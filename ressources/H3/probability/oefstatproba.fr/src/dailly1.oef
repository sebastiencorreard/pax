\title{Probabilités 1 : Vocabulaire des probabilités}
\langage{fr}
\format{html}
\author{Delphine, Dailly}

\computeanswer{no}
\precision{10000}

\text{color=rouge,verte,jaune,violette,orange,bleue}
\text{colors=rouges,vertes,jaunes,violettes,oranges,bleues}
\text{\nb=shuffle(6)}

\text{nb1=randint(2..10)}
\text{nb2=randint(2..10)}
\text{nb3=randint(2..10)}

\text{phrases=avoir une boule \color[\nb[4]], avoir une boule de couleur, avoir une boule \color[\nb[1]], ne pas avoir de boule \color[\nb[3]]}

\text{proba1=simplify(\nb3/(\nb3+\nb1+\nb2))}
\text{proba2=simplify(1-\nb2/(\nb3+\nb1+\nb2))}

\statement{
Dans une urne, il y a \nb1 boules \colors[\nb[2]], \nb2 boules \colors[\nb[3]]
et \nb3 boules \colors[\nb[1]].
On tire une boule au hasard de l'urne. Elles sont indicernables au toucher.
<div class="spacer">Mettre en relation chaque événement avec sa probabilité :</div>

<div class="wimscenter">\embed{r1}</div>}

\answer{}{\phrases;0,1,\proba1,\proba2}{type=correspond}{option=shuffle split eqweight}

\hint{Penser à simplifier les fractions.}
