\title{Nuage de points et point moyen}
\autor{Cédric,Taupin}
\format{html}

\integer{y0=(randint(0..5)*10+10)}
\integer{y1=(randint(0..5)*10+10)}
\integer{y2=(randint(0..5)*10+10)}
\integer{y3=(randint(0..5)*10+10)}
\integer{y4=(randint(0..5)*10+10)}
\integer{y5=(randint(0..5)*10+10)}

\integer{xg=(((10+20+30+40+50)/5)+10)}
\integer{yg=((\y1+\y2+\y3+\y4+\y5)/5)+10}
\text{rep = slib(graphpaper/millimetre 8,8,1,1,1,1)}

\text{a=fcircle 10,\y0+10,10,red}
\text{b=fcircle 20,\y1+10,10,red}
\text{c=fcircle 30,\y2+10,10,red}
\text{d=fcircle 40,\y3+10,10,red}
\text{e=fcircle 50,\y4+10,10,red}
\text{g=fcircle \xg,\yg,10,green}

\text{f=fcircle 60,\y5+10,10,red}

\text{rep1 = draw (200,200
fcircle \xg,\yg,15,purple
\rep
\a
\b
\c
\d
\e
\f
\g)}



\integer{y0=\y0/10}
\integer{y1=\y1/10}
\integer{y2=\y2/10}
\integer{y3=\y3/10}
\integer{y4=\y4/10}
\integer{y5=\y5/10}

\statement{
<p>
Calculer les coordonnées du point G, point moyen de la série statistique suivante et
le placer sur le graphe (les calculs seront arrondis à l'unité) :
</p>
<table class="wimscenter wimsborder">
  <tr>
   <th style="background-color:red">\( X_i )</th>
   <td>0</td>
   <td>1</td>
   <td>2</td>
   <td>3</td>
   <td>4</td>
   <td>5</td>
  </tr><tr>
   <th style="background-color:red">\(y_i)</th>
   <td>\y0</td>
   <td>\y1</td>
   <td>\y2</td>
   <td>\y3</td>
   <td>\y4</td>
   <td>\y5</td>
  </tr>
</table>
<div class="wimscenter">\embed{r1}</div>
}

\answer{}{\rep1;circle,\xg,\yg,20}{type=coord}
