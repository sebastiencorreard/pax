\title{Déterminer l'équation de la droite de Mayer}
\autor{Cédric,Taupin}
\format{html}

\integer{a=randint(0..1000)}
\integer{b=randint(1..100)+\a}
\integer{c=randint(1..100)+\b}
\integer{d=randint(1..100)+\c}
\integer{e=randint(1..100)+\d}
\integer{f=randint(1..100)+\e}
\integer{g=randint(1..100)+\f}
\integer{h=randint(1..100)+\g}
\integer{i=randint(1..100)+\h}
\integer{j=randint(1..100)+\i}

\text{objet= randitem(stylos, DVD, gommes, ampoules, livres, feutres, chaises, tables)}

\integer{xg1=(2000+2001+2002+2003+2004)/5}
\integer{yg1=(\a+\b+\c+\d+\e)/5}

\integer{xg2=(2005+2006+2007+2008+2009)/5}
\integer{yg2=(\f+\g+\h+\i+\j)/5}

\integer{u=(\yg2-\yg1)/(\xg2-\xg1)}
\integer{v=\yg1-\u*\xg1}

\integer{w=\u*2011+\v}


\steps{r1,r2,r3,r4
r5,r6
r7}

\statement{

\if{\step=1}{
Le tableau ci-dessous représente la production de \objet en milliers d'articles d'une usine française.
