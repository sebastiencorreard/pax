\title{Statistiques : effectifs et fréquences}
\language{fr}
\range{-5..5}
\author{Jean-Baptiste, Bergamo}
\email{jbcube@hotmail.com}
\computeanswer{no}
\format{html}
\precision{1000}



\integer{n=randint(20..30)}
\integer{nmin=randint(0..25)}
\integer{neff=\nmin+4}
\text{liste1=slib(stat/random \n, \nmin,\neff)}
\text{liste2=wims(values x for x= \nmin to \neff+1)}
\text{E=slib(stat/effectif [\liste1],[\liste2])}
\text{E=item(1,\E)}
\text{E=wims(declosing \E)}

\text{F=slib(stat/freq [\liste1],[\liste2])}
\text{F=item(1,\F)}
\text{F=wims(declosing \F)}
\real{freq1=ceil(item(1,\F)*1000)/1000}
\real{freq2=ceil(item(2,\F)*1000)/1000}
\real{freq3=ceil(item(3,\F)*1000)/1000}
\real{freq4=ceil(item(4,\F)*1000)/1000}
\real{freq5=ceil(item(5,\F)*1000)/1000}

\real{freq6=100*\freq1}
\real{freq7=100*\freq2}
\real{freq8=100*\freq3}
\real{freq9=100*\freq4}
\real{freq10=100*\freq5}


\text{eff1=item(1,\E)}
\text{eff2=item(2,\E)}
\text{eff3=item(3,\E)}
\text{eff4=item(4,\E)}
\text{eff5=item(5,\E)}

\text{table=<table class="wimscenter wimsborder">}

\integer{nn=ceil(\n/10)}
\for{i=0 to \nn-1}{
  \text{table=\table <tr>}
  \for{j=1 to 10}{\text{a=item(\i*10+\j,\liste1)}
  \text{table=\table <td>\a</td>}
 }
 \text{table=\table </tr>}
}
\text{table=\table </table>}
\real{a1=item(1,\liste2)}
\real{a2=item(2,\liste2)}
\real{a3=item(3,\liste2)}
\real{a4=item(4,\liste2)}
\real{a5=item(5,\liste2)}
\text{tableau=<table class="wimscenter wimsborder">}
\text{tableau=\tableau<tr><th>Températures (°C)</th>
<td>\a1</td>
<td>\a2</td>
<td>\a3</td>
<td>\a4</td>
<td>\a5</td>
</tr>}


\statement{Voici les températures de différentes communes d'une région de France à la suite d'une étude :
\table
<p>Compléter le tableau suivant au millième près par excès pour
les fréquences et au dixième pour les fréquences en poucentage :
</p>
\tableau
<tr><th>Effectif (nb de communes)</th>
<td>\embed{reply 1,10}</td>
<td>\embed{reply 2,10}</td>
<td>\embed{reply 3,10}</td>
<td>\embed{reply 4,10}</td>
<td>\embed{reply 5,10}</td>
</tr>
<tr><th>Fréquence</th>
<td>\embed{reply 6,10}</td>
<td>\embed{reply 7,10}</td>
<td>\embed{reply 8,10}</td>
<td>\embed{reply 9,10}</td>
<td>\embed{reply 10,10}</td>
</tr>
<tr><th>Fréquence en %</th>
<td>\embed{reply 11,10}</td>
<td>\embed{reply 12,10}</td>
<td>\embed{reply 13,10}</td>
<td>\embed{reply 14,10}</td>
<td>\embed{reply 15,10}</td>
</tr>
</table>}

\answer{Effectif 1}{\eff1}{type=numeric}
\answer{Effectif 2}{\eff2}{type=numeric}
\answer{Effectif 3}{\eff3}{type=numeric}
\answer{Effectif 4}{\eff4}{type=numeric}
\answer{Effectif 5}{\eff5}{type=numeric}

\answer{Fréquence 1}{\freq1}{type=numeric}
\answer{Fréquence 2}{\freq2}{type=numeric}
\answer{Fréquence 3}{\freq3}{type=numeric}
\answer{Fréquence 4}{\freq4}{type=numeric}
\answer{Fréquence 5}{\freq5}{type=numeric}

\answer{Fréquence 6}{\freq6}{type=numeric}
\answer{Fréquence 7}{\freq7}{type=numeric}
\answer{Fréquence 8}{\freq8}{type=numeric}
\answer{Fréquence 9}{\freq9}{type=numeric}
\answer{Fréquence 10}{\freq10}{type=numeric}
