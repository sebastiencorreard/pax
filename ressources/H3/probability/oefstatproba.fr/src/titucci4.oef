\title{Statistiques : moyenne, étendue, variance et écart type}
\language{fr}
\author{Aurélien,Tutucci}
\email{obie_trice06@hotmail.com}
\format{html}

\text{club1=random(milan,psg,barcelone,chelsea)}
\text{club2=random(juventus,lyon,real madrid,arsenal)}
\text{club3=random(inter,nice,valence,liverpool)}
\text{club4=random(naples,marseille,villaréal,manchester united)}
\text{club5=random(as roma,bordeaux,deportivo,manchester city)}
\text{club6=random(lazio,lilles,athlético madrid,newcastle)}
\text{club7=random(fiorentina,lens,seville,aston villa)}
\text{club8=random(udinese,rennes,majorque,tottenham)}

\integer{x=randint(10..50)}
\integer{y=randint(10..50)}
\integer{z=randint(10..50)}
\integer{t=randint(10..50)}
\integer{u=randint(10..50)}
\integer{v=randint(10..50)}
\integer{w=randint(10..50)}
\integer{s=randint(10..50)}

\text{liste=\x,\y,\z,\t,\u,\v,\w,\s}
\text{liste2=wims(sort numeric item \liste)}
\text{maxi=item(8,\liste2)}
\text{mini=item(1,\liste2)}
\real{etendue=\maxi-\mini}
\text{moy=(\x+\y+\z+\t+\u+\v+\w+\s)/8}
\text{var=((\x-\moy)^2+(\y-\moy)^2+(\z-\moy)^2+(\t-\moy)^2+(\u-\moy)^2+(\v-\moy)^2+(\w-\moy)^2+(\s-\moy)^2)/8}
\text{ecart= sqrt(\var) }

\real{ecart=rint(\ecart*10)/10}
\real{moy=rint(\moy*10)/10}
\real{var=rint(\var*10)/10}
\real{etendue=rint(\etendue*10)/10}


\statement{<table class="wimscenter wimsborder">
<tr><th>equipe</th><th>matchs gagnés</th></tr>
<tr><td>\club1</td><td>\x</td></tr>
<tr><td>\club2</td><td>\y</td></tr>
<tr><td>\club3</td><td>\z</td></tr>
<tr><td>\club4</td><td>\t</td></tr>
<tr><td>\club5</td><td>\u</td></tr>
<tr><td>\club6</td><td>\v</td></tr>
<tr><td>\club7</td><td>\w</td></tr>
<tr><td>\club8</td><td>\s</td></tr>
</table>
<ul><li>
Calculer le nombre moyen de matchs gagnés.
</li><li>
Calculer l'étendue.</li><li>
Calculer la variance et l'écart type.
</li></ul>}


\answer{le nombre moyen de matchs gagnés est }{\moy}{type=numexp}
\answer{l'étendue est }{\etendue}{type=numexp}
\answer{la variance est}{\var}{type=numexp}
\answer{l'ecart type est }{\ecart}{type=numexp}
