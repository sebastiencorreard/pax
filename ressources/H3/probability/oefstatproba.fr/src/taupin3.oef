\title{Déterminer l'équation de la droite de régression linéaire}
\autor{Cédric,Taupin}
\format{html}

\integer{a=randint(0..1000)}
\integer{b=randint(1..100)+\a}
\integer{c=randint(1..100)+\b}
\integer{d=randint(1..100)+\c}
\integer{e=randint(1..100)+\d}
\integer{f=randint(1..100)+\e}
\integer{g=randint(1..100)+\f}
\integer{h=randint(1..100)+\g}
\integer{i=randint(1..100)+\h}
\integer{j=randint(1..100)+\i}

\text{objet= randitem(stylos, DVD, gommes, ampoules, livres, feutres, chaises, tables)}

\integer{moy1=(2000+2001+2002+2003+2004+2005+2006+2007+2008+2009)/10}

\integer{moy=(\a+\b+\c+\d+\e+\f+\g+\h+\i+\j)/10}

\integer{cov=(
(\a-\moy)*(2000-\moy1)+
(\b-\moy)*(2001-\moy1)+
(\c-\moy)*(2002-\moy1)+
(\d-\moy)*(2003-\moy1)+
(\e-\moy)*(2004-\moy1)+
(\f-\moy)*(2005-\moy1)+
(\g-\moy)*(2006-\moy1)+
(\h-\moy)*(2007-\moy1)+
(\i-\moy)*(2008-\moy1)+
(\j-\moy)*(2009-\moy1))/10}

\integer{var=((2000-\moy1)^2+(2001-\moy1)^2+(2002-\moy1)^2+
(2003-\moy1)^2+(2004-\moy1)^2+
(2005-\moy1)^2+(2006-\moy1)^2+(2007-\moy1)^2+(2008-\moy1)^2+
(2009-\moy1)^2)/10}

\integer{w=\cov/\var}
\integer{x=\moy1-(\a*\moy)}

\statement{
Le tableau ci-dessous représente la production de \objet en milliers
d'articles d'une usine française
<div class="wims_instruction">Les calculs seront arrondis à l'unité.</div>

<table class="wimscenter wimsborder">
  <tr>
   <th style="background-color:red"> Année  </th>
   <td> 2000</td>
   <td> 2001</td>
   <td> 2002</td>
   <td> 2003</td>
   <td> 2004</td>
   <td> 2005</td>
   <td> 2006</td>
   <td> 2007</td>
   <td> 2008</td>
   <td> 2009</td>
  </tr><tr>
   <th style="background-color:red"> Production de \objet en milliers d'articles </th>
   <td> \a</td>
   <td> \b</td>
   <td> \c</td>
   <td> \d</td>
   <td> \e</td>
   <td> \f</td>
   <td> \g</td>
   <td> \h</td>
   <td> \i</td>
   <td> \j</td>
  </tr>
</table>
Calculer \(a\) et \(b\) tel que la droite d'équation \(y=a x+b\)
soit la meilleure approximation affine des données.
<div class="wimscenter">
a = \embed{r1}, b = \embed{r2}
</div>
}

\answer{}{\w}{type=numexp}
\answer{}{\x}{type=numexp}
