\title{Probabilités 2 : Comparaisons de probabilités}
\langage{fr}
\format{html}
\author{Delphine, Dailly}
\computeanswer{no}
\precision{10000}

\text{prenom=slib(lang/fname fr,boy)}
\text{lettre1=randitem(A,B,C,D,E,F,G,F,G,H,J,K,L)}
\text{lettre2=randitem(M,N,P,Q,R,S,T,V,W,X,Y,Z)}
\text{color=rouge,verte,jaune,blanche,noire,bleue}
\text{colors=rouges,vertes,jaunes,blanches,noires,bleues}
\text{\nb0=shuffle(6)}

\text{nb1=randint(2..10)}
\text{nb2=randint(4..10)}
\text{nb3=randint(2..10)}
\text{nb=randitem(1,2,3)}
\text{nb4=randitem(simplify(\nb2+\nb),simplify(\nb2-\nb))}

\rational{frac1=\nb2/(\nb1+\nb2)}
\rational{frac2=\nb4/(\nb3+\nb4)}
\if{\frac1=\frac2}{
  \integer{nb4=\nb4+1}
  \rational{frac2=\nb4/(\nb3+\nb4)}
}

\if{\frac1-\frac2<0}{\text{C=\lettre2}}{\text{C=\lettre1}}

\statement{
<ul><li>
Dans le sac \lettre1, il y a \nb1 boules \colors[\nb0[1]] et \nb2 boules \colors[\nb0[2]].
</li><li>
Dans le sac \lettre2, il y a \nb3 boules \colors[\nb0[1]] et \nb4 boules \colors[\nb0[2]].
</li></ul>
<p>
\prenom a le choix : tirer une boule dans le sac \lettre1 ou dans le sac \lettre2.
</p><p>
Il gagne s'il tire une boule \color[\nb0[2]].
</p>
<div class="spacer bold">
Quel sac doit-il choisir pour avoir le plus de chances de gagner ?</div>}

\choice{}{\C}{\lettre1,\lettre2}
\hint{Mettre les fractions sur le même dénominateur pour pouvoir les comparer.}

\solution{Pour le sac \lettre1, la probabilité d'avoir une boule \color[\nb0[2]] est de \(\frac1).
Pour le sac \lettre2, la probabilité d'avoir une boule \color[\nb0[2]] est de \(\frac2).
Donc il vaut mieux choisir le sac \C.}
