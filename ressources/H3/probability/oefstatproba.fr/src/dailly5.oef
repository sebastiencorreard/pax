\title{Probabilités 5 : Evénement contraire}
\langage{fr}
\format{html}
\author{Delphine, Dailly}
\computeanswer{no}
\precision{10000}

\text{color=rouge,verte,jaune,blanche,noire,bleue}
\text{colors=rouges,vertes,jaunes,blanches,noires,bleues}
\text{nb=shuffle(6)}

\integer{ch=randint(1..2)}
\text{nb1=randint(1..10)}
\text{nb2=randint(1..10)}
\text{nb3=randint(1..10)}
\text{nb4=randint(1..10)}
\text{f1=texmath(simplify(\nb1/(\nb1+\nb2)))}
\text{f2=texmath(simplify(\nb3/(\nb3+\nb4)))}

\text{rep1=simplify(\nb2/(\nb1+\nb2))}
\text{rep2=simplify(1-\nb3/(\nb3+\nb4))}

\if{\ch=1}{
 \text{final1=\rep1}
 \text{final2=\rep1}
}{
 \text{final1=non}
 \text{final2=\rep2}
}

\statement{
\if{\ch=1}{
Dans un sac, il y a des boules \colors[\nb[1]] et des boules \colors[\nb[2]].
On sait que la probabilité de tirer une boule \color[\nb[1]] est \(\f1).

<ol type="a">
<li><b>Calculer, si possible, la probabilité de tirer une boule \color[\nb[2]] </b>
(sinon écrire "non" en minuscules) : \embed{r1,10}.</li>
<li><b>Calculer, si possible, la probabilité de ne pas tirer une boule
\color[\nb[1]] </b> (sinon écrire "non" en minuscules) : \embed{r2,10}.</li>
</ol>
}{
Dans une urne, il y a des boules \colors[\nb[2]], \colors[\nb[3]] et \colors[\nb[1]].
On sait que la probabilité de tirer une boule \color[\nb[2]] est \(\f2).
<ol>
<li><b>Calculer, si possible, la probabilité que la boule soit \color[\nb[3]]</b> (sinon écrire "non" en minuscules) : \embed{r1,10}. </li>
<li><b>Calculer, si possible, la probabilité que la boule ne soit pas \color[\nb[2]]</b> (sinon écrire "non" en minuscules) :\embed{r2,10}.</li>
</ol>}
}

\answer{}{\srep1}{type=auto}
\answer{}{\srep2}{type=auto}

\condition{La réponse à la question 1 est correcte}{\final1 issametext \srep1 or \final1=\srep1}
\condition{La réponse à la question 2 est correcte}{\final2=\srep2}

\hint{Attention, il faut écrire le résultat sous la forme d'une fraction irréductible !

Si on ne peut pas calculer la probabilité, écrire "non" dans la zone de réponse.
}
