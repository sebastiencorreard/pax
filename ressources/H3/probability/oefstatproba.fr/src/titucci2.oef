\title{Statistiques : effectifs et médiane}
\language{fr}
\author{Aurélien,Tutucci}
\email{obie_trice06@hotmail.com}
\format{html}
\precision{100}


\text{eff=}
\text{effcc=}
\text{age=randint(17..18)}
\text{liste=}

\for{k=1 to 8}{
 \text{eff=\eff,randint(1..5)}
 \integer{t=\effcc[-1]+\eff[-1]}
 \text{effcc=\effcc,\t}
 \integer{nage=\age[-1]+randint(1..3)}
 \text{age=\age,\nage}
 \text{liste=\liste,wims(values \nage for v=1 to \eff[-1])}
}
\text{eff=\eff[2 to -1]}
\text{effcc=\effcc[2 to -1]}
\text{liste=\liste[2 to -1]}
\text{age=\age[2 to -1]}

\text{liste2=wims(sort numeric item \liste)}
\integer{nb=items(\liste2)}
\real{test=\nb/2}
\if{. isin \test}{
 \integer{ind=\test}
 \real{mediane=\liste2[\ind]}
}{
 \real{mediane=(\liste2[\test]+\liste2[\test+1])/2}
}

\statement{On étudie une série statistique sur l'âge des joueurs d'une équipe de football.
Compléter le tableau suivant :
<table class="wimscenter wimsborder">
<tr><th>âges</th><th>effectifs</th>
<th>effectifs cumulés croissants </th>
</tr>
\for{j=1 to 8}{
 <tr><td>\age[\j]</td><td>\eff[\j]</td><td>\embed{r\j,30}</td></tr>
}
</table>}

\answer{effectif 1}{\effcc[1]}{type=numeric}
\answer{effectif 2}{\effcc[2]}{type=numeric}
\answer{effectif 3}{\effcc[3]}{type=numeric}
\answer{effectif 4}{\effcc[4]}{type=numeric}
\answer{effectif 5}{\effcc[5]}{type=numeric}
\answer{effectif 6}{\effcc[6]}{type=numeric}
\answer{effectif 7}{\effcc[7]}{type=numeric}
\answer{effectif 8}{\effcc[8]}{type=numeric}


\answer{la médiane est}{\mediane}
