\title{Statistiques : variance}
\language{fr}
\range{-5..5}
\author{Jean-Baptiste, Bergamo}
\email{jbcube@hotmail.com}
\computeanswer{no}
\format{html}
\precision{1000}

\text{mo1= Décembre, Janvier, Fevrier}
\text{mo2=shuffle(\mo1)}
\text{mo=item(1,\mo2)}

\text{vi1= Paris,Lilles,Lens,Reims,Dijon}
\text{vi2=shuffle(\vi1)}
\text{vi=item(1,\vi2)}

\integer{n=randint(15..25)}
\integer{nmin=randint((-6)..9)}
\integer{neff=\nmin+4}
\text{liste1=slib(stat/random \n, \nmin,\neff)}
\text{liste2=wims(values x for x= \nmin to \neff+1)}
\text{E=slib(stat/effectif [\liste1],[\liste2])}
\text{E=item(1,\E)}
\text{E=wims(declosing \E)}

\text{m=slib(stat/arithmean [\liste1])}
\text{m=item(1,\m)}
\real{m=rint(\m*10)/10}
\text{v=slib(stat/variance [\liste1])}
\text{v=item(1,\v)}
\real{v=rint(\v*10)/10}


\text{F=slib(stat/freq [\liste1],[\liste2])}
\text{F=item(1,\F)}
\text{F=wims(declosing \F)}
\real{freq1=ceil(item(1,\F)*1000)/10}
\real{freq2=ceil(item(2,\F)*1000)/10}
\real{freq3=ceil(item(3,\F)*1000)/10}
\real{freq4=ceil(item(4,\F)*1000)/10}
\real{freq5=ceil(item(5,\F)*1000)/10}

\text{eff1=item(1,\E)}
\text{eff2=item(2,\E)}
\text{eff3=item(3,\E)}
\text{eff4=item(4,\E)}
\text{eff5=item(5,\E)}

\text{table=<table class="wimscenter wimsborder">}

\integer{nn=ceil(\n/10)}
\for{i=0 to \nn-1}
 {\text{table=\table<tr>}
 \for{j=1 to 10}
 {\text{a=item(\i*10+\j,\liste1)}
\text{table=\table<td>\a</td>}
 }
\text{table=\table</tr>}
}
\text{table=\table</table>}
\real{a1=item(1,\liste2)}
\real{a2=item(2,\liste2)}
\real{a3=item(3,\liste2)}
\real{a4=item(4,\liste2)}
\real{a5=item(5,\liste2)}
\text{tableau=<table class="wimscenter wimsborder">}
\text{tableau=\tableau<tr><th>Températures</th>
<td>\a1</td>
<td>\a2</td>
<td>\a3</td>
<td>\a4</td>
<td>\a5</td>
}
\text{tableau=\tableau</tr>}

\statement{Voici les températures(°C) relevées à \vi durant le mois de \mo:
\table
<p>
Compléter le tableau suivant
</p>
\tableau
<tr><th>Effectif</th>
<td>\embed{reply 1,8}</td>
<td>\embed{reply 2,8}</td>
<td>\embed{reply 3,8}</td>
<td>\embed{reply 4,8}</td>
<td>\embed{reply 5,8}</td>
</tr>
<tr><th>Fréquence(%)</th>
<td>\embed{reply 6,8}</td>
<td>\embed{reply 7,8}</td>
<td>\embed{reply 8,8}</td>
<td>\embed{reply 9,8}</td>
<td>\embed{reply 10,8}</td>
</tr>
</table>
<ul><li>La température moyenne sur \vi en \mo est de:\embed{reply 11}.</li>
<li>La variance est de: \embed{reply 12}.</li>
</ul>
}
\choice{Qu'est-ce que la variance?}
{la moyenne des carrés des écarts par rapport à la moyenne ,la dispersion des valeurs par rapport à la moyenne}
{le carré de la moyenne des écarts de la moyenne, la médiane des écarts}

\answer{Effectif 1}{\eff1}{type=numexp}
\answer{Effectif 2}{\eff2}{type=numexp}
\answer{Effectif 3}{\eff3}{type=numexp}
\answer{Effectif 4}{\eff4}{type=numexp}
\answer{Effectif 5}{\eff5}{type=numexp}

\answer{Fréquence 1}{\freq1}{type=numexp}
\answer{Fréquence 2}{\freq2}{type=numexp}
\answer{Fréquence 3}{\freq3}{type=numexp}
\answer{Fréquence 4}{\freq4}{type=numexp}
\answer{Fréquence 5}{\freq5}{type=numexp}
\answer{moyenne}{\m}{type=numexp}
\answer{variance}{\v}{type=numexp}
