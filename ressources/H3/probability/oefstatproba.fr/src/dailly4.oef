\title{Probabilités 4 : Influence du passé sur l'avenir 1}
\langage{fr}
\format{html}
\author{Delphine, Dailly}
\computeanswer{no}
\precision{10000}

\text{nb=randint(2..20)}
\text{listpiece=shuffle(face,pile)}
\text{piece1=item(1,\listpiece)}
\text{piece2=item(2,\listpiece)}
\text{nb1=simplify(\nb +1)}

\statement{
On a lancé \nb fois de suite une pièce de monnaie (parfaitement équilibrée)
et, chaque fois, elle est tombée sur "\piece1".

<p><b>Compléter la phrase suivante :</b></p>
<div class="spacer">La \nb1 ième fois, la probabilité que la pièce tombe sur "\piece1" est
\embed{r1,140} la probabilité de tomber sur "\piece2".
</div>}

\answer{}{la même que;supérieure à,inférieure à}{type=dragfill}{option=shuffle}

\hint{Attention, ne te précipite pas !}
