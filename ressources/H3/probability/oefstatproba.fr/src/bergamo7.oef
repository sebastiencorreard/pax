\title{Statistiques : médiane}
\language{fr}
\range{-5..5}
\precision{1000}
\author{Jean-Baptiste, Bergamo}
\email{jbcube@hotmail.com}
\computeanswer{no}
\format{html}

\text{n=randint(8,9,10,11,12,13)}

\text{a=slib(stat/random \n,0,30)}
\text{a=wims(declosing [\a])}
\text{b =}
\for{ i = 1 to \n}{
  \for{j = 1 to \n}{
  \real{c= (\a[\i]+\a[\j])/2}
   \text{b=\b,\c}
   }
}
\text{b=wims(nonempty items \b)}

\text{tableau= <table class="wimscenter wimsborder"><tr>}
\for{i=1 to \n}{
\real{u=item(\i, \a)}
\text{tableau= \tableau <td> &nbsp;&nbsp;  \u  &nbsp;&nbsp; </td>}
}
\text{tableau=\tableau </tr></table>}

\real{m=slib(stat/median [\a])}
\real{moy=item(1,slib(stat/arithmean [\a]) )}

\statement{Durant l'automne, \n températures ont été relevé dans le centre de  Paris :
\tableau
<p>
Calculer la médiane de cette série statistique.
</p><div class="wimscenter">
La médiane est égale à : \embed{reply1,5}</div>
}

\answer{Médiane}{\m}{type=algexp}

\choice{Qu'est-ce que la médiane?}
{c'est le nombre qui sépare la série en deux groupes de même effectif}
{c'est la moyenne des valeurs extrêmes, c'est la moyenne de la population qui sépare la série en deux groupes de même effectif, c'est la moyenne des effectifs, c'est le nombre qui sépare la série en deux groupes de même population}

\hint{<span style="color:purple">Attention : ne pas oublier de ranger les températures par ordre croissant !
La médiane est la valeur centrale (ou la moyenne des deux valeurs centrales).</span>}

\real{test2 =  (\a[rint(\n/2)]+\a[rint((\n+1)/2)])/2}

\feedback{\reply1 <> \m and \reply1 = \test2}{<p>
<span class="wims_warning">Attention</span> : ne pas oublier de ranger les températures par ordre croissant !
</p>}

\feedback{\reply1 = \moy and \reply1 <> \m}{<p><span class="wims_warning">
Attention</span> : vous confondez la moyenne et la médiane ! </p>}

\feedback{\reply1 <> \m and \reply1 <> \moy and \reply1 notitemof \b}{
<p><span class="wims_warning">Attention</span>: La médiane se trouve parmi un des
nombres de la série, ou de la moyenne de deux d'entre eux.</p>}
