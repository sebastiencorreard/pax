\title{Statistiques : effectifs cumulés}
\language{fr}
\author{Aurélien,Tutucci}
\email{obie_trice06@hotmail.com}
\format{html}
\precision{100}


\integer{x=randint(1..6)}
\integer{y=randint(2..5)}
\integer{z=randint(1..2)}
\integer{t=randint(4..5)}
\integer{u=randint(3..6)}
\integer{v=randint(2..3)}
\integer{w=randint(1..3)}
\integer{a=randint(3..4)}
\integer{b=randint(1..2)}

\integer{c=randint(17..19)}
\integer{d=randint(20..21)}
\integer{e=randint(22..24)}
\integer{f=randint(25..27)}
\integer{g=randint(28..29)}
\integer{h=randint(30..32)}
\integer{i=randint(33..35)}
\integer{j=randint(36..37)}
\integer{k=randint(38..40)}

\text{n=(\x+\y+\z+\t+\u+\v+\w+\a+\b)}
\integer{effcc1=\x}
\integer{effcc2=\y+\x}
\integer{effcc3=\z+\y+\x}
\integer{effcc4=\t+\z+\y+\x}
\integer{effcc5=\u+\t+\z+\y+\x}
\integer{effcc6=\v+\u+\t+\z+\y+\x}
\integer{effcc7=\w+\v+\u+\t+\z+\y+\x}
\integer{effcc8=\a+\w+\v+\u+\t+\z+\y+\x}
\integer{effcc9=\b+\a+\w+\v+\u+\t+\z+\y+\x}

\integer{effcd1=\b+\a+\w+\v+\u+\t+\z+\y+\x}
\integer{effcd2=\b+\a+\w+\v+\u+\t+\z+\y}
\integer{effcd3=\b+\a+\w+\v+\u+\t+\z}
\integer{effcd4=\b+\a+\w+\v+\u+\t}
\integer{effcd5=\b+\a+\w+\v+\u}
\integer{effcd6=\b+\a+\w+\v}
\integer{effcd7=\b+\a+\w}
\integer{effcd8=\b+\a}
\integer{effcd9=\b}




\statement{
On étudie une série statistique sur l'âge des joueurs d'une équipe de football.
<p>Compléter le tableau suivant :</p>
<table class="wimscenter wimsborder">
<tr><th>effectifs</th><th>âges</th><th>effectifs cumulés croissants</th>
<th>effectifs cumulés décroissants</th></tr>
<tr><td>\x</td><td>\c</td><td>\embed{reply 1,30}</td><td>\embed{reply 10,30}</td></tr>
<tr><td>\y</td><td>\d</td><td>\embed{reply 2,30}</td><td>\embed{reply 11,30}</td></tr>
<tr><td>\z</td><td>\e</td><td>\embed{reply 3,30}</td><td>\embed{reply 12,30}</td></tr>
<tr><td>\t</td><td>\f</td><td>\embed{reply 4,30}</td><td>\embed{reply 13,30}</td></tr>
<tr><td>\u</td><td>\g</td><td>\embed{reply 5,30}</td><td>\embed{reply 14,30}</td></tr>
<tr><td>\v</td><td>\h</td><td>\embed{reply 6,30}</td><td>\embed{reply 15,30}</td></tr>
<tr><td>\w</td><td>\i</td><td>\embed{reply 7,30}</td><td>\embed{reply 16,30}</td></tr>
<tr><td>\a</td><td>\j</td><td>\embed{reply 8,30}</td><td>\embed{reply 17,30}</td></tr>
<tr><td>\b</td><td>\k</td><td>\embed{reply 9,30}</td><td>\embed{reply 18,30}</td></tr>
</table>}

\answer{effectifcc 1}{\effcc1}{type=numeric}
\answer{effectifcc 2}{\effcc2}{type=numeric}
\answer{effectifcc 3}{\effcc3}{type=numeric}
\answer{effectifcc 4}{\effcc4}{type=numeric}
\answer{effectifcc 5}{\effcc5}{type=numeric}
\answer{effectifcc 6}{\effcc6}{type=numeric}
\answer{effectifcc 7}{\effcc7}{type=numeric}
\answer{effectifcc 8}{\effcc8}{type=numeric}
\answer{effectifcc 9}{\effcc9}{type=numeric}




\answer{effectifcd 1}{\effcd1}{type=numeric}
\answer{effectifcd 2}{\effcd2}{type=numeric}
\answer{effectifcd 3}{\effcd3}{type=numeric}
\answer{effectifcd 4}{\effcd4}{type=numeric}
\answer{effectifcd 5}{\effcd5}{type=numeric}
\answer{effectifcd 6}{\effcd6}{type=numeric}
\answer{effectifcd 7}{\effcd7}{type=numeric}
\answer{effectifcd 8}{\effcd8}{type=numeric}
\answer{effectifcd 9}{\effcd9}{type=numeric}
