\title{Moyenne pondérée}
\language{fr}
\author{Aurélien,Tutucci}
\email{obie_trice06@hotmail.com}
\format{html}
\precision{1000}

\integer{x=randint(1..3)}
\integer{y=randint(2..4)}
\integer{z=randint(3..4)}
\integer{t=randint(3..5)}
\integer{u=randint(1..2)}
\integer{v=randint(2..3)}
\integer{w=randint(1..2)}
\integer{a=randint(3..4)}
\integer{b=randint(2..2)}

\text{age1=randint(17..19)}
\text{age2=randint(22..24)}
\text{age3=randint(25..27)}
\text{age4=randint(28..31)}
\text{age5=randint(38..40)}
\text{age6=randint(20..21)}
\text{age7=randint(34..35)}
\text{age8=randint(32..33)}
\text{age9=randint(36..37)}

\steps{r1
r2}

\text{n=\x+\y+\z+\t+\u+\v+\w+\a+\b}
\real{moy=(\x*\age1+\y*\age2+\z*\age3+\t*\age4+\u*\age5+\v*\age6+\w*\age7+\a*\age8+\b*\age9)/(\n)}
\text{var=(\x*((\age1-\moy)^2)+\y*((\age2-\moy)^2)+\z*((\age3-\moy)^2)+\t*((\age4-\moy)^2)+\u*((\age5-\moy)^2)+\v*((\age6-\moy)^2)+\w*((\age7-\moy)^2)+\a*((\age8-\moy)^2)+\b*((\age9-\moy)^2))/(\n)}
\real{moya=floor(\moy*100)/100*1.}
\real{vara=floor(\var*100)/100*1.}

\statement{
On étudie une série statistique sur l'âge des joueurs d'une équipe de football.

<table class="wimscenter wimsborder">
<tr><th>effectifs</th><th>age</th></tr>
<tr><td>\x</td><td>\age1</td></tr>
<tr><td>\y</td><td>\age2</td></tr>
<tr><td>\z</td><td>\age3</td></tr>
<tr><td>\t</td><td>\age4</td></tr>
<tr><td>\u</td><td>\age5</td></tr>
<tr><td>\v</td><td>\age6</td></tr>
<tr><td>\w</td><td>\age7</td></tr>
<tr><td>\a</td><td>\age8</td></tr>
<tr><td>\b</td><td>\age9</td></tr>
</table>
<ol>
 <li>Calculer l'âge moyen des joueurs de l'équipe (arrondi au 100ième).
\if{\step=1}{
 <div class="wimscenter">\embed{r1}</div></li>
}{
 \moya<b> bonne réponse</b></li>
 <li>Maintenant calculer la variance.
 <div><b>reponse</b> : \embed{r2,15}</div></li>
}
</ol>}
\answer{la moyenne est }{\moya}{type=numeric}
\answer{la variance est }{\vara}{type=numeric}
