!set title=Statistiques : vocabulaire caractère
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Bergamo
email=jbcube@hotmail.com
language=fr
computeanswer=no
precision=10000

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 19, 25

val6=$[rint($(tmp0)-1)]
tmp0=!randint 20, 25

val7=$[rint($(tmp0)+5)]
tmp0=!randint 20, 26

val8=$[rint($(tmp0)-1)]
tmp0=!randint 21, 25

val9=$[rint($(tmp0)+5)]
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val10=$(tmp0)
choicename1=Dans cette étude statistique:
choicegood1=les températures d'été en France
choicebad1=les villes du Japon, les communes de France, la météo en France, la personne qui regarde les données météo
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10 regarde les données météo d'une journée de cet été.	<table class="wimscenter wimsborder">	<tr><th>noms des villes</th><th>température(°C)</th></tr>	<tr><td>Paris</td><td>$val6</td></tr>	<tr><td>Marseille</td><td>$val7</td></tr>	<tr><td>Bordeaux</td><td>$val8</td></tr>	<tr><td>Nice</td><td>$val9</td></tr>	</table>	Le "caractère" est le critère qui permet de classer les élèments	de la population en différentes valeurs.	<p>	Quel est le caractère de cette étude statistique?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=0
