val26=($val6*(($val15-$val25)^2)+$val7*(($val16-$val25)^2)+$val8*(($val17-$val25)^2)+$val9*(($val18-$val25)^2)+$val10*(($val19-$val25)^2)+$val11*(($val20-$val25)^2)+$val12*(($val21-$val25)^2)+$val13*(($val22-$val25)^2)+$val14*(($val23-$val25)^2))/($val24)
