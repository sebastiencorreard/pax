!set title=Nuage de points et point moyen
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 5

val6=$[rint(($(tmp0)*10+10))]
tmp0=!randint 0, 5

val7=$[rint(($(tmp0)*10+10))]
tmp0=!randint 0, 5

val8=$[rint(($(tmp0)*10+10))]
tmp0=!randint 0, 5

val9=$[rint(($(tmp0)*10+10))]
tmp0=!randint 0, 5

val10=$[rint(($(tmp0)*10+10))]
tmp0=!randint 0, 5

val11=$[rint(($(tmp0)*10+10))]
val12=$[rint((((10+20+30+40+50)/5)+10))]
val13=$[rint((($val7+$val8+$val9+$val10+$val11)/5)+10)]
!readproc slib/graphpaper/millimetre 8,8,1,1,1,1 
tmp0=$slib_out
val14=$(tmp0)
val15=fcircle 10,$val6+10,10,red
val16=fcircle 20,$val7+10,10,red
val17=fcircle 30,$val8+10,10,red
val18=fcircle 40,$val9+10,10,red
val19=fcircle 50,$val10+10,10,red
val20=fcircle $val12,$val13,10,green
val21=fcircle 60,$val11+10,10,red
!readproc oef/draw.phtml 200,200 \
fcircle $val12,$val13,15,purple	$val14	$val15	$val16	$val17	$val18	$val19	$val21	$val20 
tmp0=$ins_url
val22=$(tmp0)
val6=$[rint($val6/10)]
val7=$[rint($val7/10)]
val8=$[rint($val8/10)]
val9=$[rint($val9/10)]
val10=$[rint($val10/10)]
val11=$[rint($val11/10)]
replytype1=coord
replyname1=
replygood1=$val22;circle,$val12,$val13,20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	Calculer les coordonnées du point G, point moyen de la série statistique suivante et	le placer sur le graphe (les calculs seront arrondis à l'unité) :	</p>	<table class="wimscenter wimsborder">	  <tr>	   <th style="background-color:red">
!insmath  X_i 
$()</th>	   <td>0</td>	   <td>1</td>	   <td>2</td>	   <td>3</td>	   <td>4</td>	   <td>5</td>	  </tr><tr>	   <th style="background-color:red">
!insmath y_i
$()</th>	   <td>$val6</td>	   <td>$val7</td>	   <td>$val8</td>	   <td>$val9</td>	   <td>$val10</td>	   <td>$val11</td>	  </tr>	</table>	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

