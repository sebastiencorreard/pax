!set title=Statistiques : vocabulaire population
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Bergamo
email=jbcube@hotmail.com
language=fr
computeanswer=no
precision=10000

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 7

val6=$[rint($(tmp0)-1)]
tmp0=!randint 7, 13

val7=$[rint($(tmp0)+1)]
tmp0=!randint 3, 10

val8=$[rint($(tmp0)-1)]
tmp0=!randint 8, 12

val9=$[rint($(tmp0)+1)]
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val10=$(tmp0)
choicename1=Dans cette étude statistique:
choicegood1=les communes de France,les grandes villes de France
choicebad1=les températures d'hiver,les températures en France,la population des grandes villes de France, la météo en France,la personne qui regarde les données météo
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10 regarde les données météo de cet hiver.	<table class="wimscenter wimsborder">	<tr><th>noms des villes</th><th>température(°C)</th></tr>	<tr><td>Paris</td><td>$val6</td></tr>	<tr><td>Marseille</td><td>$val7</td></tr>	<tr><td>Bordeaux</td><td>$val8</td></tr>	<tr><td>Nice</td><td>$val9</td></tr>	</table>	On appelle "population" l'ensemble des personnes ou objets étudiés.	<p>Quelle est la population de cette étude statistique ?</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=0
