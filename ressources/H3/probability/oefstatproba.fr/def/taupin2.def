!set title=Déterminer l'équation de la droite de Mayer
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r,r,r,r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=7
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 1000

val6=$[rint($(tmp0))]
tmp0=!randint 1, 100

val7=$[rint($(tmp0)+$val6)]
tmp0=!randint 1, 100

val8=$[rint($(tmp0)+$val7)]
tmp0=!randint 1, 100

val9=$[rint($(tmp0)+$val8)]
tmp0=!randint 1, 100

val10=$[rint($(tmp0)+$val9)]
tmp0=!randint 1, 100

val11=$[rint($(tmp0)+$val10)]
tmp0=!randint 1, 100

val12=$[rint($(tmp0)+$val11)]
tmp0=!randint 1, 100

val13=$[rint($(tmp0)+$val12)]
tmp0=!randint 1, 100

val14=$[rint($(tmp0)+$val13)]
tmp0=!randint 1, 100

val15=$[rint($(tmp0)+$val14)]
tmp=!nonempty items stylos, DVD, gommes, ampoules, livres, feutres, chaises, tables

tmp0=!randitem $tmp
val16=$(tmp0)
val17=$[rint((2000+2001+2002+2003+2004)/5)]
val18=$[rint(($val6+$val7+$val8+$val9+$val10)/5)]
val19=$[rint((2005+2006+2007+2008+2009)/5)]
val20=$[rint(($val11+$val12+$val13+$val14+$val15)/5)]
val21=$[rint(($val20-$val18)/($val19-$val17))]
val22=$[rint($val18-$val21*$val17)]
val23=$[rint($val21*2011+$val22)]
oefsteps=r1,r2,r3,r4	r5,r6	r7 
nextstep=!nosubst r1,r2,r3,r4	r5,r6	r7 
!readproc oef/steps.proc
replytype1=numexp
replyname1=
replygood1=$val17
replytype2=numexp
replyname2=
replygood2=$val18
replytype3=numexp
replyname3=
replygood3=$val19
replytype4=numexp
replyname4=
replygood4=$val20
replytype5=numexp
replyname5=
replygood5=$val21
replytype6=numexp
replyname6=
replygood6=$val22
replytype7=numexp
replyname7=
replygood7=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

