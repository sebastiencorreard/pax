val15=$[rint($(tmp0))]
tmp=!nonempty items stylos, DVD, gommes, ampoules, livres, feutres, chaises, tables

tmp0=!randitem $tmp
val16=$(tmp0)
val17=$[rint(($val6+$val7+$val8+$val9+$val10+$val11+$val12+$val13+$val14+$val15)/10)]
val18=$[rint((2000+2001+2002+2003+2004+2005+2006+2007+2008+2009)/10)]
replytype1=numexp
replyname1=
replygood1=$val18
replytype2=numexp
replyname2=
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

