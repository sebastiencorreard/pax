!set title=Probabilités 1 : Vocabulaire des probabilités
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Delphine, Dailly
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=rouge,verte,jaune,violette,orange,bleue
val7=rouges,vertes,jaunes,violettes,oranges,bleues
tmp0=!shuffle 6

val8=$(tmp0)
tmp0=!randint 2, 10

val9=$(tmp0)
tmp0=!randint 2, 10

val10=$(tmp0)
tmp0=!randint 2, 10

val11=$(tmp0)
val12=avoir une boule $(val6[$(val8[4])]), avoir une boule de couleur, avoir une boule $(val6[$(val8[1])]), ne pas avoir de boule $(val6[$(val8[3])])
tmp=!translate ";': to $     $ in $val11/($val11+$val9+$val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
tmp=!translate ";': to $     $ in 1-$val10/($val11+$val9+$val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
replytype1=correspond
replyoption1=shuffle split eqweight 
replyname1=
replygood1=$val12;0,1,$val13,$val14
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Penser à simplifier les fractions.


!goto stat

!exit

:question
$()	Dans une urne, il y a $val9 boules $(val7[$(val8[2])]), $val10 boules $(val7[$(val8[3])])	et $val11 boules $(val7[$(val8[1])]).	On tire une boule au hasard de l'urne. Elles sont indicernables au toucher.	<div class="spacer">Mettre en relation chaque événement avec sa probabilité :</div>		<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>
$()
!exit

:hint
$()Penser à simplifier les fractions.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=1
