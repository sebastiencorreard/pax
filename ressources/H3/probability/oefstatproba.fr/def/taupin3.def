 !exit
!endif

tmp0=!randint 0, 1000

val6=$[rint($(tmp0))]
tmp0=!randint 1, 100

val7=$[rint($(tmp0)+$val6)]
tmp0=!randint 1, 100

val8=$[rint($(tmp0)+$val7)]
tmp0=!randint 1, 100

val9=$[rint($(tmp0)+$val8)]
tmp0=!randint 1, 100

val10=$[rint($(tmp0)+$val9)]
tmp0=!randint 1, 100

val11=$[rint($(tmp0)+$val10)]
