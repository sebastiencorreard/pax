val13=$[rint($(tmp0)+$val12)]
tmp0=!randint 1, 100

val14=$[rint($(tmp0)+$val13)]
tmp0=!randint 1, 100

val15=$[rint($(tmp0)+$val14)]
tmp=!nonempty items stylos, DVD, gommes, ampoules, livres, feutres, chaises, tables

tmp0=!randitem $tmp
val16=$(tmp0)
val17=$[rint((2000+2001+2002+2003+2004+2005+2006+2007+2008+2009)/10)]
val18=$[rint(($val6+$val7+$val8+$val9+$val10+$val11+$val12+$val13+$val14+$val15)/10)]
val19=$[rint((	($val6-$val18)*(2000-$val17)+	($val7-$val18)*(2001-$val17)+	($val8-$val18)*(2002-$val17)+	($val9-$val18)*(2003-$val17)+	($val10-$val18)*(2004-$val17)+	($val11-$val18)*(2005-$val17)+	($val12-$val18)*(2006-$val17)+	($val13-$val18)*(2007-$val17)+	($val14-$val18)*(2008-$val17)+	($val15-$val18)*(2009-$val17))/10)]
val20=$[rint(((2000-$val17)^2+(2001-$val17)^2+(2002-$val17)^2+	(2003-$val17)^2+(2004-$val17)^2+	(2005-$val17)^2+(2006-$val17)^2+(2007-$val17)^2+(2008-$val17)^2+	(2009-$val17)^2)/10)]
val21=$[rint($val19/$val20)]
val22=$[rint($val17-($val6*$val18))]
replytype1=numexp
replyname1=
replygood1=$val21
replytype2=numexp
replyname2=
replygood2=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

