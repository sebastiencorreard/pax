$()
!exit

:feedback

!exit

:test

!ifval $val18 issametext $val20 or $val18=$val20
 condtest1=1
!else
 condtest1=0
!endif
condname1=La réponse à la question 1 est correcte

!ifval $val19=$val21
 condtest2=1
!else
 condtest2=0
!endif
condname2=La réponse à la question 2 est correcte

!exit

:stat
vsavelist=6,7,8,9,14,15,18,19,20,21
