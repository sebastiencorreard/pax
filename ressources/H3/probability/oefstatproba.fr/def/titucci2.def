val13=$(tmp0)
tmp0=!itemcnt $val13

val14=$[rint($(tmp0))]
val15=$[$val14/2]
!if . isin $val15 
val16=$[rint($val15)]
val17=$[$(val13[$val16])]
!else
val17=$[($(val13[$val15])+$(val13[$val15+1]))/2]
!endif
