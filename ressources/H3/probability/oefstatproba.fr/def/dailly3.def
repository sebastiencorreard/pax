!set title=Probabilités 3 : Calcul de probabilités avec un dé
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Delphine, Dailly
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 4,6,8,10,12,20

tmp0=!randitem $tmp
val6=$(tmp0)
val7=$[rint(floor($val6/4))]
val8=$[rint(floor($val6/3))]
tmp=!translate ";': to $     $ in $val7/$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp=!translate ";': to $     $ in 1-$val8/$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
tmp=!nonempty items pair,impair

tmp0=!randitem $tmp
val11=$(tmp0)
replytype1=numexp
replyname1=
replygood1=1/2
replytype2=numexp
replyname2=
replygood2=$val9
replytype3=numexp
replyname3=
replygood3=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Attention, il faut écrire le résultat sous la forme d'une fraction irréductible !


!goto stat

!exit

:question
$()	On dispose d'un dé à $val6 faces numérotées de 1 à $val6. On lance le dé	et on note le numéro de la face supérieure du dé.		<p>Quelle est la probabilité des évènements suivants ?</p>	<ol>	<li>Obtenir un nombre $val11.	<div class="wimscenter">La probabilité d'obtenir un nombre $val11 est de  
!read oef/embed.phtml r1,20 
$().</div>	</li>	<li>Obtenir un multiple de 4.	<div class="wimscenter">La probabilité d'obtenir un multiple de 4 est de  
!read oef/embed.phtml r2,20 
$().</div></li>	<li>Ne pas obtenir un multiple de 3.	<div class="wimscenter">La probabilité de ne pas obtenir un multiple de 3 est de  
!read oef/embed.phtml r3,20 
$().</div></li>	</ol>
$()
!exit

:hint
$()Attention, il faut écrire le résultat sous la forme d'une fraction irréductible !
$()
!exit

:help
$()
$()
!exit

:solution
