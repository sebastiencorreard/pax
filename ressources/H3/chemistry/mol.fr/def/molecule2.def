tmp=!trim dioxygène|de dioxygène|du dioxygène,0,0,0,2,\(O_2),	 diazote|de diazote|du diazote,0,0,2,0,\(N_2)	 dihydrogène|de dihydrogène|du dihydrogène, 0,2,0,0,\(H_2)	 dioxyde de carbone|de dioxyde de carbone| du dioxyde de carbone, 1,0,0,2, \(CO_2)	 eau|d'eau|de l'eau, 0,2,0,1,\(H_2O)	 méthane|de méthane|du méthane,1,4,0,0,\(CH_4)	 monoxyde de carbone|de monoxyde de carbone|du monoxyde de carbone, 1,0,0,1,\(CO)	
val6=!translate internal $	\
$ to ;; in $tmp
val7=disk -0.5,0, 15,red	disk 0.5,0, 15,red	toto	toto	toto
val8=disk -0.5,0, 15,blue	disk 0.5,0, 15,blue	toto	toto	toto
val9=disk 0,0.5, 15,white	disk 0,-0.5, 15,white	toto	toto	toto
val10=disk -1,0, 15,red	disk 1,0, 15,red	disk 0,0, 22,black	toto	toto
val11=disk 0.7,0.2, 15,white	disk -0.7,0.2, 15,white	disk 0,-0.5, 15,red	toto	toto
val12=disk 0.7,0.7, 15,white	disk -0.7,0.7, 15,white	disk 0.7,-0.7, 15,white	disk -0.7,-0.7, 15,white	disk 0,0, 22,black
val13=disk 0.7,0, 15,red	disk -0.5,0, 22,black	toto	toto	toto
tmp=!trim $val7	$val8	$val9	$val10	$val11	$val12	$val13	
val14=!translate internal $	\
$ to ;; in $tmp
val15=carbone|de carbone|du carbone,hydrogène|d'hydrogène,de l'hydrogène,azote |d'azote|de l'azote,oxygène|de l'oxygène d'oxygène
val16=carbone, hydrogène,azote,oxygène
tmp0=!randint 1, 7

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!item 1 of $val18

val19=$(tmp0)
tmp0=!item 2,3,4,5 of $val18

val20=$(tmp0)
val21=
!for val22 =1 to 4 
!if $(val16[$val22])!=0 
val21=$val21,$(val16[$val22])
!endif
!next
tmp0=!nonempty items $val21

val21=$(tmp0)
tmp0=!itemcnt $val21

val23=$(tmp0)
val24=$[rint(5*$val17-5+1)]
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val24 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val24+1 of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val24+2 of $tmp
tmp2=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val24+3 of $tmp
tmp3=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val24+4 of $tmp
tmp4=!translate internal $\
$ to ; in $tmp
val25=$(tmp0)	$(tmp1)	$(tmp2)	$(tmp3)	$(tmp4)	
tmp0=!replace ; by in $val25

val25=$(tmp0)
tmp0=!item 1 of \mix

tmp1=!item $(tmp0) of $val20


!ifval $(tmp1)=0 
val26= \non
!else
val26=\oui
!endif
tmp0=!item 2 of \mix

tmp1=!item $(tmp0) of $val20


!ifval $(tmp1)=0 
val27= \non
!else
val27=\oui
!endif
tmp0=!item 3 of \mix

tmp1=!item $(tmp0) of $val20


!ifval $(tmp1)=0 
val28= \non
!else
val28=\oui
!endif
tmp0=!item 4 of \mix

tmp1=!item $(tmp0) of $val20


!ifval $(tmp1)=0 
val29= \non
!else
val29=\oui
!endif
tmp=!translate internal $	$ to ; in \listerep

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 2 of $(tmp0)

val30=$(tmp1)
tmp=!translate internal $	$ to ; in \listerep

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 1 of $(tmp0)

tmp2=!item $(tmp1) of $val16

val24=$(tmp2)
tmp=!translate internal $	$ to ; in \listerep

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 2 of $(tmp0)

val31=$(tmp1)
tmp=!translate internal $	$ to ; in \listerep

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 1 of $(tmp0)

tmp2=!item $(tmp1) of $val16

val32=$(tmp2)
