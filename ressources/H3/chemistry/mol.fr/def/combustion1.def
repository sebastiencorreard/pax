!set title=Combustion simple II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=de dihydrogène,d' eau, 1, 8	de carbone,de dioxyde de carbone, 3,8	
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
val12=$[rint($val10+$val11)]
tmp0=!randint 3, 8

val13=$[rint($(tmp0))]
val14=$[rint($val10*$val13)]
val15=$[rint($val11*$val13)]
tmp0=!randint 0, 4

val16=$[rint($(tmp0))]
tmp0=!randitem 1,2

val17=$(tmp0)

!ifval $val17=1 
val14=$[rint( $val14+$val16)]
!endif

!ifval $val17=2 
val15=$[rint( $val15+$val16)]
!endif
val18=$[rint(($val12)*$val13)]

!ifval $val17=1 
val19=$[rint( $val16)]
!else
val19=$[rint(0)]
!endif

!ifval $val17=2 
val20=$[rint( $val16)]
!else
val20=$[rint(0)]
!endif
replytype1=numeric
replyname1=masse formée
replygood1=$[$val18]
replytype2=numeric
replyname2=$val8 restant ?
replygood2=$[$val19]
replytype3=numeric
replyname3=dioxygène restant ?
replygood3=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La combustion complète de	$val10 
!insmath g
$() $val8 nécessite $val11 
!insmath g
$() de dioxygène et donne $val12 
!insmath g
$() $val9.	<p>On fait brûler $val14 
!insmath g
$() $val8 avec $val15 
!insmath g
$() de dioxygène :	</p>	<ol><li>	Quelle est la masse $val9 formée ?  
!read oef/embed.phtml reply 1,5 
$() 
!insmath g
$().	</li><li>	 Combien reste-il de grammes de $val8 ?  
!read oef/embed.phtml reply 2,5 
$() 
!insmath g
$().	</li><li>	 Combien reste-t-il de grammes de dioxygène ?  
!read oef/embed.phtml reply 3,5 
$() 
!insmath g
$()	</li></ol>	
$()
!exit

