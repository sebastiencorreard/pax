!set title=Combustion simple
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=de dihydrogène,d' eau, 1, 8	de carbone,de dioxyde de carbone, 3,8	
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
val12=$[rint($val10+$val11)]
tmp0=!randint 3, 8

val13=$[rint($(tmp0))]
val14=$[rint($val10*$val13)]
val15=$[rint($val11*$val13)]
val16=$[rint(($val12)*$val13)]

!ifval \choix=1 
val17=$[rint( \rest)]
!else
val17=$[rint(0)]
!endif

!ifval \choix=2 
val18=$[rint( \rest)]
!else
val18=$[rint(0)]
!endif
replytype1=numeric
replyname1=Masse de dioxygène
replygood1=$[$val15]
replytype2=numeric
replyname2=$val8 restant ?
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La combustion complète de	$val10 
!insmath g
$() $val8 nécessite $val11 
!insmath g
$() de dioxygène et donne $val12 
!insmath g
$() $val9.	<ol><li>	 Quelle masse de dioxygène faut-il pour brûler complètement $val14 
!insmath g
$() $val8 ?	  
!read oef/embed.phtml reply 1,5 
$() 
!insmath g
$().	</li><li>	 Combien obtient-on de grammes $val9 ? 
!read oef/embed.phtml reply 2,5 
$() 
!insmath g
$().	</li></ol>	
$()
!exit

