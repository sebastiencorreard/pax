\title{Combustion simple}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\text{liste=de dihydrogène,d' eau, 1, 8
de carbone,de dioxyde de carbone, 3,8
}

\text{mol=randomrow(\liste)}
\text{mol1=item(1,\mol)}
\text{mol2=item(2,\mol)}
\text{n=item(3,\mol)}
\text{m=item(4,\mol)}
\integer{nm=\n+\m}
\integer{mult=randint(3..8)}
\integer{s1=\n*\mult}
\integer{s2=\m*\mult}
\integer{rep1= (\nm)*\mult}
\integer{rep2= \choix=1 ? \rest:0}
\integer{rep3= \choix=2 ? \rest:0}

\statement{La combustion complète de
\n \(g) \mol1 nécessite \m \(g) de dioxygène et donne \nm \(g) \mol2.
<ol><li>
 Quelle masse de dioxygène faut-il pour brûler complètement \s1 \(g) \mol1 ?
 \embed{reply 1,5} \(g).
</li><li>
 Combien obtient-on de grammes \mol2 ?\embed{reply 2,5} \(g).
</li></ol>
}
\answer{Masse de dioxygène}{\s2}{type=numeric}
\answer{\mol1 restant ?}{\rep1}{type=numeric}
