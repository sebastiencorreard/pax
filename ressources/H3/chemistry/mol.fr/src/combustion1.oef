\title{Combustion simple II}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\text{liste=de dihydrogène,d' eau, 1, 8
de carbone,de dioxyde de carbone, 3,8
}

\text{mol=randomrow(\liste)}
\text{mol1=item(1,\mol)}
\text{mol2=item(2,\mol)}
\text{n=item(3,\mol)}
\text{m=item(4,\mol)}
\integer{nm=\n+\m}
\integer{mult=randint(3..8)}
\integer{s1=\n*\mult}
\integer{s2=\m*\mult}
\integer{rest=randint(0..4)}
\text{choix=random(1,2)}
\integer{s1=\choix=1 ? \s1+\rest}
\integer{s2=\choix=2 ? \s2+\rest}
\integer{rep1= (\nm)*\mult}
\integer{rep2= \choix=1 ? \rest:0}
\integer{rep3= \choix=2 ? \rest:0}

\statement{La combustion complète de
\n \(g) \mol1 nécessite \m \(g) de dioxygène et donne \nm \(g) \mol2.
<p>On fait brûler \s1 \(g) \mol1 avec \s2 \(g) de dioxygène :
</p>
<ol><li>
Quelle est la masse \mol2 formée ? \embed{reply 1,5} \(g).
</li><li>
 Combien reste-il de grammes de \mol1 ? \embed{reply 2,5} \(g).
</li><li>
 Combien reste-t-il de grammes de dioxygène ? \embed{reply 3,5} \(g)
</li></ol>
}
\answer{masse formée}{\rep1}{type=numeric}
\answer{\mol1 restant ?}{\rep2}{type=numeric}
\answer{dioxygène restant ? }{\rep3}{type=numeric}
