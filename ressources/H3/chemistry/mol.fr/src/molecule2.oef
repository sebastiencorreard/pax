\title{Molécules simples II}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{yes}
\format{html}
\precision{5000}

\matrix{liste= dioxygène|de dioxygène|du dioxygène,0,0,0,2,\(O_2),
 diazote|de diazote|du diazote,0,0,2,0,\(N_2)
 dihydrogène|de dihydrogène|du dihydrogène, 0,2,0,0,\(H_2)
 dioxyde de carbone|de dioxyde de carbone| du dioxyde de carbone, 1,0,0,2, \(CO_2)
 eau|d'eau|de l'eau, 0,2,0,1,\(H_2O)
 méthane|de méthane|du méthane,1,4,0,0,\(CH_4)
 monoxyde de carbone|de monoxyde de carbone|du monoxyde de carbone, 1,0,0,1,\(CO)
}

\text{dessin1=disk -0.5,0, 15,red
disk 0.5,0, 15,red
toto
toto
toto}
\text{dessin2=disk -0.5,0, 15,blue
disk 0.5,0, 15,blue
toto
toto
toto}
\text{dessin3=disk 0,0.5, 15,white
disk 0,-0.5, 15,white
toto
toto
toto}
\text{dessin4=disk -1,0, 15,red
disk 1,0, 15,red
disk 0,0, 22,black
toto
toto}
\text{dessin5=disk 0.7,0.2, 15,white
disk -0.7,0.2, 15,white
disk 0,-0.5, 15,red
toto
toto}
\text{dessin6=disk 0.7,0.7, 15,white
disk -0.7,0.7, 15,white
disk 0.7,-0.7, 15,white
disk -0.7,-0.7, 15,white
disk 0,0, 22,black}
\text{dessin7=disk 0.7,0, 15,red
disk -0.5,0, 22,black
toto
toto
toto}
\matrix{dessin=\dessin1
\dessin2
\dessin3
\dessin4
\dessin5
\dessin6
\dessin7
}


\text{atome=carbone|de carbone|du carbone,hydrogène|d'hydrogène,de l'hydrogène,azote |d'azote|de l'azote,oxygène|de l'oxygène d'oxygène}
\text{atomes=carbone, hydrogène,azote,oxygène}
text{couleur= black,white,blue,red}

\text{mol=randint(1..7)}
\text{molecule=row(\mol,\liste)}
\text{nom=item(1,\molecule)}
\text{type=item([2,3,4,5],\molecule)}
\text{atomemol=}
\for{i=1 to 4}{
  \if{\atomes[\i]!=0}{\text{atomemol=\atomemol,\atomes[\i]}}
}
\text{atomemol=wims(nonempty items \atomemol)}
\text{natome=wims(itemcnt \atomemol)}
\integer{mol1=5*\mol-5+1}
\text{dessinmol= row(\mol1,\dessin)
row(\mol1+1,\dessin)
row(\mol1+2,\dessin)
row(\mol1+3,\dessin)
row(\mol1+4,\dessin)
}
\text{dessinmol=wims(replace ; by in \dessinmol)}
\text{rep1=item(item(1,\mix),\type)=0 ? \non:\oui}
\text{rep2=item(item(2,\mix),\type)=0 ? \non:\oui}
\text{rep3=item(item(3,\mix),\type)=0 ? \non:\oui}
\text{rep4=item(item(4,\mix),\type)=0 ? \non:\oui}


\text{rep5=item(2,row(2,\listerep))}
\text{mol1=item(item(1,row(2,\listerep)),\atomes)}
\text{rep6=item(2,row(3,\listerep))}
\text{mol2=item(item(1,row(3,\listerep)),\atomes)}

\statement{
Donner le nom de la molécule représentée par le dessin suivant,
  puis le nom des différentes sortes d'atomes qui la composent :
<div class="wimscenter">\draw{50,50}
{xrange -2,2
yrange -2,2
fill 0,0,grey
\dessinmol}
</div>
<div class="wims_instruction">Ne pas mettre d'articles pour les atomes.</div>}

\answer{Nom de la molécule}{\nom}{type=nocase}
\answer{Liste des atomes }{\atomemol}{type=wlist}
\hint{Les atomes de carbone sont représentés par une boule noire,
les atomes d'hydrogène par une boule blanche, les atomes d'oxygène par une boule rouge
et les atomes d'azote par une boule bleue. }
