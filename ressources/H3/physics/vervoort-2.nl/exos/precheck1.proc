n=$counter
# test voor 10^
test=!nospace $(reply$n)
t=!itemcnt $test
!for p=1 to $t
    tt=!item $p of $test
    !if $tt>999 or $tt<0.001
	!if 10^ notin $tt
	    errortext=Je moet het getal $tt omzetten naar een wetenschappelijke schijfwijze...<br />Dus iets met <b>10^</b>
	    goback=1
	    !exit
	!endif
    !endif
!next p

!readproc $checkdir/new_number.proc
!exit
