#hfst2
#exo14(hfst2) Isoleren van variabelen [ type a*x = b*y + c*c -> x = ? ]
n=$counter
display=1
checkfile=$checkdir/equation.proc
rounding=-1
mathview=5
r=!randint 2,20
s=!randint 2,20
t=!randint 2,20
pm=!randitem -1,1
mp=!randitem -1,1

r=$[($pm)*($r)]

s=$[($mp)*($s)]


varlist=y,z
arglist=x
keuze=!randint 0,1

!if $keuze=1
    applettext=!nospace $r cdot x = $s cdot y + $t cdot z -> 

    formula$n=$r \cdot x = $s \cdot y + $t \cdot z \rightarrow x =  [?]

    texanswer$n=\left[ \begin{array}{cccc} $r \cdot x & = & $s \cdot y + $t \cdot z & \Leftrightarrow \\ \\ \displaystyle \frac{$r \cdot x}{$r}	       & = & \displaystyle \frac{$s \cdot y + $t \cdot z}{$r} & \Leftrightarrow \\ \\ x & =  & \displaystyle \frac{$s \cdot y + $t \cdot z}{$r} & \end{array} \right.		

    answer$n=($s*y+$t*z)/($r)
!else
    applettext=!nospace $r cdot x = $s cdot y - $t cdot z -> 

    formula$n=$r \cdot x = $s \cdot y - $t \cdot z \rightarrow x =  [?]

    texanswer$n=\left[ \begin{array}{cccc} $r \cdot x & = & $s \cdot y - $t \cdot z & \Leftrightarrow \\ \\ \displaystyle \frac{$r \cdot x}{$r}	       & = & \displaystyle \frac{$s \cdot y - $t \cdot z}{$r} & \Leftrightarrow \\ \\ x & =  & \displaystyle \frac{$s \cdot y - $t \cdot z}{$r} & \end{array} \right.

    answer$n=($s*y-$t*z)/($r)
!endif
question$n=Isoleer de uitdrukking voor <kbd>x</kbd><br />
mathviewpanel=$module_title:x=:y:z:*:+:-:/
helptext=Geef je antwoord op als : <kbd>x = je_antwoord</kbd>
myanswer=!nospace x = $(answer$n)

!exit


    
