#hfst3
#exo31(hfst3) Bereken de luchtsnelheid van een ventilator
n=$counter
math=0
cols=18
rounding=1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
description=De luchtsnelheid
ex1=&nbsp;<kbd>m/s</kbd>
m_rightarrow=&nbsp;=&nbsp;
checkfile=$checkdir/units.proc
cols=10
keuze=!randint 0,1
!if $keuze=1
    #m^3
    vol=!randint 11,99
    sig=2
!else
    sig=3
    vol=!randint 101,500
!endif

#cm
opp=!randint 10,40
opp=$[$opp*10]
# m/s
ans=$[($vol/60 )/($opp*10^(-4))] 
tot=!exec scienceprint $[$ans],$sig,0 $[$ans],$sig,1
r_ans=!item 1 of $tot
h_ans=!item 2 of $tot


var1=0
var2=$[abs(($ans) - ($r_ans))]
# answer$n is fysisch correct...niet wiskundig precies
answer$n=$r_ans

textanswer$n=<ul><li>We gaan luchtsnelheid uitrekenen in m/s</li><li>Doorsnede $opp cm<sup>2</sup> = $opp&times;10<sup>&minus;4</sup> m<sup>2</sup></li><li>Debiet is $vol m<sup>3</sup>/min = $vol/60 m<sup>3</sup>/sec</li><li>De luchtsnelheid is  ($vol/60 ) / ($opp&times;10<sup>&minus;4</sup>) m/s</li><li>De luchtsnelheid is  $[ $vol / 60 ] / $[$opp*10^(-4)] m/s</li><li>De luchtsnelheid is $ans m/s</li><li>Met $sig significante cijfers (afkomstig van $vol) : De luchtsnelheid is $h_ans m/s</li></ul>

ss=Een ventilator blaast per minuut $vol m<sup>3</sup> uit door een rechthoekige opening.<br />Deze opening heeft een doorsnede van $opp cm<sup>2</sup>.<br />Bereken de snelheid (in m/s)  van de lucht.<br />Geef je antwoord in de juiste precisie.

helptext=<img src=\'$module_dir/gifs/ventilator.jpg\' alt=\'ventilator\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit




    
