#hfst2
#exo29(hfst2) Hoeveel windingen in een spoel?
n=$counter
math=0
cols=18
rounding=1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
ex1=$empty
description=Het aantal windingen
checkfile=$checkdir/new_number.proc
# meter
lengte=!randint 111,999
# diameter in cm
diameter=!randint 15,25
diameter=!nospace $diameter . 0
# meter
omtrek=$[pi*$diameter/100]
windingen=$[$lengte/$omtrek]
answer$n=$[floor($windingen)]
var1=$empty
var2=$empty

textanswer$n=<ul><li>1 winding heeft een lente van &pi;&times;$diameter cm = &pi;&times;$diameter/100 meter = $omtrek meter</li><li>Van een draad van $lengte meter kunnen we een spoel met $lengte / $omtrek &asymp; $windingen windingen maken</li><li>Dus $(answer$n) hele windingen</li></ul> 

ss=We wikkelen een <span style="color:blue">spoel</span> met diameter $diameter cm uit een draad met een lengte van $lengte meter.<br />Hoeveel hele windingen heeft deze spoel?

helptext=<img src=\'$module_dir/gifs/spoel.jpg\' alt=\'spoel\' />

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit

    
