# hfst2
#exo23(hfst2) Cilindervormig vat en inhoud
n=$counter
math=0
cols=18
rounding=-1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
m_rightarrow=&nbsp;=&nbsp;
description=De hoogte van het water
checkfile=$checkdir/units.proc

diameter=!randint 111,999
diameter=!exec moneyprint $[$diameter/100] 1
sig=!charcnt $diameter
sig=$[$sig - 1]
#h=V/(r^2)
water=!randint 100,999
h=$[$water/(0.25*pi*$diameter*$diameter)]
tot=!exec scienceprint $h,$sig $h,$sig,1
h_c=!item 1 of $tot
h_h=!item 2 of $tot
# answer$n is fysiek correcte antwoord...niet wiskundig precies,dus
answer$n=$h_c cm
diff=$[abs($h_c - $h)]
var1=1
var2=$diff
textanswer$n=<ul><li>Uit de formule voor het volume van een cilinder moet eerst de hoogte worden geisoleerd.</li><li><kbd>V = &pi; &times; r<sup>2</sup> &times; h $m_longrightarrow h = V / (&pi; &times; r<sup>2</sup>)</kbd></li><li>Verder geldt : <kbd>diameter = 2 &times; r $m_longrightarrow r = diameter / 2</li><li>h = V / (&pi; &times; (diameter/2)<sup>2</sup>) = V / (&pi; &times;0.25&times; diameter<sup>2</sup>) </kbd></li><li>Invullen: <kbd>h = $water  / (&pi; * 0.25 * $diameter^2) &nbsp;=&nbsp; $h </kbd></li><li>De eenheid controleren: ml / cm^2 == cm^3 /cm^2 == cm</li><li>h &nbsp;=&nbsp; $h cm.</li><li>Het aantal significante cijfers in het eindantwoord wordt bepaald door $diameter  (dus $sig cijfers)</li><li>De hoogte van het water in de cilinder is: h &nbsp;=&nbsp; $h_h cm</li></ul>

ss=Voor de inhoud van een <span style="color:blue">cilindervormig vat</span> geldt:<kbd>V = &pi; &times; r<sup>2</sup> &times; h</kbd><br />Met daarin <kbd>V = volume , r = straal, h = hoogte en &pi; = pi...</kbd>.<hr />Een <span style="color:blue">cilindervormig vat</span> heeft een diameter van $diameter cm<br />en wordt gevuld met $water ml water.<br />Bereken de hoogte in cm van het water.<br />Geef je antwoord met SI eenheid en passende precisie.

helptext=<img src=\'$module_dir/gifs/vat.jpg\' alt=\'vat\' />

question$n=<a onmouseover="return escape('$helptext')">$ss</a>
!exit





    
