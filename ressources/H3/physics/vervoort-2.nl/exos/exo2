# vereenvoudig [ type: 2a^2/(4a) ]
n=$counter
rounding=0
display=1
!readproc $remarkdir/rounding.$taal
question$n=Vereenvoudig;
helptext=img src=\'$module_dir/gifs/exo2.jpg\' alt=\'noalt\' />
questiontype=0
image=0
make_tr=1
mathview=5
math=0
R=$level
!if $level=0
    R=$counter
!endif
pm=!randitem +,-
ppm=!randitem +,-
mp=!randitem 1,-1
checkfile=exos/vereenvoudigen.proc
x=!randitem x,y,a,b,d,f,k,h
varlist=$x
module_title=!defof title_$taal in INDEX
mathviewpanel=$module_title:$x:(:):/:+:-:* 
var1=0
smallfont=15
# hoeft niet als 1 breuk te worden geschreven
!if $R=1
    a=!randint 2,9
    b=!randint 2,9
    c=!randint 2,9
    c=$[$mp*$c]
    e=!randint $b,$[$b+3]
    a=$[$c*$b]
    d=$[$c*$e]
    tel=!rawmath $a*$x $pm $d
    formula$n=\frac{$tel}{$c} = [?]
    answer$n=$b*$x $pm $e
    texanswer$n=\frac{$tel}{ $c } = \frac{$a $x}{$c} $pm \frac{$d}{$c} = $b \cdot $x $pm $e
    !if $mp = -1
	applettext=!nospace ($tel)/($c) =
    !else
	applettext=!nospace ($tel)/$c =
    !endif
 !exit
!endif

!if $R=2
    a=!randitem 2,3,4,5
    b=!randitem 2,3,4,5
    g=!randitem 3,4,5,6
    pm=!randitem 1,-1
    c=$[$pm*$a*$b]
    d=$[$b+1]
    f=$[$a*$d]
    e=$[$g-1]
    b=$[$pm*$b]
    formula$n=\frac{$c $x^{$g}}{$f $x} =  [?]
    answer$n=($b*$x^$e)/$d
    texanswer$n=\frac{$c $x^{$g}}{$f $x} =  \frac{ $a \cdot $b \cdot $x \cdot $x^{$e} }{$a \cdot $d \cdot $x } = \frac{ $b \cdot $x^$e }{ $d }
    applettext=!nospace ($c*$x^$g)/($f*$x) =
 !exit
!endif

!if $R>2
    a=!randitem 2,3,4,5
    b=!randitem 2,3,4,5
    e=!randitem 2,3,4
    g=!randitem 6,7,8,9
    pm=!randitem 1,-1

    c=$[$pm*$a*$b]
    d=$[$b+1]
    f=$[$a*$d]
    h=$[$g-$e]
    b=$[$pm*$b]
    
    formula$n=\frac{$c $x^{$e}}{ $f $x^{$g}} = [?]
    answer$n=$b/($d*$x^$h)
    texanswer$n=\frac{$c $x^{$e}}{ $f $x^{$g}} =\frac{ $a \cdot $b \cdot $x^{$e}}{$a \cdot $d \cdot $x^{$e} \cdot $x^{$h}} = \frac{$b}{$d \cdot $x^{$h}}
    applettext=!nospace ($c*$x^$e)/($f*$x^$g) = 
 !exit
!endif

