#hfst1
#exo7(hfst1) Gloeilamp [verhouding warmte en licht]
n=$counter
checkfile=$checkdir/units.proc
mathview=0
inputs=2
cols=8
rows=1
make_tr=1
formula$n=$empty
W=!randint 75,325
sig=!charcnt $W
ss=Een gloeilamp is gemaakt om licht te geven.<br />Slechts 5 % van de elektrische energie wordt omgezet in licht.<br />De lamp verbruikt $W joule per seconde aan elektrische energie.<br />Bereken de hoeveelheid licht en de hoeveelheid warmte.

ans1=$[0.05*$W]
ans2=$[0.95*$W]
tot=!exec scienceprint $ans1,$sig,0 $ans1,$sig,1 $ans2,$sig,0 $ans2,$sig,1
c_ans1=!item 1 of $tot
h_ans1=!item 2 of $tot
c_ans2=!item 3 of $tot
h_ans2=!item 4 of $tot
diff1=$[abs($ans1 - $c_ans1)]
diff2=$[abs($ans2 - $c_ans2)]
answer$n=$c_ans1,$c_ans2
var1=0,0
var2=$diff1,$diff2

textanswer$n=Een gloeilamp heeft dus de verdeling 5% licht en 100 &minus; 5 % = 95% warmte<br />licht : 0.05 &times; $W = $ans1 J/s ( of  Watt ). In $sig significante cijfers $h_ans1 J/s  <br />warmte : 0.95 &times; $W = $ans2 J/s ( of  Watt ). In $sig significante cijfers $h_ans2 J/s

ex1=&nbsp;J/s
ex2=&nbsp;J/s
m_rightarrow=&nbsp;:&nbsp;
description=Hoeveelheid geleverde licht,Hoeveelheid geleverde warmte
helptext=Geef je antwoord op met correcte <a target=new href=http://nl.wikipedia.org/wiki/Significant_cijfer>precisie</a>
question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/gloeilamp.gif\' alt=\'gloeilamp\' /><hr />$helptext')">$ss</a>

!exit

    
