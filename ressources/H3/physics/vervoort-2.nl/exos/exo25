# hfst2
#exo25(hfst2) Oppervlak en inhoud van een bol I
n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
plot=0
make_tr=1
checkfile=$checkdir/new_number.proc
# hoeft geen eenheid
var1=$empty
var2=$empty
# R in cm
r=!randint 5,25
# inhoud dm
r_dm=$[$r/10]
I_dm=$[(4/3)*pi*($r_dm)^3]
keuze=!randint 0,1
!if $keuze=1
    # opp cm^2
    opp=$[4*pi*$r*$r]
    unit=cm<sup>2</sup>
    O_dm=$[$opp*0.01]
!else
    # opp mm^2
    opp=$[4*pi*$r*$r*100]
    unit=mm<sup>2</sup>
    O_dm=$[$opp*0.0001]
!endif
opp=$[round($opp)]
sig=!charcnt $opp
answer$n=!exec scienceprint $I_dm,$sig


# opp dm^2
inputs=1.1
description=De inhoud van de bol 
ex1=&nbsp;liter
textanswer$n=<ul><li>Om de inhoud van de bol te berekenen moeten we eerst de radius (R) van de bol kennen.</li><li>A<sub>bol</sub> = 4 &times; &pi; &times; R<sup>2</sup></li><li>We isoleren R:<br />R<sup>2</sup> = A / ( 4 &times; &pi; )<br />R = sqrt(A / ( 4 &times; &pi;))</li><li>Om de inhoud in liters uit te drukken moeten we het oppervlak in dm<sup>2</sup> invullen:<br />$opp $unit == $O_dm dm<sup>2</sup></li><li>Invullen: R = sqrt( $O_dm / (4*&pi;)) &nbsp;=&nbsp; $r_dm dm</li><li>Inh = 4/3 &times; &pi; &times; R<sup>3</sup> dm<sup>3</sup><br />Inh = 4/3 &times; &pi; &times; $r_dm<sup>3</sup> dm<sup>3</sup> &nbsp;=&nbsp; $(answer$n) liter</li></ul>

ss=Een bol heeft een oppervlak van $opp $unit.<br />Bereken de inhoud van deze bol in liter.

helptext=<br />Inhoud van bol = 4/3 &times; &pi; &times;R<sup>3</sup><br />Oppervlak = 4 &times;&pi; &times;R<sup>2</sup>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit




    
