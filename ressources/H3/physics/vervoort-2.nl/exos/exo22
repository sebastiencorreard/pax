# hfst2
#exo22(hfst2) Bereken de draadlengte van een spoel
n=$counter
math=0
cols=18
rounding=-1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
description=De draadlengte 
checkfile=$checkdir/units.proc

windingen=!randint 5,15
windingen=$[$windingen*10]
diameter=!randint 40,199
diameter=!exec moneyprint $[$diameter/10] 1
prec=!charcnt $diameter
# punt moet eraf :  1.24 -> 3
prec=$[$prec-1]
omtrek=$[pi*$diameter]
lengte_cm=$[$omtrek*$windingen]
lengte_m=$[$omtrek*$windingen/100]
var1=1
tot=!exec scienceprint $lengte_cm,$prec $lengte_cm,$prec,1 $lengte_m,$prec,1
ans=!item 1 of $tot
h_ans_cm=!item 2 of $tot
h_ans_m=!item 3 of $tot
var2=$[abs($ans - $lengte_cm)]
# antwoord is fysisch correct...niet wiskundig ($l;engte_cm)
answer$n=$ans cm

rr=<ul><li>De omtrek van een cirkel: <kbd> 2 &times; &pi; &times; Radius = &pi; &times; Diameter </li><li>Omtrek spoel in cm : &pi; &times; $diameter &asymp; $omtrek cm</li><li>Bij $windingen windingen is de lengte van de draad dus ongeveer: $windingen &times; $omtrek cm</li><li>Het aantal significante cijfers in je eindantwoord : $prec (afkomstig van $diameter)</li><li>De draadlengte is : $h_ans_cm cm ($h_ans_m m)</li></ul>

ss=Een ronde <span style="color:blue">spoel</span> heeft $windingen windingen en een diameter van $diameter cm.<br />Bereken de lengte van de draad (in cm) waarvan deze spoel is gemaakt.<br />Geef je antwoord met SI eenheid en een passende precisie.

helptext=<img src=\'$module_dir/gifs/spoel.jpg\' alt=\'spoel\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
textanswer$n=$rr
!exit





    
