n=$counter
mathview=0
#hfst4
#exo40(hfst4) Rekenen aan concentraties [zout in water]
checkfile=$checkdir/units.proc
inputs=1.1
cols=10
rows=1
make_tr=1
formula$n=$empty
description=De benodigde hoeveelheid zout
m_rightarrow=&nbsp;&nbsp;=&nbsp;&nbsp;
ex1=&nbsp;<kbd>gram</kbd>
vol=!randitem 125,250,400,500,750,1250,1400,1750,2000,2500,3000

sig=!randint 2,3
keuze=!randint 1,4
!if $sig=3
    c1=!randint 1,9
    c2=!randint 0,9
    c3=!randint 1,9
    !if $keuze=1
	conc=!nospace $c1 .$c2 $c3 
    !else
	!if $keuze=2
	    conc=!nospace 0. $c1 $c2 $c3 
	!else
	    !if $keuze=3
		conc=!nospace 0 . $c1 $c2 $c3
	    !else
		conc=!nospace $c1 $c2 . $c3
	    !endif
	!endif
    !endif
!else
    c1=!randint 1,9
    c2=!randint 1,9
    !if $keuze=1
	conc=!nospace $c1 .$c2
    !else
	!if $keuze=2
	    conc=!nospace 0. $c1 $c2
	!else
	    !if $keuze=3
		conc=!nospace 0. 0 0 $c1 $c2
	    !else
		conc=!nospace 0. 0 $c1 $c2
	    !endif
	!endif
    !endif
!endif
rounding=0
ans=$[$vol*$conc/1000]
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,1
c_ans=!item 1 of $tot
h_ans=!item 2 of $tot
answer$n=$c_ans
var2=$[abs($ans-$c_ans)]
var1=0

textanswer$n=c = m / V $m_longrightarrow m = c &times; V <br />\
(Volume V in liters, concentratie c in g/l en massa m in g)<br />\
m = $conc g/l &times; $[$vol/1000] l = $ans g<br />\
m = $h_ans g <em>(in $sig significante cijfers)</em>


helptext=

question$n=Hoeveel gram zout moeten we oplossen in $vol ml water<br />om een zoutconcentratie van $conc g/l te krijgen ?

!exit
    
