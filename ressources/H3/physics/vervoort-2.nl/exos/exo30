#hfst3
#exo30(hfst3) Volumedebiet in een vierkante buis
n=$counter
math=0
cols=18
rounding=1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
description=Het volumedebiet &Phi;<sub>v</sub>
m_rightarrow=&nbsp;=&nbsp;
ex1=&nbsp;<kbd>m<sup>3</sup> / uur </kbd>
checkfile=$checkdir/units.proc

sig=!randint 2,3
!if $sig=2
    z1=!randint 1,9
    z2=5
    # cm
    zijde=!nospace $z1 . $z2

!else
    z1=!randint 1,9
    z2=!randint 1,9
    z3=5
    # cm
    zijde=!nospace $z1 . $z2  $z3
!endif
v=!randint 10,50
v=!nospace $v . 0

ans=$[60*60*$v*$zijde*$zijde*10^-4]

tot=!exec scienceprint $ans,$sig,0 $ans,$sig,1
answer$n=!item 1 of $tot
h_ans=!item 2 of $tot

# geen eenheid
var1=0
var2=$[abs($ans-$(answer$n))]

ss=Door een <span style="color:blue">vierkante buis</span> (zijde <kbd>a</kbd> is $zijde cm) stroomt lucht met een snelheid van $v m/s.<br />Bereken het volumedebiet in m<sup>3</sup> / h<br />Geef je antwoord in de juiste precisie.

plaatje=<img src=\'$module_dir/gifs/exo30.jpg\' alt=\'vierkantebuis\' />
helptext=$plaatje<hr />Geef je antwoord in de juiste precisie.

question$n=<a onmouseover="return escape('$plaatje')">$ss</a>

textanswer$n=<ul><li>Oppervlak van de buis is $zijde&times;$zijde cm<sup>2</sup> = $zijde&times;$zijde&times;10<sup>&minus;4</sup> m<sup>2</sup></li><li>De luchtsnelheid in de buis is $v m/s :<br />per seconde wordt $v &times; $zijde&times;$zijde&times;10<sup>&minus;4</sup> m<sup>3</sup> lucht verplaatst</li><li>Per uur wordt 60 &times; 60 &times $v &times; $zijde &times; $zijde &times;10<sup>&minus;4</sup> m<sup>3</sup> lucht verplaatst</li><li>Het volumedebiet door de buis is : $ans m<sup>3</sup> / h </li><li>Met $sig significante cijfers (afkomstig van $zijde ): Het volumedebiet door de buis is : $h_ans m<sup>3</sup> / h </li></ul>
texanswer$n=\begin{array}{ll}\Phi_{v} = & v \cdot \textrm{A} \\ & \textrm{met daarin:} \\ \Phi_{v} &\textrm{het debiet} \\ v &\textrm{de snelheid } \\ \textrm{A}& \textrm{het oppervlak van de doorsnede} \end{array}
!exit





    
