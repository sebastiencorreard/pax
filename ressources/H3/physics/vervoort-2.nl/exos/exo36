n=$counter
#hfst3                                                                                                                                     
#exo36(hfst3)Toerental van een katrol
math=0
cols=14
mathview=0
image=0
plot=0
make_tr=1
checkfile=$checkdir/units.proc
inputs=1.1
description=Het toerental van de katrol
ex1=&nbsp;<kbd>rph</kbd>
m_rightarrow=&nbsp;=&nbsp;

sig=!randint 2,3
!if $sig=3
    # cm/min
    v=!randint 2,12
    v=!nospace $[$v*10] . 5
    # cm
    diameter=!randint 5,9
    diameter=!nospace $[$diameter*5] .5
!else
    # cm/min
    v=!randint 2,12
    v=$[$v*10]
    # cm
    diameter=!randint 5,9
    diameter=$[$diameter*5]
!endif
#cm
omtrek=$[pi*$diameter]
rpm=$[$v/$omtrek]
rph=$[60*$rpm]
ss=Een <span style="color:blue">katrol</span> heeft een diameter van ca $diameter cm.<br />Door middel van deze katrol wordt een massa <br />naar boven getakeld met een snelheid van ca $v cm/min.<br />Bereken het toerental van de katrol in rph.

rounding=-1
tot=!exec scienceprint $rph,$sig,0 $rph,$sig,1
c_ans=!item 1 of $tot
h_ans=!item 2 of $tot
# diff 
var2=$[abs( $rph - $c_ans )]
var1=0
answer$n=$rph
r_rph=$[(round(100*$rph))100]
helptext=<img src=\'$module_dir/gifs/exo36.jpg\' alt=\'katrol\' />

textanswer$n=<ul><li><kbd>n = v / O</kbd><br /><kbd>O = &pi;&times;d<kbd><br />met daarin: <kbd>n</kbd> = toerental , <kbd>O</kbd> = oppervlak , <kbd>d</kbd> = diameter </li><li><kbd> O = &pi; &times; $diameter = $omtrek cm </kbd></li><li><kbd>v = $v cm/min / $omtrek cm = $v/$omtrek min<sup>&minus;1</sup> = $rpm rpm = 60 &times; $rpm rph = $rph rph</kbd></li><li>$inputtext1 is $rph rph</li><li>$inputtext1 is dus ongeveer $h_ans rph</li></ul>
question$n=<a onmouseover="return escape('$helptext')">$ss</a>


!exit
    



