#dataset=$dataset;dataset:$(artikel$s);$(xydata$s) 
R=1
dataset=$empty
!if $R=1
    tmax=!randint 8,20
    break1=!randint 2,$[$tmax - 4]
    break2=!randint $[$break1 + 1],$[$tmax-1]
    factor=!randint 1,5
    afstand=0
    afstand1=0
    afstand2=0
    # gebied tussen $break1 en $break2 is de snelheid 0 m/s
    !for t=1 to $tmax
	!if $t<=$break1
	    weg=$[$weg + $factor]
	    afstand=$[$afstand + $factor]
	    afstand1=$[$afstand1+$factor]
	!else
	    !if $t>$break2
		weg=$[$weg-$factor]
		afstand=$[$afstand + $factor]
		afstand2=$[$afstand2 + $factor]
	  !else
		weg=$weg
	  !endif
	!endif
    dataset=!append word $t,$weg; to $dataset
  !next t
!endif

dataset=!nospace dataset;0,0;$dataset

tot=!exec pari A=$afstand1/$break1\
$afstand1/$break2\
$afstand/$tmax

V1=!line 1 of $tot
V2=!line 2 of $tot
V3=!line 3 of $tot
S1=$afstand
answer$n=$V1\
$V2\
$V3\
$S1

