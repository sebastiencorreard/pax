n=$counter
mathview=0
inputs=2
m_rightarrow=&nbsp;=&nbsp;
make_tr=1
checkfile=$checkdir/new_number.proc
v=!randint 500,2500
f=!randitem 10,50,100,1000
v=!exec moneyprint $[$v/100]
x=!randint 2,20
sigdig=!exec sigdigits $v
sig=$(sigdig[1])
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
significant=!item $sig of $telwoorden
description=diameter,volume vergroting
ex1=dm
ex2=&times;
display=1
formula$n=V_{bol} = \frac{1}{6} \pi \cdot d^{3} 
ans1=$[(6*$v/pi)^(1/3)]
tot=!exec scienceprint $ans1,$sig,0 $ans1,$sig,2
c_ans1=!item 1 of $tot
t_ans1=!item 2 of $tot
ans2=$[$x^3]
answer$n=$c_ans1\
$ans2
var2=0,0
var1=$[abs($ans1 - $c_ans1)],0

ss=Voor het volume van een bol met diameter <i>d</i> geldt de onderstaande formule.<br /><ul><li>Bereken <i>d</i> in <i>dm</i> als de bol een volume heeft van $v L</li><li>De diameter <i>d</i> wordt $x &times; groter.<br />Hoeveel keer groter wordt dan het volume ?</li></ul>
question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/bol.gif\' alt=\'bol\' />')">$ss</a>
texanswer$n=\left[ \begin{array}{ll} 1) & V_{bol} = \frac{1}{6} \pi \cdot d^{3} \rightarrow d^{3} = \frac{V}{\sfrac{\pi}{6}} = 6 \cdot \frac{V}{\pi} \\  & d = \left( 6 \cdot \frac{V}{\pi} \right)^{\frac{1}{3}} = \root{3} \of{ 6 \cdot \frac{V}{\pi} } \\  & V = $v L = $v \: dm^{3} \\  & d = \root{3} \of{ 6 \cdot \frac{$v}{\pi} } \approx $ans1 \: dm  \\  & \textrm{Het antwoord in $significant significante cijfers, afkomstig van $v } \\  & d = $t_ans1 \: dm \\ 2) & V = \frac{1}{6} \pi \cdot d^{3} \\   & d_{2} = $x \cdot d  \\ & V_{2} = \frac{1}{6}\pi \cdot \left( $x \cdot d \right)^{3} = \frac{1}{6}\pi \cdot d^{3} \times $x^{3} = V \times $x^{3} \\  & \textrm{dus een factor }\:  $x^{3} = $ans2 \end{array} \right.










