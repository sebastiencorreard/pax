#\begin{array}{l}\textrm{Het aantal mol }\;H_{3}O^{+} \; \textrm{blijft gelijk} \\ \textrm{We passen toe: } \\ V_{1} \cdot c_{1} + V_{2} \cdot c_{2} = (V_{1}+V_{2}) \cdot c_{3} \\ V_{1} \cdot c_{1} + V_{2} \cdot c_{2} = V_{1} \cdot c_{3} + V_{2} \cdot c_{3} \\ V_{2} \cdot c_{2} - V_{2} \cdot c_{3} = V_{1} \cdot c_{3} - V_{1} \cdot c_{1} \\ V_{2} \cdot ( c_{2} - c_{3})  = V_{1} \cdot (c_{3} - c_{1}) \\ \special{color=red}V_{2} = V_{1} \cdot \frac{(c_{3} - c_{1})}{(c_{2} - c_{3})} \\ V_{1} = $v1 \; L \\ V_{2} = [?] \\ c_{1} : pH = $ph1 \rightarrow \left[ H_{3}O^{+} \right] = c_{1} = 10^{-$ph1} \; mol / L \\ c_{2} : \textrm{de pH van verdunningswater} \; c_{2}= 10^{-7} mol/L \; H^{+} \\ c_{3} : pH = $ph2 \rightarrow \left[ H_{3}O^{+} \right] = c_{3}= 10^{-$ph2} \; mol / L \\ V_2 = $v1 \cdot \frac{10^{-$ph2} - 10^{-$ph1}}{ 10^{-7} - 10^{-$ph2}} \approx $v2 \;L \\ \textrm{Dit antwoord op $sig significante cijfers : } $t_v2 L  \end{array}

