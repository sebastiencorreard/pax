n=$counter
mathview=0
inputs=1.1
description=Aantal keer te veel
make_tr=1
checkfile=$checkdir/new_number.proc
ex1=$empty
diff=!randint 11,30
db=!randint 80,99
ss=Op een bepaalde plaats is sprake van geluidshinder van $db dB.<br />Dit is $diff dB meer dan toegestaan.<br />Hoeveel &times; teveel is de geluidsintensiteit dan?

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s15.jpg\' alt=\'noalt\' />')">$ss</a>
ans1=$[0.1*$db - 12]
db2=$[$db - $diff]
ans2=$[0.1*$db2 - 12]
ans=$[$ans1 - ($ans2)]
answer$n=$[10^($ans)]
var2=0.01
var1=100
texanswer$n=\left[ \begin{array}{l} I = 10^{0.1 \cdot L - 12} \\ L_{1} = $db \:\: dB \rightarrow I_{1} =  10^{0.1 \cdot $db - 12} = 10^{$ans1} \\ L_{2} = $db - $diff = $db2 \:\: dB \rightarrow I_{2} = 10^{0.1\cdot $db2 - 12 } = 10^{$ans2}  \\ \frac{I_{1}}{I_{2}} = \frac{10^{$ans1}}{ 10^{$ans2}} = 10^{$ans1 - $ans2} = 10^{$ans}\\ \textrm{Dus }\: 10^{$ans} \times \: \textrm{ te veel }  \end{array} \right.










