n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=2
ex1=dB
ex2=dB

r1=!randint 5,10
r2=$[$r1+5]
P=!randint 10,40
A1=$[4*pi*$r1*$r1]
A2=$[4*pi*$r2*$r2]
I1=$[$P/$A1]
I2=$[$P/$A2]
L1=$[10*(log($I1/(10^(-12))))/(log(10))]
L2=$[10*(log($I2/(10^(-12))))/(log(10))]
L3=$[round($L1-$L2)]
answer$n=$L1\
$[$L1-$L2]
var1=0.1,$[abs($(answer$n) - $L3)]
var2=10,10

#exotext=$var1
ss=Een bolvormige geluidsbron heeft een vermogen van $P W.<br />Het geluidsniveau hangt sterk af van de afstand tot de geluidsbron.<br /><br />a) Bereken het geluidsniveau in dB op een afstand van $r1 m.<br />b) Bereken de afname van het geluidsniveau als de afstand toeneemt tot $r2 m.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s15.jpg\' alt=\'noalt\' />')">$ss</a>

description=Geluidsniveau op $r1 meter,Afname geluidsniveau

texanswer$n=\left[ \begin{array}{ll} a) & I = \frac{P}{A} \;\; W/m^{2} \\  & A_{bol} = 4 \cdot \pi \cdot r^{2} \\  & A = 4\cdot \pi \cdot $r1^{2} \approx $A1 \\    & I = \frac{$P}{$A1} \approx $I1  \;\; W/m^{2} \\     & L = 10 \cdot \log \left( \frac{$I1}{10^{-12}} \right) \approx $L1 \\ b) & I = \frac{P}{A} \;\; W/m^{2} \\  & A_{bol} = 4 \cdot \pi \cdot r^{2} \\      & A = 4\cdot \pi \cdot $r2^{2} \approx $A2 \\  & I = \frac{$P}{$A2} \approx $I2  \;\; W/m^{2} \\ & L = 10 \cdot \log \left( \frac{$I2}{10^{-12}} \right) \approx $L2 \\  & \\   & \textrm{Een afname in geluidsniveau van :} \; $L1 - $L2 \approx $L3 \; dB \end{array} \right.










