n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/units.proc
h=!randint 20,80
H=$[$h/100]
v=!randint 20,200
V=$[$v/100]
sig1=!exec sigdigits $H
sig2=!exec sigdigits $V
sig1=$(sig1[1])
sig2=$(sig2[1])
sig=$[min($sig1,$sig2)]

g=9.81
t1=$[sqrt(2*$g)]

ss=Een bak is gevuld met water.<br />In de bodem zit een gaatje waardoor het water uit de bak <span class="schaersvoorde_link">stroomt</span>.<ol style="list-style-type:lower-alpha"><li>Bereken de uitstroomsnelheid bij een waterhoogte van $h cm.</li><li> Bereken de hoogte als de uitstroomsnelheid $v cm/s bedraagt.</li></ol>Geef je antwoord op in de juiste SI eenheid en significantie

#formula$n=\left[ \begin{array}{l} \textrm{Gegeven:} \\ \textrm{voor de uitstroomsnelheid van het water geldt : }\; v = \sqrt{2 \cdot g \cdot h} \\ \textrm{waarin }\ v \: \textrm{ de snelheid in}\: m/s \\ h \: \textrm{ is de hoogte van het water in meter} \\ g \: \textrm{ is de zwaartekrachtversnelling } \:$g m / s^{2} \end{array} \right.
inputs=2
description=a) v,b) h

ans1=$[$t1*sqrt($H)]
ans2=$[$V*$V/(2*$g)]
helptext=<img src=\'$module_dir/gifs/hfst2.s6.png\' alt=\'gegeven\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

tot=!exec scienceprint $ans1,$sig,0 $ans1,$sig,2 $ans2,$sig,0 $ans2,$sig,2
c_ans1=!item 1 of $tot
t_ans1=!item 2 of $tot
c_ans2=!item 3 of $tot
t_ans2=!item 4 of $tot
answer$n=$c_ans1 m/s,$c_ans2 m
var1=1,1
var2=$[abs($ans1-$c_ans1)],$[abs($ans2-$c_ans2)]
texanswer$n=\left[\begin{array}{ll} a) & v = \sqrt{2gh} = \sqrt{2 \cdot $g } \cdot \sqrt{h} = $t1 \cdot \sqrt{h}  \\ & h = $H m \\  & v_{h = $H m} = $t1 \cdot \sqrt{$H} \approx $ans1 \: m/s \\  & \textrm{De snelheid in $sig significante cijfers : } \: $t_ans1 m /s \\ b) & v = \sqrt{2gh} \rightarrow v^{2}= \left( \sqrt{2gh} \right)^{2} = 2gh \\ & h = \frac{v^{2}}{2g} \:\: m \\ & v = $V \: \: m/s \\ & h = \frac{$V^{2}}{2 \cdot $g} \approx $ans2 \: m \\ & \textrm{De hoogte in $sig significante cijfers : } \: $t_ans2 \: m \end{array} \right.










