n=$counter
# gelijk aan s33 maar dan met 10^(-x)
mathview=0
embed=1
inputs=1.1
cols=10
make_tr=1
questiontype=0
checkfile=$checkdir/simplify.proc
#x=!randitem x,y,c,k,m
wims_rawmath_variables=x
varlist=x
helptext=Als er geen grondtal wordt vermeld...veronderstellen we grondtal 10<br />log(a) == <sup>10</sup>log(a)
g=!randint 2,10
var2=$empty
var1=$empty
sig=!randint 2,5
getal=!randint 11,99
description=
tt=$[log($getal)/log(10)]
nn=$[log($g)/log(10)]
exp=$[$tt/$nn]
tot=!exec scienceprint $exp,$sig,0 $exp,$sig,2
answer$n=$g^(-$(tot[1])*x)
exp3=$(tot[2])
ss=Herschrijf de volgende uitdrukking in <i>x</i> als een macht met grondtal $g.<br />Geef de exponent op in $sig significante cijfers
formula$n=$getal^{-x} = $g^{?}
texanswer$n=\begin{array}{l} \textrm{Eerst de exponent uitrekenen:} \; $getal = $g^{?} \\ ^{$g} \log \left( $getal \right) = \frac{\log \left( $getal \right) }{\log($g)} = \frac{$tt}{$nn} = $exp \\ \textrm{De exponent in $sig significante cijfers : } \; $getal = $g^{$exp3} \\ $getal^{-x} = \left( $g^{$exp3} \right)^{-x} = $g^{- $exp3 \cdot x } \end{array} \right.

var1=$getal^(-x)

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s33.jpg\' alt=\'logaritme\' />')">$ss</a>

