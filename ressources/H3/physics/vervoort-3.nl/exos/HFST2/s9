n=$counter
mathview=0
inputs=1.1
description=Lengte van de balk
make_tr=1
var1=1
checkfile=$checkdir/units.proc
v=!randint 100,999
v=!exec moneyprint $[$v/100]
#sig=!charcnt $v
sig=3
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
significant=!item $sig of $telwoorden
f=!randint 20,99
f=$[$f/10]
ss=Een <span style="schaersvoorde_link">balk</span> heeft een lengte die $f &times; zo groot is als de breedte.<br />De doorsnede is een vierkant. Het volume is $v L<br />Bereken de lengte van de balk. <br />Geef je antwoord de juiste SI eenheid en significantie.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s9.jpg\' alt=\'balk\' />')">$ss</a>
b_ans=$[($v/$f)^(1/3)]
l_ans=$[$f*$b_ans]
tot=!exec scienceprint $l_ans,$sig,0 $l_ans,$sig,2
c_ans=!item 1 of $tot
t_ans=!item 2 of $tot
answer$n=$c_ans dm
var2=$[abs($l_ans-$c_ans)]

texanswer$n=\left[ \begin{array}{l} V_{balk} = A_{vierkant} \cdot l = b^{2} \cdot l \\ l = $f \cdot b \\ V = b^{2} \cdot $f \cdot b = $f \cdot b^{3} \\ \textrm{ V = volume  , l = lengte , b = breedte } \\ $f \cdot b^{3} = $v \: L = $v \: dm^{3} \\ b^{3} = \frac{$v}{$f} \: dm^{3} \\ b = \left( \frac{$v}{$f} \right)^{\frac{1}{3}} = \root{3} \of{\frac{$v}{$f}}  \approx $b_ans \: dm \\ l = $f \cdot $b_ans = $l_ans \: dm \\ \textrm{Het antwoord in $significant significante cijfers :} \: l = $t_ans  \: dm \end{array} \right.










