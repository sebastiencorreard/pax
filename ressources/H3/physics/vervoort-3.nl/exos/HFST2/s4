n=$counter
mathview=0
inputs=1.1
description=Lengte korte zijde
make_tr=1
var1=1
checkfile=$checkdir/units.proc
a=!randint 2,6
A=!randint 100,200
questiontype=0
ss=Van een <span style="schaersvoorde_link">rechthoek</span> is de lange zijde $a &times; zo groot als de korte zijde.<br />De oppervlakte van deze rechthoek is $A cm<sup>2</sup>.<br />Bereken de lengte van de korte zijde.<br />Geef je antwoord op in de correcte eenheid en significantie.

ans=$[sqrt($A/$a)]
sig=3
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2
c_ans=!item 1 of $tot
t_ans=!item 2 of $tot
answer$n=$c_ans cm
var2=$[abs($ans-$c_ans)]
texanswer$n=\left[\begin{array}{l} A = l \times b = $a \cdot b \times b = $a \cdot b^{2} \\ A  = $A \: cm^{2} \\ $A = $a \cdot b^{2} \\ b^{2} = \frac{$A}{$a} \\ b = \sqrt{ \frac{$A}{$a} } \approx $ans \: cm \\ \textrm{Antwoord in $sig significante cijfers:} b =  $t_ans \: cm \end{array} \right.
max=$[round($a*$c_ans)]
k=!randitem red,green,blue,cyan,lightblue.lightgreen,orange
!insdraw 200,200\
transparent white\
xrange 0,$max\
yrange 0,$max\
frect 0,$max,$max,$[$max-$c_ans],$k
insdraw_size=200,200
question$n=<a onmouseover="return escape('<img src=\'$wims_ref_name?&session=$session&module=$module&cmd=getins&special_parm=insert-1.gif\' />')">$ss</a>







