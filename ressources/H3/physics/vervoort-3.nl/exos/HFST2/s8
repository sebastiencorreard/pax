n=$counter
mathview=0
inputs=1.1
description=Diameter van de cilinder
make_tr=1
var1=1
checkfile=$checkdir/units.proc
v=!randint 100,999
v=!exec moneyprint $[$v/100]
#sig=!charcnt $v
sig=3
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
significant=!item $sig of $telwoorden
f=!randint 15,75
f=$[$f/10]
p=$[2*$f]
ss=Een <span style="schaersvoorde_link">cilinder</span> heeft een lengte die $f &times; zo groot is als de diameter.<br />De cilinder heeft een volume van $v liter.<br />Bereken de diameter.<br />Geef je antwoord de juiste SI eenheid en significantie.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s8.jpg\' alt=\'cilinder\' />')">$ss</a>
r_ans=$[($v/($p*pi))^(1/3)]
d_ans=$[2*$r_ans]
tot=!exec scienceprint $d_ans,$sig,0 $d_ans,$sig,2
c_ans=!item 1 of $tot
t_ans=!item 2 of $tot
answer$n=$c_ans dm
var2=$[abs($d_ans-$c_ans)]

texanswer$n=\left[ \begin{array}{l} V_{cilinder} = A \cdot h = \pi \cdot r^{2} \cdot h \\ d = 2 \cdot r \\ h = $f \cdot d \rightarrow h = $p \cdot r \\ \textrm{ V = volume  , h = hoogte , r = radius , d = diameter} \\ V = \pi \cdot \r^{2} \cdot $p \cdot r = $p \cdot \pi \cdot r^{3} \\ r^{3} = \frac{V}{$p \cdot \pi} \\ r = \left( \frac{V}{$p \cdot \pi} \right)^{\frac{1}{3}} = \root{3} \of{ \frac{V}{$p \cdot \pi} } \\ r = \root{3} \of{ \frac{ $v dm^{3} }{ $[$p*pi] } } \approx $r_ans \: dm \\  d = 2 \cdot $r_ans  = $d_ans  \: dm \\ \textrm{Het antwoord in $significant significante cijfers :} \: d = $t_ans  \: dm \end{array} \right.










