n=$counter
mathview=0
make_tr=1
questiontype=0
checkfile=$checkdir/new_number.proc
inputs=1.1
f=!randint 4,9
factor=10^$f
h_factor=10<sup>$f</sup>
hr=!randint 20,50
hr=!exec moneyprint $[$hr/10] 1
sig=2
min=$[60*$hr]
N=$[log(2)*$f/(log(10))]
T2=$[$min/$N]
tot=!exec scienceprint $T2,$sig,0 $T2,$sig,2
answer$n=$(tot[1])
var1=$[abs($T2-$(answer$n))]
var2=0
ss=Een bepaalde bacterie vermenigvuldigt zich in $hr uur met een factor $h_factor.<br />Bereken de generatie of verdubbelingstijd.<br />Geef je antwoord op in de correcte precisie.

helptext=Let op de tijd notatie !<br />Bij deze opdracht geldt: 1.2 uur is 1.2 &times; 60 min = 72 minuten
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=minuten
description=Verdubbelingstijd
texanswer$n=\left[ \begin{array}{l} 2^{n} = 10^{$f} \rightarrow n = ^{2}\log\left(10^{$f}\right) \\ n = \frac{ \log\left( 10^{$f}\right)}{\log(2)} \approx \frac{$f}{$[log(2)/log(10)]} \approx $N \\ $hr = $hr \cdot 60 =  $min \;\textrm{min} \\ T_{2} \cdot $N  = $min  \rightarrow T_{2} = \frac{$min}{$N} \approx $T2 \;\textrm{min} \\ \textrm{Dit antwoord in $sig significante cijfers , afkomstig van $hr } \\ T_{2} = $(tot[2])  \;\textrm{min} \end{array} \right.

math=0
!exit
