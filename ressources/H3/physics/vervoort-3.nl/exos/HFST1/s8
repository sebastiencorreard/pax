n=$counter
math=0
cols=18
inputs=1.1
rounding=-1
mathview=0
image=0
plot=0
make_tr=1
checkfile=exos/science.proc
embed=1
science_calc=$empty
science_html=$empty
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
!if $options>4
    options=4
!else
    !if $options<2
	options=2
    !endif
!endif
inputs=$options

formula$n=\left\{ \begin{array}{l}

texanswer$n=\left[ \begin{array}{l}

!for r=1 to $inputs
    c=!randint 1,3
    s=!randint 0,9
    getal1=$s .
    !for p=1 to $c
	s=!randint 0,9
        getal1=!append word $s to $getal1
    !next p
    s=!randint 0,9
    getal2=$s .
    d=!randint 0,3
    !for p=1 to $[$c+$d]
	s=!randint 0,9
        getal2=!append word $s to $getal2
    !next p
    getal1=!nospace $getal1
    getal2=!nospace $getal2
    e2=!randint 2,15
    # e1 groter/ e2
    e1=!randint $[$e2+1],$[$e2+$sig]
    keuze=!randint 0,1
    !if $keuze=0
	# bij 0 exp e1 en e2 verwisselen
        a1=$[-1*$e2]
	e2=$[-1*$e1]
	e1=$a1
    !endif
    
    k=!randint 0,1
    pm=!randitem +,-
    t=!randint 0,1
    k=1
    !if $k=0
	# bij optellen kleinste aantal dec. getallen gebruiken
	tot=!exec sigdigits $getal1 $getal2
	tot1=!line 1 of $tot
	tot2=!line 2 of $tot
	!if $(tot1[3]) < $(tot2[3])
	    dec=$(tot1[3])
	    decgetal=$getal1
	!else
	    dec=$(tot2[3])
	    decgetal=$getal2
	!endif
	!if $t=0
	    formule=$ $getal1 \times 10^{$e1} $pm $getal2 \times 10^{$e2} $
	    ans=!exec moneyprint $[($getal1*10^($e1)) $pm ($getal2*10^($e2))] $dec
	!else
	    formule=$ $getal2 \times 10^{$e2} $pm $getal1 \times 10^{$e1} $
	    ans=!exec moneyprint $[($getal2*10^($e2)) $pm ($getal1*10^($e1))] $dec
	!endif
	tex=!texmath $ans
    !else
	getal3=!randint 100,1000
	dec3=!randint 1,5
	getal3=!exec moneyprint $[$getal3/300] $dec3
	c1=!charcnt $getal1
	c2=!charcnt $getal2
	min=$[min($c1,$c2)]
	min=$[$min-1]
	!if $t=0
	    ans_optelling=!exec scienceprint $[(($getal1*10^($e1)) $pm ($getal2*10^($e2)))],$min,0
	    formule=$getal3 \cdot \left( $getal1 \times 10^{$e1} $pm $getal2 \times 10^{$e2} \right)	
	!else
	    ans_optelling=!exec scienceprint $[(($getal2*10^($e2)) $pm ($getal1*10^($e1)))],$min,0
	    formule=\left( $getal2 \times 10^{$e2} $pm $getal1 \times 10^{$e1} \right) \cdot $getal3
	!endif
	ans=$[$getal3*($ans_optelling)]
	# zoeken naar kleinste aantal decimalen in de optelling
	tot=!exec sigdigits $getal1 $getal2
	tot1=!line 1 of $tot
	tot2=!line 2 of $tot
	dec1=$(tot1[3])
	dec2=$(tot2[3])
	!if $dec1<$dec2
	    dec_min=$dec1
	!else
	    dec_min=$dec2
	!endif
	# drukken de optelling uit in laagste aantal decimalen
	ans_optelling=!exec moneyprint $ans_optelling $dec_min
	# nu zoeken naar laagste significantie in $getal3 x $ans_optelling
	tot=!exec sigdigits $getal3 $ans_optelling
	tot1=!line 1 of $tot
	tot2=!line 2 of $tot
	sig1=$(tot1[1])
	sig2=$(tot2[1])
	!if $sig1<$sig2
	    sig=$sig1
	    siggetal=$getal3
	!else
	    sig=$sig2
	    siggetal=het resultaat de berekening tussen de haakjes ($ans_optelling in $dec_min decimalen)
	!endif
	sigtext=$sig significante cijfers
        tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2
        ans=!item 1 of $tot
        tex=!item 2 of $tot
    !endif
    formula$n=!append word $ $formule  \\ $ to $(formula$n)
    answer$n=!append item $ans to $(answer$n)
    texanswer$n=!append word $ $formule = $tex \\ \left( \emph{\textrm{in $sigtext afkomstig van $siggetal }} \right) \\ $ to $(texanswer$n) 
!next r

formula$n=!append word $ \end{array} \right. $ to $(formula$n)

texanswer$n=!append word $ \end{array} \right. $ to $(texanswer$n)

ss=Bereken en geef het antwoord in SCI-mode met de <span style="color:blue">juiste significantie</span>.

helptext=Regels voor significante cijfers :<ul><li>Deze regels zijn alleen van interesse bij resultaten uit experimenten, waarbij dus meetnauwkeurigheid een rol speelt.</li><li>Nullen voor de cijfers 1 - 9 zijn nooit significant.<br />bijv.: 0.0000000082 alleen de &rsquo;8&rsquo; en de &rsquo;2&rsquo; zijn significante cijfers </li><li>Eindstandige nullen in decimale getallen zijn significant: 1.1000 [5 sig. cijfers]</li><li>Eindstandige nullen in niet-decimale getallen zijn niet eenduidig zonder verder beschrijving. Bijvoorbeeld: voor 3500 kan natuurlijk gelden <br />2499 &le; meting &le; 3501<br />3400 &le; meting &le; 3600<br />Geef daarom de voorkeur aan SCI notatie: 3.500&times;10<sup>3</sup> is wel eenduidig.</li><li>Alle andere cijfers zijn altijd significant</li></ul><hr /><ul><li>Bij berekeningen: altijd rekenen tot het eindantwoord met onafgeronde getallen.</li><li>Bij vermenigvuldiging en deling wordt het resultaat uitgedrukt in het laagste aantal significante cijfers van de gebruikte getallen.<br />Bijvoorbeeld:<br />A = 2 &times; &pi; &times; R &amp; R = 12.3 : A = 2 &times; 3.1415... &times; 12.3 = 77.28317...<br />A = 77.3 : We moeten dit getal uitdrukken in 3 significante cijfers, afkomstig van R.<br />De factor 2 is een wiskundig factor zonder invloed op significantie.<br />De factor &pi; is eveneens een wiskundig factor zonder invloed op significantie.</li><li>Bij optellen en aftrekken kan als vuistregel het aantal significante cijfers uit het getal met het laagste aantal decimalen worden genomen.<br />Bijvoorbeeld : 100.0 + 1.123456789 = 101.1 </li></ul>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

m_rightarrow=&nbsp;=&nbsp;
!exit


    
