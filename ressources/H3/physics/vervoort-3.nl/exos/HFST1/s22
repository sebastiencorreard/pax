n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
draw=1
plot=0
make_tr=1

inputs=2
description=De massa in <kbd>atomaire massa-eenheid</kbd>,De massa in <kbd>kg</kbd>
ex1=&nbsp;<kbd>u</kbd>
ex2=&nbsp;<kbd>kg</kbd>
m_rightarrow=&nbsp;=&nbsp;
m=!randint 1,103
# 4 significante cijfers
!if $m<100
    m=!nospace $m .00
!else
    m=!nospace $m .0
!endif
ss=&Eacute;&eacute;n atoom van een bepaald element heeft een massa van $m <kbd>u</kbd>.<br /><kbd>u</kbd> is de <a target="new" href="http://nl.wikipedia.org/wiki/Atomaire_massa-eenheid">atomaire massa-eenheid</a> en wordt vooral gebruikt bij het<br />rekenen met kleine deeltjes zoals atomen en moleculen.<br />Bereken de <span style="color:blue">massa van 1 mol</span> van deze stof in <kbd>u</kbd> en in g.

U=1.660538921*10^(-27)
h_U=1.660538921 &times;10<sup>-27</sup>
Mu=$[$m*6.022*10^23]
Mg=$[$Mu*($U)]
tot=!exec scienceprint $Mu,4,0 $Mu,4,1 $Mg,4,0 $Mg,4,0
ans1=!item 1 of $tot
h_ans1=!item 2 of $tot
ans2=!item 3 of $tot
h_ans2=!item 4 of $tot

answer$n=$ans1,$m
checkfile=$checkdir/units.proc
# hoeft geen eenheid
var1=0,0
var2=$[abs($ans1-$Mu)],$[abs($ans2-$Mg)]

textanswer$n=<ol><li>M = N &times; $m = 6.022&times;10<sup>+23</sup> &times; $m = $Mu <kbd>u</kbd><br />Op 4 significante cijfers M = $h_ans1 <kbd>u</kbd></li><li>M = $Mu &times; $h_U kg = $Mg kg <br />Op 4 significante cijfers M = $h_ans2 <kbd>kg</kbd><br />Let op: dit is dus per definitie : $m g</li></ol>

helptext=<span size=\'+1\'> 1 <kbd>u</kbd> = (1.660538921 &plusmn; 0.000000073) &times; 10<sup>-27</sup> kg<br />N = 6.022 &times; 10<sup>23</sup> (constante van <em>Avogadro</em>)</span>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit




