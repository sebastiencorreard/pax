# machten hrleiden
n=$counter
embed=1
questiontype=0
mathview=0
make_tr=1
rounding=0
checkfile=$checkdir/new_number.proc
var1=$empty
var2=$empty
cols=8
rows=1
exotext=$empty
choice=!randint 1,4
!if $choice=1
    B=!randitem 12,18,24
    g=!randitem 1,2,3,4,5
    !if $B=12
	a=$[2*$g]
        b=$g
	texanswer$n=$B^{$g} = \left(4 \cdot 3 \right)^{$g} = \left(2^{2} \cdot 3 \right)^{$g} = 2^{2 \cdot $g} \cdot 3^{$g} = 2^{$a} \cdot 3^{$b} \rightarrow \left[ \begin{array}{lcl} a & = & $a \\ b & = & $b \end{array} \right.

    !else
	!if $B=18
    	    a=$g
	    b=$[2*$g]
	    texanswer$n=$B^{$g} = \left(2 \cdot 9 \right)^{$g} = \left(2 \cdot 3^{2} \right)^{$g} = 2^{$g} \cdot 3^{2 \cdot $g} = 2^{$a} \cdot 3^{$b}  \rightarrow \left[ \begin{array}{lcl} a & = & $a \\ b & = & $b \end{array}  \right.
    
	!else
	    !if $B=24
		a=$[3*$g]
	        b=$g
		texanswer$n=$B^{$g} = \left(8 \cdot 3 \right)^{$g} = \left(2^{3} \cdot 3 \right)^{$g} = 2^{3 \cdot $g} \cdot 3^{$g} = 2^{$a} \cdot 3^{$b}  \rightarrow \left[ \begin{array}{lcl} a & = & $a \\ b & = & $b \end{array} \right.
	    !endif
	!endif
    !endif
    formula$n=\left\{\begin{array}{lcl}  $B^{$g} & = & 2^{a} \cdot 3^{b} \\ a & = & [?] \\ b & = & [?] \end{array} \right. \rightarrow
    inputs=2
    m_rightarrow=&nbsp;=
    description=&nbsp;<kbd>a</kbd>,&nbsp;<kbd>b</kbd>
    answer$n=$a\
    $b
    question$n=Voor welke waarden van <kbd>a</kbd> en <kbd>b</kbd> geldt:
 !exit
!endif
    
!if $choice=2
    
    p=!randitem 1,2,3,4,5
    q=!randitem 1,2,3,4,5
    r=!randitem 1,2,3,4,5
    
    formula$n=\left\{\begin{array}{l} \displaystyle{ \left(\frac{2 a^{$p}}{ b^{-$q}} \right)^{$choice}  =  2^{x} \cdot a^{y} \cdot b^{z} } \\ x = [?] \\ y = [?] \\ z = [?] \end{array} \rightarrow
    x=$choice
    y=$[$p*$choice]
    z=$[$q*$choice]
    
    texanswer$n=\left(\frac{2 a^{$p}}{ b^{-$q}} \right)^{$choice} = \left( \frac{2^{$choice} \cdot a^{$p \cdot $choice}}{b^{-$q \cdot $choice} }\right) = 2^$x \cdot a^{$y} \cdot b^{$z}  \rightarrow \left[ \begin{array}{l} x  = $x \\ y = $y \\ z = $z \end{array} \right.
    
    inputs=3
    m_rightarrow=&nbsp;=
    description=&nbsp;<kbd>x</kbd>,&nbsp;<kbd>y</kbd>,&nbsp;<kbd>z</kbd>
    answer$n=$x\
    $y\
    $z
    
    question$n=Voor welke waarden van <kbd>x</kbd>, <kbd>y</kbd> en <kbd>z</kbd> geldt:
 !exit
!endif

!if $choice=3
    
    B=!randitem 6,9,12
    p=!randint 1,5
    q=!randint 1,5
    !if $B=6
	a=$[4-$p]
        b=$[-1*$p - $q]
	texanswer$n=\frac{$B^{-$p}}{3^{$q}} \cdot 2^{4} = \frac{(2 \cdot 3)^{-$p} }{3^{$q}} \cdot 2^{4} = 2^{-$p}  \cdot 3^{-$p} \:\:\: \cdot 2^{4}  \cdot \:\:\: 3^{-$q} = 2^{4-$p} \cdot 3^{-$p - $q} \rightarrow \left[ \begin{array}{l} a = 4 - $p = $a \\ b = -$p - $q = $b \end{array} \right.
    
    !else
	!if $B=9
	    a=4
	    b=$[-2*$p - $q]	
	
	    texanswer$n=\frac{$B^{-$p}}{3^{$q}} \cdot 2^{4} = \frac{\left(3^{2}\right)^{-$p} }{3^{$q}} \cdot 2^{4} = \frac{3^{2\cdot -$p} }{3^{$q}} \cdot 2^{4} = 2^{4} \cdot 3^{-2\cdot $p - $q} \rightarrow \left[ \begin{array}{l} a = 4 \\ b = -2\cdot $p - $q = $b \end{array} \right.
	
	!else
	    !if $B=12
		a=$[-2*$p+4]
		b=$[-1*$p - $q]
	
		texanswer$n=\frac{$B^{-$p}}{3^{$q}} \cdot 2^{4} = \frac{(4 \cdot 3)^{-$p} }{3^{$q}} \cdot 2^{4}  = \frac{(2^{2} \cdot 3)^{-$p} }{3^{$q}} \cdot 2^{4}  = 2^{-2 \cdot $p} \cdot 2^{4} \cdot 3^{-$p} \cdot 3^{-$q} ]  = 2^{-2 $p + 4} \cdot 3^{-$p - $q} \rightarrow \left[ \begin{array}{l} a = -2\cdot $p + 4 = $a \\ b = -$p - $q = $b \end{array} \right.
	
	    !endif
	!endif
    !endif
    
    formula$n=\left\{ \begin{array}{l} \displaystyle{\frac{$B^{-$p}}{3^{$q}} \cdot 2^{4} = 2^{a} \cdot 3^{b}} \\ a = [?] \\ b = [?]  \end{array} \right. \rightarrow
    
    inputs=2
    m_rightarrow=&nbsp;=
    description=&nbsp;<kbd>a</kbd>&nbsp;,&nbsp;<kbd>b</kbd>&nbsp;
    answer$n=$a\
    $b
    
    question$n=Voor welke waarden van <kbd>a</kbd> en <kbd>b</kbd> geldt:

 !exit
!endif

!if $choice=4

    B=!randitem 10,20,40
    p=!randitem 0,1,2,3,4,5
    !if $B=10
	a=$p
        b=$[$p-1]
    
	texanswer$n=\frac{$B^{$p}}{2} = \frac{\left(5 \cdot 2 \right )^{$p}}{2} = \left(5 \cdot 2 \right)^{$p} \cdot 2^{-1} = 5^{$p} \cdot 2^{$p} \cdot 2^{-1} =  5^{$p} \cdot 2^{$p - 1} \rightarrow \left[ \begin{array}{l} a = $a \\ b = $p - 1 = $b \end{array}\right.
    
    !else
	!if $B=20
	    a=$p
	    b=$[2*$p - 1]
	
	    texanswer$n=\frac{$B^{$p}}{2} = \frac{\left(5 \cdot 4 \right)^{$p}}{2} = \left(5 \cdot 2^{2} \right)^{$p} \cdot 2^{-1} = 5^{$p} \cdot 2^{2\cdot $p} \cdot 2^{-1} =  5^{$p} \cdot 2^{2\cdot $p - 1} \rightarrow \left[ \begin{array}{l} a = $a \\ b = 2 \cdot $p - 1 = $b \end{array}\right.
	
	!else
	    !if $B=40
		a=$p
		b=$[3*$p-1]
	    
		texanswer$n=\frac{$B^{$p}}{2} = \frac{\left(5 \cdot 8 \right)^{$p}}{2} = \left(5 \cdot 2^{3} \right)^{$p} \cdot 2^{-1} = 5^{$p} \cdot 2^{3\cdot $p} \cdot 2^{-1} =  5^{$p} \cdot 2^{3 \cdot $p - 1} \rightarrow \left[ \begin{array}{l} a = $a \\ b = 3 \cdot $p - 1 = $b \end{array}\right.

	    !endif
	!endif
    !endif

    formula$n=\left\{ \begin{array}{l} \displaystyle{\frac{$B^{$p}}{2} = 5^{a} \cdot 2^{b}} \\ a = [?] \\ b = [?]  \end{array} \right. \rightarrow

    inputs=2
    m_rightarrow=&nbsp;=
    description=&nbsp;<kbd>a</kbd>&nbsp;,&nbsp;<kbd>b</kbd>&nbsp;
    answer$n=$a\
    $b

    question$n=Voor welke waarden van <kbd>a</kbd> en <kbd>b</kbd> geldt:

 !exit
!endif

