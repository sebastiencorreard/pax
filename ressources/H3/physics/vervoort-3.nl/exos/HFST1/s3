# grontal
n=$counter
embed=1
questiontype=0
mathview=3
make_tr=1
rounding=0
smallfont=18
largefont=24
checkfile=$checkdir/simplify.proc
X=x,a,b,f,h,k
Y=y,b,c,w,z,p
k=!randint 1,6
x=!item $k of $X
y=!item $k of $Y

varlist=$x,$y
g=!shuffle 2,3,4,5,6,7,8,9
a1=!item 1 of $g
a2=!item 2 of $g
b1=!item 3 of $g
b2=!item 4 of $g
keuze=!randint 0,2
!if $keuze=0
    var1=!nospace $x^$a1 * $y^$b1 * $x^$a2 / $y^$b2 
    answer$n=$x^($[$a1+$a2])*$y^($[$b1-$b2])
    texanswer$n=\frac{$x^{$a1} \cdot $y^{$b1} \cdot $x^{$a2}}{$y^{$b2}} =  $x^{$a1 + $a2} \cdot \frac{$y^{$b1}}{$y^{$b2}} = $x^{$[$a1+$a2]} \cdot $y^{$b1} \cdot $y^{-$b2} = $x^{$[$a1+$a2]} \cdot $y^{$b1-$b2} = $x^{$[$a1+$a2]} \cdot $y^{$[$b1-$b2]} 
!else
    !if $keuze=1
	var1=!nospace $y^$b1 * $x^$a1  / ( $x^$a2 * $y^$b2) 
	answer$n=$x^($[$a1-$a2])*$y^($[$b1-$b2])
	texanswer$n=\frac{$y^{$b1} \cdot $x^{$a1}}{$x^{$a2} \cdot $y^{$b2}} = $y^{$b1} \cdot $x^{$a1} \cdot $x^{-$a2} \cdot $y^{-$b2} = $y^{$b1 - $b2} \cdot $x^{$a1 - $a2}  = $y^{$[$b1 - $b2]} \cdot $x^{$[$a1 - $a2]} 
    !else
	var1=!nospace $x^$a1 / $y^$b1 * $y^$b2 / $x^$a2 
	answer$n=$x^($[$a1-$a2])*$y^($[$b2-$b1])
	texanswer$n= \frac{$x^{$a1}}{$y^{$b1}} \cdot \frac{ $y^{$b2}}{ $x^{$a2}} = \frac{$x^{$a1}}{$x^{$a2}} \cdot \frac{ $y^{$b2}}{ $y^{$b1}} = $x^{$a1} \cdot $x^{-$a2} \cdot $y^{$b2} \cdot $y^{-$b1} = $x^{$a1 - $a2} \cdot $y^{$b2 - $b1} = $x^{$[$a1 - $a2]} \cdot $y^{$[$b2 - $b1]} 
    !endif
!endif
applettext=!nospace $var1 = 
mathviewpanel=$module_title:^:+:-:/:
question$n=Herleid de onderstaande uitdrukking tot een simpeler vorm:
 
!exit
