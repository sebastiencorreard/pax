n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
draw=1
plot=0
make_tr=1

k=!randint 1,26

voorbeelden=aceton,0.80\
Natriumhydroxide 25%,1.30\
alcohol,0.79\
benzine,0.72\
benzeen,0.88\
bier,1.02\
chloroform,1.48\
ether,0.72\
dieselolie,0.84\
glycerine,1.26\
kwik,13.596\
melk,1.03\
lijnolie,0.94\
olijfolie,0.92\
raapolie,0.91\
terpentijnolie,0.84\
n-pentaan,0.63\
petroleum,0.80\
salpeterzuur (100%),1.50\
tetrachloorkoolstof,1.63\
tolueen,0.88\
water,0.998\
zeewater,1.024\
zoutzuur (100%),1.18\
zwavelzuur (100%),1.84

K=!line $k of $voorbeelden
vloeistof=!item 1 of $K
sg=!item 2 of $K
SG=$[1000*$sg]
inputs=1.1
description=De vloeistof druk op de bodem
ex1=&nbsp;N/m<sup>2</sup>
m_rightarrow=&nbsp;=&nbsp;
Hoogte=!randint 200,1500
hoogte=!exec moneyprint $[$Hoogte/100] 2

ss=Hoe hoger de <span style="color:blue">vloeistofkolom</span> hoe groter de druk op de bodem.<br />We vullen de kolom met <span style="color:blue">$vloeistof</span>.<br />Bereken de vloeistofdruk op de bodem bij een hoogte van $hoogte cm<br />Gegeven is <em>g</em>=9.81 N/kg.

tot=!exec sigdigits $sg $hoogte
sig=3
w=3
tst=soortelijke massa,hoogte,g
!for p=1 to 2
    t=!line 1 of $tot
    t=!item 1 of $t
    !if $t<$sig
	sig=$t
	w=$p
    !endif
!next p
welke=!item $w of $tst
druk=$[$sg*10^3*9.81*$hoogte*10^(-2)]
tot=!exec scienceprint $druk,$sig,0 $druk,$sig,2
ans=!item 1 of $tot
t_ans=!item 2 of $tot
checkfile=$checkdir/units.proc
# hoeft geen eenheid
var1=0
var2=$[abs(ans-$druk)]
answer$n=$ans

