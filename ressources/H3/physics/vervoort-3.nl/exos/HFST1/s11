n=$counter
math=0
cols=12
rounding=-1
mathview=0
applet=0
image=0
plot=0
make_tr=1
checkfile=exos/science.proc
gw=kg,g,mg
fw=10^0,10^3,10^6
hw=10<sup>0</sup>,10<sup>3</sup>,10<sup>6</sup>

L1=m,dm,cm,mm
HL1=m,dm,cm,mm
F1=10^0,10^1,10^2,10^3

L2=m^2,dm^2,cm^2,mm^2
HL2=m<sup>2</sup>,dm<sup>2</sup>,cm<sup>2</sup>,mm<sup>2</sup>
F2=10^0,10^2,10^4,10^6

L3=m^3,dm^3,cm^3,mm^3
HL3=m<sup>3</sup>,dm<sup>3</sup>,cm<sup>3</sup>,mm<sup>3</sup>
F3=10^0,10^3,10^6,10^9

# 1 kg  = 1000 gr  = 1000000 mg
# 1 m^1   = 10 dm = 100 cm   = 1000 mm  |^1
# 1 m^2   = 100 dm  = 10000 cm = 1000000 mm |^2
# 1 m^3   = 1000 dm =1000000 cm  = 10^9 mm |^3
# 1 m^-1  = 0.1 dm = 0.01 cm   = 0.0001 mm |^-1
# 1 m^-2  = 0.01 dm = 0.0001 cm = 0.000001 mm |^-2
# 1 m^-3  = 0.001 dm =0.000001 cm  = 10^-9 mm |^-3


textanswer$n=<ol>
!if $options<2
    options=2
!endif
inputs=$options
answers=$empty
getallen=$empty
ol_type=a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z
description=$empty
!for p=1 to $inputs
    g0=!randint 0,9
    g1=!randint 0,9
    g2=!randint 0,9
    g3=!randint 0,9
    g4=!randint 0,9
    g5=!randint 0,9
    dec=!randint 1,5
    getal=$g0 .
    !for d=1 to $dec
	getal=!append word $(g$d) to $getal
    !next d
    getal=!nospace $getal
    !if $[1*$getal]=0
	# 0.000
	gc=!randint 1,9
	getal=!append word $gc to $getal
	getal=!nospace $getal
    !endif 
    getallen=!append word $getal to $getallen
    a=!item $p of $ol_type
    # gewichten
    gew=!shuffle 1,2,3
    p1=!item 1 of $gew
    p2=!item 2 of $gew
    # eerste eenheid kg/?
    V1=!item $p1 of $gw
    A1=!item $p2 of $gw
    # reken factoren
    vf1=!item $p1 of $fw
    af1=!item $p2 of $fw
    # lengte/opp/inh
    kans=!randint 1,3
    kans=2
    len=!shuffle 1,2,3,4
    maat=$(L$kans)
    maat_factor=$(F$kans)
    maat_html=$(HL$kans)
    p1=!item 1 of $len
    p2=!item 2 of $len
    # tweede eenheid ?/mm^2
    V2=!item $p1 of $maat_html
    A2=!item $p2 of $maat_html
    # factoren
    vf2=!item $p1 of $maat_factor
    af2=!item $p2 of $maat_factor
    oper=!randint 0,1
    !if $oper=1
	op=/
	factor=$[$af1*(1/$af2)/($vf1*(1/$vf2))]
    !else
	op=&sdot;
	factor=$[$af1*$af2/($vf1*$vf2)]
    !endif
    description=!append item $p)&nbsp;$getal <kbd>$V1$op$V2</kbd> to $description
    ex$p=&nbsp;<kbd>$A1$op$A2 </kbd>
    answers=!append item $[$factor*$getal] to $answers
!next p
m_rightarrow=&nbsp;=&nbsp;
sigdigits=!exec sigdigits $getallen
h_science=$empty
c_science=$empty
digits=$empty
exotext=$empty
!for p=1 to $inputs
    G=!item $p of $answers
    S=!line $p of $sigdigits
    sig=$(S[1])
    digits=!append item $sig to $digits
    h_science=!append word $G,$sig,1 to $h_science
    c_science=!append word $G,$sig,0 to $c_science
!next p

tot=!exec scienceprint $c_science $h_science
var1=$empty
var2=$empty
rr=<table summary="textanswer">

!for p=1 to $inputs
    G=!item $p of $answers
    c_ans=!item $p of $tot
    h_ans=!item $[$p+$inputs] of $tot
    answer$n=!append item $c_ans to $(answer$n)
    var1=!append item $[abs($G-$c_ans)] to $var1
    var2=!append item 0 to $var2
    sig=!item $p of $digits
    rr=!append line <tr><td><span style="color:blue">$(inputtext$p)</span></td><td>=</td><td>$h_ans $(ex$p)</td><td>&nbsp;in $sig significante cijfers</td></tr> to $rr
!next p

rr=!append word </table> to $rr

ss=Zet de volgende eenheden om en schrijf de waarde in<br />wetenschappelijke notatie met dezelfde significantie.

sometext=<ul><li>1 kg  = 10<sup>3</sup> g  = 10<sup>3</sup> &times; 10<sup>3</sup> mg = 10<sup>6</sup> mg</li><li>1 m   = 10<sup>1</sup> dm = 10<sup>2</sup> cm   = 10<sup>3</sup> mm </li><li>1 m<sup>2</sup>  = 10<sup>1</sup>&times;10<sup>1</sup> dm<sup>2</sup> = 10<sup>2</sup> dm<sup>2</sup> = 10<sup>2</sup>&times;10<sup>2</sup> cm = 10<sup>4</sup> cm<sup>2</sup> =  10<sup>3</sup>&times;10<sup>3</sup> mm = 10<sup>6</sup> mm</li><li>1 m<sup>3</sup>  = 10<sup>1</sup>&times;10<sup>1</sup>&times;10<sup>1</sup> dm<sup>3</sup> = 10<sup>3</sup> dm<sup>3</sup> = 10<sup>2</sup>&times;10<sup>2</sup>&times;10<sup>2</sup> cm<sup>3</sup> = 10<sup>6</sup> cm<sup>3</sup> = 10<sup>3</sup>&times;10<sup>3</sup>&times;10<sup>3</sup> mm<sup>3</sup> = 10<sup>9</sup> mm<sup>3</sup></li></ul>

helptext=$empty
question$n=$ss
textanswer$n=<a onmouseover="return escape('$sometext')">$rr</a>
!exit




