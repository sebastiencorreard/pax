n=$counter

!if ? isin $(reply$n)
    goback=0
    maxscore=0
    remark$n=$NOK
    !exit
!endif

t=!itemcnt $(reply$n)
!for p=1 to $t
    P=!item $p of $(reply$n)
    !if ^ notin $P
	errortext=Je moet het antwoord als een macht schrijven...<br />dus iets met eenn <b>^</b>-symbool.
	goback=1
	!exit
    !endif
!next p
!readproc $checkdir/new_number.proc
