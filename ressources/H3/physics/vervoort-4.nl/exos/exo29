n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=1.1
sig=4
c=!randint 10,100
poh=$[-1*log($c/1000)/log(10)]
ph=$[14-$poh]
tot=!exec scienceprint $[$c/1000],$sig,0 $[$c/1000],$sig,2 $[$c/1000],$sig,1 $ph,$sig,0 $ph,$sig,2
c=$(tot[1])
C=$(tot[2])
h_C=$(tot[3])
c_ph=$(tot[4])
t_ph=$(tot[5])
ss=Voor een vloeistof geldt: [OH<sup>-</sup>] = $h_C mol/L<br />Bereken de pH van de vloeistof.

answer$n=$ph
var1=$[abs($ph-$c_ph)]
var2=0
helptext=<img src=\'$module_dir/gifs/ph.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=De pH waarde 
texanswer$n=\begin{array}{l} pOH = - \log \left[ OH^{-} \right] = - \loc \left( $C \right) \approx $poh \\ pH + pOH = 14 \rightarrow pH = 14 - pOH \\ pH \approx 14 - $poh \approx $ph \\ \textrm{Antwoord in 4 significante cijfers : } \; pH = $t_ph \end{array}

math=0
!exit
