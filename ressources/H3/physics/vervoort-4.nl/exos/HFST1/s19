n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
draw=1
plot=0
make_tr=1
inputs=1.1
description=De totale kracht op de fles
ex1=&nbsp;N
m_rightarrow=&nbsp;=&nbsp;

druk=!randint 950,1050
# druk in N
druk=$[$druk*100]
sig=3
tot=!exec scienceprint $druk,$sig,0 $druk,$sig,1 $druk,$sig,2
druk=$(tot[1])
h_druk=$(tot[2])
t_druk=$(tot[3])
opp=!randint 90,120
l=!randint 1,9
opp=!nospace $opp $l
F=$[$druk*$opp*10^(-4)]
list=luchtdruk,oppervlakte van de fles
tot=!exec scienceprint $F,$sig,0 $F,$sig,2
ans1=!item 1 of $tot
t_ans1=!item 2 of $tot

answer$n=$ans1
checkfile=$checkdir/units.proc
# hoeft geen eenheid
var1=0
var2=$[abs(ans1-$F)]

ss=Deze <span style="color:blue">fles</span> heeft een oppervlak van $opp cm<sup>2</sup>.<br />\
Bereken de <span style="color:blue">totale kracht</span> op de fles als er in de fles een vacu&uuml;m is.<br />\
De luchtdruk tijdens dit experiment is $h_druk N/m<sup>2</sup>

texanswer$n=\left[ \begin{array}{l} F = p_{b} \cdot A  \rightarrow F = $t_druk N/m^{2} \cdot $opp \times 10^{-4} m^{2} = $F N \\ \textrm{Afgerond:} \\ F = $t_ans1 N \end{array}\right.

helptext=De luchtdruk is p = $druk N/m<sup>2</sup> 

question$n=<a onmouseover="return escape('$helptext <hr /><img src=\'$module_dir/gifs/fles.jpg\' alt=\'fles\'/>')">$ss</a>

!exit




    
