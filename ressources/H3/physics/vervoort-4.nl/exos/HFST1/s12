n=$counter
math=0
cols=12
rounding=-1
mathview=0
applet=0
image=0
plot=0
inputs=1.1
make_tr=1
checkfile=$checkdir/units.proc
# geen eenheid
var1=0
# geen precisie opgegeven
var2=$empty
keuze=!randint 1,3
!if $keuze=1
    helptext=<ul><li><a target=\'new\' href=\'http://nl.wikipedia.org/wiki/Waterstofsulfide\'>H<sub>2</sub>S</a> : waterstof sulfide</li><li><a  target=\'new\'  href=\'http://nl.wikipedia.org/wiki/Constante_van_Avogadro\'>Getal van Avogadro</a> (N) : 6.022&sdot;10<sup>23</sup></ul>
    t_stof=H_{2}S
    h_stof=H<sub>2</sub>S
    g=!randint 0,12
!else
    !if $keuze=2
	t_stof=NH_{3}
        h_stof=NH<sub>3</sub>
	helptext=<ul><li><a target=\'new\' href=\'http://nl.wikipedia.org/wiki/Ammoniak\'>NH<sub>3</sub></a> : ammoniak (waterstof nitride)</li><li><a  target=\'new\'  href=\'http://nl.wikipedia.org/wiki/Constante_van_Avogadro\'>Getal van Avogadro</a> (N) : 6.022&sdot;10<sup>23</sup></ul>
	g=!randint 0,18
    !else
	t_stof=CH_{4}
	h_stof=CH<sub>4</sub>
	helptext=<ul><li><a target=\'new\' href=\'http://nl.wikipedia.org/wiki/Methaan\'>CH<sub>4</sub></a> : methaan (alkaan)</li><li><a  target=\'new\'  href=\'http://nl.wikipedia.org/wiki/Constante_van_Avogadro\'>Getal van Avogadro</a> (N) : 6.022&sdot;10<sup>23</sup></ul>
	g=!randint 20,120
    !endif
!endif
dec=!randint 1,3
ppm=$g .
!for p=1 to $dec
    g=!randint 0,9
    ppm=!append word $g to $ppm
!next p
ppm=!nospace $ppm
sig=!exec sigdigits $ppm
sig=!item 1 of $sig
!if $sig>4
    sig=4
    # dus significantie van Avogadro 6.022 = 4
!endif
ans=$[6.022*$ppm*10^17]
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2
answer$n=!item 1 of $tot
tex_ans=!item 2 of $tot

ss=De lucht in een varkenstal bevat $ppm ppm <span style="color:blue">$h_stof</span>.<br />1 mol lucht bevat <span style="color:blue">6.022&sdot;10<sup>23</sup></span> moleculen<br />Bereken het aantal moleculen $h_stof per mol lucht.

description=Het aantal moleculen $h_stof
m_rightarrow=&nbsp;:&nbsp;
ex1=&nbsp; per mol lucht.

texanswer$n=\left[ \begin{array}{l}\textrm{$ppm  ppm} = \frac{\textrm{$ppm moleculen }\; $t_stof}{10^{6}\; \textrm{ luchtmoleculen}} \\ \textrm{Dit is }\; $ppm \;\textrm{ moleculen }\; $t_stof \; \textrm{ op} \; 10^{6} \; \textrm{ luchtmoleculen} \\ \textrm{Dus per 1 mol : }\;\frac{6.022 \cdot 10^{23}}{10^{6}} \times $ppm  = $tex_ans  \; \textrm{moleculen}\; $t_stof \\ \textrm{in $sig significante cijfers} \end{array}\right.

textanswer$n=<a onmouseover="return escape('<table class=\'default_table\' ><tr><td>1 %</td><td>1 per &rsquo;cent&rsquo;</td><td>1 op 100 (10<sup>2</sup>)</td></tr><tr><td>1 &permil;</td><td>1 per &rsquo;mille&rsquo;</td><td>1 op 1000 (10<sup>3</sup>)</td></tr><tr><td>1 ppm</td><td>1 per &rsquo;miljoen&rsquo;</td><td>1 op 1000000 (10<sup>6</sup>)</td></tr></table>')"> ppm ?</a>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit





