texanswer$n=\left[ \begin{array}{l} \frac{p \cdot V}{T} = n \cdot R \rightarrow V = \frac{n \cdot R \cdot T}{p} \\ \\ n = 1 \\ R = 8.314 \;\; \textrm{de gasconstante in } \; J\cdot K^{-1} \cdot mol^{-1} \\ T = 20 + 273 = 293\; K \\ p = 1 \; \textrm{ bar} = 10^{5}\; \textrm{ Pa} \\ \\ V = \frac{1 \times 8.314 \times 293}{10^{5}} = 0.0243\; m^{3} \\ \\ V = 24.3\; \textrm{ liter } \end{array} \right.

