n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
draw=1
plot=0
make_tr=1
inputs=2

v=!randint 45,55 
r=!randint 45,55
tot=!exec moneyprint $[$v/10],$[$r/10]
v=!item 1 of $tot
r=!item 2 of $tot
v_ml=$[$v*1000]
sig=2
dagen=120
ans1=$[$v_ml*$r*10^9]
ans2=$[$ans1/$dagen]
tot=!exec scienceprint $ans1,$sig,0 $ans1,$sig,2 $ans2,$sig,0 $ans2,$sig,2  
c_ans1=!item 1 of $tot
t_ans1=!item 2 of $tot
c_ans2=!item 3 of $tot
t_ans2=!item 4 of $tot

checkfile=$checkdir/units.proc
var1=0,0
diff1=$[abs($ans1-$c_ans1)]
diff2=$[abs($ans2-$c_ans2)]
var2=$diff1,$diff2

answer$n=$c_ans1,$c_ans2


ss=Een menselijk lichaam bevat gemiddeld $v liter bloed.<br />1 ml bloed bevat ongeveer $r miljard rode bloedcellen (ery's).<br />Deze hebben een gemiddelde levensduur van $dagen dagen.<br />1) Bereken het totale aantal ery's in een lichaam.<br />2) Bereken het aantal rode bloedcellen dat per dag gemaakt wordt.

description=1) Totale aantal ery's,2) Productie rode bloedcellen 

ex1=&nbsp;
ex2=&nbsp;ery/dag
m_rightarrow=&nbsp;=&nbsp;
texanswer$n=\left[ \begin{array}{l} V = $v liter  = $v_ml mL \\ 1 miljard = 10^{9} \\  \textrm{aantal ery } = $v_ml \times $r \times 10^{9} = $ans1 = $t_ans1 \: \textrm{in $sig sign. cijfers} \\ \textrm{Levensduur is 120 dagen} \\ \textrm{productie per dag :} \frac{$ans1}{120} = $ans2 = $t_ans2 \; \textrm{ery / dag} \end{array} \right.

helptext=de levensduur is $dagen dagen

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/bloed.jpg\' alt=\'bloed\'/>')">$ss</a>

!exit




