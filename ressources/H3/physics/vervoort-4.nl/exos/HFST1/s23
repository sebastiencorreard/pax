n=$counter
math=0
cols=12
rounding=1
mathview=0
image=0
draw=1
plot=0
make_tr=1

inputs=2
description=Aantal mol O<sub>2</sub>,Aantal moleculen O<sub>2</sub>
ex1=&nbsp;
ex2=&nbsp;
m_rightarrow=&nbsp;=&nbsp;
weight=!randint 10,40
weight=$[$weight*10]
v=20.94
w=28.8
mol_lucht=$[$weight/$w]
mol_O2=$[$mol_lucht*$v/100]
moleculen_O2=$[$mol_O2*6.022*10^23]
ss=Bereken het aantal mol zuurstof en het <span style="color:blue">aantal moleculen</span> zuurstof in $weight g lucht.<br />1 mol lucht bevat $v vol% O<sub>2</sub> ofwel 0.2094 mol O<sub>2</sub>.<br />1 mol lucht weegt $w g.

tot=!exec scienceprint $mol_O2,3,0 $mol_O2,3,1 $moleculen_O2,3,0 $moleculen_O2,3,1
ans1=!item 1 of $tot
h_ans1=!item 2 of $tot
ans2=!item 3 of $tot
h_ans2=!item 4 of $tot

answer$n=$ans1,$ans2
checkfile=$checkdir/units.proc
# hoeft geen eenheid
var1=0,0
var2=$[abs($ans1-$mol_O2)],$[abs($ans2-$moleculen_O2)]

textanswer$n=<ul><li>n(<em>lucht</em>) = $weight g <b>/</b> $w g/mol = $mol_lucht mol lucht </li><li>n(<em>O<sub>2</sub></em>) = $v/100 &times; $mol_lucht = $[$v/100] &times; $mol_lucht = $mol_O2 mol O<sub>2</sub><br />We noteren dit getal in 3 significante cijfers, afkomstig van "$w"<br />Het aantal mol O<sub>2</sub> in $weight gram lucht is $h_ans1</li><li>N(<em>O<sub>2</sub></em>) = $mol_O2 &times; 6.022&sdot;10<sup>23</sup> moleculen O<sub>2</sub>(getal van Avogadro)<br />N(<em>O<sub>2</sub></em>) = $moleculen_O2 moleculen O<sub>2</sub><br />we noteren dit getal in 3 significante cijfers, afkomstig van "$w"<br />Het aantal moleculen O<sub>2</sub> in $weight gram lucht is $h_ans2 </li></ul>

helptext=N = 6.022 &times; 10<sup>23</sup> (constante van <em>Avogadro</em>)

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit




