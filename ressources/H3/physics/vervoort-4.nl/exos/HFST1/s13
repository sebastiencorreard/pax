n=$counter
math=0
cols=12
rounding=-1
mathview=0
applet=0
image=0
plot=0
inputs=2
make_tr=1

# g/l
sg=9.987*10^2
# molmassa gr/mol
M=18.0
sig=3
weight=!randint 500,1750
weight=!exec moneyprint $[$weight/100]
mol=$[($weight/$M)]
mol_per_liter=$mol&sdot;10<sup>-3</sup>
factor=$[($sg/$weight)]
n_H2O=$[6.022*10^23*$mol]
tot=!exec scienceprint $n_H2O,$sig,0 $n_H2O,$sig,1 $factor,$sig,0
ans1=!item 1 of $tot
h_ans1=!item 2 of $tot
ans2=!item 3 of $tot
answer$n=$ans1,$ans2
checkfile=$checkdir/units.proc
# beide antwoorden geen eenheid
var1=0,0
# een precisie opgegeven
var2=$[abs($n_H2O-$ans1)],$[abs($factor-$ans2)]

ss=Een m<sup>3</sup> lucht bevat $weight gram waterdamp.<br />Water ,als vloeistof, heeft een dichtheid van 9.987&sdot;10<sup>2</sup> g·L<sup>-1</sup><br />De massa van 1 mol water is $M g.


description=<b>a</b>)&nbsp;Bereken het aantal H<sub>2</sub>O-moleculen<br />dat in 1 liter lucht zit.,<b>b</b>)&nbsp;In 1 liter water zitten uiteraard veel<br />meer H<sub>2</sub>O-moleculen. Hoeveel keer meer?
m_rightarrow=&nbsp;:&nbsp;
ex1=&nbsp;moleculen H<sub>2</sub>O per liter lucht
ex2=&nbsp;&times; meer

textanswer$n=<ol><li><em>m</em>(waterdamp) = $weight gram per m<sup>3</sup> lucht<br />Hoeveel mol waterdamp in 1 liter lucht: <em>n</em>(H<sub>2</sub>O) = $weight/$M per m<sup>3</sup> = $mol / m<sup>3</sup> = $mol_per_liter mol/L<br />Hoeveel moleculen is dit :<em>n</em>(H<sub>2</sub>O) =  $mol_per_liter &nbsp; &times; 6.022&sdot;10<sup>23</sup> (N, getal van Avogadro)<br />Dus $h_ans1 moleculen (met $sig significante cijfers)</li><li><em>m</em>(water) = $sg gram per liter water<br /><em>n</em>(H<sub>2</sub>O) = $sg / $M = $factor<br />Dus een factor $ans2 (met $sig significante cijfers)</li></ol>
helptext=<ul><li>De dichtheid van water (bij deze temperatuur en druk) is: 9.987&sdot;10<sup>2</sup> g/L</li><li>Molmassa water : 18.0 g/mol</li><li><a  target=\'new\'  href=\'http://nl.wikipedia.org/wiki/Constante_van_Avogadro\'>Getal van Avogadro</a> (N) : 6.022&sdot;10<sup>23</sup></ul>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit





