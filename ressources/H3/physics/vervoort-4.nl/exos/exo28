n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=1.1
sig=3
M=98.1
#Opm: verander 3,00 in een waarde tussen 2 en 20 g
#Verander 100 mL in een 200, 300 ,400 of 500 mL
ml=!randitem 100,200,300,400,500
g=!randint 200,2000
g=!exec moneyprint $[$g/100]
ss=Bereken de pH van een oplossing van $g g H<sub>2</sub>SO<sub>4</sub> per $ml mL water.<br />Gegeven: zwavelzuur H<sub>2</sub>SO<sub>4</sub> M = $M g/mol

# g/L
c=$[1000*$g/$ml]
mc=$[$c/$M]
MC=$[2*$mc]
# ph-waarde niet in scienceprint !!
ph=$[-1*log($MC)/(log(10))]
t_ph=!exec moneyprint $ph 2
answer$n=$ph
var1=$[abs($ph-$t_ph)]
var2=0
helptext=<img src=\'$module_dir/gifs/ph.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=De pH waarde 
texanswer$n=\begin{array}{l} $g \; \textrm{gram per $ml milliliter is }\; $c \; gram/L \\ M_{H_{2}SO_{4}} = $M \; g/mol \\ $c \;gram/L = $mc \; mol/L \\ H_{2}SO_{4} + 2H_{2}O \rightarrow 2H_{3}O^{+} + 2SO_{4}^{2-} \\ \textrm{ 1 mol zwavelzuur levert bij oplossen 2 mol } \;H^{+} \\ \left[ H_{3}O^{+} \right] = 2 \times $mc \; mol/L = $MC \; mol/L \\ pH = - \log \left[ H_{3}O^{+} \right] = - \log\left( $MC \right) \approx $ph \\ \textrm{Het antwoord in $sig significante cijfers :} pH = $t_ph  \end{array}

math=0
!exit
