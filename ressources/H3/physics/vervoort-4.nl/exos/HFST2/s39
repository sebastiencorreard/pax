n=$counter
image=1
mathview=0
use_arrow=1
arrow=$gifdir/red_varrow.gif
questiontype=8
checkfile=exos/checkfile3.proc
xsize=600
ysize=150
make_tr=1
inputs=0
insdraw_size=600,150
image_settings$n=600,150
d1=1
d2=8
var1=$[$d1-1],$[$d2+1],0,0
!for d=$d1 to $d2 
    millenia=!append line line $d,-4,$d,4,red to $millenia
    mtext=!append line text blue,$[$d-0.1],-8,normal,$[10^$d] to $mtext
    mtext=!append line text blue,$[$d-0.1],8,normal,$[10^$d] to $mtext
!next d
image$n=xrange $[$d1-1],$[$d2+1]\
yrange -10,10\
$decennia\
$half_millenia\
$millenia\
$mtext\
linewidth 4\
hline black,0,0
linewidth 1

rounding=100
x=!randint $d1,$[$d2-2]
k=!randint 11,99
k=$[$k/10]
g=$[$k*10^$x]
tot=!exec scienceprint $g,2,9 $g,2,1
answer$n=$[log( $(tot[1]) )/log(10)]
rans=$[(round(100*$(answer$n)))/100]
ss=Zet het getal <kbd>$(tot[2])</kbd> ($g) op de <sup>10</sup>log getallen lijn.
helptext=TIP:<br />De x-co&ouml;rdinaat van de pijl is de exponent...<br />dus 10<sup>exponent</sup> is het gevraagde getal...
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
textanswer$n=$(tot[2]) op de <sup>10</sup>log-schaal : log($g) &asymp; $rans<br />Zie blauwe pijl in plaatje.
draw=1
plot=0