n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=2
c1=!randint 9,50
s=!randint 1,3
c1=!exec moneyprint $[$c1/100] $s
sig=!exec sigdigits $c1
sig=$(sig[1])
f=!randint 5,25
c2=$[$c1/$f]
#exotext=$var1
ph1=$[-1*log($c1)/(log(10))]
ph2=$[-1*log($c2)/(log(10))]
tot=!exec scienceprint $ph1,$sig,1 $ph2,$sig,1 $ph1,$sig,2 $ph2,$sig,2
#tot=!exec moneyprint $ph1,$ph2 2
c_ans1=!item 1 of $tot
c_ans2=!item 2 of $tot
ans1=!item 3 of $tot
ans2=!item 4 of $tot
answer$n=$ph1\
$ph2

var1=$[abs($ph1 - $c_ans1)],$[abs($ph1 - $c_ans2)]
var2=100,100
ss=De concentratie van de H<sub>3</sub>O<sup>+</sup>-ionen is gelijk aan $c1 mol/L.<br /><br />\
a) Bereken de <span class="schaersvoorde_link">pH-waarde</span><br />\
b) Bereken de <span class="schaersvoorde_link">pH-waarde</span> als de concentratie $f &times; kleiner is.

helptext=<img src=\'$module_dir/gifs/ph.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=pH-waarde,pH-waarde verdunning
texanswer$n=\begin{array}{ll} a) & \left[ H_{3}O^{+}\right] = $c1 \; mol/L \\   & pH = - \log \left[ H^{+} \right] = - \log \left( $c1 \right) = $ph1 \\   & \textrm{Antwoord in $sig significante cijfers: }\;\; pH = $ans1 \\ b) & \left[ H_{3}O^{+}\right]_{verdunning} = \frac{$c1}{$f} \approx $c2 \; mol/L \\    & pH = - \log \left[ H^{+} \right] = - \log \left( $c2 \right) = $ph2 \\   & \textrm{Antwoord in $sig significante cijfers: }\;\; pH = $ans2 \end{array}

#formula$n=\begin{array}{l}\textrm{de pH waarde is per definitie :} \\ pH = - \log \left[ H^{+} \right] = - \log \left[^{} H_{3}O^{+} \right] \end{array}









