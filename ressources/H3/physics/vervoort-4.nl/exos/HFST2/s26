n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=1.1
sig=3
c1=!randint 1,20
num=!randint 2,10
ph=$[-1*log($c1/(1000*$num))/log(10)]
tot=!exec scienceprint $[$c1/1000],$sig,0 $[$c1/1000],$sig,1 $[$c1/1000],$sig,2 $[$c1/($num*1000)],$sig,0 $[$c1/($num*1000)],$sig,2 $ph,$sig,0 $ph,$sig,2
c1=$(tot[1])
h_c1=$(tot[2])
t_c1=$(tot[3])
c2=$(tot[4])
t_c2=$(tot[5])
c_ph=$(tot[6])
t_ph=$(tot[7])
ss=De concentratie van de H<sub>3</sub>O<sup>+</sup>-ionen is gelijk aan $h_c1 mol/L.<br />Bereken de pH als deze concentratie $num &times; kleiner is.
var1=$[abs($ph - $c_ph)]
var1=0
answer$n=$ph
helptext=<img src=\'$module_dir/gifs/ph.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=De pH-waarde 
texanswer$n=\begin{array}{l} \left[ H_{3}O^{+} \right] = \frac{$t_c1}{$num} = $t_c2 mol /L \\ pH = -\log \left[ H_{3}O^{+} \right] = -\log \left( $t_c2 \right) \approx $ph \\ \textrm{Op $sig significante cijfers : } \; pH = $t_ph \end{array}
math=0
!exit
