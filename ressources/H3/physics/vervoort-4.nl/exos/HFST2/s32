# gelijk aan s31, maar dan het "getal" in science notatie
n=$counter
mathview=0
inputs=$options
embed=0
questiontype=0
make_tr=1
checkfile=exos/precheck1.proc
#$checkdir/new_number.proc
helptext=Als er geen grondtal wordt vermeld...veronderstellen we grondtal 10<br />log(a) == <sup>10</sup>log(a)
ss=Schrijf de volgende getallen als een macht met het gegeven grondtal.<br />Geef de exponent in het gewenste aantal significante cijfers
grondtallen=!shuffle 2,3,4,5,6,7,8,9,2,3
factors=!shuffle 20000,10000,5000,1000,500,200,100,50
texanswer$n=\left[ \begin{array}{lll} 
var2=$empty
var1=$empty
!for p=1 to $options
    sig=!randint 2,5
    g=!item $p of $grondtallen
    getal=!randint 1111,9999
    getal=$[$getal/1000]
    f=!item $p of $factors
    k=!randint 0,1
    !if $k=0
	getal=$[$getal/$f]
    !else
	getal=$[$getal*$f]
    !endif
    tmp=!exec scienceprint $getal,$sig,0 $getal,$sig,1 $getal,$sig,2
    getal=$(tmp[1])
    h_getal=$(tmp[2])
    t_getal=$(tmp[3])
    tt=$[log($getal)/log(10)]
    nn=$[log($g)/log(10)]
    exp=$[$tt/$nn]
    tot=!exec scienceprint $exp,$sig,0 $exp,$sig,2
    ex$p=(in <b>$sig</b> significante cijfers)
    description=!append item $p) Schrijf <b>$h_getal</b> als macht met grondtal <b>$g</b> to $description
    answer$n=!append line $g^($(tot[1])) to $(answer$n)
    exp3=$(tot[2])
    texanswer$n=!append word $ $p) & ^{$g} \log \left( $t_getal \right)  =  \frac{ \log \left( $t_getal \right) }{\log \left( $g \right) }  & = & \frac{$tt}{$nn}  = $exp \\ & \textrm{De exponent in $sig significante cijfers :} \; $exp3 & \rightarrow & $t_getal = $g^{$exp3} \\ $ to $(texanswer$n)
    var1=!append item $[round( abs( $g^( $exp ) - $g^( $(tot[1]) ) ) )] to $var1

!next p
texanswer$n=!append word $ \end{array} \right. $ to $(texanswer$n)

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s131.jpg\' alt=\'logaritme\' />')">$ss</a>

# help ^{a}\log(b) = \frac{\log(b)}{\log(a)} \rightarrow b = a^{^{a}\log(b)}


























