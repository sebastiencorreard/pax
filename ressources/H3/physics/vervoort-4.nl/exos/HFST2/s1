n=$counter
choice=!randint 1,6
embed=0
total_exos=6
questiontype=0
calculator=0
mathview=0
rounding=0
checkfile=$checkdir/new_number.proc
arglist=$empty
var1=$empty
var2=$empty
cols=8
rows=1
v1=!randint 1,9
v2=!randint 2,9
g=!nospace $v1.$v2
k=$[$g^2]
gegeven=$empty
!if $choice=1
    vraag=\left( $g \times 10^{2} \right)^{2} 
    gegeven=$ $g^{2} = $k \\ $
    antwoord=\left( $g \right)^{2} \times 10^{2 \cdot 2} = $k \times 10^{4}
    answer$n=$k*10^4
!else
    !if $choice=2
	gegeven=$ $g^{2} = $k \\ $
	vraag=\sqrt{$k}
	antwoord=\sqrt{$g^{2}} = $g
	answer$n=$g
    !else
	!if $choice=3
	    # voor: x1=5 en x2=-5
	    arglist=x
	    gegeven=$ $g^{2} = $k \\ $
	    vraag=x^{2} = $k \rightarrow x 
	    antwoord=\; = \pm \sqrt{$k} = \pm \sqrt{$g^{2}} = \pm $g
	    answer$n=$g,-$g
	!else
	    !if $choice=4
		gegeven=$ $g^{2} = $k \\ $
		vraag=\sqrt{ \left( -$g \right)^{2} } 
		antwoord=\sqrt{$k} = $g
		answer$n=$g
	    !else
		!if $choice=5
		    vraag=\left($v1 + 0.$v2 \right)^{2}
		    antwoord= $[$v1+0.$v2]^{2} = $k
		    answer$n=$k
		!else
		    vraag=$v1 + \left( 0.$v2\right)^2
		    answer$n=$[$v1+(0.$v2)^2] 
		    antwoord=$v1 + $[(0.$v2)^2] = $(answer$n)
		!endif
	    !endif
	!endif
    !endif
!endif
!if $use_mathml = 2
    formula$n=\left[ \begin{array}{l}  $gegeven $vraag = \input{12}{0}{font-size:18px;background:orange}{}{0} \end{array} \right.
    inputs=-1
!else
    embed=1
    formula$n= \left[ \begin{array}{l} $gegeven $vraag \end{array} \right. 
!endif
helptext=Als er meerdere oplossingen zijn bij het berekenen van de waarde van een variabele...<br />iets noteren als:<br/>x1=1.23 en x2=3.21
texanswer$n=$vraag = $antwoord 
m_rightarrow=&nbsp;=&nbsp;

question$n=Bereken de volgende machten zonder rekenmachine!
