n=$counter
mathview=0
embed=1
inputs=1.1
cols=10
make_tr=1
questiontype=0
sig=!randint 2,5
checkfile=$checkdir/new_number.proc
helptext=Als er geen grondtal wordt vermeld...veronderstellen we grondtal 10<br />log(a) == <sup>10</sup>log(a)
g=!randint 2,10
var2=$empty
var1=$empty
description=
g=!randint 2,22
a=!randint 5,55
c=!randint 1,30
tt=$[log($g)/log(10)]
nn=$[log($a)/log(10)]
ans=$[$tt/($c*$nn)]
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2
answer$n=$(tot[1])
rans=$(tot[2])
ss=Bereken <i>x</i> in $sig significante cijfers.
!if $c=1
    formula$n=$a^{x} = $g \rightarrow x = [?]
!else
    formula$n=$a^{$c \cdot x} = $g \rightarrow x = [?]
!endif
texanswer$n=\begin{array}{l} \textrm{We gebruiken de rekenregel :} \; g^{n \cdot x} = a \rightarrow n \cdot x = ^{g}\log(a) = \frac{ \log(a)}{\log(g)}  \rightarrow x = \frac{ \log(a)}{n \cdot \log(g)} \\ $g^{$c \cdot x} = $a \rightarrow \\  $c \cdot x = ^{$a} \log($g) \rightarrow \\  $c \cdot x = \frac{\log($g)}{\log($a)} \rightarrow \\ $c \cdot x = \frac{$tt}{$nn}  \rightarrow \\  x = $ans \\ \textrm{Opgeven in $sig significante cijfers : } \; x = $rans \end{array} \right.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s36.jpg\' alt=\'logaritme\' />')">$ss</a>

