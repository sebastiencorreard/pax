n=$counter
mathview=0
inputs=1.1
P=!randint 50,120
r=!randint 10,120
s1=!charcnt $P
s2=!charcnt $r
sig=$[(min($s1,$s2))]

description=Geluidniveau of $r meter afstand
make_tr=1
var1=1
checkfile=$checkdir/new_number.proc
ex1=dB
ss=Geluid dat afkomstig is van een luidspreker van $P W plant zich in alle richtingen voort.<br />\
Bereken het geluidsniveau op een afstand van $r m.

A=$[4*pi*$r*$r]
I=$[$P/$A]
L=$[10*log($I/(10^(-12)))/log(10)]
question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s15.jpg\' alt=\'noalt\' />')">$ss</a>
tot=!exec scienceprint $L,$sig,0 $L,$sig,2
ans=!item 1 of $tot
t_ans=!item 2 of $tot

answer$n=$ans

var1=$[abs($ans-$L)]
var2=100
texanswer$n=\left[\begin{array}{ll}  I = \frac{P}{A_{bol}} \:\: W/m^{2} \\    L = 10 \cdot \log \left( \frac{I}{10^{-12}} \right) \: \:  dB \\    A_{bol} = 4 \cdot \pi \cdot r^{2}  \\    r = $r m \rightarrow A = 4 \cdot \pi \cdot $r^{2} = $A \: \m^{2} \\    I = \frac{$P \: W}{$A \: m^{2}} = $I \: W/m^{2} \\    L = 10 \cdot \log \left( \frac{$I}{10^{-12}} \right) = $L \: \: dB \\   \textrm{Antwoord op $sig significante cijfers afkomstig van $r } \\   L = $t_ans \: \: dB \end{array} \right.










