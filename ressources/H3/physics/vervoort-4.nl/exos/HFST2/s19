n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=1.1
num=!randint 2,9
sig=2
ex1=dB
db=!randitem 96,90,87,84,81
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
aantal=!item $num of $telwoorden

ss=Op een bepaalde afstand van $aantal even sterke lawaaibronnen meten<br />we een geluidsniveau van $db dB.<br />Bereken het gemeten geluidsniveau in als er maar 1 bron aan staat.


question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s15.jpg\' alt=\'noalt\' />')">$ss</a>
description=Geluidsniveau bij 1 bron
sig=2
var2=$empty
var1=$empty
p1=$[0.1*$db - 12]
I2=$[(10^($p1))/$num]
ans=$[10*(log($I2*10^(12))/log(10))]
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2 $ans,-1,2 $I2,-1,2
c_ans=$(tot[1])
t_ans=$(tot[2])
u_ans=$(tot[3])
t_I=$(tot[4])
var1=$[abs($ans - $c_ans)]
var2=0

#exotext=$var1

answer$n=$ans

texanswer$n=\left[ \begin{array}{l} L = $db \;\; dB \\ I = 10^{0.1 \cdot L - 12} \\ I = 10^{0.1 \cdot $db - 12} = 10^{$p1} \;\; \sfrac{W}{m^2} \\ I_{1\;bron} = \frac{I}{$num} = \frac{10^{$p1}}{$num} = $t_I \;\; W/m^{2} \\ I_{1\;bron} = 10 \times \log\left( \frac{$t_I}{10^{-12}} \right) = $u_ans \; \textrm{dB}  \\ \textrm{In 2 significante cijfers : } \; I = $t_ans \;\textrm{dB} \end{array} \right.










