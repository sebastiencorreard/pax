n=$counter
mathview=0
inputs=1.1
m_rightarrow=&nbsp;=&nbsp;
make_tr=1
checkfile=$checkdir/units.proc
Vv=!randint 100,300
Vv=$[$Vv*10^-6]
sig=3
tot=!exec scienceprint $Vv,$sig,0 $Vv,$sig,2 $Vv,$sig,3
v=!item 1 of $tot
V=!item 2 of $tot
Vs=!item 3 of $tot
Vhtml=!nospace $Vs<em>L</em>
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
significant=!item $sig of $telwoorden
description=diameter
display=1
formula$n=V_{bol} = \frac{4}{3} \pi \cdot r^{3}
r=$[(3*$v/(4*pi))^(1/3)]
ans=$[2*$r]
tot=!exec scienceprint $ans,-1,2 $ans,$sig,0 $ans,$sig,2
p_ans=!item 1 of $tot
c_ans=!item 2 of $tot
t_ans=!item 3 of $tot
answer$n=$c_ans dm
var1=1
var2=$[abs($ans - $c_ans)]

ss=Voor het volume van een bol met radius <i>r</i> geldt de onderstaande formule.<br />\
Een bolletje heeft een volume van $Vhtml .<br />\
Bereken de diameter.<br />Geef je antwoord op in een SI eenheid en correcte precisie.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/bol.gif\' alt=\'bol\' />')">$ss</a>

texanswer$n=\left[ \begin{array}{l} V_{bol} = \frac{4}{3} \pi \cdot r^{3} \\ r^{3} = \frac{3\cdot V}{4 \cdot \pi} = 4 \\ r = \left( \frac{ 3 \cdot $V \;dm^{3}}{4 \cdot \pi} \right)^{\sfrac{1}{3}} = \root{3} \of{ \frac{3 \cdot $V}{4 \cdot \pi} } = $r \;dm \\  \textrm{ diameter  }\: d = 2 \cdot r \\ d = $p_ans \: dm \\ \textrm{het antwoord of $significant significante cijfers} \\ d = $t_ans \: dm \end{array} \right.










