n=$counter
image=0
make_tr=1
inputs=yes
mathview=0
# myhotspot2
questiontype=7
javascript=js/logscale.js
# javascript coordinaten afronding in hotspot2.phtml
rounding=10
checkfile=$checkdir/coord.proc
question$n=Bepaal de co&ouml;rdinaten van de getekende punten<br />Ga uit van "mooie / hele" getallen...
logscale=10
xmin=0
ymin=1
xmax=10
ymax=10000
# let op: uitgetrimmed op size 1.4,1.4
xsize=700
ysize=560
var3=-1.15,10.1,-0.34,4.12
var5=size 1.4,1.4;logscale y $logscale ; border ; tmargin 1 ; rmargin 1 ; xtics $xmin,0.5,$xmax ; ytics $ymin,$logscale,$ymax ; mytics $logscale ; mxtics 2 ;grid xtics ytics mxtics mytics linetype 2 , linetype 2 ; xlabel "x-as" ; ylabel "y-as" ; zeroaxis linetype 1
var4=[$xmin : $xmax] [$ymin : $ymax] 0 notitle
# joke@vrijdag /home/joke : identify wims.gif
# wims.gif GIF 700x560 700x560+0+0 8-bit sRGB 128c 11.3KB 0.000u 0:00.015
options=5
#x / y point js-array
var7=$empty
var8=$empty
textanswer$n=<ul>
math=0
xnums=$empty
!for p=1 to $[2*$xmax - 1]
    xnums=!append item $[$p/2] to $xnums
!next p
xnums=!shuffle $xnums
!for p=1 to $options
    x=!item $p of $xnums
    y=!randint 1,$[log($ymax)/log(10)]
    Y=$[10^$y]
    answer$n=!append item $x,$Y to $(answer$n)
    var7=!append item "$x" to $var7
    var8=!append item "$y" to $var8
    textanswer$n=!append word $ <li>( $x : $Y )</li> $ to $(textanswer$n)
!next p
textanswer$n=!append word $ </ul> $ to $(textanswer$n)

var7=!nospace [ $var7 ]
var8=!nospace [ $var8 ]
