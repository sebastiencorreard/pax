n=$counter
mathview=0
make_tr=1
questiontype=0
checkfile=$checkdir/new_number.proc
inputs=1.1
num=!randint 20,90
num=!exec moneyprint $[$num/10] 1
ph=$[log($num)/log(10)]
dph=!exec moneyprint $ph 1
answer$n=$ph
var1=$[abs($ph-$dph)]
var2=0
ss=Bereken de toename van de pH als je een zuur $num &times; verdund ?<br />
helptext=<img src=\'$module_dir/gifs/ph.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=De pH toename
texanswer$n=\begin{array}{l} \left[ H_{3}O^{+} \right] = x \; mol/L\rightarrow pH = - \log(x)\\ \textrm{ $num keer verdunnen : } \\ \left[ H_{3}O^{+} \right]_{verdunning} = \frac{x}{$num} \; mol/L \rightarrow pH_{verdunning} = - \log\left( \frac{x}{$num}\right) \\ \special{color=red}\textrm{we passen de rekenregel toe :} \log\left( \frac{a}{b} \right) = \log\left( a \right) - \log\left( b \right) \\ pH_{verdunning} = - \log\left( x \right) - - \log($num) = - \log\left( x \right) + \log($num) \\ \textrm{ De pH-waarde neemt dus toe met :} \log($num) \approx $dph \end{array}

math=0
!exit
