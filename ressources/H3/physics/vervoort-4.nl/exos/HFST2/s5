n=$counter
mathview=0
inputs=1.1
description=Diameter
make_tr=1
var1=1
questiontype=0
checkfile=$checkdir/units.proc
A=!randint 10,200
sig=!charcnt $A
ss=Van een <span style="schaersvoorde_link">cirkel</span> is de oppervlakte $A cm<sup>2</sup>.<br />Bereken de diameter.<br />Geef je antwoord op in de correcte eenheid en significantie.

question$n=<a onmouseover="return escape('<img src=\'$module_dir/gifs/hfst2.s5.jpg\' alt=\'cirkel\' />')">$ss</a>

ans=$[2*(sqrt($A/pi))]
r_ans=$[$ans/2]
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,2
c_ans=!item 1 of $tot
t_ans=!item 2 of $tot
answer$n=$c_ans cm
var2=$[abs($ans-$c_ans)]
texanswer$n=\left[\begin{array}{l} A = \pi \times r^{2} \rightarrow r = \sqrt{ \frac{A}{\pi}} \\ A = $A \: cm^{2} \\ \pi = $[1*pi] \\ r = \sqrt{ \frac{$A}{\pi}} \approx $r_ans \: cm \\ d = 2 \cdot r \rightarrow d \approx $ans \: cm \\ \textrm{Antwoord in $sig significante cijfers (afkomstig van $A) :} \\  d =  $t_ans \: cm \end{array} \right.










