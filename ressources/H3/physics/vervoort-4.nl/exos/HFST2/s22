n=$counter
mathview=0
make_tr=1
checkfile=$checkdir/new_number.proc
inputs=1.1
lf=!randint 1,10
f=$[$lf*100]
rounding=10
var1=$empty
var2=$empty
ss=Bereken de verandering van de pH als de<br />concentratie van de OH<sup>&minus;</sup>-ionen $f &times; zo groot is.
answer$n=$[log($f)/log(10)]
helptext=<img src=\'$module_dir/gifs/ph2.jpg\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
ex1=$empty
description=Verandering pH-waarde
texanswer$n=\begin{array}{l} pH + pOH = 14  \\ - \log \left[ H^{+} \right]  +  - \log \left[ OH^{-} \right] = 14 \\ - \log \left[ H^{+} \right]  +  - \log \left( $f \times \left[ OH^{-} \right] \right) = 14  \\ - \log \left[ H^{+} \right]  +  - \log \left( $f \right) + - \log \left[ OH^{-} \right] = 14 \\ \textrm{de pH-waarde neemt dus af met }\; \log \left($f \right) = $(answer$n) \\ \special{color=red}\textrm{we gebruiken de rekenregel: } \log(a \times b) = \log(a)+\log(b) \end{array}
!exit

#formula$n=\Large  \begin{array}{l}\textrm{per definitie :} \\ \color{red} pH = - \log \left[ H^{+} \right] = - \log \left[ H_{3}O^{+} \right] \\ \color{blue} pOH = - \log \left[ OH^{-} \right] = - \log \left[ OH^{-} \right] \\ \color{red} pH \color{black} + \color{blue}{ pOH }\color{black} = 14 \end{array}





