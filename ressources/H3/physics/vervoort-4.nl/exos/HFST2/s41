n=$counter
mathview=0
make_tr=1
questiontype=0
checkfile=$checkdir/new_number.proc
inputs=1.1
tg=!randint 20,30
hr=!randint 10,15 
sig=2
question$n=Een bepaalde bacterie heeft een generatietijd van $tg min.<br />Bereken het aantal bacteri&euml;n na $hr uur.<br />Geef je antwoord op in de correcte precisie
helptext=$empty
ex1="stuks"
description=Aantal bacteri&euml;n
nn=$[$hr*60/$tg]
N=$[2^$nn]
tot=!exec scienceprint $N,$sig,0 $N,$sig,2
answer$n=$(tot[1])
var1=$[abs($(answer$n) - $N)]
var2=0
texanswer$n=\left[ \begin{array}{l} n = \frac{$hr \times 60 }{$tg} =  $nn \\ N = 2^{$nn} = $N \\ \textrm{Dit antwoord in $sig significante cijfers ;}\; $(tot[2]) \;\textrm{bacterien} \end{array} \right.

math=0
!exit
