#hfst3
#exo32(hfst3) Bereken het oppervlak van papier dmv weging
n=$counter
questiontype=3
math=0
cols=18
rounding=1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
cols=12
description=Het oppervlak
m_rightarrow=&nbsp;&asymp;&nbsp;
ex1=&nbsp;<kbd>cm<sup>2</sup></kbd>
checkfile=$checkdir/units.proc
# gr
s_massa=!randint 600,999
s_massa=!exec moneyprint $[$s_massa/10] 1
# mg
massa=!randint 12000,55000
massa=$[$massa/10]
massa_gr=$[$massa/1000]
per_cm=$[1/($s_massa*10^(-4))]
opp=$[($massa / 1000) / ($s_massa*10^(-4))]
sig=3
tot=!exec scienceprint $opp,$sig $opp,$sig,1
ans=!item 1 of $tot
h_ans=!item 2 of $tot
answer$n=$ans
var1=0
var2=$[abs($opp - $ans)]

textanswer$n=<ul><li>$s_massa gram per m<sup>2</sup> = $s_massa &times; 10<sup>&minus;4</sup> g/cm<sup>2</sup><br />(1 m<sup>2</sup> = 100 cm &times;100 cm = 10000 cm<sup>2</sup> = 10^4 cm<sup>2</sup><br /> 1 cm = 10<sup>-4</sup> m<sup>2</sup>)</li><li>1 gram papier heeft dus een oppervlakte van 1/($s_massa &times; 10<sup>&minus;4</sup>) cm<sup>2</sup></li><li>$massa mg = $massa_gr gram</li><li>Het oppervlak is : $massa_gr &times; 1/($s_massa &times;10<sup>-4</sup>)  = $opp cm<sup>2</sup> </li><li>Het antwoord op $sig significante cijfers (afkomstig van $s_massa): $h_ans cm<sup>2</sup></li></ul>

ss=Een bepaalde papiersoort heeft een massa van $s_massa g/m<sup>2</sup>.<br />Het stuk papier wordt nauwkeurig gewogen en heeft een massa van $massa mg.<br />Bereken de oppervlakte van dit papier in cm<sup>2</sup>.

helptext=Geef je antwoord in de juiste precisie
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit




    
