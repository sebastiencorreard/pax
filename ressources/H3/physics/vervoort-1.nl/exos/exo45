#hfst4
#exo45(hfst4) Warm water : snelheid en geleverde hoeveelheid warmte
n=$counter
questiontype=3
math=0
make_tr=1
cols=8
rounding=10000
mathview=0
applet=0
image=0
plot=0
checkfile=$checkdir/units.proc
inputs=2

debiet=!randint 100,175
debiet=!exec moneyprint $[$debiet/10]
# diameter in cm
diameter=!randint 20,45
diameter=!exec moneyprint $[$diameter/10]
tmin=!randint 30,50
tmax=!randint 60,90
ans1=$[$debiet/(pi*(0.1*$diameter/2)^2)]
ans11=$[$ans1/600]
tot=!exec scienceprint $ans11,2,0 $ans11,2,2
ans11_r=!item 1 of $tot
diff1=$[abs($ans11 - $ans11_r)]
# vragen naar m/s
rans11=!item 2 of $tot

Q=$[$ans1*4180*($tmax-$tmin)]
ans2=$[$Q/3600000]
#rans2=$[(round(1000*$ans2))/1000]
tot=!exec scienceprint $ans2,2,0 $ans2,2,2 $Q,6,2
rans2=!item 1 of $tot
Q_latex=!item 2 of $tot
Q_L=!item 3 of $tot
diff2=$[abs($ans2 - $rans2)]

answer$n=$ans11_r,$rans2

var1=0,0
var2=$[2*$diff1],$[2*$diff2]

ss=Door de <span style="color:blue">leiding</span> van een verwarming stroomt water met een debiet van $debiet l/min.<br />De leiding heeft een inwendige diameter van $diameter cm<br />Doordat het water de kamer verwarmt koelt het af van $tmax &deg;C tot $tmin &deg;C.<br />Bereken snelheid in <kbd>m/s</kbd> en geleverde warmte in <kbd>kWh/min</kbd> van het water.<br />Geef beide antwoorden op in een passende precisie.

m_rightarrow=&nbsp;&asymp;&nbsp;
description=De snelheid van het water,De geleverde warmte 
ex1=&nbsp;<kbd>m/s</kbd>
ex2=&nbsp;<kbd>kWh/min</kbd>

helptext=<img src=\'$module_dir/gifs/vloeistof.door.een.leiding.jpg\' alt=\'geen_plaatje\' /><br />Neem voor de soortelijke warmte van water onder deze omstandigheden 4180 J kg<sup>-1</sup>*K<sup>-1</sup>

question$n=<a onmouseover="return escape('$helptext ')">$ss</a>

texanswer$n=\left[ \begin{array}{l} v \textrm{ is de snelheid in m/s} \\ \phi \textrm{ is het debiet in l/min} \\ m \textrm{ is de massa in kg} \\ c \textrm{ is de soortelijke warmte van water = 4180 J/kg/K} \\  \Delta T \textrm{ is het temperatuurverval} \\ Q  \textrm{ is de hoeveelheid geleverde  warmte}  \\ \hline \\ v =\displaystyle  \frac{\displaystyle  \phi_{v}}{A} = \frac{\displaystyle $debiet \:\:  \textrm{dm}^{3}\textrm{/min} }{\displaystyle \pi  \cdot \left( 0.1 \cdot $diameter/2 \right)^{2} \:\: \textrm{dm}^{2}} \approx $ans1 \:\: \textrm{dm/min} \:\:  \approx $ans11 \:\:\textrm{m/s} \\ \textrm{De snelheid geven we bij het tussenantwoord op in 3 significante cijfers} \\ v \approx $rans11 \:\textrm{ m/s} \\ \\ \hline \\  Q = m \cdot c \cdot \Delta T = $debiet \cdot 4180 \cdot ($tmax - $tmin) \approx $Q \textrm{ Joule/min} \\  \\ Q = \displaystyle \frac{$Q_L \:\: \textrm{ Joule/min}}{ 3600000 \textrm{ Joule/kWh}} \approx $ans2  \:\: \textrm{ kWh/min} \\ \textrm{We moeten het antwoord opgeven in 2 significante cijfers...} \\  \textrm{afkomstig van de temperatuur} \\ \textrm{ Q = } $Q_latex \:\textrm{kWh/min} \end{array} \right.

formula$n=$empty


    

    
