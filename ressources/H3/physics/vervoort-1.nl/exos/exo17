#hfst2
#exo17(hfst2) Isoleren van variabelen [ type y = a*z/x -> x = ? ]
n=$counter
questiontype=1
display=1
checkfile=$checkdir/equation.proc
rounding=-1
mathview=5
s=!randint 200,600
s=$[$s/100]
pm=!randitem -1,1
s=$[$pm*$s]

varlist=z,y
arglist=x

applettext=!nospace y = $s cdot (z) / x -> 

formula$n=y = $s \cdot \displaystyle \frac{z}{x} \rightarrow x =  [?]

texanswer$n=\left[ \begin{array}{cccc} y & = & $s \cdot \displaystyle \frac{z}{x} & \Leftrightarrow \\ \\ y \cdot x & = & $s \cdot \displaystyle \frac{z \cdot x }{x} & \Leftrightarrow \\ \\ y \cdot x & = & $s \cdot z & \Leftrightarrow \\ \\ \displaystyle \frac{y \cdot x}{y} & = & \displaystyle \frac{$s \cdot z}{y} & \Leftrightarrow \\ \\ x & = & \displaystyle \frac{$s \cdot z}{y} \end{array} \right.		

answer$n=$s*z/y
question$n=Isoleer de uitdrukking voor <kbd>x</kbd><br />
mathviewpanel=$module_title:x=:y:z:*:+:-:/
myanswer=!nospace x = $(answer$n)
helptext=Geef je antwoord op als : <kbd>x = je_antwoord</kbd>
!exit
    
