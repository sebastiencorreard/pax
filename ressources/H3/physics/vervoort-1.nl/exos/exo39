n=$counter
#hfst3                                                                                                                                     
#exo36(hfst3)Opwarmtijd van water 
# 3 stappen
questiontype=3
math=0
cols=14
mathview=0
image=0
plot=0
make_tr=1
checkfile=$checkdir/units.proc
inputs=1.1

V=!randint 10,99
T1=!randint 5,24
Td=!randint 20,$[98-$T1]
T2=$[$T1+$Td]
P=!randint 15,30
P=$[$P*100]
perc=$[round($Td*0.653)]
pc=$[$perc/100]
Pn=$[(1-$pc)*$P]

c=4180
Q=$[$V*$c*$Td]
# sec
ans_s=$[$Q/$Pn]
# min
ans=$[$ans_s/60]
sig=2
tot=!exec scienceprint $ans,$sig,0 $ans,$sig,1
c_ans=!item 1 of $tot
h_ans=!item 2 of $tot
answer$n=$c_ans
var1=0
var2=$[abs($ans-$c_ans)]

ss=Een vat met $V liter water wordt verwarmd van $T1 &deg;C tot $T2 &deg;C.<br />Dit opwarmen wordt gedaan met een <span style="color:blue">dompelaar</span> van $P W.<br />Bij deze apparatuur gaat er van de toegevoerde warmte $perc % verloren aan de omgeving.<br />Hoeveel tijd (in minuten) heb je nodig om het water op te warmen.

rr=<ul><li>Q  = m &sdot; c &sdot; &Delta;T <hr />Q in Joule , m in kg , c in J/(kg &deg;C) , T in &deg;C</li><li>Gegeven:<br />&rho;<sub>water</sub> = 1 kg / l<br /> M<sub>water</sub> : $V / &rho; = $V kg<br />c = $c  J/(kg &deg;C)<br />&Delta;T= $T2 - $T1 = $Td &deg;C<br />P = $P Watt<br />P<sub>nuttig</sup> = (100 &minus; $perc) &times; $P / 100 = $[1-$pc] &times; $P = $Pn W = $Pn J/s</li><li>Q = $V &sdot; $c &sdot; $Td = $Q Joule</li><li>Q = P &sdot; tijd <br />[eenheid controleren: Joule = Joule/seconde &sdot; seconde = Joule]<br />tijd = Q / P<br />tijd = $Q / $Pn = $ans_s seconden = $ans min</li><li>Opwarmtijd = $h_ans min (in $sig significante cijfers)</li></ul>

textanswer$n=$rr

helptext=<img src=$module_dir/gifs/exo39.jpg alt=dompelaar /><ul><li>Dichtheid van water : &rho;=1000 kg/m<sup>3</sup></li><li>Soortelijke warmte van water : c = $c  J/(kg &deg;C)</li></ul>
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

m_rightarrow=&nbsp;=&nbsp;
description=Opwarmtijd
ex1=&nbsp;min

!exit
    



