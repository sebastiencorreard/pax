#hfst3
#exo33(hfst3) Bereken toerental centrifuge
n=$counter
questiontype=3
math=0
cols=10
rounding=1
mathview=0
image=0
plot=0
make_tr=1
inputs=1.1
description=Het toerental
m_rightarrow=&nbsp;&asymp;&nbsp;
ex1=&nbsp;<kbd>rpm</kbd>
checkfile=$checkdir/units.proc
var1=$empty
var2=$empty

v=!randint 11,25
# km/h
v=$[$v*10] 
v_m=$[$v*1000/60]
d=!randint 25,50
d=$[$d+0.5]
omtrek_m=$[pi*$d/100]
rpm=$[$v_m/$omtrek_m]
sig=3
tot=!exec scienceprint $rpm,$sig $rpm,$sig,1
answer$n=!item 1 of $tot
h_ans=!item 2 of $tot
var1=0
var2=$[abs($rpm - $(answer$n))]


textanswer$n=<ul><li>De omtreksnelheid is $v km/h = $v&times;1000 m/h = $v&times;1000 / 60 m/min = $v_m m/min </li><li>De omtrek van de cirkel is &pi;&times;$d cm = &pi;&times;$d/100 m = $omtrek_m meter</li><li>Het toerental van deze centrifuge is: $v_m (m/min) / $omtrek_m m = $rpm/min = $rpm  min<sup>-1</sup>  = $rpm rpm</li><li>Het antwoord moet worden opgegeven in $sig significante cijfers (afkomstig van $d)</li><li>Het toerental van deze centrifuge is: $h_ans rpm</li></ul>

extext=Met een centrifuge !<br />Door een snelle draaiende beweging van de centrifugerotor <br />wordt op zwevende deeltjes een extra kracht uitgeoefend.

ss=Hoe kun je de zwaartekracht 'n <span style="color:blue">handje helpen?</span><br />Gegevens van een labcentrifuge :<ul><li>de snelheid aan de omtrek is $v km/h.</li><li>De diameter van de cirkelbeweging is $d cm.</li></ul>Bereken het toerental van de centrifuge in rpm.<br />Geef je antwoord bijvoorkeur op in wetenschappelijke notatie en in de juiste precisie

helptext=<img src=\'$module_dir/gifs/centrifuge.jpg\' alt=\'centrifuge\' /><hr />$extext
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

!exit

    
