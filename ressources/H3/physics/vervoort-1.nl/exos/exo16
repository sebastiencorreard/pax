#hfst2
#exo16(hfst2) Isoleren van variabelen [ type y = a*x -> x = ? ]
display=1
questiontype=1
n=$counter
checkfile=$checkdir/equation.proc
rounding=-1
mathview=5
s=!randint 200,600
s=$[$s/100]
pm=!randitem -1,1
s=$[$pm*$s]

varlist=y
arglist=x

applettext=!nospace y = $s cdot x -> 

formula$n=y = $s \cdot x \rightarrow x =  [?]

texanswer$n=\left[ \begin{array}{cccc} y & = & $s \cdot x & \Leftrightarrow \\ \\ \displaystyle \frac{y}{$s} & = & \displaystyle \frac{$s \cdot x}{$s} & \Leftrightarrow \\ \\ \displaystyle \frac{y}{$s} & = &  x & \Leftrightarrow \\ \\ x & = & \displaystyle \frac{y}{$s} & \end{array} \right.		

answer$n=y/($s)
question$n=Isoleer de uitdrukking voor <kbd>x</kbd><br />
mathviewpanel=$module_title:x=:y:*:+:-:/
myanswer=!nospace x = $(answer$n)
helptext=Geef je antwoord op als : <kbd>x = je_antwoord</kbd>

!exit

    
