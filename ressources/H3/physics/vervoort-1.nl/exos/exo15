#hfst2
#exo15(hfst2) Isoleren van variabelen [ type y = a*x^2 -> x = ? ]
display=1
questiontype=1
n=$counter
checkfile=$checkdir/equation.proc
rounding=-1
mathview=5
s=!randint 200,600
s=$[$s/100]

varlist=y
arglist=x

applettext=!nospace y = $s cdot x^2 -> 

formula$n=y = $s \cdot x^{2} \rightarrow x =  [?]

texanswer$n=\left[ \begin{array}{cccc} y & = & $s \cdot x^{2} & \Leftrightarrow \\ \\ \displaystyle \frac{y}{$s} & = & \displaystyle \frac{$s \cdot x^{2}}{$s} & \Leftrightarrow \\ \\ \displaystyle \frac{y}{$s} & = &  x^{2} & \Leftrightarrow \\ \\ x^{2} & = & \displaystyle \frac{y}{$s} & \Leftrightarrow \\ \\ \sqrt{x^{2}} & = & \displaystyle \sqrt{\frac{y}{$s}} & \Leftrightarrow \\ \\ x & = & \displaystyle \sqrt{\frac{y}{$s}} & \end{array} \right.		

answer$n=sqrt(y/($s))

helptext=Geef je antwoord op als : <kbd>x = je_antwoord</kbd>
question$n=Isoleer de uitdrukking voor <kbd>x</kbd><br />
mathviewpanel=$module_title:x=:y:sqrt:*:+:-:/
myanswer=!nospace x = $(answer$n)
!exit
    
