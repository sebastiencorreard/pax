!set title=Rekenen in andere Getallenstelsels
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 6

val6=$[rint($(tmp0))]
tmp0=!randitem +,-

val7=$(tmp0)

!ifval $val7 issametext +
tmp0=!randint 0, $val6-1

tmp1=!randitem $val6-1,$(tmp0)

val8=$[rint( $(tmp1))]
!else
tmp2=!randint 1, $val6-1

tmp3=!randitem $val6-1,$(tmp2) 

val8=$[rint($(tmp3))]
!endif

!ifval $val7 issametext +
tmp0=!randint 0, $val6-2

val9=$[rint( $(tmp0))]
!else
tmp1=!randint 1, $val6-1

val9=$[rint( $(tmp1))]
!endif
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of 100,1000

val11=$[rint($(tmp0))]
!if $val7 issametext +  

!ifval $val10=1
val12=$[rint( $val8+1)]
!else
val12=$[rint($val8)]
!endif

!ifval $val10=1
val13=$[rint($val9)]
!else
val13=$[rint($val9+1)]
!endif

!ifval $val12=$val6 
val13=$[rint( $val13+1)]
!endif

!ifval $val12=$val6 
val12=$[rint( 0)]
!endif
!else

!ifval $val10=1
val12=$[rint( $val8-1)]
!else
val12=$[rint($val8)]
!endif

!ifval $val10=1
val13=$[rint($val9)]
!else
val13=$[rint($val9-1)]
!endif

!ifval $val13=-1 
val12=$[rint( $val12-1)]
!endif

!ifval $val13=-1 
val13=$[rint( $val6-1)]
!endif
!endif
tmp0=!randint 0, $val6-1

tmp1=!randitem e,e,$(tmp0)

val14=$(tmp1)
tmp0=!nospace abc$val9$val8 d$val14

val15=$(tmp0)
tmp0=!nospace abc$val13$val12 d$val14

val16=$(tmp0)
replyname1=n$val7 $val11
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We werken in het $val6 -tallige stelsel.<br>	Een getal 
!insmath $val15
$() wordt geschreven als $val15 .<br>	Hoe schrijven we dan 
!insmath n$val7 $val11
$() ?		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,15
embedcnt=0
