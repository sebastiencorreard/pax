!for val11 =1 to $val9 
tmp0=!randitem 1,0

val12=$[rint($(tmp0))]
val7=$[rint($val7+$val12*2^($val11-1))]
val8=$[rint($val8+$val12*10^($val11-1))]
val10=$val10, $val12
!next
t_=!replace internal \( by ( in $val8
tmp0=!exec pari $t_

val8=$(tmp0)
tmp0=!item $val9+1 of $val10

val13=$(tmp0)
tmp0=!item $val9 of $val10

val14=$(tmp0)
tmp0=!item $val9-1 of $val10

val15=$(tmp0)
tmp0=!item $val9-2 of $val10

val16=$(tmp0)
tmp0=!item $val9-3 of $val10

val17=$(tmp0)
