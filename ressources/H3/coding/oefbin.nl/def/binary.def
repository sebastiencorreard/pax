t_=!replace internal \( by ( in k=3;n=0;nbin=0; for(i=1,k, n1=RANDOM(2); n=n+n1*2^(i-1);	nbin=nbin+n1*10^(i-1)); print(n","nbin)
tmp0=!exec pari $t_

val6=$(tmp0)
