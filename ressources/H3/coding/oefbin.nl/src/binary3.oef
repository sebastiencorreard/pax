\title{Binaire getallen III}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{k=8}
\integer{uns=random(3,4,5)}
\text{pp=item(1..\uns,shuffle(\k))}
\integer{n=wims(replace internal , by +2^ in 2^\pp)}
\integer{n=\n/2}
\text{rep1=8 isitemof \pp?1:0}
\text{rep2=7 isitemof \pp?1:0}
\text{rep3=6 isitemof \pp?1:0}
\text{rep4=5 isitemof \pp?1:0}
\text{rep5=4 isitemof \pp?1:0}
\text{rep6=3 isitemof \pp?1:0}
\text{rep7=2 isitemof \pp?1:0}
\text{rep8=1 isitemof \pp?1:0}

\statement{Schrijf het getal \n in binaire notatie.
<p>
<center>
<table align="center" border=1>
 <tr>
	<th>Machten van 2</th> 
	<th> \(2^7)</th>
	<th> \(2^6)</th>
	<th> \(2^5)</th>
	<th> \(2^4)</th>
	<th> \(2^3)</th>
	<th> \(2^2)</th>
	<th>\(2^1)</th>
	<th>\(2^0) </th> 
</tr> 
<tr>
	<td>&nbsp;</td>
	<td>128</td> 
	<td>64</td> 
	<td>32</td> 
	<td>16</td> 
	<td>8</td>
	<td>4</td>
	<td>2</td>
	<td>1</td>
</tr> 
<tr>
	 <td> \n</td>
	<td>\embed{reply 1,4}</td>
	<td>\embed{reply 2,4}</td>
	<td>\embed{reply 3,4}</td>
	<td>\embed{reply 4,4}</td>
	<td>\embed{reply 5,4}</td>
	<td>\embed{reply 6,4}</td>
	<td>\embed{reply 7,4}</td>
	<td>\embed{reply 8,4}</td>
	
</tr>  
</table>
</center>}


\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=numeric}
\answer{}{\rep5}{type=numeric}
\answer{}{\rep6}{type=numeric}
\answer{}{\rep7}{type=numeric}
\answer{}{\rep8}{type=numeric}

\feedback{1=1}{\n in binaire notatir is \nbin}
\feedback{\rep8 <> \reply8}{<p>het gehele getal<b> \n </b> is \if{\rep8=0}{pair}{impair}; jouw antwoord eindigd op  \if{\rep8=0}{1}{0}, en dat is werkelijk onmogelijk.}
