\title{Binaire getallen IV}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{k=8}
\integer{n=0}
\integer{nbin=0}
\text{liste=2}
\text{choix1=randint(1..4)}
\text{choix2=randint(5..8)}
\for{i=1 to \k-1}{
	\integer{n1=random(1,0)}
	\integer{n= \n+\n1*2^(\i-1)}
	\integer{nbin=\nbin+\n1*10^(\i-1)}
	\text{liste=  \liste, \n1}
	}
\integer{n1=random(1,1,1,1,0)}
	\integer{n= \n+\n1*2^(\k-1)}
	\integer{nbin=\nbin+\n1*10^(\k-1)}
	\text{liste=  \liste, \n1}	
\text{choix1=randint(5..8)}
\text{choix2=randint(1..4)}
\text{reponse= \n}
\integer{m= item(\choix1+1,\liste)=1 ? \n-2^(\choix1-1): \n+2^(\choix1-1)}
\text{reponse=\reponse,\m}
\integer{m1= item(\choix2+1,\liste)=1 ?   \n-2^(\choix2-1):\n+2^(\choix2-1)}
\text{reponse=\reponse,\m1}
\integer{m1= item(\choix2+1,\liste)=1 ?   \m-2^(\choix2-1):\m+2^(\choix2-1)}
\text{reponse=\reponse,\m1}
\text{nbin=pari(\nbin)}
\text{rep1=item(\k+1,\liste)}
\text{rep2=item(\k,\liste)}
\text{rep3=item(\k-1,\liste)}
\text{rep4=item(\k-2,\liste)}
\text{rep5=item(\k-3,\liste)}
\text{rep6=item(\k-4,\liste)}
\text{rep7=item(\k-5,\liste)}
\text{rep8=item(\k-6,\liste)}


\statement{De binaire representatie van het gehele getal <b>\(n)</b> is
<p>
<center>
<table align="center" border=1>
 <tr align="center">
	<th>Machten van 2</th> 
	<th> \(2^7)</th>
	<th> \(2^6)</th>
	<th> \(2^5)</th>
	<th> \(2^4)</th>
	<th> \(2^3)</th>
	<th> \(2^2)</th>
	<th>\(2^1)</th>
	<th>\(2^0) </th> 
</tr> 
<tr align="center">
	<td>&nbsp;</td>
	<td>128</td> 
	<td>64</td> 
	<td>32</td> 
	<td>16</td> 
	<td>8</td>
	<td>4</td>
	<td>2</td>
	<td>1</td>
</tr> 
<tr align="center">
	 <td> n </td>
	<td>\if{\choix1=8}{a}{\rep1}</td>
	<td>\if{\choix1=7}{a}{\rep2}</td>
	<td>\if{\choix1=6}{a}{\rep3}</td>
	<td>\if{\choix1=5}{a}{\rep4}</td>
	<td>\if{\choix2=4}{b}{\rep5}</td>
	<td>\if{\choix2=3}{b}{\rep6}</td>
	<td>\if{\choix2=2}{b}{\rep7}</td>
	<td>\if{\choix2=1}{b}{\rep8}</td>
	
</tr>  
</table>
</center>
<p>
Geef alle mogelijke waarden van \(n) . 
Schrijf je antwoord in decimale notatie. }


\answer{}{\reponse}{type=set}
