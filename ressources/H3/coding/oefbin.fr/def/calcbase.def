!set title=Calcul en base b
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Rekenen in andere Getallenstelsels

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Écrivons les entiers en base,	  Un entier \(n\) s'écrit,	  Comment s'écrit
!if $val6=nl 
val7=We werken in het,	  -tallige stelsel. Een getal \(n\) wordt geschreven als,	  Hoe schrijven we dan
!endif
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
tmp0=!randitem +,-

val9=$(tmp0)

!ifval $val9 issametext +
tmp0=!randint 0, $val8-1

tmp1=!randitem $val8-1,$(tmp0)

val10=$[rint( $(tmp1))]
!else
tmp2=!randint 1, $val8-1

tmp3=!randitem $val8-1,$(tmp2) 

val10=$[rint($(tmp3))]
!endif

!ifval $val9 issametext +
tmp0=!randint 0, $val8-2

val11=$[rint( $(tmp0))]
!else
tmp1=!randint 1, $val8-1

val11=$[rint( $(tmp1))]
!endif
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of 100,1000

val13=$[rint($(tmp0))]
!if $val9 issametext +  

!ifval $val12=1
val14=$[rint( $val10+1)]
!else
val14=$[rint($val10)]
!endif

!ifval $val12=1
val15=$[rint($val11)]
!else
val15=$[rint($val11+1)]
!endif

!ifval $val14=$val8 
val15=$[rint( $val15+1)]
!endif

!ifval $val14=$val8 
val14=$[rint( 0)]
!endif
!else

!ifval $val12=1
val14=$[rint( $val10-1)]
!else
val14=$[rint($val10)]
!endif

!ifval $val12=1
val15=$[rint($val11)]
!else
val15=$[rint($val11-1)]
!endif

!ifval $val15=-1 
val14=$[rint( $val14-1)]
!endif

!ifval $val15=-1 
val15=$[rint( $val8-1)]
!endif
!endif
tmp0=!randint 0, $val8-1

tmp1=!randitem e,e,$(tmp0)

val16=$(tmp1)
tmp0=!nospace abc$val11$val10 d$val16

val17=$(tmp0)
tmp0=!nospace abc$val15$val14 d$val16

val18=$(tmp0)
replytype1=nocase
replyname1=\(n) $val9 $val13
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) $val8. $(val7[2]) $val17.	  $(val7[3]) 
!insmath n $val9 $val13
$()?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,13,17
embedcnt=0
