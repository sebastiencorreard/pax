\title{Question 1102 Somme d'un entier et d'une fraction}
\keywords{mental_calculation,addition,fraction}
%%%%%%%%%%%% question 15 %%%%%%%%%%%%%
\integer{a=randitem(1,2,3)}
\integer{b=randint(3,6,7)}
\text{op=random(+,-)}
\text{enonce= \(\a \op \frac{1}{\b} ={}\)  }
\rational{rep=\a \op 1/\b}
\integer{tempa=\a*\b}
\text{enonceb=}
\text{feedback=Rappel : \(\a=\frac{\tempa}{\b}\)}
