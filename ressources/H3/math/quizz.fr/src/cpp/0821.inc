\title{Question 0821 Egalités de fractions}
\keywords{mental_calculation,fraction,number_writing}
%%% a/b=c/d
\text{liste=shuffle(2,3,5,7)}
\integer{a=\liste[1]*\liste[3]}
\integer{b=\liste[2]*\liste[3]}
\integer{c=\liste[1]*\liste[4]}
\integer{d=\liste[2]*\liste[4]}
\rational{rep=\c}
\text{enonce=Complète \(\frac{\a}{\b}=\frac{\dots}{\d}\) <br> Réponse &#58;}
\text{enonceb=}
%%%% feedback %%%%
\text{feedback=random(On peut remarquer que \(\frac{\a}{\b}=\frac{\liste[1]}{\liste[2]}\) et que  \(\d=\liste[2] \times \liste[4]\)<br> La bonne réponse est donc \(\liste[1] \times \liste[4]\),\(\frac{\a}{\b}=\frac{\liste[1]}{\liste[2]}=\frac{\liste[1]\times \liste[4]}{\liste[2] \times \liste[4]}=\frac{\c}{\d}\))}
