\title{Question 0920 Problème de rendu de monnaie}
\keywords{mental_calculation,pbsolving}
\integer{a1=randint(1..3)}
\integer{a2=randint(5..8)}
\integer{a3=0}
\text{aquest=\a1.\a2\a3}
\real{rep=10-2*(\a1+\a2*0.1)}
\text{enonce=Une gaufre coûte \(\aquest\) &euro;. J'achète deux gaufres, je paie avec un billet de \(10\) &euro;. On me rend }
\text{enonceb=&euro;.}
\text{feedback=L'opération à faire est : \(10-\aquest \times 2\).}
