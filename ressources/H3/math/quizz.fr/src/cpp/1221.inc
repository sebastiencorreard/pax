\title{Question 1221 Valeur remarquable du cosinus}
\keywords{mental_calculation,trigonometry}
%%%%%%% (k+1) cos(kPi)
\integer{k=randint(2000..3000)}
\integer{k2=\k+1}
\integer{rep=(\k2)*cos(\k*PI)}


\text{enonce=\(\k2 \times cos(\k \pi)\)<br> Réponse &#58; }
\text{enonceb=}
\text{feedback=\(cos(k\pi)=(-1)^k\). Vaut \(1\) si \(k\) est pair, \(-1\) sinon.}
