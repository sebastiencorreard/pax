\title{Question 0423 Problème}
\keywords{pbsolving}
\integer{a=randitem(50,10,10,20)}
\integer{p=randint(1,2)}
\integer{p2=\p*100}
\integer{b=\p*100/\a}
\real{rep=\b}
\text{enonce=Un caramel coûte \(\a\) centimes. <br>En dépensant \(\p\) euros, j'achète  }
\text{enonceb= caramels.}
