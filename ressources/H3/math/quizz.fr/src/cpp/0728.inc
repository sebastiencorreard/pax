\title{Question 0728 Mutiplication 999}
\keywords{methodical_calculation}
\integer{a=randint(2..4)*10+randint(2..4)}
\integer{cas=randomitem(1,2,2,2,3)}
\text{c=9,99,999}
\integer{b=\c[\cas]}
\text{d=10,100,1000}

\integer{rep=\a*\b}
\text{enonce=\(\a \times \b\)}
\text{feedback=\(\b=\d[\cas]-1\), on peut donc faire \(\a \times \d[\cas] -\a\)}