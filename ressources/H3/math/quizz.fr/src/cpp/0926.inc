\title{Question 0926 Multiplication de nombres décimaux}
\keywords{mental_calculation,fraction,decimals,multiplication}
\real{a11=randint(20..30)+randint(1)/4}
\integer{b11=4*randint(2..7)}
\real{rep=\a11*\b11}
\text{enonce=\(\a11 \times \b11 =\)}
\text{enonceb=}
\integer{temp11=\b11/4}
\text{feedback=On remarque que : \(\a11 \times \b11 =\a11 \times 4 \times \temp11\)}
