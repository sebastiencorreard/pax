\title{Question 1009 Calcul de moyenne }
\keywords{mental_calculation,methodical_calculation,mean}
%%%%%%%%%Question 9 %%%%%%%%%%%%%%%%%%%%%%%
\integer{m9=random(80,100,100,120)}
\integer{som9=random(20,40)}
