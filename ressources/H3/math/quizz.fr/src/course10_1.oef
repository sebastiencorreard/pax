\title{Question 1013 Soustraction et carré}
\keywords{mental_calculation,subtraction,power}
%%%%%%%%%%%%% question 13 %%%%%%%%%%%%%
\integer{a13=randitem(20,5)}
\integer{b13=randitem(2,3)}
\integer{c13=\a13*\b13}
\integer{rep=\c13^2-\a13^2}
\text{enonce=\(\c13^2-\a13^2 =\) }
\text{enonceb=}
\text{feedback=Il faut factoriser. Ici : \(\c13^2-\a13^2=(\a13*\b13)^2-\a13^2=\a13^2(\b13^2-1)\) }
\text{enonce13=\enonce}
\text{enonceb13=\enonceb}
\text{rep13=\rep}
