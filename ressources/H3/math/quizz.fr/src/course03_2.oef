\text{temp=\minutes1 <0? wims(append item \h1 h 45 min to \temp):wims(append item \h h \minutes1 min to \temp)}
\text{temp=\minutes <0? wims(append item \h2 h 45 min to \temp):wims(append item \h1 h \minutes min to \temp)}
