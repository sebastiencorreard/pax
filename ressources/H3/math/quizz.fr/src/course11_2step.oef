\title{Question 1129 Périmètre et aires}
\keywords{mental_calculation,perimeter,area,squareroot}
\text{um=random(m,mm,cm)}
\integer{l=randint(5,7,8,9)}
\integer{a=\l*\l}
\integer{rep=4*\l}
\text{enonce=Périmètre d'un carré d'aire \(\a\) \(\um^2\)<br> }
\text{enonceb=\(\um\)}
\text{feedback=Les côtés mesurent \(\l\) \(\um\). La réponse est donc \(4\times\l\)\( \um\)}
\text{enonce14=\enonce}
\text{enonceb14=\enonceb}
\text{rep14=\rep}
\text{feedback14=\feedback}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\title{Question 1130 Produit&#44; quotient d'exponentielles}
\keywords{mental_calculation,exponent,multiplication,power,division}
%%% e^a*e^b / e^c= 10^??
\integer{c7=randint(4..5)}
\integer{a7=randint(6..7)}
\integer{b7=randint(2..3)}
%%%%%% fait par méthode spéciale \frac{e^\a7 \times e^\b7}{e^\c7}=e^{...} %%%%
\text{enonce=Complète \(\frac{e^\a7 \times e^\b7}{e^\c7}=e^{....}\) <br> Réponse :}
\text{enonceb=}
\integer{rep=\a7+\b7-\c7}
\text{feedback=Rappel : \(\frac{e^\a7 \times e^\b7}{e^\c7}=e^{\a7+\b7-\c7}=e^\rep\)}
\text{enonce15=\enonce}
\text{enonceb15=\enonceb}
\text{rep15=\rep}
\text{feedback15=\feedback}
