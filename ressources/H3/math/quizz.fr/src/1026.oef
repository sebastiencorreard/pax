\text{feedback211=\(0.75 \times \a11=\frac{3}{4} \times \a11=\frac{\a11 \times 3}{4} \)\({}= \frac{\a11 }{4}\times 3=\b11 \times 3 = \temp11\)}
\text{feedback=\choix11=1 ? \feedback111 : \feedback211}
