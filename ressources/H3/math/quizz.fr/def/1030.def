!set title=Question 1030 Script Python
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,python
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX
oefcss=<style>.CodeMirror {max-height:100px;}</style>

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 5,10,25

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp0=!randint 4, 9

val9=$[rint($val8*$(tmp0))]
val10=$[rint($val9+$val8)]
tmp0=!randint 1, 4

val11=$[rint($val9+$(tmp0))]
val12=def fin (b):	   a = 0	   while a < b :	      a = a + $val8	   return a
!readproc slib/editor [python,[$val12]],1,readonly fullscreen theme=[3024-night,3024-day] 
tmp0=$slib_out
val13=$(tmp0)
val14=On considère le script python &#58;	$val13	L'expression fin($val11) renvoie &#58; 
val15=
val16=Lors de l'exécution du programme Python, la variable a prend comme valeurs successives les multiples de $val8 tant qu'ils ne dépassent pas $val11. La réponse est donc $val9 &#58; le premier multiple de	$val8 supérieur à $val11.
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val16!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,16
embedcnt=1
