!set title=Question 1023 Exploiter un ratio
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,proportionality
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 3,4,5,7

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 3,4,5,7

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval $val8==$val9
val9=$[rint( $val9+1)]
!endif
tmp=!nonempty items 3,4,5,6,8

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]

!ifval $val11==1
val12=$[ $val10*$val8 ]
!else
val12=$[ $val10*$val9]
!endif

!ifval $val11==1
val13=$[$val8]
!else
val13=$[$val9]
!endif

!ifval $val11==1
val14=$[$val9]
!else
val14=$[$val8]
!endif

!ifval $val11==1
val15=$[ $val10*$val9 ]
!else
val15=$[ $val10*$val8]
!endif

!ifval $val11==1
val16= filles 
!else
val16= garçons
!endif

!ifval $val11==1
val17= garçons 
!else
val17= filles
!endif

!ifval $val11==1
val18= $val8
!else
val18= $val9
!endif

!ifval $val11==1
val19= $val9
!else
val19= $val8
!endif
val20=Dans une classe de troisième, le ratio filles &#58; garçons est de $val8 &#58; $val9.<br>Il y a dans cette classe $val12 $val16. Calculer le nombre de $val17. <br> Réponse &#58; 
val21=
val22=L'énoncé signifie qu'il y a $val8 filles pour $val9 garçons.	Comme il y a au total $val10 fois $val13 $val16, cela fait $val10 fois $val14 $val17.
val23=\begin{enumerate}
val23=$val23	    \item	    $val20	    \dots $val21	  
val23=$val23\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
