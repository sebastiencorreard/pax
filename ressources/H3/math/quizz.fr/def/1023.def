$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val22!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val22</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,20,21,22,23
embedcnt=1
