xrange $val17,$val24	yrange -30,15	arrow $val17,0,$val24,0,10,black	arrow $val13,-20,$val13,-5,10,black	segment $val8,-3,$val8,3,black	parallel $val8,-2,$val8,10,1,0,$val14,black	parallel $val8,-2,$val8,6,0.5,0,$val15,black	parallel $val8,-2,$val8,2,0.1,0,$val16,black	text black,$val21,-5,large, $val8	text black,$val22,-5,large, $val9	text black,$val23,-5,large, $val10	 
