!set title=Question 0921 Vitesse&#44; temps et distance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,pbsolving,proportionality,velocity,time,distance
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 3, 9

val8=$[rint($(tmp0)*10)]
val9=$[rint($val8/2)]
val10=$[rint(60)]
val11=$[rint($val10/3)]
val12=$[rint($val10-5)]
val13=$[rint(100/$val11-1)]
val14=$[rint(100/$val9-1)]
tmp=!translate ";': to $     $ in $val8/$val10*100

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=100,$(tmp0)

!ifval $(val15[2])>100
tmp=!translate ";': to $     $ in 100*$val10/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0),100
!else
val15=$val15
!endif
!readproc oef/draw.phtml 300,300 \
xrange -20,110	yrange -20,120	arrow 0,0,0,100,10,black	arrow 0,0,100,0,10,black	parallel $val11,0,$val11,100,$val11,0,$val13,grey	parallel 0,$val9,100,$val9,0,$val9,$val14,grey	segment 0,0,$(val15[1]),$(val15[2]),black	dsegment 0,$val8,$val10,$val8,black	dsegment $val10,0,$val10,$val8,black	text black,-10,$val8,large,$val8	text black,$val12,-6,large,$val10	text black,-10,110,large,Distance en km	text black,65,-6,large,Temps en min	 
tmp0=$ins_url
val16=$(tmp0)
val16=<div class="wimscenter"><img src="$val16" alt=""></div>
tmp0=!randitem 4,5,7

val17=$[rint($(tmp0))]
val18=$val16 À vitesse constante, le graphique ci-dessous donne la distance parcourue en fonction du temps. Quelle est la distance parcourue en \($val17\) heures?
val19=\( km \).
val20=$[$val8*$val17]
val21=Graphiquement la vitesse est de \($val8 km\) pour \(60 min\) donc \($val8 km\) en une heure.	  Il reste à faire la multiplication \($val8 \times $val17\) pour trouver la réponse.
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val18  
!read oef/embed.phtml r1,10	    autofocus 
$() $val19</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,18,19,21
embedcnt=1
