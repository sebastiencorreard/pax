!set title=Question 0713 Multiplication entier décimal 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=multiplication,decimals
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 5, 9

val9=$[rint($(tmp0)*10)]
tmp=!nonempty items 1,2,2

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp0=!randint 2, 4

val11=$[$(tmp0)]
val12=$[$val11/(10^$val10)]

!ifval $val10==1
val13=$[0.1]
!else
val13=$[0.01]
!endif
val14=\($val9 \times $val12 ={}\) 
val15=

!ifval $val10==1
val16=une décimale
!else
val16=deux décimales
!endif
val17=$[$val9*$val12]
val18=$val12 possède $val16, le résultat doit en avoir autant. Ou encore : \($val9 \times $val11 \times $val13\) 
val19=\begin{enumerate}
val19=$val19	    \item	    $val14	    \dots $val15	  
val19=$val19 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,18,19
embedcnt=1
