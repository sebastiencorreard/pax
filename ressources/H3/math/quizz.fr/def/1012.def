!set title=Question 1012 Multiplication réfléchie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,multiplication,methodical_calculation
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 4,0.25;	0.2,10;	0.2,5;	0.5,20
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp=!trim 12.2,10;	13.4,10;	11.2,10;	10,4.5
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]

!ifval $val10=1
val11=$(val8[1])
!else
val11=$(val8[2])
!endif

!ifval $val10=1
val12=$(val9[1])
!else
val12=$(val9[2])
!endif

!ifval $val10=2
val13=$(val8[1])
!else
val13=$(val8[2])
!endif

!ifval $val10=2
val14=$(val9[1])
!else
val14=$(val9[2])
!endif
val15=$[rint($val11*$val12*$val13*$val14)]
val16=\($val11 \times $val12 \times $val13 \times $val14=\)
val17=
val18=$[rint($(val8[1])*$(val8[2]))]
val19=$[rint($(val9[1])*$(val9[2]))]
val20=Il faut regrouper les termes pour faciliter l'opération. Ici : \($(val8[1]) \times $(val8[2])=$val18\) et \($(val9[1]) \times $(val9[2])=$val19\).
val21=\begin{enumerate}
val21=$val21	    \item	    $val16	    \dots $val17	  
val21=$val21\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,10	    autofocus 
$() $val17</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val20!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,17,20,21
embedcnt=1
