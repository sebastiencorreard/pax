!set title=Question 1018 Vitesse, distance, durée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,proportionality,velocity
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 120,80,160

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 2,3,4

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]

!ifval $val10=1 
val11=$[rint( $val9 )]
!else
val11=$[rint( $val9-1)]
!endif

!ifval $val10=1 
val12= $val11 h 15 min 
!else
val12= $val11 h 45 min
!endif
val13=$[$val8*$val9+$val10*$val8/4]
val14=$[$val13]
val15=Quelle est la distance parcourue en $val12 à \($val8\) km/h &#63;<br>Réponse :
val16=km

!ifval $val10=1 
val17= et 
!else
val17= moins le 
!endif

!ifval $val10=1 
val18= plus 
!else
val18= moins
!endif
val19=En $val9 heure $val17 quart, on parcourt $val11 fois $val8 km $val18 le quart de $val8 km, soit $val13 km.
val20=\begin{enumerate}
val20=$val20	    \item	    $val15	    \dots $val16	  
val20=$val20\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,10	    autofocus 
$() $val16</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val19!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val19</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,15,16,19,20
embedcnt=1
