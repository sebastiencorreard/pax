!set title=Question 0909 Multiplication de décimaux 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,multiplication,decimals
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 3,7,4,6,8,9

val8=$(tmp0)
tmp0=!randint 1, 9

val9=$[$(tmp0)+$(val8[1])/10]
tmp0=!randint 1, 9

val10=$[$(tmp0)+$(val8[2])/10]
val11=$[$val9*$val10*10]
val12=$[$val9*$val10/10]
val13=$[$val9*$val10]
val14=Sélectionne le résultat de $val9\( {}\times {} \)$val10. 
val15=
val16=Rappel : \($val9\) possède une décimale, \($val10\) possède une décimale donc \($val9 \times $val10\) a \(1+1=2\) décimales.
val17=\begin{enumerate}
val17=$val17	    \item	    $val14	    \begin{radio}	    \item $val13	    \item $val11	    \item $val12	    \end{radio}
val17=$val17 \end{enumerate}
replytype1=menu
replyoption1=shuffle default=$val11 weight=2 
replyname1=
replygood1=1;$val13,$val11,$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

