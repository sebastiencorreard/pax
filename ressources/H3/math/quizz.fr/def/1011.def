!set title=Question 1011 Ecriture scientifique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,multiplication,scientific_notation,power
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
tmp0=!randint 2, 9

val9=$[rint($(tmp0)*10)]
tmp0=!randint 2, 9

val10=$[rint($(tmp0)*100)]
tmp0=!randint 21, 35

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]

!ifval $val12=1
val13=$[rint($val8+$val9)]
!else
val13=$[rint($val8+$val9+$val10)]
!endif
tmp=!translate ";': to $     $ in $val13/10^$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$[$(tmp0)]
val15=$[rint($val11+$val12)]
val16=$val14*10^$val15
val17=$val14*10^$val11
val18=$val13*10^$val11
val19=$[rint($val11-$val12)]
val20=$val14*10^$val19
val21=Ecriture scientifique de \($val13 \times 10^$val11 \) 
val22=
val23=Rappel : \($val13=$val14 \times 10^$val12\). 
val24=\begin{enumerate}
val24=$val24\end{enumerate}
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
!read oef/embed.phtml r1,10	    autofocus 
$() $val22</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val24 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val23!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val23</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,21,22,23,24
embedcnt=1
