!set title=Question T1128 Image par une fonction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,literal_calculation
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp=!nonempty items 1,1,2,3

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1,2,-2

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val9*x^2+$val11*x+$val10
tmp0=!exec pari $t_

val12=!rawmath $(tmp0)
tmp0=!randitem -1,-2,-3

val13=$[rint($(tmp0))]
evaltmp=$val12

evaltmp=!mathsubst x=($val13) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
val15=Calculer l'expression \($val12 \) pour \(x=$val13 \) &#58; 
val16=
val17=Attention au signe, le carré est toujours positif. \(x^2\) vaut \(1\) lorsque \(x=-1\).
val8=$[rint(6)]
val18=\begin{enumerate}
val18=$val18	    \item	    $val15	    \dots $val16	  
val18=$val18 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val16	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,15,16,17,18
embedcnt=1
