!set title=Question T1125 Somme de fractions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,addition
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp=!trim 4,6,12	6,8,24	6,9,18	8,12,24	9,12,36
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val10=$[rint($(tmp1))]
val11=$[rint($(val9[$val10;1]))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val12=$[rint($val11+$(tmp0))]
val13=$[rint($(val9[$val10;2]))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val14=$[rint($val13+$(tmp0))]
val15=$[rint($(val9[$val10;3]))]
val16=$[rint($val12*($val15/$val11))]
val17=$[rint($val14*($val15/$val13))]
val18=$[rint($val16+$val17)]
t_=!replace internal \( by ( in $val12/$val11+$val14/$val13
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val19=!exec pari print($t_)
val20=Exprimer sous forme d'une fraction irréductible, la somme \(\frac{$val12}{$val11}+\frac{$val14}{$val13}\) : 
val21=
val22=Le plus petit dénominateur commun est $val15.<br>\(\frac{$val12}{$val11}+\frac{$val14}{$val13}=\frac{$val16}{$val15}+\frac{$val17}{$val15}=\frac{$val18}{$val15}\).
val8=$[rint(6)]
val23=\begin{enumerate}
val23=$val23 \end{enumerate}
replytype1=nocase
replyname1=
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

