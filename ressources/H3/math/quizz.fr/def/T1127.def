!set title=Question T1127 Proportion
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,percents,proportionality
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp=!trim 10,20,20,30,30	20,10,15,25,30	25,12,16,20,24	50,14,16,18,20	75,12,16,20,24	
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val10=$[rint($(tmp1))]
tmp0=!randint 2, 5

val11=$[rint($(tmp0))]
val12=$[rint($(val9[$val10;$val11])*$(val9[$val10;1])/100)]
val13=$[rint($(val9[$val10;1]))]
val14=Si \($val12\) des \($(val9[$val10;$val11])\) classes du lycée participent au concours "La Course Aux Nombres", quel pourcentage de classes a participé &#63;<br>
val15=\(\%\).
val16=\($val12 \div $(val9[$val10;$val11])=$val13 \%\)
val8=$[rint(6)]
val17=\begin{enumerate}
val17=$val17 \end{enumerate}
replytype1=formal
replyoption1=comma default=0 
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,16,17
embedcnt=1
