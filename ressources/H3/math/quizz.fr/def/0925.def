!set title=Question 0925 Lire une abscisse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,fraction,pbsolving,number_line
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val8+1

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$[rint($(tmp0))]
tmp0=!randitem 3,4

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val9*$val10+1)/$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
val12=$val11
val13=$[1/$val10]
val14=$[$val8-1]
val15=$[$val11+1]
val16=$[rint($val10+2)]
val14=$[$val8-1/$val10]
val15=$[$val11+2/$val10]
!readproc oef/draw.phtml 250,100 \
xrange $val14,$val15	yrange -30,5	arrow $val14,0,$val15,0,10,black	arrow $val11,-20,$val11,-5,10,black	segment $val8,-3,$val8,3,black	segment $val9,-3,$val9,3,black	parallel $val8,-2,$val8,2,$val13,0,$val16,black	text black,$val8,-5,large, $val8	text black,$val9,-5,large, $val9	 
tmp0=$ins_url
val17=$(tmp0)
val17=<div class="wimscenter"><img src="$val17" alt=""></div>
val18=$val17 Réponse : 
val19=
val20=L'unité est découpée en \($val10\), les graduations sont donc des \(\frac{1}{$val10}\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val18  
!read oef/embed.phtml r1,10	    autofocus 
$() $val19</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,18,19,20
embedcnt=1
