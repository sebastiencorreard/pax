!set title=Question 0730 Ecriture décimale d'une fraction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals,fraction
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 1,2,3,4,6,7,8,9

val9=$[rint($(tmp0))]
val10=$[rint(5)]
tmp=!translate ";': to $     $ in $val9/$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[$(tmp0)]
val12=$val11
tmp0=!replace internal . by , in $val11

val11=$val11|$(tmp0)
val13=$[rint(2*$val9)]
val14=Ecriture décimale de \(\frac{$val9}{$val10}\) &#58; 
val15=<div class="wims_instruction">Sans zéros inutiles</div>
val16=Rappel :\(\frac{$val9}{$val10}=\frac{$val13}{10}=$val12\).
val17=\begin{enumerate}
val17=$val17 \end{enumerate}
replytype1=case
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,16,17
embedcnt=1
