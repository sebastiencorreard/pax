!set title=Question 0715 Moitié d'un décimal
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,division
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 3,5,7,9

val9=$[$(tmp0)/10]
val10=$[rint($val9*100)]
val11=$[rint($val10/2)]
val12=$[$val9/2]
val13=$[$val9/2]
val14=La moitié de \($val9\) &#58;
val15=
val16=\($val9=\frac{$val10}{100}\) vaut \($val10\) centièmes. <br>Sa moitié vaut donc \($val11\) centièmes donc \($val12\) 
val17=\begin{enumerate}
val17=$val17	    \item	    $val14	    \dots $val15	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
