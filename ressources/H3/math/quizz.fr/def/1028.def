!set title=Question 1028 Théorème de Thalès
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,proportionality
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in 6.5,4,13,2	7.5,4,10,3	8,3,6,4	6,4,8,3	5,6,10,3

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$[$(val9[1])]

!ifval $val8==1 
val11= FC 
!else
val11= $(val9[4])
!endif

!ifval $val8==1 
val12= $(val9[4]) 
!else
val12= EC 
!endif

!ifval $val8==1 
val13= $(val9[3]) 
!else
val13= $(val9[2])
!endif

!ifval $val8==1 
val14= $(val9[2]) 
!else
val14= $(val9[3])
!endif

!ifval $val8==1 
val15= $val11 
!else
val15= $val12
!endif

!ifval $val8==1 
val16= text black,85,135,medium,$val12 
!else
val16= text black,100,60,medium,$val11 
!endif
!readproc oef/draw.phtml 230,115 \
xrange 0,200	yrange 0,200	line 20,80,180,120,black	line 90,30,110,170,black	line 20,80,90,30,black	line 180,120,110,170,black	text black,100,90,medium,C	text black,10,75,medium,A	text black,55,90,medium,$val13	text black,90,25,medium,F	text black,100,200,medium,E	text black,185,150,medium,B	text black,140,110,medium,$val14	$val16 
tmp0=$ins_url
val17=$(tmp0)
val17=<img src="$val17" alt="">
val18=</td></tr></table>
val19=<table><tr><td>$val17 </td><td>Les droites (AF) et (EB) sont parallèles.<br>Déterminer $val15 &#58; 
val18=</td></tr></table>
val20=On doit avoir (d'après le théorème de Thalès) : \(CE/CF = CB/CA\) ce qui nous donne ici : \({{$val12}\over{$val11}} = {{$val14}\over{$val13}}\). On calcule la réponse par proportionnalité.
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,10	    autofocus 
$() $val18</div>	
$()
!exit

