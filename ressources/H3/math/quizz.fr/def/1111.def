!set title=Question 1111 Volume d'un pavé droit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,volume
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 2,5,7;3,4,5;3,5,6;4,5,7
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
!readproc oef/draw.phtml 250,180 \
xrange -45,490	yrange -30,200	rect 0,0,300,100,black	polyline black,0,100,150,180,450,180,300,100	polyline black,300,0,450,80,450,180	dsegment 0,0,150,80,black	dsegment 150,80,150,180,black	dsegment 150,80,450,80,black	text black,-45,50,small,$(val9[1]) m	text black,120,-5,small,$(val9[2]) m	text black,60,70,small,$(val9[3]) m	 
tmp0=$ins_url
val10=$(tmp0)
val11=$[rint($(val9[1])*$(val9[2])*$(val9[3]))]
val12=<img src="$val10" alt=""><br>Quel est le volume en \(m^3\) de ce pavé droit &#63;
val13=\(m^3\)
val14=
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val14!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,13,14
embedcnt=1
