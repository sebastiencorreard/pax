!set title=Question 0313 Estimer la longueur d'un objet
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,length
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
val8=130 cm,13 m,130 m
tmp=!trim d'un rateau,1;d'un autocar,2
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val11=$(val8[$(val9[2])])
val12=$[rint($(val9[2]))]

!ifval $val12==1
val13=$[rint(2)]
!else
val13=$[rint(1)]
!endif
val13=$(val8[$val13])
val14=$(val8[3])
val15=$val13,$val14
val16=Choisis la longueur possible $(val9[1]) &#63; 
val17=
val18=Il faut faire attention aussi aux unités de mesure. Ne pas confondre les mètres et les centimètres.
replytype1=menu
replyoption1=shuffle default=$val13 weight=2 
replyname1=
replygood1=1;$val11,$val13,$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,10	    autofocus 
$() $val17</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val18!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,17,18
embedcnt=1
