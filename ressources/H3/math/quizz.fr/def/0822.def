!set title=Question 0822 Calcul réfléchi
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals,multiplication,methodical_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem -1,-1,-1,1

tmp1=!randitem 3,5

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint(abs($val8))]

!ifval $val8<0
val10=$[rint(4)]
!else
tmp0=!randitem -1,1

val10=$[rint($(tmp0)*4)]
!endif
val11=$[rint(abs($val10/2))]
val12=$[rint(abs($val10))]
tmp0=!randitem 2,3,4

val13=$[$(tmp0)+0.5]

!ifval $val10*$val8<0
val13=$[$val13]
!else
val13=$[-1*$val13]
!endif
val14=$[abs($val13)]
val15=$[2*$val13]
val16=$[abs($val15)]
val17=$val13 \times $val10 \times $val8
!if $val8<0 
val17=$val13 \times $val10 \times ($val8)
!endif
!if $val10<0 
val17=$val13 \times ($val10) \times $val8
!endif
val18=$[$val13*$val10*$val8]
val19=$[$val18]
val20=Calcule &#58; \($val17\) <br> Réponse &#58;
val21=
val22=On sait que \($val13\times2=$val15 \) puis en remarquant que \($val12=2 \times $val11 \) cela facilite les calculs.	<br> \($val17= - $val14 \times 2 \times $val11 \times $val9=-$val16 \times $val11 \times $val9=$val19\)
val23=\begin{enumerate}
val23=$val23	    \item	    $val20	    \dots $val21	  
val23=$val23 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val20  
!read oef/embed.phtml r1,10	    autofocus 
$() $val21</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val23 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val22!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val22</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,20,21,22,23
embedcnt=1
