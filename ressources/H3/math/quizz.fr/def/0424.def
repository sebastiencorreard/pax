!set title=Question 0424 Repérage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=coordinates,number_line
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(0)]
val9=$[$val8-0.15]
val10=$[$val8+1.15]
tmp0=!randitem 4,5,5

val11=$[rint($(tmp0))]
val12=$[1/$val11]
tmp0=!randint 1, ($val11-1)

val13=$[$val8+$(tmp0)*$val12]

!ifval ($val13==$val8+0.5)
tmp=!nonempty items -0.25,0.25

tmp0=!randitem $tmp
val13=$[ $val13+$(tmp0)]
!else
val13=$[$val13]
!endif
val14=$[rint(1+$val8)]
!readproc oef/draw.phtml 300,60 \
xrange $val9,$val10	yrange -3,3	linewidth 1.5	segment $val9,0,$val10,0,black	segment $val8,-1.5,$val8,1.5,black	segment $val8+1,-1.5,$val8+1,1.5,black	parallel $val8+$val12,-0.5,$val8+$val12,0.5,$val12,0,$val11-1,black	text black,$val8,-1.5,large,$val8	text black,$val8+1,-1.5,large,$val14	linewidth 2	arrow $val13,-2.8,$val13,-1,10,black	 
tmp0=$ins_url
val15=$(tmp0)
val16=<img src="$val15" alt="">
val17=$[$val13]
val18=<table><tr><td>$val16</td></tr><tr><td> Le nombre repéré par la flèche est </td></tr></table>
val19=
val20=Une graduation vaut $val12
val21=\begin{enumerate}
val21=$val21	    \item	    $val18	    \dots $val19	  
val21=$val21 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val18  
!read oef/embed.phtml r1,10	    autofocus 
$() $val19	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'><div class="feedback">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,18,19,20,21
embedcnt=1
