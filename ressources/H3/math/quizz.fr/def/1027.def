!set title=Question 1027 Equation carrée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,equations,squareroot
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
tmp0=!randint 3, 9

val9=$[rint($(tmp0))]
val10=$[rint($val8^2)]
val11=$[rint($val8^2-$val9)]
val12=$[-$val8]
val13=$[$val12]
val14=Quelle est la solution négative de l'équation \(x^2 - $val9 = $val11\) &#63; <br>Réponse : 
val15=
val16=Ici, on obtient \(x^2=$val10\), qui a pour solutions \($val8\) et \($val12\).
val17=\begin{enumerate}
val17=$val17\end{enumerate}
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

