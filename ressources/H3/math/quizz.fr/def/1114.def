!set title=Question 1114 Abscisse ou ordonnée d'un point
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,coordinates,plane
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle A,B,C

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
val11=$(val8[3])
tmp=!trim 2,3,4,1,1,2,;4,3,3,1,1,2,;4,3,2,1,1,2
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint($(val12[2]))]
val15=$[rint($(val12[3]))]
val16=$[rint($(val12[4]))]
val17=$[rint($(val12[5]))]
val18=$[rint($(val12[6]))]
val19=$[0.4]
val20=$[$val13]
val21=$[$val14+$val19]
val22=$[$val15+$val19]
val23=$[$val16]
val24=$[$val17-$val19]
val25=$[$val18]
val26=xrange -1,5.5	yrange -1,4.5	parallel 0,0,5,0,0,1,6,grey	parallel 0,0,0,4,1,0,6,grey	parallel -0.2,1,0.2,1,0,1,4,black	parallel 1,-0.2,1,0.2,1,0,5,black	arrow -1,0,5,0,15,black	arrow 0,-1,0,4,15,black	text black,-0.3,-0.1,medium,0	text black,-0.5,1.1,medium,1	text black,-0.5,2.1,medium,2	text black,-0.5,3.1,medium,3	text black,-0.5,4.1,medium,4	text black,0.9,-0.3,medium,1	text black,1.9,-0.3,medium,2	text black,2.9,-0.3,medium,3	text black,3.9,-0.3,medium,4	text black,4.9,-0.3,medium,5	
!readproc oef/draw.phtml 250,300 \
$val26	linewidth 2	fpoly white,$val13,$val14,$val15,$val16,$val17,$val18,$val13,$val14	polyline black,$val13,$val14,$val15,$val16,$val17,$val18,$val13,$val14	crosshairs black,$val13,$val14,$val15,$val16,$val17,$val18	text black,$val20,$val21,giant,$val9	text black,$val22,$val23,giant,$val10	text black,$val24,$val25,giant,$val11	 
tmp0=$ins_url
val27=$(tmp0)
val28=$val9,$val13,$val14,$val10,$val15,$val16,$val11,$val17,$val18
tmp0=!randitem 1,4,7

val29=$(tmp0)
tmp0=!randitem 1,2

val30=$[rint($(tmp0))]

!ifval $val30==1
val31=abscisse
!else
val31=ordonnée
!endif

!ifval $val30==1
val32=$[rint($(val28[$val29+1]))]
!else
val32=$[rint($(val28[$val29+2]))]
!endif
val33=<img src="$val27" alt=""> <br>Quel est l'$val31 du point $(val28[$val29]) &#63;
val34=
val35=Le point $(val28[$val29]) a pour coordonnées ($(val28[$val29+1])&#59; $(val28[$val29+2])) son $val31 est bien égale à $val32.
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val32]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val33  
!read oef/embed.phtml r1,10	    autofocus 
$() $val34	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
