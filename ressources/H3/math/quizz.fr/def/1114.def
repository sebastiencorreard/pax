 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val35</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,33,34,35
embedcnt=1
