!set title=Question 0315 Ecouter l'écriture décimale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=5
postvarcnt=7
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
val8=Ecris un nombre en chiffre dans lequel on entend "cent" et "mille". 
val9=
val10=
replytype1=numeric
replyoption1=defaut=0 
replyname1=
replygood1=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val8  
!read oef/embed.phtml r1,10	    autofocus 
$() $val9</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!text expand $val11 using 01

val12=$(tmp0)
tmp0=!words2items $val12

val12=$(tmp0)
tmp0=!words2items $val12

val13=$(tmp0)
tmp0=!itemcnt $val13

val14=$(tmp0)

!ifval $val14<3
val15=$[rint(0)]
!else
val15=$[rint($(val13[$val14-2]))]
!endif
!if $val15==0 

!ifval $val14<6
val15=$[rint(0)]
!else
val15=$[rint($(val13[$val14-5]))]
!endif
!endif

!ifval $val14<4
val16=$[rint(0)]
!else
val16=$[rint($(val13[$val14-3])$(val13[$val14-4])$(val13[$val14-5]))]
!endif

!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val10!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val10</div>
$()</div>
!endif

!exit

:test

!ifval $val15!=0
 condtest1=1
!else
 condtest1=0
!endif
condname1=Dans $val11 on entend "cent" ?

!ifval $val16!=0
 condtest2=1
!else
 condtest2=0
!endif
condname2=Dans $val11 on entend "mille" ?

!exit

:stat
vsavelist=6,8,9,10,11
embedcnt=1
