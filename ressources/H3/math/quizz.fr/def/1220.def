!set title=Question 1220 Coefficient directeur de la tangente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,derivative,tangent
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 1,2,3

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in x^3+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val10=!rawmath $(tmp0)
tmp0=!randitem -1,1,-1,1,2,-2

val11=$[rint($(tmp0))]
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[rint($(tmp0))]
val13=Coefficient directeur de la tangente au point d'abscisse \($val11\) de la courbe d'équation \(y = $val9 \)<br> Réponse &#58; 
val14=
val15=La dérivée est égale à \($val10\), il suffit de prendre sa valeur pour \(x=$val11\).
val16=\begin{enumerate}
val16=$val16	    \item	    $val13	    \dots $val14	  
val16=$val16 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val16 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val16 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val15!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val15</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,15,16
embedcnt=1
