!set title=Question 0522 Tiers quarts 1 bis
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,division,proportionality
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=4,120,200,240;3,150,60,90
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)

!ifval $(val8[1])=4
val9=\(\frac{3}{4}\)
!else
val9=\(\frac{2}{3}\)
!endif
tmp0=!item 2 to 4 of $val8

tmp=!nonempty items $(tmp0)

tmp1=!randitem $tmp
val10=$[rint($(tmp1))]

!ifval $(val8[1])=4
val11=$[rint(3*$val10)]
!else
val11=$[rint(2*$val10)]
!endif
val12=$[rint($val11/$(val8[1]))]
val13=Calcule le $val9 de $val10 &euro;.<br>
val14=&euro;

!ifval $(val8[1])=4
val15=3
!else
val15=2
!endif
val16=\($val15 \times $val10 \div $(val8[1])= $val12\) 
val17=\begin{enumerate}
val17=$val17	    \item	    $val13	    \dots $val14	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,16,17
embedcnt=1
