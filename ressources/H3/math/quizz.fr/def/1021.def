!set title=Question 1021 Théorème de Pythagore
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,proportionality,velocity
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 3,4,5

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]

!ifval $val8=3 
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val9=$[rint( $(tmp0) )]
!else
tmp=!nonempty items 2,4,5

tmp1=!randitem $tmp
val9=$[rint( $(tmp1))]
!endif
val10=$[rint($val8^2+$val9^2)]
val11=sqrt($val10)
val12=$val11
!readproc oef/draw.phtml 230,115 \
xrange -60,60	yrange -55,55	triangle -15,40,30,40,30,-37,black	segment 20,40,20,30,black	segment 20,30,30,30,black	text black,-20,45,medium,A	text black,35,45,medium,C	text black,35,-42,medium,B	text black,35,1,medium,$val9 cm	text black,5,55,medium,$val8 cm 
tmp0=$ins_url
val13=$(tmp0)
val13=<img src="$val13" alt="">
val14=<table><tr><td>$val13 </td><td> La valeur exacte de AB est : <br>AB = 
val15=\(cm\)</td></tr></table>
val16=Utiliser le théorème de Pythagore : \(AB=\sqrt{AC^2+BC^2}=\sqrt{$val9^2+$val8^2}=\sqrt{$val10}\)
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val16!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,16
embedcnt=1
