!set title=Question 0923 Calcul de l'aire d'une partie d'un rectangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,multiplication,area,rectangles,fraction
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 8,10,12,16,20

val8=$[rint($(tmp0))]
val9=$val8 cm
tmp0=!randint 3, min(9,$val8)

val10=$(tmp0)
val11=$val10 cm
val12=xrange -150,150	yrange -140,140	fpoly grey,-130,-110,-130,110,0,110,130,-110	rect -130,-110,130,110,black	segment -65,100,-55,120,black	segment 55,100,65,120,black	rect -130,-110,-110,-90,black	rect -130,110,-110,90,black	rect 130,110,110,90,black	segment 0,110,130,-110,black	text black,-140,130,large,A	text black,140,130,large,B	text black,140,-120,large,C	text black,-140,-120,large,D	text black,0,130,large,E	text black,-40,-110,large,$val9	arrow 30,-120,130,-120,10,black	arrow -50,-120,-130,-120,10,black	textup black,-149,-20,large,$val11	arrow -137,-30,-137,-110,10,black	arrow -137,30,-137,110,10,black	
!readproc oef/draw.phtml 300,280 \
$val12 
tmp0=$ins_url
val13=$(tmp0)
val13=<div class="wimscenter"><img src="$val13" alt=""></div>
val14=$val13 Quelle est l'aire de la surface grisée ?
val15=\( cm^2 \).
val16=$[$val10*$val8*3/4]
!readproc oef/draw.phtml 300,280 \
$val12	polyline red,-130,-110,0,110,0,-110	 
tmp0=$ins_url
val17=$(tmp0)
val18=Méthode : par découpage la partie grisée a pour aire les \(\frac{3}{4}\) de l'aire du rectangle. 
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,18
embedcnt=1
