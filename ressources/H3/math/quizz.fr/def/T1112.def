val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randint 5, 9

val9=$[rint($(tmp0)*10)]
tmp0=!randint 1, 5

val10=$[rint($(tmp0)*10)]
val11=$[1-$val10/100]
val12=$[$val9*$val11]
val13=$[$val12]
val14=Le prix d'un manteau est $val9 &euro;. Il baisse de $val10 %.<br>Quel est son nouveau prix  &#63;<br>Réponse :  
val15=&euro;
val16=$[rint($val9/10)]
val17=$[rint($val11*10)]
val18=Il faut multiplier le prix par le coefficient multiplicateur, qui est égal ici à \($val11\). <br>\($val9 \times $val11 = $val16 \times $val17 = $val12\).
val14=Un pantalon coute $val9 &euro;. Quel est son prix après une baisse de $val10 % &#63; 
val8=$[rint(6)]
val19=\begin{enumerate}
val19=$val19	    \item	    $val14	    \dots $val15	  
val19=$val19 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


