!set title=Question 0626 Taille
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving,masse,length,time
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp=!trim une fourmi mesure,1,3 mm,3 dm,3 m	une voiture pèse,2,1500 g,1500 kg,1500 tonnes	une voiture pèse,3,1.5 g,1.5 kg,1.5 tonnes	un éléphant pèse,3,5 g,5 kg,5 tonnes	un éléphant pèse,2,5000 g,5000 kg,5000 tonnes	une guitare a une longueur de,2,100 mm,100 cm,100 m	une guitare a une longueur de,2,1 cm,1 m,1 km	un car a une longueur de,2,11 cm, 11 m, 11 km	une baleine bleue mesure,2,1.25 m,25 hm, 25 km	une baleine bleue pèse,3,130 g,130 kg,130 tonnes	une raquette de tennis a une longueur de,2,6.85 cm,6.85 dm,6.85 m	une raquette de tennis a une longueur de,1,68.5 cm,68.5 dm,68.5 m	un pigeon pèse,2,300 mg,300 g,300 kg	un marathon dure,3,2 s,2 min,2 h	un film au cinéma dure,2,120 s,120 min,120 h	une brique pèse,2,3.5 g,3.5 kg,3.5 tonnes	un adulte mesure,1,175 cm,175 dm,175 m	un adulte mesure,2,1.8 dm,1.8 m,1.8 dam	
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val10=$[rint($(tmp1))]
val11=$[$(val9[$val10;2])]
val12=$(val9[$val10;3..-1])
val13=Clique sur la bonne réponse &#58;<br> $(val9[$val10;1])
val14=
val15=
replytype1=mark
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
