!set title=Question 0604 Prix
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=proportionality,mental_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp=!nonempty items 4,5,6

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
!if $val9==4 
tmp=!nonempty items 3,5

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
!endif
!if $val9==5 
tmp=!nonempty items 4,6

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
!endif
!if $val9==6 
tmp=!nonempty items 4,5

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
!endif
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp0=!randint 2, 6

val12=$[rint($(tmp0))]
val13=$[rint($val9*$val12)]
val14=$[rint($val10*$val12)]

!ifval ($val11==1)
val15=$[rint( $val14)]
!else
val15=$[rint($val13 )]
!endif
val16=\($val9\) cahiers coûtent \($val10\)&euro;.<br>

!ifval ($val11==1)
val17= $val16\($val13\) cahiers coûtent 
!else
val17=$val16
!endif

!ifval ($val11==1)
val18= &euro;.
!else
val18= cahiers coûtent \($val14\)&euro;.
!endif
val19=
val20=\begin{enumerate}
val20=$val20	    \item	    $val17	    \dots $val18	  
val20=$val20 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val17  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val18	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val19</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,17,18,19,20
embedcnt=1
