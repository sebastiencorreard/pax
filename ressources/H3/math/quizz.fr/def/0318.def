!set title=Question 0318 Soustraction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 3, 9

val8=$[rint($(tmp0))]
tmp0=!randint 3, 9

val9=$[rint($(tmp0))]
tmp0=!randint 3, 9

val10=$[rint($(tmp0))]
val11=$[rint($val8*100+$val9*10+$val10)]
val12=$[rint($val8)]
tmp0=!randint 2, $val9

val13=$[rint($(tmp0)-1)]
tmp0=!randint 2, $val10

val14=$[rint($(tmp0)-1)]
val15=$[rint($val12*100+$val13*10+$val14)]
val16=$[rint($val11-$val15)]
val17=\($val11-$val15={}\)
val18=
val19=
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val17  
!read oef/embed.phtml r1,10	    autofocus 
$() $val18</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val19!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val19</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,17,18,19
embedcnt=1
