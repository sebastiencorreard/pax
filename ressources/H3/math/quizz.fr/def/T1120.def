!set title=Question T1120 Factorisation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,literal_calculation,factorization
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 4, 7

val11=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

val13=$[rint($(tmp0))]
tmp0=!randint 6, 10

tmp=!nonempty items 1,1,-1

tmp1=!randitem $tmp
val14=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in ($val9*x+$val10)*($val11*x+$val12)+($val9*x+$val10)*($val13*x+$val14)
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val9*x+$val10
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val11*x+$val12
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val13*x+$val14
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val11*x+$val12)+($val13*x+$val14)
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in factor(($val9*x+$val10)*(($val11+$val13)*x+($val12+$val14)))
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
val21=Factoriser l'expression \($val15\) en termes du premier degré : 
val22=
val23=!rawmath $val20
val24=\($val15\)<br>\({}=($val16)\)\(($val17+$val18)\)<br>\({}=($val16)\)\(($val19)\).
val8=$[rint(10)]
val25=\begin{enumerate}
val25=$val25 \end{enumerate}
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val23
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val22	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val25 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val24!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val24</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,21,22,24,25
embedcnt=1
