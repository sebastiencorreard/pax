!set title=Question 0304 Patron du cube
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=cube
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
!readproc oef/draw.phtml 100,100 \
xrange -5,85	yrange -5,85	rect 0,20,20,40,black	rect 20,20,40,40,black	rect 40,20,60,40,black	rect 60,20,80,40,black	rect 40,40,60,60,black	rect 40,0,60,20,black	 
tmp0=$ins_url
val8=$(tmp0)	
!readproc oef/draw.phtml 100,100 \
xrange -5,85	yrange -5,85	rect 0,0,80,40,black	parallel 0,0,80,0,0,20,3,black	parallel 0,0,0,40,20,0,5,black	 
tmp0=$ins_url
val9=$(tmp0)	
!readproc oef/draw.phtml 100,100 \
xrange -5,85	yrange -5,85	rect 0,20,60,40,black	rect 20,0,40,60,black	 
tmp0=$ins_url
val10=$(tmp0)	
tmp0=!shuffle 1,2,3

val11=$(tmp0)
val12=$val8,$val9,$val10
tmp0=!positionof item 1 in $val11

val13=$[rint($(tmp0))]
val14=$[rint((1+$val11)%3)]
val15=Quel est le patron du cube &#63;<table><tr><td>Figure 1 <br> <img src="$(val12[$(val11[1])])" alt=""></td><td>Figure 2 <br> <img src="$(val12[$(val11[2])])" alt=""></td><td>Figure 3 <br> <img src="$(val12[$(val11[3])])" alt=""></td></tr></table> 
val16=
val17=
replytype1=menu
replyoption1=default=$val14 
replyname1=
replygood1=$val13;Figure 1,Figure 2, Figure 3
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,10	    autofocus 
$() $val16</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val17!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,15,16,17
embedcnt=1
