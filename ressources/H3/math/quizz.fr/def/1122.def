val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 0,1,3,1,4,-2,2,2,3;0,1,3,1,4,-2,2,2,2;0,2,3,1,4,-2,2,2,3;0,2,3,1,4,-2,2,2,1;0,2,3,1,5,-2,2,2,3;0,1,3,1,4,-2,2,2,2;0,2,3,1,5,-2,2,2,1;0,1,3,1,4,-2,2,2,3
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=$[rint($(val8[3]))]
val12=$[rint($(val8[4]))]
val13=$[rint($(val8[5]))]
val14=$[rint($(val8[6]))]
val15=$[rint($(val8[7]))]
val16=$[rint($(val8[8]))]
val17=$[rint($(val8[9]))]
tmp0=$val16-$val13


!ifval $(tmp0)=$val17
val17=$[rint(1)]
!else
val17=$[rint($val17)]
!endif
val18=!rawmath $val17(x-$val15)+$val16
tmp=!translate ";': to $     $ in ((x-($val12))*(x-($val15))/(($val9-($val12))*($val9-($val15))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ((x-($val9))*(x-($val15))/(($val12-($val9))*($val12-($val15))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ((x-($val9))*(x-($val12))/(($val15-($val9))*($val15-($val12))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val19,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val22=!rawmath $(tmp1)
evaltmp=$val22

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val22=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val20,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val23=!rawmath $(tmp1)
evaltmp=$val23

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val21,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val24=!rawmath $(tmp1)
evaltmp=$val24

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
val24=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val19*($val10+(x-$val9)*($val11-$val22*$val10)) + ($val20)*($val13+(x-$val12)*($val14-$val23*$val13)) +($val21)*($val16+(x-$val15)*($val17-$val24*$val16))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=!rawmath $(tmp0)
tmp=!replace internal .. by , in $val25=$val10+1,x=0.1..0.9 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val26=$[$(tmp0)]
val27=$[$val10+1]
val28=xrange -0.8,3.2	yrange -0.8,5.2	linewidth 1	parallel 0,0,3,0,0,1,6,grey	parallel 0,0,0,5,1,0,6,grey	linewidth 2	plot black,$val25	plot black,$val18	fpoly white,-0.8,-0.8,-0.8,5.2,-0.1,5.2,-0.1,-0.8	linewidth 1	parallel -0.1,1,0.1,1,0,1,4,black	parallel 1,-0.1,1,0.1,1,0,2,black	arrow -1,0,3,0,15,black	arrow 0,-1,0,5,15,black	text black,-0.3,-0.1,medium,0	text black,-0.3,1.1,medium,1	text black,-0.3,2.1,medium,2	text black,-0.3,3.1,medium,3	text black,-0.3,4.1,medium,4	text black,1,-0.3,medium,1	text black,2,-0.3,medium,2	text black,3,-0.3,medium,3	text black,$val26,$val27,medium, (Cf)	
val29=À partir du graphique ci-dessous qui représente une fonction f et une tangente à cette représentation &#58;
!readproc oef/draw.phtml 250,300 \
$val28	 
