!set title=Question T1111 Opération en mots
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation 
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randint 2, 9

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

val10=$[rint($(tmp0))]
tmp0=!shuffle double,triple

val11=$(tmp0)
tmp0=!shuffle somme,différence

val12=$(tmp0)

!ifval ($val9>0)
val13= $val9
!else
val13=($val9)
!endif

!ifval ($(val11[1]) issametext double)
val14= 2*$val13
!else
val14=3*$val13
!endif

!ifval ($(val12[1]) issametext somme)
val15= $val14+$val10
!else
val15=$val14-$val10
!endif
val16=La $(val12[1]) du $(val11[1]) de \($val9\) et de l'inverse de \(\frac{1}{$val10}\) : 
val17=
val18=$[rint($val15)]
val19=Il faut effectuer l'opération \( $val15 \) pour obtenir la $(val12[1]) du $(val11[1]) de \($val9\) et de l'inverse de \(\frac{1}{$val10}\). 
val8=$[rint(6)]
val20=\begin{enumerate}
val20=$val20	    \item	    $val16	    \dots $val17	  
val20=$val20 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val17	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val19</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,16,17,19,20
embedcnt=1
