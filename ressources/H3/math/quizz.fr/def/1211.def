!set title=Question 1211 Entier le plus proche
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim e,Pi,sqrt(2);e,\pi,\sqrt{2}
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 3

val9=$(tmp0)
val10=$[$(val8[1;$(val9[1])])]
val11=$[rint($val10*100)/100]
val12=$(val8[2;$(val9[1])])
val13=$[$(val8[1;$(val9[2])])]
val14=$(val8[2;$(val9[2])])
val15=$[rint($val13*100)/100]
tmp0=!randitem +,-

val16=$(tmp0)

!ifval $val16 issametext + 
val17=$[$val10 + $val13]
!else
val17=$[$val10-$val13]
!endif
val18=$[rint($val17) ]
val19=L'entier le plus proche de \($val12 $val16 $val14\). 
val20=
val21=Rappel &#58; \($val12 \simeq $val11 \) à \(0.01\) près <br>et \($val14 \simeq $val15 \) à \(0.01\) près 
val22=\begin{enumerate}
val22=$val22	    \item	    $val19	    \dots $val20	  
val22=$val22 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,10	    autofocus 
$() $val20	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val22 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,19,20,21,22
embedcnt=1
