!set title=Question 1128 Probabilité et arbre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,probability,events
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 9

val8=$(tmp0)
val9=$[$(val8[1])/10]
val10=$[$(val8[2])/10]
val11=$[$(val8[3])/10]
val12=$[1-$val11]
val13=$[1-$val9]
val14=$[1-$val10]
val15=$[$val12*$val9]
val16=$[$val11*$val14]
val17=\(P(\bar{A} \cap \bar{B})={}\),$val16,\(P_\bar{A} (\bar{B})=1-$val10\),\(P(\bar{A} \cap \bar{B})=$val11\times$val14\);	\(P(A \cap B)={}\),$val15,\(P_{A} =1-$val11\),\(P({A} \cap {B})=$val12 \times $val9\)
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
val18=xrange 0,256	yrange 0,160	copy 0,160,-1,-1,-1,-1,1128.png	text black,150,150,giant,$val9	text black,150,70,giant,$val10	text black,40,58,giant,$val11
!readproc oef/draw.phtml 256,160 \
$val18 
tmp0=$ins_url
val19=$(tmp0)
val20=$[$(val17[2])]
val21=<img src="$val19" alt="arbre"> <br>$(val17[1])
val22=
val23=On a $(val17[3]), donc $(val17[4])
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
!read oef/embed.phtml r1,10	    autofocus 
$() $val22	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val23!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val23</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,21,22,23
embedcnt=1
