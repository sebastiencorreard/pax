!set title=Question 0310 Problème & Mutiplication
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving,multiplication
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(15)]
tmp=!trim L'ours,l'ours,30;Le gorille,le gorille,45;L'éléphant,l'éléphant,60
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$[rint($(val9[3])/$val8)]
val11=$[rint($val8*$val10)]
val12=Le tigre vit $val8 ans. $(val9[1]) vit $val10 fois plus longtemps. <STRONG>Combien de temps vit $(val9[2]) &#63;</STRONG>
val13=ans
val14=A partir de l'énoncé, le calcul à faire est \($val8 \times $val10\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val14!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,13,14
embedcnt=1
