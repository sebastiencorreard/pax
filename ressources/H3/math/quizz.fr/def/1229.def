!set title=Question 1229 Probabilité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,probability,events,independent_events
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem le même résultat,le même résultat,le même résultat,face,pile

val8=$(tmp0)
tmp0=!randitem 2,3,4

val9=$[rint($(tmp0))]
!readproc slib/numeration/ecriturelettre $val9 
tmp0=$slib_out
val10=$(tmp0)
val11=On lance $val9 fois une pièce de monnaie équilibrée.<br>Quelle est la probabilité d'avoir $val10 fois $val8 &#63;<br>Réponse &#58;
val12=

!ifval $val8 issametext le même résultat
tmp=!translate ";': to $     $ in 2*(1/2)^$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
!else
tmp=!translate ";': to $     $ in (1/2)^$val9

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp1)
val13=!exec pari print($t_)
!endif

!ifval $val8 issametext le même résultat
val14=Cela revient à l'événement avoir $val10 pile ou $val10 face.
!else
val14=\(\left(\frac{1}{2}\right)^$val9\)
!endif
val15=\begin{enumerate}
val15=$val15	    \item	    $val11	    \dots $val12	  
val15=$val15 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val15 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val11  
!read oef/embed.phtml r1,10	    autofocus 
$() $val12	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val15 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val14!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,11,12,14,15
embedcnt=1
