!set title=Question 0614 Changement d'heure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving,clock,addition
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 7, 20

val9=$[rint($(tmp0))]
tmp0=!randint 4, 9

val10=$[rint(5*$(tmp0))]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]

!ifval ($val11==1)
val12= enlève
!else
val12=ajoute
!endif

!ifval ($val11==1)
tmp0=!randint 1, ($val10/5-1)

val13=$[rint( 5*$(tmp0))]
!else
tmp1=!randint (13-$val10/5), 11

val13=$[rint(5*$(tmp1))]
!endif

!ifval ($val11==1)
val14=$[rint( $val9-1)]
!else
val14=$[rint($val9+1)]
!endif

!ifval ($val11==1)
val15=$[rint( 60+$val13-$val10)]
!else
val15=$[rint($val10+$val13-60)]
!endif

!ifval ($val13==5)
val13= 05
!else
val13=$val13
!endif
val16=Si on $val12 \($val10\) min à \($val9\, \text{h} \,$val13 \,min\). Quelle heure obtient-on ?<br>
val17=\(\text{h}\)
val18=\(min\)
val8=$[rint(4)]
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val14]
replytype2=numeric
replyoption2=comma default=0 
replyname2=
replygood2=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val17	 
!read oef/embed.phtml r2,$val8 
$() $val18	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and (\feedback!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$m_feedback</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,16,17,18
embedcnt=2
