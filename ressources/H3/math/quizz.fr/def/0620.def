!set title=Question 0620 Longueur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=geometry,length
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 3,4,5

val9=$[rint($(tmp0))]
tmp0=!randint 1, ($val9-1)

val10=$[rint($val9+$(tmp0))]
val11=$[rint(2*$val9+1.2)]
val12=$[rint(floor($val11))]
!readproc oef/draw.phtml 300,100 \
xrange -0.2,$val11	yrange -0.2,3.2	parallel 0,0,0,3,1,0,$val12,grey	parallel 0,0,$val12,0,0,1,3,grey	linewidth 3	segment 1,3,1+$val9,3,blue	text blue,2.5,2.8,large,1	segment 1,1,1+$val10,1,black	fcircle 1,1,8,black	fcircle 1+$val10,1,8,black	text black,1,1.7,large,A	text black,1+$val10,1.7,large,B	 
tmp0=$ins_url
val13=$(tmp0)
val14=<img src="$val13" alt="">
t_=!rawmath \x
val15=!exec pari print($t_)
val16=<table><tr><td>$val14</td></tr><tr><td> Quelle est la longueur du segment [AB] &#63; </td></tr></table> 
val17=unité(s)
t_=!rawmath $val10/$val9
val15=!exec pari print($t_)
val18=Un carreau a une longueur égale à 1/$val9 d'unité. 
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val17	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,16,17,18
embedcnt=1
