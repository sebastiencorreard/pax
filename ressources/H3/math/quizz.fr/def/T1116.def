tmp=!trim -4,2,-10,-3,-2,0,4,3,0,6,-2,-1	-5,3,-6,-3,-1,0,4,3,0,6,-1,-7	-5,3,-10,-3,-3,0,3,3,0,6,-3,-7	-4,3,-10,-3,-1,0,4,3,0,6,-1,-4	-5,3,-10,-3,-3,0,2,3,0,6,-3,-1	-5,4,-10,-3,-3,0,2,3,0,6,-3,-3	
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

