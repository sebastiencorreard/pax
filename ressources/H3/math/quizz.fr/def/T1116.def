val23=!rawmath (((x-($val14))*(x-($val17))*(x-($val20))/(($val11-($val14))*($val11-($val17))*($val11-($val20)))))^2
val24=!rawmath (((x-($val11))*(x-($val17))*(x-($val20))/(($val14-($val11))*($val14-($val17))*($val14-($val20)))))^2
val25=!rawmath (((x-($val11))*(x-($val14))*(x-($val20))/(($val17-($val11))*($val17-($val14))*($val17-($val20)))))^2
val26=!rawmath (((x-($val11))*(x-($val14))*(x-($val17))/(($val20-($val11))*($val20-($val14))*($val20-($val17)))))^2
tmp=!translate ;";': to $     $ in $val23,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val27=!rawmath ($(tmp0))
