!set title=Question 1222 Extremum sur un intervalle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,functions,affine_function,extremum
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem minimale,maximale

val8=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem -1,1

tmp2=!randint 2, 6

val9=!rawmath $(tmp0)+$(tmp1)*$(tmp2)*x
t_=!replace internal \( by ( in $val9
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
tmp0=!randint 3, 5

val12=$[rint($val11+$(tmp0))]

!ifval $val8 issametext minimale 
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp1=($evaltmp)
val13=$[rint( min($(tmp0),$(tmp1)))]
!else
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp2=($evaltmp)
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp3=($evaltmp)
val13=$[rint(max($(tmp2),$(tmp3)))]
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp1=($evaltmp)

!ifval $(tmp0)<$(tmp1)
val14=croissante
!else
val14=décroissante
!endif
!if $val14 issametext croissante 

!ifval $val8 issametext minimale 
val15=$[rint( $val11)]
!else
val15=$[rint($val12)]
!endif
!endif
!if $val14 issametext décroissante 

!ifval $val8 issametext minimale 
val15=$[rint( $val12)]
!else
val15=$[rint($val11)]
!endif
!endif
val16=Valeur $val8 de \($val10\) lorsque \(x \in [ $val11; $val12 ]\).<br> Réponse &#58;
val17=
val18=La fonction est $val14. On cherche la valeur <b>$val8 </b>, c'est donc l'image de $val15.
val19=\begin{enumerate}
val19=$val19	    \item	    $val16	    \dots $val17	  
val19=$val19 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,10	    autofocus 
$() $val17	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,17,18,19
embedcnt=1
