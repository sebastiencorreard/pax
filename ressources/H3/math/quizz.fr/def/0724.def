!set title=Question 0724 Mesurer un angle avec un rapporteur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=angles
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 11, 13

val9=$[rint($(tmp0)*10)]
val10=$[rint(180-$val9+10)]
val11=$[rint($val10-10)]
val12=linewidth 3	segment 6,0,7,0,black	linewidth 1
!for val13 =1 to 19 
val14=$[rint($val13*10)]
!if ($val14=100) or ($val14=190) 
val12=$val12	    linewidth 3
!endif
val12=$val12	  rotation $val14	  segment 6,0,7,0,black
!if ($val14=100) or ($val14=190) 
val12=$val12	    linewidth 1
!endif
!next
val15=rotation 10	polyline black,7,0,8,0,8,-1,-8,-1,-8,0,-7,0	arc 0,0,14,14,10,190,black	arc 0,0,3,3,$val10,180,black	text black,-1,2.5,giant,?	segment 6,0,7,0,black	text black,-0.5,6,medium,90°	text black,5,0.5,medium,0°	text black,-5.5,0.5,medium,180°	halfline 0,0,-10,0,black	$val12	killrotation	rotation $val10	halfline 0,0,10,0,black	killrotation	
!readproc oef/draw.phtml 300,225 \
xrange -10,10	yrange -5,10	$val15	 
tmp0=$ins_url
val16=$(tmp0)
val17=<img src="$val16" alt="image">
val18=$[$val9]
val19=<div class="wimscenter">$val17</div> Donne la mesure de l'angle. <br> &#63;\({}={}\)
val20=°
val21=Une graduation vaut 10°. L'angle va de la graduation 180° à la graduation $val11 °. L'angle mesure donc 180°-$val11 °=$val9 ° 
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val20	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,19,20,21
embedcnt=1
