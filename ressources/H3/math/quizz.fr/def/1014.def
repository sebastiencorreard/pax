!set title=Question 1014 Proportionnalité dans les formules
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,proportionality
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim Le volume d'un cube est proportionnel à la longueur de son arête,2,V=a^3,2e	Le volume d'un prisme est proportionnel à sa hauteur,1,V=base \times hauteur,1er	La longueur d'un cercle est proportionnelle à son rayon,1,L=2\pi \times rayon ,1er	L'aire d'un cercle est proportionnelle à son rayon,2,A=\pi R^2,2e	L'aire d'un carré est proportionnelle à la longueur de son côté,2,A=c^2,2e	Le périmètre d'un carré est proportionnel à la longueur de son côté,1,P=4 \times c,1er
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$(val9[1])
val11=$[rint($(val9[2]))]

!ifval $(val9[2])=1
val12=FAUX
!else
val12=VRAI
!endif
val13=
val14="\( A \)" est proportionnel à "\(b \)" si on a une formule du type "\(A=k times b\)" où \(k \) ne dépend pas de \(b \).	<br>Si on a une formule du type "\(A=k \times b^2\)", \(A \) n'est pas proportionnel à \(b \).	<br>Ici, on a \($(val9[3])\). On est donc dans le $(val9[4]) cas...
val15=$val12
val16=\begin{enumerate}
val16=$val16	    \item	    $val10	    \begin{radio}	    \item VRAI	    \item FAUX	    \end{radio}
val16=$val16\end{enumerate}
replytype1=menu
replyoption1=default=$(val15[1]) 
replyname1=
replygood1=$val11;VRAI,FAUX
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val16 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val10  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val16 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val14!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,13,14,16
embedcnt=1
