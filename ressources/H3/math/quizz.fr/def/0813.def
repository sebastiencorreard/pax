!set title=Question 0813 Aire d'un triangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,2_shape,triangles,altitude,area
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 5,6,7,8,9,10

val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=$[rint(2/3*$val10)]
val12=$[rint(sqrt($val9^2+$val11^2))]
val13=xrange 0,120	yrange 0,90	linewidth 2	ABCAH	polygon black,10,10,100,10,67.8114,66.33,10,10,77.8462,48.7692	text black,4,8,large,A	text black,102,8,large,B	text black,82,55,large,H	text black,67,75,large,C	arrow 45,5,10,5,10,black	arrow 70,5,100,5,10,black	text black,47,8,large,$val12 cm	arrow 93.7782,49.2959,80.5068,72.5209,10,black	arrow 103.1632,32.8722,113.3704,16.0095,10,black	text black,90,48,large,$val10 cm	text black,43,29,large,AH= $val9 cm	polygon black,77.8462,48.7692,74.8942,53.9351,67.6369,49.788,70.5888,44.6222,77.8462,48.7692	
!readproc oef/draw.phtml 240,180 \
$val13 
tmp0=$ins_url
val14=$(tmp0)
val14=<div class="wimscenter"><img src="$val14" alt=""></div>
val15=$val14 Calcule l'aire du triangle \(ABC\)<br> Réponse &#58; 
val16=\( cm^2 \).
val17=$[$val9*$val10/2]
!readproc oef/draw.phtml 300,280 \
$val13	polyline red,-130,-110,0,110,0,-110	 
tmp0=$ins_url
val18=$(tmp0)
val19=L'aire est égale à \(\frac{CB \times AH}{2}\) d'après la formule \(base \times hauteur \div 2\). 
val20=\begin{enumerate}
val20=$val20	    \item	    $val15	    \dots $val16	  
val20=$val20 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

