!set title=Question 1215 Coordonnées et vecteurs colinéaires
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation, vectors,coordinates
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,5,7,6,9

val8=$(tmp0)
val9=$[$(val8[1])]
val10=$[$(val8[2])]
val11=$[$(val8[3])/10]
val12=$[$val11*$val9]
val13=$[$val11*$val10]
tmp0=!randitem x,y

val14=$(tmp0)

!ifval $val14 issametext x 
val15=$[ $val12 ]
!else
val15=$[ $val13]
!endif
tmp=!trim $val9;$val10
val16=!translate internal $	\
$ to ;; in $tmp

!ifval $val14 issametext x 
tmp=!trim  x;$val13 
val17=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim $val12;y
val17=!translate internal $	\
$ to ;; in $tmp
!endif

!ifval $val14 issametext x 
val18= \($val13= $val11 \times $val10\)
!else
val18=\($val12= $val11 \times $val9\)
!endif

!ifval $val14 issametext x 
val19= \(x= $val11 \times $val9\)
!else
val19=\(y= $val11 \times $val10\)
!endif
val20=\(\overrightarrow{u}\)\([$val16]\) et \(\overrightarrow{v}\)\([$val17]\) <br> sont colinéaires si &#58; \($val14 =\) 
val21=
val22=On observe que $val18, <br>donc $val19. 
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val20  
!read oef/embed.phtml r1,10	    autofocus 
$() $val21	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val22!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val22</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,20,21,22
embedcnt=1
