!set title=Question 0819 Abscisse ou ordonnée d'un point
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,coordinates,plane,fraction
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 4,5

val8=$[rint($(tmp0))]
val9=$[1/$val8]
val10=$[-2*$val9]
tmp0=!randitem A,B,C

val11=$(tmp0)
tmp0=!randitem ord,abs

val12=$(tmp0)

!ifval $val12 issametext abs 
val13=$[-1/$val8]
!else
tmp0=!randint 1, $val8-1

val13=$[$(tmp0)/$val8]
!endif

!ifval $val12 issametext ord 
val14=$[-1/$val8]
!else
tmp0=!randint 1, $val8-1

val14=$[$(tmp0)/$val8]
!endif
val15=$[0.15]
val16=$[$val13-$val15]
val17=$[$val14+$val15]
val18=xrange -0.5,1.3	yrange -0.5,1.3	parallel -0.5,$val10,2,$val10,0,$val9,10,grey	parallel $val10,-0.8,$val10,2,$val9,0,10,grey	linewidth 2	segment -0.05,1,0.05,1,black	segment 1,-0.05,1,0.05,black	linewidth 1	arrow -1,0,1.3,0,10,black	arrow 0,-1,0,1.3,10,black	text black,-0.1,-0.05,medium,0	text black,-0.15,1.05,medium,1	text black,0.95,-0.1,medium,1	
!readproc oef/draw.phtml 180,180 \
$val18	linewidth 2	crosshairs black,$val13,$val14	text black,$val16,$val17,giant,$val11	 
tmp0=$ins_url
val19=$(tmp0)
tmp0=!randitem 1,2

val20=$[rint($(tmp0))]

!ifval $val20==1
val21=abscisse
!else
val21=ordonnée
!endif

!ifval $val20==1
val22=$[$val13]
!else
val22=$[$val14]
!endif
val23=$[$val22]
val24=<img src="$val19" alt=""> <br>Quelle est l'$val21 du point $val11 &#63;
val25=
val26=Attention, il y a $val8 graduations grises entre zéro et un. Chaque graduation représente donc $val9.<br> Le point $val11 a pour coordonnées \(\left($val13; $val14 \right)\) son $val21 est bien égale à $val23.
val27=\begin{enumerate}
val27=$val27	    \item	    $val24	    \dots $val25	  
val27=$val27 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val22]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val27 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val24  
!read oef/embed.phtml r1,10	    autofocus 
$() $val25</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val27 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val26!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val26</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,24,25,26,27
embedcnt=1
