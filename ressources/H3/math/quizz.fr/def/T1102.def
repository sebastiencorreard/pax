!set title=Question T1102 Somme d'un entier et d'une fraction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,addition,subtraction,integers,fraction
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
tmp0=!randitem 3,4,6,7

val10=$[rint($(tmp0))]
tmp0=!randitem +,-

val11=$(tmp0)

!ifval $val11 issamecase +
tmp=!translate ";': to $     $ in $val9+1/$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val12=!exec pari print($t_)
!else
tmp=!translate ";': to $     $ in $val9-1/$val10

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp1)
val12=!exec pari print($t_)
!endif
t_=!rawmath $val12
val13=!exec pari print($t_)

!ifval $val11 issamecase +
val14=\($val9 + \frac{1}{$val10}={}\)
!else
val14=\($val9 - \frac{1}{$val10}={}\)
!endif
val15=
val16=$[rint($val9 * $val10)]
val17=Rappel : \($val9=\frac{$val9 \times $val10}{$val10}\) donc $val14 \(\frac{$val16 $val11 1}{$val10}={}\)	\($val12 \).
val8=$[rint(6)]
val18=\begin{enumerate}
val18=$val18	    \item	    $val14	    \dots $val15	  
val18=$val18 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,17,18
embedcnt=1
