!set title=Question 0305 Problème
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 1,2,3,4

val8=$[rint($(tmp0))]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval $val8>1
val10=voitures
!else
val10=voiture
!endif

!ifval $val9>1
val11=motos
!else
val11=motos
!endif
val12=Dans un garage, il y a $val8 $val10 et $val9 $val11 . Combien comptes-tu de roues &#63; 
val13=
val14=$[rint($val8*4+$val9*2)]
val15=Une voiture a quatre roues et une moto deux. La réponse est donc \(4\times$val8+2\times$val9\)
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val15!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val15</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,13,15
embedcnt=1
