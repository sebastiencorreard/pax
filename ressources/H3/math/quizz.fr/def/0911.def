!set title=Question 0911 Autour de l'aire d'un carré 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,area,squareroot
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 10,15,2,5,6

val8=$[rint($(tmp0))]
val9=sqrt($val8)
val10=L'aire d'un carré est égale à \($val8\)\(cm^2\). Quelle est la valeur exacte de la longueur du côté du carré ?
val11=\(cm\).
val12=Rappel : l'aire d'un carré s'obtient en élevant au carré la longueur des côtés. Il faut donc	prendre la racine carrée de l'aire pour avoir la longueur des côtés. Ici \(\sqrt{$val8}\)
val13=\begin{enumerate}
val13=$val13 \end{enumerate}
replytype1=formal
replyoption1=comma default=0 
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val10  
!read oef/embed.phtml r1,10	    autofocus 
$() $val11</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val12!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val12</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,11,12,13
embedcnt=1
