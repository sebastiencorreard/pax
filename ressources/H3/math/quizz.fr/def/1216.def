!set title=Question 1216 Lecture de l'équation réduite 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,coordinates,lines,affine_function,line_equation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 1,2,2

val8=$[1/$(tmp0)*(-1)]

!ifval $val8=-0.5 
tmp0=!randitem 1,2

val9=$[rint( $(tmp0))]
!endif

!ifval $val8=-1 
tmp0=!randitem 3,2

val9=$[rint( $(tmp0))]
!endif
val10=!rawmath $val8*x+$val9
val11=$[rint(-$val9/$val8)]
val12=crosshairs black,0,$val9,$val11,0
!if $val8=-0.5 
val13=$[rint($val8*(-2)+$val9)]
val14=$[rint($val8*(2)+$val9)]
val15=linewidth 2	crosshairsize 5	crosshairs blue,-2,$val13,2,$val14
!endif
!if $val8=-1 
val16=$[rint($val8*(-1)+$val9)]
val17=$[rint($val8*(1)+$val9)]
val14=$[rint($val8*(2)+$val9)]
val15=linewidth 2	crosshairsize 5	crosshairs blue,-1,$val16,1,$val17,2,$val14
!endif
val18=$[0.3]
val19=$[0.5+$val18]
val20=$[$val8*$val19+$val9+$val18]
val21=text black,$val19,$val20,giant, (d)
val22=xrange -3,5.2	yrange -1,3.5	linewidth 2	parallel -3,-1,5.2,-1,0,1,8,grey	parallel -3,-1,-3,3.5,1,0,8,grey	linewidth 1	parallel -3,-1,5.2,-1,0,0.2,40,grey	parallel -3,-1,-3,3.5,0.2,0,45,grey	linewidth 2	$val21	plot black,$val10	linewidth 1	parallel -0.1,1,0.1,1,0,1,4,black	parallel -2,-0.1,-2,0.1,1,0,8,black	segment -3,0,5.2,0,black	segment 0,-1,0,3.5,black	text black,-0.3,-0.1,medium,0	text black,-0.3,1.1,medium,1	text black,-0.3,2.1,medium,2	text black,-0.3,3.1,medium,3	text black,-0.3,4.1,medium,4	text black,1,-0.3,medium,1	text black,2,-0.3,medium,2	text black,3,-0.3,medium,3	text black,4,-0.3,medium,4	text black,5,-0.3,medium,5	text black,-1,-0.3,medium,-1	text black,-2,-0.3,medium,-2	
!readproc oef/draw.phtml 500,300 \
$val22	$val15	$val12	 
tmp0=$ins_url
val23=$(tmp0)
!readproc oef/draw.phtml 300,300 \
$val22	linewidth 2	crosshairsize 6	crosshairs blue,0,$val9	crosshairs red,$val11,0	 
tmp0=$ins_url
val24=$(tmp0)
val25=$[$val8]
val26=$[$val9]
val27=<img src="$val23" alt="représentation graphique"> <br> Equation réduite de la droite (d).<br>\(y={}\)
val28=\(x +{}\)
val29=<div class="wims_instruction">Complétez par des nombres</div>
val30=<img src="$val24" alt="représentation graphique"><br>L'ordonnée à l'origine se lit sur le graphique &#58; $val9 <br><small>C'est la croix bleue</small>.<br> Le coefficient directeur se calcule  \($val8=\frac{\Delta y}{\Delta x}\)
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val25]
replytype2=numeric
replyoption2=comma default=0 
replyname2=
replygood2=$[$val26]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val27  
!read oef/embed.phtml r1,10	    autofocus 
$() $val28	 
!read oef/embed.phtml r2,10 
$()	$val29	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val30!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val30</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,27,28,29,30
embedcnt=2
