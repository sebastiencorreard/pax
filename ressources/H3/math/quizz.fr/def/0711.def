!set title=Question 0711 Cubes 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=cube,mental_calculation,volume,multiplication
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
val9=5,4,3	3,3,3	3,3,4	3,5,2	2,5,6	2,5,5	
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!shuffle $(tmp0)

val10=$(tmp1)
val11=$[rint($(val10[1]))]
val12=$[rint($(val10[2]))]
val13=$[rint($(val10[3]))]
val14=$[rint(1.8*max(max($(val10[1]),$(val10[2])),$(val10[3])))]
val15=$[rint($val11+1)]
val16=$[rint($val12+1)]
val17=$[rint($val13+1)]
val18=$[$val13*0.5]
val19=$[$val12+$val13*0.5]
val20=$[$val11+$val13*0.5]
val21=$[$val13*0.5]
!readproc oef/draw.phtml 300,300 \
xrange -1,$val14	yrange -1,$val14	parallel 0,0,0,$val12,1,0,$val15,black	parallel 0,0,$val11,0,0,1,$val16,black	parallel 0,$val12,$val11,$val12,0.5,0.5,$val17,black	parallel 0,$val12,$val18,$val19,1,0,$val15,black	parallel $val11,0,$val11,$val12,0.5,0.5,$val17,black	parallel $val11,0,$val20,$val21,0,1,$val16,black	 
tmp0=$ins_url
val22=$(tmp0)
val22=<div class="wimscenter"><img src="$val22" alt="Pavé droit"></div>
val23=$val22 Combien y a-t-il de petits cubes dans ce pavé droit &#63; 
val24=
val25=$[$val11*$val12*$val13]
val26=$[$val25]
val27=On peut faire cela par multiplication : \($val11 \times $val12 \times $val13 = $val25\). 
val28=\begin{enumerate}
val28=$val28	    \item	    $val23	    \dots $val24	  
val28=$val28 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val26]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val28 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val23  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val24	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val28 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val27!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val27</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,23,24,27,28
embedcnt=1
