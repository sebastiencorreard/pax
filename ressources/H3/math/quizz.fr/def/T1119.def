!set title=Question T1119 Script Python
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,python
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX
oefcss=<style>.CodeMirror {max-height:100px;}</style>

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randint 2, 6

val9=$[rint($(tmp0))]
tmp0=!randint 1, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]

!ifval ($val11>0)
val12= c=b+$val11
!else
val12=c=b$val11
!endif
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
val14=$[rint($val13*$val9+$val10+$val11)]
val15=$[rint($val14)]
val16=On considère le script python &#58; <div class="tt">&emsp;def prog(a)&#58;<br>&emsp;&emsp; b=$val9*a+$val10<br> &emsp;&emsp; $val12<br> &emsp;&emsp; return c</div>L&#146;expression prog($val13) renvoie &#58; 
val17=def prog(a):	   b=$val9*a+$val10	   $val12	   return c
!readproc slib/editor [python,[$val17]],1,readonly fullscreen theme=[3024-night,3024-day] 
tmp0=$slib_out
val18=$(tmp0)
val16=On considère le script python &#58;	$val18	L'expression prog($val13) renvoie &#58;
val19=
val20=$[rint($val9*$val13+$val10)]

!ifval ($val11>0)
val21= $val20+$val11
!else
val21=$val20$val11
!endif
val22=Lors de l'exécution du programme Python, b prend la valeur \($val9 \times $val13+$val10=$val20) et c prend la valeur \($val21=$val14).
val8=$[rint(6)]
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val19	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val22!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val22</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,16,19,22
embedcnt=1
