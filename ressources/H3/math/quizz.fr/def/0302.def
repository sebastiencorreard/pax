!set title=Question 0302 Repérage sur une droite graduée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=number_line
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 170,270,370

val8=$[rint($(tmp0))]
val9=$[rint($val8+10)]
val10=$[rint($val9+10)]
tmp=!translate ";': to $     $ in $val8+50

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[rint($(tmp0))]
tmp0=!randitem 35,45

val12=$[rint($(tmp0))]
val13=$[rint($val8+$val12)]

!ifval $val12=45
val14=$[rint(6)]
!else
val14=$[rint(5)]
!endif

!ifval $val12=45
val15=$[rint(10)]
!else
val15=$[rint(8)]
!endif

!ifval $val12=45
val16=$[rint(50)]
!else
val16=$[rint(40)]
!endif
val17=$[$val8-10]
val18=$[$val13+6]
val19=$[rint(-2)]
val20=$[rint(3)]
tmp=!translate ";': to $     $ in $val8-$val20

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val9-$val20

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val10-$val20

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$[rint($(tmp0))]
val24=$[rint($val18+10)]
!readproc oef/draw.phtml 350,100 \
xrange $val17,$val24	yrange -30,15	arrow $val17,0,$val24,0,10,black	arrow $val13,-20,$val13,-5,10,black	segment $val8,-3,$val8,3,black	parallel $val8,-2,$val8,10,10,0,$val14,black	parallel $val8,-2,$val8,6,5,0,$val15,black	parallel $val8,-2,$val8,2,1,0,$val16,black	text black,$val21,-5,large, $val8	text black,$val22,-5,large, $val9	text black,$val23,-5,large, $val10	 
tmp0=$ins_url
val25=$(tmp0)
val25=<div class="wimscenter"><img src="$val25" alt=""></div>
val26=$val25 Complète 
val27=
val28=
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val26  
!read oef/embed.phtml r1,10	    autofocus 
$() $val27</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val28!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val28</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,26,27,28
embedcnt=1
