!set title=Question 1022 Probabilité deux tirages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,probability
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim On obtient au moins une fois PILE,3/4,3 ont au moins un PILE	On obtient au moins une fois FACE,3/4,3 ont au moins un FACE	On obtient deux fois PILE,1/4,1 a deux PILE	On obtient deux fois FACE,1/4,1 a deux FACE	On obtient exactement une fois PILE,2/4,2 ont exactement un PILE	On obtient exactement une fois PILE,2/4,2 ont exactement un PILE
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$[$(val8[2])]
val10=On lance deux fois de suite une pièce de monnaie parfaitement équilibrée. Quelle est la probabilité de l'évènement : «$(val8[1])» &#63; <br> Réponse : 
val11=
val12=On imagine un arbre, sur lequel figurent les 4 évènements équiprobables "PILE1-PILE2", "PILE1-FACE2", "FACE1-PILE2", "FACE1-FACE2". Sur ces 4 issues possibles, $(val8[3]). Donc la réponse est \($(val8[2])\)
val13=\begin{enumerate}
val13=$val13	    \item	    $val10	    \dots $val11	  
val13=$val13\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val10  
!read oef/embed.phtml r1,10	    autofocus 
$() $val11</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val12!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val12</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,11,12,13
embedcnt=1
