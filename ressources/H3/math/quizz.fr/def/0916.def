!set title=Question 0916 Mesure d'un angle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,division,fraction,angles
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 3,4

val8=$[rint($(tmp0))]
val9=line 120,0,-120,0,black
!if $val8=3 
tmp=!translate ";': to $     $ in 120*cos(2/3*PI)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin(2/3*PI)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*cos(1/3*PI)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin(1/3*PI)

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
val9=$val9	line 0,0,$(tmp0),$(tmp1),black	line 0,0,$(tmp2),$(tmp3),black
val10=arc 0,0,50,50,0,60,black	arc 0,0,60,60,60,120,black	arc 0,0,50,50,120,180,black
!endif
!if $val8=4 
tmp=!translate ";': to $     $ in 120*cos(1/4*PI)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin(1/4*PI)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*cos(2/4*PI)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin(2/4*PI)

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*cos(3/4*PI)

tmp=!lower $tmp
tmp4=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin(3/4*PI)

tmp=!lower $tmp
tmp5=!exec maxima fullratsimp($tmp);
val9=$val9	line 0,0,$(tmp0),$(tmp1),black	line 0,0,$(tmp2),$(tmp3),black	line 0,0,$(tmp4),$(tmp5),black
val10=arc 0,0,50,50,0,45,black	arc 0,0,60,60,45,90,black	arc 0,0,50,50,90,135,black	arc 0,0,60,60,135,180,black	
!endif
tmp0=!randint 1, $val8-1

tmp=!translate ";': to $     $ in PI-$(tmp0)/$val8*PI

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val11=$(tmp1)
tmp=!translate ";': to $     $ in 120*cos($val11)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 120*sin($val11)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val12=$(tmp0),$(tmp1)
!readproc oef/draw.phtml 300,170 \
xrange -150,150	yrange -20,150	line 120,0,-120,0,black	arc 0,0,240,240,0,180,black	$val9	$val10	text black,0,-5,large,O	text black,-120,-5,large,A	text black,120,-5,large,I	text black,$(val12[1]),$(val12[2])+20,large,B	 
tmp0=$ins_url
val13=$(tmp0)
val13=<div class="wimscenter"><img src="$val13" alt=""></div>
val14=$val13 I, O et A sont alignés, quelle est la mesure de l'angle de la rotation qui transforme A en B ?
val15=°.
tmp=!translate ";': to $     $ in 180-$val11/PI*180

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$[rint($(tmp0))]
val17=Rappel : l'angle plat \(\widehat{IOA}\) mesure \(180^\circ\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

