!set title=Question 1025 Ecrire un calcul
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,literal_calculation
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,3,4,5

tmp0=!randitem $tmp
val8=$(tmp0)x
tmp=!nonempty items 6,7,8,9

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]

!ifval $val10==1 
val12= carré 
!else
val12= cube
!endif

!ifval $val11==1 
val13= somme 
!else
val13= différence
!endif

!ifval $val10==1 and $val11==1 
val14=($val8)^2+$val9
!endif

!ifval $val10==1 and $val11==2 
val14=($val8)^2-$val9
!endif

!ifval $val10==2 and $val11==1 
val14=($val8)^3+$val9
!endif

!ifval $val10==2 and $val11==2 
val14=($val8)^3-$val9
!endif
val15=Écrire sous la forme d'une expression littérale la $val13 du $val12 de \($val8 \) et de \($val9 \). <br> Réponse : 
val16=<div class="wims_instruction">Ne pas développer ni réduire.</div>
val17=Ne pas oublier les parenthèses pour les priorités...
val18=\begin{enumerate}
val18=$val18\end{enumerate}
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,10	    autofocus 
$() $val16</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val17!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,15,16,17,18
embedcnt=1
