!set title=Question 1126 Suite et Script Python
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,python
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX
oefcss=<style>.CodeMirror {max-height:110px;}</style>

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3

val8=$(tmp0)
tmp0=!randint 5, 7

val9=$[rint($(tmp0))]
val10=$[rint($(val8[1]))]
val11=$[rint($(val8[2]))]
val12=$[rint(0)]
val13=$[rint($val11)]
val14=$val11
val15=$val12
!while $val13<$val9 
val12=$[rint($val12+1)]
val13=$[rint($val13+$val10)]
val14=$val14,$val13
val15=$val15,$val12
!endwhile
val16=$[rint($val12)]
val17=def Suite (u):	   n = 0	   while u < $val9 :	      u = u + $val10	      n = n + 1	   return n
!readproc slib/editor [python,[$val17]],1,readonly fullscreen theme=[3024-night,3024-day] 
tmp0=$slib_out
val18=$(tmp0)
val19=On considère le script python &#58;	$val18	Suite($val11) renvoie &#58; 
val20=
val21=Lors de l'exécution du programme Python, la variables u et n prennent comme valeurs successives : 	<br>u : $val14<br> n : $val15
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,10	    autofocus 
$() $val20	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,19,20,21
embedcnt=1
