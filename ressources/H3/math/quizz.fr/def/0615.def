!set title=Question 0615 Dixièmes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=decimals,addition
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randint 2, 8

tmp1=!randint 1, 9

val10=$[$(tmp0)+0.9+$(tmp1)/100]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val11=$[($(tmp0)*100+$(tmp1)*10+$(tmp2))/10]
tmp0=!replace internal . by , in $val10

val12=$(tmp0)
tmp0=!replace internal . by , in $val11

val13=$(tmp0)

!ifval ($val9==1)
val14= Ajoute un dixième à \($val12\) 
!else
val14= Combien de dixièmes dans \($val13\) ?
!endif

!ifval ($val9==1)
val15=$[ $val10+0.1]
!else
tmp=!translate ";': to $     $ in 10*$val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$[ $(tmp0)]
!endif
val16=
val17=
val18=\begin{enumerate}
val18=$val18	    \item	    $val14	    \dots $val16	  
val18=$val18 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val16	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,16,17,18
embedcnt=1
