!set title=Question 0624 Repérage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=coordinates,number_line
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 2, 8

val9=$[rint($(tmp0))]
val10=$[$val9-0.15]
val11=$[$val9+1.15]
tmp0=!randitem 4,5

val12=$[rint($(tmp0))]
val13=$[1/$val12]
tmp0=!randint 1, ($val12-1)

val14=$[$val9+$(tmp0)*$val13]

!ifval ($val14==$val9+0.5)
tmp=!nonempty items -0.25,0.25

tmp0=!randitem $tmp
val14=$[ $val14+$(tmp0)]
!else
val14=$[$val14]
!endif
val15=$[rint(1+$val9)]
!readproc oef/draw.phtml 300,60 \
xrange $val10,$val11	yrange -3,3	linewidth 1.5	segment $val10,0,$val11,0,black	segment $val9,-1.5,$val9,1.5,black	segment $val9+1,-1.5,$val9+1,1.5,black	parallel $val9+$val13,-0.5,$val9+$val13,0.5,$val13,0,$val12-1,black	text black,$val9,-1.5,large,$val9	text black,$val9+1,-1.5,large,$val15	linewidth 2	arrow $val14,-2.8,$val14,-1,10,black	 
tmp0=$ins_url
val16=$(tmp0)
val17=<img src="$val16" alt="">
val18=$[$val14]
val19=<table><tr><td>$val17</td></tr><tr><td> Le nombre repéré par la flèche est </td></tr></table>
val20=
val21=Une graduation vaut $val13
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val20	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,19,20,21
embedcnt=1
