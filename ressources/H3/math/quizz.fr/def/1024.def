!set title=Question 1024 Décomposition en facteurs premiers
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,primes
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,5,7

val8=$(tmp0)

!ifval $(val8[1])==7 
val9=$[rint( $(val8[4]) )]
!else
val9=$[rint( $(val8[1]))]
!endif
val10=$[rint($(val8[2]))]
val11=$[rint($(val8[3]))]
val12=$[rint($val9^2*$val10*$val11)]
val13=$val9^2*$val10*$val11|[Alt:[Apick:3,[*],[*],$val9^2,$val10,$val11],[Apick:4,[*],[*],[*],$val9,$val9,$val10,$val11]]
val14=Décomposer $val12 en produit de facteurs premiers. <br> Réponse : 
val15=
val16=$[rint($val9^2)]
val17=$[rint($val10*$val11)]
val18=On divise \($val12 \), puis chacun de ses facteurs. On continue	jusqu'à ne plus pouvoir diviser.<br>Par exemple : \( $val12= $val16 \times $val17 \)	\({} = $val9 \times $val9 \times $val10 \times $val11 \)	\({}= $val9^2 \times $val10 \times $val11\).
val19=\begin{enumerate}
val19=$val19\end{enumerate}
replytype1=case
replyoption1=symtext default=0 
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val18!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,18,19
embedcnt=1
