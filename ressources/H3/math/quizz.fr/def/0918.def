!set title=Question 0918 Pourcentage d'un entier
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,proportionality,percents,percentage
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 9

val8=$[rint($(tmp0)*10)]
tmp0=!randint 2, 9

val9=$[rint($(tmp0)*10)]
tmp=!translate ";': to $     $ in $val9*$val8/100

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$[rint($(tmp0))]
val11=$[rint($val10)]
val12=\($val8 \%\) de \($val9\) 
val13=
val14=$[$val8/100]
val15=Rappel : Il faut effectuer l'opération \( $val14 \times $val9 = $val10 \) pour obtenir \($val8 \%\) de \($val9\). 
val16=\begin{enumerate}
val16=$val16	    \item	    $val12	    \dots $val13	  
val16=$val16 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val16 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val16 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val15!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val15</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,13,15,16
embedcnt=1
