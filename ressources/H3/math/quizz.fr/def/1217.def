!set title=Question 1217 Raison d'une suite arithmétique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=arithmetic_sequence,mental_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 1,2,3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

val9=$(tmp0)
tmp=!translate ";': to $     $ in $val9+$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val9+2*$val8

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val9+3*$val8

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val9+4*$val8

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
val10=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
tmp0=!randitem 2,3

val11=$[rint($(tmp0))]
val12=$[rint($(val10[$val11])-$val9)]
val13=$[rint($val8)]
val14=\(u\) est une suite arithmétique telle que \(u_0 = $val9\) et \(u_$val11 = $(val10[$val11])\). Quelle est sa raison &#63;
val15=
val16=Puisque \( u_$val11 -u_0 =$val12\). On calcule \($val12 \div $val11 =$val8\)
val17=\begin{enumerate}
val17=$val17	    \item	    $val14	    \dots $val15	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,16,17
embedcnt=1
