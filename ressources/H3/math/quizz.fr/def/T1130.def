!set title=Question T1130 Aire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,area,circle,rectangles
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
val9=$[rint(200)]
tmp0=!randint 2, 5

val10=$[rint(2*$(tmp0))]
val11=$[rint($val10/2)]
val12=$[rint($val10^2)]
val13=$[rint($val11^2)]
val14=$val12-$val13,pi
val15=$[rint(6*$val9/8)]
!readproc oef/draw.phtml $val9,$val9 \
xrange -1,7	yrange -1,7	polygon black,0,0,6,0,6,6,0,6	hatchfill 3,3,10,10,black	fcircle 3,3,$val15,white	circle 3,3,$val15,black	crosshair 3,3,5,black	text black,3.5,3.5,giant,O	text black,-0.5,6.5,giant,A	text black,6.5,6.5,giant,B	text black,6.5,-0.2,giant,C	text black,-0.5,-0.2,giant,D	 
tmp0=$ins_url
val16=$(tmp0)	
val16=<img src="$val16" alt="">
val17=Sur la figure ci-dessous, le disque blanc de centre O est inscrit dans le carré ABCD de côté \($val10\) cm.<br>Exprimer en fonction de \(pi)&#44; l'aire de la partie hachurée en \(cm^2\) :<br> 
val18=cm² <br>$val16<div class="wims_instruction">Saisir 3pi si la réponse est \(3\pi\).</div>
tmp0=!replace internal ,pi by *pi in $val14

val19=$(tmp0)
val20=L'aire du rectangle est égale à \($val10^2\) auquel il faut enlever l'aire du disque de rayon \($val10 \div 2\).<br> L'aire d'un disque de rayon \(r\) est \(\pi r^2\).
val8=$[rint(8)]
replytype1=formal
replyoption1=comma default=0 
replyname1=
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val17  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val18	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,17,18,20
embedcnt=1
