!set title=Question 0619 Nombre en mots
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=numeration
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval ($val9==1)
val10=millions,mille,cent
!else
val10=unités,dizaines,centaines
!endif
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
tmp0=!randint 2, 8

val12=$[rint($(tmp0))]
tmp0=!randint 3, 14

val13=$[rint(5*$(tmp0))]
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!randint 2, 9

val15=$[rint($(tmp0))]

!ifval ($val15==$val12)
val15=$[rint( $val12+1)]
!else
val15=$[rint($val15)]
!endif
!readproc slib/numeration/ecriturelettre $val12 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/numeration/ecriturelettre $val13 
tmp0=$slib_out
val17=$(tmp0)
!readproc slib/numeration/ecriturelettre $val15 
tmp0=$slib_out
val18=$(tmp0)
!if $val9==1 

!ifval ($val11==1)
val19= $val16-millions-$val17-mille
!else
val19=$val16-millions-$val18-cents
!endif

!ifval ($val11==1)
val20=$[rint( $val12*1000000+$val13*1000)]
!else
val20=$[rint($val12*1000000+$val15*100)]
!endif
!else

!ifval ($val14==1)
val19= $val16 unités et $val18 centaines
!else
val19=$val16 dizaines et $val18 centaines
!endif

!ifval ($val14==1)
val20=$[rint( $val12+$val15*100)]
!else
val20=$[rint($val12*10+$val15*100)]
!endif
!endif
val21=Ecrire en chiffres, le nombre $val19 : 
val22=
val23=
val24=\begin{enumerate}
val24=$val24	    \item	    $val21	    \dots $val22	  
val24=$val24 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val20]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val22	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val24 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val23!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val23</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,21,22,23,24
embedcnt=1
