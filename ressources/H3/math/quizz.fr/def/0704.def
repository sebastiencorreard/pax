!set title=Question 0704 Produit par regroupement
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,methodical_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp=!trim 4,25;	2,50;	2,5;	5,20
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!randitem 0,1

val11=$[rint($(tmp0))]

!ifval $val11=1
val12=$[rint($(val10[1]))]
!else
tmp0=!randitem 3,6,7,8,9

val12=$[rint($(tmp0))]
!endif

!ifval $val11=1
tmp0=!randitem 3,6,7,8,9

val13=$[rint($(tmp0))]
!else
val13=$[rint($(val10[1]))]
!endif

!ifval $val11=1
val14=$[rint($(val10[2]))]
!else
tmp0=!randitem 3,6,7,8,9

val14=$[rint($(tmp0))]
!endif

!ifval $val11=1
tmp0=!randitem 3,6,7,8,9

val15=$[rint($(tmp0))]
!else
val15=$[rint($(val10[2]))]
!endif
val16=$[rint($val12*$val13*$val14*$val15)]
val17=\($val12 \times $val13 \times $val14 \times $val15=\)
val18=
val19=$[rint($(val10[1])*$(val10[2]))]
val20=Il faut regrouper les termes pour faciliter l'opération. Ici : \($(val10[1]) \times $(val10[2])=$val19\).
val21=\begin{enumerate}
val21=$val21	    \item	    $val17	    \dots $val18	  
val21=$val21 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val17  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val18	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,17,18,20,21
embedcnt=1
