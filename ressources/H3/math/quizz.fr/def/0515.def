!set title=Question 0515 Dixièmes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=decimals,addition
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 1,2,2,2

val8=$[rint($(tmp0))]
tmp0=!randint 2, 8

val9=$[rint($(tmp0))]
tmp0=!randint 2, 8

val10=$[rint($(tmp0))]
tmp0=!randint 2, 8

val11=$[rint($(tmp0))]

!ifval ($val8==1)
val12= Ajoute \($val11\) dixième à \($val9\) unités 
!else
val12= Combien de dixièmes dans \($val10\) unités ?
!endif

!ifval ($val8==1)
val13=$[ $val9+0.1*$val11]
!else
tmp=!translate ";': to $     $ in 10*$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$[ $(tmp0)]
!endif
val14=
val15=$[$val11*0.1]

!ifval $val8=1
val16=Rappel &#58; \($val11\) dixièmes est égal à \($val15\)
!else
val16=Rappel &#58; une unité est égale à 10 dixièmes.
!endif
val17=\begin{enumerate}
val17=$val17	    \item	    $val12	    \dots $val14	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,14,16,17
embedcnt=1
