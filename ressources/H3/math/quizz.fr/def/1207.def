!set title=Question 1207 Probabilité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=probability,mental_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,4,5

val8=$(tmp0)
val9=$[rint($(val8[1]))]
!readproc slib/numeration/ecriturelettre $val9 
tmp0=$slib_out
val10=$(tmp0)
val11=$[rint($(val8[2]))]
!readproc slib/numeration/ecriturelettre $val11 
tmp0=$slib_out
val12=$(tmp0)
tmp0=!randitem noire,blanche

val13=$(tmp0)
val14=$[rint($val9+$val11)]

!ifval $val13 issametext noire 
val15=$[ $val9/$val14]
!else
val15=$[$val11/$val14]
!endif
val16=s

!ifval $val13 issametext noire 
val17=$[rint( $val9)]
!else
val17=$[rint($val11)]
!endif
val18=Une urne contient $val10 boules noires et $val12 boules blanches. <br><i>On tire une boule au hasard.</i><br>Quelle est la probabilité de tirer une boule $val13 &#63; 
val19=
val20=Attention, il y a $val14 boules $val13$val16. Donc \(\frac{$val17}{$val14}\).
val21=\begin{enumerate}
val21=$val21	    \item	    $val18	    \dots $val19	  
val21=$val21 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val18  
!read oef/embed.phtml r1,10	    autofocus 
$() $val19	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,18,19,20,21
embedcnt=1
