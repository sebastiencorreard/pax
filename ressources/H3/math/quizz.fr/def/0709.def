!set title=Question 0709 Multiplication de décimaux 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,multiplication,decimals
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!shuffle 3,7,4,6,8,9

val9=$(tmp0)
tmp0=!randint 1, 9

val10=$[$(tmp0)+$(val9[1])/10]
tmp0=!randint 1, 9

val11=$[$(tmp0)+$(val9[2])/10]
val12=$[$val10*$val11*10]
val13=$[$val10*$val11/10]
val14=$[$val10*$val11]
val15=Sélectionne le résultat de $val10\( {}\times {} \)$val11. 
val16=
val17=Rappel : \($val10\) possède une décimale, \($val11\) possède une décimale donc \($val10 \times $val11\) a \(1+1=2\) décimales.
val18=\begin{enumerate}
val18=$val18	    \item	    $val15	    \begin{radio}	    \item $val14	    \item $val12	    \item $val13	    \end{radio}
val18=$val18 \end{enumerate}
replytype1=menu
replyoption1=shuffle default=$val12 weight=2 
replyname1=
replygood1=1;$val14,$val12,$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val16	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,15,16,17,18
embedcnt=1
