!set title=Question 0512 Différentes écritures d'une fraction 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals,rational_number,number_writing
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 5,10	10,20	2,4	3,6	4,10	8,10
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=Donne deux écriture différentes de \($val9/$val10 \)
val12=
val13=
val14=\begin{enumerate}
val14=$val14 \end{enumerate}
replytype1=numeric
replyoption1=defaut=0 
replyname1=
replygood1=?analyze 15
replytype2=numeric
replyoption2=defaut=0 
replyname2=
replygood2=?analyze 16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val11  
!read oef/embed.phtml r1,10	    autofocus 
$() $val12	 et  
!read oef/embed.phtml r2,10 
$() $m_enoncec	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val13!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val13</div>
$()</div>
!endif

!exit

:test

!ifval ($val15=$val9/$val10) and ($val16=$val9/$val10) and ($val15 notsametext $val9/$val10) and ($val16 notsametext $val9/$val10) and ($val15 notsametext $val16)
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonnes réponses ?

!exit

:stat
vsavelist=6,9,10,11,12,13,14,15,16
embedcnt=2
