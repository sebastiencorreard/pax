!set title=Question 1020 Calcul du coefficient directeur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,lines,affine_function,line
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 2,3,4,5

tmp0=!randitem $tmp
val9=$[rint($val8*$(tmp0))]
tmp=!nonempty items 1,2,3

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp=!nonempty items 1,2,3

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[rint($val10+$val8)]
val13=$[rint($val11+$val9)]
val14=$[$val9/$val8]
val15=$[$val14]
val16=Dans un repère, on considère les points C($val10 ; $val11) et D($val12 ; $val13). Calculer le coefficient directeur de la droite (CD). <br> Réponse : 
val17=
val18=On utilise la formule \(m=\frac{y_D-y_C}{x_D-x_C}\). <br>Ici cela nous donne : \(m=\frac{$val9}{$val8}=$val14\)
val19=\begin{enumerate}
val19=$val19	    \item	    $val16	    \dots $val17	  
val19=$val19\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,10	    autofocus 
$() $val17</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val18!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,17,18,19
embedcnt=1
