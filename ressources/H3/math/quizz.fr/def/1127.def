!set title=Question 1127 Théorème de Thalès
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,proportionality
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 2,3

val8=$[rint($(tmp0))]
tmp0=!randitem 11,7,13

val9=$(tmp0)
tmp0=!randitem 2,3,4,5

val10=$val8*$val9,$val8*,$val9,$(tmp0)
tmp0=!randitem 2,3,4,5

val11=$[$(tmp0)]
val12=$[$val9*$val8]
val13=$[$val9]
val14=$[$val11*$val8]
!readproc oef/draw.phtml 230,115 \
xrange 0,200	yrange 0,200	line 20,80,180,120,black	line 90,30,110,170,black	line 20,80,90,30,black	line 180,120,110,170,black	text black,90,25,medium,F	text black,105,95,medium,C	text black,100,57,medium, ?	text black,90,140,medium,$val14	text black,10,75,medium,A	text black,45,45,medium,$val13	text black,100,200,medium,E	text black,185,150,medium,B	text black,145,170,medium,$val11	 
tmp0=$ins_url
val15=$(tmp0)
val15=<img src="$val15" alt="">
val16=<table><tr><td> $val15 </td><td> (AF) // (EB) <br>Déterminer FC : 
val17=</td></tr></table>
val18=On doit avoir (d'après le théorème de Thalès) : \(CE/CF = EB/AF\) ce qui nous donne ici : \({{$val14}\over{FC}} = {{$val11}\over{$val13}}\). On calcule la réponse par proportionnalité.
replytype1=formal
replyoption1=comma default=0 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val16  
!read oef/embed.phtml r1,10	    autofocus 
$() $val17	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
