!set title=Question 0618 Conversion
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=conversion,masse,length
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp=!trim g,kg	m,km	kg,g	km,m
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
tmp0=!randint 11, 75

val11=$[rint($(tmp0)*100)]
val12=$[$val11/1000]

!ifval ($val10<=2)
val13=$[ $val12]
!else
val13=$[$val11]
!endif

!ifval ($val10<=2)
val14= Convertir &#58; \($val11\) $(val9[$val10;1])=
!else
val14=Convertir &#58; \($val12\) $(val9[$val10;1])=
!endif
val15=$(val9[$val10;2])

!ifval ($val10<=2)
val16= On rappelle que 1000 $(val9[$val10;1])=1 $(val9[$val10;2]).
!else
val16=On rappelle que 1 $(val9[$val10;1])=1000 $(val9[$val10;2]). 
!endif
val17=\begin{enumerate}
val17=$val17	    \item	    $val14	    \dots $val15	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,16,17
embedcnt=1
