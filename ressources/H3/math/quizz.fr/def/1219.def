!set title=Question 1219 Abscisse du sommet de la parabole
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,functions,coordinates
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 1, 3

val8=$[$(tmp0)*(-1)-0.5]
tmp0=!randint 4, 6

val9=$[$val8+$(tmp0)]
val10=!rawmath (x-$val8)*(x-$val9)
val11=$[($val8+$val9)/2]
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
val10=!rawmath -1*($val10/($val12))
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
val13=$[0.3]
val14=$[$val11-$val13]
val15=$[$val12-$val13]
val16=$[$val8+$val13]
val17=$[$val9-3*$val13]
val18=xrange -5,5	yrange -2,2	linewidth 2	plot black,$val10	linewidth 1	arrow -5,0,10,0,15,black	arrow 0,-3,0,10,15,black	crosshairsize 5	linewidth 2	crosshairs black,$val8,0,$val9,0,$val11,$val12	text black,$val16,$val13,medium,$val8	text black,$val17,$val13,medium,$val9	text black,$val14,$val15,giant,S	
!readproc oef/draw.phtml 300,200 \
$val18 
tmp0=$ins_url
val19=$(tmp0)
val20=$[($val8+$val9)/2]
val21=<img src="$val19" alt="graph"><br> Abscisse du sommet S de cette parabole.<br>Réponse &#58;
val22=
val23=C'est la moyenne \(\frac{$val8+$val9}{2}\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
!read oef/embed.phtml r1,10	    autofocus 
$() $val22	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val23!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val23</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,21,22,23
embedcnt=1
