!set title=Question 0508 Groupes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving,divisibility
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 15,1,3	16,2	18,1	20,2,3	21,1,4	24,1,2	25,3	27,1	28,2,4	30,1,3	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val9=$[rint($(tmp1))]
val10=$(val8[$val9;2..-1])
val11=3 joueurs,4 joueurs,5 joueurs,7 joueurs
val12=Un entraineur répartit \($(val8[$val9;1])\) joueurs dans des équipes ayant le même nombre de joueurs.<br>Il peut faire des équipes de &#58;
val13=<div class="wims_instruction">Cocher <u>toutes</u> les réponses justes.</div>
val14=Il suffit de vérifier si les nombres proposés sont des diviseurs du nombre de joueurs.
replytype1=checkbox
replyname1=
replygood1=$val10;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val12  
!read oef/embed.phtml r1,10	    autofocus 
$() $val13	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val14!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,13,14
embedcnt=1
