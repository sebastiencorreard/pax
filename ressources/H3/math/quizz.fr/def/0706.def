!set title=Question 0706 Addition de fractions décimales 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,decimals,addition,fraction
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 11, 30

val9=$[rint($(tmp0))]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

val11=$[rint($(tmp0))]
tmp0=!randitem 0,1

val12=$[rint($(tmp0))]

!ifval $val12=0
val13=$[rint(10)]
!else
val13=$[rint(100)]
!endif
val14=$[$val9+$val10/$val13+$val11/1000]
val15=Écriture décimale de : \($val9+\frac{$val10}{$val13}+\frac{$val11}{1000}=\)
val16=
val17=$[$val10/$val13]
val18=Rappel : \(\frac{$val10}{$val13} = $val17\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val16	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
