!set title=Question 0430 Aire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=geometry,area
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 0, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 4, 6

val10=$[rint($(tmp0))]
tmp0=!randitem 4,5

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

val12=$[rint($(tmp0))]
!if $val12=1 
val13=5,6,5.5,5.5,black
val14=6,6,5.5,5.5,black
val15=5,5,6,5,5.5,5.5
val16=$[($val10-$val8)*($val11-$val9)*4]
val17=Une case a une surface de 4 unités d'aire.
!endif
!if $val12=2 
val13=0,0,0,0,grey
val14=0,0,0,0,grey
val15=5,5,6,5,5,6
val16=$[($val10-$val8)*($val11-$val9)*2]
val17=Une case a une surface de 2 unités d'aire.
!endif
!if $val12=3 
val13=0,0,0,0,grey
val14=0,0,0,0,grey
val15=4,5,6,5,6,6,4,6
val16=$[($val10-$val8)*($val11-$val9)/2]
val17=Une case a une surface de 0,5 unités d'aire.
!endif
val18=xrange -0.2,6.2	yrange -0.2,6.2	parallel 0,0,0,6,1,0,7,grey	parallel 0,0,6,0,0,1,7,grey	fpoly blue,$val15	segment $val13	segment $val14	linewidth 3	segment $val8,$val9,$val10,$val9,black	segment $val8,$val9,$val8,$val11,black	segment $val10,$val9,$val10,$val11,black	segment $val10,$val11,$val8,$val11,black
!readproc oef/draw.phtml 250,250 \
$val18 
tmp0=$ins_url
val19=$(tmp0)
val20=<img src="$val19" alt="">
val21=<table><tr><td>$val20</td></tr><tr><td> Quelle est l'aire du rectangle noir &#63; <br> L'unité est l'aire de la figure bleue. </td></tr></table> 
val22=unités d'aire
val23=\begin{enumerate}
val23=$val23	    \item	    $val21	    \dots $val22	  
val23=$val23 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val21  
