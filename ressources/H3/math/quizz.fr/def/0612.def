!set title=Question 0612 Durée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=pbsolving,time
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval $val9==1 
tmp0=!randint 7, 10

val10=$[rint( 5*$(tmp0))]
!else
tmp1=!randint 3, 8

val10=$[rint(5*$(tmp1))]
!endif
tmp0=!randint 18, 21

val11=$[rint($(tmp0))]
tmp0=!randint ((65-$val10)/5), 11

val12=$[rint(5*$(tmp0))]
val13=$[rint($val11+$val9+1)]

!ifval ($val13==24)
val13= 0
!else
val13=$val13
!endif
val14=$[rint($val10+$val12-60)]

!ifval ($val14==5)
val14= 05
!else
val14=$val14
!endif
val15=$[rint($val9)]
val16=$[rint($val10)]
val17=Un film commence à \($val11\, \text{h} \,$val12 \,min\) et se termine à \($val13\, \text{h} \,$val14 \,min\). Combien de temps dure t-il?
val18=\(\text{h}\)
val19=\(min\)
val8=$[rint(4)]
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
replytype2=numeric
replyoption2=comma default=0 
replyname2=
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val17  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val18	 
!read oef/embed.phtml r2,$val8 
$() $val19	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and (\feedback!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$m_feedback</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,17,18,19
embedcnt=2
