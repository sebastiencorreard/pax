tmp1=!randitem 1,0

val13=$[0.1*$(tmp0)+$(tmp1)]
val14=$[$val9+$val13]
val15=$[rint(3)]
val16=$[rint(6)]
val17=$[rint(30)]
val18=$[$val9-0.5]
val19=$[$val14+1]
val20=$[rint(-2)]
val21=$[rint(0.2)]
tmp=!translate ";': to $     $ in $val9-$val21

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val10-$val21

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val11-$val21

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$[rint($(tmp0))]
val25=$[rint($val9+3.25)]
!readproc oef/draw.phtml 350,100 \
xrange $val18,$val25	yrange -30,15	arrow $val18,0,$val25,0,10,black	arrow $val14,-20,$val14,-5,10,black	segment $val9,-3,$val9,3,black	parallel $val9,-2,$val9,10,1,0,$val15,black	parallel $val9,-2,$val9,6,0.5,0,$val16,black	parallel $val9,-2,$val9,2,0.1,0,$val17,black	text black,$val22,-5,large, $val9	text black,$val23,-5,large, $val10	text black,$val24,-5,large, $val11	 
