!set title=Question 1026 Multiplication par un décimal
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=mental_calculation,multiplication,decimals,methodical_calculation
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,1,2

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 12,16,20,24

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval $val8=1 
val10=$[ 1.25 ]
!else
val10=$[ 0.75]
!endif
val11=$[$val9*$val10]
val12=$[$val11]
val13=\($val10 \times $val9 ={}\)
val14=
val15=$[rint($val9/4)]
val16=\(1.25 \times $val9=1 \times $val9+0,25 \times $val9\)\({}=$val9+\frac{1}{4} \times $val9 = $val9 + $val15 = $val11\)
val17=\(0.75 \times $val9=\frac{3}{4} \times $val9=\frac{$val9 \times 3}{4} \)\({}= \frac{$val9 }{4}\times 3=$val15 \times 3 = $val11\)

!ifval $val8=1 
val18= $val16 
!else
val18= $val17
!endif
val19=\begin{enumerate}
val19=$val19	    \item	    $val13	    \dots $val14	  
val19=$val19\end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1<1 and $val18!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,18,19
embedcnt=1
