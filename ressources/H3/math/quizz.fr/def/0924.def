!set title=Question 0924 Hausse de prix
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,percentage,pbsolving
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 5

val8=$[rint($(tmp0)*100)]
tmp0=!randitem 25,30,40

val9=$[rint($(tmp0))]
tmp0=!randitem -1,1

val10=$[rint($(tmp0))]

!ifval $val10=-1
val11=baisse 
!else
val11= augmente
!endif
val12=$[$val8*(1+$val10*$val9/100)]
val13=Une console de jeu coûte \($val8\) &euro;. Son prix $val11 de \($val9 \%\). Quel est son nouveau prix ?
val14=&euro;.
val15=$[$val9/100]
val16=$[$val9/100*$val8]

!ifval $val10=-1
val17= Montant de la baisse &#58; \($val15 \times $val8=$val16\), il reste à faire la soustraction.
!else
val17=Montant de l'augmentation &#58; \($val15 \times $val8=$val16\), il reste à faire l'addition.
!endif
val18=\begin{enumerate}
val18=$val18	    \item	    $val13	    \dots $val14	  
val18=$val18 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val17</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,17,18
embedcnt=1
