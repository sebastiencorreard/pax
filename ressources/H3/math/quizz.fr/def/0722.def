!set title=Question 0722 Addition de décimaux
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=decimals,methodical_calculation
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 1, 3

tmp1=!randint 1, 9

tmp2=!randint 4, 5

tmp3=!randint 1, 9

val9=$(tmp0)*10+$(tmp1),$(tmp2)*10+$(tmp3)
tmp0=!randint 1, 3

tmp1=!randint 1, 9

val10=$[rint($(tmp0)*10+$(tmp1))]
val11=$[rint(100-$val10)]
tmp0=!randint 4, 5

tmp1=!randint 1, 9

val12=$[rint($(tmp0)*10+$(tmp1))]
tmp0=!shuffle 6

val13=$(tmp0)
val14=$[$(val13[1])+$val10/100]
val15=$[$(val13[2])+$val12/100]
val16=$[$(val13[3])+$val11/100]
tmp0=!randitem 1,2,1

val17=$[rint($(tmp0))]

!ifval $val17=1
val18=$[$val14]
!else
val18=$[$val15]
!endif

!ifval $val17=2
val19=$[$val14]
!else
val19=$[$val15]
!endif
val20=$[$val16]
val21=$[$val14+$val16]
val22=$[$val18+$val19+$val20]
val23=\($val18+$val19+$val20={}\)
val24=On peut remarquer que \($val14+$val16=$val21\). Il reste juste à ajouter \($val15\).
val25=\begin{enumerate}
val25=$val25	    \item	    $val23	    \dots \enonceb	  
val25=$val25 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val22]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val23  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $m_enonceb	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val25 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val24!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val24</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,23,24,25
embedcnt=1
