val9=$[rint($(tmp0))]
tmp0=!randint 5, 20

val10=$[rint($(tmp0))]
val11=&#91;
val12=&#93;
val13=\(-\infty)
val14=\(+\infty)
val15=&#123;
val16=&#125;
val17=&#59;
val18=>
val19=\(\ge )
val20=<
val21=\(\le \)
val22=$val20,$val21,$val18,$val19
tmp0=!randint 1, 2

val23=$[rint($(tmp0))]
tmp0=!randint 1, 2

val24=$[rint($(tmp0))]

!ifval $val23=1
val25=$val12
!else
val25=$val11
!endif

!ifval $val24=1
val26=$val11
!else
val26=$val12
!endif
val27=$val25,$val9,$val17,$val10,$val26

!ifval $val23=2
val28=$val12
!else
val28=$val11
!endif

!ifval $val24=2
val29=$val11
!else
val29=$val12
