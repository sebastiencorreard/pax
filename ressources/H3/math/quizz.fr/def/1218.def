val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 0,1,3,1,4,-2,2,2,3;0,1,3,1,4,-2,2,2,2;0,2,3,1,4,-2,2,2,3;0,2,3,1,4,-2,2,2,1;0,2,3,1,5,-2,2,2,3;0,1,3,1,4,-2,2,2,2;0,2,3,1,5,-2,2,2,1;0,1,3,1,4,-2,2,2,3
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=$[rint($(val8[3]))]
val12=$[rint($(val8[4]))]
val13=$[rint($(val8[5]))]
val14=$[rint($(val8[6]))]
val15=$[rint($(val8[7]))]
val16=$[rint($(val8[8]))]
val17=$[rint($(val8[9]))]
tmp=!translate ";': to $     $ in ((x-($val12))*(x-($val15))/(($val9-($val12))*($val9-($val15))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ((x-($val9))*(x-($val15))/(($val12-($val9))*($val12-($val15))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ((x-($val9))*(x-($val12))/(($val15-($val9))*($val15-($val12))))^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val18,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val21=!rawmath $(tmp1)
evaltmp=$val21

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val21=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val19,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val22=!rawmath $(tmp1)
evaltmp=$val22

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val22=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val20,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val23=!rawmath $(tmp1)
evaltmp=$val23

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val18*($val10+(x-$val9)*($val11-$val21*$val10)) + ($val19)*($val13+(x-$val12)*($val14-$val22*$val13)) +($val20)*($val16+(x-$val15)*($val17-$val23*$val16))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=!rawmath $(tmp0)
val25=xrange -1,3.2	yrange -0.8,5.2	linewidth 2	plot red,$val24	linewidth 1	arrow -1,0,3.2,0,15,black	arrow 0,-1,0,5,15,black	text black,0.1,5,medium, y	text black,3,-0.1,medium, x	
!readproc oef/draw.phtml 300,300 \
$val25 
tmp0=$ins_url
val26=$(tmp0)
tmp=!translate ;";': to $     $ in $val24,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val27=!rawmath $(tmp0)
tmp=!replace internal .. by , in $val27,x=-0.8..3.2 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val28=$(tmp0)
tmp0=!itemcnt $val28

val28=$[rint($(tmp0))]
val29=$[rint($val28)]
val30=<img src="$val26" alt="graph"><br> La fonction \(f\) est représentée ci-dessus. A l'aide de ce graphique, quel est le nombre de solutions de l'équation \(f &#8242;(x) = 0\) &#63;
val31=
val32=Cela correspond au nombre de fois où la courbe a une tangente horizontale.
replytype1=numeric
replyoption1=comma default=0 
replyname1=
