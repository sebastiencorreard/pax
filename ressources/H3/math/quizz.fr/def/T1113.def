!set title=Question T1113 Ecriture décimale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,decimals
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp=!nonempty items 10,100,100

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval ($val9=10)
tmp=!nonempty items 2,5

tmp0=!randitem $tmp
val10=$[rint( $(tmp0))]
!else
tmp=!nonempty items 2,4,5

tmp1=!randitem $tmp
val10=$[rint($(tmp1))]
!endif
val11=$[rint($val9/$val10)]

!ifval ($val9=10)
tmp0=!randint 3, 7

val12=$[rint( $(tmp0))]
!else
tmp=!nonempty items 2,3,3,4,4

tmp1=!randitem $tmp
val12=$[rint($(tmp1))]
!endif
val13=$[($val11^$val12)*($val10^$val12)]
val14=L'écriture décimale de \($val11^$val12 \times $val10^$val12\) : 
val15=
val16=$[rint($val13)]
val9=$[rint($val10*$val11)]

!ifval ($val9>10)
val17= 100
!else
val17=10
!endif
!for val18 =2 to $val12 

!ifval ($val9>10)
val17= $val17,00
!else
val17=$val17,0
!endif
!next
tmp0=!replace internal , by in $val17

val17=$(tmp0)
val19=\($val11^$val12 \times $val10^$val12=$val9^$val12= $val17 \). 
val8=$[rint(15)]
val20=\begin{enumerate}
val20=$val20	    \item	    $val14	    \dots $val15	  
val20=$val20 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val19</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,14,15,19,20
embedcnt=1
