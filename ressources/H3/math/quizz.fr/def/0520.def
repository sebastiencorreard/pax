!set title=Question 0520 Tracer un segment
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=length,lines
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 4, 5

val8=$[rint($(tmp0))]
val9=$[$val8/2]
tmp0=!randint 1, 3

val10=$[rint($val8+$(tmp0))]
val11=\(\frac{$val10}{$val8}\)
val12=$[rint($val10)]
val13=JXG.Options.point.snapToGrid = true;	JXG.Options.point.snapSizeX = 1;	JXG.Options.elements.tabindex = -1;	const brd = JXG.JSXGraph.initBoard('id1', { boundingbox: [-2, 4, 18, -2],	  axis:false,	  grid:true,	  showCopyright : false,	  showNavigation:false,	  showZoom : false,	  keepaspectratio : true,	  zoom: {factorX: 1.25,factorY: 1.25,wheel: true,needShift: true,eps: 0.001},	  pan: {needShift: true,enabled: true,needTwoFingers: true,pinchHorizontal: true,pinchVertical: true,pinchSensitivity: 7}	   } );	brd.create('text', [$val9, 3, "1 unité"], {fontSize: 15, fixed:true,anchorX:'middle', cssClass:'mytext'});	let p1 = brd.create('point', [0,0],{name:'A',size:4,color:'green',fixed:true,face:'cross',showInfobox:false,label:{fixed:true,offset:[-15,-10]}});	let l1 = brd.create('segment',[[0,0],[18,0]],{strokeColor: 'transparent',highlight: false,fixed:true});	let l2 = brd.create('segment',[[0,2],[$val8,2]],{strokeColor: 'red',highlight: false,fixed:true});	let p2_rep1=brd.create('glider', [p2_var1,0,l1],{name:'B',tabindex:10,size:4,color:'green',fixed:false,showInfobox:false,layer: 15,label:{fixed:false,offset:[0,-10]}});	let seg=brd.create('segment',[p1,p2_rep1],{name:'s',strokeColor: 'green',strokeWidth: 2,highlight: false});	p2_var1=1;	
val14=Déplacer le point B pour tracer un segment [AB] de longueur $val11 unités.
val15=<div>	\embed{r1,400x200	id1 brd [responsive center min=250px max=400px scroll]	$val13	 }</div>
val16=Une unité vaut \($val8\) carreaux. Le segment doit donc mesurer \($val10\) carreaux.
replytype1=jsxgraph

replyoption1=noanalyzeprint 
replyname1=Construction
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	$val14	<div>	 
!read oef/embed.phtml r1,400x200	id1 brd [responsive center min=250px max=400px scroll]	$val13	 
$()	</div>	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,16
embedcnt=1
