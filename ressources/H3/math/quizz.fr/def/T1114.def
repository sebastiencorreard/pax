!set title=Question T1114 Côté d'un triangle rectangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,proportionality,velocity
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp=!nonempty items 3,4,5

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval $val9=3 
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val10=$[rint( $(tmp0) )]
!else
tmp=!nonempty items 2,4,5

tmp1=!randitem $tmp
val10=$[rint( $(tmp1))]
!endif
val11=$[rint($val9^2+$val10^2)]
val12=sqrt($val11)
val13=$val12
!readproc oef/draw.phtml 230,115 \
xrange -60,60	yrange -55,55	triangle -15,40,30,40,30,-37,black	segment 20,40,20,30,black	segment 20,30,30,30,black	text black,-20,45,medium,A	text black,35,45,medium,C	text black,35,-42,medium,B	text black,35,1,medium,$val10 cm	text black,5,55,medium,$val9 cm 
tmp0=$ins_url
val14=$(tmp0)
val14=<img src="$val14" alt="">
val15=<table><tr><td>$val14 </td><td> La valeur exacte de AB est : <br>AB = 
val16=\(cm\)</td></tr></table>
val17=Utiliser le théorème de Pythagore : \(AB=\sqrt{AC^2+BC^2}=\sqrt{$val10^2+$val9^2}=\sqrt{$val11}\)
val8=$[rint(8)]
val18=\begin{enumerate}
val18=$val18 \end{enumerate}
replytype1=formal
replyoption1=comma default=0 
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val15  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val16	  </div>	
$()
!exit

