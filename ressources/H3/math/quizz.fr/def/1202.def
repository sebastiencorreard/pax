!set title=Question 1202 Somme d'un entier et d'une fraction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,addition,subtraction,integers,fraction
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
tmp0=!randitem 3,4,6,7

val9=$[rint($(tmp0))]
tmp0=!randitem +,-

val10=$(tmp0)

!ifval $val10 issamecase +
tmp=!translate ";': to $     $ in $val8+1/$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val11=!exec pari print($t_)
!else
tmp=!translate ";': to $     $ in $val8-1/$val9

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp1)
val11=!exec pari print($t_)
!endif
t_=!rawmath $val11
val12=!exec pari print($t_)

!ifval $val10 issamecase +
val13=\($val8 + \frac{1}{$val9}={}\)
!else
val13=\($val8 - \frac{1}{$val9}={}\)
!endif
val14=
val15=$[rint($val8 * $val9)]
val16=Rappel : \($val8=\frac{$val8 \times $val9}{$val9}\) donc $val13 \(\frac{$val15 $val10 1}{$val9}={}\)	\($val11 \).
val17=\begin{enumerate}
val17=$val17	    \item	    $val13	    \dots $val14	  
val17=$val17 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,10	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,14,16,17
embedcnt=1
