!set title=Question T1109 Calcul de moyenne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=mental_calculation,methodical_calculation,mean
oefobservation=Course 1er Technologique. Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(10)]
tmp0=!randitem 80,100,100,120

val9=$[rint($(tmp0))]
tmp0=!randitem 20,40

val10=$[rint($(tmp0))]
val11=$[rint($val9-$val10)]
tmp0=!shuffle 3,4,2,1

val12=$(tmp0)
val13=$[rint($val10/2+$(val12[1]))]
val14=$[rint($val10/2-$(val12[1]))]
val15=$[rint($val11/2+$(val12[2]))]
val16=$[rint($val11/2-$(val12[2]))]
tmp=!trim $val13,$val15,$val14,$val16
val17=!translate internal $	\
$ to ;; in $tmp
val18=$[$val9/4]
val19=Moyenne des nombres : \($(val17[1])\) &#59; \($(val17[2])\) &#59; \($(val17[3])\) et \($(val17[4])\). Réponse : 
val20=
val21=Avant de faire la division par \(4\), il est efficace de regrouper les termes : \($(val17[1])+$(val17[3])=$val10\) et \($(val17[2])+$(val17[4])=$val11\)
val8=$[rint(6)]
val22=\begin{enumerate}
val22=$val22	    \item	    $val19	    \dots $val20	  
val22=$val22 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val19  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val20	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val22 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val21</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,19,20,21,22
embedcnt=1
