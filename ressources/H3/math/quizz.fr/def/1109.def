!set title=Question 1109 Calcul de moyenne 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,methodical_calculation,mean
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 80,100,100,120

val8=$[rint($(tmp0))]
tmp0=!randitem 20,40

val9=$[rint($(tmp0))]
val10=$[rint($val8-$val9)]
tmp0=!shuffle 3,4,2,1

val11=$(tmp0)
val12=$[rint($val9/2+$(val11[1]))]
val13=$[rint($val9/2-$(val11[1]))]
val14=$[rint($val10/2+$(val11[2]))]
val15=$[rint($val10/2-$(val11[2]))]
tmp=!trim $val12,$val14,$val13,$val15
val16=!translate internal $	\
$ to ;; in $tmp
val17=$[$val8/4]
val18=Moyenne des nombres : \($(val16[1])\) &#59; \($(val16[2])\) &#59; \($(val16[3])\) et \($(val16[4])\). Réponse : 
val19=
val20=Avant de faire la division par \(4\), il est efficace de regrouper les termes : \($(val16[1])+$(val16[3])=$val9\) et \($(val16[2])+$(val16[4])=$val10\)
val21=\begin{enumerate}
val21=$val21	    \item	    $val18	    \dots $val19	  
val21=$val21 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val18  
!read oef/embed.phtml r1,10	    autofocus 
$() $val19	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,18,19,20,21
embedcnt=1
