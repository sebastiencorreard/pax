!set title=Question 0718 Calcul de longueur 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=circle,length
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp=!nonempty items 3,4,5

tmp0=!randitem $tmp
val9=$[$(tmp0)]
tmp=!nonempty items 1.3,1.4,1.6,1.7

tmp0=!randitem $tmp
val10=$[$(tmp0)]
val11=$[$val9-$val10]
!readproc oef/draw.phtml 300,300 \
xrange 0,10	yrange -5,5	segment 2,0,4,0,black	text black,1.8,-0.1,medium,E	segment 2,4,4,0,black	text black,4.1,-0.1,medium,F	segment 2,0,2,4,black	text black,2,4.5,medium,G	text black,2.3,2.5,medium,I	circle 2,0,120,black	arrow2 1.5,0,1.5,4,10,black	text black,1.2,2.4,medium,$val9	arrow2 2,-0.5,4,-0.5,10,black	text black,2.8,-0.8,medium,$val10	segment 2.5,0,2.5,0.5,black	segment 2.5,0.5,2,0.5,black	 
tmp0=$ins_url
val12=$(tmp0)
val12=<div class="wimscenter"><img src="$val12" alt="figure"></div>
val13=La figure a été faite à main levée. <br><i> Le cercle est le cercle de centre \(E\) passant par \(F\). <br>\(I\) est sur le cercle.<br>\(I in [EG]\)</i> $val12 Complète \(GI={}\)
val14=
val15=$[$val11]
val16=\(GI+IE=$val9\) et \(IE\) est un rayon. Ainsi \(GI+$val10=$val9\).
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val14	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,13,14,16
embedcnt=1
