!set title=Question 0320 Lire l'heure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,clock
oefobservation=Le numéro de la question s'interprête comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4)
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 8, 11

val8=$[rint($(tmp0))]
val9=$[rint($val8-1)]
val10=$[rint($val9-1)]
tmp0=!randitem 15,-15,-15

val11=$[rint($(tmp0))]

!ifval $val11 <0 
val12= moins le 
!else
val12= et 
!endif
val13=$val8 heures $val12 quart

!ifval $val11=15
val14=$[rint(-15)]
!else
val14=$[rint(15)]
!endif
tmp=!trim $val8,$val11;$val8,$val14;$val9,$val11
val15=!translate internal $	\
$ to ;; in $tmp

!ifval $val11 <0 
val16= $val9 h 45 min
!else
val16=$val8 h $val11 min
!endif

!ifval $val14 <0
tmp0=!append item $val9 h 45 min to $val16

val16= $(tmp0)
!else
tmp1=!append item $val8 h $val14 min to $val16

val16=$(tmp1)
!endif

!ifval $val11 <0
tmp0=!append item $val10 h 45 min to $val16

val16= $(tmp0)
!else
tmp1=!append item $val9 h $val11 min to $val16

val16=$(tmp1)
!endif
tmp0=!shuffle 3

val17=$(tmp0)
!readproc slib/draw/clock $(val15[$(val17[1]);1]):$(val15[$(val17[1]);2]):00,120,1,html 
tmp0=$slib_out
val18=$(tmp0)
!readproc slib/draw/clock $(val15[$(val17[2]);1]):$(val15[$(val17[2]);2]):00,120,1,html 
tmp0=$slib_out
val19=$(tmp0)
!readproc slib/draw/clock $(val15[$(val17[3]);1]):$(val15[$(val17[3]);2]):00,120,1,html 
tmp0=$slib_out
val20=$(tmp0)
tmp0=!positionof item 1 in $val17

val21=$[rint($(tmp0))]
val22=$[rint(($val21 +1)%3)]
val22=Figure $val22
val23=Figure 1 : $val18 Figure 2 : $val19 Figure 3 : $val20<br>Quelle pendule indique $val13.
val24=
val25=Les réponses : <br> $(val16[$(val17[1])]) : $val18 <br>$(val16[$(val17[2])]) : $val19 <br>$(val16[$(val17[3])]) : $val20
replytype1=menu
replyoption1=default=$val22 
replyname1=
replygood1=$val21;Figure 1,Figure 2, Figure 3
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val23  
!read oef/embed.phtml r1,10	    autofocus 
$() $val24</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1 and $val25!=
 <div class='oef_feedbacks'>	  <style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val25</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,23,24,25
embedcnt=1
