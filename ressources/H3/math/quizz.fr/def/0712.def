!set title=Question 0712 Minutes en heures 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=time
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong>	<br><u>Aide à la saisie :</u> saisir 3/4 pour \(3/4) et de préférence saisir 1.3 pour 1,3. 
val7=Félicitations toutes les réponses sont justes !
val8=$[rint(6)]
tmp0=!randint 2, 7

val9=$[rint($(tmp0))]
val10=$[rint($val9*60)]
tmp0=!randint 12, 56

val11=$[rint($(tmp0))]
val12=$[rint($val9*60+$val11)]
val13=Complète. <br>$val12 min \({}={}\) 
val14=h
val15=min
val16=$[rint($val9)]
val17=$[rint($val11)]
val18=1 h = 60 min, 2 h = 120 min, 3 h = 180min, ... 
val19=\begin{enumerate}
val19=$val19	    \item	    $val13	    \dots $val14	  
val19=$val19 \end{enumerate}
replytype1=numeric
replyoption1=comma default=0 
replyname1=
replygood1=$[$val16]
replytype2=numeric
replyoption2=comma default=0 
replyname2=
replygood2=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val13  
!read oef/embed.phtml r1,$val8	    autofocus 
$() $val14	 
!read oef/embed.phtml r2,$val8 
$() $val15	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val18</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,13,14,15,18,19
embedcnt=2
