!set title=Question 0828 Théorème de Pythagore
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=mental_calculation,length,squareroot,triangles,angles
oefobservation=Le numéro de la question s'interprète comme suit : <br>Question XXYY est la question YY du niveau XX

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<ul class="wims_nopuce"><li><img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" ><strong>La calculatrice n'est pas autorisée, ni le brouillon.</strong></li>	<li><u>Aide à la saisie : </u>saisir 1.25 pour 1,25, saisir 3/4 pour \(3/4\), saisir 2^3 pour \(2^3) et saisir sqrt(3) pour \(\sqrt{ 3}\).</li></ul>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 10,9

val8=$[rint($(tmp0))]
tmp0=!randitem 2,3,5,6,7,8

val9=$[rint($(tmp0))]
val10=$[rint($val8^2-$val9^2)]

!ifval ceil(sqrt($val10))=sqrt($val10)
tmp=!translate ";': to $     $ in sqrt($val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
!else
val11=sqrt($val10)
!endif
val12=$val11
!readproc oef/draw.phtml 240,200 \
xrange 0,60	yrange 0,50	triangle 10,20,40,10,48.29,34.87,black	segment 33.61,12.13,35.46,17.68,black	segment 35.46,17.68,41.85,15.55,black	text black,8,20,medium,A	text black,50,37,medium,C	text black,40,8,medium,B	text black,24,33,medium,$val8 cm	text black,20,13,medium,$val9 cm  
tmp0=$ins_url
val13=$(tmp0)
val13=<img src="$val13" alt="">
val14=$val13<br> La valeur exacte de BC est &#58; 
val15=\(cm\)
val16=Par le théorème de Pythagore \(BC^2=\AC^2-AB^2=$val10\) 
replytype1=algexp
replyoption1=comma default=0 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val6!= 
$()	<div class="wims_instruction">$val6</div>	 
!endif
$()	<div class="wims_question">	  $val14  
!read oef/embed.phtml r1,10	    autofocus 
$() $val15</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'><style>.feedmutu {	    border: 1px solid;	    border-radius: 5px;	    padding: .5em;}	</style>	  <div class="feedmutu">$val16</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,15,16
embedcnt=1
