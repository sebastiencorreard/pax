\text{human=randitem(\name_human)}
\text{n=randint(40,50,60,70)}
\text{a=slib(stat/random \n,0,30)}
\text{a=wims(declosing \a)}
\text{tableau= <table class="wimscenter wimsborder" style="background-color:skyblue">}
\for{i=0 to ceil(\n/10)-1}{
\text{tableau= \tableau <tr>}
  \for{j=1 to 10}{
	\if{10*\i+\j <=\n }{\real{u=item(10*\i+\j, \a)+160}
\text{tableau= \tableau <td> \u </td>}
	}{\text{tableau= \tableau <td></td>}
	}
}
\text{tableau= \tableau </tr>}
}
\text{liste=[0,5,10,15,20,25,30]}
\text{liste2=[160,165,170,175,180,185,190]}
\text{tableau=\tableau</table>}
text{d=slib(stat/freq [\a],\liste)}
\text{c=slib(stat/effectif [\a],\liste)}
\text{c=item(1,\c)}
\text{b=pari(print(\c/\n))}
\text{c=wims(declosing \c)}
\text{b=wims(declosing \b)}
\real{freq1=ceil(item(1,\b)*1000)/10}
\real{freq2=ceil(item(2,\b)*1000)/10}
\real{freq3=ceil(item(3,\b)*1000)/10}
\real{freq4=ceil(item(4,\b)*1000)/10}
\real{freq5=ceil(item(5,\b)*1000)/10}
\real{freq6=ceil(item(6,\b)*1000)/10}
\text{eff1=item(1,\c)}
\text{eff2=item(2,\c)}
\text{eff3=item(3,\c)}
\text{eff4=item(4,\c)}
\text{eff5=item(5,\c)}
\text{eff6=item(6,\c)}
