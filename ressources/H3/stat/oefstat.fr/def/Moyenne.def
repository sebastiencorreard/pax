!set title=Moyenne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=xiao@unice.fr
author=XIAO Dingyu
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Gemiddelden

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=a eu XXXX de moyenne au premier trimestre, YYYY de	moyenne au deuxième trimestre et ZZZZ de moyenne au troisième	trimestre. Quelle est sa moyenne annuelle (arrondie au premier	chiffre après la virgule)&nbsp;
val8=Moyenne annuelle
!if $val6=nl 
val7=heeft voor een eerste proefwerk het cijfer XXXX gehaald,	  Voor een tweede proefwerk behaalde een YYYY.	  Voor een derde proefwerk haalde het cijfer.	  Wat is NNNN's gemiddelde cijfer?	  Rond je uitkomst af op 1 cijfer achter de komma	
val8=Moyenne annuelle
!endif
!readproc slib/lang/fname $val6 boy 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!randint 50, 150

val10=$[rint($(tmp0))]
val11=$[rint(20)]
val12=$[rint($val10-$val11)]
val13=$[rint($val10+$val11)]
tmp0=!randint $val12, $val13

val14=$[$(tmp0)/10]
tmp0=!randint $val12, $val13

val15=$[$(tmp0)/10]
tmp0=!randint $val12, $val13

val16=$[$(tmp0)/10]
val17=$[rint(10*($val14+$val15+$val16)/3)/10]
tmp0=!replace internal XXXX by $val14 in $val7

val18=$(tmp0)
tmp0=!replace internal YYYY by $val15 in $val18

val18=$(tmp0)
tmp0=!replace internal ZZZZ by $val16 in $val18

val18=$(tmp0)
tmp0=!replace internal NNNN by $val9 in $val18

val18=$(tmp0)
replytype1=default
replyname1=$val8
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9 $val18?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,18
embedcnt=0
