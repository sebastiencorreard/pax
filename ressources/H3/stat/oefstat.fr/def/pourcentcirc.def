!set title=Diagramme circulaire et pourcentages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Cirkeldiagram en percentages

ansorder=r
varcnt=43
prevarcnt=42
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=rouge, bleu,orange,gris, vert, violet
val8=Effectifs
val9=Voici la représentation graphique (diagramme circulaire) de,	  caractères sur une population de,individus&nbsp;
val10=Quel est le pourcentage des individus possédant le caractère
val11=Pourcentage
!if $val6=nl 
val7=rood, blauw,oranje,grijs, groen, paar
val8=Aantallen
val9=Hieronder zie je een cirkeldiagram die een populatie van,	  individuen met,eigenschappen weergeeft
val10=Bereken het percentage individuen met	  de eigenschap weergegeven door de kleur
val11=Percentage
!endif
tmp0=!randint 4, 6

val12=$(tmp0)
val13=100
!for val14 =1 to $val12-1 
tmp0=!randint 8, 20

val15=$(tmp0)
!if $val14=1 
val16=$val15
!else
val16=$val16,$val15
!endif
val13=$[$val13-$val15]
!next
val16=$val16,$val13
tmp0=!shuffle 6

val17=$(tmp0)
val18=red,skyblue,orange,grey,green,purple
val19=A,B,C,D,E,F
tmp0=!randint 1, $val12

val20=$(tmp0)
tmp0=!item $val20 of $val17

tmp1=!item $(tmp0) of  $val7

val21=$(tmp1)
tmp0=!item $val20 of $val17

tmp1=!item $(tmp0) of  $val19

val22=$(tmp1)
tmp0=!randint 10, 30

val23=$[rint($(tmp0)*100)]
tmp0=!item $val20 of $val16

val24=$[round($(tmp0)/100*$val23)]
val25=ellipse 0,0,2,2,black	segment 0,0,1,0,black
val26=0
tmp0=!randint 1, $val12

val20=$(tmp0)
!for val14 =1 to $val12 
tmp0=!item $val14 of $val16

val27=$[$(tmp0)*2*pi/100]
val28=$[$val26+$val27/2]
tmp0=!item $val14 of $val17

tmp1=!item $(tmp0) of $val18

val21=$(tmp1)
tmp0=!item $val14 of $val17

tmp1=!item $(tmp0) of  $val19

val22=$(tmp1)
val26=$[$val26+$val27]
val25=$val25	segment 0,0,cos($val26),sin($val26),black	fill cos($val28)/2,sin($val28)/2, $val21	text black, 1.2*cos($val28),1.2*sin($val28),medium, $val22
!if $val14 = $val20 
!else
tmp0=!item $val14 of $val16

val25=$val25	text black, 2*cos($val28)/3,2*sin($val28)/3, medium, $(tmp0)%	
!endif
!next
tmp0=!item $val20 of $val17

tmp1=!item $(tmp0) of  $val7

val21=$(tmp1)
tmp0=!randint 10, 30

val23=$[rint($(tmp0)*100)]
tmp0=!item $val20 of $val16

val24=$[$(tmp0)]
tmp0=!item $val20 of $val17

tmp1=!item $(tmp0) of  $val19

val22=$(tmp1)
replytype1=numeric
replyname1=$val11
replygood1=$[$val24]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val9[1]) $val12 $(val9[2]) $val23 $(val9[3]):	<div class="wimscenter">	  
!read oef/draw.phtml 200,200 \
xrange -1.5,1.5	yrange -1.5,1.5	$val25 
$()	</div>	$val10	$val21 ($val22) ? 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,12,21,22,23,25
embedcnt=0
