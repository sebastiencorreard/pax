!set title=Moyenne pondérée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
title_nl=gemiddelde

ansorder=r,r,r,r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer pour cette série statistique,	  la moyenne,la valeur maximale,la valeur minimale,	  l'étendue statistique
val8=Moyenne,Maximum,Minimum,Etendue
val9=L'étendue statistique est égale au maximum moins le minimum.
val10=Valeurs, Coeff.
val11=Soit la série statistique suivante pondérée par des coefficients
!if $val6=nl 
val7=Bereken van deze statistische reeks,	  het gemiddelde,de maximale waarde,de minimale waarde,	  de spreidingsbreedte
val8=Gemiddelde,Maximum,Minimum,Spreidingsbreedte
val9=De spreidingsbreedte is het maximum - het minimum.
val10=Waarden, Coeff.
val11=Zie hier een statistische reeks met bijbehorende coefficienten
!endif

!ifval $val2=
tmp0=!randint 6, 9

val12=$[rint( $(tmp0))]
!endif

!ifval $val2=1
tmp0=!randint 4, 6

val12=$[rint( $(tmp0))]
!endif

!ifval $val2=2
tmp0=!randint 7, 8

val12=$[rint( $(tmp0))]
!endif

!ifval $val2=3
tmp0=!randint 9, 12

val12=$[rint( $(tmp0))]
!endif
tmp0=!randint 20, 30

val13=$[$(tmp0)]
!readproc slib/stat/random $val12-1, 0,$val13 
tmp0=$slib_out
val14=$(tmp0)
!readproc slib/stat/random $val12-1,1,4 
tmp0=$slib_out
val15=$(tmp0)
!readproc slib/stat/arithmean [$val14],[$val15] 
tmp0=$slib_out
tmp1=!item 1 of $(tmp0)

val16=$(tmp1)
tmp0=!sort numeric item $val14

val17=$(tmp0)
tmp0=!item -1 of $val17

val18=$(tmp0)
tmp0=!item 1 of $val17

val19=$(tmp0)
val20=$[$val18-$val19]
val21=<th>$(val10[1])</th>
val22=<th>$(val10[2])</th>
!for val23 =1 to $val12-1 
tmp0=!item $val23 of $val14

val24=$(tmp0)
tmp0=!item $val23 of $val15

val25=$(tmp0)
val21=$val21<td>$val24</td>
val22=$val22<td>$val25</td>
!next
replytype1=numeric
replyname1=$(val8[1])
replygood1=$[$val16]
replytype2=numeric
replyname2=$(val8[2])
replygood2=$[$val18]
replytype3=numeric
replyname3=$(val8[3])
replygood3=$[$val19]
replytype4=numeric
replyname4=$(val8[4])
replygood4=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11:	 <table class="wimscenter wimsborder">	  <tr>$val21</tr>	  <tr>$val22</tr>	  </table>	<div class="wims_question">	$(val7[1])	<ul><li><label for="reply1">$(val7[2]):</label>  
!read oef/embed.phtml reply 1, 6 
$()	</li><li>	  <label for="reply2">$(val7[3]):</label>  
!read oef/embed.phtml reply 2, 6 
$()	</li><li>	  <label for="reply3">$(val7[4]):</label>  
!read oef/embed.phtml reply 3, 6 
$()	</li><li>	  <label for="reply4">$(val7[5]):</label>  
!read oef/embed.phtml reply 4, 6 
$()	</li></ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply4-$m_reply2+$m_reply3 !=0
 <div class='oef_feedbacks'>	 <span class="oef_indbad">	 $val9	 </span>	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,9,11,21,22
embedcnt=4
