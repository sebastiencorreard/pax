replyname4=$(val8[3])
replygood4=$[$val18]
replytype5=numeric
replyname5=$(val8[3])
replygood5=$[$val19]
replytype6=numeric
replyname6=$(val8[4])
replygood6=$[$val20]
replytype7=numeric
replyname7=$(val8[4])
replygood7=$[$val21]
replytype8=numeric
replyname8=$(val8[4])
replygood8=$[$val22]
replytype9=numeric
replyname9=$(val8[4])
replygood9=$[$val23]
replytype10=numeric
replyname10=$(val8[4])
