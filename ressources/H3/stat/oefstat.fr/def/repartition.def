!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compléter le tableau ci-dessous qui	  représente la répartition des notes obtenues par,	  élèves.
val8=Classe des notes,Effectif,Effectif cumulé, Fréquence
val9=On donnera le résultat pour les	  fréquences en approchant les valeurs à une décimale par défaut.
