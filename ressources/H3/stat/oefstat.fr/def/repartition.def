val14=$[rint($(tmp0))]
val15=$[rint($val10)]
val16=$[rint($val15+$val11)]
val17=$[rint($val15+$val11+$val12)]
val18=$[rint($val15+$val11+$val12+$val13)]
val19=$[rint($val15+$val11+$val12+$val13+$val14)]
val20=$[floor(1000*$val10/$val19)/10]
val21=$[floor(1000*$val11/$val19)/10]
val22=$[floor(1000*$val12/$val19)/10]
val23=$[floor(1000*$val13/$val19)/10]
val24=$[floor(1000*$val14/$val19)/10]
