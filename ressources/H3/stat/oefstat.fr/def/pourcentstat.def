!set title=Statistique et pourcentages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Cirkeldiagram en aantallen

ansorder=r
varcnt=39
prevarcnt=38
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=rouge, bleu,orange,gris, vert, violet
val8=Effectifs
val9=Voici la représentation graphique (diagramme circulaire) de,	  caractères sur une population de,individus&nbsp;
val10=Donner le nombre d'individus possédant le caractère
val11=On arrondira à l'entier le plus proche.
val12=Nombre d'individus
!if $val6=nl 
val7=rood, blauw,oranje,grijs, groen, paar
val8=Aantallen
val9=Hieronder zie je een cirkeldiagram die een populatie van,	  individuen met,eigenschappen weergeeft
val10=Geef het aantal individuen voorgesteld door de kleur 
val11=rond je getal af op "helen"
val12=Aantal individuen
!endif
tmp0=!randint 4, 6

val13=$(tmp0)
val14=100
!for val15 =1 to $val13-1 
tmp0=!randint 8, 20

val16=$(tmp0)
!if $val15=1 
val17=$val16
!else
val17=$val17,$val16
!endif
val14=$[$val14-$val16]
!next
val17=$val17,$val14
tmp0=!shuffle 6

val18=$(tmp0)
val19=red,skyblue,orange,grey,green,purple
val20=A,B,C,D,E,F
val21=ellipse 0,0,2,2,black	segment 0,0,1,0,black
val22=0
!for val15 =1 to $val13 
tmp0=!item $val15 of $val17

val23=$[$(tmp0)*2*pi/100]
val24=$[$val22+$val23/2]
tmp0=!item $val15 of $val18

tmp1=!item $(tmp0) of $val19

val25=$(tmp1)
tmp0=!item $val15 of $val18

tmp1=!item $(tmp0) of  $val20

val26=$(tmp1)
val22=$[$val22+$val23]
tmp0=!item $val15 of $val17

val21=$val21	segment 0,0,cos($val22),sin($val22),black	fill cos($val24)/2,sin($val24)/2, $val25	text black, 1.2*cos($val24),1.2*sin($val24),medium, $val26	text black, 2*cos($val24)/3,2*sin($val24)/3, medium, $(tmp0)%	
!next
tmp0=!randint 1, $val13

val27=$(tmp0)
tmp0=!item $val27 of $val18

tmp1=!item $(tmp0) of  $val7

val25=$(tmp1)
tmp0=!item $val27 of $val18

tmp1=!item $(tmp0) of  $val20

val26=$(tmp1)
tmp0=!randint 10, 30

val28=$[rint($(tmp0)*100)]
tmp0=!item $val27 of $val17

val29=$[round($(tmp0)/100*$val28)]
replytype1=numeric
replyname1=$val12
replygood1=$[$val29]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val9[1]) $val13 $(val9[2]) $val28 $(val9[3]):	<div class="wimscenter">	  
!read oef/draw.phtml 200,200 \
xrange -1.5,1.5	yrange -1.5,1.5	$val21 
$()	</div>	<div class="wims_question">	 $val10 $val25 ($val26).	</div>	<div class="wims_instruction">$val11</div> 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,13,21,25,26,28
embedcnt=0
