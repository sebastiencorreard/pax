!if $wims_read_parm!=slib_header
 !goto proc
!endif
slib_title=histo d'une serie statistique
slib_parms=liste\
,liste des coordonnees des points a tracer

slib_author=Fabrice Guerimand
slib_out=Les données pour insdraw</li></ol>
!exit


:proc
slib_input=!item 4 to -1 of $wims_read_parm
s_nb=!itemcnt $slib_input
s_nb=$[$s_nb/2]
s_xmax=-10000
s_ymax=-10000
s_color=!randitem red,blue,green
s_dessin=$empty
s_t3=!item 3 of $wims_read_parm
!for s_k=1 to $s_nb
 s_tmpx=!item $s_k*2-1 of $slib_input
 s_xmax=$[max($s_xmax,$(s_tmpx))]
 s_tmpy=!item $s_k*2 of $slib_input
 s_ymax=$[max($s_ymax,$(s_tmpy))]
 s_tmp=segment $s_tmpx,$s_t3,$s_tmpx,$s_tmpy,$s_color
 s_dessin=!append line $s_tmp to $s_dessin
!next k
s_xmax=$[$s_xmax+1]
s_ymax=$[$s_ymax+1]
s_t1=!item 1 of $wims_read_parm
s_t2=!item 2 of $wims_read_parm
slib_out=range -1,$s_xmax,$s_t3-2,$s_ymax+1\
parallel 0,$s_t3,$s_xmax,$s_t3,0,1,$s_ymax-$s_t3,grey\
parallel 0,$s_t3,0,$s_ymax,1,0,$s_xmax,grey\
linewidth 2\
parallel 0,-0.1+$s_t3,0,0.1+$s_t3,1,0,$s_xmax,black\
parallel -0.1,$s_t3,0.1,$s_t3,0,1,$s_ymax-$s_t3,black\
arrow -1,$s_t3,$s_xmax,$s_t3,15,black\
arrow 0,-1+$s_t3,0,$s_ymax,15,black\
text black,2,$s_t3-0.6,medium,$s_t1\
text black,1,$s_ymax-0.5,medium,$s_t2\
linewidth 3\
$s_dessin



