!set title=Centre de classe 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 5

val6=$[rint($(tmp0))]
tmp0=!randint -9, -7

val7=$[rint($(tmp0))]
tmp0=!randint 4, 5

val8=$[rint($(tmp0))]
val9=
val10=
tmp0=!randint 110, 150

val11=$[rint($(tmp0))]
!readproc slib/generator $val8,$val11 
tmp0=$slib_out
val12=$(tmp0)
!for val13 =1 to $val8 
val14=$[rint($val7+($val13-1)*$val6)]
val15=$[rint($val7+$val13*$val6)]
tmp0=!append item \($val14 \leq T < $val15) to $val9

val9=$(tmp0)
val16=$[($val14+$val15)/2]
tmp0=!append item $val16 to $val10

val10=$(tmp0)
!next
tmp0=!item 1 to $val8 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val17=$(tmp0)
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=numexp
replyname1=1
replygood1=$(val10[1])
replytype2=numexp
replyname2=2
replygood2=$(val10[2])
replytype3=numexp
replyname3=3
replygood3=$(val10[3])
replytype4=numexp
replyname4=4
replygood4=$(val10[4])
replytype5=numexp
replyname5=5
replygood5=$(val10[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Une station de météo a relevé les températures durant une période et les a reportées	dans le tableau ci-dessous :	  <table class="wimscenter wimsborder">	   <tr>	    <th>Températures (T)</th>	    <th>Nombres de jours</th>	    <th>Centre de classe</th>	   </tr>	    
!for m_l=1 to $val8 
$()	    <tr>	     <td>$(val9[$m_l])</td>	     <td>$(val12[$m_l])</td>	     <td> 
!read oef/embed.phtml $(val17[$m_l]),5 
$()</td>	    </tr>	    
!next
$()	  </table>	Calculer le centre des classes.
$()
!exit

