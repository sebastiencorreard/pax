!set title=Fréquences 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,3

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!record $val6 of src/stat2.don

val7=$(tmp0)
tmp=!translate internal $	$ to ; in $val7

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!randint 2, 5

val9=$[rint($(tmp0)*100)]
val10=$[rint(1)]
val11=$[rint(4)]
tmp=!translate internal $	$ to ; in $val7

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val7

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!values v for v=$val10 to $val11

val14=$(tmp0)
val15=$[rint($val11-$val10+1)]
val16=
!readproc slib/generator $val15,100 
tmp0=$slib_out
val17=$(tmp0)
val18=
!for val19 =1 to $val15 
val8=$[rint($(val17[$val19])*$val9/100)]
tmp0=!append item $val8 to $val18

val18=$(tmp0)
!next
val20=r1,r2,r3,r4
replytype1=numexp
replyname1=1
replygood1=$(val17[1])
replytype2=numexp
replyname2=2
replygood2=$(val17[2])
replytype3=numexp
replyname3=3
replygood3=$(val17[3])
replytype4=numexp
replyname4=4
replygood4=$(val17[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12.<br>	$val16	<p>Calculer les fréquences.</p>	  <table class="wimscenter wimsborder">	   <tr>	    <th>$val13</th>	     
!for m_l=1 to $val15 
$()<td>$(val14[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Effectifs</th>	     
!for m_l=1 to $val15 
$()<td>$(val18[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Fréquences</th>	     
!for m_l=1 to $val15 
$()<td> 
!read oef/embed.phtml $(val20[$m_l]),5 
$()%</td> 
!next
$()	   </tr>	  </table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,14,15,16,18,20
embedcnt=1
