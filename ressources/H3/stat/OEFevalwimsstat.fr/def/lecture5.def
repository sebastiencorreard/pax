!set title=Tableau d'effectifs 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 4

val6=$[rint($(tmp0))]
val7=$val6
val6=$[rint($val6+1)]
val8=$[rint(100)]
!readproc slib/generator $val6,$val8 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!randint 7, 30

val10=$[rint($(tmp0)*100)]
val11=
!for val12 =1 to $val6 
val13=$[rint($(val9[$val12])*$val10/100)]
tmp0=!append item $val13 to $val11

val11=$(tmp0)
!next
tmp0=!item 1 to $val6 of r1,r2,r3,r4,r5

val14=$(tmp0)
oefsteps=$val14 
nextstep=!nosubst $val14 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Effectif 1
replygood1=$(val11[1])
replytype2=numexp
replyname2=Effectif 2
replygood2=$(val11[2])
replytype3=numexp
replyname3=Effectif 3
replygood3=$(val11[3])
replytype4=numexp
replyname4=Effectif 4
replygood4=$(val11[4])
replytype5=numexp
replyname5=Effectif 5
replygood5=$(val11[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici les résultats d'une enquête portant sur $val10 foyers afin de déterminer le nombre de télévisions possédées par chaque famille.<br>	Les résultats sont exprimés en pourcentage, retrouver les effectifs.	<table class="wimscenter wimsborder">	   <tr>	    <th>Nombre de télévisions</th>	     
!for m_l=0 to $val6-1 
$()<td>$m_l</td> 
!next
$()	   </tr><tr>	    <th>Pourcentages</th>	     
!for m_l=1 to $val6 
$()<td>$(val9[$m_l]) %</td> 
!next
$()	   </tr><tr>	    <th>Effectifs</th>	     
!for m_l=1 to $val6 
$()<td> 
!read oef/embed.phtml $(val14[$m_l]),5 
$()</td> 
!next
$()	   </tr>	  </table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

