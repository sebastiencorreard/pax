!set title=Centre de classe 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randrecord src/stat3.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!randint $(val8[1]), $(val8[2])

val9=$[rint($(tmp0)*$val7)]
tmp0=!randint 3, 4

val10=$[rint($val9+$(tmp0)*$val7)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=$[rint(($val10-$val9+1)/$val7)]
val14=
val15=
!for val16 =1 to $val13 
val17=$[rint($val9+($val16-1)*$val7)]
val18=$[rint($val9+$val16*$val7)]
tmp0=!append item \($val17 \leq $val12 < $val18) to $val14

val14=$(tmp0)
val8=$[($val17+$val18)/2]
tmp0=!append item $val8 to $val15

val15=$(tmp0)
!next
tmp0=!item 1 to $val13 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val19=$(tmp0)
oefsteps=$val19 
nextstep=!nosubst $val19 
!readproc oef/steps.proc
replytype1=numexp
replyname1=1
replygood1=$(val15[1])
replytype2=numexp
replyname2=2
replygood2=$(val15[2])
replytype3=numexp
replyname3=3
replygood3=$(val15[3])
replytype4=numexp
replyname4=4
replygood4=$(val15[4])
replytype5=numexp
replyname5=5
replygood5=$(val15[5])
replytype6=numexp
replyname6=6
replygood6=$(val15[6])
replytype7=numexp
replyname7=7
replygood7=$(val15[7])
replytype8=numexp
replyname8=8
replygood8=$(val15[8])
replytype9=numexp
replyname9=9
replygood9=$(val15[9])
replytype10=numexp
replyname10=10
replygood10=$(val15[10])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer le centre des classes.	  <table class="wimscenter wimsborder">	   <tr>	    <th>$val11</th>	     
!for m_l=1 to $val13 
$()<td>$(val14[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Centres de classe</th>	     
!for m_l=1 to $val13 
$()<td> 
!read oef/embed.phtml $(val19[$m_l]),5 
$()</td> 
!next
$()	   </tr>	  </table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

