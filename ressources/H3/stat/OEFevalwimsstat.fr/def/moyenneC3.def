!set title=Moyenne C3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 5

val6=$[rint($(tmp0))]
tmp0=!randint -9, -7

val7=$[rint($(tmp0))]
tmp0=!randint 4, 5

val8=$[rint($(tmp0))]
val9=
val10=
val11=$[rint(0)]
tmp0=!randint 110, 150

val12=$[rint($(tmp0))]
!readproc slib/generator $val8,$val12 
tmp0=$slib_out
val13=$(tmp0)
!for val14 =1 to $val8 
val15=$[rint($val7+($val14-1)*$val6)]
val16=$[rint($val7+$val14*$val6)]
tmp0=!append item \($val15 \leq T < $val16) to $val9

val9=$(tmp0)
val17=$[($val15+$val16)/2]
tmp0=!append item $val17 to $val10

val10=$(tmp0)
val11=$[$val11+$val17*$(val13[$val14])]
!next
val11=$[rint($val11/$val12*10)/10]
tmp0=!item 1 to $val8 of r1,r2,r3,r4,r5

val18=$(tmp0)
oefsteps=$val18,r6 
nextstep=!nosubst $val18,r6 
!readproc oef/steps.proc
replytype1=numexp
replyname1=1
replygood1=$(val10[1])
replytype2=numexp
replyname2=2
replygood2=$(val10[2])
replytype3=numexp
replyname3=3
replygood3=$(val10[3])
replytype4=numexp
replyname4=4
replygood4=$(val10[4])
replytype5=numexp
replyname5=5
replygood5=$(val10[5])
replytype6=numexp
replyname6=Moyenne
replygood6=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Une station de météo a relevé les températures durant une période et	les a reportées dans le tableau ci-dessous :	  <table class="wimscenter wimsborder">	   <tr>	    <th>Températures (T)</th>	    <th>Nombre de jours</th>	    <th>Centre de classe</th>	   </tr>	    
!for m_l=1 to $val8 
$()	    <tr>	     <td>$(val9[$m_l])</td>	     <td>$(val13[$m_l])</td>	     <td> 
!read oef/embed.phtml $(val18[$m_l]),5 
$()</td>	    </tr>	    
!next
$()	  </table>		Calculer le centre des classes puis la température moyenne sur cette période.	<div class="spacer"><b>Votre réponse</b> :	La température moyenne est de  
!read oef/embed.phtml r6,6 
$() degrés.	</div>	<div class="wims_instruction">Vous donnerez l'arrondi au dixième.</div>
$()
!exit

