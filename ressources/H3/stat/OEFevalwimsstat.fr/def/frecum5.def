!set title=Fréquences cumulées 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 5

val6=$[rint($(tmp0))]
!readproc slib/generator $val6,100 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randrecord src/stat2.don

val8=$(tmp0)
tmp0=!randint 2, 5

val9=$[rint($(tmp0)*100)]
tmp=!translate internal $	$ to ; in $val8

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val11=$[rint(1)]
val12=$[rint($val11+$val6)]
tmp=!translate internal $	$ to ; in $val8

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
tmp0=!item $val15 of croissants,décroissants

val16=$(tmp0)
tmp0=!item $val15 of croissantes,décroissantes

val17=$(tmp0)
tmp0=!values v for v=$val11 to $val12

val18=$(tmp0)

!ifval $val15=1
val19=$[rint(0)]
!else
val19=$[rint(100)]
!endif

!ifval $val15=1
val20=+
!else
val20=-
!endif
val21=$val19
val22=$[rint($val19*$val9/100)]
!for val23 =1 to $val6 
val19=$[rint($val19$val20$(val7[$val23]))]
val10=$[rint($val19*$val9/100)]
val21=$val21,$val19
tmp0=!append item $val10 to $val22

val22=$(tmp0)
!next
tmp0=!item 1 to $val6 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val24=$(tmp0)
oefsteps=$val24 
nextstep=!nosubst $val24 
!readproc oef/steps.proc
replytype1=numexp
replyname1=1
replygood1=$(val21[1])
replytype2=numexp
replyname2=2
replygood2=$(val21[2])
replytype3=numexp
replyname3=3
replygood3=$(val21[3])
replytype4=numexp
replyname4=4
replygood4=$(val21[4])
replytype5=numexp
replyname5=5
replygood5=$(val21[5])
replytype6=numexp
replyname6=6
replygood6=$(val21[6])
replytype7=numexp
replyname7=7
replygood7=$(val21[7])
replytype8=numexp
replyname8=8
replygood8=$(val21[8])
replytype9=numexp
replyname9=9
replygood9=$(val21[9])
replytype10=numexp
replyname10=10
replygood10=$(val21[10])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13<br>	L'effectif total de la série statistique est de $val9.	<p>Calculer les fréquences cumulées $val17.</p>	  <table class="wimscenter wimsborder">	   <tr>	    <th>$val14</th>	     
!for m_l=1 to $val6 
$()<td>$(val18[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Effectifs cumulés $val16</th>	     
!for m_l=1 to $val6 
$()<td>$(val22[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Fréquences cumulées $val17</th>	     
!for m_l=1 to $val6 
$()<td> 
!read oef/embed.phtml $(val24[$m_l]),5 
$() %</td> 
!next
$()	   </tr>	  </table>	
$()
!exit

