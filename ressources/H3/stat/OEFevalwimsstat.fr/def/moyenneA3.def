!set title=Moyenne A3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 3, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1975, 1995

val8=$[rint($(tmp0))]
tmp0=!values v for v=$val8 to $val8+$val7-1

val8=$(tmp0)
val9=
val10=$[rint(0)]
!for val11 =1 to $val7 
tmp0=!randint 600, 800

val12=$[rint($(tmp0))]
tmp0=!append item $val12 to $val9

val9=$(tmp0)
val10=$[rint($val10+$val12)]
!next
val10=$[rint($val10/$val7)]
replytype1=numexp
replyname1=Moyenne
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici le nombre de voitures recyclées par une usine sur plusieurs années :	<table class="wimscenter wimsborder">	<tr>	 <th>Années</th>	 <th>Nombre de voitures</th>	</tr>	  
!for m_l=1 to $val7 
$()<tr><td>$(val8[$m_l])</td><td>$(val9[$m_l])</td></tr> 
!next
$()	</table>	Quel a été le nombre moyen de voitures recyclées durant ces $val7 années ?	<div class="wims_instruction">Vous arrondirez votre résultat à l'unité.</div>
$()
!exit

