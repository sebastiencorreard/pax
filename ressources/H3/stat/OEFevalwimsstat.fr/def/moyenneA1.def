!set title=Moyenne A1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items Mathématiques,Français,Histoire,Géographie,Anglais,Espagnol,Italien,SVT,Sciences Physiques

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!values v for v=1 to 20

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp=!nonempty items 4,5

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
tmp0=!item 1 to $val9 of $val8

val8=$(tmp0)
tmp0=!replace internal , by &nbsp;;&nbsp; in $val8

val10=$(tmp0)
tmp0=!replace internal , by + in $val8

val11=$[$(tmp0)]
val11=$[$val11/$val9]
replytype1=numexp
replyname1=Moyenne
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Les notes de $val6 en $val7 durant le premier trimestre sont les suivantes :	<div class="wimscenter">$val10</div>	Quelle est la moyenne de $val6 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10
embedcnt=0
