!set title=Centre de classe 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items m,M,T,t,N,S

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items 3,6,7

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint(2*$(tmp0)*$val7)]
tmp0=!values v for v=1 to $val7-1

val9=$(tmp0)
tmp=!nonempty items $val9

tmp0=!randitem $tmp
tmp1=!randint 3, 8

val9=$[rint($(tmp0)+$val7*$(tmp1))]
val10=$[rint($val9+$val8)]
val11=\(\frac{$val9}{$val7} \leq $val6 < \frac{$val10}{$val7})
tmp=!translate ";': to $     $ in ($val9+$val10)/(2*$val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=Réponse
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est la valeur centrale de la classe des nombres 
!insmath $val6
$() vérifiant :	<div class="wimscenter"> $val11 ?</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11
embedcnt=0
