!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randrecord src/stat.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!nonempty items 0,1

tmp0=!randitem $tmp
val13=$[rint($(val12[1])+$(tmp0))]
tmp=!nonempty items -1,0

tmp0=!randitem $tmp
val14=$[rint($(val12[2])+$(tmp0))]
tmp0=!values 0 for v=$val13 to $val14

val15=$(tmp0)
val16=
val9=$[rint($val14-$val13+1)]
!for val17 =1 to $val8 
tmp0=!randint $val13, $val14

val18=$[rint($(tmp0))]
tmp0=!append item $val18 to $val16

val16=$(tmp0)
val19=$[rint($val18-$val13+1)]
val7=$[rint($(val15[$val19])+1)]
tmp0=!replace item number $val19 by $val7 in $val15

val15=$(tmp0)
!next
tmp0=!replace internal , by &nbsp;;&nbsp; in $val16

val16=$(tmp0)
tmp0=!item 1 to $val9 of r1,r2,r3,r4,r5,r6,r7,r8

val20=$(tmp0)
oefsteps=$val20 
nextstep=!nosubst $val20 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Effectif 1
replygood1=$(val15[1])
