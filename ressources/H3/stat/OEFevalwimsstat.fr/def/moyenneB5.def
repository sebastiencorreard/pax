tmp0=!randint 10, 15

val9=$[rint($(tmp0))]
tmp0=!randint 3, 6

val10=$[rint($val9+$(tmp0))]
tmp0=!shuffle $val9,$val10

val11=$(tmp0)
val12=$[rint(($(val8[1])*$(val11[1])+$(val8[2])*$(val11[2]))/($(val8[1])+$(val8[2]))*10)/10]
replytype1=numexp
replyname1=Moyenne
replygood1=$val12
