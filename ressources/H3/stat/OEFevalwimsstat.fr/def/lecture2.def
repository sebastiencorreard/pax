!set title=Tableau d'effectifs 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randrecord src/stat.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
!readproc slib/generator $val9,$val8 
tmp0=$slib_out
val13=$(tmp0)
val14=Utiliser le graphique pour compléter le tableau ci-dessous
val15=
!for val16 =0 to $val9-1 
tmp0=!append item $val16,$(val13[$val16+1]) to $val15

val15=$(tmp0)
!next
!readproc slib/lgbrisee $val11,Effectifs,$val15 
tmp0=$slib_out
val17=$(tmp0)
!readproc oef/draw.phtml 300,300 \
$val17 
tmp0=$ins_url
val18=$(tmp0)
val18=<img src="$val18" alt="">
tmp0=!item 1 to $val9 of r1,r2,r3,r4,r5,r6,r7,r8

val19=$(tmp0)
oefsteps=$val19 
nextstep=!nosubst $val19 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Effectif 1
replygood1=$(val13[1])
replytype2=numexp
replyname2=Effectif 2
replygood2=$(val13[2])
replytype3=numexp
replyname3=Effectif 3
replygood3=$(val13[3])
replytype4=numexp
replyname4=Effectif 4
replygood4=$(val13[4])
replytype5=numexp
replyname5=Effectif 5
replygood5=$(val13[5])
replytype6=numexp
replyname6=Effectif 6
replygood6=$(val13[6])
replytype7=numexp
replyname7=Effectif 7
replygood7=$(val13[7])
replytype8=numexp
replyname8=Effectif 8
replygood8=$(val13[8])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val18</div>	 <div class="medium_size text_col">	$val10	<p>$val14.</p>	  <table class="wimscenter wimsnorder">	   <tr>	    <th>$val11</th>	     
!for m_l=0 to $val9-1 
$()<td>$m_l</td> 
!next
$()	   </tr><tr>	    <th>Effectifs</th>	     
!for m_l=1 to $val9 
$()<td> 
!read oef/embed.phtml $(val19[$m_l]),5 
$()</td> 
!next
$()	   </tr>	  </table>	   </div>	</div>	
$()
!exit

