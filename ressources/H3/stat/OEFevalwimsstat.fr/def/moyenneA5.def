!set title=Moyenne A5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 3, 5

val7=$[rint($(tmp0))]
val8=
val9=
val10=$[rint(0)]
!for val11 =1 to $val7 
tmp0=!randint 10, 40

val12=$[rint($(tmp0))]
tmp0=!append item $val12 to $val8

val8=$(tmp0)
tmp0=!randint 2, 4

val13=$[rint($(tmp0))]
tmp0=!append item $val13 to $val9

val9=$(tmp0)
val10=$[rint($val10+$val12+60*$val13)]
!next
val14=$[rint($val10/$val7)]
val15=$[rint(floor($val14/60))]
val14=$[rint($val14-60*$val15)]
replytype1=numexp
replyname1=Minute
replygood1=$val15
replytype2=numexp
replyname2=Seconde
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6 a écouté plusieurs chansons d'un album. On a reporté les durées de chaque chanson dans le tableau suivant :	<table class="wimscenter wimsborder">	<tr>	 <th>Chansons</th>	 <th>Temps</th>	</tr>	  
!for m_l=1 to $val7 
$()<tr><td>$m_l</td><td>$(val9[$m_l]) min $(val8[$m_l]) s</td></tr> 
!next
$()	</table>	<p>Quelle est la durée moyenne de ces chansons ?</p>	<div class="spacer">	<b>Votre réponse</b> :  
!read oef/embed.phtml r1,5 
$() min  
!read oef/embed.phtml r2,5 
$()s.	</div>		<div class="wims_instruction">Vous donnerez le résultat à la seconde près.</div>.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=2
