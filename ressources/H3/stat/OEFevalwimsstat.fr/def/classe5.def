val6=$[rint(500)]
val7=$[rint(3999)]
tmp0=!randint 25, 30

val8=$[rint($(tmp0))]
val9=$[rint(ceil($val7/500)-floor($val6/500))]
val10=
!for val11 =1 to $val8 
tmp0=!randint $val6/10, $val7/10

val12=$[rint($(tmp0)*10)]
tmp0=!append item $val12 to $val10

val10=$(tmp0)
!next
val13=$[rint(floor($val6/500)*500)]
val14=
!for val15 =1 to $val9 
val16=$[rint(floor($val6/500)*500+500*($val15-1))]
val17=$[rint($val16+500)]
tmp0=!append item &#91;$val16;$val17&#91; to $val14

val14=$(tmp0)
tmp0=!append item $val17 to $val13

val13=$(tmp0)
!next
!readproc slib/stat/effectif [$val10],[$val13] 
tmp0=$slib_out
val18=$(tmp0)
tmp0=!item 1 of $val18

val19=$(tmp0)
tmp0=!char 2 to -2 of $val19

val19=$(tmp0)
tmp0=!item 1 to $val9 of r1,r2,r3,r4,r5,r6,r7,r8,r9

val20=$(tmp0)
