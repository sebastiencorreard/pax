tmp0=!randrecord src/stat3.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val10=$[rint($(tmp0)*$val9)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val11=$[rint($(tmp0)*$val9)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=Calculer les effectifs cumulés décroissants.
val16=$[rint(($val11-$val10+1)/$val9)]
val17=
!for val18 =1 to $val16 
val19=$[rint($val10+($val18-1)*$val9)]
val20=$[rint($val10+$val18*$val9)]
tmp0=!append item \($val19 \leq $val14 < $val20) to $val17

val17=$(tmp0)
!next
val21=$[rint(2)]
val22=$[rint(1)]
!readproc slib/generator $val16,$val8 
tmp0=$slib_out
val23=$(tmp0)
tmp0=!item $val21 of Effectifs cumulés croissants,Effectifs cumulés décroissants

val24=$(tmp0)

!ifval $val21=1
val25=$[rint(0)]
!else
val25=$[rint($val8)]
!endif

!ifval $val21=1
val26=+
!else
val26=-
!endif
val27=$val25
!for val28 =1 to $val16 
val25=$[rint($val25$val26$(val23[$val28]))]
val27=$val27,$val25
!next

!ifval $val21=1
tmp0=!item 2 to -1 of $val27

val27=$(tmp0)
!endif
tmp0=!item 1 to $val16 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val29=$(tmp0)
oefsteps=$val29 
nextstep=!nosubst $val29 
!readproc oef/steps.proc
