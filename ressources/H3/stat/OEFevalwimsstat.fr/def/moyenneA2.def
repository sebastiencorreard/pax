!set title=Moyenne A2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!values -v,v for v=1 to 7

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!randint 5, 7

val8=$[rint($(tmp0))]
tmp0=!item 1 to $val8 of $val7

val7=$(tmp0)
tmp0=!replace internal , by &nbsp;;&nbsp; in $val7

val9=$(tmp0)
tmp0=!replace internal , by + in $val7

val10=$[$(tmp0)]
val10=$[rint($val10/$val8*10)/10]
replytype1=numexp
replyname1=Moyenne
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Les températures suivantes sont celles relevées par $val6 pendant $val8 jours consécutifs :	<div class="wimscenter"> $val9 </div>	Quelle a été la température moyenne durant ces $val8 jours ?		<div class="wims_instruction">Vous arrondirez votre résultat au dixième.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9
embedcnt=0
