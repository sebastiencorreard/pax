!set title=Moyenne B1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items Anglais,Espagnol,Italien,Allemand

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!values v for v=1 to 20

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!item 1 to 3 of $val8

val9=$(tmp0)
tmp0=!shuffle 2,3

val10=$(tmp0),1
val11=$[rint(($(val10[1])*$(val9[1])+$(val10[2])*$(val9[2])+$(val10[3])*$(val9[3]))/6*10)/10]
tmp=!nonempty items premier,deuxième,troisième

tmp0=!randitem $tmp
val12=$(tmp0)
replytype1=numexp
replyname1=Moyenne
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Les notes de $val6 en $val7 durant le $val12 trimestre sont les suivantes :	<div class="wimscenter"> Ecrit : $(val9[1]) ; Oral : $(val9[2]) ; Devoir maison : $(val9[3]) </div>	Le professeur calcule la moyenne en utilisant des coefficients $(val10[1]) pour l'écrit, $(val10[2]) pour l'oral et $(val10[3]) pour les devoirs à la maison.<br>	Quelle est la moyenne de $val6 ?		<div class="wims_instruction">Arrondir le résultat au dixième.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10,12
embedcnt=0
