!set title=Centre de classe 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items m,M,T,t,N,S

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randint 10, 20

val7=$[rint($(tmp0)*10)]
tmp0=!randint 3, 5

val8=$[rint($val7+20*$(tmp0))]
val9=$val6 est compris entre $val7 et $val8
val10=$[($val7+$val8)/2]
replytype1=numexp
replyoption1=noreduction 
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est la valeur centrale de la classe des nombres 
!insmath $val6
$() vérifiant :	<div class="wimscenter"> $val9 ?</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9
embedcnt=0
