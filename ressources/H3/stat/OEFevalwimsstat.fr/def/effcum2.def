replygood8=$(val22[8])
replytype9=numexp
replyname9=9
replygood9=$(val22[9])
replytype10=numexp
replyname10=10
replygood10=$(val22[10])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

