val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randrecord src/stat2.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=Calculer les effectifs cumulés décroissants.
tmp0=!values v for v=$val9 to $val10

val14=$(tmp0)
val15=$[rint(2)]
val16=$[rint($val10-$val9+1)]
val17=$[rint(0)]
!readproc slib/generator $val16,$val8 
tmp0=$slib_out
val18=$(tmp0)
tmp0=!item $val15 of Effectifs cumulés croissants,Effectifs cumulés décroissants

val19=$(tmp0)

!ifval $val15=1
val20=$[rint(0)]
!else
val20=$[rint($val8)]
!endif

!ifval $val15=1
val21=+
!else
val21=-
!endif
val22=$val20
!for val23 =1 to $val16 
val20=$[rint($val20$val21$(val18[$val23]))]
val22=$val22,$val20
!next

!ifval $val15=1
tmp0=!item 2 to -1 of $val22

val22=$(tmp0)
!endif
tmp0=!item 1 to $val16 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val24=$(tmp0)
oefsteps=$val24 
nextstep=!nosubst $val24 
!readproc oef/steps.proc
replytype1=numexp
replyname1=1
replygood1=$(val22[1])
