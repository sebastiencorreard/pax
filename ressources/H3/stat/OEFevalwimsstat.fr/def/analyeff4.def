tmp0=!randrecord src/stat3.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val10=$[rint($(tmp0)*$val9)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val11=$[rint($(tmp0)*$val9)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$[rint(($val11-$val10+1)/$val9)]
val17=
!for val18 =1 to $val16 
val19=$[rint($val10+($val18-1)*$val9)]
val20=$[rint($val10+$val18*$val9)]
tmp0=!append item \($val19 \leq $val14 < $val20) to $val17

val17=$(tmp0)
!next
val21=$[rint(1)]
val22=r2
!readproc slib/generator $val16,$val8 
tmp0=$slib_out
val23=$(tmp0)
val24=$[rint(0)]
val25=$[rint($val8)]
val26=$val24
val27=$val25
!for val28 =1 to $val16 
val24=$[rint($val24+$(val23[$val28]))]
val25=$[rint($val25-$(val23[$val28]))]
val26=$val26,$val24
val27=$val27,$val25
!next
tmp0=!item 2 to -1 of $val26

val26=$(tmp0)
tmp0=!randint 2, $val16

val29=$[rint($(tmp0))]
!if $val21=0 

!ifval $(val17[$val29])=1
val29=$[rint($val29+1)]
!endif
tmp0=!replace internal NNNN by $(val17[$val29]) in $val15

val15=$(tmp0)
!else

!ifval r2 isin $val22
val30=$[rint($val10+$val29*$val9)]
!else
val30=$[rint($val10+($val29-1)*$val9)]
!endif
tmp0=!replace internal NNNN by $val30 in $val15

val15=$(tmp0)
!endif
oefsteps=$val22 
nextstep=!nosubst $val22 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Réponse
replygood1=$(val23[$val29])
replytype2=numexp
replyname2=Réponse
replygood2=$(val26[$val29])
replytype3=numexp
replyname3=Réponse
replygood3=$(val27[$val29])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

