val8=$(tmp0)
tmp0=!randint 2, 5

val9=$[rint($(tmp0)*100)]
tmp=!translate internal $	$ to ; in $val8

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val11=$[rint(1)]
val12=$[rint($val11+$val6)]
tmp=!translate internal $	$ to ; in $val8

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=Calculer les fréquences cumulées croissantes.
tmp0=!values v for v=$val11 to $val12

