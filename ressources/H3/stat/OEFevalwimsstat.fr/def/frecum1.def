val19=$(tmp0)
!next
val21=$val19
val22=$[rint(0)]
tmp0=!item $val17 of Fréquences cumulées croissantes,Fréquences cumulées décroissantes

val23=$(tmp0)

!ifval $val17=1
val24=$[rint(0)]
!else
val24=$[rint($val9)]
!endif

!ifval $val17=1
val25=+
!else
val25=-
!endif
val26=$[rint($val24/$val9*100)]
!for val27 =1 to $val6 
val24=$[rint($val24$val25$(val19[$val27]))]
val10=$[rint($val24/$val9*100)]
val26=$val26,$val10
!next

!ifval $val17=1
tmp0=!item 2 to -1 of $val26

val26=$(tmp0)
!endif
tmp0=!item 1 to $val6 of r1,r2,r3,r4,r5,r6,r7,r8,r9,r10

val28=$(tmp0)
oefsteps=$val28 
nextstep=!nosubst $val28 
!readproc oef/steps.proc
