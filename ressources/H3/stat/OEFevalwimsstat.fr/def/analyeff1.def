!set title=Interprétation des effectifs 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randrecord src/stat2.don

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randint $(val7[1]), $(val7[2])

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!values v for v=$val9 to $val10

val14=$(tmp0)
val15=$[rint($val10-$val9+1)]
val16=$[rint(0)]
val17=r1
!readproc slib/generator $val15,$val8 
tmp0=$slib_out
val18=$(tmp0)
val19=$[rint(0)]
val20=$[rint($val8)]
val21=$val19
val22=$val20
!for val23 =1 to $val15 
val19=$[rint($val19+$(val18[$val23]))]
val20=$[rint($val20-$(val18[$val23]))]
val21=$val21,$val19
val22=$val22,$val20
!next
tmp0=!item 2 to -1 of $val21

val21=$(tmp0)
tmp0=!randint 2, $val15

val24=$[rint($(tmp0))]
!if $val16=0 

!ifval $(val14[$val24])=1
val24=$[rint($val24+1)]
!endif
tmp0=!replace internal NNNN by $(val14[$val24]) in $val13

val13=$(tmp0)
!else

!ifval r2 isin $val17
val25=$[rint($val9+$val24*\int)]
!else
val25=$[rint($val9+($val24-1)*\int)]
!endif
tmp0=!replace internal NNNN by $val25 in $val13

val13=$(tmp0)
!endif
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Réponse
replygood1=$(val18[$val24])
replytype2=numexp
replyname2=Réponse
replygood2=$(val21[$val24])
replytype3=numexp
replyname3=Réponse
replygood3=$(val22[$val24])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11.	<p>$val13 ?</p>	  <table class="wimscenter wimsborder">	   <tr>	    <th>$val12</th>	     
!for m_l=1 to $val15 
$()<td>$(val14[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Effectifs</th>	     
!for m_l=1 to $val15 
$()<td>$(val18[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Effectifs cumulés croissants</th>	     
!for m_l=1 to $val15 
$()<td>$(val21[$m_l])</td> 
!next
$()	   </tr><tr>	    <th>Effectifs cumulés décroissants</th>	     
!for m_l=1 to $val15 
$()<td>$(val22[$m_l])</td> 
!next
$()	   </tr>	  </table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,13,14,15,18,21,22
embedcnt=0
