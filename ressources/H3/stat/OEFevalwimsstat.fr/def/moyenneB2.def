!set title=Moyenne B2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items Mathématiques,Français,Histoire,Géographie,SVT,Sciences Physiques

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!values v for v=1 to 20

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!shuffle 2,2,3,1

val9=$(tmp0)
tmp0=!item 1 to $(val9[1]) of $val8

val10=$(tmp0)
tmp0=!item $(val9[1])+1 to $(val9[1])+$(val9[2]) of $val8

val11=$(tmp0)
tmp0=!item $(val9[1])+$(val9[2])+1 to $(val9[1])+$(val9[2])+$(val9[3]) of $val8

val12=$(tmp0)
tmp0=!itemcnt $val10

val13=$(tmp0)
tmp0=!itemcnt $val11

val14=$(tmp0)
tmp0=!itemcnt $val12

val15=$(tmp0)
tmp0=!replace internal , by &nbsp; ; &nbsp; in $val10

val16=$(tmp0)
tmp0=!replace internal , by &nbsp; ; &nbsp; in $val11

val17=$(tmp0)
tmp0=!replace internal , by &nbsp; ; &nbsp; in $val12

val18=$(tmp0)
tmp0=!replace internal , by + in $val10

val19=$[rint($(tmp0))]
tmp0=!replace internal , by + in $val11

val20=$[rint($(tmp0))]
tmp0=!replace internal , by + in $val12

val21=$[rint($(tmp0))]
tmp0=!shuffle 2,3

val22=$(tmp0),1
val23=$[rint($val13*$(val22[1])+$val14*$(val22[2])+$val15*$(val22[3]))]
val24=$[rint(($(val22[1])*$val19+$(val22[2])*$val20+$(val22[3])*$val21)/$val23*10)/10]
tmp=!nonempty items premier,deuxième,troisième

tmp0=!randitem $tmp
val25=$(tmp0)
replytype1=numexp
replyname1=Moyenne
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Les notes de $val6 en $val7 durant le $val25 trimestre sont les suivantes :	<table class="wimscenter wimsborder">	 <tr><th>Contrôle</th><td>$val16</td></tr>	 <tr><th>Interrogation</th><td>$val17</td></tr>	 <tr><th>Devoir maison</th><td>$val18</td></tr>	</table>	Le professeur calcule la moyenne en utilisant des coefficients	$(val22[1]) pour les contrôles, $(val22[2]) pour les interrogations et $(val22[3]) pour les devoirs à la maison.	<p>	Quelle est la moyenne de $val6 ?	</p>		<div class="wims_instruction">Arrondir le résultat au dixième.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,16,17,18,22,25
embedcnt=0
