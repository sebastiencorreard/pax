\title{Fréquences 5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\text{donnees=wims(randrecord src/stat.don)}
\text{tmp=row(1,\donnees)}
\integer{eff=randint(\tmp[1]..\tmp[2])}
\text{tmp=row(2,\donnees)}
\integer{nb=randint(\tmp[1]..\tmp[2])}
\text{enonce=row(3,\donnees)}
\text{nameclass=row(4,\donnees)}
\text{borne=row(5,\donnees)}
\text{E=slib(generator \nb,\eff)}

 \text{ddessin=}
 \for{k=0 to \nb-1}{
  \text{ddessin=wims(append item \k,\E[\k+1] to \ddessin)}
 }
 \text{dessin=slib(lgbrisee \nameclass,Effectifs,\ddessin)}
 \text{grdon=draw(300,300
\dessin)}
 \text{grdon=<img src="\grdon" alt="">}
\text{r=item(1 to \nb,r1,r2,r3,r4,r5,r6,r7,r8)}
\steps{\r}
\text{f=}
\for{k=1 to \nb}{
 \integer{tmp=\E[\k]/\eff*100}
 \text{f=wims(append item \tmp to \f)}
}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\grdon</div>
 <div class="medium_size text_col">
\enonce<br>
Calculer les fréquences de cette série statistique.
  <table class="wimscenter wimsborder">
   <tr>
    <th>\nameclass</th>
    \for{l=0 to \nb-1}{<td>\l</td>}
   </tr><tr>
    <th>Fréquences</th>
    \for{l=1 to \nb}{<td>\embed{\r[\l],3} %</td>}
   </tr>
  </table>
<div class="wims_instruction"> Vous arrondirez les résultats à l'entier le plus proche.</div>
 </div>
</div>
}
\answer{Effectif 1}{\f[1]}{type=numexp}
\answer{Effectif 2}{\f[2]}{type=numexp}
\answer{Effectif 3}{\f[3]}{type=numexp}
\answer{Effectif 4}{\f[4]}{type=numexp}
\answer{Effectif 5}{\f[5]}{type=numexp}
\answer{Effectif 6}{\f[6]}{type=numexp}
\answer{Effectif 7}{\f[7]}{type=numexp}
\answer{Effectif 8}{\f[8]}{type=numexp}
