\title{Tableau d'effectifs 4}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{eff=randint(25..35)}
\integer{maxscore=randitem(5,10,20)}
\integer{nb=5}
\text{nameclass=Notes}
\text{E=slib(generator \nb,\eff)}

 \text{dessin=}
 \for{k=1 to \nb}{
  \integer{t2=\k*\maxscore/5}
  \text{dessin=wims(append item \t2,\E[\k] to \dessin)}
 }
 \text{dessin=slib(histo Notes,Effectifs,\dessin)}
 \text{grdon=draw(300,300
\dessin)}
 \text{grdon=<img src="\grdon" alt="">}
 \text{min=wims(values \maxscore/5*v for v=0 to 5)}
 \text{max=item(2 to -1,\min)}

\text{r=r1,r2,r3,r4,r5}

\statement{
 <div class="wims_columns">
 <div class="medium_size img_col">\grdon</div>
 <div class="medium_size text_col">
  Un enseignant a relevé les notes obtenues par ses élèves lors d'une interrogation notée sur \maxscore.<br>
  À l'aide de l'histogramme ci-contre, compléter le tableau ci-dessous.
  <table class="wimscenter wimsborder">
   <tr>
    <th>\nameclass (N)</th>
    \for{l=1 to \nb}{<td>\(\min[\l] \leq N < \max[\l]) </td>}
   </tr><tr>
    <th>Effectifs</th>
    \for{l=1 to \nb}{<td>\embed{\r[\l],5}</td>}
   </tr>
  </table>
   </div>
</div>
}
\answer{Effectif 1}{\E[1]}{type=numexp}
\answer{Effectif 2}{\E[2]}{type=numexp}
\answer{Effectif 3}{\E[3]}{type=numexp}
\answer{Effectif 4}{\E[4]}{type=numexp}
\answer{Effectif 5}{\E[5]}{type=numexp}
