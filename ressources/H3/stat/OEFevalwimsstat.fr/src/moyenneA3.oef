\title{Moyenne A3}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{name=slib(lang/fname fr,boy)}
\integer{nb=randint(3..5)}
\integer{an=randint(1975..1995)}
\text{an=wims(values v for v=\an to \an+\nb-1)}
\text{val=}
\integer{rep=0}
\for{k=1 to \nb}{
 \integer{v=randint(600..800)}
 \text{val=wims(append item \v to \val)}
 \integer{rep=\rep+\v}
}
\integer{rep=\rep/\nb}

\statement{
Voici le nombre de voitures recyclées par une usine sur plusieurs années :
<table class="wimscenter wimsborder">
<tr>
 <th>Années</th>
 <th>Nombre de voitures</th>
</tr>
 \for{l=1 to \nb}{<tr><td>\an[\l]</td><td>\val[\l]</td></tr>}
</table>
Quel a été le nombre moyen de voitures recyclées durant ces \nb années ?
<div class="wims_instruction">Vous arrondirez votre résultat à l'unité.</div>}

\answer{Moyenne}{\rep}{type=numexp}
