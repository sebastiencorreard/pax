\title{Moyenne A5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{name=slib(lang/fname fr,girl)}
\integer{nb=randint(3..5)}
\text{vsec=}
\text{vmin=}
\integer{rep=0}
\for{k=1 to \nb}{
 \integer{v1=randint(10..40)}
 \text{vsec=wims(append item \v1 to \vsec)}
 \integer{v2=randint(2..4)}
 \text{vmin=wims(append item \v2 to \vmin)}
 \integer{rep=\rep+\v1+60*\v2}
}
\integer{sec=\rep/\nb}
\integer{min=floor(\sec/60)}
\integer{sec=\sec-60*\min}

\statement{
\name a écouté plusieurs chansons d'un album. On a reporté les durées de chaque chanson dans le tableau suivant :
<table class="wimscenter wimsborder">
<tr>
 <th>Chansons</th>
 <th>Temps</th>
</tr>
 \for{l=1 to \nb}{<tr><td>\l</td><td>\vmin[\l] min \vsec[\l] s</td></tr>}
</table>
<p>Quelle est la durée moyenne de ces chansons ?</p>
<div class="spacer">
<b>Votre réponse</b> : \embed{r1,5} min \embed{r2,5}s.
</div>

<div class="wims_instruction">Vous donnerez le résultat à la seconde près.</div>.}

\answer{Minute}{\min}{type=numexp}
\answer{Seconde}{\sec}{type=numexp}
