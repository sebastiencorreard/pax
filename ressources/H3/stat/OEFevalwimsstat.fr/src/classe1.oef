\title{Regroupement en classes 1}
\author{Fabrice,Guerimand}
\email{fwguerimafree.fr}


\integer{nbc=randint(4..5)}
\text{cl=\nbc=4?&#91;0;5&#91;,&#91;5;10&#91;,&#91;10;15&#91;,&#91;15;20&#93;:&#91;0;4&#91;,&#91;4;8&#91;,&#91;8;12&#91;,&#91;12;16&#91;,&#91;16;20&#93;}
\text{serie=}
\text{rep=}
\integer{eff=randint(20..30)}
\integer{effr=\eff}
\integer{pas=20/\nbc}
\for{a=1 to \nbc}{
 \integer{n=randint(max(1,\effr/(\nbc-\a+1)-3)..min(10,\effr-\nbc+\a))}
 \integer{effr=\eff-\n}
 \text{rep=wims(append item \n to \rep)}
 \for{l=1 to \n}{
  \integer{no=randint(\pas*(\a-1)..\pas*(\a)-1)}
  \text{serie=wims(append item \no to \serie)}
 }
}
\integer{eff=items(\serie)}
\text{serie=shuffle(\serie)}

\text{nrep=item(1 to \nbc,r1,r2,r3,r4,r5)}
\steps{\nrep}

\statement{
Voici les notes obtenues à un contrôle des \eff élèves de la classe :
<div class="wimscenter">
\serie
</div>
Complète le tableau des effectifs suivant :
<table class="wimscenter wimsborder">
 <tr><th>classes</th>\for{k=1 to \nbc}{<td><b>\cl[\k]</b></td>}</tr>
 <tr><th>Effectifs</th>\for{L=1 to \nbc}{<td>\embed{\nrep[\L],5}</td>}</tr>
</table>}

\answer{\cl[1]}{\rep[1]}{type=numexp}
\answer{\cl[2]}{\rep[2]}{type=numexp}
\answer{\cl[3]}{\rep[3]}{type=numexp}
\answer{\cl[4]}{\rep[4]}{type=numexp}
\answer{\cl[5]}{\rep[5]}{type=numexp}
