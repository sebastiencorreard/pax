\title{Regroupement en classes 4}
\author{Fabrice,Guerimand}
\email{fwguerimafree.fr}

\integer{min=randint(140..145)}
\integer{max=randint(176..184)}
\text{l=180}
\integer{max=\max isitemof \l?\max-1}
\integer{nbse=randint(23..30)}
\integer{ncl=ceil(\max/5)-floor(\min/5)}

\text{serie=}
\text{serieA=}
\for{a=1 to \nbse}{
 \integer{n=randint(\min..\max)}
 \text{serie=wims(append item \n to \serie)}
 \integer{r=\n-100}
 \text{serieA=wims(append item 1m\r to \serieA)}
 \text{ddessin=wims(append item \a,\n to \ddessin)}
}

\integer{classes=floor(\min/5)}
\text{cl=}
\for{b=1 to \ncl}{
 \integer{tmp1=floor(\min/5)*5+5*(\b-1)}
 \integer{tmp2=\tmp1+5}
 \text{cl=wims(append item &#91;\tmp1;\tmp2&#91; to \cl)}
 \text{classes=wims(append item \tmp2 to \classes)}
}

\text{classe=slib(stat/effectif [\serie],[\classes])}
\text{rep=item(1,\classe)}
\text{rep=wims(char 2 to -2 of \rep)}

\text{nrep=item(1 to \ncl,r1,r2,r3,r4,r5,r6,r7,r8,r9)}
\steps{\nrep}

\text{serieA=wims(replace internal , by &nbsp;;&nbsp; in \serieA)}

\statement{
Voici la série des tailles, en centimètres, de chacun des \nbse élèves d'une classe :
<div class="wimscenter">
\serieA
</div>
Complète le tableau ci-dessous :
<table class="wimscenter wimsborder">
 <tr><th>Taille (en cm)</th>\for{k=1 to \ncl}{<td><b>\cl[\k]</b></td>}</tr>
 <tr><th>Effectifs</th>\for{L=1 to \ncl}{<td>\embed{\nrep[\L],5}</td>}</tr>
</table>}

\answer{\cl[1]}{\rep[1]}{type=numexp}
\answer{\cl[2]}{\rep[2]}{type=numexp}
\answer{\cl[3]}{\rep[3]}{type=numexp}
\answer{\cl[4]}{\rep[4]}{type=numexp}
\answer{\cl[5]}{\rep[5]}{type=numexp}
\answer{\cl[6]}{\rep[6]}{type=numexp}
\answer{\cl[7]}{\rep[7]}{type=numexp}
\answer{\cl[8]}{\rep[8]}{type=numexp}
\answer{\cl[9]}{\rep[9]}{type=numexp}
