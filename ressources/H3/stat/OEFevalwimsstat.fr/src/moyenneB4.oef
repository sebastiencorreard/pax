\title{Moyenne B4}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{notes=-randint(100..500),simplify(randitem(1,1,-1)*randint(100..500)),simplify(randitem(1,1,-1)*randint(50..300))}
\text{val=wims(values v for v=3 to 10)}
\text{c=shuffle(\val)}

\integer{S=\c[1]+\c[2]+\c[3]}
\real{rep=rint((\c[1]*\notes[1]+\c[2]*\notes[2]+\c[3]*\notes[3])/\S*10)/10}

\statement{
Calculer la moyenne pondérée des nombres \notes[1], \notes[2] et \notes[3]
affectés respectivement des coefficients \c[1], \c[2] et \c[3].

<div class="wims_instruction">Arrondir le résultat au dixième.</div>}

\answer{Moyenne}{\rep}{type=numexp}
