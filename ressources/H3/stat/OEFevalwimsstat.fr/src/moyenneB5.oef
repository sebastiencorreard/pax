\title{Moyenne B5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nb1=randint(5..9)}
\integer{nb2=\nb1+randint(4..7)}
\text{nb=shuffle(\nb1,\nb2)}
\integer{N1=randint(10..15)}
\integer{N2=\N1+randint(3..6)}
\text{N=shuffle(\N1,\N2)}
\real{rep=rint((\nb[1]*\N[1]+\nb[2]*\N[2])/(\nb[1]+\nb[2])*10)/10}

\statement{<ul>
<li>Dans un groupe, il y a \nb[1] filles et \nb[2] garçons.</li>
<li>L'age moyen des filles est de \N[1] ans et l'age moyen des garçons est de \N[2] ans.</li>
</ul>
Quel est l'age moyen des personnes de ce groupe ?

<div class="wims_instruction">Arrondir le résultat au dixième.</div>

<div class="spacer"><b>Votre réponse</b> :
L'âge moyen du groupe est de \embed{r1,5} ans.
</div>}

\answer{Moyenne}{\rep}{type=numexp}
