\title{Moyenne C4}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{eff=randint(25..35)}
\integer{maxscore=randitem(1,2)}
\integer{nb=5}
\text{nameclass=Notes}
\text{E=slib(generator \nb,\eff)}
\text{cent=wims(values \maxscore*(1+2*v) for v=0 to \nb-1)}
\integer{maxscore=10*\maxscore}
\text{dessin=}
\real{moyenne=0}
\for{k=1 to \nb}{
 \integer{t2=\k*\maxscore/5}
 \text{dessin=wims(append item \t2,\E[\k] to \dessin)}
 \real{moyenne=\moyenne+\E[\k]*\cent[\k]}
}
 \real{moyenne=rint(\moyenne/\eff*10)/10}
 \text{dessin=slib(histo Notes,Effectifs,\dessin)}
 \text{grdon=draw(300,300
\dessin)}
 \text{grdon=<img src="\grdon" alt="">}
 \text{min=wims(values \maxscore/5*v for v=0 to 5)}
 \text{max=item(2 to -1,\min)}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\grdon</div>
 <div class="medium_size text_col">
  Un enseignant a relevé les notes obtenues par ses élèves lors d'une interrogation
  notée sur \maxscore et a tracé l'histogramme ci-contre.
<p>
  Quelle est la moyenne de la classe ?
</p>
<div class="wims_instruction">Vous arrondirez votre résultat au dixième.</div>
 </div>
</div>
}
\answer{Moyenne}{\moyenne}{type=numexp}
