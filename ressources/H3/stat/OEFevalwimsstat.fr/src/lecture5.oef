\title{Tableau d'effectifs 5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nb=randint(3..4)}
\text{borne=\nb}
\integer{nb=\nb+1}
\integer{eff=100}
\text{E=slib(generator \nb,\eff)}
\integer{total=randint(7..30)*100}
\text{Tot=}
\for{j=1 to \nb}{
 \integer{tmp=\E[\j]*\total/100}
 \text{Tot=wims(append item \tmp to \Tot)}
}
\text{r=item(1 to \nb,r1,r2,r3,r4,r5)}
\steps{\r}

\statement{
Voici les résultats d'une enquête portant sur \total foyers afin de déterminer le nombre de télévisions possédées par chaque famille.<br>
Les résultats sont exprimés en pourcentage, retrouver les effectifs.
<table class="wimscenter wimsborder">
   <tr>
    <th>Nombre de télévisions</th>
    \for{l=0 to \nb-1}{<td>\l</td>}
   </tr><tr>
    <th>Pourcentages</th>
    \for{l=1 to \nb}{<td>\E[\l] %</td>}
   </tr><tr>
    <th>Effectifs</th>
    \for{l=1 to \nb}{<td>\embed{\r[\l],5}</td>}
   </tr>
  </table>
}
\answer{Effectif 1}{\Tot[1]}{type=numexp}
\answer{Effectif 2}{\Tot[2]}{type=numexp}
\answer{Effectif 3}{\Tot[3]}{type=numexp}
\answer{Effectif 4}{\Tot[4]}{type=numexp}
\answer{Effectif 5}{\Tot[5]}{type=numexp}
