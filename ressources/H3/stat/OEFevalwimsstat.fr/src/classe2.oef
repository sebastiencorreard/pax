\title{Regroupement en classes 2}
\author{Fabrice,Guerimand}
\email{fwguerimafree.fr}

\integer{min=randint(0..5)}
\integer{max=randitem(16,17,18,19,21,22,23,24,26,27,28,29)}
\integer{nbse=26}
\integer{ncl=ceil(\max/5)-floor(\min/5)+1}
\integer{som=randint(5..\nbse-5)}
\text{loi=x*(x-\nbse)*(\max-\min)/(\som*(\som-\nbse))+\min}

\text{serie=}
\text{ddessin=}
\for{a=1 to \nbse}{
 \integer{n=evalue(\loi,x=\a)}
 \integer{n=randint(max(1,\n-5)..\n+5)}
 \text{serie=wims(append item \n to \serie)}
 \text{ddessin=wims(append item \a,\n to \ddessin)}
}

\text{cl=}
\text{dessin2=}
\integer{classes=floor(\min/5)}
\for{b=1 to \ncl}{
 \integer{tmp1=floor(\min/5)*5+5*(\b-1)}
 \integer{tmp2=\tmp1+5}
 \text{cl=wims(append item &#91;\tmp1;\tmp2&#91; to \cl)}
 \text{classes=wims(append item \tmp2 to \classes)}
 \text{dessin2=\dessin2
text black,-1,\tmp2+0.3,medium,\tmp2}
}

\text{dessin=slib(lgbrisee Semaine,Temperature,\ddessin)}
\text{figure=draw(500,500
\dessin
\dessin2)}

\text{classe=slib(stat/effectif [\serie],[\classes])}
\text{rep=item(1,\classe)}
\text{rep=wims(char 2 to -2 of \rep)}

\text{nrep=item(1 to \ncl,r1,r2,r3,r4,r5,r6,r7)}
\steps{\nrep}

\statement{
Voici le graphique des températures moyennes par semaine relevées dans une même ville sur un semestre :
<div class="wimscenter">
<img src="\figure" alt="">
</div>
Complète le tableau donnant les effectifs en fonction des classes de températures définies :
<table class="wimscenter wimsborder">
 <tr><th>Classes</th>\for{k=1 to \ncl}{<td><b>\cl[\k]</b></td>}</tr>
 <tr><th>Effectifs</th>\for{L=1 to \ncl}{<td>\embed{\nrep[\L],5}</td>}</tr>
</table>}

\answer{\cl[1]}{\rep[1]}{type=numexp}
\answer{\cl[2]}{\rep[2]}{type=numexp}
\answer{\cl[3]}{\rep[3]}{type=numexp}
\answer{\cl[4]}{\rep[4]}{type=numexp}
\answer{\cl[5]}{\rep[5]}{type=numexp}
\answer{\cl[6]}{\rep[6]}{type=numexp}
\answer{\cl[7]}{\rep[7]}{type=numexp}
