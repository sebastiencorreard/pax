\title{Effectifs cumulés 5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{donnees=wims(randrecord src/stat2.don)}
\text{tmp=row(1,\donnees)}
\integer{eff=randint(\tmp[1]..\tmp[2])}
\integer{min=1}
\integer{max=6}
\text{enonce=row(4,\donnees)}
\text{nameclass=row(5,\donnees)}
\text{question=Compléter le tableau suivant.}
\text{et=wims(values v for v=\min to \max)}
\integer{nb=6}

\text{E=slib(generator \nb,\eff)}
\integer{toc=0}
\integer{tod=\eff}
\text{crois=\toc}
\text{decrois=\tod}
\for{k=1 to \nb}{
 \integer{toc=\toc+\E[\k]}
 \integer{tod=\tod-\E[\k]}
 \text{crois=\crois,\toc}
 \text{decrois=\decrois,\tod}
}
\text{crois=item(2 to -1,\crois)}

\statement{
\enonce<br>
\question
  <table class="wimscenter wimsborder">
   <tr>
    <th>\nameclass</th>
    \for{l=1 to \nb}{<td>\et[\l]</td>}
   </tr><tr>
    <th>Effectifs</th>
    <td>\E[1]</td>
    <td>\embed{r2,5}</td>
    <td>\E[3]</td>
    <td>\E[4]</td>
    <td>\E[5]</td>
    <td>\E[6]</td>
   </tr><tr>
    <th>Effectifs cumulés croissants</th>
    <td>\crois[1]</td>
    <td>\crois[2]</td>
    <td>\crois[3]</td>
    <td>\embed{r1,5}</td>
    <td>\crois[5]</td>
    <td>\crois[6]</td>
   </tr><tr>
    <th>Effectifs cumulés décroissants</th>
    <td>\decrois[1]</td>
    <td>\decrois[2]</td>
    <td>\decrois[3]</td>
    <td>\decrois[4]</td>
    <td>\embed{r3,5}</td>
    <td>\decrois[6]</td>
   </tr>
  </table>
}

\answer{Effectifs cumulés croisants}{\crois[4]}{type=numexp}
\answer{Effectifs}{\E[2]}{type=numexp}
\answer{Effectifs cumulés décroissants}{\decrois[5]}{type=numexp}
