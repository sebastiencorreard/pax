\title{Moyenne A1}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{name=slib(lang/fname fr,boy)}
\text{matiere=randitem(Mathématiques,Français,Histoire,Géographie,Anglais,Espagnol,Italien,SVT,Sciences Physiques)}
\text{val=wims(values v for v=1 to 20)}
\text{val=shuffle(\val)}
\integer{nb=randitem(4,5)}
\text{val=item(1 to \nb,\val)}
\text{notes=wims(replace internal , by &nbsp;;&nbsp; in \val)}
\real{rep=wims(replace internal , by + in \val)}
\real{rep=\rep/\nb}

\statement{
Les notes de \name en \matiere durant le premier trimestre sont les suivantes :
<div class="wimscenter">\notes</div>
Quelle est la moyenne de \name ?}

\answer{Moyenne}{\rep}{type=numexp}
