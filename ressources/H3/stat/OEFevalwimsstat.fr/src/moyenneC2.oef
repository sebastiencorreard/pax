\title{Moyenne C2}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}


 \text{donnees=wims(randrecord src/stat3.don)}
 \text{tmp=row(1,\donnees)}
 \integer{eff=randint(\tmp[1]..\tmp[2])}
 \integer{int=row(4,\donnees)}
 \text{tmp=row(2,\donnees)}
 \integer{min=randint(\tmp[1]..\tmp[2])*\int}
 \integer{max=\min+randint(4..5)*\int}
 \text{enonce=row(5,\donnees)}
 \text{nameclass=row(6,\donnees)}
 \text{name=row(7,\donnees)}
 \integer{nb=(\max-\min+1)/\int}
 \text{et=}
 \text{res=}
 \integer{moyenne=0}
 \text{E=slib(generator \nb,\eff)}
 \for{i=1 to \nb}{
  \integer{em=\min+(\i-1)*\int}
  \integer{eM=\min+\i*\int}
  \text{et=wims(append item \(\em \leq \name < \eM) to \et)}
  \real{tmp=(\em+\eM)/2}
  \text{res=wims(append item \tmp to \res)}
  \real{moyenne=\moyenne+\E[\i]*\tmp}
 }
 \real{moyenne=rint(\moyenne/\eff*10)/10}

\text{r=item(1 to \nb,r1,r2,r3,r4,r5)}
\steps{\r,r6}

\statement{
\enonce
<table class="wimscenter wimsborder">
   <tr>
    <th>\nameclass</th>
    \for{l=1 to \nb}{<td>\et[\l]</td>}
   </tr><tr>
    <th>Effectifs</th>
    \for{l=1 to \nb}{<td>\E[\l]</td>}
   </tr><tr>
    <th>Centres de classe</th>
    \for{l=1 to \nb}{<td>\embed{\r[\l],5}</td>}
   </tr>
  </table>
<p>
Calculer les centres de classe et la moyenne de cette série statistique.</p>
<div class="spacer"><b>Votre réponse</b> :
La moyenne est de \embed{r6,7}.
</div>
<div class="wims_instruction">Vous donnerez l'arrondi au dixième.</div>}
\answer{1}{\res[1]}{type=numexp}
\answer{2}{\res[2]}{type=numexp}
\answer{3}{\res[3]}{type=numexp}
\answer{4}{\res[4]}{type=numexp}
\answer{5}{\res[5]}{type=numexp}
\answer{Moyenne}{\moyenne}{type=numexp}
