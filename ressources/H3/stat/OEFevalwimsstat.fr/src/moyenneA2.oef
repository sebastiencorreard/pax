\title{Moyenne A2}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{name=slib(lang/fname fr,boy)}
\text{val=wims(values -v,v for v=1 to 7)}
\text{val=shuffle(\val)}
\integer{nb=randint(5..7)}
\text{val=item(1 to \nb,\val)}
\text{notes=wims(replace internal , by &nbsp;;&nbsp; in \val)}
\real{rep=wims(replace internal , by + in \val)}
\real{rep=rint(\rep/\nb*10)/10}

\statement{
Les températures suivantes sont celles relevées par \name pendant \nb jours consécutifs :
<div class="wimscenter"> \notes </div>
Quelle a été la température moyenne durant ces \nb jours ?

<div class="wims_instruction">Vous arrondirez votre résultat au dixième.</div>}

\answer{Moyenne}{\rep}{type=numexp}
