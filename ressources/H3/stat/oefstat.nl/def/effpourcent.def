!set title=Cirkeldiagrammen:Aantal en percentages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r
varcnt=38
prevarcnt=37
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=6
val7=100
!for val8 =1 to $val6-1 
tmp0=!randint 8, 20

val9=$(tmp0)
!if $val8=1 
val10=$val9
!else
val10=$val10,$val9
!endif
val7=$[$val7-$val9]
!next
val10=$val10,$val7
tmp0=!shuffle 6

val11=$(tmp0)
val12=red,skyblue,orange,grey,green,purple
val13=rood, blauw,oranje,grijs, groen, paars
val14=A,B,C,D,E,F
tmp0=!randint 1, $val6

val15=$(tmp0)
tmp0=!item $val15 of $val11

tmp1=!item $(tmp0) of  $val13

val16=$(tmp1)
tmp0=!item $val15 of $val11

tmp1=!item $(tmp0) of  $val14

val17=$(tmp1)
tmp0=!randint 10, 30

val18=$[rint($(tmp0)*100)]
tmp0=!item $val15 of $val10

val19=$[round($(tmp0)/100*$val18)]
val20=ellipse 0,0,2,2,black	line 0,0,1,0,black
val21=0
tmp0=!randint 1, $val6

val15=$(tmp0)
!for val8 =1 to $val6 
tmp0=!item $val8 of $val10

val22=$[$(tmp0)*2*pi/100]
val23=$[$val21+$val22/2]
tmp0=!item $val8 of $val11

tmp1=!item $(tmp0) of $val12

val16=$(tmp1)
tmp0=!item $val8 of $val11

tmp1=!item $(tmp0) of  $val14

val17=$(tmp1)
val21=$[$val21+$val22]
val20=$val20	line 0,0,cos($val21),sin($val21),black	fill  cos($val23)/2,sin($val23)/2, $val16	text black,  1.2*cos($val23),1.2*sin($val23),medium, $val17
!if $val8 = $val15 
!else
tmp0=!item $val8 of $val10

val20=$val20	text black, 2*cos($val23)/3,2*sin($val23)/3, medium, $(tmp0)%	
!endif
!next
tmp0=!item $val15 of $val11

tmp1=!item $(tmp0) of  $val13

val16=$(tmp1)
tmp0=!item $val15 of $val11

tmp1=!item $(tmp0) of  $val14

val17=$(tmp1)
tmp0=!randint 10, 30

val18=$[rint($(tmp0)*100)]
tmp0=!positionof item 1 in $val11

tmp1=!item $(tmp0) of $val10

val24=$[round($(tmp1)/100*$val18)]
tmp0=!positionof item 2 in $val11

tmp1=!item $(tmp0) of $val10

val25=$[round($(tmp1)/100*$val18)]
tmp0=!positionof item 3 in $val11

tmp1=!item $(tmp0) of $val10

val26=$[round($(tmp1)/100*$val18)]
tmp0=!positionof item 4 in $val11

tmp1=!item $(tmp0) of $val10

val27=$[round($(tmp1)/100*$val18)]
tmp0=!positionof item 5 in $val11

tmp1=!item $(tmp0) of $val10

val28=$[round($(tmp1)/100*$val18)]
tmp0=!positionof item 6 in $val11

tmp1=!item $(tmp0) of $val10

val29=$[round($(tmp1)/100*$val18)]
replytype1=numeric
replyname1=rood
replygood1=$[$val24]
replytype2=numeric
replyname2=blauw
replygood2=$[$val25]
replytype3=numeric
replyname3=oranje
replygood3=$[$val26]
replytype4=numeric
replyname4=grije
replygood4=$[$val27]
replytype5=numeric
replyname5=groen
replygood5=$[$val28]
replytype6=numeric
replyname6=paars
replygood6=$[$val29]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Hieronder zie je een cirkeldiagram die een populatie van $val18 individuen met $val6 eigenschappen	weergeeft :	<center>	  
!read oef/draw.phtml 300,300 \
transparent white	xrange -1.5,1.5	yrange -1.5,1.5	$val20 
$()	</center>	Vul de onderstaande tabel in (rond je uitkomsten af op gehele getallen)	<table align="center" border=1> <tr align="center"><th></th><th>rood (A) </th><th> blauw (B)</th><th>oranje (C)	</th><th>grijs (D)</th><th>groen (E)</th><th>paars (F)</th></tr>	<tr align="center"><th>Aantallen</th><td> 
!read oef/embed.phtml reply 1, 5 
$()</td>	<td> 
!read oef/embed.phtml reply 2, 5 
$()</td>	<td> 
!read oef/embed.phtml reply 3, 5 
$()</td>	<td> 
!read oef/embed.phtml reply 4, 5 
$()</td>	<td> 
!read oef/embed.phtml reply 5, 5 
$()</td>	<td> 
!read oef/embed.phtml reply 6, 5 
$()</td>	</table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

