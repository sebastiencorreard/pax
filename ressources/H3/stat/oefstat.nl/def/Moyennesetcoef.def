!set title=Gemiddelden en co&euml;fficienten
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items Jan,Piet,Klaas, Albert, Emmanuelle, Stefan, Eric, 	Marcel,Marie, Alexander, Marga, Laura,Carla, Lucie

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
tmp0=!randitem 2, 7

val10=$[rint($(tmp0))]
tmp0=!randitem 2, 7

val11=$[rint($(tmp0))]
tmp0=!randitem 2, 7

val12=$[rint($(tmp0))]
val13=$[rint(10*($val7*$val10+$val8*$val11+$val9*$val12)/($val10+$val11+$val12))/10]
replytype1=default
replyname1=Totaal gemiddelde
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 heeft gemiddeld een $val7 gehaald voor wiskunde (het aantal toetsen was $val10)<br>	Voor frans heeft $val6 een $val8 gemiddeld gescoord (het aantal toetsen was  $val11) en<br>	voor natuurkunde heeft $val6  een $val9 gemiddeld (het aantal toetsen was  $val12).  	Wat is het totale gemiddelde van $val6 ? <br>	Rond je antwoord af op 1 cijfer achter de komma nauwkeurig
$()
