!set title=Cirkeldiagram en hoek
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 6

val6=$(tmp0)
val7=100
!for val8 =1 to $val6-1 
tmp0=!randint 8, 20

val9=$(tmp0)
!if $val8=1 
val10=$val9
!else
val10=$val10,$val9
!endif
val7=$[$val7-$val9]
!next
val10=$val10,$val7
tmp0=!shuffle 6

val11=$(tmp0)
val12=red,skyblue,orange,grey,green,purple
val13=rood, blauw ,oranje ,grijs, groen, paars
tmp0=!randint 1, $val6

val14=$(tmp0)
tmp0=!item $val14 of $val11

tmp1=!item $(tmp0) of  $val13

val15=$(tmp1)
tmp0=!randint 10, 30

val16=$[rint($(tmp0)*100)]
tmp0=!item $val14 of $val10

val17=$[round($(tmp0)/100*$val16)]
val18=ellipse 0,0,2,2,black	line 0,0,1,0,black
val19=0
tmp0=!randint 1, $val6

val14=$(tmp0)
!for val8 =1 to $val6 
tmp0=!item $val8 of $val10

val20=$[$(tmp0)*2*pi/100]
val21=$[$val19+$val20/2]
tmp0=!item $val8 of $val11

tmp1=!item $(tmp0) of $val12

val15=$(tmp1)
val19=$[$val19+$val20]
val18=$val18	line 0,0,cos($val19),sin($val19),black	fill  cos($val21)/2,sin($val21)/2, $val15
!if $val8 = $val14 
!else
tmp0=!item $val8 of $val10

val18=$val18	text black, 2*cos($val21)/3,2*sin($val21)/3, medium, $(tmp0)%	
!endif
!next
tmp0=!item $val14 of $val11

tmp1=!item $(tmp0) of  $val13

val15=$(tmp1)
tmp0=!randint 10, 30

val16=$[rint($(tmp0)*100)]
tmp0=!item $val14 of $val10

val17=$[round($(tmp0)/100*360)]
replytype1=numeric
replyname1=Hoek:
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Hieronder zie je een cirkeldiagram van een populatie met $val16 individuen met	$val6 eigenschappen, weergegeven door de verschillende kleuren:  	<center>	  
!read oef/draw.phtml 300,300 \
transparent white	xrange -1.5,1.5	yrange -1.5,1.5	$val18 
$()	</center>	Wat is de hoek in graden die hoort bij het aantal individuen met de eigenschap $val15 ?	<br>Rond je getal af op hele graden nauwkeurig . 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,15,16,18
embedcnt=0
