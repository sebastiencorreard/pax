!set title=Gemiddelden
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname nl boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 30, 80

val7=$[rint($(tmp0))]
val8=$[rint(20)]
val9=$[rint($val7-$val8)]
val10=$[rint($val7+$val8)]
tmp0=!randint $val9, $val10

val11=$[$(tmp0)/10]
tmp0=!randint $val9, $val10

val12=$[$(tmp0)/10]
tmp0=!randint $val9, $val10

val13=$[$(tmp0)/10]
val14=$[rint(10*($val11+$val12+$val13)/3)/10]
replytype1=default
replyname1=<b>$val6 's gemiddelde cijfer:</b>
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 heeft voor een eerste proefwerk het cijfer <b>$val11</b> gehaald.<br>	Voor een tweede proefwerk behaalde $m_HIJ een <b>$val12</b>. <br>	Voor een derde proefwerk haalde $m_HIJ  het cijfer <b>$val13</b>.<br>	Wat is  $val6 's  gemiddelde cijfer?<br>	Rond je uitkomst af op 1 cijfer achter de komma  <br>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,12,13
embedcnt=0
