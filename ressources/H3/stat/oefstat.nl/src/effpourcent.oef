\title{Cirkeldiagrammen:Aantal en percentages}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{n=6}
\text{ss=100}
\for{i=1 to \n-1}{
\text{u=randint(8..20)}
\if{\i=1}{\text{s=\u}}{\text{s=\s,\u}}
\real{ss=\ss-\u}}
\text{s=\s,\ss}
\text{shu=shuffle(6)}
\text{listecouleur=red,skyblue,orange,grey,green,purple}
\text{listenl=rood, blauw,oranje,grijs, groen, paars}
 \text{listealpha = A,B,C,D,E,F}
\text{pos=randint(1..\n)}
\text{couleur=item(item(\pos,\shu), \listenl)}
\text{alph=item(item(\pos,\shu), \listealpha)}
\integer{ind=randint(10..30)*100}
\real{rep= round(item(\pos,\s)/100*\ind)}
\text{dessin= ellipse 0,0,2,2,black
line 0,0,1,0,black}
\text{anglet=0}
\text{pos=randint(1..\n)}
\for{i=1 to \n}{
\real{angle=item(\i,\s)*2*pi/100}
\real{point=\anglet+\angle/2}
\text{couleur=item(item(\i,\shu),\listecouleur)}
\text{alph=item(item(\i,\shu), \listealpha)}
\real{anglet=\anglet+\angle}
\text{dessin=\dessin
line 0,0,cos(\anglet),sin(\anglet),black
fill  cos(\point)/2,sin(\point)/2, \couleur
text black,  1.2*cos(\point),1.2*sin(\point),medium, \alph}
\if{\i = \pos}{}{\text{dessin=\dessin
text black, 2*cos(\point)/3,2*sin(\point)/3, medium, item(\i,\s)%
}}}


\text{couleur=item(item(\pos,\shu), \listenl)}
\text{alph=item(item(\pos,\shu), \listealpha)}
\integer{ind=randint(10..30)*100}
\real{rep1= round(item(position(1,\shu),\s)/100*\ind)}
\real{rep2= round(item(position(2,\shu),\s)/100*\ind)}
\real{rep3= round(item(position(3,\shu),\s)/100*\ind)}
\real{rep4= round(item(position(4,\shu),\s)/100*\ind)}
\real{rep5= round(item(position(5,\shu),\s)/100*\ind)}
\real{rep6= round(item(position(6,\shu),\s)/100*\ind)}

\statement{
Hieronder zie je een cirkeldiagram die een populatie van \ind individuen met \n eigenschappen
weergeeft :
<center>
 \draw{300,300}
{transparent white
xrange -1.5,1.5
yrange -1.5,1.5
\dessin}
</center>
Vul de onderstaande tabel in (rond je uitkomsten af op gehele getallen)
<table align="center" border=1> <tr align="center"><th></th><th>rood (A) </th><th> blauw (B)</th><th>oranje (C)
</th><th>grijs (D)</th><th>groen (E)</th><th>paars (F)</th></tr>
<tr align="center"><th>Aantallen</th><td>\embed{reply 1, 5}</td>
<td>\embed{reply 2, 5}</td>
<td>\embed{reply 3, 5}</td>
<td>\embed{reply 4, 5}</td>
<td>\embed{reply 5, 5}</td>
<td>\embed{reply 6, 5}</td>
</table>}

\answer{rood}{\rep1}{type=numeric}
\answer{blauw}{\rep2}{type=numeric}
\answer{oranje}{\rep3}{type=numeric}
\answer{grije}{\rep4}{type=numeric}
\answer{groen}{\rep5}{type=numeric}
\answer{paars}{\rep6}{type=numeric}

