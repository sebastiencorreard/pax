\title{Verdelingen I}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{eff1=randint(0..3)}
\integer{eff2=randint(4..8)}
\integer{eff3=randint(8..12)}
\integer{eff4=randint(7..10)}
\integer{eff5=randint(1..3)}

\integer{effc1=\eff1}
\integer{effc2=\effc1+\eff2}
\integer{effc3=\effc1+\eff2+\eff3}
\integer{effc4=\effc1+\eff2+\eff3+\eff4}
\integer{effc5=\effc1+\eff2+\eff3+\eff4+\eff5}

\real{freq1=floor(1000*\eff1/\effc5)/10}
\real{freq2=floor(1000*\eff2/\effc5)/10}
\real{freq3=floor(1000*\eff3/\effc5)/10}
\real{freq4=floor(1000*\eff4/\effc5)/10}
\real{freq5=floor(1000*\eff5/\effc5)/10}



\statement{
De onderstaande tabel geeft de cijfers voor een proefwerk
 weer van \effc5 leerlingen.
Vul de tabel verder in.
Geef je antwoorden op 1 decimaal nauwkeurig

<p>

<table align="center" border=1>

<tr align="center"><th>Klasseverdeling v/d cijfers</th>
<td>\(0\leq N <4 )</td>
<td>\(4\leq N <8 )</td>
<td>\(8\leq N <12 )</td>
<td>\(12\leq N <16 )</td>
<td>\(16\leq N \leq 20 )</td>
</tr>

<tr align="center"><th>Aantal</th>
<td>\eff1</td>
<td>\eff2</td>
<td>\eff3</td>
<td>\eff4</td>
<td>\eff5</td>
</tr>

<tr align="center"><th>Cumulatieve aantal</th>
<td>\embed{reply 1,5} </td>
<td>\embed{reply 2,5} </td>
<td>\embed{reply 3,5} </td>
<td>\embed{reply 4,5} </td>
<td>\embed{reply 5,5} </td>
</tr>

<tr align="center"><th>Frequentie (%)</th>
<td>\embed{reply 6,5} </td>
<td>\embed{reply 7,5} </td>
<td>\embed{reply 8,5} </td>
<td>\embed{reply 9,5} </td>
<td>\embed{reply 10,5} </td>
</tr>

</table>



}

\answer{Cumulatieve aantal}{\effc1}{type=numeric}
\answer{Cumulatieve aantal}{\effc2}{type=numeric}
\answer{Cumulatieve aantal}{\effc3}{type=numeric}
\answer{Cumulatieve aantal}{\effc4}{type=numeric}
\answer{Cumulatieve aantal}{\effc5}{type=numeric}

\answer{Frequentie}{\freq1}{type=numeric}
\answer{Frequentie}{\freq2}{type=numeric}
\answer{Frequentie}{\freq3}{type=numeric}
\answer{Frequentie}{\freq4}{type=numeric}
\answer{Frequentie}{\freq5}{type=numeric}


