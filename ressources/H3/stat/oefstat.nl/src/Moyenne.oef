\title{Gemiddelden}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\text{nom=slib(lang/fname nl boy)}
\integer{mm=randint(30..80)}
\integer{dev=20}
\integer{min=\mm-\dev}
\integer{max=\mm+\dev}
\real{p=randint(\min..\max)/10}
\real{s=randint(\min..\max)/10}
\real{t=randint(\min..\max)/10}
\real{r=rint(10*(\p+\s+\t)/3)/10} 

\statement{\nom heeft voor een eerste proefwerk het cijfer <b>\p</b> gehaald.<br>
Voor een tweede proefwerk behaalde \HIJ een <b>\s</b>. <br>
Voor een derde proefwerk haalde \HIJ  het cijfer <b>\t</b>.<br>
Wat is  \nom 's  gemiddelde cijfer?<br>
Rond je uitkomst af op 1 cijfer achter de komma  <br>
}


\answer{<b>\nom 's gemiddelde cijfer:</b>}{\r}{type=default}
