\title{Statistiek}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{n=randint(40,50,60,70)}

\text{a=slib(stat/random \n,0,30)}
\text{a=wims(declosing \a)}
\text{tableau= <table bgcolor="skyblue"
 align="center">}
\for{i=0 to ceil(\n/10)}{
\text{tableau= \tableau <tr align="center">}
  \for{j=1 to 10}{ 
	\if{10*\i+\j <=\n }{\real{u=item(10*\i+\j, \a)+160}
\text{tableau= \tableau <td> &nbsp;&nbsp;  \u &nbsp; &nbsp; </td>}
	}{\text{tableau= \tableau <td> &nbsp;&nbsp;  &nbsp; &nbsp; </td>}
	}
}
\text{tableau= \tableau </tr>}
}
\text{liste=[0,5,10,15,20,25,30]}
\text{liste2=[160,165,170,175,180,185,190]}
\text{tableau=\tableau</table>}
text{d=slib(stat/freq [\a],\liste)}
\text{c=slib(stat/effectif [\a],\liste)}
\text{c=item(1,\c)}
\text{b=pari(print(\c/\n))}
\text{c=wims(declosing \c)}
\text{b=wims(declosing \b)}
\real{freq1=ceil(item(1,\b)*1000)/10}
\real{freq2=ceil(item(2,\b)*1000)/10}
\real{freq3=ceil(item(3,\b)*1000)/10}
\real{freq4=ceil(item(4,\b)*1000)/10}
\real{freq5=ceil(item(5,\b)*1000)/10}
\real{freq6=ceil(item(6,\b)*1000)/10}
\text{eff1=item(1,\c)}
\text{eff2=item(2,\c)}
\text{eff3=item(3,\c)}
\text{eff4=item(4,\c)}
\text{eff5=item(5,\c)}
\text{eff6=item(6,\c)}
\text{human=randomitem(jongens,meisjes)}
\text{histo=slib(stat/histo [\c],\liste2,ytics 10,xtics)}
 
\statement{De lengte van de \n \human van het plaatselijke jeugdvoetbal elftal
is:

<p>
\tableau
Maak de onderstaande tabel verder af:
<table align="center" border=1>

<tr align="center"><th>Lengte</th>
<td>\(\lbrack 160,165 \lbrack)</td>
<td>\(\lbrack 165,170 \lbrack)</td>
<td>\(\lbrack 170,175 \lbrack)</td>
<td>\(\lbrack 175,180 \lbrack)</td>
<td>\(\lbrack 180,185 \lbrack)</td>
<td>\(\lbrack 185,190 \rbrack)</td>
</tr>

<tr align="center"><th>Aantal</th>
<td>\embed{reply 1,5} </td>
<td>\embed{reply 2,5} </td>
<td>\embed{reply 3,5} </td>
<td>\embed{reply 4,5} </td>
<td>\embed{reply 5,5} </td>
<td>\embed{reply 6,5} </td>
</tr>

<tr align="center"><th>Frequentie (%)</th>
<td>\embed{reply 7,5} </td>
<td>\embed{reply 8,5} </td>
<td>\embed{reply 9,5} </td>
<td>\embed{reply 10,5} </td>
<td>\embed{reply 11,5} </td>
<td>\embed{reply 12,5} </td>
</tr>

</table>
<p> 
Rond de frequenties af op 0.1% nauwkeurig
}

\hint{Hier zie je het Histogram
\draw{400,200}{\histo}
}
\feedback{1=1}{hier zie je het Histogram
\draw{400,200}{\histo}
}

\answer{Aantal 1}{\eff1}{type=numeric}
\answer{Aantal 2}{\eff2}{type=numeric}
\answer{Aantal 3}{\eff3}{type=numeric}
\answer{Aantal 4}{\eff4}{type=numeric}
\answer{Aantal 5}{\eff5}{type=numeric}
\answer{Aantal 6}{\eff6}{type=numeric}
\answer{Frequentie 1}{\freq1}{type=numeric}
\answer{Frequentie 2}{\freq2}{type=numeric}
\answer{Frequentie 3}{\freq3}{type=numeric}
