\title{Gemiddelden en co&euml;fficienten}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\text{nom=randomitem(Jan,Piet,Klaas, Albert, Emmanuelle, Stefan, Eric, 
Marcel,Marie, Alexander, Marga, Laura,Carla, Lucie)}
\integer{m=random(1..10)}
\integer{f=random(1..10)}
\integer{p=random(1..10)}
\integer{cm=random(2, 7)}
\integer{cf=random(2, 7)}
\integer{cp=random(2, 7)}
\real{r=rint(10*(\m*\cm+\f*\cf+\p*\cp)/(\cm+\cf+\cp))/10}  

\statement{\nom heeft gemiddeld een \m gehaald voor wiskunde (het aantal toetsen was \cm)<br>
Voor frans heeft \nom een \f gemiddeld gescoord (het aantal toetsen was  \cf) en<br>
voor natuurkunde heeft \nom  een \p gemiddeld (het aantal toetsen was  \cp).  
Wat is het totale gemiddelde van \nom ? <br>
Rond je antwoord af op 1 cijfer achter de komma nauwkeurig}


\answer{Totaal gemiddelde}{\r}{type=default}