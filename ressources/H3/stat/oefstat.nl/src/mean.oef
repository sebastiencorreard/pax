\title{Statistisch gemiddelde}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{nb=randint(15..20)}
\integer{neff=randint(20..30)}
\text{eff=slib(stat/random \nb-1, 0,\neff)}
\text{eff=wims(values x*0.5 for x in \eff)}
\text{moy=item(1,slib(stat/arithmean \eff))}
\text{liste=wims(sort  numeric item \eff)}
\text{maxi=wims(item -1 of  \liste)}
\text{mini=wims(item 1 of  \liste)}
\real{etendue=\maxi-\mini}
\text{table=<th>Waarden </th>}
\for{i=1 to \nb}{
	\text{a=item(\i,\eff)}
	\text{table=\table <td> \a </td>}
}

\statement{
Zie hier een statistische reeks; 
	<p> 
	<table align="center" border="1">
	 <tr align ="center">\table </tr>
	 </table>
	 
<p>
Bereken van deze statistische reeks 
<ul><li>het gemiddelde  : \embed{reply 1, 6}
</li>
<li>de maximale waarde : \embed{reply 2, 6}
</li> 
<li>de minimale waarde : \embed{reply 3, 6}
</li>
<li>de spreidingsbreedte: \embed{reply 4, 6}
</li>
</ul>
}

\answer{Gemiddelde}{\moy}{type=numeric}
\answer{Maximium}{\maxi}{type=numeric}
\answer{Minimum}{\mini}{type=numeric}
\answer{Spreidingsbreedte}{\etendue}{type=numeric}

\feedback{\reply4-\reply2+\reply3 !=0}{
	<font color="red">De spreidingsbreedte is het maximum - het minimum.
	</font>
}
