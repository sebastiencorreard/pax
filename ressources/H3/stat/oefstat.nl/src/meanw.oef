\title{gemiddelde}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{nb=randint(10..15)}
\real{neff=randint(20..30)}
\text{eff=slib(stat/random  \nb-1, 0,\neff)}
\text{coeff=slib(stat/random \nb-1,1,4)}
\text{moy=item(1,slib(stat/arithmean \eff;\coeff))}
\text{liste=wims(sort  numeric item \eff)}
\text{maxi=wims(item -1 of  \liste)}
\text{mini=wims(item 1 of  \liste)}
\real{etendue=\maxi-\mini}
\text{table=<th>Waarden </th>}
\text{table1=<th>Coefficienten</th>}
\for{i=1 to \nb}{
	\text{a=item(\i,\eff)}
	\text{b=item(\i,\coeff)}
	\text{table=\table <td> \a </td>}
	\text{table1=\table1 <td> \b </td>}
}

\statement{
Zie hier een statistische reeks met bijbehorende coefficienten:: 
	<p> 
	<table align="center" border=1>
	 <tr align ="center">\table </tr>
	 <tr align ="center">\table1 </tr>
	 </table>
	 
<p>
Bereken voor deze serie statistische gegevens:
<ul><li>het gemiddelde  : \embed{reply 1, 6}
</li>
<li> de maximale waarde : \embed{reply 2, 6}
</li> 
<li> de minimale waarde : \embed{reply 3, 6}
</li>
<li> de spreidingsbreedte : \embed{reply 4, 6}
</li>
</ul>
}

\answer{ het gemiddelde}{\moy}{type=numeric}
\answer{ het maximum}{\maxi}{type=numeric}
\answer{ het minimum}{\mini}{type=numeric}
\answer{ de spreidingsbreedte}{\etendue}{type=numeric}


\feedback{\reply4-\reply2+\reply3 !=0}{
	<font color=red>De spreidingsbreedte is gelijk aan het verschil tussen de maximale
	waarde en de minimale waarde
	</font>
}
