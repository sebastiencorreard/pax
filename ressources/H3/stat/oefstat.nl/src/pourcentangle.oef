\title{Cirkeldiagram en hoek}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{n=randint(4..6)}
\text{ss=100}
\for{i=1 to \n-1}{
\text{u=randint(8..20)}
\if{\i=1}{\text{s=\u}}{\text{s=\s,\u}}
\real{ss=\ss-\u}}
\text{s=\s,\ss}
\text{shu=shuffle(6)}
\text{listecouleur=red,skyblue,orange,grey,green,purple}
\text{listenl=rood, blauw ,oranje ,grijs, groen, paars}
\text{pos=randint(1..\n)}
\text{couleur=item(item(\pos,\shu), \listenl)}
\integer{ind=randint(10..30)*100}
\real{rep= round(item(\pos,\s)/100*\ind)}
\text{dessin= ellipse 0,0,2,2,black
line 0,0,1,0,black}
\text{anglet=0}
\text{pos=randint(1..\n)}
\for{i=1 to \n}{
\real{angle=item(\i,\s)*2*pi/100}
\real{point=\anglet+\angle/2}
\text{couleur=item(item(\i,\shu),\listecouleur)}
\real{anglet=\anglet+\angle}
\text{dessin=\dessin
line 0,0,cos(\anglet),sin(\anglet),black
fill  cos(\point)/2,sin(\point)/2, \couleur}
\if{\i = \pos}{}{\text{dessin=\dessin
text black, 2*cos(\point)/3,2*sin(\point)/3, medium, item(\i,\s)%
}}}


\text{couleur=item(item(\pos,\shu), \listenl)}
\integer{ind=randint(10..30)*100}
\real{rep= round(item(\pos,\s)/100*360)}

\statement{
Hieronder zie je een cirkeldiagram van een populatie met \ind individuen met
\n eigenschappen, weergegeven door de verschillende kleuren:  
<center>
 \draw{300,300}
{transparent white
xrange -1.5,1.5
yrange -1.5,1.5
\dessin}
</center>
Wat is de hoek in graden die hoort bij het aantal individuen met de eigenschap \couleur ?
<br>Rond je getal af op hele graden nauwkeurig . }

\answer{Hoek:}{\rep}{type=numeric}
