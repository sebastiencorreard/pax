%%%%%%%%%%%%%%%%   Redéfinitions %%%%%%%%%%%%%%%%%%%%%

%\theoremstyle{plain}

%\theoremstyle{break}
%\theoremheaderfont{\scshape}
%\theorembodyfont{\normalfont}

\newtheorem{defi}[defi]{Définition : \titdefinition}
\newtheorem{defn}[defi]{\titdefinition}

\newtheorem{thm}{\tittheoreme}[section]
\newtheorem{prop}{Proposition : \titproposition}
\newtheorem{theo}{Théorème : \tittheoreme}
\newtheorem{regle}{Règle}

\newtheore{rqm}{Remarques : \titremarque}
\newtheorem{rmq}{Remarque : \titremarque}
\newtheorem{rmqs}[rem]{Remarques : \titremarques}

\newtheorem{exemple}{Exemple  : \titexemple }[section]
\newtheorem{eg}{Exemple : \titexemple }[section]
\newtheorem{egs}[eg]{Exemples : \titexemples }

\newtheorem{exercice}{Exercice : \titexercice}
\newtheorem{exo}{Exercice : \titexercice}
\newtheorem{exos}[exercice]{Exercices : \titexercices}
\newtheorem{sol}[exercice]{Solution : \titsolution}
\newtheorem{demo}{Démonstration : \titpreuve}

\newtheorem{rap}{Rappel : \titrappel}
\newtheorem{rappel}{Rappel : \titrappel}

\newtheorem{boen}{}
\newtheorem{frame}{.}
%commenter l'une des deux lignes suivantes
\newtheorem{exowims}{\titexerciceswims}
%\excludecomment{exowims}
%excludecomment{boen}
\defwims\textbf#1{<b>#1</b>}
\defwims\imgreload{<img src="gifs/doc/etoile.gif" alt="rechargez" style="width:20px;height;20px" />}
\def\email#1{}
\defwims\textcolor#1#2{<span style="color:#1">#2</span>}


\environmentwims{proof}[1]{\preuve}{<div class="dem">}{</div>}
\environmentwims{frame}[1]{Frame}{<div class="frame">}{</div>}
\defwims\emph#1{<span class="bold" style="color:green">#1</span>}

\defwims\thispagestyle#1{}

%%%%%%%%%%%%%%% Options %%%%%%%%%%%%%

\samestyle{thm,prop,theo,regle,exowims}
\samestyle{defn,defi}
\samestyle{rqm,rmq,rmqs}
\samestyle{exemple,eg,egs}
\samestyle{exercice,solution,sol,exo,exos,exowims}
\sasmestyle{rap,rappel}
\samestyle{dem,demo}

\typefold{footnote}
\wimsoption{depth=4} % 4 par défaut profondeur des sections et co de style link
\wimsoption{toc_down,toc_left} %configuration des tables de matières
\wimsoption{numero,tooltip}


