<div class="defn"> <span class="defn">Définition : </span>On appelle
 <span class="definition"> effectif
 d'une valeur de caractère </span> (ce que l'on est
 en train d'étudier, dans les exemples précédents les notes d'un
 élève), le nombre de fois qu'apparaît
 cette valeur.
</div>
\def{integer n=randint(15..20)}
\def{integer m=randint(5..7)}
\def{text serie=slib(stat/random \n,0,\m)}
\def{text serie2=wims(sort numeric item \serie)}
\def{text min=item(1,\serie2)}
\def{text max=item(-1,\serie2)}
\def{text ligne1=<th>Série</th>}
\def{text ligne2=<th>Effectifs </th>}
\def{text ligne0=<th>Valeurs </th>}
\def{text liste=shuffle(8)}
\def{text liste=0,wims(sort numeric item \liste)}
\def{text c=slib(stat/effectif [\serie],[\liste])}
\def{text c=wims(declosing item(1,\c))}
 \for{i=1 to \n}{
    \def{real a=item(\i,\serie)}
    \def{real b=item(\i,\c)}
    \def{real l=\i-1}
    \def{text ligne1=\ligne1 <td>\a</td>}
    \def{text ligne2=\max >= \l? \ligne2 <td>\b</td>}
    \def{text ligne0=\max >= \l? \ligne0 <td>\l</td>}
 }
