<div class="exemple" id="histo">

\def{text n=randint(100,70)}
\def{integer m=randint(6..9)}
\def{integer u=randint(2..10)}
\def{integer v=randint(1..10)}
\def{text a=slib(stat/random \n,0,\v*(\m-1))}
\def{text a=wims(declosing \a)}
\def{text liste=[0,5,10,15,20,25,30]}

\for{i=0 to \m-1}
{\def{integer s= \u+\v*\i}
\def{integer s1=\i*\v}
\if{\i=0}{\def{text liste2=\s}\def{text liste=\s1}}{\def{text liste2=\liste2,\s}
\def{text liste=\liste,\s1}}}
\def{text liste=[\liste]}
\def{text liste2=[\liste2]}
\def{text c=slib(stat/effectif [\a],\liste)}
\def{text c=item(1,\c)}
\def{text histo=slib(stat/histo \c,\liste2,ytics 10,xtics,color blue)}
\reload{<img src="gifs/doc/etoile.gif" alt="rechargez" width="20" height="20"  />}{histo}
<div class="wimscenter">\draw {400,200}{\histo}</div>
</div>