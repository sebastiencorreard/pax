<a id="subdiagrammes_circulaires"></a><div class="frame">   
    Les diagrammes circulaires : il y a proportionnalité entre les mesures des angles et l'effectif associé à un caractère.
</div>
<div class="frame">   <br class="spacer">	\def{integer n=randint(15..20)}
	\def{integer m=randint(5..7)}
	\def{text serie=slib(stat/random \n,0,\m)}
	
	\def{text serie2=wims(sort numeric item \serie)}
	\def{text min=item(1,\serie2)}
	\def{text max=item(-1,\serie2)}
	
	
	\def{text ligne1=<td class="tabular_cell" >Série</td>}
	\def{text ligne2=<td class="tabular_cell" >Effectifs </td>}
	\def{text ligne0=<td class="tabular_cell" >Valeurs </td>}
	\def{text lignef=<td class="tabular_cell" > Fréquences </td>}
	\def{text lignepour=<td class="tabular_cell" > Pourcentages </td>}
	\def{text lignealpha=<td class="tabular_cell" > Angles </td>}
	
	\def{text liste=shuffle(8)}
	
	\def{text liste=0,wims(sort numeric item \liste)}
	
	\def{text c=slib(stat/effectif [\serie],[\liste])}<br class="spacer">	\def{text c=wims(declosing item(1,\c))}
	
	\def{text valeur_his=}
	\def{text caract_his=}
	\def{text caract_alpha=}
	 \for{i=1 to \n}{
	    \def{real a=item(\i,\serie)}
	    \def{real b=item(\i,\c)}
	    \def{real l=\i-1}
		\def{integer f=1000*\b/\n}
		\def{real f=\f/1000}
		\def{real p=\f*100}
		\def{real alpha=\f*360}
	    \def{text ligne1=\ligne1 <td class="tabular_cell" >\a</td>}
	    \def{text ligne2=\max >= \l? \ligne2 <td class="tabular_cell" >\b</td>}
	    \def{text ligne0=\max >= \l? \ligne0 <td class="tabular_cell" >\l</td>}
	    \def{text lignef=\max >= \l? \lignef <td class="tabular_cell" >\f</td>}
	    \def{text lignealpha=\max >= \l? \lignealpha <td class="tabular_cell" >\alpha</td>}
	    \def{text lignepour=\max >= \l? \lignepour <td class="tabular_cell" >\p</td>}
		\def{text caract_his=\max >= \l? wims(append item \l to \caract_his)}
		\def{text valeur_his=\max >= \l? wims(append item \b to \valeur_his)}
		\def{text valeur_alpha=\max >= \l? wims(append item \alpha to \valeur_alpha)}
		
	 }
	
	
