<td>
!insmath \lbrack 165,170 \lbrack
</td>
<td>
!insmath \lbrack 170,175 \lbrack
</td>
<td>
!insmath \lbrack 175,180 \lbrack
</td>
<td>
!insmath \lbrack 180,185 \lbrack
</td>
<td>
!insmath \lbrack 185,190 \lbrack
</td>
</tr>
<tr><th>Effectif</th>
<td>$m_eff1</td>
<td>$m_eff2 </td>
<td>$m_eff3 </td>
<td>$m_eff4 </td>
<td>$m_eff5 </td>
<td>$m_eff6</td>
</tr>
<tr><th>Fréquence (%)</th>
<td>$m_freq1 </td>
<td>$m_freq2 </td>
<td>$m_freq3 </td>
