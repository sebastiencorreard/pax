<a id="subetendue"></a>
<div class="frame"><h3 class="l2w_content defn">Définition &#58; $m_titdefinition [Étendue]</h3><div class="l2w_content defn">
		L'étendue d'une série statistique est la différence entre la plus grande et la plus petite des valeurs du caractère.
	</div><br class="spacer">	Dans la série statistique suivante &#58;<br class="spacer">	
!set tmp0=!randint 7, 15

!set m_n=$[rint($(tmp0))]

	
!set m_serie=

	 
!for m_u=1 to $m_n 
 
	  
!set tmp0=!randint 10, 99

!set m_s=$[rint($(tmp0))]

	  
!set tmp0=!append item $m_s to $m_serie

!set m_serie=$(tmp0)

	
!next

	 
!set tmp0=!sort numeric item $m_serie

!set m_serieord=$(tmp0)

	 
!set m_min=$[rint($(m_serieord[1]))]

	 
!set m_max=$[rint($(m_serieord[$m_n]))]

	 
!set m_etendue=$[rint($m_max-$m_min)]

	 
	  <div class="center" >$m_serie.</div>
<br/>
	 La plus grande valeur est $m_max, la plus petite est $m_min. L'étendue de cette série est donc 
!insmath e=\max-\min=\etendue

	 <br class="spacer"><h3 class="l2w_content exercice">Exercice &#58; $m_titexercice</h3><div class="l2w_content exercice"><ul class="itemize"><li>  
!read primitives.phtml 13, exercise, module=H3/stat/oefstat.fr&cmd=new&exo=mediane, Médiane 1 

		 </li><li>  
