!set titb=Etendue
!set keyw=
!set datm=20030521
!set prev=moyennepond
!set next=frequence
!set upbl=tocmoyenne
!set dat1=19000101
!set dat2=24000101

!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
!exit

:content
<div class="defn"> <span class="defn">Définition &#58; </span>
 <span class="definition"> L'étendue </span> d'une série statistique est la différence entre la plus
 grande et la plus petite des valeurs du caractère.
</div>
<br/>
Dans la série statistique suivante,

!read primitives.phtml 1, reload, <img src="gifs/doc/etoile.gif" alt="rechargez" width="20" height="20" /> 

<br/>
!set tmp0=!randint 8, 10

!set m_n=$[rint($(tmp0))]


!set m_ligne1=<th>Notes </th>



!set m_ligne2=<th>Coeff. </th>


 
!for m_i=1 to $m_n 

 
!set tmp0=!randint 13, 35

!set m_a=$[$(tmp0)/2]

  
!if $m_i=1 

!set m_max=$m_a


 
!set m_min=$m_a


!else

  
 
!set m_ligne1=$m_ligne1 <td>$m_a</td>


 
!set m_max=$[max($m_max,$m_a)]

 
!set m_min=$[min($m_min,$m_a)]

 
!endif

!next

<table class="tabledocstat wimscenter wimsborder"><tr>$m_ligne1</tr></table>

!set m_M=$[$m_max-$m_min]

l'étendue est de
$m_max - $m_min = $m_M.
<div class="exercice"> <span class="exercice">Exercices &#58;</span> 
!read primitives.phtml 2, exercise, cmd=new&module=H3/stat/oefstat.fr&exo=mean&qnum=1&qcmlevel=3&scoredelay=, Moyenne, étendue 
,

!read primitives.phtml 3, exercise, cmd=new&module=H3/stat/oefstat.fr&exo=meanw&qnum=1&qcmlevel=3&scoredelay=, Moyenne avec coefficients II 

</div>

