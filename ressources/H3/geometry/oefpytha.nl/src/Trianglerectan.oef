\title{Omgeschreven cirkel}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\translatro{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}

\matrix{donne=
3,4,5
6,8,10
9,12,15
12,16,20
15,20,25
5,12,13
7,24,25
}
\text{ligne=randomrow(\donne)}
\text{AC=item(1,\ligne)}
\text{BC=item(2,\ligne)}
\text{AB=item(3,\ligne)}
\real{angle=asin(\AC/\AB)*2}
\real{x0=cos(\angle)*1.7}
\real{y0=sin(\angle)*1.7}

\statement{
<p><center>
\draw{200,200}{
xrange -2,2
yrange -2,2
circle 0,0,175,red
line -1.7,0,1.7,0,black
text black,-1.9,0.1,medium,A
text black,1.8,0.1,medium,B
lines blue,-1.7,0,\x0,\y0,1.7,0
text black,\x0,\y0+0.3,medium,C
line 0,-0.05,0,0.05,black 
text black,-0.05,0.28,medium,O
}
</center> <p>
AC is \BC cm en BC \AC cm. Hoe lang is AB (in cm) ? 
}

\answer{AB}{\AB}
