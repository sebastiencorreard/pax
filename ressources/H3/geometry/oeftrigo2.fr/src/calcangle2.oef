\title{Calculette et trigonométrie 3}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\integer{prec=randint(1,10,100)}
\real{precision=1/\prec}

\text{fonction=sin,cos,tan}
\text{fonction=shuffle(\fonction)}
\text{rep=}
\text{fonct=}
\text{name=x,y,z}
\for{i=1 to 3}{
 \text{fn=item(\i,\fonction)}
 \integer{a=random(5..50)}
 \integer{b=random(5..50)}
 \if{\fn!=tan}{
  \integer{a=min(\a,\b)}
  \integer{b=max(\a,\b)}
 }
 \text{val=simplify(\a/\b)}
 \text{aff=texmath(\val)}
 \integer{tmp=arc\fn(\val)/pi*180*\prec}
 \real{tmp=\tmp/\prec}
 \text{rep=wims(append item \tmp to \rep)}
 \text{tmp=\fn(\name[\i])=\aff}
 \text{fonct=wims(append item \tmp to \fonct)}
}

\statement{A l'aide de la calculette, donner les valeurs arrondies à
  \precision degré près des angles suivants :
<ul><li>
  <label for="reply1">\(\fonct[1]); \(x \simeq \) </label> \embed{r1,10}
  </li><li><label for="reply2">\(\fonct[2]\) ; \(y \simeq\)</label> \embed{r2,10}
  </li><li><label for="reply3">\(\fonct[3]\) ;  \(z \simeq \)</label> \embed{r3,10}
</li></ul>
}

\answer{\(\fonct[1])}{\rep[1]}{type=numexp}
\answer{\(\fonct[2])}{\rep[2]}{type=numexp}
\answer{\(\fonct[3])}{\rep[3]}{type=numexp}
