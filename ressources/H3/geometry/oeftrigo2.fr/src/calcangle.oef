\title{Calculette et trigonométrie 2}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\integer{prec=randint(1,10,100)}
\real{precision=1/\prec}

\text{fonction=sin,cos,tan}
\text{fonction=shuffle(\fonction)}
\text{rep=}
\text{fonct=}
\text{name=alpha,beta,gamma}
\for{i=1 to 3}{
 \text{fn=item(\i,\fonction)}
 \if{\fn=tan}{
  \real{val=randint(10..500)/100}
 }{
  \real{val=randint(10..100)/100}
 }
 \integer{tmp=arc\fn(\val)/pi*180*\prec}
 \real{tmp=\tmp/\prec}
 \text{rep=wims(append item \tmp to \rep)}
 \text{tmp=\fn(\name[\i])=\val}
 \text{fonct=wims(append item \tmp to \fonct)}
}

\statement{À l'aide de la calculette, donner les valeurs arrondies
  à \precision degré près des angles suivants :
<ul><li>
  <label for="reply1">\(\fonct[1]\); \(\alpha \simeq \)</label> \embed{r1,10}
  </li><li><label for="reply2">\(\fonct[2]\) ; \(\beta \simeq\)</label> \embed{r2,10}
  </li><li><label for="reply3">\(\fonct[3]\) ; \(\gamma \simeq \)</label> \embed{r3,10}
</li></ul>
}

\answer{\(\fonct[1])}{\rep[1]}{type=numexp}
\answer{\(\fonct[2])}{\rep[2]}{type=numexp}
\answer{\(\fonct[3])}{\rep[3]}{type=numexp}
