!set title=Vocabulaire 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1

!ifval $val2 notwordof 0 1
val2=$[rint(1)]
!endif
tmp=!trim A,B,C	T,I,R	E,F,G	D,E,F
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
val11=$[rint(240)]
val12=$[rint(140)]
tmp0=!shuffle $val9,$val10

val13=$(tmp0)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!item 2 of $val13

val15=$(tmp0)
val16=segment 20,20,20,120,black	segment 20,120,220,120,black	segment 20,20,220,120,black	segment 21,110,30,110,red	segment 30,110,30,119,red	text black,10,115,medium,$val8	text black,10,10,medium,$val14	text black,230,115,medium,$val15
tmp=!trim \([$val9$val10]\),Quelle est l'hypoténuse du triangle \($val8$val9$val10\)	\([$val8$val10]\),Quel est le côté adjacent à l'angle \(\widehat{$val8$val10$val9}\)	\([$val8$val9]\),Quel est le côté opposé à l'angle \(\widehat{$val8$val10$val9}\)
val17=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!item 1 of $val18

val19=$(tmp0)
tmp0=!item 2 of $val18

val20=$(tmp0)
tmp0=!word 3 to -1 of $val20

val21=$(tmp0)
val22=\([$val9$val10]\),\([$val8$val10]\),\([$val8$val9]\)
val23=Le triangle \($val8$val9$val10\) est rectangle en \($val8\).
replytype1=clickfill
replyname1=réponse
replygood1=$val19|$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val2=1 
$()	  <div class="wims_columns"><div class="medium_size img_col">	     
!read oef/draw.phtml $val11,$val12 \
$val16 
$()</div>	    <div class="medium_size text_col">$val23 $val20? 
!else
$() 	    <div>$val23 $val20?	   
!endif
$()	  <div class="spacer">	  <b>Votre réponse</b> :	  $val21 est  
!read oef/embed.phtml r1,$val6 
$().	  </div>	  </div>	  
!if $val2=1 
$()</div> 
!endif
$()	
$()
!exit

