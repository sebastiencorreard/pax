!set title=Vocabulaire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r,r,r
varcnt=40
prevarcnt=39
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(250)]
tmp0=!random 0, 7

val7=$[$(tmp0)]
val8=$[$val6/2*0.8]
tmp=!nonempty items pi/2,pi/3,pi/4,pi/5,2*pi/3,3*pi/4,2*pi/5,4*pi/5

tmp0=!randitem $tmp
val9=$[$(tmp0)]
val10=$[rint($val8*cos($val7))]
val11=$[rint($val8*sin($val7))]
val12=$[rint($val8*cos($val7+pi))]
val13=$[rint($val8*sin($val7+pi))]
val14=$[rint($val8*cos($val7+$val9))]
val15=$[rint($val8*sin($val7+$val9))]
val16=$[rint(sqrt(($val10-$val14)^2+($val11-$val15)^2))]
val17=$[rint(sqrt(($val14-$val12)^2+($val15-$val13)^2))]
val18=$[rint(max($val17,$val16))]
val19=$[rint($val18/(10*$val16)*($val10-$val14)+$val14)]
val20=$[rint($val18/(10*$val16)*($val11-$val15)+$val15)]
val21=$[rint($val18/($val17*10)*($val12-$val14)+$val19)]
val22=$[rint($val18/($val17*10)*($val13-$val15)+$val20)]
val23=$[rint($val18/($val17*10)*($val12-$val14)+$val14)]
val24=$[rint($val18/($val17*10)*($val13-$val15)+$val15)]
val25=$val10,$val11,$val12,$val13,$val14,$val15
val26=$[rint(-0.5*$val6)]
val27=$[rint(0.5*$val6)]
val28=$[rint(($val10+$val14)/2+$val27-15)]
val29=$[rint(-($val11+$val15)/2-$val26-10)]
val30=$[rint(($val10+$val12)/2+$val27-15)]
val31=$[rint(-($val11+$val13)/2-$val26-10)]
val32=$[rint(($val12+$val14)/2+$val27-15)]
val33=$[rint(-($val13+$val15)/2-$val26-10)]
val34=$[rint((2*$val7+pi+$val9)/2*180/pi)]
val35=$[rint(($val7+pi)*180/pi)]
val36=$[rint(0.95*$val10)]
val37=$[rint(0.95*$val11)]
val38=$[rint(0.08*($val14-$val10)+$val10)]
val39=$[rint(0.08*($val15-$val11)+$val11)]
tmp0=!shuffle A,B,C

val40=$(tmp0)
val41=$(val40[1])
val42=$(val40[2])
val43=$(val40[3])
!readproc oef/draw.phtml $val6,$val6 \
xrange $val26,$val27	yrange $val26,$val27	poly red,$val14,$val15,$val19,$val20,$val21,$val22,$val23,$val24,$val14,$val15	triangle $val25,green	fill ($val19+$val23)/2,($val20+$val24)/2,red	arc $val10,$val11,30,30,$val34,$val35,green	fill ($val36+$val38)/2,($val37+$val39)/2,green	text black,$val10+$val10/abs($val10)*10,$val11+$val11/abs($val11)*10,medium,$val41	text black,$val12+$val12/abs($val12)*10,$val13+$val13/abs($val13)*10,medium,$val42	text black,$val14+$val14/abs($val14)*10,$val15+$val15/abs($val15)*10,medium,$val43 
tmp0=$ins_url
val44=$(tmp0)
replytype1=dragfill
replyname1=
replygood1=Adj
replytype2=dragfill
replyname2=
replygood2=Opp
replytype3=dragfill
replyname3=
replygood3=Hypo
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/special.phtml imagefill $val44,$val6 x $val6,40x27	r1,$val28 x $val29	r2,$val32 x $val33	r3,$val30 x $val31 
$()</div>	 <div class="medium_size text_col">	Trouvez l'hypoténuse de ce triangle rectangle et	les côtés adjacent et opposé à 
!insmath \widehat{$(val40[3])$(val40[1])$(val40[2])}
$() :	placez les étiquettes au bon endroit.	<div class="wims_instruction">	<b>Consigne</b> : L'étiquette <span style="color:green">Hypo</span> représente	l'hypoténuse du triangle rectangle 
!insmath ABC
$() et les étiquettes	<span style="color:green">Adj</span> et <span style="color:green">Opp</span> représentent	respectivement les côtés adjacent et opposé à 
!insmath \widehat{$(val40[3])$(val40[1])$(val40[2])}
$().	</div>	 </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,28,29,30,31,32,33,40,44
embedcnt=1
