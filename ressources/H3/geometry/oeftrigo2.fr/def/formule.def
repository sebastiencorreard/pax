$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val36=$[1.1*max($val12,$val13)]
val37=2*$val12/3,$val13/3
val38=-$(val37[1]),-$(val37[2])
val39=$val12 -$(val37[1]),-$(val37[2])
val40=$val12-$(val37[1]),$val13-$(val37[2])
val36=-$val36,$val36
val41=xrange $val36	yrange $val36	linewidth 2	triangle $val38,$val39,$val40,green	arc $val38,10,10,0,$val15,red	text black, $val38, medium,$(val8[1])	text black, $val39, medium,$val7	text black, $val40, medium,$(val8[2])

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>Lorsqu'on effectue la fin du calcul, on trouve : 
!insmath $val22
$() = $val24 cm.	  Voici le dessin qui correspondait à l'énoncé :<div class="wimscenter">	   
!read oef/draw.phtml 200,200 \
$val41 
$()</div>
$()</div>
!endif

!exit

:test

!exit

:stat
