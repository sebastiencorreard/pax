!set title=Calculette et trigonométrie 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,10,100

val6=$[rint($(tmp0))]
val7=$[1/$val6]
val8=sin,cos,tan
tmp0=!shuffle $val8

val8=$(tmp0)
val9=
val10=
val11=alpha,beta,gamma
!for val12 =1 to 3 
tmp0=!item $val12 of $val8

val13=$(tmp0)
!if $val13=tan 
tmp0=!randint 10, 500

val14=$[$(tmp0)/100]
!else
tmp0=!randint 10, 100

val14=$[$(tmp0)/100]
!endif
val15=$[rint(arc$val13($val14)/pi*180*$val6)]
val15=$[$val15/$val6]
tmp0=!append item $val15 to $val9

val9=$(tmp0)
val15=$val13($(val11[$val12]))=$val14
tmp0=!append item $val15 to $val10

val10=$(tmp0)
!next
replytype1=numexp
replyname1=\($(val10[1]))
replygood1=$(val9[1])
replytype2=numexp
replyname2=\($(val10[2]))
replygood2=$(val9[2])
replytype3=numexp
replyname3=\($(val10[3]))
replygood3=$(val9[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()À l'aide de la calculette, donner les valeurs arrondies	  à $val7 degré près des angles suivants :	<ul><li>	  <label for="reply1">
!insmath $(val10[1])
$(); 
!insmath \alpha \simeq 
$()</label>  
!read oef/embed.phtml r1,10 
$()	  </li><li><label for="reply2">
!insmath $(val10[2])
$() ; 
!insmath \beta \simeq
$()</label>  
!read oef/embed.phtml r2,10 
$()	  </li><li><label for="reply3">
!insmath $(val10[3])
$() ; 
!insmath \gamma \simeq 
$()</label>  
!read oef/embed.phtml r3,10 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10
embedcnt=3
