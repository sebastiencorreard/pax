\computeanswer{no}
\format{html}
\precision{10000}

\matrix{donne=
6,3,4,8
12,6,8,16
18,9,12,24
24,12,16,32}
\text{ligne=randomrow(\donne)}
\text{FG=item(1,\ligne)}
\text{HO=item(2,\ligne)}
\text{EO=item(3,\ligne)}
\text{EG=item(4,\ligne)}

\statement{<p><center>
\draw{250,250}{
xrange -25,25
yrange -25,25
circle 0,0,220,red
line -22,0,22,0,blue
circle -11,0,110,red
lines blue,-22,0,14,17,22,0
line 14,17,22,0,black
line -4.5,8.8,0,0,black
text black,-24,1,medium,E 
text black,15,19,medium,F
text black,23,1,medium,G
text black,-4,12,medium,H
text black,1,3,medium,O 
}
</center> <p>
[HO] // [FG] ; FG = \FG cm ; HO = \HO cm ; EO = \EO cm. Hoe lang is [EG] 
(in cm) ?}


\answer{Lengte van [EG]}{\EG}{type=default}
