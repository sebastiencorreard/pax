!set title=Driehoek en evenwijdige lijnen
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 10,5,12,6	12,6,14,7	14,7,16,8	16,8,20,10	20,10,24,12
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
replytype1=default
replyname1=Lengte van [DE]
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p><center>	 
!read oef/draw.phtml 200,200 \
	xrange -20,20	yrange -20,20	triangle -5,12,-15,-10,16,-10,black	line -15,-10,16,-10,red	line -10,1,5.5,1,red	text black,-5.5,14.5,medium,A	text black,-17,-10,medium,B	text black,17,-10,medium,C	text black,-12,3,medium,D	text black,6.5,3,medium,E	 
$()	</center> <p>	[DE] // [BC] ; AB = $val8 cm ; AD = $val9 cm ; BC = $val10 cm. Hoe lang is DE 	(in cm) ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10
embedcnt=0
