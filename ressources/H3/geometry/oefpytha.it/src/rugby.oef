\title{Trasformazione nel rugby}
\author{Marie-Claude, David; Guillaume, Wuthrich}
\email{marie-claude.david@math.u-psud.fr}
\language{fr}
\precision{2}
\computeanswer{no}
\range{-5..5}

L'essai est marqué à une distance c du poteau de corner
La trasformazione viene assegnata a una distanza c dalla bandierina
\integer{c=randint(1..24)}

Le joueur se met à une distance b de la ligne de fond
Il giocatore si posiziona una distanza b dalla linea di meta
\integer{b=22+randint(0..8)}

a est la distance au milieu des poteaux
a è la distanza dal centro dei pali
\real{a=sqrt(\b*\b+(35-\c)*(35-\c))}

aa est la distance au milieu du terrain
aa è la distanza a centrocampo
\real{aa=sqrt((50-\b)*(50-\b)+(35-\c)*(35-\c))}

aaa est la distance à l'entraineur
aaa è la distanza dall'allenatore
\real{aaa=sqrt((50-\b)*(50-\b)+(70-\c)*(70-\c))}

\matrix{data=A che distanza dal centro dei pali si trova la palla, \a
A che distanza dal centro del campo si trova la palla, \aa
L'allenatore vuole dare consigli al giocatore. Qual è la distanza tra il giocatore e l'allenatore, \aaa}

\text{L=randint(1..rows(\data))}
\text{question=\data[\L;1]}
\real{rep1=\data[\L;2]}
\integer{rep=round(\rep1)}
\statement{<p class="wimscenter">
<img src="\imagedir/rugby.png" alt="rugby" /></p>
<p>
Il calcio piazzato di trasformazione viene assegnato a una distanza di \(c=\c) metri dal bordo del campo. <br />
Il giocatore decide di posizionarsi a una distanza di \(b=\b) metri dalla linea di meta. <br />
\question ?</p>
<p class="wimscenter">\embed{r1}</p>
<p style="font-style:italic">Dare la risposta (in metri) approssimando all'intero più vicino.</p>}

\answer{La distance en mètre est d'environ}{\r}{type=numeric}{option=absolute}
\real{ecart=\reply1-\rep}

\condition{La risposta data è approssimata a 0.5 metri }{abs(\ecart) <= 0.5}{weight=6}
\condition{La risposta data è corretta e nel margine di approssimazione richiesto }{abs(\ecart)=0}{weight=4}
\feedback{ 1=1}{La risposta corretta è \(\rep) metri.}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\condition{La risposta data è effettivamente un'approssimazione come richiesto }{(. notin \reply1) and (/ notin \reply1)}{weight=1}
