!set title=Théorème de Pythagore (avec applet)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=pbyache@ac-aix-marseille.fr
precision=10000
oefobservation=Calcul d'une hypoténuse avec Pythagore, un applet permet à l'élève de vérifier la cohérence de sa réponse avec une équerre avant de l'envoyer

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 230,504,554	230,552,598	231,308,385	231,392,455	231,520,569	232,435,493	234,480,534	235,564,611	237,316,395	240,252,348	240,275,365	240,364,436	240,418,482	240,551,601	240,576,624	243,324,405	245,588,637	248,465,527	249,332,415	252,275,373
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[$(tmp0)/100]
tmp0=!item 2 of $val7

val9=$[$(tmp0)/100]
tmp0=!item 3 of $val7

val10=$[$(tmp0)/100]
tmp=!nonempty items 9,11

tmp0=!randitem $tmp
val11=$[$val10*$(tmp0)/10]
val12=$[2-$val8*0.998]
val13=$[-16-$val8*0.07]
val14=A=(-16,2)	B=($val13,$val12)	r=Circle[A,$val9]	s=Circle[B,$val11]	C=Intersect[r,s,1]	Segment[A,B]	Segment[A,C]	Segment[C,B]
val15=width=400	height=240	showToolBar=false	language=fr	showMenuBar=false	showAlgebraInput=false		file=square.ggb	setLabelVisible('C',true)	setLabelVisible('B',true)	setLabelVisible('A',true)	setFixed('A',true)	setFixed('B',true)
!readproc slib/geo2D/geogebra $val14, $val15 
tmp0=$slib_out
val16=$(tmp0)
replytype1=numexp
replyname1=La longueur BC est
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_left spacer">	$val16	</div>	<div class="float_right">	On considère un triangle ABC tel que AB=$val8 et AC=$val9.<br>	Quelle doit être la longueur du côté BC pour que le triangle ABC soit rectangle en A ?		<div class="wims_instruction">	<b>Après</b> avoir fait vos calculs, vous pouvez	faire afficher le triangle pour le voir avant de valider votre réponse.	Votre note ne sera pas diminuée.<br>	Pour déplacer l'équerre, utilisez le point rouge.	</div>	Entrez votre valeur de BC :	<input type="text" id="zzz" style="color:blue;background:yellow" size="5" value="$val11" />	<script type="text/javascript">	compteur=0;	function Construction() {	if(compteur<6){	ggbApplet0.evalCommand('A=(-16,2)');	ggbApplet0.evalCommand('B=($val13,$val12)');	ggbApplet0.evalCommand('r=Circle[A,$val9]');	ggbApplet0.evalCommand('s=Circle[B,'+document.getElementById("zzz").value+']');	ggbApplet0.evalCommand('C=Intersect[r,s,1]');	ggbApplet0.evalCommand('Segment[A,B]');	ggbApplet0.evalCommand('Segment[A,C]');	ggbApplet0.evalCommand('Segment[C,B]');	compteur=compteur+1;	} else {	document.getElementById("xxx").value="Trop d'essais : faites un calcul !";};	}	</script>	<input type="button" id="xxx" value="Tracer le triangle" style="color:blue;background:yellow" onclick="Construction();" >	</div>	<br class="clearall">	Réponse : La longueur de BC doit être :  
!read oef/embed.phtml r1,5	autocomplete="off" 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,11,12,13,16
embedcnt=1
