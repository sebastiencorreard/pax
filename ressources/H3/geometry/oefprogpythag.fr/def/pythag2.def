!set title="Pythagore 2"
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=pbyache@ac-aix-marseille.fr
oefobservation=Programme de calcul du calcul d'une longueur qui n'est pas l'hypoténuse, avec Pythagore
precision=10000
oefcss=<style type="text/css"> table.algo {margin-left:auto;margin-right:auto;border: 2px solid #999;} .algo1 {color:blue;} .algo2 {text-align:center;color:blue;background:yellow;} .fleche {font-size:2em;} </style> 

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 9

val6=$[rint($(tmp0))]
tmp0=!randint 1, 8

val7=$[rint($(tmp0))]
!if $val4=2 
tmp0=!randint 1, 150

val7=$[$(tmp0)/10]
!endif
!if $val4=3 
tmp0=!randint 1, 10

tmp1=!randint 3, 10

t_=!rawmath $(tmp0)/$(tmp1)
val7=!exec pari print($t_)
!endif
tmp0=!randint $val7+1, 10

val8=$[rint($(tmp0))]
!if $val4=2 
tmp0=!randint 200, 300

val8=$[$(tmp0)/10]
!endif
!if $val4=3 
tmp0=!randint 1, 4

tmp1=!randint 3, 10

t_=!rawmath $val7+$(tmp0)/$(tmp1)
val8=!exec pari print($t_)
!endif
val9=$[($val7)^2]
val10=$[rint($val9*100)/100]
val11=$[($val8)^2]
val12=$[rint($val11*100)/100]
val13=$[$val11-$val9]
val14=$[rint($val13*100)/100]
val15=$[sqrt($val13)]
val16=$[rint($val15*100)/100]

!ifval (1 notin $val4) 
val17=	<iframe src=scripts/js/wincalc.html height="250" width="300" frameborder="0" align="right">	</iframe>Voici une calculatrice.<br>Notez les résultats sur une feuille de brouillon.	<br>Quand vous avez fini vos calculs, cliquez sur "retour au travail" ci-dessous.	<br><i>Remarque</i> Il est plus pratique d'utiliser votre propre calculatrice...
!else
val17=
!endif
replytype1=numeric
replyname1=
replygood1=$[$val10]
replytype2=numeric
replyname2=
replygood2=$[$val12]
replytype3=numeric
replyname3=
replygood3=$[$val14]
replytype4=numeric
replyname4=
replygood4=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val17


!goto stat

!exit

:question
$()Complète le programme de calcul ci-dessous,	qui permet de calculer la longueur d'un côté de l'angle droit	dans un triangle rectangle.	<div class="wims_instruction">	Il faut donner des valeurs décimales arrondies à 
!insmath 10^(-2)
$() près.	</div>	<table class="algo">	<tr>	<td colspan="2" class="algo1 smaller">	  Premier côté de <br>l'angle droit :</td>	<td></td>	<td colspan="2" class="algo1 smaller">	  Deuxième côté<br> de l'angle droit :</td>	</tr>	<tr><td class="algo2" style="width:30px;">	$val7	</td>	<td></td>	<td style="width:40px;"></td>	<td style="width:30px;" class="algo2">	 
!read oef/embed.phtml r4,7	autocomplete="off" 
$()	</td><td></td></tr>	<tr><td style="width:20%" class="wimscenter fleche">&darr;</td>	<td>On met <br>au carré.</td><td></td>	<td class="wimscenter fleche" style="width:20%">&uarr;</td>	<td>On prend<br>la racine<br>carrée.</td>	</tr>	<tr><td> 
!read oef/embed.phtml r1,7	autocomplete="off" 
$()	</td><td colspan="2" class="wimscenter fleche">&rarr;</td><td>	 
!read oef/embed.phtml r3,7	autocomplete="off" 
$()	</td><td></td></tr>	<tr><td></td>	<td></td><td></td>	<td class="wimscenter fleche">&uarr;</td>	<td>On soustrait.</td>	</tr>	<tr><td></td>	<td colspan="2" class="wimscenter">	 
!read oef/embed.phtml r2,7	autocomplete="off" 
$()	</td><td class="fleche">&rarr;</td>	</tr>	<tr><td></td><td class="fleche" style="text-align:right">&uarr;</td>	<td>On met <br>au carré.</td><td></td><td></td>	</tr>	<tr><td></td><td colspan="2" class="wimscenter algo1 smaller">	Hypoténuse :</td>	</tr>	<tr><td></td><td colspan="2" style="width:30px" class="wimscenter algo2">	$val8	</td><td></td></tr>	</table>	
$()
!exit

