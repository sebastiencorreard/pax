\title{"Pythagore 2"}
\langage {fr}
\author{Paul, Byache}
\email{pbyache@ac-aix-marseille.fr}
\langage{html}
\observation{Programme de calcul du calcul d'une longueur qui n'est pas l'hypoténuse, avec Pythagore}
\precision{10000}
\css{<style type="text/css">
table.algo {margin-left:auto;margin-right:auto;border: 2px solid #999;}
.algo1 {color:blue;}
.algo2 {text-align:center;color:blue;background:yellow;}
.fleche {font-size:2em;}
</style>
}

\integer{a=random(3..9)}
\integer{x=random(1..8)}
\if{\confparm3=2}{
\real{x=randint(1..150)/10}
}
\if{\confparm3=3}{
\rational{x=randint(1..10)/randint(3..10)}
}
\integer{y=random(\x+1..10)}
\if{\confparm3=2}{
\real{y=randint(200..300)/10}
}
\if{\confparm3=3}{
\rational{y=\x+randint(1..4)/randint(3..10)}
}

\real{op1=(\x)^2}
\real{sol1=rint(\op1*100)/100}
\real{op2=(\y)^2}
\real{sol2=rint(\op2*100)/100}
\real{op3=\op2-\op1}
\real{sol3=rint(\op3*100)/100}
\real{op4=sqrt(\op3)}
\real{sol4=rint(\op4*100)/100}

\text{HINT=(1 notin \confparm3) ?
<iframe src=scripts/js/wincalc.html height="250" width="300" frameborder="0" align="right">
</iframe>Voici une calculatrice.<br>Notez les résultats sur une feuille de brouillon.
<br>Quand vous avez fini vos calculs, cliquez sur "retour au travail" ci-dessous.
<br><i>Remarque</i> Il est plus pratique d'utiliser votre propre calculatrice...:}

\statement{Complète le programme de calcul ci-dessous,
qui permet de calculer la longueur d'un côté de l'angle droit
dans un triangle rectangle.
<div class="wims_instruction">
Il faut donner des valeurs décimales arrondies à \(10^(-2)) près.
</div>
<table class="algo">
<tr>
<td colspan="2" class="algo1 smaller">
  Premier côté de <br>l'angle droit :</td>
<td></td>
<td colspan="2" class="algo1 smaller">
  Deuxième côté<br> de l'angle droit :</td>
</tr>
<tr><td class="algo2" style="width:30px;">
\x
</td>
<td></td>
<td style="width:40px;"></td>
<td style="width:30px;" class="algo2">
\embed{r4,7
autocomplete="off"}
</td><td></td></tr>
<tr><td style="width:20%" class="wimscenter fleche">&darr;</td>
<td>On met <br>au carré.</td><td></td>
<td class="wimscenter fleche" style="width:20%">&uarr;</td>
<td>On prend<br>la racine<br>carrée.</td>
</tr>
<tr><td>\embed{r1,7
autocomplete="off"}
</td><td colspan="2" class="wimscenter fleche">&rarr;</td><td>
\embed{r3,7
autocomplete="off"}
</td><td></td></tr>
<tr><td></td>
<td></td><td></td>
<td class="wimscenter fleche">&uarr;</td>
<td>On soustrait.</td>
</tr>
<tr><td></td>
<td colspan="2" class="wimscenter">
\embed{r2,7
autocomplete="off"}
</td><td class="fleche">&rarr;</td>
</tr>
<tr><td></td><td class="fleche" style="text-align:right">&uarr;</td>
<td>On met <br>au carré.</td><td></td><td></td>
</tr>
<tr><td></td><td colspan="2" class="wimscenter algo1 smaller">
Hypoténuse :</td>
</tr>
<tr><td></td><td colspan="2" style="width:30px" class="wimscenter algo2">
\y
</td><td></td></tr>
</table>
}

\answer{}{\sol1}{type=numeric}
\answer{}{\sol2}{type=numeric}
\answer{}{\sol3}{type=numeric}
\answer{}{\sol4}{type=numeric}

