!if $val6=nl 
val7=Hoe lang is , in
val8=Lengte van
val9=
val10=Le symbole \(\sslash\) signifie parallèle.
!endif
tmp=!trim 10,5,12,6	12,6,14,7	14,7,16,8	16,8,20,10	20,10,24,12
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val11

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
tmp0=!item 3 of $val12

val15=$(tmp0)
tmp0=!item 4 of $val12

val16=$(tmp0)
val17=xrange -20,20	yrange -20,20	triangle -5,12,-15,-10,16,-10,black	segment -15,-10,16,-10,red	segment -10,1,5.5,1,red	text black,-5.5,14.5,medium,A	text black,-17,-10,medium,B	text black,17,-10,medium,C	text black,-12,3,medium,D	text black,6.5,3,medium,E
!readproc oef/drawtikz.phtml 200,200 \
$val17 
tmp0=$ins_tikz
val18=$(tmp0)
replytype1=default
replyname1=$val8 \([DE]\)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val10

latex=!nosubst \begin{statement} $val9 <p> \([DE] \parallel [BC]\) ; \(AB = $val13\) \(cm\) ; \(AD = $val14\) \(cm\) ; \(BC = $val15\) \(cm\). </p> $(val7[1]) \(DE\) ($(val7[2]) \(cm\))? \par $val18 \end{statement} 


!goto stat

!exit

