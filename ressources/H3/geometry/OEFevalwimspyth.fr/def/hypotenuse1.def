tmp0=!randint 300, 350

val6=$[rint($(tmp0))]
val7=$[rint(200)]
tmp0=!shuffle A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S

val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=$(tmp0)
tmp0=!item 3 of $val8

val11=$(tmp0)
tmp0=!item 4 of $val8

val12=$(tmp0)
tmp=!translate internal $	$ to ; in 20,20,$val6-20,20,20,$val7-20	$val6-20,20,$val6-20,$val7-20,20,20	$val6-20,$val7-20,20,$val7-20,$val6-20,20	20,$val7-20,20,20,$val6-20,$val7-20

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=
val15=$val6,$val7,$val6,$val7,$val6,$val7
val16=(m-25)/(m-40)*(x)+(10-20*(m-25)/(m-40))
!for val17 =1 to 6 
evaltmp=$val16

evaltmp=!mathsubst x=($(val13[$val17])) in $evaltmp
evaltmp=!mathsubst m=($(val15[$val17])) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val18=$(tmp1)
tmp0=!append item $val18 to $val14

val14=$(tmp0)
!next
val16=(m-60)/(m-40)*(x)+(30-20*(m-60)/(m-40))
evaltmp=$val16

evaltmp=!mathsubst x=($(val13[1])) in $evaltmp
evaltmp=!mathsubst m=($val6) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val19=$(tmp1)
evaltmp=$val16

evaltmp=!mathsubst x=($(val13[2])) in $evaltmp
evaltmp=!mathsubst m=($val7) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val20=$(tmp1)
val21=triangle $val13,black	text black,$(val14[1]),$(val14[2]),medium,$val9	text black,$(val14[3]),$(val14[4]),medium,$val10	text black,$(val14[5]),$(val14[6]),medium,$val11	segment $(val13[1]),$val20,$val19,$val20,red	segment $val19,$val20,$val19,$(val13[2]),red
