!set title=Choisir la bonne propriété 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand

ansorder=c
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val11=$(tmp0)
tmp0=!shuffle $val10,$val11

val12=$(tmp0)
tmp0=!listuniq $val12

val12=$(tmp0)
tmp0=!itemcnt $val12

val13=$[rint($(tmp0))]

!ifval $val13<2
tmp0=!shuffle Pierre,Paul

val12=$(tmp0)
!endif
tmp0=!randint 2, 6

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val14-1

val15=$[rint($(tmp0))]
val16=$[rint(max($val14^2-$val15^2,2*$val14*$val15))]
val17=$[rint(min($val14^2-$val15^2,2*$val14*$val15))]
val18=$[rint(($val16^2+$val17^2)^(1/2))]
tmp=!translate internal $	$ to ; in $val7$val8 = $val16 cm  &nbsp;&#59; &nbsp; $val7$val9 = $val17 cm,$val8$val9	$val7$val8=$val16 cm &nbsp;&#59;&nbsp; $val8$val9=$val18 cm,$val7$val9	$val7$val9 = $val17 cm &nbsp;&#59;&nbsp; $val8$val9=$val18 cm,$val7$val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
choicename1=
choicegood1=Le théorème de Pythagore
choicebad1=La réciproque du théorème de Pythagore
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

