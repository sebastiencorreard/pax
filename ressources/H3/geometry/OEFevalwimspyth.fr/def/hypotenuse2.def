$()<div class="wims_columns">	 <div class="medium_size img_col">	  <img src="$val30" alt=""></div>	  <div class="medium_size text_col">	$val9$val10$val11 est un triangle rectangle en $val9. $m_compenonce	<div class="spacer">	   $val29 ?	  </div>	</div>	</div>	
$()
!exit

