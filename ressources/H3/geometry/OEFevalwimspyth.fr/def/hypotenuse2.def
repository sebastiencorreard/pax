!set title=Reconnaître l'hypoténuse 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 300, 350

val6=$[rint($(tmp0))]
val7=$[rint(200)]
tmp0=!shuffle A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S

val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=$(tmp0)
tmp0=!item 3 of $val8

val11=$(tmp0)
tmp0=!item 4 of $val8

val12=$(tmp0)
tmp0=!randint -30, 30

val13=$[rint($(tmp0))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val14=$[rint($(tmp0)*sqrt(80^2-($val13)^2))]

!ifval $val14>0
val15=$[rint($val14+15)]
!else
val15=$[rint($val14-5)]
!endif
val16=$[rint(-80-$val13)]
val17=$[rint(-$val14)]
val18=$[sqrt(($val16)^2+($val17)^2)]
val19=$[rint(80-$val13)]
val20=$[rint(-$val14)]
val21=$[sqrt(($val19)^2+($val20)^2)]
val22=$[rint($val13+10*$val16/($val18))]
val23=$[rint($val14+10*$val17/($val18))]
val24=$[rint(10*$val19/($val21))]
val25=$[rint(10*$val20/($val21))]
val26=range -100,100,-100,100	triangle -80,0,80,0,$val13,$val14,black	text black,$val13-5,$val15,medium,$val9	text black,-90,-5,medium,$val10	text black,85,-5,medium,$val11	segment $val22,$val23,$val22+$val24,$val23+$val25,red	segment $val22+$val24,$val23+$val25,$val13+$val24,$val14+$val25,red
val27=[$val9$val10],[$val9$val11]
val7=$[rint(200)]
val6=$[rint(200)]
val28=[$val10$val11]
val29=Quelle est son hypoténuse
!readproc oef/draw.phtml $val6,$val7 \
$val26 
tmp0=$ins_url
val30=$(tmp0)
choicename1=
choicegood1=$val28
choicebad1=$val27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

