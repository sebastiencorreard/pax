 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val11=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val12=$(tmp0)
