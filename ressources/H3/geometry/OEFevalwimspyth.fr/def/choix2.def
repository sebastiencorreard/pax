!ifval $val14<3
tmp0=!shuffle Pierre,Paul,Olivier

val13=$(tmp0)
!endif
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
tmp0=!randint 25, 65

val16=$[rint($(tmp0))]

!ifval $val15=1
val17=$[rint(90-$val16)]
!else
tmp0=!randint 25, 55

val17=$[rint($(tmp0))]
!endif

!ifval $val16+$val17=90
val15=$[rint(1)]
!endif
!if $val15=1 
val18=Le triangle est rectangle en $val7
!else
val18=Le triangle n'est pas rectangle en $val7
!endif
