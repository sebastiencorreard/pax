tmp0=!randint 25, 35

val13=$[rint($(tmp0))]
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
!if $val14=1 
tmp0=!shuffle $val7$val8,$val7$val9

val15=$(tmp0),$val8$val9
!else
val15=$val7$val8,$val8$val9,$val7$val9
!endif
val16=\($(val15[1])=$val12 \textrm{ cm} \quad\quad ; \quad\quad $(val15[2]) = $val13 \textrm{ cm})
val15=$(val15[3])
