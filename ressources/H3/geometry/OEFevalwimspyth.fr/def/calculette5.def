ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,1,1,0,0,0,0

val6=$(tmp0)
val7=$[rint(2^$(val6[1])*3^$(val6[2])*5^$(val6[3])*7^$(val6[4])*11^$(val6[5])*13^$(val6[6])*17^$(val6[7]))]
tmp0=!randint 3, 7

val7=$[rint($(tmp0))]
tmp0=!randint 8, 12

val8=$[rint($(tmp0))]
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[rint($val7^2)]
val11=$[rint($val8^2)]
val12=sqrt($val11$val9$val10)
val13=1,2,3
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp=!nonempty items $val13

tmp0=!randitem $tmp
val13=$(tmp0)
tmp0=!item $val13 of rint($val12*10^($val14-1)),ceil($val12*10^($val14-1)),floor($val12*10^($val14-1))

val15=$[$(tmp0)]
val15=$[$val15/10^($val14-1)]
val16=à l'unité,au dixième,au centième
tmp0=!item $val14 of $val16

val17=$(tmp0)
tmp0=!item $val13 of l'arrondi $val17,la valeur approchée $val17 par excès,la valeur approchée $val17 par défaut

val18=$(tmp0)
tmp0=!texmath $val12

val19=$(tmp0)
replytype1=numexp
replyname1=\($val19)
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

