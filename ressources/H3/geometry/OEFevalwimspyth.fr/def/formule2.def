$()	
!if $m_dessin!= 
$()	  <div class="wims_columns">	 <div class="medium_size img_col"><img src="$val15" alt=""></div>	 <div class="medium_size text_col">	 
!endif
$()	   $val9$val10$val11 est un triangle rectangle en $val9.<p>	   Parmi les égalités suivantes, laquelle est vraie ?</p>	   <blockquote>	   <ul>	    
!for m_l=1 to $val16 
$()	    <li> 
!read oef/embed.phtml r1,\l 
$()</li>	    
!next
$()	   </ul>	   </blockquote>	
!if $m_dessin!= 
$()</div></div> 
!endif
