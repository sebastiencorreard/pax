val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 300, 350

val6=$[rint($(tmp0))]
val7=$[rint(200)]
tmp0=!shuffle A,B,C,D,E,F,G,H,J,K

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
val11=$(val8[3])
val12=\($val10$val11 = $val9$val10 + $val9$val11),\($val9$val10^2 = $val10$val11^2 + $val9$val11^2),\($val9$val11^2 = $val10$val11^2 + $val9$val10^2) , \($val9$val10 = $val10$val11 + $val9$val11),\($val9$val11 = $val10$val11 + $val9$val10)
val13=\($val10$val11^2 = $val9$val10^2 + $val9$val11^2)
tmp0=!shuffle $val12,$val13

val12=$(tmp0)
tmp0=!positionof item $val13 in $val12

val13=$[rint($(tmp0))]
val14=radio
!if \dessin!= 
!readproc oef/draw.phtml $val6,$val7 \
\dessin 
tmp0=$ins_url
val15=$(tmp0)
!endif
tmp0=!itemcnt $val12

val16=$[rint($(tmp0))]
replytype1=$val14

replyname1=Réponse
replygood1=$val13;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

