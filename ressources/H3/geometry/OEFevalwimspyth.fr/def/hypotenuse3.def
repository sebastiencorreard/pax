!set title=Reconnaître l'hypoténuse 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H,K,L

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
choicename1=
choicegood1=[$val8$val9]
choicebad1=[$val7$val8],[$val7$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7$val8$val9 est un triangle rectangle en $val7.	Quelle est son hypoténuse ?
$()
!exit

