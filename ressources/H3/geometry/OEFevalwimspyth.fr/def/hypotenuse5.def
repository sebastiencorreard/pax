!set title=Reconnaître l'hypoténuse 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!randint 2, 6

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10-1

val11=$[rint($(tmp0))]
val12=$[rint(max($val10^2-$val11^2,2*$val10*$val11))]
val13=$[rint(min($val10^2-$val11^2,2*$val10*$val11))]
val14=$[rint(($val13^2+$val12^2)^(1/2))]
tmp0=!shuffle $val8$val9=$val14,$val7$val9=$val13,$val7$val8=$val12

val15=$(tmp0)
tmp=!nonempty items centimètres,décimètres,décamètres

tmp0=!randitem $tmp
val16=$(tmp0)
choicename1=
choicegood1=[$val8$val9]
choicebad1=[$val7$val8],[$val7$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7$val8$val9 est un triangle rectangle dont les côtés mesurent (en $val16):	  <ul>	    
!for m_k=1 to 3 
$()<li>$(val15[$m_k]).</li> 
!next
$()	  </ul>	  Quelle est l'hypoténuse du triangle $val7$val8$val9 ?
$()
