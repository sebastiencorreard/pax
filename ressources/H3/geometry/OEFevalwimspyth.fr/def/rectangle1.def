!set title=Rectangle ou non 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand

ansorder=c
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
tmp0=!randint 2, 6

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10-1

val11=$[rint($(tmp0))]
val12=$[rint(max($val10^2-$val11^2,2*$val10*$val11))]
val13=$[rint(min($val10^2-$val11^2,2*$val10*$val11))]
val14=$[rint(($val12^2+$val13^2)^(1/2))]
choicename1=
choicegood1=$val7
choicebad1=$val8,$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath $val7$val8$val9
$() est un triangle tel que :	<div class="wimscenter">	$val7$val8 = $val12 cm &nbsp;;&nbsp; $val7$val9 = $val13 cm &nbsp;;&nbsp; $val8$val9 = $val14 cm </div>	Si le triangle est rectangle,cela ne peut être qu'en ? 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,12,13,14
embedcnt=0
