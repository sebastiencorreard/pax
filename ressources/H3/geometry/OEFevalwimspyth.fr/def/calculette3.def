!set title=Utiliser sa calculatrice 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,1,1,0,0,0,0

val6=$(tmp0)
val7=$[rint(2^$(val6[1])*3^$(val6[2])*5^$(val6[3])*7^$(val6[4])*11^$(val6[5])*13^$(val6[6])*17^$(val6[7]))]
val8=sqrt($val7)
val9=3
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp=!nonempty items $val9

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!item $val9 of rint($val8*10^($val10-1)),ceil($val8*10^($val10-1)),floor($val8*10^($val10-1))

val11=$[$(tmp0)]
val11=$[$val11/10^($val10-1)]
val12=à l'unité,au dixième,au centième
tmp0=!item $val10 of $val12

val13=$(tmp0)
tmp0=!item $val9 of l'arrondi $val13,la valeur approchée $val13 par excès,la valeur approchée $val13 par défaut

val14=$(tmp0)
tmp0=!texmath $val8

val15=$(tmp0)
replytype1=numexp
replyname1=\($val15)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Utilisez votre calculatrice pour donner $val14 de :	<div class="wimscenter"> 
!insmath $val15
$()</div>
$()
!exit

