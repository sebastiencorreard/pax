!set title=Relation de Pythagore 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=20
prevarcnt=6
postvarcnt=13
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
val11=\($val8$val9),\($val7$val8),\($val7$val9),\($val7$val9^2),\($val7$val8^2),\(\ =\ ),\(\ +\ ),\(\ -\ ),\($val8$val9^2)
replytype1=dragfill
replyname1=Réponse
replygood1=?analyze 12;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   $val7$val8$val9 est un triangle rectangle en $val7.	   Écrire une relation faisant intervenir les longueurs de tous les côtés de ce triangle.	   <div class="wimscenter">	     
!read oef/embed.phtml r1,50x40x6 
$()	   </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!if $(val11[4]) isitemof $val12 and $(val11[6]) isitemof $val12 and  
tmp0=!replace item $(val11[4]) by 9 in $val12

val13=$(tmp0)
tmp0=!replace item $(val11[5]) by 16 in $val13

val13=$(tmp0)
tmp0=!replace item $(val11[9]) by 25 in $val13

val13=$(tmp0)
tmp0=!replace item $(val11[7]) by + in $val13

val13=$(tmp0)
tmp0=!replace item $(val11[8]) by - in $val13

val13=$(tmp0)
tmp0=!replace item $(val11[6]) by = in $val13

val13=$(tmp0)
val14=$[rint(1)]
tmp0=!positionof item = in $val13

val15=$(tmp0)
tmp0=!item 1 to $val15-1 of $val13

val16=$(tmp0)
tmp0=!items2words $val16

val17=$(tmp0)
tmp0=!item $val15+1 to -1 of $val13

val18=$(tmp0)
tmp0=!items2words $val18

val19=$(tmp0)
!else
val14=0
!endif

!exit

:feedback

!exit

:test

!ifval $val14=1 and $val17=$val19
 condtest1=1
!else
 condtest1=0
!endif
condname1=Egalité correcte

!exit

:stat
vsavelist=7,8,9,11,12
embedcnt=1
