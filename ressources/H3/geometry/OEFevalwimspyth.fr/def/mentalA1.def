!set title=Calculer mentalement des carrés 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Calculer mentalement&nbsp;
tmp=!nonempty items 4,5,6,7,8,9,3

tmp0=!randitem $tmp
val7=$(tmp0)
val8=A
!if A isin $val8 
val9=$[$val7^2]
val10=\($val7^2)
!else
val9=$[$val7]
val7=$[$val7^2]
val10=\(\sqrt{$val7})
!endif
replytype1=numexp
replyname1=$val10
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val6:	<div class="wimscenter"> $val10 </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
