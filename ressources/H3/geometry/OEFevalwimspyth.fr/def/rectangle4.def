!set title=Rectangle ou non 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp=!nonempty items 1,2,2,2

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp0=!randint 20, 60

val11=$[rint($(tmp0))]
tmp0=!randint 10, $val11-1

val12=$[rint($(tmp0))]
val13=$[max($val11^2-$val12^2,2*$val11*$val12)/10]
val14=$[min($val11^2-$val12^2,2*$val11*$val12)/10]
val15=$[($val13^2+$val14^2)^(1/2)]

!ifval $val10=1
tmp0=!randint 30, 90

val15=$[$val15+$(tmp0)/10]
!endif
tmp0=!randint 1, 2

val16=$(tmp0)
!if $val16=1 
val14=$[$val14/10]
val13=$val13 cm
val14=$val14 dm
val15=$val15 cm
!else
val13=$[$val13/10]
val13=$val13 dm
val14=$val14 cm
val15=$val15 cm
!endif
val17=Non,Oui
tmp0=!item $val10 of $val17

val18=$(tmp0)
choicename1=
choicegood1=$val18
choicebad1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath $val7$val8$val9
$() est un triangle tel que :	<div class="wimscenter">$val7$val8 = $val13 &nbsp;;&nbsp; $val7$val9 = $val14 &nbsp;;&nbsp; $val8$val9 = $val15</div>	  Le triangle 
!insmath $val7$val8$val9
$() est-il rectangle ? 
$()
!exit

