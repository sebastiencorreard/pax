val14=$(tmp0)
!readproc oef/draw.phtml 190,210 \
fpoly $(val13[$(val14[1])]),10,80,60,80,60,130,10,130	fpoly $(val13[$(val14[2])]),60,130,60,200,130,200,130,130	fpoly $(val13[$(val14[3])]),130,130,180,60,110,10,60,80	fpoly $(val13[$(val14[4])]),60,80,60,130,130,130 
tmp0=$ins_url
val15=$(tmp0)
val10=Oui,Non
tmp0=!item $val6 of $val10

val11=$(tmp0)
choicename1=
choicegood1=$val11
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

