val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 100, 250

val7=$[rint($(tmp0))]
tmp0=!randint 300, 500

val8=$[rint($(tmp0))]

!ifval $val6=1
val9=$[rint($val7+$val8)]
!else
tmp0=!randint 100, 200

val9=$[rint($val7+$val8+$(tmp0))]
!endif
