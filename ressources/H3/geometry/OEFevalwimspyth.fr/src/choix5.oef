\title{Choisir la bonne propriété 5}
\author{Fabrice,Guerimand}
\mail{fwguerima@free.fr}

\text{let=shuffle(A,B,C,D,E,F,G,H)}
\text{A=\let[1]}
\text{B=\let[2]}
\text{C=\let[3]}

\text{name1=slib(lang/fname fr,boy)}
\text{name2=slib(lang/fname fr,girl)}
\text{name=shuffle(\name1,\name2)}
\text{name=wims(listuniq \name)}
\integer{nb=items(\name)}
\text{name=\nb<2?shuffle(Pierre,Paul)}
\integer{u=random(2..6)}
\integer{v=random(1..\u-1)}
\integer{ab=max(\u^2-\v^2,2*\u*\v)}
\integer{ac=min(\u^2-\v^2,2*\u*\v)}
\integer{bc=(\ab^2+\ac^2)^(1/2)}
\text{longs=randrow(\A\B = \ab cm  &nbsp;&#59; &nbsp; \A\C = \ac cm,\B\C
\A\B=\ab cm &nbsp;&#59;&nbsp; \B\C=\bc cm,\A\C
\A\C = \ac cm &nbsp;&#59;&nbsp; \B\C=\bc cm,\A\B)}


\statement{
\(\A\B\C) est un triangle rectangle en \A tel que :
<div class="wimscenter"> \longs[1] </div>
Quelle propriété faut-il utiliser pour calculer \enonce
\longs[2] ?}

\choice{}{Le théorème de Pythagore}{La réciproque du théorème de Pythagore}
