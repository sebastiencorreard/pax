\title{Choisir la bonne propriété 3}
\author{Fabrice,Guerimand}
\mail{fwguerima@free.fr}

\text{let=shuffle(A,B,C,D,E,F,G,H)}
\text{A=\let[1]}
\text{B=\let[2]}
\text{C=\let[3]}

\integer{u=random(2..6)}
\integer{v=random(1..\u-1)}
\integer{ab=max(\u^2-\v^2,2*\u*\v)}
\integer{ac=min(\u^2-\v^2,2*\u*\v)}
\integer{bc=(\ab^2+\ac^2)^(1/2)}

\text{phrase1=\(\B\C^2 = \A\C^2+\A\B^2) donc d'après la réciproque du théorème de Pythagore&#46; le triangle \(\A\B\C) est rectangle en \A.}
\text{phrase2=\(\B\C^2 = \A\C^2+\A\B^2) donc d'après le théorème de Pythagore&#46; le triangle \(\A\B\C) est rectangle en \A.}
\text{phrase3=\(\B\C^2 \neq \A\C^2+\A\B^2) donc d'après la réciproque du théorème de Pythagore&#46; le triangle \(\A\B\C) n'est pas rectangle en \A.}
\text{phrase4=\(\B\C^2 \neq \A\C^2+\A\B^2) donc d'après le théorème de Pythagore&#46; le triangle \(\A\B\C) n'est pas rectangle en \A.}
\text{phrase5=\(\B\C^2 \neq \A\C^2+\A\B^2). Si le triangle \(\A\B\C) était rectangle en \A&#46; d'après le théorème de Pythagore&#46; on aurait \(\B\C^2 = \A\C^2+\A\B^2) donc il ne peut pas être rectangle en \A.}
\text{phrase6=\(\B\C^2 \neq \A\C^2+\A\B^2). Si le triangle \(\A\B\C) était rectangle en \A&#46; d'après la réciproque du théorème de Pythagore&#46; on aurait \(\B\C^2 = \A\C^2+\A\B^2) donc il ne peut pas être rectangle en \A.}


\statement{
\(\A\B\C) est un triangle tel que :
<div class="wimscenter">\A\B = \ab cm &nbsp;;&nbsp; \A\C = \ac cm &nbsp;;&nbsp; \B\C = \bc cm </div>
Le triangle est-il rectangle en \A ?}

\choice{}{\phrase1}{\phrase2,\phrase3,\phrase4,\phrase5,\phrase6}
