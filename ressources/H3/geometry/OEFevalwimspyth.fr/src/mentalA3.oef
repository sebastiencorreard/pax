\title{Calculer mentalement des carrés 3}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\text{v=wims(values v for v=2 to 5)}
\text{v=shuffle(\v)}
\text{enonce=\v[1]^2 + \v[2]^2}
\integer{good=\enonce}
\text{enonce=\(\enonce)}
\statement{
Calculer mentalement :
<div class="wimscenter"> \enonce </div>}
\answer{\enonce}{\good}{type=numexp}
