\title{Relation de Pythagore 5}

\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}
\text{D=item(4,\lettres)}
\text{bad=\(\B\C),\(\A\B),\(\A\C),\(\A\C^2),\(\A\B^2),\(\ =\ ),\(\ +\ ),\(\ -\ ),\(\B\C^2)}

\statement{
   \A\B\C est un triangle rectangle en \A.
   Écrire une relation faisant intervenir les longueurs de tous les côtés de ce triangle.
   <div class="wimscenter">
    \embed{r1,50x40x6}
   </div>}

\answer{Réponse}{\good;\bad}{type=dragfill}

\if{\bad[4] isitemof \good and \bad[6] isitemof \good and }{
   \text{rep=wims(replace item \bad[4] by 9 in \good)}
   \text{rep=wims(replace item \bad[5] by 16 in \rep)}
   \text{rep=wims(replace item \bad[9] by 25 in \rep)}
   \text{rep=wims(replace item \bad[7] by + in \rep)}
   \text{rep=wims(replace item \bad[8] by - in \rep)}
   \text{rep=wims(replace item \bad[6] by = in \rep)}
   \integer{test=1}
   \text{po=wims(positionof item = in \rep)}
   \text{m1=item(1 to \po-1,\rep)}
   \text{M1=wims(items2words \m1)}
   \text{m2=item(\po+1 to -1,\rep)}
   \text{M2=wims(items2words \m2)}
}{
   \text{test=0}
}
\condition{Egalité correcte}{\test=1 and \M1=\M2}
