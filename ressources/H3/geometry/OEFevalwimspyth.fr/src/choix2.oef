\title{Choisir la bonne propriété 2}
\author{Fabrice,Guerimand}
\mail{fwguerima@free.fr}

\text{let=shuffle(A,B,C,D,E,F,G,H)}
\text{A=\let[1]}
\text{B=\let[2]}
\text{C=\let[3]}

\text{name1=slib(lang/fname fr,boy)}
\text{name2=slib(lang/fname fr,girl)}
\text{name3=slib(lang/fname fr,girl)}
\text{name=shuffle(\name1,\name2,\name3)}
\text{name=wims(listuniq \name)}
\integer{nb=items(\name)}
\text{name=\nb<3?shuffle(Pierre,Paul,Olivier)}

\integer{ch=randint(1..2)}
\integer{b=randint(25..65)}
\integer{c=\ch=1?90-\b:randint(25..55)}
\integer{ch=\b+\c=90?1}
\if{\ch=1}{
 \text{enonce=Le triangle est rectangle en \A}

}{
 \text{enonce=Le triangle n'est pas rectangle en \A}
}
\text{ph=shuffle(la réciproque du théorème de Pythagore,le théorème de Pythagore)}

\statement{
\(\A\B\C) est un triangle tel que :
<div class="wimscenter">\(\widehat{\B} = \b^\circ \quad\quad;\quad\quad \widehat{\C} = \c^\circ)</div>
\enonce.
<p>
Le professeur demande à ses élèves de justifier la réponse.
</p>
<ul>
 <li> \name[1] répond :<span style="font-style:italic">C'est simple, il faut utiliser \ph[1].</span></li>
 <li> \name[2] répond :<span style="font-style:italic">Mais non, il faut utiliser \ph[2].</span></li>
 <li> \name[3] répond :<span style="font-style:italic">Vous avez tort tous les deux !! Il ne faut utiliser aucune de ces deux propriétés, c'est la propriété.</span></li>
</ul>
Qui a raison ?}

\choice{}{\name[3]}{\name}
