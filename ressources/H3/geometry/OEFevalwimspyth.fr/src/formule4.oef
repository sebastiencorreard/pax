\title{Relation de Pythagore 4}

\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\integer{xmax=randint(300..350)}
\integer{ymax=200}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}
\text{D=item(4,\lettres)}

\text{bad=\(\B\C),\(\A\B),\(\A\C),\(\A\C^2),\(\A\B^2),\(\ +\ ),\(\ -\ ),\(\B\C^2)}
\integer{ch=randint(1..2)}
\if{\ch=1}{
 \text{inc=\A\C}
 \text{good=\(\B\C^2),\(\ -\ ),\(\A\B^2)}
}{
\text{inc=\A\B}
 \text{good=\(\B\C^2),\(\ -\ ),\(\A\C^2)}
}

\statement{
   \A\B\C est un triangle rectangle en \A.
  Écrire une relation faisant intervenir les longueurs de tous les côtés de ce triangle.
   <div class="wimscenter">
    \(\inc^2 =) \embed{r1,50x40x3}
   </div>}

\answer{Réponse}{\good;\bad}{type=dragfill}
