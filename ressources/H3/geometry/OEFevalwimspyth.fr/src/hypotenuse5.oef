\title{Reconnaître l'hypoténuse 5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\text{lettres=shuffle(A,B,C,D,E,F,G,H)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}


\integer{u=random(2..6)}
\integer{v=random(1..\u-1)}
\integer{sm=max(\u^2-\v^2,2*\u*\v)}
\integer{mn=min(\u^2-\v^2,2*\u*\v)}
\integer{sn=(\mn^2+\sm^2)^(1/2)}
\text{don=shuffle(\B\C=\sn,\A\C=\mn,\A\B=\sm)}
\text{unit=randitem(centimètres,décimètres,décamètres)}

\statement{
\A\B\C est un triangle rectangle dont les côtés mesurent (en \unit):
  <ul>
   \for{k=1 to 3}{<li>\don[\k].</li>}
  </ul>
  Quelle est l'hypoténuse du triangle \A\B\C ?}
\choice{}{[\B\C]}{[\A\B],[\A\C]}
