\title{Relation de Pythagore dans un contexte 4}

\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\integer{xmax=randint(300..350)}
\integer{ymax=200}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,J,K,L,M,O,P,R,S)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}
\text{D=item(4,\lettres)}

\text{bad=\(\B\C),\(\A\B),\(\A\C),\(\A\C^2),\(\A\B^2),\(\ +\ ),\(\ -\ ),\(\B\C^2)}
\integer{ch=randint(1..3)}
\if{\ch=1}{
 \text{inc=\A\C}
 \text{good=\(\B\C^2),\(\ -\ ),\(\A\B^2)}
 \text{long=\A\B,\B\C}
}{
 \if{\ch=2}{
  \text{inc=\A\B}
  \text{good=\(\B\C^2),\(\ -\ ),\(\A\C^2)}
  \text{long=\A\C,\B\C}
 }{
  \text{inc=\B\C}
  \text{good=\(\A\C^2),\(\ +\ ),\(\A\B^2)|\(\A\B^2),\(\ +\ ),\(\A\C^2)}
  \text{long=shuffle(\A\C,\A\B)}
 }
}
 \integer{N1=randint(5..15)}
 \integer{N2=randint(25..35)}
 \text{mesure=\(\long[1]=\N1 \textrm{ cm} \quad\quad ; \quad\quad \long[2] = \N2 \textrm{ cm})}

\statement{
\A\B\C est un triangle rectangle en \A tel que :
<div class="wimscenter">\mesure</div>
 Écrire une relation qui te permettra de calculer la longueur \inc.
   <div class="wimscenter">
    \(\inc^2 =) \embed{r1,50x40x3}
   </div>}

\answer{Réponse}{\good;\bad}{type=dragfill}
