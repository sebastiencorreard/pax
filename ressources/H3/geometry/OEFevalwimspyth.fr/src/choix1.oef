\title{Choisir la bonne propriété 1}
\author{Fabrice,Guerimand}
\mail{fwguerima@free.fr}

\text{let=shuffle(A,B,C,D,E,F,G,H)}
\text{A=\let[1]}
\text{B=\let[2]}
\text{C=\let[3]}

\text{name1=slib(lang/fname fr,boy)}
\text{name2=slib(lang/fname fr,girl)}
\text{name=shuffle(\name1,\name2)}
\text{name=wims(listuniq \name)}
\integer{nb=items(\name)}
\text{name=\nb<2?shuffle(Pierre,Paul)}
\integer{u=random(2..6)}
\integer{v=random(1..\u-1)}
\integer{ab=max(\u^2-\v^2,2*\u*\v)}
\integer{ac=min(\u^2-\v^2,2*\u*\v)}
\integer{bc=(\ab^2+\ac^2)^(1/2)}

\integer{ch=randint(1..2)}
\if{\ch=1}{
 \text{enonce=Le triangle est rectangle en \A}
 \integer{ch2=randint(1..2)}
 \if{\ch2=1}{
  \text{phrase1=C'est simple comme \(\B\C^2 = \A\C^2+\A\B^2), d'après la réciproque du théorème de Pythagore, le triangle est rectangle en \A}
  \text{phrase2=Mais non, il faut utiliser le théorème de Pythagore.}
  \text{good=\name[1]}
  \text{bad=\name[2]}
 }{
  \text{phrase1=C'est simple comme \(\B\C^2 = \A\C^2+\A\B^2), d'après théorème de Pythagore, le triangle est rectangle en \A}
  \text{phrase2=Mais non, il faut utiliser la réciproque du théorème de Pythagore.}
  \text{good=\name[2]}
  \text{bad=\name[1]}
 }
}{
 \text{enonce=Le triangle n'est pas rectangle en \A}
 \integer{bc=\bc+randint(2..4)}
 \integer{ch2=randint(1..2)}
 \if{\ch2=1}{
  \text{phrase1=C'est simple comme \(\B\C^2 \neq \A\C^2+\A\B^2), d'après la réciproque du théorème de Pythagore, le triangle n'est pas rectangle en \A}
  \text{phrase2=Mais non, s'il était rectangle en \A, d'après le théorème de Pythagore on aurait \(\B\C^2 = \A\C^2+\A\B^2) mais avec les longueurs données, on a \(\B\C^2 \neq \A\C^2+\A\B^2) donc le triangle n'est pas rectangle en \A.}
  \text{good=\name[2]}
  \text{bad=\name[1]}
 }{
  \text{phrase1=s'il était rectangle en \A, d'après le théorème de Pythagore on aurait \(\B\C^2 = \A\C^2+\A\B^2) mais avec les longueurs données, on a \(\B\C^2 \neq \A\C^2+\A\B^2) donc le triangle n'est pas rectangle en \A.}
  \text{phrase2=Mais non, comme \(\B\C^2 \neq \A\C^2+\A\B^2), d'après la réciproque du théorème de Pythagore, le triangle n'est pas rectangle en \A.}
  \text{good=\name[1]}
  \text{bad=\name[2]}
 }
}

\statement{
\(\A\B\C) est un triangle tel que :
<div class="wimscenter">\A\B = \ab cm &nbsp;;&nbsp; \A\C = \ac cm &nbsp;;&nbsp; \B\C = \bc cm </div>
\enonce.
Le professeur demande à ses élèves de justifier cette réponse.
<ul>
 <li> \name[1] répond :<span style="font-style:italic">\phrase1</span></li>
 <li> \name[2] répond :<span style="font-style:italic">\phrase2</span></li>
</ul>
Qui a raison ?}

\choice{}{\good}{\bad}
