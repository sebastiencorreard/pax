 !exit
!endif

tmp0=!randint 67, 100

val6=$[rint($(tmp0))]
tmp0=!randint 20, 40

val7=$[rint($(tmp0))]
val8=linewidth 2	parallel 20,$val6,180,$val6,0,$val7,2,green	segment 120,0,30,180,black	segment 80,0,170,180,black
val9=Les deux droites vertes sont parallèles
val10=Oui
!readproc oef/draw.phtml 200,200 \
$val8 
tmp0=$ins_url
val11=$(tmp0)
choicename1=Réponse
choicegood1=$val10
choicebad1=Oui,Non
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

