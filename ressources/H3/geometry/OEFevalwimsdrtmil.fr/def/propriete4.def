!set title=Connaître les propriétés 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefobservation=losange

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Il a 4 côtés,	   Ses côtés opposés sont parallèles deux à deux,	   Ses côtés opposés ont même longueur deux à deux,	   Il a deux côtés opposés parallèles et de même longueur,	   Ses diagonales se coupent en leur milieu,	   Tous ses côtés ont même longueur,	   Ses diagonales sont perpendiculaires,	   Ses diagonales ont même longueur,	   Il a 3 angles droits,	   Il a un angle droit,	   Il a deux côtés consécutifs de même longueur
tmp0=!itemcnt $val6

val7=$[rint($(tmp0))]
tmp0=!shuffle A,B,C,D,E,F,G,H,K,L

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
val11=$(val8[3])
val12=$(val8[4])
val13=$val9$val10$val11$val12
val14=losange
val15=1,2,3,4,5,6,7,11
replytype1=checkbox
replyoption1=split shuffle 
replyname1=
replygood1=$val15;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13 est un $val14. Quelles sont ses propriétés ?	<ul>	 
!for m_k=1 to $val7 
$()	 <li>	   
!read oef/embed.phtml r1,\k 
$()	 </li>	 
!next
$()	</ul>
$()
!exit

