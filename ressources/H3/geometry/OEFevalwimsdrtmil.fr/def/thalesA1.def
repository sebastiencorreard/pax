tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=segment 20,20,180,130,black	segment 20,20,50,180,black	segment 180,130,50,180,red	segment 35,100,100,75,red	text black,10,10,medium,$val8	text black,190,135,medium,$(val14[2])	text black,35,185,medium,$(val14[4])	text black,25,100,medium,$(val14[3])	text black,115,70,medium,$(val14[1])
!readproc oef/draw.phtml 200,200 \
$val15 
