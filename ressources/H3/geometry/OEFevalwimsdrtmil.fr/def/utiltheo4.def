postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
val10=$(val6[4])
val11=$(val6[5])
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!if $val12=1 
tmp=!nonempty items $val10 est le milieu du côté \([$val7$val8]\) et $val11 le milieu du côté \([$val7$val9]\),$val10 et $val11 sont respectivement les milieux des côtés \([$val7$val8]\) et \([$val7$val9]\)

tmp0=!randitem $tmp
val13=$val7$val8$val9 est un triangle. $(tmp0).
val14=Que peut-on dire des droites \(($val10$val11)\) et \(($val9$val8)\) &#63;
val15=parallèles|parallèle
val16=elles sont
!else
val13=$val7$val8$val9 est un triangle et $val10 est le milieu du côté \([$val7$val8]\). La parallèle à \(($val8$val9)\) passant par $val10 coupe le côté \([$val7$val9]\) en $val11.
val14=Que représente le point $val11 pour le segment \([$val7$val9]\) &#63;
val15=le milieu|milieu
val16=c'est
!endif
replytype1=nocase
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

