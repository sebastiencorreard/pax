!set title=Reconnaître un quadrilatère particulier 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Il a 4 côtés,	   Ses côtés opposés sont parallèles deux à deux,	   Ses côtés opposés ont même longueur deux à deux,	   Il a deux côtés opposés parallèles et de même longueur,	   Ses diagonales se coupent en leur milieu,	   Tous ses côtés ont même longueur,	   Ses diagonales sont perpendiculaires,	   Ses diagonales ont même longueur,	   Il a 3 angles droits,	   Il a un angle droit,	   Il a deux côtés consécutifs de même longueur
tmp0=!itemcnt $val6

val7=$[rint($(tmp0))]
tmp0=!shuffle A,B,C,D,E,F,G,H,K,L

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
val11=$(val8[3])
val12=$(val8[4])
val13=$val9$val10$val11$val12
val14=Rectangle
tmp=!nonempty items 2,3,4,5

tmp0=!randitem $tmp
tmp=!nonempty items 8,10

tmp1=!randitem $tmp
tmp=!nonempty items 2,3,4,5

tmp2=!randitem $tmp
tmp=!nonempty items 8,10

tmp3=!randitem $tmp
tmp=!nonempty items 2,3,4,5

tmp4=!randitem $tmp
tmp=!nonempty items 8,10

tmp5=!randitem $tmp
val15=9	$(tmp0),$(tmp1)	$(tmp2),$(tmp3)	$(tmp4),$(tmp5)
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!itemcnt $val15

val16=$(tmp0)

!ifval $val16>1
tmp0=!shuffle $val15

val15=$(tmp0)
!endif
val15=1,$val15
val16=$val16+1
val17=Quadrilatère seulement,Parallélogramme,Rectangle,Losange,Carré
choiceoption1=shuffle 
choicename1=
choicegood1=$val14
choicebad1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13 est un quadrilatère possédant les propriétés suivantes :	<ul>	 
!for m_k=1 to $val16 
$()	   <li>$(val6[$(val15[$m_k])])</li>	  
!next
$()	</ul>	   Quelle est la nature de $val13 ?
$()
