val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Il a 4 côtés,	   Ses côtés opposés sont parallèles deux à deux,	   Ses côtés opposés ont même longueur deux à deux,	   Il a deux côtés opposés parallèles et de même longueur,	   Ses diagonales se coupent en leur milieu,	   Tous ses côtés ont même longueur,	   Ses diagonales sont perpendiculaires,	   Ses diagonales ont même longueur,	   Il a 3 angles droits,	   Il a un angle droit,	   Il a deux côtés consécutifs de même longueur
tmp0=!itemcnt $val6

val7=$[rint($(tmp0))]
tmp0=!shuffle A,B,C,D,E,F,G,H,K,L

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
val11=$(val8[3])
val12=$(val8[4])
val13=$val9$val10$val11$val12
val14=losange
val15=B,G;C,G;D,G;E,G;B,K;C,K;D,K;E,K
val16=2,3,4,5,7,8,10,11
tmp0=!item $val16 of $val6

val17=$(tmp0)
val18=A,B,C,D,E,F,G,H,I,J,K
tmp0=!itemcnt $val16

val19=$[rint($(tmp0))]
val20=$val15
!for val21 =1 to $val19 
val22=$(val6[$(val16[$val21])])
tmp0=!positionof item $val22 in $val17

val23=$[rint($(tmp0))]
val24=$(val18[$(val16[$val21])])
tmp0=!replace internal $val24 by $val23 in $val20

val20=$(tmp0)
!next
replytype1=checkbox
replyname1=
replygood1=?analyze 25;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Il faut démontrer que $val13 est un $val14.	<div class="wims_instruction">Il faut utiliser le moins possible de propriétés	   (tout en étant sûr que cela sera bien un $val14).</div>	   Parmi les propriétés suivantes lesquelles allez-vous utiliser ?	<ul>	 
!for m_k=1 to $val19 
$()	 <li> 
!read oef/embed.phtml r1,\k 
$()</li>	 
!next
$()	</ul>
$()
