:postdef
tmp0=!itemcnt $val25

val26=$(tmp0)
val27=
!for val28 =1 to $val26 
tmp0=!positionof item $(val25[$val28]) in $val17

val22=$(tmp0)
tmp0=!append item $val22 to $val27

val27=$(tmp0)
!next
tmp=!translate internal $	$ to ; in $val20

tmp0=!rowcnt $tmp
val29=$[rint($(tmp0))]
val30=$[rint(0)]
!for val31 =1 to $val29 
tmp=!translate internal $	$ to ; in $val20

tmp=!row $val31 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)

!ifval $val27 issametext $val22
val30=$[rint(1)]
!endif
!next

!exit

