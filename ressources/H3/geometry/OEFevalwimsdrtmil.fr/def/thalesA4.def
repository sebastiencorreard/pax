!set title=Triangles et proportionnalité A4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 120, 180

val6=$[rint($(tmp0))]
tmp0=!randint 20, 60

val7=$[rint($(tmp0))]
tmp0=!randint 20, 60

val8=$[rint($(tmp0))]
tmp0=!randint 120, 180

val9=$[rint($(tmp0))]
tmp0=!randint 120, 180

val10=$[rint($(tmp0))]
tmp0=!randint 120, 180

val11=$[rint($(tmp0))]
val12=linewidth 2	triangle $val6,$val7,$val8,$val9,$val10,$val11,black	segment ($val6+$val8)/2,($val7+$val9)/2,($val6+$val10)/2,($val7+$val11)/2,black	segment ($val6+$val8)/2,($val7+$val9)/2,$val10,$val11,black	segment $val8,$val9,($val6+$val10)/2,($val7+$val11)/2,black	circle (3*$val6+$val8)/4,(3*$val7+$val9)/4,10,green	circle ($val6+3*$val8)/4,($val7+3*$val9)/4,10,green	segment (3*$val6+$val10)/4-4,(3*$val7+$val11)/4-2,(3*$val6+$val10)/4+4,(3*$val7+$val11)/4-2,green	segment (3*$val6+$val10)/4-4,(3*$val7+$val11)/4+2,(3*$val6+$val10)/4+4,(3*$val7+$val11)/4+2,green	segment ($val6+3*$val10)/4-4,($val7+3*$val11)/4-2,($val6+3*$val10)/4+4,($val7+3*$val11)/4-2,green	segment ($val6+3*$val10)/4-4,($val7+3*$val11)/4+2,($val6+3*$val10)/4+4,($val7+3*$val11)/4+2,green
val13=Oui
val14=Peut-on utiliser la propriété d'égalité des rapports dans la figure ci-contre&nbsp;
val15=Oui,Non
!readproc oef/draw.phtml 200,200 \
$val12 
tmp0=$ins_url
val16=$(tmp0)
choicename1=Réponse
choicegood1=$val13
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

