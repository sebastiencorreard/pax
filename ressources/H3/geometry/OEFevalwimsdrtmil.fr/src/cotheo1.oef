\statement{
Compléter la propriété suivante :
<div class="wimscenter" style="font-style:italic">
Si une droite passe par \embed{r1,7} de deux \embed{r2,7} d'un triangle,
alors elle est \embed{r3,7} au troisième côté du triangle.
</div>}

\answer{Premier blanc}{les milieux|milieux|milieu|le milieu}{type=nocase}
\answer{Deuxième blanc}{côtés|côté}{type=nocase}
\answer{Troisième blanc}{parallèle|parallèles}{type=nocase}
