\statement{
Compléter la propriété suivante :
<div class="wimscenter" style="font-style:italic">
Si une droite est \embed{r1,7} à un côté d'un triangle et passe par \embed{r2,7} d'un deuxième
alors elle passe par \embed{r3,7} du troisième côté.
</div>}

\answer{Troisième blanc}{parallèle|parallèles}{type=nocase}
\answer{Premier blanc}{le milieu|milieu}{type=nocase}
