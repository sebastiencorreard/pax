\title{Vergelijking van een  lijn}
\language{nl}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{a=randint(-4..4)}
\integer{b=randint(-4..4)}
\integer{a=\a=0 and \b=0? randint(1..4)*random(1,-1)}
\function{eq=simplify(\a*x+(\b))}
\text{dessin=xrange -5.2, 5.2
     yrange -5.2, 5.2
     hline 0,0, black
     vline 0,0, black
     parallel -5,-5,5,-5,0,1,10, grey
     parallel -5,-5,-5,5,1,0,10, grey
     arrow 0,0,1,0,10, black
     arrow 0,0,0,1,10, black
     plot blue, \eq}

\statement{Geef de vergelijking van de getrokken lijn: 

<p class="wimscenter"> \draw{200,200}{\dessin}</p>
<p class="wimscenter">\(y = ) \embed{reply 1,15}</p>
}
\answer{\(y = )}{\eq,x}{type=function}

