\title{Lijn en kwadrant}
\language{nl}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\rational{p=random(randint(1..3)*random(1,-1),1/randint(1..3)*random(1,-1))}
\integer{a= randint(1..3)*random(1,-1)}
\rational{b=\p*(\a)}
\text{d=simplify((\p)*x)}
\text{d_tex=texmath(\d)}
\text{choix=I,II,III,IV}

\text{\rep= \b>0 and \a>0? item(1,\choix)}
\text{\rep= \b>0 and \a<0? item(2,\choix)}
\text{\rep= \b<0 and \a<0? item(3,\choix)}
\text{\rep= \b<0 and \a>0? item(4,\choix)}
\statement{De rechte \(d)  stelt de lineaire functie \(x\mapsto \d_tex) voor. 

Het x-coordinaat van een punt \(A) dat op de rechte \(d) ligt is gelijk aan \a. Stel je de rechte voor en zeg in welk kwadrant punt \(A) ligt: 
<p class="wimscenter"> \draw{200,200}{xrange -8.2,8.2
yrange -8.2,8.2
parallel -8,-8,8,-8,0,1,20, grey
parallel -8,-8,-8,8,1,0,20, grey
hline 0,0,black
arrow 0,0,1,0,8, black
arrow 0,0,0,1,8, black
vline 0,0,black
text black, 5,7,medium,(I)
 text black,-7,7,medium,(II)
 text black,-7,-5,medium,(III)
 text black,5,-5,medium,(IV)
}
</p>}
\choice{Kwadrant}{\rep}{\choix}
\hint{Hier is de grafiek van de rechte : 

<p class="wimscenter"> \draw{200,200}{xrange -8.2,8.2
yrange -8.2,8.2
parallel -8,-8,8,-8,0,1,20, grey
parallel -8,-8,-8,8,1,0,20, grey
hline 0,0,black
arrow 0,0,1,0,8, black
arrow 0,0,0,1,8, black
vline 0,0,black
text black, 5,7,medium,(I)
 text black,-7,7,medium,(II)
 text black,-7,-5,medium,(III)
 text black,5,-5,medium,(IV)
 plot red , \p*x
}
</p>}

\feedback{1=1}{
<p class="wimscenter"> \draw{200,200}{xrange -8.2,8.2
yrange -8.2,8.2
parallel -8,-8,8,-8,0,1,20, grey
parallel -8,-8,-8,8,1,0,20, grey
hline 0,0,black
arrow 0,0,1,0,8, black
arrow 0,0,0,1,8, black
vline 0,0,black
ttext black, 5,7,medium,(I)
 text black,-7,7,medium,(II)
 text black,-7,-5,medium,(III)
 text black,5,-5,medium,(IV)
 disk \a,\b,7,blue
 text black,\a,\b,medium,A
 plot red , \p*x
}
</p>}
