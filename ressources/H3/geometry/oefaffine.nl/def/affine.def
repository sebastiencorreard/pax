val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
t_=!rawmath $val8/$val9
val8=!exec pari print($t_)
t_=!rawmath $val6*$val8+$val7
val10=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val6*x+($val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)
val12=het origineel, het beeld
tmp0=!randitem 1,2

val13=$(tmp0)
tmp0=!item $val13 of $val12

val14=$(tmp0)

!ifval $val13=1
t_=!rawmath  $val10
val15=!exec pari print($t_)
!else
t_=!rawmath  $val8
val15=!exec pari print($t_)
!endif

!ifval $val13=1 
t_=!rawmath  $val8
val16=!exec pari print($t_)
!else
t_=!rawmath $val10
val16=!exec pari print($t_)
!endif
replytype1=formal
replyname1=$val14 van $val15
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

