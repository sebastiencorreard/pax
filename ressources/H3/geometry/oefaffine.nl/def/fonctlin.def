!set title=Lineaire functie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,-1

tmp1=!randint 1, 5

tmp2=!randint 1, 3

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val6=!exec pari print($t_)
tmp0=!randitem 1,-1

tmp1=!randint 2, 8

t_=!rawmath $(tmp0)*$(tmp1)
val7=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val7)/($val6)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
replytype1=formal
replyname1=\(f(x))
replygood1=$val8,x
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Bepaal 
!insmath f(x)
$() voor de functie 
!insmath f
$() als 
!insmath f($val6)=$val7
$() en 
!insmath f(0)=0
$().		
$()
!exit

