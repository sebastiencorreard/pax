!set title=Geanimeerde lijn
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,1,2,2,3

val6=$(tmp0)

!ifval $val6=1  or $val6=3
val7= 1-4*s
!else
tmp0=!randint -4, 4

val7= $(tmp0)
!endif

!ifval $val6=2 or $val6=3
val8= 2-3*s
!else
tmp0=!randint -4, 4

val8= $(tmp0)
!endif
val9=alleen de helling, alleen het y-coordinaat van 	de oorsprong, de helling en het y-coordinaat van de oorsprong
tmp0=!item $val6 of $val9

val10=$(tmp0)
choicename1=Hetgene dat varieert
choicegood1=$val10
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Hier is de geanimeerde lijn met vergelijking 
!insmath y=a*x+b
$(). 		Wat varieert er: de helling 
!insmath a
$(), het y-coordinaat van de 	oorsprong 
!insmath b
$() of allebei?	<p class="wimscenter">  
!read oef/draw.phtml 200,200 \
	animate 15,0.2,0	xrange -5.2,5.2	yrange -5.2,5.2	parallel -5,-5,5,-5,0,1,10, grey	parallel -5,-5,-5,5,1,0,10, grey	hline 0,0,black	vline 0,0,black	linewidth 2	plot blue,$val7*x+$val8	linewidth 1	 
$()	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=0
