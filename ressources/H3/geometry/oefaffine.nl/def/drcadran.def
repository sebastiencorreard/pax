!set title=Lijn en kwadrant
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

tmp1=!randitem 1,-1

tmp2=!randint 1, 3

tmp3=!randitem 1,-1

tmp4=!randitem $(tmp0)*$(tmp1),1/$(tmp2)*$(tmp3)

t_=!rawmath $(tmp4)
val6=!exec pari print($t_)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val6*($val7)
val8=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val6)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp0=!texmath $val9

val10=$(tmp0)
val11=I,II,III,IV

!ifval $val8>0 and $val7>0
tmp0=!item 1 of $val11

val12= $(tmp0)
!endif

!ifval $val8>0 and $val7<0
tmp0=!item 2 of $val11

val12= $(tmp0)
!endif

!ifval $val8<0 and $val7<0
tmp0=!item 3 of $val11

val12= $(tmp0)
!endif

!ifval $val8<0 and $val7>0
tmp0=!item 4 of $val11

val12= $(tmp0)
!endif
choicename1=Kwadrant
choicegood1=$val12
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()De rechte 
!insmath d
$()  stelt de lineaire functie 
!insmath x\mapsto $val10
$() voor. 		Het x-coordinaat van een punt 
!insmath A
$() dat op de rechte 
!insmath d
$() ligt is gelijk aan $val7. Stel je de rechte voor en zeg in welk kwadrant punt 
!insmath A
$() ligt: 	<p class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	text black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 
$()	</p>
$()
!exit

:hint
$()Hier is de grafiek van de rechte : 		<p class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	text black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 plot red , $val6*x	 
$()	</p>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <p>	<p class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	ttext black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 disk $val7,$val8,7,blue	 text black,$val7,$val8,medium,A	 plot red , $val6*x	 
$()	</p>
$()
!endif

!exit

:test

