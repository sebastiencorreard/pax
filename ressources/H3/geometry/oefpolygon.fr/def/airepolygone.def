val15=\(cm\)
val16=$[rint($val17)]
!endif
!endif
!if $val6=3 
val13=triangle \(ABC\). On sait que 
!if $val7=1 
val14=sa hauteur est égale à \($val8\) \(cm\) et sa base à \($val9\) \(cm\).	   Son aire vaut
val15=\(cm^2\)
val16=$[$val8*$val9/2]
!endif
!if $val7=2 
val14=\(AB\) est égal \($val8\) \(cm),  \(AC\) à \($val9\) cm et	   l'angle \(\widehat{BAC}\) à \($(val11[$val10;1])^\circ\). Son aire vaut
val15=\(cm^2)
val19=$[sin($(val11[$val10;1])*pi/180)]
val16=$[$val8*$val9*$val19/2]
!endif
!endif
!if $val6=4 
val13=losange \(ABCD\). On sait que 
!if $val7=1 
val14=ses diagonales sont égales à \($val8) \(cm\) et \($val9\) \(cm\).	  Son aire vaut
val15=\(cm^2\)
val16=$[$val8*$val9/2]
!endif
!if $val7=2 
val14=la longueur de son côté est égale à \($val8) \(cm\) et	   l'un de ses angles  à \($(val11[$val10;1])^\circ\). Son aire vaut
val15=\(cm^2\)
val19=$[sin($(val11[$val10;1])*pi/180)]
val16=$[$val19*$val8^2]
!endif
!endif
!if $val6=5 
val13=parallélogramme \(ABCD\). On sait que 
!if $val7=1 
