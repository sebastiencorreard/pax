!endif
!if $val7=2 
val14=son aire vaut \($val12\) \(cm^2\). Son côté a pour longueur
val15=\(cm)
val16=$[rint($val8)]
!endif
!endif
!if $val6=2 
val12=$[rint($val8*$val9)]
val17=$[rint($val9)]
val18=$[rint($val8)]
!if $val8<$val9 
val17=$[rint($val8)]
val18=$[rint($val9)]
!endif
val13=rectangle \(ABCD). On sait que 
!if $val7=1 
val14=sa longueur est égale à \($val18\) \(cm\) et	  sa largeur à \($val17\) \(cm\). Son aire vaut
val15=\(cm^2\)
val16=$[rint($val12)]
!endif
!if $val7=2 
