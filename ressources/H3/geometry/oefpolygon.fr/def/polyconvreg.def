!set title=Polygone convexe régulier*
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=Marie-Claude.David@universite-paris-saclay.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=100

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 6

val6=$[rint($(tmp0))]
tmp0=!randint 3, 15

val7=$[rint($(tmp0))]
tmp0=!randint 1, 6

val8=$[rint($(tmp0))]
!if $val6=1 
val9=Chaque angle de \(P\)
val10=$[($val7-2)*180/$val7]
!endif
!if $val6=2 
val9=Chaque angle au centre de \(P\) 
val10=$[2*180/$val7]
!endif
!if $val6=3 
val9=La longueur de chaque côté de \(P\) 
val10=$[2*$val8*sin(pi/$val7)]
!endif
!if $val6=4 
val9=L'apothème de \(P\) 
val10=$[$val8*cos(pi/$val7)]
!endif
!if $val6=5 
val9=L'aire de \(P\) 
val10=$[$val7*($val8^2)*cos(pi/$val7)*sin(pi/$val7)]
!endif
!if $val6=6 
val9=Le périmètre de \(P\) 
val10=$[2*$val7*$val8*sin(pi/$val7)]
!endif
replytype1=numeric
replyname1=$val9 vaut
replygood1=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">Dans le plan affine euclidien, on considère	un polygone convexe régulier 
!insmath P
$() à 
!insmath $val7
$() côtés inscrit dans un cercle de	rayon 
!insmath $val8 \; cm
$().	<label for="reply1">$val9 vaut</label>  
!read oef/embed.phtml reply1,10 
$().</div>	<div class="wims_instruction">	Les angles sont mesurés en degré, les longueurs en cm et les aires en 
!insmath cm^2
$().	Vous pouvez utiliser la calculatrice de WIMS en cliquant sur outils	dans la barre de liens. </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=1
