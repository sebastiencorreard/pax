!set title=Nombres constructibles*
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=Marie-Claude.David@universite-paris-saclay.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=54
prevarcnt=52
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=les nombres rationnels sont constructibles
val7=l'ensemble des nombres constructibles est un sous-corps de \(\mathbb{R}\) (partie stable par les quatre opérations)
val8=la racine carrée d'un nombre constructible est constructible
val9=on sait que la quadrature du cercle est impossible
val10=on sait que la duplication du cube est impossible
val11=$val6,$val7,$val8,$val9,$val10
tmp0=!positionof item $val6 in $val11

val12=$(tmp0)
tmp0=!positionof item $val7 in $val11

val13=$(tmp0)
tmp0=!positionof item $val8 in $val11

val14=$(tmp0)
tmp0=!positionof item $val9 in $val11

val15=$(tmp0)
tmp0=!positionof item $val10 in $val11

val16=$(tmp0)
tmp0=!randitem 3,4,5,6,8,10,12,15,16,17,20

val17=$[rint($(tmp0))]
tmp0=!randitem 7,9,11,13,14,18,19

val18=$[rint($(tmp0))]
val19=le polygone régulier à \($val17) côtés est constructible
val20=le polygone régulier à \($val18) côtés n'est pas constructible
tmp0=!shuffle $val9,$val10,$val19,$val20

val11=$val6,$val7,$val8,$(tmp0)
tmp0=!positionof item $val6 in $val11

val12=$(tmp0)
tmp0=!positionof item $val7 in $val11

val13=$(tmp0)
tmp0=!positionof item $val8 in $val11

val14=$(tmp0)
tmp0=!positionof item $val9 in $val11

val15=$(tmp0)
tmp0=!positionof item $val10 in $val11

val16=$(tmp0)
tmp0=!positionof item $val19 in $val11

val21=$(tmp0)
tmp0=!positionof item $val20 in $val11

val22=$(tmp0)
tmp0=!randint 1, 7

val23=$[rint($(tmp0))]
tmp0=!randitem 0,1

val24=$[rint($(tmp0))]
tmp0=!randitem 7,11,13,17,19

tmp1=!randint 2, 6

val25=\frac{$(tmp0)}{$(tmp1)}
tmp0=!randint 101, 250

val26=$[$(tmp0)/100]
tmp0=!randitem 2,3,5,6,7,10

val27=$[rint($(tmp0))]
tmp0=!randitem $val25,$val26

val28=$(tmp0)
!if $val23=1 
val29=$val28
val30=1
val31=$val12
!endif
!if $val23=2 
tmp0=!randitem \sqrt{$val27}+$val28, \sqrt{\sqrt{$val27}+$val28}

val29=$(tmp0)
val30=1
val31=$val12,$val13,$val14
!endif
!if $val23=3 
val29=$val28+\pi 
val30=2
val31=$val12,$val13,$val15,$val14
!endif
!if $val23=4 
val29=$val28 \displaystyle{\sqrt[3]{2}}-$val27
val30=2
val31=$val12,$val13,$val16
!endif
!if $val23=5 
val29=\sqrt{$val28}
val30=1
val31=$val12,$val14
!endif
!if $val23=6 
val29=$val25 \sqrt{\pi}
val30=2
val31=$val12,$val13,$val15
!endif
!if $val23=7 
tmp0=!randitem $val17,$val18

val32=$[rint($(tmp0))]
val29=\frac{2 \pi}{$val32}
val30=2
val31=$val12,$val13,$val15,$val14
!endif
val33=oui,non
replytype1=radio
replyname1=
replygood1=$val30;$val33
replytype2=checkbox
replyname2=
replygood2=$val31;$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Le nombre 
!insmath $val29
$() est-il constructible ?  
!read oef/embed.phtml reply1 
$().	<p>	Cochez les affirmations qui justifient votre réponse et seulement celles-là.	</p>	<ul>	<li> 
!read oef/embed.phtml reply2,1 
$()</li>	<li> 
!read oef/embed.phtml reply2,2 
$()</li>	<li> 
!read oef/embed.phtml reply2,3 
$()</li>	<li> 
!read oef/embed.phtml reply2,4 
$()</li>	<li> 
!read oef/embed.phtml reply2,5 
$()</li>	<li> 
!read oef/embed.phtml reply2,6 
$()</li>	<li> 
!read oef/embed.phtml reply2,7 
$()</li>	</ul>	
$()
!exit

:hint
$()On rappelle que	<ul>	<li>la duplication du cube est impossible signifie que le nombre 
!insmath \displaystyle{\sqrt[3]{2}}
$() n'est pas constructible</li>	<li>la quadrature du cercle est impossible signifie que le nombre 
!insmath \sqrt{\pi}
$() n'est pas constructible</li>	<li>la constructibilité d'un polygone régulier à 
!insmath n
$() côtés est équivalente à celle du nombre 
!insmath \cos(2\pi/n)
$()</li>	<ul>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!replace internal \\ by \ in $m_reply2

val34=$(tmp0)

!exit

:feedback
!ifval ($val23=7) and ((($m_reply1 issametext oui) and ($val19 isitemof $val34)) or (($m_reply1 issametext non) and ($val20 isitemof $val34)))
 <div class='oef_feedbacks'>La question concerne la longueur 
!insmath $val29
$() et non l'angle 
!insmath $val29
$() !
$()</div>
!endif
!ifval ($m_reply1 issametext oui) and (($val9 isitemof $val34) or ($val10 isitemof $val34))
 <div class='oef_feedbacks'>Vous justifiez la constructibilité d'un nombre par un résultat de non-constructibilité !
$()</div>
!endif

!exit

