!set title=Placer un vecteur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=vectors,coordinates
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
precision=100

ansorder=r
varcnt=17
prevarcnt=13
postvarcnt=3
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-10,10
val7=-10,10
val8=300,300
tmp0=!randint 1, 2

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
tmp2=!randint 1, 2

tmp=!nonempty items 1,-1

tmp3=!randitem $tmp
val9=$(tmp0)*$(tmp1), $(tmp2)*$(tmp3)
t_=!replace internal \( by ( in [$val9]
tmp0=!exec pari $t_

val9=$(tmp0)
tmp0=!randint 1, 7

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
tmp2=!randint 1, 7

tmp=!nonempty items 1,-1

tmp3=!randitem $tmp
val10=$(tmp0)*$(tmp1), $(tmp2)*$(tmp3)
t_=!replace internal \( by ( in [$val10]
tmp0=!exec pari $t_

val10=$(tmp0)
val11=var brd = JXG.JSXGraph.initBoard('jxgbox', {boundingbox:[$(val6[1]),$(val7[2]),$(val6[2]),$(val7[1])],axis:true,keepaspectratio:true,grid:true});	   var P=brd.create('point',[$val9],{fixed:true,name:'',visible:false});	   var Q=brd.create('point',[$(val9[1])+1,$(val9[2])+1],{name:'',snapToGrid:true,size:1});	   var v=brd.create('arrow',[P,Q],{strokeColor:'black',name:''});	
val12=jxgbox_var1=[function(){return Q.X()},function(){return Q.Y()}],{name:'',visible:false} ;
t_=!replace internal \( by ( in [$val10] + [$val9]
tmp0=!exec pari $t_

val13=$(tmp0)
val14=Tracer le vecteur \(\vec{v} = ($val10)\).
!readproc slib/geo2D/jsxgraph jxgbox,$(val8[1])x $(val8[2]),$val11 
tmp0=$slib_out
val15=$(tmp0)
val11=$val11	jxgbox_rep1 = brd.create('point',jxgbox_var1,{strokeColor:'transparent',fillColor:'transparent',name:''}); 
replytype1=jsxgraph

replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14	<div class="wimscenter">	  
!read oef/embed.phtml r1,400x400	jxgbox brd	$val11	$val12	  
$()	 </div>	 
