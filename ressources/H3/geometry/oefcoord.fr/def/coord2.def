 <div class='oef_feedbacks'>	<script type="text/javascript">	/*<![CDATA[*/	   Q.setProperty('visible:false');v.setProperty('visible:false');	   var Q1=brd.create('point',[$(val16[1]),$(val16[2])],{name:'',visible:false,fixed:true});	   var v1=brd.create('arrow',[P,Q1],{strokeColor:'$val17',name:''});	   $val12	/*]]>*/	</script>	
$()</div>
