!ifval $m_sc_reply1=1
val17=green
!else
val17=red
!endif

!ifval $m_sc_reply1<1 
val12=	 var Q2=brd.create('point',[$(val9[1])+$(val10[1]),$(val9[2])+$(val10[2])],{name:'',visible:false,fixed:true});	 var v2=brd.create('arrow',[P,Q2],{strokeColor:'green',name:''});	
!endif

!exit

