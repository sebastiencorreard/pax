!set title=Parallélogramme ?
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=parallelogram
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim A,B,C,D	E,F,G,H	M,N,O,P
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]
tmp0=!randint -10, 10

val16=$[rint($(tmp0))]
tmp0=!randint -10, 10

val17=$[rint($(tmp0))]
!if ($val14-$val12)*($val17-$val13)-($val15-$val13)*($val16-$val12)=0 
val12=$[rint(1)]
val13=$[rint(-1)]
val14=$[rint(3)]
val15=$[rint(5)]
val16=$[rint(-2)]
val17=$[rint(-2)]
!endif
val18=$[rint($val14-$val12)]
val19=$[rint($val15-$val13)]
val20=$[rint($val16+$val18)]
val21=$[rint($val17+$val19)]
tmp0=!randint 1, 2

val22=$[rint($(tmp0))]
!if $val22=1 
val23=Oui
!else
val23=Non
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val20=$[rint($val20+($(tmp0)*$(tmp1)))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val21=$[rint($val21+($(tmp0)*$(tmp1)))]
!endif
choicename1=réponse
choicegood1=$val23
choicebad1=Oui,Non
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère,	on considère les points 
!insmath $val8
$(), 
!insmath $val9
$(), 
!insmath $val10
$() et 
!insmath $val11
$() de coordonnées	 respectives 
!insmath ($val12,$val13)
$(), 
!insmath ($val14,$val15)
$(), 
!insmath ($val16,$val17)
$() et 
!insmath ($val20,$val21)
$().	 Le quadrilatère 
!insmath $val8 $val9 $val11 $val10
$() est-il un parallèlogramme ? 
$()
!exit

