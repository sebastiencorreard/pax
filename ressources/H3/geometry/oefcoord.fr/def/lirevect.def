!set title=Lire les coordonnées d'un vecteur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=vectors
language=fr
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 
computeanswer=no
precision=10000

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -4, 4

val6=$[rint($(tmp0))]
tmp0=!randint -4, 4

val7=$[rint($(tmp0))]
tmp0=!randint -4, 4

val8=$[rint($(tmp0))]
tmp0=!randint -4, 4

val9=$[rint($(tmp0))]
!if $val6=$val8 and $val7=$val9 
val6=$[rint(2)]
val7=$[rint(3)]
val8=$[rint(1)]
val9=$[rint(-2)]
!endif
tmp0=!record 2 of src/graph.don

val10=$(tmp0)
val11=$[rint(150+($val6*30))]
val12=$[rint(150-($val7*30))]
val13=$[rint(150+($val8*30))]
val14=$[rint(150-($val9*30))]
tmp0=!record 2 of src/graph.don

val10=$(tmp0)
val10=$val10	arrow $val11,$val12,$val13,$val14,10,red
val15=$[rint($val8-($val6))]
val16=$[rint($val9-($val7))]
replytype1=auto

replyname1=Première coordonnée
replygood1=$val15
replytype2=auto

replyname2=Deuxième coordonnée
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Quelles sont les coordonnées du vecteur du plan dessiné dans le repère ci-dessous ?	<div class="wimscenter">	 
!read oef/draw.phtml 300,300 \
$val10 
$()	</div>	<br><span class="ans"><label for="reply1">Votre réponse</label></span> :	( 
!read oef/embed.phtml r1,3 
$(), 
!read oef/embed.phtml r2,3 
$())
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=2
