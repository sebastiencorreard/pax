!set title=Image par une translation 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=translation
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items u,v,w

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items A,B,C,M,N

tmp0=!randitem $tmp
val7=$(tmp0)
val8=$val7'
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
val13=$[rint($val11+$val9)]
val14=$[rint($val12+$val10)]
val15=Dans le plan muni d'un repère, le point \($val7\) a pour	  coordonnées \(($val11,$val12)\).	  Quelles sont les coordonnées de l'image du point \($val7\) par la translation	  de vecteur \(\overrightarrow{$val6}($val9,$val10))&nbsp;
val16=L'image du point \($val7) par la translation de vecteur	  \(\overrightarrow{$val6}) a pour coordonnées
replytype1=numexp
replyname1=Première coordonnée
replygood1=$val13
replytype2=numexp
replyname2=Deuxième coordonnée
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val15?	<hr class="wimscenter" style="width:50%">	<span class="ans">Votre réponse</span> :	<div><label for="reply1">$val16</label>( 
!read oef/embed.phtml r1,3 
$(), 
!read oef/embed.phtml r2,3 
$()).</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15,16
embedcnt=2
