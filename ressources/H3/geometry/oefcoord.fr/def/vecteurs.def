!set title=Coordonnées d'un vecteur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=vectors
language=fr
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 
computeanswer=no
precision=10000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
!if $val10=1 
val11=\overrightarrow{A B}
val12=$[rint($val8-$val6)]
val13=$[rint($val9-$val7)]
!else
val11=\overrightarrow{B A}
val12=$[rint($val6-$val8)]
val13=$[rint($val7-$val9)]
!endif
replytype1=auto

replyname1=Première coordonnée
replygood1=$val12
replytype2=auto

replyname2=Deuxième coordonnée
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère, on considère les points 
!insmath A
$() et 
!insmath B
$()	de coordonnées respectives 
!insmath ($val6,$val7)
$() et 
!insmath ($val8,$val9)
$().<br>	 <label for="reply1">Les coordonnées du vecteur 
!insmath $val11
$() sont</label> ( 
!read oef/embed.phtml r1,3 
$(), 
!read oef/embed.phtml r2,3 
$()).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,11
embedcnt=2
