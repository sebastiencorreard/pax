!set title=Point dans un repère (aidé)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=mcld@math.u-psud.fr

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(300)]
val7=xrange -7.2,7.2	   yrange -7.2,7.2	   parallel -7,-7,7,-7,0,1,16, grey	   parallel -7,-7,-7,7,1,0,16, grey	   hline 0,0,black	   arrow 6,0,7,0,8, black	  text black, 0.8,-0.1, normal, 1	   arrow 0,6,0,7,8, black	   text black, -0.5,1, normal, 1	   vline 0,0,black 
!readproc oef/draw.phtml $val6,$val6 \
 $val7 
tmp0=$ins_url
val8=$(tmp0)
tmp0=!randint -6, 6

val9=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 6

val10=$[rint($(tmp0)*$(tmp1))]
val11=$[7.2]
!readproc slib/draw/convpixel $val9,0,$val6,$val6,-$val11,$val11,-$val11,$val11,0,pixels 
tmp0=$slib_out
val12=$(tmp0) 
val13=$[$(val12[1]) ]
val14=$[$(val12[2]) ]
!readproc slib/draw/convpixel $val9,$val10,$val6,$val6,-$val11,$val11,-$val11,$val11,0,pixels 
tmp0=$slib_out
val15=$(tmp0) 
val16=$[$(val15[1]) ]
val17=$[$(val15[2]) ]
val18=$val7	 vline $val9,0,green	 circle $val9,0,10,green
!readproc oef/draw.phtml $val6,$val6 \
 $val18 
tmp0=$ins_url
val19=$(tmp0)
val20=$val18	 hline 0,$val10,orange	  disk $val9,$val10,10,blue
!readproc oef/draw.phtml $val6,$val6 \
 $val20 
tmp0=$ins_url
val21=$(tmp0)
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=coord
replyoption1=noanalyzeprint 
replyname1=
replygood1=$val8 ; point, $val13,$val14
replytype2=coord
replyname2=
replygood2=$val19 ; point, $val16,$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<span style="color:blue;">Cet exercice propose deux étapes pour placer	  le point 
!insmath A
$() de coordonnées 
!insmath ($val9,$val10)
$() dans le repère.</span><br>	
!if $m_step=1 
$()<b>Première étape :</b> Cliquez sur le point de coordonnées 
!insmath ($val9,0)
$().	        <div class="wimscenter"> 
!read oef/embed.phtml  reply1  
$() </div>	 
!endif
$()	
!if $m_step=2 
$()<i>Bravo ! Vous avez cliqué sur le point  de coordonnées 
!insmath ($val9,0)
$().</i><br>	<span style="color:green;">On a dessiné la droite verte qui porte tous les points d'abcisse 
!insmath $val9
$().</span> <br>	<b>Deuxième étape : </b> Maintenant, cliquez sur le point 
!insmath A
$().	        <div class="wimscenter"> 
!read oef/embed.phtml  reply2  
$() </div>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval  $m_result1 = -1 
 <div class='oef_feedbacks'>Le point de coordonnées 
!insmath ($val9,0)
$() est sur l'axe horizontal. <br>	<span style="color:green;">La droite verte porte tous les points d'abscisse 
!insmath $val9
$().</sapn>
$()</div>
!endif
!ifval 1=1 
 <div class='oef_feedbacks'><span style="color:orange;">La droite orange porte tous les points d'ordonnée 
!insmath $val10
$().</span>	<br><span style="color:blue;">Le point bleu est le point 
!insmath A
$() :</span>	    <div class="wimscenter">	    <img src="$val21" alt=""></div> 
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=9,10,21
embedcnt=2
