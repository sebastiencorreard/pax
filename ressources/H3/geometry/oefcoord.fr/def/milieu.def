!set title=Milieu d'un segment (calcul)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=midpoint
language=fr
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 
computeanswer=no
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=A,B,C,D,E,F,G,H
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
!ifval ($val9-$val11)^2+($val10-$val12)^2=0 
val9=$[rint(2)]
val10=$[rint(5)]
val11=$[rint(-3)]
val12=$[rint(1)]
!endif
val13=$[($val9+$val11)/2]
val14=$[($val10+$val12)/2]
replytype1=auto

replyname1=Première coordonnée
replygood1=$val13
replytype2=auto

replyname2=Deuxième coordonnée
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère orthonormé,	on considère les points 
!insmath $val7
$() et 
!insmath $val8
$() de coordonnées	respectives 
!insmath ($val9,$val10)
$() et 
!insmath ($val11,$val12)
$().	<label for="reply1">Les coordonnées du milieu du segment 
!insmath [$val7$val8]
$()</label> sont :	 ( 
!read oef/embed.phtml r1,3 
$(), 
!read oef/embed.phtml r2,3 
$())
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12
embedcnt=2
