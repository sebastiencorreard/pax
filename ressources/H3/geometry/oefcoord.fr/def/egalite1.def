!set title=Égalité vectorielle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=vectors
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items u,v,w

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items A,B,C,M,N

tmp0=!randitem $tmp
val7=$(tmp0)
val8=$val7'
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
val13=$[rint($val11+$val9)]
val14=$[rint($val12+$val10)]
tmp=!trim $val11,$val12,$val13,$val14,$val7 $val8	$val13,$val14,$val11,$val12,$val8 $val7
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

val11=$[rint($(tmp0))]
tmp0=!item 2 of $val15

val12=$[rint($(tmp0))]
tmp0=!item 3 of $val15

val13=$[rint($(tmp0))]
tmp0=!item 4 of $val15

val14=$[rint($(tmp0))]
tmp0=!item 5 of $val15

val16=$(tmp0)
val17=Dans le plan muni d'un repère, le point \($val7\) a pour coordonnées	  \(($val11,$val12)). Le vecteur \(\overrightarrow{$val6}) a pour coordonnées	  \(($val9,$val10)). Quelles sont les coordonnées du point \($val8) tel que	  \(\overrightarrow{$val16}=\overrightarrow{$val6})&nbsp;
val18=Le point \($val8) a pour coordonnées
replytype1=numexp
replyname1=Première coordonnée
replygood1=$val13
replytype2=numexp
replyname2=Deuxième coordonnée
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

