!set title=Longueur d'un segment (graphique)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=length
language=fr
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 
computeanswer=no
precision=10000

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=A,B,C,D,E,F,G,H
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!randint -4, 4

val9=$[rint($(tmp0))]
tmp0=!randint -4, 4

val10=$[rint($(tmp0))]
tmp0=!randint -4, 4

val11=$[rint($(tmp0))]
tmp0=!randint -4, 4

val12=$[rint($(tmp0))]
!ifval ($val9-$val11)^2+($val10-$val12)^2=0 
val9=$[rint(2)]
val10=$[rint(4)]
val11=$[rint(-3)]
val12=$[rint(1)]
!endif
val13=dixième,centième,millième
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val13

val15=$(tmp0)
val16=$[rint((($val9-$val11)^2+($val10-$val12)^2)^(1/2)*10^($val14))]
val16=$[$val16/(10^($val14))]
tmp0=!record 2 of src/graph.don

val17=$(tmp0)
val18=$[rint(150+($val9*30))]
val19=$[rint(150-($val10*30))]
val20=$[rint(150+($val11*30))]
val21=$[rint(150-($val12*30))]
!if $val9>$val11 
val22=$[rint(0)]
val23=$[rint(-10)]
!else
val23=$[rint(0)]
val22=$[rint(-10)]
!endif
val17=$val17	segment $val18,$val19,$val20,$val21,red	text black,$val18+$val22,$val19,medium,$val7	text black,$val20+$val23,$val21,medium,$val8
replytype1=algexp
replyname1=longueur
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère orthonormé,	on considère les points 
!insmath $val7
$() et 
!insmath $val8
$() représentés ci-dessous :	<div class="wimscenter">	 
!read oef/draw.phtml 300,300 \
$val17 
$()	</div>	Quelle est la longueur du segment 
!insmath [$val7$val8]
$() au $val15 près ?	<br><span class="ans">Votre réponse</span> :	  <label for="reply1">
!insmath $val7$val8=
$()</label> 
!read oef/embed.phtml r1,5 
$() unité
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,15,17
embedcnt=1
