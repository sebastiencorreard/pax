val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)
tmp=!nonempty items u,v,w

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 2, 4

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 2, 4

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -2, 2

val15=$[rint($(tmp0))]
tmp0=!randint -2, 2

val16=$[rint($(tmp0))]
val17=$[rint($val15+($val13))]
val18=$[rint($val16+($val14))]
!readproc slib/draw/repere $val6,$val7,20,-7,7,-7,7,1,1,black,grey 
tmp0=$slib_out
val19=$(tmp0)
tmp=!translate internal $	$ to ; in $val19

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!item 1 of $val20

val21=$[rint($(tmp0))]
tmp0=!item 2 of $val20

val22=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val19

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!item 1 of $val20

val23=$[$(tmp0)]
tmp0=!item 2 of $val20

val24=$[$(tmp0)]
tmp0=!line 3 to -1 of $val19

val25=$(tmp0)
val25=$val25	text black,$val21-10,$val22+4,small,O	text black,$val21+$val23-4,$val22+4,small,I	text black,$val21-12,$val22+$val24-4,small,J
val26=$[rint($val23*($val15)+($val21))]
val27=$[rint($val24*($val16)+($val22))]
val28=$[rint($val23*($val17)+($val21))]
val29=$[rint($val24*($val18)+($val22))]
val30=red
tmp=!trim $val10,$val11,$val26,$val27,$val28,$val29	$val11,$val10,$val28,$val29,$val26,$val27
val31=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val31

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val31=$(tmp0)
tmp0=!item 1 of $val31

val32=$(tmp0)
tmp0=!item 2 of $val31

val33=$(tmp0)
tmp0=!item 3 of $val31

