!set title=Parallélogramme (4ième sommet)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=parallelogram
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .ans {text-decoration:underline;font-weight:bold;} </style> 

ansorder=r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim A,B,C,D	E,F,G,H	M,N,R,P
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]
tmp0=!randint -10, 10

val16=$[rint($(tmp0))]
tmp0=!randint -10, 10

val17=$[rint($(tmp0))]
val18=$[rint(($val14-$val12)*($val17-$val13)-($val15-$val13)*($val16-$val12))]
!if $val18=0 
val12=$[rint(1)]
val13=$[rint(-1)]
val14=$[rint(3)]
val15=$[rint(5)]
val16=$[rint(-2)]
val17=$[rint(-2)]
!endif
val19=\overrightarrow{$val8 $val9}
val20=$[rint($val14-$val12)]
val21=$[rint($val15-$val13)]
val22=$[rint($val16+$val20)]
val23=$[rint($val17+$val21)]
val24=Dans le plan muni d'un repère, les points \($val8), \($val9) et \($val10)	  ont pour coordonnées respectives \(($val12,$val13)), \(($val14,$val15)) et \(($val16,$val17)).	  Quelles sont les coordonnées du point \($val11) tel que \($val8 $val9 $val11 $val10) soit	  un parallèlogramme
val25=Le point \($val11) a pour coordonnées
replytype1=numexp
replyname1=Première coordonnée
replygood1=$val22
replytype2=numexp
replyname2=Deuxième coordonnée
replygood2=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val24 ?	<hr class="wimscenter" style="width:50%">	<span class="ans">Votre réponse</span> :	<div><label for="reply1">$val25 </label>( 
!read oef/embed.phtml r1,3 
$(), 
!read oef/embed.phtml r2,3 
$()).</div>	
$()
!exit

