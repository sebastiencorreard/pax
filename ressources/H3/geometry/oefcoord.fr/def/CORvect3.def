!set title=Correspondance vecteurs-coordonnées 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
keywords=vectors, coordinates
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=25x60x60
val7=Mettre en relation chaque vecteur avec ses coordonnées.
val8=$[rint(3)]
val9=1,2,3
tmp0=!shuffle $val9

val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val9

val9=$[rint($(tmp0))]
val11=$val9;#;$val10,$val9;#;-$val10,-$val9;#;$val10,-$val9;#;-$val10,$val10;#;$val9,-$val10;#;$val9,$val10;#;-$val9,-$val10;#;-$val9
tmp0=!shuffle $val11

val11=$(tmp0)
val12=red;#;rouge,green;#;vert,yellow;#;jaune,purple;#;violet,blue;#;bleu,black;#;noir
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!item 1 to $val8 of $val12

val12=$(tmp0)
tmp0=!items2lines $val12

tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal ;#; by , in $val13

tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!record 2 of src/graph.don

val15=$(tmp0)
val16=
!for val17 =1 to $val8 
tmp0=!item $val17 of $val11

val18=$(tmp0)
val13=$val18
tmp0=!replace internal ;#; by , in $val18

val18=$(tmp0)
tmp0=!randint -2, 2

val19=$[rint($(tmp0))]
tmp0=!item 1 of $val18

val20=$[rint($(tmp0))]
val21=$[rint($val19+($val20))]
tmp0=!randint -2, 2

val22=$[rint($(tmp0))]
tmp0=!item 2 of $val18

val23=$[rint($(tmp0))]
val24=$[rint($val22+($val23))]
val25=$[rint(150+($val19*30))]
val26=$[rint(150-($val22*30))]
val27=$[rint(150+($val21*30))]
val28=$[rint(150-($val24*30))]
val15=$val15	arrow $val25,$val26,$val27,$val28,10,$(val12[$val17])
val13=($val20,$val23)
tmp0=!append item $val13 to $val16

val16=$(tmp0)
!next
replytype1=correspond
replyname1=Réponses
replygood1=$val14;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 300,300 \
$val15 
$()</div>	 <div class="medium_size text_col">	  $val7	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val6 
$()	</div>	 </div>	</div>	
$()
!exit

