!set title=Hauteur d'un arbre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, XIAO 
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=De hoogte van een boom

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=L'angle, mesure,l'angle,	  et l'observateur se trouve à, de l'arbre. Calculer la hauteur de l'arbre à un mètre près.
val8=Hauteur de l'arbre
!if $val6=nl 
val7=De hoek, is,De hoek,	  Het mannetje staat, van de boom. Bereken hiermee de hoogte (in meter) van de boom.
val8=De hoogte van de boom is
!endif
tmp=!trim 5,40,12,5	6,45,15,8
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!item 3 of $val10

val13=$(tmp0)
tmp0=!item 4 of $val10

val14=$(tmp0)
replyname1=$val8
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val7[1]) 
!insmath B A H
$() $(val7[2]) $val12&deg;,	$(val7[3]) 
!insmath H A C
$() $(val7[2]) $val13&deg; $(val7[4]) $val11 m	$(val7[5])	<div class="wimscenter">	<img src="$val1/hauteurarbre.gif" alt="">	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,7,11,12,13
embedcnt=0
