!set title=Échelle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, XIAO 
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Ladder

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Une échelle E est appuyée contre un mur,	  mesure
tmp=!trim Combien mesure l'angle,arrondi au degré près	  Combien mesure l'échelle,arrondi au décimètre près
val8=!translate internal $	\
$ to ;; in $tmp
val9=L'angle,en degré,Longueur de l'échelle
!if $val6=nl 
val7=Een ladder E steunt tegen een muur,	  is, lang
tmp=!trim Hoe groot is de hoek,rond je getal af	  Hoe lang is de ladder,arfronden op een decimeter
val8=!translate internal $	\
$ to ;; in $tmp
val9=Hoek,in graden,Lengte van de ladder
!endif
tmp=!trim 2,1	3,1	4,1	5,2	6,2	7,2	8,2	9,3	
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!item 1 of $val11

val10=$(tmp0)
tmp0=!item 2 of $val11

val12=$(tmp0)
val13=$[rint(atan($val10/$val12)*180/pi)]
val14=$[rint(10*sqrt($val10^2+$val12^2))/10]
replyname1=$(val9[1]) B $(val9[2])
replygood1=$val13
replyname2=$(val9[3])
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wimscenter">	 
!read oef/draw.phtml 150,250 \
	xrange -15,15	yrange -25,25	segment -15,-24,15,-24,black	rect -14,24,0,-24,black	fill -5,0,grey	segment 0,15,14,-24,black	text black,7,0,medium,E	text black,-7,0,medium,B	text black,0.5,16.5,medium,C	text black,0.5,-21.5,medium,A	text black,12,-21.5,medium,B	 
$()	</div>	$(val7[1]) 
!insmath B
$(), 
!insmath A C
$() $(val7[2]) $val10 m $(val7[3]),	
!insmath A B
$() $(val7[2]) $val12 m $(val7[3]).	$(val8[1;1]) 
!insmath \widehat B
$() ($(val8[1;2])) ?	$(val8[2;1]) ($(val8[2;2])) ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

