# Variable declaration file.
#
# Only those variables with possible user inputs or requiring inter-request
# savings need to be declared in this file.
#
#Each non-comment line defines a variable. Format of the line:
#
#name	allow
#
#name: name of the variable
#allow: when allow the user to override the defined value.
#       it maybe any, deny, init, config, reply.
#
#
#name	allow

status	deny
error deny
droite deny
dessin deny
dessin1 deny
dessin2 deny

color1 deny
color2 deny
color0 deny
couleur0 deny
couleur2 deny
couleur1 deny
dessinsol deny
border deny
equation deny
equationlin deny
eq_tex deny
mode any
proj any
diff any
centre init
x_size init
xsize1 init
xsize2 init
ysize2 init
yy_size init
xx_size init
inssize init
click_x reply
click_y reply
insdraw_size deny
a deny
b deny
A deny
B deny
pente deny
ord deny
liste deny
liste_c deny
 click_cnt deny
 reply_cnt any
 erreur deny
 miss deny
incert deny
module_score deny
err deny
ring_size deny
X1 deny
X2 deny
Y1 deny
Y2 deny
e1 deny
e2 deny
