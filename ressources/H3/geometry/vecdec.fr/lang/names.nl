!set lang_exists=yes

!set couleurs=blauw,oranje,rode

!! intro
!set name_intro=is een oefening over het ontbinden van een vector in het vlak langs twee richtingen, en over de verkregen
!set name_list=projectie, ontbinding, le symétrique
!set name_list2=orthogonale,willekeurige
!set name_level=Moeilijkheidsgraad
!set name_level_help=in de niveaus hoger dan 1, komen er ook overbodige lijnen bij
!set name_instruction1=Je wordt gevraagd naar de 
!set name_instruction2= van de gegeven vector langs twee  

!! answer
!set name_congratulation=!nosubst Gefeliciteerd met dit juist antwoord.,Het antwoord is in het $couleur0.
!set name_module_score=!nosubst Je hebt een eindresultaat geboekt van  $module_score uit 10 punten.

!! present
!set name_preswarning=De punten liggen te dicht bij elkaar. Opnieuw.

!!present
!set name_statement=!nosubst Hier is een vector in het $couleur0. Er wordt gevraagd om de 
!set name_vector1=!nosubst van de vector op de $couleur1 lijn  te geven evenwijdig aan de $couleur2 lijn, van de vector langs de $couleur1 en $couleur2 lijnen te geven
!set name_vector2=!nosubst van de vector loodrecht op de  $couleur1 lijn te geven, van de vector langs deze lijn en de lijn die er loodrecht op staat te geven, orthogonale par rapport à la droite $couleur1


!!form
!set name_list3=van de projectie,van een van de vectorende, du symétrique
!set name_click2=Klik op het eindpunt van de tweede vector
!set name_click1=Klik op het eindpunt