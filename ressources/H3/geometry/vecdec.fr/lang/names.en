!set lang_exists=yes

!set couleurs=blue,orange,red

!! intro
!set name_intro= is an exercice on projection, decomposition or symmetry of a planar vector along two directions
!set name_list= the  projection, the  decomposition, the symmetry
!set name_list2=orthogonal,non-orthogonal
!set name_level=Difficulty level
!set name_level_help= for upper levels some extraneous lines appear
!set name_instruction1= You need to draw
!set name_instruction2= of the given vector
!! answer
!set name_congratulation=!nosubst Congratulation for this awesome answer, The right answer is in $couleur0.
!set name_module_score=!nosubst You scored $module_score (over 10) points for this answer.

!! present
!set name_preswarning=The points are too close. Try again.

!!present
!set name_statement=!nosubst Here is a  $couleur0 vector. The goal is to find
!set name_vector1=!nosubst of the vector onto the $couleur1 line along the $couleur2 line, of the vector onto the $couleur1 and $couleur2 lines, of the vector across the  $couleur1 line along the $couleur2 line
!set name_vector2=!nosubst of the vector  onto the $couleur1 line orthogonally to it, of the vector along this line and its orthogonal, of the vector across the $couleur1 line orthogonally to it

!!form
!set name_list3=of the projection, of one of the vectors, of the symmetric
!set name_click2=Click on the extremity of the second vector
!set name_click1=Click on the extremity
