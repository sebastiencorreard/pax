!set lang_exists=yes

!set couleurs=blau, taronja, vermella

!! intro
!set name_intro=és un exercici sobre les projeccions, descomposició i simetries d'un vector en el pla segons dues direccions
!set name_list=la projecció, la descomposició, el simètric
!set name_list2=ortogonals, qualssevol
!set name_level=Nivell de dificultat
!set name_level_help=en els nivells diferents a l'1, apareixen algunes rectes alienes a l'exercici
!set name_instruction1=Heu de dibuixar
!set name_instruction2=del vector donat segons dues direccions

!! answer
!set name_congratulation=!nosubst Felicitacions per la seva excel·lent resposta, La resposta correcta es mostra en $couleur0.
!set name_module_score=!nosubst Tens $module_score punts (sobre 10) per aquesta resposta.

!! present
!set name_preswarning=Els punts estan molt a prop. Torneu a provar-ho.

!!present
!set name_statement=!nosubst A continuació es mostra un vector en $couleur0. Troba
!set name_vector1=!nosubst del vector sobre la recta $couleur1 de forma paralel·la a la recta $couleur2, del vector segons les rectes $couleur1 i $couleur2, del vector respecto a la recta $couleur1 paral·lela a la recta $couleur2
!set name_vector2=!nosubst ortogonal del vector sobre la recta $couleur1, del vector segons aquesta recta i la recta ortogonal, ortogonal respecte a la recta $couleur1

!!form
!set name_list3=de la projecció, d'un dels vectors, del simètric
!set name_click2=Clica sobre l'extrem del segon vector
!set name_click1=Clica sobre l'extrem
