!set lang_exists=yes

!set couleurs=blu,arancione,rossa

!! intro
!set name_intro=è un esercizio sulle proiezioni, scomposizioni e simmetrie rispetto a due direzioni nel piano
!set name_list=la proiezione,la scomposizione,il simmetrico
!set name_list2=ortogonali,non ortogonali
!set name_level=Livello di difficoltà
!set name_level_help=nei livelli superiori a 1 appariranno anche rette distrattrici
!set name_instruction1=Viene richiesto di costruire
!set name_instruction2=del vettore dato secondo due direzioni

!! answer
!set name_congratulation=!nosubst Bravo ottima risposta,La risposta corretta è rappresentata in $couleur0.
!set name_module_score=!nosubst Avete ottenuto $module_score punti (su 10) per questa risposta.

!! present
!set name_preswarning=I punti sono troppo vicini. Ricomincia.

!!present
!set name_statement=!nosubst Nel disegno è rappresentato un vettore $couleur0. Si deve trovare
!set name_vector1=!nosubst del vettore sulla retta $couleur1 parallelamente alla retta $couleur2, del vettore secondo le rette $couleur1 e $couleur2, del vettore rispetto alla retta $couleur1 parallelamente alla retta $couleur2
!set name_vector2=!nosubst ortognale del vettore sulla retta $couleur1, del vettero secondo la retta $couleur1 e la perpendicolare a tale retta, perpendicolarmente rispetto alla retta $couleur1

!!form
!set name_list3=della proiezione, di uno dei vettori, del simmetrico
!set name_click2=Cliccare sull'estremo del secondo vettore
!set name_click1=Cliccare sull'estremo 
