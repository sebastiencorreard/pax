!set lang_exists=yes

!set couleurs=azul,naranja,roja

!! intro
!set name_intro=es un ejercicio sobre las proyecciones, descomposición y simetrías de un vector en el plano según dos direcciones
!set name_list=la proyección, la descomposición, el simétrico
!set name_list2=ortogonales,cualesquiera
!set name_level=Nivel de dificultad
!set name_level_help=en los niveles distintos al 1, aparecen algunas rectas ajenas al ejercicio
!set name_instruction1=Usted debe dibujar
!set name_instruction2=del vector dado según dos direcciones

!! answer
!set name_congratulation=!nosubst Felicitaciones por su excelente respuesta, La respuesta correcta se muestra en $couleur0.
!set name_module_score=!nosubst Usted obtuvo $module_score puntos (sobre 10) por esta respuesta.

!! present
!set name_preswarning=Los puntos están muy cerca. Intente de nuevo.

!!present
!set name_statement=!nosubst A continuación se muestra un vector en $couleur0. Encuentre
!set name_vector1=!nosubst del vector sobre la recta $couleur1 de forma paralela a la recta $couleur2, del vector según las rectas $couleur1 y $couleur2, del vector con respecto a la recta $couleur1 paralela a la recta $couleur2
!set name_vector2=!nosubst ortogonal del vector sobre la recta $couleur1, del vector según esta recta y la recta ortogonal, ortogonal con respecto a la recta $couleur1

!!form
!set name_list3=de la proyección, de uno de los vectores, del simétrico
!set name_click2=Haga clic sobre el extremo del segundo vector
!set name_click1=Haga clic sobre el extremo
