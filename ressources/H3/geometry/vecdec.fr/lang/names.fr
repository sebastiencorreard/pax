!set lang_exists=yes

!set couleurs=bleu,orange,rouge

!! intro
!set name_intro=est un exercice sur les projections, décompositions et symétries d'un vecteur dans le plan selon deux directions
!set name_list=la projection, la décomposition, le symétrique
!set name_list2=orthogonales,quelconques
!set name_level=Niveau de difficulté
!set name_level_help=dans les niveaux autres que 1, des droites parasites apparaissent
!set name_instruction1=Tracer
!set name_instruction2=du vecteur donné selon deux directions

!! answer
!set name_congratulation=!nosubst Bravo pour cette très bonne réponse,La bonne réponse est en $couleur0.
!set name_module_score=!nosubst Vous avez obtenu $module_score points (sur 10) pour cette réponse.

!! present
!set name_preswarning=Les points sont trop proches. Recommencez.

!!present
!set name_statement=!nosubst Voici un vecteur dessiné en $couleur0. Il s'agit de trouver
!set name_vector1=!nosubst du vecteur sur la droite $couleur1 parallèlement à la droite $couleur2, du vecteur selon les droites $couleur1 et $couleur2, du vecteur par rapport à la droite $couleur1 parallèlement à la droite $couleur2
!set name_vector2=!nosubst orthogonale du vecteur sur la droite $couleur1, du vecteur selon cette droite et la droite orthogonale, orthogonale par rapport à la droite $couleur1

!!form
!set name_list3=de la projection, d'un des vecteurs, du symétrique
!set name_click2=Cliquer sur l'extrémité du deuxième vecteur
!set name_click1=Cliquer sur l'extrémité
