!! generated with canvasdraw ; js-file modified to draw arrows from fixed point (0;0)
!! for this purpose modified canvasdraw.h MAX_INT to ensure that snaptopoints array can contain 360 points (x;y)
!! note: probably best to introduce an extra command for userdraw primitives, something like 'fixed_point x,y'

!set xsize=400
!set ysize=400
!set size_X=!nospace $xsize px
!set size_Y=!nospace $ysize px
<div id="canvas_div" style="display:block;position:relative;width:$size_X;height:$size_Y;margin-left:auto;margin-right:auto;">
 <canvas id="wims_canvas1" width="$size_X" height="$size_Y"></canvas>
</div>
<script type="text/javascript">

function sendanswer(){
 var rep = read_canvas();
 if(rep.indexOf('NaN') != -1 ){setAlarm("Hmmmm...<br />"+rep);return;};
 var ans = rep.split(',');
 var reply = -1;
 if(ans[2] == 0 && ans[3] == 1){
  reply = 90;
 }
 else
 {
  if(ans[2] == 0 && ans[3] ==-1){
   reply = 270;
  }
  else
  {
   if(ans[2] == 1 && ans[3] == 0){
    reply = 0;
   }
   else
   {
    if(ans[2] ==-1 && ans[3] == 0){
     reply = 180;
    }
   }
  }
 }
 if(reply == -1){
  var angle = parseInt(180*(Math.atan(ans[3]/ans[2]))/Math.PI);
  if(ans[2]>0 && ans[3]>0){
   reply = angle;
  }
  else
  {
   if(ans[2]<0 && ans[3]>0){ 
    reply = 180 + angle;
   }
   else
   {
    if(ans[2]<0 && ans[3]<0){
     reply = 180 + angle;
    }
    else
    {
     if(ans[2]>0 && ans[3]<0){
       reply = 360 + angle;
     }
    }
   }
  }
 }
 reply = Math.PI*reply/180;
 myConfirm('$send ?',reply,'$wims_ref_name','$session','$module','$counter','$ok_send_color');
}
