# Pythagoras III
# gelijk aan exo11 maar dan ook andere onbekende zijden
n=$counter
math=0
mathview=0
questiontype=1
# multiplechoice
multiimage=1
image=0
plot=0
draw=0
applet=0
make_tr=1

!if $rounding != -1
    $rounding = -1
    !readproc $remarkdir/rounding.$taal
!endif
!if $options >6 or $options < 2
    options=4
!endif

checkfile=$checkdir/multiplechoice.proc

g1=5,3,20,12,15,6,9,18,21,10,15,20,25,30,24,27
g2=12,4,48,16,20,8,12,24,28,24,36,48,60,72,32,36
k=!randint 1,16
#max=!itemcnt $g1
l1=!item $k of $g1
l2=!item $k of $g2
!if $l1>$l2
    AC=$l1
    AB=$l2
!else
    !if $l1<$l2
	AC=$l2
	AB=$l1
    !else
	AC=$[$l1+4]
	AB=$l1
    !endif
!endif
BC=$[sqrt(($AB)^2 + ($AC)^2)]

keuzes=$empty
!for p=1 to $options
    keuzes=!append item $p to $keuzes
!next p
keuzes=!shuffle $keuzes

answer$n=!randint 1,$options
xsize=180
ysize=120
image_settings$n=$xsize,$ysize
!for p=1 to $options
    !if $p=$(answer$n)
ex$p=!exec canvasdraw\
size $xsize,$ysize\
xrange 0,1\
yrange 0,1\
fontfamily bold 16px Ariel\
copy 0,1,-1,-1,-1,-1,$module_dir/gifs/ABC.gif\
string black,0.4,0.6,$BC\
string black,0.4,0.1,$AC\
string black,0.8,0.5,$AB
	
object$n=$(ex$p)
     !else
	keuze=!item $p of $keuzes
	pm=!randitem +,-
        !if $keuze=1
	    bc=$[$BC $pm 1]
	    ac=$AC
	    ab=$AB
	!else
	    !if $keuze=2
		bc=$BC
		ac=$[$AC $pm 1]
		ab=$AB
	    !else
		!if $keuze=3
		    bc=$BC
		    ac=$AC
		    ab=$[$AB $pm 1]
		!else
		    pp=!randitem +,-
		    !if $keuze=4
			bc=$[$BC $pm 1]
			ac=$[$AC $pp 1]
			ab=$AB
		    !else
			!if $keuze=5
			    bc=$[$BC $pm 1]
			    ac=$AC
			    ab=$[$AB $pp 1]
			!else
			    !if $keuze=7
				bc=$BC
			        ac=$[$AC $pm 1]
				ab=$[$AB $pp 1]
			    !else
				# maximum options = 8
				mp=!randitem +,-
				bc=$[$BC $mp 1]
			        ac=$[$AC $pm 1]
				ab=$[$AB $pp 1]
			    !endif
			!endif
		    !endif
		!endif
	    !endif
	!endif
ex$p=!exec canvasdraw\
size $xsize,$ysize\
xrange 0,1\
yrange 0,1\
copy 0,1,-1,-1,-1,-1,$module_dir/gifs/ABC.gif\
fontfamily bold 16px Ariel\
string black,0.4,0.6,$bc\
string black,0.4,0.1,$ac\
string black,0.8,0.5,$ab

     !endif
!next p
telwoorden=!record 59 of $remarkdir/commonremarks.$taal
aantal=!item $options of $telwoorden
ss=!record 74 of lang/remarks.$taal
#@<b>Bereken</b> welke van de onderstaande $aantal driehoeken<br />een <b>rechte</b> hoek in A heeft.<br />[dus 90<sup><small>o</small></sup>] ?

question$n=$ss

helptext=PYTHAGORAS !!! <img src=\'$module_dir/gifs/pytha.gif\' /> 
