	!else
	    bd=?
	    cd=$CD
	    r4=$empty
	    r5=readonly="readonly"
	    k4=lightgreen
	    k5=orange
	    texanswer$n=\left[ \begin{array}{l} \,?\, + BC^{2} = AB^{2} \rightarrow  \,?\, = AC = \sqrt{$AB^{2} - $BC^{2}} = $AC \\ CD^{2} + BC^{2} = \,? \rightarrow \,?\, = BD = \sqrt{$CD^{2} + $BC^{2}} = $BD \end{array}
        !endif
    !else
	ab=$AB
	bc=?
	ac=$AC
	r1=readonly="readonly"
	r2=$empty
	r3=readonly="readonly"
	k1=orange
        k2=lightgreen
	k3=orange
	!if $kans=1
	    bd=$BD
	    cd=?
	    r4=readonly="readonly"
	    r5=$empty
	    k4=orange
	    k5=lightgreen
	    texanswer$n=\left[ \begin{array}{l} AC^{2} + \,?\, = AB^{2} \rightarrow  \,?\, = BC = \sqrt{$AB^{2} - $AC^{2}} = $BC \\ ?\, + BC^{2} = BD^{2} \rightarrow \,? \,= CD = \sqrt{$BD^{2} - $BC^{2}} = $CD \end{array}
	!else
	    bd=?
	    cd=$CD
	    r4=$empty
	    r5=readonly="readonly"
