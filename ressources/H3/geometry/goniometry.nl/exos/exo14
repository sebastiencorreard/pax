##################

!if $keuze=1
    ab=?
    bc=$BC
    ac=$AC
    r1=$empty
    r2=readonly="readonly"
    r3=readonly="readonly"
    k1=lightgreen
    k2=orange
    k3=orange
    !if $kans=1
	bd=$BD
	cd=?
	r4=readonly="readonly"
	r5=$empty
	k4=orange
	k5=lightgreen
	texanswer$n=\left[ \begin{array}{l} AC^{2} + BC^{2} = \,? \rightarrow \,?\, = AB = \sqrt{$AC^{2} + $BC^{2}} = $AB \\ ?\, + BC^{2} = BD^{2} \rightarrow \,? \,= CD = \sqrt{$BD^{2} - $BC^{2}} = $CD \end{array}
    !else
	bd=?
	cd=$CD
	r4=$empty
