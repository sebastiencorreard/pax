    !endif
    
!else
    !if $keuze=2
	ab=$AB
	bc=$BC
	ac=?
	r1=readonly="readonly"
	r2=readonly="readonly"
	r3=$empty
	k1=orange
        k2=orange
        k3=lightgreen
	!if $kans=1
	    bd=$BD
	    cd=?
	    r4=readonly="readonly"
