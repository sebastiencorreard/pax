	    k5=orange
	    texanswer$n=\left[ \begin{array}{l} AC^{2} + \,?\, = AB^{2} \rightarrow  \,?\, = BC = \sqrt{$AB^{2} - $AC^{2}} = $BC \\ CD^{2} + BC^{2} = \,? \rightarrow \,?\, = BD = \sqrt{$CD^{2} + $BC^{2}} = $BD \end{array}
	!endif
    !endif
