n=$counter
math=0
mathview=0
questiontyp=0
embed=1
cols=15
rows=1
inpust=1.1
checkfile=$checkdir/number.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif
# ivm automatisch html file genereren
sr=$R
#
#een willekeurig punt $A 
X1=!randitem -7,-6,-5,-4,-3,-2
Y1=!randitem 2,3,4,5,6,7
dx=!randitem 3,4,5,6,7,8,9,10
dy=!randitem -10,-9,-8,-7,-6,-5,-4,-3

#nog een willekeurig net punt
X2=$[$X1+($dx)]
Y2=$[$Y1+($dy)]

#de lijn door X1Y1 X2Y2 y=m1x+q
m1=$[$dy/$dx]
q1=$[$Y1-($m1)*$X1]

#de lijn loodrecht hierop is dus in X1Y1
m2=$[-1*$dx/$dy]
q2=$[$Y1-($m2)*$X1]

#eem mooie Y3
Y3=!randitem -7,-6,-5,-4,-3,-2,-1,0

#bijpassende X3-waarde
X3=$[($Y3-($q2))/($m2)]

#het maximum en minimum voor het plaatje
MIN=$[min($X1,min($X3,min($Y1,min($Y2,$Y3))))]
MAX=$[max($X2,max($X3,max($Y1,max($Y2,$Y3))))]

#lengte AB is dus (X1:Y1) -- (X2:Y2)
#lengte AC is dus (X1:Y1) -- (X3:Y3)
#lengte BC is dus (X2:Y3) -- (X3:Y3)

AC=$[round(10*(sqrt(($X1-$X2)^2 + ($Y1-$Y2)^2)))/10]
AB=$[round(10*(sqrt(($X1-$X3)^2 + ($Y1-$Y3)^2)))/10]
BC=$[round(10*(sqrt(($X2-$X3)^2 + ($Y2-$Y3)^2)))/10]
    
rounding=100
hoek=$[(round($rounding*(atan($AB/$AC))*180/pi))/$rounding]

########PLAATJE############
keuze=!randitem 1,2,3,4
A=!item $keuze of  A,D,K,P
B=!item $keuze of  B,E,L,Q
C=!item $keuze of  C,F,M,R
A=A
B=B
C=C
!if $R=1
    ex1=$empty
    rounding=100
    !readproc $remarkdir/rounding.$taal
    formula$n=\tan\left(\angle $C \right) 
    applettext=!nospace tan($C)=
    answer$n=$[$AB/$AC]
    answ=\frac{$AB}{$AC}
    ans=$[(round($rounding*$(answer$n)))/$rounding]
    ss=!record 1 of lang/remarks.$taal
    rr=!record 2 of lang/remarks.$taal
    texanswer$n=\tan\left(\angle $C \right) = $answ \simeq $(answer$n)\simeq $ans
 !goto KLAAR
!endif

!if $R=2
    ex1=&deg;
    rounding=100
    !readproc $remarkdir/rounding.$taal
    answer$n=$hoek
    formula$n=\angle $C
    answ=\tan^{-1}\left(\frac{$AB}{$AC}\right)
    texanswer$n=\angle $C = $answ \simeq $hoek ^{o} 
    ss=!record 3 of lang/remarks.$taal
    rr=!record 4 of lang/remarks.$taal
 !goto KLAAR
!endif
 
!if $R=3
    ex1=$empty
    answer$n=$[$AC*(tan($hoek*pi/180))]
    rounding=10
    formula$n=\bf{d}\left($A$B\right)
    ans=$[(round($rounding*$(answer$n)))/$rounding]
    answ=$AC \cdot \tan($hoek)
    texanswer$n=$A$B = $answ \simeq $(answer$n)\simeq $ans
    !readproc $remarkdir/rounding.$taal
    ss=!record 5 of lang/remarks.$taal
    rr=!record 6 of lang/remarks.$taal
!else
    answer$n=$[$AB/(tan($hoek*pi/180))]
    rounding=10
    ans=$[(round($rounding*$(answer$n)))/$rounding]
    answ=\frac{$AB}{\tan($hoek)}
    formula$n= \bf{d}\left($A$C\right)
    texanswer$n=$A$C = $answ \simeq $(answer$n) \simeq $ans
    !readproc $remarkdir/rounding.$taal
    ss=!record 7 of lang/remarks.$taal
    rr=!record 8 of lang/remarks.$taal
!endif

:KLAAR
question$n=$ss
textanswer$n=$rr

!if $teaching=1
    applet=1
    !if $sr=1 or $sr=2 or $sr=4 
	text1=string black,$[($X1+$X3)/2],$[($Y1+$Y3)/2+0.8],$AB
    !else
	text1=empty
    !endif
    !if $sr=1 or $sr=2 or $sr=3 
	text2=string black,$[($X1+$X2)/2-0.5],$[($Y1+$Y2)/2+0.5],$AC
    !else
	text2=empty
    !endif
    !if $sr=3 or $sr=4
	text3=string black,$[$X2-2.9],$[$Y2+0.8],$hoek
    !else
	text3=empty
    !endif

    make_tr=0
    xsize=220
    ysize=220
    k=!randitem red,blue,orange,green

object$n=!exec canvasdraw\
size $xsize,$ysize\
xrange $[$MIN-2],$[$MAX+2]\
yrange $[$MIN-2],$[$MAX+2]\
linewidth 1\
opacity 200,30\
ftriangle $X1,$Y1,$X2,$Y2,$X3,$Y3,$k\
opacity 255,255\
linewidth 8\
fontfamily 14px Ariel\
linewidth 2\
points green,$X1,$Y1,$X3,$Y3\
string black,$[$X1+0.5],$[$Y1+0.5],$A\
string black,$[$X2+0.5],$[$Y2+0.5],$C\
string black,$[$X3+0.5],$[$Y3+0.5],$B\
point $X2,$Y2,red\
$text1\
$text2\
$text3\
zoom $k

!endif
