# Pythagoras VI
n=$counter
math=0
mathview=0
questiontype=0
inputs=4
cols=6
rows=1
image=0
!if $rounding<0
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif
# var2 is de range: min1:max1,min2:max2,min3:max3...
checkfile=$checkdir/units.proc

!if $level=0 
    R=$counter
!else
    R=$level
!endif

k=!randint 1,4
ac=13,13,5,5
ab=5,12,3,4
bc=12,5,4,3
AC=!item $k of $ac
AB=!item $k of $ab
BC=!item $k of $bc

!if $R=1
    f=!randint 1,5
!else
    !if $R=2
	f=!randint 10,50
	f=$[$f/10]
    !else
	f=!randint 100,500
	f=$[$f/100]
    !endif
!endif
AC=$[$f*$AC]
AB=$[$f*$AB]
BC=$[$f*$BC]

#     X     X
#
#
#
# X	  	 X
#
#
# A	  	 X
#
#
#
# B    C    X


AC=$[sqrt(($AB)^2 + ($BC)^2)]
A=$AC
B=$BC
ff=!randint 20,80
C=$[round($ff*$AC/100)]
eenheid=!randitem cm,mm,dm
hoogte=$[2*$AB]
breedte=$[$C+2*$BC]
oppdriehoek=$[(0.5*$BC*$AB)]
totaal=$[$hoogte*$breedte - 4*$oppdriehoek]
description=!record 79 of lang/remarks.$taal
#@hoogte,breedte,oppervlak driehoek,totale oppervlak

ss=!record 80 of lang/remarks.$taal
#@<span style="color:blue"><u>Hier</u></span> zie je een regelmatige veelhoek.<br /><small><em>let op: de figuur is niet op schaal getekend...</em></small><ul><li>Zijde A $A $eenheid is</li><li>Zijde C is $C $eenheid</li><li>En B is $B $eenheid</li></ul>\Wat is dan de hoogte en breedte van deze figuur ?<br />En bereken het oppervlak van de <em>hulp driehoek</em><br />\en het <em>totale oppervlak</em> van deze figuur<br /><small><em>vergeet niet de correcte eenheden te vermelden in je antwoord</em></small>
helptext=<img src=\'$module_dir/gifs/poly1.gif\' alt=\'noalt\' />
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

answer$n=$hoogte $eenheid,$breedte $eenheid,$oppdriehoek $eenheid^2,$totaal $eenheid^2

# alle twee antwoorden moeten een eenheid hebben
var1=1,1,1,1
var2=$empty
ex1=&nbsp;?
ex2=&nbsp;?
ex3=&nbsp;?
ex4=&nbsp;?
texanswer$n=\left[ \begin{array}{l} \textrm{$(description[1])} = 2\times \sqrt{$AC^{2} - $BC^{2}} = 2 \times $AB = $hoogte \textrm{$eenheid} \\ \textrm{$(description[2])} = 2\times $BC + $C = $breedte \textrm{$eenheid} \\ \textrm{$(description[3])} = \frac{1}{2}\times $BC \times $AB = $oppdriehoek  \textrm{$eenheid}^{2} \\ \textrm{$(description[4])} = \textrm{$(description[1])} \times \textrm{$(description[2])} - 4\times\left(\textrm{$(description[3])}\right) = $totaal \textrm{$eenheid}^{2} \end{array} \right.

textanswer$n=<ul><li>$(description[1])=$breedte $eenheid</li><li>$(description[2])=$hoogte $eenheid</li><li>$(description[3])=$oppdriehoek $eenheid<sup><small>2</small></sup></li><li>$(description[4])=$totaal  $eenheid<sup><small>2</small></sup></li></ul>


