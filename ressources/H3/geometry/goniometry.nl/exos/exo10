n=$counter
make_tr=1
questiontype=7
javascript=js/hotspot.phtml
inputs=yes
cols=15
rows=1
mathview=0
xsize=400
ysize=400
math=0
!if $level=0
    R=$counter
!else
    R=$level
!endif
checkfile=exos/checkfile1.proc
!if $R=1
    A=!randint 1,23
    graden=$[$A*15]
    answer$n=$[pi*$graden/180]
    ss=!record 52 of lang/remarks.$taal
    rr=!record 53 of lang/remarks.$taal
    help=!record 54 of lang/remarks.$taal
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
    textanswer$n=$rr
 !exit
!endif

!if $R=2
    A=!randint 24,60
    graden=$[$A*15]
    gr=$[($A%24)*15]
    answer$n=$[pi*$gr/180]
    ss=!record 52 of lang/remarks.$taal
    rr=!record 53 of lang/remarks.$taal
    helptext=!record 54 of lang/remarks.$taal
    textanswer$n=$graden &deg; == $gr &deg;<br />$rr
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
 !exit
!endif

!if $R>2
    A=!randint 1,23
    graden=$[$A*15]
    answer$n=$[pi*$graden/180]
    omtrek=$[(round(100*pi*$graden/180))/100]
    totaleomtrek=6.28
    
    ss=!record 55 of lang/remarks.$taal
    rr=!record 56 of lang/remarks.$taal
    helptext=!record 57 of lang/remarks.$taal
    textanswer$n=$rr
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
 !exit
!endif

!exit
