#@ $m_Delta ABC heeft een rechte hoek [<em>dus 90<sup>o</sup></em>] in A.<br />Vul het onderstaande schema in <br />en bereken de lengte BC [<em>de hypothenusa</em>]
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

answer$n=AB:BA:$AB:$[$AB^2],AC:CA:$AC:$[$AC^2],BC:CB:$BC:$[$BC^2]

