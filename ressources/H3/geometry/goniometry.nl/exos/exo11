# Pythagoras I
n=$counter
math=0
mathview=0
questiontype=7
javascript=js/exo11.js
inputs=yes
!if $rounding<0
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif

checkfile=exos/checkfile2.proc
!if $level=0 
    R=$counter
!else
    R=$level
!endif

!if $R=1
    g1=5,3,20,12,15,6,9,18,21,10,15,20,25,30,24,27
    g2=12,4,48,16,20,8,12,24,28,24,36,48,60,72,32,36
    k=!randint 1,16
    #max=!itemcnt $g1
    l1=!item $k of $g1
    l2=!item $k of $g2
!else
    !if $R=2
	l1=!randint 2,30
	l2=!randint 2,30
    !else
	l1=!randint 21,60
	l2=!randint 21,60
    !endif
!endif

!if $l1>$l2
    AC=$l1
    AB=$l2
!else
    !if $l1<$l2
	AC=$l2
	AB=$l1
    !else
	AC=$[$l1+4]
	AB=$l1
    !endif
!endif

test=$[sqrt(($AB)^2 + ($AC)^2)]
!if . isin $test
    BC=sqrt($[($AB)^2 + ($AC)^2])
    !if $rounding!=0
	last=$[(round($rounding*(sqrt($AB^2 + $AC^2))))/$rounding]
	last = \simeq $last
    !endif
!else
    BC=$test
    last = \,=\,$BC
!endif

texanswer$n=\textrm{BC}\, = \, \sqrt{AB^{2} + AC^{2}} = \sqrt{$AB^{2} + $AC^{2}} = \sqrt{$[$AB^2 + $AC^2]} $last

helptext=<img src=\'$module_dir/gifs/exo11.jpg\' alt=\'noalt\' />
