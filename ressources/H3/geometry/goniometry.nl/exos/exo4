n=$counter
math=0
inputs=1.1
mathview=0
questiontype=0
embed=1
cols=15
rows=1
checkfile=$checkdir/number.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif

#een willekeurig punt $A 
X1=!randitem -4,-3,-2,-1,0,1,2
Y1=!randitem 4,5,6,7,8,9
dx=!randitem 4,5,8
dy=!randitem -5,-4,-2,1,2
    
#nog een willekeurig net punt
X2=$[$X1+($dx)]
Y2=$[$Y1+($dy)]
    
#de lijn door X1Y1 X2Y2 y=m1x+q
m1=$[$dy/$dx]
q1=$[$Y1-($m1)*$X1]
    
#de lijn loodrecht hierop is dus in X1Y1
m2=$[-1*$dx/$dy]
q2=$[$Y1-($m2)*$X1]
    
#eem mooie Y3
Y3=!randitem -8,-7,-6,-5,-4
    
#bijpassende X3-waarde
X3=$[($Y3-($q2))/($m2)]

#lengte AC is dus (X1:Y1) -- (X2:Y2)
#lengte AB is dus (X1:Y1) -- (X3:Y3)
#lengte BC is dus (X2:Y3) -- (X3:Y3)

AC=$[sqrt(($X1-$X2)^2 + ($Y1-$Y2)^2)]
AB=$[sqrt(($X1-$X3)^2 + ($Y1-$Y3)^2)]
BC=$[sqrt(($X2-$X3)^2 + ($Y2-$Y3)^2)]

#PI=3.141592654
hoekC=$[ (round(100*(acos($AC/$BC))*180/pi))/100]
hoekB=$[90-$hoekC]
    
########PLAATJE############
keuze=!randitem 1,1
A=!item $keuze of  A,D,K,P
B=!item $keuze of  B,E,L,Q
C=!item $keuze of  C,F,M,R

keuze=!randitem 1,2
!if $keuze=1
    lengte=$AB
    punt=$B
!else
    lengte=$AC
    punt=$C
!endif

telwoorden=!record 59 of $remarkdir/commonremarks.$taal
rounding=100
!readproc $remarkdir/rounding.$taal
twee=!item 2 of $telwoorden

!if $R=1
    formula$n=d\left($A$punt\right)
    answer$n=$[(round($rounding*($lengte)))/$rounding]
    texanswer$n=d\left($A$punt\right) \simeq $(answer$n)
    ss=!record 25 of lang/remarks.$taal
    rr=!record 26 of lang/remarks.$taal
 !goto KLAAR
!endif

!if $R=2
    trigo=!record 27 of lang/remarks.$taal
    k=!randitem 1,2,3
    sin=!item $k of $trigo
    lsin=!item $k of sin,cos,tan
    hoek=!randitem $B,$C
    !if ($k=1 and $hoek=$B) or ($k=2 and $hoek=$C)
	ans=$AC/$BC
    !else
	!if ($k=2 and $hoek=$B) or ($k=1 and $hoek=$C)
	    ans=$AB/$BC
	!else
	    !if $k=3 and $hoek=$B
		ans=$AC/$AB
	    !else
    		ans=$AB/$AC
	    !endif
	!endif
    !endif
    answer$n=$[(round($ans*$rounding))/$rounding]
    formula$n=\$lsin\left(\angle $hoek\right)
    texanswer$n=\$lsin\left(\angle $hoek\right) \simeq $(answer$n)
    ss=!record 28 of lang/remarks.$taal
    rr=!record 29 of lang/remarks.$taal
 !goto KLAAR
!endif
 
!if $R>2
    answer$n=$hoekB
    hoek=!randitem $B,$C
    !if $hoek=$B
	answer$n=$hoekB
    !else
	answer$n=$hoekC
    !endif
    formula$n=\angle $hoek
    texanswer$n=\angle $hoek = $(answer$n) ^{o}
    ss=!record 30 of lang/remarks.$taal
    rr=!record 31 of lang/remarks.$taal
    ex=&deg;
!endif

:KLAAR
    
question$n=$ss
tekstanswer$n=$rr
applet=1
draw=0
plot=0
make_tr=0
	
xrange= -20,20
yrange= -20,20
	
object$n=!exec canvasdraw\
size 300,300\
xrange -20,20\
yrange -20,20\
fontfamily 12px Ariel\
precision 1\
axis\
axisnumbering\
opacity 100,100\
grid 4,4,grey,2,2,7,blue\
linewidth 2\
opacity 200,30\
ftriangle $X1,$Y1,$X2,$Y2,$X3,$Y3,red\
linewidth 3\
points green,$X1,$Y1,$X2,$Y2,$X3,$Y3\
fontfamily 16px Ariel\
string black,$X1,$[$Y1+1],$A\
string black,$X2,$[$Y2+1],$C\
string black,$X3,$[$Y3+1],$B\
mouse blue,22\
zoom black
