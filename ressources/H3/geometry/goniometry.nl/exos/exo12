# Pythagoras II

# gelijk aan exo11 maar dan ook andere onbekende zijden
n=$counter
math=0
mathview=0
questiontype=7
javascript=js/exo11.js
inputs=yes
applet=1
plot=0
draw=0
make_tr=0
xsize=300
ysize=300
image_settings$n=$xsize,$ysize

!if $rounding<0
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif

checkfile=exos/checkfile2.proc
g1=5,3,20,12,15,6,9,18,21,10,15,20,25,30,24,27
g2=12,4,48,16,20,8,12,24,28,24,36,48,60,72,32,36
k=!randint 1,16
#max=!itemcnt $g1
l1=!item $k of $g1
l2=!item $k of $g2
!if $l1>$l2    
    AC=$l1
    AB=$l2
!else
    !if $l1<$l2
	AC=$l2
	AB=$l1
    !else
	AC=$[$l1+4]
	AB=$l1
    !endif
!endif

BC=$[sqrt(($AB)^2 + ($AC)^2)]

keuze=!randitem 1,2,3,1,2
!if $keuze=1
object$n=!exec canvasdraw\
size $xsize,$ysize\
xrange 0,1\
yrange 0,1\
copy 0,1,-1,-1,-1,-1,$module_dir/gifs/driehoekABC.gif\
fontfamily bold 18px Ariel\
string blue,0.5,0.85,$BC\
string blue,0.5,0.5,?? \
string blue,0.8,0.75,$AB

    texanswer$n=\begin{array}{l} AB^{2} + AC^{2} = BC^{2} \rightarrow AC^{2} = BC^{2} - AB^{2} \\ AC = \sqrt{BC^{2} - AB^{2}} \\ AC = \sqrt{$BC^{2}  - $AB^{2}} = \sqrt{$[($BC)^2  - ($AB)^2]} \\ AC = $AC  \end{array}
     
!else
    !if $keuze=2
object$n=!exec canvasdraw\
size $xsize,$ysize\
xrange 0,1\
yrange 0,1\
copy 0,1,-1,-1,-1,-1,$module_dir/gifs/driehoekABC.gif\
fontfamily bold 18px Ariel\
string blue,0.5,0.85,$BC\
string blue,0.5,0.5,$AC \
string blue,0.8,0.75,?? 
	
	texanswer$n=\begin{array}{l} AB^{2} + AC^{2} = BC^{2} \rightarrow AB^{2} = BC^{2} - AC^{2} \\ AB = \sqrt{BC^{2} - AC^{2}} \\ AB = \sqrt{$BC^{2}  - $AC^{2}} = \sqrt{$[($BC)^2  - ($AC)^2]} \\ AB = $AB \end{array}
    !else
	
object$n=!exec canvasdraw\
size $xsize,$ysize\
xrange 0,1\
yrange 0,1\
copy 0,1,-1,-1,-1,-1,$module_dir/gifs/driehoekABC.gif\
fontfamily bold 18px Ariel\
string blue,0.5,0.85,??\
string blue,0.5,0.5,$AC\
string blue,0.8,0.75,$AB
	
	texanswer$n=\begin{array}{l} AB^{2} + AC^{2} = BC^{2} \rightarrow  BC = \sqrt{AB^{2} + AC^{2}} \\ BC = \sqrt{$AB^{2}  + $AC^{2}} = \sqrt{$[($AB)^2  + ($AC)^2]} \\ BC = $BC \end{array}
    
    !endif
!endif


