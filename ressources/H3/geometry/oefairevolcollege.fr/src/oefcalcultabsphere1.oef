\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Tableau de sphère et boule}

\text{r=1,randint(2..5),randint(6..12),randint(13..19),randint(20..30)}
\integer{u=randint(1..4)}

\integer{repa=4*\r[1]^2*pi}
\integer{repv=4*\r[1]^3*pi/3}

\for{i=2 to 5}
   {\integer{a=4*\r[\i]^2*pi}
    \integer{v=4*\r[\i]^3*pi/3}
    \text{repa=\repa,\a}
    \text{repv=\repv,\v}}

\text{unit=mm,cm,dm,m}

\integer{large=6}

\text{repu= \unit[\u]\(^2),\unit[\u]\(^3)}

\statement{
Nous avons cinq sphères avec des rayons différents.
Compléter le tableau suivant :
<table class="wimscenter wimsborder">
<tr><th>Rayon en \unit[\u]</th>
\for{j= 1 to 5}{<td>\r[\j]</td>}</tr>
<tr><th>Aire de la sphère <br> en \unit[\u]\(^2)</th>
<td>\embed{r1,\large}</td>
<td>\embed{r2,\large}</td>
<td>\embed{r3,\large}</td>
<td>\embed{r4,\large}</td>
<td>\embed{r5,\large}</td>
</tr>
<tr><th>Volume de la boule <br> en \unit[\u]\(^3)</th>
<td>\embed{r6,\large}</td>
<td>\embed{r7,\large}</td>
<td>\embed{r8,\large}</td>
<td>\embed{r9,\large}</td>
<td>\embed{r10,\large}</td>
</tr>
</table>
<div class="wims_instruction">Donner des valeurs approchées à l'unité près.</div>
<ul>
<li>
L'aire de la sphère est-elle proportionnelle à son rayon ? : \embed{r11}
</li><li>
Le volume de la boule est-il proportionnel à son rayon ? : \embed{r12}
</li></ul>
}
\answer{}{\repa[1]}{type=numeric}
\answer{}{\repa[2]}{type=numeric}
\answer{}{\repa[3]}{type=numeric}
\answer{}{\repa[4]}{type=numeric}
\answer{}{\repa[5]}{type=numeric}
\answer{}{\repv[1]}{type=numeric}
\answer{}{\repv[2]}{type=numeric}
\answer{}{\repv[3]}{type=numeric}
\answer{}{\repv[4]}{type=numeric}
\answer{}{\repv[5]}{type=numeric}
\answer{}{2;oui,non,peut-être}{type=menu}
\answer{}{2;oui,non,peut-être}{type=menu}
