\title{Choisir la bonne formule littérale}
\text{nx=<i> x </i>}
\text{form=\(2L + 2l\),
\(4c\),
\(c^2\),
\(c^3\),
\(\ \pi r^2\),
\(\frac{1}{3}\pi r^2 h\) ou \(\frac{1}{3} A h\),
\(L l\),
