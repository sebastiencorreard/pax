\real{h=randint(3..99)/5}
\if{\b=1}{\real{r=\h}}{\real{r=\h/2}}
\text{unit=mm,cm,dm,m}

\text{eg=égale,égal}
\text{ch= sphère, boule}
\text{voc=aire,volume}
\text{mes=rayon,diamètre}
