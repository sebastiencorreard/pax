!set title=Choisir la bonne formule 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=70x200x270
val7=<i> x </i>
val8=2 \(\times) longueur + 2 \(\times) largeur,	4 \(\times) côté,	côté \(\times)  côté,	côté \(\times)  côté \(\times)  côté,	\(\pi \times) rayon \(\times) rayon,	\(\pi \times) rayon \(\times) rayon \(\times) hauteur \(\div) 3 <br>ou Aire de base \(\times) hauteur \(\div) 3,	longueur \(\times) largeur,	base \(\times) hauteur \(\div) 2,	Aire de base \(\times) hauteur,	Aire de base \(\times) hauteur \(\div) 3,	longueur \(\times) largeur \(\times) hauteur,	\(\pi \times) diamètre,	\(\pi \times) rayon \(\times) rayon \(\times) hauteur <br>ou Aire de base \(\times) hauteur	
val9=Périmètre du rectangle,	Périmètre du carré,	Aire du carré,	Volume du cube,	Aire du disque,	Volume du cône,	Aire du rectangle,	Aire du triangle,	Volume du prisme,	Volume de la pyramide,	Volume du pavé,	Périmètre du cercle,	Volume du cylindre
tmp0=!shuffle 13

val10=$(tmp0)
val11=$(val9[$(val10[1])]),$(val9[$(val10[2])]),$(val9[$(val10[3])]),$(val9[$(val10[4])])
val12=$(val8[$(val10[1])]),$(val8[$(val10[2])]),$(val8[$(val10[3])]),$(val8[$(val10[4])])
replytype1=correspond
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

