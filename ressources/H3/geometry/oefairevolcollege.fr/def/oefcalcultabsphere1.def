 !exit
!endif

tmp0=!randint 2, 5

tmp1=!randint 6, 12

tmp2=!randint 13, 19

tmp3=!randint 20, 30

val6=1,$(tmp0),$(tmp1),$(tmp2),$(tmp3)
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]
val8=$[rint(4*$(val6[1])^2*pi)]
val9=$[rint(4*$(val6[1])^3*pi/3)]
!for val10 =2 to 5 
val11=$[rint(4*$(val6[$val10])^2*pi)]
val12=$[rint(4*$(val6[$val10])^3*pi/3)]
val8=$val8,$val11
val9=$val9,$val12
!next
val13=mm,cm,dm,m
val14=$[rint(6)]
val15=$(val13[$val7])\(^2),$(val13[$val7])\(^3)
