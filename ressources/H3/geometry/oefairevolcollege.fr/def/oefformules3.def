!set title=Choisir la bonne formule littérale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=70x200x270
val7=<i> x </i>
val8=\(2L + 2l\),	\(4c\),	\(c^2\),	\(c^3\),	\(\ \pi r^2\),	\(\frac{1}{3}\pi r^2 h\) ou \(\frac{1}{3} A h\),	\(L l\),	\(\frac{1}{2} b h\),	\(A h\),	\(\frac{1}{3} A h\),	\(L l h\),	\(\ \pi D\),	\(\ \pi r^2 h\) ou \(A h\),	\(\frac{4}{3}\pi r^3\),	\(4 \pi r^2\)	
val9=Périmètre du rectangle,	Périmètre du carré,	Aire du carré,	Volume du cube,	Aire du disque,	Volume du cône,	Aire du rectangle,	Aire du triangle,	Volume du prisme,	Volume de la pyramide,	Volume du pavé,	Périmètre du cercle,	Volume du cylindre,	Volume de la boule,	Aire de la sphère
tmp0=!shuffle 15

val10=$(tmp0)
val11=$(val9[$(val10[1])]),$(val9[$(val10[2])]),$(val9[$(val10[3])]),$(val9[$(val10[4])])
val12=$(val8[$(val10[1])]),$(val8[$(val10[2])]),$(val8[$(val10[3])]),$(val8[$(val10[4])])
replytype1=correspond
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

