val17=$[rint(4*pi*$val10*$val10)]
!endif
!if $val7=2 
val17=$[rint(4*pi*$val10*$val10*$val10/3)]
!endif
val18=$[rint(6)]
!readproc oef/draw.phtml 320,320 \
fcircle 160,160,sqrt($val10)*$val6*18,grey	 
tmp0=$ins_url
val19=$(tmp0)
val20=$(val11[$val6])\(^2),$(val11[$val6])\(^3)
replytype1=numeric
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

