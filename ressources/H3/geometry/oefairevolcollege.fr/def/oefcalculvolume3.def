 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!randint 3, 99

val9=$[$(tmp0)/5]
!if $val8=1 
val10=$[$val9]
!else
val10=$[$val9/2]
!endif
val11=mm,cm,dm,m
val12=égale,égal
val13=sphère, boule
val14=aire,volume
val15=rayon,diamètre
