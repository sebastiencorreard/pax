!set title=Teorema di Talete e Circonferenze +
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, XIAO 
email=xiao@unice.fr
language=it
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 6,3,4,8	12,6,8,16	18,9,12,24	24,12,16,32
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
replytype1=default
replyname1=Lunghezza di \(EG)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p class="wimscenter">	 
!read oef/draw.phtml 250,250 \
	xrange -25,25	yrange -25,25	circle 0,0,220,red	segment -22,0,22,0,blue	circle -11,0,110,red	lines blue,-22,0,14,17,22,0	segment 14,17,22,0,black	segment -4.5,8.8,0,0,black	text black,-24,1,medium,E 	text black,15,19,medium,F	text black,23,1,medium,G	text black,-4,12,medium,H	text black,1,3,medium,O 	 
$()	</p>	Sappiamo che 
!insmath HO \parallel FG
$() ; 
!insmath FG = $val8
$() 
!insmath cm
$() ; 
!insmath HO = $val9
$() 
!insmath cm
$() ; 
!insmath EO = $val10
$() 
!insmath cm
$(). Calcolare la lunghezza del segmento	
!insmath EG
$() (in 
!insmath cm
$()).
$()
!exit

:hint
$()Il simbolo $m_parallel significa parallele.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10
embedcnt=0
