tmp0=!random 60, 120

val13=$[$(tmp0)/180*pi]
val14=$[100+($val11*cos($val12))]
val15=$[100+($val11*sin($val12))]
val16=$[100-($val11*cos($val12))]
val17=$[100-($val11*sin($val12))]
