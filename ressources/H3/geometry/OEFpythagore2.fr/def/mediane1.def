val30=$val19 + ($val23)/($val26)*$val28
val31=$val18 + ($val24)/($val27)*$val28
val32=$val19 + ($val25)/($val27)*$val28
val33=$[$val31 + ($val22)/($val26)*$val28]
val34=$[$val32 + ($val23)/($val26)*$val28]
!if cos($val12)>0 

