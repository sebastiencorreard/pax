val17=$(tmp0)
val18=En utilisant les étiquettes, reconstituez l'égalité	  que vous pouvez déduire du théorème de Pythagore dans le triangle \($val17\).
tmp=!nonempty items Le triangle \($val7$val8$val9) est rectangle en \($val8),L'angle \(\widehat{$val7$val8$val9}) est droit

tmp0=!randitem $tmp
val19=$(tmp0)
val20=\($val7$val8),\($val7$val9),\($val8$val9),\($val7$val8^2),\($val7$val9^2),\($val8$val9^2),+
val21=\($val7$val10),\($val7$val10^2),\($val8$val10),\($val8$val10^2)
!if $val16=1 
