#:Kerk [ Pythagoras ]
n=$counter
R=$level
!if $level=0
    R=$counter
!endif

!if $rounding<0
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif
mathview=0
make_tr=0
questiontype=0
cols=20
rows=1
m_rightarrow=&nbsp;=
embed=1
applet=1
inputs=1
helptext=$empty
checkfile=$checkdir/number.proc
!if $R=1
    totaal=!randitem 250,260,270
    totaal=250
    f=!randitem 0.6,0.7
    g=$[2*$f-0.3]
    hoogte=$[$f*$totaal]
    diepte=0
    breedte=$[$totaal-$hoogte]
    x=!randitem 4,6,8,10
    b=$[$x/2]
    p=!randitem 0,1,2,3
    z=$[$x+$p]
    q=!randitem 0,1,2
    a=$[$g*$g*$z*$z+2*$b*$b]
    c=$[round(sqrt($a))+$q]
    d=$[$c^2-2*$b^2]
    answer$n=sqrt($d)
    test=$[$(answer$n)]
    !if $rounding=0
        ans=$empty
    !else
        ans=\approx $[round($rounding*$test)/$rounding]
    !endif
    !if . isin $test
        tex=\sqrt{$d} $ans
    !else
        tex=\sqrt{$d} = $test
    !endif
    ss=!record 8 of lang/remarks.$taal
    #@De hiernaast gegeven kerktoren bestaat uit een balk en een piramide.<br />De maten zijn:<br /><ul><li>AB=BC=$x <li>AE=$z<li>TE=TF=TG=TH=$c </ul><br />Bereken de afstand van de top T tot het vlak EFGH.
    texanswer$n=\left[ \begin{array}{lll} ES^{2}=$b^{2}+$b^{2}=$[2*$b^2]  \\  $[2*$b^2] + TS^{2}=$c^{2} \\ $[2*$b^2]+h^{2}=$[$c^2]  \\  h^{2}= $d \\  h=\sqrt($d)  \\  TS=$tex \end{array} \right.
    
    question$n=$ss
    
    description=d(TS)
    construction=<Midpoint name="S" n="2000" showname="true" bold="true" large="true"  first="E" second="G" shape="circle"></Midpoint><Segment type="bold" name="TS" alias="TS" color="5" n="1000" from="T" to="S"></Segment>
    
    !readproc exos/kerkxml.proc
 !exit
 
!endif
!if $R=2
    totaal=!randitem 250,260,270
    totaal=250
    f=!randitem 0.6,0.7,0.8
    g=$[2*$f-0.3]
    hoogte=$[$f*$totaal]
    diepte=0
    breedte=$[$totaal-$hoogte]
    x=!randitem 4,6,8,10
    b=$[$x/2]
    p=!randitem 0,1,2,3
    z=$[$x+$p]
    q=!randitem 0,1,2
    a=$[$g*$g*$z*$z+2*$b*$b]
    c=$[round(sqrt($a))+$q]
    d=$[$c^2-2*$b^2]
    answer$n=$z+sqrt($d)
    test=$[$(answer$n)]
    !if $rounding=0
        ans=$empty
    !else
        ans=\approx $[round($rounding*$test)/$rounding]
    !endif
    !if . isin $test
        tex=$z+\sqrt{$d} $ans
    !else
        tex=$z+\sqrt{$d} = $test
    !endif
    ss=!record 9 of lang/remarks.$taal
    #@De hiernaast gegeven kerktoren bestaat uit een balk en een piramide.<br />De maten zijn:<br /><ul><li>AB=BC=$x <li>AE=$z<li>TE=TF=TG=TH=$c </ul><br />Bereken de hoogte TS van de kerk.
    texanswer$n=\left[ \begin{array}{lll} TS=$z+h  \\  $b^{2}+$b^{2}+h^{2}=$c^{2} \\ $[2*$b^2]+h^{2}=$[$c^2]  \\  h^{2}= $d \\  h=\sqrt($d)  \\  TS=$tex \end{array} \right.
    
    question$n=$ss
    
    description=d(TS)
    
    construction=<Midpoint name="S" n="2000" showname="true" bold="true" large="true"  first="A" second="C" shape="circle"></Midpoint><Segment type="bold" name="TS" alias="TS" color="5" n="1000" from="T" to="S"></Segment>
    
    !readproc exos/kerkxml.proc
 !exit
!endif

!if $R>2
    A=!randitem A,B,C,D
    AT=!nospace $A T
    AS=!nospace $A S
    totaal=!randitem 250,260,270
    totaal=250
    f=!randitem 0.6,0.7
    g=$[2*$f-0.3]
    hoogte=$[$f*$totaal]
    diepte=0
    breedte=$[$totaal-$hoogte]
    x=!randitem 4,6,8,10
    b=$[$x/2]
    p=!randitem 0,1,2,3
    z=$[$x+$p]
    q=!randitem 0,1,2
    a=$[$g*$g*$z*$z+2*$b*$b]
    c=$[round(sqrt($a))+$q]
    d=$[$c^2-2*$b^2]
    e=$z+sqrt($d)
    answer$n=sqrt(2*$b*$b+($e)*($e))
    test1=$[$e]
    test=$[$(answer$n)]
    ans1=$[round($rounding*$test1)/$rounding]
    ans=\approx $[round($rounding*$test)/$rounding]
    ss=!record 10 of lang/remarks.$taal
    #@De hiernaast gegeven kerktoren bestaat uit een balk en een piramide.<br />De maten zijn:<br /><ul><li>AB=BC=$x <li>AE=$z<li>TE=TF=TG=TH=$c </ul><br />Bereken de afstand van de top T tot $A.
    texanswer$n=\left[ \begin{array}{lll} TS=$z+h  \\  $b^{2}+$b^{2}+h^{2}=$c^{2} \\ $[2*$b^2]+h^{2}=$[$c^2]  \\  h^{2}= $d \\  h=\sqrt{$d}  \\  TS = $z+\sqrt{$d} \approx  $ans1  \\ TS^{2}+$AS^{2}=$AT^{2}  \\  $ans1^{2}+$[2*$b^2] = $AT^{2}  \\  $AT $ans \end{array}
    question$n=$ss
    description=d($AT)
    construction=<Midpoint name="S" n="2000" showname="true" bold="true" large="true"  first="A" second="C" shape="circle"></Midpoint>\
    <Segment type="bold" name="TS" alias="TS" color="1" n="1000" from="T" to="S"></Segment>\
    <Segment type="bold" name="$AT" alias="$AT" color="5" n="1000" from="$A" to="T"></Segment>
    !readproc exos/kerkxml.proc
 !exit
!endif

