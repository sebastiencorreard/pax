#:Kubus-Balk [ Oppervlak bepalen ] 
n=$counter

R=$level
!if $level=0
    R=$counter
!endif

!if $rounding<1
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif
make_tr=0
mathview=0
questiontype=0
cols=16
rows=1
m_rightarrow=&nbsp;=
embed=1
applet=1
inputs=1
hoogte=35
breedte=0
diepte=0
# kubus
sometext=!record 13 of lang/remarks.$taal
helptext=$empty
checkfile=$checkdir/number.proc

!if $R=1
    x=!randint 4,14
    ss=!record 22 of lang/remarks.$taal
    textanswer$n=$empty
    question$n=$ss
    Oppervlak=!record 24 of lang/remarks.$taal
    description=$Oppervlak: 
    answer$n=$[6*$x^2]
    texanswer$n=6 \cdot $x^{2}=$(answer$n)
    construction=$empty
    !readproc exos/balkxml.proc
!exit
!endif


!if $R=2
    x=!randint 8,15
    y=!randint 2,$[$x-1]
    z=!randitem 4,5,6,7,8
    AB=$y, BC=$z en BF=$x
    # arbitraire onzin...verhoudingen kloppen NIET ECHT !!!!!
    hoogte=$[35+$x]
    breedte=$[$y*4.5]
    diepte=$[$y*4.5]
    ss=!record 23 of lang/remarks.$taal
    #@Van een balk ABCD.EFGH is<br />AB=$y, BC=$z en BF=$x .<br />Bereken de oppervlakte van de balk.
    textanswer$n=$empty
    question$n=$ss
    Oppervlak=!record 24 of lang/remarks.$taal
    description=$Oppervlak: 
    answer$n=$[2*$x*$z+2*$x*$y+2*$y*$z]
    texanswer$n=2\cdot $x\cdot $z+2\cdot $x\cdot $y+2\cdot $y\cdot $z=$(answer$n)
    !readproc exos/balkxml.proc
 !exit
!endif

!if $R>2
    kans=!randint 0,1
    !if $kans=0
	keuze=!randitem 1,2,3
        x=!randint 8,15
	y=!randint 4,$[$x-1]
        z=!randitem 4,5,6,7,8
	AB=$y, BC=$z en BF=$x
        # arbitraire onzin...verhoudingen kloppen NIET ECHT !!!!!
	hoogte=$[35+$x]
        breedte=$[$y*4.5]
	diepte=$[$y*4.5]
        !if $keuze=1
	    d=$[$x^2+$y^2]
	    d_tex=\sqrt{$y^{2}+$x^{2}}
	    c=$z
	    setje=E,B,C,H A,F,G,D
	!else
    	    !if $keuze=2
	        d=$[$x^2+$z^2]
		d_tex=\sqrt{$z^{2}+$x^{2}}
	        c=$y
		setje=B,G,H,A C,F,E,D
    	    !else
		d=$[$y^2+$z^2]
		d_tex=\sqrt{$y^{2}+$z^{2}}
		c=$x
		setje=A,C,G,E B,D,H,F
	    !endif
	!endif
	keus=!randitem 1,2
	set=!word $keus of $setje
	A=!item 1 of $set
	F=!item 2 of $set
	G=!item 3 of $set
	D=!item 4 of $set
	AF=!nospace $A $F
	FG=!nospace $F $G
	GD=!nospace $G $D
	AD=!nospace $A $D
	AFGD=!nospace $A $F $G $D
        textanswer$n=$empty
	ss=!record 25 of lang/remarks.$taal
        #@Van een balk ABCD.EFGH is<br />AB=$y, BC=$z en BF=$x .<br />Bereken de oppervlakte van het diagonaalvlak $AFGD.
	question$n=$ss
	Oppervlak=!record 24 of lang/remarks.$taal
	description=$Oppervlak: 
	answer$n=$[$c*sqrt($d)]
	ans=\approx $[round($rounding*$(answer$n))/$rounding]
    
	texanswer$n=\left[ \begin{array}{l} $AF =$d_tex=\sqrt{$d} \\ \textrm{$Oppervlak} = $c \cdot \sqrt{$d} $ans \end{array} \right
    
	construction=<Segment type="thick" name="$AF" n="2002" alias="$AB" color="1" from="$A" to="$F"></Segment><Segment type="thick" name="$FG" n="2003" alias="$FG" color="1" from="$F" to="$G"></Segment><Segment type="thick" name="$GD" n="2004" alias="$GD" color="1" from="$G" to="$D"></Segment><Segment type="thick" name="$AD" n="2005" alias="$AD" color="1" from="$A" to="$D"></Segment><Polygon name="$AFGD" n="2006" color="1" background="true" filled="true" solid="true" point1="$A" point2="$F" point3="$G" point4="$D"/>
    
	!readproc exos/balkxml.proc
	!exit
    !else
	keuze=!randitem 1,2
	x=!randint 8,15
	y=!randint 2,$[$x-1]
	z=!randitem 4,5,6,7,8
	AB=$y, BC=$z en BF=$x
	# arbitraire onzin...verhoudingen kloppen NIET ECHT !!!!!
	hoogte=$[35+$x]
        breedte=$[$y*4.5]
	diepte=$[$y*4.5]
        !if $keuze=1
    	    setje=E,B,C,H,A,D  A,F,G,D,B,C
	    d=$[$x^2+$y^2]
	    d_tex=$x^{2}+$y^{2}
	    c=$z
	    a=$x
	    b=$y
	!else
	    setje=A,H,G,B,E,F C,F,E,D,G,H
	    d=$[$x^2+$z^2]
	    d_tex=$x^{2}+$z^{2}
	    c=$y
	    a=$x
	    b=$z
	!endif
	keus=!randitem 1,2
	set=!word $keus of $setje
	A=!item 1 of $set
	F=!item 2 of $set
	G=!item 3 of $set
	D=!item 4 of $set
	K=!item 5 of $set
	M=!item 6 of $set
	AF=!nospace $A $F
	FG=!nospace $F $G
	GD=!nospace $G $D
	AD=!nospace $A $D
	AK=!nospace $A $K
	KM=!nospace $K $M
	KF=!nospace $K $F
	MG=!nospace $M $G
	MD=!nospace $M $D
	AFGD=!nospace $A $F $G $D
	AFK=!nospace $A $F $K
	GDM=!nospace $G $D $M
	KMDA=!nospace $K $M $D $A
	KMGF=!nospace $K $M $G $F
	KFGMAD=!nospace $K $F $G $M . $A $D
	
	ss=!record 26 of lang/remarks.$taal
	#@Van een balk ABCD.EFGH is<br />AB=$y, BC=$z en BF=$x .<br />Bereken de oppervlakte van de balk.
	textanswer$n=$empty
	question$n=$ss
	Oppervlak=!record 24 of lang/remarks.$taal
	description=$Oppervlak
	answer$n=$[$x*$z+$x*$y+$y*$z+$c*sqrt($d)]
	ans=\approx $[round($rounding*$(answer$n))/$rounding]
    
	texanswer$n=2\cdot \frac{1}{2} \cdot $a\cdot $b  + $a\cdot $c +$b\cdot $c + $c\cdot \sqrt{$d_tex} $(ans) 
    
	construction=<Segment type="bold" name="$AF" n="2002" alias="$AB" color="1" from="$A" to="$F"></Segment><Segment type="thick" name="$FG" n="2003" alias="$FG" color="1" from="$F" to="$G"></Segment><Segment type="bold" name="$GD" n="2004" alias="$GD" color="1" from="$G" to="$D"></Segment><Segment type="thick" name="$AD" n="2005" alias="$AD" color="1" from="$A" to="$D"></Segment><Segment type="thick" name="$AK" n="2006" alias="$AK" color="1" from="$A" to="$K"></Segment><Segment type="thick" name="$KM" n="2007" alias="$KM" color="1" from="$K" to="$M"></Segment><Segment type="thick" name="$KF" n="2008" alias="$KF" color="1" from="$K" to="$F"></Segment><Segment type="thick" name="$MG" n="2009" alias="$MG" color="1" from="$M" to="$G"></Segment><Segment type="thick" name="$MD" n="2010" alias="$MD" color="1" from="$M" to="$D"></Segment><Polygon name="$AFGD" n="2011" color="1" background="true" filled="true" solid="true" point1="$A" point2="$F" point3="$G" point4="$D"/><Polygon name="$KMDA" n="2012" color="1" background="true" filled="true" solid="true" point1="$K" point2="$M" point3="$D" point4="$A"/><Polygon name="$KMGF" n="2013" color="1" background="true" filled="true" solid="true" point1="$K" point2="$M" point3="$G" point4="$F"/><Polygon name="$AFK" n="2014" color="1" background="true" filled="true" solid="true" point1="$A" point2="$F" point3="$K"/><Polygon name="$GDM" n="2015" color="1" background="true" filled="true" solid="true" point1="$G" point2="$D" point3="$M"/>

	!readproc exos/balkxml.proc
	!exit
    !endif
!endif

