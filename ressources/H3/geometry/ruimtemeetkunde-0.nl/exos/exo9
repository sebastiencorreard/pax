#:[html5] Piramide [ Oppervlak ]
n=$counter

R=$level
!if $level=0
    R=$counter
!endif
!if $rounding<1
    rounding=100
    !readproc $remarkdir/rounding.$taal
!endif

origin=0
applet=1
embed=1
mathview=0
make_tr=0
questiontype=0
cols=16
rows=2
checkfile=$checkdir/number.proc
extratext=!record 12 of lang/remarks.$taal
helptext=$empty
x=!randitem 6,8,10,12,14
a=!randitem -3,-2,-1,1,2,3
z=$[$x+($a)]
b=$[$x/2]
c=$[ceil(sqrt($b^2+$b^2))]
d=!randint $c,$[$c+4]
Oppervlak=!record 24 of lang/remarks.$taal
hoogte=!record 27 of lang/remarks.$taal
!if $R=1
    setje=A,B B,C C,D A,D
    keuze=!randint 1,4
    keuze=4
    set=!word $keuze of $setje
    A=!item 1 of $set
    B=!item 2 of $set
    AB=!nospace $A $B
    AT=!nospace $A T
    BT=!nospace $B T
    ABT=!nospace $A $B T
    coord=-9.23,-5.44,1.57,-7.06\
    1.57,-7.06,6.81,-3.75\
    6.81,-3.75,-4.10,-2.19\
    -9.23,-5.44,-4.10,-2.19
    
    lijn=!line $keuze of $coord
    lijn=!nospace $lijn
    
    punt1=!item 1 of $lijn
    punt2=!item 2 of $lijn
    punt3=!item 3 of $lijn
    punt4=!item 4 of $lijn
    #A(-9.23,-5.44) B(1.57,-7.06) C(6.81,-3.75) D(-4.10,-2.19) T(-1.28,8.06) S(-1.21,-4.56) AB(-4.15,-6.81)
    object$n=!exec canvasdraw\
    size 398,320\
    xrange -10,10\
    yrange -10,10\
    fontfamily 18px Ariel\
    copy -10,10,-1,-1,-1,-1,$module_dir/gifs/exo3.jpg\
    linewidth 2\
    point,-1.21,-4.56,blue\
    #point,$punt1,$punt2,blue\
    string black,-4.15,-7.31,$x\
    string black,-1.01,-0.56,$z\
    string black,-1.01,-4.56,S\
    linewidth 2\
    dashed\
    dashtype 6,3\
    segment -1.28,8.06,-1.21,-4.56,black\
    opacity 255,100\
    fillcolor yellow\
    fpoly yellow,$punt1,$punt2,$punt3,$punt4,-1.28,8.06\
    mouse red,18\
    dashed\
    dashtype 4,2\
    opacity 215,50\
    filled\
    fillcolor orange\
    replyformat -1\
    userdraw poly3,red 
         
    e=$[$d^2-$b^2]
    !if . isin $[sqrt($e)]
	h=sqrt($e)
	h_tex=\sqrt{$e}
        answer$n=$b*$h
        ans=\approx $[round($rounding*$(answer$n))/$rounding] 
    !else
	h=$[sqrt($e)]
	h_tex=$h
        answer$n=$[$b*$h]
	ans= = $(answer$n)
    !endif
    ss=!record 28 of lang/remarks.$taal
    #@:Gegeven een regelmatige piramide<br />met grondvlak ABCD en top T.<br />AB=$x en $AT=$d<br />Bepaal de oppervlakte van &Delta; $ABT .
    question$n=$ss 
    description=$Oppervlak: 
    texanswer$n=\left[ \begin{array}{l} \textrm{$hoogte} \ \Delta $ABT = \sqrt{$d^{2}-$b^{2}}=$h_tex \\ \textrm{$Oppervlak} = \frac{1}{2} \cdot $x \cdot $h_tex $ans \end{array} \right.
    
 !exit
!endif

!if $R=2
    setje=A,C B,D 
    keuze=!randitem 1,2
    set=!word $keuze of $setje
    A=!item 1 of $set
    B=!item 2 of $set
    AB=!nospace $A $B
    AT=!nospace $A T
    BT=!nospace $B T
    AR=!nospace $A R
    ABT=!nospace $A $B T
    e=$[$b^2+$b^2]
    h=$[$d^2-$e]

    #A(-9.23,-5.44) B(1.57,-7.06) C(6.81,-3.75) D(-4.10,-2.19) T(-1.28,8.06) S(-1.21,-4.56) AB(-4.15,-6.81)
    
    coord=-9.23,-5.44,6.81,-3.75\
    1.57,-7.06,-4.10,-2.19
    lijn=!line $keuze of $coord
    lijn=!nospace $lijn
    
    punt1=!item 1 of $lijn
    punt2=!item 2 of $lijn
    punt3=!item 3 of $lijn
    punt4=!item 4 of $lijn
    
    object$n=!exec canvasdraw\
    size 398,320\
    xrange -10,10\
    yrange -10,10\
    fontfamily 18px Ariel\
    copy -10,10,-1,-1,-1,-1,$module_dir/gifs/exo3.jpg\
    linewidth 2\
    point,-1.21,-4.56,blue\
    #point,$punt1,$punt2,blue\
    string black,-4.15,-7.31,$x\
    string black,-1.01,-0.56,$z\
    string black,-1.01,-4.56,S\
    linewidth 2\
    dashed\
    dashtype 6,3\
    segment -1.28,8.06,-1.21,-4.56,black\
    opacity 255,100\
    fillcolor yellow\
    fpoly yellow,$punt1,$punt2,$punt3,$punt4,-1.28,8.06\
    mouse red,18\
    dashed\
    dashtype 4,2\
    opacity 215,50\
    filled\
    fillcolor orange\
    replyformat -1\
    userdraw poly3,red 

    !if . isin $[sqrt($h)]
	h_tex=\sqrt{$h}
        answer$n=sqrt($e)*sqrt($h)
        ans=\approx $[round($rounding*$(answer$n))/$rounding] 
    !else
	h_tex=$[sqrt($h)]
        answer$n=$h_tex*sqrt($e)
	ans=\approx $[round($rounding*$(answer$n))/$rounding]
    !endif
    ss=!record 28 of lang/remarks.$taal
    #@:Gegeven een regelmatige piramide<br />met grondvlak ABCD en top T.<br />AB=$x en $AT=$d<br />Bepaal de oppervlakte van &Delta; $ABT .
    question$n=$ss 
    description=$Oppervlak:
    texanswer$n=\left[ \begin{array}{l} $AR=\sqrt{$b^{2}+$b^{2}}=\sqrt{$e} \\ TR=\sqrt{$d^{2}-$e}=\sqrt{$h} \\ \textrm{$Oppervlak} = \frac{1}{2} \cdot 2 \cdot \sqrt{$e} \cdot $h_tex $ans \end{array} \right.
     
 !exit
!endif


!if $R>2
    setje=A,B,C,D B,C,A,D 
    keuze=!randitem 1,2
    set=!word $keuze of $setje
    A=!item 1 of $set
    B=!item 2 of $set
    C=!item 3 of $set
    D=!item 4 of $set
    AB=!nospace $A $B
    AT=!nospace $A T
    CD=!nospace $C $D
    ABT=QRT

    #A(-9.23,-5.44) B(1.57,-7.06) C(6.81,-3.75) D(-4.10,-2.19) T(-1.28,8.06) S(-1.21,-4.56) AB(-4.15,-6.81)
    
    coord=-3.83,-6.25,1.36,-2.97\
    4.19,-5.41,-6.67,-3.82
    
    lijn=!line $keuze of $coord
    lijn=!nospace $lijn
    
    punt1=!item 1 of $lijn
    punt2=!item 2 of $lijn
    punt3=!item 3 of $lijn
    punt4=!item 4 of $lijn
    
    object$n=!exec canvasdraw\
    size 398,320\
    xrange -10,10\
    yrange -10,10\
    fontfamily 18px Ariel\
    copy -10,10,-1,-1,-1,-1,$module_dir/gifs/exo3.jpg\
    linewidth 2\
    point,-1.21,-4.56,blue\
    point,$punt1,$punt2,blue\
    point,$punt3,$punt4,blue\
    string black,-4.15,-7.31,$x\
    string black,-5.88,-0.56,$d\
    string black,-1.01,-4.56,S\
    string black,$punt1,$punt2,R\
    string black,$punt3,$punt4,Q\
    linewidth 2\
    dashed\
    dashtype 6,3\
    segment -1.28,8.06,-1.21,-4.56,black\
    opacity 255,100\
    fillcolor yellow\
    fpoly yellow,$punt1,$punt2,$punt3,$punt4,-1.28,8.06\
    mouse red,18\
    dashed\
    dashtype 4,2\
    opacity 215,50\
    filled\
    fillcolor orange\
    replyformat -1\
    userdraw poly3,red 

    e=$[$d^2-$b^2]
    h=$[$e-$b^2]
    !if . isin $[sqrt($e)]
	tr=sqrt($e)
	tr_tex=\sqrt{$e}
    !else
	tr=$[sqrt($e)]
	tr_tex=$tr
    !endif
    !if . isin $[sqrt($h)]
	ts=sqrt($h)
	ts_tex=\sqrt{$h}
	answer$n=$b*$ts
	ans=\approx $[round($rounding*$(answer$n))/$rounding] 
    !else
	ts=$[sqrt($h)]
	ts_tex=$ts
	answer$n=$b*$ts
	ans= =$[$b*$ts]
    !endif
    ss=!record 29 of lang/remarks.$taal
    #@:Gegeven een regelmatige piramide<br />met grondvlak ABCD en top T.<br />AB=$x en $AT=$d<br />
    R is het midden van $AB . Q is het midden van $CD .<br />Bepaal de oppervlakte van &Delta; $ABT .  
    question$n=$ss
    description=$Oppervlak:
    
    texanswer$n=\left[ \begin{array}{l} TR = \sqrt{$d^{2}-$b^{2}}=$tr_tex \\ TS = \sqrt{$e - $b^{2}}=$ts_tex \\ \textrm{$Oppervlak} = \frac{1}{2} \cdot $x \cdot $ts_tex $ans \end{array} \right.
    
 !exit
!endif

