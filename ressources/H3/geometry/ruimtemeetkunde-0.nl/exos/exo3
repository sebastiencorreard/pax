#:[HTML5] Piramide [ Pythagoras ]
n=$counter

R=$level
!if $level=0
    R=$counter
!endif
origin=0
applet=1
embed=1
make_tr=0
inputs=1
questiontype=0
cols=20
rows=1
m_rightarrow=&nbsp;=
checkfile=$checkdir/number.proc
helptext=$empty
!if $R=1
    !if $rounding<0
	rounding=100
	!readproc $remarkdir/rounding.$taal
    !endif
    setje=A,B B,C C,D A,D
    keuze=!randint 1,4
    set=!word $keuze of $setje
    A=!item 1 of $set
    B=!item 2 of $set
    AB=!nospace $A $B
    x=!randitem 6,8,10,12
    a=!randitem -3,-2,-1,1,2,3
    z=$[$x+($a)]
    b=$[$x/2]
    d=$[$b^2+$z^2]
    d_tex=$b^{2}+$z^{2}
#A(-9.22,-5,37) B(1.58,-7.06) C(6.81,-3.75) D(-4.10,-2.19) T(-1.28,8.06) S(-1.21,-4.56) AB(-4.15,-6.81)

    coord=-1.28,8.06,-3.82,-6.22\
    -1.28,8.06,4.20,-5.41\
    -1.28,8.06,1.36,-2.97\
    -1.28,8.06,-6.66,-3.78
    
    lijn=!line $keuze of $coord
    lijn=!nospace $lijn 
    
    punt1=!item 3 of $lijn
    punt2=!item 4 of $lijn
    
    !if $keuze<3
	seg=segment $lijn,darkred
    !else
	seg=dashed\
	dashtype 6,3\
	segment $lijn,darkred
    !endif
    
    object$n=!exec canvasdraw\
    size 398,320\
    xrange -10,10\
    yrange -10,10\
    fontfamily 18px Ariel\
    copy -10,10,-1,-1,-1,-1,$module_dir/gifs/exo3.jpg\
    #points red,0,0,1,1,2,2,3,3,4,4\
    linewidth 2\
    point,-1.21,-4.56,blue\
    point,$punt1,$punt2,blue\
    string black,-4.15,-7.31,$x\
    string black,-1.01,-0.56,$z\
    string black,-1.01,-4.56,S\
    string black,$punt1,$punt2,R\
    linewidth 2\
    dashed\
    dashtype 6,3\
    segment -1.28,8.06,-1.21,-4.56,black\
    $seg\
    #segment $lijn,darkred\
    #userdraw segment,red\
    #mouse red,18\
    dashed\
    dashtype 6,3\
    opacity 255,50\
    filled\
    fillcolor orange\
    replyformat -1\
    userdraw poly3,red 
    
    answer$n=sqrt($d)
    test=$[$(answer$n)]
    !if $rounding=0
	ans=$empty
    !else
	ans=\approx $[round($rounding*$(answer$n))/$rounding]
    !endif
    !if . isin $test
        tex=\sqrt{$d} $ans
    !else
        tex=\sqrt{$d} = $test
    !endif
    ss=!record 6 of lang/remarks.$taal
    #@Gegeven een regelmatige piramide<br />met grondvlak ABCD en top T.<br />AB=$x en de hoogte TS=$z<br />R is het midden van $AB<br />Bereken de lengte van TR
    question$n=$ss 
    description=d(TR)
    texanswer$n= \bf{SR} =$b \rightarrow \bf{TR} = \sqrt{$d_tex} = $tex
    
 !exit
!endif


!if $R>1
    !if $rounding<0
	rounding=100
	!readproc $remarkdir/rounding.$taal
    !endif
    A=!randitem A,B,C,D
    AT=!nospace $A T
    AS=!nospace $A S
    x=!randint 6,8,10,12,14
    a=!randitem -3,-2,-1,1,2,3
    z=$[$x+($a)]
    b=$[$x/2]
    c=$[$b^2+$b^2]
    c_tex=$b^{2}+$b^{2}
    d=$[$c+$z^2]
    d_tex=$c+$z^{2}

    
    object$n=!exec canvasdraw\
    size 398,320\
    xrange -10,10\
    yrange -10,10\
    fontfamily 18px Ariel\
    copy -10,10,-1,-1,-1,-1,$module_dir/gifs/exo3.jpg\
    #points red,0,0,1,1,2,2,3,3,4,4\
    linewidth 2\
    point,-1.21,-4.56,blue\
    string black,-4.15,-7.31,$x\
    string black,-1.01,-0.56,$z\
    string black,-1.01,-4.56,S\
    #string black,$punt1,$punt2,R\
    linewidth 2\
    dashed\
    dashtype 6,3\
    segment -1.28,8.06,-1.21,-4.56,black\
    #mouse red,18\
    dashed\
    dashtype 6,3\
    opacity 255,50\
    filled\
    fillcolor orange\
    replyformat -1\
    userdraw poly3,red 
    

    answer$n=sqrt($d)
    test=$[$(answer$n)]
    !if $rounding=0
	ans=$empty
    !else
	ans=\approx $[round($rounding*$(answer$n))/$rounding]
    !endif
    !if . isin $test
        tex=\sqrt{$d} $ans
    !else
        tex=\sqrt{$d} = $test
    !endif
    ss=!record 7 of lang/remarks.$taal
    #@Gegeven een regelmatige piramide<br />met grondvlak ABCD en top T.<br />AB=$x en de hoogte TS=$z<br /><br />Bereken de lengte van $AT
    question$n=$ss
    description=d($AT)
    texanswer$n=\left[ \begin{array} {l} $AS=\sqrt{$c_tex} = \sqrt{$c} \rightarrow \\ $AT=\sqrt{$d_tex} = $tex \end{array} \right.
    
 !exit
!endif

    
