\text{name_statement=Si consideri la figura seguente composta da quadrati identici numerati da 1 a 8 e nella quale gli angoli tra due quadrati contigui sono uguali a due a due.
<p>Il punto \(O\) è il punto medio del segmento <span class="nowrap">\([DH]\).</span></p>}
\text{name_carre=È il quadrato}
}
\text{liste=1,2,3,4,5,6,7,8}
\text{image=transfo1.png}
\integer{j=randint(2..8)}
