\title{Homothétie 3}
\title_it{Omotetia 3}
\text{name_alt=triangles homothétiques}
\text{name_statement1=En appliquant à la figure A des homothéties de centre O et de rapports différents, on a ensuite obtenu d'autres figures.}
\text{name_instruction=On exprimera le rapport cherché sous la forme d'un nombre entier ou d'une fraction irréductible.}
note for translators: keep commas
\text{name_quest1=Quel est le rapport d'homothétie de centre O qui permet d'obtenir la figure,à partir de la figure A&nbsp;}
note for translators: keep commas
\text{name_quest2=On applique l'homothétie de centre O et de rapport,à la figure,Quelle figure obtient-on&nbsp;}
\if{\lang=it}{
\text{name_alt=triangoli omotetici}
\text{name_statement1=Applicando alla figura A delle omotetie di centro O e di rapporti diversi si sono ottenute altre figure.}
\text{name_instruction=Esprimere il rapporto cercato sotto forma di un numero intero o di una frazione irriducibile.}
note for translators: keep commas
\text{name_quest1=Qual è il rapporto dell'omotetia con centro O che permette di ottenere la figura, dalla figura A}
note for translators: keep commas
\text{name_quest2=Applichiamo l'omotetia con centro O e rapporto, alla figura, Otteniamo così la figura}
