val15=A,B,C,D,E,F,G,H,I,J,K,L,M
tmp=!trim $(val15[1]),$(val15[5]),$(val15[9])	$(val15[5]),$(val15[9]),$(val15[13])	$(val15[1]),$(val15[9]),$(val15[8])	$(val15[9]),$(val15[13]),$(val15[8])	$(val15[13]),$(val15[12]),$(val15[8])	$(val15[8]),$(val15[12]),$(val15[4])	$(val15[13]),$(val15[12]),$(val15[7])	$(val15[12]),$(val15[4]),$(val15[7])	$(val15[11]),$(val15[3]),$(val15[7])	$(val15[11]),$(val15[7]),$(val15[13])	$(val15[6]),$(val15[11]),$(val15[3])	$(val15[6]),$(val15[13]),$(val15[11])	$(val15[6]),$(val15[13]),$(val15[10])	$(val15[6]),$(val15[10]),$(val15[2])	$(val15[5]),$(val15[10]),$(val15[13])	$(val15[2]),$(val15[10]),$(val15[5])
val16=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val15[1]),$(val15[4]),$(val15[2])	$(val15[2]),$(val15[1]),$(val15[3])	$(val15[3]),$(val15[2]),$(val15[4])	$(val15[4]),$(val15[3]),$(val15[1])	$(val15[5]),$(val15[8]),$(val15[6])	$(val15[6]),$(val15[5]),$(val15[7])	$(val15[7]),$(val15[6]),$(val15[8])	$(val15[8]),$(val15[7]),$(val15[5])	$(val15[9]),$(val15[12]),$(val15[10])	$(val15[10]),$(val15[9]),$(val15[11])	$(val15[11]),$(val15[10]),$(val15[12])	$(val15[12]),$(val15[11]),$(val15[9])	$(val15[13]),$(val15[13]),$(val15[13])
val17=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 16

val18=$[rint($(tmp0))]
val19=$(val16[$val18;1])$(val16[$val18;2])$(val16[$val18;3])
!if $val13=1 
!for val20 =1 to 13 
!if $(val16[$val18;1]) issamecase $(val17[$val20;1]) 
val21=$(val17[$val20;2])
val22=$(val17[$val20;3])
!endif
!if $(val16[$val18;2]) issamecase $(val17[$val20;1]) 
