val21=$(val17[$val20;3])
val22=$(val17[$val20;2])
!endif
!if $(val16[$val18;2]) issamecase $(val17[$val20;1]) 
val23=$(val17[$val20;3])
val24=$(val17[$val20;2])
!endif
!if $(val16[$val18;3]) issamecase $(val17[$val20;1]) 
val25=$(val17[$val20;3])
