!set title=Symétrie centrale 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Simmetria centrale 5

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Conclusion&nbsp;
val8=Quelle est l'image du cerf-volant,par la symétrie de centre
val9=La figure ci-dessous est un pavage constitué de cerfs-volants identiques.
val10=Le quadrilatère,ainsi formé est un losange de centre
val11=Le cerf-volant
!if $val6=it 
val7=Conclusione
val8=Qual è l'immagine dell'aquilone,tramite la simmetria di centro
val9=La figura qui sotto è un pavimento costituito da aquiloni identici.
val10=Il quadrilatero, così formato è un rombo di centro
val11=L'aquilone
!endif
val12=1,2,3,4,5,6
val13=transfo5.png
tmp=!trim 1,6	2,5	3,4	4,3	5,2	6,1
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=Par demi-tour autour du point <span class="nowrap">\(J\),</span> le cerf-volant \($(val15[1])\) se superpose au cerf-volant <span class="nowrap">\($(val15[2])\).</span>	<p>$val7: Par la symétrie de centre <span class="nowrap">\(J\),</span> l'image du cerf-volant \($(val15[1])\) est le cerf-volant <span class="nowrap">\($(val15[2])\).</span></p>
!if $val6=it 
val16=Applicando la simmetria centrale rispetto al punto <span class="nowrap">\(J\),</span> l'aquilone \($(val15[1])\) si sovrappone all'aquilone <span class="nowrap">\($(val15[2])\).</span>	<p>$val7: Applicando la simmetria centrale <span class="nowrap">\(J\),</span> l'immagine dell'aquilone \($(val15[1])\) è l'aquilone <span class="nowrap">\($(val15[2])\).</span></p>
!endif
replytype1=menu
replyname1=$val11
replygood1=$(val15[2]);$val12
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val16


!goto stat

!exit

