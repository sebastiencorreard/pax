val49=var brd = JXG.JSXGraph.initBoard('jxgbox', {	 axis:false,boundingbox: [-10, 10, 10, -10], grid:true,showCopyright:false});	var ptdep = brd.create('point', [$(val8[7]),$(val8[8])], {name: "$val34",fixed:true,face:'cross',showInfobox:false});	var ptarr = brd.create('point', [$(val8[9]),$(val8[10])], {name: "$val35",fixed:true,face:'cross',showInfobox:false});	var D = brd.create('point', [$val39,$val40], {name: "$val13",fixed:true,face:'cross',showInfobox:false});	var deparr = brd.create('arrow', [ptdep, ptarr]);	jxgbox_rep1 = brd.create('point',jxgbox_var1,{name:"$val12",showInfoBox:false,snapToGrid:true} );
val50=Une translation est une transformation géométrique qui correspond à l'idée intuitive de « glissement » d'un objet,	sans rotation, ni retournement, ni déformation de cet objet.	<p>Par exemple, la figure bleue est l'image de la figure rouge par la translation qui transforme le point \(A\) en <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Translaté de cocotte"></div>	<p>L'image de \(A\) est \(A^{'}\), l'image de \(C\) est \(C^{'}\), l'image de \(H\) est \(H^{'}\).</p>	Les quadrilatères \(A A^{'}C^{'}C\) et \(A A^{'}H^{'}H\) sont des parallélogrammes.
val51=Le point \($val12\) est l'antécédent du point \($val13\) par la translation qui transforme $(val8[11]) signifie que le point \($val13) est l'image du point \($val12\) par cette même translation.	<p>Ainsi le quadrilatère \($val45\) est un parallélogramme.</p>	On place le point \($val12\) de sorte que \($val45\) soit un parallélogramme.
!if $val6=it 
val50=Una traslazione è una trasformazione geometrica che corrisponde all'idea intuitiva di «scivolamento» di un oggetto,	senza rotazione, né ribaltamento, né deformazione di tale oggetto.	<p>Per esempio, la figura blu è l'immagine della figura rossa tramite la traslazione che trasforma il punto \(A\) in <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Traslato di cocotte"></div>	<p>L'immagine di \(A\) è \(A^{'}\), l'immagine di \(C\) è \(C^{'}\), l'immagine di \(H\) è \(H^{'}\).</p>	I quadrilateri \(A A^{'}C^{'}C\) e \(A A^{'}H^{'}H\) sono parallelogrammi.
val51=Il punto \($val12\) è la preimmagine del punto \($val13\) tramite la traslazione che trasforma $(val8[11]), il che significa che il punto \($val13\) è l'immagine del punto \($val12\) tramite questa stessa traslazione.	<p>Ciò significa che il quadrilatero \($val45\) è un parallelogramma.</p>	Si deve quindi posizionare il punto \($val12\) in modo che \($val45\) sia un parallelogramma.
!endif
