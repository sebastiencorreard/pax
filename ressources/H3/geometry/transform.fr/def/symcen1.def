 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Conclusion&nbsp;
val8=Quel est le symétrique par rapport au point,du carré
val9=On considère la figure suivante composée de carrés identiques numérotés de 1 à 8 et dans laquelle les angles de deux carrés contigus sont égaux deux à deux.	<p>Le point \(O\) est le milieu du segment <span class="nowrap">\([DH]\).</span></p>
val10=Le carré
!if $val6=it 
val7=Conclusione
val8=Qual è il simmetrico rispetto al punto,del quadrato
val9=Si consideri la figura seguente composta da quadrati identici numerati da 1 a 8 e nella quale gli angoli tra due quadrati contigui sono uguali a due a due.	<p>Il punto \(O\) è il punto medio del segmento <span class="nowrap">\([DH]\).</span></p>
val10=È il quadrato
!endif
val11=1,2,3,4,5,6,7,8
val12=transfo1.png
tmp=!trim 1,5	2,6	3,7	4,8	5,1	6,2	7,3	8,4
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=$(val8[1]) \(O\) $(val8[2])
val16=Par demi-tour autour du point \(O\), le carré \($(val14[1])\) se superpose au carré <span class="nowrap">\($(val14[2])\).</span>	<p>$val7: Le symétrique par rapport au point \(O\) du carré \($(val14[1])\) est le carré <span class="nowrap">\($(val14[2])\).</span>
!if $val6=it 
val16=Applicando una simmetria centrale rispetto al punto \(O\) il quadrato \($(val14[1])\) si sovrappone al quadrato <span class="nowrap">\($(val14[2])\).</span>	<p>$val7: Il simmetrico rispetto al punto \(O\) del quadrato \($(val14[1])\) è il quadrato <span class="nowrap">\($(val14[2])\).</span>
!endif
replytype1=menu
replyname1=
replygood1=$(val14[2]);$val11
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val16


!goto stat

!exit

