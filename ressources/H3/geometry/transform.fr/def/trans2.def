!set title=Translation 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Traslazione 2

ansorder=r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 3

val7=$[rint($(tmp0))]
!if $val7=1 
tmp=!trim B,C	C,D	D,E	F,G	H,I	J,K	K,L	L,M	M,N	O,P	P,Q	Q,R
val8=!translate internal $	\
$ to ;; in $tmp
val9=A,B
!endif
!if $val7=2 
tmp=!trim B,J	C,K	D,L	E,M	G,O	I,Q
val8=!translate internal $	\
$ to ;; in $tmp
val9=H,P
!endif
!if $val7=3 
tmp=!trim A,G	B,H	F,L	G,M	H,N	J,P	K,Q	L,R
val8=!translate internal $	\
$ to ;; in $tmp
val9=C,I
!endif
tmp=!translate internal $	$ to ; in $val8

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)

val10=$(tmp1)
tmp=!trim $(val8[$(val10[1..4]);])
val11=!translate internal $	\
$ to ;; in $tmp
val12=en
val13=Points situés sur un réseau pointé à maille triangulaire
val14=Compléter les phrases suivantes,Par la translation qui transforme le point,l'image du point,est
!if $val6=it 
val12=nel punto
val13=Punti situati su una rete punteggiata a maglia triangolare
val14=Completa le frasi seguenti,Applicando la traslazione che trasforma il punto,l'immagine del punto,è
!endif
val15=\(A\) $val12 \(B\) :,\(H\) $val12 \(P\) :,\(C\) $val12 \(I\) :
val16=Le quadrilatère \($(val9[1])$(val9[2])$(val11[1;2])$(val11[1;1])\) est un parallélogramme donc la translation,	qui transforme le point \($(val9[1])\) en le point \($(val9[2])\)	transforme également le point \($(val11[1;1])\) en le point <span class="nowrap">\($(val11[1;2])\).</span>	</p>	<p>Le quadrilatère \($(val9[1])$(val9[2])$(val11[2;2])$(val11[2;1])\) est un parallélogramme donc la translation,	qui transforme le point \($(val9[1])\) en le point \($(val9[2])\) transforme également	le point \($(val11[2;1])\) en le point <span class="nowrap">\($(val11[2;2])\).</span></p>	Le quadrilatère \($(val9[1])$(val9[2])$(val11[3;2])$(val11[3;1])\) est un parallélogramme donc la translation,	qui transforme le point \($(val9[1])\) en le point \($(val9[2])\) transforme également le point	\($(val11[3;1])\) en le point <span class="nowrap">\($(val11[3;2])\).</span></p>	<p>Le quadrilatère \($(val9[1])$(val9[2])$(val11[4;2])$(val11[4;1])\) est un parallélogramme donc la translation,	qui transforme le point \($(val9[1])\) en le point \($(val9[2])\) transforme également le point \($(val11[4;1])\)	en le point <span class="nowrap">\($(val11[4;2])\).</span></p>
val17=Une translation est une transformation géométrique qui correspond à l'idée intuitive de « glissement » d'un objet,	sans rotation, ni retournement, ni déformation de cet objet.	<p>Par exemple, la figure bleue est l'image de la figure rouge par la translation qui transforme le point \(A\) en <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Translaté de cocotte"></div>	<p>L'image de \(A\) est \(A^{'}\), l'image de \(C\) est \(C^{'}\), l'image de \(H\) est \(H^{'}\).</p>	Les quadrilatères \(A A^{'}C^{'}C\) et \(A A^{'}H^{'}H\) sont des parallélogrammes.
!if $val6=it 
val16=Il quadrilatero \($(val9[1])$(val9[2])$(val11[1;2])$(val11[1;1])\) è un parallelogramma quindi la traslazione	che trasforma il punto \($(val9[1])\) nel punto \($(val9[2])\)	trasforma anche il punto \($(val11[1;1])\) nel punto <span class="nowrap">\($(val11[1;2])\).</span>	</p>	<p>Il quadrilatero \($(val9[1])$(val9[2])$(val11[2;2])$(val11[2;1])\) è un parallelogramma quindi la traslazione	che trasforma il punto \($(val9[1])\) nel punto \($(val9[2])\) trasforma anche	il punto \($(val11[2;1])\) nel punto <span class="nowrap">\($(val11[2;2])\).</span></p>	Il quadrilatero \($(val9[1])$(val9[2])$(val11[3;2])$(val11[3;1])\) è un parallelogramma quindi la traslazione	che trasforma il punto \($(val9[1])\) nel punto \($(val9[2])\) trasforma anche il punto	\($(val11[3;1])\) nel punto <span class="nowrap">\($(val11[3;2])\).</span></p>	<p>Il quadrilatero \($(val9[1])$(val9[2])$(val11[4;2])$(val11[4;1])\) è un parallelogramma quindi la traslazione	che trasforma il punto \($(val9[1])\) nel punto \($(val9[2])\) trasforma anche il punto \($(val11[4;1])\)	nel punto <span class="nowrap">\($(val11[4;2])\).</span></p>
val17=Una traslazione è una trasformazione geometrica che corrisponde all'idea intuitiva di «scivolamento» di un oggetto,	senza rotazione, né ribaltamento, né deformazione di tale oggetto.	<p>Per esempio, la figura blu è l'immagine della figura rossa tramite la traslazione che trasforma il punto \(A\) in <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Traslato di cocotte"></div>	<p>L'immagine di \(A\) è \(A^{'}\), l'immagine di \(C\) è \(C^{'}\), l'immagine di \(H\) è \(H^{'}\).</p>	I quadrilateri \(A A^{'}C^{'}C\) e \(A A^{'}H^{'}H\) sono parallelogrammi.
!endif
replytype1=case
replyname1=
