!set title=Rotation 7
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style> .macss{ background-color : yellow; } </style> 
title_it=Rotazione 7

ansorder=r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=transfo7.png
val8=inverse des aiguilles d'une montre,des aiguilles d'une montre
val9=Par la rotation de centre \(A\) et d'angle \(120^{\circ}\) dans le sens 
val10=Vous vous êtes trompé de sens de rotation pour la question
val11=L'hexagone
val12=La figure ci-dessous est constituée de 10 hexagones réguliers numérotés de 1 à 10.	<p>L'hexagone 5 est noté ABCDEF.</p>	Le point I est le milieu du segment [AB].
val13=Quelle est l'image de l'hexagone
val14=hexagone
!if $val6=it 
val8=in senso antiorario, in senso orario
val9=Applicando la rotazione di centro \(A\) e angolo \(120^{\circ}\) in senso
val10=Hai sbagliato il senso di rotazione
val11=È l'esagono
val12=La figura qui sotto è costituita da 10 esagoni regolari numerati da 1 a 10.	<p>L'esagono 5 è indicato con le lettere ABCDEF.</p>	 I è il punto medio del segmento [AB].
val13=Qual è l'immagine dell'esagono
val14=esagono
!endif
tmp0=!randint 2

val15=$[rint($(tmp0))]
tmp=!trim 8,10,2	5,9,6	9,6,5	6,5,9	2,8,10	10,2,8
val16=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val16

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)

val17=$(tmp1)
tmp=!trim $(val16[$(val17[1..3]);])
val18=!translate internal $	\
$ to ;; in $tmp
val19=$(val18[1;1]),$(val18[2;1]),$(val18[3;1])
!if $val15=1 
val20=$(val18[1;2]),$(val18[2;2]),$(val18[3;2])
val21=$(val18[1;3]),$(val18[2;3]),$(val18[3;3])
!else
val20=$(val18[1;3]),$(val18[2;3]),$(val18[3;3])
val21=$(val18[1;2]),$(val18[2;2]),$(val18[3;2])
!endif
replytype1=case
replyoption1=numexp 
replyname1=
replygood1=$(val20[1])
replytype2=case
replyoption2=numexp 
replyname2=
replygood2=$(val20[2])
replytype3=case
replyoption3=numexp 
replyname3=
replygood3=$(val20[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val12	<div class="wimscenter"><img src="$val1/$val7" alt="$val14"></div>	$val9	<span class="nowrap">$(val8[$val15]) ...</span>	<ul>	<li>$val13 $(val19[1])&nbsp;? <label for="reply1">$val11</label>  
!read oef/embed.phtml reply1,3 
$().</li>	<li>$val13 $(val19[2])&nbsp;? <label for="reply2">$val11</label>  
!read oef/embed.phtml reply2,3 
$().</li>	<li>$val13 $(val19[3])&nbsp;? <label for="reply3">$val11</label>  
!read oef/embed.phtml reply3,3 
$().</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply1 issametext $(val21[1])
 <div class='oef_feedbacks'><div class="macss">$val10 1.</div>
$()</div>
!endif
!ifval $m_reply2 issametext $(val21[2])
 <div class='oef_feedbacks'><div class="macss">$val10 2.</div>
$()</div>
!endif
!ifval $m_reply3 issametext $(val21[3])
 <div class='oef_feedbacks'><div class="macss">$val10 3.</div>
$()</div>
!endif

!exit

:test

!exit

