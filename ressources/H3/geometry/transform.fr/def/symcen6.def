!set title=Symétrie centrale 6
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style> .macss{ background-color : yellow; } </style> 
title_it=Simmetria centrale 6

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=transfo6.png
val8=Quel est le symétrique par rapport au point,du quadrilatère
val9=Le quadrilatère
val10=On considère l'hexagone ABCDEF de centre O représenté ci-dessous.
!if $val6=it 
val8=Qual è il simmetrico rispetto al punto,del quadrilatero
val9=Il quadrilatero
val10=Si consideri l'esagono ABCDEF di centro O rappresentato qui sotto.
!endif
tmp0=!shuffle ABOF,ABCO,CDEO,EDOF

val11=$(tmp0)
val12=$(val11[1])
!if $val12=ABOF 
val13=DEOC,DCOE,EOCD,EDCO,OCDE,OEDC,CDEO,COED
!endif
!if $val12=ABCO 
val13=DEFO,DOEF,EFOD,EDOF,FODE,FEDO,ODEF,OFED
!endif
!if $val12=CDEO 
val13=FABO,FOBA,ABOF,AFOB,BOFA,BAFO,OFAB,OBAF
!endif
!if $val12=EDOF 
val13=BAOC,BCOA,AOCB,ABCO,OCBA,OABC,CBAO,COAB
!endif
tmp0=!text expand $val12 using 01

val14=$(tmp0)
tmp0=!words2items $val14

val14=$(tmp0)
tmp0=!text expand $(val13[1]) using 01

val15=$(tmp0)
tmp0=!words2items $val15

val15=$(tmp0)
val16=$(val8[1]) \(O\) $(val8[2]) 
val17=Par la symétrie de centre O,	<p>le point \($(val14[1])\) a pour image le point <span class="nowrap">\($(val15[1])\),</span></p>	le point \($(val14[2])\) a pour image le point <span class="nowrap">\($(val15[2])\),</span>	<p>le point \($(val14[3])\) a pour image le point <span class="nowrap">\($(val15[3])\),</span></p>	<p>le point \($(val14[4])\) a pour image le point <span class="nowrap">\($(val15[4])\),</span></p>	<p>le symétrique du quadrilatère \($val12\) est le quadrilatère <span class="nowrap">\($(val13[1])\).</span></p>
!if $val6=it 
val17=Applicando la simmetria centrale O,	<p>il punto \($(val14[1])\) ha per immagine il punto <span class="nowrap">\($(val15[1])\),</span></p>	il punto \($(val14[2])\) ha per immagine il punto <span class="nowrap">\($(val15[2])\),</span>	<p>il punto \($(val14[3])\) ha per immagine il punto <span class="nowrap">\($(val15[3])\),</span></p>	<p>il punto \($(val14[4])\) ha per immagine il punto <span class="nowrap">\($(val15[4])\),</span></p>	<p>il simmetrico del quadrilatero \($val12\) è il quadrilatero <span class="nowrap">\($(val13[1])\).</span></p>
!endif
replytype1=auto

replyname1=$val9
replygood1=?analyze 18
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val17


!goto stat

!exit

