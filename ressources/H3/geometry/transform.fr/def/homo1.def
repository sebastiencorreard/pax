!set title=Homothétie 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Omotetia 1

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=triangles homothétiques
val8=Figure
val9=homothétie de rapport
val10=Les triangles roses sont les images du triangle vert \(ABC\) par des homothéties de centre D.
val11=Associer à chacun des triangles roses l'homothétie qui lui correspond.
!if $val6=it 
val7=triangoli omotetici
val8=Triangolo
val9=omotetia di rapporto
val10=I triangoli rosa sono le immagini del triangolo verde \(ABC\) tramite alcune omotetie di centro D.
val11=Associare a ciascuno dei triangoli rosa l'omotetia che gli corrisponde.
!endif
val12=homo1.png
tmp=!trim $val8 \(F_1\),$val9 \(-0.5)	$val8 \(F_{2}\),$val9 \(-0.3)	$val8 \(F_{3}\),$val9 \(0.3)	$val8 \(F_{4}\),$val9 \(0.5)
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)

val14=$(tmp1)
tmp=!trim $(val13[$(val14[1..4]);])
val15=!translate internal $	\
$ to ;; in $tmp
val16=correspond
!if $val6=it 
!endif
replytype1=$val16

replyoption1=split 
replyname1=
replygood1=$(val15[;1]);$(val15[;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<div class="wimscenter"><img src="$val1/$val12" alt="$val7"></div>	<p>$val11</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply1,40x100x200 
$()</div>	
$()
!exit

