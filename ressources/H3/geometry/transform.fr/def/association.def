!set title=Propriétés des transformations
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Proprietà delle trasformazioni

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim symétrie centrale, effectuer un demi-tour autour d'un point	symétrie axiale, plier le long d'une droite	translation, glisser sans rotation&#44; ni retournement&#44; ni déformation	rotation, tourner autour d'un point	homothétie, agrandir ou réduire une figure
val7=!translate internal $	\
$ to ;; in $tmp
val8=Associer chaque transformation (en gris) à son action (en orange)
!if $val6=it 
tmp=!trim simmetria centrale,effettuare un mezzogiro attorno a un punto	simmetria assiale, piegare lungo una retta	traslazione, scorrere senza rotazione&#44; né inversione&#44; né deformazione	rotazione, far girare attorno a un punto	omotetia, ingrandire o ridurre una figura
val7=!translate internal $	\
$ to ;; in $tmp
val8=Associare a ogni trasformazione la sua azione
!endif
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$(val7[;1]);$(val7[;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8.<br>	<div class="wimscenter"> 
!read oef/embed.phtml reply1,40x125x300 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
