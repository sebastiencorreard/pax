!set title=Symétrie centrale 7
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style> .macss{ background-color : yellow; } </style> 
title_it=Simmetria centrale 7

ansorder=r,r,r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=transfo7.png
val8=Conclusion&nbsp;
val9=Par la symétrie de centre 
val10=Par demi-tour autour du point
val11=se superpose à l'hexagone
val12=l'image de l'hexagone
val13=est l'hexagone
val14=l'hexagone
val15=L'hexagone
val16=La figure ci-dessous est constituée de 10 hexagones réguliers numérotés de 1 à 10.	<p>L'hexagone 5 est noté ABCDEF.</p>	Le point I est le milieu du segment [AB].
val17=Quelle est l'image de l'hexagone
val18=hexagone
!if $val6=it 
val8=Conclusione
val9=Applicando la simmetria di centro
val10=Applicando la rotazione di 180° attorno al punto
val11=si sovrappone all'esagono
val12=l'immagine dell'esagono
val13=è l'esagono
val14=l'esagono
val15=È l'esagono
val16=La figura qui sotto è costituita da 10 esagoni regolari numerati da 1 a 10.	<p>L'esagono 5 è indicato con le lettere ABCDEF.</p>	 I è il punto medio del segmento [AB].
val17=Qual è l'immagine dell'esagono
val18=esagono
!endif
tmp=!trim 1,10	2,9	3,8	4,7	5,6	6,5	7,4	8,3	9,2	10,1
val19=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val19

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)

val20=$(tmp1)
tmp=!trim $(val19[$(val20[1..3]);])
val21=!translate internal $	\
$ to ;; in $tmp
val22=$(val21[1;1]),$(val21[2;1]),$(val21[3;1])
val23=$(val21[1;2]),$(val21[2;2]),$(val21[3;2])
replytype1=case
replyoption1=numexp 
replyname1=
replygood1=$(val23[1])
replytype2=case
replyoption2=numexp 
replyname2=
replygood2=$(val23[2])
replytype3=case
replyoption3=numexp 
replyname3=
replygood3=$(val23[3])
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val16	<div class="wimscenter"><img src="$val1/$val7" alt="$val18"></div>	$val9	<span class="nowrap">
!insmath I
$()...</span>	<ul>	<li>$val17 $(val22[1])&nbsp;? <label for="reply1">$val15</label>  
!read oef/embed.phtml reply1,3 
$().</li>	<li>$val17 $(val22[2])&nbsp;? <label for="reply2">$val15</label>  
!read oef/embed.phtml reply2,3 
$().</li>	<li>$val17 $(val22[3])&nbsp;? <label for="reply3">$val15</label>  
!read oef/embed.phtml reply3,3 
$().</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val10 <span class="nowrap">
!insmath I
$(),</span>	<p>$val15 $(val22[1]) $val11 $(val23[1]),</p>	$val15 $(val22[2]) $val11 $(val23[2]),	<p>$val15 $(val22[3]) $val11 $(val23[3]).</p>	$val8:	<p>$val9 <span class="nowrap">
!insmath I
$(),</span>	$val12 $(val22[1]) $val13 $(val23[1]),	$val12 $(val22[2]) $val13 $(val23[2]),	$val12 $(val22[3]) $val13 $(val23[3]).</p>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
