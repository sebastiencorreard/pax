!set title=Symétrie centrale 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Simmetria centrale 3

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=transfo3.png
tmp=!trim 9,19,	10,18,	11,17,	12,16,	16,12,	17,11,	18,10,	19,9
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=Le motif
val11=Conclusion&nbsp;
val12=Quelle est l'image du motif,par la symétrie de centre
val13=On considère le pavage suivant constitué d'un même motif
val14=pavage
!if $val6=it 
val10=Il modulo
val11=Conclusione
val12=Qual è l'immagine del modulo,tramite la simmetria di centro
val13=Si consideri il pavimento seguente costituito da moduli identici
val14=pavimento
!endif
val15=Par demi-tour autour du point <span class="nowrap">\(G\),</span> le motif \($(val9[1])\) se superpose au motif <span class="nowrap">\($(val9[2])\).</span>	<p>$val11: Le symétrique du motif \($(val9[1])\) par rapport au point \(G\) est le motif <span class="nowrap">\($(val9[2])\).</span></p>
!if $val6=it 
val15=Con una rotazione di mezzo giro attorno al punto <span class="nowrap">\(G\),</span> il modulo \($(val9[1])\) si sovrappone al modulo <span class="nowrap">\($(val9[2])\).</span>	<p>$val11: Il simmetrico del modulo \($(val9[1])\) rispetto al punto \(G\) è il modulo <span class="nowrap">\($(val9[2])\).</span></p>
!endif
replytype1=numexp
replyname1=$val10
replygood1=$(val9[2])
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val15


!goto stat

!exit

:question
$()$val13.	<p class="wimscenter"><img src="$val1/$val7" alt="$val14"></p>	$(val12[1]) 
!insmath $(val9[1])
$() $(val12[2])	<span class="nowrap">
!insmath G
$() ?</span>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val15
$()
!exit

