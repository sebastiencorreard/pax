!set title=Symétrie centrale 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style> .macss{ background-color : yellow; } </style> 
title_it=Simmetria centrale 2

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=transfo2.png
tmp0=!makelist x for x=1 to 20

val8=$(tmp0)
val9=Le motif
val10=Conclusion&nbsp;
val11=Quel est le symétrique du motif,par la,demi-tour autour du point,au point
val12=symétrie centrale de centre
val13=On considère la figure suivante composée de vingt motifs numérotés de 1 à 20 dans laquelle l'angle \(\widehat{AOB}\) vérifie
!if $val6=it 
val9=Il modulo
val10=Conclusione
val11=Qual è il simmetrico del modulo,tramite la,rotazione di 180° attorno al punto, al punto
val12=simmetria centrale di centro
val13=Si consideri la figura seguente composta da venti moduli numerati da 1 a 20 nella quale l'angolo \(\widehat{AOB}\) soddisfa la condizione
!endif
tmp=!trim 1,6,	2,7,	3,8,	4,9,	5,10,	6,1,	7,2,	8,3,	9,4,	10,5,	11,16,	12,17,	13,18,	14,19,	15,20,	16,11,	17,12,	18,13,	19,14,	20,15
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$(val11[1]) \($(val15[1])\) $(val11[2]) 
val17=$(val11[3]) <span class="nowrap">\(O\),</span>
val18=$(val11[4]) \(O\)
val19=Par $val17 le motif \($(val15[1])\) se superpose au motif <span class="nowrap">\($(val15[2])\).</span>
val20=Le symétrique par rapport $val18 du motif \($(val15[1])\) est le motif <span class="nowrap">\($(val15[2])\).</span>
!if $val6=it 
val19=Applicando la $val17 il modulo \($(val15[1])\) si sovrappone al modulo <span class="nowrap">\($(val15[2])\).</span>
val20=Il simmetrico rispetto $val18 del modulo \($(val15[1])\) è il modulo <span class="nowrap">\($(val15[2])\).</span>
!endif
replytype1=menu
replyname1=$val9
replygood1=$(val15[2]);$val8
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val19 <p>$val10: $val20</p>


!goto stat

!exit

:question
$()$val13 <span class="nowrap">
!insmath \widehat{AOB}=36^{\circ}
$().</span>	<p class="wimscenter"><img src="$val1/$val7" alt="motif"></p>	$val16	$val12 <span class="nowrap">
!insmath O
$().</span>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val19 <p>$val10: $val20</p>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,7,10,12,13,16,19,20
embedcnt=0
