!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Conclusion&nbsp;
val8=Quel est le symétrique par rapport à la droite,du carré
val9=à lui-même. Il est son propre symétrique.
val10=au carré
val11=On considère la figure suivante composée de carrés identiques numérotés de 1 à 8 et dans laquelle les angles de deux carrés contigus sont égaux deux à deux.	<p>Le point \(O\) est le milieu du segment <span class="nowrap">\([DH]\).</span></p>
val12=Le carré
!if $val6=it 
val7=Conclusione
val8=Qual è il simmetrico rispetto alla retta,del quadrato
val9=a se stesso. È il proprio simmetrico.
val10=al quadrato
val11=Si consideri la figura seguente composta da quadrati identici numerati da 1 a 8 e nella quale gli angoli tra due quadrati contigui sono uguali a due a due.	<p>Il punto \(O\) è il punto medio del segmento <span class="nowrap">\([DH]\).</span></p>
val12=È il quadrato
!endif
val13=1,2,3,4,5,6,7,8
val14=transfo1.png
tmp=!trim 1,1,	2,8,	3,7,	4,6,	5,5,	6,4,	7,3,	8,2
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$(val8[1]) \((DH)\) $(val8[2]) 
!if $(val16[1])=1 or $(val16[1])=5 
val18=$val9
!else
val18=$val10 <span class="nowrap">\($(val16[2])\).</span>
!endif
val19=Par pliage le long de la droite \((DH)\), le carré \($(val16[1])\) se superpose $val18	<p>$val7: Le symétrique par rapport à la droite \((DH)\) du carré \($(val16[1])\) est...le carré <span class="nowrap">\($(val16[2])\).</span>
!if $val6=it 
val19=Applicando la riflessione rispetto alla retta \((DH)\), il quadrato \($(val16[1])\) si sovrappone $val18	<p>$val7: Il simmetrico rispetto alla retta \((DH)\) del quadrato \($(val16[1])\) è il quadrato <span class="nowrap">\($(val16[2])\).</span>
!endif
replytype1=menu
replyname1=
replygood1=$(val16[2]);$val13
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val19


!goto stat

