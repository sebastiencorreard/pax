tmp=!trim $val11
val13=!translate internal $	\
$ to ;; in $tmp
!endif
!readproc slib/data/random 2,row,$val13 
tmp0=$slib_out
tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2

val12=$[rint($(tmp0))]
!if $val12=2 
tmp=!trim $(val13[1;2]),$(val13[1;1])	$(val13[2;2]),$(val13[2;1])
val13=!translate internal $	\
$ to ;; in $tmp
!endif
val14=On considère le parallélépipède rectangle suivant,Quelle est l'image du point,par la translation qui transforme,en
val15=Le quadrilatère,forme un parallélogramme,La translation qui transforme,en,transforme le point
!if $val6=it 
val14=Si consideri il parallelepipedo rettangolo seguente,Qual è l'immagine del punto,tramite la traslazione che trasforma,in
val15=Il quadrilatero,forma un parallelogramma,La traslazione che trasforma,in,trasforma il punto
!endif
val16=Une translation est une transformation géométrique qui correspond à l'idée intuitive de « glissement » d'un objet,	sans rotation, ni retournement, ni déformation de cet objet.	<p>Par exemple, la figure bleue est l'image de la figure rouge par la translation qui transforme le point \(A\) en <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Translaté de cocotte"></div>	<p>L'image de \(A\) est \(A^{'}\), l'image de \(C\) est \(C^{'}\), l'image de \(H\) est \(H^{'}\).</p>	Les quadrilatères \(A A^{'}C^{'}C\) et \(A A^{'}H^{'}H\) sont des parallélogrammes.
!if $val6=it 
val16=Una traslazione è una trasformazione geometrica che corrisponde all'idea intuitiva di «scivolamento» di un oggetto,	senza rotazione, né ribaltamento, né deformazione di tale oggetto.	<p>Per esempio, la figura blu è l'immagine della figura rossa tramite la traslazione che trasforma il punto \(A\) in <span class="nowrap">\(A^{'}\).</span></p>	<div class="wimscenter"><img src="$val1/hinttrans2.png" alt="Traslato di cocotte"></div>	<p>L'immagine di \(A\) è \(A^{'}\), l'immagine di \(C\) è \(C^{'}\), l'immagine di \(H\) è \(H^{'}\).</p>	I quadrilateri \(A A^{'}C^{'}C\) e \(A A^{'}H^{'}H\) sono parallelogrammi.
!endif
replytype1=case
