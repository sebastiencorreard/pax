!read language lang/names
!header
!for i=0 to $[max(2,$diff )]
  !set couleur$i=!item $[$i+1] of $couleurs
!next i

!! La présentation de l'exercice.
!read present.phtml

!if $status=waiting
  !if $error!=$empty
    <div class="wims_msg alert">
    !read msg.phtml
    </div>
  !endif
  !! La forme de réponse
  <div class="wims_question">
  !read form.phtml
  </div>
  <p>
  !set wims_ref_class=wims_button
  !href exo_Renew
  </p>
!else
  !if $error!=$empty
    <div class="wims_msg alert">
    !read msg.phtml
    </div>
  !endif
  !! L'analyse de réponse
  !read answer.phtml
  <p>
  !set wims_ref_class=wims_button
  !href exo_Again

  !if $worksheet=$empty
    !set wims_ref_class=wims_button
    !href exo_Intro

  !endif
  </p>
!endif

:end
!tail
