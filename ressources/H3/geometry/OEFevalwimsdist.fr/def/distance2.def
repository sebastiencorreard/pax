val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=est une droite du plan et AAAA un point.
val7=Quel est le plus petit segment joignant AAAA  à un point de la droite (d)&nbsp;
val8=Le segment joignant AAAA  au pied de la perpendiculaire à (d) passant par AAAA .
val9=Le segment joignant AAAA  au pied de la parallèle à (d) passant par AAAA.,Peu importe tous les segments joignant AAAA  et un point de (d) sont de même longueur.
tmp0=!shuffle A,B,C,E,F

val10=$(tmp0)
val11=$(val10[1])
val12=$(val10[2])
val13=$(val10[3])
tmp0=!replace internal AAAA by $val11 in $val7

val14=$(tmp0)
tmp0=!replace internal AAAA by $val11 in $val8

val15=$(tmp0)
tmp0=!replace internal AAAA by $val11 in $val9

val16=$(tmp0)
tmp0=!replace internal AAAA by $val11 in $val6

val17=$(tmp0)
choicename1=
choicegood1=$val15
choicebad1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

