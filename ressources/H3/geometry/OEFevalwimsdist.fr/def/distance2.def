!set title=Distance d'un point à une droite 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=distance
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
