!set title=Calcul de distance 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=Si nécessaire arrondir votre résultat au dixième.
val8=rouge,bleue,verte,violette,marron
val9=est un carré dont les côtés mesurent,	   Quelle est la distance entre le sommet AAAA	   et la diagonale représentée sur le dessin&nbsp;
tmp0=!shuffle A,B,C,E,F,G

val10=$(tmp0)
val11=$(val10[1])
val12=$(val10[2])
val13=$(val10[3])
val14=$(val10[4])
val15=square 50,50,200,black	text black,45,35,medium,$val11	text black,245,35,medium,$val12	text black,245,255,medium,$val13	text black,45,255,medium,$val14	segment 50,250,250,50,black
!readproc oef/draw.phtml 300,300 \
$val15 
tmp0=$ins_url
val16=$(tmp0)
tmp0=!randint 10, 20

val17=$(tmp0)
val18=$[rint(sqrt(2)/2*$val17*10)/10]
tmp0=!replace internal AAAA by $val11 in $val9

val19=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_left"><img src="$val16" alt=""></div>	<div class="float_left">	  $val11$val12$val13$val14 $(val19[1]) $val17 cm.<br>$(val19[2])?	</div>	<div class="clearall">	 <b>$val6:</b>  
!read oef/embed.phtml r1,5 
$() cm.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,12,13,14,16,17,19
embedcnt=1
