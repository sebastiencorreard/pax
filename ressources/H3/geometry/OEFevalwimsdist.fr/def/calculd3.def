$()	 <div class="wimscenter"><img src="$val38" alt=""></div>	  <div>	   $(val41[1]) $val12$val13$val14 $(val41[2]) $val33 cm $(val41[3]) $val39 cm.	   $val42 $val12$val13$val14 ?	  </div>	  <div>	   <b>$val6:</b>  
