!set title=Définition 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La droite perpendiculaire à (AAAA BBBB) et passant par le milieu de [AAAA BBBB],	  L'ensemble des points équidistants de AAAA et BBBB,	  La droite joignant AAAA au milieu du côté [BBBB CCCC],	  La droite passant par AAAA et perpendiculaire à (BBBB CCCC),	  La demi-droite qui partage l'angle \(\widehat{BBBB AAAA CCCC}\) en deux angles de même mesure
val7=est un triangle. Voici une liste de propriétés.	  Lesquelles sont vérifiées par
val8=la médiatrice du segment
tmp0=!shuffle A,B,C,D,E,F

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
val12=$(val9[3])
val13=$val8 [$val10$val11]
val14=1,2
tmp0=!replace internal AAAA by $val10 in $val6

val15=$(tmp0)
tmp0=!replace internal BBBB by $val11 in $val15

val15=$(tmp0)
tmp0=!replace internal CCCC by $val12 in $val15

val15=$(tmp0)
replytype1=checkbox
replyoption1=shuffle split 
replyname1=
replygood1=$val14;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath $val10$val11$val12
$() $val7 $val13 ?	<ul>	 
!for m_k=1 to 5 
$()	 <li> 
!read oef/embed.phtml r1,\k 
$()</li>	 
!next
$()	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,13
embedcnt=1
