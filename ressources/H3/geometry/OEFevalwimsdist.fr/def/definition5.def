 !exit
!endif

val6=Intersection des médiatrices,Intersection des médianes,Intersection des hauteurs,Intersections des bissectrices
val7=Centre du cercle circonscrit,Centre de gravité,Orthocentre,Centre du cercle inscrit
val8=est un triangle quelconque. Ses trois médiatrices sont concourantes en un point.	  Il en est de même pour ses bissectrices, médianes et hauteurs.	  Pouvez-vous mettre en correspondance chacun de ces points avec son nom
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$val6;$val7
