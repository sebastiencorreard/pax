!set title=Formule 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=Compléter l'égalité suivante 
val8=Côté adjacent à,Hypoténuse,Côté opposé à 
val9=est l'un des deux angles aigus d'un triangle rectangle.
val10=180x30x1
tmp=!nonempty items x,y,z,a,b,c

tmp0=!randitem $tmp
val11=$(tmp0)
val11=\widehat{$val11}
val12=\(\cos($val11))
val13=$(val8[2]) \($(val11[1])\)
val14=$(val8[1])
val15=$(val8[3]) \($val11\)
val16=\($val11\) $val9
replytype1=clickfill
replyname1=Numérateur
replygood1=$val13;$val15,$val12
replytype2=clickfill
replyname2=Dénominateur
replygood2=$val14;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 
!if $m_dessin!= 
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$m_image" alt=""></div>	 <div class="medium_size text_col">	 
!endif
$()	 $val16	 $val7:	<table class="wimscenter wimsnoborder">	  <tr>	  <td rowspan="3">$val12</td>	  <td rowspan="3"> = </td>	  <td> 
!read oef/embed.phtml reply1,$val10 
$()</td>	  </tr>	  <tr><td><hr></td></tr>	  <tr>	  <td> 
!read oef/embed.phtml reply2,$val10 
$()</td>	  </tr>	 </table>	 
!if $m_dessin!= 
$()</div></div> 
!endif
$()	
$()
!exit

