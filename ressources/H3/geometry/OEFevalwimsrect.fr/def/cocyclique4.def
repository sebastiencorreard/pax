!set title=Points d'un cercle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=est un point du cercle de diamètre,distinct de, et
val8=Que représente le segment , pour le triangle
val9=Vous ne devez taper qu'un seul mot.
val10=Hypoténuse
tmp0=!shuffle A,B,C,D,E,F,G,H,R,S,T

val11=$(tmp0)
val12=$(val11[1])
val13=$(val11[2])
val14=$(val11[3])
tmp=!nonempty items $val13,$val14

tmp0=!randitem $tmp
val15=$(tmp0)
val16=$val10
replytype1=atext
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12 $(val7[1]) [$val13$val14] $(val7[2]) $val13 $(val7[3]) $val14.	<p>	$(val8[1]) [$val13$val14] $(val8[2]) $val12$val13$val14 ?	</p>	<label for="reply1"><b>$val6</b></label> :  
!read oef/embed.phtml r1 
$().	<div class="wims_instruction">$val9</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,12,13,14
embedcnt=1
