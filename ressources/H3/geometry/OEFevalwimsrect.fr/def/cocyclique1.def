!set title=Points d'un cercle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=est un point du cercle de diamètre,et de centre O. 
val8=Quelle est la mesure (en carreaux) du segment,tracé en
val9=rouge,bleu,vert,violet
val10=carreaux
tmp0=!shuffle A,B,C,D,E,F,G,H,R,S,T

val11=$(tmp0)
val12=$(val11[1])
val13=$(val11[2])
val14=$(val11[3])
tmp0=!randint 1, 4

val15=$[rint($(tmp0)*20)]
tmp0=!randint 5, 7

val16=$[rint(2*$(tmp0))]
tmp0=!values v,$val16-v for v=2 to $val16/2-1

val17=$(tmp0)
tmp=!nonempty items $val17

tmp0=!randitem $tmp
val17=$[rint($(tmp0))]
val18=$[rint($val16*20)]
val19=$[rint(10*20)]
val20=$[rint($val15+$val18)]
val21=$[rint($val19)]
val22=$[rint(($val15+$val20)/2)]
val23=$[rint($val19)]
val24=$[rint($val15+$val17*20)]
val25=$[rint($val23-sqrt(($val18/2)^2-($val24-$val22)^2))]
tmp0=!randint 1, 4

val26=$[rint($(tmp0))]
tmp0=!item $val26 of $val9

val27=$(tmp0)
tmp0=!item $val26 of red,blue,green,purple

val28=$(tmp0)
!readproc oef/draw.phtml 400,400 \
parallel 0,0,0,400,20,0,21,grey	parallel 0,0,400,0,0,20,21,grey	text black,$val22,$val23,medium,O	text black,$val15-8,$val19-4,medium,$val12	text black,$val20+2,$val21-4,medium,$val13	text black,$val24,$val25-15,medium,$val14	linewidth 2	triangle $val15,$val19,$val20,$val21,$val24,$val25,black	circle $val22,$val23,$val18,black	segment $val22,$val23,$val24,$val25,$val28 
tmp0=$ins_url
val29=$(tmp0)
val30=$[rint($val16/2)]
replytype1=numexp
replyname1=
replygood1=$val30
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14 $(val7[1]) [$val12$val13] $(val7[2])<p>	$(val8[1]) [O$val14] $(val8[2]) $val27 ?	</p>	<div class="wimscenter"><img src="$val29" alt=""></div>	<label for="reply1"><b$val6</b>:</label>  
!read oef/embed.phtml r1,8 
$() $val10.
$()
!exit

