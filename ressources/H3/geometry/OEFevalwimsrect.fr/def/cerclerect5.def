!set title=Cercle et triangle rectangle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=Cliquez sur la position du centre du cercle circonscrit au	  triangle rectangle ci-dessous.
val8=$[rint(8)]
tmp0=!randint 1, 4

val9=$[rint($(tmp0)*20)]
tmp0=!randint 5, 7

val10=$[rint(2*$(tmp0))]
tmp0=!values v,$val10-v for v=2 to $val10/2-1

val11=$(tmp0)
tmp=!nonempty items $val11

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[rint($val10*20)]
val13=$[rint(10*20)]
val14=$[rint($val9+$val12)]
val15=$[rint($val13)]
val16=$[rint(($val9+$val14)/2)]
val17=$[rint($val13)]
val18=$[rint($val9+$val11*20)]
val19=$[rint($val17-sqrt(($val12/2)^2-($val18-$val16)^2))]
val20=$[rint($val9-$val18)]
val21=$[rint($val13-$val19)]
val22=$[sqrt(($val20)^2+($val21)^2)/8]
val23=$[rint($val14-$val18)]
val24=$[rint($val15-$val19)]
val25=$[sqrt(($val23)^2+($val24)^2)/8]
!readproc oef/draw.phtml 400,250 \
parallel 0,0,0,400,20,0,21,grey		fpolygon red,$val18,$val19,$val18+$val23/$val25,$val19+$val24/$val25,$val18+$val23/$val25+$val20/$val22,$val19+$val24/$val25+$val21/$val22,$val18+$val20/$val22,$val19+$val21/$val22	linewidth 2	triangle $val9,$val13,$val14,$val15,$val18,$val19,black 
tmp0=$ins_url
val26=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val26;circle,$val16,$val17,8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7		<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>		
$()
!exit

