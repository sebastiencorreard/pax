!set title=Points d'un cercle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
tmp0=!shuffle A,B,C,D,E,F,G,H,R,S,T

val7=$(tmp0)
val8=$(val7[1])
val9=$(val7[2])
val10=$(val7[3])
tmp=!nonempty items $val9,$val10

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!trim isocèle de sommet principal O	isocèle de sommet principal $val8,rectangle en $val8,rectangle en O,équilatéral
val12=!translate internal $	\
$ to ;; in $tmp
choicename1=
choicegood1=$(val12[1;])
choicebad1=$(val12[2;])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Complétez la phrase suivante :	<div class="wimscenter" style="font-style:italic">		$val8 est un point du cercle de diamètre [$val9$val10] et de centre O.	Le point $val8 est distinct de $val9 et $val10.	Le triangle O$val8$val9 est...</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10
embedcnt=0
