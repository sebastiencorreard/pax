!set title=Calcul d'angle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=au degré,au dixième de degré,au centième de degré
val8=Utiliser la calculatrice pour donner l'arrondi, de la mesure de l'angle aigu,vérifiant 
tmp=!nonempty items A,B,C,D

tmp0=!randitem $tmp
val9=$(tmp0)
val9=\widehat{$val9}
val10=arccos(x)
val11=cos($val9)
tmp0=!randint 2, 15

tmp1=!randint 17, 45

tmp=!translate ";': to $     $ in $(tmp0)/$(tmp1)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
val12=$(tmp2)
tmp0=!replace internal x by $val12 in $val10

val13=$(tmp0)
tmp0=!randint 0, 2

val14=$[rint($(tmp0))]
tmp0=!item $val14+1 of $val7

val15=$(tmp0)
val16=$[$val13/pi*180]
val16=$[rint($val16*10^$val14)/10^$val14]
tmp0=!texmath $val12

val17=$(tmp0)
replytype1=numexp
replyname1=\($val9\)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val8[1]) $val15 $(val8[2]) 
!insmath $val9
$() $(val8[3]):	<div class="wimscenter">	 
!insmath $val11 = $val17 
$().	</div>	<b>$val6</b>:	 <label for="reply1">
!insmath $val9 \simeq 
$()</label>  
!read oef/embed.phtml r1,5 
$() °.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,11,15,17
embedcnt=1
