!set title=Cercle circonscrit 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!shuffle $val7,$val8,$val9

val10=$(tmp0)
tmp0=!listuniq $val10

val10=$(tmp0)
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]

!ifval $val11<3
tmp0=!shuffle Pierre,Paul,Olivier

val10=$(tmp0)
!endif
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val12=$(tmp0)

!ifval $val12=1
val13= $(val10[3])
!else
val13=$(val10[1])
!endif
tmp0=!shuffle $val10

val14=$(tmp0)
val15=On peut toujours tracer une droite passant par deux points distincts. Et bien moi,	  je te parie que j'arrive toujours à faire passer un cercle par trois points distincts

!ifval $val12=1
val16=$val15. 
!else
val16= $val15 non alignés.
!endif
choicename1=
choicegood1=$val13
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val10[1]) dit à $(val10[2])&nbsp;:	<div style="font-style:italic">$val16</div>	$(val10[2]) répond:	<div style="font-style:italic">	C'est impossible on ne peut jamais faire cela.</div>	$(val10[3]) qui écoutait leur conversation ajoute :	<div style="font-style:italic">	Cela dépend de la position des points.</div>	<p>	Qui a raison ?	</p>
$()
!exit

