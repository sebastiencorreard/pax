!else
val16=range 1.1,-0.1,1.2,-0.2	square 0.05,0,10,red	triangle 0,0,1,0,0,1,black	text black,-0.05,-0.05,medium,$val11	text black,-0.05,0.95,medium,$(val15[1])	text black,1.05,-0.05,medium,$(val15[2])
!endif
!endif
