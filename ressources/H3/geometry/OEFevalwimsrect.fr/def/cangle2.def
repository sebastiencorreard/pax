 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=est un triangle rectangle en
val8=à l'unité,au dixième,au centième
val9=Calculer la mesure de l'angle, arrondie 
tmp=!translate internal $	$ to ; in A,B,C	T,R,I	S,V,T	R,S,T	E,F,G

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!item 3 of $val10

val13=$(tmp0)
tmp0=!randint 5, 10

val14=$[rint($(tmp0))]
tmp0=!randint 11, 20

val15=$[rint($(tmp0))]
val16=<li>$val12$val13 = $val15 cm</li><li> $val11$val12 = $val14 cm</li>
val17=180/pi*arccos($val14/$val15)
tmp0=!shuffle $val12,$val13

val18=$(tmp0)
tmp0=!randint 4, 16

val19=$[$(tmp0)/10]
val20=$[sqrt(1-($val19-1)^2)]
val21=$[sqrt($val19^2+$val20^2)/0.1]
val22=$[sqrt((2-$val19)^2+$val20^2)/0.1]
val23=$[$val19-$val19/$val21]
val24=$[$val20-$val20/$val21]
val25=$[$val23+(2-$val19)/$val22]
val26=$[$val24-$val20/$val22]
val27=$[$val19+(2-$val19)/$val22]
val28=$[$val20-$val20/$val22]
val29=range -0.2,2.2,-0.2,1.2	segment $val23,$val24,$val25,$val26,red	segment $val25,$val26,$val27,$val28,red	triangle 0,0,2,0,$val19,$val20,black	text black,$val19,$val20+0.14,medium,$val11	text black,-0.05,0,medium,$(val18[1])	text black,2,0,medium,$(val18[2])
tmp0=!randint 0, 2

val30=$[rint($(tmp0))]
tmp0=!item $val30+1 of $val8

val31=$(tmp0)
val17=$[rint(($val17)*10^$val30)/10^$val30]
!if $val29!= 
!readproc oef/draw.phtml 240,140 \
$val29 
tmp0=$ins_url
val32=$(tmp0)
!endif
replytype1=numexp
replyname1=\(\widehat{$val11$val12$val13}\)
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

