!set title=Calcul d'angle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=Quelle touche de la calculette doit-on utiliser&nbsp;
val8=On désire calculer l'arrondi, de la mesure de l'angle aigu , vérifiant&nbsp;
val9=au degré,au dixième de degré,au centième de degré
tmp=!nonempty items A,B,C,D

tmp0=!randitem $tmp
val10=$(tmp0)
val10=\widehat{$val10}
val11=arccos(x)
val12=cos($val10)
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!randint 30, 70

val14=$[$(tmp0)/100]
tmp0=!randint 0, 2

val13=$[rint($(tmp0))]
tmp0=!item $val13+1 of $val9

val15=$(tmp0)
tmp0=!texmath $val14

val16=$(tmp0)
val17=<img src="$val1/cos.gif" alt="">,<img src="$val1/acos.gif" alt="">
replytype1=click
replyname1=
replygood1=2;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val8[1]) $val15 $(val8[2]) 
!insmath $val10
$() $(val8[3]):	<div class="wimscenter">	 
!insmath $val12 = $val16
$().	</div>	$val7?	<div class="wimscenter"> 
!read oef/embed.phtml r1,1 
$()  
!read oef/embed.phtml r1,2 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,12,15,16
embedcnt=2
