val6=Votre réponse&nbsp;
val7=est un triangle rectangle en
val8=à l'unité,au dixième,au centième
val9=Calculer la longueur du segment, arrondie
tmp=!translate internal $	$ to ; in A,B,C	T,R,I	S,V,T	R,S,T	E,F,G

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!item 3 of $val10

val13=$(tmp0)
val14=$val11$val13
tmp0=!randint 5, 15

val15=$[rint($(tmp0))]
tmp0=!randint 30, 70

val16=$[rint($(tmp0))]
val17=<li>$val12$val13 = $val15 cm</li><li>\(\widehat{$val11$val12$val13} = $val16^\circ)</li>
val18=$val15*sin($val16*pi/180)
tmp0=!shuffle $val12,$val13

val19=$(tmp0)
tmp0=!randint 4, 16

val20=$[$(tmp0)/10]
val21=$[sqrt(1-($val20-1)^2)]
val22=$[sqrt($val20^2+$val21^2)/0.1]
val23=$[sqrt((2-$val20)^2+$val21^2)/0.1]
val24=$[$val20-$val20/$val22]
val25=$[$val21-$val21/$val22]
val26=$[$val24+(2-$val20)/$val23]
val27=$[$val25-$val21/$val23]
val28=$[$val20+(2-$val20)/$val23]
val29=$[$val21-$val21/$val23]
val30=range -0.2,2.2,-0.2,1.2	segment $val24,$val25,$val26,$val27,red	segment $val26,$val27,$val28,$val29,red	triangle 0,0,2,0,$val20,$val21,black	text black,$val20,$val21+0.14,medium,$val11	text black,-0.05,0,medium,$(val19[1])	text black,2,0,medium,$(val19[2])
tmp0=!randint 0, 2

val31=$[rint($(tmp0))]
tmp0=!item $val31+1 of $val8

val32=$(tmp0)
val18=$[rint(($val18)*10^$val31)/10^$val31]
!if $val30!= 
!readproc oef/draw.phtml 240,140 \
$val30 
tmp0=$ins_url
val33=$(tmp0)
!endif
replytype1=numexp
replyname1=$val14
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

