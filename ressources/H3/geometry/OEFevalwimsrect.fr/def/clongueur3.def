val6=Votre réponse&nbsp;
val7=est un triangle rectangle en
val8=à l'unité,au dixième,au centième
val9=Calculer la longueur du segment, arrondie
tmp=!translate internal $	$ to ; in A,B,C	T,R,I	S,V,T	R,S,T	E,F,G

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!item 3 of $val10

val13=$(tmp0)
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
!if $val14=1 
val15=$val11$val12
tmp0=!randint 5, 15

val16=$[rint($(tmp0))]
tmp0=!randint 30, 70

val17=$[rint($(tmp0))]
val18=<li>$val12$val13 = $val16 cm</li><li>\(\widehat{$val11$val12$val13} = $val17^\circ)</li>
val19=$val16*cos($val17*pi/180)
!else
val15=$val12$val13
tmp0=!randint 5, 15

val16=$[rint($(tmp0))]
tmp0=!randint 30, 70

val17=$[rint($(tmp0))]
val18=<li>$val11$val12 = $val16 cm</li><li>\(\widehat{$val11$val12$val13} = $val17^\circ)</li>
val19=$val16/cos($val17*pi/180)
!endif
tmp0=!randint 0, 2

val14=$[rint($(tmp0))]
tmp0=!item $val14+1 of $val8

val20=$(tmp0)
val19=$[rint(($val19)*10^$val14)/10^$val14]
!if \dessin!= 
!readproc oef/draw.phtml 240,140 \
\dessin 
tmp0=$ins_url
val21=$(tmp0)
!endif
replytype1=numexp
replyname1=$val15
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

