val6=Votre réponse&nbsp;
val7=Cliquez sur la position du centre du cercle circonscrit	  au triangle rectangle ci-dessous&nbsp;
val8=$[rint(8)]
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
tmp0=!randint 3, 7

val11=$[rint(2*$(tmp0))]
tmp0=!randint 2, 7

val12=$[rint(2*$(tmp0)+1)]
tmp0=!shuffle $val11,$val12

val13=$(tmp0)
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
val15=$val9*20,$val10*20,($val9+$(val13[1]))*20,$val10*20,$val9*20,($val10+$(val13[2]))*20,$val9*20,$val10*20	(20-$val9)*20,$val10*20,(20-$val9-$(val13[1]))*20,$val10*20,(20-$val9)*20,($val10+$(val13[2]))*20,(20-$val9)*20-$val8,$val10*20	(20-$val9)*20,(20-$val10)*20,(20-$val9-$(val13[1]))*20,(20-$val10)*20,(20-$val9)*20,(20-$val10-$(val13[2]))*20,(20-$val9)*20-$val8,(20-$val10)*20-$val8	$val9*20,(20-$val10)*20,($val9+$(val13[1]))*20,(20-$val10)*20,$val9*20,(20-$val10-$(val13[2]))*20,$val9*20,(20-$val10)*20-$val8
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 7 to 8 of $val15

val16=$(tmp0)
tmp0=!item 1 to 6 of $val15

val15=$(tmp0)
!readproc oef/draw.phtml 400,400 \
parallel 0,0,0,400,20,0,21,grey	parallel 0,0,400,0,0,20,21,grey	fsquare $val16,$val8,red	linewidth 2	triangle $val15,black 
tmp0=$ins_url
val17=$(tmp0)
val18=$[rint(($(val15[3])+$(val15[5]))/2)]
val19=$[rint(($(val15[4])+$(val15[6]))/2)]
