!set title=Calcul 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=au dixième,au centième,au millième
val8=Utiliser la calculatrice pour donner l'arrondi, de
val9=cos
val10=\cos
val11=$val9(x)
tmp0=!texmath $val11

val12=$(tmp0)
tmp0=!randint 5, 85

val13=$(tmp0)
tmp0=!replace internal x by $val13^\circ in $val12

val14=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val15=$(tmp0)
tmp0=!randint 1, 3

val16=$[rint($(tmp0))]
tmp0=!item $val16 of $val7

val17=$(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val13*pi/180) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
val18=$[rint($val18*10^$val16)/10^$val16]
replytype1=numexp
replyname1=$val15
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val8[1]) $val17 $(val8[2]) :	<div class="wimscenter">	 <label for="reply1">
!insmath $val15 = $val14 = 
$()</label> 
!read oef/embed.phtml r1,6 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,14,15,17
embedcnt=1
