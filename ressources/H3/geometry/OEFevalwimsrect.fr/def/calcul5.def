!set title=Calcul 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=au dixième,au centième,au millième
val8=Utiliser la calculatrice pour donner l'arrondi, de
val9=cos
val10=\cos
tmp0=!randint 2, 9

val11=$(tmp0)
val12=$val9(x)*$val11
val13=$val10(x)\times$val11
tmp0=!randint 5, 85

val14=$(tmp0)
tmp0=!replace internal x by $val14^\circ in $val13

val15=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!randint 1, 3

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val7

val18=$(tmp0)
evaltmp=$val12

evaltmp=!mathsubst x=($val14*pi/180) in $evaltmp
tmp0=($evaltmp)
val19=$[$(tmp0)]
val19=$[rint($val19*10^$val17)/10^$val17]
replytype1=numexp
replyname1=$val16
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val8[1]) $val18 $(val8[2]) :	<div class="wimscenter">	 <label for="reply1">
!insmath $val16 = $val15 = 
$()</label> 
!read oef/embed.phtml r1,6 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,15,16,18
embedcnt=1
