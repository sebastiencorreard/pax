!set title=Formule 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=Compléter l'égalité suivante 
val8=est un triangle rectangle en
val9=Côté adjacent à,Hypoténuse,Côté opposé à 
val10=180x30x1
tmp=!translate internal $	$ to ; in A,B,C	T,R,I	S,V,T	R,S,T	E,F,G

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$(tmp0)
tmp0=!item 2 of $val11

val13=$(tmp0)
tmp0=!item 3 of $val11

val14=$(tmp0)
val15=\(\cos(\widehat{$val12$val13$val14}))
val16=$(val9[1]) \(\widehat{$val12$val13$val14}\)
val17=$(val9[2])
val18=$(val9[3]) \(\widehat{$val12$val13$val14}\)
val19=$val12$val13$val14 $val8 $val12.
replytype1=clickfill
replyname1=Numérateur
replygood1=$val16;$val18,$val15
replytype2=clickfill
replyname2=Dénominateur
replygood2=$val17;$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 
!if $m_dessin!= 
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$m_image" alt=""></div>	 <div class="medium_size text_col">	 
!endif
$()	 $val19	 $val7:	<table class="wimscenter wimsnoborder">	  <tr>	  <td rowspan="3">$val15</td>	  <td rowspan="3"> = </td>	  <td> 
!read oef/embed.phtml reply1,$val10 
$()</td>	  </tr>	  <tr><td><hr></td></tr>	  <tr>	  <td> 
!read oef/embed.phtml reply2,$val10 
$()</td>	  </tr>	 </table>	 
!if $m_dessin!= 
$()</div></div> 
!endif
$()	
$()
!exit

