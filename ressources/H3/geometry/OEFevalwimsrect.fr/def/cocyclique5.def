!set title=Points d'un cercle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=est un point du cercle de diamètre,distinct de, et
val8=Quelle est la mesure en degrés de l'angle
tmp0=!shuffle A,B,C,D,E,F,G,H,R,S,T

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
val12=$(val9[3])
tmp=!nonempty items $val11,$val12

tmp0=!randitem $tmp
val13=$(tmp0)
replytype1=numexp
replyname1=
replygood1=90
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10 $(val7[1]) [$val11$val12] $(val7[2]) $val11 $(val7[3]) $val12.	<p>	$val8 
!insmath \widehat{$val11$val10$val12}
$() ?	</p>	<b>$val6</b>:	<label for="reply1">
!insmath \widehat{$val11$val10$val12} =
$()</label>	 
!read oef/embed.phtml r1,5 
$()°
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,11,12
embedcnt=1
