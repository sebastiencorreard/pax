!set title=Calcul 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=au dixième,au centième,au millième
val8=Il faut calculer l'arrondi, du cosinus d'un angle de,degrés.,	  Quelle touche de la calculatrice doit-on utiliser&nbsp;
val7=au dixième,au centième,au millième
tmp0=!randint 5, 85

val9=$(tmp0)
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val7

val11=$(tmp0)
val12=<img src="$val1/cos.gif" alt="">,<img src="$val1/acos.gif" alt="">
replytype1=click
replyname1=
replygood1=1;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val8[1]) $val11 $(val8[2]) $val9 $(val8[3])	<p>$(val8[4])?</p>	<div class="wimscenter">	 
!read oef/embed.phtml r1,1 
$()&nbsp; 
!read oef/embed.phtml r1,2 
$()</div>
$()
!exit

