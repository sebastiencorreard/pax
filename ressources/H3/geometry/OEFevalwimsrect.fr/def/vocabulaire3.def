!set title=Vocabulaire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Votre réponse&nbsp;
val7=est un triangle rectangle en
val8=Quelle est l'hypoténuse de ce triangle
val9=80x30x1
tmp=!translate internal $	$ to ; in A,B,C	T,R,I	S,V,T	R,S,T	E,F,G

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!item 3 of $val10

val13=$(tmp0)
val14=$val8
val15=\([$val12$val13])
val16=
val17=\([$val12$val13]),\([$val11$val13]),\([$val11$val12])
!if $val16!= 
!readproc oef/draw.phtml 240,140 \
$val16 
tmp0=$ins_url
val18=$(tmp0)
!endif
replytype1=dragfill
replyname1=Réponse
replygood1=$val15;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val16!= 
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val18" alt=""></div>	 <div class="medium_size text_col">	 
!endif
$()	  $val11$val12$val13 $val7 $val11.	  <p>$val14 ?</p>	<b>Votre réponse</b> :  
!read oef/embed.phtml r1,$val9 
$()	
!if $val16!= 
$() </div></div> 
!endif
$()	
$()
!exit

