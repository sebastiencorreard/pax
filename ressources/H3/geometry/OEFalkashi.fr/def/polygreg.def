!set title=Côté d'un polygône régulier.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
precision=100

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 5,7,8,9,10,11,12

val6=$[rint($(tmp0))]
tmp0=!item $val6 of ,,,,penta,,hepta,octo,ennéa,déca,hendéca,dodéca

val7=$(tmp0)
tmp0=!nospace $val7 gone

val7=$(tmp0)
tmp0=!randint 3, 10

val8=$[rint($(tmp0))]
val9=$[sqrt(2*($val8)^2*(1-cos(2*Pi/$val6)))]
replytype1=numeric
replyoption1=absolute 
replyname1=Longueur d'un côté arrondie au centième
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On veut construire un $val7 régulier inscrit dans un cercle de rayon $val8 cm.	<br>Faites un schéma et calculer la longueur des côtés de cette figure.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=0
