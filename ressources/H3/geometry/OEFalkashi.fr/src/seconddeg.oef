\title{Côté d'un triangle (plus difficile).}
\author{Paul,Byache}
\email{paul@byache.fr}

\precision{100}


\text{alphabet=shuffle(A,B,C,D,E,F)}
\text{A=item(1,\alphabet)}
\text{B=item(2,\alphabet)}
\text{C=item(3,\alphabet)}
\text{truc=random(\A\B\C,\B\A\C,\C\A\B)}

#dans cet exercice, le théorème d'al kashi mène à une équation du second degré. 
#les données ci-dessous sont choisies pour qu'on ait (presque) autant de "delta" positif, que de négatif, que de nul
#data : angle,b,c,delta,sol1
\text{data=randomrow(60,1,1,1,2
60,3,4,-12,3
30,2,4,0,1
30,1,2,0,1
30,2,2,12,2
30,1,3,-5,3
45,3,4,4,2
45,2,3,-2,3)}
\integer{ang=item(1,\data)}
\real{b=item(2,\data)}
\real{c=item(3,\data)}
\real{delta=item(4,\data)}
\integer{sol1=item(5,\data)}


\text{nstep=\sol1=3 ? reply1 } 
\text{nstep=\sol1=1 ? reply1 
reply2 }
\text{nstep=\sol1=2? reply1 
reply3}
\steps{ \nstep }

\real{sol2=(2*\c*cos(\ang/180*Pi)+sqrt(\delta))/2}
\real{sol3=(2*\c*cos(\ang/180*Pi)-sqrt(\delta))/2}

\statement{On veut construire un triangle \truc tel que :
<ul><li>\A\B = \c cm</li><li>\A\C = \b cm</li><li>\(\widehat{\A\B\C} = \ang)°</li></ul>
\if{\step=1}{En utilisant le théorème d'Al Kashi, on peut voir si un tel triangle existe ou non. Choisissez la bonne réponse : \embed{r1}.}
\if{\step=2}{Calculer la longueur du côté \B\C (arrondir au centième).
\if{\sol1=2}{Donner les deux possibilités, séparées par une virgule.}}
}
\answer{Nombre de solutions :}{\sol1;il y a une seule possibilité, il existe deux possibilités, c'est impossible !}{type=menu}
\answer{Longueur du 3e côté arr. au centième}{\sol2}{type=numeric}{option=absolute}
\answer{Les 2 possibilités sép. par 1 virg.}{\sol2,\sol3}{type=aset}{option=absolute}
