\title{Côté d'un polygône régulier.}
\author{Paul,Byache}
\email{paul@byache.fr}

\precision{100}

\integer{nbre=random(5,7,8,9,10,11,12)}
\text{truc=item(\nbre,,,,,penta,,hepta,octo,ennéa,déca,hendéca,dodéca)}
\text{truc=wims(nospace \truc gone)}

\integer{ray=randint(3..10)}

\real{sol=sqrt(2*(\ray)^2*(1-cos(2*Pi/\nbre)))}

\statement{On veut construire un \truc régulier inscrit dans un cercle de rayon \ray cm.
<br>Faites un schéma et calculer la longueur des côtés de cette figure.}

\answer{Longueur d'un côté arrondie au centième}{\sol}{type=numeric}{option=absolute}
