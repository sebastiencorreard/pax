\title{12. Calculer un angle connaissant deux côtés d'un triangle rectangle}

\author{Euler,Versailles}
%%%CK GM %%%
\language{\lang}
\email{euler.wims@ac-versailles.fr}
\format{html}
\computeanswer{no}

\if{\lang=fr}{



\keywords{cosinus,sinus,tangent}


\credits{Figure(s) réalisée(s) avec JSXGraph}
}

























\description{Vous devez calculer la mesure en degrés arrondie à l'unité de l’angle considéré d’un triangle rectangle dont on connait les longueurs de deux côtés.}
\observation{Dans cette ressource, un triangle rectangle et sa représentation graphique sont donnés ainsi que les 
longueurs de deux de ses côtés. 
Il est demandé de donner la mesure en degrés de l’angle considéré arrondie à l’unité.}

