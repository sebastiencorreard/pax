\title{06. Associer lignes trigonométriques et quotients}

\author{Euler,Versailles}
%%%CK GM %%%
\language{\lang}
\email{euler.wims@ac-versailles.fr}
\format{html}
\computeanswer{no}

\if{\lang=fr}{



\keywords{cosinus,sinus,tangent}


\credits{Figure(s) réalisée(s) avec JSXGraph}
}













\description{Vous devez associer l'étiquette de chaque ligne trigonométrique d’un angle donné du triangle rectangle 
avec le quotient correspondant.}
\observation{Dans cette ressource, un triangle rectangle et sa représentation graphique sont donnés.   
Il est demandé d’associer les trois lignes trigonométriques de l’angle aigu considéré à chaque quotient 
correspondant.}













