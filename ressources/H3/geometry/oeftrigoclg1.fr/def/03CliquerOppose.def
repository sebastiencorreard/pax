oefcss= <style> .indication{ font-weight:bold;color:#009999; margin-bottom: 0.8em; margin-top: 0.8em; } .quest{ color:blue; font-weight:bold; margin:0; } .ui-accordion .ui-accordion-content{ padding-left:1em; padding-right:1em; } </style> 

