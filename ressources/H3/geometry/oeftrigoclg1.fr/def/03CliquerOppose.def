Color:'black',fillColor:'#0000FF',fillOpacity:1});	brd500.create('angle',[A,C,B],{name:' ',radius:0.7,strokeColor:'black',fillColor:'#993300',fillOpacity:1});	brd500.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: 'white',highlightfillColor:'grey'});	 
