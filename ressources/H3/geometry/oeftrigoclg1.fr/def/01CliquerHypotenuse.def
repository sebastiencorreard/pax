!set title=01. Sélectionner l'hypoténuse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Euler,Versailles
email=euler.wims@ac-versailles.fr
keywords=hypoténuse
computeanswer=no
oefdescription=Vous devez cliquer sur l’hypoténuse du triangle rectangle donné.
oefobservation=Dans cette ressource, un triangle rectangle et sa représentation graphique sont donnés. Il est demandé de cliquer sur le segment qui en est l'hypoténuse.
oefcss= <style> .indication{ font-weight:bold;color:#009999; margin-bottom: 0.8em; margin-top: 0.8em; } .quest{ color:blue; font-weight:bold; margin:0; } .ui-accordion .ui-accordion-content{ padding-left:1em; padding-right:1em; } </style> 

