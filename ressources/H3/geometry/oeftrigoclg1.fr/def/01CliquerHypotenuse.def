varcnt=81
prevarcnt=68
postvarcnt=12
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=4
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
credits=Figure(s) réalisée(s) avec JSXGraph
!endif
val7=AIL,AIR,AME,AMI,ARC,ART,BAC,BAL,BAM,BAS,BEC,BIP,BIS,BLE,BOA,BOL,BON,BUS,BUT,BZH,CAP,CAR,CIL,	CLE,COL,COR,COU,CRI,CRU,DIX,DON,DOS,DRU,DUO,DUR,EAU,EST,FAC,FAR,FAT,FER,FEU,FIL,FIN,FOL,FOU,FUT,GAI,GEL,	GUI,ILE,INF,IRE,JET,JEU,JUS,LAC,LET,LIN,LIT,LOI,LOT,LUI,LYS,MAI,MAL,MAT,MER,MIE,MIL,MOI,MON,MOT,MOU,MUR,	NEF,NEZ,OUI,PAF,PAS,PEU,PIC,PIE,PIN,PLI,POC,POF,PRO,PUR,RAP,RAS,RAZ,RIA,RIO,RIZ,ROC,ROI,RUE,SAC,SEC,SEL,	SET,SIX,SOC,SOL,SON,SOU,SPI,SUD,SUP,SUR,TAC,TAS,TER,THE,TIC,TIR,TOC,TOI,TON,TRI,UNE,UNI,VAL,VAN,VER,VIE,	VIS,VUE,YEN,ZEN	
tmp=!nonempty items $val7

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!char 1 of $val8

val9=$(tmp0)
tmp0=!char 2 of $val8

val10=$(tmp0)
tmp0=!char 3 of $val8

val11=$(tmp0)
val12=$val9,$val10,$val11
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=$(val12[$val13])
tmp0=!listcomplement $val14 in $val12

val15=$(tmp0)
val16=[B,C]
val17=[A,B]
val18=[A,C]
val19=[$(val15[1])$(val15[2])]
val20=[$val14$(val15[1])]
val21=[$val14$(val15[2])]
tmp0=!randint 0, 255

val22=$[rint($(tmp0))]
tmp0=!randint 0, 255

val23=$[rint($(tmp0))]
tmp0=!randint 0, 255

val24=$[rint($(tmp0))]
val25=rgb($val22,$val23,$val24)
tmp0=!randint 10, 90

val26=$[$(tmp0)/10]
tmp0=!randint 10, 90

val27=$[$(tmp0)/10]
tmp0=!random 0, 6.28

val28=$[$(tmp0)]
val29=$[Pi/2+$val28]
val30=$[$val26*cos($val28)]
val31=$[$val26*sin($val28)]
val32=$[$val27*cos($val29)]
val33=$[$val27*sin($val29)]
val34=$[min(1,min($val26/6,$val27/6))]
val35=$[round(10*sqrt($val26^2+$val27^2))/10]
tmp0=!replace internal . by , in $val26

val36=$(tmp0)
tmp0=!replace internal . by , in $val27

val37=$(tmp0)
val38=$[min(min(0,$val30),$val32)-1.5]
val39=$[max(max(0,$val30),$val32)+1.5]
val40=$[min(min(0,$val31),$val33)-1.5]
val41=$[max(max(0,$val31),$val33)+1.5]
val42=$[rint(250)]

!ifval $val39-$val38 > $val41-$val40
val43=$[$val42/($val39-$val38)]
!else
val43=$[$val42/($val41-$val40)]
!endif
val44=$[rint((($val39-$val38)*$val43))]
val45=$[rint((($val41-$val40)*$val43))]
val46=le sinus,le cosinus,la tangente
val47=du côté opposé,du côté opposé à l'angle,du côté adjacent,du côté adjacent à l'angle,de l'hypoténuse
val48=Vous avez répondu&nbsp;:
val49=Nous avons&nbsp;:
val50=Votre réponse est exacte.
val51=Votre réponse est fausse.
val52=Votre réponse est incomplète.
val53=Votre réponse est partiellement exacte.
val54=Réponse exacte&nbsp;:
val55=var brd = JXG.JSXGraph.initBoard('jsxenonce', {showCopyright : false,axis:false,boundingbox: [$val38,$val41,$val39,$val40],grid:false});
val56=var brd = JXG.JSXGraph.initBoard('jsxsol', {showCopyright : false,axis:false, boundingbox: [$val38,$val41,$val39,$val40],grid:false});
val57=A=brd.create('point',[0,0],{name:'$val14',face:'x',size:3,color:'$val25',fixed:true,showInfobox:false,label:{fixed: false}});	B=brd.create('point',[$val30,$val31],{name:'$(val15[1])',face:'x',size:3,color:'$val25',fixed:true,showInfobox:false,label:{fixed: false}});	C=brd.create('point',[$val32,$val33],{name:'$(val15[2])',face:'x',size:3,color:'$val25',fixed:true,showInfobox:false,label:{fixed: false}});	brd.create('angle',[B,A,C],{name:' ',radius:$val34,strokeColor:'black',fillColor:'red',fillOpacity:0.8});	brd.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: '$val25',highlightfillColor:'$val25'});	hypo=brd.create('segment',[B,C]);	cat1=brd.create('segment',[A,B]);	cat2=brd.create('segment',[A,C]);		
val58=hypo.setAttribute({strokeWidth:5,color:'green'})
!readproc slib/geo2D/jsxgraph jsxsol,$val44 x $val45,$val56 $val57 $val58 
tmp0=$slib_out
val59=$(tmp0)
val60=
val61=$val9$val10$val11 est un triangle rectangle en <span class="nowrap">$val14.</span>
val49=Sélectionner son hypoténuse.
val62=Identifier son hypoténuse.
val63=Comment sélectionner un objet ?
val64=Un clic sur un objet sélectionne l'objet&nbsp;; un nouveau clic sur le même objet annule la sélection.	<p>Une fois la sélection voulue effectuée, cliquer sur "Envoyer la réponse".</p>
val65=<p>Par définition, l'hypoténuse d'un triangle rectangle est le côté opposé à l'angle droit.</p>	<p>Ici, $val9$val10$val11 est un triangle rectangle en $val14&nbsp;: le sommet de l'angle droit du	triangle est le point $val14.</p>	<p>Son côté opposé, appelé hypoténuse,  est le segment	 <span class="nowrap"><span class="oef_indgood">[$(val15[1])$(val15[2])]</span>.</span>	</p>		
val66=Vous avez sélectionné le côté <span class="oef_indgood">$val19</span>. C'est bien		l'hypoténuse du triangle <span class="nowrap">$val9$val10$val11</span> rectangle en <span class="nowrap">$val14.</span>		
val67=Vous avez sélectionné le côté <span class="oef_indbad">$val20</span>. C'est		un côté de l'angle droit&nbsp;!		
val68=Vous avez sélectionné le côté <span class="oef_indbad">$val21</span>. C'est		un côté de l'angle droit&nbsp;!		
val69=Vous avez sélectionné plusieurs segments&nbsp;!
val70=L'hypoténuse		du triangle <span class="nowrap">$val9$val10$val11</span> rectangle en $val14 est le côté	<span class="nowrap oef_indgood">$val19</span>.
val71=Par définition, l'hypoténuse d'un triangle rectangle est le côté opposé à son angle droit.
replytype1=jsxgraphobjet

replyoption1= 
replyname1=
replygood1=hypo;cat1|cat2
