!readproc slib/geo2D/jsxgraph jsxhint,$val36 x $val36,	var brd500 = JXG.JSXGraph.initBoard('jsxhint', {showCopyright:false,showNavigation:false,axis:false,	 boundingbox: [-6,8,4,-2],grid:false});	A=brd500.create('point',[0,0],{name:'A',face:'x',size:3,color:'red',fixed:true,showInfobox:false,	label:{offset:[4,-8],color:'red'}});	B=brd500.create('point',[1.1557766,6.7010582],{name:'B',face:'x',size:3,color:'#0000FF',fixed:true,showInfobox:false,	label:{offset:[4,4],color:'#0000FF'}});	C=brd500.create('point',[-4.9272486,0.84983571],{name:'C',face:'x',size:3,color:'#993300',fixed:true,showInfobox:false,	label:{offset:[-12,-10],color:'#993300'}});	Hyp=brd500.create('point',[-3.2,5],{name:'$val42',face:'x',size:0,color:'white',fixed:true,showInfobox:false,	label:{offset:[-15,-15],color:'#FF0000'}});	AdjB1=brd500.create('point',[1.5,5.1],{name:'$val43',face:'x',size:0,color:'white',fixed:true,showInfobox:false,	label:{offset:[-15,-15],color:'#0000FF'}});	AdjB2=brd500.create('point',[1.5,4.4],{name:'$val45 \(\widehat{ABC}\)',face:'x',size:0,color:'white',fixed:true,showInfobox:false,	label:{offset:[-15,-15],color:'#0000FF'}});	OppB1=brd500.create('point',[-4.2,0.4],{name:'$val44 $val45 \(\widehat{ABC}\)',face:'x',size:0,color:'white',	fixed:true,showInfobox:false,label:{offset:[-15,-15],color:'#0000FF'}});	OppC1=brd500.create('point',[1.2,2.8],{name:'$val44',face:'x',size:0,color:'white',fixed:true,	showInfobox:false,label:{offset:[-15,-15],color:'#993300'}});	OppC2=brd500.create('point',[1.2,2.1],{name:'$val45 \(\widehat{ACB}\)',face:'x',size:0,color:'white',fixed:true,	showInfobox:false,label:{offset:[-15,-15],color:'#993300'}});	AdjC1=brd500.create('point',[-4.2,-0.5],{name:'$val43 $val45 \(\widehat{ACB}\)',face:'x',size:0,color:'white',	fixed:true,showInfobox:false,label:{offset:[-15,-15],color:'#993300'}});		brd500.create('angle',[B,A,C],{name:' ',radius:0.5,strokeColor:'red',fillColor:'red',fillOpacity:0.8});	brd500.create('angle',[C,B,A],{name:' ',radius:0.7,strokeColor:'black',fillColor:'#0000FF',fillOpacity:1});	brd500.create('angle',[A,C,B],{name:' ',radius:0.7,strokeColor:'black',fillColor:'#993300',fillOpacity:1});	brd500.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: 'white',highlightfillColor:'grey'});	 
tmp0=$slib_out
