val43=côté adjacent
val44=côté opposé
val45=à
val46=le sinus,le cosinus,la tangente
val47=du côté opposé,du côté opposé à l'angle,du côté adjacent,du côté adjacent à l'angle,de l'hypoténuse
val48=Vous avez répondu&nbsp;:
val49=Nous avons&nbsp;:
val50=Votre réponse est exacte.
val51=Votre réponse est fausse.
val52=Votre réponse est incomplète.
val53=Votre réponse est partiellement exacte.
val54=Réponse exacte&nbsp;:
tmp=!trim \(sin(\widehat{$val40})\)	\(cos(\widehat{$val40})\)	\(tan(\widehat{$val40})\)	
val55=!translate internal $	\
$ to ;; in $tmp
tmp=!trim \(\frac{$val14$(val15[2])}{$(val15[1])$(val15[2])}\)	\(\frac{$val14$(val15[1])}{$(val15[1])$(val15[2])}\)	\(\frac{$val14$(val15[2])}{$val14$(val15[1])}\)	
val56=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val55

tmp0=!rowcnt $tmp
val57=$[rint($(tmp0))]
tmp0=!shuffle $val57

val58=$(tmp0)
val59=$(val55[$(val58[1]);]),	$(val55[$(val58[2]);]),	$(val55[$(val58[3]);]),	
val60=$(val56[$(val58[1]);]),	$(val56[$(val58[2]);]),	$(val56[$(val58[3]);]),	
val61=<p><span class="nowrap"> $val9$val10$val11 </span> est un triangle rectangle en $val14.</p>	<p><span class="quest">Associer les nombres égaux.</span></p>	
val62=<p><span class="nowrap"> $val9$val10$val11 </span> est un triangle rectangle en $val14.</p>	Reconnaître le <strong>cosinus</strong>, le <strong>sinus</strong> et la <strong>tangente</strong> de l'angle 	<span class="nowrap">\(\widehat{$val40}\).</span>	
val63=Comment relier deux cases&nbsp;?
val64=Comprendre les codes couleurs
val65=<ul class="euler_ul"> 	 <li>Pour relier deux cases&nbsp;:	  <ul class="euler_ul">	    <li>cliquer sur l'une puis sur l'autre,</li>	    <li>ou déplacer l'une sur l'autre.</li>	  </ul>	  La case de droite vient alors à la hauteur de la case de gauche et une flèche apparaît.	  <li>Pour modifier une liaison déjà établie, utiliser les mêmes méthodes.</li>	</ul>	
val66=<ul class="euler_ul">	  <li>Couleur de fond et du liseré&nbsp;:</li>	    <ul class="euler_ul">	      <li>vert : la réponse est entièrement exacte,</li>	      <li>orange : la réponse est partiellement exacte,</li>	      <li>rouge : la réponse est entièrement fausse.</li>	    </ul>	  <li>Couleur des étiquettes de la colonne de droite&nbsp;:</li>	    <ul class="euler_ul">	      <li>vert : la correspondance est exacte,</li>	      <li>rose : la correspondance est fausse.</li>	    </ul>	</ul>	
val67=Définition
val68=Application
val69=longueur du côté opposé à l'angle
val70=longueur du côté adjacent à l'angle
val71=longueur de l'hypoténuse
val72=var brd = JXG.JSXGraph.initBoard('jsxenonce', {showCopyright : false,axis:false,boundingbox: [$val32,$val35,$val33,$val34],grid:false});
val73=var brd = JXG.JSXGraph.initBoard('jsxsol', {showCopyright : false,axis:false, boundingbox: [$val32,$val35,$val33,$val34],grid:false});
val74=A=brd.create('point',[0,0],{name:'$val14',face:'x',size:3,color:'$val19',fixed:true,showInfobox:false,label:{fixed: false}});	B=brd.create('point',[$val24,$val25],{name:'$(val15[1])',face:'x',size:3,color:'$val19',fixed:true,showInfobox:false,label:{fixed: false}});	C=brd.create('point',[$val26,$val27],{name:'$(val15[2])',face:'x',size:3,color:'$val19',fixed:true,showInfobox:false,label:{fixed: false}});	brd.create('angle',[B,A,C],{name:' ',radius:$val28,strokeColor:'black',fillColor:'red',fillOpacity:0.8});	brd.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: '$val19',highlightfillColor:'$val19'});	hypo=brd.create('segment',[B,C]);	cat1=brd.create('segment',[A,B]);	cat2=brd.create('segment',[A,C]);		brd.create('angle',[C,B,A],{name:' ',radius:$val28,strokeColor:'black',fillColor:'$val19',fillOpacity:1});		
!readproc slib/geo2D/jsxgraph jsxenonce,$val38 x $val39,$val72 $val74 
tmp0=$slib_out
