!set title=06. Associer lignes trigonométriques et quotients
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Euler,Versailles
email=euler.wims@ac-versailles.fr
keywords=cosinus,sinus,tangent
computeanswer=no
oefdescription=Vous devez associer l'étiquette de chaque ligne trigonométrique d’un angle donné du triangle rectangle avec le quotient correspondant.
oefobservation=Dans cette ressource, un triangle rectangle et sa représentation graphique sont donnés. Il est demandé d’associer les trois lignes trigonométriques de l’angle aigu considéré à chaque quotient correspondant.
oefcss= <style> .indication{ font-weight:bold;color:#009999; margin-bottom: 0.8em; margin-top: 0.8em; } .quest{ color:blue; font-weight:bold; margin:0; } .ui-accordion .ui-accordion-content{ padding-left:1em; padding-right:1em; } table.tabSol td { border:solid 1px; padding:0.3em; } table.tabSol th { border:solid 1px; background-color:#CEE3F6; color:#2609AB; } table.tabSol th.vide { border: none; background: none; } table.tabSol tr:nth-child(2n+3) { background-color:#EFF5FB; } </style> 

