credits=Figure(s) réalisée(s) avec JSXGraph
!endif
val7=AIL,AIR,AME,AMI,ARC,ART,BAC,BAL,BAM,BAS,BEC,BIP,BIS,BLE,BOA,BOL,BON,BUS,BUT,BZH,CAP,CAR,CIL,	CLE,COL,COR,COU,CRI,CRU,DIX,DON,DOS,DRU,DUO,DUR,EAU,EST,FAC,FAR,FAT,FER,FEU,FIL,FIN,FOL,FOU,FUT,GAI,GEL,	GUI,ILE,INF,IRE,JET,JEU,JUS,LAC,LET,LIN,LIT,LOI,LOT,LUI,LYS,MAI,MAL,MAT,MER,MIE,MIL,MOI,MON,MOT,MOU,MUR,	NEF,NEZ,OUI,PAF,PAS,PEU,PIC,PIE,PIN,PLI,POC,POF,PRO,PUR,RAP,RAS,RAZ,RIA,RIO,RIZ,ROC,ROI,RUE,SAC,SEC,SEL,	SET,SIX,SOC,SOL,SON,SOU,SPI,SUD,SUP,SUR,TAC,TAS,TER,THE,TIC,TIR,TOC,TOI,TON,TRI,UNE,UNI,VAL,VAN,VER,VIE,	VIS,VUE,YEN,ZEN	
tmp=!nonempty items $val7

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!char 1 of $val8

val9=$(tmp0)
tmp0=!char 2 of $val8

val10=$(tmp0)
tmp0=!char 3 of $val8

val11=$(tmp0)
val12=$val9,$val10,$val11
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=$(val12[$val13])
tmp0=!listcomplement $val14 in $val12

val15=$(tmp0)
tmp0=!randint 0, 255

val16=$[rint($(tmp0))]
tmp0=!randint 0, 255

val17=$[rint($(tmp0))]
tmp0=!randint 0, 255

val18=$[rint($(tmp0))]
val19=rgb($val16,$val17,$val18)
tmp0=!randint 10, 90

val20=$[$(tmp0)/10]
tmp0=!randint 10, 90

val21=$[$(tmp0)/10]
tmp0=!random 0, 6.28

val22=$[$(tmp0)]
val23=$[Pi/2+$val22]
val24=$[$val20*cos($val22)]
val25=$[$val20*sin($val22)]
val26=$[$val21*cos($val23)]
val27=$[$val21*sin($val23)]
val28=$[min(1,min($val20/6,$val21/6))]
val29=$[round(10*sqrt($val20^2+$val21^2))/10]
tmp0=!replace internal . by , in $val20

val30=$(tmp0)
tmp0=!replace internal . by , in $val21

val31=$(tmp0)
val32=$[min(min(0,$val24),$val26)-1.5]
val33=$[max(max(0,$val24),$val26)+1.5]
val34=$[min(min(0,$val25),$val27)-1.5]
val35=$[max(max(0,$val25),$val27)+1.5]
val36=$[rint(250)]

!ifval $val33-$val32 > $val35-$val34
val37=$[$val36/($val33-$val32)]
!else
val37=$[$val36/($val35-$val34)]
!endif
val38=$[rint((($val33-$val32)*$val37))]
val39=$[rint((($val35-$val34)*$val37))]
tmp0=!randitem 1,2


!ifval $(tmp0)=1
val40=$val14$(val15[1])$(val15[2])
!else
val40=$(val15[2])$(val15[1])$val14
!endif
tmp0=!randitem 1,2


!ifval $(tmp0)=1
val41=$val14$(val15[2])$(val15[1])
!else
val41=$(val15[1])$(val15[2])$val14
!endif
