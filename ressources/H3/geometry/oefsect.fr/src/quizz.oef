\title{Quizz sections planes}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{1000}


\real{e=0.5}
\text{listsol=cube,parallélépipède rectangle,cône de révolution,cylindre de révolution}
\text{listsect=carré,rectangle,parallèlogramme,disque,triangle}

\matrix{don=1,parallèle à une face,1
1,parallèle à une arète,2
2,parallèle à une face,2
2,parallèle à une arète,2
3,parallèle à la base,4
4,parallèle à la base,4
4,parallèle à l'axe du cylindre,2}

\text{list=randrow(\don)}
\integer{ch=item(1,\list)}
\text{solide=item(\ch,\listsol)}
\text{plan=item(2,\list)}
\text{good=item(item(3,\list),\listsect)}
\text{bad=\listsect}

\if{\ch<3}{
\if{\ch=1}{
\integer{l=200}
\integer{h=200}
\integer{p=100}}{
\integer{l=300}
\integer{h=150}
\integer{p=100}}
\integer{x=\l+\p}
\integer{y=\h+\p}
\text{dessin=segment 20,20+\e*\p,20,(\h+\p)*\e+20,black
segment 20,(\h+\p)*\e+20,20+\l*\e,(\h+\p)*\e+20,black
segment 20+\l*\e,(\h+\p)*\e+20,20+\l*\e,20+\e*\p,black
segment 20+\l*\e,20+\e*\p,20,20+\e*\p,black
segment 20,20+\e*\p,20+\e*\p,20,black
dsegment 20,(\h+\p)*\e+20,20+\e*\p,20+\h*\e,black
segment 20+\l*\e,(\p+\h)*\e+20,(\l+\p)*\e+20,20+\h*\e,black
segment 20+\l*\e,20+\e*\p,(\l+\p)*\e+20,20,black
segment 20+\e*\p,20,(\p+\l)*\e+20,20,black
dsegment 20+\e*\p,20+\h*\e,(\l+\p)*\e+20,20+\h*\e,black
dsegment 20+\e*\p,20,20+\e*\p,20+\h*\e,black
segment (\l+\p)*\e+20,20,(\l+\p)*\e+20,20+\h*\e,black}}

\if{\ch=3}{
\integer{l=150}
\integer{h=250}
\integer{p=50}
\integer{x=\l*2}
\integer{y=\h+\p}
\text{dessin=arc 20+\l*\e,20+\h*\e,2*\l*\e,\p*\e,0,180,black
arc 20+\l*\e,20+\h*\e,2*\l*\e,\p*\e,180,360,green
segment 20+\l*\e,20,20,20+\h*\e,black
segment 20+\l*\e,20,20+2*\l*\e,20+\h*\e,black}}

\if{\ch=4}{
\integer{l=150}
\integer{h=250}
\integer{p=50}
\integer{x=\l*2}
\integer{y=\h+\p}
\text{dessin=arc 20+\l*\e,\p*\e+20+\h*\e,2*\l*\e,\p*\e,0,180,black
arc 20+\l*\e,\p*\e+20+\h*\e,2*\l*\e,\p*\e,180,360,green
ellipse 20+\l*\e,\p*\e+20,2*\l*\e,\p*\e,black
segment 20,\p*\e+20,20,\p*\e+20+\h*\e,black
segment 20+2*\l*\e,\p*\e+20,20+2*\l*\e,\p*\e+20+\h*\e,black}}


\statement{Quelle est la nature de la section plane obtenue en coupant
un \solide par un plan \plan ?
<div class="wimscenter">
\draw{40+\e*\x,40+\e*\y}{\dessin}
</div>}

\choice{Réponse}{\good}{\bad}
