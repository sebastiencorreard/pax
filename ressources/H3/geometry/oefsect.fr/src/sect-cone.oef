\title{Section d'un cône}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{e=.6}
\integer{l=random(100..200)}
\integer{h=random(200..350)}
\integer{p=\l/2}
\integer{x=\l*2}
\integer{y=\h+\p}
\text{dessin=arc 20+\l*\e,20+\h*\e,2*\l*\e,\p*\e,0,180,black
arc 20+\l*\e,20+\h*\e,2*\l*\e,\p*\e,180,360,green
dsegment 20+\l*\e,20+\h*\e,20,20+\h*\e,black
dsegment 20+\l*\e,20+\h*\e,20+\l*\e,20,black
segment 20+\l*\e,20,20,20+\h*\e,black
segment 20+\l*\e,20,20+2*\l*\e,20+\h*\e,black
text black,20+\l*\e,5,medium,S
text black,20+\l*\e,20+\h*\e,medium,O}

\integer{a=random(\h/3..2*\h/3)}
\integer{b=\l*\a/\h}
\integer{c=\p*\a/\h}

\text{dessin=\dessin
arc 20+\l*\e,20+\a*\e,2*\b*\e,\c*\e,0,180,black
arc 20+\l*\e,20+\a*\e,2*\b*\e,\c*\e,180,360,green
dsegment 20+\l*\e,20+\a*\e,20+(\l-\b)*\e,20+\a*\e,black
text black,25+\l*\e,15+\a*\e,medium,C}

\integer{rep1=\l*\a/\h*10}
\real{rep1=\rep1/10}
\integer{rep2=(\l*\a/\h)^2*pi*100}
\real{rep2=\rep2/100}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\draw{40+\e*\x,40+\e*\y}{\dessin}</div>
 <div class="medium_size text_col">\(\mathcal{S}) est un cône de révolution dont le sommet est S et la base est un disque de centre O et de rayon \l cm. On sait que OS mesure \h cm.<br>
On coupe ce cône par un plan parallèle à sa base et qui passe par le point C. SC mesure \a cm. Calculer le rayon de la section plane obtenue ainsi que son aire.
<div class="wims_instruction">
Les réponses doivent être données au \(mm) près pour les longueurs et au \(mm^2) près pour les aires.
</div>
</div></div>
}

\answer{Rayon}{\rep1 cm}{type=units}
\answer{Aire}{\rep2 cm^2}{type=units}
