!set title=Agrandissement-Réduction (aire)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items cm,dm,m,mm,dam

tmp0=!randitem $tmp
val6=$(tmp0)
val7=une pyramide, un cône, un cylindre
val8=deux pyramides, deux cônes, deux cylindres
val9=obtenue,obtenu,obtenu
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val7

val7=$(tmp0)
tmp0=!item $val10 of $val9

val9=$(tmp0)
tmp0=!item $val10 of $val8

val8=$(tmp0)
tmp0=!randint 120, 1000

val11=$[rint($(tmp0))]
val11=$[$val11/10]
tmp0=!randint 1, 50

val12=$[rint($(tmp0))]
val12=$[$val12/10]
val6=\($val6 ^2)
val13=$[rint(2)]
val14=$[$val11*($val12)^2]
tmp=!trim \(\mathcal{C}_1) est $val7 dont la base a une aire de $val11 $val6. \(\mathcal{C}_2) est $val9 en multipliant les longueurs de \(\mathcal{C}_1) par $val12. Quelle est l'aire de la base de \(\mathcal{C}_2)	\(\mathcal{C}_1) est $val7. \(\mathcal{C}_2) est $val9 en multipliant les longueurs de \(\mathcal{C}_1) par $val12. L'aire de la base de \(\mathcal{C}_2) est de $val14 $val6. Quelle est l'aire de la base de \(\mathcal{C}_1)	\(\mathcal{C}_1) et \(\mathcal{C}_2) sont $val8 dont les dimensions sont proportionnelles. L'aire de la base de \(\mathcal{C}_1) est de $val11 $val6 et l'aire de la base de \(\mathcal{C}_2) est de $val14 $val6. Quel est le coefficient qui permet d'obtenir les dimensions de \(\mathcal{C}_2) en fonction de celles de \(\mathcal{C}_1) 
val15=!translate internal $	\
$ to ;; in $tmp
val16=$val14,$val11,$val12
val17=$val6,$val6,
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val16

val16=$[$(tmp0)]
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item $val10 of $val17

val17=$(tmp0)
!if $val10<3 
val18=reply 1
!else
val18=reply 2
!endif
oefsteps=$val18 
nextstep=!nosubst $val18 
!readproc oef/steps.proc
replytype1=units
replyname1=Réponse
replygood1=$val16 $val6
replytype2=auto

replyname2=Réponse
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val15 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=0
