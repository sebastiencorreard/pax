!set title=Section d'un cône
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(.6)]
tmp0=!randint 100, 200

val7=$[rint($(tmp0))]
tmp0=!randint 200, 350

val8=$[rint($(tmp0))]
val9=$[rint($val7/2)]
val10=$[rint($val7*2)]
val11=$[rint($val8+$val9)]
val12=arc 20+$val7*$val6,20+$val8*$val6,2*$val7*$val6,$val9*$val6,0,180,black	arc 20+$val7*$val6,20+$val8*$val6,2*$val7*$val6,$val9*$val6,180,360,green	dsegment 20+$val7*$val6,20+$val8*$val6,20,20+$val8*$val6,black	dsegment 20+$val7*$val6,20+$val8*$val6,20+$val7*$val6,20,black	segment 20+$val7*$val6,20,20,20+$val8*$val6,black	segment 20+$val7*$val6,20,20+2*$val7*$val6,20+$val8*$val6,black	text black,20+$val7*$val6,5,medium,S	text black,20+$val7*$val6,20+$val8*$val6,medium,O
tmp0=!randint $val8/3, 2*$val8/3

val13=$[rint($(tmp0))]
val14=$[rint($val7*$val13/$val8)]
val15=$[rint($val9*$val13/$val8)]
val12=$val12	arc 20+$val7*$val6,20+$val13*$val6,2*$val14*$val6,$val15*$val6,0,180,black	arc 20+$val7*$val6,20+$val13*$val6,2*$val14*$val6,$val15*$val6,180,360,green	dsegment 20+$val7*$val6,20+$val13*$val6,20+($val7-$val14)*$val6,20+$val13*$val6,black	text black,25+$val7*$val6,15+$val13*$val6,medium,C
val16=$[rint($val7*$val13/$val8*10)]
val16=$[$val16/10]
val17=$[rint(($val7*$val13/$val8)^2*pi*100)]
val17=$[$val17/100]
replytype1=units
replyname1=Rayon
replygood1=$val16 cm
replytype2=units
replyname2=Aire
replygood2=$val17 cm^2
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 40+$val6*$val10,40+$val6*$val11 \
$val12 
$()</div>	 <div class="medium_size text_col">
!insmath \mathcal{S}
$() est un cône de révolution dont le sommet est S et la base est un disque de centre O et de rayon $val7 cm. On sait que OS mesure $val8 cm.<br>	On coupe ce cône par un plan parallèle à sa base et qui passe par le point C. SC mesure $val13 cm. Calculer le rayon de la section plane obtenue ainsi que son aire.	<div class="wims_instruction">	Les réponses doivent être données au 
!insmath mm
$() près pour les longueurs et au 
!insmath mm^2
$() près pour les aires.	</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,11,12,13
embedcnt=0
