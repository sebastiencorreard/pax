!endif

val6=$[0.5]
val7=cube,parallélépipède rectangle,cône de révolution,cylindre de révolution
val8=carré,rectangle,parallèlogramme,disque,triangle
tmp=!trim 1,parallèle à une face,1	1,parallèle à une arète,2	2,parallèle à une face,2	2,parallèle à une arète,2	3,parallèle à la base,4	4,parallèle à la base,4	4,parallèle à l'axe du cylindre,2
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$[rint($(tmp0))]
tmp0=!item $val11 of $val7

val12=$(tmp0)
tmp0=!item 2 of $val10

val13=$(tmp0)
tmp0=!item 3 of $val10

tmp1=!item $(tmp0) of $val8

val14=$(tmp1)
val15=$val8
!if $val11<3 
!if $val11=1 
val16=$[rint(200)]
val17=$[rint(200)]
val18=$[rint(100)]
!else
val16=$[rint(300)]
val17=$[rint(150)]
val18=$[rint(100)]
!endif
val19=$[rint($val16+$val18)]
val20=$[rint($val17+$val18)]
val21=segment 20,20+$val6*$val18,20,($val17+$val18)*$val6+20,black	segment 20,($val17+$val18)*$val6+20,20+$val16*$val6,($val17+$val18)*$val6+20,black	segment 20+$val16*$val6,($val17+$val18)*$val6+20,20+$val16*$val6,20+$val6*$val18,black	segment 20+$val16*$val6,20+$val6*$val18,20,20+$val6*$val18,black	segment 20,20+$val6*$val18,20+$val6*$val18,20,black	dsegment 20,($val17+$val18)*$val6+20,20+$val6*$val18,20+$val17*$val6,black	segment 20+$val16*$val6,($val18+$val17)*$val6+20,($val16+$val18)*$val6+20,20+$val17*$val6,black	segment 20+$val16*$val6,20+$val6*$val18,($val16+$val18)*$val6+20,20,black	segment 20+$val6*$val18,20,($val18+$val16)*$val6+20,20,black	dsegment 20+$val6*$val18,20+$val17*$val6,($val16+$val18)*$val6+20,20+$val17*$val6,black	dsegment 20+$val6*$val18,20,20+$val6*$val18,20+$val17*$val6,black	segment ($val16+$val18)*$val6+20,20,($val16+$val18)*$val6+20,20+$val17*$val6,black
!endif
!if $val11=3 
val16=$[rint(150)]
val17=$[rint(250)]
val18=$[rint(50)]
val19=$[rint($val16*2)]
val20=$[rint($val17+$val18)]
val21=arc 20+$val16*$val6,20+$val17*$val6,2*$val16*$val6,$val18*$val6,0,180,black	arc 20+$val16*$val6,20+$val17*$val6,2*$val16*$val6,$val18*$val6,180,360,green	segment 20+$val16*$val6,20,20,20+$val17*$val6,black	segment 20+$val16*$val6,20,20+2*$val16*$val6,20+$val17*$val6,black
!endif
!if $val11=4 
val16=$[rint(150)]
val17=$[rint(250)]
val18=$[rint(50)]
val19=$[rint($val16*2)]
val20=$[rint($val17+$val18)]
val21=arc 20+$val16*$val6,$val18*$val6+20+$val17*$val6,2*$val16*$val6,$val18*$val6,0,180,black	arc 20+$val16*$val6,$val18*$val6+20+$val17*$val6,2*$val16*$val6,$val18*$val6,180,360,green	ellipse 20+$val16*$val6,$val18*$val6+20,2*$val16*$val6,$val18*$val6,black	segment 20,$val18*$val6+20,20,$val18*$val6+20+$val17*$val6,black	segment 20+2*$val16*$val6,$val18*$val6+20,20+2*$val16*$val6,$val18*$val6+20+$val17*$val6,black
!endif
