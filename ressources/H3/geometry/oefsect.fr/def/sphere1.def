!set title=Section d'une sphère (rayon section)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim R,r,C,O	a,b,I,J	r,d,O,K
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
tmp0=!randint 2, 6

val11=$[rint($(tmp0))]
tmp0=!randint 1, $val11-1

val12=$[rint($(tmp0))]
val13=$[rint(max($val11^2-$val12^2,2*$val11*$val12))]
val14=$[rint(min($val11^2-$val12^2,2*$val11*$val12))]
val15=$[rint(($val14^2+$val13^2)^(1/2))]
tmp0=!randint 15, 25

val16=$[$(tmp0)/10]
val17=$[$val13*$val16]
val18=$[$val15*$val16]
val19=$[$val14*$val16]
val20=Sachant que \($val7 = $val18 cm) et \($val10$val9 = $val19 cm) calculer \($val8)
val21=$[$val17]
val22=circle 170,170,300,black	dsegment 170,170,320,170,black	dsegment 170,170,170,20,black	text black,231,155,medium,$val7	text black,156,163,medium,$val10	arc 170,170,300,75,0,180,black	arc 170,170,300,75,180,360,green	dsegment 170,70,282,70,black	text black,226,55,medium,$val8	arc 170,70,224,40,0,180,black	arc 170,70,224,40,180,360,green	text black,156,63,medium,$val9
replytype1=units
replyname1=Reponse
replygood1=$val21 cm
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath \mathcal{S}
$() est une sphère de centre 
!insmath $val10
$() et de rayon 
!insmath $val7
$().<br>	On coupe cette sphère par un plan. La section plane obtenue est un cercle de centre 
!insmath $val9
$()	et de rayon 
!insmath $val8
$().<br>	$val20.	<div class="wimscenter"> 
!read oef/draw.phtml 340,340 \
$val22 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,20,22
embedcnt=0
