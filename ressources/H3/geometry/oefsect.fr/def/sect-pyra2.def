!set title=Meuble de forme pyramidale 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(.8)]
tmp0=!randint 80, 130

val7=$[rint($(tmp0))]
tmp0=!randint 150, 250

val8=$[rint($(tmp0))]
tmp0=!randint 150, 250

val9=$[rint($(tmp0))]
val10=$[.5]
val11=$[rint(max($val9,$val7))]
val12=$[rint($val8+max($val7*$val10,$val9*$val10))]
val13=segment 20,20,20,20+$val8*$val6,black	segment 20,20+$val8*$val6,20+$val7*$val6,20+($val8+$val7*$val10)*$val6,black	dsegment 20,20+$val8*$val6,20+$val9*$val6,20+($val8-$val9*$val10)*$val6,black	segment 20+$val7*$val6,20+($val8+$val7*$val10)*$val6,20+$val9*$val6,20+($val8-$val9*$val10)*$val6,black	segment 20,20,20+$val7*$val6,20+($val8+$val7*$val10)*$val6,black	segment 20,20,20+$val9*$val6,20+($val8-$val9*$val10)*$val6,black	text black,5,15,medium,A	text black,5,15+$val8*$val6,medium,B	text black,20+$val7*$val6,20+($val8+$val7*$val10)*$val6,medium,C	text black,20+$val9*$val6,20+($val8-$val9*$val10)*$val6,medium,D
tmp0=!randint $val8/3, 2*$val8/3

val14=$[rint($(tmp0))]
val15=$[rint($val14/$val8*$val7)]
val16=$[rint($val14/$val8*$val9)]
val13=$val13	segment 20,20+$val14*$val6,20+$val15*$val6,20+($val14+$val15*$val10)*$val6,red	dsegment 20,20+$val14*$val6,20+$val16*$val6,20+($val14-$val16*$val10)*$val6,red	segment 20+$val15*$val6,20+($val14+$val15*$val10)*$val6,20+$val16*$val6,20+($val14-$val16*$val10)*$val6,red	text black,5,15+$val14*$val6,medium,E	text black,20+$val16*$val6,($val14-$val16*$val10)*$val6,medium,F	text black,10+$val15*$val6,20+($val14+$val15*$val10)*$val6,medium,G
val17=$[rint($val14/$val8*$val7*10)]
val17=$[$val17/10]
val18=$[rint($val14/$val8*$val9*10)]
val18=$[$val18/10]
tmp0=!randint $val7/3, 2*$val7/3

val19=$[rint($(tmp0))]
val20=$[rint($val19*$val8/$val7*10)]
val20=$[$val20/10]
oefsteps=reply 1, reply 2	reply3 
nextstep=!nosubst reply 1, reply 2	reply3 
!readproc oef/steps.proc
replytype1=units
replyname1=EG
replygood1=$val17 cm
replytype2=units
replyname2=EF
replygood2=$val18 cm
replytype3=units
replyname3=AE
replygood3=$val20 cm
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 40+$val6*$val11,40+$val6*$val12 \
$val13 
$()</div>	 <div class="medium_size text_col">	Un meuble dont la forme est une pyramide se trouve dans l'angle d'une pièce	dont les murs forment un angle droit. La base du meuble est un triangle rectangle en B.	Les dimensions du meuble sont les suivantes :	<ul>	<li> AB=$val8 cm.</li>	<li> BC=$val7 cm.</li>	<li> BD=$val9 cm.</li>	</ul>		<b>Question 1.</b> On décide de placer une étagère triangulaire dans ce meuble	représentée en rouge sur le dessin. Cette étagère est un triangle rectangle en E.	De plus, elle ne doit pas dépasser du meuble : c'est-à-dire que les points A, G et C sont alignés	et les points A, F et D le sont aussi. On veut placer l'étagère à une distance de AE=$val14 cm	du sommet du meuble. Calculer les dimensions des côtés EG et EF de l'étagère au 
!insmath mm
$() près.	
!if $m_step=2 
$()	<span class="oef_indgood">Réponses</span>: EG=$val17 cm et EF=$val18 cm. 
!endif
$()		
!if $m_step=2 
$()<b>Question 2.</b> Avec le meuble, le vendeur a fourni une étagère	dont la dimension du côté EG est $val19 cm. A quelle distance du sommet	du meuble faut-il la placer? Donner une valeur au 
!insmath mm
$() près. 
!endif
$()	 </div>	</div>	
$()
!exit

