val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 200, 300

val6=$[rint($(tmp0))]
val7=$[rint($val6)]
val8=$[rint($val6/2)]
val9=$[rint($val8+$val7)]
val10=$[rint($val8+$val6)]
val11=$[0.5]
val12=segment 20,20+$val11*$val8,20,($val6+$val8)*$val11+20,black	segment 20,($val6+$val8)*$val11+20,20+$val7*$val11,($val6+$val8)*$val11+20,black	segment 20+$val7*$val11,($val6+$val8)*$val11+20,20+$val7*$val11,20+$val11*$val8,black	segment 20+$val7*$val11,20+$val11*$val8,20,20+$val11*$val8,black	segment 20,20+$val11*$val8,20+$val11*$val8,20,red	dsegment 20,($val6+$val8)*$val11+20,20+$val11*$val8,20+$val6*$val11,black	segment 20+$val7*$val11,($val8+$val6)*$val11+20,($val7+$val8)*$val11+20,20+$val6*$val11,black	segment 20+$val7*$val11,20+$val11*$val8,($val7+$val8)*$val11+20,20,black	segment 20+$val11*$val8,20,($val8+$val7)*$val11+20,20,black	dsegment 20+$val11*$val8,20+$val6*$val11,($val7+$val8)*$val11+20,20+$val6*$val11,black	dsegment 20+$val11*$val8,20,20+$val11*$val8,20+$val6*$val11,black	segment ($val7+$val8)*$val11+20,20,($val7+$val8)*$val11+20,20+$val6*$val11,black	text black,10,10+$val8*$val11,medium,A	text black,10+$val8*$val11,10,medium,B	text black,30+($val8+$val7)*$val11,10,medium,C	text black,30+$val7*$val11,10+$val8*$val11,medium,D	text black,10,10+($val8+$val6)*$val11,medium,E	text black,10+$val8*$val11,10+$val6*$val11,medium,F	text black,30+($val8+$val7)*$val11,10+$val6*$val11,medium,G	text black,30+$val7*$val11,10+($val8+$val6)*$val11,medium,H
tmp0=!randint $val7/3, $val7

val13=$[rint($(tmp0))]

!ifval $val13>2*$val7/3
val13=$[rint($val7)]
!endif
!if $val13<>$val7 
val14=dsegment
val15=ABJI
val16=Sachant que \(EI=$val13 cm), calculer
val17=text red,10+$val13*$val11,20+($val8+$val6)*$val11,medium,I	text red,20+($val8+$val13)*$val11,5+$val6*$val11,medium,J
!else
val14=segment
val17=
val15=ABGH
val16=Calculer
!endif
val12=$val12	segment 20,20+$val11*$val8,20+$val13*$val11,20+($val8+$val6)*$val11,red	$val14 20+$val13*$val11,20+($val8+$val6)*$val11,20+($val13+$val8)*$val11,20+$val6*$val11,red	dsegment 20+($val13+$val8)*$val11,20+$val6*$val11,20+$val8*$val11,20,red	$val17 
val18=$[rint((($val13)^2+($val6)^2)^(1/2)*10)]
val18=$[$val18/10]
val19=$[min($val18,$val7)]
val20=$[max($val18,$val7)]
val21=$[rint((($val13)^2+($val6)^2)^(1/2)*$val7*100)]
val21=$[$val21/100]
replytype1=units
replyname1=Longueur
replygood1=$val20 cm
replytype2=units
replyname2=Largeur
replygood2=$val19 cm
replytype3=units
replyname3=Aire
replygood3=$val21 cm^2
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

