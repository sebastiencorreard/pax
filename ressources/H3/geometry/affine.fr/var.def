
# Variable declaration file.
#
# Only those variables with possible user inputs or requiring inter-request
# savings need to be declared in this file.
#
#Each non-comment line defines a variable. Format of the line:
#
#name	allow
#
#name: name of the variable
#allow: when allow the user to override the defined value.
#       it maybe any, deny, init, config, reply.
#
#
#name	allow

deny:status error droite dessin dessin1 dessin2 dessinsol border equation \
 equationlin eq_tex mode

init: mode1 coeff type x_size xsize1 xsize2 ysize2 yy_size xx_size inssize
reply:click_x click_y

deny: insdraw_size a b A B pente ord liste liste_c  click_cnt erreur miss\
  incert module_score err

any:reply_cnt
