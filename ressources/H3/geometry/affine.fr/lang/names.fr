!set lang_exists=yes

!set name_intro=est un exercice sur la représentation graphique d'une fonction linéaire \
  ou affine. Il demande de tracer la représentation graphique d'une fonction

!set name1= une formule
!set name2= son coefficient directeur et une valeur
!set name3= !nosubst son coefficient directeur $a et la valeur d'un antécédent
!set name4= la fonction linéaire associée et une valeur
!set name5=  la fonction linéaire associée et la valeur d'un antécédent

!distribute lines Cliquer sur un point de la droite\
 Cliquer sur un deuxième point de la droite\
 Les points sont trop proches. Recommencez.\
into name_clickpoint,name_clickpoint2,name_msg

!distribute lines affine,linéaire\
  entiers, rationnels, décimaux\
  donnée par\
  Les coefficients sont \
into name_intro_afflin, name_typenumber,name_givenby,name_coefficienttype


!distribute lines Tracer la représentation graphique de la fonction \
  Tracer la représentation graphique de la fonction affine \
  dont la fonction linéaire associée est\
  Pour cela, cliquer successivement sur deux points distants de la droite.\
into name_rep,name_traceraffine,name_lineaireassoc,name_clicktwopoints

!set name_direct=!nosubst de coefficient directeur $a et telle que l'image de $A par \(f\) soit $B.
!set name_indirect=de coefficient directeur $a et telle que l'antécédent de $B par \(f\) soit $A.
!set name_applindir=!nosubst et telle que l'image de $A par \(f\) soit $B.
!set name_applinante=!nosubst et telle que l'antécédent de $B par \(f\) soit $A.

!distribute lines Bravo pour cette très bonne réponse.\
  Votre réponse est en rouge, la bonne réponse est en vert.\
  Un des points n'est pas du tout sur la droite.\
  Aucun des deux points n'est sur la droite.\
  La droite tracée est cependant presque parallèle à la droite demandée.\
  La droite tracée a cependant la bonne ordonnée à l'origine.\
  La représentation graphique d'une fonction linéaire passe toujours par l'origine. \
into name_answergood,name_redgreen,name_outline,name_nopoints, name_parallel,\
  name_ordonnee,name_origin

!set name_score=!nosubst Vous avez obtenu $module_score (sur 10) points pour cette réponse.
