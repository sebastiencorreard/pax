!set lang_exists=yes
!set name_intro=è un gioco/esercizio visuale. Ti presento due immagini,\
  una iniziale e l'altra dopo la rotazione sul piano. Devi trovare il\
  centro della rotazione e indicarlo cliccando sull'immagine.

!distribute lines Scegli il livello di difficoltà:\
  Numero massimo di possibilità in ogni sessione\
  il punteggio ti sarà dato alla fine della sessione).\
  Qui sotto puoi vedere la tua risposta e il reale punto di rotazione.\
  rosso,figura originale\
  verde,figura ruotata\
  dove hai cliccato,il reale centro di rotazione\
  Precisione media di questa sessione\
  Continua con un nuovo tentativo\
  Inizia una nuova sessione\
  Riconfigura il gioco\
  voto\
  Riassunto dei tentativi della sessione.\
into name_introlevel, name_introcount, name_introscore,\
  name_answer,name_red,name_green,name_answer2,name_ecart2,\
  name_next,name_again, name_configure, name_score,name_resume

!set name_present=Sono rappresentate due figure con due colori differenti.\
  Una è ottenuta dalla rotazione dell'altra nel piano.\
  Trova il centro di questa rotazione.

!set name_consigne=Per rispondere: clicca sulla figura, nel punto che ritieni esatto.

!set name_ecart=!nosubst Precisione della risposta (tentativo numero $reply_cnt di $shoots)

!set name_end=!nosubst Fine della sessione con $reply_cnt colpi. Precisione media

!set name_help=Il centro di rotazione ha eguale distanza da un punto e dalla sua immagine
