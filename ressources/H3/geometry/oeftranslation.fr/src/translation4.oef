\title{Roues translatées}
\language{fr}
\range{-5..5}
\author{Yaméogo Joachim}
\email{yameogo@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}


#cadre du dessin
\integer{r=5}
\integer{h=100*(\r)}

##couleur des grilles
\text{gridcolor=lightblue}

##les rayons de la roue
\integer{d2=random(50..150)}
\integer{borng=\d2-20}
\integer{bornd=\d2-10}
\integer{d1=random(\borng..\bornd)}
\real{r1=(\d1)/50}
\real{r2=(\d2)/50}

##constantes de rotation
\real{a=(sqrt(3))/2}
\real{b=1/2}

\text{rot1=1,0,0,1}
\text{rot2=-1,0,0,-1}
\text{rot3=0,-1,1,0}
\text{rot4=0,1,-1,0}
\matrix{matrots=\rot1
\rot2
\rot3
\rot4
}

##points de suture
\text{spt1=(\r1)*(\a),(-\r1)*(\b)}
\text{spt2=0,\r1}
\text{spt3=(-\r1)*(\a),(-\r1)*(\b)}

##centres des roues
\integer{x1=random(-7,-6,-5)}
\integer{x2=random(-3,-2,-1)}
\integer{x3=random(1,2,3)}
\integer{x4=random(5,6,7)}

\integer{y1=random(-7..7)}
\integer{y2=random(-7..7)}
\integer{y3=random(-7..7)}
\integer{y4=random(-7..7)}

##couleurs possibles pour les roues
\text{color1=blue}
\text{color2=green}
\text{color3=orange}
\text{color4=black}

##permutations
\text{permrots=shuffle(4)}
\text{aff1=item(1,\permrots)}
\text{aff2=item(2,\permrots)}
\text{aff3=item(3,\permrots)}
\text{aff4=\aff1}


\text{permrots=shuffle(\aff1,\aff2,\aff3,\aff4)}
\text{rposits=position(\aff1,\permrots)}
\text{rposi1=item(1,\rposits)}
\text{rposi2=item(2,\rposits)}

\text{aff1=item(1,\permrots)}
\text{aff2=item(2,\permrots)}
\text{aff3=item(3,\permrots)}
\text{aff4=item(4,\permrots)}

\text{aff1=\matrots[\aff1;]}
\text{aff2=\matrots[\aff2;]}
\text{aff3=\matrots[\aff3;]}
\text{aff4=\matrots[\aff4;]}

\text{permcolor=shuffle(\color1,\color2,\color3,\color4)}
\text{coul1=item(1,\permcolor)}
\text{coul2=item(2,\permcolor)}
\text{coul3=item(3,\permcolor)}
\text{coul4=item(4,\permcolor)}

\text{rcolor1=item(\rposi1,\permcolor)}
\text{rcolor2=item(\rposi2,\permcolor)}


\text{rcolor1=\rcolor1 iswordof blue?bleue}
\text{rcolor1=\rcolor1 iswordof green?verte}
\text{rcolor1=\rcolor1 iswordof black?noire}

\text{rcolor2=\rcolor2 iswordof blue?bleue}
\text{rcolor2=\rcolor2 iswordof green?verte}
\text{rcolor2=\rcolor2 iswordof black?noire}

\text{colorList=bleue et verte,bleue et orange,bleue et noire,verte et orange,verte et noire,orange et noire}

\text{phrase=\rcolor1 et \rcolor2}

\text{phrase=(\rcolor1 iswordof verte ) and (\rcolor2 iswordof bleue)?\rcolor2 et \rcolor1}
\text{phrase=(\rcolor1 iswordof orange) and (\rcolor2 iswordof bleue)?\rcolor2 et \rcolor1}
\text{phrase=(\rcolor1 iswordof noire ) and (\rcolor2 iswordof bleue)?\rcolor2 et \rcolor1}
\text{phrase=(\rcolor1 iswordof orange) and (\rcolor2 iswordof verte)?\rcolor2 et \rcolor1}
\text{phrase=(\rcolor1 iswordof noire ) and (\rcolor2 iswordof verte)?\rcolor2 et \rcolor1}
\text{phrase=(\rcolor1 iswordof noire ) and (\rcolor2 iswordof orange)?\rcolor2 et \rcolor1}

\text{rep=position(\phrase,\colorList)}


####### enoncé de l'exo ######
\statement{
<div style="width:75%">
      Dans le plan muni d'un repère orthonormé \((O,i,j)\), on considère les
      quatres roues suivantes. Deux de ces roues se déduisent l'une de l'autre
      par une translation. Dites lesquelles.
 </div>
<p style="text-align:center">
\draw{\h,\h}{xrange -10,10
yrange -10,10

gridfill 0,0,10,10,\gridcolor

linewidth 2

affine \aff1,\x1,\y1
circle 0,0,\d1,\coul1
circle 0,0,\d2,\coul1
segment 0,0,\spt1,\coul1
segment 0,0,\spt2,\coul1
segment 0,0,\spt3,\coul1
killaffine

affine \aff2,\x2,\y2
circle 0,0,\d1,\coul2
circle 0,0,\d2,\coul2
segment 0,0,\spt1,\coul2
segment 0,0,\spt2,\coul2
segment 0,0,\spt3,\coul2
killaffine

affine \aff3,\x3,\y3
circle 0,0,\d1,\coul3
circle 0,0,\d2,\coul3
segment 0,0,\spt1,\coul3
segment 0,0,\spt2,\coul3
segment 0,0,\spt3,\coul3
killaffine

affine \aff4,\x4,\y4
circle 0,0,\d1,\coul4
circle 0,0,\d2,\coul4
segment 0,0,\spt1,\coul4
segment 0,0,\spt2,\coul4
segment 0,0,\spt3,\coul4
killaffine


translate 0.2,0.2


vline 2,0,\gridcolor
vline 4,0,\gridcolor
vline 6,0,\gridcolor
vline 8,0,\gridcolor
vline 10,0,\gridcolor
vline -2,0,\gridcolor
vline -4,0,\gridcolor
vline -6,0,\gridcolor
vline -8,0,\gridcolor
vline -10,0,\gridcolor
hline 0,2,\gridcolor
hline 0,4,\gridcolor
hline 0,6,\gridcolor
hline 0,8,\gridcolor
hline 0,10,\gridcolor
hline 0,-2,\gridcolor
hline 0,-4,\gridcolor
hline 0,-6,\gridcolor
hline 0,-8,\gridcolor
hline 0,-10,\gridcolor

vline 0,0,black
hline 0,0,black

arrow 0,0,2,0,10,magenta
arrow 0,0,0,2,10,magenta

text red,1,-0.2,medium,i
text red,-0.4,1,medium,j
text black,-0.3,-0.2,medim,O

text red,1.975,-9.80,small,1
text red,3.975,-9.80,small,2
text red,5.975,-9.80,small,3
text red,7.975,-9.80,small,4

text red,-2.30,-9.80,small,-1
text red,-4.30,-9.80,small,-2
text red,-6.30,-9.80,small,-3
text red,-8.30,-9.80,small,-4

text red,-10.2,-7.80,small,-4
text red,-10.2,-5.80,small,-3
text red,-10.2,-3.80,small,-2
text red,-10.2,-1.80,small,-1


text red,-10,2.35,small,1
text red,-10,4.35,small,2
text red,-10,6.35,small,3
text red,-10,8.35,small,4
}
</p>

}
\answer{CHOIX:}{\rep;\colorList}{type=radio}
