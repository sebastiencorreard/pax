\title{Cercles translatés}
\language{fr}
\range{-5..5}
\author{Yaméogo Joachim}
\email{yameogo@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}


##cadre du dessin
\integer{r=5}
\integer{h=100*(\r)}

##couleur des grilles
\text{gridcolor=lightblue}

##le diamètre du disque
\integer{l=random(12..75)}
\integer{born=2*(\r)-2-floor((\l)/25)}
\integer{d=2*(\l)}

##choix aléatoire du centre du disque
\integer{x1=random(-(\born)..(\born))}
\integer{y1=random(-(\born)..(\born))}


##contruction du translaté du premier disque
###conditions pour que le translaté reste dans le cadre
\integer{minx=\x1-1-floor((\l)/25)}
\integer{maxx=\x1+1+floor((\l)/25)}

\integer{miny=\y1-1-floor((\l)/25)}
\integer{maxy=\y1+1+floor((\l)/25)}

\integer{mintx=-(\born)-\minx}
\integer{maxtx=(\born)-\maxx}

\integer{minty=-(\born)-\miny}
\integer{maxty=(\born)-\maxy}

###contruction d'un vecteur de translation non nul
\integer{tx=random(\mintx..\maxtx)}
\integer{ty=random(\minty..\maxty)}
\integer{tx=\tx=\ty and \tx=0?\maxtx}
\integer{tx=\tx=\ty and \tx=0?\mintx}

###le translaté du centre
\integer{p1=\x1+\tx}
\integer{q1=\y1+\ty}

##la bonne réponse à soumettre
\real{reptx=\tx/2}
\real{repty=\ty/2}
\text{bonrep=\reptx,\repty}

##champ de la réponse
\text{rep=\((a,b)\)}

####### enoncé de l'exo #######
\statement{
<div style="width:75%">
      Dans le plan muni d'un repère orthonormé \((O,i,j)\), une translation de
      vecteur \(v=a i+b j\) transforme le cercle bleu en le cercle vert.
      Donner les coordonnées \((a,b)\) du vecteur de translation \(v\).
</div>

<p style="text-align:center">
\draw{500,500}{xrange -10,10
yrange -10,10

gridfill 0,0,10,10,\gridcolor

translate 0.2,0.2

linewidth 2

vline 2,0,\gridcolor
vline 4,0,\gridcolor
vline 6,0,\gridcolor
vline 8,0,\gridcolor
vline 10,0,\gridcolor
vline -2,0,\gridcolor
vline -4,0,\gridcolor
vline -6,0,\gridcolor
vline -8,0,\gridcolor
vline -10,0,\gridcolor
hline 0,2,\gridcolor
hline 0,4,\gridcolor
hline 0,6,\gridcolor
hline 0,8,\gridcolor
hline 0,10,\gridcolor
hline 0,-2,\gridcolor
hline 0,-4,\gridcolor
hline 0,-6,\gridcolor
hline 0,-8,\gridcolor
hline 0,-10,\gridcolor

vline 0,0,black
hline 0,0,black

circle \x1,\y1,\d,darkblue
circle \p1,\q1,\d,green

arrow 0,0,2,0,10,magenta
arrow 0,0,0,2,10,magenta

text red,1,-0.2,medium,i
text red,-0.4,1,medium,j
text black,-0.3,-0.2,medim,O

text red,1.975,-9.80,small,1
text red,3.975,-9.80,small,2
text red,5.975,-9.80,small,3
text red,7.975,-9.80,small,4

text red,-2.30,-9.80,small,-1
text red,-4.30,-9.80,small,-2
text red,-6.30,-9.80,small,-3
text red,-8.30,-9.80,small,-4

text red,-10.2,-7.80,small,-4
text red,-10.2,-5.80,small,-3
text red,-10.2,-3.80,small,-2
text red,-10.2,-1.80,small,-1


text red,-10,2.35,small,1
text red,-10,4.35,small,2
text red,-10,6.35,small,3
text red,-10,8.35,small,4
}
</p>

}

#### soumission de réponse ####
\answer{\rep}{\bonrep}{type=vector}
