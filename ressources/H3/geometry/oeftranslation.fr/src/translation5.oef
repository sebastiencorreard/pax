\title{Une translation pour deux symétries}
\language{fr}
\range{-5..5}
\author{Yaméogo Joachim}
\email{yameogo@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}


##cadre du dessin
\integer{r=5}
\integer{h=100*(\r)}

##couleur des grilles
\text{gridcolor=lightblue}

##choix aléatoire d'un sommet de triangle
\integer{r1=\r-1}
\integer{x1=random(-2*(\r1)..2*(\r1))}
\integer{y1=random(-2*(\r1)..2*(\r1))}

##construction de deux vecteurs libres adhéquats
###bornes des vecteurs
\integer{bgx=-2*(\r1)-(\x1)}
\integer{bdx=2*(\r1)-(\x1)}
\integer{bgy=-2*(\r1)-(\y1)}
\integer{bdy=2*(\r1)-(\y1)}
###choix du premier vecteur, on s'assure que ux est non nul
\integer{ux=random(\bgx..\bdx)}
\integer{ux=\ux=0?\bdx}
\integer{ux=\ux=0?\bgx}
\integer{uy=random(\bgy..\bdy)}
###choix du deuxième vecteur
\integer{vx=random(\bgx..\bdx)}
\integer{vy=random(\bgy..\bdy)}
###on s'assure que les vecteurs sont libres
\integer{vy=(\ux*\vy)-(\uy*\vx)=0?\vy+1}

##coordonnées des 2 autres sommets du premier triangle
\integer{x2=\x1+\ux}
\integer{y2=\y1+\uy}
\integer{x3=\x1+\vx}
\integer{y3=\y1+\vy}

##la bonne réponse
\real{xap=(\x1)+((\x3)-(\x2))/2}
\real{yap=(\y1)+((\y3)-(\y2))/2}
\text{bonrep=\xap/2,\yap/2}

##champ de la réponse
\text{rep=les coordonnées de <em>A'</em> sont <em>(x',y')</em>}

##placement de la lettre A et du vecteur v
\real{xA=(\x1)}
\real{yA=(\y1-0.2)}

\real{xv=((\x2)+(\x3))/2}
\real{yv=-0.8+((\y2)+(\y3))/2}

####### enoncé de l'exo #######
\statement{
<div style="width:75%">
      Dans le plan muni d'un repère orthonormé \((O,i,j)\), la translation
      <em>T</em> de vecteur <em>V</em> s'obtient en composant deux symétries
      centrales \(s_1) et \(s_2). &nbsp; Une symétrie centrale
      \(s_1) de centre <em>A</em> suivie d'une symétrie centrale \(s_2) de
      centre <em>A'</em>.  Donner les coordonnées <em>(x',y')</em> de
      <em>A'</em>.
</div>

<p style="text-align:center">
\draw{500,500}{xrange -10,10
yrange -10,10

gridfill 0,0,10,10,\gridcolor

translate 0.2,0.2

linewidth 2

vline 2,0,\gridcolor
vline 4,0,\gridcolor
vline 6,0,\gridcolor
vline 8,0,\gridcolor
vline 10,0,\gridcolor
vline -2,0,\gridcolor
vline -4,0,\gridcolor
vline -6,0,\gridcolor
vline -8,0,\gridcolor
vline -10,0,\gridcolor
hline 0,2,\gridcolor
hline 0,4,\gridcolor
hline 0,6,\gridcolor
hline 0,8,\gridcolor
hline 0,10,\gridcolor
hline 0,-2,\gridcolor
hline 0,-4,\gridcolor
hline 0,-6,\gridcolor
hline 0,-8,\gridcolor
hline 0,-10,\gridcolor

vline 0,0,black
hline 0,0,black

linewidth 10
point \x1,\y1,transparent green

linewidth 2

text black,\xA,\yA,medium,A
arrow \x2,\y2,\x3,\y3,15,orange
text black,\xv,\yv,medium,V

arrow 0,0,2,0,10,magenta
arrow 0,0,0,2,10,magenta

text red,1,-0.2,medium,i
text red,-0.4,1,medium,j
text black,-0.3,-0.2,medim,O

text red,1.975,-9.80,small,1
text red,3.975,-9.80,small,2
text red,5.975,-9.80,small,3
text red,7.975,-9.80,small,4

text red,-2.30,-9.80,small,-1
text red,-4.30,-9.80,small,-2
text red,-6.30,-9.80,small,-3
text red,-8.30,-9.80,small,-4

text red,-10.2,-7.80,small,-4
text red,-10.2,-5.80,small,-3
text red,-10.2,-3.80,small,-2
text red,-10.2,-1.80,small,-1


text red,-10,2.35,small,1
text red,-10,4.35,small,2
text red,-10,6.35,small,3
text red,-10,8.35,small,4
}
</p>

}

#### soumission de réponse ####
\answer{\rep}{\bonrep}{type=vector}
