\title{Composer deux translations}
\language{fr}
\range{-5..5}
\author{Yaméogo, Joachim}
\email{yameogo@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}


##cadre du dessin
\integer{r=5}
\integer{h=100*(\r)}

##couleur des grilles
\text{gridcolor=lightblue}

##choix aléatoire d'un sommet de triangle
\integer{r1=\r-1}
\integer{x1=random(-2*(\r1)..2*(\r1))}
\integer{y1=random(-2*(\r1)..2*(\r1))}

##construction de deux vecteurs libres adhéquats
###bornes des vecteurs
\integer{bgx=-2*(\r1)-(\x1)}
\integer{bdx=2*(\r1)-(\x1)}
\integer{bgy=-2*(\r1)-(\y1)}
\integer{bdy=2*(\r1)-(\y1)}
###choix du premier vecteur, on s'assure que ux est non nul
\integer{ux=random(\bgx..\bdx)}
\integer{ux=\ux=0?\bdx}
\integer{ux=\ux=0?\bgx}
\integer{uy=random(\bgy..\bdy)}
###choix du deuxième vecteur
\integer{vx=random(\bgx..\bdx)}
\integer{vy=random(\bgy..\bdy)}
###on s'assure que les vecteurs sont libres
\integer{vy=(\ux*\vy)-(\uy*\vx)=0?\vy+1}

##coordonnées des 2 autres sommets du triangle
\integer{x2=\x1+\ux}
\integer{y2=\y1+\uy}
\integer{x3=\x1+\vx}
\integer{y3=\y1+\vy}

##contruction du translaté d'un point du triangle
###conditions pour que le translaté reste dans le cadre
\integer{minxi=min(\x1,\x2)}
\integer{minxi=min(\minxi,\x3)}
\integer{maxxi=max(\x1,\x2)}
\integer{maxxi=max(\maxxi,\x3)}

\integer{minyi=min(\y1,\y2)}
\integer{minyi=min(\minyi,\y3)}
\integer{maxyi=max(\y1,\y2)}
\integer{maxyi=max(\maxyi,\y3)}

\integer{mintx=-2*(\r1)-\minxi}
\integer{maxtx=2*(\r1)-\maxxi}

\integer{minty=-2*(\r1)-\minyi}
\integer{maxty=2*(\r1)-\maxyi}

###contruction d'un vecteur de translation non nul
\integer{tx=random(\mintx..\maxtx)}
\integer{ty=random(\minty..\maxty)}
\integer{tx=\tx=\ty and \tx=0?\maxtx}
\integer{tx=\tx=\ty and \tx=0?\mintx}

###le translaté
\integer{x4=\x1+\tx}
\integer{y4=\y1+\ty}

##construction d'un 5ème point
\real{xmil1=(\x1+\x2)/2}
\real{ymil1=(\y1+\y2)/2}

\real{xmil2=(\x2+\x3)/2}
\real{ymil2=(\y2+\y3)/2}

\real{xmil3=(\x3+\x1)/2}
\real{ymil3=(\y3+\y1)/2}

\integer{mil=random(1,2,3)}

\real{x5=\mil=1?\xmil1+\tx}
\real{x5=\mil=2?\xmil2+\tx}
\real{x5=\mil=3?\xmil3+\tx}

\real{y5=\mil=1?\ymil1+\ty}
\real{y5=\mil=2?\ymil2+\ty}
\real{y5=\mil=3?\ymil3+\ty}

##la bonne réponse
\real{vx=\x2-\x1+\x4-\x3}
\real{vy=\y2-\y1+\y4-\y3}

\real{xS=\x5+\vx}
\real{yS=\y5+\vy}
\real{brep_x=\xS/2}
\real{brep_y=\yS/2}

\text{bonrep=\brep_x,\brep_y}

##champ de la réponse
\text{rep=les coordonnées de <em>S</em> sont <em>(x,y)</em>}

##placement des lettres sur le dessin
\real{xA=(\x1)}
\real{yA=(\y1-0.2)}

\real{xB=(\x2)}
\real{yB=(\y2-0.2)}

\real{xC=(\x3)}
\real{yC=(\y3-0.2)}

\real{xD=(\x4)}
\real{yD=(\y4-0.2)}

\real{xR=(\x5)}
\real{yR=(\y5-0.2)}

####### enoncé de l'exo #######
\statement{
<div style="width:75%">
      Dans le plan muni d'un repère orthonormé \((O,i,j)\), la translation de vecteur
      \(\vec{A B}) suivie de la  translation de vecteur \(\vec{C D}) envoie
     le point <em>R</em> (point de couleur orange) sur un point <em>S</em>
     (non dessiné). Donner les coordonnées <em>(x,y)</em> de <em>S</em>.
</div>

<p style="text-align:center">
\draw{500,500}{xrange -10,10
yrange -10,10

gridfill 0,0,10,10,\gridcolor

translate 0.2,0.2

linewidth 2

vline 2,0,\gridcolor
vline 4,0,\gridcolor
vline 6,0,\gridcolor
vline 8,0,\gridcolor
vline 10,0,\gridcolor
vline -2,0,\gridcolor
vline -4,0,\gridcolor
vline -6,0,\gridcolor
vline -8,0,\gridcolor
vline -10,0,\gridcolor
hline 0,2,\gridcolor
hline 0,4,\gridcolor
hline 0,6,\gridcolor
hline 0,8,\gridcolor
hline 0,10,\gridcolor
hline 0,-2,\gridcolor
hline 0,-4,\gridcolor
hline 0,-6,\gridcolor
hline 0,-8,\gridcolor
hline 0,-10,\gridcolor

vline 0,0,black
hline 0,0,black

linewidth 10
point \x1,\y1,transparent green
point \x2,\y2,transparent green
point \x3,\y3,transparent green
point \x4,\y4,transparent green
point \x5,\y5,orange

linewidth 2


text black,\xA,\yA,medium,A
text black,\xB,\yB,medium,B
text black,\xC,\yC,medium,C
text black,\xD,\yD,medium,D
text black,\xR,\yR,medium,R

arrow 0,0,2,0,10,magenta
arrow 0,0,0,2,10,magenta

text red,1,-0.2,medium,i
text red,-0.4,1,medium,j
text black,-0.3,-0.2,medim,O

text red,1.975,-9.80,small,1
text red,3.975,-9.80,small,2
text red,5.975,-9.80,small,3
text red,7.975,-9.80,small,4

text red,-2.30,-9.80,small,-1
text red,-4.30,-9.80,small,-2
text red,-6.30,-9.80,small,-3
text red,-8.30,-9.80,small,-4

text red,-10.2,-7.80,small,-4
text red,-10.2,-5.80,small,-3
text red,-10.2,-3.80,small,-2
text red,-10.2,-1.80,small,-1


text red,-10,2.35,small,1
text red,-10,4.35,small,2
text red,-10,6.35,small,3
text red,-10,8.35,small,4
}
</p>

}

#### soumission de réponse ####
\answer{\rep}{\bonrep}{type=vector}
