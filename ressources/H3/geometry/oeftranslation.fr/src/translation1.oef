\title{Triangles translatés}
\language{fr}
\range{-5..5}
\author{Yaméogo Joachim}
\email{yameogo@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}


##cadre du dessin
\integer{r=5}
\integer{h=100*(\r)}

##couleur des grilles
\text{gridcolor=lightblue}

##choix aléatoire d'un sommet du premier triangle
\integer{r1=\r-1}
\integer{x1=random(-2*(\r1)..2*(\r1))}
\integer{y1=random(-2*(\r1)..2*(\r1))}

##construction de deux vecteurs libres adhéquats
###bornes des vecteurs
\integer{bgx=-2*(\r1)-(\x1)}
\integer{bdx=2*(\r1)-(\x1)}
\integer{bgy=-2*(\r1)-(\y1)}
\integer{bdy=2*(\r1)-(\y1)}
###choix du premier vecteur, on s'assure que ux est non nul
\integer{ux=random(\bgx..\bdx)}
\integer{ux=\ux=0?\bdx}
\integer{ux=\ux=0?\bgx}
\integer{uy=random(\bgy..\bdy)}
###choix du deuxième vecteur
\integer{vx=random(\bgx..\bdx)}
\integer{vy=random(\bgy..\bdy)}
###on s'assure que les vecteurs sont libres
\integer{vy=(\ux*\vy)-(\uy*\vx)=0?\vy+1}

##coordonnées des 2 autres sommets du premier triangle
\integer{x2=\x1+\ux}
\integer{y2=\y1+\uy}
\integer{x3=\x1+\vx}
\integer{y3=\y1+\vy}

##contruction du translaté du premier triangle
###conditions pour que le translaté reste dans le cadre
\integer{minxi=min(\x1,\x2)}
\integer{minxi=min(\minxi,\x3)}
\integer{maxxi=max(\x1,\x2)}
\integer{maxxi=max(\maxxi,\x3)}

\integer{minyi=min(\y1,\y2)}
\integer{minyi=min(\minyi,\y3)}
\integer{maxyi=max(\y1,\y2)}
\integer{maxyi=max(\maxyi,\y3)}

\integer{mintx=-2*(\r1)-\minxi}
\integer{maxtx=2*(\r1)-\maxxi}

\integer{minty=-2*(\r1)-\minyi}
\integer{maxty=2*(\r1)-\maxyi}

###contruction d'un vecteur de translation non nul
\integer{tx=random(\mintx..\maxtx)}
\integer{ty=random(\minty..\maxty)}
\integer{tx=\tx=\ty and \tx=0?\maxtx}
\integer{tx=\tx=\ty and \tx=0?\mintx}

###le translaté
\integer{p1=\x1+\tx}
\integer{q1=\y1+\ty}
\integer{p2=\x2+\tx}
\integer{q2=\y2+\ty}
\integer{p3=\x3+\tx}
\integer{q3=\y3+\ty}

##la bonne réponse à soumettre
\real{reptx=\tx/2}
\real{repty=\ty/2}
\text{bonrep=\reptx,\repty}

##champ de la réponse
\text{rep=\((a,b)\)}

####### enoncé de l'exo #######
\statement{
      <div style="width:75%">
      Dans le plan muni d'un repère orthonormé \((O,\vec{\i},\vec{\j})\), une translation de
      vecteur \(v=a \vec{\i}+b \vec{\j}\) transforme le triangle bleu en le triangle vert.
      <br>
      Donner les coordonnées \((a,b)\) du vecteur de translation \(v\).
      </div>

<p style="text-align:center">
\draw{500,500}{xrange -10,10
yrange -10,10

gridfill 0,0,10,10,\gridcolor

translate 0.2,0.2

linewidth 2

vline 2,0,\gridcolor
vline 4,0,\gridcolor
vline 6,0,\gridcolor
vline 8,0,\gridcolor
vline 10,0,\gridcolor
vline -2,0,\gridcolor
vline -4,0,\gridcolor
vline -6,0,\gridcolor
vline -8,0,\gridcolor
vline -10,0,\gridcolor
hline 0,2,\gridcolor
hline 0,4,\gridcolor
hline 0,6,\gridcolor
hline 0,8,\gridcolor
hline 0,10,\gridcolor
hline 0,-2,\gridcolor
hline 0,-4,\gridcolor
hline 0,-6,\gridcolor
hline 0,-8,\gridcolor
hline 0,-10,\gridcolor

vline 0,0,black
hline 0,0,black


triangle \x1,\y1,\x2,\y2,\x3,\y3,darkblue
triangle \p1,\q1,\p2,\q2,\p3,\q3,green

arrow 0,0,2,0,10,magenta
arrow 0,0,0,2,10,magenta

text red,1,-0.2,medium,i
text red,-0.4,1,medium,j
text black,-0.3,-0.2,medim,O

text red,1.975,-9.80,small,1
text red,3.975,-9.80,small,2
text red,5.975,-9.80,small,3
text red,7.975,-9.80,small,4

text red,-2.30,-9.80,small,-1
text red,-4.30,-9.80,small,-2
text red,-6.30,-9.80,small,-3
text red,-8.30,-9.80,small,-4

text red,-10.2,-7.80,small,-4
text red,-10.2,-5.80,small,-3
text red,-10.2,-3.80,small,-2
text red,-10.2,-1.80,small,-1


text red,-10,2.35,small,1
text red,-10,4.35,small,2
text red,-10,6.35,small,3
text red,-10,8.35,small,4
}
</p>

}

#### soumission de réponse ####
\answer{\rep}{\bonrep}{type=vector}
