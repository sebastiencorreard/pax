!exit

:question
$()	      <div style="width:75%">	      Dans le plan muni d'un repère orthonormé 
!insmath (O,\vec{\i},\vec{\j})
$(), une translation de	      vecteur 
!insmath v=a \vec{\i}+b \vec{\j}
$() transforme le triangle bleu en le triangle vert.	      <br>	      Donner les coordonnées 
!insmath (a,b)
$() du vecteur de translation 
!insmath v
$().	      </div>		<p style="text-align:center">	 
!read oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10		gridfill 0,0,10,10,$val8		translate 0.2,0.2		linewidth 2		vline 2,0,$val8	vline 4,0,$val8	vline 6,0,$val8	vline 8,0,$val8	vline 10,0,$val8	vline -2,0,$val8	vline -4,0,$val8	vline -6,0,$val8	vline -8,0,$val8	vline -10,0,$val8	hline 0,2,$val8	hline 0,4,$val8	hline 0,6,$val8	hline 0,8,$val8	hline 0,10,$val8	hline 0,-2,$val8	hline 0,-4,$val8	hline 0,-6,$val8	hline 0,-8,$val8	hline 0,-10,$val8		vline 0,0,black	hline 0,0,black			triangle $val10,$val11,$val20,$val21,$val22,$val23,darkblue	triangle $val34,$val35,$val36,$val37,$val38,$val39,green		arrow 0,0,2,0,10,magenta	arrow 0,0,0,2,10,magenta		text red,1,-0.2,medium,i	text red,-0.4,1,medium,j	text black,-0.3,-0.2,medim,O		text red,1.975,-9.80,small,1	text red,3.975,-9.80,small,2	text red,5.975,-9.80,small,3	text red,7.975,-9.80,small,4		text red,-2.30,-9.80,small,-1	text red,-4.30,-9.80,small,-2	text red,-6.30,-9.80,small,-3	text red,-8.30,-9.80,small,-4		text red,-10.2,-7.80,small,-4	text red,-10.2,-5.80,small,-3	text red,-10.2,-3.80,small,-2	text red,-10.2,-1.80,small,-1			text red,-10,2.35,small,1	text red,-10,4.35,small,2	text red,-10,6.35,small,3	text red,-10,8.35,small,4	 
$()	</p>		
