val6=$[rint(5)]
val7=$[rint(100*($val6))]
val8=lightblue
val9=$[rint($val6-1)]
tmp0=!randint -2*($val9), 2*($val9)

val10=$[rint($(tmp0))]
tmp0=!randint -2*($val9), 2*($val9)

val11=$[rint($(tmp0))]
val12=$[rint(-2*($val9)-($val10))]
val13=$[rint(2*($val9)-($val10))]
val14=$[rint(-2*($val9)-($val11))]
val15=$[rint(2*($val9)-($val11))]
tmp0=!randint $val12, $val13

val16=$[rint($(tmp0))]

!ifval $val16=0
val16=$[rint($val13)]
!endif

!ifval $val16=0
val16=$[rint($val12)]
!endif
tmp0=!randint $val14, $val15

val17=$[rint($(tmp0))]
tmp0=!randint $val12, $val13

val18=$[rint($(tmp0))]
tmp0=!randint $val14, $val15

val19=$[rint($(tmp0))]

!ifval ($val16*$val19)-($val17*$val18)=0
val19=$[rint($val19+1)]
!endif
val20=$[rint($val10+$val16)]
val21=$[rint($val11+$val17)]
val22=$[rint($val10+$val18)]
val23=$[rint($val11+$val19)]
val24=$[rint(min($val10,$val20))]
val24=$[rint(min($val24,$val22))]
val25=$[rint(max($val10,$val20))]
val25=$[rint(max($val25,$val22))]
val26=$[rint(min($val11,$val21))]
val26=$[rint(min($val26,$val23))]
val27=$[rint(max($val11,$val21))]
val27=$[rint(max($val27,$val23))]
val28=$[rint(-2*($val9)-$val24)]
val29=$[rint(2*($val9)-$val25)]
val30=$[rint(-2*($val9)-$val26)]
val31=$[rint(2*($val9)-$val27)]
tmp0=!randint $val28, $val29

val32=$[rint($(tmp0))]
tmp0=!randint $val30, $val31

val33=$[rint($(tmp0))]

!ifval $val32=$val33 and $val32=0
val32=$[rint($val29)]
!endif

!ifval $val32=$val33 and $val32=0
val32=$[rint($val28)]
!endif
val34=$[rint($val10+$val32)]
val35=$[rint($val11+$val33)]
val36=$[rint($val20+$val32)]
val37=$[rint($val21+$val33)]
val38=$[rint($val22+$val32)]
val39=$[rint($val23+$val33)]
