val6=$[rint(5)]
val7=$[rint(100*($val6))]
val8=lightblue
tmp0=!randint 12, 75

val9=$[rint($(tmp0))]
val10=$[rint(2*($val6)-2-floor(($val9)/25))]
val11=$[rint(2*($val9))]
tmp0=!randint -($val10), ($val10)

val12=$[rint($(tmp0))]
tmp0=!randint -($val10), ($val10)

val13=$[rint($(tmp0))]
val14=$[rint($val12-1-floor(($val9)/25))]
val15=$[rint($val12+1+floor(($val9)/25))]
val16=$[rint($val13-1-floor(($val9)/25))]
val17=$[rint($val13+1+floor(($val9)/25))]
val18=$[rint(-($val10)-$val14)]
val19=$[rint(($val10)-$val15)]
val20=$[rint(-($val10)-$val16)]
val21=$[rint(($val10)-$val17)]
tmp0=!randint $val18, $val19

val22=$[rint($(tmp0))]
tmp0=!randint $val20, $val21

val23=$[rint($(tmp0))]

!ifval $val22=$val23 and $val22=0
val22=$[rint($val19)]
!endif

!ifval $val22=$val23 and $val22=0
val22=$[rint($val18)]
!endif
val24=$[rint($val12+$val22)]
val25=$[rint($val13+$val23)]
val26=$[$val22/2]
val27=$[$val23/2]
val28=$val26,$val27
val29=\((a,b)\)
replytype1=vector
replyname1=$val29
replygood1=$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="width:75%">	      Dans le plan muni d'un repère orthonormé 
!insmath (O,i,j)
$(), une translation de	      vecteur 
!insmath v=a i+b j
$() transforme le disque bleu en le disque vert.	      <br>	      Donner les coordonnées 
!insmath (a,b)
$() du vecteur de translation 
!insmath v
$().	</div>		<p style="text-align:center">	 
!read oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10		gridfill 0,0,10,10,$val8		translate 0.2,0.2		linewidth 2		vline 2,0,$val8	vline 4,0,$val8	vline 6,0,$val8	vline 8,0,$val8	vline 10,0,$val8	vline -2,0,$val8	vline -4,0,$val8	vline -6,0,$val8	vline -8,0,$val8	vline -10,0,$val8	hline 0,2,$val8	hline 0,4,$val8	hline 0,6,$val8	hline 0,8,$val8	hline 0,10,$val8	hline 0,-2,$val8	hline 0,-4,$val8	hline 0,-6,$val8	hline 0,-8,$val8	hline 0,-10,$val8		vline 0,0,black	hline 0,0,black		fcircle $val12,$val13,$val11,darkblue	fcircle $val24,$val25,$val11,green		arrow 0,0,2,0,10,magenta	arrow 0,0,0,2,10,magenta		text red,1,-0.2,medium,i	text red,-0.4,1,medium,j	text black,-0.3,-0.2,medim,O		text red,1.975,-9.80,small,1	text red,3.975,-9.80,small,2	text red,5.975,-9.80,small,3	text red,7.975,-9.80,small,4		text red,-2.30,-9.80,small,-1	text red,-4.30,-9.80,small,-2	text red,-6.30,-9.80,small,-3	text red,-8.30,-9.80,small,-4		text red,-10.2,-7.80,small,-4	text red,-10.2,-5.80,small,-3	text red,-10.2,-3.80,small,-2	text red,-10.2,-1.80,small,-1			text red,-10,2.35,small,1	text red,-10,4.35,small,2	text red,-10,6.35,small,3	text red,-10,8.35,small,4	 
$()	</p>		
