!set title=Deux symétries pour une translation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Yaméogo Joachim
email=yameogo@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(5)]
val7=$[rint(100*($val6))]
val8=lightblue
val9=$[rint($val6-1)]
tmp0=!randint -2*($val9), 2*($val9)

val10=$[rint($(tmp0))]
tmp0=!randint -2*($val9), 2*($val9)

val11=$[rint($(tmp0))]
val12=$[rint(-2*($val9)-($val10))]
val13=$[rint(2*($val9)-($val10))]
val14=$[rint(-2*($val9)-($val11))]
val15=$[rint(2*($val9)-($val11))]
tmp0=!randint $val12, $val13

val16=$[rint($(tmp0))]

!ifval $val16=0
val16=$[rint($val13)]
!endif

!ifval $val16=0
val16=$[rint($val12)]
!endif
tmp0=!randint $val14, $val15

val17=$[rint($(tmp0))]
tmp0=!randint $val12, $val13

val18=$[rint($(tmp0))]
tmp0=!randint $val14, $val15

val19=$[rint($(tmp0))]

!ifval ($val16*$val19)-($val17*$val18)=0
val19=$[rint($val19+1)]
!endif
val20=$[rint($val10+$val16)]
val21=$[rint($val11+$val17)]
val22=$[rint($val10+$val18)]
val23=$[rint($val11+$val19)]
val24=$[($val10)-(($val22)-($val20))/2]
val25=$[($val11)-(($val23)-($val21))/2]
val26=$val24/2,$val25/2
val27=les coordonnées de <em>A</em> sont <em>(x,y)</em>
val28=$[($val10)]
val29=$[($val11-0.2)]
val30=$[(($val20)+($val22))/2]
val31=$[-0.8+(($val21)+($val23))/2]
replytype1=vector
replyname1=$val27
replygood1=$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="width:75%">	      Dans le plan muni d'un repère orthonormé 
!insmath (O,i,j)
$(), la translation	      <em>T</em> de vecteur <em>V</em> s'obtient en composant deux symétries	      centrales 
!insmath s_1
$() et 
!insmath s_2
$(). &nbsp; Une symétrie centrale	      
!insmath s_1
$() de centre <em>A</em> suivie d'une symétrie centrale 
!insmath s_2
$() de	      centre <em>B</em>.  Donner les coordonnées <em>(x,y)</em> de	      <em>A</em>.	</div>	<p style="text-align:center">	 
!read oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10		gridfill 0,0,10,10,$val8		translate 0.2,0.2		linewidth 2		vline 2,0,$val8	vline 4,0,$val8	vline 6,0,$val8	vline 8,0,$val8	vline 10,0,$val8	vline -2,0,$val8	vline -4,0,$val8	vline -6,0,$val8	vline -8,0,$val8	vline -10,0,$val8	hline 0,2,$val8	hline 0,4,$val8	hline 0,6,$val8	hline 0,8,$val8	hline 0,10,$val8	hline 0,-2,$val8	hline 0,-4,$val8	hline 0,-6,$val8	hline 0,-8,$val8	hline 0,-10,$val8		vline 0,0,black	hline 0,0,black		linewidth 10	point $val10,$val11,transparent green		linewidth 2		text black,$val28,$val29,medium,B	arrow $val20,$val21,$val22,$val23,15,orange	text black,$val30,$val31,medium,V		arrow 0,0,2,0,10,magenta	arrow 0,0,0,2,10,magenta		text red,1,-0.2,medium,i	text red,-0.4,1,medium,j	text black,-0.3,-0.2,medim,O		text red,1.975,-9.80,small,1	text red,3.975,-9.80,small,2	text red,5.975,-9.80,small,3	text red,7.975,-9.80,small,4		text red,-2.30,-9.80,small,-1	text red,-4.30,-9.80,small,-2	text red,-6.30,-9.80,small,-3	text red,-8.30,-9.80,small,-4		text red,-10.2,-7.80,small,-4	text red,-10.2,-5.80,small,-3	text red,-10.2,-3.80,small,-2	text red,-10.2,-1.80,small,-1			text red,-10,2.35,small,1	text red,-10,4.35,small,2	text red,-10,6.35,small,3	text red,-10,8.35,small,4	 
$()	</p>		
$()
