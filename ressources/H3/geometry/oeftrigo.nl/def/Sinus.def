!set title=Sinus
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 50

val2=$[rint($(tmp0))]
tmp0=!randitem 30,45,50,60,20,15,40,35,55,65,75,80

val3=$[rint($(tmp0))]
val4=$[rint($val2*sin($val3*pi/180))]
replytype1=default
replyname1=De lengte AB in cm
replygood1=$val4
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p><center>	 
!read oef/draw.phtml 200,200 \
	xrange -20,20	yrange -20,20	triangle 15,15,15,-15,-15,-15,black	text black,14.5,17.5,medium,A	text black,16,-15,medium,B	text black,-16.5,-15,medium,C	 
$()	</center><p>	ABC is een rechthoekige driehoek in B.<br>	 [AC] is $val2 centimeter lang.<br>	De hoek 
!insmath \widehat{C}
$() is $val3&deg.<br>	Bereken hiermee de lengte AB in centimeter.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

