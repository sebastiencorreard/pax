!set title=Ladder
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 2,1	3,1	4,1	5,2	6,2	7,2	8,2	9,3	
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val6=$(tmp0)
tmp0=!item 2 of $val7

val8=$(tmp0)
val9=$[rint(atan($val6/$val8)*180/pi)]
val10=$[rint(10*sqrt($val6^2+$val8^2))/10]
replyname1=Hoek B in graden
replygood1=$val9
replyname2=Lengte van de ladder
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p><center>	 
!read oef/draw.phtml 150,250 \
	xrange -15,15	yrange -25,25	line -15,-24,15,-24,black	rect -14,24,0,-24,black	fill -5,0,grey	line 0,15,14,-24,black	text black,7,0,medium,E	text black,-7,0,medium,B	text black,0.5,16.5,medium,C	text black,0.5,-21.5,medium,A	text black,12,-21.5,medium,B	 
$()	</center><p>	Een ladder E steunt tegen een muur  B.<br> 	AC is $val6 meter lang,	AB is $val8 meter lang. 	Hoe groot is de hoek
!insmath \widehat B
$() (rond je getal af) ?	Hoe lang is de ladder (arfronden op  een decimeter) ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=0
