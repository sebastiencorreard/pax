!set title=De hoogte van een boom
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=XIAO Dingyu
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 5,40,12,5	6,45,15,8
val2=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val2

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val3=$(tmp0)
tmp0=!item 1 of $val3

val4=$(tmp0)
tmp0=!item 2 of $val3

val5=$(tmp0)
tmp0=!item 3 of $val3

val6=$(tmp0)
tmp0=!item 4 of $val3

val7=$(tmp0)
replyname1=De hoogte van de boom is
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<uL>	<li>	De hoek BAH is $val5&deg;	<li>	De hoek HAC is $val6&deg;	<li>	Het mannetje staat $val4 meter van de boom	</ul>	Bereken hiermee de hoogte (in meter) van de boom	<p><center>	<img src=$val1/hauteurarbre.gif>	</center><p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=4,5,6
embedcnt=0
