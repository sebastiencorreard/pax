\title{Cosinus}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{ac=random(15..50)}
\integer{deg=random(30,45,50,60,20,15,40,35,55,65,75,80)}
\integer{\r=\ac*cos(\deg*pi/180)}
\statement{<p><center>
\draw{200,200}{
xrange -20,20
yrange -20,20
triangle 15,15,15,-15,-15,-15,black
text black,14.5,17.5,medium,A
text black,16,-15,medium,B
text black,-16.5,-15,medium,C
}
</center><p>
ABC is een rechthoekige driehoek in B<br>
[AC] is \ac centimeter.<br>
De hoek \(\widehat{C}) is \deg&deg;.<br>
Bereken hiermee de lengte BC in centimeters.
}


\answer{De lengte BC in cm}{\r}{type=default}