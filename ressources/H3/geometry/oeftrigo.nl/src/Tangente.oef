\integer{bc=random(5..15)}
\integer{\r=\bc*tan(pi/4)}
\statement{<p><center>
\draw{200,200}{
xrange -20,20
yrange -20,20
triangle 15,15,15,-15,-15,-15,black
text black,14.5,17.5,medium,A
text black,16,-15,medium,B
text black,-16.5,-15,medium,C
}
</center><p>
ABC is een rechthoekige driehoek in B.
[BC] is \bc cm lang. 
De hoek \(\widehat{C}) is 45&deg;. 
Bereken de lengte AB in centimeters.}


\answer{Lengte AB in cm}{\r}{type=default}