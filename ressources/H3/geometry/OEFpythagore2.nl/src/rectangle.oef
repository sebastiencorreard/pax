\title{Is het rechthoekig ?}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\matrix{lettre=A,B,C
T,I,R
E,F,G
D,E,F}
\text{lettre=randrow(\lettre)}
\text{lettre=shuffle(\lettre)}
\text{X1=item(1,\lettre)}
\text{X2=item(2,\lettre)}
\text{X3=item(3,\lettre)}

\integer{type=randitem(1,2)}
\if{\type=1}{
 \text{listchoix==,\(\neq)}
 \integer{u=random(2..6)}
 \integer{v=random(1..\u-1)}
 \integer{sm=max(\u^2-\v^2,2*\u*\v)}
 \integer{mn=min(\u^2-\v^2,2*\u*\v)}
 \integer{sn=(\mn^2+\sm^2)^(1/2)}
 \real{k=randint(15..25)}
 \real{l2=\sm*\k}
 \real{l1=\sn*\k}
 \real{l3=\mn*\k}
}{
 \text{listchoix=\(\neq),=}
 \integer{l1=randint(20..1900)}
 \integer{l2=randint(20..1900)}
 \integer{m=max(\l1-\l2,\l2-\l1)}
 \integer{l3=randint(\m+20..\l1+\l2)}
 \if{(\l1^2+\l2^2-\l3^2)*(\l1^2+\l3^2-\l2^2)*(\l3^2+\l2^2-\l1^2)=0}{
  \integer{l1=50}
  \integer{l2=20}
  \integer{l3=30}
 }
}

\real{l1=\l1/10}
\real{l2=\l2/10}
\real{l3=\l3/10}
\text{longueur=\(\X1\X2 = \l3),\(\X2\X3 = \l2),\(\X1\X3 = \l1)}
\text{longueur=shuffle(\longueur)}
\text{longueur=wims(replace internal , by &nbsp;&nbsp; in \longueur)}

\text{choix1=is rechthoekig,is niet rechthoekig}
\text{choix2=het omgekeerde van de stelling van Pythagoras,de stelling van Pythagoras}
\text{choix3=en \X1,en \X2,en \X3}
\text{rep1=item(\type,\choix1)}
\text{rep2=item(\type,\choix2)}
\text{rep3=item(2,\choix3)}

\text{listchoix=\listchoix,\(\X1\X2^2),\(\X1\X3^2),\(\X2\X3^2),\X1\X2,\X1\X3,+,\X2\X3}
\text{solegal=wims(item 4,1,3,8,5 of \listchoix)|wims(item 4,1,5,8,3 of \listchoix)|wims(item 3,8,5,1,4 of \listchoix)|wims(item 5,8,3,1,4 of \listchoix)}

\text{unit=randitem(cm,m,dm,dam)}

\text{mstep=c1,c2}

\nextstep{\mstep}

\statement{<br>
De zijdes van de driehoek \(\X1\X2\X3) hebben de volgende afmetingen ( in \unit) :<p>
 <center>\longueur</center>
\if{\step=1}{<ul>
 <li>Is de driehoek rechthoekig ?</li>
 <li>Welke stelling gebruik je ?</li>
</ul>
<b>Antwoord </b>: <br>
<center>\embed{r1,40x35x5}</center><br> Volgens \embed{c2}, de driehoek \(\X1\X2\X3) \embed{c1}.
}{\if{\type=1}{Welke hoek is recht ?<br>
<b>Antwoord </b> : \(\X1\X2\X3) is rechthoekig \embed{c3}.
}}}

\text{mstep=\type=1 and \step=2?c3}

\answer{Formule}{\solegal;\listchoix}{type=clickfill}{weight=4}
\choice{Driehoek}{\rep1}{\choix1}{weight=2}
\choice{Stelling}{\rep2}{\choix2}{weight=3}
\choice{Rechte hoek}{\rep3}{\choix3}{weight=2}