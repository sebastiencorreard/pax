$()</td>	    <td align=center>$val8</td>	    <td align=center>$val9</td>	    <td align=center>$val10</td>	    <td align=center>$val11</td>	    <td align=center>
!insmath $val12
$()</td>	  </tr>	  <tr>	    <td align=center>
!insmath \sqrt{x}
$()</td>	    <td align=center> 
