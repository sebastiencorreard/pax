!ifval $val2 notitemof 0,1
val2=$[rint(1)]
!endif
tmp=!trim A,B,C	T,I,R	E,F,G	D,E,F
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
val10=$[rint(240)]
val11=$[rint(140)]
tmp=!trim $val7,$val9	$val9,$val7
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
val15=line 20,20,20,120,black	line 20,120,220,120,black	line 20,20,220,120,black	line 21,110,30,110,red	line 30,110,30,119,red	text black,10,115,medium,$val8	text black,10,10,medium,$val13	text black,230,115,medium,$val14
val16=$[rint(1)]
val17=$[rint(1)]
val18=<br>Geef de stelling van Pythagoras met behulp van deze driehoek en de blauwe vakjes hieronder.
tmp=!nonempty items De driehoek \($val7$val8$val9) is rechthoekig in \($val8), \(\angle{$val7$val8$val9}) is recht

tmp0=!randitem $tmp
val19=$(tmp0)
val20=\($val7$val8),\($val7$val9),\($val8$val9),\($val7$val8^2),\($val7$val9^2),\($val8$val9^2),+
val21=\($val7\X4),\($val7\X4^2),\($val8\X4),\($val8\X4^2)
!if $val16=1 
tmp0=!item 5 of $val20

val22=$(tmp0)
tmp0=!item 4 of $val20

tmp1=!item 7 of $val20

tmp2=!item 6 of $val20

tmp3=!item 6 of $val20

tmp4=!item 7 of $val20

tmp5=!item 4 of $val20

val23=$(tmp0),$(tmp1),$(tmp2)|$(tmp3),$(tmp4),$(tmp5)
!else
