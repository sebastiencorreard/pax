!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2 notitemof 0,1
val2=$[rint(1)]
!endif
tmp=!trim A,B,C,D	T,I,R,J	E,F,G,H	D,E,F,G
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
val11=$[rint(240)]
val12=$[rint(140)]
tmp0=!randint 80, 160

val13=$[rint($(tmp0))]
val14=line 20,20,20,120,black	line 20,120,220,120,black	line 20,20,220,120,black	line 20,20,$val13,120,black	line 21,110,30,110,red	line 30,110,30,119,red	text black,10,125,medium,$val8	text black,10,10,medium,$val7	text black,225,125,medium,$val9	text black,$val13,125,medium,$val10
val15=$[rint(2)]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
val17=$val7$val8$val9,$val7$val8$val10
tmp0=!item $val16 of $val17

val17=$(tmp0)
val18=<br>Geef de stelling van Pythagoras met behulp van de driehoek \($val17) en de blauwe vakjes hieronder.
tmp=!nonempty items De driehoek \($val7$val8$val9) is rechthoekig in \($val8), \(\angle{$val7$val8$val9}) is recht

tmp0=!randitem $tmp
val19=$(tmp0)
val20=\($val7$val8),\($val7$val9),\($val8$val9),\($val7$val8^2),\($val7$val9^2),\($val8$val9^2),+
val21=\($val7$val10),\($val7$val10^2),\($val8$val10),\($val8$val10^2)
!if $val16=1 
tmp0=!item 5 of $val20

val22=$(tmp0)
tmp0=!item 4 of $val20

tmp1=!item 7 of $val20

tmp2=!item 6 of $val20

tmp3=!item 6 of $val20

tmp4=!item 7 of $val20

tmp5=!item 4 of $val20

val23=$(tmp0),$(tmp1),$(tmp2)|$(tmp3),$(tmp4),$(tmp5)
!else
tmp0=!item 2 of $val21

val22=$(tmp0)
tmp0=!item 4 of $val20

tmp1=!item 7 of $val20

tmp2=!item 4 of $val21

tmp3=!item 4 of $val21

tmp4=!item 7 of $val20

tmp5=!item 4 of $val20

val23=$(tmp0),$(tmp1),$(tmp2)|$(tmp3),$(tmp4),$(tmp5)
!endif
!if $val15=2 
val20=$val20,$val21
!endif
replytype1=clickfill
replyname1=Membre de gauche
replygood1=$val22;$val20
replytype2=clickfill
replyname2=Membre de droite
replygood2=$val23;$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

