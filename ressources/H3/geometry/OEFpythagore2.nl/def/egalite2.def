$() 
!if $val2=1 
$()	<table>	<tr>	   <td>$val19. $val18 ?</td>	   <td> 
!read oef/draw.phtml $val11,$val12 \
$val14 
$()<center>(de driehoek is niet op schaal getekend)<center></td>	</tr>	</table>	 
!else
