!set title=Image et antécédent; application affine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Beeld en origineel; lineaire functie

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=l'antécédent, l'image
val8=Soit \(f\) la fonction affine définie par,	  Déterminer,de ,par
!if $val6=nl 
val7=het origineel, het beeld
val8=Zij \(f\) de lineaire functie gedefinieerd door,	   Bepaal,van ,onder
!endif
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val10=$[rint($(tmp0))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
t_=!rawmath $val11/$val12
val11=!exec pari print($t_)
t_=!rawmath $val9*$val11+$val10
val13=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val9*x + ($val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
tmp0=!randitem 1,2

val15=$(tmp0)
tmp0=!item $val15 of $val7

val16=$(tmp0)

!ifval $val15=1
t_=!rawmath  $val13
val17=!exec pari print($t_)
!else
t_=!rawmath  $val11
val17=!exec pari print($t_)
!endif

!ifval $val15=1 
t_=!rawmath  $val11
val18=!exec pari print($t_)
!else
t_=!rawmath $val13
val18=!exec pari print($t_)
!endif
val19=$(val8[1])	\(f(x) = $val14\). $(val8[2])	$val16 $(val8[3]) $val17 $(val8[4]) \(f\).
replytype1=formal
replyname1=$val16 $(val8[3]) $val17
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

