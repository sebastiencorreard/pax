!set title=Fonction linéaire 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
title_nl=Lineaire functie

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Déterminer l'expression \(f(x)\) de la fonction	  linéaire \(f\) sachant que
!if $val6=nl 
val7=Bepaal \(f(x)\) voor de linear functie \(f\) als
!endif
tmp0=!randitem 1,-1

tmp1=!randint 1, 5

tmp2=!randint 1, 3

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val8=!exec pari print($t_)
tmp0=!randitem 1,-1

tmp1=!randint 2, 8

t_=!rawmath $(tmp0)*$(tmp1)
val9=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val9)/($val8)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
replytype1=formal
replyname1=\(f(x)\)
replygood1=$val10,x
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath f($val8) = $val9
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=0
