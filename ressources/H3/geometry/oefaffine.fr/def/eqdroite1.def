!set title=Déterminer graphiquement une équation de droite (niveau 2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabien,Sommier
email=math.sommier@gmail.com
author=Fabien,Sommier
email=math.sommier@gmail.com
language=fr
precision=10000
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
title_nl=Vergelijking van een lijn (niveau 2)

ansorder=r
varcnt=8
prevarcnt=5
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=nl 
!endif
val7=xrange -5.2, 5.2	yrange -5.2, 5.2	parallel -5.2,-5,5.2,-5,0,1,11, grey	parallel -5,-5.2,-5,5.2,1,0,11, grey	segment 1,-0.2,1,0.2, black	segment -0.2,1,0.2,1, black	text black, 0.9,-0.25,medium, 1	text black, -0.5,1.25,medium, 1	text black, -0.5,-0.25,medium, "0"	point 0,0, black	hline 0,0, black	vline 0,0, black	arrow -5.2,0,5.2,0, 10, black	arrow 0,-5.2,0,5.2, 10, black	
tmp0=!randitem -1,1

tmp1=!randitem  1/2,1/3,1/4,3/2,2/3,3/4,4/3

t_=!rawmath $(tmp0)*$(tmp1) 
val8=!exec pari print($t_)
tmp0=!randint  -4, 4 

val9=$[rint($(tmp0) )]
tmp=!translate ";': to $     $ in $val8*x + ($val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath $(tmp0) 
replytype1=function
replyoption1=noanalyzeprint 
replyname1=\(y = )
replygood1=!rawmath $val10,x 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compléter l'équation réduite de la droite tracée :	<div class="wimscenter">	 
!read oef/draw.phtml 200,200  \
	$val7	plot blue, $val10  
$()	<br>	<label for ="reply1">
!insmath y = 
$() </label> 
!read oef/embed.phtml  reply 1, 15  
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp=!translate ";': to $     $ in $m_reply1-($val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0) 
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val12=$(tmp0)

!exit

:feedback
!ifval  $val11<>0 
 <div class='oef_feedbacks'>	La droite tracée a pour équation y=$val12<br>	Voici en rouge la droite correspondant à l'équation que vous avez donnée :	<div class="wimscenter">	 
!read oef/draw.phtml  200,200  \
	$val7	plot red, $m_reply1	plot blue,$val10	  
$() </div> 
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,10
embedcnt=1
