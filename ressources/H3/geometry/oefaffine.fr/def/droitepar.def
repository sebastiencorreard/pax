!set title=Équation de droite affine parallèle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Vergelijking van een evenwijdige lijn

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Donner l'équation de la droite parallèle à la droite tracée et	  passant par le point
!if $val6=nl 
val7=Geef de vergelijking van de lijn die evenwijdig	  loopt aan de getrokken lijn,  door het punt
!endif
tmp0=!randint -4, 4

val8=$[rint($(tmp0))]
tmp0=!randint -4, 4

val9=$[rint($(tmp0))]

!ifval $val8=0 and $val9=0
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint( $(tmp0)*$(tmp1))]
!endif
tmp=!translate ";': to $     $ in $val8*x+($val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath $(tmp0)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -3, 3

val12=$[rint($(tmp0))]

!ifval $val8*($val12)+($val9)=$val11
tmp0=!randitem 1,-1

val11=$[rint( $val11+$(tmp0))]
!endif
val13=$[rint(-($val8)*$val12+($val11))]
tmp=!translate ";': to $     $ in $val8*x + ($val13)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
replytype1=function
replyname1=\(y = )
replygood1=!rawmath $val14,x
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath A = ($val12 , $val11)
$() :	<div class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -5.2,5.2	yrange -5.2,5.2	parallel -5,-5,5,-5,0,1,10, grey	parallel -5,-5,-5,5,1,0,10, grey	hline 0,0,black	disk $val12,$val11, 6,blue,	text black , $val12,$val11,medium ,A	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	plot red , $val10	 
$()	</div>	<div class="wimscenter"><label for ="reply1">
!insmath y = 
$()</label>	 
!read oef/embed.phtml reply 1,15 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12
embedcnt=1
