 <div class='oef_feedbacks'>	<div class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	ttext black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 disk $val13,$val14,7,blue	 text black,$val13,$val14,medium,A	 plot red, $val12*x	 
$()	</div>
$()</div>
