!set title=Droite et cadran
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
title_nl=Lijn en kwadrant

ansorder=c
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=La droite \(d\) représente la fonction linéaire
val8=L'abscisse d'un point \(A\) qui appartient à la droite \(d\) est égale à
val9=Représentez-vous la droite et dites	  dans quel quadrant se trouve le point \(A\)&nbsp;
val10=Voici le dessin de la droite&nbsp;
val11=Quadrant
!if $val6=nl 
val7=De rechte \(d\) stelt de lineaire functie
val8=Het x-coordinaat van een punt \(A\) dat op de rechte \(d\) ligt is gelijk aan
val9=Stel je de rechte voor en zeg in welk kwadrant punt \(A\) ligt
val10=Hier is de grafiek van de rechte
val11=Kwadrant
!endif
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

tmp2=!randint 1, 3

tmp3=!randitem 1,-1

tmp4=!randitem $(tmp0)*$(tmp1),1/$(tmp2)*$(tmp3)

t_=!rawmath $(tmp4)
val12=!exec pari print($t_)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val12*($val13)
val14=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val12)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp0=!texmath $val15

val16=$(tmp0)
val17=I,II,III,IV

!ifval $val14>0 and $val13>0
tmp0=!item 1 of $val17

val18= $(tmp0)
!endif

!ifval $val14>0 and $val13<0
tmp0=!item 2 of $val17

val18= $(tmp0)
!endif

!ifval $val14<0 and $val13<0
tmp0=!item 3 of $val17

val18= $(tmp0)
!endif

!ifval $val14<0 and $val13>0
tmp0=!item 4 of $val17

val18= $(tmp0)
!endif
choicename1=$val11
choicegood1=$val18
choicebad1=$val17
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<p class="wimscenter">
!insmath x \mapsto $val16
$(). </p>	$val8 $val13.	$val9:	<div class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	text black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 
$()	</div>
$()
!exit

:hint
$()$val10:	<div class="wimscenter">  
!read oef/draw.phtml 200,200 \
xrange -8.2,8.2	yrange -8.2,8.2	parallel -8,-8,8,-8,0,1,20, grey	parallel -8,-8,-8,8,1,0,20, grey	hline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	vline 0,0,black	text black, 5,7,medium,(I)	 text black,-7,7,medium,(II)	 text black,-7,-5,medium,(III)	 text black,5,-5,medium,(IV)	 plot red , $val12*x	 
$()	</div>
$()
!exit

