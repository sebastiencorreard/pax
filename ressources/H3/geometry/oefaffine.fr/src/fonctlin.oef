\title{Fonction linéaire 1}
\title_nl{Lineaire functie}

\text{name_enonce=Déterminer l'expression \(f(x)\) de la fonction
  linéaire \(f\) sachant que}

\if{\lang=nl}{

\text{name_enonce=Bepaal \(f(x)\) voor de linear functie \(f\) als}

}

\rational{a=random(1,-1)*randint(1..5)/randint(1..3)}
\rational{b=random(1,-1)*randint(2..8)}
\text{u=simplify((\b)/(\a)*x)}
\statement{\name_enonce \(f(\a) = \b\).}
\answer{\(f(x)\)}{\u,x}{type=formal}

