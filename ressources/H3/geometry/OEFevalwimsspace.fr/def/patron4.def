!set title=Patron de solide 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Parmi les figures suivantes, lesquelles sont des	  patrons de pyramides&nbsp;
val9=
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in 9,src/pcarre.don,src/fpcarre.don	2,src/ptriangle.don,src/fptriangle.don

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
!if $val10=1 
tmp0=!randint 1, $(val11[1])

tmp1=!randint 1, $(val11[1])

val9=1,$(tmp0),$(val11[2])	2,$(tmp1),$(val11[3])
!else
tmp0=!values v for v=1 to $(val11[1])

val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
val9=1,$(val12[1]),$(val11[2])	1,$(val12[2]),$(val11[2])
!endif
tmp0=!randint 1, 9

tmp1=!randint 1, 5

tmp2=!randint 1, 11

tmp3=!randint 1, 8

val9=$val9	2,$(tmp0),src/patronpave.don	2,$(tmp1),src/fpatronpave.don	2,$(tmp2),src/patroncube.don	2,$(tmp3),src/fpatroncube.don
val13=$val8
val14=
val15=
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
val16=$[rint($(tmp0))]
!for val17 =1 to $val16 
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!record $(val18[2]) of $(val18[3])

val19=$(tmp0)
!readproc oef/draw.phtml 200,200 \
$val19 
tmp0=$ins_url
val20=$(tmp0)
val20=<img src='$val20' alt=''>
tmp0=!append item $val20 to $val14

val14=$(tmp0)

!ifval $(val18[1])=1
tmp0=!append item $val17 to $val15

val15=$(tmp0)
!endif
!next
replytype1=checkbox
replyoption1=shuffle split 
replyname1=
replygood1=$val15;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13?	 <ul class="inline">	  
!for m_j=1 to $val16 
$()	  <li> 
!read oef/embed.phtml r1,\j 
$()</li>	  
!next
$()	 </ul>	
$()
!exit

