!set title=Calcul de longueur 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=length, measurement

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=à l'unité,au dixième,au centième
val9=Si nécessaire, donner l'arrondi
val10=Quelle est la longueur de la diagonale d'un cube dont	  les arêtes mesurent
tmp=!nonempty items m,cm,dm

tmp0=!randitem $tmp
val11=$(tmp0)
val11=\mathrm{$val11}
tmp0=!randint 5, 9

val12=$(tmp0)
val13=$val10 $val12 \($val11\)&nbsp;&#63;
val14=sqrt(3)*$val12
tmp0=!randint 1, 3

val15=$[rint($(tmp0))]
tmp0=!item $val15 of $val8

val16=$(tmp0)
val14=$[rint(($val14)*10^($val15-1))/10^($val15-1)]
replytype1=numexp
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13	<div class="spacer">	<label for="reply1"><b>$val7</b> :</label>  
!read oef/embed.phtml r1,5 
$() 
!insmath $val11
$().	</div>	<div class="wims_instruction">$(val9[1]), $(val9[2]) $val16.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11,13,16
embedcnt=1
