!set title=Patron de solide 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Mettre en correspondance chaque nom de solide avec son patron.
val9=Cube,Pavé droit, Pyramide à base carrée,Pyramide à base triangulaire
tmp0=!randint 1, 11

tmp1=!randint 1, 9

tmp2=!randint 1, 9

tmp3=!randint 1, 2

val10=$(val9[1]),$(tmp0),src/patroncube.don	  $(val9[2]),$(tmp1),src/patronpave.don	  $(val9[3]),$(tmp2),src/pcarre.don	  $(val9[4]),$(tmp3),src/ptriangle.don
val11=
val12=
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
val13=$[rint($(tmp0))]
!for val14 =1 to $val13 
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!record $(val15[2]) of $(val15[3])

val16=$(tmp0)
!readproc oef/draw.phtml 100,100 \
$val16 
tmp0=$ins_url
val17=$(tmp0)
val17=<img src="$val17" alt="">
tmp0=!append item $val17 to $val12

val12=$(tmp0)
tmp0=!append item $(val15[1]) to $val11

val11=$(tmp0)
!next
replytype1=correspond
replyoption1=shuffle split 
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8	<div class="wimscenter"> 
!read oef/embed.phtml r1,100x100x100 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
