!set title=Formule d'aire 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=area, measurement

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Tapez, pour
val9=Quelle est la mesure de l'aire d'un parallélogramme dont la mesure	  de deux côtés opposés est,et dont la distance entre ces deux côtés mesure
tmp0=!shuffle A,B,C,D,E,F

val10=$(tmp0)
val11=$(val9[1]) \($(val10[1])\) $(val9[2]) \($(val10[2])\)&nbsp;
val12=$(val10[1])*$(val10[2])
replytype1=algexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11?	<div class="spacer">	<label for="reply1"><b>$val7</b> :</label>  
!read oef/embed.phtml r1,5 
$()	</div>	<div class="wims_instruction">	$(val8[1]) <span class="tt">pi</span> $(val8[2]) 
!insmath \,\pi
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11
embedcnt=1
