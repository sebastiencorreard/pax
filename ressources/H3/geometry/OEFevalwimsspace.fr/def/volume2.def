!set title=Volume d'un solide 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=volume, measurement

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=à l'unité,au dixième,au centième
val9=Si nécessaire, donner l'arrondi
val10=Quelle est la mesure du volume d'un pavé dont la longueur mesure,	 la largeur,et la hauteur
tmp=!nonempty items m,cm,dm

tmp0=!randitem $tmp
val11=$(tmp0)
val11=\mathrm{$val11}
tmp0=!randint 7, 11

val12=$[rint($(tmp0))]
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
tmp0=!randint 3, 7

val14=$[rint($(tmp0))]
val15=$(val10[1]) $val12 \($val11\),	  $(val10[2]) $val13 \($val11\) $(val10[3]) $val14 \($val11\)&nbsp;&#63;
val16=$val12*$val13*$val14
tmp0=!randint 1, 3

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val8

val18=$(tmp0)
val16=$[rint(($val16)*10^($val17-1))/10^($val17-1)]
replytype1=numexp
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val15	<div class="spacer">	<label for="reply1"><b>$val7</b> :</label>  
!read oef/embed.phtml r1,5 
$() 
!insmath $val11^3
$().	</div>	<div class="wims_instruction">$val9 $val18.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11,15,18
embedcnt=1
