val9=est une pyramide régulière de sommet S, de hauteur (SO) et dont la base est	  un carré de centre O. La représentation en perspective cavalière de	  cette pyramide est donnée ci-contre.
tmp0=!shuffle A,B,C,D,E,F,G,H,J,K,L,M,N

val10=$(tmp0)
val11=$(val10[1])
val12=$(val10[2])
val13=$(val10[3])
val14=$(val10[4])
val15=$(val10[5])
val16=$(val10[6])
val17=$(val10[7])
val18=$(val10[8])
tmp0=!randint 300, 400

val19=$[rint($(tmp0))]
val20=$[rint($val19)]
val21=$[rint($val19/2+10)]
val22=$[rint($val21+$val20)]
val23=$[rint($val21+$val19)]
val24=$[0.6]
val25=$[rint(20+$val24*($val21+$val20)/2)]
val26=$[rint(20+$val24*$val21/2)]
val27=segment 20,($val19+$val21)*$val24+20,20+$val20*$val24,($val19+$val21)*$val24+20,black	segment 20+$val20*$val24,($val19+$val21)*$val24+20,20+$val24*($val21+$val20),20+$val19*$val24,black	dsegment 20+$val24*($val21+$val20),20+$val19*$val24,($val21)*$val24+20,20+$val19*$val24,black	dsegment ($val21)*$val24+20,20+$val19*$val24,20,($val19+$val21)*$val24+20,black	segment $val25,$val26,20,20+$val24*($val19+$val21),black	segment $val25,$val26,20+$val20*$val24,20+$val24*($val19+$val21),black	segment $val25,$val26,20+($val20+$val21)*$val24,20+$val24*($val19),black	dsegment $val25,$val26,20+($val21)*$val24,20+$val24*$val19,black	dsegment 20,($val19+$val21)*$val24+20,20+$val24*($val21+$val20),20+$val19*$val24,green	dsegment ($val21)*$val24+20,20+$val19*$val24,20+$val20*$val24,($val19+$val21)*$val24+20,green	text black,$val25-3,$val26-15,medium,S	text black,$val25-5,$val26+$val19*$val24+10,medium,O	text black,10,10+($val21+$val19)*$val24,medium,$val11	text black,10+$val21*$val24,10+$val19*$val24,medium,$val12	text black,30+($val21+$val20)*$val24,10+$val19*$val24,medium,$val13	text black,30+$val20*$val24,10+($val21+$val19)*$val24,medium,$val14
val28=S$val11$val12$val13$val14 $val9
tmp0=!shuffle ($val11$val12)//($val14$val13),($val11$val14)//($val12$val13),($val12$val11)//($val13$val14),($val14$val11)//($val13$val12)

val29=$(tmp0)
tmp0=!shuffle (SO)//($val11$val14),($val11$val13)//($val14$val12),($val11$val12)//($val14$val11),(S$val11)//($val12$val13)

val30=$(tmp0)
tmp0=!randint 1, 3

val31=$[rint($(tmp0))]
val32=$[rint(5)]
