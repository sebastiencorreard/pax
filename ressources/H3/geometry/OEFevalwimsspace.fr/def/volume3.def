!set title=Volume d'un solide 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=volume, measurement

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=à l'unité,au dixième,au centième
val9=Si nécessaire, donner l'arrondi
val10=Quelle est la mesure du volume d'une pyramide de hauteur,	  et dont la base est un carré de côté
tmp=!nonempty items m,cm,dm

tmp0=!randitem $tmp
val11=$(tmp0)
val11=\mathrm{$val11}
tmp0=!randint 3, 9

val12=$[rint($(tmp0))]
tmp0=!randint 11, 19

val13=$[rint($(tmp0))]
val14=$(val10[1]) $val13 \($val11\) $(val10[2]) $val12 \($val11\)&nbsp;&#63;
val15=$val12^2*$val13/3
tmp0=!randint 1, 3

val16=$[rint($(tmp0))]
tmp0=!item $val16 of $val8

val17=$(tmp0)
val15=$[rint(($val15)*10^($val16-1))/10^($val16-1)]
replytype1=numexp
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14	<div class="spacer">	<label for="reply1"><b>$val7</b> :</label>  
!read oef/embed.phtml r1,5 
$() 
!insmath $val11^3
$().	</div>	<div class="wims_instruction">$val9 $val17.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11,14,17
embedcnt=1
