!set title=Patron de solide 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Parmi les figures suivantes, lesquelles	  sont des patrons de solides&nbsp;
val9=
tmp=!translate internal $	$ to ; in 1,2,2	1,1,2	1,1,1

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!item $(val10[1]) of 11,8

val11=$[rint($(tmp0))]
tmp0=!item $(val10[1]) of src/patroncube.don,src/fpatroncube.don

val12=$(tmp0)
tmp0=!randint 1, $val11

tmp1=!append line $(val10[1]),$(tmp0),$val12 to $val9

val9=$(tmp1)
tmp0=!item $(val10[2]) of 9,5

val11=$[rint($(tmp0))]
tmp0=!item $(val10[2]) of src/patronpave.don,src/fpatronpave.don

val12=$(tmp0)
tmp0=!randint 1, $val11

tmp1=!append line $(val10[2]),$(tmp0),$val12 to $val9

val9=$(tmp1)
tmp0=!item $(val10[3]) of src/pcarre.don,src/fpcarre.don

val12=$(tmp0)
tmp0=!randint 1, 9

tmp1=!append line $(val10[3]),$(tmp0),$val12 to $val9

val9=$(tmp1)
val13=$val8
val14=
val15=
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
val16=$[rint($(tmp0))]
!for val17 =1 to $val16 
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!record $(val18[2]) of $(val18[3])

val19=$(tmp0)
!readproc oef/draw.phtml 200,200 \
$val19 
tmp0=$ins_url
val20=$(tmp0)
val20=<img src='$val20' alt=''>
tmp0=!append item $val20 to $val14

val14=$(tmp0)

!ifval $(val18[1])=1
tmp0=!append item $val17 to $val15

val15=$(tmp0)
!endif
!next
replytype1=checkbox
replyoption1=shuffle split 
replyname1=
replygood1=$val15;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13?	 <ul class="inline">	  
!for m_j=1 to $val16 
$()	  <li> 
!read oef/embed.phtml r1,\j 
$()</li>	  
!next
$()	 </ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

