!set title=Droites remarquables QCM
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=marie-claude.david@math.u-psud.fr
title_en=Droites remarquables QCM

ansorder=c
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
val11=la droite passant par \($val7\) et le milieu \($val7'\) du côté \([$val8$val9]\).,	la droite passant par \($val7\) et perpendiculaire au côté \([$val8$val9]\).,	la droite passant par le milieu \($val7'\) du côté \([$val8$val9]\) et perpendiculaire au côté \([$val8$val9]\).
val12=la médiane issue de \($val7\),	la hauteur issue de \($val7\),	la médiatrice du côté \([$val8$val9]\)
val13=Dans le triangle \($val7$val8$val9\) quelle est $(val12[$val10])
val14=est
choicename1=
choicegood1=$(val11[$val10])
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $(val12[$val10]) $val14 $(val11[$val10])


!goto stat

!exit

:question
$()$val13 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$(val12[$val10]) $val14 $(val11[$val10])
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14
embedcnt=0
