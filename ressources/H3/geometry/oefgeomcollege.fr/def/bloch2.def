!set title=Calcul d'aire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gwennaëlle, Bloch
email=gwennlbl@gmail.com
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
title_en=Calcul d'aire

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 3, 12

val7=$[rint($(tmp0)*18)]
tmp0=!randint 5, 10

val8=$[rint($(tmp0)*18)]
tmp0=!randint 3, ($val8/18-1)

val9=$[rint($(tmp0)*18)]
val10=$[rint(($val9-20)/18)]
val11=$[rint(($val7-20)/18)]
val12=$[rint(($val8-20)/18)]
!readproc oef/draw.phtml $val8+20,$val7+20 \
segment 20,20,$val9,20,black	segment 20,20,20,$val7,black	segment 20,$val7,$val8,$val7,black	segment $val9,20,$val8,$val7,black	text red,($val9+20)/2,5,medium,x	text black,6,($val7+20)/2,medium,$val11	text black,($val8+20)/2,$val7+5,medium,$val12	 
tmp0=$ins_url
val13=$(tmp0)
tmp=!translate ";': to $     $ in $val11/2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
tmp=!translate ";': to $     $ in ($val11*$val12)/2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
val16=$[(($val10+$val12)/2)*$val11]
val17=On considère le trapèze ci-contre.
val18=Exprimer l'aire \(A\) de ce trapèze droit en fonction de \(x\).
val19=Quelle valeur faut-il donner à \(x\) pour que l'aire \(A\)	  soit égale à $val16 cm² ? 
!if $val6=en 
val17=On considère le trapèze ci-contre.
val18=Exprimer l'aire \(A\) de ce trapèze droit en fonction de \(x\).
val19=Quelle valeur faut-il donner à \(x\) pour que l'aire \(A\)	  soit égale à $val16 cm²? 
!endif
replytype1=litexp
replyname1=
replygood1=$val14*x+$val15
replytype2=numexp
replyname2=
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val13" alt=""></div>	 <div class="medium_size text_col">	$val17	<p>	$val18	</p>	<div class="wimscenter">
!insmath A
$()= 
!read oef/embed.phtml r1 
$()</div>	<p>	$val19	</p>	<div class="wimscenter">
!insmath x
$()= 
!read oef/embed.phtml r2 
$()</div>	</div></div>	
$()
!exit

