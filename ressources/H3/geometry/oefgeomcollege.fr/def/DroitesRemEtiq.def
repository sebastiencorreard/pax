!set title=Droites remarquables (étiquette)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=marie-claude.david@math.u-psud.fr
language=fr
title_en=Droites remarquables (étiquette)

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=bissectrice.png,bissectrice	mediane.png,médiane	mediatrice.png,médiatrice	hauteur.png, hauteur
val7=$[rint(3)]
val8=40
val9=200
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Clique sur le mot correspondant à l'image.
val12=bissectrice,médiane,médiatrice,hauteur
!if $val10=en 
val11=Clique sur le mot correspondant à l'image.
val12=bissectrice,médiane,médiatrice,hauteur
!endif
!if $val12!= 
val6=bissectrice.png,$(val12[1])	mediane.png,$(val12[2])	mediatrice.png,$(val12[3])	hauteur.png,$(val12[4])
!endif
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$(val13[1])
tmp0=!lowercase $val14

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val15=$(tmp2)
val13=$(val13[2])
tmp=!translate internal $	$ to ; in  $val6

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp0=!listcomplement $val13 in $val16

val17=$(tmp0)
tmp0=!shuffle $val17

val17=$(tmp0)
val17=$(val17[1..$val7])
replytype1=clickfill
replyname1=
replygood1=$val13;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11	<p class="wimscenter">	
!if $val15 isitemof png,gif,jpg,jpeg 
$()	   
!read oef/img.phtml $val1/$val14  
$()	   
!else
$()	   $val14 
!endif
$()</p>	<p class="wimscenter">	 
!read oef/embed.phtml r1,$val9 x $val8 
$()	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,8,9,11,14,15
embedcnt=1
