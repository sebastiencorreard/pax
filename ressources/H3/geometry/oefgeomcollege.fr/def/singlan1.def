!set title=Somme des angles d'un triangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gaëlle, Singlan
email=gaelle.singlan@orange.fr
language=fr
computeanswer=no
leftrange=-5.000000
rightrange=5.000000
precision=10000
title_en=Somme des angles d'un triangle

ansorder=r,c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=est,n'est pas
tmp=!trim On a les mesures suivantes	  Calculer la somme suivante	  Donc le triangle	  constructible
val8=!translate internal $	\
$ to ;; in $tmp
!if $val6=en 
val7=est,n'est pas
tmp=!trim On a les mesures suivantes	  Calculer la somme suivante	  Donc le triangle	  constructible
val8=!translate internal $	\
$ to ;; in $tmp
!endif
val9=A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P,K,R,S,T,U,V,W,X,Y,Z
tmp0=!shuffle $val9

val10=$(tmp0)
tmp0=!randint 10, 80

val11=$[rint($(tmp0))]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val12=$(tmp0)
!if $val12=1 
tmp0=!randint 10, 80

val13=$[rint($(tmp0))]
val14=$[rint(180-$val11-$val13)]
val15=$(val7[1])
!else
tmp0=!randint 10, 80

val13=$[rint($(tmp0))]
tmp0=!randint (170-$val11-$val13), (190-$val11-$val13)

val14=$[rint($(tmp0))]

!ifval $val14=180-$val11-$val13
val14=$[rint( $val14+2)]
!endif
val15=$(val7[2])
!endif
tmp0=!shuffle $val11,$val13,$val14

val16=$(tmp0)
val17=$[rint($val11 + $val13 + $val14)]
replytype1=numexp
replyname1=
replygood1=$val17
choiceoption1=shuffle 
choicename1=
choicegood1=$val15
choicebad1=$(val7[1]),$(val7[2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1;]) :	<ul>	  <li> 
!insmath \widehat{$(val10[1])$(val10[2])$(val10[3])} = $(val16[1])
$() ° </li>	  <li> 
!insmath \widehat{$(val10[2])$(val10[3])$(val10[1])} = $(val16[2])
$() ° </li>	  <li> 
!insmath \widehat{$(val10[3])$(val10[1])$(val10[2])} = $(val16[3])
$() ° </li>	</ul>	<br> $(val8[2;]) :	<br> 
!insmath \widehat{$(val10[1])$(val10[2])$(val10[3])} + \widehat{$(val10[2])$(val10[3])$(val10[1])} + \widehat{$(val10[3])$(val10[1])$(val10[2])} =
$()  
!read oef/embed.phtml r1,20x10 
$()	<br> $(val8[3;]) $(val10[1])$(val10[2])$(val10[3])  
!read oef/embed.phtml c1,20x20 
$() $(val8[4;]).	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
