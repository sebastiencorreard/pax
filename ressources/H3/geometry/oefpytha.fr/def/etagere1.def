!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Toto a posé une boule sur son étagère.	  Mais la planche n'est peut-être pas horizontale.
val8=Le dessin n'est pas à l'échelle.
val9=Les dimensions de l'étagère sont
val10=La boule roule vers l'intérieur de l'étagère.,	  La boule reste en place.,	  La boule tombe par terre.
val11=Toto a mesuré que
val12=Que va faire la boule&nbsp;
!if $val6=it 
val7=Toto a posé une boule sur son étagère.	  Mais la planche n'est peut-être pas horizontale.
val8=Le dessin n'est pas à l'échelle.
val9=Les dimensions de l'étagère sont
val10=La boule roule vers l'intérieur de l'étagère.,	  La boule reste en place.,	  La boule tombe par terre.
val11=Toto a mesuré que
val12=Que va faire la boule&nbsp;
!endif
!if $val6=nl 
val7=Toto a posé une boule sur son étagère.	  Mais la planche n'est peut-être pas horizontale.
val8=Le dessin n'est pas à l'échelle.
val9=Les dimensions de l'étagère sont
val10=La boule roule vers l'intérieur de l'étagère.,	  La boule reste en place.,	  La boule tombe par terre.
val11=Toto a mesuré que
val12=Que va faire la boule&nbsp;
!endif
val13=xrange -1,5	yrange -1,5	dashed	segments red,3,0,0,4	linewidth 3	segments black,0,0,0,4,0,0,3,0	text black,0,-0.3,large,A	text black,3,-0.3,large,B	text black,0.2,4,large,C	linewidth 1	fcircles blue,2,0.2,0.2
tmp0=!randint 300, 600

val14=$(tmp0)
tmp0=!randint 100, 150

val15=$(tmp0)
val16=25
t_=!replace internal \( by ( in pyth(A,B,lim)={for(a=A+B,A+lim+B, for(b=a,a+lim,N=sqrt(a^2+b^2); if(floor(N)==N, return([a,b,floor(N)]))))}
tmp0=!exec pari $t_

val17=$(tmp0)
t_=!replace internal \( by ( in lim=25; pyth($val14,$val15,lim)
tmp0=!exec pari $t_

val18=$(tmp0)

!ifval $(val18[1])==0
t_=!replace internal \( by ( in lim1=100; pyth($val14,$val15+lim,lim1)
tmp0=!exec pari $t_

val18= $(tmp0)
!endif

!ifval $(val18[1])==0
val18= erreur
!endif
val15=$[$(val18[1])]
val19=$[$(val18[2])]
val14=$[$(val18[3])]
tmp=!nonempty items 1,1,-1,-1,0

tmp0=!randitem $tmp
val20=$(tmp0)
tmp0=!randint 1, 3

val21=$[$val14+$val20*$(tmp0)]
t_=!replace internal \( by ( in [$val15,$val19,$val14,$val21]/10.
tmp0=!exec pari $t_

val22=$(tmp0)
val23=$val10
val24=$[rint($val20+2)]
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val25=$(tmp0)
tmp0=!replace internal Toto by $val25 in $val7

val26=$(tmp0)
tmp0=!replace internal Toto by $val25 in $val11

val27=$(tmp0)
replytype1=radio
replyname1=
replygood1=$val24;$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

