tmp=!nonempty items $val7

tmp0=!randitem $tmp
val7=$(tmp0)
val8=Un avion vole au dessus de XXXX.	Il doit atterrir dans un aéroport situé à YYYY km de la ville.	Pour descendre, il parcourt ZZZZ km.
val9=À quelle altitude volait-il quand il était au dessus de la ville&nbsp;
!if $val6=it 
val7=Metropolis,Springfield, El Dorado
tmp=!nonempty items $val7

tmp0=!randitem $tmp
val7=$(tmp0)
val8=Un avion vole au dessus de XXXX.	Il doit atterrir dans un aéroport situé à YYYY km de la ville.	Pour descendre, il parcourt ZZZZ km.
val9=À quelle altitude volait-il quand il était au dessus de la ville&nbsp;
!endif
!if $val6=nl 
val7=Metropolis,Springfield, El Dorado
tmp=!nonempty items $val7

tmp0=!randitem $tmp
val7=$(tmp0)
val8=Un avion vole au dessus de XXXX.	Il doit atterrir dans un aéroport situé à YYYY km de la ville.	Pour descendre, il parcourt ZZZZ km.
val9=À quelle altitude volait-il quand il était au dessus de la ville&nbsp;
!endif
tmp0=!randint 100, 200

val10=$(tmp0)
tmp0=!randint 100, 200

val11=$(tmp0)
t_=!replace internal \( by ( in pyth(A,B,lim)={for(a=A+B,A+lim+B, for(b=a,a+lim,N=sqrt(a^2+b^2); if(floor(N)==N, return([a,b,floor(N)]))))}
tmp0=!exec pari $t_

val12=$(tmp0)
t_=!replace internal \( by ( in lim=25; pyth($val10,$val11,lim)
tmp0=!exec pari $t_

val13=$(tmp0)

!ifval $(val13[1])==0
t_=!replace internal \( by ( in lim1=100; pyth($val10,$val11+lim,lim1)
tmp0=!exec pari $t_

val13= $(tmp0)
!endif

!ifval $(val13[1])==0
val13= erreur
!endif
tmp0=!sort item $val13

val12=$(tmp0)
t_=!replace internal \( by ( in [$val12]/10.
tmp0=!exec pari $t_

val12=$(tmp0)
tmp0=!replace internal XXXX by $val7 in $val8

val14=$(tmp0)
tmp0=!replace internal YYYY by $(val12[2]) in $val14

val14=$(tmp0)
tmp0=!replace internal ZZZZ by $(val12[3]) in $val14

val14=$(tmp0)
tmp0=!replace internal XXXX by $val7 in $val9

val15=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$(val12[1])]
