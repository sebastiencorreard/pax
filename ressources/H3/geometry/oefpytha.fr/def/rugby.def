!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=À quelle distance du milieu des poteaux se trouve le ballon,	  À quelle distance du centre du terrain se trouve le ballon,	  L'entraîneur veut donner un conseil à son joueur. Quelle distance sépare le joueur de l'entraîneur
val8=L'essai a été marqué à, mètres du poteau de corner. ,	  Le joueur décide de se placer à, mètres de la ligne d'essai.
val9=La distance en mètre est d'environ
val10=Votre réponse est juste à 0.5 mètre près
val11=Votre réponse est juste et respecte la consigne d'approximation
val12=Votre réponse respecte la consigne d'approximation
val13=La bonne réponse est,mètres.
val14=Donner la réponse (en mètres) sous forme de l'entier	  le plus proche.
!if $val6=it 
val7=A che distanza dal centro dei pali si trova la palla,	  A che distanza dal centro del campo si trova la palla,	  L'allenatore vuole dare consigli al giocatore. Qual è la distanza tra il giocatore e l'allenatore
val8=La meta è stata assegnata a, metri dal bordo del campo.,	  Il giocatore decide di posizionarsi a una distanza di, metri dalla linea di metà.
val9=La distanza approssimativa in metri
val10=La risposta data è approssimata a 0.5 metri
val11=La risposta data è corretta e nel margine di approssimazione richiesto
val12=La risposta data è effettivamente un'approssimazione come richiesto
val13=La risposta corretta è,metri.
val14=Dare la risposta (in metri) approssimando all'intero più vicino.
!endif
!if $val6=nl 
val7=À quelle distance du milieu des poteaux se trouve le ballon,	  À quelle distance du centre du terrain se trouve le ballon,	  L'entraîneur veut donner un conseil à son joueur. Quelle distance sépare le joueur de l'entraîneur
val8=L'essai a été marqué à, mètres du poteau de corner. ,	  Le joueur décide de se placer à, mètres de la ligne d'essai.
val9=La distance en mètre est d'environ
val10=Votre réponse est juste à 0.5 mètre près
val11=Votre réponse est juste et respecte la consigne d'approximation
val12=Votre réponse respecte la consigne d'approximation
val13=La bonne réponse est,mètres.
val14=Donner la réponse (en mètres) sous forme de l'entier	  le plus proche.
!endif
tmp0=!randint 1, 24

val15=$[rint($(tmp0))]
tmp0=!randint 0, 8

val16=$[rint(22+$(tmp0))]
val17=$[sqrt($val16*$val16+(35-$val15)*(35-$val15))]
val18=$[sqrt((50-$val16)*(50-$val16)+(35-$val15)*(35-$val15))]
val19=$[sqrt((50-$val16)*(50-$val16)+(70-$val15)*(70-$val15))]
tmp=!trim $(val7[1]), $val17	$(val7[2]), $val18	$(val7[3]), $val19
val20=!translate internal $	\
$ to ;; in $tmp
val21=rugby.png
tmp=!translate internal $	$ to ; in $val20

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val22=$(tmp1)
val23=$(val20[$val22;1])
val24=$[$(val20[$val22;2])]
val25=$[rint(round($val24))]
replytype1=numeric
replyoption1=absolute 
replyname1=$val9
replygood1=?analyze 26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

