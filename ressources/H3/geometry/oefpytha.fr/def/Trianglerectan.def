!set title=Triangle rectangle et cercle circonscrit 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu,XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Triangolo rettangolo e cerchio circoscritto 
title_nl=Omgeschreven cirkel 

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=mesure,et,Combien mesure,en
!if $val6=it 
val7=misura,e,Quanto misura,in
!endif
!if $val6=nl 
val7=is,en,Hoe lang is ,in
!endif
tmp=!trim 3,4,5	6,8,10	9,12,15	12,16,20	15,20,25	5,12,13	7,24,25	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)
tmp0=!item 3 of $val9

val12=$(tmp0)
val13=$[asin($val10/$val12)*2]
val14=$[cos($val13)*1.7]
val15=$[sin($val13)*1.7]
replyname1=\(AB\)
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">	 
!read oef/draw.phtml 200,200 \
	xrange -2,2	yrange -2,2	circle 0,0,175,red	segment -1.7,0,1.7,0,black	text black,-1.9,0.1,medium,A	text black,1.8,0.1,medium,B	polyline blue,-1.7,0,$val14,$val15,1.7,0	text black,$val14,$val15+0.3,medium,C	segment 0,-0.05,0,0.05,black	text black,-0.05,0.28,medium,O	 
$()	</div>	
!insmath AC
$() $(val7[1]) 
!insmath $val11 \mathrm{cm}
$() $(val7[2]) 
!insmath BC
$()	$(val7[1]) 
!insmath $val10 \mathrm{cm}
$(). $(val7[3]) 
!insmath AB
$() ($(val7[4]) 
!insmath \mathrm{cm}
$())?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,14,15
embedcnt=0
