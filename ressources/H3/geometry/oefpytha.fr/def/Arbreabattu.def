!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Un arbre a été abattu par la foudre. Quelle était sa hauteur avant, en
val8=La hauteur de l'arbre
val9=La souche, le tronc et le sol forment un triangle rectangle,	  l'hypoténuse symbolisé par le tronc coupé.
val10=On utilise le théorème de Pythagore.,On note&nbsp;,	  la hauteur du tronc coupé,	  la hauteur de la souche,	  la longueur au sol
val11=On a alors la formule&nbsp;,	  D'où la hauteur de l'arbre est&nbsp;,
!if $val6=it 
val7=Un albero è stato abbattuto da un fulmine. Quale era la sua altezza,in
val8=L'altezza dell'albero
val9=Il ceppo, il tronco e il terreno formano un triangolo rettangolo, la cui	  ipotenusa è il pezzo di tronco tagliato.
val10=Utilizziamo il teorema di Pitagora.,Si ha,	  l'altezza del pezzo di tronco tagliato,	  l'altezza del ceppo,	  la distanza sul terreno
val11=Si ha allora la formula,	  Da cui si ricava che l'altezza dell'albero era,
!endif
!if $val6=nl 
val7=Een boom is omgeknakt door de bliksem. Hoe hoog was de boom daarvoor, in
val8=De hoogte van de boom
val9=La souche, le tronc et le sol forment un triangle rectangle,	  l'hypoténuse symbolisé par le tronc coupé.
val10=On utilise le théorème de Pythagore.,On note&nbsp;,	  la hauteur du tronc coupé,	  la hauteur de la souche,	  la longueur au sol
val11=On a alors la formule&nbsp;,	  D'où la hauteur de l'arbre est&nbsp;,
!endif
tmp=!trim 4,3,8	8,6,16	12,9,24	16,12,32	20,15,40	12,5,18	24,7,32
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!item 2 of $val13

val15=$(tmp0)
tmp0=!item 3 of $val13

val16=$(tmp0)
val17=$[sqrt($val14^2+$val15^2)]
val18=$[$val17+$val15]
replyname1=$val8
replygood1=$val16
