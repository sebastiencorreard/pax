!set title=Calculer un angle à partir de son cosinus
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand; Paul, Byache
email=paul@byache.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
oefobservation=Utiliser sa calculatrice pour trouver la mesure d'un angle connaissant son cosinus. D'autres exercices de F. Guerimand existent, qui ne se limitent pas au cosinus.
computeanswer=no
precision=100000

ansorder=r
varcnt=34
prevarcnt=32
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=90x35x1

!ifval $val2 notitemof 0,1
val2=$[rint(1)]
!endif
tmp=!trim A,B,C	T,I,R	E,F,G	D,E,F
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
val11=$[rint(240)]
val12=$[rint(140)]
tmp=!trim $val8,$val10	$val10,$val8
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!item 2 of $val13

val15=$(tmp0)
val16=segment 20,20,20,120,black	segment 20,120,220,120,black	segment 20,20,220,120,black	segment 21,110,30,110,red	segment 30,110,30,119,red	text black,10,115,medium,$val9	text black,10,10,medium,$val14	text black,230,115,medium,$val15
val17=\widehat{$val9$val8$val10}
val17=\($val17)
val18=cos
val19=le cosinus
val20=arccos
val21=\(\cos($val17))
tmp0=!randint 500

val22=$[rint($(tmp0))]
val22=$[$val22/1000]
val23=$val20($val22)*180/pi
tmp0=!randint 1, 3

val24=$[rint($(tmp0))]
val25=degré,dixième de degré,centième de degré
tmp0=!item $val24 of $val25

val25=$(tmp0)
val26=$[rint($val23*10^($val24-1))]
val27=$[$val26/10^($val24-1)]
val22=$[rint($val22*10^($val24+2))]
val22=$[$val22/10^($val24+2)]
val28=<ul class="nopuce"><li>Le triangle \($val8$val9$val10) est rectangle en \($val9).</li>	<li>Le cosinus de l'angle $val17 vaut environ $val22.</li></ul>	<p>Quel est l'arrondi, au $val25, de la mesure de l'angle $val17
replytype1=litexp
replyname1=Réponse
replygood1=$val27
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val2=1 
$()	<div class="float_right">	 
!read oef/draw.phtml $val11,$val12 \
$val16 
$()<div class="wims_instruction">	   Le dessin n'est pas à l'échelle.	   </div>	</div>	$val28 ?</p>	<div>Réponse :  
!read oef/embed.phtml r1	autocomplete="off" 
$()	</div> 
!endif
$()	
$()
!exit

:hint
$()Utiliser la touche "Arccos" ou "
!insmath cos^-1
$()" de votre calculatrice.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val29=$[abs($val27-$m_reply1)]

!exit

:feedback
!ifval $val29<=0.1 and $val27<>$m_reply1
 <div class='oef_feedbacks'><span class="oef_indbad">Avez-vous	bien arrondi votre résultat ?</span>
$()</div>
!endif

!exit

:test
condoption1=hide 

!ifval $val29<=0.1
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=2,11,12,16,27,28
embedcnt=1
