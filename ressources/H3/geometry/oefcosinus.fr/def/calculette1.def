!set title=Calculette et cosinus 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand; Paul, Byache
email=paul@byache.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000
oefobservation=Calculer une mesure d'angle à la calculatrice à partir d'un cosinus. D'autres exercices similaires de F. Guerimand existent, qui ne se limitent pas au cosinus. Voir le module "OEF Trigonométrie 1" ( H3/geometry/oeftrigo2.fr )

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 10,100,1000,10000

val6=$[rint($(tmp0))]
val7=$[1/$val6]
val8=cos
val9=
val10=
val11=
!for val12 =1 to 3 
tmp0=!randint 15, 75

val13=$[rint($(tmp0))]
val14=$val8
val15=$[$val14($val13/180*pi)]
tmp0=!append item $val15 to $val11

val11=$(tmp0)
val16=$[rint($val14($val13/180*pi)*$val6)]
val16=$[$val16/$val6]
tmp0=!append item $val16 to $val9

val9=$(tmp0)
val16=$val14($val13)
tmp0=!append item $val16 to $val10

val10=$(tmp0)
!next
val11=$[$(val11[1])]
val17=$[floor($val11*$val6)/$val6]
val18=$[(floor($val11*$val6)+1)/$val6]
replytype1=numexp
replyname1=\($(val10[1]))
replygood1=$(val9[1])
replytype2=numexp
replyname2=\($(val10[2]))
replygood2=$(val9[2])
replytype3=numexp
replyname3=\($(val10[3]))
replygood3=$(val9[3])
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst La valeur de $(val10[1]) est environ : $val11. Pour arrondir cette valeur à $val7 degré près, on doit choisir entre $val17 et $val18 ...


!goto stat

!exit

:question
$()A l'aide de la calculette, donner les valeurs arrondies à $val7 de :	<ul class="wims_nopuce">	  <li>
!insmath $(val10[1])
$() =   
!read oef/embed.phtml r1,10	autocomplete="off" 
$() </li>	 <li>
!insmath $(val10[2])
$() =  
!read oef/embed.phtml r2,10	autocomplete="off" 
$() </li>	  <li>
!insmath $(val10[3])
$() =  
!read oef/embed.phtml r3,10	autocomplete="off" 
$()</li>	</ul>	
$()
!exit

:hint
$()La valeur de $(val10[1]) est environ : $val11. Pour arrondir cette valeur à $val7 degré près, on doit choisir entre $val17 et $val18 ...
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,17,18
embedcnt=3
