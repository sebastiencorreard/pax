\title{Calculer un cosinus dans un triangle rectangle}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand; Paul, Byache}
\email{paul@byache.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\observation{Calculer un cosinus à la calculatrice. D'autres exercices similaires de F. Guerimand existent, qui ne se limitent pas au cosinus}
\text{size=90x35x1}
\integer{confparm1=\confparm1 notitemof 0,1?1}

\matrix{lettre=A,B,C
T,I,R
E,F,G
D,E,F}
\text{lettre=randrow(\lettre)}
\text{lettre=shuffle(\lettre)}
\text{X1=item(1,\lettre)}
\text{X2=item(2,\lettre)}
\text{X3=item(3,\lettre)}

\integer{xrange=240}
\integer{yrange=140}

\matrix{chdes=\X1,\X3
\X3,\X1}
\text{chdes=randrow(\chdes)}
\text{Y1=item(1,\chdes)}
\text{Y2=item(2,\chdes)}
\text{dessin=segment 20,20,20,120,black
segment 20,120,220,120,black
segment 20,20,220,120,black
segment 21,110,30,110,red
segment 30,110,30,119,red
text black,10,115,medium,\X2
text black,10,10,medium,\Y1
text black,230,115,medium,\Y2}
\integer{l1=random(25..100)}
\real{l1=\l1/10}
\integer{l2=random(25..100)}
\integer{l2=\l2=\l1?112}
\real{l2=\l2/10}
\text{angle=\widehat{\X2\X1\X3}}
\text{angle=\(\angle)}

\if{\l1>\l2}{\real{tmp=\l1}\real{l1=\l2}\real{l2=\tmp}}

\text{fonct=cos}
\text{nom=le cosinus}
\text{rfonct=arccos}
\text{num=\(\X1\X2)}
\text{den=\(\X1\X3)}
\text{eq1=\(\cos(\angle))}
\real{xxx=\l1/\l2}
\text{res=\rfonct(\l1/\l2)*180/pi}
\text{val=\eq1,\den,\num,\l2,\l1}
\integer{prec=random(2..3)}
\text{precision=blablabla,dixième,centième}
\text{precision=item(\prec,\precision)}
\integer{tmp=\xxx*10^(\prec-1)}
\real{sol=\tmp/10^(\prec-1)}
\text{data=random(\num = \l1 et \den = \l2,\den = \l2 et \num = \l1)}
\text{enonce=Le triangle \(\X1\X2\X3) est rectangle en \(\X2) et on a \data <p>Quel est l'arrondi, au \precision, du cosinus de l'angle \angle}

\statement{\if{\confparm1=1}{
<div class="float_right">
\draw{\xrange,\yrange}{\dessin}
<div class="wims_instruction">Le dessin n'est pas à l'échelle.
</div>
</div>
}
\enonce ?</p>
<div>Réponse : \embed{r1
autocomplete="off"}
</div>
}
\answer{Réponse}{\sol}{type=litexp}
\hint{Utiliser la touche "cos" de votre calculatrice.}
\real{tt=abs(\sol-\reply1)}
\condition{}{\tt<=0.1}{option=hide}
\feedback{\tt<=0.1 and \sol<>\reply1}{<font color="red">Avez-vous bien arrondi votre résultat ?</font>}
