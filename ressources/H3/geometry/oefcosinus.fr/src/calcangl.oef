\title{Calculer un angle à partir de son cosinus}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand; Paul, Byache}
\observation{Utiliser sa calculatrice pour trouver la mesure d'un angle connaissant son cosinus. D'autres exercices de F. Guerimand existent, qui ne se limitent pas au cosinus.}
\email{paul@byache.fr}
\computeanswer{no}
\format{html}
\precision{100000}
\text{size=90x35x1}
\integer{confparm1=\confparm1 notitemof 0,1?1}

\matrix{lettre=A,B,C
T,I,R
E,F,G
D,E,F}
\text{lettre=randrow(\lettre)}
\text{lettre=shuffle(\lettre)}
\text{X1=item(1,\lettre)}
\text{X2=item(2,\lettre)}
\text{X3=item(3,\lettre)}

\integer{xrange=240}
\integer{yrange=140}

\matrix{chdes=\X1,\X3
\X3,\X1}
\text{chdes=randrow(\chdes)}
\text{Y1=item(1,\chdes)}
\text{Y2=item(2,\chdes)}
\text{dessin=segment 20,20,20,120,black
segment 20,120,220,120,black
segment 20,20,220,120,black
segment 21,110,30,110,red
segment 30,110,30,119,red
text black,10,115,medium,\X2
text black,10,10,medium,\Y1
text black,230,115,medium,\Y2}
\text{angle=\widehat{\X2\X1\X3}}
\text{angle=\(\angle)}

\text{fonct=cos}
\text{nom=le cosinus}
\text{rfonct=arccos}
\text{eq1=\(\cos(\angle))}
\integer{xxx=random(500)}
\real{xxx=\xxx/1000}

\text{res=\rfonct(\xxx)*180/pi}
\integer{prec=random(1..3)}
\text{precision=degré,dixième de degré,centième de degré}
\text{precision=item(\prec,\precision)}
\integer{tmp=\res*10^(\prec-1)}
\real{sol=\tmp/10^(\prec-1)}

\integer{xxx=\xxx*10^(\prec+2)}
\real{xxx=\xxx/10^(\prec+2)}

\text{enonce=<ul class="nopuce"><li>Le triangle \(\X1\X2\X3) est rectangle en \(\X2).</li>
<li>Le cosinus de l'angle \angle vaut environ \xxx.</li></ul>
<p>Quel est l'arrondi, au \precision, de la mesure de l'angle \angle}

\statement{\if{\confparm1=1}{
<div class="float_right">
\draw{\xrange,\yrange}{\dessin}<div class="wims_instruction">
   Le dessin n'est pas à l'échelle.
   </div>
</div>
\enonce ?</p>
<div>Réponse : \embed{r1
autocomplete="off"}
</div>}
}
\answer{Réponse}{\sol}{type=litexp}
\hint{Utiliser la touche "Arccos" ou "\(cos^-1)" de votre calculatrice.}
\real{tt=abs(\sol-\reply1)}
\condition{}{\tt<=0.1}{option=hide}
\feedback{\tt<=0.1 and \sol<>\reply1}{<span class="oef_indbad">Avez-vous
bien arrondi votre résultat ?</span>}
