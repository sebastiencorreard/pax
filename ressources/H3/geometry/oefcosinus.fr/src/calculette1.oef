\title{Calculette et cosinus 1}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand; Paul, Byache}
\email{paul@byache.fr}
\computeanswer{no}
\format{html}
\precision{100000}
\observation{Calculer une mesure d'angle à la calculatrice à partir d'un cosinus. D'autres exercices similaires de F. Guerimand existent, qui ne se limitent pas au cosinus. Voir le module "OEF Trigonométrie 1" ( H3/geometry/oeftrigo2.fr )}

\integer{prec=randint(10,100,1000,10000)}
\real{precision=1/\prec}

\text{fonction=cos}
\text{rep=}
\text{fonct=}
\text{hint=}
\for{i=1 to 3}{
 \integer{angle=random(15..75)}
 \text{fn=\fonction}
 \real{hh=\fn(\angle/180*pi)}
 \text{hint=wims(append item \hh to \hint)}
 \integer{tmp=\fn(\angle/180*pi)*\prec}
 \real{tmp=\tmp/\prec}
 \text{rep=wims(append item \tmp to \rep)}
 \text{tmp=\fn(\angle)}
 \text{fonct=wims(append item \tmp to \fonct)}
}

\real{hint=\hint[1]}
\real{hint2=floor(\hint*\prec)/\prec}
\real{hint3=(floor(\hint*\prec)+1)/\prec}

\statement{A l'aide de la calculette, donner les valeurs arrondies à \precision de :
<ul class="wims_nopuce">
  <li>\(\fonct[1]) =  \embed{r1,10
autocomplete="off"} </li>
 <li>\(\fonct[2]) = \embed{r2,10
autocomplete="off"} </li>
  <li>\(\fonct[3]) = \embed{r3,10
autocomplete="off"}</li>
</ul>
}

\answer{\(\fonct[1])}{\rep[1]}{type=numexp}
\answer{\(\fonct[2])}{\rep[2]}{type=numexp}
\answer{\(\fonct[3])}{\rep[3]}{type=numexp}

\hint{La valeur de \fonct[1] est environ : \hint.
Pour arrondir cette valeur à \precision degré près, on doit choisir
entre \hint2 et \hint3 ...}
