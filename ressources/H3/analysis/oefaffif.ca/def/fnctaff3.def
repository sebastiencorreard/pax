 !exit
!endif

tmp=!nonempty items f,g,h

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 7

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 7

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath $val7*(x)+($val8)
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val11=$[rint($(tmp0)*$(tmp1))]
!if $val10=$val11 
val10=$[rint(7)]
val11=$[rint(-3)]
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val12=$[rint($(tmp0))]
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
val14=$val12=$val10*a+b
val15=$val13=$val11*a+b
oefsteps=r1	r2	r3,r4 
nextstep=!nosubst r1	r2	r3,r4 
!readproc oef/steps.proc
