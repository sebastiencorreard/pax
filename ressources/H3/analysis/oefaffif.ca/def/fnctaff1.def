!set title=Trobar la fórmula.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=ca
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items f,g,h

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val10=$[rint($(tmp0)*$(tmp1))]
!if $val7=$val9 
val7=$[rint(7)]
val9=$[rint(-3)]
!endif
tmp=!translate ";': to $     $ in ($val8-$val10)/($val7-$val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
tmp=!translate ";': to $     $ in $val8-($val11)*$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
tmp=!translate ";': to $     $ in $val11*x+($val12)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
replyname1=Expressió 
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La imatge de 
!insmath $val7
$() per la funció afí 
!insmath $val6
$() és 
!insmath $val8
$() i la imatge de 
!insmath $val9
$() per la mateixa funció és 
!insmath $val10
$().<p>	La funció 
!insmath $val6
$() pot escriure's de la forma 
!insmath $val6 : x\mapsto ax+b
$(). Quina és aquesta expressió? <br>	
!insmath $val6 : x\mapsto 
$() 
!read oef/embed.phtml reply1 
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

