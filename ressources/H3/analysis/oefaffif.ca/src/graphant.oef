\title{Graphique -> antécédant}
\language{fr}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\text{nom=random(f,g,h)}
\integer{nb1=random(1,-1)*random(1..50)}
\integer{nb2=random(1,-1)*random(1..50)}
\real{nb1=\nb1/10}
\real{nb2=\nb2/10}
\if{abs(\nb1-\nb2)<.5}{
\real{nb1=-2.5}
\real{nb2=3.4}}

\real{a=10/(\nb2-(\nb1))}
\real{b=5-\nb2*(\a)}
\integer{pt1=\nb1*50+250}
\integer{pt2=\nb2*50+250}

\text{dessin=wims(record 1 of src/graph.don)}
\text{dessin=\dessin
line \pt2,0,\pt1,500,red}

\integer{ord=random(1,-1)*random(1..45)}
\real{ord=\ord/10}
\real{abs=(\ord-\b)/(\a)}
\integer{abs2=\abs*10}
\real{abs2=\abs2/10}

\integer{tmp=-(\ord)*50+250}
\integer{tmp2=250+(\abs)*50}
\if{\abs>0}{\text{texte1=text green,220,\tmp-10,medium,\ord}}
{\text{texte1=text green,255,\tmp-10,medium,\ord}}

\if{\ord>0}{\text{texte2=text green,\tmp2-10,260,medium,\abs2}}
{\text{texte2=text green,\tmp2-10,230,medium,\abs2}}

\text{dessin2=\dessin
arrow \tmp2,\tmp,\tmp2,250,10,green
\texte2
arrow 250,\tmp,\tmp2,\tmp,10,green
\texte1}

\statement{<br>
La représentation graphique de la fonction affine \(\nom) est la suivante :
<center>
\draw{500,500}{\dessin}
</center>
Quel nombre a pour image \(\ord) par la fonction \(\nom) ?<br>
<center><hr width=50%></center>
<table class=reply>
<tr><td>
<u><b>Votre réponse :</b></u>
<br>
Le nombre qui a pour image \(\ord) par la fonction \(\nom) est \embed{r1,5}.
</td></tr></table>}

\answer{\(\nom^{-1}(\ord))}{\rep}{type=auto}

\condition{Image}{abs(\abs-(\rep))<0.1}

\solution{Le nombre qui a pour image \ord par la fonction \nom est, par définition, <b>l'abscisse</b> du point sur la droite dont l'ordonnée est \ord.<p>
On place donc le point de la droite dont l'ordonnée est \ord puis, on lit son abscisse.
<center>
\draw{500,500}{\dessin2}
</center>}
