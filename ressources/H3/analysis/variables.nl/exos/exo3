n=$counter
image=0
make_tr=1
math=0
checkfile=exos/checkfile1.proc
cols=16
rows=1
mathview=0
# afblijven van rows=1
!if $level=0
    R=$counter
!else
    R=$level
!endif  
!if $options<2 or $options>10
    options=5 
!endif
inputs=-1
description=$empty
textanswer$n=<table class="zebra_table_h2">
exotext=<table class="zebra_table_h2">
answer=$empty
var1=!randitem a,k,q,u,x,c,n,z,s 
var2=!randitem b,g,m,r,v,y,d,p,t
var4=0
var5=$empty
var7=1
var6=0
# var1 = letter1                                                                                               
# var2 = letter2                                                                                               
# var3 = varcount  varcnt                                                                                      
# var4 = letterlijk                                                                                            
# var5 = controle 
#
helptext=<img src=\'$module_dir/gifs/exo$subject.jpg\' alt=\'noalt\' />
!if $R=1
    question$n=!record 7 of lang/remarks.$taal
    wims_rawmath_variables=$var1
    var3=1
    getal=2,4,6,8,10
    getal=!shuffle $getal
    getallen=2,3,4,5,6
    getallen=!shuffle $getallen
    i=0
    # 2 haaktjes
    var8=2
    !for p=1 to $options
	k=!randitem 1,3,5,7,9
	keuze=!randitem 1,2
	getal1=!item $p of $getal
	getal2=$[$getal1+$k]
	pm=!randitem +,-
	!if $keuze=1
	    answer=$var1*($getal1*$var1 $pm $getal2)
	!else
	    getal3=!item $p of $getallen
	    getal4=!item $[$p+1] of $getallen
	    answer=$var1^$getal3*($getal1*$var1^$getal4 $pm $getal2)
	!endif
	vraag=!exec pari $answer
	vraag_html=!htmlmath $vraag
	vraag_html=!replace internal - by &minus; in $vraag_html
	description=!append item $vraag_html to $description
	var5=!append item $vraag to $var5
	answer$n=!append item $answer to $(answer$n)
	htmlgoed=!htmlmath  $answer
	textanswer$n=!append word $ <tr><td>$vraag_html </td><td>=</td><td>$htmlgoed</td></tr> $ to $(textanswer$n)
	exotext=!append word $ <tr><td>$vraag_html</td><td>=</td><td><input type="text" id="myinput$i" class="schaersvoorde_input" size="$cols" value="" /></td></tr> to $exotext
	!increase i
    !next p
    textanswer$n=!append word $ </table> $ to $(textanswer$n)
    exotext=!append word $ </table> $ to $exotext
 !exit
!endif
