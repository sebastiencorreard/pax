# ontbinden in factoren
make_tr=1
n=$counter
image=0
cols=16
rows=1
math=0
# geen wiskunde in antwoord
mathview=0
questiontype=0
checkfile=exos/checkfile1.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif
!if $options<2 or $options>8
    options=3
!endif
inputs=-1
# var1 = letter1
# var2 = letter2 
# var3 = varcount  varcnt
# var4 = letterlijk
# var5 = controle
# var6 = geen haakjes gebruiken
# 1 variabele
var3=1
# niet letterlijk :we checken op haakjes
var4=0
# letterlijke som
var5=$empty
# controle op 1*(som)
var7=1
# geen haakjes
var6=0
# 4 haakjes !!
var8=2
var1=!randitem x,p,t,a
var2=!randitem y,q,h,b
helptext=<img src=\'$module_dir/gifs/exo$subject.jpg\' alt=\'noalt\' />
textanswer$n=<table class="zebra_table_h2">
exotext=<table class="zebra_table_h2">
description=$empty

!if $R=1
    question$n=!record 7 of lang/remarks.$taal
    wims_rawmath_variables=$var1
    numbers=2,3,4,5,6,7,8,9,10
    numbers=!shuffle $numbers
    i=0
    !for p=1 to $options
        keuze=!randitem 1,2,3
	kans=!randitem 1,2,3,4
        number1=!item $p of $numbers
        !if $keuze=1
	    answer=($var1 + $number1)*($var1 + $number1)
	    ans=($var1 + $number1)^2
	    !if $kans=1
		vraag=$var1^2 + $[2*$number1]*$var1 + $[$number1*$number1]
    	    !else
		!if $kans=2
		    vraag=$[2*$number1]*$var1+ $var1^2  + $[$number1*$number1]
		!else
		    !if $kans=3
			vraag=$[2*$number1]*$var1 + $[$number1*$number1] + $var1^2
		    !else
			vraag=$[$number1*$number1] + $[2*$number1]*$var1  + $var1^2
		    !endif
		!endif
	    !endif
	!else
    	    !if $keuze=2
	        answer=($var1 - $number1)*($var1 - $number1)
		ans=($var1 - $number1)^2
	        !if $kans=1
	    	    vraag=$var1^2 - $[2*$number1]*$var1 + $[$number1*$number1]
    		!else
		    !if $kans=2
			vraag=$[-2*$number1]*$var1 + $var1^2  + $[$number1*$number1]
		    !else
			!if $kans=3
			    vraag=$[-2*$number1]*$var1 + $[$number1*$number1] + $var1^2
			!else
			    vraag=$[$number1*$number1] - $[2*$number1]*$var1  + $var1^2
			!endif
		    !endif
		!endif
    	    !else
		answer=($var1 - $number1)*($var1+$number1)
		ans=$answer
		!if $kans=1 or $kans=2
		    vraag=$var1^2 - $[$number1*$number1]
    		!else
		    vraag=$[-1*$number1*$number1] + $var1^2
		!endif
    	    !endif
	!endif
	vraag_html=!htmlmath $vraag
	vraag_html=!replace internal - by &minus; in $vraag_html
        description=!append item $vraag_html to $description
	var5=!append item $vraag to $var5
        answer$n=!append item $answer to $(answer$n)
	htmlgoed=!htmlmath $ans
	textanswer$n=!append word $ <tr><td>$vraag_html </td><td>=</td><td>$htmlgoed</td></tr> $ to $(textanswer$n)
	exotext=!append word $ <tr><td>$vraag_html</td><td>=</td><td><input type="text" id="myinput$i" class="schaersvoorde_input" size="$cols" value="" /></td></tr> to $exotext
	!increase i
    !next p
    textanswer$n=!append word $ </table> $ to $(textanswer$n)
    exotext=!append word $ </table> $ to $exotext
 !exit
!endif

!if $R=2
    question$n=!record 22 of lang/remarks.$taal
    wims_rawmath_variables=$var1
    # geen 1 ivm checkfile
    numbers=2,3,4,5,6,7,8,9,10
    numbers=!shuffle $numbers
    
    i=0
    !for p=1 to $options
	keuze=!randitem 1,2,3
        number1=!item $p of $numbers
        number2=!item $[$p + 1] of $numbers
        number3=!item $[$p + 2] of $numbers
        number4=!item $[$p + 3] of $numbers
        mp=!randitem +,-
        pm=!randitem +,-
	pp=!randitem -1,1
	!if $keuze=1
	    ans=$[$pp*$number1]*($var1 $pm $number2)^2
	    answer=$[$pp*$number1]*($var1 $pm $number2)*($var1 $pm $number2)
	!else
	    !if $keuze=2
		ans=$var1*($var1 $pm $number3)^2
		answer=$var1*($var1 $pm $number3)*($var1 $pm $number3)
	    !else
		ans=$var1^2*($var1 $pm $number4)^2
		answer=$var1^2*($var1 $pm $number4)*($var1 $pm $number4)
	    !endif
	!endif
	vraag=!exec pari $answer
	vraag_html=!htmlmath $vraag
	vraag_html=!replace internal - by &minus; in $vraag_html
        description=!append item $vraag_html to $description
	var5=!append item $vraag to $var5
	answer$n=!append item $answer to $(answer$n)
	htmlgoed=!htmlmath $ans
	textanswer$n=!append word $ <tr><td>$vraag_html </td><td>=</td><td>$htmlgoed</td></tr> $ to $(textanswer$n)
	exotext=!append word $ <tr><td>$vraag_html</td><td>=</td><td><input type="text" id="myinput$i" class="schaersvoorde_input" size="$cols" value="" /></td></tr> to $exotext
	!increase i
    !next p
    textanswer$n=!append word $ </table> $ to $(textanswer$n)
    exotext=!append word $ </table> $ to $exotext
 !exit
!endif

