n=$counter
cols=14
rows=1
image=0
math=1
questiontype=0
embed=1
!if $level=0
    R=$counter
!else
    R=$level
!endif
checkfile=$checkdir/simplify.proc
helptext=<img src=\'$module_dir/gifs/exo$subject.jpg\' alt=\'noalt\' />
arglist=$empty
letters=x,y,z,a,p,s
letters=!shuffle $letters
x=!item 1 of $letters
y=!item 2 of $letters
z=!item 3 of $letters
a=!item 4 of $letters
getallen=!shuffle 2,3,4,5,6,7,8,-2,-3,-4,-5,-6,-7,-8
b=!item 1 of $getallen
c=!item 2 of $getallen
d=!item 3 of $getallen
e=!item 4 of $getallen
question$n=!record 8 of lang/remarks.$taal
#@ herleid de volgende macht <br /><font size=-1>dus schrijf anders</font>
# var1 is used for checking  "literal typing" of question

!if $R=1
    var1=$x^$a/($x^($b*$a)) 
    applettext=!nospace $var1 =
    answer$n=!exec maxima ratsimp($var1);
    tex=!texmath $(answer$n)
    formula$n=\frac{$x^{\textsize $a}}{$x^{\textsize $b\cdot $a}}
    texanswer$n=$(formula$n) \,\,=\,\, $tex
    varlist=!varlist $(answer$n)
    wims_rawmath_variables=$varlist
 !exit
!endif

!if $R=2
    var1=$x^($c*$a)/($x^($b*$a))
    applettext=!nospace $var1 =
    answer$n=!exec maxima ratsimp($var1);
    tex=!texmath $(answer$n)
    formula$n=\frac{$x^{\textsize $c \cdot $a}}{$x^{\textsize $b\cdot $a}}
    texanswer$n=$(formula$n) \,\,=\,\, $tex
    varlist=!varlist $(answer$n)
    wims_rawmath_variables=$varlist
 !exit
!endif

!if $R>2
    kans=!randint 0,1
    !if $kans=0
	var1=$c*$x^($b*$a)/($x^($d*$a))
	applettext=!nospace $var1 =
	answer$n=!exec maxima ratsimp($var1);
	tex=!texmath $(answer$n)
	formula$n=\frac{$c \cdot $x^{\textsize $b \cdot $a}}{$x^{\textsize $d \cdot $a}}
	texanswer$n=$(formula$n) \,\,=\,\, $tex
	varlist=!varlist $(answer$n)
	wims_rawmath_variables=$varlist
    !else
	var1=$c*$x^($b*$a)/($e*$x^($d*$a))
	applettext=!nospace $var1 =
	answer$n=!exec maxima ratsimp($var1);
        tex=!texmath $(answer$n)
        formula$n=\frac{$c \cdot $x^{\textsize $b \cdot $a}}{$e \cdot $x^{\textsize $d \cdot $a}}
	texanswer$n=$(formula$n) \,\,=\,\, $tex
        varlist=!varlist $(answer$n)
	wims_rawmath_variables=$varlist
    !endif
 !exit
!endif


