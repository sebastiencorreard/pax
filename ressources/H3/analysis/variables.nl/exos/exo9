# schrijf zonder haakjes (x-3)^2 => x^2....
n=$counter
image=0
cols=17
rows=1
math=1
questiontype=0
embed=1
checkfile=exos/checkfile2.proc
question$n=!record 6 of lang/remarks.$taal
helptext=<img src=\'$module_dir/gifs/exo$subject.jpg\' alt=\'noalt\' />
!if $level=0
    R=$counter
!else
    R=$level
!endif
x=!randitem x,p,t,a
y=!randitem y,q,h,b
a=!randitem 2,3,4

!if $R=1
    numbers=!shuffle 2,3,4,5,6,7
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3,4
    number1=!item 1 of $numbers
    number2=!item 1 of $numbers
    pm=!randitem +,-
    !if $keuze=1
	var1=($a*$x $pm $number1)^2
    !else
	!if $keuze=2
	    var1=($number1 $pm $a*$x)^2
	!else
	    !if $keuze=3
		var1=($a*$x - $number1)*($a*$x + $number1)
	    !else
		var1=(-$number1 $pm $a*$x)^2
	    !endif
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

!if $R=2
    ppm=!randitem 1,-1
    a=$[$ppm*$a]
    numbers=!shuffle 2,3,4,5,6,7
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    number5=!item 5 of $numbers
    mp=!randitem +,-
    pm=!randitem +,-
    !if $keuze=1
	var1=$a*($number1*$x $pm $number2)^2
    !else
	!if $keuze=2
	    var1=$a*(-$number3 $pm $x)^2
	!else
	    var1=$a*(-$number4*$x $pm $number5)*($number5 $mp $number4*$x)
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

!if $R=3
    numbers=!shuffle 2,3,4,5,6,7
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    number5=!item 5 of $numbers
    mp=!randitem +,-
    pm=!randitem +,-
    mmp=!randitem +,-
    !if $keuze=1
	var1=!rawmath ($a*$x $pm $number1)^2 $mp $number2 
    !else
	!if $keuze=2
	    var1=!rawmath $a*$x^2 $mp (-$number3 $pm $a*$x)^2
	!else
	    var1=!rawmath (-$a*$x $pm $number5)*($number5 $mp $a*$x) $mmp $number1
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

!if $R>3
    ppm=!randitem 1,-1
    a=$[$ppm*$a]
    numbers=!shuffle 2,3,4,5,6,7
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    number5=!item 5 of $numbers
    mp=!randitem +,-
    pm=!randitem +,-
    mmp=!randitem +,-
    !if $keuze=1
	var1=!rawmath $number2 $mmp ($a*$x $pm $number1)^2 $mp $a*$x^2
    !else
	!if $keuze=2
	    var1=!rawmath $a*$x^2 $mp (-$number3 $pm $a*$x)^2 $mmp $number4
	!else
	    var1=!rawmath $a*$x $mp (-$a*$x $pm $number5)*($number5 $mp $a*$x) $mmp $number1
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var2 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

