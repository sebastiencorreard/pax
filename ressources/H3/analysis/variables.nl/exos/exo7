# schrijf zonder haakjes (x-3)^2 => x^2....
n=$counter
image=0
cols=16
rows=1
math=1
questiontype=0
embed=1
checkfile=exos/checkfile2.proc
question$n=!record 6 of lang/remarks.$taal
helptext=<img src=\'$module_dir/gifs/exo$subject.jpg\' alt=\'noalt\' />
!if $level=0
    R=$counter
!else
    R=$level
!endif
x=!randitem x,p,t,a
y=!randitem y,q,h,b
!if $R=1
    numbers=!shuffle 2,3,4,5,6,7,8,9,10
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3,4
    number1=!item 1 of $numbers
    pm=!randitem +,-
    !if $keuze=1
	var1=($x $pm $number1)^2
	tex1=($x $pm $number1) \cdot ($x $pm $number1)
    !else
	!if $keuze=2
	    var1=($number1 $pm $x)^2
	    tex1=($number1 $pm $x) \cdot ($number1 $pm $x)
	!else
	    !if $keuze=3
		var1=($x - $number1)*($x+$number1)
		tex1=($x \cdot $x - $number1\cdot $x -$number1 \cdot $x - $number1 \cdot $number1
	    !else
		var1=(-$number1 $pm $x)^2
		tex1=(-$number1 $pm $x) \cdot (-$number1 $pm $x) 
	    !endif
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex1 = $tex
 !exit
!endif

!if $R=2
    numbers=!shuffle 2,3,4,5,6,7,8,9,10
    varlist=$x
    wims_rawmath_variables=$x
    keuze=!randitem 1,2,3,4
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    pm=!randitem +,-
    mp=!randitem +,-
    !if $keuze=1
	var1=($x $pm $number1)^2 $mp $number2
	tex1=($x $pm $number1) \cdot ($x $pm $number1)   $mp $number2
    !else
	!if $keuze=2
	    var1=$number2 $mp ($number1 $pm $x)^2
	    tex1=$number2 $mp ($number1 $pm $x) \cdot ($number1 $pm $x)
	!else
	    !if $keuze=3
		var1=($x - $number1)*($x+$number1) $pm $number2*$x^2
		tex1=$x^{2} - $number1 \cdot $x -$number1 \cdot $x $pm $number2 \cdot x^{2}
	    !else
		var1=$number2*$x $mp (-$number1 $pm $x)^2
		tex1=$number2*$x $mp (-$number1 $pm $x) \cdot (-$number1 $pm $x)
	    !endif
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex1 = $tex
 !exit
!endif

!if $R=3
    wims_rawmath_variables=$x
    varlist=$x
    numbers=!shuffle 2,3,4,5,6,7,8,9
    nummers=!shuffle 1/2,1/3,2/3,1/4,3/4,1/5,2/5,3/5,4/5,1/6
    keuze=!randitem 1,2,3,4,5
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    nummer1=!item 1 of $nummers
    nummer2=!item 2 of $nummers
    nummer3=!item 3 of $nummers
    nummer4=!item 4 of $nummers
    nummer5=!item 5 of $nummers
    mp=!randitem +,-
    pm=!randitem +,-
	
    !if $keuze=1
	var1=($number1*$x $pm $nummer1)^2
    !else
	!if $keuze=2
	    var1=($number2*$x + $nummer2)*($number2*$x - $nummer2)
	!else
	    !if $keuze=3
		var1=($x $pm $nummer3)^2
	    !else
		!if $keuze=4
		    var1=$nummer4*($x $pm $number3)^2
		!else
		    var1=($nummer5 - $number4*$x)*($nummer5 + $number4*$x )
		!endif
	    !endif
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

!if $R>3
    wims_rawmath_variables=$x
    varlist=$x
    numbers=!shuffle 2,3,4,5,6,7,8,9
    nummers=!shuffle 1/2,1/3,2/3,1/4,3/4,1/5,2/5,3/5,4/5,1/6
    keuze=!randitem 1,2,3,4,5
    number1=!item 1 of $numbers
    number2=!item 2 of $numbers
    number3=!item 3 of $numbers
    number4=!item 4 of $numbers
    nummer1=!item 1 of $nummers
    nummer2=!item 2 of $nummers
    nummer3=!item 3 of $nummers
    nummer4=!item 4 of $nummers
    nummer5=!item 5 of $nummers
    mp=!randitem +,-
    pm=!randitem +,-
	
    !if $keuze=1
	var1=($number1*$x $pm $nummer1)^2 $mp $nummer2*$x
    !else
	!if $keuze=2
	    var1=$nummer3*$x^2 $mp ($number2*$x + $nummer2)*($number2*$x - $nummer2)
	!else
	    !if $keuze=3
		var1=$nummer4*($x $pm $nummer3)^2
	    !else
		!if $keuze=4
		    var1=$nummer4*($number1*$x $pm $number3)^2
		!else
		    var1=$nummer1 $pm ($nummer5 - $number4*$x)*($nummer5 + $number4*$x )
		!endif
	    !endif
	!endif
    !endif
    formula$n=!texmath $var1
    applettext=!nospace $var1 =
    tot=!exec pari A=$var1 \
    printtex(A)
    answer$n=!line 1 of $tot
    tex=!line 2 of $tot
    texanswer$n= \rightarrow $tex
 !exit
!endif

