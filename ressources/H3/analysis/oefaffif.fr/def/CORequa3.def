!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=red;#;rouge,green;#;vert,yellow;#;jaune,purple;#;violet,blue;#;bleu,black;#;noir
val8=Mettre en correspondance chaque fonction avec la couleur de sa représentation graphique dans le repère ci-contre.
val9=Mettre en relation chaque équation avec la couleur de la droite correspondante dans le repère ci-contre.
