!if $val6=it 
val7=red;#;rosso,green;#;verde,yellow;#;giallo,purple;#;viola,blue;#;blu,black;#;nero
val8=Metti in corrispondenza ogni funzione con il colore della sua rappresentazione grafica nel disegno a fianco.
val9=Metti in relazione ogni equazione con il colore della retta corrispondente nel disegno a fianco.
val10=Risposta
!endif
val11=$[rint(2)]
val12=$[rint(3)]
!if $val11=1 
val13=$val8
val14=f(x)
val15=40x150x75
!else
val13=$val9
val14=y
val15=40x140x75
!endif
val16=1,2,3,4
tmp0=!item 1 of $val16

val17=$[rint($(tmp0))]
tmp0=!item 2 of $val16

val16=$[rint($(tmp0))]
val18=$val16;#;$val17,$val16;#;-$val17,-$val16;#;$val17,-$val16;#;-$val17,$val17;#;$val16,-$val17;#;$val16,$val17;#;-$val16,-$val17;#;-$val16
tmp0=!shuffle $val18

val18=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 to $val12 of $val7

val7=$(tmp0)
tmp0=!items2lines $val7

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal ;#; by , in $val19

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val19

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp=!translate internal $	$ to ; in $val19

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!record 2 of src/graph.don

val21=$(tmp0)
val22=
!for val23 =1 to $val12 
tmp0=!item $val23 of $val18

val24=$(tmp0)
val19=$val24
tmp0=!replace internal ;#; by , in $val24

val24=$(tmp0)
tmp0=!item 1 of $val24

val25=$[rint($(tmp0))]
tmp0=!item 2 of $val24

val26=$[rint($(tmp0))]
val27=$[rint(150+(-5*30))]
val28=$[rint(150+(5*30))]
val29=!rawmath -($val25*(x)+($val26))*30+150
evaltmp=$val29

evaltmp=!mathsubst x=(-5) in $evaltmp
tmp0=($evaltmp)
val30=$[rint($(tmp0))]
evaltmp=$val29

evaltmp=!mathsubst x=(5) in $evaltmp
tmp0=($evaltmp)
val31=$[rint($(tmp0))]
val21=$val21	segment $val27,$val30,$val28,$val31,$(val7[$val23])
tmp0=!texmath $val25*x+($val26)

val32=$(tmp0)

!ifval $val11=1
val19=\(x \mapsto $val32)
!else
val19=\(y=$val32)
!endif
tmp0=!append item $val19 to $val22

val22=$(tmp0)
!next
val21=$val21	text black,290,150,medium,x	text black,155,2,medium,$val14
