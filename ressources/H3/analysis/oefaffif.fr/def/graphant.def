tmp0=!randitem f,g,h

val14=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 1, 50

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 50

val16=$[rint($(tmp0)*$(tmp1))]
val15=$[$val15/10]
val16=$[$val16/10]
!if abs($val15-$val16)<.5 
val15=$[-2.5]
val16=$[3.4]
!endif
val17=$[10/($val16-($val15))]
val18=$[5-$val16*($val17)]
val19=$[rint($val15*50+250)]
val20=$[rint($val16*50+250)]
tmp0=!record 1 of src/graph.don

val21=$(tmp0)
val21=$val21	segment $val20,0,$val19,500,red
tmp0=!randitem 1,-1

tmp1=!randint 1, 45

val22=$[rint($(tmp0)*$(tmp1))]
val22=$[$val22/10]
val23=$[($val22-$val18)/($val17)]
val24=$[rint($val23*10)]
val24=$[$val24/10]
val25=$[rint(-($val22)*50+250)]
val26=$[rint(250+($val23)*50)]
!if $val23>0 
val27=text green,220,$val25-10,medium,$val22
!else
val27=text green,255,$val25-10,medium,$val22
!endif
!if $val22>0 
val28=text green,$val26-10,260,medium,$val24
!else
val28=text green,$val26-10,230,medium,$val24
!endif
val29=$val21	arrow $val26,$val25,$val26,250,10,green	$val28	arrow 250,$val25,$val26,$val25,10,green	$val27
