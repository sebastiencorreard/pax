text{nom=randitem(f,g,h)}
\integer{nb1=random(1,-1)*random(1..15)}
\integer{nb2=random(1,-1)*random(1..15)}
\integer{nb3=random(1,-1)*random(1..15)}
\integer{nb4=random(1,-1)*random(1..15)}
\if{\nb1=\nb3}{
\integer{nb1=7}
\integer{nb3=-3}
}
\text{a=simplify((\nb2-\nb4)/(\nb1-\nb3))}
\text{b=simplify(\nb2-(\a)*\nb1)}
\text{sol=simplify(\a*x+(\b))}

\statement{
La retta \(d) passa per i punti \(A(\nb1 ; \nb2)) e \(B(\nb3 ; \nb4)).
<p>
Essendo \( \nb1\neq \nb3), la retta \(d) ammette una equazione della forma \(y=a x+b).</p>
Ricava l'equazione di \(d) : <div class="wimscenter">
\(y = )\embed{reply1}
</div>}

\answer{Espressione}{\sol}{type=auto}
