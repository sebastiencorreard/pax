!set title=Trova l'equazione ridotta
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabien, Sommier
email=sommierf@sfr.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val9=$[rint($(tmp0)*$(tmp1))]
!if $val6=$val8 
val6=$[rint(7)]
val8=$[rint(-3)]
!endif
tmp=!translate ";': to $     $ in ($val7-$val9)/($val6-$val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
tmp=!translate ";': to $     $ in $val7-($val10)*$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
tmp=!translate ";': to $     $ in $val10*x+($val11)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
replytype1=auto

replyname1=Espressione
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La retta 
!insmath d
$() passa per i punti 
!insmath A($val6 ; $val7)
$() e 
!insmath B($val8 ; $val9)
$().	<p>	Essendo 
!insmath  $val6\neq $val8
$(), la retta 
!insmath d
$() ammette una equazione della forma 
!insmath y=a x+b
$().</p>	Ricava l'equazione di 
!insmath d
$() : <div class="wimscenter">	
!insmath y = 
$() 
!read oef/embed.phtml reply1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=1
