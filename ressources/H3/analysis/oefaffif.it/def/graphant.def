!set title=Grafico -> antecedente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=it
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem f,g,h

val6=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 1, 50

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 50

val8=$[rint($(tmp0)*$(tmp1))]
val7=$[$val7/10]
val8=$[$val8/10]
!if abs($val7-$val8)<.5 
val7=$[-2.5]
val8=$[3.4]
!endif
val9=$[10/($val8-($val7))]
val10=$[5-$val8*($val9)]
val11=$[rint($val7*50+250)]
val12=$[rint($val8*50+250)]
tmp0=!record 1 of src/graph.don

val13=$(tmp0)
val13=$val13	line $val12,0,$val11,500,red
tmp0=!randitem 1,-1

tmp1=!randint 1, 45

val14=$[rint($(tmp0)*$(tmp1))]
val14=$[$val14/10]
val15=$[($val14-$val10)/($val9)]
val16=$[rint($val15*10)]
val16=$[$val16/10]
val17=$[rint(-($val14)*50+250)]
val18=$[rint(250+($val15)*50)]
!if $val15>0 
val19=text green,220,$val17-10,medium,$val14
!else
val19=text green,255,$val17-10,medium,$val14
!endif
!if $val14>0 
val20=text green,$val18-10,260,medium,$val16
!else
val20=text green,$val18-10,230,medium,$val16
!endif
val21=$val13	arrow $val18,$val17,$val18,250,10,green	$val20	arrow 250,$val17,$val18,$val17,10,green	$val19
replytype1=auto

replyname1=\($val6^{-1}($val14))
replygood1=?analyze 22
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La rappresentazione grafica della funzione affine 
!insmath $val6
$() è la seguente:	<div class="wimscenter">	 
!read oef/draw.phtml 500,500 \
$val13 
$()	</div>	Quale numero ha per immagine 
!insmath $val14
$() rispetto alla funzione 
!insmath $val6
$()?	<div class="spacer">	<b>La tua risposta:</b>	Il numero che ha per immagine 
!insmath $val14
$() rispetto alla funzione 
!insmath $val6
$() è  
!read oef/embed.phtml r1,5 
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Il numero che per immagine $val14 rispetto alla funzione $val6 è, per definizione, <b>l'ascissa</b> del punto sulla retta la cui ordinata è $val14.<br/>	Si prende quindi il punto della retta la cui ordinata è $val14,  poi si legge la sua ascissa.	<div class="wimscenter">	 
!read oef/draw.phtml 500,500 \
$val21 
$()	</div>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs($val15-($val22))<0.1
 condtest1=1
!else
 condtest1=0
