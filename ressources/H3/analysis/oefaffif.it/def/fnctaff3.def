!set title=Trovare la formula (guidato 1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=it
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items f,g,h

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 7

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 7

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath $val7*(x)+($val8)
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 10

val11=$[rint($(tmp0)*$(tmp1))]
!if $val10=$val11 
val10=$[rint(7)]
val11=$[rint(-3)]
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val12=$[rint($(tmp0))]
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
val14=$val12=$val10*a+b
val15=$val13=$val11*a+b
oefsteps=r1	r2	r3,r4 
nextstep=!nosubst r1	r2	r3,r4 
!readproc oef/steps.proc
replytype1=auto

replyname1=Prima equazione
replygood1=$val14
replytype2=auto

replyname2=Seconda equazione
replygood2=$val15
replytype3=auto

replyname3=a
replygood3=$val7
replytype4=auto

replyname4=b
replygood4=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!insmath $val6
$() è una funzione affine tale che l'immagine di 
!insmath $val10
$() è 
!insmath $val12
$() e l'immagine di 
!insmath $val11
$() è 
!insmath $val13
$().	<p>L'obiettivo è trovare l'espressione della funzione 
!insmath $val6
$().	La funzione è affine, si devono quindi trovare due numeri 
!insmath a
$() e 
!insmath b
$() tali che 
!insmath $val6(x)=ax+b
$() per ogni numero 
!insmath x
$(). </p>	Per risolvere questo esercizio, rispondi alle domande seguenti:	<div class="spacer">	<strong>Domanda 1</strong>: Tradurre la frase	<div class="wimscenter" style="font-style:italic">L'immagine rispetto a 
!insmath $val6
$() di 
!insmath $val10
$() è 
!insmath $val12
$().</div>	con un'equazione facendo intervenire 
!insmath a
$() e 
!insmath b
$().<br/>	<div>La tua risposta: 	
!if $m_step=1 
$()	 
!read oef/embed.phtml r1 
$()</div>	 
!else
$() 	
!insmath \special{color=green}$val14
$().	</div>	<strong>Domanda 2</strong>: Tradurre la frase	<div class="wimscenter" style="font-style:italic">L'immagine rispetto a 
!insmath $val6
$() di 
!insmath $val11
$() é 
!insmath $val13
$().</div>	con un'equazione utilizzando 
!insmath a
$() e 
!insmath b
$().	<div>La tua risposta: 	
!if $m_step=2 
$() 
!read oef/embed.phtml r2 
$()</div>	 
!else
$() 	
!if $m_step=3 
$()	
!insmath \special{color=green}$val15
$().</div>	<strong>Domanda 3</strong>:	Risolvere il sistema di equazioni, di incognite 
!insmath a
$() e 
!insmath b
$(), formato dalle due equazioni precedenti.	<div class="wims_instruction">	Puoi utilizzare la calcolatrice cliccando sul link nel menu.	</div>	<div class="wimscenter">
!insmath a=
$() 
!read oef/embed.phtml r3 
$()<br/>	
!insmath b=
$() 
!read oef/embed.phtml r4 
$()	</div>	 
!endif
$() 
!endif
$() 
!endif
