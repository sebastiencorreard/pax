!set title=Qual è l'equazione?
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=it
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 2, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 2, 3

val7=$[rint($(tmp0)*$(tmp1))]

!ifval $val7=$val6
val7=$[rint(6)]
!endif
val8=$[rint(-$val6)]
val9=$[rint(-$val7)]

!ifval $val6<0
val10=$val6
!else
val10=+$val6
!endif

!ifval $val7<0
val11=$val7
!else
val11=+$val7
!endif

!ifval $val8<0
val12=$val8
!else
val12=+$val8
!endif

!ifval $val9<0
val13=$val9
!else
val13=+$val9
!endif
val14=\(y= $val6 x$val11)
val15=\(y= $val7 x$val10),\(y= $val8 x$val11),\(y= $val8 x$val13),\(y= $val6 x$val13),\(y= $val7 x$val12)
val16=Qual è l'equazione della retta qui sotto?
val17=y
val18=!rawmath -($val6*(x)+($val7))*30+150
evaltmp=$val18

evaltmp=!mathsubst x=(-5) in $evaltmp
tmp0=($evaltmp)
val19=$[rint($(tmp0))]
evaltmp=$val18

evaltmp=!mathsubst x=(5) in $evaltmp
tmp0=($evaltmp)
val20=$[rint($(tmp0))]
tmp0=!record 2 of src/graph.don

val21=$(tmp0)
val21=$val21	line 0,$val19,300,$val20,red	text black,290,150,medium,x	text black,155,2,medium,$val17
choicename1=
choicegood1=$val14
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

