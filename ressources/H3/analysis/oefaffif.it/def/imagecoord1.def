!set title=Clicca sull'ordinata dell'immagine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David 
email=mcld@math.u-psud.fr 

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]
!if $val8=1 
val9=$[(-7-$val7)/$val6]
val10=$[(7-$val7)/$val6]
!else
val9=$[(-7+$val7)/$val6]
val10=$[(7+$val7)/$val6]
!endif
val9=$[max($val9,-7)]
val10=$[min($val10,7)]
tmp0=!randint $val9, $val10

val11=$[rint($(tmp0))]
val12=$[rint($val8*$val6)]
val13=$[rint($val12*$val11+$val7)]
tmp=!translate ";': to $     $ in $val12*x +  $val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
val15=200
val16=xrange -7.2,7.2	   yrange -7.2,7.2	   parallel -7,-7,7,-7,0,1,16, grey	   parallel -7,-7,-7,7,1,0,16, grey	   hline 0,0,black	text black,7-0.5,+0.8,medium,x	text black,-0.5,7,medium,y	   arrow 0,0,1,0,8, black	   arrow 0,0,0,1,8, black	   vline 0,0,black	fcircle $val11,0,6,green	linewidth 2	plot blue, $val14	
!readproc oef/draw.phtml $val15,$val15 \
$val16 
tmp0=$ins_url
val17=$(tmp0)
!readproc slib/draw/convpixel 0,$val13,$val15,$val15,-7.2,7.2,-7.2,7.2,0,pixels 
tmp0=$slib_out
val18=$(tmp0)
val19=$(val18[1])
val20=$(val18[2])
replytype1=coord
replyname1=
replygood1=$val17;point,$val19,$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Ecco una rappresentazione grafica della funzione 
!insmath g
$().	Sull'asse delle ordinate, clicca sul punto di ordinata 
!insmath y = g($val11)
$().	 <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$() </div>	  
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval  $m_result1 = -1 
 <div class='oef_feedbacks'>Ecco la risposta	    <p class="wimscenter">	      
!read oef/draw.phtml  $val15,$val15  \
	      $val16	      dlines  green,$val11,0,$val11,$val13,0,$val13	      fcircle 0,$val13,6,green	      text green,0.3,$val13,medium,y	 
$() </p>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=11,13,15,16
embedcnt=1
