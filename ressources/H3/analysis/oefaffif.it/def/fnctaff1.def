!set title=Trovare la formula
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=it
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items f,g,h

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val10=$[rint($(tmp0)*$(tmp1))]
!if $val7=$val9 
val7=$[rint(7)]
val9=$[rint(-3)]
!endif
tmp=!translate ";': to $     $ in ($val8-$val10)/($val7-$val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
tmp=!translate ";': to $     $ in $val8-($val11)*$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
tmp=!translate ";': to $     $ in $val11*x+($val12)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
replytype1=auto

replyname1=Espressione
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()L'immagine di 
!insmath $val7
$() rispetto alla funzione affine 
!insmath $val6
$() è 
!insmath $val8
$() e l'immagine di 
!insmath $val9
$() rispetto alla stessa funzione è 
!insmath $val10
$().<p>	La funzione 
!insmath $val6
$() si può scrivere nella forma 
!insmath $val6 : x\mapsto ax+b
$().	</p>	Qual è questa  formulazione? <div class="wimscenter">	
!insmath $val6 : x\mapsto 
$() 
!read oef/embed.phtml reply1 
$()</div>
$()
