!set title=Lineaire functies 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fguerima@tele2.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items f,g,h

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 15

val8=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val8/$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
replyname1=a
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()De lineaire functie 
!insmath $val6
$() voldoet aan 
!insmath $val6(0)=0
$(). 	De functie 
!insmath $val6
$() kan dus geschreven worden als 
!insmath $val6 : x\mapsto ax
$() 	waar 
!insmath a
$() de helling van de functie is. 	Er geldt 
!insmath $val6
$()(
!insmath $val7
$())=
!insmath $val8
$().<p> Wat is de preciese waarde van 
!insmath a
$()?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Het oplossen kan op twee manieren: 	<ul>	<li><b>Methode 1 :</b> een verhoudingstabel maken:<p>	<table width="101" border="1" height="62">	  <tr> 	    <td width="47"> 	      <div align="center"><b>x</b></div>	    </td>	    <td width="44">
!insmath $val7
$()</td>	  </tr>	  <tr> 	    <td width="47"> 	      <div align="center"><b>$val6 (x)</b></div>	    </td>	    <td width="44">
!insmath $val8
$()</td>	  </tr>	</table>	De helling van de functie is de verhoudingscoefficient van de tabel: dat wil 	zeggen de coefficient waarmee de getallen van de eerste lijn vermenigvuldigd 	worden om de getallen van de tweede lijn te krijgen. In ons geval is dat 	
!insmath $val9
$().</li>	<li><b>Methode 2 :</b> het oplossen van een vergelijking:<p> 	De notatie als functie is 
!insmath $val6(x)=ax
$() dus voor 
!insmath x=$val7
$(), 
!insmath $val6($val7)=a\times$val7
$(). Verder weten we van de opgave dat 
!insmath $val6($val7)=$val8
$(). We krijgen dus 	de vergelijking  
!insmath $val8=a\times$val7
$(). Hieruit volgt dat 
!insmath a=$val9
$().</li></ul>
$()
!exit

:feedback
!ifval $val10=$val9 en ($val10 notsamecase $val9)
 <p><font color=red>De breuk in 	het antwoord is niet vereenvoudigd, dat kost punten.	</font>Het juiste antwoord is 
!insmath $val9
$()
$()
!endif

!exit

:test

!ifval $val10=$val9
 condtest1=1
!else
 condtest1=0
!endif
condname1=goed antwoord

!ifval $val10 issamecase $val9
 condtest2=1
!else
 condtest2=0
!endif
condname2=vereenvoudigde breuk?

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=0
