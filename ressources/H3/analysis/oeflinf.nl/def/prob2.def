!set title=Verhoudingen 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fguerima@tele2.fr
computeanswer=no
precision=10000000

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 50

val6=$[rint($(tmp0))]
val7=$[(1-$val6/100)]
tmp0=!randint 1, 5000

val8=$[rint($(tmp0))]
val8=$[$val8/100]
tmp0=!randint 1, 5000

val9=$[rint($(tmp0))]
val9=$[$val9/100]
val10=$[$val8*$val7]
val11=$[rint($val8*$val7*100)]
val11=$[$val11/100]
val12=$[$val9/$val7]
val13=$[rint($val9/$val7*100)]
val13=$[$val13/100]
val7=$val7*x
oefsteps=reply 1	reply 2	reply 3 
nextstep=!nosubst reply 1	reply 2	reply 3 
!readproc oef/steps.proc
replytype1=algexp
replyname1=P(x)
replygood1=$val7
replyname2=prijs
replygood2=$val11
replyname3=prijs
replygood3=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Een winkel geeft $val6 % korting op al zijn artikelen. De gereduceerde prijs P staat in verhouding tot de oorspronkelijke prijs x.<p>	<u>Vraag 1:</u> Geef P als lineaire functie van x.<p>	 
!if $m_step>=2 
$()Antwoord: <font color=green>P(x)=$val7</font><p>	<u>Vraag 2:</u> Hoeveel kost, op de cent nauwkeurig, een artikel waarvan de 	oorspronkelijke prijs $val8 euro is?<p> 
!endif
$()	 
!if $m_step>=3 
$()Antwoord: <font color=green>$val11 euro</font><p>	<u>Vraag 3:</u>Een artikel kost $val9 euro, wat was zijn oorspronkelijke prijs, 	op de cent nauwkeurig? 
!endif
$()
$()
!exit

