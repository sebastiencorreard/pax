!set title=Grafiek -> functie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fguerima@tele2.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 5

val7=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val7/$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
val9=$[rint(5*$val8*50+250)]
val10=$[rint(-5*$val8*50+250)]
tmp0=!record 1 of src/graph.don

val11=$(tmp0)
val11=$val11	line 0,$val9,500,$val10,red
!if $val6>0 
val12=text green,220,-($val7*50)+245,medium,$val7
!else
val12=text green,255,-($val7*50)+245,medium,$val7
!endif
!if $val7>0 
val13=text green,245+50*($val6),260,medium,$val6
!else
val13=text green,245+50*($val6),230,medium,$val6
!endif
val14=$val11	arrow 250+50*($val6),250,250+50*($val6),-($val7*50)+250,10,green	$val13	arrow 250+50*($val6),-($val7*50)+250,250,-($val7*50)+250,10,green	$val12
replyname1=a
replygood1=?analyze 15
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Schrijf de functie waarvan de grafiek als volgt is als 	
!insmath x\mapsto ax
$() (a is de helling van de lineaire functie):	<center>	 
!read oef/draw.phtml 500,500 \
$val11 
$()	</center>	Het resultaat moet gegeven worden in de vorm van een breuk.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Om de helling te vinden van een lineaire functie f waarvan de grafiek 	door de oorsprong gaat is het voldoende om voor een willekeurige x, f(x) te hebben. In de grafiek is af te lezen dat f($val6)  $val7 is.	<center>	 
!read oef/draw.phtml 500,500 \
$val14 
$()	</center>	De helling van de functie is dus   
!if $val8 issametext $val7/$val6 
$()
!insmath \frac{$val7}{$val6}
$() 
!else
$() 
!insmath \frac{$val7}{$val6}=$val8
$() 
!endif
$().
$()
!exit

:feedback
!ifval $val15=$val8 en ($val15 notsamecase $val8)
 <p><font	color=red></font>Het juiste antwoord is 
!insmath $val8
$()
$()
!endif

!exit

:test

!ifval $val15=$val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=juist antwoord

!ifval $val15 issamecase $val8
 condtest2=1
!else
 condtest2=0
!endif
condname2=vereenvoudigde breuk?

!exit

:stat
vsavelist=6,7,8,11,14,15
embedcnt=0
