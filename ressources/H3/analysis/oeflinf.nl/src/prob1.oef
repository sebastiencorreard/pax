\title{Verhoudingen 1}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000000}


\integer{prix=random(50..100)}
\real{prix=\prix/10}
\text{nom=randitem(ham, appels, peren, perzikken, pasta, wortels)}
\integer{poid=random(1..50)}
\real{poid=\poid/10}
\integer{pr=random(1..5000)}
\real{pr=\pr/100}
\text{rep1=x*\prix}
\real{test2=\prix*\poid}
\integer{rep2=\prix*\poid*100}
\real{rep2=\rep2/100}
\real{test3=\pr/\prix}
\integer{rep3=\pr/\prix*1000}
\real{rep3=\rep3/1000}

\steps{reply 1
reply 2
reply 3}

\statement{Een kilo \nom kost \prix euro.<p>
<u>Vraag 1:</u> Geef de prijs P die in euros betaald moet worden als functie 
van het gewicht x.<p>
\if{\step>=2}{Antwoord: <font color=green>P(x)=\rep1</font><p>
<u>Vraag 2:</u> Hoeveel kost \poid kg \nom? Geef het resultaat op de 
cent nauwkeurig.<p>}
\if{\step>=3}{Antwoord: <font color=green>\rep2 euro</font><p>
<u>Vraag 3:</u>Hoeveel \nom kan gekocht worden met \pr euro? Geef het 
resultaat op de gram nauwkeurig.} }

\answer{P(x)}{\rep1}{type=algexp}
\answer{prijs}{\rep2}{type=auto}
\answer{gewicht}{\rep3 kg}{type=units}
