\title{Verhoudingen 2}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000000}


\integer{pour=random(1..50)}
\real{rep1=(1-\pour/100)}
\integer{p1=random(1..5000)}
\real{p1=\p1/100}
\integer{p2=random(1..5000)}
\real{p2=\p2/100}
\real{test2=\p1*\rep1}
\integer{rep2=\p1*\rep1*100}
\real{rep2=\rep2/100}
\real{test3=\p2/\rep1}
\integer{rep3=\p2/\rep1*100}
\real{rep3=\rep3/100}
\text{rep1=\rep1*x}

\steps{reply 1
reply 2
reply 3}

\statement{Een winkel geeft \pour % korting op al zijn artikelen. De gereduceerde prijs P staat in verhouding tot de oorspronkelijke prijs x.<p>
<u>Vraag 1:</u> Geef P als lineaire functie van x.<p>
\if{\step>=2}{Antwoord: <font color=green>P(x)=\rep1</font><p>
<u>Vraag 2:</u> Hoeveel kost, op de cent nauwkeurig, een artikel waarvan de 
oorspronkelijke prijs \p1 euro is?<p>}
\if{\step>=3}{Antwoord: <font color=green>\rep2 euro</font><p>
<u>Vraag 3:</u>Een artikel kost \p2 euro, wat was zijn oorspronkelijke prijs, 
op de cent nauwkeurig?}}

\answer{P(x)}{\rep1}{type=algexp}
\answer{prijs}{\rep2}{type=auto}
\answer{prijs}{\rep3}{type=auto}
