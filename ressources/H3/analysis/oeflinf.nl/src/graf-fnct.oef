\title{Grafiek -> functie}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..5)}
\integer{b=random(1,-1)*random(1..5)}
\text{sol=simplify(\b/\a)}
\integer{pt1=5*\sol*50+250}
\integer{pt2=-5*\sol*50+250}

\text{dessin=wims(record 1 of src/graph.don)}
\text{dessin=\dessin
line 0,\pt1,500,\pt2,red}

\if{\a>0}{\text{texte1=text green,220,-(\b*50)+245,medium,\b}}
{\text{texte1=text green,255,-(\b*50)+245,medium,\b}}

\if{\b>0}{\text{texte2=text green,245+50*(\a),260,medium,\a}}
{\text{texte2=text green,245+50*(\a),230,medium,\a}}

\text{dessin2=\dessin
arrow 250+50*(\a),250,250+50*(\a),-(\b*50)+250,10,green
\texte2
arrow 250+50*(\a),-(\b*50)+250,250,-(\b*50)+250,10,green
\texte1}


\statement{Schrijf de functie waarvan de grafiek als volgt is als 
\(x\mapsto ax) (a is de helling van de lineaire functie):
<center>
\draw{500,500}{\dessin}
</center>
Het resultaat moet gegeven worden in de vorm van een breuk.}

\answer{a}{\rep}{type=auto}
\condition{juist antwoord}{\rep=\sol}
\condition{vereenvoudigde breuk?}{\rep issamecase \sol}

\feedback{\rep=\sol en (\rep notsamecase \sol)}{<font
color=red></font>Het juiste antwoord is \(\sol)}

\solution{Om de helling te vinden van een lineaire functie f waarvan de grafiek 
door de oorsprong gaat is het voldoende om voor een willekeurige x, f(x) te hebben. In de grafiek is af te lezen dat f(\a)  \b is.
<center>
\draw{500,500}{\dessin2}
</center>
De helling van de functie is dus  \if{\sol issametext \b/\a}{\(\frac{\b}{\a})}{\(\frac{\b}{\a}=\sol)}.}
