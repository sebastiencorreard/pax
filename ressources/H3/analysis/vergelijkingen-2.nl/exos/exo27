# type AB=AC
# let op: bij texmath vervangen we wims \to door \rightarrow in combinatie met een Array !!!
n=$counter
!if $rounding=-1
    rounding=0
    !readproc $remarkdir/rounding.$taal
!endif
!if $usage=2
    image=0
!endif
!if $level=0
    R=$counter
!else
    R=$level
!endif
# NEEE  we willen NIET checken op vereenvoudigde breuken
var5=0
math=0
embed=1
exotext=$empty
keuze=!randitem 1,2
checkfile=exos/checkfile1.proc
mathviewpanel=$module_title:x=:->:and
!if $subject=27
    varlist=x
    ss=!record 1 of lang/remarks.$taal
    #@ Los de volgende vergelijking op:<br />
    helptext=!record 3 of lang/remarks.$taal
    cols=20
    rows=2
    # berekeniningen laten zien
    var3=0
    questiontype=0
!else
    varlist=x
    # maximaal aantal pijlen=tussenstappenn
    var1=5
    # aantal pijlen=tussenstappen
    var2=3
    # berekeniningen laten zien
    var3=1
    ss=!record 4 of lang/remarks.$taal
    #@ Los de volgende vergelijking op:<br />
    cols=30
    rows=5
    questiontype=7
    javascript=js/exo1.js
    embed=1
    make_tr=1
    helptext=<img src=\'$module_dir/gifs/exo16.jpg\' alt=\'noalt\' />
!endif
question$n=<a onmouseover="return escape('$helptext')">$ss</a>

# question$n = html/ascii vraag
# formula$n  = latex/html versie van de formule
# answer$n = nakijk wiskundige goede antwoorden
# textanswer$n= text/ascii/html versie met uitleg van het goede antwoord
# texanswer$n is latexformule van goede antwoord

!if $R=1
    # type (ax-b)^2*(cx-d)=(ax-b)^2*(ex+f)
    a=!randint 2,9
    b=!randint 1,20
    c=!randint 2,9
    d=!randint 1,20
    e=!randint 2,9
    f=!randint 1,20
    pm=!randitem 1,-1
    e=$[$pm*$e]
    !if $c=$e
	c=$[$c+1]
    !endif
    !if $[$b/$a] = $[($f+$d)/($c-($e))]
	b=$[$b+1]
    !endif
    tot=!exec pari A=$b/$a\
    printtex(A)\
    B=($f+$d)/($c-($e))\
    printtex(B)
    x1=!line 1 of $tot
    tex_x1=!line 2 of $tot
    x2=!line 3 of $tot
    tex_x2=!line 4 of $tot
    answer$n=$x1,$x2
    formula$n=\left($a x - $b \right)^{2} \left($c x - $d \right)=\left($a x - $b \right)^{2} \left($e x + $f \right)
    applettext=!nospace ($a*x - $b)^2 *($c x - $d )=($a*x - $b )^2 *($e x + $f )
    texanswer$n=\left[ \begin{array}{l}\textrm{type :} \; a \cdot b = a \cdot c \rightarrow \\ a \cdot b - a \cdot c = 0 \rightarrow a \cdot ( b - c) = 0 \rightarrow  a = 0 \;\bigvee\; b = c \\ \\ $(formula$n) \\ $a x -$b =0 \;\bigvee\; $c x - $d = $e x + $f \rightarrow \\  x_{1}=$x1 \;\bigvee\; x_{2}=$x2 \end{array} \right.
 !exit
!endif

!if $R=2
    # type (ax+b)^2*(cx-d)=(ax+b)^3
    a=!randint 2,9
    pm=!randitem 1,-1
    a=$[$pm*$a]
    b=!randint 1,20
    c=!randint 2,9
    d=!randint 1,20
    !if $[-1$b/($a)] = $[($b+$d)/($c-($a))]
	c=$[$c+1]
    !endif
    tot=!exec pari A=-1*$b/($a)\
    printtex(A)\
    B=($b+$d)/($c-($a))\
    printtex(B)
    x1=!line 1 of $tot
    tex_x1=!line 2 of $tot
    x2=!line 3 of $tot
    tex_x2=!line 4 of $tot
    answer$n=$x1,$x2
    formula$n=\left($a x + $b \right)^{2} \left($c x - $d \right)=\left($a x + $b \right)^{3}
    applettext=!nospace ($a*x + $b)^2 *($c x - $d )=($a*x + $b )^3
    texanswer$n=\left[ \begin{array}{l}\textrm{type :} \; a \cdot b = a \cdot c \rightarrow \\ a \cdot b - a \cdot c = 0 \rightarrow a \cdot ( b - c) = 0 \rightarrow  a = 0 \;\bigvee\; b = c \\ \\ $(formula$n) \\  $a x + $b =0 \;\bigvee\; $c x - $d = $a x + $b \rightarrow \\  x_{1}=$x1 \;\bigvee\; x_{2}=$x2 \end{array} \right.
 !exit
!endif

!if $R>2
    # type (ax-b)*g^x=pax-pb
    a=!randint 2,9
    pm=!randitem 1,-1
    a=$[$pm*$a]
    b=!randint 1,10
    g=!randint 2,5
    h=!randint 2,5
    c=$[$g^$h]
    d=$[$c*$a]
    e=$[$c*$b]
    
    tot=!exec pari A=-1*$b/($a)\
    printtex(A)
    x1=!line 1 of $tot
    tex_x1=!line 2 of $tot
    x2=$h
    answer$n=$x1,$x2
    formula$n=\left($a x + $b \right) $g^{x}=$d x + $e 
    applettext=!nospace ($a*x + $b) *$g^x=$d*x + $e
    texanswer$n=\left[ \begin{array}{l}\textrm{type :} \; a \cdot b = a \cdot c \rightarrow \\ a \cdot b - a \cdot c = 0 \rightarrow a \cdot ( b - c) = 0 \rightarrow  a = 0 \;\bigvee\; b = c \\ \\  \left($a x + $b \right) $g^{x}=$c \left( $a x + $b \right) \rightarrow \\ $a x + $b =0 \;\bigvee\; $g^{x} = $c \rightarrow \\  x_{1}=$x1 \;\bigvee\; x_{2}=$x2 \end{array} \right.
 !exit
!endif

 
