question$n=<a onmouseover="return escape('$helptext')">$ss</a>
keuze=!randitem 1,0
!if $R=1
    # sqrt(ax+b)=sqrt(c) => ax+b=c => ax=c-b =>  x=(c-b)/a 
    x=!randint -10,10
    a=!randitem -7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7
    d=!randint 1,25
    b=$[$d-$a*$x]
    !if $b=0
	d=$[$d+5]
        b=$[$d-$a*$x]
    !endif
    c=$[$a*$x + $b]
    tus=!rawmath x+$b
    formula$n=\sqrt{$a \cdot $tus} = \sqrt{$c}
    applettext=!nospace sqrt($a * $tus)= sqrt($c) ->
    texanswer$n=\left[ \begin{array}{l} \textrm{type :} \sqrt{ax+b}= \sqrt{c} \rightarrow \left( \sqrt{ax+b}\right)^{2} = \left(\sqrt{c}\right)^{2} \rightarrow ax+b = c \\ \\ $(formula$n) \\ $a \cdot $tus = $c  \\  $a \cdot x = $[$c - $b]   \\  x=$x \end{array} \right.
    answer$n=$x
 !exit
!endif 

!if $R=2
    # sqrt(ax+b)=sqrt(cx) => ax-cx=-b => (a-c)x=-b =>  x=-b/(a-c) 
    # sqrt(ax+b)=sqrt(cx+d) => ax-cx=d-b => (a-c)x=d-b =>  x=(d-b)/(a-c) 
    a=!randitem -7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7
    b=!randitem -7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7
    c=!randint 2,10
    !if $a=$c
	c=$[$c+1]
    !endif
    d=!randitem -8,-7,-6,-5,-4,-3,-2,-1,1,2,3,4,5,6,7,8
    tus=!rawmath x+$b
    tussen=!rawmath x+$d
    
    !if $keuze=1
        formula$n=\sqrt{$a \cdot $tus} = \sqrt{$c x}
	applettext=!nospace sqrt($a * $tus) = sqrt($c*x) ->
	tot=!exec pari A=($b)/(($c)-($a))\
	printtex(A)
	answer$n=!line 1 of $tot
	xtex=!line 2 of $tot
        texanswer$n=\left[ \begin{array}{l} \textrm{type :} \sqrt{ax+b}= \sqrt{c} \rightarrow \left( \sqrt{ax+b}\right)^{2} = \left(\sqrt{c}\right)^{2}  \rightarrow ax+b = c \\ \\ $(formula$n) \\$a \cdot $tus = $c x  \\  $a \cdot x -$c x= -$b  \\  x=$xtex  \end{array} \right.
    !else
        formula$n=\sqrt{$a \cdot $tus} = \sqrt{$c $tussen}
	applettext=!nospace sqrt($a * $tus) = sqrt($c*$tussen) ->
	tot=!exec pari A=(($d)-($b))/(($a)-($c))\
	printtex(A)
	answer$n=!line 1 of $tot
	xtex=!line 2 of $tot
	texanswer$n=\left[ \begin{array}{l} \textrm{type :} \sqrt{ax+b}= \sqrt{c} \rightarrow \left( \sqrt{ax+b}\right)^{2} = \left(\sqrt{c}\right)^{2}  \rightarrow ax+b = c \\ \\ $(formula$n) \\ $a \cdot $tus = $c $tussen  \\  $[$a-$c] x= $[$d-$b]  \\  x=$xtex \end{array} \right.
    !endif
 !exit
!endif 

