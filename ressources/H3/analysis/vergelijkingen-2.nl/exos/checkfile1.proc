goback=0
errortext=$empty
# edited on : Fri Mar 7 13:44:28 CET 2008
 
# kijkt na: x=1 en x=2 <----- var3=0
# kijkt berekening na: x(x-2)=0 => x=0 en x=2 <----- var3=1
# let op varlist=x  : alle andere "vars" kunnen niet !!!

n=$counter
wims_compare_precision=10000

extra=$empty

leeg=!wordcnt $(reply$n)
!if $leeg = 0
    maxscore=$[$P1*$maxscore]
    errortext=!record 37 of $remarkdir/commonremarks.$taal
    goback=1
    !exit
!endif

!if $leeg >25
    maxscore=$[$P1*$maxscore]
    errortext=!record 48 of $remarkdir/commonremarks.$taal
    goback=1
    !exit
!endif

!if ? isin $(reply$n)
    remark$n=$NOK
    maxscore=0
    goback=0
    !exit
!endif

AAA=!lower $(reply$n)
wims_rawmath_variables=$varlist
test=!replace internal , by @ in $AAA
!if @ isin $test
    !readproc $checkdir/decimalpoint.proc
    !if $goback=1
	!exit
    !endif
!endif

AAA=!nospace $AAA

!for p in $varlist
    !if $p notin $AAA
	testvar=$p 
	maxscore=$[$P2*$maxscore]
	errortext=!record 10 of lang/remarks.$taal
	#@Je bent de variabele $p vergeten...
	goback=1
	!exit
    !endif
!next p   

roots=!itemcnt $(answer$n)
!if $rounding<1
    exact=1
    factor=1000000
!else
    factor=$rounding
!endif

!if $var3=1
    # show calculations
    #pijlen=->,-->,<->,<-->,=>,==>,<=>,<==>,thus,so,dus,ergo,geldt,alors
    # via java/javascript input wordt <=> de standaard pijl
    # zie js/exo1.js of $authordir/phtml/showmath.java.phtml
    # test op pijlen -> => etc etc
    test=$AAA
    test=!replace internal -> by @ in $test
    t=!positionof char @ in $test
    pijlcnt=!itemcnt $t
    !if $pijlcnt <$var2
	errortext=!record 11 of lang/remarks.$taal
	#@Het is de bedoeling dat je in elkgeval 1 tussenstap produceerd...<br />en wel de belangrijkste stap: het "nul" maken van de vergelijking
	maxscore=$[$P1*$maxscore]
	goback=1
	!exit
    !endif
    !if $pijlcnt > $var1
	errortext=!record 12 of lang/remarks.$taal
	#@Nou nou ,het mag wel wat korter/bondiger
	maxscore=$[$P1*$maxscore]
	goback=1
	!exit
    !endif
    AAA=!replace internal @ by , in $test
    !for p=1 to 4
	AAA=!replace internal ,, by , in $AAA
    !next p
    # testen op -> x=5-2-->x=3--> wordt ,x=5-1,x=3,
    c=!char 1 of $AAA
    !if $c=,
	AAA=!char 2 to -1 of $AAA
    !endif
    c=!char -1 of $AAA
    !if $c=,
	AAA=!char 1 to -2 of $AAA
    !endif
    !for p in $varlist
	X=!upper $p
	AAA=!replace internal $p by $X in $AAA
    !next p
    !for p in sqrt,sin,cos,tan,abs,pi,ln,log
	P=!toupper $p
	AAA=!replace internal $p by $P in $AAA
    !next p
    AAA=!replace [a-z\~\!\@\>\<\#\$\%\&\_\;] by $empty in $AAA
    AAA=!lower $AAA
    leeg=!wordcnt $AAA
    !if $leeg=0
	errortext=!record 13 of lang/remarks.$taal
	goback=1
	maxscore=$[$P4*$maxscore]
	!exit
    !endif
    calculations=!item 1 to -2 of $AAA
    AAA=!item -1 of $AAA
    # dus het eindantwoord is x=1 en x2=-1 enz
    aantal=!itemcnt $calculations
    !if $aantal < 1
	maxscore=$[$P2*$maxscore]
	errortext=!record 11 of lang/remarks.$taal
	goback=1
	!exit
    !else
	!if $aantal > $var1
	    maxscore=$[$P2*$maxscore]
	    errortext=!record 14 of lang/remarks.$taal
	    #@Je gebruikt wel erg veel tussenstappen...
	    goback=1
	    !exit
	!endif
    !endif
    rem=$empty
    check=0
    duplicate=0
    old=@
    # aantal is het aantal stappen (pijlen) in't leerling antwoord
    !for p=1 to $aantal
	org=!item $p of $calculations
	!if $org=$old
	    !increase duplicate
	!endif
	# is-teken ??
	# calculations= x^2-2x-63=0,(x-9)(x+7)=0
	i=!replace internal = by , in $org
	tst=!itemcnt $i
	!if $tst !=2
	    errortext=!record 13 of lang/remarks.$taal
	    #@Je hebt de schrijfwijze niet helemaal begrepen, geloof ik<br />Kijk even in de "mouse_tooltip" of in de help-pagina
	    goback=1
	    !if $teaching=1
		maxscore=$[$maxscore*$P3]
	    !else
		maxscore=$[$maxscore*$P6]
	    !endif
	    !exit
	!endif
	i1=!item 1 of $i
	i2=!item 2 of $i
	!if $i2 = 0
	    i1=!rawmath $i1
	    !for s in $(answer$n)
		ck=!replace internal x by ($s) in $i1
		#ck=!evalsubst x=$s in $i1 : gives sometimes trouble :(
		ck=$[(round($factor*($ck)))/$factor]
		!if NaN isin $ck
		    errortext=!record 26 of $remarkdir/commonremarks.$taal
		    goback=1
		    maxscore=$[$P3*$maxscore]
		    !exit
		!endif
		!ifval $ck=0
		    !increase check
		!endif
	    !next s
	!else
	    !if $i1 = 0
		# for answers like => 0 = 4*x+5
		i2=!rawmath $i2
		!for s in $(answer$n)
		    ck=!replace internal x by ($s) in $i2
		    #ck=!evalsubst x=$s in $i2 : gives sometimes trouble :(
		    !if NaN isin $ck
			errortext=!record 26 of $remarkdir/commonremarks.$taal
			goback=1
			maxscore=$[$P3*$maxscore]
			!exit
		    !endif
		    ck=$[(round(100*($ck)))/100]
		    !ifval $ck=0
			!increase check
		    !endif
		!next s
	    !else
		i=!rawmath ($i1) - ($i2)
		!for s in $(answer$n)
		    ck=!replace internal x by ($s) in $i
		    !if NaN isin $ck
			errortext=!record 26 of $remarkdir/commonremarks.$taal
			goback=1
			maxscore=$[$P3*$maxscore]
			!exit
		    !endif
		    ck=$[(round(100*($ck)))/100]
		    !ifval $ck=0
			!increase check
		    !endif
		!next s
	    !endif
	!endif
	old=$org
    !next p
    straf2=1
    score2=$[$check/($straf2*$aantal*$roots)]
    !if $duplicate !=0
	ex=!record 17 of lang/remarks.$taal
	extra=$extra $ex
    !endif
    !if $score2=1 and $aantal>$var2
	ex=!record 18 of lang/remarks.$taal
	#@en zelfs $aantal tussenstappen....<br />
	extra=$extra $ex
    !endif
    !if $score2 >0 and $score2<1
	ex=!record 19 of lang/remarks.$taal
	#@je hebt een tiep-foutje? gemaakt in je redenering...<br />
	extra=$extra $ex
    !endif
# end of va3=1 ==> calculations check 
!endif

!for p in $varlist
    t1=!replace $p[_0-9]*= by @ in $AAA
    t2=!replace =$p[_0-9]* by @ in $AAA
    # er is nog een probleem bij : x=4 en 5=x --> 45
    # terwijl natuurlijk         : 4=x en 5=x --> 4,5
    # terwijl natuurlijk         : x=4 en x=5 --> 4,5
    # moet nog worden opgelost. misschien JS 'voorfilteren' ?    
!next p
rev=0
!if @ notin $t1
    !if @ notin $t2
	errortext=!record 15 of lang/remarks.$taal
	#@ik verwacht natuurlijk wel een (eind)antwoord als <b>x=2 of x=4</b>
	maxscore=$[$P5*$maxscore]
	goback=1
	!exit
    !else
	rev=1
    !endif
!endif
!if @ isin $t1 and @ isin $t2
    errortext=!record 7 of lang/remarks.$taal
    #@Helaas kan ik je antwoord $(reply$n) niet goed nakijken...<br />Als je meerdere antwoorden wilt noteren moet iets noteren als:<br /><span style="color:green">x = 123 en x = 321</span><br />en <b>niet</b> <br />x=123 en 321=x !!!
    goback=1
    !exit
!endif
!if $rev=0
    AAA=!replace internal @ by , in $t1
!else
    AAA=!replace internal @ by , in $t2
!endif
    
AAA=!replace internal ,, by , in $AAA
c=!char 1 of $AAA
!if $c=,
    AAA=!char 2 to -1 of $AAA
!endif
c=!char -1 of $AAA
!if $c=,
    AAA=!char 1 to -2 of $AAA
!endif

    
#errortext=AAA=$AAA 
#goback=1
#!exit
ss=!itemcnt $AAA
!if $ss=0
    errortext=!record 15 of lang/remarks.$taal
    #@ik verwacht natuurlijk wel een (eind)antwoord als <b>x=2 of x=4</b>
    maxscore=$[$P5*$maxscore]
    goback=1
    !exit
!endif
!for p in $varlist
    X=!upper $p
    AAA=!replace internal $p by $X in $AAA
!next p

!for p in sqrt,sin,cos,tan,abs,pi,ln,log
    P=!toupper $p
    AAA=!replace internal $p by $P in $AAA
!next p
AAA=!replace [a-z\~\!\@\>\<\#\$\%\&\_\;] by $empty in $AAA
AAA=!lower $AAA
leeg=!wordcnt $AAA
!if $leeg=0
    errortext=!record 13 of lang/remarks.$taal
    goback=1
    maxscore=$[$P4*$maxscore]
    !exit
!endif

straf1=1
!if $roots != $ss
    testvar1=$roots
    testvar2=$ss
    extra=!record 16 of lang/remarks.$taal
    #@Het aantal wortels is: $testvar1<br /> en niet zoals in jouw antwoord: $testvar2 
    !if $ss > $roots
    #antwoorden erbij bedacht
	straf1=$[$roots/(4*$ss)]
    !else
	straf1=$P3
    !endif
!endif

score1=0
t=0
GGG=$empty

!for p in $(answer$n)
    pp=$[(round($factor*$p))/$factor]
    GGG=!append item $pp to $GGG
!next p

!for p in $(answer$n)
    !if / isin $p 
	breuk=1
    !else
	breuk=0
    !endif
    !increase t
    p1=!item $t of $GGG
    klaar=0
    omgedraaid=0
    !for s in $AAA
	!if $klaar=0
	    s1=$[(round($factor*($s)))/$factor]
	    !if NaN isin $s1
		errortext=!record 26 of $remarkdir/commonremarks.$taal
		goback=1
		maxscore=$[$P3*$maxscore]
		!exit
	    !endif
	    !ifval ($s1=$[-1*$p1]) and ($s1 notitemof $GGG)
		!increase omgedraaid 
	    !endif
	    sc=0
	    !if $exact=1
		ss=!exec pari if( (abs(1.0*($s) - 1.0*($p)))<10^-15 ,1,0)
		!if $wims_exec_error != $empty
		    errortext=!record 26 of $remarkdir/commonremarks.$taal
		    goback=1
		    maxscore=$[$P3*$maxscore]
		    !exit
		!endif
		!if $ss=1
		    sc=1
		    klaar=1
		    !increase score1
		!endif
	    !else
		!ifval $s1=$p1
		    sc=1
		    klaar=1
		    !increase score1
		!endif
	    !endif
	    !if $sc=1 and $var5=1
		# var5=1 -> check op vereenvoudigen
		# check op vereenvoudiging van breuken
		!if $breuk=1
		    !if / isin $s
			G=!replace internal / by , in $p
			A=!replace internal / by , in $s
			G1=!item 1 of $G
			G2=!item 2 of $G
			# trouble "!item 1 of (a,b)" == (a,b)
			A=!declosing $A
			A1=!item 1 of $A
			A2=!item 2 of $A
			!if $[abs($A1)]=$[abs($G1)] and $[abs($A2)]=$[abs($G2)]
			    ex=!record 21 of lang/remarks.$taal
			    #@en de breuk $s  goed vereenvoudigd :)<br />
			    extra=$extra $ex
			#!else
			#    ex=!record 22 of lang/remarks.$taal
			    #@je hebt de breuk $s niet vereenvoudigd :(<br />
			#    extra=$extra $ex A=$A A1=$A1 A2=$A2
			!endif
		    !else
			!if $s != $p
			    # so 1.333333333
			    # and not 1/3
			    ex=!record 23 of lang/remarks.$taal
			    #@je kunt je antwoord $s beter als de breuk $p noteren !<br />
			    extra=$extra $ex
			!endif
		    !endif
		!else
		    !if / isin $s
			ex=!record 24 of lang/remarks.$taal
			#@Het antwoord is gewoon een rond getal ($p) en geen breuk ($s) , hoor !<br />
			extra=$extra $ex
		    !endif
		!endif
	    !endif
	!endif
    !next s
!next p
score1=$[$straf1*$score1/$t]

#errortext=AAA=$AAA roots=$roots ss=$ss straf1=$straf1 score1=$score1 exra=$extra
#goback=1
#!exit

!if $var3=1
    !if $score1=0 and $score2>0
	ex=!record 20 of lang/remarks.$taal
	#@je hebt het eindantwoord niet goed...<br />
	extra=$extra $ex
    !endif
!endif
!if $var3=1
    # final answer is 50% of grade...
    # calculations is 50% of grade
    maxscore=$[$maxscore*($score1 + $score2)/2]
!else
    maxscore=$[$maxscore*($score1)]
!endif


!if $maxscore>0.9
    remark$n=$OK
!else
    !if $omgedraaid>0
	ex=!record 27 of $remarkdir/commonremarks.$taal
	extra=!append line <br />$ex to $extra
	!if $maxscore<0.6
	    # a few points for this?
	    maxscore=$[$maxscore + 0.3]
	!endif
    !endif
    !if $maxscore>0.45
	remark$n=$BOK
    !else
	remark$n=$NOK
    !endif
!endif

modulescore=$[$modulescore + $maxscore]

!if $extra != $empty
    remark$n=$(remark$n)<br />$extra
!endif
!exit
