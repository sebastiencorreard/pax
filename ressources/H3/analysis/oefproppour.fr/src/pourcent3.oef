\text{name_enonce=Écrire les nombres suivants en écriture décimale&nbsp;}

\precision{10000}
\integer{size=6}
\text{donnees=randint(1..9)/10,randint(12..99)/100,randint(12..99)/10000,randint(12..99)/1000,randint(101..999)/1000}
\text{donnees=shuffle(\donnees)}
\text{enonce=}
\text{rep=}
\for{i=1 to 6}{
 \integer{ent=randitem(0,1,2)}
 \real{nombre=item(\i,\donnees)+\ent}
 \real{sol=\nombre*100}
 \text{en=\frac{\sol}{100}}
 \text{enonce=wims(append item \en to \enonce)}
 \text{rep=wims(append item \nombre to \rep)}
}
\statement{
\name_enonce:
<ul class="inline spacer wims_nopuce">
<li><label for="reply1">\(\enonce[1] = \)</label> \embed{r1,\size}</li>
