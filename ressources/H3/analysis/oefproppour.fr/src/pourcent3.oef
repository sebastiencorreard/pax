<li><label for="reply5">\(\enonce[5] = \)</label> \embed{r5,\size}</li>
<li><label for="reply6">\(\enonce[6] = \)</label> \embed{r6,\size}</li>
</ul>
}
\answer{\(\enonce[1]\)}{\rep[1]}{type=numexp}
