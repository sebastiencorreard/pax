     <td>\(C\)</td>
    </tr><tr>
     <td>\(x\)</td>
     <td>\embed{r1,\size}</td>
     <td>\embed{r3,\size}</td>
     <td>\embed{r5,\size}</td>
    </tr><tr>
     <td>\(y\)</td>
     <td>\embed{r2,\size}</td>
     <td>\embed{r4,\size}</td>
     <td>\embed{r6,\size}</td>
    </tr>
   </table>
<div class="wimscenter"><img src="\figure" alt=""></div>
}
