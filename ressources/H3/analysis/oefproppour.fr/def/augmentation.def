!set title=Augmentation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

tmp1=!randint 1, 9

val6=$(tmp0).$(tmp1)
tmp0=!randint 10, 999

val7=$[$(tmp0)]
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/life/frcommodity $val7 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val9=$(tmp0)
tmp=!nonempty items 2000,2001,2002,2003,2004

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[$val7*$val6/100]
val13=$[$val7+$val12]
tmp=!trim Entre janvier $val11 et décembre $val11, les prix ont augmenté de $val6 %. $val8 a acheté $val10 $val9 à $val7 euros en janvier
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
!if $val15=1 
val16=Quelle économie a-t-il fait par rapport à un achat en Décembre
val17=$[$val12]
!else
val16=Quel prix aurait-il payé s'il l'avait acheté en Décembre&nbsp;
val17=$[$val13]
!endif
val18=$[floor($val17*100)/100]
val19=$[ceil($val17*100)/100]
val17=$[rint($val17*100)/100]
tmp0=!replace internal % by \% in $val14

val20=$(tmp0)
replytype1=auto

replyname1=Réponse
replygood1=?analyze 21
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20. $val16? \end{statement} 


!goto stat

!exit

:question
$()$val14.	$val16?	<div class="spacer">	<label for="reply1"><b>Votre réponse</b> :</label>  
!read oef/embed.phtml r1 
$() euro.</div>	<div class="wims_instruction">Arrondir si nécessaire le résultat au centième d'euros.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20. $val16? $m_end{statement} 
$()
!exit

:feedback

!exit

:test
condweight1=8 

!ifval $val21>=$val18 and $val21<=$val19
 condtest1=1
!else
 condtest1=0
!endif
condname1=Calcul
condweight2=2 

!ifval $val17=$val21
 condtest2=1
!else
 condtest2=0
!endif
condname2=Arrondi correct

!exit

:stat
vsavelist=14,16,17,18,19,20,21
embedcnt=1
