replygood5=$(val10[5])
replytype6=numexp
replyname6=$(val9[6])
replygood6=$(val10[6])
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val6: \begin{enumerate} \item $(val9[1]) = \(\frac{\phantom{-------}}{100}\) \item $(val9[2]) = \(\frac{\phantom{-------}}{100}\) \item $(val9[3]) = \(\frac{\phantom{-------}}{100}\) \item $(val9[4]) = \(\frac{\phantom{-------}}{100}\) \item $(val9[5]) = \(\frac{\phantom{-------}}{100}\) \item $(val9[6]) = \(\frac{\phantom{-------}}{100}\) \end{enumerate} \end{statement} 


!goto stat

!exit

