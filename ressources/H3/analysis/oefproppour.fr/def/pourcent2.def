 !exit
!endif

val6=Écrire les nombres décimaux suivants sous forme de quotient	  dont le dénominateur est égal à 100&nbsp;
val7=$[rint(6)]
tmp0=!randint 1, 9

tmp1=!randint 12, 99

tmp2=!randint 12, 99

tmp3=!randint 12, 99

tmp4=!randint 101, 999

val8=$(tmp0)/10,$(tmp1)/100,$(tmp2)/10000,$(tmp3)/1000,$(tmp4)/1000
tmp0=!shuffle $val8

val8=$(tmp0)
val9=
val10=
!for val11 =1 to 6 
tmp=!nonempty items 0,1,2

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
tmp0=!item $val11 of $val8

val13=$[$(tmp0)+$val12]
val14=$[$val13*100]
tmp0=!append item $val13 to $val9

val9=$(tmp0)
tmp0=!append item $val14 to $val10

val10=$(tmp0)
!next
replytype1=numexp
replyname1=$(val9[1])
replygood1=$(val10[1])
replytype2=numexp
replyname2=$(val9[2])
replygood2=$(val10[2])
