!set title=Géométrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp=!nonempty items carré,losange,rectangle,triangle,triangle équilatèral,triangle isocéle,parallélogramme

tmp0=!randitem $tmp
val7=$(tmp0)
val8=On augmente la longueur de tous les côtés d'un $val7 de
val9=De quel pourcentage son périmètre augmente-t-il&nbsp;
replytype1=numexp
replyname1=Réponse
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val8 $val6 \%. $val9? ------ \end{statement} 


!goto stat

!exit

:question
$()	$val8 $val6 %.	<p>$val9? </p>	<div>	<label for="reply1"><b>Votre réponse </b>:</label>  
!read oef/embed.phtml r1,4 
$() %.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val8 $val6 \%. $val9? ------ $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9
embedcnt=1
