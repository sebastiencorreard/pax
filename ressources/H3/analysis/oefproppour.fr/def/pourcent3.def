replygood4=$(val10[4])
replytype5=numexp
replyname5=\($(val9[5])\)
replygood5=$(val10[5])
replytype6=numexp
replyname6=\($(val9[6])\)
replygood6=$(val10[6])
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val6: \begin{enumerate} \item \($(val9[1]) = \) ..... \item \($(val9[2]) = \) ..... \item \($(val9[3]) = \) ..... \item \($(val9[4]) = \) ..... \item \($(val9[5]) = \) ..... \item \($(val9[6]) = \) ..... \end{enumerate} \end{statement} 


!goto stat

!exit

