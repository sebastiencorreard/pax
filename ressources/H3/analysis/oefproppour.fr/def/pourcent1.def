!set title=Calcul de pourcentage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Calculer les nombres suivants&nbsp;
val7=Calculs,Réponses
val8=Réponse
val9=$[rint(8)]
val10=
val11=
!for val12 =1 to 5 
tmp0=!randint 15, 85

val13=$[rint($(tmp0))]
tmp0=!randint 25, 950

val14=$[rint($(tmp0))]
val15=$[$val14*$val13/100]
val16=$val13 % de $val14
tmp0=!append item $val16 to $val10

val10=$(tmp0)
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!next
replytype1=numexp
replyname1=$val8 1
replygood1=$(val11[1])
replytype2=numexp
replyname2=$val8 2
replygood2=$(val11[2])
replytype3=numexp
replyname3=$val8 3
replygood3=$(val11[3])
replytype4=numexp
replyname4=$val8 4
replygood4=$(val11[4])
replytype5=numexp
replyname5=$val8 5
replygood5=$(val11[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<table class="wimscenter wimsborder">	 <tr>	  <th>$(val7[1])</th>	  <th>$(val7[2])</th>	 </tr>	  
!for m_j=1 to 5 
$()	  <tr>	   <td><label for="reply$m_j">$(val10[$m_j])</label></td>	   <td> 
!read oef/embed.phtml r\j,$val9 
$()</td>	  </tr>	  
!next
$()	</table>	
$()
!exit

