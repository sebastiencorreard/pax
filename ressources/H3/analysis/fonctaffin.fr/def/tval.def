val25=var board2 = JXG.JSXGraph.initBoard('jsxbox2', {	    boundingbox: [-7, $val22, 7, -$val22],	    showCopyright: false,	    keepAspectRatio: false,	    axis: true,	    grid: {	    drawGrid: true,	    gridX: 1,	    gridY: 1	  }	});	var ptA = board2.create('point', [$(val9[1]), $val10], { name: 'A', size: 6, color: 'black', face: 'plus', showInfobox: false, fixed: true,label:{fontSize:25} });	var ptB = board2.create('point', [$(val9[2]), $val11], { name: 'B', size: 6, color: 'black', face: 'plus', showInfobox: false, fixed: true,label:{fontSize:25} });	var ptC = board2.create('point', [$(val9[3]), $val12], { name: 'C', size: 6, color: 'black', face: 'plus', showInfobox: false, fixed: true,label:{fontSize:25} });	var ptD = board2.create('point', [$(val9[4]), $val13], { name: 'D', size: 6, color: 'black', face: 'plus', showInfobox: false, fixed: true,label:{fontSize:25} });	var graph = board2.create('line', [ptA,ptB],{strokeWidth:2,strokeColor:'blue'});	var Ax = board2.create('point', [$(val9[1]), 0], { name: '$(val9[1])', visible: false, color: 'blue', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25,autoPosition: false,anchorX:'middle',anchorY:'top', offset: [$(val14[1]), $(val14[2])], color: 'blue'} });	var Ay = board2.create('point', [0, $val10], { name: '$val10', visible: false, color: 'green', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'left',anchorY:'middle', offset: [$(val15[1]), $(val15[2])], color: 'green' } });	var dxA = board2.create('segment', [[$(val9[1]), $val10], [0, $val10]], { size: 2, color: 'green', dash: 1, fixed: true });	var dyA = board2.create('segment', [[$(val9[1]), $val10], [$(val9[1]), 0]], { size: 2, color: 'blue', dash: 1, fixed: true });	var Bx = board2.create('point', [$(val9[2]), 0], { name: '$(val9[2])', visible: false, color: 'blue', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'middle',anchorY:'top', offset: [$(val16[1]), $(val16[2])], color: 'blue' } });	var By = board2.create('point', [0, $val11], { name: '$val11', visible: false, color: 'green', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'left',anchorY:'middle', offset: [$(val17[1]), $(val17[2])], color: 'green' } });	var dxB = board2.create('segment', [[$(val9[2]), $val11], [0, $val11]], { size: 2, color: 'green', dash: 1, fixed: true });	var dyB = board2.create('segment', [[$(val9[2]), $val11], [$(val9[2]), 0]], { size: 2, color: 'blue', dash: 1, fixed: true });	var Cx = board2.create('point', [$(val9[3]), 0], { name: '$(val9[3])', visible: false, color: 'blue', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'middle',anchorY:'top', offset: [$(val18[1]), $(val18[2])], color: 'blue' } });	var Cy = board2.create('point', [0, $val12], { name: '$val12', visible: false, color: 'green', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'left',anchorY:'middle', offset: [$(val19[1]), $(val19[2])], color: 'green' } });	var dxC = board2.create('segment', [[$(val9[3]), $val12], [0, $val12]], { size: 2, color: 'green', dash: 1, fixed: true });	var dyC = board2.create('segment', [[$(val9[3]), $val12], [$(val9[3]), 0]], { size: 2, color: 'blue', dash: 1, fixed: true });	var Dx = board2.create('point', [$(val9[4]), 0], { name: '$(val9[4])',visible: false, color: 'blue', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'middle',anchorY:'top', offset: [$(val20[1]), $(val20[2])], color: 'blue' } });	var Dy = board2.create('point', [0, $val13], { name: '$val13', visible: false, color: 'green', strokeColor: 'red', face: 'cross', showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:'left',anchorY:'middle', offset: [$(val21[1]), $(val21[2])], color: 'green' } });	var dxD = board2.create('segment', [[$(val9[4]), $val13], [0, $val13]], { size: 2, color: 'green', dash: 1, fixed: true });	var dyD = board2.create('segment', [[$(val9[4]), $val13], [$(val9[4]), 0]], { size: 2, color: 'blue', dash: 1, fixed: true });	var groups = {	    A: { main: ptA, auxPoints: [Ax, Ay], segments: [dxA, dyA] },	    B: { main: ptB, auxPoints: [Bx, By], segments: [dxB, dyB] },	    C: { main: ptC, auxPoints: [Cx, Cy], segments: [dxC, dyC] },	    D: { main: ptD, auxPoints: [Dx, Dy], segments: [dxD, dyD] },	};	var letters = ["A", "B", "C", "D"];	var currentIndex = 0;	var btnExt = document.getElementById('startBtn2');	  btnExt.addEventListener('click', function() {	    btnExt.disabled = true;	    setTimeout(animateBoundingBox(board2, targetBbox2, 1200),1000);	    setTimeout(startAnimation, 600);	  });	
