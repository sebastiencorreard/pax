                                             \frac{\c -x}{\b},-1/\b,\c/\b,\frac{-1 \times x + \tc2}{\b},\frac{-1 \times x}{\b} + \frac{\c}{\b}, - \frac{1}{\b} \times x + \frac{\c}{\b}}}
                    \if{\a<>1 and \a<>-1}{\matrix{datar=\frac{\a}{\b} x \tc,\a/\b,\c,\frac{\a}{\b} \times x + \tc2
