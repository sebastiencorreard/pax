!set title=Quotient de puissance de dix 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 9

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val7=$[rint($(tmp0)*$(val6[1]))]
val8=\frac{1}{10^{$val7}}
val9=$[rint(-$val7)]
replytype1=numexp
replyname1=réponse
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Effectuer le calcul suivant :	<div class="wimscenter"> 
!insmath $val8 = 10
$()<sup> 
!read oef/embed.phtml r1,3 
$()</sup>.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
