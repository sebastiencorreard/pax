!set title=Calcul et priorités 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=3 to 5

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp=!nonempty items 2,3,4

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
val8=$(val6[1])+$(val6[2])^$val7
tmp0=!texmath $val8

val9=$(tmp0)
tmp=!translate ";': to $     $ in $val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$[$(tmp0)]
replytype1=numexp
replyname1=réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Effectuer le calcul suivant :	<div class="wimscenter"> 
!insmath $val9 = 
$()  
!read oef/embed.phtml r1,10 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=1
