!set title=Notation scientifique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1000, 99999

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
val8=$[$val6/10^($val7)]
val8=\($val8 \times 10^$val7)
tmp0=!charcnt $val6

val7=$[rint($(tmp0))]
val7=$[rint($val7-1)]
val9=$[$val6/10^($val7)]
val9=\($val9 \times 10^$val7)
tmp0=!randint 5, 7

val7=$[rint($(tmp0))]
val10=$[$val6/10^($val7)]
val10=\($val10 \times 10^{$val7})
tmp=!nonempty items 2,3,5,7

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[rint($val6*$val11)]
val12=\(\frac{$val12}{$val11})
val6=\($val6)
tmp0=!shuffle $val6,$val8,$val9,$val10,$val12

val13=$(tmp0)
tmp0=!positionof item $val9 in $val13

val14=$(tmp0)
replytype1=checkbox
replyname1=Réponse
replygood1=$val14;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici plusieurs écritures d'un même nombre. Cocher le(s) écriture(s) scientifique(s).	<ul>	 <li> 
!read oef/embed.phtml r1,1 
$()</li>	 <li> 
!read oef/embed.phtml r1,2 
$()</li>	 <li> 
!read oef/embed.phtml r1,3 
$()</li>	 <li> 
!read oef/embed.phtml r1,4 
$()</li>	 <li> 
!read oef/embed.phtml r1,5 
$()</li>	</ul>	
$()
!exit

