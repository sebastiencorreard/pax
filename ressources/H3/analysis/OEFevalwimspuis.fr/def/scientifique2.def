!set title=Notation scientifique 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1000, 99999

val6=$[rint($(tmp0))]
tmp0=!charcnt $val6

val7=$[rint($(tmp0))]
val8=$[rint($val7-1)]
val9=$[$val6/10^($val8)]
replytype1=numexp
replyname1=Partie décimale
replygood1=$val9
replytype2=numexp
replyname2=Exposant
replygood2=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donner l'écriture scientifique du nombre suivant :	<div class="wimscenter">
!insmath $val6 =
$()  
!read oef/embed.phtml r1,15 
$() 
!insmath \times 10
$()<sup> 
!read oef/embed.phtml r2,3 
$()</sup></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=2
