!set title=Notation scientifique 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1111, 99999

val6=$[rint($(tmp0))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 2, 7

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
val9=$[$val6/10^($val8)]
val10=$[rint(floor($val9))]
tmp0=!charcnt $val10

val10=$[rint($(tmp0))]
val6=$val9 \times 10^{$val7}
val11=$[rint($val10-1)]
val12=$[$val9/10^($val11)]
val11=$[rint($val11+$val7)]
replytype1=numexp
replyname1=Partie décimale
replygood1=$val12
replytype2=numexp
replyname2=Exposant
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donner l'écriture scientifique du nombre suivant :	<div class="wimscenter">
!insmath $val6 =
$()  
!read oef/embed.phtml r1,15 
$() 
!insmath \times 10
$()<sup> 
!read oef/embed.phtml r2,3 
$()</sup></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=2
