!set title=Problème 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 5, 7

val7=$[rint($(tmp0))]
tmp0=!randint 2, 4

val8=$[rint($(tmp0))]
tmp=!nonempty items riz,blé

tmp0=!randitem $tmp
val9=$(tmp0)
val10=<b>Messagerie électronique</b>	$val6 envoie un message électronique à $val8 de ses amis. Le lendemain chacun d'entre eux envoie également le même message à $val8 de leurs amis et ainsi de suite.
val11=En supposant que deux personnes ne reçoivent jamais deux fois ce message électronique, combien de personnes l'auront reçu dans $val7 jours
val12=\($val8^$val7)
val13=\($val8\times $val7)
choicename1=Réponse
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	$val11 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=0
