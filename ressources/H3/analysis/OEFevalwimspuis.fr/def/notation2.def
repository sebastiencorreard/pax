!set title=Notation puissance 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=c
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 5

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val6=$[rint($(val6[2]))]
val8=\($val7^$val6)
val9=\($val7\times $val6)
tmp0=!values $val7 for v=1 to $val6

val10=$(tmp0)
tmp0=!replace internal , by \times in $val10

val10=$(tmp0)
val10=\($val10)
choicename1=réponse
choicegood1=$val10
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Parmi les écritures proposées, laquelle est égale à :	<div class="wimscenter">$val8</div>
$()
!exit

