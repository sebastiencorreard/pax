!set title=Problème 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 5, 7

val7=$[rint($(tmp0))]
tmp0=!randint 2, 4

val8=$[rint($(tmp0))]
tmp=!nonempty items riz,blé

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$val6 dispose de $val7 bols. Il les remplit de la façon suivante :	 <ul>	  <li>Il met $val8 grains de $val9 dans le premier.</li>	  <li>Dans le deuxième il met $val8 fois plus de grains que dans le premier.</li>	  <li>Dans le troisième il met $val8 fois plus de grains que dans le deuxième.</li>	  <li>ainsi de suite jusqu'au dernier.</li>	 </ul>
val11=Combien met-il de grains de $val9 dans le dernier bol
val12=\($val8^$val7)
val13=\($val8\times $val7)
choicename1=Réponse
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	$val11 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=0
