!set title=Produit de puissance 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 9

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 2, 7

val7=$[rint($(tmp0))]
tmp0=!shuffle ,,-,-

tmp1=!shuffle ,,,-

tmp=!translate internal $	$ to ; in $(tmp0)	$(tmp1)

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val8=$(tmp2)
val9=$[rint($(val8[4])$(val6[4]))]
val10=$[rint($(val8[1])$(val6[1])+$(val8[2])$(val6[2])+$(val8[3])$(val6[3])+$val9)]
!if $val10=0 
val9=$[rint($val9+1)]
val10=$[rint(1)]
!endif
val11=$val7^{$(val8[1])$(val6[1])}\times $val7^{$(val8[2])$(val6[2])} \times $val7^{$(val8[3])$(val6[3])} \times $val7^{$val9}
replytype1=numexp
replyname1=réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Effectuer le calcul suivant :	<div class="wimscenter"> 
!insmath $val11 = $val7
$()<sup> 
!read oef/embed.phtml r1,3 
$()</sup>.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11
embedcnt=1
