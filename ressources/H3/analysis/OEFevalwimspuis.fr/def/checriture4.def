!set title=Changement d'écriture 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 3, 7

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]

!ifval $val7=1
tmp0=!randint 111111, 999999

val8=$[$(tmp0)/1000]
!else
tmp1=!randint 11111, 99999

val8=$[$(tmp1)/100]
!endif
tmp0=!randitem 1,2

val9=$[rint(-$(tmp0))]
val10=$[$val8*10^($val9)]
val11=$[rint($val6-$val9)]
replytype1=numexp
replyname1=réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter l'égalité suivante :	<div class="wimscenter"> 
!insmath $val8 \times 10^{$val6} =
$()  
!read oef/embed.phtml r1,10 
$() 
!insmath \times 10^{$val11}
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,11
embedcnt=1
