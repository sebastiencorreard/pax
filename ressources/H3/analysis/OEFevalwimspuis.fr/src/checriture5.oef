\title{Changement d'écriture 5}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\integer{p=randitem(5,7,8,-3,-4,-5,-6,-7)}
\real{enonce1=randint(11..99)}
\integer{d=-randint(3..4)}
\real{enonce2=\enonce1*10^(\d)}
\integer{rep=\p-\d}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter"> \(\enonce1 \times 10^{\p} =) \embed{r1,10} \(\times 10^{\rep}).</div>}
\answer{réponse}{\enonce2}{type=numexp}
