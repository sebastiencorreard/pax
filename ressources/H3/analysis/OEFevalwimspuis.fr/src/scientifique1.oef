\title{Notation scientifique 1}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}


\text{nb1=randint(1000..99999)}
\integer{nb=randint(1..2)}
\real{nb2=\nb1/10^(\nb)}
\text{nb2=\(\nb2 \times 10^\nb)}
\integer{nb=wims(charcnt \nb1)}
\integer{nb=\nb-1}
\real{nb3=\nb1/10^(\nb)}
\text{nb3=\(\nb3 \times 10^\nb)}
\integer{nb=randint(5..7)}
\real{nb4=\nb1/10^(\nb)}
\text{nb4=\(\nb4 \times 10^{\nb})}
\integer{p=randitem(2,3,5,7)}
\integer{nb5=\nb1*\p}
\text{nb5=\(\frac{\nb5}{\p})}
\text{nb1=\(\nb1)}
\text{list=shuffle(\nb1,\nb2,\nb3,\nb4,\nb5)}
\text{good=positionof(\nb3,\list)}

\statement{
Voici plusieurs écritures d'un même nombre. Cocher le(s) écriture(s) scientifique(s).
<ul>
 <li>\embed{r1,1}</li>
 <li>\embed{r1,2}</li>
 <li>\embed{r1,3}</li>
 <li>\embed{r1,4}</li>
 <li>\embed{r1,5}</li>
</ul>
}

\answer{Réponse}{\good;\list}{type=checkbox}
