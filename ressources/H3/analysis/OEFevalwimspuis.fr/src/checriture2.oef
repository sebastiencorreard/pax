\title{Changement d'écriture 2}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\integer{p=randitem(1,-1)*randint(3..7)}
\integer{ch=randint(1..2)}
\real{enonce1=\ch=1?randint(111111..999999)/1000:randint(11111..99999)/1000}
\integer{d=randint(1,2)}
\real{enonce2=\enonce1*10^(\d)}
\integer{rep=\p-\d}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter"> \(\enonce1 \times 10^{\p} =) \embed{r1,10} \(\times 10^{\rep}).</div>}
\answer{réponse}{\enonce2}{type=numexp}
