#functie=(Cx -A)(x+B)= Cx^2 +xCB -xA -AB = Cx^2 +x(CB-A) -AB
#a= C
#b= CB-A
#c= AB
!if $R = 1
    a=!randitem -1,1
    b=!randitem -5,-4,-3,-2,-1,1,2,3,4,5
    c=!randitem -10,-8,-6,-4,-2,-1,1,2,4,6,8,10
!else
    !if $R = 2
	a=!randitem -1,-2,-3,1,2,3
	b=!randitem -5,-4,-3,-2,-1,1,2,3,4,5
	c=!randitem -10,-8,-6,-4,-2,-1,1,2,4,6,8,10
    !else
        !if $R = 3
	    a=!randitem -1,-2,-3,1,2,3
	    b=!randitem -5,-4,-3,-2,-1,1,2,3,4,5
	    c=!randitem -10,-8,-6,-4,-2,-1,1,2,4,6,8,10
	!else
	    a=!randitem -1,-2,-3,1,2,3
	    b=!randitem -5,-4,-3,-2,-1,1,2,3,4,5
	    c=!randitem -10,-8,-6,-4,-2,-1,1,2,4,6,8,10
	!endif
    !endif
!endif
plus=<img src="$module_dir/gifs/plus.gif" id="img1" name="img1" style="height:58px;width:58px;border:0px" alt="+" />
min=<img src="$module_dir/gifs/min.gif" id="img2" name="img2" style="height:58px;width:58px;border:0px" alt="&minus;"/>
nul=<img src="$module_dir/gifs/nul.gif" id="img0" name="img0" style="height:58px;width:58px;border:0px" alt="0" />
functie=($a)*x^2 + ($b)*x + ($c)
D=$[$b*$b - 4*($a)*($c)]
!if $D >= 0
    x1=(-1*$b + sqrt($b*$b - 4*($a)*($c)))/(2*($a))
    x2=(-1*$b - sqrt($b*$b - 4*($a)*($c)))/(2*($a))
    tot=!exec maxima expand($x1);\
    expand($x2);
    x11=!line 1 of $tot
    x22=!line 2 of $tot
    !ifval $x11 < $x22
	x1=$x11
	x2=$x22
    !else
	x2=$x11
	x1=$x22
    !endif     
    X1tex=!texmath $x1
    X2tex=!texmath $x2
    !if $D > 0
	texanswer$n= \left[ \begin{array}{l} x_{1} \,=\, $X1tex \\ x_{2} \,=\, $X2tex \end{array}\right.
	!if $a>0
	    answer$n=$x1,$x2,+,x,-,x,+
	    textanswer$n=<table><tr><th>$F(x)</th><th>$plus</th><th>$nul</th><th>$min</th><th>$nul</th><th>$plus</th></tr></table>
	!else
	    answer$n=$x1,$x2,-,x,+,x,-
	    textanswer$n=<table><tr><th>$F(x)</th><th>$min</th><th>$nul</th><th>$plus</th><th>$nul</th><th>$min</th></tr></table>
	!endif
    !else
	# D=0
	texanswer$n= x_{1} \,=\, $X1tex
	!if $a>0
	    answer$n=$x1,+,x,+
	    textanswer$n=<table><tr><th>$F(x)</th><th>$plus</th><th>$nul</th><th>$plus</th></tr></table>
	!else
	    answer$n=$x1,-,x,-
	    textanswer$n=<table><tr><th>$F(x)</th><th>$min</th><th>$nul</th><th>$min</th></tr></table>
	!endif
    !endif
!else
    !if $a>0
	answer$n=+
	textanswer$n=<table><th>$F(x)</th><th>$plus</th><th>$plus</th><th>$plus</th><th>$plus</th></tr></table>
    !else
	answer$n=-
	textanswer$n=<table><th>$F(x)</th><th>$min</th><th>$min</th><th>$min</th><th>$min</th></tr></table>
    !endif
    texanswer$n=x \,\, \notin \,\, \Bf{R}
!endif	
 
formula$n=!texmath $functie
formula$n=$F\left( x \right)\,\,=\,\,$(formula$n)
