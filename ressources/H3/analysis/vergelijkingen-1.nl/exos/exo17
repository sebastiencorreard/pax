        x1=$[-1*$a]
	formula$n=(x+$a)(x-$b)  \,=\, $c x(x+$a) 
        applettext=!nospace (x+$a)(x-$b) = $c x(x+$a) ->
        !if $x1=$x2
    	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x+$a)(x-$b)  = $c x(x+$a) \\   x_{1} \,\,=\,\, $x1 \end{array}
    	    answer$n=$x1
        !else
	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\  (x+$a)(x-$b) = $c x(x+$a) \\ x+$a=0 \wedge x-$b=$c x \\ x_{1} = $x1\\ x_{2} = $tex_x2  \end{array}\right.
	    answer$n=$x1,$x2
        !endif
    !else
        x1=$a
	formula$n=(x-$a)(x-$b)  \,=\, $c x(x-$a) 
        applettext=!nospace (x-$a)(x-$b) = $c x(x-$a) ->
        !if $x1=$x2
    	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x-$a)(x-$b)  \,=\, $c x(x-$a)   \\ x_{1} \,\,=\,\, $x1 \end{array}
    	    answer$n=$x1
        !else
	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x-$a)(x-$b)  \,=\, $c x(x-$a)  \\ x-$a=0 \wedge x-$b=$c x \\ x_{1} = $x1 \\ x_{2} = $tex_x2  \end{array}\right.
	    answer$n=$x1,$x2
        !endif
    !endif
  !exit
!endif

