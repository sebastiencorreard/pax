        !else
	    texanswer$n=\left[ \begin{array}{l} (x-$a)^{2}(x-$b)  \,=\, (x+$c)(x-$a)\\ x-$a=0 \wedge (x-$a)(x-$b)=x+$c \\ x = $a \wedge x^{2}-$a \cdot x-$b \cdot x +$[$a*$b] = x+$c \\ x = $a \wedge x^{2}-$[$a+$b+1] \cdot x = 0 \\  x_{1} = $x1 \wedge x_{2} = $x2 \wedge x_{3}=$x3 \end{array}\right.
	    answer$n=$x1,$x2,$x3
        !endif
    !endif
  !exit
