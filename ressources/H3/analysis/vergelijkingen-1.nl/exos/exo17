	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x-$a)(x-$b)  \,=\, ($c x-$d)(x-$a) \\ x-$a=0 \wedge x-$b=$c x-$d \\ x_{1} = $x1\\ x_{2} = $tex_x2  \end{array}\right.
	    answer$n=$x1,$x2
        !endif	
    !endif
