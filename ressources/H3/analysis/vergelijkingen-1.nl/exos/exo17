!if $R>2
    keuze=!randitem 1,2
    a=!randitem 2,3,4,5,6,7,8,9
    b=!randint 2,10
    c=$[$a*$b]
    !if $keuze=1
        x1=$[-1*$a]
        x2=0
        x3=$[-1*$a+$b+1]
	formula$n=(x+$a)^{2}(x-$b)  \,=\, (x-$c)(x+$a) 
        applettext=!nospace (x+$a)^2(x-$b) = (x - $c)(x+$a) ->
        !if $x2=$x3
	    texanswer$n=\left[ \begin{array}{l}(x+$a)^{2}(x-$b)  \,=\, (x-$c)(x+$a) \\ x+$a=0 \wedge (x+$a)(x-$b)=x-$c \\ x = -$a \wedge x^{2}+$a \cdot x - $b \cdot x -$[$a*$b] = x-$c \\ x = -$a \wedge x^{2}+$[$a-$b-1] \cdot x = 0  \\  x_{1} = $x1 \wedge x_{2} = $x2 x_{3}=$x3 \end{array}\right.
    	    answer$n=$x1,$x2
        !else
	    texanswer$n=\left[ \begin{array}{l}(x+$a)^{2}(x-$b)  \,=\, (x-$c)(x+$a) \\ x+$a=0 \wedge (x+$a)(x-$b)=x-$c \\ x = -$a \wedge x^{2}+$a \cdot x - $b \cdot x - $[$a*$b]=x-$c \\ x = -$a \wedge x^{2}+$[$a-$b-1] \cdot x = 0 \\ x_{1} = $x1 \wedge x_{2} = $x2 x_{3}=$x3 \end{array}\right.
	    answer$n=$x1,$x2,$x3
        !endif
