	formula$n=(x+$a)(x-$b)  \,=\, ($c x+$d)(x+$a) 
        applettext=!nospace (x+$a)(x-$b) = ($c x + $d)(x+$a) ->
        !if $x1=$x2
    	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x+$a)(x-$b)  \,=\, ($c x+$d)(x+$a) \\  x_{1} \,\,=\,\, $x1 \end{array}\right.
