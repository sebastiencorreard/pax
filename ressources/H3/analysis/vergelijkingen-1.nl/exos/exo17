	    answer$n=$x1,$x2
        !endif	
    !else
        tot=!exec pari A=(-1*$b+$d)/($c-1)\
        printtex(A)
        x2=!line 1 of $tot
        tex_x2=!line 2 of $tot
        x1=$a
	formula$n=(x-$a)(x-$b)  \,=\, ($c x-$d)(x-$a) 
        applettext=!nospace (x-$a)*(x-$b) = ($c x - $d)*(x-$a) ->
        !if $x1=$x2
	    texanswer$n=\left[ \begin{array}{l} a \cdot b = a \cdot c \rightarrow a \cdot b - a \cdot c = 0 \rightarrow a (b - c) = 0 \rightarrow a = 0 \wedge b = c \\ \\ (x-$a)(x-$b)  \,=\, ($c x-$d)(x-$a) \\ x-$a=0 \wedge x-$b=$c x-$d \\  x_{1} = $tex_x1  \end{array}\right.
    	    answer$n=$x1
