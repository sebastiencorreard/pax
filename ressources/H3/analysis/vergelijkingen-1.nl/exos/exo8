n=$counter
!if $rounding=-1
    rounding=0
    !readproc $remarkdir/rounding.$taal
!endif
image=0
impossible=0
questiontype=0
arglist=x
kleuren=red,blue,green,orange,purple
kleuren=!shuffle $kleuren
color1=!item 1 of $kleuren
color2=!item 2 of $kleuren
exotext=$empty
sometext=!record 6 of lang/remarks.$taal
raaklijn=!item 1 of $sometext
raken=!item 2 of $sometext
embed=1

!if $level=0
    R=$counter
!else
    R=$level
!endif

!if $subject=8
    checkfile=$checkdir/number.proc
    cols=15
    rows=2
    ss=!record 2 of lang/remarks.$taal
    helptext=!record 23 of lang/remarks.$taal
    mathviewpanel=$module_title:x1=:and:x2=:sqrt()
!else
    R=$[$R+1]
    # eerste som te makkelijk...
    checkfile=exos/checkfile2.proc
    math=1
    var1=5
    varlist=x
    # max number of arrows
    cols=40
    rows=4
    ss=!record 25 of lang/remarks.$taal
    helptext=!record 26 of lang/remarks.$taal
    mathviewpanel=$module_title:->x1=:x2=:and
# convert all arrows to "->"
    my_arrows=0
!endif
question$n=<a onmouseover="return escape('$helptext')">$ss</a>


!if $R=1
    #c*(x+a)(x+b)=0
    a=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    b=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    c=!randitem -1,1
    !if $a=$b
	a=$[$a-1]
    !endif
    curve1=$c*(x+$a)*(x+$b)
    fac1=!rawmath x+$a
    fac2=!rawmath x+$b
    
    C1=!htmlmath $curve1 = 0
    tot=!exec pari A=($curve1)\
    printtex(A)
    
    f1=!line 1 of $tot
    ftex1=!line 2 of $tot
    formula$n= $ftex1 \,=\, 0
    applettext=!nospace $f1 = 0 ->
    x1=$[-1*$a]
    x2=$[-1*$b]
    y1=0
    y2=0
    rr=!record 7 of lang/remarks.$taal
    #@ We ontbinden de vergelijking eerst in factoren, <br />dus de vergelijking wordt dan $C1 <br />
    textanswer$n=$rr
    texanswer$n=\left[ \begin{array}{l} $ftex1 = 0 \\ $c \cdot \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1 = 0 \bigvee $fac2 = 0 \\  x_{1} = $x1\\ x_{2} = $x2  \end{array}\right.
    answer$n=$x1,$x2
    !if $teaching=1
	XRANGE=-15,15
	YRANGE=-50,50
	curve1=curve $color1,$curve1
	curve2=hline 0,0,$color2
	!readproc exos/image1.proc
    !endif
  !exit
!endif
!if $R=2
    #(x+a)(x+b)=x^2+(a+b)x +ab=0
    #x^2+ex+f = cx+ d
    # x^2+x(e-c)+ (f-d)=0
    
    a=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    b=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    c=!randitem -5,-4,-3,-2,-1,2,3,4,5
    d=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    pm=!randitem 1,-1
    !if $pm=-1
	e=$[(-1*($a)) + (-1*($b)) + ($c)]
	!if $e=0
	    a=-2
	    b=4
	    c=7
	    e=5
	!endif
	f=$[-1*($a)*($b)+($d)]
    !else
	e=$[($a) + ($b) + ($c)]
	!if $e=0
	    a=-2
    	    b=4
    	    c=3
	    e=5
	!endif
	f=$[($a)*($b)+($d)]
    !endif
    curve1=$pm*x^2 + ($e)*x + ($f)
    curve2=($c)*x + ($d)
    tot=!exec pari A=($curve1)\
    printtex(A)\
    B=($curve2)\
    printtex(B)\
    printtex(A - (B))
    
    f1=!line 1 of $tot
    ftex1=!line 2 of $tot
    f2=!line 3 of $tot
    ftex2=!line 4 of $tot
    tussen=!line 5 of $tot
    fac1=!rawmath x+$a
    fac2=!rawmath x+$b
    formula$n= $ftex1 \,=\, $ftex2 
    applettext=!nospace $f1 = $f2 ->
    x1=$[-1*$a]
    x2=$[-1*$b]
    y1=$[$c*$x1+($d)]
    y2=$[$c*$x2+($d)]
    !if $a=$b
	texanswer$n=\left[ \begin{array}{l}  $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1 = 0  \\ x = $x1 \\ \textrm{$raaklijn} \end{array}\right.
	answer$n=$x1
    !else
	texanswer$n=\left[ \begin{array}{l} $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1=0 \bigvee $fac2 =0 \\ x_{1} = $x1 \\ x_{2} = $x2  \end{array}\right.
	answer$n=$x1,$x2
    !endif
#    antwoord=$a\cdot x^{2}+$b\cdot x+$c=$c \Longleftrightarrow  x\left($a\cdot x+$b\right)=$c-$c \Longrightarrow  
    !if $teaching=1
	curve1=$pm*x^2+($e)*x+($f)
	curve2=($c)*x+($d)
	XRANGE=-15,15
	YRANGE=-80,80
	curve1=curve $color1,$curve1
	curve2=curve $color2,$curve2
	!readproc exos/image1.proc
    !endif
  !exit
!endif
!if $R=3
    #ax^2+bx+c=dx^2+ex+f
    a=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    b=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    c=!randitem -4,-3,-2,-1,2,3,4
    d=!randitem 1/2,1/3,1/4,1/5,2/3,3/4,4/5,-1/2,-1/3,-1/4,-1/5,-2/3,-3/4,-4/5
    e=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    f=!randitem -9,-8,-7,-6,-5,-4,-3,-2,-1,2,3,4,5,6,7,8,9
    p=!exec pari $c+$d
    q=$[($c)*($a)+($c)*($b) + ($e)]
    r=$[($c)*($a)*($b) + ($f)]
    tot=!exec pari A=(($p)*x^2+($q)*x + ($r)) \
    printtex(A)\
    B=(($d)*x^2 + ($e)*x + ($f))\
    printtex(B)\
    printtex(A - (B))
    
    f1=!line 1 of $tot
    ftex1=!line 2 of $tot
    f2=!line 3 of $tot
    ftex2=!line 4 of $tot
    tussen=!line 5 of $tot
    
    formula$n= $ftex1 \,=\, $ftex2
    applettext=!nospace $f1 = $f2 ->
    x1=$[-1*($a)]
    x2=$[-1*($b)]
    y1=$[$d*$x1*$x1 + $e*$x1 + $f]
    y2=$[$d*$x2*$x2 + $e*$x2 + $f]
    fac1=!rawmath x+$a
    fac2=!rawmath x+$b
    !if $a=$b
	texanswer$n=\left[ \begin{array}{l}  $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1 = 0  \\ x = $x1 \\ \textrm{$raken} \end{array}\right.
	answer$n=$x1
    !else
	texanswer$n=\left[ \begin{array}{l} $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1=0 \bigvee $fac2 =0 \\ x_{1} = $x1 \\ x_{2} = $x2  \end{array}\right.
	answer$n=$x1,$x2
    !endif

    !if $teaching=1
	curve1=($p)*x^2+($q)*x + ($r)
	curve2=($d)*x^2+($e)*x + ($f)
	XRANGE=-20,20
	YRANGE=-200,200
	curve1=curve $color1,$curve1
	curve2=curve $color2,$curve2
	!readproc exos/image1.proc
    !endif
  !exit
!endif

!if $R>3
    #p+c(x+q)^2=d(x+e)
    a=!randitem -5,-4,-3,-2,-1,2,3,4,5
    b=!randitem -5,-4,-3,-2,-1,2,3,4,5
    c=!randitem 1,2,3,4,-1,-2,-3,-4
    d=!randitem 2,3,4,-1,-2,-3,-4
    e=!randitem -5,-4,-3,-2,-1,2,3,4,5
    f=!randitem -5,-4,-3,-2,-1,2,3,4,5
    !if $[$c*$a + $c*$b + $d] = 0
	a=2
	b=-3
	c=-1
	d=-2
    !endif
    q=!exec pari (($c)*$a+($c)*$b+($d))/(2*($c))
    p=!exec pari ($c)*$a*$b+($d)*$e-($c)*$q*$q
    !if $p=0
	f1=!rawmath $c*(x+$q)^2
	ftex1=!texmath $f1
	curve1=$f1
    !else
	f1=!rawmath $p+$c*(x+$q)^2
	ftex1=!texmath $f1
	curve1=$f1
    !endif
    f2=!rawmath $d*(x + $e)
    ftex2=!texmath $f2
    curve2=$f2
    tussen=!exec pari printtex($f1 - ($f2))
    
    formula$n= $ftex1 \,\,\,=\,\,\, $ftex2
    applettext=!nospace $f1 = $f2 ->
    x1=$[-1*($a)]
    x2=$[-1*($b)]
    y1=$[$d*($x1 + $e)]
    y2=$[$d*($x2 + $e)]
    fac1=!rawmath x+$a
    fac2=!rawmath x+$b
    !if $a=$b
	texanswer$n=\left[ \begin{array}{l}  $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1 = 0  \\ x = $x1 \\ \textrm{$raken} \end{array}\right.
	answer$n=$x1
    !else
	texanswer$n=\left[ \begin{array}{l} $ftex1 = $ftex2 \\ $ftex1 - \left( $ftex2 \right) = 0 \\ $tussen = 0 \\ \left( $fac1 \right)\left( $fac2 \right) = 0 \\ $fac1=0 \bigvee $fac2 =0 \\ x_{1} = $x1 \\ x_{2} = $x2  \end{array}\right.
	answer$n=$x1,$x2
    !endif
    !if $teaching=1
	XRANGE=-20,20
	YRANGE=-200,200
	curve1=curve $color1,$curve1
	curve2=curve $color2,$curve2
	!readproc exos/image1.proc
    !endif
  !exit
!endif

  
