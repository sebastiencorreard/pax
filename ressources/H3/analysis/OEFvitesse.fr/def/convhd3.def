!set title=Conversion horaire vers décimal 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim HMS,H	HMS,M
val6=!translate internal $	\
$ to ;; in $tmp
val7=$[rint(1)]

!ifval $val2=
val2=$[rint(1)]
!endif
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=$(tmp0)
!readproc slib/convheure $val9,$val10 
tmp0=$slib_out
val11=$(tmp0)
!if $val7=1 
tmp=!translate internal $	$ to ; in $val11

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
!else
tmp=!translate internal $	$ to ; in $val11

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 2 of $val8

val9=$(tmp0)
tmp0=!item 1 of $val8

val10=$(tmp0)
!endif
val14=h,min,s
val15=H,M,S
tmp0=!itemcnt $val12

val16=$[rint($(tmp0))]
val17=
!for val18 =1 to $val16 
tmp0=!char $val18 of $val9

val19=$(tmp0)
tmp0=!positionof item $val19 in $val15

val20=$[rint($(tmp0))]
tmp0=!item $val20 of $val14

val21=$(tmp0)
val17=$val17 $(val12[$val18]) $val21
!next
tmp0=!itemcnt $val13

val16=$[rint($(tmp0))]
val22=
!for val18 =1 to $val16 
tmp0=!char $val18 of $val10

val19=$(tmp0)
tmp0=!positionof item $val19 in $val15

val20=$[rint($(tmp0))]
tmp0=!item $val20 of $val14

val21=$(tmp0)
tmp0=!append item $val21 to $val22

val22=$(tmp0)
!next

!ifval $val7=1
val23=Convertir dans le système décimal
!else
val23=Convertir dans le système horaire
!endif
tmp0=!item 1 to $val16 of r1,r2,r3

oefsteps=$(tmp0) 
nextstep=!nosubst $(tmp0) 
!readproc oef/steps.proc
replytype1=numexp
replyname1=$(val22[1])
replygood1=$(val13[1])
replytype2=numexp
replyname2=$(val22[2])
replygood2=$(val13[2])
replytype3=numexp
replyname3=$(val22[3])
replygood3=$(val13[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val23.	<div class="wimscenter">	$val17 =  
!for m_j=1 to $val16 
$() 
!read oef/embed.phtml r\j,10 
$() $(val22[$m_j]) 
!next
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,17,22,23
embedcnt=1
