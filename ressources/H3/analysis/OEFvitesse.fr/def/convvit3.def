!set title=Conversion vitesse 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim km/h,km/min,km/s,m/h,m/s,m/min
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
val10=km/h,km/min,km/s,m/h,m/s,m/min
val11=3600,60,1,3600000,1000,60000
tmp0=!randint 100, 500

val12=$[$(tmp0)/100]
tmp0=!positionof item $val8 in $val10

val13=$[rint($(tmp0))]
tmp0=!positionof item $val9 in $val10

val14=$[rint($(tmp0))]
tmp0=!item $val13 of $val11

val15=$[$val12*$(tmp0)]
tmp0=!item $val14 of $val11

val16=$[$val12*$(tmp0)]
replytype1=numexp
replyname1=\($val15 $val8)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Convertir $val15 $val8 en $val9.	<div class="spacer">	<b>Votre réponse</b>: $val15 $val8 = 
!read oef/embed.phtml r1,9 
$() $val9.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,15
embedcnt=1
