\title{Calculer une quatrième proportionnelle 2}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}
\text{v=shuffle(11,12,13,14,15,16,17,18,19)}
\integer{a=\v[1]}
\integer{b=\v[2]}
\integer{x=randint(2..9)}
\integer{c=\a*\x}
\integer{d=\b*\x}

\statement{
Compléter le tableau de proportionnalité suivant :
<table class="wimscenter wimsborder">
 <tr>
  <td>\a</td>
  <td>\embed{r1,5}</td>
 </tr><tr>
  <td>\b</td>
  <td>\d</td>
 </tr>
 </table>}
\answer{}{\c}{type=numexp}
