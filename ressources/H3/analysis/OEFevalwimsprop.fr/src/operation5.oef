\title{Opération sur les pourcentages 5}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{name=slib(lang/fname fr,boy)}
\integer{lit=randint(2,3,4)}
\integer{pour=randint(1..4)*5}
\integer{p=\lit*\pour}
\integer{p2=\lit+\pour}

\statement{
Pour peindre un mur, \name doit diluer sa peinture. Sur le pot d'un litre,
il est écrit : <i>Diluer avec \pour % d'eau.</i>.
\name décide de préparer \lit litres de peinture.<br>
Quel est le pourcentage d'eau dans le mélange obtenu ?}

\choice{réponse}{\pour %}{\p %,\lit %,\p2 %}
