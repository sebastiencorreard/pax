\title{Reconnaître la proportionnalité B2}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}

\integer{cx=randitem(2,4,5)}
\integer{cy=randitem(4,5,10)}
\integer{p=randint(9..13)}
\integer{ch=randint(1..2)}
\text{x1=randint(4..6)}
\text{x2=randint(9..11)}
\text{x3=randint(14..16)}
\if{\ch=1}{
 \text{coeff=randitem(1,1/2,1/3,6/5)}
 \integer{o=0}
}{
 \text{coeff=randitem(1/4,1/5)}
 \integer{o=randint(10..15)}
}

\text{name=slib(lang/fname fr,boy)}
\integer{p=randint(9..13)}
\text{dessin=slib(draw/repere 480,480,40,0,20,0,20,1,1,black,grey)}
\text{dessin=\dessin
range -2,22,-2,22
text black,-2,\cy+0.4,medium,10 cm
text black,\cx-0.3,-0.3,medium,1H
linewidth=4
point \x1,\o+\coeff*\x1,red
point \x2,\o+\coeff*\x2,red
point \x3,\o+\coeff*\x3,red}
\text{figure=draw(480,480
\dessin)}
\text{bad=Oui,Non}
\text{good=item(\ch,\bad)}
\statement{
\name a ouvert un robinet pour remplir sa piscine. Il a relevé la hauteur d'eau dans
la piscine à différents moments et la reportée dans le graphique ci-dessous.
Peut-on dire que la hauteur d'eau contenue dans la piscine
est proportionnelle au temps écoulé ?
<div class="wimscenter"><img src="\figure" alt=""></div>
}

\choice{}{\good}{\bad}
