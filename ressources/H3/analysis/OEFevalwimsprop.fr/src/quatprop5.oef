\title{Calculer une quatrième proportionnelle 5}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}
\keywords{proportionality}
\real{a=randint(111..999)/10}
\real{b=randint(111..999)/10}
\real{b=\a=\b?\b+randint(1..5)}
\real{x=randitem(2,3,6,7)}
\real{c=\a*\x}
\real{d=\b*\x}
\integer{ch=randint(1..2)}
\real{rep=\ch=1?\c:\d}

\statement{
Compléter l'égalité suivante :
<table class="wimscenter wimsnoborder">
 <tr>
  <td>\if{\ch=1}{\embed{r1,5}}{\c}</td>
  <td></td>
  <td>\a</td>
 </tr><tr>
  <td><hr></td>
  <td>=</td>
  <td><hr></td>
 </tr><tr>
  <td>\if{\ch=2}{\embed{r1,5}}{\d}</td>
  <td></td>
  <td>\b</td>
 </tr>
 </table>}
\answer{}{\rep}{type=numexp}
