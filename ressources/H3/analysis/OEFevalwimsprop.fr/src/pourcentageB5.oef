\title{Calculer un pourcentage 5}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}

\integer{ch=randitem(2,3,4)}
\integer{an=randint(6..10)}
\text{name=,doublé,triplé,quadruplé}
\text{change=item(\ch,\name)}
\text{ltgood=,100 %,200 %,300 %}
\text{good=item(\ch,\ltgood)}
\integer{t1=\an*100}
\integer{t2=(\an-1)*100}
\integer{t3=\ch*100}
\text{bad=\t3 %,\ch %,\t1 %,\t2 %,\an %}

\text{name=slib(lang/fname fr,girl)}
\statement{
Le bénéfice d'une petite entreprise a \change en \an ans.
Quel est le pourcentage d'augmentation du bénéfice sur cette période ?}

\choice{}{\good}{\bad}
