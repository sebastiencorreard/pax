\author{Fabrice,Guerimand}
email{fwguerima@free.fr}
\text{name=slib(lang/fname fr,boy)}

\title{Utiliser un pourcentage 1}

\integer{N1=randint(3..9)*100}
\integer{P1=randint(2..4)*10}
\real{rep1=\N1*\P1/100}

\integer{N2=randint(3..9)*100+randint(1..9)*10}
\real{P2=randint(2..9)/10}
\real{rep2=\N2*\P2/100}

\integer{N3=randint(3..9)*100+randint(1..9)*10}
\real{P3=100+randitem(5,10,15,25,20)}
\real{rep3=\N3*\P3/100}

\statement{
Calculer :<ul>
<li>\P1 % de \N1 : \embed{r1,5}</li>
<li>\P2 % de \N2 : \embed{r2,5}</li>
<li>\P3 % de \N3 : \embed{r3,5}</li>
</ul>}

\answer{Premier calcul}{\rep1}{type=numexp}
\answer{Deuxième calcul}{\rep2}{type=numexp}
\answer{Troisième calcul}{\rep3}{type=numexp}
