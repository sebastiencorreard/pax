\text{v=shuffle(11,12,13,14,15,16,17,18,19)}
\integer{a=\v[1]}
\integer{b=\v[2]}
\integer{x=randint(2..9)}
\integer{c=\a*\x}
\integer{d=\b*\x}

\statement{
Compléter l'égalité suivante :
