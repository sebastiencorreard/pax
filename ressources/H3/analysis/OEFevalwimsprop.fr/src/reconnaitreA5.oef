\title{Reconnaître la proportionnalité 5}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{nombre1=randint(3..7)}
\integer{nombre2=randint(15..20)}
\integer{prix=randint(15..25)}
\integer{ch=randint(1..2)}
\integer{prix1=\nombre1*\prix}
\integer{prix2=\ch=1?\nombre2*\prix:\nombre2*\prix-randint(1..3)*\prix}
\text{bad=Oui,Non}
\text{good=item(\ch,\bad)}

\statement{<ul>
<li>Dans un restaurant, un groupe de \nombre1 personnes a payé \prix1 euros.</li>
<li>Un autre groupe de \nombre2 personnes a payé \prix2 euros.</li>
<li>Dans ce restaurant, le prix à payer est-il proportionnel au nombre de personnes ?</li>
</ul>}

\choice{}{\good}{\bad}
