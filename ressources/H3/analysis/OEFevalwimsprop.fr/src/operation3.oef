\title{Opération sur les pourcentages 3}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{pour1=randitem(35,40,45,55,60)}
\integer{pour2=randint(15..45)}
\integer{rep=\pour1*\pour2/100}
\text{carac=randitem(boucles d'oreilles,lunettes,poupées)}
\statement{
Dans une classe, \pour1 % des élèves sont des filles. Parmi ces filles,
\pour2 % ont des \carac alors qu'aucun des garçons n'en a.
<p>
Quel pourcentage des enfants de la classe ont des \carac ?
</p>
<b>Votre réponse :</b> \embed{r1,5} %<br>
<div class="wims_instruction">Le résultat doit être arrondi à l'unité.</div>}

\answer{réponse}{\rep}{type=numexp}
