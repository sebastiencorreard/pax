\title{Reconnaître la proportionnalité B3}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}

\integer{cx=randitem(2,4,5)}
\integer{cy=randitem(4,5,10)}
\integer{p=randint(9..13)}
\integer{ch=randint(1..2)}
\text{x1=randint(4..6)}
\text{x2=randint(9..11)}
\text{x3=randint(14..16)}
\if{\ch=1}{
 \text{ligne=segment 0,0,19,randint(14..18),red}
}{
 \integer{t1=randint(8..12)}
 \integer{t2=randint(16..18)}
 \text{ligne=segment 0,0,\t1,\t2,red
segment \t1,\t2,19,randint(19..20),red}
}

\text{name=slib(lang/fname fr,boy)}
\integer{p=randint(9..13)}
\text{dessin=slib(draw/repere 480,480,40,0,20,0,20,1,1,black,grey)}
\text{dessin=\dessin
range -2,22,-2,22
text black,-2,\cy+0.4,medium,10 m3
text black,\cx-0.3,-0.3,medium,1 m
linewidth=2
\ligne}
\text{figure=draw(480,480
\dessin)}

\text{bad=Oui,Non}
\text{good=item(\ch,\bad)}

\statement{
Sur le graphique ci-dessous, \name a représenté le volume d'eau contenu
dans un réservoir en fonction de la hauteur atteinte par l'eau.
Peut-on dire que le volume d'eau contenu dans le réservoir est proportionnel à la hauteur d'eau ?
<div class="wimscenter"><img src="\figure" alt=""></div>}
\choice{}{\good}{\bad}
