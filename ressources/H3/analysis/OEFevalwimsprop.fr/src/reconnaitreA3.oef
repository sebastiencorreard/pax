\title{Reconnaître la proportionnalité 3}
\author{Fabrice,Guerimand}
email{fwguerima@free.fr}

\text{bad=Non,Oui}
\text{name=slib(lang/fname fr,boy)}
\real{a=randitem(0.65,0.70,0.75)}
\integer{n1=randint(2..6)}
\integer{n2=randitem(10,15,20)}
\integer{n3=randitem(25,30,35,40)}
\integer{ch=randint(1..2)}
\integer{c=randitem(2,3,4)}
\if{\ch=2}{
 \real{p1=\n1*\a}
 \real{p2=\n2*\a}
 \real{p3=\n3*\a}
}{
 \real{p1=\n1*\a}
 \real{p2=(\n2-\c)*\a}
 \real{p3=(\n3-2*\c)*\a}
}

\text{good=item(\ch,\bad)}

\statement{
Sur la vitrine d'une boulangerie, \name voit affiché :
<table class="wimscenter wimsborder">
 <tr>
  <th>Nombre de pains</th>
  <td>1</td>
  <td>\n1</td>
  <td>\n2</td>
  <td>\n3</td>
 </tr>
 <tr>
  <th>Prix à payer (en euros)</th>
  <td>\a</td>
  <td>\p1</td>
  <td>\p2</td>
  <td>\p3</td>
 </tr>
 </table>
Le prix à payer est-il proportionnel au nombre de pains achetés ?}

\choice{}{\good}{\bad}
