!set title=Utiliser un pourcentage 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 3, 9

val7=$[rint($(tmp0)*100)]
tmp0=!randint 2, 4

val8=$[rint($(tmp0)*10)]
val9=$[$val7*$val8/100]
tmp0=!randint 3, 9

tmp1=!randint 1, 9

val10=$[rint($(tmp0)*100+$(tmp1)*10)]
tmp0=!randint 2, 9

val11=$[$(tmp0)/10]
val12=$[$val10*$val11/100]
tmp0=!randint 3, 9

tmp1=!randint 1, 9

val13=$[rint($(tmp0)*100+$(tmp1)*10)]
tmp=!nonempty items 5,10,15,25,20

tmp0=!randitem $tmp
val14=$[100+$(tmp0)]
val15=$[$val13*$val14/100]
replytype1=numexp
replyname1=Premier calcul
replygood1=$val9
replytype2=numexp
replyname2=Deuxième calcul
replygood2=$val12
replytype3=numexp
replyname3=Troisième calcul
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer :<ul>	<li>$val8 % de $val7 :  
!read oef/embed.phtml r1,5 
$()</li>	<li>$val11 % de $val10 :  
!read oef/embed.phtml r2,5 
$()</li>	<li>$val14 % de $val13 :  
!read oef/embed.phtml r3,5 
$()</li>	</ul>
$()
!exit

