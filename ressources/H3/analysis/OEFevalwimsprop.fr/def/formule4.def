!set title=Formule 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=conversion
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 19

val6=$[rint(3*$(tmp0))]
tmp0=!randint 4, 11

val7=$[rint(9*$(tmp0))]
val8=secondes
val9=$[$val7*$val6/36*10]
val10=$val6
val11=Combien de temps faut-il pour parcourir $val9 mètres à la vitesse de $val7 km/h &#63;
replytype1=numexp
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11	<div class="spacer">	<label for="reply1"><b>Votre réponse :</b></label>  
!read oef/embed.phtml r1,5 
$() $val8.</div>	$m_remarque
$()
!exit

