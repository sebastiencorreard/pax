!set title=Conversion d'unités de temps 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=conversion
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Convertir dans le système décimal,	  Convertir dans le système horaire
tmp=!trim HM,H
val7=!translate internal $	\
$ to ;; in $tmp
val8=$[rint(1)]
val9=$(val6[$val8])
val2=$[rint(1)]
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
!readproc slib/convheure $val11,$val12 
tmp0=$slib_out
val13=$(tmp0)
!if $val8=1 
tmp=!translate internal $	$ to ; in $val13

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
!else
tmp=!translate internal $	$ to ; in $val13

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 2 of $val10

val11=$(tmp0)
tmp0=!item 1 of $val10

val12=$(tmp0)
!endif
val16=h,min,s
val17=H,M,S
tmp0=!itemcnt $val14

val18=$[rint($(tmp0))]
val19=
!for val20 =1 to $val18 
tmp0=!char $val20 of $val11

val21=$(tmp0)
tmp0=!positionof item $val21 in $val17

val22=$[rint($(tmp0))]
tmp0=!item $val22 of $val16

val23=$(tmp0)
val19=$val19 $(val14[$val20]) $val23
!next
tmp0=!itemcnt $val15

val18=$[rint($(tmp0))]
val24=
!for val20 =1 to $val18 
tmp0=!char $val20 of $val12

val21=$(tmp0)
tmp0=!positionof item $val21 in $val17

val22=$[rint($(tmp0))]
tmp0=!item $val22 of $val16

val23=$(tmp0)
tmp0=!append item $val23 to $val24

val24=$(tmp0)
!next
tmp0=!item 1 to $val18 of r1,r2,r3

oefsteps=$(tmp0) 
nextstep=!nosubst $(tmp0) 
!readproc oef/steps.proc
replytype1=numexp
replyname1=$(val24[1])
replygood1=$(val15[1])
replytype2=numexp
replyname2=$(val24[2])
replygood2=$(val15[2])
replytype3=numexp
replyname3=$(val24[3])
replygood3=$(val15[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val9.	<div class="wimscenter"><label for="reply1">$val19 =</label>	 
!for m_j=1 to $val18 
$() 
!read oef/embed.phtml r\j,10 
$() $(val24[$m_j]) 
!next
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

