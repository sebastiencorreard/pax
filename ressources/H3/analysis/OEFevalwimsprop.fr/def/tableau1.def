!set title=Compléter un tableau 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter le tableau de proportionnalité suivant sachant que le coefficient de proportionnalité (pour passer de la première à la deuxième ligne) est
tmp0=!randint 2, 9

val7=$[$(tmp0)]
tmp0=!shuffle 0,0,0,0

val8=$(tmp0)
tmp0=!shuffle 1,1,1,0

val9=$(tmp0)
val10=$val6 $val7
tmp0=!values v for v=2 to 20

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 to 4 of $val11

val12=$(tmp0)
val13=
val14=
!for val15 =1 to 4 
val16=$[$(val12[$val15])*$val7]
tmp0=!append item $val16 to $val13

val13=$(tmp0)

!ifval $(val8[$val15])=1
tmp0=!append item r$val15 to $val14

val14=$(tmp0)
!endif
val17=$[rint(4+$val15)]

!ifval $(val9[$val15])=1
tmp0=!append item r$val17 to $val14

val14=$(tmp0)
!endif
!next
oefsteps=$val14 
nextstep=!nosubst $val14 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Première ligne, première colonne
replygood1=$(val12[1])
replytype2=numexp
replyname2=Première ligne, deuxième colonne
replygood2=$(val12[2])
replytype3=numexp
replyname3=Première ligne, troisième colonne
replygood3=$(val12[3])
replytype4=numexp
replyname4=Première ligne, quatrième colonne
replygood4=$(val12[4])
replytype5=numexp
replyname5=Deuxième ligne, première colonne
replygood5=$(val13[1])
replytype6=numexp
replyname6=Deuxième ligne, deuxième colonne
replygood6=$(val13[2])
replytype7=numexp
replyname7=Deuxième ligne, troisième colonne
replygood7=$(val13[3])
replytype8=numexp
replyname8=Deuxième ligne, quatrième colonne
replygood8=$(val13[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10.	<table class="wimscenter wimsborder">	 <tr>	   
!for m_m=1 to 4 
$()<td>
!if $(val8[$m_m])=1 
$() 
!read oef/embed.phtml r\m,5 
$() 
!else
$() $(val12[$m_m]) 
!endif
$()</td> 
!next
$()	 </tr><tr>	   
!for m_n=5 to 8 
$()<td>
!if $(val9[$m_n-4])=1 
$() 
!read oef/embed.phtml r\n,5 
$() 
!else
$() $(val13[$m_n-4]) 
!endif
$()</td> 
!next
$()	 </tr>	</table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,12,13
embedcnt=2
