!set title=Formule 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=conversion
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 5,10,20

tmp0=!randitem $tmp
val6=$[rint($(tmp0)*10)]
tmp=!nonempty items 15,12,6,45,30

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val9=$(tmp0)
!if $val8=$val9 
val8=Anthony
val9=Matthieu
!endif
val10=heures
val11=$[1000/$val6*$val7/60]
val12=$val8 parcourt $val6 mètres de plus que $val9 toutes les $val7 minutes.	 Dans combien de temps aura-t-il 1 kilomètre d'avance &#63;
replytype1=numexp
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12	<div class="spacer">	<label for="reply1"><b>Votre réponse :</b></label>  
!read oef/embed.phtml r1,5 
$() $val10.</div>	$m_remarque
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,12
embedcnt=1
