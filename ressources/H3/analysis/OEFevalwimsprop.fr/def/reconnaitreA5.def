!set title=Reconnaître la proportionnalité 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 7

val6=$[rint($(tmp0))]
tmp0=!randint 15, 20

val7=$[rint($(tmp0))]
tmp0=!randint 15, 25

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=$[rint($val6*$val8)]

!ifval $val9=1
val11=$[rint($val7*$val8)]
!else
tmp0=!randint 1, 3

val11=$[rint($val7*$val8-$(tmp0)*$val8)]
!endif
val12=Oui,Non
tmp0=!item $val9 of $val12

val13=$(tmp0)
choicename1=
choicegood1=$val13
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<ul>	<li>Dans un restaurant, un groupe de $val6 personnes a payé $val10 euros.</li>	<li>Un autre groupe de $val7 personnes a payé $val11 euros.</li>	<li>Dans ce restaurant, le prix à payer est-il proportionnel au nombre de personnes ?</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11
embedcnt=0
