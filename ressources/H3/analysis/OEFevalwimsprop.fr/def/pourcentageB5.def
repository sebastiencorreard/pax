!set title=Calculer un pourcentage 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand

ansorder=c
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,3,4

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 6, 10

val7=$[rint($(tmp0))]
val8=,doublé,triplé,quadruplé
tmp0=!item $val6 of $val8

val9=$(tmp0)
val10=,100 %,200 %,300 %
tmp0=!item $val6 of $val10

val11=$(tmp0)
val12=$[rint($val7*100)]
val13=$[rint(($val7-1)*100)]
val14=$[rint($val6*100)]
val15=$val14 %,$val6 %,$val12 %,$val13 %,$val7 %
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val8=$(tmp0)
choicename1=
choicegood1=$val11
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le bénéfice d'une petite entreprise a $val9 en $val7 ans.	Quel est le pourcentage d'augmentation du bénéfice sur cette période ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
