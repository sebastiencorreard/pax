!set title=Calcul de vitesse moyenne 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val6=$(tmp0)
tmp=!translate internal $	$ to ; in kilomètres,heures,km/h	  mètres,secondes,m/s

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 3 of $val7

val8=$(tmp0)
tmp0=!item 1 of $val7

val9=$(tmp0)
tmp0=!item 2 of $val7

val10=$(tmp0)
tmp0=!randint 10, 100

val11=$[rint($(tmp0))]
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
val8=km/h
tmp=!nonempty items 0.25,0.75,0.5

tmp0=!randitem $tmp
val13=$[$(tmp0)]
val14=$[$val12+$val13]
val15=$[rint($val13*60)]
val16=$[$val14*$val11]
val17=$val6 parcourt $val16 kilomètres en $val12 h $val15 min
val18=$[$val11]
replytype1=numexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val17.	<p>	  Quelle est sa vitesse moyenne durant ce trajet&nbsp;?	</p>	<label for="reply1"><b>Votre réponse :</b></label>  
!read oef/embed.phtml r1,5 
$() $val8.	<div class="wims_instruction">Donner l'arrondi entier si nécessaire.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,17
embedcnt=1
