!set title=Formule 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=conversion
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

tmp1=!randint 4, 11

tmp2=!randint 20, 80

tmp3=!randint 2, 9

tmp4=!randint 20, 40

tmp5=!randint 50, 200

tmp=!translate internal $	$ to ; in kilomètres,heures,km/h,$(tmp0),$(tmp1)*10	  mètres,secondes,m/s,$(tmp2),$(tmp3)	  mètres,minutes,m/min,$(tmp4),$(tmp5)

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp6=!translate internal $\
$ to ; in $tmp
val6=$(tmp6)
tmp0=!item 4 of $val6

val7=$(tmp0)
tmp0=!item 3 of $val6

val8=$(tmp0)
tmp0=!item 1 of $val6

val9=$(tmp0)
tmp0=!item 2 of $val6

val10=$(tmp0)
tmp0=!item 5 of $val6

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val7)]
val13=Combien de temps faut-il pour parcourir $val12 $val9 à la vitesse de $val11 $val8 &#63;
val14=$[$val7]
replytype1=numexp
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13	<div class="spacer">	<label for="reply1"><b>Votre réponse :</b></label>  
!read oef/embed.phtml r1,5 
$() $val10.</div>	$m_remarque
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,13
embedcnt=1
