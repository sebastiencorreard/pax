!set title=Calculer un pourcentage 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
keywords=percents, pbsolving
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp0=!randint 25, 35

val8=$[rint($(tmp0))]
tmp0=!randint 5, 20

val9=$[rint($(tmp0))]
val10=$[rint($val8-$val9)]
!if $val7=1 
val11=Dans une classe il y a $val8 élèves. $val10 sont des garçons.
val12=Quel est le pourcentage de garçons
val13=$[rint($val10/$val8*100)]
!else
val11=Dans une classe il y a $val8 élèves. $val9 sont des filles.
val12=Quel est le pourcentage de filles
val13=$[rint($val9/$val8*100)]
!endif
replytype1=numexp
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11<p>	$val12 ?	</p>	<label for="reply1"><b>Votre réponse</b></label> 
!read oef/embed.phtml r1,5 
$() %.	<div class="wims_instruction">Le résultat doit être arrondi à l'unité.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12
embedcnt=1
