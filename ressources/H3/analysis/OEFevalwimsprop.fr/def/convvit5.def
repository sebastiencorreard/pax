!set title=Conversion vitesse 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=conversion
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Convertir,en
val7=Votre réponse
tmp=!trim km/h,km/min,km/s,m/h,m/s,m/min
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)
val12=km/h,km/min,km/s,m/h,m/s,m/min
val13=3600,60,1,3600000,1000,60000
tmp0=!randint 100, 500

val14=$[$(tmp0)/100]
tmp0=!positionof item $val10 in $val12

val15=$[rint($(tmp0))]
tmp0=!positionof item $val11 in $val12

val16=$[rint($(tmp0))]
tmp0=!item $val15 of $val13

val17=$[$val14*$(tmp0)]
tmp0=!item $val16 of $val13

val18=$[$val14*$(tmp0)]
replytype1=numexp
replyname1=\($val17 $val10)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $(val6[1]) $val17 $val10 $(val6[2]) $val11.	<div class="spacer">	<b>$val7</b>:	<label for="reply1">$val17 $val10 =</label>  
!read oef/embed.phtml r1,9 
$() $val11.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11,17
embedcnt=1
