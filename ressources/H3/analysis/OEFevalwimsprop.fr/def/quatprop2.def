!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 11,12,13,14,15,16,17,18,19

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
val10=$[rint($val7*$val9)]
val11=$[rint($val8*$val9)]
replytype1=numexp
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

