$()	Compléter le tableau de proportionnalité suivant :	<table class="wimscenter wimsborder">	 <tr>	  <td>$val7</td>	  <td> 
!read oef/embed.phtml r1,5 
$()</td>	 </tr><tr>	  <td>$val8</td>	  <td>$val11</td>	 </tr>	 </table>
