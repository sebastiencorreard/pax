!set title=Calculer une quatrième proportionnelle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
keywords=proportionality

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 111, 999

val6=$[$(tmp0)/10]
tmp0=!randint 111, 999

val7=$[$(tmp0)/10]

!ifval $val6=$val7
tmp0=!randint 1, 5

val7=$[$val7+$(tmp0)]
!endif
tmp=!nonempty items 2,3,6,7

tmp0=!randitem $tmp
val8=$[$(tmp0)]
val9=$[$val6*$val8]
val10=$[$val7*$val8]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]

!ifval $val11=1
val12=$[$val9]
!else
val12=$[$val10]
!endif
replytype1=numexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

