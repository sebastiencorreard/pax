$()	Compléter l'égalité suivante :	<table class="wimscenter wimsnoborder">	 <tr>	  <td>
!if $val11=1 
$() 
!read oef/embed.phtml r1,5 
$() 
!else
$() $val9 
!endif
$()</td>	  <td></td>	  <td>$val6</td>	 </tr><tr>	  <td><hr></td>	  <td>=</td>	  <td><hr></td>	 </tr><tr>	  <td>
!if $val11=2 
$() 
!read oef/embed.phtml r1,5 
$() 
!else
$() $val10 
!endif
$()</td>	  <td></td>	  <td>$val7</td>	 </tr>	 </table>
$()
