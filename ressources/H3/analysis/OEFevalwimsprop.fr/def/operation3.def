!set title=Opération sur les pourcentages 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 35,40,45,55,60

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 15, 45

val7=$[rint($(tmp0))]
val8=$[rint($val6*$val7/100)]
tmp=!nonempty items boucles d'oreilles,lunettes,poupées

tmp0=!randitem $tmp
val9=$(tmp0)
replytype1=numexp
replyname1=réponse
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans une classe, $val6 % des élèves sont des filles. Parmi ces filles,	$val7 % ont des $val9 alors qu'aucun des garçons n'en a.	<p>	Quel pourcentage des enfants de la classe ont des $val9 ?	</p>	<b>Votre réponse :</b>  
!read oef/embed.phtml r1,5 
$() %<br>	<div class="wims_instruction">Le résultat doit être arrondi à l'unité.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9
embedcnt=1
