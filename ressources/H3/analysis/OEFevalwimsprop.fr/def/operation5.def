!set title=Opération sur les pourcentages 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randitem 2,3,4

val7=$[rint($(tmp0))]
tmp0=!randint 1, 4

val8=$[rint($(tmp0)*5)]
val9=$[rint($val7*$val8)]
val10=$[rint($val7+$val8)]
choicename1=réponse
choicegood1=$val8 %
choicebad1=$val9 %,$val7 %,$val10 %
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Pour peindre un mur, $val6 doit diluer sa peinture. Sur le pot d'un litre,	il est écrit : <i>Diluer avec $val8 % d'eau.</i>.	$val6 décide de préparer $val7 litres de peinture.<br>	Quel est le pourcentage d'eau dans le mélange obtenu ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=0
