!set title=Reconnaître la proportionnalité 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
keywords=proportionality
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Non,Oui
val7=Ce tableau est-il un tableau de proportionnalité&nbsp;
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
tmp0=!randint 2, 6

tmp1=!randint 12, 18

val9=$(tmp0),$(tmp1)
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
!if $val11=1 
tmp0=!shuffle 11,12,13,14,15,16,17,18,19

val12=$(tmp0)
tmp0=!item 1 to 3 of $val12

val12=$(tmp0)
!else
tmp0=!randint 11, 17

val12=$(tmp0)
val13=$[rint($val12+$(val9[1]))]
val14=$[rint($val12+$(val9[2]))]
val12=$val12,$val13,$val14
!endif
val15=
!if $val10=2 
!for val16 =1 to 3 
val17=$[rint($(val12[$val16])*$val8)]
tmp0=!append item $val17 to $val15

val15=$(tmp0)
!next
!else
!if $val11=1 
tmp0=!randint 20, 99

val18=$[rint($(tmp0))]
val13=$[rint($val18+$(val9[1]))]
val14=$[rint($val18+$(val9[2]))]
val15=$val18,$val13,$val14
!else
!for val16 =1 to 3 
val17=$[rint($(val12[$val16])+$(val9[1]))]
tmp0=!append item $val17 to $val15

val15=$(tmp0)
!next
!endif
!endif
tmp0=!item $val10 of $val6

val19=$(tmp0)
choicename1=
choicegood1=$val19
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

