!set title=Reconnaître la proportionnalité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Non,Oui
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val7=$(tmp0)
tmp=!nonempty items 0.65,0.70,0.75

tmp0=!randitem $tmp
val8=$[$(tmp0)]
tmp0=!randint 2, 6

val9=$[rint($(tmp0))]
tmp=!nonempty items 10,15,20

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp=!nonempty items 25,30,35,40

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp=!nonempty items 2,3,4

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
!if $val12=2 
val14=$[$val9*$val8]
val15=$[$val10*$val8]
val16=$[$val11*$val8]
!else
val14=$[$val9*$val8]
val15=$[($val10-$val13)*$val8]
val16=$[($val11-2*$val13)*$val8]
!endif
tmp0=!item $val12 of $val6

val17=$(tmp0)
choicename1=
choicegood1=$val17
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Sur la vitrine d'une boulangerie, $val7 voit affiché :	<table class="wimscenter wimsborder">	 <tr>	  <th>Nombre de pains</th>	  <td>1</td>	  <td>$val9</td>	  <td>$val10</td>	  <td>$val11</td>	 </tr>	 <tr>	  <th>Prix à payer (en euros)</th>	  <td>$val8</td>	  <td>$val14</td>	  <td>$val15</td>	  <td>$val16</td>	 </tr>	 </table>	Le prix à payer est-il proportionnel au nombre de pains achetés ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

