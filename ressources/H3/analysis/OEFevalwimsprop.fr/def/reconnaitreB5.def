$()	  </td><td>	   <img src="$(val22[2])" alt=""><br>	    
!read oef/embed.phtml r2,$val6 
$()	  </td>	 </tr><tr>	  <td>	   <img src="$(val22[3])" alt=""><br>	    
!read oef/embed.phtml r3,$val6 
$()	  </td><td>	   <img src="$(val22[4])" alt=""><br>	    
!read oef/embed.phtml r4,$val6 
$()	  </td>	 </tr>	</table>
$()
!exit

