!set title=Reconnaître la proportionnalité B5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=120x60x1
tmp0=!values v for v=1 to 4

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp=!nonempty items 2,-2,3,-3

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 1,2,0.5,0.3,0.7

tmp0=!randitem $tmp
val9=$[$(tmp0)]
tmp=!trim $(val7[1])/10*x^2,2	$val9*x,1	$(val7[3])*x+$val8,2	2*x-$(val7[4])+abs(x-$(val7[4])),2
val10=!translate internal $	\
$ to ;; in $tmp
val11=Situation de proportionnalité,Pas de proportionnalité
tmp0=!shuffle 1,2,3,4

val12=$(tmp0)
!readproc slib/draw/repere 240,240,20,0,10,0,10,1,1,black,grey 
tmp0=$slib_out
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val17=$(tmp0)
tmp0=!item 2 of $val14

val18=$(tmp0)
tmp0=!line 3 to -1 of $val13

val13=$(tmp0)
val19=!rawmath (x-($val15))/$val17
val20=!rawmath x*($val18)+($val16)
val21=
val22=
!for val23 =1 to 4 
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val12[$val23]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
tmp0=!item 1 of $val24

val25=!rawmath $(tmp0)
tmp0=!item 2 of $val24

val26=$(tmp0)
tmp0=!item $val26 of $val11

val26=$(tmp0)
tmp0=!append item $val26 to $val21

val21=$(tmp0)
evaltmp=$val25

evaltmp=!mathsubst x=($val19) in $evaltmp
tmp0=($evaltmp)
evaltmp=$val20

evaltmp=!mathsubst x=($(tmp0)) in $evaltmp
tmp1=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp1)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
val27=!rawmath $(tmp2)
val28=
!for val29 =1 to 8 
evaltmp=$val25

evaltmp=!mathsubst x=($val29) in $evaltmp
tmp0=($evaltmp)
val30=$[$(tmp0)]
tmp0=!append item $val30 to \test

val31=$(tmp0)
val30=point $val29,$val30,red
tmp0=!append line $val30 to $val28

val28=$(tmp0)
!next
!readproc oef/draw.phtml 240,240 \
$val13	range -1,11,-1,11	linewidth 5	$val28 
tmp0=$ins_url
val14=$(tmp0)
tmp0=!append item $val14 to $val22

val22=$(tmp0)
!next
replytype1=clickfill
replyname1=Graphique 1
replygood1=$(val21[1]);$val11
replytype2=clickfill
replyname2=Graphique 2
replygood2=$(val21[2]);$val11
replytype3=clickfill
replyname3=Graphique 3
replygood3=$(val21[3]);$val11
replytype4=clickfill
replyname4=Graphique 4
replygood4=$(val21[4]);$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Parmi les graphiques suivants indiquer, en utilisant les étiquettes,	ceux qui correspondent à des situations de proportionnalité.	<table class="wimscenter wimsnoborder">	 <tr>	  <td>	   <img src="$(val22[1])" alt=""><br>	    
