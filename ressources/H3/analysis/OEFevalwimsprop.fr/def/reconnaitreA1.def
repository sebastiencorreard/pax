!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Non,Oui
val7=Ce tableau est-il un tableau de proportionnalité&nbsp;
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
tmp0=!shuffle 11,12,13,14,15,16,17,18,19

val9=$(tmp0)
tmp0=!item 1 to 3 of $val9

val9=$(tmp0)
val10=
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!for val13 =1 to 3 

!ifval $val12=1 and $val13=3
val14=$[rint($(val9[$val13])*$val8+$val11)]
!else
val14=$[rint($(val9[$val13])*$val8)]
!endif
tmp0=!append item $val14 to $val10

val10=$(tmp0)
!next
tmp0=!item $val12 of $val6

val15=$(tmp0)
choicename1=
choicegood1=$val15
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

