!set title=Problème de proportionnalité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=pbsolving, proportionality
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000000

ansorder=r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 100

val6=$[rint($(tmp0))]
val6=$[$val6/10]
tmp=!nonempty items jambon,pommes,poires,pêches,pâtes,carottes

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!randint 11, 50

val8=$[rint($(tmp0))]
val8=$[$val8/10]
tmp0=!randint 1, 5000

val9=$[rint($(tmp0))]
val9=$[$val9/100]
val10=x*$val6
val11=$[$val6*$val8]
val12=$[rint($val6*$val8*100)]
val12=$[$val12/100]
val13=$[$val9/$val6]
val14=$[rint($val9/$val6*1000)]
val14=$[$val14/1000]
replytype1=algexp
replyname1=\(P(x)\)
replygood1=$val10
replytype2=auto

replyname2=prix
replygood2=$val12
replytype3=units
replyname3=poids
replygood3=$val14 kg
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Un kilogramme de $val7 coûte $val6 euros.	<ol>	 <li>Exprimer en fonction du poids x de $val7 le prix 
!insmath P
$() en euros à payer.</li>	 <li>Combien coûtent $val8 kg de $val7 ?	 <div class="wims_instruction">Donner votre résultat au centime près.</div></li>	 <li>Quel poids de $val7 peut-on acheter avec $val9 euros ?	 <div class="wims_instruction">Donner le résultat au gramme près et préciser l'unité.</div>	 </li>	</ol>		<div class="spacer"><b>Vos réponses</b> :	<ol>	 <li>
!insmath P(x)
$() =  
!read oef/embed.phtml r1,8 
$().</li>	 <li>$val8 kg de $val7 coûtent  
!read oef/embed.phtml r2,8 
$() euros.</li>	 <li>On peut acheter  
!read oef/embed.phtml r3,8 
$() de $val7.</li>	</ol></div>	
$()
!exit

