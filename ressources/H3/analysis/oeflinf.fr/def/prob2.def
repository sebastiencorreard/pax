!endif

tmp0=!randint 1, 50

val6=$[rint($(tmp0))]
val7=$[(1-$val6/100)]
tmp0=!randint 1, 5000

val8=$[rint($(tmp0))]
val8=$[$val8/100]
tmp0=!randint 1, 5000

val9=$[rint($(tmp0))]
val9=$[$val9/100]
val10=$[$val8*$val7]
val11=$[rint($val8*$val7*100)]
val11=$[$val11/100]
val12=$[$val9/$val7]
val13=$[rint($val9/$val7*100)]
val13=$[$val13/100]
val7=$val7*x
replytype1=algexp
