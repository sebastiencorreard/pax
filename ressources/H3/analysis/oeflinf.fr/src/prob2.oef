\title{Problème de proportionnalité 2}
\language{fr}
\range{-5..5}
\keywords{pbsolving}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{pour=random(1..50)}
\real{rep1=(1-\pour/100)}
\integer{p1=random(1..5000)}
\real{p1=\p1/100}
\integer{p2=random(1..5000)}
\real{p2=\p2/100}
\real{test2=\p1*\rep1}
\integer{rep2=\p1*\rep1*100}
\real{rep2=\rep2/100}
\real{test3=\p2/\rep1}
\integer{rep3=\p2/\rep1*100}
\real{rep3=\rep3/100}
\text{rep1=\rep1*x}

\statement{
Un magasin offre une réduction de \pour % sur tous ses articles.
Le prix réduit \(P\) est proportionnel au prix initial \(x\).
<ol>
 <li>Exprimer \(P\) comme une fonction linéaire de \(x\).</li>
 <li>Combien coûte, au centime près, un article dont le prix initial est de \p1 euros ?</li>
 <li>Un article du magasin coûte \p2 euros, quel était son prix initial au centime près ?</li>
</ol>
<div><b>Vos réponses :</b>
<ol>
 <li>\(P(x)\) = \embed{r1,8}.</li>
 <li>Cet article coûte \embed{r2,8} euros.</li>
 <li>Son prix initial était de \embed{r3,8} euros.</li>
</ol>
</div>
<div class="wims_instruction">Simplifier tous les calculs et ne pas utiliser
d'écriture fractionnaire.</div>}

\answer{\(P(x)\)}{\rep1}{type=algexp}
\answer{prix}{\rep2}{type=numexp}
\answer{poids}{\rep3}{type=numexp}
