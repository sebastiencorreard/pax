!! fichier d'affichage des étapes de calculs
!if $algo=division
 <table>
 !for i=1 to $nbetape
 <tr><td>
 \($(AA$[$i])=$(QQ$[$i])\times $(BB$[$i]) + $(RR$[$i]))
 </td></tr>
 !next i
 </table>
!exit
!endif

!if $algo=soustraction
 <table>
 !for i=1 to $nbetape
 <tr><td>
 \($(AA$[$i]) - $(BB$[$i]) = $(RR$[$i]))
 </td></tr>
 !next i
 </table>
!exit
!endif