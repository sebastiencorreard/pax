tmp0=!randint 10, 25

val6=$[rint($(tmp0))]
tmp0=!randint 4, 8

val7=$[rint($(tmp0))]
tmp0=!randint 5, 10

val8=$[rint($(tmp0))]
tmp0=!randint 5, 7

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd(gcd($val7,$val8),$val9);
tmp0=!exec maxima $t_

val10=$[rint($(tmp0))]
