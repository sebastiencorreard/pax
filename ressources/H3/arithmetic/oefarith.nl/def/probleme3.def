!endif
val11=$[rint($val6*$val7)]
val12=$[rint($val6*$val8)]
val13=$[rint($val6*$val9)]
t_=!replace internal \( by ( in gcd($val11,$val12);
tmp0=!exec maxima $t_

val14=$[rint($(tmp0))]
val15=$[rint($val7*$val8*$val9)]
