val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 50

val6=$[rint($(tmp0))]
tmp0=!randint 25, 100

val7=$[rint($(tmp0))]
tmp0=!randint 25, 100

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val7,$val8);
tmp0=!exec maxima $t_

val9=$[rint($(tmp0))]
val7=$[rint($val7/$val9)]
val8=$[rint($val8/$val9)]
!if $val7=$val8 
val7=$[rint(37)]
val8=$[rint(17)]
!endif
val10=$[rint($val6*$val7)]
val11=$[rint($val6*$val8)]
val12=$[$val6*$val7/100]
val13=$[$val6*$val8/100]
val14=$[rint($val7*$val8)]
replytype1=units
replyname1=Lengte van een zijde van een tegel
replygood1=$val6 cm
replytype2=numeric
replyname2=Aantal tegels
replygood2=$[$val14]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Men wil een pakhuis met lengte $val12 meter en breedte $val13 meter zonder 	te snijden betegelen met vierkante tegels waarvan de zijde een geheel aantal 	centimeters is. Verder wil men zo weinig mogelijk tegels gebruiken. 	<blockquote>	<p>Vraag 1 : Wat is de lengte van de zijde van een tegel?</p>	<p>Vraag 2 : Hoeveel tegels zijn er nodig?</p>	</blockquote>
$()
!exit

:hint
$()Schrijf de afmetingen van het pakhuis in centimeters.  	Merk daarna op dat de afmeting van een tegel een deler van de lengte 	en van de breedte van het pakhuis moet zijn.
$()
!exit

:help
$()
$()
!exit

:solution
$()Het pakhuis is $val12 m oftewel $val10 cm lang en $val13 m oftewel $val11 cm	breed. De lengte van de zijde van een tegel is de ggd van $val10 en $val11. 	Dat is $val6. De lengte van een zijde van een tegel is dus $val6 cm.<p>	Het aantal tegels dat nodig is is 
!insmath \frac{$val10}{$val6}\times \frac{$val11}{$val6}
$() 	oftewel $val14 tegels.
$()
!exit

:feedback

!exit

:test

!exit

:stat
