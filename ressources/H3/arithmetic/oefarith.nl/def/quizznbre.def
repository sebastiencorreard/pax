!set title=Getallen quiz
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fguerima@tele2.fr
computeanswer=no
precision=10000

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,7,5,8,27

val6=$(tmp0)
tmp0=!randint 1, 1000

val7=$[rint($(tmp0))]
val8=$[$val7/100]
tmp0=!randint 1, 10000

val7=$[rint($(tmp0))]
val9=$[$val7/1000]
tmp0=!randitem -,

val10=$(tmp0)
tmp=!trim \(\pi),0,0,0,1	\($val10\sqrt{$val6}),0,0,0,1	\($val10\frac{2}{3}),1,0,0,0	\($val10\frac{4}{7}),1,0,0,0	\($val10\frac{$val6}{2}),1,1,0,0	\($val10\frac{$val6}{4}),1,1,0,0	\($val10 $val9),1,1,0,0	\($val10 $val8),1,1,0,0	\($val10 $val6),1,1,1,0 
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!random 1, 9

tmp=!translate internal $	$ to ; in $val11

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val12=$(tmp1)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
val15=rationaal, decimaal, geheel, irrationaal
tmp0=!item $val14 of $val15

val15=$(tmp0)
val16=Nee, Ja
tmp0=!item $val14+1 of $val12

tmp1=!item $(tmp0)+1 of $val16

val17=$(tmp1)
choicename1=Antwoord
choicegood1=$val17
choicebad1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Is $val13 $val15 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,15
embedcnt=0
