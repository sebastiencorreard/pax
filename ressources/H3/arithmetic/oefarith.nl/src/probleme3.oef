\title{Kist}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(10..25)}
\integer{b=random(4..8)}
\integer{c=random(5..10)}
\integer{d=random(5..7)}
\integer{g=maxima(gcd(gcd(\b,\c),\d);)}
\integer{b=\b/\g}
\integer{c=\c/\g}
\integer{d=\d/\g}
\if{\b=\c or \c=\d or \b=\d}{
\integer{b=7}
\integer{c=9}
\integer{d=5}}
\integer{A=\a*\b}
\integer{B=\a*\c}
\integer{C=\a*\d}
\integer{g0=maxima(gcd(\A,\B);)}
\integer{rep=\b*\c*\d}

\statement{Een rechthoekige kist wordt gevuld met identieke kubussen. 
De zijde van zo'n kubus is een geheel aantal centimeters. De kubussen 
moeten de kist geheel vullen en zo groot mogelijk zijn. <br>
De afmetingen van de kist zijn  \A cm, \B cm en \C cm.
<blockquote>
<p>Vraag 1 : Wat is de lengte van de zijden van de kubussen?</p>
<p>Vraag 2 : Hoeveel kubussen kunnen in de kist?</p>
</blockquote>}

\solution{<u>Vraag 1 :</u><br>De kubussen moeten de kist geheel vullen en 
zijden van een 
geheel aantal centimeters hebben. De lengte van een zijde van de kubus moet 
dus een deler zijn van de afmetingen van de kubus, dwz van  \A, \B en \C.<br>
Als de kubussen ook nog zo groot mogelijk moeten zijn,  moet de lengte 
van de zijden de ggd van de drie getallen zijn.<br>
Met het algoritme van Euclides berekent men eerst de ggd van \A en \B. 
Die is \g0.<br>
Nogmaals met het algoritme van Euclides berekent men de ggd van \C en \g0. Die 
is \a.<br>
De ggd van \A,  \B en \C is dus \a.<br>
<u>Vraag 2 :</u><br>
Het aantal kubussen dat nodig is om de kist te vullen is:<br>
\(\frac{\A}{\a}\times \frac{\B}{\a}\times \frac{\C}{\a}) oftewel \rep kubussen.}
\answer{Lengte van de zijden}{\a cm}{type=units}
\answer{Aantal kubussen}{\rep}{type=numeric}
