\title{Pakhuis}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(10..50)}
\integer{b=random(25..100)}
\integer{c=random(25..100)}
\integer{g=maxima(gcd(\b,\c);)}
\integer{b=\b/\g}
\integer{c=\c/\g}
\if{\b=\c}{
\integer{b=37}
\integer{c=17}}
\integer{Ac=\a*\b}
\integer{Bc=\a*\c}
\real{A=\a*\b/100}
\real{B=\a*\c/100}
\integer{rep=\b*\c}

\statement{Men wil een pakhuis met lengte \A meter en breedte \B meter zonder 
te snijden betegelen met vierkante tegels waarvan de zijde een geheel aantal 
centimeters is. Verder wil men zo weinig mogelijk tegels gebruiken. 
<blockquote>
<p>Vraag 1 : Wat is de lengte van de zijde van een tegel?</p>
<p>Vraag 2 : Hoeveel tegels zijn er nodig?</p>
</blockquote>}

\hint{Schrijf de afmetingen van het pakhuis in centimeters.  
Merk daarna op dat de afmeting van een tegel een deler van de lengte 
en van de breedte van het pakhuis moet zijn.}

\solution {Het pakhuis is \A m oftewel \Ac cm lang en \B m oftewel \Bc cm
breed. De lengte van de zijde van een tegel is de ggd van \Ac en \Bc. 
Dat is \a. De lengte van een zijde van een tegel is dus \a cm.<p>
Het aantal tegels dat nodig is is \(\frac{\Ac}{\a}\times \frac{\Bc}{\a}) 
oftewel \rep tegels.}
\answer{Lengte van een zijde van een tegel}{\a cm}{type=units}
\answer{Aantal tegels}{\rep}{type=numeric}
