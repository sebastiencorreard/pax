\title{Getallen quiz}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\text{n=random(2,3,7,5,8,27)}
\integer{tmp=random(1..1000)}
\real{m=\tmp/100}
\integer{tmp=random(1..10000)}
\real{p=\tmp/1000}
\text{sg=random(-,)}
\matrix{don=\(\pi),0,0,0,1
\(\sg\sqrt{\n}),0,0,0,1
\(\sg\frac{2}{3}),1,0,0,0
\(\sg\frac{4}{7}),1,0,0,0
\(\sg\frac{\n}{2}),1,1,0,0
\(\sg\frac{\n}{4}),1,1,0,0
\(\sg \p),1,1,0,0
\(\sg \m),1,1,0,0
\(\sg \n),1,1,1,0 }
\text{list=row(random(1..9),\don)}
\text{enonce=item(1,\list)}
\integer{typeno=random(1..4)}
\text{lttype=rationaal, decimaal, geheel, irrationaal}
\text{lttype=item(\typeno,\lttype)}
\text{bad=Nee, Ja}
\text{good=item(item(\typeno+1,\list)+1,\bad)}
\statement{Is \enonce \lttype ?}



\choice{Antwoord}{\good}{\bad}
