\title{Dozen}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(5..25)}
\integer{b=random(15..100)}
\integer{c=random(15..100)}
\integer{g=maxima(gcd(\b,\c);)}
\integer{b=\b/\g}
\integer{c=\c/\g}
\if{\b=\c}{
\integer{b=37}
\integer{c=17}}
\integer{A=\a*\b}
\integer{B=\a*\c}
\text{nom=potloden, ballonnen, glazen, pennen, stiften}
\text{nom=randitem(\nom)}
\text{coul1=blauwe,groene,zwarte,witte,gele} 
\text{coul1=shuffle(\coul1)}
\text{coul2=item(1,\coul1)}
\text{coul1=item(2,\coul1)}
\integer{rep1=\A/\a}
\integer{rep2=\B/\a}
\integer{rep=\rep1+\rep2}

\statement{We zoeken \A \coul1 \nom en \B \coul2 \nom bij elkaar in dozen 
zodat alle \nom in een doos van dezelfde kleur zijn en alle dozen
evenveel \nom bevatten. Verder moeten de dozen zoveel mogelijk \nom bevatten. 
<blockquote>
<p>Vraag 1 : Hoeveel \nom moeten er in een doos?</p>
<p>Vraag 2 : Hoeveel dozen zijn er nodig?</p>
</blockquote>}

\hint{Het aantal \nom per doos moet een deler zijn van het aantal \coul1 \nom 
en van het aantal \coul2 \nom}

\solution {Het aantal \nom per doos moet een deler zijn van het aantal 
\coul1 \nom en van het aantal \coul2 \nom. Bereken dus de ggd van \A en \B. 
Dit geeft \a.<p>
Het aantal \nom per doos is dus \a. Het aantal dozen 
met \coul1 \nom is \(\frac{\A}{\a}) oftewel \rep1 dozen. Net zo is het aantal 
dozen met \coul2 \nom gelijk aan \(\frac{\B}{\a}) oftewel \rep2 dozen.<p>
Het totaal aantal dozen is dus \rep .}
\answer{Aantal \nom per doos}{\a}{type=default}
\answer{Aantal dozen}{\rep}{type=default}
