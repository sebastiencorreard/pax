\title{Breuken vereenvoudigen}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..50)}
\integer{b=random(10..35)}
\integer{c=random(10..35)}
\integer{c=\c=\b?36}
\integer{A=\a*\b}
\integer{B=\a*\c}
\integer{p=maxima(GCD(\A,\B);)}
\integer{Ar=\A/\p}
\integer{Br=\B/\p}

\statement{Wat is de vereenvoudigde schrijfwijze van de breuk \(\frac{\A}{\B})?
<p>
Antwoord: 
<table>
 <tr>
    <td align=center>\(\A)</td>
    <td></td>
    <td align=center>\embed{reply 1,3}</td>
 </tr>
 <tr>
    <td><hr></td>
    <td align=center>=</td>
    <td><hr></td>
 </tr>
 <tr>
    <td align=center>\(\B)</td>
    <td></td>
    <td align=center>\embed{reply 2,3}</td>
 </tr>
</table>}

\hint{Bereken de ggd van \A en \B.}
\answer{Teller}{\Ar}{type=numeric}
\answer{Noemer}{\Br}{type=numeric}
