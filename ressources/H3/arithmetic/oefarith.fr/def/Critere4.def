!set title=Critères de divisibilité 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude,David
email=mcld@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=5
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 500

val6=$[rint($(tmp0))]
tmp0=!randint 1, 50

val7=$[rint(3*$(tmp0))]
tmp0=!randint 1, 50

val8=$[rint(3*$(tmp0)+1)]
tmp0=!randint 1, 50

val9=$[rint(3*$(tmp0)+2)]
tmp0=!randint 1, 50

val10=$[rint(9*$(tmp0))]
tmp0=!randint 1, 50

val11=$[rint(9*$(tmp0)+1)]
tmp0=!randint 1, 50

val12=$[rint(9*$(tmp0)+2)]
tmp0=!randint 1, 50

val13=$[rint($(tmp0))]
tmp=!nonempty items 1,3,5,7,9

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
tmp=!nonempty items 1,3,7,9

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
tmp=!nonempty items 0,2,4,6,8

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
tmp0=!randitem 0,5

val17=$[rint($(tmp0))]
tmp=!trim 2,$val6,,2,4,6,8,10	2,$val6,$val16,12	2,$val6,$val14,11	5,$val6,$val15,11	5,$val6,$val17,12	5,$val6,,5,10	10,$val6,0,12	10,$val6,,10	10,$val6,$val14,11	3,$val7,,3,6,9,10	3,$val8,,2,5,8	3,$val9,,1,4,7	9,$val10,,9,10	9,$val11,,8	9,$val12,,7
val18=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val18

tmp0=!rowcnt $tmp
val19=$[rint($(tmp0))]
tmp0=!randint 1, $val19

val20=$[rint($(tmp0))]
val21=$(val18[$val20;2])c$(val18[$val20;3])
val22=1,2,3,4,5,6,7,8,9,0,aucune valeur,toutes les valeurs
replytype1=checkbox
replyname1=Valeurs de c
replygood1=$(val18[$val20;4..-1]);$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Cocher toutes les valeurs du chiffre 
!insmath c
$() qui permettent 	au nombre $val21 d'être divisible par 
!insmath $(val18[$val20;1])
$() : </div>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$().</div>	<div class="wims_instruction">Si toutes les valeurs conviennent, cocher "toutes les valeurs".</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $(val18[$val20;1])=2
 <div class='oef_feedbacks'><p class="wims_emph">Un nombre est divisible par 2 quand son chiffre des unités est 0&#44	 2&#44	 4&#44	 6 ou 8.</p>
$()</div>
!endif
!ifval $(val18[$val20;1])=5
 <div class='oef_feedbacks'><p class="wims_emph">Un nombre est divisible par 5 quand son chiffre des unités est 0 ou 5.</p>
$()</div>
!endif
!ifval $(val18[$val20;1])=10
 <div class='oef_feedbacks'><p class="wims_emph">Un nombre est divisible par 10 quand son chiffre des unités est 0.</p>
$()</div>
!endif
!ifval $(val18[$val20:1])=3
 <div class='oef_feedbacks'><p class="wims_emph">Un nombre est divisible par 3 quand la somme de ses chiffres est divisible par 3.</p>
$()</div>
!endif
!ifval $(val18[$val20;1])=9
 <div class='oef_feedbacks'><p class="wims_emph">Un nombre est divisible par 9 quand la somme de ses chiffres est divisible par 9.</p>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=18,20,21
embedcnt=1
