!set title=Division euclidienne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude,David;Cécile,Jézéquel
email=mcld@math.u-psud.fr,Cecile.Jezequel1@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=6
prevarcnt=4
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 80

val6=$[rint($(tmp0))]
tmp0=!randint 2, 50

val7=$[rint($(tmp0))]
tmp0=!randint 0, $val6-1

val8=$[rint($(tmp0))]
val9=$[rint($val6*$val7+$val8)]
replytype1=algexp
replyname1=
replygood1=$val7
replytype2=algexp
replyname2=
replygood2=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compléter la division euclidienne de 
!insmath $val9
$() par 
!insmath $val6
$() :	<div class="wimscenter">	<label for="reply1">
!insmath $val9 = $val6 \times
$()</label>  
!read oef/embed.phtml reply1,3 
$() <label for="reply2">+</label>  
!read oef/embed.phtml reply2,3 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val10=$[rint($val6*$m_reply1+$m_reply2)]

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>La division euclidienne de 
!insmath $val9
$() par 
!insmath $val6
$() s'écrit :	<p class="wimscenter">	
!insmath $val9 = $val6 \times $val7 + $val8
$()</p>
$()</div>
!endif
!ifval $val10 <>$val9
 <div class='oef_feedbacks'>Le nombre 
!insmath $val9
$() n'est pas égal à 
!insmath $val6 \times $m_reply1 + $m_reply2
$(). 
$()</div>
!endif
!ifval $m_reply2 >=$val6
 <div class='oef_feedbacks'>Votre reste est supérieur ou égal au diviseur.
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=2
