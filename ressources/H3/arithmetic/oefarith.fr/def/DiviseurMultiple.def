!set title=Diviseur/multiple
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David; Cécile, Jézéquel
email=mcld@math.u-psud.fr,Cecile.Jezequel1@ac-versailles.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 80

val6=$[rint($(tmp0))]
tmp0=!randint 2, 50

val7=$[rint($(tmp0))]
val8=diviseur,multiple
val9=$[rint(0)]
val10=$[rint($val6*$val7+$val9)]
tmp0=!randitem $val6,$val7\

val11=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]

!ifval $val12=1
val13= \($val10\)
!else
val13=\($val11\)
!endif

!ifval $val12=1
val14= \($val11\)
!else
val14=\($val10\)
!endif

!ifval $val12=1
val9= r1
!else
val9=r2
!endif

!ifval $val12=1
val15= r2
!else
val15=r1
!endif
replytype1=menu
replyoption1=shuffle 
replyname1=
replygood1=2;$val8
replytype2=menu
replyoption2=shuffle 
replyname2=
replygood2=1;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p class="wims_question">Connaissant l'égalité 
!insmath $val10 = $val6 \times $val7
$(), compléter les propositions suivantes :</p>	<div>	<ul><li>Le nombre $val13 est un  
!read oef/embed.phtml $val9 
$() de $val14.</li>	<li>Le nombre $val14 est un  
!read oef/embed.phtml $val15 
$() de $val13.</li></ul></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10,13,14,15
embedcnt=2
