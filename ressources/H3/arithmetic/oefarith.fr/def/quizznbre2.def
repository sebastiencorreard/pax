!set title=Quizz nombres 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,7,5,8,27

val6=$(tmp0)
tmp0=!randint 1, 1000

val7=$[rint($(tmp0))]
val8=$[$val7/100]

!ifval . notin $val8
val8=$[$val8+0.01]
!endif
tmp0=!randint 1, 10000

val7=$[rint($(tmp0))]
val9=$[$val7/1000]

!ifval . notin $val9
val9=$[$val9+0.001]
!endif
tmp0=!randitem -,

val10=$(tmp0)
tmp0=!values 2*v+1 for v=0 to 5

val11=$(tmp0)
tmp=!nonempty items $val11

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp=!trim \(\pi),0,0,0,1	\($val10\sqrt{$val6}),0,0,0,1	\($val10\frac{2}{3}),1,0,0,0	\($val10\frac{4}{7}),1,0,0,0	\($val10\frac{$val11}{2}),1,1,0,0	\($val10\frac{$val11}{4}),1,1,0,0	\($val10 $val9),1,1,0,0	\($val10 $val8),1,1,0,0	\($val10 $val6),1,1,1,0 
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!random 1, 9

tmp=!translate internal $	$ to ; in $val12

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val13=$(tmp1)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!randint 1, 4

val15=$[rint($(tmp0))]
val16=rationnel,décimal,entier,irrationnel
tmp0=!positionof item 1 in $(val13[2 to -1])

val17=$(tmp0)
replytype1=checkbox
replyname1=réponse
replygood1=$val17;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()A quel(s) ensemble(s) de nombres appartient le nombre $val14 ?	<table>	 
!for m_k=1 to 4 
$()<tr><td> 
!read oef/embed.phtml r1,\k 
$()</td></tr> 
!next
$()	</table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14
embedcnt=1
