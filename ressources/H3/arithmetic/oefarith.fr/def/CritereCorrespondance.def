!set title=Critères de divisibilité 0
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude,David; Cécile,Jézéquel
email=mcld@math.u-psud.fr,Cecile.Jezequel1@ac-versailles.fr
computeanswer=no
precision=100

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]

!ifval $val6=1
val7= divisible par 
!else
val7=multiple de 
!endif
tmp=!trim N est divisible par 2,  le chiffre des unités de N est 0&#44	 2&#44	 4&#44	 6 ou 8	N est divisible par 5, le chiffre des unités de N est 0 ou 5	N est divisible par 10, le chiffre des unités de N est 0	N est divisible par 3, la somme des chiffres de N est $val7 3	N est divisible par 9, la somme des chiffres de N est $val7 9
val8=!translate internal $	\
$ to ;; in $tmp
replytype1=correspond
replyname1=
replygood1=$(val8[;1]);$(val8[;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

