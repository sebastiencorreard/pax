val6=$[rint($(tmp0))]
tmp0=!randint 4, 15

val7=$[rint($(tmp0))]
tmp0=!randint 5, 15

val8=$[rint($(tmp0))]
tmp0=!randint 5, 15

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd(gcd($val7,$val8),$val9)	
