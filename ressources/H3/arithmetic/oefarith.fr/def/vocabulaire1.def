!set title=Vocabulaire multiplication
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim double,2*x,le	  triple,3*x,le	  moitié,x/2,la	  tiers,x/3,le	  quart,x/4,le	  deux-tiers,2*x/3,les	  trois-quarts,3*x/4,les
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 3, 25

val7=$[rint(4*3*$(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=!rawmath $(tmp0)
tmp0=!item 3 of $val8

val11=$(tmp0)

!ifval les isin $val11
val12=Quels sont
!else
val12=Quel est
!endif

!ifval la isin $val11
val12=Quelle est
!endif
evaltmp=$val10

evaltmp=!mathsubst x=($val7) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
replytype1=numexp
replyname1=réponse
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12 $val11 $val9 de $val7 ?	<div>	<b><label for="reply1">Votre réponse :</label></b>  
!read oef/embed.phtml r1,6 
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11,12
embedcnt=1
