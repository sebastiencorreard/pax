!set title=Trouver un diviseur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=16
prevarcnt=13
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(4)]
tmp0=!randint 0, 2

val7=$[rint($(tmp0))]
val6=$[rint($val6-$val7)]
tmp0=!randint 0, $val6

val8=$[rint($(tmp0))]
val6=$[rint($val6-$val8)]
tmp0=!randint 0, $val6

val9=$[rint($(tmp0))]
val6=$[rint($val6-$val9)]
tmp0=!randint 0, $val6

val10=$[rint($(tmp0))]
val6=$[rint($val6-$val10)]
tmp0=!randint 0, $val6

val11=$[rint($(tmp0))]
val6=$[rint($val6-$val11)]
!if $val7+$val8+$val9+$val10+$val11<=1 
val10=$[rint($val10+1)]
!endif
val12=$[rint(2^$val7*3^$val8*5^$val9*7^$val10*11^$val11)]
replytype1=auto

replyname1=Réponse
replygood1=?analyze 13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Écrire un diviseur de 
!insmath $val12
$() différent de 1 et de lui-même.	<div class="spacer">	<b><label for="reply1">Votre réponse :</label></b>	 
!read oef/embed.phtml r1,7 
$() est un diviseur de 
!insmath $val12
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val14=$[rint($val12/$val13)]
val15=$[rint($val13/$val12)]

!exit

:feedback
!ifval $val15*$val12=$val13 and $val13!=1 and $val13!=$val12
 <div class='oef_feedbacks'>Tu as écrit un multiple.
$()</div>
!endif
!ifval $val13=1 or $val13=$val12
 <div class='oef_feedbacks'>On demande un diviseur différent de 1 et de $val12.
$()</div>
!endif

!exit

:test

!ifval $val14*$val13=$val12 and $val13!=1 and $val13!=$val12 and $val14!=NaN
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val13 est un diviseur de \($val12\) différent de 1 et de \($val12\) ?

!exit

:stat
vsavelist=12,13
embedcnt=1
