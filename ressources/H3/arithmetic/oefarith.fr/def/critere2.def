!set title=Critères de divisibilité 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,3,5,9,10

tmp0=!randitem $tmp
tmp=!nonempty items 1,2,3,5,9,10

tmp1=!randitem $tmp
tmp=!nonempty items 2,3,5,10

tmp2=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1)*$(tmp2))]
val7=Utiliser les critères de divisibilité.
tmp0=!randint 10, 35

val8=$[rint($(tmp0))]
tmp0=!randint 10, 35

val9=$[rint($(tmp0))]

!ifval $val9=$val8
val9=$[rint(36)]
!endif
t_=!replace internal \( by ( in GCD($val8,$val9);
tmp0=!exec maxima $t_

val10=$[rint($(tmp0))]
val8=$[rint($val8/$val10)]
val9=$[rint($val9/$val10)]
!if $val9=1 
val8=$[rint(2)]
val9=$[rint(3)]
!endif
val11=$[rint($val6*$val8)]
val12=$[rint($val6*$val9)]
t_=!replace internal \( by ( in GCD($val11,$val12);
tmp0=!exec maxima $t_

val13=$[rint($(tmp0))]
val14=$[rint($val11/$val13)]
val15=$[rint($val12/$val13)]
replytype1=numexp
replyname1=numérateur
replygood1=$val14
replytype2=numexp
replyname2=dénominateur
replygood2=$val15
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Une fraction est dite irréductible lorsque elle est simplifiée au maximum, c'est-à-dire lorsque le seul diviseur commun à son numérateur et son dénominateur est 1.


!goto stat

!exit

:question
$()	  Quelle est l'écriture irréductible de la fraction 
!insmath \frac{$val11}{$val12}
$() ?	
!if $val7!= 
$()	<div class="wims_instruction">$val7</div>	 
!else
$() 	<br> 
!endif
$()	<b>Votre réponse :</b>	<table class="wimscenter">	 <tr>	    <td>
!insmath $val11
$()</td>	    <td></td>	    <td> 
!read oef/embed.phtml reply 1,3 
$()</td>	 </tr>	 <tr>	    <td><hr></td>	    <td>=</td>	    <td><hr></td>	 </tr>	 <tr>	    <td>
!insmath $val12
$()</td>	    <td></td>	    <td> 
!read oef/embed.phtml reply 2,3 
$()</td>	 </tr>	</table>	
$()
!exit

:hint
$()Une fraction est dite irréductible lorsque elle est simplifiée au maximum, c'est-à-dire lorsque le seul diviseur commun à son numérateur et son dénominateur est 1.
$()
