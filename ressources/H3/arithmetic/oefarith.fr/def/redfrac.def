!set title=Réduction fractions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 50

val6=$[rint($(tmp0))]
tmp0=!randint 10, 35

val7=$[rint($(tmp0))]
tmp0=!randint 10, 35

val8=$[rint($(tmp0))]

!ifval $val8=$val7
val8=$[rint(36)]
!endif
val9=$[rint($val6*$val7)]
val10=$[rint($val6*$val8)]
t_=!replace internal \( by ( in GCD($val9,$val10);
tmp0=!exec maxima $t_

val11=$[rint($(tmp0))]
val12=$[rint($val9/$val11)]
val13=$[rint($val10/$val11)]
replytype1=numexp
replyname1=numérateur
replygood1=$val12
replytype2=numexp
replyname2=dénominateur
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Calculer le pgcd de $val9 et $val10.


!goto stat

!exit

:question
$()	  Quelle est l'écriture irréductible de la fraction 
!insmath \frac{$val9}{$val10}
$() ?	
!if $m_complement!= 
$()	<div class="wims_instruction">$m_complement</div>	 
!else
$() 	<br> 
!endif
$()	<b>Votre réponse :</b>	<table class="wimscenter">	 <tr>	    <td>
!insmath $val9
$()</td>	    <td></td>	    <td> 
!read oef/embed.phtml reply 1,3 
$()</td>	 </tr>	 <tr>	    <td><hr></td>	    <td>=</td>	    <td><hr></td>	 </tr>	 <tr>	    <td>
!insmath $val10
$()</td>	    <td></td>	    <td> 
!read oef/embed.phtml reply 2,3 
$()</td>	 </tr>	</table>	
$()
!exit

:hint
$()Calculer le pgcd de $val9 et $val10.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10
embedcnt=2
