!set title=Décomposer
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=2
prevarcnt=1
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,3,5,8,9,12

tmp0=!randitem $tmp
tmp1=!randitem 16,25,36,64

val6=$[rint($(tmp0)*$(tmp1))]
replytype1=auto

replyname1=Premier nombre
replygood1=?analyze 7
replytype2=auto

replyname2=Deuxième nombre
replygood2=?analyze 8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Écrire 
!insmath $val6
$() comme produit de deux entiers strictement plus grands que 1.		<div class="spacer">	<b><label for="reply1"></label>Votre réponse :</b> 
!insmath $val6 =
$() 
!read oef/embed.phtml r1,5 
$()
!insmath \times
$() 
!read oef/embed.phtml r2,5 
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val7*$val8=$val6 and $val7>1 and $val8>1
 condtest1=1
!else
 condtest1=0
!endif
condname1=produit

!exit

:stat
vsavelist=6,7,8
embedcnt=2
