\title{Décomposer}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{nombre=randitem(2,3,5,8,9,12)*random(16,25,36,64)}

\statement{
Écrire \(\nombre) comme produit de deux entiers strictement plus grands que 1.

<div class="spacer">
<b><label for="reply1"></label>Votre réponse :</b> \(\nombre =)\embed{r1,5}\(\times)\embed{r2,5}.
</div>}

\answer{Premier nombre}{\rep1}{type=auto}
\answer{Deuxième nombre}{\rep2}{type=auto}

\condition{produit}{\rep1*\rep2=\nombre and \rep1>1 and \rep2>1}
