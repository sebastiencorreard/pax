\title{Trouver un multiple}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{r=4}
\integer{a1=random(0..2)}
\integer{r=\r-\a1}
\integer{a2=random(0..\r)}
\integer{r=\r-\a2}
\integer{a3=random(0..\r)}
\integer{r=\r-\a3}
\integer{a4=random(0..\r)}
\integer{r=\r-\a4}
\integer{a5=random(0..\r)}
\integer{r=\r-\a5}

\if{\a1+\a2+\a3+\a4+\a5=0}{
 \integer{nombre=126}
}{
 \integer{nombre=2^\a1*3^\a2*5^\a3*7^\a4*11^\a5}
}


\statement{Écrire un multiple de \(\nombre) différent de 0 et de lui-même.
<div class="spacer">
<b><label for="reply1">Votre réponse :</label></b>
\embed{r1,7} est un multiple de \(\nombre).
</div>}

\answer{Réponse}{\rep}{type=auto}

\integer{test=\nombre/\rep}
\integer{test2=\rep/\nombre}
\condition{\rep est un multiple de \(\nombre\) différent de 0 et de \(\nombre\)}{
  \test2*\nombre=\rep and \rep!=0 and \rep!=\nombre and \test!=NaN}

\feedback{\test*\rep=\nombre and \rep!=1 and \rep!=\nombre}{Tu as écrit un diviseur.}
\feedback{\rep=1 or \rep=\nombre}{On demande un multiple différent de 1 et de \nombre.}
