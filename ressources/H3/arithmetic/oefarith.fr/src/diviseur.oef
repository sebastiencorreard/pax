\title{Trouver un diviseur}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
maintenu par WIMSEDU à partir de la version
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{r=4}
\integer{a1=randint(0..2)}
\integer{r=\r-\a1}
\integer{a2=randint(0..\r)}
\integer{r=\r-\a2}
\integer{a3=randint(0..\r)}
\integer{r=\r-\a3}
\integer{a4=randint(0..\r)}
\integer{r=\r-\a4}
\integer{a5=randint(0..\r)}
\integer{r=\r-\a5}

\if{\a1+\a2+\a3+\a4+\a5<=1}{
 \integer{a4=\a4+1}
}
\integer{nombre=2^\a1*3^\a2*5^\a3*7^\a4*11^\a5}



\statement{Écrire un diviseur de \(\nombre) différent de 1 et de lui-même.
<div class="spacer">
<b><label for="reply1">Votre réponse :</label></b>
\embed{r1,7} est un diviseur de \(\nombre\).
</div>}

\answer{Réponse}{\rep}{type=auto}

\integer{test=\nombre/\rep}
\condition{\rep est un diviseur de \(\nombre\) différent de 1 et de \(\nombre\) ?}{\test*\rep=\nombre and \rep!=1 and \rep!=\nombre and \test!=NaN}
\integer{test2=\rep/\nombre}
\feedback{\test2*\nombre=\rep and \rep!=1 and \rep!=\nombre}{Tu as écrit un multiple.}
\feedback{\rep=1 or \rep=\nombre}{On demande un diviseur différent de 1 et de \nombre.}
