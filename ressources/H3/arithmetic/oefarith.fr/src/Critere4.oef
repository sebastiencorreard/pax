\title{Critères de divisibilité 4}
\language{fr}
\range{-5..5}
\author{Marie-Claude,David}
\email{mcld@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}
\integer{p=randint(1..500)}
\integer{p0=3*randint(1..50)}
\integer{p1=3*randint(1..50)+1}
\integer{p2=3*randint(1..50)+2}
\integer{h0=9*randint(1..50)}
\integer{h1=9*randint(1..50)+1}
\integer{h2=9*randint(1..50)+2}
\integer{q=randint(1..50)}
\integer{a=randitem(1,3,5,7,9)}
\integer{e=randitem(1,3,7,9)}
\integer{b=randitem(0,2,4,6,8)}
\integer{d=random(0,5)}
dans les colonnes
1 le diviseur,
2 les premiers chiffres du nombre
3 les derniers chiffres du nombre (peut être vide)
4 etc les places des bonnes réponses entre la colonne 4 et la dernière colonne notée -1
\matrix{data=2,\p,,2,4,6,8,10
2,\p,\b,12
2,\p,\a,11
5,\p,\e,11
5,\p,\d,12
5,\p,,5,10
10,\p,0,12
10,\p,,10
10,\p,\a,11
3,\p0,,3,6,9,10
3,\p1,,2,5,8
3,\p2,,1,4,7
9,\h0,,9,10
9,\h1,,8
9,\h2,,7}
Nombre de lignes dans la matrice
\integer{r=rows(\data)}
choix d'une ligne au hasard
\integer{k=randint(1..\r)}
integer{k=1}
\text{n=\data[\k;2]c\data[\k;3]}
liste des réponses
\text{liste=1,2,3,4,5,6,7,8,9,0,aucune valeur,toutes les valeurs}
\statement{<div class="wims_question">Cocher toutes les valeurs du chiffre \(c\) qui permettent 
au nombre \n d'être divisible par \(\data[\k;1]\) : </div>
<div class="wimscenter">\embed{reply1}.</div>
<div class="wims_instruction">Si toutes les valeurs conviennent, cocher "toutes les valeurs".</div>
}
\answer{Valeurs de c}{\data[\k;4..-1];\liste}{type=checkbox}

\feedback{\data[\k;1]=2}{<p class="wims_emph">Un nombre est divisible par 2 quand son chiffre des unités est 0&#44
 2&#44
 4&#44
 6 ou 8.</p>}
\feedback{\data[\k;1]=5}{<p class="wims_emph">Un nombre est divisible par 5 quand son chiffre des unités est 0 ou 5.</p>}
\feedback{\data[\k;1]=10}{<p class="wims_emph">Un nombre est divisible par 10 quand son chiffre des unités est 0.</p>}
\feedback{\data[\k:1]=3}{<p class="wims_emph">Un nombre est divisible par 3 quand la somme de ses chiffres est divisible par 3.</p>}
\feedback{\data[\k;1]=9}{<p class="wims_emph">Un nombre est divisible par 9 quand la somme de ses chiffres est divisible par 9.</p>}
