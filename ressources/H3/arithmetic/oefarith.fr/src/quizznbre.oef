\title{Quizz nombres 1}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{n=random(2,3,7,5,8,27)}
\integer{tmp=random(1..1000)}
\real{m=\tmp/100}
\real{m=. notin \m?\m+0.01}
\integer{tmp=random(1..10000)}
\real{p=\tmp/1000}
\real{p=. notin \p?\p+0.001}
\text{sg=random(-,)}
\text{N=wims(values 2*v+1 for v=0 to 5)}
\integer{N=randitem(\N)}
\matrix{don=\(\pi),0,0,0,1
\(\sg\sqrt{\n}),0,0,0,1
\(\sg\frac{2}{3}),1,0,0,0
\(\sg\frac{4}{7}),1,0,0,0
\(\sg\frac{\N}{2}),1,1,0,0
\(\sg\frac{\N}{4}),1,1,0,0
\(\sg \p),1,1,0,0
\(\sg \m),1,1,0,0
\(\sg \n),1,1,1,0 }
\text{list=row(random(1..9),\don)}
\text{enonce=item(1,\list)}
\integer{typeno=random(1..4)}
\text{lttype=rationnel,décimal,entier,irrationnel}
\text{lttype=item(\typeno,\lttype)}
\text{bad=Non ce n'est pas,Oui c'est}
\text{good=item(item(\typeno+1,\list)+1,\bad)}

\statement{\enonce est-il un \lttype ?

<div class="spacer"><b>Votre réponse :</b>
\embed{c1} un \lttype.
</div>
}

\choice{réponse}{\good}{\bad}
