\title{Division euclidienne}
\language{fr}
\range{-5..5}
\author{Marie-Claude,David;Cécile,Jézéquel}
\email{mcld@math.u-psud.fr,Cecile.Jezequel1@ac-versailles.fr}
\computeanswer{no}
\format{html}
\precision{10000}
a=bq+r
\integer{b=randint(2..80)}
\integer{q=randint(2..50)}

\integer{r=randint(0..\b-1)}
\integer{a=\b*\q+\r}

\statement {Compléter la division euclidienne de \(\a\) par \(\b\) :
<div class="wimscenter">
<label for="reply1">\(\a = \b \times\)</label> \embed{reply1,3} <label for="reply2">+</label> \embed{reply2,3}</div>}

\answer{}{\q}{type=algexp}
\answer{}{\r}{type=algexp}
\feedback{1=1}{La division euclidienne de \(\a\) par \(\b\) s'écrit :
<p class="wimscenter">
\(\a = \b \times \q + \r\)</p>}
\integer{arep=\b*\reply1+\reply2}

\feedback{\arep <>\a}{Le nombre \(\a\) n'est pas égal à \(\b \times \reply1 + \reply2\). }
\feedback{\reply2 >=\b}{Votre reste est supérieur ou égal au diviseur.}
