\title{Diviseur/multiple}
\language{fr}
\range{-5..5}
\author{Marie-Claude, David; Cécile, Jézéquel}
\email{mcld@math.u-psud.fr,Cecile.Jezequel1@ac-versailles.fr}
\computeanswer{no}
\format{html}
\precision{10000}

a=bq+r
\integer{b=randint(2..80)}
\integer{q=randint(2..50)}
integer{r=randint(1..\b-1)}
\text{choix=diviseur,multiple}
\integer{r=0}
\integer{a=\b*\q+\r}
\integer{d=random(\b,\q\)}
\integer{k=randint(1..2)}
\text{A=\k=1? \(\a\):\(\d\)}
\text{B=\k=1? \(\d\):\(\a\)}
\text{r=\k=1? r1:r2}
\text{s=\k=1? r2:r1}

\statement {<p class="wims_question">Connaissant l'égalité \(\a = \b \times \q\), compléter les propositions suivantes :</p>
<div>
<ul><li>Le nombre \A est un \embed{\r} de \B.</li>
<li>Le nombre \B est un \embed{\s} de \A.</li></ul></div>
}
\answer{}{2;\choix}{type=menu}{option=shuffle}
\answer{}{1;\choix}{type=menu}{option=shuffle}
