!set title=Dictée: d'une forme à l'autre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
title_nl=Dictée: d'une forme à l'autre

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env rename 
tmp0=$slib_out
val6=$(tmp0)

!ifval $val3=2 
val6= 
!endif
!readproc slib/oef/env list_error 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/oef/env user 
tmp0=$slib_out
val8=$(tmp0)

!ifval $val8 issametext supervisor and $val7 notsametext 
tmp0=!nosubst <em>\name_msg[1]? </em> \name_msg[2]:	<div class="wims_warning">	  \name_msg[3]:

val9=	$(tmp0)	$val7	\name_msg[4]</div>
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Vous êtes en train de préparer une feuille d'exercices&nbsp;,	  attention,	  Les mots suivants n'ont pas été trouvés&nbsp;,	  Il vous est conseillé de reconfigurer l'exercice.
val12=Écoutez le verbe
val13=Écrire sa forme pleine,1 ère personne du singulier
!if $val10=nl 
val11=Vous êtes en train de préparer une feuille d'exercices&nbsp;,	  attention,	  Les mots suivants n'ont pas été trouvés&nbsp;,	  Il vous est conseillé de reconfigurer l'exercice.
val12=Écoutez le verbe
val13=Écrire sa forme pleine,1 ère personne du singulier
!endif
tmp0=!randrecord listverbs

val14=$(tmp0)
tmp0=!lookup $val14 in swac_baseform_keys

val15=$(tmp0)
tmp0=!shuffle 3

val16=$(tmp0)
val17=$(val15[$(val16[1])])
!readproc slib/lang/swac $val17,eng-balm-verbs 
tmp0=$slib_out
val17=$(tmp0)
val18=$(val17[2..-1])
val17=$(val17[1;1])
val19=Preterite,Present Perfect,Infinitive
val20=$(val19[$(val16[2])])
val21=$(val19[$(val16[3])])
val22=$(val15[$(val16[2])])
val23=$(val15[$(val16[3])])
replytype1=case
replyname1=
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val12[1]) $val17.	<p>$(val13[1]) "$val20" 
!if $val20 issametext Infinitive 
$()(to + infinitif) 
!else
$()	 ($(val13[2])) 
!endif
$()</p>	<div class="wimscenter">  
!read oef/embed.phtml r1,20 
$() </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,17,20
embedcnt=1
