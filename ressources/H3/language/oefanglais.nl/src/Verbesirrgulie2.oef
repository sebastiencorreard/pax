\integer{n= rows(\liste)}
\text{selec =item(1..\u,shuffle(\n))}
\text{selection= row(\selec,\liste)}
\matrix{table= infinitief,verleden tijd,voltooid deelwoord, vertaling
de infinitief, de verleden tijd, het voltooid deelwoord, de vertaling}
\text{possible=item(1..3,row(2,\table))}
\text{base1 = item(1,\selection)}
\text{traduction=item(4,\selection)}
\text{base2= item(2,\selection)}
\text{base3= item(3,\selection)}

text{sol= item(\v, \possible)}

text{sol1 = \base1 issametext item(1,\selection) and \v<>1 ? \sol, item(1, \possible): \sol}
text{sol2 = \base1 issametext item(2,\selection) and \v<>2? sol1, item(2, \possible): \sol1}
text{sol3 = \base1 issametext item(3,\selection) and \v<>3 ? \sol2, item(3, \possible): \sol2}
text{solu= item(\w, \selection)}

\statement{Geef de verleden tijd en het voltooid deelwoord van het werkwoord <font color= green><b> \base1 </b></font> :
}
\answer{De verleden tijd is }{\base2}{type=nocase}
\answer{Het voltooid deelwoord is }{\base3}{type=nocase}
\feedback{1=1}{En <font color= green><b> \base1 </b></font> 
 betekent <font color= magenta><b> \traduction </b></font> .}
