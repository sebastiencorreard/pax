$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!column $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
!if $val9=1 
tmp0=!replace internal , by </div>,<div class="wims_center"> in <div class="wims_center">$val14</div>

val14=$(tmp0)	 
!endif
tmp0=!item $val9 of 30,250,250,250,250

val15=$[rint($(tmp0))]
tmp0=!item $val10 of 30,250,250,250,250

val16=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val13

tmp=!column $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
val18=$val14 ; $val17
