$ to ;; in $tmp
val7=une région
val8=son chef-lieu
val9=$[rint(4)]
val10=$[rint(5)]
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val11=$[rint($(tmp0))]
