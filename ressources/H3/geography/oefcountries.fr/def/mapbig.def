!set title=Cartes des grands pays
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
precision=10000
title_en=Maps of big countries

ansorder=r,c
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=africain
val8=américain
val9=asiatique
val10=européen
val11=océanique
val12=
val13=Quel est ce pays,	  C'est un pays
val14=Nom du pays,Continent
!if $val6=en 
val7=of Africa
val8=of America
val9=of Asia
val10=of Europe
val11=of Oceanic
val12=
val13=What is this country,	  This is a country of
val14=Name of the country,Continent
!endif
tmp=!trim ag,$val7	ar,$val8	as,$val11	bg,$val9	br,$val8	ca,$val8	ch,$val9	eg,$val7	et,$val7	fr,$val10	gm,$val10	id,$val9	in,$val9	ir,$val9	it,$val10	ja,$val9	ks,$val9	kz,$val9	ly,$val7	mg,$val9	mx,$val8	ni,$val7	pk,$val9	rp,$val9	rs,$val10	sa,$val9	su,$val7	tu,$val9	uk,$val10	up,$val10	us,$val8	vm,$val9
val15=!translate internal $	\
$ to ;; in $tmp
val16=$val7,$val8,$val9,$val10,$val11
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!nospace big _fr

val18=$(tmp0)
!if $val6=en 
tmp0=!nospace big _en

val18=$(tmp0)
!endif
tmp0=!item 1 of $val17

val19=$(tmp0)
tmp0=!lookup $val19 in data/$val18

val20=$(tmp0)
val20=$(val20[1])
tmp0=!item 2 of $val17

val21=$(tmp0)
val22=Algérie,Angola,Botswana,Bénin,Burundi,Tchad,Cameroun,Comores,Centrafrique,Cap Vert,Djibouti,Egypte,Guinée Equatoriale,Erythrée,Ethiopie,Gambie,Gabon,Ghana,Guinée,Côte d'Ivoire,Kenya,Liberia,Lesotho,Libye,Madagascar,Malawi,Mali,Maroc,Maurice , Ile Maurice,Mauritanie,Mozambique,Niger,Nigéria,Guinée Bissau,Rwanda,Seychelles,Afrique du Sud,Sénégal,Sierra Leone,Somalie,Soudan,Togo,Tunisie,Tanzanie,Ouganda,Burkina Faso,Namibie,Swaziland,Zambie,Zimbabwe,Argentine,Barbade,Bahamas,Belize,Bolivie,Brésil,Canada,Chili,Colombie,Costa Rica,Cuba,Dominique,République Dominicaine,Équateur,El Salvador,Grenade,Guatemala,Guyana,Haïti,Honduras,Jamaïque,Mexique,Suriname,Nicaragua,Paraguay,Pérou,Panama,Saint Kitts et Nevis,Sainte Lucie,Trinidad et Tobago,Etats Unis,Uruguay,Venezuela,Afghanistan,Azerbaijan,Arménie,Bahreïn,Bangladesh , Bengladesh,Birmanie,Bhoutan,Brunei,Cambodge,Sri Lanka,Chine,Chypre,Indonésie,Inde,Iran,Israël,Irak,Japon,Jordanie,Khirghizistan,Corée du Nord,Corée du Sud,Kuweït,Kazakhstan,Laos,Liban,Mongolie,Oman,Maldives,Malaisie,Népal,Pakistan,Qatar,Philippines,Arabie Saoudite,Singapour,Syrie,Emirats Arabes Unis,Thaïlande,Tadjikistan,Turquie,Turkménistan,Ouzbékistan,Viêt Nam,Yémen,Albanie,Andorre,Autriche,Belgique,Biélorussie,Bulgarie,Danemark,Irlande,Estonie,République Tchèque , Tchèque,Finlande,France,Géorgie,Allemagne,Grèce,Croatie,Hongrie,Islande,Italie,Lettonie,Lituanie,Slovaquie,Liechtenstein,Luxembourg,Moldavie,Macédoine,Monaco,Malte,Pays Bas,Norvège,Pologne,Portugal,Roumanie,Russie,Slovénie,Espagne,Suède,Suisse,Royaume Uni , Grande Bretagne , Angleterre,Ukraine,Vatican,Australie,Salomon , Iles Salomon,Fidji , Iles Fidji,Micronésie,Kiribati,Vanuatu,Nauru,Nouvelle Zélande,Papouasie Nouvelle Guinée,Palau,Marshall , Iles Marshall,Tonga,Tuvalu,Samoa , Samoa occidentales,		
replytype1=atext
replyname1=$(val14[1])
replygood1=$val20;$val22
choicename1=$(val14[2])
