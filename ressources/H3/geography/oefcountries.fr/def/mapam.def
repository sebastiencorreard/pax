!set title=Cartes d'Amérique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
precision=10000
title_en=Maps of America

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Quel est ce pays,	  C'est un pays
val8=Nom du pays,Continent
val9=du continent américain
!if $val6=en 
val7=What is this country,	  This is a country of
val8=Name of the country,Continent
val9=of American continent
!endif
tmp=!trim ar	bb	bf	bh	bl	br	ca	ci	co	cs	cu	do	dr	ec	es	gj	gt	gy	ha	ho	jm	mx	ns	nu	pa	pe	pm	sc	st	td	us	uy	ve
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!nospace am _fr

val12=$(tmp0)
!if $val6=en 
tmp0=!nospace am _en

val12=$(tmp0)
!endif
tmp0=!item 1 of $val11

val13=$(tmp0)
tmp0=!lookup $val13 in data/$val12

val14=$(tmp0)
val14=$(val14[1])
val15=Algérie,Angola,Botswana,Bénin,Burundi,Tchad,Cameroun,Comores,Centrafrique,Cap Vert,Djibouti,Egypte,Guinée Equatoriale,Erythrée,Ethiopie,Gambie,Gabon,Ghana,Guinée,Côte d'Ivoire,Kenya,Liberia,Lesotho,Libye,Madagascar,Malawi,Mali,Maroc,Maurice , Ile Maurice,Mauritanie,Mozambique,Niger,Nigéria,Guinée Bissau,Rwanda,Seychelles,Afrique du Sud,Sénégal,Sierra Leone,Somalie,Soudan,Togo,Tunisie,Tanzanie,Ouganda,Burkina Faso,Namibie,Swaziland,Zambie,Zimbabwe,Argentine,Barbade,Bahamas,Belize,Bolivie,Brésil,Canada,Chili,Colombie,Costa Rica,Cuba,Dominique,République Dominicaine,Équateur,El Salvador,Grenade,Guatemala,Guyana,Haïti,Honduras,Jamaïque,Mexique,Suriname,Nicaragua,Paraguay,Pérou,Panama,Saint Kitts et Nevis,Sainte Lucie,Trinidad et Tobago,Etats Unis,Uruguay,Venezuela,Afghanistan,Azerbaijan,Arménie,Bahreïn,Bangladesh , Bengladesh,Birmanie,Bhoutan,Brunei,Cambodge,Sri Lanka,Chine,Chypre,Indonésie,Inde,Iran,Israël,Irak,Japon,Jordanie,Khirghizistan,Corée du Nord,Corée du Sud,Kuweït,Kazakhstan,Laos,Liban,Mongolie,Oman,Maldives,Malaisie,Népal,Pakistan,Qatar,Philippines,Arabie Saoudite,Singapour,Syrie,Emirats Arabes Unis,Thaïlande,Tadjikistan,Turquie,Turkménistan,Ouzbékistan,Viêt Nam,Yémen,Albanie,Andorre,Autriche,Belgique,Biélorussie,Bulgarie,Danemark,Irlande,Estonie,République Tchèque , Tchèque,Finlande,France,Géorgie,Allemagne,Grèce,Croatie,Hongrie,Islande,Italie,Lettonie,Lituanie,Slovaquie,Liechtenstein,Luxembourg,Moldavie,Macédoine,Monaco,Malte,Pays Bas,Norvège,Pologne,Portugal,Roumanie,Russie,Slovénie,Espagne,Suède,Suisse,Royaume Uni , Grande Bretagne , Angleterre,Ukraine,Vatican,Australie,Salomon , Iles Salomon,Fidji , Iles Fidji,Micronésie,Kiribati,Vanuatu,Nauru,Nouvelle Zélande,Papouasie Nouvelle Guinée,Palau,Marshall , Iles Marshall,Tonga,Tuvalu,Samoa , Samoa occidentales,		
