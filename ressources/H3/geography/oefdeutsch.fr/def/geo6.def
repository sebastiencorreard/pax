replyname5=5
replygood5=$(val9[5])
replytype6=dragfill
replyname6=6
replygood6=$(val9[6])
replytype7=dragfill
replyname7=7
replygood7=$(val9[7])
replytype8=dragfill
replyname8=8
replygood8=$(val9[8])
replytype9=dragfill
replyname9=9
replygood9=$(val9[9])
replytype10=dragfill
replyname10=10
replygood10=$(val9[10])
replytype11=dragfill
replyname11=11
replygood11=$(val9[11])
replytype12=dragfill
replyname12=12
replygood12=$(val9[12])
replytype13=dragfill
replyname13=13
replygood13=$(val9[13])
replytype14=dragfill
replyname14=14
replygood14=$(val9[14])
replytype15=dragfill
replyname15=15
replygood15=$(val9[15])
replytype16=dragfill
replyname16=16
replygood16=$(val9[16])
replytype17=dragfill
replyname17=17
replygood17=$(val9[17])
replytype18=dragfill
replyname18=18
replygood18=$(val9[18])
replytype19=dragfill
replyname19=19
replygood19=$(val9[19])
replytype20=dragfill
replyname20=20
replygood20=$(val9[20])
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val8 \newline \listchoice{$val14} \end{statement} \begin{solution} $val9 \end{solution} 


!goto stat

!exit

:question
$()	  <div class="wims_question">$val8</div>	   
!for m_k=1 to $val6 
$()<div class="inline"> 
!read oef/embed.phtml r\k,$val7 
$()</div> 
!next
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val8 $m_newline $m_listchoice{$val14} $m_end{statement} $m_begin{solution} $val9 $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,14
embedcnt=1
