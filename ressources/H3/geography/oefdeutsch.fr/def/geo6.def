!set title=Les villes allemandes et leur population
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Carré, Delafraye
email=josiane-an.carre@ac-amiens.fr

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=20
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(10)]
val7=150x60
val8=Classe les villes allemandes suivantes, dans l'ordre croissant, de la plus peuplée à la moins peuplée. Au fait, en allemand, un "habitant" se dit "Einwohner" !
val9=Berlin,Hamburg,München,Köln,Frankfurt am Main,Stuttgart,Düsseldorf,Leipzig,Dortmund,Essen
tmp0=!item 1 of 1 oui, 2 non

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!word 1 of $val10

val10=$(tmp0)

!ifval $val10=1 
tmp0=!embraced randitem $val9

val9= $(tmp0)
!endif
tmp0=!itemcnt $val9

val11=$[rint($(tmp0))]
val6=$[rint(min(20,min($val6,$val11)))]
!if $val6<$val11 
tmp0=!shuffle $val11

val12=$(tmp0)
tmp0=!sort numeric items $(val12[1..$val6])

val12=$(tmp0)
tmp0=!item $val12 of $val9

val9=$(tmp0)
!endif
tmp0=!makelist r x for x=1 to $val6

val13=$(tmp0)
!readproc slib/data/random $val6, item, $val9 
tmp0=$slib_out
val14=$(tmp0)
oefsteps=$val13 
nextstep=!nosubst $val13 
!readproc oef/steps.proc
replytype1=dragfill
replyname1=1
replygood1=$(val9[1])
replytype2=dragfill
replyname2=2
replygood2=$(val9[2])
