val10=!translate internal $	\
$ to ;; in $tmp
val11=split
val12=
tmp0=!item 1 of 1. oui, 2. non

val13=$(tmp0)
tmp=!nonempty items $val9

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!nonempty rows $val10

val10=$(tmp0)
tmp0=!select $val10 where column 2 issametext $val9

val14=$(tmp0)
tmp0=!select $val10 where column 2 notsametext $val9

val15=$(tmp0)
tmp0=!nonempty item $(val14[;1])

tmp1=!shuffle $(tmp0)

val14=$(tmp1)
tmp0=!nonempty item $(val15[;1])

tmp1=!shuffle $(tmp0)

val15=$(tmp1)
tmp0=!itemcnt $val14

val16=$[rint($(tmp0))]
tmp0=!itemcnt $val15

val17=$[rint($(tmp0))]
val6=$[rint(min($val6,$val16+$val17))]
val7=$[rint(min($val7,$val6-1))]
val8=$[rint(min($val8,$val6-$val7-1))]
tmp0=!randint min($val7,$val16), min($val6-$val8,$val16)

val18=$[rint($(tmp0))]
val19=$[rint(min($val6-$val18,$val17))]
val6=$[rint($val18+$val19)]
tmp0=!makelist 1 for x=1 to $val18

tmp1=!makelist 0 for x=1 to $val19

val20=$(tmp0),$(tmp1)
tmp0=!item 1 to $val18 of $val14

tmp1=!item 1 to $val19 of $val15

val21=$(tmp0),$(tmp1)
tmp0=!values x for x=1 to $val6

val22=$(tmp0)
tmp0=!shuffle $val22

val23=$(tmp0)
tmp0=!item $val23 of $val21

val21=$(tmp0)
tmp0=!item $val23 of $val20

val20=$(tmp0)
tmp0=!positionof item 1 in $val20

val24=$(tmp0)
tmp0=!itemcnt $val24

val25=$[rint($(tmp0))]
!if liste iswordof $val12 
val26=<ul>
val27=<li>
val28=</li>
val29=</ul>
!else
val26=<div>
val27=<span>
val28=</span>
