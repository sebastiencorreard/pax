val30=$(tmp0)
!endif
!if liste iswordof $val12 
val31=\begin{checkbox}
!for val32 =1 to $val6 
val31=$val31	    \item $(val21[$val32]) 
!next
val31=$val31 \end{checkbox}
!else
val31=\begin{quote}
!for val32 =1 to $val6-1 
val31=$val31 $(val21[$val32]), 
!next
val31=$val31 $(val21[$val6]).	        \end{quote} 
!endif
!if liste iswordof $val12 
val33=\begin{itemize}
!for val34 =1 to $val25 
val33=$val33	    \item $(val21[$(val24[$val34])]) 
!next
val33=$val33	        \end{itemize}
!else
val33=\begin{quote}
!for val35 =1 to $val25-1 
val33=$val33 $(val21[$(val24[$val35])]), 
!next
val33=$val33 $(val21[$(val24[$val35])]).	        \end{quote} 
!endif
