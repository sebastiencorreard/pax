:question
$()	   
!for m_a=1 to $m_step-1 
$()	    
!if $m_a <= $val7 
$()	      <div class="word_jumble">$(val27[$m_a;])	      
!if  $(val16[$m_a;]) notsametext xxx  
$()<em class="indication">($(val16[$m_a;]))</em> 
!endif
$()</div>	     
!endif
$()	   
!next
$()	  
!if $m_step <= $val7 
$()	    <p class="wims_question">$val6</p>	    <div class="wimscenter">	       
!read oef/embed.phtml r \step,50 x 50 
$()	      
!if  $(val16[$m_step;]) notsametext xxx  
$()	      <span class="indication">($(val16[$m_step;]))</span>  
!endif
$()	    </div>	   
!endif
$()	
$()
