 \title{Ranger des nombres A1}
 \integer{a=randint(1..9)}
 \integer{b=randint(1..6)}
 \text{sg=shuffle(-1,-1,1,1)}
 \real{N1=\sg[1]*(\a+\b/10)}
 \real{N2=\sg[2]*(\a+(\b+1)/10)}
 \real{N3=\sg[3]*(\a+(\b+2)/10)}
 \real{N4=\sg[4]*(\a+(\b+3)/10)}
 \text{liste=\N1,\N2,\N3,\N4}

\real{S1=min(min(\liste[1],\liste[2]),min(\liste[3],\liste[4]))}
\real{S4=max(max(\liste[1],\liste[2]),max(\liste[3],\liste[4]))}
\text{t2=wims(listcomplement \S1,\S4 in \liste)}
\real{S2=min(\t2)}
\real{S3=max(\t2)}
\integer{ch=randint(1..2)}
\text{sign=item(\ch,<,>)}
\text{sens=item(\ch,croissant,décroissant)}
\text{ltrep=\ch=2?\S4,\S3,\S2,\S1:\S1,\S2,\S3,\S4}
\statement{
Ranger les nombres suivants dans l'ordre \sens.
