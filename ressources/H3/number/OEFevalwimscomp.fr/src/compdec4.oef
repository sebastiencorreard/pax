 \title{Comparer deux nombres A4}
 \integer{a=randint(11..99)}
 \integer{b=randint(1..9)}
 \integer{p1=randint(2..4)}
 \integer{p2=randint(\p1+1..6)}
 \real{N1=\a+\b*10^(-\p1)}
 \real{N2=\a+\b*10^(-\p2)}
 \text{ltrep=\N2,\N1}

\integer{ch=randint(1..2)}
