\title{Somme/différence et comparaison 5}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}
\text{size=100x50x1}

\integer{a=randint(11..49)}
\integer{c=randint(51..99)}
\integer{b=randint(101..199)}
\text{f1=\a/\b}
\text{f2=\c/\b}
\integer{a=randint(1..8)}
\integer{b=randint(1..9)}
\real{n1=\b+\a*0.1+randint(1..9)*0.01}
\real{n2=\b+randint(\a+1..9)*0.1+randint(1..9)*0.01}
\text{sg=randitem(+,-)}
\text{n=+ isin \sg?\n1,\n2:\n2,\n1}
\text{N1=texmath(\f1\sg\n[1])}
\text{N2=texmath(\f1\sg\n[2])}
\text{N3=texmath(\f2\sg\n[2])}
\integer{ch=randint(1..2)}
\text{sign=item(\ch,<,>)}
\text{sens=item(\ch,croissant,décroissant)}
\text{ltrep=\ch=2?\(\N3),\(\N2),\(\N1):\(\N1),\(\N2),\(\N3)}



\statement{
Ranger les expressions suivantes dans l'ordre \sens.
<table class="wimscenter wimsnoborder"><tr>
 <td>\embed{r1,\size}</td>
 <td>\sign</td>
 <td>\embed{r2,\size}</td>
 <td>\sign</td>
 <td>\embed{r3,\size}</td>
 </tr></table>
<div class="wims_instruction">Vous ne devez faire aucun calcul.</div>}

\answer{Premier champ}{\rep1;\ltrep}{type=dragfill}
\answer{Deuxième champ}{\rep2}{type=dragfill}
\answer{Troisième champ}{\rep3}{type=dragfill}

\condition{Ordre correct}{( \rep1 issametext \ltrep[1] and \rep2 issametext \ltrep[2] ) and ( \rep3 issametext \ltrep[3] )}

