!set title=Encadrement 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

tmp1=!randint 1, 9

tmp2=!randint 11, 19

val6=$(tmp0)+$(tmp1)/$(tmp2)
tmp=!translate ";': to $     $ in $val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val6=$(tmp0)
tmp0=!texmath $val6

val7=$(tmp0)
val8=Donner un encadrement par deux entiers consécutifs du nombre \($val7).
val9=$[rint(floor($val6))]
val10=$[rint($val9+1)]
replytype1=numexp
replyname1=Borne inférieure
replygood1=$val9
replytype2=numexp
replyname2=Borne supérieure
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8	<div class="wimscenter"> 
!read oef/embed.phtml r1,5 
$() 
!insmath < $val7 < 
$()  
!read oef/embed.phtml r2,5 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=2
