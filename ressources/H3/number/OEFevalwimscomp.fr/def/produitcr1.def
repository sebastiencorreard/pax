!set title=Egalité de fractions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
tmp0=!shuffle a,b,c,d

val7=$(tmp0)
val8=Compléter la phrase ci-dessous.
val9=Pour vérifier si \(\frac{$(val7[1])}{$(val7[2])}=\frac{$(val7[3])}{$(val7[4])}), il faut vérifier que ... 
val10=\($(val7[1])\times $(val7[4]) = $(val7[3])\times $(val7[2]))
val11=\($(val7[1]) + $(val7[4]) = $(val7[3]) + $(val7[2])\char32),\($(val7[1]) - $(val7[4]) = $(val7[3]) - $(val7[2])\char32)
choicename1=
choicegood1=$val10
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val8!= 
$()$val8 
!endif
$()	<div class="wimscenter bold">$val9</div>	
!if $m_compenonce!= 
$()	<div class="wims_instruction">	$m_compenonce	</div> 
!endif
$()
$()
!exit

