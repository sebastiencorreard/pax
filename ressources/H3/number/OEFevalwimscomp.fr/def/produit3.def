!set title=Produit et comparaison 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
val7=Vous devez répondre à la question sans faire de calcul.
tmp0=!shuffle A,B,C,D,E,F

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 11, 49

val11=$[rint($(tmp0))]
tmp0=!randint 51, 99

val12=$[rint($(tmp0))]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val13=$(tmp0)
tmp0=!randint 111, 999

tmp1=!randint 111.999

tmp2=!texmath $val13 $(tmp0)/$(tmp1)

val14=$(tmp2)

!ifval - isin $val13
val14=($val14)
!endif
val15=$val11\times $val14
val16=$val12\times $val14
tmp0=!randint 1, 2

val17=$[rint($(tmp0))]

!ifval $val17=1
val18=$val9 = $val15 \quad ; \quad $val10 = $val16
!else
val18=$val10 = $val16 \quad ; \quad $val9 = $val15
!endif

!ifval + isin $val13
val19=$val9,$val10
!else
val19=$val10,$val9
!endif
tmp0=!randint 1, 2

val17=$[rint($(tmp0))]
tmp0=!item $val17 of petite,grande

val20=$(tmp0)
val21=Parmi les deux expressions ci-dessous, laquelle est la plus $val20 &#63;
val22=\($val18)
tmp0=!item $val17 of $val19

val23=$(tmp0)
val24=$val7
choicename1=
choicegood1=$val23
choicebad1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val21!= 
$()$val21 
!endif
$()	<div class="wimscenter bold">$val22</div>	
!if $val24!= 
$()	<div class="wims_instruction">	$val24	</div> 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=21,22,24
embedcnt=0
