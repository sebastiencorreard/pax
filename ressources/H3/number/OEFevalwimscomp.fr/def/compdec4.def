!set title=Comparer deux nombres A4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
tmp0=!randint 2, 4

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 6

val9=$[rint($(tmp0))]
val10=$[$val6+$val7*10^(-$val8)]
val11=$[$val6+$val7*10^(-$val9)]
val12=$val11,$val10
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val12

val14=$(tmp0)
tmp0=!item $val13 of petit,grand

val15=$(tmp0)
choicename1=
choicegood1=$val14
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le plus $val15 de ces deux nombres ?
$()
!exit

