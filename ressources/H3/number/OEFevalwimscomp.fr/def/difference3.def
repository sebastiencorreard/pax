val6=50x25x1
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 1111, 99999

tmp1=!randint 1, 3

val8=$[-$(tmp0)/10^$(tmp1)]
tmp0=!shuffle A,B,C,D,E,F

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of grand,petit

val13=$(tmp0)
val14=$val7 a calculé la différence entre deux nombres \(A\) et $val11. Elle trouve :	 <div class="wimscenter">\($val10 -$val11=$val8)</div> Quel est le plus $val13 de ces deux nombres &#63;
val15=$val11,$val10,aucun des deux
tmp0=!item $val12 of $val15

val16=$(tmp0)
choicename1=
choicegood1=$val16
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

