!set title=Egalité de fractions 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
tmp0=!shuffle 2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint($(val7[1])*$val9)]
val11=$[rint($(val7[2])*$val9)]

!ifval $val8=1
val7=$(val7[1]),$(val7[2]),$val10,$val11
!endif
val12=Les nombres \(\frac{$(val7[1])}{$(val7[2])}) et \(\frac{$(val7[3])}{$(val7[4])}) sont-ils égaux &#63;

!ifval $(val7[1])*($(val7[4]))=$(val7[3])*($(val7[2]))
val13=Oui
!else
val13=Non
!endif
val14=Oui,Non
choicename1=
choicegood1=$val13
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $m_enonce0!= 
$()$m_enonce0 
!endif
$()	<div class="wimscenter bold">$val12</div>	
!if $m_compenonce!= 
$()	<div class="wims_instruction">	$m_compenonce	</div> 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=0
