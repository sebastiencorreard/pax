!set title=Comparer deux nombres B5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 30

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 11, 49

val7=$[rint($(tmp0))]
tmp0=!randint 51, 99

val8=$[rint($(tmp0))]
tmp0=!randint 11, 49

val9=$[rint($(tmp0))]
tmp0=!randint 51, 99

val10=$[rint($(tmp0))]
val11=\(\frac{$val7}{$val8}),\(\frac{$val10}{$val9})
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=$(tmp0)
tmp0=!item $val12 of petit,grand

val14=$(tmp0)
choicename1=
choicegood1=$val13
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le plus $val14 de ces deux nombres ?
$()
!exit

