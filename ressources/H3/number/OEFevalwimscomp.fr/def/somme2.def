!set title=Somme/Différence et comparaison 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
val7=Vous devez répondre à la question sans faire de calcul.
tmp0=!shuffle A,B,C,D,E,F

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp=!nonempty items strictement positif,strictement négatif,positif,négatif

tmp0=!randitem $tmp
val11=$(tmp0)
val12=Compléter la phrase ci-dessous.
val13=Si je soustrais un nombre $val11 à deux nombres \(A\) et \(B\), alors les différences obtenues ... 
val14=sont rangées dans le même ordre que \(A\) et \(B\)
val15=sont rangées dans l'ordre inverse de celui de \(A\) et \(B\)
choicename1=
choicegood1=$val14
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val12!= 
$()$val12 
!endif
$()	<div class="wimscenter bold">$val13</div>	
!if $m_compenonce!= 
$()	<div class="wims_instruction">	$m_compenonce	</div> 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=0
