!set title=Comparer deux nombres B2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 30

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 11, 49

val7=$[rint($(tmp0))]
tmp0=!randint 51, 99

val8=$[rint($(tmp0))]
val9=\(\frac{$val7}{$(val6[1])}),\(\frac{$val8}{$(val6[1])})
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val9

val11=$(tmp0)
tmp0=!item $val10 of petit,grand

val12=$(tmp0)
choicename1=
choicegood1=$val11
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le plus $val12 de ces deux nombres ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=0
