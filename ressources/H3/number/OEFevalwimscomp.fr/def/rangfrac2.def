!set title=Ranger des nombres B2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=40x50x1
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randint 21, 29

val8=$[rint($(tmp0))]
tmp0=!randint 31, 49

val9=$[rint($(tmp0))]
tmp0=!randint 51, 69

val10=$[rint($(tmp0))]
tmp0=!randint 71, 99

val11=$[rint($(tmp0))]
val12=\(\frac{$val8}{$val7}),\(\frac{$val9}{$val7}),\(\frac{$val10}{$val7}),\(\frac{$val11}{$val7})
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!item $val13 of <,>

val14=$(tmp0)
tmp0=!item $val13 of croissant,décroissant

val15=$(tmp0)

!ifval $val13=2
val12=$(val12[4]),$(val12[3]),$(val12[2]),$(val12[1])
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 16;$val12
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 17
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 18
replytype4=dragfill
replyname4=Quatrième champ
replygood4=?analyze 19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres suivants dans l'ordre $val15.	<table class="wimscenter"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val14</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val14</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 <td>$val14</td>	 <td> 
!read oef/embed.phtml r4,$val6 
$()</td>	 </tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val16 isin $(val12[1]) and $val17 isin $(val12[2])) and ($val18 isin $(val12[3]) and $val19 isin $(val12[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,12,14,15,16,17,18,19
embedcnt=4
