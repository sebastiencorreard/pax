!set title=Valeur approchée 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in petit,supérieur,1	grand,inférieur,2

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!randint 11, 99

tmp1=!randint 111, 999

val7=$[$(tmp0)+$(tmp1)/1000]
val7=$[-$val7]
val8=Quel est le plus $(val6[1]) nombre entier $(val6[2]) au nombre $val7 &#63;
val9=$[rint(floor($val7))]

!ifval $(val6[3])=1
val9=$[rint($val9+1)]
!endif
replytype1=numexp
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8<p>	<b>Votre réponse</b>:  
!read oef/embed.phtml r1,5 
$()	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
