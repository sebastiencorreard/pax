!set title=Produit et comparaison 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
val7=Vous devez répondre à la question sans faire de calcul.
tmp0=!shuffle A,B,C,D,E,F

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 11, 99

val11=$[rint($(tmp0))]
tmp0=!randint 5, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val12=$[$val11+$(tmp0)*+$(tmp1)*0.01+$(tmp2)*0.001]
val12=$[-$val12]
tmp0=!randint 1, 4

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val13=$[$val11+$(tmp0)*+$(tmp1)*0.01+$(tmp2)*0.001]
val13=$[-$val13]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val14=$(tmp0)
tmp0=!randint 11, 99

tmp1=!randint 1, 9

tmp2=!randint 0, 9

val15=$[$(tmp0)+0.1*$(tmp1)+$(tmp2)*0.01]

!ifval - isin $val14
val15=(-$val15)
!endif
val16=$val12\times $val15
val17=$val13\times $val15
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]

!ifval $val18=1
val19=$val9 = $val16 \quad ; \quad $val10 = $val17
!else
val19=$val10 = $val17 \quad ; \quad $val9 = $val16
!endif

!ifval + isin $val14
val20=$val9,$val10
!else
val20=$val10,$val9
!endif
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]
tmp0=!item $val18 of petite,grande

val21=$(tmp0)
val22=Parmi les deux expressions ci-dessous, laquelle est la plus $val21 &#63;
val23=\($val19)
tmp0=!item $val18 of $val20

val24=$(tmp0)
choicename1=
choicegood1=$val24
choicebad1=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val22!= 
$()$val22 
!endif
$()	<div class="wimscenter bold">$val23</div>	
!if $m_compenonce!= 
$()	<div class="wims_instruction">	$m_compenonce	</div> 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=22,23
embedcnt=0
