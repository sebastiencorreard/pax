!set title=Comparer deux nombres B1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 30

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
val7=\(-\frac{$(val6[1])}{$(val6[2])}),\(\frac{$(val6[3])}{$(val6[4])})
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!item $val8 of $val7

val9=$(tmp0)
tmp0=!item $val8 of petit,grand

val10=$(tmp0)
choicename1=
choicegood1=$val9
choicebad1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le plus $val10 de ces deux nombres ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=0
