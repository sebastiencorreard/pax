!set title=Egalité de fractions 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
tmp0=!shuffle 2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!shuffle -1,1

val10=$(tmp0)
tmp0=!shuffle -1,1

val11=$(tmp0)
val12=$[rint($(val10[1])*$(val7[1]))]
val13=$[rint($(val10[2])*$(val7[2]))]

!ifval $val9=1
val14=$[rint($(val11[1])*$(val7[1])*$val8)]
!else
val14=$[rint($(val11[1])*$(val7[3]))]
!endif

!ifval $val9=1
val15=$[rint($(val11[2])*$(val7[2])*$val8)]
!else
val15=$[rint($(val11[2])*$(val7[4]))]
!endif
val16=Les nombres \(\frac{$val12}{$val13}) et \(\frac{$val14}{$val15}) sont-ils égaux &#63;

!ifval $val12*($val15)=$val13*($val14)
val17=Oui
!else
val17=Non
!endif
val18=Oui,Non
choicename1=
choicegood1=$val17
choicebad1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $m_enonce0!= 
$()$m_enonce0 
!endif
$()	<div class="wimscenter bold">$val16</div>	
!if $m_compenonce!= 
$()	<div class="wims_instruction">	$m_compenonce	</div> 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16
embedcnt=0
