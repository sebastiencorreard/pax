!set title=Ranger des nombres A5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
tmp0=!shuffle 2,3,4,5,6,1,7,8,9

val7=$(tmp0)
tmp0=!shuffle $(val7[1]),$(val7[1]),0,0

val8=$(tmp0)
val9=$[$(val8[1])+$(val7[2])/100+$(val7[2])/1000]
val10=$[$(val8[2])+$(val7[2])/10+$(val7[2])/1000]
val11=$[$(val8[3])+$(val7[2])/100+$(val7[2])/10]
val12=$[$(val8[4])+$(val7[2])/1000]
val13=$val9,$val10,$val11,$val12
val14=$[min(min($(val13[1]),$(val13[2])),min($(val13[3]),$(val13[4])))]
val15=$[max(max($(val13[1]),$(val13[2])),max($(val13[3]),$(val13[4])))]
tmp0=!listcomplement $val14,$val15 in $val13

val16=$(tmp0)
val17=$[min($val16)]
val18=$[max($val16)]
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
tmp0=!item $val19 of <,>

val20=$(tmp0)
tmp0=!item $val19 of croissant,décroissant

val21=$(tmp0)

!ifval $val19=2
val22=$val15,$val18,$val17,$val14
!else
val22=$val14,$val17,$val18,$val15
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 23;$val22
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 24
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 25
replytype4=dragfill
replyname4=Quatrième champ
replygood4=?analyze 26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres suivants dans l'ordre $val21.	<table class="wimscenter"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val20</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val20</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 <td>$val20</td>	 <td> 
!read oef/embed.phtml r4,$val6 
$()</td>	 </tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val23 isin $(val22[1]) and $val24 isin $(val22[2])) and ($val25 isin $(val22[3]) and $val26 isin $(val22[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,20,21,22,23,24,25,26
embedcnt=4
