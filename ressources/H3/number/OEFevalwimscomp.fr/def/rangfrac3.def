!set title=Ranger des nombres B3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=40x50x1
tmp0=!randint 21, 29

val7=$[rint($(tmp0))]
tmp0=!randint 31, 49

val8=$[rint($(tmp0))]
tmp0=!randint 51, 69

val9=$[rint($(tmp0))]
tmp0=!randint 71, 99

val10=$[rint($(tmp0))]
val11=\(-\frac{1}{$val7}),\(-\frac{1}{$val8}),\(-\frac{1}{$val9}),\(-\frac{1}{$val10})
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of <,>

val13=$(tmp0)
tmp0=!item $val12 of croissant,décroissant

val14=$(tmp0)

!ifval $val12=2
val11=$(val11[4]),$(val11[3]),$(val11[2]),$(val11[1])
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 15;$val11
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 16
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 17
replytype4=dragfill
replyname4=Quatrième champ
replygood4=?analyze 18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres suivants dans l'ordre $val14.	<table class="wimscenter"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val13</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val13</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 <td>$val13</td>	 <td> 
!read oef/embed.phtml r4,$val6 
$()</td>	 </tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val15 isin $(val11[1]) and $val16 isin $(val11[2])) and ($val17 isin $(val11[3]) and $val18 isin $(val11[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,11,13,14,15,16,17,18
embedcnt=4
