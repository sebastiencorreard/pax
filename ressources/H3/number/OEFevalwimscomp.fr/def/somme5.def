!set title=Somme/différence et comparaison 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=100x50x1
tmp0=!randint 11, 49

val7=$[rint($(tmp0))]
tmp0=!randint 51, 99

val8=$[rint($(tmp0))]
tmp0=!randint 101, 199

val9=$[rint($(tmp0))]
val10=$val7/$val9
val11=$val8/$val9
tmp0=!randint 1, 8

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 9

val12=$[$val9+$val7*0.1+$(tmp0)*0.01]
tmp0=!randint $val7+1, 9

tmp1=!randint 1, 9

val13=$[$val9+$(tmp0)*0.1+$(tmp1)*0.01]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val14=$(tmp0)

!ifval + isin $val14
val15=$val12,$val13
!else
val15=$val13,$val12
!endif
tmp0=!texmath $val10$val14$(val15[1])

val16=$(tmp0)
tmp0=!texmath $val10$val14$(val15[2])

val17=$(tmp0)
tmp0=!texmath $val11$val14$(val15[2])

val18=$(tmp0)
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
tmp0=!item $val19 of <,>

val20=$(tmp0)
tmp0=!item $val19 of croissant,décroissant

val21=$(tmp0)

!ifval $val19=2
val22=\($val18),\($val17),\($val16)
!else
val22=\($val16),\($val17),\($val18)
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 23;$val22
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 24
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les expressions suivantes dans l'ordre $val21.	<table class="wimscenter wimsnoborder"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val20</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val20</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 </tr></table>	<div class="wims_instruction">Vous ne devez faire aucun calcul.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ( $val23 issametext $(val22[1]) and $val24 issametext $(val22[2]) ) and ( $val25 issametext $(val22[3]) )
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,20,21,22,23,24,25
embedcnt=3
