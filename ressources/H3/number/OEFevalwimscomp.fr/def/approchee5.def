!set title=Valeur approchée 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

tmp1=!randint 1, 9

tmp2=!randint 1, 9

tmp3=!randint 1, 9

val6=$[$(tmp0)+$(tmp1)*0.1+$(tmp2)*0.01+$(tmp3)*0.001]
tmp0=!randint 0, 2

val7=$[rint($(tmp0))]
tmp0=!item $val7+1 of à l'unité,au dixième,au centième

val8=$(tmp0)
val9=$[rint(($val6)*10^$val7)/10^$val7]
val10=Quel est l'arrondi $val8 du nombre $val6 &#63;
replytype1=numexp
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10<p>	<b>Votre réponse</b>:  
!read oef/embed.phtml r1,5 
$()	</p>
$()
!exit

