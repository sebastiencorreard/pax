!set title=Ranger des nombres B5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=40x50x1
tmp0=!randint 11, 49

val7=$[rint($(tmp0))]
tmp0=!randint 51, 99

val8=$[rint($(tmp0))]
tmp0=!randint 11, 49

val9=$[rint($(tmp0))]
tmp0=!randint 51, 99

val10=$[rint($(tmp0))]
tmp0=!randint 11, 49

val11=$[rint($(tmp0))]
tmp0=!randint 51, 99

val12=$[rint($(tmp0))]
tmp0=!randint 11, 49

val13=$[rint($(tmp0))]
tmp0=!randint 51, 99

val14=$[rint($(tmp0))]
val15=\(-\frac{$val8}{$val7}),\(-\frac{$val9}{$val10}),\(\frac{$val11}{$val12}),\(\frac{$val14}{$val13})
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
tmp0=!item $val16 of <,>

val17=$(tmp0)
tmp0=!item $val16 of croissant,décroissant

val18=$(tmp0)

!ifval $val16=2
val15=$(val15[4]),$(val15[3]),$(val15[2]),$(val15[1])
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 19;$val15
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 20
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 21
replytype4=dragfill
replyname4=Quatrième champ
replygood4=?analyze 22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres suivants dans l'ordre $val18.	<table class="wimscenter"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val17</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val17</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 <td>$val17</td>	 <td> 
!read oef/embed.phtml r4,$val6 
$()</td>	 </tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val19 isin $(val15[1]) and $val20 isin $(val15[2])) and ($val21 isin $(val15[3]) and $val22 isin $(val15[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,15,17,18,19,20,21,22
embedcnt=4
