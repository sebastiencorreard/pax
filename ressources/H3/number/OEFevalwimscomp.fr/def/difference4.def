!if $val13=0 
val9=$[rint(232407)]
val10=$[rint(232450)]
val11=$[rint(232469)]
val12=$[rint(232500)]
val13=$[$val9/$val11-$val10/$val12]
!endif
tmp0=!char 1 to -2 of \times10^{}

val14=$(tmp0)
tmp0=!char -1 of 10^{}

val15=$(tmp0)

!ifval e isin $val13
tmp0=!replace internal e by $val14 in $val13

val13=$(tmp0)$val15
!endif
tmp0=!texmath $val9/$val11

val16=$(tmp0)
tmp0=!texmath $val10/$val12

val17=$(tmp0)
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]
tmp0=!item $val18 of grand,petit

val19=$(tmp0)
val20=$val7 a calculé la différence entre \($val16) et \($val17) avec sa calculatrice. Voici le résultat :<div class="wimscenter">\($val16 - $val17 = $val13)</div> Quel est le plus $val19 de ces deux nombres &#63;

!ifval $val13>0
val21=\($val16),\($val17)
!else
val21=\($val17),\($val16)
!endif
tmp0=!item $val18 of $val21

val22=$(tmp0)
choicename1=
choicegood1=$val22
choicebad1=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

