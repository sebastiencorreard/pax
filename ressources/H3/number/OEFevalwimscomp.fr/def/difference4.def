val6=50x25x1
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 111111, 999999

val8=$[rint($(tmp0))]
tmp0=!randint $val8-50, $val8-25

val9=$[rint($(tmp0))]
tmp0=!randint $val8-24, $val8

val10=$[rint($(tmp0))]
tmp0=!randint $val8+1, $val8+25

val11=$[rint($(tmp0))]
tmp0=!randint $val8+26, $val8+50

val12=$[rint($(tmp0))]
