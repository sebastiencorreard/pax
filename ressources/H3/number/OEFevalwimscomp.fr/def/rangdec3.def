!set title=Ranger des nombres A3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
tmp0=!shuffle 2,3,4,5,6,1,7,8,9

val7=$(tmp0)
val8=$[$(val7[1])+$(val7[2])/100+$(val7[2])/1000]
val9=$[$(val7[1])+$(val7[2])/10+$(val7[2])/1000]
val10=$[$(val7[1])+$(val7[2])/100+$(val7[2])/10]
val11=$[$(val7[1])+$(val7[2])/1000]
val12=$val8,$val9,$val10,$val11
val13=$[min(min($(val12[1]),$(val12[2])),min($(val12[3]),$(val12[4])))]
val14=$[max(max($(val12[1]),$(val12[2])),max($(val12[3]),$(val12[4])))]
tmp0=!listcomplement $val13,$val14 in $val12

val15=$(tmp0)
val16=$[min($val15)]
val17=$[max($val15)]
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]
tmp0=!item $val18 of <,>

val19=$(tmp0)
tmp0=!item $val18 of croissant,décroissant

val20=$(tmp0)

!ifval $val18=2
val21=$val14,$val17,$val16,$val13
!else
val21=$val13,$val16,$val17,$val14
!endif
replytype1=dragfill
replyname1=Premier champ
replygood1=?analyze 22;$val21
replytype2=dragfill
replyname2=Deuxième champ
replygood2=?analyze 23
replytype3=dragfill
replyname3=Troisième champ
replygood3=?analyze 24
replytype4=dragfill
replyname4=Quatrième champ
replygood4=?analyze 25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres suivants dans l'ordre $val20.	<table class="wimscenter"><tr>	 <td> 
!read oef/embed.phtml r1,$val6 
$()</td>	 <td>$val19</td>	 <td> 
!read oef/embed.phtml r2,$val6 
$()</td>	 <td>$val19</td>	 <td> 
!read oef/embed.phtml r3,$val6 
$()</td>	 <td>$val19</td>	 <td> 
!read oef/embed.phtml r4,$val6 
$()</td>	 </tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val22 isin $(val21[1]) and $val23 isin $(val21[2])) and ($val24 isin $(val21[3]) and $val25 isin $(val21[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,19,20,21,22,23,24,25
embedcnt=4
