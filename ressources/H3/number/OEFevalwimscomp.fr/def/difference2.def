!set title=Comparaison et différence 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=50x25x1
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 1111, 99999

tmp1=!randint 1, 3

val8=$[$(tmp0)/10^$(tmp1)]
tmp0=!shuffle A,B,C,D,E,F

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of grand,petit

val13=$(tmp0)
val14=Quel est le plus $val13 de ces deux nombres &#63;
val15=\($val10-$val11=$val8)
val16=$val10,$val11,aucun des deux
tmp0=!item $val12 of $val16

val17=$(tmp0)
choicename1=
choicegood1=$val17
choicebad1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

