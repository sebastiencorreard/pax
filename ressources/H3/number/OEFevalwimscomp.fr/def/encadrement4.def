!set title=Encadrement 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=3
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11111, 99999

val6=$[rint($(tmp0))]
tmp0=!randint 1111, 9999

val7=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6/$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)

!ifval / notin $val8
val8=12485/4482
!endif
tmp0=!texmath $val8

val9=$(tmp0)
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of un dixième,un centième

val11=$(tmp0)
val12=$[10^(-$val10)]
val13=Donner un encadrement d'amplitude $val11 de \($val9).
replytype1=numexp
replyname1=Borne inférieure
replygood1=?analyze 14
replytype2=numexp
replyname2=Borne supérieure
replygood2=?analyze 15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13	<div class="wimscenter"> 
!read oef/embed.phtml r1,5 
$() 
!insmath < $val9 < 
$()  
!read oef/embed.phtml r2,5 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val14<=$val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=Condition sur la borne inférieure

!ifval $val15>=$val8
 condtest2=1
!else
 condtest2=0
!endif
condname2=Condition sur la borne supérieure

!ifval $val15-$val14=$val12 or $val14-$val15=$val12
 condtest3=1
!else
 condtest3=0
!endif
condname3=Amplitude d'$val11

!exit

:stat
vsavelist=8,9,11,12,13,14,15
embedcnt=2
