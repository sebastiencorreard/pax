!set title=Somme algébrique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

tmp1=!randitem +,-

tmp2=!randitem +,-

tmp3=!randitem +,-

tmp4=!randitem +,-

val6=$(tmp0),$(tmp1),$(tmp2),$(tmp3),$(tmp4)
tmp0=!randitem +,-

tmp1=!randitem +,-

tmp2=!randitem +,-

tmp3=!randitem +,-

val7=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
val8=$(val6[1])
!for val9 =2 to 5 
!if $(val7[$val9-1])=$(val6[$val9]) 
val8=$val8,+
!else
val8=$val8,-
!endif
!next
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

tmp3=!randint 1, 9

tmp4=!randint 1, 9

val10=$(tmp0),$(tmp1),$(tmp2),$(tmp3),$(tmp4)
val11=$(val6[1])$(val10[1])
!for val12 =2 to 5 
val11=$val11,$(val7[$val12-1])($(val6[$val12]) $(val10[$val12]))
!next
val13=$[$(val11[1])+$(val11[2])+$(val11[3])+$(val11[4])+$(val11[5])]
replytype1=raw
replyname1=
replygood1=$(val8[1])
replytype2=raw
replyname2=
replygood2=$(val8[2])
replytype3=raw
replyname3=
replygood3=$(val8[3])
replytype4=raw
replyname4=
replygood4=$(val8[4])
replytype5=raw
replyname5=
replygood5=$(val8[5])
replytype6=numeric
replyname6=
replygood6=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Donnez le résultat :</p>	<div class="wimscenter">	 
!for m_i=1 to 5 
$()( $(val6[$m_i]) $(val10[$m_i]) ) $(val7[$m_i]) 
!next
$() = <br>	(  
!read oef/embed.phtml r1,1 
$() $(val10[1]) ) + (  
!read oef/embed.phtml r2,1 
$() $(val10[2]) ) + (  
!read oef/embed.phtml r3,1 
$() $(val10[3]) ) +	(  
!read oef/embed.phtml r4,1 
$() $(val10[4]) ) + (  
!read oef/embed.phtml r5,1 
$() $(val10[5]) ) =  
!read oef/embed.phtml r6,3 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10
embedcnt=6
