!set title=Soustraction des relatifs 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

val6=$(tmp0)
tmp0=!randitem +,-

val7=$(tmp0)
!if $val7=+ 
val8=-
!else
val8=+
!endif
tmp0=!randint 2, 9

tmp1=!randint 4, 9

val9=$[rint($(tmp0)*10+$(tmp1))]
tmp0=!randint 97, 99

val10=$[rint($(tmp0))]
val11=$[$val6$val9-$val7$val10]
replytype1=raw
replyname1=
replygood1=$val6
replytype2=raw
replyname2=
replygood2=$val8
replytype3=numeric
replyname3=
replygood3=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Donnez le résultat de la soustraction :</p>	<div class="wimscenter">	 ( $val6 $val9 ) 
!insmath -
$() ( $val7 $val10 ) = (  
!read oef/embed.phtml r1,1 
$() $val9 ) + (  
!read oef/embed.phtml r2,1 
$() $val10 ) =  
!read oef/embed.phtml r3,4 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10
embedcnt=3
