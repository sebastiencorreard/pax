!set title=Signe division
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
val7=&#150;,+
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 19

val10=$[rint($(tmp0))]
tmp0=!randint 2, 19

val11=$[rint($(tmp0))]
val12=$[$(val6[$val8])$val10/$(val6[$val9])$val11]
val13=$[rint((3+sign($val12))/2)]
val14=$(val7[$val13])
replytype1=menu
replyname1=
replygood1=$val13;négatif,positif
replytype2=clickfill
replyname2=
replygood2=$val14;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Nous avons le calcul suivant :	<div class="wimscenter">	
!insmath \frac{$(val6[$val8])$val10}{$(val6[$val9])$val11}
$()	</div>	<ul><li>	Le résultat est  
!read oef/embed.phtml r1 
$()	</li><li>	Le signe du résultat est  
!read oef/embed.phtml r2 
$()	</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,10,11
embedcnt=2
