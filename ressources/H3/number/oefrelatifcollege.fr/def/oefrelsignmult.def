!set title=Signe multiplication
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
tmp0=!randitem 1,2

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$(tmp0)
val9=&#150;,+
tmp0=!randint 1, 49

val10=$[rint($(tmp0))]
tmp0=!randint 1, 49

val11=$[rint($(tmp0))]
!if $val10=$val11 
tmp0=!randint 1, 9

val11=$[rint($val10+$(tmp0))]
!endif
val12=\(times)
val13=$[$(val6[$val7])$val10*$(val6[$val8])$val11]
val14=$[rint((3+sign($val13))/2)]
tmp=!trim $(val9[$val14])
val15=!translate internal $	\
$ to ;; in $tmp
replytype1=menu
replyname1=
replygood1=$val14;négatif,positif
replytype2=clickfill
replyname2=
replygood2=$val15;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Nous avons le calcul suivant :</p>	<div class="wimscenter">	 ( $(val9[$val7]) $val10 ) $val12 ( $(val9[$val8]) $val11 )	</div>	<ul><li>	Le résultat est  
!read oef/embed.phtml r1 
$()	</li><li>	Le signe du résultat est  
!read oef/embed.phtml r2 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12
embedcnt=2
