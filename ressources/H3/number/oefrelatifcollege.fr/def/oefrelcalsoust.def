!set title=Différence de relatifs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
tmp0=!randitem 1,2

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$(tmp0)
val9=&#150;,+
tmp0=!randint 1, 49

val10=$[rint($(tmp0))]
tmp0=!randint 1, 49

val11=$[rint($(tmp0))]
!if $val10=$val11 
tmp0=!randint 1, 9

val11=$[rint($val10+$(tmp0))]
!endif
val12=&#150;
val13=$[$(val6[$val7])$val10-$(val6[$val8])$val11]
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Donner le résultat du calcul suivant :</p>	<div class="wimscenter">	 ( $(val9[$val7]) $val10 ) $val12 ( $(val9[$val8]) $val11 )	=	 
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12
embedcnt=1
