!set title=Soustraction des relatifs 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

val6=$(tmp0)
tmp0=!randitem +,-

val7=$(tmp0)
!if $val7=+ 
val8=-
!else
val8=+
!endif
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
!if $val9=$val10 
val10=$[rint($val9+1)]
!endif
tmp0=!randint 1, 7

tmp1=!randint 2, 9

val11=$[($(tmp0)*10+$(tmp1))/10^$val9]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val12=$[($(tmp0)*10+$(tmp1))/10^$val10]
val13=$[$val6$val11-$val7$val12]
replytype1=raw
replyname1=
replygood1=$val6
replytype2=raw
replyname2=
replygood2=$val8
replytype3=numeric
replyname3=
replygood3=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Donnez le résultat de la soustraction :</p>	<div class="wimscenter">	 ( $val6 $val11 ) 
!insmath -
$() ( $val7 $val12 ) = (  
!read oef/embed.phtml r1,1 
$() $val11 ) + (  
!read oef/embed.phtml r2,1 
$() $val12 ) =  
!read oef/embed.phtml r3,4 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,12
embedcnt=3
