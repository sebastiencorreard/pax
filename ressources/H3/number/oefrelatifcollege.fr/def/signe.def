!set title=Signe de nombreux produits
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
tmp0=!randitem 1,1,1,2,1,1

val7=$(tmp0)
val8=&#150;,+
tmp0=!randint 11, 49

val9=$[rint($(tmp0))]
tmp0=!randint 14, 49

val10=$[rint($(tmp0))]
val11=$[rint(floor($val10/2))]
val12=$[rint($val10/2)]
!if $val7=2 
val13=$[rint(2)]
!else
!if $val11=$val12 
val13=$[rint(2)]
!else
val13=$[rint(1)]
!endif
!endif
val14=$(val8[$val13])
replytype1=menu
replyname1=
replygood1=$val13;négatif,positif
replytype2=clickfill
replyname2=
replygood2=$val14;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Nous avons le calcul suivant :</p>	<div class="wimscenter">	 
!insmath ($(val8[$val7]) $val9 )^$val10
$()	</div>	<ul><li>	Le résultat est  
!read oef/embed.phtml r1 
$()	</li><li>	Le signe du résultat est  
!read oef/embed.phtml r2 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10
embedcnt=2
