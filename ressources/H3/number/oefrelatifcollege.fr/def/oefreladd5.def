!set title=Addition des relatifs 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

val6=$(tmp0)
tmp0=!randitem +,-

val7=$(tmp0)
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
!if $val8=$val9 
val9=$[rint($val8+1)]
!endif
tmp0=!randint 1, 7

tmp1=!randint 2, 9

val10=$[($(tmp0)*10+$(tmp1))/10^$val8]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val11=$[($(tmp0)*10+$(tmp1))/10^$val9]
val12=$[$val6$val10+$val7$val11]
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Donnez le résultat de l'addition :</p>	<div class="wimscenter">	 ( $val6 $val10 ) + ( $val7 $val11 ) =  
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

