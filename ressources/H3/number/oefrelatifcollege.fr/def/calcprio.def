!set title=Règles de priorité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni;Bernadette,Perrin-Riou
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=addition,multiplication
tmp0=!randitem 1,2

val7=$(tmp0)
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint -49, -19

val9=$[rint($(tmp0))]
tmp0=!randint -9, 9

val10=$[rint($(tmp0))]
!if $val7=1 
!if $val10<0 
val11=\(A=[$val8 + ($val9)] \times ($val10))
!else
val11=\(A=[$val8 + ($val9)] \times $val10)
!endif
val12=addition
!else
!if $val10<0 
val11=\(A=$val8 + ($val9) \times ($val10))
!else
val11=\(A=$val8 + ($val9) \times $val10)
!endif
val12=multiplication
!endif
!if $val7=1 
val13=$[rint($val8 + $val9)]
!else
val13=$[rint($val9 * $val10)]
!endif
!if $val7=1 
val14=$[rint($val13 * $val10)]
!else
val14=$[rint($val8 + $val13)]
!endif
oefsteps=c1	r1	r2 
nextstep=!nosubst c1	r1	r2 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=nonstop 
replyname1=
replygood1=$[$val13]
replytype2=numeric
replyoption2=nonstop 
replyname2=
replygood2=$[$val14]
choicename1=opération
choicegood1=$val12
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Tu dois calculer	<div class="wimscenter">$val11 </div>		
!if $m_step=1 
$()	Quelle opération fais-tu en premier ?  
!read oef/embed.phtml c1 
$() 
!endif
$()		
!if $m_step=2 
$()	Calcule en respectant les priorités:<div class="wimscenter">	
!if $val7=1 
$()	     
!if $val10<0 
$()A =  
!read oef/embed.phtml r1,3 
$() 
!insmath \times ($val10)
$() 
!else
$()	               A =  
!read oef/embed.phtml r1,3 
$() 
!insmath \times $val10
$() 
!endif
$() 
!endif
$()	
!if $val7=2 
$()A = 
!insmath $val8 +
$()  
!read oef/embed.phtml reply 1, 3 
$() 
!endif
$()	</div> 
!endif
$()		
!if $m_step=3 
$()	Calcule en respectant les priorités:	<div class="wimscenter">	
!if $val7=1 
$()
!if $val10<0 
$()
!insmath A = $val13 \times ($val10)
$()  
!else
$()	 
!insmath A = $val13 \times $val10
$()  
!endif
$() 
!else
$()	 
!if $val13<0 
$()
!insmath A = $val8 + ($val13)
$() 
!else
$()	 
!insmath A = $val8 + $val13
$() 
!endif
$() 
!endif
$()	</div>	<div class="wimscenter">	A =  
!read oef/embed.phtml r2,3 
$()	</div> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11,13
embedcnt=5
