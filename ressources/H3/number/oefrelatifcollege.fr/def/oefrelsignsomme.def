!set title=Signe d'une somme algébrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
tmp0=!randitem 1,2

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$(tmp0)
tmp0=!randitem 1,2

val9=$(tmp0)
val10=&#150;,+,&#177;
val11=$val6
tmp0=!randint 1, 29

val12=$[rint($(tmp0))]
tmp0=!randint 1, 29

val13=$[rint($(tmp0))]
tmp0=!randint 1, 19

val14=$[rint($(tmp0))]
tmp0=!randitem 1,2

val15=$(tmp0)
tmp0=!randitem 1,2

val16=$(tmp0)
val17=$[$(val6[$val7])$val12$(val11[$val15])$(val6[$val8])$val13$(val11[$val16])$(val6[$val9])$val14]
val18=$[rint((3+sign($val17))/2)]
!if $val17=0 
val18=$[rint(3)]
!endif
tmp=!trim $(val10[$val18])
val19=!translate internal $	\
$ to ;; in $tmp
val20=$val10
replytype1=menu
replyname1=
replygood1=$val18;négatif,positif,positif et négatif
replytype2=clickfill
replyname2=
replygood2=$val19;$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Nous avons le calcul suivant :</p>	<div class="wimscenter">	 ( $(val10[$val7]) $val12 ) $(val10[$val15]) ( $(val10[$val8]) $val13 ) $(val10[$val16]) ( $(val10[$val9]) $val14 )	</div>	<ul><li>	Le résultat est  
!read oef/embed.phtml r1 
$()	</li><li>	Le signe du résultat est  
!read oef/embed.phtml r2 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,12,13,14,15,16
embedcnt=2
