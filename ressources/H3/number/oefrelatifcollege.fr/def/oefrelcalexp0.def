!set title=Expression numérique avec des petits relatifs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-,+
tmp0=!randitem 1,2

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$(tmp0)
tmp0=!randitem 1,2

val9=$(tmp0)
val10=&#150;,+,\(times),&#177;
val11=-,+,*
tmp0=!randint 1, 7

val12=$[rint($(tmp0))]
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

val14=$[rint($(tmp0))]
tmp0=!shuffle 2

val15=$(tmp0)
val16=$(val15[1])+1
val17=$(val15[2])+1
val18=$[$(val6[$val7])$val12$(val11[$val16])$(val6[$val8])$val13$(val11[$val17])$(val6[$val9])$val14]
replytype1=numeric
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>Donner le résultat du calcul suivant :</p>	<div class="wimscenter">	 ( $(val10[$val7]) $val12 ) $(val10[$val16]) ( $(val10[$val8]) $val13 ) $(val10[$val17]) ( $(val10[$val9]) $val14 )	=	 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,12,13,14,16,17
embedcnt=1
