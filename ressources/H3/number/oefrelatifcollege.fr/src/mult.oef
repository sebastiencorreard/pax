\title{Multiplication de plusieurs nbres relatifs}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{1000000}
\text{sign=-,+}
\text{s1=randint(1,2)}
\text{s2=randint(1,2)}
\text{s3=randint(1,2)}
\text{s4=randint(1,2)}
\text{ecrsg=&#150;,+}

\integer{nb1=randint(1..12)}
\integer{nb2=randint(1..12)}
\integer{nb3=randint(1..12)}
\integer{nb4=randint(1..12)}

\text{op1=\(times)}
\integer{rs=\sign[\s1]\nb1*\sign[\s2]\nb2*\sign[\s3]\nb3*\sign[\s4]\nb4}
\if{\rs<0}{\text{signe=\sign[1]}}{\text{signe=\sign[2]}}
\integer{res=abs(\rs)}

\statement{<p>Donner le résultat du calcul suivant :</p>
<div class="wimscenter">
 ( \ecrsg[\s1] \nb1 ) \op1 ( \ecrsg[\s2] \nb2 ) \op1 ( \ecrsg[\s3] \nb3 ) \op1 ( \ecrsg[\s4] \nb4 )
= \embed{r2} \embed{r1,5}
</div>
}
\answer{}{\res}{type=numeric}
\answer{}{\signe;\sign}{type=dragfill}
