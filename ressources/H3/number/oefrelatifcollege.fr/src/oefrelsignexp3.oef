\title{Signe d'une expression numérique 3}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\text{sign=-,+}
\text{ecrsg=&#150;,+}
\integer{s1=randint(1,2)}
\integer{s2=randint(1,2)}
\integer{s3=randint(1,2)}

\integer{nb1=randint(1..19)}
\integer{nb2=randint(2..19)}
\integer{nb3=randint(1..19)}

\real{res=(\sign[\s1]\nb1 + \sign[\s2]\nb2) / \sign[\s3]\nb3}
\integer{rep=(3+sign(\res))/2}
\text{rep2=\ecrsg[\rep]}

\statement{

Nous avons le calcul suivant à faire :
<div class="wimscenter">
\(\frac{(\sign[\s1]\nb1) + (\sign[\s2]\nb2)}{\sign[\s3]\nb3})
</div>
<ul><li>
Le résultat est \embed{r1}
</li><li>
Le signe du résultat est \embed{r2}
</li></ul>}

\answer{}{\rep;négatif,positif}{type=menu}
\answer{}{\rep2;\ecrsg}{type=clickfill}
