\title{Signe de nombreux produits}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\text{sign=-,+}
\text{s1=random(1,1,1,2,1,1)}
\text{ecrsg=&#150;,+}

\integer{nb1=randint(11..49)}
\integer{ex1=randint(14..49)}

\integer{a=floor(\ex1/2)}
\integer{b=\ex1/2}


\if{\s1=2}{\integer{rep=2}}
  {\if{\a=\b}{\integer{rep=2}}
                  {\integer{rep=1}}}

\text{rep2=\ecrsg[\rep]}

\statement{<p>Nous avons le calcul suivant :</p>
<div class="wimscenter">
 \((\ecrsg[\s1] \nb1 )^\ex1)
</div>
<ul><li>
Le résultat est \embed{r1}
</li><li>
Le signe du résultat est \embed{r2}
</li></ul>
}
\answer{}{\rep;négatif,positif}{type=menu}
\answer{}{\rep2;\ecrsg}{type=clickfill}
