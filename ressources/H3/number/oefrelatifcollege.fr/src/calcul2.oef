\title{Calcul et parenthèses}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ch=random(1,2)}
\integer{a=randint(-20..20)}
\integer{b=randint(-49..-19)}
\integer{c=randint(-9..9)}

\if{\c<0}{\text{enonc1=\(A=[\a + (\b)] \times (\c))}}
{\text{enonc1=\(A=[\a + (\b)] \times \c)}}

\if{\c<0}{\text{enonc2=\(A=\a + (\b) \times (\c))}}
{\text{enonc2=\(A=\a + (\b) \times \c)}}

\integer{sol1=(\a + \b)* \c}
\integer{sol2=\a + \b * \c}

\statement{<p>Calcule en respectant les priorités:</p>
<ul><li>\enonc1 = \embed{r1,3}</li>
<li>\enonc2 = \embed{r2,3}</li>
</ul>
}

\answer{}{\sol1}{type=numeric}
\answer{}{\sol2}{type=numeric}
