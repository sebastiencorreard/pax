\title{Règles de priorité}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni;Bernadette,Perrin-Riou}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\text{\listechoix=addition,multiplication}
\text{ch=random(1,2)}
\integer{a=randint(-20..20)}
\integer{b=randint(-49..-19)}
\integer{c=randint(-9..9)}

\if{\ch=1}{\if{\c<0}{\text{enonc=\(A=[\a + (\b)] \times (\c))}}
{\text{enonc=\(A=[\a + (\b)] \times \c)}}
\text{\sol=addition}}
{\if{\c<0}{\text{enonc=\(A=\a + (\b) \times (\c))}}
{\text{enonc=\(A=\a + (\b) \times \c)}}
\text{\sol=multiplication}}

\if{\ch=1}{\integer{sol1=\a + \b}}
{\integer{sol1=\b * \c}}

\if{\ch=1}{\integer{sol2=\sol1 * \c}}
{\integer{sol2=\a + \sol1}}

\steps{c1
r1
r2}

\statement{
Tu dois calculer
<div class="wimscenter">\enonc </div>

\if{\step=1}{
Quelle opération fais-tu en premier ? \embed{c1}}

\if{\step=2}{
Calcule en respectant les priorités:<div class="wimscenter">
\if{\ch=1}{
     \if{\c<0}{A = \embed{r1,3} \(\times (\c))}
              {A = \embed{r1,3} \(\times \c)}}
\if{\ch=2}{A = \(\a +) \embed{reply 1, 3}}
</div>}

\if{\step=3}{
Calcule en respectant les priorités:
<div class="wimscenter">
\if{\ch=1}{\if{\c<0}{\(A = \sol1 \times (\c)) }
{\(A = \sol1 \times \c) }}
{\if{\sol1<0}{\(A = \a + (\sol1))}
{\(A = \a + \sol1)}}
</div>
<div class="wimscenter">
A = \embed{r2,3}
</div>}
}

\choice{opération}{\sol}{\listechoix}
\answer{}{\sol1}{type=numeric}{option=nonstop}
\answer{}{\sol2}{type=numeric}{option=nonstop}
