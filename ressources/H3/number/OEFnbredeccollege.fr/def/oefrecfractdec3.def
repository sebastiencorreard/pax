!set title=Reconnaître une écriture décimale 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r,r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le carré représente l'unité, c'est-à-dire 1.
val7=La partie coloriée correspond au nombre,	  Utiliser la fraction la plus simple.,	  en utilisant l'écriture d'un nombre décimal	
val8=Utiliser la virgule comme séparateur décimal    et éviter les zéros inutiles.
val9=en utilisant une somme de fractions décimales
val10=$[rint(15)]
val11=$[rint(25)]
val12=$[rint(25)]
val13=square
val14=fsquare
val15=black
val16=red
val17=
!for val18 =0 to 9 
!for val19 =0 to 9 
val20=$[rint($val11+$val19*$val10)]
val21=$[rint($val12+$val18*$val10)]
val22=$val13 $val20,$val21,$val10,$val15
val17=$val17	     $val22
!next
!next
tmp0=!randint 1, 9

val23=$[rint($(tmp0))]
tmp0=!randint 1, 9

val24=$[rint($(tmp0))]
val25=0,$val23$val24
val26=
!for val18 =1 to $val23 
!for val19 =0 to 9 
val20=$[rint($val11+$val19*$val10)]
val21=$[rint($val12+($val18-1)*$val10)]
val22=$val14 $val20,$val21,$val10,$val16
val26=$val26	     $val22
!next
!next
val18=$[rint($val23)]
!for val19 =1 to $val24 
val20=$[rint($val11+($val19-1)*$val10)]
val21=$[rint($val12+$val18*$val10)]
val22=$val14 $val20,$val21,$val10,$val16
val26=$val26	     $val22
!next
!readproc oef/draw.phtml 200,200 \
linewidth 2	$val26	$val17	 
tmp0=$ins_url
val27=$(tmp0)
replytype1=case
replyname1=
replygood1=$val23
replytype2=case
replyname2=
replygood2=$val24
replytype3=case
replyname3=
replygood3=$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">		<img src="$val27" alt=""><br>	$val6	</div><div class="medium_size txt_col">	$(val7[1]) :	<ul><li>	$val9		 
!read oef/special.phtml mathmlinput [\frac{reply1}{10} + \frac{reply2}{100}],3	reply1	reply2 
$()		</li><li>		$(val7[3]):  
!read oef/embed.phtml r3,5 
$()		<div class="wims_instruction">	$val8	</div>	</li></ul>	</div></div>	
$()
!exit

