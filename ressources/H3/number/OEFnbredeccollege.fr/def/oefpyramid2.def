!read oef/embed.phtml r5,5 
$()</td>	<td></td><td></td><td></td><td></td></tr>	<tr><td></td><td></td><td colspan="4" style="background-color:#FFFF00"> 
!read oef/embed.phtml r4,5 
$()</td><td colspan="4" style="background-color:#FFFF00">$(val13[6])</td>	<td colspan="4" style="background-color:#FFFF00">$(val13[7])</td><td></td><td></td></tr>	<tr><td colspan="4" style="background-color:#FFFF00"> 
!read oef/embed.phtml r1,5 
$()</td><td colspan="4" style="background-color:#FFFF00"> 
!read oef/embed.phtml r2,5 
$()</td>	<td colspan="4" style="background-color:#FFFF00">$(val13[3])</td><td colspan="4" style="background-color:#FFFF00"> 
!read oef/embed.phtml r3,5 
$()</td></tr>	</table>	<p>$val6</p>	<div class="wims_instruction">	$val7	</div>	
$()
!exit

