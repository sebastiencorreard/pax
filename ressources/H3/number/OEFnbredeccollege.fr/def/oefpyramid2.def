!set title=Pyramide 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000000

ansorder=r,r,r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver les nombres manquants.
val7=Si nécessaire, vous utiliserez le point comme séparateur décimal.
val8=Le nombre du pavé du dessus est égal à la somme des nombres des deux pavés placés dessous.

!ifval $val2=
val2= 1
!endif
tmp0=!record $val2 of src/generateur

val9=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
val13=
!for val14 =1 to $val12 
tmp0=!randint 0, $(val10[1])

tmp1=!randint 0, $(val10[2])

tmp2=!randint 1, $(val10[3])

val15=$[($(tmp0)$(tmp1)$(tmp2))/$(val11[1])]
tmp0=!append item $val15 to $val13

val13=$(tmp0)
!next
!for val14 =1 to 4-$val12 
tmp0=!randint 0, $(val10[4])

tmp1=!randint 0, $(val10[5])

tmp2=!randint 1, $(val10[6])

val15=$[($(tmp0)$(tmp1)$(tmp2))/$(val11[2])]
tmp0=!append item $val15 to $val13

val13=$(tmp0)
!next
tmp0=!shuffle $val13

val13=$(tmp0)
val15=$[$(val13[1])+$(val13[2])]
val16=$[$(val13[2])+$(val13[3])]
val17=$[$(val13[3])+$(val13[4])]
val18=$[$val15+$val16]
val19=$[$val16+$val17]
val20=$[$val18+$val19]
val13=$(val13[1]),$(val13[2]),$(val13[3]),$(val13[4]),$val15,$val16,$val17,$val18,$val19,$val20
replytype1=numeric
replyname1=
replygood1=$[$(val13[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val13[2])]
replytype3=numeric
replyname3=
replygood3=$[$(val13[4])]
replytype4=numeric
replyname4=
replygood4=$[$(val13[5])]
replytype5=numeric
replyname5=
replygood5=$[$(val13[9])]
replytype6=numeric
replyname6=
replygood6=$[$(val13[10])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val8</p>	<table class="wimscenter wimsborder">	<tr><td></td><td></td><td></td><td></td><td></td><td></td><td colspan="4" style="background-color:#FFFF00"> 
