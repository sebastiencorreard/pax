!set title=Addition et soustraction 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000000

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Choisir la bonne opération pour passer d'un nombre à l'autre
val7=-100,-10,-1,-0.1,-0.01,-0.001,+0.001,+0.01,+0.1,+1,+10,+100
val8=\(\longrightarrow\)
tmp0=!randint 1, 999

tmp1=!randint 1, 3

val9=$[$(tmp0)/10^$(tmp1)]
tmp0=!randint 4-log10($val9), 12

val10=$[rint($(tmp0))]
val11=$(val7[$val10])
val12=$[$val9+$(val7[$val10])]
tmp0=!randint 4-log10($val12), 12

val13=$[rint($(tmp0))]
val14=$(val7[$val13])
val15=$[$val12+$(val7[$val13])]
tmp0=!randint 4-log10($val15), 12

val16=$[rint($(tmp0))]
val17=$(val7[$val16])
val18=$[$val15+$(val7[$val16])]
tmp0=!randint 4-log10($val18), 12

val19=$[rint($(tmp0))]
val20=$(val7[$val19])
val21=$[$val18+$(val7[$val19])]
replytype1=clickfill
replyname1=
replygood1=$val11;$val7
replytype2=clickfill
replyname2=
replygood2=$val14;$val7
replytype3=clickfill
replyname3=
replygood3=$val17;$val7
replytype4=clickfill
replyname4=
replygood4=$val20;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<table class="wimscenter wimsborder">	<tr>	<td></td>	<td> 
!read oef/embed.phtml r1,55x50 
$()</td>	<td></td>	<td> 
!read oef/embed.phtml r2 
$()</td>	<td></td>	<td> 
!read oef/embed.phtml r3 
$()</td>	<td></td>	<td> 
!read oef/embed.phtml r4 
$()</td>	<td></td>	</tr><tr>	<td>$val9</td>	<td>$val8</td>	<td>$val12</td>	<td>$val8</td>	<td>$val15</td>	<td>$val8</td>	<td>$val18</td>	<td>$val8</td>	<td>$val21</td></tr>	</table>	
$()
!exit

