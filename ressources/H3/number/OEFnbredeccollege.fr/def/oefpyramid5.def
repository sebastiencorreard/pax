!endif

val6=Trouver les nombres manquants.
val7=Si nécessaire, vous utiliserez le point comme séparateur décimal.
val8=Le nombre du pavé du dessus est égal à la somme des nombres des deux pavés placés dessous.
tmp0=!randint 1, 9

val9=$(tmp0)
val10=0.1,0.01,0.001
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!randitem 0.9,0.09,0.009

val11=$(tmp0)
val12=$val9,$(val10[1]),$(val10[2]),$val11
tmp0=!shuffle $val12

val12=$(tmp0)
val13=$[$(val12[1])+$(val12[2])]
val14=$[$(val12[2])+$(val12[3])]
val15=$[$(val12[3])+$(val12[4])]
val16=$[$val13+$val14]
val9=$[$val14+$val15]
val10=$[$val16+$val9]
val12=$(val12[1]),$(val12[2]),$(val12[3]),$(val12[4]),$val13,$val14,$val15,$val16,$val9,$val10
replytype1=numeric
replyname1=
replygood1=$[$(val12[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val12[3])]
replytype3=numeric
replyname3=
replygood3=$[$(val12[4])]
replytype4=numeric
replyname4=
replygood4=$[$(val12[5])]
replytype5=numeric
replyname5=
replygood5=$[$(val12[6])]
replytype6=numeric
replyname6=
replygood6=$[$(val12[8])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

