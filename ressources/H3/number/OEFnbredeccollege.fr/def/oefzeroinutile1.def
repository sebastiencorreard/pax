!set title=Zéros inutiles 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Priscilla, Baechler
email=baepriscilla@yahoo.fr
language=fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le nombre,se réécrit sans les zéros inutiles
tmp0=!random 1, 999999

val7=$[$(tmp0)/1000]
val8=0,00,000,0000
tmp=!nonempty items $val8

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items $val8

tmp0=!randitem $tmp
val10=$(tmp0)
replytype1=case
replyname1=
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val6[1]) $val9$val7$val10 $(val6[2])  :  
!read oef/embed.phtml r1,10 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10
embedcnt=1
