    \text{v=wims(append item \a to \v)}
 }
\text{v=shuffle(\v)}
\real{a=\v[1]+\v[2]}
\real{b=\v[2]+\v[3]}
\real{c=\v[3]+\v[4]}
\real{d=\a+\b}
\real{e=\b+\c}
\real{f=\d+\e}
