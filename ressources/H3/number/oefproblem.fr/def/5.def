!set title=Petit problème 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items girl,boy

tmp0=!randitem $tmp
val6=$(tmp0)
val7=ils,elles
!readproc slib/lang/fname ,$val6,2 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!randint 4, 9

val9=$(tmp0)
val10=$[rint($val9+1)]
val11=$[rint($val9+$val10)]
val12=$[rint($val10^2-$val9^2)]
val13=Les réponses doivent être séparées par une virgule
val14=La somme de deux nombres entiers est égale à $val11.	  La différence de leurs carrés est aussi égale à $val12.	  Quels sont ces deux nombres ?	
replytype1=set
replyname1=
replygood1=$val9,$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <label for="reply1">$val14</label>	  <div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	  <div class="wims_instruction">$val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14
embedcnt=1
