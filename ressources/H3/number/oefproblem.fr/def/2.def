!set title=Petit problème 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items girl,boy

tmp0=!randitem $tmp
val6=$(tmp0)
val7=ils,elles
!readproc slib/lang/fname ,$val6,2 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!randint 4, 8

val9=$[rint($(tmp0))]
tmp0=!randint 8, 10

val10=$(tmp0)
tmp0=!randint 2, 4

val11=$(tmp0)
tmp0=!randint 1, 3

val12=$[rint($val10-$(tmp0))]
val13=$[rint(($val10-$val12)*$val9-$val11)]
tmp=!nonempty items girl,boy

tmp0=!randitem $tmp
val6=$(tmp0)
!readproc slib/lang/fname \lang,$val6,2 
tmp0=$slib_out
val8=$(tmp0)
val14=Les réponses doivent être séparées par une virgule
val15=XXXXX et YYYYY choisissent un même nombre. XXXXX le multiplie par $val10	puis soustrait $val11 au résultat obtenu. YYYYY le multiplie par $val12	et ajoute $val13 au résultat obtenu. IIIII obtiennent tous les deux le même résultat.	Quel nombre XXXXX et YYYYY avaient-iiiii choisi au départ ?	
val7=ils,elles
val16=Ils,Elles

!ifval $val6 issametext boy 
val7=$(val7[1])
!else
val7=$(val7[2])
!endif

!ifval $val6 issametext boy 
val16=$(val16[1])
!else
val16=$(val16[2])
!endif
tmp0=!replace internal XXXXX by $(val8[1]) in $val15

val15=$(tmp0)
tmp0=!replace internal YYYYY by $(val8[2]) in $val15

val15=$(tmp0)
tmp0=!replace internal IIIII by $val16 in $val15

val15=$(tmp0)
tmp0=!replace internal iiiii by $val7 in $val15

val15=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<label for="reply1">$val15</label>	  <div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=1
