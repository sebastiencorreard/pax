!set title=Petit problème 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items girl,boy

tmp0=!randitem $tmp
val6=$(tmp0)
val7=ils,elles
!readproc slib/lang/fname ,$val6,2 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!randint 10, 13

val9=$(tmp0)
tmp0=!randint 2*$val9+3, 2*$val9+20

val10=$(tmp0)
val11=$[rint($val10-2*$val9)]
val12=Les réponses doivent être séparées par une virgule
val13=Aujourd'hui, XXXXX a $val9 ans et YYYYY $val10 ans. Dans	  combien d'années l'âge de YYYYY sera-t-il le double de celui de XXXXX&nbsp;
tmp0=!replace internal XXXXX by $(val8[1]) in $val13

val13=$(tmp0)
tmp0=!replace internal YYYYY by $(val8[2]) in $val13

val13=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <label for="reply1">$val13?</label>	  <div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13
embedcnt=1
