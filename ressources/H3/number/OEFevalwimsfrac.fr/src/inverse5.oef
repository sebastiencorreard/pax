\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100000}
 \title{Inverse 5}
 \text{sg=randitem(,-)}
 \real{v=randint(5..24)+randint(1..9)/10}
 \text{rep=\sg 1/\v}
 \text{enonce=\sg\v}
 \text{A=randitem(A,B,C,D,E,F)}
\statement{
Quel est l'inverse du nombre suivant :
<div class="wimscenter"> \(\A = \enonce).</div>}
\answer{inverse de \(\A)}{\rep}{type=numexp2}
