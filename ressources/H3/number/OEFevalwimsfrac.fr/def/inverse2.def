!set title=Inverse 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=5 to 25

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!shuffle -,

val7=$(tmp0)
val8=$(val7[1])$(val6[1])/$(val7[2])$(val6[2])
tmp=!translate ";': to $     $ in 1/($val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp0=!texmath $val8

val8=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val10=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=inverse de \($val10)
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est l'inverse du nombre suivant :	<div class="wimscenter"> 
!insmath $val10 = $val8 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=0
