!set title=Calcul 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
tmp=!translate ";': to $     $ in  (($(val6[1]))/($(val6[6])))/(($(val6[3]))/($(val6[2])))/($(val6[4])/$(val6[5]))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val7=$(tmp0)
val8=\frac{$(val6[1])}{$(val6[6])} : \frac{$(val6[3])}{$(val6[2])} : \frac{$(val6[4])}{$(val6[5])}
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val9=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=réponse
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter"> 
!insmath $val9 = $val8 = 
$()  
!read oef/embed.phtml r1,10 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

