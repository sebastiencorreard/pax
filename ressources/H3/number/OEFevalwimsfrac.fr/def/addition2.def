tmp0=!randint 1, 15

val6=$[rint($(tmp0))]
tmp0=!randint 1, 15

val7=$[rint($(tmp0))]
val8=$[rint(gcd($val6,$val7))]
val6=$[rint($val6/$val8)]
val7=$[rint($val7/$val8)]
!if $val6=1 or $val7=1 
val6=$[rint(2)]
val7=$[rint(3)]
!endif
tmp0=!values $val6*v,$val7*v for v=1 to 10

val9=$(tmp0)
tmp0=!values v for v=6 to 30

val10=$(tmp0)
tmp0=!listcomplement $val9 in $val10

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val11=+
tmp=!nonempty items 7,9

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
val13=$[rint($(val9[1]))]
val14=$[rint($val6*$val12)]
val15=$[rint($(val9[2]))]
val16=$[rint($val7*$val12)]
val17=\frac{$val13}{$val14} $val11 \frac{$val15}{$val16}
tmp=!translate ";': to $     $ in (($val13)/($val14))$val11(($val15)/($val16))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val19=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=réponse
