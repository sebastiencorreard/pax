tmp0=!randint 1, 15

val6=$[rint($(tmp0))]
tmp0=!randint 1, 15

val7=$[rint($(tmp0))]
val8=$[rint(gcd($val6,$val7))]
val6=$[rint($val6/$val8)]
val7=$[rint($val7/$val8)]
!if $val6=1 or $val7=1 
val6=$[rint(2)]
val7=$[rint(3)]
!endif
tmp0=!values $val6*v,$val7*v for v=1 to 10

val9=$(tmp0)
tmp0=!values v for v=6 to 30

val10=$(tmp0)
