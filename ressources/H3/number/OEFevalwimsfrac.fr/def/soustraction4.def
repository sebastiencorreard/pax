tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
val14=$[-$(val9[1])]
val15=$[rint($val6*$val13)]
val16=$[-$(val9[2])]
val17=$[rint($val7*$val13)]
val18=\frac{$val14}{$val15} $val11 \frac{$val16}{$val17}
tmp=!translate ";': to $     $ in (($val14)/($val15))$val11(($val16)/($val17))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val20=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
