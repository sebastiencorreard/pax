tmp=!nonempty items $(val8[1])/$(val8[2]) $val7 $(val8[3])/$val10,$(val8[1])/$val10 $val7 $(val8[3])/$(val8[2])

tmp0=!randitem $tmp
val11=$(tmp0)

!ifval $val6=
tmp0=!texmath $val11

val6=$(tmp0)
!endif
tmp=!translate ";': to $     $ in $val11

