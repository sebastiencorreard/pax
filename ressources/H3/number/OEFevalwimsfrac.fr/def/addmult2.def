val6=
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!values v for v=15 to 49

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
val9=$(val8[1])/$(val8[2]) - (-$(val8[3]))/$(val8[2])
val6=\frac{$(val8[1])}{$(val8[2])} - \frac{-$(val8[3])}{$(val8[2])}

!ifval $val6=
tmp0=!texmath $val9

val6=$(tmp0)
!endif
tmp=!translate ";': to $     $ in $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val11=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

