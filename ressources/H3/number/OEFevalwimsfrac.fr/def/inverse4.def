!set title=Inverse 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp=!nonempty items 3,6,7,9,11,13,14,15,17,18,19

tmp1=!randitem $tmp
val6=$(tmp0)*$(tmp1)
val7=$val6
tmp=!translate ";': to $     $ in 1/($val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
tmp0=!texmath $val7

val7=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val9=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=inverse de \($val9)
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est l'inverse du nombre suivant :	<div class="wimscenter"> 
!insmath $val9 = $val7 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
