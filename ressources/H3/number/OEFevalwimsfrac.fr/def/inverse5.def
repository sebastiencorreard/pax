!set title=Inverse 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items ,-

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randint 5, 24

tmp1=!randint 1, 9

val7=$[$(tmp0)+$(tmp1)/10]
val8=$val6 1/$val7
val9=$val6$val7
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val10=$(tmp0)
replytype1=numexp2

replyname1=inverse de \($val10)
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est l'inverse du nombre suivant :	<div class="wimscenter"> 
!insmath $val10 = $val9
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10
embedcnt=0
