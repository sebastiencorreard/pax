!set title=Calcul 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val7=$(tmp0)
tmp=!translate ";': to $     $ in  (($(val6[1]))^2/($(val6[6])))$val7(($(val6[3]))/($(val6[2]))) 

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
val9=\frac{$(val6[1])}{$(val6[6])}^2$val7\frac{$(val6[3])}{$(val6[2])}
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val10=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=réponse
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter"> 
!insmath $val10 = $val9 = 
$()  
!read oef/embed.phtml r1,10 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10
embedcnt=1
