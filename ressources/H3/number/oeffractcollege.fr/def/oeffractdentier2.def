!set title=Multiplier un entier par une fraction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni; Christophe, Caillet
email=jluc.donadoni@laposte.net
language=fr
computeanswer=no
precision=100000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2,3,4,5,6,7,8,9
tmp0=!itemcnt $val6

val7=$[rint($(tmp0))]
val8=1/2,3/2,5/2,7/2,	1/4,3/4,5/4,9/4,1/5,2/5,3/5,4/5,6/5,7/5	1/8,3/8,5/8,7/8,9/8
tmp=!nonempty items $val8

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!translate internal / to , in $val9

val10=$(tmp0)
val11=$[rint($(val10[1]))]
val12=$[rint($(val10[2]))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0))]
val15=$[rint($val13*$val12+$val14)]
val16=$[$val15*$val11/$val12]
replytype1=numeric
replyoption1=comma 
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Donner le résultat du calcul suivant :	<div class="wimscenter larger">	
!insmath $val15 \times \frac{$val11}{$val12} 
$() =  
!read oef/embed.phtml r1,5 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,15
embedcnt=1
