\language{fr}
\author{Jean-Luc, Donadoni; Christophe, Caillet}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{100000}

\title{Multiplier un entier par une fraction 2}

\text{mulist=2,3,4,5,6,7,8,9}
\integer{mucnt=items(\mulist)}
\text{data=1/2,3/2,5/2,7/2,
1/4,3/4,5/4,9/4,1/5,2/5,3/5,4/5,6/5,7/5
1/8,3/8,5/8,7/8,9/8}
\text{fraction=randitem(\data)}
\text{f1=wims(translate internal / to , in \fraction)}
\integer{num=\f1[1]}
\integer{den=\f1[2]}
\integer{mu=randitem(\mulist)}
\integer{r=randint(1..\den-1)}
\integer{entier=\mu*\den+\r}
\real{rep=\entier*\num/\den}

\statement{Donner le résultat du calcul suivant :
<div class="wimscenter larger">
\(\entier \times \frac{\num}{\den} \) = \embed{r1,5}
</div>
}

\answer{}{\rep}{type=numeric}{option=comma}
