\title{Calculer un quotient }

\text{data=1/2,3/2,5/2,7/2,
1/4,3/4,5/4,7/4,9/4,11/4,13/4,15/4,17/4,19/4,
1/5,2/5,3/5,4/5,6/5,7/5,9/5,11/5,12/5,13/5,14/5
1/8,3/8,5/8,7/8,9/8,10/8,11/8,13/8,14/8,15/8}
\text{fraction=randitem(\data)}
\text{f1=wims(translate internal / to , in \fraction)}
\integer{num=\f1[1]}
\integer{den=\f1[2]}
\real{rep=\num/\den}

\statement{Calculer le quotient :

<div class="wimscenter larger">
\(\frac{\num}{\den} \) =\embed{r1,5}
</div>}

\answer{}{\rep}{type=numeric}
