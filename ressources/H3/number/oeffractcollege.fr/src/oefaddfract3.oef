\language{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}
\title{Additionner deux fractions 3}

\text{al=1,2,3,1,2,3,1,2,1,2}
\text{p1=2,3,5,7,11,13,17,19,23}
\text{p2=2,3,5,7,11}
\text{p3=2,3,5}
\text{p4=2,3}
\integer{al=randomitem(\al)}
\if{\al=1}{\text{den=randomitem(item(3..7,\p1))}}
\if{\al=2}{\text{den=randomitem(item(1..4,\p1)),randomitem(item(1..3,\p3))}}
\if{\al=3}{\text{den=randomitem(item(1..4,\p1)),randomitem(item(1..2,\p3)),randomitem(item(1..2,\p4))}}
\integer{den1=\den[1]}
\for{i=2 to \al}{\integer{den1=\den1*\den[\i]}}

\integer{num3=randint(4..\den1*2-3)}

\integer{dv=gcd(\num3,\den1)}
\while{\dv<>1}{\integer{num3=\num3+1}
\integer{dv=gcd(\num3,\den1)}}

\integer{m=randint(2..130/\den1)}
\if{\m>9}{\integer{m=randint(2..9)}}

\integer{num2=randint(1..\num3-1)}
\integer{num1=\num3 - \num2}
\integer{num4=\num2*\m}
\integer{den4=\den1*\m}

\statement{Calcule la somme ci-dessous :
\special{mathmlinput [\frac{\num1}{\den1} +\frac{\num4}{\den4} =
\frac{\num1}{\den1} + \frac{reply1 \times reply2}{reply5 \times reply6}
=
\frac{\num1}{\den1} + \frac{reply3}{reply7}=\frac{reply4}{reply8}], 3,noanswer
reply1
reply2
reply3
reply4
reply5
reply6
reply7
reply8
}

}
\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}
\answer{}{\num2}{type=numeric}
\answer{}{\num3}{type=numeric}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=numeric}
\answer{}{\den1}{type=numeric}
\answer{}{\den1}{type=numeric}
\condition{simplification du numérateur}{\num4=\rep1*\rep2}
\condition{simplification du dénominateur}{\den4=\rep3*\rep4}
