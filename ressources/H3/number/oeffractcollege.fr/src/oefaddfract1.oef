\language{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}
\title{Additionner deux fractions 1}

\text{al=1,2,3,4,1,2,3,1,2,1,2,1}
\text{p1=2,3,5,7,11,13,17,19,23}
\text{p2=2,3,5,7,11}
\text{p3=2,3,5}
\text{p4=2,3}
\integer{al=randomitem(\al)}
\if{\al=1}{\text{den=randomitem(item(3..9,\p1))}}
\if{\al=2}{\text{den=randomitem(item(1..5,\p1)),randomitem(item(1..3,\p2))}}
\if{\al=3}{\text{den=randomitem(item(1..4,\p1)),randomitem(item(1..2,\p2)),randomitem(item(1..2,\p3))}}
\if{\al=4}{\text{den=randomitem(item(1..3,\p1)),randomitem(item(1..2,\p2)),randomitem(item(1..2,\p3)),randomitem(item(1..1,\p4))}}
\integer{den1=\den[1]}
\for{i=2 to \al}{\integer{den1=\den1*\den[\i]}}

\integer{num3=randint(4..\den1*2-1)}

\integer{dv=gcd(\num3,\den1)}
\while{\dv<>1}{\integer{num3=\num3+1}
\integer{dv=gcd(\num3,\den1)}}

\integer{num2=randint(1..\num3-1)}
\integer{num1=\num3 - \num2}

\statement{Calcule la somme ci-dessous :
<div class="wimscenter larger">
\special{mathmlinput [\frac{\num1}{\den1}+\frac{\num2}{\den1} = \frac{reply1 + reply2}{reply4}
=
\frac{reply3}{reply5}], 3
reply1
reply2
reply3
reply4
reply5}
</div>
}
\answer{}{\num1}{type=numeric}
\answer{}{\num2}{type=numeric}
\answer{}{\num3}{type=numeric}
\answer{}{\den1}{type=numeric}
\answer{}{\den1}{type=numeric}
