\language{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}
\title{Additionner deux fractions 4}

\text{al=2,3,4}
\text{p1=2,3,5,7,11,13,17,19,23}
\text{p2=2,3,5,7,11}
\text{p3=2,3,5}
\text{p4=2,3}
\integer{al=randomitem(\al)}
\if{\al=2}{\text{den=randomitem(item(1..4,\p2)),randomitem(item(2..5,\p1))}}
\if{\al=3}{\text{den=randomitem(item(1..3,\p2)),randomitem(item(2..4,\p1)),randomitem(item(1..2,\p3))}}
\if{\al=4}{\text{den=randomitem(item(1..2,\p2)),randomitem(item(2..4,\p1)),randomitem(item(1..2,\p3)),randomitem(item(1..1,\p4))}}

\integer{b=randint(1..2)}
\integer{den2=\den[2]}
\if{\al>2 and \b=2}{\integer{den2=\den2*\den[1]}}

\integer{den1=\den[1]}
\for{i=2 to \al}{\integer{den1=\den1*\den[\i]}}

\integer{num1=randint(1..\den1+10)}

\integer{dv=gcd(\num1,\den1)}
\while{\dv<>1}{\integer{num1=\num1+1}
\integer{dv=gcd(\num1,\den1)}}

\integer{num2=randint(1..\den2-1)}

\integer{dv=gcd(\num2,\den2)}
\while{\dv<>1}{\integer{num2=\num2+1}
\integer{dv=gcd(\num2,\den2)}}
\integer{num4=\num2*\den1/\den2}
\integer{num3=\num1+\num4}
\integer{dv3=gcd(\num3,\den1)}

\while{\dv3<>1}{\integer{num2=\num2+1}
\integer{num4=\num2*\den1/\den2}
\integer{num3=\num1+\num4}
\integer{dv3=gcd(\num3,\den1)}}

\statement{Calcule la somme ci-dessous :
<div class="wimscenter larger">
\special{mathmlinput [\frac{\num1}{\den1} +\frac{\num2}{\den2} =
\frac{\num1}{\den1} + \frac{reply1 \times reply2}{reply5 \times reply6}
=
\frac{\num1}{\den1} + \frac{reply3}{reply7}=\frac{reply4}{reply8}], 3,noanswer
reply1
reply2
reply3
reply4
reply5
reply6
reply7
reply8
}
</div>
}

\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}
\answer{}{\num4}{type=numeric}
\answer{}{\num3}{type=numeric}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=numeric}
\answer{}{\den1}{type=numeric}
\answer{}{\den1}{type=numeric}
\condition{changement numérateur}{\num4=\rep1*\rep2}
\condition{changement dénominateur}{\den1=\rep3*\rep4}
