val7=Durée en min,Distance en km
tmp=!trim Un piéton, marche,La promenade	Un vélo, roule,L'excursion	Une voiture, roule,Le voyage	Un cheval, galope,La chevauchée
val8=!translate internal $	\
$ to ;; in $tmp
val9=à une vitesse moyenne de, a duré
val10=La distance parcourue est
tmp=!trim $(val8[1;1]), $(val8[1;2]),2, 7, 5, 59, $(val8[1;3])	$(val8[2;1]), $(val8[2;2]), 15, 30, 15, 120, $(val8[2;3])	$(val8[3;1]), $(val8[3;2]), 60, 130, 70, 200, $(val8[3;3])	$(val8[4;1]), $(val8[4;2]), 30, 100, 15, 90, $(val8[4;3])
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!randitem $(val11[$val12;5]), $(val11[$val12;6])

val13=$[rint($(tmp0))]
val14=$[rint(floor($val13/60))]
val15=$[rint($val13-60*$val14)]

!ifval $val14=0
val16= 
!else
val16=$val14 h 
!endif
tmp0=!randitem $(val11[$val12;3]), $(val11[$val12;4])

val17=$[rint($(tmp0))]
val18=$[$val13*$val17/100]
val19=$[$val17*6/10]
val20=$[rint(60)]
replytype1=numeric
replyname1=
replygood1=$[$val20]
replytype2=numeric
replyname2=
replygood2=$[$val13]
replytype3=numeric
replyname3=
replygood3=$[$val18]
replytype4=numeric
replyname4=
replygood4=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

