!set title=Tableau de proportion 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Remplir le tableau&nbsp;
val7=Compléter le tableau de proportionnalité suivant&nbsp;
val8=Le coefficient de proportionnalité est&nbsp;
tmp0=!randint 2, 9

tmp1=!randitem 3/2,1/2,5/2

tmp2=!randitem $(tmp0), $(tmp1)

t_=!rawmath $(tmp2)
val9=!exec pari print($t_)
tmp0=!randint 3, 6

val10=$[rint($(tmp0))]
tmp0=!randint 4, 9

val11=$[rint($(tmp0))]

!ifval $val10=$val11
val11=$[rint( $val11+1)]
!endif
t_=!rawmath $val10*$val9
val12=!exec pari print($t_)
t_=!rawmath $val11*$val9
val13=!exec pari print($t_)
val14=$val9
tmp0=!randitem 1,2,3,4

val15=$(tmp0)

!ifval $val15=1
val16= $val10
!else
val16=$val12
!endif

!ifval $val15=2
val16= $val11
!endif

!ifval $val15=4
val16= $val13
!endif
replytype1=numeric
replyname1=
replygood1=$[$val16]
replytype2=numeric
replyname2=
replygood2=$[$val14]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<label for="reply1">$val7:</label>	<table class="wimsborder wimscenter">	<tr><td>	
!if $val15=1 
$() 
!read oef/embed.phtml reply 1,5 
$() 
!else
$() $val10 
!endif
$()</td><td>
!if $val15=2 
$() 
!read oef/embed.phtml reply 1,5 
$() 
!else
$() $val11 
!endif
$()</td></tr>	<tr><td>
!if $val15=3 
$() 
!read oef/embed.phtml reply 1,5 
$() 
!else
$() $val12 
!endif
$()</td><td>	
!if $val15=4 
$() 
!read oef/embed.phtml reply 1,5 
$() 
!else
$() $val13 
!endif
$()</td>	</tr>	</table>	<div><label for="reply2">$val8:</label>  
!read oef/embed.phtml reply 2,6 
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11,12,13,15
embedcnt=5
