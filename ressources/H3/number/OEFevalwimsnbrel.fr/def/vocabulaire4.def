!set title=Vocabulaire 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 10

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
val8=$[rint($(val6[1])+$(val6[2]))]

!ifval $val7=1
val6=$(val6[1]),$(val6[2]),$val8
!else
val6=$val8,$(val6[2]),$(val6[1])
!endif
tmp0=!item $val7 of la somme,la différence

val9=$(tmp0)
val10=Quelle est $val9 de $(val6[1]) et $(val6[2])
val11=$(val6[3])
replytype1=numexp
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10 ?	<div>	<b>Votre réponse</b>:  
!read oef/embed.phtml r1,8 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=1
