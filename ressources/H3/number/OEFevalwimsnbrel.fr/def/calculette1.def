!set title=Calculette 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v/10 for v=11 to 99

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val7=$(tmp0)
val8=(-$(val6[1]))*(-$(val6[2]))+$(val6[3])
val9=-$(val6[1])\times(-$(val6[2]))+$(val6[3])
val10=$[$val8]
replytype1=numexp
replyname1=$val7
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Utiliser la calculatrice pour trouver le résultat du calcul suivant :	<div class="wimscenter">
!insmath $val7 = $val9
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
