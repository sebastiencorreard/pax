!set title=Priorités opératoires 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 12

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
!if $val7=1 
val8=+
val9=L'addition de $(val6[1]) et $(val6[2])
!else
val8=-
val9=La soustraction de $(val6[2]) à $(val6[1])
!endif
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
!if $val10=1 
val11=+
val12=L'addition de $(val6[2]) et $(val6[3])
!else
val11=-
val12=La soustraction de $(val6[3]) à $(val6[2])
!endif
val13=$(val6[1]) $val8 $(val6[2]) $val11 $(val6[3])
val14=Peu importe,$val9,$val12
tmp0=!item $val7 of $val14

val15=$(tmp0)
choicename1=
choicegood1=$val15
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici un calcul :	<div class="wimscenter">
!insmath $val13
$()</div>	Quelle opération devez-vous obligatoirement effectuer en premier ?
$()
!exit

