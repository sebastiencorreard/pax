!set title=Vocabulaire 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 15

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
val8=$[rint($(val6[1])*$(val6[2]))]

!ifval $val7=1
val6=$(val6[1]),$(val6[2]),$val8
!else
val6=$val8,$(val6[2]),$(val6[1])
!endif
val9=*,/
val10=\times, \div 
val11=$(val6[1])$(val10[$val7])$(val6[2]) = $(val6[3])
val12=On dit que $(val6[3]) est 
val13=de $(val6[1]) par $(val6[2])
val14=le produit,le quotient,la somme,la différence,un terme,un facteur
tmp0=!item $val7 of $val14

val15=$(tmp0)
replytype1=dragfill
replyname1=
replygood1=$val15;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">
!insmath $val11
$()</div>	Complétez la phrase suivante :	<div class="wimscenter">	$val12  
!read oef/embed.phtml r1 
$() $val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,13
embedcnt=1
