!set title=Calculer un produit 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=-1,-1
tmp0=!shuffle 2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp0=!item 1 to 2 of $val7

val7=$(tmp0)
val8=$[rint($(val6[1])*$(val7[1]))]
val9=($val8)
val10=$val8
tmp0=!itemcnt $val7

val11=$[rint($(tmp0))]
!for val12 =2 to $val11 
val8=$[rint($(val6[$val12])*$(val7[$val12]))]

!ifval $val8>0
val8=+$val8
!endif
val9=$val9\times($val8)
val10=$[rint($val8*$val10)]
!next
replytype1=numexp
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer le produit suivant :	<div class="wimscenter">
!insmath $val9 = 
$()  
!read oef/embed.phtml r1,8 
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=1
