!set title=Suivre un programme de calcul 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v/10 for v=11 to 99

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]
val8=Le double de la somme de $(val6[1]) et $(val6[2])	La somme du double de $(val6[1]) et $(val6[2])	Le double de la différence entre $(val6[1]) et $(val6[2])	La différence entre le double de $(val6[1]) et $(val6[2])
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$val7
val11=\(2\times($(val6[1])+$(val6[2]))),\(2\times$(val6[1])+$(val6[2])),\(2\times($(val6[1])-$(val6[2]))),\(2\times$(val6[1])-$(val6[2])),\($(val6[1])+2\times$(val6[2]))
tmp0=!itemcnt $val11

val12=$[rint($(tmp0))]
tmp0=!item $(val10[1]) of $val11

val13=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!positionof item $val13 in $val11

val10=$(tmp0)
replytype1=radio
replyname1=
replygood1=$val10;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	A quel calcul correspond la phrase suivante :	<div class="wimscenter">$val9</div>	<blockquote>	 <ul>	 
!for m_k=1 to $val12 
$()	 <li> 
!read oef/embed.phtml r1,\k 
$()</li>	 
!next
$()	</ul>	</blockquote>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12
embedcnt=1
