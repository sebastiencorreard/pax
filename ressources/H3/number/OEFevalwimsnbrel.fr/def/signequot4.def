!set title=Signe d'un quotient 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in +,-	-,-

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!values v for v=2 to 9

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=$(val6[1])$(val7[1])
val9=$[rint($(val6[2])$(val7[2]))]
val10=$[rint($val8*$val9)]
val11=$[rint($(val7[1])*$(val7[2]))]
val12=\(+),\(-)
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
!if $val13=1 

!ifval $val10>0
val14=$(val12[1])
!else
val14=$(val12[2])
!endif
!else

!ifval $val8>0
val14=$(val12[1])
!else
val14=$(val12[2])
!endif
!endif
replytype1=dragfill
replyname1=Réponse
replygood1=$val14;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter l'égalité suivante :	 <table class="wimscenter wimsnoborder">	
!if $val13=1 
$()	  <tr>	   <td> 
!read oef/embed.phtml r1,20x20x1 
$() 
!insmath $val11
$() </td>	   <td rowspan="3"> 
!insmath =
$() </td>	   <td rowspan="3">
!insmath $val9
$()</td>	  </tr>	  <tr><td><hr></td></tr>	  <tr>	   <td>
!insmath $val8
$()</td>	  </tr>	 
!else
$() 	  <tr>	   <td>
!insmath $val10
$() </td>	   <td rowspan="3"> 
!insmath =
$() </td>	   <td rowspan="3">
!insmath $val9
$()</td>	  </tr>	  <tr><td><hr></td></tr>	  <tr>	   <td> 
!read oef/embed.phtml r1,15x20x1 
$() 
!insmath $(val7[1])
$()</td>	  </tr>	 
!endif
$()	</table>
$()
!exit

