!set title=Priorités opératoires 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 12

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
!if $val7=1 
val8=\times
val9=La multiplication
!else
val8=\div
val9=La division
!endif
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
!if $val10=1 
val11=+
val12=L'addition
!else
val11=-
val12=La soustraction
!endif
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=$(val6[1]) $val8 ($(val6[2]) $val11 $(val6[3]))	($(val6[2]) $val11 $(val6[3])) $val8 $(val6[1])	$(val6[1]) $val8 $(val6[2]) $val11 $(val6[3])
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$val12,$val12,$val9,Peu importe
tmp0=!item $val13 of $val16

val17=$(tmp0)
choicename1=
choicegood1=$val17
choicebad1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici un calcul :	<div class="wimscenter">
!insmath $val15
$()</div>	Quelle opération devez-vous obligatoirement effectuer en premier ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=0
