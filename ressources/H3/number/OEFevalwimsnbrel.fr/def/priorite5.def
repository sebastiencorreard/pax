!set title=Priorités opératoires 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 12

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!shuffle +,-

val7=$(tmp0)
tmp=!nonempty items 1,B,C,D,E,F

tmp0=!randitem $tmp
val8=$(tmp0)
val9=$(val6[1]) - ($(val6[2]) $(val7[1]) $(val6[3]))
choicename1=
choicegood1=$val8=$(val6[1]) - $(val6[2]) $(val7[2]) $(val6[3])
choicebad1=$val8=$(val6[1]) - $(val6[2]) $(val7[1]) $(val6[3]),$val8=$(val6[1]) + $(val6[2]) $(val7[1]) $(val6[3]),$val8=$(val6[1]) + $(val6[2]) $(val7[2]) $(val6[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici une expression numérique:	<div class="wimscenter">
!insmath $val8 = $val9
$()</div>	Parmi les égalités suivantes, laquelle est vraie ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=0
