!set title=Notion d'inverse 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,4,8,5,10

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
val7=L'inverse du nombre $val6 est
val8=1,2
val9=$[1/$val6]
val10=\($val9),\(\frac{1}{$val6}),\(-$val6),\(-\frac{1}{$val6}),\($val6-1)
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]
tmp0=!item $(val8[1]) of $val10

val12=$(tmp0)
tmp0=!item $(val8[2]) of $val10

val13=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!positionof item $val12 in $val10

tmp1=!positionof item $val13 in $val10

val8=$(tmp0),$(tmp1)
tmp0=!nonempty item $val8

val8=$(tmp0)
replytype1=checkbox
replyname1=
replygood1=$val8;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est la fin de la phrase suivante :	<div class="wimscenter" style="font-style:italic">$val7...</div>	<blockquote>	 <ul>	 
!for m_k=1 to $val11 
$()	 <li> 
!read oef/embed.phtml r1,\k 
$()</li>	 
!next
$()	</ul>	</blockquote>	<div class="wims_instruction">Si plusieurs réponses conviennent, les cocher toutes.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11
embedcnt=1
