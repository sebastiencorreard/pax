!set title=Signe d'un quotient 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in -,-,-	,,-	-,,-	-,-,	,-,-

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!values v for v=2 to 99

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=\(+),\(-)
tmp0=!positionof item - in $val6

val9=$(tmp0)
tmp0=!itemcnt $val9

val9=$[rint($(tmp0))]
val9=$[$val9/2]

!ifval . isin $val9
val9=$(val8[2])
!else
val9=$(val8[1])
!endif
replytype1=dragfill
replyname1=Réponse
replygood1=$val9;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter l'égalité suivante :	<table class="wimscenter wimsborder">	 <tr>	  
!if - isin $(val6[1]) 
$()<td rowspan="3"> 
!insmath $(val6[1])
$()</td> 
!endif
$()	  <td>
!insmath $(val6[2])$(val7[1])
$() </td>	  <td rowspan="3"> 
!insmath =
$() </td>	  <td> 
!read oef/embed.phtml r1,20x20x1 
$()
!insmath $(val7[1])
$()</td>	 </tr>	 <tr><td><hr></td><td><hr></td></tr>	 <tr>	  <td>
!insmath $(val6[3])$(val7[2])
$()</td>	  <td>
!insmath $(val7[2])
$()</td>	 </tr>	</table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
