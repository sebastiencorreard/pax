!set title=Signe d'un produit 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1000, 10000

val6=$[rint($(tmp0))]
tmp0=!randint 100, 999

val7=$[rint($(tmp0))]
val8=Positif,Négatif
val9=$[$val6/2]

!ifval . isin $val9
val10=$(val8[2])
!else
val10=$(val8[1])
!endif
choicename1=Réponse
choicegood1=$val10
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le signe d'un produit de plusieurs facteurs non nuls contenant	$val6 facteurs négatifs et $val7 facteurs positifs ?
$()
!exit

