!set title=Vocabulaire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 15

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
val8=+,*
val9=+, \times 
val10=$[rint($(val6[1])$(val8[$val7])$(val6[2]))]
val11=$(val6[1])$(val9[$val7])$(val6[2]) = $val10
tmp=!nonempty items $(val6[1]),$(val6[2])

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
val13=On dit que $val12 est 

!ifval $val7=1
val14=de la somme de $(val6[1]) et $(val6[2])
!else
val14=du produit de $(val6[1]) par $(val6[2])
!endif
val15=un terme,un facteur,le produit,le quotient,la somme,la différence
tmp0=!item $val7 of $val15

val16=$(tmp0)
replytype1=dragfill
replyname1=
replygood1=$val16;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">
!insmath $val11
$()</div>	Complétez la phrase suivante :	<div class="wimscenter">	$val13  
!read oef/embed.phtml r1 
$() $val14</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

