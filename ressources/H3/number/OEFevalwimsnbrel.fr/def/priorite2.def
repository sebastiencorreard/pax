!set title=Priorités opératoires 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 12

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
!if $val7=1 
val8=+
val9=L'addition
!else
val8=-
val9=La soustraction
!endif
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
val11=\frac{$(val6[1])}{$(val6[2])$val8$(val6[3])}	$(val6[1]) \div($(val6[2]) $val8 $(val6[3]))	$(val6[1]) \div $(val6[2]) $val8 $(val6[3])	\frac{$(val6[1])}{$(val6[2])} $val8 $(val6[3])
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=$val9,$val9,La division,La division,Peu importe
tmp0=!item $val10 of $val13

val14=$(tmp0)
choicename1=
choicegood1=$val14
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Voici un calcul :	<div class="wimscenter">
!insmath $val12
$()</div>	Quelle opération devez-vous obligatoirement effectuer en premier ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=0
