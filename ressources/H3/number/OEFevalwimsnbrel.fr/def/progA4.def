!set title=Ecrire un programme de calcul 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v/10 for v=11 to 99

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp0=!item $val7 of $(val6[1])-$(val6[2])\times $(val6[3]),($(val6[1])-$(val6[2]))\times $(val6[3])

val8=$(tmp0)
val9=$val7
val10=La différence entre $(val6[1]) et le produit de $(val6[2]) par $(val6[3]),Le produit de la différence entre $(val6[1]) et $(val6[2]) par $(val6[3]), La somme entre $(val6[1]) et le produit de $(val6[2]) par $(val6[3]),Le quotient de la différence entre $(val6[1]) et $(val6[2]) par $(val6[3])
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]
tmp0=!item $(val9[1]) of $val10

val12=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!positionof item $val12 in $val10

val9=$(tmp0)
val8=\($val8)
replytype1=radio
replyname1=
replygood1=$val9;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	A quelle phrase correspond le calcul suivant :	<div class="wimscenter">$val8</div>	<blockquote>	<ul> 
!for m_k=1 to $val11 
$()	 <li> 
!read oef/embed.phtml r1,\k 
$()</li>	 
!next
$()	</ul>	</blockquote>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,11
embedcnt=1
