!set title=Signe d'un quotient 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in +,-	-,-

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
val8=$(val6[1])$val7
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
val10=$(val6[2])$val9
tmp0=!shuffle $val8,$val10

val11=$(tmp0)
val12=$[rint($val8*$val10)]
val13=\(+),\(-)

!ifval $val10>0
val14=$(val13[1])
!else
val14=$(val13[2])
!endif
replytype1=dragfill
replyname1=Réponse
replygood1=$val14;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter l'égalité suivante :	<div class="wimscenter">	
!insmath \frac{$val12}{$val8} = 
$() 
!read oef/embed.phtml r1,20x20x1 
$() 
!insmath $val9
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,12
embedcnt=1
