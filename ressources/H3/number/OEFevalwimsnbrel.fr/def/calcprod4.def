!set title=Calculer un produit 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=G.,Bayle;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 5

val6=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in -1,-1,1,1	-1,-1,-1,1

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0),1
tmp0=!shuffle 3,4,6,7,8,9

val8=$(tmp0)
tmp0=!item 1 to 2 of $val8

val8=$(tmp0)
val9=2,5,$val8,-1
tmp0=!values v for v=1 to $val6

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!item $val8 of $val9

val9=$(tmp0)
tmp0=!item $val8 of $val7

val7=$(tmp0)
val8=$[rint($(val7[1])*$(val9[1]))]
val10=($val8)
val11=$val8
tmp0=!itemcnt $val9

val6=$[rint($(tmp0))]
!for val12 =2 to $val6 
val8=$[rint($(val7[$val12])*$(val9[$val12]))]

!ifval $val8>0
val8=+$val8
!endif
val10=$val10\times($val8)
val11=$[rint($val8*$val11)]
!next
replytype1=numexp
replyname1=Réponse
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer le produit suivant :	<div class="wimscenter">
!insmath $val10 = 
$()  
!read oef/embed.phtml r1,8 
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=1
