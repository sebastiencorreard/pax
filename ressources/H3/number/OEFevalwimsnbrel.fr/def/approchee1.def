!set title=Valeur Approchée 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 3,7,9,11,13,17

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 1, $val6-1

tmp1=!randint 10, 20

val7=$[rint($(tmp0)+$val6*$(tmp1))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
val6=$[rint($val8*$val6)]
val7=$[rint($val8*$val7)]
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val9=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val10=$(tmp0)
val11=$[$val7/$val6]
val12=$val10 a utilisé sa calculatrice pour calculer le quotient de $val7 par $val6 et a trouvé : <div class="wimscenter"> \($val9 = $val7 \div $val6 = $val11)</div>
val13=$[rint(1)]
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
val15=à l'unité,au dixième,au centième,au millième
tmp=!nonempty items $val13

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
tmp0=!item $val13 of rint,floor,ceil

val16=$(tmp0)
val17=$[$val16($val11*10^($val14-1))/10^($val14-1)]
tmp=!nonempty items Quel est l'arrondi par défaut,Quelle est la troncature

tmp0=!randitem $tmp
val18=Quel est l'arrondi	$(tmp0)	Quel est l'arrondi par excés
tmp=!translate internal $	$ to ; in $val18

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12	<p>	$val19 $(val15[$val14]) de $val9 ?</p>	<div>	<b>Votre réponse</b> :  
!read oef/embed.phtml r1,8 
$()	</div>
$()
!exit

