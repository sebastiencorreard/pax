\title{Signe d'un quotient 4}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\text{s=shuffle(\s)}
\text{l=wims(values v for v=2 to 9)}
\text{l=shuffle(\l)}
\text{A=\s[1]\l[1]}
\integer{B=\s[2]\l[2]}
\integer{p=\A*\B}
\integer{P=\l[1]*\l[2]}

\text{bad=\(+),\(-)}
\integer{ch=randint(1..2)}

\if{\ch=1}{
 \text{good=\p>0?\bad[1]:\bad[2]}
}{
 \text{good=\A>0?\bad[1]:\bad[2]}
}

\statement{
Compléter l'égalité suivante :
 <table class="wimscenter wimsnoborder">
\if{\ch=1}{
  <tr>
   <td>\embed{r1,20x20x1} \(\P) </td>
   <td rowspan="3"> \(=) </td>
   <td rowspan="3">\(\B)</td>
  </tr>
  <tr><td><hr></td></tr>
  <tr>
   <td>\(\A)</td>
  </tr>
}{
  <tr>
   <td>\(\p) </td>
   <td rowspan="3"> \(=) </td>
   <td rowspan="3">\(\B)</td>
  </tr>
  <tr><td><hr></td></tr>
  <tr>
   <td>\embed{r1,15x20x1} \(\l[1])</td>
  </tr>
}
</table>}

\answer{Réponse}{\good;\bad}{type=dragfill}
