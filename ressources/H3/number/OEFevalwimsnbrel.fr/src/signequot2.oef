\title{Signe d'un quotient 2}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\text{s=shuffle(\s)}
\text{l=wims(values v for v=2 to 9)}
\text{l=shuffle(\l)}
\text{A=\s[1]\l[1]}
\integer{B=\s[2]\l[2]}
\integer{p=\A*\B}
\integer{P=\l[1]*\l[2]}

\text{bad=\(+),\(-)}
\integer{ch=randint(1..2)}

\if{\ch=1}{
 \text{good=\p>0?\bad[1]:\bad[2]}
}{
 \text{good=\A>0?\bad[1]:\bad[2]}
}
\text{br=()}
\text{bl=wims(char 1 of \br)}
\text{br=wims(char 2 of \br)}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
\if{\ch=1}{
 \(\bl ) \embed{r1,20x20x1} \(\P \br \div (\A) = \B)
}{
 \((\p)\div \bl) \embed{r1,20x20x1} \(\l[1] \br = \B)
}

</div>}
\answer{Réponse}{\good;\bad}{type=dragfill}
