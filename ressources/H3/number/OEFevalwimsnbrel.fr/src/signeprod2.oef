\title{Signe d'un produit 2}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\text{s=shuffle(\s)}
\text{l=wims(values v for v=2 to 99)}
\text{l=shuffle(\l)}
\text{A=\s[1]\l[1]}
\text{B=\s[2]\l[2]}
\integer{p=\A*\B}
\text{bad=\(+),\(-)}
\integer{ch=randint(1..2)}

\if{\ch=1}{
 \text{good=\A>0?\bad[1]:\bad[2]}
}{
 \text{good=\B>0?\bad[1]:\bad[2]}
}

\text{br=()}
\text{bl=wims(char 1 of \br)}
\text{br=wims(char 2 of \br)}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
\if{\ch=1}{
 \(\bl ) \embed{r1,20x20x1} \(\l[1] \br \times (\B) = \p)
}{
 \((\A)\times \bl) \embed{r1,20x20x1} \(\l[2] \br = \p)
}

</div>}
\answer{Réponse}{\good;\bad}{type=dragfill}
