\title{Priorités opératoires 5}

\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\text{v=wims(values v for v=2 to 12)}
\text{v=shuffle(\v)}

\text{sg=shuffle(+,-)}
\text{A=randitem(1,B,C,D,E,F)}
\text{calcul=\v[1] - (\v[2] \sg[1] \v[3])}

\statement{
Voici une expression numérique:
<div class="wimscenter">\(\A = \calcul)</div>
Parmi les égalités suivantes, laquelle est vraie ?}
\choice{}{\A=\v[1] - \v[2] \sg[2] \v[3]}{\A=\v[1] - \v[2] \sg[1] \v[3],\A=\v[1] + \v[2] \sg[1] \v[3],\A=\v[1] + \v[2] \sg[2] \v[3]}
