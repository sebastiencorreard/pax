\title{Signe d'un produit 5}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nb1=randint(1000..10000)}
\integer{nb2=randint(100..999)}
\text{bad=Positif,Négatif}
\real{t=\nb1/2}
\text{good=. isin \t?\bad[2]:\bad[1]}

\statement{
Quel est le signe d'un produit de plusieurs facteurs non nuls contenant
\nb1 facteurs négatifs et \nb2 facteurs positifs ?}

\choice{Réponse}{\good}{\bad}
