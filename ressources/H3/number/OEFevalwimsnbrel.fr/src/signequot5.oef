\title{Signe d'un quotient 5}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(-,-,-
,,-
-,,-
-,-,
,-,-)}
\text{l=wims(values v for v=2 to 99)}
\text{l=shuffle(\l)}

\text{bad=\(+),\(-)}
\text{good=wims(positionof item - in \s)}
\integer{good=items(\good)}
\real{\good=\good/2}
\text{good=. isin \good?\bad[2]:\bad[1]}

\statement{
Compléter l'égalité suivante :
<table class="wimscenter wimsborder">
 <tr>
  \if{- isin \s[1]}{<td rowspan="3"> \(\s[1])</td>}
  <td>\(\s[2]\l[1]) </td>
  <td rowspan="3"> \(=) </td>
  <td>\embed{r1,20x20x1}\(\l[1])</td>
 </tr>
 <tr><td><hr></td><td><hr></td></tr>
 <tr>
  <td>\(\s[3]\l[2])</td>
  <td>\(\l[2])</td>
 </tr>
</table>}

\answer{Réponse}{\good;\bad}{type=dragfill}
