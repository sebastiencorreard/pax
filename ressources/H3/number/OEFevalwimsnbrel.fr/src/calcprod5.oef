\title{Calculer un produit 5}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nbf=randint(3..5)}
\text{s=randrow(-1,-1,1,1
-1,-1,-1,1)}
\text{s=shuffle(\s)}
\text{tmp=wims(values v for v=2 to 99)}
\text{l=shuffle(\tmp)}

\text{enonce=0}
\integer{p=0}
\for{k=2 to \nbf}{
 \integer{tmp=\s[\k-1]*\l[\k]}
 \text{tmp=\tmp>0?+\tmp}
 \text{tmp=(\tmp)}
 \text{enonce=wims(append item \tmp to \enonce)}
}
\text{enonce=shuffle(\enonce)}
\text{enonce=wims(replace internal , by \times in \enonce)}

\statement{
Calculer le produit suivant :
<div class="wimscenter">\(\enonce = ) \embed{r1,8} </div>}

\answer{Réponse}{\p}{type=numexp}
