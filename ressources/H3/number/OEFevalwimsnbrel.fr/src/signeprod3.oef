\title{Signe d'un produit 3}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nb=randint(3..10)}
\text{l=wims(values v for v=1 to 99)}
\text{l=shuffle(\l)}
\integer{nbs=randint(1..\nb-1)}
\text{s=wims(values -1 for v=1 to \nbs)}
\text{s2=wims(values 1 for v=\nbs+1 to \nb)}
\text{s=shuffle(\s,\s2)}

\text{bad=Positif,Négatif}
\real{t=\nbs/2}
\text{good=. isin \t?\bad[2]:\bad[1]}

\integer{tmp=\s[1]*\l[1]}
\text{enonce=(\tmp)}
\for{k=2 to \nb}{
 \integer{tmp=\s[\k]*\l[\k]}
 \text{tmp=\tmp>0?+\tmp}
 \text{enonce=\enonce\times(\tmp)}
}

\statement{
Quel est le signe de ce produit ?
<div class="wimscenter"> \(\enonce) </div>}

\choice{Réponse}{\good}{\bad}
