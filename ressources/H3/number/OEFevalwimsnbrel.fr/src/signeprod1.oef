\title{Signe d'un produit 1}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\integer{a=randint(2..50)}
\text{A=\s[1]\a}
\integer{b=randint(51..99)}
\text{B=\s[2]\b}
\text{l=shuffle(\A,\B)}
\integer{p=\a*\b}
\text{bad=\(\ +\ ),\(\ -\ )}
\text{good=\A*\B>0?\bad[1]:\bad[2]}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
\((\l[1])\times(\l[2]) = )\embed{r1,20x20x1} \(\p)
</div>}
\answer{Réponse}{\good;\bad}{type=dragfill}
