\title{Calculer un produit 3}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\text{s=shuffle(\s)}
\text{l=wims(values v for v=2 to 9)}
\text{l=shuffle(\l)}
\text{A=\s[1]\l[1]}
\text{B=\s[2]\l[2]}
\integer{p=\A*\B}
\text{p=\p>0?+\p}
\integer{ch=randint(1..2)}
\text{rep=\ch=1?\A:\B}
\text{br=()}
\text{bl=wims(char 1 of \br)}
\text{br=wims(char 2 of \br)}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
\if{\ch=1}{
 \(\bl) \embed{r1,5} \(\br \times (\B) = \p)
}{
 \((\A)\times \bl) \embed{r1,5} \(\br = \p)
}

</div>}
\answer{Réponse}{\rep}{type=numeric}
