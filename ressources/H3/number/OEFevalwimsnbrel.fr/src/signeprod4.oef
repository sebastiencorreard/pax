\title{Signe d'un produit 4}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\integer{nb=randint(3..6)}
\text{l=wims(values v for v=2 to 23)}
\text{l=shuffle(\l)}
\integer{nbs=randint(1..\nb-1)}
\text{s=wims(values -1 for v=1 to \nbs)}
\text{s2=wims(values 1 for v=\nbs+1 to \nb)}
\text{s=shuffle(\s,\s2)}

\text{bad=\(\ +\ ),\(\ -\ )}
\real{t=\nbs/2}
\text{good=. isin \t?\bad[2]:\bad[1]}

\integer{tmp=\s[1]*\l[1]}
\text{enonce=(\tmp)}
\integer{p=\l[1]}
\for{k=2 to \nb}{
 \integer{tmp=\s[\k]*\l[\k]}
 \integer{p=\p*\l[\k]}
 \text{tmp=\tmp>0?+\tmp}
 \text{enonce=\enonce\times(\tmp)}
}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
 \(\enonce = ) \embed{r1,20x20x1} \(\p)
</div>}

\answer{Réponse}{\good;\bad}{type=dragfill}
