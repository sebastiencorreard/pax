\title{Signe d'un quotient 3}
\author{G.,Bayle;Fabrice,Guerimand}
\email{fwguerima@free.fr}

\text{s=randrow(+,-
-,-)}
\integer{a=randint(2..9)}
\text{A=\s[1]\a}
\integer{b=randint(2..9)}
\text{B=\s[2]\b}
\text{l=shuffle(\A,\B)}
\integer{p=\A*\B}

\text{bad=\(+),\(-)}
\text{good=\B>0?\bad[1]:\bad[2]}

\statement{
Compléter l'égalité suivante :
<div class="wimscenter">
\(\frac{\p}{\A} = )\embed{r1,20x20x1} \(\b)
</div>}
\answer{Réponse}{\good;\bad}{type=dragfill}
