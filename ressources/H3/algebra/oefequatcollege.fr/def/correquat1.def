!set title=Correspondance d'équations
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni; Fabrice, Guerimand
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Mettre en relation chaque équation d'inconnue,	  avec sa solution.
val8=50x200x75
val9=$[rint(4)]
val10=x
tmp0=!shuffle 19

val11=$(tmp0)
tmp0=!randint 3, 11

val12=$[rint($(tmp0))]
tmp0=!randint $val12*$(val11[1]), 200

val13=$[rint($(tmp0))]
val14=$[rint($val13-$val12*$(val11[1]))]
val15=$val12 $val10 + $val14 = $val13
tmp0=!randint $(val11[2])+1, 21

val16=$[rint($val12*$(tmp0))]
val17=$[rint($val16/$val12-$(val11[2]))]
val18=$val12 ($val10 + $val17) = $val16
tmp0=!randint 2, $val12-1

val19=$[rint($(tmp0))]
tmp0=!randint 1, 19

val20=$[rint($(tmp0))]
val21=$[rint($(val11[3])*($val12-$val19)+$val20)]
val22=$val12 $val10 + $val20 = $val19 $val10 + $val21
tmp0=!randint 2, $val12-1

val23=$[rint($(tmp0))]
tmp0=!randint 1, 9

val24=$[rint($(tmp0))]
val25=$[rint($(val11[4])*($val12-$val23)+$val12*$val24)]
val26=$val12 ($val10 + $val24) = $val23 $val10 + $val25
val27=\($val15\),\($val18\),\($val22\),\($val26\)
tmp0=!item 1 to 4 of $val11

val28=$(tmp0)
replytype1=correspond
replyname1=
replygood1=$val27;$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) 
!insmath $val10
$() $(val7[2])	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val8 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10
embedcnt=1
