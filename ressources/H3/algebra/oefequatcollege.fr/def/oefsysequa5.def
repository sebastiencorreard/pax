!set title=Système d'équations 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Résoudre le système d'équations
val8=La solution du système est
val9=Si nécessaire, utiliser le point comme séparateur décimal.

!ifval $val2=
val10= 1
!else
val10=$val2
!endif
tmp0=!record $val10 of src/generateur

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 3 of $val12

val14=$(tmp0)
!if $val13= 
tmp0=!item 1 of $val12

val15=$(tmp0)
tmp0=!item 2 of $val12

val16=$(tmp0)
tmp0=!values $val14*v for v=$val15 to $val16

val17=$(tmp0)
!else
val17=$val13
!if $val14<0 
tmp0=!replace internal , by ,- in $val17

val17=$(tmp0)
!endif
!endif
tmp0=!listuniq $val17

val17=$(tmp0)
tmp0=!shuffle $val17

val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$(tmp0)
tmp0=!item 2 of $val17

val19=$(tmp0)
tmp0=!shuffle 2,3,4,5,6,7,8,9

val20=$(tmp0)
val21=+
val22=+
val23=1,$(val20[1]),$(val20[2]),$(val20[3])
val24=\,$(val20[1]),$(val20[2]),$(val20[3])
tmp0=!shuffle 4

val14=$(tmp0)
val25=$(val23[$(val14[1])])
val26=$(val23[$(val14[2])])
val27=$(val23[$(val14[3])])
val28=$(val23[$(val14[4])])
val29=$[$val25*$val18 $val21 $val26*$val19]
val30=$[$val27*$val18 $val22 $val28*$val19]
val31=\begin{array}{ccc}	$(val24[$(val14[1])]) x $val21 $(val24[$(val14[2])]) y &=& $val29 \\\ $(val24[$(val14[3])]) x $val22 $(val24[$(val14[4])]) y &=& $val30	\end{array}
val32=\(\left \lbrace$val31 \right.\)
replytype1=numeric
replyname1=
replygood1=$[$val18]
replytype2=numeric
replyname2=
replygood2=$[$val19]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 $val32. \par $val9 \par \(x = \cdots\) $val6 \(y = \cdots\). \end{statement} 


!goto stat

!exit

:question
$()	$val7 <div class="wimscenter">$val32</div>	<div class="wims_question">$val8	<div class="wimscenter">	<label for="reply1">
!insmath x
$() =</label>  
!read oef/embed.phtml r1,5 
$()	  $val6 <label for="reply2">
!insmath y
$() =</label>  
!read oef/embed.phtml r2,5 
$().	</div>	</div>	<div class="wims_instruction">$val9</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 $val32. $m_par $val9 $m_par 
!insmath x = \cdots
$() $val6 
!insmath y = \cdots
$(). $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,32
embedcnt=2
