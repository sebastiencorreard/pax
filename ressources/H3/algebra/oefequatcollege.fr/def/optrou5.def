!set title=Soustraction à trou 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni; Fabrice, Guerimand
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Compléter l'opération
val8=$[rint(4)]

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val2=
val9= 1
!else
val9=$val2
!endif
tmp0=!record $val9 of src/generateur

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 3 of $val11

val13=$(tmp0)
!if $val12= 
tmp0=!item 1 of $val11

val14=$(tmp0)
tmp0=!item 2 of $val11

val15=$(tmp0)
tmp0=!values $val13*v for v=$val14 to $val15

val16=$(tmp0)
!else
val16=$val12
!if $val13<0 
tmp0=!replace internal , by ,- in $val16

val16=$(tmp0)
!endif
!endif
tmp0=!listuniq $val16

val16=$(tmp0)
tmp0=!shuffle $val16

val16=$(tmp0)
tmp0=!item 1 of $val16

val14=$(tmp0)
tmp0=!item 2 of $val16

val15=$(tmp0)
!if $val2=1 or $val2=3 or $val2=5 
!if $val14<$val15 
val17=$[$val14]
val14=$[$val15]
val15=$[$val17]
!endif
!endif
val18=$[$val14-$val15]
val19=$val14 -
val20== $val15
replytype1=numeric
replyname1=
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 $val19 \(\cdots\) $val20. \end{statement} 


!goto stat

!exit

:question
$()$val7	<div class="wimscenter larger">	<label for="reply1">$val19</label>  
!read oef/embed.phtml r1,$val8 
$() $val20.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 $val19 
!insmath \cdots
$() $val20. $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,19,20
embedcnt=1
