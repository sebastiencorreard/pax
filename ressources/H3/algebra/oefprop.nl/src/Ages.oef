\title{Leeftijden}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\translator{ERNE Reinie}
\computeanswer{no}
\format{html}
\precision{10000}

\text{noms=Matthijs, Chris, Laura, Karin, Michel, Céline, Joseph,
Nicolas, Reinier, Lucas, Maria, Clara, Suzanne, Hendrik
}
\text{noms=shuffle(\noms)}
\text{nom1=item(1,\noms)}
\text{nom2=item(2,\noms)}
\matrix{donnee=
twee keer, 3, 1
drie keer, 4, 1
vier keer, 5, 1
de helft van, 3, 2
een derde van, 4, 3
}
\text{ligne=randomrow(\donnee)}
\text{fois=item(1,\ligne)}
\integer{m1=item(2,\ligne)}
\integer{m2=item(3,\ligne)}
\integer{r=random(5..30)}
\integer{d=\r*\m1}
\integer{R=\r*\m2}

\statement{\nom1 en \nom2 zijn samen \d jaar oud. Als bekend is dat de 
leeftijd van \nom2 \fois die van \nom1 is, wat is dan de leeftijd 
van \nom1?}


\answer{De leeftijd van \nom1}{\R}{type=default}
