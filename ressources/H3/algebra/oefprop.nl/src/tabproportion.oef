\title{Verhoudingstabel III}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\vertaling{Reinie Erne}
\computeanswer{yes}
\format{html}
\precision{10000}

\rational{prop= random(randint(2..9), random(3/2,1/2,5/2))}
\integer{a=randint(3..6)}
\integer{b=randint(4..9)}
\integer{b=\a=\b? \b+1}
\rational{aa=\a*\prop}
\rational{bb=\b*\prop}
\text{pr=\prop}
\text{choix=random(1,2,3,4)}
\text{rep1=\choix=1? \a:\aa}
\text{rep1=\choix=2? \b}
\text{rep1=\choix=4? \bb}
\statement{Maak de volgende verhoudingstabel af: 
<table align="center" border=1>
<tr align="center"><td>
\if{\choix=1}{\embed{reply 1,5}}{\a}</td><td>\if{\choix=2}{\embed{reply 1,5}}{\b}</td></tr>
<tr align="center"><td>\if{\choix=3}{\embed{reply 1,5}}{\aa}</td><td>
\if{\choix=4}{\embed{reply 1,5}}{\bb}</td>
</tr>
</table>
Om de getallen in de tweede rij te krijgen,<br>
moet je getallen in de eerste rij vermenigvuldigen met: \embed{reply 2,6}.
}
\answer{}{\rep1}{type=numeric}
\answer{}{\pr}{type=numeric}
