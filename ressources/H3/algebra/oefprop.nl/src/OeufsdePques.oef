\title{Paaseieren}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}

\text{noms=Patrick, Danielle, Willem, Elsbeth, Marco, Paul, Gerard, Lars, Catherine, Juliette, Chris, Alex, Karel, Sylvia}
\text{noms=shuffle(\noms)}
\text{nom1=item(1,\noms)}
\text{nom2=item(2,\noms)}
\text{nom3=item(3,\noms)}

\matrix{donnee=
de helft, een kwart, 1, 4
de helft, een derde, 1, 6
een kwart, een kwart, 2, 4
een derde, een derde, 1, 3
een derde, een kwart, 5, 12
}
\text{ligne=randomrow(\donnee)}
\text{q1=item(1,\ligne)}
\text{q2=item(2,\ligne)}
\integer{num=item(3,\ligne)}
\integer{den=item(4,\ligne)}
\integer{part=random(2..10)}
\integer{q3=\num*\part}
\integer{reponse=\part*\den}

\statement{Een aantal kinderen zoeken paaseieren in een tuin.
\nom1 heeft er \q1 gevonden, \nom2 \q2 en \nom3 heeft er \q3
gevonden. Hoeveel eieren zijn er gevonden? }


\answer{Het aantal eieren}{\reponse}{type=default}
