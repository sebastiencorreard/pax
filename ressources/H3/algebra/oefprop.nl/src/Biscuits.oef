\title{Delen}
\language{nl}
\range{-5..5}
\author{XIAO Dingyu}
\email{xiao@unice.fr}
\translator{ERNE Reinie}
\computeanswer{no}
\format{html}
\precision{10000}

\text{noms=Frits, Elsbeth, Lars, Catho, Gerard, Olivier, Diederik, Karel, Victor, Simon, Helen, Pieter, Joost, Juliette}
\text{noms=shuffle(\noms)}
\text{nom1=item(1,\noms)}
\text{nom2=item(2,\noms)}
\text{nom3=item(3,\noms)}
\matrix{donnee=
een kwart, 1, 4
een derde, 1, 3
de helft, 1, 2
twee derde, 2, 3
twee vijfde, 2, 5
}
\text{objets=random(koekjes, snoepjes)}
\text{ligne=randomrow(\donnee)}
\text{frac=item(1,\ligne)}
\text{num=item(2,\ligne)}
\text{den=item(3,\ligne)}
\integer{part=random(2..9)}
\integer{sol=\part*\num}
\integer{total=\part*\den}
\integer{reste=\total-\sol}
\integer{part1=random(1..\reste-1)}
\integer{part2=\reste-\part1}

\statement{Kinderen verdelen onderling \objets : \nom1 heeft er \part1 gehad, \nom2 \part2 en \nom3 \frac.
Hoeveel heeft \nom3 er gehad?}


\answer{\nom3 heeft er}{\sol}{type=default}{gehad.}
