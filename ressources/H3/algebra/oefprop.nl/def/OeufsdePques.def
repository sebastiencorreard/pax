!set title=Paaseieren
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Dingyu
email=xiao@unice.fr
language=nl
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Patrick, Danielle, Willem, Elsbeth, Marco, Paul, Gerard, Lars, Catherine, Juliette, Chris, Alex, Karel, Sylvia
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp=!trim de helft, een kwart, 1, 4	de helft, een derde, 1, 6	een kwart, een kwart, 2, 4	een derde, een derde, 1, 3	een derde, een kwart, 5, 12	
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$(tmp0)
tmp0=!item 2 of $val11

val13=$(tmp0)
tmp0=!item 3 of $val11

val14=$[rint($(tmp0))]
tmp0=!item 4 of $val11

val15=$[rint($(tmp0))]
tmp0=!randint 2, 10

val16=$[rint($(tmp0))]
val17=$[rint($val14*$val16)]
val18=$[rint($val16*$val15)]
replytype1=default
replyname1=Het aantal eieren
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Een aantal kinderen zoeken paaseieren in een tuin.	$val7 heeft er $val12 gevonden, $val8 $val13 en $val9 heeft er $val17	gevonden. Hoeveel eieren zijn er gevonden? 
$()
