!set title=Delen
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Dingyu
email=xiao@unice.fr
language=nl
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Frits, Elsbeth, Lars, Catho, Gerard, Olivier, Diederik, Karel, Victor, Simon, Helen, Pieter, Joost, Juliette
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp=!trim een kwart, 1, 4	een derde, 1, 3	de helft, 1, 2	twee derde, 2, 3	twee vijfde, 2, 5	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem koekjes, snoepjes

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
tmp0=!item 3 of $val12

val15=$(tmp0)
tmp0=!randint 2, 9

val16=$[rint($(tmp0))]
val17=$[rint($val16*$val14)]
val18=$[rint($val16*$val15)]
val19=$[rint($val18-$val17)]
tmp0=!randint 1, $val19-1

val20=$[rint($(tmp0))]
val21=$[rint($val19-$val20)]
replytype1=default
replyname1=$val9 heeft er
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Kinderen verdelen onderling $val11 : $val7 heeft er $val20 gehad, $val8 $val21 en $val9 $val13.	Hoeveel heeft $val9 er gehad?
$()
!exit

