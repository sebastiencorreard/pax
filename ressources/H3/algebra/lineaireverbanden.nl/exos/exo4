A=!randitem A,B,C,D,E,F,G,S,W
B=!randitem H,K,L,M,N,P,R,T,V
keuze=!randitem 1,0
!if $keuze=0
    pm=+
    ptex=$empty
!else
    pm=-
    ptex=-    
!endif
letter1=x
letter2=y
letter3=f
letter4=g
    
x1=!randitem -6,-5,-4,-3,-2,-1,1,2,3,4,5,6
!if $R=1
    m=!randitem 1,2,3,-3,-2,-1
    q=0
!else
    !if $R=2
	m=!randitem 1,2,3,-3,-2,-1
	q=!randitem 1,2,3,4
!else
	q=!randitem 1,2,3,4,5,6,7
	d=!randint 3,9
	d=$[$q+$d]
    	!if $R=3
    	    m=!randitem 2,1,1/2,1/4,1/8,1/10,3/2,2,-1,-1/2,-1/4,-1/8,-1/10,-3/2,-2
	!else
    	    T=!randint 1,20
	    N=!randint 40,100
	    mp=!randitem -1,1
    	    N=$[$mp*$N]
	    m=$T/$N
	!endif
    !endif
!endif
tot=!exec pari A=(($m)*($x1) $pm $q)\
printtex(A)\
$m\
printtex($m)

y1=!line 1 of $tot
y1_tex=!line 2 of $tot
rc=!line 3 of $tot
rc_tex=!line 4 of $tot
!if $R>2
    ss=!record 54 of lang/remarks.$taal
    formula$n=\left[ \begin{array}{l} $letter4($letter1)=$m\cdot $letter1 $pm $d \\ \\  $A \left($x1 : $y1_tex\right) \end{array}\right.
    applettext=!nospace (vlist( $letter4($letter1) = $m*$letter1 $pm $d , $A ($x1 : $y1) , a = $rc )) ->
!else
    ss=!record 11 of lang/remarks.$taal
    formula$n=\left[ \begin{array}{l} $letter3($letter1)=a\cdot $letter1 + b \\ \\  $A \left($x1 : $y1_tex\right) \end{array}\right.
    applettext=!nospace (vlist( $letter3($letter1) = a*$letter1 + b , $A ($x1 : $y1) , a = $rc )) ->
!endif
#@ Bepaal de rechte lijn door hellingsgetal en punt<p>Lijn <em>$letter3</em> gaat door het punt <em>$A</em> met <em>$letter1,$letter2</em>-co&ouml;rdinaten ($x1:$y1)<br />Lijn <em>$letter3</em> heeft hellingsgetal $m. [richtingsco&euml;fficient]<br />Geef de formule van de lijn <em>$letter3</em>  
#@! Determine the formula of a straight line by slope and point<p>Determine the formula of the line <em>$letter3</em> with <em>slope</em>=$m<br />and through point <em>$A</em> with <em>x,y</em>-co&ouml;rdinates ($x1:$y1) 
#@!~ 利用斜率以及一个点确定直线的方程<p>确定直线 <em>$letter3</em> 的方程, 其<em>斜率</em>=$m<br />并且通过点 <em>$A</em> 它的 <em>x,y</em> 坐标是 ($x1:$y1) 
    
