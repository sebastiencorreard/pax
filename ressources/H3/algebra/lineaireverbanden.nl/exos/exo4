#: bepaal de lijn door punt & richtingsco&euml;fficient
n=$counter
questiontype=0
image=0
cols=20
rows=1
math=0
embed=1
mathview=4
checkfile=$checkdir/equation.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif

!if $printexo=0
    white=white
    image=0
!else
    image=1
