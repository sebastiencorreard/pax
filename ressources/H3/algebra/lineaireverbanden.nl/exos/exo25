# tabel en lijn [GeoGebra]
n=$counter
make_tr=1
inputs=yes
mathview=0
checkfile=exos/checkfile1.proc
questiontype=7
javascript=js/exo15.js
math=0
!if $level=0
    R=$counter
!else
    R=$level
!endif
showToolBar=true
showMenuBar=false
framePossible=true
list_of_things=['line']; 
ggb=ggb/rooster.ggb
#letop: 0 decimalen , snap-to-grid
height=480
width=600
formula$n=
customToolBar=" 1 | 2 | 6 | 40 | 41 | 42 "
image=0

!if $level=0
    R=$counter
!else
    R=$level
!endif

!if $options<4 or $options>8
    options=5
!endif

sometext=!record 40 of lang/remarks.$taal
#@uitkomst:getal,bedrag:tijd,afstand:tijd,hoogte:tijd
ding=!randitem $sometext
ding=!replace internal : by , in $ding
y=!item 1 of $ding
x=!item 2 of $ding
keuze=!randitem 1,0

!if $R=1
    c=!randint 1,9
    const=1
    a=1
    !if $keuze=1
	pm=+
	start=0
	var4=$c
    !else
	pm=-
	start=$c
	var4=$[-1*$c]
    !endif
    formula$n=\begin{array}{l} \textrm{ $y } \,=\, \textrm{ $x } $pm $c  \end{array}
    func=$a*x $pm $c
    var3=$a
!else
    !if $R=2
	const=1
	a=!randint 2,9
	start=0
	formula$n=\begin{array}{l} \textrm{ $y } \,=\, $a \times \textrm{ $x }  \end{array}
	func=$a*x
	var3=$a
	var4=0
    !else
	!if $R=3
	    const=1
	    a=!randint 2,9
	    c=!randint 1,5
	    !if $keuze=1
	        pm=+
	        start=0
	        var4=$c
	    !else
	        pm=-
	        start=$c
	        var4=$[-1*$c]
	    !endif
	    formula$n=\begin{array}{l} \textrm{ $y } \,=\, $a \times \textrm{ $x } $pm $c  \end{array}
	    func=$a*x $pm $c
	!else
	    const=1
	    a=!randint 2,7
	    pm=!randitem +,-
	    y=y
	    x=x
	    !if $keuze=1
		c=!randint 1,5
	        start=0
	        var4=$c
		formula$n=\begin{array}{l} \textrm{ y } \,=\, $a \cdot \textrm{ x } $pm $c  \end{array}
		func=$a*x $pm $c
	    !else
		c=!randint 5,15
	        start=0
	        var4=$c
		formula$n=\begin{array}{l} \textrm{ y } \,=\, $c - $a \cdot \textrm{ x }  \end{array}
		func=$c - $a*x
            !endif
	!endif
    !endif
!endif
var1=$x
var2=$y

header=<th>$x</th>
body=<th>$y</th>
answer_body=<th>$y</th>
answer$n=$func
i=0
!for p=1 to $options
    ans=!evalsubst x=$start in $func
    answer$n=!append item $ans to $(answer$n)
    header=!append word $ <th>$start</th> $ to $header
    answer_body=!append word <th><input type="text" class="schaersvoorde_input" size="2" id="myinput$i" value="$ans" readonly="readonly"/></th> $ to $answer_body
    !if $wims_user=supervisor
	body=!append word <th><input type="text" class="schaersvoorde_input" size="4" id="myinput$i" value="$ans" /></th> $ to $body
    !else
	body=!append word <th><input type="text" class="schaersvoorde_input" size="4" id="myinput$i" value="" /></th> $ to $body
    !endif
    start=$[$start + $const]
    !increase i
!next p

exotext=<table class="zebra_table_h2"><tr>$header</tr><tr>$body</tr></table>
textanswer$n=<table class="zebra_table_h2"><tr>$header</tr><tr>$answer_body</tr></table>

helptext=<img src=\'$module_dir/gifs/exo10.$taal.jpg\' alt=\'noalt\' />

question$n=!record 44 of lang/remarks.$taal
#@Vul de tabel in bij de formule en teken de lijn in de GeoGebra applet.<br />

!exit

