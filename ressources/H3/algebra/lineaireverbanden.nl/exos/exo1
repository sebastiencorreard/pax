#: tabel & lijn [HTML5 H1/H2]
n=$counter
questiontype=0
image=0
cols=15
math=0
inputs=-1
mathview=0
checkfile=$checkdir/number.proc
rounding=10
var1=yes
!if $level=0
    R=$counter
!else
    R=$level
!endif
options=4
rc=!record 2 of lang/remarks.$taal
#@ de richtingsco&euml;fficient(=hellingsgetal), het hellingsgetal
#@! slope,inclination
#@!~ Ð±ÂÊ,Ð±ÂÊ
rc=!randitem $rc
rise_fall=!record 3 of lang/remarks.$taal
#@stijgend,dalend
#@!increasing,decreasing
#@!~ µÝÔö , µÝ¼õ
s1=!item 1 of $rise_fall
s2=!item 2 of $rise_fall 
#m=!randitem 2,3,1,1/2,1/4,1/5,1/8,1/10,1/16
m=!randitem 3,5/2,2,3/2,1,1/2,1/4,1/8
!if $R=1
    step=1
    pm=+
    q=0
    xmin=0
    letter2=y
    letter1=x
    htmllijn=!htmlmath $letter2=$m*$letter1
!else
    !if $R=2
	step=2
	mp=!randitem -1,1
	m=$[$mp*$m]
	xmin=!randitem -1,0,1
	letter2=y
	letter1=x
	htmllijn=!htmlmath $letter2=$m*$letter1
    !else
	mp=!randitem -1,1
	step=2
	m=$[$mp*$m]
	pm=!randitem +,-
	q=!randint 1,10
	xmin=!randitem -2,-1,0,1,2
	!if $R=3
	    letter2=y
	    letter1=x
	!else
	    letter2=!randitem f,g,h,k
	    letter1=!randitem a,b,c,d
	!endif
	htmllijn=!htmlmath $letter2=$m*$letter1 $pm $q
    !endif
!endif
    
exotext=$empty
make_tr=0
rise_fall=!record 3 of lang/remarks.$taal
#@stijgend,dalend
#@!increasing,decreasing
#@!~ µÝÔö , µÝ¼õ
!if $m>0
    stijgend=$s1
    a1=1
!else
    stijgend=$s2
    a1=-1
!endif
# answer$n --> $option+1 items
xmax=$[$xmin + $step*$options]
!if $m>0
    # stijgen
 ymin=$[$m*$xmin $pm $q - 2]
 ymax=$[$m*$xmax $pm $q + 2]
!else
    # dalend
 ymin=$[$m*$xmax $pm $q - 2]
 ymax=$[$m*$xmin $pm $q + 2]
!endif 
!if $ymax < 1
    ymax=2
!endif
!if $ymin>-1
    ymin=-2
!endif
!for s=$[$xmin] to $[$xmax] step $step
    getallen=!append item $s to $getallen
!next s
s=0
i=0
points=$empty
!for p=1 to $[$step*$options] step $step
    !increase s
    getal=!item $s of $getallen
    ant=$[$m*$getal $pm $q] 
    answer$n=!append item $ant to $(answer$n)
    TD=!append word $ <tr><td>$getal</td><td><input id="myinput$i" class="schaersvoorde_input" size="5" value="" /></td></tr> $ to $TD
    TDD=!append word $ <tr><td>$getal</td><td><input id="myinput$i" class="schaersvoorde_input" size="5" value="$ant"/></td></tr> $ to $TDD
    points=!append item $getal,$ant to $points
    !increase i
!next p
answer$n=!append item $a1 to $(answer$n)
ss=!record 6 of lang/remarks.$taal
rr=!record 7 of lang/remarks.$taal
s0=!record 34 of lang/remarks.$taal
exotext=<table class="demospecial"><tr><th><em>$letter1</em></th><th><em>$letter2</em></th></tr><tr>$TD</tr></table><br />$s0 <select id="myselect0" ><option value="1">$s1</option><option value="-1">$s2</option></select>
image=0
applet=1

object$n=!exec canvasdraw\
size 360,360\
bgcolor $wims_bgcolor\
xrange $[$xmin-2],$[$xmax+2]\
yrange $ymin,$ymax\
xlabel $letter1 -axis\
ylabel $letter2 -axis\
opacity 160,160\
precision 10\
axis\
axisnumbering\
grid 1,1,grey,2,2,6,blue\
zoom red\
precision 1000\
mouse red,18\
line -100,$[-100*$m $pm $q],100,$[100*$m $pm $q],red\
linewidth 2\
points green,$points

textanswer$n=$rr<table class="demospecial"><tr><th><em>$letter1</em></th><th><em>$letter2</em></th></tr><tr>$TDD</tr></table>
question$n=$ss $tooltip<br />
helptext=$empty

!exit

 
 
