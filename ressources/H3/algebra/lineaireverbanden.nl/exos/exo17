# :bepaal de lijn door twee punten 
n=$counter
questiontype=0
image=0
cols=15
math=0
embed=1
mathview=0
checkfile=$checkdir/equation.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif

A=!randitem A,B
B=!randitem C,D
pm=!randitem +,-
p=!randitem 1,2,3,4
letter1=x
letter2=y
letter3=!randitem f,g

!if $R=1
    m=!randitem 1,2,3,-3,-2,-1
    q=!randitem 1,2,3,4
    x1=!randitem -4,-3,-2,-1
    x2=!randitem 1,2,3,4,5
!else
    !if $R=2
	m=!randitem 1,2,3,-3,-2,-1
	q=!randitem 1,2,3,4
	x1=!randitem -6,-5,-4,-3,-2,-1
	x2=!randitem 1,2,3,4,5,6
    !else
	m=!randitem 1,1/2,1/4,1/10,3/2,2,-1,-1/2,-1/4,-1/10,-3/2,-2
	q=!randitem 1,2,3,4,5,6,7
	x1=!randitem -6,-5,-4,-3,-2,-1
	x2=!randitem 1,2,3,4,5,6
    !endif
!endif

tot=!exec pari A=($m)*($x1) $pm $q\
B= ($m)*($x2) $pm $q\
printtex(A)\
printtex(B)\
printtex($m)

y1=!line 1 of $tot
y2=!line 2 of $tot
y1_tex=!line 3 of $tot
y2_tex=!line 4 of $tot
rc_tex=!line 5 of $tot

ss=!record 47 of lang/remarks.$taal
#@ Stel de formule op van de rechte lijn tussen twee punten<p>Geef de <em>exacte</em> formule van de lijn <em>$letter3</em> door de twee punten. <br /><ul><li>Punt $A met <em>$letter1,$letter2</em>-co&ouml;rdinaten ($x1:$y1)</ll><li>Punt $B met <em>$letter1,$letter2</em>-co&ouml;rdinaten ($x2:$y2)</li></ul> 
#@! Determine the formula of the line between two given points<p>Give the <em>exact</em> formula of the line <em>$letter3</em><br />in a <em>$letter1,$letter2-plane</em> through the next points: <br /><ul><li>Point $A with <em>$letter1,$letter2</em>-co&ouml;rdinates ($x1:$y1)</li><li>Point $B with <em>$letter1,$letter2</em>-co&ouml;rdinates ($x2:$y2)</li></ul>
#@!~ 确定通过 2 个已知点的直线 <p>确定在 <em>$letter1,$letter2 平面</em>内通过以下两点<br />的直线 <em>$letter3</em> 的<em>精确</em>公式:<br /><ul><li>点 $A 的 <em>$letter1,$letter2</em> 坐标为 ($x1:$y1)</li><li>点 $B 的 <em>$letter1,$letter2</em> 坐标为 ($x2:$y2)</li></ul>

lijn=$m*x $pm $q
answer$n= $m*$letter1 $pm $q
ggg=!htmlmath $letter2 = $(answer$n)

rr=!record 48 of lang/remarks.$taal
#@ De lijn door $A ($x1:$y1) en $B ($x2:$y2) heeft de vergelijking: <br />$ggg 
#@! The line through $A ($x1:$y1) and $B ($x2:$y2) is:<br />$ggg 
#@!~ 通过 $A ($x1:$y1) 和 $B ($x2:$y2) 的直线公式是:<br />$ggg 


formula$n=\left[ \begin{array}{l} y= a \cdot $letter1 + b \\ \\  $A \left($x1 : $y1_tex \right)  \\  \\ $B \left( $x2 : $y2_tex \right)  \end{array} \right.
applettext=!nospace (vlist( y = a*$letter1 + b , $A ($x1 : $y1) ,  $B ($x2 : $y2) )) ->

lijn=!rawmath $m*x $pm $q
answer$n=$lijn
arglist=$letter3($letter1),$letter2
varlist=$letter1
ggg=!htmlmath y = $(answer$n)

