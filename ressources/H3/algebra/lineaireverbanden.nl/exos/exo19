#:bepaal het snijpunt vantwee lijnen
n=$counter
questiontype=0
image=0
cols=15
rows=1
math=0
embed=1
mathview=4
checkfile=$checkdir/coord.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif

letter1=x
letter2=y
letter3=f
letter4=g
A=!randitem A,B,C,D,E,F
kleuren=!record 15 of lang/remarks.$taal
#@ red@rooie,blue@blauwe,green@groene,orange@oranje,purple@paarse
#@! red@red,blue@blue,green@geenish,orange@orange,purple@purple
#@!~ red@红色,blue@蓝色,green@绿色,orange@橙色,purple@紫色
kleuren=!shuffle $kleuren
k1=!item 1 of $kleuren
k2=!item 2 of $kleuren
k1=!replace internal @ by , in $k1
k2=!replace internal @ by , in $k2
lang_color1=!item 2 of $k1
color1=!item 1 of $k1
lang_color2=!item 2 of $k2
color2=!item 1 of $k2

x=!randint 1,10
y=!randint 1,10
pm=!randitem -1,1
pp=!randitem -1,1
mp=!randitem 1,-1

!if $R=1
    m=!randitem 1,2,3
    p=!randint $[$m+1],$[$m+5]
!else
    !if $R=2
	m=!randitem 1,2,3,-2,-3
	x=$[$pm*$x]
	y=$[$pp*$y]
	!if $m>0
	    p=!randint $[-1*$m-4],-1
	!else
	    p=!randint 1,$[-1*$m+4]
	!endif
    !else
	m=!randitem 2,3,4,5,6,-1,-2,-3,-4,-5,-6
	x=$[$pm*$x]
	y=$[$pp*$y]
	!if $m>0
	    p=!randint $[-1*$m-4],-1
	!else
	    p=!randint 1,$[-1*$m+4]
	!endif
    !endif
!endif

answer$n=$x,$y

tot=!exec pari  A=($m)*($letter1) + ($y) - ($m)*($x)\
printtex(A)\
B=($p)*($letter1) + ($y) - ($p)*($x)\
printtex(B)\
C=($m)*($letter1)-($p)*($letter1)\
printtex(C)\
D=($y) - ($p)*($x) -(($y) - ($m)*($x))\
printtex(D)

lijn1=!line 1 of $tot
L1tex=!line 2 of $tot
lijn2=!line 3 of $tot
L2tex=!line 4 of $tot
tussen1=!line 6 of $tot
tussen2=!line 8 of $tot
!if $[abs($m)]=1
    calc=!replace internal $letter1 by $ $x $ in $L1tex
!else
    calc=!replace internal $letter1 by $ \cdot$x $ in $L1tex
!endif
L1=$letter3 (x) = $L1tex
L2=$letter4 (x) = $L2tex

formula$n=\left[ \begin{array}{l}$L1 \\ \\ $L2 \\ $A ( x : y) \end{array}

texanswer$n=\left[ \begin{array}{l} \\ $A : $letter3(x) = $letter4(x) \\$L1tex = $L2tex  \\ $tussen1 = $tussen2 \rightarrow x_{$A} = $x \\ y_{$A} = $calc \rightarrow y_{$A} = $y \end{array}\right] \rightarrow $A \left( $x : $y \right) 

applettext=!nospace ( vlist( $letter3($letter1)=$lijn1 ,., $letter4($letter1)=$lijn2 , $A ( x_$A ; y_$A ) ) ) ->

ss=!record 18 of lang/remarks.$taal

rr=!record 19 of lang/remarks.$taal

textanswer$n=$rr

helptext=<textarea class=\'schaersvoorde_textarea\' readonly=\'readonly\' cols=\'15\' rows=\'1\'>(-10;3)</textarea>

question$n=<a onmouseover="return escape('$helptext')">$ss</a>
    
!if $teaching=1
    image=0
    etext=!record 1 of lang/remarks.$taal
    y11=!evalsubst x=-10 in $lijn1
    y12=!evalsubst x=10 in $lijn1
    y21=!evalsubst x=-10 in $lijn2
    y22=!evalsubst x=10 in $lijn2
    
    tooltip=!exec canvasdraw\
    size 320,320\
    xrange -20,20\
    yrange -20,20\
    bgcolor $wims_bgcolor\
    axis\
    xlabel x-as\
    ylabel y-as\
    grid 100,100,grey,1,1,0,grey\
    linewidth 2\
    line -10,$y11,10,$y12,$color1\
    line -10,$y21,10,$y22,$color2\
    linewidth 3\
    point $x,$y,green\
    string black,$x,$y,  $A (x:y)\
    intooltip $etext
    
    exotext=$tooltip<br />
	
!endif



    

