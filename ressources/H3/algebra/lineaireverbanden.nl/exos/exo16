helptext=<textarea class=\'schaersvoorde_textaarea\' readonly=\'readonly\' cols=\'25\' rows=\'2\'>$letter2 = 1/2*$letter1 - 5</textarea><br /><textarea class=\'schaersvoorde_textaarea\' readonly=\'readonly\' cols=\'25\' rows=\'2\'>$letter2 = -3$letter1 + 1/3</textarea>
question$n=<a onmouseover="return escape('$helptext')">$ss</a>
textanswer$n=$rr
texanswer$n=\left[ \begin{array}{ll} I: &  $letter2 = a \cdot $letter1 + b \\ II : &  a = $rc_tex \\ III : & $A ( $x1 : $y1_tex )  \\   b = [?] &  \\ I+II : & $letter2 = $rc_tex \cdot $letter1 + b \\ I+II+III  : & $letter2 _{$A} = $rc_tex \cdot $letter1 _{$A} + b  \\ \rightarrow  $y1_tex = $rc_tex \cdot $x1 + b & \rightarrow  b = $y1_tex - \left( $rc_tex \cdot $x1 \right) = $ptex $q \end{array}\right]  \rightarrow y = $rc_tex \cdot x $pm $q







