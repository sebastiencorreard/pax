#: bepaal de lijn door punt & richtingsco&euml;fficient
n=$counter
questiontype=0
image=0
cols=20
rows=1
math=0
embed=1
mathview=4
checkfile=$checkdir/equation.proc
!if $level=0
    R=$counter
!else
    R=$level
!endif

A=!randitem A,B,C,D,E,F,G,S,W
B=!randitem H,K,L,M,N,P,R,T,V
keuze=!randitem 1,0
!if $keuze=0
    pm=+
    ptex=$empty
!else
    pm=-
    ptex=-
!endif
letter1=x
letter2=y
letter3=f
    
x1=!randitem -6,-5,-4,-3,-2,-1,1,2,3,4,5,6
!if $R=1
    m=!randitem 1,2,3,-3,-2,-1
    q=0
!else
    !if $R=2
	m=!randitem 1,2,3,-3,-2,-1
	q=!randitem 1,2,3,4
    !else
	q=!randitem 1,2,3,4,5,6,7
    	!if $R=3
    	    m=!randitem 2,1,1/2,1/4,1/8,1/10,3/2,2,-1,-1/2,-1/4,-1/8,-1/10,-3/2,-2
	!else
    	    T=!randint 1,20
	    N=!randint 40,100
	    mp=!randitem -1,1
    	    N=$[$mp*$N]
	    m=$T/$N
	!endif
    !endif
!endif
tot=!exec pari A=(($m)*($x1) $pm ($q))\
printtex(A)\
$m\
printtex($m)

y1=!line 1 of $tot
y1_tex=!line 2 of $tot
rc=!line 3 of $tot
rc_tex=!line 4 of $tot
ss=!record 45 of lang/remarks.$taal

formula$n=\left[ \begin{array}{l} y=a\cdot $letter1 + b \\ a = $rc_tex \\  $A \left($x1 : $y1_tex\right) \end{array}\right.
applettext=!nospace (vlist( $letter3($letter1) = a*$letter1 + b , $A ($x1 : $y1) , a = $rc )) ->

lijn=!rawmath $m*x $pm $q
answer$n=$lijn
arglist=$letter3($letter1),$letter2
varlist=$letter1
ggg=!htmlmath y = $(answer$n)

rr=!record 46 of lang/remarks.$taal
#@ De rechte lijn met hellingsgetal [richtingsco&euml;fficient] $m en door het punt $A <br />heeft de vergelijking : <br /> $ggg 
#@! The line through point $A and slope=$m ,has the formula:<br /> $ggg 
#@!~ 通过点 $A 具有斜率=$m 的直线方程为:<br /> $ggg 
    
image=0
