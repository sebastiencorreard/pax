n=$counter
questiontype=0
image=0
cols=20
rows=2
math=0
embed=1
mathview=4
checkfile=$checkdir/equation.proc

!if $level=0
    R=$counter
!else
    R=$level
!endif

letter1=x
letter2=y
letter3=f
letter4=g

A=!randitem A,B,C,D
pm =!randitem +,-
m1=!randitem 1/2,1/4,1/5,1,3/2,4/5,2,-1/2,-1/4,-1/5,-1,-3/2,-4/5,-2
q1=!randitem 1,2,3,4,5
lijn1=$m1*x + $q1
#punt $A niet op de lijn
x1=!randitem -5,-4,-3,-2,-1,2,3,4,5
y1=$[round(($m1)*$x1 + $q1)]
y1=$[$y1 $pm 10]
l1=!texmath $lijn1
ll1=!htmlmath f(x)=$lijn1
color1=!randitem red,blue
!if $color1=blue
    color2=red
!else
    color2 =blue
!endif

helptext=<textarea readonly=\'readonly\' cols=\'25\' rows=\'2\' class=\'schaersvoorde_textarea\' >$letter4($letter1) = 1/2*$letter1 - 5</textarea><br /><textarea readonly=\'readonly\' cols=\'25\' rows=\'2\' class=\'schaersvoorde_textarea\' >$letter2 = -3$letter1 + 1/3</textarea>
!if $R=1
    arglist=$letter4($letter1),$letter2
    varlist=$letter1
    #parallel  aan  y=$m1*x + q1 ==> punt $A op de || lijn
    #lijn2 y1=m1*x1+q2 => q2=$y1 - ($m1*$x1) 	
    tot=!exec pari A=($m1)*x + ($y1) - ($m1*($x1))\
    printtex(A)\
    printtex($m1)
    
    lijn2=!line 1 of $tot
    l2=!line 2 of $tot
    rc=!line 3 of $tot
    answer$n=$lijn2 
    ll2=!htmlmath g(x)=$lijn2
    
    ss=!record 20 of lang/remarks.$taal
    #@ Bepaal de vergelijking van de lijn <span size="+1" color=$color2><em>g</em></span>parallel (||) aan de lijn <span size="+1" color=$color1><em>f</em></span>en <br /> door het punt <span size="+1" color=$color2><em>$A</em></span>
    #@! Determine the equation of the line <span size="+1" color=$color2><em>g</em></span>parallel (||) to the line <span size="+1" color=$color1><em>f</em></span>and<br /> through point <span size="+1" color=$color2><em>$A</em></span>
    #@!~ 已知 直线 <span size="+1" color=$color2><em>f</em></span>与点 $A<br /> 确定 直线 <span color=$color1 size="+1"><em>g</em></span> 的方程, 它垂直于直线 <span size="+1" color=$color2><em>f</em></span> 且<br />通过点 $A
    
    formula$n=\left[ \begin{array}{l}$A ($x1;$y1) \\ \\ f(x) = $l1 \\ \\ g(x) = [?] \end{array}
    texanswer$n=\left[ \begin{array}{lll} f(x) = $l1 \,\, \rightarrow \,\, g(x) = $rc \cdot x + b && \\ \\ ($x1;$y1) \in g \rightarrow $y1 = $rc \cdot $x1 + b \rightarrow b =$[ $y1 - ($m1*$x1) ]  & \end{array}\right] \rightarrow g(x)= $l2
    
    rr=!record 21 of lang/remarks.$taal
    #@ De gezochte lijn g : <br /> $A ($x1:$y1) || $ll1 $m_rightarrow $ll2
    #@! The line g:<br /> $A ($x1:$y1) || $ll1 $m_rightarrow $ll2
    #@!~ 直线 g:<br /> $A ($x1:$y1) || $ll1 $m_rightarrow $ll2
    !if $teaching=1
	etext=!record 1 of lang/remarks.$taal
	tooltip=!exec canvasdraw \
	size 320,320\
	xrange -40,40\
	yrange -40,40\
	bgcolor $wims_bgcolor\
	xlabel x-as\
	ylabel y-as\
	axis\
	grid 100,100,black,1,1,0,black\
	linewidth 2\
	curve $color1,$lijn1\
	curve $color2,$lijn2\
	point $x1,$y1,green\
	string black,$x1,$y1,   $A ($x1:$y1)\
	intooltip $etext
	
	#insdraw_size=200,200
	#!insdraw $plaatje
	#exotext=<a onmouseover="return escape('<img src=\'$wims_ref_name?&session=$session&module=$module&cmd=getins&special_parm=insert-1.gif\' alt=\'noalt\' />')">$etext</a>
	
	exotext=$tooltip <br />
    !endif
    textanswer$n=$rr
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
 !exit
!endif

!if $R=2
    arglist=$letter4($letter1),$letter2
    varlist=$letter1
    #loodrecht    y=$[-1/$m1]*x +Q ==> punt A op de lijn	
    #y1=$[-1/$m1]*x1 +Q ==> Q=$y1-$[-1/$m1]*$x1=$y1+$x1/$m1
    tot=!exec pari A= x/(-1*($m1)) + ($y1-(-1/($m1))*($x1))\
    printtex(A)\
    B=-1/($m1)\
    printtex(B)
    
    lijn2=!line 1 of $tot
    l2=!line 2 of $tot
    m2=!line 3 of $tot
    rc=!line 4 of $tot
    l2=!texmath $lijn2
    ll2= !htmlmath g(x)=$lijn2
    answer$n=$lijn2

    ss=!record 22 of lang/remarks.$taal
    #@  Gegeven de lijn <span size="+1" color=$color2><em>f</em></span>en het punt $A<br />Bepaal de vergelijking van de lijn <span color=$color1 size="+1"><em>g</em></span> loodrecht op de lijn <span size="+1" color=$color2><em>f</em></span> en <br />door $A
    #@! Given <span size="+1" color=$color2>the line <em>f</em></span>and point $A<br />Determine the equation of <span color=$color1 size="+1">the line <em>g</em></span> perpendicular to line <span size="+1" color=$color2><em>f</em></span> and<br />through point $A
    #@!~ 确定 <span size="+1" color=$color2>直线 <em>g</em></span> 的方程, 它平行于 <span size="+1" color=$color1>直线 <em>f</em></span>  且<br /> 通过点 <span size="+1" color=$color2><em>$A</em></span>

    formula$n=\left[ \begin{array}{l}$A ($x1:$y1) \\ \\ f(x) = $l1 \\ \\ g(x) = [?]\end{array} \right.
    texanswer$n=\left[ \begin{array}{lll} f(x) = $l1 \,\,\perp \,\, g(x) = a\cdot x + b & \rightarrow a = $rc  & \\ g(x_{$A}) = y_{$A} & \rightarrow y_{$A} = $rc \cdot x_{$A} + b & \rightarrow $y1 = $rc \cdot $x1 + b \\ b = $y1 - $[$m2*$x1] & \rightarrow b =$[ $y1 - ($m2*$x1) ]  & \end{array}\right] \rightarrow g(x)= $l2
    
    rr=!record 23 of lang/remarks.$taal    
    #@ De gezochte lijn <em>g</em>:<br /> $A ($x1:$y1) &perp; $ll1 $m_rightarrow  $ll2
    #@! The line <em>g</em>:<br /> $A ($x1:$y1) &perp; $ll1 $m_rightarrow  $ll2
    #@!~ 直线 <em>g</em>:<br /> $A ($x1:$y1) &perp; $ll1 $m_rightarrow  $ll2
    !if $teaching=1
	etext=!record 1 of lang/remarks.$taal
	tooltip=!exec canvasdraw \
	size 320,320\
	xrange -40,40\
	yrange -40,40\
	bgcolor $wims_bgcolor\
	xlabel x-as\
	ylabel y-as\
	axis\
	grid 100,100,black,1,1,0,black\
	linewidth 2\
	curve $color2,$lijn1\
	curve $color1,$lijn2\
	point $x1,$y1,$color2\
	string black,$x1,$y1,   $A ($x1:$y1)\
	intooltip $etext
	
	exotext=$tooltip <br />
    !endif
    textanswer$n=$rr
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
 !exit
!endif


!if $R>2
    var1=1
    letter1=x
    letter2=y
    letter3=a
    mp=!randitem -1,1
    pm=!randitem -1,1
    x1=!randint 1,10
    y1=!randint 1,10
    x1=$[$pm*$x1]
    y1=$[$mp*$y1]
    ss=!record 24 of lang/remarks.$taal
    #@ Gegeven is het punt $A met <em>x,y</em>-co&ouml;rdinaten ($x1:$y1).<br /> Geef de algemene vergelijking van <b>alle</b> rechte lijnen door het punt $A<br />Neem voor de algemene vergelijking van een rechte lijn:<br /><p align="center"><span size=+1><em>$letter2 = $letter3 x + b</em></span></p>
    #@! Given point $A with <em>x,y</em>-co&ouml;rdinates ($x1:$y1).<br />Give a general equation of <span size=+1>all</span> straight lines through point $A.<br />Take as general equation for a straight line:<br /><p align="center"><span size=+1><em>$letter2 = $letter3 x + b</em></span></p>
    #@! 已知点 $A 的 <em>x,y</em> 坐标 ($x1:$y1).<br /> 确定通过点 $A 的 <b>所有</b> 直线的一般方程.<br /> 直线一般方程的形式为:<br /><p align="center"><span size=+1><em>$letter2 = $letter3 x + b</em></span></p>

    arglist=g,$letter2
    varlist=$letter1,$letter3
    wims_rawmath_variables=$letter3,$letter1
    !if $pm=1
	!if $mp=1
	    answer$n=$letter3*x - $x1*$letter3 + $y1
	!else
	    answer$n=$letter3*x - $x1*$letter3  $y1
	!endif
    !else
	!if $mp=1
	    answer$n=$letter3*x + $[-1*$x1]*$letter3 + $y1
	!else
	    answer$n=$letter3*x + $[-1*$x1]*$letter3  $y1
	!endif
    !endif
    answer$n=!rawmath $(answer$n)
    tex=!texmath $(answer$n)
    ggg=!htmlmath $letter2=$(answer$n)
    formula$n=\left[ \begin{array}{l} $A ($x1 : $y1) \\ $letter2  \,=\, $letter3\cdot x + b  \\ g(x) \,=\,[?] \end{array} \right.
    texanswer$n=\left[ \begin{array}{l} y_{$A} = $letter3 \cdot x_{$A} + b \\ $y1 = $letter3 \cdot $x1 + b \\ b=$y1 - $letter3 \cdot $x1 \end{array}\right] \rightarrow y=$tex
    !if $teaching=1
	CURVES=$empty
	!for p=0.5 to 10 step 0.5
	    r=$[tan($p)]
	    yc1=!evalsubst x=-20 in $r*(x-$x1)+$y1
	    yc2=!evalsubst x=20 in $r*(x-$x1)+$y1
	    CURVES=!append line line -20,$yc1,20,$yc2,red to $CURVES
	    yc1=!evalsubst x=-20 in $[-1*$r]*(x-$x1)+$y1
	    yc2=!evalsubst x=20 in $[-1*$r]*(x-$x1)+$y1
	    CURVES=!append line line -20,$yc1,20,$yc2,red to $CURVES
	!next p

	etext=!record 1 of lang/remarks.$taal
	
	tooltip=!exec canvasdraw\
	size 320,320\
	xrange -20,20\
	yrange -20,20\
	bgcolor $wims_bgcolor\
	xlabel $letter1 -as\
	ylabel $letter2 -as\
	axis\
	grid 100,100,black,1,1,0,black\
	linewidth 1\
	$CURVES\
	linewidth 3\
	point $x1,$y1,green\
	string black,$x1,$y1,   $A ($x1:$y1)\
	intooltip $etext
	
	exotext=$tooltip <br />
    !endif
    
    helptext=<textarea readonly=\'readonly\' cols=\'25\' rows=\'2\' class=\'schaersvoorde_textarea\' >$letter4($letter1) = a*$letter1 + b</textarea><br /><textarea readonly=\'readonly\' cols=\'25\' rows=\'2\' class=\'schaersvoorde_textarea\' >$letter2 = -3$letter1 + 1/3</textarea>
    rr=!record 25 of lang/remarks.$taal
    question$n=<a onmouseover="return escape('$helptext')">$ss</a>
    textanswer$n=$rr

!endif

