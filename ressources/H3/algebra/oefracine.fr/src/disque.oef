\title{Périmètre et aire d'un disque}
\language{fr}
\author{Cyrielle,Danel; Antoine,Rousseau;Marie-Claude,David}
\email{Marie-Claude.David@math.u-psud.fr}

\matrix{L=2,3,5,7,11,13,17,19}
\integer{p=randint(\L)}
\integer{n=randint(1..5)}
\integer{N=2*\n}
\text{d=\(\N\sqrt{\p})}
\integer{M=\N*\N/4*\p}
\text{peri=\N*pi*sqrt(\p)}
\text{aire=pi*\M}

\statement{On considère un disque de diamètre \d.
<ul>
<li>Calculer la valeur exacte de son périmètre.<br>
Réponse : \embed{r1,15}</li>
<li>Calculer la valeur exacte de son aire.<br>
Réponse : \embed{r2,15}</li>
</ul>}


\answer{Périmètre}{\peri}{type=formal}
\answer{Aire}{\aire}{type=formal}
