\title{Calcul d'expression}
\language{fr}
\author{Cyrielle, Danel; Antoine, Rousseau;Marie-Claude,David}
\email{Marie-Claude.David@math.u-psud.fr}

\integer{b=randint(2..10)}
\integer{c=randint(1..10)}
\text{A = x² + \b x + \c}
\integer{p=random(2,3,5,7,11,13,17,19)}
\integer{n=randint(2..10)}
\text{x=\n\sqrt{\p}}
\text{sol=simplify(\n*\n*\p+\c)+simplify(\b*\n)*sqrt(\p)}

\statement{Calculer \(A=\A) pour \(x=\x).
<div class="wimscenter"> A = \embed{r1,15}</div>
<div class="wims_instruction">
Pour entrer "racine carrée de x", écrire
<span class="tt">sqrt(x)</span>.</div>
}

\answer{A}{\sol}{type=formal}

\feedback{1=1 }{La valeur de \(\A) pour \(x=\x) est \(\sol).}
