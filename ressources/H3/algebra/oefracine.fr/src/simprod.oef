\title{Calculer un produit.}
\language{fr}
\author{Fabrice,Guerimand;Sylvain,Aubert}
corrigé ajouté par Sylvain Aubert
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(2,3,5,6,7,10,11)}
\integer{b=random(2,3,5,6,7,10,11)}
\integer{ab2=\a*\b^2}
\integer{c=random(2,3,5)}
\integer{ac=\a*\c}
\integer{\ab2c=\ab2*\c}
\integer{ab=\a*\b}
\integer{a2b2=\a^2*\b^2}
\integer{a2=\a^2}
\integer{b2=\b^2}
\integer{a2b2c=\a2*\b2*\c}
\integer{a2c=\a^2*\c}

\matrix{don=\sqrt{\a}\times\sqrt{\ab2},\sqrt{\a}\times\sqrt{\ab2}=\sqrt{\a\times\ab2}=\sqrt{\a2b2}=\sqrt{\a2\times\b2}=\sqrt{\a2}\times\sqrt{\b2}=\a\times\b=\ab,\ab
\sqrt{\a}\times\sqrt{\a},\sqrt{\a}\times\sqrt{\a}=\sqrt{\a2}=\a,\a
\sqrt{\a}\times\sqrt{\ab2c},\sqrt{\a}\times\sqrt{\ab2c}=\sqrt{\a\times\ab2c}=\sqrt{\a2b2c}=\sqrt{\a2b2\times\c}=\sqrt{\a2b2}\times\sqrt{\c}=\sqrt{\a2\times\b2}\times\sqrt{\c}=\sqrt{\a2}\times\sqrt{\b2}\times\sqrt{\c}=\a\times\b\times\sqrt{\c}=\ab\times\sqrt{\c}=\ab\sqrt{\c},\ab*sqrt(\c),sqrt(\c)*\ab
\sqrt{\ac}\times\sqrt{\ab2},\sqrt{\ac}\times\sqrt{\ab2}=\sqrt{\ac\times\ab2}=\sqrt{\a2b2c}=\sqrt{\a2b2\times\c}=\sqrt{\a2b2}\times\sqrt{\c}=\sqrt{\a2\times\b2}\times\sqrt{\c}=\sqrt{\a2}\times\sqrt{\b2}\times\sqrt{\c}=\a\times\b\times\sqrt{\c}=\ab\times\sqrt{\c}=\ab\sqrt{\c},\ab*sqrt(\c),sqrt(\c)*\ab
\sqrt{\ac}\times\sqrt{\a},\sqrt{\ac}\times\sqrt{\a}=\sqrt{\ac\times\a}=\sqrt{\a2c}=\sqrt{\a2\times\c}=\sqrt{\a2}\times\sqrt{\c}=\a\times\sqrt{\c}=\a\sqrt{\c},\a*sqrt(\c),sqrt(\c)*\a
\sqrt{\a}\times\sqrt{\ac},\sqrt{\a}\times\sqrt{\ac}=\sqrt{\a\times\ac}=\sqrt{\a2c}=\sqrt{\a2\times\c}=\sqrt{\a2}\times\sqrt{\c}=\a\times\sqrt{\c}=\a\sqrt{\c},\a*sqrt(\c),sqrt(\c)*\a}



\text{list=randrow(\don)}
\text{enonce=item(1,\list)}
\text{rep=wims(item 3 to -1 of \list)}
\text{solution=item(2,\list)}

\integer{prec=random(1..3)}
\integer{rep2=item(1,\rep)*10^(\prec)}
\real{rep2=\rep2/10^(\prec)}
\text{rep2=\rep2}

\text{listprec=dixième,centième,millième}
\text{precision1=item(\prec,\listprec)}
\text{precision1= au \precision1}
\real{precision2=10^(-\prec)}
\text{precision2=à \(\precision2) près}
\text{precision=random(\precision1,\precision2)}

\statement{
<ol>
 <li>Ecrire le nombre \(\enonce) sous la forme \(a\sqrt{b}) où \(b\)
 est un entier positif le plus petit possible.</li>
 <li>Calculer son arrondi \precision.</li>
</ol>
<div class="wims_instruction">
Vous devez taper <span class="tt">sqrt(2)</span> pour \(\sqrt{2}\).
</div>}

\reply{Ecriture simplifiée}{\rep}{type=litexp}{weight=9}
\reply{Valeur approchée}{\rep2}{type=numexp}{weight=1}


\solution{La solution de la première question est :
<div class="wimscenter">\(\solution)</div>

Pour la deuxième question prends ta calculette.}
