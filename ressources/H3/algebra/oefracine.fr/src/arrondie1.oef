\language{fr}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\title{Valeur approchée d'une racine carrée.}

\integer{a=random(15..2000)}
\integer{b=random(0..2)}
\integer{prec=random(1..3)}
\real{a=\a/10^(\b)}
\text{enonce=\sqrt{\a}}
\integer{b=sqrt(\a)*10^(\prec)}
\real{rep=\b/10^(\prec)}
\text{rep=\rep}

\text{listprec=dixième,centième,millième}
\text{precision1=item(\prec,\listprec)}
\text{precision1= au \precision1}
\real{precision2=10^(-\prec)}
\text{precision2=à \(\precision2) près}
\text{precision=random(\precision1,\precision2)}

\statement{
Quel est l'arrondi \precision de \(\enonce\) ? }

\reply{Réponse}{\rep}{type=litexp}
