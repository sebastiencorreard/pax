\title{Ecriture réduite N1.}
\language{fr}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\text{list=2,3,5,6,7,10,11}
\integer{a=randitem(\list)}
\integer{b=randitem(\list)}
\integer{c=randitem(\list)}

\integer{a2=\a^2}
\integer{b2=\b^2}
\integer{b3=\b^3}
\integer{b2c=\b2*\c}
\integer{ab=\a*\b}
\integer{ac=\a*\c}
\integer{bc=\b*\c}
\integer{abc=\ab*\c}

\matrix{don=\sqrt{\a2},\a,0
\sqrt{\b3},\b,sqrt(\b)
\sqrt{\b2c},\b,sqrt(\c)
\sqrt{\a^2},\a,0
\sqrt{\a^3\times\b^2},\ab,sqrt(\a)
\c\sqrt{\a2},\ac,0
\c\sqrt{\b3},\bc,sqrt(\b)
\c\sqrt{\b2c},\bc,sqrt(\c)
\c\sqrt{\a^2},\ac,0
\c\sqrt{\a^3\times\b^2},\abc,sqrt(\a)}

\text{list=randrow(\don)}

\text{enonce=item(1,\list)}
\text{c1=item(2,\list)}
\text{c2=item(3,\list)}
\text{rep=\c2=0?\c1:\c1*\c2,\c2*\c1}

\text{lettre=randitem(A,B,C)}

\statement{
<div class="wimscenter">\(\lettre = \enonce\)</div>

Écrire \(\lettre\) sous la forme \(a\sqrt{b}\) où \(b\) est
un entier positif le plus petit possible.
<div class="wims_instruction">
Vous devez taper <span class="tt">sqrt(2)</span> pour \(\sqrt{2}\).
</div>}

\reply{\lettre}{\rep}{type=litexp}
