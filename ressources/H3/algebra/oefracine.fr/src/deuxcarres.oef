\title{Deux carrés}

\author{Cyrielle, Danel; Antoine, Rousseau;Marie-Claude, David}
\email{Marie-Claude.David@math.u-psud.fr}

\integer{  n=random(4..15)  }
\real{  N=\n*\n  }
\integer{  x=random(4..\N-4)  }
\real{ y=\N-\x}
\statement{Sur la figure, \(EFGH\) et \(HIJK\) sont des carrés.
Leurs aires valent respectivement \(x = \x\; cm^2) et \(y = \y\; cm^2).
Calculer la valeur exacte de la longueur \(GI).
<div class="wimscenter"> <img src="\imagedir/tice.jpg" alt=""></div>

La valeur de \(GI\) est \embed{r1,15} \(cm\)
}

\answer{La valeur de la longueur \(GI) est}{\n}{type=units}

\help{
L'aire d'un carré de côté \(a cm) est \(a^2 cm²).
}

\solution{Il faut appliquer le théorème de Pythagore au triangle rectangle \(GHI).}
