\title{Développer/réduire 1.}
\language{fr}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{val=shuffle(2,3,5,6,7,10,11)}
\integer{a=item(1,\val)}
\integer{d=item(2,\val)}
\integer{g=gcd(\a,\d)}
\integer{d=\g!=1?13}
\integer{c=random(2..10)}
\integer{b=random(2..10)}

\matrix{don=(\sqrt{\a}+\b)(\sqrt{\a}-\b),\a-\b^2,0,0
(\b+\sqrt{\a})(\b-\sqrt{\a}),\b^2-\a,0,0
(\sqrt{\a}+\sqrt{\d})(\sqrt{\a}-\sqrt{\d}),\a-\d,0,0
(\b+\sqrt{\a})^2,\b^2+\a,2*\b,\a
(\sqrt{\a}+\b)^2,\b^2+\a,2*\b,\a
(\b-\sqrt{\a})^2,\b^2+\a,-2*\b,\a
(\sqrt{\a}-\b)^2,\b^2+\a,-2*\b,\a
(\sqrt{\a}+\sqrt{\d})^2,\a+\d,2,\a*\d
(\sqrt{\a}-\sqrt{\d})^2,\a+\d,-2,\a*\d
(\c\sqrt{\a}+\sqrt{\d})(\sqrt{\a}-\c\sqrt{\d}),\c*\a-\c*\d,1-\c^2,\a*\d
(\c\sqrt{\a}+\b)(\c\sqrt{\a}-\b),\c^2*\a-\b^2,0,0
(\b+\c\sqrt{\a})(\b-\c\sqrt{\a}),\b^2-\a*\c^2,0,0
(\b+\c\sqrt{\a})^2,\b^2+\c^2*\a,2*\b*\c,\a
(\c\sqrt{\a}+\b)^2,\b^2+\c^2*\a,2*\b*\c,\a
(\b-\c\sqrt{\a})^2,\b^2+\c^2*\a,-2*\b*\c,\a
(\c\sqrt{\a}-\b)^2,\b^2+\c^2*\a,-2*\b*\c,\a
(\c\sqrt{\a}+\sqrt{\d})^2,\c^2*\a+\d,2*\c,\a*\d}

\text{donnees=randrow(\don)}
\text{enonce=item(1,\donnees)}
\text{b=simplify(item(2,\donnees))}
\text{sb=\b<0?-:+}
\text{Db=\b<0?-:}
\integer{b=abs(\b)}
\text{a=simplify(item(3,\donnees))}
\text{sa=\a<0?-:+}
\text{Da=\a<0?-:}
\integer{a=abs(\a)}

\text{base=simplify(item(4,\donnees))}

\text{rep=\a=0?\Db\b:\Da\a*sqrt(\base)\sb\b,\Da sqrt(\base)*\a\sb\b,\Db\b\sa\a*sqrt(\base),\Db\b\sa sqrt(\base)*\a}

\statement{
Développer et réduire l'expression \(\enonce).
<div class="wims_instruction">
Vous devez taper <span class="tt">sqrt(2)</span> pour \(\sqrt{2}).
</div>}

\reply{Réponse}{\rep}{type=litexp}
