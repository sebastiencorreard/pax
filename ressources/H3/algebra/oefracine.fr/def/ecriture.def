!set title=Ecriture réduite N1.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2,3,5,6,7,10,11
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint($val7^2)]
val11=$[rint($val8^2)]
val12=$[rint($val8^3)]
val13=$[rint($val11*$val9)]
val14=$[rint($val7*$val8)]
val15=$[rint($val7*$val9)]
val16=$[rint($val8*$val9)]
val17=$[rint($val14*$val9)]
tmp=!trim \sqrt{$val10},$val7,0	\sqrt{$val12},$val8,sqrt($val8)	\sqrt{$val13},$val8,sqrt($val9)	\sqrt{$val7^2},$val7,0	\sqrt{$val7^3\times$val8^2},$val14,sqrt($val7)	$val9\sqrt{$val10},$val15,0	$val9\sqrt{$val12},$val16,sqrt($val8)	$val9\sqrt{$val13},$val16,sqrt($val9)	$val9\sqrt{$val7^2},$val15,0	$val9\sqrt{$val7^3\times$val8^2},$val17,sqrt($val7)
val18=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val18

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val19=$(tmp0)
tmp0=!item 2 of $val6

val20=$(tmp0)
tmp0=!item 3 of $val6

val21=$(tmp0)

!ifval $val21=0
val22=$val20
!else
val22=$val20*$val21,$val21*$val20
!endif
tmp=!nonempty items A,B,C

tmp0=!randitem $tmp
val23=$(tmp0)
replytype1=litexp
replyname1=$val23
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">
!insmath $val23 = $val19
$()</div>		Écrire 
!insmath $val23
$() sous la forme 
!insmath a\sqrt{b}
$() où 
!insmath b
$() est	un entier positif le plus petit possible.	<div class="wims_instruction">	Vous devez taper <span class="tt">sqrt(2)</span> pour 
!insmath \sqrt{2}
$().	</div>
$()
!exit

