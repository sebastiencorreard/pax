!set title=Périmètre et aire d'un disque
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrielle,Danel; Antoine,Rousseau;Marie-Claude,David
email=Marie-Claude.David@math.u-psud.fr
language=fr

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 2,3,5,7,11,13,17,19
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint $val6

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
val9=$[rint(2*$val8)]
val10=\($val9\sqrt{$val7})
val11=$[rint($val9*$val9/4*$val7)]
val12=$val9*pi*sqrt($val7)
val13=pi*$val11
replytype1=formal
replyname1=Périmètre
replygood1=$val12
replytype2=formal
replyname2=Aire
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère un disque de diamètre $val10.	<ul>	<li>Calculer la valeur exacte de son périmètre.<br>	Réponse :  
!read oef/embed.phtml r1,15 
$()</li>	<li>Calculer la valeur exacte de son aire.<br>	Réponse :  
!read oef/embed.phtml r2,15 
$()</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=2
