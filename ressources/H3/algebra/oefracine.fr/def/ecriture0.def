!set title=Ecriture réduite N0.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand;Paul,Byache
email=byachepaul@yahoo.fr
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2,3,5,6
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val9=$[rint($val7^2)]
val10=$[rint($val7^3)]
val11=$[rint($val9*$val8)]
tmp=!trim \sqrt{$val10},$val7,sqrt($val7)	\sqrt{$val11},$val7,sqrt($val8)
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val13=$(tmp0)
tmp0=!item 2 of $val6

val14=$(tmp0)
tmp0=!item 3 of $val6

val15=$(tmp0)

!ifval $val15=0
val16=$val14
!else
val16=$val14*$val15,$val15*$val14
!endif
tmp=!nonempty items A,B,C

tmp0=!randitem $tmp
val17=$(tmp0)
replytype1=litexp
replyname1=$val17
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">
!insmath $val17 = $val13
$()</div>		Ecrire 
!insmath $val17
$() sous la forme 
!insmath a\sqrt{b}
$() où 
!insmath b
$() est un entier	positif le plus petit possible.<br>	(vous devez taper sqrt(2) pour 
!insmath \sqrt{2}
$() ou alors cliquer sur le	bouton :	 <INPUT TYPE="button" VALUE="&radic;"	 onClick=a=document.replyform.reply1.value;document.replyform.reply1.value=a+"sqrt&#40;";document.replyform.reply1.focus();>	 )
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La bonne réponse est : 
!insmath $(val16[1])
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,16,17
embedcnt=0
