 !exit
!endif

tmp0=!randint 15, 2000

val6=$[rint($(tmp0))]
tmp0=!randint 0, 2

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
val6=$[$val6/10^($val7)]
val9=\sqrt{$val6}
val7=$[rint(sqrt($val6)*10^($val8))]
val10=$[$val7/10^($val8)]
val10=$val10
val11=dixième,centième,millième
tmp0=!item $val8 of $val11

val12=$(tmp0)
val12=au $val12
val13=$[10^(-$val8)]
val13=à \($val13) près
tmp0=!randitem $val12,$val13

val14=$(tmp0)
replytype1=litexp
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

