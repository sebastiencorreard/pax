!set title=Deux carrés
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrielle, Danel; Antoine, Rousseau;Marie-Claude, David
email=Marie-Claude.David@math.u-psud.fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 15

val6=$[rint($(tmp0)  )]
val7=$[$val6*$val6  ]
tmp0=!randint 4, $val7-4

val8=$[rint($(tmp0)  )]
val9=$[$val7-$val8]
replytype1=units
replyname1=La valeur de la longueur \(GI) est
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Sur la figure, 
!insmath EFGH
$() et 
!insmath HIJK
$() sont des carrés.	Leurs aires valent respectivement 
!insmath x = $val8\; cm^2
$() et 
!insmath y = $val9\; cm^2
$().	Calculer la valeur exacte de la longueur 
!insmath GI
$().	<div class="wimscenter"> <img src="$val1/tice.jpg" alt=""></div>		La valeur de 
!insmath GI
$() est  
!read oef/embed.phtml r1,15 
$() 
!insmath cm
$()	
$()
!exit

