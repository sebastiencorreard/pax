val6=50x50x50
val7=$[rint(3)]
tmp=!nonempty items 5,6,7,8,10,11,12,13,14,15,17,18,18,20

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val9=\(\sqrt{$val8})
tmp0=!values v for v=2 to 13

val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
val11=$[rint($(val10[1]))]
val12=$[rint($val11^2)]
val13=$[rint($(val10[2]))]
val14=\($val13^2)
tmp0=!randint 1, 9

val15=$[rint($(tmp0))]
val15=$[$val15/10]
val16=$[$val15^2]
tmp0=!randint 3, 13

val17=$[rint($(tmp0))]
val18=$[rint($val17^2)]
val17=\(\frac{1}{$val17})
val18=\(\frac{1}{$val18})
tmp0=!randitem 2,4,8,10,11

val19=$[rint($(tmp0))]
tmp0=!randitem 3,9,7,13

val20=$[rint($(tmp0))]
val21=$[rint($val19^2)]
val22=$[rint($val20^2)]
val23=\(\frac{$val19}{$val20})
val24=\(\frac{$val21}{$val22})
tmp0=!randitem 1,-1

tmp1=!randint 2, 9

val25=$[rint($(tmp0)*$(tmp1))]
val26=$[rint(2*$val25)]
val25=\(10^{$val25})
val26=\(10^{$val26})
tmp0=!randint 2, 9

val19=$[rint($(tmp0))]
tmp0=!randitem 1,-1

tmp1=!randint 2, 9

val27=$[rint($(tmp0)*$(tmp1))]
val28=$[rint(2*$val27)]
val27=\($val19^{$val27})
val28=\($val19^{$val28})
tmp=!trim $val8,$val16,$val12,$val14,$val18,$val24,$val26,$val28	$val9,$val15,$val11,$val13,$val17,$val23,$val25,$val27
val29=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 8

val30=$(tmp0)
tmp=!translate internal $	$ to ; in $val29

tmp=!column $(val30[1 to $val7]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)
val31=!translate internal $	\
$ to ;; in $tmp
replytype1=correspond
replyname1=La correspondance
replygood1=$val31
