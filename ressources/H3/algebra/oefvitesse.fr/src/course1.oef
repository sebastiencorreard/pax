\title{Course à pieds 1}

\email{paul@byache.fr}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand; Paul, Byache}
\keywords{velocity}
\computeanswer{no}
\format{html}
\precision{10000}
\matrix{donnees=100,12,20
200,24,45
1000,180,360
10000,2100,3599}
\text{donnees=randrow(\donnees)}
\integer{distance=item(1,\donnees)}
\integer{timemin=item(2,\donnees)}
\integer{timemax=item(3,\donnees)}
\integer{duree=randint(\timemin..\timemax)}
\integer{Mduree=floor(\duree/60)}
\integer{Sduree=\duree-\Mduree*60}
\text{time=\Mduree!=0?\Mduree mn}
\text{time=\Sduree!=0?\time \Sduree s}
\text{name=slib(lang/fname fr,boy)}
\text{arrname=dixième,centième}
\integer{ch=random(1..2)}
\real{tmp=1/10^\ch}
\integer{t=random(1..2)}
\text{narrondie=\t=1?au item(\ch,\arrname):à \tmp}
\integer{rep1=\distance/\duree*10^\ch}
\real{rep1=\rep1/10^\ch}
\integer{rep2=3.6*\distance/\duree*10^\ch}
\real{rep2=\rep2/10^\ch}

\statement{
\name effectue une course à pieds de \distance m. Le chronomètre indique : \duree s.
<p>Donner sa vitesse moyenne en m/s.</p>
<div>
<b>Votre réponse</b> :
Vitesse moyenne : \embed{r1,8}.
</div><br/>
<div class="wims_instruction">
Les résultats seront arrondis \narrondie près. Préciser l'unité.
</div>
}
\answer{Vitesse moyenne :}{\rep1 m/s}{type=unit}
