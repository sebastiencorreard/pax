\title{En voiture ! (2)}
\email{paul@byache.fr}
\language{fr}
\author{Paul, Byache}
\computeanswer{no}
\format{html}
\keywords{velocity}
\precision{10000}
\integer{type=random(1,2,3)}
\integer{vitesse=randint(50..120)}
\integer{h=randint(0..3)}
\integer{m=randint(0..9)*6}
\real{duree=\h+(\m/60)}
\text{dureetexte= \h!=0 ? \h h}
\text{dureetexte= \m!=0 ? \dureetexte \m min}
\real{distance=\vitesse*\duree}

\text{numero= \type=1 ? 2,3 : 1,2}
\text{numero= \type=2 ? 1,3}
\text{donnee=wims(item \numero of J'ai roulé pendant \dureetexte (\duree heure).,J'ai parcouru une distance de \distance km.,Ma vitesse moyenne a été de \vitesse km/h.)}
\text{question=item(\type,Quelle a été la durée totale <b>(en heure)</b> de mon parcours en voiture,Quelle distance ai-je parcouru (en km),Quelle a été ma vitesse moyenne (en km/h))}
\text{reponse=item(\type,\duree h,\distance km,\vitesse km/h)}
\text{phrasereponse=item(\type,La durée totale de mon parcours a été :,La distance que j'ai parcourue a été de :,J'ai roulé à une vitesse moyenne de :)}

\statement{
<div class="float_right"><img src="\imagedir/voiture_001.gif" style="width:250px" alt="" />
</div>
Aujourd'hui, j'ai utilisé ma voiture.
<br/>\donnee[1]<br/>\donnee[2]
<p>\question ?</p>
<div>\phrasereponse \embed{r1,8}.</div><br/>
<div class="wims_instruction">Préciser l'unité.</div>.}
\answer{}{\reponse}{type=unit}
