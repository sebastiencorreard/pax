\text{data=randomrow(\data)}

\integer{vitesse=\data[5]}
\text{nom=\data[1]}
\real{tj=\data[3]}
\real{ts=\data[4]}
\real{rayon=\data[2]}
\real{circ=2*pi*\rayon}

\statement{La \nom fait le tour du soleil en \tj jours (\ts s).
<br/>Elle se trouve à une distance moyenne du soleil de \rayon x \(10^6) km.
<p>Quelle est sa vitesse moyenne en km/s ?</p>
<p class="wims_instruction">Arrondir à l'unité.</p>
<div>
La vitesse moyenne de la \nom est de : \embed{r1,5} km/s.
</div>}
\answer{Vitesse moyenne :}{\vitesse}{type=numeric}

\hint{La trajectoire de la \nom autour du soleil est approximativement un cercle
de rayon \rayon millions de km.
<br/>La longueur de ce cercle est : \(2*pi*\rayon) (en millions de km)...}
