!set title=C'est astronomique !
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=paul@byache.fr
author=Paul, Byache
keywords=velocity
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim planète Mercure,58,88,7603200,47.93,4878,74753832.77,60774866039.91	planète Vénus,108,225,19440000,34.91,12104,460264736.85,928507395798.2	planète Mars,228,687,59356800,24.13,6794,145011003.44,164200792893.86	Terre,150,365.25,31557600,29.87,12756,511185932.52,1086781292542.89
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$[rint($(val6[5]))]
val8=$(val6[1])
val9=$[$(val6[3])]
val10=$[$(val6[4])]
val11=$[$(val6[2])]
val12=$[2*pi*$val11]
replytype1=numeric
replyname1=Vitesse moyenne :
replygood1=$[$val7]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La $val8 fait le tour du soleil en $val9 jours ($val10 s).	<br/>Elle se trouve à une distance moyenne du soleil de $val11 x 
!insmath 10^6
$() km.	<p>Quelle est sa vitesse moyenne en km/s ?</p>	<p class="wims_instruction">Arrondir à l'unité.</p>	<div>	La vitesse moyenne de la $val8 est de :  
!read oef/embed.phtml r1,5 
$() km/s.	</div>
$()
!exit

:hint
$()La trajectoire de la $val8 autour du soleil est approximativement un cercle	de rayon $val11 millions de km.	<br/>La longueur de ce cercle est : 
!insmath 2*pi*$val11
$() (en millions de km)...
$()
!exit

