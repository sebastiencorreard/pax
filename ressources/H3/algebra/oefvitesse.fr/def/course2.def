!set title=Course à pieds 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=paul@byache.fr
author=Fabrice,Guerimand; Paul, Byache
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 100,12,20	200,24,45	1000,180,360	10000,2100,3599
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val8=$[rint($(tmp0))]
tmp0=!item 3 of $val6

val9=$[rint($(tmp0))]
tmp0=!randint $val8, $val9

val10=$[rint($(tmp0))]
val11=$[rint(floor($val10/60))]
val12=$[rint($val10-$val11*60)]

!ifval $val11!=0
val13=$val11 mn
!endif

!ifval $val12!=0
val13=$val13 $val12 s
!endif
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val14=$(tmp0)
val15=dixième,centième
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
val17=$[1/10^$val16]
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]

!ifval $val18=1
tmp0=!item $val16 of $val15

val19=au $(tmp0)
!else
val19=à $val17
!endif
val20=$[rint($val7/$val10*10^$val16)]
val20=$[$val20/10^$val16]
val21=$[rint(3.6*$val7/$val10*10^$val16)]
val21=$[$val21/10^$val16]
replytype1=units
replyname1=Vitesse moyenne :
replygood1=$val20 m/s
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14 effectue une course à pieds de $val7 m.	Le chronomètre indique : $val13.	<p>Donner sa vitesse moyenne en m/s.</p>		<div>	<b>Votre réponse</b> :	Vitesse moyenne :  
!read oef/embed.phtml r1,8 
$().	</div><br/>	<div class="wims_instruction">	Les résultats seront arrondis $val19 près. Préciser l'unité.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,13,14,19
embedcnt=1
