!set title=En voiture ! (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=paul@byache.fr
author=Paul, Byache
keywords=velocity
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 120

val6=$[rint($(tmp0))]
tmp0=!randint 0, 3

val7=$[rint($(tmp0))]
tmp0=!randint 0, 9

val8=$[rint($(tmp0)*6)]
val9=$[$val7+($val8/60)]

!ifval $val7!=0 
val10= $val7 h
!endif

!ifval $val8!=0 
val10= $val10 $val8 min
!endif
val11=$[$val6*$val9]
replytype1=units
replyname1=Vitesse moyenne :
replygood1=$val6 km/h
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right">	<img src="$val1/voiture_014.gif" style="width:250px" alt="" /></div>	Aujourd'hui, avec ma voiture, j'ai roulé pendant $val10 ($val9 heure(s)).	<br/>J'ai parcouru une distance de $val11 km.	<p>Quelle a été ma vitesse moyenne en km/h ?</p>	<div>	Ma vitesse moyenne a été de :  
!read oef/embed.phtml r1,8 
$().	</div><br/>	<div class="wims_instruction">Préciser l'unité.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,9,10,11
embedcnt=1
