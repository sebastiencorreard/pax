tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$[$(val6[6])]
val8=$[$(val6[7])]
val9=$[$(val6[8])]
