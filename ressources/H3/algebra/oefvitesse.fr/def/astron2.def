val14=$(tmp0)
tmp0=!item $val11 of $val8 km^2 #$val12,$val9 km^3 #$val12

val15=$(tmp0)

!ifval $val13=1 
val16= chiffre 
!else
val16= chiffres
!endif

!ifval $val11=1 
val17= Quelle 
!else
val17= Quel
!endif
