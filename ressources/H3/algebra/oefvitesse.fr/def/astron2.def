tmp=!trim planète Mercure,58,88,7603200,47.93,4878,74753832.77,60774866039.91	planète Vénus,108,225,19440000,34.91,12104,460264736.85,928507395798.2	planète Mars,228,687,59356800,24.13,6794,145011003.44,164200792893.86	Terre,150,365.25,31557600,29.87,12756,511185932.52,1086781292542.89
