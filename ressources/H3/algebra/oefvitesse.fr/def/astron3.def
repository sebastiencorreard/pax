!endif

tmp=!trim planète Mercure,58,88,7603200,47.93,4878,74753832.77,7.475e7	planète Vénus,108,225,19440000,34.91,12104,460264736.85,4.603e8	planète Mars,228,687,59356800,24.13,6794,145011003.44,1.450e8	Terre,150,365.25,31557600,29.87,12756,511185932.52,5.112e8
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$[$(val6[6])]
val8=$[$(val6[8])]
val9=$(val6[1])
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
val12=$[rint($val11 - 1)]

!ifval $val12=1 
val13= chiffre 
!else
val13= chiffres
!endif
replytype1=sigunits
replyname1=
replygood1=$val7 km #$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

