# inklemmen snijpunten
n=$counter
!if $n=1
    var3=!shuffle -5,-4,-3,-2,-1,2,3,4,5
!endif
questiontype=7
javascript=js/inklemmen.js
checkfile=exos/checkfile1.proc
cols=4
inputs=yes
mathview=0
!if $level=0
    R=$counter
!else
    R=$level
!endif
rounding=100
dec=2
htxt=!record 1 of lang/remarks.$taal
#@x-as,y-as,parabool,lijn,snijpunten,boven,onder,invullen in,uitrekenen,afgerond op $dec decimalen,Zie tabel,Dit plaatje heeft een actieve muis,linker,rechter,wortel functie,machts functie,exponenti&euml;le functie
roundingtext=!record 10 of lang/remarks.$taal
#Bepaal je antwoord via inklemming<br />en geef je antwoord op 2 decimalen nauwkeurig
attentie=!record 11 of lang/remarks.$taal
xas=!item 1 of $htxt
yas=!item 2 of $htxt
parabool=!item 3 of $htxt
lijn=!item 4 of $htxt
snijpunten=!item 5 of $htxt
invullen=!item 8 of $htxt
uitrekenen=!item 9 of $htxt
afgerond=!item 10 of $htxt
zie_tabel=!item 11 of $htxt
actievemuis=!item 12 of $htxt
typefunctie=!item 15 of $htxt
linker=$empty
ss=!record 2 of lang/remarks.$taal
#@Gegeven de $functie <em>f</em> en een lijn <em>g</em><br />Bepaal via <span style="color:blue">inklemming</span> de <em>x-waarde</em> van het $linker snijpunt.

xmin=-10
xmax=10
ymin=-10
ymax=10
a=!item $n of $var3
#!randitem -5,-4,-3,-2,-1,2,3,4,5
b=!randitem 1,2,4,5,8,10
e=!randitem 1,5/2,3/2,2
!if $a>0
    c=$[ceil(-1*$b/$a)]
    d=!randitem -8,$c
!else
    c=$[floor(-1*$b/$a)]
    d=!randitem $c,8
!endif
p=!exec pari $e*$d
!if $p=0
    f2=$e*x
!else
    f2=!rawmath $e*x + $p
!endif
f1=!rawmath sqrt($a*x + $b)
F1=\sqrt{$a \cdot x + $b}
f1=!nospace $f1
f2=!nospace $f2
F2=!texmath $f2
formula$n=\left[ \begin{array}{ll} \textrm{$typefunctie : } &  f(x) = $F1 \\ \textrm{$lijn : } &  g(x) = $F2  \\ \textrm{$afgerond}\end{array} \right.
A=$[$e*$e]
B=$[2*$e*$p-$a]
C=$[$p*$p-$b]
x1=$[(round($rounding*((-1*$B-sqrt($B*$B-4*$A*$C))/(2*$A))))/$rounding]
x2=$[(round($rounding*((-1*$B+sqrt($B*$B-4*$A*$C))/(2*$A))))/$rounding]
y1=$[(round($rounding*($e*$x1+$p)))/$rounding]
y2=$[(round($rounding*($e*$x2+$p)))/$rounding]
!if $y1>0
    xs=$x1
    ys=$y1
!else
    xs=$x2
    ys=$y2
!endif
answer$n=$xs,$ys
    
rr=\left[ \begin{array}{l} \textrm{$snijpunten : $typefunctie = $lijn } \\ $F1 = $F2 \\ \textrm{$afgerond} \\ x_{s} \simeq $xs \\ \textrm{$zie_tabel} \end{array} \right.

!if $xs>$xmax
    xmax=$[$xs+6]
!else
    !if $xs<$xmin
	xmin=$[$xs-6]
    !endif
!endif
!if $ys>$ymax
    ymax=$[$ys+6]
!else
    !if $ys<$ymin
	ymin=$[$ys-6]
    !endif
!endif
    
xsize=320
ysize=320
data=debug no\
coordinates yes\
precision 1\
xrange $xmin,$xmax\
yrange $ymin,$ymax\
text 0.6*$xmax,-0.5,ariel,14,$xas,black\
textup -0.5,0.6*$ymax,-90,ariel,14,$yas,black\
linewidth 2\
vline 0,0,black,120\
hline 0,0,black,120\
linewidth 2\
plotjump 100\
curve $f1,red,160\
curve $f2,green,160\
linewidth 6\
points $(answer$n),blue
        
myname=$counter.data
!filewrite getfile/$myname $data

tablebody=$empty
diff=0.95,0.98,0.99,1.00,1.01,1.02
begin=$[$xs-1]
!for p=1 to 6
    d=!item $p of $diff
    s=$[$begin+$d]
    yl=!evalsubst x=($s) in $f1
    yr=!evalsubst x=($s) in $f2
    yl=$[(round(100*$yl))/100]
    yr=$[(round(100*$yr))/100]
    !if $s != $xs
	tablebody=!append line <tr><td>$s</td><td>$yl</td><td>$yr</td></tr> to $tablebody
    !else
	tablebody=!append line <tr><td style="background-color:lightgreen;color:red;font-size:120%">$s</td><td style="background-color:lightgreen;color:red;font-size:120%">$yl</td><td style="background-color:lightgreen;color:red;font-size:120%">$yr</td></tr> to $tablebody
    !endif
!next p
tt=<table style="text-align:center"><tr><th >x</th><th><em>f(x)</em></th><th><em>g(x)</em></th></tr>$tablebody</table>

textanswer$n=$tt
texanswer$n=$rr
var1=$f1
var2=$f2

question$n=<a onmouseover="return escape('<table><tr><td><object id=\'FlyApplet\' width=\'$xsize\' height=\'$ysize\' classid=\'java:FlyApplet.class\' type=\'application/x-java-applet;jpi-version=1.4\'><param name = \'java_codebase\' value = \'$appletdir\' /><param name = \'java_archive\' value = \'FlyApplet.jar\' /><param name = \'java_code\' value = \'FlyApplet.class\' /><param name=\'file\' value=\'$wims_ref_name?session=$session&cmd=getfile&special_parm=$myname\'/>$nojava</object></td><td>$actievemuis<hr />$attentie</td></tr></table>')">$ss</a>

helptext=<img src=\'$module_dir/gifs/inklemmen.jpg\' alt=\'noalt\' /><hr />$attentie

