# snijpunten via inklemmen lastiger
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
#### nog maar 1 niveau
R=1
###
questiontype=7
javascript=js/inklemmen.js
cols=3
inputs=yes
math=0
mathview=0
rounding=100
dec=2
htxt=!record 1 of lang/remarks.$taal
#@x-as,y-as,parabool,lijn,snijpunten,boven,onder,invullen in,uitrekenen,afgerond op $dec decimalen,Zie tabel
roundingtext=!record 10 of lang/remarks.$taal
#Bepaal je antwoord via inklemming<br />en geef je antwoord op 2 decimalen nauwkeurig
checkfile=exos/checkfile1.proc
xas=!item 1 of $htxt
yas=!item 2 of $htxt
typefunctie=!item 3 of $htxt
lijn=!item 4 of $htxt
snijpunten=!item 5 of $htxt
invullen=!item 8 of $htxt
afgerond=!item 10 of $htxt
actievemuis=!item 12 of $htxt
welksnijpunt=!randitem 13,14
linker=!item $welksnijpunt of $htxt
keuze=!randint 0,1
attentie=!record 11 of lang/remarks.$taal
        
!if $R=1
    #!if $R=2
    b=!randitem 2,3,4,5
    a=!randitem 2,3,4,5,-2,-3,-4,-5
    c=!randitem 4,6,8,10,12
    pm=!randitem +,-
    x1=!randitem -6,-5,-4,-3,-2,-1
    x2=!randitem 1,2,3,4,5,6
    y1=$[$a*$x1*$x1 $pm $b*$x1 - $c ]
    y2=$[$a*$x2*$x2 $pm $b*$x2 -$c ]
    f1=!nospace $a*x^2 $pm $b*x - $c
    F1=$a\cdot x^2 $pm $b\cdot x - $c
    punten=points red,$x1,$y1,$x2,$y2
    tot=!exec pari A = ((($y1)-($y2))/(($x1)-($x2)))*x + ($y1) -($x1)*(($y1)-($y2))/(($x1)-($x2))\
    printtex(A)
    f2=!line 1 of $tot
    f2=!nospace $f2
    F2=!line 2 of $tot
!endif

!if $welksnijpunt=13
    # we vragen alleen linker snijpunt
    !if $x1<$x2
	punt=$x1,$y1
	answer$n=$x1
    !else
	punt=$x2,$y2
	answer$n=$x2
    !endif
!else
    # we vragen alleen linker snijpunt
    !if $x1<$x2
	punt=$x2,$y2
	answer$n=$x1
    !else
	punt=$x1,$y1
	answer$n=$x1
    !endif
!endif
diff1=0.8,0.9,0.95,0.99,1.00,1.01,1.05
diff2=0.7,0.94,0.99,1.00,1.01,1.1,1.2
r=1
!for xx in $x1,$x2
    tablebody=$empty
    begin=$[$xx-1]
    !for p=1 to 8
	d=!item $p of $(diff$r)
	s=$[$begin+$d]
	yl=!evalsubst x=($s) in $f1
	yr=!evalsubst x=($s) in $f2
	yl=$[(round($rounding*$yl))/$rounding]
	yr=$[(round($rounding*$yr))/$rounding]
	!if $s != $xx
	    tablebody=!append word $ <tr><td>$s</td><td>$yl</td><td>$yr</td></tr> $ to $tablebody
	!else
	    k=lightgreen
	    tablebody=!append word $ <tr><td style="background-color:$k;color:red;font-size:120%">$s</td><td style="background-color:$k;color:red;font-size:120%">$yl</td><td style="background-color:$k;color:red;font-size:120%">$yr</td></tr> $ to $tablebody
	!endif
    !next p
    t$r=<table class="zebra_table_v2"><tr><th >x</th><th><i>f(x)</i></th><th><i>g(x)</i></td></tr>$tablebody</table>
    !increase r
!next xx
textanswer$n=<table style="text-align:center"><tr><th>x<sub>1</sub></th><th>x<sub>2</sub></th></tr><tr><td>$t1</td><td>$t2</td></tr></table>
  
formula$n=\left[\begin{array}{ll}\textrm{$typefunctie : } & f(x) = $F1 \\ \textrm{$lijn : } & g(x) = $F2 \\ \textrm{$afgerond} & \end{array} 
ss=!record 2 of lang/remarks.$taal

rr=\left[ \begin{array}{l}\textrm{$snijpunten :  $typefunctie = $lijn } \\ f(x) = g(x) \\ $F1 = $F2 \\  x_{1} \simeq $x1 \wedge x_{2} \simeq $x2 \\ \textrm{$zie_tabel}\end{array} 

xmin=$[(min($x2,$x1)) - 10]
ymin=$[(min($y2,$y1)) - 20]
xmax=$[(max($x2,$x1)) + 10]
ymax=$[(max($y2,$y1)) + 20]
!if $ymin>0
    ymin=-20
!endif
!if $ymax<0
    ymax=20
!endif
!if $xmin>0
    xmin=-10
!endif
!if $xmax<0
    xmax=10
!endif

question$n=<a onmouseover="return escape('$actievemuis<p>$attentie')">$ss</a>
texanswer$n=$rr
helptext=<img src=\'$module_dir/gifs/inklemmen.jpg\' alt=\'noalt\' /><br />$attentie




!if $teaching=1
xsize=300
ysize=300
tiptxt=!record 63 of $remarkdir/commonremarks.$taal
!if $ymin>$ymax
 tmp=$ymin
 ymin=$ymax
 ymax=$tmp
!endif

xstep=$[abs(($xmax-$xmin)/10)]
ystep=$[abs(($ymax-$ymin)/10)]

tip=!exec canvasdraw\
size $xsize,$ysize\
xrange $xmin,$xmax\
yrange $ymin,$ymax\
bgcolor $wims_bgcolor\
xlabel    $xas\
ylabel    $yas\
axis\
grid $xstep,$ystep,grey,2,2,6,black\
linewidth 2\
jscurve red,$f1\
jscurve green,$f2\
linewidth 3\
point $punt,blue\
intooltip $tiptxt\
zoom black\
precision 10\
mouse blue,22\
precision 1000

exotext=<span class="schaersvoorde_link">$tip</span><br />

!endif