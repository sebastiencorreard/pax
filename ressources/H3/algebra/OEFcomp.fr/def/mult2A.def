!set title=Multiplication et fractions 2A
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
title_it=Moltiplicazioni e frazioni 2A
title_es=Multiplicación y fracciones 2A

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!values v for v=2 to 15

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=\frac{$(val7[1])}{$(val7[2])}\times\frac{-$(val7[3])}{$(val7[4])}
val9=\frac{$(val7[5])}{$(val7[2])}\times\frac{-$(val7[3])}{$(val7[4])}

!ifval $(val7[1])<$(val7[5])
val10=2
!else
val10=1
!endif
val11=1
tmp=!trim ,	,-	-,	-,-
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
!if $val11=0 

!ifval $val13=2
val10=2
!endif

!ifval $val13=3
val10=1
!endif
!else

!ifval $val13=2
val10=1
!endif

!ifval $val13=3
val10=2
!endif
!endif

!ifval $val13=4 and $val10!=3
val10=-$val10+3
!endif
val8=$(val12[1])$val8
val9=$(val12[2])$val9
val14=<span class="larger"><</span>,<span class="larger">></span>,<span class="larger">=</span>
tmp0=!item $val10 of $val14

val10=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
val15=Comparer les deux expressions suivantes :
val16=Symbole
!endif
!if $val6=it 
val15=Confrontare le due espressioni seguenti:
val16=Simbolo
!endif
!if $val6=es 
val15=Compare las dos expresiones siguientes:
val16=Símbolo
!endif
replytype1=clickfill
replyname1=$val16
replygood1=$val10|$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val15	<div class="wimscenter">	 
!insmath $val8
$()  
!read oef/embed.phtml r1,30x30x1 
$() 
!insmath $val9
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

