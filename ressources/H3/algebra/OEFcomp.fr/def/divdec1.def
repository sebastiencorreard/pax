title_es=División y decimales 1

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 101, 999

val7=$[$(tmp0)/100]
tmp0=!randint 101, 999

val8=$[$(tmp0)/100]
tmp0=!randint 1001, 1999

val9=$[$(tmp0)/100]
val10=$val7 \ : \ $val9
val11=$val8 \ : \ $val9

!ifval $val7<$val8
val12=1
!else
val12=2
!endif
val13=0

!ifval $val7=$val8
val12=3
!endif
tmp=!trim ,	,-	-,	-,-
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val15=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val15 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
!if $val12!=3 
!if $val13=0 

!ifval $val15=2
val12=2
!endif

!ifval $val15=3
val12=1
!endif
!else

!ifval $val15=2
val12=1
!endif

!ifval $val15=3
val12=2
!endif
!endif

!ifval $val15=4
val12=-$val12+3
!endif
!endif
val10=$(val14[1]) $val10
val11=$(val14[2]) $val11
val16=<span class="larger"><</span>,<span class="larger">></span>,<span class="larger">=</span>
tmp0=!item $val12 of $val16

val12=$(tmp0)
tmp0=!texmath $val10

val17=$(tmp0)
tmp0=!texmath $val11

val18=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
val19=Comparer les deux expressions suivantes :
val20=Symbole
!endif
!if $val6=it 
val19=Confrontare le due espressioni seguenti:
val20=Simbolo
!endif
!if $val6=es 
val19=Compare las dos expresiones siguientes:
val20=Símbolo
!endif
replytype1=clickfill
replyname1=$val20
replygood1=$val12|$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

