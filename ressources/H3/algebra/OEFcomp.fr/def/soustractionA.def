!set title=Soustraction et fractions A
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
title_it=Sottrazioni e frazioni A
title_es=Sustracción y fracciones A

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!values v for v=2 to 15

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=$(val7[1])/$(val7[2]) - $(val7[3])/$(val7[4])
val9=$(val7[5])/$(val7[2]) - $(val7[3])/$(val7[4])

!ifval $(val7[1])<$(val7[5])
val10=1
!else
val10=2
!endif
tmp=!trim +,+	+,-	-,+	-,-
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
!if $val10!=3 

!ifval $val12=2
val10=2
!endif

!ifval $val12=3
val10=1
!endif

!ifval $val12=4
val10=-$val10+3
!endif
!endif
val8=$(val11[1])$val8
val9=$(val11[2])$val9
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
val13=Comparer les deux expressions suivantes :
val14=Symbole
!endif
!if $val6=it 
val13=Confrontare le due espressioni seguenti:
val14=Simbolo
!endif
!if $val6=es 
val13=Compare las dos expresiones siguientes:
val14=Símbolo
!endif
val15=<span class="larger"><</span>,<span class="larger">></span>,<span class="larger"2>=</span>
tmp0=!item $val10 of $val15

val10=$(tmp0)
tmp0=!texmath $val8

val16=$(tmp0)
tmp0=!texmath $val9

val17=$(tmp0)
replytype1=clickfill
replyname1=$val14
replygood1=$val10|$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13	<div class="wimscenter">	 
!insmath $val16
$()  
!read oef/embed.phtml r1,30x30x1 
$() 
!insmath $val17
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

