!! fichier de gestion des actions de combinaison lineaire
<u><b>Combinació lineal:</b></u>
!goto $wims_read_parm
!exit

:question
!form reply
!if $nbreesscalc=0
He de substituïr l'equació
!formselect repexo1 from 1 to 2
per l'equació obtinguda en calcular
!formselect repexo7 list -1,1 prompt la diferència, la suma
membre a membre entre l'equació 
!formselect repexo2 from 1 to 2
i l'equació
!formselect repexo3 from 1 to 2
.
!else
$(comment$[$nbetape+1])
!endif
!if $nocalcul!=1
   !read calcligne.phtml question
!endif
<input type=hidden name=status value=3>
<center><input type=submit value="Enviar"></center>
</form>
!exit

:reponse
<p>
   <blockquote>
   <p>
   He substituït l'equació $repexo1 per l'equació obtinguda en calcular 
!if $repexo7=-1
   la diferència
!else
   la suma
!endif
membre a membre entre l'equació $repexo2 i l'equació $repexo3 .</p>
!if $erreur!=calcul
   <font color=red><p>$erreur .</p></font>
   <p>pots:</p>
   <ul>
   <li>
   !href cmd=resume&status=2 fer
   una altra suma o diferència.
   </li>
      <li>
   !href cmd=resume&status=1 tornar
   al menú general.
   </li>
   </ul>
!else
   !read erreurcalc.phtml
!endif
</blockquote>
!let wims_module_error=error : $erreur
!let erreur=$empty
!exit

:analyse
!! --------------- test si tous les champs sont remplis
!if $repexo1=$empty or $repexo3=$empty or $repexo2=$empty
   erreur=$meserreur
   status=2
   !exit
!endif
!! -------------- test de la validit?de l'expression donn?.
!if $repexo2=$repexo3  
   !increase $nbreerrrais
   erreur=Has de triar dues equacions diferents.
   !exit
!endif

!! ------------- calcul de la nouvelle equation/inequation
!if $evitecalc=0
   evitecalc=1
   tmp1=!line $repexo2 of $(sys$nbetape)
   tmp2=!line $repexo3 of $(sys$nbetape)
   !distribute items $tmp1 into tmp3,tmp4,tmp5
   !distribute items $tmp2 into tmp6,tmp4,tmp7
   tmp=!exec maxima $tmp3+($repexo7)*($tmp6);\
$tmp5+($repexo7)*($tmp7);
   !distribute lines $tmp into tmp1,tmp2
   tmp4=$tmp1,$tmp4,$tmp2
   sys$[$nbetape+1]=!replace line number $repexo1 by $tmp4 in $(sys$nbetape)
!endif
comment$[$nbetape+1]=He substituït l'equació $repexo1 per l'equació obtinguda<br>en calcular la diferència membre a membre entre<br>l'equació $repexo2 i l'equació $repexo3.
!! ------------ verification de l'exactitude des calculs
!if $nocalcul!=1
tmp1=!line $repexo1 of $(sys$[$nbetape+1])
repexo4=!rawmath $repexo4
repexo6=!rawmath $repexo6
!read verifequ.calc $tmp1,$repexo4,1,$repexo6
!if NaN isin $test  
   erreur=$meserreur
   status=2
   !exit
!endif
!if $test!=$empty
   erreur=calcul
   !exit
!endif
!replace line number $repexo1 of $(sys$[$nbetape+1]) by $repexo4,1,$repexo6
!endif
!increase nbetape
status=1
evitecalc=0
!exit