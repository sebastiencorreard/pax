!! pour simplifier l'?riture d'une ?uation.

<u><b>Simplificar:</b></u>
!goto $wims_read_parm
!exit

:question
!form reply
   !if $mode=2
      He de simplificar l'escriptura membre a membre de l'equació 
      !formselect repexo1 from 1 to 2
      del sistema d'equacions.
   !endif
   Cadascun dels dos membres de l'$nom esdevé :
   !if $mode=2
   <ul>
      <li>Membre de l'esquerra : <input type=text name=repexo2 size=10 value=$repexo2>.</li>
      <li>Membre de la dreta : <input type=text name=repexo3 size=10 value=$repexo3>.</li>
   </ul>
   !else
     !distribute items $(sys$[$nbetape]) into tmp1,tmp2,tmp3
    <ul>
      <li>\($tmp1=)<input type=text name=repexo2 size=10 value=$repexo2>.</li>
      <li>\($tmp3=)<input type=text name=repexo3 size=10 value=$repexo3>.</li>
   </ul>
   !endif
<input type=hidden name=status value=3>
<center><input type=submit value="Enviar"></center>
</form>
!exit

:reponse
<blockquote>
!if $mode=2
   tmp=!line $repexo1 of $(sys$[$nbetape])
   !distribute items $tmp into tmp1,tmp2,tmp3
   He simplificat l'escriptura membre a membre de l'equació $(repexo1) del sistema d'equacions. 
!else
   !distribute items $(sys$[$nbetape]) into tmp1,tmp2,tmp3
!endif
Cadascun dels dos membres de l'$nom esdevé :
<ul>
   !let tmp1=!texmath $tmp1=$repexo2
   !let tmp3=!texmath $tmp3=$repexo3
   <li>\($tmp1)</li>
   <li>\($tmp3)</li>
</ul>
<font color=red><p>Has fet un error de càlcul.</p></font>
   <p>pots:</p>
   <ul>
   <li>
   !href cmd=resume&status=2 fer
   una altra simplificació.
   </li>
      <li>
   !href cmd=resume&status=1 tornar
   al menú general.
   </li>
   </ul>
   </blockquote>
!let wims_module_error=error : $erreur
!let erreur=$empty
!exit

:analyse
!! --------------- test si tous les champs sont remplis
!if $repexo2=$empty or $repexo3=$empty or ($repexo1=$empty and $mode=2)
   erreur=$meserreur
   status=2
   !exit
!endif
!! -------------- test de la validit?de l'expression donn?.
i=0
replygood0=tt
!for j=2 to 3
   test=$empty
   reply0=$(repexo$[$j])
   !read anstype/algexp
   !if NaN isin $test
      !break
   !endif
!next j
!if NaN isin $test  
   erreur=$meserreur
   status=2
   !exit
!endif

comment$[$nbetape+1]=Simplificació de les expressions.

!! ------------- V?ification des ?alit?.
!if $mode!=2
   repexo1=1
!endif
tmp=!line $repexo1 of $(sys$[$nbetape])
!distribute items $tmp into tmp1,tmp2,tmp3
repexo2=!rawmath $repexo2
repexo3=!rawmath $repexo3
tmp=!exec maxima expand($tmp1-($repexo2));\
expand($tmp3-($repexo3));
tmp=!lines2items $tmp
tmp=!listuniq $tmp
!if $tmp!=0
   !increase nbreerrcalc
   !exit
!endif

!! ------------- calcul de la nouvelle equation/inequation
tmp=$repexo2,$tmp2,$repexo3
!if $mode=2
   sys$[$nbetape+1]=!replace line number $repexo1 by $tmp in $(sys$[$nbetape])
!else
val41=$tmp
   sys$[$nbetape+1]=$tmp
!endif 
!increase nbetape
status=1
evitecalc=0
!exit