!if $val3=1 
tmp=!trim r1,r2	r3
val36=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim r3
val36=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!item 1 of $val21

val37=$(tmp0)
oefsteps=$val36 
