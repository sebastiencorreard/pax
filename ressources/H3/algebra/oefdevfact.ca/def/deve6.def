val10=$(tmp0)
tmp0=!values v for v=0 to $val2

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val13=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val8*$val10^$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
tmp=!translate ";': to $     $ in $val9*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp0=!shuffle +,-

val16=$(tmp0)
tmp0=!item 1 of $val16

val17=$(tmp0)
tmp0=!item 2 of $val16

val18=$(tmp0)
tmp=!translate internal $	$ to ; in \don

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
tmp0=!rawmath ($val14$val17$val15)($val14$val18$val15)

val20=$(tmp0)
!readproc slib/commutesom $val20,$val10 
tmp0=$slib_out
val21=$(tmp0)
tmp0=!texmath $val14

val22=$(tmp0)
tmp0=!texmath $val15

val23=$(tmp0)
val24=$val22,$val23
tmp0=!texmath $val20

val25=$(tmp0)
val26=red,green,blue,purple
tmp0=!shuffle $val26

val26=$(tmp0)
val27={\special{color=$(val26[1])}}
val28={\special{color=black}}
val29={\special{color=$(val26[2])}}
val30={\special{color=$(val26[3])}}
val31={\special{color=$(val26[4])}}
