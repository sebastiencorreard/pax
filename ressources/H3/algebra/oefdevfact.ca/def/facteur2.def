val7=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val8=$[rint($(tmp0))]
tmp0=!item 3 of $val6

val9=$[rint($(tmp0))]
tmp0=!item 4 of $val6

val10=$[rint($(tmp0))]
tmp0=!item 5 of $val6

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val7,$val8);
tmp0=!exec maxima $t_

val12=$[rint($(tmp0))]
!if $val12!=1 
val7=$[rint(2)]
val8=$[rint(3)]
!endif
t_=!replace internal \( by ( in gcd($val9,$val10);
tmp0=!exec maxima $t_

val12=$[rint($(tmp0))]
!if $val12!=1 
val9=$[rint(5)]
val10=$[rint(-3)]
!endif
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val13=$(tmp0)
tmp0=!shuffle x,y,a,b,z

val14=$(tmp0)
val15=$[rint($val7*$val8)]
val16=$[rint($val7*$val9)]
val17=$[rint($val8*$val9)]
tmp=!trim $val15*$(val14[1])+$val8,$val8	$val8+$val15*$(val14[1]),$val8	$val16*$(val14[1])+$val17,$val9	$val17+$val16*$(val14[1]),$val9
val18=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val18

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
tmp0=!item 1 of $val19

val20=$(tmp0)
