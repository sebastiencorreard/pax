tmp0=!randint 2, 15

val6=$[rint($(tmp0))]
tmp0=!randint 2, 15

val7=$[rint($(tmp0))]
tmp0=!randint 2, 15

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val7,$val8);
tmp0=!exec maxima $t_

val9=$[rint($(tmp0))]
val7=$[rint($val7/$val9)]
val8=$[rint($val8/$val9)]
!if $val7=$val8 
val7=$[rint(2)]
val8=$[rint(3)]
!endif
tmp0=!randint 2, 15

val10=$[rint($(tmp0))]
tmp0=!randint 2, 15

val11=$[rint($(tmp0))]
tmp0=!randint 2, 15

val12=$[rint($(tmp0))]
tmp=!nonempty items x,y,a,b

tmp0=!randitem $tmp
val13=$(tmp0)
val2=$[rint($val2)]

!ifval NaN isin $val2 or $val2=
val2=$[rint(1)]
!endif
tmp0=!randitem 2,4

val10=$[rint($(tmp0))]
tmp0=!randitem 5,3,7,9,11,13,15

val6=$[rint($(tmp0))]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val14=$(tmp0)
tmp=!translate ";': to $     $ in $val13^2$val14 2*$val6*$val13+$val6^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in ($val10*$val13)^2$val14 2*$val6*$val10*$val13+$val6^2

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!trim $(tmp0)	$(tmp1)
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
t_=!replace internal \( by ( in factor($val16);
tmp0=!exec maxima $t_

val17=$(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)
tmp0=!char 1 of $val17

val18=$(tmp0)
!if $val18=- 
tmp0=!char 2 to -1 of $val17

val17=$(tmp0)
tmp0=!char 1 to -2 of *()

val18=$(tmp0)
tmp0=!char 1 to -2 of ,()

val19=$(tmp0)
tmp0=!replace internal $val18 by $val19 in $val17

val20=$(tmp0)
tmp0=!itemcnt $val20

val21=$[rint($(tmp0))]
val17=
!for val22 =1 to $val21 
tmp0=!item $val22 of $val20

val18=$(tmp0)
tmp0=!listcomplement $val18 in $val20

val19=$(tmp0)
tmp0=!replace , by * in $val19

val19=$(tmp0)
val19=-$val18*$val19
tmp0=!append item $val19 to $val17

val17=$(tmp0)
!next
