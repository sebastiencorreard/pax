!set title=Completar una factorització 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=ca
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v,-v for v=2 to 20

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val8=$[rint($(tmp0))]
tmp0=!item 3 of $val6

val9=$[rint($(tmp0))]
tmp0=!item 4 of $val6

val10=$[rint($(tmp0))]
tmp0=!item 5 of $val6

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val7,$val8);
tmp0=!exec maxima $t_

val12=$[rint($(tmp0))]
!if $val12!=1 
val7=$[rint(2)]
val8=$[rint(3)]
!endif
t_=!replace internal \( by ( in gcd($val9,$val10);
tmp0=!exec maxima $t_

val12=$[rint($(tmp0))]
!if $val12!=1 
val9=$[rint(5)]
val10=$[rint(-3)]
!endif
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val13=$(tmp0)
tmp0=!shuffle x,y,a,b,z

val14=$(tmp0)
val15=$[rint($val7*$val8)]
val16=$[rint($val7*$val9)]
val17=$[rint($val8*$val9)]
tmp=!trim $val15*$(val14[1])+$val8,$val8,$val7+$(val14[1])	$val8+$val15*$(val14[1]),$val8,$val7+$(val14[1])	$val16*$(val14[1])+$val17,$val9,$val7*$(val14[1])+$val8	$val17+$val16*$(val14[1]),$val9,$val7*$(val14[1])+$val8
val18=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val18

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
tmp0=!item 1 of $val19

val20=$(tmp0)
tmp0=!item 2 of $val19

val21=$(tmp0)
tmp0=!item 3 of $val19

tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val22=$(tmp1)
t_=!replace internal \( by ( in expand($val22);
tmp0=!exec maxima $t_

val22=$(tmp0)
tmp0=!texmath $val20

val20=$(tmp0)
tmp0=!texmath $val21

val21=$(tmp0)
replytype1=algexp
replyname1=Resposta
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	Completar la factorització :	<center>
!insmath $val20 = $val21 \char40
$() 
!read oef/embed.phtml r1,20 
$() 
!insmath \char41
$()</center>	<small>Has d'escriure un resultat simplificat i reduït.</small>
$()
!exit

