\title{Développer k(a+b)#}
\language{fr}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm1=\confparm1}
\integer{confparm2=\confparm2}
\integer{confparm2=\confparm2= or NaN isin \confparm2?2}
\integer{confparm1=NaN isin \confparm1 or \confparm1=?1}


\integer{size=10}
\text{size2=40x25x1}
\integer{a=random(-1,1)*random(2..10)}
\integer{b=random(-1,1)*random(2..15)}
\integer{g=maxima(gcd(\a,\b);)}
\integer{a=\a/\g}
\integer{b=\b/\g}
\integer{c=random(-1,1)*random(2..15)}

\text{x=random(x,y,z,a,b)}

\text{lt=wims(values v for v=0 to \confparm1)}
\text{lt=shuffle(\lt)}
\integer{p1=item(1,\lt)}
\integer{p2=item(2,\lt)}
\integer{p3=randitem(\lt)}
\text{m1=simplify(\a*\x^\p1)}
\text{m2=simplify(\b*\x^\p2)}
\text{m3=simplify(\c*\x^\p3)}

\text{sg=\b>0?+:}
\text{rep=\m3*(\m1 \sg \m2)}
\text{rep=wims(rawmath \rep)}
\text{rep7=slib(commutesom \rep,\x)}
\text{A=texmath(\m3)}
\text{B=texmath(\m1)}
\text{C=texmath(\m2)}
\text{enonce=texmath(\rep)}

\text{coul=red,green,blue,purple}
\text{coul=shuffle(\coul)}
\text{tr={\special{color=\coul[1]}}}
\text{tb={\special{color=black}}}
\text{tg={\special{color=\coul[2]}}}
\text{ty={\special{color=\coul[3]}}}
\text{po=\char40}
\text{pf=\char41}
\text{enonce1=\tr \A \tb (\tg \B \ty\sg \C \tb )}
\text{rep1=texmath(\m3)}
\text{rep2=texmath(\m1)}
\text{rep3=texmath(\m3)}
\text{rep4=texmath(\m2)}
\text{rep5=simplify(\m3*\m1)}
\text{rep6=simplify(\m3*\m2)}

\text{ligne1=<td>\(\enonce1)</td>
<td>=</td>
<td>\(\tr\po \A \pf\tb\times \tg\po \B \pf\tb) </td>
<td>+</td>
<td>\(\tr\po \A \pf\tb \times \ty\po \C \pf\tb) </td>}

\text{tmps=wims(char 1 of \rep6)}
\text{tmp=\tmps=-?(\rep6):\rep6}
\text{ligne2=<td></td>
<td>=</td>
<td> \(\rep5)</td> 
<td>+</td>
<td> \(\tmp) </td>}

\if{\confparm2=1}{
\matrix{type=r1,r2,r3,r4
r5,r6
r7}
}{
\matrix{type=r7}
}

\steps{\type}

\text{solf=texmath(item(1,\rep7))}

\statement{<br>
Développer et r&eacute;duire l'expression \(\enonce).
<br>
<center><hr width=50%></center>
<table class=reply>
<tr><td>
<u><b>Votre réponse :</b></u><br>

\if{\confparm2=1}{
On vous propose de résoudre l'exercice en vous guidant. Complétez les différentes étapes de calcul qui vous sont proposées en vous aidant des couleurs et en utilisant l'identité \(k(a+b)=ka+kb) : <p>
\if{\step=1}{<small>Utiliser les étiquettes pour compléter le calcul.</small> <p>
   \(\enonce1= \tr\po\tb) \embed{r1,\size2} \(\tr\pf\tb\times \tg\po\tb) \embed{r2,\size2} \(\tg\pf\tb + \tr\po\tb) \embed{r3,\size2} \(\tr\pf\tb \times \ty\po\tb ) \embed{r4,\size2} \(\ty\pf\tb)
}{
<table border=0>
<tr>\ligne1</tr>
<tr>
\if{\step=2}{
<td></td>
<td>=</td>
<td> \embed{r5,\size}</td> 
<td>+</td>
<td> \embed{r6,\size} </td>
</tr>
}{
\ligne2
</tr>
<tr>
<td></td>
<td>=</td>
<td colspan=3> \embed{r7,2*\size} </td>
</tr>
}
</table>
}
}
{
\(\enonce = )\embed{r7,2*\size}.
}
</td></tr>
</table>
}
\answer{Réponse 1}{\rep1;\rep1,\rep2,\rep3,\rep4}{type=clickfill}
\answer{Réponse 2}{\rep2;\rep1,\rep2,\rep3,\rep4}{type=clickfill}
\answer{Réponse 3}{\rep3;\rep1,\rep2,\rep3,\rep4}{type=clickfill}
\answer{Réponse 4}{\rep4;\rep1,\rep2,\rep3,\rep4}{type=clickfill}
\answer{Réponse 5}{\rep5}{type=litexp}
\answer{Réponse 6}{\rep6}{type=litexp}
\answer{Réponse}{\rep7}{type=litexp}

\solution{
<table border=0>
<tr>\ligne1</tr>
<tr>\ligne2</tr>
<tr>
   <td></td>
   <td>=</td>
   <td colspan=3> \(\solf)</td>
</tr>
</table>}