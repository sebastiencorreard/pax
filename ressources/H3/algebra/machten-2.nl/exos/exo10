# vermenigvuldigen met machten
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
mathviewpanel=$module_title:^:+:-:/:*
rounding=0
mathview=5
math=0
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
# produceerd een <tr>
make_tr=1
varlist=s
# dus 4s ->4*s en 4sqrt => 4*sqrt 
arglist=$empty
question$n=!record 38 of lang/remarks.$taal
#@Bereken en schrijf als &eacute;&eacute;n macht:
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo10.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
smallfont=18
largefont=24
v1=!randitem a,b,x,y
varlist=$v1
wims_rawmath_variables=$v1

!if $R=1
    checkfile=$checkdir/simplify.proc
    pm=!randitem -1,1
    a=!randitem 2,3,4,5,6,7,8,9,10
    b=!randitem 2,3,4,5,6,7,8,9,10
    c=!randitem 2,3,4,5
    d=!randitem 2,3,4,5
    a=$[$pm*$a]
    e=$[$a*$b]
    f=$[$c+$d]
    # var1 is verbatim question
    var1=$a*$v1^$c*$b*$v1^$d
    applettext=!nospace $a $v1^$c * $b $v1^$d =
    answer$n=$e*$v1^($f)
    formula$n=$a $v1^{$c} \cdot $b $v1^{$d} \,=\,[?]
    texanswer$n=$a $v1^{$c} \cdot $b $v1^{$d} \,=\, $a \cdot $b \cdot $v1^{$c+$d} = $e $v1^{$f}
 !exit
!endif

!if $R=2
    checkfile=$checkdir/simplify.proc
    pm=!randitem -1,1
    a=!randitem 2,3,4,5,6,7,8,9,10
    b=!randitem 2,3,4,5,6,7,8,9,10
    d=!randitem 2,3,4,5,6,-2,-3,-4,-5,-6
    !if $d<0
	d=($d)
    !endif
    c=!randitem -2,-3,-4,-5
    !if $[$c+$d]=0
	c=$[$c-1]
    !endif
    a=$[$pm*$a]
    e=$[$a*$b]
    f=$[$c+$d]
    # var1 is verbatim question
    var1=$a*$v1^$c*$b*$v1^$d
    applettext=!nospace $a $v1^($c) * $b $v1^$d =
    answer$n=$e*$v1^($f)
    formula$n=$a $v1^{$c} \cdot $b $v1^{$d} \,=\,[?]
    texanswer$n=$a $v1^{$c} \cdot $b $v1^{$d} \,=\, $a \cdot $b \cdot $v1^{$c+$d} = $e $v1^{$f}
 !exit
!endif

!if $R>2
    checkfile=$checkdir/simplify.proc
    pm=!randitem -1,1
    mp=!randitem -1,1
    a=!randitem 2,3,4,5,6,7,8,9,10
    b=!randitem 2,3,4,5,6,7,8,9,10
    d=!randitem 2,3,4,5,6,7,8,9,10
    c=!randitem -2,-3,-4,-5,-6,-7
    h=!randitem -2,-3,-4,-5,-6,-7,2,3,4,5,6,7
    !if $[$c+$d+$h]=0
	c=$[$c-1]
    !endif
    a=$[$pm*$a]
    b=$[$mp*$b]
    e=$[$a*$b]
    f=$[$c+$d+$h]
    formula$n=$a $v1^{$c} \cdot $v1^{$d} \cdot $b $v1^{$h} \,=\,[?]
    var1=$a*$v1^$c*$v1^$d*$b*$v1^$h
    !if $h<0
	h=($h)
    !endif
    !if $b<0
	b=($b)
    !endif
    # var1 is verbatim question
    applettext=!nospace $a*$v1^($c)*$v1^$d*$b*$v1^$h =
    answer$n=$e*$v1^($f)
    tex=!rawmath $c+$d+$h
    texanswer$n=\left[ \begin{array}{l} $a $v1^{$c} \cdot $v1^{$d} \cdot $b $v1^{$h} \,= \\ $a \cdot $b \cdot $v1^{$tex} = \\ $e $v1^{$f} \end{array}\right.
 !exit
!endif

