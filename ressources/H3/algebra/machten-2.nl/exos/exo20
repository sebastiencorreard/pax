# 20: Schrijf zonder wortel: met variabelen II
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
rounding=0
mathview=5
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
embed=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
make_tr=1
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo20.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
#font settings in input applet
smallfont=18
largefont=26

ss=!record 49 of lang/remarks.$taal
question$n=$ss
checkfile=exos/checkfile7.proc
letters=!shuffle a,b,x,y,z
v=!item 1 of $letters
w=!item 2 of $letters
mathviewpanel=$module_title:$v:$w

!if $R=1
    a=!randint 3,8
    b=!randint 3,8
    c=$[2*$a]
    d=$[2*$b]
    e=!randint 1,$[$c-1]
    h=$[$c - $e]
    f=!randint 1,$[$d-1]
    k=$[$d - $f]
    varlist=$v,$w
    wims_rawmath_variables=$v,$w
    formula$n=\sqrt{$v^{$e} \cdot $w^{$f}} \cdot \sqrt{$v^{$h} \cdot $w^{$k}}\,=\,[?]
    answer$n=$v^$a*$w^$b
    texanswer$n=\left[ \begin{array}{l} \sqrt{$v^{$e} \cdot $w^{$f} \cdot $v^{$h} \cdot $w^{$k}} = \\ \\ \sqrt{$v^{$e+$h} \cdot $w^{$f+$k}} = \\ \sqrt{$v^{$c} \cdot $w^{$d}} = \\ $v^{$a} $w^{$b} \end{array} \right.
    applettext=!nospace sqrt($v^$e*$w^$f)*sqrt($v^$h*$w^$k) =
 !exit
!endif

!if $R>1
    a=!randint 3,8
    b=!randint 3,8
    c=$[2*$a]
    d=$[2*$b]
    e=!randint 2,5
    f=!randint 2,7
    g=$[2*$a+$e]
    h=$[2*$b+$f]
    k=!randint 2,6
    l=!randint 2,4
    m=$[$l*$k]
    varlist=$v,$w
    wims_rawmath_variables=$v,$w
    formula$n=\displaystyle \frac{$m \sqrt{$v^{$g}\cdot $w^{$h}}}{$k \sqrt{$v^{$e}\cdot $w^{$f}}} = [?]
    answer$n=$l*$v^$a*$w^$b
    texanswer$n=\left[ \begin{array}{l}$l \displaystyle  \sqrt{\frac{$v^{$g}\cdot $w^{$h}}{$v^{$e}\cdot $w^{$f}}}= \\ \\ $l \sqrt{$v^{$g-$e}$w^{$h-$f}} = \\ $l \sqrt{$v^{$c} $w^{$d}} = \\ $l $v^{$a} $w^{$b} \end{array} \right.
    applettext=!nospace ($m*sqrt($v^$g*$w^$h))/($k*sqrt($v^$e*$w^$f)) =
 !exit
!endif
