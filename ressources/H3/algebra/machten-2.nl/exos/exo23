# vermenigvuldigen met machten
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
mathviewpanel=$module_title:^:+:-:/:*
rounding=0
mathview=5
math=0
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
# produceerd een <tr>
make_tr=1
# dus 4s ->4*s en 4sqrt => 4*sqrt 
arglist=$empty
question$n=!record 38 of lang/remarks.$taal
#@Bereken en schrijf als &eacute;&eacute;n macht:
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo10.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
smallfont=18
largefont=24
!if $R=1
    v1=!randitem a,b,x,y
    varlist=$v1
    wims_rawmath_variables=$v1
    checkfile=$checkdir/simplify.proc
    pm=!randitem -1,1
    a=!randitem 2,3,4,5
    b=!randitem 2,3,4,5,6
    c=!randitem 2,3
    a=$[$pm*$a]
    e=$[($a)^$c]
    f=$[$b*$c]
    # var1 is verbatim question
    var1=($a*$v1^($b))^$c
    applettext=!nospace ($a*$v1^($b))^($c) =
    answer$n=$e*$v1^$f
    formula$n=\left( $a $v1^{$b} \right)^{$c}\,=\,[?]
    texanswer$n=\left( $a $v1^{$b} \right)^{$c} \,=\, ($a)^{$c} \cdot \left( $v1^{$b}\right)^{$c} = $e \cdot $v1^{$b \cdot $c} = $e \cdot $v1^{$f}
 !exit
!endif

!if $R=2
    v1=!randitem a,b,x,y
    v2=!randitem d,f,z
    varlist=$v1,$v2
    wims_rawmath_variables=$v1,$v2
    checkfile=$checkdir/simplify.proc
    b=!randitem 2,3,4,5
    c=!randitem 2,3,4
    f=$[$b*$c]
    # var1 is verbatim question
    var1=($v1^($b*$v2))^$c
    applettext=!nospace ($v1^($b*$v2))^($c) =
    answer$n=$v1^($f*$v2)
    formula$n=\left($v1^{$b $v2} \right)^{$c}\,=\,[?]
    texanswer$n=\left( $v1^{$b $v2} \right)^{$c} \,=\, $v1^{$b $v2 \cdot $c} = $e \cdot $v1^{$f $v2}
 !exit
!endif

!if $R>2
    checkfile=$checkdir/simplify.proc
    v1=!randitem a,b,x,y
    v2=!randitem d,f,z
    varlist=$v1,$v2
    wims_rawmath_variables=$v1,$v2
    a=!randitem 2,3,4,5
    b=!randitem 2,3,4,5
    c=!randitem 2,3,4
    g=$[$a+$b]
    f=$[$g*$c]
    # var1 is verbatim question
    var1=($v1^($b*$v2)*$v1^($a*$v2))^$c
    applettext=!nospace ($v1^($b*$v2)*$v1^($a*$v2))^($c) =
    answer$n=$v1^($f*$v2)
    formula$n=\left($v1^{$b $v2} \cdot $v1^{$a $v2} \right)^{$c}\,=\,[?]
    texanswer$n=\left( $v1^{$b $v2} \cdot $v1^{$a $v2}\right)^{$c} \,=\, \left( $v1^{$b $v2 + $a $v2} \right) ^{$c} = \left( $v1^{$g $v2} \right) ^{$c} = $v1^{$g $v2 \cdot $c}=$v1^{$f $v2}
 !exit
!endif

