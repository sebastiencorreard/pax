# :standaardvorm: delen hogere machts wortels
# het goede antwoord is: $a,sqrt($b)
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
mathviewpanel=$module_title:sqrt():sqrt[3]():sqrt[4]():sqrt[5]():sqrt[6]():sqrt[7]():sqrt[n]()
rounding=0
mathview=5
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
embed=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
# produceerd een <tr>
make_tr=1
varlist=s
# dus 4s ->4*s en 4sqrt => 4*sqrt 
arglist=$empty
question$n=!record 41 of lang/remarks.$taal
#@Schrijf indien nodig in de standaardvorm <img src=$module_dir/gifs/exo1.gif/> ,<br />waarbij <em>b</em> een zo klein mogelijk getal is
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo7.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
#font settings in input applet
smallfont=16
largefont=24
checkfile=exos/checkfile1.proc

!if $R=1
    # var1=1 er zit een wortel in antwoord
    var1=1
    a=!randitem 2,3,4,5,6,7,9
    b=!randitem 2,3,5,6
    p=!randitem 3,4,5,6
    c=$[$a*$b]
    formula$n=\frac{ \root{\textstyle $p} \of{$c}}{ \root{\textstyle $p} \of{$b}} \,=\,[?]
    answer$n=1,sqrt($a),$p
    texanswer$n=\frac{ \root{\textstyle $p} \of{$c}}{ \root{\textstyle $p} \of{$b}} \,=\, \root{\textstyle $p} \of{\frac{$c}{$b}} \,=\, \root{\textstyle $p} \of{$a}
    applettext=!nospace sqrt[$p]($c)/(sqrt[$p]($b))=
 !exit
!endif

!if $R=2
    # var1=1 er zit een wortel in antwoord
    var1=1
    a=!randitem 2,3,4,5,6,7,9
    b=!randitem 2,3,5,6
    p=!randitem 3,4,5,6
    f=!randitem 2,3,4
    g=!randitem -4,-3,-2,2,3,4
    e=$[$f*$g]
    c=$[$a*$b]
    formula$n=\frac{ $e \root{\textstyle $p} \of{$c}}{ $f \root{\textstyle $p} \of{$b}} \,=\,[?]
    answer$n=$g,sqrt($a),$p
    texanswer$n=\left[ \begin{array}{l} \frac{ $e \root{\textstyle $p} \of{$c}}{ $f \root{\textstyle $p} \of{$b}} = \\ \\ \frac{$e}{$f} \cdot \root{\textstyle $p} \of{\frac{$c}{$b}} \,=\,$g \cdot \root{\textstyle $p} \of{$a} \end{array} \right.
    applettext=!nospace ($e*sqrt[$p]($c))/($f*sqrt[$p]($b))=
 !exit
!endif

!if $R>2
    a=!randitem 2,3,4
    p=!randitem 3,4,5
    b=!randitem 2,3
    e=!randitem 2,3,4
    d=$[$e*$b]
    c=$[$d*$a^($p)]
    formula$n=\frac{ \root{\textstyle $p} \of{$c}}{\root{\textstyle $p} \of{$b}} \,=\,[?]
    answer$n=$a,sqrt($e),$p
    texanswer$n=\left[ \begin{array}{l} \frac{\root{\textstyle $p} \of{$c}}{\root{\textstyle $p} \of{$b}} = \\ \root{\textstyle $p} \of{\frac{$c}{$b}} = \\ \root{\textstyle $p} \of{$[($c)/($b)]} \,=\, \root{\textstyle $p} \of{$e \cdot $a^{$p} }  = \\  $a \cdot \root{\textstyle $p} \of{$e} \end{array} \right.
    applettext=!nospace (sqrt[$p]($c))/(sqrt[$p]($b)) =
 !exit
!endif
