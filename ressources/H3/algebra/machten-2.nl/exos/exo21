# :21 Haakjes uitwerken met wortels en getallen
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
rounding=0
mathview=5
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
embed=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
make_tr=1
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo19.jpg\' alt=\'noalt\' />
#font settings in input applet
smallfont=18
largefont=26
#var9 = letterlijke som
ss=!record 57 of lang/remarks.$taal
#@Werk de haakjes uit en schrijf zo kort mogelijk...
question$n=$ss
# letop geen variabele "t" gebruiken...gaat mis vermoedelijk via de "t" in "sqrt" -> sqrT() -> sqr() -> ()
checkfile=exos/precheck3.proc

mathviewpanel=$module_title:sqrt():+:-:*:/
keuze=!randitem 1,0

!if $R=1
    w=!shuffle 2,3,5,6,7,8,10,11
    a=!item 1 of $w
    b=!item 2 of $w
    c=!item 3 of $w
    pm=!randitem +,-
    var9=sqrt($a)*(sqrt($b) $pm sqrt($c))
    inter=sqrt($a * $b) $pm sqrt($a*$c)
    #tot=!exec maxima radexpand=true;rootsconmode=true;\
    #rootscontract(radcan($inter));
    # 5/10/2012
    tot=!exec maxima sqrtdispflag:true;\
    rootscontract($inter)
    answer$n=!line 2 of $tot
    tex=!texmath $(answer$n)
    
    !if $keuze=1
	formula$n=\sqrt{$a} \cdot \left( \sqrt{$b} $pm \sqrt{$c}\right) = [?]
	applettext=!nospace $var9 =
    !else
	formula$n=\left( \sqrt{$b} $pm \sqrt{$c}\right) \times \sqrt{$a} = [?]
	applettext=!nospace (sqrt($b) $pm sqrt($c))*sqrt($a) =
    !endif
    texanswer$n=\left[ \begin{array}{l} \sqrt{$a} \cdot \sqrt{$b} $pm \sqrt{$a} \cdot \sqrt{$c} = \\ \sqrt{$a \cdot $b} $pm \sqrt{$a \cdot $c } = \\ \sqrt{$[$a*$b]} $pm \sqrt{$[$a*$c] } = \\ $tex  \end{array} \right.
 !exit
!endif

!if $R=2
    w=!shuffle 2,3,5,6,7,8,10,11
    a=!item 1 of $w
    b=!item 2 of $w
    c=!item 3 of $w
    d=!item 4 of $w
    keuze=!randint 1,4
    !if $keuze=1
	pm=+
	mp=+
	inter=sqrt($[$a*$b]) + sqrt($[$a*$c]) + sqrt($[$d*$b]) + sqrt($[$d*$c])
    !else
	!if $keuze=2
	    pm=+
	    mp=-
	    inter=sqrt($[$a*$b]) - sqrt($[$a*$c]) + sqrt($[$d*$b]) - sqrt($[$d*$c])
	!else
	    !if $keuze=3
		pm=-
		mp=+
		inter=sqrt($[$a*$b]) + sqrt($[$a*$c]) - sqrt($[$d*$b]) - sqrt($[$d*$c])
	    !else
		pm=-
		mp=-
		inter=sqrt($[$a*$b]) - sqrt($[$a*$c]) - sqrt($[$d*$b]) + sqrt($[$d*$c])
	    !endif
	!endif
    !endif
    var9=(sqrt($a) $mp sqrt($d))*(sqrt($b) $pm sqrt($c))
#    answer$n=!exec maxima radcan($var9);
#    tot=!exec maxima radexpand=true;rootsconmode=true;\
#    rootscontract($inter);
    # 5/10/2012
    tot=!exec maxima sqrtdispflag:true;\
    rootscontract($inter)
#    tot=!exec maxima radexpand=true;rootsconmode=true;\
#    rootscontract(radcan($inter));
    answer$n=!line 2 of $tot
    tex=!texmath $(answer$n)
    formula$n=\left( \sqrt{$a} $mp \sqrt{$d} \right)\left( \sqrt{$b} $pm \sqrt{$c} \right) = [?]
    applettext=!nospace $var9 =
    
    !if $keuze=1
	texanswer$n=\left[ \begin{array}{l} \sqrt{$a} \cdot \sqrt{$b} + \sqrt{$a} \cdot \sqrt{$c} + \sqrt{$d} \cdot \sqrt{$b} + \sqrt{$d} \cdot \sqrt{$c} \\ \sqrt{$a \cdot $b} + \sqrt{$a \cdot $c} + \sqrt{$d \cdot $b} + \sqrt{$d \cdot $c} \\ \sqrt{$[$a*$b]} + \sqrt{$[$a*$c]} + \sqrt{$[$d*$b]} + \sqrt{$[$d*$c]} = \\ $tex \end{array} \right.
    !else
	!if $keuze=2
	    texanswer$n=\left[ \begin{array}{l} \sqrt{$a} \cdot \sqrt{$b} - \sqrt{$a} \cdot \sqrt{$c} + \sqrt{$d} \cdot \sqrt{$b} - \sqrt{$d} \cdot \sqrt{$c} \\ \sqrt{$a \cdot $b} - \sqrt{$a \cdot $c} + \sqrt{$d \cdot $b} - \sqrt{$d \cdot $c} \\ \sqrt{$[$a*$b]} - \sqrt{$[$a*$c]} + \sqrt{$[$d*$b]} - \sqrt{$[$d*$c]} = \\ $tex \end{array} \right.
	!else
	    !if $keuze=3
		texanswer$n=\left[ \begin{array}{l} \sqrt{$a} \cdot \sqrt{$b} + \sqrt{$a} \cdot \sqrt{$c} - \sqrt{$d} \cdot \sqrt{$b} - \sqrt{$d} \cdot \sqrt{$c} \\ \sqrt{$a \cdot $b} + \sqrt{$a \cdot $c} - \sqrt{$d \cdot $b} - \sqrt{$d \cdot $c} \\ \sqrt{$[$a*$b]} + \sqrt{$[$a*$c]} - \sqrt{$[$d*$b]} - \sqrt{$[$d*$c]} = \\ $tex \end{array} \right.
	    !else
		texanswer$n=\left[ \begin{array}{l} \sqrt{$a} \cdot \sqrt{$b} - \sqrt{$a} \cdot \sqrt{$c} - \sqrt{$d} \cdot \sqrt{$b} + \sqrt{$d} \cdot \sqrt{$c} \\ \sqrt{$a \cdot $b} - \sqrt{$a \cdot $c} - \sqrt{$d \cdot $b} + \sqrt{$d \cdot $c} \\ \sqrt{$[$a*$b]} - \sqrt{$[$a*$c]} - \sqrt{$[$d*$b]} + \sqrt{$[$d*$c]} = \\ $tex  \end{array} \right.
	    !endif
	!endif
    !endif
 !exit
!endif

!if $R>2
    w=!shuffle 2,3,5,6,7,8,10,11
    a=!item 1 of $w
    b=!item 2 of $w
    c=$[$a+$b]
    d=$[$a*$b]
    pp=!shuffle +,-
    pm=!item 1 of $pp
    mp=!item 2 of $pp
    
#    tot=!exec maxima radexpand=true;rootsconmode=true;\
#    rootscontract(radcan($var9));
#    tot=!exec maxima sqrtdispflag:true;\
#    rootscontract($var9)
#    answer$n=!line 2 of $tot
#    answer$n=!exec maxima radcan($var9);

    tot=!exec maxima 2*sqrt($d)
    tex=!texmath $tot
    
    !if $keuze=1
	var9=(sqrt($a) $pm sqrt($b))^2
	formula$n=\left( \sqrt{$a} $pm \sqrt{$b}\right)^{2} = [?]
	answer$n=$c $pm $tot
    !else
	var9=-(sqrt($a) $pm sqrt($b))^2
	formula$n= -\left( \sqrt{$a} $pm \sqrt{$b}\right)^{2} = [?]
	answer$n=-$c $mp $tot
    !endif
    
    applettext=!nospace $var9 = 
    !if $keuze=1
	texanswer$n=\left[ \begin{array}{l} \left( \sqrt{$a} $pm \sqrt{$b} \right) \cdot \left( \sqrt{$a} $pm \sqrt{$b} \right) = \\ $a $pm 2\cdot \sqrt{$a \cdot $b} + $b  = \\ $c $pm $tex \end{array} \right.
    !else
	texanswer$n=\left[ \begin{array}{l} -\left( \sqrt{$a} $pm \sqrt{$b} \right) \cdot \left( \sqrt{$a} $pm \sqrt{$b} \right) = \\ -$a $mp 2\cdot \sqrt{$a \cdot $b} - $b  = \\ -$c $mp $tex \end{array} \right.
    !endif
 !exit
!endif
