# :schrijf zonder wortel
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
display=1
rounding=0
mathview=5
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
embed=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
make_tr=1
hulptext=!record 3 of lang/remarks.$taal
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo17.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
#font settings in input applet
smallfont=18
largefont=26

ss=!record 49 of lang/remarks.$taal
question$n=$ss
# er zit geen wortel in
var8=0
checkfile=exos/checkfile7.proc
letters=!shuffle a,b,x,y,z
v1=!item 1 of $letters
mathviewpanel=$module_title:$v1:^
!if $R=1
    varlist=$v1
    wims_rawmath_variables=$v1
    a=!randint 1,20
    b=$[2*$a]
    formula$n=\sqrt{$v1^{$b}}\,=\,[?]
    answer$n=$v1^$a
    texanswer$n=\left[ \begin{array}{l} \sqrt{$v1^{$b}} = $v1^{$a} \\ \\  \because \left($v1^{$a}\right)^{2} = $v1^{$a} \times $v1^{$a} = $v1^{$b} \end{array} \right.
    applettext=!nospace sqrt($v1^$b)=
 !exit
!endif

!if $R=2
    keuze=!randint 1,2
    varlist=$v1
    wims_rawmath_variables=$v1
    a=!randint 1,20
    b=$[2*$a]
    c=!randint 2,9
    d=$[$c*$c]
    !if $keuze=1
        formula$n=\sqrt{$d $v1^{$b}}\,=\,[?]
        answer$n=$c*$v1^$a
        texanswer$n=\left[ \begin{array}{l} \sqrt{$d $v1^{$b}} = $c $v1^{$a} \\ \\ \because \left($c $v1^{$a}\right)^{2} = $c $v1^{$a} \times $c $v1^{$a} =$d $v1^{$b} \end{array} \right.
        applettext=!nospace sqrt($d*$v1^$b)=
    !else
        formula$n=\sqrt{ \displaystyle \frac{$v1^{$b}}{$d}} \,=\,[?]
        answer$n=($v1^$a)/$c
        texanswer$n=\left[ \begin{array}{l} \sqrt{ \displaystyle \frac{$v1^{$b}}{$d} } \,=\,\frac{$v1^{$a}}{$c}  \\  \\ \because \displaystyle \left( \frac{$v1^{$a}}{$c} \right)^{2} =\displaystyle \frac{$v1^{$a}}{$c} \times \frac{$v1^{$a}}{$c} = \frac{$v1^{$b}}{$d} \end{array} \right.
        applettext=!nospace sqrt($v1^$b/$d)=
    !endif
 !exit
!endif


!if $R>2
    v2=!item 2 of $letters
    mathviewpanel=$module_title:$v1:$v2:^
    keuze=!randint 1,2
    varlist=$v1,$v2
    wims_rawmath_variables=$v1
    a=!randint 5,30
    b=$[2*$a]
    c=!randint 2,13
    d=$[$c*$c]
    f=!randint 10,50
    g=$[2*$f]
    h=$[$c+1]
    k=$[$h*$h]
    !if $keuze=1
        formula$n=\sqrt{$d \cdot $v1^{$b} $v2^{$g}}\,=\,[?]
        answer$n=$c*$v1^$a*$v2^$f
        texanswer$n=\left[ \begin{array}{l} \sqrt{$d \cdot $v1^{$b} $v2^{$g}} = $c $v1^{$a} $v2^{$f} \\ \\ \because \left($c $v1^{$a} $v2^{$f} \right)^{2} = $c $v1^{$a} $v2^{$f} \times $c $v1^{$a} $v2^{$f}=$d $v1^{$b} $v2^{$g}\end{array} \right.
        applettext=!nospace sqrt($d*$v1^$b*$v2^$g)=
    !else
        formula$n=\sqrt{ \displaystyle \frac{$d $v1^{$b}}{$k $v2^{$g}}} \,=\,[?]
        answer$n=($c*$v1^$a)/($h*$v2^$f)
        texanswer$n=\left[ \begin{array}{l} \sqrt{ \displaystyle \frac{$d $v1^{$b}}{$k $v2^{$g}}}\,=\,\displaystyle \frac{$c $v1^{$a}}{$h $v2^{$f}} \\ \\ \because  \displaystyle \left(\frac{$c $v1^{$a}}{$h $v2^{$f}} \right)^{2} =\displaystyle \frac{$c $v1^{$a}}{$h $v2^{$f}} \times \frac{$c $v1^{$a}}{$h $v2^{$f}} = \frac{$d $v1^{$b}}{$k $v2^{$g}} \end{array} \right.
        applettext=!nospace sqrt(($d*$v1^$b)/($k*$v2^$g))=
    !endif
 !exit
!endif
