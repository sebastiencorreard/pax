n=$counter
# eerst check op letterlijk overtiepen
a=$(reply$n)
g=$(answer$n)
return=-1
!readproc exos/copy_of_question.proc
!if $return !=-1
    goback=$return
!else
    # geen "number.proc" die geeft een waarschuwing over "berekeningen zelft uitvoeren" 
    # als 1+sqrt(2) wordt geschreven als 1+2^(1/2)
    !readproc $checkdir/new_number.proc
!endif
!exit
