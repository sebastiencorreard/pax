# :standaardvorm: vermenigvuldigen hogere machts wortels
# het goede antwoord is: $a,sqrt($b)
# werkt alleen met javainput applet
display=1
# tell myfreestyle.phtml not to modify sqrt[3](2) into 2^(1/3)
convert_root=1
mathviewpanel=$module_title:sqrt():sqrt[3]():sqrt[4]():sqrt[5]():sqrt[6]():sqrt[7]():sqrt[8]():sqrt[9]()
rounding=0
mathview=5
math=0
!readproc $remarkdir/rounding.$taal
image=0
questiontype=0
embed=0
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
# produceerd een <tr>
make_tr=1
varlist=s
# dus 4s ->4*s en 4sqrt => 4*sqrt 
arglist=$empty
question$n=!record 41 of lang/remarks.$taal
#@Schrijf indien nodig in de standaardvorm <img src=$module_dir/gifs/exo1.gif/> ,<br />waarbij <em>b</em> een zo klein mogelijk getal is
cols=15
rows=1
helptext=<img src=\'$module_dir/gifs/exo6.jpg\' alt=\'noalt\' />
keuze=!randitem 1,0
#font settings in input applet
smallfont=18
largefont=24

!if $R=1
    !if $keuze=1
	checkfile=exos/checkfile1.proc
	# var1=1 er zit een wortel in antwoord
	var1=1
	c=!randitem 2,3,5,6,7
	b=!randitem 2,3,5,6,7
	e=$[$c*$b]
	p=!randitem 3,4,5,6
	formula$n=\root{\textstyle $p} \of{$c} \cdot \root{\textstyle $p} \of{$b} \,=\,[?]
	answer$n=1,sqrt($e),$p
	texanswer$n=\left[ \begin{array}{l}\root{\textstyle $p} \of{$c} \cdot \root{\textstyle $p} \of{$b} = \\ \root{\textstyle $p } \of{ $b \cdot $c } = \\ \root{\textstyle $p} \of{$e} \end{array} \right.
	applettext=!nospace sqrt[$p]($c) cdot sqrt[$p]($b) = 
    !else
	checkfile=exos/checkfile2.proc
	var1=0
	p=!randitem 3,4,5,6,7
	a=!randitem 2,3,4
	c=$[$a^($p-1)]
	answer$n=$a
	formula$n=\root{\textstyle $p} \of{$c} \cdot \root{\textstyle $p} \of{$a} \,=\,[?]
	texanswer$n=\root{\textstyle $p} \of{$c} \cdot \root{\textstyle $p} \of{$a} \,=\, \root{\textstyle $p} \of{$[$a*$c]} = $a
	applettext=!nospace sqrt[$p]($c) cdot sqrt[$p]($a) =
    !endif
 !exit
!endif

!if $R=2
    # var1=1 er zit een wortel in antwoord
    checkfile=exos/checkfile1.proc
    var1=1
    a=!randitem 2,3
    b=!randitem 2,3,5,6
    p=!randitem 3,4,5
    c=!randitem 2,3
    d=$[$c*$a^($p)]
    e=$[$c*$b]
    formula$n=\root{\textstyle $p} \of{$d} \cdot \root{\textstyle $p} \of{$b} \,=\,[?]
    answer$n=$a,sqrt($e),$p
    texanswer$n=\left[ \begin{array}{l}\root{\textstyle $p} \of{$d} \cdot \root{\textstyle $p} \of{$b} \,=\, \root{\textstyle $p } \of{ $[$d*$b] } \\ \root{\textstyle $p } \of{ $e \cdot $a^{$p} }  =  $a \root{\textstyle $p} \of{$e} \end{array} \right.
    applettext=!nospace sqrt[$p]($d) cdot sqrt[$p]($b) =
 !exit
!endif

!if $R>2
    # var1=1 er zit een wortel in antwoord
    checkfile=exos/checkfile1.proc
    var1=1
    a=!randitem 2,3,4
    b=!randitem 2,3,5,6,7
    p=!randitem 3,4,5,6,7
    c=!randitem 2,3,5,6,7
    d=$[$c*$a^($p)]
    e=$[$c*$b]
    formula$n=\root{\textstyle $p} \of{$d} \cdot \root{\textstyle $p} \of{$b} \,=\,[?]
    answer$n=$a,sqrt($e),$p
    texanswer$n=\left[ \begin{array}{l}\root{\textstyle $p} \of{$d} \cdot \root{\textstyle $p} \of{$b} \,=\, \root{\textstyle $p } \of{ $[$d*$b] } \\ \root{\textstyle $p } \of{ $e \cdot $a^{$p} }  =  $a \root{\textstyle $p} \of{$e} \end{array} \right.
    
    applettext=!nospace sqrt[$p]($d) cdot sqrt[$p]($b) =
 !exit
!endif

