<a id="secdefinitions"></a><div class="frame"><h3 class="l2w_content defn">Définition &#58; $m_titdefinition [Inéquation]</h3><div class="l2w_content defn">
		Une inéquation est une inégalité dans laquelle intervient un nombre inconnu désigné le plus souvent par une lettre.
	</div><br class="spacer">	
		
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_a=$[rint($(tmp0)*$(tmp1))]

		
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_b=$[rint($(tmp0)*$(tmp1))]

		
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_c=$[rint($(tmp0)*$(tmp1))]

		
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_d=$[rint($(tmp0)*$(tmp1))]

		
!set tmp0=!randitem x,$m_a x,$m_a x,$m_a x,$m_a x,x^2,-2x^2

!set m_var=$(tmp0)

		
!set tmp0=!randitem x,$m_b x,$m_b x,$m_b x,3x^2

!set m_var2=$(tmp0)

		
!set tmp0=!randitem >,<

!set m_inf=$(tmp0)

	
	<h3 class="l2w_content exemple">Exemple &#58; $m_titexemple [ 
!read primitives.phtml 5, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 
	]</h3><div class="l2w_content exemple"><div class="center">
			
!insmath  \var +\c \inf \var2 +\d 

		</div></div>
<h3 class="l2w_content defn">Définition &#58; $m_titdefinition [Résoudre une inéquation]</h3><div class="l2w_content defn">
		Résoudre une inéquation, c'est déterminer toutes les valeurs que peut <span class="bold" style="color&#58;green">prendre</span> l'inconnue afin que l'inéquation soit vérifiée. Ces valeurs sont les solutions de l'inéquation.
	</div></div>
<div class="frame"><div class="frametitle">Tests de valeurs</div>
	<br class="spacer">	
		
			
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_a=$[rint($(tmp0)*$(tmp1))]

			
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_b=$[rint($(tmp0)*$(tmp1))]

			
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_c=$[rint($(tmp0)*$(tmp1))]

			
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_d=$[rint($(tmp0)*$(tmp1))]

			
!set tmp0=!randint 2, 12

!set tmp1=!randitem -1,1

!set m_e=$[rint($(tmp0)*$(tmp1))]

			
!set tmp0=!randitem -1,1

!set tmp1=!randint 2, 12*$(tmp0)

!set m_f=$[rint($(tmp1))]

			 
!if $m_e=$m_f 

!set m_f=$[rint($m_f-3)]

!endif
<br class="spacer">			
!set tmp0=!randitem x+$m_c,$m_a *x+$m_c,$m_a *x+$m_c,$m_a *x+$m_c,$m_a x+$m_c,x^2+$m_c,-2*x^2+$m_c

!set m_var=!rawmath $(tmp0) 

			
!set tmp0=!randitem x+$m_d,$m_b *x+$m_d,$m_b *x+$m_d,$m_b *x+$m_d,3*x^2+$m_d

!set m_var2=!rawmath $(tmp0) 

			
!set tmp0=!randitem >,<

!set m_inf=$(tmp0)

			
!set evaltmp=$m_var

!set evaltmp=!mathsubst x=($m_e) in $evaltmp
!set tmp0=($evaltmp)
!set m_res1=$[$(tmp0)]

			
!set evaltmp=$m_var2

!set evaltmp=!mathsubst x=($m_e) in $evaltmp
!set tmp0=($evaltmp)
!set m_res2=$[$(tmp0)]

			
!set m_toto=$[$m_res1-$m_res2]
<br class="spacer">			
!set evaltmp=$m_var

!set evaltmp=!mathsubst x=(($m_f)) in $evaltmp
!set tmp0=($evaltmp)
!set m_res11=$[$(tmp0)]

			
!set evaltmp=$m_var2

!set evaltmp=!mathsubst x=(($m_f)) in $evaltmp
!set tmp0=($evaltmp)
!set m_res22=$[$(tmp0)]

			
!set m_toto2=$[($m_res11)-($m_res22)]
<br class="spacer">			 
!if $m_toto<0 and $m_inf=<  

!set m_conc=On a bien \($m_res1<$m_res2\) donc, $m_e est bien solution

!endif

			 
!if $m_toto<0 and $m_inf=> 

!set m_conc=On a \( $m_res1<$m_res2\), donc $m_e n'est pas solution

!endif

			 
!if $m_toto>0 and $m_inf=<  

!set m_conc=On a \( $m_res1>$m_res2\), donc $m_e n'est pas solution

!endif

			 
!if $m_toto>0 and $m_inf=>  

!set m_conc=On a \( $m_res1>$m_res2\), donc $m_e est solution.

!endif

			 
!if $m_toto=0 

!set m_conc=On a \($m_res1=$m_res2\), donc $m_e n'est pas solution.

!endif
<br class="spacer">			 
!if $m_toto2<0 and $m_inf=<  

!set m_conc2=On a bien \($m_res11<$m_res22\) donc, $m_f est bien solution

!endif

			 
!if $m_toto2<0 and $m_inf=> 

!set m_conc2=On a \( $m_res11<$m_res22\), donc $m_f n'est pas solution

!endif

			 
!if $m_toto2>0 and $m_inf=<  

!set m_conc2=On a \( $m_res11>$m_res22\), donc $m_f n'est pas solution

!endif

			 
!if $m_toto2>0 and $m_inf=>  

!set m_conc2=On a \( $m_res11>$m_res22\), donc $m_f est solution.

!endif

			 
!if $m_toto2=0 

!set m_conc2=On a \($m_res11=$m_res22\), donc $m_f n'est pas solution.

!endif
<br class="spacer">		
		<h3 class="l2w_content exemple">Exemple &#58; $m_titexemple [ 
!read primitives.phtml 6, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 
	]</h3><div class="l2w_content exemple">
			On considère l'inéquation 
!insmath \var \inf \var2 
 . La valeur $m_e est-elle solution ? La valeur $m_f ? <br><br class="spacer">			On calcule chacun de deux membres avec la valeur particulière donnée &#58;<br><br class="spacer">			Pour la valeur $m_e, on a &#58; 
!insmath  \var=\res1 
 et 
!insmath  \var2=\res2 
. $m_conc <br><br class="spacer">			Pour la valeur $m_f, on a &#58; 
!insmath  \var=\res11 
 et 
!insmath  \var2=\res22 
. $m_conc2 <br>
		</div></div></div><div id="down_toc"><div class="wims_chemin">
!read primitives.phtml 7, reload, <img src="gifs/doc/etoile.gif" alt="rechargez" style="width:20px;height:20px;"> 
  
!read primitives.phtml 8, link, main, Sur les inéquations 
 &#8594; I Définitions</div></div></div>
