<a id="secexemples"></a><div class="frame"><div class="frametitle">Premier exemple</div>
	<br class="spacer">	
		
			
!set tmp0=!randint 7, 15

!set m_a=$[rint($(tmp0))]

			
!set tmp0=!randint 1, 10

!set m_b=$[rint($(tmp0))]

			
!set tmp=!nonempty items +,-

!set tmp0=!randitem $tmp
!set m_s1=$(tmp0)

			
!set tmp=!nonempty items +,-

!set tmp0=!randitem $tmp
!set m_s2=$(tmp0)

			  
!if $m_s1=+ 

!set m_s1c=-

!else
 
!set m_s1c=+

!endif

			  
!if $m_s2=+ 

!set m_s2c=-

!else
 
!set m_s2c=+

!endif

			
!set tmp0=!randint 2, $m_a-1

!set m_ap=$[rint($(tmp0))]

			
!set tmp0=!randint 1, 10

!set m_bp=$[rint($(tmp0))]

			
!set tmp=!nonempty items leq,geq

!set tmp0=!randitem $tmp
!set m_ineq=$(tmp0)

			
!set m_A=$[rint($m_a - $m_ap)]

			
!set m_B=$[rint($m_bp $m_s1c $m_b)]

			
!set t_=!rawmath $m_B / $m_A 
!set m_C=!exec pari print($t_)

			 
!if $m_ineq=leq 

!set m_graphsol=segment  -10,0,$m_C,0,green

!else
 
!set m_graphsol=segment  10,0,$m_C,0,green

!endif

			 
!if $m_ineq=leq 

!set m_hache=parallel 10.2,0.6,9.8,-0.6,-0.5,0,2*(10-$m_C),red

!else
 
!set m_hache=parallel -10.2,0.6,-9.8,-0.6,0.5,0,2*abs($m_C+10),red

!endif

			 
!if $m_ineq=leq 

!set m_crochet=parallel $m_C-0.3,1,$m_C,1,0,-2.1,2,green

!else
 
!set m_crochet=parallel $m_C+0.3,1,$m_C,1,0,-2.1,2,green

!endif
<br class="spacer">		
		On veut résoudre l'inéquation &#58; 
!insmath  \a x \s1 \b \\ineq \ap x \s2 \bp 
 
!read primitives.phtml 5, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 

		<br>
		On procède ainsi &#58;<div class="math">
!insmath \begin{matrix}  			\a x \s1 \b & \\ineq & \ap x \s2 \bp \\ 			\a x \s1 \b - {\textcolor{red}{\ap x}} & \\ineq & \ap x \s2 \bp - {\textcolor{red}{\ap x}} \\ 			\A x \s1 \b & \\ineq & \bp \\ 			\A x \s1 \b \s1c {\textcolor{red}{\b}} & \\ineq & \bp \s1c {\textcolor{red}{\b}} \\ 			\A x & \\ineq & \B \\ 			\frac{\A x}{{\textcolor{red}{\A}}} & \\ineq & \frac{\B}{{\textcolor{red}{\A}}} \\ 			x & \\ineq & \C 		\end{matrix}
</div>
<div class="center">
	      
!read primitives.phtml 6, draw, 500,70, xrange -10,10	       yrange -3,3	       hline  0,0,1,0,black	       parallel -10,-0.8,-10,0.8,1,0,20,grey	    parallel 0,-0.8,0,0.8,1,0,2,black	    text black,0,-1,medium,O	    text black,1,-1,medium,1	    segment  \C,-1,\C,1,green	    \crochet	    \hache	    \graphsol	     

	    </div>
		On hachure la partie non solution (ici en rouge), et surligne (ici en vert) la partie solution. Il est important de toujours mentionner la légende. (Certaines personnes hachurent la partie solution, il n'y a pas de règle, il faut préciser à chaque fois.)
	
</div>
<div class="frame"><div class="frametitle">Deuxième exemple</div>
	
	
		
			
!set tmp0=!randint 2, 7

!set m_a=$[rint($(tmp0))]

			
!set tmp0=!randint 1, 10

!set m_b=$[rint($(tmp0))]

			
!set tmp=!nonempty items +,-

!set tmp0=!randitem $tmp
!set m_s1=$(tmp0)

			
!set tmp=!nonempty items +,-

!set tmp0=!randitem $tmp
!set m_s2=$(tmp0)

			  
!if $m_s1=+ 

!set m_s1c=-

!else
 
!set m_s1c=+

!endif

			  
!if $m_s2=+ 

!set m_s2c=-

!else
 
!set m_s2c=+

!endif

			
!set tmp0=!randint 8, 15

!set m_ap=$[rint($(tmp0))]

			
!set tmp0=!randint 1, 10

!set m_bp=$[rint($(tmp0))]

			
!set tmp=!nonempty items leq,geq

!set tmp0=!randitem $tmp
!set m_ineq=$(tmp0)

			 
!if $m_ineq=leq 

!set m_ineq2=geq

!else
 
!set m_ineq2=leq

!endif

			
!set m_A=$[rint($m_a - $m_ap)]

			
!set m_B=$[rint($m_bp $m_s1c $m_b)]

			
!set t_=!rawmath $m_B / $m_A 
!set m_C=!exec pari print($t_)

			 
!if $m_ineq=geq 

!set m_graphsol=segment  -10,0,$m_C,0,green

!else
 
!set m_graphsol=segment  10,0,$m_C,0,green

!endif

			 
!if $m_ineq=geq 

!set m_hache=parallel 10.2,0.6,9.8,-0.6,-0.5,0,2*(10-$m_C),red

!else
 
!set m_hache=parallel -10.2,0.6,-9.8,-0.6,0.5,0,2*abs($m_C+10),red

!endif

			 
!if $m_ineq=geq 

!set m_crochet=parallel $m_C-0.3,1,$m_C,1,0,-2.1,2,green

!else
 
!set m_crochet=parallel $m_C+0.3,1,$m_C,1,0,-2.1,2,green

!endif
<br class="spacer">		
		On veut résoudre l'inéquation &#58; 
!insmath  \a x \s1 \b \\ineq \ap x \s2 \bp 
 
!read primitives.phtml 7, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 

		<br>
		On procède ainsi &#58;<div class="math">
!insmath \begin{matrix}  			\a x \s1 \b & \\ineq & \ap x \s2 \bp \\ 			\a x \s1 \b - {\textcolor{red}{\ap x}} & \\ineq & \ap x \s2 \bp - {\textcolor{red}{\ap x}} \\ 			\A x \s1 \b & \\ineq & \bp \\ 			\A x \s1 \b \s1c {\textcolor{red}{\b}} & \\ineq & \bp \s1c {\textcolor{red}{\b}} \\ 			\A x & \\ineq & \B \\ 			\frac{\A x}{{\textcolor{red}{\A}}} & {\textcolor{red}{\\ineq2}} & \frac{\B}{{\textcolor{red}{\A}}} \\ 			x & \\ineq2 & \C 		\end{matrix}
</div>
<div class="center">
	      
!read primitives.phtml 8, draw, 500,70, xrange -10,10	       yrange -3,3	       hline  0,0,1,0,black	       parallel -10,-0.8,-10,0.8,1,0,20,grey	    parallel 0,-0.8,0,0.8,1,0,2,black	    text black,0,-1,medium,O	    text black,1,-1,medium,1	    segment  \C,-1,\C,1,green	    \crochet	    \hache	    \graphsol	     

	    </div>
		On hachure la partie non solution (ici en rouge), et surligne (ici en vert) la partie solution. Il est important de toujours mentionner la légende. (Certaines personnes hachurent la partie solution, il n'y a pas de règle, il faut préciser à chaque fois.)
	
</div></div><div id="down_toc"><div class="wims_chemin">
