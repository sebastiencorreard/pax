\title{Problème et système d'équations 2}

\precision{10000}
\text{genre=randitem(boy,girl)}
\text{noms=slib(lang/fname fr,\genre,2)}
\text{prenom1=item(1,\noms)}
\text{prenom2=item(2,\noms)}





\integer{prixA=randint(15..30)}
\integer{prixB=randint(15..30)}

\if{\prixA=\prixB}{





\integer{prixA=17}
\integer{prixB=22}

}




\real{prixA=\prixA/10}
\real{prixB=\prixB/10}
\text{t=shuffle(2,3,4,5,6,7)}

\integer{nbA1=\t[1]}
\integer{nbA2=\t[2]}
\integer{nbB1=\t[3]}
\integer{nbB2=\t[4]}
\integer{nbB2=\nbA1*\nbB2-\nbA2*\nbB1=0?\nbB2+1}
\real{total1=\nbA1*\prixA+\nbB1*\prixB}
\real{total2=\nbA2*\prixA+\nbB2*\prixB}
w

\text{listnoms=shuffle(de pommes,de poires,de pêches,de fraises,de framboises,de poivrons,de courgettes,de carottes,de tomates,d'aubergines)}
\text{enonce=Chez l'épicier, \prenom1 achète \nbA1 kilos \listnoms[1] et \nbB1 kilos \listnoms[2]
  pour \total1 euros. \prenom2 achète \nbA2 kilos \listnoms[1] et \nbB2 kilos \listnoms[2] pour \total2 euros.}
\text{enonce2=Déterminez le prix d'un kilo \listnoms[1] et le prix d'un kilo \listnoms[2].}
\text{name_prix=Prix d'un kilo,Prix d'un kilo}

