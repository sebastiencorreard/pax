      \integer{tmp3=item(1,\tmp)*100}
      \integer{tmp4=item(2,\tmp)*100}
      \text{tmp=\tmp3/\tmp4}
    }
  }
  \text{tmp=simplify(\tmp)}
  \text{tmp=texmath(\tmp)}
  \text{tmp1=wims(append item \(\tmp\) to \tmp1)}
  \text{tmp=item(\i,\nb)}
  \text{tmp=texmath(\tmp)}
  \text{tmp2=wims(append item \(\tmp\) to \tmp2)}
}
