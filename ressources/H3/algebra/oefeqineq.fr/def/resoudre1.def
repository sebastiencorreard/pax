tmp=!nonempty items x,y,a,b

tmp0=!randitem $tmp
val26=$(tmp0)
val27=$val13*$val26+($val14)
val28=$val12*$val26+($val17)
val29=$val18*$val26+($val19)
!if $val12+($val18)=0 or  $val12-($val18)=0 
val18=2
val12=3
!endif
tmp=!translate ";': to $     $ in -($val21)/($val20)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in -($val23)/($val22)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in -($val21)/($val20)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in -($val23+($val25))/($val22+($val24))

tmp=!lower $tmp
