!set title=Soustraction à trou 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Complétez l'opération suivante&nbsp;
val7=Réponse
val8=Donner votre résultat sous une forme aussi simplifiée que possible.
val9=$[rint(4)]

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val3=
val3=$[rint(1)]
!endif
tmp0=!record $val2 of src/generateur

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 3 of $val11

val13=$(tmp0)
!if $val12= 
tmp0=!item 1 of $val11

val14=$(tmp0)
tmp0=!item 2 of $val11

val15=$(tmp0)
!if $val13<0 
tmp0=!values $val13*v,-($val13)*v for v=$val14 to $val15

val16=$(tmp0)
!else
tmp0=!values $val13*v for v=$val14 to $val15

val16=$(tmp0)
!endif
!else
val16=$val12
!if $val13<0 
tmp0=!replace internal , by ,- in $val16

val17=$(tmp0)
tmp0=!listunion $val16 and $val17

val16=$(tmp0)
!endif
!endif
tmp0=!listuniq $val16

val16=$(tmp0)
tmp0=!shuffle $val16

val16=$(tmp0)
tmp0=!item 1 of $val16

val14=$(tmp0)
tmp0=!item 2 of $val16

val15=$(tmp0)
!if $val2>=5 
val18=$[rint(100*$val14)]
val19=$[rint(100*$val15)]
!else
val18=$val14
val19=$val15
!endif
tmp=!nonempty items x,y,z,a,b

tmp0=!randitem $tmp
val20=$(tmp0)
!if $val2>=5 
val17=$[rint(($val18)-($val19))]
!readproc slib/decimal $val17,2 
tmp0=$slib_out
val21=$(tmp0)
!else
tmp=!translate ";': to $     $ in $val14-($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=$(tmp0)
!endif
tmp0=!texmath $val14

val22=$(tmp0)-
tmp0=!texmath =$val15

val23=$(tmp0)
val24=$[rint(0)]
tmp0=!texmath \enonce

val25=$(tmp0)
replytype1=numexp
replyname1=$val7
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

