$()	
!if $val24=1 
$()$(val6[1]) 
!insmath $val25
$().	<div class="wimscenter">	<label for="reply1">
!insmath $val20 =
$()</label>  
!read oef/embed.phtml reply 1,$val9 
$().	</div>	<div class="wims_instruction">$val8</div> 
!else
$()	 $(val6[1]):	<label for="reply1">
!insmath $val22
$()</label>  
!read oef/embed.phtml reply 1,$val9 
$() 
!insmath $val23
$(). 
!endif
$()
$()
!exit

