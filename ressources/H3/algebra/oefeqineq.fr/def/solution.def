!set title=Solution(s) d'équations 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
