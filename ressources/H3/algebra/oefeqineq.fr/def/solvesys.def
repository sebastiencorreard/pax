val8=$[rint($(tmp0))]
tmp0=!randint 7, 30

val9=$[rint($(tmp0))]
!if $val8=$val9 
val8=$[rint(7)]
val9=$[rint(12)]
!endif
tmp0=!randint 2, 7

val10=$[rint($(tmp0))]
tmp0=!randint 2, 7

val11=$[rint($(tmp0))]
tmp0=!randint 2, 7

val12=$[rint($(tmp0))]
tmp0=!randint 2, 7

val13=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in x,y	u,v	a,b

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val17=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val18=$(tmp0)
val19=$[$val10*$val8 $val17 $val12*$val9]
val20=$[$val11*$val8 $val18 $val13*$val9]
tmp0=!char 1 to 2 of \{}

val21=$(tmp0)
val22=\left$val21\begin{array}{ccccc}	$val10 $val15 & $val17 & $val12 $val16 & = & $val19\\$val11 $val15 & $val18 & $val13 $val16 & = & $val20		\end{array}\right.
replytype1=numexp
replyname1=\($val15\)
replygood1=$val8
replytype2=numexp
replyname2=\($val16\)
replygood2=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

