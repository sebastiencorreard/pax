!set title=Problème et système d'équations 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items boy,girl

tmp0=!randitem $tmp
val6=$(tmp0)
!readproc slib/lang/fname fr,$val6,2 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!randint 7, 30

val10=$[rint($(tmp0))]
tmp0=!randint 7, 30

val11=$[rint($(tmp0))]
!if $val10=$val11 
val10=$[rint(7)]
val11=$[rint(12)]
!endif
tmp0=!shuffle 7

val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint($(val12[2]))]
val15=$[rint($(val12[3]))]
val16=$[rint($(val12[4]))]

!ifval $val13*$val16-$val14*$val15=0
val16=$[rint($val16+1)]
!endif
val17=$[$val13*$val10+$val15*$val11]
val18=$[$val14*$val10+$val16*$val11]
tmp=!nonempty items CD,DVD

tmp0=!randitem $tmp
val19=$(tmp0),BD
val20=Dans un grand magasin, le prix des $(val19[1]) est unique, ainsi que celui des $(val19[2]).	  $val8 achète $val13 $(val19[1]) et $val15 $(val19[2]) pour $val17 euros.	  $val9 achète $val14 $(val19[1]) et $val16 $(val19[2]) pour $val18 euros.	
val21=Déterminez le prix d'un $(val19[1]) et le prix d'une $(val19[2]).
val22=Prix d'un,Prix d'une
replytype1=auto

replyname1=$(val22[1]) $(val19[1])
replygood1=$val10
replytype2=auto

replyname2=$(val22[2]) $(val19[2])
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div>$val20	<p>$val21</p>	</div>	<ul>	<li><label for="reply1">$(val22[1]) $(val19[1])</label> :  
!read oef/embed.phtml r1,10 
$() euros</li>	<li><label for="reply2">$(val22[2]) $(val19[2])</label> :  
!read oef/embed.phtml r2,10 
$() euros</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=19,20,21,22
embedcnt=2
