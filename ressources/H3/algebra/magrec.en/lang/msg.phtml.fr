!! This file contains error messages. It will be processed
!! whenever the variable `error' is not empty.

<b>$wims_name_Error</b>

!if bound_integer=$error
  Les nombres entrés ne sont pas des entiers compris entre 1 et $[$cols*$rows].
  Veuillez corriger l'erreur et réessayer.
  !exit
!endif
!if bad_sum=$error
  Mauvais calcul&nbsp;: les lignes ou colonnes dont $(n_$kind)
  n'est pas juste sont indiquées en rouge.
  Veuillez corriger l'erreur et réessayer.
  !exit
!endif
!if $error=double_number
  Le nombre $e a été utilisé plusieurs fois. Veuillez corriger.
  !exit
!endif

!msg $error
