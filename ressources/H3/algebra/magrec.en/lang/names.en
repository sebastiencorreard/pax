!set lang_exists=yes

!set name_intro=A magic square is a table of n rows and n columns, \
  filled by numbers 1, 2, ..., \(n^2\), such that the sums of \
  each row and each column are equal

!set name_intro2=is a variation of this principle

!distribute lines you are before a table of\
  rows\
  and\
  columns\
  with a given number at the side of each row and each column.\
  Your goal is to fill this table using the numbers 1, 2, ...,rows&times;columns, so that the\
  of each row and each column equals the corresponding given number.\
   And you should solve each problem within\
  minutes\
  And of course no number can be used twice.\
into name_intro3,name_rows,name_and,name_cols,name_intro4,name_intro5,name_intro6\
  name_intro7,name_minutes,name_intro8

!set n_sum=sum
!set n_product=product

!set name_instruction=!nosubst Fill the following table by the numbers\
  1,2,...,$[$cols*$rows],\
  so that the $(n_$kind) of each row and of each column equals\
  the corresponding blue number.\
  Each number can only be used once.

!set name_tester=Test the solution
!set name_chrono=!nosubst To have a maximal score, you must solve the problem within
!set name_chrono2=It remains
!set name_second=seconds

!set name_giveup=Abandon and see a solution
!set name_start=Start to play

!set name_answer=Great! You have successfully constructed this table.
!set name_answerchrono=But you have exceeded a bit the allowed time.
!set name_answergiveup=Sorry that you have abandonned. Here is a solution of the problem\
  (there may be other solutions).

!set name_Score=Your score
