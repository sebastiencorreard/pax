!! This file contains error messages. It will be processed
!! whenever the variable `error' is not empty.

<b>$wims_name_Error</b>

!if bound_integer=$error
  The given numbers are not integers between 1 and $[$cols*$rows].
  Please correct the error and try again.
  !exit
!endif
!if bad_sum=$error
  Bad computation: the rows or columns whose
  $(n_$kind)
  does not match are shown in red.
  Please correct the error and try again.
  !exit
!endif
!if $error=double_number
  The number $e has been used several times. Please correct.
  !exit
!endif

!msg $error
