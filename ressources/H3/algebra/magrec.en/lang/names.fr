!set lang_exists=yes

!set name_intro=Un carré magique est un tableau de n lignes et n colonnes, \
  rempli par les nombres 1, 2, ..., \(n^2\), tel que les sommes des lignes \
  et des colonnes sont identiques.
!set name_intro2=est une variation de ce principe&nbsp;

!distribute lines Vous êtes devant un tableau de\
  lignes\
  et\
  colonnes\
  avec un nombre donné à côté de chaque ligne et chaque colonne.\
  Le but sera de remplir ce tableau par les nombres 1, 2,..., lignes&times;colonnes de sorte que\
  de chaque ligne et chaque colonne égale le nombre donné correspondant.\
  Vous devez résoudre chaque problème en\
  minutes\
  Bien entendu, aucun nombre ne peut être utilisé deux fois.\
into name_intro3,name_rows,name_and,name_cols,name_intro4,name_intro5,name_intro6\
  name_intro7,name_minutes,name_intro8

!set n_sum=la somme
!set n_product=le produit

!set name_instruction=!nosubst Remplissez le tableau suivant par les nombres\
  1, 2, ..., $[$cols*$rows]\
  de sorte que $(n_$kind) de chaque ligne et de chaque colonne égale\
  le nombre bleu correspondant.\
  Chaque nombre ne peut être utilisé qu'une seule fois.

!set name_tester=Tester la solution
!set name_chrono=!nosubst Pour avoir un score maximal, vous devez résoudre ce problème en
!set name_chrono2=Il vous reste
!set name_second=secondes
!set name_start=Commencer à jouer
!set name_giveup=Abandonner et voir la solution

!set name_answer=Bravo! Vous avez bien réussi ce tableau.
!set name_answerchrono= Mais vous avez un peu dépassé le temps autorisé.

!set name_answergiveup=C'est dommage que vous ayez abandonné. Voici une solution du problème\
  (il peut y en avoir d'autres).

!set name_Score=Votre score&nbsp;
