!! This file contains error messages. It will be processed
!! whenever the variable `error' is not empty.

<b>$wims_name_Error</b>

!if bound_integer=$error
  I numeri inseriti non sono interi compresi tra 1 e $[$cols*$rows].
  Puoi correggere e riprovare.
  !exit
!endif
!if bad_sum=$error
  Errore di conto: le righe e le colonne per cui
  $(n_$kind)
  non corrisponde alla richiesta sono indicate in rosso.
  Puoi correggere e riprovare.
  !exit
!endif
!if $error=double_number
  Il numero $e è stato utilizzato più di una volta. Puoi correggere riprovare.
  !exit
!endif

!msg $error
