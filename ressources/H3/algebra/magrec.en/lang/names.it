!set lang_exists=yes

!set name_intro=Un quadrato magico è una tabella con n righe e n colonne, \
  riempita con numeri 1, 2, ..., \(n^2\), in modo che la somma di \
  ogni riga e di ogni colonna sia uguale

!set name_intro2=è una variazione di questa idea

!distribute lines Viene proposta una tabella con \
  righe\
  e\
  colonne\
  con un numero indicato a lato di ogni riga e di ogni colonna.\
  Lo scopo è di riempire questa tabella utilizzando i numeri 1, 2, ...,rows&times;columns, in modo che \
  di ogni riga e di ogni colonna sia uguale al numero indicato.\
   Per risolvere il problema hai un tempo massimo di\
  minuti\
  Naturalmente nessun numero può essere utilizzato più di una volta.\
into name_intro3,name_rows,name_and,name_cols,name_intro4,name_intro5,name_intro6\
  name_intro7,name_minutes,name_intro8

!set n_sum=la somma
!set n_product=il prodotto

!set name_instruction=!nosubst Completa la seguente tabella utilizzando i numeri\
  1,2,...,$[$cols*$rows],\
  in modo che $(n_$kind) di ogni riga e di ogni colonna sia uguale\
  al numero corrispondente indicato in blu.\
  Ogni numero può essere utilizzato una sola volta.

!set name_tester=Verifica la soluzione
!set name_chrono=!nosubst Per ottenere il punteggio massimo, devi completare questo prolema entro
!set name_chrono2=Hai a disposizione
!set name_second=secondi

!set name_giveup=Abbandona e visualizza una soluzione
!set name_start=Inizia il gioco

!set name_answer=Molto bene! Hai completato correttamente la tabella.
!set name_answerchrono=Ma hai utilizzato un po' troppo tempo!
!set name_answergiveup=Peccato che tu abbia abbandonato. Ecco una soluzione \
  del problema\
  (potrebbero esserci altre soluzioni).

!set name_Score=Il tuo punteggio
