!readproc slib/lang/fname  $val6  
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 1, 7

val8=$[rint($(tmp0))]
val9=$[rint($val8+1)]
tmp0=!randint $val9, 15

val10=$[rint($(tmp0))]
tmp0=!randint 1, 6

val11=$[rint($(tmp0))]
val12=$[rint($val11+1)]
tmp0=!randint $val12, 9

val13=$[rint($(tmp0))]
t_=!rawmath $val8/$val10
val14=!exec pari print($t_)
val15=\dfrac{$val8}{$val10}
t_=!rawmath $val11/$val13
val16=!exec pari print($t_)
val17=\dfrac{$val11}{$val13}
tmp0=!randint 1, 9

val18=$[rint($(tmp0)*($val10-$val8)*($val13-$val11))]
