val19=!exec pari print($t_)
t_=!rawmath ($val18)/($val19)
val20=!exec pari print($t_)
val21=TIT
!readproc slib/oef/env lang 
tmp0=$slib_out
val22=$(tmp0)
!if $val6=boy 
val23=Il
!else
val23=Elle
!endif
val24=Reste
val25=$val7 a $val20 euros. $val23 en dépense \($val14\) dans un premier achat et \($val16\) de ce qui lui reste dans un deuxième achat. Calculer la somme qui reste à $val7.
val26=Il reste \( $val18 \) euros à $val7.
replyname1=$val24
replygood1=$val18 
question=__EXECUTED_1692754_EXERCISE__
