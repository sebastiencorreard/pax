!set title=2 - Résistances en dérivation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=jbfrondas@gmail.com
language=fr
precision=10000
computeanswer=no

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 99

val6=$[rint($(tmp0))]
tmp0=!randint 1, 99

val7=$[rint($(tmp0))]
t_=!rawmath ($val6+$val7)/($val6*$val7)
val8=!exec pari print($t_)
val9=TIT
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Dans un circuit électrique, on a deux résistances \( R_{1}= $val6 \) \(\Omega\) et \( R_{2}=$val7 \) \(\Omega\) montées en dérivation. On veut remplacer ces deux résistances par une résistance équivalente \( R \). Quelle est la valeur de \( R \) ?
val12=On rappelle que dans ce cas, la valeur de la résistance équivalente est donnée par la formule : \( \dfrac{1}{R}=\dfrac{1}{R_1}+\dfrac{1}{R_2}\)
replyname1=R \( (\Omega) \)
replygood1=$val8 
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val12

solution=!nosubst 

latex=!nosubst  \begin{statement} $val11 $val12 \end{statement} \begin{solution} \(R= $val8 \Omega\) \end{solution} 


!goto stat

!exit

:question
$()$val11
$()
!exit

:hint
$()$val12
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val11 $val12 $m_end{statement} $m_begin{solution} 
!insmath R= $val8 \Omega
$() $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,11,12
embedcnt=0
