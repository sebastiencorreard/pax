\title{Snelheid en teller}
\language{nl}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{100}

\real{v=randint(0..24)*5}
\integer{hd=randint(0..10)}
\integer{ha=randint(\hd+3..\hd+7)}
\integer{t=\ha-\hd}
\integer{d=\v*\t}
\integer{kmd=randint(10000..10500)}
\integer{kma=\kmd+\d}

\steps{reply1
reply2
reply3}

\statement{Een automobilist vertrek van zijn huis om \hd uur, zijn 
kilometerteller geeft \kmd km aan. Hij komt om \ha uur terug, de teller 
staat dan op \kma km.  <p>
\if {\step=1}{Welke afstand heeft hij gereden? }
\if {\step=2}{Hoe lang heeft hij gereden?}
\if {\step=3}{Inderdaad, hij heeft \d km gereden, in \t uur. Wat was zijn 
gemiddelde snelheid, per uur?}

<p><b><font color="purple"> Afspraak : geef de eenheden aan.</font></b>}

\answer{De afgelegde afstand is}{\d km}{type=units}
\answer{Hij heeft}{\t u} {type=units}{gereden}
\answer{Zijn gemiddelde snelheid is}{\v km/u}{type=units}

\hint{\if{\step=1}{De afgelegde afstand is het verschil tussen wat de teller 
bij aankomst aangeeft en wat hij bij vertrek aangaf.}
\if{\step=2}{De duur van het traject is het verschil tussen de tijd van 
aankomst en de tijd van vertrek.}
\if{\step=3}{De gemiddelde snelheid per uur is de afgelegde afstand gedeeld 
door de tijd die hij gereden heeft}}
