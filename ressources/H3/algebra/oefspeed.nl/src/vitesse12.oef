\title{Snelheid}
\language{nl}
\range{-5..5}
\author{Karine MAURICE et Bernadette PERRIN-RIOU}
\email{kreen.maurice@free.fr,bpr@math.u-psud.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{100}

\integer{h=randint(7..11)}
\integer{hr=randint(\h+1..\h+4)}
\integer{t1=randint(5..58)}
\integer{v1=randint(45..100)}
\integer{t2=randint(5..58)}
\integer{v2=randint(45..100)}
\integer{t3=randint(5..58)}
\integer{v3=randint(45..100)}

\real{d1=ceil(\v1*\t1/60*100)/100}
\real{d2=ceil(\v2*\t2/60*100)/100}
\real{d3=ceil(\v3*\t3/60*100)/100}
\real{d=ceil((\d1+\d2+\d3)*100)/100}
\real{tmin=\t1+\t2+\t3}

conversie van de tijd in minuten naar uur/minuten
\integer{t=floor(\tmin/60)}
\integer{th=floor(\t)}
\integer{tm=\tmin-60*\th}
\integer{tha=\th+\h}

\real{v=ceil((\d/(\tmin/60))*100)/100}

\text{liste= ja, nee}
\text{rep=\hr>\h+\t?item(1,\liste):item(2,\liste)}
\text{liste1=gedurende \t1 minuten met een snelheid van \v1 km/u, 
\d1 km in \t1 minuten, gedurende \d1 km met een snelheid 
van \v1 km/u}
\text{liste2=gedurende \t2 minuten met een snelheid van \v2 km/u, \d2 km in  
\t2 minuten, gedurende \d2 km met een snelheid van \v2 km/u}
\text{liste3=gedurende \t3 minuten met een snelheid van \v3 km/u, \d3 km in  
\t3 minuten, gedurende \d3 km met een snelheid van \v3 km/u}
\text{portion1=randitem(\liste1)}
\text{portion2=randitem(\liste2)}
\text{portion3=randitem(\liste3)}

\steps{reply1
reply2
reply3
choice1}

\statement{
Meneer Snel vertrekt van Amsterdam om \h uur en rijdt eerst \portion1, 
vervlogens \portion2, en daarna \portion3. 
<p>
\if{\step=1}{Hoeveel kilometers heeft hij afgelegd (naar boven afgerond 
tot op een nauwkeurigheid van 0.01)?}
\if{\step>=2}{Hij heeft \d km afgelegd.}
\if{\step=2}{<p>Hoeveel tijd heeft hij over het traject gedaan?}
\if{\step>=3}{Zijn traject heeft \th u \tm min geduurd.}
\if{\step=3}{<p>Wat was zijn gemiddelde snelheid over de hele rit?}
\if{\step>=4}{Zijn gemiddelde snelheid over de hele rit is \v km/u.}
\if{\step=4}{<p>Hij heeft om \hr uur een afspraak. Zal hij op tijd zijn?
\embed{choice1}}
<p><b><font color="purple">Afspraak: geef de eenheden aan: bijvoorbeeld 3  km, 5 km/u , 1u 32min (laat een spatie tussen de uren en de minuten).
</font></b>}

\hint{
\if{\step=1}{We berekenen de afstand vanaf de tijd voor het traject 
(in uren) en de snelheid met behulp van de relatie \(a=s*t)}
\if{\step=2}{Of hij wel of niet op tijd aankomt hangt van zijn 
aankomsttijd af, en dus van de tijd die hij over het traject doet}
\d - \th u \tm min}


\answer{Afgelegde afstand}{\d km}{type=units}
\answer{Duur van het traject}{\th u \tm min}{type=units}
\answer{Gemiddelde snelheid}{\v km/u}{type=units}
\choice{}{\rep}{\liste}

\feedback{\step>=4 \choice1 notsametext \rep}{De duur van zijn traject is 
\th uur \tm min. Hij komt dus om \tha u \tm min aan, wat 
\if{\hr>=\h+\t}{voor}{na} het tijdstip van zijn afspraak is.}
