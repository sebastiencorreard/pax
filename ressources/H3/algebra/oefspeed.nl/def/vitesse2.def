!set title=Snelheid en teller
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette PERRIN-RIOU
email=bpr@math.u-psud.fr
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 24

val6=$[$(tmp0)*5]
tmp0=!randint 0, 10

val7=$[rint($(tmp0))]
tmp0=!randint $val7+3, $val7+7

val8=$[rint($(tmp0))]
val9=$[rint($val8-$val7)]
val10=$[rint($val6*$val9)]
tmp0=!randint 10000, 10500

val11=$[rint($(tmp0))]
val12=$[rint($val11+$val10)]
oefsteps=reply1	reply2	reply3 
nextstep=!nosubst reply1	reply2	reply3 
!readproc oef/steps.proc
replytype1=units
replyname1=De afgelegde afstand is
replygood1=$val10 km
replytype2=units
replyname2=Hij heeft
replygood2=$val9 u
replytype3=units
replyname3=Zijn gemiddelde snelheid is
replygood3=$val6 km/u
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Een automobilist vertrek van zijn huis om $val7 uur, zijn 	kilometerteller geeft $val11 km aan. Hij komt om $val8 uur terug, de teller 	staat dan op $val12 km.  <p>	 
!if $m_step=1 
$()Welke afstand heeft hij gereden?  
!endif
$()	 
!if $m_step=2 
$()Hoe lang heeft hij gereden? 
!endif
$()	 
!if $m_step=3 
$()Inderdaad, hij heeft $val10 km gereden, in $val9 uur. Wat was zijn 	gemiddelde snelheid, per uur? 
!endif
$()		<p><b><font color="purple"> Afspraak : geef de eenheden aan.</font></b>
$()
!exit

:hint
$() 
!if $m_step=1 
$()De afgelegde afstand is het verschil tussen wat de teller 	bij aankomst aangeeft en wat hij bij vertrek aangaf. 
!endif
$()	 
!if $m_step=2 
$()De duur van het traject is het verschil tussen de tijd van 	aankomst en de tijd van vertrek. 
!endif
$()	 
!if $m_step=3 
$()De gemiddelde snelheid per uur is de afgelegde afstand gedeeld 	door de tijd die hij gereden heeft 
!endif
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12
embedcnt=0
