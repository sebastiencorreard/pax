!set lang_exists=yes

!set name_answer=!nosubst Jazeker. Je hebt met succes deze $level \
  puzzel opgelost na $replycnt verschuivingen.

!set name_form=Laat de originele foto zien,Terug naar het beginpunt

!set name_intro1=is een online puzzeltje, waarbij de stukken alleen \
  in horizontale en vertikale richting verschoven kunnen worden.\
  In alle gevallen is de puzzel oplosbaar.

!set name_intro2=is maar weinig wiskunde kennis nodig om dit spelletje,\
  te kunnen spelen
!set name_intro3=Eventueel kun je kijken naar\
   om de bij een schuifpuzzel horende wiskunde te bekijken.

!set name_prompt=Kies het aantal stukken
!set name_goto=Spelen

!set name_change=Verander de puzzel,Andere puzzel,Verander het aantal stukken

!set name_present1=Je ziet hier een foto in,\
  stukken gesneden. De stukken zitten niet op de juiste plaats.\

!set name_alt=Shift up the column,\
  Shift left the row,\
  Shift right the row,\
  Shift down the column,\
  Photo d'origine

!set name_inst1=Click on the arrows to shift the row or the column of pieces in the\
  indicated direction.
!set name_inst2=Lukt het je de originele foto terug te krijgen.
