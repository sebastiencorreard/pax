!set lang_exists=yes

!set name_answer=!nosubst Yes. You have successfully recovered \
  this $level puzzle after $replycnt operations.

!set name_form=Show the original photo,Back to the starting point

!set name_intro1=is an online jigsaw puzzle game, where the pieces can only be shifted\
  vertically or horizontally, column by column or row by row. It is however\
  guaranteed that the solution exists in all the cases presented to you.
!set name_intro2=Few mathematical knowledge is necessary in order to play
!set name_intro3=On the contrary, you can take a look on the exercise-game\
  to see how a jigsaw puzzle can require fairly deep mathematical concepts.

!set name_prompt=Choose the number of pieces you like
!set name_goto=Go play

!set name_change=Change the puzzle,Another puzzle,Change number of pieces

!set name_present1=Here you have a photo cut into,\
  pieces which are reassembled in disorder. Can you recover it

!set name_alt=Shift up the column,\
  Shift left the row,\
  Shift right the row,\
  Shift down the column,\
  Photo d'origine

!set name_inst1=Click on the arrows to shift the row or the column of pieces in the\
  indicated direction.
!set name_inst2=Here is the original photo. Click on it to hide.
