\title{Machten van een geheel getal 2}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}

\text{listnom=Pieter,Jan,Paul,Jelmer,Stephan,Niek,David}
\text{listnom=shuffle(\listnom)}
\text{bad=wims(item 1 to 3 of \listnom)}
\integer{a=2}
\integer{b=3}

\integer{rep1=\a^\b}
\integer{rep2=\b^\a}
\integer{rep3=\a*\b}
\text{rep=shuffle(\rep1,\rep2,\rep3)}
\integer{pos=positionof(\rep1,\rep)}
\text{good=item(\pos,\bad)}

\statement{<br>
Er wordt gevraagd om \(\a^\b) uit te rekenen. \bad[1] vindt \rep[1], \bad[2] trvindt \rep[2] en \bad[3] vindt \rep[3]. Wie heeft het juiste antwoord gegeven?
}

\choice{Antwoord}{\good}{\bad}
