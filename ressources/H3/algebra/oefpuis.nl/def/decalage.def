!set title=Opschuiven van de komma 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval \parmconf1=
val6=$[rint(1)]
!endif
val7=
val8=
val9=
val10=
!for val11 =1 to $val2 
tmp0=!shuffle 1,-1

val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
tmp=!nonempty items 1,1,-1

tmp0=!randitem $tmp
tmp1=!randint 10, 1000

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 3

val16=$[rint($val13*$(tmp0))]
tmp0=!randint 2, 3

val17=$[rint($val14*$(tmp0))]

!ifval $val16<0
val16=$[$val15*10^($val16)]
!else
val16=$[$val15]
!endif
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 1, 3

val18=$[rint($(tmp0)*$(tmp1))]
val19=$val16 \times 10^{$val17}
val20=$[rint($val17+($val18))]

!ifval $val20=0
val18=$[rint($val18+1)]
!endif

!ifval $val20=0
val20=$[rint(1)]
!endif
val21=10^{$val20}
val22=$[$val16*10^(-($val18))]
tmp0=!append item $val19 to $val7

val7=$(tmp0)
tmp0=!append item $val21 to $val9

val9=$(tmp0)
tmp0=!append item $val22 to $val8

val8=$(tmp0)
tmp0=!append item r$val11 to $val10

val10=$(tmp0)
!next
oefsteps=$val10 
nextstep=!nosubst $val10 
!readproc oef/steps.proc
replytype1=numexp
replyname1=\(\lteno[1])
replygood1=$(val8[1])
replytype2=numexp
replyname2=\(\lteno[2])
replygood2=$(val8[2])
replytype3=numexp
replyname3=\(\lteno[3])
replygood3=$(val8[3])
replytype4=numexp
replyname4=\(\lteno[4])
replygood4=$(val8[4])
replytype5=numexp
replyname5=\(\lteno[5])
replygood5=$(val8[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	Vul in:	<center><table><tr><td width=300><ul>	  
!for m_k=1 to $val2 
$()	  <li>
!insmath $(val7[$m_k]) = 
$()  
!read oef/embed.phtml r\k,10 
$() 
!insmath \times $(val9[$m_k])
$().</li>	   
!next
$()	</ul></td></tr></table></center>
$()
!exit

