!set title=Machten van een geheel getal 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval \parmconf1=
val6=$[rint(1)]
!endif
val7=
val8=
val9=
!for val10 =1 to $val2 
tmp0=!shuffle 1,-1

val11=$(tmp0)
tmp=!nonempty items $val11

tmp0=!randitem $tmp
tmp1=!randint 2, 9

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
val14=($val12)^{$val13}
val15=$[($val12)^($val13)]
tmp0=!append item $val14 to $val7

val7=$(tmp0)
tmp0=!append item $val15 to $val8

val8=$(tmp0)
tmp0=!append item r$val10 to $val9

val9=$(tmp0)
!next
oefsteps=$val9 
nextstep=!nosubst $val9 
!readproc oef/steps.proc
replytype1=numexp
replyname1=\($(val7[1]))
replygood1=$(val8[1])
replytype2=numexp
replyname2=\($(val7[2]))
replygood2=$(val8[2])
replytype3=numexp
replyname3=\($(val7[3]))
replygood3=$(val8[3])
replytype4=numexp
replyname4=\($(val7[4]))
replygood4=$(val8[4])
replytype5=numexp
replyname5=\($(val7[5]))
replygood5=$(val8[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	 
!if $val2=1 
$()Schrijf het volgende getal in decimale schrijfwijze: <br>	<center>
!insmath $val7 = 
$()  
!read oef/embed.phtml r1,8 
$().</center> 
!else
$()	 Schrijf de volgende getallen in decimale schrijfwijze:	<center><table><tr><td width=300><ul>	  
!for m_k=1 to $val2 
$()	  <li>
!insmath $(val7[$m_k]) = 
$()  
!read oef/embed.phtml r\k,8 
$().</li>	   
!next
$()	</ul></td></tr></table></center> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=2,7
embedcnt=2
