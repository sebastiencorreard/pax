!set title=Machten 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=puissance3
!readproc slib/expnumeric $val6 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in $val7;
tmp0=!exec maxima $t_

val8=$(tmp0)

!ifval $val2=
val2=$[rint(1)]
!endif
tmp0=!replace internal / by , in $val7

val8=$(tmp0)
tmp0=!item 2 of $val8

val9=$(tmp0)
tmp0=!texmath $val9

val9=$(tmp0)
tmp0=!item 1 of $val8

val10=$(tmp0)
tmp0=!texmath $val10

val10=$(tmp0)
tmp0=!replace internal \left by \times\left in $val10

val10=$(tmp0)
t_=!replace internal \( by ( in $val7;
tmp0=!exec maxima $t_

val8=$(tmp0)
val7=\frac{$val10}{$val9}
replytype1=numexp
replyname1=\($val7)
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	Bereken de volgende uitdrukking: 
!insmath $val7
$()	<br>	<center><hr width=50%></center>	<table class=reply>	<tr><td>	<u><b>Antwoord:</b></u>	<br>	
!insmath $val7
$() =  
!read oef/embed.phtml r1,10 
$() .	</td></tr></table>
$()
!exit

