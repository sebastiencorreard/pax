!set title=Machten van een geheel getal 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Guerimand Fabrice
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=c
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Pieter,Jan,Paul,Jelmer,Stephan,Niek,David
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 to 3 of $val6

val7=$(tmp0)
val8=$[rint(2)]
val9=$[rint(3)]
val10=$[rint($val8^$val9)]
val11=$[rint($val9^$val8)]
val12=$[rint($val8*$val9)]
tmp0=!shuffle $val10,$val11,$val12

val13=$(tmp0)
tmp0=!positionof item $val10 in $val13

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val7

val15=$(tmp0)
choicename1=Antwoord
choicegood1=$val15
choicebad1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	Er wordt gevraagd om 
!insmath $val8^$val9
$() uit te rekenen. $(val7[1]) vindt $(val13[1]), $(val7[2]) trvindt $(val13[2]) en $(val7[3]) vindt $(val13[3]). Wie heeft het juiste antwoord gegeven?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,13
embedcnt=0
