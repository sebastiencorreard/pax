!set title=Tableau de proportionnalité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
language=fr
leftrange=-5.000000
rightrange=5.000000
title_nl=Verhoudingstabel

ansorder=r,r,r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Complète le tableau de proportionnalité suivant&nbsp;
val8=On passe de la ,ligne à la ,en multipliant par
val9=première, seconde
!if $val6=nl 
val7=Maak de volgende verhoudingstabel af
val8=We gaan van de ,regel naar de ,door te vermenigvuldigen met
val9=eerste, tweede
!endif
tmp0=!randint 2, 9

val10=$[rint($(tmp0))]
tmp0=!shuffle 1,2,3,4,5,6,7,8,9

val11=$(tmp0)
val12=$[rint($(val11[1]))]
val13=$[rint($(val11[2]))]
val14=$[rint($(val11[3]))]
val15=$[rint($(val11[4]))]
val16=$[rint($(val11[5]))]
val17=$[rint($(val11[6]))]
val18=$[rint($val12*$val10)]
val19=$[rint($val13*$val10)]
val20=$[rint($val14*$val10)]
val21=$[rint($val15*$val10)]
val22=$[rint($val16*$val10)]
val23=$[rint($val17*$val10)]
tmp0=!randitem 1,2

val24=$(tmp0)
tmp0=!item $val24 of $val9

val25=$(tmp0)
tmp0=!item 3-$val24 of $val9

val26=$(tmp0)

!ifval $val24=1 
val27= $val10
!else
val27=1/$val10
!endif
replytype1=numeric
replyname1=
replygood1=$[$val15]
replytype2=numeric
replyname2=
replygood2=$[$val16]
replytype3=numeric
replyname3=
replygood3=$[$val20]
replytype4=numeric
replyname4=
replygood4=$[$val23]
replytype5=numexp
replyname5=
replygood5=$val27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	<table class="wimscenter wimsborder">	<tr><td>$val12</td><td>$val13</td><td>$val14</td>	<td> 
!read oef/embed.phtml reply 1,6 
$()</td><td> 
!read oef/embed.phtml reply 2,6 
$()</td><td>$val17</td>	</tr><tr>	<td>$val18</td><td>$val19</td><td> 
!read oef/embed.phtml reply 3,6 
$()</td>	<td>$val21</td><td>$val22</td><td> 
!read oef/embed.phtml reply 4,6 
$()</td>	</tr>	</table>	<div><label for="reply5">	$(val8[1]) $val25 $(val8[2]) $val26 $(val8[3])</label>	 
!read oef/embed.phtml reply 5,6 
$().</div>	
$()
!exit

