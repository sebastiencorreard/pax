!set title=Tableau de proportion (nombres décimaux)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=byachepaul@yahoo.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
title_nl=Verhoudingstabel (nombres décimaux)

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Complète le tableau de proportionnalité suivant&nbsp;
val8=Le coefficient de proportionnalité	  (qui permet de passer de la première ligne à la deuxième ligne) est
val9=Pour calculer <b>le coefficient</b> de proportionnalité,	  vous pouvez utiliser les calculs suivants&nbsp;
val10=ou
val11=Pour calculer <b>la quatrième case du tableau</b> de proportionnalité,	  vous pouvez utiliser le calcul suivant&nbsp;
!if $val6=nl 
val7=Complète le tableau de proportionnalité suivant&nbsp;
val8=Le coefficient de proportionnalité	  (qui permet de passer de la première ligne à la deuxième ligne) est
val9=Pour calculer <b>le coefficient</b> de proportionnalité,	  vous pouvez utiliser les calculs suivants&nbsp;
val10=ou
val11=Pour calculer <b>la quatrième case du tableau</b> de proportionnalité,	  vous pouvez utiliser le calcul suivant&nbsp;
!endif
tmp0=!randint 2, 9

val12=$[$(tmp0)/10]
tmp0=!randint 30, 60

val13=$[$(tmp0)/10]
tmp0=!randint 40, 90

val14=$[$(tmp0)/10]

!ifval $val13=$val14
val14=$[ $val14+1]
!endif
val15=$[$val13*$val12]
val16=$[$val14*$val12]
val17=$val12
tmp0=!randitem 1,2,3,4

val18=$(tmp0)

!ifval $val18=1
val19= $val13
!else
val19=$val15
!endif

!ifval $val18=2
val19= $val14
!endif

!ifval $val18=4
val19= $val16
!endif
tmp0=!item $val18 of \(\frac{$val16}{$val14}),\(\frac{$val15}{$val13}),\(\frac{$val16}{$val14}),\(\frac{$val15}{$val13})

val20=$(tmp0)
tmp0=!item $val18 of $val14 &times	 &#63	 = $val16,$val13 &times	 &#63	 = $val15,$val14 &times	 &#63	 = $val16,$val13 &times	 &#63	 = $val15

val21=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val19]
replytype2=numeric
replyname2=
replygood2=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

