!set title=Oeufs de Pâques
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Dingyu
email=xiao@unice.fr
author=XIAO Dingyu
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Paaseieren

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim la moitié, le quart	la moitié, le tiers	le quart, le quart	le tiers, le tiers	le tiers, le quart
val7=!translate internal $	\
$ to ;; in $tmp
val8=Des enfants cherchent des oeufs de Pâques dans un jardin.	  XXXX en a trouvé YYYY, ZZZZ en a trouvé TTTT et NNNN en a trouvé QQQQ.
val9=Combien d'oeufs ont-ils été trouvés&nbsp;
val10=Nombre d'oeufs
!if $val6=nl 
tmp=!trim de helft, een kwart	de helft, een derde	een kwart, een kwart	een derde, een derde	een derde, een kwart
val7=!translate internal $	\
$ to ;; in $tmp
val8=Een aantal kinderen zoeken paaseieren in een tuin.	  XXXX heeft er YYYY, ZZZZ TTTT en NNNN heeft er QQQQ gevonden.
val9=Hoeveel eieren zijn er gevonden
val10=Het aantal eieren
!endif
val11=Patrick, Fabien, Fabrice, Carole, Elodie, Jean-Pierre, Paul, Gérard, Louis, Catherine, Julie, George, Dominique, Charles, Sylvie
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$(tmp0)
tmp0=!item 2 of $val11

val13=$(tmp0)
tmp0=!item 3 of $val11

val14=$(tmp0)
tmp=!trim $(val7[1;]), 1, 4	$(val7[2;]), 1, 6	$(val7[3;]), 2, 4	$(val7[4;]), 1, 3	$(val7[5;]), 5, 12
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp0=!item 1 of $val16

val17=$(tmp0)
tmp0=!item 2 of $val16

val18=$(tmp0)
tmp0=!item 3 of $val16

val19=$[rint($(tmp0))]
tmp0=!item 4 of $val16

val20=$[rint($(tmp0))]
tmp0=!randint 2, 10

val21=$[rint($(tmp0))]
val22=$[rint($val19*$val21)]
val23=$[rint($val21*$val20)]
val24=$val8
tmp0=!replace internal XXXX by $val12 in $val24

val24=$(tmp0)
tmp0=!replace internal YYYY by $val17 in $val24

val24=$(tmp0)
tmp0=!replace internal ZZZZ by $val13 in $val24

val24=$(tmp0)
tmp0=!replace internal TTTT by $val18 in $val24

val24=$(tmp0)
tmp0=!replace internal NNNN by $val14 in $val24

val24=$(tmp0)
tmp0=!replace internal QQQQ by $val22 in $val24

val24=$(tmp0)
replytype1=default
replyname1=$val10
replygood1=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val24 $val9?
$()
!exit

