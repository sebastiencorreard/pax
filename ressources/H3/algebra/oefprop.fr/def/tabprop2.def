val8=Le tableau suivant est-il un tableau de proportionnalité&nbsp;
tmp=!trim Oui, c'est un tableau de proportionnalité.	  Quel est le coefficient de proportionnalité&nbsp;	  En effet, ce n'est pas un tableau de proportionnalité&nbsp;	  donne deux numéros de colonnes qui permettent de conclure à la non proportionnalité.
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Il faut donner deux numéros de colonnes. Un seul ne prouve rien.	  Il faut donner deux numéros de colonnes, pas trois	  Vérifie. On a bien
val10=!translate internal $	\
$ to ;; in $tmp
val11=Donc, ce n'est pas avec ces deux colonnes que vous allez	  pouvoir montrer que le tableau n'est pas un tableau de proportionnalité.
!if $val6=nl 
val7=ja,nee
val8=Is deze tabel een verhoudingstabel
tmp=!trim Juist, het is een verhoudingstabel.	  Met welke factor moet een getal uit de bovenste rij worden vermenigvuldigd	  Inderdaad, het is geen verhoudingstabel.	  Aan welke twee kolommen kun je zien dat dit geen verhoudingstabel is. Geef je antwoord bijvoorbeeld als
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Je moet de nummers van twee kolommen geven. Een enkele bewijst niets.	  Je moest nummers van twee kolommen geven, geen drie.	  Controleer. We hebben 
val10=!translate internal $	\
$ to ;; in $tmp
val11=Dus het is niet aan de hand van deze kolommen	  dat je hebt kunnen zien dat het geen verhoudingstabel is.
!endif
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
tmp0=!shuffle 1,2,3,4,5,6,7,8,9

val13=$(tmp0)
val14=$[rint($(val13[1]))]
val15=$[rint($(val13[2]))]
val16=$[rint($(val13[3]))]
val17=$[rint($val14*$val12)]
val18=$[rint($val15*$val12)]
val19=$[rint($val16*$val12)]
val20=$[rint(\d*$val12)]
val21=$[rint(\e*$val12)]
val22=$[rint(\f*$val12)]
tmp0=!randitem 0,0,1,2,3

val23=$[rint($(tmp0))]

!ifval $val23=1 
val17=$[rint( 2*$val17)]
!endif

!ifval $val23=2 
val18=$[rint( $val18+2)]
!endif

!ifval $val23=3
val19=$[rint( 2*$val18-2)]
!endif

