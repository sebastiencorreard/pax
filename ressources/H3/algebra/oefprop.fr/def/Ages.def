val20=$[rint($val18*$val17)]
val21=$val7
tmp0=!replace internal XXXX by $val11 in $val21

val21=$(tmp0)
tmp0=!replace internal YYYY by $val12 in $val21

val21=$(tmp0)
tmp0=!replace internal ZZZZ by $val19 in $val21

val21=$(tmp0)
