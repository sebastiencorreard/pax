val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp=!trim $(val9[1]), 3, 1	$(val9[2]), 4, 1	$(val9[3]), 5, 1	$(val9[4]), 3, 2	$(val9[5]), 4, 3
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$[rint($(tmp0))]
tmp0=!item 3 of $val14

val17=$[rint($(tmp0))]
tmp0=!randint 5, 30

val18=$[rint($(tmp0))]
