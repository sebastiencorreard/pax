\title{Réduire}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000000}


\integer{confparm3=\confparm3=?1}
\text{champ=wims(record \confparm3 of src/generateur)}
\text{A=row(2,\champ)}
\text{c=item(3,\A)}
\text{a=item(1,\A)}
\text{b=item(2,\A)}
\text{valeurs=wims(values \c*v for v=\a to \b)}
\text{valeurs=wims(listuniq \valeurs)}
\text{valeurs=shuffle(\valeurs)}
\real{a=item(1,\valeurs)}
\real{b=item(2,\valeurs)}

\integer{exm=\confparm1}
\integer{ex1=randint(2..\exm)}
\integer{ex2=randint(1..\ex1)}
\if{\confparm1=1}{
\integer{ex1=1}
\integer{ex2=1}}
\integer{exa=\ex1+\ex2}
\integer{exs=\ex1-\ex2}

\text{x=random(x,y)}

\text{m1=texmath(\a*simplify(\x^\ex1))}
\text{m2=texmath(\b*simplify(\x^\ex2))}
\real{pp=\a*\b}
\real{aa=\a+\b}
\real{ss=\a-\b}

\text{p1=\aa*simplify(\x^\ex1)}
\text{p2=\pp*simplify(\x^\exa)}
\text{p3=\ss*simplify(\x^\ex1)}
\text{p4=<small> On ne peut pas <br> réduire </small>}
\text{p5=\pp*simplify(\x^\ex1)}
\if{\ex1=\ex2}{\text{p6=\ss}}
{\text{p6=\ss*simplify(\x^\exs)}}
\text{p7=\aa*simplify(\x^\exa)}
\if{\ex1=\ex2}{
\text{p8=\(\p1)}
\text{p9=\(\p3)}}
{\text{p8=\p4}
\text{p9=\p4}}

\text{p1=\(\p1)}
\text{p2=\(\p2)}
\text{p3=\(\p3)}
\text{p7=\(\p7)}
\text{p5=\(\p5)}
\text{p6=\(\p6)}

\text{\p=\p1,\p2,\p3,\p4,\p5,\p6,\p7}

\statement{
Réduire, si possible, les expressions suivantes :
<ul>
 <li>\(\m1 + \m2) = \embed{r1,100x50}</li>
 <li> \(\m1 - \m2) = \embed{r3,100x50}</li>
 <li> \(\m1 + \b) = \embed{r4,100x50}</li>
<li>
\if{\confparm3<4}{\(\m1) \times \(\m2)}{\(\m1) \times (\(\m2))}
 = \embed{r2,100x50}
</li><li>
\if{\confparm3<4}{\(\m1) \times \b}{\(\m1) \times (\b)}
 = \embed{r5,100x50}
 </li>
 </ul>
}

\answer{}{\p8;\p}{type=clickfill}{option=shuffle}
\answer{}{\p2;\p}{type=clickfill}
\answer{}{\p9;\p}{type=clickfill}
\answer{}{\p4;\p}{type=clickfill}
\answer{}{\p5;\p}{type=clickfill}
