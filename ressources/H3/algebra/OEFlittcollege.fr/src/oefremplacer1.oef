\title{Remplacer k(a+b) ou k(a-b)#}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand; Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm1=\confparm1}
\integer{confparm2=\confparm2}
\integer{confparm2=\confparm2= or NaN isin \confparm2?2}
\integer{confparm1=NaN isin \confparm1 or \confparm1=?1}
\integer{confparm3=\confparm3=?1}
\text{champ=wims(record \confparm3 of src/generateur)}
\text{A=row(2,\champ)}
\text{c=item(3,\A)}
\text{a=item(1,\A)}
\text{b=item(2,\A)}
\text{valeurs=wims(values \c*v for v=\a to \b)}
\text{valeurs=wims(listuniq \valeurs)}
\text{valeurs=shuffle(\valeurs)}

\real{n=item(1,\valeurs)}

\integer{a=random(-1,1)*random(2..10)}
\integer{b=random(-1,1)*random(2..15)}
\integer{g=maxima(gcd(\a,\b);)}
\integer{a=\a/\g}
\integer{b=\b/\g}
\integer{c=random(-1,1)*random(2..15)}

\text{x=random(x,y)}

\text{lt=wims(values v for v=0 to \confparm1)}
\text{lt=shuffle(\lt)}
\integer{p1=item(1,\lt)}
\integer{p2=item(2,\lt)}
\integer{p3=randitem(\lt)}
\text{m1=simplify(\a*\x^\p1)}
\real{r1=\a*(\n)^\p1}
\text{m2=simplify(\b*\x^\p2)}
\real{r2=\b*(\n)^\p2}
\text{m3=simplify(\c*\x^\p3)}
\real{r3=\c*(\n)^\p3}

\text{sg=\b>0?+:}
\text{rep=\m3*(\m1 \sg \m2)}
\real{r=\r3*(\r1 + \r2)}
\text{rep=wims(rawmath \rep)}
\text{rep7=slib(commutesom \rep,\x)}
\text{enonce=\rep}

\text{repf=texmath(item(2,\rep7))}

\statement{
<p>Calculer l'expression E = \(\rep) avec la valeur \x = \n.</p>
<div class="wimscenter">
Pour \x = \n , nous avons E =\embed{r1,10}.</div>

<p>Calculer l'expression F = \(\repf) avec la valeur \x = \n.</p>
<div class="wimscenter">
Pour \x = \n , nous avons F =\embed{r2,10}.
</div>}


\answer{}{\r}{type=numeric}
\answer{}{\r}{type=numeric}
