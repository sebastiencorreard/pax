\title{Utiliser la lettre x pour calculer}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni; Odile,Benassy}
\email{jluc.donadoni@gmail.com}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{fignum=random(1..5)}
\real{t=random(2,2.5,3,3.5,4,4.5,5,5.5,10,12,15,20,30,50,100,120)}
\text{exprs=2x+\t,3x+\t,5x,\t-x,\t+x,x/4}
\text{expr=item(\fignum,\exprs)}
\function{expr=\expr}

\integer{xval=random(1..20)}
\if{\fignum=4}{\real{xval=random(1,1.5,\t*0.2,\t*0.5,\t*0.7,\t*0.8)}}
\real{yres=evalue(\expr,x=\xval)}
\integer{xres=random(1..20)}
\if{\fignum=4}{\real{xres=random(1.5,\t*0.2,\t*0.5,\t*0.7,\t*0.8)}}
\if{\xres=\xval}{\integer{\xres=\xval-1}}
\real{yval=evalue(\expr,x=\xres)}

\real{essai=evalue(\expr,x=\xval)}


\steps{reply 1
reply 2
}


