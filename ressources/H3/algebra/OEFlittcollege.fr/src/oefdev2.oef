\title{Développer (a+b)(c+d)#}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand; Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm1=\confparm1}
\integer{confparm2=\confparm2}
\integer{confparm2=\confparm2= or NaN isin \confparm2?2}
\integer{confparm1=NaN isin \confparm1 or \confparm1=?1}

\integer{size=4}
\text{size2=50x25x1}
\text{lt=wims(values v,-v for v=2 to 15)}
\text{lt=shuffle(\lt)}
\integer{a=item(1,\lt)}
\integer{b=item(2,\lt)}
\integer{c=item(3,\lt)}
\integer{d=item(4,\lt)}
\text{x=random(x,y)}
\text{fab=\lt}

\text{lt=wims(values v for v=0 to \confparm1)}
\text{lt=shuffle(\lt)}
\text{p1=item(1,\lt)}
\text{p2=item(2,\lt)}
\text{lt=shuffle(\lt)}
\text{p3=item(1,\lt)}
\text{p4=item(2,\lt)}

\text{m1=simplify(\a*\x^\p1)}
\text{m2=simplify(\b*\x^\p2)}
\text{m3=simplify(\c*\x^\p3)}
\text{m4=simplify(\d*\x^\p4)}

\text{rep=wims(rawmath (\m1+\m2)*(\m3+\m4))}
\text{rep13=slib(commutesom \rep,\x)}
\text{A1=texmath(\m1)}
\text{A2=texmath(\m2)}
\text{A3=texmath(\m3)}
\text{A4=texmath(\m4)}
\text{A=\A1,\A2,\A3,\A4}
\text{enonce=\rep}

\text{coul=red,green,blue,purple}
\text{coul=shuffle(\coul)}
\text{t1=\special{color=\coul[1]}}
\text{t0=\special{color=black}}
\text{t2=\special{color=\coul[2]}}
\text{t3=\special{color=\coul[3]}}
\text{t4=\special{color=\coul[4]}}
\text{po=wims(char 1 of ())}
\text{pf=wims(char 2 of ())}

\text{tmps=wims(char 1 of \A[4])}
\text{tmps=\tmps=-?:+}
\text{tmps2=wims(char 1 of \A[2])}
\text{tmps2=\tmps2=-?:+}
\text{enonce1=(\t1 \A[1] \t2 \tmps2 \A[2])(\t3 \A[3] \t4 \tmps\A[4])}
\text{tmp=\A[1]*(\A[3]),\A[1]*(\A[4]),\A[2]*(\A[3]),\A[2]*(\A[4]),\A[1]*(\A[3])+(\A[1]*(\A[4]))+(\A[2]*(\A[3]))+(\A[2]*(\A[4]))}
\text{tmp=wims(replace internal \x by *\x in \tmp)}
\text{repco=}
\for{i=1 to 4}{
\text{tmp7=simplify(\tmp[\i])}
\text{repco=wims(append item \tmp7 to \repco)}}
\text{tmp7=maxima(\tmp[5];)}
\text{repco=\repco,\tmp7}

\text{ligne1=<td>\(\enonce1)</td>
<td>=</td>
<td>\(\t1\po \A[1] \pf\t0\times \t3\po \A[3] \pf) </td>
<td>+</td>
<td>\(\t1\po \A[1] \pf\t0 \times \t4\po \A[4] \pf) </td>
<td>+</td>
<td>\(\t2\po \A[2] \pf\t0 \times \t3\po \A[3] \pf) </td>
<td>+</td>
<td>\(\t2\po \A[2] \pf\t0 \times \t4\po \A[4] \pf) </td>}

\text{tmp1=- isin \repco[2]?(\repco[2]):\repco[2]}
\text{tmp2=- isin \repco[3]?(\repco[3]):\repco[3]}
\text{tmp3=- isin \repco[4]?(\repco[4]):\repco[4]}
\text{ligne2=<td></td>
<td>=</td>
<td> \(\repco[1])</td>
<td>+</td>
<td> \(\tmp1) </td>
<td>+</td>
<td> \(\tmp2) </td>
<td>+</td>
<td> \(\tmp3) </td>}

\if{\confparm2=1}{
\matrix{type=r1,r2,r3,r4,r5,r7,r8
r9,r10,r11,r12
r13}
}{
\matrix{type=r13}
}

\steps{\type}

\statement{
Développer et réduire l'expression \(\enonce).
<p><b>Je développe :</b></p>
\if{\confparm2=1}{
On vous propose de résoudre l'exercice en vous guidant.
<p>Complétez les différentes étapes de calcul qui vous sont proposées en respectant les couleurs
et en utilisant l'identité \((a+b)(c+d)=a c+a d+b c+b d) :</p>
\if{\step=1}{ <div class="wims_instruction">Utiliser les étiquettes pour compléter le calcul.</div>
<div class="wimscenter">
   \(\enonce1= \t1\po) \embed{r1,\size2} \(\t1\pf\t0\times \t3\po) \embed{r2,\size2}
   \(\t3\pf\t0 + \t1\po) \embed{r3,\size2} \(\t1\pf\t0 \times \t4\po )
   \embed{r4,\size2} \(\t4\pf\t0 + \t2\po) \embed{r5,\size2} \(\t2\pf\t0 \times \t3\po )
   \embed{r6,\size2} \(\t3\pf\t0 + \t2\po) \embed{r7,\size2} \(\t2\pf\t0 \times \t4\po )
   \embed{r8,\size2} \(\t4\pf)</div>
}{
<table class="wimscenter">
<tr>\ligne1</tr>
<tr>
\if{\step=2}{
<td></td>
<td>=</td>
<td> \embed{r9,4*\size}</td>
<td>+</td>
<td> \embed{r10,4*\size} </td>
<td>+</td>
<td> \embed{r11,4*\size} </td>
<td>+</td>
<td> \embed{r12,4*\size} </td>
</tr>
}{
\ligne2
</tr><tr>
<td>Donc je conclus : \(\enonce)</td>
<td>=</td>
<td colspan="7"> \embed{r13,8*\size} </td>
</tr>
}
</table>
}
}
{<div class="wimscenter">
\(\enonce = )\embed{r13,8*\size}.
</div>
}
}
\answer{Réponse 1}{\A[1];\A}{type=clickfill}
\answer{Réponse 2}{\A[3];\A}{type=clickfill}
\answer{Réponse 3}{\A[1];\A}{type=clickfill}
\answer{Réponse 4}{\A[4];\A}{type=clickfill}
\answer{Réponse 5}{\A[2];\A}{type=clickfill}
\answer{Réponse 6}{\A[3];\A}{type=clickfill}
\answer{Réponse 7}{\A[2];\A}{type=clickfill}
\answer{Réponse 8}{\A[4];\A}{type=clickfill}
\answer{Réponse 9}{\repco[1]}{type=litexp}
\answer{Réponse 10}{\repco[2]}{type=litexp}
\answer{Réponse 11}{\repco[3]}{type=litexp}
\answer{Réponse 12}{\repco[4]}{type=litexp}
\answer{\(\enonce)}{\rep13}{type=litexp}


\solution{
