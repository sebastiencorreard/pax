\title{Remplacer une lettre par une valeur}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni; Christophe, Caillet}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{100000}

\text{variable=randitem(x,y,a,b,c)}
\text{fonction=randitem(A,B,C,D,E,F)}
\real{valeur=randint(1..100)/10}
\integer{operation=randint(1..4)}
\text{expression=}
\real{c1=randint(1..100)/10}
\integer{c2=randint(2..19)}
\text{tconstante=wims(translate . to , in \c1)}
\real{resultat=0}
\if{\operation==1}{
 \integer{hasard=randint(0..1)}
 \text{expression=\hasard=1?\c2 \times \variable + \tconstante:\tconstante + \c2 \times \variable}
 \real{resultat=\c2 * \valeur+\c1}
}
\if{\operation==2}{
   \if{\valeur>\constante} {
    \text{expression=\c2 \times \variable - \tconstante}
    \real{resultat=\c2 * \valeur-\c1}}
    {
    \text{expression=\tconstante - \c2 \times \variable}
    \real{resultat=\c1 - \c2 * \valeur}}}

\if{\operation==3}{
     \integer{hasard=randint(0..1)}
     \text{expression=\hasard=1?\c2 \times (\variable + \tconstante):(\tconstante + \variable) \times \c2}
     \real{resultat=(\valeur+\c1)*\c2}
   }

\if{\operation==4}{
     \integer{hasard=randint(0..1)}
     \text{expression=\hasard=1?\c2 \times \variable + \c2 \times \tconstante :\c2 \times \tconstante + \variable \times \c2}
     \real{resultat=(\valeur+\c1)*\c2}
   }

\text{tvaleur=wims(translate . to , in \valeur)}
\text{tresultat=wims(translate . to , in \resultat)}
\statement{
On donne l'expression :
<div class="wimscenter larger">\(\fonction = \expression)</div>

Que vaut \fonction lorsque \variable vaut \tvaleur ?
<div class="wimscenter larger"> \embed{reply 1,6}</div>
}
\reply{}{\rep}
\text{rep=wims(translate , to . in \rep)}
\real{result=\rep}
\condition{Bonne Réponse}{\result=\resultat}
\solution {La réponse est \tresultat}
