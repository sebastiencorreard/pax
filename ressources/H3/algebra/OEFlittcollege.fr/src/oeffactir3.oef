\title{Factoriser a²-b²}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm1=\confparm1}
\integer{confparm1=NaN isin \confparm1 or \confparm1=?1}

\integer{size=6}
\text{size2=40x25x1}
\integer{a=random(2..15)}
\integer{b=random(2..15)}
\integer{b=\a=\b?17}
\text{x=random(x,y)}

\text{lt=wims(values v for v=0 to \confparm1)}
\text{lt=shuffle(\lt)}
\integer{p1=item(1,\lt)}
\integer{p2=item(2,\lt)}
\text{m1=simplify(\a*\x^\p1)}
\text{m2=simplify(\b*\x^\p2)}

\text{lsg=shuffle(+,-)}
\text{sg1=item(1,\lsg)}
\text{sg2=item(2,\lsg)}
\text{enonce=\rep}
\text{list=randrow(\don)}
\text{rep=wims(rawmath (\m1\sg1\m2)(\m1\sg2\m2))}
\text{rep3=slib(commutesom \rep,\x)}
\text{A1=texmath(\m1)}
\text{A2=texmath(\m2)}
\text{A=\A1,\A2}

\text{affl=randomitem(\rep3)}

\statement{
Factoriser l'expression : \(\affl).
<p><b>Je factorise :</b></p>

<div class="wimscenter">\(\affl = )\embed{r1,4*\size}.</div>}

\answer{Réponse}{\rep}{type=algexp}
