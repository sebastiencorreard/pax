\title{Calcul littéral et aires}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni; Odile Benassy}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{fignum=random(1..5)}

\if{\fignum=1}{
\integer{a1=random(30..80)}
\integer{a2=random(30..80)}
\if{\a2=\a1}{\integer{a2=\a2-3}}
\integer{h=random(30..80)}
\integer{r=random(1..99)}

\real{x1=-16*\a}
\real{x2=16*\a}
\real{y1=-16*\b}
\real{y2=16*\b}
\real{c=\c1/10}

\integer{b=sqrt(\h*\h + \a*\a*(1-\r/100)*(1-\r/100))}
\integer{c=sqrt(\h*\h + \a*\a*(\r/100)*(\r/100))}
\real{x1=\a1/10}
\real{x2=\a2/10}
\real{y=\b/10}
\real{z=\c/10}
\real{t=\h/10}
\real{u=\x1*\r/100}

\real{xval=\x1}
\function{expr=x*\t/2}
\real{yres=evalue(\expr,x=\xval)}
\real{xres=\x2}
\real{yval=evalue(\expr,x=\xres)}

\integer{scale=\x1*10}


\matrix{Xcoord=\u,\t}
\real{Xx=\scale*item(1,\Xcoord)}
\real{Xy=\scale*item(2,\Xcoord)}
\matrix{Ycoord=0,0}
\real{Yx=\scale*item(1,\Ycoord)}
\real{Yy=\scale*item(2,\Ycoord)}
\matrix{Zcoord=\x1,0}
\real{Zx=\scale*item(1,\Zcoord)}
\real{Zy=\scale*item(2,\Zcoord)}

\text{color1=black}
\text{range = \fignum=1 ? pari(1.2*[\Xx-50,\Xy+50,\Yx-60,\Yy+50,\Zx+70,\Zy+50,0,-50])}
\text{range = slib(draw/range \range)}
\text{xx=shuffle(x,\t)}
\text{yy = \xx[1]}
\text{xx = \xx[2]}
\text{dessin=draw(300,300
xrange \range[1,2]
yrange \range[3,4]
polygon \color1, \Xx,\Xy,\Yx,\Yy,\Zx,\Zy
fill \Xx,\Xy-50,skyblue
text black,\Xx,\Xy + 50,large,A
text black,\Yx-60,\Yy,large,B
text black,\Zx+30,\Zy-10,large,C
arrow (\Yx+\Zx)/2-35,-25, \Yx, -25, 8, \color1
arrow (\Yx+\Zx)/2+35,-25, \Zx, -25, 8, \color1
text black, (\Yx + \Zx)/2, -20, normal, \xx
arrow \Zx + 70,\Xy/2 - 35,\Zx + 70,0,8,\color1
arrow \Zx + 70,\Xy/2 + 35,\Zx + 70,\Xy,8,\color1
text black, \Zx + 50, \Xy/2, normal,\yy
dsegment \Xx,\Xy,\Zx + 70,\Xy, \color1
dsegment \Zx,0,\Zx + 70,0, \color1)
}
}
\if{\fignum=2}{
\integer{a1=random(11..48)}
\integer{b1=random(11..48)}
\integer{b2=random(11..48)}
\if{\b2=\b1}{\integer{b2=\b2+6}}
\integer{c1=random(3..\b1-1)}
\integer{d1=\b1+\c1}

\real{a=\a1/10}
\real{b=\b1/10}
\real{c=\c1/10}
\real{d=\d1/10}

\real{x1=-16*\a}
\real{x2=16*\a}
\real{y1=-16*\b}
\real{y2=16*\b}
\real{c=\c1/10}

\real{xval=\b}
\function{expr=\a*(x+\c)/2}
\real{yres=evalue(\expr,x=\xval)}
\real{xres=\b2/10}
\real{yval=evalue(\expr,x=\xres)}
\text{range = pari(1.2*[\x2-5,\y2-5,\x2+5,\y1+5,\x1+5,\y1-5,\x1-5,\y2+5])}
\text{range = slib(draw/range \range)}
\text{dessin=draw(350,350
xrange \range[1,2]
yrange \range[3,4]
polygon black, \x2,\y2,\x2,\y1,\x1,\y1
fill \x2-1,\y1+1,gold

segment \x2-5,\y1,\x2-5,\y1+5, black
segment \x2,\y1+5, \x2-5, \y1+5, black

text black,\x2 + 2, \y2 + 10,large,A
text black,\x2 + 2, \y1,large,C
text black,\x1 - 4,\y1,large,B
text black,-3,\y1 - 5,normal, \a

segment \x2 -2 , 10, \x2 + 2, 10, black
arrow \x2 + 4, (\y2+10)/2 + 5, \x2 + 4, \y2, 8, black
arrow \x2 + 4, (\y2+10)/2 - 5, \x2 + 4, 10, 8, black
arrow \x2 + 4, (\y1+10)/2 + 5, \x2 + 4, 10, 8, black
arrow \x2 + 4, (\y1+10)/2 - 5, \x2 + 4, \y1, 8, black
text black, \x2 + 4, (\y2+10)/2 + 3, normal, \c \unit
text black, \x2 + 4, (\y1+10)/2 + 3, normal, x
)
}

}
\if{\fignum=3}{
\integer{a1=random(11..48)}
\integer{b1=random(11..48)}
\integer{b2=random(11..48)}
\if{\b2=\b1}{\integer{b2=\b2+6}}
\real{a=\a1/10}
\real{b=\b1/10}


\real{xval=\b}
\function{expr=x*\a/2}
\real{yres=evalue(\expr,x=\xval)}
\real{xres=\b2/10}
\real{yval=evalue(\expr,x=\xres)}
\text{xx=shuffle(x,\a)}
\text{yy = \xx[1]}
\text{xx = \xx[2]}
\text{range =pari(1.2*[-16*\a-15,-15, 0,16*\b+20, 16*\a+15,0, 0,-16*\b-20, -16*\a,15])}
\text{range = slib(draw/range \range)}
\text{dessin = draw(350,350
xrange \range[1,2]
yrange \range[3,4]
polygon black,-16*\a,0, 0,16*\b, 16*\a,0, 0,-16*\b, -16*\a,0
fill 0,0,seashell

arrow -15,16*\b+15,-16*\a,16*\b+15,8,black
arrow 15,16*\b+15,16*\a,16*\b+15,8,black
dsegment -16*\a,0,-16*\a,16*\b+15, black
dsegment 16*\a,0,16*\a,16*\b+15, black

arrow 16*\a + 15,10,16*\a + 15,16*\b,8,black
arrow 16 * \a + 15,-10,16*\a + 15,-16*\b,8,black
dsegment 0,-16*\b,16*\a + 15,-16*\b, black
dsegment 0, 16*\b,16*\a + 15,16*\b, black

segment - 8*\a + 1, 8*\b - 3, -8*\a - 1, 8*\b + 3, red
segment 8*\a - 1, 8*\b - 3, 8*\a + 1, 8*\b + 3, red
segment 8*\a - 1, - 8*\b + 3, 8*\a + 1, - 8*\b - 3, red
segment - 8*\a + 1, - 8*\b + 3, -8*\a - 1, - 8*\b - 3, red

text black,-16*\a - 10, 5,large,A
text black,-2, 16*\b + 12,large,B
text black,16*\a + 2,0,large,C
text black,-2,-16*\b - 4,large,D
text black,-5,16*\b+20,normal,\xx
text black,16*\a + 13, 5,normal, \yy
)
}
}
\if{\fignum=4}{
\integer{b1=random(11..48)}
\integer{a1=random(6..28)}
\integer{a2=random(6..28)}
\if{\a2=\a1}{\integer{a2=\a2-3}}
\integer{c1=random(3..\b1-1)}
\real{a=\a1/10}
\real{b=\b1/10}
\real{c=\c1/10}

\real{xval=\a}
\function{expr=(2*x + \c)*\b}
\real{yres=evalue(\expr,x=\xval)}
\real{xres=\a2/10}
\real{yval=evalue(\expr,x=\xres)}
\text{range = pari(1.2*[-7,-8*\b-3,16*(2*\a+\c)+5,8*\b+8])}
\text{range = slib(draw/range \range)}
\text{dessin = draw(350,350
xrange \range[1,2]
yrange \range[3,4]
rectangle 0,-8*\b,16*(2*\a+\c),8*\b,black
fill 16*\a,0,lavender

segment 16*\a, 8*\b - 3, 16*\a, 8*\b + 3, black
segment 16*(2*\a), 8*\b - 3, 16*(2*\a), 8*\b + 3, black
segment 16*(\a/2)-1, 8*\b-2, 16*(\a/2)+1, 8*\b+2, red
segment 16*(3*\a/2)-1, 8*\b-2, 16*(3*\a/2)+1, 8*\b+2, red

arrow 16*(2*\a+\c) + 10,5,16*(2*\a+\c) + 10,8*\b,8,black
arrow 16*(2*\a+\c) + 10,-5,16*(2*\a+\c) + 10,-8*\b,8,black

text black,- 4, 8*\b,large,A
text black,16*(2*\a+\c), 8*\b + 2,large,B
text black,16*(2*\a+\c),-8*\b,large,C
text black,- 4,-8*\b,large,D

arrow 16*\a/2 - 2.5, 8*\b+5, 0, 8*\b+5, 8, black
arrow 16*\a/2 + 2.5, 8*\b+5, 16*\a, 8*\b+5, 8, black
text black,16*\a/2,8*\b+7,normal,x

arrow 16*(2*\a+\c/2) - 5, 8*\b+5, 16*(2*\a), 8*\b+5, 8, black
arrow min(16*(2*\a+\c),16*(2*\a+\c/2) + 6), 8*\b+5, 16*(2*\a+\c), 8*\b+5, 8, black
text black,16*(2*\a + \c/2)-2,8*\b+7,normal,\c
text black,16*(2*\a+\c) + 7, 2,normal, \b
)
}

}
\if{\fignum=5}{
\text{cnt=randint(2..5)}

\integer{a1=\cnt * randint(5..24)}
\integer{b1=random(11..48)}
\real{a=\a1/10}
\real{b=\b1/10}
\integer{a2=\cnt * randint(5..24)}
\if{\a2=\a1}{\integer{a2=\a2+6}}

\real{xval=\a/\cnt}
\function{expr=\cnt*x*\b}
\real{yres=evalue(\expr,x=\xval)}
\real{xres=\a2/50}
\real{yval=evalue(\expr,x=\xres)}
\text{range = pari(1.2*[-15,-16*\b -15,32*\a +15,16*\b+15])}
\text{range = slib(draw/range \range)}
\text{dessin1 = xrange \range[1],\range[2]
yrange \range[3],\range[4]
rectangle 0,-16*\b,32*\a,16*\b,black
fill 16*\a,0,lavender}
\for{i = 1 to \cnt-1 }{
\text{dessin1 = \dessin1
segment \i*32*\a/\cnt,16*\b-3,\i*32*\a/\cnt +,16*\b+3, black
segment (2*\i-1)*16*\a/\cnt - 1.5, 16*\b-2, (2*\i-1)*16*\a/\cnt + 1.5, 16*\b+2, red
}
}
\text{dessin1= \dessin1
segment (2*\cnt-1)*16*\a/\cnt - 1.5, 16*\b-2, (2*\cnt-1)*16*\a/\cnt + 1.5, 16*\b+2, red
}
\text{dessin = draw(350,350
\dessin1
arrow 16*\a/\cnt-5,16*\b+5,0,16*\b+5,8,black
arrow 16*\a/\cnt+5,16*\b+5,32*\a/\cnt,16*\b+5,8,black

arrow 32*\a + 10,10,32*\a + 10,16*\b,8,black
arrow 32*\a + 10,-10,32*\a + 10,-16*\b,8,black

text black,- 4, 16*\b + 10,large,A
text black,32*\a + 2, 16*\b + 10,large,B
text black,32*\a + 2,-16*\b,large,C
text black,- 4,-16*\b,large,D
text black,16*\a/\cnt-1,16*\b+10,normal,x
text black,32*\a + 8, 5,normal, \b
)
}
}

\real{essai=evalue(\expr,x=\xval)}

\steps{reply 1
reply 2
}

\statement{
<div class="float_right"><img src="\dessin" alt=""></div>

\if{\step<=1}{
<p>Déterminer la formule qui permettrait de calculer l'aire de la figure
si on connaissait la longueur \(x).</p>
<div>Ma formule pour l'aire de la figure : \embed{reply 1, 15}.</div>
}

\if{\step=2}{
<p>Ma formule pour l'aire de la figure : \( \expr). </p>
<p>Calculer l'aire de la figure pour la valeur \(x = \xval).</p>
<div><b>Réponse </b> : Pour la valeur \(x = \xval), l'aire de la figure vaut \embed{reply 2,5}.
</div>
}

}

\answer{Formule pour l'aire}{\expr}{type=function}
\answer{aire pour \(x = \xval)}{\yres}{type=numeric}
\hint{Pour calculer l'aire d'un triangle ou d'un losange,
il faut trouver le rectangle englobant, calculer son aire et ensuite diviser par 2.}
