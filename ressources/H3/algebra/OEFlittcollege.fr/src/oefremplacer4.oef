\title{Remplacer}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni;Fabrice,Guerimand}
\email{jluc.donadoni@gmail.com}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm1=\confparm1}
\integer{confparm2=\confparm2}
\integer{confparm2=\confparm2= or NaN isin \confparm2?2}
\integer{confparm1=NaN isin \confparm1 or \confparm1=?1}

\integer{confparm3=\confparm3=?1}
\text{champ=wims(record \confparm3 of src/generateur)}
\text{A=row(2,\champ)}
\text{c=item(3,\A)}
\text{a=item(1,\A)}
\text{b=item(2,\A)}
\text{valeurs=wims(values \c*v for v=\a to \b)}
\text{valeurs=wims(listuniq \valeurs)}
\text{valeurs=shuffle(\valeurs)}

\real{n=item(1,\valeurs)}

\integer{a=random(2..10)}
\text{Aa=\a=1?:\a}
\text{Aa=\a=-1?-:\a}
\integer{b=random(2..15)}
\text{Bb=\b=1?:\b}
\text{Bb=\b=-1?-:\b}
\integer{c=random(-1,1)*random(2..15)}
\integer{d=random(-1,1)*random(2..10)}
\integer{e=random(-1,1)*random(2..10)}

\integer{choix=random(1..3)}

\if{\choix=1=}{
   \text{tmp1=\c<0?(\Bb x \c):(\Bb x +\c)}
   \text{tmp2=\d<0?(\Aa x \d):(\Aa x +\d)}
   \text{enonce=\e \tmp1 \tmp2}
   \text{rep=maxima(expand(\e*(\a*x+(\d))*(\b*x+(\c)));)}
}{\if{\choix=2}{
\integer{f=random(2..10)}
   \text{tmp3=\e>0?+\e x: \e x}
   \text{tmp3=\f>0?\tmp3 +\f:\tmp3 \f}
   \integer{ch=random(1..3)}
   \if{\ch=1}{
   \text{tmp1=\c<0?(\Aa x \c):(\Aa x +\c)}
   \integer{d=-\c}
   \text{tmp2=\d<0?(\Aa x \d):(\Aa x +\d)}
   \text{enonce=\tmp1 \tmp2}
   \text{calc=(\a*x+(\d))*(\a*x+(\c))}}
   \if{\ch=2}{
   \text{enonce=\c<0?(\Aa x \c)^2:(\Aa x +\c)^2}
   \text{calc=(\a *x+(\c))^2}}
   \if{\ch=3}{
   \text{enonce=\c<0?(x \c)^2:(x +\c)^2}
   \text{calc=(x+(\c))^2}}
   \text{enonce=\enonce \tmp3}
   \text{rep=maxima(expand(\calc+(\e)*x+(\f));)}
}{
\text{tmp1=\c<0?(\Aa x \c):(\Aa x +\c)}
   \integer{g=-\c}
   \text{tmp2=\g<0?(\Aa x \g):(\Aa x +\g)}
   \text{enonce1=\tmp1 \tmp2}
   \text{calc1=(\a*x+(\g))*(\a*x-(\g))}
   \text{enonce2=\d<0?(\Bb x \d)^2:(\Bb x +\d)^2}
   \text{calc2=(\b *x+(\d))^2}
   \text{enonce3=\e<0?(x \e)^2:(x +\e)^2}
   \text{calc3=(x+(\e))^2}
   \text{tenon=\enonce1,\enonce2,\enonce3}
   \text{tcalc=\calc1,\calc2,\calc3}
   \text{ch=1,2,3}
   \text{ch=shuffle(\ch)}
   \text{en1=item(item(1,\ch),\tenon)}
   \text{en2=item(item(2,\ch),\tenon)}
   \text{ca1=item(item(1,\ch),\tcalc)}
   \text{ca2=item(item(2,\ch),\tcalc)}
   \text{enonce=\en1 + \en2}
   \text{rep=maxima(expand(\ca1+\ca2);)}
}}

\text{rep=slib(commutesom \rep,\x)}
\text{rp=items(\rep)}
\if{\rp=6}{\text{rp=item(6,\rep)}}{\text{rp=item(1,\rep)}}

\text{r=wims(replace internal x by (\n) in \rp)}
\real{r=\r}

\statement{
<p>Calculer l'expression E = \(\enonce) avec la valeur \x = \n.</p>
<div class="wimscenter">
Pour \x = \n , nous avons E =\embed{r1,10}.
</div>

<p>Calculer l'expression F = \(\rp) avec la valeur \x = \n.</p>
<div class="wimscenter">
Pour \x = \n , nous avons F =\embed{r2,10}.
</div>}


\answer{}{\r}{type=numeric}
\answer{}{\r}{type=numeric}
