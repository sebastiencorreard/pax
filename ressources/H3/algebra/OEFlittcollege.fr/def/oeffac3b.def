!set title=Factoriser a²+2ab+b²
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=+
val2=$[rint($val2)]

!ifval NaN isin $val2 or $val2=
val2=$[rint(1)]
!endif
val7=$[rint(8)]
val8=40x25x1
tmp0=!randitem 1,1

tmp1=!randint 2, 15

val9=$(tmp0)*$(tmp1)
tmp=!translate ";': to $     $ in $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp0=!randint 2, 15

val10=$(tmp0)
tmp0=!randitem x,y

val11=$(tmp0)
tmp0=!values v for v=0 to $val2

val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$[rint($(tmp0))]
tmp0=!item 2 of $val12

val14=$[rint($(tmp0))]
val15=$val9*$val11^$val13
tmp=!translate ";': to $     $ in $val15

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp0=!texmath $val15

val16=$(tmp0)
val17=$val10*$val11^$val14
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp0=!texmath $val17

val18=$(tmp0)
val19=($val15 $val6 $val17)^2
!readproc slib/commutesom $val19,$val11 
tmp0=$slib_out
val20=$(tmp0)
tmp0=!texmath $val15

val21=$(tmp0)
tmp0=!texmath $val17

val22=$(tmp0)
val23=$val21,$val22
val24=($(val23[1]) $val6 $(val23[2]))^2
tmp=!nonempty items $val20

tmp0=!randitem $tmp
tmp1=!texmath $(tmp0)

val25=$(tmp1)
replytype1=algexp
replyname1=
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Factoriser l'expression 
!insmath $val25
$().	<div class="spacer"><b>Je factorise</b> :</div>	<div class="wimscenter">	
!insmath $val25 = 
$() 
!read oef/embed.phtml r1,2*$val7 
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	<table border=0>	<tr>$m_ligne1</tr>	<tr>$m_ligne2</tr>	<tr>	   <td></td>	   <td>=</td>	   <td colspan=5> 
!insmath $val25
$()</td>	</tr>	</table>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

