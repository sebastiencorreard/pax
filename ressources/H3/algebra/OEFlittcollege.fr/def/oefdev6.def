val2=$[rint($val2)]
val3=$[rint($val3)]

!ifval $val3= or NaN isin $val3
val3=$[rint(2)]
!endif

!ifval NaN isin $val2 or $val2=
val2=$[rint(1)]
!endif
val6=$[rint(6)]
val7=40x25x1
tmp0=!randint 2, 15

val8=$[rint($(tmp0))]
tmp0=!randint 2, 15

val9=$[rint($(tmp0))]

!ifval $val8=$val9
val9=$[rint(17)]
!endif
tmp0=!randitem x,y

val10=$(tmp0)
tmp0=!values v for v=0 to $val2

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val13=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val8*$val10^$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
tmp=!translate ";': to $     $ in $val9*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp0=!shuffle +,-

val16=$(tmp0)
tmp0=!item 1 of $val16

val17=$(tmp0)
tmp0=!item 2 of $val16

val18=$(tmp0)
tmp=!translate internal $	$ to ; in \don

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
tmp0=!rawmath ($val14$val17$val15)($val14$val18$val15)

val20=$(tmp0)
!readproc slib/commutesom $val20,$val10 
tmp0=$slib_out
val21=$(tmp0)
tmp0=!texmath $val14

val22=$(tmp0)
tmp0=!texmath $val15

val23=$(tmp0)
val24=$val22,$val23
val25=$val20
val26=red,green,blue,purple
tmp0=!shuffle $val26

val26=$(tmp0)
val27=\special{color=$(val26[1])}
val28=\special{color=black}
val29=\special{color=$(val26[2])}
val30=\special{color=$(val26[3])}
val31=\special{color=$(val26[4])}
tmp0=!char 1 of ()

val32=$(tmp0)
tmp0=!char 2 of ()

val33=$(tmp0)
val34=($val27 $(val24[1]) $val28 + $val29 $(val24[2]) $val28)($val27 $(val24[1])$val28 - $val29 $(val24[2]) $val28 )
val35=<td>\($val34)</td>	<td>=</td>	<td>\($val27$val32 $(val24[1]) $val33$val28^2 - $val29$val32 $(val24[2]) $val33$val28^2) </td>
!if $val3=1 
tmp=!trim r1,r2	r3
val36=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim r3
val36=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!item 1 of $val21

val37=$(tmp0)
oefsteps=$val36 
nextstep=!nosubst $val36 
!readproc oef/steps.proc
replytype1=clickfill
replyname1=Réponse 1
