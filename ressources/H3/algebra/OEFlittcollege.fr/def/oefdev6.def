!insmath (a+b)(a-b)=a^2-b^2
$()	
!if $m_step=1 
$()<div class="wims_instruction">Utiliser les étiquettes pour compléter le calcul.</div>	<div class="wimscenter">	   
!insmath $val34 = $val27$val32
$()  
!read oef/embed.phtml r1,$val7 
$() 
!insmath $val27$val33$val28^2- $val29$val32
$()  
!read oef/embed.phtml r2,$val7 
$() 
!insmath $val29$val33$val28^2
$()	   </div>	 
