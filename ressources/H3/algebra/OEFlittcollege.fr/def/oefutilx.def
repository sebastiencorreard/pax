!set title=Utiliser la lettre x pour calculer
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni; Odile,Benassy
email=jluc.donadoni@gmail.com
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randitem 2,2.5,3,3.5,4,4.5,5,5.5,10,12,15,20,30,50,100,120

val7=$[$(tmp0)]
val8=2x+$val7,3x+$val7,5x,$val7-x,$val7+x,x/4
tmp0=!item $val6 of $val8

val9=$(tmp0)
val9=!rawmath $val9
tmp0=!randint 1, 20

val10=$[rint($(tmp0))]
!if $val6=4 
tmp0=!randitem 1,1.5,$val7*0.2,$val7*0.5,$val7*0.7,$val7*0.8

val10=$[$(tmp0)]
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
tmp0=!randint 1, 20

val12=$[rint($(tmp0))]
!if $val6=4 
tmp0=!randitem 1.5,$val7*0.2,$val7*0.5,$val7*0.7,$val7*0.8

val12=$[$(tmp0)]
!endif
!if $val12=$val10 
val12=$[rint($val10-1)]
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val13=$[$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
oefsteps=reply 1	reply 2 
nextstep=!nosubst reply 1	reply 2 
!readproc oef/steps.proc
replytype1=function
replyname1=\(AC)
replygood1=!rawmath $val9
replytype2=numeric
replyname2=\(AC) pour \(x) = $val10
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

