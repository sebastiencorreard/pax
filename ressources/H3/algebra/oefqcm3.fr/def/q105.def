val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 11, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val8<0
val11=($val8)
!else
val11=$val8
!endif

!ifval $val9<0
val12=($val9)
!else
val12=$val9
!endif

!ifval $val10<0
val13=($val10)
!else
val13=$val10
!endif
val14=\($val8 x=$val10\)
val15=\(x+$val9=$val10\)
val16=\($val8 x+$val9=$val10\)
tmp=!nonempty items eq1,eq2,eq3,eq3,eq3

tmp0=!randitem $tmp
val17=$(tmp0)
!if $val17 issametext eq1 
val18=Pour résoudre l’équation $val14&#44; on effectue le calcul&nbsp;&#58;
val19=
val20=\(x=$val10+$val8\)
val21=\(x=$val10-$val8\)
val22=\(x=-$val10+$val8\)
val23=\(x=$val8-$val10\)
val24=\(x=$val8+$val10\)
val25=\(x=-$val8+$val10\)
val26=\(x=$val8/$val10\)
val27=\(x=-$val8/$val10\)
val28=\(x=$val8/-$val10\)
val29=\(x=$val10/$val8\)
val30=La bonne réponse est&nbsp;&#58 <span style="nowrap">$val29.</span><ul class="wims_nopuce"><li> \($val8 x=$val10\) </li><li> \(\frac{$val8 x}{$val8}=\frac{$val10}{$val8}) </li><li> $val29</li></ul>
!endif
!if $val17 issametext eq2 
val18=Pour résoudre l’équation $val15&#44; on effectue le calcul&nbsp;&#58;
val19=
val20=\(x=$val10/$val9)
val21=\(x=-$val10/$val9)
val22=\(x=$val10/-$val9)
val23=\(x=$val9+$val10\)
val24=\(x=$val9-$val10\)
val25=\(x=-$val9+$val10\)
val26=\(x=$val9/$val10\)
val27=\(x=-$val9/$val10\)
val28=\(x=$val9/-$val10\)
val29=\(x=$val10-$val9)
val30=La bonne réponse est&nbsp;&#58 <span style="nowrap">$val29.</span><ul class="wims_nopuce"><li> \(x+$val9=$val10\) </li><li> \(x+$val9-$val9=$val10-$val9) </li><li> \(x=$val10-$val9)</li></ul>
!endif
!if $val17 issametext eq3 
val18=Pour résoudre l’équation $val16&#44; on effectue le calcul&nbsp;&#58;
val19=
val20=\(x=($val10/$val8)+$val9\)
val21=\(x=($val10/$val8)-$val9\)
val22=\(x=($val10/-$val8)-$val9\)
val23=\(x=($val10-$val8)+$val9\)
val24=\(x=($val10+$val8)+$val9\)
val25=\(x=($val10-$val8)-$val9\)
val31=$[rint(-$val10)]
val26=\(x=($val10\times$val11)+$val9\)
val27=\(x=($val10\times$val11)-$val9\)
val28=\(x=($val31\times$val11)+$val9\)
val32=$[rint(-$val9)]

!ifval $val32<0
val32=$val32
!else
val32=+$val32
!endif
val29=\(x=\frac{$val10 $val32}{$val8}\)
val30=La bonne réponse est&nbsp;&#58 <span style="nowrap">$val29.</span> <ul class="wims_nopuce"><li> \($val8 x+$val9=$val10\) </li><li> \($val8 x+$val9 $val32=$val10 $val32\) </li><li> \($val8 x=$val10 $val32\) </li><li> \(\frac{$val8 x}{$val8}=\frac{$val10 $val32}{$val8}\) </li><li> $val29</li></ul>
!endif
tmp=!nonempty items $val20,$val21,$val22

tmp0=!randitem $tmp
tmp=!nonempty items $val23,$val24,$val25

tmp1=!randitem $tmp
tmp=!nonempty items $val26,$val27,$val28

tmp2=!randitem $tmp
val33=$(tmp0),$(tmp1),$(tmp2)
val34=\latexversion	    \item	    $val18	    \begin{radio}	    \item \ttrep[1]	    \item \ttrep[2]	    \item \ttrep[3]	    \item \ttrep[4]	    \end{radio}
val34=$val34 \end{enumerate}
val35=$val29,$val33
tmp0=!shuffle 4

val36=$(tmp0)
val35=$(val35[$(val36[1])]),$(val35[$(val36[2])]),$(val35[$(val36[3])]),$(val35[$(val36[4])])
tmp0=!positionof item 1 in $val36

val37=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val37;Réponse A, Réponse B, Réponse C, Réponse D
question=__EXECUTED_1692754_EXERCISE__
