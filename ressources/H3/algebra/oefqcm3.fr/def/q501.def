!set title=Question 501 Programme de calcul (Scratch)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sébastien, Corréard
email=sebastien.correard@ac-aix-marseille.fr
keywords=quizz,algorithmics,calculation
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-b-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 
language=fr

ansorder=r
varcnt=45
prevarcnt=44
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 1, 5

val8=$(tmp0)
tmp0=!randint 0, 10

val9=$[rint($(tmp0))]
val10=$val1/../pgm_calcul_$val8.svg
!if $val8 = 1 
val11=$[rint(8*$val9)]
val12=$[rint(8*$val9+2)]
val13=$[rint(4*$val9+1)]
val14=Le résultat vaut $val13&nbsp;&#58<br>
val14=$val14 8 × <strong>$val9</strong> = $val11<br>
val14=$val14 $val11 + 2 = $val12<br>
val14=$val14 $val12 ÷ 2 = $val13
!endif
!if $val8 = 2 
val11=$[rint(4*$val9)]
val12=$[rint(4*$val9+8)]
val13=$[rint(2*$val9+4)]
val14=Le résultat vaut $val13&nbsp;&#58<br>
val14=$val14 4 × <strong>$val9</strong> = $val11<br>
val14=$val14 $val11 + 8 = $val12<br>
val14=$val14 $val12 ÷ 2 = $val13
!endif
!if $val8 = 3 
val11=$[rint(9*$val9)]
val12=$[rint(9*$val9+6)]
val13=$[rint(3*$val9+2)]
val14=Le résultat vaut $val13&nbsp;&#58<br>
val14=$val14 9 × <strong>$val9</strong> = $val11<br>
val14=$val14 $val11 + 6 = $val12<br>
val14=$val14 $val12 ÷ 3 = $val13
!endif
!if $val8 = 4 
val11=$[rint(20*$val9)]
val12=$[rint(20*$val9+15)]
val13=$[rint(4*$val9+3)]
val14=Le résultat vaut $val13&nbsp;&#58<br>
val14=$val14 20 × <strong>$val9</strong> = $val11<br>
val14=$val14 $val11 + 15 = $val12<br>
val14=$val14 $val12 ÷ 5 = $val13
!endif
!if $val8 = 5 
val11=$[rint(8*$val9)]
val12=$[rint(8*$val9+12)]
val13=$[rint(2*$val9+3)]
val14=Le résultat vaut $val13&nbsp;&#58;<br>
val14=$val14 8 × <strong>$val9</strong> = $val11<br>
val14=$val14 $val11 + 12 = $val12<br>
val14=$val14 $val12 ÷ 4 = $val13
!endif
val15=$val13
val16=numeric
val17=<p>On considère l'algorithme suivant&nbsp;&#58;</p>	<div class="wimscenter"><img style="height:40%;width:40%;" src="$val1/../pgm_calcul_$val8.svg" alt=""></div>	<p>Quel résultat obtient-on si on choisit $val9 comme nombre de départ&nbsp;&#63;<p>
val18=
replytype1=$val16

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val17	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val18	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
