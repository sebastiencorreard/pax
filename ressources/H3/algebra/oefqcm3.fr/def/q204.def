!set title=Question 204 Théorème de Thalès (num.)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=quizz,thales
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-a-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,2,3,3,4

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 2,5,2,3

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint($val9*$val8)]
tmp=!nonempty items 7,13,9,7

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$val10,$val8,$val11
!readproc oef/canvasdraw.phtml 300,300 \
range -10,100,-10,40	segment 0,0,80,0,black	segment 0,0,64,26,black	segment 25,10,30,0,black	segment 64,26,80,0,black	text black,30,-3,medium,B	text black,24,13,medium,C	text black,-5,2,medium,A	text black,64,28,medium,D	text black,85,0,medium,E	text black,5,7,medium,$(val12[1]) cm	text black,30,6,medium,$(val12[2]) cm	text black,80,14,medium,$(val12[3]) cm	 
tmp0=$canvasdraw_out
val13=$(tmp0)
val14=$[rint(5)]
val15=Sur la figure ci-contre&#44; dans le triangle \(ADE\) les droites \((DE)\) et \((CB)\) sont parallèles.	$val13	Déterminer la longueur <span style="white-space:nowrap;">\(AD).</span>
val16=cm
val17=$[rint($(val12[1])*$(val12[3])/$(val12[2]))]
val18=numeric
tmp=!nonempty items \(AD =$(val12[1]) \times $(val12[3])\div $(val12[2])\),\(AD =\frac{$(val12[1]) \times $(val12[3])}{$(val12[2])}\)

tmp0=!randitem $tmp
val19=$(tmp0)
val20=La bonne réponse est <b>$val17 cm</b>.<ul class="wims_nopuce"><li>Par le théorème de Thalès on a \(\frac{AC}{AD}=\frac{BC}{DE}\)</li>	<li>C'est à dire \(\frac{$(val12[1])}{AD}=\frac{$(val12[2])}{$(val12[3])}\)</li>	<li>Ainsi $val19 \({}=$val9 \times $(val12[3])\)</li>	<li>\(AD=$val17\) cm
replytype1=$val18

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val15	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val16	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,15,16,20
embedcnt=1
