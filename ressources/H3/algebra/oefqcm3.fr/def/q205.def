!set title=Question 205 Calculer le périmètre d'un losange
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sévan,Polteau
email=sevan.polteau@ac-aix-marseille.fr
keywords=quizz,perimeter
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-a-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 

ansorder=r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 3, 8

val8=$[rint($(tmp0))]
val9=$[rint(0)]
val10=$[rint(0)]
val11=$[rint($val8)]
val12=$[rint(0)]
tmp0=!randint 2, $val8

val13=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val14=$[$(tmp0)*sqrt($val8*$val8-$val13*$val13)]
val15=$[$val11+$val14]
val16=$[rint($val13)]
val17=$[min(min(min($val9,$val11),$val15),$val14)-1.5]
val18=$[max(max(max($val9,$val11),$val15),$val14)+0.8]
val19=$[min(min(min($val10,$val12),$val16),$val13)-1.6]
val20=$[max(max(max($val10,$val12),$val16),$val13)+0.8]
!if $val8<4 or $val13<3 
tmp0=!randint 40, 50

val21=$[rint($(tmp0))]
!endif
!if $val8>=4 and $val8<=6 
tmp0=!randint 30, 40

val21=$[rint($(tmp0))]
!endif
!if $val8>=7 
tmp0=!randint 25, 35

val21=$[rint($(tmp0))]
!endif
val22=$[rint(($val18-$val17)*$val21)]
val23=$[rint(($val20-$val19)*$val21)]
val24=
!for val25 =ceil($val17) to floor($val18) 
val24=$val24	    segment $val25,$val19,$val25,$val20,grey	  
!next
!for val25 =ceil($val19) to floor($val20) 
val24=$val24	    segment $val17,$val25,$val18,$val25,grey	  
!next
!readproc oef/draw.phtml $val22,$val23 \
  xrange $val17,$val18	  yrange $val19,$val20	  $val24	  segment -1,-1,0,-1,red	  segment -1,-1.2,-1,-0.8,red	  segment 0,-1.2,0,-0.8,red	  text red, -0.9,-0.4,medium,1 cm	  linewidth 2	  polygon blue, $val9,$val10,$val11,$val12,$val15,$val16,$val14,$val13	 
tmp0=$ins_url
val26=$(tmp0)
!readproc oef/draw.phtml $val22,$val23 \
  xrange $val17,$val18	  yrange $val19,$val20	  $val24	  segment -1,-1,0,-1,red	  segment -1,-1.2,-1,-0.8,red	  segment 0,-1.2,0,-0.8,red	  text red, -0.9,-0.4,medium,1 cm	  linewidth 2	  polygon blue, $val9,$val10,$val11,$val12,$val15,$val16,$val14,$val13	  dsegment $val9,$val10,$val11,$val12,red	  text red, $val11/2-0.5, -0.1,giant,$val8 cm	 
tmp0=$ins_url
val27=$(tmp0)
val28=Quel est le périmètre de ce losange&nbsp;&#63;	<br><img src="$val26" alt="">	
val29=$[rint($val8*4)]
val30=cm
val31=formal
val32=Comme tous les losanges&#44; il a ses 4 côtés qui sont de la même mesure.	<br>On trouve la mesure de ses côtés grace aux carreaux &#58; <span style="color:red">$val8 cm</span>.	<br><img src="$val27" alt="">	<br>On calcule le périmètre &#58; $val8 cm &#215; 4 = $val29 cm	<br>	<br><u>Ce losange a un périmètre de <b>$val29 centimètres</b></u>.	
replytype1=$val31

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val29
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val28	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val30	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val32!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val32</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,28,30,32
embedcnt=1
