!set title=Question 101 Conversion minutes en heures
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sébastien, Corréard
email=sebastien.correard@ac-aix-marseille.fr
keywords=quizz,calculation,division
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro du DNB publié sur éduscol en décembre 2025 : sujet-zero-dnb-serie-generale-a-mathematiques 

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
val9=$[rint($val8*60)]
val10=Un film dure $val9 min. Quelle est sa durée en heures&nbsp;&#63;
val11=
val12=$val8
val13=numeric
tmp=!nonempty items Il faut diviser le nombre de minutes par 60 pour obtenir le nombre d'heures.,Rappel&nbsp;&#58; \(60\) minutes font une heure.

tmp0=!randitem $tmp
val14=$(tmp0)
val15=La bonne réponse est \($val8\).<br>$val14
val16=\latexversion	    \item	    $val10	    \newline Réponse : \hspace{4em} $val11	    
val16=$val16 \end{enumerate}
replytype1=$val13

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val16 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val10	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val11	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val16 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val15!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val15</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,11,15,16
embedcnt=1
