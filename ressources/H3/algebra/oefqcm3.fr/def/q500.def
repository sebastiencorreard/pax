!set title=Question 500&#8718; Programme de calcul (Scratch)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sébastien, Corréard
email=sebastien.correard@ac-aix-marseille.fr
keywords=quizz,algorithmics,calculation
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-b-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 
language=fr

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 5

val8=$(tmp0)
tmp0=!randint 3, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
val11=$[rint($(val8[$val10]))]
val12=$val1/../pgm_calcul_$(val8[1]).svg
val13=$val1/../pgm_calcul_$(val8[2]).svg
val14=$val1/../pgm_calcul_$(val8[3]).svg
val15=$val1/../pgm_calcul_$(val8[4]).svg
val16=$[rint(4*$val9+1)]
val17=$[rint(2*$val9+4)]
val18=$[rint(3*$val9+2)]
val19=$[rint(4*$val9+3)]
val20=$[rint(2*$val9+3)]
val21=$val16,$val17,$val18,$val19,$val20
val22=$val1/../pgm_calcul_$val11.svg
val23=<img src="$val22" alt="">
val24=La bonne réponse est&nbsp;&#58; <div class="wimscenter">$val23 </div>Le résultat $(val21[$val11]) est obtenu en faisant le calcul suivant&nbsp;&#58; 
!if $val11 = 1 
val24=$val24 &#40; &#40;8 × <strong>$val9</strong>&#41; + 2&#41; ÷ 2
!endif
!if $val11 = 2 
val24=$val24 &#40; &#40;4 × <strong>$val9</strong>&#41; + 8&#41; ÷ 2
!endif
!if $val11 = 3 
val24=$val24 &#40; &#40;9 × <strong>$val9</strong>&#41; + 6&#41; ÷ 3
!endif
!if $val11 = 4 
val24=$val24 &#40; &#40;20 × <strong>$val9</strong>&#41; + 15&#41; ÷ 5
!endif
!if $val11 = 5 
val24=$val24 &#40; &#40;8 × <strong>$val9</strong>&#41; + 12&#41; ÷ 4
!endif
val25=
!for val26  = 1 to 4 
!if $val26 != $val11 
!if $val25 =  
val25=<img src="$val1/../pgm_calcul_$val26.svg" alt="">
!else
val25=$val25,<img src="$val1/../pgm_calcul_$val26.svg" alt="">
!endif
!endif
!next
val27=Voici un programme Scratch.	<br>Si le nombre de départ vaut $val9&#44; quel programme va donner $(val21[$val11])&nbsp;&#63;<br>
val28=
val29=$val23,$val25
tmp0=!shuffle 4

val30=$(tmp0)
val29=$(val29[$(val30[1])]),$(val29[$(val30[2])]),$(val29[$(val30[3])]),$(val29[$(val30[4])])
tmp0=!positionof item 1 in $val30

val31=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val31;Réponse A, Réponse B, Réponse C, Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val27	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder">	<tr><th> A. </th><th>B. </th></tr>	<tr><td>$(val29[1]) </td><td>$(val29[2]) </td></tr>	<tr><td> C.</td><td> D.</td></tr>	<tr><td>$(val29[3]) </td><td>$(val29[4]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val24!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val24</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,24,27,29
embedcnt=1
