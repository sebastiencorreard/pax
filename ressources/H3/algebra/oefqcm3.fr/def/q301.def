val8=$(tmp0)
val9=$[rint(0)]
!while $val9==0 
tmp0=!randint 5, 15

val10=$[rint($(tmp0))]
tmp0=!randint 5, 15

val11=$[rint($(tmp0))]
tmp0=!randint 5, 15

val12=$[rint($(tmp0))]
tmp0=!randint 5, 15

val13=$[rint($(tmp0))]
tmp0=!randint 5, 15

val14=$[rint($(tmp0))]
tmp0=!randint 5, 15

val15=$[rint($(tmp0))]
!if $val8 issametext trois 
val13=$[rint(3*$val10-$val12-$val11)]
!if ($val13<=20) and ($val13>=0) 
val9=$[rint(1)]
!endif
val16=Voici une série de $val8 notes&nbsp;&#58; $val11 ; $val12 ; $val13.<br>Quelle est la moyenne de cette série&nbsp;&#63;
val17=
val18=La moyenne est la somme des notes divisée par le nombre de notes &nbsp;&#58; \(($val11+$val12+$val13) \div 3 = $val10).
!endif
!if $val8 issametext quatre 
val14=$[rint(4*$val10-$val13-$val12-$val11)]
!if ($val14<=20) and ($val14>=0) 
val9=$[rint(1)]
!endif
val16=Voici une série de $val8 notes&nbsp;&#58; $val11 ; $val12 ; $val13 ; $val14.<br>Quelle est la moyenne de cette série&nbsp;&#63;
val17=
val18=La moyenne est la somme des notes divisée par le nombre de notes &nbsp;&#58; \(($val11+$val12+$val13+$val14) \div 4 = $val10).
!endif
!if $val8 issametext cinq 
val15=$[rint(5*$val10-$val14-$val13-$val12-$val11)]
!if ($val15<=20) and ($val15>=0) 
val9=$[rint(1)]
!endif
val16=Voici une série de $val8 notes&nbsp;&#58; $val11 ; $val12 ; $val13 ; $val14 ; $val15.<br>Quelle est la moyenne de cette série&nbsp;&#63;
val17=
val18=La moyenne est la somme des notes divisée par le nombre de notes &nbsp;&#58; \(($val11+$val12+$val13+$val14+$val15) \div 5 = $val10).
!endif
!endwhile
tmp=!nonempty items -2,2

tmp0=!randitem $tmp
val19=$[rint($val10+$(tmp0))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val20=$[rint($val10+$(tmp0))]
tmp0=!randitem -1/2,1/2

