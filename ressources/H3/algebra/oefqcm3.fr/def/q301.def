val25=$val25 \end{enumerate}
val26=$val22,$val23
tmp0=!shuffle 4

val27=$(tmp0)
val26=$(val26[$(val27[1])]),$(val26[$(val27[2])]),$(val26[$(val27[3])]),$(val26[$(val27[4])])
tmp0=!positionof item 1 in $val27

val28=$[rint($(tmp0))]
