!endif
!if $val18=1 
!if $val8=1.5 
val24=$val24	  <br>Et comme &nbsp;&nbsp; <span style="color:blue"><b>$val9 km + $val15 km = $val17 km</b></span>	    <br>On calcule &nbsp; <span style="color:green"><b>60 min + 30 min = $val16 min </b></span>	  
!else
val24=$val24	  <br>Et comme &nbsp;&nbsp; <span style="color:blue"><b>$val9 km <span style="color:red">$val13</span> = $val17 km</b></span>	    <br>On calcule &nbsp; <span style="color:green"><b>60 min <span style="color:red">$val13</span> = $val16 min </b></span>	  
!endif
val24=$val24	    <br>	    <br><u>Pour parcourir $val17 km&#44; la voiture va mettre <b>$val16 minutes</b></u>.	  
!endif
!if $val18=2 
!if $val8=1.5 
val24=$val24	  <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>60 min + 30 min = $val16 min </b></span>	    <br>On calcule &nbsp; <span style="color:blue"><b>$val9 km + $val15 km = $val17 km</b></span>	  
!else
val24=$val24	  <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>60 min <span style="color:red">$val13</span> = $val16 min </b></span>	    <br>On calcule &nbsp; <span style="color:blue"><b>$val9 km <span style="color:red">$val13</span> = $val17 km</b></span>	  
