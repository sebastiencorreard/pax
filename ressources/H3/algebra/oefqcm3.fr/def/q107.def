!else
val24=$val24	      <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>$val16 min <span style="color:red">$val14</span> = 60 min</b></span>	      <br>On calcule &nbsp; <span style="color:blue"><b>$val17 km <span style="color:red">$val14</span> = $val9 km</b></span>	    
!endif
val24=$val24	      <br>	      <br><u>La voiture a une vitesse de <b>$val9 km/h</b></u>.	    
