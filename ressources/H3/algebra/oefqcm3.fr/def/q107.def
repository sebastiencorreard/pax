val20=
val21=$val9 km/h
val10=$[rint($val9*$val10)]
val11=$[rint($val9*$val11)]
val12=$[rint($val9*$val12)]
val22=km/h
!endif
val23=$val10 $val22,$val11 $val22,$val12 $val22
