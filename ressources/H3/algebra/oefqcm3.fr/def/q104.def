!set title=Question 104 Calcul d’un pourcentage d’une quantité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=quizz,percentage
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-b-mathematiques.pdf du DNB publié sur éduscol en décembre 2025

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items lunettes,lentilles,appareils dentaires, boucles d'oreilles

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!randint 5, 50

val9=$[rint(20*$(tmp0))]
tmp=!nonempty items 5,10,25,50,75

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
val11=$[$val10/100]
!if $val10==5 
val12=<u>Astuce &nbsp;&#58;</u> calculer \($val10&#37;) d'une quantité revient à la diviser par \(20). <br>En effet \($val11) = \($val10/100) = \(1/20)
!endif
!if $val10==10 
val12=<u>Astuce &nbsp;&#58;</u> calculer \($val10&#37;) d'une quantité revient à la diviser par \(10). <br>En effet \($val11;) = \($val10/100) = \(1/10)
!endif
!if $val10==25 
val12=<u>Astuce &nbsp;&#58;</u> calculer \($val10&#37;) d'une quantité revient à la diviser par \(4). <br>En effet \($val11) = \($val10/100) = \(1/4)
!endif
!if $val10==50 
val12=<u>Astuce &nbsp;&#58;</u> calculer \($val10&#37;) d'une quantité revient à la diviser par \(2). <br>En effet \($val11) = \($val10/100) = \(1/2)
!endif
!if $val10==75 
val12=<u>Astuce &nbsp;&#58;</u> calculer \($val10&#37;) d'une quantité revient à la diviser par \(4) puis multiplier par \(3). <br>En effet \($val11) = \($val10/100) = \(3/4)
!endif
val13=Dans un collège de \($val9) élèves&#44; \($val10 &#37;) des élèves portent des $val8.<br> Combien d'élèves portent des $val8&nbsp;&#63;
val14=
val15=$[rint($val9*$val10/100)]
val16=numeric
val17=Calculer $val10 &#37; de $val9 revient à effectuer : \($val11\times$val9=$val15)<br>$val12
val18=\latexversion	    \item	    $val13	    \newline Réponse : \hspace{4em} $val14	    
val18=$val18 \end{enumerate}
replytype1=$val16

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

