!set title=Question 201 Mesure d'un angle particulier
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=quizz,angles
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-b-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items d,p,n

tmp0=!randitem $tmp
val8=$(tmp0)

!ifval $val8 issametext d
val9= droit
!endif

!ifval $val8 issametext p
val9= plat
!endif

!ifval $val8 issametext n
val9= nul
!endif
val10=Quelle est la mesure&#44; en degrés&#44; d'un angle $val9 ?
val11=degrés.
!if $val8 issametext d 
val12=90
!endif
!if $val8 issametext p 
val12=180
!endif
!if $val8 issametext n 
val12=0
!endif
val13=numeric
val14=La mesure d'un angle $val9 vaut $val12 °
val15=\latexversion	    \item	    $val10	    \newline Réponse : \hspace{4em} $val11	    
val15=$val15 \end{enumerate}
replytype1=$val13

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val15 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val10	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val11	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val15 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val14!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val14</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,11,14,15
embedcnt=1
