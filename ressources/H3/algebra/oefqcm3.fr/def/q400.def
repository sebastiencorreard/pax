!set title=Question 400 Lecture graphique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud
email=communaute.mutuwims@laposte.net
keywords=graphing,quizz,functions
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
computeanswer=no
precision=10000000
oefobservation=Question du sujet zéro sujet-zero-dnb-serie-generale-b-mathematiques.pdf du DNB publié sur éduscol en décembre 2025

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,4,6,8

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 2,4

tmp0=!randitem $tmp
val9=$[rint($val8+$(tmp0))]
tmp=!nonempty items 2,4

tmp0=!randitem $tmp
val10=$[rint($val9+$(tmp0))]
tmp=!nonempty items 5,10,15

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp0=!shuffle 2.5,7.5,12.5

val12=$(tmp0)
val13=$[$val11+$(val12[1])]
val14=$[$val13+$(val12[2])]
!readproc oef/canvasdraw.phtml 300,200 \
xrange -5,23	yrange -10,40	parallel 0,0,18,0,0,5,8,grey	parallel 0,0,0,35,2,0,10,grey	fontfamily 15px Arial	stringup black,-2,5,270,Température (en °C)	stringup black,3,-7,0,Horaire (en heures)	fontfamily 10px Arial	string black,-1,-1,0	string black,-1,4,5	string black,-1.5,9,10	string black,-1.5,14,15	string black,-1.5,19,20	string black,-1.5,24,25	string black,-1.5,29,30	string black,-1.5,34,35	string black,-0.3,-3,0	string black,1.7,-3,2	string black,3.7,-3,4	string black,5.7,-3,6	string black,7.7,-3,8	string black,9.6,-3,10	string black,11.6,-3,12	string black,13.6,-3,14	string black,15.6,-3,16	string black,17.6,-3,18	fcircle $val8,$val11,8,grey	fcircle $val9,$val13,8,grey	fcircle $val10,$val14,8,grey	polyline blue,$val8,$val11,$val9,$val13,$val10,$val14	 
tmp0=$canvasdraw_out
val15=$(tmp0)
val16=Le graphique ci-dessous donne l’évolution de la température (en degrés Celsius) en fonction de l’horaire (en heures).	<div class="wimscenter">$val15</div>Entre $val8 h et $val10 h&#44; de combien de degrés la température a-t-elle augmenté&nbsp;&#63;
val17=°C
val18=$[rint($val14-$val11)]
tmp=!nonempty items $val11+$val18=$val14,$val14-$val11=$val18

tmp0=!randitem $tmp
val19=$(tmp0)
val20=La bonne réponse est $val18. <br>En effet &nbsp;&#58; <ul class="wims_nopuce"><li>A $val8 h elle était de $val11 °C</li><li>A $val10 h elle était de $val14 °C</li><li>$val11+$val18=$val14</li></ul>
replytype1=\typerep

replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val16	 <br><label for="reply1"> Réponse&nbsp;&#58;</label>  
!read oef/embed.phtml r1,10	 autofocus 
$()	  $val17	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val20</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,17,20
embedcnt=1
