\title{Question 107 Calculer avec une vitesse}
\keywords{quizz,proportionality}
\observation{Question du sujet zéro sujet-zero-dnb-serie-generale-a-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 }
% Durée étudiée, rapport par rapport à une heure
\text{rapport=1/4,1/3,1/2,1.5,2}
\text{rapport=randitem(\rapport)}
% Tirage vitesse
\integer{vitesse=randint(30,40,45,50,60,70,75,80,90,100,110,120,130)}
\if{\rapport=1/4}{
  \integer{vitesse=randint(40,60,80,100,120)}
  \text{bad1=1/2}
  \text{bad2=1.5}
  \text{bad3=3/4}
  \text{calcul=&#58; 4}
  \text{calcul_inverse=&#215; 4}
}
\if{\rapport=1/3}{
  \integer{vitesse=randint(30,45,60,75,90,120)}
  \text{bad1=2/3}
  \text{bad2=1.5}
  \text{bad3=1/2}
  \text{calcul=&#58; 3}
  \text{calcul_inverse=&#215; 3}
}
\if{\rapport=1/2}{
  \integer{vitesse=randint(30,40,50,60,70,80,90,100,110,120,130)}
  \text{bad1=1/4}
  \text{bad2=1.5}
  \text{bad3=3/4}
  \text{calcul=&#58; 2}
  \text{calcul_inverse=&#215; 2}
}
\if{\rapport=1.5}{
  \integer{vitesse=randint(30,40,50,60,70,80,90,100,110,120,130)}
  \integer{vitesse_moitie=\vitesse/2}
  \text{bad1=1/2}
  \text{bad2=2}
  \text{bad3=3/4}
  \text{calcul=&#215; 1.5}
  \text{calcul_inverse=&#58; 1.5}
}
\if{\rapport=2}{
  \integer{vitesse=randint(30,40,45,50,60,70,75,80,90,100,110,120,130)}
  \text{bad1=1/2}
  \text{bad2=1.5}
  \text{bad3=3/4}
  \text{calcul=&#215; 2}
  \text{calcul_inverse=&#58; 2}
}
% Calcul durée
\integer{duree=60*\rapport}
% Calcul distance
\integer{distance=\rapport*\vitesse}
% Choix question
\integer{question=randint(3)}
% Question 1, on demande la durée
\if{\question=1}{
  \text{enonce=Une voiture roule à \vitesse km/h. Combien de temps met-elle pour parcourir \distance km &#63;}
  \text{enonceb=}
  \text{good=\duree min}
  \integer{bad1=60*\bad1}
  \integer{bad2=60*\bad2}
  \integer{bad3=60*\bad3}
  \text{unite=min}
}
% Question 2, on demande la distance
\if{\question=2}{
  \text{enonce=Une voiture roule à \vitesse km/h pendant \duree minutes. Combien de kilomètre a-t-elle parcouru &#63;}
  \text{good=\distance km}
  \text{enonceb=}
  \integer{bad1=\vitesse*\bad1}
  \integer{bad2=\vitesse*\bad2}
  \integer{bad3=\vitesse*\bad3}
  \text{unite=km}
}
% Question 3, on demande la vitesse
\if{\question=3}{
  \text{enonce=Une voiture a parcouru \distance km en \duree minutes en roulant à la même vitesse. Quelle a été sa vitesse &#63;}
  \text{enonceb=}
  \text{good=\vitesse km/h}
  \integer{bad1=\vitesse*\bad1}
  \integer{bad2=\vitesse*\bad2}
  \integer{bad3=\vitesse*\bad3}
  \text{unite=km/h}
}
\text{bads=\bad1 \unite,\bad2 \unite,\bad3 \unite}
\if{\question=1 or \question=2}{
  \text{feedback=Une vitesse de \vitesse km/h signifie que <span style="color:blue"><b>\vitesse kilomètres</b></span> sont parcourus en <span style="color:green"><b>1 heure</b></span>.}
}
\if{\question=1}{
\if{\rapport=1.5}{
  \text{feedback=\feedback
  <br>Et comme &nbsp;&nbsp; <span style="color:blue"><b>\vitesse km + \vitesse_moitie km = \distance km</b></span>
    <br>On calcule &nbsp; <span style="color:green"><b>60 min + 30 min = \duree min </b></span>
  }
}{
  \text{feedback=\feedback
  <br>Et comme &nbsp;&nbsp; <span style="color:blue"><b>\vitesse km <span style="color:red">\calcul</span> = \distance km</b></span>
    <br>On calcule &nbsp; <span style="color:green"><b>60 min <span style="color:red">\calcul</span> = \duree min </b></span>
  }
}
  \text{feedback=\feedback
    <br>
    <br><u>Pour parcourir \distance km&#44; la voiture va mettre <b>\duree minutes</b></u>.
  }
}
\if{\question=2}{
\if{\rapport=1.5}{
  \text{feedback=\feedback
  <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>60 min + 30 min = \duree min </b></span>
    <br>On calcule &nbsp; <span style="color:blue"><b>\vitesse km + \vitesse_moitie km = \distance km</b></span>
  }
}{
  \text{feedback=\feedback
  <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>60 min <span style="color:red">\calcul</span> = \duree min </b></span>
    <br>On calcule &nbsp; <span style="color:blue"><b>\vitesse km <span style="color:red">\calcul</span> = \distance km</b></span>
  }
}
  \text{feedback=\feedback
    <br>
    <br><u>En \duree minutes&#44; la voiture va parcourir <b>\distance km</b></u>.
  }
}
\if{\question=3}{
  \integer{vitesse_moitie=\vitesse/2}
  \text{feedback=Pour connaître la vitesse&#44; il faut chercher combien de <span style="color:blue"><b>kilomètres</b></span> sont parcourus en <span style="color:green"><b>1 heure</b></span>.}
  \if{\rapport=1.5}
  {
    \text{feedback=\feedback
      <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>\duree min <span style="color:red">&#58; 3</span> = 30 min</b></span>
      <br>On calcule &nbsp; <span style="color:blue"><b>\distance km <span style="color:red">&#58; 3</span> = \vitesse_moitie km</b></span>
      <br>&rarr; En <span style="color:green"><b>30 minutes</b></span>&#44; la voiture a parcouru <span style="color:blue"><b>\vitesse_moitie kilomètres</b></span>.
      <br>
      <br>Et en doublant les valeurs&#44; on trouve la distance parcourue en une heure.
    }
  }{
    \text{feedback=\feedback
      <br>Et comme &nbsp;&nbsp; <span style="color:green"><b>\duree min <span style="color:red">\calcul_inverse</span> = 60 min</b></span>
      <br>On calcule &nbsp; <span style="color:blue"><b>\distance km <span style="color:red">\calcul_inverse</span> = \vitesse km</b></span>
    }
  }
    \text{feedback=\feedback
      <br>
      <br><u>La voiture a une vitesse de <b>\vitesse km/h</b></u>.
    }
}
\text{qen5=\enonce}
\text{qenb5=\enonceb}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng5=position(1,\t)}
\text{repA5=\qrep[\t[1]]}
\text{repB5=\qrep[\t[2]]}
\text{repC5=\qrep[\t[3]]}
\text{repD5=\qrep[\t[4]]}
%%%% si question libre
\text{rep5=\rep}
\text{trep5=\typerep}
\text{size5=8}
