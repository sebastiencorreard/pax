\precision{10000000}
\title{Question 102 Lecture d'abscisse}
\keywords{quizz,fraction,number_line}
\observation{Question du sujet zéro sujet-zero-dnb-serie-generale-a-mathematiques.pdf du DNB publié sur éduscol en décembre 2025 }
\language{fr}
\author{Sébastien, Corréard}
\email{sebastien.correard@ac-aix-marseille.fr}
\format{html}
\integer{u1=2}
\integer{u2=10}
\integer{h_grad_princ=20}
\integer{h_grad_sec=10}
\integer{denominateur=randint(3..6)}
\integer{numerateur=randint(\denominateur+1..2*\denominateur-1)}
\rational{pas=1/\denominateur}
\real{rpas=1/\denominateur}
\rational{borne_x_inf=0-\pas}
\real{rborne_x_inf=0-\rpas}
\integer{borne_x_sup=2}
\rational{abscisse_e=\numerateur/\denominateur}
\text{good=\(\frac{\numerateur}{\denominateur}\)}
\integer{bad_denom1=\denominateur-1}
\integer{bad_denom2=\denominateur<6?\denominateur+1:randint(3..5)}
\integer{bad_denom3=randint(3..5)}
\integer{bad_num1=\numerateur+1}
\integer{bad_num2=\numerateur-1}
\text{bad1=\(\frac{\numerateur}{\bad_denom1}\)}
\text{bad2=\(\frac{\bad_num2}{\bad_denom2}\)}
\text{bad3=\(\frac{\bad_num1}{\bad_denom1}\)}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse est \good.}
\text{feedback=\feedback <br>L'unité est partagé en \denominateur parties&#44; chaque intervalle vaut donc \(\frac{1}{\denominateur}\).}
\text{feedback=\feedback <br>L'abscisse du point E et à \numerateur intervalles de l'origine&#44; son abscisse vaut donc \(\numerateur\times\frac{1}{\denominateur}=\frac{\numerateur}{\denominateur}\).}
