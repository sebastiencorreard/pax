\real{rpas_pixels=(500*\rpas)/(2+\rpas)}
\integer{pas_pixels=floor(\rpas_pixels)}
\text{grad_sec=}
\for{i=2 to 2*\denominateur}
{
  \integer{diff=\i-\denominateur}
  \if{\diff = 1}
  {}
  {
    \integer{xgrad=\i*\pas_pixels}
    \text{grad_sec=\grad_sec segment \xgrad,50-\h_grad_sec,\xgrad,50+\h_grad_sec,black;}
  }
}
\text{grad_princ=segment \pas_pixels,50-\h_grad_princ,\pas_pixels,50+\h_grad_princ,black;}
\integer{xgrad=(\denominateur+1)*\pas_pixels}
\text{grad_princ=\grad_princ segment \xgrad,50-\h_grad_princ,\xgrad,50+\h_grad_princ,black}
\text{dessin=canvasdraw(500,100
linewidth 2
segment 0,50,500,50,black
text black,\pas_pixels*0.92,10,large,0
text black,\pas_pixels*(\denominateur+0.92),10,large,1
text blue,\pas_pixels*(\numerateur+0.9),65,large,E
linewidth 1
\grad_sec
linewidth 2
\grad_princ
crosshair \pas_pixels*(\numerateur+1),50,blue
)}
