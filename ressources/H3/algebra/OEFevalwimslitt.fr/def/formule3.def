!set title=Établir une formule 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Réponse&nbsp;
val7=Mettre en correspondance chacun des textes avec leur traduction algébrique.
val8=&nbsp;
tmp0=!values v for v=2 to 9

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$[rint($(val9[1]))]
val11=$[rint($(val9[2]))]
tmp=!nonempty items x,y,y,t,u,v,a,b

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]

!ifval $val13=1
val14=somme
!else
val14=différence
!endif

!ifval $val13=1
val15=+
!else
val15=-
!endif
tmp=!trim La $val14 de $val10 et de \($val12\),\($val10$val15 $val12 \)	Le produit de $val10 par \($val12\),\($val10\times $val12\)	La $val14 de $val11 et du produit de \($val12\) par $val10,\($val11$val15 $val12\times $val10\)	Le produit de $val11 par la $val14 de $val10 et de \($val12\),\($val11\times ($val10$val15$val12)\)
val16=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val16

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
replytype1=correspond
replyname1=$val6
replygood1=$val17;$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

