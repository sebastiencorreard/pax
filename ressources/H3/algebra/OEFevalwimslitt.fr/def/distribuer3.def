replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Développer l'expression ,suivante&nbsp;
val7=Expression développée
val8=&nbsp;
tmp0=!values v for v=2 to 9

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
tmp=!nonempty items x,y,z,a,b,u,v

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val12=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val13=$(tmp0)
tmp0=!shuffle ,*$val10

val14=$(tmp0)
tmp0=!shuffle ,*$val10

val15=$(tmp0)
val16=-($(val9[1])$(val14[1])-$(val9[2])$(val14[2]))+($(val9[3])$(val15[1])-$(val9[4])$(val15[2]))
tmp0=!texmath $val16

val17=$(tmp0)
t_=!replace internal \( by ( in $val16
tmp0=!exec pari $t_

val18=$(tmp0)
replytype1=litexp
replyoption1=polexpand 
replyname1=\($val13\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $(val6[1]) \($val13\) $(val6[2]): \begin{center}\($val13 = $val17\).\end{center} \end{statement}


!goto stat

!exit

:question
$()	  $(val6[1]) 
!insmath $val13
$() $(val6[2]):	<div class="wimscenter"> 
!insmath $val13 = $val17
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $(val6[1]) 
!insmath $val13
$() $(val6[2]): $m_begin{center}
!insmath $val13 = $val17
$().$m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

