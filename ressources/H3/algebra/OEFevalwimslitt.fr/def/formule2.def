!set title=Établir une formule 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Réponse&nbsp;
val7=&nbsp;
tmp0=!shuffle A,B,C,D,E

val8=$(tmp0)
tmp0=!randint 9, 15

val9=$[rint($(tmp0))]
tmp=!nonempty items x,y,a,b,u,v

tmp0=!randitem $tmp
val10=$(tmp0)
!readproc oef/draw.phtml 200,100 \
range 0,20,0,10	polygon black,2,2,14,2,19,2,14,8,2,8	text black,2,1.9,medium,$(val8[4])	text black,14,1.9,medium,$(val8[3])	text black,19,1.9,medium,$(val8[5])	text black,14,9.3,medium,$(val8[2])	text black,2,9.3,medium,$(val8[1])	dsegment 14,2,14,8,black 
tmp0=$ins_url
val11=$(tmp0)
tmp=!nonempty items cm,m,dm,dam

tmp0=!randitem $tmp
val12=$(tmp0)
replytype1=auto

replyname1=$val6
replygood1=$val10*($val9-$val10)+$val10^2/2
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val11" alt=""></div>	 <div class="medium_size text_col">	  Sur la figure, 
!insmath $(val8[1])$(val8[2])$(val8[3])$(val8[4])
$() est un rectangle et 
!insmath $(val8[2])$(val8[3])$(val8[5])
$()	  un triangle rectangle isocèle en $(val8[3]).<br>	  On sait que $(val8[4])$(val8[5]) = $val9 $val12 et on pose 
!insmath $(val8[1])$(val8[4])
$() = 
!insmath $val10
$() $val12.<p>	  Exprimer la mesure de l'aire de la surface 
!insmath $(val8[1])$(val8[2])$(val8[5])$(val8[4])
$() en fonction de 
!insmath $val10
$().	</p>	<div>	<b>$val6$val7:</b>	<label for="reply1">	La mesure de l'aire de 
!insmath $(val8[1])$(val8[2])$(val8[5])$(val8[4])
$() est de </label>	 
!read oef/embed.phtml r1,15 
$() 
!insmath $val12^2
$().	</div>	</div></div>
$()
!exit

