!set title=Établir une formule 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Réponse&nbsp;
val7=&nbsp;
tmp0=!randint 12, 16

val8=$[rint($(tmp0))]
tmp=!nonempty items X,Y,Z,N

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!randint 1, 2

val10=$(tmp0)
!if $val10=1 
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val11=$(tmp0)
val12=il
!else
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val11=$(tmp0)
val12=elle
!endif
val13=a $val8 ans. Quel âge aura-t-$val12 dans \($val9\) ans&nbsp;
replytype1=litexp
replyname1=$val6
replygood1=$val9+$val8,$val8+$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 $val13?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13
embedcnt=0
