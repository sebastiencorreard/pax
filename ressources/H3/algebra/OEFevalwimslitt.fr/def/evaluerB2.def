!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Évaluer l'expression,pour
val7=&nbsp;
tmp0=!values v for v=2 to 9

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp=!nonempty items x,y,z,a,b,u,v

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!shuffle +$(val8[1])*$val9,$val10$(val8[2])

val13=$(tmp0)
tmp0=!items2words $val13

val13=$(tmp0)
tmp0=!shuffle +$(val8[3])*$val9,$val11$(val8[4])

val14=$(tmp0)
tmp0=!items2words $val14

val14=$(tmp0)
val15=($val13)*($val14)
val16=-$(val8[5])
tmp0=!texmath $val15

val17=$(tmp0)
tmp0=!replace internal $val9 by ($val9) in $val15

val15=$(tmp0)
evaltmp=$val15

evaltmp=!mathsubst $val9=($val16) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val18=$(tmp1)
tmp0=!texmath $val16

val19=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=\($val12\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $(val6[1]) \($val12\) $(val6[2]) \($val9 = $val19\): \begin{center}\($val12 = $val17\).\end{center} \end{statement}


!goto stat

!exit

