val8=$(tmp0)
tmp0=!randint 2, 8

val9=$[rint($(tmp0))]
tmp0=!randint 12, 18

val10=$[rint($(tmp0))]
tmp=!nonempty items x,y,b,u,v

tmp0=!randitem $tmp
val11=$(tmp0)
!readproc oef/draw.phtml 200,200 \
range 0,20,0,20	polygon black,6,2,14,2,14,14,18,14,18,18,2,18,2,14,6,14	text black,2,19.3,medium,$(val8[1])	text black,6,19.3,medium,$(val8[2])	text black,14,19.3,medium,$(val8[3])	text black,18,19.3,medium,$(val8[4])	text black,18.1,13.9,medium,$(val8[5])	text black,14.3,13.9,medium,$(val8[6])	text black,14,1.9,medium,$(val8[7])	text black,6,1.9,medium,$(val8[8])	text black,4.8,13.9,medium,$(val8[9])	text black,2,13.9,medium,$(val8[10])	dsegment 6,14,6,18,black	dsegment 14,14,14,18,black 
tmp0=$ins_url
val12=$(tmp0)
tmp=!nonempty items cm,m,dm,dam

tmp0=!randitem $tmp
val13=$(tmp0)
val14=$[rint(2*($val10+$val9))]
replytype1=auto

replyname1=$val6
replygood1=4*$val11+$val14,$val14+4*$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val12" alt=""></div>	 <div class="medium_size text_col">	Sur la figure, 
!insmath $(val8[2])$(val8[3])$(val8[7])$(val8[8])
$() est un rectangle.	
!insmath $(val8[1])$(val8[2])$(val8[9])$(val8[10])
$() et  
!insmath $(val8[3])$(val8[4])$(val8[5])$(val8[6])
$() sont deux carrés.	<br>	On sait que 
!insmath $(val8[2])$(val8[8]) = $val10 $val13
$() et 
!insmath $(val8[8])$(val8[7]) = $val9 $val13
$().<br>	On note 
!insmath $val11
$() la mesure (en $val13) de la longueur des côtés des carrés 
!insmath $(val8[1])$(val8[2])$(val8[9])$(val8[10])
$()	et 
!insmath $(val8[3])$(val8[4])$(val8[5])$(val8[6])
$().<br>	Exprimer la mesure du périmètre de la figure en fonction de 
!insmath $val11
$().	<div>	<b>$val6$val7:</b>	<label for="reply1">La mesure du périmètre de la figure est de</label>  
!read oef/embed.phtml r1,7 
$() $val13.	</div>	</div>	</div>	
$()
