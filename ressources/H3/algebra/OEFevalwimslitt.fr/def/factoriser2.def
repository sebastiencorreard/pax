!set title=Factoriser une somme 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Factoriser l'expression suivante&nbsp;
val7=&nbsp;
tmp=!nonempty items 2,4,6,8

tmp0=!randitem $tmp
val8=$(tmp0)

!ifval $val8=6
tmp=!nonempty items 5,7,11

tmp0=!randitem $tmp
val9=$(tmp0)
!else
tmp=!nonempty items 3,5,7,9

tmp1=!randitem $tmp
val9=$(tmp1)
!endif
tmp=!nonempty items 2,3,5,9

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items x,y,z,a,b,u,v

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val12=$(tmp0)
val13=$[rint($val8*$val10)]
val14=$[rint($val9*$val10)]
tmp0=!shuffle ,*$val11

val15=$(tmp0)
val16=$val13$(val15[1])-$val14$(val15[2])
tmp0=!texmath $val16

val17=$(tmp0)
t_=!replace internal \( by ( in factor($val16);
tmp0=!exec maxima $t_

val18=$(tmp0)
replytype1=litexp
replyoption1=polfactor 
replyname1=\($val12\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val6 \begin{center}\($val12 = $val17\).\end{center} \end{statement}


!goto stat

!exit

:question
$()	  $val6:	<div class="wimscenter"> 
!insmath $val12 = $val17
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val6 $m_begin{center}
!insmath $val12 = $val17
$().$m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12,17
embedcnt=0
