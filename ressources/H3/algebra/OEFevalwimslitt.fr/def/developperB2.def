!set title=Développer une expression B2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Développer et réduire l'expression
val7=&nbsp;
tmp0=!values v for v=2 to 9

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp=!nonempty items x,y,z,a,b,u,v

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!shuffle $(val8[1]),$(val8[2])*$val9

val11=$(tmp0)
tmp0=!shuffle $(val8[3]),$(val8[4])*$val9

val12=$(tmp0)
tmp0=!shuffle +,-

val13=$(tmp0)
val14=($(val11[1])$(val13[1])$(val11[2]))*($(val12[1])$(val13[2])$(val12[2]))
tmp0=!texmath $val14

val15=$(tmp0)
t_=!replace internal \( by ( in $val14
tmp0=!exec pari $t_

val16=$(tmp0)
replytype1=litexp
replyoption1=polexpand 
replyname1=\($val10\)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val6 \($val10\): \begin{center}\($val10 = $val15\).\end{center} \end{statement}


!goto stat

!exit

:question
$()	  $val6 
!insmath $val10
$()$val7:	<div class="wimscenter"> 
!insmath $val10 = $val15
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val6 
!insmath $val10
$(): $m_begin{center}
!insmath $val10 = $val15
$().$m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,15
embedcnt=0
