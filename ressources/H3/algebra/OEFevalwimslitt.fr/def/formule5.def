!set title=Établir une formule 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Réponse&nbsp;
val7=&nbsp;
tmp=!trim lui,il	lui,elle
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val9=$(tmp0)
!if $val9=2 
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val10=$(tmp0)
!else
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val10=$(tmp0)
!endif
tmp0=!randint 12, 25

val11=$[rint($(tmp0))]
tmp0=!randint 3, 6

val12=$[rint($(tmp0))]
tmp=!nonempty items X,Y,Z,N

tmp0=!randitem $tmp
val13=$(tmp0)
replytype1=auto

replyname1=$val6
replygood1=$val11+$val12*$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10 a acheté un abonnement au cinéma près de chez $(val8[$val9;1]).	  Cet abonnement $(val8[$val9;1]) a coûté $val11 euros.	  Maintenant pour chaque film qu'$(val8[$val9;2]) va voir, $(val8[$val9;2]) paye $val12 euros.	  <p>	  Écrire en fonction de 
!insmath $val13
$() combien $(val8[$val9;2]) dépensera pour aller	  voir 
!insmath $val13
$() films.	  </p>	  <div class="spacer">	  <label for="reply1">$val6$val7:</label>  
!read oef/embed.phtml r1,7 
$() euros.	  </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13
embedcnt=1
