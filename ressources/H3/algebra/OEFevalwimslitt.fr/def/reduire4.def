val7=&nbsp;
tmp0=!values v for v=2 to 9

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp=!nonempty items x,y,z,a,b,u,v

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val12=$(tmp0)
val13=$[rint($(val8[1])+$(val8[6]))]
tmp0=!shuffle ,*$val9,*$val9^2

val14=$(tmp0)
tmp0=!shuffle +$(val8[1])$(val14[1]),+$(val8[2])$(val14[2]),-$val13$(val14[1]),+$(val8[4])$(val14[3]),$val11$(val8[5])$(val14[2]),+$(val8[6])$(val14[1])

val15=$(tmp0)
tmp0=!items2words $val15

val15=$(tmp0)
tmp0=!texmath $val15

val16=$(tmp0)
t_=!replace internal \( by ( in $val15
tmp0=!exec pari $t_

val17=$(tmp0)
replytype1=litexp
replyname1=\($val12\)
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $(val6[1]) \($val9\) $(val6[2]) \($val12\): \begin{center}\($val12 = $val16\).\end{center} \end{statement}


