\title{Distribuer 3}


\text{a=wims(values v for v=2 to 9)}
\text{a=shuffle(\a)}
\text{x=randitem(x,y,z,a,b,u,v)}
\text{sg=randitem(+,-)}
\text{sg2=randitem(+,-)}
\text{A=randitem(A,B,C,D,E,F,G)}
\text{l=shuffle(,*\x)}
\text{l2=shuffle(,*\x)}
\text{calc=-(\a[1]\l[1]-\a[2]\l[2])+(\a[3]\l2[1]-\a[4]\l2[2])}
\text{enonce=texmath(\calc)}
\text{rep=pari(\calc)}
