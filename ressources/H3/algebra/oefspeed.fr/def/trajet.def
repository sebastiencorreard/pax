$()	</li><li> $(val11[3;1]) $val45 $(val11[3;2])?	 
!read oef/embed.phtml reply 2,8 
$()	</li><li>	$(val11[4;])?	 
!read oef/embed.phtml reply 3,8 
$()	</li></ul> 
!endif
$()	
!if $m_step=2 
$()	  
!if $val44=1 
$()$(val12[1;])	  $val32 km/h. $(val12[2;1])? 
!else
$() $(val12[2;2]) $val29.	  $(val12[3;])? 
!endif
$()	  <div class="wimscenter"> 
!read oef/embed.phtml reply 4, 8 
$()</div> 
!endif
$()	
!if $m_step=3 
$()$(val13[1]) $val29 $(val13[2]) $val32 km/h.	  $(val13[3])?	<div class="wimscenter"> 
!read oef/embed.phtml reply 5,8 
$()</div> 
