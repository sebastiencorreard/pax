!set title=Trajet en voiture
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Traject met de auto

ansorder=r,r,r,r,r
varcnt=57
prevarcnt=56
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=première,seconde
!readproc slib/oef/env lang 
tmp0=$slib_out
val7=$(tmp0)
val8=h,km,km/h
val9=Heure,Vitesse
val10=Anne doit parcourir la distance de, km selon le graphique suivant
tmp=!trim Lire le diagramme	  Combien de temps s'arrête-t-elle en cours de route	  Combien de temps après son départ fait-elle la,pause	  Quelle distance a-t-elle alors parcourue
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Elle a parcouru la fin du trajet (après la deuxième pause) à la vitesse moyenne horaire de	  A quelle heure arrive-t-elle, Elle arrive à	  A quelle vitesse moyenne horaire a-t-elle parcouru la fin du trajet (après la deuxième pause)
val12=!translate internal $	\
$ to ;; in $tmp
val13=Elle arrive donc à,	  avec une vitesse moyenne horaire sur le dernier tronçon de,	  Quelle est sa vitesse moyenne horaire sur l'ensemble du parcours
val14=Arrondir les vitesses à 1 par excès (en km/h).	  Écrire les unités (les temps sont écrits en heures et en minutes	  par exemple 150 min ou 2 h 30 min en laissant un espace entre les heures et les minutes)
val15=Temps de pause ,pause,Nombre de km
!if $val7=nl 
val8=uur,km,km/uur
val9=Tijd, Snelheid
val10=Anne moet de afstand van, km doorlopen volgens het	volgende grafiek
tmp=!trim Lees het diagram	  Hoe lang stopt zij onderweg	  Hoe lang na haar vertrek neemt zij haar eerste pauze	  Hoeveel km heeft ze dan gereden
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Het einde van het traject (na de tweede pauze) heeft ze gereden met een gemiddelde snelheid gehad van	  Hoe laat komt ze aan, Ze komt om XXXX aan	  Met welke gemiddelde snelheid heeft ze het einde van het traject (na de tweede pauze) gereden
val12=!translate internal $	\
$ to ;; in $tmp
val13=Ze komt dus om,	 uur aan met een gemiddelde snelheid voor laatste stuk van,	 Wat is haar gemiddelde snelheid voor het hele traject
val14=Rond de snelheden naar boven af op de eenheid (in km/h).	  Schrijf de tijden als uren en minuten,	  bijvoorbeeld als 120 min of 2u 30 min.
val15=Duur van de pauze,pauze,Aantal km
!endif
tmp0=!randint 2, 3

val16=$[rint($(tmp0))]
tmp0=!randint 1, 2

tmp1=!randitem 2,4

val17=$[$(tmp0)/$(tmp1)]
tmp0=!randint 1, 2

val18=$[$(tmp0)]
tmp0=!randint 1, 2

tmp1=!randitem 2,4

val19=$[$(tmp0)/$(tmp1)]
tmp0=!randint 1, 2

val20=$[$(tmp0)]
tmp0=!randint 7, 9

val21=$[$(tmp0)]
val22=$[$val21+$val16]
val23=$[$val22+$val17]
val24=$[$val23+$val18]
val25=$[$val24+$val19]
val26=$[$val25+$val20]
val27=$[floor($val26)]
val28=$[($val26-$val27)*60]

!ifval $val28 <>0 
val29= $val27 h $val28 min 
!else
val29= $val27 h
!endif
tmp0=!randint 9, 12

val30=$[rint(10*$(tmp0))]
tmp0=!randint 6, 9

val31=$[rint(10*$(tmp0))]
tmp0=!randint 9, 12

val32=$[rint(10*$(tmp0))]
val33=$[$val30*$val16]
val34=
!for val35 =0 to 20 
val36=$[rint($val35+$val21)]
val37=$[rint($val35*100)]
val34=$val34	text black, $val21+$val35,-0.5,medium,$val36 $(val8[1])	text black,$val21-1.5,$val35*100,medium,$val37 $(val8[2])	
!next
val38=$[$val30*$val16+$val31*$val18]
val39=$[$val38+$val32*$val20]
val40=$[$val16+$val17+$val18+$val19+$val20]
val41=$[ceil($val39/$val40)]
val42=$[$val39+2]
val43=$[($val17+$val19)*60]
tmp0=!randitem 1,2

val44=$(tmp0)
tmp=!nonempty items $(val6[1]),$(val6[2])

tmp0=!randitem $tmp
val45=$(tmp0)

!ifval p isin $val45
val46=$[ $val16]
!else
val46=$[$val16+$val17+$val18]
!endif
val47=$[rint(floor($val46*60))]

!ifval p isin $val45
val48= $val33
!else
val48=$val38
!endif

!ifval $val44=1 
val49= $val27 h $val28 min 
!else
val49=$val32 km/h
!endif

!ifval $val44=1 
val50= $(val8[1])
!else
val50=$(val8[3])
!endif
val51=$[$val41]

!ifval $val44=1
val52= $(val9[1])
!else
val52=$(val9[2])
!endif
oefsteps=reply1,reply2, reply3	reply4	reply5 
nextstep=!nosubst reply1,reply2, reply3	reply4	reply5 
!readproc oef/steps.proc
replytype1=units
replyname1=$(val15[1]):
replygood1=$val43 min
replytype2=units
replyname2=$val45 $(val15[2])
replygood2=$val47 min
replytype3=units
replyname3=$(val15[3])
replygood3=$val48 km
replytype4=units
replyname4=$val52
replygood4=$val49
replytype5=units
replyname5=
replygood5=$val51 km/h
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() $(val10[1]) $val39 $(val10[2]):	<div class="wimscenter">  
!read oef/draw.phtml 500,250 \
	xrange $val21-2,$val26+1	yrange -40,$val42+1	$val34	hline $val21,0, black	vline $val21,0, black	parallel $val21-0.1,0,$val21+0.1,0,0,10,100,blue	parallel $val21-0.5,0,$val21+0.5,0,0,100,10,black	parallel $val21,-1,$val21,1,1,0,10,black	parallel $val21,-12,$val21,12,1,0,20,black	parallel $val21,-5,$val21,5,0.25,0,80,blue	linewidth 2	polyline red, $val21,0,$val22,$val33,$val23,$val33,$val24,$val38, $val25,$val38, $val25+$val20, $val39	arrow $val25,$val38,$val25+$val20, $val39,10, red	linewidth 1	dsegment $val22,$val33,$val22,0,black	dsegment $val23,$val33,$val23,0,black	dsegment $val24,$val38,$val24,0,black	dsegment $val25,$val38,$val25,0,black	dsegment $val22,$val33,$val21,$val33,black	dsegment $val24,$val38,$val21,$val38,black	 
$()</div>	
!if $m_step=1 
$()$(val11[1;]):	<ul><li>	$(val11[2;])?  
