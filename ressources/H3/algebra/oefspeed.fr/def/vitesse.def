!set title=Calcul de vitesse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Snelheids berekening

ansorder=r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=h,km,km/h
val8=Un motocycliste roule pendant,à la vitesse de,	  et pendant,à la vitesse de
val9=Quelle est sa vitesse moyenne
val10=Il roule ensuite pendant, Sa vitesse moyenne totale est de,	  Quelle est sa vitesse moyenne dans la dernière partie&nbsp;
val11=Les résultats seront donnés avec un chiffre au plus après la virgule et	  en
val12=Vitesse moyenne,	  Vitesse dans la dernière partie
!if $val6=nl 
val7=uur,km,km/uur
val8=Een motorfietser rijdt,met een snelheid van,	  en,met een snelheid van
val9=Wat is zijn gemiddelde snelheid
val10=Wat is zijn gemiddelde snelheid, Zijn gemiddelde snelheid over het geheel is,	  QWat is zijn gemiddelde snelheid over het laatste stu
val11=De resultaten worden gegeven met één cijfer achter	  de comma, en in km/u. Schrijf de eenheid erbij.
!endif
tmp0=!randint 1, 6

val13=$[rint(10*$(tmp0))]
tmp0=!randint 1, 6

val14=$[rint(10*$(tmp0))]
tmp0=!randint 1, 6

val15=$[rint($(tmp0)*5)]
tmp0=!randint 1, 6

val16=$[rint($(tmp0)*5)]
val17=$[floor(10*($val13*$val15+$val14*$val16)/($val13+$val14))/10]
tmp0=!randint 1, 6

val18=$[rint(10*$(tmp0))]
tmp0=!randint 1, 6

val19=$[rint($(tmp0)*5)]
val20=$[floor(10*($val13*$val15+$val14*$val16+$val18*$val19)/($val13+$val14+$val18))/10]
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=absolute precision=10 comma 
replyname1=$(val12[1])
replygood1=$[$val17]
replyoption2=absolute precision=10 comma 
replyname2=$(val12[2])
replygood2=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val13 min	  $(val8[2]) $val15 km/h $(val8[3]) $val14 min $(val8[4]) $val16 $(val7[3]).	  
!if $m_step=1 
$()$val9?  
!endif
$()	  
!if $m_step=2 
$()<p>$(val10[1]) $val18 min. $(val10[2]) $val20 $(val7[3]). $(val10[3])?</p> 
!endif
$()	  <div class="wims_instruction">$val11 $(val7[3]).</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,13,14,15,16,18,20
embedcnt=0
