!set title=Puissance 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Machten 1

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer la valeur exacte de l'expression suivante&nbsp;
val8=Vous pouvez écrire votre résultat sous forme	  d'une fraction irréductible ou sous forme décimale (si elle existe).
!if $val6=nl 
val7=Bereken de volgende uitdrukking
val8=Vous pouvez écrire votre résultat sous forme	  d'une fraction irréductible ou sous forme décimale (si elle existe).
!endif
val9=puissance1
!readproc slib/expnumeric $val9 
tmp0=$slib_out
val10=$(tmp0)
t_=!replace internal \( by ( in $val10;
tmp0=!exec maxima $t_

val11=$(tmp0)

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val2>5
val2=$[rint(5)]
!endif
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val12=$(tmp0)
replytype1=numexp
replyname1=\($val10\)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7: \begin{center}\($val12 = $val10\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()$val7:	  <div class="wimscenter">
!insmath $val12 = $val10
$()</div>	<div class="wimscenter"><label for="reply1">
!insmath $val12
$()</label> =  
!read oef/embed.phtml r1,10 
$().</div>	<div class="wims_instruction">	$val8</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7: $m_begin{center}
!insmath $val12 = $val10
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,12
embedcnt=1
