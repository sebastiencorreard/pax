!set title=Écriture décimale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Decimale schrijfwijze

ansorder=r,r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Écrire sous forme décimale le nombre suivant&nbsp;,	  Écrire sous forme décimale les nombres suivants&nbsp;
!if $val6=nl 
val7=Schrijf het volgende getal in decimale schrijfwijze,	  Schrijf de volgende getallen in decimale schrijfwijze
!endif

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val2>5
val2=$[rint(5)]
!endif
val8=
val9=
val10=
!for val11 =1 to $val2 
tmp0=!shuffle 1,-1

val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
tmp=!nonempty items 1,1,-1

tmp0=!randitem $tmp
tmp1=!randint 10, 1000

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 4

val16=$[rint($val13*$(tmp0))]
tmp0=!randint 2, 4

val17=$[rint($val14*$(tmp0))]

!ifval $val16<0
val16=$[$val15*10^($val16)]
!else
val16=$[$val15]
!endif
val18=$val16\times 10^{$val17}
val19=$[$val16*10^($val17)]
tmp0=!append item $val18 to $val8

val8=$(tmp0)
tmp0=!append item $val19 to $val9

val9=$(tmp0)
tmp0=!append item r$val11 to $val10

val10=$(tmp0)
!next
oefsteps=$val10 
nextstep=!nosubst $val10 
!readproc oef/steps.proc
replytype1=numexp
replyname1=\($(val8[1]))
replygood1=$(val9[1])
replytype2=numexp
replyname2=\($(val8[2]))
replygood2=$(val9[2])
replytype3=numexp
replyname3=\($(val8[3]))
replygood3=$(val9[3])
replytype4=numexp
replyname4=\($(val8[4]))
replygood4=$(val9[4])
replytype5=numexp
replyname5=\($(val8[5]))
replygood5=$(val9[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val2=1 
$()	  $(val7[1]):	  <div class="wimscenter"><label for="reply1">
!insmath $val8 = 
$()</label>  
!read oef/embed.phtml r1,8 
$().</div>	 
!else
$() 	$(val7[1]):	<ul>	  
!for m_k=1 to $val2 
$()	  <li><label for="reply$m_k">
!insmath $(val8[$m_k]) = 
$()</label>  
!read oef/embed.phtml r\k,8 
$().</li>	   
!next
$()	</ul> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=2,7,8
embedcnt=2
