ansorder=r,r,r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compléter l'égalité suivante&nbsp;,	  Compléter les égalités suivantes&nbsp;
!if $val6=nl 
val7=Vul in,	  Vul in
!endif

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val2>5
val2=$[rint(5)]
!endif
val8=
val9=
val10=
val11=
!for val12 =1 to $val2 
tmp0=!shuffle 1,-1

val13=$(tmp0)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!item 2 of $val13

val15=$(tmp0)
tmp=!nonempty items 1,1,-1

tmp0=!randitem $tmp
tmp1=!randint 10, 1000

val16=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 3

val17=$[rint($val14*$(tmp0))]
tmp0=!randint 2, 3

val18=$[rint($val15*$(tmp0))]

!ifval $val17<0
val17=$[$val16*10^($val17)]
!else
val17=$[$val16]
!endif
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 1, 3

val19=$[rint($(tmp0)*$(tmp1))]
val20=$val17 \times 10^{$val18}
val21=$[rint($val18+($val19))]

!ifval $val21=0
val19=$[rint($val19+1)]
!endif

!ifval $val21=0
val21=$[rint(1)]
!endif
val22=10^{$val21}
val23=$[$val17*10^(-($val19))]
tmp0=!append item $val20 to $val8

val8=$(tmp0)
tmp0=!append item $val22 to $val10

val10=$(tmp0)
tmp0=!append item $val23 to $val9

val9=$(tmp0)
tmp0=!append item r$val12 to $val11

val11=$(tmp0)
!next
oefsteps=$val11 
nextstep=!nosubst $val11 
!readproc oef/steps.proc
replytype1=numexp
replyname1=\(\lteno[1]\)
replygood1=$(val9[1])
replytype2=numexp
replyname2=\(\lteno[2]\)
replygood2=$(val9[2])
replytype3=numexp
replyname3=\(\lteno[3]\)
replygood3=$(val9[3])
replytype4=numexp
replyname4=\(\lteno[4]\)
replygood4=$(val9[4])
replytype5=numexp
replyname5=\(\lteno[5]\)
replygood5=$(val9[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val2=1 
$()	  $(val7[1]):	  <div class="wimscenter">	  <label for="reply1">
!insmath $(val8[1]) = 
$()</label>  
!read oef/embed.phtml r1,10 
$() 
!insmath \times $(val10[1])
$().	  </div>	 
!else
$() 	  $(val7[2]):	  <ul>	   
!for m_k=1 to $val2 
$()	    <li>	    <label for="reply$m_k">
!insmath $(val8[$m_k]) = 
$()</label>  
!read oef/embed.phtml r\k,10 
$() 
!insmath \times $(val10[$m_k])
$().	  </li>	   
!next
$()	  </ul>	 
!endif
$()
$()
!exit

