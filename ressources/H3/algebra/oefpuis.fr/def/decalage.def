!set title=Décalage de la virgule 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
