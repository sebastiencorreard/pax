!set title=Puissance d'un entier 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_nl=Machten van een geheel getal 2

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=On demande de calculer,	  trouve,et,Qui a donné la bonne réponse&nbsp;
!if $val6=nl 
val7=Er wordt gevraagd om,	  vindt,trvindt,Wie heeft het juiste antwoord gegeven
!endif
val8=Pierre,Jeanne,Paul,Jacques,Stéphane,Nicolas,Florian,Florence
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!item 1 to 3 of $val8

val9=$(tmp0)
val10=$[rint(2)]
val11=$[rint(3)]
val12=$[rint($val10^$val11)]
val13=$[rint($val11^$val10)]
val14=$[rint($val10*$val11)]
tmp0=!shuffle $val12,$val13,$val14

val15=$(tmp0)
tmp0=!positionof item $val12 in $val15

val16=$[rint($(tmp0))]
tmp0=!item $val16 of $val9

val17=$(tmp0)
choicename1=Réponse
choicegood1=$val17
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val7[1]) 
!insmath $val10^$val11
$(). $(val9[1]) $(val7[2]) $(val15[1]),	  $(val9[2]) $(val7[2]) $(val15[2]) $(val7[3]) $(val9[3]) $(val7[2]) $(val15[3]).	$(val7[4])?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,11,15
embedcnt=0
