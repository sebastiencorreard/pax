\title{L' archiducheche}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/eponge.jpg> }
\real{a=133.1}
\real{b=21}
\integer{size=5}
\text{enonc=L'éponge de l'archiduchesse a la forme d'un parallélépipède rectangle de 100 cm³ 
lorsqu'elle est sèche et archi-sèche. 
<br>Mouillée, ses trois dimensions augmentent de 10 %.
<br><br>
Quel est le volume de l' éponge de l'archiduchesse lorsqu'elle est mouillée &#63; 
<br><br>
De quel pourcentage l'aire de chacune des faces a-t-elle augmenté &#63; }

\statement{
<table>
<tr><td><br><br>\enonc</td>
<td>\ill</td>
</tr></table>
<br><br> Le volume de l' éponge est de \embed{r1,\size} cm³ (à 0,1près) lorsqu'elle est mouillée. 
<br><br>L'aire de chacune des faces a augmentée de \embed{r2,\size} %
}


\answer{reponse}{\el1}{type=raw}
\answer{reponse}{\el2}{type=raw}

\text{el1=wims(translate , to . in \el1)}
\condition{Bonne Reponse : }{\el1=\a and \el2=\b}
