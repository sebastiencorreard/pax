\title{Les particules}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=12}
\integer{size=8}
\text{enonc=Deux particules en forme de disque ont chacune une surface initiale de 1 cm²
<br><br>On place leurs centres à 4,47m l’un de l’autre.
<br><br>Elles sont alors soumises à un réactif chimique qui, à chaque seconde, 
fait doubler la surface de l’une et tripler la surface de l’autre.
<br><br>Sachant que ces particules conservent leur forme de disque et que leurs centres restent fixes, au bout de combien de secondes ces particules entreront elles en contact  &#63;}

\statement{
<br><br>\enonc
<br><br>Les deux particules entreront en contact au bout de \embed{r1,\size} secondes (à une seconde près).
}

\answer{}{\rep}{type=raw}
\condition{ Bonne réponse }{\rep=\a}
