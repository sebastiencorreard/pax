\title{Boule dans un verre conique}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/verre.jpg> }
\real{a=3.3}
\integer{size=5}
\text{enonc=Une boule de billard est déposée dans un verre conique dont les dimensions sont données sur la figure.
<br><br>
Cette boule affleure le plan horizontal passant par le bord supérieur du verre.
<br><br>
Quelle est, au millimètre près, le rayon de cette boule  &#63; }

\statement{
<table>
<tr><td><br><br>\enonc</td>
<td>\ill</td>
</tr></table>
<br><br> La boule a un rayon de \embed{r1,\size} cm à 1 mm près. 
}

\answer{reponse}{\el1}{type=raw}

\text{el1=wims(translate , to . in \el1)}
\condition{Bonne Reponse }{\el1=\a}
