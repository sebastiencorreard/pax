\title{La piscine ronde}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=238918}
\integer{size=8}
\text{enonc=Teiki et Ariitea sont assis en deux points diamétralement opposés d’une piscine de forme circulaire et profonde de 1,80 m.
<br><br>Lorsque Hinearii prend place au bord du même bassin, les deux garçons nagent tout droit vers elle à la même vitesse.
<br><br>Après un parcours de 5 mètres, Teiki rejoint Hinearii, alors qu’Ariitea devra encore nager 7 m pour la rejoindre.
<br><br>Combien y a-t-il de litres d’eau dans ce bassin &#63;}

\statement{
<br><br>\enonc
<br><br>Dans ce bassin, il y a \embed{r1,\size} litres d'eau (à un litre près).
}

\answer{}{\rep}{type=raw}
\condition{ Bonne réponse }{\rep=\a}
