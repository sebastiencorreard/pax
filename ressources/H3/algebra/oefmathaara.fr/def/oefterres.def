!set title=Affaires de terre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=1000

ansorder=r,r
varcnt=6
prevarcnt=4
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[10]
val7=$[14]
val8=$[rint(5)]
val9=Cinq frères et sœurs ont hérité de cinq terrains carrés dont les mesures des côtés, en mètres, sont cinq entiers consécutifs. 	<br>Les terrains sont assemblés en deux groupes : les trois plus petits terrains d'un côté d'un chemin et les deux plus grands terrains de l'autre côté. 	<br>	Les surfaces de part et d'autre du chemin sont égales.	<br><br>Trouver les dimensions du plus petit et du plus grand terrain.
replytype1=raw
replyname1=reponse
replygood1=?analyze 10
replytype2=raw
replyname2=reponse
replygood2=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val9</td>	</tr></table>	<br><br> Le plus petit terrain est un carré de  
!read oef/embed.phtml r1,$val8 
$() m de côté. 	<br><br> Le plus grand terrain est un carré de  
!read oef/embed.phtml r2,$val8 
$() m de côté.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:postdef
tmp0=!translate , to . in $val10

val10=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val10=$val6 and $val11=$val7
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne Reponse : 

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=2
