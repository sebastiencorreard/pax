!set title=L' archiducheche
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=1000

ansorder=r,r
varcnt=7
prevarcnt=5
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src=$val1/eponge.jpg> 
val7=$[133.1]
val8=$[21]
val9=$[rint(5)]
val10=L'éponge de l'archiduchesse a la forme d'un parallélépipède rectangle de 100 cm³ 	lorsqu'elle est sèche et archi-sèche. 	<br>Mouillée, ses trois dimensions augmentent de 10 %.	<br><br>	Quel est le volume de l' éponge de l'archiduchesse lorsqu'elle est mouillée &#63; 	<br><br>	De quel pourcentage l'aire de chacune des faces a-t-elle augmenté &#63; 
replytype1=raw
replyname1=reponse
replygood1=?analyze 11
replytype2=raw
replyname2=reponse
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val10</td>	<td>$val6</td>	</tr></table>	<br><br> Le volume de l' éponge est de  
!read oef/embed.phtml r1,$val9 
$() cm³ (à 0,1près) lorsqu'elle est mouillée. 	<br><br>L'aire de chacune des faces a augmentée de  
!read oef/embed.phtml r2,$val9 
$() %	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:postdef
tmp0=!translate , to . in $val11

val11=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val11=$val7 and $val12=$val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne Reponse : 

