 !exit
!endif

val6=<img src=$val1/dollar.jpg> 
val7=<img src=$val1/addition.jpg> 
val8=$[10652]
val9=$[rint(5)]
val10=Mike, an American student is short of money and sends a request to his parents. 	<br><br>	His request is a clue. The total amount of dollars he needs is the result of this addition in which each digit (from 0 to 9) is associated to one and only one letter :	<br><br>	Can you find the amount of money Mike needs &#63; 
replytype1=raw
replyname1=reponse
replygood1=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val10</td>	<td>$val7 <br><br>$val6</td>	</tr></table>	<br><br> Mike needs  
!read oef/embed.phtml r1,$val9 
$() &#36;. 	
$()
!exit

