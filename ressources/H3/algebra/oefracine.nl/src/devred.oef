\title{Ontwikkelen/vereenvoudigen 1.}
\language{nl}
\author{Guerimand Fabrice}
\email{fguerima@tele2.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{a=random(2,3,5,6,7,10,11)}
\integer{d=random(2,3,5,6,7,10,11)}
\integer{g=gcd(\a,\d)}
\integer{d=\g<>1?13}
\integer{c=random(2..10)}
\integer{b=random(2..10)}

\matrix{don=(\sqrt{\a}+\b)(\sqrt{\a}-\b),\a-\b^2
(\b+\sqrt{\a})(\b-\sqrt{\a}),\b^2-\a
(\sqrt{\a}+\sqrt{\d})(\sqrt{\a}-\sqrt{\d}),\a-\d
(\b+\sqrt{\a})^2,\b^2+\a+2*\b*sqrt(\a)
(\sqrt{\a}+\b)^2,\b^2+\a+2*\b*sqrt(\a)
(\b-\sqrt{\a})^2,\b^2+\a-2*\b*sqrt(\a)
(\sqrt{\a}-\b)^2,\b^2+\a-2*\b*sqrt(\a)
(\sqrt{\a}+\sqrt{\d})^2,\a+\d+2*sqrt(\a*\d)
(\sqrt{\a}-\sqrt{\d})^2,\a+\d-2*sqrt(\a*\d)
(\c\sqrt{\a}+\sqrt{\d})(\sqrt{\a}-\c\sqrt{\d}),\c*\a-\c*\d+(1-\c^2)*sqrt(\a*\d)
(\c\sqrt{\a}+\b)(\c\sqrt{\a}-\b),\c^2*\a-\b^2
(\b+\c\sqrt{\a})(\b-\c\sqrt{\a}),\b^2-\a*\c^2
(\b+\c\sqrt{\a})^2,\b^2+\c^2*\a+2*\b*\c*sqrt(\a)
(\c\sqrt{\a}+\b)^2,\b^2+\c^2*\a+2*\b*\c*sqrt(\a)
(\b-\c\sqrt{\a})^2,\b^2+\c^2*\a-2*\b*\c*sqrt(\a)
(\c\sqrt{\a}-\b)^2,\b^2+\c^2*\a-2*\b*\c*sqrt(\a)
(\c\sqrt{\a}+\sqrt{\d})^2,\c^2*\a+\d+\c*sqrt(\a*\d)
(\b+\sqrt{\a})(\c-\sqrt{\d}),\b*\c-\b*\sqrt(\d)+\c*sqrt(\a)-sqrt(\a*\d)}

\text{list=randrow(\don)}
\text{enonce=item(1,\list)}
\text{rep=item(2,\list)}
\text{rep=maxima(\rep;)}

\statement{Ontwikkel en vereenvoudig de uitdrukking \(\enonce).<br>
(schrijf sqrt(2) voor \(\sqrt{2}) )}

\reply{Antwoord}{\rep}{type=algexp}
