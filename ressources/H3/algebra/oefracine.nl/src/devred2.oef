\title{Ontwikkelen/vereenvoudigen 2.}
\language{fr}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{a=random(2,3,5)}
\integer{b=random(2,3,5,7,11)}
\integer{b=\a=\b?11}
\integer{ab=\a*\b}
\integer{c=random(2..10)}
\integer{d=random(2..10)}

\matrix{don=(\sqrt{\a}+\sqrt{\ab})^2,\a+\ab,2*\a,\b
(\sqrt{\a}-\sqrt{\ab})^2,\a+\ab,-2*\a,\b
(\c\sqrt{\a}+\sqrt{\ab})(\sqrt{\a}-\c\sqrt{\ab}),\c*\a-\c*\ab,(1-\c^2)*\a,\b
(\c\sqrt{\a}+\sqrt{\ab})^2,\c^2*\a+\ab,2*\c*\a,\b}

\text{donnees=randrow(\don)}
\text{enonce=item(1,\donnees)}
\text{b=simplify(item(2,\donnees))}
\text{sb=\b<0?-:+}
\text{Db=\b<0?-:}
\integer{b=abs(\b)}
\text{a=simplify(item(3,\donnees))}
\text{sa=\a<0?-:+}
\text{Da=\a<0?-:}
\integer{a=abs(\a)}

\text{base=simplify(item(4,\donnees))}

\text{rep=\a=0?\b:\Da\a*sqrt(\base)\sb\b,\Da sqrt(\base)*\a\sb\b,\Db\b\sa\a*sqrt(\base),\Db\b\sa sqrt(\base)*\a}

\statement{Ontwikkel en vereenvoudig de uitdrukking 
\(\enonce)
.<br>
(schrijf sqrt(2) voor \(\sqrt{2}) )}
\reply{Antwoord}{\rep}{type=litexp}
