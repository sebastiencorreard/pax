val19=$(tmp0)
tmp0=!item 2 of $val18

val20=$(tmp0)
tmp=!trim $val17*$val19+$val16*$val20
val21=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val21

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
t_=!replace internal \( by ( in factor($val22);
tmp0=!exec maxima $t_

val23=$(tmp0)
