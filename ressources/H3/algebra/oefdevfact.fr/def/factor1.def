val15=$(tmp0)
tmp0=!randitem 1,-1

val16=$[rint($(tmp0)*$val8*$val10)]
tmp0=!randitem 1,-1

val17=$[rint($(tmp0)*$val8*$val9)]

!ifval $val2=1
val18=1,$val15
!else
val18=1,$val15,$val15^2,$val15^3,$val15^4
