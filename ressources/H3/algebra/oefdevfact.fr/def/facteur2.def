val6=Réponse
val7=Vous ne devez utiliser que des coefficients entiers.
val8=Écrire un facteur commun de l'expression ci-dessous&nbsp;,	  Un facteur commun est 
tmp0=!values v,-v for v=2 to 20

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val9

val11=$[rint($(tmp0))]
tmp0=!item 3 of $val9

val12=$[rint($(tmp0))]
tmp0=!item 4 of $val9

val13=$[rint($(tmp0))]
tmp0=!item 5 of $val9

val14=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val10,$val11);
tmp0=!exec maxima $t_

val15=$[rint($(tmp0))]
!if $val15!=1 
val10=$[rint(2)]
val11=$[rint(3)]
!endif
t_=!replace internal \( by ( in gcd($val12,$val13);
tmp0=!exec maxima $t_

val15=$[rint($(tmp0))]
!if $val15!=1 
val12=$[rint(5)]
val13=$[rint(-3)]
!endif
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!shuffle x,y,a,b,z

val17=$(tmp0)
val18=$[rint($val10*$val11)]
val19=$[rint($val10*$val12)]
val20=$[rint($val11*$val12)]
tmp=!trim $val18*$(val17[1])+$val11,$val11	$val11+$val18*$(val17[1]),$val11	$val19*$(val17[1])+$val20,$val12	$val20+$val19*$(val17[1]),$val12
val21=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val21

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
tmp0=!item 1 of $val22

val23=$(tmp0)
tmp0=!item 2 of $val22

val24=$(tmp0)
tmp=!translate ";': to $     $ in $val24

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
tmp0=!texmath $val23

val23=$(tmp0)
tmp=!translate ";': to $     $ in -1*($val24)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
replytype1=litexp
replyoption1=polexpand 
replyname1=\lg_ans
