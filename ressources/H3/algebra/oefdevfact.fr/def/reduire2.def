val11=$(tmp0)
tmp0=!values v for v=0 to $val2

val12=$(tmp0)
val13=
!for val14 =0 to $val2 
tmp0=!randint $val10, $val9

val15=$[rint($(tmp0))]
!for val16 =1 to $val15 
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 2, 10

val17=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val17*$val11^$val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=($(tmp0))
tmp0=!append item $val18 to $val13

val13=$(tmp0)
!next
!next
tmp0=!shuffle $val13

val13=$(tmp0)
tmp0=!replace internal , by + in $val13

val13=$(tmp0)
t_=!replace internal \( by ( in $val13;
tmp0=!exec maxima $t_

val19=$(tmp0)
!readproc slib/commutesom $val19,$val11 
tmp0=$slib_out
val19=$(tmp0)
tmp0=!texmath $val13

val13=$(tmp0)
