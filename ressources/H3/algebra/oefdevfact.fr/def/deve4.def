tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
tmp0=!texmath $val25

val26=$(tmp0)
val27=($val23 $val14 $val25)^2
t_=!replace internal \( by ( in expand($val27);
tmp0=!exec maxima $t_

val28=$(tmp0)
tmp0=!texmath $val23

val29=$(tmp0)
tmp0=!texmath $val25

val30=$(tmp0)
val31=$val29,$val30
