!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!items2words $val16

val16=$(tmp0)
tmp0=!rawmath $val16

val16=$(tmp0)
tmp=!translate ";': to $     $ in $val16-($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val17=0
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val8?

!exit

:stat
