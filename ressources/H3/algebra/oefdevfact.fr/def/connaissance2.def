 !exit
!endif

val6=Réponse
val7=Compléter l'identité remarquable suivante en utilisant les étiquettes fournies&nbsp;
val8=Réponse correcte&nbsp;
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val10=$(tmp0)
val11=(a $val9 b)*(c $val10 d)
val12=a,b,c,d,+,-
val13=20x30x12
tmp0=!texmath $val11

val14=$(tmp0)
val15=$val11
replytype1=clickfill
replyname1=\($val14 =\)
replygood1=?analyze 16;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	<div class="wimscenter"><label for="reply1">
!insmath $val14 =
$()</label>  
!read oef/embed.phtml r1,$val13 
$().</div>
$()
!exit

