!set title=Connaissance de (a+b)(c+d)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
computeanswer=no
leftrange=-5.000000
rightrange=5.000000
language=fr

ansorder=r
varcnt=14
prevarcnt=10
postvarcnt=3
