!endif

val6=Réponse
val7=Simplifier les expressions suivantes&nbsp;
val8=Développer et réduire l'expression suivante&nbsp;
val9=Bonne réponse

!ifval $val2=
val2=$[rint(1)]
!endif

!ifval $val2<1 or $val2>6
val2=$[rint(1)]
!endif
tmp=!nonempty items x,y,z,t,u,v,a,b

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!values v,-v for v=1 to 9

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!values v for v=0 to $val2

val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
tmp0=!item 2 of $val12

val14=$(tmp0)
val15=$val13
val16=$val14
tmp=!translate ";': to $     $ in $(val11[1])*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $(val11[2])*$val10^$val14

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $(val11[3])*$val10^$val15

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $(val11[4])*$val10^$val16

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
val17=($(tmp0)+$(tmp1))*($(tmp2)+$(tmp3))
tmp0=!texmath $val17

val18=$(tmp0)
t_=!replace internal \( by ( in expand($val17);
tmp0=!exec maxima $t_

val19=$(tmp0)
tmp=!translate ";': to $     $ in $(val11[3])*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val20=$(tmp1)

!ifval $(val11[3])<0
val20=($val20)
!endif
tmp=!translate ";': to $     $ in $(val11[1])*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val21=$(tmp1)
val22=$val21\times $val20
tmp=!translate ";': to $     $ in $(val11[1])*$(val11[3])*$val10^($val13+$val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $(val11[4])*$val10^$val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val21=$(tmp1)

!ifval $(val11[4])<0
val21=($val21)
!endif
tmp=!translate ";': to $     $ in $(val11[3])*$val10^$val15

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val24=$(tmp1)

!ifval $(val11[3])>=0
val24=+$val24
!endif
tmp=!translate ";': to $     $ in $(val11[2])*$val10^$val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val20=$(tmp1)

!ifval $(val11[2])<0
val20=($val20)
!endif
tmp=!translate ";': to $     $ in $(val11[1])*$val10^$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val25=$(tmp1)\times $val21 $val24\times $val20
t_=!replace internal \( by ( in expand($(val11[1])*$(val11[4])*$val10^($val13+$val16)+$(val11[2])*$(val11[3])*$val10^($val14+$val15));
tmp0=!exec maxima $t_

val26=$(tmp0)
oefsteps=r1,r2	r3 
nextstep=!nosubst r1,r2	r3 
!readproc oef/steps.proc
replytype1=litexp
replyoption1=polexpand 
