language=fr

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Réponse
val7=Faire correspondre chaque expression factorisée avec une expression développée égale.
val8=40x220x220

!ifval $val2=
val2=$[rint(2)]
!endif
tmp0=!values v for v=1 to 10

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$[rint($(val9[1]))]
val11=$[rint($(val9[2]))]
tmp0=!randitem x,y

val12=$(tmp0)
tmp=!trim 0,0,0,0	0,1,0,1	0,1,0,0	0,0,0,1
val13=!translate internal $	\
$ to ;; in $tmp
val14=
val15=
!for val16 =1 to 4 
tmp=!translate internal $	$ to ; in $val13

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
val18=($val12^$val2+(-1)^($(val17[2]))*$val10)*($val12+(-1)^($(val17[4]))*$val11)
tmp=!translate ";': to $     $ in $val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
t_=!replace internal \( by ( in expand($val18)
tmp0=!exec maxima $t_

val19=$(tmp0)
tmp0=!texmath $val19

val19=$(tmp0)
val19=\($val19)
tmp0=!texmath $val18

val18=$(tmp0)
val18=\($val18)
tmp0=!append item $val18 to $val14

val14=$(tmp0)
tmp0=!append item $val19 to $val15

val15=$(tmp0)
!next
replytype1=correspond
replyname1=
replygood1=$val14;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

