val6=Réponse
val7=Compléter la factorisation ci-dessous&nbsp;
val8=Vous devez écrire un résultat simplifié et réduit.
tmp0=!values v for v=2 to 20

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val9

val11=$[rint($(tmp0))]
tmp0=!item 3 of $val9

val12=$[rint($(tmp0))]
tmp0=!item 4 of $val9

val13=$[rint($(tmp0))]
tmp0=!item 5 of $val9

val14=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val10,$val11);
tmp0=!exec maxima $t_

val15=$[rint($(tmp0))]
!if $val15!=1 
val10=$[rint(2)]
val11=$[rint(3)]
!endif
t_=!replace internal \( by ( in gcd($val12,$val13);
tmp0=!exec maxima $t_

val15=$[rint($(tmp0))]
!if $val15!=1 
val12=$[rint(5)]
val13=$[rint(-3)]
!endif
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!shuffle x,y,a,b,z

val17=$(tmp0)
val18=$[rint($val10*$val11)]
val19=$[rint($val10*$val12)]
val20=$[rint($val11*$val12)]
tmp=!trim $val18*$(val17[1])+$val11,$val11,$val10*$(val17[1])+1	$val11+$val18*$(val17[1]),$val11,1+$val10*$(val17[1])	$val19*$(val17[1])+$val20,$val12,$val10*$(val17[1])+$val11	$val20+$val19*$(val17[1]),$val12,$val10*$(val17[1])+$val11
val21=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val21

tmp0=!rowcnt $tmp
val22=$[rint($(tmp0))]
tmp0=!randint 1, $val22

val23=$(tmp0)
tmp=!translate internal $	$ to ; in $val21

tmp=!row $val23 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
tmp0=!item 1 of $val24

val25=$(tmp0)
tmp0=!item 2 of $val24

val26=$(tmp0)
tmp0=!item 3 of $val24

val27=$(tmp0)
t_=!replace internal \( by ( in expand($val27);
tmp0=!exec maxima $t_

val27=$(tmp0)
tmp0=!texmath $val25

val25=$(tmp0)
tmp0=!texmath $val26

val26=$(tmp0)
val28=()
tmp0=!char 1 of $val28

val29=$(tmp0)
tmp0=!char 2 of $val28

val30=$(tmp0)
val31=polexpand
replytype1=litexp
