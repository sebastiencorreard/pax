			5,12,13
			7,24,25
			9,40,41}
			\def{text a=randomrow(\list)}
			\def{integer A1=\a[1]^2}
			\def{integer A2=\a[2]^2}
			\def{integer a3=\a[1]+\a[2]}
			\def{integer A3=\A1+\A2}
   		 <div class="math">\(\begin{matrix} 
   		    A & = & \sqrt{\A1}+\sqrt{\A2} \\ 
   		    A & = & \a[1]+\a[2]  \\ 
   		    A & = & \a3
   		\end{matrix})</div></div>
<div style="width:0.45\textwidth; display:inline-block;vertical-align:top;" class="column"><div class="math">\(\begin{matrix} 
   			B & = & \sqrt{\A1+\A2} \\ 
   			B & = & \sqrt{\A3} \\ 
   			B & = & \a[3]
   		\end{matrix})</div></div>
