<a id="secproprietes"></a><div class="frame"><h3 class="l2w_content thm">Proposition &#58; $m_titproposition</h3><div class="l2w_content thm">
	    Soit 
!insmath  a 
 et 
!insmath  b 
 deux nombres positifs, on a&nbsp;&#58;
	    <p class="math">
!insmath  \sqrt{a}\times \sqrt{b}=\sqrt{ab}
</p> 
	    De plus, si 
!insmath  b \not = 0 
, on a aussi&nbsp;&#58;
	    <p class="math">
!insmath  \sqrt{\frac{a}{b}}=\frac{\sqrt{a}}{\sqrt{b}} 
</p>
	</div>
<h3 class="l2w_content exemple">Exemple &#58; $m_titexemple [
!read primitives.phtml 3, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 
]</h3><div class="l2w_content exemple"><div class="columns">
			<div style="width&#58;0.45$m_textwidth; display&#58;inline-block;vertical-align&#58;top;" class="column">
   
				
!set tmp=!trim 2,8,16,4	    2,18,36,6	    2,32,64,8	    2,50,100,10	    5,20,100,10	    10,10,100,10	    2,72,144,12	    4,36,144,12	    9,16,144,12	     
!set m_a=!translate internal $	$ to ; in $tmp

				
!set tmp=!translate internal $	$ to ; in $m_a

!set tmp=!nonempty rows $tmp
!set tmp=!randrow $tmp
!set tmp0=!translate internal $\
$ to ; in $tmp
!set m_a=$(tmp0)

				
!set m_a1=$[rint($(m_a[1]))]

				
!set m_a2=$[rint($(m_a[2]))]

				
!set m_a3=$[rint($(m_a[3]))]

			 <div class="math">
!insmath \begin{matrix}  				A & = & \sqrt{\a1} \times \sqrt{\a2} \\  			    A & = & \sqrt{\a3}   \\  			    A & = & \a[4]  			\end{matrix}
</div></div>
<div style="width&#58;0.45$m_textwidth; display&#58;inline-block;vertical-align&#58;top;" class="column">
   
				
!set tmp0=!randint 2, 15

!set m_bb1=$[rint($(tmp0))]

				
!set m_b1=$[rint(($m_bb1)^2)]

				
!set tmp0=!randint 2, 15

!set m_bb2=$[rint($(tmp0))]

				
!set m_b2=$[rint(($m_bb2)^2)]

				
!set t_=!rawmath $m_bb1 / $m_bb2 
!set m_r=!exec pari print($t_)

				
!set m_comp1=$m_bb1/$m_bb2

				
!set m_comp2=$m_r

				 
!if $m_comp1=$m_comp2 

!set m_sol=

!else
 
!set m_sol=B&=&$m_r

!endif

		 <div class="math">
!insmath \begin{matrix}  			B & = & \sqrt{\frac{\b1}{\b2}} \\  		    B & = &\frac{\sqrt{\b1}}{\sqrt{\b2}}   \\  		    B & = & \frac{\bb1}{\bb2} \\ 			\sol 		\end{matrix}
</div></div>
</div></div>
</div><div class="frame"><div class="frametitle">Attention</div>
<div class="columns"><div style="width&#58;0.45$m_textwidth; display&#58;inline-block;vertical-align&#58;top;" class="column">
   
			
!set tmp=!trim 3,4,5	   5,12,13	   7,24,25	   9,40,41 
!set m_list=!translate internal $	$ to ; in $tmp

			
!set tmp=!translate internal $	$ to ; in $m_list

!set tmp=!nonempty rows $tmp
!set tmp=!randrow $tmp
!set tmp0=!translate internal $\
$ to ; in $tmp
!set m_a=$(tmp0)

			
!set m_A1=$[rint($(m_a[1])^2)]

			
!set m_A2=$[rint($(m_a[2])^2)]

			
!set m_a3=$[rint($(m_a[1])+$(m_a[2]))]

			
!set m_A3=$[rint($m_A1+$m_A2)]

   		 <div class="math">
!insmath \begin{matrix}     		    A & = & \sqrt{\A1}+\sqrt{\A2} \\     		    A & = & \a[1]+\a[2]  \\     		    A & = & \a3    		\end{matrix}
</div></div>
<div style="width&#58;0.45$m_textwidth; display&#58;inline-block;vertical-align&#58;top;" class="column"><div class="math">
!insmath \begin{matrix}     			B & = & \sqrt{\A1+\A2} \\     			B & = & \sqrt{\A3} \\     			B & = & \a[3]    		\end{matrix}
</div></div>
</div><br class="spacer">	
	<h3 class="l2w_content rqm">Remarque &#58; $m_titremarque</h3><div class="l2w_content rqm">
	    Soit 
!insmath  a 
 et 
!insmath  b 
 des nombres strictement positifs, on a toujours&nbsp;&#58;
	    <p class="math">
!insmath  \sqrt{a}+\sqrt{b}\not=\sqrt{a+b} 
</p>
	</div></div>
<div class="frame">   
On écrira toujours une racine carrée sous sa forme la plus simple
possible.<br class="spacer">	
!set tmp0=!randint 2, 16

!set m_a=$[rint($(tmp0))]

	
!set m_a2=$[rint($m_a^2)]

	
!set tmp=!trim 2, 3, 5, 7, 11 
!set m_primes=!translate internal $	$ to ; in $tmp

	
!set tmp0=!shuffle $m_primes

!set tmp=!trim $(tmp0) 
!set m_list=!translate internal $	$ to ; in $tmp

	
!set m_k=$[rint($(m_list[1]))]

	
!set m_n=$[rint($m_k*$m_a2)]
<br class="spacer">	<h3 class="l2w_content exemple">Exemple &#58; $m_titexemple [ 
!read primitives.phtml 4, reload, <img src = "gifs/doc/etoile.gif" alt = "rechargez" width = "20" height = "20"> 
	]</h3><div class="l2w_content exemple">
	    Écrire le nombre donné sous la forme la plus simple &#58; 
!insmath  A=\sqrt{\n}

		<br>
		<br>
		On a &#58;
		 <div class="math">
!insmath \begin{matrix}  			A & = & \sqrt{\n} \\ 			A & = & \sqrt{\k \times \a2} \\ 			A & = & \sqrt{\k \times \a^2} \\ 			A & = & \sqrt{\a^2} \times \sqrt{\k} \\ 			A & = & \a\sqrt{\k} 		\end{matrix}
</div></div>
</div><div class="frame"><h3 class="l2w_content exercice">Exercice &#58; $m_titexercice</h3><div class="l2w_content exercice"><ul class="itemize"><li>  
