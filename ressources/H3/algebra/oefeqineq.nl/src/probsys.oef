\title{Stelsel vergelijkingen 1}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}


\text{noms=Luc,Tanya,Chris,Jan,Paul,Juliette,Yvan,Pieter,Pascale,Manja,Stephan,Lars,Clara}
\text{noms=shuffle(\noms)}
\text{prenom1=item(1,\noms)}
\text{prenom2=item(2,\noms)}


\integer{prixA=random(7..30)}
\integer{prixB=random(7..30)}
\if{\prixA=\prixB}{
\integer{prixA=7}
\integer{prixB=12}
}

\text{nomA=random(CD,DVD)}
\text{nomB=stripboek}
\text{nomBmvd=stripboeken}
\text{adA=een}
\text{adB=een}
\integer{nbA1=random(1..7)}
\integer{nbA2=random(1..7)}
\integer{nbB1=random(1..7)}
\integer{nbB2=random(1..7)}



\real{total1=\nbA1*\prixA+\nbB1*\prixB}
\real{total2=\nbA2*\prixA+\nbB2*\prixB}


\text{enonce=In een grote winkel kost iedere \nomA hetzelfde, net als ieder \nomB. \prenom1 koopt \nbA1 \nomA's en \nbB1 \nomBmvd voor \total1 euro. \prenom2 koopt \nbA2 \nomA's en \nbB2 \nomBmvd voor \total2 euro.<br>Bepaal de prijs van \adA \nomA en de prijs van \adB \nomB.}


\statement{\enonce <br><br>
<b>Antwoorden :</b> 
<ul>
<li>Prijs van \adA \nomA : \embed{r1,10} euro </li>
<li>Prijs van \adB \nomB : \embed{r2,10} euro </li>
</ul>}

\reply{Prijs van \adA \nomA}{\prixA}{type=auto}
\reply{Prijs van \adB \nomB}{\prixB}{type=auto}
