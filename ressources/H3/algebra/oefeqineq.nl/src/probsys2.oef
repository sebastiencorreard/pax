\title{Stelsel vergelijkingen 2}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{10000}


\text{noms=Luc,Tanya,Chris,Jan,Paul,Juliette,Yvan,Pieter,Pascale,Manja,Stephan,Lars,Clara}
\text{noms=shuffle(\noms)}
\text{prenom1=item(1,\noms)}
\text{prenom2=item(2,\noms)}


\integer{prixA=random(15..30)}
\integer{prixB=random(15..30)}
\if{\prixA=\prixB}{
\integer{prixA=17}
\integer{prixB=22}
}

\real{prixA=\prixA/10}
\real{prixB=\prixB/10}

\text{listnoms=appels,peren,perzikken,aardbeien,frambozen,paprikas,courgettes,wortels,tomaten,aubergines}
\text{listnoms=shuffle(\listnoms)}
\text{nomA=item(1,\listnoms)}
\text{nomB=item(2,\listnoms)}

\integer{nbA1=random(2..7)}
\integer{nbA2=random(2..7)}
\integer{nbB1=random(2..7)}
\integer{nbB2=random(2..7)}

\real{total1=\nbA1*\prixA+\nbB1*\prixB}
\real{total2=\nbA2*\prixA+\nbB2*\prixB}

\text{enonce=In de winkel koopt \prenom1 \nbA1 kilo \nomA en \nbB1 kilo \nomB voor een totaal van \total1 euro. \prenom2 koopt \nbA2 kilo \nomA en \nbB2 kilo \nomB voor een totaal van \total2 euro.<br>Bepaal de prijs van een kilo \nomA en van een kilo \nomB.}


\statement{\enonce <br><br>
<b>Antwoorden :</b> 
<ul>
<li>Prijs van een kilo \nomA : \embed{r1,10} euro </li>
<li>Prijs van een kilo \nomB : \embed{r2,10} euro </li>
</ul>}

\reply{Prijs van \adA \nomA}{\prixA}{type=auto}
\reply{Prijs van \adB \nomB}{\prixB}{type=auto}
