 \integer{d=randitem(\sg)*item(4,\listnombre)}
 \integer{n=item(5,\listnombre)}
 \text{opetex=wims(replace internal * by \times in \ope)}
 \text{opetex=wims(replace internal / by : in \opetex)}
 \if{\type=A}{
  \integer{g1=maxima(gcd(\a,\b);)}
