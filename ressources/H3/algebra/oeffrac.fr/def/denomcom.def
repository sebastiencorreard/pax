val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Quel est le plus petit dénominateur commun à,et,	  Le plus petit dénominateur commun aux deux fractions est
val8=Dénominateur commun
val9=Votre réponse
val10=Écrire la liste des multiples de, et
tmp0=!randint 2, 20

val11=$[rint($(tmp0))]
tmp0=!randint 2, 20

val12=$[rint($(tmp0))]
tmp=!nonempty items 1,2,3,4,5,2,3,4,5

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
tmp0=!randint 2, 5

val14=$[rint($val13*$(tmp0))]
tmp0=!randint 1, 5

val15=$[rint($val13*$(tmp0))]
tmp0=!shuffle 29,31,37,41

val16=$(tmp0)
t_=!replace internal \( by ( in gcd($val11,$val14);
tmp0=!exec maxima $t_

val13=$[rint($(tmp0))]

!ifval $val13!=1
tmp0=!item 1 of $val16

val11=$[rint($(tmp0))]
!endif
t_=!replace internal \( by ( in gcd($val12,$val15);
tmp0=!exec maxima $t_

val13=$[rint($(tmp0))]

!ifval $val13!=1
tmp0=!item 2 of $val16

val12=$[rint($(tmp0))]
!endif
!if $val14=$val15 
val11=$[rint(11)]
val12=$[rint(17)]
val14=$[rint(12)]
val15=$[rint(28)]
!endif
val17=\(\frac{$val11}{$val14})
val18=\(\frac{$val12}{$val15})
t_=!replace internal \( by ( in $val14*$val15/gcd($val14,$val15);
tmp0=!exec maxima $t_

val19=$[rint($(tmp0))]
replytype1=numexp
replyname1=$val8
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val7[1]) $val17 $(val7[2]) $val18 ?	<div class="spacer">	<b>$val9</b> :	$(val7[3])  
