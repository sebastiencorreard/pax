#:parameters I (H4)
n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
!if $rounding<10
    rounding=0
    !readproc $remarkdir/rounding.$taal
!endif
cols=20
rows=2
inputs=1.1
embed=1
checkfile=$checkdir/new_number.proc


a=!randitem -5,-4,-3,-2,-1,1,2,3,4,5
b=!randint 1,10
c=!randint 1,10
!if $a=1
    a_t=$empty
!else
    !if $a=-1
	a_t=-
    !else
	a_t=$a
    !endif
!endif
!if $b=1
    b_t=$empty
!else
    b_t=$b \cdot
!endif
!if $c=1
    c_t=$empty
!else
    c_t=$c \cdot
!endif
    
!if $R = 1
    checkfile=$checkdir/new_number.proc
    x=!randint  -5,5
    tot=!exec pari Y=$a*(($x)^2)+($b)*($x)\
    P=Y+($c)*($x)\
    printtex(Y)\
    printtex(P)
    y=!line 1 of $tot
    p=!line 2 of $tot
    y_tex=!line 3 of $tot
    p_tex=!line 4 of $tot
    
    answer$n=$p
    ss=!record 39 of lang/remarks.$taal
    #@Het punt P ($x : $y) is een snijpunt van de grafieken van <em>f</em> en <em>g</em><sub>p</sub><br />Bepaal voor welke waarde van <em>p</em> dit geldt.
    
    texanswer$n=\left[\begin{array}{l} g_{p}(x) = p - $c_t x \\ P ($x : $y) \\ g_{p}($x) = p - $c_t $x = $y \rightarrow \\ p = $y + $c_t $x \\  p = $y + $[$c*$x] \\ p = $p \end{array} \right.

    arglist=p
    example=<textarea cols=\'20\' rows=\'1\' class=\'schaersvoorde_textarea\' readonly=\'readonly\'>p = 1.23456</textarea>

!else
    !if $R=2
	checkfile=$checkdir/new_number.proc
	ss=!record 40 of lang/remarks.$taal
	#@De grafieken van <em>f</em> en <em>g</em><sub>p</sub> raken elkaar.<br />Bereken voor welke <em>p</em> dit het geval is.
	tot=!exec pari D=($b + ($c))^2/( -4*($a))\
	printtex(D)
	
	answer$n=!line 1 of $tot
	tex_ans=!line 2 of $tot
	
	bc=$[$b+$c]
	BC=$[$bc*$bc]
	DD=!rawmath $[$bc^2] + $[4*$a] 
	texanswer$n=\left[ \begin{array}{l} f(x)  = $a_t  x^{2} + $b_t  x \\ g_{p}(x) = p - $c_t x \\  f(x) = g_{p}(x) \\ $a_t  x^{2} + $b_t  x = p - $c_t x \\	$a_t  x^{2} + $b_t  x + $c_t x - p = 0 \\ $a_t  x^{2} + $bc \cdot x - p = 0 \\ \bf{D} = \textrm{b}^{2} - 4 \textrm{ac} = 0 \\ a=$a \\ b=$bc \\ c = - p \\ \textrm{D = } 0 \rightarrow $bc^{2} - 4 \cdot $a \cdot - p = $DD \cdot p = 0 \\  p = -\frac{$BC}{$[4*$a]} = $tex_ans \end{array} \right.
	
	arglist=p
	example=<textarea cols=\'20\' rows=\'1\' class=\'schaersvoorde_textarea\' readonly=\'readonly\'>p = 1.23456</textarea>
		
    !else
	checkfile=$checkdir/ineq.proc
	ss=!record 41 of lang/remarks.$taal
	#@De grafieken van <em>f</em> en <em>g</em><sub>p</sub> hebben twee snijpuntem.<br />Bereken voor welke waarden van <em>p</em> dit het geval is.
	
	tot=!exec pari D=($b + ($c))^2/( -4*($a))\
	printtex(D)
	
	ans=!line 1 of $tot
	tex_ans=!line 2 of $tot

	!if $a>0
	    answer$n=p>$ans
	    tex= p>$tex_ans
	!else
	    answer$n=p<$ans
	    tex= p<$tex_ans
	!endif
	bc=$[$b+$c]
	BC=$[$bc*$bc]
	DD=!rawmath $[$bc^2] + $[4*$a]
	 
	texanswer$n=\left[ \begin{array}{l} f(x)  = $a_t  x^{2} + $b_t  x \\ g_{p}(x) = p - $c_t x \\ f(x) = g_{p}(x) \\ $a_t  x^{2} + $b_t  x = p - $c_t x \\ $a_t  x^{2} + $b_t  x + $c_t x - p = 0  \\ $a_t  x^{2} + $bc \cdot x - p = 0 \\ \bf{D} = \textrm{b}^{2} - 4\textrm{ac} > 0 \\ a=$a \\ b=$bc \\ c = - p \\ \bf{D} = $bc^{2} - 4 \cdot $a \cdot - p = $DD \cdot p  \\ $DD \cdot p = 0 \\ p = -\frac{$BC}{$[4*$a]}\\ p = $tex_ans \\ D > 0 \rightarrow $tex \end{array} \right.
	example=<textarea cols=\'20\' rows=\'1\' class=\'schaersvoorde_textarea\' readonly=\'readonly\'>p < 1.23 </textarea>
	
	varlist=p
    !endif

!endif

applettext=!nospace {vlist($a*x^2+$b*x,p-$c*x,p=?)}->
mathviewpanel=$module_title:p=:sqrt()
formula$n= \left[ \begin{array}{lcl}f(x) = $a_t  x^{2} + $b_t  x  \\  \\ g_{p}(x) = p - $c_t x \end{array} \right.

!if $teaching=1
    insplot_set=size 0.4,0.4;zeroaxis
    !if $a>0
	!insplot $a*x**2+$b*x notitle ,-40-$c*x notitle ,5-$c*x notitle ,40-$c*x notitle 
    !else
	!insplot $a*x**2+$b*x notitle ,100-$c*x notitle ,-5-$c*x notitle ,-40-$c*x notitle 
    !endif
    helptext=<img src=\'$wims_ref_name?&session=$session&module=$module&cmd=getins&special_parm=insert-1.gif\' alt=\'noalt\' /><br />$example
!endif
ss2=!record 42 of lang/remarks.$taal
#@Gegeven is de onderstaande functie <em>f</em>  en de familie van lineaire functies <em>g<sub>p</sub></em>.<br />
question$n=<a onmouseover="return escape('$example')">$ss2</a><br />$ss
