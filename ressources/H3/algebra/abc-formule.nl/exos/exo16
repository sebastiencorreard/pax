n=$counter
!if $level=0
    R=$counter
!else
    R=$level
!endif
math=0
!if $rounding<10
    rounding=0
    !readproc $remarkdir/rounding.$taal
!endif
cols=20
rows=2
embed=1
checkfile=$checkdir/number.proc
arglist=x
varlist=$empty
!if $lang=nl
    example=<textarea cols=\'20\' rows=\'3\' class=\'schaersvoorde_textarea\' readonly=\'readonly\'>x1=23\n en \nx2=-14</textarea>
!else
    example=<textarea cols=\'20\' rows=\'3\' class=\'schaersvoorde_textarea\' readonly=\'readonly\'>x1=23\n and \nx2=-14</textarea>
!endif
text=!record 7 of lang/remarks.$taal
#@ Bepaal de nulpunten,de beide nulpunten zijn,en,het ene nulpunt is
ss=!item 1 of $text
beide=!item 2 of $text
en=!item 3 of $text
ene=!item 4 of $text
question$n=<a onmouseover="return escape('$example')">$ss</a>
#functie=(Cx -A)(x+B)= Cx^2 +xCB -xA -AB = Cx^2 +x(CB-A) -AB
#a= C
#b= CB-A
#c= AB
keus=!randitem 0,1,2

F=!randitem f,g,h

!if $R = 1
    A=!randitem 1,2,3,4
    B=!randitem 1,2,3,4
    D=!randitem 2,3,-1
!else
    !if $R = 2
	A=!randitem 4,5,6,7,8
        B=!randitem 1,2,3
	D=!randitem -1,-2,-3,2,3
    !else
	!if $R = 3
	    A=!randitem 1,2,3,4,5,6,7,8
	    B=!randitem 1,2,3,4,5,6,7,8
	    D=!randitem -1,-2,-3,2,3
	!else
	    A=!randitem 1,2,3,4,5,6,7,8
	    B=!randitem 1,2,3,4,5,6,7,8
	    D=!randitem 1/2,1/3,1/4,1/5
	!endif
    !endif
!endif
!if $keus=0
    functie=$D*(x - $A)*(x + $B)
    tussen=(x - $A)*(x + $B)
    tex=(x - $A)\cdot(x + $B)
    tex2=(x - $A) = 0 \,\,\bigvee\,\, (x + $B) = 0
    x1=$A
    x2=$[-1*$B]
!else
    !if $keus=1
	functie=$D*(x + $A)*(x + $B)
	tussen=(x + $A)*(x + $B)
	tex=(x + $A)\cdot(x + $B)
	tex2=(x + $A) = 0 \,\,\bigvee\,\, (x + $B) = 0
	x1=$[-1*$A]
	x2=$[-1*$B]
    !else
	functie=$D*(x - $A)*(x - $B)
	tussen=(x - $A)*(x - $B)
	tex=(x - $A)\cdot(x - $B)
	tex2=(x - $A) = 0 \,\,\bigvee\,\, (x - $B)=0
	x1=$A
	x2=$B
    !endif
!endif
#betekend er zijn gewoon altijd nulpunten
#extra$n=1
var1=1
tot=!exec pari A=$functie\
G=$tussen\
printtex(A)\
printtex(G)

raw=!line 1 of $tot
keuze=!randitem 1,0
tex_fun=!line 3 of $tot
tussen=!line 4 of $tot

!if $keuze=1
    formula$n=$F\left( x \right)=$tex_fun
    applettext=!nospace $F (x)= $functie ->
!else
    formula$n=y\,\,= $tex_fun
    applettext=!nospace y= $functie ->
!endif
mathviewpanel=$module_title:x_1=:and:x_2=:sqrt()
x1_tex=$x1
x2_tex=$x2

!if $x1 != $x2
    texanswer$n=  \left[ \begin{array}{l}  y = 0 \rightarrow $tex_fun = 0 \\  $D ($tussen) =0 \\ \\ $D $tex =0 \\ $tex2 \\ x_{1}= $x1_tex \,\,\bigvee\,\, x_{2}= $x2_tex\end{array}\right.
    answer$n=$x1,$x2
    punten=$x1,0,$x2,0
    textanswer$n=$beide x1=$x1 $en x2=$x2  
!else
    texanswer$n=  \left[ \begin{array}{l}  y = 0 \rightarrow $tex_Fun = 0 \\$D ($tussen) =0 \\ \\ $D $tex =0 \\ $tex2 \\ x_{1}= $x1_tex \end{array}\right.
    answer$n=$x1
    punten=$x1,0,$x1,0
    textanswer$n=$ene x=$x1
!endif 


!if $teaching=1
    make_tr=0
    xsize=150
    ysize=150
    image_settings$n=200,200
    image$n=\
    transparent white\
    xrange -20,20\
    yrange -100,100\
    vline 0,0,blue\
    hline 0,0,blue\
    linewidth 2\
    curve green,$functie\
    linewidth 6\
    points red,$punten
    
    draw=1
    plot=0
    svg=0
    insdraw_size=$xsize,$ysize
    !insdraw $(image$n)
    helptext=<img src=\'$wims_ref_name?&session=$session&module=$module&cmd=getins&special_parm=insert-1.gif\' alt=\'noalt\' /><hr />$example
!endif
