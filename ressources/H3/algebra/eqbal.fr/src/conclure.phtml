   prov=$tmp3
   tmp3=$tmp5
   tmp5=$prov 
   !if $tmp3!=$tmp1
      !exit
   !endif
!endif
i=0
replygood0=0
test=$empty
reply0=$tmp5
!read anstype/numeric
!if NaN isin $test
   !exit
!endif
tmp6=!exec pari $tmp5


!if $tmp5 notsametext $tmp6
   !exit
!endif

