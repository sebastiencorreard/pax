
$name_instruction
!form reply
<table class="wimscenter wimsborder">
!for i=1 to $rows
  <tr>
  !for j=1 to $cols
    !set t_=$[$j+$cols*($i-1)]
    <td>
    <input size="2" maxlength="2" name="x$t_" value="$(x$t_)" />
    </td>
  !next j
  <th scope="row"><span style="color:blue">$(rowsum$i)</span>
  !if $i iswordof $badrows
    <span style="color:red" class="smaller">$(rowgot$i)</span>
  !endif
  </th>
  </tr>
!next i
<tr>
!for j=1 to $cols
  <th scope="col"><span style="color:blue">$(colsum$j)</span>
  !if $j iswordof $badcols
    <span style="color:red" class="smaller">$(colgot$j)</span>
  !endif
  </th>
!next j
<td><span style="color:blue">
$(n_$kind)
</span></td>
</tr></table>
<div class="wimscenter">
<input type="submit" value="$name_tester" />
</div>
!formend
<div>
<form action="#" name="chrono">
$name_chrono $allow $name_second. <label for="clock">$name_chrono2</label> <input size="4" id="clock" name="clock" /> $name_second.
</form>
</div>
