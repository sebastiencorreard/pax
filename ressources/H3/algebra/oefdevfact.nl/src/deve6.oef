\title{Haakjes wegwerken (a-b)(a+b)#}
\language{nl}
\range{-5..5}
\author{Guerimand Fabrice}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{confparm2=\confparm2=?2}
\integer{confparm1=\confparm2=?1}

\integer{size=6}
\text{size2=40x25x1}
\integer{a=random(2..15)}
\integer{b=random(2..15)}
\integer{b=\a=\b?17}
\text{x=random(x,y,z,a,b)}

\text{lt=wims(values v for v=0 to \confparm1)}
\text{lt=shuffle(\lt)}
\integer{p1=item(1,\lt)}
\integer{p2=item(2,\lt)}
\text{m1=simplify(\a*\x^\p1)}
\text{m2=simplify(\b*\x^\p2)}

\text{lsg=shuffle(+,-)}
\text{sg1=item(1,\lsg)}
\text{sg2=item(2,\lsg)}

\text{list=randrow(\don)}
\text{rep=wims(rawmath (\m1\sg1\m2)(\m1\sg2\m2))}
\text{rep3=slib(commutesom \rep,\x)}
\text{A1=texmath(\m1)}
\text{A2=texmath(\m2)}
\text{A=\A1,\A2}

\text{enonce=texmath(\rep)}

\text{coul=red,green,blue,purple}
\text{coul=shuffle(\coul)}
\text{t1={\special{color=\coul[1]}}}
\text{t0={\special{color=black}}}
\text{t2={\special{color=\coul[2]}}}
\text{t3={\special{color=\coul[3]}}}
\text{t4={\special{color=\coul[4]}}}
\text{po=\char40}
\text{pf=\char41}

\text{enonce1=(\t1 \A[1] \t0 + \t2 \A[2] \t0)(\t1 \A[1]\t0 - \t2 \A[2] \t0 )}

\text{ligne1=<td>\(\enonce1)</td>
<td>=</td>
<td>\(\t1\po \A[1] \pf\t0^2 - \t2\po \A[2] \pf\t0^2) </td>}

\if{\confparm2=1}{
\matrix{type=r1,r2
r3}
}{
\matrix{type=r3}
}

\steps{\type}

\text{affl=item(1,\rep3)}

\statement{<br>
Werk de haakjes weg en schrijf zo eenvoudig mogelijk:  \(\enonce).
<br>
<center><hr width=50%></center>
<table class=reply>
<tr><td>
<u><b>Jouw antwoord :</b></u><br>

\if{\confparm2=1}{
Je moet de opdracht als volgt uitvoeren. Sleep de verschillende onderdelen naar de juiste plek op de vraagtekens. Let op
 de corresponderende kleuren. Gebruik de regel \((a+b)(a-b)=a^2-b^2) : <p>
\if{\step=1}{<small>Gebruik de blauwe vakjes om de berekening af te maken.</small> <p>
   \(\enonce1 = \t1\po\t0) \embed{r1,\size2} \(\t1\pf\t0^2- \t2\po\t0) \embed{r2,\size2} \(\t2\pf\t0^2) 
}{
<table border=0>
<tr>\ligne1</tr>
<tr>
\if{\step=2}{
<td></td>
<td>=</td>
<td colspan=2> \embed{r3,4*\size}</td> 
</tr>
}
</table>
}
}{
\(\enonce = )\embed{r3,4*\size}.
}
</td></tr></table>
}


\answer{Antwoord 1}{\A[1];\A}{type=clickfill}
\answer{Antwoord 2}{\A[2];\A}{type=clickfill}
\answer{Antwoord}{\rep3}{type=litexp}


\solution{
<table border=0>
<tr>\ligne1</tr>
<tr>
   <td></td>
   <td>=</td>
   <td> \(\affl)</td>
</tr>
</table>}