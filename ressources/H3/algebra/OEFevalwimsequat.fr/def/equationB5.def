!set title=Résolution équation B5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=G., Bayle;Fabrice, Guerimand

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
tmp0=!randint $val7+1, 10

val8=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath $val9

val11=$(tmp0)
val12=$val11 $val6 = $val10
tmp=!translate ";': to $     $ in $val10*$val8/$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
val14=noreduction
replytype1=numexp
replyoption1=$val14 
replyname1=Réponse
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

