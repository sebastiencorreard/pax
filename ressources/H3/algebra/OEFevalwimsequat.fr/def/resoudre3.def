!set title=Résoudre 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!shuffle $val6,$val7,$val8

val9=$(tmp0)
tmp0=!listuniq $val9

val9=$(tmp0)
tmp0=!itemcnt $val9

val10=$[rint($(tmp0))]

!ifval $val10<3
tmp0=!shuffle Pierre,Paul,Olivier

val9=$(tmp0)
!endif
tmp=!nonempty items x,y,z

tmp0=!randitem $tmp
val11=$(tmp0)
tmp0=!randint 10, 17

val12=$[rint($(tmp0))]
tmp0=!shuffle 2,3,4

val13=$(tmp0)
val14=$[rint($(val13[1]))]
val15=$[rint($(val13[2]))]
val16=$[rint(3*$val12+$val14-$val15)]
val17=$(val9[1]) a $val14 ans de plus que son frère $(val9[2]) et $(val9[3]) a $val15 ans de moins que $(val9[2]). La somme de leurs âges est l'âge de leur mère qui est de $val16 ans.
val18=Quel est l'âge de $(val9[2])
val19=ans
replytype1=numexp
replyoption1=noreduction 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val17	<div>	$val18 ?	</div>	<label for="reply1"><b>Votre réponse :</b></label>  
!read oef/embed.phtml r1,8 
$() $val19.
$()
!exit

