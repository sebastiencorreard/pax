!set title=Opération à trou 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 10

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
val7=$[rint($(val6[1]))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val8=$[rint($(val6[2])*$(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
!if $val9=1 
val10=
val11=- $val7 = $val8 
tmp=!translate ";': to $     $ in $val8+$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
!else
val10=$val7 + 
val11== $val8 
tmp=!translate ";': to $     $ in $val8-$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
!endif
val13=
val14=Compléter l'opération à trou suivante&nbsp;
replytype1=numexp
replyoption1=$val13 
replyname1=Réponse
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val14	<div class="wimscenter"><label for="reply1">
!insmath $val10
$()</label>  
!read oef/embed.phtml r1,5 
$() 
!insmath $val11
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

