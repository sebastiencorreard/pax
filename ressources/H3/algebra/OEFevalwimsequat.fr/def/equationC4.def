!set title=Résolution équation C4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=G., Bayle;Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath -$val7*$val6 - $val8 = $val9

val10=$(tmp0)
tmp=!translate ";': to $     $ in ($val9+$val8)/(-$val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
val12=noreduction
replytype1=numexp
replyoption1=$val12 
replyname1=Réponse
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Quelle est la solution de l'équation suivante :	<div class="wimscenter">
!insmath $val10
$()</div>	<div><b>Votre réponse :</b>	  La solution de cette équation est  
!read oef/embed.phtml r1,7 
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=1
