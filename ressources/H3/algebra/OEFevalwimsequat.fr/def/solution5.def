!set title=Solution d'une équation 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!values v,-v for v=2 to 10

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
val8=$[rint(2)]
tmp=!nonempty items $(val7[1])*$val6^2+$(val7[2]),$(val7[2])+$(val7[1])*$val6^2

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$(val7[1])*($val6)^2+$(val7[2])
tmp=!nonempty items 1,-1,3,-3,2,-2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
evaltmp=$val10

evaltmp=!mathsubst $val6=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[rint($(tmp0))]
evaltmp=$val10-$(val7[3])*$val6

evaltmp=!mathsubst $val6=($val11) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]

!ifval $val8=1
val13=$[rint($val13)]
!else
val13=$[rint($val13+$(val7[5]))]
!endif
tmp=!nonempty items $(val7[3])*$val6+$val13,$val13+$(val7[3])*$val6

tmp0=!randitem $tmp
val13=$(tmp0)
evaltmp=$val13

evaltmp=!mathsubst $val6=($val11) in $evaltmp
tmp0=($evaltmp)
val14=$[rint($(tmp0))]
tmp0=!texmath $val13

val13=$(tmp0)
val15=$val9 = $val13
val16=Oui&#44; $val11 est solution de l'équation,Non&#44; $val11 n'est pas solution de l'équation
replytype1=numexp
replyname1=
replygood1=$val12
replytype2=numexp
replyname2=
replygood2=$val14
replytype3=radio
replyoption3=noreduction 
replyname3=Réponse
replygood3=$val8;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Soit l'équation :	<div class="wimscenter">
!insmath $val15
$()</div>	<ul><li>	  Évaluer les deux membres de cette équation pour $val6 = $val11.	</li><li>	  Indiquer ensuite si $val11 est solution de l'équation.	</li></ul>	<b>Votre réponse :</b>	<ul>	 <li> Pour $val6 = $val11, <label for="reply1">le membre de gauche vaut</label>  
!read oef/embed.phtml r1,5 
$().</li>	 <li> Pour $val6 = $val11, <label for="reply1">le membre de droite vaut</label>  
!read oef/embed.phtml r2,5 
$().</li>	</ul>	 <blockquote>	 <div> 
!read oef/embed.phtml r3,1 
$()</div>	 <div> 
!read oef/embed.phtml r3,2 
$()</div>	</blockquote>
$()
!exit

