!set title=Opération à trou 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v for v=2 to 10

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
val7=$[rint($(val6[1]))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val8=$[rint($(val6[2])*$(tmp0))]
val8=$[rint(abs($val8))]
val9=$val7 \div 
val10== $val8 
tmp=!translate ";': to $     $ in $val7/($val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
val12=noreduction
val13=Compléter l'opération à trou suivante&nbsp;
replytype1=numexp
replyoption1=$val12 
replyname1=Réponse
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val13	<div class="wimscenter"><label for="reply1">
!insmath $val9
$()</label>  
!read oef/embed.phtml r1,5 
$() 
!insmath $val10
$().</div>
$()
!exit

