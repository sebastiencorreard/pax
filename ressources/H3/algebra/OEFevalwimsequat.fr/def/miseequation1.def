!set title=Mettre en équation 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
keywords=pbsolving

ansorder=r
varcnt=18
prevarcnt=14
postvarcnt=3
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!shuffle $val6,$val7,$val8

val9=$(tmp0)
tmp0=!listuniq $val9

val9=$(tmp0)
tmp0=!itemcnt $val9

val10=$[rint($(tmp0))]

!ifval $val10<3
tmp0=!shuffle Pierre,Paul,Olivier

val9=$(tmp0)
!endif
tmp=!nonempty items x,y,z

tmp0=!randitem $tmp
val11=$(tmp0)
tmp0=!randint 75, 125

val12=$[rint($(tmp0))]
tmp0=!randint 12, 24

val13=$[rint($(tmp0))]
tmp0=!randint 25, $val12-25

val14=$[rint($(tmp0))]
val15=$[rint(3*$val12+$val13-$val14)]
val16=$(val9[1]), $(val9[2]) et $(val9[3]) se sont partagés $val15 euros. $(val9[1]) a pris $val13 euros de plus que $(val9[2]) et $(val9[3]) en a $val14 de moins que $(val9[2]). Combien chacun a-t-il pris &#63;
val17=Soit \($val11\) la quantité d'argent prise par $(val9[2]). Quelle équation doit vérifier \($val11\)
replytype1=auto

replyname1=
replygood1=?analyze 18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici un problème :	<p class="bold">$val16</p>	<p>$val17 ?</p>	<div class="wimscenter"> 
