$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
t_=!replace internal \( by ( in SOLVE($val18,$val11);
tmp0=!exec maxima $t_

val19=$(tmp0)
tmp0=!replace internal = by , in $val19

val19=$(tmp0)
val19=$(val19[2])

!exit

:feedback

!exit

:test

!ifval $val12=$val19
 condtest1=1
!else
 condtest1=0
!endif
condname1=Equation correcte

!exit

:stat
