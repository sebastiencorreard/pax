!set title=Résolution équation A1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=G., Bayle;Fabrice, Guerimand

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!randint 1, 100

val7=$[rint($(tmp0))]
tmp0=!randint 1, 100

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
val9=$val6 + $val7 = $val8
tmp=!translate ";': to $     $ in $val8-$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
val11=
replytype1=numexp
replyoption1=$val11 
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Quelle est la solution de l'équation suivante :	<div class="wimscenter">
!insmath $val9
$()</div>	<div><b>Votre réponse :</b>	  La solution de cette équation est  
!read oef/embed.phtml r1,7 
$().	</div>
$()
!exit

