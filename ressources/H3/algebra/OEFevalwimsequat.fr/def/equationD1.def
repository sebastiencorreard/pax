!set title=Résolution équation D1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!values v for v=1 to 10

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=$[rint(1)]
val9=$[rint(1)]
val10=$[rint(1)]
val11=$[rint(1)]
val12=$[rint($(val7[1])*$val8)]
val13=$[rint($(val7[2])*$val9)]
val14=$[rint($(val7[3])*$val10)]
val15=$[rint($(val7[4])*$val11)]
tmp0=!texmath $val12*$val6+$val13

val16=$(tmp0)
tmp0=!texmath $val14*$val6+$val15

val17=$(tmp0)
tmp0=!shuffle $val16,$val17

val18=$(tmp0)
val19=$(val18[1]) = $(val18[2])
tmp=!translate ";': to $     $ in (($val15)-($val13))/(($val12)-($val14))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=Réponse
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Quelle est la solution de l'équation suivante :	<div class="wimscenter">
!insmath $val19
$()</div>	<b>Votre réponse :</b>	<div><label for="reply1">La solution de cette équation est</label>  
!read oef/embed.phtml r1,7 
$().</div>
$()
!exit

