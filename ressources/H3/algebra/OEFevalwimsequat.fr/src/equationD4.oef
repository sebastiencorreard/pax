\title{Résolution équation D4}
\text{x=x}
\text{ch=wims(values v for v=1 to 10)}
\text{ch=shuffle(\ch)}

 \integer{sga=-1}
 \integer{sgb=-1}
 \integer{sgc=1}
 \integer{sgd=1}

\integer{a=\ch[1]*\sga}
\integer{b=\ch[2]*\sgb}
\integer{c=\ch[3]*\sgc}
\integer{d=\ch[4]*\sgd}
