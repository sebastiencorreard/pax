 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=atomic number, symbol,name,atomic mass in \(u\)
val8=In the emptied periodic table of elements below,	  click in the box for the element whose
val9=is
val10=The position
val11=You have clicked in the box of,instead of
!if $val6=fr 
val7=le numéro atomique, le symbole, le nom, la masse atomique en \(u\)
val8=Dans le tableau périodique des éléments qui n'est pas rempli,	  cliquez sur la case pour l'élément dont 
val9=est
val10=La position
val11=Vous avez cliqué sur la case,au lieu de
!endif
!if $val6=nl 
val7=atoom nummer, symbool,naam,atoomgewicht
val8=In het leeg gemaakte "<em>periodiek systeem der elementen</em>" hieronder,	  moet je klikken op de plaats van het element waarvoor geldt
val9=is
val10=De positie
val11=Je hebt geklikt op de plaats van,in plaats van
!endif
tmp0=!record 0 of table.$val6

val12=$(tmp0)

!ifval $val12=
tmp0=!record 0 of table

val12= $(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val12

tmp0=!rowcnt $tmp
val13=$[rint($(tmp0))]

!ifval $val2 notitemof 1,2,3,4
val2=$[rint(0)]
!endif

!ifval $val3 notitemof 1,2,3,4
val3=$[rint(0)]
!endif
val14=

!ifval $val4 issametext $val14 or $val4<7 or	  $val4>$val13
val4=$[rint(54)]
!endif
tmp0=!values x for x=1 to $val13

val15=$(tmp0)
tmp0=!listintersect $val5 and $val15

val5=$(tmp0)

!ifval $val2>0
val16=$[rint($val2)]
!else
tmp0=!randint 1, 4

val16=$[rint($(tmp0))]
!endif

!ifval $val3=$val2
val17=$[rint(0)]
!else
val17=$[rint($val3)]
!endif
tmp0=!listcomplement $val16 in 1,2,3,4

val18=$(tmp0)

!ifval \candouble issametext yes and $val16 != 1
val18=$val16,$val18
!endif

!ifval $val17>0 and $val17 isitemof $val18
val19=$[rint($val17)]
!else
tmp=!nonempty items $val18

tmp0=!randitem $tmp
val19=$[rint($(tmp0))]
!endif
tmp0=!record 0 of table.$val6

val20=$(tmp0)

!ifval $val20=$val14
tmp0=!record 0 of table

val20= $(tmp0)
!endif
val12=$val20
val14=
!if $val5 notsametext $val14 and \selective notsametext no 
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val12

tmp=!column 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
tmp=!translate internal $	$ to ; in $val12

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
tmp=!translate internal $	$ to ; in $val12

tmp0=!rowcnt $tmp
val23=$[rint(min($val4,$(tmp0)))]
tmp0=!record 0 of position

val24=$(tmp0)
val25=$val24
val14=
!if $val5 notsametext $val14 and \selective notsametext no 
tmp=!translate internal $	$ to ; in $val25

tmp=!row $val5 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val25=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val25

tmp=!column 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
tmp=!translate internal $	$ to ; in $val25

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
tmp=!translate internal $	$ to ; in $val25

tmp0=!rowcnt $tmp
val26=$[rint(min($val4,$(tmp0)))]

!ifval $val16 isitemof 2,3
val27=$[rint($val16)]
!else
tmp=!nonempty items 2,3

tmp0=!randitem $tmp
val27=$[rint($(tmp0))]
!endif
tmp0=!randint 1, $val23

val28=$[rint($(tmp0))]
val29=$(val12[$val28;])
tmp0=!item 1 of $val29

val28=$[rint($(tmp0))]
val30=$[rint(30)]
val31=$[rint(30)]
tmp=!translate internal $	$ to ; in $val24

tmp=!column 4 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val32=$(tmp0)
tmp=!translate internal $	$ to ; in $val24

tmp=!column 3 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val33=$(tmp0)
val34=
!for val35 =1 to $val13 
val36=$[rint($(val32[$val35])*$val30)]
val37=$[rint($(val33[$val35])*$val31)]

!ifval $(val33[$val35])>8
val37=$[rint($val37+5)]
!endif

!ifval $(val33[$val35])>8
val36=$[rint($val36+$val30*2)]
!endif
val34=$val34 r,$val36,$val37,$val36+$val30,$val37+$val31;
!if $val35=$val28 
val38=r,$val36,$val37,$val36+$val30,$val37+$val31
!endif
!next
val39=$(val29[$val27])
val40=$(val20[;$val27])
replytype1=coord
replyname1=$val10
replygood1=$val1/table2.gif;$val38;$val34
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

