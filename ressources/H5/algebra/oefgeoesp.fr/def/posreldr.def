!set title=Position relative de deux droites
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,1]);print(M)
tmp0=!exec pari $t_

val8=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,2]);print(M)
tmp0=!exec pari $t_

val9=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,3]);print(M)
tmp0=!exec pari $t_

val10=$(tmp0)
tmp0=!randint 2, 5

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in [$val7]+$val11*[$val8]
tmp0=!exec pari $t_

val12=$(tmp0)
t_=!replace internal \( by ( in [$val7]+$val11*[$val8]+[$val10]
tmp0=!exec pari $t_

val13=$(tmp0)
t_=!replace internal \( by ( in $(val7[1])+u*$(val8[1])
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val7[2])+u*$(val8[2])
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val7[3])+u*$(val8[3])
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
tmp0=!randint 1, 3

val17=$[rint($(tmp0))]
val18=sécantes,parallèles,non coplanaires
!if $val17=1 
t_=!replace internal \( by ( in $(val12[1])+v*$(val9[1])
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val12[2])+v*$(val9[2])
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val12[3])+v*$(val9[3])
tmp0=!exec maxima $t_

val21=!rawmath $(tmp0)
!endif
!if $val17=2 
tmp0=!randitem -1,1

tmp1=!randint 2, 5

val11=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $(val13[1])+v*$val11*$(val8[1])
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val13[2])+v*$val11*$(val8[2])
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val13[3])+v*$val11*$(val8[3])
tmp0=!exec maxima $t_

val21=!rawmath $(tmp0)
!endif
!if $val17=3 
t_=!replace internal \( by ( in $(val13[1])+v*$(val9[1])
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val13[2])+v*$(val9[2])
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val13[3])+v*$(val9[3])
tmp0=!exec maxima $t_

val21=!rawmath $(tmp0)
!endif
tmp0=!texmath $val14

val22=$(tmp0)
tmp0=!texmath $val15

val23=$(tmp0)
tmp0=!texmath $val16

val24=$(tmp0)
tmp0=!texmath $val19

val25=$(tmp0)
tmp0=!texmath $val20

val26=$(tmp0)
tmp0=!texmath $val21

val27=$(tmp0)
replytype1=menu
replyname1=xu
replygood1=$val17;$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère les droites 
!insmath d
$() et 
!insmath d'
$() paramétrées respectivement par	<div class="wimscenter">	
!insmath (d) \left \lbrace \begin{matrix}	x&=&$val22\\	y&=&$val23\\	z&=&$val24\end{matrix}	\right .	
$() et	
!insmath (d') \left \lbrace \begin{matrix}x&=&$val25 \\	y&=&$val26 \\	z&=&$val27\end{matrix}	\right . 
$()	</div>	Les droites 
!insmath d
$() et 
!insmath d'
$() sont  
!read oef/embed.phtml reply 1 
$().	
$()
!exit

:hint
$()<ul><li>	Si ces droites sont parallèles, leurs vecteurs directeurs sont colinéaires.	</li><li>Si elles sont sécantes, il existe des valeurs de 
!insmath u
$() et 
!insmath v
$() telles	que 
!insmath x=x',y=y'
$() et 
!insmath z=z'
$().	</li><li>	Sinon, elles sont non coplanaires.	</li></ul>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=22,23,24,25,26,27
embedcnt=1
