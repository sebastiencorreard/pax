!set title=Point sur un plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=13
prevarcnt=11
postvarcnt=1
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,1]);print(M)
tmp0=!exec pari $t_

val8=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,2]);print(M)
tmp0=!exec pari $t_

val9=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,3]);print(M)
tmp0=!exec pari $t_

val10=$(tmp0)
t_=!replace internal \( by ( in u=[$val8];v=[$val9];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val11=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in [$val7]*mattranspose([$val11])
tmp0=!exec pari $t_

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in ordergreat(x,y,z,t)
tmp0=!exec maxima $t_

val13=$(tmp0)
t_=!replace internal \( by ( in $(val11[1])*x
tmp0=!exec maxima $t_

t_=!replace internal \( by ( in $(val11[2])*y
tmp1=!exec maxima $t_

t_=!replace internal \( by ( in $(val11[3])*z
tmp2=!exec maxima $t_

val14=!rawmath $(tmp0)+$(tmp1)+$(tmp2)
t_=!replace internal \( by ( in $val14
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!rawmath 
val15=!exec pari print($t_)
replytype1=default
replyname1=x
replygood1=?analyze 16
replytype2=default
replyname2=y
replygood2=?analyze 17
replytype3=default
replyname3=z
replygood3=?analyze 18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer les coordonnées d'un point	
!insmath M
$() situé sur le plan 
!insmath P
$() d'équation 
!insmath $val14=$val12
$().	<div class="spacer">	Le point 
!insmath M
$() ( 
!read oef/embed.phtml reply 1,5 
$(), 
!read oef/embed.phtml reply 2,5 
$(),  
!read oef/embed.phtml reply 3,5 
$())	est situé sur le plan 
!insmath P
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
t_=!replace internal \( by ( in [$val16,$val17,$val18]*mattranspose([$val11])
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val15=!exec pari print($t_)

!exit

:feedback

!exit

:test

!ifval $val15=$val12
 condtest1=1
!else
 condtest1=0
!endif
condname1=Test

!exit

:stat
vsavelist=11,12,14,15,16,17,18
embedcnt=3
