!set title=Intersection de deux plans
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r
varcnt=19
prevarcnt=12
postvarcnt=6
replycnt=6
choicecnt=0
conditioncnt=4
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,1]);print(M)
tmp0=!exec pari $t_

val8=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,2]);print(M)
tmp0=!exec pari $t_

val9=$(tmp0)
t_=!replace internal \( by ( in u=[$val8];v=[$val9];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val10=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in [$val7]*mattranspose([$val8])
tmp0=!exec pari $t_

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in [$val7]*mattranspose([$val9])
tmp0=!exec pari $t_

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in ordergreat(x,y,z,t)
tmp0=!exec maxima $t_

val13=$(tmp0)
t_=!replace internal \( by ( in $(val8[1])*x+$(val8[2])*y+$(val8[3])*z
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val9[1])*x+$(val9[2])*y+$(val9[3])*z
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!texmath $val14

val14=$(tmp0)
tmp0=!texmath $val15

val15=$(tmp0)
replytype1=default
replyname1=xA
replygood1=?analyze 16
replytype2=default
replyname2=yA
replygood2=?analyze 17
replytype3=default
replyname3=zA
replygood3=?analyze 18
replytype4=default
replyname4=xu
replygood4=?analyze 19
replytype5=default
replyname5=yu
replygood5=?analyze 20
replytype6=default
replyname6=zu
replygood6=?analyze 21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère les plans 
!insmath P_1
$() et 
!insmath P_2
$() d'équations respectives 	<div class="wimscenter">
!insmath $val14=$val11
$() et 	
!insmath $val15=$val12
$()</div>	On se propose de déterminer l'intersection de ces deux plans.	<div class="spacer">	L'intersection de ces deux plans est la droite 
!insmath d
$() passant par le point	<div class="wimscenter">
!insmath A
$() ( 
!read oef/embed.phtml reply 1,5 
$(), 
!read oef/embed.phtml reply 2,5 
$(), 
!read oef/embed.phtml reply 3,5 
$())</div>	et dirigée par le vecteur	<div class="wimscenter">	
!insmath \overrightarrow{u} 
$()( 
!read oef/embed.phtml reply 4,5 
$(), 
!read oef/embed.phtml reply 5,5 
$(), 
!read oef/embed.phtml reply 6,5 
$()).	</div>	</div>	
$()
!exit

