keywords=plane_equation,equation,distance,normal_vector
computeanswer=yes
precision=100000
oefobservation=Au moins l'une des coordonnées du vecteur normal est nulle, avec une probabilité égale à 0.5.

ansorder=r
varcnt=39
prevarcnt=38
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
