tmp0=!exec pari $t_

val10=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val11=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in [$val7]+$val11*[$val10]
tmp0=!exec pari $t_

val12=$(tmp0)
t_=!replace internal \( by ( in u=[$val8];v=[$val9];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in [$val7]*mattranspose([$val13])
tmp0=!exec pari $t_

val14=$[rint($(tmp0))]
t_=!replace internal \( by ( in $(val13[1])*x+$(val13[2])*y+$(val13[3])*z
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!randint 1, 4

val16=$[rint($(tmp0))]
!if $val16=1 
val17=$val8
!endif
!if $val16=2 
val17=$val13
!endif
!if $val16=3 
t_=!replace internal \( by ( in matrank([$val13;$val10])
tmp0=!exec pari $t_

val18=$[rint($(tmp0))]
!if $val18=1 
t_=!replace internal \( by ( in [$val10]+[$val8]
tmp0=!exec pari $t_

val10=$(tmp0)
!endif
val17=$val10
!endif
!if $val16=4 
val12=$val7
val17=$val9
!endif
val19=strictement parallèle au, orthogonale au, sécante et non orthogonale au,contenue dans le
