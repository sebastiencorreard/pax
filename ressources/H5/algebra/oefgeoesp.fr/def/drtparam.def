!set title=Exploiter l'équation paramétrique d'une droite
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
keywords=line_equation,solid_geometry,vectors,directing_vector
email=communaute.mutuwims@laposte.net
language=fr
oefobservation=Demande les coordonnées d'un point ou d'un vecteur directeur. 
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r
varcnt=33
prevarcnt=26
postvarcnt=6
replycnt=6
choicecnt=0
conditioncnt=3
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];M=matrix(1,3,i,j,A[j,1]);print(M)
tmp0=!exec pari $t_

val8=$(tmp0)
tmp0=!shuffle 1,2,3

val9=$(tmp0)
!if $(val9[1])=1 
tmp0=!replace internal $(val7[$(val9[1])]) by 0 in $val7

val7=$(tmp0)
tmp0=!replace internal $(val7[$(val9[2])]) by 1 in $val7

val7=$(tmp0)
!endif
!if $(val9[1])=2 
tmp0=!replace internal $(val8[$(val9[1])]) by 0 in $val8

val8=$(tmp0)
tmp0=!replace internal $(val8[$(val9[2])]) by 1 in $val8

val8=$(tmp0)
!endif
t_=!replace internal \( by ( in $(val7[1])+t*$(val8[1])
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val7[2])+t*$(val8[2])
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in $(val7[3])+t*$(val8[3])
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!texmath $val10

val13=$(tmp0)
tmp0=!texmath $val11

val14=$(tmp0)
tmp0=!texmath $val12

val15=$(tmp0)
t_=!rawmath 
val16=!exec pari print($t_)
t_=!rawmath 
val17=!exec pari print($t_)
t_=!rawmath 
val18=!exec pari print($t_)
tmp0=!randint -2, 2

val19=$[rint($(tmp0))]
evaltmp=$val10

evaltmp=!mathsubst t=($val19) in $evaltmp
tmp0=($evaltmp)
val20=$[rint($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst t=($val19) in $evaltmp
tmp0=($evaltmp)
val21=$[rint($(tmp0))]
evaltmp=$val12

evaltmp=!mathsubst t=($val19) in $evaltmp
tmp0=($evaltmp)
val22=$[rint($(tmp0))]
tmp0=!replace internal , by ; in $val8

tmp=!trim $(tmp0)
val23=!translate internal $	\
$ to ;; in $tmp
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val24=$[rint($(tmp0))]
!if $val24=1 
val25=1,2
!else
val25=3
!endif

!ifval $val24=1
val26=reply 1,reply 2, reply 3
!else
val26=reply 4,reply 5, reply 6
!endif
oefsteps=$val26 
nextstep=!nosubst $val26 
!readproc oef/steps.proc
replytype1=default
replyoption1=noanalyzeprint 
replyname1=xu
replygood1=?analyze 27
replytype2=default
replyoption2=noanalyzeprint 
replyname2=yu
replygood2=?analyze 28
replytype3=default
replyoption3=noanalyzeprint 
replyname3=zu
replygood3=?analyze 29
replytype4=default
replyoption4=noanalyzeprint 
replyname4=xB
replygood4=?analyze 30
replytype5=default
replyoption5=noanalyzeprint 
replyname5=yB
replygood5=?analyze 31
replytype6=default
replyoption6=noanalyzeprint 
replyname6=zB
replygood6=?analyze 32
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la droite 
!insmath (d)
$() paramétrée par	<div class="wimscenter">	
!insmath \left \lbrace \begin{matrix} x&=&$val13\\	y&=&$val14\\	z&=&$val15 \end{matrix}\right .
$()	</div>	
!if $val24=1 
$()	<div class="wims_question">	Donnez les coordonnées d'un vecteur directeur 
!insmath \overrightarrow{u}
$() de cette droite.	<div class="wimscenter">	On a 	 
!read oef/special.phtml mathmlinput [\overrightarrow{u} =\left( \begin{matrix} reply1\\	reply2\\	reply3 \end{matrix} \right)],5,noanswer	reply 1	reply 2	reply 3 
$()	</div></div> 
!endif
$()	
!if $val24=2 
$()	<div class="wims_question">	Donner les coordonnées d'un point 
!insmath B
$() qui appartient à 
!insmath (d)
$() <br>	<div class="wimscenter">	On a 
!insmath B 
$()( 
!read oef/embed.phtml reply 4,5 
$(); 
!read oef/embed.phtml reply 5,5 
$(); 
!read oef/embed.phtml reply 6,5 
$()).	</div></div> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp=!trim $val27,$val28,$val29
val33=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $val30,$val31,$val32
val34=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal , by ; in $val33

tmp=!trim $(tmp0)
val35=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in [$val33]*mattranspose([$val33])
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
t_=!replace internal \( by ( in M=[$val33;$val8];r=matrank(M);print(r)
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val17=!exec pari print($t_)

!ifval ($(val34[1])=$(val7[1]) and $(val34[2])=$(val7[2]) and $(val34[3])=$(val7[3])) or (($(val34[1])-$(val7[1]))/$(val8[1])=($(val34[2])-$(val7[2]))/$(val8[2]) and ($(val34[3])-$(val7[3]))/$(val8[3])=($(val34[2])-$(val7[2]))/$(val8[2]))
val36=$[rint(1)]
!else
val36=$[rint(0 )]
!endif

!exit

:feedback
!ifval ($val16 = 0 or $val17<>1) and $val24=1 
 <div class='oef_feedbacks'>	<div class="feedback">	
!if $val16 = 0 
$()Le vecteur 
!insmath \overrightarrow{u}
$() est le vecteur nul. Il ne peut donc pas être un vecteur directeur.<br> 
!endif
$()	
!if $val17<>1 
$()Le vecteur 
!insmath [$val35]
$() que vous avez donné n'est pas un vecteur directeur.	<br> Le vecteur 
!insmath \overrightarrow{u}
$()
!insmath [$val23] 
$() en est un.	<br> Les deux vecteurs ne sont pas colinéaires. 
!endif
$()	</div>	
$()</div>
!endif
!ifval $val36<>1 and $val24=2
 <div class='oef_feedbacks'>	<div class="feedback">	Le point de coordonnées 
!insmath \left( $val30;$val31;$val32 \right)
$() n'appartient pas à la droite.	<br>Pour obtenir les coordonnées d'un point de la droite, on choisit un nombre 
!insmath t
$() et on calcule les coordonnées 
!insmath x
$(), 
!insmath y
$() et 
!insmath z
$().	<p><u>Par exemple:</u> pour 
!insmath t=$val19
$() on obtient 
!insmath \left( $val20;$val21;$val22 \right)
$().</p>	</div>	
$()</div>
!endif
!ifval ($val16 <> 0 and $val17=1) or ($val36=1) 
 <div class='oef_feedbacks'>	<div class="feedback">	Bravo bonne réponse !	</div>	
$()</div>
!endif

!exit

:test

condlist=$val25
condweight1=1 
condoption1=hide 

!ifval $val16 <> 0
 condtest1=1
!else
 condtest1=0
!endif
condname1=u est non nul
condweight2=1 
condoption2=hide 

!ifval $val17=1
 condtest2=1
!else
 condtest2=0
!endif
condname2=u est parallèle à P2
condweight3=1 
condoption3=hide 

!ifval $val36=1
 condtest3=1
!else
 condtest3=0
!endif
condname3=B appartient à la droite 

!exit

:stat
vsavelist=7,8,13,14,15,16,17,19,20,21,22,23,24,25,27,28,29,30,31,32
embedcnt=4
