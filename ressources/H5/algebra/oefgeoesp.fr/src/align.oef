\title{Problème d'alignement}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{cA=slib(matrix/random 1,3,5)}
\text{cu=slib(matrix/givenrank 1,3,1,5)}
\matrix{cB=pari([\cA]+[\cu])}
\integer{k=random(-1,1)*randint(1..5)}
\matrix{cC=pari([\cA]+\k*[\cu])}
\integer{al=random(1..3)}
\text{var=item(\al,x,y,z)}

\if{\al=1}{
\text{xC=x}
\integer{yC=\cC[2]}
\integer{zC=\cC[3]}
}

\if{\al=2}{
\integer{xC=\cC[1]}
\text{yC=y}
\integer{zC=\cC[3]}
}

\if{\al=3}{
\integer{xC=\cC[1]}
\integer{yC=\cC[2]}
\text{zC=z}
}

\integer{val=\cC[\al]}

\statement{Pour quelle valeur de \var les points \(A(\cA)), \(B(\cB)) et \(C(\xC,\yC,\zC))
sont-ils alignés ?
<div>
Ces points sont alignés pour la valeur \(\var=) \embed{reply 1,5}.
</div>
}

\answer{Valeur}{\val}{type=default}
