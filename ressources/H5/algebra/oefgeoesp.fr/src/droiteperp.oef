\title{Paramétrisation d'une droite}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}
u est un vecteur directeur de d, qui passe par A.

\function{px=maxima(\A[1]+t*\u[1])}
\function{py=maxima(\A[2]+t*\u[2])}
\function{pz=maxima(\A[3]+t*\u[3])}
\text{pxtex=texmath(\px)}
\text{pytex=texmath(\py)}
\text{pztex=texmath(\pz)}
\rational{tu1=}
\rational{tu2=}
\rational{tB1=}

\rational{v1=\u[2]}
\rational{v2=-\u[1]}
\rational{v3=0}

\steps{
reply 1,reply2, reply 3
reply 4,reply 5, reply 6
}

\statement{On considère la droite \(d) paramétrée par
<div class="wimscenter">
\(\left \lbrace \begin{matrix} x&=&\pxtex\\
y&=&\pytex\\
z&=&\pztex \end{matrix}\right .\)
</div>
\if{\step=1}{
Déterminer un vecteur directeur \(\overrightarrow{u}) de cette droite.
<div class="wimscenter">
On a \(\overrightarrow{u}=)(\embed{reply 1,5},\embed{reply 2,5},\embed{reply 3,5}).
</div>
}
\if{\step=2}{
Soit \(A=(\A)) un point de \(d). Déterminer les coordonnées
d'un point \(B) tel que les droites \(AB) et (d) soient perpendiculaires.<br>
<div class="wimscenter">
On a \(B=)(\embed{reply 4,5},\embed{reply 5,5},\embed{reply 6,5}).
</div>
}
}



\answer{xu}{\rep1}{type=default}
\answer{yu}{\rep2}{type=default}
\answer{zu}{\rep3}{type=default}
\answer{xB}{\rep4}{type=default}
\answer{yB}{\rep5}{type=default}
\answer{zB}{\rep6}{type=default}

\matrix{vu=\rep1,\rep2,\rep3}
\matrix{vB=\rep4,\rep5,\rep6}

\rational{tu1=pari([\vu]*mattranspose([\vu]))}
\rational{tu2=pari(M=[\vu;\u];r=matrank(M);print(r))}
\rational{tB1=pari(([\vB]-[\A])*mattranspose([\u]))}

\integer{tAB=(\rep4-\A[1])^2+(\rep5-\A[2])^2+(\rep6-\A[3])^2}

\condition{u est non nul}{\tu1 <> 0}{weight=1}
\condition{u est parallèle à P2}{\tu2=1}{weight=1}
\condition{AB est perpendiculaire à d}{\tB1=0}{weight=1}
\condition{AB différente de 0}{\tAB <>0}{weight=10}

\hint{On pourra déterminer une équation du plan perpnediculaire à \(d), passant par \(A).}
