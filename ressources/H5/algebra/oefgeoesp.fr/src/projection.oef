\title{Projection d'un point sur un plan}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}


\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}
\text{w=pari(A=[\M];M=matrix(1,3,i,j,A[j,3]);print(M))}

\text{B=pari([\A]+[\u])}
\integer{k=random(-1,1)*randint(1..4)}
\matrix{n=pari(u=[\u];v=[\v];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M))}
\text{P=pari([\A]+\k*[\n])}

\integer{d=pari([\A]*mattranspose([\n]))}

\text{equ=maxima(\n[1]*x+\n[2]*y+\n[3]*z)}
\text{equ=texmath(\equ)}

\statement{On considère le plan \(P) d'équation \(\equ)\({}=\d\) et le point \(M(\P)\).
On note \(H) le projeté orthogonal de \(M) sur le plan \(P).
Déterminer les coordonnées du point \(H).
<div class="spacer">
Le point \(H) a pour coordonnées (\embed{reply 1,5},\embed{reply 2,5},\embed{reply 3,5}).
</div>
}

\answer{xI}{\A[1]}{type=default}
\answer{yI}{\A[2]}{type=default}
\answer{zI}{\A[3]}{type=default}

\hint{Le projeté orthogonal de \(M) sur le plan \(P) est l'intersection de ce plan et de la droite perpendiculaire à \(P),
passant par \(M).}
