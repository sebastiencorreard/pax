\title{Position relative de deux droites}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}
\text{w=pari(A=[\M];M=matrix(1,3,i,j,A[j,3]);print(M))}

\integer{k=randint(2..5)}

\text{B=pari([\A]+\k*[\u])}
\text{C=pari([\A]+\k*[\u]+[\w])}
d1 passe par A est est dirigée par u
d2 passe par B est est dirigée par v
d3 passe par C est est dirigée par w
de sorte que d1 et d2 sont sécantes, tandis que s1 et d3 sont non-coplanaires

\function{px=maxima(\A[1]+u*\u[1])}
\function{py=maxima(\A[2]+u*\u[2])}
\function{pz=maxima(\A[3]+u*\u[3])}

\integer{al=random(1..3)}

\text{position=sécantes,parallèles,non coplanaires}

\if{\al=1}{
\function{px2=maxima(\B[1]+v*\v[1])}
\function{py2=maxima(\B[2]+v*\v[2])}
\function{pz2=maxima(\B[3]+v*\v[3])}
}

\if{\al=2}{
\integer{k=random(-1,1)*randint(2..5)}
\function{px2=maxima(\C[1]+v*\k*\u[1])}
\function{py2=maxima(\C[2]+v*\k*\u[2])}
\function{pz2=maxima(\C[3]+v*\k*\u[3])}
}

\if{\al=3}{
\function{px2=maxima(\C[1]+v*\v[1])}
\function{py2=maxima(\C[2]+v*\v[2])}
\function{pz2=maxima(\C[3]+v*\v[3])}
}

\text{pxtex=texmath(\px)}
\text{pytex=texmath(\py)}
\text{pztex=texmath(\pz)}
\text{px2tex=texmath(\px2)}
\text{py2tex=texmath(\py2)}
\text{pz2tex=texmath(\pz2)}

\statement{On considère les droites \(d) et \(d') paramétrées respectivement par
<div class="wimscenter">
\((d) \left \lbrace \begin{matrix}
x&=&\pxtex\\
y&=&\pytex\\
z&=&\pztex\end{matrix}
\right .
\) et
\((d') \left \lbrace \begin{matrix}x&=&\px2tex \\
y&=&\py2tex \\
z&=&\pz2tex\end{matrix}
\right . \)
</div>
Les droites \(d) et \(d') sont \embed{reply 1}.
}

\answer{xu}{\al;\position}{type=menu}

\hint{<ul><li>
Si ces droites sont parallèles, leurs vecteurs directeurs sont colinéaires.
</li><li>Si elles sont sécantes, il existe des valeurs de \(u) et \(v) telles
que \(x=x',y=y') et \(z=z').
</li><li>
Sinon, elles sont non coplanaires.
</li></ul>
}
