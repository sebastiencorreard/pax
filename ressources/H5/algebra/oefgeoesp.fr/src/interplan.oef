\title{Intersection de deux plans}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}
u et v sont normaux aux plans P1 et P2

\matrix{n=pari(u=[\u];v=[\v];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M))}

Le vecteur n est un vecteur directeur de d

\integer{d1=pari([\A]*mattranspose([\u]))}
\integer{d2=pari([\A]*mattranspose([\v]))}

\text{vide=maxima(ordergreat(x,y,z,t))}

\function{equ1=maxima(\u[1]*x+\u[2]*y+\u[3]*z)}
\function{equ2=maxima(\v[1]*x+\v[2]*y+\v[3]*z)}
\text{equ1=texmath(\equ1)}
\text{equ2=texmath(\equ2)}


\rationa{ta1=}
\rationa{ta2=}
\rationa{tu1=}
\rationa{tu2=}

\statement{On considère les plans \(P_1\) et \(P_2\) d'équations respectives 
<div class="wimscenter">\(\equ1=\d1) et 
\(\equ2=\d2)</div>
On se propose de déterminer l'intersection de ces deux plans.
<div class="spacer">
L'intersection de ces deux plans est la droite \(d) passant par le point
<div class="wimscenter">\(A\) (\embed{reply 1,5},\embed{reply 2,5},\embed{reply 3,5})</div>
et dirigée par le vecteur
<div class="wimscenter">
\(\overrightarrow{u} \)(\embed{reply 4,5},\embed{reply 5,5},\embed{reply 6,5}).
</div>
</div>
}

\answer{xA}{\rep1}{type=default}
\answer{yA}{\rep2}{type=default}
\answer{zA}{\rep3}{type=default}
\answer{xu}{\rep4}{type=default}
\answer{yu}{\rep5}{type=default}
\answer{zu}{\rep6}{type=default}

\matrix{va=\rep1,\rep2,\rep3}
\matrix{vu=\rep4,\rep5,\rep6}

\rational{ta1=pari([\va]*mattranspose([\u]))}
\rational{ta2=pari([\va]*mattranspose([\v]))}
\rational{tu1=pari([\vu]*mattranspose([\u]))}
\rational{tu2=pari([\vu]*mattranspose([\v]))}

\condition{A est sur P1}{\ta1=\d1}
\condition{A est sur P2}{\ta2=\d2}
\condition{u est parallèle à P1}{\tu1=0}
\condition{u est parallèle à P2}{\tu2=0}
