\title{Intersection d'une droite et d'un plan}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}
\text{w=pari(A=[\M];M=matrix(1,3,i,j,A[j,3]);print(M))}

\integer{k=random(-1,1)*randint(1..10)}
\text{P=pari([\A]+\k*[\w])}

\matrix{n=pari(u=[\u];v=[\v];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M))}

\integer{d=pari([\A]*mattranspose([\n]))}
\text{vide=maxima(ordergreat(x,y,z,t))}
\text{equ=maxima(expand(\n[1]*x+\n[2]*y+\n[3]*z))}

\text{equa=texmath(\equ)}

\statement{On considère le plan \(P) d'équation \(\equa=\d) et la droite \(d) passant par le point
\(A(\P)) et dirigé par le vecteur \(\overrightarrow{w}(\w)). Déterminer les coordonnées du point \(I),
intersection de \(d) et \(P).
<div class="wimscenter">
Le point \(I) a pour coordonnées (\embed{reply 1,5},\embed{reply 2,5},\embed{reply 3,5}).
</div>
}

\answer{xI}{\A[1]}{type=default}
\answer{yI}{\A[2]}{type=default}
\answer{zI}{\A[3]}{type=default}

