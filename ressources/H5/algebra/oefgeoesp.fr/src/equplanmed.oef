\title{Équation du plan médiateur}
\author{Bruno, Mifsud;Hubert, Prohal}
\email{communaute.mutuwims@laposte.net;hubert.proal@ac-aix-marseille.fr}

\keywords{plane_equation,equation}
%%%% maj 2025 03 11 MB
%%%% maj 2022 03 28

\observation{Au moins une des coordonnées de A et B sont égales, avec une probabilité égale à 0.5.}

%Vecteur AB
%%%% pour avoir au moins une coord nulle 1 fois sur 2
\text{cas=randint(1,2,3,4,4,4)} %%% place du zéro
\integer{a=\cas=1 ?0:random(1..6)*randint(-1,1)}
\integer{b=\cas=2 ?0:random(1..6)*randint(-1,1)}
\integer{c=\cas=3 ?0:random(1..6)*randint(-1,1)}
%%%% vérification si pas vecteur nul
\integer{test=\a^2+\b^2+\c^2}
\if{\a^2+\b^2+\c^2=0}
{\integer{a=random(1..6)*randint(-1,1)}
\integer{b=random(1..6)*randint(-1,1)}
\integer{c=random(1..6)*randint(-1,1)}}

%%%%% Point A
\integer{xA=random(1..6)*random(-1,1)}
\integer{yA=random(1..6)*random(-1,1)}
\integer{zA=random(1..6)*random(-1,1)}
%%%%% Point B
\integer{xB=\xA+\a}
\integer{yB=\yA+\b}
\integer{zB=\zA+\c}
%%% Milieu de [AB]
\real{xM=(\xA+\xB)/2}
\real{yM=(\yA+\yB)/2}
\real{zM=(\zA+\zB)/2}

%%% Vecteur normal au plan médiateur : vect(AB)
\integer{a=\xB-\xA}
\integer{b=\yB-\yA}
\integer{c=\zB-\zA}
%%%%% Simplification des coordonnées
\integer{gcdab=gcd(\a,\b)}
\integer{gcdbc=gcd(\b,\c)}
\integer{pg= gcd(\gcdab,\gcdbc)}
\integer{a=\a/\pg}
\integer{b=\b/\pg}
\integer{c=\c/\pg}
\real{d=-1*\a*\xM-\b*\yM-\c*\zM}
\matrix{n=\a
\b
\c}
\text{rep=\a*x+\b*y+\c*z+\d=0}
%%% pour solution%%%
\text{eq1=simplify(\a*x+\b*y+\c*z)}
\text{b1=\b<0? (\b):\b}
\text{c1=\c<0? (\c):\c}
\text{xM1=\xM<0? (\xM):\xM}
\text{zM1=\zM<0? (\zM):\zM}
\text{yM1=\yM<0? (\yM):\yM}
\text{rep1=\d<0?\eq1 \d=0:\eq1 + \d=0}
\text{rep1=\d=0?\eq1=0:\rep1}
\text{eq2=wims(replace x by x_M in \eq1)}
\text{eq2=wims(replace y by y_M in \eq2)}
\text{eq2=wims(replace z by z_M in \eq2)}

\matrix{cAB=x_B-x_A
y_B-y_A
z_B-z_A
}

\hint{Le plan médiateur est le plan qui passe par le milieu du segment \([AB]) et qui est orthogonal à la droite \((AB)).}

\statement{<p>On se place dans un repère othonormé de l'espace.</p>
<p>Déterminez une équation cartésienne du plan médiateur à \(A(\xA;\yA;\zA)) et \(B(\xB;\yB;\zB)).</p>
<div class="wims_question"><label for="reply1">L'équation </label>est : \embed{r1,30}.</div>
}

\answer{}{\rep}{type=equation}

\solution{
<p>Notations : on notera \((x_A;y_A;z_A)\) les coordonnées d'un point \(A).</p>
<p class="wims_emph">Étape 1 coordonnées d'un vecteur normal au plan.</p>
<p><u>On sait que :</u> Le vecteur \(\widevec{AB}) est un vecteur normal au plan médiateur.
 Ses coordonnées sont : \([\cAB]) \(=)\([\n]).</p>
 <p class="wims_emph">Étape 2 Coordonnées du milieu de \([AB])</p>
 <p> <u>On sait que :</u> ce milieu \(M) a pour coordonnées \(\left(\frac{x_A+x_B}{2};\frac{y_A+y_B}{2};\frac{z_A+z_B}{2}\right))</p>
 <p> Ainsi \(M) a pour coordonnées \((\xM;\yM;\zM)).</p>

<p class="wims_emph">Étape 3 Equation du plan plan.</p>

<p><u>On sait que :</u> le plan d'équation \(\eq1+k=0) <i> (\(k) réel)</i> a pour vecteur
normal le vecteur de coordonnées \([\a;\b;\c]). </p>
<p>Ainsi, il reste à déterminer la valeur de \(k) pour que les coordonnées de \(M(\xM;\yM;\zM))
vérifient l'équation : \(\eq1+k=0)</p>
<ul class="wims_nopuce"><li> Soit : \(\eq2 +k=0) que l'on résout.</li>
<li> On trouve \( k=\d).</li></ul>
<p> <u>Conclusion :</u>\(\rep1) est une équation de ce plan.</p>}


