\title{Exploiter l'équation paramétrique d'une droite}
\language{fr}
\author{Bruno, Mifsud}
\keywords{line_equation,solid_geometry,vectors,directing_vector}
\observation{Demande les coordonnées d'un point ou d'un vecteur directeur. }
\email{communaute.mutuwims@laposte.net}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}
\text{A=slib(matrix/random 1,3,5)}
\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
u est un vecteur directeur de d, qui passe par A.
\text{temp=shuffle(1,2,3)}
\if{\temp[1]=1}{%%% on met un un et un zéro dans les coor de A
\text{A=wims(replace internal \A[\temp[1]] by 0 in \A)}
\text{A=wims(replace internal \A[\temp[2]] by 1 in \A)}
}
\if{\temp[1]=2}{%%% on met un un et un zéro dans les coor de u
\text{u=wims(replace internal \u[\temp[1]] by 0 in \u)}
\text{u=wims(replace internal \u[\temp[2]] by 1 in \u)}
}


\function{px=maxima(\A[1]+t*\u[1])}
\function{py=maxima(\A[2]+t*\u[2])}
\function{pz=maxima(\A[3]+t*\u[3])}
\text{pxtex=texmath(\px)}
\text{pytex=texmath(\py)}
\text{pztex=texmath(\pz)}
\rational{tu1=}
\rational{tu2=}
\rational{tB1=}
%%% feedback
\integer{t0=randint(-2..2)}
\integer{p0x=evalue(\px,t=\t0)}
\integer{p0y=evalue(\py,t=\t0)}
\integer{p0z=evalue(\pz,t=\t0)}
\matrix{ubis=wims(replace internal , by ; in \u)}
%%%%
\integer{cas=randomitem(1,2)} 1 -> vect dir 2-> pts de la droite
\if{\cas=1}{\text{list_cond=1,2}}{\text{list_cond=3}}
\conditions{\list_cond}
\text{liststep=\cas=1?reply 1,reply 2, reply 3:reply 4,reply 5, reply 6}
\steps{\liststep}

\statement{On considère la droite \((d)\) paramétrée par
<div class="wimscenter">
\(\left \lbrace \begin{matrix} x&=&\pxtex\\
y&=&\pytex\\
z&=&\pztex \end{matrix}\right .\)
</div>
\if{\cas=1}{
<div class="wims_question">
Donnez les coordonnées d'un vecteur directeur \(\overrightarrow{u}) de cette droite.
<div class="wimscenter">
On a 
\special{mathmlinput [\overrightarrow{u} =\left( \begin{matrix} reply1\\
reply2\\
reply3 \end{matrix} \right)],5,noanswer
reply 1
reply 2
reply 3}
</div></div>}
\if{\cas=2}{
<div class="wims_question">
Donner les coordonnées d'un point \(B) qui appartient à \((d)\) <br>
<div class="wimscenter">
On a \(B \)(\embed{reply 4,5};\embed{reply 5,5};\embed{reply 6,5}).
</div></div>}
}
\answer{xu}{\rep1}{type=default}{option=noanalyzeprint}
\answer{yu}{\rep2}{type=default}{option=noanalyzeprint}
\answer{zu}{\rep3}{type=default}{option=noanalyzeprint}
\answer{xB}{\rep4}{type=default}{option=noanalyzeprint}
\answer{yB}{\rep5}{type=default}{option=noanalyzeprint}
\answer{zB}{\rep6}{type=default}{option=noanalyzeprint}

\matrix{vu=\rep1,\rep2,\rep3}
\matrix{vB=\rep4,\rep5,\rep6}

\matrix{vubis=wims(replace internal , by ; in \vu)}

\rational{tu1=pari([\vu]*mattranspose([\vu]))}
\rational{tu2=pari(M=[\vu;\u];r=matrank(M);print(r))}
\integer{testB1=(\vB[1]=\A[1] and \vB[2]=\A[2] and \vB[3]=\A[3]) or ((\vB[1]-\A[1])/\u[1]=(\vB[2]-\A[2])/\u[2] and (\vB[3]-\A[3])/\u[3]=(\vB[2]-\A[2])/\u[2])?1:0 }

\condition{u est non nul}{\tu1 <> 0}{weight=1}{option=hide} 
\condition{u est parallèle à P2}{\tu2=1}{weight=1}{option=hide}
\condition{B appartient à la droite }{\testB1=1}{weight=1}{option=hide}
\feedback{(\tu1 = 0 or \tu2<>1) and \cas=1 }{
<div class="feedback">
\if{\tu1 = 0}{Le vecteur \(\overrightarrow{u}\) est le vecteur nul. Il ne peut donc pas être un vecteur directeur.<br>}
\if{\tu2<>1}{Le vecteur \([\vubis]\) que vous avez donné n'est pas un vecteur directeur.
<br> Le vecteur \(\overrightarrow{u}\)\([\ubis] \) en est un.
<br> Les deux vecteurs ne sont pas colinéaires.}
</div>
}

\feedback{\testB1<>1 and \cas=2}{
<div class="feedback">
Le point de coordonnées \(\left( \rep4;\rep5;\rep6 \right)\) n'appartient pas à la droite.
<br>Pour obtenir les coordonnées d'un point de la droite, on choisit un nombre \(t\) et on calcule les coordonnées \(x\), \(y\) et \(z\).
<p><u>Par exemple:</u> pour \(t=\t0\) on obtient \(\left( \p0x;\p0y;\p0z \right)\).</p>
</div>
}
\feedback{(\tu1 <> 0 and \tu2=1) or (\testB1=1) }{
<div class="feedback">
Bravo bonne réponse !
</div>
}
