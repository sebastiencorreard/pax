\title{Equation d'un plan}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{M=slib(matrix/invertible 3,6)}

\text{A=slib(matrix/random 1,3,5)}

\text{u=pari(A=[\M];M=matrix(1,3,i,j,A[j,1]);print(M))}
\text{v=pari(A=[\M];M=matrix(1,3,i,j,A[j,2]);print(M))}

\text{B=pari([\A]+[\u])}
\text{C=pari([\A]+[\v])}

\matrix{n=pari(u=[\u];v=[\v];M=[u[2]*v[3]-u[3]*v[2],u[3]*v[1]-u[1]*v[3],u[1]*v[2]-u[2]*v[1]];print(M))}

\integer{d=pari([\A]*mattranspose([\n]))}

\integer{r0=}
\integer{r1=}
\matrix{Mrep=}
\matrix{Mnul=}

\integer{alen=random(1..3)}

\text{equ=pari([\n]*mattranspose([x,y,z]))}
\text{equ=maxima(\equ)}

\statement{
\if{\alen=1}{On considère les points \(A(\A)), \(B(\B)) et \(C(\C)).
Déterminer une équation du plan \(P) passant par les points \(A,B) et \(C).}
\if{\alen=2}{On considère le point \(A(\A)) et les vecteurs \(\overrightarrow{u}(\u)) et \(\overrightarrow{v}(\v)).
Déterminer une équation du plan \(P) passant par le point \(A) et
dirigé par les vecteurs \(\overrightarrow{u}) et \(\overrightarrow{v}).}
\if{\alen=3}{On considère le point \(A(\A)) et le vecteur \(\overrightarrow{n}(\n)).
Déterminer une équation du plan \(P) passant par le point \(A) et
admettant le vecteur \(\overrightarrow{n}) pour vecteur normal.}
Le plan \(P) admet pour équation :
<div class="wimscenter">
\embed{reply 1,5} x + \embed{reply 2,5} y + \embed{reply 3,5} z = \embed{reply 4,5}
</div>
}

\answer{a}{\rep1}{type=default}
\answer{b}{\rep2}{type=default}
\answer{c}{\rep3}{type=default}
\answer{d}{\rep4}{type=default}

\matrix{Mnul=\rep1,\rep2,\rep3,\rep4;\rep1,\rep2,\rep3,\rep4}
\matrix{Mrep=\n,\d;\rep1,\rep2,\rep3,\rep4}

\integer{r0=pari(matrank([\Mnul]))}
\integer{r1=pari(matrank([\Mrep]))}

\condition{Vérification}{\r0=1 and \r1=1}

\solution{Une équation de ce plan est \(\equ=\d).}
