\text{good=wims(nonempty items \good)}
\text{bad=wims(nonempty items \bad)}
\integer{badcnt=random(1,1,2,2,3)}
\integer{goodcnt=4-\badcnt}
\text{bads=item(1..\badcnt,1,1,1,1,1,1)}
\text{gb=item(1..4,\bads,0,0,0,0,0,0)}
\text{bads=item(1..\badcnt,\bad)}
\text{goods=item(1..4-\badcnt,\good)}
\text{order=shuffle(4)}
\text{list=item(\order,\bads,\goods)}
\text{gb=item(\order,\gb)}
\text{bad=wims(positionof item 1 in \gb)}
\text{good=wims(positionof item 0 in \gb)}
\text{l1=item(1,\list)}
\text{l2=item(2,\list)}
\text{l3=item(3,\list)}
\text{l4=item(4,\list)}
\text{space=<td>&nbsp;&nbsp;&nbsp;}
\if{random(1,2) = 1}{
 \text{ask=错误}
 \text{cond=错误的}
 \text{ans=\bad}
}{
 \text{ask=正确}
 \text{cond=正确的}
 \text{ans=\good}
}
\statement{设 \(z1,z2) 是两个非零复数.

在以下\propsname中, 哪一个是\ask的 ?
<p><center><table border=0>
 <tr><td>\embed{reply 1,1}.\space<td>\l1
 <tr><td>\embed{reply 1,2}.\space<td>\l2
 <tr><td>\embed{reply 1,3}.\space<td>\l3
 <tr><td>\embed{reply 1,4}.\space<td>\l4
</table></center> <p>
}
\reply{\cond\propsname是}{\ans;1,2,3,4}{type=checkbox}
