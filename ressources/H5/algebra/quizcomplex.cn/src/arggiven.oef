\title{已知辐角}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\real{mod=randint(1..100)/10}
\real{a1=randint(1..100)/10*random(-1,1)}
\integer{type=random(1,2)}
\real{arg=\type=1?\a1:\a1*pi}
\text{Arg=\type=1?\a1:\a1*pi}
\real{re=cos(\arg)*\mod}
\real{im=sin(\arg)*\mod}

\statement{已知复数 \(z) 有 |\(z)|=\mod, 并且辐角是 \Arg.
计算 \(x) 的实部与虚部.}

\answer{\(Re(z))}{\re}
\answer{\(Im(z))}{\im}
