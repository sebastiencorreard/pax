!set title=实部和虚部
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=XIAO Gang
email=xiao@unice.fr

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

val6=$(tmp0)
tmp=!translate internal $	$ to ; in 	 i*z, -y, x	 -i*z, y, -x	 $val6*z,$val6*x,$val6*y	 z+i,x,y+1	 z-i,x,y-1	 i-z,-x,1-y	 $val6+z,x+$val6,y	 $val6-z,$val6-x,-y	 z-$val6,x-$val6,y	 $val6+i*z,$val6-y,x	 $val6-i*z,$val6+y,-x	 i*z-$val6,-y-$val6,x	 z+$val6*i,x,y+$val6	 z-$val6*i,x,y-$val6	 $val6*i-z,-x,$val6-y	 conj(z),x,-y	 i*conj(z),y,x	 -i*conj(z),-y,-x	 $val6*conj(z),$val6*x,-$val6*y	 conj(z)+i,x,-y+1	 conj(z)-i,x,-y-1	 i-conj(z),-x,1+y	 $val6+conj(z),x+$val6,-y	 $val6-conj(z),$val6-x,y	 conj(z)-$val6,x-$val6,-y	 z+$val6+i,x+$val6,y+1	 z-$val6+i,x-$val6,y+1	 z-$val6-i,x-$val6,y-1	 z+$val6-i,x+$val6,y-1	 $val6+i-z,$val6-x,1-y	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=!rawmath $(tmp0)
tmp0=!item 2 of $val7

val9=!rawmath $(tmp0)
tmp0=!item 3 of $val7

val10=!rawmath $(tmp0)
replytype1=formal
replyname1=实部
replygood1=$val9
replytype2=formal
replyname2=虚部
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 
!insmath z = x + i*y
$() 是一个复数, 其中 
!insmath x
$() 和 
!insmath y
$()	是实数. 
!insmath $val8
$() 的实部和虚部是什么 ?	<p><center>	 Re(
!insmath $val8
$()) =  
!read oef/embed.phtml reply 1,10 
$(), Im(
!insmath $val8
$()) =  
!read oef/embed.phtml reply 2,10 
$().	</center>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=2
