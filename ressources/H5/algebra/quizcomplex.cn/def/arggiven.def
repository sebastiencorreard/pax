!set title=已知辐角
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 100

val6=$[$(tmp0)/10]
tmp0=!randint 1, 100

tmp1=!randitem -1,1

val7=$[$(tmp0)/10*$(tmp1)]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=$[$val7]
!else
val9=$[$val7*pi]
!endif

!ifval $val8=1
val10=$val7
!else
val10=$val7*pi
!endif
val11=$[cos($val9)*$val6]
val12=$[sin($val9)*$val6]
replyname1=\(Re(z))
replygood1=$val11
replyname2=\(Im(z))
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()已知复数 
!insmath z
$() 有 |
!insmath z
$()|=$val6, 并且辐角是 $val10.	计算 
!insmath x
$() 的实部与虚部.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10
embedcnt=0
