tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(($val7)^2-4*$val6*$val8)]
t_=!replace internal \( by ( in expand((x-$val9)*($val6*x^2+$val7*x+$val8))
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val6*x^2+$val7*x+$val8))
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
evaltmp=$val12

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
!if $val13 !=0 
!if $val10>0 
val14=$[rint(3)]
!endif
!if $val10=0 
val14=$[rint(2)]
!endif
