val14=$[rint(1)]
!endif
!else
!if $val10>0 
val14=$[rint(2)]
!endif
!if $val10=0 
val14=$[rint(1)]
!endif
!if $val10<0 
val14=$[rint(1)]
!endif
!endif
t_=!replace internal \( by ( in x-$val9
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
