!set title=Grafische voorstelling drieterm
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=F. PITOUN
email=lva.pitoun@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val8*(x-$val6)*(x-$val7))
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
!if $val6=$val7 
t_=!replace internal \( by ( in a*(x-$val6)^2
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
val11=\(\f) heeft wortel $val6
t_=!rawmath $val6+1
val12=!exec pari print($t_)
!else
t_=!replace internal \( by ( in a*(x-$val6)*(x-$val7)
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
val11=\(\f) heeft twee wortels $val6 en $val7
t_=!rawmath ($val6+$val7)/2
val12=!exec pari print($t_)
!endif
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
val14=$[rint(-15)]
val15=$[rint(15)]
val16=$[rint($val15-$val14+1)]
val17=xrange=-6,6	yrange $val14,$val15	parallel -6,$val14,-6,$val15,1,0,13,blue	parallel -6,$val14,6,$val14,0,1,$val16,blue	linewidth 2	line -6,0,6,0,red	line 0,$val14,0,$val15,red	arrow 0,0,1,0,10,red	arrow 0,0,0,1,10,red	plot green,$val9	
replytype1=algexp
replyname1=Het functievoorschrift van \(f) is :
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

