!set title=Wortels van een polynoom van graad 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Frédéric PITOUN
email=lva.pitoun@free.fr
computeanswer=no
precision=10000

ansorder=r,r,c
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=2
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,-1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 6

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 6

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint(($val6)*(-1)*($val7+$val8))]
val10=$[rint(($val6)*$val7*$val8)]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val9,$val11

val14=$[rint($(tmp0))]
tmp0=!item $val13 of $val10,$val12

val15=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(($val6)*x^2+($val14)*x+$val15)
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
val17=$[rint(($val14)^2-4*($val6)*($val15))]

!ifval $val17<0
val18=0
!endif

!ifval $val17=0
val18=1
!endif

!ifval $val17>0
val18=2
!endif

!ifval $val17=0
val19=een wortel. Wat is die wortel?
!endif

!ifval $val17>0
val19=twee wortels. Wat zijn die wortels?
!endif
!if $val17>=0 
tmp=!translate ";': to $     $ in 	((-1)*$val14-\sqrt($val17))/(2*$val6)	

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in 	((-1)*$val14+\sqrt($val17))/(2*$val6)	

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=!rawmath $(tmp0)
!endif

!ifval $val17>0
val22=$val20,$val21
!endif

!ifval $val17=0
val22=$val20
!endif

!ifval $val17>=0 
val23= reply1	choice 1	reply2	
!else
val23=	reply1	choice 1	
!endif

!ifval $val17<0
val24= De discriminant \($val17) is negatief, dit polynoom heeft dus geen wortel.
!endif

!ifval $val17=0
val24= De discriminant is nul, dit polynoom heeft dus een enkele wortel, namelijk \($val20).
!endif

!ifval $val17>0
val24= De discriminant \($val17) is positief, dit polynoom heeft dus twee verschillende wortels, namelijk <br/>	<center>	\($val20) en \($val21)	</center>
!endif
oefsteps=$val23 
nextstep=!nosubst $val23 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Discriminant van
replygood1=$[$val17]
replytype2=fset
replyname2=Verzameling wortels
replygood2=$val22
choicename1=Aantal wortels
choicegood1=$val18
choicebad1=0,1,2
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Zij  
!insmath P
$() de polynoom gedefinieerd door 
!insmath P(x)=$val16
$().  
!if $m_step=1 
$()Bereken de discriminant 
!insmath \Delta
$() van 
!insmath P
$(). <br/>	<p align="center"> 
!insmath \Delta=
$()  
!read oef/embed.phtml reply 1 
$() </p>	 
!endif
$()	 
!if $m_step=2 
$() Inderdaad, 
!insmath \Delta=$val17
$().  
!endif
$()	 
!if $m_step=3 
$() Inderdaad, 
!insmath \Delta=$val17
$(). Dit polynoom heeft dus $val19 <br/>		 <p align="center"> 		Verzameling wortels: 
!read oef/embed.phtml reply  2,20 
$() <br/>		</p>		<b>Let op:</b> Scheid, zonodig, de wortels met een komma.	 
!endif
$()			
$()
!exit

