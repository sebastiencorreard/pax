tmp0=!randint -4, 4

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val8*(x-$val6)^2+$val7)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val10=$[rint($(tmp0)*$(tmp1))]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[rint($(tmp0))]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val12=!rawmath $(tmp0)
evaltmp=$val12

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
t_=!rawmath $val11-$val13*$val10
val14=!exec pari print($t_)
!if \p=0 
val15=$[rint(1)]
!endif
!if \p=1 and $val8>0 
val15=$[rint(2)]
!endif
!if \p=1 and $val8<0 
val15=$[rint(0)]
!endif
!if \p=-1 and $val8>0 
val15=$[rint(0)]
!endif
!if \p=-1 and $val8<0 
val15=$[rint(2)]
!endif
t_=!replace internal \( by ( in $val9-$val13*x-$val14-\p
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val13*x+b
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val13*x+$val14
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
val19=$[rint(-10)]
val20=$[rint(10)]
val21=$[rint($val20-$val19+1)]
val22=animate 10,0.5,0	xrange=-6,6	yrange $val19,$val20	linewidth 1	parallel -6,$val19,-6,$val20,1,0,13,blue	parallel -6,$val19,6,$val19,0,1,$val21,blue	linewidth 2	line -6,0,6,0,red	line 0,$val19,0,$val20,red	arrow 0,0,1,0,10,red	arrow 0,0,0,1,10,red	plot green,$val9	plot blue,$val13*x+s*20-10	
replytype1=default
replyname1=De waarde van b
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

