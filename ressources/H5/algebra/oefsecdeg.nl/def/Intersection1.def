!set title=Doorsnede 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Frédéric PITOUN
email=lva.pitoun@free.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6*x^2+$val7*x+$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val12=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val9*x-$val9*$val10+$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in 	($val9-$val7)/$val6-$val10 	

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in 	$(tmp0)	

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val15=!rawmath $(tmp1)
val16=$[$val14-$val10]

!ifval ($val16>=0)
val17=!rawmath $val10
!else
val17=!rawmath $val14
!endif

!ifval ($val16>=0)
val18=!rawmath $val12
!else
val18=!rawmath $val15
!endif

!ifval ($val16>=0)
val19=!rawmath $val14
!else
val19=!rawmath $val10
!endif

!ifval ($val16>=0)
val20=!rawmath $val15
!else
val20=!rawmath $val12
!endif

!ifval ($val10=$val14)
val21=Deze twee krommen snijden in precies een punt \(A($val10;$val12))
!else
val21=Deze twee krommen snijden in twee punten \(A($val10;$val12)) en \(B($val14;$val15))
!endif
replytype1=default
replyname1=x-coordinaat van het 1e intersectiepunt
replygood1=$val17
replytype2=default
replyname2=y-coordinaat van het 1e intersectiepunt
replygood2=$val18
replytype3=default
replyname3=x-coordinaat van het 2e intersectiepunt
replygood3=$val19
replytype4=default
replyname4=y-coordinaat van het 2e intersectiepunt
replygood4=$val20
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Bepaal de coordinaten van het of de punten  in de doorsnede van lijn 
!insmath d
$() gegeven door 
!insmath y=$val13
$() en parabool 
!insmath P
$() gegeven door 
!insmath y=$val11
$().<br/>	<b>Opmerking:</b> Als je maar een punt vindt, vul dan twee keer zijn coordinaten in. Als je twee punten vindt, vul dan als eerste diegene in met het kleinste x-coordinaat.
$()
!exit

:hint
$()Om het x-coordinaat van de intersectiepunt te vinden van twee krommen met vergelijkingen 
!insmath y=f(x)
$() en 
!insmath y=g(x)
$(), moet je de vergelijking 
!insmath f(x)=g(x)
$() oplossen.
$()
!exit

:help
$()
$()
!exit

:solution
$()$val21
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13,21
embedcnt=0
