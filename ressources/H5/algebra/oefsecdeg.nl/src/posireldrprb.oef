\title{Relatieve positie lijn/parabool}
\language{nl}
\range{-5..5}
\author{F. PITOUN}
\email{pitoun.wims@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-4..4)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)}
\function{f0=maxima(expand(\k*(x-\u)^2+\v))}

\integer{mx=random(-1,1)*random(1..5)}
\integer{my=evalue(\f0,x=\mx)}
\function{f1=diff(\f0,x)}
\rational{a=evalue(\f1,x=\mx)}
\rational{b=\my-\a*\mx}



\if{\p=0}{
\integer{ns=1}
}


\if{\p=1 and \k>0}{
\integer{ns=2}
}


\if{\p=1 and \k<0}{
\integer{ns=0}
}


\if{\p=-1 and \k>0}{
\integer{ns=0}
}


\if{\p=-1 and \k<0}{
\integer{ns=2}
}

\function{f2=maxima(\f0-\a*x-\b-\p)}

\function{d=maxima(\a*x+b)}
\function{db=maxima(\a*x+\b)}


\integer{ym=-10}
\integer{yM=10}
\integer{ny=\yM-\ym+1}
\text{dessin=
animate 10,0.5,0
xrange=-6,6
yrange \ym,\yM
linewidth 1
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
plot green,\f0
plot blue,\a*x+s*20-10
}

\statement{
Gegeven de parabool \(P) met vergelijking \(y = \f0).<br>
Voor welke waarde van \(b) heeft de rechte met vergelijking \(y = \d) <br>
slechts &eacute;&eacute;n snijpuntm met \(P) ?

<hr>
<p align=center>
\draw{300,300}{
\dessin
}
</p>


<br>
<p align=center>
\(P) en \(d) hebben &eacute;&eacute;n snijpunt, dus geldt \(b=) \embed{reply 1,15}
</p>
}


\answer{De waarde van b}{\b}{type=default}



\solution{
<br>
\(d) en \(P) hebben een snijpunt als geldt \(\f0=\d).<br>
Dit is de tweedegraads vergelijking : \(\f0 - (\d) = 0) .<br>
Aan de voorwaarde "slechts &eacute;&eacute;n snijpunt" wordt<br>
voldaan als de discriminant gelijk is aan 0.<br>
Dus (\(\Delta=0))
}
