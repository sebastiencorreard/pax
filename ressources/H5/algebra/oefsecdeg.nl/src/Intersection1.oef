\title{Doorsnede 1}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..5)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{p=random(1..4)}
\integer{x0=random(-5..5)}

\function{f=simplify(\a*x^2+\b*x+\c)}
\integer{y0=evalue(\f,x=\x0)}
\function{eq=simplify(\p*x-\p*\x0+\y0)}
\function{x1=simplify(
(\p-\b)/\a-\x0 
)}
\function{y1=simplify(
evalue(\f,x=\x1)
)}
\real{t=\x1-\x0}
\function{sx0=(\t>=0)?\x0:\x1}
\function{sy0=(\t>=0)?\y0:\y1}
\function{sx1=(\t>=0)?\x1:\x0}
\function{sy1=(\t>=0)?\y1:\y0}
\text{sol=(\x0=\x1)?Deze twee krommen snijden in precies een punt \(A(\x0;\y0)):Deze twee krommen snijden in twee punten \(A(\x0;\y0)) en \(B(\x1;\y1))}
\statement{Bepaal de coordinaten van het of de punten  in de doorsnede van lijn \(d) gegeven door \(y=\eq) en parabool \(P) gegeven door \(y=\f).<br/>
<b>Opmerking:</b> Als je maar een punt vindt, vul dan twee keer zijn coordinaten in. Als je twee punten vindt, vul dan als eerste diegene in met het kleinste x-coordinaat.}

\hint{Om het x-coordinaat van de intersectiepunt te vinden van twee krommen met vergelijkingen \(y=f(x)) en \(y=g(x)), moet je de vergelijking \(f(x)=g(x)) oplossen.}

\answer{x-coordinaat van het 1e intersectiepunt}{\sx0}{type=default}
\answer{y-coordinaat van het 1e intersectiepunt}{\sy0}{type=default}
\answer{x-coordinaat van het 2e intersectiepunt}{\sx1}{type=default}
\answer{y-coordinaat van het 2e intersectiepunt}{\sy1}{type=default}



\solution{\sol}
