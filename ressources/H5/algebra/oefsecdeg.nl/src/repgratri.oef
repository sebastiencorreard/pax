\title{Grafische voorstelling drieterm}
\language{nl}
\range{-5..5}
\author{F. PITOUN}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..5)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)*random(1..3)}
\function{f0=maxima(expand(\k*(x-\u)*(x-\v)))}
\if{\u=\v}{
\function{f1=maxima(a*(x-\u)^2)}
\text{phrase=\(\f) heeft wortel \u}
\rational{s=\u+1}
}{
\function{f1=maxima(a*(x-\u)*(x-\v))}
\text{phrase=\(\f) heeft twee wortels \u en \v}
\rational{s=(\u+\v)/2}
}
\rational{p=evalue(\f0,x=\s)}
\integer{ym=-15}
\integer{yM=15}
\integer{ny=\yM-\ym+1}
\text{dessin=
xrange=-6,6
yrange \ym,\yM
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
plot green,\f0
}

\statement{
Hieronder staat de grafiek van de tweedegraads polynoom \(f)
<br>
Bepaal het functievoorschrift van \(f) als ook bekend is dat<br>
het punt S met co&ouml;rdinaten \( (\s : \p)) op de grafiek van \(f) ligt.
<br>
<p align=center>
\draw{300,300}{
\dessin
}
</p>

<b>Opmerking </b> Geef \(f) in de ontwikkelde vorm.<br>
<br>
<p align=center>
\(f(x)=) \embed{reply 1,15}
</p>
}


\answer{Het functievoorschrift van \(f) is : }{\f0}{type=algexp}

\hint{Zoek de nulpunten van \(f)}

\solution{\phrase, \(f(x)) is dus in de vorm\(\f1). <br>
En bepaal de waarde van \(a) met het gegeven \(f(\s)=\p).
}
