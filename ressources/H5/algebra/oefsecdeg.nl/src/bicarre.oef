\title{Nulpunten van vergelijkingen}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{a=random(-1,1)*random(1..5)}
\integer{u=random(-1,1)*randint(1..8)}
\integer{v=randint(-8..8)}
\integer{al=random(1,2)}
\function{tri=maxima(expand(\a*(x-\u)*(x-\v)))}

\if{\al=1}{
	\function{f=maxima(expand(\a*(x^2-\u)*(x^2-\v)))}

	\if{\u>0 and \v >0 and \u != \v}{
	\integer{N=4}
	}

	\if{\u>0 and \v >0 and \u = \v}{
	\integer{N=2}
	}

	\if{(\u>0 and \v <0) or (\u<0 and \v>0)}{
	\integer{N=2}
	}

	\if{\u<0 and \v <0}{
	\integer{N=0}
	}

	\if{\u>0 and \v=0}{
	\integer{N=3}
	}
	\if{\u<0 and \v=0}{
	\integer{N=1}
	}	
}


\if{\al=2}{
	\function{f=maxima(expand(\a*(sqrt(x)-\u)*(sqrt(x)-\v)))}

	\if{\u>0 and \v >0 and \u != \v}{
	\integer{N=2}
	}

	\if{\u>0 and \v >0 and \u = \v}{
	\integer{N=1}
	}

	\if{(\u>0 and \v <0) or (\u<0 and \v>0)}{
	\integer{N=1}
	}

	\if{\u<0 and \v <0}{
	\integer{N=0}
	}

	\if{(\u>0 and \v=0) or (\u=0 and \v>0)}{
	\integer{N=2}
	}
	\if{(\u<0 and \v=0) or (\u=0 and \v<0)}{
	\integer{N=1}
	}

	
}



\statement{Hoeveel re&euml;ele nulpunten het de onderstaande vergelijking ?<br>
<p align="center">
\(\f=0)
<br><br>
Het aantal nulpunten is : \embed {reply 1}<br>
</p>

}


\answer{Het aantal oplossingen is:}{\N}{type=integer}

\hint{De wortels van : \(\tri) zijn \(\u) en \(\v)}
