\title{Doorsnede 2}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..5)}
\integer{b0=random(1..5)}
\integer{pb=random(1..2)}
\integer{b=\b0*(-1)^(\pb)}
\integer{c=random(-5..5)}
\integer{p=random(1..4)}
\integer{xa=random(1..5)}
\integer{px=random(1..2)}
\integer{x0=\xa*(-1)^(\px)+\c}

\function{f=\a+simplify(\b/(x-\c))}
\function{f_simp=simplify(\f)}
\function{y0=simplify(evalue(\f,x=\x0))}
\function{eq=simplify(\p*x-\p*\x0+\y0)}
\function{eqa=simplify(\a*(x-\c)+\b)}
\function{eqb=simplify((\eq)*(x-\c))}
\function{eqc=simplify(maxima(expand(\eqb))-\eqa)}
\text{tm=texmath(\eq)}

\text{f_simp_t=texmath(\f_simp)}
\text{eqa_t=texmath(\eqa)}
\text{eqb_t=texmath(\eqb)}
\text{eqc_t=texmath(\eqc)}

\function{x1=simplify(
\b/(\p*(\c-\x0))+\c
)}
\function{y1=simplify(
evalue(\f,x=\x1)
)}
\real{t=simplify((\x1)+(-1)*(\x0))}

\function{sx0=(\t>=0)?\x0:\x1}
\function{sy0=(\t>=0)?\y0:\y1}
\function{sx1=(\t>=0)?\x1:\x0}
\function{sy1=(\t>=0)?\y1:\y0}

\text{sol1=De vergelijking van de hyperbool kan geschreven worden in de vorm \(y=\f_simp_t), om de intersectiepunten van \(H) en \(d) te vinden, moet men dus de volgende vergelijking oplossen<br/>
<p align="center"> 
\(
\begin{array}{cccc}
& \f_simp_t & = & \tm \\
\Leftrightarrow & \eqa_t & = & \eqb_t \\
\Leftrightarrow & 0 & = & \eqc_t
) <p/> <br/>
Deze laatste vergelijking heeft
}

\text{sol2=(\x0=\x1)? een unieke oplossing, namelijk \(\sx0). Deze twee krommen hebben een uniek intersectiepunt, namelijk \(A(\x0;\y0)): twee oplossingen \(\sx0) en \(\sx1). Deze twee krommen hebben twee intersectiepunten \(A(\x0;\y0)) en \(B(\x1;\y1))}

\statement{Bepaal de coordinaten van het of de punten in de doorsnede van lijn \(d) gegeven door \(y=\tm) en hyperbool \(H) gegeven door \(y=\f).<br/>
<b>Belangrijke opmerkingen:</b> 
<ul>
<li>
    Als je maar een intersectiepunt vindt, vul zijn coordinaten dan twee keer in. 
</li>
<li>
    Als je twee intersectiepunten vindt, vul dan als eerste diegene in met het kleinste x-coordinaat.
</li>
<li>
    Numerieke antwoorden moeten exact zijn.
</li>
</ul>
}


\answer{x-coordinaat van het 1e intersectiepunt}{\sx0}{type=default}
\answer{y-coordinaat van het 1e intersectiepunt}{\sy0}{type=default}
\answer{x-coordinaat van het 2e intersectiepunt}{\sx1}{type=default}
\answer{y-coordinaat van het 2e intersectiepunt}{\sy1}{type=default}

\hint{Herschrijf de vergelijking zodat je een kruisproduct kunt gebruiken.}

\solution{\sol1 \sol2}
