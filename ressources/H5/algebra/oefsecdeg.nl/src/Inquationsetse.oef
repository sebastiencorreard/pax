\title{Ongelijkheden in graad 2}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{a0=random(1,-1)}
\integer{u=random(1,-1)*randint(1..6)}
\integer{v=randint(1..6)}
\integer{b0=-2*\a0*\u}
\integer{c0=-\a0*\v}
\integer{a1=random(-1,1)*randint(1..5)}
\integer{b1=random(-5..5)}
\integer{c1=random(-5..5)}

\integer{a2=\a0+\a1}
\integer{b2=\b0+\b1}
\integer{c2=\c0+\c1}

\function{pol0=maxima(expand((\a0)*x^2+(\b0)*x+\c0))}
\function{pol1=maxima(expand((\a1)*x^2+(\b1)*x+\c1))}
\function{pol2=maxima(expand((\a2)*x^2+(\b2)*x+\c2))}

\integer{al=random(1..4)}
\text{i1=>}
\text{i2=\ge}
\text{i3=<}
\text{i4=\le}
\text{ineg=item(\al,\i1,\i2,\i3,\i4)}
\text{I1=\lbrack a ; b \rbrack}
\text{I2=\rbrack a ; b \lbrack}
\text{I3=\rbrack - \infty ; a \rbrack \cup \lbrack  b ; + \infty \rbrack}
\text{I4=\rbrack - \infty ; a \lbrack \cup \rbrack  b ; + \infty \rbrack}



\integer{d=(\b0)^2-4*(\a0)*(\c0)}



\text{inter=((\a0>0) and (\al=1))?4}
\text{inter=((\a0>0) and (\al=2))?3}
\text{inter=((\a0>0) and (\al=3))?2}
\text{inter=((\a0>0) and (\al=4))?1}


\text{inter=((\a0<0) and (\al=1))?2}
\text{inter=((\a0<0) and (\al=2))?1}
\text{inter=((\a0<0) and (\al=3))?4}
\text{inter=((\a0<0) and (\al=4))?3}



\text{forme=item(\inter,\I1, \I2, \I3, \I4)}


\function{x1=simplify(
((-1)*\b0-\sqrt(\d))/(2*\a0)
)}
\function{x2=simplify(
((-1)*\b0+\sqrt(\d))/(2*\a0)
)}

\real{t=\x2-\x1}
\function{sx1=(\t>=0)?\x1:\x2}
\function{sx2=(\t>=0)?\x2:\x1}

\steps{
reply1
reply2,reply3
}

\statement{Los de volgende ongelijkheid op \(\pol2) \(\ineg) \(\pol1).</br>

\if{\step=1}{
De verzameling oplossingen van deze ongelijkheid is van de vorm: \embed{reply 1}</br>


<p align="center">
<ol>
<li> \(\I1) </li>
<li> \(\I2) </li>
<li> \(\I3) </li>
<li> \(\I4) </li>
</ol>
</p>

}
\if{\step=2}{Ja, de verzameling oplossingen van de ongelijkheid  
\(\pol2) \(\ineg) \(\pol1) is van de vorm \(\forme). Geef nu:
 <p align="center">
De waarde van a : \embed{reply  2} <br/>
De waarde van b :\embed{reply  3} <br/>
</p>

<b>Let op:</b> Voor \(\sqrt{a}), moet je "sqrt(a)" typen.
}


}
\answer{Vorm van de oplossingsverzameling:}{\inter;1,2,3,4}{type=radio}
\answer{Eerste wortel}{\sx1}{type=formal}
\answer{Tweede wortel}{\sx2}{type=formal}




