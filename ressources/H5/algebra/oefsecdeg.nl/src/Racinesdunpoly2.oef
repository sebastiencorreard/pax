\title{Wortels van een polynoom van graad 2}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{a=random(1,-1)*randint(1..5)}
\integer{u=random(1,-1)*randint(1..6)}
\integer{v=random(1,-1)*randint(1..6)}
\integer{b0=(\a)*(-1)*(\u+\v)}
\integer{c0=(\a)*\u*\v}

\integer{b1=random(-5..5)}
\integer{c1=random(-5..5)}

\integer{al=random(1..2)}

\integer{b=item(\al,\b0,\b1)}
\integer{c=item(\al,\c0,\c1)}

\function{pol=maxima(expand((\a)*x^2+(\b)*x+\c))}

\integer{d=(\b)^2-4*(\a)*(\c)}

\text{nb=\d<0?0}
\text{nb=\d=0?1}
\text{nb=\d>0?2}

\text{nbrac=\d=0?een wortel. Wat is die wortel?}
\text{nbrac=\d>0?twee wortels. Wat zijn die wortels?}



\if{\d>=0}{
\function{x1=simplify(
((-1)*\b-\sqrt(\d))/(2*\a)
)}
\function{x2=simplify(
((-1)*\b+\sqrt(\d))/(2*\a)
)}
}

\text{sol=\d>0?\x1,\x2}
\text{sol=\d=0?\x1}


\text{STEPS = \d>=0 ? reply1
choice 1
reply2
:
reply1
choice 1
}
\steps{\STEPS}

\text{textsol=\d<0? De discriminant \(\d) is negatief, dit polynoom heeft dus geen wortel.}

\text{textsol=\d=0? De discriminant is nul, dit polynoom heeft dus een enkele wortel, namelijk \(\x1).}

\text{textsol=\d>0? De discriminant \(\d) is positief, dit polynoom heeft dus twee verschillende wortels, namelijk <br/>
<center>
\(\x1) en \(\x2)
</center>}




\statement{Zij  \(P) de polynoom gedefinieerd door \(P(x)=\pol). \if{\step=1}{Bereken de discriminant \(\Delta) van \(P). <br/>
<p align="center"> \(\Delta=) \embed{reply 1} </p>
}
\if{\step=2}{ Inderdaad, \(\Delta=\d). }
\if{\step=3}{ Inderdaad, \(\Delta=\d). Dit polynoom heeft dus \nbrac <br/>

 <p align="center"> 

Verzameling wortels:\embed{reply  2,20} <br/>

</p>

<b>Let op:</b> Scheid, zonodig, de wortels met een komma.
}


}
\answer{Discriminant van}{\d}{type=numeric}

\answer{Verzameling wortels}{\sol}{type=fset}

\choice{Aantal wortels}{\nb}{0,1,2}

\solution{\textsol}
