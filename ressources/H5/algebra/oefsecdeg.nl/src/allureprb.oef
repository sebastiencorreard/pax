\title{Ligging van een parabool}
\language{nl}
\range{-5..5}
\author{F. PITOUN}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-4..4)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)}
\function{f0=maxima(expand(\k*(x-\u)^2+\v))}

\integer{D=4*\k^2*\u^2-4*\k*(\v+\u^2)}

\if{\k<0}{
\text{b1=a&#60;0}
}
{
\text{b1=a&#62;0}
}
\text{u1=a&#60;0}
\text{u2=a&#62;0}

\text{v1=\(\Delta)&#60;0}
\text{v2=\(\Delta)&#62;0}
\text{v3=\(\Delta)&#61;0}

\if{\D>0}{\text{b2=\(\Delta)&#62;0}}
\if{\D=0}{\text{b2=\(\Delta)&#61;0}}
\if{\D<0}{\text{b2=\(\Delta)&#60;0}}


\function{f2=maxima(\f0-\a*x-\b-\p)}

\function{d=maxima(\a*x+b)}
\function{db=maxima(\a*x+\b)}


\integer{ym=-10}
\integer{yM=10}
\integer{ny=\yM-\ym+1}
\text{dessin=
animate 10,0.5,0
xrange=-6,6
yrange \ym,\yM
linewidth 1
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
plot green,\f0
plot blue,\a*x+s*20-10
}

\statement{
Gegeven de parabool <b>P</b> met vergelijking \(y=ax^2+bx+c) <br>
(zie grafiek hieronder)

<hr>
<p align="center">
\draw{300,300}{
\dessin
}
</p>

<br>
<p align=center>
Uit de grafiek kunnen we concluderen dat :
<p align=center>
  \embed{reply 1,50 25}
</p>

</p>
}


\answer{Het teken van a is \(\Delta)}{\b1,\b2 | \b2,\b1;\u1,\u2,\v1,\v2,\v3}{type=dragfill}


\solution{
<ul>
<li>
Een parabool is een bergparabool als geldt a &lt; 0.
</li>
<li>
Een parabool heeft twee snijpunten met de \(x)-as (de lijn \(y=0)) als de discriminant &gt; 0 <br>
Dus \(\Delta) &gt; 0.
</li>
<li>
Een parabool heeft &eacute;&eacute;n snijpunt met de \(x)-as als geldt \(\Delta) = 0
</li>
</ul>
}
