\title{Ontbinding van polynomen van graad 2}
\language{nl}
\range{-5..5}
\author{Frédéric PITOUN}
\email{lva.pitoun@free.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(2..4)}
\integer{u=random(-1,1)*randint(1..8)}
\integer{v=random(-1,1)*randint(1..8)}
\function{err=maxima(factor((x-\u)*(x-\v)))}
\function{fac=maxima(factor((\a)*(x-\u)*(x-\v)))}
\function{dev=maxima(expand(\fac))}
\integer{d=((\u-\v)*(\u-\v)*\a*\a)}
\statement{Schrijf polynoom \(\dev) als product van zijn factoren.
<p align=left>
<b>Let op:
</b> Je moet "maximal" ontbinden.
</p>}

\answer{Ontbinding}{\fac}{type=algexp}

\solution{De discriminant van dit polynoom is \(\d), zijn wortels zijn \(x_1=\u) en \(x_2=\v). Zijn ontbinding is dus: <br/>
<p align="center"> \(\fac) </p>}
