\title{Ontbinden derdegraads polynoom}
\language{nl}
\range{-5..5}
\author{F. PITOUN}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*randint(1..5)}
\integer{b=random(-5..5)}
\integer{c=random(-1,1)*randint(1..5)}

\integer{ev=random(-1,1)*randint(1..3)}

\integer{d=(\b)^2-4*\a*\c}

\function{f=maxima(expand((x-\ev)*(\a*x^2+\b*x+\c)))}

\function{g=maxima(expand((\a*x^2+\b*x+\c)))}

\integer{test=evalue(\g,x=\ev)}

\if{\test !=0}{
\if{\d>0}{
\integer{N=3}
}
\if{\d=0}{
\integer{N=2}
}
\if{\d<0}{
\integer{N=1}
}
}{
\if{\d>0}{
\integer{N=2}
}
\if{\d=0}{
\integer{N=1}
}
\if{\d<0}{
\integer{N=1}
}


}

\function{g1=maxima(x-\ev)}


\steps{
reply1
reply2
}

\statement{
Gegeven de functie \(f), gedefinieerd in \(\mathbb{R}), 
door \(f(x)=\f).
\if{\step=1}{ <br>Bepaal het functievoorschrift van de tweedegraads polynoom g waarvoor geldt:<br>
<p align=center>
\(f(x)=(\g1)g(x))
<br>
<br>
\(g(x)=) \embed{reply 1}
</p>}
\if{\step=2}{<br>We weten dat geldt \(f(x)=(\g1)(\g)). <br>
Hoeveel re&euml;ele oplossingen heeft de vergelijkine \(\f = 0)
<br>
<p align=center>
Deze vergelijking heeft \embed{reply 2,5} oplossingen.
</p>
}
}


\answer{Polynoom g}{\g}{type=default}
\answer{Aantal oplossingen}{\N}{type=integer}
