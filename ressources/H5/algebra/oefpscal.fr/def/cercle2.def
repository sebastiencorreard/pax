!set title=Equation d'un cercle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=100

ansorder=r,r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand((x-$val6)^2+(y-$val7)^2-$val8^2)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
replytype1=default
replyname1=
replygood1=$val6
replytype2=default
replyname2=
replygood2=$val7
replytype3=default
replyname3=
replygood3=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer le centre 
!insmath M
$() et le rayon 
!insmath r
$() du cercle d'équation	<div class="wimscenter">	
!insmath $val9=0
$()	</div>	<ul>	<li> M( 
!read oef/embed.phtml reply 1,4 
$(); 
!read oef/embed.phtml reply 2,4 
$()) </li>	<li> r= 
!read oef/embed.phtml reply 3 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=3
