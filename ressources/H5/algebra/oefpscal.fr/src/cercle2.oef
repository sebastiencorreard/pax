

\title{Equation d'un cercle}

\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{100}

\integer{xo=random(-5..5)}
\integer{yo=random(-5..5)}

\integer{r=random(2..10)}

\function{eqc=maxima(expand((x-\xo)^2+(y-\yo)^2-\r^2))}

\statement{Déterminer le centre \(M) et le rayon \(r) du cercle d'équation
<div class="wimscenter">
\(\eqc=0)
</div>
<ul>
<li> M(\embed{reply 1,4};\embed{reply 2,4}) </li>
<li> r=\embed{reply 3}</li>
</ul>
}

\answer{}{\xo}{type=default}
\answer{}{\yo}{type=default}
\answer{}{\r}{type=default}
