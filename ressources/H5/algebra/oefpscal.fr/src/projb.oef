
  \title{Projeté orthogonal}

\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{100}


\integer{al=random(1..6)}

\integer{a=random(-1,1)*random(1..5)}



\integer{k=random(-1,1)*randint(1..10)}

\integer{xu=random(-1,1)*randint(1..5)}
\integer{yu=\a*\xu}

\integer{b=randint(-5..5)}

y=ax+b est l'équation d'une droite dirigée par vectu

\integer{xn=-1*\yu}
\integer{yn=\xu}

\integer{alv=random(1,2)}
\if{\alv=1}{
  \text{vec=directeur}
  \text{v=\overrightarrow{u}}
  \integer{xv=\xu}
  \integer{yv=\yu}
}

\if{\alv=2}{
  \text{vec=normal}
  \text{v=\overrightarrow{n}}
  \integer{xv=\xn}
  \integer{yv=\yn}
}

Le vecteur normal xn,yn

\integer{x0=randint(-5..5)}

\integer{y0=\a*\x0+\b}

xO,yO est sur d

\integer{x1=\x0+random(-1,1)*randint(1..4)}

\integer{y1=\a*\x1+\b}

x1,y1 aussi

\integer{x2=\x1-\a*\k}

\integer{y2=\y1+\k}

x2,y2 se projette orthogonalement en x1,y1 sur d

\rational{a1=-1/\a}
\rational{b1=\y1-\a1*\x1}

\rational{x3=2*\x1-\x0}

\rational{y3=2*\y1-\y0}

x3,y3 est tel que x1,y1 soit le milieu de x0,y0 x3,y3

y=a1x+b1 est l'équation de la normale à d en x1,y1'

\text{dist=maxima(sqrt((\x1-\x2)^2+(\y1-\y2)^2))}

la distance de x2,y2 à d

\integer{xm=abs(\x2)+4}
\integer{ym=abs(\y2)+4}

\text{valeurs=wims(sort numeric item 19,\xm,\ym)}
\text{M=item(-1,\valeurs)}
\integer{M=(floor(\M/5)+1)*5}
\integer{n=2*\M/5+1}
\integer{rayon=200*\dist/(\M)}
\text{cercle=
  draw(200,200


        xrange -\M,\M
        yrange -\M,\M
        parallel -\M,-\M,\M,-\M,0,5,\n,green
        parallel -\M,-\M,-\M,\M,5,0,\n,green
        linewidth 2
        line -1*\M,0,\M,0,blue
        line 0,-1*\M,0,\M,blue
        linewidth 1
        plot red,\a*x+\b
        fcircle \x2,\y2,5,red
        text green,5,0.5,normal,5
        text green,0.5,5,normal,5
        text red,\x2,\y2,normal,M

  )
}
\text{cerct=
  draw(200,200


        xrange -\M,\M
        yrange -\M,\M
        parallel -\M,-\M,\M,-\M,0,5,\n,green
        parallel -\M,-\M,-\M,\M,5,0,\n,green
        linewidth 2
        line -1*\M,0,\M,0,blue
        line 0,-1*\M,0,\M,blue
        linewidth 1
        plot red,\a*x+\b
        fcircle \x2,\y2,5,red
        text green,5,0.5,normal,5
        text green,0.5,5,normal,5
        text red,\x2,\y2,normal,M
        circle \x2,\y2,\rayon,red
  )
}

\text{med=
  draw(200,200


        xrange -\M,\M
        yrange -\M,\M
        parallel -\M,-\M,\M,-\M,0,5,\n,green
        parallel -\M,-\M,-\M,\M,5,0,\n,green
        linewidth 2
        line -1*\M,0,\M,0,blue
        line 0,-1*\M,0,\M,blue
        linewidth 1
        text green,5,0.5,normal,5
        text green,0.5,5,normal,5
        text red,\x0,\y0,normal,A
       text red,\x3,\y3,normal,B
       fcircle \x0,\y0,5,red
       fcircle \x3,\y3,5,red
       line \x0,\y0,\x3,\y3,red
  )
}

\real{t1=}
\real{t2=}
  \statement{<div class="float_right"><img src="\cercle" alt=""></div>
  On a représenté ci-contre, une droite d passant par A(\x0;\y0) et admettant
  le vecteur \(\overrightarrow{n})(\xn;\yn) pour vecteur normal.
  Déterminer les coordonnées du point H
  projeté orthogonal de M(\x2;\y2) sur d.
<div class="wimscenter">
  H(\embed{reply 1,6};\embed{reply 2,6})
</div>
}
\answer{abs}{\x1}{type=default}
\answer{ord}{\y1}{type=default}
