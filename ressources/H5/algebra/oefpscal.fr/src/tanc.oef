\text{valeurs=wims(sort numeric item 19,\xm,\ym)}
\text{M=item(-1,\valeurs)}
\integer{M=(floor(\M/5)+1)*5}
\integer{n=2*\M/5+1}
\integer{rayon=200*\dist/(\M)}
\text{cercle=
  draw(200,200
	xrange -\M,\M
	yrange -\M,\M
	parallel -\M,-\M,\M,-\M,0,5,\n,green
	parallel -\M,-\M,-\M,\M,5,0,\n,green
	linewidth 2
	line -1*\M,0,\M,0,blue
	line 0,-1*\M,0,\M,blue
	linewidth 1
	plot red,\a*x+\b
	fcircle \x2,\y2,5,red
	text green,5,0.5,normal,5
	text green,0.5,5,normal,5
	text red,\x2,\y2,normal,M

  )
}
\text{cerct=
  draw(200,200
	xrange -\M,\M
	yrange -\M,\M
	parallel -\M,-\M,\M,-\M,0,5,\n,green
	parallel -\M,-\M,-\M,\M,5,0,\n,green
	linewidth 2
	line -1*\M,0,\M,0,blue
	line 0,-1*\M,0,\M,blue
	linewidth 1
	plot red,\a*x+\b
	fcircle \x2,\y2,5,red
	text green,5,0.5,normal,5
	text green,0.5,5,normal,5
	text red,\x2,\y2,normal,M
	circle \x2,\y2,\rayon,red
  )
}

\text{med=
  draw(200,200
	xrange -\M,\M
	yrange -\M,\M
	parallel -\M,-\M,\M,-\M,0,5,\n,green
	parallel -\M,-\M,-\M,\M,5,0,\n,green
	linewidth 2
