!set title=Numéro d'un contrôle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5

val6=$[rint($(tmp0))]
val7=le percepteur contrôle les impôts de l'entreprise Picsou
val8=le service d'hygiène contrôle l'épicerie de Vincent Time
val9=le service vétérinaire effectue un contrôle à l'abattoir Sanzot
val10=les pompiers effectuent un contrôle de la sécurité de la clinique des Lilas
val11=la maintenance de l'usine Hagaz effectue un contrôle de la chaîne de montage
val12=$val7,$val8,$val9,$val10,$val11
val13=$(val12[$val6])
tmp0=!randint 2, 5

val14=$[rint($(tmp0))]
tmp0=!randint 13, 19

val15=$[rint($(tmp0))]
tmp0=!randint 2, 12

val16=$[rint(2000+$(tmp0))]
tmp0=!randint 4, 8

val17=$[rint($(tmp0))]
val18=$[rint($val15+$val17)]
val19=$[rint($val16+$val17*$val14)]
val20=$[rint($val16+(1-$val15)*$val14)]
replytype1=default
replyname1=Numéro du contrôle de l'année $val19
replygood1=$val18
replytype2=default
replyname2=Année du premier contrôle
replygood2=$val20
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		Tous les $val14 ans, $val13.	<ul><li>	<label for="reply1">Si le $val15-ième contrôle correspond à l'année 
!insmath u_{$val15} = $val16
$(),	quel est le numéro du contrôle de l'année $val19 ?</label>	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,5 
$()	</div>	<div class="wims_instruction">Répondre par un nombre entier.</div>	</li><li><label for="reply2">À quelle année 
!insmath u_1
$() correspond le premier contrôle ?</label>	<div class="wimscenter">	 
!read oef/embed.phtml reply 2,5 
$()	</div>	</li></ul>	
$()
!exit

:hint
$()Il s'agit d'une suite arithmétique de raison $val14.	<ul><li>	Combien de fois faut-il ajouter $val14 pour passer de $val16 à $val19 ?	</li><li>	Et pour diminuer de
!insmath u_$val15
$() à 
!insmath u_1
$() ?	</li></ul>
$()
!exit

:help
$()
$()
!exit

:solution
$()Il s'agit d'une suite arithmétique de raison $val14.	<ul><li>	Pour passer de $val16 à $val19 il faut ajouter : 
!insmath \frac{$val19-$val16}{$val14} = $val17
$() fois le nombre $val14.	</li><li>	Le numéro du contrôle de l'année $val19 est donc $val15 + $val17 = $val18.</li><li>	Pour diminuer de 
!insmath u_$val15
$() à 
!insmath u_1
$(), on retranche 
!insmath ($val15-1)
$() fois $val14 à $val16 et	on obtient l'année 
!insmath $val16-($val15-1)*$val14=$val20
$().	</li></ul>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14,15,16,17,18,19,20
embedcnt=2
