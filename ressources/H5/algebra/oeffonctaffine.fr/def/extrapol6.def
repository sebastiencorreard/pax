!set title=Trouver une fonction affine 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,0,1

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]

!ifval $val6=0
val7=$[rint($val7)]
!else
val7=$[rint(-$val7)]
!endif
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 6, 12

val9=$[rint($(tmp0))]
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
val11=$[rint($val9+$val10)]
val12=$[rint($val7*$val9+$val8)]
val13=$[rint($val7*$val11+$val8)]
!if $val12=$val9 
val9=$[rint($val9-1)]
val12=$[rint($val7*$val9+$val8)]
!endif
!if $val13=$val11 
val11=$[rint($val11+1)]
val13=$[rint($val7*$val11+$val8)]
!endif
val14=!rawmath $val7(x-$val9)+$val12
val15=!rawmath $val7*x+$val8
val16=10
oefsteps=reply1	reply2, reply3	reply4 
nextstep=!nosubst reply1	reply2, reply3	reply4 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Coefficient directeur
replygood1=$[$val7]
replytype2=numeric
replyname2=xA
replygood2=?analyze 17
replytype3=numeric
replyname3=yA
replygood3=?analyze 18
replytype4=litexp
replyname4=\(f(x))
replygood4=$val15
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la fonction affine 
!insmath f
$() telle que :	<div class="wimscenter">	
!insmath f($val9)= $val12
$()   et  
!insmath f($val11)= $val13
$()	</div>		
!if $m_step=1 
$()	<label for="reply1">Le coefficient directeur de 
!insmath f
$() est :</label>  
!read oef/embed.phtml reply 1,6 
$()	 
!endif
$()	
!if $m_step=2 
$()	Le coefficient directeur de 
!insmath f
$() est bien $val7. Compléter :	<div class="wimscenter"> <label for="reply2">
!insmath f(x) = $val7
$()  (
!insmath x
$() - </label>	 
!read oef/embed.phtml reply 2,6 
$()) <label for="reply3">+ </label> 
!read oef/embed.phtml reply 3,6 
$()</div>	 
!endif
$()	
!if $m_step=3 
$()	Déterminer la fonction affine 
!insmath f
$() en développant :	<div class="wimscenter">	<label for="reply4">
!insmath f(x)= $val7 (x - $val9) + $val12 =
$()</label>  
!read oef/embed.phtml reply4,$val16 
$()</div>	 
!endif
$()		
$()
!exit

:hint
$()	<ul><li>	On considère les points A(
!insmath x_A
$();
!insmath f(x_A)
$()) et B(
!insmath x_B
$();
!insmath f(x_B)
$()).</li><li>	Le coefficient directeur est 
!insmath a =\frac{y_B - y_A}{x_B - x_A}
$().</li><li>	
!insmath f(x) = a(x -x_A) + y_A
$().</li></ul>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>$m_reply2,$m_reply3
$()</div>
!endif
!ifval ($val17 = $val12 and $val18 = $val9) or ($val17 = $val13 and $val18 = $val11)
 <div class='oef_feedbacks'>	Vous avez inversé les coordonnées à la deuxième étape.
$()</div>
!endif

!exit

:test

!ifval $val18=$val7*$val17 + $val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse

!exit

:stat
vsavelist=7,8,9,11,12,13,16,17,18
embedcnt=4
