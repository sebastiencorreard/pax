val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]

!ifval $val6=$val7 
val8=$[rint( 1+ $val7)]
!else
val8=$[rint( $val7)]
!endif
tmp0=!randitem -1,1

val9=$[rint($(tmp0))]
val10=$[rint($val9*$val6)]
tmp0=!randitem -1,1

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val8)]
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val13=$[rint($(tmp0)*$(tmp1))]
val14=$[rint($val10*$val13-$val12)]
val15=\($val10)
val16=\($val8)

!ifval $val11>0
val17=+
!else
val17=&#0151
!endif

!ifval $val11>0
val18=&#0151
!else
val18=+
!endif

!ifval $val9>0
val19=+
!else
val19=&#0151
!endif

!ifval $val9>0
val20=&#0151
!else
val20=+
!endif
val21=\(\times) ($val10)
val22=\($val10 x)
val23=$val17 ($val8)
val24=\(x + $val12)
val25=$val18 ($val8)
val26=\(\div) ($val10)
val27=\(\div) ($val12)
val28=$val19 ($val6)
val29=\(\times) ($val12)
val30=$val20 ($val6)
val31=$[rint($val14+$val12)]

!ifval $val11=1
val32= \(\frac{x + $val8}{$val10})
!else
val32= \(\frac{x - $val8}{$val10})
!endif
tmp0=!shuffle $val21,$val23,$val25,$val26,$val27,$val28,$val29,$val30

val33=$(tmp0)
