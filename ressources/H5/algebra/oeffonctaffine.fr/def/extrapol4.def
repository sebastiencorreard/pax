!set title=Coût d'une quantité variable continue
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r,r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 12

val6=$[rint($(tmp0))]
val7=d'eau potable,de gaz,d'électricité,de fuel,de ciment,de bois de chauffage,de farine,de lait,de pommes,de prunes,de poires,de cerises,de citrons
val8=\(m^3),\(m^3),kWh,litre,kg,\(m^3),kg,litre,kg,kg,kg,kg,kg,kg,kg
val9=\(m^3),\(m^3),kWh,litres,kg,\(m^3),kg,litres,kg,kg,kg,kg,kg,kg,kg
val10=$(val8[$val6])
val11=$(val7[$val6])
val12=$(val9[$val6])

!ifval $val6<4 
val13= l'abonnement
!else
val13=le transport
!endif
tmp=!trim 2.3,6.3,5,30,30,70	0.38,0.58,29,49,200,700	0.09,0.14,15,25,150,650	0.5,0.9,8,30,50,250	0.2,1.2,5.1,8.1,100,600	135,175,20,30,3,13	1.8,2.8,4,9,20,120	0.5,1,4,8,20,60	2.5,3.5,2,7,10,50	1,3,3,4,5,25	1.5,3,3,4,5,25	2,12,3,5,5,25	0.5,3,3,4,5,25	
val14=!translate internal $	\
$ to ;; in $tmp
val15=$[$(val14[$val6;1])]
val16=$[$(val14[$val6;2])]
val17=$[$(val14[$val6;3])]
val18=$[$(val14[$val6;4])]
val19=$[$(val14[$val6;5])]
val20=$[$(val14[$val6;6])]
tmp0=!randint 0, 10

val21=$[$val15+0.1*($val16-$val15)*$(tmp0)]
tmp0=!randint 0, 10

val22=$[$val17+0.1*($val18-$val17)*$(tmp0)]
tmp0=!randint 0, 5

val23=$[$val19+0.05*($val20-$val19)*$(tmp0)]
val24=$[$val21 *$val23 +$val22]
tmp0=!randint 15, 20

val25=$[$val19+0.05*($val20-$val19)*$(tmp0)]
val26=$[$val21 *$val25 +$val22]
val27=$[$val25 - $val23]
val28=$[$val26 - $val24]
val29=!rawmath $val21*x+$val22
tmp0=!randint 7, 13

val30=$[$val19+0.05*($val20-$val19)*$(tmp0)]
val31=$[$val21 *$val30 +$val22]
replytype1=default
replyname1=Prix de chaque $val10 supplémentaire
replygood1=$val21
replytype2=default
replyname2=Prix de $val30 $val11
replygood2=$val31
replytype3=default
replyname3=Coût pour $val13
replygood3=$val22
replytype4=formal
replyname4=Coût total pour \(x) $val11
replygood4=$val29
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  La facture $val11 comporte un prix fixe pour $val13 et un prix proportionnel à la quantité $val11.	  Le prix total pour $val23 $val12 $val11 est $val24 &euro; et pour $val25 $val12 $val11, il est de $val26 &euro;.	  <ul><li><label for="reply1">	  Quel est le prix de chaque $val10 $val11 supplémentaire (sans $val13)</label> ?  
!read oef/embed.phtml reply 1,5 
$() &euro;	  </li><li><label for="reply2">	  Quel est le prix de $val30 $val12 $val11, $val13 compris ? </label> 
!read oef/embed.phtml reply 2,5 
$() &euro;	  </li><li>	  <label for="reply3">Combien coûte $val13 ?</label>  
!read oef/embed.phtml reply 3,5 
$() &euro;.	  </li><li><label for="reply4">	  Finalement le coût total pour 
!insmath x
$() $val12 $val11, $val13 compris est </label>:  
!read oef/embed.phtml reply 4,15 
$() &euro;	  </li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	  <ul><li>	  Le prix supplémentaire pour chaque $val10 $val11 est 
!insmath ($val26 - $val24)/($val25 - $val23)
$() = $val21 &euro;.	  Pour $val30 $val12 $val11, le coût total est 
!insmath $val21 * ($val30 - $val23) + $val24 = $val31
$() &euro;.	  </li><li>	  Et $val13 coûte 
!insmath $val24 - $val21 *$val23 = $val22
$() &euro;.	  </li><li>	  Pour 
!insmath x
$() $val12 $val11 le coût total est 
!insmath $val21 * (x - $val23) + $val24 = $val21 * x + $val22
$() &euro;.	  </li></ul>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,21,22,23,24,25,26,30,31
embedcnt=4
