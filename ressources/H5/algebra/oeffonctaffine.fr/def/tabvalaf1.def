!set title=Tableau de valeurs d'une fonction affine 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,0,1

val6=$[rint($(tmp0))]
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 6, 12

val9=$[rint($(tmp0))]
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
val11=$[rint($val9+$val10)]
val12=$[rint($val7*$val9+$val8)]
val13=$[rint($val7*$val11+$val8)]
val14=$[rint($val13-$val12)]
val15=$[rint($val9-$val10)]
val16=$[rint($val11+$val10)]
val17=$[rint($val16+1)]
val18=$[rint($val7*$val15+$val8)]
val19=$[rint($val7*$val16+$val8)]
val20=$[rint($val7*$val17+$val8)]
val21=$[rint($val7*$val15)]
val22=<ul><li>Lorsque \(x\) augmente de $val10, l'image \(f(x)\) augmente de $val14.</li><li>	  Lorsque \(x\) augmente de 1, l'image \(f(x)\) augmente de $val7.</li><li>	  Lorsque \(x\) diminue de $val10, l'image \(f(x)\) diminue de $val14.</li><li>	  Lorsque \(x\) diminue de $val15, l'image \(f(x)\) diminue de $val21.</li></ul>
val23=10
val24=Compléter le tableau de valeurs d'une fonction affine.
val25=Les écarts sur les images \(f(x)\) sont proportionnels aux	  écarts sur les \(x\).	  De combien augmente \(x\) de $val9 à $val11 ? et \(f(x)\) de $val12 à $val13 ?	
tmp=!trim ,,,,+ reply5,,	\(x\),0,$val15,$val9,,$val11,$val16,$val17	\(f(x)\),reply1,reply2,$val12,,$val13,reply3,reply4	,,,,+ reply6,,
val26=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val26],wimscenter wimsborder,TH=[;1] CAPTION="Tableau" 
tmp0=$slib_out
val27=$(tmp0)
replytype1=default
replyname1=\(f(0)\)
replygood1=$val8
replytype2=default
replyname2=\(f($val15)\)
replygood2=$val18
replytype3=default
replyname3=\(f($val16)\)
replygood3=$val19
replytype4=default
replyname4=\(f($val17)\)
replygood4=$val20
replytype5=default
replyname5=$val11 - $val9
replygood5=$val10
replytype6=default
replyname6=$val13 - $val12
replygood6=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val25

solution=!nosubst $val22


!goto stat

!exit

