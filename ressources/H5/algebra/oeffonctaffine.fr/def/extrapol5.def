 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]

!ifval $val6=$val7 
val8=$[rint( 1+ $val7)]
!else
val8=$[rint( $val7)]
!endif
tmp0=!randitem -1,1

val9=$[rint($(tmp0))]
val6=$[rint($val9*$val6)]
tmp0=!randitem -1,1

val10=$[rint($(tmp0))]
val11=$[rint($val10*$val8)]
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val12=$[rint($(tmp0)*$(tmp1))]
val13=$[rint($val6*$val12+$val11)]
val14=$val6 x + $val11
val15=\($val6)
val16=\($val8)

!ifval $val10>0
val17=+
!else
val17=&mdash;
!endif

!ifval $val10>0
val18=&mdash;
!else
val18=+
!endif
val19=\(\times) ($val6)
val20=\($val6 x)
val21=$val17 ($val8)
val22=\(x + $val11)
val23=$val18 ($val8)
val24=\(\div) ($val6)
val25=\(\div) ($val11)
val26=+ ($val6)
val27=\(\times) ($val11)
val28=$[rint($val13-$val11)]
tmp0=!shuffle $val19,$val21,$val23,$val24,$val25,$val26,$val27

val29=$(tmp0)
val30=$(val29[1]),$(val29[2]),$(val29[3]),$(val29[4]),$(val29[5]),$(val29[6]),$(val29[7])
tmp0=!shuffle $val20,$val22

val31=$(tmp0)
val32=$(val31[1]),$(val31[2])
val33=50x30x1
oefsteps=reply1,reply2,reply3	reply4,reply5	reply6,reply7,reply8,reply9 
nextstep=!nosubst reply1,reply2,reply3	reply4,reply5	reply6,reply7,reply8,reply9 
!readproc oef/steps.proc
replytype1=clickfill
replyname1=
replygood1=$val19;$val30
replytype2=clickfill
replyname2=
replygood2=$val20;$val32
replytype3=clickfill
replyname3=
replygood3=$val21;$val30
replytype4=clickfill
replyname4=
replygood4=$val23;$val30
replytype5=clickfill
replyname5=
replygood5=$val24;$val30
replytype6=numeric
replyname6=
replygood6=$[$val28]
replytype7=numeric
replyname7=
replygood7=$[$val12]
replytype8=numeric
replyname8=
replygood8=$[$val28]
replytype9=numeric
replyname9=
replygood9=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

