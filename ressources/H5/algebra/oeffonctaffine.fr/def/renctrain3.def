val30=$[$val10 / 2]
val31=$[rint(round($val17 - 60*floor($val17/60)))]
val32=$[rint($val6 + floor($val17/60))]
val33=$[rint($val6+1)]
val34=$[rint(max($val19,$val20)+20)]
val35=$[rint($val8+10)]
val36=xrange -30,$val34	yrange -30,$val35	linewidth 1	parallel 0,0,$val34,0,0,10,20,black	parallel 0,0,0,$val8,5,0,60,black	linewidth 3	parallel 0,0,0,$val35,60,0,4,black	parallel 0,50,$val34,50,0,50,7,black	arrow 0,0,$val34,0,10,black	arrow 0,0,0,$val35,10,black	linewidth 4	segment 0,$val8,$val34,$val8,black	segment $val12,0,$val19,$val8,blue	segment $val14,$val8,$val20,0,red		text black, -3,-1,large,$val6 h	text black, 57,-1,large,$val33 h	text black, -7,2,large, 0	text black, -14,52,large,50 km	text black, -15,102,large,100 km	text black, -15,152,large,150 km	text black, -15,202,large,200 km	text black, -15,252,large,250 km	text black, $val12,-2,large,$val22 h $val21	text black, $val14,$val35,large,$val24 h $val23	text black, $val19,$val35,large,$val26 h $val25	text black, $val20,-2,large,$val28 h $val27	
val37=Réalisez un graphique en graduant l'axe horizontal	  de 5 minutes en 5 minutes à partir de $val6 h. Puis calculez	  la vitesse en km/min du 1er train pour connaître la distance	  par rapport à Arnes.
replytype1=default
replyname1=Heure du croisement
replygood1=$val32
