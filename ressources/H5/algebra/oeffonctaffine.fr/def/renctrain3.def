val18=$[0.5*$val9*($val17 - $val12)]
val19=$[rint(round($val12 + $val8/$val15*60))]
val20=$[rint(round($val14 + $val8/$val16*60))]
val21=$[rint($val12 - 60*floor($val12/60))]
val22=$[rint($val6 + floor($val12/60))]
val23=$[rint($val14 - 60*floor($val14/60))]
val24=$[rint($val6 + floor($val14/60))]
val25=$[rint($val19 - 60*floor($val19/60))]
