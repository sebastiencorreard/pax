!set title=Fonction affine d'après un graphique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
val7=500
val8=500
val9=-4.5
val10=4.5
val11=-4.5
val12=4.5
val13=linewidth 1	parallel 0,$val11,0,$val12,0.2,0,floor(5*($val10))+1,$val6	parallel 0,$val11,0,$val12,-0.2,0,floor(5*abs($val9))+1,$val6	parallel $val9,0,$val10,0,0,0.2,floor(5*($val12))+1,$val6	parallel $val9,0,$val10,0,0,-0.2,floor(5*abs($val11))+1,$val6	
val14=linewidth 3	parallel 0,$val11,0,$val12,1,0,floor($val10+1),$val6	parallel 0,$val11,0,$val12,-1,0,floor(abs($val9)+1),$val6	parallel $val9,0,$val10,0,0,1,floor($val12+1),$val6	parallel $val9,0,$val10,0,0,-1,floor(abs($val11)+1),$val6	
val15=linewidth 2	vline 0,0,black	hline 0,0,black		text black,0.9,-0.1,medium,1	text black,-0.2,1.1,medium,1	text black,-0.2,-0.1,medium,O	arrow $val10-1,0,$val10,0,10,black	arrow 0,$val12-1,0,$val12,10,black	text black,$val10-0.2,-0.2,medium,x	text black,-0.2,$val12-0.2,medium,y	
val16=xrange $val9,$val10	yrange $val11,$val12	$val13	$val14	$val15	
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 2

val18=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 2

val19=$[rint($val18+$(tmp0)*$(tmp1))]
t_=!rawmath ($val19-$val18)/$val17
val20=!exec pari print($t_)
val21=!rawmath $val18+($val20)*x
tmp0=!texmath $val21

val22=$(tmp0)
val23=$[rint($val17-\x1)]
val24=$[rint($val19-\y1)]
tmp0=!shuffle 3

val25=$(tmp0)
val26=red,orange,green
val27=rouge,orange,vert
val28=$val16	linewidth 2	plot $(val26[$(val25[1])]),$val21	
replytype1=formal
replyname1=\(f(x))
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	  Quelle est la formule de la fonction affine	  représentée par la droite <b>D</b> en $(val27[$(val25[1])])	  ci-dessous ?	</p><div class="wimscenter">	   
!read oef/draw.phtml $val7,$val8 \
	 $val28	  
$()	 </div>	<b>Votre réponse.</b> <label for="reply1">
!insmath f(x) =
$() </label> 
!read oef/embed.phtml reply 1,10 
$().	
$()
!exit

:hint
$()	  Vous pouvez utiliser le théorème suivant en prenant pour	  <b>A</b> et <b>B</b> deux points appropriés du plan.	  <p>	  <b>Théorème:</b> Soient 
!insmath A(x_{A},y_{A})
$() et	  
!insmath B(x_{B},y_{B})
$() deux points du plan.	 </p><p>	  Si 
!insmath x_{A}\neq x_{B}
$(), alors la fonction affine 
!insmath f
$() représentée	  par la droite 
!insmath (AB)
$() a pour coefficient directeur	   
!insmath a=\frac{y_B-y_A}{x_B-x_A}
$() et pour ordonnée à l'origine 
!insmath f(0)
$().	  </p>	
$()
!exit

:help
$()
$()
!exit

:solution
$()	  <p>	  La droite a pour coefficient directeur 
!insmath a=\frac{$val19-($val18)}{$val17-0}=$val20
$()	  et pour ordonnée à l'origine 
!insmath b = f(0)= $val18
$().<br>	  Donc la formule est 
!insmath f(x) =$val21
$().	  </p>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,17,18,19,20,21,25,27,28
embedcnt=1
