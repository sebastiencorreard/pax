ansorder=r,r,r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,0,1

val6=$[rint($(tmp0))]
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]

!ifval $val6=0
val7=$[rint($val7)]
!else
val7=$[rint(-$val7)]
!endif
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val7>0
val8=$[rint($val8)]
!else
val8=$[rint($val8-20*$val7)]
!endif
tmp0=!randint 6, 10

val9=$[rint($(tmp0))]
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
val11=$[rint($val9+$val10)]
val12=$[rint($val7*$val9+$val8)]
val13=$[rint($val7*$val11+$val8)]
val14=$[rint($val9-$val10)]
val15=$[rint($val11+$val10)]
val16=$[rint($val15+1)]
val17=$[rint($val7*$val14+$val8)]
val18=$[rint($val7*$val15+$val8)]
val19=$[rint($val7*$val16+$val8)]
val20=10
val21=Compléter le tableau de valeurs d'une fonction affine.
val22=Le coefficient directeur de \(f\) est \(a =\)
val23=<ul><li>Les écarts sur les images \(f(x)\) sont proportionnels aux écarts sur les \(x\).</li><li>	  Le coefficient de proportionnalité est le coefficient directeur \(a\).</li><li>	  Autrement dit \(a = \frac{f($val11) - f($val9)}{$val11 - $val9}\).</li></ul>	
tmp=!trim \(x\),0,$val14,$val9,$val11,$val15,$val16	\(f(x)\),reply1,reply2,$val12,$val13,reply3,reply4
val24=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val24],wimscenter wimsborder,TH=[1;1] CAPTION="Tableau" 
tmp0=$slib_out
val25=$(tmp0)
replytype1=default
replyname1=\(f(0)\)
replygood1=$val8
replytype2=default
replyname2=\(f($val14)\)
replygood2=$val17
replytype3=default
replyname3=\(f($val15)\)
replygood3=$val18
replytype4=default
replyname4=\(f($val16)\)
replygood4=$val19
replytype5=default
replyname5=\(a\)
replygood5=$val7
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val23


!goto stat

!exit

