!set title=Traduction mathématique 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem CD,DVD,gâteaux,seaux,foulards,colliers,bracelets,ballons,jeux

val6=$(tmp0)
tmp0=!randitem 1,3,5,7

val7=$[3+0.5*$(tmp0)]
tmp0=!randint 3, 10

val8=$[rint($(tmp0))]
val9=$[$val8*$val7]
tmp0=!randint 1, 4

val10=$[rint(10*ceil(0.1*$val8*$val7)+10*$(tmp0))]
!if s=2*$val9 
!endif
val11=$[$val10-$val9]
replytype1=numeric
replyname1=Reste
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">	  Vous avez $val10 &euro;.	  Vous achetez $val8 $val6 qui coûte chacun $val7 &euro;.	  Combien vous reste-t-il ?	  </div>	  <label for="reply1">Il vous reste </label>  
!read oef/embed.phtml reply 1,6 
$() &euro;.	  <div class="wims_instruction">	  Vous pouvez écrire l'opération ou le résultat, utilisez <span class="tt">*</span>	  pour multiplier,	  <span class="tt"> /</span> pour diviser et écrire les nombres décimaux avec	  un point à la place de la virgule.	  Par exemple,
!insmath 7*21/3
$()+4,25 s'écrit <span class="tt">7*21/3+4.25</span>	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Il vous reste : 
!insmath $val10 - $val8*$val7 = $val11
$() &euro;.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,11
embedcnt=1
