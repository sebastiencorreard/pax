!set title=Coût d'un lot de voitures miniatures
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r,r,r,r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,3,5,7

val6=$[3+0.5*$(tmp0)]
tmp0=!randint 7, 19

val7=$[rint($(tmp0))]
tmp0=!randint 0, 10

val8=$[rint(10+2*$(tmp0))]
val9=$[rint($val6 *$val8 +$val7)]
tmp0=!randint 2, 10

val10=$[rint($val8 +10*$(tmp0))]
val11=$[rint($val6 *$val10 +$val7)]
val12=$[rint($val8 +10)]
val13=$[rint($val6 *$val12 +$val7)]
val14=$[rint($val10 - $val8)]
val15=$[rint($val11 - $val9)]
val16=Nombre de voitures supplémentaires
replytype1=default
replyname1=Nombre
replygood1=$val14
replytype2=default
replyname2=dy
replygood2=$val15
replytype3=default
replyname3=a
replygood3=$val6
replytype4=default
replyname4=y3
replygood4=$val13
replytype5=default
replyname5=a
replygood5=$val6
replytype6=default
replyname6=a
replygood6=$val6
replytype7=default
replyname7=a
replygood7=$val6
replytype8=default
replyname8=b
replygood8=$val7
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question"><p>Pour un achat par correspondance de voitures miniatures,	on paye un prix fixe pour l'envoi par la Poste	et un prix proportionnel au nombre de voitures.	</p><p>	Le prix total pour $val8 voitures miniatures $val9 euros et pour $val10, il est de $val11 euros.	</p>	</div>	<ul class="wims_nopuce">	<li>	Entre $val8 et $val10, <label for="reply1">le nombre de voitures augmente de</label>	 
!read oef/embed.phtml reply 1,6 
$()	et <label for="reply2">le prix de</label>  
!read oef/embed.phtml reply 2,6 
$() euros.	</li><li>	<label for="reply3">Le prix supplémentaire pour chaque voiture est :</label>  
!read oef/embed.phtml reply 3,6 
$() euros.	</li><li>	<label for="reply4">Le prix total pour $val12 voitures (soit $val8 + 10) est :</label>	  
!read oef/embed.phtml reply 4,6 
$() euros. </li><li>	<label for="reply5">Si on achète en tout 
!insmath x
$() voitures, le coût supplémentaire	  par rapport à $val8 est:</label>	  
!read oef/embed.phtml reply 5,6 
$() (
!insmath x - $val8
$()) euros. </li><li>	<label for="reply6">Ce qui donne au total :</label>	  
!read oef/embed.phtml reply 6,6 
$() (
!insmath x - $val8
$()) + $val9 euros.</li><li>	<label for="reply7">Finalement le coût total pour 
!insmath x
$() voitures miniatures est :</label>	   
!read oef/embed.phtml reply 7,6 
$() 
!insmath x
$() +  
!read oef/embed.phtml reply 8,6 
$() euros.	  </li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	<p>Le prix supplémentaire pour chaque voiture est 
!insmath ($val9 - $val11)/($val8 - $val10)
$() = $val6 .	</p><p>	Pour $val12 voitures le coût total est $val6 * ($val12 - $val8) + $val9.	</p>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,10,11,12
embedcnt=8
