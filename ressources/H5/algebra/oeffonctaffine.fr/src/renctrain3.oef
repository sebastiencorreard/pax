\title{Rencontre de trains 3}
\language{fr}
\range{-5..5}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{10000}

### Les trains partent à un multiple de 5 minutes après h0 ###
\integer{h0=randint(7..10)}
\integer{d=6*randint(4..7)}
\integer{L=5*\d}
\integer{n1=randint(2..5)}
\integer{n2=randint(2..5)}
\integer{s1=randint(0..2)}
\integer{t1=5*\s1}
\integer{s2=randint(3..5)}
\integer{t2=5*\s2}
\integer{v1=30*\n1}
\integer{v2=30*\n2}
\real{t=5*(2*\d+\n1*\s1 + \n2*\s2)/(\n1 + \n2)}
\real{Di=0.5*\n1*(\t - \t1)}
\integer{t3=round(\t1 + \L/\v1*60)}
\integer{t4=round(\t2 + \L/\v2*60)}

\integer{m1=\t1 - 60*floor(\t1/60)}
\integer{h1=\h0 + floor(\t1/60)}
\integer{m2=\t2 - 60*floor(\t2/60)}
\integer{h2=\h0 + floor(\t2/60)}
\integer{m3=\t3 - 60*floor(\t3/60)}
\integer{h3=\h0 + floor(\t3/60)}
\integer{m4=\t4 - 60*floor(\t4/60)}
\integer{h4=\h0 + floor(\t4/60)}
\real{w1=\n1 / 2}
\real{w2=\n2 / 2}

\integer{m=round(\t - 60*floor(\t/60))}
\integer{h=\h0 + floor(\t/60)}

\integer{tg1=\h0+1}
\integer{xM=max(\t3,\t4)+20}
\integer{LM=\L+10}
\text{graph= xrange -30,\xM
yrange -30,\LM
linewidth 1
parallel 0,0,\xM,0,0,10,20,black
parallel 0,0,0,\L,5,0,60,black
linewidth 3
parallel 0,0,0,\LM,60,0,4,black
parallel 0,50,\xM,50,0,50,7,black
arrow 0,0,\xM,0,10,black
arrow 0,0,0,\LM,10,black
linewidth 4
segment 0,\L,\xM,\L,black
segment \t1,0,\t3,\L,blue
segment \t2,\L,\t4,0,red

text black, -3,-1,large,\h0 h
text black, 57,-1,large,\tg1 h
text black, -7,2,large, 0
text black, -14,52,large,50 km
text black, -15,102,large,100 km
text black, -15,152,large,150 km
text black, -15,202,large,200 km
text black, -15,252,large,250 km
text black, \t1,-2,large,\h1 h \m1
text black, \t2,\LM,large,\h2 h \m2
text black, \t3,\LM,large,\h3 h \m3
text black, \t4,-2,large,\h4 h \m4
}

\text{name_hint=Réalisez un graphique en graduant l'axe horizontal
  de 5 minutes en 5 minutes à partir de \h0 h. Puis calculez
  la vitesse en km/min du 1er train pour connaître la distance
  par rapport à Arnes.}

\statement{
<ul><li>
Les villes Arnes et Buluc sont distantes de \L km.
</li><li>
Le train N°1 part de Arnes à \h1 h \m1 min et arrive à Buluc \h3 h \m3 min à
la vitesse de \w1 km/min.
</li><li>
Le train N°2 part de Buluc à \h2 h \m2 min et arrive à Arnes \h4 h \m4 min à
la vitesse de \w2 km/min.
</li></ul>
<div class="wims_question">
<ul><li>
<p>
A quelle heure les deux trains se croiseront-ils (à 5 minutes près) ?
</p>
Réponse :
<label for="reply1">Ils se croiseront à</label> \embed{reply1,3} h \embed{reply2,3}
<label for="reply2">min.</label>
</li><li>
<p>A quelle distance de Arnes se croiseront-ils (à 5 km près) ?</p>
Réponse :
<label for="reply3">Ils se croiseront à</label>
\embed{reply3,4} km de Arnes.
</li></ul>
</div>
}
\hint{\name_hint}

\answer{Heure du croisement}{\h}{type=default}
\answer{Minutes du croisement}{\m-5,\m+5,\m}{type=range}
\answer{Distance de Arnes}{\Di-5, \Di+5, \Di}{type=range}

\solution{
<div class="float_right">\draw{800,400}{\graph}
Les trains se croisent \(x) minutes après \h0 h avec :
<div class="wimscenter">
\(\w1(x-\t1)=\L-\w2(x-\t2)).
</div>
</div>}
