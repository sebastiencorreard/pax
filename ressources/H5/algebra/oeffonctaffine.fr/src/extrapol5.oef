\title{Décomposer et résoudre une équation}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## choix des paramètres en évitant de réutiliser les mêmes chiffres

\integer{a=random(2..9)}
\integer{b1=random(1..9)}

\integer{b0= \a=\b1 ? 1+ \b1: \b1}

\integer{s=random(-1,1)}
\integer{a=\s*\a}
\integer{cb=random(-1,1)}
\integer{b=\cb*\b0}

## Choix de la solution
\integer{x=random(-1,1)*random(1..9)}

## Calcul de la cible
\integer{c=\a*\x+\b}
\text{tf=\a x + \b}

### la liste des objets que l'on peut cliquer pour résoudre l'exercice ###
\text{ta=\(\a)}
\text{tb0=\(\b0)} ## Valeur de b sans le signe
\text{sb=\cb>0?+:&mdash;} ## signe de b
\text{msb=\cb>0?&mdash;:+} ## signe de -b
\text{t1=\(\times) (\a)}
\text{t2=\(\a x)}
\text{t3=\sb (\b0)}
\text{t4=\(x + \b)}
\text{t5=\msb (\b0)}
\text{t6=\(\div) (\a)}

\text{t7=\(\div) (\b)}
\text{t8=+ (\a)}
\text{t9=\(\times) (\b)}

\integer{s6=\c-\b}

\text{permut=shuffle(\t1,\t3,\t5,\t6,\t7,\t8,\t9)}
\text{clicList=\permut[1],\permut[2],\permut[3],\permut[4],\permut[5],\permut[6],\permut[7]}
\text{perm=shuffle(\t2,\t4)}
\text{clicList2=\perm[1],\perm[2]}

## taille des symboles et des champs à remplir par clic LxHxnb ##
\text{size=50x30x1}

\steps{reply1,reply2,reply3
reply4,reply5
reply6,reply7,reply8,reply9}

####### enoncé de l'exo #######

\statement{
  \if{\step=1}{
  Décomposer \(f(x)= \tf\).
<table class="wimscenter wimsnoborder">
 <tr>
  <td></td><td>\embed{reply1,\size}</td><td></td><td>\embed{reply3,\size}</td><td></td>
 </tr><tr>
  <td>\(x)</td><td>\(\longrightarrow\)</td><td>\embed{reply2,\size}</td><td>\(\longrightarrow\)</td><td>\(\tf)</td>
 </tr>
</table>
}
  \if{\step=2}{
  Trouver les opérations réciproques :
<table class="wimscenter wimsnoborder">
  <tr>
  <td></td><td>\t1</td><td></td><td>\t3</td><td></td>
 </tr><tr>
  <td>\(x)</td><td>\(\longrightarrow\)</td><td>\t2</td><td>\(\longrightarrow\)</td><td>\(\tf)</td>
 </tr><tr>
  <td>\(x)</td><td>\(\longleftarrow\)</td><td>\t2</td><td>\(\longleftarrow\)</td><td>\(\tf)</td>
 </tr><tr>
  <td></td><td>\embed{reply5,\size}</td><td></td><td>\embed{reply4,\size}</td><td></td>
 </tr>
</table>
}
  \if{\step=3}{
  On veut résoudre l'équation \(\tf = \c\) c'est-à-dire retrouver l'antécédent de \c.
<table class="wimscenter wimsnoborder">
  <tr>
  <td></td><td>\t1</td><td></td><td>\t3</td><td></td>
 </tr><tr>
  <td>\(x)</td><td>\(\longleftarrow\)</td><td>\t2</td><td>\(\longleftarrow\)</td><td>\(\tf)</td>
 </tr><tr>
  <td>\embed{reply7,5}</td><td>\(\longleftarrow\)</td>
  <td>\embed{reply6,5}</td><td>\(\longleftarrow\)</td><td>\c</td>
 </tr><tr>
  <td></td><td>\t6</td><td></td><td>\t5</td><td></td>
 </tr>
</table>
Autrement dit l'équation  \(\tf = \c\) équivaut à :
<ul><li>
<label for="reply8">\t2 =</label> \embed{reply8,3}</li><li>
<label for="reply9">\(x) =</label> \embed{reply9,3}</li></ul>
}
}
###indication###
\hint{
\if{\step=1}{
  <ul><li>
  Indiquer une opération au dessus de chaque flèche parmi :
  <div class="wimscenter">\clicList</div>
  </li><li>
  Choisir la bonne expression intermédiaire (entre les flèches) parmi :
  <div class="wimscenter">\clicList2</div>
  </li></ul>
}
\if{\step=2}{
  Indiquer une opération en dessous de chaque flèche pour obtenir
  l'expression de gauche à partir de celle de droite parmi :
  <div class="wimscenter">\clicList</div>
}
\if{\step=3}{
  Appliquer les opérateurs \t5 et \t6 en partant de \c à droite.
  <div class="wims_instruction">
  Écrire les mêmes nombres dans la rédaction classique.
  </div>
}
}
#### soumission de réponse ####
\answer{}{\t1;\clicList}{type=clickfill}
\answer{}{\t2;\clicList2}{type=clickfill}
\answer{}{\t3;\clicList}{type=clickfill}
\answer{}{\t5;\clicList}{type=clickfill}
\answer{}{\t6;\clicList}{type=clickfill}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
