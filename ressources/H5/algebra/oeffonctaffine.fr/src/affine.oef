\title{Fonction affine d'après un graphique}
\language{fr}
\computeanswer{yes}
\precision{1000}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## couleur des grilles
\text{gridcolor=lightblue}

### cadre générique ###
\text{dimh=500}
\text{dimv=500}

\text{xmin=-4.5}
\text{xmax=4.5}
\text{ymin=-4.5}
\text{ymax=4.5}

\text{petitscarreaux=
linewidth 1
parallel 0,\ymin,0,\ymax,0.2,0,floor(5*(\xmax))+1,\gridcolor
parallel 0,\ymin,0,\ymax,-0.2,0,floor(5*abs(\xmin))+1,\gridcolor
parallel \xmin,0,\xmax,0,0,0.2,floor(5*(\ymax))+1,\gridcolor
parallel \xmin,0,\xmax,0,0,-0.2,floor(5*abs(\ymin))+1,\gridcolor
}

\text{groscarreaux=
linewidth 3
parallel 0,\ymin,0,\ymax,1,0,floor(\xmax+1),\gridcolor
parallel 0,\ymin,0,\ymax,-1,0,floor(abs(\xmin)+1),\gridcolor
parallel \xmin,0,\xmax,0,0,1,floor(\ymax+1),\gridcolor
parallel \xmin,0,\xmax,0,0,-1,floor(abs(\ymin)+1),\gridcolor
}

\text{axes=
linewidth 2
vline 0,0,black
hline 0,0,black

text black,0.9,-0.1,medium,1
text black,-0.2,1.1,medium,1
text black,-0.2,-0.1,medium,O
arrow \xmax-1,0,\xmax,0,10,black
arrow 0,\ymax-1,0,\ymax,10,black
text black,\xmax-0.2,-0.2,medium,x
text black,-0.2,\ymax-0.2,medium,y
}

\text{cadre=
xrange \xmin,\xmax
yrange \ymin,\ymax
\petitscarreaux
\groscarreaux
\axes
}
## fin du cadre générique ##

## fabrication d'une droite à dessiner dans le cadre ##
\integer{x2=random(-1,1)*randint(1..4)}
\integer{b=random(-1,1)*random(1..2)}
\integer{y2=\b+random(-1,1)*randint(1..2)}


\rational{a=(\y2-\b)/\x2}

\function{f=\b+(\a)*x}
\text{afRep=texmath(\f)}
\integer{xBA=\x2-\x1}
\integer{yBA=\y2-\y1}

## dessin de la droite ##
\text{vari=shuffle(3)}
\text{couleurs=red,orange,green}
\text{NameCoul=rouge,orange,vert}
\text{graph=
\cadre
linewidth 2
plot \couleurs[\vari[1]],\f
}

####### enoncé de l'exo #######
\statement{
<p>
  Quelle est la formule de la fonction affine
  représentée par la droite <b>D</b> en \NameCoul[\vari[1]]
  ci-dessous ?
</p><div class="wimscenter">
  \draw{\dimh,\dimv}{
	\graph
	}
	</div>
<b>Votre réponse.</b>	<label for="reply1">\(f(x) =) </label>\embed{reply 1,10}.
}
##### collecte de la réponse de l'utilisateur #####


## Aide ou rappel ##
\hint{
  Vous pouvez utiliser le théorème suivant en prenant pour
  <b>A</b> et <b>B</b> deux points appropriés du plan.
  <p>
  <b>Théorème:</b> Soient \(A(x_{A},y_{A})) et
  \(B(x_{B},y_{B})) deux points du plan.
 </p><p>
  Si \(x_{A}\neq x_{B}), alors la fonction affine \(f) représentée
  par la droite \((AB)) a pour coefficient directeur
   \(a=\frac{y_B-y_A}{x_B-x_A}) et pour ordonnée à l'origine \(f(0)).
  </p>
}

## Une solution rédigée si on n'a pas trouvé la bonne réponse ##
\solution{
  <p>
  La droite a pour coefficient directeur \(a=\frac{\y2-(\b)}{\x2-0}=\a)
  et pour ordonnée à l'origine \(b = f(0)= \b).<br>
  Donc la formule est \(f(x) =\f).
  </p>
}
\answer{\(f(x))}{\f}{type=formal}
