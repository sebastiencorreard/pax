\title{Traduction mathématique 3}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{obj=random(CD,DVD,gâteaux,seaux,foulards,colliers,bracelets,ballons,jeux)}
\real{u=3+0.5*random(1,3,5,7)}
\integer{n=random(3..10)}

\real{t=\n*\u}
\integer{s=10*ceil(0.1*\n*\u)+10*randint(1..4)}
\if{s=2*\t}{\s=\s+10}

\real{r=\s-\t}

\statement{<div class="wims_question">
  Vous avez \s &euro;.
  Vous achetez \n \obj qui coûte chacun \u &euro;.
  Combien vous reste-t-il ?
  </div>
  <label for="reply1">Il vous reste </label> \embed{reply 1,6} &euro;.
  <div class="wims_instruction">
  Vous pouvez écrire l'opération ou le résultat, utilisez <span class="tt">*</span>
  pour multiplier,
  <span class="tt"> /</span> pour diviser et écrire les nombres décimaux avec
  un point à la place de la virgule.
  Par exemple,\(7*21/3)+4,25 s'écrit <span class="tt">7*21/3+4.25</span>
  </div>
}
\answer{Reste }{\r}{type=numeric}

\solution{Il vous reste : \(\s - \n*\u = \r) &euro;.}
