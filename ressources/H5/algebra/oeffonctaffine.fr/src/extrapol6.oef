\title{Trouver une fonction affine 1}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## choix de la question

\integer{orient=random(0,0,1)}

## Choix et calculs des coefficients ##
\integer{a=random(2..9)}
\integer{a=\orient=0?\a:-\a}
\integer{b=random(-1,1)*randint(1..9)}

## Choix de deux valeurs données

\integer{x1=randint(6..12)}
\integer{dx=randint(2..5)}
\integer{x2=\x1+\dx}
\integer{y1=\a*\x1+\b}
\integer{y2=\a*\x2+\b}

## Modification pour éviter y1=x1 ou y2 = x2 ##
\if{\y1=\x1}{
  \integer{x1=\x1-1}
  \integer{y1=\a*\x1+\b}
}
\if{\y2=\x2}{
  \integer{x2=\x2+1}
  \integer{y2=\a*\x2+\b}
}

## préparation de la question
\function{g=\a(x-\x1)+\y1}

## préparation de la réponse
\function{f=\a*x+\b}

## Calcul par étapes ##
\steps{reply1
reply2, reply3
reply4}

####### enoncé de l'exo #######
\text{size=10}

\statement{
On considère la fonction affine \(f) telle que :
<div class="wimscenter">
\(f(\x1)= \y1)   et  \(f(\x2)= \y2)
</div>

\if{\step=1}{
<label for="reply1">Le coefficient directeur de \(f) est :</label> \embed{reply 1,6}
}
\if{\step=2}{
Le coefficient directeur de \(f) est bien \a. Compléter :
<div class="wimscenter"> <label for="reply2">\(f(x) = \a)  (\(x) - </label>
\embed{reply 2,6}) <label for="reply3">+ </label>\embed{reply 3,6}</div>
}
\if{\step=3}{
Déterminer la fonction affine \(f) en développant :
<div class="wimscenter">
<label for="reply4">\(f(x)= \a (x - \x1) + \y1 =)</label> \embed{reply4,\size}</div>
}

}
###indication###
\hint{
<ul><li>
On considère les points A(\(x_A);\(f(x_A))) et B(\(x_B);\(f(x_B))).</li><li>
Le coefficient directeur est \(a =\frac{y_B - y_A}{x_B - x_A}).</li><li>
\(f(x) = a(x -x_A) + y_A).</li></ul>
}

#### soumission de réponse ####

\answer{Coefficient directeur}{\a}{type=numeric}
\answer{xA}{\x3}{type=numeric}
\answer{yA}{\y3}{type=numeric}
\feedback{1=1}{\reply2,\reply3}
\condition{Bonne réponse}{\y3=\a*\x3 + \b}
\feedback{(\x3 = \y1 and \y3 = \x1) or (\x3 = \y2 and \y3 = \x2)}{
Vous avez inversé les coordonnées à la deuxième étape.}
\answer{\(f(x))}{\f}{type=litexp}
