 </tr>
  <tr>
  <td>\(x)</td><td><img src="\fl1" alt="\tf1"></td><td>\t4</td><td><img src="\fl1" alt="\tf1"></td><td>\tf</td>
 </tr>
  <tr>
  <td>\(x)</td><td><img src="\fl2" alt=""></td><td>\t4</td><td><img src="\fl2" alt=""></td><td>\tf</td>
 </tr>
  <tr>
  <td></td><td>\embed{reply4,\size}</td><td></td><td>\embed{reply3,\size}</td><td></td>
 </tr>
</table>
}
  \if{\step=3}{
  On veut résoudre l'équation \tf = \c c'est-à-dire retrouver l'antécédent de \c.
<table class="wimscenter">
  <tr>
  <td></td><td>\t3</td><td></td><td>\t6</td><td></td>
 </tr>
  <tr>
  <td>\(x)</td><td><img src="\fl1" alt=""></td><td>\t4</td><td><img src="\fl1" alt=""></td><td>\tf</td>
 </tr>
   <tr>
  <td>=</td><td></td><td>=</td><td></td><td>=</td>
 </tr>
 <tr>
  <td>\embed{reply6,5}</td><td><img src="\fl2" alt="\tf2"></td><td>\embed{reply5,5}</td>
  <td><img src="\fl2" alt="\tf2"></td><td>\c</td>
 </tr>
  <tr>
  <td></td><td>\t5</td><td></td><td>\t1</td><td></td>
 </tr>
</table>

Autrement dit :
L'équation  \tf = \c équivaut à :
<ul><li>
\t4 = \embed{reply7,3}
</li><li>
\(x) = \embed{reply8,3}
</li></ul>
}
}
###indication###
\hint{
\if{\step=1}{
Prendre une opération en bas et la placer au dessus de chaque flèche parmi :<br>
\ListOp<br>
Quelle opération faut-il effectuer pour passer de \(x) à \t4 ?
puis de \t4 à \tf ?
}
\if{\step=2}{
On lit ici le schéma en commençant par \tf.<br>
Prendre une opération en bas et la placer en dessous de chaque flèche parmi :<br>
\ListOp<br>
Quelle opération faut-il effectuer pour passer de \tf à \t4 ? <br>
L'opération choisie doit être l'opération réciproque de \t6.<br><br>
Quelle opération faut-il effectuer pour passer de \t4 à \(x) ? <br>
L'opération choisie doit être l'opération réciproque de \t3.<br>
}
\if{\step=3}{
Effectuer les opérations \t1 et \t5 en partant de \c à droite.<br>
Vous trouverez ainsi la valeur de \t4 puis de \(x).<br>
Écrire les mêmes nombres dans la rédaction classique.
}
}
#### soumission de réponse ####
\answer{}{\t3;\ListOp}{type=clickfill}
\answer{}{\t6;\ListOp}{type=clickfill}
\answer{}{\t1;\ListOp}{type=clickfill}
\answer{}{\t5;\ListOp}{type=clickfill}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
