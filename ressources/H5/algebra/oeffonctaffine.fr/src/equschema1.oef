\title{Trouver les opérateurs et résoudre une équation 2}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

##Type de fonction (x+b)/a
## choix des paramètres en évitant de réutiliser les mêmes chiffres

\integer{aa=randint(2..9)}
\integer{b1=randint(1..9)}

\integer{b0= \aa=\b1 ? 1+ \b1: \b1}

\integer{s=random(-1,1)}
\integer{a=\s*\aa}
\integer{cb=random(-1,1)}
\integer{b=\cb*\b0}

## Choix de la cible

\integer{c=random(-1,1)*randint(1..9)}

## Calcul de la solution
\integer{x=\a*\c-\b}

### la liste des objets que l'on peut cliquer pour résoudre l'exercice ###
\text{ta=\(\a)}
\text{tb0=\(\b0)} ## Valeur de b sans le signe
\text{sb=\cb>0?+:&#0151} ## signe de b
\text{msb=\cb>0?&#0151:+} ## signe de -b
\text{sa=\s>0?+:&#0151} ## signe de a
\text{msa=\s>0?&#0151:+} ## signe de -a
\text{t1=\(\times) (\a)}
\text{t2=\(\a x)}
\text{t3=\sb (\b0)}
\text{t4=\(x + \b)}
\text{t5=\msb (\b0)}
\text{t6=\(\div) (\a)}
\text{t7=\(\div) (\b)}
\text{t8=\sa (\aa)}
\text{t9=\(\times) (\b)}
\text{t0=\msa (\aa)}

\integer{s6=\x+\b}

\text{tf=\cb=1? \(\frac{x + \b0}{\a}): \(\frac{x - \b0}{\a})}

\text{ListOp=shuffle(\t1,\t3,\t5,\t6,\t7,\t8,\t9,\t0)}

## Flèches : 1 de gauche à droite, 2 de gauche à droite
\text{tf1 = flèche de gauche à droite}
\text{fl1 = draw(80,16
segment 0,0,0,16,black
arrow 0,8,80,8,20,black)}

\text{tf2 = flèche de droite à gauche}
\text{fl2 = draw(80,16
segment 79,0,79,16,black
arrow 80,8,0,8,20,black)}

## taille des symboles et des champs à remplir par clic LxHxnb ##
\text{size=50x30x1}

\steps{reply1,reply2
reply3,reply4
reply5,reply6,reply7,reply8}

####### enoncé de l'exo #######

\statement{
  \if{\step=1}{
  Placer les opérations dans les cases :
