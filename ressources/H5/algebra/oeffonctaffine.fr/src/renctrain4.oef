\title{Rencontre de trains 4}
\language{fr}
\range{-5..5}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{10000}

### Les trains partent à une heure ronde. On demande les formules de la distance en fonction du temps. ###
\integer{t0=randint(7..10)}

\integer{n1=randint(2..4)}
\integer{n2=randint(2..5)}
\if{\n2=\n1}{\integer{n2=\n2+1}}{}
\integer{b=\n1+\n2}
\integer{a=floor(30 / \b)}

\integer{d=(\a + randint(0..4))*\b}
\integer{L=5*\d}
\integer{s1=0}
\integer{t1=5*\s1}
\integer{s2=0}

\integer{t2=5*\s2}
\integer{v1=30*\n1}
\integer{v2=30*\n2}
\integer{t=5*(2*\d+\n1*\s1 + \n2*\s2)/(\n1 + \n2)}

\integer{t3=\t1 + \L/\v1*60}
\integer{t4=\t2 + \L/\v2*60}

\integer{m2=\t2 - 60*floor(\t2/60)}
\integer{h2=\t0 + floor(\t2/60)}
\integer{m3=\t3 - 60*floor(\t3/60)}
\integer{h3=\t0 + floor(\t3/60)}
\integer{m4=\t4 - 60*floor(\t4/60)}
\integer{h4=\t0 + floor(\t4/60)}

\integer{m=\t - 60*floor(\t/60)}
\integer{h=\t0 + floor(\t/60)}

\real{w1= \n1 * 0.5}
\real{w2= \n2 * 0.5}

\text{tf1=\w1 x}
\function{f1= \tf1}

\text{tf2= - \w2 x + \L}
\function{f2= \tf2}

\matrix{Sol=La vitesse du train N°1 est \v1 km/h soit \w1 km/min.
Il part de Arnes vers Buluc donc \(x) minutes après \t0 h il est à \(\w1 x) km de Arnes.
Ainsi \(f1(x) = \w1 x).
La vitesse du train N°2 est \v2 km/h soit \w2 km/min.
Il part à \h2 h donc \(x) minutes après \t0 h il a parcouru \(\w2 x) km depuis Buluc vers Arnes.
Buluc étant à \L km de Arnes, il est alors à \(\L - \w2 x) km de Arnes.
Ainsi \(f2(x) = \L - \w2 x).
Pour trouver l'heure où les trains se croisent, il ne reste qu'à résoudre \(\tf1 = \tf2).
Ce qui conduit à \(x = \t) soit à \h h \m min.
}
\integer{solcnt=items(\Sol[;1])}
\text{name_hint=Si le train 1 parcourt \v1 km en 60 minutes, alors
  il parcourt ... km en 1 minute.
  Calculer de la même façon la vitesse en km/min pour le 2ème train.
  Attention, le 2ème train part de Buluc, donc la distance à Arnes est
  \L km moins la distance parcourue.}
\statement{

<ul><li>
Les villes Arnes et Buluc sont distantes de \L km.
</li><li>
Le train N°1 part de Arnes vers Buluc à \t0 h à la vitesse de \v1 km/h.
</li><li>
Le train N°2 part de Buluc vers Arnes à \h2 h à la vitesse de \v2 km/h.
</li></ul>

Donner l'expression de la distance en km de chaque train par rapport à Arnes,
en fonction du nombre \(x) de minutes écoulées depuis \t0 h.
<div class="wims_question">
<ul><li>
<label for="reply1">\(f1(x)) = </label>\embed{reply1,10} pour le train 1.
</li><li>
<label for="reply2">\(f2(x)) = </label>\embed{reply2,10} pour le train 2.
</li></ul>

A quel instant les deux trains se croiseront-ils ?
<label for="reply3">Ils se croiseront à</label>
\embed{reply3,3} h \embed{reply4,3} <label for="reply3">min.</label>
</div>
}
\hint{\name_hint}

\answer{\(f1(x)) =}{\f1}{type=function}
\answer{\(f2(x)) =}{\f2}{type=function}
\answer{Heure du croisement}{\h}{type=default}
\answer{Minutes du croisement}{\m}{type=default}

\solution{<ul>
\for{j=1 to \solcnt}{<li>\Sol[\j;]</li>}
</ul>}
