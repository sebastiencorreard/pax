\title{Trouver les opérateurs et résoudre une équation}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

##Type de fonction ax+b
## choix des paramètres en évitant de réutiliser les mêmes chiffres

\integer{aa=randint(2..9)}
\integer{b1=randint(1..9)}

\integer{b0= \aa=\b1 ? 1+ \b1: \b1}

\integer{s=random(-1,1)}
\integer{a=\s*\aa}
\integer{cb=random(-1,1)}
\integer{b=\cb*\b0}

## Choix de la solution

\integer{x=random(-1,1)*randint(1..9)}

## Calcul de la cible
\integer{c=\a*\x+\b}

### la liste des objets que l'on peut cliquer pour résoudre l'exercice ###
\text{sa=\s>0?+:&#0151} ## signe de a
\text{msa=\s>0?&#0151:+} ## signe de -a
\text{sb=\cb>0?+:&#0151} ## signe de b
\text{msb=\cb>0?&#0151:+} ## signe de -b

\text{t1=\(\times) (\a)}
\text{t2=\(\a x)}
\text{t3=\sb (\b0)}
\text{t4=\(x + \b)}
\text{t5=\msb (\b0)}
\text{t6=\(\div) (\a)}
\text{t7=\(\div) (\b)}
\text{t8=\sa (\aa)}
\text{t9=\(\times) (\b)}
\text{t0=\msa (\aa)}

\integer{s6=\a*\x}

\text{tf=\a*x+\b}

\text{ListOp=shuffle(\t1,\t3,\t5,\t6,\t7,\t8,\t9,\t0)}

## taille des symboles et des champs à remplir par clic LxHxnb ##
\text{size=50x30x1}

\steps{reply1,reply2
reply3,reply4
reply5,reply6,reply7,reply8}

####### enoncé de l'exo #######

\statement{
  \if{\step=1}{
    Placer les opérations dans les cases pour obtenir \(\tf\) en deux étapes :
    <table class="wimscenter wimsnoborder">
    <tr>
    <td></td><td>\embed{reply1,\size}</td><td></td><td>\embed{reply2,\size}</td><td></td>
    </tr><tr>
    <td>\(x)</td><td>\(\longrightarrow\)</td><td>\t2</td><td>\(\longrightarrow\)
    </td><td>\(\tf\)</td>
    </tr>
    </table>
  }
  \if{\step=2}{
    Trouver les opérations réciproques :
    <table class="wimscenter wimsnoborder">
    <tr>
    <td></td><td>\t1</td><td></td><td>\t3</td><td></td>
    </tr><tr>
    <td>\(x)</td><td>\(\longrightarrow\)</td><td>\t2</td><td>\(\longrightarrow\)</td><td>\(\tf\)</td>
    </tr><tr>
    <td>\(x)</td><td>\(\longleftarrow\)</td><td>\t2</td><td>\(\longleftarrow\)</td><td>\(\tf\)</td>
    </tr><tr>
    <td></td><td>\embed{reply4,\size}</td><td></td><td>\embed{reply3,\size}</td><td></td>
    </tr>
    </table>
  }
  \if{\step=3}{
    On veut résoudre l'équation \(\tf = \c\) c'est-à-dire retrouver l'antécédent de \c.
    <table class="wimscenter wimsnoborder">
    <tr>
    <td></td><td>\t1</td><td></td><td>\t3</td><td></td>
    </tr><tr>
    <td>\(x)</td><td>\(\longrightarrow\)</td><td>\t2</td><td>\(\longrightarrow\)</td><td>\(\tf\)</td>
    </tr><tr>
    <td>=</td><td></td><td>=</td><td></td><td>=</td>
    </tr><tr>
    <td>\embed{reply6,5}</td><td>\(\longleftarrow\)</td><td>\embed{reply5,5}</td>
    <td>\(\longleftarrow\)</td><td>\c</td>
    </tr><tr>
    <td></td><td>\t6</td><td></td><td>\t5</td><td></td>
    </tr>
    </table>
    <div>
    Autrement dit :
    L'équation \(\tf = \c\) équivaut à :
    <ul><li>
    <label for="reply7">\t2 =</label> \embed{reply7,3}
    </li><li>
    <label for="reply8">\(x) =</label> \embed{reply8,3}
    </li></ul>
    </div>
}
}
###indication###
\hint{
\if{\step=1}{
  Prendre une opération en bas et la placer au dessus de chaque flèche parmi :<br>
  \ListOp
  <ul><li>
  Quelle opération faut-il effectuer pour passer de \(x) à \t2 ?
  </li><li>
  puis de \t2 à \(\tf\) ?
  </li></ul>
}
  \if{\step=2}{
    On lit ici le schéma en commençant par \(\tf\).
    Prendre une opération en bas et la placer en dessous de chaque flèche parmi :
    <div class="wimscenter">\ListOp</div>
    <ul><li>
    Quelle opération faut-il effectuer pour passer de \(\tf\) à \t2 ?
    </li><li>
    L'opération choisie doit être l'opération réciproque de \t3.
    </li><li>
    Quelle opération faut-il effectuer pour passer de \t2 à \(x) ?
    </li><li>
    L'opération choisie doit être l'opération réciproque de \t1.
    </li></ul>
  }
  \if{\step=3}{
    Effectuer les opérations \t5 et \t6 en partant de \c à droite.
    Vous trouverez ainsi la valeur de \t2 puis de \(x).
    Écrire les mêmes nombres dans la rédaction classique.
  }
}
#### soumission de réponse ####
\answer{}{\t1;\ListOp}{type=clickfill}
\answer{}{\t3;\ListOp}{type=clickfill}
\answer{}{\t5;\ListOp}{type=clickfill}
\answer{}{\t6;\ListOp}{type=clickfill}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
\answer{}{\s6}{type=numeric}
\answer{}{\x}{type=numeric}
