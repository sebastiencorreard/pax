\hint{\name_hint}
%%%% soumission de réponse %%%%
\answer{\(f(0)\)}{\b}{type=default}
\answer{\(f(\x0)\)}{\y0}{type=default}
\answer{\(f(\x3)\)}{\y3}{type=default}
