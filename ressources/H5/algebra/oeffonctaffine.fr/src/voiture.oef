\title{Coût d'un lot de voitures miniatures}
\language{fr}
\range{-5..5}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=3+0.5*random(1,3,5,7)}
\integer{b=random(7..19)}

\integer{x1=10+2*random(0..10)}
\integer{y1=\a *\x1 +\b}
\integer{x2=\x1 +10*random(2..10)}
\integer{y2=\a *\x2 +\b}
\integer{x3=\x1 +10}
\integer{y3=\a *\x3 +\b}
\integer{dx=\x2 - \x1}
\integer{dy=\y2 - \y1}
\text{t1=Nombre de voitures supplémentaires}

\statement{
<div class="wims_question"><p>Pour un achat par correspondance de voitures miniatures,
on paye un prix fixe pour l'envoi par la Poste
et un prix proportionnel au nombre de voitures.
</p><p>
Le prix total pour \x1 voitures miniatures \y1 euros et pour \x2, il est de \y2 euros.
</p>
</div>
<ul class="wims_nopuce">
<li>
Entre \x1 et \x2, <label for="reply1">le nombre de voitures augmente de</label>
\embed{reply 1,6}
et <label for="reply2">le prix de</label> \embed{reply 2,6} euros.
</li><li>
<label for="reply3">Le prix supplémentaire pour chaque voiture est :</label> \embed{reply 3,6} euros.
</li><li>
<label for="reply4">Le prix total pour \x3 voitures (soit \x1 + 10) est :</label>
 \embed{reply 4,6} euros. </li><li>
<label for="reply5">Si on achète en tout \(x) voitures, le coût supplémentaire
  par rapport à \x1 est:</label>
 \embed{reply 5,6} (\(x - \x1)) euros. </li><li>
<label for="reply6">Ce qui donne au total :</label>
 \embed{reply 6,6} (\(x - \x1)) + \y1 euros.</li><li>
<label for="reply7">Finalement le coût total pour \(x) voitures miniatures est :</label>
  \embed{reply 7,6} \(x) + \embed{reply 8,6} euros.
  </li></ul>
}
\answer{Nombre }{\dx}{type=default}
\answer{dy }{\dy}{type=default}
\answer{a }{\a}{type=default}
\answer{y3 }{\y3}{type=default}
\answer{a }{\a}{type=default}
\answer{a }{\a}{type=default}
\answer{a }{\a}{type=default}
\answer{b }{\b}{type=default}
\solution{
<p>Le prix supplémentaire pour chaque voiture est \((\y1 - \y2)/(\x1 - \x2)) = \a .
</p><p>
Pour \x3 voitures le coût total est \a * (\x3 - \x1) + \y1.
</p>
}
s
