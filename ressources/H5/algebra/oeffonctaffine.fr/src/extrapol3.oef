\title{Coût d'un lot d'objets}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

##Choix du contexte##
\integer{n=randint(12)}

\text{L1=savon,photo,bracelet,stylo,foulard,verre,bol,figurine,peluche,dragon,bille,balle,nounours}

\text{\t1=\L1[\n]}
\text{\t2=\L1[\n]s}

##Choix des coefficients##
\real{a=0.2+0.2*random(1,3,5,7)}
\integer{b=random(1..5)}

##Choix des valeurs données avec leurs images##
\integer{x1=10+2*random(0..10)}
\real{y1=\a *\x1 +\b}
\integer{x2=\x1 +10*random(2..10)}
\real{y2=\a *\x2 +\b}
\integer{dx=\x2 - \x1}
\real{dy=\y2 - \y1}
\function{f=\a*x+\b}

#Choix du nombre d'objets au coût inconnu
\integer{x3=\x1 +10}
\real{y3=\a *\x3 +\b}

\statement{
  <div class="wims_question">
  Pour un achat de \t2 par correspondance, on paye un prix fixe pour l'envoi par la Poste
  et un prix proportionnel au nombre de \t2.
  Le prix total pour \x1 \t2 est \y1 &euro; et pour \x2 \t2, il est de \y2&euro;.
  </div>
  <ul><li>
  <label for="reply1">Quel est le prix de \x3 \t2 ?</label> \embed{reply 1,5} &euro;.
  </li><li>
  <label for="reply2">Quel est le prix de chaque \t1 supplémentaire (sans les frais de transport) ?
  </label>\embed{reply 2,5} &euro;.
  </li><li>
  <label for="reply3"> Combien coûte le transport ?</label> \embed{reply 3,5}&euro;.
  </li><li>
  <label for="reply4">Finalement le coût total pour \(x) \t2 transport compris est :</label>
  \embed{reply 4,15}&euro;.
  </li></ul>
}
\answer{Prix de \x3 \t2  }{\y3}{type=default}
\answer{Prix de chaque \t1 supplémentaire  }{\a}{type=default}
\answer{Coût du transport  }{\b}{type=default}
\answer{Coût total pour \(x) \t2  }{\f}{type=formal}

\solution{<ul><li>
  Le prix supplémentaire pour chaque \t1 est \((\y2 - \y1)/(\x2 - \x1)) = \a &euro;.
  </li><li>
  Pour \x3 \t2 le coût total est \a * (\x3 - \x1) + \y1 = \y3&euro;.
  </li><li>
  Pour \(x) \t2 le coût total est \a * (\(x) - \x1) + \y1 = \a * \(x) + \b&euro;.
  </li></ul>
}
