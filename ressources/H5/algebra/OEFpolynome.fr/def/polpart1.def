!set title=Factorisation de polynômes particuliers
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r,r,r
varcnt=37
prevarcnt=26
postvarcnt=10
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(gcd($val6,$val7))]
val9=$[rint($val6 / $val8)]
val10=$[rint($val7 / $val8)]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
val11=$[rint(2)]
!if $val11=1 
tmp0=!texmath $val9*x^2+$val10*x

val12=$(tmp0)
val13=$val9*x^2+$val10*x
val14=$[rint(1)]
tmp=!translate ";': to $     $ in -$val10 / $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)

!ifval $val15>0
val16=0,$val15
!else
val16=$val15,0
!endif
val17=r1	     r2,r3
tmp0=!texmath x*($val9*x+$val10)

val18=$(tmp0)
!else
tmp0=!texmath $val9*x^2+$val10

val12=$(tmp0)
val13=$val9*x^2+$val10

!ifval $val9*$val10>0
val14=$[rint(2)]
!else
val14=$[rint(1)]
!endif
!if $val14=1 
val15=$[sqrt(-$val10 / $val9)]
val19=$[-$val15]

!ifval $val15<0
val16=$val15,$val19
!else
val16=$val19,$val15
!endif
val17=r1	    r2,r3

!ifval $val9>0
tmp0=!texmath (sqrt($val9)*x-sqrt(-$val10))*(sqrt($val9)*x+sqrt(-$val10))

val18=$(tmp0)
!else
tmp1=!texmath (-sqrt(-$val9)*x+sqrt($val10))*(sqrt(-$val9)*x+sqrt($val10))

val18=$(tmp1)
!endif
!else
val17=r1
!endif
!endif
val20=Le polynôme \(P(x)=$val12) peut-il se factoriser
val21=Factoriser \(P(x)=$val12)

!ifval $val11=1 or ($val11=2 and $val14=1)
val22=1
!endif
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=radio
replyname1=
replygood1=$val14;Oui,Non
replytype2=function
replyname2=
replygood2=?analyze 23
replytype3=function
replyname3=
replygood3=?analyze 24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $m_step=1 
$()	 $val20	 <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	  
!else
$()	  	 $val21		 <div class="wimscenter">
!insmath P(x)=
$()( 
!read oef/embed.phtml reply2,7 
$())
!insmath \times
$()( 
!read oef/embed.phtml reply3,7 
$())</div>	<div class="wims_instruction">Taper <span class="tt">sqrt(a)</span>	pour 
!insmath \sqrt{a}
$().</div>	  
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val25=!rawmath ($m_reply2)*($m_reply3)
evaltmp=$val25

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val26=$[$(tmp0)]
evaltmp=$val25

evaltmp=!mathsubst x=(1) in $evaltmp
tmp0=($evaltmp)
val27=$[$(tmp0)]
evaltmp=$val25

evaltmp=!mathsubst x=(2) in $evaltmp
tmp0=($evaltmp)
val28=$[$(tmp0)]
evaltmp=$val13

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val29=$[$(tmp0)]
evaltmp=$val13

evaltmp=!mathsubst x=(1) in $evaltmp
tmp0=($evaltmp)
val30=$[$(tmp0)]
evaltmp=$val13

evaltmp=!mathsubst x=(2) in $evaltmp
tmp0=($evaltmp)
val31=$[$(tmp0)]
tmp0=!position char x  in $m_reply2

val32=$(tmp0)
tmp0=!position char x in $m_reply3

val33=$(tmp0)

!ifval $val29=$val26 and $val30=$val27 and $val31=$val28 and $val32>0 and $val33>0
val34=$[rint(1)]
!else
val34=$[rint(0)]
!endif

!exit

:feedback
!ifval $val34=0 and $val14=1
 <div class='oef_feedbacks'>La factorisation de 
!insmath P(x)
$() est 
!insmath $val18
$().	
$()</div>
!endif

!exit

:test

condlist=$val22

!ifval $val34=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=13,14,18,20,21,22,23,24
embedcnt=3
