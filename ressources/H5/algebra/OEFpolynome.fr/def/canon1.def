!set title=Mise sous forme canonique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(1)]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint(2*$(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
tmp0=!texmath $val6*x^2+$val7*x+$val8

val9=$(tmp0)
val10=$[rint($val6)]
t_=!rawmath $val7 / (2 * $val6)
val11=!exec pari print($t_)

!ifval $val11<0
val12=-
!else
val12=+
!endif

!ifval $val11<0
val13=2
!else
val13=1
!endif

!ifval $val11<0
t_=!rawmath -$val11
val11=!exec pari print($t_)
!endif
val14=$[rint(($val7)^2-4*$val6*$val8)]
t_=!rawmath $val14 / (4*($val6)^2)
val15=!exec pari print($t_)

!ifval $val15>0
val16=-
!else
val16=+
!endif

!ifval $val15>0
val17=2
!else
val17=1
!endif
t_=!rawmath abs($val15)
val15=!exec pari print($t_)
replytype1=menu
replyname1=signe 1
replygood1=$val13;+,-
replytype2=numeric
replyname2=coef 2
replygood2=$[$val11]
replytype3=menu
replyname3=signe 2
replygood3=$val17;+,-
replytype4=numeric
replyname4=coef 3
replygood4=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Mettre sous forme canonique le polynôme 
!insmath P(x)=$val9
$():						<div class="wimscenter">
!insmath P(x)=
$()(
!insmath x
$() 
!read oef/embed.phtml reply1 
$() 
!read oef/embed.phtml reply2,2 
$())<sup>2</sup> 
!read oef/embed.phtml reply3 
$() 
!read oef/embed.phtml reply4,3 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=4
