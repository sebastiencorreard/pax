!set title=Equations particulières
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(gcd($val6,$val7))]
val9=$[rint($val6 / $val8)]
val10=$[rint($val7 / $val8)]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
val11=$[rint(2)]
!if $val11=1 
tmp0=!texmath $val9*x^2+$val10*x

val12=$(tmp0)
val13=$val9*x^2+$val10*x
val14=$[rint(1)]
tmp=!translate ";': to $     $ in -$val10 / $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)

!ifval $val15>0
val16=0,$val15
!else
val16=$val15,0
!endif
val17=r1	     r2,r3
tmp0=!texmath x*($val9*x+$val10)

val18=$(tmp0)
!else
tmp0=!texmath $val9*x^2+$val10

val12=$(tmp0)
val13=$val9*x^2+$val10

!ifval $val9*$val10>0
val14=$[rint(2)]
!else
val14=$[rint(1)]
!endif
!if $val14=1 
val15=$[sqrt(-$val10 / $val9)]
val19=$[-$val15]

!ifval $val15<0
val16=$val15,$val19
!else
val16=$val19,$val15
!endif
val17=r1	    r2,r3

!ifval $val9>0
tmp0=!texmath (sqrt($val9)*x-sqrt(-$val10))*(sqrt($val9)*x+sqrt(-$val10))

val18=$(tmp0)
!else
tmp1=!texmath (-sqrt(-$val9)*x+sqrt($val10))*(sqrt(-$val9)*x+sqrt($val10))

val18=$(tmp1)
!endif
!else
val17=r1
!endif
!endif
val20=L'équation \($val12=0) a-t-elle des solutions
val21=Résoudre \($val12=0)
val22=$(val16[1])
val23=$(val16[2])
val24=
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=radio
replyname1=
replygood1=$val14;Oui,Non
replytype2=function
replyname2=
replygood2=!rawmath $val22
replytype3=function
replyname3=
replygood3=!rawmath $val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $m_step=1 
$()	 $val20	 <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	  
!else
$()	  	 $val21		 <div class="wimscenter">
!insmath S=
$()&#123; 
!read oef/embed.phtml reply2,5 
$(), 
!read oef/embed.phtml reply3,5 
$()&#125;</div>	<div class="wims_instruction"> Ordonner les solutions dans l'ordre croissant;<br>	Taper <span class="tt">sqrt(a)</span> pour 
!insmath \sqrt{a}
$().</div>	  
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

condlist=$val24

!exit

:stat
vsavelist=20,21,24
embedcnt=3
