\title{Points alignés}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\computeanswer{no}
\integer{x1=random(1..20)*random(-1,1)}
\integer{x3=random(-20..20)}
\integer{y1=random(-20..20)}
\integer{y3=random(-20..20)}
\integer{coef=random(2..5)*random(-1,1)}
\integer{t=random(1,2)}
\integer{q=random(1,2)}
\integer{x2=(\t=1)?\coef*(\x3-\x1)+\x1 : (2-\q)*(\coef*(\x3-\x1)+\x1)}
\integer{y2=(\t=1)? \coef*(\y3-\y1)+\y1 : (\q+1)*(\coef*(\y3-\y1)+\y1)}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{z3=\x3+\y3*i  }
\complex{rep1=(\x2-\x1)+(\y2-\y1)*i}
\complex{rep2=(\x3-\x1)+(\y3-\y1)*i}

\statement{On donne \(A) d'affixe \(\z1), \(B) d'affixe \(\z2) et \(C) d'affixe \(\z3).
<div class="wims_question"><label for="reply1">
Les points \(A), \(B) et \(C) sont-ils alignés ?</label> \embed{r1}</div>}

\answer{A, B et C alignés?}{\t;oui,non,je ne sais pas}{type=menu}

\solution{Etudions si les vecteurs \(\overrightarrow{AB})  et  \(\overrightarrow{AC}) sont colinéaires :<br/> 
\(\overrightarrow{AB}) a pour affixe \(z_B-z_A=\z2-(\z1)=\rep1).<br/> \(\overrightarrow{AC}) a pour affixe \(z_C-z_A=\z3-(\z1)=\rep2). <br/>\if{\t=1}{On a  \(\overrightarrow{AB})=\coef \(\overrightarrow{AC}) donc \(\overrightarrow{AB}) et \(\overrightarrow{AC}) sont colinéaires et \(A), \(B) et \(C) sont alignés.}
{On n'a pas de coefficient \(k) tel que  \(\overrightarrow{AB}=k \overrightarrow{AC}) donc \(\overrightarrow{AB}) et  \(\overrightarrow{AC}) ne sont pas colinéaires et \(A), \(B) et \(C) ne sont pas alignés.}}
