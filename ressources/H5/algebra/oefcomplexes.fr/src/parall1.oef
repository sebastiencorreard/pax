\title{Parallélogramme}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\computeanswer{no}
\matrix{points=A,B,C,D,E
F,G,H,I,J
K,L,M,N,P
R,S,T,Q,W
}
\integer{choix=random(1..5)}
\text{quad=\points[1;\choix]\points[2;\choix]\points[3;\choix]\points[4;\choix]}
\text{vec1=\points[1;\choix]\points[2;\choix]}
\text{vec2=\points[4;\choix]\points[3;\choix]}
\text{vec3=\points[3;\choix]\points[4;\choix]}
\text{vec4=\points[1;\choix]\points[3;\choix]}
\integer{x1=random(1..20)*random(-1,1)}
\integer{x2=random(1..20)*random(-1,1)}
\integer{x3=random(-20..20)}
\integer{y1=random(-20..20)}
\integer{y2=random(-20..20)}
\integer{y3=random(-20..20)}
\integer{t=random(1,2)}
\integer{x4=(\t=1)? \x3-\x2+\x1 : \x3-\x2+2*\x1}
\integer{y4=(\t=1)? \y3-\y2+\y1 : 2*\y3-\y2+\y1}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{z3=\x3+\y3*i  }
\complex{z4=\x4+\y4*i}
\complex{rep1=(\x2-\x1)+(\y2-\y1)*i}
\complex{rep2=(\x3-\x4)+(\y3-\y4)*i}
\statement{On donne \(\points[1;\choix]) d'affixe \(\z1), \(\points[2;\choix]) d'affixe \(\z2) , \(\points[3;\choix]) d'affixe \(\z3) et \(\points[4;\choix]) d'affixe \(\z4).
<div class="wims_question"><p><label for="reply1">Le quadrilatère \(\quad) est-il un parallélogramme ? </label></p>\embed{r1}
</div>}
\answer{}{\t;oui,non,je ne sais pas}{type=menu}

\solution{<ul class="wims_nopuce">
<li>\(\overrightarrow{\vec1}\) a pour affixe \(z_\points[2;\choix]-z_\points[1;\choix]=\z2-(\z1)=\rep1\). </li>
<li> \(\overrightarrow{\vec2}\) a pour affixe 
\(z_\points[3;\choix]-z_\points[4;\choix]=\z3-(\z4)=\rep2\).</li>
<li>
Les affixes de  \(\overrightarrow{\vec1}\) et \(\overrightarrow{\vec2}\) \if{\t=1}{sont les mêmes donc \(\quad) est un parallélogramme}
{ne sont pas les mêmes donc \(\quad) n'est pas un parallélogramme.}</li>
</ul>}
