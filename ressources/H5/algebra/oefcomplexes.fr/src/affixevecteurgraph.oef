\title{Affixe d'un vecteur graphiquement}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\format{html}
\computeanswer(yes)

\integer{x=randint(-6..6)}
\integer{y=(\x=0)? randint(1..7)*randitem(-1,1):randint(-7..7)}
\integer{ax=(\x>=0)? randint(-7..(7-\x)):randint((-7-\x)..7)}
\integer{ay=(\y>=0)? randint(-7..(7-\y)):randint((-7-\y)..7)}
\integer{bx=\x+\ax}
\integer{by=\y+\ay}
\complex{z=\x+\y*i}

\text{dessin=draw(400,400
xrange -8,8
yrange -8,8
parallel -8,-8,-8,8,1,0,16,grey
parallel -8,-8,8,-8,0,1,16,grey
hline 0,0,black
vline 0,0,black
arrow 0,0,1,0,8,black
arrow 0,0,0,1,8,black
text black , -0.5,-0.2,small , O
text black , 0.5,-0.3,small , u
arrow 0.3,-0.2,1,-0.2,6,black
text black , -0.5,0.8,small , v
arrow -0.7,0.9,0,0.9,6,black
linewidth 1.7
segment -0.3,5,0.3,5,0,black
segment -0.3,-5,0.3,-5,0,black
segment -5,0.3,-5,-0.3,black
segment 5,0.3,5,-0.3,black
segment \ax-0.3,\ay-0.3,\ax+0.3,\ay+0.3,black
segment \ax-0.3,\ay+0.3,\ax+0.3,\ay-0.3,black
segment \bx-0.3,\by-0.3,\bx+0.3,\by+0.3,black
segment \bx-0.3,\by+0.3,\bx+0.3,\by-0.3,black
linewidth 2
arrow \ax,\ay,\bx,\by,10,black
)}

\text{dessinsol=draw(380,380
xrange -8,8
yrange -8,8
parallel -8,-8,-8,8,1,0,16,grey
parallel -8,-8,8,-8,0,1,16,grey
hline 0,0,black
vline 0,0,black
arrow 0,0,1,0,8,black
arrow 0,0,0,1,8,black
text black , -0.5,-0.2,small , O
text black , 0.5,-0.3,small , u
arrow 0.3,-0.2,1,-0.2,6,black
text black , -0.5,0.8,small , v
arrow -0.7,0.9,0,0.9,6,black
linewidth 1.7
segment \ax-0.3,\ay-0.3,\ax+0.3,\ay+0.3,black
segment \ax-0.3,\ay+0.3,\ax+0.3,\ay-0.3,black
segment \bx-0.3,\by-0.3,\bx+0.3,\by+0.3,black
segment \bx-0.3,\by+0.3,\bx+0.3,\by-0.3,black
arrow 0,0,\x,\y,10,blue
segment \x-0.3,\y-0.3,\x+0.3,\y+0.3,blue
segment \x-0.3,\y+0.3,\x+0.3,\y-0.3,blue
dline \ax,\ay,\bx,\ay,black
dline \bx,\ay,\bx,\by,black
text blue , \x+0.3,\y+0.3,medium , M
segment -0.3,5,0.3,5,0,black
segment -0.3,-5,0.3,-5,0,black
segment -5,0.3,-5,-0.3,black
segment 5,0.3,5,-0.3,black
linewidth 2
arrow \ax,\ay,\bx,\by,10,black

)}

\statement{Lire l'affixe du vecteur \(\overrightarrow{w}) dont un représentant est tracé dans le plan complexe ci-dessous.
<img src="\dessin" alt="dessin" />
<div class="wims_question"><label for="reply1">L'affixe est </label>\embed{r1,5}.</div>}

\answer{}{\z}{type=complex}

\solution{<img src="\dessinsol" alt="dessinsol" /><br/>
L'affixe de \(\overrightarrow{w}) est l'affixe du point \(M) tel que \(\overrightarrow{w}=\overrightarrow{OM}) c'est à dire \(\z).<br/>
On peut également observer comment on se déplace de l'origine à l'extrémité du vecteur \(\overrightarrow{w}).}
