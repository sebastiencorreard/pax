\title{Affixe d'un vecteur}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\computeanswer{no}
\integer{x1=random(0..20)*random(-1,1)}
\integer{x2=random(0..20)*random(-1,1)}
\integer{y1=random(-20..20)}
\integer{y2=random(-20..20)}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{rep=(\x2-\x1)+(\y2-\y1)*i}
\matrix{point=A,B
B,C
C,D
A,D
E,F
M,N
R,S}
\integer{choix=randint(1..7)}
\statement{<div class="wims_question">
<p>Calculer l'affixe du vecteur \(\overrightarrow{\point[\choix;1]\point[\choix;2]}) pour \(\point[\choix;1]) d'affixe \(\z1) et \(\point[\choix;2]) d'affixe \(\z2).</p>
<p><label for="reply1">Réponse : </label>\embed{r1,10}</div>}
\answer{Réponse}{\rep}{type=complex}
\hint{L'affixe de  \(\overrightarrow{AB}) est \(z_B-z_A). Attention aux parenthèses pour \(z_A).}
\solution{L'affixe est \(z_\point[\choix;2]-z_\point[\choix;1]=(\z2)-(\z1)=\rep).}
