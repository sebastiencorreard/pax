\title{Droites parallèles}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\integer{x1=random(1..20)*random(-1,1)}
\integer{x4=random(1..20)*random(-1,1)}
\integer{x3=random(-20..20)}
\integer{y1=random(-20..20)}
\integer{y4=random(-20..20)}
\integer{y3=random(-20..20)}
\integer{coef=random(2..5)*random(-1,1)}
\integer{t=random(1,2)}
\integer{q=random(1,2)}
\integer{x2=(\t=1)?\coef*(\x4-\x3)+\x1 : (2-\q)*(\coef*(\x4-\x3)+\x1)}
\integer{y2=(\t=1)? \coef*(\y4-\y3)+\y1 : (\q+1)*(\coef*(\y4-\y3)+\y1)}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{z3=\x3+\y3*i  }
\complex{z4=\x4+\y4*i}
\complex{rep1=(\x2-\x1)+(\y2-\y1)*i}
\complex{rep2=(\x4-\x3)+(\y4-\y3)*i}

\statement{On donne \(A\) d'affixe \(\z1), \(B\) d'affixe \(\z2), \(C\) d'affixe \(\z3) et \(D\) d'affixe \(\z4).
<div class="wims_question"><p><label for="reply1">Les droites \((AB)\) et \((CD)\) sont-elles parallèles ?</label>
</p><p>\embed{r1}</p></div>}

\answer{parallèles ?}{\t;oui,non,je ne sais pas}{type=menu}

\solution{Etudions si les vecteurs \(\overrightarrow{AB}\)  et  \(\overrightarrow{CD}\) sont colinéaires : 
<ul class="wims_nopuce"><li> \(\overrightarrow{AB}\) a pour affixe \(z_B-z_A=\z2-(\z1)=\rep1\).</li> 
<li>\(\overrightarrow{CD}\) a pour affixe \(z_D-z_C=\z4-(\z3)=\rep2\).</li>
</li>
</ul>
\if{\t=1}{On a  \(\overrightarrow{AB}\)\({}= \coef\) \(\overrightarrow{CD}\) donc \(\overrightarrow{AB}\) et \(\overrightarrow{CD}\) sont colinéaires. 
<br>Ainsi : \((AB)\) et \((CD)\) sont parallèles.}
{On n'a pas de coefficient \(k\) tel que  \(\overrightarrow{AB}=k \overrightarrow{CD}\) donc \(\overrightarrow{AB}\) et  \(\overrightarrow{CD}\) ne sont pas colinéaires. 
<br>Ainsi : \((AB)\) et \((CD)\) ne sont pas parallèles.}
}
