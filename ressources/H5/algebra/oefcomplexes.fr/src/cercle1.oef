\title{Point sur un cercle}
author{Cyrille,Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}

\computeanswer{yes}
\precision{100000}
\integer{x1=random(-10...10)}
\integer{y1=random(-10..10)}
\integer{x2=random(-10...10)}
\integer{y2=random(-10..10)}
\integer{k=random(1..4)*random(-1,1)}
\integer{x3=\x1-\k*(\y2-\y1)}
\integer{y3=\y1+\k*(\x2-\x1)}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{z3=\x3+\y3*i}
\integer{rep1=(\x2-\x1)*(\x2-\x1)+(\y2-\y1)*(\y2-\y1)}
\integer{rep2=(\x3-\x1)*(\x3-\x1)+(\y3-\y1)*(\y3-\y1)}
\text{modul2=sqrt(\rep2)}
\integer{rep3=(\rep1=\rep2)? 1:2}
\real{modul1=sqrt(\rep1)}
\text{rayon=(round(\modul1)=\modul1)? \modul1:\sqrt{\rep1}}
%%%MB Feedback %%%%%

%%%%
\statement{<div class="wims_question"><p>Le point \(M) d'affixe \(\z3) appartient-il au cercle de centre \(A) d'affixe \(\z1) et de rayon \(\rayon\) ?</p>
<label for="reply1">\(A M=)\embed{r1,6}</label></div>
<div class="wims_instruction">Pour noter \(\sqrt{...}) : écrire sqrt(...). Ne pas utiliser plus d'une racine carrée.</div>
<div class="wims_question">\(M\) appartient au cercle? \embed{r2}</div>
}
\answer{}{\modul2}{type=formal}
\answer{}{\rep3;oui,non}{type=radio}
\hint{AB=|z<sub>B</sub>-z<sub>A</sub>|, on calcule d'abord la différence z<sub>B</sub>-z<sub>A</sub> puis le module.}
\feedback{\sc_reply1<1}{<div class="feedback">
<p>On calcule d'abord le module de \(\lvert z_M -z_A \rvert\)\({}=\lvert \z3-(\z1) \rvert \) ici égal à \(\modul2\).
</p>
<p>Puis on compare avec le rayon : \(\rayon\). Ici ils sont \if{\rayon=\modul2}{égaux}{différents}.</p>
<p>Le point \if{\rayon=\modul2}{ est donc }{n'est donc pas }sur le cercle.</div>}
