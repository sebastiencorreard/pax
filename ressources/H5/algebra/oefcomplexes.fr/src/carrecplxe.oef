\title{Equation avec carré}
\author{Cyrille,Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\integer{a=randint(-80..-2)}
\text{z1=sqrt(-\a)*i}
\text{z2=-sqrt(-\a)*i}
\text{sol=\z1,\z2}

\integer{aabs=-\a}

\statement{<div class="wims_question"><p><label for="reply1">Résoudre dans \(\mathbb{C}\), l'équation \(z^2=\a\).</label></p>
S=\embed{r1,20}.</div>
<div class="wims_instruction">Séparez les valeurs par une virgule.Pour \(\sqrt{...}), écrire sqrt(...).</div>}
\answer{}{\sol}{type=fset}

\solution{\(z^2=\a\) &hArr; \(z^2=(\sqrt{\aabs}\,i)^2\) &hArr; \(z=\sqrt{\aabs}\, i\) ou \(z=-\sqrt{\aabs}\, i\).}
