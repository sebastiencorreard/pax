\title{Nature d'un triangle (étapes)}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\computeanswer{no}

\integer{a1=randint(1..10)}
\integer{b1=randint(-20..20)}
\integer{a2=2*randint(1..10)}
\integer{b2=\a2+(randint(1..7)*randint(-1,1))}
%%Nature du triangle : 1-> équilatéral, 2 -> isocèle, 3->isocèle rectangle, 4-> rectangle%%
\integer{nat=randint(1..4)}
\if{\nat=1}
{\integer{x1=\a1}
\integer{y1=0}
\integer{x2=\a2+\a1}
\integer{y2=0}
\integer{x3=\a1+0.5*\a2}
\integer{y3=0.5*\a2*sqrt(3)}
\integer{y31=0.5*\a2}
\integer{rep2=(\x3-\x1)*(\x3-\x1)+0.25*\a2*\a2*3}
\integer{rep3=(\x3-\x2)*(\x3-\x2)+0.25*\a2*\a2*3}
}
{
\if{\nat<4}
{\integer{x1=\a1}
\integer{y1=\b1}
\integer{x2=\a1+\a2}
\integer{y2=\b1+\b2}
\integer{x3=(\nat=3)? \a1-\b2 : \a1+\b2}
\integer{y3=\b1+\a2}
}
{\integer{x1=\a1}
\integer{y1=\b1}
\integer{x2=\a1+\a2}
\integer{y2=\b1+\b2}
\integer{k=randint(2..4)}
\integer{x3=\a1-\k*\b2}
\integer{y3=\b1+\k*\a2}
}
\integer{rep2=(\x3-\x1)*(\x3-\x1)+(\y3-\y1)*(\y3-\y1)}
\integer{rep3=(\x3-\x2)*(\x3-\x2)+(\y3-\y2)*(\y3-\y2)}
}
\complex{z1=\x1+\y1*i}
\complex{z2=\x2+\y2*i}
\complex{z3=\x3+\y3*i}
\integer{rep1=(\x2-\x1)*(\x2-\x1)+(\y2-\y1)*(\y2-\y1)}
\real{modul1=sqrt(\rep1)}
\real{modul2=sqrt(\rep2)}
\real{modul3=sqrt(\rep3)}
\integer{rep4=(\nat=1)? 1:2}
\integer{rep5=(\nat=2 or \nat=3)? 1:2}
\integer{rep7=(\nat=2)? \rep1 : \rep3}
\integer{rep8=(\nat=2)? \rep3+\rep2 : \rep1+\rep2}
\integer{rep9=(\nat>2)? 1:2}
\if{\nat=1}{
\text{etap=r1
r2
r3
r4}
}{
\text{etap=(\nat<4)? r1
r2
r3
r4
r5,r6 
r7,r8,r9:
r1
r2
r3
r4
r5
r7,r8,r9
}}
\nextstep{\etap}
##Variables pour le corrigé##
\complex{zab=\z2-(\z1)}
\integer{xac1=\x3-\x1}
\text{zac1=\xac1 +\y31 \sqrt{3} i}
\complex{zac=\z3-(\z1)}
\integer{xbc1=\x3-\x2}
\text{zbc1=\xbc1 +\y31 \sqrt{3} i}
\complex{zbc=\z3-(\z2)}
\integer{r1=\x2-\x1}
\integer{r2=\y2-\y1}
\text{affAB=(round( \modul1)=\modul1)? \modul1:\sqrt{\rep1}}
\text{affAC=(round( \modul2)=\modul2)? \modul2:\sqrt{\rep2}}
\text{affBC=(round( \modul3)=\modul3)? \modul3:\sqrt{\rep3}}

\statement{<p>On donne \(A) d'affixe \(\z1) , \(B) d'affixe \(\z2) , \(C) d'affixe
\if{\nat=1}{\(\x3 +\y31 \sqrt{3} i)}{\(\z3)}. </p>
<div class="wims_question"><p>Quelle est la nature du triangle \(A B C) ?</p>
<p>On commence par calculer les trois longueurs des côtés :</p>

\if{\step=1}{ \(A B=)\embed{r1,6}}
<div class="wims_instruction">Pour noter \(\sqrt{...}) : écrire sqrt(...).</div>

\if{\step=2 and \sc_reply1=0}{<font color="red"><b>Erreur :</b></font> \(A B=\affAB), pas \(\reply1). <br />Calculer : \(A C=)\embed{r2, 6}}
\if{\step=2 and \sc_reply1=1}{<font color="green"><b>Correct :</b></font> \(A B=\affAB). <br />Calculer : \(A C=)\embed{r2, 6}}

\if{\step=3 and \sc_reply2=0}{\(A B=\affAB). <font color="red"><b>Erreur :</b></font>\(A C=\affAC), pas \reply2. <br />Calculer : \(B C=)\embed{r3, 6}}
\if{\step=3 and \sc_reply2=1}{\(A B=\affAB). <font color="green"><b>Correct :</b></font> \(A C=\affAC). <br />Calculer : \(B C=)\embed{r3, 6}}

\if{\step=4 and \sc_reply3=0}{\(A B=\affAB). \(A C=\affAC). <font color="red"><b>Erreur :</b></font> \(B C=\affBC), pas \reply3. <br />Le triangle \(A B C) est-il équilatéral ? \embed{r4}}
\if{\step=4 and \sc_reply3=1}{\(A B=\affAB). \(A C=\affAC). <font color="green"><b>Correct :</b></font> \(B C=\affBC). <br />Le triangle \(A B C) est-il équilatéral ? \embed{r4}}
\if{\step=5 and \nat=1}{\(A B=\affAB). \(A C=\affAC). \(B C=\affBC). <br />Le triangle \(A B C) est équilatéral.}
\if{\step=5 and \nat>1}{\(A B=\affAB). \(A C=\affAC). \(B C=\affBC). <br />Le triangle \(A B C) n'est pas équilatéral.<br />Le triangle \(A B C) est-il isocèle ? \embed{r5}<br />
\if{\nat<4}{en \embed{r6}}}
\if{\step=6 and \rep5=1}{\(A B=\affAB). \(A C=\affAC). \(B C=\affBC). Le triangle \(A B C) est isocèle en \(A).  <br />
\if{\nat=2}{\(A B^2=)\embed{r7,6},  \(A C^2+B C^2=)\embed{r8,6},}{\(B C^2=)\embed{r7,6}, \(A B^2+A C^2=)\embed{r8,6},} <br /> Le triangle \(A B C) est-il rectangle en \(A) ? \embed{r9}}
\if{\step=6 and \rep5=2}{\(A B=\affAB). \(A C=\affAC). \(B C=\affBC). <br />Le triangle \(A B C) n'est pas isocèle. 
<br/>\(B C^2=)\embed{r7,6}, \(A B^2+A C^2=)\embed{r8,6}.<br />  Le triangle \(A B C) est-il rectangle en \(A)? \embed{r9}}
</div>
}
\answer{}{sqrt(\rep1)|\modul1}{type=case}{option=nonstop}
\answer{}{sqrt(\rep2)|\modul3}{type=case}{option=nonstop}
\answer{}{sqrt(\rep3)|\modul3}{type=case}{option=nonstop}
\answer{}{\rep4;oui,non}{type=radio}{option=nonstop}
\answer{}{\rep5;oui,non}{type=radio}{option=nonstop}
\answer{}{1;A,B,C}{type=menu}
\answer{}{\rep7}{type=numeric}
\answer{}{\rep8}{type=numeric}
\answer{}{\rep9;oui,non}{type=radio}{option=nonstop}

\solution{\(A B=|z_B-z_A|=|\z2-(\z1)|=|\zab|={})\if{\nat=1}{\(\a2)}{\(\sqrt{(\r1)^2+(\r2)^2}=\affAB)}.<br/> 
\(A C=|z_C-z_A|={})\if{\nat=1}{\(|\zac1|)}{\(|\zac|)}\(=\affAC). <br/>
\(B C=|z_C-z_B|={})\if{\nat=1}{\(|\zbc1|)}{\(|\zbc|)}\(=\affBC).<br/>
\if{\nat=1}{\(AB=AC=BC) donc \(ABC) est équilatéral.}
\if{\nat=2 or \nat=3}{\(AB=AC) donc \(ABC) est isocèle en \(A).}
\if{\nat=3 or \nat=4}{\(AB²+AC²=BC²) donc \(ABC) est rectangle en \(A).}




}
