\title{De la forme trigonométrique à la forme algebrique}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\format{html}

\integer{k=randint(2..7)*randitem(-1,1,1)}
\matrix{argu=1,1,-1,1,-1,\k
2,0,1,1,-1,-1
3,0,1,2,-1,-2
4,0,1,3,-1,-3
6,0,1,5,-1,-5}##en 1er : den, après : num##
\integer{choix1=randint(1..5)}
\integer{choix2=randint(2..6)}
\integer{module=2*randint(1..15)}
\text{argunum=maxima(\argu[\choix1;\choix2]*pi)}
\text{argunum=wims(replace internal * by  in \argunum)}
\text{argunum=wims(replace internal pi by \pi in \argunum)}
\text{argunum=texmath(\argunum)}
##Pour le corrigé##
\integer{kcos=(round(\k/2)=\k/2)? 1:-1}
\matrix{coefcos=1,-1,-1,-1,-1,\kcos
2,1,0,0,0,0
3,1,1,-1,1,-1
4,1,sqrt(2),-sqrt(2),sqrt(2),-sqrt(2)
6,1,sqrt(3),-sqrt(3),sqrt(3),-sqrt(3)}
\matrix{coefsin=1,0,0,0,0,0
2,0,1,1,-1,-1
3,0,sqrt(3),sqrt(3),-sqrt(3),-sqrt(3)
4,0,sqrt(2),sqrt(2),-sqrt(2),-sqrt(2)
6,0,1,1,-1,-1}
\text{tcos=(\choix1>2 and \choix2>2)? \coefcos[\choix1;\choix2]/2:\coefcos[\choix1;\choix2]}
\text{tsin=(\choix1>2 and \choix2>2)? \coefsin[\choix1;\choix2]/2:\coefsin[\choix1;\choix2]}
%%% MB modif pour éviter écrire bien les racines carrées %%%%
\text{tcos=wims(replace internal sqrt(2) by \sqrt{2} in \tcos)}
\text{tcos=wims(replace internal sqrt(3) by \sqrt{3} in \tcos)}
\text{tsin=wims(replace internal sqrt(2) by \sqrt{2} in \tsin)}
\text{tsin=wims(replace internal sqrt(3) by \sqrt{3} in \tsin)}
%%%% fin modifs MB
\text{t=(\argu[\choix1;\choix2]<0 and \choix1>1)? \tcos\tsin :\tcos+\tsin }
\rational{mimodule=\module/2}
\integer{kx=(round(\k/2)=\k/2)? \module:-\module}
\matrix{coefx=1,-\module,-\module,-\module,-\module,\kx
2,\module,0,0,0,0
3,\module,\mimodule,-\mimodule,\mimodule,-\mimodule
4,\module,\mimodule sqrt(2),-\mimodule sqrt(2),\mimodule sqrt(2),-\mimodule sqrt(2)
6,\module,\mimodule sqrt(3),-\mimodule sqrt(3),\mimodule sqrt(3),-\mimodule sqrt(3)}
\matrix{coefy=1,0,0,0,0,0
2,0,\module ,\module,-\module,-\module
3,0,\mimodule sqrt(3),\mimodule sqrt(3),-\mimodule sqrt(3),-\mimodule sqrt(3)
4,0,\mimodule sqrt(2),\mimodule sqrt(2),-\mimodule sqrt(2),-\mimodule sqrt(2)
6,0,\mimodule ,\mimodule ,-\mimodule ,-\mimodule }

\text{xs=wims(replace internal sqrt by \sqrt{} in \coefx[\choix1;\choix2])}
\text{ys=wims(replace internal sqrt by \sqrt{} in \coefy[\choix1;\choix2])}

\text{zs=(\argu[\choix1;\choix2]<0 and \choix1>1)? \xs\ys i:\xs+\ys i}

\statement{<div class="wims_question">Donner la forme algébrique de 
\if{\choix1>1 and \choix2>2}{\(z=\module \left ( cos(\frac{\argunum}{\argu[\choix1;1]})+i sin  (\frac{\argunum}{\argu[\choix1;1]}) \right )).}{\(z=\module \left ( cos(\argunum)+i sin  (\argunum)\right ) ).} 
<p>\(z={}\)\embed{r1,8}+\embed{r2,8}i.</p></div>
<div class="wims_instruction">Pour \(\sqrt{...}), écrire sqrt(...).</div>}
\answer{}{\coefx[\choix1;\choix2]}{type=formal}
\answer{}{\coefy[\choix1;\choix2]}{type=formal}
\solution{
\if{\choix1>1 and \choix2>2}{\(z=\module \left ( cos(\frac{\argunum}{\argu[\choix1;1]})+i sin  (\frac{\argunum}{\argu[\choix1;1]}) \right ))}{\(z=\module \left ( cos(\argunum)+i sin  (\argunum)\right ) )}\({}=\module (\t \; i)=\zs).}
