\title{Affixe d'un point}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{complex_number}
\format{html}

\computeanswer(yes)

\integer{x=randint(-7..7)}
\integer{y=randint(-7..7)}
\complex{z=\x+\y*i}

\text{dessin=draw(400,400
xrange -8,8
yrange -8,8

parallel -8,-8,-8,8,1,0,16,grey
parallel -8,-8,8,-8,0,1,16,grey
hline 0,0,black
vline 0,0,black
arrow 0,0,1,0,8,black
arrow 0,0,0,1,8,black
text black , -0.5,-0.2,small , O
text black , 0.5,-0.3,small , u
arrow 0.3,-0.2,1,-0.2,6,black
text black , -0.5,0.8,small , v
arrow -0.7,0.9,0,0.9,6,black
linewidth 2
segment -0.3,5,0.3,5,0,black
segment -0.3,-5,0.3,-5,0,black
segment -5,0.3,-5,-0.3,black
segment 5,0.3,5,-0.3,black
segment \x-0.3,\y-0.3,\x+0.3,\y+0.3,black
segment \x-0.3,\y+0.3,\x+0.3,\y-0.3,black
text black ,\x+0.4,\y,huge, M
)}


\statement{Lire l'affixe du point \(M) dans le plan complexe ci-dessous.<br/>
<img src="\dessin" alt="dessin" />
<div class="wims_question"><label for="reply1">L'affixe est </label>\embed{r1,5}.</div>}

\answer{}{\z}{type=complex}
\solution{Le point M a pour coordonnées \((\x;\y)\), sont afffixe est donc \(\z\)}

