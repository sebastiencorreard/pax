\title{Calcul d'un coefficient du binôme dans &#8450;}
\author{Bruno, Mifsud}
\email{communaute.mutuwims@laposte.net}
\keywords{polynomials,complex_number}

\observation{Partie imaginaire ou réelle de (i+a)^n, a=+/-1, n entier de 3 à 10}
\keywords{complex_number,polynomials}
\integer{a = randomitem(1,-1)}
\integer{n= randint(3..10)}


\text{quest=randomitem(réelle,imaginaire)}
\text{poly=(i+\a)^\n}

\integer{rep=\quest issametext réelle?maxima(realpart(\poly)):maxima(imagpart(\poly))}
%%%% feedback
\text{sommsol=}
\integer{nmid=\n%2==0?\n/2:\n/2-1}
\if{\quest issametext réelle}{
  \for{kk=0 to \nmid}{
    \integer{k0=2*\kk}
    \text{temp=i^\k0 \binom{\n}{\k0}}
    \text{sommsol=\sommsol=?\temp:\sommsol+\temp}
    }
    }{
    \for{kk=0 to \nmid}{
    \integer{k0=min(\n,2*\kk+1)}
    \text{temp=i^\k0 \binom{\n}{\k0}}
    \text{sommsol=\sommsol=?\temp:\sommsol+\temp}
    }
    }
  \text{quest0=\quest issametext réelle?paire:impaire}
\text{feed=Pour avoir la partie \quest il additionner toutes les puissances \quest0 de i donc : \(\sommsol\)}


\statement{
<div class="wims_question">
Quelle est la partie  \quest de \((i+\a)^\n\) ?
<p>Réponse : \embed{r1,10
autofocus}}

\answer{Réponse}{\rep}{type=numeric}
\feedback{\sc_reply1<1}{
<div class="feedback">\feed</div>
 }
