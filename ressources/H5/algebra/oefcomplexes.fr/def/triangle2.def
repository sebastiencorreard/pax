:solution
$()
!insmath A B=|z_B-z_A|=|$val22-($val21)|=|$val33|={}
$()
!if $val10=1 
$()
!insmath $val8
$() 
!else
$() 
!insmath \sqrt{($val40)^2+($val41)^2}=$val42
$() 
!endif
$().<br/> 	
!insmath A C=|z_C-z_A|={}
$()
!if $val10=1 
$()
!insmath |$val35|
$() 
!else
$() 
!insmath |$val36|
$() 
!endif
$()
!insmath =$val43
$(). <br/>	
!insmath B C=|z_C-z_B|={}
$()
!if $val10=1 
$()
!insmath |$val38|
$() 
!else
$() 
!insmath |$val39|
$() 
!endif
$()
!insmath =$val44
$().<br/>	
!if $val10=1 
$()
!insmath AB=AC=BC
$() donc 
!insmath ABC
$() est équilatéral. 
!endif
$()	
!if $val10=2 or $val10=3 
$()
!insmath AB=AC
$() donc 
!insmath ABC
$() est isocèle en 
!insmath A
$(). 
!endif
$()	
!if $val10=3 or $val10=4 
$()
!insmath AB²+AC²=BC²
$() donc 
!insmath ABC
$() est rectangle en 
!insmath A
$(). 
!endif
$()
$()
