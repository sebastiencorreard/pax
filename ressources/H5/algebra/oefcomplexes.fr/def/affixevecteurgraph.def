val6=$[rint($(tmp0))]

!ifval ($val6=0)
tmp0=!randint 1, 7

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val7=$[rint( $(tmp0)*$(tmp1))]
!else
tmp2=!randint -7, 7

val7=$[rint($(tmp2))]
!endif

!ifval ($val6>=0)
tmp0=!randint -7, (7-$val6)

val8=$[rint( $(tmp0))]
!else
