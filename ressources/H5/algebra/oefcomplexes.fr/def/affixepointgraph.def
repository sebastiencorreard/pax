!set title=Affixe d'un point
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=complex_number

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -7, 7

val6=$[rint($(tmp0))]
tmp0=!randint -7, 7

val7=$[rint($(tmp0))]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val8=!mathsubst I=i in $t_
!readproc oef/draw.phtml 400,400 \
xrange -8,8	yrange -8,8		parallel -8,-8,-8,8,1,0,16,grey	parallel -8,-8,8,-8,0,1,16,grey	hline 0,0,black	vline 0,0,black	arrow 0,0,1,0,8,black	arrow 0,0,0,1,8,black	text black , -0.5,-0.2,small , O	text black , 0.5,-0.3,small , u	arrow 0.3,-0.2,1,-0.2,6,black	text black , -0.5,0.8,small , v	arrow -0.7,0.9,0,0.9,6,black	linewidth 2	segment -0.3,5,0.3,5,0,black	segment -0.3,-5,0.3,-5,0,black	segment -5,0.3,-5,-0.3,black	segment 5,0.3,5,-0.3,black	segment $val6-0.3,$val7-0.3,$val6+0.3,$val7+0.3,black	segment $val6-0.3,$val7+0.3,$val6+0.3,$val7-0.3,black	text black ,$val6+0.4,$val7,huge, M	 
tmp0=$ins_url
val9=$(tmp0)
replytype1=complex

replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Lire l'affixe du point 
!insmath M
$() dans le plan complexe ci-dessous.<br/>	<img src="$val9" alt="dessin" />	<div class="wims_question"><label for="reply1">L'affixe est </label> 
!read oef/embed.phtml r1,5 
$().</div>
$()
!exit

