!set title=Droites parallèles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
tmp0=!randint -20, 20

val10=$[rint($(tmp0))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]

!ifval ($val13=1)
val15=$[rint($val12*($val7-$val8)+$val6 )]
!else
val15=$[rint( (2-$val14)*($val12*($val7-$val8)+$val6))]
!endif

!ifval ($val13=1)
val16=$[rint( $val12*($val10-$val11)+$val9 )]
!else
val16=$[rint( ($val14+1)*($val12*($val10-$val11)+$val9))]
!endif
t_=!rawmath $val6+$val9*i
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
t_=!rawmath $val15+$val16*i
t_=!exec pari print($t_)
val18=!mathsubst I=i in $t_
t_=!rawmath $val8+$val11*i  
t_=!exec pari print($t_)
val19=!mathsubst I=i in $t_
t_=!rawmath $val7+$val10*i
t_=!exec pari print($t_)
val20=!mathsubst I=i in $t_
t_=!rawmath ($val15-$val6)+($val16-$val9)*i
t_=!exec pari print($t_)
val21=!mathsubst I=i in $t_
t_=!rawmath ($val7-$val8)+($val10-$val11)*i
t_=!exec pari print($t_)
val22=!mathsubst I=i in $t_
replytype1=menu
replyname1=parallèles ?
replygood1=$val13;oui,non,je ne sais pas
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On donne 
!insmath A
$() d'affixe 
!insmath $val17
$(), 
!insmath B
$() d'affixe 
!insmath $val18
$(), 
!insmath C
$() d'affixe 
!insmath $val19
$() et 
!insmath D
$() d'affixe 
!insmath $val20
$().	<div class="wims_question"><p><label for="reply1">Les droites 
!insmath (AB)
$() et 
!insmath (CD)
$() sont-elles parallèles ?</label>	</p><p> 
!read oef/embed.phtml r1 
$()</p></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Etudions si les vecteurs 
!insmath \overrightarrow{AB}
$()  et  
!insmath \overrightarrow{CD}
$() sont colinéaires : 	<ul class="wims_nopuce"><li> 
!insmath \overrightarrow{AB}
$() a pour affixe 
!insmath z_B-z_A=$val18-($val17)=$val21
$().</li> 	<li>
!insmath \overrightarrow{CD}
$() a pour affixe 
!insmath z_D-z_C=$val20-($val19)=$val22
$().</li>	</li>	</ul>	
!if $val13=1 
$()On a  
!insmath \overrightarrow{AB}
$()
!insmath {}= $val12
$() 
!insmath \overrightarrow{CD}
$() donc 
!insmath \overrightarrow{AB}
$() et 
!insmath \overrightarrow{CD}
$() sont colinéaires. 	<br>Ainsi : 
!insmath (AB)
$() et 
!insmath (CD)
$() sont parallèles. 
!else
$()	 On n'a pas de coefficient 
!insmath k
$() tel que  
!insmath \overrightarrow{AB}=k \overrightarrow{CD}
$() donc 
!insmath \overrightarrow{AB}
$() et  
!insmath \overrightarrow{CD}
$() ne sont pas colinéaires. 	<br>Ainsi : 
!insmath (AB)
$() et 
!insmath (CD)
$() ne sont pas parallèles. 
!endif
$()	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
