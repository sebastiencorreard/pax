!set title=Affixe d'un vecteur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 0, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
t_=!rawmath $val6+$val8*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
t_=!rawmath $val7+$val9*i
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!rawmath ($val7-$val6)+($val9-$val8)*i
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp=!trim A,B	B,C	C,D	A,D	E,F	M,N	R,S
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 7

val14=$[rint($(tmp0))]
replytype1=complex

replyname1=Réponse
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">	<p>Calculer l'affixe du vecteur 
!insmath \overrightarrow{$(val13[$val14;1])$(val13[$val14;2])}
$() pour 
!insmath $(val13[$val14;1])
$() d'affixe 
!insmath $val10
$() et 
!insmath $(val13[$val14;2])
$() d'affixe 
!insmath $val11
$().</p>	<p><label for="reply1">Réponse : </label> 
!read oef/embed.phtml r1,10 
$()</div>
$()
!exit

:hint
$()L'affixe de  
!insmath \overrightarrow{AB}
$() est 
!insmath z_B-z_A
$(). Attention aux parenthèses pour 
!insmath z_A
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()L'affixe est 
!insmath z_$(val13[$val14;2])-z_$(val13[$val14;1])=($val11)-($val10)=$val12
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14
embedcnt=1
