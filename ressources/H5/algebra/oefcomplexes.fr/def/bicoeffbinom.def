tmp0=!shuffle \binom{n}{p},\binom{n-1}{p-1}+\binom{n-1}{p}

val21=$(tmp0)
val21=\($(val21[1])=$(val21[2])\)
tmp0=!shuffle \binom{n}{p},\binom{n}{n-p}

val22=$(tmp0)
val22=\($(val22[1])=$(val22[2])\)
tmp0=!randint 5, 15

val23=$[rint($(tmp0))]
tmp0=!randint 1, $val23/3

val24=$[rint($(tmp0))]
val25=$[rint($val23-1)]
val26=$[rint($val24-1)]
val27=$[rint($val23-$val24)]
val28=\binom{$val23}{$val24},\binom{$val23-1}{$val24-1}+\binom{$val23-1}{$val24},\binom{$val25}{$val26}+\binom{$val25}{$val24}
val28=\($(val28[1])=$(val28[2])=$(val28[3])\)
val29=\binom{$val23}{$val24},\binom{$val23}{$val23-$val24},\binom{$val23}{$val27}
val29=\($(val29[1])=$(val29[2])=$(val29[3])\)
