!set title=Parallélogramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=complex_number
computeanswer=no

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim A,B,C,D,E	F,G,H,I,J	K,L,M,N,P	R,S,T,Q,W	
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
val8=$(val6[1;$val7])$(val6[2;$val7])$(val6[3;$val7])$(val6[4;$val7])
val9=$(val6[1;$val7])$(val6[2;$val7])
val10=$(val6[4;$val7])$(val6[3;$val7])
val11=$(val6[3;$val7])$(val6[4;$val7])
val12=$(val6[1;$val7])$(val6[3;$val7])
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val15=$[rint($(tmp0))]
tmp0=!randint -20, 20

val16=$[rint($(tmp0))]
tmp0=!randint -20, 20

val17=$[rint($(tmp0))]
tmp0=!randint -20, 20

val18=$[rint($(tmp0))]
tmp0=!randitem 1,2

val19=$[rint($(tmp0))]

!ifval ($val19=1)
val20=$[rint( $val15-$val14+$val13 )]
!else
val20=$[rint( $val15-$val14+2*$val13)]
!endif

!ifval ($val19=1)
val21=$[rint( $val18-$val17+$val16 )]
!else
val21=$[rint( 2*$val18-$val17+$val16)]
!endif
t_=!rawmath $val13+$val16*i
t_=!exec pari print($t_)
val22=!mathsubst I=i in $t_
t_=!rawmath $val14+$val17*i
t_=!exec pari print($t_)
val23=!mathsubst I=i in $t_
t_=!rawmath $val15+$val18*i  
t_=!exec pari print($t_)
val24=!mathsubst I=i in $t_
t_=!rawmath $val20+$val21*i
t_=!exec pari print($t_)
val25=!mathsubst I=i in $t_
t_=!rawmath ($val14-$val13)+($val17-$val16)*i
t_=!exec pari print($t_)
val26=!mathsubst I=i in $t_
t_=!rawmath ($val15-$val20)+($val18-$val21)*i
t_=!exec pari print($t_)
val27=!mathsubst I=i in $t_
replytype1=menu
replyname1=
replygood1=$val19;oui,non,je ne sais pas
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On donne 
!insmath $(val6[1;$val7])
$() d'affixe 
!insmath $val22
$(), 
!insmath $(val6[2;$val7])
$() d'affixe 
!insmath $val23
$() , 
!insmath $(val6[3;$val7])
$() d'affixe 
!insmath $val24
$() et 
!insmath $(val6[4;$val7])
$() d'affixe 
!insmath $val25
$().	<div class="wims_question"><p><label for="reply1">Le quadrilatère 
!insmath $val8
$() est-il un parallélogramme ? </label></p> 
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()<ul class="wims_nopuce">	<li>
!insmath \overrightarrow{$val9}
$() a pour affixe 
!insmath z_$(val6[2;$val7])-z_$(val6[1;$val7])=$val23-($val22)=$val26
$(). </li>	<li> 
!insmath \overrightarrow{$val10}
$() a pour affixe 	
!insmath z_$(val6[3;$val7])-z_$(val6[4;$val7])=$val24-($val25)=$val27
$().</li>	<li>	Les affixes de  
!insmath \overrightarrow{$val9}
$() et 
!insmath \overrightarrow{$val10}
$() 
!if $val19=1 
$()sont les mêmes donc 
!insmath $val8
$() est un parallélogramme 
!else
$()	 ne sont pas les mêmes donc 
!insmath $val8
$() n'est pas un parallélogramme. 
!endif
$()</li>	</ul>
$()
!exit

