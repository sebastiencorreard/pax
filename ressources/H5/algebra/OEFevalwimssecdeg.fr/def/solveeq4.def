!set title=Résoudre une équation du second degré 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=equations,trinomial,roots
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La calculatrice n'est pas autorisée.
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9

val8=$[rint($(tmp0)*$val7)]
tmp0=!randint -9, 9

val9=$[rint($(tmp0))]
tmp0=!randint -9, 9

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=$[rint(($val9)^2-4*$val8*$val10)]
val13=$[rint(2*$val8)]

!ifval $val12<0
val14=$[rint(1)]
!endif

!ifval $val12=0
val14=$[rint(2)]
!endif

!ifval $val12>0
val14=$[rint(3)]
!endif
replytype1=radio
replyname1=nombre de solutions
replygood1=$val14;Aucun point, Un point, Deux points distincts
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_warning">$val6</div>	<p>	  Déterminer <label for="reply1">le nombre de points d'intersection</label> de la parabole 
!insmath \mathcal{P}
$()	 avec l'axe des abscisses:	</p>	<div class="wimscenter"> 
!insmath \mathcal{P} : y=$val11
$()</div>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11
embedcnt=1
