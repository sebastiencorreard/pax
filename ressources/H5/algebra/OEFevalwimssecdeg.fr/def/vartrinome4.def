!set title=Variation d'un trinôme du second degré 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=function_variation,trinomial
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
val9=\(\searrow),\(\nearrow)

!ifval $val8>0
val10=top,bottom,top
!else
val10=bottom,top,bottom
!endif

!ifval $val8>0
val11=1,2
!else
val11=2,1
!endif
val12=$(val9[$val11])
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]

!ifval $val6=$val13
val6=$[rint(2*$val6)]
!endif
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]

!ifval $val15=$val14
tmp0=!randint 1.5

val15=$[rint($val15+$(tmp0))]
!endif
t_=!replace internal \( by ( in x^2-$val13*x+$val15
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val16=$(tmp1)
t_=!replace internal \( by ( in $val8*x^2-2*$val8*$val13*x+$val8*($val13)^2+$val14
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val17=$(tmp1)
t_=!replace internal \( by ( in $val8*x^2-$val8*($val13+$val6)*x+$val8*$val13*$val6+$val14
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
t_=!replace internal \( by ( in -$val8*x^2+2*$val8*$val13*x-$val8*($val13)^2+$val14
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val19=$(tmp1)
val20=\($val16),\($val17),\($val18),\($val19)
replytype1=radio
replyoption1=shuffle 
replyname1=expression possible
replygood1=2;$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Le tableau des variations d'une fonction trinôme du second degré 
!insmath f
$() est:	<table class="wimsnoborder wimscenter">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> 
!insmath x
$()</th>	  <td style="width:15%;text-align:left"> 
!insmath -\infty
$()</td>	  <td style="width:8%"></td>	  <td style="width:15%">$val13</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">
!insmath +\infty
$()</td>	</tr><tr style="border:solid 1px black">	  <th style="width:15%:border:solid 1px black;vertical-align: middle;">
!insmath var f
$()</th>	  <td style="width:15%;text-align:left; vertical-align:$(val10[1])"></td>	  <td style="width:8%">$(val12[1]) </td>	  <td style="width:15%;vertical-align:$(val10[2])">$val14</td>	  <td style="width:8%">$(val12[2])</td>	  <td style="width:15%;text-align:right;vertical-align:$(val10[3])"></td>	 </tr>	</table>	  Retrouver parmi les expressions suivantes, une expression possible pour 
!insmath f(x)
$():	<ul>	<li> 
!read oef/embed.phtml reply1,1 
$()</li>	<li> 
!read oef/embed.phtml reply1,2 
$()</li>	<li> 
!read oef/embed.phtml reply1,3 
$()</li>	<li> 
!read oef/embed.phtml reply1,4 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,12,13,14
embedcnt=4
