val6=Attention: Les deux lignes du tableau doivent avoir	 le même nombre d'étiquettes, utiliser l'étiquette vide pour compléter et aligner,	  mais ne pas mettre plusieurs étiquettes vides côte à côte.
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(2*$val7)]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath $val7*x^2+$val9*x+$val10

val11=$(tmp0)
val12=$[rint(($val9)^2-4*$val7*$val10)]
val13=$[rint(-$val12)]
tmp0=!texmath (-$val9-x)/$val8

val14=$(tmp0)
tmp0=!texmath (-$val9+x)/$val8

val15=$(tmp0)

!ifval $val12>0
tmp0=!replace internal x by \sqrt{$val12} in $val14

val14=$(tmp0)
!else
tmp1=!replace internal x by \sqrt{$val13} in $val14

val14=$(tmp1)
!endif

!ifval $val12>0
tmp0=!replace internal x by \sqrt{$val12} in $val15

val15=$(tmp0)
!else
tmp1=!replace internal x by \sqrt{$val13} in $val15

val15=$(tmp1)
!endif

!ifval $val12=0
tmp=!translate ";': to $     $ in -$val9/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val16=$(tmp1)
!endif

!ifval $val12=0
tmp=!translate ";': to $     $ in $val9/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)

val17=$(tmp1)
!endif

!ifval $val12=0
val14=$val16
!endif

!ifval $val12=0
val15=$val17
!endif
!if $val12=0 
val18=<table class="wimscenter wimsnoborder" style="border:solid 1px black">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> \(x)</th>	  <td style="width:15%;text-align:left"> \(-\infty)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_0)</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">\(+\infty)</td>	</tr><tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black">signe P</th>	  <td style="width:15%;text-align:left" > &nbsp; </td>	  <td style="width:8%"><span class="larger" style="color:red">+</span></td>	  <td style="width:15%">0</td>	  <td style="width:8%;"><span class="larger" style="color:red">+</span></td>	  <td style="width:15%;text-align:right"> &nbsp; </td>	 </tr>	</table>	avec \(x_0=$val16\)	
!else
val18=<table class="wimscenter wimsnoborder" style="border:solid 1px black">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> \(x)</th>	  <td style="width:15%;text-align:left"> \(-\infty)</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">\(+\infty)</td>	</tr>	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black">signe P</th>	  <td style="width:15%;text-align:left" > &nbsp; </td>	  <td style="width:8%"> <span class="larger" style="color:red">+</span></td>	  <td style="width:15%;text-align:right"> &nbsp; </td>	  </tr>	</table>
!endif
