!else
val20=<table class="wimscenter wimsnoborder" style="border:solid 1px black">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> \(x)</th>	  <td style="width:15%;text-align:left"> \(-\infty)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_1)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_2)</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">\(+\infty)</td>	</tr><tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black">signe P</th>	  <td style="width:15%;text-align:left" > &nbsp; </td>	  <td style="width:8%"> <span class="larger" style="color:red">+</span></td>	  <td style="width:15%"> 0</td>	  <td style="width:8%"> <span class="larger" style="color:red">-</span></td>	  <td style="width:15%"> 0 </td>	  <td style="width:8%"> <span class="larger" style="color:red">+</span></td>	  <td style="width:15%;text-align:right"> &nbsp; </td>	</tr>	</table>	avec \(x_1=$val14) et \(x_2=$val15)
!endif
!if $val12=0 
val21=<table class="wimscenter wimsnoborder" style="border:solid 1px black">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> \(x)</th>	  <td style="width:15%;text-align:left"> \(-\infty)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_0\)</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">\(+\infty)</td>	</tr><tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black">signe P</th>	  <td style="width:15%;text-align:left"> &nbsp; </td>	  <td style="width:8%"> <span class="larger" style="color:red">-</span></td>	  <td style="width:15%"> 0</td>	  <td style="width:8%"> <span class="larger" style="color:red">-</span></td>	  <td style="width:15%;text-align:right"> &nbsp; </td>	 </tr>	</table>	avec \(x_0=$val17\)	
!else
val21=<table class="wimscenter wimsnoborder" style="border:solid 1px black">	<tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black"> \(x)</th>	  <td style="width:15%;text-align:left"> \(-\infty)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_1)</td>	  <td style="width:8%"></td>	  <td style="width:15%">\(x_2)</td>	  <td style="width:8%"></td>	  <td style="width:15%;text-align:right">\(+\infty)</td>	</tr><tr style="border:solid 1px black">	  <th style="width:15%;border:solid 1px black">signe \(P\)</th>	  <td style="width:15%;text-align:left" > &nbsp; </td>	  <td style="width:8%"> <span class="larger" style="color:red">-</span></td>	  <td style="width:15%"> 0</td>	  <td style="width:8%"> <span class="larger" style="color:red">+</span></td>	  <td style="width:15%"> 0 </td>	  <td style="width:8%"> <span class="larger" style="color:red">-</span></td>	  <td style="width:15%;text-align:right"> &nbsp; </td>	  </tr>	</table>	avec \(x_1=$val14\) et \(x_2=$val15\)	
!endif
