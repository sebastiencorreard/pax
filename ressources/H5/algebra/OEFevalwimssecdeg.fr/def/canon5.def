!set title=Forme canonique 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
keywords=trinomial
email=regine@mangeard.fr
precision=100

ansorder=r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

val6=$[rint(-$(tmp0))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*x^2+$val7*x+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val9=$(tmp1)
val10=$[rint($val6)]
t_=!rawmath $val7 / (2 * $val6)
val11=!exec pari print($t_)

!ifval $val11<0
val12=-
!else
val12=+
!endif

!ifval $val11<0
val13=2
!else
val13=1
!endif

!ifval $val11<0
t_=!rawmath -$val11
val11=!exec pari print($t_)
!endif
val14=$[rint(($val7)^2-4*$val6*$val8)]
t_=!rawmath $val14 / (4*($val6)^2)
val15=!exec pari print($t_)

!ifval $val15>0
val16=-
!else
val16=+
!endif

!ifval $val15>0
val17=2
!else
val17=1
!endif
t_=!rawmath abs($val15)
val15=!exec pari print($t_)
val18=Mettre sous forme canonique le polynôme \(P(x)=$val9 \):
replytype1=numeric
replyname1=coef 1
replygood1=$[$val10]
replytype2=menu
replyname2=signe 1
replygood2=$val13;+,-
replytype3=numexp
replyname3=coef 2
replygood3=$val11
replytype4=menu
replyname4=signe 2
replygood4=$val17;+,-
replytype5=numexp
replyname5=coef 3
replygood5=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val18		<div class="wimscenter">
!insmath P(x)=
$() 
!read oef/embed.phtml reply1,2 
$()$m_leftpar2	  (
!insmath x
$() 
!read oef/embed.phtml reply2 
$() 
!read oef/embed.phtml reply3,2 
$())<sup>2</sup> 
!read oef/embed.phtml reply4 
$() 
!read oef/embed.phtml reply5,3 
$()$m_rightpar2</div>								
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18
embedcnt=5
