!set title=Coefficients et racines 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/pythagore 100 
tmp0=$slib_out
val6=$(tmp0)

!ifval $(val6[1])<$(val6[2])
val7=$[rint($(val6[1]))]
!else
val7=$[rint($(val6[2]))]
!endif

!ifval $(val6[1])<$(val6[2])
val8=$[rint($(val6[2]))]
!else
val8=$[rint($(val6[1]))]
!endif
val9=$[rint($val7+$val8)]
val10=$[rint($val7*$val8)]
val11=$[$val10/2]
val12=$[rint($(val6[3]))]
val13=$[rint($val7+$val8+$val12)]
replytype1=numeric
replyname1=Petit côté
replygood1=$[$val7]
replytype2=numeric
replyname2=Grand côté
replygood2=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  Un triangle rectangle a une hypoténuse de longueur $val12 cm et et	  une aire de $val11 cm<sup>2</sup>.	</p>	 Quelles sont les longueurs des deux autres côtés?	<ul class="wims_nopuce"><li>	  <label for="reply1">Petit côté de l'angle droit</label> =  
!read oef/embed.phtml reply1,4 
$()cm	</li><li>	  <label for="reply2">Grand côté de l'angle droit</label> =  
!read oef/embed.phtml reply2,4 
$()cm	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Notons 
!insmath x
$() le petit côté et 
!insmath y
$() le grand côté de l'angle droit.<br>	  D'après les hypothèses on a: 
!insmath x^2+y^2=$val12^2
$() et 
!insmath \frac{xy}{2} =$val11
$().<p>	  On obtient facilement 
!insmath x+y=$val9
$() et 
!insmath xy=$val10
$().	</p>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,12
embedcnt=2
