!set title=Coefficients et racines 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val8=$[rint($val7+$(tmp0)*$(tmp1))]

!ifval $val8=0
val8=$[rint( -$val7)]
!endif
val9=$[rint($val7+$val8)]
tmp=!translate ";': to $     $ in $val9/2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
tmp0=!texmath $val10

val10=$(tmp0)
val11=$[rint($val7*$val8)]
val12=$[rint(-$val6*$val9)]
val13=$[rint($val11*$val6)]
replytype1=numeric
replyname1=a
replygood1=$[$val6]
replytype2=numeric
replyname2=b
replygood2=$[$val12]
replytype3=numeric
replyname3=c
replygood3=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère une parabole 
!insmath \mathcal{P}
$() qui coupe l'axe des ordonnées au point 
!insmath A(0;$val13)
$()	  et dont l'axe de symétrie a pour équation 
!insmath x=$val10
$().<br>	  On sait de plus que le produit des abscisses 
!insmath x_1
$() et 
!insmath x_2
$()	  des points d'intersection de 
!insmath \mathcal{P}
$() avec l'axe des abscisses vaut 
!insmath $val11
$().	<p>	  On note 
!insmath y=a x^2+b x +c
$() l'équation de 
!insmath \mathcal{P}
$().</p>	  Déterminer les réels 
!insmath a
$(), 
!insmath b
$() et 
!insmath c
$():	<ul class="wims_nopuce">	<li>	<label for="reply1">
!insmath a=
$()</label>  
!read oef/embed.phtml reply1,4 
$()	</li><li>	<label for="reply2">
!insmath b=
$()</label>  
!read oef/embed.phtml reply2,4 
$()	</li><li>	<label for="reply3">
!insmath c=
$()</label>  
!read oef/embed.phtml reply3,4 
$()	</li>	</ul>	
$()
!exit

