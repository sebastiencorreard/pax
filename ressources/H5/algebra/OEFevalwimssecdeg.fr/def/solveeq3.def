!set title=Résoudre une équation du second degré 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=equations,trinomial,roots
precision=1000

ansorder=r,r,r,r,r,r,r,r
varcnt=41
prevarcnt=38
postvarcnt=2
replycnt=8
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La calculatrice n'est pas autorisée.
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
tmp0=!randint 2, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
!if $val7=1 
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
tmp0=!texmath $val11*x+$val12

val15=$(tmp0)
val16=$[rint(($val9-$val11)^2-4*$val8*($val10-$val12))]
val17=$[rint(2*$val8)]
val9=$[rint($val9-$val11)]
val18=$[rint(($val10-$val12))]
val19=$[rint($val8)]
!endif
!if $val7=2 
t_=!replace internal \( by ( in x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
tmp0=!texmath ($val8*x+$val12)*(x+$val13)

val15=$(tmp0)
val16=$[rint(($val12+$val8*$val13-$val9)^2-4*($val8-1)*($val12*$val13-$val10))]
val17=$[rint(2*($val8-1))]
val9=$[rint($val12+$val8*$val13-$val9)]
val18=$[rint(($val12*$val13-$val10))]
val19=$[rint(($val8-1))]
!endif
!if $val7=3 
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
tmp0=!texmath (x+$val12)^2

val14=$(tmp0)
val16=$[rint(($val9-2*$val12)^2-4*($val8-1)*($val10-($val12)^2))]
val17=$[rint(2*($val8-1))]
val9=$[rint($val9-2*$val12)]
val18=$[rint(($val10-($val12)^2))]
val19=$[rint(($val8-1))]
!endif
val20=$[rint(-$val9)]

!ifval $val16<0
val21=$[rint(1)]
!endif

!ifval $val16=0
val21=$[rint(2)]
!endif

!ifval $val16>0
val21=$[rint(3)]
!endif

!ifval $val21=1
val22=r1,r2
!else
val22=r1,r2	r3,r4
!endif

!ifval $val21=3
val22=$val22,r5,r6,r7,r8
!endif

!ifval $val16>=0
val23=1
!else
val23=
!endif

!ifval $val16>0
val24=Les solutions sont \(\frac{$val20-\sqrt{$val16}}{$val17}\) et	  \(\frac{$val20+\sqrt{$val16}}{$val17}\)
!else
val24= la solution est \(\frac{$val20}{$val17}\)
!endif

!ifval $val16<0
val24=
!endif
oefsteps=$val22 
nextstep=!nosubst $val22 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Discriminant
replygood1=$[$val16]
replytype2=radio
replyname2=nombre de solutions
replygood2=$val21;aucune solution, une solution, deux solutions distinctes
replytype3=numeric
replyoption3=noanalyzeprint 
replyname3=
replygood3=?analyze 25
replytype4=numeric
replyoption4=noanalyzeprint 
replyname4=
replygood4=?analyze 26
replytype5=numeric
replyoption5=noanalyzeprint 
replyname5=
replygood5=?analyze 27
replytype6=numeric
replyoption6=noanalyzeprint 
replyname6=
replygood6=?analyze 28
replytype7=numeric
replyoption7=noanalyzeprint 
replyname7=
replygood7=?analyze 29
replytype8=numeric
replyoption8=noanalyzeprint 
replyname8=
replygood8=?analyze 30
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val24


!goto stat

!exit

:question
$()<div class="wims_warning">$val6</div>	  Résoudre l'équation 
!insmath (E) : $val14=$val15
$(). Pour cela,	<ol>	
!if $m_step=1 
$()	<li> Calculer le discriminant 
!insmath \Delta
$() de cette équation:	<div class="wimscenter"> <label for="reply1">
!insmath \Delta
$()</label>= 
!read oef/embed.phtml reply1 
$()</div></li>	<li> En déduire <label for="reply2">le nombre de solutions de 
!insmath (E)
$():</label>	<div class="wimscenter"> 
!read oef/embed.phtml reply2 
$()</div></li>	 
!else
$()	 	<li> 
!insmath \Delta=$val16
$().</li>	<li> Il y a donc $m_reply2 solutions.</li>	<li>	 
!if $val21=2 
$()	 Compléter la solution unique :	  
!read oef/special.phtml mathmlinput [x_0 = \frac{reply3}{reply4}],5,noanswer	 reply 3	 reply 4	 
$()	  
!else
$() 	 Compléter les deux solutions distinctes :	   
!read oef/special.phtml mathmlinput [x_1=\frac{reply3 + \sqrt{reply5}}{reply4}, x_2=\frac{reply6 - \sqrt{reply8}}{reply7}],3,noanswer	 reply 3	 reply 4	 reply 5	 reply 6	 reply 7	 reply 8	 
$()	 
!endif
$()	</li>	 
!endif
$()	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val24
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp=!translate ";': to $     $ in ($m_reply3 + sqrt($m_reply5))/($m_reply4)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=$(tmp0)
tmp=!translate ";': to $     $ in ($m_reply6 - sqrt($m_reply8))/($m_reply7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val32=$(tmp0)

!exit

:feedback

!exit

:test

condlist=$val23

!ifval ($val21=2 and $m_reply3/($m_reply4)==-$val9/($val17)) or	  ($val21=3 and $val31+$val32=-$val9/($val19) and ($val31)*($val32)=$val18/($val19))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Solution(s) correcte(s) ? 

!exit

:stat
vsavelist=6,9,14,15,16,17,18,19,21,23,24,25,26,27,28,29,30
embedcnt=4
