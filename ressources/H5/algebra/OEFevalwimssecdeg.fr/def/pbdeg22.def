ansorder=r
varcnt=38
prevarcnt=37
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=xrange -15,15	 yrange -15,15	 parallel -15,-15,-15,15,1,0,30,gray	 parallel -15,-15,15,-15,0,1,30,gray	 linewidth 2	 arrow 0,-15,0,15,10,blue	 arrow -15,0,15,0,10,blue	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	
val7=$[rint(2)]
tmp0=!randint -3, 3

val8=$[rint($(tmp0))]
tmp0=!randitem -3,-2,-1,0,0,0,1,2,3

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint(-15-$(tmp0))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
t_=!rawmath ($val11-$val9)/($val10-$val8)^2
val12=!exec pari print($t_)
val13=$val12*(x-$val8)^2+$val9
t_=!replace internal \( by ( in expand($val13)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
!if $val7=3 

!ifval $val12>0
val15=$[rint($val8+sqrt((15-$val9)/$val12))]
!else
val15=$[rint($val8+sqrt(($val9-15)/$val12))]
!endif
tmp0=!randint -10, $val15

val16=$[rint($(tmp0))]
evaltmp=$val13

evaltmp=!mathsubst x=($val16) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
t_=!rawmath ($val17-$val11)/($val16-$val10)
val18=!exec pari print($t_)
t_=!rawmath $val11-$val18*$val10
val19=!exec pari print($t_)
!endif
!if $val7=2 
t_=!rawmath 2*$val12*($val10-$val8)
val18=!exec pari print($t_)
t_=!rawmath $val11-$val18*$val10
val19=!exec pari print($t_)
!endif
!if $val7=1 
t_=!rawmath 2*$val12*($val10-$val8)
val18=!exec pari print($t_)

!ifval $val12<0
tmp0=!randint 1, 3

t_=!rawmath $val11-$val18*$val10+$(tmp0)
val19=!exec pari print($t_)
!else
tmp1=!randint 1, 3

t_=!rawmath $val11-$val18*$val10-$(tmp1)
val19=!exec pari print($t_)
!endif
!endif
val6=animate 10,0.5,0	 $val6	 
val20=plot green,($val18+s*20-10)*x+$val19
tmp0=!texmath t*x+$val19

val21=$(tmp0)
t_=!rawmath $val18
val22=!exec pari print($t_)
t_=!rawmath -2*$val12($val10+$val8)
val23=!exec pari print($t_)

!ifval $val22=$val23
val24=$val22
!else
val24=$val22,$val23
!endif
val25=$val12
tmp0=!replace internal / by , in $val25

val26=$(tmp0)
val27=$[rint($(val26[2]))]
t_=!replace internal \( by ( in expand($val27*($val13 - t*x -$val19))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val28=$(tmp1)
tmp0=!replace internal x^2 by , in $val28

val29=$(tmp0)
tmp0=!replace internal x by , in $val29

val29=$(tmp0)
tmp0=!replace internal t by *t in $val29

val29=$(tmp0)
val30=$(val29[1])

!ifval $val30=
val30=1
!endif
tmp0=!texmath $(val29[2])+$(val29[3])

val31=$(tmp0)
val32=$(val29[4])
val33=On veut que l'équation \($val14=$val21\) ait une seule solution,	  c'est-à-dire que le discriminant de \($val28=0\) soit nul.	  <div class="wimscenter">	\(\Delta=($val31)^2-4\times ($val30) \times ($val32)=0 \Leftrightarrow t=$val18\) ou \(t= $val23\)	</div>	
val6=$val6	 plot red,$val13	 $val20	
replytype1=fset
replyname1=\(t\)
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val33


!goto stat

!exit

