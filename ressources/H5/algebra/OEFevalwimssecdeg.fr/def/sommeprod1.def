!set title=Somme et produit des racines 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude, David
email=mcldavid@orange.fr
keywords=equations,trinomial,roots
language=fr
computeanswer=no
precision=10000
leftrange=-5.000000
rightrange=5.000000
oefdescription=Somme et produit des racines d'un polynôme du second degré.

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint -2, 5

val7=$[rint($(tmp0))]
val8=$[rint($val6 + ($val7))]
val9=$[rint(-$val8)]
val10=$[rint($val6*$val7)]
val11=$[rint(($val9)^2-4*($val10))]
t_=!replace internal \( by ( in x^2+$val9*x+$val10
tmp0=!exec pari $t_

val12=$(tmp0)
replytype1=numeric
replyname1=somme
replygood1=$[$val8]
replytype2=numeric
replyname2=produit
replygood2=$[$val10]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst On peut connaître la somme et le produit des racines du polynôme sans les calculer. Il suffit d'imaginer le trinôme factorisé. 


!goto stat

!exit

:question
$()	<p>Soit 
!insmath P(x) = $val12
$(). Ce polynôme admet deux racines distinctes ou confondues.	  Calculer leur somme et leur produit.</p>	<div>Les deux racines du polynômes ont pour somme	   
!read oef/embed.phtml reply 1,20 
$() et pour produit  
!read oef/embed.phtml reply 2,20 
$().	</div>	
$()
!exit

:hint
$()On peut connaître la somme et le produit des racines du polynôme sans les calculer. Il suffit d'imaginer le trinôme factorisé. 
$()
!exit

