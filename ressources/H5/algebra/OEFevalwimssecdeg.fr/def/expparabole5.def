!set title=Exploiter une parabole 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=parabola

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=xrange -15,15	 yrange -15,15	 parallel -15,-15,-15,15,1,0,30,gray	 parallel -15,-15,15,-15,0,1,30,gray	 linewidth 2	 arrow 0,-15,0,15,10,blue	 arrow -15,0,15,0,10,blue	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val7=$val8
val8=$[rint($val8+1)]
!endif
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
t_=!rawmath $val9/($val7*$val8)
val10=!exec pari print($t_)
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]

!ifval $val11=1
tmp0=!randint 1, 14-$val9

val12=$[rint($(tmp0))]
!else
tmp1=!randint 1, 12

val12=$[rint(-$(tmp1))]
!endif
val13=$val10*(x-$val7)*(x-$val8)+$val12
val14=des points d'intersection avec les droites d'équation \(y=$val12) et \(x=0)
val15=<div class="wims_instruction">Donner une forme semi-factorisée de préférence du type \(\alpha(x-\beta)(x-\gamma)+\delta).</div>
val6=$val6	 dsegment -15,$val12,15,$val12,blue	
val16=Soit \(f) la fonction dont la parabole \(\mathcal{P}) est la courbe représentative.<br>	  Considérons la fonction \(g) définie par \(g(x)=f(x)-$val12).<br>	  Il vient \(g($val7)=g($val8)=0) donc \(g(x)=a(x-$val7)(x-$val8)).<br>	  De plus \(g(0)=f(0)-$val12=$val9=a($val7)($val8)) donc \(g(x)=$val10(x-$val7)(x-$val8)).<br>	  Donc \(f(x)=$val10(x-$val7)(x-$val8)+$val12).
tmp0=!texmath a*x^2+b*x+c

val17=$(tmp0)
tmp0=!text expand $val17 using 01

val17=$(tmp0)
val6=$val6	 plot red,$val13	
replytype1=function
replyname1=équation de P
replygood1=!rawmath $val13
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val16


!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 300,300 \
$val6 
$()</div>	 <div class="medium_size text_col">	  On a représenté ci-dessous une parabole 
!insmath \mathcal{P}
$() d'équation:	<div class="wimscenter"> 
!insmath \mathcal{P}: y=$val17
$()</div>	<div>	  Par lecture graphique $val14, déterminer une équation de 
!insmath \mathcal{P}
$():	<br>$val15</div>	<div class="wimscenter"> <label for="reply1">
!insmath \mathcal{P}
$()</label>:y=  
!read oef/embed.phtml reply1 
$()</div>	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val16
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,14,15,16,17
embedcnt=1
