!set title=Factorisation de polynômes 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=polynomials,factorization

ansorder=r,r,r,r,r,r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=9
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,-1,2,-2

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in x-($val6)
tmp0=!exec maxima $t_

val10=($(tmp0))
val11=$[rint($val6)]
val12=$[rint($val6)]
!if $val7=1 
tmp0=!randint 1, 5

val13=$[rint($val8*$(tmp0)^2)]
!endif
!if $val7=2 
val13=$[rint(0)]
val11=$[rint(-($val9))]
val12=$[rint(-($val9))]
!endif
!if $val7=3 
tmp0=!randint 1, 5

val13=$[rint(-$val8*$(tmp0)^2)]
t_=!replace internal \( by ( in -($val9)-sqrt($val13/$val8)
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!replace internal \( by ( in -($val9)+sqrt($val13/$val8)
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
!endif
val14=$[rint(2*$val8*$val9)]
val15=$[rint($val8*($val9)^2+$val13)]
val16=$val6,$val11,$val12
tmp0=!listuniq $val16

val16=$(tmp0)
tmp0=!itemcnt $val16

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand((x-($val6))*($val8*(x+($val9))^2+($val13)))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
t_=!replace internal \( by ( in factor((x-($val6))*($val8*(x+($val9))^2+($val13)))
tmp0=!exec maxima $t_

val19=$(tmp0)
oefsteps=r1,r2,r3 
nextstep=!nosubst r1,r2,r3 
!readproc oef/steps.proc
replytype1=numeric
replyname1=a
replygood1=$[$val8]
replytype2=numeric
replyname2=b
replygood2=$[$val14]
replytype3=numeric
replyname3=c
replygood3=$[$val15]
replytype4=numeric
replyname4=nombre de racines
replygood4=$[$val17]
replytype5=algexp
replyname5=factorisation
replygood5=$val19
replytype6=numeric
replyname6=\(P(1))
replygood6=?analyze 20
replytype7=numeric
replyname7=\(P(-1))
replygood7=?analyze 21
replytype8=numeric
replyname8=\(P(2))
replygood8=?analyze 22
replytype9=numeric
replyname9=\(P(-2))
replygood9=?analyze 23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Soit le polynôme 
!insmath P(x)=$val18
$().	  On remarque que 
!insmath P($val6)=0
$().<p>	  Trouver des réels 
!insmath a
$(), 
!insmath b
$() et 
!insmath c
$() tels que 
!insmath P(x)=$val10(a x^2+b x+c)
$().</p>	<div class="wimscenter">	<label for="reply1">
!insmath a=
$()</label>  
!read oef/embed.phtml reply1,4 
$(),	<label for="reply2">
!insmath b=
$()</label>  
!read oef/embed.phtml reply2,4 
$() et	<label for="reply3">
!insmath c=
$()</label>  
!read oef/embed.phtml reply3,4 
$()	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10,18,20,21,22,23
embedcnt=3
