!set title=Résoudre une équation du second degré 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=equations,trinomial,roots
precision=1000

ansorder=r
varcnt=41
prevarcnt=40
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La calculatrice n'est pas autorisée.
val7=
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
tmp0=!texmath x^2+$val8*x

val9=$(tmp0)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

val11=$[rint($(tmp0))]
tmp0=!randint 1, 9

val8=$[rint(-$(tmp0))]
val12=$[rint(($val8)^2-4*$val10*$val11)]

!ifval $val12=0
val11=$[rint($val11+1)]
!endif
tmp0=!texmath $val10*x^2+$val8*x+ $val11

val9=$(tmp0)
t_=!rawmath 3/2
val13=!exec pari print($t_)
tmp0=!randint 2, 5

t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
t_=!replace internal \( by ( in expand(2*(x-$val13)*(x-$val14))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val9=$(tmp1)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
tmp0=!randitem 1,-1

val15=$[rint($(tmp0))]
val10=$[rint($val15*$val10)]
val11=$[rint($val15*$val11)]
tmp0=!texmath $val10*x^2+$val11

val9=$(tmp0)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
val11=$[rint(-$val11)]
tmp0=!texmath $val10*x^2+$val11

val9=$(tmp0)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
tmp0=!randint -9, 9

val16=$[rint($(tmp0))]
tmp0=!texmath ($val10*x+$val8)*($val11*x+$val16)

val9=$(tmp0)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
tmp0=!randint 2, 9

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath $val10*x^2+$val8*x

val9=$(tmp0)
tmp0=!append item \($val9=0) to $val7

val7=$(tmp0)
tmp0=!randitem 1,3,5,7,9

val13=$[rint($(tmp0))]
t_=!rawmath $val13/2
val13=!exec pari print($t_)
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val14=$[rint(2*$(tmp0)*$(tmp1))]
val11=$[rint(-2*$val10*$val13*$val14)]
t_=!replace internal \( by ( in expand(2*$val10*(x-$val13)*(x-$val14)+$val11)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val9=$(tmp1)
val12=$[rint(($val8)^2+4*$val10*$val11)]

!ifval $val12=0
val11=$[rint($val11+1)]
!endif
tmp0=!texmath $val10*x^2+$val8*x

val9=$(tmp0)
tmp0=!append item \($val9=$val11) to $val7

val7=$(tmp0)
val17=1,3,4,5,6
replytype1=checkbox
replyoption1=shuffle 
replyname1=sans discriminant
replygood1=$val17;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_warning">$val6</div>	<p>	  Parmi les équations suivantes, cocher celles qui peuvent être résolues sans	  utiliser le discriminant 
!insmath \Delta
$().	</p>	<ol>	<li> 
