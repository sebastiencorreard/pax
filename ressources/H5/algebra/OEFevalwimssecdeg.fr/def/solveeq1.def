!set title=Résoudre une équation du second degré 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=equations,trinomial,roots
precision=1000

ansorder=r,r,r,r,r,r,r,r
varcnt=23
prevarcnt=20
postvarcnt=2
replycnt=8
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La calculatrice n'est pas autorisée.
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0)*$val7)]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 10

val10=$[rint(-$(tmp0)*$val7)]
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=$[rint(($val9)^2-4*$val8*$val10)]
val13=$[rint(2*$val8)]
val14=$[rint($val8)]
val15=$[rint($val10)]
val16=0
val17=$[rint(-$val9)]

!ifval $val12<0
val18=$[rint(1)]
!endif

!ifval $val12=0
val18=$[rint(2)]
!endif

!ifval $val12>0
val18=$[rint(3)]
!endif

!ifval $val18=1
val19=r1,r2
!else
val19=r1,r2	r3,r4
!endif

!ifval $val18=3
val19=$val19,r5,r6,r7,r8
!endif

!ifval $val12>=0
val20=1
!else
val20=
!endif

!ifval $val12>0
val21=Les solutions sont \(\frac{$val17-\sqrt{$val12}}{$val13}\) et	  \(\frac{$val17+\sqrt{$val12}}{$val13}\)
!else
val21= la solution est \(\frac{$val17}{$val13}\)
!endif

!ifval $val12<0
val21=
!endif
oefsteps=$val19 
nextstep=!nosubst $val19 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Discriminant
replygood1=$[$val12]
replytype2=radio
replyname2=nombre de solutions
replygood2=$val18;aucune solution, une solution, deux solutions distinctes
replytype3=numeric
replyoption3=noanalyzeprint 
replyname3=
replygood3=?analyze 22
replytype4=numeric
replyoption4=noanalyzeprint 
replyname4=
replygood4=?analyze 23
replytype5=numeric
replyoption5=noanalyzeprint 
replyname5=
replygood5=?analyze 24
replytype6=numeric
replyoption6=noanalyzeprint 
replyname6=
replygood6=?analyze 25
replytype7=numeric
replyoption7=noanalyzeprint 
replyname7=
replygood7=?analyze 26
replytype8=numeric
replyoption8=noanalyzeprint 
replyname8=
replygood8=?analyze 27
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val21


!goto stat

!exit

:question
$()<div class="wims_warning">$val6</div>	  Résoudre l'équation 
!insmath (E) : $val11=$val16
$(). Pour cela,	<ol>	
!if $m_step=1 
$()	<li> Calculer le discriminant 
!insmath \Delta
$() de cette équation:	<div class="wimscenter"> <label for="reply1">
!insmath \Delta
$()</label>= 
!read oef/embed.phtml reply1 
$()</div></li>	<li> En déduire <label for="reply2">le nombre de solutions de 
!insmath (E)
$():</label>	<div class="wimscenter"> 
!read oef/embed.phtml reply2 
$()</div></li>	 
!else
$()	 	<li> 
!insmath \Delta=$val12
$().</li>	<li> Il y a donc $m_reply2 solutions.</li>	<li>	 
!if $val18=2 
$()	 Compléter la solution unique :	  
!read oef/special.phtml mathmlinput [x_0 = \frac{reply3}{reply4}],5,noanswer	 reply 3	 reply 4	 
$()	  
!else
$() 	 Compléter les deux solutions distinctes :	   
!read oef/special.phtml mathmlinput [x_1=\frac{reply3 + \sqrt{reply5}}{reply4}, x_2=\frac{reply6 - \sqrt{reply8}}{reply7}],3,noanswer	 reply 3	 reply 4	 reply 5	 reply 6	 reply 7	 reply 8	 
$()	 
!endif
$()	</li>	 
!endif
$()	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val21
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp=!translate ";': to $     $ in ($m_reply3 + sqrt($m_reply5))/($m_reply4)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28=$(tmp0)
tmp=!translate ";': to $     $ in ($m_reply6 - sqrt($m_reply8))/($m_reply7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val29=$(tmp0)

!exit

:feedback

!exit

:test

condlist=$val20

!ifval ($val18=2 and $m_reply3/($m_reply4)==-$val9/($val13)) or	  ($val18=3 and $val28+$val29=-$val9/($val14) and ($val28)*($val29)=$val15/($val14))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Solution(s) correcte(s) ? 

!exit

:stat
vsavelist=6,9,11,12,13,14,15,16,18,20,21,22,23,24,25,26,27
embedcnt=4
