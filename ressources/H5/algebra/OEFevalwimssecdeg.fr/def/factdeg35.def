tmp=!nonempty items 1,-1,2,-2

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in x-($val6)
tmp0=!exec maxima $t_

val10=($(tmp0))
val11=$[rint($val6)]
val12=$[rint($val6)]
!if $val7=1 
tmp0=!randint 1, 5

val13=$[rint($val8*$(tmp0)^2)]
!endif
!if $val7=2 
val13=$[rint(0)]
val11=$[rint(-($val9))]
val12=$[rint(-($val9))]
!endif
!if $val7=3 
tmp0=!randint 1, 5

val13=$[rint(-$val8*$(tmp0)^2)]
t_=!replace internal \( by ( in -($val9)-sqrt($val13/$val8)
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!replace internal \( by ( in -($val9)+sqrt($val13/$val8)
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
!endif
val14=$[rint(2*$val8*$val9)]
val15=$[rint($val8*($val9)^2+$val13)]
val16=$val6,$val11,$val12
tmp0=!listuniq $val16

val16=$(tmp0)
tmp0=!itemcnt $val16

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand((x-($val6))*($val8*(x+($val9))^2+($val13)))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
t_=!replace internal \( by ( in factor((x-($val6))*($val8*(x+($val9))^2+($val13)))
tmp0=!exec maxima $t_

val19=$(tmp0)
val20=Les polynômes irréductibles intervenant dans la factorisation	  doivent avoir leur coefficient de plus haut degré égal à 1. Par exemple,	\( 4x^2-9= 4(x-3/2)(x+3/2)=4(x-1.5)(x+1.5)\)
val21=!rawmath (x-($val6))*($val8*(x+($val9))^2+($val13))
evaltmp=$val21

evaltmp=!mathsubst x=(1) in $evaltmp
tmp0=($evaltmp)
val22=$[rint($(tmp0))]
evaltmp=$val21

evaltmp=!mathsubst x=(-1) in $evaltmp
tmp0=($evaltmp)
val23=$[rint($(tmp0))]
evaltmp=$val21

evaltmp=!mathsubst x=(2) in $evaltmp
tmp0=($evaltmp)
val24=$[rint($(tmp0))]
evaltmp=$val21

evaltmp=!mathsubst x=(-2) in $evaltmp
tmp0=($evaltmp)
val25=$[rint($(tmp0))]
