!set title=Exploiter une parabole 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=parabola

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=xrange -15,15	 yrange -15,15	 parallel -15,-15,-15,15,1,0,30,gray	 parallel -15,-15,15,-15,0,1,30,gray	 linewidth 2	 arrow 0,-15,0,15,10,blue	 arrow -15,0,15,0,10,blue	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val9*(x-$val7)*(x-$val8)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
t_=!replace internal \( by ( in expand($val9*(x-$val7)*(x-$val8))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val12=$(tmp1)

!ifval $val9=1
t_=!replace internal \( by ( in $val10*(x-$val7)*(x-$val8)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val13=$(tmp1)
!else
t_=!replace internal \( by ( in (x-$val7)*(x-$val8)
tmp2=!exec maxima $t_

tmp3=!texmath $(tmp2)

val13=$(tmp3)
!endif
t_=!replace internal \( by ( in -$val9*(x-$val7)*(x-$val8)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
t_=!replace internal \( by ( in -$val9*(x+$val7)*(x+$val8)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)

!ifval $val9=1
t_=!replace internal \( by ( in expand($val10*(x-$val7)*(x-$val8))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val16=$(tmp1)
!else
t_=!replace internal \( by ( in expand((x-$val7)*(x-$val8))
tmp2=!exec maxima $t_

tmp3=!texmath $(tmp2)

val16=$(tmp3)
!endif
val17=\(y=$val11),\(y=$val12),\(y=$val13),\(y=$val14),\(y=$val15),\(y=$val16)
val18=1,2
val6=$val6	 plot red,$val9*(x-$val7)*(x-$val8)	
replytype1=checkbox
replyoption1=shuffle 
replyname1=équation de P
replygood1=$val18;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 300,300 \
$val6 
$()</div>	 <div class="medium_size text_col">	  On considère la parabole 
!insmath \mathcal{P}
$() représentée ci-contre.	  Une équation de cette parabole est:	<ul>	 <li> 
!read oef/embed.phtml reply1,1 
$()</li>	 <li> 
!read oef/embed.phtml reply1,2 
$()</li>	 <li> 
!read oef/embed.phtml reply1,3 
$()</li>	 <li> 
!read oef/embed.phtml reply1,4 
$()</li>	 <li> 
!read oef/embed.phtml reply1,5 
$()</li>	 <li> 
!read oef/embed.phtml reply1,6 
$()</li>	 </ul>	</div></div>	<div class="wims_instruction"> Cocher toutes les réponses possibles.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=6
