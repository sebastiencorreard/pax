!set title=Problème du second degré 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Maguy, Bruno
email=regine@mangeard.fr
keywords=equations, trinomial,roots

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=xrange -15,15	 yrange -15,15	 parallel -15,-15,-15,15,1,0,30,gray	 parallel -15,-15,15,-15,0,1,30,gray	 linewidth 2	 arrow 0,-15,0,15,10,blue	 arrow -15,0,15,0,10,blue	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -9, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath x-$val10

val11=$(tmp0)
val12=$val7*x^2+$val8*x+$val9
val13=(x-$val10)*($val12)
t_=!replace internal \( by ( in expand($val13)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
evaltmp=$val12

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val15=$[rint($(tmp0))]
val16=$[rint(($val8)^2-4*$val7*$val9)]

!ifval $val15=0
val17=$[rint(0)]
!else
val17=$[rint(1)]
!endif

!ifval $val16>0
val18=$[rint(2)]
!else
val18=$[rint(1)]
!endif

!ifval $val16<0
val18=$[rint(0)]
!endif
val17=$[rint($val17+$val18)]
replytype1=function
replyname1=g
replygood1=!rawmath $val12
replytype2=numeric
replyname2=nb solutions
replygood2=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction f, définie sur 
!insmath \,\RR
$(), par 
!insmath f(x)= $val14
$().	<ol>	<li> Déterminer une fonction polynôme 
!insmath g
$() de degré 2 telle que :	<div class="wimscenter">
!insmath f(x)=($val11)g(x)
$()</div>	<div class="wimscenter"><label for="reply1">
!insmath g(x)
$()=</label> 
!read oef/embed.phtml reply1 
$()</div>	</li>	<li> Combien l'équation 
!insmath $val14=0
$() possède-t-elle de solutions distinctes dans 
!insmath \,\RR
$()?	<div class="wimscenter"> <label for="reply2">Nombre de solutions :</label>	   
!read oef/embed.phtml reply2 
$()</div>	</li>	</ol>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,14
embedcnt=2
