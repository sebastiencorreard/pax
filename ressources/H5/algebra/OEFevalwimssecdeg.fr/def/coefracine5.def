!set title=Coefficients et racines 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 10

val6=$[rint($(tmp0))]
tmp0=!randint 8, 20

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp=!translate ";': to $     $ in 1/$val6+1/$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val9=!exec pari print($t_)
t_=!rawmath ($val9)^(-1)
val9=!exec pari print($t_)
tmp0=!texmath $val9

val9=$(tmp0)
replytype1=numeric
replyname1=\(R_1)
replygood1=?analyze 10
replytype2=numeric
replyname2=\(R_2)
replygood2=?analyze 11
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Quand les résistances sont en série, la résistance totale est la somme des résistances.<br> Quand les résistances sont en parallèle, les conductances s'ajoutent. L'inverse de la résistance totale est la somme des des inverses des résistances.


!goto stat

!exit

:question
$()	
!insmath R_1
$() et 
!insmath R_2
$() sont deux résistances inconnues.	<ul><li>	  Si on les branche en parallèle, on obtient une résistance équivalente de 
!insmath $val9 \Omega
$().	</li><li>	  Si on les branche en série, on obtient une résistance équivalente de 
!insmath $val8 \Omega
$().	</li></ul>	  Déterminer les valeurs de 
!insmath R_1
$() et 
!insmath R_2
$().	<ul class="wims_nopuce">	<li>	<label for="reply1">
!insmath R_1=
$() </label> 
!read oef/embed.phtml reply1,4 
$()	</li><li>	<label for="reply2">
!insmath R_2=
$() </label> 
!read oef/embed.phtml reply2,4 
$()	</li>	</ul>	
$()
!exit

:hint
$()Quand les résistances sont en série, la résistance totale est la somme des résistances.<br> Quand les résistances sont en parallèle, les conductances s'ajoutent. L'inverse de la résistance totale est la somme des des inverses des résistances.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val10=$val6 and $val11=$val7) or ($val10=$val7 and $val11=$val6)
 condtest1=1
!else
 condtest1=0
!endif
condname1=valeurs des résistances

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=2
