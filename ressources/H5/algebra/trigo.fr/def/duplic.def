!set title=Formule de duplication
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frederic, Pitoun
email=frederic.pitoun@free.fr
precision=1000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!random -1, 1

val7=$[$(tmp0)]
val8=$[floor(1000*cos($val7))/1000]
!if $val6=1 
val9=$[2*$val8^2-1]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
val11=cos(2t)
!endif
!if $val6=2 
val9=$[sqrt(($val8+1)/2)]
val10=$[rint($val6-1)]
val11=cos(t/2)
!endif
!if $val6=3 
val9=$[-1*sqrt(($val8+1)/2)]
val10=$[rint($val6-1)]
val11=cos(t/2)
!endif
tmp=!trim 0 , \pi	\pi , 2\pi	
val12=!translate internal $	\
$ to ;; in $tmp
val13=$(val12[$val10;1])
val14=$(val12[$val10;2])
replytype1=default
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath t
$() un réel tel que 
!insmath cos(t)=$val8
$(). Déterminer la valeur	de 
!insmath $val11
$() sachant que 
!insmath t
$() est situé dans l'intervalle	 
!insmath \lbrack $val13 ; $val14 \rbrack
$().<br />	On a 
!insmath $val11
$() =  
!read oef/embed.phtml reply 1 ,10 
$().	<div class="wims_instruction">Remarque: Un précision de 
!insmath 10^{-3}
$() est demandée.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,11,13,14
embedcnt=1
