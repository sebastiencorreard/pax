!set title=Théorème de Pythagore
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frederic, Pitoun
email=lva.pitoun@free.fr
precision=100

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,1

val6=$[rint($(tmp0))]
tmp0=!randitem 0,1

val7=$[rint($(tmp0))]
val8=$[rint(1+$val6+2*($val7))]
tmp0=!randint -5, 5

val9=$[rint(2*$(tmp0))]
tmp=!trim 0,1	-1,0	-1/2,1/2	1/2,3/2	
val10=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in ($(val10[$val8;1])+$val9)*x
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($(val10[$val8;2])+$val9)*x
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!replace x by \pi in $val11

val13=$(tmp0)
tmp0=!replace x by \pi in $val12

val14=$(tmp0)
tmp0=!random -1, 1

val15=$[$(tmp0)]
val15=$[floor(100*$val15)/100]
tmp0=!item $val8 of 1,-1,1,-1

val16=$[rint($(tmp0))]
tmp0=!item $val8 of cos,cos,sin,sin

val17=$(tmp0)
tmp0=!item $val8 of sin,sin,cos,cos

val18=$(tmp0)
val19=$[($val16)*sqrt(1-($val15)^2)]
replytype1=default
replyname1=
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath t
$() un réel tel que 
!insmath $val17(t)=$val15
$(). Déterminer la valeur	de 
!insmath $val18(t)
$() sachant que 
!insmath t
$() est dans l'intervalle 
!insmath \lbrack
$() 
!insmath   $val13 ; $val14
$() 
!insmath  \rbrack
$().	<div class="wimscenter">	On a 
!insmath $val18(t)=
$()  
!read oef/embed.phtml reply 1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14,15,17,18
embedcnt=1
