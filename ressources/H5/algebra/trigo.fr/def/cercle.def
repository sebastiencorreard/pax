!set title=Cercle trigonométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frederic, Pitoun
email=frederic.pitoun@free.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,7/6,3/4,4/3,3/2,4/3,7/4,11/6
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!itemcnt $val6

val8=$[rint($(tmp0))]
tmp0=!randint 1, $val8

val9=$[rint($(tmp0))]
tmp0=!item $val9 of $val6

t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
t_=!replace internal \( by ( in ($val10+2*$val7)*x
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp0=!replace x by \pi in $val11

val12=$(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=(3.14159) in $evaltmp
tmp0=($evaltmp)
val13=$[cos($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=(3.14159) in $evaltmp
tmp0=($evaltmp)
val14=$[sin($(tmp0))]
val15=$[rint(100*$val13+100)]
val16=$[rint(100-100*$val14)]
!readproc oef/draw.phtml 200,200 \
xrange -1,1	yrange -1,1	linewidth 2	circle 0,0,200,red	arrow -1,0,1,0,10,blue	arrow 0,-1,0,1,10,blue	linewidth=1	dsegment 0.7,-0.7,0.7,0.7,green	dsegment 0.7,0.7,-0.7,0.7,green	dsegment -0.7,0.7,-0.7,-0.7,green	dsegment -0.7,-0.7,0.7,-0.7,green		dsegment 0.87,-0.5,0.87,0.5,green	dsegment 0.87,0.5,-0.87,0.5,green	dsegment -0.87,0.5,-0.87,-0.5,green	dsegment -0.87,-0.5,0.87,-0.5,green		dsegment 0.5,-0.87,0.5,0.87,green	dsegment 0.5,0.87,-0.5,0.87,green	dsegment -0.5,0.87,-0.5,-0.87,green	dsegment -0.5,-0.87,0.5,-0.87,green	 
tmp0=$ins_url
val17=$(tmp0)	
!readproc oef/draw.phtml 200,200 \
xrange -1,1	yrange -1,1	linewidth 2	circle 0,0,200,red	arrow -1,0,1,0,10,blue	arrow 0,-1,0,1,10,blue	linewidth=1	dsegment 0.7,-0.7,0.7,0.7,green	dsegment 0.7,0.7,-0.7,0.7,green	dsegment -0.7,0.7,-0.7,-0.7,green	dsegment -0.7,-0.7,0.7,-0.7,green		dsegment 0.87,-0.5,0.87,0.5,green	dsegment 0.87,0.5,-0.87,0.5,green	dsegment -0.87,0.5,-0.87,-0.5,green	dsegment -0.87,-0.5,0.87,-0.5,green		dsegment 0.5,-0.87,0.5,0.87,green	dsegment 0.5,0.87,-0.5,0.87,green	dsegment -0.5,0.87,-0.5,-0.87,green	dsegment -0.5,-0.87,0.5,-0.87,green		fcircle $val13,$val14,10,green	 
tmp0=$ins_url
val18=$(tmp0)	
replytype1=coord
replyname1=
replygood1=$val17;circle,$val15,$val16,20
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst <div class="wimscenter"> <img src="$val18" alt="" /> </div>


!goto stat

!exit

:question
$()	On a représenté ci-dessous le cercle trigonométrique ainsi que les lignes	trigonométriques remarquables. On note 
!insmath I(1;0)
$().<br />	Placer le point 
!insmath M
$()	tel que l'angle orienté 
!insmath (\overrightarrow{O I},\overrightarrow{O M})
$() mesure	
!insmath $val12
$() radians.		<div class="wimscenter">	 
!read oef/embed.phtml reply 1 
$()	</div>	
$()
!exit

