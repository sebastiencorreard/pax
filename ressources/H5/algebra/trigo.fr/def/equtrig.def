val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of cos,sin

val7=$(tmp0)
tmp=!trim 1/6,1/4,1/3,1/2,2/3,3/4,5/6	-1/6,-1/4,-1/3,-1/2,-2/3,-3/4,-5/6	11/6,7/4,5/3,3/2,4/3,5/4,7/6	\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2}	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim -1/3,-1/4,-1/6,0,1/6,1/4,1/3	-2/3,-3/4,-5/6,0,5/6,3/4,2/3	5/3,7/4,11/6,0,1/6,1/4,1/3	4/3,5/4,7/6,0,5/6,3/4,2/3	-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2},0,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2}	
val9=!translate internal $	\
$ to ;; in $tmp
!if $val6=1 
tmp=!trim $val8
val10=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim $val9
val10=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!randint 1, 7

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!randint -2, 2

val13=$[rint(2*$(tmp0))]
tmp=!trim -1+$val13,1+$val13	$val13,2+$val13	
val14=!translate internal $	\
$ to ;; in $tmp
val15=$(val10[3+$val6;$val11])
t_=!replace internal \( by ( in ($(val14[$val12;1]))*x
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($(val14[$val12;2]))*x
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
tmp0=!replace x by \pi in $val16

val16=$(tmp0)
tmp0=!replace x by \pi in $val17

val17=$(tmp0)
!if $val6=1 
t_=!replace internal \( by ( in ($(val10[1;$val11])+$val13)*x
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($(val10[1+$val12;$val11])+$val13)*x
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
!else
!if $val12=1 
t_=!replace internal \( by ( in ($(val10[1;$val11])+$val13)*x
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($(val10[2;$val11])+$val13)*x
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
!endif
!if $val12=2 
t_=!replace internal \( by ( in ($(val10[3;$val11])+$val13)*x
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($(val10[4;$val11])+$val13)*x
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
!endif
!endif
!if $val6=2 and $val11=4 and $val12=1 
t_=!replace internal \( by ( in (-1+$val13)*x
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in (0+$val13)*x
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in (1+$val13)*x
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
!endif
!if $val6=2 and $val11=4 and $val12=2 
t_=!replace internal \( by ( in (0+$val13)*x
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in (1+$val13)*x
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in (2+$val13)*x
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
!endif
tmp0=!replace x by \pi in $val18

val18=$(tmp0)
tmp0=!replace x by \pi in $val19

val19=$(tmp0)
tmp0=!replace \pi by pi in $val18

val21=$(tmp0)
tmp0=!replace \pi by pi in $val19

val22=$(tmp0)
!if $val6=2 and $val11=4 
tmp0=!replace x by \pi in $val20

val20=$(tmp0)
tmp0=!replace \pi by pi in $val20

val23=$(tmp0)
tmp=!trim $val21,$val22,$val23
val24=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim $val21,$val22
val24=!translate internal $	\
$ to ;; in $tmp
!endif
replytype1=fset
replyname1=
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

