!set title=Symétries
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frederic, Pitoun
email=frederic.pitoun@free.fr

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!random 0, 6.28

val6=$[$(tmp0)]
val7=$[cos($val6)]
val8=$[sin($val6)]
tmp=!trim 1/2,1,3/2,2
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
tmp0=!item $val11 of $val9

t_=!rawmath $(tmp0)
val12=!exec pari print($t_)
t_=!replace internal \( by ( in ($val12+2*$val10)*x
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp0=!replace x by \pi in $val13

val14=$(tmp0)
evaltmp=$val13

evaltmp=!mathsubst x=(3.14159) in $evaltmp
tmp0=($evaltmp)
val15=$[cos($(tmp0)+$val6)]
evaltmp=$val13

evaltmp=!mathsubst x=(3.14159) in $evaltmp
tmp0=($evaltmp)
val16=$[sin($(tmp0)+$val6)]
val17=$[rint(100*$val15+100)]
val18=$[rint(100-100*$val16)]
!readproc oef/draw.phtml 200,200 \
xrange -1,1	yrange -1,1	linewidth 2	circle 0,0,200,red	arrow -1,0,1,0,10,blue	arrow 0,-1,0,1,10,blue	fcircle 0.99*$val7,0.99*$val8,10,blue	 
tmp0=$ins_url
val19=$(tmp0)	
!readproc oef/draw.phtml 200,200 \
xrange -1,1	yrange -1,1	linewidth 2	circle 0,0,200,red	arrow -1,0,1,0,10,blue	arrow 0,-1,0,1,10,blue	fcircle 0.99*$val7,0.99*$val8,10,blue	fcircle 0.99*$val15,0.99*$val16,10,green	 
tmp0=$ins_url
val20=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val19;circle,$val17,$val18,30
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst  <div class="wimscenter"> <img src="$val20" alt="" /> </div> 


!goto stat

!exit

:question
$()Sur le cercle trigonométrique ci-dessous, placer le point M	tel que l'angle orienté 
!insmath (\overrightarrow{O A},\overrightarrow{O M})
$() mesure	
!insmath $val14
$() radians. Le point A est marqué en bleu.		<div class="wimscenter">	 
