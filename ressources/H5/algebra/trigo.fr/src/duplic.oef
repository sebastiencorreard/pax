\title{Formule de duplication}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}
\precision{1000}
\integer{r=random(1..3)}

\real{c=random(-1..1)}
\real{cv=floor(1000*cos(\c))/1000}

\if{\r=1}{
\real{d=2*\cv^2-1}
\integer{ir=random(1..2)}
\text{ques=cos(2t)}
}
\if{\r=2}{
\real{d=sqrt((\cv+1)/2)}
\integer{ir=\r-1}
\text{ques=cos(t/2)}
}
\if{\r=3}{
\real{d=-1*sqrt((\cv+1)/2)}
\integer{ir=\r-1}
\text{ques=cos(t/2)}
}

\matrix{inter=
0 , \pi
\pi , 2\pi
}

\text{i1=\inter[\ir;1]}
\text{i2=\inter[\ir;2]}

\statement{Soit \(t) un réel tel que \(cos(t)=\cv). Déterminer la valeur
de \(\ques) sachant que \(t) est situé dans l'intervalle
 \(\lbrack \i1 ; \i2 \rbrack).<br />
On a \(\ques) = \embed{reply 1 ,10}.
<div class="wims_instruction">Remarque: Un précision de \(10^{-3}) est demandée.
</div>}

\answer{}{\d}{type=default}
