\title{Angles orientés}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}

\matrix{m=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,7/6,3/4,4/3,3/2,4/3,7/4,11/6}
\matrix{a=1/6,1/4,1/3,1/2,2/3,3/4,5/6}

\integer{k=randint(-10..10)}
\integer{lm=items(\m)}
\integer{la=items(\a)}
\integer{rm=randint(1..\lm)}
\integer{ra=randint(1..\la)}
\rational{angle=randint(-1,1)*item(\ra,\a)}
\rational{rm=item(\rm,\m)}
\rational{rn=\rm+\angle}
\real{xm=cos(\rm*3.14159)}
\real{ym=sin(\rm*3.14159)}
\real{xn=cos(\rn*3.14159)}
\real{yn=sin(\rn*3.14159)}


\text{image=draw(200,200
xrange -1,1
yrange -1,1
linewidth 2

circle 0,0,200,red

linewidth=1dsegment 0.7,-0.7,0.7,0.7,green
dsegment 0.7,0.7,-0.7,0.7,green
dsegment -0.7,0.7,-0.7,-0.7,green
dsegment -0.7,-0.7,0.7,-0.7,green

dsegment 0.87,-0.5,0.87,0.5,green
dsegment 0.87,0.5,-0.87,0.5,green
dsegment -0.87,0.5,-0.87,-0.5,green
dsegment -0.87,-0.5,0.87,-0.5,green

dsegment 0.5,-0.87,0.5,0.87,green
dsegment 0.5,0.87,-0.5,0.87,green
dsegment -0.5,0.87,-0.5,-0.87,green
dsegment -0.5,-0.87,0.5,-0.87,green
fcircle 0.99*\xm,0.99*\ym,10,blue
fcircle 0.99*\xn,0.99*\yn,10,green
arrow -1,0,1,0,10,blue
arrow 0,-1,0,1,10,blue
)
}

\function{anglea=\angle*x}
\text{anglea=wims(replace x by \pi in \anglea)}
\text{anglea=texmath(\anglea)}

\statement{Sur le cercle trigonométrique, ci-dessous, on a tracé les lignes trigonométriques
remarquables. En outre, on a placé deux points
A (en bleu) et B (en vert).<br />
Déterminer la mesure principale de l'angle orienté
formé par les vecteurs \(\overrightarrow{O A}) et \(\overrightarrow{O B}).
<div class="wimscenter">
<img src="\image" alt="" /><br />
La mesure principale de l'angle
\((\overrightarrow{O A},\overrightarrow{O B})) est:\embed{reply 1,6} \(\pi) radians.
</div>

<br>
<b>Remarque:</b> Votre réponse doit être un nombre rationnel.
}








\answer{}{\angle}{type=default}

\solution{La mesure principale de l'angle orienté
 \((\overrightarrow{O A},\overrightarrow{O B})) est \(\anglea)

}
