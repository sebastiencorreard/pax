\title{Symétries}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}

\real{a=random(0..6.28)}
\real{xa=cos(\a)}
\real{ya=sin(\a)}
\matrix{m=1/2,1,3/2,2}
\integer{k=randint(-10..10)}
\integer{r=randint(1..4)}
\rational{d=item(\r,\m)}
\function{p1=maxima((\d+2*\k)*x)}
\text{p2=wims( replace x by \pi in \p1)}
\real{xp=cos(evalue(\p1,x=3.14159)+\a)}
\real{yp=sin(evalue(\p1,x=3.14159)+\a)}
\integer{xr=100*\xp+100}
\integer{yr=100-100*\yp}

\text{image=draw(200,200
xrange -1,1
yrange -1,1
linewidth 2
circle 0,0,200,red
arrow -1,0,1,0,10,blue
arrow 0,-1,0,1,10,blue
fcircle 0.99*\xa,0.99*\ya,10,blue
)
}

\text{image2=draw(200,200
xrange -1,1
yrange -1,1
linewidth 2
circle 0,0,200,red
arrow -1,0,1,0,10,blue
arrow 0,-1,0,1,10,blue
fcircle 0.99*\xa,0.99*\ya,10,blue
fcircle 0.99*\xp,0.99*\yp,10,green
)}


\statement{Sur le cercle trigonométrique ci-dessous, placer le point M
tel que l'angle orienté \((\overrightarrow{O A},\overrightarrow{O M})) mesure
\(\p2) radians. Le point A est marqué en bleu.

<div class="wimscenter">
\embed{reply 1}
</div>
}

\answer{}{\image;circle,\xr,\yr,30}{type=coord}

\solution{
<div class="wimscenter">
<img src="\image2" alt="" />
</div>
}
