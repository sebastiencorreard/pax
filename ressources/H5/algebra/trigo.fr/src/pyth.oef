\title{Théorème de Pythagore}
\author{Frederic, Pitoun}
\email{lva.pitoun@free.fr}
\precision{100}
\integer{r0=random(0,1)}
\integer{r1=random(0,1)}
\integer{r=1+\r0+2*(\r1)}
\integer{p=2*randint(-5..5)}
\matrix{m=
0,1
-1,0
-1/2,1/2
1/2,3/2
}
\function{a=maxima((\m[\r;1]+\p)*x)}
\function{b=maxima((\m[\r;2]+\p)*x)}

\text{at=wims(replace x by \pi in \a)}
\text{bt=wims(replace x by \pi in \b)}

\real{u=random(-1..1)}
\real{u=floor(100*\u)/100}
\integer{s=item(\r,1,-1,1,-1)}
\text{don=item(\r,cos,cos,sin,sin)}
\text{dem=item(\r,sin,sin,cos,cos)}

\real{v=(\s)*sqrt(1-(\u)^2)}

\statement{Soit \(t) un réel tel que \(\don(t)=\u). Déterminer la valeur
de \(\dem(t)) sachant que \(t) est dans l'intervalle \(\lbrack) \(  \at ; \bt) \( \rbrack).
<div class="wimscenter">
On a \(\dem(t)=) \embed{reply 1}
</div>
}

\answer{}{\v}{type=default}
