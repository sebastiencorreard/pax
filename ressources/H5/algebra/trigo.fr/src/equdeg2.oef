\title{Second degré et fonctions trigonométriques}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}

\integer{f1=random(1,2)}
\integer{f2=random(1,2)}
\integer{f2=\f1}
\integer{f=\f1+2*(\f2-1)}
\integer{r1=random(1..5)}
\integer{r2=random(1..5)}
\integer{k=random(-1,1)*randint(1..5)}

\matrix{nombresol=
2,2,2,1,0
3,2,1,1,0
}

\integer{rn=\nombresol[\f1;\r1]+\nombresol[\f2;\r2]}
\text{m=0,random(-1,1)*random(0.1..0.9),1,-1,random(-1,1)*random(1.1..11)}

\real{a1=floor(\m[\r1]*100)/100}
\real{a2=floor(\m[\r2]*100)/100}

\if{\a1=\a2}{
\integer{rn=\rn/2}
}

\function{x1=item(\f1,cos,sin)}
\function{x2=item(\f2,cos,sin)}

\matrix{listefonc=
\k*(cos(2*x)+1-2*(\a1+\a2)*cos(x)+2*\a1*\a2)
\k*(sin(2*x)+1-2*(\a1)*sin(x)-2*(\a2)*cos(x)+2*\a1*\a2)
\k*(sin(2*x)+1-2*(\a2)*sin(x)-2*(\a1)*cos(x)+2*\a1*\a2)
\k*(-cos(2*x)+1-2*(\a1+\a2)*sin(x)+2*\a1*\a2)
}

\function{fonc=maxima(expand(\listefonc[\f;1]))}

\text{fonca=texmath(\fonc)}

\statement{
On considère l'équation
<div class="wimscenter">\(\fonca = 0)</div>
Combien cette équation possède-t-elle de solutions dans l'intervalle
\(\lbrack 0 ; 2 \pi \rbrack) ?<br />
Cette équation possède \embed{reply 1,10} solutions dans \(\lbrack 0 ; 2 \pi \rbrack).
}

\hint{Se ramener à une équation de degré 2 en \(\x1(x)) en utilisant la
relation
<div class="wimscenter">
\(\cos(2x)=2\cos^2(x)-1=1-2\sin^2(x))
</div>.
}

\answer{}{\rn}{type=default}
