\title{Cercle trigonométrique}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}

\matrix{m=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,7/6,3/4,4/3,3/2,4/3,7/4,11/6}
\integer{k=randint(-10..10)}
\integer{l=items(\m)}
\integer{r=randint(1..\l)}
\rational{a=item(\r,\m)}
\function{p1=maxima((\a+2*\k)*x)}
\text{p2=wims( replace x by \pi in \p1)}
\real{xp=cos(evalue(\p1,x=3.14159))}
\real{yp=sin(evalue(\p1,x=3.14159))}
\integer{xr=100*\xp+100}
\integer{yr=100-100*\yp}

\text{image=draw(200,200
xrange -1,1
yrange -1,1
linewidth 2
circle 0,0,200,red
arrow -1,0,1,0,10,blue
arrow 0,-1,0,1,10,blue
linewidth=1
dsegment 0.7,-0.7,0.7,0.7,green
dsegment 0.7,0.7,-0.7,0.7,green
dsegment -0.7,0.7,-0.7,-0.7,green
dsegment -0.7,-0.7,0.7,-0.7,green

dsegment 0.87,-0.5,0.87,0.5,green
dsegment 0.87,0.5,-0.87,0.5,green
dsegment -0.87,0.5,-0.87,-0.5,green
dsegment -0.87,-0.5,0.87,-0.5,green

dsegment 0.5,-0.87,0.5,0.87,green
dsegment 0.5,0.87,-0.5,0.87,green
dsegment -0.5,0.87,-0.5,-0.87,green
dsegment -0.5,-0.87,0.5,-0.87,green
)
}

\text{image2=draw(200,200
xrange -1,1
yrange -1,1
linewidth 2
circle 0,0,200,red
arrow -1,0,1,0,10,blue
arrow 0,-1,0,1,10,blue
linewidth=1
dsegment 0.7,-0.7,0.7,0.7,green
dsegment 0.7,0.7,-0.7,0.7,green
dsegment -0.7,0.7,-0.7,-0.7,green
dsegment -0.7,-0.7,0.7,-0.7,green

dsegment 0.87,-0.5,0.87,0.5,green
dsegment 0.87,0.5,-0.87,0.5,green
dsegment -0.87,0.5,-0.87,-0.5,green
dsegment -0.87,-0.5,0.87,-0.5,green

dsegment 0.5,-0.87,0.5,0.87,green
dsegment 0.5,0.87,-0.5,0.87,green
dsegment -0.5,0.87,-0.5,-0.87,green
dsegment -0.5,-0.87,0.5,-0.87,green

fcircle \xp,\yp,10,green
)
}

\statement{
On a représenté ci-dessous le cercle trigonométrique ainsi que les lignes
trigonométriques remarquables. On note \(I(1;0)).<br />
Placer le point \(M\)
tel que l'angle orienté \((\overrightarrow{O I},\overrightarrow{O M})) mesure
\(\p2) radians.

<div class="wimscenter">
\embed{reply 1}
</div>
}

\answer{}{\image;circle,\xr,\yr,20}{type=coord}

\solution{<div class="wimscenter">
<img src="\image2" alt="" />
</div>}
