\title{Dérivée des fonctions trigonométriques}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}
\integer{r=randitem(1,2)}
\integer{r=2}
\text{trig=item(\r,sin,cos)}

\real{u=randint(-10..10)/10}
\real{v=randint(-10..10)/10}

\real{s=\u+\v}
\real{p=\u*\v}

\integer{a=random(-1,1)*randint(1..4)}

\real{coeff=4*(\a)}
\function{pol=pari(\coeff*t^2 -(\u+(\v))*(\coeff)*t + \coeff*(\u)*(\v))}
\function{f=4*\a*(\tirg(x)-\u)*(\trig(x)-\v)}
\function{f1=maxima(expand(\f))}
\real{coeff2=2*(\a)+4*(\a)*(\p)}
\real{coeff1=4*(\s)*(\a)}
\if{\r=1}{
\function{F=maxima(-(\a)*sin(2*x)+(\coeff1)*cos(x)+(\coeff2)*x+randint(-10..10))}
}
\if{\r=2}{
\function{F=maxima(\a*sin(2*x)-(\coeff1)*sin(x)+(\coeff2)*x+randint(-10..10))}
}
\function{f2=maxima(diff(\F,x,1))}

\steps{reply 1
reply 2}


\statement{\pol1
On considère la fonction \(f) définie sur \(\R) par la relation
<div class="wimscenter">
\(f(x)=\F)
</div>
\if{\step=1}{Calculer la dérivée de la fonction \(f).
<p>
La dérivée de la fonction \(f) est définie par la relation \(f'(x)=) \embed{reply 1}.
</p>
}
\if{\step=2}{On a vu que \(f'(x)=\f2).
<p>
Déterminer un polynôme \(P) de degré 2 tel que \(f'(x)=P(\trig(x))).
</p>
<div class="wimscenter">
On a  \(P(t)=) \embed{reply 2}
</div>
<div class="wims_instruction">
Attention : \(P) est un polynôme en \(t).
</div>
}
}

\answer{der}{\f2}{type=default}
\answer{pol}{\pol}{type=default}
