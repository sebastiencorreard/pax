\title{Equations trigonométriques}
\author{Frederic, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}

\integer{r0=random(1,2)}
\text{ftrig=item(\r0,cos,sin)}

\matrix{mc=
1/6,1/4,1/3,1/2,2/3,3/4,5/6
-1/6,-1/4,-1/3,-1/2,-2/3,-3/4,-5/6
11/6,7/4,5/3,3/2,4/3,5/4,7/6
\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2}
}

\matrix{ms=
-1/3,-1/4,-1/6,0,1/6,1/4,1/3
-2/3,-3/4,-5/6,0,5/6,3/4,2/3
5/3,7/4,11/6,0,1/6,1/4,1/3
4/3,5/4,7/6,0,5/6,3/4,2/3
-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2},0,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2}
}

\if{\r0=1}{\matrix{m1=\mc}}{\matrix{m1=\ms}}

\integer{tr=randint(1..7)}
\integer{ir=randint(1,2)}
\integer{k=2*randint(-2..2)}
\matrix{int=
-1+\k,1+\k
\k,2+\k
}

\text{a=\m1[3+\r0;\tr]}


\function{i1=maxima((\int[\ir;1])*x)}
\function{i2=maxima((\int[\ir;2])*x)}
\text{i1=wims(replace x by \pi in \i1)}
\text{i2=wims(replace x by \pi in \i2)}
\if{\r0=1}{
\function{s1=maxima((\m1[1;\tr]+\k)*x)}
\function{s2=maxima((\m1[1+\ir;\tr]+\k)*x)}
}{
\if{\ir=1}{
\function{s1=maxima((\m1[1;\tr]+\k)*x)}
\function{s2=maxima((\m1[2;\tr]+\k)*x)}
}
\if{\ir=2}{
\function{s1=maxima((\m1[3;\tr]+\k)*x)}
\function{s2=maxima((\m1[4;\tr]+\k)*x)}
}

}

\if{\r0=2 and \tr=4 and \ir=1}{
\function{s1=maxima((-1+\k)*x)}
\function{s2=maxima((0+\k)*x)}
\function{s3=maxima((1+\k)*x)}
}

\if{\r0=2 and \tr=4 and \ir=2}{
\function{s1=maxima((0+\k)*x)}
\function{s2=maxima((1+\k)*x)}
\function{s3=maxima((2+\k)*x)}
}


\text{s1=wims(replace x by \pi in \s1)}
\text{s2=wims(replace x by \pi in \s2)}

\text{sn1=wims(replace \pi by pi in \s1)}
\text{sn2=wims(replace \pi by pi in \s2)}

\if{\r0=2 and \tr=4}{
\text{s3=wims(replace x by \pi in \s3)}
\text{sn3=wims(replace \pi by pi in \s3)}
\matrix{sol=\sn1,\sn2,\sn3}
}
{
\matrix{sol=\sn1,\sn2}
} tes sin=0

\statement{Résoudre l'équation
<div class="wimscenter">
\(\ftrig (x)= \a)
</div>
 dans l'intervalle
\(&#91; \i1 ; \i2 &#93;).

<div class="wimscenter">
Les solutions sont:\embed{reply 1}
</div>

<div class="wims_instruction"> Remarque:
\(\pi) doit être noté pi, s'il y a plusieurs réponses,
séparez les par une virgule. </div>
}

\answer{}{\sol}{type=fset}
\solution{Les solutions de cette équation sont \(\s1) et \(\s2)}
