!set title=Re et Im
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soient \(z = x + i*y) un nombre complexe, où \(x) et \(y) sont des réels.	  Quelles sont les parties réelle et imaginaire de 
val8=Partie réelle,Partie imaginaire
tmp0=!randint 2, 8

val9=$(tmp0)
tmp=!translate internal $	$ to ; in 	 i*z,- y, x	 -i*z, y, -x	 $val9*z,$val9*x,$val9*y	 z + i,x,y + 1	 z - i,x,y - 1	 i - z, - x,1 - y	 $val9 + z,x + $val9,y	 $val9 - z,$val9 - x, - y	 z - $val9,x - $val9,y	 $val9 + i*z,$val9 - y,x	 $val9 - i*z,$val9 + y, -x	 i*z - $val9,-y - $val9,x	 z + $val9*i,x,y + $val9	 z - $val9*i,x,y - $val9	 $val9*i - z, - x,$val9 - y	 conj(z),x, - y	 i*conj(z),y,x	 - i*conj(z), - y, - x	 $val9*conj(z),$val9*x, - $val9*y	 conj(z) + i,x, - y + 1	 conj(z) - i,x, - y - 1	 i - conj(z), - x,1 + y	 $val9 + conj(z),x + $val9, - y	 $val9 - conj(z),$val9 - x,y	 conj(z) - $val9,x - $val9,-y	 z + $val9 + i,x + $val9,y + 1	 z - $val9 + i,x - $val9,y + 1	 z - $val9 - i,x - $val9,y - 1	 z + $val9 - i,x + $val9,y - 1	 $val9 + i - z,$val9 - x,1 - y	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!item 1 of $val10

val11=!rawmath $(tmp0)
tmp0=!item 2 of $val10

val12=!rawmath $(tmp0)
tmp0=!item 3 of $val10

val13=!rawmath $(tmp0)
replytype1=formal
replyname1=$(val8[1])
replygood1=$val12
replytype2=formal
replyname2=$(val8[2])
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath $val11
$()?	<div class="wimscenter">	 Re(
!insmath $val11
$()) =  
!read oef/embed.phtml reply 1,10 
$(), Im(
!insmath $val11
$()) =  
!read oef/embed.phtml reply 2,10 
$().	</div>	
$()
!exit

