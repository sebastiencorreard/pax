\title{Inéquation avec quotient (3)}
\text{lang=slib(oef/env lang)}
\text{name_question=Résoudre algébriquement sur \(\RR\;\) l'inéquation (1)}
\text{name_with=avec}
\text{name_question2=L'inéquation (1) équivaut à l'inéquation suivante }
\text{name_enonce1=On a montré que résoudre (1) équivaut à résoudre l'inéquation (2)}
\text{name_form=forme développée,forme factorisée}
\text{name_brouillon=Faire <span class="enrouge">sur papier libre</span> l'étude des signes du quotient}
\text{name_question3=Ensuite, dans la liste suivante, cocher tous les intervalles
  dont la réunion est l'ensemble des solutions de l'inéquation (1)}
\text{name_numerateur=On peut réécrire le numérateur \(u(x)\) sous forme canonique }
\text{name_question4=Que peut-on dire du numérateur}
\matrix{name_enonce2=On constate que le numérateur,ne se factorise pas et garde un signe constant.
  On constate que le numérateur se factorise en}
/** inéquation (x-a)/(x-b)< c/(x-d) **/
\integer{c = random(-1,1)*random(2..4)}
\integer{a = random(-1,1)*random(1..4)}
\integer{b = random(-1,1)*random(1..4)}
\if{\a == \b} {\integer{b = -\b}}
\integer{d =\b + random(-1,1)*random(1..4)}
/** P = a + c + d toujours pair **/
\rational{tmp = (\a+\c+\d)/2}
\rational{tmp2 = floor((\a+\c+\d)/2)}
\if{\tmp2 != \tmp} {\integer{d = \d +1}}
\if{\d ==\b}{\integer{d = \d +2}}
/** Q = ad + bc jamais nul **/
\if{\a*\d+\b*\c == 0}{\integer{c = \c -1} }
\function{ u = x - \a}
\function{ v = x - \b}
\if{\d==0}{\function{ w = x }}{\function{ w = x - \d}}
\integer{P= - (\a +\c+\d)}
\integer{p = \P/2}
\integer{Q= \a*\d + \c*\b}
\function{ Udev = simplify(x^2 +\P*x + \Q) }
\integer{R = \Q - ((\p)^2)}
\integer{R0=abs(\R)}
\real{r = sqrt(\R0)}
\integer{floorr = floor(\r)}
\integer{po=-\p}
\if{\r == \floorr }{ \integer{u1 = \po -\r} \text{x1 = \u1}
  \integer{u2 = \po +\r} \text{x2 = \u2}
  \function{Ufact= simplify((x - \u1)(x - \u2))}
}{
  \real{u1 = \po -\r} \real{u2 = \po +\r}
  \if{\p==0}{\text{x1 = - sqrt(\R0)}}{\text{x1 = \po - sqrt(\R0)}}
  \if{\p==0}{\text{x2 = sqrt(\R0)}}{\text{x2 = \po + sqrt(\R0)}}
  \if{\p==0}{\text{Ufact= (x - sqrt(\R0) )(x + sqrt(\R0))}}
    {\text{Ufact= (x + \p - sqrt(\R0) )(x + \p + sqrt(\R0))}}
}
\integer{y1=\p+\R0}
\integer{y2=\p-\R0}
\if{\p==0}{\function{ Ucano = x^2 + \R}}{\function{ Ucano = (x + \p)^2 + \R}}
\function{V = (\v)(\w)}
\function{q = (\Udev) / (\V)}
\function{q2 = (\Ucano) / (\V)}
\text{lsymb=<,>,\leq,\geq}
\text{symb=item(1,shuffle(\lsymb))}
\text{ ineq = (\u) / (\v) \symb \c / (\w) }
/** STEP 3 : propriété de la forme canonique**/
\text{pptes = \(u(x)) ne se factorise pas et garde un signe constant, \(u(x)) ne garde pas un signe constant,
\(u(x)) se factorise en \(\Ufact) , \(u(x)) se factorise en \((x -\y1 )(x -\y2 )) }
\text{sol3=\R>0?1:2,3}
/** STEP 4 : intervalles de solutions **/
/** cas R négatif, numérateur factorisable, il y a 4 racines à ranger**/
\if{\R <0}
{
\text{rac1s= \u1,\u2,\b,\d}
\real{min = \u1}
\integer{index=1}
\for{i = 2 to 4}{
 \if{\min > \rac1s[\i]}{\real{min = \rac1s[\i]}\integer{index=\i}}
}
\if{\index==1} {\text{rac2s=item(2..4,\rac1s)}}
 { \if{\index==4} {\text{rac2s=item(1..3,\rac1s)}}
 {\text{rac2s=item(1..(\index-1),\rac1s),item((\index+1)..4,\rac1s)}}
}
\text{racines=\min}
\real{min = \rac2s[1]}
\integer{index=1}
\for{i = 2 to 3}{
 \if{\min > \rac2s[\i]}{\real{min = \rac2s[\i]}\integer{index=\i}}
}
\text{racines=\racines,\min}
\if{\index==1}{\text{rac3s=item(2..3,\rac2s)}}
 {\if{\index==3}{\text{rac3s=item(1..2,\rac2s)}}
  {\text{rac3s=\rac2s[1],\rac2s[3]}}
}
\if{\rac3s[1]>\rac3s[2]}{\text{rac3s=\rac3s[2],\rac3s[1]}}
\text{racines=\racines,\rac3s}
\text{rac1= item(1,\racines)}
\if{\rac1 == \u1}{\text{rac1= \x1}}
\if{\rac1 == \u2}{\text{rac1= \x2}}
\text{rac2= item(2,\racines)}
\if{\rac2 == \u1}{\text{rac2= \x1}}
\if{\rac2 == \u2}{\text{rac2= \x2}}
\text{rac3= item(3,\racines)}
\if{\rac3 == \u1}{\text{rac3= \x1}}
\if{\rac3 == \u2}{\text{rac3= \x2}}
\text{rac4= item(4,\racines)}
\if{\rac4 == \u1}{\text{rac4= \x1}}
\if{\rac4 == \u2}{\text{rac4= \x2}}
\text{I1of=&#93; -&#8734; &#44; \( \rac1) &#93; }
\text{I1oo= &#93; -&#8734; &#44; \( \rac1) &#91; }
\text{I2ff=&#91;\( \rac1 ) &#44; \( \rac2 ) &#93; }
\text{I2oo=&#93; \( \rac1 ) &#44; \( \rac2 ) &#91; }
\text{I2of=&#93;\( \rac1 ) &#44; \( \rac2 ) &#93; }
\text{I2fo=&#91; \( \rac1 ) &#44; \( \rac2 ) &#91; }
\text{I3ff=&#91; \( \rac2 ) &#44; \( \rac3 ) &#93; }
\text{I3oo=&#93; \( \rac2 ) &#44; \( \rac3 ) &#91; }
\text{I3of=&#93; \( \rac2 ) &#44; \( \rac3 ) &#93; }
\text{I3fo=&#91; \( \rac2 ) &#44;\( \rac3 ) &#91; }
\text{I4ff=&#91; \( \rac3 ) &#44; \( \rac4 ) &#93; }
\text{I4oo=&#93; \( \rac3 ) &#44; \( \rac4 ) &#91; }
\text{I4of=&#93; \( \rac3 ) &#44; \( \rac4 ) &#93; }
\text{I4fo=&#91; \( \rac3 ) &#44; \( \rac4 ) &#91; }
\text{I5fo=&#91; \( \rac4) &#44; +&#8734; &#91; }
\text{I5oo= &#93; \( \rac4) &#44; +&#8734; &#91; }
\text{intervalles=\I1oo,\I1of,\I2ff,\I2oo,\I2of,\I2fo,\I3ff,\I3oo,\I3of,\I3fo,\I4ff,\I4oo,\I4of,\I4fo,\I5fo,\I5oo}
\text{sol4=(\symb issametext < )?4,12}
\text{sol4=(\symb issametext \leq )?6,13}
\text{sol4=(\symb issametext > )?1,8,16}
\text{sol4=(\symb issametext \geq )?2,8,15}
}
/** Cas \R positif, numérateur signe constant**/
\if{\R >0}{
\text{racines = \b,\d}
\text{racines= wims(sort items \racines)}
\text{rac1= item(1,\racines)}
\text{rac2= item(2,\racines)}
\text{I1of=&#93; -&#8734; &#44; \rac1 &#93; }
\text{I1oo= &#93; -&#8734; &#44; \rac1 &#91; }
\text{I2ff=&#91;\rac1 &#44; \rac2 &#93; }
\text{I2oo=&#93; \rac1 &#44; \rac2 &#91; }
\text{I2of=&#93; \rac1 &#44; \rac2 &#93; }
\text{I2fo=&#91; \rac1 &#44; \rac2 &#91; }
\text{I3fo=&#91; \rac2 &#44; +&#8734; &#91; }
\text{I3oo= &#93; \rac2 &#44; +&#8734; &#91; }
\text{intervalles=\I1oo,\I1of,\I2ff,\I2oo,\I2of,\I2fo,\I3fo,\I3oo}
\text{sol4=(\symb issametext < )?4}
\text{sol4=(\symb issametext \leq )?4}
\text{sol4=(\symb issametext > )?1,8}
\text{sol4=(\symb issametext \geq )?1,8}
}
