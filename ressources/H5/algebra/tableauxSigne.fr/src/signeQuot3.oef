\title{Signe d'une expression a + u(x)/v(x)}

\text{lang=slib(oef/env lang)}


\text{name_error=Erreur}
\text{name_feed0=Vous avez marqué YYYY comme valeur interdite du quotient \(f(x)\).
  Rappelons qu'une valeur interdite est un nombre qui annule le <strong>dénominateur</strong>
du quotient. Or ici YYYY annule le <strong>numérateur</strong> de \(f(x)\).}
\matrix{name_feed1=On réécrit, sous forme d'un quotient pour en étudier le signe
 Vous avez mal ordonné les valeurs dans la première ligne du tableau.}
\text{name_feed2=Vous avez fait une erreur sur la valeur interdite VVVV :
  toute valeur qui annule le dénominateur de \(f(x)\)
  est une "valeur interdite" ; dans la ligne du quotient
  on la signale par une double-barre.}
\text{name_feed3=Vous avez marqué XXXX comme valeur interdite du quotient \(f(x)\).
  Rappelons qu'une valeur interdite est un nombre qui annule le
  <strong>dénominateur</strong> du quotient. Or ici XXXX annule
  le <strong>numérateur</strong> de \(f(x)\).}
\text{name_feed4=Vous avez marqué YYYY comme valeur interdite du quotient \(f(x)\).
  Rappelons qu'une valeur interdite est un nombre qui annule le
  <strong>dénominateur</strong> du quotient. Or ici YYYY annule le
  <strong>numérateur</strong> de \(f(x)\).}

\text{name_enonce=Étudier en fonction de \(x\) le signe de l'expression,
  Compléter le tableau ci-dessous}
\text{name_hint=Commencer par écrire , en un seul quotient de dénominateur}

/** même type d'exercice que src/signeProdQuotient.oef sans notion de fonction **/
/** variante de Chantal Causse : expression de la forme a + u(x)/v(x) **/
\integer{a = (-1)^random(0,1)*random(1..10)}
\integer{b = (-1)^random(0,1)*random(1..10)}
\integer{c = (-1)^random(0,1)*random(1..10)}
\integer{d = (-1)^random(0,1)*random(1..5)*\c/gcd(\a,\c)}
\rational{racu=-(\b)/(\a)}
/** Faire en sorte que les racines soient distinctes **/
\integer{d=(-(\d)/(\c)=\racu)?-\d}
\rational{racv=-(\d)/(\c)}
\function{u=\a*x + \b}
\function{u=\a==1?x + \b}
\function{u=\a==-1?-x + \b}
\function{v=\c*x + \d}
\function{v=\c==1?x + \d}
\function{v=\c==-1?-x + \d}
/**quotient **/
\function{f=pari((\u)/(\v))}
\function{u = pari(numerator(\f))}
\function{v = pari(denominator(\f))}
\rational{vi=\racv}
/**décomposition en éléments simples de f**/
\rational{ent = (\a)/(\c)}
\function{ff = pari((\f)- (\ent))}
/** placer le terme ayant la plus petite racine en premier **/
/** rgerac = 1 : u avant v ; rgerac = 2 : v avant u **/
\integer{rgerac=\racu<\racv?1:2}
/** ordonner les racines ; preparer les tests de signe **/
\rational{x1=\rgerac==1?\racu:\racv}
\rational{x2=\rgerac==1?\racv:\racu}
\rational{ug = evaluate(\u,x=\x1-1)}
\rational{um = evaluate(\u,x=(\x1+\x2)/2)}
\rational{ud = evaluate(\u,x=\x2+1)}
\rational{vg = evaluate(\v,x=\x1-1)}
\rational{vm = evaluate(\v,x=(\x1+\x2)/2)}
\rational{vd = evaluate(\v,x=\x2+1)}
/** choix pour les barres et signes **/
\text{ch3=+,-}
\text{ch4=0,||,|}
\text{ch5=+,-}
\text{ch6=0,||,|}
\text{ch7=+,-}
\text{ch8=+,-}
\text{ch9=0,||,|}
\text{ch10=+,-}
\text{ch11=0,||,|}
\text{ch12=+,-}
\text{ch13=+,-}
\text{ch14=0,||,|}
\text{ch15=+,-}
\text{ch16=0,||,|}
\text{ch17=+,-}
/** bonnes réponses **/
\rational{rep1=\x1}
\rational{rep2=\x2}
\text{rep3=\ug>0?1:2}
\text{rep4=\x1==\racu?1:3}
\text{rep5=\um>0?1:2}
\text{rep6=\x2==\racu?1:3}
\text{rep7=\ud>0?1:2}
\text{rep8=\vg>0?1:2}
\text{rep9=\x1==\racv?1:3}
\text{rep10=\vm>0?1:2}
\text{rep11=\x2==\racv?1:3}
\text{rep12=\vd>0?1:2}
\text{rep13=\rep3*\rep8==2?2:1}
\text{rep14= \x1==\vi?2:1}
\text{rep15=\rep5*\rep10==2?2:1}
\text{rep16= \x2==\vi?2:1}
\text{rep17=\rep7*\rep12==2?2:1}
\text{rep18= \u}
\text{feed0=wims(replace internal YYYY by \x2 in \name_feed4)}
\text{feed2=wims(replace internal VVVV by \vi in \name_feed2)}
\text{feed3=wims(replace internal XXXX by \x1 in \name_feed3)}
\text{feed4=wims(replace internal YYYY by \x2 in \name_feed4)}
