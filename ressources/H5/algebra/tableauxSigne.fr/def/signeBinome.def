!set title=Signe d'un binôme \(ax+b)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Complétez le tableau de signes du binôme du premier degré
val8=Le binôme du premier degré \(a x + b\) s'annule en \(-\frac{b}{a}\)	  et change de signe en \(-\frac{b}{a}\).	  Il est du signe du coefficient \(a\) lorsque \(x > -\frac{b}{a}\).
tmp0=!randitem 0,1

tmp1=!randint 1, 4

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
t_=!rawmath -$val10/$val9
val11=!exec pari print($t_)
val12=!rawmath $val9 *x + $val10

!ifval $val9==1
val12=!rawmath x + $val10
!endif

!ifval $val9==-1
val12=!rawmath -x + $val10
!endif
t_=!rawmath -$val10/$val9
val13=!exec pari print($t_)
val14=-,+
val15=-,+
val16=0,||,|

!ifval $val9>0
val17=1
!else
val17=2
!endif

!ifval $val9>0
val18=2
!else
val18=1
!endif
val19=1
replytype1=numexp
replyname1=
replygood1=$val13
replytype2=menu
replyname2=
replygood2=$val17 ; $val14
replytype3=menu
replyname3=
replygood3=$val19 ; $val16
replytype4=menu
replyname4=
replygood4=$val18 ; $val15
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  <div class="enbleu">$val8</div> 


!goto stat

!exit

:question
$()	<div class="wims_question">	<p>$val7 
!insmath $val12
$().</p>	<div class="center">	<table class="wimsborder" style="width:70%">	<tr>	<td style="width:15%;text-align:center">
!insmath x
$()</td><td style="width:30%;text-align:left">	
!insmath -\infty
$()</td><td style="width:5%;text-align:center"> 
!read oef/embed.phtml reply1,5 
$()</td>	<td style="width:30%;text-align:right">
!insmath +\infty
$()</td>	</tr>	<tr>	<td style="width:15%;text-align:center">
!insmath $val12
$()</td><td style="width:30%;text-align:center">	 
!read oef/embed.phtml reply2 
$()</td><td style="width:5%;text-align:center"> 
!read oef/embed.phtml reply3 
$()</td><td style="width:30%;text-align:center"> 
!read oef/embed.phtml reply4 
$()</td>	</tr>	</table>	</div>	</div>	
$()
!exit

:hint
$() <div class="enbleu">$val8</div> 
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,12
embedcnt=4
