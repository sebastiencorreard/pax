val7=L'expression XXXX a un signe évident quel que soit le réel \(x\),	  est toujours
val8=strictement négative,négative ou nulle,	  strictement positive,positive ou nulle
tmp=!trim On a, pour tout réel	  donc, est toujours du signe de,et ne s'annule jamais.	  est toujours positif ou nul si	  ou nul en	  Le nombre,est strictement positif,donc la somme,est strictement positive	  est toujours négatif ou nul	  est strictement négatif et on peut écrire	  est strictement négatif
val9=!translate internal $	\
$ to ;; in $tmp
val10=Or
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val11=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val13=$[rint((-1)^$(tmp0)*$(tmp1))]

!ifval $val13<0
val14=$[rint(1)]
!else
val14=$[rint(3)]
!endif

!ifval $val13<0
val15=$[rint(2)]
!else
val15=$[rint(4)]
!endif
tmp0=!randint 1, 10

val16=$[rint($(tmp0))]
tmp0=!randint 1, 10

val17=$[rint($(tmp0))]
tmp0=!randitem 2,4

val18=$[rint($(tmp0))]
t_=!rawmath -$val12/$val11
val19=!exec pari print($t_)
val20=!rawmath $val11 *x + $val12

!ifval $val11==1
val20=!rawmath x + $val12
!endif

!ifval $val11==-1
val20=!rawmath -x + $val12
!endif
val21=$val13,$val13($val20)^$val18,$val16($val20)^$val18 + $val17,-$val16($val20)^$val18 - $val17
tmp0=!randint 1, 4

val22=$[rint($(tmp0))]
tmp0=!item $val22 of $val21

val23=$(tmp0)
val24=$(val8[1])
val25=$(val8[2])
val26=$(val8[3])
val27=$(val8[4])
val28=$val24,$val25,$val26,$val27
val29=$val14,$val15,3,1
tmp0=!item $val22 of $val29

val30=$(tmp0)
tmp0=!replace internal XXXX by \(f(x) = $val23\) in $val7

val31=$(tmp0)
replytype1=menu
replyname1=
replygood1=$val30 ; $val28
question=__EXECUTED_1692754_EXERCISE__

