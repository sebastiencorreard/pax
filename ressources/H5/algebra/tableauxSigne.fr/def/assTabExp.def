!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=aucune
val8=De quelle(s) expression(s) le tableau suivant	  est-il le tableau de signes&nbsp;
val9=Il peut y avoir plusieurs réponses ou aucune.
val10=Le binôme \(a x +b\) s'annule en \(-\frac{b}{a}\)	  et change de signe en \(-\frac{b}{a}\).	  Il est du signe de \(a\) lorsque \(x > -\frac{b}{a}\).
val11=Si une double barre est présente sous une valeur \(x_0\),	  cela indique que \(f\) n'est pas définie en \(x_0\).	  Dans ce cas, \(f\) est un quotient dont le dénominateur s'annule en \(x_0\).
tmp0=!randitem 0,1

tmp1=!randint 1, 4

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val13=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 2, 10

val14=$[rint((-1)^$(tmp0)*$(tmp1))]
t_=!rawmath -$val13/$val12
val15=!exec pari print($t_)
val16=!rawmath $val12 *x + $val13

!ifval $val12==1
val16=!rawmath x + $val13
!endif

!ifval $val12==-1
val16=!rawmath -x + $val13
!endif
val17=!rawmath $val14/($val16)
val18=!rawmath 1/($val16)
val19=!rawmath $val14/($val16)^2

!ifval $val12>0
val20=+
!else
val20=-
!endif

!ifval $val12>0
val21=-
!else
val21=+
!endif
t_=!rawmath -$val13/$val12
val15=!exec pari print($t_)
tmp0=!randitem -,+

val22=$(tmp0)
tmp0=!randitem -,+

val23=$(tmp0)
tmp0=!randitem 0,||

val24=$(tmp0)
val25=$val22,$val24,$val23
val26=\($val16),\($val14($val16)),\(($val16)^2), \($val14($val16)^2), \($val18) , \($val17) ,	\($val19) , $val7

!ifval ($val25 issametext $val21,0,$val20) and $val14>0
val27=1,2
!endif

!ifval ($val25 issametext $val21,0,$val20) and $val14<0
val27=1
!endif

!ifval ($val25 issametext $val20,0,$val21) and $val14>0
val27=8
!endif

!ifval ($val25 issametext $val20,0,$val21) and $val14<0
val27=2
!endif

!ifval ($val25 issametext $val21,||,$val20) and $val14>0
val27=5,6
!endif

!ifval ($val25 issametext $val21,||,$val20) and $val14<0
val27=5
!endif

!ifval ($val25 issametext $val20,||,$val21) and $val14>0
val27=8
!endif

!ifval ($val25 issametext $val20,||,$val21) and $val14<0
val27=6
!endif

!ifval ($val25 issametext +,||,+) and $val14<0
val27=8
!endif

!ifval ($val25 issametext -,||,-) and $val14<0
val27=7
!endif

!ifval ($val25 issametext +,||,+) and $val14>0
val27=7
!endif

!ifval ($val25 issametext -,||,-) and $val14>0
val27=8
!endif

!ifval ($val25 issametext +,0,+) and $val14>0
val27=3,4
!endif

!ifval ($val25 issametext +,0,+) and $val14<0
val27=3
!endif

!ifval ($val25 issametext -,0,-) and $val14>0
val27=8
!endif

!ifval ($val25 issametext -,0,-) and $val14<0
val27=4
!endif
replytype1=checkbox
