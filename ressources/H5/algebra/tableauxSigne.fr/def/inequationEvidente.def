tmp0=!randitem 2,4

val21=$[rint($(tmp0))]
t_=!rawmath -$val15/$val14
val22=!exec pari print($t_)
val23=!rawmath $val14*x + $val15

!ifval $val14==1
val23=!rawmath x + $val15
!endif

!ifval $val14==-1
val23=!rawmath -x + $val15
!endif
val24=$val16*($val23)^$val21,$val19*($val23)^$val21 + $val20,-$val19*($val23)^$val21 - $val20
tmp0=!randint 1, 3

val25=$[rint($(tmp0))]
tmp0=!item $val25 of $val24

val26=$(tmp0)
tmp0=!texmath $val26

val26=$(tmp0)
tmp0=!texmath $val23

val23=$(tmp0)
val27=\(\RR\; )
val28=\(\emptyset\; )
val29=$val27,$val28
val30=$val18,3,1
