\title{Puissances d'une matrice}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{n=randint(2..3)}

\if{\n=3}{\text{p=2}}{
\text{p=randint(2..3)}
}

\text{N=randitem(A,B,C,D,M,P)}

\integer{i=randint(1..\n)}
\integer{j=randint(1..\n)}

\text{M=slib(matrix/random \n,\n,5)}
\text{C=pari([\M]^\p)}

\if{\n=2}{\text{etape=r1,r2,r3,r4}}{\text{etape=r1,r2,r3,r4,r5,r6,r7,r8,r9}}
\nextstep{\etape}

\statement{
<div id="enonce">
Soit \(\N=[\M]), alors \(\N^\p) = 


\if{\etape issametext r1,r2,r3,r4 }{
<div class="reponse">
<table>
<tr>
<td>\embed{r1,5}</td><td>\embed{r2,5}</td>
</tr>
<tr>
<td>\embed{r3,5}</td><td>\embed{r4,5}</td>
</tr>
</table>
</div>
}


\if{\etape issametext r1,r2,r3,r4,r5,r6,r7,r8,r9 }{
<div class="reponse">
<table class="matrice">
<tr>
<td>\embed{r1,5}</td><td>\embed{r2,5}</td><td>\embed{r5,5}</td>
</tr>
<tr>
<td>\embed{r3,5}</td><td>\embed{r4,5}</td><td>\embed{r6,5}</td>
</tr>
<tr>
<td>\embed{r7,5}</td><td>\embed{r8,5}</td><td>\embed{r9,5}</td>
</tr>
</table>
</div>
}

</div>

}

\answer{}{\C[1;1]}{type=numeric}
\answer{}{\C[1;2]}{type=numeric}
\answer{}{\C[2;1]}{type=numeric}
\answer{}{\C[2;2]}{type=numeric}
\answer{}{\C[1;3]}{type=numeric}
\answer{}{\C[2;3]}{type=numeric}
\answer{}{\C[3;1]}{type=numeric}
\answer{}{\C[3;2]}{type=numeric}
\answer{}{\C[3;3]}{type=numeric}
