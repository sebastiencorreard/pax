\title{Produit de matrices}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{n=randint(2..3)}
\integer{p1=randint(2..3)}
\integer{p2=randint(2..3)}
\integer{q=randint(2..3)}
\text{i=randint(1..\n)}
\text{j=randint(1..\q)}

\text{A=slib(matrix/random \n,\p1,5)}
\text{B=slib(matrix/random \p2,\q,5)}

\if{\p1=\p2}{\text{C=pari([\A]*[\B])}}

\text{rep1=\p1=\p2?1:2}
\text{c=\C[\i;\j]}
\text{etape=r1}
\nextstep{\etape}

\statement{
<div id="enonce">
On considère les matrices A=\([\A]) et B=\([\B])<br>
</div>

\if{\etape issametext r1}{
<div class="question">
Le produit A\(\times)B est-il possible ?
<div class="reponse">
\embed{r1}
</div>
</div>
}


\if{\etape issametext r2,r3}{
<div class="question">
Quel est le format du produit A\(\times)B ?
<div class="reponse">
(\embed{r2,5};\embed{r3,5})
</div>
</div>
}

\if{\etape issametext r4}{
<div class="question">
Soit C=A\(\times) B. Que vaut le coefficient \(c\i\j) ?
<div class="reponse">
\(c\i\j)=\embed{r4}
</div>
</div>
}

}

\answer{calcul possible}{\rep1;oui,non}{type=radio}
\answer{format}{\n}{type=numeric}
\answer{format}{\q}{type=numeric}
\answer{}{\c}{type=numeric}

\if{\sc_reply1=1 and \rep1=1}{\text{etape=r2,r3}}
\if{(\sc_reply1=1 and \rep1=2) or (\sc_reply1=0)}{\text{etape=}}
\if{\sc_reply2=1 and \sc_reply3=1}{\text{etape=r4}}
\if{\sc_reply2=0 or \sc_reply3=0}{\text{etape=}}
\if{\step>3}{\text{etape=}}
