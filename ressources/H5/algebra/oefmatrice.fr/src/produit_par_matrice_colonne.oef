\title{Produit par une matrice colonne}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{n=randint(2..3)}
\integer{p=randint(2..3)}

\text{i=randint(1..\n)}
\text{j=randint(1..\p)}

\text{A=slib(matrix/random \n,\p,5)}
\text{B=slib(matrix/random \p,1,5)}
\text{A=slib(text/matrixinsert [\A],\i,\j,a)}
\text{C=pari([\A]*[\B])}
\text{rep=\C[\i;1]}
\text{u=1}
\text{c=c\i\u}
\text{C=slib(text/matrixinsert [\C],\i,1,\c)}

\statement{
<div id="enonce">
Exprimer le coefficient \(\c)  en fonction de \(a)  dans le calcul suivant : <br>
\([\A])\(\times)\([\B])=\([\C])

<div class="reponse">
\(\c)=\embed{r1,10}
</div>

</div>
}

\answer{coefficient}{\rep}{type=algexp}
