\title{Lecture des coefficients d'une matrice}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{n=randint(2..4)}
\integer{p=randint(2..4)}

\text{listeL=shuffle(\n)}
\integer{i1=\listeL[1]}
\integer{i2=\listeL[2]}

\text{listeC=shuffle(\p)}
\integer{j1=\listeC[1]}
\integer{j2=\listeC[2]}

\text{maj=A,B,C,D,M,P}
\text{minu=a,b,c,d,m,p}
\integer{k=randint(1..6)}
\text{A=\maj[\k]}
\text{a=\minu[\k]}

\text{M=slib(matrix/random \n,\p,5)}
\real{somme=\M[\i1;\j1]+\M[\i2;\j2]}

\statement{
<div id="enonce">
On considère la matrice \A=\([\M]) et on note \(\a _ij) ses coefficients. Calculer \(\a\i1\j1 + \a\i2\j2).<br>
<div class="reponse">
\(\a\i1\j1 + \a\i2\j2)=\embed{r1,5}
</div>
</div>
}

\answer{somme = }{\somme}{type=numeric}
