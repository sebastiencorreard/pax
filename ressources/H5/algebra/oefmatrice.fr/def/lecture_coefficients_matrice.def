!set title=Lecture des coefficients d'une matrice
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 4

val6=$[rint($(tmp0))]
tmp0=!randint 2, 4

val7=$[rint($(tmp0))]
tmp0=!shuffle $val6

val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
tmp0=!shuffle $val7

val11=$(tmp0)
val12=$[rint($(val11[1]))]
val13=$[rint($(val11[2]))]
val14=A,B,C,D,M,P
val15=a,b,c,d,m,p
tmp0=!randint 1, 6

val16=$[rint($(tmp0))]
val17=$(val14[$val16])
val18=$(val15[$val16])
!readproc slib/matrix/random $val6,$val7,5 
tmp0=$slib_out
val19=$(tmp0)
val20=$[$(val19[$val9;$val12])+$(val19[$val10;$val13])]
replytype1=numeric
replyname1=somme 
replygood1=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	On considère la matrice $val17=
!insmath [$val19]
$() et on note 
!insmath $val18 _ij
$() ses coefficients. Calculer 
!insmath $val18$val9$val12 + $val18$val10$val13
$().<br>	<div class="reponse">	
!insmath $val18$val9$val12 + $val18$val10$val13
$()= 
!read oef/embed.phtml r1,5 
$()	</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,12,13,17,18,19
embedcnt=1
