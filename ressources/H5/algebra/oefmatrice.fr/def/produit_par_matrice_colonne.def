!set title=Produit par une matrice colonne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 3

val6=$[rint($(tmp0))]
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, $val6

val8=$(tmp0)
tmp0=!randint 1, $val7

val9=$(tmp0)
!readproc slib/matrix/random $val6,$val7,5 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/matrix/random $val7,1,5 
tmp0=$slib_out
val11=$(tmp0)
!readproc slib/text/matrixinsert [$val10],$val8,$val9,a 
tmp0=$slib_out
val10=$(tmp0)
t_=!replace internal \( by ( in [$val10]*[$val11]
tmp0=!exec pari $t_

val12=$(tmp0)
val13=$(val12[$val8;1])
val14=1
val15=c$val8$val14
!readproc slib/text/matrixinsert [$val12],$val8,1,$val15 
tmp0=$slib_out
val12=$(tmp0)
replytype1=algexp
replyname1=coefficient
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	Exprimer le coefficient 
!insmath $val15
$()  en fonction de 
!insmath a
$()  dans le calcul suivant : <br>	
!insmath [$val10]
$()
!insmath \times
$()
!insmath [$val11]
$()=
!insmath [$val12]
$()		<div class="reponse">	
!insmath $val15
$()= 
!read oef/embed.phtml r1,10 
$()	</div>		</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,15
embedcnt=1
