 \arg(-\c1) = random(\ai,\aj) \mod
 \arg(\i1) = random(\aj,\aj,\pi/4,-\pi/4,\a1) \mod
 \arg(-\i1) = random(\ai,\ai,-pi/4,pi/4,\a1) \mod
 \arg(|\z1|) = |\arg(\z1)| \mod
 \arg(\z1^2) = \arg(\z1)^2 \mod
 \arg(i\z1) = \arg(\z1) random(- \frac{\pi}{2}, + \frac{3\pi}{2}, + \frac{\pi}{4}, - \frac{\pi}{4}, +\frac{3\pi}{4}, -\frac{3\pi}{4}, +\pi, -\pi) \mod
 \arg(\z1/i) = \arg(\z1) random(+ \frac{\pi}{2}, - \frac{3\pi}{2}, + \frac{\pi}{4}, - \frac{\pi}{4}, +\frac{3\pi}{4}, -\frac{3\pi}{4}, +\pi, -\pi) \mod
 \arg(\ri\z1) = \ri \arg(\z1) \mod
 \arg(-\ri\z1) = - \arg(\z1) \mod
