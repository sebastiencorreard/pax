}
\integer{nb=rows(\bad)}
liste des bonnes réponses
\integer{q=randint(1..3)}
\text{qg=item(1 .. \q, shuffle(\ng))}
\text{question=\(\good[\qg[1];1]\)}
\text{ans=1}
\if{\q > 1}{
  \for{p=2 to \q}{
   \text{question=\question,\(\good[\qg[\p];1]\)}
   \text{ans=\ans,\p}
 }
}
