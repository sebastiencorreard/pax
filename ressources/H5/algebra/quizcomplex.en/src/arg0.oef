\text{pm=random(+,-) }
\text{mod=\mod 2\pi}
\matrix{good= \arg(\z1 \; \z2) = \arg(\z1) + \arg(\z2) \mod
\arg\left(\frac{\z1}{\z2}\right) = \arg(\z1) - \arg(\z2) \mod
\arg(1/\z1) = -\arg(\z1) \mod
\arg(\overline{\z1}) = -\arg(\z1) \mod
\arg(\overline{\z1}) = \arg(\frac{1}{\z1}) \mod
\arg(\c1) = \a0 \mod
\arg(- \c1) = \a1 \mod
\arg(\i1) = \ai \mod
\arg(- \i1) = \aj \mod
