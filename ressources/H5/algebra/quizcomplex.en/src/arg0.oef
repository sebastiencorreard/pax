\arg(\z1^2) = 2\arg(\z1) \mod
\arg(- \z1) = \arg(\z1) \pm\pi \mod
\arg(i\z1) = \arg(\z1) random(+ \frac{\pi}{2}, - \frac{3\pi}{2}) \mod
\arg(\frac{\z1}{i}) = \arg(\z1) random(- \frac{\pi}{2}, + \frac{3\pi}{2}) \mod
\arg(\ri \z1) = \arg(\z1) \mod
\arg(-\ri \z1) = \arg(\z1) \pm\pi \mod
}
\integer{ng=rows(\good)}
\matrix{bad=
 \arg(0) = 0 \mod
 \arg(\z1 \z2) = \arg(\z1) \times \arg(\z2) \mod
 \arg(\z1/\z2) = \arg(\z1) / \arg(\z2) \mod
 \arg(1/\z1) = 1/\arg(\z1) \mod
 \arg(\z1+\z2) = \arg(\z1) + \arg(\z2) \mod
 \arg(\z1-\z2) = \arg(\z1) - \arg(\z2) \mod
 \arg(-\z1) = -\arg(\z1) \mod
 \arg(\overline{\z1}) = \overline{\arg(\z1)} \mod
 \arg(\c1) = \a0
