!set title=Given argument
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000
title_fr=Argument donné
title_nl=Argument III

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Compute the real part and imaginary part of the complex number \(z\) having	  and having	  as an argument
val7=!translate internal $	\
$ to ;; in $tmp
!if $val6=fr 
tmp=!trim Calculer la partie réelle et la partie imaginaire du nombre complexe \(z\) ayant	  comme module et ayant	  comme un argument
val7=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val6=nl 
tmp=!trim Bereken het reële en imaginaire gedeelte van het complexe getal	  met en	  als argument
val7=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!randint 1, 100

val8=$[$(tmp0)/10]
tmp0=!randint 1, 100

tmp1=!randitem -1,1

val9=$[$(tmp0)/10*$(tmp1)]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]

!ifval $val10=1
val11=$[$val9]
!else
val11=$[$val9*pi]
!endif

!ifval $val10=1
val12=$val9
!else
val12=$val9 \pi
!endif
val13=$[cos($val11)*$val8]
val14=$[sin($val11)*$val8]
replyname1=\(Re(z)\)
replygood1=$val13
replyname2=\(Im(z)\)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1;]) $val8 $(val7[2;]) \($val12\) $(val7[3;]). \begin{itemize} \item \(Re(z)\) = \item \(Im(z)\) = \end{itemize} \end{statement} \begin{solution} \(Re(z)= $val13 \), \(Im(z)= $val14 \). \end{solution} 


!goto stat

!exit

:question
$()$(val7[1;]) $val8 $(val7[2;]) 
!insmath $val12
$() $(val7[3;]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1;]) $val8 $(val7[2;]) 
!insmath $val12
$() $(val7[3;]). $m_begin{itemize} $m_item 
!insmath Re(z)
$() = $m_item 
!insmath Im(z)
$() = $m_end{itemize} $m_end{statement} $m_begin{solution} 
!insmath Re(z)= $val13 
$(), 
!insmath Im(z)= $val14 
$(). $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,12,13,14
embedcnt=0
