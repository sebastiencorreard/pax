!set title=Somme de proportions 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9-$val6

val7=$[rint($(tmp0)*10)]
val6=$[rint(10*$val6)]
val8=$[rint(($val6+$val7)/2)]
val9=$[rint($val6+$val7)]
val10=$[rint($val6*$val7/100)]
tmp0=!shuffle $val8 %,$val9 %, $val10 %

val11=$(tmp0),on ne peut pas savoir
tmp0=!positionof item $val8 % in $val11

val12=$[rint($(tmp0))]

!ifval $val6=$val7
val13=$[rint($val12)]
!else
val13=$[rint(4)]
!endif
val14=Soit respectivement \(N_1\) et \(N_2\) le nombre de filles et de garçons dans le groupe.<br>	  Le nombre de sportifs est \(N_1 \times \frac{$val6}{100} + N_2 \times \frac{$val7}{100}).<br>	  La proportion de sportifs est donc&nbsp;: <span class="nowrap">\(\frac{N_1 \times \frac{$val6}{100} + N_2 \times \frac{$val7}{100}}{N_1+N_2}\)</span>

!ifval $val6=$val7
val14=$val14 c'est à dire \(\frac{(N_1+N_2) \times \frac{$val6}{100}}{N_1+N_2}\) 	soit encore <span class="nowrap">\(\frac{$val6}{100}\).</span><br> Cette proportion ne dépend ni du nombre de filles ni du nombre de garçons dans le groupe. 
!else
val14=$val14<br> Cette proportion dépend du nombre de filles et du nombre de garçons dans le groupe, on ne peut donc pas savoir&nbsp;!
!endif
val15=Le pourcentage d'élèves de ce groupe pratiquant un sport est&nbsp;:
replytype1=radio
replyname1=
replygood1=$val13;$val11
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val14


!goto stat

!exit

:question
$()	<p>	  Dans un groupe d'élèves, $val6&nbsp;% des filles et $val7&nbsp;% des garçons font du sport.	</p>		<p>$val15</p>	<div class="wimscenter">  
!read oef/embed.phtml reply1 
$() </div>					
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val14
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,14,15
embedcnt=1
