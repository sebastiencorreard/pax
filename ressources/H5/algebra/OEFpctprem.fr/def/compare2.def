$()	<div class="table-scroll">	<table class="wimscenter wimsborder">	<tr><th>&nbsp;</th><th>1L</th><th>1S</th><th>1ES</th><th>1STMG</th></tr>	<tr><th>Garçons</th>	   
!for m_l1=1 to 4 
$()<td>$(val12[$m_l1])</td> 
