val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=1L,1S,1ES,1STMG
tmp0=!makelist x for x=40 to 70

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=$(val7[1]),$(val7[2]),$(val7[3]),$(val7[4])
val9=40,45,50,55,60,65,70,75,80
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$(val9[1]),$(val9[2]),$(val9[3]),$(val9[4])
val11=
val12=
val13=
val14=
val15=
val16=
val17=
!for val18 =1 to 4 
val19=$[rint($(val8[$val18])*100/$(val10[$val18]))]
val20=$[rint($val19 - $(val8[$val18]))]
val21=$[$(val8[$val18])/$val19]
t_=!replace internal \( by ( in round($val21*1000)/10
tmp0=!exec pari $t_

val22=$[$(tmp0)]
t_=!replace internal \( by ( in $val22==$val21*100
tmp0=!exec pari $t_

val23=$(tmp0)

!ifval $val23=1
val24==
!else
val24=\simeq
!endif
val25=$[rint($val21*1000)]
val25=$[$val25/10]
tmp0=!append item $val21 to $val14

val14=$(tmp0)
tmp0=!append item $val22 to $val17

val17=$(tmp0)
tmp0=!append item $val24 to $val15

val15=$(tmp0)
tmp0=!append item $val25 to $val16

val16=$(tmp0)
tmp0=!append item $val23 to $val13

val13=$(tmp0)
tmp0=!append item $val19 to $val11

val11=$(tmp0)
tmp0=!append item $val20 to $val12

val12=$(tmp0)
!next
tmp0=!sort item $val10

val26=$(tmp0)
tmp0=!positionof item $(val26[4]) in $val10

val27=$[rint($(tmp0))]
val28=$[rint(($(val8[$val27])/ $(val11[$val27]))*1000)]
val28=$[$val28/10]
replytype1=radio
replyname1=
replygood1=$val27;1L,1S,1ES,1STMG
replytype2=numeric
replyname2=
replygood2=$[$val28]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

