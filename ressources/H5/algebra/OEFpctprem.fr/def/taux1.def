!set title=Taux d'évolution 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=18
prevarcnt=15
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=augmente,baisse
val7=hausse,baisse
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
tmp0=!randint 1000, 3000

val9=$[rint($(tmp0))]
tmp0=!randint 10, 90

val10=$[rint($(tmp0))]

!ifval $val8=1
t_=!rawmath 1+$val10/100
val11=!exec pari print($t_)
!else
t_=!rawmath 1-$val10/100
val11=!exec pari print($t_)
!endif

!ifval $val8=1
val12=1+\frac{$val10}{100}
!else
val12=1-\frac{$val10}{100}
!endif
t_=!rawmath $val9*$val11
val13=!exec pari print($t_)
val14=$[$val13]
val15=$[round(10*$val13)/10]
val16=$[rint(round($val13))]
!readproc slib/numeration/ecriturenombre $val9,tex 
tmp0=$slib_out
val17=$(tmp0)
!readproc slib/numeration/ecriturenombre $val14,comma tex 
tmp0=$slib_out
val18=$(tmp0)
!readproc slib/numeration/ecriturenombre $val15,comma tex 
tmp0=$slib_out
val19=$(tmp0)
val20=On peut multiplier la valeur initale \($val17\) par le coefficient multiplicateur \($val12\)	  qui correspond à la $(val7[$val8]) de <span class="nowrap">\($val10\) %.</span>	  <br>	  Le nouveau prix est \($val9 \times \left($val12\right)\) ce qui donne \($val18\) euros.
replytype1=numeric
replyname1=Réponse :
replygood1=?analyze 21
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val20


!goto stat

!exit

:question
$()	<p>	    Un bien coûte 
!insmath $val17
$() euros.<br>	    Il $(val6[$val8]) de <span class="nowrap">
!insmath $val10
$() %.</span>	  </p><p>	    <label for="reply1">Quel est son nouveau prix ?</label>	  </p>	  <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()euros</div>	  <div class="wims_instruction"> Donner la valeur exacte.</div>	  
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val20
$()
!exit

:latex
$()
$()
!exit

:postdef
val22=$[abs($val21-$val13)]

!ifval $val22<=1 and $val22<>0 
val23= 1
!else
val23=0
!endif

!exit

:feedback
!ifval $val23=1
 <div class='oef_feedbacks'>Vous avez sans doute effectué le bon calcul	    mais c'est la valeur exacte qui est demandée.
$()</div>
!endif

!exit

:test
condweight1=19 

!ifval $val22<=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=Le raisonnement semble correct&nbsp;
condweight2=1 

!ifval $val22=0
 condtest2=1
!else
 condtest2=0
!endif
condname2=Valeur exacte donnée&nbsp;

!exit

:stat
vsavelist=6,8,10,13,17,20,21
embedcnt=1
