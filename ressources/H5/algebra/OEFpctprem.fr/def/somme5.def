!set title=Somme de proportions 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9-$val6

val7=$[rint($(tmp0)*10)]
val6=$[rint(10*$val6)]
tmp=!nonempty items 4,5,8,10,16,20,25

tmp0=!randitem $tmp
val8=$[rint(10*$(tmp0))]
tmp0=!randint 3, 5

val9=$[rint(min($(tmp0)*10,$val8-10))]
val10=$[rint($val8-$val9)]
val11=$[($val6*$val9+$val7*$val10)/100]
val12=$[($val6*$val9+$val7*$val10)/$val8]
val13=Le nombre de sportifs est <span class="nowrap">\($val9 \times \frac{$val6}{100} + $val10 \times \frac{$val7}{100}=$val11\).</span><br>	  La proportion de sportifs est donc&nbsp;: \(\frac{$val11}{$val9+$val10}=\frac{$val11}{$val8}\) soit <span class="nowrap">\($val12\) %.</span>
val14=Sachant qu'il y a $val9 filles et $val10 garçons,	  quelle est la proportion, en pourcentage, d'élèves de ce groupe pratiquant un sport&nbsp;?
replytype1=numexp
replyoption1=noreduction 
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val13


!goto stat

!exit

:question
$()	<p>	  Dans un groupe d'élèves, $val6&nbsp;% des filles et $val7&nbsp;% des garçons font du sport.	</p>					<p><label for="reply1">$val14</label></p>	<div class="wimscenter nowrap">  
!read oef/embed.phtml reply1 
$() %</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val13
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,13,14
embedcnt=1
