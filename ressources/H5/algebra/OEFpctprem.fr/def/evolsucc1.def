!set title=Évolutions successives 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Fabien, Sommier
email=regine@mangeard.fr,fabien.sommier@gmail.com
precision=100

ansorder=r
varcnt=36
prevarcnt=33
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=augmente,baisse
val7=augmenter,baisser
val8=hausse,baisse
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randint 1000, 3000

val10=$[rint($(tmp0))]
tmp0=!randint 10, 90

val11=$[rint($(tmp0))]

!ifval $val9=1
val12=$[1+$val11/100]
!else
val12=$[1-$val11/100]
!endif
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]
tmp0=!randint 10, 90

val14=$[rint($(tmp0))]

!ifval $val13=1
val15=$[1+$val14/100]
!else
val15=$[1-$val14/100]
!endif
val16=$[$val12*$val15]
!if $val16=1 
val13=$[rint(3-$val13)]

!ifval $val13=1
t_=!rawmath 1+$val14/100
val15=!exec pari print($t_)
!else
t_=!rawmath 1-$val14/100
val15=!exec pari print($t_)
!endif
t_=!rawmath $val12*$val15
val16=!exec pari print($t_)
!endif

!ifval $val16>1
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif
val18=$[($val16-1)*100]

!ifval $val17=1
val19=$[($val16-1)*100]
!else
val19=$[(1-$val16)*100]
!endif
t_=!rawmath $val10*$val16
val20=!exec pari print($t_)
val21=$[rint($val20)]
val22=$[round($val20*100)/100]
!readproc slib/numeration/ecriturenombre $val19,comma tex 
tmp0=$slib_out
val23=$(tmp0)
!readproc slib/numeration/ecriturenombre $val16,comma tex 
tmp0=$slib_out
val24=$(tmp0)
!readproc slib/numeration/ecriturenombre $val12,comma tex 
tmp0=$slib_out
val25=$(tmp0)
!readproc slib/numeration/ecriturenombre $val15,comma tex 
tmp0=$slib_out
val26=$(tmp0)
!readproc slib/numeration/ecriturenombre $val22,comma tex 
tmp0=$slib_out
val27=$(tmp0)
!if $val22!=$val20 
val28=euros (valeur arrondie au centime).
!else
val28=euros.
!endif
!readproc slib/numeration/ecriturenombre $val10,tex 
tmp0=$slib_out
val29=$(tmp0)

!ifval $val9=1
val30=\(CM1= 1+\frac{$val11}{100}\) 
!else
val30= \(CM1= 1-\frac{$val11}{100}\) 
!endif

!ifval $val13=1
val31=\(CM2= 1+\frac{$val14}{100}\) 
!else
val31= \(CM2= 1-\frac{$val14}{100}\) 
!endif
val32=<span class="nowrap">\(CM= CM1 \times CM2\).</span><br> <span class="nowrap">\(CM= $val24\).</span>
val33=<p>Dans le cas d'évolutions successives, on peut calculer les différents coefficients multiplicateurs	associés aux différentes évolutions, puis calculer le coefficient multiplicateur global.</p>	<p>Appelons CM1 le coefficient multiplicateur correspondant à la première évolution et CM2 celui de la deuxième.</p>	<p> $val30 d'où \(CM1 = $val25\) et $val31 d'où <span class="nowrap">\(CM2 = $val26\).</span> </p>	<p> Le coefficient multiplicateur global est $val32</p>
val33=$val33	<p>Le nouveau prix en euros est donc \($val29 \times $val24\)	ce qui donne \($val27\) $val28 </p>	
replytype1=numexp
replyname1=Réponse :
replygood1=?analyze 34
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	  Un bien de valeur 
!insmath $val29
$() euros a subi une $(val8[$val9]) de <span class="nowrap">
!insmath $val11
$() %</span> puis une $(val8[$val13]) de <span class="nowrap">
!insmath $val14
$() %.</span>	  <br><label for="reply1">Quel est son nouveau prix ?</label>	</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$() euros</div>	<div class="wims_instruction">Arrondir au centime.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$m_sol2 $val33
$()
!exit

:latex
$()
$()
!exit

:postdef
val35=$[abs($val34-$val22)]

!ifval $val35 >=0.01
val36= 1
!else
val36=0
!endif

!exit

:feedback
!ifval $val35<=1 and $val35!=0
 <div class='oef_feedbacks'>Vous avez sans doute effectué le bon calcul mais vous avez mal arrondi le résultat.
$()</div>
!endif

!exit

:test
condweight1=19 

!ifval $val35<=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=Le raisonnement semble correct&nbsp;
condweight2=1 

!ifval $val35=0
 condtest2=1
!else
 condtest2=0
!endif
condname2=La réponse est correctement arrondie au centime&nbsp;

!exit

:stat
vsavelist=8,9,11,13,14,22,29,33,34
embedcnt=1
