tmp1=!randint 10000, 30000

val11=$(tmp0)/100,$(tmp1)/100
val12=$[$(val11[1])]
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val13=$val12,$(tmp0)
val14=$[$(val13[2])*$(val13[1])/100]
val15=$[$(val13[1])-$val14]
