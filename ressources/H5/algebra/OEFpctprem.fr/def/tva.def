tmp0=!randitem $tmp
val16=$[$(tmp0)]
val17=$[$val16*$val15/100]
val18=$[$val15+$val17]
val13=$val13,$val14,$val15,$val16,$val17,$val18
val19=
!for val20 =1 to 7 
val21=$[rint($(val13[$val20])*100)]
val21=$[$val21/100]
tmp0=!append item $val21 to $val19

val19=$(tmp0)
!next
val13=$val19
val12=$[$(val11[2])]
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val22=$val12,$(tmp0)
val14=$[$(val22[2])*$(val22[1])/100]
val15=$[$(val22[1])-$val14]
tmp=!nonempty items $val9

tmp0=!randitem $tmp
val16=$[$(tmp0)]
val17=$[$val16*$val15/100]
val18=$[$val15+$val17]
val22=$val22,$val14,$val15,$val16,$val17,$val18
val19=
!for val20 =1 to 7 
val21=$[rint($(val22[$val20])*100)]
val21=$[$val21/100]
tmp0=!append item $val21 to $val19

val19=$(tmp0)
!next
val22=$val19
replytype1=numeric
replyname1=
replygood1=?analyze 23
