tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=blablabla
val14=$(val13[1]), parmi l'ensemble des $(val13[3]), $val8 % sont des $(val13[5]). <br>	  Parmi l'ensemble $(val13[6]), $val9 % sont des $(val13[5]).
val15=Quelle est la proportion, en pourcentage, des $(val13[3])	  parmi l'ensemble $(val13[6])
val16=$[$val7]
val17=Soit \(p\) la proportion cherchée.<br>	  D'après l'énoncé, \(p \times \frac{$val8}{100}=\frac{$val9}{100}\) <br>	  d'où \(p = \frac{$val9}{$val8}\) <br>	  \(p=$val12\) <br>	  \(p=\frac{$val16}{100}\)<br>	  La proportion, en pourcentage, des $(val13[3]) parmi l'ensemble $(val13[6]) est de $val7&nbsp;%.
