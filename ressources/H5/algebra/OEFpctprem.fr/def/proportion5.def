!set title=Proportion 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2004,2005,2006,2007

val6=$[rint($(tmp0))]
tmp0=!randint 30, 60

val7=$[rint($(tmp0))]
tmp0=!randint 25, 50

val8=$[rint($(tmp0))]
tmp0=!randint 20, 40

val9=$[rint($(tmp0))]
val10=$[rint(100-$val8-$val9)]
val11=$[rint($val8*$val7*10)]
val12=$[rint($val9*$val7*10)]
val13=$[rint($val10*$val7*10)]
val14=$[rint($val11+$val12+$val13)]
tmp0=!randint 10, 20

val15=$[rint($(tmp0)*100)]
val16=$[rint($val8*$val15/100)]
val17=$[rint($val9*$val15/100)]
val18=$[rint($val10*$val15/100)]
replytype1=numeric
replyname1=part 1
replygood1=$[$val16]
replytype2=numeric
replyname2=part 2
replygood2=$[$val17]
replytype3=numeric
replyname3=part 3
replygood3=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	  M.Albert a investi $val11 euros dans une entreprise, M.Bigart $val12	  euros et Mme Carrier $val13 euros.</p><p>	 En $val6, les bénéfices ont été de $val15 euros. Chacun	 reçoit une part proportionnelle au capital investi.	</p><p>	 Calculer les trois parts.	 </p>	<ul><li>	  <label for="reply1">Part de M. Albert&nbsp;:</label>  
!read oef/embed.phtml reply1 
$()	  </li><li>	  <label for="reply2">Part de M. Bigart&nbsp;:</label>  
!read oef/embed.phtml reply2 
$()	  </li><li>	  <label for="reply3">Part de Mme Carrier&nbsp;:</label>  
!read oef/embed.phtml reply3 
$()	  </li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	<ul><li>Le total investi par ces 3 personnes est 
!insmath $val11+$val12+$val13=$val14
$()	</li><li>	  La part de M. Albert est donc de 
!insmath \frac{$val11}{$val14}\times $val15 = $val16
$()	</li><li>	  La part de M. Bigart est donc de 
!insmath \frac{$val12}{$val14}\times $val15 = $val17
$()	</li><li>	  La part de Mme Carrier est donc de 
!insmath \frac{$val13}{$val14}\times $val15 = $val18
$()	</li></ul>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,12,13,14,15,16,17,18
embedcnt=3
