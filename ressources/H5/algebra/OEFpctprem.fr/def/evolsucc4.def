!set title=Évolutions successives 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard;Fabien, Sommier
email=regine@mangeard.fr,fabien.sommier@gmail.com
precision=100

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=augmente,baisse
val7=augmenter,baisser
val8=hausse,baisse
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randint 1000, 3000

val10=$[rint($(tmp0))]
tmp0=!randint 10, 90

val11=$[rint($(tmp0))]

!ifval $val9=1
val12=$[1+$val11/100]
!else
val12=$[1-$val11/100]
!endif
val13=$[rint(3-$val9)]
val14=$[rint($val11)]

!ifval $val13=1
val15=$[1+$val14/100]
!else
val15=$[1-$val14/100]
!endif
val16=$[$val12*$val15]

!ifval $val16>1
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif
val18=$[($val16-1)*100]

!ifval $val17=1
val19=$[($val16-1)*100]
!else
val19=$[(1-$val16)*100]
!endif
t_=!rawmath $val10*$val16
val20=!exec pari print($t_)
val21=$[rint($val20)]
val22=$[round($val20*100)/100]
!readproc slib/numeration/ecriturenombre $val19,comma tex 
tmp0=$slib_out
val23=$(tmp0)
!readproc slib/numeration/ecriturenombre $val16,comma tex 
tmp0=$slib_out
val24=$(tmp0)
!readproc slib/numeration/ecriturenombre $val12,comma tex 
tmp0=$slib_out
val25=$(tmp0)
!readproc slib/numeration/ecriturenombre $val15,comma tex 
tmp0=$slib_out
val26=$(tmp0)
!readproc slib/numeration/ecriturenombre $val22,comma tex 
tmp0=$slib_out
val27=$(tmp0)
!if $val22!=$val20 
val28=euros (valeur arrondie au centime).
!else
val28=euros.
!endif

!ifval $val9=1
val29=\(CM1= 1+\frac{$val11}{100}\) 
!else
val29= \(CM1= 1-\frac{$val11}{100}\) 
!endif

!ifval $val13=1
val30=\(CM2= 1+\frac{$val14}{100}\) 
!else
val30= \(CM2= 1-\frac{$val14}{100}\) 
!endif
val31=<span class="nowrap">\(CM= CM1 \times CM2\).</span><br> <span class="nowrap">\(CM= $val24\).</span>
val32=<p>Dans le cas d'évolutions successives, on peut calculer les différents coefficients multiplicateurs	associés aux différentes évolutions, puis calculer le coefficient multiplicateur global.</p>	<p>Appelons CM1 le coefficient multiplicateur correspondant à la première évolution et CM2 celui de la deuxième.</p>	<p> $val29 d'où \(CM1 = $val25\) et $val30 d'où <span class="nowrap">\(CM2 = $val26\).</span> </p>	<p> Le coefficient multiplicateur global est $val31</p>
val33=Un bien qui subit une $(val8[$val9]) de <span class="nowrap">\($val11\) %</span> puis une $(val8[$val13]) de <span class="nowrap">\($val14\) %</span>
val34=ne change pas de prix, subit une baisse, subit une augmentation
val32=$val32	<p>Puisque \(CM < 1\) alors le bien a subi globalement une baisse à l'issue de ces deux évolutions successives.<br>	Cette baisse est de <span class="nowrap">\($val23\) %.</span>	</p>
replytype1=radio
replyname1=
replygood1=2;$val34
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	  Cliquer sur la bonne réponse&nbsp;:	</p><p>	$val33	</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

