tmp0=!randint 1, 3

val19=$[rint($(tmp0))]
val20=$[rint($(val13[$val19]))]
val21=$[rint(100/$val20)]
val22=$(val12[$val19])
t_=!rawmath 1+$val21/100
val23=!exec pari print($t_)
tmp0=!texmath $val23

val24=$(tmp0)
t_=!rawmath 1-$val21/100
val25=!exec pari print($t_)
tmp0=!texmath $val25

val26=$(tmp0)
val27=Pour augmenter une valeur \(v\) de
val28=Pour diminuer une valeur \(v\) de
val29=il suffit de multiplier \(v\) par
val30=il suffit de diviser \(v\) par
val31=il suffit d'ajouter à \(v\)
val32=il suffit de retrancher à \(v\)
val33=Un prix \(p\) peut subir une hausse de
val34=Un prix \(p\) peut subir une baisse de
val35=et ceci n'est pas égal à
!if $val21=50 
val36=$val28 $val21&nbsp;% &#44; $val30 <span class="nowrap">\($val20\).</span>,1,<span class="nowrap">\(v \times \left(1-\frac{$val21}{100}\right) = \frac{v}{$val20} \).</span>
!else
val36=$val28 $val21&nbsp;% &#44; $val30 <span class="nowrap">\($val20\).</span>,2,\(v \times \left(1-\frac{$val21}{100}\right) = v \times $val26 \) $val35 <span class="nowrap">\(\frac{v}{$val20}\).</span>
!endif
tmp=!trim $val27 100&nbsp;% &#44; $val29 <span class="nowrap">\(2\).</span>,1,<span class="nowrap">\(v \times \left( 1 + \frac{100}{100}\right) = v \times 2\).</span>	$val28 100&nbsp;% &#44; $val30 <span class="nowrap">\(2\).</span>,2,\(v \times \left( 1 - \frac{100}{100}\right) = 0\) $val35 <span class="nowrap">\(\frac{v}{2}\).</span>	$val27 $val14&nbsp;% &#44; $val29 <span class="nowrap">\($val9\).</span>,2,\(v \times \left( 1 + \frac{$val14}{100}\right) = v \times $val15\) $val35 <span class="nowrap">\(v \times $val9\).</span>	$val27 $val14&nbsp;% &#44; $val29 <span class="nowrap">\($val15\).</span>,1,<span class="nowrap">\(v \times \left( 1 + \frac{$val14}{100}\right) = v \times $val15\).</span>	$val27 $val14&nbsp;% &#44; $val31 $val17.,1,<span class="nowrap">\(v + \left(\frac{$val14}{100}\right) \times v = v + $val9 v \).</span>	$val27 $val14&nbsp;% &#44; $val31 $val18.,2,\(v + \left(\frac{$val14}{100}\right) \times v = v + $val9 v \) $val35 <span class="nowrap">\(v + $val15 v\).</span>	$val27 $val21&nbsp;% &#44; $val31 $val22.,1,<span class="nowrap">\(v + \left(\frac{$val21}{100}\right) \times v = v + \frac{1}{$val20} v \).</span>	$val27 $val21&nbsp;% &#44; $val29 <span class="nowrap">\($val24\).</span>,1,<span class="nowrap">\(v \times \left( 1 + \frac{$val21}{100}\right) = v \times $val24\).</span>	$val27 $val21&nbsp;% &#44; $val29 <span class="nowrap">\($val26\).</span>,2,\(v \times \left( 1 + \frac{$val21}{100}\right) = v \times $val24\) $val35 <span class="nowrap">\(v \times $val26\).</span>	$val28 $val21&nbsp;% &#44; $val32 $val22.,1,<span class="nowrap">\(v - \left(\frac{$val21}{100}\right) \times v = v - \frac{1}{$val20} v \).</span>	$val36	$val28 $val21&nbsp;% &#44; $val29 <span class="nowrap">\($val26\).</span>,1,<span class="nowrap">\(v \times \left(1-\frac{$val21}{100}\right) = v \times $val26 \).</span>	$val33 100&nbsp;%.,1,\(p \times \left( 1 + \frac{100}{100}\right) = p \times 2\) et le prix \(p\) a alors doublé.	$val34 100&nbsp;%.,1,\(p \times \left( 1 - \frac{100}{100}\right) = 0\) et le prix \(p\) est devenu nul.	$val33 $val14&nbsp;%.,1,\(p \times \left( 1 + \frac{$val14}{100}\right) = p \times $val15\) et le prix \(p\) a alors $(val11[$val9]).	$val34 $val14&nbsp;%.,2,\(p \times \left( 1 - \frac{$val14}{100}\right) = p \times ($val16)\) ce qui n'est pas possible.	
