!set title=Somme de proportions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=C'est possible,C'est impossible
tmp0=!randint 2, 6

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint($val7+$(tmp0))]
tmp0=!randint 2, 6

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($val9+$(tmp0))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
!if $val11=1 
val10=$[rint($val8)]
val9=$[rint($val8-$val7)]
!else

!ifval $val7/ $val8 + $val9 / $val10=1
val11=$[rint(1)]
!endif
!endif

!ifval $val11=1
val12=C'est possible puisque la somme des proportions vaut 1
!else
val12= C'est impossible puisque la somme des proportions ne vaut pas 1
!endif
tmp=!translate ";': to $     $ in $val7 / $val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
val13=\($val13)
tmp=!translate ";': to $     $ in $val9 / $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
val14=\($val14)
replytype1=radio
replyname1=
replygood1=$val11;$val6
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val12.


!goto stat

!exit

:question
$()	<p>	  Lise affirme que dans sa classe, la part des filles est de $val13 et celle des garçons et de $val14.	 <br>Qu'en pensez-vous&nbsp;?	</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val12.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,14
embedcnt=1
