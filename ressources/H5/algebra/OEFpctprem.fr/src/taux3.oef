  }
  \answer{Réponse : }{\reponse}{type=numeric} la réponse attendue est \av
  \text{testentier=\reponse=round(\reponse) ? 1:0}
  \real{di=abs(\reponse-\av)}
  \text{testar=\di<=1 and \di<>0 ? 1:0}
  \condition{Bonne réponse&nbsp;}{\di<=1}{weight=19}
