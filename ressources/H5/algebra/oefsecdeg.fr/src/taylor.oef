\title{Identification des coefficients}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*randint(1..10)}
\integer{b=randint(-20..20)}
\integer{c=randint(-20..20)}

\integer{p=random(-1,1)*randint(1..5)}

\function{fv=(x-\p)}
\function{fw=(x-\p)^2}

\function{f=\a*x^2+\b*x+\c}

\rational{u=evalue(\f,x=\p)}

\rational{v=evalue(diff(\f,x),x=\p)}

\rational{w=evalue(diff(diff(\f,x),x),x=\p)/2}

\statement{Déterminer trois réels \(a\), \(b\), \(c\) tels que
<div class="wimscenter">
\(\f= a\fw + b \fv + c\).
</div>
On a:<ul>
<li><label for="reply3">\(a=\)</label> \embed{reply 3,5}</li>
<li><label for="reply2">\(b=\)</label> \embed{reply 2,5}</li>
<li><label for="reply1">\(c=\)</label> \embed{reply 1,5}</li>
</ul>}

\answer{c}{\u}{type=default}
\answer{b}{\v}{type=default}
\answer{a}{\w}{type=default}
