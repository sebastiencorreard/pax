\title{Factorisation d'un polynôme de degré 2}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(2..4)}
\integer{u=random(-1,1)*randint(1..8)}
\integer{v=random(-1,1)*randint(1..8)}
\function{err=maxima(factor((x-\u)*(x-\v)))}
\function{fac=maxima(factor((\a)*(x-\u)*(x-\v)))}
\function{dev=maxima(expand(\fac))}
\text{d=pari(poldisc(\dev))}
\statement{Écrire le polynôme \(\dev\) sous forme factorisée.
<div class="wims_instruction">
<b>Attention:</b> Il faut factoriser au "maximum".
</div>}

\answer{Forme factorisée}{\fac}{type=algexp}

\solution{Le discriminant de ce polynôme est égal à \(\d\), ses racines sont
\(x_1=\u\) et \(x_2=\v\). Sa forme factorisée est donc:
<div class="wimscenter"> \(\fac\).</div>}
