\title{Intersection droite parabole}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..5)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)}
\function{f0=maxima(expand(\k*(x-\u)*(x-\v)))}

\integer{mx=random(-1,1)*random(5..10)}
\integer{my=evalue(\f0,x=\mx)}
\function{f1=diff(\f0,x)}
\rational{a=evalue(\f1,x=\mx)}
\rational{b=\my-\a*\mx}

\integer{p=random(-1,1)}

\if{\p=0}{
\integer{ns=1}
}

\if{\p=1 and \k>0}{
\integer{ns=2}
}

\if{\p=1 and \k<0}{
\integer{ns=0}
}

\if{\p=-1 and \k>0}{
\integer{ns=0}
}

\if{\p=-1 and \k<0}{
\integer{ns=2}
}

\function{f2=maxima(\f0-\a*x-\b-\p)}

\function{d=maxima(\a*x+\b+\p)}


\integer{ym=-10}
\integer{yM=10}
\integer{ny=\yM-\ym+1}
\text{dessin=
xrange=-6,6
yrange \ym,\yM
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
plot green,\f0
plot green,\d
}

\text{f0a=texmath(\f0)}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\draw{300,300}{\dessin}</div>
 <div class="medium_size text_col">
On considère la parabole \(P\) d'équation \(y=\f0a\) et la droite
\(d\) d'équation \(y=\d\). Combien \(P\) et \(d\) possèdent-elles de points d'intersection ?

<div class="wimscenter">
<label for="reply1">\(P\) et \(d\) possèdent</label> \embed{reply 1,5} points d'intersection.
</div>
 </div>
</div>

}

\answer{Nombres de points d'intersection}{\ns}{type=default}

\solution{Les abscisses des points d'intersection de \(P\) et de \(d\)
sont les solutions de l'équation \(\f2=0\). Il suffit donc de calculer
le discriminant de cette équation pour trouver le nombre de points d'intersection
de ces deux courbes.}
