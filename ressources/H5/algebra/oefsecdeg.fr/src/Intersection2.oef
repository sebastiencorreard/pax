\title{Intersection 2}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..5)}

\integer{b=random(-1,1)*random(1..3)}
\integer{c=random(-3..3)}
\integer{p=random(1..4)}

\integer{x0n=random(-1,1)*random(2,3,5)}
\integer{x0d=random(2..10)}
\rational{x0=\x0n/\x0d}
\rational{x0 = \x0=\c ? random(\c-2,\c-1,\c+1)}

\function{f=\a+simplify(\b/(x-\c))}
\function{f_simp=simplify(\f)}
\function{y0=simplify(evalue(\f,x=\x0))}
\function{eq=simplify(\p*x-\p*\x0+\y0)}
\function{eqa=simplify(\a*(x-\c)+\b)}
\function{eqb=simplify((\eq)*(x-\c))}
\function{eqc=simplify(maxima(expand(\eqb))-\eqa)}
\text{tm=texmath(\eq)}

\text{f_simp_t=texmath(\f_simp)}
\text{eqa_t=texmath(\eqa)}
\text{eqb_t=texmath(\eqb)}
\text{eqc_t=texmath(\eqc)}

\function{x1=simplify(
\b/(\p*(\c-\x0))+\c
)}
\function{y1=simplify(
evalue(\f,x=\x1)
)}
\real{t=simplify((\x1)+(-1)*(\x0))}

\rational{s=\x0+\x1}
\rational{pr=\x0*\x1}

\if{\x0=\x1}{
\integer{ns=1}
}
{
\integer{ns=2}
}

\text{sol1=L'équation de l'hyperbole peut s'écrire sous la forme \(y=\f_simp_t),
pour trouver les points d'intersection de \(H) et \(d), on est donc amené
à résoudre l'équation
<div class="wimscenter">
\(
\begin{array}{cccc}
& \f_simp_t & = & \tm \\
\Leftrightarrow & \eqa_t & = & \eqb_t \\
\Leftrightarrow & 0 & = & \eqc_t
) </div>
Cette dernière équation possède
}

\text{sol2=(\x0=\x1)? une unique solution qui est \(\x0). Ces deux courbes possèdent un unique point d'intersection qui est \(A(\x0;\y0)): deux solutions \(\x0) et \(\x1). Ces deux courbes possèdent deux points d'intersection \(A(\x0;\y0)) et \(B(\x1;\y1))}

\integer{yt=max(5,abs(\y0))}
\integer{yt=(floor(\yt/5.1)+1)*5}
\integer{dy=\yt/5}
\integer{ym=-\yt}
\integer{yM=\yt}
\integer{ny=(\yM-\ym)/\dy}

\text{dessin=
linewidth 1
xrange -5,5
yrange \ym,\yM
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,\dy,\ny,blue
linewidth 2
line 1,-\dy/5,1,\dy/5,red
line -0.2,\dy,0.2,\dy,red
line -6,0,6,0,red
line 0,\ym,0,\yM,red
text red,0.2,0,normal,0
text red,1.2,0,normal,1
text red,0.2,\dy,normal,\dy
plot green,\f
plot green,\eq
}

\text{sol=(\x0=\x1)?Ces deux courbes possèdent un unique point d'intersection qui est \(A(\x0;\y0)):Ces deux courbes possèdent deux points d'intersection \(A(\x0;\y0)) et \(B(\x1;\y1))}

\text{reput=}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\draw{200,200}{\dessin}</div>
 <div class="medium_size text_col">
 Déterminer les coordonnées du ou des points d'intersection
de la droite \(d) et de l'hyperbole \(H) d'équations respectives:
<div class="wimscenter">\(y=\eq) et \(y=\f). </div>
