</div>

}

\hint{Ecrire \(\f) sous forme d'un quotient, puis utiliser les produits en croix.}

\answer{La matrice.....}{\rep1}{type=matrix}

\rational{xr1=\rep1[1;1]}
\rational{yr1=\rep1[1;2]}

\integer{nsr=rows(\rep1)}
\if{\nsr >1}{
\rational{xr2=\rep1[2;1]}
\rational{yr2=\rep1[2;2]}
\real{t2=evalue(\f0,x=\xr2)}
\real{t4=evalue(\f,x=\xr2)-(\yr2)}
}
\real{t1=evalue(\f0,x=\xr1)}

\real{t3=evalue(\f,x=\xr1)-(\yr1)}

\if{\nsr>1}{
\real{t5=\xr1+\xr2-\s}
\real{t6=\xr1*\xr2-\pr}
}{
\real{t5=2*\xr1-\s}
\real{t6=(\xr1)^2-\pr}
}
\real{t7=\ns-\nsr}

\if{\nsr=1}{
\text{reput=Votre réponse: A(\xr1;\yr1)}
}

\if{\nsr>1}{
\text{reput=Votre réponse: A(\xr1;\yr1) et B(\xr2;\yr2)}
}

\condition{Les abscisses des points que vous avez donnés sont
 correctes}{\t5=0 and \t6=0}
\condition{Les points que vous avez donnés sont situés sur l'hyperbole \(P\)}{\t3=0 and \t4=0}
\condition{Vous avez trouvé le bon nombre de points d'intersection}{\t7=0}

