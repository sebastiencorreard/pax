\title{Identification et quotient}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*randint(1..10)}
\integer{b=randint(-20..20)}
\integer{c=random(-1,1)*randint(1..20)}

\integer{p=random(-1,1)*randint(1..5)}

\function{num=(\a*x+\b)*(x-\p)+\c}
\function{num=maxima(expand(\num))}
\text{num=texmath(\num)}
\function{den=(x-\p)}
\statement{Déterminer trois réels \(a\),\(b\), \(c\) tels que
<div class="wimscenter">
\(\frac{\num}{\den}= a x+ b + \frac{c}{\den}\)
</div>
On a:
<ul>
<li><label for="reply1">\(a=\)</label> \embed{reply 1,5}</li>
<li><label for="reply2">\(b=\)</label> \embed{reply 2,5}</li>
<li><label for="reply3">\(c=\)</label> \embed{reply 3,5}</li>
</ul>}

\answer{\(a\)}{\a}{type=default}
\answer{\(b\)}{\b}{type=default}
\answer{\(c\)}{\c}{type=default}
