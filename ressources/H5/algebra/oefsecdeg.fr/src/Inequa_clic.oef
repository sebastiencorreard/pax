\title{Signe d'un trinôme}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{c1=&#91;}
\text{c2=&#93;}
\text{a1=&#123;}
\text{a2=&#125;}
\text{pv=&#59;}

\integer{u=random(-5..5)}
\integer{v=randint(1..5)^2}
\integer{eps=random(-1,-1,-1,1)}
\integer{k=random(-1,1)*randint(1..2)}

\function{f1=maxima(expand(\k*((x+\u)^2+\eps*\v)))}

\rational{a=maxima(-\u-sqrt(\v))}
\rational{b=maxima(-\u+sqrt(\v))}
\integer{pierre=randint(1..2)}
\if{\pierre=1}
{\rational{c=\b+randint(1..5)}}
{\rational{c=\a-randint(1..5)}}

\integer{al=random(1..4)}

\text{signe=item(\al,\le,<,\ge,>)}

\if{\eps<0}{
  \if{\k>0 and \al=1}{
    \text{ligne=\c1,\a,\pv,\b,\c2}
  }
  \if{\k>0 and \al=2}{
    \text{ligne=\c2,\a,\pv,\b,\c1}
  }
  \if{\k>0 and \al=3}{
  \text{ligne=\c2,\(-\infty),\pv,\a,\c2,\(\cup),\c1,\b,\pv,\(+\infty),\c1}
  }
  \if{\k>0 and \al=4}{
    \text{ligne=\c2,\(-\infty),\pv,\a, \c1,\(\cup),\c2,\b,\pv,\(+\infty),\c1}
  }
  \if{\k<0 and \al=3}{
    \text{ligne=\c1,\a,\pv,\b,\c2}
  }
  \if{\k<0 and \al=4}{
    \text{ligne=\c2,\a,\pv,\b,\c1}
  }
  \if{\k<0 and \al=1}{
    \text{ligne=\c2,\(-\infty),\pv,\a,\c2,\(\cup),\c1,\b,\pv,\(+\infty),\c1}
  }
  \if{\k<0 and \al=2}{
    \text{ligne=\c2,\(-\infty),\pv,\a,\c1,\(\cup),\c2,\b,\pv,\(+\infty),\c1}
  }
}

\if{\eps>0 and \v=0}{
  \if{\k>0 and \al=1}{
    \text{ligne=\a1,\a,\a2}
  }
  \if{\k>0 and \al=2}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k>0 and \al=3}{
  \text{ligne=\(\mathbb{R})}
  }
  \if{\k>0 and \al=4}{
    \text{ligne=\c2,\(-\infty),\pv,\a,\c1,\(\cup),\c2,\b,\pv,\(+\infty),\c1}
  }
  \if{\k<0 and \al=3}{
    \text{ligne=\a1,\a,\a2}
  }
  \if{\k<0 and \al=4}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k<0 and \al=1}{
    \text{ligne=\(\mathbb{R})}
  }
  \if{\k<0 and \al=2}{
    \text{ligne=\c2,\(-\infty),\pv,\a,\c1,\(\cup),\c2,\b,\pv,\(+\infty),\c1}
  }
}
\if{\eps>0 and \v!=0}{
  \if{\k>0 and \al=1}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k>0 and \al=2}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k>0 and \al=3}{
    \text{ligne=\(\mathbb{R})}
  }
  \if{\k>0 and \al=4}{
    \text{ligne=\(\mathbb{R})}
  }
  \if{\k<0 and \al=3}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k<0 and \al=4}{
    \text{ligne=\(\emptyset)}
  }
  \if{\k<0 and \al=1}{
    \text{ligne=\(\mathbb{R})}
  }
  \if{\k<0 and \al=2}{
    \text{ligne=\(\mathbb{R})}
  }
}

\matrix{reponse=
\ligne
\c1,\a,\pv,\b,\c,\c2, \(\cup), \(-\infty), \(+\infty), \(\mathbb{R}), \(\emptyset),\a1,\a2
}

\statement{Résoudre l'inéquation:
<div class="wimscenter"> \(\f1\) \(\signe 0\)</div>
L'ensemble des solutions de cette inéquation est:
<div class="wimscenter">
 \embed{reply 1,50 30 12}
</div>

}

\answer{Ensemble des solutions}{\reponse}{type=clickfill}
