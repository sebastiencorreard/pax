\title{Racines d'un polynôme du second degré v2}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{a=random(1,-1)*randint(1..5)}
\integer{u=random(1,-1)*randint(1..12)}
\integer{v=random(1,-1)*randint(1..12)}
\integer{b0=(\a)*(-1)*(\u+\v)}
\integer{c0=(\a)*\u*\v}

\integer{b1=random(-5..5)}
\integer{c1=random(-5..5)}

\integer{al=random(1..2)}
\integer{al=1}

\integer{b=item(\al,\b0,\b1)}
\integer{c=item(\al,\c0,\c1)}

\function{pol=maxima(expand((\a)*x^2+(\b)*x+\c))}

\integer{d=(\b)^2-4*(\a)*(\c)}

\text{nb=\d<0?0}
\text{nb=\d=0?1}
\text{nb=\d>0?2}

\text{nbrac=\d=0?une racine. Quelle est cette racine ?}
\text{nbrac=\d>0?deux racines. Quelles sont ces racines ?}

\if{\d>=0}{
\function{x1=simplify(
((-1)*\b-\sqrt(\d))/(2*\a)
)}
\function{x2=simplify(
((-1)*\b+\sqrt(\d))/(2*\a)
)}
}

\text{sol=\d>0?\x1,\x2}
\text{sol=\d=0?\x1}

\text{STEPS = \d>=0 ? reply1
choice 1
reply2
:
reply1
choice 1
}
\steps{\STEPS}

\text{textsol=\d<0? Le discriminant (\d) étant négatif, ce polynôme ne possède pas de racine.}

\text{textsol=\d=0? Le discriminant étant nul, ce polynôme possède donc une seule racine qui est \(\x1).}

\text{textsol=\d>0? Le discriminant (\d\) étant positif, ce polynôme possède deux racines, qui sont
<div class="wimscenter">
\(\x1\) et \(\x2\).
</div>}

\statement{On considère le polynôme \(P\) définie par la relation \(P(x)=\pol\).
\if{\step=1}{Calculer le discriminant \(\Delta\) de \(P\).
<div class="wimscenter"> <label for="reply1">\(\Delta=\)</label> \embed{reply 1} </div>
}
\if{\step=2}{ Oui, on a bien \(\Delta=\d\). }
\if{\step=3}{ Oui, on a bien \(\Delta=\d\). Ce polynôme possède donc \nbrac.
 <div class="wimscenter">
<label for="reply1">Ensemble des solutions:</label> \embed{reply 2,20}.
</div>
<div class="wims_instruction">
<b>Attention:</b> Séparer, s'il y a lieu, les racines par une virgule.
De plus \(\sqrt{a}\) s'écrit <span class="tt">sqrt(a)</span>.</div>
}

}
\answer{Discriminant de}{\d}{type=numeric}

\answer{ensemble des solutions}{\sol}{type=fset}

\choice{Nombre de solutions}{\nb}{0,1,2}

\solution{\textsol}
