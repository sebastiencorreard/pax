\title{Équations bicarrées et autres}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*random(1..5)}
\integer{u=random(-1,1)*randint(1..8)}
\integer{v=randint(-8..8)}
\integer{al=random(1,2)}
\function{tri=maxima(expand(\a*(x-\u)*(x-\v)))}

\if{\al=1}{
	\function{f=maxima(expand(\a*(x^2-\u)*(x^2-\v)))}
	\if{\u>0 and \v >0 and \u != \v}{
	  \integer{N=4}
	}
	\if{\u>0 and \v >0 and \u = \v}{
	  \integer{N=2}
	}
	\if{(\u>0 and \v <0) or (\u<0 and \v>0)}{
	  \integer{N=2}
	}
	\if{\u<0 and \v <0}{
	  \integer{N=0}
	}
	\if{\u>0 and \v=0}{
	  \integer{N=3}
	}
	\if{\u<0 and \v=0}{
	  \integer{N=1}
	}
}
\if{\al=2}{
	\function{f=maxima(expand(\a*(sqrt(x)-\u)*(sqrt(x)-\v)))}
	\if{\u>0 and \v >0 and \u != \v}{
	  \integer{N=2}
	}
	\if{\u>0 and \v >0 and \u = \v}{
	  \integer{N=1}
	}
	\if{(\u>0 and \v <0) or (\u<0 and \v>0)}{
	  \integer{N=1}
	}
	\if{\u<0 and \v <0}{
	  \integer{N=0}
	}
	\if{(\u>0 and \v=0) or (\u=0 and \v>0)}{
	  \integer{N=2}
	}
	\if{(\u<0 and \v=0) or (\u=0 and \v<0)}{
	  \integer{N=1}
	}
}

\statement{Combien l'équation \(\f=0\) possède-t-elle de solutions réelles ?
<div class="wimscenter">
<label for="reply1">Votre réponse:</label> \embed {reply 1}
</div>
}

\answer{Nombre de solutions}{\N}{type=integer}

\hint{Les racines du polynôme \(\tri\) sont \(\u\) et \(\v\).}
