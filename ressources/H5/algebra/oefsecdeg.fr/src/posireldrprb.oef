\title{Position relative droite/parabole}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{pitoun.wims@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-4..4)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)}
\function{f0=maxima(expand(\k*(x-\u)^2+\v))}

\integer{mx=random(-1,1)*random(1..5)}
\integer{my=evalue(\f0,x=\mx)}
\function{f1=diff(\f0,x)}
\rational{a=evalue(\f1,x=\mx)}
\rational{b=\my-\a*\mx}

\if{\p=0}{
\integer{ns=1}
}

\if{\p=1 and \k>0}{
\integer{ns=2}
}

\if{\p=1 and \k<0}{
\integer{ns=0}
}

\if{\p=-1 and \k>0}{
\integer{ns=0}
}

\if{\p=-1 and \k<0}{
\integer{ns=2}
}

\function{f2=maxima(\f0-\a*x-\b-\p)}

\function{d=maxima(\a*x+b)}
\function{db=maxima(\a*x+\b)}

\integer{ym=-10}
\integer{yM=10}
\integer{ny=\yM-\ym+1}
\text{dessin=
animate 10,0.5,0
xrange=-6,6
yrange \ym,\yM
linewidth 1
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
plot green,\f0
plot blue,\a*x+s*20-10
}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\draw{300,300}{
\dessin}</div>
 <div class="medium_size text_col">
 On considère la parabole \(P\) d'équation \(y = \f0\).
Pour quelle valeur de \(b\) la droite d'équation \(y = \d\) et
\(P\) possèdent-elles un unique point d'intersection ?
<div class="wimscenter">
\(P\) et \(d\) possède un unique point d'intersection lorsque <label for="reply1">\(b=\)</label> \embed{reply 1,15}.
</div>
 </div>
</div>
}

\answer{Valeur de b}{\b}{type=default}

\solution{\(d\) et \(P\) possèdent un unique point d'interection si et seulement
  si l'équation \(\f0=\d\) possède une unique solution.
  Or cette équation se ramène à une équation du second degré, il suffit donc
  de trouver la valeur de \(b\)
  pour laquelle cette dernière ne possède qu'une seule solution (\(\Delta=0\)).
}
