\title{Simplifier une fraction rationnelle}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a1=random(-1,1)*randint(1..5)}
\integer{a2=random(-1,1)*randint(1..5)}
\integer{as=pari(gcd(\a1,\a2))}
\integer{uc=random(-5..5)}
\integer{v1=random(-1,1)*randint(1..5)}
\integer{v2=random(-1,1)*randint(1..5)}
\if{\v1=\v2}{
\integer{v2=\v1+1}
}
\function{n=maxima(expand(\a1*(x-\v1)*(x-\uc)))}
\function{d=maxima(expand(\a2*(x-\v2)*(x-\uc)))}
\function{nf=maxima(\a1*(x-\v1)*(x-\uc))}
\function{df=maxima(\a2*(x-\v2)*(x-\uc))}
\text{nt=texmath(\n)}
\text{dt=texmath(\d)}
\text{nst=texmath(maxima(\a1*(x-\v1)/\as))}
\text{dst=texmath(maxima(\a2*(x-\v2)/\as))}

\function{t1=}
\function{t2=}
\function{t3=}

\function{q=\n/\d}
\function{qs=maxima(\a1*(x-\v1)/(\a2*(x-\v2)))}

\statement{On considère la fraction rationnelle \(F(x)=\frac{\nt}{\dt}\).
Simplifier l'écriture de \(F\).
<div class="wimscenter">
On a: \embed{reply 1}
</div>
}

\hint{On pourra essayer d'écrire le numérateur et le dénominateur sous forme factorisée.}

\answer{Forme simplifiée}{\rep1}{type=default}

\function{t1=(\rep1)*\a2*(x-\v2)}
\function{t2=(\t1)-\a1*(x-\v1)}
\function{t3=simplify(\t2)}

\condition{Vérification}{\t3=0}

\solution{On a \(\n=\nf\) et \(\d=\df\), il s'ensuit que:
\(\frac{\nt}{\dt}=\frac{\nst}{\dst}\)
.}
