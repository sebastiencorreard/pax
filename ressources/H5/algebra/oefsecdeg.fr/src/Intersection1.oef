\title{Intersection 1}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{p=random(1..4)}
\integer{x0n=random(-1,1)*random(2,3,5,7,11)}
\integer{x0d=random(2..10)}
\rational{x0=\x0n/\x0d}

\function{f=simplify(\a*x^2+\b*x+\c)}
\rational{y0=evalue(\f,x=\x0)}
\function{eq=simplify(\p*x-\p*\x0+\y0)}

\function{f0=maxima(expand(\f-(\eq)))}

\rational{pr=evalue(\f0,x=0)/\a}
\rational{s=-1*evalue(diff(\f0,x),x=0)/\a}
\rational{dta=(\a)^2*((\s)^2-4*\pr)}
\integer{ns=\dta>0?2:1}

\rational{x1=simplify(
(\p-\b)/\a-\x0
)}
\rational{y1=simplify(
evalue(\f,x=\x1)
)}
\real{t=\x1-\x0}

\integer{yt=max(5,abs(\y0))}
\integer{yt=(floor(\yt/5.1)+1)*5}
\integer{dy=\yt/5}
\integer{ym=-\yt}
\integer{yM=\yt}
\integer{ny=(\yM-\ym)/\dy}

\text{dessin=
linewidth 1
xrange -5,5
yrange \ym,\yM
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,\dy,\ny,blue
linewidth 2
line 1,-\dy/5,1,\dy/5,red
line -0.2,\dy,0.2,\dy,red
line -6,0,6,0,red
line 0,\ym,0,\yM,red
text red,0.2,0,normal,0
text red,1.2,0,normal,1
text red,0.2,\dy,normal,\dy
plot green,\f
plot green,\eq
}

\rational{xr1=}
\rational{yr1=}
\rational{xr2=}
\rational{yr2=}
\real{t1=}
\real{t2=}
\real{t3=}
\real{t4=}
\real{t5=}
\real{t6=}
\real{t7=}
\integer{nsr=}

\text{reput=}

\text{sol=(\ns=1)?Ces deux courbes possèdent un unique point d'intersection qui est \(A(\x0;\y0)):Ces deux courbes possèdent deux points d'intersection \(A(\x0;\y0)) et \(B(\x1;\y1))}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\draw{200,200}{\dessin}</div>
 <div class="medium_size text_col">
 Déterminer les coordonnées du ou des points d'intersection de la droite \(d\) et de la parabole \(P\) d'équations respectives:
  <div class="wimscenter">\(y=\eq\) et \(y=\f\).</div>
  <div class="spacer">
<label for="reply1">Votre réponse:</label>
 \embed{reply 1}
</div>
 </div>
</div>


<div class="wims_instruction">
<b>Remarque:</b> Si vous trouvez comme points d'intersection \(A(1,2)\) et \(B(3,4)\),
votre réponse devra être :
<table class="wimsnoborder wimscenter">
<tr><td>1,2</td></tr>
<tr><td>3,4</td></tr>
</table>
</div>
}

\hint{Pour trouver l'absicsse du point d'intersection de deux courbes d'équations \(y = f(x)\)
 et \(y = g(x)\), il faut résoudre l'équation \(f(x) = g(x)\).}

\answer{La matrice.....}{\rep1}{type=matrix}

\rational{xr1=\rep1[1;1]}
\rational{yr1=\rep1[1;2]}

\integer{nsr=rows(\rep1)}
\if{\nsr >1}{
\rational{xr2=\rep1[2;1]}
\rational{yr2=\rep1[2;2]}
\real{t2=evalue(\f0,x=\xr2)}
\real{t4=evalue(\f,x=\xr2)-(\yr2)}
}
\real{t1=evalue(\f0,x=\xr1)}

\real{t3=evalue(\f,x=\xr1)-(\yr1)}

\if{\nsr>1}{
\real{t5=\xr1+\xr2-\s}
\real{t6=\xr1*\xr2-\pr}
}{
\real{t5=2*\xr1-\s}
\real{t6=(\xr1)^2-\pr}
}
\real{t7=\ns-\nsr}

\if{\nsr=1}{
\text{reput=Votre réponse: A(\xr1;\yr1)}
}

\if{\nsr>1}{
\text{reput=Votre réponse: A(\xr1;\yr1) et B(\xr2;\yr2)}
}

\condition{Les abscisses des points que vous avez donnés sont
 correctes}{\t5=0 and \t6=0}
\condition{Les points que vous avez donnés sont situés sur la parabole \(P)}{\t3=0 and \t4=0}
\condition{Le nombre de solutions que vous avez donné est exact}{\t7=0}

\solution{
\reput<br>
\sol
}
