\title{Inéquations et second degré}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{a0=random(1,-1)}
\integer{u=random(1,-1)*randint(1..6)}
\integer{v=randint(1..6)}
\integer{b0=-2*\a0*\u}
\integer{c0=-\a0*\v}
\integer{a1=random(-1,1)*randint(1..5)}
\integer{b1=random(-5..5)}
\integer{c1=random(-5..5)}

\integer{a2=\a0+\a1}
\integer{b2=\b0+\b1}
\integer{c2=\c0+\c1}

\function{pol0=maxima(expand((\a0)*x^2+(\b0)*x+\c0))}
\function{pol1=maxima(expand((\a1)*x^2+(\b1)*x+\c1))}
\function{pol2=maxima(expand((\a2)*x^2+(\b2)*x+\c2))}

\integer{al=random(1..4)}
\text{i1=>}
\text{i2=\ge}
\text{i3=<}
\text{i4=\le}
\text{ineg=item(\al,\i1,\i2,\i3,\i4)}
\text{I1=\lbrack a ; b \rbrack}
\text{I2=\rbrack a ; b \lbrack}
\text{I3=\rbrack - \infty ; a \rbrack \cup \lbrack b ; + \infty \lbrack}
\text{I4=\rbrack - \infty ; a \lbrack \cup \rbrack b ; + \infty \lbrack}

\integer{d=(\b0)^2-4*(\a0)*(\c0)}

\text{inter=((\a0>0) and (\al=1))?4}
\text{inter=((\a0>0) and (\al=2))?3}
\text{inter=((\a0>0) and (\al=3))?2}
\text{inter=((\a0>0) and (\al=4))?1}

\text{inter=((\a0<0) and (\al=1))?2}
\text{inter=((\a0<0) and (\al=2))?1}
\text{inter=((\a0<0) and (\al=3))?4}
\text{inter=((\a0<0) and (\al=4))?3}

\text{forme=item(\inter,\I1, \I2, \I3, \I4)}

\function{x1=simplify(
((-1)*\b0-\sqrt(\d))/(2*\a0)
)}
\function{x2=simplify(
((-1)*\b0+\sqrt(\d))/(2*\a0)
)}

\real{t=(\x2)-(\x1)}
\function{sx1=(\t>=0)?\x1:\x2}
\function{sx2=(\t>=0)?\x2:\x1}

\steps{
reply1
reply2,reply3
}

\statement{Résoudre l'inéquation \(\pol2) \(\ineg) \(\pol1).

\if{\step=1}{
<p>
L'ensemble des solutions de cette inéquation est de la forme:</p>
<div class="wimscenter">
 \embed{reply 1, 180 30}
</div>

}
\if{\step=2}{<p>Oui, l'ensemble des solutions de l'inéquation
\(\pol2) \(\ineg) \(\pol1) est bien de la forme \(\forme). Précisez maintenant:</p>
 <ul>
<li><label for="reply2">La valeur de \(a\) :</label> \embed{reply 2} </li>
<li><label for="reply3">La valeur de \(b\) :</label>\embed{reply 3} </li>
</ul>

<div class="wims_instruction">
<b>Attention:</b> Pour rentrer une expression du type \(\sqrt{a}),
il faut taper <span class="tt">sqrt(a)</span>.
</div>
}

}
\answer{Solutions de l'inéquation}{\(\forme);\(\I1),\(\I2),\(\I3),\(\I4)}{type=dragfill}

\answer{Première racine}{\sx1}{type=formal}
\answer{Seconde racine}{\sx2}{type=formal}

\solution{L'ensemble des solutions de l'inéquation \(\pol2) \(\ineg) \(\pol1)
est de la forme \(\forme) avec \(a=\sx1) et \(b=\sx2)}

