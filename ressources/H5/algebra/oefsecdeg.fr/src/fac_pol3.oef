\title{Factorisation d'un polynôme de degré 3}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*randint(1..5)}
\integer{b=random(-5..5)}
\integer{c=random(-1,1)*randint(1..5)}

\integer{ev=random(-1,1)*randint(1..3)}

\integer{d=(\b)^2-4*\a*\c}

\function{f=maxima(expand((x-\ev)*(\a*x^2+\b*x+\c)))}

\function{g=maxima(expand((\a*x^2+\b*x+\c)))}

\integer{test=evalue(\g,x=\ev)}

\if{\test !=0}{
\if{\d>0}{
\integer{N=3}
}
\if{\d=0}{
\integer{N=2}
}
\if{\d<0}{
\integer{N=1}
}
}{
\if{\d>0}{
\integer{N=2}
}
\if{\d=0}{
\integer{N=1}
}
\if{\d<0}{
\integer{N=1}
}

}

\function{g1=maxima(x-\ev)}

\steps{
reply1
reply2
}

\statement{
On considère la fonction \(f\), définie sur \(\mathbb{R}\),
par \(f(x)=\f\).
\if{\step=1}{ Déterminer une fonction polynôme de degré 2 telle que:
<div class="wimscenter">
\(f(x)=(\g1)g(x)\)
</div>
<div class="wimscenter">
<label for="reply1">\(g(x)=\)</label> \embed{reply 1}
</div>}
\if{\step=2}{<p>On a vu que \(f(x)=(\g1)(\g)\).
Combien l'équation \(\f=0\) possède-t-elle de solutions réelles ?</p>
<div class="wimscenter">
<label for="reply2">Cette équation possède</label> \embed{reply 2,5} solutions.
</div>
}
}

\answer{Polynôme}{\g}{type=default}
\answer{Nombre}{\N}{type=integer}
