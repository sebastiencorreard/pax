\title{Factorisation d'un polynôme de degré 4}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{r1=random(-1,1)*randint(20)}
\integer{r2=randint(-20..20)}
\integer{u=randint(-20..20)}
\integer{v=random(-1,1,0)*pari(prime(randint(20..40)))}
\function{pf=(x-\r1)*(x-\r2)*((x-\u)^2-(\v))}
\function{p=maxima(expand(\pf))}
\if{\v>0}{
  \integer{n=4}
}
\if{\v=0}{
  \integer{n=3}
}
\if{\v<0}{
  \integer{n=2}
}
\if{\r1=\r2}{
  \integer{n=\n-1}
}
\if{(\v=0 and \u=\r1) or (\v=0 and \u=\r2)}{
  \integer{n=\n-1}
}
\text{appletcommand=\p \
}
\text{option= showToolBar=true
showMenuBar=true
width=600
height=500
}

\text{applet=slib(geo2D/geogebra \appletcommand , \option)}

\statement{On considère le polynôme
<div class="wimscenter">
\(p(x)=\p\)
</div>
Déterminer le nombre de racines réelles distinctes de \(p\).

On pourra à cette fin utiliser les outils de factorisation ou de visualisation.
<div class="wimscenter">
Ce polynôme possède \embed{reply 1,5} racines réelles distinctes.
</div>
<div class="spacer">
<b> Indication: </b> ce polynôme possède des racines évidentes
dans l'intervalle &#91; -20; 20 &#93;.
</div>
}
\answer{Nombre de racines}{\n}{type=default}
