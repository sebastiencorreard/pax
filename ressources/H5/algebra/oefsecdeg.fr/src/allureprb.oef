\title{Allure d'une parabole}
\language{fr}
\range{-5..5}
\author{Frédéric,Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-4..4)}
\integer{v=random(-5..5)}

\integer{k=random(-1,1)}
\function{f0=maxima(expand(\k*(x-\u)^2+\v))}

\integer{D=4*\k^2*\u^2-4*\k*(\v+\u^2)}

\if{\k<0}{
\text{b1=a&#60;0}
}
{
\text{b1=a&#62;0}
}
\text{u1=a&#60;0}
\text{u2=a&#62;0}

\text{v1=\(\Delta)&#60;0}
\text{v2=\(\Delta)&#62;0}
\text{v3=\(\Delta)&#61;0}

\if{\D>0}{\text{b2=\(\Delta)&#62;0}}
\if{\D=0}{\text{b2=\(\Delta)&#61;0}}
\if{\D<0}{\text{b2=\(\Delta)&#60;0}}

\function{f2=maxima(\f0-\a*x-\b-\p)}

\function{d=maxima(\a*x+b)}
\function{db=maxima(\a*x+\b)}

\integer{ym=-10}
\integer{yM=10}
\integer{ny=\yM-\ym+1}
\text{dessin=
animate 10,0.5,0
xrange=-6,6
yrange \ym,\yM
linewidth 1
parallel -6,\ym,-6,\yM,1,0,13,blue
parallel -6,\ym,6,\ym,0,1,\ny,blue
linewidth 2
line -6,0,6,0,red
line 0,\ym,0,\yM,red
linewidth 2
line 1,-0.2,1,0.2,black
line -0.2,1,0.2,1,black
text black,0.9,-0.2,medium,I
text black,-0.6,1.3,medium,J
text black,-0.3,-0.1,medium,O
plot green,\f0
plot blue,\a*x+s*20-10
}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\draw{300,300}{\dessin}</div>
 <div class="medium_size text_col">
  On considère la parabole \(P\) d'équation \(y=a x^2+b x+c\)
représentée dans le repère \((O,I,J)\) ci-contre.
  A partir du graphique, on peut affirmer que:
  <div class="wimscenter">
  \embed{reply 1,50 25}
  </div>
</div>
 </div>
}

\answer{Signe de a et \(\Delta\)}{\b1,\b2 | \b2,\b1;\u1,\u2,\v1,\v2,\v3}{type=dragfill}

\solution{L'allure de la parabole donne le signe de \(a\) : la parabole est tournée vers
le haut lorsque \(a>0\), vers le bas lorsque \(a<0\).<br>
Le signe de \(\Delta\) donne le nombre de solutions de l'équation \(a x^2+b x+c=0\) ;
ce nombre correspond au nombre de points d'intersections entre la parabole
et l'axe des abscisses. <br>
Un résultat du cours permet alors de déterminer le signe de \(\Delta\) :
<ul>
   <li>\(\Delta <0\) si et seulement si l'équation \(a x^2+b x+c=0\)
   n'admet aucune solution réelle ;</li>
   <li>\(\Delta=0\) si et seulement si l'équation \(a x^2+b x+c=0\)
   admet une unique solution réelle ;</li>
    <li>\(\Delta>0\) si et seulement si l'équation \(a x^2+b x+c=0\)
    admet exactement deux solutions réelles. </li>
 </ul>
}
