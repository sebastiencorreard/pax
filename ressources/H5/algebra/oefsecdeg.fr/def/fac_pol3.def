!set title=Factorisation d'un polynôme de degré 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(($val7)^2-4*$val6*$val8)]
t_=!replace internal \( by ( in expand((x-$val9)*($val6*x^2+$val7*x+$val8))
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val6*x^2+$val7*x+$val8))
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
evaltmp=$val12

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
!if $val13 !=0 
!if $val10>0 
val14=$[rint(3)]
!endif
!if $val10=0 
val14=$[rint(2)]
!endif
!if $val10<0 
val14=$[rint(1)]
!endif
!else
!if $val10>0 
val14=$[rint(2)]
!endif
!if $val10=0 
val14=$[rint(1)]
!endif
!if $val10<0 
val14=$[rint(1)]
!endif
!endif
t_=!replace internal \( by ( in x-$val9
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=default
replyname1=Polynôme
replygood1=$val12
replytype2=integer

replyname2=Nombre
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la fonction 
!insmath f
$(), définie sur 
!insmath \mathbb{R}
$(),	par 
!insmath f(x)=$val11
$().	
!if $m_step=1 
$() Déterminer une fonction polynôme de degré 2 telle que:	<div class="wimscenter">	
!insmath f(x)=($val15)g(x)
$()	</div>	<div class="wimscenter">	<label for="reply1">
!insmath g(x)=
$()</label>  
!read oef/embed.phtml reply 1 
$()	</div> 
!endif
$()	
!if $m_step=2 
$()<p>On a vu que 
!insmath f(x)=($val15)($val12)
$().	Combien l'équation 
!insmath $val11=0
$() possède-t-elle de solutions réelles ?</p>	<div class="wimscenter">	<label for="reply2">Cette équation possède</label>  
!read oef/embed.phtml reply 2,5 
$() solutions.	</div>	 
!endif
$()	
$()
!exit

