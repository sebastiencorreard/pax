!set title=Racines d'un polynôme du second degré v2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,c
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=2
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,-1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 12

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 12

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint(($val6)*(-1)*($val7+$val8))]
val10=$[rint(($val6)*$val7*$val8)]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val13=$[rint(1)]
tmp0=!item $val13 of $val9,$val11

val14=$[rint($(tmp0))]
tmp0=!item $val13 of $val10,$val12

val15=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(($val6)*x^2+($val14)*x+$val15)
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
val17=$[rint(($val14)^2-4*($val6)*($val15))]

!ifval $val17<0
val18=0
!endif

!ifval $val17=0
val18=1
!endif

!ifval $val17>0
val18=2
!endif

!ifval $val17=0
val19=une racine. Quelle est cette racine ?
!endif

!ifval $val17>0
val19=deux racines. Quelles sont ces racines ?
!endif
!if $val17>=0 
tmp=!translate ";': to $     $ in 	((-1)*$val14-\sqrt($val17))/(2*$val6)	

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in 	((-1)*$val14+\sqrt($val17))/(2*$val6)	

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=!rawmath $(tmp0)
!endif

!ifval $val17>0
val22=$val20,$val21
!endif

!ifval $val17=0
val22=$val20
!endif

!ifval $val17>=0 
val23= reply1	choice 1	reply2	
!else
val23=	reply1	choice 1	
!endif

!ifval $val17<0
val24= Le discriminant ($val17) étant négatif, ce polynôme ne possède pas de racine.
!endif

!ifval $val17=0
val24= Le discriminant étant nul, ce polynôme possède donc une seule racine qui est \($val20).
!endif

!ifval $val17>0
val24= Le discriminant ($val17\) étant positif, ce polynôme possède deux racines, qui sont	<div class="wimscenter">	\($val20\) et \($val21\).	</div>
!endif
oefsteps=$val23 
nextstep=!nosubst $val23 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Discriminant de
replygood1=$[$val17]
replytype2=fset
replyname2=ensemble des solutions
replygood2=$val22
choicename1=Nombre de solutions
choicegood1=$val18
choicebad1=0,1,2
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val24


!goto stat

!exit

:question
$()On considère le polynôme 
!insmath P
$() définie par la relation 
!insmath P(x)=$val16
$().	
!if $m_step=1 
$()Calculer le discriminant 
!insmath \Delta
$() de 
!insmath P
$().	<div class="wimscenter"> <label for="reply1">
!insmath \Delta=
$()</label>  
!read oef/embed.phtml reply 1 
$() </div>	 
!endif
$()	
!if $m_step=2 
$() Oui, on a bien 
!insmath \Delta=$val17
$().  
!endif
$()	
!if $m_step=3 
$() Oui, on a bien 
!insmath \Delta=$val17
$(). Ce polynôme possède donc $val19.	 <div class="wimscenter">	<label for="reply1">Ensemble des solutions:</label>  
!read oef/embed.phtml reply 2,20 
$().	</div>	<div class="wims_instruction">	<b>Attention:</b> Séparer, s'il y a lieu, les racines par une virgule.	De plus 
!insmath \sqrt{a}
$() s'écrit <span class="tt">sqrt(a)</span>.</div>	 
!endif
$()		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val24
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,17,19,24
embedcnt=2
