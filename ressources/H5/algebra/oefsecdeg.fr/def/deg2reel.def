tmp0=!randint 1, 6

tmp1=!randitem -1,1

tmp2=!randitem 0,1,1,1,1,1,1

val16=$[rint($(tmp0)*$(tmp1)*$(tmp2))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sqrt(2),sqrt(3),sqrt(5),1,1,1,1

val18=$(tmp0)
tmp=!translate ";': to $     $ in $val17*i*$val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
