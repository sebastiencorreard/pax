val16=$[rint($(tmp0)*$(tmp1)*$(tmp2))]
tmp0=!randitem 1,7,11,13

tmp1=!randitem -1,1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sqrt(2),sqrt(3),sqrt(5),1,1,1,1

val18=$(tmp0)
tmp=!translate ";': to $     $ in $val17*$val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
tmp=!translate ";': to $     $ in $val16+$val19

