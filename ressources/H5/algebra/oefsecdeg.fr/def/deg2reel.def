val11=$(tmp0)
tmp=!translate ";': to $     $ in $val10*($val16*$val16-$val17*$val17*$val18*$val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
!endif
val8=$[$val11*$val11-4*$val10*$val12]
