val9=$(tmp0)
tmp=!translate ";': to $     $ in $val16-$val19

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp=!translate ";': to $     $ in $val10*(-1)*($val9+$val15)

tmp=!lower $tmp
