tmp0=!randitem 0,1,1

val14=$[rint($(tmp0))]
!if $val14=0 
val9=0
tmp0=!randint 1, 6

tmp1=!randitem -1,1

tmp=!translate ";': to $     $ in $(tmp0)*$(tmp1)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
val15=$(tmp2)
tmp=!translate ";': to $     $ in $val10*(-1)*($val9+$val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
val12=0
!else
