val24=animate 10,0.5,0	xrange=-6,6	yrange $val21,$val22	linewidth 1	parallel -6,$val21,-6,$val22,1,0,13,blue	parallel -6,$val21,6,$val21,0,1,$val23,blue	linewidth 2	line -6,0,6,0,red	line 0,$val21,0,$val22,red	linewidth 2	line 1,-0.2,1,0.2,black	line -0.2,1,0.2,1,black	text black,0.9,-0.2,medium,I	text black,-0.6,1.3,medium,J	text black,-0.3,-0.1,medium,O	plot green,$val9	plot blue,\a*x+s*20-10	
