!set title=Identification des coefficients
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 10

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val9=$[rint($(tmp0)*$(tmp1))]
val10=!rawmath (x-$val9)
val11=!rawmath (x-$val9)^2
val12=!rawmath $val6*x^2+$val7*x+$val8
evaltmp=$val12

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
evaltmp=$(tmp0)

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp1=($evaltmp)
t_=!rawmath $(tmp1)
val14=!exec pari print($t_)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ;";': to $     $ in $(tmp0),x

tmp=!lower $tmp
tmp1=!exec maxima diff($tmp);
evaltmp=$(tmp1)

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp2=($evaltmp)
t_=!rawmath $(tmp2)/2
val15=!exec pari print($t_)
replytype1=default
replyname1=c
replygood1=$val13
replytype2=default
replyname2=b
replygood2=$val14
replytype3=default
replyname3=a
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer trois réels 
!insmath a
$(), 
!insmath b
$(), 
!insmath c
$() tels que	<div class="wimscenter">	
!insmath $val12= a$val11 + b $val10 + c
$().	</div>	On a:<ul>	<li><label for="reply3">
!insmath a=
$()</label>  
!read oef/embed.phtml reply 3,5 
$()</li>	<li><label for="reply2">
!insmath b=
$()</label>  
!read oef/embed.phtml reply 2,5 
$()</li>	<li><label for="reply1">
!insmath c=
$()</label>  
!read oef/embed.phtml reply 1,5 
$()</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12
embedcnt=3
