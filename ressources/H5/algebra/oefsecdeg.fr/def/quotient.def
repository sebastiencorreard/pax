!set title=Identification et quotient
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 10

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 20

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val9=$[rint($(tmp0)*$(tmp1))]
val10=!rawmath ($val6*x+$val7)*(x-$val9)+$val8
t_=!replace internal \( by ( in expand($val10)
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
tmp0=!texmath $val10

val10=$(tmp0)
val11=!rawmath (x-$val9)
replytype1=default
replyname1=\(a\)
replygood1=$val6
replytype2=default
replyname2=\(b\)
replygood2=$val7
replytype3=default
replyname3=\(c\)
replygood3=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer trois réels 
!insmath a
$(),
!insmath b
$(), 
!insmath c
$() tels que	<div class="wimscenter">	
!insmath \frac{$val10}{$val11}= a x+ b + \frac{c}{$val11}
$()	</div>	On a:	<ul>	<li><label for="reply1">
!insmath a=
$()</label>  
!read oef/embed.phtml reply 1,5 
$()</li>	<li><label for="reply2">
!insmath b=
$()</label>  
!read oef/embed.phtml reply 2,5 
$()</li>	<li><label for="reply3">
!insmath c=
$()</label>  
!read oef/embed.phtml reply 3,5 
$()</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=3
