!set title=Équations bicarrées et autres
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 8

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val8=$[rint($(tmp0))]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val6*(x-$val7)*(x-$val8))
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
!if $val9=1 
t_=!replace internal \( by ( in expand($val6*(x^2-$val7)*(x^2-$val8))
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
!if $val7>0 and $val8 >0 and $val7 != $val8 
val12=$[rint(4)]
!endif
!if $val7>0 and $val8 >0 and $val7 = $val8 
val12=$[rint(2)]
!endif
!if ($val7>0 and $val8 <0) or ($val7<0 and $val8>0) 
val12=$[rint(2)]
!endif
!if $val7<0 and $val8 <0 
val12=$[rint(0)]
!endif
!if $val7>0 and $val8=0 
val12=$[rint(3)]
!endif
!if $val7<0 and $val8=0 
val12=$[rint(1)]
!endif
!endif
!if $val9=2 
t_=!replace internal \( by ( in expand($val6*(sqrt(x)-$val7)*(sqrt(x)-$val8))
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
!if $val7>0 and $val8 >0 and $val7 != $val8 
val12=$[rint(2)]
!endif
!if $val7>0 and $val8 >0 and $val7 = $val8 
val12=$[rint(1)]
!endif
!if ($val7>0 and $val8 <0) or ($val7<0 and $val8>0) 
val12=$[rint(1)]
!endif
!if $val7<0 and $val8 <0 
val12=$[rint(0)]
!endif
!if ($val7>0 and $val8=0) or ($val7=0 and $val8>0) 
val12=$[rint(2)]
!endif
!if ($val7<0 and $val8=0) or ($val7=0 and $val8<0) 
val12=$[rint(1)]
!endif
!endif
replytype1=integer

replyname1=Nombre de solutions
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Combien l'équation 
!insmath $val11=0
$() possède-t-elle de solutions réelles ?	<div class="wimscenter">	<label for="reply1">Votre réponse:</label>  
!read oef/embed.phtml reply 1 
$()	</div>	
$()
!exit

