!set title=Tekenverloop van een lineaire functie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Véronique Royer
email=royer.veronique@wanadoo.fr
computeanswer=no
precision=100

ansorder=r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,1

tmp1=!randint 1, 4

val6=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
t_=!rawmath -$val7/$val6
val8=!exec pari print($t_)
val9=!rawmath $val6 *x + $val7

!ifval $val6==1
val9=!rawmath x + $val7
!endif

!ifval $val6==-1
val9=!rawmath -x + $val7
!endif
t_=!rawmath -$val7/$val6
val10=!exec pari print($t_)
val11=-,+
val12=-,+
val13=0,||,|

!ifval $val6>0
val14=1
!else
val14=2
!endif

!ifval $val6>0
val15=2
!else
val15=1
!endif
val16=1
replytype1=rational

replyname1=
replygood1=$val10
replytype2=menu
replyname2=
replygood2=$val14 ; $val11
replytype3=menu
replyname3=
replygood3=$val16 ; $val13
replytype4=menu
replyname4=
replygood4=$val15 ; $val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p> Bepaal het tekenverloop van 
!insmath f
$() gedefinieerd op $m_RR door 
!insmath f(x) = $val9
$(). </p>	<p align="center">	<table border=1 border="solid" width="60%">	<tr>	<td width="10%" align="center"> 
!insmath x
$()</td><td  width="30%" align="left">
!insmath -\infty
$()</td><td  width="5%" align="center"> 
!read oef/embed.phtml reply1,5 
$()</td>	<td width="30%" align="right">
!insmath +\infty
$()</td>	</tr>	<tr>	<td width="10%" align="center">
!insmath f(x)
$()</td><td width="30%" align="center">  
!read oef/embed.phtml reply2 
$() </td><td  width="5%" align="center"> 
!read oef/embed.phtml reply3 
$()</td><td width="30%" align="center">  
!read oef/embed.phtml reply4 
$()</td>	</tr>	</table>	</p>	
$()
!exit

:hint
$()	<p>De functie 
!insmath ax+b
$()  wordt 0 in 
!insmath -\frac{b}{a}
$() en verandert van teken in 
!insmath -\frac{b}{a}
$().<br>	En heeft het teken van 
!insmath a
$() wanneer 
!insmath x > -\frac{b}{a}
$(). </p>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=4
