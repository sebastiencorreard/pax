!set title=Functies met een eenduidig teken
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Véronique Royer
email=royer.veronique@wanadoo.fr
computeanswer=no
precision=100

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,1

tmp1=!randint 1, 10

val6=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val8=$[rint((-1)^$(tmp0)*$(tmp1))]

!ifval $val8<0
val9=$[rint(1)]
!else
val9=$[rint(3)]
!endif

!ifval $val8<0
val10=$[rint(2)]
!else
val10=$[rint(4)]
!endif
tmp0=!randint 1, 10

val11=$[rint($(tmp0))]
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
tmp0=!randitem 2,4

val13=$[rint($(tmp0))]
t_=!rawmath -$val7/$val6
val14=!exec pari print($t_)
val15=!rawmath $val6 *x + $val7

!ifval $val6==1
val15=!rawmath x + $val7
!endif

!ifval $val6==-1
val15=!rawmath -x + $val7
!endif
val16=$val8,$val8($val15)^$val13,$val11($val15)^$val13 + $val12,-$val11($val15)^$val13 - $val12
tmp0=!randint 1, 4

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val16

val18=$(tmp0)
val19=strikt negatief
val20=negatief of nul
val21=strikt positief
val22=positief of nul
val23=$val19,$val20,$val21,$val22
val24=$val9,$val10,3,1
tmp0=!item $val17 of $val24

val25=$(tmp0)
replytype1=menu
replyname1=
replygood1=$val25 ; $val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p> De functie 
!insmath f
$() is gedefinieerd in $m_RR door: 
!insmath f(x) = $val18 
$() :  </p> 	<p align="center">
!insmath f
$() is in $m_RR altijd:  
!read oef/embed.phtml reply1 
$()</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback
!set tmp0=!item $val25 of $val23

!ifval $m_reply1 notsametext $(tmp0)
 <p>	<b>Uitleg : </b>	 
!if $val17==1 
$()er geldt 
!insmath f(x) = $val18 
$() voor alle 
!insmath x
$() $m_in $m_RR , 
!insmath f(x)
$() heeft waarde 
!insmath $val8
$() en wordt nooit nul.  
!endif
$()	 
!if $val17==2 
$()er geldt 
!insmath f(x) = $val18 
$() voor alle 
!insmath x
$() $m_in $m_RR . <br/> Of  
!insmath ($val15)^$val13
$() is altijd positief of nul als geldt 
!insmath x = $val14
$(), 	
!insmath f(x)
$() heeft functiewaarde 
!insmath $val8
$() of nul by 
!insmath $val14
$(). 
!endif
$()	 
!if $val17==3 
$() 
!insmath $val11($val15)^$val13
$() is altijd	positief, of nul als 
!insmath x = $val14
$(). <br/> 	
!insmath $val12
$() is strikt positief, en dus is  	
!insmath f(x) = $val11($val15)^$val13  + $val12
$() ook strikt positief, voor alle 
!insmath x
$() $m_in $m_RR. 
!endif
$()	 
!if $val17==4 
$() 
!insmath ($val15)^$val13
$() is altijd	positief, of nul als 
!insmath x = $val14
$(). 	 Dus 
!insmath -$val11($val15)^$val13
$() is altijd negatief of nul. <br/> 
!insmath -$val12
$()  is strikt negatief en je mag schrijven 	
!insmath f(x) = -$val11($val15)^$val13 + (-$val12)
$(). Dus 
!insmath f(x)
$() is strikt negatief voor alle 
!insmath x
$() $m_in $m_RR. 
!endif
$()	
$()
!endif

!exit

:test

!exit

:stat
vsavelist=8,11,12,13,14,15,17,18,23,25
embedcnt=1
