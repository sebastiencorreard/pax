\title{Functies met een eenduidig teken}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{royer.veronique@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = (-1)^random(0,1)*random(1..10)}
\integer{b = (-1)^random(0,1)*random(1..10)}
\integer{k = (-1)^random(0,1)*random(1..10)}
\integer{signk=\k<0?1:3}
\integer{signku2=\k<0?2:4}
\integer{k1=random(1..10)}
\integer{k2=random(1..10)}
\integer{n=random(2,4)}
\rational{zero=-\b/\a}
\function{u=\a *x + \b}
\function{u=\a==1?x + \b}
\function{u=\a==-1?-x + \b}
\text{ff=\k,\k(\u)^\n,\k1(\u)^\n + \k2,-\k1(\u)^\n - \k2}

\integer{cas=random(1..4)}
\text{f=item(\cas,\ff)}
\text{item1=strikt negatief}
\text{item2=negatief of nul}
\text{item3=strikt positief}
\text{item4=positief of nul}
\text{choix=\item1,\item2,\item3,\item4}
\text{reps=\signk,\signku2,3,1}
\text{rep=item(\cas,\reps)}

\statement{
<p> De functie \(f) is gedefinieerd in \RR door: \(f(x) = \f ) :  </p> 
<p align="center">\(f) is in \RR altijd: \embed{reply1}</p>
}
\answer{}{\rep ; \choix}{type=menu}

\feedback{\reply1 notsametext item(\rep,\choix)}{
<b>Uitleg : </b>
\if{\cas==1}{er geldt \(f(x) = \f ) voor alle \(x) \in \RR , \(f(x)) heeft waarde \(\k) en wordt nooit nul. }
\if{\cas==2}{er geldt \(f(x) = \f ) voor alle \(x) \in \RR . <br/> Of  \((\u)^\n) is altijd positief of nul als geldt \(x = \zero), 
\(f(x)) heeft functiewaarde \(\k) of nul by \(\zero).}
\if{\cas==3}{ \(\k1(\u)^\n) is altijd
positief, of nul als \(x = \zero). <br/> 
\(\k2) is strikt positief, en dus is  
\(f(x) = \k1(\u)^\n  + \k2) ook strikt positief, voor alle \(x) \in \RR.}
\if{\cas==4}{ \((\u)^\n) is altijd
positief, of nul als \(x = \zero). 
 Dus \(-\k1(\u)^\n) is altijd negatief of nul. <br/> \(-\k2)  is strikt negatief en je mag schrijven 
\(f(x) = -\k1(\u)^\n + (-\k2)). Dus \(f(x)) is strikt negatief voor alle \(x) \in \RR.}
}