\title{Het teken van product of quoti&euml;nt }
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{royer.veronique@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = (-1)^random(0,1)*random(1..10)}
\integer{b = (-1)^random(0,1)*random(1..10)}
\integer{c = (-1)^random(0,1)*random(1..10)}
\integer{d = (-1)^random(0,1)*random(1..10)}
\rational{racu=-\b/\a}
\rational{racv=-\d/\c}

\function{u=\a *x + \b}
\function{u=\a==1?x + \b}
\function{u=\a==-1?-x + \b}
\function{v=\c *x + \d}
\function{v=\c==1?x + \d}
\function{v=\c==-1?-x + \d}

/** produit ou quotient **/

\integer{cas=random(1,4)}
\text{listf=(\u)(\v),(\u)(\v),(\u)/(\v),(\v)/(\u)}
\rational{vi=\cas==3?\racv}
\rational{vi=\cas==4?\racu}
\function{\f=item(\cas,\listf)}


/** placer le terme ayant la plus petite racine en premier **/
/** cas = 1 :  u avant v  ; cas = 2 : v avant u  **/ 
\integer{rgerac=\racu<\racv?1:2}

/** ordonner les racines ; preparer les tests de signe **/
\rational{x1=\rgerac==1?\racu:\racv}
\rational{x2=\rgerac==1?\racv:\racu}
\rational{ug = evaluate(\u,x=\x1-1)}
\rational{um = evaluate(\u,x=(\x1+\x2)/2)}
\rational{ud = evaluate(\u,x=\x2+1)}
\rational{vg = evaluate(\v,x=\x1-1)}
\rational{vm = evaluate(\v,x=(\x1+\x2)/2)}
\rational{vd = evaluate(\v,x=\x2+1)}
\rational{fg = evaluate(\v,x=\x1-1)}
\rational{fm = evaluate(\v,x=(\x1+\x2)/2)}
\rational{fd = evaluate(\v,x=\x2+1)}

/** choix pour les barres et signes **/
\text{ch3=+,-}
\text{ch4=0,||,|}
\text{ch5=+,-}
\text{ch6=0,||,|}
\text{ch7=+,-}

\text{ch8=+,-}
\text{ch9=0,||,|}
\text{ch10=+,-}
\text{ch11=0,||,|}
\text{ch12=+,-}

\text{ch13=+,-}
\text{ch14=0,||,|}
\text{ch15=+,-}
\text{ch16=0,||,|}
\text{ch17=+,-}

/** bonnes  réponses **/
\rational{rep1=\x1}
\rational{rep2=\x2}
\text{rep3=\ug>0?1:2}
\text{rep4=\x1==\racu?1:3}
\text{rep5=\um>0?1:2}
\text{rep6=\x2==\racu?1:3}
\text{rep7=\ud>0?1:2}

\text{rep8=\vg>0?1:2}
\text{rep9=\x1==\racv?1:3}
\text{rep10=\vm>0?1:2}
\text{rep11=\x2==\racv?1:3}
\text{rep12=\vd>0?1:2}

\text{rep13=\rep3*\rep8==2?2:1}
\text{rep14=\cas>2  and \x1==\vi?2:1}
\text{rep15=\rep5*\rep10==2?2:1}
\text{rep16=\cas>2 and \x2==\vi?2:1}
\text{rep17=\rep7*\rep12==2?2:1}

\statement{
<p> De functie \(f) is gedefinieerd
\if{\cas<2}{in \RR }{ voor alle \(x) \in \RR uitgezonderd \(x = \vi), }
 door \(f(x) = \f)
 <p>
Maak het tekenverloop van \(f) &nbsp;in de tabel af.

<p align="center">
<table border=1 border="solid" width="80%">
<tr>
<td width="15%" align="center"> \(x)</td>
<td  width="25%" align="left">\(-\infty)</td>
<td  width="5%" align="center">\embed{reply1,3}</td>
<td width="25%" align="right"> </td>
<td  width="5%" align="center">\embed{reply2,3}</td>
<td width="25%" align="right">\(+\infty)</td>
</tr>
<tr>
<td width="15%" align="center"> \(\u)</td>
<td  width="25%" align="center">\embed{reply3}</td>
<td  width="5%" align="center">\embed{reply4}</td>
<td width="25%" align="center">\embed{reply5} </td>
<td  width="5%" align="center">\embed{reply6}</td>
<td width="25%" align="center">\embed{reply7}</td>
</tr>
<tr>
<td width="15%" align="center"> \(\v)</td>
<td  width="25%" align="center">\embed{reply8}</td>
<td  width="5%" align="center">\embed{reply9}</td>
<td width="25%" align="center">\embed{reply10} </td>
<td  width="5%" align="center">\embed{reply11}</td>
<td width="25%" align="center">\embed{reply12}</td>
</tr>
<tr>
<td width="15%" align="center"> \(f(x))</td>
<td  width="25%" align="center">\embed{reply13}</td>
<td  width="5%" align="center">\embed{reply14}</td>
<td width="25%" align="center">\embed{reply15} </td>
<td  width="5%" align="center">\embed{reply16}</td>
<td width="25%" align="center">\embed{reply17}</td>
</tr>
</table>
</p>
}
\answer{}{\rep1}{type=rational}
\answer{}{\rep2}{type=rational}
\answer{}{\rep3 ; \ch3}{type=menu}
\answer{}{\rep4 ; \ch4}{type=menu}
\answer{}{\rep5 ; \ch5}{type=menu}
\answer{}{\rep6 ; \ch6}{type=menu}
\answer{}{\rep7 ; \ch7}{type=menu}
\answer{}{\rep8 ; \ch8}{type=menu}
\answer{}{\rep9 ; \ch9}{type=menu}
\answer{}{\rep10 ; \ch10}{type=menu}
\answer{}{\rep11 ; \ch11}{type=menu}
\answer{}{\rep12 ; \ch12}{type=menu}
\answer{}{\rep13 ; \ch13}{type=menu}
\answer{}{\rep14 ; \ch14}{type=menu}
\answer{}{\rep15 ; \ch15}{type=menu}
\answer{}{\rep16 ; \ch16}{type=menu}
\answer{}{\rep17 ; \ch17}{type=menu}

\hint{
<ul>
<li><b>||</b> betekend: hier zijn geen geldige waarden gedefinieerd
<li><b>|</b> betekend: hier zijn wel geldige waarden
</ul>
<p>\(ax+b) wordt nul als \(x_0=-\frac{b}{a}) en verandert van teken in \(x_0). 
En heeft het teken van \(a) als \(x > x_0). </p>}
