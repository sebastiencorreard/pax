!set title=Lire un diagramme en boîte
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Premier Décile,Premier Quartile,Médiane,Troisième Quartile,Neuvième Décile
val7=Par lecture graphique, déterminer les indicateurs de cette série.
val8=On considère une série statistique dont voici le diagramme à moustaches.
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
tmp0=!randint $val9+5, 20

val10=$[rint($(tmp0))]
tmp0=!randint $val9+2, $val10-2

val11=$[rint($(tmp0))]
tmp0=!randint $val9+1, $val11-1

val12=$[rint($(tmp0))]
tmp0=!randint $val11+1, $val10-1

val13=$[rint($(tmp0))]
!readproc slib/stat/boxplot [$val9,$val10,600,150], [$val12,$val11,$val13],[f,f,f] 
tmp0=$slib_out
val14=$(tmp0)
replytype1=numexp
replyname1=$(val6[2])
replygood1=$val12
replytype2=numexp
replyname2=$(val6[3])
replygood2=$val11
replytype3=numexp
replyname3=$(val6[4])
replygood3=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8	<div class="wimscenter">	$val14	</div>	$val7	<table class="wimsborder wimscenter">	<tr><th>$(val6[2])</th><th>$(val6[3])</th><th>$(val6[4])</th></tr>	<tr><td> 
!read oef/embed.phtml reply1,4 
$()</td><td> 
!read oef/embed.phtml reply2,4 
$()</td><td> 
!read oef/embed.phtml reply3,4 
$()</td></tr>	</table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,14
embedcnt=3
