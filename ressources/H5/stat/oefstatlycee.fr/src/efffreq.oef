\title{Effectif et fréquence}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard} d'après un ex de Bernadette PERRIN-RIOU
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{1000}



\integer{n=randint(20..50)}
\integer{nmin=randint(30..40)}
\integer{neff=\nmin+4}
\text{liste1=slib(stat/random \n, \nmin,\neff)}
\text{liste2=wims(values x for x= \nmin to \neff+1)}
\text{E=slib(stat/effectif [\liste1],[\liste2])}
\text{E=item(1,\E)}
\text{E=wims(declosing \E)}

\text{m=slib(stat/arithmean [\liste1])}
\text{m=item(1,\m)}

\text{v=slib(stat/variance [\liste1])}
\text{v=item(1,\v)}

\text{F=slib(stat/freq [\liste1],[\liste2])}
\text{F=item(1,\F)}
\text{F=wims(declosing \F)}
\real{freq1=round(item(1,\F)*1000)/10}
\real{freq2=round(item(2,\F)*1000)/10}
\real{freq3=round(item(3,\F)*1000)/10}
\real{freq4=round(item(4,\F)*1000)/10}
\real{freq5=round(item(5,\F)*1000)/10}
\real{freqtot=\freq1+\freq2+\freq3+\freq4+\freq5}

\text{eff1=item(1,\E)}
\text{eff2=item(2,\E)}
\text{eff3=item(3,\E)}
\text{eff4=item(4,\E)}
\text{eff5=item(5,\E)}

\text{table=<table class="wimscenter wimsborder" style="background-color:skyblue">}

\integer{nn=ceil(\n/10)}
\for{i=0 to \nn-1}
 {\text{table=\table <tr>}
 \for{j=1 to 10}
 {\text{a=item(\i*10+\j,\liste1)}
\text{table=\table <td> \a </td>}
 }
\text{table=\table </tr>}
}
\text{table=\table </table>}
\real{a1=item(1,\liste2)}
\real{a2=item(2,\liste2)}
\real{a3=item(3,\liste2)}
\real{a4=item(4,\liste2)}
\real{a5=item(5,\liste2)}
\text{tableau=<table class="wimscenter wimsborder">}
\text{tableau=\tableau<tr><th> Ages </th>
<td> \a1 </td>
<td> \a2 </td>
<td> \a3 </td>
<td> \a4 </td>
<td> \a5 </td>
}
\text{tableau=\tableau</tr>}

\statement{Voici les âges recensés dans une population à la suite d'une étude:

\table
<p>
Compléter le tableau suivant
</p>
\tableau
<tr><th>Effectif</th>
<td>\embed{reply 1,8} </td>
<td>\embed{reply 2,8} </td>
<td>\embed{reply 3,8} </td>
<td>\embed{reply 4,8} </td>
<td>\embed{reply 5,8} </td>
</tr>

<tr><th>Fréquence</th>
<td>\embed{reply 6,8} </td>
<td>\embed{reply 7,8} </td>
<td>\embed{reply 8,8} </td>
<td>\embed{reply 9,8} </td>
<td>\embed{reply 10,8} </td>

</tr>
</table>
<div class="wims_instruction"> Arrondir les fréquences à
\(10^{-1}) près, le total des fréquences attendu est \freqtot.</div>

}

\answer{Effectif 1}{\eff1}{type=numeric}
\answer{Effectif 2}{\eff2}{type=numeric}
\answer{Effectif 3}{\eff3}{type=numeric}
\answer{Effectif 4}{\eff4}{type=numeric}
\answer{Effectif 5}{\eff5}{type=numeric}

\answer{Fréquence 1}{\freq1}{type=numeric}
\answer{Fréquence 2}{\freq2}{type=numeric}
\answer{Fréquence 3}{\freq3}{type=numeric}
\answer{Fréquence 4}{\freq4}{type=numeric}
\answer{Fréquence 5}{\freq5}{type=numeric}
