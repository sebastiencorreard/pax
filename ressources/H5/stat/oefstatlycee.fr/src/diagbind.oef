\title{Diagrammes en boite et indicateurs}
\language{fr}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

## couleur des grilles
\text{gridcolor=lightblue}

\integer{offset=random(0..10)*10}
\integer{offset5=\offset+5}
\integer{offset10=\offset+10}
\integer{offset15=\offset+15}
\integer{offset20=\offset+20}
### cadre générique ###
\text{cadre=
xrange -2,22
yrange -2,4
linewidth 2
segment 0,0,20,0,black
parallel 0,-0.1,0,0.1,1,0,20,black
parallel 0,-0.2,0,0.2,5,0,5,black
text black,0,-0.4,medium,\offset
text black,5,-0.4,medium,\offset5
text black,10,-0.4,medium,\offset10
text black,15,-0.4,medium,\offset15
text black,20,-0.4,medium,\offset20
}

## fin du cadre générique ##

## choix de la bonne série
## liste de séries ##
\integer{xim=random(1..15)}
\integer{xiM=random(\xim..20)}
\integer{Mie=random(\xim..\xiM)}
\integer{Qi1=random(\xim..\Mie)}
\integer{Qi3=random(\Mie..\xiM)}
\text{graphi=
\cadre
segment \xim,2,\Qi1,2,black
segment \Qi3,2,\xiM,2,black
segment \xim,1.8,\xim,2.2,black
segment \xiM,1.8,\xiM,2.2,black
polygon blue,\Qi1,1,\Qi3,1,\Qi3,3,\Qi1,3
segment \Mie,1.5,\Mie,2.5,red
}
    \integer{xmin=\xim+\offset}
    \integer{xmax=\xiM+\offset}
    \integer{Med=\Mie+\offset}
    \integer{Q1=\Qi1+\offset}
    \integer{Q3=\Qi3+\offset}
    \text{graph=\graphi}

####### enoncé de l'exo #######
\statement{
 On considère une série statistique dont on connait le diagramme en boîte suivant.
  Déterminez les indicateurs de cette série.
<div class="wimscenter"> \draw{200,200}{\graph}

  <table class="wimscenter wimsborder">
    <tr><th>Premier décile</th>
      <td>
        \embed{reply 1}
      </td></tr>
    <tr><th>Premier Quartile</th>
      <td>
        \embed{reply 2}
      </td></tr>
    <tr><th>Médiane</th>
      <td>
        \embed{reply 3}
      </td></tr>
    <tr><th>Troisième Quartile</th>
      <td>
        \embed{reply 4}
      </td></tr>
    <tr><th>Neuvième décile</th>
      <td>
        \embed{reply 5}
      </td></tr>
  </table>
  </div>

}
#### soumission de réponse ####
\reply{D1}{\xmin}{type=numeric}
\reply{Q1}{\Q1}{type=numeric}
\reply{MEd}{\Med}{type=numeric}
\reply{Q3}{\Q3}{type=numeric}
\reply{D9}{\xmax}{type=numeric}
