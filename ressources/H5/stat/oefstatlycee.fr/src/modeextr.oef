\title{Mode, étendue et valeurs extrêmes}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{1000}



\integer{n=randint(20..50)}
\text{listval=}
\integer{valmin=20}
\integer{xmax=\valmin}
\integer{valmax=50}
\integer{xmin=\valmax}
\integer{nbval=randint(5..10)}
\text{valposs=shuffle(\valmax-\valmin)}
\integer{imode=randint(1..\nbval)}
\text{listeff=}
\integer{efftotal=0}
\text{xlistval=}
\for{i=1 to \nbval}
{
 \integer{newval=\valposs[\i]+\valmin-1}
 \text{xlistval=wims(append item \newval to \xlistval)}}
\text{xlistval=wims(sort numeric list \xlistval)}
\for{i=1 to \nbval}
  {
   \if{\i=\imode}{\integer{eff=random(6..10)}
                   \integer{valmode=\xlistval[\i]}
                  }
      {\integer{eff=random(1..5)}}
   \integer{efftotal=\efftotal+\eff}
   \text{listeff=wims(append item \eff to \listeff)}
   \integer{val=\xlistval[\i]}
   \for{j=1 to \eff}
    {
     \text{listval=wims(append item \val to \listval)}
    }
   \integer{\xmin=\val<\xmin?\val}
   \integer{\xmax=\val>\xmax?\val}
  }

\text{slistval=shuffle(\listval)}
\integer{rangeval=\xmax - \xmin}
\text{table=<table class="wimsborder wimscenter" style="background-color:skyblue">}

\integer{nn=ceil(\efftotal/10)}
\for{i=0 to \nn-1}
 {\text{table=\table <tr>}
 \for{j=1 to 10}
 {\text{a=item(\i*10+\j,\slistval)}
\text{table=\table <td> \a </td>}
 }
\text{table=\table </tr>}
}
\text{table=\table </table>}
\text{tableau=<table class="wimsborder wimscenter">}
\text{tableau=\tableau<tr><th> Ages </th>}
\for{j=1 to \nbval}
{
 \text{tableau=\tableau<td> \xlistval[\j] </td>}
}
\text{tableau=\tableau</tr><tr><th>Effectif</th>}
\integer{eff1=\listeff[1]}
\integer{eff2=\listeff[2]}

\text{mstep = wims(makelist r x for x = 1 to \nbval+4)}
\text{mstep=wims(nospace \mstep)}

\nextstep{\mstep}

\statement{
Voici les âges recensés dans une population à la suite d'une étude:
\table
<p>
Compléter le tableau suivant
</p>
\tableau
 <td> \embed{reply 5,3} </td>
 <td> \embed{reply 6,3} </td>
 <td> \embed{reply 7,3} </td>
 <td> \embed{reply 8,3} </td>
 <td> \embed{reply 9,3} </td>
\if{\nbval>5}
{
 <td> \embed{reply 10,3} </td>
}
\if{\nbval>6}
{
 <td> \embed{reply 11,3} </td>
}
\if{\nbval>7}
{
 <td> \embed{reply 12,3} </td>
}
\if{\nbval>8}
{
 <td> \embed{reply 13,3} </td>
}
\if{\nbval>9}
{
 <td> \embed{reply 14,3} </td>
}
</tr></table>
<ol><li> Quelle est l'étendue de cette série: \embed{reply1,3}</li>
<li> Quelle est la valeur minimale:\embed{reply2,3}</li>
<li> Quelle est la valeur maximale:\embed{reply3,3}</li>
<li> Que vaut le mode:\embed{reply4,3}</li>
</ol>

}
\if{\step=2}{\text{mstep=}}

\answer{Etendue}{\rangeval}{type=numeric}
\answer{Valeur minimale}{\xmin}{type=numeric}
\answer{Valeur maximale}{\xmax}{type=numeric}
\answer{Mode}{\valmode}{type=numeric}

\answer{Effectif 1}{\listeff[1]}{type=numeric}
\answer{Effectif 2}{\listeff[2]}{type=numeric}
\answer{Effectif 3}{\listeff[3]}{type=numeric}
\answer{Effectif 4}{\listeff[4]}{type=numeric}
\answer{Effectif 5}{\listeff[5]}{type=numeric}
\answer{Effectif 6}{\listeff[6]}{type=numeric}
\answer{Effectif 7}{\listeff[7]}{type=numeric}
\answer{Effectif 8}{\listeff[8]}{type=numeric}
\answer{Effectif 9}{\listeff[9]}{type=numeric}
\answer{Effectif 10}{\listeff[10]}{type=numeric}
