\title{Médiane, quartiles, déciles et classes}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{1000}


\integer{n=randint(20..50)}
\text{listval=}
\integer{valmin=20}
\integer{xmax=\valmin}
\integer{valmax=50}
\integer{xmin=\valmax}
\integer{nbval=randint(5..10)}
\text{valposs=shuffle(\valmax-\valmin)}
\integer{imode=randint(1..\nbval)}
\text{listeff=}
\integer{efftotal=0}
\text{xlistval=}
\for{i=1 to \nbval}
{ 
 \text{xlistval=wims(append item \valposs[\i] to \xlistval)}}
\text{xlistval=wims(sort numeric list \xlistval)}
\for{i=1 to \nbval}
  {
   \if{\i=\imode}{\integer{eff=random(6..10)}
                   \integer{valmode=\xlistval[\i]}
                  }
      {\integer{eff=random(1..5)}}
   \integer{efftotal=\efftotal+\eff}
   \text{listeff=wims(append item \eff to \listeff)}
   \integer{val=\xlistval[\i]}
   \for{j=1 to \eff}
    {
     \text{listval=wims(append item \val to \listval)}
    }
   \integer{\xmin=\val<\xmin?\val}
   \integer{\xmax=\val>\xmax?\val}
  }
## Calcul des pourcentages
\text{listpct=}
\for{i=1 to \nbval}
{
\integer{pct=round(\listeff[\i]*10000/\efftotal)}
\real{pct2=\pct/100}
\text{listpct=wims(append item \pct2 to \listpct)}
}

\integer{bornesup=\xlistval[\nbval]+10}
\text{xlistval=wims(append item \bornesup to \xlistval)}
## Calcul des indicateurs
\integer{ecc=0}
\integer{Q1g=-1}
\integer{Q3g=-1}
\integer{D1g=-1}
\integer{D9g=-1}
\integer{Medg=-1}
\real{effMed=\efftotal/2}
\real{effQ1=\efftotal/4}
\real{effQ3=3*\efftotal/4}
\real{effD1=\efftotal/10}
\real{effD9=9*\efftotal/10}
\for{i=1 to \nbval}
 {
 \integer{ecc=\ecc+\listeff[\i]}
 \if{\ecc>\effD1 and \D1g<0}
   {
    \integer{D1g=\xlistval[\i]}
    \integer{D1d=\xlistval[\i+1]}
   }
 \if{\ecc>\effQ1 and \Q1g<0}
   {
    \integer{Q1g=\xlistval[\i]}
    \integer{Q1d=\xlistval[\i+1]}
   }
 \if{\ecc>\effMed and \Medg<0}
   {
   \integer{Medg=\xlistval[\i]}
   \integer{Medd=\xlistval[\i+1]}
   }
 \if{\ecc>\effQ3 and \Q3g<0}
   {
   \integer{Q3g=\xlistval[\i]}
   \integer{Q3d=\xlistval[\i+1]}
   }
 \if{\ecc>\effD9 and \D9g<0}
   {
    \integer{D9g=\xlistval[\i]}
    \integer{D9d=\xlistval[\i+1]}
   }
 }

\text{slistval=shuffle(\listval)}
\integer{rangeval=\xmax - \xmin}
\text{table=<table class="wimscenter wimsborder" style="background-color:skyblue">
	 <tr>}

\integer{nn=ceil(\efftotal/10)}
\for{i=0 to \nn-1}
 {\text{table=\table <tr>}
 \for{j=1 to 10}
 {\text{a=item(\i*10+\j,\slistval)}
\text{table=\table <td> \a </td>}
 }
\text{table=\table </tr>}
}
\text{table=\table </table>}
\text{crochg=&#91;}
\text{crochd=&#93;}
\text{ptvirg=&#59;}

\text{tableau=<table class="wimscenter wimsborder">}
\text{tableau=\tableau<tr><th> Ages </th>}
\for{j=1 to \nbval}
{
 \text{tableau=\tableau<td> \crochg \xlistval[\j] \ptvirg \xlistval[\j+1] \crochg
 </td>}
}
## choix effectif ou fréquence
\integer{choix=random(1,2)}
\if{\choix=1}
{
  \text{tableau=\tableau</tr><tr><th>Effectif</th>}
  \for{j=1 to \nbval}
  {
   \text{tableau=\tableau<td> \listeff[\j] </td>}
  }
}
{
  \text{tableau=\tableau</tr><tr><th>Fréquence en %</th>}
  \for{j=1 to \nbval}
  {
   \text{tableau=\tableau<td> \listpct[\j] </td>}
  }
}
\text{tableau=\tableau</tr></table>}


\statement{<p>
Voici les données d'une série statistique: </p>

\tableau

<ol><li> Quelle est la médiane de cette série: \crochg \embed{reply1,3};\embed{reply2,3} \crochg</li>
<li> Que vaut Q1:\crochg \embed{reply3,3};\embed{reply4,3} \crochg</li>
<li> Que vaut Q3:\crochg \embed{reply5,3};\embed{reply6,3} \crochg</li>
<li> Que vaut D1:\crochg \embed{reply7,3};\embed{reply8,3} \crochg</li>
<li> Que vaut D9:\crochg \embed{reply9,3};\embed{reply10,3} \crochg</li>
</ol>
}

\answer{Médiane borne gauche}{\Medg}{type=numeric}
\answer{Médiane borne droite}{\Medd}{type=numeric}
\answer{Q1 borne gauche}{\Q1g}{type=numeric}
\answer{Q1 borne droite}{\Q1d}{type=numeric}
\answer{Q3 borne gauche}{\Q3g}{type=numeric}
\answer{Q3 borne droite}{\Q3d}{type=numeric}
\answer{D1 borne gauche}{\D1g}{type=numeric}
\answer{D1 borne droite}{\D1d}{type=numeric}
\answer{D9 borne gauche}{\D9g}{type=numeric}
\answer{D9 borne droite}{\D9d}{type=numeric}
