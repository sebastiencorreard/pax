\title{Moyenne, variance et écart-type}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard} d'après un exo de Jean-jacques Kamdem Fodjo et Bernadette Perrin-Riou
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{100}

\integer{nb=6}
\integer{neff=random(10..25)}
\text{heure=wims(values x for x = 1 to 6)}

\text{eff=slib(stat/random \nb-2, 0,\neff)}
\real{S=slib(stat/sum \eff)}
\integer{i=100-\S}
\integer{j=random(0..\i)}
\text{eff=wims(append item \j to \eff)}
\integer{j=\i-\j}
\text{eff=wims(append item \j to \eff)}
\text{eff=shuffle(\eff)}

##text{moy=item(1,slib(stat/arithmean [\heure],[\eff]))}
\real{moy=0}
\for {i=1 to \nb}{
    \real{moy=\moy+\heure[\i]*\eff[\i]/100}
  }
\real{varian=0}
\for{i=1 to \nb}{
 \real{varian=\varian+\eff[\i]*(\heure[\i]-\moy)^2/100}
 }
\real{sigm=sqrt(\varian)}

\text{liste=wims(sort numeric item \eff)}
\text{maxi=item( -1 ,  \liste)}
\text{mini=item( 1 ,  \liste)}
\real{etendue=\maxi-\mini}
\real{S=slib(stat/sum \eff)}

\text{table=<table class="wimsborder wimscenter" style="background-color:skyblue;width:100px;">
	 <tr>}
\text{table=\table<th>Numéro </th>}

\for{a=1 to \nb}{
\text{table=\table <td> \a </td>}
}
\text{table=\table </tr><tr><th>Nombre de tirages </th>}

\for{i=1 to \nb}{

	\text{c=item(\i,\eff)}
	\text{table=\table <td> \c </td>}

	}
\text{table=\table </tr>
</table>}

\real{S=\S*0.5}
\real{M=item(1,\eff)}
\for{i=1 to \nb}{
\if{\M<\S}{\real{M=\M+item(\i+1,\eff)}
  \integer{m=\i}}
}


\statement{<p>On a lancé 100 fois un dé et on a noté les résultats obtenus</p>
 \table
<p>
Calculer pour cette série statistique:</p>
<ul><li> la moyenne : \embed{reply 1, 6}</li>
<li> la variance : \embed{reply 2, 6}</li>
<li> l'écart-type : \embed{reply 3, 6}</li>
</ul>
Les valeurs seront données au centième près.
}

\answer{Moyenne}{\moy}{type=numeric}
\answer{Variance}{\varian}{type=numeric}
\answer{Ecart-type}{\sigm}{type=numeric}
