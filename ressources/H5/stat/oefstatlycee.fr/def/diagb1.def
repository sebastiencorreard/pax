!set title=Diagrammes en boite I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
tmp0=!randint 0, 10

val7=$[rint($(tmp0)*10)]
val8=$[rint($val7+5)]
val9=$[rint($val7+10)]
val10=$[rint($val7+15)]
val11=$[rint($val7+20)]
val12=xrange -2,22	yrange -2,4	linewidth 2	segment 0,0,20,0,black	parallel 0,-0.1,0,0.1,1,0,20,black	parallel 0,-0.2,0,0.2,5,0,5,black	text black,0,-0.4,medium,$val7	text black,5,-0.4,medium,$val8	text black,10,-0.4,medium,$val9	text black,15,-0.4,medium,$val10	text black,20,-0.4,medium,$val11	
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
val14=
!for val15 =1 to 4 
tmp0=!randint 0, 15

val16=$[rint($(tmp0))]
tmp0=!randint $val16, 20

val17=$[rint($(tmp0))]
tmp0=!randint $val16, $val17

val18=$[rint($(tmp0))]
tmp0=!randint $val16, $val18

val19=$[rint($(tmp0))]
tmp0=!randint $val18, $val17

val20=$[rint($(tmp0))]
val21=$val12	segment $val16,2,$val19,2,black	segment $val20,2,$val17,2,black	segment $val16,1.8,$val16,2.2,black	segment $val17,1.8,$val17,2.2,black	polygon blue,$val19,1,$val20,1,$val20,3,$val19,3	segment $val18,1.5,$val18,2.5,red	
!if $val15=$val13 
val22=$[rint($val16+$val7)]
val23=$[rint($val17+$val7)]
val24=$[rint($val18+$val7)]
val25=$[rint($val19+$val7)]
val26=$[rint($val20+$val7)]
val27=$val21
!endif
!if $val15=1 
val28=$val21
!endif
!if $val15=2 
val29=$val21
!endif
!if $val15=3 
val30=$val21
!endif
!if $val15=4 
val31=$val21
!endif
!next
val32=
!if $val28=$val27 
tmp0=!append item 1 to $val32

val32=$(tmp0)
!endif
!if $val29=$val27 
tmp0=!append item 2 to $val32

val32=$(tmp0)
!endif
!if $val30=$val27 
tmp0=!append item 3 to $val32

val32=$(tmp0)
!endif
!if $val31=$val27 
tmp0=!append item 4 to $val32

val32=$(tmp0)
!endif
replytype1=radio
replyname1=\rep
replygood1=$val32;1,2,3,4
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	      <p>	      On considère une série statistique dont on connait les indicateurs.	      </p>	<table class="wimsborder wimscenter">	<tr><th>Premier décile</th><th>Neuvième décile</th><th>Médiane</th><th>Premier Quartile</th><th>Troisième Quartile</th></tr>	<tr><td>$val22</td><td>$val23</td><td>$val24</td><td>$val25</td><td>$val26</td></tr>	</table>	      <p>	      Indiquez dans la liste ci-dessous, le diagramme en boite de cette série.	      </p>		  <table  class="wimscenter wimsborder">	    <tr>	      <td>	         
!read oef/embed.phtml reply 1,1 
$()	      </td>	      <td>	         
!read oef/draw.phtml 200,200 \
$val28 
$()	      </td>	      <td>	         
!read oef/embed.phtml reply 1,2 
$()	      </td>	      <td>	         
!read oef/draw.phtml 200,200 \
$val29 
$()	      </td>	    </tr>	    <tr>	      <td>	         
!read oef/embed.phtml reply 1,3 
$()	      </td>	      <td>	         
!read oef/draw.phtml 200,200 \
$val30 
$()	      </td>	      <td>	         
!read oef/embed.phtml reply 1,4 
$()	      </td>	      <td>	         
!read oef/draw.phtml 200,200 \
$val31 
$()	      </td>	    </tr>	  </table>		
$()
!exit

