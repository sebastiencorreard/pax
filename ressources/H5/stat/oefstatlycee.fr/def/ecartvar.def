!set title=Moyenne, variance et écart-type
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=100

ansorder=r,r,r
varcnt=38
prevarcnt=37
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(6)]
tmp0=!randint 10, 25

val7=$[rint($(tmp0))]
tmp0=!values x for x = 1 to 6

val8=$(tmp0)
!readproc slib/stat/random $val6-2, 0,$val7 
tmp0=$slib_out
val9=$(tmp0)
!readproc slib/stat/sum $val9 
tmp0=$slib_out
val10=$[$(tmp0)]
val11=$[rint(100-$val10)]
tmp0=!randint 0, $val11

val12=$[rint($(tmp0))]
tmp0=!append item $val12 to $val9

val9=$(tmp0)
val12=$[rint($val11-$val12)]
tmp0=!append item $val12 to $val9

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val13=$[0]
!for val11 =1 to $val6 
val13=$[$val13+$(val8[$val11])*$(val9[$val11])/100]
!next
val14=$[0]
!for val11 =1 to $val6 
val14=$[$val14+$(val9[$val11])*($(val8[$val11])-$val13)^2/100]
!next
val15=$[sqrt($val14)]
tmp0=!sort numeric item $val9

val16=$(tmp0)
tmp0=!item  -1 of   $val16

val17=$(tmp0)
tmp0=!item  1 of   $val16

val18=$(tmp0)
val19=$[$val17-$val18]
!readproc slib/stat/sum $val9 
tmp0=$slib_out
val10=$[$(tmp0)]
val20=<table class="wimsborder wimscenter" style="background-color:skyblue;width:100px;">	  <tr>
val20=$val20<th>Numéro </th>
!for val21 =1 to $val6 
val20=$val20 <td> $val21 </td>
!next
val20=$val20 </tr><tr><th>Nombre de tirages </th>
!for val11 =1 to $val6 
tmp0=!item $val11 of $val9

val22=$(tmp0)
val20=$val20 <td> $val22 </td>
!next
val20=$val20 </tr>	</table>
val10=$[$val10*0.5]
tmp0=!item 1 of $val9

val23=$[$(tmp0)]
!for val11 =1 to $val6 
!if $val23<$val10 
tmp0=!item $val11+1 of $val9

val23=$[$val23+$(tmp0)]
val24=$[rint($val11)]
!endif
!next
replytype1=numeric
replyname1=Moyenne
replygood1=$[$val13]
replytype2=numeric
replyname2=Variance
replygood2=$[$val14]
replytype3=numeric
replyname3=Ecart-type
replygood3=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>On a lancé 100 fois un dé et on a noté les résultats obtenus</p>	 $val20	<p>	Calculer pour cette série statistique:</p>	<ul><li> la moyenne :  
!read oef/embed.phtml reply 1, 6 
$()</li>	<li> la variance :  
!read oef/embed.phtml reply 2, 6 
$()</li>	<li> l'écart-type :  
!read oef/embed.phtml reply 3, 6 
$()</li>	</ul>	Les valeurs seront données au centième près.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=20
embedcnt=3
