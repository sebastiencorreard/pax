rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=63
prevarcnt=62
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Intervallen,Totale frequentie,Histogram
val7=Gegeven is de onderstaande tabel	    met intervallen en de bijbehorende totale frequentie
val8=Bepaal het histogram, welke hoort bij de gegeven tabel.
tmp0=!randint 4, 7

val9=$[rint($(tmp0))]
tmp0=!randint 10, 20

val10=$[rint($(tmp0))]
tmp0=!randint 20, 90

val11=$[rint($(tmp0))]
!readproc slib/list/selshuf $val10,$val9 
tmp0=$slib_out
val12=$(tmp0)
tmp0=!sort numeric item $val12

val13=$(tmp0)
tmp0=!item $val9 of $val13

val14=$[rint($(tmp0)+1)]
tmp0=!replace  item number $val9 by $val14 in $val13

val13=$(tmp0)
!readproc slib/list/selshuf $val11,$val9-1 
tmp0=$slib_out
val15=$(tmp0)
!for val16 =1 to $val9-1 
tmp0=!item $val16 of $val15

val17=$(tmp0)
tmp0=!item $val16+1 of $val13

val18=$(tmp0)
tmp0=!item $val16 of $val13

val19=$(tmp0)
t_=!rawmath $val17*($val18-$val19)
val20=!exec pari print($t_)
!if $val16=1 
val21=$val20
!else
val21=$val21,$val20
!endif
!next
!readproc slib/stat/histo [$val15],[$val13],ytics 5,xtics 
tmp0=$slib_out
val22=$(tmp0)
tmp0=!randint 1, floor($val9/2)

val23=$[rint($(tmp0))]
tmp0=!randint floor($val9/2)+1, $val9-1

val24=$[rint($(tmp0))]
val25=$val15
tmp0=!item $val23 of $val15

t_=!rawmath $(tmp0)
val26=!exec pari print($t_)
t_=!rawmath $val26+10
val26=!exec pari print($t_)
tmp0=!item $val24 of $val15

t_=!rawmath $(tmp0)
val27=!exec pari print($t_)
t_=!rawmath max(0,$val27-10)
val27=!exec pari print($t_)
tmp0=!replace item number $val23 by $val26 in $val25

val25=$(tmp0)
tmp0=!replace item number $val24 by $val27 in $val25

val25=$(tmp0)
!readproc slib/stat/histo [$val25],[$val13],ytics 5,xtics 
tmp0=$slib_out
val28=$(tmp0)
val29=$val13
val30=$val15
val31=$[rint(0)]
val32=$[rint(0)]
!for val16 =1 to $val9-1 
!if $val31 =0 
tmp0=!item $val16 of $val13

val33=$(tmp0)
tmp0=!item $val16+1 of $val13

val34=$(tmp0)
!if $val34-$val33>1 
val32=$[rint($val33+1)]
tmp0=!item $val16 of $val15

t_=!rawmath $(tmp0)*($val34-$val33)
val35=!exec pari print($t_)
tmp0=!replace item number $val16 by $val32 in $val29

val29=$(tmp0)
tmp0=!replace item number $val16 by $val35 in $val30

val30=$(tmp0)
val31=$[rint(1)]
!endif
!endif
!next
!readproc slib/stat/histo [$val15],[$val29],ytics 5,xtics 
tmp0=$slib_out
val36=$(tmp0)
!readproc slib/stat/histo [$val21],[$val13],ytics 5,xtics 
tmp0=$slib_out
val37=$(tmp0)
val38=
val39=
!for val16 =1 to $val9-1 
tmp0=!item $val16 of $val13

val40=$(tmp0)
tmp0=!item $val16+1 of $val13

val41=$(tmp0)
tmp0=!item $val16 of $val15

t_=!rawmath $(tmp0)
val42=!exec pari print($t_)
tmp0=!append word <td>\($val40\leq x <$val41)</td> to $val38

val38=$(tmp0)
tmp0=!append word <td>$val42</td> to $val39

val39=$(tmp0)
!next
tmp0=!shuffle 4

val43=$(tmp0)
tmp0=!positionof item 1 in $val43

val44=$(tmp0)
val45=($val22),($val28),($val36),($val37)
tmp0=!item 1 of $val43

tmp1=!item $(tmp0) of $val45

val46=$(tmp1)
tmp0=!declosing $val46

val46=$(tmp0)
tmp0=!item 2 of $val43

tmp1=!item $(tmp0) of $val45

val47=$(tmp1)
tmp0=!declosing $val47

val47=$(tmp0)
tmp0=!item 3 of $val43

tmp1=!item $(tmp0) of $val45

val48=$(tmp1)
tmp0=!declosing $val48

val48=$(tmp0)
tmp0=!item 4 of $val43

tmp1=!item $(tmp0) of $val45

val49=$(tmp1)
tmp0=!declosing $val49

val49=$(tmp0)
replytype1=radio
replyname1=$(val6[3])
replygood1=$val44;A,B,C,D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

