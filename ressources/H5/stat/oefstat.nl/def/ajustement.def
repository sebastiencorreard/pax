 <div class='oef_feedbacks'>$val40:	<div class="wimscenter"> 
!read oef/draw.phtml 200,200 \
xrange -0.5,5	  yrange $val26-1,$val27+0.5	  hline 0,0,black	  vline 0,0, black	  plot red,$val36	  $val18 
$()	</div>	
$()</div>
!endif

!exit

:test

!exit

:stat
