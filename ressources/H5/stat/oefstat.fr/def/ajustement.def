val40=Una approssimazione di \(y) rispetto a \(x) di tipo,sembra adattarsi a questi dati
val41=Ecco in rosso una curva approssimante di tipo $(val38[$val10])
val42=Andamento
!endif

!ifval $val10=3
val26= -$val27/5
!endif
