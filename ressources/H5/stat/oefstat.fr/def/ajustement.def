val38=lineal, parabólico,exponencial,logarítmico
val39=Considere la siguiente nube de puntos&nbsp;
val40=La función de \(x) que mejor representa a \(y) parece ser de tipo,
val41=A continuación se muestra en rojo la curva de ajuste de tipo $(val38[$val10])
val42=Ajuste
!endif
!if $val37=ca 
val38=lineal, parabòlic, exponencial, logarítmic
val39=Considereu el següent núvol de punts&nbsp;
val40=La funció de \(x) que millor representa a \(y) sembla ser de tipus,
val41=A continuació es mostra en vermell la corba d'ajust de tipus $(val38[$val10])
val42=Ajust
!endif
!if $val37=it 
