tmp0=!randint 2, 4

val6=$[$(tmp0)]
tmp0=!randint 1, 4

val7=$[$(tmp0)]
tmp0=!random 3, 5

val8=$[$(tmp0)]
val9=y*x + z, $val8*x^2 + y*x + z,exp(y*x + z), ln((y*x + z))
tmp0=!itemcnt $val9

tmp1=!randint 1, $(tmp0)

val10=$(tmp1)

!ifval $val10<=3 
tmp0=!randitem 1,-1

val6=$[ $val6*$(tmp0)]
!endif
tmp0=!item $val10 of $val9

val11=$(tmp0)
val12=$[rint(100)]
!readproc slib/stat/random $val12,0,4,R 
tmp0=$slib_out
val13=$(tmp0)
!readproc slib/stat/random $val12,-0.8,0.8,R 
tmp0=$slib_out
val14=$(tmp0)
!readproc slib/stat/random $val12,-0.8,0.8,R 
tmp0=$slib_out
val15=$(tmp0)
val16=
val17=
val18=
!for val19 =1 to $val12 
tmp0=!item $val19 of $val13

val20=$(tmp0)
tmp0=!item $val19 of $val14

val21=$(tmp0)
tmp0=!item $val19 of $val15

val22=$(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val20) in $evaltmp
evaltmp=!mathsubst y=($val6+($val21)) in $evaltmp
evaltmp=!mathsubst z=($val7+($val22)) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
val16=$val16,$val23
!if $val10=2 
val24=$[$val23-$val8*($val20)^2]
val17=$val17,$val24
!endif
tmp0=!nonempty item $val16

val16=$(tmp0)
tmp0=!nonempty item $val17

val17=$(tmp0)
val18=$val18	disk $val20,$val23,3, blue 
!next
tmp0=!sort numeric items $val16

val25=$(tmp0)
tmp0=!item 1 of $val25

val26=$[$(tmp0)]
val26=$[min($val26,-1)]
tmp0=!item -1 of $val25

val27=$[$(tmp0)]

!ifval $val10=1
val28= $val16
!endif

!ifval $val10=2
val28= $val17
!endif

!ifval $val10=3
tmp0=!values log(x) for x in $val16

val28= $(tmp0)
!endif

!ifval $val10=4
tmp0=!values exp(x) for x in $val16

val28= $(tmp0)
!endif
!readproc slib/stat/covariance [$val13],[$val28] 
tmp0=$slib_out
tmp=!translate internal $	$ to ; in $(tmp0)

tmp=!row 1 of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp1)
val29=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val29

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)
val30=!translate internal $	\
$ to ;; in $tmp
tmp0=!item 2 of $val30

val29=$(tmp0)
tmp0=!item 1 of $val30

val31=$(tmp0)
!readproc slib/stat/arithmean [$val13] 
tmp0=$slib_out
tmp1=!item 1 of $(tmp0)

val32=$(tmp1)
!readproc slib/stat/arithmean [$val28] 
tmp0=$slib_out
tmp1=!item 1 of $(tmp0)

val33=$(tmp1)
val34=$[$val29/$val31]
val35=$[$val33-($val34)*($val32)]

!ifval $val10=1 
val36=!rawmath  $val34*x + $val35
!endif

!ifval $val10=2
val36=!rawmath  $val8*x^2 + ($val34)*x + ($val35)
!endif

!ifval $val10=3
val36=!rawmath  exp($val34*x + $val35)
!endif

!ifval $val10=4
val36=!rawmath  log($val34*x + $val35)
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val37=$(tmp0)
val38=linéaire, parabolique,exponentielle,logarithmique
val39=Soit le nuage de points suivant&nbsp;
val40=Un ajustement de \(y) en \(x) du type,semble être justifié
