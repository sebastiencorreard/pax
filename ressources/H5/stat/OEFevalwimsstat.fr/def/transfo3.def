!set title=Influence d'une transformation 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 80, 140

val6=$[$(tmp0)/10]
tmp0=!randint 200, 450

val7=$[$(tmp0)/100]
tmp0=!randint 2, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val8>0
val9=positif
!else
val9=négatif
!endif
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
val11=$[$val8*$val6+$val10]
val12=$[abs($val8)*$val7]
replytype1=numeric
replyname1=Moyenne
replygood1=$[$val11]
replytype2=numeric
replyname2=Ecart type
replygood2=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soit une série statistique 
!insmath (x_i)
$() de moyenne $val6 et d'écart type $val7.	On pose 
!insmath y_i=$val8 x_i+ $val10
$().</p>	<p>	Calculer la moyenne et l'écart type de la série 
!insmath (y_i)
$().	</p>	<ul>	<li><label for="reply1">Moyenne de 
!insmath (y_i)
$() =</label>  
!read oef/embed.phtml reply1,3 
$() </li>	<li><label for="reply1">Écart type de 
!insmath (y_i)
$() =</label>  
!read oef/embed.phtml reply2,3 
$() </li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10
embedcnt=2
