!set title=Effet de structure 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 18, 23

val6=$[rint($(tmp0))]
tmp0=!randint 60, 65

val7=$[rint($(tmp0))]
val8=$[rint(100-$val6-$val7)]
tmp0=!randint 8, 12

val9=$[$(tmp0)/10]
tmp0=!randint 20, 24

val10=$[$(tmp0)/10]
tmp0=!randint 50, 60

val11=$[$(tmp0)]
t_=!rawmath ($val6*$val9+$val7*$val10+$val8*$val11)/100
val12=!exec pari print($t_)
tmp0=!randint 50, 60

val13=$[rint($(tmp0))]
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
val15=$[rint(100-$val13-$val14)]
t_=!rawmath 3*($val13*$val9+$val15*$val10+$val14*$val11)/100
val16=!exec pari print($t_)
replytype1=numexp
replyname1=taux en France
replygood1=$val12
replytype2=numexp
replyname2=taux au pays imaginaire
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On étudie le taux de mortalité dans la population française:	</p>	<table class="wimsborder wimscenter">	<tr><th> Âge</th><th>- de 15 ans</th><th> 15-65 ans</th><th> + de 65 ans</th></tr>	<tr><th> Proportion en %</th><td> $val6</td><td> $val7 </td><td> $val8</td></tr>	<tr><th> taux de mortalité en %</th><td> $val9</td><td> $val10 </td><td> $val11 </td></tr>	</table>	<div>	<label for="reply1">Calculer le taux de mortalité moyen en France:</label>	   
!read oef/embed.phtml reply1,4 
$() %.	</div><div>	On imagine un pays dont le taux de mortalité serait le triple de celui de la France	pour chaque tranche d'âge et dont la répartition serait la suivante:	<table class="wimsborder wimscenter">	<tr><th> Âge</th><th>- de 15 ans</th><th> 15-65 ans</th><th> + de 65 ans</th></tr>	<tr><th> Proportion en %</th><td> $val13</td><td> $val15 </td><td> $val14</td></tr>	</table>	</div>	<div>	<label for="reply2">Calculer le taux de mortalité moyen de ce pays imaginaire:</label>	   
!read oef/embed.phtml reply2,4 
$() %.	</div>	
$()
!exit

