val41=$[rint(7)]
!else
val41=$[rint(12)]
!endif

!ifval $val42=3
val42=$[rint(5)]
!else
val42=$[rint(3)]
!endif
val40=$val40	 segment $(val19[$val15]),0,$(val19[$val15]),$(val11[$val15]),blue	 dsegment $val7-5,$(val11[$val15]),$(val19[$val15]),$(val11[$val15]),orange	 text black,$(val19[$val15]),-$val42,medium,$(val19[$val15])
!next
val41=$[12]
!for val15 =1 to $val34 

!ifval $val41=12
val41=$[rint(7)]
!else
val41=$[rint(12)]
!endif
val40=$val40	 text black,$val7-$val41,$(val33[$val15]),medium,$(val33[$val15])
