tmp0=!randint 20, 100

val6=$[rint($(tmp0))]
tmp0=!randint 0, $val6

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
val8=$[rint(2)]
tmp0=!randitem 3,4

val9=$[rint(2*$(tmp0)+$val8)]
tmp0=!randitem 100,200,400,500

val10=$[rint($(tmp0))]
val11=
val12=$[rint(0)]
val13=$[rint($val10/100)]
val14=$[rint(round($val10/($val9-$val13)))]
!for val15 =1 to $val9-$val13 
tmp0=!randint 5, $val14

val16=$[rint($(tmp0))]
val12=$[rint($val12+$val16)]
tmp0=!append item $val16 to $val11

val11=$(tmp0)
!next
!for val15 =1 to $val13-1 
val16=$[rint(($val10-$val12)/$val13)]
val12=$[rint($val12+$val16)]
tmp0=!append item $val16 to $val11

val11=$(tmp0)
!next
val16=$[rint($val10-$val12)]
tmp0=!append item $val16 to $val11

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
val17=
val18=$[rint($val7)]
val19=
val20=
val21=$[rint(0)]
val22=$[rint(0)]
val23=$[rint(0)]
val24=$[rint(0)]
tmp0=!append item $val18 to $val19

val19=$(tmp0)
!for val15 =1 to $val9 
val16=$[rint($(val11[$val15]))]
val21=$[rint($val21+$val16*$val18)]
val23=$[rint($val23+$val16*$val18^2)]
tmp0=!randitem 1,2,4

val25=$[rint($(tmp0))]
val18=$[rint($val18+$val25*10)]
val22=$[rint($val22+$val16*$val18)]
tmp0=!append item $val18 to $val19

val19=$(tmp0)
val26=$[$val16 / $val25]
tmp0=!append item $val26 to $val20

val20=$(tmp0)
!next
tmp0=!listuniq $val20

val27=$(tmp0)
tmp0=!sort numeric list $val27

val27=$(tmp0)
tmp0=!itemcnt $val27

val28=$[rint($(tmp0))]
val29=$[rint($(val27[$val28]))]
t_=!rawmath $val21/$val10
val30=!exec pari print($t_)
t_=!rawmath $val22/$val10
val31=!exec pari print($t_)
t_=!rawmath ($val30+$val31)/2
val32=!exec pari print($t_)
tmp0=!listuniq $val11

val33=$(tmp0)
tmp0=!sort numeric list $val33

val33=$(tmp0)
tmp0=!itemcnt $val33

val34=$[rint($(tmp0))]
val35=$[rint($(val33[$val34]))]
val36=$[$val21/$val10]
t_=!rawmath $val23 / $val10 - ($val36)^2
val23=!exec pari print($t_)
t_=!rawmath $val24 / $val10 - ($val32)^2
val24=!exec pari print($t_)
val37=$[sqrt($val23)]
val38=$[sqrt($val24)]
val36=$[round($val21*100/$val10)/100]
val32=$[round($val32*100)/100]
val24=$[round($val24*100)/100]
val23=$[round($val23*100)/100]
val37=$[round($val37*100)/100]
val38=$[round($val38*100)/100]
val7=$[rint($(val19[1]))]
val39=$[rint($(val19[$val9+1]))]
val40=xrange $val7-15,$val39+5	 yrange -10,$val35+5	 arrow $val7-5,0,$val39+5,0,10,black	 arrow $val7-5,-5,$val7-5,$val35+5,10,black	 segment $(val19[1]),0,$(val19[1]),$(val11[1]),blue	dsegment $val7-5,$(val11[1]),$(val19[1]),$(val11[1]),orange	text black,$(val19[1]),-5,medium,$(val19[1])	
val41=$[rint(12)]
val42=$[rint(5)]
