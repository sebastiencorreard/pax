!set title=Choix d'un indicateur 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mode,Médiane,Moyenne
val7=Valeur de la série ayant le plus grand effectif,	Valeur partageant la série en deux parties de même effectif,	Somme des valeurs de la série divisée par l'effectif total
val8=80x100x200
replytype1=correspond
replyname1=
replygood1=$val6;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Associer à chaque indicateur de position sa définition.	</p><div class="wimscenter"> 
!read oef/embed.phtml reply1,$val8 
$()</div>	
$()
!exit

