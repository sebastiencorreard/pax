tmp0=!randint 5, 15

val6=$[rint($(tmp0))]
tmp0=!randint 5, 20

val7=$[rint($(tmp0))]

!ifval $val6=$val7
tmp0=!randint 2, 5

val6=$[rint($val6+$(tmp0))]
!endif
t_=!rawmath ($val6+$val7)/2
val8=!exec pari print($t_)
t_=!rawmath $val6*0.8+$val7*0.2
val9=!exec pari print($t_)
t_=!rawmath $val7*0.8+$val6*0.2
val10=!exec pari print($t_)
