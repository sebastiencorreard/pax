val11=$[rint($(tmp0))]

!ifval $val6<$val7
val12=$[rint($val6)]
!else
val12=$[rint($val7)]
!endif

!ifval $val6<$val7
val13=$[rint($val7)]
!else
val13=$[rint($val6)]
!endif

!ifval $val11=1
tmp0=!randint $val12*10, $val13*10

val14=$[$(tmp0)/10]
!else
tmp1=!randint 10, $val12*10

val14=$[$(tmp1)/10]
!endif
