!set title=Choix d'un indicateur 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mode,Médiane,Moyenne
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
val8=9.10,8.5,10,9,3	11.66,11.5,7,8,1	7.89,9,10,8,2
val9=1,2,3,3,3,3,3,4,4,6,6.5,7,7,7,7,7.5,7.5,8,9,10,10,10,10,10,10,12,12,13,14,15,16.5,18,19,19,20	7,7,7,7,7,8,9.5,9.5,10,10.5,11,11,11.5,11.5,11.5,11.5,12,12,12,12.5,13,13.5,13.5,13.5,14,14.5,15,16,16.5,16.5,16.5	1,2,3,3,3,3,3,3.5,4,5,6.5,6.5,7,7,7,8,9,9,9,10,10,10,10,10,10,11.5,12,12,12,12,1,13.5,15
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]
val12=$[rint(0)]
!for val13 =1 to $val11 
val12=$[rint($val12+$(val10[$val13]))]
!next
val14=$[$val12/$val11]
val15=$[rint($val11/2)]

!ifval $val15*2=$val11
val15=$[rint(0)]
!else
val15=$[rint(1)]
!endif

!ifval $val15=0
val16=$[($(val10[$val11/2])+$(val10[$val11/2+1]))/2]
!else
val16=$[$(val10[($val11+1)/2])]
!endif
tmp0=!shuffle $val10

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val19=$[rint($(val18[5]))]
val20=$[rint($(val18[4]))]
val21=au dessus du mode, au dessus de la moyenne, au dessus de la médiane
val22=<table class="wimscenter wimsborder">	<caption>notes de la classe</caption>
val23=$[rint(ceil($val11/10))]
!for val13 =0 to $val23-1 
val22=$val22<tr>
!for val24 =1 to 10 
tmp0=!item $val13*10+$val24 of $val17

val25=$(tmp0)
val22=$val22 <td>$val25</td>
!next
val22=$val22 </tr>
!next
val22=$val22 </table>
replytype1=radio
replyname1=
replygood1=$val19;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Marc n'a obtenu que $val20 /20 à son contrôle de statistiques, les notes de la classe sont:	</p>	<div class="wimscenter">$val22</div>	<p>	 Pour annoncer positivement sa note à ses parents, quel indicateur Marc utilisera-t-il?</p>	Sa note est :  
