!set title=Calculer, interpréter une médiane 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=29
prevarcnt=18
postvarcnt=10
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 100

val6=$[rint($(tmp0))]
tmp0=!randint 0, 20

val7=$[rint($(tmp0))]
tmp0=!randitem 1,0

val8=$[rint($(tmp0))]
val8=$[rint(1)]
tmp0=!randint 4, 7

val9=$[rint(2*$(tmp0)+$val8)]
tmp0=!makelist x for x=$val7 to $val7+$val6

val10=$(tmp0)
tmp0=!shuffle $val6

val11=$(tmp0)
tmp0=!item 1 to $val9 of $val11

val11=$(tmp0)
tmp0=!item $val11 of $val10

val10=$(tmp0)
tmp0=!sort numeric list $val10

val12=$(tmp0)
val13=$val12
val7=$[rint($(val13[1]))]
val13=$val10
val14=<table class="wimsborder wimscenter"><tr>
!for val15 =1 to $val9 
val14=$val14 <td>$(val13[$val15])</td>
!next
val14=$val14 </tr></table>

!ifval $val8=1
val16=$[$(val12[($val9+1)/2])]
!else
val16=$[($(val12[$val9 / 2])+ $(val12[$val9 / 2 +1]))/2]
!endif
replytype1=numeric
replyname1=Médiane
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la série statistique suivante :	$val14	Déterminer la médiane de cette série :<div class="wimscenter">	<label for="reply1">Médiane :</label>  
!read oef/embed.phtml reply1,3 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val17=
val18=$[rint(0)]
val19=$[rint(-1)]
t_=!rawmath \efftotal/2
val20=!exec pari print($t_)
!for val15 =1 to $val9 
val18=$[rint($val18+\lsteff[$val15])]
!if $val18>$val20 and $val19=-1 
val19=$[rint($val15)]
!endif
tmp0=!append item $val18 to $val17

val17=$(tmp0)
!next
val16=$[rint($(val13[$val19]))]

!ifval $(val17[$val19-1])=$val20
t_=!rawmath ($(val13[$val19-1])+$(val13[$val19]))/2
val16=!exec pari print($t_)
!endif

!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,13,14,15
embedcnt=1
