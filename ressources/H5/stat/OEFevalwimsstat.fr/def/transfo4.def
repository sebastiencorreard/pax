!set title=Influence d'une transformation 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 80, 140

val6=$[$(tmp0)/10]
tmp0=!randint 200, 450

val7=$[$(tmp0)/100]
tmp0=!randint 2, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val8>0
val9=positif
!else
val9=négatif
!endif
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
val11=$[$val8*$val6+$val10]
val12=$[abs($val8)*$val7]
val13=!rawmath $val8*x+$val10
replytype1=function
replyname1=transformation
replygood1=!rawmath $val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	La moyenne de la classe à un devoir de mathématique est de $val6 et l'écart-type est de $val7.	</p><p>	 Quelle transformation affine de coefficient directeur $val9 faut-il appliquer à la série de notes	afin de se ramener à une moyenne de $val11 et à un écart-type de $val12?	</p><div>	<label for="reply1">Transformation affine:</label>  
!read oef/embed.phtml reply1 
$()	</div>	<i> Donner votre réponse sous la forme a*x+b</i>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,11,12
embedcnt=1
