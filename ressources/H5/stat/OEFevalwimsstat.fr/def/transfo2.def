!set title=Influence d'une transformation 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
val7=$[rint($val6^2)]
val8=$[rint($val7^2)]
val9=on augmente toutes les valeurs de la série de $val7,2,2,1,2,1,1	on diminue toutes les valeurs de la série de $val7,3,3,1,3,1,1	on multiplie toutes les valeurs de la série par $val7,4,4,4,4,5,4	
val10=ne change pas, augmente de $val7, diminue de $val7, est multiplié(e) par $val7, est multiplié(e) par $val8, est multiplié(e) par $val6
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val12=$(val11[1])
replytype1=menu
replyname1=Médiane
replygood1=$(val11[2]);$val10
replytype2=menu
replyname2=Q1
replygood2=$(val11[3]);$val10
replytype3=menu
replyname3=Q3-Q1
replygood3=$(val11[4]);$val10
replytype4=menu
replyname4=Moyenne
replygood4=$(val11[5]);$val10
replytype5=menu
replyname5=Variance
replygood5=$(val11[6]);$val10
replytype6=menu
replyname6=écart-type
replygood6=$(val11[7]);$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Que deviennent les indicateurs d'une série statistique lorsqu'$val12?	</p>	<ul>	<li> La médiane  
!read oef/embed.phtml reply1 
$()</li>	<li> Le premier quartile  
!read oef/embed.phtml reply2 
$()</li>	<li> L'intervalle interquartile  
!read oef/embed.phtml reply3 
$()</li>	<li> La moyenne  
!read oef/embed.phtml reply4 
$()</li>	<li> La variance  
!read oef/embed.phtml reply5 
$()</li>	<li> l'écart-type  
!read oef/embed.phtml reply6 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=6
