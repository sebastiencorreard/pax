!set title=Influence d'une transformation 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 8

tmp1=!randint 4, 8

tmp2=!randint 6, 12

tmp3=!randint 10, 15

tmp4=!randint 13, 18

tmp5=!randint 18, 24

tmp6=!randint 20, 28

tmp7=!randint 20, 28

tmp8=!randint 18, 24

tmp9=!randint 15, 20

tmp10=!randint 8, 15

tmp11=!randint 4, 10

val6=$(tmp0),$(tmp1),$(tmp2),$(tmp3),$(tmp4),$(tmp5),$(tmp6),$(tmp7),$(tmp8),$(tmp9),$(tmp10),$(tmp11)
val7=$[rint(0)]
!for val8 =1 to 12 
val7=$[rint($val7+$(val6[$val8]))]
!next
val9=$[$val7/12]
val7=$[rint(0)]
!for val8 =1 to 12 
val7=$[rint($val7+($(val6[$val8])-$val9)^2)]
!next
val10=$[sqrt($val7/12)]
val9=$[round($val9*10)/10]
val10=$[round($val10*10)/10]
val11=$[1.8*$val9+32]
val11=$[round($val11*10)/10]
val12=$[1.8*$val10]
val12=$[round($val12*10)/10]
replytype1=numeric
replyname1=Moyenne
replygood1=$[$val9]
replytype2=numeric
replyname2=Écart type
replygood2=$[$val10]
replytype3=numeric
replyname3=Nouvelle moyenne
replygood3=$[$val11]
replytype4=numeric
replyname4=Nouvel écart type
replygood4=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On a relevé les températures d'une ville de France le premier jour	 de chaque mois pendant une année.<br>	 Le tableau est exprimé en degré Celsius.</p>	<table class="wimscenter wimsborder">	<tr><th>Janvier</th><th>Février</th><th>Mars</th><th>Avril</th><th>Mai</th><th>Juin</th></tr>	<tr>	 
!for m_i=1 to 6 
$() <td>$(val6[$m_i])</td>  
!next
$()	</tr>	<tr><th>Juillet</th><th>Août</th><th>Septembre</th><th>Octobre</th><th>Novembre</th><th>Décembre</th></tr>	<tr>	 
!for m_i=7 to 12 
$() <td>$(val6[$m_i])</td>  
!next
$()	</tr></table>	<p>Calculer la moyenne et l'écart type de cette série:</p>	<ul>	<li> <label for="reply1">Moyenne =</label>  
!read oef/embed.phtml reply1,3 
$() <i> arrondie à 0.1 près</i></li>	<li> <label for="reply2">Écart type =</label>  
!read oef/embed.phtml reply2,3 
$() <i> arrondi à 0.1 près</i></li>	</ul><p>	Si les mesures avaient été faites par des anglais,	ils auraient exprimé les résultats en degré Fahrenheit.<br>	 La formule de conversion est 
!insmath \;T_F\;=\; 1.8t_c+32
$().<br>	Calculer la moyenne et l'écart type des températures en degré Fahrenheit.</p>	<ul>	<li><label for="reply3">Nouvelle moyenne = </label> 
!read oef/embed.phtml reply3,3 
$() <i> arrondie à 0.1 près</i></li>	<li><label for="reply4">Nouvel écart type = </label> 
!read oef/embed.phtml reply4,3 
$() <i> arrondi à 0.1 près</i></li>	</ul>	
$()
!exit

