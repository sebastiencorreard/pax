val31=xrange $val7-5,$(val9[5])+15	 yrange -5,$(val26[4])+3	 segment $(val9[1]),0,$(val9[2]),$(val26[1]),orange	 segment $(val9[2]),$(val26[1]),$(val9[3]),$(val26[2]),orange	 segment $(val9[3]),$(val26[2]),$(val9[4]),$(val26[3]),orange	 segment $(val9[4]),$(val26[3]),$(val9[5]),$(val26[4]),orange	 dpolyline orange,$val7,$(val26[1]),$(val9[2]),$(val26[1]),$(val9[2]),0	 dpolyline orange,$val7,$(val26[2]),$(val9[3]),$(val26[2]),$(val9[3]),0	 dpolyline orange,$val7,$(val26[3]),$(val9[4]),$(val26[3]),$(val9[4]),0	 dpolyline orange,$val7,$(val26[4]),$(val9[5]),$(val26[4]),$(val9[5]),0	 text black,$(val9[2]),$(val26[1])+1,small,$(val26[1])	 text black,$(val9[3]),$(val26[2])+1,small,$(val26[2])	 text black,$(val9[4]),$(val26[3])+1,small,$(val26[3])	 text black,$(val9[5]),$(val26[4])+1,small,$(val26[4])	 arrow $val7-5,0,$(val9[5])+5,0,10,black	 arrow $val7,-1,$val7,$(val26[4])+3,10,black	 text black,$(val9[1]),-1,small,$(val9[1])	 text black,$(val9[2]),-1,small,$(val9[2])	 text black,$(val9[3]),-1,small,$(val9[3])	 text black,$(val9[4]),-1,small,$(val9[4])	 text black,$(val9[5]),-1,small,$(val9[5])	
