!readproc oef/draw.phtml 300,300 \
$val26 
tmp0=$ins_url
val29=$(tmp0)
val29=<img src='$val29' alt=''>
tmp0=!append item $val29 to $val28

val28=$(tmp0)
!readproc oef/draw.phtml 300,300 \
$val27 
tmp0=$ins_url
val29=$(tmp0)
val29=<img src='$val29' alt=''>
tmp0=!append item $val29 to $val28

val28=$(tmp0)
replytype1=radio
replyoption1=shuffle 
replyname1=histogramme
replygood1=1;$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère une série statistique donnée par son tableau d'effectifs :	<div class="wimscenter"> $val17 </div>	<p>	Cocher l'histogramme correspondant à cette série:	</p>	<table class="wimscenter wimsnoborder">	<tr>	 <td> 
