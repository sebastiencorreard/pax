!set title=Choix d'un indicateur 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mode,Médiane,Moyenne
val7=La moitié de la classe a eu plus de 11 au dernier contrôle de Maths.,2	En France&#44; plus de la moitié des candidats à l'examen du code de la route pour le permis de conduire font moins de quatre fautes.,2	Sur une année&#44; le nombre de sorties par jour des pompiers d'une caserne dans la région parisienne est de 2.,3	En France&#44; lors du recensement de 1999&#44; on a dénombré au moins deux enfants dans plus de la moitié des familles.,2	Un coureur cycliste qui a parcouru 60 km en 90 min&#44; a atteint ou dépassé par moment la vitesse de 40 km/h.,3	L'élection de Miss France a été remportée par la candidate de Picardie.,1	Le seul joueur du loto ayant trouvé les 6 bons numéros est un habitant de Nice.,1	
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$(val8[1])
val10=$[rint($(val8[2]))]
replytype1=radio
replyname1=
replygood1=$val10;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Quel est l'indicateur de position concerné dans le texte ci-dessous:	<p>	$val9	</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

