val23=$[rint(0)]
val24=$[rint(-1)]
t_=!rawmath $val14/2
val25=!exec pari print($t_)
!for val19 =1 to $val9 
val23=$[rint($val23+$(val15[$val19]))]
!if $val23>$val25 and $val24=-1 
val24=$[rint($val19)]
!endif
tmp0=!append item $val23 to $val22

val22=$(tmp0)
!next
