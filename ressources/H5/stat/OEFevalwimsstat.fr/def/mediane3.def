!for val19 =1 to $val9-$val17 
tmp0=!randint 5, $val18

val20=$[rint($(tmp0))]
val16=$[rint($val16+$val20)]
tmp0=!append item $val20 to $val15

val15=$(tmp0)
!next
!for val19 =1 to $val17-1 
val20=$[rint(($val14-$val16)/$val17)]
val16=$[rint($val16+$val20)]
tmp0=!append item $val20 to $val15

val15=$(tmp0)
!next
