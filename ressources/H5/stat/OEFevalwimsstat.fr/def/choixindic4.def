!set title=Choix d'un indicateur 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mode,Médiane,Moyenne
tmp=!trim 5,8,9,10,10,10	3,3,6,14,16,17	7,7,7,8,18,18
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 3

val8=$(tmp0)
tmp0=!positionof item 1 in $val8

val9=$[rint($(tmp0))]
tmp0=!positionof item 3 in $val8

val10=$[rint($(tmp0))]
tmp0=!positionof item 2 in $val8

val11=$[rint($(tmp0))]
replytype1=radio
replyname1=mode
replygood1=$val9;A,B,C
replytype2=radio
replyname2=moyenne
replygood2=$val10;A,B,C
replytype3=radio
replyname3=médiane
replygood3=$val11;A,B,C
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	Voici 3 séries à comparer:</p>	<table class="wimscenter wimsborder">	<tr><th>série A:</th><td>$(val7[$(val8[1]);])</td></tr>	<tr><th>série B:</th><td>$(val7[$(val8[2]);])</td></tr>	<tr><th>série C:</th><td>$(val7[$(val8[3]);])</td></tr>	</table>	<ul>	<li>Quelle série a le mode le plus élevé?  
!read oef/embed.phtml reply1 
$()</li>	<li>Quelle série a la moyenne la plus élevée?  
!read oef/embed.phtml reply2 
$()</li>	<li>Quelle série a la médiane la plus élevée?  
!read oef/embed.phtml reply3 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=3
