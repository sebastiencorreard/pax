!set title=Influence d'une transformation 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 20

val6=$[rint($(tmp0))]
tmp0=!randint 1, $val6-1

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=$[rint($val6-$val7)]
val10=$[rint($val8+1)]
val11=La médiane ne change pas, La médiane change, La moyenne ne change pas, La moyenne change, Le mode ne change pas, Le mode change
val12=On rajoute une valeur au dessus et une valeur en dessous de $val6,1	On rajoute une valeur égale à $val8 et une valeur égale à $val9,1,3	On rajoute une valeur égale à $val10 et une valeur égale à $val9,1,4	On rajoute une valeur égale à $val6,1,3,5	On retire une valeur égale à $val6,3	On retire une valeur au dessus et une valeur en dessous de $val6,1,5	
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$(val13[1])
tmp0=!item 2 to -1 of $val13

val15=$(tmp0)
replytype1=checkbox
replyname1=Affirmations vraies
replygood1=$val15;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère une série statistique dont le mode, la médiane et la moyenne	ont pour valeur $val6.	$val14	</p><p>	Cocher la ou les propositions que l'on peut affirmer:	</p>	<ul> 
!for m_j=1 to 6 
$()<li> 
!read oef/embed.phtml reply1,\j 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,14
embedcnt=1
