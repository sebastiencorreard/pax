!set title=Moyenne mobile 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Janvier,Février,Mars,Avril,Mai,Juin,Juillet,Aôut,Septembre,Octobre,Novembre,Décembre
val7=Jan.,Fév.,Mars,Avril,Mai,Juin,Juil.,Août,Sept.,Oct.,Nov.,Déc.
val8=10,8,8,14,18,20,24,23,20,18,14,12
val9=
!for val10 =1 to 12 
tmp0=!randitem -1,-0.5,0,0.5,1

val11=$[$(tmp0)]
val12=$[$(val8[$val10])+$val11]
tmp0=!append item $val12 to $val9

val9=$(tmp0)
!next
val13=&nbsp;,&nbsp;
!for val14 =2 to 11 
t_=!rawmath ($(val9[$val14-1])+$(val9[$val14])+$(val9[$val14+1]))/3
val15=!exec pari print($t_)
val15=$[round(10*$val15)/10]
tmp0=!append item $val15 to $val13

val13=$(tmp0)
!next
val13=$val13,&nbsp;,&nbsp;
val16=<table class="wimscenter wimsborder">	<tr><th>Mois</th>	
!for val14 =1 to 12 
val16=$val16<td> $(val7[$val14]) </td>
!next
tmp0=!randint 10, 20

val17=$[rint($(tmp0))]
val18=$[rint($val17-2)]
val19=$[rint($val17-4)]
val20=$[rint($val17-6)]
replytype1=numeric
replyname1=ordre 3
replygood1=$[$val18]
replytype2=numeric
replyname2=ordre 5
replygood2=$[$val19]
replytype3=numeric
replyname3=ordre 7
replygood3=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère une série statistiques comportant $val17 valeurs.</p>	Combien de valeurs comportent les séries de moyennes mobiles:	<ul>	<li> <label for="reply1">d'ordre 3:</label>  
!read oef/embed.phtml reply1,4 
$()</li>	<li> <label for="reply2">d'ordre 5:</label>  
!read oef/embed.phtml reply2,4 
$()</li>	<li> <label for="reply3">d'ordre 7:</label>  
!read oef/embed.phtml reply3,4 
$()</li>	</ul>	
$()
!exit

