\text{verbe=\rep>\b?augmente:baisse}
\real{x=\rep>\b?\rep-\b:\b-\rep}
\real{x=round(\x*10)/10}
\integer{d=\rep>\b?(\a+1)*(\b+\x)-\a*\b:(\a+1)*(\b-\x)-\a*\b}
