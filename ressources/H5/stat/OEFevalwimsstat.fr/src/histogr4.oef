\title{Histogramme à pas variable 4}

%% Construction de la série
%% Choix des amplitudes
\text{lstlarg=1,1,2,2,3,3,4,4}
\text{lstlarg=shuffle(\lstlarg)}
%% choix de la valeur de départ
\integer{xmin=randint(10,50,80,100)}
\integer{tl=randint(5,10,20)}
%% Construction des classes
\text{xval=\xmin}
\for{i=1 to 4}
 {
 \integer{x=\xval[\i]+\tl*\lstlarg[\i]}
 \text{xval=wims(append item \x to \xval)}
 }
%% choix des effectifs
\text{lsteff=}
\integer{effcum=0}
\for{i=1 to 4}{
  \integer{eff=randint(1..5)*6}
  \integer{effcum=\effcum+\eff}
  \text{lsteff=wims(append item \eff to \lsteff)}
}
\text{effl=wims( sort numeric list \lsteff)}
\integer{effmax=\effl[4]}
%% Construction du tableau de la série
\text{tableau=<table class="wimscenter wimsborder">
<tr><td>Classes</td>}
\for{i=1 to 4}{
  \text{tableau=\tableau<td> &#91; \xval[\i];\xval[\i+1] &#91; </td>}
}
\text{tableau=\tableau</tr><tr><td>Effectifs</td>}
\for{i=1 to 4}{
  \text{tableau=\tableau<td> \lsteff[\i]</td>}
}
\text{tableau=\tableau</tr></table>}
%% Construction des hauteurs
\text{h=}
\for{i=1 to 4}{
  \rational{h1=\lsteff[\i]/\lstlarg[\i]}
  \text{h=wims(append item \h1 to \h)}
}
%% liste des classes
\text{lstcla=}
\for {i=1 to 4}{
  \text{classe=&#91; \xval[\i] &#59; \xval[\i+1] &#91;}
  \text{lstcla=wims(append item \classe to \lstcla)}
}
%% classe modale
\text{hl=wims(sort numeric list \h)}
\text{clmod=position(\hl[4],\h)}
%% Construction du dessin
\text{dessin=
 xrange \xmin-5,\xval[5]+5
 yrange -5,\effmax+3
 rectangle \xval[1],0,\xval[2],\h[1],orange
 rectangle \xval[2],0,\xval[3],\h[2],orange
 rectangle \xval[3],0,\xval[4],\h[3],orange
 rectangle \xval[4],0,\xval[5],\h[4],orange
 text black,(\xval[1]+\xval[2])/2,\h[1]+1,small,\h[1]
 text black,(\xval[2]+\xval[3])/2,\h[2]+1,small,\h[2]
 text black,(\xval[3]+\xval[4])/2,\h[3]+1,small,\h[3]
 text black,(\xval[4]+\xval[5])/2,\h[4]+1,small,\h[4]
 arrow \xmin-5,0,\xval[5]+5,0,10,black
 arrow \xmin,-1,\xmin,\effmax+3,10,black
 text black,\xval[1],-1,small,\xval[1]
 text black,\xval[2],-1,small,\xval[2]
 text black,\xval[3],-1,small,\xval[3]
 text black,\xval[4],-1,small,\xval[4]
 text black,\xval[5],-1,small,\xval[5]
}

\text{baddessin1=
 xrange \xmin-5,\xmin+50
 yrange -5,\effmax+3
 rectangle \xmin,0,\xmin+10,\h[1],orange
 rectangle \xmin+10,0,\xmin+20,\h[2],orange
 rectangle \xmin+20,0,\xmin+30,\h[3],orange
 rectangle \xmin+30,0,\xmin+40,\h[4],orange
 text black,\xmin+5,\h[1]+1,small,\h[1]
 text black,\xmin+15,\h[2]+1,small,\h[2]
 text black,\xmin+25,\h[3]+1,small,\h[3]
 text black,\xmin+35,\h[4]+1,small,\h[4]
 arrow \xmin-5,0,\xmin+40+5,0,10,black
 arrow \xmin,-1,\xmin,\effmax+3,10,black
 text black,\xmin,-1,small,\xval[1]
 text black,\xmin+10,-1,small,\xval[2]
 text black,\xmin+20,-1,small,\xval[3]
 text black,\xmin+30,-1,small,\xval[4]
 text black,\xmin+40,-1,small,\xval[5]
}
\text{baddessin2=
 xrange \xmin-5,\xval[5]+15
 yrange -5,\effmax+3
 rectangle \xval[1],0,\xval[2],\lsteff[1],orange
 rectangle \xval[2],0,\xval[3],\lsteff[2],orange
 rectangle \xval[3],0,\xval[4],\lsteff[3],orange
 rectangle \xval[4],0,\xval[5],\lsteff[4],orange
 text black,(\xval[1]+\xval[2])/2,\h[1]+1,small,\lsteff[1]
 text black,(\xval[2]+\xval[3])/2,\h[2]+1,small,\lsteff[2]
 text black,(\xval[3]+\xval[4])/2,\h[3]+1,small,\lsteff[3]
 text black,(\xval[4]+\xval[5])/2,\h[4]+1,small,\lsteff[4]
 arrow \xmin-5,0,\xval[5]+5,0,10,black
 arrow \xmin,-1,\xmin,\effmax+3,10,black
 text black,\xval[1],-1,small,\xval[1]
 text black,\xval[2],-1,small,\xval[2]
 text black,\xval[3],-1,small,\xval[3]
 text black,\xval[4],-1,small,\xval[4]
 text black,\xval[5],-1,small,\xval[5]
}
\text{baddessin3=
 xrange \xmin-5,\xmin+40+15
 yrange -5,\effmax+3
 rectangle \xmin,0,\xmin+10,\lsteff[1],orange
 rectangle \xmin+10,0,\xmin+20,\lsteff[2],orange
 rectangle \xmin+20,0,\xmin+30,\lsteff[3],orange
 rectangle \xmin+30,0,\xmin+40,\lsteff[4],orange
 text black,\xmin+5,\h[1]+1,small,\lsteff[1]
 text black,\xmin+15,\h[2]+1,small,\lsteff[2]
 text black,\xmin+25,\h[3]+1,small,\lsteff[3]
 text black,\xmin+35,\h[4]+1,small,\lsteff[4]
 arrow \xmin-5,0,\xmin+40+5,0,10,black
 arrow \xmin,-1,\xmin,\effmax+3,10,black
 text black,\xmin,-1,small,\xval[1]
 text black,\xmin+10,-1,small,\xval[2]
 text black,\xmin+20,-1,small,\xval[3]
 text black,\xmin+30,-1,small,\xval[4]
 text black,\xmin+40,-1,small,\xval[5]
}

