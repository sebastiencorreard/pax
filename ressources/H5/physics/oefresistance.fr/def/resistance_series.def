!set title=Résistance équivalente en serie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Romain, Minne
email=romain.minne@wanadoo.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(0)]
tmp0=!random 10, 100

val7=$[$(tmp0)]
tmp0=!random 10, 100

val8=$[$(tmp0)]
val9=$[round($val7*1)/1]
val10=$[round($val8*1)/1]
val11=$[round(($val9+$val10)*10)/10]
replytype1=sigunits
replyname1=Calculer la valeur de la résistance R
replygood1=$val11 ohm
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la résistance équivalente de résistors montés	en série. On utilise pour cela deux résistors R<sub>1</sub>=$val9 $m_Omega et R<sub>2</sub>=$val10 $m_Omega.	<div class="wims_instruction">	ATTENTION: On tiendra compte des unités.<br>	Le symbole $m_Omega est absent du clavier : utilisez simplement les lettres "ohm".	</div>		
!if $val6=1 
$()	<h3>debug mode</h3>	Réponses : R = $val11 ohm	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,11
embedcnt=0
