!set title=Résistance équivalente en dérivation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Romain, Minne
email=romain.minne@wanadoo.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(0)]
tmp0=!randint 20, 100

val7=$[rint($(tmp0))]
tmp0=!randint 20, 100

val8=$[rint($(tmp0))]
val9=$[round((1/$val7+1/$val8)*1000)/1000]
val10=$[round(1/$val9)]
replytype1=sigunits
replyname1=Calculer la valeur de la conductance G
replygood1=$val9 S#2
replytype2=sigunits
replyname2=Calculer la valeur de la résistance R
replygood2=$val10 ohm#2
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la résistance équivalente de résistors montés en dérivation.	On utilise pour cela deux résistors R<sub>1</sub>=$val7 $m_Omega et R<sub>2</sub>=$val8 $m_Omega.	<div class="wims_instruction">	ATTENTION: on tiendra compte des chiffres	significatifs et des unités.<br>	Le symbole $m_Omega est absent du clavier : utilisez simplement les lettres "ohm".	</div>		
!if $val6=1 
$()	<h3>debug mode</h3>	Réponses : G = $val9 S, R = $val10 ohm	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=0
