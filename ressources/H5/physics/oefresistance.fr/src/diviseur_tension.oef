\title{Diviseur de tension}
\language{fr}
\range{-5..5}
\author{Romain, Minne}
\email{romain.minne@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{debug=1}


#calcul des coefficients
\integer{x1=random(1..10)}
\integer{x2=random(1..5)}
\integer{x3=\x1+\x2}
#calcul du diviseur
\integer{R1=random(20..100)}
\integer{R2=random(20..100)}
\real{U1=random(1..10)}
\real{Ue=round(\U1*100)/100}
\real{Us=\Ue*\R2/(\R1+\R2)}
\real{soluce=round(\Us*10)/10}

\text{circ=slib(circuits/draw 3/div1,20,black,res2 R1,res2 R2,)}
\text{liste=\(Us=Ug*(R\x3)/(R\x1+R\x3)),\(Ug=Us*(R\x1)/(R\x3+R\x1)),\(Us=Ug*(R\x1)/(R\x1+R\x3)),\(Ug=Us*(R\x1)/(R\x2+R\x3))}

\text{ good=\liste }
\text{ cnt = items(\good) }
\text{ mix = shuffle(\cnt) }
\matrix{ good= \good[\mix] }
\text{ rep = position(1,\mix) }

\text{reponse=1}

\steps{r1
r2}

\statement{Un élève réalise le montage suivant :
\draw{200,200}{
new 300,220
xrange -4,8
yrange 0,11
transparent white
linewidth 7
points black,2,1,2,6
linewidth 1
polyline black,-1,10,2,10,2,9
polyline black,2,7,2,5,2,6,4,6
segment 5.5,1,-1,1,black
segment 2,1,2,3,black
trange 0,1
affine 0,-(1),1,0,2,8
parallel -1,0,-0.75,0,1.75,0,2,black
rectangle -0.75,-0.5,0.75,0.6,black
affine 0,-1,1,0,2,8
killaffine
text black,2.25,9.5,large," R\x1 = \R1 ohms"
affine 0,-(1),1,0,2,4
parallel -1,0,-0.75,0,1.75,0,2,black
rectangle -0.75,-0.5,0.75,0.6,black
affine 0,-1,1,0,2,4
killaffine
text black,2.5,3,large," R\x3 = \R2 ohms"
killaffine
text black,-3.5,5.5,large,"Ug = \Ue V"
text black,5.5,4.5,large,"Us"
arrow 0,1,0,10,8, black
arrow 5,1,5,6,8, black}
<br>
\if{\step=1}{
Choisir l'expression littérale du diviseur de tension liant Us
aux autres grandeurs&nbsp;:
<br>
\embed{ reply 1 }
}
\if{\step=2}{
Calculer la valeur de la tension de sortie:
\embed{ reply 2 }
}
\if{\debug=0}{
<h3>soluce mode</h3>
La réponse est \good[\rep]
}
}
\answer{la bonne réponse est}{\rep;\good}{type=radio}
\answer{Us=}{\soluce V}{type=units}
