\title{Résistance équivalente en dérivation}
\language{fr}
\range{-5..5}
\author{Romain, Minne}
\email{romain.minne@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{debug=0}
\integer{x1=random(20..100)}
\integer{x2=random(20..100)}
\real{G=round((1/\x1+1/\x2)*1000)/1000}
\real{R=round(1/\G)}
\statement{Calculer la résistance équivalente de résistors montés en dérivation.
On utilise pour cela deux résistors R<sub>1</sub>=\x1 \Omega et R<sub>2</sub>=\x2 \Omega.
<div class="wims_instruction">
ATTENTION: on tiendra compte des chiffres
significatifs et des unités.<br>
Le symbole \Omega est absent du clavier : utilisez simplement les lettres "ohm".
</div>

\if{\debug=1}
{
<h3>debug mode</h3>
Réponses : G = \G S, R = \R ohm
}
}

\answer{Calculer la valeur de la conductance G}{\G S#2}{type=sigunits}
\answer{Calculer la valeur de la résistance R}{\R ohm#2}{type=sigunits}
