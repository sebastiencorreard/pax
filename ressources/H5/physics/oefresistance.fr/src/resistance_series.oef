\title{Résistance équivalente en serie}
\language{fr}
\range{-5..5}
\author{Romain, Minne}
\email{romain.minne@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{debug=0}
\real{x1=random(10..100)}
\real{x2=random(10..100)}
\real{R1=round(\x1*1)/1}
\real{R2=round(\x2*1)/1}

\real{R=round((\R1+\R2)*10)/10}

\statement{Calculer la résistance équivalente de résistors montés
en série. On utilise pour cela deux résistors R<sub>1</sub>=\R1 \Omega et R<sub>2</sub>=\R2 \Omega.
<div class="wims_instruction">
ATTENTION: On tiendra compte des unités.<br>
Le symbole \Omega est absent du clavier : utilisez simplement les lettres "ohm".
</div>

\if{\debug=1}
{
<h3>debug mode</h3>
Réponses : R = \R ohm
}
}


\answer{Calculer la valeur de la résistance R}{\R ohm}{type=sigunits}
