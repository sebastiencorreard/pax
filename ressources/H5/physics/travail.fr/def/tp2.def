!set title=Travail et puissance (2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 25

val6=$[rint($(tmp0))]
val7=$[$val6/180*pi]
tmp0=!randitem 60,70,80,90

val8=$[$(tmp0)]
tmp0=!randitem 1,1.5,2,2.5,3

val9=$[$(tmp0)*1000]
tmp0=!random 0.5, 0.75

val10=$[$(tmp0)]
val11=$[$val10*735]
val12=$[$val8*$val9*cos($val7)/$val11]
val13=$[rint(round($val12/60))]
val12=$[60*$val13]
val13=$val13 min
!readproc slib/text/sigunits $val8 N,2 
tmp0=$slib_out
val14=$(tmp0)
!readproc slib/text/sigunits $val8,2 
tmp0=$slib_out
val8=$[$(tmp0)]
!readproc slib/text/sigunits $val9 m,2,,km 
tmp0=$slib_out
val15=$(tmp0)
val16=$[$val8*$val9*cos($val7)]
!readproc slib/text/sigunits $val16 J,2 
tmp0=$slib_out
val17=$(tmp0)
val11=$[$val16/$val12]
!readproc slib/text/sigunits $val11 W,2 
tmp0=$slib_out
val18=$(tmp0)
val10=$[$val11/735]
!readproc slib/text/sigunits $val10,2 
tmp0=$slib_out
val10=$(tmp0)
replytype1=sigunits
replyname1=
replygood1=$val17
replytype2=sigunits
replyname2=
replygood2=$val18
replytype3=sigunits
replyname3=
replygood3=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<br>	<img src=$val1/cab.png align=left alt="un cab" style="padding-right:20px">	Un cheval tire un cab (voir la gravure ci-contre). La force constante	F qu'il exerce a une valeur de $val14, et forme un angle de $val6 ° avec	l'horizontale.	<p>	Le cheval tire le cab le long d'une voie horizontale, sur une distance	de $val15. Le trajet dure $val13.	<p>	Calculez	<ul>	<li>Le travail de la force F sur ce trajet&nbsp;: 
!read oef/embed.phtml r1 
$()	<li>La puissance de cette force&nbsp;: 
!read oef/embed.phtml r2 
$()	<li>Quelle est la valeur de cette puissance convertie en 	cheval-vapeur&nbsp;?	 
!read oef/embed.phtml r3 
$()<br>	(&nbsp;L'ancienne unité cheval vapeur vaut 735 W&nbsp;).	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,13,14,15
embedcnt=3
