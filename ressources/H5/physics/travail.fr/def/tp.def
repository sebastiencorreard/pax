!set title=Travail et puissance (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!random 30, 60

val6=$[$(tmp0)*1e3]
tmp0=!randitem 100,150,200,250,300

val7=$[$(tmp0)*1e3]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 0, 59

val9=$[rint($(tmp0))]
val10=$[3600*$val8+$val9*60]
val11=$val8 h $val9 min
!readproc slib/text/sigunits $val6 N,2,,kN 
tmp0=$slib_out
val12=$(tmp0)
!readproc slib/text/sigunits $val6,2 
tmp0=$slib_out
val6=$[$(tmp0)]
!readproc slib/text/sigunits $val7 m,3,,km 
tmp0=$slib_out
val13=$(tmp0)
val14=$[$val6*$val7]
!readproc slib/text/sigunits $val14 J,2 
tmp0=$slib_out
val15=$(tmp0)
val16=$[$val14/$val10]
!readproc slib/text/sigunits $val16 W,2 
tmp0=$slib_out
val17=$(tmp0)
replytype1=sigunits
replyname1=
replygood1=$val15
replytype2=sigunits
replyname2=
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<img src="http://upload.wikimedia.org/wikipedia/commons/thumb/7/7c/TGV_train_inside_Gare_Montparnasse_DSC08895.jpg/800px-TGV_train_inside_Gare_Montparnasse_DSC08895.jpg"	width="300px" align="left">	Une motrice exerce une force de traction de valeur $val12 sur un train.	Le trajet du train est rectiligne, il mesure $val13 et il se déroule	en $val11.	<p>	Calculez	<ul>	<li>Le travail W de la force de traction&nbsp;: 
!read oef/embed.phtml r1 
$()	<li>La puissance P de cette force&nbsp;: 
!read oef/embed.phtml r2 
$()	</ul>	Faites attention aux chiffres significatifs.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

