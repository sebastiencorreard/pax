!set title=Travail d'une force (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 12, 35

val6=$[$(tmp0)/10]
!readproc slib/text/sigunits $val6 N,2 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint -160, 160

val8=$[$(tmp0)]
tmp0=!randint 0, 100

val9=$[rint($(tmp0))]
val10=$[75]
!if $val9>$val10 
tmp0=!randitem -90,90

val8=$[$(tmp0)]
!endif
val11=$val8 °
val12=$[$val8/180*pi]
tmp0=!randint 15, 45

val13=$[$(tmp0)/100]
!readproc slib/text/sigunits $val13 m,3,,cm 
tmp0=$slib_out
val14=$(tmp0)
val15=$[$val13*$val6*cos($val12)]
!if $val9>$val10 
val15=$[0]
!endif
!readproc slib/text/sigunits $val15 J,2 
tmp0=$slib_out
val16=$(tmp0)
val17=un travail moteur, un travail résistant, nul
!if $val8=90 or $val8=-90 
val18=$[rint(3)]
!else
!if cos($val12)<0 
val18=$[rint(2)]
!else
val18=$[rint(1)]
!endif
!endif
val19=$[0.1]
val20=$[0.03 ]
val21=$[3]
val22=$[$val19*$val6*cos($val12)]
val23=$[$val19*$val6*sin($val12)]
val24=$[$val22+$val20*cos($val12+pi)+$val20/$val21*cos($val12+pi/2)]
val25=$[$val23+$val20*sin($val12+pi)+$val20/$val21*sin($val12+pi/2)]
val26=$[$val22+$val20*cos($val12+pi)+$val20/$val21*cos($val12-pi/2)]
val27=$[$val23+$val20*sin($val12+pi)+$val20/$val21*sin($val12-pi/2)]
val28=animate 50,0.04,0	xrange -0.20,0.60	yrange -0.40,0.40	linewidth 1	hline 0,0, blue	linewidth 7	point 0,0, blue	text black,0,0,medium,A	point $val13,0, blue	text black,$val13,0,medium,B	linewidth 3	segment 0,0,$val13,0, blue	linewidth 7	point s*$val13,0, red	text black,s*$val13,0, medium, M	linewidth 2	segment s*$val13,0,s*$val13+$val22, $val23, red	segment s*$val13+$val22, $val23, s*$val13+$val24, $val25, red	segment s*$val13+$val22, $val23, s*$val13+$val26, $val27, red	
val29=$[rint(0)]
replytype1=menu
replyname1=
replygood1=$val18;$val17
replytype2=sigunits
replyname2=
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $val29=1 
$()	<div style="font-size:80%;background:lightyellow; border:1px solid black;">	<h3>debug</h3>	l = $val14, f= $val7, alpha=$val11	fx=$val22, fy=$val23<br>	alpha = $val12 rad cos(alpha)=\[cos($val12)]	</div>	 
!endif
$()		<table><tr><td>	 
!read oef/draw.phtml 300,300 \
$val28 
$()	</td><td>	Un objet mobile M est se déplace entre un point de départ A et 	un point d'arrivée B, distants de $val14, en ligne droite. Cet objet est soumis à une 	force F de valeur $val7, qui fait un angle de $val11 avec le 	vecteur AB.	<p>	Le travail de la force F est  
!read oef/embed.phtml r1 
$()	<p>	La valeur de ce travail est  
!read oef/embed.phtml r2 
$()	<span style="font-size:80%;color:grey;">	Attention au nombre de chiffres significatifs, précisez l'unité.	</span>	</td></tr></table>	
$()
!exit

