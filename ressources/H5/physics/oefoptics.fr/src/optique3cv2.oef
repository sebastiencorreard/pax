  linewidth 4
  segment \a,0,\a,\yB,\couleur1
  segment \a1,0,\a1,\yB1, \couleur2
}
\text{dessin1 = \a=\f?
  polyline red, \a,\yB, 0,\yB,-\f,0,\u,\c
  polyline blue, \a,\yB
  polyline green, \a,\yB,
  polyline red, \a,\yB, 0,\yB,-\f,0
