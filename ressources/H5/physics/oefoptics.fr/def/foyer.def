val12=!exec pari print($t_)
!else
t_=!rawmath 100
val12=!exec pari print($t_)
!endif
t_=!rawmath $val11*($val12)/($val10)
val13=!exec pari print($t_)
val14=!rawmath ($val11)/($val10)*t
val15=!rawmath ($val13)/(-$val9)*(t-($val9))
val16=!rawmath ($val11)/($val9)*(t+($val9))

!ifval $val10!=$val9
