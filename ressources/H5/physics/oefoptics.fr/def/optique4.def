val39=	  dpolyline red,min($val10,0),$val11, 0,$val11	  dpolyline red,-min(-$val10,0),$val11, 0,$val11	  dpolyline red, -($val9),0,0,$val11	  dpolyline red, $val12,$val13,0,$val11	  polyline blue, 0,$val13,abs($val17),$val13	  dpolyline blue, 0,$val13,$val17,$val13	  dpolyline blue, 0,$val13,$val10,$val11	  dpolyline blue, 0,$val13,$val9,0	  trange 0,$val21	  plot red, t,$val16	  trange min($val10,0),0	  plot red, t,$val11	  trange min(-$val10,0),0	  plot red, t,$val11	  trange $val20,0	  plot blue, t,$val15	  text black,$val9,-0.2,large, F	  text black,-($val9),-0.2,large, F'	  linewidth 4	  segment $val10,0,$val10,$val11,$val27	  segment $val12,0,$val12,$val13, $val28	
!endif

!ifval $val10=$val9
