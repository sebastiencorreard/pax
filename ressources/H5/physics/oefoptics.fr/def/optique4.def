val27=$(tmp0)
tmp0=!item 2 of $val26

val28=$(tmp0)
val29=$val27
tmp0=!positionof item $val29 in  $val25

val30=$(tmp0)

!ifval $val7=
val7= $val26
!endif
tmp0=!item $val30 of $val7

val31=$(tmp0)
