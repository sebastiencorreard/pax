!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)

!ifval $val6 issametext fr 
val7= violet,orange,bleu marine, bleu ciel
!endif
tmp0=!randint 3, 7

val8=$[rint(-$(tmp0))]
tmp0=!randint floor($val8/2), 2*floor($val8)

val9=$[rint($(tmp0))]
tmp0=!randitem 10*$val9/3, 2*$val9/3*10

val10=$[$(tmp0)/10]
tmp0=!randitem 1,-1

val9=$[rint($(tmp0)*$val9)]
tmp0=!randitem 1,-1

val10=$[$(tmp0)*$val10]

!ifval $val9=$val8
val9=$[rint( $val9-1)]
!endif

!ifval $val9!=$val8
t_=!rawmath  1/(1/($val9)-1/($val8))
val11=!exec pari print($t_)
!else
t_=!rawmath 100
val11=!exec pari print($t_)
!endif
val12=$[$val10*($val11)/($val9)]
val13=!rawmath ($val10)/($val9)*t
val14=!rawmath ($val12)/(-$val8)*(t-($val8))
val15=!rawmath ($val10)/($val8)*(t+($val8))

!ifval $val9!=$val8
val16=$[ $val11*1.2]
!else
val16=$[-2*$val8]
!endif
evaltmp=$val15

evaltmp=!mathsubst t=($val16) in $evaltmp
tmp0=($evaltmp)
val17=$[$(tmp0)]

!ifval $val9<>$val8
tmp0=!sort numeric item $val11,$val9,$val8,-$val8

val18= $(tmp0)
!else
tmp1=!sort numeric item $val9,$val8,-$val8

val18=$(tmp1) 
!endif
tmp0=!item 1 of $val18

val19=$[min($(tmp0),-1)]
tmp0=!item -1 of $val18

val20=$[max($(tmp0),1)]
val19=$[1.2*$val19]
val20=$[1.2*$val20]

!ifval $val9<>$val8 
val21=$[ max( abs($val10),abs($val12))]
!else
val21=$[abs($val10)]
!endif
val21=$[$val21*1.5]
val22=$[($val20-$val19)/(2*$val21)]
val23=$[rint(600)]
val22=$[$val23*$val22^(-1)]
val24=purple,orange,navy,skyblue
tmp0=!shuffle $val24

val25=$(tmp0)
tmp0=!item 1 of $val25

val26=$(tmp0)
tmp0=!item 2 of $val25

val27=$(tmp0)
tmp=!nonempty items $val26,$val27

tmp0=!randitem $tmp
val28=$(tmp0)
tmp0=!positionof item $val28 in  $val24

val29=$(tmp0)
tmp0=!item $val29 of $val7

val30=$(tmp0)
val31=linewidth 1	dhline 0,$val10, grey	dhline 0,$val12, grey
val32=xrange $val19,$val20	yrange -$val21*1.3,$val21	hline 0,0, black	linewidth 4	vline 0,0,black	linewidth 1	text black, 0.2,-0.2,medium, O	arrow $val19+($val20-$val19)/20,-$val21*1.2,$val19+($val20-$val19)/10,-$val21*1.2,15, black	

!ifval $val28 issametext $val26
val33=$[ min(0,$val10)]
!else
val33=$[min(0,$val12)]
!endif

!ifval $val28 issametext $val26
val34=	textup black,$val9,$val33,large,$val30
!else
val34=	textup black,$val11,$val33,large,$val30	
!endif

!ifval $val9<>$val8
val32= $val32	dpolyline red,min($val9,0),$val10, 0,$val10	dpolyline red,-min(-$val9,0),$val10, 0,$val10	dpolyline red ,-($val8),0,0,$val10	dpolyline red ,$val11,$val12,0,$val10	polyline blue, 0,$val12,abs($val16),$val12	dpolyline blue, 0,$val12,$val16,$val12	dpolyline blue ,0,$val12,$val9,$val10	dpolyline blue, 0,$val12,$val8,0	trange 0,$val20	plot red , t,$val15	trange min($val9,0),0	plot red , t,$val10	trange min(-$val9,0),0	plot red , t,$val10	trange $val19,0	plot blue, t,$val14	trange $val19,$val20	plot green, t, $val13	linewidth 4	arrow $val9,0,$val9,$val10,6,$val26	arrow $val11,0,$val11,$val12, 6,$val27	$val34	$val31	
!endif

!ifval $val9=$val8
val32= $val32	polyline red, $val9,$val10, 0,$val10,-$val8,0,$val16,$val17	polyline blue, $val9,$val10	polyline green, $val9,$val10,	polyline red, $val9,$val10, 0,$val10,-$val8,0	polyline blue, $val8,0, $val9,$val10,0	polyline green, $val9,$val10,-($val9),-($val10)	linewidth 4	arrow $val9,0,$val9,$val10,6,$val26,	arrow $val11,0, $val11,$val12, 6,$val27	$val34	$val31	
!endif

!ifval $val28 issametext $val26 and $val9<0 
val35= 1
!endif

!ifval $val28 issametext $val27 and $val11<0 
val35= 4
!endif

!ifval $val28 issametext $val26 and $val9>0 
val35= 2
!endif

!ifval $val28 issametext $val27 and $val11>0 
val35= 3
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)

!ifval $val2=1 
val36= convergente
!else
val36=
