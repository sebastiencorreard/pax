tmp0=!random 3, 5

val6=$[$(tmp0)/10]
val7=$[3.1415927]
tmp0=!random 0, 2

val8=$[$(tmp0)*$val7]
tmp0=!random -0.2, 0.2

val9=$[$val8+$(tmp0)*$val7]
tmp0=!random 10, 15

val10=$[$(tmp0)*$val6]
tmp=!nonempty items 0.04,0.06

tmp0=!randitem $tmp
val11=$[$(tmp0)]
val12=$[0.2]
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!random 0.5, 1.5

val14=$[$val8+$(tmp0)*$val7]
!if $val13=2 
tmp0=!random 3, 5

val15=$[$(tmp0)]
!else
val15=$[0]
!endif
val16=$[rint(450)]
val17=$[rint(20)]
val18=$[rint(7)]
val19=
val20=
val21=
val22=$[0]
val23=$[0]
val24=$[0]
val25=$[0]
!for val26 =1 to $val18 
val27=$[sin($val8)*$val6*$val26*$val11+0.5*$val15*sin($val14)*($val26*$val11)^2]
val28=$[cos($val8)*$val6*$val26*$val11+0.5*$val15*cos($val14)*($val26*$val11)^2]
val19=$val19 $val27,$val28,
val22=$[min($val22,$val27)]
val23=$[min($val23,$val28)]
val24=$[max($val24,$val27)]
val25=$[max($val25,$val28)]
val29=$[$val27+$val12*sin($val10*$val26*$val11+$val9)]
val30=$[$val28+$val12*cos($val10*$val26*$val11+$val9)]
val20=$val20 $val29,$val30,
val22=$[min($val22,$val29)]
val23=$[min($val23,$val30)]
val24=$[max($val24,$val29)]
val25=$[max($val25,$val30)]
val29=$[$val27-$val12*sin($val10*$val26*$val11+$val9)]
val30=$[$val28-$val12*cos($val10*$val26*$val11+$val9)]
val21=$val21 $val29,$val30,
val22=$[min($val22,$val29)]
val23=$[min($val23,$val30)]
val24=$[max($val24,$val29)]
val25=$[max($val25,$val30)]
!next
val31=$[$val24-$val22]
val32=$[$val25-$val23]
val33=$[max($val31,$val32)]
val29=$[0.5*($val22+$val24-$val33)*$val16/($val16-2*$val17)]
val34=$[0.5*($val22+$val24+$val33)*$val16/($val16-2*$val17)]
val30=$[0.5*($val23+$val25-$val33)*$val16/($val16-2*$val17)]
val35=$[0.5*($val23+$val25+$val33)*$val16/($val16-2*$val17)]
val36=xrange $val29,$val34	yrange $val30,$val35	
val37=
val38=
val39=
val40=$[rint(0)]
!for val41 =1 to 1+2*$val18 step 2 
tmp0=!items $val41 to $val41+1 of $val20

val42=$(tmp0)
tmp0=!items $val41 to $val41+1 of $val21

val43=$(tmp0)
val37=$val37	  segment $val42, $val43, blue	  
val38=$val38	  text blue, $val42, medium, A$val40	  text blue, $val43, medium, B$val40	  
val39=$val39 $val40;
val40=$[rint($val40+1)]
!next
val44=points blue, $val20	points blue, $val21	
val45=
val46=
val47=
!for val48 =1 to $val18 
tmp0=!items 1 to 2*$val48-2 of $val19

val49=$(tmp0)
tmp0=!items 2*$val48-1 to 2*$val48 of $val19

val50=$(tmp0)
tmp0=!item 1 of $val50

val27=$[$(tmp0)]
tmp0=!item 2 of $val50

val28=$[$(tmp0)]
val51=$[rint(($val16-1)*($val27-$val29)/($val34-$val29))]
val52=$[rint(($val16-1)*($val35-$val28)/($val35-$val30))]
val47=$val47 circle,$val51,$val52,25;
!readproc oef/draw.phtml $val16,$val16 \
    $val36	    linewidth 1	    $val37	    $val38	    linewidth 5	    $val44	    points red, $val49	   
tmp0=$ins_url
val45=$val45	   $(tmp0)	  ;	  
val46=$val46 r$val48;	  
!next
val53=<p><img src="$val1/Majoret5.gif" 	alt="chronophotographie d'un bâton de majorette, (c) INRP"	title="chronophotographie d'un bâton de majorette, (c) INRP"	align="left" style="padding:10px;">	Cet exercice est basé sur l'enregistrement de deux points 	<b>A</b> et <b>B</b> d'un solide qui est lancé puis	laissé à lui-même, dans diverses conditions. Il peut être isolé par rapport au référentiel 	d'étude ou il peut subir une force. Voyez ci-contre un enregistrement par	<a href="http://fr.wikipedia.org/wiki/Chronophotographie">chronophotographie</a>	du mouvement d'un bâton de majorette, qui est soumis à son propre poids.	<p>	En fait le solide dont on enregistre deux points peut aussi bien être posé sur une tab le à 	coussin d'air qui compense son poids.	<p>	Vous verrez successivement $val18 images cliquables, où vous devrez pointer les positions	successives du centre de gravité (qui se trouve au milieu du segment <b>AB</b>).	Restez attentif au numéro qui est indiqué.  Les positions correctes des centres de gravité 	qu'on aurait du pointer aux étapes précédentes sont affichées en rouge à mesure qu'on avance.	Évidemment, votre score dépend de la qualité de vos pointages.	<p>	<a href="#question">Cliquez ici</a> pour aller directement au travail.	
val54=<div style="color:grey;border:1px solid grey;">	Conseil&nbsp;: tracez au crayon deux points A et B au bord d'une 	feuille de papier, qui coïncideront avec A<sub>1</sub> et 	B<sub>1</sub> sur l'écran. Puis traces sur le ford de cette 	même feuille le centre de gravité G de la barre. 	Ensuite, la feuille de papier aide à pointer facilement 	les positions successives du centre de gravité à l'aide 	de la souris.	</div>	
val55=$[rint(0)]
oefsteps=$val46;r8, r9, r10 
nextstep=!nosubst $val46;r8, r9, r10 
!readproc oef/steps.proc
