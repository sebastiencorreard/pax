!set title=Rotation d'un disque
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
precision=100

ansorder=r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=un disque vinyle, 78, 0.2, 5, 14;	un disque vinyle, 33, 0.2, 5, 14;	un disque vinyle, 45, 2, 5, 10;	un compact disque, 600, 0.8, 2.5, 6;	
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val8=$[$(val7[1;4])*10]
val9=$[$(val7[1;5])*10]
tmp0=!randint $val8, $val9

val10=$[$(tmp0)/10]
val11=$[$val10/100]
val12=$[$(val7[;2])/60]
val13=$[2*pi*$val12]
val14=$[$val13*$val11]
!readproc slib/text/sigunits $val14,3 
tmp0=$slib_out
val14=$(tmp0)
val15=$[$(val7[;3])/$(val7[;5])]
val16=$[$val10/$(val7[;5])]
val17=$[0.1/$val12]
val18=$[rint(0)]
replytype1=numeric
replyname1=
replygood1=$[$val12]
replytype2=numeric
replyname2=
replygood2=$[$val13]
replytype3=numeric
replyname3=
replygood3=$[$val11]
replytype4=sigunits
replyname4=
replygood4=$val14 m/s#3
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		
!if $val18=1 
$()<h3>debug</h3>	v=$val14 m/s<br>	<hr>	 
!endif
$()	<br>	<div style="position:relative; float:right;text-align:right;">	<a href="http://fr.wikipedia.org/wiki/Disque_microsillon" target="_new"><img title="cliquer pour visiter Wikipédia" src="$val1/Vinyl_albums.jpg"></a> <br>	<a href="http://fr.wikipedia.org/wiki/Cd" target="_new"><img title="cliquer pour visiter Wikipédia" src="$val1/CD_autolev_crop.jpg"></a> <br>	<span style="color:grey;font-size:50%;">Source: Wikipédia</span>	</div>	Soit $(val7[;1]), tournant à $(val7[;2]) tours par minute.	Une tache de couleur y a été déposée à $val10 centimètres du	centre.	<p>	Toutes les vitesses sont relatives au référentiel du lecteur de disque.	<p>	<table>	<tr><th colspan=2>Convertir la vitesse de rotation</th></tr>	<tr><td colspan=2 style="font-size:70%;color:chocolate;">On attend des réponses précises à mieux que 1%.</td></tr>	<tr><td>
!insmath \omega =
$()</td><td> 
!read oef/embed.phtml r1 
$() tour/seconde</td></tr>	<tr><td>
!insmath \omega =
$()</td><td> 
!read oef/embed.phtml r2 
$() radian/seconde</td></tr>	<tr><th colspan=2>Convertir la distance du centre à la tache de couleur</th></tr>	<tr><td>
!insmath {}r =
$()</td><td> 
!read oef/embed.phtml r3 
$() m</td></tr>	<tr><th colspan=2>Calculer la vitesse du point de couleur</th></tr>	<tr><td colspan=2 style="font-size:70%;color:chocolate;">Donnez trois chiffres significatifs <b>exactement</b>&nbsp;; n'oubliez pas de préciser l'unité&nbsp;:</td></tr>	<tr><td>
!insmath {}v=
$()</td><td> 
!read oef/embed.phtml r4 
$()</td></tr>	</table>	
$()
!exit

