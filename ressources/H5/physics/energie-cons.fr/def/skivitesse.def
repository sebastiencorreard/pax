val6=
val7=$[565]
val8=$[1740]
val9=$[asin($val7/$val8)]
val10=$[180/pi*$val9]
!readproc slib/text/sigunits $val10,3 
tmp0=$slib_out
val10=$(tmp0)
tmp0=!randint 200, 240

val11=$[$(tmp0)]
val12=$[$val11/3.6]
val6=$val6 vklms (1ere affectation)= $val12 ;
val13=$[100/$val12]
!readproc slib/text/sigunits $val13,4 
tmp0=$slib_out
val14=$(tmp0)
val6=$val6 t= $val13 ts= $val14 ;
val12=$[100/$val14]
val6=$val6 vklms (2eme affectation)= $val12 ;
!readproc slib/text/sigunits $val12,4 
tmp0=$slib_out
val12=$(tmp0)
tmp0=!randint 45, 50

val15=$[$(tmp0)*10]
tmp0=!randint 14, 17

val16=$[$(tmp0)/10]
val17=$[$val16*$val15*$val7/$val8]
!readproc slib/text/sigunits $val17,2 
tmp0=$slib_out
val17=$(tmp0)
val18=$[-1*$val17]
val19=$[asin($val17/$val15)]
val20=$[180/pi*$val19]
!readproc slib/text/sigunits $val20,3 
tmp0=$slib_out
val20=$(tmp0)
val21=$[9.8]
tmp0=!randint 65, 80

val22=$[$(tmp0)]
val23=$[sqrt(-2*$val21*$val18)]
!readproc slib/text/sigunits $val23,3 
tmp0=$slib_out
val24=$(tmp0)
val25=$[0.5*$val22*$val23^2]
val26=$[0.5*$val22*$val12^2]
val27=$[$val25-$val26]
!readproc slib/text/sigunits $val27,3 
tmp0=$slib_out
val28=$(tmp0)
val29=$[rint(0)]
