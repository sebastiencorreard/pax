\title{ski de vitesse}
\precision{100}

\text{debugstr=}
\real{deniv=565}
\real{lef=1740}
\real{alpharad=asin(\deniv/\lef)}
\real{alphadeg=180/pi*\alpharad}
\text{alphadeg=slib(text/sigunits \alphadeg,3)}
\real{vkl=randint(200..240)}
\real{vklms=\vkl/3.6}
\text{debugstr=\debugstr vklms (1ere affectation)= \vklms ;}
\real{t=100/\vklms}
\text{ts=slib(text/sigunits \t,4)}
\text{debugstr=\debugstr t= \t ts= \ts ;}
\real{vklms=100/\ts}
\text{debugstr=\debugstr vklms (2eme affectation)= \vklms ;}
\text{vklms=slib(text/sigunits \vklms,4)}
\real{l1=randint(45..50)*10}
\real{incpente=randint(14..17)/10}
\real{moinsdz=\incpente*\l1*\deniv/\lef}
\text{moinsdz=slib(text/sigunits \moinsdz,2)}
\real{dz=-1*\moinsdz}
\real{alpha1rad=asin(\moinsdz/\l1)}
\real{alpha1deg=180/pi*\alpha1rad}
\text{alpha1deg=slib(text/sigunits \alpha1deg,3)}
\real{g=9.8}
\real{m=randint(65..80)}
\real{vmax=sqrt(-2*\g*\dz)}
\text{vmaxms=slib(text/sigunits \vmax,3)}
\real{ecmax=0.5*\m*\vmax^2}
\real{ec=0.5*\m*\vklms^2}
\real{ed=\ecmax-\ec}
\text{edJ=slib(text/sigunits \ed,3)}

\steps{r1,r2
r3,r4,r5}

\integer{debug=0}
\statement{
\if{\debug=1}{
<h3>debug</h3>
\debugstr<br>
\(\alpha)=\alphadeg°<br>
incpente=\incpente<br>
dz= \dz m<br>
vmax = \vmax m/s<br>
Vkl= \vklms m/s <br>
<p>
}
<div style="float:left;">
<div style="width:300px;border:1px solid grey; padding:2px;margin-right:2em;">
<img src="\imagedir/ski-800px.jpg" width=300px">
<br>
