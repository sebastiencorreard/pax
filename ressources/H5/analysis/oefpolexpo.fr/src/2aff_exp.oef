%%%%%%%%%%%%%% TITLE %%%%%%%%%%%%%
\title{2. Dérivée du produit des fonctions exponentielle et affine}
\author{Euler,Académie de Versailles}
%%% MA & GM %%%
\language{\lang}
\email{euler.wims@ac-versailles.fr}
\format{html}
\computeanswer{no}
\precision{10000000000}
\if{\lang=fr}{
\keywords{}
}
%%%%%%%%%%%%% DESCRIPTION - OBSERVATION %%%%%%%%%%%%%%%
\description{
Cet exercice demande de calculer la fonction dérivée du
produit
d'une fonction exponentielle par une 
fonction affine.
}
\observation{Cet exercice d'apprentissage demande de calculer la fonction dérivée du 
produit
d'une fonction exponentielle par une 
fonction affine.
}
%%%%% TEXTES DE L'EXERCICE DANS LA LANGUE %%%%%
%%%%% VARIABLES DE L'EXERCICE %%%%%
%%% Recup confparm %%%
\text{conf1=\confparm1 == ? 1 : \confparm1}
\text{conf1=randitem(\conf1)}
\text{conf2=\confparm2 == ? 1 : \confparm2}
\text{conf2=randitem(\conf2)}
%%% choix des noms de la variable et de la fonction %%%
\text{x = randitem(x , t)}
\if{\x = x}
   {\text{f = randitem(f,g,h)}
    \text{y = t}
   }
   {\text{f = randitem(u,v,w)}
    \text{y = x}
   }
%%% fonctions polynôme et exponentielle %%%
%%Coefficients de ax^2+bx+c et mx+p (entiers par défaut)
  \integer{a = (-1)^randitem(0,1)*randint(1..10)}
  \integer{b = (-1)^randitem(0,1)*randint(0..10)}
  \integer{c = (-1)^randitem(0,1)*randint(0..10)}
  \integer{m = (-1)^randitem(0,1)*randint(1..10)}
  \integer{p = (-1)^randitem(0,1)*randint(1..10)}
%le polynôme est de degré 1
   \integer{a = 0}
   \if{\b == 0}{\integer{b = 1}}
%le polynôme est constant non nul et différent de 1
%cas des coefficients décimaux
\if{\conf1 == 2}
 {\real{a = \a/randitem(1,2,4,5,10)}
  \real{b = \b/randitem(1,2,4,5,10)}
  \real{c = \c/randitem(1,2,4,5,10)}
  \real{m = \m/randitem(1,2,4,5,10)}
  \real{p = \p/randitem(1,2,4,5,10)}
 }
%cas des coefficients rationnels
\if{\conf1 == 3}
 {\rational{a = \a/randitem(1,2,4,5,10)}
  \rational{b = \b/randitem(1,2,4,5,10)}
  \rational{c = \c/randitem(1,2,4,5,10)}
  \rational{m = \m/randitem(1,2,4,5,10)}
  \rational{p = \p/randitem(1,2,4,5,10)}
 }
%Pour exp(mx+p)/c : c est entier
% mx+p = x (par défaut)
 \if{\conf2 == 1}
 {\integer{m = 1}
  \integer{p = 0}
 }
% mx+p = mx avec m!=1 et p=0
\if{\conf2 == 2}
 {\integer{p = 0}
  \if{\m=1}{\integer{m=-1}}
 }
% Ne pas avoir -1 au dénominateur
%Pour exp(mx+p)/(ax^2+bx+c) : si delta>=0, remplacer ax^2+bx+c par a(x-b)(x-c) dont les racines sont b et c
%%%%Fonction f(x)=(ax^2+bx+c)exp(mx+p) ou f(x)=exp(mx+p)/(ax^2+bx+c)
%(ax^2+bx+c)
\text{trino=slib(polynet \a*\x^2 + \b*\x + \c,\x)}
\function{polyn=(pari(\trino))}
\function{poly=pari(\trino)}
\if{\x isvarof \poly}{
  \text{polyaff=\left(texmath(\poly)\right)}
  }
  {\text{polyaff=texmath(\poly)}}
\text{polyaffdeno=\polyaff}
\if{(\a=0 and \c=0 and \b>0) or (\a>0 and \c=0 and \b=0)}
  {\text{polyaff=texmath(\poly)}}
%mx+p = x ou mx+p=(mx+p)
\if{\m == 1 and \p == 0}
   {\function{aff = \x}
   }
   {\function{aff = (pari(\m*\x + \p))}
   }
%%f(x)=(ax^2+bx+c)exp(mx+p) avec e en romain
  \function{fonc = (pari(\a*\x^2 + \b*\x + \c)) * e^\aff}
  \text{fonc_modif = wims(replace internal e by aaa in \fonc)}
  \text{fonc_tex = texmath(\fonc_modif)}
  \text{fonc_tex = wims(replace internal aaa by \mathrm{e} in \fonc_tex)}
%%f(x)=exp(mx+p)/(ax^2+bx+c) avec e en romain
%%% Domaine de dérivabilité %%%
  \text{Int = \mathbb{R}}
%%% Fonction dérivée %%%
\rational{da = \m*\a}
\rational{d2a = 2*\a}
  \rational{db = \m*\b + 2*\a}
  \rational{dc = \m*\c + \b}
\text{expo = pari(\m*\x + \p)}
\text{expoaff = texmath(\expo)}
\text{dpoly=slib(polynet \da*\x^2 + \db*\x + \dc,\x)}
\function{dpoly = (\dpoly)}
\text{derpoly = slib(polynet \d2a*\x + \b,\x)}
\if{(\x isvarof \derpoly and \b != 0) or (\a <0 and \b=0)}
   {\text{derpolyaff = \left(texmath(\derpoly)\right)}
   }
   {\text{derpolyaff = texmath(\derpoly)}
   }
\if{\m < 0}
   {\text{coefm = \left(texmath(\m)\right) \times}
   }
   {\text{coefm = texmath(\m) \times}
   }
\if{\m = 1 and \p = 0}
   {\text{coefm =}}
\text{facteur1aff = slib(polynet \m*(\poly),\x,tex)}
\if{(\a=0 and \b*\m>0) or (\a*\m>0 and \b=0 and \c=0) }
  {\text{facteur1aff =\facteur1aff}}
  {\text{facteur1aff =\left(\facteur1aff \right)}}
  % bonne réponse
    \function{rep1 = (pari(\da*\x^2 + \db*\x + \dc))*e^(pari(\m*\x + \p))}
     %%function{rep1 = (\da*\x^2 + \db*\x + \dc)*e^(\m*\x + \p)}
  % mauvaise réponse : élève a fait (uv)'= u'*v' 
    \function{rep2 =((2*\a*\x + \b)*\m )* e^(\m*\x + \p)}
  % mauvaise réponse : élève a fait (exp(u))' = exp(u)
    \function{rep3 = (\a*\x^2 + (2*\a + \b)*\x + \c + \b)*e^(\m*\x + \p)}
\function{dfonc = \dpoly * e^\aff}
\text{dfonc_modif = wims(replace internal e by aaa in \dfonc)}
\text{dfonc_tex = texmath(\dfonc_modif)}
\text{dfonc_tex = wims(replace internal aaa by \mathrm{e} in \dfonc_tex)}
\text{dfonc_disp = wims(replace internal . by , in \dfonc_tex)}
\text{facteur = pari(\derpoly + (\m) * (\poly))}
\text{facteuraff=texmath(\facteur)}
\text{dfoncLx1 = \derpolyaff \times \mathrm{e}^{\expoaff} + \polyaff \times \coefm \mathrm{e}^{\expoaff}}
\text{dfoncLx2 = \left(\derpolyaff + \facteur1aff \right) \mathrm{e}^{\expoaff}}
\text{dfoncLx3 =\dfonc_disp}
\integer{nbSol = 3}
\if{\a == 0 and \b == 0}
   {\text{dfoncLx1 = \polyaff \times \coefm \mathrm{e}^{\expoaff}}
    \text{dfoncLx2 =\dfonc_disp}
    \integer{nbSol = 2}
    \if{\m == 1 and \c == -1}
       {\text{dfoncLx2 = -\mathrm{e}^{\expoaff}}
       }
   }
\text{Int = wims(replace internal . by , in \Int)}
\text{fonc_disp = wims(replace internal . by , in \fonc_tex)}
\text{dfoncLx1 = wims(replace internal . by , in \dfoncLx1)}
\text{dfoncLx2 = wims(replace internal . by , in \dfoncLx2)}
\text{dfoncLx3 = wims(replace internal . by , in \dfoncLx3)}
%%% variables pour après statement %%%
\text{Delta2=}
\text{Delta3=}
\function{rep=}
%%%% Bloc solution %%%
\text{soluce =
      \(\forall \x \in \Int,\, \f^'(\x)=\dfoncLx1\)
     }
\if{\nbSol > 1}
   {\text{soluce = \soluce
                   <br>
                   \(\phantom{\forall \x \in \Int,\, \f^'(\x)}=\dfoncLx2\)
         }
    \if{\nbSol == 3 }
       {\text{soluce = \soluce
                       <br>
                       \(\phantom{\forall \x \in \Int,\, \f^'(\x)}=\dfoncLx3\)
             }
       }
   }
%%%% Largeur des champs réponse %%%
 \integer{largeur=70}
\text{enonce = On considère la fonction \(\f \,: \x \mapsto \fonc_disp\) définie et dérivable sur <span class="nowrap">\(\Int\).</span>}
\text{question = Déterminer une expression algébrique de la fonction dérivée de <span class="nowrap">\(\f\).</span>}
\text{retour = Vous avez répondu&nbsp;:}
\text{rep_good_0 =Votre réponse est correcte.}
\text{rep_good_1 = On a bien&nbsp;: }
\text{rep_bad_0 = Votre réponse n'est pas correcte.<br>En effet, on a&nbsp;:} 
\text{rep_bad_1 = Votre démarche semble juste mais l'expression de \(\f^{'}\) demandée est en fonction de la variable <span class="nowrap">\(\x\).</span><br>En effet, on a&nbsp;:}
\text{feed0=Attention, l'expression de \(\f^{'}\) demandée est en fonction de la variable <span class="nowrap">\(\x\).</span>}
 \text{feed1=Vous semblez avoir commis une erreur sur <strong>la dérivée d'un produit</strong>.<br>
 On rappelle que si \(u\) et \(v\) sont deux fonctions dérivables sur un intervalle \(\mathrm{I}\) alors la fonction
 \(P \,: \x \mapsto u(\x) \times v(\x)\) est dérivable sur \(\mathrm{I}\) et on a&nbsp;:
 \(P^'(\x) = u^'(\x) \times v(\x) + u(\x) \times v^'(\x)\) pour tout réel \(\x\) appartenant à <span class="nowrap">\(\mathrm{I}\).</span>}
\text{feed2= Vous semblez avoir commis une erreur sur la dérivée de <span class="nowrap">\(\x \mapsto \mathrm{e}^{\expoaff}\).</span><br>
    On rappelle que si \(m\) et \(p\) sont deux nombres réels alors la fonction \(w \,: \x \mapsto \mathrm{e} ^{m \x + p}\) est dérivable sur \(\mathbb{R}\) et on a&nbsp;:
     \(w^'(\x) = m \times \mathrm{e}^{m \x + p}\) pour tout réel <span class="nowrap">\(\x\).</span>}
\text{feed3=
Rappels :<br>
<ul class="euler_ul">
  <li>
    Soit \(u\) et \(v\) deux fonctions dérivables sur un intervalle <span class="nowrap">\(\mathrm{I}\).</span><br>
    La fonction \(P \,: \x \mapsto u(\x) \times v(\x)\) est dérivable sur \(\mathrm{I}\) et on a&nbsp;:
     \(P^'(\x) = u^'(\x) \times v(\x) + u(\x) \times v^'(\x)\) pour tout réel \(\x\) appartenant à <span class="nowrap">\(\mathrm{I}\).</span>
  </li>
  <li>
    Soit \(m\) et \(p\) deux nombres réels, la fonction \(w \,: \x \mapsto \mathrm{e} ^{m \x + p}\) est dérivable sur \(\mathbb{R}\) et on a \(w^'(\x) = m \times \mathrm{e}^{m \x + p}\) pour tout réel <span class="nowrap">\(\x\).</span>
  </li>
</ul>}
%%% HELP %%%%
\text{aide =
    <ul>
     <li>Pour la fonction exponentielle, on pourra saisir soit <code>exp(k*x)</code> soit <code>e^(k*x)</code>.</li>
     <li>Pour l'écriture des nombres décimaux, on pourra utiliser au choix le point ou la virgule comme séparateur décimal.</li>
     <li>Pour les produits, on peut omettre le symbole <code>*</code> entre deux facteurs.<br>
         Par exemple : \(-2 x \mathrm{e}^{3 x+4}\) est obtenu en saisissant
         <code>-2*x*e^(3*x+4)</code> ou <code>-2xe^(3x+4)</code>...
     </li>
    </ul>
}
%%%HINT %%%
\text{hint_1=
Soit \(u\) et \(v\) deux fonctions dérivables sur un intervalle <span class="nowrap">\(\mathrm{I}\).</span><br>
La fonction \(P \,: \x \mapsto u(\x) \times v(\x)\) est dérivable sur \(\mathrm{I}\) et on a&nbsp;: \(P^'(\x) = u^'(\x) \times v(\x) + u(\x) \times v^'(\x)\) pour tout réel \(\x\) appartenant à <span class="nowrap">\(\mathrm{I}\).</span>
}
\text{hint_2=
Soit \(m\) et \(p\) deux nombres réels.<br>
La fonction \(w \,: \x \mapsto \mathrm{e} ^{m \x + p}\) est dérivable sur \(\mathbb{R}\) et on a \(w^'(\x) = m \times \mathrm{e}^{m \x + p}\) pour tout réel <span class="nowrap">\(\x\).</span>
}
