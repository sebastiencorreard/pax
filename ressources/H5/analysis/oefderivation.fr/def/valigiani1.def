!set title=Dérivation par étapes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Karen, Valigiani 
email=karen.valigiani@gmail.com 

ansorder=r,r,r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x,y,z,t
tmp0=!shuffle $val6

val6=$(tmp0)
val6=$(val6[1])
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
!readproc slib/polynomial/random $val7, 4, $val6 
tmp0=$slib_out
val8=$(tmp0)
val9=($val8), sqrt($val6), cos($val6), sin($val6), e^$val6, ln($val6)
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
tmp0=!texmath $val10

val12=$(tmp0)
tmp0=!texmath $val11

val13=$(tmp0)
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
!if $val14 = 1 
val15=$val10 + $val11
tmp0=!texmath $val12 + $val13

val16=$(tmp0)
val17=u + v
!endif
!if $val14 = 2 
val15=$val10 * $val11
tmp0=!texmath $val12 \times $val13

val16=$(tmp0)
val17=u \times v
!endif
!if $val14 = 3 
val15=$val10 / $val11
val16=\frac{$val12}{$val13}
val17=\frac{u}{v}
!endif
val18=\(u + v ) , \(u \times v) , \(\frac{u}{v})
!if $val14 = 1 
val19=u' + v'
tmp0=!texmath $val19

val20=$(tmp0)
!endif
!if $val14 = 2 
val19=u'v + v'u, vu' + v'u, u'v + uv', uv' + vu'
tmp0=!texmath u' \times v + v' \times u

val20=$(tmp0)
!endif
!if $val14 = 3 
val19=(u'v - v'u)/v^2, (vu' - v'u)/v^2, (u'v - uv')/v^2, (vu' - uv')/v^2
tmp0=!texmath \frac{u' \times v - v' \times u}{v^2}

val20=$(tmp0)
!endif
tmp=!translate ;";': to $     $ in $val15,$val6

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val21=$(tmp1)
oefsteps=r1	r2	r3 
nextstep=!nosubst r1	r2	r3 
!readproc oef/steps.proc
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val14;$val18
replytype2=formal
replyname2=
replygood2=$val19
replytype3=formal
replyname3=
replygood3=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath f
$() la fonction définie par 
!insmath f($(val6[1])) = $val16 
$().	<ol>	
!if $m_step = 1 
$()	   <li>	   Quelle forme reconnaissez-vous ?  
!read oef/embed.phtml r1 
$()	   </li>	 
!endif
$()	
!if $m_step = 2 
$()	   <li>  
!insmath f
$() est de la forme : 
!insmath $val17 
$()	   </li><li>	   Donner la formule : 
!insmath ($val17)'
$()=  
!read oef/embed.phtml r2 
$()	   </li>	 
!endif
$()	
!if $m_step = 3 
$()	   <li>	   
!insmath f
$() est de la forme : 
!insmath $val17
$()	   </li><li>	    On utilise la formule : 
!insmath ($val17)' = $val20
$()	   </li><li>	   Calculer la dérivée de la fonction 
!insmath f
$() :	   
!insmath f'($(val6[1]))
$() =   
!read oef/embed.phtml r3 
$()	   </li>	 
!endif
$()	</ol>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,16,17,20
embedcnt=3
