val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 7

val11=$[rint($(tmp0))]
val12=$val7*x^2+$val8*x+$val9
tmp=!translate ";': to $     $ in $val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
val14=sin(x),cos(x),sqrt(x),exp(x),$val13,ln(x),1/x
val15=sin($(val14[$val10])),cos($(val14[$val10])),sqrt($(val14[$val10])),exp($(val14[$val10])),ln($(val14[$val10])),2/($(val14[$val10])),($(val14[$val10]))^$val6
val16=$(val15[$val11])
tmp0=!texmath $val16

val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

