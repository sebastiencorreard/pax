tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,$val6

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val19=$(tmp0)
