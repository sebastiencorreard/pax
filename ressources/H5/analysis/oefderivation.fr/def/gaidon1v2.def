!set title=Dérivée de fonctions usuelles (sans polynôme)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache;Stéphanie,Gaidon
email=paul@byache.fr
language=fr
oefobservation=Il s'agit d'une version sans polynôme de l'exercice "dérivée de fonctions usuelles".
computeanswer=yes

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 1,2,3,4,5,6

val6=$(tmp0)
val7=sin(x),cos(x),sqrt(x),exp(x),ln(x),1/x
val8=$(val7[$(val6[1])])
tmp0=!texmath $val8

val9=$(tmp0)
tmp=!translate ;";': to $     $ in $val8,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val10=$(tmp0)
val11=$(val7[$(val6[2])])
tmp0=!texmath $val11

val12=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=$(tmp0)
replytype1=algexp
replyname1=
replygood1=$val10
replytype2=algexp
replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Soit la fonction 
!insmath A
$() définie par :	<div class="wimscenter">
!insmath A(x) = $val9 
$()</div>	La dérivée de la fonction 
!insmath A
$() est :	<div class="wimscenter">
!insmath A'(x)
$()= 
!read oef/embed.phtml r1 
$()</div>		Soit la fonction 
!insmath B
$() définie par :	<div class="wimscenter">
!insmath B(x) = $val12 
$()</div>	La dérivée de la fonction 
!insmath B
$() est :	<div class="wimscenter">
!insmath B'(x)
$()= 
!read oef/embed.phtml r2 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12
embedcnt=2
