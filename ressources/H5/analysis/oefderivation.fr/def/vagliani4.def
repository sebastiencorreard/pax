!set title=Dérivation d'un quotient
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Karen, Valigiani
email=karen.valigiani@gmail.com 

ansorder=r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x,y,z,t
tmp0=!shuffle $val6

val6=$(tmp0)
val6=$(val6[1])
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
!readproc slib/polynomial/random $val7, 4, $val6 
tmp0=$slib_out
val8=$(tmp0)
val9=$val8, sqrt($val6), cos($val6), sin($val6), e^$val6, ln($val6)
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
tmp0=!texmath $val10

val12=$(tmp0)
tmp0=!texmath $val11

val13=$(tmp0)
val14=$val10 / $val11
!if $val10 = $val8 
val14=($val10) / $val11
!endif
!if $val11 = $val8 
val14=$val10 / ($val11)
!endif
tmp0=!texmath \frac{$val12}{$val13}

val15=$(tmp0)
tmp=!translate ;";': to $     $ in $val10,$val6

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,$val6

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,$val6

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ;";': to $     $ in $val14,$val6

tmp=!lower $tmp
tmp2=!exec maxima diff($tmp);
val18=$(tmp1), $(tmp2)
tmp0=!texmath $val16

val19=$(tmp0)
tmp0=!texmath $val17

val20=$(tmp0)
oefsteps=r1, r2	r3 
nextstep=!nosubst r1, r2	r3 
!readproc oef/steps.proc
replytype1=formal
replyname1=
replygood1=$val16
replytype2=formal
replyname2=
replygood2=$val17
replytype3=formal
replyname3=
replygood3=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ol>	
!if $m_step = 1 
$()	   <li>	   Dériver la fonction 
!insmath u
$() définie par	   
!insmath u($(val6[1])) = $val12
$() :	   <div class="wimscenter">	   
!insmath u'($(val6[1])) 
$() =  
!read oef/embed.phtml r1 
$().	   </div>	   </li><li>	   Dériver la fonction 
!insmath v
$() définie par	   
!insmath v($(val6[1])) = $val13 
$() :	   <div class="wimscenter">	   
!insmath v'($(val6[1])) 
$() =  
!read oef/embed.phtml r2 
$()	   </div>	   </li>	 
!endif
$()	
!if $m_step = 2 
$()	   <li>	   La dérivée de la fonction 
!insmath u
$() définie par	   
!insmath u($(val6[1])) = $val12
$() est	   
!insmath u'($(val6[1])) = $val19
$().	   </li><li>	   La dérivée de la fonction 
!insmath v
$() définie par	   
!insmath v($(val6[1])) = $val13
$() est	   
!insmath v'($(val6[1])) = $val20
$()	   </li><li>	   Dériver la fonction 
!insmath f
$() définie par :	   
!insmath f($(val6[1])) = $val15
$().	   <div class="wimscenter">
!insmath f'($(val6[1]))
$() =  
!read oef/embed.phtml r3 
$()</div>	   </li>	 
!endif
$()	</ol>	
$()
!exit

:hint
$()
$()
!exit

