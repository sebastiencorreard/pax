!set title=Dérivée de fonctions usuelles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Stéphanie, Gaidon
language=fr
computeanswer=yes
oefobservation=Cet exercice dispose d'un variant qui ne propose pas de polynôme.Il s'agit de "dérivée de fonctions usuelles (sans polynôme)".

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

val11=$[rint($(tmp0))]
val12=$val6*x^4+$val7*x^3+$val8*x^2+$val9*x+$val10
tmp=!translate ";': to $     $ in $val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
val14=sin(x),cos(x),sqrt(x),$val13,exp(x),ln(x),1/x
val15=$(val14[$val11])
tmp0=!texmath $val15

val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Soit la fonction 
!insmath A
$() définie par :	<div class="wimscenter">
!insmath A(x) = $val16 
$()</div>	La dérivée de la fonction 
!insmath A
$() est :	<div class="wimscenter">
!insmath A'(x)
$()= 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

