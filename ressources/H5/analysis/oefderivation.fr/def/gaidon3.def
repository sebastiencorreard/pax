!set title=Equation de la tangente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Stéphanie, Gaidon
language=fr
computeanswer=yes

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 15

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val10=$[rint($(tmp0)*$(tmp1))]
val11=$val6*x^4+$val7*x^3+$val8*x^2+$val9*x+$val10
tmp=!translate ";': to $     $ in $val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
val13=!rawmath $val12
tmp0=!texmath $val13

val14=$(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=$(tmp0)
evaltmp=$val15

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val16=$[$(tmp0)]
val17=$val16*x+$val10
val18=$[5]
val19=$[300]
val20=xrange -$val18, $val18	    yrange -$val18, $val18	    hline 0,0,black	    arrow 0,0,1,0,6,black	    arrow 0,0,0,1,6,black	    vline 0,0,black	    plot blue,$val12	    plot red, $val17	
!readproc oef/draw.phtml $val19,$val19 \
      $val20	       
tmp0=$ins_url
val21=$(tmp0)	 
oefsteps=r1,r2,r3	r4 
nextstep=!nosubst r1,r2,r3	r4 
!readproc oef/steps.proc
replytype1=formal
replyname1=
replygood1=$val15
replytype2=numexp
replyname2=
replygood2=$val10
replytype3=numexp
replyname3=
replygood3=$val16
replytype4=formal
replyname4=
replygood4=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_left spacer">	<img src="$val21" alt="" />	</div>	<div class="float_left">	On considère la fonction définie par :	<div class="wimscenter">
!insmath f(x)=$val14 
$()</div>	Sa courbe représentative est donnée en bleue ci-contre.	La droite représentée en rouge est la tangente à 
!insmath f
$() en 
!insmath x= 0
$().	<br/>	Le but de l'exercice est de donner l'équation de cette droite :	<ol>	
!if $m_step=1 
$()	<li>Quelle est la dérivée de la fonction 
!insmath f 
$() ?	  <div class="wimscenter">
!insmath f'(x)
$()= 
!read oef/embed.phtml r1 
$()</div>	</li>	<li>Calculer les valeurs de 
!insmath f
$() et de 
!insmath f'
$() en 
!insmath x=0
$().	  <ul>	  <li>
!insmath f(0)
$() =  
!read oef/embed.phtml r2 
$()</li>	  <li>
!insmath f'(0)
$() =  
!read oef/embed.phtml r3 
$()</li>	  </ul>	</li>	 
!else
$() 	<li>La dérivée de la fonction 
!insmath f
$() est donnée par :	  <div class="wimscenter">
!insmath f'(x)=\special{color=green}{$val15}
$()</div>	</li>	<li>Les valeurs de 
!insmath f
$() et de 
!insmath f'
$() en 
!insmath x=0
$() sont :	  <ul>	  <li>
!insmath f(0)=\special{color=green} $val10 
$().	  </li><li>	  
!insmath f'(0)= \special{color=green} $val16
$().	  </li></ul>	</li><li>	 En déduire l'équation de la tangente 
!insmath y=T(x)
$() à 
!insmath f
$() en 
!insmath x= 0
$():	<div class="wimscenter">
!insmath T(x)
$() =  
!read oef/embed.phtml r4 
$()</div>	</li>	 
!endif
$()	</ol>	</div>		
$()
!exit

