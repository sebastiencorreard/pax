!set title=Limites de fonctions usuelles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Stéphanie,Gaidon
language=fr
computeanswer=yes

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint 1, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint 1, 15

val9=$[rint($(tmp0))]
val10=\(+ \infty)
val11=\(- \infty)
tmp0=!randint 1, 17

val12=$[rint($(tmp0))]
val13=sin(x)/x,(1-cos(x))/x^2,exp(x),exp(x),exp(-x),exp(-x),ln(x),ln(x),ln(1+x)/x,(exp(x)-1)/x,ln(x)^$val6/x^$val7, exp(x)/x^$val8,1/x^$val9,1/x^$val9,x^$val7*ln(x),x^$val7*exp(-x),(1-cos(x))/x
val14=0,0,+\infty,-\infty,+\infty,-\infty,0,+\infty,0,0,+\infty,+\infty,+\infty,-\infty,0,+\infty,0
val15=1,1/2,+inf,0,0,+inf,-inf,+inf,1,1,0,+inf,0,0,0,0,0
val16=$(val13[$val12])
tmp0=!texmath $val16

val17=$(tmp0)
replytype1=raw
replyoption1=nospace 
replyname1=
replygood1=$(val15[$val12])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer la limite suivante :	<div class="wimscenter">
!insmath \lim_{x \to $(val14[$val12])} $val17
$() =  
!read oef/embed.phtml r1 
$()</div>		<div class="wims_instruction">	<b>Notations: </b> Si la limite est égale à $val11, taper <span class="tt">-inf</span>.	Si elle est égale à $val10, taper <span class="tt">+inf</span>.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,14,17
embedcnt=1
