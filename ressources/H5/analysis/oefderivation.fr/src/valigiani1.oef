\title{Dérivation par étapes}
\author{ Karen, Valigiani }
\format{ html }
\email{ karen.valigiani@gmail.com }


LETTRE :
\text{l = x,y,z,t}
\text{l = shuffle(\l)}
\text{l = \l[1]}


2 FONCTIONS u ET v :
   Création d'un polygone :
\integer{d = randint(2..3)}
\text{poly = slib(polynomial/random \d, 4, \l)}

   Choix des deux fonctions :
\text{fonc = (\poly), sqrt(\l), cos(\l), sin(\l), e^\l, ln(\l)}
\text{fonc = shuffle(\fonc)}
\text{u = \fonc[1]}
\text{v = \fonc[2]}

   Format Latex :
\text{u1 = texmath(\u)}
\text{v1 = texmath(\v)}


CONSTRUCTION DE f :
\integer{n = randint(1..3)}

   Somme :
\if{\n = 1}{
   \text{f = \u + \v}
   Format Latex :
   \text{f1 = texmath(\u1 + \v1)}
   \text{bon1 = u + v}
}

   Produit :
\if{\n = 2}{
   \text{f = \u * \v}
   Format Latex :
   \text{f1 = texmath(\u1 \times \v1)}
   \text{bon1 = u \times v}
}

   Division :
\if{\n = 3}{
   \text{f = \u / \v}
   Format Latex :
   \text{f1 = \frac{\u1}{\v1}}
   \text{bon1 = \frac{u}{v}}
}

REPONSE :
   Liste de reponse 1 :
\text{liste = \(u + v ) , \(u \times v) , \(\frac{u}{v})}
   Reponse 2 :
\if{\n = 1}{
   \text{rep1 = u' + v'}
   Format Latex :
   \text{rep11 = texmath(\rep1)}
}
\if{\n = 2}{
   \text{rep1 = u'v + v'u, vu' + v'u, u'v + uv', uv' + vu'}
   Format Latex :
   \text{rep11 = texmath(u' \times v + v' \times u)}
}
\if{\n = 3}{
   \text{rep1 = (u'v - v'u)/v^2, (vu' - v'u)/v^2, (u'v - uv')/v^2, (vu' - uv')/v^2}
   Format Latex :
   \text{rep11 = texmath(\frac{u' \times v - v' \times u}{v^2})}
}
   Reponse 3 :
\text{rep2 = maxima(diff(\f,\l))}


DIFFERENTES ETAPES :
\steps{r1
r2
r3}

\statement {Soit \(f\) la fonction définie par \(f(\l[1]) = \f1 ).
<ol>
\if{\step = 1}{
   <li>
   Quelle forme reconnaissez-vous ? \embed{r1}
   </li>
}
\if{\step = 2}{
   <li>  \(f\) est de la forme : \(\bon1 )
   </li><li>
   Donner la formule : \((\bon1)')= \embed{r2}
   </li>
}
\if{\step = 3}{
   <li>
   \(f\) est de la forme : \(\bon1)
   </li><li>
    On utilise la formule : \((\bon1)' = \rep11)
   </li><li>
   Calculer la dérivée de la fonction \(f\) :
   \(f'(\l[1])) =  \embed{r3}
   </li>
}
</ol>}

\answer {}{\n;\liste}{type=radio}{option=shuffle}
\answer {}{\rep1}{type=formal}
\answer {}{\rep2}{type=formal}
