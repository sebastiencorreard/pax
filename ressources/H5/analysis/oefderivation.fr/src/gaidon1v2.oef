\title{Dérivée de fonctions usuelles (sans polynôme)}
\language{fr}
\author{Paul, Byache;Stéphanie,Gaidon}

\observation{Il s'agit d'une version sans polynôme de l'exercice "dérivée de fonctions usuelles".}

\email{paul@byache.fr}
\format{html}
\computeanswer{yes}

\text{f=shuffle(1,2,3,4,5,6)}

\text{list=sin(x),cos(x),sqrt(x),exp(x),ln(x),1/x}

\text{A1=\list[\f[1]]}
\text{aff1=texmath(\A1)}
\text{derive1=diff(\A1,x)}

\text{A2=\list[\f[2]]}
\text{aff2=texmath(\A2)}
\text{derive2=diff(\A2,x)}

\statement{
Soit la fonction \(A) définie par :
<div class="wimscenter">\(A(x) = \aff1 )</div>
La dérivée de la fonction \(A\) est :
<div class="wimscenter">\(A'(x)\)=\embed{r1}</div>

Soit la fonction \(B) définie par :
<div class="wimscenter">\(B(x) = \aff2 )</div>
La dérivée de la fonction \(B\) est :
<div class="wimscenter">\(B'(x)\)=\embed{r2}</div>
}

\answer{}{\derive1}{type=algexp}
\answer{}{\derive2}{type=algexp} 
