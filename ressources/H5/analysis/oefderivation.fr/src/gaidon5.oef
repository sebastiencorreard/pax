\title{Limite de quotient de polynômes}
\language{fr}
\range{-5..5}
\author{Stéphanie, Gaidon}
\email{hayashine@hotmail.com}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a1=randint(1..15)*randitem(-1,1)}
\integer{a2=randint(1..15)*randitem(-1,1)}
\integer{a3=randint(1..15)*randitem(-1,1)}
\integer{a4=randint(1..15)*randitem(-1,1)}
\integer{a5=randint(1..15)*randitem(-1,1)}
\integer{a6=randint(1..15)*randitem(-1,1)}
\integer{b1=randint(1..15)*randitem(-1,1)}
\integer{b2=randint(1..15)*randitem(-1,1)}
\integer{b3=randint(1..15)*randitem(-1,1)}
\integer{b4=randint(1..15)*randitem(-1,1)}
\integer{b5=randint(1..15)*randitem(-1,1)}
\integer{b6=randint(1..15)*randitem(-1,1)}
\integer{c1=randint(1..15)*randitem(-1,1)}
\integer{c2=randint(1..15)*randitem(-1,1)}
\integer{c3=randint(1..15)*randitem(-1,1)}
\integer{c4=randint(1..15)*randitem(-1,1)}
\integer{c5=randint(1..15)*randitem(-1,1)}
\integer{c6=randint(1..15)*randitem(-1,1)}
\integer{d1=randint(1..15)*randitem(-1,1)}
\integer{d2=randint(1..15)*randitem(-1,1)}
\integer{d3=randint(1..15)*randitem(-1,1)}
\integer{d4=randint(1..15)*randitem(-1,1)}
\integer{d5=randint(1..15)*randitem(-1,1)}
\integer{d6=randint(1..15)*randitem(-1,1)}


\integer{f=randint(0..2)}
\integer{f2=randint(0..2)}

\text{pol1=\a1*x^3+\b1*x^2+\c1*x+\d1}
\text{pol2=\b2*x^\f+\c2*x+\d2}
\text{pol3=\b3*x^\f2+\c3*x+\d3}
\text{pol4=\a4*x^3+\b4*x^2+\c4*x+\d4}
\text{pol5=\a5*x^3+\b5*x^2+\c5*x+\d5}
\text{pol6=\a6*x^3+\b6*x^2+\c6*x+\d6}


\text{pol1s=simplify (\pol1)}
\text{aff1=texmath(\pol1s)}
\text{pol2s=simplify (\pol2)}
\text{aff2=texmath(\pol2s)}
\text{pol3s=simplify (\pol3)}
\text{aff3=texmath(\pol3s)}
\text{pol4s=simplify (\pol4)}
\text{aff4=texmath(\pol4s)}
\text{pol5s=simplify (\pol5)}
\text{aff5=texmath(\pol5s)}
\text{pol6s=simplify (\pol6)}
\text{aff6=texmath(\pol6s)}

\text{A=simplify(\a5/\a6)}
\text{limite=\(\frac{\aff1}{\aff2}),\(\frac{\aff3}{\aff4}),
             \(\frac{\aff5}{\aff6})}

\text{limitinf=maxima(limit((\pol1s)/(\pol2s),x,inf))}

\if{\limitinf=minf}{
  \text{\limitinf=\(-\infty)}
}{
  \text{\limitinf=\(+\infty)}
}

\text{reponse=\limitinf,0,\(\A\quad)}

\statement{
Reliez chaque fonction à sa limite lorsque \(x \to +\infty).

<div class="wimscenter">
\embed{r1,100x300 x 100}
</div>
}

\answer{Question}{\limite;\reponse}{type=correspond}
