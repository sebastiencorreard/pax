\title{Limites de fonctions usuelles}
\language{fr}
\author{Stéphanie,Gaidon}
\format{html}
\computeanswer{yes}

\integer{a=randint(-15..15)}
\integer{b=randint(1..15)}
\integer{c=randint(-15..15)}
\integer{d=randint(1..15)}


\text{plusinf = \(+ \infty)}
\text{moinsinf = \(- \infty)}

\integer{f=randint(1..17)}

\text{list=sin(x)/x,(1-cos(x))/x^2,exp(x),exp(x),exp(-x),exp(-x),ln(x),ln(x),ln(1+x)/x,(exp(x)-1)/x,ln(x)^\a/x^\b, exp(x)/x^\c,1/x^\d,1/x^\d,x^\b*ln(x),x^\b*exp(-x),(1-cos(x))/x}
\text{listtend=0,0,+\infty,-\infty,+\infty,-\infty,0,+\infty,0,0,+\infty,+\infty,+\infty,-\infty,0,+\infty,0}
\text{listlim=1,1/2,+inf,0,0,+inf,-inf,+inf,1,1,0,+inf,0,0,0,0,0}

\text{A=\list[\f]}
\text{aff=texmath(\A)}

\statement{
Calculer la limite suivante :
<div class="wimscenter">\(\lim_{x \to \listtend[\f]} \aff) = \embed{r1}</div>

<div class="wims_instruction">
<b>Notations: </b> Si la limite est égale à \moinsinf, taper <span class="tt">-inf</span>.
Si elle est égale à \plusinf, taper <span class="tt">+inf</span>.
</div>
}

\answer{}{\listlim[\f]}{type=raw}{option = nospace}
