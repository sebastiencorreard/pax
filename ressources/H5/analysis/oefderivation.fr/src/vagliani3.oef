\title{Dérivation d'un produit}
\author{Karen, Valigiani}
\format{ html }
\email{ karen.valigiani@gmail.com }


LETTRE :
\text{l = x,y,z,t}
\text{l = shuffle(\l)}
\text{l = \l[1]}


2 FONCTIONS u ET v :
   Construction du polynome :
\integer{d = randint(2..3)}
\text{poly = slib(polynomial/random \d, 4, \l)}

   Choix des deux fonctions :
\text{fonc = \poly, sqrt(\l), cos(\l), sin(\l), e^\l, ln(\l)}
\text{fonc = shuffle(\fonc)}
\text{u = \fonc[1]}
\text{v = \fonc[2]}

   Format Latex :
\text{u1 = texmath(\u)}
\text{v1 = texmath(\v)}


CONSTRUCTION DE f = uv :
\text{f = \u * \v}
\if{\u = \poly}{
   \text{f = (\u) * \v}
}
\if{\v = \poly}{
   \text{f = \u * (\v)}
}
   Format Latex :
\text{f1 = texmath(\f)}


REPONSE :
\text{rep1 = diff(\u,\l)}
\text{rep2 = diff(\v,\l)}
\text{rep3 = simplify(diff(\f,\l)), diff(\f,\l)}
   Format Latex :
\text{rep11 = texmath(\rep1)}
\text{rep21 = texmath(\rep2)}


DIFFERENTES ETAPES :
\steps{r1, r2
r3
}

\statement {
<ol>
\if{\step = 1}{
   <li>
   Dériver la fonction \(u\) définie par \(u(\l[1]) = \u1 )
   <div class="wimscenter">\(u'(\l[1]) )= \embed{r1} </div>
   </li><li>
   Dériver la fonction \(v\) définie par \(v(\l[1]) = \v1 )
   <div class="wimscenter">\(v'(\l[1]) )= \embed{r2}</div>
   </li>
}
\if{\step = 2}{
   <li>
   La dérivée de la fonction \(u\) définie par
   \(u(\l[1]) = \u1 ) est
   \(u'(\l[1]) = \rep11 ).
   </li><li>
   La dérivée de la fonction \(v\) définie par
   \(v(\l[1]) = \v1) est
   \(v'(\l[1]) = \rep21 )
   </li><li>
   Dériver la fonction \(f\) définie par
   \(f(\l[1]) = \f1 ) :
   <div class="wimscenter">
   \(f'(\l[1])) = \embed{r3}
   </div>
   </li>
}
</ol>
<div class="wims_instruction">
</div>
}

\answer {}{\rep1}{type=formal}
\answer {}{\rep2}{type=formal}
\answer {}{\rep3}{type=formal}
