\title{Dérivée de fonctions composées}
\language{fr}
\author{Stéphanie, Gaidon}
\format{html}
\computeanswer{yes}


\integer{a=randint(1..5)*randitem(-1,1)}
\integer{c=randint(-15..15)}
\integer{d=randint(1..15)*randitem(-1,1)}
\integer{e=randint(1..15)*randitem(-1,1)}

\integer{f=randint(1..7)}
\integer{g=randint(1..7)}
\text{pol=\c*x^2+\d*x+\e}
\text{pols=simplify (\pol)}
\text{list1=sin(x),cos(x),sqrt(x),exp(x),\pols,ln(x),1/x}

\text{list2=sin(\list1[\f]),cos(\list1[\f]),sqrt(\list1[\f]),exp(\list1[\f]),ln(\list1[\f]),2/(\list1[\f]),(\list1[\f])^\a}

\text{A=\list2[\g]}
\text{aff=texmath(\A)}
\text{derive=diff(\A,x)}

\statement{
Soit la fonction \(A) définie par:
<div class="wimscenter">\(A(x) = \aff)</div>
La dérivée de la fonction \(A\) dans son domaine de définition est donnée par :
<div class="wimscenter">\(A'(x)) = \embed{r1}</div>
}


\answer{}{\derive}{type=formal}
