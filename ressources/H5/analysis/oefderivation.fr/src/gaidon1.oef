\title{Dérivée de fonctions usuelles}
\language{fr}
\author{Stéphanie, Gaidon}
\format{html}
\computeanswer{yes}

\observation{Cet exercice dispose d'un variant qui ne propose pas de polynôme.Il s'agit de "dérivée 
   de fonctions usuelles (sans polynôme)".}

\integer{a=randint(-15..15)}
\integer{b=randint(-15..15)}
\integer{c=randint(-15..15)}
\integer{d=randint(1..15)*randitem(-1,1)}
\integer{e=randint(1..15)*randitem(-1,1)}

\integer{f=randint(1..7)}

\text{pol=\a*x^4+\b*x^3+\c*x^2+\d*x+\e}
\text{pols=simplify (\pol)}
\text{list=sin(x),cos(x),sqrt(x),\pols,exp(x),ln(x),1/x}

\text{A=\list[\f]}
\text{aff=texmath(\A)}
\text{derive=diff(\A,x)}
\statement{
Soit la fonction \(A) définie par :
<div class="wimscenter">\(A(x) = \aff )</div>
La dérivée de la fonction \(A\) est :
<div class="wimscenter">\(A'(x)\)=\embed{r1}</div>
}


\answer{}{\derive}{type=formal}
