!if $val6=en 
val7=Prove
val8=and
val9=Let, three , non negative,, tels que
val10=rational numbers, real numbers
!endif
m_options=nofloat fixedgoal
tmp=!nonempty items constineq,obvineq

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items trans,addineq

tmp0=!randitem $tmp
val12=$(tmp0)
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/lincomb,	ineq/$val11, ineq/$val12, ineq/mulineq, ineq/sqrpos
m_minsteps=8
tmp=!trim x,y,z	a,b,c	r,s,t	l,m,n	u,v,w	
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 1 of $val13

val14=$(tmp0)
tmp0=!item 2 of $val13

val15=$(tmp0)
tmp0=!item 3 of $val13

val16=$(tmp0)
tmp0=!randint 8, 30

val17=$[rint($(tmp0))]
val18=$[rint($val17^3)]
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val19=$(tmp0)
tmp0=!randitem <,<=

val20=$(tmp0)
val21=$val14 + $val15 + $val16 $val20 $val17
val22=0 <= $val14
val23=0 <= $val15
val24=0 <= $val16
val25=$val14*$val15*$val16 $val20 $val18
m_context=$val21	$val22	$val23	$val24	
m_goal=$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val9[1]) 
!insmath $val14, $val15, $val16
$() $(val9[2]) $val19 $(val9[3]) $(val9[4])	
