val26=$(tmp0)
tmp0=!item 1 of $val26

val27=$(tmp0)
tmp0=!item 2 of $val26

val28=$(tmp0)
tmp0=!item 3 of $val26

val29=$(tmp0)
!if $val28 issametext $val20 
tmp=!translate ";': to $     $ in $val27-($val14*$val15*$val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val30=$(tmp0)
tmp=!translate ";': to $     $ in $val29-($val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=$(tmp0)
!else
tmp=!translate ";': to $     $ in $val29-($val14*$val15*$val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val30=$(tmp0)
tmp=!translate ";': to $     $ in $val27-($val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=$(tmp0)
tmp0=!translate internal <> to >< in $val28

val28=$(tmp0)
!endif
!endif

!exit

