m_options=nofloat
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp,	ineq/trans, ineq/addineq, ineq/mulineq,	prf/contrapose
tmp=!trim a,b	c,d	x,y	r,s	s,t	p,q	
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$(tmp0)
tmp0=!item 2 of $val10

val12=$(tmp0)
tmp0=!randint 3, 20

val13=$[rint($(tmp0))]
tmp0=!randint 3, 20

val14=$[rint($(tmp0))]
val15=$[rint($val13*$val14)]
val16=
tmp=!nonempty items ,=

tmp0=!randitem $tmp
val17=$(tmp0)
val18=>
val19=<
tmp=!trim $val11^2 $val18 $val12^2, $val11 $val18= 0, $val11 $val18 $val12, 2, 4	$val11^2 $val18 $val12^2, $val11 $val19= 0, $val11 $val19 $val12, 3, 3	$val11^2 $val19 $val12^2, $val12 $val18= 0, $val11 $val19 $val12, 2, 4	$val11^2 $val19 $val12^2, $val12 $val19= 0, $val11 $val18 $val12, 3, 3	
val20=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val20

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!item 1 of $val20

val21=$(tmp0)
tmp0=!randitem 1,2

!if $(tmp0)=1 
tmp0=!item 2 of $val20

val22=$(tmp0)
tmp0=!item 3 of $val20

val23=$(tmp0)
tmp0=!item 4 of $val20

val24=$[rint($(tmp0))]
!else
tmp0=!item 3 of $val20

val22=$(tmp0)
tmp0=!item 2 of $val20

val23=$(tmp0)
tmp0=!item 5 of $val20

val24=$[rint($(tmp0))]
!endif
m_minsteps=$val24
m_context=$val21	$val22
m_goal=$val23
val25=$m_goal
question=__EXECUTED_1692754_EXERCISE__

