!set title=Carré borné I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Bounded square I

varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Soit \(\x\) un nombre réel avec
val10=Il faut faire une démonstration par contradiction.
!if $val6=en 
val7=Prove
val8=and
val9=Let \(\x\) be a real number with
val10=A proof by contradiction is necessary.
!endif
m_environ=QQ
m_options=nofloat
tmp=!nonempty items constineq,obvineq

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items mulnum, divnum

tmp0=!randitem $tmp
val12=$(tmp0)
tmp=!nonempty items addnum, addterm

tmp0=!randitem $tmp
val13=$(tmp0)
tmp=!nonempty items addineq, trans

tmp0=!randitem $tmp
val14=$(tmp0)
tmp=!nonempty items ineq/sqrpos, ineq/splitineq, prf/splitgoal, exp/rewrite

tmp0=!randitem $tmp
val15=$(tmp0)
m_methods=ineq/$val13, ineq/$val12, ineq/exsides,	ineq/$val11, ineq/$val14, ineq/mulineq,	$val15,prf/contrapose
tmp=!nonempty items a,b,c,d,r,s,t,x,y,z

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!randint 8, 60

val17=$[rint($(tmp0))]
val18=$[rint($val17^2)]
val19=
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val20=$[rint($(tmp0))]
!if $val20=1 
m_minsteps=2
!else
m_minsteps=3
!endif
tmp=!nonempty items ,=

tmp0=!randitem $tmp
val21=$(tmp0)
val22=<$val21
val23=>$val21
tmp0=!item $val20 of $val16 $val22 $val17, $val16 $val23 -$val17

val24=$(tmp0)
val25=$val16^2 $val22 $val18
m_context=$val25
m_goal=$val24
val26=$m_goal
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  $val10 


!goto stat

!exit

:question
$()	$val9		
!insmath $val25 = $val17^2
$().		$val7 
!insmath  $val26 
$().	
$()
!exit

:hint
$() $val10 
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,17,25,26
embedcnt=0
