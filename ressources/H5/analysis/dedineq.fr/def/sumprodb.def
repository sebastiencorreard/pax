!set title=Somme et produit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Sum and product

varcnt=18
prevarcnt=14
postvarcnt=3
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Soient \(a\) et \(b\) deux entiers tels que
!if $val6=en 
val7=Prove
val8=and
val9=Let \(a\) and \(b\) be two integers such that
!endif
m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=7
tmp0=!randint 100, 200

val10=$[rint($(tmp0))]
tmp0=!randint 50, 200

val11=$[rint(ceil($val10^2/4)+$(tmp0))]
tmp0=!randitem <,<=

val12=$(tmp0)
val13=<
val14=>
val15=-$val10 $val12 a + b
val16=a + b $val12 $val10
m_context=$val15	$val16	
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9	
!insmath -$val10 $val12 a + b $val12 $val10
$().	$val7	<div class="wimscenter">
!insmath  a*b $val13 $val11 
$() .</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!nospace $m_newobject

val17=$(tmp0)
val18=a*b
val19=b*a

!exit

:feedback

!exit

:test

!ifval $val17 iswordof $val18$val13$val11 $val19$val13$val11	 $val11$val14$val18 $val11$val14$val19	
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=7,9,10,11,12,13,14
embedcnt=0
