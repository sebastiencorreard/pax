!set title=Fraction simple II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Simple fraction II

varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Montrez que l'inégalité, n'a pas de solution quand
!if $val6=en 
val7=Prove
val8=and
val9=Prove that the inequality,has no solution when
!endif
m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides	ineq/trans, ineq/addineq, ineq/mulineq
m_minsteps=4
tmp=!nonempty items a,b,c,d,p,q,r,s,t,u,v,x,y,z

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!shuffle 15

val11=$(tmp0)
tmp0=!item 1 of $val11

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val12=$[rint(($(tmp0)+1)*$(tmp1))]
tmp0=!item 2 of $val11

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val13=$[rint(($(tmp0)+1)*$(tmp1))]
tmp0=!item 3 of $val11

val14=$[rint(($(tmp0)+1))]
tmp=!trim >,<,1	<,>,-1	
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

tmp1=!randitem ,=

val16=$(tmp0)$(tmp1)
tmp0=!item 2 of $val15

val17=$(tmp0)
tmp0=!item 3 of $val15

val18=$[rint($(tmp0))]
tmp0=!randint 1, 10

val19=$[rint(-($val13)+($val18)*$(tmp0))]
val20=!rawmath ($val10 + $val12)/($val10 + $val13)
val21=$[($val19+($val12))/($val19+($val13))]

!ifval $val21>1
val14=$[rint(1-$val14)]
!else
val14=$[rint(1+$val14)]
!endif

!ifval $val21>1
val17=<
!else
val17=>
!endif
tmp=!nonempty items ,=

tmp0=!randitem $tmp
val22=$(tmp0)
val23=$val17$val22
val24=$val10 $val16 $val19
val25=$val20 $val23 $val14
m_context=$val24	$val25
m_goal=contradiction
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val9[1]) 
!insmath $val20 $val23 $val14
$() $(val9[2]) 
!insmath $val10 $val16 $val19
$().	
$()
!exit

