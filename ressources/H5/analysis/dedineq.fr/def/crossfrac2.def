!set title=Fractions croisées II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Cross fractions II

varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=positif,négatif
val10=Soit \(\x) un, strictement
val11=entier, nombre rationnel, nombre réel
!if $val6=en 
val7=Prove
val8=and
val9=positive,negative
val10=Let \(\x) a, strictly
val11=integer, rational number, real number
!endif
m_options=nofloat expand
tmp=!nonempty items trans,addineq

tmp0=!randitem $tmp
val12=$(tmp0)
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/divexp,	ineq/$val12, ineq/mulineq, ineq/sqrpos
m_minsteps=3
tmp=!nonempty items $val11

tmp0=!randitem $tmp
val13=$(tmp0)
tmp=!nonempty items a,b,c,d,r,s,t,u,v,x,y,z

tmp0=!randitem $tmp
val14=$(tmp0)
tmp=!trim >,>=,2,$(val9[1])	<,<=,-2,$(val9[2])	
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$(tmp0)
tmp0=!item 2 of $val15

val17=$(tmp0)
tmp0=!item 3 of $val15

val18=$(tmp0)
tmp0=!item 4 of $val15

val19=$(tmp0)
tmp0=!randint 6, 99

val20=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val14/$val20 + $val20/$val14;
tmp0=!exec maxima $t_

val21=$(tmp0)
val22=$val21 $val17 $val18
m_context=$val14 $val16 0	
m_goal=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		$(val10[1]) $val13 $(val10[2]) $val19.		$val7 
!insmath  $val22 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,13,19,22
embedcnt=0
