!set title=Fraction simple I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Simple fraction I

varcnt=28
prevarcnt=24
postvarcnt=3
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Résoudre l'inégalité, avec la condition 
val10=L'objectif de l'exercice est de transformer l'inégalité donnée en une	  inégalité équivalente dont la partie gauche est, et dont la partie droite	  est une constante.
!if $val6=en 
val7=Prove
val8=and
val9=Solve the inequality, under the condition 
val10=The goal of the exercise is to transform the given	  inequality into an equivalent one whose left side is, and whose right side	  is a constant.
!endif
m_options=nofloat askresult
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides
m_minsteps=3
tmp=!nonempty items a,b,c,d,p,q,r,s,t,u,v,x,y,z

tmp0=!randitem $tmp
val11=$(tmp0)
tmp0=!shuffle 15

val12=$(tmp0)
tmp0=!item 1 of $val12

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val13=$[rint(($(tmp0)+1)*$(tmp1))]
tmp0=!item 2 of $val12

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val14=$[rint(($(tmp0)+1)*$(tmp1))]
tmp0=!item 3 of $val12

val15=$[rint(($(tmp0)+1))]
val16=$[rint(-($val14))]
tmp=!trim >,<,1	<,>,-1	
val17=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$(tmp0)
tmp0=!item 2 of $val17

val19=$(tmp0)
tmp0=!item 3 of $val17

val20=$[rint($(tmp0))]
val21=!rawmath ($val11 + $val13)/($val11 + $val14)
val22=$[($val13-($val14))*($val20)]

!ifval $val22>0
val15=$[rint(1+$val15)]
!else
val15=$[rint(1-$val15)]
!endif
tmp=!nonempty items <,>,<=,>=

tmp0=!randitem $tmp
val23=$(tmp0)
m_equivalence=$val21 $val23 $val15
m_context=$val11 $val18 $val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val9[1]) 
!insmath $val21 $val23 $val15
$(), $(val9[2]) 
!insmath $val11 $val18 $val16
$().	<p>	$(val10[1]) $val11, $(val10[2])	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!translate internal <=> to , , in $m_equivalence

val24=$(tmp0)
tmp0=!item 1 of $val24

val25=$(tmp0)
tmp0=!item 2 of $val24

val26=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val25 issametext $val11 and $val11 notin $val26
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=9,10,11,15,16,18,21,23
embedcnt=0
