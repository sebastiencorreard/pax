m_options=nofloat
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/divexp,	ineq/trans, ineq/addineq	prf/contrapose
m_minsteps=3
tmp=!trim a,b,c,d	x,y,z,t	r,s,t,u	p,q,r,s	
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val11

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$(tmp0)
tmp0=!item 2 of $val11

val13=$(tmp0)
tmp0=!item 3 of $val11

val14=$(tmp0)
tmp0=!item 4 of $val11

val15=$(tmp0)
tmp0=!randitem ,=

val16=$(tmp0)
tmp0=!shuffle >,<

val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$(tmp0)$val16
tmp0=!item 2 of $val17

val19=$(tmp0)$val16
tmp=!trim $(val10[1]),>,$val18,$val19	$(val10[2]),<,$val19,$val18	
val20=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val20

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!item 1 of $val20

val21=$(tmp0)
tmp0=!item 2 of $val20

val22=$(tmp0)
tmp0=!item 3 of $val20

val23=$(tmp0)
tmp0=!item 4 of $val20

val24=$(tmp0)
tmp=!translate ";': to $     $ in $val12*$val13 $val19 $val14*$val15

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
val26=$val12 $val23 $val14
val27=$val13 $val24 $val15
m_context=$val12 $val22 0	$val13 $val22 0	$val14 $val22 0	$val15 $val22 0	$val25	$val26
m_goal=$val27
val28=$m_goal
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

