!set title=Somme et produit I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Sum and product I

varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Soient \(a\) et \(b\) deux entiers tels que
!if $val6=en 
val7=Prove
val8=and
val9=Let \(a\) and \(b\) be two integers such that
!endif
m_options=nofloat
m_methods=ineq/addterm, ineq/mulnum, ineq/divnum, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=7
tmp0=!randint 100, 200

val10=$[rint($(tmp0))]
tmp0=!randint 100, 500

val11=$[rint(ceil($val10^2/4)+$(tmp0))]
tmp0=!randitem <,<=

val12=$(tmp0)
tmp0=!randitem <,<=

val13=$(tmp0)
val14=<
val15=>
val16=0 $val12 a + b
val17=a + b $val13 $val10
m_context=$val16	$val17	
m_goal=a*b $val14 $val11
val18=$m_goal
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9	
!insmath 0 $val12 $val17
$().	$val7	<div class="wimscenter">
!insmath  $val18 
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,12,17,18
embedcnt=0
