!set title=Résolution linéaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Linear solve

varcnt=23
prevarcnt=17
postvarcnt=5
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Résoudre pour,l'inégalité
val10=L'objectif de l'exercice est de transformer l'inégalité donnée en une	  inégalité équivalente dont la partie gauche est , et dont la partie droite	  est une expression de 
!if $val6=en 
val7=Prove
val8=and
val9=Solve for,the inequality
val10=The goal of the exercise is to transform the given inequality into an	  equivalent one where the left part is , and the right part	  is an expression of
!endif
m_options=nofloat askresult
m_methods=ineq/addterm, ineq/mulnum, ineq/divnum, ineq/exsides
m_minsteps=2
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
val15=!rawmath $val11*x + $val14
tmp=!nonempty items <,<=,>,>=

tmp0=!randitem $tmp
val16=$(tmp0)
val17=!rawmath $val12*x + $val13*y
val18=
m_equivalence=$val15 $val16 $val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val9[1]) 
!insmath \y
$() $(val9[2]) 
!insmath $val15 $val16 $val17
$().	<p>	$(val10[1]) 
!insmath \y
$(), $(val10[2]) 
!insmath \x
$().	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!translate internal <=> to , , in $m_equivalence

val19=$(tmp0)
tmp0=!item 1 of $val19

val20=$(tmp0)
tmp0=!item 2 of $val19

val21=$(tmp0)
tmp0=!varlist $val21

val18=$(tmp0)
val22=

!exit

:feedback

!exit

:test

!ifval $val20 issametext y and	 ($val18 issametext x or $val18 issametext $val22)
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=9,10,15,16,17,18
embedcnt=0
