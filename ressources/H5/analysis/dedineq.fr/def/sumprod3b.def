val7=Prove
val8=and
val9=Let, three, such that
val10=integers, rational numbers, real numbers
val11=One should prove, And for this, you should start
!endif
m_options=nofloat fixedgoal
tmp=!nonempty items constineq,obvineq

tmp0=!randitem $tmp
val12=$(tmp0)
tmp=!nonempty items trans,addineq

tmp0=!randitem $tmp
val13=$(tmp0)
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/lincomb,	ineq/$val12, ineq/$val13, ineq/mulineq, ineq/sqrpos
m_minsteps=7
tmp=!trim x,y,z	a,b,c	r,s,t	l,m,n	u,v,w	
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$(tmp0)
tmp0=!item 3 of $val14

val17=$(tmp0)
tmp0=!randint 10, 60

val18=$[rint(3*$(tmp0))]
val19=$[rint($val18^2/3)]
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val20=$(tmp0)
tmp0=!randitem <,<=

val21=$(tmp0)
val22=$val15 + $val16 + $val17 $val21 $val18
val23=0 $val21 $val15 + $val16 + $val17
val24=$val15*$val16 + $val15*$val17 + $val16*$val17 $val21 $val19
m_context=$val23	$val22	
m_goal=$val24
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

