!insmath $val15*$val16 + $val15*$val17 + $val16*$val17 $val21 $val15^2 + $val16^2 + $val17^2
$().	</div>	$(val11[2]), $(val11[3]) 
!insmath 2*$val15*$val16 $val21 $val15^2 + $val16^2
$(), etc.	
$()
