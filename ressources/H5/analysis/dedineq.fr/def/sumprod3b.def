$()$(val9[1]) 
!insmath $val15, $val16, $val17
$() $(val9[2]) $val20 $(val9[3])	  
!insmath  0 $val21 $val22 
$().	$val7	<div class="wimscenter">
!insmath $val24
$().</div>	
$()
!exit

:hint
