!set title=Somme et produit II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Sum and product II

varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=nombres rationnels, nombres réels
val10=Soient, deux,,positifs, tels que
!if $val6=en 
val7=Prove
val8=and
val9=rational numbers, real numbers
val10=Let, two,positive,,such that
!endif
m_options=nofloat
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/lincomb,	ineq/mulnum, ineq/divnum, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=4
tmp=!trim a,b	c,d	r,s	s,t	u,v	x,y	
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val11

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!item 1 of $val11

val12=$(tmp0)
tmp0=!item 2 of $val11

val13=$(tmp0)
tmp0=!random $val9

val14=$(tmp0)
tmp0=!shuffle 25

val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$[rint($(tmp0)+2)]
tmp0=!item 2 of $val15

val17=$[rint($(tmp0)+2)]
tmp0=!randint 50, 100

val18=$[rint($(tmp0)*2)]
t_=!rawmath $val18^2/(4*$val16*$val17)
val19=!exec pari print($t_)
tmp0=!randitem <,<=

val20=$(tmp0)
val21=!rawmath $val16*$val12 + $val17*$val13
val22=$val21 $val20 $val18
m_context=$val12 > 0	$val13 > 0	$val22	
val23=$val12*$val13 $val20 $val19
m_goal=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath $val12
$() $val8 
!insmath $val13
$() $(val10[2]) $val14 $(val10[3]) $(val10[4])	
!insmath $val22
$().	$val7	<div class="wimscenter">
!insmath  $val23 
$() .</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,12,13,14,22,23
embedcnt=0
