!set title=Produit donné
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Given product

varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
!if $val6=en 
val7=Prove
val8=and
!endif
m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides,	ineq/trans, ineq/addineq, ineq/mulineq,	prf/contrapose
m_minsteps=3
tmp=!trim a,b	c,d	x,y	r,s	s,t	p,q	
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)
tmp0=!randint 3, 20

val12=$[rint($(tmp0))]
tmp0=!randint 3, 20

val13=$[rint($(tmp0))]
val14=$[rint($val12*$val13)]
val15=
tmp0=!randitem ,=

val16=$(tmp0)
val17=<$val16
val18=>$val16
val19=$val10*$val11 $val17 $val14
val20=$val10 $val18 $val12
val21=$val11 $val17 $val13
m_context=$val19	$val20
m_goal=$val21
val22=$m_goal
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$m_name_enonce 
!insmath $val19
$() $val8 
!insmath $val20
$().	$val7 
!insmath  $val22 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,19,20,22
embedcnt=0
