m_minsteps=3
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val13=$(tmp0)
tmp=!trim a,b	c,d	x,y	r,s	s,t	p,q	
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$(tmp0)
tmp=!trim >,>,>=,2	<,<,>=,2	<,>,<=,-2	>,<,<=,-2	
val17=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$(tmp0)
tmp0=!item 2 of $val17

val19=$(tmp0)
tmp0=!item 3 of $val17

val20=$(tmp0)
tmp0=!item 4 of $val17

val21=$(tmp0)
t_=!replace internal \( by ( in $val15/$val16 + $val16/$val15;
tmp0=!exec maxima $t_

val22=$(tmp0)
val23=$val22 $val20 $val21
m_context=$val15 $val18 0	$val16 $val19 0	
m_goal=$val23
question=__EXECUTED_1692754_EXERCISE__

