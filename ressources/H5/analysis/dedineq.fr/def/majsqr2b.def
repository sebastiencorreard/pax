!set title=Majorer le carré IIb
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr
title_en=Upper-bound the square IIb

varcnt=21
prevarcnt=19
postvarcnt=1
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Montrez que
val8=et
val9=Soit \(\x\) un nombre réel avec
!if $val6=en 
val7=Prove
val8=and
val9=Let \(\x\) be a real number with
!endif
m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=4
tmp=!nonempty items a,b,c,d,r,s,t,x,y,z

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!randint 2, 100

val11=$[rint($(tmp0))]
tmp0=!randint 2, 100

val12=$[rint($(tmp0))]
val13=$[rint(max($val11,$val12))]
val14=$[rint($val13^2)]
tmp0=!randint 2, 200

val15=$[rint($val14+$(tmp0))]
tmp=!nonempty items ,=

tmp0=!randitem $tmp
val16=$(tmp0)
val17=<$val16
val18=>$val16
val19=$val10 $val18 -$val11
val20=$val10 $val17 $val12
val21=$val10^2<$val15
m_context=$val19	$val20	
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9 
!insmath -$val11 $val17 $val10 $val17 $val12
$().	$val7 
!insmath  $val10^2 < $val15 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!nospace $m_newobject

val22=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val22 issametext $val21
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=7,9,10,11,12,15,17,21
embedcnt=0
