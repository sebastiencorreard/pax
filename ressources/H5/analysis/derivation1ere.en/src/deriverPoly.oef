\title{The derivative of a polynomial}
\language{en}
\range{-5..5}
\author{Véronique Royer}
\email{royer.veronique@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..10)}
\integer{b = random(-1,1)*random(1..10)}
\integer{c = random(-1,1)*random(1..10)}
\integer{d = random(-1,1)*random(1..10)}
\integer{e = random(-1,1)*random(1..10)}

\rational{a1 = \a/randint(2..5)}
\rational{b1 = \b/randint(2..5)}
\rational{c1 = \c/randint(2..5)}
\rational{d1 = \d/randint(2..5)}

\real{a2 = random(-1,1)*randint(1..100)/100}
\real{b2 = random(-1,1)*randint(1..100)/100}
\real{c2 = random(-1,1)*randint(1..100)/100}
\real{d2 = random(-1,1)*randint(1..100)/100}


\function{f=randitem(\e,
\a *x^4 + \b*x^3+ \c*x^2 + \d*x + \e,
\a*x^3+ random(\c*x^2 , \d*x) + \e,
 \a*x^2 + \d*x+ \e,
 \a*x^2 + \e,
 \a*x + \e,
\a1*x^3+ random(\b1*x^2 , \c1*x) + \d1,
\a1*x^2 + \c1*x + \d1,
\a1*x^2 + \d1,
\a1*x+\d1,
\a2*x^3+ random(\b2*x^2 , \c2*x) + \d2,
\a2*x^2 + \c2*x + \d2,
\a2*x^2 + \d2,
\a2*x + \d2
)}



/** bonnes réponses **/
\function{derivee = diff(\f,x)}
\text{nicefunction = wims(texmath f(x)=\f)}


\statement{
<div style="border: thin solid blue;padding:1%">
<p>
Let \(f) be a polynomial, defined in \RR by
\(\nicefunction)
.
</p><p>Let \(f) be differentiable in \RR.
Determine the derivative.
</p>
</div>
<div class="wimscenter">
For all real \(x),   &nbsp; \(f'(x)) =  \embed{reply1,30}
</div>

}
\answer{}{\derivee}{type=function}


\hint{
<p>If \(f(x)\,=\,x^{n}) then \(f'(x)\,=\,nx^{n-1}) </p>
<p>If \(f(x)\,=\,k \cdot u(x)) then \(f'(x)\,=\,k \cdot u'(x)) </p>
<p>If \(f(x)\,=\,u(x)+v(x)) then \(f'(x)\,=\,u'(x)+v'(x)) </p>
The derivative of a polynomial is determined term by term.
}
