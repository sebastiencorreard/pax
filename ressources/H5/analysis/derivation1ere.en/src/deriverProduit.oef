\title	{The product rule}
\author	{Véronique Royer}
\email	{royer.veronique@wanadoo.fr}
\format	{html}
\language{en}
\integer{a1=random(1..8)*random(1,-1)}
\integer{a2=random(1..8)*random(1,-1)}
\integer{c1=random(1..8)*random(1,-1)}
\integer{c2=random(1..8)*random(1,-1)}
\integer{c3=random(1..8)*random(1,-1)}
\integer{c4=random(1..8)*random(1,-1)}

\function{u=randitem(
 \a1*x+\a2,
 \a1*x^randint(2,3)
)}

\function{v=randitem(\c1*x^2+\c2*x+\c3,
\c3*x^2+random(\c4,\c4*x),
\c3*x+\c4)}

\function{f=(\u)(\v)}
\function{U=diff(\u,x)}
\function{V=diff(\v,x)}
\function{F=diff(\f,x)}
\function{factorF=maxima(factor(\F))}
\function{devF=maxima(expand(\F))}
\text{UU=texmath(\u)}
\text{VV=texmath(\v)}
\text{formule= \(f'=u'v+uv')}
\text{list= \(f'=u'v') , \(f'=u'v+uv'), \(f'=u'v-uv')}
\text{choix=shuffle(\list)}
\integer{rep3=position(\formule,\choix)}

\statement{

<div style="border: thin solid blue;padding:1%"><p>Determine the derivative of a function in \RR defined by
 \(f(x) = u(x) \cdot v(x)) with :</p>
<div class="wimscenter">
\(\begin{array}{l} u(x) \, = \, \UU \\ v(x) \, = \, \VV \end{array})</div>
<p>
The functions \(u) and \(v) are differentiable in \(RR) and :</p>
<div class="wimscenter">\(u'(x)) = \embed{reply1,20} </div>
<div class="wimscenter">\(v'(x)) = \embed{reply2,20} </div>
<p>
In order to determine the derivative of \(f) &nbsp; we apply the following rule of differentiation:
</p>
<div class="wimscenter">\embed{reply3}</div>
<p>
The derivative function of \(f) &nbsp; will be :</p>
<div class="wimscenter">\(f'(x)) = \embed{reply4, 30}</div>
}
\answer{The derivative \(u'(x)) }{\U}{type=formal}
\answer{The derivative \(v'(x)) }{\V}{type=formal}
\answer{The applied rule of differentiation }{\rep3;\choix}{type=checkbox}
\answer{The derivative \(f'(x))  }{\devF}{type=algexp}
\feedback{0==0}{<b>Solution.</b> <br/>
The normal form of \(f'(x)) is \(\devF). <br/>
The factorized form of \(f'(x)) is \(\factorF).}
