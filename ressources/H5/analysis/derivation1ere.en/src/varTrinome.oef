\title	{Investigate a Function}
\author	{Véronique Royer}
\email	{royer.veronique@wanadoo.fr}
\format	{html}
\language{en}

\integer{a1=random(1..3)*random(1,-1)}
\integer{a2=random(1..3)*random(1,-1)}
\rational{c1=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c2=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c3=randint(1..10)*random(1,-1)/randint(1,2,3,5)}

\text{flist=\c1*x^2+\c2*x+\c3,
\c1*x^2+\c2*x,
\c1*x^2+\c3,
\c1*(\a2*x+\a1)^2}

\integer{\cas=random(1..4)}
\function{f=item(\cas,\flist)}

\function{F=diff(\f,x)}

\rational{x0=\cas<3?-(\c2)/(2*\c1) }
\rational{x0=\cas==3?0 }
\rational{x0=\cas==4?-(\a1/\a2) }
\rational{valextr=evaluate(\f,x=\x0)}
\text{inf=&#8734}
\text{I1=\(\langle) -&#8734; ; \(\x0) \(\rangle)}
\text{I2=\(\langle) \(\x0) ; +&#8734; \(\rangle)}
\text{choix3=+,-}
\integer{rep3=\c1>0?2:1}
\text{choix4=+,-}
\integer{rep4=\c1>0?1:2}
\text{choix5=ascending,descending}
\integer{rep5=\rep3}
\text{choix6=ascending,descending}
\integer{rep6=\rep4}
\text{choix7=minimum,maximum}
\integer{rep7=\rep6}
\steps{reply1,reply2
reply3,reply4,reply5,reply6,reply7,reply8
}


\statement{
<div style="border: thin solid blue;padding:1%">
Given the function \(f) defined in \RR by &nbsp;\(f(x) = \f).
<p>
Investigate this function and determine the extremum (extrema) of \(f).
</p>
</div>
\if{\step==1}{
<ol>
<li>The function \(f) is differentiable in \RR :
<div class="wimscenter">for all real \(x) : &nbsp; \(f'(x)\,=\,) \embed{reply1,20}
</div></li>
<li>The nature of the derivative function \(f') :
<div class="wimscenter">The derivative of \(f') is zero for \(x)  =  \embed{reply2,10}
</div></li>
</ol>
}
\if{\step>1}{
<ol>
<li>The derivative of \(f) :
<div class="wimscenter"> \(f'(x) = \F )</div>
</li>
<li>The nature of the sign of \(f') :
<table class="wimscenter wimsborder" style="width:50%"
<tr>
<td style="width:10%;text-align:center"> \(x)</td>
<td style="width:30%;text-align:left">-\inf</td>
<td style="width:5%;text-align:center">\x0</td>
<td style="width:30%;text-align:right">+\inf</td>
</tr>
<tr>
<td style="width:10%;">\(f'(x))</td>
<td style="width:30%;">
\embed{reply3} </td><td style="width:5%;">0</td>
<td style="width:30%;">
 \embed{reply4}</td>
</tr>
</table>
</li>
<li>The nature of the sign of \(f) :
<ul>
<li>
\(f) is \embed{reply5} on the interval \I1
</li>
<li>
\(f) is \embed{reply6} on the interval \I2
</li>
</ul>
</li>
<li>The extremum of  \(f) :
<ul>
<li> \(f) reaches in \(\x0) a \embed{reply7} with value \embed{reply8, 10}
</li>
</ul>
</li>
</ol>
}
}
\answer{the derivative \(f'(x))}{\F}{type=formal}
\answer{f'(x) is zero in }{\x0}
\answer{The sign of f' }{\rep3;\choix3}{type=menu}
\answer{The sign of f'}{\rep4;\choix4}{type=menu}
\answer{f ascends}{\rep5;\choix5}{type=menu}
\answer{f decenst}{\rep6;\choix6}{type=menu}
\answer{The type of extremum}{\rep7;\choix7}{type=menu}
\answer{The value of the extremum \(f)}{\valextr}

\hint{When the derivative f' changes it's sign for a particular x-value ,<br>
is is known as the "local" extremum of \(f) (a minimum or maximum). }
