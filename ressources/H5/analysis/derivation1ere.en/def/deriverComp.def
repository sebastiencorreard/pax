!set title=The derivative of a combined function
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique Royer
email=royer.veronique@wanadoo.fr
language=en
language=nl

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath $val6*x+$val7
t_=!rawmath -$val7/$val6
val10=!exec pari print($t_)
tmp0=!randitem 2,3

tmp1=!randitem 2,3

val11=!rawmath sqrt($val9),	 $val8/($val9),	 $val8*($val9)^$(tmp0),	 ($val9)^$(tmp1)+$val8,	
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
tmp0=!texmath $val14

val15=$(tmp0)
tmp0=!texmath $val13

val16=$(tmp0)
val17=&#8734

!ifval $val12==1 and $val6>0
val18=\($val10)
!endif

!ifval $val12==1 and $val6>0
val19=+$val17
!endif

!ifval $val12==1 and $val6<0
val19=\($val10)
!endif

!ifval $val12==1 and $val6<0
val18=-$val17
!endif

!ifval $val12==1
val20= on the interval \(\langle) $val18 &#44; $val19 \(\rangle)
!endif

!ifval $val12==2
val20= in \(\RR \setminus \{$val10\})
!endif

!ifval $val12>2
val20= in \(\RR) 
!endif
replytype1=formal
replyname1=The derivative \(f'(x))
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div style="border: thin solid blue;padding:1%">	Given the function : 
!insmath f(x) \,=\, $val16 
$() <br>	Determine the derivative in $val20	<p class="wimscenter"> 
!insmath f'(x)
$() =  
!read oef/embed.phtml reply1, 40 
$()</p>		
!if $val12==1 
$()<p>NB : <i>write </i> "sqrt(a x+b)" <i>for 
!insmath sqrt(a x+b)
$()</i></p> 
!endif
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 0==0
 <div class='oef_feedbacks'>The derivative function is : 
!insmath f'(x) \,=\, $val15
$().
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,15,16,20
embedcnt=1
