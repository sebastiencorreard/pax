!set title=Investigate a Function
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique Royer
email=royer.veronique@wanadoo.fr
language=en

ansorder=r,r,r,r,r,r,r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val8=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val9=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val10=!exec pari print($t_)
val11=$val8*x^2+$val9*x+$val10,	$val8*x^2+$val9*x,	$val8*x^2+$val10,	$val8*($val7*x+$val6)^2
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)

!ifval $val12<3
t_=!rawmath -($val9)/(2*$val8) 
val15=!exec pari print($t_)
!endif

!ifval $val12==3
t_=!rawmath 0 
val15=!exec pari print($t_)
!endif

!ifval $val12==4
t_=!rawmath -($val6/$val7) 
val15=!exec pari print($t_)
!endif
evaltmp=$val13

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
val17=&#8734
val18=\(\langle) -&#8734; ; \($val15) \(\rangle)
val19=\(\langle) \($val15) ; +&#8734; \(\rangle)
val20=+,-

!ifval $val8>0
val21=$[rint(2)]
!else
val21=$[rint(1)]
!endif
val22=+,-

!ifval $val8>0
val23=$[rint(1)]
!else
val23=$[rint(2)]
!endif
val24=ascending,descending
val25=$[rint($val21)]
val26=ascending,descending
val27=$[rint($val23)]
val28=minimum,maximum
val29=$[rint($val27)]
oefsteps=reply1,reply2	reply3,reply4,reply5,reply6,reply7,reply8 
nextstep=!nosubst reply1,reply2	reply3,reply4,reply5,reply6,reply7,reply8 
!readproc oef/steps.proc
replytype1=formal
replyname1=the derivative \(f'(x))
replygood1=$val14
replyname2=f'(x) is zero in
replygood2=$val15
replytype3=menu
replyname3=The sign of f'
replygood3=$val21;$val20
replytype4=menu
replyname4=The sign of f'
replygood4=$val23;$val22
replytype5=menu
replyname5=f ascends
replygood5=$val25;$val24
replytype6=menu
replyname6=f decenst
replygood6=$val27;$val26
replytype7=menu
replyname7=The type of extremum
replygood7=$val29;$val28
replyname8=The value of the extremum \(f)
replygood8=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="border: thin solid blue;padding:1%">	Given the function 
!insmath f
$() defined in $m_RR by &nbsp;
!insmath f(x) = $val13
$().	<p>	Investigate this function and determine the extremum (extrema) of 
!insmath f
$().	</p>	</div>	
!if $m_step==1 
$()	<ol>	<li>The function 
!insmath f
$() is differentiable in $m_RR :	<div class="wimscenter">for all real 
!insmath x
$() : &nbsp; 
!insmath f'(x)\,=\,
$()  
!read oef/embed.phtml reply1,20 
$()	</div></li>	<li>The nature of the derivative function 
!insmath f'
$() :	<div class="wimscenter">The derivative of 
!insmath f'
$() is zero for 
!insmath x
$()  =   
!read oef/embed.phtml reply2,10 
$()	</div></li>	</ol>	 
!endif
$()	
!if $m_step>1 
$()	<ol>	<li>The derivative of 
!insmath f
$() :	<div class="wimscenter"> 
!insmath f'(x) = $val14 
$()</div>	</li>	<li>The nature of the sign of 
!insmath f'
$() :	<table class="wimscenter wimsborder" style="width:50%"	<tr>	<td style="width:10%;text-align:center"> 
!insmath x
$()</td>	<td style="width:30%;text-align:left">-$val17</td>	<td style="width:5%;text-align:center">$val15</td>	<td style="width:30%;text-align:right">+$val17</td>	</tr>	<tr>	<td style="width:10%;">
!insmath f'(x)
$()</td>	<td style="width:30%;">	 
!read oef/embed.phtml reply3 
$() </td><td style="width:5%;">0</td>	<td style="width:30%;">	  
!read oef/embed.phtml reply4 
$()</td>	</tr>	</table>	</li>	<li>The nature of the sign of 
!insmath f
$() :	<ul>	<li>	
!insmath f
$() is  
!read oef/embed.phtml reply5 
$() on the interval $val18	</li>	<li>	
!insmath f
$() is  
!read oef/embed.phtml reply6 
$() on the interval $val19	</li>	</ul>	</li>	<li>The extremum of  
!insmath f
$() :	<ul>	<li> 
!insmath f
$() reaches in 
!insmath $val15
$() a  
!read oef/embed.phtml reply7 
$() with value  
!read oef/embed.phtml reply8, 10 
$()	</li>	</ul>	</li>	</ol>	 
!endif
$()	
$()
!exit

:hint
$()When the derivative f' changes it's sign for a particular x-value ,<br>	is is known as the "local" extremum of 
!insmath f
$() (a minimum or maximum). 
