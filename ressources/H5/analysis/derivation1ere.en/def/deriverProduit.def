!set title=The product rule
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique Royer
email=royer.veronique@wanadoo.fr
language=en

ansorder=r,r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,3

tmp=!nonempty items 	 $val6*x+$val7,	 $val6*x^$(tmp0)	

tmp1=!randitem $tmp
val12=!rawmath $(tmp1)
tmp0=!randitem $val11,$val11*x

tmp=!nonempty items $val8*x^2+$val9*x+$val10,	$val10*x^2+$(tmp0),	$val10*x+$val11

tmp1=!randitem $tmp
val13=!rawmath $(tmp1)
val14=!rawmath ($val12)($val13)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in factor($val17)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val17)
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
tmp0=!texmath $val12

val20=$(tmp0)
tmp0=!texmath $val13

val21=$(tmp0)
val22=\(f'=u'v+uv')
val23=\(f'=u'v') , \(f'=u'v+uv'), \(f'=u'v-uv')
tmp0=!shuffle $val23

val24=$(tmp0)
tmp0=!positionof item $val22 in $val24

val25=$[rint($(tmp0))]
replytype1=formal
replyname1=The derivative \(u'(x))
replygood1=$val15
replytype2=formal
replyname2=The derivative \(v'(x))
replygood2=$val16
replytype3=checkbox
replyname3=The applied rule of differentiation
replygood3=$val25;$val24
replytype4=algexp
replyname4=The derivative \(f'(x))
replygood4=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div style="border: thin solid blue;padding:1%"><p>Determine the derivative of a function in $m_RR defined by	 
!insmath f(x) = u(x) \cdot v(x)
$() with :</p>	<div class="wimscenter">	
!insmath \begin{array}{l} u(x) \, = \, $val20 \\ v(x) \, = \, $val21 \end{array}
$()</div>	<p>	The functions 
!insmath u
$() and 
!insmath v
$() are differentiable in 
!insmath RR
$() and :</p>	<div class="wimscenter">
!insmath u'(x)
$() =  
!read oef/embed.phtml reply1,20 
$() </div>	<div class="wimscenter">
!insmath v'(x)
$() =  
!read oef/embed.phtml reply2,20 
$() </div>	<p>	In order to determine the derivative of 
!insmath f
$() &nbsp; we apply the following rule of differentiation:	</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply3 
$()</div>	<p>	The derivative function of 
!insmath f
$() &nbsp; will be :</p>	<div class="wimscenter">
!insmath f'(x)
$() =  
!read oef/embed.phtml reply4, 30 
$()</div>	
$()
!exit

