!endif

tmp0=!randint 5, 15

val6=$[rint($(tmp0))]
val7=$[rint($val6*$val6)]
val8=$[rint($val6*$val7)]
val9=$[rint(3)]
val10=$[$val8]
!while $val10<7*10^7 
val10=$[$val10*$val6]
val9=$[rint($val9+1)]
!endwhile
val11=$[rint($val10/1000000)]
val12=\($val11 10^6)
val13=$[rint($val9)]
!while $val10<7*10^8 
val10=$[$val10*$val6]
val13=$[rint($val13+1)]
!endwhile
val14=$[rint($val10/10^6)]
val15=\($val14 10^6)
val16=$[rint($val13)]
!while $val10<7*10^9 
val10=$[$val10*$val6]
val16=$[rint($val16+1)]
!endwhile
val17=$[rint($val10/10^9)]
val18=\($val17 10^9)
val19=$[rint(floor(log(7*10^7)/log($val6)))]
val19=$[rint($val19+1)]
oefsteps=reply1,reply2	reply3,reply4,reply5 
nextstep=!nosubst reply1,reply2	reply3,reply4,reply5 
!readproc oef/steps.proc
replytype1=numeric
replyname1=\(u_2)
