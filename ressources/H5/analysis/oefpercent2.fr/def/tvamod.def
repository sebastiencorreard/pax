!set title=TVA modifiée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r,r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 200, 400

val6=$[0.1*$(tmp0)]
tmp0=!randint 50, 100

val7=$[0.1*$(tmp0)]
val8=$[1+0.01*$val6]
val9=$[1+0.01*$val7]
val10=$[($val9 - $val8)/$val8]
val11=$[100*$val10]
val12=$[rint(1000*($val8-$val9)/$val8)]
val12=$[0.1*$val12]
val13=$[1-0.01*$val6]
val14=$[0.01*$val6]
val15=$[1-0.01*$val7]
val16=$[0.01*$val7]
val17=$[$val9-$val8]
val18=Valeur Finale
val19=Valeur Initiale
val20=<p>Le taux d'évolution de l'ancien prix TTC au nouveau prix TTC est donné par la formule :<br>	\(\frac{$val18 - $val19}{$val19})</p>	<p> La valeur négative indique qu'il s'agit d'une diminution.</p>
val21=&#0151
val22=+ ($val6) %
val23=\(\times) $val8
val24=+ $val6
val25=$val21 $val6 %
val26=\(\times $val6/100)
val27=\(\times $val13)
val28=+ ($val7) %
val29=\(\times) $val9
val30=+ $val7
val31=$val21 $val7 %
val32=\(\times $val7/100)
val33=\(\times $val15)
val34=+ $val6/100
!readproc oef/draw.phtml 400,20 \
xrange 0,100	yrange -10,10	line 0,0,100,0,black 
tmp0=$ins_url
val35=$(tmp0)	
val36=$val23,$val29,$val26,$val32,$val34,$val27,$val33
val37=$val14,$val16,$val17,$val6,$val8,$val9
val38=100x30x1
oefsteps=reply1	reply2	reply3,reply4,reply5,reply6 
nextstep=!nosubst reply1	reply2	reply3,reply4,reply5,reply6 
!readproc oef/steps.proc
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val23;$val36
replytype2=clickfill
replyoption2=shuffle 
replyname2=
replygood2=$val29;$val36
replytype3=clickfill
replyoption3=shuffle 
replyname3=
replygood3=$val9;$val37
replytype4=clickfill
replyoption4=shuffle 
replyname4=
replygood4=$val8;$val37
replytype5=clickfill
replyoption5=shuffle 
replyname5=
replygood5=$val8;$val37
replytype6=numeric
replyname6=
replygood6=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">	<ul class="wims_nopuce">	<li>La TVA sur certains produits était de $val6 % du prix Hors Taxe (HT).</li>	<li>Le prix payé par le client est la somme du prix Hors Taxe et de la TVA, que l'on appelle le prix Toutes Taxes Comprises (TTC).</li>	<li>Le taux de la TVA sur ces produits a été réduit et est à présent $val7 %.</li>	<li>La question est de savoir quelle est le pourcentage de diminution sur le prix TTC en supposant que le prix HT reste le même.</li>	</ul>	</div>	  
!if $m_step=1 
$()	    Placer la bonne opération dans la case pour obtenir le prix TTC dans la situation initiale :	  <div class="wimscenter">	    <p>	    
!insmath \large{ HT\; \overset{\phantom{xx}+$val6 \%\phantom{xx}}{{\mapsto}}\; TTC1}
$()	    </p>	    <p> 
!read oef/embed.phtml reply1,$val38 
$()</p>	    </div>	 
!endif
$()	  
!if $m_step=2 
$()	  Placer la bonne opération dans la case pour obtenir le prix TTC avec le nouveau taux:	  <div class="wimscenter">	  <p>	  
!insmath \large{ HT\; \overset{\phantom{xx}+$val6 \%\phantom{xx}}{\underset{\times $val8}{\mapsto}}\; TTC1}
$()	  </p>	  <p>	  
!insmath \large{ HT\; \overset{\phantom{xx}+$val7 \%\phantom{xx}}{{\mapsto}}\; TTC2}
$()	  </p>	  <p>	   
!read oef/embed.phtml reply2,$val38 
$()	  </p>	  </div>	 
!endif
$()	  
!if $m_step=3 
$()	    <p>Comment calculer le pourcentage de diminution de TTC1 à TTC2 ?<br>	    Pour cela exprimer TTC1 et TTC2 en fonction de HT.</p>	    <div class="wimscenter">	    <p>	    
!insmath \large{ HT\; \overset{\phantom{xx}+$val6 \%\phantom{xx}}{\underset{\times $val8}{\mapsto}}\; TTC1 = $val8 \times HT}
$()	    </p>	    <p>	    
!insmath \large{ HT\; \overset{\phantom{xx}+$val7 \%\phantom{xx}}{\underset{\times $val9}{\mapsto}}\; TTC2 = $val9 \times HT}
$()	    </p>	    <p>	    
!insmath \large{ $val8 \times HT = TTC1\; \overset{\phantom{xx}- ? \%\phantom{xx}}{{\mapsto}}\; TTC2 = $val9 \times HT}
$()	    </p>	    </div>	    $val20	    Le taux d'évolution ici est donc :	    <div class="wimscenter">	    <p>	     
!read oef/embed.phtml reply3,$val38 
$() $m_times HT 
!insmath -
$()  
!read oef/embed.phtml reply4,$val38 
$() 
!insmath \times
$() HT	    </p>	    <p>	    <img src="$val35">	    </p>	    <p>	     
!read oef/embed.phtml reply5,$val38 
$() 
!insmath \times
$() HT	    </p>	    </div>	    <p>	    En déduire le  le pourcentage de diminution de TTC1 à TTC2 :	     
!read oef/embed.phtml reply6,5 
$() % (nombre positif à 0,1 % près).	    </p>	   
!endif
$()	
$()
!exit

:hint
$()	  
!if $m_step<3 
$()	      Le coefficient multiplicateur correspondant à une augmentation de 
!insmath p
$() % est :<br>	  
!insmath 1 + \frac{p}{100}
$()	   
!else
$() 	    $val20	    Le pourcentage de diminution est 
!insmath p = - 100 \times t
$().	   
!endif
$()	
$()
!exit

:help
$()
$()
!exit

:solution
$()	  <p>	  
!insmath \large{ HT\; \overset{\phantom{xx}+$val6 \%\phantom{xx}}{\underset{\times $val8}{\mapsto}}\; TTC1 = $val8 \times HT}
$()	  </p><p>	  
!insmath \large{ HT\; \overset{\phantom{xx}+$val7 \%\phantom{xx}}{\underset{\times $val9}{\mapsto}}\; TTC2 = $val9 \times HT}
$()	  </p><p>	  
!insmath \large{ $val8 \times HT = TTC1\; \overset{\phantom{xx}- ? \%\phantom{xx}}{{\mapsto}}\; TTC2 = $val9 \times HT}
$()	  </p>	  $val20	  <p>Ce qui conduit ici à :	  
!insmath \frac{$val9 HT - $val8 HT}{$val8 HT} = \frac{$val9 - $val8}{$val8} \approx $val10 =\frac{$val11}{100}
$()</p>	  Le pourcentage de diminution arrondi à 0,1 % près est : $val12 %.	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,20,35,38
embedcnt=6
