!for val31 =1 to 9 
val32=$[rint($(val7[$val9+1+$val31;$val8]))]
val33=$[rint($(val6[$val9+1+$val31;$val8]))]
val17=$[$val33/$val10]
val26=$val26,$val31,$val17
val27=$[rint(max($val27,$val33))]
val28=$[rint(max($val28,$val32))]
val34=$[rint($val15*$val33)]
val35=$[rint($val16*$val32)]
val30=$val30,$val31
val18=$val18,$val33
val19=$val19,$val32
val22=$val22,$val31,$val33
val23=$val23,$val31,$val32
val24=$val24,$val31,$val34
val25=$val25,$val31,$val35
!if $val31=1 
val20=$val20,$val34
!else
val20=$val20, xxx
!endif
val21=$val21, xxx
!next
val36=$val11,$val18
val37=$val12,$val19
tmp=!trim $val30;$val36;$val37
val38=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val38],wimscenter wimsborder,TH=[;1]		CAPTION="Tableau initial" 
tmp0=$slib_out
val39=$(tmp0)
tmp=!trim $val30;$val20;$val21
val40=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val40],wimscenter wimsborder,TH=[;1]		CAPTION="Tableau des indices de base 100 en $val29" 
tmp0=$slib_out
val41=$(tmp0)
val28=$[rint(1.15*$val28)]
val27=$[rint(1.1*$val27)]
val42=$[rint(max(110*$val27/$val13,$val28))]
val43=$[rint(max($val27/$val10,$val28))]
val44=$[rint(-0.1*$val28)]
val45=$[rint(floor($val27*0.0018)*50+50)]
val46=$[rint(floor($val42*0.002)*25+25)]
val47=$[rint(ceil($val43*0.01)*5)]
val48=$[0.5*$val46]
val49=$[rint(ceil($val28*0.02)*5)]
val50=$[0.15*$val47]
val51=$[0.4*$val49]
val52=$[1*$val47]
val53=text black, 0,-1,large, 0
val54=text black, -1, $val48, large,0
val55=text black, -1,2,large,0 %
val56=text red, -1,$val50,large,0
val57=text blue, -1,0.2*$val49,large,0
val58=text blue, 9.1,1*$val47,large,0
!for val31 =1 to 10 
val59=$[rint($val45*$val31)]
val60=$[rint($val46*$val31)]
val61=$[$val59/$val10]
val62=$[rint($val49*$val31)]
val63=$[rint($val47*$val31)]
val53=$val53;text black, $val31,-1,large, $val31
val54=$val54;text black, -1,$val59+$val48, large,$val59
val55=$val55;text black, -1.5, $val60+5, large,$val60 %
val56=$val56;text red, -1, $val61+$val50,large,$val59
val57=$val57;text blue, -1,$val62+$val51,large,$val62
val58=$val58;text blue, 9.1,$val63+$val52,large,$val63
!next
val64=xrange -2,11	yrange -0.1*$val27,$val27	linewidth 3	arrow 0,0,11,0,10,black	arrow 0,0,0,$val27,10,black	linewidth 4	$val53	$val54	
val65=$val64		$val22	$val23	
val66=xrange -2,11	yrange -0.1*$val42,$val42	linewidth 3	arrow 0,0,11,0,10,black	arrow 0,0,0,$val42,10,black	linewidth 4	$val53	$val55	$val24	$val25	
val67=$val64	$val22	
val68=xrange -2,11	yrange $val44,$val28	linewidth 3	arrow 0,0,11,0,10,black	arrow 0,0,0,$val28,10,black	linewidth 4	$val53	$val57	$val23	
val69=xrange -2,10	yrange -0.1*$val43,$val43	linewidth 3		arrow 0,0,10,0,10,black	arrow 9,0,9,$val43,10,blue	arrow 0,0,0,$val43,10,red	linewidth 4		$val53	$val56	$val58		$val23	$val26	
val70=text red, -10,-1,large, 0
val71=text blue, -0.06*$val27,0.2*$val49,large, 0
val72=points black, $val13,$val14
!for val31 =1 to 10 
val59=$[rint($val45*$val31)]
val61=$[rint(10*$val31)]
