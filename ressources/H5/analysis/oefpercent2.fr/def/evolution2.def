tmp0=!randint 0, 4

val9=$[rint($(tmp0))]
val10=$[rint(16)]
val11=le prix de la construction
val12=le prix de la consomation
val13=$[rint($(val6[$val9+1;$val8]))]
val14=$[rint($(val7[$val9+1;$val8]))]
