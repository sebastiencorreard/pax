val72=$val72,$(val18[$val31]),$(val19[$val31])
!next
val73=xrange -0.1*$val27,$val27	yrange $val44,$val28	linewidth 3	arrow 0,0,$val27,0,10,black	arrow 0,0,0,$val28,10,black		linewidth 4	$val70	$val71	$val72	
val74=On veut comparer $val11 et $val12 à partir de $val29 (trimestre $val8) :
tmp=!trim Données brutes dans un même repère.	  Pourcentage par rapport à la valeur de $val29.	  Chaque série dans un repère adapté<br>l'un en dessous de l'autre.	  Un seul graphique avec un axe pour chaque liste	  Les coordonnées des points sont les nombres <br>de chaque série correspondant à la même année
val75=!translate internal $	\
$ to ;; in $tmp
oefsteps=reply1	reply2,reply3 
nextstep=!nosubst reply1	reply2,reply3 
!readproc oef/steps.proc
replytype1=radio
replyname1=Graphique
