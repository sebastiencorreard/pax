val11=fille nommée Julie Dédeugénie pour répondre,	  fille nommée Métab Laurie,	  garçon nommé Léo Pérateur,	  fille nommée Mechet Marie,	  garçon nommé Lucas Particulier,	  garçon nommé Constantin Connu,	  garçon nommé Côme André Currente
val12=$(val11[$val6])
val13=Je sais <b>répondre</b> sans aide supplémentaire.,	 Le problème peut être résolu avec des <b>tableaux</b> de proportionnalité.,	 Trouver le bon <b>opérateur</b> est souvent la clef du problème.,	 Réaliser un <b>schéma</b> guide vers la solution.,	 On peut se servir d'une valeur <b>particulière</b>.,	 On peut utiliser une <b>lettre</b> pour désigner la valeur initiale inconnue.,	 On peut calculer le pourcentage d'augmentation chaque année par rapport à l'année <b>précédente</b>,	 On peut calculer le pourcentage de chaque valeur par rapport à celle de <b>2015</b>.,	 Utiliser la <b>lettre</b> \(x) pour désigner le prix initial pour justifier la dernière réponse.
val13=$(val13[$val7])
val14=yellow,lightgrey,paleturquoise,lightsalmon,blueviolet,lightgreen,orange
val14=$(val14[$val6])
!readproc slib/text/balloon [$(val13[1])],$(val14[1]),250,100,triangle=left-in 
tmp0=$slib_out
