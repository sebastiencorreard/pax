$()	    Vous avez choisi de répondre à l'aide de tableaux de proportionnalité.	    <table class="wimscenter wimsborder"><caption>Augmentation de $val23%</caption>	    <tr><td></td><td>Valeur</td><td>Pourcentage</td></tr>	    <tr><td>Avant</td><td>$val22</td><td>100</td></tr>	    <tr><td>Après</td><td> 
!read oef/embed.phtml reply3 
$()</td><td>$val24</td></tr>	    </table>	    <br/>	    <table class="wimscenter wimsborder"><caption>Augmentation de $val25%</caption>	    <tr><td></td><td>Valeur</td><td>Pourcentage</td></tr>	    <tr><td>Avant</td><td> 
!read oef/embed.phtml reply4 
$()</td><td>100</td></tr>	    <tr><td>Après</td><td> 
!read oef/embed.phtml reply6 
$()</td><td>$val26</td></tr>	    </table>	    <br/>	    <table class="wimscenter wimsborder"><caption>Augmentation de $val27%</caption>	    <tr><td></td><td>Valeur</td><td>Pourcentage</td></tr>	    <tr><td>Avant</td><td> 
!read oef/embed.phtml reply7 
$()</td><td>100</td></tr>	    <tr><td>Après</td><td> 
!read oef/embed.phtml reply10 
$()</td><td>$val28</td></tr>	    </table>	   
!endif
$()		  
!if $val48=opérateur 
$()	    Vous avez choisi de répondre à l'aide des coefficients multiplicateurs.	    <ul class="wims_nopuce">	    <li>Le coefficient multiplicateur correspondant à une augmentation de $val23% est :  
!read oef/embed.phtml reply2 
$()</li>	    <li>Le coefficient multiplicateur correspondant à une $val30 de $val25% est :  
!read oef/embed.phtml reply5 
$()</li>	    <li>Le coefficient multiplicateur correspondant à une augmentation de $val27% est :  
!read oef/embed.phtml reply8 
$()</li>	    <li>Le coefficient multiplicateur global est :  
!read oef/embed.phtml reply9 
$() (valeur exacte)</li>		    <li>Le prix final est :  
!read oef/embed.phtml reply11 
$() (à 0,01 près)</li>		    </ul>	   
!endif
$()		  
!if $val48=schéma 
