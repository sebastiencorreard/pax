!set title=Indice de base 100
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r,r,r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(5)]
val7=$[rint(100)]
tmp0=!randint 1, 5

val8=$[rint(200+10*$(tmp0))]
val9=$[$val8/100]
val10=$[rint($val8)]
val11=$[rint(100)]
val12=v1
val13=100
val14=<td>$val8</td>
val15=<td>100</td>
val16=<td>0</td>
!for val17 =1 to 5 
val6=$[rint($val17%2)]
val6=$[rint(2*$val6-1)]
tmp0=!randint $val6, 8

val11=$[$val11+$(tmp0)]
val10=$[rint($val11*$val9)]
val16=$val16<td>$val17</td>
val12=$val12,$val10
val13=$val13,$val11
val14=$val14<td>$val10</td>
val15=$val15<td>$val11</td>
!next
oefsteps=reply1,reply2,reply3,reply4,reply5,reply6 
nextstep=!nosubst reply1,reply2,reply3,reply4,reply5,reply6 
!readproc oef/steps.proc
replytype1=numeric
replyname1=2010
replygood1=$[$(val13[1])]
