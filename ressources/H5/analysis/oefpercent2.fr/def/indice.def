replyname2=2011
replygood2=$[$(val13[2])]
replytype3=numeric
replyname3=2012
replygood3=$[$(val13[3])]
replytype4=numeric
replyname4=2013
replygood4=$[$(val13[4])]
replytype5=numeric
replyname5=2014
replygood5=$[$(val13[5])]
replytype6=numeric
replyname6=2015
replygood6=$[$(val13[6])]
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst  <table class="wimscenter wimsborder"> <tr><th scope="row">Année 2010 + </th>$val16</tr> <tr><th scope="row">Série statistique</th>$val14</tr> <tr><th scope="row">Indice de base 100 en 2010</th>$val15</tr> </table> 


!goto stat

!exit

