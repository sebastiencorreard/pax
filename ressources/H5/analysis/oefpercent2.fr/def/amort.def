!set title=Amortissement
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 12

val6=$[rint($(tmp0))]
tmp0=!randint 150, 199

val7=$[rint(100*$(tmp0))]
val8=$[1-0.01*$val6]
val9=$[$val8*$val7]
val10=$[rint(100*$val8*$val9)]
val10=$[0.01*$val10]
val11=$[rint(100*($val8^10)*$val7)]
val11=$[0.01*$val11]
val12=$[rint(floor(log(0.25)/log($val8)))]
val13=$[$val12+1]
val14=$[rint(100*$val7*$val8^($val12))]
val14=$[0.01*$val14]
val15=$[rint(100*$val7*$val8^($val13))]
val15=$[0.01*$val15]
val16=$[rint(2020+$val12)]
val17=$[rint(2020+$val13)]
val18=$[rint(0.25*$val7)]
oefsteps=reply1,reply2,reply3	reply4 
nextstep=!nosubst reply1,reply2,reply3	reply4 
!readproc oef/steps.proc
replytype1=numeric
replyname1=En 2021
replygood1=$[$val9]
replytype2=numeric
replyname2=En 2022
replygood2=$[$val10]
replytype3=numeric
replyname3=En 2030
replygood3=$[$val11]
replytype4=numeric
replyname4=Au bout de
replygood4=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  Pour diminuer une quantité de $val6 %, on la multiplie par $val8. 

solution=!nosubst  <p>Le quart de $val7 est $val18.</p> <table class="wimsborder wimscenter"> <tr><th>Année</th><th>Prix</th></tr> <tr><td>2020</td><td>$val7</td></tr> <tr><td>2021</td><td>$val9</td></tr> <tr><td>2022</td><td>$val10</td></tr> <tr><td>...</td><td>...</td></tr> <tr><td>2030</td><td>$val11</td></tr> <tr><td>...</td><td>...</td></tr> <tr><td>$val16</td><td>$val14</td></tr> <tr><td>$val17</td><td>$val15</td></tr> </table> 


!goto stat

!exit

:question
$()	L'entreprise Honnier a acheté une nouvelle machine en 2020 au prix de $val7 &euro;.	Cette machine perd $val6 % de sa valeur chaque année par rapport à l'année précédente.	  
!if $m_step=1 
$()	    <ul><li>	    <label for="reply1">Quelle est la valeur de cette machine en 2021 ? </label>  
!read oef/embed.phtml reply1,10 
$() (valeur exacte)	    </li><li>	    <label for="reply2">Quelle est la valeur de cette machine en 2022 ? </label>  
!read oef/embed.phtml reply2,10 
$() (valeur arrondie à 0,01 &euro;)	    </li><li>	    <label for="reply3">Quelle est la valeur de cette machine en 2030 ? </label>  
!read oef/embed.phtml reply3,10 
$() (valeur arrondie à 0,01 &euro;)	    </li></ul>	   
!endif
$()	  
!if $m_step=2 
$()	    <label for="reply4"> Au bout de combien d'années sa valeur sera-t-elle inférieure au quart de sa valeur initiale ?</label>	     
!read oef/embed.phtml reply4,7 
$()	   
!endif
$()	
$()
!exit

:hint
$() Pour diminuer une quantité de $val6 %, on la multiplie par $val8. 
$()
!exit

:help
$()
$()
!exit

:solution
$() <p>Le quart de $val7 est $val18.</p> <table class="wimsborder wimscenter"> <tr><th>Année</th><th>Prix</th></tr> <tr><td>2020</td><td>$val7</td></tr> <tr><td>2021</td><td>$val9</td></tr> <tr><td>2022</td><td>$val10</td></tr> <tr><td>...</td><td>...</td></tr> <tr><td>2030</td><td>$val11</td></tr> <tr><td>...</td><td>...</td></tr> <tr><td>$val16</td><td>$val14</td></tr> <tr><td>$val17</td><td>$val15</td></tr> </table> 
$()
