tmp0=$slib_out
val20=$(tmp0)
val21=<p>Répondre directement ou choisir une méthode qui mènera au résultat.</p>
val22=$[rint(100)]
tmp0=!randint 40, 80

val23=$[rint($(tmp0))]
val24=$[rint(100+$val23)]
tmp0=!randint 4, 8

val25=$[rint($(tmp0))]
val26=$[rint(100+$val25)]
val27=diminution
tmp0=!randint 0, 8

val28=$[rint($(tmp0))]
val29=$[rint($val24*$val26*0.01-100)]
val30=$[rint(100*$val29/(100+$val29))]
!if $val28=0 
val31=$[rint($val30-7)]
tmp0=!randint $val31, $val30

val32=$[rint($(tmp0)-1)]
!endif
!if $val28=1 
tmp0=!randint $val29, 80

val32=$[rint($(tmp0))]
!endif
!if $val28>1 
tmp0=!randint $val30, $val29

val32=$[rint($(tmp0))]
!endif
val33=$[rint(100-$val32)]
val34=\(CM2= 1-\frac{$val32}{100})
val35=$[$val24/100]
val36=$[0.01*round(100*$val22*$val35)]
val37=$[$val33/100]
val38=$[0.01*round(100*$val36*$val37)]
val39=$[$val38]
val40=$[$val36]
val41=$[$val26/100]
val42=$[0.01*round(100*$val38*$val41)]
val43=$[$val35*$val37*$val41]
val44=$[0.01*round(100*$val43)]
val45=$[rint(round(100*$val43))]
val46=$[rint(abs($val45-100))]
val47=$[rint(100*$val22*$val43)]
val47=$[0.01*$val47]
val48=\(CM1= 1+\frac{$val23}{100}=$val35)
val34=$val34=$val37
val49=\(CM3= 1+\frac{$val25}{100}=$val41)
val50=\(CM= CM1 \times CM2 \times CM3 = $val43)
val51=<ul><li>	  Dans le cas d'évolutions successives,	  il faut calculer les différents coefficients multiplicateurs,	  puis calculer le coefficient multiplicateur global.</li><li>	  Ici, successivement : $val48, $val34, $val49.</li><li>	  Donc le coefficient global est $val50 \(\approx) $val44.</li>	  
val39=$[$val35*$val37]
val40=$[$val35]
val52=a diminué, a augmenté,est identique
!if $val43<1 
val53=$[rint(1)]
!endif
!if $val43=1 
val53=$[rint(3)]
!endif
!if $val43>1 
val53=$[rint(2)]
!endif
