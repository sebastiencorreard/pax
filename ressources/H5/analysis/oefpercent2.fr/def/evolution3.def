!set title=Évolution des prix
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

val6=$[rint($(tmp0))]
tmp0=!randint 150, 199

val7=$[rint($(tmp0))]
val8=$[1+0.01*$val6]
val9=$[$val8*$val7]
val10=$[rint(100*$val8*$val9)]
val10=$[0.01*$val10]
val11=$[rint(100*($val8^10)*$val7)]
val11=$[0.01*$val11]
val12=$[rint(floor(log(3)/log($val8)))]
val13=$[$val12+1]
val14=$[rint(100*$val7*$val8^($val12))]
val14=$[0.01*$val14]
val15=$[rint(100*$val7*$val8^($val13))]
val15=$[0.01*$val15]
val16=$[rint(2020+$val12)]
val17=$[rint(2020+$val13)]
val18=$[rint(3*$val7)]
oefsteps=reply1,reply2,reply3	reply4 
nextstep=!nosubst reply1,reply2,reply3	reply4 
!readproc oef/steps.proc
replytype1=numeric
replyname1=En 2021
replygood1=$[$val9]
replytype2=numeric
replyname2=En 2022
replygood2=$[$val10]
replytype3=numeric
replyname3=En 2030
replygood3=$[$val11]
replytype4=numeric
replyname4=Au bout de
replygood4=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  Pour augmenter une quantité de $val6 %, on la multiplie par $val8. 

solution=!nosubst  <p>Le triple de $val7 est $val18.</p> <table class="wimsborder wimscenter"> <tr><th scope="col">Année</th><th scope="col">Prix</th></tr> <tr><td>2020</td><td>$val7</td></tr> <tr><td>2021</td><td>$val9</td></tr> <tr><td>2022</td><td>$val10</td></tr> <tr><td> ... </td><td> ... </td></tr> <tr><td> 2030 </td><td> $val11 </td></tr> <tr><td> ... </td><td> ... </td></tr> <tr><td>$val16</td><td>$val14</td></tr> <tr><td>$val17</td><td>$val15</td></tr> </table> 


!goto stat

!exit

:question
$()	Un article coûte $val7 &euro; en 2020 et son prix augmente de $val6 % par an.	  
!if $m_step=1 
$()	  <p>	  <label for="reply1">Quel est le prix de cet article en 2021 ?</label>   
!read oef/embed.phtml reply1,10 
$() (valeur exacte)<br>	  <label for="reply2">Quel est le prix de cet article en 2022 ?</label>   
!read oef/embed.phtml reply2,10 
$() (valeur arrondie à 0,01 &euro;)<br>	  <label for="reply3">Quel est le prix de cet article en 2030 ?</label>   
!read oef/embed.phtml reply3,10 
$() (valeur arrondie à 0,01 &euro;)<br>	  </p>                    
!endif
$()	  
!if $m_step=2 
$()	    <p><label for="reply4">Au bout de combien d'années (au minimum) son prix sera-t-il	    multiplié par 3 ?</label>	     
!read oef/embed.phtml reply4,7 
$().</p>	   
!endif
$()	
$()
!exit

:hint
$() Pour augmenter une quantité de $val6 %, on la multiplie par $val8. 
$()
!exit

:help
$()
$()
!exit

:solution
$() <p>Le triple de $val7 est $val18.</p> <table class="wimsborder wimscenter"> <tr><th scope="col">Année</th><th scope="col">Prix</th></tr> <tr><td>2020</td><td>$val7</td></tr> <tr><td>2021</td><td>$val9</td></tr> <tr><td>2022</td><td>$val10</td></tr> <tr><td> ... </td><td> ... </td></tr> <tr><td> 2030 </td><td> $val11 </td></tr> <tr><td> ... </td><td> ... </td></tr> <tr><td>$val16</td><td>$val14</td></tr> <tr><td>$val17</td><td>$val15</td></tr> </table> 
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,14,15,16,17,18
embedcnt=4
