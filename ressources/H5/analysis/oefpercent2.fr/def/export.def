!set title=Exportations
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr
precision=1000

ansorder=r,r,r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 50

val6=$[rint($(tmp0))]
tmp0=!randint 4, 14

val7=$[rint($(tmp0))]
tmp0=!randint 50, 70

val8=$[rint($(tmp0))]
tmp0=!randint 20, 80

val9=$[rint(10*$(tmp0))]
val10=$[0.01*$val6*$val9]
val11=$[0.01*$val7*$val10]
val12=$[0.01*$val8*$val11]
val13=$[100*$val12/$val9]
val14=$[0.01*$val6]
val15=$[0.01*$val7]
val16=$[0.01*$val8]
val17=pourcentages de pourcentages, pourcentage d'augmentation, pourcentage de diminution, pourcentage d'évolution
!readproc oef/draw.phtml 120,120 \
xrange=-10,110	yrange=-10,110	rectangle 0,0,100,100,black	rectangle 5,2,90,80,blue	rectangle 10,4,80,60,red	rectangle 15,6,70,40,green 
tmp0=$ins_url
val18=$(tmp0)
val19=Rectangles encastrés les uns dans les autres
!readproc oef/draw.phtml 120,120 \
xrange=-10,110	yrange=-10,110	rectangle 0,0,15,50,black	rectangle 20,0,35,75,blue	rectangle 40,0,55,80,red	rectangle 60,0,75,100,green 
tmp0=$ins_url
val20=$(tmp0)
val21=Rectangles  côte à côte de plus en plus grands
!readproc oef/draw.phtml 100,120 \
xrange=-10,90	yrange=-10,110	rectangle 0,0,15,100,black	rectangle 20,0,35,75,blue	rectangle 40,0,55,65,red	rectangle 60,0,75,50,green 
tmp0=$ins_url
val22=$(tmp0)
val23=Rectangles côte à côte de plus en plus petits
!readproc oef/draw.phtml 100,120 \
xrange=-10,90	yrange=-10,110	rectangle 0,0,15,100,black	rectangle 20,0,35,$val6,blue	rectangle 40,0,55,$val7,red	rectangle 60,0,75,$val8,green 
tmp0=$ins_url
val24=$(tmp0)
val25=Rectangles côte à côte de différentes tailles
val26=xrange=-10,110	yrange=-10,110	rectangle 0,0,100,100,black	rectangle 5,2,90,80,blue	rectangle 10,4,85,60,red	rectangle 15,6,80,40,green	text black, 10,95,giant, Exportations $val9 milliards	text blue, 10,75,giant, Service	text black, 70,75,giant, $val6 %	text red, 15,55,giant, Info. et comm.	text blue, 60,55,giant, $val7 %	text green, 20,35,giant, Informatique	text red, 60,35,giant, $val8 %
!readproc oef/draw.phtml 360,360 \
$val26 
tmp0=$ins_url
val27=$(tmp0)
!readproc oef/draw.phtml 360,360 \
$val26	text blue, 10,70,giant, $val10 milliards	text red, 15,50,giant, $val11 milliards	text green, 20,30,giant, $val12 milliards	 
tmp0=$ins_url
val28=$(tmp0)
oefsteps=reply1,reply2	reply3,reply4,reply5	reply6 
nextstep=!nosubst reply1,reply2	reply3,reply4,reply5	reply6 
!readproc oef/steps.proc
replytype1=radio
replyname1=type de pourcentage
replygood1=1;$val17
replytype2=radio
replyname2=Graphique adapté
replygood2=1;a,b,c,d
replytype3=numeric
replyname3=services
replygood3=$[$val10]
replytype4=numeric
replyname4=info communication
replygood4=$[$val11]
replytype5=numeric
replyname5=informatiques
replygood5=$[$val12]
replytype6=numeric
replyname6=Pourcentage cherché
replygood6=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <p>	  Dans un certain pays, les <b>exportations</b> se sont élevées à $val9 milliards d'euros.<br>	  Les <b>services</b> représentent $val6 % des exportations.<br>	  Parmi les services, <b>l'information et la communication</b> représente $val7 %.<br>	  Et les <b>activités informatiques et services d'information</b> représentent $val8 % de l'information et la communication.<br>	  On cherche quel pourcentage des <b>exportations</b> de ce pays représentent les <b>activités informatiques et services d'information</b>.	  </p>	    
!if $m_step=1 
$()Quel type de pourcentage correspond à ce problème ? <br>	   
!read oef/embed.phtml reply1 
$() <br>	  Quel graphique illustre la situation ?	  <table class="wimscenter wimsborder">	  <tr>	  <td>  
!read oef/embed.phtml reply2,1 
$()</td><td>  
!read oef/embed.phtml reply2,2 
$()</td><td>  
!read oef/embed.phtml reply2,3 
$()</td><td>  
!read oef/embed.phtml reply2,4 
$()</td>	  </tr><tr>	  <td><img src="$val18" alt="$val19"></td><td><img src="$val20" alt="$val21"></td><td><img src="$val22" alt="$val23"></td><td><img src="$val24" alt="$val25"></td>	  </tr>	  </table>	 
!endif
$()	  
!if $m_step=2 
$()	    Compléter le schéma :	      <ul class="wims_nopuce">	        <li> 
!read oef/special.phtml mathmlinput [\large{ $val9\phantom{x}milliards\; \overset{\phantom{xx}$val6 \%\phantom{xx}}{\mapsto}\; reply3 milliards\; \overset{\phantom{xx}$val7\%\phantom{xx}}{\mapsto}\; reply4 milliards\;	  \overset{\phantom{xx}$val8 \%\phantom{xx}}{\mapsto}\; reply5 milliards}],5	reply3	reply4	reply5 
$()	  </li>	  </ul>		  <img src="$val27" alt="" />	   
!endif
$()	  
!if $m_step=3 
$()	    Les <b>activités informatiques et services d'information</b> s'élèvent à $val12 milliards.<br>	    <label for="reply6">Quel pourcentage des exportations de ce pays représentent	    les <b>activités informatiques et services d'information</b> ?	    </label>	     
!read oef/embed.phtml reply6,4 
$() %.	   
!endif
$()		
$()
!exit

:hint
$()	  
!if $m_step=1 
$()	    Est-il question d'évolution, d'augmentation ou de diminution, ou bien s'agit-il de parties incluses les unes dans les autres ?<br>	   
!endif
$()	  
!if $m_step=2 
$()	    Pour calculer $val6 % de $val9, on multiplie $val9 par $val6 / 100...	   
!endif
$()	  
!if $m_step=3 
$()	  <table class="wimscenter wimsborder">	    <tr>	    <td>$val12</td><td>? ? ?</td>	   </tr><tr>	    <td>$val9</td><td>100</td>	   </tr>	  </table>	   
!endif
$()	
$()
!exit

:help
$()
$()
!exit

:solution
$()<p>Pourcentage de pourcentage</p>	  <p>	  
!insmath \large{$val9\phantom{x}milliards {\overset{\phantom{xxx}$val6 \%\phantom{xxx}}{\underset{\times $val14}{\mapsto}}} $val10\phantom{x}milliards		  {\overset{\phantom{xxx}$val7 \%\phantom{xxx}}{\underset{\times $val15}{\mapsto}}} $val11\phantom{x}milliards	   {\overset{\phantom{xxx}$val8 \%\phantom{xxx}}{\underset{\times $val16}{\mapsto}}}$val12\phantom{x}milliards}	  
$()	  </p><p>	  
!insmath \frac{$val12}{$val9}\times 100 = $val13
$()	  </p><p>Donc  les <b>activités informatiques et services d'information</b>	  représentent $val13 % des exportations.</p>	  <div class="wimscenter">	  <img src="$val28" alt="$val19" avec les valeurs correspondant à chaque ensemble.>	  </div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
