tmp0=!itemcnt $val6

val10=$[rint($(tmp0))]
val11=fille nommée Julie Dédeugénie pour répondre,	  fille nommée Métab Laurie,	  garçon nommé Léo Pérateur,	  fille nommée Mechet Marie,	  garçon nommé Lucas Particulier,	  garçon nommé Constantin Connu,	  garçon nommé Côme André Currente
val12=$(val11[$val6])
val13=Je sais <b>répondre</b> sans aide supplémentaire.,	 Le problème peut être résolu avec des <b>tableaux</b> de proportionnalité.,	 Trouver le bon <b>opérateur</b> est souvent la clef du problème.,	 Réaliser un <b>schéma</b> guide vers la solution.,	 On peut se servir d'une valeur <b>particulière</b>.,	 On peut utiliser une <b>lettre</b> pour désigner la valeur initiale inconnue.,	 On peut calculer le pourcentage d'augmentation chaque année par rapport à l'année <b>précédente</b>,	 On peut calculer le pourcentage de chaque valeur par rapport à celle de <b>2015</b>.,	 Utiliser la <b>lettre</b> \(x) pour désigner le prix initial pour justifier la dernière réponse.
val13=$(val13[$val7])
val14=yellow,lightgrey,paleturquoise,lightsalmon,blueviolet,lightgreen,orange
val14=$(val14[$val6])
!readproc slib/text/balloon [$(val13[1])],$(val14[1]),250,100,triangle=left-in 
tmp0=$slib_out
val15=$(tmp0)
!readproc slib/text/balloon [$(val13[2])],$(val14[2]),250,100,triangle=left-in 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/text/balloon [$(val13[3])],$(val14[3]),250,100,triangle=left-in 
tmp0=$slib_out
val17=$(tmp0)
!readproc slib/text/balloon [$(val13[4])],$(val14[4]),250,100,triangle=left-in 
tmp0=$slib_out
val18=$(tmp0)
!readproc slib/text/balloon [$(val13[5])],$(val14[5]),250,100,triangle=left-in 
tmp0=$slib_out
val19=$(tmp0)
!readproc slib/text/balloon [$(val13[6])],$(val14[6]),250,100,triangle=left-in 
tmp0=$slib_out
val20=$(tmp0)
val21=<p>Lorsqu'on clique sur l'icone, la méthode choisie est présentée sans pouvoir répondre puis on peut choisir	de voir une autre méthode.</p>	<p>Lorsqu'on a trouvé, on peut répondre aux questions en cliquant sur l'icone de répondre.</p>
tmp0=!randint 100, 300

val22=$[rint($(tmp0))]
tmp0=!randint 5, 24

val23=$[rint($(tmp0))]
val24=$[1+$val23/100]
val25=$[rint(100*$val22*$val24)]
val25=$[0.01*$val25]
tmp0=!randint 20, 30

val26=$[rint($(tmp0))]
val27=$[1-$val26/100]
val28=$[$val24*$val27]
val29=$[$val28-1]
val30=$[rint((1-$val28)*100)]
val31=$[rint(-$val30)]
val32=$[rint(100*$val22*$val28)]
val32=$[0.01*$val32]
val33=\(CM1= 1+\frac{$val23}{100}=$val24) (hausse)
val34=\(CM2= 1-\frac{$val26}{100}=$val27) (baisse)
val35=\(CM= CM1 \times CM2 = $val28 < 1) donc baisse
val36=Dans le cas d'évolutions successives, il faut calculer les différents coefficients multiplicateurs, puis calculer le coefficient multiplicateur global.<br>	Ici, $val33 et $val34<br>	Donc le coefficient global est $val35<br>
val36=$val36 Le nouveau prix est donc \(NV = AV \times CM1 =$val22 \times $val24 = $val25) &euro;<br><br>
val36=$val36 Et le prix pour André est \(NV = AV \times CM =$val22 \times $val28 = $val32) &euro;<br><br><br>
val36=$val36 Le pourcentage d'évolution pour André est \(\frac{NV - AV}{AV} = \frac{$val32 - $val22}{ $val22} = $val29 \approx $val31) %<br>
val36=$val36 Soit une réduction de $val30 %. <br><br>
val36=$val36 Par ailleurs \(\frac{NV - AV}{AV} =  \frac{AV \times CM - AV}{AV} = CM-1= $val28 - 1 = $val29 \approx $val31) %.<br>
val36=$val36 Le pourcentage de réduction ne dépend que du coefficient multiplicateur, donc il est indépendant du prix initial.
val37=Augmentation, Remise
val38=
val39=r1
val40=1
dynsteps=yes
oefsteps=$val39 
nextstep=!nosubst $val39 
!readproc oef/steps.proc
