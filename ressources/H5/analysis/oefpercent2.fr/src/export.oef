\title{Exportations}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}
\precision{1000}

## choix des pourcentage et de la quantité numérique
\integer{p1=randint(15..50)}
\integer{p2=randint(4..14)}
\integer{p3=randint(50..70)}

\integer{x=10*randint(20..80)}
\real{y1= 0.01*\p1*\x}
\real{y2= 0.01*\p2*\y1}
\real{y3= 0.01*\p3*\y2}

\real{p=100*\y3/\x}

\real{k1= 0.01*\p1}
\real{k2= 0.01*\p2}
\real{k3= 0.01*\p3}

\text{L1=pourcentages de pourcentages, pourcentage d'augmentation, pourcentage de diminution, pourcentage d'évolution}

## Graphiques à choisir
\text{Gr1 = draw(120,120
xrange=-10,110
yrange=-10,110
rectangle 0,0,100,100,black
rectangle 5,2,90,80,blue
rectangle 10,4,80,60,red
rectangle 15,6,70,40,green)}
\text{tg1=Rectangles encastrés les uns dans les autres}

\text{Gr2 = draw(120,120
xrange=-10,110
yrange=-10,110
rectangle 0,0,15,50,black
rectangle 20,0,35,75,blue
rectangle 40,0,55,80,red
rectangle 60,0,75,100,green)}
\text{tg2=Rectangles  côte à côte de plus en plus grands}

\text{Gr3 = draw(100,120
xrange=-10,90
yrange=-10,110
rectangle 0,0,15,100,black
rectangle 20,0,35,75,blue
rectangle 40,0,55,65,red
rectangle 60,0,75,50,green)}
\text{tg3=Rectangles côte à côte de plus en plus petits}

\text{Gr4 = draw(100,120
xrange=-10,90
yrange=-10,110
rectangle 0,0,15,100,black
rectangle 20,0,35,\p1,blue
rectangle 40,0,55,\p2,red
rectangle 60,0,75,\p3,green)}
\text{tg4=Rectangles côte à côte de différentes tailles}

\text{Gr =xrange=-10,110
yrange=-10,110
rectangle 0,0,100,100,black
rectangle 5,2,90,80,blue
rectangle 10,4,85,60,red
rectangle 15,6,80,40,green
text black, 10,95,giant, Exportations \x milliards
text blue, 10,75,giant, Service
text black, 70,75,giant, \p1 %
text red, 15,55,giant, Info. et comm.
text blue, 60,55,giant, \p2 %
text green, 20,35,giant, Informatique
text red, 60,35,giant, \p3 %}

\text{Gr5 = draw(360,360
\Gr)}
\text{GrS = draw(360,360
\Gr
text blue, 10,70,giant, \y1 milliards
text red, 15,50,giant, \y2 milliards
text green, 20,30,giant, \y3 milliards
)}

\steps{reply1,reply2
reply3,reply4,reply5
reply6}

####### enoncé de l'exo #######

\statement{
  <p>
  Dans un certain pays, les <b>exportations</b> se sont élevées à \x milliards d'euros.<br>
  Les <b>services</b> représentent \p1 % des exportations.<br>
  Parmi les services, <b>l'information et la communication</b> représente \p2 %.<br>
  Et les <b>activités informatiques et services d'information</b> représentent \p3 % de l'information et la communication.<br>
  On cherche quel pourcentage des <b>exportations</b> de ce pays représentent les <b>activités informatiques et services d'information</b>.
  </p>
    \if{\step=1}
  {Quel type de pourcentage correspond à ce problème ? <br>
  \embed{reply1} <br>
  Quel graphique illustre la situation ?
  <table class="wimscenter wimsborder">
  <tr>
  <td> \embed{reply2,1}</td><td> \embed{reply2,2}</td><td> \embed{reply2,3}</td><td> \embed{reply2,4}</td>
  </tr><tr>
  <td><img src="\Gr1" alt="\tg1"></td><td><img src="\Gr2" alt="\tg2"></td><td><img src="\Gr3" alt="\tg3"></td><td><img src="\Gr4" alt="\tg4"></td>
  </tr>
  </table>
}
  \if{\step=2}{
    Compléter le schéma :
      <ul class="wims_nopuce">
        <li>\special{mathmlinput [\large{ \x\phantom{x}milliards\; \overset{\phantom{xx}\p1 \%\phantom{xx}}{\mapsto}\; reply3 milliards\; \overset{\phantom{xx}\p2\%\phantom{xx}}{\mapsto}\; reply4 milliards\;
  \overset{\phantom{xx}\p3 \%\phantom{xx}}{\mapsto}\; reply5 milliards}],5
reply3
reply4
reply5}
  </li>
  </ul>

  <img src="\Gr5" alt="" />
  }
  \if{\step=3}{
    Les <b>activités informatiques et services d'information</b> s'élèvent à \y3 milliards.<br>
    <label for="reply6">Quel pourcentage des exportations de ce pays représentent
    les <b>activités informatiques et services d'information</b> ?
    </label>
    \embed{reply6,4} %.
  }

}
###indication###
\hint{
  \if{\step=1}{
    Est-il question d'évolution, d'augmentation ou de diminution, ou bien s'agit-il de parties incluses les unes dans les autres ?<br>
  }
  \if{\step=2}{
    Pour calculer \p1 % de \x, on multiplie \x par \p1 / 100...
  }
  \if{\step=3}{
  <table class="wimscenter wimsborder">
    <tr>
    <td>\y3</td><td>? ? ?</td>
   </tr><tr>
    <td>\x</td><td>100</td>
   </tr>
  </table>
  }
}
#### Réponses ####
\answer{type de pourcentage }{1;\L1}{type=radio}
\answer{Graphique adapté }{1;a,b,c,d}{type=radio}
\answer{services}{\y1}{type=numeric}
\answer{info communication}{\y2}{type=numeric}
\answer{informatiques}{\y3}{type=numeric}
\answer{Pourcentage cherché}{\p}{type=numeric}

\solution{<p>Pourcentage de pourcentage</p>
  <p>
  \(\large{\x\phantom{x}milliards {\overset{\phantom{xxx}\p1 \%\phantom{xxx}}{\underset{\times \k1}{\mapsto}}} \y1\phantom{x}milliards

  {\overset{\phantom{xxx}\p2 \%\phantom{xxx}}{\underset{\times \k2}{\mapsto}}} \y2\phantom{x}milliards
   {\overset{\phantom{xxx}\p3 \%\phantom{xxx}}{\underset{\times \k3}{\mapsto}}}\y3\phantom{x}milliards}
  \)
  </p><p>
  \(\frac{\y3}{\x}\times 100 = \p)
  </p><p>Donc  les <b>activités informatiques et services d'information</b>
  représentent \p % des exportations.</p>
  <div class="wimscenter">
  <img src="\GrS" alt="\tg1" avec les valeurs correspondant à chaque ensemble.>
  </div>
}
