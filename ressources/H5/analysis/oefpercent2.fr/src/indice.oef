\title{Indice de base 100}
\language{fr}
\range{-5..5}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

# nombre de valeurs 6
# Liste L1
# Indice L2
# Valeur initiale v1

\integer{l=5}

\integer{u1=100}
\integer{v1=200+10*randint(1..5)}
\real{k=\v1/100}
\integer{vi=\v1}
\integer{ui=100}
\text{L1=v1}
\text{L2=100}
\text{T1=<td>\v1</td>}
\text{T2=<td>100</td>}

\text{T0=<td>0</td>}

\for{i=1 to 5}{
  \integer{l=\i%2}
  \integer{l=2*\l-1}
  \real{ui=\ui+randint(\l..8)}
  \integer{vi=\ui*\k}
  \text{T0=\T0<td>\i</td>}
  \text{L1=\L1,\vi}
  \text{L2=\L2,\ui}

  \text{T1=\T1<td>\vi</td>}
  \text{T2=\T2<td>\ui</td>}
  }

\steps{reply1,reply2,reply3,reply4,reply5,reply6}

\statement{Voici une série statistique.
  <p>Déterminer l'indice de base 100 en 2010 de cette série.</p>
  <table class="wimscenter wimsborder">
  <tr><th scope="row">Année 2010 + </th>\T0</tr>
  <tr><th scope="row">Série statistique</th>\T1</tr>
  <tr><th scope="row">Indice de base 100 en 2010
    arrondi à l'unité</th>
  <td>\embed{reply1,10}</td>
  <td>\embed{reply2,10}</td>
  <td>\embed{reply3,10}</td>
  <td>\embed{reply4,10}</td>
  <td>\embed{reply5,10}</td>
  <td>\embed{reply6,10}</td>
  </tr>
  </table>
}

\answer{2010}{\L2[1]}{type=numeric}
\answer{2011}{\L2[2]}{type=numeric}
\answer{2012}{\L2[3]}{type=numeric}
\answer{2013}{\L2[4]}{type=numeric}
\answer{2014}{\L2[5]}{type=numeric}
\answer{2015}{\L2[6]}{type=numeric}

\solution{
  <table class="wimscenter wimsborder">
  <tr><th scope="row">Année 2010 + </th>\T0</tr>
  <tr><th scope="row">Série statistique</th>\T1</tr>
  <tr><th scope="row">Indice de base 100 en 2010</th>\T2</tr>
  </table>
}
