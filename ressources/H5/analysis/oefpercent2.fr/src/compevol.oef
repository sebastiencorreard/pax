\title{Comparaison d'évolutions}
\description{Choisir parmi 5 graphiques pour comparer et comment calculer.}
\integer{k=randint(12..15)}
\integer{l=10}
\text{t1=la liste 1}
\text{t2=la liste 2}
\integer{b0=randint(15..20)}
\integer{a0=\k*\b0+10+randint(1..5)}

\real{k1=100/\a0}
\real{k2=100/\b0}
\integer{ai=\a0}
\integer{bi=\b0}
\text{L=\a0}
\text{V=\b0}
\text{L3=\t1,100}
\text{L4=\t2,100}





\text{L0=Année 2010 +,0}
\text{P1=polyline red, 0,\a0}
\text{P2=polyline blue, 0,\b0}
\text{P3=polyline red, 0,100}
\text{P4=polyline blue, 0,100}

\real{wi=\a0/\l}
\text{P5=polyline red, 0,\wi}

\integer{M=\a0}
\integer{n=\b0}
\for{i=1 to 9}{

  \integer{bi=\bi+randint(-2..5)}
  \integer{ai=\k*\bi+4*randint(0..\k)}
  \real{wi=\ai/\l}
  \text{P5=\P5,\i,\wi}

  \integer{M=max(\M,\ai)}
  \integer{n=max(\n,\bi)}
  \integer{ui=\k1*\ai}
  \integer{vi=\k2*\bi}
  \text{L0=\L0,\i}
  \text{L=\L,\ai}
  \text{V=\V,\bi}
  \text{P1=\P1,\i,\ai}
  \text{P2=\P2,\i,\bi}
  \text{P3=\P3,\i,\ui}
  \text{P4=\P4,\i,\vi}
  \if{\i=1}{\text{L3=\L3,\ui}}{\text{L3=\L3, xxx}}

  \text{L4=\L4, xxx}




  }
\text{L1=\t1,\L}
\text{L2=\t2,\V}
\matrix{matrice=\L0;\L1;\L2}
\text{Mat=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[;1] CAPTION="Tableau initial")}
\matrix{matr2=\L0;\L3;\L2}
\text{Mat2=slib(text/matrixhtml [\matr2],wimscenter wimsborder,TH=[;1] CAPTION="Tableau des indices de base 100 en 2010")}
\integer{n=1.15*\n}
\integer{M=1.1*\M}
\integer{M1=max(110*\M/\a0,\n)}








\integer{M5=max(\M/\l,\n)}
\integer{m4=-0.1*\n}


\integer{p=floor(\M*0.0018)*50+50}
\integer{p1=floor(\M1*0.002)*25+25}
\integer{p5=ceil(\M5*0.005)*5}
\real{d1=0.5*\p1}

\integer{p2=ceil(\n*0.005)*5}
\real{d3=0.15*\p5}






\real{d4=0.4*\p2}
\real{d5=0.2*\p5}

\text{X1 = text black, 0,-1,large, 0}
\text{U1 = text black, -1, \d1, large,0}
\text{U2 = text black, -1,2,large,0 %}
\text{U3 = text red, -1,\d3,large,0}
\text{U4 = text blue, -1,0.2*\p2,large,0}
\text{U5 = text blue, 9.1,0.2*\p5,large,0}

\for{i=1 to 10}{
   \integer{j=\p*\i}
   \integer{j2=\p1*\i}
   \real{j3=\j/\l}
   \integer{j4=\p2*\i}
   \integer{j5=\p5*\i}

   \text{X1 = \X1;text black, \i,-1,large, \i}  
   \text{U1 = \U1;text black, -1,\j+\d1, large,\j}
   \text{U2 = \U2;text black, -1.5, \j2+5, large,\j2 %}
   \text{U3 = \U3;text red, -1, \j3+\d3,large,\j}
   \text{U4 = \U4;text blue, -1,\j4+\d4,large,\j4}
   \text{U5 = \U5;text blue, 9.1,\j5+\d5,large,\j5}
   }

