\title{TVA modifiée}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

##Les pourcentages sont p1 et p2 avec p1 > p2
\real{p1=0.1*randint(200..400)}
\real{p2=0.1*randint(50..100)}

##Les coefficients multiplicateurs sont : k1, k2 et k
\real{k1=1+0.01*\p1}
\real{k2=1+0.01*\p2}
\real{t=(\k2 - \k1)/\k1}
\real{pn=100*\t}

## Le pourcentage de diminution est p
\integer{p=1000*(\k1-\k2)/\k1}
\real{p=0.1*\p}

##Mauvaises réponses : coefficients inadaptés
\real{a1=1-0.01*\p1}
\real{b1=0.01*\p1}

\real{a2=1-0.01*\p2}
\real{b2=0.01*\p2}

\real{a=\k2-\k1}

\text{Vf=Valeur Finale}
\text{Vi=Valeur Initiale}
\text{F=<p>Le taux d'évolution de l'ancien prix TTC au nouveau prix TTC est donné par la formule :<br>
\(\frac{\Vf - \Vi}{\Vi})</p>
<p> La valeur négative indique qu'il s'agit d'une diminution.</p>}

### la liste des objets que l'on peut cliquer pour résoudre l'exercice ###
\text{m=&#0151} ## signe moins

\text{s1=+ (\p1) %}
\text{s2=\(\times) \k1}

\text{t1=+ \p1}
\text{u1=\m \p1 %}

\text{t2=\(\times \p1/100)}
\text{u2=\(\times \a1)}

\text{s3=+ (\p2) %}
\text{s4=\(\times) \k2}

\text{t3=+ \p2}
\text{u3=\m \p2 %}

\text{t4=\(\times \p2/100)}
\text{u4=\(\times \a2)}

\text{t5=+ \p1/100}

\text{TraitH=draw (400,20
xrange 0,100
yrange -10,10
line 0,0,100,0,black)
}

\text{ListOp=\s2,\s4,\t2,\t4,\t5,\u2,\u4}
\text{ListOp2=\b1,\b2,\a,\p1,\k1,\k2}

## taille des symboles et des champs à remplir par clic LxHxnb ##
\text{size=100x30x1}

\steps{reply1
reply2
reply3,reply4,reply5,reply6}

####### enoncé de l'exo #######

\statement{
<div class="wims_question">
<ul class="wims_nopuce">
<li>La TVA sur certains produits était de \p1 % du prix Hors Taxe (HT).</li>
<li>Le prix payé par le client est la somme du prix Hors Taxe et de la TVA, que l'on appelle le prix Toutes Taxes Comprises (TTC).</li>
<li>Le taux de la TVA sur ces produits a été réduit et est à présent \p2 %.</li>
<li>La question est de savoir quelle est le pourcentage de diminution sur le prix TTC en supposant que le prix HT reste le même.</li>
</ul>
</div>
  \if{\step=1}{
    Placer la bonne opération dans la case pour obtenir le prix TTC dans la situation initiale :
  <div class="wimscenter">
    <p>
    \(\large{ HT\; \overset{\phantom{xx}+\p1 \%\phantom{xx}}{{\mapsto}}\; TTC1})
    </p>
    <p>\embed{reply1,\size}</p>
    </div>
}
  \if{\step=2}{
  Placer la bonne opération dans la case pour obtenir le prix TTC avec le nouveau taux:
  <div class="wimscenter">
  <p>
  \(\large{ HT\; \overset{\phantom{xx}+\p1 \%\phantom{xx}}{\underset{\times \k1}{\mapsto}}\; TTC1})
  </p>
  <p>
  \(\large{ HT\; \overset{\phantom{xx}+\p2 \%\phantom{xx}}{{\mapsto}}\; TTC2})
  </p>
  <p>
  \embed{reply2,\size}
  </p>
  </div>
}
  \if{\step=3}{
    <p>Comment calculer le pourcentage de diminution de TTC1 à TTC2 ?<br>
    Pour cela exprimer TTC1 et TTC2 en fonction de HT.</p>
    <div class="wimscenter">
    <p>
    \(\large{ HT\; \overset{\phantom{xx}+\p1 \%\phantom{xx}}{\underset{\times \k1}{\mapsto}}\; TTC1 = \k1 \times HT})
    </p>
    <p>
    \(\large{ HT\; \overset{\phantom{xx}+\p2 \%\phantom{xx}}{\underset{\times \k2}{\mapsto}}\; TTC2 = \k2 \times HT})
    </p>
    <p>
    \(\large{ \k1 \times HT = TTC1\; \overset{\phantom{xx}- ? \%\phantom{xx}}{{\mapsto}}\; TTC2 = \k2 \times HT})
    </p>
    </div>
    \F
    Le taux d'évolution ici est donc :
    <div class="wimscenter">
    <p>
    \embed{reply3,\size} \times HT \(-) \embed{reply4,\size} \(\times) HT
    </p>
    <p>
    <img src="\TraitH">
    </p>
    <p>
    \embed{reply5,\size} \(\times) HT
    </p>
    </div>
    <p>
    En déduire le  le pourcentage de diminution de TTC1 à TTC2 :
    \embed{reply6,5} % (nombre positif à 0,1 % près).
    </p>
  }
}

#### soumission de réponse ####
\answer{}{\s2;\ListOp}{type=clickfill}{option=shuffle}
\answer{}{\s4;\ListOp}{type=clickfill}{option=shuffle}
\answer{}{\k2;\ListOp2}{type=clickfill}{option=shuffle}
\answer{}{\k1;\ListOp2}{type=clickfill}{option=shuffle}
\answer{}{\k1;\ListOp2}{type=clickfill}{option=shuffle}
\answer{}{\p}{type=numeric}

\hint{
  \if{\step<3}{
      Le coefficient multiplicateur correspondant à une augmentation de \(p) % est :<br>
  \(1 + \frac{p}{100})
  }{
    \F
    Le pourcentage de diminution est \(p = - 100 \times t).
  }
}
\solution{
  <p>
  \(\large{ HT\; \overset{\phantom{xx}+\p1 \%\phantom{xx}}{\underset{\times \k1}{\mapsto}}\; TTC1 = \k1 \times HT})
  </p><p>
  \(\large{ HT\; \overset{\phantom{xx}+\p2 \%\phantom{xx}}{\underset{\times \k2}{\mapsto}}\; TTC2 = \k2 \times HT})
  </p><p>
  \(\large{ \k1 \times HT = TTC1\; \overset{\phantom{xx}- ? \%\phantom{xx}}{{\mapsto}}\; TTC2 = \k2 \times HT})
  </p>
  \F
  <p>Ce qui conduit ici à :
  \(\frac{\k2 HT - \k1 HT}{\k1 HT} = \frac{\k2 - \k1}{\k1} \approx \t =\frac{\pn}{100})</p>
  Le pourcentage de diminution arrondi à 0,1 % près est : \p %.
}
