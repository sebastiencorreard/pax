\title{Amortissement}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## choix du pourcentage et de la quantité numérique
\integer{p=randint(3..12)}
\integer{x=100*randint(150..199)}

\real{t=1-0.01*\p}
\real{x1=\t*\x}
\integer{x2=100*\t*\x1}
\real{x2=0.01*\x2}
\integer{x3=100*(\t^10)*\x}
\real{x3=0.01*\x3}

\integer{na=floor(log(0.25)/log(\t))}

\real{n=\na+1}

\integer{xa=100*\x*\t^(\na)}
\real{xa=0.01*\xa}
\integer{xs=100*\x*\t^(\n)}
\real{xs=0.01*\xs}

\integer{aa=2020+\na}
\integer{as=2020+\n}
\integer{xc=0.25*\x}

\steps{reply1,reply2,reply3
reply4}

####### enoncé de l'exo #######

\statement{
L'entreprise Honnier a acheté une nouvelle machine en 2020 au prix de \x &euro;.
Cette machine perd \p % de sa valeur chaque année par rapport à l'année précédente.
  \if{\step=1}{
    <ul><li>
    <label for="reply1">Quelle est la valeur de cette machine en 2021 ? </label> \embed{reply1,10} (valeur exacte)
    </li><li>
    <label for="reply2">Quelle est la valeur de cette machine en 2022 ? </label> \embed{reply2,10} (valeur arrondie à 0,01 &euro;)
    </li><li>
    <label for="reply3">Quelle est la valeur de cette machine en 2030 ? </label> \embed{reply3,10} (valeur arrondie à 0,01 &euro;)
    </li></ul>
  }
  \if{\step=2}{
    <label for="reply4"> Au bout de combien d'années sa valeur sera-t-elle inférieure au quart de sa valeur initiale ?</label>
    \embed{reply4,7}
  }
}
###indication###
\hint{
  Pour diminuer une quantité de \p %, on la multiplie par \t.
}
#### Réponses ####
\answer{En 2021 }{\x1}{type=numeric}
\answer{En 2022}{\x2}{type=numeric}
\answer{En 2030}{\x3}{type=numeric}
\answer{Au bout de }{\n}{type=numeric}

\solution{
  <p>Le quart de \x est \xc.</p>
  <table class="wimsborder wimscenter">
  <tr><th>Année</th><th>Prix</th></tr>
  <tr><td>2020</td><td>\x</td></tr>
  <tr><td>2021</td><td>\x1</td></tr>
  <tr><td>2022</td><td>\x2</td></tr>
  <tr><td>...</td><td>...</td></tr>
  <tr><td>2030</td><td>\x3</td></tr>
  <tr><td>...</td><td>...</td></tr>
  <tr><td>\aa</td><td>\xa</td></tr>
  <tr><td>\as</td><td>\xs</td></tr>
  </table>
}
