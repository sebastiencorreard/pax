\title{Évolution des prix}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## choix du pourcentage et de la quantité numérique
\integer{p=randint(2..9)}
\integer{x=randint(150..199)}

\real{t=1+0.01*\p}
\real{x1=\t*\x}
\integer{x2=100*\t*\x1}
\real{x2=0.01*\x2}
\integer{x3=100*(\t^10)*\x}
\real{x3=0.01*\x3}

\integer{na=floor(log(3)/log(\t))}

\real{n=\na+1}

\integer{xa=100*\x*\t^(\na)}
\real{xa=0.01*\xa}
\integer{xs=100*\x*\t^(\n)}
\real{xs=0.01*\xs}

\integer{aa=2020+\na}
\integer{as=2020+\n}
\integer{xc=3*\x}

\steps{reply1,reply2,reply3
reply4}

####### enoncé de l'exo #######

\statement{
Un article coûte \x &euro; en 2020 et son prix augmente de \p % par an.
  \if{\step=1}{
  <p>
  <label for="reply1">Quel est le prix de cet article en 2021 ?</label>  \embed{reply1,10} (valeur exacte)<br>
  <label for="reply2">Quel est le prix de cet article en 2022 ?</label>  \embed{reply2,10} (valeur arrondie à 0,01 &euro;)<br>
  <label for="reply3">Quel est le prix de cet article en 2030 ?</label>  \embed{reply3,10} (valeur arrondie à 0,01 &euro;)<br>
  </p>                   }
  \if{\step=2}{
    <p><label for="reply4">Au bout de combien d'années (au minimum) son prix sera-t-il
    multiplié par 3 ?</label>
    \embed{reply4,7}.</p>
  }
}
###indication###
\hint{
  Pour augmenter une quantité de \p %, on la multiplie par \t.
}
#### Réponses ####
\answer{En 2021 }{\x1}{type=numeric}
\answer{En 2022}{\x2}{type=numeric}
\answer{En 2030}{\x3}{type=numeric}
\answer{Au bout de }{\n}{type=numeric}

\solution{

  <p>Le triple de \x est \xc.</p>
  <table class="wimsborder wimscenter">
  <tr><th scope="col">Année</th><th scope="col">Prix</th></tr>
  <tr><td>2020</td><td>\x</td></tr>
  <tr><td>2021</td><td>\x1</td></tr>
  <tr><td>2022</td><td>\x2</td></tr>
  <tr><td> ... </td><td> ... </td></tr>
  <tr><td> 2030 </td><td> \x3 </td></tr>
  <tr><td> ... </td><td> ... </td></tr>
  <tr><td>\aa</td><td>\xa</td></tr>
  <tr><td>\as</td><td>\xs</td></tr>
  </table>
}
