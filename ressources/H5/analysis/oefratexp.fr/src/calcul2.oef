\title{Calculer avec des exposants décimaux}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

\text{L=a,b,c,d,e}

%% choix des paramètres pour la question A
\integer{d1=random(10,100,1000)}
\real{p1=1/\d1}
\integer{c1=randint(2..7)}
\text{Q1=\(-\c1^{\p1})}
Liste de formules :
\text{G1=\(-) \(\root{k}{\c1}),\(\frac{1}{\root{k}{\c1}}),\(\root{k}{\c1}),\(-\frac{1}{\root{k}{\c1}}),\(-) \(\sqrt{\c1^k})}

\text{L1=shuffle(1,2,3,4,5)}
\integer{s1=position(1,\L1)}
\text{F1 = \G1[\L1[1]],\G1[\L1[2]],\G1[\L1[3]],\G1[\L1[4]],\G1[\L1[5]]}

%% choix des paramètres pour la question B
\integer{d2=10}
\integer{n2=random(3,7,9)}
\real{p2=0.1*\n2}
\integer{c2=random(2,3,5,6,7)}
\text{Q2=\(\c2^{\p2})}
Liste de formules :
\text{G2=\(\root{k}{\c2^n}),\(\frac{1}{\root{k}{\c2^n}}),\(k \sqrt{\c2^n}),\(\frac{k}{\sqrt{\c2^n}}),\(\frac{\c2^k}{\c2^n})}
\text{L2=shuffle(1,2,3,4,5)}
\integer{s2=position(1,\L2)}
\text{F2 = \G2[\L2[1]],\G2[\L2[2]],\G2[\L2[3]],\G2[\L2[4]],\G2[\L2[5]]}

%% choix des paramètres pour la question C
\integer{n3=2*randint(1..9)+1}
\real{p3=0.5*\n3}
\integer{c3=random(2,3,5,6,7)}
\text{Q3=\(\c3^{\p3})}
Liste de formules :
\text{G3=\(\sqrt{\c3^k}),\(-) \(\sqrt{\c3^k}),\(\frac{k}{\sqrt{\c3}}),\(\frac{\sqrt{\c3}}{k}),\(\root{k}{\c3}),\(\c3^k)}
\text{L3=shuffle(1,2,3,4,5)}
\integer{s3=position(1,\L3)}
\text{F3 = \G3[\L3[1]],\G3[\L3[2]],\G3[\L3[3]],\G3[\L3[4]],\G3[\L3[5]]}

%% choix des paramètres pour la question D
\integer{d4=random(10,100,1000)}
\real{p4=1/\d4}
\integer{c4=randint(2..7)}
\text{Q4=\(\c4^{-\p4})}
Liste de formules :
\text{G4=\(\frac{1}{\root{k}{\c4}}),\(-) \(\root{k}{\c4}),\(-\frac{1}{\root{k}{\c4}}),\(\root{k}{\c4}),\(-) \(\sqrt{\c4^k})}

\text{L4=shuffle(1,2,3,4,5)}
\integer{s4=position(1,\L4)}
\text{F4 = \G4[\L4[1]],\G4[\L4[2]],\G4[\L4[3]],\G4[\L4[4]],\G4[\L4[5]]}

%% choix des paramètres pour la question E
\integer{n5=2*randint(1..2)+1}
\real{p5=0.5*\n5}
\real{b5=random(2,5,0.5,0.1,0.2,10)}
\real{c5=\b5^2}
\text{Q5=\(\c5^{-\p5})}
Liste de formules :
\text{G5=\(\frac{1}{\sqrt{\c5^k}}),\(\sqrt{\c5^k}),\(-) \(\sqrt{\c5^k}),\(\frac{k}{\sqrt{\c5}}),\(\root{k}{\c5}),\(-\c5^k)}
\text{L5=shuffle(1,2,3,4,5)}
\integer{s5=position(1,\L5)}
\text{F5 = \G5[\L5[1]],\G5[\L5[2]],\G5[\L5[3]],\G5[\L5[4]],\G5[\L5[5]]}
\real{a5=1/(\b5^\n5)}

\text{sol=<p>A = \Q1 = \(-) \(\root{\d1}{\c1})</p>
<p>B = \Q2 = \(\root{\d2}{\c2^\n2})</p>
<p>C = \Q3 = \(\sqrt{\c3^\n3})</p>
<p>D = \Q4 = \(\frac{1}{\root{\d4}{\c4}})</p>
<p>E = \Q5 = \(\frac{1}{\sqrt{\c5^\n5}})</p>}

\steps{reply 1,reply 2
reply 3,reply 4,reply 5
reply 6,reply 7
reply 8,reply 9
reply 10,reply 11
reply 12}

%%%%%%% enoncé de l'exo %%%%%%%

\statement{
<p class="wims_question">On veut écrire les puissances rationnelles
  suivantes à l'aide du symbole \(\sqrt{ }).<br>
Choisir la formule puis le ou les entiers positifs adaptés.</p>
\if{\step=1}{
  <h2>Question 1/6</h2>
  <table class="wimscenter wimsborder">
  <caption>A = \Q1</caption>
  <tr>
  <td>\embed{reply1,1}</td><td>\embed{reply1,2}</td><td>\embed{reply1,3}</td>
  <td>\embed{reply1,4}</td><td>\embed{reply1,5}</td></tr>
  <tr><td>\F1[1]</td><td>\F1[2]</td><td>\F1[3]</td>
  <td>\F1[4]</td><td>\F1[5]</td></tr>
  </table>
  <div>
  <label for="reply2">On utilise la formule choisie ci-dessus où \(k) est
  un nombre entier positif qui vaut</label> \embed{reply2,5}.</div>
}
\if{\step=2}{
  <h2>Question 2/6</h2>
  <table class="wimscenter wimsborder">
  <caption>B = \Q2</caption>
  <tr>
  <td>\embed{reply3,1}</td><td>\embed{reply3,2}</td><td>\embed{reply3,3}</td>
  <td>\embed{reply3,4}</td><td>\embed{reply3,5}</td></tr>
  <td>\F2[1]</td><td>\F2[2]</td><td>\F2[3]</td>
  <td>\F2[4]</td><td>\F2[5]</td></tr>
  </table>
  On utilise la formule choisie ci-dessus où \(k) et \(n) sont des nombres entiers positifs.
  <ul><li>
  <label for="reply4">Quelle est la valeur de \(k) ?</label> \embed{reply4,5}.
  </li><li>
  <label for="reply5">Quelle est la valeur de \(n) ?</label> \embed{reply5,5}.
  </li></ul>
}
\if{\step=3}{
  <h2>Question 3/6</h2>
  <table class="wimscenter wimsborder">
  <caption>C = \Q3</caption>
  <tr>
  <td>\embed{reply6,1}</td><td>\embed{reply6,2}</td><td>\embed{reply6,3}</td>
  <td>\embed{reply6,4}</td><td>\embed{reply6,5}</td></tr>
  <td>\F3[1]</td><td>\F3[2]</td><td>\F3[3]</td>
  <td>\F3[4]</td><td>\F3[5]</td></tr>
  </table>
  <label for="reply7">On utilise la formule choisie ci-dessus où \(k) est un nombre entier positif qui vaut</label>
 \embed{reply7,5}
}
\if{\step=4}{
  <h2>Question 4/6</h2>
  <table class="wimscenter wimsborder">
  <caption>D = \Q4</caption><tr>
  <td>\embed{reply8,1}</td><td>\embed{reply8,2}</td><td>\embed{reply8,3}</td>
  <td>\embed{reply8,4}</td><td>\embed{reply8,5}</td></tr>
  <td>\F4[1]</td><td>\F4[2]</td><td>\F4[3]</td>
  <td>\F4[4]</td><td>\F4[5]</td></tr>
  </table>
  <label for="reply9">On utilise la formule ci-dessus où \(k) est un nombre entier positif qui vaut</label> \embed{reply9,5}.<br>
}
\if{\step=5}{
  <h2>Question 5/6</h2>
  <table class="wimscenter wimsborder">
  <caption>E = \Q5</caption><tr>
  <td>\embed{reply10,1}</td><td>\embed{reply10,2}</td><td>\embed{reply10,3}</td>
  <td>\embed{reply10,4}</td><td>\embed{reply10,5}</td></tr>
  <td>\F5[1]</td><td>\F5[2]</td><td>\F5[3]</td>
  <td>\F5[4]</td><td>\F5[5]</td></tr>
  </table>
<label for="reply11">On utilise la formule ci-dessus où \(k) est un nombre entier positif
  qui vaut</label> \embed{reply11,5}.<br>
}
\if{\step=6}{
  <h2>Question 6/6</h2>
  <b>Bravo !</b> Toutes les réponses sont bonnes !<br>
  Mais saurez vous trouver lequel de ces nombres est un nombre décimal ?
  <ul class="wims_nopuce">
  <li>\embed{reply12,1} = \Q1 = \(-) \(\root{\d1}{\c1})
  </li><li>\embed{reply12,2} = \Q2 = \(\root{\d2}{\c2^\n2})
  </li><li>\embed{reply12,3} = \Q3 = \(\sqrt{\c3^\n3})
  </li><li>\embed{reply12,4} = \Q4 = \(\frac{1}{\root{\d4}{\c4}})
  </li><li>\embed{reply12,5} = \Q5 = \(\frac{1}{\sqrt{\c5^\n5}})
  </li></ul>
}
}

%%%% Réponses %%%%
\answer{Formule 1}{\s1;\L}{type=radio}
\answer{k}{\d1}{type=numeric}
\answer{Formule 2}{\s2;\L}{type=radio}
\answer{k}{\d2}{type=numeric}
\answer{n}{\n2}{type=numeric}
\answer{Formule 3}{\s3;\L}{type=radio}
\answer{k}{\n3}{type=numeric}
\answer{Formule 4}{\s4;\L}{type=radio}
\answer{k}{\d4}{type=numeric}
\answer{Formule 5}{\s5;\L}{type=radio}
\answer{k}{\n5}{type=numeric}
\answer{Nombre décimal}{5;A,B,C,D,E}{type=radio}

\hint{
\if{\step=1}{
Écrire \p1 sous la forme d'une fraction.
}
\if{\step=2}{
Écrire \p2 sous la forme d'une fraction.
}
\if{\step=3}{
Écrire \p3 sous la forme d'une fraction de dénominateur 2 pour utiliser la racine carrée.
}
\if{\step=4}{
Écrire \p4 sous la forme d'une fraction et se rappeler que \(a^{-x} = \frac{1}{a^x}).
}
\if{\step=5}{
Écrire \p5 sous la forme d'une fraction de dénominateur 2 pour utiliser la racine carrée.<br>
Et se rappeler que \(a^{-x} = \frac{1}{a^x}).
}
}

\solution{
\sol
\if{\step=6}{
<p>
Seul E est un nombre décimal car \(\sqrt{\c5^\n5} = \b5^\n5) et E =\(\frac{1}{\b5^\n5}) = \a5.
</p>
}
}
