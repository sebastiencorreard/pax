\author{Rémi Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}
\precision{500}
\title{Le placement d'Adrien}

\integer{av=100*randint(10..30)}
\real{p=0.1*randint(30..90)}
\real{cm=1+\p/100}
\real{cn=\cm^0.25}
\integer{nv=10000*\cn-10000}
\real{p1=0.01*\nv}

\text{tsol=<ul><li>Le coefficient multiplicateur pour un an est :
\(CM = 1 + \frac{\p}{100} = \cm)
</li><li>
Si \(k) est le coefficient multiplicateur pour un trimestre alors \(k^4*\av=\cm*\av)
</li><li>
Donc \(k = \root{4}{\cm} \approx \cn) et donc le taux trimestriel est de \p1 %.
</li></ul>}

\statement{
<ul class="wims_nopuce">
<li>Adrien a placé \av &euro; sur un compte à intérêts composés à \p % par an.</li>
<li>Cela signifie qu'au bout d'un an, il touchera \p % d'intérêts qui seront ajoutés
à son capital, et l'année suivante,
 il touchera \p % d'intérêts non seulement sur les \av &euro;,
 mais aussi sur les intérêts obtenus la première année.</li>
<li>Supposons que les intérêts soient calculés et ajoutés chaque trimestre.</li>
<li><label for="reply1">Quel taux d'intérêts composés trimestriel conduirait
au taux de \p % par an ?</label></li></ul>
<div class="wimscenter">\embed{reply1} % (arrondir à 0,01 % près).</div>
}
\answer{taux moyen}{\p1}{type=numeric}{option=absolute}

\solution{\tsol}
