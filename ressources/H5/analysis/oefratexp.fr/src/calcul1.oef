\title{Calculer avec des exposants rationnels}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% choix des paramètres pour l'exercice A
\integer{a=random(2,3,5,6,7,11)}
\integer{k=randint(2..9)}
\integer{b=\k^2}
\integer{n=randint(3..7)}
\integer{s1=\a*\k}

%% choix des paramètres pour l'exercice B
\integer{c=random(2,3,5,6,7,11)}
\integer{m=2*randint(1..7)+1}
\integer{s2=2*\m}
\integer{s3=\m+2}

%% choix des paramètres pour l'exercice B
\real{p=random(0.2,2,3,5,10)}
\real{d=\p^3}

%%%%%%% enoncé de l'exo %%%%%%%

\statement{
  <ol style="list-style-type: upper-alpha">
  <li>On peut écrire \(\a^{2/3} \times \b^{1/3}) sous la forme \(x^{2/3}).
   <div><label for="reply1">Quelle est la valeur de \(x) ?</label> \embed{reply1,5}</div>
  </li><li>
  On peut écrire \(\sqrt{\c} \times \root{\m}{\c}) sous la forme \(\root{d}{\c^n}).
  <ul><li>
  <label for="reply2">Quelle est la valeur de \(d) ?</label> \embed{reply2,5}</li><li>
  <label for="reply3">Quelle est la valeur de \(n) ?</label> \embed{reply3,5}</li></ul>
  </li><li>
  Calculer \(y = (\frac{1}{\d})^{-1/3}).
  <div>
  <label for="reply4">Quelle est la valeur de \(y) ?</label> \embed{reply4,5}
  </div>
  </li></ol>
}

%%%% Réponses %%%%
\answer{x }{\s1}{type=numeric}
\answer{d}{\s2}{type=numeric}
\answer{n}{\s3}{type=numeric}
\answer{n}{\p}{type=numeric}
\hint{
  <ol style="list-style-type: upper-alpha">
  <li>
  Remarquer que \b est un carré.
  </li><li>
  Remarquer que \(\sqrt{\c} = \c^{1/2}) et interpréter \(\root{\m}{\c}) comme \(\c^t).
  </li><li>
  \(a^{-1/3}) est l'inverse de \(a^{1/3}) et \d est le cube d'un nombre.
  </li></ol>
   }
  \solution{
  <ol style="list-style-type: upper-alpha">
  <li>
  \(\a^{2/3} \times \b^{1/3} = \a^{2/3} \times \k^{2/3} = (\a \times \k)^{2/3} = \s1^{2/3}).
  </li><li>
  \(\sqrt{\c} \times \root{\m}{\c} = \c^{1/2} \times \c^{1/\m} = \c^{1/2 + 1/\m} = \c^{\s3/\s2}).
  </li><li>
  \(y = (\frac{1}{\d})^{-1/3} = \d^{1/3} = \root{3}{\d} = \p).
  </li></ol>
}
