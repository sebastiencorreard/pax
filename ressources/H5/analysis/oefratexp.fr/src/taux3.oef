\title{Taux annuel}
\language{fr}
\range{-5..5}
\author{Rémi Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

##Choix de l'évolution##
\integer{n=randint(2)}

\text{t1=\n=1? augmentent : diminuent}
\text{t2=\n=1? augmentent-elles : diminuent-elles}
\text{t3=\n=1? d'augmentation : de diminution }

##Choix du pourcentage
\integer{p=randint(4..10)}
\if{\n=1}{\real{sp=\p}}{\real{sp=-\p}}
\real{q=1+0.01*\sp}
\real{k=\q^4}
\integer{pa=abs(\k-1)*1000}
\real{pa=0.1*\pa}

\statement{
<ul class="wims_nopuce">
<li>Chaque trimestre les ventes \t1 de \p % par rapport au trimestre précédent.</li>
<li><label for="reply1">De quel pourcentage \t2 au bout d'un an (4 trimestres) ?</label></li>
</ul>
<div class="wimscenter">
\embed{reply 1,5} % (à 0,1 % près).
</div>
}
\hint{Il s'agit d'une suite géométrique de raison \q.
<ul><li>
Quel coefficient correspond à 4 étapes ? </li><li>
A quel pourcentage correspond ce coefficient ?</li></ul>}

\answer{Pourcentage annuel}{\pa}{type=numeric}

\solution{Il s'agit d'une suite géométrique de raison \q.
Au bout de 4 trimestres, les ventes auront été multipliées par \k.
Ce qui correspond à un pourcentage \t3 de \pa %.
}
