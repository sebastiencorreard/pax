\solution{
<h2>A</h2>
\M1[1] = \M1[2] = \M1[3] et \M1[4] = \M1[3] donc<br>
 \((a^{1/d})^n) = \((a^n)^{1/d}) = \(a^{n/d}).

<h2>B</h2>
\M2[1] = \M2[2] et \M2[3] = \M2[4] = \M2[2] donc<br>
 \(a^{k/{k c}}) = \(a^{1/c})
<h2>C</h2>
\M3[2] = \M3[5] = \M3[1] = \M3[3] et \M3[4] = \M3[6] = \M3[3] donc<br>
\(a^{n/d} \times a^{m/p} =a^{\frac{n p}{d p} +\frac{m d}{p d}} = a^{n/d + m/p}).
<h2>D</h2>
\M4[2] = \M4[1] = \M4[4] et \M4[5] = \M4[6] = \M4[4] donc<br>
\(a^{-n/d}) = \(\frac{1}{a^{n/d}}) = \((a^{1/d})^{-n}).
<h2>E</h2>
\M5[2] = \M5[1] = \M5[4]
et \M5[5] = \M5[7] = \M5[4] ou \M5[5]=\M5[6] = \M5[4] donc<br>
\(a^{n/d} \times b^{n/d}) = \(((a b)^{1/d})^{n}) = \((a b)^{n/d}).
 }
