\title{Démonstrations sur les exposants rationnels}
\language{fr}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{Qa=<h2>A</h2><p>Étant donnés deux nombres entiers \(n) et \(d) strictement positifs, démontrons que les nombres \(u = (\root{d}{a})^n) et \(v = \root{d}{a^n}) sont égaux.</p>}
\text{M1=\(((\root{d}{a})^n)^d),\(((\root{d}{a})^d)^n),\(a^n),\((\root{d}{a^n})^d),\(\root{d}{a^{n d}})}

\text{Qb=<h2>B</h2><p>Étant donnés trois nombres entiers \(k), \(n) et \(d) strictement positifs, démontrons que les nombres \(u = \root{k c}{a^k}) et \(v = \root{c}{a}) sont égaux.</p>}
\text{M2=\((\root{k c}{a^k})^{k c}),\(a^k),\((\root{c}{a})^{k c}),\(((\root{c}{a})^c)^k),\(\root{c}{a^{k c}})}

\text{Qc=<h2>C</h2><p>Étant donnés quatre nombres entiers \(n), \(d), \(m) et \(p) strictement positifs, démontrons que
 les nombres \(u = a^{n/d} \times a^{m/p}) et \(v = a^{n/d + m/p}) sont égaux.</p>}
\text{M3=\(a^{n p} \times a^{m d}),\((a^{n/d} \times a^{m/p})^{d p}),\(a^{n p + m d}),\((a^{n/d + m/p})^{d p}),
\(((a^{n/d})^d)^p \times ((a^{m/p})^p)^d),\((a^{\frac{n p + m d}{d p}})^{d p}),\((a^{\frac{n m}{d p}})^{d p}),\(a^{n m})}

\text{Qd=<h2>D</h2><p>Étant donné deux nombres entiers \(n), \(d) strictement positifs et \(a>0), démontrons que
 les nombres \(u = \frac{1}{\root{d}{a^n}}) et \(v = \root{d}{a^{-n}}) sont égaux.</p>}
\text{M4= \(\frac{1}{(\root{d}{a^n})^d}),\((\frac{1}{\root{d}{a^n}})^d),\(\frac{n}{a}),\(\frac{1}{a^n}), \(( \root{d}{a^{-n}})^d),\(a^{-n}),\(-a^n)}

\text{Qe=<h2>E</h2><p>Étant donné deux nombres entiers \(n), \(d) strictement positifs et deux nombres réels \(a) et \(b) strictement positifs, démontrons que
 les nombres \(u = \root{d}{a^n} \times \root{d}{b^n}) et \(v = \root{d}{(a b)^n}) sont égaux.</p>}
\text{M5=\((\root{d}{a^n})^{d} \times (\root{d}{b^n})^{d}),\((\root{d}{a^n} \times \root{d}{b^n})^{d}),\((a b)^{2 n}),\(a^n b^n), \((\root{d}{(a b)^n})^d), \((\root{d}{a^n b^n})^d),
\((a b)^{n})}

\steps{
