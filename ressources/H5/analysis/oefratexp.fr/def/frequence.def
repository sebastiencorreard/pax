:solution
$()	  Vous avez choisi	  
!if $val47<1 
$()	    de répondre directement.	   
!else
$() 	    
!if $(val45[2])=1 
$()	      <h3>$val35 <strong>$(val22[2])</strong>.</h3>	      <img src="$val39"><img src="$val41">	     
!endif
$()	    
!if $(val45[3])=1 
$()	      <h3>$val35 <strong>$(val22[3])</strong>.</h3>	      <img src="$val39"><img src="$val43"><br>	      De LA<sub>3</sub> à RE# la fréquence est multipliée par 
!insmath x = \sqrt{2}
$()<br>	      De LA<sub>3</sub> à DO<sub>4</sub> la fréquence est multipliée par 
!insmath k = \sqrt[4]{2}
$()<br>	      De LA<sub>3</sub> à LA# la fréquence est multipliée par 
!insmath r = \sqrt[12]{2}
$()	     
!endif
$()	    
!if $(val45[4])=1 
$()	      <h3>$val35 <strong>$(val22[4])</strong>.</h3>	      Si on appelle 
!insmath r
$() le nombre par lequel est multiplié la fréquence lorsqu'on monte d'un demi-ton alors 
!insmath r^12=2
$().<br>	    Donc 
!insmath r = \sqrt[12]{2} \approx
$() $val37.	   
!endif
$()	  
!if $(val45[5])=1 
$()	    <h3>$val35 <strong>$(val22[5])</strong>.</h3>	    Par la fonction cube 
!insmath f
$() définie sur &#91 0 ; 
!insmath +\infty
$()&#91 par 
!insmath x \mapsto x^12
$(), le nombre 2 a un antécédent.<br>	    La courbe de 
!insmath f
$() est :<br>	     
!read oef/draw.phtml 200,400 \
$val44 
$()	   
!endif
$()	  
!if $(val45[6])=1 
$()	    <h3>$val35 <strong>$(val22[6])</strong>.</h3>	    Voici un tableau de valeurs.	    <table class="wimscenter wimsborder">	    <tr><th>
!insmath x
$()</td><td>1,05</td><td>1,055</td><td>1,059</td><td>1,0594</td><td>1,0595</td><td>1,06</td><td>1,065</td></tr>	    <tr><th>
!insmath x^12
$()</td><td>1,796</td><td>1,901</td><td>1,9895</td><td>1,9986</td><td>2,0008</td><td>2,012</td><td>2,129</td></tr>	    </table>	   
!endif
$()	  
!if $(val45[7])=1 
$()	    <h3>$val35 <strong>$(val22[7])</strong>.</h3>	    Algorithme possible :	    <ul>	      <li>A 
!insmath \leftarrow
$() 1</li>	      <li>B 
!insmath \leftarrow
$() 2</li>	      <li>P 
!insmath \leftarrow
$() 0,001 (<i>P est la précision voulue.</i>)</li>	      <li>Tant que B 
!insmath -
$() A 
!insmath \gt
$() P faire :	      <ul>	        <li>X 
!insmath \leftarrow
$() (A + B)/2</li>	        <li>Y 
!insmath \leftarrow
$() X^3</li>	        <li>Si Y 
!insmath \gt
$() 2 alors B 
!insmath \leftarrow
$() X sinon A 
!insmath \leftarrow
$() X</li>	        <li>Fin Tant que</li>	      </ul></li>	      <li>Afficher A, Afficher B</li>	    </ul>	     
!endif
$()	   
!endif
$()	  <p>La bonne réponse est 
!insmath \sqrt[12]{2} \approx
$() $val37.</p>	
