val6=$[rint($(tmp0))]
tmp=!trim pi,2^pi,\(2^\pi),\(\pi)	sqrt(7),2^sqrt(7),\(2^{\sqrt{7}}),\(\sqrt{7})	sqrt(3),2^sqrt(3),\(2^{\sqrt{3}}),\(\sqrt{3})	sqrt(5),2^sqrt(5),\(2^{\sqrt{5}}),\(\sqrt{5})	sqrt(6),2^sqrt(6),\(2^{\sqrt{6}}),\(\sqrt{6})
val7=!translate internal $	\
$ to ;; in $tmp
val8=$[$(val7[$val6;1])]
val9=$[$(val7[$val6;2])]
val10=$(val7[$val6;3])
val11=$(val7[$val6;4])
val12=$[rint(floor(10*$val8))]
val13=$[rint($val12+1)]
val14=$[2^(0.1*$val12)]
val15=$[2^(0.1*$val13)]
val16=$[rint(floor(100*$val8))]
val17=$[rint($val16+1)]
val18=$[2^(0.01*$val16)]
val19=$[2^(0.01*$val17)]
val20=$[rint(floor(1000*$val8))]
val21=$[rint($val20+1)]
val22=$[2^(0.001*$val20)]
val23=$[2^(0.001*$val21)]
oefsteps=reply1,reply2	reply3,reply4	reply5,reply6 
nextstep=!nosubst reply1,reply2	reply3,reply4	reply5,reply6 
!readproc oef/steps.proc
