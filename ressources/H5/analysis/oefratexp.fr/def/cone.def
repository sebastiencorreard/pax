val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 10

val6=$[rint($(tmp0))]
tmp0=!randint 4, $val6

val7=$[rint($(tmp0))]
val8=$[2^(1/3)]
val9=$[rint(100*$val8*$val6)]
val9=$[0.01*$val9]
val10=$[rint(100*$val8*$val7)]
val10=$[0.01*$val10]
t_=!rawmath $val7^2*$val6/12
val11=!exec pari print($t_)
val12=$[3^(1/3)]
val13=$[rint(100*$val12*$val6)]
val13=$[0.01*$val13]
val14=$[rint(100*$val12*$val7)]
val14=$[0.01*$val14]
replytype1=numeric
replyoption1=absolute 
replyname1=Hauteur pour doubler
replygood1=$[$val9]
replytype2=numeric
replyoption2=absolute 
