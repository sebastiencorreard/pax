replygood2=$[$val10]
replytype3=numeric
replyoption3=absolute 
replyname3=Hauteur pour tripler
replygood3=$[$val13]
replytype4=numeric
replyoption4=absolute 
replyname4=Diamètre pour tripler
replygood4=$[$val14]
