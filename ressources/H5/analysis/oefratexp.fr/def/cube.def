:solution
$()	  Vous avez choisi	  
!if $val44<1 
$()	    de répondre directement.	   
!else
$() 	    
!if $(val42[2])=1 
$()	      <h3>$val35 <strong>$(val22[2])</strong>.</h3>	      <img src="$val40"><br>	      Le cube bleu a un volume double mais son arête n'est pas le double de celle du cube noir.</li>	     
!endif
$()	    
!if $(val42[3])=1 
$()	      <h3>la méthode  <strong>$(val22[3])</strong>.</h3>	      Si le cube initial a pour arête 1, son volume est 1.<br>	      Le cube final a pour arête 
!insmath x
$() et pour volume 
!insmath x^3=2
$().	     
!endif
$()	    
!if $(val42[4])=1 
$()	      <h3>la méthode  <strong>$(val22[4])</strong>.</h3>	      Par la fonction cube 
!insmath f
$() définie sur &#91 0 ; 
!insmath +\infty
$()&#91 par 
!insmath x \mapsto x^3
$(), le nombre 2 a un antécédent.<br>	    La courbe de 
!insmath f
$() est :<br>	     
!read oef/draw.phtml 200,400 \
$val41 
$()	   
!endif
$()	  
!if $(val42[5])=1 
$()	    <h3>$val35 <strong>$(val22[5])</strong>.</h3>	    Voici un tableau de valeurs.	    <table class="wimsborder wimscenter">	    <tr><td>
!insmath x
$()</td><td>1,2</td><td>1,25</td><td>1,26</td><td>1,3</td></tr>	    <tr><td>
!insmath x^3
$()</td><td>1,728</td><td>1,953</td><td>2,0004</td><td>2,197</td></tr>	    </table>	   
!endif
$()	  
!if $(val42[6])=1 
$()	    <h3>$val35 <strong>$(val22[6])</strong>.</h3>	    Algorithme possible :	    <ul>	      <li>A 
!insmath \leftarrow
$() 1</li>	      <li>B 
!insmath \leftarrow
$() 2</li>	      <li>P 
!insmath \leftarrow
$() 0,001 (<i>P est la précision voulue.</i>)</li>	      <li>Tant que B 
!insmath -
$() A 
!insmath \gt
$() P faire :	      <ul>	        <li>X 
!insmath \leftarrow
$() (A + B)/2</li>	        <li>Y 
!insmath \leftarrow
$() X^3</li>	        <li>Si Y 
!insmath \gt
$() 2 alors B 
!insmath \leftarrow
$() X sinon A 
!insmath \leftarrow
$() X</li>	        <li>Fin Tant que</li>	      </ul></li>	      <li>Afficher A, Afficher B</li>	    </ul>	     
!endif
$()	   
!endif
$()	  <p>La bonne réponse est 
!insmath \sqrt[3]{2} \approx $val37 \approx $val38
$().</p>	
$()
