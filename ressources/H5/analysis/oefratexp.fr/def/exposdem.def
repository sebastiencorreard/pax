:solution
$()	<h2>A</h2>	$(val7[1]) = $(val7[2]) = $(val7[3]) et $(val7[4]) = $(val7[3]) donc<br>	 
!insmath (a^{1/d})^n
$() = 
!insmath (a^n)^{1/d}
$() = 
!insmath a^{n/d}
$().		<h2>B</h2>	$(val9[1]) = $(val9[2]) et $(val9[3]) = $(val9[4]) = $(val9[2]) donc<br>	 
!insmath a^{k/{k c}}
$() = 
!insmath a^{1/c}
$()	<h2>C</h2>	$(val11[2]) = $(val11[5]) = $(val11[1]) = $(val11[3]) et $(val11[4]) = $(val11[6]) = $(val11[3]) donc<br>	
!insmath a^{n/d} \times a^{m/p} =a^{\frac{n p}{d p} +\frac{m d}{p d}} = a^{n/d + m/p}
$().	<h2>D</h2>	$(val13[2]) = $(val13[1]) = $(val13[4]) et $(val13[5]) = $(val13[6]) = $(val13[4]) donc<br>	
!insmath a^{-n/d}
$() = 
!insmath \frac{1}{a^{n/d}}
$() = 
!insmath (a^{1/d})^{-n}
$().	<h2>E</h2>	$(val15[2]) = $(val15[1]) = $(val15[4])	et $(val15[5]) = $(val15[7]) = $(val15[4]) ou $(val15[5])=$(val15[6]) = $(val15[4]) donc<br>	
!insmath a^{n/d} \times b^{n/d}
$() = 
!insmath ((a b)^{1/d})^{n}
$() = 
!insmath (a b)^{n/d}
$().	 
$()
!exit

