!set title=Calculer avec des exposants rationnels
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,5,6,7,11

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
val8=$[rint($val7^2)]
tmp0=!randint 3, 7

val9=$[rint($(tmp0))]
val10=$[rint($val6*$val7)]
tmp0=!randitem 2,3,5,6,7,11

val11=$[rint($(tmp0))]
tmp0=!randint 1, 7

val12=$[rint(2*$(tmp0)+1)]
val13=$[rint(2*$val12)]
val14=$[rint($val12+2)]
tmp0=!randitem 0.2,2,3,5,10

val15=$[$(tmp0)]
val16=$[$val15^3]
replytype1=numeric
replyname1=x
replygood1=$[$val10]
replytype2=numeric
replyname2=d
replygood2=$[$val13]
replytype3=numeric
replyname3=n
replygood3=$[$val14]
replytype4=numeric
replyname4=n
replygood4=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <ol style="list-style-type: upper-alpha">	  <li>On peut écrire 
!insmath $val6^{2/3} \times $val8^{1/3}
$() sous la forme 
!insmath x^{2/3}
$().	   <div><label for="reply1">Quelle est la valeur de 
!insmath x
$() ?</label>  
!read oef/embed.phtml reply1,5 
$()</div>	  </li><li>	  On peut écrire 
!insmath \sqrt{$val11} \times \root{$val12}{$val11}
$() sous la forme 
!insmath \root{d}{$val11^n}
$().	  <ul><li>	  <label for="reply2">Quelle est la valeur de 
!insmath d
$() ?</label>  
!read oef/embed.phtml reply2,5 
$()</li><li>	  <label for="reply3">Quelle est la valeur de 
!insmath n
$() ?</label>  
!read oef/embed.phtml reply3,5 
$()</li></ul>	  </li><li>	  Calculer 
!insmath y = (\frac{1}{$val16})^{-1/3}
$().	  <div>	  <label for="reply4">Quelle est la valeur de 
!insmath y
$() ?</label>  
!read oef/embed.phtml reply4,5 
$()	  </div>	  </li></ol>	
$()
!exit

:hint
$()	  <ol style="list-style-type: upper-alpha">	  <li>	  Remarquer que $val8 est un carré.	  </li><li>	  Remarquer que 
!insmath \sqrt{$val11} = $val11^{1/2}
$() et interpréter 
!insmath \root{$val12}{$val11}
$() comme 
!insmath $val11^t
$().	  </li><li>	  
!insmath a^{-1/3}
$() est l'inverse de 
!insmath a^{1/3}
$() et $val16 est le cube d'un nombre.	  </li></ol>	   
$()
!exit

:help
$()
$()
!exit

:solution
$()	  <ol style="list-style-type: upper-alpha">	  <li>	  
!insmath $val6^{2/3} \times $val8^{1/3} = $val6^{2/3} \times $val7^{2/3} = ($val6 \times $val7)^{2/3} = $val10^{2/3}
$().	  </li><li>	  
!insmath \sqrt{$val11} \times \root{$val12}{$val11} = $val11^{1/2} \times $val11^{1/$val12} = $val11^{1/2 + 1/$val12} = $val11^{$val14/$val13}
$().	  </li><li>	  
!insmath y = (\frac{1}{$val16})^{-1/3} = $val16^{1/3} = \root{3}{$val16} = $val15
$().	  </li></ol>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,11,12,13,14,15,16
embedcnt=4
