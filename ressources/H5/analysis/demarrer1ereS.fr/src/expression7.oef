\title{Expressions 7}

\text{name_statement=On suppose que la variable \(x\) varie dans l'intervalle,
  Déterminer les intervalles dans lesquels varient respectivement
  les expressions suivantes.}
\text{name_variation=varie dans l'intervalle}

\integer{a = random(2..5)}
\integer{b = (-1)^random(0,1)*random(1..5)}
\integer{c = (-1)*random(2..5)}
\integer{d = (-1)^random(0,1)*random(1..5)}
\integer{min = (-1)^random(0,1)*random(1..10)}
\integer{max = \min + random(1..5)}
\function{u=\a *x + \b}
\function{v= \d+\c *x}
\function{w=\a*(x-\min)^2 + \b}
\function{z=\c*(x-\max)^2 + \d}
\integer{rep1=\a*\min+\b}
\integer{rep2=\a*\max+\b}
\integer{rep3=\c*\max+\d}
\integer{rep4=\c*\min+\d}
\integer{rep5=\b}
\integer{rep6=\a*(\max-\min)^2+\b}
\integer{rep7=\c*(\max-\min)^2+\d}
\integer{rep8=\d}
\statement{<div class="monenonce">
<p>\name_statement[1] [\min ; \max].</p>
<p>\name_statement[2]</p>
<ul>
<li><label for="reply1">\(\u\) \name_variation</label> [\embed{reply1,4} ; \embed{reply2,4}]</li>
<li><label for="reply3">\(\v\) \name_variation</label> [\embed{reply3,4} ; \embed{reply4,4}]</li>
<li><label for="reply5">\(\w\) \name_variation</label> [\embed{reply5,4} ; \embed{reply6,4}]</li>
<li><label for="reply7">\(\z\) \name_variation</label> [\embed{reply7,4} ; \embed{reply8,4}]</li>
</ul>
</div>
}
\answer{}{\rep1}
\answer{}{\rep2}
\answer{}{\rep3}
\answer{}{\rep4}
\answer{}{\rep5}
\answer{}{\rep6}
\answer{}{\rep7}
\answer{}{\rep8}

