!set title=Terminologie 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Pour associer deux cases, cliquer sur l'une puis sur l'autre.
val7=Associer chaque énoncé de la colonne de gauche à son	  écriture mathématique.
val8=et
val9=désignent des fonctions qu'on suppose définies	  sur un intervalle commun
val10=\(f\) est le produit de \(u\) et de \(v\),	\(f\) est \(k\) fois le produit de \(u\) et de \(v\),	\(f\) est la somme de \(u\) et de \(v\),	\(f\) est \(k\) fois la somme de \(u\) et de \(v\),	\(f\) est la différence de \(u\) par \(v\),	\(f\) est le quotient de \(u\) par \(v\),	\(f\) est le carré de \(u\),	\(f\) est le cube de \(u\),	\(f\) est la racine carrée de \(u\),	\(f\) est le double de \(u\) augmenté de \(v\),	\(f\) est le triple de \(v\) augmenté de \(u\),	\(f\) est la somme du carré de \(u\) et du tiers de \(v\),	\(f\) est \(k\) fois l'inverse de \(v\),	\(f\) est le carré de la somme de \(u\) et de \(v\),	\(f\) est l'inverse de la somme de \(u\) et de \(v\),	\(f\) est \(k\) fois \(u\) divisé par \(v\) au carré,	\(f\) est \(k\) fois \(u\) divisé par la racine carrée de \(v\),	\(f\) est le carré de la somme de \(u\) et de \(v\),	\(f\) est le carré du quotient de \(u\) par \(v\),	\(f\) est le cube de la différence de \(u\) et de \(v\)
val11=\(f = u*v\),	\(f = k*u*v\),	\(f = u + v\),	\(f = k*(u+v)\),	\(f = u - v\),	\(f = (u)/(v)\),	\(f = u^2\),	\(f = u^3\),	\(f = sqrt(u) \),	\(f = 2 u + v\),	\(f = 3 v + u\),	\(f = u^2 + v/3\),	\(f = k/(v)\),	\(f = (u+ v)^2\),	\(f = 1/(u+ v)\),	\(f = k*u/(v)^2\),	\(f = k*u/(sqrt(v))\),	\(f = (u+v)^2\),	\(f = (u/v)^2\),	\(f = (u-v)^3\)
tmp0=!itemcnt $val11

val12=$(tmp0)
tmp0=!shuffle $val12

val13=$(tmp0)
val14=$(val10[$(val13[1])])
!for val15  = 2 to 8 
val14=$val14,$(val10[$(val13[$val15])]) 
!next
val16=$(val11[$(val13[1])])
!for val15  = 2 to 8 
val16=$val16,$(val11[$(val13[$val15])]) 
!next
val17=\(f\), \(u\) $val8 \(v\) $val9 \(I\).
replytype1=correspond
replyoption1=split shuffle 
replyname1=
replygood1=$val14;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

