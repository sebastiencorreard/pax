!set title=Expressions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer sur les expressions affines,	  c'est-à-dire celles qui sont du premier degré.
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val8=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val11=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val13=$[rint((-1)^$(tmp0)*$(tmp1))]
val14=!rawmath $val7 *x + $val8

!ifval $val7==1
val14=!rawmath x + $val8
!endif

!ifval $val7==-1
val14=!rawmath -x + $val8
!endif
val15=!rawmath $val10 + $val9 *x
val16=\($val13),\($val14), \($val15), \($val13/($val14)),\($val15/$val13), \(sqrt($val15)),\($val13($val14)),\($val11($val15) + $val12), \($val13($val15)^2),\($val11($val14)^2 + $val12),
val17=2,3,5,7,8
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=$val17 ; $val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="monenonce">	$val6	<div class="wimscenter"> 
!read oef/embed.phtml \reply1 
$()</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

