val23=$[rint(($val10)^2+($val12)^2)]
val24=$[rint(($val9)^2)]
val25=$[rint(($val10)^2 + $val12)]
val26=$[rint($val9*$val11)]
val27=$[rint($val13 + $val10*$val12)]
tmp0=!randint 1, 5

val28=$[rint($(tmp0))]
tmp0=!item $val28 of $val17

val29=$(tmp0)
