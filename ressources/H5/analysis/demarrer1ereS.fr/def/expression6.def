val14=!rawmath $val9*x + $val10
val15=!rawmath $val12 + $val11*x
val16=!rawmath $val11*x^2 + $val9*x
val17=\($val13($val14)($val15)),\($val13($val16)),\(($val14)^2 + ($val15)^2), \(($val14)^2 + $val12), \($val13 + ($val14)($val15)) 
val18=$[rint($val13*$val9*$val11)]
