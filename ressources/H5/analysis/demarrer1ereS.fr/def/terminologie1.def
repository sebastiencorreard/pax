val6=Choisir le bon terme dans les énoncés suivants.
tmp=!trim &#171; <span style="color:blue"> \(UUUU = (VVVV)^2\)</span> &#187; est une	 &#171; <span style="color:blue">il existe un seul réel \(x\), tel que \( UUUU = VVVV\)</span> &#187; est une	 Dans &#171; <span style="color:blue">\(VVVV\) est une somme</span> &#187;, le sujet est une	 Dans &#171; <span style="color:blue">calculer les racines de \(WWWW\)</span> &#187;, le complément du mot "racines" est une	 Dans &#171; <span style="color:blue">l'ensemble des solutions de \(E\) est vide</span> &#187;, la lettre E doit désigner une	 &#171; <span style="color:blue">\(w\) change de signe deux fois</span> &#187; est une	 &#171; <span style="color:blue"> \( UUUU = VVVV\) \(\Longleftrightarrow \)\( x = \sol\) </span> &#187; est une	 le premier membre de l'égalité &#171; <span style="color:blue"> \(f(x) = 0\)</span> &#187; est une	 écrire &#171; <span style="color:blue"> \(WWWW\) \(\Longleftrightarrow\) 0</span> &#187; est incorrect, car \(WWWW) est une	
val7=!translate internal $	\
$ to ;; in $tmp
val8=expression, équation, proposition 
tmp0=!randint 2, 5

val9=$[rint($(tmp0))]
tmp0=!randitem 0,1

tmp1=!randint 1, 5

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val11=$[rint((-1)*$(tmp0))]
tmp0=!randitem 0,1

tmp1=!randint 1, 5

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val13=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val14=$[rint($val13 + $(tmp0))]
val15=!rawmath $val9*x + $val10
val16=!rawmath $val12+$val11*x
val17=!rawmath $val9*x^2 + $val10*x + $val11
t_=!rawmath ($val12-$val10)/($val9-$val11)
val18=!exec pari print($t_)
val19=2,3,1,1,2,3,3,1,1
tmp0=!shuffle 9

val20=$(tmp0)
tmp0=!replace internal UUUU by $val15 in $val7

val7=$(tmp0)
tmp0=!replace internal VVVV by $val16 in $val7

val7=$(tmp0)
tmp0=!replace internal WWWW by $val17 in $val7

val7=$(tmp0)
replytype1=menu
replyname1=
replygood1=$(val19[$(val20[1])]) ; $val8
replytype2=menu
replyname2=
replygood2=$(val19[$(val20[2])]) ; $val8
