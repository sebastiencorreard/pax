replygood4=$(val19[$(val20[4])]) ; $val8
replytype5=menu
replyname5=
replygood5=$(val19[$(val20[5])]) ; $val8
replytype6=menu
replyname6=
replygood6=$(val19[$(val20[6])]) ; $val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

