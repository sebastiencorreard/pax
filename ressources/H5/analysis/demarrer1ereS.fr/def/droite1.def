!set title=Étude de droite 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Joachim,Yameogo
email=yameogo@math.unice.fr
language=fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=rouge,orange,vert
val7=Le plan \(\RR^2\) est muni d'un repère orthonormé
val8=Quel est le coefficient directeur de la droite \(D\)	  dessinée en
val9=Le coefficient directeur de la droite \(D\) est&nbsp;
val10=lightblue
val11=400
val12=400
val13=-4
val14=4
val15=-4
val16=4
val17=linewidth 1	parallel 0,$val15,0,$val16,0.2,0,floor(5*($val14))+1,$val10	parallel 0,$val15,0,$val16,-0.2,0,floor(5*abs($val13))+1,$val10	parallel $val13,0,$val14,0,0,0.2,floor(5*($val16))+1,$val10	parallel $val13,0,$val14,0,0,-0.2,floor(5*abs($val15))+1,$val10	
val18=linewidth 3	parallel 0,$val15,0,$val16,1,0,floor($val14+1),$val10	parallel 0,$val15,0,$val16,-1,0,floor(abs($val13)+1),$val10	parallel $val13,0,$val14,0,0,1,floor($val16+1),$val10	parallel $val13,0,$val14,0,0,-1,floor(abs($val15)+1),$val10	
val19=linewidth 2	vline 0,0,black	hline 0,0,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.7,-0.1,medium,i	text red,-0.2,0.7,medium,j	text black,-0.2,-0.1,medium,O	arrow $val14-1,0,$val14,0,10,black	arrow 0,$val16-1,0,$val16,10,black	text black,$val14-0.2,-0.2,large,x	text black,-0.2,$val16-0.2,large,y
val20=xrange $val13,$val14	yrange $val15,$val16	$val17	$val18	$val19	
tmp0=!randitem -1,1

tmp1=!randint 1, ($val14-1)

val21=$[rint($(tmp0)*$(tmp1))]
!if $val21>0 
tmp0=!randint ($val13+1), ($val21-1)

val22=$[rint($(tmp0))]
!else
tmp0=!randint ($val21+1), ($val14-1)

val22=$[rint($(tmp0))]
!endif
tmp0=!randitem -1,1

tmp1=!randint 1, ($val16-1)

val23=$[rint($(tmp0)*$(tmp1))]
!if $val23>0 
tmp0=!randint ($val15+1), ($val23-1)

val24=$[rint($(tmp0))]
!else
tmp0=!randint ($val23+1), ($val16-1)

val24=$[rint($(tmp0))]
!endif
t_=!replace internal \( by ( in ($val24-($val23))/($val22-($val21));
tmp0=!exec maxima $t_

val25=$(tmp0)
val26=$val23+($val25)*(x-($val21))
tmp0=!texmath $val25

val27=$(tmp0)
val28=$[rint($val22-$val21)]
val29=$[rint($val24-$val23)]
tmp0=!shuffle 3

val30=$(tmp0)
val31=red,orange,green
val32=$val20	linewidth 2	plot $(val31[$(val30[1])]),$val26	
replyname1=
replygood1=$val25
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div>	  $val7 
!insmath (O,i,j)
$().	  <br>	  $val8 $(val6[$(val30[1])])?	</div>	<div class="wimscenter">	   
!read oef/draw.phtml $val11,$val12 \
	 $val32	  
$()	 </div>	 <span style="background-color:lightblue">	 <label for="reply1">$val9:</label>  
!read oef/embed.phtml reply 1,10 
$().	 </span>	
$()
!exit

:hint
$()	  Vous pouvez utiliser le théorème suivant en prenant pour	  
!insmath A
$() et 
!insmath B
$() deux points appropriés du plan.	  <p style="background-color:wheat">	  <b>Théorème:</b> Soient 
!insmath A(x_{A},y_{A})
$() et	  
!insmath B(x_{B},y_{B})
$() deux points du plan.	  <br>	  Si 
!insmath x_{A}\neq x_{B}
$(), alors la droite 
!insmath (A B)
$() a pour coefficient directeur	  
!insmath m=\frac{y_B-y_A}{x_B-x_A}
$().	  </p>	
$()
!exit

:help
$()
$()
!exit

:solution
$()	  Voici un	  <span class="bold" style="color:darkcyan"">exemple de rédaction</span> de la solution:	  <br>	  Pour calculer le coefficient directeur de la droite 
!insmath D
$(), nous allons appliquer le	  théorème suivant avec les points 
!insmath A($val21,$val23)
$() et 
!insmath B($val22,$val24)
$() qui sont	  sur 
!insmath D
$().	  <p style="background-color:wheat">	  <b>Théorème:</b> Soient 
!insmath A(x_{A},y_{A})
$() et	  
!insmath B(x_{B},y_{B})
$() deux points du plan.	  <br>	  Si 
!insmath x_{A}\neq x_{B}
$(), alors la droite 
!insmath (AB)
$() a pour coefficient directeur	  
!insmath m=\frac{y_B-y_A}{x_B-x_A}
$().	  </p>	  On trouve 
!insmath y_B-y_A=$val29
$(), 
!insmath x_B-x_A=$val28
$(), donc le coefficient directeur de la	  droite en question est 
!insmath m=$val27
$().	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,11,12,21,22,23,24,27,28,29,30,32
embedcnt=1
