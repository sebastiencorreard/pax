tmp0=!randitem 0,1

tmp1=!randint 1, 10

val15=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val16=$[rint((-1)^$(tmp0)*$(tmp1))]
val17=!rawmath $val7 *x + $val8

!ifval $val7==1
val17=!rawmath x + $val8
!endif

!ifval $val7==-1
val17=!rawmath -x + $val8
!endif
val18=!rawmath $val10 + $val9 *x
val19=!rawmath $val14*x^2 +$val15*x + $val16
val20=\($val19),\($val13($val19)), \(($val17) +$val11($val19)) , \( $val17 + $val13($val18)^2), \( ($val17)($val18)) , \(($val18/$val13)^2),	\($val11($val18)^2 + $val12), \($val11 - $val12($val17)^2) , \($val13/($val17)^2), \($val17), \($val12($val19)^2 + $val11), \( ($val18)*($val19)), \(sqrt($val19)),\($val13($val17)/($val18))	
val21=1,2,3,4,5,6,7,8
