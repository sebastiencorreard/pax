val6=Cocher les expressions quadratiques,	  c'est-à-dire celles qui sont du second degré.
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val8=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

