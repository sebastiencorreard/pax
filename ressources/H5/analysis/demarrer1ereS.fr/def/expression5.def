val6=Cocher les expressions qui sont factorisées	<span style="color:red">au maximum</span> et dont les facteurs sont	<span style="color:red">au plus de degré deux</span>.
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val8=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val11=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val13=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint 1, 12

val14=$[rint($(tmp0))]
tmp0=!randint 1, 12

val15=$[rint($(tmp0))]
val16=!rawmath $val7 *x + $val8

!ifval $val7==1
val16=!rawmath x + $val8
!endif

!ifval $val7==-1
val16=!rawmath -x + $val8
!endif
val17=!rawmath $val10 + $val9 *x
val18=!rawmath x^2 + $val14
val19=!rawmath x^2 - $val15
val20=\($val11($val16)($val17)),\(($val17)($val18)),\($val12($val16)($val17)^2),\($val13($val18)^2),\(($val17/$val12)^2),	 \(($val17)($val19)), \(($val16)^2 + $val14), \($val11($val19)), \($val13 + ($val16)($val17)) , \($val12 ((x-$val7)^2 - $val14)), \(sqrt($val18)),\($val12($val16)/($val17))	
val21=1,2,3,4,5
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=$val21 ; $val20
question=__EXECUTED_1692754_EXERCISE__

