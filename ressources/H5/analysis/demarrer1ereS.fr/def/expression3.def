val6=Cocher les expressions qui se présentent	  comme des carrés d'autres expressions.
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val7=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val8=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

