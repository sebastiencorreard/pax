!if $status=waiting
 !exit
!endif

val6=Pour associer deux cases, cliquer sur l'une puis sur l'autre.
val7=Associer chaque énoncé de la colonne de gauche à son	  écriture mathématique.
val8=\(x\) appartient à l'intervalle \(I\),	  \(x\) n'appartient pas à l'intervalle \(I\),	  L'ensemble \(E\) est vide,	  Les intervalles \(I\) et \(J\) sont disjoints,	  \(x\) appartient à \(I\) et à \(J\),	  \(I\) est inclus dans \(J\) ou égal à \(J\),	  \(I\) est strictement inclus dans \(J\),	  \(x\) appartient à \(I\) ou à \(J\),	  \(J\) ne contient pas \(I\),	  \(I\) est l'intervalle fermé de \(a\) à \(b\),	  \(x\) est strictement inférieur à \(a\),	  \(x\) est inférieur ou égal à \(a\),	  \(x\) est strictement supérieur à \(a\),	  \(x\) est supérieur ou égal à \(a\),	  \(x\) est compris entre \(a\) et \(b\),	  \(x\) est compris entre \(a\) et \(b\),	  \(I\) est l'intervalle ouvert de \(a\) à \(b\),	  \(x\) est positif ou nul,	  \(x\) est strictement positif,	  La fonction \(f\) s'annule en \(a\),	  Les zéros de la fonction \(f\) sont \(a\) et \(b\)
val9=\(x \in I\),	  \(x \notin I\),	  \(E=\emptyset\),	  \(I \cap J = \emptyset\),	  \(x \in I\cap J\),	  \(I \subseteq J\),	  \(I \subset J\),	  \(x \in I \cup J\),	  \(I\) &nsub; \(J\),	  \(I = &#91; a ; b &#93;\),	  \(x < a\),	  \(x \leq a \),	  \(x \in &#93; a ; +\infty &#91;\),	  \(x \in &#91; a ; +\infty &#91;\),	  \(x \in &#91; a ; b &#93;\),	  \(a \leq x \leq b\),	  \(I = &#93;  a ; b &#91; \) ,	  \(x \geq 0\),	  \(x > 0\),	  \(f(a) = 0\),	  \(f(x) = 0 \Longleftrightarrow x = a \; ou \; x = b\)
tmp0=!itemcnt $val9

val10=$(tmp0)
tmp0=!shuffle $val10

val11=$(tmp0)
val12=$(val8[$(val11[1])])
!for val13  = 2 to 8 
val12=$val12,$(val8[$(val11[$val13])]) 
!next
val14=$(val9[$(val11[1])])
!for val13  = 2 to 8 
val14=$val14,$(val9[$(val11[$val13])]) 
!next
val15=
replytype1=correspond
replyoption1=split shuffle 
replyname1=
replygood1=$val12;$val14
