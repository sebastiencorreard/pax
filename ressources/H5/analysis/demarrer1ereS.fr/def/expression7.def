val6=On suppose que la variable \(x\) varie dans l'intervalle,	  Déterminer les intervalles dans lesquels varient respectivement	  les expressions suivantes.
val7=varie dans l'intervalle
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
tmp0=!randitem 0,1

tmp1=!randint 1, 5

val9=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val10=$[rint((-1)*$(tmp0))]
tmp0=!randitem 0,1

tmp1=!randint 1, 5

val11=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val12=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val13=$[rint($val12 + $(tmp0))]
val14=!rawmath $val8 *x + $val9
val15=!rawmath $val11+$val10 *x
val16=!rawmath $val8*(x-$val12)^2 + $val9
val17=!rawmath $val10*(x-$val13)^2 + $val11
val18=$[rint($val8*$val12+$val9)]
val19=$[rint($val8*$val13+$val9)]
val20=$[rint($val10*$val13+$val11)]
val21=$[rint($val10*$val12+$val11)]
val22=$[rint($val9)]
val23=$[rint($val8*($val13-$val12)^2+$val9)]
val24=$[rint($val10*($val13-$val12)^2+$val11)]
val25=$[rint($val11)]
replyname1=
replygood1=$val18
replyname2=
replygood2=$val19
replyname3=
replygood3=$val20
replyname4=
replygood4=$val21
replyname5=
replygood5=$val22
replyname6=
replygood6=$val23
replyname7=
replygood7=$val24
replyname8=
replygood8=$val25
question=__EXECUTED_1692754_EXERCISE__

