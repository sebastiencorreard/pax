!set title=Étude de signe 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=une constante, un carré multiplié par une constante,	  une somme de deux expressions positives, une somme de deux expressions négatives
val7=strictement négative,négative ou nulle,strictement positive,	  positive ou nulle
val8=L'expression, a un signe évident quel que soit le réel
val9=En effet \(f(x)\) s'écrit sous la forme,	  Par conséquent \(f(x)\) est toujours
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val10=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val11=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randitem 0,1

tmp1=!randint 1, 10

val12=$[rint((-1)^$(tmp0)*$(tmp1))]

!ifval $val12<0
val13=$[rint(1)]
!else
val13=$[rint(3)]
!endif

!ifval $val12<0
val14=$[rint(2)]
!else
val14=$[rint(4)]
!endif
tmp0=!randint 1, 10

val15=$[rint($(tmp0))]
tmp0=!randint 1, 10

val16=$[rint($(tmp0))]
t_=!rawmath -$val11/$val10
val17=!exec pari print($t_)
val18=!rawmath $val10 *x + $val11

!ifval $val10==1
val18=!rawmath x + $val11
!endif

!ifval $val10==-1
val18=!rawmath -x + $val11
!endif
val19=$val12,$val12($val18)^2,$val15($val18)^2 + $val16,-$val15($val18)^2 - $val16
tmp0=!randint 1, 4

val20=$[rint($(tmp0))]
tmp0=!item $val20 of $val19

val21=$(tmp0)
tmp0=!item $val20 of 1,2,3,4

val22=$(tmp0)
val23=$val13,$val14,3,1
tmp0=!item $val20 of $val23

val24=$(tmp0)
replytype1=menu
replyname1=forme
replygood1=$val22 ; $val6
replytype2=menu
replyname2=signe
replygood2=$val24 ; $val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="monenonce">	$(val8[1]) 
!insmath f(x) = $val21
$() $(val8[2]) 
!insmath x
$() :	</div>	<div class="wims_question">	<ul class="wims_nopuce">	<li>$(val9[1])  
!read oef/embed.phtml reply1 
$().</li>	<li>$(val9[2])  
!read oef/embed.phtml reply2 
$().</li>	</ul>	</div>	
$()
!exit

