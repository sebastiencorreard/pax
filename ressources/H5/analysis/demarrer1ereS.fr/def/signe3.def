$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 0==0
 <div class='oef_feedbacks'>	<div class="macorrection">	<b>Explications :</b>	
!if $val20==1 
$()On a 
!insmath f(x) = $val21
$() pour tout réel 
!insmath x
$(), donc 
!insmath f(x)
$() est toujours du signe de 
!insmath $val12
$() et ne s'annule jamais.  
!endif
$()	
!if $val20==2 
$()On a 
!insmath f(x) = $val21
$() pour tout réel 
!insmath x
$().<br> Or le carré 
!insmath ($val18)^2
$() est toujours positif, ou nul si 
!insmath x = $val17
$(),	donc 
!insmath f(x)
$() est toujours du signe de 
!insmath $val12
$() ou nul en 
!insmath $val17
$(). 
!endif
$()	
!if $val20==3 
$() 
!insmath $val15($val18)^2
$() est toujours	positif, ou nul si 
!insmath x = $val17
$().<br>	Le nombre 
!insmath $val16
$() est strictement positif, donc la somme	
!insmath f(x) = $val15($val18)^2 + $val16
$() est strictement positive, pour tout réel 
!insmath x
$(). 
!endif
$()	
!if $val20==4 
$() 
!insmath ($val18)^2
$() est toujours	positif, ou nul si 
!insmath x = $val17
$().	 Donc 
!insmath -$val15($val18)^2
$() est toujours négatif ou nul.<br> Le nombre 
!insmath -$val16
$() est strictement négatif et on peut écrire	
!insmath f(x) = -$val15($val18)^2 + (-$val16)
$(). Donc 
!insmath f(x)
$() est strictement négatif pour tout réel 
!insmath x
$(). 
!endif
$()	</div>
$()</div>
!endif

!exit

:test

!exit

