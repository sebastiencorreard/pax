\title	{Functie onderzoek}
\author	{Véronique Royer}
\email	{royer.veronique@wanadoo.fr}
\format	{html}
\language{nl}

\integer{a1=random(1..3)*random(1,-1)}
\integer{a2=random(1..3)*random(1,-1)}
\rational{c1=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c2=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c3=randint(1..10)*random(1,-1)/randint(1,2,3,5)}

\text{flist=\c1*x^2+\c2*x+\c3,
\c1*x^2+\c2*x,
\c1*x^2+\c3,
\c1*(\a2*x+\a1)^2}

\integer{\cas=random(1..4)}
\function{f=item(\cas,\flist)}

\function{F=diff(\f,x)}

\rational{x0=\cas<3?-(\c2)/(2*\c1) }
\rational{x0=\cas==3?0 }
\rational{x0=\cas==4?-(\a1/\a2) }
\rational{valextr=evaluate(\f,x=\x0)}
\text{inf=&#8734}
\text{I1=\(\langle) -&#8734; ; \(\x0) \(\rangle)}
\text{I2=\(\langle) \(\x0) ; +&#8734; \(\rangle)}
\text{choix3=+,-}
\integer{rep3=\c1>0?2:1}
\text{choix4=+,-}
\integer{rep4=\c1>0?1:2}
\text{choix5=stijgend,dalend}
\integer{rep5=\rep3}
\text{choix6=stijgend,dalend}
\integer{rep6=\rep4}
\text{choix7=minimum,maximum}
\integer{rep7=\rep6}
\text{nicef=wims(exec pari printtex(\f))}
\text{niceF=wims(exec pari printtex(\F))}
\steps{reply1,reply2,
reply3,reply4,reply5,reply6,reply7,reply8
}


\statement{
<table width="80%" align="center">
<tr bgcolor=#FFCC66><td>
Gegeven de functie \(f) gedefinieerd in \RR door &nbsp;\(f(x) \,=\, \nicef).</p>
<p>
Onderzoek deze functie en bepaal de extreme waarde(n) van \(f).
</p>
</td></tr></table>
\if{\step==1}{
<ol>
<li>
De functie \(f) is differentieerbaar in \RR :<br>
Voor alle re&euml;ele \(x) geldt : &nbsp; \(f'(x)\,=\,) \embed{reply1,20}
</li>
<li>Het tekenverloop van de afgeleide functie \(f') :<br>
De afgeleide functie \(f') is nul in \(x)  =  \embed{reply2,10} 
</li>
</ol>
}
\if{\step>1}{
<ol>
<li>De afgeleide functie van \(f) : 
<center> \(f'(x) \,=\, \niceF )</center>
</li>
<li>Het tekenverloop van \(f') : 
<center>
<table border=1 border="solid" width="50%">
<tr>
<td width="10%" align="center"> \(x)</td><td  width="30%" align="left">-\inf</td><td  width="5%" align="center">\x0</td>
<td width="30%" align="right">+\inf</td>
</tr>
<tr>
<td width="10%" align="center">\(f'(x))</td><td width="30%" align="center"> \embed{reply3} </td><td  width="5%" align="center">0</td><td width="30%" align="center"> \embed{reply4}</td>
</tr>
</table>
</center>
</li>
<li>Het verloop van \(f) :
<ul>
<li>
\(f) is \embed{reply5} op het interval   \I1
</li>
<li>
\(f) is \embed{reply6} op het interval   \I2
</li>
</ul>
</li>
<li>De extreme waarde van  \(f) :
<ul>
<li> \(f) bereikt in \(\x0) een \embed{reply7} met de waarde \embed{reply8, 10} 
</li>
</ul>
</li>
</ol>
}
}
\answer{De afgeleide \(f'(x))}{\F}{type=formal}
\answer{f'(x) wordt nul in }{\x0}
\answer{Het teken van f' }{\rep3;\choix3}{type=menu}
\answer{Het teken van f'}{\rep4;\choix4}{type=menu}
\answer{f stijgt}{\rep5;\choix5}{type=menu}
\answer{f daalt}{\rep6;\choix6}{type=menu}
\answer{Het soort extremum}{\rep7;\choix7}{type=menu}
\answer{De extreme waarde van \(f)}{\valextr}

\hint{Als de afgeleide functie f' van teken verandert voor een bepaalde x-waarde ,<br> 
zegt men dat \(f(x)) het "lokaal" extremum is van \(f) (een minimum of maximum). }



