\title	{De productregel}
\author	{Véronique Royer}
\email	{royer.veronique@wanadoo.fr}
\format	{html}
\language{nl}
\integer{a1=random(1..8)*random(1,-1)}
\integer{a2=random(1..8)*random(1,-1)}
\integer{c1=random(1..8)*random(1,-1)}
\integer{c2=random(1..8)*random(1,-1)}
\integer{c3=random(1..8)*random(1,-1)}
\integer{c4=random(1..8)*random(1,-1)}

\function{u=randitem(
 \a1*x+\a2,
 \a1*x^randint(2,3)
)}

\function{v=randitem(\c1*x^2+\c2*x+\c3,
\c3*x^2+random(\c4,\c4*x),
\c3*x+\c4)}

\function{f=(\u)(\v)}
\function{U=diff(\u,x)}
\function{V=diff(\v,x)}
\function{F=diff(\f,x)}
\function{factorF=maxima(factor(\F))}
\function{devF=maxima(expand(\F))}

\text{formule= \(f'=u'v+uv')}
\text{list= \(f'=u'v') , \(f'=u'v+uv'), \(f'=u'v-uv')}
\text{choix=shuffle(\list)}
\integer{rep3=position(\formule,\choix)}
\text{nicedevF = wims(texmath \devF)}
\text{nicefactorF = wims(texmath \factorF)}
\text{UU = wims(exec pari printtex(\u))}
\text{VV = wims(exec pari printtex(\v))}

\statement{

<table width="80%" align="center" >
<tr bgcolor=#FFCC66><td>
<p>Bepaal de afgeleide van een functie gedefinieerd in \RR
door \(f(x) = u(x) \cdot v(x))  met :
<center>
\(\begin{array}{l} u(x) \, = \, \UU \\ v(x) \, = \, \VV \end{array}) 
</p>
</td></tr></table>
De functies \(u) en \(v) zijn differentieerbaar in \(RR) en :
<center>\(u'(x)) = \embed{reply1,20} </center>
<center>\(v'(x)) = \embed{reply2,20} </center>
<p>
Om de afgeleide van \(f) te bepalen passen we de volgende regel toe :
<center>\embed{reply3}</center></p>
<p>
De afgeleide van de functie \(f) is dan:
<center>\(f'(x)) = \embed{reply4, 30}</center></p>
}
\answer{De afgeleide \(u'(x)) }{\U}{type=formal}
\answer{De afgeleide \(v'(x)) }{\V}{type=formal}
\answer{De differentie&euml;r regel }{\rep3;\choix}{type=checkbox}
\answer{De afgeleide \(f'(x))  }{\devF}{type=algexp}
\feedback{0==0}{<b>Oplossing.</b> <br/>
De uitgeschreven vorm van de afgeleide is \(f'(x)\,=\, \nicedevF). <br/>
De ontbonden vorm van de afgeleide is  \(f'(x)\,=\, \nicefactorF).}