\title	{De quoti&euml;nt regel}
\author	{Véronique Royer}
\email	{royer.lyjamo@wanadoo.fr}
\format	{html}
\language{nl}
\integer{a1=random(1..4)}
\integer{c1=random(1..4)*random(1,-1)}
\integer{c2=random(1..8)*random(1,-1)}
\integer{c3=random(1..4)*random(1,-1)}
\integer{c4=random(1..8)*random(1,-1)}

\text{ulist= \c1*x + \c2,
  x^2 + \c1,
 \c1*x^2 + \c2*x + \c3,
  \c1*random(x,x^2)
}
\text{vlist= \c3*x+\c4,
 (\c3*x+\c4)^2,
 \a1*random(x,x^2),
 x^2+\a1
}
\integer{casv=random(1..4)}
\integer{casu=(\casv==3)?random(1..3):random(1..4)}

\function{num=item(\casu , \ulist)}
\function{deno=item(\casv , \vlist)}
\rational{vi = \casv<3 ?-\c4 / \c3}
\rational{vi = \casv==3 ?0}
\rational{vi = \casv==4 ?0}
\integer{novi=\casv==4?1:0}
\text{ensder=\(\RR),\(\RR \setminus\{\vi\})}
\integer{rep5=\casv==4?1:2}

\function{dernum=diff(\num,x)}
\function{derdeno=diff(\deno,x)}
\function{f= (\num)/(\deno)}
\function{derf=diff(\f,x)}
\function{facderf=maxima(factor(\derf))}
\text{nicefacderf=wims(exec pari printtex(\facderf))}
\integer{casf=randint(1..3)}
\text{numA=u'v + uv'}
\text{numB=u'v - uv'}
\text{denoA=v^2}
\text{form1=\(f' = \numA)}
\text{form2=\(f' = \numB)}
\text{form3=\(f' = \frac{\numB}{\denoA})}
\text{form4=\(f' = \frac{u'}{v'})}
\text{form5=\(f' = \frac{\numA}{\denoA})}
\text{formules=\casf==3?\form1,\form2,\form3,\form4,\form5}
\text{formules=\casf==2?\form1,\form3,\form2,\form4,\form5}
\text{formules=\casf==1?\form3,\form1,\form2,\form4,\form5}
\integer{rep6=\casf}

\steps{reply1, reply2, reply3, reply4
reply5 , reply6
reply7}

\statement{<table width="80%" align="center" ><tr bgcolor=#FFCC66><td><p>Gegeven is de functie \(f) gedefinieerd in \if{\novi==1}{\RR}{\(\RR \setminus\{\vi \})} door &nbsp;  \(f(x)  = (\num)/(\deno)).</p><p> We gaan nu de afgeleide&nbsp; \(f) &nbsp;in stappen berekenen :</p></td></tr></table>\if{\step==1}{<ul><li> We schrijven \(f) als een quoti&euml;nt&nbsp;  \(\frac{u}{v}) ,waarbij de functies \(u) en \(v) zijn gedefinieerd in \RR door :<center>\(u(x)\,=\,) \embed{reply1, 15}  &nbsp;en&nbsp;\(v(x)\,=\, ) \embed{reply2, 15}  </center><p></li><li> De functies \(u) en \(v) zijn differentieerbaar in \RR :<center> \(u'(x)\,=\,)  \embed{reply3, 15}  &nbsp;en&nbsp;\(v'(x) \,=\, ) \embed{reply4, 15} </center></li>}{<li>  \(f) = \(\frac{u}{v}) met :<center> <p>\(u(x) = \num)  &nbsp;en&nbsp;\(u'(x) = \dernum)  </p><p>\(v(x) = \deno )  &nbsp;en&nbsp;\(v'(x) = \derdeno) </p></center></li>}\if{\step==2}{<li> De breuk  \(f = \frac{u}{v} ) is differentieerbaar in:  <center> \embed{reply5}</center></li><li> Welke formule passen we nu toe :<center> \embed{reply6}</center></li>}\if{\step==3}{<li> \(f) is differentieerbaar in \if{\novi==1}{\RR}{\(\RR \setminus\{\vi \})}. </li><li> Welke differentieerregel passen we toe : \form3 </li><li> We krijgen dus : <center> \(f'(x)) =  \embed{reply7, 50}</center> </li>}</ol>}

\answer{De teller \(u) is gedefinieerd door&nbsp;:&nbsp; \( u(x) ) }{\num}{type=formal}
\answer{De noemer \(v) is gedefinieerd door&nbsp;:&nbsp; \( v(x) ) }{\deno}{type=formal}
\answer{De afgeleide van de teller&nbsp;:&nbsp; \( u'(x) ) }{\dernum}{type=formal}
\answer{De afgeleide van de noemer&nbsp;:&nbsp; \( v'(x) ) }{\derdeno}{type=formal}
\answer{Differentieerbaar in&nbsp;:&nbsp; }{\rep5 ; \ensder}{type=radio}
\answer{De toegepaste formule&nbsp;:&nbsp; }{\rep6 ; \formules}{type=radio}
\answer{De afgeleide \(f') is gedefinieerd door&nbsp;:&nbsp; \( f'(x) )}{\facderf}{type=formal}

\feedback{0==0}{<b>Oplossing.</b> De afgeleide functie \(f') is gedefinieerd door &nbsp; \( f'(x) \,=\,\nicefacderf ) , \if{\novi==1}{voor alle re&euml;ele \(x)}{voor alle re&euml;ele \(x) uitgezonderd  \(\vi)} }



