val10=!exec pari print($t_)
val11=$val8*x^2+$val9*x+$val10,	$val8*x^2+$val9*x,	$val8*x^2+$val10,	$val8*($val7*x+$val6)^2
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

