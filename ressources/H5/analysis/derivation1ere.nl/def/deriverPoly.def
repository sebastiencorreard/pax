!set title=De afgeleide van een polynoom
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Véronique Royer
email=royer.veronique@wanadoo.fr
computeanswer=no
precision=100

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 10

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

t_=!rawmath $val6/$(tmp0)
val11=!exec pari print($t_)
tmp0=!randint 2, 5

t_=!rawmath $val7/$(tmp0)
val12=!exec pari print($t_)
tmp0=!randint 2, 5

t_=!rawmath $val8/$(tmp0)
val13=!exec pari print($t_)
tmp0=!randint 2, 5

t_=!rawmath $val9/$(tmp0)
val14=!exec pari print($t_)
tmp0=!randitem -1,1

tmp1=!randint 1, 100

val15=$[$(tmp0)*$(tmp1)/100]
tmp0=!randitem -1,1

tmp1=!randint 1, 100

val16=$[$(tmp0)*$(tmp1)/100]
tmp0=!randitem -1,1

tmp1=!randint 1, 100

val17=$[$(tmp0)*$(tmp1)/100]
tmp0=!randitem -1,1

tmp1=!randint 1, 100

val18=$[$(tmp0)*$(tmp1)/100]
tmp0=!randitem $val8*x^2 , $val9*x

tmp1=!randitem $val12*x^2 , $val13*x

tmp2=!randitem $val16*x^2 , $val17*x

tmp=!nonempty items $val10,	$val6 *x^4 + $val7*x^3+ $val8*x^2 + $val9*x + $val10,	$val6*x^3+ $(tmp0) + $val10,	 $val6*x^2 + $val9*x+ $val10,	 $val6*x^2 + $val10,	 $val6*x + $val10, 	$val11*x^3+ $(tmp1) + $val14,	$val11*x^2 + $val13*x + $val14,	$val11*x^2 + $val14,	$val11*x+$val14,	$val15*x^3+ $(tmp2) + $val18,	$val15*x^2 + $val17*x + $val18,	$val15*x^2 + $val18,	$val15*x + $val18	

tmp3=!randitem $tmp
val19=!rawmath $(tmp3)
tmp=!translate ;";': to $     $ in $val19,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val20=!rawmath $(tmp0)
tmp0=!texmath f(x)=$val19

val21=$(tmp0)
replytype1=function
replyname1=
replygood1=!rawmath $val20
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table width="80%" align="center" >	<tr bgcolor=#FFCC66><td>	<p>	Laat 
!insmath f
$() een polynoom zijn , gedefinieerd in $m_RR door	
!insmath $val21
$() 	.	<p> 
!insmath f
$() is differentieerbaar in  $m_RR. 	Bepaal de afgeleide.	</p>	</td></tr>	</table>	<center>  	Voor alle ree&euml;le 
!insmath x
$(),   &nbsp; 
!insmath f'(x)
$() =   
!read oef/embed.phtml reply1,30 
$()	</center>		
$()
!exit

:hint
$()	<p>Als 
!insmath f(x)\,=\,x^{n}
$() dan is 
!insmath f'(x)\,=\,nx^{n-1}
$() </p>	<p>Als 
!insmath f(x)\,=\,k \cdot u(x)
$() dan is 
!insmath f'(x)\,=\,k \cdot u'(x)
$() </p>	<p>Als 
!insmath f(x)\,=\,u(x)+v(x)
$() dan is 
!insmath f'(x)\,=\,u'(x)+v'(x)
$() </p>	De afgeleide van een polynoom bepaal je dus term voor term.	
$()
!exit

