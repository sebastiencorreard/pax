postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,3

tmp=!nonempty items 	 $val6*x+$val7,	 $val6*x^$(tmp0)	

tmp1=!randitem $tmp
val12=!rawmath $(tmp1)
tmp0=!randitem $val11,$val11*x

tmp=!nonempty items $val8*x^2+$val9*x+$val10,	$val10*x^2+$(tmp0),	$val10*x+$val11

tmp1=!randitem $tmp
val13=!rawmath $(tmp1)
val14=!rawmath ($val12)($val13)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in factor($val17)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val17)
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
val20=\(f'=u'v+uv')
val21=\(f'=u'v') , \(f'=u'v+uv'), \(f'=u'v-uv')
tmp0=!shuffle $val21

val22=$(tmp0)
tmp0=!positionof item $val20 in $val22

val23=$[rint($(tmp0))]
tmp0=!texmath $val19

val24=$(tmp0)
tmp0=!texmath $val18

val25=$(tmp0)
tmp0=!exec pari printtex($val12)

val26=$(tmp0)
tmp0=!exec pari printtex($val13)

val27=$(tmp0)
replytype1=formal
replyname1=De afgeleide \(u'(x))
replygood1=$val15
replytype2=formal
replyname2=De afgeleide \(v'(x))
replygood2=$val16
replytype3=checkbox
replyname3=De differentie&euml;r regel
replygood3=$val23;$val22
replytype4=algexp
replyname4=De afgeleide \(f'(x))
replygood4=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<table width="80%" align="center" >	<tr bgcolor=#FFCC66><td>	<p>Bepaal de afgeleide van een functie gedefinieerd in $m_RR	door 
!insmath f(x) = u(x) \cdot v(x)
$()  met :	<center>	
!insmath \begin{array}{l} u(x) \, = \, $val26 \\ v(x) \, = \, $val27 \end{array}
$() 	</p>	</td></tr></table>	De functies 
!insmath u
$() en 
!insmath v
$() zijn differentieerbaar in 
!insmath RR
$() en :	<center>
!insmath u'(x)
$() =  
!read oef/embed.phtml reply1,20 
$() </center>	<center>
!insmath v'(x)
$() =  
!read oef/embed.phtml reply2,20 
$() </center>	<p>	Om de afgeleide van 
!insmath f
$() te bepalen passen we de volgende regel toe :	<center> 
!read oef/embed.phtml reply3 
$()</center></p>	<p>	De afgeleide van de functie 
!insmath f
$() is dan:	<center>
!insmath f'(x)
$() =  
!read oef/embed.phtml reply4, 30 
$()</center></p>	
$()
