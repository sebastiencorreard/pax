val6=On fait apparaître l'expression de l'asymptote	  dans chacune des expressions algébriques&nbsp;
val7=au dessus,en dessous
val8=La courbe bleue représente une fonction	  \(f\), ses asymptotes sont représentées en pointillés rouge.
val9=Choisir l'expression algébrique pouvant correspondre à \(f\).
val10=Les deux dernières expressions ont des points de discontinuité et ne	  peuvent pas correspondre à \(f\).<br>La courbe se situant XXXX	  de son asymptote
val11=La troisième expression est donc la seule à présenter	  une seule asymptote verticale
val12=La dernière expression est donc la seule à présenter	  deux asymptotes verticales 
val13=la bonne expression pour \(f\) est
val14=\(-\infty\)
val15=\(+\infty\)
val16=\(\emptyset)
val17=&#59;
val18=$[rint(-5)]
val19=$[rint(5)]
val20=$[rint(-5)]
val21=$[rint(5)]
tmp0=!randitem 1,2,-1,-2

val22=$[rint($(tmp0))]
tmp0=!randitem 1,1,1,2,3

val23=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val22 / $val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val24=!exec pari print($t_)
val24=$val24
tmp0=!replace internal / by , in $val24

val24=$(tmp0)
val22=$[rint($(val24[1]))]
tmp0=!itemcnt $val24


!ifval $(tmp0)=1
val23=$[rint(1)]
!else
val23=$[rint($(val24[2]))]
!endif

!ifval $val23=1
val25=$val22
!else
val25=\(\frac{$val22}{$val23})
!endif

!ifval $val25=1
val25=
!else
val25=$val25
!endif

!ifval $val25=-1
val25=-
!else
val25=$val25
!endif
tmp0=!randint 1, 3

val26=$[rint($(tmp0))]
tmp0=!randint 1, 5

val27=$[rint($(tmp0))]
val28=$[rint(10*$val27)]
tmp0=!randint 1, 5

val29=$[rint($(tmp0))]
tmp0=!randint 1, 3

val30=$[rint($(tmp0))]
tmp0=!randint 1, 5

val31=$[rint($(tmp0))]
val32=+$val27*10/(($val29*x+$val30)^2+$val31), - $val27*10/(($val29*x+$val30)^2+$val31),+$val27/($val29*x+$val30),+ $val27/(($val29*x+$val30)*($val26*x-$val31))
val33=($val29*x+$val30)^2+$val31,($val29*x+$val30)^2+$val31,$val29*x+$val30,($val29*x+$val30)*($val26*x-$val31)
val34=
val35=
val36=
tmp0=!randint 1, 4

val37=$[rint($(tmp0))]
!for val38 =1 to 4 
val39=!rawmath $val22/$val23*x+$val26 $(val32[$val38])
tmp=!translate ";': to $     $ in $val39

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val39=!rawmath $(tmp0)
tmp0=!replace internal / by , in $val39

val40=$(tmp0)
tmp0=!declosing $(val40[1])

val41=$(tmp0)
tmp0=!declosing $(val40[2])

val42=$(tmp0)
val43=$(val33[$val38])
tmp0=!texmath $val41

tmp1=!texmath $val42

val44=\(\frac{$(tmp0)}{$(tmp1)})

!ifval $val38<3
tmp0=!texmath $val43

val45=!rawmath \(\frac{$val28}{$(tmp0)})
!else
tmp1=!texmath $val43

val45=!rawmath \(\frac{$val27}{$(tmp1)})
!endif
tmp0=!append item $val39 to $val34

val34=$(tmp0)
tmp0=!append item $val44 to $val35

val35=$(tmp0)
tmp0=!append item $val45 to $val36

val36=$(tmp0)
!next
val46=$val6:<br>	$(val35[1])=$val25 x + $val26 + $(val36[1])<br>	$(val35[2])=$val25 x + $val26 - $(val36[2])<br>	$(val35[3])=$val25 x + $val26 + $(val36[3])<br>	$(val35[4])=$val25 x + $val26 + $(val36[4])<br>
tmp0=!replace internal XXXX by $(val7[$val37]) in $val10

val10=$(tmp0)
!if $val37=1 or $val37=2 
val46=$val46 $val10, $val13 $(val35[$val37]).
val47=
!endif
!if $val37=3 
val46=$val46 $val11, $val13 $(val35[$val37]).
val47=dsegment -$val30/$val29,$val20,-$val30/$val29,$val21,red
!endif
!if $val37=4 
val46=$val46 $val10, $val13 $(val35[$val37]).
val47=dsegment -$val30/$val29,$val20,-$val30/$val29,$val21,red	  dsegment $val31/$val26,$val20,$val31/$val26,$val21,red	  
!endif

!ifval $val2=2
val48=style="font-size
!else
