\title{Coordonnées du sommet d'une parabole}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\credits{}
\precision{100}

\real{a=random(1,-1)*random(2,4,5,8,10,12)}
\real{d=randint(5..15)}
\real{xa=randint(-10..5)}
\real{xb=\xa+\d}
\function{f = simplify(\a*(x-\xa)*(x-\xb))}
\function{f=pari(\f)}
\real{x1=\xa-randint(1..4)}
\real{x3=\xb+randint(1..4)}
\real{x2=(\xa+\xb)/2}
\real{y1=evalue(\f,x=\x1)}
\real{y2=evalue(\f,x=\x2)}
\real{y3=evalue(\f,x=\x3)}

\function{df=diff(\f,x)}
\function{d2f=diff(\df,x)}
\real{a=\d2f/2}
\real{b=evalue(\df,x=0)}
\real{c=evalue(\f,x=0)}
\function{f = simplify(\a*x^2+\b*x+\c)}
\function{f=pari(\f)}
\real{x0=-\b/(2*\a)}
\real{y0=evalue(\f,x=\x0)}


\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{
<div class="enonce">
<p>Soit la parabole \(P\) d'équation \(y=\f\).</p>
<div>Quels sont les coefficients \(a\) et \(b\) :
<ul class="inline">
<li> \(a=\) \embed{r3,4}</li>
<li> \(b=\) \embed{r4,4}</li>
</ul>
</div>
Calculer :
<ul class="inline">
 <li>\(-b/(2*a)\) = \embed{r5,4}
 </li><li>
  \(f(-b/(2*a))\) = \embed{r6,4}
</li>
</ul>
<div>Le sommet \(S\) de la parabole \(P\) &nbsp; a pour coordonnées \(S\)
( \embed{r1,6} , \embed{r2,6})</div>
</div>
}

\answer{}{\x0}{type=numeric}
\answer{}{\y0}{type=numeric}
\answer{}{\a}{type=numeric}
\answer{}{\b}{type=numeric}
\answer{}{\x0}{type=numeric}
\answer{}{\y0}{type=numeric}
