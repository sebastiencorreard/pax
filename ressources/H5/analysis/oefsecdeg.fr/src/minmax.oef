\title{Minimum ou maximum}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\range(100)
\credits{}

\real{a = random(-1,1)*randint(1..30)}
\real{b = randint(-20..20)}
\real{c = randint(-20..20)}
\integer{e=random(0,1)}
\text{f = \e=0 ? \a*x^2+\b*x+\c : \b*x+\c+\a*x^2}
\function{f = pari(\f)}

\real{x0=-\b/(2*\a)}
\real{y0=evalue(\f,x=\x0)}

\text{lext=premier,second,troisième,autre}
\text{ext= \a<>0 ?second:autre}
\text{pext=position(\ext,\lext)}

\text{lext2=positif,negatif,ça depend}
\text{ext2= \a>0 ?positif:negatif}
\text{pext2=position(\ext2,\lext2)}

\text{lext3=minimum,maximum,ça depend}
\text{ext3= \a>0 ?minimum:maximum}
\text{pext3=position(\ext3,\lext3)}

\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{

<div class="enonce">
<div>Soit la fonction \(f\) définie pour tout \(x\) par \(f(x)=\f\).
Déterminer le minimum ou le maximum de \(f\).</div>
<div>\(f\) est une fonction du \embed{reply1} degré. Le coefficient \(a\) de \(x^2\) est égal à \embed{reply2,4}. Son signe est \embed{reply3}.</div>
<div>La fonction \(f\) admet donc un \embed{reply4} :</div>
<table class="wimscenter">
	<tr>
	  <th>\(-b/(2*a)\) = </th><td>\embed{reply5,4}</td>
	</tr>
	<tr>
	  <th>\(f(-b/(2*a))\) = </th><td>\embed{reply6,4}</td>
	</tr>
</table>
Le \embed{reply7} de la fonction \(f\) est égal à \embed{reply8}.
</div>

}


\answer{}{\pext;\lext}{type=menu}{option=shuffle}
\answer{}{\a}type=numeric{}
\answer{}{\pext2;\lext2}{type=menu}{option=shuffle}
\answer{}{\pext3;\lext3}{type=menu}{option=shuffle}
\answer{}{\x0}{type=numeric}
\answer{}{\y0}{type=numeric}
\answer{}{\pext3;\lext3}{type=menu}{option=shuffle}
\answer{}{\y0}{type=numeric}
