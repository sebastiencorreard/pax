\title{Identifier une parabole à partir de son équation}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{ 10000}
\credits{}


\integer{ a=random(-1,1)}
\integer{ b=randint(-2..2)}
\integer{ c=randint(-2..2)}
\function{ f=maxima(expand(\a*(x-\b)^2+\c))}
\integer{ xA=\b+random(-1,1)*random(1..2)}
\integer{ yA=evalue(\f,x=\xA)}
\integer{z=abs(\yA)}
\if{\z>4}{*** cela permet que l'origine du repère soit visible ***
\integer{xA=random(\b+1,\b-1)}
\integer{ yA=evalue(\f,x=\xA)}
}
\integer{ xm=\xA-5}
\integer{ xM=\xA+5}
\integer{ ym=\yA-5}
\integer{ yM=\yA+5}
\integer{ Ny=11}
\integer{ Nx=11}

\integer{d=random(0)}
\integer{s=random(-1,1)}
\integer{s2=random(-1,1)}
\integer{e=random(0,1)}
\real{k=random(0.25,0.5,1.5,2)}
\if{\d=0}{\real{k=random(0.2,0.4,1.5,3,5)}}
\if{\e=0}{
  \function{f2=maxima(expand(\k*\s*\a*(x-\b-\d)^2+\c))}
  \function{f3=maxima(expand(-\k*\s*\a*(x-\b+\d)^2+\c))}
  }
  {
  \function{f2=maxima(expand(\k*\s*\a*(x-\b+\d)^2+\c))}
  \function{f3=maxima(expand(-\k*\s*\a*(x-\b-\d)^2+\c))}
}


\text{dessin1=
animate 10,0.5,0
xrange \xm,\xM
yrange \ym,\yM
linewidth 1
parallel \xm,\ym,\xM,\ym,0,1,\Ny,grey
parallel \xm,\ym,\xm,\yM,1,0,\Nx,grey
linewidth 2
line \xm,0,\xM,0,blue
line 0,\ym,0,\yM,blue
line 1,-0.2,1,0.2, black
line -0.2,1,0.2,1, black
text black, 0.9,-0.25,medium, 1
text black, -0.5,1.25,medium, 1
text black, -0.5,-0.25,medium, "0"
point 0,0, black
hline 0,0, black
vline 0,0, black
plot red,\f
linewidth 5
}

\text{dessin2=
animate 10,0.5,0
xrange \xm,\xM
yrange \ym,\yM
linewidth 1
parallel \xm,\ym,\xM,\ym,0,1,\Ny,grey
parallel \xm,\ym,\xm,\yM,1,0,\Nx,grey
linewidth 2
line \xm,0,\xM,0,blue
line 0,\ym,0,\yM,blue
line 1,-0.2,1,0.2, black
line -0.2,1,0.2,1, black
text black, 0.9,-0.25,medium, 1
text black, -0.5,1.25,medium, 1
text black, -0.5,-0.25,medium, "0"
point 0,0, black
hline 0,0, black
vline 0,0, black
plot red,\f2
linewidth 5
}

\text{dessin3=
animate 10,0.5,0
xrange \xm,\xM
yrange \ym,\yM
linewidth 1
parallel \xm,\ym,\xM,\ym,0,1,\Ny,grey
parallel \xm,\ym,\xm,\yM,1,0,\Nx,grey
linewidth 2
line \xm,0,\xM,0,blue
line 0,\ym,0,\yM,blue
line 1,-0.2,1,0.2, black
line -0.2,1,0.2,1, black
text black, 0.9,-0.25,medium, 1
text black, -0.5,1.25,medium, 1
text black, -0.5,-0.25,medium, "0"
point 0,0, black
hline 0,0, black
vline 0,0, black
plot red,\f3
linewidth 5
}
\text{id=shuffle(3)}
\text{r=position(1,\id)}

\if{\id[1]=1}{\text{dessinA=\dessin1}}
\if{\id[1]=2}{\text{dessinA=\dessin2}}
\if{\id[1]=3}{\text{dessinA=\dessin3}}

\if{\id[2]=1}{\text{dessinB=\dessin1}}
\if{\id[2]=2}{\text{dessinB=\dessin2}}
\if{\id[2]=3}{\text{dessinB=\dessin3}}

\if{\id[3]=1}{\text{dessinC=\dessin1}}
\if{\id[3]=2}{\text{dessinC=\dessin2}}
\if{\id[3]=3}{\text{dessinC=\dessin3}}

\text{lst=Parabole 1,Parabole 2,Parabole 3}
\integer{num=\r}

\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{

<div class="enonce">
<p>La courbe représentative de la fonction \(f\) définie pour tout nombre \(x\) par \(f(x)=\f\) est :</p>
<table class="wimsborder" >
  <tr>
    <td>\draw{200,200}{\dessinA}</td>
    <td>\draw{200,200}{\dessinB}</td>
    <td>\draw{200,200}{\dessinC}</td>
  </tr>
  <tr>
    <td>Parabole 1</td>
    <td>Parabole 2</td>
    <td>Parabole 3</td>
  </tr>
</table>

<p>Cocher la bonne réponse :</p>
<ul class="wimscenter">
\for {u=1 to 3}{<li style="list-style-type:none;">\embed{r1,\u}</li>}
</ul>
</div>
}
\answer{}{\num;\lst}{type=radio}
