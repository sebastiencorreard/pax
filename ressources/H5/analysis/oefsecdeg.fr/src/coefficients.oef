\title{Coefficients d'une fonction du second degré}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\credits{}

\real{a = random(-1,1)*randint(1..30)/10}
\real{b = randint(-20..20)/10}
\real{c = randint(-20..20)/10}
\integer{e=random(0,1,2)}
\text{f = \e=0 ? \a*x^2+\b*x+\c}
\text{f = \e=1 ? \b*x+\c+\a*x^2}
\text{f = \e=2 ? \c + \b*x+\a*x^2}

\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{

<div class="enonce">
<p>L'équation de la parabole \(P\) d'équation \(y=\f\) &nbsp; a pour coefficients :</p>
<ul class="inline">
<li> \(a=\) \embed{reply1,6}</li>
<li> \(b=\) \embed{reply2,6}</li>
<li> \(c=\) \embed{reply3,6}</li>
</ul>
</div>
}

\answer{}{\a}{type=numeric}
\answer{}{\b}{type=numeric}
\answer{}{\c}{type=numeric}
