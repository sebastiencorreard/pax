\title{Trouver les coefficients à partir de f}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{ 10000}
\credits{}

\text{vl=5}
\text{v= wims(values x for x = -\vl to \vl) }
: on choisi a et on l'enlève de la liste
\integer{a=random(\v)}
\integer{va=abs(\a)}
\text{v= wims(replace \a by in \v)}
\text{v= wims(nonempty items \v)}
: idem pour b
\integer{b=random(\v)}
\integer{vb=abs(\b)}
\text{v= wims(replace \b by in \v)}
\text{v= wims(nonempty items \v)}

\integer{c=random(\v)}
\integer{vc=abs(\c)}

\function{f=\a*x^2+\b*x+\c}
\function{f=pari(\f)}

\text{coeff1=\a&#44;\b&#44;\c}
\integer{e=random(0,1,2,3)}
\if{\e=0}{\text{coeff2=\a&#44;\b&#44;\c}}
\if{\e=1}{\text{coeff2=\va&#44;\b&#44;\c}}
\if{\e=2}{\text{coeff2=\a&#44;\vb&#44;\vc}}
\if{\e=3}{\text{coeff2=\va&#44;\vb&#44;\vc}}
\integer{e=random(0,1,2,3)}
\if{\e=0}{\text{coeff3=\va&#44;\b&#44;\c}}
\if{\e=1}{\text{coeff3=\va&#44;\b&#44;\c}}
\if{\e=2}{\text{coeff3=\va&#44;\b&#44;\vc}}
\if{\e=3}{\text{coeff3=\va&#44;\vb&#44;\vc}}

\text{lst=\coeff1,\coeff2,\coeff3}
\integer{num=1}

\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{
<div class="enonce">
<p>Soit la fonction du second degré \(f\) telle que \(f(x)=\f\).</p>
<p>Alors, les coefficients \(a\), \(b\) et \(c\) sont (dans cet ordre) : </p>
<ul class="wims_nopuce">
\for {u=1 to 3}{<li>\embed{r1,\u}</li>}
</ul>
</div>
}
\answer{}{\num;\lst}{type=radio}{option=shuffle}
