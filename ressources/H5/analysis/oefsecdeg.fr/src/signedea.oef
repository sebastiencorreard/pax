\title{Signe du coefficient a}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\credits{}

\real{a=random(1,-1)*randitem(2,4,5,8,10,12)}
\real{d=randint(5..15)}
\real{xa=randint(-10..5)}
\real{xb=\xa+\d}
\function{f = simplify(\a*(x-\xa)*(x-\xb))}
\function{f=pari(\f)}
\real{x1=\xa-randint(1..4)}
\real{x3=\xb+randint(1..4)}
\real{x2=(\xa+\xb)/2}
\real{y1=evalue(\f,x=\x1)}
\real{y2=evalue(\f,x=\x2)}
\real{y3=evalue(\f,x=\x3)}

\function{df=diff(\f,x)}
\function{d2f=diff(\df,x)}
\real{a=\d2f/2}
\real{b=evalue(\df,x=0)}
\real{c=evalue(\f,x=0)}


\real{x0=-\b/(2*\a)}
\real{y0=evalue(\f,x=\x0)}

\text{lext=bas,haut,cela depend}
\text{ext= \a<0 ?haut:bas}
\text{pext=position(\ext,\lext)}

\text{lext2=positif,negatif,ça depend}
\text{ext2= \a>0 ?positif:negatif}
\text{pext2=position(\ext2,\lext2)}


\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{

<div class="enonce">
<p>Le sommet \(S\) de la parabole \(P\) d'équation \(y=\f\) &nbsp; a pour
coordonnées ( \x0 ; \y0)</p>
<div>Le sommet est le point le plus \embed{reply1} car \(a\) est un nombre \embed{reply2}.</div>
</div>
}

\answer{}{\pext;\lext}{type=menu}{option=shuffle}
\answer{}{\pext2;\lext2}{type=menu}{option=shuffle}
