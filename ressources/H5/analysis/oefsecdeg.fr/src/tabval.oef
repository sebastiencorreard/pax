\title{Tableau de valeurs}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\credits{}
\precision{100}

\real{a = random(-1,1)*randint(1..30)/10}
\real{b = random(-1,1)*randint(1..20)/10}
\real{c = randint(-20..20)/10}
\integer{e=random(0,1)}
\function{f = \e=0 ? \a*x^2+simplify(\b*x+\c) : simplify(\b*x+\c)+\a*x^2}
\function{f=pari(\f)}
\integer{n=randint(3..5)}

\real{id = random(-1,1)*randint(1..15)}
\real{delta = randint(1..5)}

\text{tx0=}
\text{ty0=}
\for {i=0 to \n-1}{
  \real{x0=\id+\i*\delta}
  \real{y0=evalue(\f,x=\x0)}
  \text{tx0=\tx0,\x0}
  \text{ty0=\ty0,\y0}
}
\text{tx0=wims(nonempty items \tx0)}
\text{ty0=wims(nonempty items \ty0)}

\text{mopt=shuffle(RUN,GRAPH,TABLE,EQUA,STAT)}
\text{nopt=position(TABLE,\mopt)}

\text{mopt2=shuffle(SEL,DEL,TYPE,STVL,SET,TABL)}
\text{nopt2=position(SET,\mopt2)}

\text{end=\id+(\n-1)*\delta}

\text{ETAPE=wims(makelist r x for x=1 to \n),r6,r7,r8,r9,r10}

\steps{\ETAPE}

\css{
<style type="text/css">
div.tabval.enonce{
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
table.tabval {
    border: 1px solid black;
    margin: auto;}
td.tabval {
text-align :center;}
</style>}

\statement{
<div class="tabval.enonce">
<p>Une parabole \(P\) a pour équation \(y=\f\).

<p><strong>Compléter le tableau de valeurs correspondantes :</strong></p>
<table class="tabval">
	<tr>
	  <th>\(x\)</th>
	  \for{u=1 to \n}{<td class="tabval"><strong>\tx0[\u]</strong></td>}
	</tr>
	<tr>
	  <th>\(f(x)\)</th>
          \for{u=1 to \n}{<td class="tabval">\embed{r \ETAPE[\u],4}</td>}
	</tr>
</table>

<div><strong>Dans le menu \embed{r \ETAPE[\n+1]} de la calculatrice (Casio),
vous avez choisi l'option \embed{r \ETAPE[\n+2]}</strong></div>
<p><strong>puis</strong></p>
<table class="tabval">
	<tr>
	  <th>Start :</th><td class="tabval">\embed{r \ETAPE[\n+3],4}</td>
	</tr>
	<tr>
	  <th>End :</th><td class="tabval">\embed{r \ETAPE[\n+4],4}</td>
	</tr>
	<tr>
	  <th>Step :</th><td class="tabval">\embed{r \ETAPE[\n+5],4}</td>
	</tr>
</table>
</div>
}

\answer{}{\ty0[1]}{type=numeric}
\answer{}{\ty0[2]}{type=numeric}
\answer{}{\ty0[3]}{type=numeric}
\answer{}{\ty0[4]}{type=numeric}
\answer{}{\ty0[5]}{type=numeric}
\answer{}{\nopt;\mopt}{type=menu}
\answer{}{\nopt2;\mopt2}{type=menu}
\answer{}{\id}{type=numeric}
\answer{}{\end}{type=numeric}
\answer{}{\delta}{type=numeric}
