\title{Tableau de variation}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\range(100)
\credits{}

\real{a=random(1,-1)*random(2,4,5,8,10,12)}
\real{d=randint(5..15)}
\real{xa=randint(-10..5)}
\real{xb=\xa+\d}
\function{f = simplify(\a*(x-\xa)*(x-\xb))}
\function{f=pari(\f)}
\real{x1=\xa-randint(1..4)}
\real{x3=\xb+randint(1..4)}
\real{x2=(\xa+\xb)/2}
\real{y1=evalue(\f,x=\x1)}
\real{y2=evalue(\f,x=\x2)}
\real{y3=evalue(\f,x=\x3)}

\function{df=diff(\f,x)}
\function{d2f=diff(\df,x)}
\real{a=\d2f/2}
\real{b=evalue(\df,x=0)}
\real{c=evalue(\f,x=0)}

\text{lint=oui,non,autre}
\text{int= \x2>\x1 and \x2<\x3 ?oui:non}
\text{pint=position(\int,\lint)}

\text{lext2=positif,negatif,ça depend}
\text{ext2= \a>0 ?positif:negatif}
\text{pext2=position(\ext2,\lext2)}

\text{lext4=croissante,décroissante,ça depend}
\text{ext4= \a>0 ?décroissante:croissante}
\text{pext4=position(\ext4,\lext4)}

\text{lext5=croissante,décroissante,ça depend}
\text{ext5= \a>0 ?croissante:décroissante}
\text{pext5=position(\ext5,\lext5)}

\text{fh=&#8599;}
\text{fb=&#8600;}

\text{lext6=\fh,\fb,ça depend}
\text{ext6= \a>0 ?\fb:\fh}
\text{pext6=position(\ext6,\lext6)}

\text{lext7=\fh,\fb,ça depend}
\text{ext7= \a>0 ?\fh:\fb}
\text{pext7=position(\ext7,\lext7)}


\css{
<style type="text/css">
div.tabvar.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
table.tabvar.table1 {
    border-collapse: collapse;
    border: 1px solid black;
    margin: auto;}
td.tabvar.left {
   text-align :left;}
td.tabvar.center{
   text-align :center;}
td.tabvar.right{
   text-align :right;}
</style>
}

\statement{
<div class="enonce">
<p>Soit la fonction \(f\) définie par \(f(x)=\f\) sur l'intervalle &#91; \x1&#44; \x3 &#93;. Etablir le tableau de variation de la fonction \(f\).</p>
<ol>
<li>Repérer les coefficients \(a\) et \(b\) : \(a\) = \embed{r1,4}, \(b\) = \embed{r2,4}</li>
<li>Calculer le nombre \(-b/(2*a)\) = \embed{r3,4}.
  Appartient-il à l'intervalle &#91; \x1&#44; \x3 &#93; ?
  \embed{r4}.
  </li>
	<li>Calculer son image \(f (-b/(2*a))\) =\embed{r5,4}.
	</li>
  <li>
    Donner le signe du coefficient \(a\) : \embed{r6,4}.
  </li>
  <li>En déduire le sens de variation de \(f\) :
    <ul class="wims_nopuce">
      <li> \(f\) est \embed{r7} sur l'intervalle &#91; \embed{r8,4} &#44; \embed{r9,4} &#93;</li>
      <li> \(f\) est \embed{r10} sur l'intervalle &#91; \embed{r11,4} &#44; \embed{r12,4} &#93;</li>
    </ul>
  </li>
  <li>Calculer les images des bornes de l'intervalle de définition :
  \(f(\x1)=\) \embed{r13,4} et \(f(\x3)=\) \embed{r14,4}</li>
  <li>Établir le tableau de variation :

<table class="tabvar.table1">
  <tbody>
    <tr>
      <th>\(x\)</th>
      <td>\embed{r15,15} \embed{r16,15} \embed{r17,15} </td>
    </tr>
    <tr>
      <th>\(f(x)\)</th>
      <td>\embed{r18,4} \embed{r19} \embed{r20,4} \embed{r21} \embed{r22,4}</td>
    </tr>
  </tbody>
</table>
</li>
</ol>
</div>
}

\answer{}{\a}{type=numeric}
\answer{}{\b}{type=numeric}
\answer{}{\x2}{type=numeric}
\answer{}{\pint;\lint}{type=menu}{option=shuffle}
\answer{}{\y2}{type=numeric}
\answer{}{\pext2;\lext2}{type=menu}{option=shuffle}
\answer{}{\pext4;\lext4}{type=menu}{option=shuffle}
\answer{}{\x1}{type=numeric}
\answer{}{\x2}{type=numeric}
\answer{}{\pext5;\lext5}{type=menu}{option=shuffle}
\answer{}{\x2}{type=numeric}
\answer{}{\x3}{type=numeric}
\answer{}{\y1}{type=numeric}
\answer{}{\y3}{type=numeric}

\answer{}{\x1}{type=numeric}
\answer{}{\x2}{type=numeric}
\answer{}{\x3}{type=numeric}
\answer{}{\y1}{type=numeric}
\answer{}{\pext6;\lext6}{type=menu}{option=shuffle}
\answer{}{\y2}{type=numeric}
\answer{}{\pext7;\lext7}{type=menu}{option=shuffle}
\answer{}{\y3}{type=numeric}
