\title{Trouver f à partir des coefficients}
\author{Eric, Guillet}
\email{mathextra@free.fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{ 10000}
\credits{}

\text{vl=5}
\text{v= wims(values x for x = -\vl to \vl) }
: on choisi a et on l'enlève de la liste
\integer{a=random(\v)}
\integer{va=abs(\a)}
\text{v= wims(replace \a by in \v)}
\text{v= wims(nonempty items \v)}
: idem pour b
\integer{b=random(\v)}
\integer{vb=abs(\b)}
\text{v= wims(replace \b by in \v)}
\text{v= wims(nonempty items \v)}

\integer{c=random(\v)}
\integer{vc=abs(\c)}

\if{abs(\a)=abs(\b) and abs(\b)=abs(\c)}{\integer{b=\b+1}}
\function{f1=\a*x^2+\b*x+\c}
\integer{e=random(0,1,2,3)}
\if{\e=0}{\function{f2=\b*x^2+\c*x+\a}}
\if{\e=1}{\function{f2=\vb*x^2+\c*x+\a}}
\if{\e=2}{\function{f2=\vb*x^2+\vc*x+\a}}
\if{\e=3}{\function{f2=\b*x^2+\vc*x+\va}}
\integer{e=random(0,1,2,3)}
\if{\e=0}{\function{f3=\c*x^2+\a*x+\b}}
\if{\e=1}{\function{f3=\vc*x^2+\a*x+\b}}
\if{\e=2}{\function{f3=\vc*x^2+\a*x+\vb}}
\if{\e=3}{\function{f3=\vc*x^2+\va*x+\vb}}


\text{lst=\(\f1),\(\f2),\(\f3)}
\integer{num=1}

\css{
<style type="text/css">
div.enonce {
  background-color: #EEEEFF;
  color: black;
  line-height: 20px;}
</style>
}

\statement{
<div class="enonce">
<p>On donne les coefficients \(a=\a\), \(b=\b\), \(c=\c\).</p>
<p>Alors la fonction du second degré telle que
\(x \mapsto a x^2+b x+c \quad (a \ne 0)\) s'écrit :</p>
<ul class="wims_nopuce">
\for {u=1 to 3}{<li>\embed{r1,\u}</li>}
</ul>
</div>
}
\answer{}{\num;\lst}{type=radio}{option=shuffle}
