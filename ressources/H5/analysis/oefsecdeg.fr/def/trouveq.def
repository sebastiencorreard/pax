!set title=Trouver f à partir des coefficients
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=5
tmp0=!values x for x = -$val6 to $val6

val7=$(tmp0) 
tmp0=!randint $val7

val8=$[rint($(tmp0))]
val9=$[rint(abs($val8))]
tmp0=!replace $val8 by in $val7

val7=$(tmp0)
tmp0=!nonempty items $val7

val7=$(tmp0)
tmp0=!randint $val7

val10=$[rint($(tmp0))]
val11=$[rint(abs($val10))]
tmp0=!replace $val10 by in $val7

val7=$(tmp0)
tmp0=!nonempty items $val7

val7=$(tmp0)
tmp0=!randint $val7

val12=$[rint($(tmp0))]
val13=$[rint(abs($val12))]
!if abs($val8)=abs($val10) and abs($val10)=abs($val12) 
val10=$[rint($val10+1)]
!endif
val14=!rawmath $val8*x^2+$val10*x+$val12
tmp0=!randitem 0,1,2,3

val15=$[rint($(tmp0))]
!if $val15=0 
val16=!rawmath $val10*x^2+$val12*x+$val8
!endif
!if $val15=1 
val16=!rawmath $val11*x^2+$val12*x+$val8
!endif
!if $val15=2 
val16=!rawmath $val11*x^2+$val13*x+$val8
!endif
!if $val15=3 
val16=!rawmath $val10*x^2+$val13*x+$val9
!endif
tmp0=!randitem 0,1,2,3

val15=$[rint($(tmp0))]
!if $val15=0 
val17=!rawmath $val12*x^2+$val8*x+$val10
!endif
!if $val15=1 
val17=!rawmath $val13*x^2+$val8*x+$val10
!endif
!if $val15=2 
val17=!rawmath $val13*x^2+$val8*x+$val11
!endif
!if $val15=3 
val17=!rawmath $val13*x^2+$val9*x+$val11
!endif
val18=\($val14),\($val16),\($val17)
val19=$[rint(1)]
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val19;$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	<p>On donne les coefficients 
!insmath a=$val8
$(), 
!insmath b=$val10
$(), 
!insmath c=$val12
$().</p>	<p>Alors la fonction du second degré telle que	
!insmath x \mapsto a x^2+b x+c \quad (a \ne 0)
$() s'écrit :</p>	<ul class="wims_nopuce">	 
!for m_u=1 to 3 
$()<li> 
!read oef/embed.phtml r1,\u 
$()</li> 
!next
$()	</ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,12
embedcnt=1
