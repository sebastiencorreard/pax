!set title=Coefficients d'une fonction du second degré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
tmp0=!randitem -1,1

tmp1=!randint 1, 30

val6=$[$(tmp0)*$(tmp1)/10]
tmp0=!randint -20, 20

val7=$[$(tmp0)/10]
tmp0=!randint -20, 20

val8=$[$(tmp0)/10]
tmp0=!randitem 0,1,2

val9=$[rint($(tmp0))]

!ifval $val9=0 
val10= $val6*x^2+$val7*x+$val8
!endif

!ifval $val9=1 
val10= $val7*x+$val8+$val6*x^2
!endif

!ifval $val9=2 
val10= $val8 + $val7*x+$val6*x^2
!endif
replytype1=numeric
replyname1=
replygood1=$[$val6]
replytype2=numeric
replyname2=
replygood2=$[$val7]
replytype3=numeric
replyname3=
replygood3=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="enonce">	<p>L'équation de la parabole 
!insmath P
$() d'équation 
!insmath y=$val10
$() &nbsp; a pour coefficients :</p>	<ul class="inline">	<li> 
!insmath a=
$()  
!read oef/embed.phtml reply1,6 
$()</li>	<li> 
!insmath b=
$()  
!read oef/embed.phtml reply2,6 
$()</li>	<li> 
!insmath c=
$()  
!read oef/embed.phtml reply3,6 
$()</li>	</ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=3
