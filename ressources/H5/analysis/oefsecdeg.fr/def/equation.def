!set title=Correspondance fonction &lt;-&gt; équation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(6)]
val7=$[rint(50)]
val8=$[rint(250)]
val9=$[rint(250)]
tmp=!trim 
val10=!translate internal $	\
$ to ;; in $tmp
!for val11 =1 to 14 
tmp0=!randitem -1,1

tmp1=!randint 1, 30

val12=$[$(tmp0)*$(tmp1)/10]
tmp0=!randint -20, 20

val13=$[$(tmp0)/10]
tmp0=!randint -20, 20

val14=$[$(tmp0)/10]
tmp0=!randitem 0,1

val13=$[rint($(tmp0))]

!ifval $val13=0 
tmp=!translate ";': to $     $ in $val13*x+$val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=!rawmath  $val12*x^2+$(tmp0) 
!else
tmp=!translate ";': to $     $ in $val13*x+$val14

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val15=!rawmath  $(tmp1)+$val12*x^2
!endif
tmp=!trim $val10	  \(f(x)=$val15\),\(y=$val15\)
val10=!translate internal $	\
$ to ;; in $tmp
!next
val16=On donne les fonctions du second degré \(f\) , \(g\) , \(h\) , \(i\) , \(j\) et \(k\) définies, pour tout nombre \(x\).	Pour chacune de ces fonctions, donner l'équation de la parabole qui la représente :
tmp0=!item 1 of 1 oui, 2 non

val17=$(tmp0)
tmp0=!word 1 of $val17

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
val18=$[rint($(tmp0))]

!ifval $val6>$val18
val6=$[rint($val18)]
!endif
tmp0=!shuffle $val18

tmp1=!item 1 to $val6 of $(tmp0)

val19=$(tmp1)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val19 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)

!ifval $val17=1
tmp0=!embraced randitem $val10

val10= $(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val10

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
val21=f,g,h,i,j,k
tmp0=!itemcnt $val20

val22=$[rint($(tmp0))]
val23=
!for val11 =1 to $val22 
val24=$(val20[$val11])
tmp0=!replace internal f by $(val21[$val11]) in $val24

val24=$(tmp0)
val23=$val23,$val24
!next
tmp0=!nonempty items $val23

val23=$(tmp0)
val20=$val23
tmp=!translate internal $	$ to ; in $val10

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val25=$(tmp0)
val26=$(val7[])x$(val8[])x$val9

!ifval $val17=1
tmp0=!embraced randitem $val16

val16= $(tmp0)
!endif
replytype1=correspond
replyname1=La réponse
replygood1=$val20;$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val16		<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val26 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,26
embedcnt=1
