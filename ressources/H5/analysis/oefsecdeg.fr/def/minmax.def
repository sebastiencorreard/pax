!set title=Minimum ou maximum
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r,r,r,r,r,r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
tmp0=!randitem -1,1

tmp1=!randint 1, 30

val6=$[$(tmp0)*$(tmp1)]
tmp0=!randint -20, 20

val7=$[$(tmp0)]
tmp0=!randint -20, 20

val8=$[$(tmp0)]
tmp0=!randitem 0,1

val9=$[rint($(tmp0))]

!ifval $val9=0 
val10= $val6*x^2+$val7*x+$val8 
!else
val10= $val7*x+$val8+$val6*x^2
!endif
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val10=!rawmath $(tmp0)
val11=$[-$val7/(2*$val6)]
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
val13=premier,second,troisième,autre

!ifval $val6<>0 
val14=second
!else
val14=autre
!endif
tmp0=!positionof item $val14 in $val13

val15=$(tmp0)
val16=positif,negatif,ça depend

!ifval $val6>0 
val17=positif
!else
val17=negatif
!endif
tmp0=!positionof item $val17 in $val16

val18=$(tmp0)
val19=minimum,maximum,ça depend

!ifval $val6>0 
val20=minimum
!else
val20=maximum
!endif
tmp0=!positionof item $val20 in $val19

val21=$(tmp0)
replytype1=menu
replyoption1=shuffle 
replyname1=
replygood1=$val15;$val13
replyname2=
replygood2=$val6
replytype3=menu
replyoption3=shuffle 
replyname3=
replygood3=$val18;$val16
replytype4=menu
replyoption4=shuffle 
replyname4=
replygood4=$val21;$val19
replytype5=numeric
replyname5=
replygood5=$[$val11]
replytype6=numeric
replyname6=
replygood6=$[$val12]
replytype7=menu
replyoption7=shuffle 
replyname7=
replygood7=$val21;$val19
replytype8=numeric
replyname8=
replygood8=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="enonce">	<div>Soit la fonction 
!insmath f
$() définie pour tout 
!insmath x
$() par 
!insmath f(x)=$val10
$().	Déterminer le minimum ou le maximum de 
!insmath f
$().</div>	<div>
!insmath f
$() est une fonction du  
!read oef/embed.phtml reply1 
$() degré. Le coefficient 
!insmath a
$() de 
!insmath x^2
$() est égal à  
!read oef/embed.phtml reply2,4 
$(). Son signe est  
!read oef/embed.phtml reply3 
$().</div>	<div>La fonction 
!insmath f
$() admet donc un  
!read oef/embed.phtml reply4 
$() :</div>	<table class="wimscenter">	 <tr>	   <th>
!insmath -b/(2*a)
$() = </th><td> 
!read oef/embed.phtml reply5,4 
$()</td>	 </tr>	 <tr>	   <th>
!insmath f(-b/(2*a))
$() = </th><td> 
!read oef/embed.phtml reply6,4 
$()</td>	 </tr>	</table>	Le  
!read oef/embed.phtml reply7 
$() de la fonction 
!insmath f
$() est égal à  
!read oef/embed.phtml reply8 
$().	</div>		
$()
!exit

