!set title=Tableau de valeurs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
precision=100
oefcss= <style type="text/css"> div.tabval.enonce{ background-color: #EEEEFF; color: black; line-height: 20px;} table.tabval { border: 1px solid black; margin: auto;} td.tabval { text-align :center;} </style>

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
tmp0=!randitem -1,1

tmp1=!randint 1, 30

val6=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 1, 20

val7=$[$(tmp0)*$(tmp1)/10]
tmp0=!randint -20, 20

val8=$[$(tmp0)/10]
tmp0=!randitem 0,1

val9=$[rint($(tmp0))]

!ifval $val9=0 
tmp=!translate ";': to $     $ in $val7*x+$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath  $val6*x^2+$(tmp0) 
!else
tmp=!translate ";': to $     $ in $val7*x+$val8

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val10=!rawmath  $(tmp1)+$val6*x^2
!endif
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val10=!rawmath $(tmp0)
tmp0=!randint 3, 5

val11=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 15

val12=$[$(tmp0)*$(tmp1)]
tmp0=!randint 1, 5

val13=$[$(tmp0)]
val14=
val15=
!for val16 =0 to $val11-1 
val17=$[$val12+$val16*$val13]
evaltmp=$val10

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
val14=$val14,$val17
val15=$val15,$val18
!next
tmp0=!nonempty items $val14

val14=$(tmp0)
tmp0=!nonempty items $val15

val15=$(tmp0)
tmp0=!shuffle RUN,GRAPH,TABLE,EQUA,STAT

val19=$(tmp0)
tmp0=!positionof item TABLE in $val19

val20=$(tmp0)
tmp0=!shuffle SEL,DEL,TYPE,STVL,SET,TABL

val21=$(tmp0)
tmp0=!positionof item SET in $val21

val22=$(tmp0)
val23=$val12+($val11-1)*$val13
tmp0=!makelist r x for x=1 to $val11

val24=$(tmp0),r6,r7,r8,r9,r10
oefsteps=$val24 
nextstep=!nosubst $val24 
!readproc oef/steps.proc
replytype1=numeric
replyname1=
replygood1=$[$(val15[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val15[2])]
replytype3=numeric
replyname3=
replygood3=$[$(val15[3])]
replytype4=numeric
replyname4=
replygood4=$[$(val15[4])]
replytype5=numeric
replyname5=
replygood5=$[$(val15[5])]
replytype6=menu
replyname6=
replygood6=$val20;$val19
replytype7=menu
replyname7=
replygood7=$val22;$val21
replytype8=numeric
replyname8=
replygood8=$[$val12]
replytype9=numeric
replyname9=
replygood9=$[$val23]
replytype10=numeric
replyname10=
replygood10=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="tabval.enonce">	<p>Une parabole 
!insmath P
$() a pour équation 
!insmath y=$val10
$().		<p><strong>Compléter le tableau de valeurs correspondantes :</strong></p>	<table class="tabval">	 <tr>	   <th>
!insmath x
$()</th>	    
!for m_u=1 to $val11 
$()<td class="tabval"><strong>$(val14[$m_u])</strong></td> 
!next
$()	 </tr>	 <tr>	   <th>
!insmath f(x)
$()</th>	           
!for m_u=1 to $val11 
$()<td class="tabval"> 
!read oef/embed.phtml r $(val24[$m_u]),4 
$()</td> 
!next
$()	 </tr>	</table>		<div><strong>Dans le menu  
!read oef/embed.phtml r $(val24[$val11+1]) 
$() de la calculatrice (Casio),	vous avez choisi l'option  
!read oef/embed.phtml r $(val24[$val11+2]) 
$()</strong></div>	<p><strong>puis</strong></p>	<table class="tabval">	 <tr>	   <th>Start :</th><td class="tabval"> 
!read oef/embed.phtml r $(val24[$val11+3]),4 
$()</td>	 </tr>	 <tr>	   <th>End :</th><td class="tabval"> 
!read oef/embed.phtml r $(val24[$val11+4]),4 
$()</td>	 </tr>	 <tr>	   <th>Step :</th><td class="tabval"> 
!read oef/embed.phtml r $(val24[$val11+5]),4 
$()</td>	 </tr>	</table>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,14,24
embedcnt=6
