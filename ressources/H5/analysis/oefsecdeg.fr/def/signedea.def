!set title=Signe du coefficient a
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
tmp0=!randitem 1,-1

tmp=!nonempty items 2,4,5,8,10,12

tmp1=!randitem $tmp
val6=$[$(tmp0)*$(tmp1)]
tmp0=!randint 5, 15

val7=$[$(tmp0)]
tmp0=!randint -10, 5

val8=$[$(tmp0)]
val9=$[$val8+$val7]
tmp=!translate ";': to $     $ in $val6*(x-$val8)*(x-$val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val10=!rawmath $(tmp0)
tmp0=!randint 1, 4

val11=$[$val8-$(tmp0)]
tmp0=!randint 1, 4

val12=$[$val9+$(tmp0)]
val13=$[($val8+$val9)/2]
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=($val13) in $evaltmp
tmp0=($evaltmp)
val15=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val16=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val17,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
val6=$[$val18/2]
evaltmp=$val17

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val19=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val20=$[$(tmp0)]
val21=$[-$val19/(2*$val6)]
evaltmp=$val10

evaltmp=!mathsubst x=($val21) in $evaltmp
tmp0=($evaltmp)
val22=$[$(tmp0)]
val23=bas,haut,cela depend

!ifval $val6<0 
val24=haut
!else
val24=bas
!endif
tmp0=!positionof item $val24 in $val23

val25=$(tmp0)
val26=positif,negatif,ça depend

!ifval $val6>0 
val27=positif
!else
val27=negatif
!endif
tmp0=!positionof item $val27 in $val26

val28=$(tmp0)
replytype1=menu
replyoption1=shuffle 
replyname1=
replygood1=$val25;$val23
replytype2=menu
replyoption2=shuffle 
replyname2=
replygood2=$val28;$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="enonce">	<p>Le sommet 
!insmath S
$() de la parabole 
!insmath P
$() d'équation 
!insmath y=$val10
$() &nbsp; a pour	coordonnées ( $val21 ; $val22)</p>	<div>Le sommet est le point le plus  
!read oef/embed.phtml reply1 
$() car 
!insmath a
$() est un nombre  
!read oef/embed.phtml reply2 
$().</div>	</div>	
$()
!exit

