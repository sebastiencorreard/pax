!set title=Trouver les coefficients à partir de f
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=5
tmp0=!values x for x = -$val6 to $val6

val7=$(tmp0) 
tmp0=!randint $val7

val8=$[rint($(tmp0))]
val9=$[rint(abs($val8))]
tmp0=!replace $val8 by in $val7

val7=$(tmp0)
tmp0=!nonempty items $val7

val7=$(tmp0)
tmp0=!randint $val7

val10=$[rint($(tmp0))]
val11=$[rint(abs($val10))]
tmp0=!replace $val10 by in $val7

val7=$(tmp0)
tmp0=!nonempty items $val7

val7=$(tmp0)
tmp0=!randint $val7

val12=$[rint($(tmp0))]
val13=$[rint(abs($val12))]
val14=!rawmath $val8*x^2+$val10*x+$val12
t_=!replace internal \( by ( in $val14
tmp0=!exec pari $t_

val14=!rawmath $(tmp0)
val15=$val8&#44;$val10&#44;$val12
tmp0=!randitem 0,1,2,3

val16=$[rint($(tmp0))]
!if $val16=0 
val17=$val8&#44;$val10&#44;$val12
!endif
!if $val16=1 
val17=$val9&#44;$val10&#44;$val12
!endif
!if $val16=2 
val17=$val8&#44;$val11&#44;$val13
!endif
!if $val16=3 
val17=$val9&#44;$val11&#44;$val13
!endif
tmp0=!randitem 0,1,2,3

val16=$[rint($(tmp0))]
!if $val16=0 
val18=$val9&#44;$val10&#44;$val12
!endif
!if $val16=1 
val18=$val9&#44;$val10&#44;$val12
!endif
!if $val16=2 
val18=$val9&#44;$val10&#44;$val13
!endif
!if $val16=3 
val18=$val9&#44;$val11&#44;$val13
!endif
val19=$val15,$val17,$val18
val20=$[rint(1)]
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val20;$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	<p>Soit la fonction du second degré 
!insmath f
$() telle que 
!insmath f(x)=$val14
$().</p>	<p>Alors, les coefficients 
!insmath a
$(), 
!insmath b
$() et 
!insmath c
$() sont (dans cet ordre) : </p>	<ul class="wims_nopuce">	 
!for m_u=1 to 3 
$()<li> 
!read oef/embed.phtml r1,\u 
$()</li> 
!next
$()	</ul>	</div>	
$()
!exit

