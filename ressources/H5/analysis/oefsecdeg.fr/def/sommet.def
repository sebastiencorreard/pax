!set title=Coordonnées du sommet d'une parabole
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Guillet
email=mathextra@free.fr
precision=100
oefcss= <style type="text/css"> div.enonce { background-color: #EEEEFF; color: black; line-height: 20px;} </style> 

ansorder=r,r,r,r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
tmp0=!randitem 1,-1

tmp1=!randitem 2,4,5,8,10,12

val6=$[$(tmp0)*$(tmp1)]
tmp0=!randint 5, 15

val7=$[$(tmp0)]
tmp0=!randint -10, 5

val8=$[$(tmp0)]
val9=$[$val8+$val7]
tmp=!translate ";': to $     $ in $val6*(x-$val8)*(x-$val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val10=!rawmath $(tmp0)
tmp0=!randint 1, 4

val11=$[$val8-$(tmp0)]
tmp0=!randint 1, 4

val12=$[$val9+$(tmp0)]
val13=$[($val8+$val9)/2]
evaltmp=$val10

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=($val13) in $evaltmp
tmp0=($evaltmp)
val15=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val16=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val17,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
val6=$[$val18/2]
evaltmp=$val17

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val19=$[$(tmp0)]
evaltmp=$val10

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val20=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val6*x^2+$val19*x+$val20

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val10=!rawmath $(tmp0)
val21=$[-$val19/(2*$val6)]
evaltmp=$val10

evaltmp=!mathsubst x=($val21) in $evaltmp
tmp0=($evaltmp)
val22=$[$(tmp0)]
replytype1=numeric
replyname1=
replygood1=$[$val21]
replytype2=numeric
replyname2=
replygood2=$[$val22]
replytype3=numeric
replyname3=
replygood3=$[$val6]
replytype4=numeric
replyname4=
replygood4=$[$val19]
replytype5=numeric
replyname5=
replygood5=$[$val21]
replytype6=numeric
replyname6=
replygood6=$[$val22]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	<p>Soit la parabole 
!insmath P
$() d'équation 
!insmath y=$val10
$().</p>	<div>Quels sont les coefficients 
!insmath a
$() et 
!insmath b
$() :	<ul class="inline">	<li> 
!insmath a=
$()  
!read oef/embed.phtml r3,4 
$()</li>	<li> 
!insmath b=
$()  
!read oef/embed.phtml r4,4 
$()</li>	</ul>	</div>	Calculer :	<ul class="inline">	 <li>
!insmath -b/(2*a)
$() =  
!read oef/embed.phtml r5,4 
$()	 </li><li>	  
!insmath f(-b/(2*a))
$() =  
!read oef/embed.phtml r6,4 
$()	</li>	</ul>	<div>Le sommet 
!insmath S
$() de la parabole 
!insmath P
$() &nbsp; a pour coordonnées 
!insmath S
$()	(  
!read oef/embed.phtml r1,6 
$() ,  
!read oef/embed.phtml r2,6 
$())</div>	</div>	
$()
