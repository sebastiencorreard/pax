\title{Le prix Hors Taxe}
\author{Rémi,Belloeil} inspiré d'un exercice de Régine Mangeard
\email{remi.belloeil@orange.fr}
\format{html}
\precision{100}

\integer{av=randint(1000..3000)}
\integer{t=randint(10..50)}
\rational{cm=1+\t/100}
\rational{nv=\av*\cm}
\integer{nv=\nv}

\text{tsol= Puisqu'il s'agit d'une augmentation, on utilise la formule:
  \(HT = \frac{TTC}{1 + \frac{p}{100}})}

\statement{
<p>
Le prix TTC d'un objet est \nv euros, sachant que la Taxe est de \t % sur le prix Hors Taxe,
</p>
<label for="reply1">Quel était son prix Hors Taxe ?</label>

<div class="wimscenter">\embed{reply1} euros.</div>
<div class="wims_instruction">Arrondir à l'euro</div>
}
\answer{av}{\av}{type=numeric}

\solution{\tsol}
