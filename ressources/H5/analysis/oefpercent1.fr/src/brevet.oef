\integer{t2=70}
\integer{t3=90}
\integer{ar=\a*\t1/100}
\integer{br=\b*\t2/100}
\integer{cr=\c*\t3/100}
\integer{g=\a+\b+\c}
\integer{gr=\ar+\br+\cr}
\real{tgd=\gr/\g}
\real{tg=100*\tgd}
\integer{tga=round(\tg)}
\real{tg1=\tg-1}
\real{tg2=\tg+1}
