\title{Calculer un pourcentage d'une quantité}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

## choix du pourcentage et de la quantité numérique
\integer{p=randint(2..99)}
\integer{x=randint(101..199)}


\real{y= 0.01*\p*\x}

%%% la liste des objets que l'on peut cliquer pour résoudre l'exercice %%%
\text{s1=\(\times)} %% signe multiplié
\text{s2=&#47} %% signe divisé
\text{s3=&#0151} %% signe moins
\text{s4=&#43} %% signe plus
\text{s5=\(p)}
\text{s6=100}

\text{t1=\x,\s1,\p,\s2,\s6}
\text{t2=\x,\s2,\s6,\s1,\p}
\text{t3=\s1,\s5,\s2,\s6}
\text{t4=\s2,\s6,\s1,\s5}

\function{f=0.01*\p*x}

\text{ListOp=shuffle(\s1,\s2,\s3,\s4,\s5,\s6)}


\text{tab3=<table class="wimsborder wimscenter">
<caption>Tableau de proportionnalité</caption>
  <tr>
  <td>&#63;&#63;&#63;</td><td>\(p)</td>
 </tr>
  <tr>
  <td>\(x)</td><td>100</td>
 </tr>
</table>}
\text{tab2= wims(replace internal \(p) by \p in \tab3)}
\text{tab1= wims(replace internal \(x) by \x in \tab2)}

\steps{reply1
reply2
reply3}

####### enoncé de l'exo #######

\statement{
  \if{\step=1}{
  <label for="reply1">Que vaut \p % de \x ?</label> \embed{reply1,\size} (valeur exacte).
  \tab1
  }
  \if{\step=2}{<label for="reply2">Quelle formule permet de calculer \p % de \(x) </label>?
  \embed{reply2,7}
\tab2
}
  \if{\step=3}{Comment calculer \(p) % de \(x) ?<div class="wimscenter">
  \(x) \embed{reply3,50x30x4}
  </div>
  \tab3
}

}
###indication###
\hint{
\if{\step=1}{
  Utiliser le tableau de proportionnalité pour trouver l'opération.
}
\if{\step=2}{
Écrire le calcul à effectuer avec \(x).
<div class="wims_instruction">Noter * pour multiplier et \s2 pour diviser.</div>
}
\if{\step=3}{
Prendre les opérations ou nombres en bas et les placer pour écrire
la réponse en calculant à partir de \(x).<div class="wimscenter">
\ListOp
</div>
}
}
#### Réponses ####
\answer{\p % de \x }{\y}{type=numeric}
\answer{\p % de \(x)}{\f}{type=function}
\answer{\(p) % de \(x)}{\t3|\t4;\ListOp}{type=dragfill}

\solution{
Pourcentage proportion
<div class="wimscenter">
\(\large{ x\; \overset{\phantom{xxxx}p\%\phantom{xxxx}}{\underset{\times p/100}{\mapsto}}\;
y})</div>>
Pour calculer \(p) % de \(x), on multiplie \(x) par \(p) /100.
}
