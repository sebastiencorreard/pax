\title{Déterminer la référence d'un pourcentage}
\language{fr}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% choix du pourcentage et dela quantité numérique
\integer{p=5*randint(1..19)}
\integer{x=2*randint(26..99)}

\real{y= 0.01*\p*\x}

%%% la liste des objets que l'on peut cliquer pour résoudre l'exercice %%%
\text{s1=\(\times)} ## signe multiplié
\text{s2=&#47} ## signe divisé
\text{s3=&#0151} ## signe moins
\text{s4=&#43} ## signe plus
\text{s5=\(p)}
\text{s6=100}
\text{s7=\(y)}

\text{t1=\s7,\s2,\s5,\s1,\s6}
\text{t2=\s6,\s1,\s7,\s2,\s5}
\text{t3=\s7,\s1,\s6,\s2,\s5}
\text{t4=\s6,\s2,\s5,\s1,\s7}

\function{f=100*y/\p}

\text{ListOp=shuffle(\s1,\s2,\s3,\s4,\s5,\s6,\s7)}

\steps{reply1
reply2
reply3}

####### enoncé de l'exo #######

\statement{


  \if{\step=1}{
    Si \y correspond à \p % à quoi correspond 100 % (la référence) ? \embed{reply1,\size}.
    <table class="wimscenter wimsborder">
    <caption>Tableau de proportionnalité </caption>
      <tr>
      <td>\y</td><td>\p %</td>
     </tr><tr>
      <td>? ? ?</td><td>100 %</td>
     </tr>
    </table>
  }
  \if{\step=2}{
    Quelle formule permet de calculer la référence (100 %) si \(y) correspond à \p %  ?  \embed{reply2,7}
<br />
    <table class="wimscenter wimsborder">
    <caption>Tableau de proportionnalité</caption>
      <tr>
      <td>\(y)</td><td>\p %</td>
     </tr><tr>
      <td>? ? ?</td><td>100 %</td>
     </tr>
    </table>
  }
  \if{\step=3}{
    Quelle formule permet de calculer la référence (100 %) si \(y) correspond à \(p) % ?
<br />
    \embed{reply3,50x30x5}
    <table class="wimscenter wimsborder">
    <tr>
    <td>\(y)</td><td>\(p) %</td>
    </tr><tr>
    <td>? ? ?</td><td>100 %</td>
    </tr>
    </table>
  }

}
###indication###
\hint{
\if{\step=1}{
  Utiliser le tableau de proportionnalité pour trouver l'opération.
}
\if{\step=2}{
  Ecrire le calcul à effectuer avec \(y)
  en notant * pour multiplier et \s2 pour diviser.
}
\if{\step=3}{
  Prendre les opérations ou nombres en bas et les placer pour écrire la réponse en calculant à partir de \(y).
<br />
  \ListOp
}
}
#### Réponses ####
\answer{\y correspond à \p % }{\x}{type=numeric}
\answer{\y correspond à \(p) % }{\f}{type=function}
\answer{\(y) correspond à \(p) %}{\t1|\t2|\t3|\t4;\ListOp}{type=dragfill}

\solution{
<ul class="wims_nopuce">
<li>Pourcentage proportion</li>
<li>\(\large{ x\; \overset{\phantom{xxxx}p\%\phantom{xxxx}}{\underset{\times p/100}{\mapsto}}\; y})</li>
<li>\(\large{ x\; \underset{\phantom{xx}:(p/100)\phantom{xx}}{\leftarrow}\; y})</li>
</ul>

  Pour déterminer la référence \(x) lorsque \(p) % de \(x) vaut \(y),
  on divise \(y) par \(\frac{p}{100}).<br>
  <div class="wimscenter">\(x=\frac{y}{p/100}=100 \frac{y}{p}).</div>
}
