\title{Évolution réciproque}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}
\precision{100}

\real{av=0.01*randint(100..130)}
\real{ap=\av+0.01*randint(10..50)}
\integer{c1=(\ap-\av)/\av*100}
\integer{c2=(\ap-\av)/\ap*100}
\integer{k1=100*\ap/\av}
\integer{k2=100*\av/\ap}
\real{k1=0.01*\k1}
\real{k2=0.01*\k2}

\integer{p=randint(3..15)}
\integer{H=randint(10..80)}
\real{T=\H*(1+0.01*\p)}
\real{k3=1+0.01*\p}

\text{tsol= Dans la première question, la référence est \av et dans la deuxième c'est \ap.
  <br />
  Pour calculer le prix HT, on utilise la formule:
  \(HT = \frac{TTC}{1 + \frac{p}{100}} = \frac{\T}{1 + \frac{\p}{100}}) }

\statement{
<ol>
<li><label for="reply1">
Si le prix d'un litre de carburant augmente de \av&euro; à \ap&euro;, cela correspond à quel pourcentage d'augmentation ?
</label>
<div class="wimscenter">\embed{reply1} % (à 1% près).</div></li>
<li><label for="reply2">Si le prix d'un litre de carburant diminue de \ap&euro; à \av&euro;, cela correspond à quel pourcentage de diminution ?
</label>
<div class="wimscenter">\embed{reply2} % (à 1% près).</div></li>
<li><label for="reply3">Le prix TTC d'un objet est \T euros, sachant que la Taxe est de
\p % sur le prix Hors Taxe.</label>
Quel était son prix Hors Taxe ? \embed{reply3} euros (arrondir à 1 centime d'euro).
</li>
</ol>
}
\answer{pourcentage 1}{\c1}{type=numeric}
\answer{pourcentage 2}{\c2}{type=numeric}
\answer{Prix HT}{\H}{type=numeric}

\solution{
<ol>
<li>Pourcentage d'augmentation : \(\large{ \av\; \overset{\phantom{xxx}+ \c1 \%\phantom{xxxx}}{\underset{\times \k1}{\mapsto}}\; \ap})
</li>
<li>Pourcentage de diminution : \(\large{ \ap\; \overset{\phantom{xxx}- \c2 \%\phantom{xxxx}}{\underset{\times \k2}{\mapsto}}\; \av})
</li>
<li>Pourcentage d'augmentation : \(\large{ \H\; \overset{\phantom{xxx}+ \p \%\phantom{xxxx}}{\underset{\times \k3}{\mapsto}}\; \T})</li>
</ol>

\tsol}
