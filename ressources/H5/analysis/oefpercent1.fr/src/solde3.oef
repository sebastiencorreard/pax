\title{Les soldes classement des types de pourcentages et de questions }
\language{fr}
\range{-5..5}
\author{Rémi,Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}


%%Choix du contexte%%
\text{LO=chemise,casquette,veste,pull,pantalon,sweatshirt,sac,foulard,ballon}
\text{U1=une,une,une,un,un,un,un,un,un}
\text{U2=cette,cette,cette,cette,ce,ce,ce,ce,ce,ce}
\text{U3=étiquetée,étiquetée,étiquetée,étiqueté,étiqueté,étiqueté,étiqueté,étiqueté,étiqueté}
\text{U4=achetée,achetée,achetée,acheté,acheté,acheté,acheté,acheté,acheté}
\text{U5=vendue,vendue,vendue,vendu,vendu,vendu,vendu,vendu,vendu}
\text{A = shuffle(9)}
\text{T = shuffle(9)}

%% bornes : prix minimum, pas, nombre de pas %%
\matrix{M=14.7,2.1,10
10.5,2.1,15
35,6.3,5
14.7,8.2,10
16.8,4.2,8
12.6,2.1,8
21,10.5,6
8.4,2.1,6
6.3,2.1,10
}
\text{Vi=}
\text{P=}
\text{Vf=}
\text{Sy=}
\text{V=}

\for{i = 1 to 3}{
  \integer{n=\A[\i]}
  \real{vi1=\M[\n;1]+\M[\n;2]*randint(0..\M[\n;3])}
  \text{Vi= wims(append item \vi1 to \Vi)}
  \integer{p1 = random(10,20,30,40,60,70)}
  \text{P= wims(append item \p1 to \P)}
  \real{vp1=\vi1*0.01*\p1}
  \text{Vf= wims(append item \vp1 to \Vf)}
  \integer{m=\T[1]}
}

\integer{n=\A[1]}
\text{L1=Jo a bénéficié d'une remise sur \U1[\n]  \LO[\n] de \P[1] %. Jo a ainsi gagné \Vf[1] &euro;. Quel était le prix initial de \U2[\n] \LO[\n] ?}

\integer{n=\A[2]}
\text{L2=Sur le marché \U1[\n] \LO[\n] est \U3[\n] à \Vi[2]&euro;. Le vendeur fait une remise de \Vf[2] &euro;. Quel est le pourcentage de la remise sur le prix affiché ?}

\integer{n=\A[3]}
\text{L3=Le prix affiché d'\U1[\n] \LO[\n] est \Vi[3] &euro;. Pendant les soldes le prix est diminué de \P[3] %. Quelle est la valeur de cette réduction ?}

\for{i = 4 to 6}{
  \integer{n=\A[\i]}
  \real{vi1=\M[\n;1]+\M[\n;2]*randint(0..\M[\n;3])}
  \text{Vi= wims(append item \vi1 to \Vi)}
  \integer{p1 = random(10,20,30,40)}
  \text{P= wims(append item \p1 to \P)}
  \real{vp1=\vi1*(1+0.01*\p1)}
  \text{Vf= wims(append item \vp1 to \Vf)}
}

\integer{n=\A[4]}
\text{L4=Le prix d'\U1[\n] \LO[\n] a augmenté de \P[4] % par rapport à l'an dernier. Combien était \U5[\n] l'an dernier \U1[\n] \LO[\n] qui est \U3[\n] \Vf[4]&euro;  cette année ?}

\integer{n=\A[5]}
\text{L5=Dans une boutique \U1[\n] \LO[\n] est \U3[\n] \Vi[5]&euro; Hors Taxe et est vendu \Vf[5]&euro; Toute Taxe Comprise. Quel est le pourcentage de la taxe par rapport au prix Hors taxe de \U2[\n] \LO[\n] ? }

\integer{n=\A[6]}
\text{L6=Le prix d'\U1[\n] \LO[\n] a augmenté de \P[6] % par rapport à l'an dernier. Combien est  \U5[\n] \U1[\n] \LO[\n] qu'on avait \U4[\n] \Vi[6] &euro; l'an dernier ? }

\for{i = 7 to 9}{
  \integer{n=\A[\i]}
  \real{vi1=\M[\n;1]+\M[\n;2]*randint(0..\M[\n;3])}
  \text{Vi= wims(append item \vi1 to \Vi)}
  \integer{p1 = random(10,20,30,40)}
  \text{P= wims(append item \p1 to \P)}
  \real{\vp1=\vi1*(1-0.01*\p1)}
  \text{Vf= wims(append item \vp1 to \Vf)}
}

\integer{n=\A[7]}
\text{L7=Grâce à une remise de \P[7] % Claude a payé \U1[\n] \LO[\n] \Vf[7]&euro;. Quel était l'ancien prix de  \U2[\n] \LO[\n] ?}

\integer{n=\A[8]}
\text{L8=Dans un magasin Dominique paye \Vf[8]&euro; \U1[\n] \LO[\n] dont l'ancien prix était \Vi[8]&euro;. Quel est le pourcentage de la remise ?}

\integer{n=\A[9]}
\text{L9=Fred a acheté \U1[\n] \LO[\n] \U3[\n] \Vi[9]&euro; mais Fred a droit à une réduction de \P[9] %. Combien Fred payera \U2[\n] \LO[\n] ?}
\text{Sy=&euro;,%,&euro;,&euro;,%,&euro;,&euro;,%,&euro;}
\text{V=\Vi[1],\P[2],\Vf[3],\Vi[4],\P[5],\Vf[6],\Vi[7],\P[8],\Vf[9]}
\text{Li=\L1,\L2,\L3,\L4,\L5,\L6,\L7,\L8,\L9}
\text{En=\Li[\T[1]],\Li[\T[2]],\Li[\T[3]],\Li[\T[4]],\Li[\T[5]],\Li[\T[6]],\Li[\T[7]],\Li[\T[8]],\Li[\T[9]]}
\text{Vn=\V[\T[1]],\V[\T[2]],\V[\T[3]],\V[\T[4]],\V[\T[5]],\V[\T[6]],\V[\T[7]],\V[\T[8]],\V[\T[9]]}
\text{Syn=\Sy[\T[1]],\Sy[\T[2]],\Sy[\T[3]],\Sy[\T[4]],\Sy[\T[5]],\Sy[\T[6]],\Sy[\T[7]],\Sy[\T[8]],\Sy[\T[9]]}

\text{TT=position(1,\T),position(2,\T),position(3,\T),position(4,\T),position(5,\T),position(6,\T),position(7,\T),position(8,\T),position(9,\T)}

\text{ListeQ=la valeur de la référence en divisant par le coefficient multiplicateur, le pourcentage, la valeur de la partie ou la valeur finale}


\text{mat=slib(text/matrixhtml [\mat], TH=[1;1])}
