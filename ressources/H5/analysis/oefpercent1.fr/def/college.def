!read oef/embed.phtml reply1,\tt,<img src="gifs/images/methods/$(val10[$m_tt])" alt="$(val12[$m_tt])"> 
$()	     
!read oef/slib.phtml text/balloon [$(val13[$m_tt])],$(val15[$m_tt]),250,100,triangle=left-in 
$()	    </li>	   
!endif
$()	 
!next
$()	</ul>	   
!endif
$()	  
!if $m_step>1 
$()	    
!if $val66!=$(val14[1]) 
$()	      <p>$val16 <strong>$val66</strong>.</p>	     
!endif
$()	    <div class="wims_question">	     
!for m_tt=1 to $val8 
$()	      
!if $val66=$(val14[$m_tt]) 
$()	        <div>	
!if $m_tt=1 
$()	  <ul class="wims_nopuce">	  <li>	  <label for="reply2">	  Combien d'élèves du collège A ont été reçus au brevet des collèges ?</label>  
!read oef/embed.phtml reply2,3 
$()	  </li><li>	  Quel est le pourcentage de reçues parmi les filles candidates du collège A ?  
!read oef/embed.phtml reply3,3 
$() %	  </li><li>	  Combien de garçons ont été reçus au brevet des collèges ?  
!read oef/embed.phtml reply4,3 
$()<br>	  Quel est le pourcentage de reçus parmi les garçons candidats du collège A ?  
!read oef/embed.phtml reply5,3 
$() %	  </li></ul>	 
!endif
$()	
!if $m_tt=2 
$()	  <p>Un dessin comme celui-ci aide à comprendre l'énoncé.</p>	  <p><i>Ce dessin n'est pas à l'échelle.</i><br>	  Le réaliser à l'échelle équivaut à résoudre le problème.</p>	  <img src="$val54" alt="" />	     
!endif
$()	
