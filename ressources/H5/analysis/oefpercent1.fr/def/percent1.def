!set title=Calculer un pourcentage d'une quantité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 99

val6=$[rint($(tmp0))]
tmp0=!randint 101, 199

val7=$[rint($(tmp0))]
val8=$[0.01*$val6*$val7]
val9=\(\times)
val10=&#47
val11=&#0151
val12=&#43
val13=\(p)
val14=100
val15=$val7,$val9,$val6,$val10,$val14
val16=$val7,$val10,$val14,$val9,$val6
val17=$val9,$val13,$val10,$val14
val18=$val10,$val14,$val9,$val13
val19=!rawmath 0.01*$val6*x
tmp0=!shuffle $val9,$val10,$val11,$val12,$val13,$val14

val20=$(tmp0)
val21=<table class="wimsborder wimscenter">	<caption>Tableau de proportionnalité</caption>	  <tr>	  <td>&#63;&#63;&#63;</td><td>\(p)</td>	 </tr>	  <tr>	  <td>\(x)</td><td>100</td>	 </tr>	</table>
tmp0=!replace internal \(p) by $val6 in $val21

val22=$(tmp0)
tmp0=!replace internal \(x) by $val7 in $val22

val23=$(tmp0)
oefsteps=reply1	reply2	reply3 
nextstep=!nosubst reply1	reply2	reply3 
!readproc oef/steps.proc
replytype1=numeric
replyname1=$val6 % de $val7
replygood1=$[$val8]
replytype2=function
replyname2=$val6 % de \(x)
replygood2=!rawmath $val19
replytype3=dragfill
replyname3=\(p) % de \(x)
replygood3=$val17|$val18;$val20
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  
!if $m_step=1 
$()	  <label for="reply1">Que vaut $val6 % de $val7 ?</label>  
!read oef/embed.phtml reply1,\size 
$() (valeur exacte).	  $val23	   
!endif
$()	  
!if $m_step=2 
$()<label for="reply2">Quelle formule permet de calculer $val6 % de 
!insmath x
$() </label>?	   
!read oef/embed.phtml reply2,7 
$()	$val22	 
!endif
$()	  
!if $m_step=3 
$()Comment calculer 
!insmath p
$() % de 
!insmath x
$() ?<div class="wimscenter">	  
!insmath x
$()  
!read oef/embed.phtml reply3,50x30x4 
$()	  </div>	  $val21	 
!endif
$()		
$()
!exit

:hint
$()	
!if $m_step=1 
$()	  Utiliser le tableau de proportionnalité pour trouver l'opération.	 
!endif
$()	
!if $m_step=2 
$()	Écrire le calcul à effectuer avec 
!insmath x
$().	<div class="wims_instruction">Noter * pour multiplier et $val10 pour diviser.</div>	 
!endif
$()	
!if $m_step=3 
$()	Prendre les opérations ou nombres en bas et les placer pour écrire	la réponse en calculant à partir de 
!insmath x
$().<div class="wimscenter">	$val20	</div>	 
!endif
$()	
$()
!exit

:help
$()
$()
!exit

:solution
$()	Pourcentage proportion	<div class="wimscenter">	
!insmath \large{ x\; \overset{\phantom{xxxx}p\%\phantom{xxxx}}{\underset{\times p/100}{\mapsto}}\;	y}
$()</div>>	Pour calculer 
!insmath p
$() % de 
!insmath x
$(), on multiplie 
!insmath x
$() par 
!insmath p
$() /100.	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,20,21,22,23
embedcnt=3
