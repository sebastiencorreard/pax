!set title=Déterminer la référence d'un pourcentage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi,Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 19

val6=$[rint(5*$(tmp0))]
tmp0=!randint 26, 99

val7=$[rint(2*$(tmp0))]
val8=$[0.01*$val6*$val7]
val9=\(\times)
val10=&#47
val11=&#0151
val12=&#43
val13=\(p)
val14=100
val15=\(y)
val16=$val15,$val10,$val13,$val9,$val14
val17=$val14,$val9,$val15,$val10,$val13
val18=$val15,$val9,$val14,$val10,$val13
val19=$val14,$val10,$val13,$val9,$val15
val20=!rawmath 100*y/$val6
tmp0=!shuffle $val9,$val10,$val11,$val12,$val13,$val14,$val15

val21=$(tmp0)
oefsteps=reply1	reply2	reply3 
nextstep=!nosubst reply1	reply2	reply3 
!readproc oef/steps.proc
replytype1=numeric
replyname1=$val8 correspond à $val6 %
replygood1=$[$val7]
replytype2=function
replyname2=$val8 correspond à \(p) %
replygood2=!rawmath $val20
replytype3=dragfill
replyname3=\(y) correspond à \(p) %
replygood3=$val16|$val17|$val18|$val19;$val21
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()			  
!if $m_step=1 
$()	    Si $val8 correspond à $val6 % à quoi correspond 100 % (la référence) ?  
!read oef/embed.phtml reply1,\size 
$().	    <table class="wimscenter wimsborder">	    <caption>Tableau de proportionnalité </caption>	      <tr>	      <td>$val8</td><td>$val6 %</td>	     </tr><tr>	      <td>? ? ?</td><td>100 %</td>	     </tr>	    </table>	   
!endif
$()	  
!if $m_step=2 
$()	    Quelle formule permet de calculer la référence (100 %) si 
!insmath y
$() correspond à $val6 %  ?   
!read oef/embed.phtml reply2,7 
$()	<br />	    <table class="wimscenter wimsborder">	    <caption>Tableau de proportionnalité</caption>	      <tr>	      <td>
!insmath y
$()</td><td>$val6 %</td>	     </tr><tr>	      <td>? ? ?</td><td>100 %</td>	     </tr>	    </table>	   
!endif
$()	  
!if $m_step=3 
$()	    Quelle formule permet de calculer la référence (100 %) si 
!insmath y
$() correspond à 
!insmath p
$() % ?	<br />	     
!read oef/embed.phtml reply3,50x30x5 
$()	    <table class="wimscenter wimsborder">	    <tr>	    <td>
!insmath y
$()</td><td>
!insmath p
$() %</td>	    </tr><tr>	    <td>? ? ?</td><td>100 %</td>	    </tr>	    </table>	   
!endif
$()		
$()
!exit

:hint
$()	
!if $m_step=1 
$()	  Utiliser le tableau de proportionnalité pour trouver l'opération.	 
!endif
$()	
!if $m_step=2 
$()	  Ecrire le calcul à effectuer avec 
!insmath y
$()	  en notant * pour multiplier et $val10 pour diviser.	 
!endif
$()	
!if $m_step=3 
$()	  Prendre les opérations ou nombres en bas et les placer pour écrire la réponse en calculant à partir de 
!insmath y
$().	<br />	  $val21	 
!endif
$()	
$()
!exit

:help
$()
$()
!exit

:solution
$()	<ul class="wims_nopuce">	<li>Pourcentage proportion</li>	<li>
!insmath \large{ x\; \overset{\phantom{xxxx}p\%\phantom{xxxx}}{\underset{\times p/100}{\mapsto}}\; y}
$()</li>	<li>
!insmath \large{ x\; \underset{\phantom{xx}:(p/100)\phantom{xx}}{\leftarrow}\; y}
$()</li>	</ul>		  Pour déterminer la référence 
!insmath x
$() lorsque 
!insmath p
$() % de 
!insmath x
$() vaut 
!insmath y
$(),	  on divise 
!insmath y
$() par 
!insmath \frac{p}{100}
$().<br>	  <div class="wimscenter">
!insmath x=\frac{y}{p/100}=100 \frac{y}{p}
$().</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,10,21
embedcnt=3
