 !exit
!endif

tmp0=!randint 1000, 3000

val6=$[rint($(tmp0))]
tmp0=!randint 10, 50

val7=$[rint($(tmp0))]
t_=!rawmath 1+$val7/100
val8=!exec pari print($t_)
t_=!rawmath $val6*$val8
val9=!exec pari print($t_)
val9=$[rint($val9)]
val10=Puisqu'il s'agit d'une augmentation, on utilise la formule:	  \(HT = \frac{TTC}{1 + \frac{p}{100}})
replytype1=numeric
replyname1=av
replygood1=$[$val6]
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val10


!goto stat

!exit

:question
