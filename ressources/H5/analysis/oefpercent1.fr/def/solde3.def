val14=!translate internal $	\
$ to ;; in $tmp
val15=
val16=
val17=
val18=
val19=
!for val20  = 1 to 3 
val21=$[rint($(val12[$val20]))]
tmp0=!randint 0, $(val14[$val21;3])

val22=$[$(val14[$val21;1])+$(val14[$val21;2])*$(tmp0)]
tmp0=!append item $val22 to $val15

val15=$(tmp0)
tmp0=!randitem 10,20,30,40,60,70

val23=$[rint($(tmp0))]
tmp0=!append item $val23 to $val16

val16=$(tmp0)
val24=$[$val22*0.01*$val23]
tmp0=!append item $val24 to $val17

val17=$(tmp0)
val25=$[rint($(val13[1]))]
!next
val21=$[rint($(val12[1]))]
val26=Jo a bénéficié d'une remise sur $(val7[$val21])  $(val6[$val21]) de $(val16[1]) %. Jo a ainsi gagné $(val17[1]) &euro;. Quel était le prix initial de $(val8[$val21]) $(val6[$val21]) ?
val21=$[rint($(val12[2]))]
val27=Sur le marché $(val7[$val21]) $(val6[$val21]) est $(val9[$val21]) à $(val15[2])&euro;. Le vendeur fait une remise de $(val17[2]) &euro;. Quel est le pourcentage de la remise sur le prix affiché ?
val21=$[rint($(val12[3]))]
val28=Le prix affiché d'$(val7[$val21]) $(val6[$val21]) est $(val15[3]) &euro;. Pendant les soldes le prix est diminué de $(val16[3]) %. Quelle est la valeur de cette réduction ?
!for val20  = 4 to 6 
val21=$[rint($(val12[$val20]))]
tmp0=!randint 0, $(val14[$val21;3])

val22=$[$(val14[$val21;1])+$(val14[$val21;2])*$(tmp0)]
tmp0=!append item $val22 to $val15

val15=$(tmp0)
tmp0=!randitem 10,20,30,40

val23=$[rint($(tmp0))]
tmp0=!append item $val23 to $val16

val16=$(tmp0)
val24=$[$val22*(1+0.01*$val23)]
tmp0=!append item $val24 to $val17

val17=$(tmp0)
!next
val21=$[rint($(val12[4]))]
val29=Le prix d'$(val7[$val21]) $(val6[$val21]) a augmenté de $(val16[4]) % par rapport à l'an dernier. Combien était $(val11[$val21]) l'an dernier $(val7[$val21]) $(val6[$val21]) qui est $(val9[$val21]) $(val17[4])&euro;  cette année ?
val21=$[rint($(val12[5]))]
val30=Dans une boutique $(val7[$val21]) $(val6[$val21]) est $(val9[$val21]) $(val15[5])&euro; Hors Taxe et est vendu $(val17[5])&euro; Toute Taxe Comprise. Quel est le pourcentage de la taxe par rapport au prix Hors taxe de $(val8[$val21]) $(val6[$val21]) ? 
val21=$[rint($(val12[6]))]
val31=Le prix d'$(val7[$val21]) $(val6[$val21]) a augmenté de $(val16[6]) % par rapport à l'an dernier. Combien est  $(val11[$val21]) $(val7[$val21]) $(val6[$val21]) qu'on avait $(val10[$val21]) $(val15[6]) &euro; l'an dernier ? 
!for val20  = 7 to 9 
val21=$[rint($(val12[$val20]))]
tmp0=!randint 0, $(val14[$val21;3])

val22=$[$(val14[$val21;1])+$(val14[$val21;2])*$(tmp0)]
tmp0=!append item $val22 to $val15

val15=$(tmp0)
tmp0=!randitem 10,20,30,40

val23=$[rint($(tmp0))]
tmp0=!append item $val23 to $val16

val16=$(tmp0)
val24=$[$val22*(1-0.01*$val23)]
tmp0=!append item $val24 to $val17

val17=$(tmp0)
!next
val21=$[rint($(val12[7]))]
val32=Grâce à une remise de $(val16[7]) % Claude a payé $(val7[$val21]) $(val6[$val21]) $(val17[7])&euro;. Quel était l'ancien prix de  $(val8[$val21]) $(val6[$val21]) ?
val21=$[rint($(val12[8]))]
val33=Dans un magasin Dominique paye $(val17[8])&euro; $(val7[$val21]) $(val6[$val21]) dont l'ancien prix était $(val15[8])&euro;. Quel est le pourcentage de la remise ?
val21=$[rint($(val12[9]))]
val34=Fred a acheté $(val7[$val21]) $(val6[$val21]) $(val9[$val21]) $(val15[9])&euro; mais Fred a droit à une réduction de $(val16[9]) %. Combien Fred payera $(val8[$val21]) $(val6[$val21]) ?
val18=&euro;,%,&euro;,&euro;,%,&euro;,&euro;,%,&euro;
val19=$(val15[1]),$(val16[2]),$(val17[3]),$(val15[4]),$(val16[5]),$(val17[6]),$(val15[7]),$(val16[8]),$(val17[9])
val35=$val26,$val27,$val28,$val29,$val30,$val31,$val32,$val33,$val34
val36=$(val35[$(val13[1])]),$(val35[$(val13[2])]),$(val35[$(val13[3])]),$(val35[$(val13[4])]),$(val35[$(val13[5])]),$(val35[$(val13[6])]),$(val35[$(val13[7])]),$(val35[$(val13[8])]),$(val35[$(val13[9])])
val37=$(val19[$(val13[1])]),$(val19[$(val13[2])]),$(val19[$(val13[3])]),$(val19[$(val13[4])]),$(val19[$(val13[5])]),$(val19[$(val13[6])]),$(val19[$(val13[7])]),$(val19[$(val13[8])]),$(val19[$(val13[9])])
val38=$(val18[$(val13[1])]),$(val18[$(val13[2])]),$(val18[$(val13[3])]),$(val18[$(val13[4])]),$(val18[$(val13[5])]),$(val18[$(val13[6])]),$(val18[$(val13[7])]),$(val18[$(val13[8])]),$(val18[$(val13[9])])
tmp0=!positionof item 1 in $val13

