val27=Calculez la valeur acquise durant la première	 année\(,) la deuxième et ainsi de suite. À l'aide des résultats trouvés\(,)	 déterminez la durée du placement. ,Remplacez le montant de l'objet	 par la valeur acquise et résoudre l'équation en utilisant	 une propriété de la fonction ln. ,Réalisez la représentation graphique	 du capital acquis en fonction de la durée puis effectuez une lecture	 graphique., Réalisez la représentation graphique du capital acquis en	 fonction du taux puis effectuez une lecture graphique.
val28=Quel doit être la durée du placement financier	 pour acheter $(val21[$val19;1]) ?
val29=$val23 souhaite acquérir $(val21[$val19;1]). L'élève dispose d'une	somme de $val8 &#8364; qu'il place à un taux annuel de $val10 %. Dans	 combien de temps, pourra-t-il s'acheter le bien de consommation	 qui a une valeur de $val15 &#8364;.
!readproc slib/geo2D/jsxgraph jsxbox,500 x 300,	var board = JXG.JSXGraph.initBoard('jsxbox', {originX: 50, originY: 220, unitX: 10, unitY: 0.05, axis:true,shownavigation:false, grid:false});		var s = board.create('slider', [[1,-500],[21,-500],[500,500,700]],{name:'Capital',strokeColor:'black',fillColor:'red',snapWidth:50});	var t = board.create('slider', [[1,-1000],[26,-1000],[3,3,8]],{name:'Taux',strokeColor:'black',fillColor:'red',snapWidth:1});	var yy = board.create('text',[3,3800,function(){	    return '<b>Capital acquis en &#8364;</b>';}],{fontSize:'14px'});	var xx = board.create('text',[20,500,function(){	    return '<b>Durée du placement en année</b>';}],{fontSize:'14px'});	var fct= board.create('functiongraph', [function(x){	var sff=s.Value(),	tff=t.Value();	return sff*Math.pow(1+tff/100,x);},0,20]);	var g1 = board.create('glider', [2, $(val24[2]), fct], {style:12,name:"Déplace moi", strokeColor:'#990000',highlightStrokeColor:'#000000'});	var pyy = board.create('point',[0 ,function(){return g1.Y();}], {name:'B',style:6,visible:false});	var pxx = board.create('point',[function(){return g1.X();}, 0], {visible:false});		var fleyy = board.create('line',[pyy,g1],	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});	var fleyy = board.create('line',[g1,pxx],	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true}); 
