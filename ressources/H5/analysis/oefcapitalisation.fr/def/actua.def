$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	<div class="solution">	
!if $m_step=1 
$()La réponse précédente est fausse.<br>	<img src="$val1/attention.png" alt="Attention">L'erreur	 classique est de ne pas tenir compte du taux de $val10 %. 
!endif
$()	</div>
$()
!exit

:latex
$()
$()
!exit

:postdef
val7=

!exit

