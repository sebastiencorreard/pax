<td><b>Intérêt<br>en &#8364;</b></td>
<td><b>Capital à la fin d'année<br>en &#8364;</b></td>
</tr>
<tr>
<td>1<sup>er</sup> année</td>
<td>\som</td>
<td>\I</td>
<td>\Cun</td>
</tr>
<tr>
<td>2<sup>e</sup> année</td>
<td>\Cun</td>
<td>\embed{reply15, 4}</td>
<td>\embed{reply16, 4}</td>
</tr>
<tr>
<td>3<sup>e</sup> année</td>
<td>\embed{reply17, 4}</td>
<td></td>
<td></td>
</tr>
\for{u=4 to 8}{
<tr>
<td>\u<sup>e</sup> année</td>
<td></td>
<td></td>
<td></td>
</tr>}
