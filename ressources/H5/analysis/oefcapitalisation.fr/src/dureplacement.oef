<div id="secondTable">
<ul><li>
\proposition[2]
</li></ul>
<b>C<sub>n</sub> = C<sub>0</sub> (1+t)<sup>n</sup></b>
<br>
\embed{reply12, 5}= \embed{reply13, 5}(1+\embed{reply14, 2})<sup>n</sup>
<br>
\embed{reply15, 5}= \embed{reply16, 5}(\embed{reply17, 2})<sup>n</sup>
<div></div>
 \special{mathmlinput [\frac{reply18}{reply19}=reply20^n],5,noanswer
 reply 18
 reply 19
 reply 20}
<br>
<img src="\imagedir/attention.png" alt="Attention">Le calcul du
 quotient doit être arrondi à 10<sup>-4</sup>.
<br>
ln(\embed{reply21, 5})=ln(\embed{reply22, 2})<sup>n</sup>
<br>
ln(\embed{reply23, 5})=n \times ln(\embed{reply24, 2})
<br>
Arrondissez à l'unité
<br>
n=\embed{reply25, 2}
</div>
<div></div><div></div><div></div>

<table><tr>
