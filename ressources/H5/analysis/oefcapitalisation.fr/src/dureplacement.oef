\title{3. Durée d'un placement}
\language{fr}
\range{-5..5}
\author{Julien, Lyotard}
\email{julien.lyotard@ac-dijon.fr}

\computeanswer{no}
\format{html}
\precision{10000}


\matrix{nstep= reply1}
\nextstep{\nstep}

\integer{n=randint(0..4)}
\integer{som=500+\n*50}

\integer{c=randint(0..5)}
\real{tp=3+\c*1}
\real{t=\tp/100}
\real{tun=1+\t}

\integer{qq=randint(0..7)}
\integer{n=3+\qq*1}

\integer{Caaa=\som*(1+\t)^(\n)*100}
\real{Ca=\Caaa/100}

\integer{quoo=\Ca/\som*10000}
\real{quo=\quoo/10000}

\text{test=}

\integer{hh=}
\if{500<\Ca and \Ca<=700}{\integer{hh=1}}
\if{700<\Ca and \Ca<=900}{\integer{hh=2}}
\if{900<\Ca and \Ca<=1100}{\integer{hh=3}}
\if{1100<\Ca and \Ca<=1200}{\integer{hh=4}}
\if{1200<\Ca and \Ca<=1600}{\integer{hh=5}}
\text{name_answer=Valeur du capital la}
\matrix{app=un appareil photo,<img src="\imagedir/photo.jpg" alt="appareil photo">
un ordinateur portable,<img src="\imagedir/ordi.jpg" alt="ordinateur">
un camescope numérique,<img src="\imagedir/camescope.jpg" alt="camescope">
un téléviseur,<img src="\imagedir/tele.jpg" alt="televiseur">
une tablette pc,<img src="\imagedir/tablette.jpg" alt="tablette">}


\text{listegraph=\app[;2]}
\text{prenom=slib(oef/env fn)}

\text{l=}
\for{tt=1 to 10}{\integer{qq=\som*(1+\t)^\tt*100}
\real{qqq=\qq/100}
\text{l=wims(append item \qqq to \l)}
}

\text{proposition=Calculez la valeur acquise durant la première
 année\(,) la deuxième et ainsi de suite. À l'aide des résultats trouvés\(,)
 déterminez la durée du placement. ,Remplacez le montant de l'objet
 par la valeur acquise et résoudre l'équation en utilisant
 une propriété de la fonction ln. ,Réalisez la représentation graphique
 du capital acquis en fonction de la durée puis effectuez une lecture
 graphique., Réalisez la représentation graphique du capital acquis en
 fonction du taux puis effectuez une lecture graphique.}

\text{pro=Quel doit être la durée du placement financier
 pour acheter \app[\hh;1] ?}

\text{enonce=\prenom souhaite acquérir \app[\hh;1]. L'élève dispose d'une
somme de \som &#8364; qu'il place à un taux annuel de \tp %. Dans
 combien de temps, pourra-t-il s'acheter le bien de consommation
 qui a une valeur de \Ca &#8364;.}


\text{AA=slib(geo2D/jsxgraph jsxbox,500 x 300,
var board = JXG.JSXGraph.initBoard('jsxbox', {originX: 50, originY: 220, unitX: 10, unitY: 0.05, axis:true,shownavigation:false, grid:false});

var s = board.create('slider', [[1,-500],[21,-500],[500,500,700]],{name:'Capital',strokeColor:'black',fillColor:'red',snapWidth:50});
var t = board.create('slider', [[1,-1000],[26,-1000],[3,3,8]],{name:'Taux',strokeColor:'black',fillColor:'red',snapWidth:1});
var yy = board.create('text',[3,3800,function(){
    return '<b>Capital acquis en &#8364;</b>';}],{fontSize:'14px'});
var xx = board.create('text',[20,500,function(){
    return '<b>Durée du placement en année</b>';}],{fontSize:'14px'});
var fct= board.create('functiongraph', [function(x){
var sff=s.Value(),
tff=t.Value();
return sff*Math.pow(1+tff/100,x);},0,20]);
var g1 = board.create('glider', [2, \l[2], fct], {style:12,name:"Déplace moi", strokeColor:'#990000',highlightStrokeColor:'#000000'});
var pyy = board.create('point',[0 ,function(){return g1.Y();}], {name:'B',style:6,visible:false});
var pxx = board.create('point',[function(){return g1.X();}, 0], {visible:false});

var fleyy = board.create('line',[pyy,g1],
 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});
var fleyy = board.create('line',[g1,pxx],
 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});)}

\text{AAA=slib(geo2D/jsxgraph box2,500 x 300,
var brd = JXG.JSXGraph.initBoard('box2', {originX: 50, originY: 220, unitX: 10, unitY: 0.05, axis:true,shownavigation:false, grid:false});
var ss = brd.create('slider', [[1,-500],[21,-500],[500,500,700]],{name:'Capital',strokeColor:'black',fillColor:'red',snapWidth:50});
var nn = brd.create('slider', [[1,-1000],[21,-1000],[1,3,10]],{name:'Durée du placement',strokeColor:'black',fillColor:'red',snapWidth:1});

var yyy = brd.create('text',[3,3800,function(){
    return '<b>Capital acquis en &#8364;</b>';}],{fontSize:'14px'});
var xxx = brd.create('text',[20,500,function(){
    return '<b>Taux en pourcentage</b>';}],{fontSize:'14px'});

var f= brd.create('functiongraph', [function(x){return ss.Value()*Math.pow(1+x/100,nn.Value());},0,20]);
var gg = brd.create('glider', [2, ss.Value()*Math.pow(1+2/100,nn.Value()), f], {style:12,name:"Déplace moi", strokeColor:'#990000',highlightStrokeColor:'#000000'});

var pyyy = brd.create('point',[0 , function(){ return gg.Y();}], {name:'B',style:6,visible:false});
var pxxx = brd.create('point',[function(){ return gg.X();}, 0], {visible:false});

var fleyyy = brd.create('line',[pyyy,gg],
 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});
var fleyyy = brd.create('line',[pxxx,gg],
 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});)}

