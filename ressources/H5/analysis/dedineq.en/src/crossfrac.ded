\title{Cross fractions}
\author{Gang Xiao}
\email{xiao@unice.fr}
\language{en}
\options{nofloat expand}
\text{methrand=random(trans,addineq)}
\methods{ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/divexp,
ineq/\methrand, ineq/mulineq, ineq/sqrpos}
\minsteps{3}

\text{kind=random(integer, real numbers, rational numbers)}
\matrix{vars=a,b
c,d
x,y
r,s
s,t
p,q
}
\text{vars=randomrow(\vars)}
\text{x=item(1,\vars)}
\text{y=item(2,\vars)}
\matrix{data=>,>,>=,2
<,<,>=,2
<,>,<=,-2
>,<,<=,-2
}
\text{data=randomrow(\data)}
\text{s1=item(1,\data)}
\text{s2=item(2,\data)}
\text{sign=item(3,\data)}
\text{right=item(4,\data)}

\text{left=maxima(\x/\y + \y/\x;)}
\text{prv=\left \sign \right}
\context{\x \s1 0
\y \s2 0
}
\goal{\prv}

\statement{Let \(\x) and \(\y) be two \kind with \(\x \s1 0) and
\(\y \s2 0). Prove \( \prv ) .
}

