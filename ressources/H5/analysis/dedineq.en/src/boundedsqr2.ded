\title{Bounded square II}
\author{Gang Xiao}
\email{xiao@unice.fr}
\language{fr}
\environ{QQ}
\options{nofloat}
\text{methcst=random(constineq,obvineq)}
\text{methnum=random(mulnum, divnum)}
\text{methadd=random(addnum, addterm)}
\text{methsid=random(addineq, trans)}
\text{methoth=random(ineq/sqrpos, ineq/splitineq, prf/splitgoal, exp/rewrite)}
\methods{ineq/\methadd, ineq/\methnum, ineq/exsides,
ineq/\methcst, ineq/\methsid, ineq/mulineq,
\methoth,prf/contrapose}

\text{x=random(a,b,c,d,r,s,t,x,y,z)}
\integer{a=random(8..60)}
\integer{sqr=\a^2}
\text{empty=}

\integer{ra=random(1,2)}
\if{\ra=1}{\minsteps{2}}{\minsteps{3}}
\text{eqr=random(,=)}
\text{less=<\eqr}
\text{more=>\eqr}
\text{prv=item(\ra,\x \more \a, \x \less -\a)}
\text{ctx1=\x^2 \more \sqr}
\text{ctx2=item(\ra,\x >random(,=) 0, \x <random(,=) 0)}

\context{\ctx1
\ctx2}
\goal{\prv}
\text{oldgoal=\goal}

\statement{Let \(\x) be a real number with \(\ctx2) and
\(\ctx1 = \a^2).
Prove \( \oldgoal ) .
}


