\title{Sum and product}
\author{Gang Xiao}
\email{xiao@unice.fr}
\language{en}
\options{nofloat}
\methods{ineq/addterm, ineq/mulnum, ineq/divnum, ineq/exsides,
ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,
ineq/sqrpos}
\minsteps{7}

\integer{n=random(100..200)}
\integer{s=ceil(\n^2/4)+random(100..500)}

\text{lt1=random(<,<=)}
\text{less=random(<,<=)}
\text{less2=<}
\text{grt2=>}
\text{pos=0 \lt1 a + b}
\text{ltn=a + b \less \n}

\context{\pos
\ltn
}
\goal{a*b \less2 \s}
\text{oldgoal=\goal}

\statement{Let \(a\) and \(b\) be two integers such that
\(0 \lt1 \ltn).
Prove
<div class="wimscenter">
	\( \oldgoal ) .
</div>
}
