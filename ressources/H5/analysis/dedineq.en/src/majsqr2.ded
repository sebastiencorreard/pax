\title{Upper-bound the square II}
\author{Gang Xiao}
\email{xiao@unice.fr}
\language{en}
\options{nofloat}
\methods{ineq/addterm, ineq/mulexp, ineq/exsides,
ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,
ineq/sqrpos}
\minsteps{2}

\text{x=random(a,b,c,d,r,s,t,x,y,z)}
\integer{a=random(2..100)}
\integer{b=random(2..100)}
\integer{c=max(\a,\b)}
\integer{sqr=\c^2}

\text{eqr=random(,=)}
\text{less=<\eqr}
\text{more=>\eqr}
\text{left=\x \more -\a}
\text{right=\x \less \b}
\context{\left
\right
}

\statement{Let \(\x) be a real number with \(-\a \less \x \less \b).
Prove	\( \x^2 \less \sqr ) .
}

\text{cut=wims(nospace \newobject)}

\condition{\cut issametext \x^2\less\sqr}
