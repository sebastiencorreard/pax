!set title=Sum and product II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/lincomb,	ineq/mulnum, ineq/divnum, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=4
tmp=!trim a,b	c,d	r,s	s,t	u,v	x,y	
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!randitem rational numbers, real numbers

val9=$(tmp0)
tmp0=!shuffle 25

val10=$(tmp0)
tmp0=!item 1 of $val10

val11=$[rint($(tmp0)+2)]
tmp0=!item 2 of $val10

val12=$[rint($(tmp0)+2)]
tmp0=!randint 50, 100

val13=$[rint($(tmp0)*2)]
t_=!rawmath $val13^2/(4*$val11*$val12)
val14=!exec pari print($t_)
tmp0=!randitem <,<=

val15=$(tmp0)
val16=!rawmath $val11*$val7 + $val12*$val8
val17=$val16 $val15 $val13
m_context=$val7 > 0	$val8 > 0	$val17	
val18=$val7*$val8 $val15 $val14
m_goal=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val7
$() and 
!insmath $val8
$() be two positive $val9 such that	
!insmath $val17
$(). Prove	<div class="wimscenter">	 
!insmath  $val18 
$() .	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,17,18
embedcnt=0
