!set title=Upper-bound the square III
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=18
prevarcnt=12
postvarcnt=5
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=2
tmp0=!randitem a,b,c,d,r,s,t,x,y,z

val6=$(tmp0)
tmp0=!randint 10, 50

val7=$[rint($(tmp0))]
tmp0=!randint 10, 50

val8=$[rint($(tmp0))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(max($val7-($val9),$val8+($val9)))]
val11=$[rint($val10^2)]
val12=!rawmath $val6+$val9
tmp0=!randitem ,=

val13=$(tmp0)
val14=<$val13
val15=>$val13
val16=$val6 $val15 -$val7
val17=$val6 $val14 $val8
m_context=$val16	$val17	
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Find the best upper bound for 
!insmath ($val12)^2
$(), when	<div class="wimscenter">	
!insmath -$val7 $val14 $val6 $val14 $val8
$() .	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val18=
tmp0=!translate internal <=> to , ; in $m_newobject

val19=$(tmp0)
!if ; notin $val19 and , isin $val19 
tmp0=!item 1 of $val19

val16=$(tmp0)
tmp0=!item 2 of $val19

val17=$(tmp0)
t_=!replace internal \( by ( in Simplify(($val12)^2 - ($val16))
tmp0=!exec yacas $t_

val18=$(tmp0)
!endif

!exit

:feedback

!exit

:test

!ifval $val18 issametext 0 and $val17 = $val11
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=6,7,8,11,12,14,16,17
embedcnt=0
