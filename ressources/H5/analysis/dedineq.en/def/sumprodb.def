!set title=Sum and product bis
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=11
prevarcnt=7
postvarcnt=3
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=7
tmp0=!randint 100, 200

val6=$[rint($(tmp0))]
tmp0=!randint 50, 200

val7=$[rint(ceil($val6^2/4)+$(tmp0))]
tmp0=!randitem <,<=

val8=$(tmp0)
val9=<
val10=>
val11=-$val6 $val8 a + b
val12=a + b $val8 $val6
m_context=$val11	$val12	
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath \a
$() and 
!insmath \b
$() be two integers such that	
!insmath -$val6 $val8 a + b $val8 $val6
$().	Prove	<div class="wimscenter">	 
!insmath  a*b $val9 $val7 
$() .	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!nospace $m_newobject

val13=$(tmp0)
val14=a*b
val15=b*a

!exit

:feedback

!exit

:test

!ifval $val13 iswordof $val14$val9$val7 $val15$val9$val7	 $val7$val10$val14 $val7$val10$val15	
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=0
