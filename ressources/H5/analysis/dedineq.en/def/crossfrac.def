!set title=Cross fractions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat expand
tmp0=!randitem trans,addineq

val2=$(tmp0)
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/divexp,	ineq/$val2, ineq/mulineq, ineq/sqrpos
m_minsteps=3
tmp0=!randitem integer, real numbers, rational numbers

val3=$(tmp0)
tmp=!trim a,b	c,d	x,y	r,s	s,t	p,q	
val4=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val4

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val4=$(tmp0)
tmp0=!item 1 of $val4

val5=$(tmp0)
tmp0=!item 2 of $val4

val6=$(tmp0)
tmp=!trim >,>,>=,2	<,<,>=,2	<,>,<=,-2	>,<,<=,-2	
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$(tmp0)
tmp0=!item 2 of $val7

val9=$(tmp0)
tmp0=!item 3 of $val7

val10=$(tmp0)
tmp0=!item 4 of $val7

val11=$(tmp0)
t_=!replace internal \( by ( in $val5/$val6 + $val6/$val5;
tmp0=!exec maxima $t_

val12=$(tmp0)
val13=$val12 $val10 $val11
m_context=$val5 $val8 0	$val6 $val9 0	
m_goal=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val5
$() and 
!insmath $val6
$() be two $val3 with 
!insmath $val5 $val8 0
$() and	
!insmath $val6 $val9 0
$(). Prove 
!insmath  $val13 
$() .	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=3,5,6,8,9,13
embedcnt=0
