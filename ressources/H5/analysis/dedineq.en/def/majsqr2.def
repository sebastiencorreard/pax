!set title=Upper-bound the square II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=12
prevarcnt=10
postvarcnt=1
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=2
tmp0=!randitem a,b,c,d,r,s,t,x,y,z

val6=$(tmp0)
tmp0=!randint 2, 100

val7=$[rint($(tmp0))]
tmp0=!randint 2, 100

val8=$[rint($(tmp0))]
val9=$[rint(max($val7,$val8))]
val10=$[rint($val9^2)]
tmp0=!randitem ,=

val11=$(tmp0)
val12=<$val11
val13=>$val11
val14=$val6 $val13 -$val7
val15=$val6 $val12 $val8
m_context=$val14	$val15	
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val6
$() be a real number with 
!insmath -$val7 $val12 $val6 $val12 $val8
$().	Prove 
!insmath  $val6^2 $val12 $val10 
$() .	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!nospace $m_newobject

val16=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val16 issametext $val6^2$val12$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=6,7,8,10,12
embedcnt=0
