!set title=Given produit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/addterm, ineq/mulexp, ineq/divexp, ineq/exsides,	ineq/trans, ineq/addineq, ineq/mulineq,	prf/contrapose
m_minsteps=3
tmp=!trim a,b	c,d	x,y	r,s	s,t	p,q	
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!randint 3, 20

val9=$[rint($(tmp0))]
tmp0=!randint 3, 20

val10=$[rint($(tmp0))]
val11=$[rint($val9*$val10)]
val12=
tmp0=!randitem ,=

val13=$(tmp0)
val14=<$val13
val15=>$val13
val16=$val7*$val8 $val14 $val11
val17=$val7 $val15 $val9
val18=$val8 $val14 $val10
m_context=$val16	$val17
m_goal=$val18
val19=$m_goal
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val7
$() and 
!insmath $val8
$() be two real numbers with 
!insmath $val16
$() and 
!insmath $val17
$().	Prove 
!insmath  $val19 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,16,17,19
embedcnt=0
