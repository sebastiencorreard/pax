!set title=Bounded square I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_environ=QQ
m_options=nofloat
tmp0=!randitem constineq,obvineq

val2=$(tmp0)
tmp0=!randitem mulnum, divnum

val3=$(tmp0)
tmp0=!randitem addnum, addterm

val4=$(tmp0)
tmp0=!randitem addineq, trans

val5=$(tmp0)
tmp0=!randitem ineq/sqrpos, ineq/splitineq, prf/splitgoal, exp/rewrite

val6=$(tmp0)
m_methods=ineq/$val4, ineq/$val3, ineq/exsides,	ineq/$val2, ineq/$val5, ineq/mulineq,	$val6,prf/contrapose
tmp0=!randitem a,b,c,d,r,s,t,x,y,z

val7=$(tmp0)
tmp0=!randint 8, 60

val8=$[rint($(tmp0))]
val9=$[rint($val8^2)]
val10=
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
!if $val11=1 
m_minsteps=2
!else
m_minsteps=3
!endif
tmp0=!randitem ,=

val12=$(tmp0)
val13=<$val12
val14=>$val12
tmp0=!item $val11 of $val7 $val13 $val8, $val7 $val14 -$val8

val15=$(tmp0)
val16=$val7^2 $val13 $val9
m_context=$val16
m_goal=$val15
val17=$m_goal
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val7
$() be a real number with 
!insmath $val16 = $val8^2
$().	Prove 
!insmath  $val17 
$() .	
$()
!exit

:hint
$()	A proof by contradiction is necessary.	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,16,17
embedcnt=0
