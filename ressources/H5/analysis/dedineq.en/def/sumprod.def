!set title=Sum and product
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=en

varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat
m_methods=ineq/addterm, ineq/mulnum, ineq/divnum, ineq/exsides,	ineq/trans, ineq/constineq, ineq/addineq, ineq/mulineq,	ineq/sqrpos
m_minsteps=7
tmp0=!randint 100, 200

val6=$[rint($(tmp0))]
tmp0=!randint 100, 500

val7=$[rint(ceil($val6^2/4)+$(tmp0))]
tmp0=!randitem <,<=

val8=$(tmp0)
tmp0=!randitem <,<=

val9=$(tmp0)
val10=<
val11=>
val12=0 $val8 a + b
val13=a + b $val9 $val6
m_context=$val12	$val13	
m_goal=a*b $val10 $val7
val14=$m_goal
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath a
$() and 
!insmath b
$() be two integers such that	
!insmath 0 $val8 $val13
$().	Prove	<div class="wimscenter">	 
!insmath  $val14 
$() .	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,13,14
embedcnt=0
