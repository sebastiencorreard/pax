!set title=Sum and product of 3 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr

varcnt=24
prevarcnt=14
postvarcnt=9
replycnt=0
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

m_options=nofloat fixedgoal
tmp0=!randitem constineq,obvineq

val6=$(tmp0)
tmp0=!randitem trans,addineq

val7=$(tmp0)
m_methods=ineq/rewrite, ineq/simpdeduc, ineq/mulexp, ineq/lincomb,	ineq/$val6, ineq/$val7, ineq/mulineq, ineq/sqrpos
m_minsteps=7
tmp=!trim x,y,z	a,b,c	r,s,t	l,m,n	u,v,w	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=$(tmp0)
tmp0=!item 3 of $val8

val11=$(tmp0)
tmp0=!randint 10, 60

val12=$[rint(3*$(tmp0))]
val13=$[rint($val12^2/3)]
tmp0=!randitem integers, rational numbers, real numbers

val14=$(tmp0)
tmp0=!randitem <,<=

val15=$(tmp0)
val16=$val9 + $val10 + $val11 $val15 $val12
val17=0 $val15 $val9 + $val10 + $val11
val18=$val9*$val10 + $val9*$val11 + $val10*$val11 $val15 $val13
m_context=$val17	$val16	
m_goal=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath $val9, $val10, $val11
$() be three $val14 such that 
!insmath  0 $val15 $val16 
$().	Prove	<div class="wimscenter">	
!insmath $val18
$().	</div>	
$()
!exit

:hint
$()One should prove	<div class="wimscenter">	
!insmath $val9*$val10 + $val9*$val11 + $val10*$val11 $val15 $val9^2 + $val10^2 + $val11^2
$().	</div>	And for this, you should start by 
!insmath 2*$val9*$val10 $val15 $val9^2 + $val10^2
$(), etc.	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!if $m_newobject != &#36;empty 
tmp0=!exec mathexp cut inequality	$m_newobject

val19=$(tmp0)
tmp0=!item 1 of $val19

val20=$(tmp0)
tmp0=!item 2 of $val19

val21=$(tmp0)
tmp0=!item 3 of $val19

val22=$(tmp0)
!if $val21 issametext $val15 
tmp=!translate ";': to $     $ in $val20-(\prv1)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $val22-($val13)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
!else
tmp=!translate ";': to $     $ in $val22-(\prv1)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $val20-($val13)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
tmp0=!translate internal <> to >< in $val21

val21=$(tmp0)
!endif
!endif

!exit

:feedback

!exit

:test

!ifval $val23 = 0 and $val24 = 0 and $val21 issametext $val15
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=9,10,11,13,14,15,16,18
embedcnt=0
