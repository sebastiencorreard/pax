tmp=!translate ";': to $     $ in $val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in y= $val17*(x-($val12))+($val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
