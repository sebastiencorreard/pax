tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
val12=!rawmath sqrt(-($val7)/(2*($val6)))
tmp=!translate ";': to $     $ in $val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=!rawmath $(tmp0)
val13=$val12
tmp0=!replace / by , in $val13

val13=$(tmp0)
tmp0=!itemcnt $val13


!ifval $(tmp0)>1
val13=\frac{$(val13[1])}{$(val13[2])}
!else
val13=$val13
!endif
val14=!rawmath $val6*x^4 + $val7*x^2 +$val11*x
tmp0=!replace internal * by in $val14

val15=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
evaltmp=$val16

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
tmp0=!mathsubst x=($val12) in $val14

