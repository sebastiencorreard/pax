t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
tmp0=!mathsubst x=($val30) in $val21

val31=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath $(tmp0)
tmp0=!mathsubst x=a in $val29

