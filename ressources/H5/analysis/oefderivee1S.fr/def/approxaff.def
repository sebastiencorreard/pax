val6=\(-\infty)
val7=\(+\infty)
val8=\(\emptyset)
val9=&#59;
tmp0=!randint -3, -2

tmp1=!randint 0, 3

tmp2=!randitem $(tmp0),$(tmp1)

tmp=!translate internal $	$ to ; in 	1/(x+1),$(tmp2),\(\RR \setminus) &#123;-1 &#125;	sin(x),0, \(\,\RR)	cos(x),0,\(\,\RR)	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp3=!translate internal $\
$ to ; in $tmp
val10=$(tmp3),1
tmp0=!randitem 0,1

tmp1=!randint -3, 3

tmp=!translate internal $	$ to ; in 	1/(x+1)^2,$(tmp0),\(\RR \setminus) &#123;-1 &#125;	(x+1)^2,$(tmp1),\(\,\RR)	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val11=$(tmp2),2
tmp0=!randint -2, 2

tmp1=!randitem 0,1

tmp=!translate internal $	$ to ; in 	(x+1)^3,$(tmp0),\(\,\RR)	1/(x+1)^3,$(tmp1),\(\RR \setminus) &#123;-1 &#125;	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val12=$(tmp2),3
tmp0=!randitem 0,3,8,15

tmp1=!randitem 0,3,15

tmp=!translate internal $	$ to ; in 	sqrt(x+1),$(tmp0), &#91;-1 $val9 $val7 &#93;	1/sqrt(x+1),$(tmp1), &#93;-1 $val9 $val7 &#93;	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val13=$(tmp2),0.5
val14=$val10;$val11;$val12;$val13
tmp=!translate internal $	$ to ; in $val14

tmp0=!rowcnt $tmp
val15=$[rint($(tmp0))]
tmp0=!shuffle $val15

val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val14

tmp=!row $(val16[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val17=$(val10[1])
val18=$[rint($(val10[2]))]
val19=$(val10[3])
tmp=!nonempty items 0.001,0.002,0.003,0.005,0.006,0.008,0.01,0.015,0.02,0.03,0.05

tmp0=!randitem $tmp
tmp1=!randitem 1,-1

val20=$[$(tmp0)*$(tmp1)]
val21=$[-($val20)]
val22=$[1+$val20]
val23=$[1-$val20]
val24=$[2+$val20]
val25=$[2-$val20]

!ifval $val20>0
val26=[0,$val20]
!else
val26=[$val20,0]
!endif
tmp0=!replace internal x+1 by $val22 in $val17

val27=$(tmp0)
tmp0=!replace internal x+2 by $val24 in $val27

val27=$(tmp0)
tmp0=!mathsubst x=$val20 in $val27

val27=$(tmp0)
val28=!rawmath $val17
val29=!rawmath $val27
evaltmp=$val28

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val30=$[$(tmp0)]
val31=$[$val18+($val20)]
tmp=!translate ;";': to $     $ in $val28,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val32=!rawmath $(tmp0)
evaltmp=$val32

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val33=$[$(tmp0)]
val34=$[$val33*$val20 +($val30)]

!ifval $val18<0
val35= ($val18)
!else
val35=$val18
!endif

!ifval $val33<0
val36=($val33)
!else
val36=$val33
!endif

!ifval $val20<0
val37=($val20)
!else
val37=$val20
!endif
