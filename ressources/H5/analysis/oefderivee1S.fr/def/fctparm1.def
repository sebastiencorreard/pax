 !exit
!endif

val6=\(-\infty)
val7=\(+\infty)
val8=\(\emptyset)
val9=&#59;
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
tmp0=!replace internal A by 1,2 in $val2

val13=$(tmp0)
tmp0=!replace internal B by 3 in $val13

val13=$(tmp0)
tmp0=!replace internal C by 4,5,6 in $val13

val13=$(tmp0)
tmp0=!randint $val13

val14=$[rint($(tmp0))]

!ifval $val14 notwordof 1 2 3 4 5 6 
tmp0=!randint 1, 6

val14=$[rint( $(tmp0))]
!endif
tmp0=!item $val14 of $val10*(x)^2 + $val11*x + $val12,	$val10*x^3 + $val11*(x)^2 + $val12*x,	$val11*x + $val12 + $val10/(x + 1),	$val11*x + $val12 + $val10*sqrt(x + 1),$val10*sqrt(x) + $val11*x + $val12,$val10*sqrt(2*x + 1) + $val11*x + $val12

val15=!rawmath $(tmp0)
tmp0=!item $val14 of a x^2 + b x + c,a x^3 + b x^2 + c x,a/(x + 1) + b x + c,a*sqrt(x + 1) + b x + c,	a*sqrt(x) + b x + c,a*sqrt(2*x + 1) + b x + c

val16=$(tmp0)
val17=\(\,\RR), \(\,\RR), \(\RR \setminus)&#123;-1&#125;, &#91;-1$val9 $val7 &#91;,\(\RR^+),&#91;-1/2$val9 $val7 &#91;
val18=$(val17[$val14])
tmp0=!texmath $val16

val16=$(tmp0)
tmp0=!item $val14 of 0,1,0,0,1,0

val19=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randitem 1,2

tmp2=!randitem -2,-1,2

tmp3=!randitem -3,-2,1,2

tmp4=!randitem 1,2,3

tmp5=!randitem 2,3,4,8,9

tmp6=!randitem 1,2,3,4

tmp7=!item $val14 of $(tmp0)*$(tmp1),$(tmp2),$(tmp3),$(tmp4),$(tmp5),$(tmp6)

val20=$[rint($(tmp7))]
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val21=!rawmath $(tmp0)
tmp0=!mathsubst x=$val19 in $val15

val22=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val22

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=!rawmath $(tmp0)
tmp0=!mathsubst x=$val20 in $val15

val23=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=!rawmath $(tmp0)
tmp0=!replace internal sqrt(4) by 2 in $val23

val23=!rawmath $(tmp0)
tmp0=!replace internal sqrt(8) by 2*sqrt(2) in $val23

val23=!rawmath $(tmp0)
tmp0=!replace internal sqrt(9) by 3 in $val23

val23=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val23))
tmp0=!exec maxima $t_

val23=!rawmath $(tmp0)
tmp0=!replace internal log by ln in $val23

val23=!rawmath $(tmp0)
tmp0=!texmath $val23

val24=$(tmp0)
val25=$[min(min($val19-2,$val20-1),-1)]
val26=$[max(max($val19+2,$val20+1),1)]
val27=$[min(min($val22-1,$val23-1),-1)]
val28=$[max(max($val22+1,$val23+1),1)]
tmp0=!mathsubst x=$val19 in $val21

val29=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val29

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val29=!rawmath $(tmp0)

!ifval $val22-$val29 < $val27+1 and $val22 + $val29>$val28-1 
val27=$[ $val22-$val29 -1 ]
!else
val27=$[ $val27]
!endif

!ifval $val22+$val29 < $val27 + 1 and $val22-$val29>$val28-1 
val27=$[ $val22 + $val29 -1 ]
!else
val27=$[ $val27]
!endif

!ifval $val28-$val27 > 40 
val27=$[ $val27-1]
!endif

!ifval $val22-$val29 >$val27 and $val22-$val29<$val28 
val30=$[ $val19-1 ]
!else
val30=$[ $val19+1]
!endif

!ifval $val22-$val29 >$val27 and $val22-$val29<$val28 
val31=$[ $val22-$val29 ]
!else
val31=$[ $val22+$val29]
!endif

!ifval abs($val29)>8 or (abs($val29)> 3 and $val28-$val27 >25) 
val32=	fcircle $val30,$val31,5, red	dsegment 0,$val31,$val30,$val31,red	text red , 0.1 , $val31, medium,$val31
!endif

!ifval floor($val23)<>$val23 or $val28 - $val27 > 25
val33=	text blue, 0.1,$val23,medium,$val23	dsegment 0,$val23,$val20,$val23,blue	
!endif

!ifval $val28 - $val27 >25 
val34=	dsegment 0,$val22,$val19,$val22,blue	text blue, 0.1,$val22,medium,$val22	
!endif
val35=$[rint(floor($val27))]
val36=$[rint(floor($val28)+1)]
val37=\($val19),\($val20),\($val22),\($val24),\($val29),\(0)
tmp0=!listuniq $val37

val38=$(tmp0)
val39=f,f'
val40=80x40x1
oefsteps=reply1,reply2,reply3,reply4,reply5,reply6,reply10,reply11,reply12	reply7,reply8,reply9 
nextstep=!nosubst reply1,reply2,reply3,reply4,reply5,reply6,reply10,reply11,reply12	reply7,reply8,reply9 
