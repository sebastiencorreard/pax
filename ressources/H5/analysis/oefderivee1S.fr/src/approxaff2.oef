 \title{Approximation affine 2}

\language{fr}
\author{Régine,Mangeard}
\email{regine@mangeard.fr}
\format{html}
\keywords{affine_function}
\text{infg=\(-\infty)}
\text{infd=\(+\infty)}
\text{empt=\(\emptyset)}
\text{ptvirg=&#59;}
\text{data1=randomrow(
1/(x+1),random(randint(-3..-2),randint(0..3)),\(\RR \setminus) &#123;-1 &#125;
sin(x),0, \(\,\RR)
cos(x),0,\(\,\RR)
),1}
\text{data2=randomrow(
1/(x+1)^2,randint(0,1),\(\RR \setminus) &#123;-1 &#125;
(x+1)^2,randint(-3..3),\(\,\RR)
),2}
\text{data3=randomrow(
(x+1)^3,randint(-2..2),\(\,\RR)
1/(x+1)^3,randint(0,1),\(\RR \setminus) &#123;-1 &#125;
),3}
\text{datah=randomrow(
sqrt(x+1),random(0,3,8,15), &#91;-1 \ptvirg \infd &#93;
1/sqrt(x+1),random(0,3,15), &#93;-1 \ptvirg \infd &#93;
),0.5}
\text{data=\data1;\data2;\data3;\datah}
\integer{cnt=rows(\data)}
\text{take=shuffle(\cnt)}
\text{data1=row(\take[1],\data)}
\text{f1=\data1[1]}
\integer{x0=\data1[2]}
\text{defdom=\data1[3]}
\real{epsilon=randitem(0.001,0.002,0.003,0.005,0.006,0.008,0.01,0.015,0.02,0.03,0.05)*random(1,-1)}
\real{minus=-(\epsilon)}
\real{plus1=1+\epsilon}
\real{minus1=1-\epsilon}
\real{plus2=2+\epsilon}
\real{minus2=2-\epsilon}
\text{interval=\epsilon>0?[0,\epsilon]:[\epsilon,0]}
\text{v1=wims(replace internal x+1 by \plus1 in \f1)}
\text{v1=wims(replace internal x+2 by \plus2 in \v1)}
\text{v1=wims(mathsubst x=\epsilon in \v1)}
\function{f=\f1}
\function{value=\v1}
\real{const=evalue(\f,x=\x0)}
\real{x1=\x0+(\epsilon)}
\function{deriv=diff(\f,x)}
\real{deriv0=evalue(\deriv,x=\x0)}
\real{approx=\deriv0*\epsilon +(\const)}

\real{y1=evalue(\f,x=\x1)}
\text{lstapp=excès,défaut}
\integer{rep=\y1<\approx?1:2}

%%%%%%%%%% solutions %%%%%%%%%%%%%%%%%%%%%%%%%
\text{x0sol=\x0<0? (\x0):\x0}
\text{deriv0sol=\deriv0<0?(\deriv0):\deriv0}
\text{epsilonsol=\epsilon<0?(\epsilon):\epsilon}
%%%%%%%%%%fin solution %%%%%%%%%%%%%%%%%%%%%%%
\statement{Soit la fonction \(f) définie sur \defdom par <span class="nowrap">\(f(x)= \f).</span>
<div class="wims_question"><ol>
<li><label for="reply1">Donner l'expression de </label> <span class="nowrap">\(f'(x)\) : \embed{reply1,20}</span>.</li>
<li><label for="reply2">Puis calculer </label> <span class="nowrap">\(f'(\x0)) : \embed{reply2}</span>
<br><label for="reply3">et </label><span class="nowrap">\(f(\x0)) :\embed{reply3}.</span></li>
<li><label for="reply4">Enfin donner une valeur approchée au millième de </label><span class="nowrap">\(f(\x1)) :
\embed{reply4}</span>.</li>

<li>Cette approximation affine est une valeur approchée de \(f(\x1))
par \embed{reply5}.</li>

</ol>
</div>
}
\answer{Étape 1}{\deriv}{type=formal}
\answer{Étape 2}{\deriv0}{type=numeric}
\answer{Étape 3}{\const}{type=numeric}
\answer{Étape 4}{\approx}{type=numeric}

\answer{Étape 5}{\rep;\lstapp}{type=radio}

\hint{Une valeur approchée par approximation affine s'obtient par&nbsp;:
<div class="wimscenter unbreakable">\(f(x_0+h) \simeq f(x_0)+f'(x_0)h\).</div>}
\solution{
<ul class="wims_nopuce">
<li>On sait que&nbsp;:<br> <div class="wims_scrollable">\(f(\x1) \simeq f(\x0) + f'(\x0)(\x1-\x0sol)\)</div></li>
<li>Or : <br>
<div class="wims_scrollable">\(f(\x0) + f'(\x0)(\x1-\x0sol) = \const + \deriv0sol \times \epsilonsol\)<br>
\(\phantom{  f(\x0) + f'(\x0)(\x1-\x0sol)}= \approx \)
</div></li>
</ul>
Conclusion&nbsp;: \(f(\x1) \simeq \approx \)}

