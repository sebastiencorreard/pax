\title{Fonction donnée par 2 tangentes et 1 point}
\language{fr}
\keywords{tangent}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\steps{reply1,reply2,reply3,reply4,reply5,reply6,reply10,reply11,reply12
reply7,reply8,reply9}

\integer{cas=random(1,2)}
###integer{cas=1}
\integer{sing1=random(1..5)*random(1,-1)}
\integer{sing2=\sing1+random(1..5)*random(1,-1)}

\if{\cas=1}{
  \integer{a=random(1..5)*random(-1,1)}
  \rational{b=-3*(\a)*((\sing1)+(\sing2))/2}
  \rational{c=3*(\a)*(\sing1)*(\sing2)}
  \function{f=\a*(x)^3 + (\b)*(x)^2+ (\c)*(x) }
  \function{y1=wims(mathsubst x=\sing1 in \f)}
  \function{y1=simplify(\y1)}
  \text{ty1=texmath(\y1)}
  \rational{y2=evalue(\f,x=\sing2)}
  \function{y2=simplify(\y2)}
  \text{ty2=texmath(\y2)}
  \function{fder=3*(\a)*x^2+2*(\b)*x + (\c)}
  \rational{y1der=evalue(\fder,x=\sing1)}
  \rational{y2der=evalue(\fder,x=\sing2)}
  \function{y1der=simplify(\y1der)}
  \text{ty1der=texmath(\y1der)}
  \function{y2der=simplify(\y2der)}
  \text{ty2der=texmath(\y2der)}
  \text{eq2=texmath(\y1der=3*(\sing1)^2*a+2*(\sing1)*b + c)}
  \text{eq3=texmath(\y2der=3*(\sing2)^2*a+2*(\sing2)*b + c)}
  \text{eq1=texmath(\y1=(\sing1)^3*a+(\sing1)^2*b+(\sing1)*c)}
  \text{ft= a x^3+ b x^2 +c x}
}{
  \integer{a=random(1..5)*random(-1,1)}
  \rational{b=randint(1..5)*randint(-1,1)}
  \rational{c=randint(1..5)*randint(-1,1)}
  \function{f=\a*(x)^2 + (\b)*x+ (\c)}
  \function{y1=wims(mathsubst x=\sing1 in \f)}
  \function{y1=simplify(\y1)}
  \text{ty1=texmath(\y1)}
  \rational{y2=evalue(\f,x=\sing2)}
  \function{y2=simplify(\y2)}
  \text{ty2=texmath(\y2)}
  \function{fder=2*(\a)*x+(\b)}
  \rational{y1der=evalue(\fder,x=\sing1)}
  \rational{y2der=evalue(\fder,x=\sing2)}
  \rational{y1der=simplify(\y1der)}
  \text{ty1der=texmath(\y1der)}
  \rational{y2der=simplify(\y2der)}
  \text{ty2der=texmath(\y2der)}
  \text{eq2=texmath(\y1der=2*(\sing1)*a+b )}
  \text{eq3=texmath(\y2der=2*(\sing2)*a+b)}
  \text{eq1=texmath(\y1=(\sing1)^2*a+(\sing1)*b+c)}
  \text{ft=a x^2+ b x +c }
}

\text{listerep = \sing1,\sing2,\y1,\y1der,\y2der}
\text{listerep=wims(listuniq \listerep)}
\text{listemenu= f,f'}
\integer{cc=\cas=1?\c:\d}
\text{size=80x50x1}
\statement{Soit la fonction \(f) définie sur <span class="nowrap">\(\,\RR),</span> de la forme&nbsp;: <span class="nowrap">\(f(x) = \ft).</span>

\if{\step=2}{
<p>
On sait que <span class="nowrap">\(f(\sing1)=\y1)&nbsp;;</span>
\(f'(\sing1) = \ty1der) et <span class="nowrap">\(f'(\sing2) = \ty2der).</span><br>
<b>Calculer <span class="nowrap">\(a),</span> \(b) et <span class="nowrap">\(c).</span></b></p>}

\if{\step=1}{<p>Interpréter les renseignements suivants
concernant la courbe représentative de <span class="nowrap">\(f)&nbsp;:</span></p>
<ul><li>
<b><i>La courbe passe par \(A (\sing1 ; \y1))</i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply10} ( \embed{reply1,\size} ) = \embed{reply2,\size}
</div></li>
<li><b><i>La tangente au point d'abscisse (\sing1) a pour coefficient directeur (\ty1der)</i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply11}( \embed{reply3} ) = \embed{reply4}</div></li>
<li><b><i>La tangente au point d'abscisse (\sing2) a pour coefficient directeur (\ty2der) </i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply12}( \embed{reply5} ) = \embed{reply6}</div></li>
</ul>
}

\if{\step=2}{
<div class="wimscenter"><label for="reply7">\(a) =</label> \embed{reply7,7} ;
<label for="reply8">\(b) =</label> \embed{reply8,7} ;
<label for="reply9">\(c) =</label> \embed{reply9,7}</div>
}}

\hint{
 \if{\step=1}{
 La courbe représentant la fonction \(f)
<b>passe par</b> les points \(M(x;y)) qui vérifient <b><span class="nowrap">\(y = f(x)).</span></b>
<p>
<b>\(f'(x))</b> est le <b>coefficient directeur de la tangente</b>
à la courbe au point <b> d'abscisse <span class="nowrap">\(x\).</span></b></p>
  }

 \if{\step=2}
 {Calculer d'abord <b>\(f'(x))</b> en dérivant <span class="nowrap">\(f(x) = \ft).</span>
<p>Exprimer ensuite les trois conditions <b>(\(f(\sing1) = \y1) ;
\(f'(\sing1)=\ty1der) et \(f'(\sing2) = \ty2der))</b> en utilisant les expressions
de \(f(x)) et <span class="nowrap">\(f'(x)).</span></p>
Vous obtenez ainsi un système de trois équations à trois inconnues
(<span class="nowrap">\(a),</span> \(b) et \(c)). Bien le regarder pour choisir
la méthode la plus simple pour le résoudre.
 }

}

\answer{}{\sing1;\listerep}{type = clickfill}
\answer{}{\y1;\listerep}{type = clickfill}
\answer{}{\sing1;\listerep}{type = clickfill}
\answer{}{\y1der;\listerep}{type = clickfill}
\answer{}{\sing2;\listerep}{type = clickfill}
\answer{}{\y2der;\listerep}{type = clickfill}



\answer{\(a)}{\a}{type=numeric}
\answer{\(b)}{\b}{type=numeric}
\answer{\(c)}{\c}{type=numeric}

\answer{}{1;\listemenu}{type=menu}
\answer{}{2;\listemenu}{type=menu}
\answer{}{2;\listemenu}{type=menu}

\solution{ On résout le système&nbsp;:
<div class="wimscenter">
\(\left \lbrace \begin{array}{c} \eq1\\ \eq2 \\ \eq3 \end{array})
</div>}
