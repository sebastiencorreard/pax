\title{Fonction donnée par 2 points et une tangente}
\language{fr}
\range{-5..5}
\keywords{tangent}
\author{Régine, Mangeard} d'après un exercice de Chantal Causse
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\steps{reply1,reply2,reply3,reply4,reply5,reply6,reply10,reply11,reply12
reply7,reply8,reply9}

\text{infg=\(-\infty)}
\text{infd=\(+\infty)}
\text{empt=\(\emptyset)}
\text{ptvirg=&#59;}

\integer{a=random(1..5)*random(-1,1)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\text{choix=wims(replace internal A by 1,2 in \confparm1)}
\text{choix=wims(replace internal B by 3 in \choix)}
\text{choix=wims(replace internal C by 4,5,6 in \choix)}
\integer{n = random(\choix)}
Si rien n'a été selectionné
\integer{ n = \n notwordof 1 2 3 4 5 6 ? random(1..6)}

\function{f=item(\n,\a*(x)^2 + \b*x + \c,
\a*x^3 + \b*(x)^2 + \c*x,
\b*x + \c + \a/(x + 1),
\b*x + \c + \a*sqrt(x + 1),\a*sqrt(x) + \b*x + \c,\a*sqrt(2*x + 1) + \b*x + \c)}
\text{ft=item(\n,a x^2 + b x + c,a x^3 + b x^2 + c x,a/(x + 1) + b x + c,a*sqrt(x + 1) + b x + c,
a*sqrt(x) + b x + c,a*sqrt(2*x + 1) + b x + c)}
\text{deflist=\(\,\RR), \(\,\RR), \(\RR \setminus)&#123;-1&#125;, &#91;-1\ptvirg \infd &#91;,\(\RR^+),&#91;-1/2\ptvirg \infd &#91;}
\text{defdom=\deflist[\n]}
\text{ft=texmath(\ft)}
\integer{x0=item(\n,0,1,0,0,1,0)}
\integer{x1=item(\n,random(-1,1)*random(1,2),random(-2,-1,2),random(-3,-2,1,2),random(1,2,3),random(2,3,4,8,9),random(1,2,3,4))}
\function{fp=diff(\f,x)}

\function{y0=wims(mathsubst x=\x0 in \f)}
\function{y0=simplify(\y0)}
\function{y1=wims(mathsubst x=\x1 in \f)}
\function{y1=simplify(\y1)}
\function{y1=wims(replace internal sqrt(4) by 2 in \y1)}
\function{y1=wims(replace internal sqrt(8) by 2*sqrt(2) in \y1)}
\function{y1=wims(replace internal sqrt(9) by 3 in \y1)}
\function{y1=maxima(expand((\y1)))}
\function{y1=wims(replace internal log by ln in \y1)}
\text{ty1=texmath(\y1)}

\real{xmin=min(min(\x0-2,\x1-1),-1)}
\real{xmax=max(max(\x0+2,\x1+1),1)}
\real{ymin=min(min(\y0-1,\y1-1),-1)}
\real{ymax=max(max(\y0+1,\y1+1),1)}

\function{yp0=wims(mathsubst x=\x0 in \fp)}
ou function{yp0=evalue( \fp,x=\x0)}
\function{yp0=simplify(\yp0)}


\real{ymin= \y0-\yp0 < \ymin+1 and \y0 + \yp0>\ymax-1 ? \y0-\yp0 -1 : \ymin}
\real{ymin= \y0+\yp0 < \ymin + 1 and \y0-\yp0>\ymax-1 ? \y0 + \yp0 -1 : \ymin}

\real{ymin= \ymax-\ymin > 40 ? \ymin-1}

\real{xt= \y0-\yp0 >\ymin and \y0-\yp0<\ymax ? \x0-1 : \x0+1}
\real{yt= \y0-\yp0 >\ymin and \y0-\yp0<\ymax ? \y0-\yp0 : \y0+\yp0}

\text{aidetg= abs(\yp0)>8 or (abs(\yp0)> 3 and \ymax-\ymin >25) ?
fcircle \xt,\yt,5, red
dsegment 0,\yt,\xt,\yt,red
text red , 0.1 , \yt, medium,\yt}

\text{aideb= floor(\y1)<>\y1 or \ymax - \ymin > 25?
text blue, 0.1,\y1,medium,\y1
dsegment 0,\y1,\x1,\y1,blue
}

\text{aidea= \ymax - \ymin >25 ?
dsegment 0,\y0,\x0,\y0,blue
text blue, 0.1,\y0,medium,\y0
}

\integer{ymi=floor(\ymin)}
\integer{yma=floor(\ymax)+1}

\text{listerep1 = \(\x0),\(\x1),\(\y0),\(\ty1),\(\yp0),\(0)}
\text{listerep=wims(listuniq \listerep1)}
\text{listemenu= f,f'}

\text{size=80x40x1}

\statement{
La courbe bleue ci-dessous représente une fonction
\(f) définie sur \defdom de la forme&nbsp;: \(f(x) = \ft).
<br>
\if{\step=2}{On sait que <span class="nowrap">\(f(\x0)=\y0)&nbsp;;</span> \(f(\x1) = \ty1) et <span class="nowrap">\(f'(\x0) = \yp0).</span>
<p><b>Calculer <span class="nowrap">\(a),</span> \(b) et <span class="nowrap">\(c).</span></b></p>}
<div>
\draw{500,300}{
  xrange \xmin, \xmax
  yrange \ymin,\ymax
  parallel \xmin,\ymi,\xmin,\yma,1,0,\xmax - \xmin +1,grey
  parallel \xmin,\ymi,\xmax,\ymi,0,1,\yma -\ymi +1,grey
  hline 0,0,black
  arrow 0,0,1,0,6,black
  arrow 0,0,0,1,6,black
  vline 0,0,black
plot blue, \f
fcircle \x0,\y0,7, green
fcircle \x1,\y1,7 , green
plot green, \y0+(x-\x0)*\yp0
text black,\x0,\y0,medium,A
text black,\x1,\y1,medium,B
\aideb
 }
 </div>

\if{\step=1}{<p>Interpréter les renseignements tirés de l'observation de la courbe&nbsp;:
</p>
<ul><li>
<b><i>La courbe passe par \(A (\x0 ; \y0))</i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply10} ( \embed{reply1,\size} ) =
\embed{reply2,\size}</div></li>
<li><b><i>La courbe passe par \(B (\x1 ; \ty1))</i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply11}( \embed{reply3} ) = \embed{reply4}</div></li>
<li><b><i>La tangente tracée en vert a comme coefficient directeur
\yp0</i></b> se traduit par&nbsp;:
<div class="wimscenter">\embed{reply12}( \embed{reply5} ) = \embed{reply6}</div></li>
</ul>
}

\if{\step=2}{
<div class="wimscenter">\(a) = \embed{reply7,7} ;
\(b) = \embed{reply8,7} ;
\(c) = \embed{reply9,7}</div>
}}

\hint{
 \if{\step=1}{La courbe représentant la fonction \(f)
<b> passe par </b> les points \(M(x;y)) qui vérifient <b><span class="nowrap">\(y = f(x)).</span></b>
<p>
<b>\(f'(x))</b> est le <b>coefficient directeur de la tangente</b>
à la courbe au point <b> d'abscisse <span class="nowrap">\(x\).</span></b>
</p><p>
N'oubliez pas de regarder <b>en quel point</b> la droite verte
est <b>tangente</b> à la courbe.
</p>}

 \if{\step=2}{Calculer d'abord <b>\(f'(x))</b> en dérivant <span class="nowrap">\(f(x) = \ft).</span>
   \if{\n=3}{On rappelle que la dérivée de \(\frac{1}{u}) est
\(\frac{-u'}{u^2})et que la dérivée de \(\frac{u}{v}) est
\(\frac{u'v-uv'}{v^2}) }
   \if{\n>3}{On rappelle que la dérivée de \(sqrt(u)) est \(\frac{u'}{2\sqrt(u)}) }
<p>Exprimer ensuite les trois conditions <b>(\(f(\x0) = \y0) ;
\(f(\x1)=\ty1) et \(f'(\x0) = \yp0))</b> en utilisant les expressions
de \(f(x)) et <span class="nowrap">\(f'(x)).</span></p>
Vous obtenez ainsi un système de trois équations à trois inconnues
(<span class="nowrap">\(a),</span> \(b) et \(c)). Bien le regarder pour choisir la méthode
la plus simple pour le résoudre.
  }
}

\answer{}{\(\x0);\listerep}{type = clickfill}
\answer{}{\(\y0);\listerep}{type = clickfill}
\answer{}{\(\x1);\listerep}{type = clickfill}
\answer{}{\(\ty1);\listerep}{type = clickfill}
\answer{}{\(\x0);\listerep}{type = clickfill}
\answer{}{\(\yp0);\listerep}{type = clickfill}



\answer{\(a)}{\a}{type=numeric}
\answer{\(b)}{\b}{type=numeric}
\answer{\(c)}{\c}{type=numeric}

\answer{}{1;\listemenu}{type=menu}
\answer{}{1;\listemenu}{type=menu}
\answer{}{2;\listemenu}{type=menu}
