\title{Taux de variation d'une fonction entre a et b}
\author{Bruno,Mifsud}
\email{bmifsud@ac-aix-marseille.fr}

%%%%% version 21 10 14 %%%%%%%%%%%%
\integer{a=randint(-6..6)}
\integer{b=\a+randint(1..6)}
\integer{c=randint(-8..8)}
\integer{d=randint(-8..8)}
\function{f=maxima(expand((x-\c[1])*(\d[1]-x)))}
\function{f=pari(\f)}

\rational{rep=((\b-\c[1])*(\d[1]-\b)-(\a-\c[1])*(\d[1]-\a))/(\b-\a)}
%%% Pour solution %%%%
\integer{fa=(\a-\c[1])*(\d[1]-\a)}
\integer{fb=(\b-\c[1])*(\d[1]-\b)}
\integer{diffba=\b-\a}

\statement{On considère la fonction \(f) définie sur \(\mathbb{R}\) par <span class="nowrap">\(f(x)=\f).</span><br>
Déterminez le taux de variation de \(f) entre les points d'abscisse \(\a) et <span class="nowrap">\(\b).</span>
<div class="wims_question"><label for="reply1">Le taux de variation&nbsp;:</label> \embed{r1}</div>
}
\answer{}{\rep}{type=numexp}

\solution{<p>Pour calculer le taux de variation de la fonction \(f) entre \(a) et <span class="nowrap">\(b),</span>
 on utilise la formule&nbsp;: <span class="nowrap">\((f(b)-f(a))/(b-a)).</span></p>

 <ul class="wims_nopuce">
 <li> Ici :
 <div class="unbreakable">
  \(f(a)=f(\a)\)<br>
  \(\phantom{f(a)}=\fa\) <br>
  \(f(b)=f(\b)\)<br>
  \(\phantom{f(b)}=\fb\) <br>
  et \(b-a=\diffba\)</li>
 <li> Donc le taux de variation de \(f\) entre \(\a\) et \(\b\) vaut&nbsp;: \(\rep)
</li></ul>}
