\title{Tangentes passant par 1 point avec étape}
\author{Marie-Claude,David;Ophélie,Rouby}
\email{ophelie.rouby@universite-paris-saclay.fr}

\language{fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{tangent}
\integer{a=randint(1..5)*randitem(-1,1)}
\integer{b=randint(1..5)}
\integer{c=randint(1..5)}
\text{flist=x^2, \a*x^2, \a/x, \a/(x-\b),\a/(x+\b),\a*x^2 + \b*x,\a*x^2 - \b*x, \a*x^2 + \b*x + \c,\a*x^2 - \b*x + \c, \a*x^2 +\b*x -\c, \a*x^2 -\b*x -\c}
\text{deflist=\(\,\RR), \(\,\RR), \(\,\RR^*), \(\RR \setminus \left\lbrace \b \right\rbrace\),\(\RR \setminus\left\lbrace -\b\right\rbrace\),\(\RR) ,\(\,\RR),\(\,\RR),\(\,\RR),\(\,\RR), \(\,\RR)}
\integer{nbf=items(\flist)}
\integer{n=randint(1..\nbf)}
\function{f=item(\n,\flist)}
\text{defdom=\deflist[\n]}
\text{ft=item(\n,x^2, \a x^2, \frac{\a}{x}, \frac{\a}{x-\b},\frac{\a}{x+\b},\a x^2 + \b x,\a x^2 - \b x,\a x^2 + \b x + \c,\a x^2 - \b x + \c,\a x^2 + \b x - \c,\a x^2 - \b x - \c)}
\integer{x0=randint(-3..3)}
\if{\n=3 and \x0=0}{\integer{x0=randint(1..3)*randitem(1,-1)}}
\if{\n=4 and \x0=\b}{\integer{x0=\x0+1}}
\if{\n=5 and \x0=-\b}{\integer{x0=\x0+1}}
\function{fp=diff(\f,x)}
\rational{nder=evalue(\fp,x=\x0)}
\function{y0=wims(mathsubst x=(\x0) in \f)}
\function{y0=simplify(\y0)}
## tangente
\text{eqtgte=simplify(y= \nder*(x-(\x0))+(\y0))}
\function{tg= \nder*(x-(\x0))+(\y0)}
## choix d'un autre point sur la tangente
\integer{x1=\x0+randint(2..5)*randitem(1,-1)}
\if{\n=3 and \x1=0}{\integer{x1=randint(4..6)}}
\if{\n=4 and \x1=\b}{\integer{x1=randint(\b+3..9)}}
\if{\n=5 and \x1=-\b}{\integer{x1=-9}}
\rational{y1=evalue(\tg,x=\x1)}
\rational{x1= \y1=0?\x1+1}
\rational{y1=evalue(\tg,x=\x1)}
\if{\n isitemof 3,4,5}{
  %pour éviter le pôle
  \rational{v=2*evalue(\f,x=\x0)}
  \if{\y1=\v}{
    \integer{x1=\x1+1}
    \rational{y1=evalue(\tg,x=\x1)}
  }
}
## rédaction d'une solution:
\text{fp0=wims(mathsubst x=a in \fp)}
\text{f0=wims(mathsubst x=a in \f)}
\text{eqsol1=(\fp0)*(x - a)+ (\f0)}
\text{eqsol2=wims(mathsubst x=\x1 in \eqsol1) -(\y1)}
\text{eqsol3=wims(mathsubst a=x in \eqsol2)}
\text{eqsol4=maxima(expand((\eqsol3));)}
\text{eqsol5=maxima(factor((\eqsol4));)}
\text{solist=pari(nfroots(,numerator(\eqsol5)))}
\text{sol1=\solist[1]}
\text{sol2=\solist[2]}
\text{eqsol3=wims(mathsubst x=a in \eqsol4)}
\text{eqsol5=wims(mathsubst x=a in \eqsol5)}
\rational{xp0=\sol1=\x0?\sol2:\sol1}
\function{yp0=wims(mathsubst x=(\xp0) in \f)}
\function{yp0=simplify(\yp0)}
\rational{nderp=evalue(\fp,x=\xp0)}
\text{eqtgtep=simplify(y= \nderp*(x-(\xp0))+(\yp0))}







\rational{rep1=\xp0<\x0?\xp0:\x0}
\rational{rep2=\xp0<\x0?\x0:\xp0}
\text{eq1=\xp0<\x0?\eqtgtep:\eqtgte}
\text{eq2=\xp0<\x0?\eqtgte:\eqtgtep}

\text{fp=texmath(\fp)}
\text{name_statement=Soit la fonction \(f\) définie sur
  <span class="nowrap">\defdom</span> par&nbsp;:
  \(f(x)=\ft\) et soit le point }
\text{name_header=Équation,Abscisse}
\text{STEP=r2,r4
r1,r3}
\steps{\STEP}
\text{name_feed=Attention&nbsp;: Vous n'avez pas respecté l'ordre demandé
  pour les abscisses.}
\statement{<i>Cet exercice comporte deux étapes.</i>
  <p>\name_statement <span class="nowrap">\(A(\x1;\y1)\).</span></p>
  \if{ \step=1 }{<div class="wims_question">1. Déterminer les abscisses \(x_1\) et \(x_2\)
  des points de la courbe représentative de \(f\) tels que la tangente en ces points passe par
  \(A\).
  On note \(x_1\) la plus petite abscisse.
  <div class="wimscenter"><label for="reply2">\(x_1\)</label>=\embed{reply2}
  et <label for="reply4">\(x_2\)</label>=\embed{reply4}</div></div>}
  \if{ \step=2 }{
  <p><span class="oef_indgood">Bonne réponse&nbsp;!</span>
    Les tangentes à la courbe représentative de \(f\) aux points d'abscisse
  \(x_1=\rep1\) et \(x_2=\rep2\) passent par \(A\).</p>
  <div class="wims_question">2.
    Déterminer les équations réduites des deux tangentes à la courbe représentative
    de \(f\) passant par A :
  <ul>
  <li><label for="reply1">Équation de la tangente au point d'abscisse \(x_1=\rep1\) :</label>
   \embed{reply1}
  </li>
  <li><label for="reply3">Équation de la tangente au point d'abscisse \(x_2=\rep2\) :</label>
   \embed{reply3}
  </li></ul></div>}
}
\answer{\name_header[1]}{\eq1,x}{type=equation}
\answer{\name_header[2]}{\rep1}{type=numexp}{option=noreduction}
\answer{\name_header[1]}{\eq2,x}{type=equation}
\answer{\name_header[2]}{\rep2}{type=numexp}{option=noreduction}
\text{test=\reply2=\rep2 and \reply4=\rep1? 1: 0}
\feedback{\test=1}{\name_feed}
\solution{Pour tout \(x\) dans \defdom,
  la dérivée de \(f\) en \(x\) est&nbsp;: <span class="nowrap">\(f'(x)=\fp\).</span>
  L'équation générale de la tangente au point \((a,f(a))\) est &nbsp;:
  <div class="wimscenter">\(y=f'(a)(x - a)+f(a)\)</div>
  ici,
  <div class="wimscenter">\(y=\eqsol1\).</div>
  On remplace \(x\) et \(y\) par les coordonnées \((\x1;\y1)\) de \(A\).
  Les solutions de l'équation en \(a\) obtenue sont les abscisses
  \(x_1\) et \(x_2\) des points
  de la courbe où la tangente passe par \(A\).
  On résout l'équation
  <p class="wimscenter">
  \(\eqsol2=0) \(\iff)
  \(\eqsol3=0) \(\iff)
  \(\eqsol5=0)</p>
 La tangente à la courbe au point d'abscisse \(x_1=\rep1\) a pour équation
 <span class="nowrap">\(\eq1)</span>,
 celle au point d'abscisse \(x_2=\rep2\) a pour équation
 <span class="nowrap">\(\eq2).</span>
}
