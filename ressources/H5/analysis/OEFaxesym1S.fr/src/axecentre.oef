\title{Axe et centre de symétrie}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\integer{a=randint(2..8)*randint(1,-1)}
\integer{b=\a+randint(2..8)*randint(1,-1)}
\integer{b2=2*\b}
\text{s=\b<0?-:+}
\text{s2=\b<0?+:-}
\integer{bb=\b>0?\b:-\b}
\text{ta=\a}
\text{tb=\bb}
\integer{ma=-\a}
\text{tma=\ma}
\text{eqx=texmath(x-\a=0)}

\text{data=un <span style="color:red">centre</span> de symétrie de coordonnées \((\a;\b)),texmath(x+\a),2,texmath(x-\a),3,texmath(\a-x),2,texmath(x+\b),3,
un <span style="color:red">axe</span> de symétrie d'équation \(\eqx),texmath(x+\a),1,texmath(x-\a),3,texmath(\a-x),1,texmath(x+\b),3,
un <span style="color:red">centre</span> de symétrie de coordonnées \((\a;\b)),texmath(x+\a),3,texmath(x-\a),2,texmath(\a-x),2,texmath(x+\b),3,
un <span style="color:red">axe</span> de symétrie d'équation \(\eqx),texmath(x+\a),3,texmath(x-\a),1,texmath(\a-x),1,texmath(x+\b),3
}
\integer{k=randint(1..4)}
\text{cedata=row(\k,\data)}
\text{intro=\cedata[1]}
\integer{n=items(\cedata)}
\integer{i=randint(1..(\n-1)/2)}
\text{comp=\cedata[2*\i]}
\integer{rep=\cedata[2*\i+1]}
\if{\k<3}{
  \text{suite=pour tout \(\comp \in \mathcal{D}_f)}
  \text{quest=g(x)=f}
 }{
  \text{suite= pour tout \(x \in \mathcal{D}_f)}
  \text{quest=f(x)=g}
}
\statement{
Soit \(f) une fonction définie sur un domaine \(\mathcal{D}_f),
 telle que sa courbe représentative \(\mathcal{C}_f) dans un repère
 orthonormé \((O;\vec{i};\vec{j})) présente \intro.
<p>Alors la fonction \(g) définie par:</p>
<div class="wimscenter"> \(\quest(\comp)) \suite</div>
est
\embed{reply1}.
}
\answer{Bonne réponse}{\rep;paire,impaire,ni paire ni impaire}{type=radio}{option=shuffle}
