\integer{a=randint(2..8)*randint(1,-1)}
\integer{b=randint(2..8)*randint(1,-1)}
\integer{b2=2*\b}
\text{s=\b<0?-:+}
\text{s2=\b<0?+:-}
\integer{bb=\b>0?\b:-\b}
