tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(2*$val7)]

!ifval $val7<0
val9=-
!else
val9=+
!endif

!ifval $val7<0
val10=+
!else
val10=-
!endif

!ifval $val7>0
val11=$[rint($val7)]
!else
val11=$[rint(-$val7)]
!endif
val12=$val6
val13=$val11
val14=$[rint(-$val6)]
val15=$val14
tmp0=!texmath x-$val6=0

val16=$(tmp0)
val17=un <span style="color:red">centre</span> de symétrie de coordonnées \(($val6;$val7)),\(f($val6+x)+f($val6-x)=$val8),\(f($val6+x)-f($val6-x)=$val8),\(f(x+$val6)+f(x-$val6)=$val8),\(f(x+$val6)-f(x-$val6)=$val8),	un <span style="color:red">axe</span> de symétrie d'équation \($val16),\(f($val6-x)=f($val6+x)),\(f(x+$val6)=f(x-$val6)),\(f(x+$val6)+f(x-$val6)=0),\(f($val6+x)+f($val6-x)=0),	un <span style="color:red">centre</span> de symétrie de coordonnées \(($val6;$val7)),\(\vec{u}=$val12\vec{i} $val9 $val13\vec{j}),\(\vec{u}=$val15\vec{i} $val9 $val13\vec{j}),\(\vec{u}=$val15\vec{i} $val10 $val13\vec{j}),\(\vec{u}=$val12\vec{i} $val10 $val13\vec{j})	un <span style="color:red">axe</span> de symétrie d'équation \($val16),\(\vec{u}=$val12\vec{i}), \(\vec{u}=$val15\vec{j}),\(\vec{u}=$val15\vec{i}),\( \vec{u}=$val12\vec{j})
tmp0=!randint 1, 4

val18=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val17

tmp=!row $val18 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
val20=$(val19[1])
tmp0=!item 2 to 5 of $val19

val21=$(tmp0)
!if $val18<3 
val22=pour tout \(x \in \mathcal{D}_f), on a:
