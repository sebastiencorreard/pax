!set title=Axe et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($val6+$(tmp0)*$(tmp1))]
val8=$[rint(2*$val7)]

!ifval $val7<0
val9=-
!else
val9=+
!endif

!ifval $val7<0
val10=+
!else
val10=-
!endif

!ifval $val7>0
val11=$[rint($val7)]
!else
val11=$[rint(-$val7)]
!endif
val12=$val6
val13=$val11
val14=$[rint(-$val6)]
val15=$val14
tmp0=!texmath x-$val6=0

val16=$(tmp0)
tmp0=!texmath x+$val6

tmp1=!texmath x-$val6

tmp2=!texmath $val6-x

tmp3=!texmath x+$val7

tmp4=!texmath x+$val6

tmp5=!texmath x-$val6

tmp6=!texmath $val6-x

tmp7=!texmath x+$val7

tmp8=!texmath x+$val6

tmp9=!texmath x-$val6

tmp10=!texmath $val6-x

tmp11=!texmath x+$val7

tmp12=!texmath x+$val6

tmp13=!texmath x-$val6

tmp14=!texmath $val6-x

tmp15=!texmath x+$val7

val17=un <span style="color:red">centre</span> de symétrie de coordonnées \(($val6;$val7)),$(tmp0),2,$(tmp1),3,$(tmp2),2,$(tmp3),3,	un <span style="color:red">axe</span> de symétrie d'équation \($val16),$(tmp4),1,$(tmp5),3,$(tmp6),1,$(tmp7),3,	un <span style="color:red">centre</span> de symétrie de coordonnées \(($val6;$val7)),$(tmp8),3,$(tmp9),2,$(tmp10),2,$(tmp11),3,	un <span style="color:red">axe</span> de symétrie d'équation \($val16),$(tmp12),3,$(tmp13),1,$(tmp14),1,$(tmp15),3	
tmp0=!randint 1, 4

val18=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val17

tmp=!row $val18 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
val20=$(val19[1])
tmp0=!itemcnt $val19

val21=$[rint($(tmp0))]
tmp0=!randint 1, ($val21-1)/2

val22=$[rint($(tmp0))]
val23=$(val19[2*$val22])
val24=$[rint($(val19[2*$val22+1]))]
!if $val18<3 
val25=pour tout \($val23 \in \mathcal{D}_f)
val26=g(x)=f
!else
val25=pour tout \(x \in \mathcal{D}_f)
val26=f(x)=g
!endif
replytype1=radio
replyoption1=shuffle 
replyname1=Bonne réponse
replygood1=$val24;paire,impaire,ni paire ni impaire
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Soit 
!insmath f
$() une fonction définie sur un domaine 
!insmath \mathcal{D}_f
$(),	 telle que sa courbe représentative 
!insmath \mathcal{C}_f
$() dans un repère	 orthonormé 
!insmath (O;\vec{i};\vec{j})
$() présente $val20.	<p>Alors la fonction 
!insmath g
$() définie par:</p>	<div class="wimscenter"> 
!insmath $val26($val23)
$() $val25</div>	est	 
!read oef/embed.phtml reply1 
$().	
$()
!exit

