!set title=Choix d'une fonction associée à x^2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=c
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
val9=!rawmath x^2

!ifval $val8=1 
val10= x^2 +$val7 
!else
val10= ( x + $val7)^2
!endif

!ifval $val8=2 
val11= x^2 +$val7 
!else
val11= ( x + $val7)^2
!endif
val10=!rawmath $val10
val11=!rawmath $val11
val12=!rawmath x^2 - $val7
val13=!rawmath (x-$val7)^2
val14=$[rint(0)]
val15=$[rint(-5)]
val16=$[rint(5)]

!ifval $val8=1 
val17=$[rint( -0.2 )]
!else
val17=$[rint( -$val7)]
!endif

!ifval $val8=1 
val18=$[rint( 0 )]
!else
val18=$[rint( -$val7)]
!endif

!ifval $val8=1 
val19=$[rint( $val7 )]
!else
val19=$[rint( 0)]
!endif

!ifval $val8=1 
val20=$[rint( $val7 )]
!else
val20=$[rint( -$val7)]
!endif
val21=La courbe rouge est l'image de celle de la fonction carré par une translation et son sommet est $val18,$val19
val22=xrange -5,5	yrange $val15,$val16	linewidth 1	parallel -5,$val15,-5,$val16,1,0,11,$val6	linewidth 1	parallel -5,$val15,5,$val15,0,1,11,blue	linewidth 3	arrow 0,$val15,0,$val16,10,black	arrow -8,0,8,0,10,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.3,-0.3,giant,i	text red,-0.5,0.7,giant,j	text black,-0.2,-0.1,giant,O	text black,$val17,$val19,giant,$val20	linewidth 3	plot blue,$val9	plot red,$val10	
!readproc oef/draw.phtml 400,400 \
$val22 
tmp0=$ins_url
val23=$(tmp0)
val24=\($val10),\($val13),\($val12),\($val11)
val25=Ajouter une constante \(k) à \($val9) translate sa courbe de	<ul>	 <li> \(k) unités vers le haut si \(k) est positif </li>	 <li>\(-k) unités vers le bas si \(k) est négatif.</li>	</ul>	Remplacer \(x) par (\(x + k)) dans \($val9) translate sa courbe de	<ul>	 <li> \(k) unités vers la gauche si \(k) est positif </li>	 <li>\(-k) unités vers la droite si \(k) est négatif.</li>	</ul>

!ifval $val7>0 
val26=$[rint( $val7)]
!else
val26=$[rint( -$val7)]
!endif

!ifval ($val7)^2>1 
val27= unités 
!else
val27= unité
!endif

!ifval $val7>0 
val28= $val26 $val27 vers le haut
!else
val28=$val26 $val27 vers le bas
!endif

!ifval $val7>0 
val29= $val26 $val27 vers la gauche
!else
val29=$val26 $val27 vers la droite
!endif

!ifval $val8 = 1 
val27= $val28 
!else
val27= $val29
!endif
val27=La courbe cherchée est celle de la fonction carré translatée de $val27 donc elle a pour équation \(y) = \($val10).
choiceoption1=shuffle 
choicename1=\(f(x)) =
choicegood1=\($val10)
choicebad1=$val24
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val25

solution=!nosubst $val27


!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	 <img src="$val23" alt="$val21"></div>	 <div class="medium_size text_col">	  Dans le plan muni d'un repère orthogonal 
!insmath (O,i,j)
$(),	  on a tracé la courbe représentative de la fonction carré (en bleu) et	  d'une fonction 
!insmath f
$() en rouge.<br>	  Par lecture graphique déterminer l'expression de 
!insmath f
$().	</div>	</div>		
$()
!exit

:hint
$()$val25
$()
!exit

:help
$()
$()
!exit

:solution
$()$val27
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=21,23,25,27
embedcnt=0
