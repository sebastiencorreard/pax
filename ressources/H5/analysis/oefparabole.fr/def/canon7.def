!set title=Forme canonique d'un trinôme par identification
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=rbelloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 2, 7

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, -1,1..10

val7=$[rint($(tmp0))]
tmp0=!randint -50, 50

val8=$[rint($(tmp0))]
val9=$[rint(2*$val7)]
val10=$[rint(-$val6*$val9)]
val11=$[rint(($val7)^2)]
val12=$[rint($val6*$val11)]
val13=$[rint($val12+$val8)]
!if \c0<0 
val14=&nbsp;
!else
val14=+
!endif
val15=!rawmath $val6*(x-$val7)^2+$val8
val16=!rawmath $val6*x^2+$val10*x+$val13
val17=$val6 x^2 + $val10 x $val14 $val13
val18=!rawmath a*(x-d)^2+k
val19=!rawmath a*x^2-2*a*d*x+a*d^2+k
val20=!rawmath a*d^2+k
val21=!rawmath -2*a*d
val22=&#40;
val23=&#41;
oefsteps=reply1,reply2,reply3	reply4,reply5,reply6	reply7,reply8,reply9,reply10 
nextstep=!nosubst reply1,reply2,reply3	reply4,reply5,reply6	reply7,reply8,reply9,reply10 
!readproc oef/steps.proc
replytype1=algexp
replyname1=Coefficient de \(x^2\)
replygood1=a
replytype2=algexp
replyname2=Coefficient de \(x\)
replygood2=$val21
replytype3=algexp
replyname3=Terme constant
replygood3=$val20
replytype4=numeric
replyname4=Coefficient d \(x^2\)
replygood4=$[$val6]
replytype5=numeric
replyname5=Coefficient d \(x\)
replygood5=$[$val10]
replytype6=numeric
replyname6=Terme constant
replygood6=$[$val13]
replytype7=numeric
replyname7=d
replygood7=$[$val7]
replytype8=numeric
replyname8=d
replygood8=$[$val7]
replytype9=numeric
replyname9=k
replygood9=$[$val8]
replytype10=algexp
replyname10=Forme canonique
replygood10=$val15
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>On considère le trinôme 
!insmath f(x)=$val16
$().</p>	<p>On cherche à obtenir sa forme canonique par identification.</p>	
!if $m_step=1 
$()	<p>Développer :</p>	<div class="wimscenter">	<label for="reply1">
!insmath $val18
$()</label> =  
!read oef/embed.phtml reply1,10 
$() 
!insmath x^2
$() +  
!read oef/embed.phtml reply2,10 
$() 
!insmath x
$() +  
!read oef/embed.phtml reply3,10 
$()</div>	 
!endif
$()	
!if $m_step=2 
$()	<div class="wimscenter">
!insmath $val18=$val19
$()</div>	<p>Pour que 
!insmath $val19= $val16
$() pour tout réel 
!insmath x
$() de 
!insmath \ \RR
$(), il faut et il suffit que :</p>	 <div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\begin{cases}	  a &= reply4\\	  -2\times a\times d &= reply5\\	  a\times d^2+k &= reply6\end{cases}],5,noanswer	  reply4	  reply5	  reply6	   
$()	 
!endif
$()	
!if $m_step=3 
$()	<div class="wimscenter">
!insmath $val18=$val19
$()</div>	<p>Pour que 
!insmath $val19=$val16
$() pour tout réel 
!insmath x
$() de 
!insmath \ \RR
$(), il faut et il suffit que :</p>	<div class="wimscenter">	
!insmath \begin{cases}a=&$val6\\	  -2\times a \times d=&$val10\\	  a\times d^2+k&=$val13	\end{cases}
$()	</div>	Ce qui équivaut à	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\begin{cases}a&=$val6\\	  d&= reply7\\	  a\times d^2+k&=$val13\end{cases}],5, noanswer	  reply 7	 
$()	</div>	Finalement :	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\begin{cases}a&=$val6\\	  d&= reply8\\	  k&= reply9\end{cases}],5, noanswer	  reply 8	  reply 9	 
$()	</div>	<p>La forme canonique de 
!insmath $val16
$() est :</p>	<div class="wimscenter"><label for="reply10">
!insmath $val18=
$()</label>  
!read oef/embed.phtml reply10,15 
$().</div>	 
!endif
$()	
$()
!exit

:hint
$()<p>La forme canonique d'un trinôme est 
!insmath a(x-d)^2+k
$(), où 
!insmath d
$() et	
!insmath k
$() sont les abscisses et ordonnées du sommet de la parabole représentant le trinôme.	</p>	Pour déterminer la forme canonique, on peut	développer 
!insmath a(x-d)^2+k
$() à l'aide de :<br>	
!insmath (a+b)^2=a^2+2*a*b+b^2
$()<br>	
!insmath (a-b)^2=a^2-2*a*b+b^2
$().<br>	Puis trouver 
!insmath a
$(), 
!insmath d
$() et 
!insmath k
$() en résolvant un système de 3 équations à 3 inconnues.	
$()
!exit

:help
$()
$()
!exit

:solution
$()	On considère le trinôme 
!insmath f(x)=$val16
$().	<div class="wimscenter">
!insmath $val18=$val19
$()</div>		Le système :	<div class="wimscenter">	
!insmath \begin{cases} a&=$val6\\	 -2\times a \times d&=$val10\\	  a \times d^2+k&=$val13	\end{cases}	
$()	</div>	équivaut à :	<div class="wimscenter">	
!insmath \begin{cases}a&=$val6\\	d&=$val7\\	k&=$val8	\end{cases}
$()	</div>	La forme canonique de 
!insmath $val17
$() est : 
!insmath $val15
$().	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,13,15,16,17,18,19
embedcnt=7
