!set title=Jet d'eau
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 4,5

val6=$[rint($(tmp0))]
tmp0=!randitem 1,5

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=$[$val8/$val6]
val10=$[1+sqrt($val9)]
val11=1+sqrt($val9)
val12=1+sqrt($val8/$val6)
val13=!rawmath $val8-$val6*(x-1)^2
val14=!rawmath $val8-$val6*(x-1)^2+0*sqrt(x)+0*sqrt($val10-x)
val15=$[rint(400)]
val16=xrange -1,4.5	yrange -0.5,10.5		linewidth 3	arrow 0,0,0,10.5,10,black	arrow 0,0,4.5,0,10,black		text black,-0.5,0.2,medium,0	text black,-0.5,1.2,medium,1	text black,-0.5,2.2,medium,2	text black,-0.5,3.2,medium,3	text black,-0.5,4.2,medium,4	text black,-0.5,5.2,medium,5	text black,-0.5,6.2,medium,6	text black,-0.5,7.2,medium,7	text black,-0.5,8.2,medium,8	text black,-0.5,9.2,medium,9	text black,-0.7,10.2,medium,10		text black,1,-0.1,medium,1	text black,2,-0.1,medium,2	text black,3,-0.1,medium,3	segment 0,$val7,2,$val7,black	segment 1,$val7,1,$val8,black	text black,1.2,$val7+2,medium,$val6		text black,-0.8,4.5,medium,Mur	text black,2.8,0.5,medium,Est	linewidth 3	plot blue,$val14	
!readproc oef/draw.phtml $val15/3,$val15 \
$val16 
tmp0=$ins_url
val17=$(tmp0)
val18=Lorsqu'on se déplace sur la parabole à partir du sommet d'une unité horizontale l'ordonnée diminue de $val6
val19=<ul class="wims_nopuce"><li>La parabole a pour sommet S(1,$val8).</li> 
val19=$val19 <li>$val18 .</li>
val19=$val19 <li>Donc l'équation de la parabole est \(y=$val13).</li>
val19=$val19 <li>Le jet arrive au sol lorsque \($val13=0).</li>
val19=$val19 <li>Donc lorsque \((x-1)^2=$val8/$val6) avec \(x \gt 1).</li>
val19=$val19 <li>Donc \(x = 1 + \sqrt{$val8/$val6} \approx $val10).</li></ul>
replytype1=function
replyname1=\(f(x)) 
replygood1=!rawmath $val13
replytype2=algexp
replyname2=x_0
replygood2=$val11,$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=!nosubst  $val19


!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val17" alt="$val18"></div>	<div class="medium_size text_col">	<p>Une fontaine produit un jet d'eau parabolique qui sort du mur à $val7 dm du sol,	dirigé vers le haut et vers l'Est.</p><p>	La hauteur maximale du jet est $val8 dm, et est obtenue à 1 dm du mur.</p>	<ul><li>	<label for="reply1">Quelle est la hauteur d'une goutte d'eau en fonction de	sa distance 
!insmath x
$() du mur en m ?</label>	 
!read oef/embed.phtml reply1,20 
$().	</li><li>	<label for="reply2">A quelle distance du mur, le jet d'eau	arrive-t-il au sol (ordonnée 0) ?</label>  
!read oef/embed.phtml reply2,10 
$() m.	</li></ul>	<div class="wims_instruction">Pour écrire 
!insmath sqrt(n)
$() taper <span class="tt">sqrt(
!insmath n
$())</span>.	</div></div></div>		
$()
!exit

