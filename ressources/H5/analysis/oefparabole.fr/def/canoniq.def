 !exit
!endif

val6=1,6,5,7,8
val7=1,6,7,8,9
val8=julie.png,	geom.png,	tableau.png,	phonk.png,	inconnu.png,	graphe.png,	algebra.png,	canonick.png
val8=$(val8[$val6])
tmp0=!itemcnt $val6

val9=$[rint($(tmp0))]
val10=fille nommée Julie Dédeugénie pour répondre,	  garçon nommé GéOMaitrie,	  fille nommée Métab Laurie,	  fille nommée Phonk Siona,	  garçon nommé Constantin Connu,	  garçon nommé Vlad Egraph,	  fille nommée Chantal Gèbre,	  garçon nommé Canot Nick
val11=$(val10[$val6])
val12=Je sais <b>répondre</b> sans aide supplémentaire.
val13=On peut utiliser un logiciel de <b>géométrie</b>.
val14=On peut réaliser des <b>tableaux</b> de valeurs.
val15=Il y a un lien entre les <b>fonctions</b>.
val16=On peut résoudre une <b>équation</b> pour l'arrivée au sol.
val17=On peut utiliser la <b>courbe</b> du trinôme.
val18=On peut <b>résoudre</b> un système d'équations.
val19=Et si on essayait de <b>factoriser</b> une partie.
val20=C'est le moment de trouver ou utiliser des <b>formules</b>.
val21=$val12,	$val13,	$val14,	$val15,	$val16,	$val17,	$val18,	$val19,	$val20
val21=$(val21[$val7])
val22=répondre,	 géométrie,	 tableaux,	 fonctions,	 équation,	 courbe,	 résoudre,	 factoriser,	 formules
val22=$(val22[$val7])
val23=yellow,darkturquoise,lightgrey,pink,lightgreen,mediumaquamarine,coral,lightseagreen
val23=$(val23[$val6])
!readproc slib/text/balloon [$(val21[1])],$(val23[1]),250,100,triangle=left-in 
tmp0=$slib_out
val24=$(tmp0)
!readproc slib/text/balloon [$(val21[2])],$(val23[2]),250,100,triangle=left-in 
tmp0=$slib_out
val25=$(tmp0)
!readproc slib/text/balloon [$(val21[3])],$(val23[3]),250,100,triangle=left-in 
tmp0=$slib_out
val26=$(tmp0)
!readproc slib/text/balloon [$(val21[4])],$(val23[4]),250,100,triangle=left-in 
tmp0=$slib_out
val27=$(tmp0)
!readproc slib/text/balloon [$(val21[5])],$(val23[5]),250,100,triangle=left-in 
tmp0=$slib_out
val28=$(tmp0)
val29=<p>Répondre directement ou choisir une méthode qui mènera au résultat.</p>
tmp0=!randitem -1,1

tmp1=!randint 2, 7

val30=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, -1,1..10

val31=$[rint($(tmp0))]
tmp0=!randint -50, 50

val32=$[rint($(tmp0))]
val33=$[rint(-2*$val31)]
val34=$[rint($val30*$val33)]
val35=$[rint(($val31)^2)]
val36=$[rint($val30*$val35)]
val37=$[rint($val36+$val32)]
!if $val37<0 
val38=&nbsp;
!else
val38=+
!endif
val39=!rawmath $val30*(x-$val31)^2+$val32
val40=!rawmath $val30*x^2+$val34*x+$val37
val41=!rawmath x^2+$val33*x
val42=!rawmath a*(x-x_S)^2+y_S
val43=!rawmath a*x^2-2*a*x_S*x+a*x_S^2+y_S
val44=!rawmath x^2-2*x_S*x+x_S^2
val45=!rawmath a*x_S^2+y_S
val46=!rawmath -2*a*x_S
val47=$[rint(0)]
val48=$[rint(0)]
val49=$[rint(0)]
val50=$[rint(0)]
val51=
val52=r1
val53=1
dynsteps=yes
oefsteps=$val52 
nextstep=!nosubst $val52 
!readproc oef/steps.proc
replytype1=click
replyoption1=nonstop 
replyname1=Méthode
replygood1=?analyze 54;$val22
replytype2=algexp
replyname2=Forme canonique
replygood2=$val39
replytype3=numeric
replyname3=a
replygood3=$[$val30]
replytype4=numeric
replyname4=\(x_S)
replygood4=$[$val31]
replytype5=numeric
replyname5=\(y_S)
replygood5=$[$val32]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p> On veut déterminer la forme canonique 
!insmath $val42
$() de 
!insmath $val40
$().</p>	
!if $m_step=1 
$()		$val29	<ul class="inline"><li>	 
!read oef/embed.phtml reply1,1,<img src="$val1/$(val8[1])" alt="$(val11[1])"> 
$()	$val24	</li><li>	 
!read oef/embed.phtml reply1,2,<img src="$val1/$(val8[2])" alt="$(val11[2])"> 
$()	$val25	</li><li>	 
!read oef/embed.phtml reply1,3,<img src="$val1/$(val8[3])" alt="$(val11[3])"> 
$()	$val26	</li><li>	 
!read oef/embed.phtml reply1,4,<img src="$val1/$(val8[4])" alt="$(val11[4])"> 
$()	$val27	</li>	
!if $val9>=5 
$()	<li>	 
!read oef/embed.phtml reply1,5,<img src="$val1/$(val8[5])" alt="$(val11[5])"> 
$()	$val28	</li> 
!endif
$()	</ul>		 
!endif
$()	
!if $m_step>1 
$()	  
!if $val51 != répondre 
$()	    <p>Voir ci-dessous l'aide pour la méthode "$val51" choisie.</p>	   
!endif
$()	 
!if $val51=courbe 
$()<ul>	    <li>Réaliser la courbe de la fonction 
!insmath f
$() définie par 
!insmath f(x)=$val40
$() sur papier ou l'afficher avec sa calculatrice.</li>	    <li>Repérer le sommet de la parabole.</li>	    <li>Noter son abscisse 
!insmath x_S
$() et son ordonnée 
!insmath y_S
$().</li>	    <li>Noter l'ordonnée 
!insmath y_T
$() du point d'abscisse 
!insmath x_S+1
$()</li>	    <li>La différence 
!insmath y_T-y_S
$() donne le coefficient 
!insmath a
$() que l'on retrouve aussi dans la forme développée.</li>	    <li>Noter la forme canonique 
!insmath a*(x-x_S)^2+y_S
$() en remplaçant 
!insmath a
$(), 
!insmath x_S
$() et 
!insmath y_S
$() par les valeurs trouvées.</li>	    </ul>	   
!endif
$()	 
!if $val51=résoudre 
$()	    <p>La forme canonique est : 
!insmath $val42=$val43
$()</p>	    <p>Pour que 
!insmath $val43= $val40
$() pour tout réel 
!insmath x
$() de 
!insmath \ \RR
$(), il faut et il suffit que :</p>	    <div class="wimscenter">	    
!insmath \begin{cases}	      a&=$val30\\       -2a x_S&=$val34 \\       a x_S^2+y_S&=$val37	      		      \end{cases}
$()	    </div>	    <p>En déduire les valeurs de 
!insmath a
$(), 
!insmath x_S
$() et 
!insmath y_S
$().</p>	    <p>Puis la forme canonique de 
!insmath $val40
$().</p>	   
!endif
$()	  
!if $val51=factoriser 
$()<ul>	    <li>On remarque que :	    
!insmath $val40=$val30*($val41)+$val37
$()</li>	    <li>Et que 
!insmath $val41
$() est le début du développement d'un carré 
!insmath (x-x_S)^2=$val44
$() ; ce qui donne 
!insmath x_S
$().</li>	    <li>En ajoutant et en retranchant le terme manquant de 
!insmath (x-x_S)^2
$() multiplié par $val30, on peut faire apparaître 
!insmath a(x-x_S)^2
$().</li>	    <li>Il reste un terme égal à 
!insmath -$val30*x_S^2+$val37
$() qui est aussi 
!insmath y_S=f(x_S)
$().</li>	    <li>Le coefficient 
!insmath a
$() du carré est le même dans l'expression développée et dans l'expression factorisée.</li>	    <li>On détermine ainsi la forme canonique 
!insmath $val42
$().</li>	    </ul>	   
!endif
$()	  
!if $val51=formules 
$()<ul>	    <li>La forme canonique est : 
!insmath $val42=$val43
$().</li>	    <li>Pour qu'elle soit égale à 
!insmath a'*x^2+b*x+c
$(), il faut et il suffit que :	    <div class="wimscenter">	    
!insmath \begin{cases}	      a&=a'\\       -2a x_S&=b \\       a x_S^2+y_S&=c	      		      \end{cases}
$()	    </div></li>	    <li>On en déduit que 
!insmath x_S=-\frac{b}{2a}
$().</li>	    <li>Mais en fait 
!insmath x_S
$() l'abscisse du sommet de la parabole et 
!insmath y_S
$() son ordonnée.</li>	    <li>Ainsi 
!insmath y_S=f(x_S)=a*x_S^2+b*x_S+c
$().</li>	    <li>Calculer les valeurs de 
!insmath a
$(), 
!insmath x_S
$() et 
!insmath y_S
$() et noter la forme canonique 
!insmath $val42
$() pour	    répondre à la question.</li>	    </ul>	   
!endif
$()		
!if $val51 != répondre 
$()	  <div class="wims_question"><label for="reply3">
!insmath a
$()=</label> 
!read oef/embed.phtml reply 3,8 
$()	  <label for="reply4">
!insmath x_S
$()=</label> 
!read oef/embed.phtml reply 4,8 
$()	  <label for="reply5">
!insmath y_S
$()=</label> 
!read oef/embed.phtml reply 5,8 
$()</div>	   
!endif
$()	  <div class="wims_question"><label for="reply2">La forme canonique de 
!insmath $val40
$() est </label>	   
!read oef/embed.phtml reply2,15 
$().</div>								  
!endif
$()	
$()
!exit

