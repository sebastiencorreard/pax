!set title=Utilisation de la forme canonique d'un trinôme 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=rbelloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
