precision=100

ansorder=r,r,r,r,r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=7
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 2, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 6, 10

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 11, 20

val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*(x-$val7)^2+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
!if $val10=1 
val11=décroissante puis croissante,croissante puis décroissante

!ifval $val6>0
val12=$[rint(1)]
!else
val12=$[rint(2)]
!endif
!else
val11=croissante puis décroissante,décroissante puis croissante

!ifval $val6>0
val12=$[rint(2)]
!else
val12=$[rint(1)]
!endif
!endif
val13=\(\searrow)
val14=\(\nearrow)
val15=&nbsp
val16=\(-\infty)
val17=\(+\infty)
tmp0=!shuffle \($val6),\($val7),\(-$val7),\(-$val6),\($val8),\(-$val8)

val18=$(tmp0)
tmp0=!listuniq $val18

val18=$(tmp0)
val19=$val16 $val14,$val17 $val13,$val14 $val17,$val13 $val16,$val18
val20=\($val7)
!if $val6>0 
val21=$val17 $val13
val22=\($val8)
val23=$val14 $val17
!else
val21=$val16 $val14
val22=\($val8)
val23=$val13 $val16
!endif
val24=60
oefsteps=reply 1	reply 2,reply 3	reply 4,reply 5,reply6,reply7 
nextstep=!nosubst reply 1	reply 2,reply 3	reply 4,reply 5,reply6,reply7 
!readproc oef/steps.proc
replytype1=menu
replyname1=Variations
replygood1=$val12;$val11
replytype2=auto

replyname2=abscisse du sommet
replygood2=$val7
replytype3=auto

replyname3=ordonnée du sommet
replygood3=$val8
replytype4=clickfill
replyname4=
replygood4=$val20;$val19
