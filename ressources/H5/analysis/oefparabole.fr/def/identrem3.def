!insmath $val18
$() =</label>  
!read oef/embed.phtml reply 3 
$().</div>	 
!endif
$()	
!if $m_step=4 
$()	<h2>N° $m_step </h2>	<div><label for="reply4">
!insmath $val20
$() =</label>  
!read oef/embed.phtml reply 4 
$().</div>	 
!endif
$()	
!if $m_step=5 
$()	<h2>N° $m_step </h2>	<div><label for="reply5">
!insmath $val22
$() =</label>  
!read oef/embed.phtml reply 5 
$().</div>	 
!endif
$()	
!if $m_step=6 
$()	<h2>N° $m_step </h2>	<div><label for="reply6">
!insmath $val24
$() =</label>  
!read oef/embed.phtml reply 6 
$().</div>	 
!endif
$()	
$()
