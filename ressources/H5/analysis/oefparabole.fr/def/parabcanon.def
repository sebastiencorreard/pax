!set title=Parabole selon la forme canonique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-10.000000
rightrange=10.000000
computeanswer=no
precision=50

ansorder=r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!randint 2, 3

val7=$[rint((2*$val6-3)*$(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 6

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint($val8+1)]
val11=$[rint($val9+$val7)]

!ifval $val7>0
val12= minimum
!else
val12= maximum
!endif
val13=!rawmath $val7*(x-$val8)^2+$val9
val14=$[rint(400)]
val15=$[($val14*$val8 / 8 + $val14)/2]
val16=$[(-$val14*$val9 / 8 + $val14)/2]
val17=$[($val14*$val10 / 8 + $val14)/2]
val18=$[(-$val14*$val11 / 8 + $val14)/2]
val19=xrange -8,8	yrange -8,8	parallel -8,-8,-8,8,1,0, 17, grey	parallel -8,-8,8,-8,0,1, 17, grey	hline 0,0,black	vline 0,0,black	arrow 0,0,1,0,8, black	arrow 0,0,0,1,8, black	text black, -7.4 ,-0.1 , small, -7	text black, -6.4 ,-0.1 , small, -6	text black, -5.4 ,-0.1 , small, -5	text black, -4.4 ,-0.1 , small, -4	text black, -3.4 ,-0.1 , small, -3	text black, -2.4 ,-0.1 , small, -2	text black, -1.4 ,-0.1 , small, -1	text black,  0,-0.1 , small, 0	text black,  1,-0.1 , small, 1	text black,  2,-0.1 , small, 2	text black,  3,-0.1 , small, 3	text black,  4,-0.1 , small, 4	text black,  5,-0.1 , small, 5	text black,  6,-0.1 , small, 6	text black,  7,-0.1 , small, 7	text black, -0.9,-6.6, small, -7	text black, -0.9,-5.6, small, -6	text black, -0.9,-4.6, small, -5	text black, -0.9,-3.6, small, -4	text black, -0.9,-2.6, small, -3	text black, -0.9,-1.6, small, -2	text black, -0.9,-0.7, small, -1	text black, -0.5,0.4, small, 0	text black, -0.5,1.4, small, 1	text black, -0.5,2.4, small, 2	text black, -0.5,3.4, small, 3	text black, -0.5,4.4, small, 4	text black, -0.5,5.4, small, 5	text black, -0.5,6.4, small, 6	text black, -0.5,7.4, small, 7		
!readproc oef/draw.phtml $val14,$val14 \
$val19	 
tmp0=$ins_url
val20=$(tmp0)	
!readproc oef/draw.phtml $val14,$val14 \
$val19	$val19	fcircle $val8,$val9, 8 , green	text black, $val8 ,$val9+1 , small, S	 
tmp0=$ins_url
val21=$(tmp0)	
oefsteps=reply1,reply2,reply3,reply4	reply5 
nextstep=!nosubst reply1,reply2,reply3,reply4	reply5 
!readproc oef/steps.proc
replytype1=numeric
replyname1=xS
replygood1=$[$val8]
replytype2=numeric
replyname2=yS
replygood2=$[$val9]
replytype3=radio
replyname3=Extremum
replygood3=$val6;un maximum,un minimum
replytype4=coord
replyname4=S
replygood4=$val20 ; point, $val15, $val16
replytype5=coord
replyname5=T
replygood5=$val21 ; point, $val17, $val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>Dans le repère orthonormé ci-dessous, on veut tracer	la parabole d'équation 
!insmath y=$val7*(x-$val8)^2+$val9
$().</p>	<div class="wims_columns">	 <div class="medium_size img_col">	  
!if $m_step=1 
$() 
!read oef/embed.phtml reply 4 
$() 
!endif
$()	  
!if $m_step=2 
$() 
!read oef/embed.phtml reply 5 
$() 
!endif
$()	</div><div class="medium_size text_col"><ul class="wims_nopuce">	
!if $m_step=1 
$()	  <li>Quelles sont les coordonnées du sommet 
!insmath S
$() de cette parabole ?</li>	  <li><label for="reply1">
!insmath x_S =
$()</label>  
!read oef/embed.phtml reply 1,10 
$()</li>	  <li><label for="reply2">
!insmath y_S =
$()</label>  
!read oef/embed.phtml reply 2,10 
$()</li>	  <li>Ce sommet correspond à :	  <ul class="wims_nopuce">	    <li> 
!read oef/embed.phtml reply 3,1 
$()</li>	    <li> 
!read oef/embed.phtml reply 3,2 
$()</li>	  </ul>	  </li><li>	  <b>Clique sur le point S sur le graphique</b>.	  </li>	 
!endif
$()	
!if $m_step=2 
$()	  <li>Tu as trouvé et placé le point 
!insmath S($val8;$val9)
$() et que ce point correspond à un $val12.</li>	  <li>Clique maintenant sur le graphique sur le point <b>d'abscisse $val10</b>.</li>	 
!endif
$()	</ul>	</div></div>	
$()
!exit

:hint
$()	
!if $m_step=1 
$()	La forme canonique d'un trinôme est 
!insmath a*(x-x_S)^2+y_S
$().<br>	Les coordonnées du sommet sont alors 
!insmath (x_S;y_S)
$().<br>	
!if $val8<0 
$()	Attention au signe de 
!insmath x_S
$() !	 
!endif
$()	<p>	Si 
!insmath a > 0
$() alors le sommet correspond à un minimum.</p>	<p>	Si 
!insmath a < 0
$() alors le sommet correspond à un maximum.</p>	 
!endif
$()	
!if $m_step=2 
$()	Tu peux calculer l'ordonnée du point d'abscisse $val10.<br>	Ou bien te rappeler que la courbe est obtenue par translation à partir de celle d'équation :<br>	
!insmath y=$val7*x^2
$().	 
!endif
$()	 
$()
!exit

:help
$()
$()
!exit

:solution
$()La parabole est représentée ci-dessous avec son sommet 
!insmath S
$() et le point 
!insmath T
$().	<div class="wimscenter">	 
!read oef/draw.phtml $val14,$val14 \
	$val19	fcircle $val8,$val9, 8 , green	text black, $val8 ,$val9+1 , small, S	linewidth 2	plot red, $val13	fcircle $val10,$val11, 8 , green	text black, $val10+0.5 ,$val11+1 , small, T	 
$()	</div>	
$()
!exit

