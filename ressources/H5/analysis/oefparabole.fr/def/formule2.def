!set title=Trouver une formule associée à x^2 (3)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath x^2
val10=!rawmath ( x + $val7)^2+$val8
val11=$[rint(-$val7)]
val12=$[rint($val8)]
val13=$[rint(-$val7)]
val14=$[rint($val8)]
val15=$[rint(0)]
val16=$[rint(-6)]
val17=$[rint(10)]
val18=xrange -8,8	yrange $val16,$val17	linewidth 1	parallel -8,$val16,-8,$val17,1,0,20,$val6	linewidth 1	parallel -8,$val16,8,$val16,0,1,17,$val6	linewidth 3	arrow 0,$val16,0,$val17,10,black	arrow -8,0,8,0,10,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.3,-0.3,large,i	text red,-0.5,0.7,large,j	text black,-0.2,-0.1,large,O	linewidth 3	plot blue,$val9	plot red,$val10	
!readproc oef/draw.phtml 400,400 \
$val18 
tmp0=$ins_url
val19=$(tmp0)
val20=<br>Remplacer \(x) par (\(x + k)) dans \($val9) translate sa courbe de	<ul>	 <li> \(k) unités vers la gauche si \(k) est positif </li>	 <li>\(-k) unités vers la droite si \(k) est négatif.</li>	</ul>	Ajouter une constante \(k) à \(f(x)) translate la courbe de \(f) de	<ul>	 <li> \(k) unités vers le haut si \(k) est positif </li>	 <li>\(-k) unités vers le bas si \(k) est négatif.</li>	</ul>

!ifval $val7>0 
val21=$[rint( $val7)]
!else
val21=$[rint( -$val7)]
!endif

!ifval ($val7)^2>1 
val22= unités
!else
val22=unité
!endif

!ifval $val7>0 
val22= $val21 $val22 vers la gauche
!else
val22=$val21 $val22 vers la droite
!endif

!ifval $val8>0 
val21=$[rint( $val8)]
!else
val21=$[rint( -$val8)]
!endif

!ifval ($val8)^2>1 
val23= unités
!else
val23=unité
!endif

!ifval $val8>0 
val23= $val21 $val23 vers le haut
!else
val23=$val21 $val23 vers la bas
!endif
val24=La courbe cherchée est celle de la fonction carré translatée de $val22 et de $val23
val22=$val24 donc elle a pour équation \(y) = \($val10).
replytype1=function
replyname1=\(f(x)) 
replygood1=!rawmath $val10
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val20

solution=!nosubst $val22


!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val19" alt="$val24"></div>	<div class="medium_size text_col">	  Dans le plan muni d'un repère orthogonal 
!insmath (O,i,j)
$(),	on a tracé la courbe représentative de la fonction carré (en bleu) et d'une fonction 
!insmath f
$() en	rouge.	Par lecture graphique déterminer l'expression de 
!insmath f
$().	<div><label for="reply1">
!insmath f(x)=
$()</label>  
!read oef/embed.phtml reply1,10 
$()</div>	</div></div>	
$()
!exit

