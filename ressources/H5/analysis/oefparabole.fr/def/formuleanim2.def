!set title=Trouver f avec animation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 15

val6=$[rint($(tmp0))]
val7=!rawmath (x-$val6)^2
val8=animstep
val9=$[rint($val8)]
val10=$[rint($val9+$val6)]
replytype1=function
replyname1=\(f(x) =)
replygood1=!rawmath $val7
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   
!read oef/draw.phtml 200,200 \
	    animate 6,0.5,0	    xrange -2,20	    yrange -2,20		    arrow -2,0,20,0,10, black	    arrow 0,-2,0,20,10, black	    text black,$val6-0.5,0,giant,$val6	    text black,$val8-1,0,medium,x-$val6	    text black,$val8+$val6-0.5,0,medium,x	    dsegment $val8,0,$val8,$val8^2,black	    dsegment $val8+$val6,0,$val8+$val6,$val8^2,black		    plot blue,x^2	    plot green,$val7	    arrow $val8,$val8^2,$val8+$val6,$val8^2,10,black	   
$()	  </div>	  <div class="medium_size img_text">	<p>La fonction carrée 
!insmath x \rightarrow x^2
$() est représentée en bleu.</p>	Quelle est la formule de la fonction représentée en vert ?	<div class="wimscenter">	<label for="reply1">
!insmath f(x) =
$()</label>  
!read oef/embed.phtml reply 1,10 
$().	</div>	</div></div>	
$()
!exit

:hint
$()	<ul><li>	Pour répondre 
!insmath (x-17)^2
$() taper <span class="tt">(x-17)^2</span>.</li><li>	Pour répondre 
!insmath (x+17)^2
$() taper <span class="tt">(x+17)^2</span>.</li><li>	Pour répondre 
!insmath x^2+17
$() taper <span class="tt">x^2+17</span>.</li><li>	Pour répondre 
!insmath x^2-17
$() taper <span class="tt">x^2-17</span>.</li></ul>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
