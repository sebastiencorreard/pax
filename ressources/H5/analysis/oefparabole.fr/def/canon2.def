!set title=Trouver la formule canonique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,0,1

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]

!ifval $val6=0
val8=$[rint($val7)]
!else
val8=$[rint(-$val7)]
!endif
tmp0=!randitem -1,1

tmp1=!randint 1, 9

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 10, 39

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val6=0
val11=minimum
!else
val11=maximum
!endif
val12=!rawmath $val8*(x-$val9)^2+$val10
val13=10
replytype1=formal
replyname1=\(f(x))
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Déterminer la fonction trinôme 
!insmath f
$() dont le $val11 est $val10 et est obtenu pour 
!insmath x=$val9
$()	et dont la courbe soit superposable avec la parabole d'équation 
!insmath y=$val7*x^2
$().	<div class="wimscenter">	<label for="reply1">
!insmath f(x)=
$()</label>  
!read oef/embed.phtml reply1,$val13 
$()	</div>	
$()
!exit

:hint
$()	Le coefficient du carré est soit $val7 soit 
!insmath -$val7
$(). <br>	Utilise la forme canonique : 
!insmath f(x) = a(x - x_S)^2 + y_S
$().	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

