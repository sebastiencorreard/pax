val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(600)]
tmp0=!randitem 1,2,3

val7=$[rint($(tmp0))]
tmp0=!randint 9, 15

val8=$[rint($(tmp0))]
val9=$[rint($val8-$val7)]
val10=$[rint($val7*$val7)]
val11=$[rint(2*$val7)]
val12=$[rint(4*$val7)]
val13=$[rint(8*$val7)]
val14=$[rint($val8*$val8)]
val15=$[rint($val14-$val10)]
val16=$[rint($val15-$val12)]
val17=$[rint(2*$val16)]
val18=!rawmath 2*x^2+$val12*x-$val13
val19=!rawmath x^2+$val11*x-$val12
val20=!rawmath x^2+$val11*x
val21=!rawmath x^2+$val11*x+$val10
val22=(x+$val7)^2
val23=xrange -4,38	yrange -3,11	linewidth 2		rect 0,0,20+$val12,10,black	frect 10,0,10+$val12,2,brown	arrow2 -0.5,0,-0.5,10,8,black	arrow2 0,-0.5,10,-0.5,8,black	arrow2 10,-0.5,10+$val12,-0.5,8,black	arrow2 10+$val12,-0.5,20+$val12,-0.5,8,black	arrow2 9.5,0,9.5,2,8,black		text black,-2,6,medium,x	text black,4.5,-1,medium,x	text black,9.5+$val11,-1,medium,$val12	text black,14+$val12,-1,medium,x	text black,8,1.5,medium,2	
!readproc oef/draw.phtml $val6,$val6/3 \
$val23 
tmp0=$ins_url
val24=$(tmp0)
val25=L'espace de danse est formé d'un carré de côté x, un rectangle de côtés x et $val12 privé d'un rectangle de $val12 m sur 2 et d'un carré de côté x
val26=$val23	frect 0,0,10,10,lightblue	frect 10+$val12,0,20+$val12,10,lightblue	frect 10,0,10+$val12,10,yellow	rect 10,0,10+$val12,2,brown	arrow2 9.5,0,9.5,2,8,black	text black,8,1.5,medium,2	text black,5,6,medium,x	text black,5.5,6.3,medium,2	text black,9.5+$val11,6,medium,$val12 x	text black,14+$val12,6,medium,x	text black,14.5+$val12,6.3,medium,2	text black,9.5+$val11,1,medium,$val13	
oefsteps=reply1	reply2,reply3,reply4,reply5	reply6	reply7 
nextstep=!nosubst reply1	reply2,reply3,reply4,reply5	reply6	reply7 
!readproc oef/steps.proc
replytype1=function
replyname1=Aire
