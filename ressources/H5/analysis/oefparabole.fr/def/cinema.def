tmp0=!randitem 20,25,40,50

val6=$[rint($(tmp0))]
val7=$[0.01*$val6]
tmp0=!randint 2, 8

val8=$[rint(400*$(tmp0))]
val8=$[rint(1600)]
val9=$[rint($val8*$val7)]
tmp0=!randint 8, 12

val10=$[rint($(tmp0))]
val11=$[rint(100*$val10)]
tmp0=!randint 1, 5

val12=$[rint(50*$(tmp0))]
val13=$[0.01*$val12]
val14=$[rint(0.5*($val8+$val11+$val12))]
val15=$[0.01*$val14]
val16=$[rint(sqrt(($val14)^2-$val12*$val8-$val12*$val11))]
tmp0=!randint 2, 5

val17=$[rint($val16-20*$(tmp0))]
val18=$[rint(($val14)^2-$val12*$val8-$val12*$val11-($val17)^2)]
val19=$[$val18*$val7]
val20=$[0.01*$val19]
val21=$[$val13*$val6]
val22=$[$val9+$val6*$val10]
val23=$[$val13*$val9+$val13*$val6*$val10+$val20]
val24=$[$val9+$val6*$val10]
val25=$[$val9+$val6*$val10+$val13*$val6]
val26=$[rint($val7*($val17)^2)]
val27=$[0.01*$val26]
val28=!rawmath $val9-$val6*(x-$val10)
val29=!rawmath -$val6*x+$val22
val30=!rawmath $val13*n+$val20
val31=!rawmath -$val21*x+$val23
val32=!rawmath -$val6*x^2+$val24*x
val33=!rawmath -$val6*x^2+$val25*x-$val23
val34=!rawmath -$val6*(x-$val15)^2+$val27
val35=$[0.01*($val14-$val17)]
val36=$[0.01*($val14+$val17)]
oefsteps=reply1	reply2,reply3	reply4,reply5	reply6,reply7	reply8,reply9 
nextstep=!nosubst reply1	reply2,reply3	reply4,reply5	reply6,reply7	reply8,reply9 
!readproc oef/steps.proc
