val6=lightblue
val7=$[rint(400)]
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

val10=$[rint($(tmp0))]
val11=!rawmath sqrt(x)
val12=!rawmath -sqrt(x)

!ifval $val10>0 
val13= sqrt(x+$val8)+$val9 
!else
val13=-sqrt(x+$val8)-$val9 
!endif
t_=!replace internal \( by ( in $val13
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
val14=$[rint(-$val8)]
val15=$[rint($val10*$val9)]
val16=$[rint(-$val8)]
val17=$[rint($val10*$val9)]
val18=$[rint(-10)]
val19=$[rint(10)]
val20=xrange -10,10	yrange $val18,$val19	linewidth 1	parallel -10,$val18,-10,$val19,1,0,21,$val6	linewidth 1	parallel -10,$val18,10,$val18,0,1,21,blue	linewidth 3	arrow 0,$val18,0,$val19,10,black	arrow -10,0,10,0,10,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.3,-0.3,giant,i	text red,-0.5,0.7,giant,j	text black,-0.2,-0.1,giant,O	linewidth 4	text black,$val14,0, giant, $val16	text black,0.1,$val15, giant, $val17		plot blue,$val11	plot green,$val12	plot red,$val13	text red, -$val8+1,$val10*$val9+0.5*$val10+0.5, giant, f	
!readproc oef/draw.phtml $val7,$val7 \
$val20 
tmp0=$ins_url
val21=$(tmp0)
val22=<br> Multiplier \(f(x)) par -1 transforme la courbe de \(f) en son symétrique par rapport à l'axe des abscisses.	<br>Remplacer \(x) par (\(x + k)) dans \($val11) translate sa courbe de	<ul>	 <li> \(k) unités vers la gauche si \(k) est positif </li>	 <li>\(-k) unités vers la droite si \(k) est négatif.</li>	</ul>	Ajouter une constante \(k) à \(f(x)) translate la courbe de \(f) de	<ul>	 <li> \(k) unités vers le haut si \(k) est positif </li>	 <li>\(-k) unités vers le bas si \(k) est négatif.</li>	</ul>		 
val23=<br> La courbe cherchée est celle de la fonction

!ifval $val10>0 
val23= $val23 racine carrée 
!else
val23=$val23 l'opposé de la racine carrée 
!endif

!ifval $val8>0 
val24=$[rint( $val8)]
!else
val24=$[rint( -$val8)]
!endif

!ifval ($val8)^2>1 
val25= unités
!else
val25=unité
!endif

!ifval $val8>0 
val25= $val24 $val25 vers la gauche
!else
val25=$val24 $val25 vers la droite
!endif

!ifval $val9>0 
val24=$[rint( $val9)]
!else
val24=$[rint( -$val9)]
!endif

!ifval ($val9)^2>1 
val26= unités
!else
val26=unité
!endif

!ifval $val10*$val9>0 
val26= $val24 $val26 vers le haut
!else
val26=$val24 $val26 vers la bas
!endif
val27=$val23 que l'on a translatée de $val25 et de $val26
val23=$val27 donc elle a pour équation :<br> \(y) = \($val13).
replytype1=function
replyname1=\(f(x)) 
replygood1=!rawmath $val13,x=[-$val8,-$val8+5]
