!set title=Trouver une formule associée à x^2 (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,1,1,2,2,2,3

val8=$[rint($(tmp0))]
val9=!rawmath x^2

!ifval $val8=1 
val10= x^2 +$val7 
!else
val10= - x ^2
!endif

!ifval $val8=2 
val10= ( x + $val7)^2 
!else
val10=$val10 
!endif
val10=!rawmath $val10
!if $val8=2 
val11=$[rint(-$val7)]
!else
val11=$[rint(0)]
!endif
!if $val8=1 
val12=$[rint($val7)]
!else
val12=$[rint(0)]
!endif
!if $val8=3 
val13=$[rint($val12-1)]
!else
val13=$[rint($val12+1)]
!endif
val14=$[rint($val11-1)]
val15=$[rint($val11+1)]
val16=La courbe de f en rouge passe par $val14,$val13 puis $val11,$val12 et $val15,$val13
val17=$[rint(0)]
val18=$[rint(-6)]
val19=$[rint(10)]
val20=xrange -8,8	yrange $val18,$val19	linewidth 1	parallel -8,$val18,-8,$val19,1,0,20,$val6	linewidth 1	parallel -8,$val18,8,$val18,0,1,17,$val6	linewidth 3	arrow 0,$val18,0,$val19,10,black	arrow -8,0,8,0,10,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.3,-0.3,large,i	text red,-0.5,0.7,large,j	text black,-0.2,-0.1,large,O	linewidth 3	plot blue,$val9	plot red,$val10	
!readproc oef/draw.phtml 500,500 \
$val20 
tmp0=$ins_url
val21=$(tmp0)
val22=<br>Remplacer \(x) par (\(x + k)) dans \($val9) translate sa courbe de	<ul>	 <li> \(k) unités vers la gauche si \(k) est positif </li>	 <li>\(-k) unités vers la droite si \(k) est négatif.</li>	</ul>	Multiplier \(f(x)) par -1 transforme la courbe de \(f) en son symétrique par rapport à l'axe des abscisses.	<br>Ajouter une constante \(k) à \(f(x)) translate la courbe de \(f) de	<ul>	 <li> \(k) unités vers le haut si \(k) est positif </li>	 <li>\(-k) unités vers le bas si \(k) est négatif.</li>	</ul>		 

!ifval $val7>0 
val23=$[rint( $val7)]
!else
val23=$[rint( -$val7)]
!endif

!ifval ($val7)^2>1 
val24= unités 
!else
val24= unité
!endif

!ifval $val7>0 
val25= $val23 $val24 vers le haut
!else
val25=$val23 $val24 vers le bas
!endif

!ifval $val7>0 
val26= $val23 $val24 vers la gauche
!else
val26=$val23 $val24 vers la droite
!endif

!ifval $val8 = 1 
val24= $val25 
!else
val24= $val26
!endif
val24=La courbe cherchée est celle de la fonction carré translatée de $val24	donc elle a pour équation : \(y) = \($val10).
val25=La courbe cherchée est symétrique de celle de la fonction carré	par rapport à l'axe des abscisses donc elle a pour équation :\(y) = \($val10).

!ifval $val8=3 
val24= $val25 
!else
val24= $val24
!endif
replytype1=function
replyname1=\(f(x)) 
replygood1=!rawmath $val10
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val22

solution=!nosubst $val24


!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val21" alt="$val16"></div>	<div class="medium_size text_col">	Dans le plan muni d'un repère orthogonal 
!insmath (O,i,j)
$(),	on a tracé la courbe représentative de la fonction carré (en bleu)	et d'une fonction 
!insmath f
$() en rouge.	Par lecture graphique déterminer l'expression de 
!insmath f
$().	</div></div>	<div><label for="reply1">
!insmath f(x)=
$()</label>  
!read oef/embed.phtml reply1,10 
$().</div>	
$()
!exit

:hint
$()$val22
$()
!exit

:help
$()
$()
!exit

:solution
$()$val24
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,21,22,24
embedcnt=1
