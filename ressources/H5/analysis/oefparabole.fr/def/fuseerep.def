val67=$val66	plot black, $val48+$val43	plot red,$val49	text red,$val39,$val43-$val37,medium,g	
val68=animate 2*$val45+2*$val38+1,1,0	$val67	linewidth 2	arrow $val59,$val43-$val34*$val59^2,$val59+$val39,$val43-$val34*$val59^2,10,black	arrow $val59,-$val34*$val59^2,$val59,$val43-$val34*$val59^2,10,black	arrow -$val38,-$val34*$val38^2,-$val38,$val43-$val34*$val38^2,10,red	arrow -$val38,$val43-$val34*$val38^2,$val36,$val40,10,red	text black,$val59-0.2,-2*$val37,medium,x-$val39	text black,$val59+$val39-0.2,-2*$val37,medium,x	dsegment $val59,-2*$val37,$val59,$val43-$val34*$val59^2,black	dsegment $val59+$val39,-2*$val37,$val59+$val39,$val43-$val34*$val59^2,black	
