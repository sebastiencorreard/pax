val6=$[rint(1)]
tmp0=!randitem -1,1

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 10, 100

val8=$[0.1*$(tmp0)*$(tmp1)]
tmp0=!randint 1, 10

val9=$[100*$val7*$(tmp0)]
val10=$[-2*$val9*$val8]
val11=$[$val9*$val8*$val8]
val12=$val8
val13=Le discriminant est 0 donc l'équation a 1 seule solution.
val14=$val9*x^2+$val10*x+$val11
val15=$[rint(2)]
val16=$[rint(-$val7)]
tmp0=!randitem -1,1

tmp1=!randint 1, 20

val17=$[$(tmp0)*$(tmp1)]
tmp0=!randint 10, 200

val18=$[$val17+0.1*$(tmp0)]
!if $val18=0 
tmp0=!randint 10, 100

val18=$[0.1*$(tmp0)]
!endif
tmp0=!randint 1, 9

val19=$[10*$val16*$(tmp0)]
val20=$[-$val19*($val17+$val18)]
val21=$[$val19*$val17*$val18]
val22=$val17,$val18
val23=$[rint(($val20)^2-4*$val19*$val21)]
val24=Le discriminant est $val23 donc l'équation a 2 solutions.
val25=$val19*x^2+$val20*x+$val21
val26=$[rint(2)]
tmp0=!randint 6, 12

val27=$[rint($(tmp0))]
tmp0=!randitem 0.5,1,2,3

val28=$[$(tmp0)]
val29=$[rint(ceil(0.25*($val27^2-63)/$val28))]
val30=$[rint(floor(0.25*($val27^2-50)/$val28))]
tmp0=!randint $val29, $val30

val31=$[rint($(tmp0))]
val32=$[rint($val27^2-4*$val28*$val31)]
val33=$[(-$val27-sqrt($val32))/(2*$val28)]
val34=$[(-$val27+sqrt($val32))/(2*$val28)]
val35=(-$val27-sqrt($val32))/(2*$val28)
val36=(-$val27+sqrt($val32))/(2*$val28)
val37=$val35,$val36
val32=$[rint(($val27)^2-4*$val28*$val31)]
val38=Le discriminant est $val32 donc l'équation a 2 solutions.
val39=$val28*x^2+$val27*x+$val31
val40=$[rint(0)]
tmp0=!randitem -1,1

val41=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val42=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val43=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val44=$[rint($val41*$(tmp0))]
val45=$[rint(-2*$val44*$val42)]
val46=$[rint($val44*(($val42)^2+($val43)^2))]
val47=vide
val48=$[rint(($val45)^2-4*$val44*$val46)]
val49=Le discriminant est \($val48 < 0) donc l'équation n'a pas de solution.
val50=$val44*x^2+$val45*x+$val46
tmp0=!randint 1, 10

val51=$[rint(-$val41*$(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val52=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 100

val53=$[rint($(tmp0)*$(tmp1))]
val54=$[rint(($val52)^2-4*$val51*$val53)]
!if $val54<0 
val55=$[rint(0)]
val56=Le discriminant est \($val54 < 0) donc l'équation n'a pas de solution.
val57=vide
!else
val55=$[rint(2)]
val58=$[(-$val52-sqrt($val54))/(2*$val51)]
val59=$[(-$val52+sqrt($val54))/(2*$val51)]
val60=(-$val52-sqrt($val54))/(2*$val51)
val61=(-$val52+sqrt($val54))/(2*$val51)
val57=$val60,$val61
val56=Le discriminant est $val54 donc l'équation a 2 solutions.
!if $val54=0 
val55=$[rint(1)]
val56=Le discriminant est 0 donc l'équation a 1 seule solution.
val57=-$val52/(2*a)
!endif
!endif
val62=$val51*x^2+$val52*x+$val53
val63=$val6,$val15,$val26,$val40
tmp=!trim $val12;$val22;$val37;$val47
val64=!translate internal $	\
$ to ;; in $tmp
val65=$val14,$val25,$val39,$val50
val66=$val13,$val24,$val38,$val49
