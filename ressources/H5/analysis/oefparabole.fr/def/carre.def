 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=!rawmath x^2+0*sqrt(x)+0*sqrt(1-x)
val7=!rawmath x^2+0*sqrt(x+1)+0*sqrt(1-x)
val8=!rawmath x^2+0*sqrt(x+1)+0*sqrt(2-x)
val9=!rawmath x^2+0*sqrt(x+2)+0*sqrt(2-x)
val10=!rawmath x^2
val11=xrange -4,4	yrange -2,10	parallel -4,-2,-4,10,1,0, 9, lightblue	parallel -4,-2,10,-2,0,1, 13, lightblue	arrow -4,0,4,0,8, black	arrow 0,-2,0,10,8, black		text black, 0,-0.1 , small, 0	text black, 1,-0.1 , small, 1	text black, 2,-0.1 , small, 2	text black, 3,-0.1 , small, 3	text black, -1.1,-0.1 , small, -1	text black, -2.1,-0.1 , small, -2	text black, -3.1,-0.1 , small, -3		text black, -0.5,0.4, small, 0	text black, -0.5,1.4, small, 1	text black, -0.5,2.4, small, 2	text black, -0.5,3.4, small, 3	text black, -0.5,4.4, small, 4	text black, -0.5,5.4, small, 5	text black, -0.5,6.4, small, 6	text black, -0.5,7.4, small, 7	text black, -0.5,8.4, small, 8	text black, -0.5,9.4, small, 9		fcircle 0,0,6, blue	
!readproc oef/draw.phtml 200,300 \
$val11	 
tmp0=$ins_url
