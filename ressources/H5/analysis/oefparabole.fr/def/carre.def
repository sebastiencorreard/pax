!readproc oef/draw.phtml 200,300 \
$val11	fcircle 1,1, 8 , blue	plot red, $val6	 
tmp0=$ins_url
val13=$(tmp0)	
!readproc oef/draw.phtml 200,300 \
$val11	fcircle 1,1, 6 , blue	fcircle -1,1, 8 , blue	plot red, $val7	 
tmp0=$ins_url
val14=$(tmp0)	
!readproc oef/draw.phtml 200,300 \
$val11	fcircle 1,1, 6 , blue	fcircle -1,1, 6 , blue	fcircle 2,4, 8 , blue	plot red, $val8	 
tmp0=$ins_url
val15=$(tmp0)	
!readproc oef/draw.phtml 200,300 \
$val11	fcircle 1,1, 6 , blue	fcircle -1,1, 6 , blue	fcircle 2,4, 6 , blue	fcircle -2,4, 8 , blue	plot red, $val9	 
tmp0=$ins_url
val16=$(tmp0)	
val17=$val11	fcircle 1,1, 6 , blue	fcircle -1,1, 6 , blue	fcircle 2,4, 6 , blue	fcircle -2,4, 6 , blue	fcircle 3,9, 8 , blue	plot red, $val10	
!readproc oef/draw.phtml 200,300 \
