tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

val10=$[rint($(tmp0))]
val11=!rawmath x^2

!ifval $val10>0 
val12= ( x + $val8)^2+$val9 
!else
val12=-( x + $val8)^2-$val9 
!endif
val12=!rawmath $val12
