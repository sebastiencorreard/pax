!for val38  = 2*$val12 to $val16 step $val12 
val39=$val39 ; text black,-0.8,$val38+0.3*$val12,small,$val38
!next
val40=xrange $val27,$val28	yrange $val29,$val30	linewidth 1	parallel $val27,0,$val27,$val30,1,0,$val28+3,lightblue	parallel $val27,$val12,$val28,$val12,0,$val12,$val30,lightblue	text black,0.5,$val30,medium,altitude en m	text black,$val28-4.5,$val12,medium,temps en s	linewidth 2	arrow $val27,0,$val28,0,10, black	arrow 0,$val29,0,$val30,10, black	text black $val27,-$val13,medium,- $val13	$val37	$val39	plotsteps 1000	text green,0.8*$val13,$val12,medium,c	text black,0.8*$val13,$val16-$val12,medium,r	plot green,$val20	plot black,$val21	
val41=$val40	plot red,$val22	text red,$val14,$val16-$val12,medium,g	
val42=animate 2*$val17+2*$val13+1,1,0	$val41	linewidth 2	arrow $val36,$val16-$val9*$val36^2,$val36+$val14,$val16-$val9*$val36^2,10,black	text black,$val36-0.2,0.5*$val29,medium,x-$val14	text black,$val36+$val14-0.2,0.5*$val29,medium,x	dsegment $val36,0,$val36,$val16-$val9*$val36^2,black	dsegment $val36+$val14,0,$val36+$val14,$val16-$val9*$val36^2,black	
val43=animate 2*$val17+2*$val13+1,1,0	$val40	plot red,$val22	plot green,$val25	plot red,$val26	text red,$val14,$val16-3,medium,g	text red,$val19,$val16-3,medium,u	text green,$val7+$val13,$val12,medium,f	linewidth 2	arrow $val36+$val14,$val16-$val9*$val36^2,$val36+$val14+$val7,$val16-$val9*$val36^2,10,black	text black,$val36-0.2,0.5*$val29,medium,x-$val19	text black,$val36+$val14-1,0.5*$val29,medium,x - $val7	text black,$val36+$val14+$val7-0.2,0.5*$val29,medium,x	dsegment $val36,0,$val36,$val16-$val9*$val36^2,black	dsegment $val36+$val14,0,$val36+$val14,$val16-$val9*$val36^2,black	dsegment $val36+$val19,0,$val36+$val19,$val16-$val9*$val36^2,black	
val44=\(g(x) = r(x)+$val14)
val45=\(g(x) = r(x+$val14))
val46=\(g(x) = r(x-$val14))
val47=\(g(x) = r(x)-$val14)
