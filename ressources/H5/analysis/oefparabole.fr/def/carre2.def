!set title=Fonction a x^2 positive
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Rémi, Belloeil
email=remi.belloeil@orange.fr
language=fr
leftrange=-10.000000
rightrange=10.000000
computeanswer=no
precision=50

ansorder=r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,3,4,5,6

val6=$[0.5*$(tmp0)]
val7=!rawmath $val6*x^2+0*sqrt(x)+0*sqrt(1-x)
val8=!rawmath $val6*x^2+0*sqrt(x+1)+0*sqrt(1-x)
val9=!rawmath $val6*x^2
val10=xrange -4,4	yrange -2,14	parallel -4,-2,-4,14,1,0, 9, lightblue	parallel -4,-2,10,-2,0,1, 17, lightblue	arrow -4,0,4,0,8, black	arrow 0,-2,0,14,8, black		text black, 0,-0.1, small, 0	text black, 1,-0.1, small, 1	text black, 2,-0.1, small, 2	text black, 3,-0.1, small, 3	text black, -1.1,-0.1, small, -1	text black, -2.1,-0.1, small, -2	text black, -3.1,-0.1, small, -3		text black, -0.5,0.4, small, 0	text black, -0.5,1.4, small, 1	text black, -0.5,2.4, small, 2	text black, -0.5,3.4, small, 3	text black, -0.5,4.4, small, 4	text black, -0.5,5.4, small, 5	text black, -0.5,6.4, small, 6	text black, -0.5,7.4, small, 7	text black, -0.5,8.4, small, 8	text black, -0.5,9.4, small, 9	text black, -0.5,10.4, small,10	text black, -0.5,11.4, small,11	text black, -0.5,12.4, small,12	text black, -0.5,13.4, small,13	fcircle 0,0,6, blue	
!readproc oef/draw.phtml 200,400 \
$val10	 
tmp0=$ins_url
val11=$(tmp0)	
!readproc oef/draw.phtml 200,400 \
$val10	fcircle 1,1*$val6, 8, blue	plot red, $val7	 
tmp0=$ins_url
val12=$(tmp0)	
!readproc oef/draw.phtml 200,400 \
$val10	fcircle 1,$val6, 6, blue	fcircle -1,$val6, 8, blue	plot red, $val8	 
tmp0=$ins_url
val13=$(tmp0)	
!readproc oef/draw.phtml 200,400 \
$val10	fcircle 1,$val6, 6, blue	fcircle -1,$val6, 6, blue	fcircle 2,4*$val6, 8, blue	plot red, $val9	 
tmp0=$ins_url
val14=$(tmp0)	
val15=$val10	fcircle 1,$val6, 6, blue	fcircle -1,$val6, 6, blue	fcircle 2,4*$val6, 6, blue	fcircle -2,4*$val6, 6, blue	plot red, $val9	
oefsteps=reply1	reply2	reply3	reply4 
nextstep=!nosubst reply1	reply2	reply3	reply4 
!readproc oef/steps.proc
replytype1=coord
replyname1=Abscisse 1
replygood1=$val11 ; point, 125, 350-25*$val6
replytype2=coord
replyname2=Abscisse -1
replygood2=$val12 ; point, 75, 350-25*$val6
replytype3=coord
replyname3=Abscisse 2
replygood3=$val13 ; point, 150, 350-100*$val6
replytype4=coord
replyname4=Abscisse -2
replygood4=$val14 ; point, 50, 350-100*$val6
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>Dans le repère orthonormé ci-dessous, on veut tracer la	parabole d'équation 
!insmath y=$val6*x^2
$().	</p><p>	Le point d'abscisse 0 qui est le sommet de la parabole est déjà placé.	</p>	
!if $m_step=1 
$()	Clique sur le point d'abscisse <strong>1</strong>:	<div class="wimscenter"> 
!read oef/embed.phtml reply 1 
$()</div>	 
!endif
$()	
!if $m_step=2 
$()	Clique sur le point d'abscisse <strong>
!insmath -1
$()</strong>:	<div class="wimscenter"> 
!read oef/embed.phtml reply 2 
$()</div>	 
!endif
$()	
!if $m_step=3 
$()	Clique sur le point d'abscisse <strong>2</strong>:	<div class="wimscenter"> 
!read oef/embed.phtml reply 3 
$()</div>	 
!endif
$()	
!if $m_step=4 
$()	Clique sur le point d'abscisse <strong>
!insmath -2
$()</strong>:	<div class="wimscenter"> 
!read oef/embed.phtml reply 4 
$()</div>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La parabole est représentée ci-dessous.	<div class="wimscenter">	 
!read oef/draw.phtml 200,400 \
	$val15	fcircle 3,9*$val6, 8, blue	fcircle -3,9*$val6, 8, blue	fcircle 4,16*$val6, 8, blue	fcircle -4,16*$val6, 8, blue	 
$()	</div>	
$()
!exit

:latex
