\title{Identités remarquables sur dessin}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% taille de l'image
\integer{L=300}

%% Choix des paramètres

\integer{a=17}
\integer{b=6}
\integer{S=\a+\b}
\integer{m=0.5*\S}

\text{f1=(a+b)^2}
\text{d1=a^2+2*a*b+b^2}
\text{f2=(a-b)^2}
\text{d2=a^2-2*a*b+b^2}
\text{f3=(a+b)*(a-b)}
\text{d3=(a+b)*(a-b)+a*b+b^2}

%% Cas 1 A=(a+b)^2

%% cadre générique
\text{cadre0=
xrange -2,28
yrange -4,26

frect 0,0,\S,\S,pink
text black,\m-3,-1,medium,a + b
text black,\S+1,\m+1,medium,a + b
arrow2 0,-0.5,\S,-0.5,8,black
arrow2 \S+0.5,0,\S+0.5,\S,8,black
}
%% création de l'image
\text{url0=draw(\L,\L
\cadre0)}
\text{t0=Carré rose de côtés a + b}

\text{cadre=
xrange -2,28
yrange -4,26

frect 0,0,\a,\b,yellow
frect 0,\b,\a,\S,green
frect \a,0,\S,\b,blue
frect \a,\b,\S,\S,yellow

text blue,-2,0.5*\b,medium,b
text green,-2,\b+0.5*\a,medium,a
text green,0.5*\a,\S+2,medium,a
text blue,\a+0.5*\b,\S+2,medium,b
text black,\m-3,-1,medium,a + b
text black,\S+1,\m+1,medium,a + b

arrow2 -0.5,0,-0.5,\b,8,blue
arrow2 -0.5,\b,-0.5,\S,8,green
arrow2 0,\S+0.5,\a,\S+0.5,8,green
arrow2 \a,\S+0.5,\S,\S+0.5,8,blue
arrow2 0,-0.5,\S,-0.5,8,black
arrow2 \S+0.5,0,\S+0.5,\S,8,black
}
\text{url=draw(\L,\L
\cadre)}
\text{t=Carré composé d'un carré vert de côté a, d'un rectangle jaune vertical de côtés a et b,
 d'un rectangle jaune horizontal de côtés b et a et d'un carré bleu de côté b}

%% cadre solution
\text{cadreSol=
\cadre
text black,0.5*\a,0.5*\b,medium,a b
text black,0.5*\a,\b+0.5*\a,medium,a
text black,0.5*\a+1,\b+0.5*\a+1,medium,2
text black,\a+0.5*\b,\b+0.5*\a,medium,a b
text black,\a+0.5*\b,0.5*\b,medium,b
text black,\a+0.5*\b+1,0.5*\b+1,medium,2
}
\text{urlS=draw(\L,\L
\cadreSol)}
\text{tS=Carré composé d'un carré de côté a d'aire a², de 2 rectangles de côtés a et b d'aires ab,
et d'un carré de côté b d'aire b²}

%% Cas 2 (a-b)^2
\text{figure0=
xrange -2,28
yrange -5,25

frect 0,0,\a,\a,green
frect \a,0,\S,\b,blue

text blue,\S+2,0.5*\b,medium,b
text green,-2,0.5*\a,medium,a
text green,0.5*\a,\a+4,medium,a
text blue,\a+0.5*\b,-2,medium,b

arrow2 -0.5,0,-0.5,\a,8,green
arrow2 0,\a+2.5,\a,\a+2.5,8,green
arrow2 \S+0.5,0,\S+0.5,\b,8,blue
arrow2 \a,-0.5,\S,-0.5,8,blue
}
\text{uf0=draw(\L,\L
\figure0)}
\text{tf0=Un carré vert de côté a et un carré bleu de côté b}

\text{figure1=
xrange -2,28
yrange -5,25

frect 0,0,\b,\a,yellow
frect \b,0,\S,\b,yellow
frect \b,\b,\a,\a,red
rect 0,0,\b,\a,black
rect \b,0,\S,\b,black

text blue,\S+2,0.5*\b,medium,b
text green,-2,0.5*\a,medium,a
text green,0.5*\a,\a+4,medium,a

arrow2 -0.5,0,-0.5,\a,8,green
arrow2 0,\a+2.5,\a,\a+2.5,8,green
arrow2 \S+0.5,0,\S+0.5,\b,8,blue

text blue,0.5*\b,\a+2,medium,b
text red,0.5*\S-2,\a+2,medium,a - b
text red,\a+2,\m,medium,a - b
text green,\b+0.5*\a,-2,medium,a

arrow2 0,\a+0.5,\b,\a+0.5,8,blue
arrow2 \b,\a+0.5,\a,\a+0.5,8,red
arrow2 \a+0.5,\b,\a+0.5,\a,8,red
arrow2 \b,-1.5,\S,-1.5,8,green
}
\text{uf1=draw(\L,\L
\figure1)}
\text{tf1=Figure composée d'un rectangle jaune de côtés a et b, d'un carré rouge de côté a-b,
 d'un rectangle jaune de côtés b et a}

\text{figS1=
\figure0
text black,0.5*\a,0.5*\a,medium,a
text black,0.5*\a+1,0.5*\a+1,small,2
text black,0.5*\b+\a,0.5*\b,medium,b
text black,0.5*\b+\a+1,0.5*\b+1,small,2
}
\text{uf1S=draw(\L,\L
\figS1)}
\text{tf1S=Figure composée d'un carré vert de côté a d'aire a² et un carré bleu de côté b d'aire b²}

\text{figS2=
\figure1
text black,0.5*\b,0.5*\a,medium,ab
text black,0.5*\S-1,0.5*\b,medium,ab
text black,\m-2,\m,medium,(a - b)
text black,\m+3,\m+1,small,2
}
\text{uf2S=draw(\L,\L
\figS2)}
\text{tf2S=Figure composée de deux rectangles jaunes de côtés a et b d'aire chacun ab et
 d'un carré rouge de côté a-b d'aire (a-b)²}

%% Cas 3 (a+b)(a-b) %%
\text{figure3=
xrange -2,28
yrange -5,25

frect 0,0,\a,\a,green
frect \a,0,\S,\a,yellow

text blue,\a+0.5*\b,-1,medium,b
text green,-2,0.5*\a,medium,a
text green,0.5*\a,-1,medium,a

arrow2 -0.5,0,-0.5,\a,8,green
arrow2 0,-0.5,\a,-0.5,8,green
arrow2 \a,-0.5,\S,-0.5,8,blue
}
\text{uf3=draw(\L,\L
\figure3)}
\text{tf3=Figure composée d'un carré vert de côté a et d'un rectangle jaune de côtés a et b}

\text{figure4=
xrange -2,28
yrange -5,25

frect 0,0,\a,\b,yellow
frect 0,\b,\S,\a,red
frect \a,0,\S,\b,blue

text blue,\a+0.5*\b,-1,medium,b
text green,-2,0.5*\a,medium,a
text green,0.5*\a,-1,medium,a

arrow2 -0.5,0,-0.5,\a,8,green
arrow2 0,-0.5,\a,-0.5,8,green
arrow2 \a,-0.5,\S,-0.5,8,blue

text blue,\S+1,0.5*\b,medium,b
text red,\m-2,\a+2,medium,a + b
text red,\S+1,0.5*\a+\b,medium,a - b

arrow2 \S+0.5,0,\S+0.5,\b,8,blue
arrow2 0,\a + 0.5,\S,\a+0.5,8,red
arrow2 \S+0.5,\b,\S+0.5,\a,8,red
}
\text{uf4=draw(\L,\L
\figure4)}
\text{tf4=Figure composée d'un rectangle rouge de côtés a-b et a+b, d'un rectangle jaune de côtés b et a et d'un carré bleu de côté b}

\text{figS3=
\figure3
text black,0.5*\a,0.5*\a,medium,a
text black,0.5*\a+1,0.5*\a+1,small,2
text black,0.5*\b+\a,0.5*\a,medium,ab
}
\text{uf3S=draw(\L,\L
\figS3)}
\text{tf3S=Figure composée d'un carré vert de côté a d'aire a² et d'un rectangle jaune de côtés a et b d'aire ab}

\text{figS4=
\figure4
text black,0.5*\a,0.5*\b,medium,ab
text black,\a+0.5*\b,0.5*\b,medium,b
text black,\a+0.5*\b+1,0.5*\b+1,small,2
text black,0.5*\S-7,\b+0.5*\a,medium,(a + b) (a - b)
}
\text{uf4S=draw(\L,\L
\figS4)}
\text{tf4S=Figure composée d'un rectangle rouge de côtés a-b et a+b d'aire (a+b)(a-b), d'un rectangle jaune de côtés b et a d'aire ab
 et d'un carré bleu de côté b d'aire b²}

\steps{reply1
reply2,reply3,reply4,reply5
reply6,reply7
reply8,reply9,reply10,reply11
reply12,reply13
reply14,reply15,reply16,reply17,reply18}

\text{inst=Pour écrire \(x^2), taper x^2.}

%%%%%%% Enoncé %%%%%%%
\statement{
\if{\step=1}{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\url0" alt="\t0"></div>
 <div class="medium_size text_col">
  <h2>Identité remarquable N°1</h2>
  <p>Voici un carré.
  <label for="reply1">Quelle est son aire en fonction de \(a) et \(b) ?</label></p>
  <div class="wimscenter">
   \embed{reply1,10} (expression factorisée)
  </div>
  <div class="wims_instruction">\inst</div>
</div></div>
 }
\if{\step=2}{<div class="wims_columns">
 <div class="medium_size img_col">
  <img src="\url0" alt="\t0"> <img src="\url" alt="\t">
  </div>
  <div class="medium_size text_col">
<h2>Identité remarquable N°1</h2>
Nous avons décomposé le carré rose précédent dont l'aire est \((a+b)^2).
<ul>
<li><label for="reply2">Quelle est l'aire de la partie en vert ?</label> \embed{reply2,4}</li>
<li><label for="reply3">Quelle est l'aire de la partie en jaune?</label> \embed{reply3,4}</li>
<li><label for="reply4">Quelle est l'aire de la partie en bleu ?</label> \embed{reply4,4}</li></ul>
Quelle est l'aire totale des parties colorées qui composent le carré rose ?
<div class="wimscenter">
<label for="reply5">\((a+b)^2) =</label> \embed{reply5,15}(expression développée)</div>
 </div></div>
}
\if{\step=3}{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\uf0" alt="\tf0"></div>
  <div class="medium_size text_col">
<h2>Identité remarquable N°2</h2>
<p>Voici deux carrés.</p><ul>
<li><label for="reply6">Quelle est l'aire du carré vert ?</label> \embed{reply6,4}</li>
<li><label for="reply7">Quelle est l'aire du carré bleu ?</label> \embed{reply7,4}</li>
</ul>
\inst
</div>
</div>
 }
\if{\step=4}{
<div class="wims_columns">
<div class="medium_size img_col">
<img src="\uf0" alt="\tf0">
 <img src="\uf1" alt="\tf1">
</div><div class="medium_size text_col">
<h2>Identité remarquable N°2</h2>
Nous avons décomposé la figure précédente dont l'aire est \(a^2+b^2)<br>
<label for="reply8">Quelle est l'aire de la partie en rouge ?</label> \embed{reply8,4}<br>
<label for="reply9">Quelle est l'aire de la partie en jaune?</label> \embed{reply9,4}
</p><p>
Quelle est l'aire totale des parties colorées rouge ou jaune : <br>
<label for="reply10">\(a^2+b^2) =</label> \embed{reply10,15} (somme des aires ci-dessus)<br>
Donc <label for="reply11">\((a-b)^2) =</label> \embed{reply11,15} (expression développée)</p>
</div>
</div>
}
\if{\step=5}{
<div class="wims_columns">
<div class="medium_size img_col"><img src="\uf3" alt="\tf3">
</div><div class="medium_size text_col"><h2>Identité remarquable N°3</h2>
<p>Voici un rectangle.</p><ul><li>
<label for="reply12">Quelle est l'aire du carré vert ?</label> \embed{reply12,4}</li><li>
<label for="reply13">Quelle est l'aire du rectangle jaune ?</label> \embed{reply13,4}
</li></ul>
\inst
</div></div>
 }
\if{\step=6}{
<div class="wims_columns">
<div class="medium_size img_col"><img src="\uf3" alt="\tf3">
<img src="\uf4" alt="\tf4">
</div>
<div class="medium_size text_col">
<h2>Identité remarquable N°3</h2>
Nous avons décomposé la figure précédente dont l'aire est \(a^2+ab)</p>
<ul><li>
<label for="reply14">Quelle est l'aire de la partie en rouge ?</label> \embed{reply14,15}</li><li>
<label for="reply15">Quelle est l'aire de la partie en jaune?</label> \embed{reply15,4}</li><li>
<label for="reply16">Quelle est l'aire de la partie en bleu?</label> \embed{reply16,4}</li></ul>
<p>
Quelle est l'aire totale des 3 parties de la figure : </p><ul><li>
<label for="reply17">\(a^2+ab) =</label> \embed{reply17,20} (somme des aires ci-dessus)</li><li>
Donc <label for="reply18">\(\f3) =</label> \embed{reply18,15} (expression développée)</li></ul>
</div>
</div></div>
}
}

\answer{Aire totale}{\f1}{type=algexp}
\answer{Aire verte}{a^2}{type=algexp}
\answer{Aire jaune}{2*a*b}{type=algexp}
\answer{Aire bleue}{b^2}{type=algexp}
\answer{Aire totale}{\d1}{type=algexp}
\answer{Aire verte}{a^2}{type=algexp}
\answer{Aire bleue}{b^2}{type=algexp}
\answer{Aire jaune}{(a-b)^2}{type=algexp}
\answer{Aire bleue}{2*a*b}{type=algexp}
\answer{Aire totale}{(a-b)^2+2*a*b}{type=algexp}
\answer{Aire totale}{\d2}{type=algexp}
\answer{Aire verte}{a^2}{type=algexp}
\answer{Aire jaune}{a*b}{type=algexp}
\answer{Aire rouge}{(a+b)*(a-b)}{type=algexp}
\answer{Aire jaune}{a*b}{type=algexp}
\answer{Aire bleue}{b^2}{type=algexp}
\answer{Aire totale}{\d3}{type=algexp}
\answer{Aire totale}{a^2-b^2}{type=algexp}

\solution{
<h2>Identité 1</h2>
<p>\(\f1 = \d1)</p>
<img src="\urlS" alt="\tS" >

<h2>Identité 2</h2>
<p>\(\f2=\d2)</p>
<ul class="inline">
<li><img src="\uf1S" alt="\tf1S" ></li>
<li><img src="\uf2S" alt="\tf2S" ></li>
</ul>

<h2>Identité 3</h2>
<p>\(\f3=a^2-b^2)</p>
<ul class="inline">
<li><img src="\uf3S" alt="\tf3S" ></li>
<li><img src="\uf4S" alt="\tf4S" ></li>
</ul>
}
