\title{Le vol parabolique du Cormoran}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}
\precision{ 10000 }

\text{bracg=&#123;}
\text{bracd=&#125;}

%% Choix du cas 1, 2 ou 3 %%
\integer{n=randint(0..2)}
%% Choix des paramètres %%
%% Cas 1 1 racine entière %%
\if{\n=1}{
  \integer{x1=randint(1..9)}
  \integer{x2=\x1}
  \integer{a=randint(1..9)}
  \integer{b=-\a*(\x1+\x2)}
  \integer{c=\a*\x1*\x2}
  \text{S=\x1}
  \text{Sol= a 1 solution.<br> \(S=) \bracg \S \bracd.}
}
%% Cas 2  2 racines décimales %%
\if{\n=2}{
  \real{x1=0.1*randint(1..9)}
  \real{x2=\x1+0.1*randint(10..20)}
  \real{a=10*randint(1..9)}
  \real{b=-\a*(\x1+\x2)}
  \real{c=\a*\x1*\x2}
  \text{S=\x1,\x2}
  \text{Sol= a 2 solutions.<br> \(S=) \bracg \S \bracd.}
}
%% Cas 3 pas de racines réelles %%
\if{\n=0}{
  \integer{r4=random(-1,1)*randint(1..9)}
  \integer{i4=randint(1..9)}
  \integer{a=randint(1..9)}
  \integer{b=-2*\a*\r4}
  \integer{c=\a*((\r4)^2+(\i4)^2)}
  \text{S=vide}
  \text{Sol= n'a pas de solution.}
}
\real{D=(\b)^2-4*\a*\c}
\text{Q=\n=1? A quelle distance: A quelles distances}
\text{Q=\Q de l'observateur touchera-t-il la surface de l'eau ?}

\text{List=reply1}
\if{\n>0}{\text{\List=\List;reply2}}

\steps{\List}

%%%%%%% enoncé de l'exo %%%%%%%
\statement{
Un cormoran vole selon une parabole d'équation \(y=\a*x^2+\b*x+\c) où
\(x) désigne la position horizontale par rapport à l'observateur et \(y) l'altitude en mètres.

\if{\step=1}{<p>
<label for="reply1">Combien de fois le cormoran touchera-t-il la surface de l'eau (altitude 0) ?</label>
</p><div class="wimscenter">
 \embed{reply1,5}
</div>
}
\if{\step=2}{
<p>
<label for="reply2">À quelles distances de l'observateur touchera-t-il la surface de l'eau ?</label>
</p>
<div class="wimscenter">\embed{reply2,20}.</div>
<div class="wims_instruction">
<p>Les nombres décimaux s'écrivent avec un point.</p>
<p>Si nécessaire, séparez les réponses par une virgule.</p>
</div>
}
}
\answer{Nombre de solutions S1 }{\n}{type=numeric}
\answer{S}{\S}{type=fset}

\solution{
Le discriminant est \D donc l'équation \(\a*x^2+\b*x+\c=0) \Sol
}
