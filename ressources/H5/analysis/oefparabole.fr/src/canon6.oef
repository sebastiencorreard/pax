\title{Utilisation de la forme canonique d'un trinôme 3}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)*randint(1..5)}

\integer{u=random(-1,1)*randint(6..10)}

\integer{sy=random(-1,1)*randint(11..20)}

\function{fc=maxima(\a*(x-\u)^2+\sy)}

\integer{h=random(1,2)}

\if{\h=1}{
  \text{Lvar=minimum,maximum}
  \integer{var=\a>0?1:2}
}{
  \text{Lvar=maximum,minimum}
  \integer{var=\a>0?2:1}
}

\text{extr=\Lvar[\var]}

%% la liste des objets que l'on peut cliquer pour résoudre l'exercice %%
\text{vse=\(\searrow)}
\text{vne=\(\nearrow)}

\text{vesp=&nbsp}
\text{infg=\(-\infty)}
\text{infd=\(+\infty)}

\text{permut=shuffle(\(\a),\u,\(-\u),\(-\a),\(\sy),\(-\sy))}
\text{permut= wims(listuniq \permut)}
\text{clicList =\infg,\infd,\vne,\vse,\(\a),\u,\(-\u),\(-\a),\(\sy),\(-\sy)}

\if{\a>0}{
  \text{fx1 =\infd}
  \text{fx2 =\vse}
  \text{fx3 =\vne}
  \text{fx4 =\infd}
  }{
  \text{grepfx =\infg,\vne,\(\sy),\vse,\infg}
  \text{fx1 =\infg}
  \text{fx2 =\vne}
  \text{fx3 =\vse}
  \text{fx4 =\infg}
}

\steps{
reply 1
reply 2,reply 3,
reply 4,reply 5,reply 6,reply 7,reply 8,reply 9,reply 10,reply 11}

\text{size=\confparm1=1 ? :x-large}

\statement{On considère le trinôme \(f(x)=\fc) défini sur \(RR).
\if{\step=1}{
<div>
La fonction \(f) admet un \embed{reply 1}.
</div>
}
\if{\step=2}{
Déterminez les coordonnées du sommet de la parabole qui représente \(f).
<ul><li>
<label for="reply2">Le \extr est</label> \embed{reply 2,20}.</li><li>
<label for="reply1">Il est obtenu lorsque \(x =)</label> \embed{reply 3,20}.
</li></ul>
}

\if{\step=3}{
Construire le tableau des variations de \(f)
en déposant les éléments nécessaires dans la ligne \(x) et
dans la ligne \(f(x)) du tableau ci-dessous.

      <table align="center" border="2" width="50%">
      <tr>
         <td align="center">\(x) </td>
         <td align="center" border="0" >\embed{reply 4,\size}</td>
         <td border="0">\vesp</td><td border="0">\embed{reply 5,\size}</td><td border="0">\vesp</td>
         <td border="0">\embed{reply 6,\size}</td>
      </tr>
      <tr>
         <td align="center" border="2">\(f(x))</td>
         <td align="center" border="0" >\embed{reply 7,\size}</td>
         <td border="0">\embed{reply 8,\size}</td>
         <td border="0">\embed{reply 9,\size}</td>
         <td border="0">\embed{reply 10,\size}</td>
         <td border="0">\embed{reply 11,\size}</td>
  </tr>
</table>
}

}

\answer{Extremum}{\var;\Lvar}{type=menu}
\answer{\extr}{\sy}{type=auto}
\answer{pour \(x =)}{\u}{type=auto}
\answer{}{\infg;\clicList}{type=clickfill}
\answer{}{\u;\clicList}{type=clickfill}
\answer{}{\infd;\clicList}{type=clickfill}
\answer{}{\fx1;\clicList}{type=clickfill}
\answer{}{\fx2;\clicList}{type=clickfill}
\answer{}{\(\sy);\clicList}{type=clickfill}
\answer{}{\fx3;\clicList}{type=clickfill}
\answer{}{\fx4;\clicList}{type=clickfill}

\hint{<p>La forme canonique d'un trinôme est \(a(x - d)^2 + e), où \(d) et
\(e) sont l'abscisse et l'ordonnée du sommet de la parabole représentant le trinôme.</p>
  <ul><li>Si \(a) est strictement positif, la fonction a un minimum.</li><li>
  Si \(a) est strictement négatif, la fonction a un maximum.</li></ul>
  <p> Exemple de la fonction carré : \(f(x) = (1)(x-0)^2+0)</p>

      <table border="2" align="center" width="50%">
      <tr>
     <td align="center">
     \(x) </td><td align="center" nowrap>\infg </td><td align="center" nowrap>\vesp</td>
<td align="center" nowrap>0</td><td align="center" nowrap>\vesp</td><td align="center" nowrap> \infd
     </td></tr>
      <tr>
     <td align="center">
     \(f(x)) </td><td align="center" nowrap>\infd </td><td align="center" nowrap>\vse</td>
<td align="center" nowrap>0</td><td align="center" nowrap>\vne</td><td align="center" nowrap> \infd
     </td>
      </tr>
</table>
}
