\title{Trouver la formule canonique}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% choix de la question

\integer{orient=random(0,0,1)}

%% Choix et calculs des coefficients %%
\integer{a0=random(2..9)}
\integer{a=\orient=0?\a0:-\a0}
\integer{xS=random(-1,1)*randint(1..9)}
\integer{yS=random(-1,1)*randint(10..39)}

%% préparation de la question
\text{ext=\orient=0?minimum:maximum}

%% préparation de la réponse
\function{f=\a*(x-\xS)^2+\yS}

%%%%%%% Enoncé %%%%%%%
\text{size=10}

\statement{
Déterminer la fonction trinôme \(f) dont le \ext est \yS et est obtenu pour \(x=\xS)
et dont la courbe soit superposable avec la parabole d'équation \(y=\a0*x^2).
<div class="wimscenter">
<label for="reply1">\(f(x)=)</label> \embed{reply1,\size}
</div>
}
%% indication %%
\hint{
Le coefficient du carré est soit \a0 soit \(-\a0). <br>
Utilise la forme canonique : \(f(x) = a(x - x_S)^2 + y_S).
}
%%%% soumission de réponse %%%%

\answer{\(f(x))}{\f}{type=formal}
