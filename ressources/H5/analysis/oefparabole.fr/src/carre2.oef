\title{Fonction a x^2 positive}
\language{fr}
\range{-10..10}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{50}

\real{a=0.5*randint(1,3,4,5,6)}

\function{f1=\a*x^2+0*sqrt(x)+0*sqrt(1-x)}
\function{f2=\a*x^2+0*sqrt(x+1)+0*sqrt(1-x)}

\function{f=\a*x^2}

\text{lerepere=
xrange -4,4
yrange -2,14
parallel -4,-2,-4,14,1,0, 9, lightblue
parallel -4,-2,10,-2,0,1, 17, lightblue
arrow -4,0,4,0,8, black
arrow 0,-2,0,14,8, black

text black, 0,-0.1, small, 0
text black, 1,-0.1, small, 1
text black, 2,-0.1, small, 2
text black, 3,-0.1, small, 3
text black, -1.1,-0.1, small, -1
text black, -2.1,-0.1, small, -2
text black, -3.1,-0.1, small, -3

text black, -0.5,0.4, small, 0
text black, -0.5,1.4, small, 1
text black, -0.5,2.4, small, 2
text black, -0.5,3.4, small, 3
text black, -0.5,4.4, small, 4
text black, -0.5,5.4, small, 5
text black, -0.5,6.4, small, 6
text black, -0.5,7.4, small, 7
text black, -0.5,8.4, small, 8
text black, -0.5,9.4, small, 9
text black, -0.5,10.4, small,10
text black, -0.5,11.4, small,11
text black, -0.5,12.4, small,12
text black, -0.5,13.4, small,13
fcircle 0,0,6, blue
}

\text{ledessin=draw(200,400
\lerepere
)
}
\text{dessin1=draw(200,400
\lerepere
fcircle 1,1*\a, 8, blue
plot red, \f1
)
}
\text{dessin2=draw(200,400
\lerepere
fcircle 1,\a, 6, blue
fcircle -1,\a, 8, blue
plot red, \f2
)
}
\text{dessin3=draw(200,400
\lerepere
fcircle 1,\a, 6, blue
fcircle -1,\a, 6, blue
fcircle 2,4*\a, 8, blue
plot red, \f
)
}

\text{dessin=
\lerepere
fcircle 1,\a, 6, blue
fcircle -1,\a, 6, blue
fcircle 2,4*\a, 6, blue
fcircle -2,4*\a, 6, blue
plot red, \f
}

\steps{reply1
reply2
reply3
reply4}

\statement{
<p>Dans le repère orthonormé ci-dessous, on veut tracer la
parabole d'équation \(y=\a*x^2).
</p><p>
Le point d'abscisse 0 qui est le sommet de la parabole est déjà placé.
</p>
\if{\step=1}{
Clique sur le point d'abscisse <strong>1</strong>:
<div class="wimscenter">\embed{reply 1}</div>
}
\if{\step=2}{
Clique sur le point d'abscisse <strong>\(-1)</strong>:
<div class="wimscenter">\embed{reply 2}</div>
}
\if{\step=3}{
Clique sur le point d'abscisse <strong>2</strong>:
<div class="wimscenter">\embed{reply 3}</div>
}
\if{\step=4}{
Clique sur le point d'abscisse <strong>\(-2)</strong>:
<div class="wimscenter">\embed{reply 4}</div>
}
}

\answer{Abscisse 1}{\ledessin ; point, 125, 350-25*\a}{type = coord}
\answer{Abscisse -1}{\dessin1 ; point, 75, 350-25*\a}{type = coord}
\answer{Abscisse 2}{\dessin2 ; point, 150, 350-100*\a}{type = coord}
\answer{Abscisse -2}{\dessin3 ; point, 50, 350-100*\a}{type = coord}

\solution{La parabole est représentée ci-dessous.
<div class="wimscenter">
\draw{200,400}{
\dessin
fcircle 3,9*\a, 8, blue
fcircle -3,9*\a, 8, blue
fcircle 4,16*\a, 8, blue
fcircle -4,16*\a, 8, blue
}
</div>
}
