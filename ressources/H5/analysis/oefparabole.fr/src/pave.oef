\title{Le pavé aux grandes faces}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%%Choix des paramètres%%
\real{xS=3*randint(1..10)}
\integer{P=12*\xS}
\integer{l=16}
\integer{h=28}
\integer{u=8}

\integer{b1=3*\xS}

\integer{b=4*\b1}

\function{A=2*x^2+4*h*x}

\text{H=\b1-2*x}
\function{fd=-6*x^2+\b*x}

\integer{yS=6*\xS^2}

\function{fc=-(x-\xS)^2+\yS}

%%% cadre initial %%%
\text{cadre=
xrange -4,26
yrange -5,40
linewidth 2

rect 0,0,16,28,black
segment 16,0,24,8,black
segment 0,28,8,36,black
segment 16,28,24,36,black
segment 8,36,24,36,black
segment 24,8,24,36,black
dsegment 0,0,8,8,black
dsegment 8,8,24,8,black
dsegment 8,8,8,36,black

arrow2 -1,0,-1,28,8,black
arrow2 0,-1,16,-1,8,black
arrow2 17,0,25,8,8,black

text black,-3,15,medium,h
text black,8,-2,medium,x
text black,21,4,medium,x
}
\text{final=
xrange -4,26
yrange -4,26
linewidth 2

rect 0,0,16,16,black
segment 16,0,24,8,black
segment 0,16,8,24,black
segment 16,16,24,24,black
segment 8,24,24,24,black
segment 24,8,24,24,black
dsegment 0,0,8,8,black
dsegment 8,8,24,8,black
dsegment 8,8,8,24,black

arrow2 -1,0,-1,16,8,black
arrow2 0,-1,16,-1,8,black
arrow2 17,0,25,8,8,black

text black,-3,9,medium,h
text black,8,-2,medium,x
text black,21,4,medium,x
}

\steps{reply1,reply2
reply3,reply4
reply5,reply6}

%%%%%%% enoncé de l'exo %%%%%%%
\statement{
<div class="wims_columns">
 <div class="medium_size img_col">
 \draw{210,300}{\cadre}
 </div><div class="medium_size text_col">
<ul class="wims_nopuce">
<li>La longueur totale des arêtes d'un parallélépipède rectangle à base carrée (pavé droit) est \P.</li>
<li>On note \(x) la longueur du côté de la base carrée et \(h) la hauteur de ce parallélépipède.</li>
<li>On cherche les dimensions \(x) et \(h) pour lesquelles l'aire totale des 6 faces est maximale.</li>
</ul>
</div>
</div>
\if{\step=1}{
<h2>Étape 1</h2>
<ul class="wims_nopuce">
<li><label for="reply1">Exprime l'aire totale des faces en fonction de \(x) et \(h).</label>
\embed{reply 1,15}.</li>
<li><label for="reply2">Exprime la longueur totale des arêtes en fonction de \(x) et \(h).</label>
\embed{reply 2,15}</li>
</ul>
 }
\if{\step=2}
 {
<h2>Étape 2</h2>
<ul>
<li><b> L'aire totale des faces en fonction de \(x) et \(h) est bien \(A=\A).</li>
<li>Et la longueur totale des arêtes est \(\G=\P)</b></li>
</ul>
<ul class="wims_nopuce">
<li>Exprime \(h) en fonction de \(x) pour que la longueur totale des arêtes soit \P.</li>
<li><label for="reply3">\(h) =</label> \embed{reply 3,10}.</li>
<li>Substituer l'expression trouvée pour \(h) dans \(A) pour obtenir une expression qui dépend seulement de \(x).</li>
<li><label for="reply4">\(A) =</label> \embed{reply 4,15}.</li>
</ul>
<p>On note cette expression \(f(x)).</p>
 }
\if{\step=3}
 {
  <h2>Étape 3</h2>
  <ul>
  <li><b> La longueur totale des arêtes est \(\G=\P) donc \(h=\H).</li>
  <li>Et l'aire hors enclos est \(f(x)=\fd)</b></li>
  </ul>
  <ul class="wims_nopuce">
  <li>Déterminer \(x) pour que \(\fd) soit maximale.</li>
  <li>Réponse : <label for="reply5">\(x) =</label> \embed{reply 5,5}.</li>
  <li>  Puis en déduire la valeur de \(h).</li>
  <li><label for="reply6">\(h) =</label> \embed{reply 6,5}.  </li>
  </ul>
 }
}

\answer{Aire totale}{\A}{type=function}
\answer{Longueur totale}{\G}{type=function}
\answer{\(h=)}{\H}{type=function}
\answer{\(f(x))}{\fd}{type=function}
\answer{\(x)}{\xS}{type=numeric}
\answer{\(h)}{\xS}{type=numeric}

\solution{
<p>\draw{300,300}{\final}</p>
<ul class="wims_nopuce">
<li>L'aire totale des faces est \(A=\A) et la longueur totale des arêtes est \(\G=\P) avec \(h=\H).</li>
<li>Donc \(A=f(x)=\fd)</li>
<li>Elle est maximale pour \(x=\xS) et \(h=\xS).</li>
</ul>
 }
