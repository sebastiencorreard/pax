\title{Résolution générale d'une équation du 2nd degré et factorisation}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\function{xS=-b/(2*a)}
\function{yS=(a*b^2)/(4*a^2)-b^2/(2*a)+c}
\function{NyS=-b^2+4*a*c}

\function{D=b^2-4*a*c}

\text{t1=\(\frac{b^2-\Delta}{4 a^2})}
\text{t2=\(\frac{b^2+\Delta}{4 a^2})}
\text{t3=\(\frac{b-\sqrt{\Delta}}{2 a})}
\text{t4=\(\frac{b+\sqrt{\Delta}}{2 a})}
\text{t5=\(\frac{-b-\sqrt{\Delta}}{2 a})}
\text{t6=\(\frac{-b+\sqrt{\Delta}}{2 a})}
\text{u1=\(\frac{b^2}{4 a^2})}
\text{u2=\(\frac{-b^2}{4 a^2})}
\text{u3=\(\frac{b}{2 a})}
\text{u4=\(\frac{-b}{2 a})}
\text{v1=\(a*(x-x_1)*(x-x_2))}
\text{v2=\(a*(x+x_1)*(x+x_2))}
\text{v3=\(a*(x-x_1)*(x+x_2))}
\text{v4=\(a*(x+x_1)*(x-x_2))}
\text{v5=\(a*(x-x_S)^2)}
\text{v6=\(a*(x+x_S)^2)}
\text{v7=\(a (x-x_S+\frac{\sqrt{\Delta}}{2a}) (x-x_S-\frac{\sqrt{\Delta}}{2a}))}
\text{v8=\(a (x+x_S+\frac{\sqrt{\Delta}}{2a}) (x-x_S-\frac{\sqrt{\Delta}}{2a}))}
\text{v9=\(a (x-x_S+\frac{\sqrt{\Delta}}{2a}) (x+x_S-\frac{\sqrt{\Delta}}{2a}))}
\text{List=\v1,\v2,\v3,\v4,\v5,\v6,\v7,\v8,\v9}

\steps{
reply1,reply2,reply3
reply4
reply5,reply6,reply7
reply8,reply9
reply10,reply11,reply12}

\statement{
<p>
On considère le trinôme \(f(x)=a*x^2+b*x+c) avec \(a \neq 0).
Sa forme canonique est \(a*(x-x_S)^2+y_S).</p>
<p>On cherche les formules de résolution de \(a*x^2+b*x+c=0).</p>
\if{\step=1}{
<p>Exprimer en fonction de \(a), \(b) et \(c) :</p>
<ul><li>
<label for="reply1">\(x_S =)</label> \embed{reply1,10}
</li><li>
<label for="reply2">\(y_S =)</label> \embed{reply2,30} = \embed{reply3,20} / \((4*a))
</li></ul>
}
\if{\step>1}{<p style="color:green">
\(x_S =\xS) et \(y_S=)\(a \frac{b^2}{4 a^2}-b \frac{b}{2 a}+c=)\(\frac{-b^2+4ac}{4a})<br>
Or \(a \neq 0) donc \(a*(x-x_S)^2+y_S=0) équivaut à \((x-x_S)^2=-\frac{y_S}{a})
</p>
}
\if{\step=2}{
Compléter en fonction de \(a), \(b) et \(c) :
<div class="wimscenter">
<label for="reply4">\(-\frac{y_S}{a}) =</label> \embed{reply4,10}/\((4*a^2)).
</div>
}
\if{\step>2}{
<p style="color:green">
On pose \(\Delta=b^2-4ac).<br>
\(a*x^2+b*x+c=0) équivaut à \((x-x_S)^2=\frac{b^2-4ac}{4a^2})
et à \((x-x_S)^2=\frac{\Delta}{4a^2})
 </p>
}
\if{\step=3}{
<ul><li>
Si \(\Delta>0), alors <label for="reply5">le nombre de solutions de \(a*x^2+b*x+c=0) est</label>
  \embed{reply5,5}.
</li><li>
Si \(\Delta=0), alors <label for="reply6">le nombre de solutions de \(a*x^2+b*x+c=0) est</label>
  \embed{reply6,5}.
</li><li>
Si \(\Delta<0), alors <label for="reply7">le nombre de solutions de \(a*x^2+b*x+c=0) est</label>
  \embed{reply7,5}.
</li></ul>
}
\if{\step>3}{
<p style="color:green">
\(a*x^2+b*x+c=0) équivaut à \((x+\frac{b}{2 a})^2=\frac{\Delta}{4a^2}).</p>
}
\if{\step=4}{
<p>Si \(\Delta>0) alors les solutions de \(a*x^2+b*x+c=0) sont :</p>
<ul class="inline"><li>\embed{reply8,1}</li><li>\embed{reply8,2}</li>
<li>\embed{reply8,3}
 </li><li>\embed{reply8,4}</li><li>\embed{reply8,5}</li>
 <li>\embed{reply8,6}</li></ul>
<p>
Si \(\Delta=0) alors la solution de \(a*x^2+b*x+c=0) est :</p>
<ul class="inline"><li>\embed{reply9,1}</li><li>\embed{reply9,2}</li><li>\embed{reply9,3}
</li><li>\embed{reply9,4}</li></ul>
}
\if{\step=5}{
<div style="color:green">
<p>Si \(\Delta>0) alors les solutions de \(a*x^2+b*x+c=0) sont :</p>
<div class="wimscenter">
\(x_1=) \t5 et \(x2=) \t6</div>
<p>
Si \(\Delta=0) alors la solution de \(a*x^2+b*x+c=0) est :</p>
<div class="wimscenter">
\(x_S=) \u4.</div>
</div>
\(f(x)) = \(a*(x-x_S)^2+y_S) = \(a) &#91 \((x-x_S)^2+\frac{y_S}{a}) &#93 = \(a) &#91 \((x-x_S)^2-\frac{\Delta}{4 a^2}) &#93<br>
<p>
Si \(\Delta \ge 0) alors \(f(x)) = \(a) &#91 \((x-x_S)^2-(\frac{\sqrt{\Delta}}{2a})^2) &#93 =
\embed{reply10,300x60x1}<br>
Donc\(f(x)) = \embed{reply11,300x60x1} <strong>en fonction de \(x_1) et \(x_2)</strong></p>
<p>
Si \(\Delta = 0) alors \(f(x)) = \embed{reply12,300x60x1}
</p>
}
}
\answer{xS}{\xS}{type=algexp}
\answer{yS}{\yS}{type=algexp}
\answer{Numérateur de yS}{\NyS}{type=algexp}
\answer{\(\Delta)}{\D}{type=algexp}
\answer{\(\Delta>0)}{2}{type=numeric}
\answer{\(\Delta=0)}{1}{type=numeric}
\answer{\(\Delta<0)}{0}{type=numeric}
\answer{2 solutions}{5,6;\t1,\t2,\t3,\t4,\t5,\t6}{type=checkbox}{option=shuffle}
\answer{1 solution}{4;\u1,\u2,\u3,\u4}{type=checkbox}{option=shuffle}
\answer{Factorisation 1}{\v7;\List}{type=clickfill}
\answer{Factorisation 1}{\v1;\List}{type=clickfill}
\answer{Factorisation 2}{\v5;\List}{type=clickfill}

\hint{
\if{\step=1}{
En développant la forme canonique on a montré que \(-2*a*x_S=b) en déduire \(x_S).<br>
De plus, \(y_S=f(x_S)=a*x_S^2+b*x_S+c).
}
\if{\step=2}{
\(-\frac{y_S}{a}=-\frac{1}{a}\times\frac{-b^2+4ac}{4a}=\frac{?}{4a^2})
}
\if{\step=3 or \step=4}{
Si \(\Delta>0) alors \(\frac{\Delta}{4a^2}=(\frac{\sqrt{\Delta}}{2a})^2) et \(X^2=k^2) a deux solutions \(-k) et \(k).<br>
\(X^2=0) équivaut à \(X=0).<br>
Si \(k<0) alors \(X^2=k) n'a pas de solution dans \(\ \RR\).
}
}
\solution{
<p>On considère le trinôme \(f(x)=a*x^2+b*x+c) avec \(a \neq 0).</p>
<p>Sa forme canonique est \(a*(x-x_S)^2+y_S).</p>
<ul class="wims_nopuce">
<li>\(x_S = \xS)<li>
<li>\(y_S= a \frac{b^2}{4 a^2} + b \frac{-b}{2 a} + c = \frac{b^2}{4 a} - \frac{2 b^2}{4 a}
  + \frac{4 a c}{4 a} =) \(\frac{-b^2+4ac}{4a})</li>
</ul>
\if{\step>1}{
<ul class="wims_nopuce">
<li>Or \(a \neq 0) donc :</li>
<li>\(a*(x-x_S)^2+y_S=0) équivaut à \((x-x_S)^2=-\frac{y_S}{a})</li>
<li>De plus \(-\frac{y_S}{a}=\frac{b^2-4 a c}{4 a^2})</li>
</ul>
}
\if{\step>2}{
<ul class="wims_nopuce">
<li>On pose \(\Delta=b^2-4ac).</li>
<li>\(a*x^2+b*x+c=0) équivaut à :</li>
</ul>
<div class="wimscenter">
<ul class="wims_nopuce">
<li>\(a*(x-x_S)^2+y_S=0)</li>
<li>\((x-x_S)^2=-\frac{y_S}{a})</li>
<li>\((x-x_S)^2=\frac{b^2-4ac}{4a^2})</li>
<li>\((x-x_S)^2=\frac{\Delta}{4a^2}).</li>
</ul>
</div>
<ul><li>
Si \(\Delta>0) alors \(a*x^2+b*x+c=0) a 2 solutions.</li><li>
Si \(\Delta=0) alors \(a*x^2+b*x+c=0) a 1 solution.</li><li>
Si \(\Delta<0) alors \(a*x^2+b*x+c=0) n'a aucune solution.</li></ul>
}
\if{\step>3}{
<ul class="wims_nopuce">
<li>Si \(\Delta>0) alors les  2 solutions de \(a*x^2+b*x+c=0) sont
\(x_1=) \t5 et \(x2=) \t6</li>


 \if{\step>4}{<li>Et \(f(x) = a(x - x_1) (x - x_2)).</li>}
</ul>
<ul class="wims_nopuce">
<li>Si \(\Delta=0) alors la solution de \(a*x^2+b*x+c=0) est :
\(x_S=) \u4.</li>

\if{\step>4}{<li>Et \(f(x) = a(x - x_1) (x - x_2) = a (x - x_S)^2)</li>}
</ul>
  }
}
