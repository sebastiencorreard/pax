\title{Différentes formes d'un trinôme}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)}

\integer{u=randint(-10..10)}

\integer{v=randint(-10..10)}

\function{fc=maxima(\a*(x-\u)^2-\a*(\v)^2)}
\function{fd=maxima(expand(\fc))}
\function{ff=maxima(\a*(x-\u-\v)*(x-\u+\v))}

\steps{
reply 1
reply 2
}

\statement{On considère le trinôme \(f(x)=\fc).
\if{\step=1}{
<p>Déterminer la forme factorisée de \(f).</p>
<div><label for="reply1">La forme factorisée de \(f) est :</label> \embed{reply 1,20}.</div>
<div class="wims_instruction">
La forme factorisée sera donnée sous la forme \((x-u)(x-v)) ou \(-(x-u)(x-v)).
</div>
}
\if{\step=2}{
<p>La forme factorisée de \(f) est \(f(x)=\ff).</p>
<div><label for="reply2">La forme développée de \(f) est alors</div> \embed{reply 2,20}.</p>
}
}

\answer{Forme factorisée}{\ff}{type=algexp}
\answer{Forme développée}{\fd}{type=algexp}

\hint{<p>La forme canonique d'un trinôme est \(a(x-d)^2+k), où \(d) et
\(k) sont les abscisses et ordonnées du sommet de la parabole représentant le trinome.</p>
<p>Pour déterminer la forme factorisée à partir de la forme canonique, on peut
utiliser l'identité remarquable \(a^2-b^2=(a-b)(a+b)).</p>
<p>En cas de message vous invitant à écrire la forme factorisée autrement,
pensez à changer l'ordre des facteurs.</p>
}
