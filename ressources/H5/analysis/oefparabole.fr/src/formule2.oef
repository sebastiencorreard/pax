\title{Trouver une formule associée à x^2 (3)}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% couleur des grilles
\text{gridcolor=lightblue}

%% Choix aléatoire de la constante
\integer{c=random(1..4)*random(1,-1)}
\integer{d=random(1..4)*random(1,-1)}

%% fonction de référence
\function{r=x^2}

%% Calcul de la fonction et associées

\function{f=( x + \c)^2+\d}

%% Position de l'extema %%
\integer{px= -\c}
\integer{py= \d}
\integer{ex= -\c}
\integer{ey= \d}

%% Calcul de l'échelle sur y

\integer{yoffset=0}

%% centrage de l'image
\integer{ymin=-6}
\integer{ymax=10}

%% cadre générique %%
\text{cadre=
xrange -8,8
yrange \ymin,\ymax
linewidth 1
parallel -8,\ymin,-8,\ymax,1,0,20,\gridcolor
linewidth 1
parallel -8,\ymin,8,\ymin,0,1,17,\gridcolor
linewidth 3
arrow 0,\ymin,0,\ymax,10,black
arrow -8,0,8,0,10,black
arrow 0,0,1,0,10,magenta
arrow 0,0,0,1,10,magenta
text red,0.3,-0.3,large,i
text red,-0.5,0.7,large,j
text black,-0.2,-0.1,large,O
linewidth 3
plot blue,\r
plot red,\f
}
%% fin du cadre générique %%
\text{url=draw(400,400
\cadre)}


%% Indication
\text{theo1=<br>Remplacer \(x) par (\(x + k)) dans \(\r) translate sa courbe de
<ul>
 <li> \(k) unités vers la gauche si \(k) est positif </li>
 <li>\(-k) unités vers la droite si \(k) est négatif.</li>
</ul>
Ajouter une constante \(k) à \(f(x)) translate la courbe de \(f) de
<ul>
 <li> \(k) unités vers le haut si \(k) est positif </li>
 <li>\(-k) unités vers le bas si \(k) est négatif.</li>
</ul>}

%% Solution et texte alternatif à l'image
\integer{k=\c>0 ? \c: -\c}
\text{sol=(\c)^2>1 ? unités:unité}
\text{sol=\c>0 ? \k \sol vers la gauche:\k \sol vers la droite}
\integer{k=\d>0 ? \d: -\d}
\text{sol2=(\d)^2>1 ? unités:unité}
\text{sol2=\d>0 ? \k \sol2 vers le haut:\k \sol2 vers la bas}
\text{ti=La courbe cherchée est celle de la fonction carré translatée de \sol et de \sol2}
\text{sol=\ti donc elle a pour équation \(y) = \(\f).}

%% enoncé de l'exo %%
\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\url" alt="\ti"></div>
<div class="medium_size text_col">
  Dans le plan muni d'un repère orthogonal \((O,i,j)\),
on a tracé la courbe représentative de la fonction carré (en bleu) et d'une fonction \(f) en
rouge.
Par lecture graphique déterminer l'expression de \(f).
<div><label for="reply1">\(f(x)=)</label> \embed{reply1,10}</div>
</div></div>
}
%% soumission de réponse %%
\hint{\theo1}
\answer{\(f(x)) =}{\f}{type=function}
\solution{\sol}
