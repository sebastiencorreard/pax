\title{Trouver une formule associée à x^2 (1)}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% couleur des grilles
\text{gridcolor=lightblue}

%% Choix aléatoire de la constante et du type
\integer{c=randint(1..5)*randint(1,-1)}
\integer{d=random(1,1,1,2,2,2,3)}

%% fonction de référence
\function{r=x^2}

%% Calcul de la fonction et associées
\text{f= \d=1 ? x^2 +\c : - x ^2}
\text{f= \d=2 ? ( x + \c)^2 :\f }
\function{f= \f}
%% Texte alternatif à l'image
\if{\d=2}{\integer{Xs=-\c}}{\integer{Xs=0}}
\if{\d=1}{\integer{Ys=\c}}{\integer{Ys=0}}
\if{\d=3}{\integer{Y1=\Ys-1}}{\integer{Y1=\Ys+1}}
\integer{X1=\Xs-1}
\integer{X2=\Xs+1}
\text{t=La courbe de f en rouge passe par \X1,\Y1 puis \Xs,\Ys et \X2,\Y1}

%% Calcul de l'échelle sur y

\integer{yoffset=0}
%% centrage de l'image
\integer{ymin=-6}
\integer{ymax=10}

%% cadre générique %%
\text{cadre=
xrange -8,8
yrange \ymin,\ymax
linewidth 1
parallel -8,\ymin,-8,\ymax,1,0,20,\gridcolor
linewidth 1
parallel -8,\ymin,8,\ymin,0,1,17,\gridcolor
linewidth 3
arrow 0,\ymin,0,\ymax,10,black
arrow -8,0,8,0,10,black
arrow 0,0,1,0,10,magenta
arrow 0,0,0,1,10,magenta
text red,0.3,-0.3,large,i
text red,-0.5,0.7,large,j
text black,-0.2,-0.1,large,O
linewidth 3
plot blue,\r
plot red,\f
}
## fin du cadre générique ##
\text{url=draw(500,500
\cadre)}
## Préparation des réponses

## Indication
\text{theo1=
<br>Remplacer \(x) par (\(x + k)) dans \(\r) translate sa courbe de
<ul>
 <li> \(k) unités vers la gauche si \(k) est positif </li>
 <li>\(-k) unités vers la droite si \(k) est négatif.</li>
</ul>
Multiplier \(f(x)) par -1 transforme la courbe de \(f) en son symétrique par rapport à l'axe des abscisses.
<br>Ajouter une constante \(k) à \(f(x)) translate la courbe de \(f) de
<ul>
 <li> \(k) unités vers le haut si \(k) est positif </li>
 <li>\(-k) unités vers le bas si \(k) est négatif.</li>
</ul>

 }

## Solution
\integer{k=\c>0 ? \c: -\c}
\text{sol=(\c)^2>1 ? unités : unité}
\text{sol1=\c>0 ? \k \sol vers le haut:\k \sol vers le bas}
\text{sol2=\c>0 ? \k \sol vers la gauche:\k \sol vers la droite}
\text{sol=\d = 1 ? \sol1 : \sol2}
\text{sol=La courbe cherchée est celle de la fonction carré translatée de \sol
donc elle a pour équation : \(y) = \(\f).}
\text{sol1=La courbe cherchée est symétrique de celle de la fonction carré
par rapport à l'axe des abscisses donc elle a pour équation :\(y) = \(\f).}
\text{sol=\d=3 ? \sol1 : \sol}

