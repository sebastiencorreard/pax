\title{À l'extrême}
\language{fr}
\range{-10..10}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{50}

\integer{n=randint(1,2)}
\integer{a=2*\n-3}
\integer{xS=randint(-1,1)*randint(1..6)}
\integer{yS=randint(-1,1)*randint(1..6)}
\integer{xT=\xS+1}
\integer{yT=\yS+\a}

\function{f=\a*(x-\xS)^2+\yS}
\text{extr=\a>0? minimum : maximum }

\real{pixMx=(300*\xS / 8 + 300)/2}
\real{pixMy=(-300*\yS / 8 + 300)/2}
\real{pixTx=(300*\xT / 8 + 300)/2}
\real{pixTy=(-300*\yT / 8 + 300)/2}

\text{lerepere=
xrange -8,8
yrange -8,8
parallel -8,-8,-8,8,1,0, 17, grey
parallel -8,-8,8,-8,0,1, 17, grey
hline 0,0,black
vline 0,0,black
arrow 0,0,1,0,8, black
arrow 0,0,0,1,8, black
text black, -7.4 ,-0.1 , small, -7
text black, -6.4 ,-0.1 , small, -6
text black, -5.4 ,-0.1 , small, -5
text black, -4.4 ,-0.1 , small, -4
text black, -3.4 ,-0.1 , small, -3
text black, -2.4 ,-0.1 , small, -2
text black, -1.4 ,-0.1 , small, -1
text black,  0,-0.1 , small, 0
text black,  1,-0.1 , small, 1
text black,  2,-0.1 , small, 2
text black,  3,-0.1 , small, 3
text black,  4,-0.1 , small, 4
text black,  5,-0.1 , small, 5
text black,  6,-0.1 , small, 6
text black,  7,-0.1 , small, 7
text black,  -0.9,-6.6, small, -7
text black,  -0.9,-5.6, small, -6
text black,  -0.9,-4.6, small, -5
text black,  -0.9,-3.6, small, -4
text black,  -0.9,-2.6, small, -3
text black,  -0.9,-1.6, small, -2
text black,  -0.9,-0.7, small, -1
text black,  -0.5,0.4, small, 0
text black,  -0.5,1.4, small, 1
text black,  -0.5,2.4, small, 2
text black,  -0.5,3.4, small, 3
text black,  -0.5,4.4, small, 4
text black,  -0.5,5.4, small, 5
text black,  -0.5,6.4, small, 6
text black,  -0.5,7.4, small, 7

}
\text{ledessin=draw(300,300
\lerepere
)
}
\text{dessin2=draw(300,300
\lerepere
fcircle \xS,\yS, 8 , blue
text blue, \xS ,\yS+1 , small, S
)
}

\steps{reply1,reply2,reply3,reply4
reply5}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">
  \if{\step=1}{\embed{reply 4}}
  \if{\step=2}{\embed{reply 5}
}
</div><div class="medium_size text_col">
<p>Dans le repère orthonormé ci-dessous, on veut tracer la parabole d'équation
\(y=\a*(x-\xS)^2+\yS).
</p>
\if{\step=1}{<div>
Quelles sont les coordonnées du sommet \(S) de cette parabole ?
<ul class="wims_nopuce"><li>
<label for="reply1">\(x_S =)</label> \embed{reply 1,10}</li><li>
<label for="reply1">\(y_S =)</label> \embed{reply 2,10}
</li></ul>
Ce sommet correspond-il à un \embed{reply 3,1} ou un \embed{reply 3,2} ?
<p>
Pour terminer cette question, <b>clique sur le point S sur le graphique</b>.
</p>
</div>
}
\if{\step=2}{
  Tu as trouvé et placé le point \(S(\xS;\yS)) et que ce point correspond à un \extr.<br>
  <b>Clique maintenant sur le graphique sur le point d'abscisse \xT.</b>.
}
</div></div>
}

\answer{xS}{\xS}{type = numeric}
\answer{yS}{\yS}{type = numeric}
\answer{Extremum}{\n;maximum,minimum}{type = radio}
\answer{S}{\ledessin ; point, \pixMx, \pixMy}{type = coord}
\answer{T}{\dessin2 ; point, \pixTx, \pixTy}{type = coord}

\hint{
\if{\step=1}{
La forme canonique d'un trinôme est \(a*(x-x_S)^2+y_S) et ici \(a) vaut 1 ou -1.<br>
Les coordonnées du sommet sont alors \((x_S;y_S)).
\if{\xS<0}{<p>
  Attention au signe de \(x_S) !
  </p>
}
<p>
Si la courbe peut être obtenue par une translation à partir de celle d'équation \(y=x^2),
alors le sommet correspond à un minimum.</p>
<p>
Si la courbe peut être obtenue par une translation à partir de celle d'équation \(y=-x^2),
alors le sommet correspond à un maximum.</p>
}
\if{\step=2}{
Tu peux calculer l'ordonnée du point d'abscisse \xT.<br>
Ou bien te rappeler que la courbe est obtenue par translation à partir de celle d'équation :
\(y=\a*x^2).
}
}

\solution{La parabole est représentée ci-dessous avec son sommet \(S) et le point \(T).
<div class="wimscenter">
\draw{300,300}{
\lerepere
fcircle \xS,\yS, 8 , blue
text blue, \xS ,\yS+1 , small, S
linewidth 2
plot red, \f
fcircle \xT,\yT, 8 , blue
text blue, \xT+0.5 ,\yT+1 , small, T
}
</div>
}
