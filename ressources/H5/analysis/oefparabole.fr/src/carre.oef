\title{Fonction carré}
\language{fr}
\range{-10..10}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{50}

\function{f1=x^2+0*sqrt(x)+0*sqrt(1-x)}
\function{f2=x^2+0*sqrt(x+1)+0*sqrt(1-x)}
\function{f3=x^2+0*sqrt(x+1)+0*sqrt(2-x)}
\function{f4=x^2+0*sqrt(x+2)+0*sqrt(2-x)}
\function{f5=x^2}

\text{lerepere=
xrange -4,4
yrange -2,10
parallel -4,-2,-4,10,1,0, 9, lightblue
parallel -4,-2,10,-2,0,1, 13, lightblue
arrow -4,0,4,0,8, black
arrow 0,-2,0,10,8, black

text black, 0,-0.1 , small, 0
text black, 1,-0.1 , small, 1
text black, 2,-0.1 , small, 2
text black, 3,-0.1 , small, 3
text black, -1.1,-0.1 , small, -1
text black, -2.1,-0.1 , small, -2
text black, -3.1,-0.1 , small, -3

text black, -0.5,0.4, small, 0
text black, -0.5,1.4, small, 1
text black, -0.5,2.4, small, 2
text black, -0.5,3.4, small, 3
text black, -0.5,4.4, small, 4
text black, -0.5,5.4, small, 5
text black, -0.5,6.4, small, 6
text black, -0.5,7.4, small, 7
text black, -0.5,8.4, small, 8
text black, -0.5,9.4, small, 9

fcircle 0,0,6, blue
}

\text{ledessin=draw(200,300
\lerepere
)
}
\text{dessin1=draw(200,300
\lerepere
fcircle 1,1, 8 , blue
plot red, \f1
)
}
\text{dessin2=draw(200,300
\lerepere
fcircle 1,1, 6 , blue
fcircle -1,1, 8 , blue
plot red, \f2
)
}
\text{dessin3=draw(200,300
\lerepere
fcircle 1,1, 6 , blue
fcircle -1,1, 6 , blue
fcircle 2,4, 8 , blue
plot red, \f3
)
}
\text{dessin4=draw(200,300
\lerepere
fcircle 1,1, 6 , blue
fcircle -1,1, 6 , blue
fcircle 2,4, 6 , blue
fcircle -2,4, 8 , blue
plot red, \f4
)
}
\text{dessin=
\lerepere
fcircle 1,1, 6 , blue
fcircle -1,1, 6 , blue
fcircle 2,4, 6 , blue
fcircle -2,4, 6 , blue
fcircle 3,9, 8 , blue
plot red, \f5
}
\text{dessin5=draw(200,300
\dessin
)
}

\steps{reply1
reply2
reply3
reply4
reply5
reply6}

\statement{
<p>Dans le repère orthonormé ci-dessous, on veut tracer la parabole d'équation \(y=x^2).<br>
Le point d'abscisse 0 qui est le sommet de la parabole est déjà placé.
</p>

\if{\step=1}{
Clique sur le point d'abscisse <strong>1</strong>
<div class="wimscenter">
\embed{reply 1}
</div>}
\if{\step=2}{
Clique sur le point d'abscisse <strong>\(-1)</strong>
<div class="wimscenter">
\embed{reply 2}
</div>}
\if{\step=3}{
Clique sur le point d'abscisse <strong>2</strong>
<div class="wimscenter">
\embed{reply 3}
</div>}
\if{\step=4}{
Clique sur le point d'abscisse <strong>\(-2)</strong>
<div class="wimscenter">
\embed{reply 4}
</div>}
\if{\step=5}{
Clique sur le point d'abscisse <strong>3</strong>
<div class="wimscenter">
\embed{reply 5}
</div>}
\if{\step=6}{
Clique sur le point d'abscisse <strong>\(-3)</strong>
<div class="wimscenter">
\embed{reply 6}
</div>}

}

\answer{Abscisse 1}{\ledessin ; point, 125, 225}{type = coord}
\answer{Abscisse -1}{\dessin1 ; point, 75, 225}{type = coord}
\answer{Abscisse 2}{\dessin2 ; point, 150, 150}{type = coord}
\answer{Abscisse -2}{\dessin3 ; point, 50, 150}{type = coord}
\answer{Abscisse 3}{\dessin4 ; point, 175, 25}{type = coord}
\answer{Abscisse -3}{\dessin5 ; point, 25, 25}{type = coord}

\solution{La parabole est représentée ci-dessous.
<div class="wimscenter">
\draw{200,300}{
\dessin
fcircle -3,9, 8 , blue
}
</div>
}
