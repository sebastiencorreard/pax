\title{Utilisation de la forme canonique d'un trinôme}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)*randint(1..5)}
\integer{u=randint(-10..10)}

\integer{sy=randint(-10..10)}
\function{fc=maxima(\a*(x-\u)^2+\sy)}

\integer{h=random(1,2)}

\if{\h=1}{
  \text{Lvar=décroissante puis croissante,croissante puis décroissante}
  \integer{var=\a>0?1:2}
}{
  \text{Lvar=croissante puis décroissante,décroissante puis croissante}
  \integer{var=\a>0?2:1}
}

\statement{On considère le trinôme \(f(x)=\fc).

Déterminez les variations de \(f).
<div>\(f) est : \embed{reply 1}.</div>

Déterminez les coordonnées du sommet de la parabole qui représente \(f).
<ul><li><label for="reply2">L'abscisse du sommet est</label> \embed{reply 2,20}.</li>
<li><label for="reply3">L'ordonnée du sommet est</label> \embed{reply 3,20}.</li></ul>
}

\answer{Variations}{\var;\Lvar}{type=menu}
\answer{abscisse du sommet}{\u}{type=auto}
\answer{ordonnée du sommet}{\sy}{type=auto}

\hint{La forme canonique d'un trinôme est \(a(x + d)^2 + e).
<ul><li>
Si \(a) est strictement positif, la fonction a un minimum,\(e) qui est atteint lorsque \(x = - d).
</li><li>
Si \(a) est strictement négatif, la fonction a un maximum,\(e) qui est atteint lorsque \(x = - d).
</li><li>
Les coordonnées du sommet de la parabole représentant le trinôme sont \(- d) et \(e).
</li></ul>
}
