\title{Utilisation de la forme canonique d'un trinôme 2}
\language{fr}
\range{-5..5}
\author{Rémi, Belloeil}
\email{rbelloeil@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)*randint(2..5)}

\integer{u=random(-1,1)*randint(6..10)}

\integer{sy=random(-1,1)*randint(11..20)}

\function{fc=maxima(\a*(x-\u)^2+\sy)}

\integer{h=random(1,2)}

\if{\h=1}{
  \text{Lvar=décroissante puis croissante,croissante puis décroissante}
  \integer{var=\a>0?1:2}
}{
  \text{Lvar=croissante puis décroissante,décroissante puis croissante}
  \integer{var=\a>0?2:1}
}

### la liste des objets que l'on peut cliquer pour résoudre l'exercice ###
\text{vse=\(\searrow)}
\text{vne=\(\nearrow)}

\text{vesp=&nbsp}
\text{infg=\(-\infty)}
\text{infd=\(+\infty)}

\text{permut=shuffle(\(\a),\(\u),\(-\u),\(-\a),\(\sy),\(-\sy))}
\text{permut= wims(listuniq \permut)}
\text{clicList =\infg \vne,\infd \vse,\vne \infd,\vse \infg,\permut}

\text{grepx =\(\u)}

\if{\a>0}{
  \text{grepfx1 =\infd \vse}
  \text{grepfx2 =\(\sy)}
  \text{grepfx3 =\vne \infd}
}{
  \text{grepfx1 =\infg \vne}
  \text{grepfx2 =\(\sy)}
  \text{grepfx3 =\vse \infg}
}
\text{size=60}

\steps{
reply 1
reply 2,reply 3
reply 4,reply 5,reply6,reply7}

\statement{On considère le trinôme \(f(x)=\fc) défini sur \(\,\RR).<br>
\if{\step=1}{
Déterminer les variations de \(f).<br>
\(f) est :\embed{reply 1}.
}
\if{\step=2}{
Déterminez les coordonnées du sommet de la parabole qui représente \(f). <br>
<label for="reply2">L'abscisse du sommet est</label> \embed{reply 2,20}.<br>
<label for="reply3">L'ordonnée du sommet est</label> \embed{reply 3,20}.
}

\if{\step=3}{
<p>Construire le tableau des variations de \(f)
en déposant les éléments nécessaires dans la ligne \(x)
et dans la ligne \(f(x)) du tableau ci-dessous.</p>
<table class="wimscenter wimsborder">
  <tr>
   <td> \(x) </td>
   <td style="text-align:left" nowrap>\infg \vesp</td>
   <td nowrap>\embed{reply 4,\size}</td>
   <td style="text-align:right" nowrap>\vesp \infd</td>
  </tr>
  <tr>
   <td>\(f(x))</td>
   <td nowrap>\embed{reply 5,\size}</td>
   <td nowrap>\embed{reply 6,\size}</td>
   <td nowrap>\embed{reply 7,\size}</td>
  </tr>
</table>
}

}

\answer{Variations}{\var;\Lvar}{type=menu}
\answer{abscisse du sommet}{\u}{type=auto}
\answer{ordonnée du sommet}{\sy}{type=auto}
\answer{}{\grepx;\clicList}{type=clickfill}
\answer{}{\grepfx1;\clicList}{type=clickfill}
\answer{}{\grepfx2;\clicList}{type=clickfill}
\answer{}{\grepfx3;\clicList}{type=clickfill}

\hint{<p>La forme canonique d'un trinôme est \(a(x - d)^2 + e), où \(d) et
\(e) sont l'abscisse et l'ordonnée du sommet de la parabole représentant le trinôme.</p>
<p>Si \(a) est strictement positif, la fonction a un minimum.<br>
Si \(a) est strictement négatif, la fonction a un maximum.</p>
<p> Exemple de la fonction carré : \(f(x) = (1)(x-0)^2+0)<p>
  <table border="2" align="center" width="50%">
  <tr>
  <td align="center">
  \(x) </td><td align="center" nowrap>\infg </td><td align="center" nowrap>\vesp</td>
  <td align="center" nowrap>0</td><td align="center" nowrap>\vesp</td><td align="center" nowrap> \infd
  </td></tr>
  <tr>
  <td align="center">
  \(f(x)) </td><td align="center" nowrap>\infd </td><td align="center" nowrap>\vse</td>
  <td align="center" nowrap>0</td><td align="center" nowrap>\vne</td><td align="center" nowrap> \infd
  </td>
  </tr>
</table>
}
\solution{
<table class="wimscenter wimsborder">
  <tr>
   <td> \(x) </td>
   <td style="text-align:left" nowrap>\infg \vesp</td>
   <td nowrap>\grepx</td>
   <td style="text-align:right" nowrap>\vesp \infd</td>
  </tr>
  <tr>
   <td>\(f(x))</td>
   <td nowrap>\grepfx1</td>
   <td nowrap>\grepfx2</td>
   <td nowrap>\grepfx3</td>
  </tr>
</table>
}
