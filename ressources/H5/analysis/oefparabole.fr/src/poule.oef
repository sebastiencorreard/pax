\title{Les poules en plein air}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% Choix des paramètres %%
\integer{P=10*randint(4..10)}
\integer{h=randint(3..5)}
\integer{l=randint(5..7)}
\real{xS=0.25*(\P+\h+\l)}

\integer{b2=\l+\h}
\integer{b1=\P+\b2}
\real{b=0.5*\b1}
\integer{c1=\l*\h}
\integer{c=-\c1}

\real{yS=\xS^2+\c}

\function{A=L*x-\c1}

\function{fd=-x^2+\b*x+\c}

\function{fc=-(x-\xS)^2+\yS}

\function{G=2*x+2*L-\b2}
\text{L=\b-x}

%%% cadre initial %%%
\text{cadre=
xrange -4,46
yrange -4,36
linewidth 2

frect 0,0,40,30,green
rect 0,0,40,30,red

frect 40-2*\l,0,40,2*\h,white
rect 40-2*\l,0,40,2*\h,black

arrow2 -0.5,0,-0.5,30,8,black
arrow2 40-2*\l,-1,40,-1,8,black
arrow2 41,0,41,2*\h,8,black
arrow2 0,30.5,40,30.5,8,black

text black,-2,15,medium,x
text black,40-\l,-1.5,medium,\l
text black,42,\h,medium,\h
text black,20,35,medium,L
text black,41-2*\l,\h,medium,Poulailler

}
\integer{L4=4*\xS}
\integer{b4=4*round(\xS+0.75)+10}

\text{plan=
xrange -10,\b4
yrange -10,\b4
linewidth 2

frect 0,0,\L4,\L4,green
rect 0,0,\L4,\L4,red

frect \L4-4*\l,0,\L4,4*\h,white
rect \L4-4*\l,0,\L4,4*\h,black

text black,-9,2*\xS,medium,\xS
text black,\L4-2*\l,-1.5,small,\l
text black,\L4+2,2*\h+2,small,\h
text black,2*\xS,\L4+8,medium,\xS

text black,10,20,medium,A = Lx-\c1
}
\steps{reply1,reply2
reply3,reply4
reply5,reply6}

%%%%%%% Enoncé %%%%%%%
\statement{
<div class="wims_columns">
 <div class="medium_size img_col">
 \draw{400,320}{\cadre}
 </div><div class="medium_size text_col">
  <ul class="wims_nopuce">
  <li>On veut réaliser un enclos rectangulaire délimité par \P m de grillage (en rouge) qui
  inclut un poulailler rectangulaire de \l m sur \h m, dans l'un des coins.</li>
  <li>Il n'y a pas de grillage le long du mur.</li>
  <li>On cherche les dimensions \(x) et \(L) en mètres pour lesquelles l'aire de
  l'enclos hors poulailler est maximale.
  </li>
  </ul>
</div></div>
\if{\step=1}{
<h2>Étape 1</h2>
<ul><li>
<label for="reply1">Quelle est l'expression de l'aire hors enclos en fonction de \(x) et \(L) ?</label>
\embed{reply 1,15}.
</li><li>
<label for="reply2">Quelle est l'expression de la longueur du grillage en fonction de \(x) et \(L) ?</label>
\embed{reply 2,15}
</li></ul>
}
\if{\step=2}{
<h2>Étape 2</h2>
<p>L'aire hors enclos est bien \(A=\A).</p>
<p>Et la longueur du grillage est \(\G=\P).</p>
<p>Exprimer \(L) en fonction de \(x) à l'aide de la 2ème formule :</p>
<div class="wimscenter">
<label for="reply3">\(L) =</label> \embed{reply 3,10}
</div>
<p>Substituer l'expression trouvée à L dans \(A) pour obtenir une expression
qui dépend seulement de \(x).</p>
<div class="wimscenter">
<label for="reply4">\(A) =</label> \embed{reply 4,15}.
</div>
<p>On note cette expression \(f(x)).</p>
}
\if{\step=3}{
<h2>Étape 3</h2>
<p>La longueur du grillage est \(\G=\P) donc \(L=\L).</p>
<p>Et l'aire hors enclos est \(f(x)=\fd).</p>
<p>Déterminer \(x) pour que \(\fd) soit maximale.</p>
<div class="wimscenter">
Réponse : <label for="reply5">\(x) = </label>\embed{reply 5,5}.</div>
Puis en déduire la valeur de \(L).
<div class="wimscenter">
<label for="reply6">\(L) = </label>\embed{reply 6,5}.</div>
 }
}

\answer{Aire}{\A}{type=function}
\answer{Grillage}{\G}{type=function}
\answer{\(L=)}{\L}{type=function}
\answer{\(f(x))}{\fd}{type=function}
\answer{\(x)}{\xS}{type=numeric}
\answer{\(L)}{\xS}{type=numeric}

\hint{
\if{\step=1}
  {<ul class="wims_nopuce">
  <li>Retrancher l'aire du poulailler à l'aire du grand rectangle
  pour obtenir l'aire de l'enclos hors poulailler.</li>
  <li>La longueur du grillage est obtenue en ajoutant x, L, x-\h et ...</li>
  </ul>
  }
\if{\step=2}
  {
  \(A=f(x)) ne doit comporter que la variable \(x) et des valeurs numériques.
  }
\if{\step=3}
  {
  L'expression canonique de \(\fd) est \(\fc).
  }
}
\solution{<div class="float_right">
  \draw{300,300}{\plan}</div>
  <div>
  <ul class="wims_nopuce">
  <li>L'aire hors enclos est \(A=\A) et la longueur du grillage est \(\G=\P) avec \(L=\L).</li>
  <li>Donc \(A=f(x)=\fd).</li>
  <li>Elle est maximale pour \(x=\xS) et \(L=\xS).</li>
  </ul>
  </div>
}
