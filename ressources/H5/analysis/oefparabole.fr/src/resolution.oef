et en utilisant sqrt(2) pour écrire \(sqrt(2)) si besoin.</li><li>
Écrire <span class="tt">vide</span> si l'équation n'a pas de solution.
</li></ul>
</div>

}
\answer{Nombre de solutions S1 }{\n1}{type = numeric}{option = nonstop}
\answer{S1}{\S1}{type=aset}{option = nonstop}
\answer{Nombre de solutions S2}{\n2}{type=numeric}{option = nonstop}
\answer{S2}{\S2}{type=aset}{option = nonstop}
\answer{Nombre de solutions S3}{\n3}{type=numeric}{option = nonstop}
\answer{S3}{\S3}{type=aset}{option = nonstop}
\answer{Nombre de solutions S4}{\n4}{type=numeric}{option = nonstop}
\answer{S4}{\S4}{type=aset}{option = nonstop}
\answer{Nombre de solutions S5}{\n5}{type=numeric}
\answer{S5}{\S5}{type=aset}

