\title{Résolution de 5 équations aléatoires de degré 2}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}
\precision{ 10000 }

%%Les 5 cas d'équations%%

%% Chaque exercice comportera d'abord 4 équations de la forme ax² + bx + c = 0 %%
%% de chacun des 4 premiers cas dans un ordre aléatoire %%
%% suivies d'une équation du 5ème cas où les coefficients sont aléatoires. %%
%% Les coefficients a, b et c de ax² + bx + c seront toujours tous non nuls. %%
%% Il y aura au moins une équation avec a < 0 et au moins une avec a>0. %%

%%Cas 1 1 racine décimale %%
\integer{n1=1}
\integer{k1=randint(-1,1)}
\real{x1=0.1*random(-1,1)*randint(10..100)}
\real{a1=100*\k1*randint(1..10)}
\real{b1=-2*\a1*\x1}
\real{c1=\a1*\x1*\x1}
\text{S1=\x1}
\text{R1=Le discriminant est 0 donc l'équation a 1 seule solution.}
\text{P1=\a1*x^2+\b1*x+\c1}

%%Cas 2 2 racines décimales %%
\integer{n2=2}
\integer{k2=-\k1}
\real{x2=random(-1,1)*randint(1..20)}
\real{y2=\x2+0.1*randint(10..200)}
\if{\y2=0}{\real{y2=0.1*randint(10..100)}}
\real{a2=10*\k2*randint(1..9)}
\real{b2=-\a2*(\x2+\y2)}
\real{c2=\a2*\x2*\y2}
\text{S2=\x2,\y2}
\integer{d2=(\b2)^2-4*\a2*\c2}
\text{R2=Le discriminant est \d2 donc l'équation a 2 solutions.}
\text{P2=\a2*x^2+\b2*x+\c2}

%%Cas 3 2 racines réelles pas décimales %%

\integer{n3=2}
\integer{b3=randint(6..12)}
\real{a3=random(0.5,1,2,3)}

\integer{l3=ceil(0.25*(\b3^2-63)/\a3)}
\integer{m3=floor(0.25*(\b3^2-50)/\a3)}

\integer{c3=randint(\l3..\m3)}
\integer{d3=\b3^2-4*\a3*\c3}
\real{x3=(-\b3-sqrt(\d3))/(2*\a3)}
\real{y3=(-\b3+sqrt(\d3))/(2*\a3)}
\text{t3=(-\b3-sqrt(\d3))/(2*\a3)}
\text{u3=(-\b3+sqrt(\d3))/(2*\a3)}
\text{S3=\t3,\u3}
\integer{d3=(\b3)^2-4*\a3*\c3}
\text{R3=Le discriminant est \d3 donc l'équation a 2 solutions.}
\text{P3=\a3*x^2+\b3*x+\c3}

%%Cas 4 pas de racines réelles %%
\integer{n4=0}
\integer{k4=randint(-1,1)}
\integer{r4=random(-1,1)*randint(1..10)}
\integer{i4=random(-1,1)*randint(1..10)}
\integer{a4=\k4*randint(1..10)}
\integer{b4=-2*\a4*\r4}
\integer{c4=\a4*((\r4)^2+(\i4)^2)}
\text{S4=vide}
\integer{d4=(\b4)^2-4*\a4*\c4}
\text{R4=Le discriminant est \(\d4 < 0) donc l'équation n'a pas de solution.}
\text{P4=\a4*x^2+\b4*x+\c4}

%%Cas 5 aléatoire avec coefficients entiers %%
\integer{a5=-\k4*randint(1..10)}
\integer{b5=random(-1,1)*randint(1..10)}
\integer{c5=random(-1,1)*randint(1..100)}
\integer{d5=(\b5)^2-4*\a5*\c5}
\if{\d5<0}{
  \integer{n5=0}
   \text{R5=Le discriminant est \(\d5 < 0) donc l'équation n'a pas de solution.}
   \text{S5=vide}
}{
  \integer{n5=2}
  \real{x5=(-\b5-sqrt(\d5))/(2*\a5)}
  \real{y5=(-\b5+sqrt(\d5))/(2*\a5)}
  \text{t5=(-\b5-sqrt(\d5))/(2*\a5)}
  \text{u5=(-\b5+sqrt(\d5))/(2*\a5)}

  \text{S5=\t5,\u5}
  \text{R5=Le discriminant est \d5 donc l'équation a 2 solutions.}

  \if{\d5=0}{
    \integer{n5=1}
    \text{R5=Le discriminant est 0 donc l'équation a 1 seule solution.}
    \text{S5=-\b5/(2*a)}
  }
}
\text{P5=\a5*x^2+\b5*x+\c5}

%%Modification de l'ordre des 4 premières questions.%%
\text{M=\n1,\n2,\n3,\n4}
\matrix{T=\S1;\S2;\S3;\S4}
\text{Q=\P1,\P2,\P3,\P4}
\text{R=\R1,\R2,\R3,\R4}
\text{H=shuffle(4)}

\text{P1=\Q[\H[1]]}
\integer{n1=\M[\H[1]]}
\text{S1=\T[\H[1];]}
\text{R1=\R[\H[1]]}

\text{P2=\Q[\H[2]]}
\integer{n2=\M[\H[2]]}
\text{S2=\T[\H[2];]}
\text{R2=\R[\H[2]]}

\text{P3=\Q[\H[3]]}
\integer{n3=\M[\H[3]]}
\text{S3=\T[\H[3];]}
\text{R3=\R[\H[3]]}

\text{P4=\Q[\H[4]]}
\integer{n4=\M[\H[4]]}
\text{S4=\T[\H[4];]}
\text{R4=\R[\H[4]]}

\text{bracg=&#123;}
\text{bracd=&#125;}

\steps{reply1,reply2
reply3,reply4
reply5,reply6
reply7,reply8
reply9,reply10}

%%%%%%% enoncé de l'exo %%%%%%%
