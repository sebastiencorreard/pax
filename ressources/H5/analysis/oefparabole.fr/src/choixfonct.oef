\title{Choix d'une fonction associée à x^2}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% couleur des grilles
\text{gridcolor=lightblue}

%% Choix aléatoire de la constante et du type
\integer{c=random(1..4)*random(1,-1)}
\integer{d=random(1,2)}

%% fonction de référence
\function{r=x^2}

%% Calcul de la fonction et associées %%
\text{f= \d=1 ? x^2 +\c : ( x + \c)^2}
\text{f1= \d=2 ? x^2 +\c : ( x + \c)^2}
\function{f= \f}
\function{f1= \f1}
\function{f2=x^2 - \c}
\function{f3=(x-\c)^2}

%% Calcul de l'échelle sur y %%

\integer{yoffset=0}
%% centrage de l'image
\integer{ymin=-5}
\integer{ymax=5}

%% Position de l'extema %%
\integer{px= \d=1 ? -0.2 : -\c}
\integer{Xs= \d=1 ? 0 : -\c}
\integer{py= \d=1 ? \c : 0}
\integer{ex= \d=1 ? \c : -\c}

%% Texte alternatif à l'image %%
\text{t=La courbe rouge est l'image de celle de la fonction carré par une translation et son sommet est \Xs,\py}


%% cadre générique %%
\text{cadre=
xrange -5,5
yrange \ymin,\ymax
linewidth 1
parallel -5,\ymin,-5,\ymax,1,0,11,\gridcolor
linewidth 1
parallel -5,\ymin,5,\ymin,0,1,11,blue
linewidth 3
arrow 0,\ymin,0,\ymax,10,black
arrow -8,0,8,0,10,black
arrow 0,0,1,0,10,magenta
arrow 0,0,0,1,10,magenta
text red,0.3,-0.3,giant,i
text red,-0.5,0.7,giant,j
text black,-0.2,-0.1,giant,O
text black,\px,\py,giant,\ex
linewidth 3
plot blue,\r
plot red,\f
}
%% fin du cadre générique %%
\text{url=draw(400,400
\cadre)}


%% Préparation des réponses
\text{replist=\(\f),\(\f3),\(\f2),\(\f1)}

%% Indication
\text{theo1=Ajouter une constante \(k) à \(\r) translate sa courbe de
<ul>
 <li> \(k) unités vers le haut si \(k) est positif </li>
 <li>\(-k) unités vers le bas si \(k) est négatif.</li>
</ul>
Remplacer \(x) par (\(x + k)) dans \(\r) translate sa courbe de
<ul>
 <li> \(k) unités vers la gauche si \(k) est positif </li>
 <li>\(-k) unités vers la droite si \(k) est négatif.</li>
</ul>}

%% Solution
\integer{k=\c>0 ? \c: -\c}
\text{sol=(\c)^2>1 ? unités : unité}
\text{sol1=\c>0 ? \k \sol vers le haut:\k \sol vers le bas}
\text{sol2=\c>0 ? \k \sol vers la gauche:\k \sol vers la droite}
\text{sol=\d = 1 ? \sol1 : \sol2}
\text{sol=La courbe cherchée est celle de la fonction carré translatée de \sol donc elle a pour équation \(y) = \(\f).}

%% Préparation des questions

%%% enoncé de l'exo %%%
\statement{
<div class="wims_columns">
 <div class="medium_size img_col">
 <img src="\url" alt="\t"></div>
 <div class="medium_size text_col">
  Dans le plan muni d'un repère orthogonal \((O,i,j)\),
  on a tracé la courbe représentative de la fonction carré (en bleu) et
  d'une fonction \(f) en rouge.<br>
  Par lecture graphique déterminer l'expression de \(f).
</div>
</div>

}
%% soumission de réponse %%
\hint{\theo1}
\choice{\(f(x)) =}{\(\f)}{\replist}{option = shuffle}
\solution{\sol}
