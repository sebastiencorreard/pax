\title{Jet d'eau}
\language{fr}
\author{Rémi, Belloeil}
\email{remi.belloeil@orange.fr}
\format{html}

%% Choix aléatoire des constantes
\integer{a=randint(4,5)}
\integer{b=randint(1,5)}
\integer{c=\a+\b}
\real{q=\c/\a}

\real{x0=1+sqrt(\q)}
\text{t0=1+sqrt(\q)}
\text{t1=1+sqrt(\c/\a)}

%% fonction recherchée
\function{f=\c-\a*(x-1)^2}
\function{g=\c-\a*(x-1)^2+0*sqrt(x)+0*sqrt(\x0-x)}

%% taille de l'image
\integer{L=400}

%% cadre générique %%
\text{cadre=
xrange -1,4.5
yrange -0.5,10.5

linewidth 3
arrow 0,0,0,10.5,10,black
arrow 0,0,4.5,0,10,black

text black,-0.5,0.2,medium,0
text black,-0.5,1.2,medium,1
text black,-0.5,2.2,medium,2
text black,-0.5,3.2,medium,3
text black,-0.5,4.2,medium,4
text black,-0.5,5.2,medium,5
text black,-0.5,6.2,medium,6
text black,-0.5,7.2,medium,7
text black,-0.5,8.2,medium,8
text black,-0.5,9.2,medium,9
text black,-0.7,10.2,medium,10

text black,1,-0.1,medium,1
text black,2,-0.1,medium,2
text black,3,-0.1,medium,3
segment 0,\b,2,\b,black
segment 1,\b,1,\c,black
text black,1.2,\b+2,medium,\a

text black,-0.8,4.5,medium,Mur
text black,2.8,0.5,medium,Est
linewidth 3
plot blue,\g
}
%% création de l'image
\text{url=draw(\L/3,\L
\cadre)}

%% Solution et texte alternatif pour l'image %%
\text{ti=Lorsqu'on se déplace sur la parabole à partir du sommet d'une unité horizontale l'ordonnée diminue de \a}
\text{sol=<ul class="wims_nopuce"><li>La parabole a pour sommet S(1,\c).</li> }
\text{sol=\sol <li>\ti .</li>}
\text{sol=\sol <li>Donc l'équation de la parabole est \(y=\f).</li>}
\text{sol=\sol <li>Le jet arrive au sol lorsque \(\f=0).</li>}
\text{sol=\sol <li>Donc lorsque \((x-1)^2=\c/\a) avec \(x \gt 1).</li>}
\text{sol=\sol <li>Donc \(x = 1 + \sqrt{\c/\a} \approx \x0).</li></ul>}

%% Enoncé %%
\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\url" alt="\ti"></div>
<div class="medium_size text_col">
<p>Une fontaine produit un jet d'eau parabolique qui sort du mur à \b dm du sol,
dirigé vers le haut et vers l'Est.</p><p>
La hauteur maximale du jet est \c dm, et est obtenue à 1 dm du mur.</p>
<ul><li>
<label for="reply1">Quelle est la hauteur d'une goutte d'eau en fonction de
sa distance \(x) du mur en m ?</label>
\embed{reply1,20}.
</li><li>
<label for="reply2">A quelle distance du mur, le jet d'eau
arrive-t-il au sol (ordonnée 0) ?</label> \embed{reply2,10} m.
</li></ul>
<div class="wims_instruction">Pour écrire \(sqrt(n)) taper <span class="tt">sqrt(\(n))</span>.
</div></div></div>

}
%% Aide, réponse et solution %%
\hint{Utilise la forme canonique \(a(x-x_S)^2+y_S).}
\answer{\(f(x)) =}{\f}{type=function}
\answer{x_0=}{\t0,\t1}{type=algexp}

\solution{
\sol}
