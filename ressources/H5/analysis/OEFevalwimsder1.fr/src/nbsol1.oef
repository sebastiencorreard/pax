\title{Nombre de solutions et encadrement 1}
\integer{a=randint(1..5)*randint(1,-1)}
\integer{b=randint(1..5)*randint(1,-1)}
%%%%
integer{a=1}
integer{b=1}
%%%%
\function{f=\a*x^4+\b*x^3}
\function{fder=4*\a*x^3+3*\b*x^2}
\rational{sing=simplify(-3*\b/(4*\a))}
\rational{bads=-\b/\a}
\if{\sing>0}
