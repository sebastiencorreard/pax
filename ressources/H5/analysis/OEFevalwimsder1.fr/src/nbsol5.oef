\title{Nombre de solutions et encadrement 5}
\text{size2=3}

\integer{x0=randint(-3..3)}
\integer{x1=\x0+2*randint(-2..2)}
\integer{x2=\x1+2*randint(1..3)}
\integer{a=randint(1..3)*randint(1,-1)}
\function{g=maxima(\a*x^3-3*\a*(\x1+\x2)*x^2/2+3*\a*\x1*\x2*x)}
\integer{y1=evalue(\g,x=\x1)}
\integer{y2=evalue(\g,x=\x2)}
\integer{yy1=\y1>\y2?\y2:\y1}
\integer{yy2=\y1>\y2?\y1:\y2}
\integer{s=\y1*\y2}
\integer{d=0}
\integer{nbsol=\s=0?2:randint(1,3)}
\if{\nbsol=1}
  { \integer{d=\s<0?random(-\yy1+randint(1..3),-\yy2-randint(1..3))}
    \integer{z1=\yy1+\d}
    \text{sg=\z1>0?\lstsing[1],\lstsing[1]:\lstsing[2],\lstsing[2]}
  }
\if{\nbsol=3}
  { \integer{d=\s>0?-randint(\yy1+1..\yy2-1)}
    \text{sg=\a>0?\lstsing[1,2]:\lstsing[2,1]}
  }
\if{\nbsol=2}
 {
  \if{\y1=0}
   { \text{sg=\a>0?\lstsing[3,2]:\lstsing[3,1]} }
   { \text{sg=\a>0?\lstsing[1,3]:\lstsing[2,3]} }
 }
\function{f=maxima(\g+\d)}
\text{ft=texmath(\f)}

\text{repvar=\a>0?1,2,1:2,1,2}
\text{tbornes=\a>0?\(L_1 < 0 < L_2) :\(L_1 > 0 > L_2)}
\text{sv=\lstvar[\repvar]}
\text{sd=\lstsigne[\repvar]}
\text{lstrep=\lstvar,\lstsigne,\lstsing}


\integer{k=randint(1..4)}
\if{\k=1}
  {
   \integer{bg=\x1-randint(1..3)}
   \integer{bd=\x2+randint(1..3)}
  }
\if{\k=2}
  {
   \integer{bg=\x1-randint(1..3)}
   \integer{bd=randint(\x1+1..\x2-1)}
  }
\if{\k=3}
  {
   \integer{bd=\x2+randint(1..3)}
   \integer{bg=randint(\x1+1..\x2-1)}
  }
\if{\k=4}
  {
   \integer{bg=\x1+1}
   \integer{bd=\x2-1}
  }
\integer{zg=evalue(\f,x=\bg)}
\integer{zd=evalue(\f,x=\bd)}
\integer{u1=\y1+\d}
\integer{u2=\y2+\d}
\if{\k=1}
  {
   \text{zl=\zg,\zd,\u1,\u2}
   \text{zl=wims(sort numeric list \zl)}
   \integer{z1=\zl[1]}
   \integer{z2=\zl[-1]}
  }
\if{\k=4}
  {
   \integer{z1=\zg<\zd?\zg:\zd}
   \integer{z2=\zg<\zd?\zd:\zg}
  }
\if{\k=2}
  {
   \text{zl=\zg,\zd,\u1}
   \text{zl=wims(sort numeric list \zl)}
   \integer{z1=\zl[1]}
   \integer{z2=\zl[-1]}
  }
\if{\k=3}
  {
   \text{zl=\zg,\zd,\u2}
   \text{zl=wims(sort numeric list \zl)}
   \integer{z1=\zl[1]}
   \integer{z2=\zl[-1]}
  }








\statement{
   On considère la fonction \(f) définie sur \(\lbrack -10^3;10^3 \rbrack) par
<div class="wimscenter"> \(f(x)=\ft) </div>
<p>
   On note \(f(-10^3)=L_1) et \(f(10^3)=L_2) avec \tbornes.</p>

   On veut encadrer \(f(x)) sur l'intervalle [\bg;\bd].
<ol>
<li> Calculer \(f(\bg))=\embed{reply13,4} et \(f(\bd))=\embed{reply14,4}</li>

<li> Compléter le tableau des variations de \(f)&nbsp;:
<table class="var_tab">
<tr>
  <th style="width:12%;"> \(x)</th>
      <td style="width:12%;">\(-10^3)</td>
      <td style="width:12%;"></td>
      <td style="width:12%;">\embed{reply1,3}</td>
      <td style="width:12%;"></td>
      <td style="width:12%;">\embed{reply2,3}</td>
      <td style="width:12%;"></td>
      <td style="width:12%;text-align:right">\(+10^3)</td>
</tr><tr>
  <th style="width:12%;"> sg \(f'(x))</th>
      <td style="width:12%;text-align:left"> &nbsp;</td>
      <td style="width:12%;">\embed{reply3,\size}</td>
      <td style="width:12%;">0</td>
      <td style="width:12%;">\embed{reply4,\size}</td>
      <td style="width:12%;">0</td>
      <td style="width:12%;">\embed{reply5,\size}</td>
      <td style="width:12%;">&nbsp;</td>
</tr><tr>
  <th style="width:12%;">\(var f)</th>
     <td style="width:12%;text-align:left" > \(L_1)</td>
     <td style="width:12%;vertical-align:middle"> \embed{reply6,\size} </td>
     <td style="width:12%;vertical-align:middle"> \embed{reply7,\size2} </td>
     <td style="width:12%;vertical-align:middle"> \embed{reply8,\size} </td>
     <td style="width:12%;vertical-align:middle"> \embed{reply9,\size2} </td>
     <td style="width:12%;vertical-align:middle"> \embed{reply10,\size} </td>
     <td style="width:12%;text-align:right;vertical-align:middle"> \(L_2) </td>
      </tr>
</table>
</li>

<li> En déduire l'encadrement cherché&nbsp;:
<div class="wimscenter"> \embed{reply11,2} \( \leq f(x) \leq ) \embed{reply12,2} </div></li>

</ol>
}
