!set title=Signe de la dérivée et variations 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 

ansorder=r,r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 9

val6=$[rint(-5-$(tmp0))]
tmp0=!randint -4, -1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!randint 0, 9

val9=$[rint(5+$(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
!if $val10=2 
tmp0=!randint 1, 9

val11=$[rint($(tmp0))]
tmp0=!randint 1, 9

val12=$[rint($val11+$(tmp0))]
tmp0=!randint -9, -1

val13=$[rint($(tmp0))]

!ifval $val13=$val7
val13=$[rint($val13-1)]
!endif
val14=$[rint(0)]
val15=$[rint($val11)]
val16=$[rint($val13)]
val17=$[rint($val16-1)]
val18=$[rint($val12)]
val19=$[rint($val7)]
val20=$[rint($val6)]
val21=\(\searrow),\(\nearrow),\(\searrow)
val22=top,bottom,top,bottom
val23=décroissante,décroissante
val24=2,1,2
!else
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
tmp0=!randint 1, 9

val14=$[rint($val13+$(tmp0))]
tmp0=!randint -9, -1

val11=$[rint($(tmp0))]
val12=$[rint(0)]
val15=$[rint($val13)]
val16=$[rint($val11)]
val17=$[rint($val16-1)]
val18=$[rint($val14)]
val19=$[rint($val8)]
val20=$[rint($val9)]
val22=bottom,top,bottom,top
val21=\(\nearrow),\(\searrow),\(\nearrow)
val23=croissante,décroissante
val24=1,2,1
!endif
val25=positif,négatif
replytype1=radio
replyname1=sur [$val6;$val7]
replygood1=$(val24[1]);$val25
replytype2=radio
replyname2=sur [$val7;$val8]
replygood2=$(val24[2]);$val25
replytype3=radio
replyname3=sur [$val8;$val9]
replygood3=$(val24[3]);$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère une fonction 
!insmath f
$() définie sur &#91; $val6; $val9 &#93;,	dont on connaît le tableau des variations	<table class="tab_var">	<tr>	  <th style="width:15%;"> 
!insmath x
$()</th>	      <td style="width:15%;text-align:left"> $val6</td>	      <td style="width:8%;"></td>	      <td style="width:15%;">$val7</td>	      <td style="width:8%;"></td>	      <td style="width:15%;">$val8</td>	      <td style="width:8%;"></td>	      <td style="width:15%;text-align:right">$val9</td>	</tr><tr>	  <th style="vertical-align:middle;width:15%;">
!insmath var f
$()</th>	     <td style="width:15%;text-align:left;vertical-align:$(val22[1])"> $val12 </td>	     <td style="width:8%;">$(val21[1]) </td>	     <td style="width:15%;vertical-align:$(val22[2])"> $val13 </td>	     <td style="width:8%;"> $(val21[2])  </td>	     <td style="width:15%;vertical-align:$(val22[3])"> $val11 </td>	     <td style="width:8%;"> $(val21[3]) </td>	     <td style="width:15%;text-align:right;vertical-align:$(val22[4])"> $val14 </td>	      </tr>	</table>	<p>	Quel est le signe de 
!insmath f'(x)
$()	</p>	<ol>	<li> sur [$val6;$val7]&nbsp;:  
!read oef/embed.phtml reply1 
$() </li>	<li> sur [$val7;$val8]&nbsp;:  
!read oef/embed.phtml reply2 
$() </li>	<li> sur [$val8;$val9]&nbsp;:  
!read oef/embed.phtml reply3 
$() </li>	</ol>	
$()
!exit

