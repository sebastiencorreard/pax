!set title=Signe de la dérivée et variations 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 

ansorder=r,r,r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!randint -10, 5

val7=$[rint($(tmp0))]
tmp0=!randint 3, 10

val8=$[rint($val7+$(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]

!ifval $val6=1
tmp0=!randint 3, 10

val10=$[rint($val9+$(tmp0))]
!else
tmp1=!randint 3, 10

val10=$[rint($val9-$(tmp1))]
!endif
val11=\(\searrow)
val12=\(\nearrow)
val13=\($val7)
val14=\($val8)
val15=\($val9)
val16=\($val10)
tmp0=!shuffle $val13,$val14,$val15,$val16

val17=$(tmp0)
tmp0=!listuniq $val17

val17=$(tmp0)
val18=$val11,$val12,$val17
val19=60x40x1

!ifval $val6=1
val20=-,+,-
!else
val20=+,-,+
!endif

!ifval $val6=1
val21=$val11,$val12,$val11
!else
val21=$val12,$val11,$val12
!endif
val22=$(val21[1]),$val15,$(val21[2]),$val16,$(val21[3])
replytype1=clickfill
replyname1=
replygood1=$(val22[1]);$val18
replytype2=clickfill
replyname2=
replygood2=$(val22[2]);$val18
replytype3=clickfill
replyname3=
replygood3=$(val22[3]);$val18
replytype4=clickfill
replyname4=
replygood4=$(val22[4]);$val18
replytype5=clickfill
replyname5=
replygood5=$(val22[5]);$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compléter le tableau des variations d'une fonction 
!insmath f
$() dérivable	sur 
!insmath \,\RR
$() sachant que	<div class="wimscenter"> 
!insmath f($val7)=$val9
$() et 
!insmath f($val8)=$val10
$() </div>	<table class="tab_var">	<tr>	  <th style="width:15%;"> 
!insmath x
$()</th>	      <td style="width:12%;text-align:left"> 
!insmath -\infty
$()</td>	      <td style="width:12%;"></td>	      <td style="width:12%;">$val7</td>	      <td style="width:12%;"></td>	      <td style="width:12%;">$val8</td>	      <td style="width:12%;"></td>	      <td style="width:12%;text-align:right">
!insmath +\infty
$()</td>	</tr><tr>	  <th style="width:15%;"> sg 
!insmath f'(x)
$()</th>	      <td style="width:12%;text-align:left"> &nbsp;</td>	      <td style="width:12%;">$(val20[1])</td>	      <td style="width:12%;">0</td>	      <td style="width:12%;">$(val20[2])</td>	      <td style="width:12%;">0</td>	      <td style="width:12%;">$(val20[1])</td>	      <td style="width:12%;text-align:right">&nbsp;</td>	</tr><tr>	  <th  style="width:15%;">
!insmath var f
$()</th>	     <td style="width:12%;text-align:left" > &nbsp;</td>	     <td style="width:12%;vertical-align:middle">  
!read oef/embed.phtml reply1,$val19 
$() </td>	     <td style="width:12%;vertical-align:middle">  
!read oef/embed.phtml reply2,$val19 
$() </td>	     <td style="width:12%;vertical-align:middle">  
!read oef/embed.phtml reply3,$val19 
$()  </td>	     <td style="width:12%;vertical-align:middle">  
!read oef/embed.phtml reply4,$val19 
$() </td>	     <td style="width:12%;vertical-align:middle">  
!read oef/embed.phtml reply5,$val19 
$() </td>	     <td style="width:12%;text-align:right;vertical-align:middle"> &nbsp; </td>	      </tr>	</table>	
$()
!exit

