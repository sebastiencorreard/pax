!set title=Equation de tangente 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100

ansorder=r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,-1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0)*$val6)]
tmp0=!randint 1, 6

val8=$[rint($(tmp0))]
val9=$[rint(-$val8)]
val10=$[rint(-$val7*2*$val8^2)]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
t_=!rawmath $val12-($val10)^2/(4*$val7)
val13=!exec pari print($t_)
val14=!rawmath $val7*x^4+$val10*x^2+$val11*x+$val12
t_=!replace internal \( by ( in $val14
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
val16=y=$val11*x+$val13
replytype1=equation
replyname1=equation
replygood1=!rawmath $val16
replytype2=numeric
replyname2=\(x_1)
replygood2=$[$val9]
replytype3=numeric
replyname3=\(x_2)
replygood3=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Soit la fonction 
!insmath f
$(), de courbe représentative 
!insmath \mathcal{P}
$(), définie sur 
!insmath \ \RR
$() par	<div class="wimscenter"> 
!insmath f(x)=$val15
$().</div>	<p>	   On cherche à déterminer l'équation d'une droite 
!insmath \mathcal{T}
$() de pente	$val11 qui soit tangente à 
!insmath \mathcal{P}
$() en deux points distincts.	</p>	<ol>	<li> Quelle est l'équation de 
!insmath \mathcal{T}
$()?	<div class="wimscenter"> <label for="reply1">
!insmath \mathcal{T}
$()&nbsp;:</label>  
!read oef/embed.phtml reply1 
$()</div>	</li><li> Quelles sont les abscisses 
!insmath x_1
$() et 
!insmath x_2
$() avec 
!insmath x_1 < x_2
$() des points de tangence?	<div class="wimscenter"> <label for="reply2">
!insmath x_1
$()=</label>  
!read oef/embed.phtml reply2,5 
$() </div>	<div class="wimscenter"> <label for="reply3">
!insmath x_2
$()=</label>  
!read oef/embed.phtml reply3,5 
$() </div>	</li>	</ol>	
$()
!exit

