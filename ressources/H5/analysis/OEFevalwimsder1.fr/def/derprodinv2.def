!set title=Dérivée produit ou inverse 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Maguy, Bruno ; Régine, Mangeard
email=regine@mangeard.fr
precision=100
computeanswer=yes

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -6, 6

val6=$[rint($(tmp0))]
val7=\a
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 6

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=!rawmath ($val10+$val9*x^$val8)*sqrt(x)
t_=!replace internal \( by ( in $val11
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val12=$(tmp1)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'(x))
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Calculer 
!insmath f'(x)
$() pour 
!insmath f(x)=$val12
$()&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath f'(x)=
$()</label> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=1
