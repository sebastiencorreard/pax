!set title=Equation de tangente 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100

ansorder=r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
val8=$[rint(-3*$val6*$val7)]
val9=$[rint(3*$val6*($val7)^2)]
val10=$[rint(-$val6*($val7)^3)]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
!if $val11=1 
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]

!ifval $val6<0
val13=$[rint(-$val13)]
!endif
val14=$[rint($val12+$val13)]
val15=r1
!endif
!if $val11=2 
val14=$[rint($val12)]
val16=$[rint($val7)]
val15=r1	r2
!endif
!if $val11=3 
tmp0=!randitem 1,4,9

val17=$[rint($(tmp0))]
val14=$[rint($val12-$val17*3*$val6)]
val18=$[rint(sqrt($val17)+$val7)]
val16=$[rint(-sqrt($val17)+$val7)]
val15=r1	r2
!endif
val9=$[rint($val9+$val14)]
val19=$[rint($val6*($val12-$val14))]
t_=!replace internal \( by ( in $val6*x^3+$val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val20=$(tmp1)
val21=aucun point, un point, deux points
oefsteps=$val15 
nextstep=!nosubst $val15 
!readproc oef/steps.proc
replytype1=radio
replyname1=nombre de points
replygood1=$val11;aucun,un,deux
replytype2=numeric
replyname2=solution
replygood2=$[$val16]
replytype3=numeric
replyname3=deuxième solution
replygood3=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Soit la fonction 
!insmath f
$() définie sur 
!insmath \ \RR
$() par :	  <div class="wimscenter">
!insmath f(x)=$val20
$().</div>	  
!if $m_step=1 
$()	    <p>	       Combien existe-t-il de points de 
!insmath \mathcal{C}
$() où la tangente a	       pour coefficient directeur $val12?	    </p>	    <div class="wimscenter">  
!read oef/embed.phtml reply1 
$()</div>	   
!else
$() <p>	    Il existe $(val21[$val11]) de 
!insmath \mathcal{C}
$() où la tangente a pour coefficient directeur $val12.	    </p>	    
!if $val11=2 
$()	      <p>Indiquer l'abscisse de ce point:</p>	      <div class="wimscenter"><label for="reply2">
!insmath x=
$()</label>  
!read oef/embed.phtml reply2,3 
$() </div>	     
!else
$() <p>	      Indiquer les abscisses 
!insmath x_1
$() et 
!insmath x_2
$() de ces points avec 
!insmath x_1 < x_2
$():	      </p>	      <div class="wimscenter"><label for="reply2">
!insmath x_1=
$()</label>  
!read oef/embed.phtml reply2,3 
$() </div>	      <div class="wimscenter"><label for="reply3">
!insmath x_2=
$()</label>   
!read oef/embed.phtml reply3,3 
$() </div>	     
!endif
$()	   
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,20,21
embedcnt=4
