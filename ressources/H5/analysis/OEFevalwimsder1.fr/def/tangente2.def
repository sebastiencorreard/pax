!set title=Equation de tangente 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(-\infty)
val7=\(+\infty)
val8=\(\emptyset)
val9=&#59;
tmp0=!randint -3, -2

tmp1=!randint 0, 3

tmp2=!randitem $(tmp0),$(tmp1)

tmp=!translate internal $	$ to ; in 	1/(x+1),$(tmp2),\(\RR \setminus) &#123;-1 &#125;	sin(x),0, \(\ \RR)	cos(x),0,\(\ \RR)	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp3=!translate internal $\
$ to ; in $tmp
val10=$(tmp3)
tmp0=!randitem 0,1

tmp1=!randint -3, 3

tmp=!translate internal $	$ to ; in 	1/(x+1)^2,$(tmp0),\(\RR \setminus) &#123;-1 &#125;	(x+1)^2,$(tmp1),\(\RR)	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val11=$(tmp2)
tmp0=!randint -2, 2

tmp1=!randitem 0,1

tmp=!translate internal $	$ to ; in 	(x+1)^3,$(tmp0),\(\RR)	1/(x+1)^3,$(tmp1),\(\RR \setminus) &#123;-1 &#125;	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val12=$(tmp2)
tmp0=!randitem 0,3,8,15

tmp1=!randitem 0,3,15

tmp=!translate internal $	$ to ; in 	sqrt(x+1),$(tmp0), &#91;-1 $val9 $val7 &#91;	1/sqrt(x+1),$(tmp1), &#93;-1 $val9 $val7 &#91;	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
val13=$(tmp2)
val14=$val10;$val11;$val12;$val13
tmp=!translate internal $	$ to ; in $val14

tmp0=!rowcnt $tmp
val15=$[rint($(tmp0))]
tmp0=!shuffle $val15

val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val14

tmp=!row $(val16[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val17=$(val10[1])
val18=$[rint($(val10[2]))]
val19=$(val10[3])
tmp0=!replace internal x+1 by \plus1 in $val17

val20=$(tmp0)
tmp0=!replace internal x+2 by \plus2 in $val20

val20=$(tmp0)
tmp0=!mathsubst x=\epsilon in $val20

val20=$(tmp0)
val21=!rawmath $val17
val22=!rawmath $val20
evaltmp=$val21

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val21,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val24=!rawmath $(tmp0)
evaltmp=$val24

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val25=$[$(tmp0)]
val26=y=$val25*(x-$val18)+$val23
replytype1=equation
replyname1=tangente
replygood1=!rawmath $val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit la fonction 
!insmath f
$() de courbe représentative 
!insmath \mathcal{C}
$(), définie sur $val19 par	<div class="wimscenter"> 
!insmath f(x)= $val21
$().</div>	   Écrire une équation de la tangente 
!insmath \mathcal{T}
$() à 
!insmath \mathcal{C}
$() au point 
!insmath A
$() d'abscisse $val18&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath \mathcal{T}
$()&nbsp;:</label>  
!read oef/embed.phtml reply1 
$()</div>	
$()
