val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -6, 6

val6=$[rint($(tmp0))]
val7=\a
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
val10=$[rint(2*$val8)]
val11=$[rint(3*$val8)]
val12=!rawmath sqrt(x)/($val8*x^2+$val9)
tmp0=!texmath $val8*x^2+$val9

val13=$(tmp0)
tmp0=!texmath $val9-$val11*x^2

val14=$(tmp0)
val15=\frac{\sqrt{x}}{$val13}
tmp0=!randitem \(f) est définie sur \(\lbrack 0; +\infty \lbrack),\(f) est définie en 0

val16=$(tmp0)
tmp0=!randitem \(f) est dérivable sur \(\lbrack 0; +\infty \lbrack),\(f) est dérivable en 0

val17=$(tmp0)
val18=\(f'(x)=\frac{\frac{1}{2\sqrt{x}}}{$val10 x})
val19=\(f'(x)=\frac{$val10 x\sqrt{x}-\frac{1}{2\sqrt{x}}($val13)}{($val13)^2})
val20=\(f'(x)=\frac{\frac{1}{2\sqrt{x}}($val13)-$val10 x\sqrt{x}}{($val13)^2})
val21=\(f'(x)=\frac{$val14}{2\sqrt{x}($val13)^2})
val22=$val18,$val19,$val20,$val21
tmp0=!shuffle 4

val23=$(tmp0)
val22=$val16,$val17,$(val22[$(val23[1])]),$(val22[$(val23[2])]),$(val22[$(val23[3])]),$(val22[$(val23[4])])
tmp0=!positionof item 3 in $val23

val24=$[rint($(tmp0)+2)]
tmp0=!positionof item 4 in $val23

val25=$[rint($(tmp0)+2)]
replytype1=checkbox
replyname1=
replygood1=1,$val24,$val25;$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

