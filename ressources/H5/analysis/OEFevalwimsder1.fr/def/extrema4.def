!set title=Recherche d'extremum 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
t_=!replace internal \( by ( in ($val6-x)*(($val6/2)^2+x^2)/$val6
tmp0=!exec maxima $t_

val7=!rawmath $(tmp0)
t_=!rawmath $val6/6
val8=!exec pari print($t_)
replytype1=formal
replyname1=Aire
replygood1=$val7
replytype2=numexp
replyname2=x
replygood2=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   On considère un carré 
!insmath A B C D
$() de côté $val6.<br>	   On note 
!insmath I
$() le milieu de [A B] et 
!insmath J
$() celui de [A D].<br>	   Un point 
!insmath M
$() se déplace sur le segment [A I], on note 
!insmath x=A M
$().<br>	 Soit 
!insmath N
$() le point de [B C] tel que le triangle 
!insmath J M N
$() soit rectangle en 
!insmath M
$().	<ol>	<li> Déterminer en fonction de 
!insmath x
$() l'aire du triangle 
!insmath J M N
$()&nbsp;:	<div class="wimscenter"><label for="reply1">Aire = </label> 
!read oef/embed.phtml reply1 
$() </div>	</li>	<li> Quelle est la valeur de 
!insmath x
$() rendant cette aire minimale?	<div class="wimscenter"><label for="reply2">
!insmath x
$()= </label> 
!read oef/embed.phtml reply2 
$() </div>	</li>	</ol>	<div class="wims_instruction"> Indication&nbsp;: on remarquera que les triangles 
!insmath A M J
$() et	  
!insmath B N M
$() sont semblables!</div>	
$()
!exit

