!set title=Equation de tangente 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
val10=!rawmath $val7*x^2+$val6*x+$val8
t_=!replace internal \( by ( in $val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
t_=!rawmath -$val6/(2*$val7)
val12=!exec pari print($t_)
evaltmp=$val10

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
t_=!rawmath ($val9-$val6)/(2*$val7)
val14=!exec pari print($t_)
evaltmp=$val10

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)
t_=!replace internal \( by ( in $val9*x
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val16=$(tmp1)
replytype1=numeric
replyname1=xA
replygood1=$[$val12]
replytype2=numeric
replyname2=yA
replygood2=$[$val13]
replytype3=numeric
replyname3=xB
replygood3=$[$val14]
replytype4=numeric
replyname4=yB
replygood4=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Soit la fonction 
!insmath f
$() définie sur 
!insmath \ \RR
$() par 
!insmath f(x)=$val11
$() et 
!insmath \mathcal{P}
$() sa représentation graphique.	<p>	 Déterminer les coordonnées des points suivants&nbsp;:	</p><ol>	<li> 
!insmath A
$(), point en lequel 
!insmath \mathcal{P}
$() admet une tangente horizontale&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath A
$()=</label> ( 
!read oef/embed.phtml reply1,3 
$(), 
!read oef/embed.phtml reply2,3 
$())</div>	</li>	<li> 
!insmath B
$(), point en lequel 
!insmath \mathcal{P}
$() admet une tangente parallèle à la droite d'équation 
!insmath y=$val16
$()&nbsp;:	<div class="wimscenter"><label for="reply3">
!insmath B
$()=</label> ( 
!read oef/embed.phtml reply3,3 
$(), 
!read oef/embed.phtml reply4,3 
$())</div>	</li></ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
