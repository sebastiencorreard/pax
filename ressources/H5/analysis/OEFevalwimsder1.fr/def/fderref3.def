!set title=Dérivée de fonction de référence 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Maguy, Bruno ; Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=numexp
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
val8=$val7
val9=!rawmath sqrt(x)
tmp0=!texmath $val9

val10=$(tmp0)
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
val8=$val7
val6=numeric
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val11=!rawmath $(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val7) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
replytype1=$val6

replyname1=\(f'(a))
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Calculer 
!insmath f'(a)
$() pour 
!insmath f(x)=$val10
$() et 
!insmath a=$val8
$()&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath f'(a)=
$()</label> 
!read oef/embed.phtml reply1,8 
$()</div>	<div class="wims_instruction">Taper "sqrt(a)" pour 
!insmath \sqrt{a}
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=1
