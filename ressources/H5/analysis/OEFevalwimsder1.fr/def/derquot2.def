!set title=Dérivée d'un quotient 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Maguy, Bruno ; Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -6, 6

val6=$[rint($(tmp0))]
val7=\a
tmp0=!randitem 2,3,5,6,7,9

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
val10=\frac{$val8 x^2}{x+$val9}
val11=\frac{\sqrt{$val8}}{x+$val9}
val12=\frac{1}{x+$val9}
val13=\frac{\cos{\theta}}{x+$val9}
val14=\(f(x)=$val10),\(f(x)=$val11),\(f(x)=$val12),\(f(x)=$val13)
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=2,3,4;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	   Dans quels cas peut-on utiliser la formule 
!insmath \left ( \frac{1}{u} \right ) ' = -\frac{u'}{u^2}
$()?</p>	<ul>	 <li> 
!read oef/embed.phtml reply1,1 
$()</li>	 <li> 
!read oef/embed.phtml reply1,2 
$()</li>	 <li> 
!read oef/embed.phtml reply1,3 
$()</li>	 <li> 
!read oef/embed.phtml reply1,4 
$()</li>	</ul>	
$()
!exit

