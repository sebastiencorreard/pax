!set title=Recherche d'extremum 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3000, 4000

val6=$[rint($(tmp0))]
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]

!ifval $val7=1
val8=euro
!else
val8=euros
!endif
tmp0=!randint 10, 15

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in p*$val6*(1-(p-$val9)/($val7*10))
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
t_=!rawmath ($val9+$val7*10)/2
val11=!exec pari print($t_)
replytype1=formal
replyname1=Recette
replygood1=$val10
replyname2=prix recherché
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	   Le parc d'attraction Totoland a ouvert en 2007 et a reçu $val6 visiteurs avec un billet d'entrée valant $val9 euros.<br>	   Une étude de marché a montré que si le prix du billet d'entrée augmentait de $val7 $val8,	   le nombre de visiteurs baisserait de 10 %, et que si le prix baissait de $val7 $val8,	   le nombre de visiteurs augmenterait de 10 %.</p><p>	   On fait l'hypothèse que cette étude de marché se prolonge ainsi à toute hausse ou baisse	   du prix du billet.</p><p>	   On veut déterminer quel prix du billet d'entrée en 2008 permettrait de réaliser une recette maximale.	</p><ol>	<li> Exprimer la recette 
!insmath R
$() réalisée en fonction du prix 
!insmath p
$() du billet d'entrée&nbsp;:	<div class="wimscenter"> <label for="reply1">
!insmath R(p)
$()= </label> 
!read oef/embed.phtml reply1 
$() </div></li>	<li> En déduire le prix 
!insmath p_0
$() correspondant au maximum de cette recette&nbsp;:	<div class="wimscenter"><label for="reply2">
!insmath p_0
$()=</label>  
!read oef/embed.phtml reply2,3 
$() </div></li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Soit 
!insmath x
$() l'augmentation par rapport au prix de départ $val9 euros, donc p=$val9+x.<br>	   Le nombre de visiteurs subit une baisse de 
!insmath t=\frac{x}{$val7}\times 10 \%=\frac{p-$val9}{$val7}\times 10 \%
$().<br>	   Le nombre de visiteurs devient donc 
!insmath $val6\times(1 -\frac{p-$val9}{$val7\times 10})
$()</p><p>	   La recette s'exprime alors par 
!insmath R(p)=p\times $val6 \times (1 -\frac{p-$val9}{$val7\times 10})
$()</p><p>	   En dérivant on obtient 
!insmath R'(p)=$val6(1-\frac{2p-$val9}{$val7\times 10})
$() qui s'annule pour 
!insmath p_0=$val11
$().	</p>	
$()
!exit

:latex
$()
$()
!exit

