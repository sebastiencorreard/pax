tmp0=!randint -3, 3

val11=$[rint($(tmp0))]
tmp0=!randint -2, 2

val12=$[rint($val11+2*$(tmp0))]
tmp0=!randint 1, 3

val13=$[rint($val12+2*$(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val14*x^3-3*$val14*($val12+$val13)*x^2/2+3*$val14*$val12*$val13*x
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
evaltmp=$val15

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val16=$[rint($(tmp0))]
evaltmp=$val15

evaltmp=!mathsubst x=($val13) in $evaltmp
tmp0=($evaltmp)
val17=$[rint($(tmp0))]

!ifval $val16>$val17
val18=$[rint($val17)]
!else
val18=$[rint($val16)]
!endif

!ifval $val16>$val17
val19=$[rint($val16)]
!else
val19=$[rint($val17)]
!endif
val20=$[rint($val16*$val17)]
val21=$[rint(0)]

!ifval $val20=0
val22=$[rint(2)]
!else
tmp0=!randitem 1,3

val22=$[rint($(tmp0))]
!endif
!if $val22=1 

!ifval $val20<0
tmp0=!randint 1, 3

tmp1=!randint 1, 3

tmp2=!randitem -$val18+$(tmp0),-$val19-$(tmp1)

val21=$[rint($(tmp2))]
!endif
val23=$[rint($val18+$val21)]

!ifval $val23>0
val24=$(val8[1]),$(val8[1])
!else
val24=$(val8[2]),$(val8[2])
!endif
!endif
!if $val22=3 

!ifval $val20>0
tmp0=!randint $val18+1, $val19-1

val21=$[rint(-$(tmp0))]
!endif

!ifval $val14>0
val24=$(val8[1,2])
!else
val24=$(val8[2,1])
!endif
!endif
!if $val22=2 
!if $val16=0 

!ifval $val14>0
val24=$(val8[3,2])
!else
val24=$(val8[3,1])
!endif
!else

!ifval $val14>0
val24=$(val8[1,3])
!else
val24=$(val8[2,3])
!endif
!endif
!endif
t_=!replace internal \( by ( in $val15+$val21
tmp0=!exec maxima $t_

val25=!rawmath $(tmp0)
tmp0=!texmath $val25

val26=$(tmp0)

!ifval $val14>0
val27=1,2,1
!else
val27=2,1,2
!endif

!ifval $val14>0
val28=\(L_1 < 0 < L_2) 
!else
val28=\(L_1 > 0 > L_2)
!endif
