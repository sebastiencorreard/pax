prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
t_=!rawmath $val7^2/$val6^2
val8=!exec pari print($t_)
t_=!rawmath -$val7/$val6
val9=!exec pari print($t_)
t_=!rawmath 2*$val7
val10=!exec pari print($t_)
val11=$val9*x+$val10
tmp0=!texmath (a*$val6-$val7)/a

val12=$(tmp0)
tmp0=!texmath $val7-$val6*a

val13=$(tmp0)
tmp0=!texmath a*x+$val7-$val6*a

val14=$(tmp0)
tmp0=!texmath $val11

val15=$(tmp0)
val16=Notons \(a) la pente de la droite \(d). Son équation réduite est	\(y=$val14).<br>	   Les points \(M) et \(N) ont pour coordonnées \(M($val12,0)) et \(N(0,$val13)).<br>	   L'aire du triangle \(O M N) est donc \(A(a)= \frac{($val12)\times($val13)}{2}).<br>	   Cette aire est minimale pour \(a^2=$val8), d'où l'équation réduite de \(d)<br>	\(y=$val15)
replytype1=formal
replyname1=equation
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val16


!goto stat

!exit

:question
$()<p>	   Le plan est rapporté à un repère orthonormal 
!insmath O,\vec{i},\vec{j}
$().</p><p>	   Une droite 
!insmath d
$() non parallèle aux axes et de pente négative passant par le point 
!insmath A($val6,$val7)
$() coupe	   l'axe des abscisses en 
!insmath M
$() et l'axe des ordonnées en 
!insmath N
$().	</p><p>	  Déterminer l'équation réduite 
!insmath d
$() pour que le triangle 
!insmath O M N
$() ait une aire minimale.	</p><div class="wimscenter"><label for="reply1">
!insmath y=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	
