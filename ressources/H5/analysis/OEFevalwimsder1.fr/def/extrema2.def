!set title=Recherche d'extremum 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint 2, 8

val7=$[rint($(tmp0)*100)]
tmp0=!randitem 1,2,4,5

val8=$[rint($(tmp0)*100)]
val9=$[round(100*$val7*$val6^3/$val8)/100]
t_=!rawmath $val7*$val6/$val8
val10=!exec pari print($t_)
t_=!replace internal \( by ( in 2*$val7*a^2/100+4*$val8*$val9/(100*a)
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
replytype1=formal
replyname1=\(P(a))
replygood1=$val11
replytype2=numexp
replyname2=côté de la base
replygood2=$val6
replytype3=numexp
replyname3=hauteur de la boîte
replygood3=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	   Un coffre à bijoux a la forme d'un parallélépipède	   rectangle à base carrée et a un volume imposé de $val9 L ($val9 dm<sup>3</sup>).</p><p>	   Le matériau utilisé pour construire les bases coûte $val7 euros le mètre carré	   et celui utilisé pour construire la surface latérale coûte $val8 euros le mètre carré.</p>	<ol><li>	 Exprimer le prix de revient 
!insmath P(a)
$() en fonction du côté 
!insmath a
$() (en dm) de la base carrée&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath P(a)=
$()</label> 
!read oef/embed.phtml reply1 
$()</div> </li>	<li> En déduire les dimensions de la boîte pour que le prix de revient soit minimal.	<ul><li><label for="reply2">Côté de la base&nbsp;:</label>  
!read oef/embed.phtml reply2 
$() dm</li><li>	   <label for="reply3">Hauteur de la boîte &nbsp;:</label>  
!read oef/embed.phtml reply3 
$() dm</li></ul>	</li></ol>	
$()
!exit

