!set title=Dérivée somme ou produit par un réel 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Maguy, Bruno ; Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -6, 6

val6=$[rint($(tmp0))]
val7=\a
tmp0=!randint 2, 6

tmp1=!randitem 1,-1

tmp2=!shuffle $(tmp0)*$(tmp1),0,0,0,0

val8=$(tmp2)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=$[rint($(val8[3]))]
val12=$[rint($(val8[4]))]
val13=$[rint($(val8[5]))]
val14=!rawmath $val9*x^3+$val10*x^2+$val11*x+$val12/x+$val13*sin(x)
t_=!replace internal \( by ( in $val14
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'(x))
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Calculer 
!insmath f'(x)
$() pour 
!insmath f(x)=$val15
$()&nbsp;:	<div class="wimscenter"><label for="reply1">
!insmath f'(x)=
$()</label> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=1
