choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
val9=r1,r2,r3,r4,r5,r6
val10=!rawmath ($val6*x+$val7)/(x-$val8)
t_=!replace internal \( by ( in $val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=\(\RR \setminus) &#123;$val8&#125;
tmp0=!randint -3, 3

val13=$[rint($(tmp0))]

!ifval $val13=$val8
val13=$[rint($val13+1)]
!endif
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
evaltmp=$val14

evaltmp=!mathsubst x=($val13) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)
tmp0=!mathsubst x=($val13) in $val10

val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=!rawmath $(tmp0)
tmp0=!mathsubst x=($val13+h) in $val10

val17=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=!rawmath $(tmp0)
val18=!rawmath ($val17 - ($val16))/h
tmp=!translate ";': to $     $ in $val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in y= $val15*(x-($val13))+($val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
oefsteps=$val9 
nextstep=!nosubst $val9 
!readproc oef/steps.proc
replytype1=numeric
replyname1=
replygood1=$[$val16]
replytype2=formal
replyname2=
replygood2=$val17
