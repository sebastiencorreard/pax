!set title=Approximation affine 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
val9=!rawmath $val7+$val8*(x-$val6)
replytype1=formal
replyname1=approximation affine
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	   Une fonction 
!insmath f
$() de courbe représentative 
!insmath \mathcal{C}
$() est telle que	<div class="wimscenter"> 
!insmath f($val6)=$val7
$() et 
!insmath f'($val6)=$val8
$()</div>	<p>	   Quelle est l'approximation affine de 
!insmath f
$() en $val6?	</p>	<div class="wimscenter"><label for="reply1">
!insmath x \mapsto
$()</label>  
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

