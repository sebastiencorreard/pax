!set title=Signe de la dérivée et variations 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard ; Maguy, Bruno
email=regine@mangeard.fr
precision=100
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 

ansorder=r
varcnt=50
prevarcnt=49
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
val6=$[rint(2)]
!if $val6=1 
tmp0=!randint -2, 2

val7=$[rint($(tmp0))]
val8=!rawmath (6*(x+$val7)+3)/((x+$val7)^2+x+$val7+2.5)
val9=xrange -6,6	 yrange -3,3	 parallel -6,-3,6,-3,0,1,7,gray	 parallel -6,-3,-6,3,1,0,13,gray	 arrow -6,0,6,0,10,black	 arrow 0,-3,0,3,10,black	 text black,-0.5,1,medium,1	 text black,1,-0.2,medium,1	 plot blue,$val8	
val10=Soit \(f) une fonction définie et dérivable sur \(\RR), la courbe ci-contre représente la fonction \(f'), dérivée de \(f).
val11=$[rint(1-$val7)]
val12=$[rint(-2-$val7)]
tmp0=!randitem $val11,$val12

val13=$[rint($(tmp0))]
t_=!rawmath -0.5-$val7
val14=!exec pari print($t_)
val15=\(f'($val13)=0),2,	\(f'($val14)=0),1
val16=\(f) admet un extremum en $val14,1,	\(f) admet un extremum en $val13,2
val17=\(f) est décroissante sur [$val11 ;6],2,	\(f) est croissante sur [$val12 ;$val11],2,	\(f) est croissante sur [$val14 ;6],1
val18=La tangente à la courbe de \(f) au point d'abscisse $val11 a pour coefficient directeur 2,1,	   La tangente à la courbe de \(f) au point d'abscisse $val12 a pour coefficient directeur -2,1,	   La tangente à la courbe de \(f) au point d'abscisse $val13 a pour coefficient directeur 0,2
val19=Sur [-6;6] la courbe de \(f) admet deux tangentes horizontales,1,	   Sur [-6;6] la courbe de \(f) admet une seule tangente horizontale,2
!else
tmp0=!randint -2, 2

val7=$[rint($(tmp0))]
val20=!rawmath -0.17*(x+$val7)^3+0.5*(x+$val7)^2+x+$val7
val9=xrange -6,6	 yrange -4,4	 parallel -6,-4,6,-4,0,1,9,gray	 parallel -6,-4,-6,4,1,0,13,gray	 arrow -6,0,6,0,10,black	 arrow 0,-4,0,4,10,black	 text black,-0.5,1,medium,1	 text black,1,-0.2,medium,1	 plot red,$val20	
val10=La courbe ci-contre représente une fonction \(f) définie et dérivable sur \(\RR). On appelle \(f') la fonction dérivée de \(f).
val21=$[rint(-$val7)]
val11=$[rint(2-$val7)]
val12=$[rint(4-$val7)]
val15=\(f') est positive sur [$val21;$val11],1,	\(f') est positive sur [$val11;$val12],2
val16=Sur [-6;6] \(f') s'annule 3 fois,2,	   Sur [-6;6] \(f') s'annule 2 fois,1
val17=Sur [-6;6] l'équation \(f'(x)=1) a 3 solutions,2,	   Sur [-6;6] l'équation \(f'(x)=1) a 2 solutions,2,	   Sur [-6;6] l'équation \(f'(x)=1) a 1 seule solution,1
val18=Le coefficient directeur de la tangente à la courbe de \(f) au point d'abscisse $val12 est positif,2,	   Le coefficient directeur de la tangente à la courbe de \(f) au point d'abscisse $val12 est négatif,1
val19=Le coefficient directeur de la tangente à la courbe de \(f) au point d'abscisse $val21 est positif,1,	   Le coefficient directeur de la tangente à la courbe de \(f) au point d'abscisse $val21 est négatif,2
val22=Sur [$val11;$val12] \(f') change de sens de variation,2,	   Sur [$val11;$val12] \(f') ne change pas de sens de variation,1
!endif
val23=
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val25=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 1 to $val23

val23=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val16

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val26=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 2 to $val23

val23=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val27=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 3 to $val23

val23=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val18

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val28=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 4 to $val23

val23=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val19

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val29=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 5 to $val23

val23=$(tmp0)
!endif
val30=$val25,$val26,$val27,$val28,$val29
!if $val6=2 
tmp=!translate internal $	$ to ; in $val22

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val24=$(tmp0)
val31=$(val24[1])
!if $(val24[2])=1 
tmp0=!append item 6 to $val23

val23=$(tmp0)
!endif
val30=$val30,$val31
!endif
replytype1=checkbox
replyname1=
replygood1=$val23;$val30
