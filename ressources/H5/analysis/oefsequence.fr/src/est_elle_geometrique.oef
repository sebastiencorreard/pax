\title{La suite est-elle géométrique ?}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}


\real{u0=randint(-100..100)/10}\if{\u0=0}{\integer{u0=1}}
\integer{q=randint(2..25)}
\real{u1=\q*\u0}
\real{u2=\q*\u1}
\real{u3=\q*\u2}

\real{v1=\q*\u0+1}
\real{v2=\q*\u1+1}
\real{v3=\q*\u2+1}

\matrix{u=\u0,\u1,\u2,\u3;\u0,\v1,\v2,\v3}
\integer{i=randint(1..2)}

\text{suite=\u[\i;]}

\text{ nstep = r1}
\nextstep{ \nstep }
\text{sujet1= La population d'un certain pays, Le prix d'un article, Le nombre d'abonnés à une revue, Le capital de M. X,
Le taux de chômage, La production d'une usine }
\text{sujet2= la population , le prix de cet article , le nombre d'abonnés, son capital, le taux de chômage,
la production de cette usine}

\integer{j=randint(1..6)}

\text{monotonie=croît, augmente, décroît, diminue}
\integer{k=randint(1..4)}
\text{annee=randitem(2000,2002,2004,2006,2008,2010,2012)}
\real{taux=randint(1..50)/10}
\text{enonce1=\sujet1[\j] \monotonie[\k] de \taux % par an.<br> On note
u<sub>n</sub> \sujet2[\j] l'année \annee+n
. On définit ainsi une suite numérique (u<sub>n</sub>).}
\text{enonce2=On donne les premiers termes d'une suite :<br>
<table width=100%>
<tr>
<td>u<sub>0</sub>=\suite[1]</td>
<td>u<sub>1</sub>=\suite[2]</td>
<td>u<sub>2</sub>=\suite[3]</td>
</tr>
</table>
}


\integer{l=randint(1..2)}
\if{\l=1}{\text{enonce=\enonce1}}{\text{enonce=\enonce2}}

\if{\l=1}{\text{numrep=1}}{\if{\i=2}{\text{numrep=3}}{\text{numrep=2}}}
\text{choix=est,semble,n'est pas}
\text{reponse=\choix[\i]}

\if{\numrep=1 and (\k=1 or \k=2)}{\real{raison=1+\taux/100}}
\if{\numrep=1 and (\k=3 or \k=4)}{\real{raison=1-\taux/100}}
\if{\numrep=2}{\real{raison=\q}}


\statement{

<div id="enonce">
\enonce
</div>


\if{\step=1}{
<div class="question">
<p class="reponse">Cette suite \embed{r1} géométrique.</p>
</div>
}


\if{\step=2 and (\numrep=1 or \numrep=2)}{
<div class="question">
\if{\numrep=1}{<p class="oui">Effectivement cette suite est géométrique.
</p>}
{<p class="consigne">On suppose que cette suite est géométrique.</p>}<br>
Quelle est sa raison ?
<p class="reponse">q=\embed{r2}</p>
</div>
}
}

\answer{}{\numrep;\choix}{type=menu}
\answer{q}{\raison}{type=numeric}
\if{\step=2 and (\numrep=1 or \numrep=2)}{\text{nstep=r2}}
