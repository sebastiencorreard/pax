\title{Produit de puissances}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}


\integer{a=randint(-10..10)}
\integer{b=randint(-10..10)}

\integer{c=\a+\b}

\statement{
<div class="question">
Indiquer dans la case le bon exposant pour que l'égalité soit juste.
<div class="reponse">
\if{\a=0}{1}{\if{\a=1}{q}{q<sup>\a</sup>}}
\(\times)
\if{\b=0}{1}{\if{\b=1}{q}{q<sup>\b</sup>}}
=q<sup>\embed{r1,1}</sup>
</div>
</div>
}

\answer{}{\c}{type=numeric}
