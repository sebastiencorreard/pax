\title{Limite d'une suite}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}

\text{k=0}\while{\k=0}{\real{k=randint(-100..100)/10}}
\text{q=1}\while{\q=1}{\real{q=randint(1..10)/5}}
\text{a=0}\while{\a=0 or \a=1}{\real{a=randint(-20..20)/5}}
\text{b=0}\while{\b=0}{\real{b=randint(-20..20)/5}}
\text{d=0}\while{\d=0}{\real{d=randint(-20..20)/5}}
\text{c=random(1,2,4,10,-1,-2,-4,-10)}
\real{f=\a/\c}
\real{g=1/\c}

\text{tg1=\k,\a\times(\q)^n}
\integer{i=randint(1..2)}
\if{\i=1}{\text{rep1=\k}}
\if{\i=2 and \q<1}{\text{rep1=0}}
\if{\i=2 and \q>1}{\if{\a>0}{\text{rep1=\(+\infty)}}{\text{rep1=\(-\infty)}}}
\text{prop=shuffle(\f,\a,\b,\k,0,\(+\infty),\(-\infty))}

\text{tg2=\a*n^2,\a*n^2+\b}
\integer{j=randint(1..2)}
\if{\a>0}{\text{rep2=\(+\infty)}}{\text{rep2=\(-\infty)}}

\text{tg3=\a/n+\b,\a/(n^2)}
\integer{k=randint(1..2)}
\if{\k=1}{\text{rep3=\b}}{\text{rep3=0}}

\text{tg4=(\a+\b*\q^n)/(\c+\d* \q^n),1/(\c+\d*\q^n)}
\integer{l=randint(1..2)}
\if{\q>1}{\if{\l=1}{\text{rep4=FI}}{\text{rep4=0}}}
\if{\q<1}{\if{\l=1}{\text{rep4=\f}}{\text{rep4=\g}}}



\statement{
<div id="enonce">
Calculer les limites suivantes <br>
<div class="reponse">
\(\[\lim_{n\to+\infty}\]) \(\tg1[\i]) = \embed{r1}
</div>

<div class="reponse">
\(\[\lim_{n\to+\infty}\]) \(\tg2[\j]) = \embed{r2}
</div>

<div class="reponse">
\(\[\lim_{n\to+\infty}\]) \(\tg3[\k]) = \embed{r3}
</div>

<div class="reponse">
\(\[\lim_{n\to+\infty}\]) \(\tg4[\l]) = \embed{r4}
</div>

</div>

}
\hint{<p class="consigne">Il faut utiliser les limites suivantes : </br>
\(\lim_{n\to+\infty}q^n=0) si \(0<q<1)<br>
\(\lim_{n\to+\infty}q^n=+\infty) si \(q>1)<br>
\(\lim_{n\to+\infty}n=+\infty) et \(\lim_{n\to+\infty}n^2=+\infty)<br>
Ainsi que la limite d'une somme, d'un produit et d'un quotient.
</p>}
\answer{}{\rep1;\prop}{type=clickfill}
\answer{}{\rep2;\prop}{type=clickfill}
\answer{}{\rep3;\prop}{type=clickfill}
\answer{}{\rep4;\prop}{type=clickfill}
