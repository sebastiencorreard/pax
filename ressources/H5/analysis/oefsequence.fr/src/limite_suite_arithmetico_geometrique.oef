\title{Limite d'une suite arithmético-géométrique}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}

\real{q=randint(1..20)/10}
\real{absa=randint(1..100)/10}\text{sa=randitem(-,+)}\text{s=randitem(-,+)}
\real{a=\sa\absa}
\real{absb=randint(1..100)/10}\text{sb=randitem(-,+)}
\real{b=\sb\absb}
\real{absc=randint(1..100)/10}\text{sc=randitem(-,+)}
\real{c=\sc\absc}


\text{tg1=\(u_n=\a\times(\q)^n\sb\absb)}
\text{tg2=\(u_n=\frac{\a\s(\q)^n}{\c})}
\integer{k=randint(1,2)}
\text{tg=\tg1,\tg2}

\if{\q>1}{\text{rep1=\(+\infty)}}{\if{\q=1}{\text{rep1=1}}{\text{rep1=0}}}

\if{\s issametext \sc}{\text{\slim=+}}{\text{\slim=-}}
\if{\q>1}{\if{\k=1}{\text{rep2=\(\sa\infty)}}{\text{rep2=\(\slim\infty)}}}{
\if{\q=1}{\if{\k=1}{\real{rep2=\a+\b}}{\real{rep2=(\a+1)/\c}}}
{\if{\k=1}{\real{rep2=\b}}{\real{rep2=\a/\c}}}
}

\real{l1=\a/\b}
\real{l2=(\a+1)/\c}
\real{l3=\a+\b}


\steps{r1
r2
}

\statement{

<div id="enonce">
On considère la suite de terme général \tg[\k]<br>
</div>

\if{\step=1}{
<div class="question">Calculer la limite suivante.
<div class="reponse">
\(\lim_{n\to+\infty}(\q)^n)=\embed{r1}
</div>
</div>
}

\if{\step=2 and \reply1=\rep1}{
<div class="question">
<div class="oui">
\(\lim_{n\to+\infty}(\q)^n)=\rep1
</div>

En déduire la limite de la suite \(u_n).
<div class="reponse">
\(\lim_{n\to+\infty}u_n)=\embed{r2}
</div>
</div>
}

\if{\step=2 and \reply1!=\rep1}{
<div class="question">
<div class="non">
\(\lim_{n\to+\infty}(\q)^n)=\rep1.
</div>
En déduire la limite de la suite \(u_n).
<div class="reponse">
\(\lim_{n\to+\infty}u_n)=\embed{r2}
</div>
</div>
}

}


\answer{}{\rep1;\(+\infty),0,1,\q,\(-\infty)}{type=clickfill}{option=nonstop}
\answer{}{\rep2;\(-\infty),\(+\infty),0,1,\l1,\l2,\l3}{type=clickfill}
