\title{Pourcentage et coefficient multiplicateur (2)}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{1000}

\real{CM1=randint(1..99)/100}\real{CM2=randint(101..700)/100}
\real{CM=randitem(\CM1,\CM2)}
\if{\CM>1}{\text{evolution=augmentation} and \integer{numevol=1}}
{\text{evolution=diminution} and \integer{numevol=2}}

\if{\CM>1}{\real{taux=(\CM-1)*100}}{\real{taux=(1-\CM)*100}}


\statement{

<div class="question">
On donne CM=\CM.<br>
Traduire ce coefficient multiplicateur en une augmentation ou diminution
puis préciser en % le taux d'évolution correspondant.
<div class="reponse">
Ce CM traduit une \embed{r1} de \embed{r2} %.
</div>
</div>
}

\answer{}{\numevol;augmentation,diminution}{type=menu}
\answer{}{\taux}{type=numeric}
\hint{<p class="consigne">Si CM>1, il s'agit d'une augmentation en % de t=(CM-1)*100.<br>
Si CM<1, il s'agit d'une diminution en % de t=(1-CM)*100.</p>
}
