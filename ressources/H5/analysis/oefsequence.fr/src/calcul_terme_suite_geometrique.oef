\title{Calcul du terme d'une suite géométrique}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\real{q=randint(-50..50)/10}\if{\q=0}{\real{q=6}}\if{\q=1}{\real{q=7}}
\real{vi=randint(-50..50)/10}
\integer{p=randint(0..1)}



\integer{n=randint(2..10)}


\real{un_approche=rint(\vi*(\q)^(\n-\p)*10)/10}
\text{un_exact=\vi*(\q)^(\n-\p)}
\real{u=\vi*(\q)^(\n-\p)}

\statement{
<div id="enonce">
On considère une suite géométrique de raison q=\q telle que 
u<sub>\p</sub>=\vi.
</div>

<div class="question">
Calculer u<sub>\n</sub> en arrondissant à 10<sup>-1</sup>.
<div class="reponse">
u<sub>\n</sub>=\embed{r1}
</div>
</div>
}

\hint{<p class="consigne">Appliquer la formule 
u<sub>n</sub>=u<sub>p</sub>&times q<sup>n-p</sup> 
où u<sub>n</sub>=terme cherché et u<sub>p</sub>=terme donné</p>}
\answer{}{\reply1}{type=numeric}
\text{test=\reply1-\un_exact<=.1 and \reply1-\un_exact>=-.1?1:0}
\condition{Réponse exacte ?}{\test=1}
\solution{La bonne réponse est \un_approche}
