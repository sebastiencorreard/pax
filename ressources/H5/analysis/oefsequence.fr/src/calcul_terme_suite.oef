\title{Calculer le terme d'une suite}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\text{pt=random(u_0,u_1)}\if{pt=u_0}{\text{n0=0}}{\text{n0=1}}
\text{n1=randint(7..15)}
\text{n2=randint(3..6)}
\text{vpt=randint(-5..5)}
\if{n0=0}{\text{D=\N}}{\text{D=\N^*}}

\text{a=0}\while{\a=0}{\real{a=randint(-10..10)/5}}
\text{c=0}\while{\c=0}{\real{c=randint(-10..10)/5}}
\real{b=randint(-10..10)/5}
\text{d=0}\while{\d=0}{\real{d=randint(-10..10)/5}}
\text{q=1}\while{\q=1 or \q=1}{\real{q=randint(-10..10)/5}}

\text{tg0=\a*n+\b, \a*n^2+\b*n+\c, (\a*n+\b)/(\c*n+\d), \a*\q^n}

\text{tg1=\a/n+\b, \a/(n^2)+\b}
\text{i=randint(1..4)}
\text{j=random(1,2)}
\if{\n0=0}{\text{tg=\tg0[\i]}}{\text{tg=\tg1[\j]}}
\text{rep1=maxima(\a*\n1+\b),maxima(\a*\n1^2+\b*\n1+\c),maxima((\a*\n1+\b)/(\c*\n1+\d)),maxima(\a*\q^\n1)}
\text{rep2=maxima(\a/\n1+\b),maxima(\a/(\n1^2)+\b)}
\if{\n0=0}{\real{rep1=\rep1[\i]}}{\real{rep1=\rep2[\j]}}



\text{rdr=\a*u_n,\a*u_n+\b,\a*(u_n)^2,\a/(u_n+\b)}
\text{algo=u:\vpt;for n:\n0 thru \n2;do (u:\a*u);print(u);}
\real{algo4=maxima(\algo)}
\text{k=randint(4)}
\text{rdr=\rdr[\k]}

\statement{algo=\algo;algo4=\algo4
<div id="enonce">
Calculer le terme demandé de la suite \((u_n)).
<div class="question">
1. Pour tout \(n\in\D),\(u_n)=\(\tg).
<div class="reponse">
\(u_{\n1})=\embed{r1}
</div>
</div>

<div class="question">
\(u_(\n0)=\vpt) et \(u_(n+1))=\(\rdr) pour tout \(n\ge\n0)
<div class="reponse">
\(u_{\n2})=\embed{r2}
</div>
</div>



</div>

}
