\title{Calcul d'une somme}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\text{q=1}\while{\q=1}{\real{q=randint(1..10)/5}}
\if{\q>1}{\text{n=randint(9..13)}}{\text{n=randint(13..25)}}
\text{p=randint(2..3)}
\integer{p1=\p+1}\integer{p2=\p+2}
\text{S=1+\q+\q^2+...+\q^{\n},\q^{\p}+\q^{\p1}+\q^{\p2}+...+\q^{\n}}
\text{i=randint(1..2)}
\if{\i=1}{\real{s=pari((1-\q^(\n+1))/(1-\q))}}{\real{s=pari(\q^(\p)*(1-\q^(\n-\p+1))/(1-\q))}}

\if{\q>1}{\text{precis=à l'unité.}\real{s_a=pari(round(\s))}}{\text{precis=au centième.}\real{s_a=pari((round(\s*100)))/100}}

\statement{
<div id="enonce">
Calculer la somme suivante arrondie \precis :
<div class="reponse">
\(S=\S[\i])=\embed{r1}
</div>

</div>

}

\hint{<p class="consigne">Il s'agit de la somme des termes consécutifs d'une suite géométrique.
On peut donc appliquer la formule \(S=P*(1-q^N)/(1-q))
où P est le premier terme, q la raison et N le nombre de termes.
</p>}
\answer{}{\s_a}{type=numeric}
