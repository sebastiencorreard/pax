\title{Somme de termes consécutifs d'une suite géométrique, limite}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\precision{10000000}

\text{s=randitem(-,+)}
\real{q=1}
\while{\q=1 or \q<=0}{\real{q=1\s 2^(randint(-3..3))*5^(randint(-2..2))}}

\integer{k=randint(1..2)}\if{\k=1}{\integer{n0=0}}{\integer{n0=1}}
\integer{n=randint(2..3)}

\text{s=\(1+\q+\q^2+...+\q^n),\(\q+\q^2+...+\q^n)}

\steps{r1
r2
r3,r4
r5
}

\if{\k=1}{\real{a=1/(1-\q)}}{\real{a=\q/(1-\q)}}
\real{b=\q/(\q-1)}
\if{\b>0}{\text{sb=+}}{\text{sb=}}

\real{rep1=maxima(sum(\q^n,n,\n0,\n))}


\if{\k=1}{\text{rep2=\(\frac{1-\q^{n+1}}{1-\q})}}
{\text{rep2=\(\q\times\frac{1-\q^n}{1-\q})}}

\real{rep3=\a}
\real{rep4=\b}
\real{c=\a+\b}

\text{liste2=
\(\q\times\frac{1-\q^n}{1-\q}),\(\frac{1-\q^n}{1-\q}),
\(\q\times\frac{1-\q^{n+1}}{1-\q}),\(\frac{1-\q^{n+1}}{1-\q}),
}

\text{liste5=\(+\infty),\(-\infty),\a,\b,\c,0}

\if{\q>1}{\text{rep5=\(+\infty)}}{\real{rep5=\a}}

\statement{

<div id="enonce">
On considère la suite \((S_n)) définie par \(S_n)=\s[\k]
pour tout entier naturel n \if{\k=2}{non nul}.
</div>

\if{\step=1}{
<div class="question">
Calculer :
<div class="reponse">
\(S_{\n})=\embed{r1,5}
</div>
</div>
}

\if{\step=2 and \reply1!=\rep1}{
<div class="question">
<div class="non">
On a \(S_{\n})=\rep1
</div>
Exprimer \(S_n) en fonction de \(n).
<div class="reponse">
S<sub>n</sub>=\embed{r2,200x50}
</div>
</div>
}


\if{\step=2 and \reply1=\rep1}{
<div class="question">
Exprimer \(S_n) en fonction de \(n).
<div class="reponse">
S<sub>n</sub>=\embed{r2,200x50}
</div>
</div>
}

\if{\step=3 and \reply2=\rep2}{
<div class="question">
<div class="oui">
Effectivement \(S_n)=\rep2
</div>
Simplifier cette expression en l'écrivant sous la forme \(S_n)=\(a+b\times\q^n).
<p class="consigne">Commencer par calculer le dénominateur.</p>
<div class="reponse">
a=\embed{r3}<br>
b=\embed{r4}
</div>
</div>
}

\if{\step=3 and \reply2!=\rep2}{
<div class="question">
<div class="non">
S<sub>n</sub>=\rep2
</div>
Simplifier cette expression en l'écrivant sous la forme \(S_n)=\(a+b\times\q^n).
<p class="consigne">Commencer par calculer le dénominateur.</p>
<div class="reponse">
a=\embed{r3}<br>
b=\embed{r4}
</div>
</div>
}


\if{\step=4}{
<div class="question">
<div class="oui">Très bien ! \(S_n)=\(\a\sb\b\times\q^n)
</div>
Quelle est la limite de \(S_n) lorsque n tend vers \(+\infty) ?
<p class="consigne">Commencer par calculer \(\lim_{n\to+\infty}\q^n) .</p>
<div class="reponse">
\(\lim_{n\to+\infty}S_n)=\embed{r5}
</div>
</div>
}
}

\answer{S<sub>\n</sub>}{\rep1}{type=numeric}{weight=10}{option=nonstop}
\answer{S<sub>n</sub>:}{\rep2;\liste2}{type=clickfill}{option=nonstop}{weight=2}

\answer{a}{\rep3}{type=numeric}{weight=20}
\answer{b}{\rep4}{type=numeric}{weight=20}
\answer{}{\rep5;\liste5}{type=clickfill}{weight=20}
