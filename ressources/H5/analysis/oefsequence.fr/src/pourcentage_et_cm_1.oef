\title{Pourcentage et coefficient multiplicateur (1)}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{1000}


\text{hausse=randitem(shuffle(une hausse, une augmentation, une revalorisation))}
\text{baisse=randitem(shuffle(une baisse, une diminution, un abattement, un rabais, une ristourne))}
\text{evol=\hausse,\baisse}
\integer{i=randint(1..2)}
\text{evolution=\evol[\i]}

\text{taux=randint(1..100)}
\if{\i=1}{\real{rep=1+\taux/100}}{\real{rep=1-\taux/100}}


\statement{
<div class="question">
Calculer le CM (coefficient multiplicateur) associé à \evolution de \taux %.
<div class="reponse">
CM = \embed{r1,5}
</div>
</div>
}

\answer{}{\rep}{type=numeric}
\hint{<p class="consigne">Pour une augmentation \(CM=1+\frac{t}{100}) 
et pour une diminution \(CM=1-\frac{t}{100})</p>}
