replygood3=$val22;$val17
replytype4=clickfill
replyname4=
replygood4=$val25;$val17
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	Calculer les limites suivantes <br>	<div class="reponse">	
!insmath \[\lim_{n\to+\infty}\]
$() 
!insmath $(val14[$val15])
$() =  
!read oef/embed.phtml r1 
$()	</div>		<div class="reponse">	
!insmath \[\lim_{n\to+\infty}\]
$() 
!insmath $(val18[$val19])
$() =  
!read oef/embed.phtml r2 
$()	</div>		<div class="reponse">	
!insmath \[\lim_{n\to+\infty}\]
$() 
!insmath $(val21[$val6])
$() =  
!read oef/embed.phtml r3 
$()	</div>		<div class="reponse">	
!insmath \[\lim_{n\to+\infty}\]
$() 
!insmath $(val23[$val24])
$() =  
!read oef/embed.phtml r4 
$()	</div>		</div>		
$()
!exit

:hint
$()<p class="consigne">Il faut utiliser les limites suivantes : </br>	
!insmath \lim_{n\to+\infty}q^n=0
$() si 
!insmath 0<q<1
$()<br>	
!insmath \lim_{n\to+\infty}q^n=+\infty
$() si 
!insmath q>1
$()<br>	
!insmath \lim_{n\to+\infty}n=+\infty
$() et 
!insmath \lim_{n\to+\infty}n^2=+\infty
$()<br>	Ainsi que la limite d'une somme, d'un produit et d'un quotient.	</p>
$()
!exit

