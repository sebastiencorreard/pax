!set title=Limite d'une suite
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr

ansorder=r,r,r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=0
!while $val6=0 
tmp0=!randint -100, 100

val6=$[$(tmp0)/10]
!endwhile
val7=1
!while $val7=1 
tmp0=!randint 1, 10

val7=$[$(tmp0)/5]
!endwhile
val8=0
!while $val8=0 or $val8=1 
tmp0=!randint -20, 20

val8=$[$(tmp0)/5]
!endwhile
val9=0
!while $val9=0 
tmp0=!randint -20, 20

val9=$[$(tmp0)/5]
!endwhile
val10=0
!while $val10=0 
tmp0=!randint -20, 20

val10=$[$(tmp0)/5]
!endwhile
tmp0=!randitem 1,2,4,10,-1,-2,-4,-10

val11=$(tmp0)
val12=$[$val8/$val11]
val13=$[1/$val11]
val14=$val6,$val8\times($val7)^n
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
!if $val15=1 
val16=$val6
!endif
!if $val15=2 and $val7<1 
val16=0
!endif
!if $val15=2 and $val7>1 
!if $val8>0 
val16=\(+\infty)
!else
val16=\(-\infty)
!endif
!endif
tmp0=!shuffle $val12,$val8,$val9,$val6,0,\(+\infty),\(-\infty)

val17=$(tmp0)
val18=$val8*n^2,$val8*n^2+$val9
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
!if $val8>0 
val20=\(+\infty)
!else
val20=\(-\infty)
!endif
val21=$val8/n+$val9,$val8/(n^2)
tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
!if $val6=1 
val22=$val9
!else
val22=0
!endif
val23=($val8+$val9*$val7^n)/($val11+$val10* $val7^n),1/($val11+$val10*$val7^n)
tmp0=!randint 1, 2

val24=$[rint($(tmp0))]
!if $val7>1 
!if $val24=1 
val25=FI
!else
val25=0
!endif
!endif
!if $val7<1 
!if $val24=1 
val25=$val12
!else
val25=$val13
!endif
!endif
replytype1=clickfill
replyname1=
replygood1=$val16;$val17
replytype2=clickfill
replyname2=
replygood2=$val20;$val17
replytype3=clickfill
