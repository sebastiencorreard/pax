!set title=Pourcentage et coefficient multiplicateur (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
computeanswer=no
precision=1000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle une hausse, une augmentation, une revalorisation

tmp=!nonempty items $(tmp0)

tmp1=!randitem $tmp
val6=$(tmp1)
tmp0=!shuffle une baisse, une diminution, un abattement, un rabais, une ristourne

tmp=!nonempty items $(tmp0)

tmp1=!randitem $tmp
val7=$(tmp1)
val8=$val6,$val7
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=$(val8[$val9])
tmp0=!randint 1, 100

val11=$(tmp0)
!if $val9=1 
val12=$[1+$val11/100]
!else
val12=$[1-$val11/100]
!endif
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="question">	Calculer le CM (coefficient multiplicateur) associé à $val10 de $val11 %.	<div class="reponse">	CM =  
!read oef/embed.phtml r1,5 
$()	</div>	</div>	
$()
!exit

:hint
$()<p class="consigne">Pour une augmentation 
!insmath CM=1+\frac{t}{100}
$() 	et pour une diminution 
!insmath CM=1-\frac{t}{100}
$()</p>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=1
