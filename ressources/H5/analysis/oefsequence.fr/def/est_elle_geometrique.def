tmp0=!randint -100, 100

val6=$[$(tmp0)/10]
!if $val6=0 
val6=$[rint(1)]
!endif
tmp0=!randint 2, 25

val7=$[rint($(tmp0))]
val8=$[$val7*$val6]
val9=$[$val7*$val8]
val10=$[$val7*$val9]
val11=$[$val7*$val6+1]
val12=$[$val7*$val8+1]
val13=$[$val7*$val9+1]
tmp=!trim $val6,$val8,$val9,$val10;$val6,$val11,$val12,$val13
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
val16=$(val14[$val15;])
val17=r1
val18=La population d'un certain pays, Le prix d'un article, Le nombre d'abonnés à une revue, Le capital de M. X,	Le taux de chômage, La production d'une usine 
val19=la population , le prix de cet article , le nombre d'abonnés, son capital, le taux de chômage,	la production de cette usine
tmp0=!randint 1, 6

val20=$[rint($(tmp0))]
val21=croît, augmente, décroît, diminue
tmp0=!randint 1, 4

val22=$[rint($(tmp0))]
tmp=!nonempty items 2000,2002,2004,2006,2008,2010,2012

tmp0=!randitem $tmp
val23=$(tmp0)
tmp0=!randint 1, 50

val24=$[$(tmp0)/10]
val25=$(val18[$val20]) $(val21[$val22]) de $val24 % par an.<br> On note	u<sub>n</sub> $(val19[$val20]) l'année $val23+n	. On définit ainsi une suite numérique (u<sub>n</sub>).
val26=On donne les premiers termes d'une suite :<br>	<table width=100%>	<tr>	<td>u<sub>0</sub>=$(val16[1])</td>	<td>u<sub>1</sub>=$(val16[2])</td>	<td>u<sub>2</sub>=$(val16[3])</td>	</tr>	</table>	
tmp0=!randint 1, 2

val27=$[rint($(tmp0))]
!if $val27=1 
val28=$val25
!else
val28=$val26
!endif
!if $val27=1 
val29=1
!else
!if $val15=2 
val29=3
!else
val29=2
!endif
!endif
val30=est,semble,n'est pas
val31=$(val30[$val15])
!if $val29=1 and ($val22=1 or $val22=2) 
val32=$[1+$val24/100]
!endif
!if $val29=1 and ($val22=3 or $val22=4) 
val32=$[1-$val24/100]
!endif
!if $val29=2 
val32=$[$val7]
!endif
dynsteps=yes
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
