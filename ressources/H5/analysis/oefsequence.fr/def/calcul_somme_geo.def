!set title=Calcul d'une somme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=1
!while $val6=1 
tmp0=!randint 1, 10

val6=$[$(tmp0)/5]
!endwhile
!if $val6>1 
tmp0=!randint 9, 13

val7=$(tmp0)
!else
tmp0=!randint 13, 25

val7=$(tmp0)
!endif
tmp0=!randint 2, 3

val8=$(tmp0)
val9=$[rint($val8+1)]
val10=$[rint($val8+2)]
val11=1+$val6+$val6^2+...+$val6^{$val7},$val6^{$val8}+$val6^{$val9}+$val6^{$val10}+...+$val6^{$val7}
tmp0=!randint 1, 2

val12=$(tmp0)
!if $val12=1 
t_=!replace internal \( by ( in (1-$val6^($val7+1))/(1-$val6)
tmp0=!exec pari $t_

val13=$[$(tmp0)]
!else
t_=!replace internal \( by ( in $val6^($val8)*(1-$val6^($val7-$val8+1))/(1-$val6)
tmp0=!exec pari $t_

val13=$[$(tmp0)]
!endif
!if $val6>1 
val14=à l'unité.
t_=!replace internal \( by ( in round($val13)
tmp0=!exec pari $t_

val15=$[$(tmp0)]
!else
val14=au centième.
t_=!replace internal \( by ( in (round($val13*100))
tmp0=!exec pari $t_

val15=$[$(tmp0)/100]
!endif
replytype1=numeric
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	Calculer la somme suivante arrondie $val14 :	<div class="reponse">	
!insmath S=$(val11[$val12])
$()= 
!read oef/embed.phtml r1 
$()	</div>		</div>		
$()
!exit

:hint
$()<p class="consigne">Il s'agit de la somme des termes consécutifs d'une suite géométrique.	On peut donc appliquer la formule 
!insmath S=P*(1-q^N)/(1-q)
$()	où P est le premier terme, q la raison et N le nombre de termes.	</p>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,14
embedcnt=1
