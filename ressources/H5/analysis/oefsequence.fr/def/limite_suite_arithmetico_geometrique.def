!set title=Limite d'une suite arithmético-géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr

ansorder=r,r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

val6=$[$(tmp0)/10]
tmp0=!randint 1, 100

val7=$[$(tmp0)/10]
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[$val8$val7]
tmp0=!randint 1, 100

val11=$[$(tmp0)/10]
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val12=$(tmp0)
val13=$[$val12$val11]
tmp0=!randint 1, 100

val14=$[$(tmp0)/10]
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val15=$(tmp0)
val16=$[$val15$val14]
val17=\(u_n=$val10\times($val6)^n$val12$val11)
val18=\(u_n=\frac{$val10$val9($val6)^n}{$val16})
tmp0=!randitem 1,2

val19=$[rint($(tmp0))]
val20=$val17,$val18
!if $val6>1 
val21=\(+\infty)
!else
!if $val6=1 
val21=1
!else
val21=0
!endif
!endif
!if $val9 issametext $val15 
val22=+
!else
val22=-
!endif
!if $val6>1 
!if $val19=1 
val23=\($val8\infty)
!else
val23=\($val22\infty)
!endif
!else
!if $val6=1 
!if $val19=1 
val23=$[$val10+$val13]
!else
val23=$[($val10+1)/$val16]
!endif
!else
!if $val19=1 
val23=$[$val13]
!else
val23=$[$val10/$val16]
!endif
!endif
!endif
val24=$[$val10/$val13]
val25=$[($val10+1)/$val16]
val26=$[$val10+$val13]
oefsteps=r1	r2 
nextstep=!nosubst r1	r2 
!readproc oef/steps.proc
replytype1=clickfill
replyoption1=nonstop 
replyname1=
replygood1=$val21;\(+\infty),0,1,$val6,\(-\infty)
replytype2=clickfill
replyname2=
replygood2=$val23;\(-\infty),\(+\infty),0,1,$val24,$val25,$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div id="enonce">	On considère la suite de terme général $(val20[$val19])<br>	</div>		
!if $m_step=1 
$()	<div class="question">Calculer la limite suivante.	<div class="reponse">	
!insmath \lim_{n\to+\infty}($val6)^n
$()= 
!read oef/embed.phtml r1 
$()	</div>	</div>	 
!endif
$()		
!if $m_step=2 and $m_reply1=$val21 
$()	<div class="question">	<div class="oui">	
!insmath \lim_{n\to+\infty}($val6)^n
$()=$val21	</div>		En déduire la limite de la suite 
!insmath u_n
$().	<div class="reponse">	
!insmath \lim_{n\to+\infty}u_n
$()= 
!read oef/embed.phtml r2 
$()	</div>	</div>	 
!endif
$()		
!if $m_step=2 and $m_reply1!=$val21 
$()	<div class="question">	<div class="non">	
!insmath \lim_{n\to+\infty}($val6)^n
$()=$val21.	</div>	En déduire la limite de la suite 
!insmath u_n
$().	<div class="reponse">	
!insmath \lim_{n\to+\infty}u_n
$()= 
!read oef/embed.phtml r2 
$()	</div>	</div>	 
!endif
$()		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,19,20,21
embedcnt=3
