$()	avec 
!insmath u_0
$()= 
!read oef/embed.phtml r1,4 
$() et q= 
!read oef/embed.phtml r2,4 
$()	</div>	</div>	 
!endif
$()		
!if $m_step=2 and ($m_sc_reply1=1 and $m_sc_reply2=1) 
