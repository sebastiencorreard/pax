!insmath u_n=u_0\times q^n=$val24\times($val25)^n
$().	</div>	Etudier les variations de cette suite.	<div class="reponse">	Puisque 
!insmath u_0
$() est  
!read oef/embed.phtml r3 
$() et  
!read oef/embed.phtml r4 
$(), on peut donc affirmer que la suite 
!insmath (u_n)
$() est   
!read oef/embed.phtml r5 
$()	</div>	</div>	 
!endif
$()		
!if $m_step=2 and ($m_sc_reply1!=1 or $m_sc_reply2!=1) 
$()	<div class="question">	<div class="non">On a 
!insmath u_n=u_0\times q^n=$val24\times($val25)^n
$().	</div>	Etudier les variations de cette suite.	<div class="reponse">	Puisque 
!insmath u_0
$() est  
!read oef/embed.phtml r3 
$() et  
!read oef/embed.phtml r4 
$(), on peut donc affirmer que la suite 
!insmath (u_n)
$() est   
!read oef/embed.phtml r5 
$()	</div>	</div>	 
!endif
$()			
!if $val25>0 and $m_step=3 
$()	<div class="question">	Nous savons que 
!insmath u_n=$val24\times$val25^n
$().<br>	Calculer maintenant la limite de 
!insmath u_n
