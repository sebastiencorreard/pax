!set title=Calcul du terme d'une suite géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r
varcnt=11
prevarcnt=9
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -50, 50

val6=$[$(tmp0)/10]
!if $val6=0 
val6=$[6]
!endif
!if $val6=1 
val6=$[7]
!endif
tmp0=!randint -50, 50

val7=$[$(tmp0)/10]
tmp0=!randint 0, 1

val8=$[rint($(tmp0))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
val10=$[rint($val7*($val6)^($val9-$val8)*10)/10]
val11=$val7*($val6)^($val9-$val8)
val12=$[$val7*($val6)^($val9-$val8)]
replytype1=numeric
replyname1=
replygood1=?analyze 13
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst <p class="consigne">Appliquer la formule u<sub>n</sub>=u<sub>p</sub>&times q<sup>n-p</sup> où u<sub>n</sub>=terme cherché et u<sub>p</sub>=terme donné</p>

solution=!nosubst La bonne réponse est $val10


!goto stat

!exit

:question
$()	<div id="enonce">	On considère une suite géométrique de raison q=$val6 telle que 	u<sub>$val8</sub>=$val7.	</div>		<div class="question">	Calculer u<sub>$val9</sub> en arrondissant à 10<sup>-1</sup>.	<div class="reponse">	u<sub>$val9</sub>= 
!read oef/embed.phtml r1 
$()	</div>	</div>	
$()
!exit

