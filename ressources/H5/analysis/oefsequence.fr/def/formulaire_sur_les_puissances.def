 !exit
!endif

tmp0=!randint 1, 6

val6=$[rint($(tmp0))]
val7=2,3,2
val8=\(q^0),\(q^1),\(q^{-1}),\(q^a\times q^b),\(\frac{q^a}{q^b}),\((q^a)^b)
val9=1,\(q),\(\frac1q),\(q^{a+b}),\(q^{a-b}),\(q^{a\times b})
val10=0,-1,-q,\(q^(a/b))
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$(val9[$val6]);$val9,$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

