!set title=Pourcentage et coefficient multiplicateur (2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=1000

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 99

val6=$[$(tmp0)/100]
tmp0=!randint 101, 700

val7=$[$(tmp0)/100]
tmp=!nonempty items $val6,$val7

tmp0=!randitem $tmp
val8=$[$(tmp0)]
!if $val8>1 
val9=augmentation
val10=$[rint(1)]
!else
val9=diminution
val10=$[rint(2)]
!endif
!if $val8>1 
val11=$[($val8-1)*100]
!else
val11=$[(1-$val8)*100]
!endif
replytype1=menu
replyname1=
replygood1=$val10;augmentation,diminution
replytype2=numeric
replyname2=
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst <p class="consigne">Si CM>1, il s'agit d'une augmentation en % de t=(CM-1)*100.<br> Si CM<1, il s'agit d'une diminution en % de t=(1-CM)*100.</p> 


!goto stat

!exit

:question
$()		<div class="question">	On donne CM=$val8.<br>	Traduire ce coefficient multiplicateur en une augmentation ou diminution	puis préciser en % le taux d'évolution correspondant.	<div class="reponse">	Ce CM traduit une  
!read oef/embed.phtml r1 
$() de  
!read oef/embed.phtml r2 
$() %.	</div>	</div>	
$()
!exit

:hint
$()<p class="consigne">Si CM>1, il s'agit d'une augmentation en % de t=(CM-1)*100.<br> Si CM<1, il s'agit d'une diminution en % de t=(1-CM)*100.</p> 
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

