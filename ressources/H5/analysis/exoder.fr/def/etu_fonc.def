val13=!rawmath $val12*(x-$val8)*(x-$val9)
t_=!replace internal \( by ( in expand(6*($val13))
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val14=!rawmath $(tmp1)
t_=!replace internal \( by ( in expand($val14)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
!readproc slib/function/bounds $val14, x,-5,5 
tmp0=$slib_out
val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$[rint($(tmp0))]
tmp0=!item 2 of $val15

val17=$[rint($(tmp0))]
tmp0=!randitem $val16,$val17

val18=$[rint($(tmp0))]
!if $val10=1 
!if $val12>0 
evaltmp=$val14

evaltmp=!mathsubst x=($val8) in $evaltmp
tmp0=($evaltmp)
val18=$[rint(-$(tmp0))]
!endif
!if $val12<0 
evaltmp=$val14

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val18=$[rint(-$(tmp0))]
!endif
!endif
val14=!rawmath $val14+$val18
!if $val8=$val9 
val19=$[rint(1)]
!else
val19=$[rint(2)]
!endif
!if $val12>0 
val20=$[rint(1)]
!endif
!if $val12<0 
val20=$[rint(2)]
!endif
evaltmp=$val14

evaltmp=!mathsubst x=($val8) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val21=!exec pari print($t_)
evaltmp=$val14

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val22=!exec pari print($t_)
!if $val21>0 
val23=$[rint(0)]
!endif
!if $val21=0 
val23=$[rint(1)]
!endif
!if $val21<0 
val23=$[rint(2)]
!endif
!if $val22>0 
val24=$[rint(0)]
!endif
!if $val22=0 
