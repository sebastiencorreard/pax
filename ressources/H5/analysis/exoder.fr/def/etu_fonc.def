tmp0=!item $val25 of $val26

val27=$[rint($(tmp0))]
tmp0=!randitem 1,2

val28=$[rint($(tmp0))]
val28=$[rint(1)]
!if $val28=1 
val29=la fonction \(f)
val30=$[rint($val27)]
!endif
!if $val28=2 
