!set title=Lien entre variation et signe de la dérivée 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative, function_variation
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style type="text/css"> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, -1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val8*(x-$val6)/(x-$val7)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
!if $val10=1 
val11=&#91;
tmp0=!randint 1, 2

val12=$[rint($val6-$(tmp0))]
tmp0=!randint $val6, $val7

val13=$[rint($(tmp0))]
!if $val13=$val6 
val13=$[rint($val6+1)]
!endif
val14=&#93;
val15=$[rint(3)]
!endif
!if $val10=2 
val11=&#91;
tmp0=!randint $val6, 0

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val13=$[rint($(tmp0))]
val14=&#91;

!ifval $val8>0
val15=$[rint(2)]
!else
val15=$[rint(1)]
!endif
!endif
!if $val10=3 
val11=&#93;
val12=\(-\infty)
tmp0=!randint -10, $val6

val13=$[rint($(tmp0))]
val14=&#93;

!ifval $val8>0
val15=$[rint(1)]
!else
val15=$[rint(2)]
!endif
!endif
!if $val10=4 
val11=&#93;
tmp0=!randint $val7, 10

val12=$[rint($(tmp0))]
val13=\(+\infty)
val14=&#91;

!ifval $val8>0
val15=$[rint(1)]
!else
val15=$[rint(2)]
!endif
!endif
!if $val8>0 
val16=\nearrow
val17=\searrow
val18=\nearrow
!endif
!if $val8<0 
val16=\searrow
val17=\nearrow
val18=\searrow
!endif
val19=positive,négative, de signe non constant
replytype1=menu
replyname1=Variations
replygood1=$val15;$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère une fonction 
!insmath f
$(), dont le tableau de variations est donné ci-dessous:	<table class="wimscenter wimsnoborder tab_var">	<tr>	<th>
!insmath x
$()</th><td>
!insmath -\infty
$()</td><td></td><td>$val6</td><td></td><td>$val7</td><td></td><td>+$m_infty</td>	</tr><tr>	<th>
!insmath f(x)
$()</th><td></td><td>
!insmath $val16
$()</td><td></td><td>
!insmath $val17
$()</td><td></td><td>
!insmath $val18
$()</td><td></td>	</tr>	</table>	Sur l'intervalle $val11 $val12;$val13 $val14, la <b> dérivée </b> de la fonction 
!insmath f
$() est :  
