!set title=Variations d'un polynôme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative, tangent, graphing
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, -1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(6*$val8*(x-$val6)*(x-$val7))
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val9,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val10=!rawmath $(tmp0)
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
!if $val11=1 
val12=&#91;
tmp0=!randint 1, 2

val13=$[rint($val6-$(tmp0))]
tmp0=!randint $val6, $val7

val14=$[rint($(tmp0))]
val15=&#93;
val16=$[rint(3)]
!endif
!if $val11=2 
val12=&#91;
tmp0=!randint $val6, 0

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val14=$[rint($(tmp0))]
val15=&#93;

!ifval $val8>0
val16=$[rint(2)]
!else
val16=$[rint(1)]
!endif
!endif
!if $val11=3 
val12=&#93;
val13=\(-\infty)
tmp0=!randint -10, $val6

val14=$[rint($(tmp0))]
val15=&#93;

!ifval $val8>0
val16=$[rint(1)]
!else
val16=$[rint(2)]
!endif
!endif
!if $val11=4 
val12=&#91;
tmp0=!randint $val7, 10

val13=$[rint($(tmp0))]
val14=\(+\infty)
val15=&#91;

!ifval $val8>0
val16=$[rint(1)]
!else
val16=$[rint(2)]
!endif
!endif
val17=strictement croissante,sitrctement décroissante, ni croissante ni décroissante
tmp0=!texmath $val10

val18=$(tmp0)
oefsteps=reply 1	reply 2	reply 3 
nextstep=!nosubst reply 1	reply 2	reply 3 
!readproc oef/steps.proc
replytype1=default
replyname1=der
replygood1=$val9
replytype2=fset
replyname2=rac
replygood2=$val6,$val7
replytype3=menu
replyname3=Variations
replygood3=$val16;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la fonction 
!insmath f(x)=$val18
$() 	
!if $m_step=1 
$()	<p>	Calculer la fonction dérivée de la fonction 
!insmath f
$(). </p>	<div class="wimscenter">On a 
!insmath f'(x)=
$() 
!read oef/embed.phtml reply 1 
$(). </div>	 
!endif
$()	
!if $m_step=2 
$()<p>	Pour quelles valeurs de 
!insmath x
$(), la courbe 
!insmath C_f
$() admet-elle une tangente horizontale	au point d'abscisse 
!insmath x
$() ? </p>	<div class="wimscenter"> 
!read oef/embed.phtml reply 2 
$()</div>	 
!endif
$()	
!if $m_step=3 
$()	<p>	Sur l'intervalle $val12 $val13;$val14 $val15 la fonction 
!insmath f(x)=$val10
$() est :</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply 3 
$()</div>	 
!endif
$()	
$()
!exit

