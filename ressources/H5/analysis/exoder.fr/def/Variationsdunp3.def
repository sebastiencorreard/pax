!set title=Variations d'un polynôme: graphique 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=40
prevarcnt=39
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, -1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(6*$val8*(x-$val6)*(x-$val7))
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val9,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val10=!rawmath $(tmp0)
!readproc slib/function/bounds $val10, x,$val6-1,$val7+1 
tmp0=$slib_out
val11=$(tmp0)
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
!if $val12=1 
val13=&#91;
tmp0=!randint 1, 2

val14=$[rint($val6-$(tmp0))]
tmp0=!randint $val6, $val7

val15=$[rint($(tmp0))]
val16=&#93;
!if $val15=$val6 
val15=$[rint($val6+1)]
!endif
val17=$[rint(3)]
!endif
!if $val12=2 
val13=&#91;
tmp0=!randint $val6, 0

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val15=$[rint($(tmp0))]
val16=&#93;

!ifval $val8>0
val17=$[rint(2)]
!else
val17=$[rint(1)]
!endif
!endif
!if $val12=3 
val13=&#93;
val14=\(-\infty)
tmp0=!randint -10, $val6

val15=$[rint($(tmp0))]
val16=&#93;

!ifval $val8>0
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif
!endif
!if $val12=4 
val13=&#91;
tmp0=!randint $val7, 10

val14=$[rint($(tmp0))]
val15=\(+\infty)
val16=&#91;

!ifval $val8>0
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif
!endif
val18=$[rint(-6)]
val19=$[rint(6)]
val20=$[rint(max(\M,5))]
val21=$[rint(-$val20)]
val20=$[rint($(val11[2])+1)]
val21=$[rint($(val11[1])-1)]
val22=$[rint(2*$val19+1)]
val23=$[rint(2*$val20+1)]
val24=$[rint(max($val20,-$val21))]
val25=$[rint(floor($val24/5)+1)]
val26=strictement positive,strictement négative, de signe non constant
replytype1=menu
replyname1=Variations
replygood1=$val17;$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right">	 
!read oef/draw.phtml 200,200 \
	xrange $val18,$val19	yrange $val21,$val20	linewidth 1	parallel $val18,0,$val19,0,0,$val25,5,green	parallel $val18,0,$val19,0,0,-$val25,5,green	parallel $val18,$val21,$val18,$val20,1,0,$val22,green		linewidth 2	line $val18,0,$val19,0,blue	line 0,$val21,0,$val20,blue		arrow 0,0,1,0,10,blue	arrow 0,0,0,1,10,blue	plot red,$val10	 
$()	</div>	On considère une fonction 
!insmath f
$(), dont la représentation graphique est donné ci-contre.	<div class="spacer">	Sur l'intervalle $val13 $val14;$val15 $val16 la fonction <b>dérivée</b> 
!insmath f'
$() est :  
!read oef/embed.phtml reply 1 
$().	</div>	
$()
!exit

