!set title=Lecture graphique (précis)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, graphing,function_variation
author=Fabien, Sommier
email=math.sommier@gmail.com
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 2

t_=!rawmath $(tmp0)*$(tmp1)
val6=!exec pari print($t_)
tmp0=!randint -4, 4

tmp1=!randint 1, 2

t_=!rawmath $(tmp0)/$(tmp1)
val7=!exec pari print($t_)
tmp0=!randint -3, 3

tmp1=!randint 1, 2

t_=!rawmath $(tmp0)\$(tmp1)
val8=!exec pari print($t_)
tmp0=!randitem $val6*x^2+$val7*x+$val8,$val6*x^3+$val7*x^2+$val8*x

val9=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val9
tmp0=!exec pari $t_

val9=!rawmath $(tmp0)
tmp0=!texmath $val9

val10=$(tmp0)
tmp0=!randint -2, 2

val11=$[rint($(tmp0))]
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
evaltmp=$val13

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
!if abs($val14)>=10 
val11=$[rint(0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
evaltmp=$val13

evaltmp=!mathsubst x=($val11) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
!endif
val15=$[-3.5]
val16=$[3.5]
!readproc slib/function/bounds $val9, x,$val15,$val16 
tmp0=$slib_out
val17=$(tmp0)
val18=$[rint($(val17[1])-2)]
val19=$[rint($(val17[2])+2)]
!if $val18>=0 
val18=$[rint(-1)]
!endif
!if $val19<=0 
val19=$[rint(1)]
!endif
!if $val19-$val18 > 15 
!if abs($(val17[2]))>abs(A[1]) 
val18=$[rint(min($val12-4,-1))]
val19=$[rint(max($val12+8,1))]
!else
val18=$[rint(min($val12-8,-1))]
val19=$[rint(max($val12+4,1))]
!endif
!endif
val20=xrange $val15,$val16	yrange $val18,$val19		parallel $val15+.5,$val18,$val15+.5,$val19,1,0,$val16 - $val15 +1, darkgrey	parallel $val15,$val18,$val16,$val18,0,1,$val19 -$val18 +1, darkgrey		linewidth 2	hline 0,0,black	vline 0,0,black		line 1,-0.2,1,0.2, black	line -0.05,1,0.05,1, black	text black, 0.9,-0.25,medium, 1	text black, -0.2,1.25,medium, 1	text black, -0.2,-0.25,medium, "0"		point 0,0, black	hline 0,0, black	vline 0,0, black		plot blue, $val9	fcircle $val11,$val12,7, green		linewidth 2	plot green, $val12+(x-$val11)*$val14		text black,$val11,$val12,medium,A	
val21=xrange $val15,$val16	yrange $val18,$val19		parallel $val15+.5,$val18,$val15+.5,$val19,0.5,0,2*($val16 - $val15) +1, lightgrey	parallel $val15,$val18,$val16,$val18,0,0.5,2*($val19 -$val18) +1,lightgrey	parallel $val15+.5,$val18,$val15+.5,$val19,1,0,$val16 - $val15 +1, darkgrey	parallel $val15,$val18,$val16,$val18,0,1,$val19 -$val18 +1, darkgrey		linewidth 2	hline 0,0,black	vline 0,0,black		line 1,-0.2,1,0.2, black	line -0.05,1,0.05,1, black	text black, 0.9,-0.25,medium, 1	text black, -0.2,1.25,medium, 1	text black, -0.2,-0.25,medium, "0"		point 0,0, black	hline 0,0, black	vline 0,0, black		plot blue, $val9	fcircle $val11,$val12,7, green		linewidth 2	plot green, $val12+(x-$val11)*$val14		text black,$val11,$val12,medium,A	
oefsteps=r1	r2,r3 
nextstep=!nosubst r1	r2,r3 
!readproc oef/steps.proc
replytype1=menu
replyweight1=0 
replyname1=
replygood1=?analyze 22;oui,non
replytype2=numexp
replyweight2=2 
replyname2=
replygood2=$val12
replytype3=numexp
replyweight3=3 
replyname3=
replygood3=$val14
