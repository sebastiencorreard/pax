!set title=Lecture graphique du nombre dérivé (signe)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative, graphing
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
tmp0=!randint -2, 2

val7=$[rint($(tmp0))]
tmp0=!randint -2, 2

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val6*(x-$val7)^2+$val8)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 2

val10=$[rint($val7+$(tmp0)*$(tmp1))]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[rint($(tmp0))]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
evaltmp=$(tmp0)

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp1=($evaltmp)
val12=$[rint($(tmp1))]
t_=!replace internal \( by ( in expand($val12*(x-$val10)+$val11)
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
val14=$[rint($val10-5)]
val15=$[rint($val10+5)]
val16=$[rint($val11-5)]
val17=$[rint($val11+5)]
val18=$[rint(11)]
val19=$[rint(11)]
!if $val12>0 
val20=\(f'($val10)>0)
!endif
!if $val12<0 
val20=\(f'($val10)<0)
!endif
!if $val12=0 
val20=\(f'($val10)=0)
!endif
val21=\(f'($val10)>0),\(f'($val10)<0),\(f'($val10)=0),
replytype1=dragfill
replyname1=Nombre dérivé
replygood1=$val20;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right">	 
!read oef/draw.phtml 200,200 \
	animate 10,0.5,0	xrange $val14,$val15	yrange $val16,$val17	linewidth 1	parallel $val14,$val16,$val15,$val16,0,1,$val18,green	parallel $val14,$val16,$val14,$val17,1,0,$val19,green		linewidth 2	line $val14,0,$val15,0,blue	line 0,$val16,0,$val17,blue		arrow 0,0,1,0,10,blue	arrow 0,0,0,1,10,blue	plot red,$val9	plot green,$val13		text green,$val10+0.2,$val11,normal,A	 
$()	</div>	On considère la courbe 
!insmath C
$(), représentant la fonction	
!insmath f
$() définie sur 
!insmath \mathbb{R}
$() par	<div class="wimscenter">	 
!insmath f(x)=$val9
$(),	</div>	 ainsi que la droite 
!insmath d
$(),	tangente à 
!insmath C
$() au point 
!insmath A($val10;$val11)
$().	 La courbe 
!insmath C
$() et sa tangente 
!insmath d
$() sont représentées ci-dessous.	 Par lecture graphique, on peut affirmer que:	<div class="wimscenter">	  
!read oef/embed.phtml reply 1,100x30 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,13,14,15,16,17,18,19
embedcnt=1
