!set title=Dérivée de l'inverse d'une fonction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val9+$val6/($val8*x+$val9)
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val11=!rawmath $(tmp0)
val12=$[rint(-$val6*$val8)]

!ifval $val12>0
val13=$[rint(1)]
!else
val13=$[rint(2)]
!endif
val14=strictement croissante,strictement décroissante
t_=!rawmath -$val9/$val8
val15=!exec pari print($t_)
!if \al=1 
val16=&#93; $val15; + \(\infty) &#91;
!else
val16=&#93; -\(\infty);$val15 &#91;
!endif
oefsteps=reply 1	reply 2	reply 3 
nextstep=!nosubst reply 1	reply 2	reply 3 
!readproc oef/steps.proc
replytype1=default
replyname1=Valeur interdite
replygood1=$val15
replytype2=default
replyname2=Fonction dérivée
replygood2=$val11
replytype3=menu
replyname3=r
replygood3=$val13;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la fonction 
!insmath f
$() définie par la relation	
!insmath f(x) = $val10
$().	<div class="spacer">	
!if $m_step=1 
$()	Pour quelle valeur de 
!insmath x
$() la fonction 
!insmath f
$() n'est-elle pas définie ?  
!read oef/embed.phtml reply 1 
$() ?	 
!endif
$()	
!if $m_step=2 
$()	La fonction dérivée de 
!insmath f
$() est 
!insmath f'(x)=
$()  
!read oef/embed.phtml reply 2 
$().	 
!endif
$()	
!if $m_step=3 
$()	Oui, on a bien 
!insmath f'(x)=$val11
$().	<div>	Sur l'intervalle $val16, on peut affirmer que la fonction 
!insmath f
$() est  
!read oef/embed.phtml reply 3 
$().	</div>	 
!endif
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,16
embedcnt=3
