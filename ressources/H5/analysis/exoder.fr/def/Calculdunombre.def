!set title=Calcul du nombre dérivé
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 4

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -4, 4

val7=$[rint($(tmp0))]
tmp0=!randint -4, 4

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val6*(x-$val7)^2+$val8)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 2

val10=$[rint($val7+$(tmp0)*$(tmp1))]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[rint($(tmp0))]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
evaltmp=$(tmp0)

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp1=($evaltmp)
val12=$[rint($(tmp1))]
t_=!replace internal \( by ( in expand($val12*(x-$val10)+$val11)
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
val14=$[rint($val10-5)]
val15=$[rint($val10+5)]
val16=$[rint($val11-5)]
val17=$[rint($val11+5)]
val18=$[rint(11)]
val19=$[rint(11)]
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val20=!rawmath $(tmp0)
val21=$[rint($val11-$val12*$val10)]
oefsteps=reply 1	reply 2	reply 3, reply 4 
nextstep=!nosubst reply 1	reply 2	reply 3, reply 4 
!readproc oef/steps.proc
replytype1=default
replyname1=Dérivé
replygood1=$val20
replytype2=default
replyname2=a0
replygood2=$val12
replytype3=default
replyname3=a
replygood3=$val12
replytype4=default
replyname4=b
replygood4=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la courbe 
!insmath C
$(), représentant la fonction 
!insmath f
$(),	définie sur 
!insmath \mathbb{R}
$() par la relation 
!insmath f(x)=$val9
$() et 
!insmath A($val10;$val11)
$() un point de 
!insmath C
$().	
!if $m_step=1 
$()	<div class="wimscenter">	On a 
!insmath f'(x)
$()=  
!read oef/embed.phtml reply 1 
$()	</div>	 
!endif
$()	
!if $m_step=2 
$()	<div>	En effet 
!insmath f'(x)=$val20
$(). Donner la valeur de 
!insmath f'($val10)
$(), qui correspond au coefficient directeur de la tangente à 
!insmath C
$() en 
!insmath A
$().	</div>	<div class="wimscenter">	On a : 
!insmath f'($val10)=
$()  
!read oef/embed.phtml reply 2,5 
$()	</div>	 
!endif
$()	
!if $m_step=3 
$()<div>	On a vu que 
!insmath f'(x)=$val20
$() et que 
!insmath f'($val10)=$val12
$() .	Quelle est l'équation de la tangente à 
!insmath C
$() en 
!insmath A
$() ?	</div>	<div class="wimscenter">	On a 
!insmath y=
$()  
!read oef/embed.phtml reply 3,5 
$() x +  
!read oef/embed.phtml reply 4, 5 
$()	</div>	 
!endif
$()		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,12,20
embedcnt=4
