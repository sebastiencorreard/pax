!set title=Dérivée d'une fonction polynôme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=functions, derivative
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val6*x^3+$val7*x^2+$val8*x+$val9
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val11=!rawmath $(tmp0)
replytype1=default
replyname1=der
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la fonction 
!insmath f
$(), définie sur 
!insmath \mathbb{R}
$() par	la relation 
!insmath f(x)=$val10
$(). Calculer 
!insmath f'(x)
$().	<div class="wimscenter">	On a 
!insmath f'(x)=
$()  
!read oef/embed.phtml reply 1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=1
