\title{Etude de fonction 1}
\keywords{roots,functions}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u0=random(-4..4)}
\integer{v0=random(-40..40)}
\if{\u0<\v0}{
\integer{u=\u0}
\integer{v=\v0}
}{
\integer{v=\u0}
\integer{u=\v0}
}
\integer{triche=random(1..5)}

\integer{k=random(-1,1)}
\function{fd=\k*(x-\u)*(x-\v)}
\function{f=maxima(6*integrate(\fd))}
\text{bornes=slib(function/bounds \f, x,-5,5)}
\integer{m=item(1,\bornes)}
\integer{M=item(2,\bornes)}
\integer{pert=randint(\m,\M)}
\if{\triche=1}{
\if{\k>0}{
\integer{pert=-evalue(\f,x=\u)}
}
\if{\k<0}{
\integer{pert=-evalue(\f,x=\v)}
}
}
\function{f=\f+\pert}
\if{\u=\v}{
\integer{nd=1}
}
{
\integer{nd=2}
}

\rational{fu=evalue(\f,x=\u)}
\rational{fv=evalue(\f,x=\v)}

\if{\fu>0}{\integer{\nu=0}}
\if{\fu=0}{\integer{\nu=1}}
\if{\fu<0}{\integer{\nu=2}}
\if{\fv>0}{\integer{\nv=0}}
\if{\fv=0}{\integer{\nv=1}}
\if{\fv<0}{\integer{\nv=2}}

\integer{d=\nu*3+\nv+1}

\if{\k>0}{
\text{pos=1,2,3,Imp,1,2,Imp,Imp,1}
}
\if{\k<0}{
\text{pos=1,Imp,Imp,2,1,Imp,3,2,1}
}

\integer{n=item(\d,\pos)}
\integer{al=random(1,2)}
\integer{al=1}
\if{\al=1}{
\text{txt=la fonction \(f)}
\integer{rep=\n}
}

\if{\al=2}{
\text{txt=la dérivée de la fonction \(f)}
\integer{rep=\nd}
}

\integer{ym=-10}
\integer{yM=10}
\integer{dy=1}
\integer{ny=(\yM-\ym)/\dy}

\statement{
On considère une fonction \(f), définie sur \(\mathbb{R}) par la
relation \(f(x)=\f). Construire le tableau de variations de la
fonction \(f) et
en déduire le nombre de solutions de l'équation \(f(x)=0).
<div class="spacer">
La fonction \(f) s'annule \embed{reply 1,10} fois sur \(\mathbb{R}).
</div>
}

\answer{Nombre}{type=default}{\rep}
