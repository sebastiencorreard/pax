\title{Dérivée d'une fonction polynôme}
\keywords{functions, derivative}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-5..5)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{d=random(-5..5)}
\function{f=maxima(\a*x^3+\b*x^2+\c*x+\d)}
\function{g=diff(\f,x)}
\statement{On considère la fonction \(f), définie sur \(\mathbb{R}) par
la relation \(f(x)=\f). Calculer \(f'(x)).
<div class="wimscenter">
On a \(f'(x)=) \embed{reply 1}
</div>}

\answer{der}{\g}{type=default}
