\title{Dérivée d'un polynôme}
\keywords{functions, derivative}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-2..2)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{d=random(-5..5)}

\real{t=(\a)^2+(\b)^2+(\c)^2+(\d)^2}
\if{\t=0}{
\integer{a=1}
}

\function{f=maxima(\a*x^3+\b*x^2+\c*x+\d)}
\function{g=diff(\f,x)}
\integer{al=random(1,2)}
\integer{xa=random(-3..3)}

\if{\al=1}{
\integer{ya=evalue(\f,x=\xa)}
}
\if{\al=2}{
\integer{ya=evalue(\g,x=\xa)}
}

\steps{
reply 1
reply 2
}

\statement{On considère la fonction \(f), définie pour \(x) réel par \(f(x)=\f).
\if{\step=1}{
<div class="wimscenter">
La fonction dérivée de la fonction \(f) est égale à \embed{reply 1}
</div>}
\if{\step=2 and \al=1}{
<div class="spacer">
Effectivement, on a \(f'(x)=\g).

<div class="wimscenter">
Le point de \(C_f) d'abscisse \(\xa) a pour ordonnée \embed{reply 2}.
</div>
}
\if{\step=2 and \al=2}{
<div class="spacer">
Effecitvement, on a \(f'(x)=\g).</div>
<div class="wimscenter">
La tangente à \(C_f) au point d'abscisse \(\xa) a pour coefficient directeur \embed{reply 2}.
</div>
}
}

\answer{Fonction dérivée}{\g}{type=algexp}
\answer{reponse 2}{\ya}{type=default}
