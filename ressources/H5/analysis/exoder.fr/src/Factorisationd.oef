\title{Factorisation d'un polynôme de degré 2}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{factorization}
\integer{u=random(-5..-1)}
\integer{v=random(1..5)}
\integer{a=random(-1,1)*random(1..3)}
\function{f=maxima(expand(\a*(x-\u)*(x-\v)))}
\function{fac=maxima(\a*(x-\u)*(x-\v))}

\text{vars=strictement croissante,strictement décroissante, ni croissante ni décroissante}
\steps{reply 1
reply 2
}

\statement{On considère la fonction \(f(x)=\f).
<div class="spacer">
\if{\step=1}{
Les solutions de l'équation \(\f=0) sont: \embed{reply 1}.
}
\if{\step=2}{
Le polynôme \(\f) s'écrit sous forme factorisée: \embed{reply 2}.
}
</div>
}

\answer{rac}{\u,\v}{type=fset}
\answer{fac}{\fac}{type=algexp}
