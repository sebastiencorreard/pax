\title{Equations du second degré}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..5)}
\integer{v=randint(1..5)^2}
\integer{eps=random(-1,-1,-1,1,0)}
\integer{k=random(-1,1)*randint(1..2)}

\function{f1=maxima(expand(\k*((x+\u)^2+\eps*\v)))}

\if{\eps<0}{
\rational{a=maxima(-\u-sqrt(\v))}
\rational{b=maxima(-\u+sqrt(\v))}
\matrix{solutions=\a,\b}
\integer{nombre=2}
\text{nombresol=2 solutions}
}

\if{\eps=0}{
\rational{a=maxima(-\u)}
\matrix{solutions=\a}
\integer{nombre=1}
\text{nombresol=1 solution}
}

\if{\eps>0}{
\integer{nombre=0}
}
\text{STEPS=\eps<=0?
reply 1
reply 2:
reply 1}
\steps{
\STEPS}

\statement{Résoudre l'équation du second degré:
<div class="wimscenter"> \(\f1 = 0) </div>
\if{\step=1}{<div class="wimscenter">
Combien cette équation possède-t-elle de solutions ? \embed{reply 1,5}
</div>
}
\if{\step=2}{<p>
Effectivement, cette équation possède \nombresol.</p>
<div class="wimscenter">
L'ensemble des solutions de cette équation est:
 \embed{reply 2,10}
</div>
<div class="wims_instruction">
<b>Remarque: </b> S'il y a plusieurs solutions, séparer par des virgules.
</div>
}

}

\answer{Nombre de solutions}{\nombre}{type=default}

\answer{Les solutions}{\solutions}{type=fset}

\hint{Essayez de vous ramener à une équation du type \(x^2+bx=c)}
