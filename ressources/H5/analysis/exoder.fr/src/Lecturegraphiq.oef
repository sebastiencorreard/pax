\title{Lecture graphique du nombre dérivé (signe)}
\keywords{functions, derivative, graphing}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{ a=random(-1,1)}
\integer{ b=randint(-2..2)}
\integer{ c=randint(-2..2)}

\function{ f=maxima(expand(\a*(x-\b)^2+\c))}

\integer{ xA=\b+random(-1,1)*random(1..2)}
\integer{ yA=evalue(\f,x=\xA)}
\integer{ m=evalue(diff(\f,x),x=\xA)}
\function{ eqd=maxima(expand(\m*(x-\xA)+\yA))}

\integer{ xm=\xA-5}
\integer{ xM=\xA+5}

\integer{ ym=\yA-5}
\integer{ yM=\yA+5}

\integer{ Ny=11}
\integer{ Nx=11}

\if{\m>0}{
\text{rep=\(f'(\xA)>0)}
}
\if{\m<0}{
\text{rep=\(f'(\xA)<0)}
}
\if{\m=0}{
\text{rep=\(f'(\xA)=0)}
}

\text{listrep=\(f'(\xA)>0),\(f'(\xA)<0),\(f'(\xA)=0),}
\statement{<div class="float_right">
\draw{200,200}{
animate 10,0.5,0
xrange \xm,\xM
yrange \ym,\yM
linewidth 1
parallel \xm,\ym,\xM,\ym,0,1,\Ny,green
parallel \xm,\ym,\xm,\yM,1,0,\Nx,green

linewidth 2
line \xm,0,\xM,0,blue
line 0,\ym,0,\yM,blue

arrow 0,0,1,0,10,blue
arrow 0,0,0,1,10,blue
plot red,\f
plot green,\eqd

text green,\xA+0.2,\yA,normal,A
}
</div>
On considère la courbe \(C), représentant la fonction
\(f) définie sur \(\mathbb{R}) par
<div class="wimscenter">
 \(f(x)=\f),
</div>
 ainsi que la droite \(d),
tangente à \(C) au point \(A(\xA;\yA)).
 La courbe \(C) et sa tangente \(d) sont représentées ci-dessous.
 Par lecture graphique, on peut affirmer que:
<div class="wimscenter">
 \embed{reply 1,100x30}
</div>
}
\answer{Nombre dérivé}{\rep;\listrep}{type=dragfill}
