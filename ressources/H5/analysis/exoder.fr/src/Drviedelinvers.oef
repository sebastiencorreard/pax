\title{Dérivée de l'inverse d'une fonction}
\keywords{functions, derivative}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*randint(1..5)}
\integer{b=random(-5..5)}
\integer{c=random(-1,1)*randint(1..5)}
\integer{d=random(-5..5)}

\function{f=maxima(\d+\a/(\c*x+\d))}
\function{g=diff(\f,x)}

\integer{t=-\a*\c}
\integer{var=\t>0?1:2}
\text{vars=strictement croissante,strictement décroissante}
\rational{m=-\d/\c}
\if{\al=1}{\text{I=&#93; \m; + \(\infty) &#91;}}
{\text{I=&#93; -\(\infty);\m &#91;}}

\steps{reply 1
reply 2
reply 3
}
\statement{On considère la fonction \(f) définie par la relation
\(f(x) = \f).
<div class="spacer">
\if{\step=1}{
Pour quelle valeur de \(x) la fonction \(f) n'est-elle pas définie ? \embed{reply 1} ?
}
\if{\step=2}{
La fonction dérivée de \(f) est \(f'(x)=) \embed{reply 2}.
}
\if{\step=3}{
Oui, on a bien \(f'(x)=\g).
<div>
Sur l'intervalle \I, on peut affirmer que la fonction \(f) est \embed{reply 3}.
</div>
}
</div>
}

\answer{Valeur interdite}{\m}{type=default}
\answer{Fonction dérivée}{\g}{type=default}
\answer{r}{\var;\vars}{type=menu}
