\integer{u=random(-5..-1)}
\integer{v=random(1..5)}
\integer{a=random(-1,1)}

\function{g=maxima(\a*(x-\u)/(x-\v))}

\integer{al=random(1..4)}
\if{\al=1}{
\text{a1=&#91;}
\integer{b1=\u-random(1..2)}
\integer{b2=random(\u..\v)}
\if{\b2=\u}{
\integer{b2=\u+1}
}
\text{a2=&#93;}
\integer{r=3}
}
\if{\al=2}{
\text{a1=&#91;}
\integer{b1=random(\u..0)}
\integer{b2=random(1..\v)}
\text{a2=&#91;}
\integer{r=\a>0?2:1}
}
\if{\al=3}{
\text{a1=&#93;}
\text{b1=\(-\infty)}
\integer{b2=random(-10..\u)}
\text{a2=&#93;}
\integer{r=\a>0?1:2}
}
\if{\al=4}{
\text{a1=&#93;}
\integer{b1=random(\v..10)}
\text{b2=\(+\infty)}
\text{a2=&#91;}
\integer{r=\a>0?1:2}
}
\if{\a>0}{
\text{f1=\nearrow}
\text{f2=\searrow}
\text{f3=\nearrow}
}
\if{\a<0}{
\text{f1=\searrow}
\text{f2=\nearrow}
\text{f3=\searrow}
}
\text{vars= positive,négative, de signe non constant}

\statement{On considère une fonction \(f), dont le tableau de variations est donné ci-dessous:
<table class="wimscenter wimsnoborder tab_var">
<tr>
<th>\(x)</th><td>\(-\infty)</td><td></td><td>\u</td><td></td><td>\v</td><td></td><td>+\infty</td>
</tr><tr>
<th>\(f(x))</th><td></td><td>\(\f1)</td><td></td><td>\(\f2)</td><td></td><td>\(\f3)</td><td></td>
</tr>
</table>
Sur l'intervalle \a1 \b1;\b2 \a2, la <b> dérivée </b> de la fonction \(f) est : \embed{reply 1}
}
\answer{Variations}{\r;\vars}{type=menu}
