\title{Variations d'un polynôme}
\keywords{functions, derivative, tangent, graphing}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..-1)}
\integer{v=random(1..5)}
\integer{a=random(-1,1)}
\function{f=maxima(expand(6*\a*(x-\u)*(x-\v)))}
\function{F=integrate(\f,x)}

\integer{al=random(1..4)}
\if{\al=1}{
\text{a1=&#91;}
\integer{b1=\u-random(1..2)}
\integer{b2=random(\u..\v)}
\text{a2=&#93;}
\integer{r=3}
}
\if{\al=2}{
\text{a1=&#91;}
\integer{b1=random(\u..0)}
\integer{b2=random(1..\v)}
\text{a2=&#93;}
\integer{r=\a>0?2:1}
}
\if{\al=3}{
\text{a1=&#93;}
\text{b1=\(-\infty)}
\integer{b2=random(-10..\u)}
\text{a2=&#93;}
\integer{r=\a>0?1:2}
}
\if{\al=4}{
\text{a1=&#91;}
\integer{b1=random(\v..10)}
\text{b2=\(+\infty)}
\text{a2=&#91;}
\integer{r=\a>0?1:2}
}

\text{vars=strictement croissante,sitrctement décroissante, ni croissante ni décroissante}
\steps{reply 1
reply 2
reply 3}


\text{ftex=texmath(\F)}

\statement{On considère la fonction \(f(x)=\ftex) 
\if{\step=1}{
<p>
Calculer la fonction dérivée de la fonction \(f). </p>
<div class="wimscenter">On a \(f'(x)=)\embed{reply 1}. </div>
}
\if{\step=2}{<p>
Pour quelles valeurs de \(x), la courbe \(C_f) admet-elle une tangente horizontale
au point d'abscisse \(x) ? </p>
<div class="wimscenter">\embed{reply 2}</div>
}
\if{\step=3}{
<p>
Sur l'intervalle \a1 \b1;\b2 \a2 la fonction \(f(x)=\F) est :</p>
<div class="wimscenter">\embed{reply 3}</div>
}
}

\answer{der}{\f}{type=default}
\answer{rac}{\u,\v}{type=fset}
