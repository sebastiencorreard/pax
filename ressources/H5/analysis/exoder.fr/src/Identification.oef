\title{Identification de coefficients}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-3..3)}
\integer{b=random(-3..3)}
\integer{c=random(-3..3)}
\integer{d=random(-3..3)}
\integer{al=random(1,4)}
\text{ques=item(\al,a,b,c,d)}
\integer{rep=item(\al,\a,\b,\c,\d)}

\function{f=maxima(\a*x^3+\b*x^2+\c*x+\d)}
\statement{Soit \(f(x)=\f).
L'expression \(f(x)) est de la forme \(f(x)=a x^3+b x^2+c x+d).
<div class="spacer">
Quelle est la valeur de \(\ques\) ? \embed{reply 1,5}.
</div>}

\answer{coeff}{\rep}{type=default}
