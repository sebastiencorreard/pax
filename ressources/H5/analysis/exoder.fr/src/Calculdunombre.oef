\title{Calcul du nombre dérivé}
\keywords{functions, derivative}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{ a=random(-1,1)*randint(1..4)}
\integer{ b=randint(-4..4)}
\integer{ c=randint(-4..4)}

\function{ f=maxima(expand(\a*(x-\b)^2+\c))}

\integer{ xA=\b+random(-1,1)*random(1..2)}
\integer{ yA=evalue(\f,x=\xA)}
\integer{ m=evalue(diff(\f,x),x=\xA)}
\function{ eqd=maxima(expand(\m*(x-\xA)+\yA))}

\integer{ xm=\xA-5}
\integer{ xM=\xA+5}

\integer{ ym=\yA-5}
\integer{ yM=\yA+5}

\integer{ Ny=11}
\integer{ Nx=11}

\function{g=diff(\f,x)}
\integer{bm=\yA-\m*\xA}

\steps{
reply 1
reply 2
reply 3, reply 4
}
\statement{On considère la courbe \(C), représentant la fonction \(f),
définie sur \(\mathbb{R}) par la relation \(f(x)=\f) et \(A(\xA;\yA)) un point de \(C).
\if{\step=1}
{
<div class="wimscenter">
On a \(f'(x))= \embed{reply 1}
</div>
}
\if{\step=2}{
<div>
En effet \(f'(x)=\g). Donner la valeur de \(f'(\xA)), qui correspond au coefficient directeur de la tangente à \(C) en \(A).
</div>
<div class="wimscenter">
On a : \(f'(\xA)=) \embed{reply 2,5}
</div>
}
\if{\step=3}
{<div>
On a vu que \(f'(x)=\g) et que \(f'(\xA)=\m) .
Quelle est l'équation de la tangente à \(C) en \(A) ?
</div>
<div class="wimscenter">
On a \(y=) \embed{reply 3,5} x + \embed{reply 4, 5}
</div>
}

}

\answer{Dérivé}{\g}{type=default}
\answer{a0}{\m}{type=default}
\answer{a}{\m}{type=default}

\answer{b}{\bm}{type=default}
