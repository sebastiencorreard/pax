\title{Lien entre variation et signe de la dérivée 3}
\keywords{functions, derivative, function_variation}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..-1)}
\integer{v=random(1..5)}
\integer{a=random(-1,1)}

\integer{k=random(1..4)}

\function{g=maxima(expand(\k*\a*(1+(\v-\u)/(x-\v))))}

\integer{al=random(1..4)}
\if{\al=1}{
\text{a1=&#91;}
\integer{b1=\u-random(1..2)}
\integer{b2=random(\u..\v)}
\text{a2=&#93;}
\integer{r=3}
}
\if{\al=2}{
\text{a1=&#91;}
\integer{b1=random(\u..0)}
\integer{b2=random(1..\v)}
\text{a2=&#91;}
\integer{r=\a>0?2:1}
}
\if{\al=3}{
\text{a1=&#93;}
\text{b1=\(-\infty)}
\integer{b2=random(-10..\u)}
\text{a2=&#93;}
\integer{r=\a>0?1:2}
}
\if{\al=4}{
\text{a1=&#93;}
\integer{b1=random(\v..10)}
\text{b2=\(+\infty)}
\text{a2=&#91;}
\integer{r=\a>0?1:2}
}

\text{vars=strictement croissante,strictement décroissante, ni croissante ni décroissante}

\statement{On considère une fonction \(f), dont la <b>dérivée </b> \(f') est définie
par la relation \(f'(x)=\g).
<div class="wimscenter">
Sur l'intervalle \a1 \b1;\b2 \a2 la fonction \(f) est : \embed{reply 1}
</div>
}

\answer{Variations}{\r;\vars}{type=menu}
