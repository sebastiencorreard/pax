!set title=Quelle est l'équation ?
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint((-1)*$(tmp0))]
tmp0=!randint 1, 3

val7=$[rint((-1)*$(tmp0))]
tmp0=!randint 1, 2

tmp1=!randint 1, 9

tmp2=!randint 0, 1

val8=$[(-1)^$(tmp0)*$(tmp1)/10+$(tmp2)]
val9=$[3*($val8)^2+2*($val6)*($val8)+($val7)]
val10=((x)^3+($val6)*(x)^2+($val7)*(x)+1)
tmp0=!evalsubst x=$val8 in $val10

val11=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
val12=$[$val11-($val9)*($val8)]
tmp=!translate ";': to $     $ in $val9*x+($val12)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=$(tmp0)
val13=y=$val13
val14=xrange -5,5	yrange -5,5	linewidth 1	arrow -5,0,5,0,20,black	arrow 0,-5,0,5,20,black	text black,0,0,small,0	text black,0,1,small,1	text black,1,0,small,1	text blue,$val8+0.1,-0.2,medium,$val8	parallel -5,-0.1,-5,0.1,1,0,10,black	parallel -0.1,-5,0.1,-5,0,1,10,black	plot red,$val9*x+($val12)	dsegment $val8,0,$val8,$val11+,blue	plot blue,x^3+$val6*x^2+$val7*x+1
replytype1=equation
replyname1=
replygood1=!rawmath $val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right"> 
!read oef/draw.phtml 301,301 \
$val14 
$()</div>	Voici la courbe de la fonction définie par 
!insmath f(x)=$val10
$().	<p>La tangente au point d'abscisse $val8 est dessinée.</p>	On donne de plus l'information suivante :	<div class="wimscenter">
!insmath f'($val8)=$val9
$()</div>	<div class="spacer">Quelle est l'équation de la tangente tracée ?</div>	<div class="wimscenter">L'équation de la tangente est  
!read oef/embed.phtml r1 
$().</div>	<div class="wims_instruction">Donner les valeurs exactes des coefficients.</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval y notin $m_reply1
 <div class='oef_feedbacks'>	Attention : l'équation d'une tangente commence par "y=...".	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=8,9,10,14
embedcnt=1
