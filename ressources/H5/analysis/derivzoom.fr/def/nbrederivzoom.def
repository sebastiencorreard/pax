!set title=Nombre dérivé avec un zoom.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint((-1)*$(tmp0))]
tmp0=!randint 1, 3

val7=$[rint((-1)*$(tmp0))]
tmp0=!randint 1, 2

tmp1=!randint 1, 9

tmp2=!randint 0, 1

val8=$[(-1)^$(tmp0)*$(tmp1)/10+$(tmp2)]
val9=$[$val8+0.005]
val10=(x)^3+($val6)*(x)^2+($val7)*(x)+1
tmp0=!evalsubst x=$val8 in $val10

val11=$[$(tmp0)]
tmp0=!evalsubst x=$val9 in $val10

val12=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
val13=$[rint(($val12-$val11)/($val9-$val8)*10)]
val13=$[$val13/10]
val14=$[$val11-($val13)*($val8)]
tmp=!translate ";': to $     $ in $val13*x+($val14)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
val15=y=$val15
!readproc slib/geo2D/jsxgraph jsxbox,	300 x 300,	var brd = JXG.JSXGraph.initBoard('jsxbox', {boundingbox:[$val8-5,$val11+5,$val8+5,$val11-5], axis:true, grid:true});	p1 = brd.create('functiongraph',[function(x){ return x*x*x+($val6)*x*x+($val7)*x+1;}, -10,10] );	p2 = brd.create('point', [$val8,$val11],{face:'x',size:2,fixed:true,infoboxDigits:5});	p3 = brd.create('point', [$val9,$val12],{face:'x',size:2,fixed:true,infoboxDigits:5}); 
tmp0=$slib_out
val16=$(tmp0)

!ifval $val13<0 
val17=descend 
!else
val17= monte
!endif

!ifval $val13<0 
val18=négatif
!else
val18= positif
!endif
replytype1=numeric
replyoption1=absolute 
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_right">$val16</div>	Voici la courbe d'une fonction 
!insmath f
$().	<br>Le point A d'abscisse $val8 est dessiné en rouge.	Vous pouvez zoomer sur la courbe (bouton <span class="tt">+</span> en bas de l'image) et	voir qu'elle porte deux points A et B très proches l'un de l'autre.	<br>Les coordonnées de ces deux points sont visibles si on clique sur eux.	<p>Quel est le nombre dérivé de la fonction en 
!insmath x=$val8
$()?</p>	<div class="wimscenter">Le nombre dérivé est  
!read oef/embed.phtml r1 
$().</div>	<div class="wims_instruction">Donner une valeur arrondie au dixième.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Comme après avoir zoomé fortement la courbe est "presque" une droite,	on peut utiliser (de façon approchée) la formule pour le coefficient directeur des droites :	
!insmath m=(y_B-y_A)/(x_B-x_A)
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply1*$val13<0
 <div class='oef_feedbacks'>Ici, la courbe "$val17" au voisinage du point A : le nombre dérivé	devait donc forcément être $val18 ! 
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=8,13,16,17,18
embedcnt=1
