:solution
$()
!insmath f'(t) = $val17
$() et 
!insmath g'(t)=$val21
$(). Ainsi, le tableau de variations de f et g est :	
!if $val14=$val18 
$()	<table class="wimscenter wimsborder mytabvar">	<tr>	<th> 
!insmath t
$()</th><td>
!insmath $val22
$()</td><td></td><td>$val14</td><td></td><td>
!insmath $val23
$()</td>	</tr><tr>	<th>
!insmath f'(t)
$()</th><td></td><td> $(val43[1]) </td><td>$val33</td><td> $(val43[2])</td><td></td>	</tr><tr>	<th>
!insmath f(t)
$()</th><td> $val31 </td><td> $(val44[1]) </td><td> $val32 </td><td> $(val44[2])</td><td> $val36 </td>	</tr>	<tr>	<th>
!insmath g'(t)
$()</th><td></td><td> $(val45[1]) </td><td>$val39</td><td> $(val45[2])</td><td></td>	</tr><tr>	<th>
!insmath g(t)
$()</th><td> $val37 </td><td> $(val46[1]) </td><td> $val38</td><td> $(val46[2])</td><td> $val42 </td>	</tr>	</table> 
!else
$() 	<table class="wimscenter wimsborder mytabvar">	<tr>	<th> 
!insmath t
$()</th><td>
!insmath $val22
$()</td><td></td><td>$val14</td><td></td><td>$val18</td><td></td><td>
!insmath $val23
$()</td>	</tr><tr>	<th>
!insmath f'(t)
$()</th><td></td><td> $(val43[1]) </td><td>$val33</td><td> $(val43[2])</td><td>$val35</td><td> $(val43[3])</td><td></td>	</tr>	<tr>	<th>
!insmath f(t)
$()</th><td> $val31 </td><td> $(val44[1]) </td><td> $val32</td><td> $(val44[2])</td><td> $val34</td><td> $(val44[3])</td><td> $val36 </td>	</tr><tr>	<th>
!insmath g'(t)
$()</th><td></td><td> $(val45[1]) </td><td>$val39</td><td> $(val45[2])</td><td>$val41</td><td> $(val45[3])</td><td></td>	</tr><tr>	<th>
!insmath g(t)
$()</th><td> $val37 </td><td> $(val46[1])</td><td> $val38</td><td> $(val46[2])</td><td> $val40</td><td> $(val46[3])</td><td> $val42 </td>	</tr>	</table>	 
!endif
$()
$()
!exit

