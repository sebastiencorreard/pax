\title{Tableau de variations d'une courbe paramétrée}
\language{fr}
\range{-5..5}
\author{Solène, Charneau; Eric, Reyssat}
\email{solene.charneau@gmail.com}
\computeanswer{no}
\format{html}
\precision{100}
\css{<style type="text/css">
.mytabvar {
border-collapse:collapse;
}
.mytabvar th{
font-family:monospace;
padding:5px;
text-align : left;
}
</style>
}
\integer{a = randitem(-1,1)*random(1..4)}
\integer{b = random(-6..6)}
\integer{c = random(-10..10)}
\integer{a2 = randitem(-1,1)*random(1..4)}
\integer{b2 = random(-6..6)}
\integer{c2 = random(-10..10)}
\integer{pct=15} taille des cases des fleches dans le second cas
\integer{pct2=10} taille des cases des nombres dans le second cas

\rational{zero=-\b/(2*\a)}
\function{f=pari(\a *t^2 + \b*t + \c)}
\text{ft=texmath(\f)}
\function{d=diff(\f,t)}

\rational{zero2=-\b2/(2*\a2)}
\function{f2=pari(\a2 *t^2 + \b2*t + \c2)}
\text{ft2=texmath(\f2)}
\function{d2=diff(\f2,t)}

\integer{inf=random(-10..\zero - 1)}
\integer{sup=random(\zero + 1..10)}
\integer{inf2=random(-10..\zero2 - 1)}
\integer{sup2=random(\zero2 + 1..10)}
\integer{inf=min(\inf,\inf2)}
\integer{sup=max(\sup,\sup2)}
%est-ce qu'on peut faire un exemple ou un des zeros est en dehors des bornes ?
\text{signes= + , - }
\text{variations = \(\nearrow),\(\searrow)}
***par colonnes : 1 pour croissant, 2 pour décroisant

\if{\zero<\zero2}{
\text{cc=\a>0?2,1,1:1,2,2}
\text{cc2=\a2>0?2,2,1:1,1,2}
}{ \if{\zero>\zero2}{
\rational{zerog=\zero}
\rational{zero=\zero2}
\rational{zero2=\zerog}
\text{cc=\a>0?2,2,1:1,1,2}
\text{cc2=\a2>0?2,1,1:1,2,2}
}{
\text{cc=\a>0?2,1:1,2}
\text{cc2=\a2>0?2,1:1,2}
}
}

\integer{fi=evalue(\f,t=\inf)}
\rational{fz=evalue(\f,t=\zero)}
\rational{fpz=evalue(\d,t=\zero)}
\rational{fz2=evalue(\f,t=\zero2)}
\rational{fpz2=evalue(\d,t=\zero2)}
\integer{fs=evalue(\f,t=\sup)}


\integer{f2i=evalue(\f2,t=\inf)}
\rational{f2z=evalue(\f2,t=\zero)}
\rational{f2pz=evalue(\d2,t=\zero)}
\rational{f2z2=evalue(\f2,t=\zero2)}
\rational{f2pz2=evalue(\d2,t=\zero2)}
\integer{f2s=evalue(\f2,t=\sup)}

\text{s=\signes[\cc]}
\text{v=\variations[\cc]}

\text{s2=\signes[\cc2]}
\text{v2=\variations[\cc2]}

\integer{nbr=\zero=\zero2?19:28}
\text{lr=wims (makelist r x for x=1 to \nbr)}
\steps{\lr}


\statement{
Pour étudier une courbe paramétrée, on est amené à étudier deux fonctions
\(f) et \(g) qui représentent l'abscisse et l'ordonnée des points de cette courbe.
<br>

Calculer les dérivées puis construire le tableau de variations des fonctions \(f)
et \(g) définies sur \(\lbrack\inf ; \sup\rbrack) par
<div class="wimscenter">\(f(t) = \ft) et \(g(t) = \ft2) . </div>
<br>
On demande les valeurs <strong>exactes</strong> de \(t), de \(f(t))
et de \(g(t)) (pour les fractions, utiliser /).
<div class="wimscenter">\(f'(t) = ) \embed{reply1}</div>
<div class="wimscenter">\(g'(t) = ) \embed{reply2}</div>

\if{\zero=\zero2}{
<table class="wimscenter wimsborder mytabvar">
<tr>
<th> \(t)</th><td>\(\inf)</td><td></td><td>\embed{reply3,5}</td><td></td><td>\(\sup)</td>
</tr><tr>
<th>\(f'(t))</th><td></td><td> \embed{reply4} </td><td>\embed{reply9,5}</td><td> \embed{reply5}</td><td></td>
</tr><tr>
<th>\(f(t))</th><td> \embed{reply10,5} </td><td> \embed{reply6} </td><td> \embed{reply8,5}</td><td> \embed{reply7}</td><td> \embed{reply11,5} </td>
</tr><tr>
<th>\(g'(t))</th><td></td><td> \embed{reply12} </td><td>\embed{reply17,5}</td><td> \embed{reply13}</td><td></td>
</tr><tr>
<th>\(g(t))</th><td> \embed{reply18,5} </td><td> \embed{reply14} </td><td> \embed{reply16,5}</td><td> \embed{reply15}</td><td> \embed{reply19,5} </td>
</tr>
</table>}{
<table class="wimscenter wimsborder mytabvar">
<tr>
<th> \(t)</th><td>\(\inf)</td><td></td><td>\embed{reply3,5}</td><td></td><td>\embed{reply20,5}</td><td></td><td>\(\sup)</td>
</tr><tr>
<th>\(f'(t))</th><td></td><td> \embed{reply4} </td><td>\embed{reply9,5}</td><td> \embed{reply5}</td><td>\embed{reply24,5}</td><td> \embed{reply21}</td><td></td>
</tr><tr>
<th>\(f(t))</th><td> \embed{reply10,5} </td><td> \embed{reply6} </td><td> \embed{reply8,5}</td><td> \embed{reply7}</td><td> \embed{reply23,5}</td><td> \embed{reply22}</td><td> \embed{reply11,5} </td>
</tr><tr>
<th> \(g'(t))</th><td></td><td> \embed{reply12} </td><td>\embed{reply17,5}</td><td> \embed{reply13}</td><td>\embed{reply28,5}</td><td> \embed{reply25}</td><td></td>
</tr><tr>
<th>\(g(t))</th><td> \embed{reply18,5} </td><td> \embed{reply14} </td><td> \embed{reply16,5}</td><td> \embed{reply15}</td><td> \embed{reply27,5}</td><td> \embed{reply26}</td><td> \embed{reply19,5} </td>
</tr>
</table>
}
}

\answer{}{\d}{type=formal}
\answer{}{\d2}{type=formal}
\answer{}{\zero}{type=numexp}
\answer{}{\s[1] }{type=clickfill}{option = shuffle}
\answer{}{\s[2] }{type=clickfill}{option = shuffle}
\answer{}{\v[1] }{type=clickfill}{option = shuffle}
\answer{}{\v[2] }{type=clickfill}{option = shuffle}
\answer{}{\fz}{type=numexp}
\answer{}{\fpz}{type=numexp}
\answer{}{\fi}{type=numexp}
\answer{}{\fs}{type=numexp}
\answer{}{\s2[1] }{type=clickfill}{option = shuffle}
\answer{}{\s2[2] }{type=clickfill}{option = shuffle}
\answer{}{\v2[1] }{type=clickfill}{option = shuffle}
\answer{}{\v2[2] }{type=clickfill}{option = shuffle}
\answer{}{\f2z}{type=numexp}
\answer{}{\f2pz}{type=numexp}
\answer{}{\f2i}{type=numexp}
\answer{}{\f2s}{type=numexp}
\answer{}{\zero2}{type=numexp}
\answer{}{\s[3] }{type=clickfill}{option = shuffle}
\answer{}{\v[3] }{type=clickfill}{option = shuffle}
\answer{}{\fz2}{type=numexp}
\answer{}{\fpz2}{type=numexp}
\answer{}{\s2[3] }{type=clickfill}{option = shuffle}
\answer{}{\v2[3] }{type=clickfill}{option = shuffle}
\answer{}{\f2z2}{type=numexp}
\answer{}{\f2pz2}{type=numexp}

\text{err1 = vous prétendez qu'en un même point la dérivée \(f') est négative
et que la fonction \(f) est croissante.}
\text{err2 = vous prétendez qu'en un même point la dérivée \(f') est positive et
que la fonction \(f) est décroissante.}
\text{err3 = vous prétendez qu'en un même point la dérivée \(g') est négative et
que la fonction \(g) est croissante.}
\text{err4 = vous prétendez qu'en un même point la dérivée \(g') est positive et
que la fonction \(g) est décroissante.}

\feedback{\reply4 isitemof \variations or \reply5 isitemof \variations or \reply21 isitemof \variations}{Pour obtenir les variations de \(f), on indique le SIGNE de la dérivée \(f'(t)).}
\feedback{\reply12 isitemof \variations or \reply13 isitemof \variations or \reply25 isitemof \variations}{Pour obtenir les variations de \(g), on indique le SIGNE de la dérivée \(g'(t)).}
\feedback{\reply6 isitemof \signes or \reply7 isitemof \signes or \reply22 isitemof \signes}{Ce sont les VARIATIONS de la fonction \(f(t)) qu'on cherche, et pas son signe.}
\feedback{\reply14 isitemof \signes or \reply15 isitemof \signes or \reply26 isitemof \signes}{Ce sont les VARIATIONS de la fonction \(g(t)) qu'on cherche, et pas son signe.}
\feedback{(\reply4 isitemof - and \reply6 isitemof \(\nearrow)) or (\reply5 isitemof - and \reply7 isitemof \(\nearrow)) or (\reply21 isitemof - and \reply22 isitemof \(\nearrow))}{Incohérence dans le tableau : \err1}
\feedback{(\reply4 isitemof + and \reply6 isitemof \(\searrow)) or (\reply5 isitemof + and \reply7 isitemof \(\searrow)) or (\reply21 isitemof + and \reply22 isitemof \(\searrow))}{Incohérence dans le tableau : \err2}
\feedback{(\reply12 isitemof - and \reply14 isitemof \(\nearrow)) or (\reply13 isitemof - and \reply15 isitemof \(\nearrow)) or (\reply25 isitemof - and \reply26 isitemof \(\nearrow))}{Incohérence dans le tableau : \err3}
\feedback{(\reply12 isitemof + and \reply14 isitemof \(\searrow)) or (\reply13 isitemof + and \reply15 isitemof \(\searrow)) or (\reply25 isitemof + and \reply26 isitemof \(\searrow))}{Incohérence dans le tableau : \err4}



\solution{\(f'(t) = \d) et \(g'(t)=\d2). Ainsi, le tableau de variations de f et g est :
\if{\zero=\zero2}{
<table class="wimscenter wimsborder mytabvar">
<tr>
<th> \(t)</th><td>\(\inf)</td><td></td><td>\zero</td><td></td><td>\(\sup)</td>
</tr><tr>
<th>\(f'(t))</th><td></td><td> \s[1] </td><td>\fpz</td><td> \s[2]</td><td></td>
</tr><tr>
<th>\(f(t))</th><td> \fi </td><td> \v[1] </td><td> \fz </td><td> \v[2]</td><td> \fs </td>
</tr>
<tr>
<th>\(g'(t))</th><td></td><td> \s2[1] </td><td>\f2pz</td><td> \s2[2]</td><td></td>
</tr><tr>
<th>\(g(t))</th><td> \f2i </td><td> \v2[1] </td><td> \f2z</td><td> \v2[2]</td><td> \f2s </td>
</tr>
</table>}{
<table class="wimscenter wimsborder mytabvar">
<tr>
<th> \(t)</th><td>\(\inf)</td><td></td><td>\zero</td><td></td><td>\zero2</td><td></td><td>\(\sup)</td>
</tr><tr>
<th>\(f'(t))</th><td></td><td> \s[1] </td><td>\fpz</td><td> \s[2]</td><td>\fpz2</td><td> \s[3]</td><td></td>
</tr>
<tr>
<th>\(f(t))</th><td> \fi </td><td> \v[1] </td><td> \fz</td><td> \v[2]</td><td> \fz2</td><td> \v[3]</td><td> \fs </td>
</tr><tr>
<th>\(g'(t))</th><td></td><td> \s2[1] </td><td>\f2pz</td><td> \s2[2]</td><td>\f2pz2</td><td> \s2[3]</td><td></td>
</tr><tr>
<th>\(g(t))</th><td> \f2i </td><td> \v2[1]</td><td> \f2z</td><td> \v2[2]</td><td> \f2z2</td><td> \v2[3]</td><td> \f2s </td>
</tr>
</table>
}}
