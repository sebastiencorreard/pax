}

\answer{variation de g }{\c_g;\choix1}{type=menu}

\answer{abscisse de disc pour gof }{\x0}
\answer{limite en -\(\infty) }{\gofx0}
\answer{monotonie 1 }{\v[1];\variations }{type=clickfill}{option = shuffle}
\answer{limite à gauche de disc }{\signeborne_gof[1] }{type=clickfill}{option = shuffle}
\answer{limite à droite de disc }{\signeborne_gof[2] }{type=clickfill}{option = shuffle}
\answer{monotonie 2}{\v[2] }{type=clickfill}{option = shuffle}
\answer{limite en +\(\infty)}{\gofx0}

\answer{abscisse du sommet pour fog }{\x1}
\answer{limite en -\(\infty) }{\fx0}
\answer{monotonie 1 }{\v2[1] }{type=clickfill}{option = shuffle}
\answer{limite à gauche de disc }{\signeborne_gof[1] }{type=clickfill}{option = shuffle}
\answer{limite à droite de disc }{\signeborne_gof[2] }{type=clickfill}{option = shuffle}
\answer{monotonie 2}{\v2[2] }{type=clickfill}{option = shuffle}
\answer{limite en +\(\infty)}{\fx0}



\hint{La composée de deux fonctions monotones
<ul>
<li> de même sens de variation est croissante </li>
<li> de sens de variations opposés est décroissante </li>
</ul>}

\text{err1=La fonction \(g) est croissante, donc \(f) et \(g \circ f) ont les mêmes variations, seules les asymptotes changent.}
\text{err2=La fonction \(g) est décroissante, donc \(f) et \(g \circ f) ont des variations opposées.}
\text{err_sens=\c2>0?\err1:\err2}

\text{err2_1=La fonction \(g) est croissante, donc \(f) et \(f \circ g) ont les mêmes variations,
 seules les asymptotes changent.}
\text{err2=La fonction \(g) est décroissante, donc \(f) et \(f \circ g) ont des
variations opposées.}
\text{err2_sens=\c2>0?\err2_1:\err2_2}

\feedback{\reply1 notsametext \choix1[\c_g]}{[1]: Une fonction affine est
croissante si son coefficient directeur est positif,
 sinon elle est décroissante}

\feedback{\reply2 notsametext  \x0}{[2]: Dans la composée \(g \circ f),
 la fonction affine \(g) a une influence "verticale":
 <ul>
<li> Dilatation verticale de coefficient \c2 </li>
<li> Translation de vecteur \(\c1\vec{j})  </li>
</ul>
L'asymptote verticale du sommet ne varie donc pas!}

\feedback{\reply3 notsametext \gofx0}{[3]: Pour l'asymptote horizontale de \(g \circ f),
il faut calculer \(g(\fx0))}

\feedback{(\reply4 notsametext \v[1]) or (\reply7 notsametext \v[2])}{[4,7]:\err_sens}

\feedback{(\reply11 notsametext \v2[1]) or (\reply14 notsametext \v2[2])}{[7,8]:\err2_sens}

\feedback{\reply9 notsametext \x1}{[9]: Pour calculer l'asymptote verticale de \(f \circ g),
il faut résoudre \(g(x)=\x0)}

\feedback{\reply10 notsametext  \fx0}{[10]: Dans la composée \(f \circ g),
 la fonction affine \(g) a une influence "horizontale":
 <ul>
<li> Dilatation horizontale de coefficient \c2 </li>
<li> Translation de vecteur \(\cc1\vec{i})  </li>
</ul>
L'asymptote horizontale ne varie donc pas!}
