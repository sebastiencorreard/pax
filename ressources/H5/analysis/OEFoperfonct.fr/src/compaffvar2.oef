<td style="width:15%"></td>
<td style="width:10%"></td>
<td style="width:10%">\embed{reply2,5}</td>
<td style="width:10%"></td>
<td style="width:15%"></td>
<td style="width:10%;text-align:right">+\(\infty)</td>
</tr><tr style="border: solid black 1px;">
<th style="width:10%;border-right: solid black 1px;">\(g\circ f(x))</th>
<td style="width:10%"> \embed{reply3,5} </td>
