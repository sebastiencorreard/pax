\title  {Variation d'une composée affine 2}
\author {Régine, Mangeard}
 a partir d'un exo de Véronique Royer
\email  {regine@mangeard.fr}
\format {html}

\integer{a1=random(1..3)*random(1,-1)}
\integer{a2=random(1..3)}
\integer{numc1=randint(1..10)*random(1,-1)}
\integer{denc1=randitem(1,2,3,5)}
\rational{c1=(\numc1)/(\denc1)}
\integer{numc2=randint(1..10)*random(1,-1)}
\integer{denc2=randint(1,2,3,5)}
\rational{c2=(\numc2)/(\denc2)}
\integer{numc3=randint(1..10)*random(1,-1)}
\integer{denc3=randitem(1,2,3,5)}
\rational{c3=(\numc3)/(\denc3)}

\text{flist=(\c1)/(x+\c3)+\c2,
(\c1)/x+\c3,
(\c1)/(\a2*x+(\a1))}

\integer{\cas=random(1..3)}
\function{f=item(\cas,\flist)}


\function{g=\c2*x+(\c1)}
\function{recg=(x-(\c1))/(\c2)}
\text{tc2=\c2}
\text{tc2=wims(replace internal / by , in \tc2)}
\text{tc2=items(\tc2)=1?\tc2[1]:\frac{\tc2[1]}{\tc2[2]}}
\text{tc2=\tc2=1? :\tc2}
\text{tc2=\tc2=-1?-:\tc2}
\if{\c1>0}
 {\text{\signtc1=+}
  \text{tc1=\c1}
 }
 {\text{\signtc1=-}
  \rational{\mc1=\c1*(-1)}
  \text{tc1=\mc1}
 }
\text{tc1=wims(replace internal / by , in \tc1)}
\text{tc1=items(\tc1)=1?\tc1[1]:\frac{\tc1[1]}{\tc1[2]}}
\text{dispg=\tc2 x \signtc1 \tc1}
\function{F=diff(\f,x)}

\rational{x0=\cas==1?-(\c3) }
\rational{x0=\cas==2?0 }
\rational{x0=\cas==3?-(\a1/\a2) }

\rational{x1=evaluate(\recg,x=\x0)}
\rational{fx0=\cas==1?(\c2)}
\rational{fx0=\cas==2?(\c3)}
\rational{fx0=\cas==3?0}
\rational{gofx0=evaluate(\g,x=\fx0)}
rational{fogx1=evaluate(\f,x=evaluate(\g,x=\x1))}

\text{choix1=croissante,décroissante}
\text{variations = \(\nearrow),\(\searrow)}
\text{c_comp=\c1*\c2>0?2,2:1,1}
\text{v=\variations[\c_comp]}
\text{v2=\variations[\c_comp]}
\text{c_f=\c1>0?2,2:1,1}
\text{monotone=\variations[\c_f]}
\text{c_g=\c2>0?1:2}
\integer{cc1=-1*\c1}

\text{signes=\(-\infty),\(+\infty)}
\text{s_f=\c1>0?1,2:2,1}
\text{signeborne_f=\signes[\s_f]}
\text{s_comp=\c1*\c2>0?1,2:2,1}
\text{signeborne_gof=\signes[\s_comp]}



\statement{
Soit \(g) la fonction affine définie par \(g(x)=\dispg\)
 et \(f) une fonction définie sur \(\,\RR\) dont le tableau des variations est donné ci-dessous

<table class="wimscenter wimsnoborder" style="border: solid black 1px;">
<tr style="border: solid black 1px;">
<td style="width:10%"> \(x)</td>
