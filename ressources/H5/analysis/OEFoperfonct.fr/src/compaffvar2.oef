<td style="width:10%"> \embed{reply8,5} </td>
</tr>
</table>
</li>
<li><p>
Compléter le tableau des variations de la fonction \(f\circ g).
</p>

<table class="wimscenter wimsnoborder" style="border: solid black 1px;">
<tr style="border:solid black 1px;">
<th style="width:10%;border-right: solid black 1px;"> \(x)</th>
<td style="width:10%;text-align:left">-\(\infty)</td>
<td style="width:15%"></td>
<td style="width:10%"></td>
<td style="width:10%">\embed{reply9,5}</td>
<td style="width:10%"></td>
