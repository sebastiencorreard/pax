\title	{Variation d'une composée affine}
\author{Régine, Mangeard}
 a partir d'un exo de Véronique Royer
\email	{regine@mangeard.fr}
\format	{html}

\integer{a1=random(1..3)*random(1,-1)}
\integer{a2=random(1..3)*random(1,-1)}
\rational{c1=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c2=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c3=randint(1..10)*random(1,-1)/randint(1,2,3,5)}


\text{flist=\c1*(x+\c3)^2+\c2,
\c1*x^2+\c3,
\c1*(\a2*x+\a1)^2}

\integer{\cas=random(1..3)}
\function{f=item(\cas,\flist)}


\function{g=\c2*x+\c1}
\function{recg=(x-\c1)/(\c2)}
\text{tc2=\c2}
\text{tc2=wims(replace internal / by , in \tc2)}
\text{tc2=items(\tc2)=1?\tc2[1]:\frac{\tc2[1]}{\tc2[2]}}
\text{tc2=\tc2=1? :\tc2}
\text{tc2=\tc2=-1?-:\tc2}
\if{\c1>0}
 {\text{\signtc1=+}
  \text{tc1=\c1}
 }
 {\text{\signtc1=-}
  \rational{\mc1=\c1*(-1)}
  \text{tc1=\mc1}
 }
\text{tc1=wims(replace internal / by , in \tc1)}
\text{tc1=items(\tc1)=1?\tc1[1]:\frac{\tc1[1]}{\tc1[2]}}
\text{dispg=\tc2 x \signtc1 \tc1}

\function{F=diff(\f,x)}

\rational{x0=\cas==1?-(\c3) }
\rational{x0=\cas==2?0 }
\rational{x0=\cas==3?-(\a1/\a2) }

\rational{x1=evaluate(\recg,x=\x0)}
\rational{fx0=evaluate(\f,x=\x0)}
\rational{gofx0=evaluate(\g,x=evaluate(\f,x=\x0))}
\rational{fogx1=evaluate(\f,x=evaluate(\g,x=\x1))}

\text{choix1=croissante,décroissante}
\text{variations = \(\nearrow),\(\searrow)}
\text{c_comp=\c1*\c2>0?2,1:1,2}
\text{c_comp2=\c1*\c2<0?2,1:1,2}
\text{v=\variations[\c_comp]}
\text{c_f=\c1>0?2,1:1,2}
\text{v2=\variations[\c_f]}
\text{monotone=\variations[\c_f]}
\text{c_g=\c2>0?1:2}
\integer{cc1=-1*\c1}

\statement{
<p>
Soit \(g) la fonction affine définie par \(g(x)=\dispg)
 et \(f) une fonction définie sur \(\,\RR\) dont le tableau des variations est donné ci-dessous.
</p>
<table class="wimscenter wimsnoborder" style="border:solid black 1px;">
<tr style="border:solid black 1px;">
<td style="border-right: solid black 1px;width:10%"> \(x)</td>
<td style="width:30%;text-align:left">-\(\infty)</td><td style="width:10%">\x0</td>
<td style="width:30%;text-align:right">+\(\infty)</td>
</tr><tr style="border:solid black 1px;">
<td style="border-right:solid black 1px;width:10%">\(f(x))</td>
<td style="width:30%"> \monotone[1]
</td><td style="width:10%"> \fx0 </td><td style="width:30%"> \monotone[2] </td>
</tr>
</table>
<ol>
<li>
Quel est le sens de variation de la fonction \(g) sur \(\,\RR\): \embed{reply1}
</li>
<li><p>
Compléter le tableau des variations de la fonction \(g\circ f).
</p>
<table class="wimscenter wimsnoborder" style="border:solid black 1px;">
<tr style="border:solid black 1px;">
<th style="border-right: solid black 1px;width:10%"> \(x)</th>
<td style="width:30%;text-align:left">-\(\infty)</td>
<td style="width:10%"> \embed{reply2,5} </td>
<td style="width:30%;text-align:right">+\(\infty)</td>
</tr><tr>
<th style="border-right:solid black 1px;width:10%">\(g\circ f(x))</th>
<td style="width:30%"> \embed{reply3} </td>
<td style="width:10%"> \embed{reply5,5} </td>
<td style="width:30%"> \embed{reply4} </td>
</tr>
</table>
</li>
<li><p>
Compléter le tableau des variations de la fonction \(f\circ g)
</p>
<table class="wimscenter wimsnoborder" style="border:solid black 1px;">
<tr style="border:solid black 1px;">
<th style="border-right: solid black 1px;width:10%">\(x)</th>
<td style="width:30%;text-align:left">-\(\infty)</td>
<td style="width:5%">\embed{reply6,5}</td>
<td style="width:30%;text-align:right">+\(\infty)</td>
</tr>
<tr style="border:solid black 1px;">
<th style="border-right: solid black 1px;width:10%">\(f\circ g(x))</th>
<td style="width:30%"> \embed{reply7} </td>
<td style="width:5%">\embed{reply9,5}</td>
<td style="width:30%"> \embed{reply8} </td>
</tr>
</table>
</li>
</ol>
}

\answer{variation de g }{\c_g;\choix1}{type=menu}
\answer{abscisse du sommet pour gof }{\x0}
\answer{monotonie 1 }{\v[1] }{type=clickfill}{option = shuffle}
\answer{monotonie 2}{\v[2] }{type=clickfill}{option = shuffle}
\answer{ordonnée du sommet}{\gofx0}
\answer{abscisse du sommet pour fog }{\x1}
\answer{monotonie 1 }{\v2[1] }{type=clickfill}{option = shuffle}
\answer{monotonie 1}{\v2[2] }{type=clickfill}{option = shuffle}
\answer{ordonnée du sommet}{\fogx1}

\hint{La composée de deux fonctions monotones
<ul>
<li> de même sens de variation est croissante </li>
<li> de sens de variations opposés est décroissante.</li>
</ul>}

\text{err1=La fonction \(g) est croissante, donc \(f) et \(g \circ f) ont les mêmes variations, seules les coordonnées du sommet changent}
\text{err2=La fonction \(g) est décroissante, donc \(f) et \(g \circ f) ont des variations opposées}
\text{err_sens=\c2>0?\err1:\err2}

\text{err2_1=La fonction \(g) est croissante, donc \(f) et \(f \circ g) ont les mêmes variations, seules les coordonnées du sommet changent}
\text{err2_2=La fonction \(g) est décroissante, donc quand \(x) varie de \(-\infty) à \(
+\infty), \(g(x)) varie de \(+\infty) à \(-\infty).<br>
Lers variations de \(f \circ g) se déduisent de celles de \(f) par une lecture de droite à gauche!<br>}
\text{err2_2=\c1>0?\err2_2 Une flèche \(\searrow) à gauche de \(\x0) dans le tableau de \(f) se transforme en \(\swarrow) ce qui donne une flèche \(\nearrow) à droite de \(\x1) dans le tableau de \(f \circ g).
: \err2_2 Une flèche \(\nearrow) à gauche de \(\x0) dans le tableau de \(f) se transforme en \(\nwarrow) ce qui donne une flèche \(\searrow) à droite de \(\x1) dans le tableau de \(f \circ g).}
\text{err2_sens=\c2>0?\err2_1:\err2_2}

\feedback{\reply1 notsametext \choix1[\c_g]}{[1]: Une fonction affine est
croissante si son coefficient directeur est positif,
 sinon elle est décroissante}

\feedback{\reply2 notsametext \x0}{[2]: Dans la composée \(g \circ f), la fonction affine \(g) a une influence "verticale":<br>
 <ul>
<li> Dilatation verticale de coefficient \c2 </li>
<li> Translation de vecteur \(\c1\vec{j}) </li>
</ul>
L'abscisse du sommet ne varie donc pas!}

\feedback{\reply5 notsametext \gofx0}{[5]: Pour calculer l'ordonnée du sommet de \(g \circ f),
il faut calculer \(g(\fx0))}

\feedback{(\reply3 notsametext \v[1]) or (\reply4 notsametext \v[2])}{[3,4]:\err_sens}

\feedback{(\reply7 notsametext \v2[1]) or (\reply8 notsametext \v2[2])}{[7,8]:\err2_sens}

\feedback{\reply6 notsametext \x1}{[6]: Pour calculer l'abscisse du sommet de \(f \circ g),
il faut résoudre \(g(x)=\x0)}

\feedback{\reply9 notsametext \fogx1}{[9]: Dans la composée \(f \circ g),
 la fonction affine \(g) a une influence "horizontale":<br>
 <ul>
<li> Dilatation horizontale de coefficient \c2 </li>
<li> Translation de vecteur \(\cc1\vec{i}) </li>
</ul>
L'ordonnée du sommet ne varie donc pas!}
