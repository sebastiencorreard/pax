!set title=QCM2 sur fonction carré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]

!ifval abs($val7)=abs($val6)
val7=$[rint(2*$val7)]
!endif
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint(-$val6)]
val10=$[rint(-$val7)]
tmp0=!texmath (x+$val6)^2+$val7

val11=$(tmp0)
tmp0=!texmath (x+$val9)^2+$val7

val12=$(tmp0)
tmp0=!texmath (x+$val6)^2+$val10

val13=$(tmp0)
tmp0=!texmath (x+$val9)^2+$val10

val14=$(tmp0)
tmp0=!texmath (x+$val7)^2+$val6

val15=$(tmp0)
tmp0=!texmath (x+$val7)^2+$val9

val16=$(tmp0)
tmp0=!texmath (x+$val10)^2+$val6

val17=$(tmp0)
tmp0=!texmath (x+$val10)^2+$val9

val18=$(tmp0)
val19=la parabole \(\displaystyle{\mathcal{P}}) d'équation \(y=x^2)
tmp0=!texmath  $val9*x+ $val7*y

val20=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val20

val20=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val20

val20=$(tmp0)
val21=\(f(x)=$val11),\(f(x)=$val12),\(f(x)=$val13),\(f(x)=$val14),\(f(x)=$val15),\(f(x)=$val16),\(f(x)=$val17),\(f(x)=$val18)
replytype1=checkbox
replyoption1=shuffle 
replyname1=translation
replygood1=1;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	La fonction 
!insmath f
$() dont la courbe représentative 
!insmath \displaystyle{\mathcal{C}_f}
$() est la translatée de	$val19 par la translation de vecteur 
!insmath $val20
$() est donnée par:	</p>	<table class="wimscenter wimsnoborder"><tr>	 
!for m_i=1 to 4 
$()<td> 
!read oef/embed.phtml reply1,\i 
$()</td> 
!next
$()	</tr><tr>	 
!for m_j=5 to 8 
$()<td> 
!read oef/embed.phtml reply1,\j 
$()</td> 
!next
$()	</tr></table>	
$()
!exit

