val17=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val17

val17=$(tmp0)
tmp0=!texmath  $val12*x+ $val11*y

val18=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val18

val18=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val18

val18=$(tmp0)
tmp0=!texmath  $val7*x+ $val6*y

val19=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val19

val19=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val19

val19=$(tmp0)
