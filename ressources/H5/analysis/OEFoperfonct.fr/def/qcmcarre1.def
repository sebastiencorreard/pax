tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]

!ifval abs($val7)=abs($val6)
val7=$[rint(2*$val7)]
!endif
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath (x+$val6)^2+$val7

val9=$(tmp0)
val10=la parabole \(\displaystyle{\mathcal{P}}) d'équation \(y=x^2)
val11=$[rint(-$val6)]
val12=$[rint(-$val7)]
tmp0=!texmath  $val11*x+ $val7*y

val13=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val13

val13=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val13

val13=$(tmp0)
tmp0=!texmath  $val11*x+ $val12*y

val14=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val14

val14=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val14

val14=$(tmp0)
tmp0=!texmath  $val6*x+ $val7*y

val15=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val15

val15=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val15

val15=$(tmp0)
tmp0=!texmath  $val6*x+ $val12*y

val16=$(tmp0)
tmp0=!replace internal x by \vec{i} in $val16

val16=$(tmp0)
tmp0=!replace internal y by \vec{j} in $val16

val16=$(tmp0)
tmp0=!texmath  $val7*x+ $val11*y

val17=$(tmp0)
