val28=<table class="tab_var">	 <caption>$val26</caption>	<tr>	  <th>\(x)</th>	  <td style="text-align:left">\(0)</td>	  <td></td>	  <td>\(\pi)</td>	  <td></td>	  <td style="text-align:right">\(2\pi)</td>	</tr><tr>	  <th valign="middle">var</th>	  <td style="text-align:left" valign="top">\(1) </td>	  <td>\(\searrow) </td>	  <td valign="bottom">-1 </td>	  <td>\(\nearrow)  </td>	  <td valign="top">\(1) </td>	  </tr>	</table>	

