tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0)*$val7)]
tmp0=!randint 1, 10

val9=$[rint(-$(tmp0)*$val7)]
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val10=$[rint($(tmp0)*$val7)]
tmp0=!randint 1, 10

val11=$[rint(-$(tmp0)*$val7)]
val12=$val8*u+$val10
val13=$val9*u+$val11
val14=$[rint($val6+1)]
val15=$[rint(2*$val6)]
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]
val16=\(\nearrow),\(\searrow)

!ifval $val7=1
val17=2,1
!else
val17=1,2
!endif

!ifval $val7=1
val18=1,2
!else
val18=2,1
!endif

!ifval $val8>0
val19=$(val16[$val17])
!else
val19=$(val16[$val18])
!endif

!ifval $val9>0
val20=$(val16[$val17])
!else
val20=$(val16[$val18])
!endif
val21=$(val16[$val17])

!ifval $val7=1
val22=$[rint($val6)]
!else
val22=$[rint($val14)]
!endif

!ifval $val7=1
val23=$[rint(0)]
!else
val23=$[rint($val15)]
!endif
val24=$[rint($val8*$val23+$val10)]
val25=$[rint($val9*$val23+$val11)]
val26=<table class="tab_var">	  <tr>	  <th>\(x)</th>	  <td style="text-align:left">-\(\infty)</td>	  <td>$val22</td>	  <td style="text-align:right">+\(\infty)</td>	  </tr><tr>	  <th>\(var u)</th>	  <td>$(val21[1]) </td>	  <td>$val23 </td>	  <td>$(val21[2]) </td>	</tr>	</table>	
replyname1=abscisse du sommet de f
replygood1=$val22
