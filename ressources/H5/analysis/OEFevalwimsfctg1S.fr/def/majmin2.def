!set title=Détermination d'extremum 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=un maximum,un minimum,un majorant,un minorant,une valeur quelconque
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val13*(x+$val11)^2+$val12)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
val15=!rawmath $val13*(x+$val11)^2

!ifval $val13>0
val16=$[rint(1)]
!else
val16=$[rint(2)]
!endif

!ifval $val13>0
val17=$[rint(2)]
!else
val17=$[rint(1)]
!endif
tmp0=!texmath $val14

val18=$(tmp0)
replyname1=calcul
replygood1=$val15
replytype2=radio
replyname2=signe du dénominateur
replygood2=$val16;Positif,Négatif,Variable
replytype3=menu
replyname3=nature de \($val12)
replygood3=$val17;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur 
!insmath \RR
$() par:	<div class="wimscenter">
!insmath f(x)=$val18
$(). </div>	  On veut déterminer si 
!insmath $val12
$() est un extremum, un minorant ou un majorant de 
!insmath f
$().	<ol>	<li> Calculer <label for="reply1">
!insmath f(x)-($val12)
$()=</label> 
!read oef/embed.phtml reply1 
$()</li>	<li> Sur 
!insmath \,\RR
$(), quel est le signe de cette expression ?  
!read oef/embed.phtml reply2 
$() </li>	<li> Que peut-on conclure alors ?	
!insmath $val12
$() est  
!read oef/embed.phtml reply3 
$() de 
!insmath f
$().</li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,18
embedcnt=3
