 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$val6*x+$val7,$val8*x+$val9
val12=\RR
val13=$(val11[1])
val14=$(val11[2])
t_=!replace internal \( by ( in ($val13)/($val14)
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!texmath $val13

val16=$(tmp0)
tmp0=!texmath $val14

val17=$(tmp0)
tmp=!translate ";': to $     $ in -$val9/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
replytype1=formal
replyname1=\(h(x))
replygood1=$val15
replytype2=fset
replyname2=Ensemble de définition
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère les fonctions 
!insmath f
$() et 
!insmath g
$() définies sur 
!insmath \,$val12
