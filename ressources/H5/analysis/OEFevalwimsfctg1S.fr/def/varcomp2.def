!set title=Sens de variation d'une composée 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr
precision=1000
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 

ansorder=r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!texmath $val6*x+$val7

val8=$(tmp0)
t_=!replace internal \( by ( in -$val6+1
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)*x

val9=$(tmp1)
tmp0=!texmath x^2

val10=$(tmp0)
tmp0=!texmath 1/x

val11=$(tmp0)
tmp=!translate ";': to $     $ in -$val7 / $val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val12=!exec pari print($t_)
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]

!ifval $val13=1
val14=&#93;\(0;+\infty)&#91;
!else
val14=&#93;\(-\infty;0)&#91;
!endif
val15=$[rint(1)]

!ifval $val6>0
val16=$[rint(2)]
!else
val16=$[rint(1)]
!endif

!ifval $val6>0
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif

!ifval $val6>0
val18=$[rint(1)]
!else
val18=$[rint(2)]
!endif

!ifval $val6>0
val19=$[rint(2)]
!else
val19=$[rint(1)]
!endif

!ifval $val13=1
val20=$[rint(2)]
!else
val20=$[rint(1)]
!endif
replytype1=radio
replyname1=
replygood1=$val15;Vrai,Faux
replytype2=radio
replyname2=
replygood2=$val16;Vrai,Faux
replytype3=radio
replyname3=
replygood3=$val17;Vrai,Faux
replytype4=radio
replyname4=
replygood4=$val18;Vrai,Faux
replytype5=radio
replyname5=
replygood5=$val19;Vrai,Faux
replytype6=radio
replyname6=
replygood6=$val20;Vrai,Faux
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère les fonctions:	<ul class="inline"><li>
!insmath f: x \mapsto $val8
$()</li><li>	
!insmath g: x \mapsto $val9
$()	</li><li>
!insmath u: x \mapsto $val10
$()	</li><li>
!insmath v: x \mapsto $val11
$()	</li></ul>	Les propositions suivantes sont-elles vraies ou fausses?	<ol>	<li>
!insmath f \circ g
$() est strictement décroissante sur 
!insmath \,\RR
$():  
!read oef/embed.phtml reply1 
$()	</li>	<li>
!insmath g \circ v
$() est strictement décroissante sur &#93;
!insmath 0;+\infty
$()&#91;:  
!read oef/embed.phtml reply2 
$()	</li>	<li>
!insmath g \circ u
$() est strictement croissante sur &#93;
!insmath -\infty;0
$()&#91;:  
!read oef/embed.phtml reply3 
$()	</li>	<li>
!insmath v \circ f
$() est strictement décroissante sur &#93;
!insmath $val12;+\infty
$()&#91;:  
!read oef/embed.phtml reply4 
$()	</li>	<li>
!insmath u \circ f
$() est strictement décroissante sur &#93;
!insmath $val12;+\infty
$()&#91;:  
!read oef/embed.phtml reply5 
$()	</li>	<li>
!insmath v \circ u
$() est strictement croissante sur $val14:  
!read oef/embed.phtml reply6 
$()	</li>	</ol>	
$()
!exit

