!set title=Axe et centre de symétrie 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
tmp0=!makelist x,-x for x=1 to 5

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$[rint($(val9[1]))]
val11=$[rint(-$(val9[1]))]
val12=$[rint($(val9[2]))]
val13=$[rint(-$(val9[2]))]
val14=$[rint($(val9[3]))]
val15=$[rint(-$(val9[3]))]
val16=$[rint($(val9[4]))]
val17=$[rint(-$(val9[4]))]
val18=$[rint($val10*$val16+$val12)]
val19=$[rint(2*$val18)]
tmp0=!texmath $val10*x+$val12+$val14/(x-$val16)

val20=$(tmp0)
val21=$val10,$val12,$val14,$val16,$val11,$val13,$val15,$val17,$val18
tmp0=!listuniq $val21

val21=$(tmp0)
replytype1=radio
replyoption1=shuffle 
replyname1=abscisse
replygood1=4;$val21
replytype2=numeric
replyname2=
replygood2=$[$val19]
replytype3=radio
replyoption3=shuffle 
replyname3=ordonnée
replygood3=9;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Soit 
!insmath g
$() la fonction définie sur 
!insmath \RR \setminus \{$val16\}
$() par:	<div class="wimscenter">
!insmath g(x)=$val20
$()</div>	  On sait que la courbe de 
!insmath g
$() possède un centre de symétrie 
!insmath \Omega
$().	<ul>	<li> Quelle est l'abscisse 
!insmath \omega
$() de 
!insmath \Omega
$() ?  
!read oef/embed.phtml reply1 
$() </li>	<li> Calculer	
!insmath g(\omega +x)+g(\omega -x)
$() pour 
!insmath \omega+x
$() et 
!insmath \omega-x
$() différents de $val16.<br>	<label for="reply2">
!insmath g(\omega +x)+g(\omega -x)
$()=</label> 
!read oef/embed.phtml reply2,4 
$()</li>	<li> En déduire l'ordonnée de 
!insmath \Omega
$():  
!read oef/embed.phtml reply3 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,20
embedcnt=3
