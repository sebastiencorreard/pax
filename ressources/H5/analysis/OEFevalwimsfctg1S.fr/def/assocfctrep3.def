!set title=Reconnaître des courbes associées 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=est l'image de la courbe de fonction carré par la translation de vecteur
val10=Dans un repère orthonormé \((O;\vec{i},\vec{j})), on donne les courbes	  \(C) et \(\Gamma) d'équations respectives
val11=Comment tracer ces courbes à partir de celle de la fonction carré&nbsp;
val12=<div class="wims_warning">$val7</div>
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
val15=$[rint(-$val13)]
val16=$[rint(-$val14)]
tmp0=!texmath x^2+$val13

val17=$(tmp0)
tmp0=!texmath (x-$val14)^2

val18=$(tmp0)
val19=C $val9 \($val13\vec{i}), C $val9 \($val13\vec{j}), C $val9 \($val15\vec{i}), C $val9 \($val15\vec{j})
val20=\(\Gamma) $val9 \($val14\vec{i}), \(\Gamma) $val9 \($val14\vec{j}), \(\Gamma) $val9 \($val16\vec{i}), \(\Gamma) $val9 \($val16\vec{j})
replytype1=radio
replyoption1=shuffle 
replyname1=Courbe C
replygood1=2;$val19
replytype2=radio
replyoption2=shuffle 
replyname2=Courbe \(Gamma)
replygood2=1;$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val12	  $val10 
!insmath y=$val17
$() $val8 
!insmath y=$val18
$().	<p>	  $(val11[1])?	</p>	<ol><li>	 <ul>	  <li> 
!read oef/embed.phtml reply1,1 
$()</li>	  <li> 
!read oef/embed.phtml reply1,2 
$()</li>	  <li> 
!read oef/embed.phtml reply1,3 
$()</li>	  <li> 
!read oef/embed.phtml reply1,4 
$()</li></ul>	</li><li>	  <ul><li> 
!read oef/embed.phtml reply2,1 
$()</li>	  <li> 
!read oef/embed.phtml reply2,2 
$()</li>	  <li> 
!read oef/embed.phtml reply2,3 
$()</li>	  <li> 
!read oef/embed.phtml reply2,4 
$()</li>	  </ul>	</li></ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,12,17,18
embedcnt=8
