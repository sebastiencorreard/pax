!set title=Axe et centre de symétrie 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0)*2)]
tmp0=!randint 1, $val12-1

val13=$[rint($(tmp0)*2)]
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0)*2+1)]
tmp0=!texmath $val9*x^$val12+$val10*x^$val13+$val11

tmp1=!texmath $val10*x-$val11/x

tmp2=!texmath $val10*x^$val14-$val11*x

tmp3=!texmath $val9*x^$val12-$val11*cos(x)

tmp4=!texmath $val9*x^$val14+$val11*sin(x)

val15=$(tmp0),\RR,2,2	$(tmp1),\RR^*,1,1	$(tmp2),\RR,1,1	$(tmp3),\RR,2,2	$(tmp4),\RR,1,1
tmp0=!shuffle 5

val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val15

tmp=!row $(val16[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
val18=$(val17[1])
val19=$(val17[2])
val20=$[rint($(val17[3]))]
val21=$[rint($(val17[4]))]
tmp=!translate internal $	$ to ; in $val15

tmp=!row $(val16[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
val23=$(val22[1])
val24=$(val22[2])
val25=$[rint($(val22[3]))]
val26=$[rint($(val22[4]))]
val27=\(f(-x)=-f(x)),\(f(-x)=f(x))
val28=La courbe de \(f) est symétrique par rapport à l'origine du repère,La courbe de \(f) est symétrique par rapport à l'axe des ordonnées
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val20;$val27
replytype2=radio
replyoption2=shuffle 
replyname2=
replygood2=$val21;$val28
replytype3=radio
replyoption3=shuffle 
replyname3=
replygood3=$val25;$val27
replytype4=radio
replyoption4=shuffle 
replyname4=
replygood4=$val26;$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Comparer 
!insmath f(x)
$() et 
!insmath f(-x)
$() pour tout 
!insmath x
$() de 
!insmath \mathcal{D}
$() et	  interpréter graphiquement:	<ul>	<li>
!insmath f(x)=$val18
$() et 
!insmath \mathcal{D}=$val19
$() :	  <ol>	  <li> 
!read oef/embed.phtml reply1 
$()</li>	  <li> 
!read oef/embed.phtml reply2,1 
$()<br> 
!read oef/embed.phtml reply2,2 
$()</li>	 </ol>	</li>	<li>
!insmath f(x)=$val23
$() et 
!insmath \mathcal{D}=$val24
$() :	  <ol>	 <li> 
!read oef/embed.phtml reply3 
$()</li>	 <li> 
!read oef/embed.phtml reply4,1 
$()<br> 
!read oef/embed.phtml reply4,2 
$()</li>	 </ol>	</li>	</ul>	
$()
!exit

