 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 
precision=1000

ansorder=r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 10

val6=$[rint($(tmp0))]
t_=!rawmath 1/$val6
val7=!exec pari print($t_)
t_=!rawmath -$val7
val8=!exec pari print($t_)
val9=$[rint(-$val6)]
val10=$[0.$val6]
val11=$[rint($val6^2)]
val12=$[rint(-$val11)]
val13=$[rint(-2*$val6)]
val14=$[rint(2*$val6)]
tmp0=!randitem x,y,z,t,u

val15=$(tmp0)
val16=-1 a pour inverse,-1,1,0.1	  0.1 a pour inverse,10,1,0.9	$val6 a pour opposé,$val9,$val7,$val10	\(\frac{1}{$val6}) a pour inverse,$val6,$val8,$val10	\(-$val6^2) est égal à,-$val11,$val11,$val13	\(($val6$val15)^2) est égal à,\($val11 $val15^2),2$val6$val15,\($val6 $val15^2)	\((-$val15)^2+$val15^2) est égal à, \(2$val15^2),0,\((2$val15)^2)	
tmp0=!shuffle 7

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row $(val17[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val19=$(val18[1])
tmp0=!item 2 to 4 of $val18

val20=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row $(val17[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val21=$(val18[1])
tmp0=!item 2 to 4 of $val18

val22=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row $(val17[3]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val23=$(val18[1])
tmp0=!item 2 to 4 of $val18

val24=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row $(val17[4]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val25=$(val18[1])
tmp0=!item 2 to 4 of $val18

val26=$(tmp0)
replytype1=radio
replyoption1=shuffle 
replyname1=$val19
replygood1=1;$val20
replytype2=radio
replyoption2=shuffle 
replyname2=$val21
replygood2=1;$val22
replytype3=radio
replyoption3=shuffle 
replyname3=$val23
replygood3=1;$val24
replytype4=radio
replyoption4=shuffle 
replyname4=$val25
replygood4=1;$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

