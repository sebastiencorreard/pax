!set title=Détermination d'extremum 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=un maximum,un minimum,un majorant,un minorant,une valeur quelconque
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val13*($val10*x+$val11)^2+$val12
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)

!ifval $val13>0
val15=minimum
!else
val15=maximum
!endif
t_=!rawmath -$val11/$val10
val16=!exec pari print($t_)
tmp0=!texmath $val14

val17=$(tmp0)
replytype1=numeric
replyname1=m
replygood1=$[$val12]
replytype2=numexp
replyname2=\(x_0)
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur 
!insmath \ \RR
$() par:	<div class="wimscenter">
!insmath f(x)=$val17
$() </div>	  Cette fonction possède un $val15 noté 
!insmath m
$() atteint en 
!insmath x_0
$().<p>	  Déterminer les valeurs de 
!insmath m
$() et de 
!insmath x_0
$().</p>	<div class="wimscenter"> 
!insmath m
$()= 
!read oef/embed.phtml reply1,4 
$()</div>	<div class="wimscenter"> 
!insmath x_0
$()= 
!read oef/embed.phtml reply2,4 
$()</div>	
$()
!exit

