$()	  $(val9[1;])	<div class="wimscenter">	
!insmath f: x \mapsto $val19
$() ,  
!insmath g: x \mapsto $val20
$(), 
!insmath u: x \mapsto $val21
$(),	
!insmath v: x \mapsto $val22
$(), 
!insmath w: x \mapsto $val23
$().	</div>	  $(val9[2;])?	<ol>	<li> $(val18[1]):  
!read oef/embed.phtml reply1 
$() </li>	<li> $(val18[2]):  
!read oef/embed.phtml reply2 
$() </li>	<li> $(val18[3]):  
!read oef/embed.phtml reply3 
$() </li>	<li> $(val18[4]):  
!read oef/embed.phtml reply4 
$() </li>	</ol>	
$()
