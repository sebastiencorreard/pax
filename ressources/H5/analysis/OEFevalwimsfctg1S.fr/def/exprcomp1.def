choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
tmp=!trim On considère les fonctions suivantes	  L'expression de la composée est-elle correcte ou incorrecte&nbsp;
val9=!translate internal $	\
$ to ;; in $tmp
val10=Correcte, Incorrecte
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]

!ifval $val11>0
val12=$[rint(-$val12)]
!endif
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val14=$[rint($(tmp0))]

!ifval $val13>0
val14=$[rint(-$val14)]
!endif

!ifval $val11*$val14+$val13-$val12*$val13-$val14=0
val14=$[rint(2*$val14)]
!endif
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]
tmp0=!randitem 1,2

tmp1=!randitem 1,2

tmp2=!randitem 1,2

tmp3=!randitem 1,2

val16=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
t_=!replace internal \( by ( in $val11*$val12*x+$val11*$val14 +$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

t_=!replace internal \( by ( in $val11*$val12*x+$val12*$val13 +$val14
tmp2=!exec maxima $t_

tmp3=!texmath $(tmp2)

t_=!replace internal \( by ( in $val11*$val12*x+$val12*$val13 +$val14
tmp4=!exec maxima $t_

tmp5=!texmath $(tmp4)

t_=!replace internal \( by ( in $val11*$val12*x+$val11*$val14 +$val13
tmp6=!exec maxima $t_

tmp7=!texmath $(tmp6)

t_=!replace internal \( by ( in ($val11)^2*x+$val11*$val13 +$val13
tmp8=!exec maxima $t_

tmp9=!texmath $(tmp8)

tmp10=!texmath ($val11*x+$val13)^2

t_=!replace internal \( by ( in ($val12)^2*x+$val12*$val14 +$val14
tmp11=!exec maxima $t_

tmp12=!texmath $(tmp11)

tmp13=!texmath ($val12*x+$val14)^2

tmp=!trim \(f \circ g(x)=$(tmp1)),\(f \circ g(x)=$(tmp3))	\(g \circ f(x)=$(tmp5)),\(g \circ f(x)=$(tmp7))	\(f \circ f(x)=$(tmp9)),\(f \circ f(x)=$(tmp10))	\(g \circ g(x)=$(tmp12)),\(g \circ g(x)=$(tmp13))
val17=!translate internal $	\
$ to ;; in $tmp
val18=$(val17[1;$(val16[1])]),$(val17[2;+$(val16[2])]),$(val17[3;$(val16[3])]),$(val17[4;$(val16[4])])
tmp0=!texmath $val11*x+$val13

val19=$(tmp0)
tmp0=!texmath $val12*x+$val14

val20=$(tmp0)
tmp0=!texmath x^2

val21=$(tmp0)
tmp0=!texmath 1/x

val22=$(tmp0)
tmp0=!texmath sqrt(x)

val23=$(tmp0)
replytype1=radio
replyname1=$(val18[1])
replygood1=$(val16[1]);$val10
replytype2=radio
replyname2=$(val18[2])
replygood2=$(val16[2]);$val10
replytype3=radio
replyname3=$(val18[3])
replygood3=$(val16[3]);$val10
replytype4=radio
replyname4=$(val18[4])
replygood4=$(val16[4]);$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

