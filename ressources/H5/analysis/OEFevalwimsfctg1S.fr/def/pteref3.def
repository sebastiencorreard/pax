tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

val7=$[rint($val6+$(tmp0))]
val8=$[rint($val6^2)]
val9=$[rint($val7^2)]
tmp0=!randitem x,y,z,t,u

val10=$(tmp0)
val11=Si \($val6 \leq $val10 \leq $val7) alors \($val8 \leq $val10^2 \leq $val9),1	  Si \($val8 \leq $val10^2 \leq $val9) alors \($val6 \leq $val10 \leq $val7),2	  Si \(-$val6 \leq $val10 \leq $val7) alors \($val8 \leq $val10^2 \leq $val9),2,contre-exemple \(0 \in [-$val6;$val7]) et \(0 \not \in [$val8;$val9])	  Si \($val10<-$val6) alors \($val10^2 < $val8),2,La fonction carré est décroissante sur &#93;\(-\infty) &#59; 0 &#91;	
tmp0=!shuffle 4

val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row $(val12[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$(val13[1])
val15=$[rint($(val13[2]))]
val16=$(val13[3])
tmp=!translate internal $	$ to ; in $val11

tmp=!row $(val12[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val17=$(val13[1])
val18=$[rint($(val13[2]))]
val16=$val16<br>$(val13[3])
tmp0=!randitem 1,2

val19=$[rint($(tmp0))]
!if $val19=1 
val20=Si \($val10^2 > $val8) alors \($val10 > $val6) ou \($val10 < -$val6)
val21=$[rint(1)]
val22=Si \($val10^2 > $val8) alors \($val10 > $val6) et \($val10 < -$val6)
val23=$[rint(2)]
!else
val20=Pour tout \($val10 > 1) alors \($val10^2 > $val10)
val21=$[rint(1)]
val22=Il existe \($val10 > 0) tel que \($val10^2 < $val10)
val23=$[rint(1)]
val16=$val16<br> 0.5 > 0 et 0.25 < 0.5
!endif
val24=$val14,$val17,$val20,$val22
val25=$val15,$val18,$val21,$val23
tmp0=!shuffle 4

val12=$(tmp0)
replytype1=radio
replyname1=$(val24[$(val12[1])])
replygood1=$(val25[$(val12[1])]);Vrai, Faux
