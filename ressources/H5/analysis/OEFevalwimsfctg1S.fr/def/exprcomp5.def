val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=On considère une fonction \(f) définie par
val10=et on veut l'écrire sous	  la forme d'une composée \(f=u \circ v).	  Cocher le couple de fonctions \(u, v) pouvant convenir.
val11=Correcte, Incorrecte
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]

!ifval $val14=$val13
val14=$[rint(-$val14)]
!endif
tmp0=!texmath $val13*x^2+$val14

tmp1=!texmath sqrt($val14*x-$val13)

tmp2=!texmath 1/(2*$val13*x+$val14)

val15=$(tmp0),$(tmp1),$(tmp2)
val16=$(val15[$val12])
tmp0=!texmath u(x)=$val13*x+$val14

tmp1=!texmath v(x)=x^2

tmp2=!texmath u(x)=$val14

tmp3=!texmath v(x)=$val13*x^2

tmp4=!texmath u(x)=$val13*x

tmp5=!texmath v(x)=x^2+$val14

tmp6=!texmath u(x)=$val14*x-$val13

tmp7=!texmath v(x)=sqrt(x)

tmp8=!texmath u(x)=sqrt(x)

tmp9=!texmath v(x)=$val14*x-$val13

tmp10=!texmath u(x)=$val14*x

tmp11=!texmath v(x)=sqrt(x-$val13)

tmp12=!texmath u(x)=1/(2*$val13*x)

tmp13=!texmath v(x)=x+$val14

tmp14=!texmath u(x)=2*$val13*x+$val14

tmp15=!texmath v(x)=1/x

tmp16=!texmath u(x)=1/x

tmp17=!texmath v(x)=2*$val13*x+$val14

val17=1,\($(tmp0)) $val8 \($(tmp1)),\($(tmp2)) $val8 \($(tmp3)),\($(tmp4)) $val8 \($(tmp5)),	2,\($(tmp6)) $val8 \($(tmp7)),\($(tmp8)) $val8 \($(tmp9)),\($(tmp10)) $val8 \($(tmp11)),	3,\($(tmp12)) $val8 \($(tmp13)),\($(tmp14)) $val8 \($(tmp15)),\($(tmp16)) $val8 \($(tmp17))
tmp=!translate internal $	$ to ; in $val17

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!item 2 to -1 of $val18

val11=$(tmp0)
val19=$[rint($(val18[1]))]
replytype1=radio
replyname1=couple convenable
replygood1=$val19;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

