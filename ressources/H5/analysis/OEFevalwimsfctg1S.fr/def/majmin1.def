!set title=Détermination d'extremum 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=un maximum,un minimum,un majorant,un minorant,une valeur quelconque
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]

!ifval $val10=$val12
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($val13+$(tmp0)*$(tmp1))]
!endif
t_=!rawmath -$val13/$val12
val14=!exec pari print($t_)
t_=!rawmath $val10/$val12
val15=!exec pari print($t_)
tmp0=!texmath $val15

val16=$(tmp0)
tmp0=!texmath $val14

val17=$(tmp0)
tmp0=!randitem 1,2

val18=$[rint($(tmp0))]

!ifval $val18=1
val19=\(\rbrack $val17; +\infty \lbrack)
!else
val19=\(\rbrack -\infty; $val17 \lbrack)
!endif
t_=!replace internal \( by ( in ($val10*x+$val11)/($val12*x+$val13)
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
tmp0=!texmath $val20

val21=$(tmp0)
t_=!replace internal \( by ( in $val20 - $val10/$val12
tmp0=!exec maxima $t_

val22=!rawmath $(tmp0)

!ifval ($val12>0 and $val18=1) or ($val12<0 and $val18=2)
val23=$[rint(1)]
!else
val23=$[rint(-1)]
!endif

!ifval $val23=1
val24=$[rint(1)]
!else
val24=$[rint(2)]
!endif
t_=!rawmath $val11-$val10*$val13/$val12
val25=!exec pari print($t_)
t_=!replace internal \( by ( in $val12*x+$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val26=$(tmp1)
t_=!rawmath $val23*$val25
val27=!exec pari print($t_)

!ifval $val27>0
val28=$[rint(4)]
!else
val28=$[rint(3)]
!endif
replyname1=calcul
replygood1=$val25
replytype2=radio
replyname2=signe du dénominateur
replygood2=$val24;Positif,Négatif,Variable
replytype3=menu
replyname3=nature de \($val16)
replygood3=$val28;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur $val19 par:	<div class="wimscenter">
!insmath f(x)=$val21
$() </div>	  On veut déterminer si 
!insmath $val16
$() est un extremum, un minorant ou un majorant de 
!insmath f
$().	<ol>	<li>Calculer	   
!read oef/special.phtml mathmlinput [f(x)- ($val16)=\frac{reply1}{$val26}],12	reply 1 
$()	</li>	<li> Sur $val19, quel est le signe du dénominateur ?	   
!read oef/embed.phtml reply2 
$() </li>	<li> Que peut-on conclure alors&nbsp;? 
!insmath $val16
$() est  
!read oef/embed.phtml reply3 
$() de 
!insmath f
$().</li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,19,21,26
embedcnt=3
