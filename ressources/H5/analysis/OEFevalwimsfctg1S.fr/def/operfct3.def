!set title=Fonctions et opérations 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*x+$val7
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val13*($val11)+$val14*($val12))
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!texmath $val11

val16=$(tmp0)
tmp0=!texmath $val12

val17=$(tmp0)
tmp0=!texmath $val15

val18=$(tmp0)
val19=$val13*f+$val14*g
replytype1=formal
replyname1=relation fonctionnelle
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère les fonctions 
!insmath f,g
$() et 
!insmath h
$() définies sur 
!insmath \,\RR
$() par	<div class="wimscenter"> 
!insmath f(x)=$val16
$() , 
!insmath g(x)=$val17
$() et 
!insmath h(x)=$val18
$() </div>	<p>	  Trouver une relation fonctionnelle exprimant 
!insmath h
$() en fonction de 
!insmath f
$() et 
!insmath g
$():	</p>	<div class="wimscenter"><label for="reply1">
!insmath h=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	
$()
!exit

