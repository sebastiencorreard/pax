!set title=Reconnaître des courbes associées 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=est l'image de la courbe de fonction inverse par la translation de vecteur
val10=C est symétrique par rapport au point
val11=Dans un repère orthonormé \((O;\vec{i},\vec{j})), on donne la courbe	  \(C) d'équation
val12=Comment tracer la courbe \(C) à partir de celle de la fonction inverse&nbsp;,	  Quel élément de symétrie possède \(C)&nbsp;
val13=<div class="wims_warning">$val7</div>
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]

!ifval $val14>0
val16=$[rint(-$val14)]
!else
val16=$[rint($val14)]
!endif

!ifval $val15>0
val17=$[rint(-$val15)]
!else
val17=$[rint($val15)]
!endif

!ifval $val14>0
val18=$[rint($val14)]
!else
val18=$[rint(-$val14)]
!endif

!ifval $val15>0
val19=$[rint($val15)]
!else
val19=$[rint(-$val15)]
!endif

!ifval $val15>0
val20=$[rint(1)]
!else
val20=$[rint(3)]
!endif

!ifval $val14<0
val20=$[rint($val20+1)]
!endif
val21=$[rint($val20)]
tmp0=!texmath 1/(x-$val14)+$val15

val22=$(tmp0)
val23=C $val9 \($val18\vec{i}+$val19\vec{j}), C $val9 \($val16\vec{i}+$val19\vec{j}), C $val9 \($val18\vec{i}$val17\vec{j}), C $val9 \($val16\vec{i}$val17\vec{j})
val24=$val10 \(S($val18;$val19)), $val10 \(S($val16;$val19)), $val10 \(S($val18;$val17)), $val10 \(S($val16;$val17))
replytype1=radio
replyoption1=shuffle 
replyname1=Courbe C
replygood1=$val20;$val23
replytype2=radio
replyoption2=shuffle 
replyname2=Symétrie
replygood2=$val21;$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val13	  $val11 
!insmath y=$val22
$().	<ol><li>	  $(val12[1])?	<ul>	 <li> 
!read oef/embed.phtml reply1,1 
$()</li>	 <li> 
!read oef/embed.phtml reply1,2 
$()</li>	 <li> 
!read oef/embed.phtml reply1,3 
$()</li>	 <li> 
!read oef/embed.phtml reply1,4 
$()</li>	 </ul>	</li><li>	  $(val12[1]) 
!insmath C
$()?	 <ul>	 <li> 
!read oef/embed.phtml reply2,1 
$()</li>	 <li> 
!read oef/embed.phtml reply2,2 
$()</li>	 <li> 
!read oef/embed.phtml reply2,3 
$()</li>	 <li> 
!read oef/embed.phtml reply2,4 
$()</li>	 </ul>	</li></ol>	
$()
!exit

