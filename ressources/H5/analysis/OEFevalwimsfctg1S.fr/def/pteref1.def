!set title=Propriétés des fonctions de référence 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr
oefcss=<style> table.tab_var {margin-left:auto;margin-right:auto; border:solid 1px black;} table.tab_var tr, table.tab_var td, table.tab_var th { padding:7pt;margin-top:10px; margin-bottom:10px; text-align:center; border-collapse:collapse; min-width:10pt; } table.tab_var th { border:solid 1px black} table.tab_var tr { border:solid 1px black} </style> 
precision=1000

ansorder=r,r,r,r,r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items -1,-2,-1/2,1,2,1/2

tmp0=!randitem $tmp
t_=!rawmath $(tmp0)
val6=!exec pari print($t_)
tmp0=!randint -4, 4

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val6*x+$val7
tmp0=!exec pari $t_

tmp1=!texmath $(tmp0)

val8=$(tmp1)
val9=$val8,x^2,\frac{1}{x},\sqrt{x}
tmp0=!shuffle 4

val10=$(tmp0)

!ifval $val6>0
val11=\(T_2),\(T_4),\(T_5),\(T_3)
!else
val11=\(T_1),\(T_4),\(T_5),\(T_3)
!endif
val12=\(C_4),\(C_3),\(C_1),\(C_2)
tmp0=!positionof item 1 in $val10

val13=$[rint($(tmp0))]
val14=$(val11[$(val10[1])])
val15=$(val12[$(val10[1])])
tmp0=!positionof item 2 in $val10

val16=$[rint($(tmp0))]
val17=$(val11[$(val10[2])])
val18=$(val12[$(val10[2])])
tmp0=!positionof item 3 in $val10

val19=$[rint($(tmp0))]
val20=$(val11[$(val10[3])])
val21=$(val12[$(val10[3])])
tmp0=!positionof item 4 in $val10

val22=$[rint($(tmp0))]
val23=$(val11[$(val10[4])])
val24=$(val12[$(val10[4])])
val25=xrange -8,8	 yrange= -6,11	 segment 0,-6,0,11,black	 segment -8,0,8,0,black	 plot red,$val6*x+$val7	 plot blue,x^2	 plot green, sqrt(x)	 plot orange, 1/x	 text red,-1,$val7,medium,C4	 text blue,-2,5,medium,C3	 text green,4,3,medium,C2	 text orange,-5,0,medium,C1	
val26=\(T_1),\(T_2),\(T_3),\(T_4),\(T_5)
val27=\(C_1),\(C_2),\(C_3),\(C_4)

!ifval $val6>0
val28=\(T_1)
!else
val28=\(T_2)
!endif
val29=<ul class="inline">	<li><table class="tab_var">	<caption>\(T_1\)</caption>	<tr>	  <th> \(x)</th>	  <td style="text-align:left"> \(-\infty)</td>	  <td></td>	  <td style="text-align:right">\(+\infty)</td>	</tr><tr>	   <th valign="middle">var</th>	   <td style="text-align:left" valign="top"> \(+\infty) </td>	   <td> \(\searrow) </td>	   <td style="text-align:right" valign="bottom"> \(-\infty) </td>	</tr>	</table>	</li><li><table class="tab_var">	<caption>\(T_2\)</caption>	<tr>	  <th>\(x)</th>	  <td style="text-align:left"> \(-\infty)</td>	  <td></td>	  <td style="text-align:right">\(+\infty)</td>	</tr><tr>	  <th valign="middle">var</th>	  <td style="text-align:left" valign="bottom"> \(-\infty) </td>	  <td> \(\nearrow) </td>	  <td style="text-align:right" valign="top"> \(+\infty) </td>	</tr>	</table>	</li><li><table class="tab_var">	<caption>\(T_3\)</caption>	<tr>	   <th>\(x)</th>	   <td style="text-align:left"> \(0)</td>	   <td></td>	   <td style="text-align:right">\(+\infty)</td>	</tr><tr>	  <th valign="middle">var</th>	  <td style="text-align:left" valign="bottom"> 0 </td>	  <td> \(\nearrow) </td>	  <td style="text-align:right" valign="top"> \(+\infty) </td>	</tr>	</table>	</li><li><table class="tab_var">	<caption>\(T_4\)</caption>	<tr>	  <th> \(x)</th>	  <td style="text-align:left"> \(-\infty)</td>	  <td></td>	  <td>0</td>	  <td></td>	  <td style="text-align:right">\(+\infty)</td>	</tr><tr>	  <th valign="middle">var</th>	  <td style="text-align:left" valign="top"> \(+\infty) </td>	  <td> \(\searrow) </td>	  <td valign="bottom"> 0 </td>	  <td> \(\nearrow)  </td>	  <td valign="top"> \(+\infty) </td>	</tr>	</table>	</li><li><table class="tab_var">	<caption>\(T_5\)</caption>	<tr>	  <th> \(x)</th>	  <td style="text-align:left"> \(-\infty)</td>	  <td></td>	  <td></td>	  <td>0</td>	  <td style="width:1px"></td>	  <td style="width:1px"></td>	  <td style="text-align:right">\(+\infty)</td>	</tr><tr>	  <th valign="middle">var</th>	  <td style="text-align:left" valign="top"> 0 </td>	  <td> \(\searrow) </td>	  <td valign="bottom"> \(-\infty) </td>	  <td style="width:1px;color:red">||</td>	  <td style="text-align:left" valign="top"> \(+\infty) </td>	  <td> \(\searrow)  </td>	  <td valign="bottom"> 0 </td>	  </tr>	</table>	</li></ul>	
replytype1=dragfill
replyname1=tableau de \(f_1)
replygood1=$val14;$val28
replytype2=dragfill
replyname2=courbe de \(f_1)
replygood2=$val15
replytype3=dragfill
replyname3=tableau de \(f_2)
replygood3=$val17
replytype4=dragfill
replyname4=courbe de \(f_2)
replygood4=$val18
replytype5=dragfill
replyname5=tableau de \(f_3)
replygood5=$val20
replytype6=dragfill
replyname6=courbe de \(f_3)
replygood6=$val21
replytype7=dragfill
replyname7=tableau de \(f_4)
replygood7=$val23
replytype8=dragfill
replyname8=courbe de \(f_4)
replygood8=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère les quatre fonctions 
!insmath f_1
$(), 
!insmath f_2
$(), 
!insmath f_3
$() et 
!insmath f_4
$() définies par	<div class="wimscenter">
!insmath f_1(x)=$(val9[$(val10[1])])
$();	
!insmath f_2(x)=$(val9[$(val10[2])])
$(); 
!insmath f_3(x)=$(val9[$(val10[3])])
$() et 
!insmath f_4(x)=$(val9[$(val10[4])])
$().</div>	<div class="center">$val29</div>	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 300,300 \
$val25 
$()</div>	<div class="medium_size text_col">Associer chaque fonction à son tableau de variation et à sa courbe.	<table class="wimscenter wimsborder">	<tr><th>Fonction</th><th>Tableau des variations</th><th>Courbe</th></tr>	<tr><td>
!insmath f_1
$() </td><td> 
!read oef/embed.phtml reply1,150x30 
$()</td><td> 
!read oef/embed.phtml reply2 
$()</td></tr>	<tr><td>
!insmath f_2
$() </td><td> 
!read oef/embed.phtml reply3 
$()</td><td> 
!read oef/embed.phtml reply4 
$()</td></tr>	<tr><td>
!insmath f_3
$() </td><td> 
!read oef/embed.phtml reply5 
$()</td><td> 
!read oef/embed.phtml reply6 
$()</td></tr>	<tr><td>
!insmath f_4
$() </td><td> 
!read oef/embed.phtml reply7 
$()</td><td> 
!read oef/embed.phtml reply8 
$()</td></tr>	</table>	</div>	</div>	
$()
!exit

