!set title=Détermination d'extremum 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=un maximum,un minimum,un majorant,un minorant,une valeur quelconque
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

tmp2=!randitem 0,$(tmp0)*$(tmp1)

val13=$[rint($(tmp2))]
t_=!replace internal \( by ( in ($val10*x^2+$val13*x+$val11)/(x^2+$val12)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in x^2+$val12
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val13*x+$val11-$val10*$val12
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
val17=$[rint($val11-$val10*$val12)]
!if $val13=0 

!ifval $val17>0
val18=$[rint(4)]
!else
val18=$[rint(3)]
!endif

!ifval $val17>0
val19=$[rint(1)]
!else
val19=$[rint(2)]
!endif
!else
val18=$[rint(5)]
val19=$[rint(3)]
!endif
tmp0=!texmath $val14

val20=$(tmp0)
replyname1=calcul
replygood1=$val16
replytype2=radio
replyname2=signe du dénominateur
replygood2=$val19;Positif,Négatif,Variable
replytype3=menu
replyname3=nature de \($val12)
replygood3=$val18;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur 
!insmath \,\RR
$() par:	<div class="wimscenter">
!insmath f(x)=$val20
$() </div>	  On veut déterminer si 
!insmath $val10
$() est un extremum, un minorant ou un majorant de 
!insmath f
$().	<ol>	<li> Calculer	 
!read oef/special.phtml mathmlinput [f(x)- ($val10) = \frac{reply1}{$val15} ], 12	reply1	 
$()	</li>	<li> Sur 
!insmath \,\RR
$(), quel est le signe de cette expression ?  
!read oef/embed.phtml reply2 
$() </li>	<li> Que peut-on conclure alors ?<br>	
!insmath $val10
$() est  
!read oef/embed.phtml reply3 
$() de 
!insmath f
$().</li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,15,20
embedcnt=3
