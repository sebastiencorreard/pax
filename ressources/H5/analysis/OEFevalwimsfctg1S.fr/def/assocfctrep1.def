!set title=Reconnaître des courbes associées 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr

ansorder=r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=Retrouver l'équation de chaque courbe sachant qu'elle est de la forme
val10=<div class="wims_warning">$val7</div>
val11=
tmp0=!shuffle -4,-3,-2,-1,-0.5,-0.25,0.25,0.5,1,2,3,4

val12=$(tmp0)
val13=$[$(val12[1])]
val14=$[$(val12[2])]
!for val15  in $val12 
tmp0=!texmath $val15*x^2

val16=\(y=$(tmp0))
tmp0=!append item $val16 to $val11

val11=$(tmp0)
!next
tmp0=!texmath $val13*x^2

val17=\(y=$(tmp0))
tmp0=!texmath $val14*x^2

val18=\(y=$(tmp0))
tmp0=!texmath k*x^2

val19=$(tmp0)
val20=$val13 * x^2
val21=$val14 * x^2
val22=$val17,$val18
val23=100x50x1
tmp0=!listcomplement $val22 in $val11

val11=$(tmp0)
val24=xrange -10,10	 yrange -10,10	 parallel -10,-9,10,-9,0,1,19,gray	 parallel -9,-10,-9,10,1,0,19,gray	 arrow 0,-10,0,10,10,black	 arrow -10,0,10,0,10,black	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	 
val25=$val24	 plot red,$val20	
val26=$val24	 plot red,$val21	 
replytype1=dragfill
replyname1=courbe 1
replygood1=$val17;$val11
replytype2=dragfill
replyname2=Courbe 2
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10	  $val9 
!insmath y=$val19
$().	<table class="wimscenter wimsnoborder"><tr>	 <td> 
!read oef/draw.phtml 200,200 \
$val25 
$()</td><td> 
!read oef/draw.phtml 200,200 \
$val26 
$()</td></tr>		  <tr><td> 
!read oef/embed.phtml reply1,$val23 
$()</td><td> 
!read oef/embed.phtml reply2,$val23 
$()</td></tr></table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,19,23,25,26
embedcnt=2
