!set title=Fonctions et opérations 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
val7=xrange -5,5	yrange -5,5	gridfill 0,0,5,5,$val6	linewidth 3	parallel -5,-5,5,-5,0,1,11,$val6	parallel -5,-5,-5,5,1,0,11,$val6	linewidth 1	vline 0,0,black	hline 0,0,black	arrow 0,0,1,0,10,magenta	arrow 0,0,0,1,10,magenta	text red,0.7,-0.1,medium,i	text red,-0.2,0.7,medium,j	text black,-0.2,-0.1,medium,O	
tmp0=!randitem -1/2,-1/3,-3,-2,1/3,1/2,2,3

val8=$(tmp0)
tmp0=!randitem -1,-1/2,-2,1/2,1,2,1/3

val9=$(tmp0)
tmp0=!randitem -1,-1/2,-2,1/2,1,2,1/3

val10=$(tmp0)
tmp0=!randitem 2,-2,-1/2,1/2

val11=$(tmp0)
val12=
val13=
tmp0=!randitem $val8*x+$val9,($val8*x+$val9)*(x+$val10)

val14=$(tmp0)
tmp0=!texmath $val14

val15=$(tmp0)
val16=abs($val14)
val17=\(|f(x)|)
tmp0=!append item $val16 to $val12

val12=$(tmp0)
tmp0=!append item $val17 to $val13

val13=$(tmp0)
val16=-($val14)
val17=\(-f(x))
tmp0=!append item $val16 to $val12

val12=$(tmp0)
tmp0=!append item $val17 to $val13

val13=$(tmp0)
val16=$val11*($val14)
val17=\($val11 f(x))
tmp0=!append item $val16 to $val12

val12=$(tmp0)
tmp0=!append item $val17 to $val13

val13=$(tmp0)
val16=$val14+$val11
val17=\($val11+f(x))
tmp0=!append item $val16 to $val12

val12=$(tmp0)
tmp0=!append item $val17 to $val13

val13=$(tmp0)
tmp0=!shuffle red,blue,orange,green

val18=$(tmp0)
val19=160
val20=
!for val21 =1 to 4 
!readproc oef/draw.phtml $val19,$val19 \
    $val7	    plot $(val18[$val21]),$(val12[$val21])	     
tmp0=$ins_url
val22=<img src="	    $(tmp0)"	    width="$val19"	    height="$val19"	    alt="">	    
tmp0=!append item $val22 to $val20

val20=$(tmp0)
!next
!readproc oef/draw.phtml $val19,$val19 \
    $val7	    plot black,$val14	     
tmp0=$ins_url
val23=<img src="	    $(tmp0)"	    width="$val19"	    height="$val19"	    alt="">	    
val24=$val19 x$val19 x$val19
replytype1=correspond
replyname1=Correspondance graphe/fonction
replygood1=$val20;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 Dans le plan muni d'un repère orthonormé 
!insmath (O,i,j)
$(), on a tracé	 le graphe de la fonction 
!insmath f(x)= $val15
$()	<div class="wimscenter"> $val23 </div>	  Associez à chacune des fonctions ci-contre son graphe.	<div class="wimscenter">	   
!read oef/embed.phtml reply 1,$val24 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

