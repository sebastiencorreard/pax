!set title=Reconnaître des courbes associées 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard; Maguy, Bruno
email=regine@mangeard.fr

ansorder=r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=Retrouver l'équation de chaque courbe sachant qu'elle est de la forme
val10=<div class="wims_warning">$val7</div>
val11=
val10=
tmp0=!shuffle -4,-3,-2,-1,0,1,2,3,4

val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint($(val12[2]))]

!ifval $val13=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val15=$[rint($(tmp2))]
!endif

!ifval $val14=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val16=$[rint($(tmp2))]
!endif
tmp0=!texmath (x-a)^2+b

val17=$(tmp0)
val18=(x-$val13)^2+$val15
val19=(x-$val14)^2+$val16
val20=\rep1,\rep2
val21=100x50x1
tmp0=!listcomplement $val20 in $val11

val11=$(tmp0)
val22=xrange -10,10	 yrange -10,10	 parallel -10,-9,10,-9,0,1,19,gray	 parallel -9,-10,-9,10,1,0,19,gray	 arrow 0,-10,0,10,10,black	 arrow -10,0,10,0,10,black	 segment -0.2,1,0.2,1,black	 segment 1,-0.2,1,0.2,black	 text black,-0.7,1.5,small,1	 text black,0.7,-0.5,small,1	 
val23=$val22	 plot red,$val18	
val24=$val22	 plot red,$val19	 
replytype1=function
replyname1=courbe 1
replygood1=!rawmath $val18
replytype2=function
replyname2=Courbe 2
replygood2=!rawmath $val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10	  $val9 
!insmath y=$val17
$().	<table class="wimscenter wimsnoborder"><tr>	 <td> 
!read oef/draw.phtml 200,200 \
$val23 
$()</td><td> 
!read oef/draw.phtml 200,200 \
$val24 
$()</td></tr>		  <tr><td><label for="reply1">
!insmath y=
$()</label> 
!read oef/embed.phtml reply1,8 
$()</td>	    <td><label for="reply2">
!insmath y=
$()</label> 
!read oef/embed.phtml reply2,8 
$()</td>	    </tr></table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,17,23,24
embedcnt=2
