tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$val6*x+$val7,$val6/x+$val7,$val6*sqrt(x)+$val7
val12=\RR,\RR^*,\rbrack 0; +\infty \lbrack
tmp0=!itemcnt $val11

tmp1=!randint 1, $(tmp0)

val13=$[rint($(tmp1))]
t_=!replace internal \( by ( in $(val11[$val13])
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val16*($val14))
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val16*($val14)+$val15)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val14)*($val15))
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val14)^2)
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
tmp0=!texmath $val14

val21=$(tmp0)
tmp0=!texmath $val15

val22=$(tmp0)
val23=$(val12[$val13])
replytype1=formal
replyname1=\(h_1(x))
replygood1=$val17
replytype2=formal
replyname2=\(h_2(x))
replygood2=$val18
replytype3=formal
replyname3=\(h_3(x))
replygood3=$val19
replytype4=formal
replyname4=\(h_4(x))
replygood4=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

