!set title=Détermination d'extremum 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=A faire sans calculatrice.
val8=et
val9=un maximum,un minimum,un majorant,un minorant,une valeur quelconque
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
t_=!replace internal \( by ( in ($val10*x^2+$val11)/($val12*x^2+$val13)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val12*x^2+$val13
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!texmath $val14

val16=$(tmp0)
t_=!rawmath $val11-$val10*$val13/$val12
val17=!exec pari print($t_)
t_=!rawmath $val10/$val12
val18=!exec pari print($t_)

!ifval $val17>0
val19=minorée
!else
val19=majorée
!endif

!ifval $val17>0
val20=plus grand minorant
!else
val20=plus petit majorant
!endif
replytype1=numexp
replyname1=m
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur 
!insmath \RR
$() par:	<div class="wimscenter">
!insmath f(x)=$val16
$().</div>	  Cette fonction est $val19.<p>	  Déterminer son $val20 noté 
!insmath m
$().	  </p>	<div class="wimscenter"> <label for="reply1">
!insmath m
$()=</label> 
!read oef/embed.phtml reply1,4 
$()</div>	
$()
!exit

