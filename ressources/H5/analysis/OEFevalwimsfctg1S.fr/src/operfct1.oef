\function{f2=maxima(expand(\m*(\f)+\g))}
\function{f3=maxima(expand((\f)*(\g)))}
\function{f4=maxima(expand((\f)^2))}
\text{ft=texmath(\f)}
\text{gt=texmath(\g)}
\text{defdomf=\defdom[\i]}
\statement{
