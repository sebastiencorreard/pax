 }{
  \real{q1=randint(\x0*10+1..\x1*10-3)/10}
  \real{q=randint(\x0*10+1..\x1*10-3)/10}
  \real{q=\q2=\q1?\q+0.1}
  \real{q2=\q1<\q?\q:\q1}
