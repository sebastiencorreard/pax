\integer{b2=\a2=0?randint(1..5)*randint(1,-1):randint(-5..5)}
\text{typef=texmath((x-a)^2+b)}
\text{f1=(x-\a1)^2+\b1}
\text{f2=(x-\a2)^2+\b2}

\text{grep=\rep1,\rep2}
