\title{Détermination d'extremum 4}

\text{lang=slib(oef/env lang)}

\text{name_warning=A faire sans calculatrice.}
\text{name_and=et}





\text{listerep=un maximum,un minimum,un majorant,un minorant,une valeur quelconque}

%%if{\lang=en}{
