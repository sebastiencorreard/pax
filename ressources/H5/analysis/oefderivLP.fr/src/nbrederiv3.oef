\title{Nombre dérivé et tangente}
\language{fr}
\range{-5..5}
\range{-5..5}
author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a = randint(-6..6)}
\function{f =slib(polynomial/random 2,10,x,\a)}
\function{d = pari (diff(\f,x))}
\integer{e= randint(0..5)}
\real {N = wims (values \d for x = \e ) }


\statement {
<ul><li>
Calculer la dérivée de la fonction \(f(x)= \f \).
</li><li>
Calculer \(f'(\e)).
</li><li>
En déduire le coefficient directeur de la tangente à la courbe représentant \(f)
au point d'abscisse \(x=\e \).
</li></ul>}


\answer{\(f'(x))}{\d} {type=function}
\answer{\(f'(\e))}{\N} {type=numeric}{comma}
\answer{coefficient directeur }{\N} {type=numeric}{comma}
