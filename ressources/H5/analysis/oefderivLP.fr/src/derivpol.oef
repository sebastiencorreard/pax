\title{Dérivée(s) de polynôme(s)}
\language{fr}
\range{-5..5}
author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{nb = \confparm1 = ? 3:\confparm1}
\text{listerep=reply1,reply2,reply3,reply4,reply5}
\text{listerep=\listerep[1..\nb]}
\steps{\listerep}

\text{enonce = \nb = 1 ? Calculer la dérivée de la fonction suivante : Calculer les dérivées des fonctions suivantes }
\text{degres = \confparm2 = ? 3:\confparm2}
\text{nd = items(\degres)}
\integer{d1 = \degres[1]}
\integer{d2 = 2>\nd ? randomitem(\degres):\degres[2]}
\integer{d3 = 3>\nd ? randomitem(\degres):\degres[3]}
\integer{d4 = 4>\nd ? randomitem(\degres):\degres[4]}
\integer{d5 = 5>\nd ? randomitem(\degres):\degres[5]}

\text{confparm3 = wims(listunion \confparm3 and \confparm4) }
\text{confparm3 = \confparm3 = ? x:\confparm3}
\text{x = randomitem(\confparm3)}
\text{x = wims(char 1 of \x)}


\function{f1=slib(polynomial/random \d1,4,\x,4)}
\function{f2 =slib(polynomial/random \d2,4,\x,1)}
\function{f3 =slib(polynomial/random \d3,1,\x,5)}
\function{f4 =slib(polynomial/random \d4,5,\x,-9)}
\function{f5 =slib(polynomial/random \d5,9,\x,9)}
\function{g1 = diff(\f1,\x)}
\function{g2 = diff(\f2,\x)}
\function{g3 = diff(\f3,\x)}
\function{g4 = diff(\f4,\x)}
\function{g5 = diff(\f5,\x)}

\text{fonct = \(\f1 \),\(\f2 \),\(\f3\),\(\f4\),\(\f5\)}
\text{fonct = \fonct[1..\nb]}
\text{deriv =,}
\text{deriv = \deriv[1..\nb]}

\text{fder =  \(\f1 \),\(\g1\);\(\f2 \),\(\g2\);\(\f3\),\(\g3\);\(\f4\),\(\g4\);\(\f5\),\(\g5\)}
\text{fder = row (1..\nb, \fder)}

\matrix{matrice = fonction \(f \),fonction dérivée \(f' \);\(\f1 \),reply1;\(\f2 \),reply2;\(\f3\),reply3;\(\f4\),reply4;\(\f5\),reply5}
\matrix{matrice = row (1..\nb+1,\matrice)}

\text{table=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;])}


\text{Tabsol = slib(text/matrixhtml [fonction \(f \),fonction dérivée \(f' \);\fder],wimscenter wimsborder,TH=[1;0])}


\statement { 
<div class="wims_question">\enonce de la variable \(\x \) .</div>
\special{codeinput [\table], 15,div
reply1
reply2
reply3
reply4
reply5
  }

}

\answer{}{\g1,\x}{type=function}{option=comma}
\answer{}{\g2,\x}{type=function}{option=comma}
\answer{}{\g3,\x}{type=function}{option=comma}
\answer{}{\g4,\x}{type=function}{option=comma}
\answer{}{\g5,\x}{type=function}{option=comma}

\solution{\Tabsol}
