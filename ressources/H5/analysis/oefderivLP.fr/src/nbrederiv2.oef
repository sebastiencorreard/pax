\title{Nombre dérivé (GeoGebra 2)}
\language{fr}
\range{-5..5}
\range{-5..5}
author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\function{f =slib(polynomial/random 3,10,x,4)}
\integer{e1= randint(-5..2)}
\real {e2=\e1+1.5}
\real {e3=\e1+3}
\function{g = diff(\f,x)}
\real { S1 = wims (values \g for x = \e1 ) }
\real { S2 = wims (values \g for x = \e2 ) }
\real { S3 = wims (values \g for x = \e3 ) }
\integer{R1= sgn(\S1)+2}
\integer{R2= sgn(\S2)+2}
\integer{R3= sgn(\S3)+2}


\text{option=width=912
height=498
language=fr
showAlgebraInput=true
showToolBar=true
customToolBar="0|40"
file=nbder2.ggb
}

\text{A=slib(geo2D/geogebra ,\option)}

\statement {<p>
Déterminer graphiquement, à l'aide de l'appliquette GeoGebra, le nombre dérivé de la fonction <span class="larger">\(f(x) = \f \) </span> en utilisant les points suivants de la courbe représentant \(f \) :
<span class="larger"> \(A_1 \) </span> d'abscisse <span class="larger"> \(\e1 \)</span> ; <span class="larger">\(A_2 \) </span>d'abscisse <span class="larger">\(\e2 \)</span> et <span class="larger">\(A_3 \) </span>d'abscisse <span class="larger">\(\e3 \)</span>
</p>

<div class="wims_instruction">
<strong>Utilisation de l'appliquette GeoGebra :</strong>
<ul>
  <li><span class="wims_emph">Entrer la fonction correcte dans la zone de saisie. Saisir : \(f(x)= \)\f </span>, puis cliquer hors de la zone de saisie pour valider.</li>
  <li>L'abscisse du point \(A \) est réglée par le curseur.</li>
  <li>La tangente à la courbe représentant \(f \) au point \(A \) est tracée automatiquement.</li>
</ul>
</div>
  \A

<ul class="spacer">
  <li><span class = "bold">Au point \(A_1 \) d'abscisse \(\e1 \)</span>, la tangente à la courbe correspond à une fonction affine \embed{reply4} ;
  <br>\(f'(\e1)= \) \embed{reply1,4} .</li>
   <li><span class = "bold">Au point \(A_2 \) d'abscisse \(\e2 \)</span>, la tangente à la courbe correspond à une fonction affine \embed{reply5} ;
  <br>\(f'(\e2)= \) \embed{reply2,4} .</li>
  <li><span class = "bold">Au point \(A_3 \) d'abscisse \(\e3 \)</span>, la tangente à la courbe correspond à une fonction affine \embed{reply6} ;
  <br>\(f'(\e3)= \) \embed{reply3,4} .</li>
</ul>
}



\answer{}{\S1} {type=numeric}{option=comma}
\answer{}{\S2} {type=numeric}{option=comma}
\answer{}{\S3} {type=numeric}{option=comma}
\answer{}{\R1;strictement décroissante,constante,strictement croissante}{type=menu}
\answer{}{\R2;strictement décroissante,constante,strictement croissante}{type=menu}
\answer{}{\R3;strictement décroissante,constante,strictement croissante}{type=menu}
