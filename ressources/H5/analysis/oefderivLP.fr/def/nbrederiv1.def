!set title=Nombre dérivé (GeoGebra 1) 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/polynomial/random 3,10,x,4 
tmp0=$slib_out
val6=!rawmath $(tmp0)
tmp0=!randint -5, 2

val7=$[rint($(tmp0))]
val8=$[$val7+1.5]
val9=$[$val7+3]
tmp=!translate ;";': to $     $ in $val6,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val10=!rawmath $(tmp0)
tmp0=!values $val10 for x = $val7 

val11=$[$(tmp0) ]
tmp0=!values $val10 for x = $val8 

val12=$[$(tmp0) ]
tmp0=!values $val10 for x = $val9 

val13=$[$(tmp0) ]
val14=width=912	height=498	language=fr	showAlgebraInput=true	showToolBar=true	customToolBar="0|40"	file=nbder1.ggb	
!readproc slib/geo2D/geogebra ,$val14 
tmp0=$slib_out
val15=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val11]
replytype2=numeric
replyoption2=comma 
replyname2=2
replygood2=$[$val12]
replytype3=numeric
replyoption3=comma 
replyname3=3
replygood3=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Déterminer graphiquement, à l'aide de l'appliquette GeoGebra, le nombre dérivé de la fonction <span class="larger">
!insmath f(x) = $val6 
$() </span> en utilisant les points suivants de la courbe représentant 
!insmath f 
$() : 	<span class="larger"> 
!insmath A_1 
$() </span> d'abscisse <span class="larger"> 
!insmath $val7 
$()</span> ; <span class="larger">
!insmath A_2 
$() </span>d'abscisse <span class="larger">
!insmath $val8 
$()</span> et <span class="larger">
!insmath A_3 
$() </span>d'abscisse <span class="larger">
!insmath $val9 
$()</span>.		   <div class="wims_instruction">	<strong>Utilisation de l'appliquette GeoGebra:</strong>	<ul>	  <li> <span class="wims_emph">Entrer la fonction correcte dans la zone de saisie. Saisir : 
!insmath f(x)= 
$()$val6 </span>, puis cliquer hors de la zone de saisie pour valider.</li>	  <li>L'abscisse du point 
!insmath A 
$() est réglée par le curseur.</li>	  <li>La tangente à la courbe représentant 
!insmath f 
$() au point 
!insmath A 
$() est tracée automatiquement, et son équation apparaît dans la partie gauche (algèbre) de la fenêtre.</li>	  <li> Déterminer graphiquement les nombres dérivés cherchés. </li>	  </ul>	  </div>	  $val15	  <ul>	  <li>
!insmath f'($val7)= 
$()  
!read oef/embed.phtml reply1,4 
$()</li>	  <li>
!insmath f'($val8)= 
$()  
!read oef/embed.phtml reply2,4 
$()</li>	  <li>
!insmath f'($val9)= 
$()  
!read oef/embed.phtml reply3,4 
$()</li>	  </ul>	  
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,15
embedcnt=3
