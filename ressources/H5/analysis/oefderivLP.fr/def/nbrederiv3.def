!set title=Nombre dérivé et tangente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=norbert.rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -6, 6

val6=$[rint($(tmp0))]
!readproc slib/polynomial/random 2,10,x,$val6 
tmp0=$slib_out
val7=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val7,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec pari $t_

val8=!rawmath $(tmp1)
tmp0=!randint 0, 5

val9=$[rint($(tmp0))]
tmp0=!values $val8 for x = $val9 

val10=$[$(tmp0) ]
replytype1=function
replyname1=\(f'(x))
replygood1=!rawmath $val8
replytype2=numeric
replyname2=\(f'($val9))
replygood2=$[$val10]
replytype3=numeric
replyname3=coefficient directeur
replygood3=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ul><li>	Calculer la dérivée de la fonction 
!insmath f(x)= $val7 
$().	</li><li>	Calculer 
!insmath f'($val9)
$().	</li><li>	En déduire le coefficient directeur de la tangente à la courbe représentant 
!insmath f
$()	au point d'abscisse 
!insmath x=$val9 
$().	</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
