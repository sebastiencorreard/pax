!set title=Opérations élémentaires sur les matrices
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
keywords=matrix

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 3

val6=$[rint($(tmp0))]
!readproc slib/matrix/random $val6,$val6,5 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/matrix/random $val6,$val6,5 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 2, 5

val9=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in A=[$val7];B=[$val8];M=(B-A)/$val9;print(M)
tmp0=!exec pari $t_

val10=$(tmp0)
replytype1=matrix
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer une matrice carrée de format $val6 x $val6 telle que:	<div class="wimscenter">	
!insmath [$val7]
$() 
!if $val9>0 
$()+ 
!endif
$() $val9 M= 
!insmath [$val8]
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=0
