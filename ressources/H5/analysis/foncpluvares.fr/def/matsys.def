!set title=Equations matricielles et systèmes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
keywords=matrix, equation_systems

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 2,5 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/matrix/random 2,1,5 
tmp0=$slib_out
val7=$(tmp0)
t_=!replace internal \( by ( in A=[$val6];B=[$val7];M=A^(-1)*B;print(M)
tmp0=!exec pari $t_

val8=$(tmp0)
replytype1=matrix
replyname1=Matrice
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Déterminer une matrice 
!insmath M=[x;y]
$() telle que	<div class="wimscenter">	
!insmath [$val6] M = [$val7]
$()	</div>	<div class="wimscenter">	
!insmath M=
$()  
!read oef/embed.phtml reply 1, 2x5 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
