!set title=Optimisation sous contrainte
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=linear_optimisation
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randitem 1,5

tmp2=!randitem -1,1

tmp3=!randint 1, 5

tmp4=!randitem -5,5

tmp5=!randitem -5,5

tmp6=!randitem -5,5

tmp=!trim $(tmp0)*$(tmp1),0,$(tmp2)*$(tmp3),$(tmp4),$(tmp5),$(tmp6)
val6=!translate internal $	\
$ to ;; in $tmp
val7=$[rint(($(val6[1]))^2-($(val6[3]))^2)]
!if $val7=0 
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint(-1*($val8+$(tmp0)))]
tmp0=!randitem -5,5

tmp1=!randitem -5,5

tmp2=!randitem -5,5

tmp=!trim $val8,0,$val9,$(tmp0),$(tmp1),$(tmp2)
val6=!translate internal $	\
$ to ;; in $tmp
!endif
t_=!replace internal \( by ( in [$val6]*[x^2;x*y;y^2;x;y;1]
tmp0=!exec pari $t_

val10=$(tmp0)
t_=!replace internal \( by ( in expand($val10)
tmp0=!exec maxima $t_

val10=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

val12=$[rint($(tmp0)*$val11)]
tmp0=!randint 1, 3

val13=$[rint($(tmp0)*$val11)]
t_=!replace internal \( by ( in $val11*x+$val12*y
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val13-$val12*y)/$val11)
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val13-$val11*x)/$val12)
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(($val16),y,$val10)
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val17)
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(($val15),x,$val10)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val18)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
!if $val19=1 
val20=x
val21=!rawmath $val17
!else
val20=y
val21=!rawmath $val18
!endif
t_=!replace internal \( by ( in subst(0,$val20,$val21)
tmp0=!exec maxima $t_

val22=$[rint($(tmp0))]
tmp=!translate ;";': to $     $ in $val21,$val20

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in subst(0,$val20,$(tmp0))
tmp1=!exec maxima $t_

val23=$[rint($(tmp1))]
tmp=!translate ;";': to $     $ in $val21,$val20,2

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in subst(0,$val20,$(tmp0))/2
tmp1=!exec maxima $t_

val24=$[rint($(tmp1))]
!if $val24>0 
val25=minimum
val26=$[rint(1)]
!else
val25=maximum
val26=$[rint(2)]
!endif
!if $val19=1 
t_=!rawmath -$val23/(2*$val24)
val27=!exec pari print($t_)
t_=!replace internal \( by ( in subst(($val27),x,$val16)
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val28=!exec pari print($t_)
!endif
!if $val19=2 
t_=!rawmath -$val23/(2*$val24)
val28=!exec pari print($t_)
t_=!replace internal \( by ( in subst(($val28),y,$val15)
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val27=!exec pari print($t_)
!endif
t_=!replace internal \( by ( in subst($val27,x,$val10)
tmp0=!exec maxima $t_

val29=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val28,y,$val29)
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val29=!exec pari print($t_)
oefsteps=reply 1	reply 2	reply 3, reply 4, reply 5 
nextstep=!nosubst reply 1	reply 2	reply 3, reply 4, reply 5 
!readproc oef/steps.proc
replytype1=function
replyname1=Fonction
replygood1=!rawmath $val21
replytype2=menu
replyname2=Extrema
replygood2=$val26;minimum,maximum
replytype3=default
replyname3=Valeur extrema
replygood3=$val29
replytype4=rational

replyname4=Extrema x
replygood4=$val27
replytype5=rational

replyname5=Extrema y
replygood5=$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la fonction de deux variables 
!insmath f
$() définie par 
!insmath f(x;y)=$val10
$().	On se propose d'optimiser  cette fonction sous la contrainre 
!insmath $val14=$val13
$().	
!if $m_step=1 
$()	<p>	Déterminer l'expression de 
!insmath f
$(), sous la contrainte imposée en fonction de $val20 uniquement:	</p><div class="wimscenter">	 
!read oef/embed.phtml reply 1,15 
$()	</div>	 
!endif
$()	
!if $m_step=2 
$()<p>	Oui, sous la contrainre imposée, on a 
!insmath f(x;y)=g($val20)=$val21
$().</p>	<div class="spacer">	Cette fonction présente sur l'ensemble des réels 
!insmath \ \\R
$() un  
!read oef/embed.phtml reply 2 
$().	</div>	 
!endif
$()	
!if $m_step=3 
$()	<p>	Oui, sous la contrainte imposée, cette fonction présente bien un $val25 sur 
!insmath \ \\R
$().	</p>	<div class="spacer">	Ce $val25 vaut  
!read oef/embed.phtml reply 3,10 
$().	Il est atteint pour 
!insmath x=
$() 
!read oef/embed.phtml reply 4,10 
$() et pour 
!insmath y=
$() 
!read oef/embed.phtml reply 5,10 
$().	</div>	 
!endif
$()	
$()
!exit

