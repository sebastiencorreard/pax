!set title=Equations linéaires et polynômes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
keywords=equation_systems

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/polynomial/random 3,10,x 
tmp0=$slib_out
val6=$(tmp0)
tmp=!translate ;";': to $     $ in $val6,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val7=$(tmp1)
tmp0=!randint -5, 0

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint($val8+$(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($val9+$(tmp0))]
tmp0=!randint 1, 3

val11=$[rint(\d+$(tmp0))]
t_=!replace internal \( by ( in subst($val8,x,$val6)
tmp0=!exec maxima $t_

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in subst($val8,x,$val7)
tmp0=!exec maxima $t_

val13=$[rint($(tmp0))]
t_=!replace internal \( by ( in subst($val9,x,$val6)
tmp0=!exec maxima $t_

val14=$[rint($(tmp0))]
t_=!replace internal \( by ( in subst($val9,x,$val7)
tmp0=!exec maxima $t_

val15=$[rint($(tmp0))]
val16=
val17=
val18=
replytype1=default
replyname1=Polynôme
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère une fonction polynomiale de degré 3,	dont la courbe passe par	les points 
!insmath A($val8;$val12)
$() et 
!insmath B($val9;$val14)
$(). On suppose en outre	 que les tangentes à 
!insmath C_f
$()	en ces points ont pour coefficnets directeurs respectifs 
!insmath $val13
$() et 
!insmath $val15
$().	<p>Déterminer la fonction 
!insmath f
$().</p>	<div class="wimscenter">	On a 
!insmath f(x)=
$()  
!read oef/embed.phtml reply 1 
$().	</div>	
$()
!exit

:hint
$()
!insmath f
$() est de la forme 
!insmath f(x)=ax^3+bx^2+cx+d
$().	La condtion 
!insmath f($val8)=$val12
$() se traduit par une équation en a,b,c et d.	<p>	De plus dire que la tangente à 
!insmath C_f
$() en 
!insmath A
$() a pour coefficent directeur 
!insmath $val13
$()	signifie que 
!insmath f'($val8)=$val13
$(), ce qui se traduit également par une équation en a,b,c,d.	</p><p>	Déterminer 
!insmath f
$() revient donc à résoudre un système de quatre équations à quatre inconnues....	</p>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,12,13,14,15
embedcnt=1
