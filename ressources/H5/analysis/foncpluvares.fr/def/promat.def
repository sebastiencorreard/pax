!set title=Produit de deux matrices
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
keywords=matrix

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
!readproc slib/matrix/random $val6,$val7,5 
tmp0=$slib_out
val9=$(tmp0)
!readproc slib/matrix/random $val7,$val8,5 
tmp0=$slib_out
val10=$(tmp0)
t_=!replace internal \( by ( in A=[$val9];B=[$val10];C=A*B;print(C)
tmp0=!exec pari $t_

val11=$(tmp0)
replytype1=matrix
replyname1=A B
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère les matrices 
!insmath A=[$val9]
$() et 
!insmath B=[$val10]
$(). Calculer le produit 
!insmath A B
$().	<p>Ce produit est égal à:</p>	<div class="wimscenter">	 
!read oef/embed.phtml reply 1, $val6 x 10 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10
embedcnt=1
