\title{Equations matricielles et systèmes}
\author{Frédéric, Pitoun}
\text{A=slib(matrix/invertible 2,5)}
\keywords{matrix, equation_systems}

\text{B=slib(matrix/random 2,1,5)}

\text{M=pari(A=[\A];B=[\B];M=A^(-1)*B;print(M))}

\statement{
Déterminer une matrice \(M=[x;y]) telle que
<div class="wimscenter">
\([\A] M = [\B])
</div>
<div class="wimscenter">
\(M=) \embed{reply 1, 2x5}
</div>
}
\answer{Matrice}{\M}{type=matrix}
