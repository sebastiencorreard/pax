\title{Opérations élémentaires sur les matrices}
\author{Frédéric, Pitoun}
\integer{n=random(2..3)}
\keywords{matrix}

\text{A=slib(matrix/random \n,\n,5)}
\text{B=slib(matrix/random \n,\n,5)}

\integer{k=random(-1,1)*randint(2..5)}

\text{M=pari(A=[\A];B=[\B];M=(B-A)/\k;print(M))}

\statement{Déterminer une matrice carrée de format \n x \n telle que:
<div class="wimscenter">
\([\A]) \if{\k>0}{+} \k M= \([\B])
</div>
}

\answer{Réponse}{\M}{type=matrix}
