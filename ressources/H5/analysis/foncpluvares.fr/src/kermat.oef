\title{Equations linéaires}
\author{Frédéric, Pitoun}
\keywords{equation_systems}

\text{A=slib(matrix/random 2,3,5)}

\text{K=pari(A=[\A];C=matker(A);print(C))}

\text{t1=}
\text{t2=}
\text{t3=}

\statement{On considère la matrice \(A=[\A]). Déterminer un vecteur non nul
\(B=[x;y;z]) tel que \(A B=0).
<p>On a</p>
<div class="wimscenter">
\(x=) \embed{reply 1,5}<br>
\(y=) \embed{reply 2,5}<br>
\(z=) \embed{reply 3,5}
</div>
}
\answer{Reponse x}{\rep1}{type=default}
\answer{Reponse y}{\rep2}{type=default}
\answer{Reponse z}{\rep3}{type=default}

\matrix{rep=\rep1;\rep2;\rep3}
\text{t1=pari(B=[\rep];n=mattranspose(B)*B;print(n))}
\text{t2=pari(A=[\A];B=[\rep];C=A*B;c=mattranspose(C)*C;print(c))}
\matrix{t3=pari(A=[\rep];print(A))}

\condition{Le vecteur est non nul}{\t1<>0}
\condition{AB=0}{\t2=0}

