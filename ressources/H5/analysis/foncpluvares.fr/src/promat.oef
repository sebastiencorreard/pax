\title{Produit de deux matrices}
\author{Frédéric, Pitoun}
\keywords{matrix}
\integer{n=randint(1..3)}
\integer{m=randint(2..3)}
\integer{r=randint(1..3)}

\text{A=slib(matrix/random \n,\m,5)}
\text{B=slib(matrix/random \m,\r,5)}

\text{C=pari(A=[\A];B=[\B];C=A*B;print(C))}


\statement{On considère les matrices \(A=[\A]) et \(B=[\B]). Calculer le produit \(A B).
<p>Ce produit est égal à:</p>
<div class="wimscenter">
\embed{reply 1, \n x 10}
</div>
}

\answer{A B}{\C}{type=matrix}
