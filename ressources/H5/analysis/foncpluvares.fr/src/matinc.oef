\title{Multiplication de matrices et inconnues}
\keywords{matrix}

\author{Frédéric, Pitoun}
\text{A=slib(matrix/random 2,3,5)}
\text{B=slib(matrix/random 3,1,5)}

\matrix{C=pari(A=[\A];B=[\B];C=A*B;print(C))}
\integer{l=random(1,2)}
\integer{c=random(1..3)}

\matrix{A1=pari(A=[\A];C=matrix(2,3,i,j,A[i,j]);C[\l,\c]=x;print(C))}

\integer{rep=\A[\l;\c]}

\statement{Déterminer \(x) pour que le produit de la matrice \([\A1]) et de la matrice
\([\B]) soit égal à \([\C]).
<div class="spacer">
On a \(x=) \embed{reply 1,5}.
</div>
}
\answer{x}{\rep}{type=default}
