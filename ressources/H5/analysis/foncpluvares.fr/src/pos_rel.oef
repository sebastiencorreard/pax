\title{Position relative d'un point et d'une surface}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{100}
\integer{alv=random(1..6)}
\integer{nb=random(-10..10)}
\if{\alv=1 or \alv=2}{
\matrix{c1=slib(matrix/random 1,6,5)}
}
\if{\alv=3}{
\matrix{c1=random(-5,5),0,0,random(-5,5),random(-5,5),random(-5,5)}
}
\if{\alv>=4}{
\matrix{c1=0,random(-1,1)*random(-5,5),0,random(-5,5),random(-5,5),random(-5,5)}
\if{\c1[6]=\nb}{
\integer{nb=\nb+1}
}
}
\text{fonc=pari([\c1]*[x^2;x*y;y^2;x;y;1])}
\text{fonc=maxima(expand(\fonc))}
\integer{nrep=random(1..3)}
\integer{xs=randint(-5..5)}
\integer{ys=randint(-5..5)}
\function{zs1=maxima(subst(\xs,x,\fonc))}
\function{zs2=maxima(subst(\ys,y,\zs1))}
\if{\nrep=1}{
\integer{zs=\zs2+0}
}
\if{\nrep=2}{
\integer{zs=\zs2+randint(1..5)}
}
\if{\nrep=3}{
\integer{zs=\zs2-randint(1..5)}
}
\text{position=sur,au dessus,au dessous}
\statement{On considère la surface \(S) d'équation \(z=\fonc) et le point \(M(\xs;\ys;\zs)).
<div class="wimscenter">
Le point \(M) est situé \embed{reply 1} la surface.
</div>
}
\answer{Nature}{\nrep;\position}{type=menu}
