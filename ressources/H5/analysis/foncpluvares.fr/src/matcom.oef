\title{Produit de deux matrices carrées}
\author{Frédéric, Pitoun}
\keywords{matrix}

\text{A=slib(matrix/random 2,2,5)}
\text{B=slib(matrix/random 2,2,5)}

\text{C1=pari(A=[\A];B=[\B];C=A*B;print(C))}
\text{C2=pari(A=[\A];B=[\B];C=B*A;print(C))}

\integer{al=random(1,2)}

\text{produit=item(\al,A B,B A)}

\text{rep=\al=1?\C1:\C2}

\statement{On considère les matrices \(A=[\A]) et \(B=[\B]). Calculer le produit \(\produit\).
<p>Ce produit vaut:</p>
<div class="wimscenter">
\embed{reply 1,4x8}
</div>
}
\answer{Produit}{\rep}{type=matrix}
