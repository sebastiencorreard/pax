\text{lang=slib(oef/env lang)}
\title{Tangente et nombre dérivé (2)}
\title_en{Tangent and derivative (2)}
\text{name_enonce=Le plan est rapporté au repère,
La <span style="color:blue">courbe CCCC</span> représente la
<span style="color:blue">fonction \(f\)</span> définie sur,
<span style="color:green">La droite \(T\)</span> est la tangente à CCCC au point \(A\) de coordonnées}
\text{name_hint=Le nombre dérivé \(f'(a)\) est le coefficient directeur (la pente) de la tangente
  \(T_a\) à la courbe représentative de \(f\) au point d'abscisse \(a\).}
\text{name_answer=Nombre dérivé}
\text{name_feed1=Vous vous êtes trompé sur le signe du coefficient directeur
  de la tangente. Si la fonction est croissante au voisinage de
  , alors la tangente \(T\) "monte" et, est de signe positif.
  Si la fonction est décroissante au voisinage de,
  alors la tangente \(T) "descend" et, est de signe négatif.
}
\text{name_feed2=Le nombre dérivé, est le coefficient directeur \(m\) de la droite \(T\)
  et \(m\) est égal à l'accroissement moyen \(\frac{\Delta y}{\Delta x} = \frac{y_B - y_A}{
x_B - x_A} = MMMM\) (voir flèches rouges sur le graphique). L'arrondi au dixième est }
\text{name_question=On sait de plus que \(T\) passe aussi par le point \(B\) de coordonnées,
  Quelle valeur de la fonction dérivée \(f'\) peut-on en déduire&nbsp;,
  Donner cette valeur arrondie au dixième.}
\if{\lang=en}{
\text{name_enonce=Given the plane,
The <span style="color:blue">curve CCCC</span> represents the
<span style="color:blue">function \(f\)</span> defined in,
<span style="color:green">The line \(T\)</span> is the tangent of CCCC at the point \(A\) of the coordinates}
\text{name_hint=The derivative number \(f'(a)\) is the slope coefficient of the tangent
  \(T_a\) at the representative curve of \(f\) at the point of abscissa \(a\).}
\text{name_answer=Derivative number}
\text{name_feed1=You were wrong about the slope sign
  of the tangent. If the function increases in the neighbourhood
  , then the tangent \(T\) "goes up" and, is of positive sign.
  If the function decreases in the neighbourhood,
  then the tangent \(T) "goes down" and, is of negative sign.
}
\text{name_feed2=The derivative number, is the slope coefficient \(m\) of the line \(T\)
  and \(m\) is equal to the average growth \(\frac{\Delta y}{\Delta x} = \frac{y_B - y_A}{
x_B - x_A} = MMMM\) (see red arrows on the graphic).
  Rounding to the tenth is }
\text{name_question=It is known that \(T\) goes also through the point \(B\) of the coordinates,
  Which value of the derivative function \(f'\) can be deduced,
  Give this value rounded to the nearest tenth.}
}
(version fevrier 05)
\integer{cas=random(1..4)}
\integer{xsize=random(4..6)}
\integer{ysize=\xsize}
\integer{sign1=random(-1,1)}
\integer{sign2=random(-1,1)}
/** cas 1 : Cf hyperbole et tangente en A3 **/
\integer{a1=\cas==1?\sign1*random(-\xsize..-0.5*\xsize-1)}
\integer{b1=\cas==1?\sign2*random(2..0.5*\ysize)}
\integer{a3=\cas==1?random(-0.5*\xsize+1..0.5*\xsize-1)}
\integer{b3=\cas==1?\sign2*random(1..0.5*\ysize-1)}
\function{f=\cas==1? \b3*(\a3-\a1)/(x-\a1)}
\text{ensdef=\cas==1?\(\RR\setminus\{\a1\})}
/** cas 2 : Cf cubique et Cg sa tangente en A3 proche du sommet **/
\integer{a1=\cas==2?random(-\xsize..-0.5*\xsize-2)}
\integer{a2=\cas==2?\sign2*random(2..0.5*\xsize-1)}
\integer{a3=\cas==2?-\sign2*random(2..0.5*\xsize-1)}
\integer{a4=\cas==2?random(0.5*\xsize+2..\xsize)}
\integer{b1=\cas==2?random(-0.5*\ysize+1..0.5*\ysize-1)}
\integer{b4=\cas==2?\b1+ random(-1..1)}
\integer{b3=\cas==2?\b1+\sign1*random(2..0.5*\ysize-1)}
\integer{b2=\cas==2?\b1-\sign1*random(2..0.5*\ysize-1)}
\function{f=\cas==2?\b1*(x-\a2)*(x-\a3)*(x-\a4)/((\a1-\a2)*(\a1-\a3)*(\a1-\a4)) + \b2*(x-\a1)*(x-\a3)*(x-\a4)/((\a2-\a1)*(\a2-\a3)*(\a2-\a4))+ \b3*(x-\a1)*(x-\a2)*(x-\a4)/((\a3-\a2)*(\a3-\a1)*(\a3-\a4))+ \b4*(x-\a1)*(x-\a2)*(x-\a3)/((\a4-\a2)*(\a4-\a1)*(\a4-\a3))}
/** cas 3 : Cf parabole et Cg sa tangente proche d'un chge var **/
\integer{a1=\cas==3?-\xsize+1}
\integer{a3=\cas==3?\sign1*random(2..0.5*\xsize)}
\integer{a4=\cas==3?\xsize-1}
\rational{b1=\cas==3?\sign1*0.5*random(0..\ysize-1)}
\rational{b4=\cas==3?-\sign1*0.5*random(0..\ysize-1)}
\rational{b3=\cas==3?\b1+(\b4-\b1)*(\a3-\a1)/(\a4-\a1)+
\sign2*0.5*random(2..5)
}
/** cas 4 : Cf parabole et Cg sa tangente proche d'un chge var **/
\integer{a1=\cas==4?-\xsize+1}
\integer{a3=\cas==4?\sign1*random(2..0.5*\xsize)}
\integer{a4=\cas==4?\xsize-1}
\rational{b1=\cas==4?\sign1*random(0.5\ysize-1..\ysize-1)}
\rational{b4=\cas==4?\sign1*random(0.5\ysize-1..\ysize-1)}
\rational{b3=\cas==4?-\sign1*random(0.5\ysize-1..1)}
\function{f=\cas>2? \b3*(x-\a1)*(x-\a4)/((\a3-\a4)*(\a3-\a1))+ \b1*(x-\a3)*(x-\a4)/((\a1-\a3)*(\a1-\a4)) + \b4*(x-\a1)*(x-\a3)/((\a4-\a3)*(\a4-\a1))}
\text{ensdef=\cas>1?\(\,\RR)}
\function{df=diff(\f,x)}
\real{m=evaluate(\df,x=\a3)}
\function{g=\m*(x-\a3)+ \b3}
/** préparation du graphique **/
\integer{ysize=\cas==3?\xsize+1}
/** si b3 non entier, afficher une val décimale de b3 pour yA **/
\real{yA=cas<3?\b3:pari(floor(100*\b3)/100)}
\real{labelf=evaluate(\f, x=-\xsize+0.5)}
\real{absm=pari(abs(\m))}
\integer{deltax=\absm<1?2:1}
\integer{x3=\a3+\deltax}
\real{h=evaluate(\g, x=\x3)}
\integer{change=(\h<-\xsize+1 or \h>\xsize-1 or \x3<-\xsize+1 or
\x3>\xsize-1)?1:0}
\integer{x3=\change==1?\a3-\deltax}
\real{y3=evaluate(\g, x=\x3)}
\real{y3=pari(floor(100*\y3)/100)}
\text{labelA=text red, \a3, \b3 +0.5, medium, A
linewidth 3
point \a3, \b3,red}
\text{labelB=text red, \x3, \y3 +0.5, medium, B
linewidth 3
point \x3, \y3,red}
/** val. de pente m arrondie au dixieme **/
\real{m0=(\y3-\yA)/(\x3-\a3)}
\real{m1=pari(floor(10*\m0)/10)}
\real{m2=pari(ceil(10*\m0)/10)}
\real{mi=(\m1+\m2)/2}
\real{rep=\m0<\mi?\m1:\m2}
\text{ticks=text black, -1, -20, small, -20
text black, -1, -15, small, -15
text black, -1,-10,small, -10
text black, -1,-5,small, -5
text black, -1, 5,small, 5
text black, -1, 10, small, 10
text black, -1, 15, small, 15
text black, -1, 20, small, 20
text black, -10, -0.2, small, -10
text black, -5, -0.2, small, -5
text black, 5, -0.2,small, 5
text black, 10, -0.2,small, 10
linewidth 3
point 1,0, black
point 0,1, black
point -10,0, black
point -5,0, black
point 5, 0, black
point 10, 0, black
point 0, -20, black
point 0, -15, black
point 0, -10, black
point 0, -5, black
point 0, 5, black
point 0, 10, black
point 0, 15, black
point 0, 20, black
}
\text{enonce=wims(replace internal CCCC by C in \name_enonce)}
\text{feed2=wims(replace internal MMMM by \m0 in \name_feed2)}
