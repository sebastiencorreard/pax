  <div>\name_question[1] \J,
  \name_question[2] \embed{reply2}.</div>
  </div>
}
\answer{\name_answer I }{\rep1 ; \name_choix}{type=radio}
\answer{\name_answer J }{\rep2 ; \name_choix}{type=radio}
