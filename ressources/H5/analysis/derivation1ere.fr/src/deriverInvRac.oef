<label for="reply1">\(f'(x)\)</label> = \embed{reply1 , 40}</div>
</div>
\if{\casf==1}
{<div class="wims_instruction">
  \name_write "sqrt(a x + b)" \name_for \(sqrt(a x + b)\).
  </div>}
}
\answer{name_answer \(f'(x)\)}{\F}{type=formal}
