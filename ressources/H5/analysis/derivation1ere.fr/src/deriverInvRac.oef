\title{Dériver une composée suivie d'une fonction de référence}
\title_en{Dériver une composée suivie d'une fonction de référence}
\text{name_answer=Dérivée}
\text{name_write=Écrire}
\text{name_for=pour}
\text{name_feed=L'expression de la dérivée est}
\text{name_hint1=La fonction racine \( sqrt(u)\) est dérivable sur tout intervalle \(I\)
  où la fonction \(u\) est strictement positive et dérivable.
  <br> Alors on a sur l'intervalle \(I\) : \( ( \sqrt{u} )' = \frac{u' }{2 \sqrt{u}}\).
  <br> La fonction \(u\) et sa racine carrée \( sqrt(u)\) ont donc les mêmes
  sens de variation sur \(I\).}
\text{name_hint2=La fonction inverse \( 1 / u \) est dérivable sur tout intervalle \(I\)
  où la fonction \(u\) ne s'annule pas et est dérivable.
  <br> Alors on a sur l'intervalle \(I\) : \( ( 1 / u )' = - \frac{u' }{u^2} \).
  <br> La fonction \(u\) et son inverse \( 1/u\) ont donc des sens
  de variation contraires sur \(I\).}
\text{name_enonce=La fonction \(f\) définie par, est dérivable sur}
\text{name_onehas=On a}
\if{\lang=en}{
\text{name_answer=Derivative}
\text{name_write=Write}
\text{name_for=for}
\text{name_feed=The derivative is}
\text{name_hint1=The function square root \( sqrt(u)) is differentiable at any interval \(I\)
  where the function \(u\) is strictly positive and differentiable.
  <br> Then on the interval \(I) : \( ( \sqrt{u} )' = \frac{u' }{2 \sqrt{u}}\).
  <br> The function \(u\) and its square root \( sqrt(u)) ont donc les mêmes
  sens de variation sur \(I\).}
\text{name_hint2=La fonction inverse \( 1 / u \) is differentiable at any interval \(I)
  where the function \(u\) does not vanish and is differentiable.
  <br>Then one has on the interval \(I\) : \( ( 1 / u )' = - \frac{u' }{u^2} \).
  <br>The function \(u\) and its inverse \( 1/u\) ont donc des sens
  de variation contraires sur \(I\).}
\text{name_enonce=The function \(f\) defined by, is differentiable in}
\text{name_onehas=One has}
}
\format {html}
\integer{a=random(1..8)*random(1,-1)}
\integer{b=random(1..8)*random(1,-1)}
\integer{b2= (\b)^2}
\integer{k=random(1..8)*random(1,-1)}
\function{us= \a*x+\b, (\a*x+\b)^2 , x^2 + \b2 }
\integer{casu=random(1..3)}
\function{u = item(\casu , \us)}
\rational{zero=-\b/\a }
\function{fs= \k*sqrt(\u), \k/(\u)}
\integer{casf=random(1..2)}
\function{f=item(\casf,\fs)}
\function{F=diff(\f,x)}
/** bornes de l'intervalle où (a x + b) est strict. positif **/
\text{borne1= \a>0?\zero:-\infty}
\text{borne2= \a>0?+\infty:\zero}
/** ens de dérivabilité **/
\text{ensdef=\(\,\RR\) }
\text{ensdef=\casf==1 and \casu==1? \( &#93; \borne1 ; \borne2 &#91; \) }
\text{ensdef=(\casf==2 and \casu!=3) or (\casf==1 and \casu==2)? \(\RR \setminus \{\zero\}\) }
