 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Dérivée
val8=Écrire
val9=pour
val10=L'expression de la dérivée est
val11=La fonction racine \( sqrt(u)\) est dérivable sur tout intervalle \(I\)	  où la fonction \(u\) est strictement positive et dérivable.	  <br> Alors on a sur l'intervalle \(I\) : \( ( \sqrt{u} )' = \frac{u' }{2 \sqrt{u}}\).	  <br> La fonction \(u\) et sa racine carrée \( sqrt(u)\) ont donc les mêmes	  sens de variation sur \(I\).
val12=La fonction inverse \( 1 / u \) est dérivable sur tout intervalle \(I\)	  où la fonction \(u\) ne s'annule pas et est dérivable.	  <br> Alors on a sur l'intervalle \(I\) : \( ( 1 / u )' = - \frac{u' }{u^2} \).	  <br> La fonction \(u\) et son inverse \( 1/u\) ont donc des sens	  de variation contraires sur \(I\).
val13=La fonction \(f\) définie par, est dérivable sur
val14=On a
!if $val6=en 
val7=Derivative
val8=Write
val9=for
val10=The derivative is
val11=The function square root \( sqrt(u)) is differentiable at any interval \(I\)	  where the function \(u\) is strictly positive and differentiable.	  <br> Then on the interval \(I) : \( ( \sqrt{u} )' = \frac{u' }{2 \sqrt{u}}\).	  <br> The function \(u\) and its square root \( sqrt(u)) ont donc les mêmes	  sens de variation sur \(I\).
val12=La fonction inverse \( 1 / u \) is differentiable at any interval \(I)	  where the function \(u\) does not vanish and is differentiable.	  <br>Then one has on the interval \(I\) : \( ( 1 / u )' = - \frac{u' }{u^2} \).	  <br>The function \(u\) and its inverse \( 1/u\) ont donc des sens	  de variation contraires sur \(I\).
val13=The function \(f\) defined by, is differentiable in
val14=One has
!endif
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
val17=$[rint(($val16)^2)]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val18=$[rint($(tmp0)*$(tmp1))]
val19=!rawmath $val15*x+$val16, ($val15*x+$val16)^2 , x^2 + $val17 
tmp0=!randint 1, 3

val20=$[rint($(tmp0))]
tmp0=!item $val20 of  $val19

val21=!rawmath $(tmp0)
t_=!rawmath -$val16/$val15 
val22=!exec pari print($t_)
val23=!rawmath $val18*sqrt($val21), $val18/($val21)
tmp0=!randint 1, 2

val24=$[rint($(tmp0))]
tmp0=!item $val24 of $val23

val25=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val25,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val26=!rawmath $(tmp0)

!ifval $val15>0
val27=$val22
!else
val27=-\infty
!endif

!ifval $val15>0
val28=+\infty
!else
val28=$val22
!endif
val29=\(\,\RR\) 

!ifval $val24==1 and $val20==1
val29= \( &#93; $val27 ; $val28 &#91; \) 
!endif

!ifval ($val24==2 and $val20!=3) or ($val24==1 and $val20==2)
val29= \(\RR \setminus \{$val22\}\) 
!endif
replytype1=formal
replyname1=name_answer \(f'(x)\)
replygood1=$val26
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  <p>$val11</p> <p>$val12</p> 


!goto stat

!exit

