tmp=!nonempty items $val17,	$val13 *x^4 + $val14*x^3+ $val15*x^2 + $val16*x + $val17,	$val13*x^3+ $(tmp0) + $val17,	 $val13*x^2 + $val16*x+ $val17,	 $val13*x^2 + $val17,	 $val13*x + $val17,	$val18*x^3+ $(tmp1) + $val21,	$val18*x^2 + $val20*x + $val21,	$val18*x^2 + $val21,	$val18*x+$val21,	$val22*x^3+ $(tmp2) + $val25,	$val22*x^2 + $val24*x + $val25,	$val22*x^2 + $val25,	$val22*x + $val25	

