!set title=Valeurs remarquables 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items sin,cos

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items 1/6,1/4,1/3

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!randint -4, 4

val8=$(tmp0)
tmp=!translate ";': to $     $ in ($val7+$val8/2)*pi

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
tmp=!translate ";': to $     $ in $val6 ($val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
replytype1=algexp
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Que vaut 
!insmath $val6($val9)
$() ?  
!read oef/embed.phtml reply1,10 
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9
embedcnt=1
