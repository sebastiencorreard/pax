!set title=Relations de base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
tmp0=!randint 1, 4

val7=$(tmp0)
!if $val7=1 
tmp=!nonempty items cos(-$val6),sin(pi/2-$val6),sin($val6+pi/2),cos(2*pi+$val6),cos(2*pi-$val6)

tmp0=!randitem $tmp
val8=$(tmp0)
!endif
!if $val7=2 
tmp=!nonempty items cos(pi/2-$val6),sin(pi-$val6),sin(2*pi+$val6),cos($val6-pi/2)

tmp0=!randitem $tmp
val8=$(tmp0)
!endif
!if $val7=3 
tmp=!nonempty items cos(pi-$val6),cos($val6+pi),cos($val6-pi)

tmp0=!randitem $tmp
val8=$(tmp0)
!endif
!if $val7=4 
tmp=!nonempty items sin(-$val6),cos($val6+pi/2),sin($val6+pi),sin(2*pi-$val6)

tmp0=!randitem $tmp
val8=$(tmp0)
!endif
replytype1=radio
replyname1=
replygood1=$val7;\(cos($val6)\),\(sin($val6)\),\(-cos($val6)\),\(-sin($val6)\)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Pour tout 
!insmath $val6\in\RR
$(), à quoi est égal 
!insmath $val8
$() ?	<ul>	  <li> 
!read oef/embed.phtml reply1,1 
$()</li></br>	  <li> 
!read oef/embed.phtml reply1,2 
$()</li></br>	  <li> 
!read oef/embed.phtml reply1,3 
$()</li></br>	  <li> 
!read oef/embed.phtml reply1,4 
$()</li>	</ul>  	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=4
