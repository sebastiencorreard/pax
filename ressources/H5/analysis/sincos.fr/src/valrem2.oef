\title{Valeurs remarquables 2}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\text{expr=randitem(sin,cos)}

\text{a=randitem(1/6,1/4,1/3)}
\text{b=randint(-4..4)}
\text{c=simplify((\a+\b/2)*pi)}

\text{rep=simplify(\expr (\c))}

\statement{Que vaut \(\expr(\c)\) ? \embed{reply1,10}}

\answer{}{\rep}{type=algexp}
