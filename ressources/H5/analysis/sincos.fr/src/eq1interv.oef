\title{Equation 1 sur un intervalle}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}


\text{a=randint(-8..8)/2}
\rational{b=\a+randint(5..8)/2}
\text{api=simplify(\a*pi)}
\text{bpi=simplify(\b*pi)}

\text{cas=randint(1,2)}

\if{\cas=1}{
\text{c=randitem(1/6,1/4,1/3,1/2,2/3,3/4,5/6)}
\text{sol1=\c}
\rational{sol2=2-\c}
\text{d=simplify(cos(\c*pi))}
\text{eq=cos(x)=\d}
}{
\text{c=randitem(0,1/6,1/4,1/3,-1/6,-1/4,-1/3)}
\text{sol1=\c}
\rational{sol2=1-\c}
\text{d=simplify(sin(\c*pi))}
\text{eq=sin(x)=\d}
}

\text{sol=}
\for{i = -3 to 4}{
\rational{val=\sol1+2*\i}
\if{(\val>=\a) and (\val<=\b)}{\text{sol=wims(append item \val*pi to \sol)}}
\rational{val=\sol2+2*\i}
\if{(\val>=\a) and (\val<=\b)}{\text{sol=wims(append item \val*pi to \sol)}}
}

\statement{<div>Déterminer les solutions de l'équation \(\eq\) sur l'intervalle [\(\api,\bpi\)] ?</div></br>

<div>L'ensemble des solutions est \embed{reply1,30}</div>
}

\answer{}{\sol}{type=fset}
