\title{Relations de base}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\text{x=x}

\text{cas=randint(1..4)}
\if{\cas=1}{
\text{expr=randitem(cos(-\x),sin(pi/2-\x),sin(\x+pi/2),cos(2*pi+\x),cos(2*pi-\x))}
}
\if{\cas=2}{
\text{expr=randitem(cos(pi/2-\x),sin(pi-\x),sin(2*pi+\x),cos(\x-pi/2))}
}
\if{\cas=3}{
\text{expr=randitem(cos(pi-\x),cos(\x+pi),cos(\x-pi))}
}
\if{\cas=4}{
\text{expr=randitem(sin(-\x),cos(\x+pi/2),sin(\x+pi),sin(2*pi-\x))}
}

\statement{Pour tout \(\x\in\RR\), à quoi est égal \(\expr\) ?
<ul>
  <li>\embed{reply1,1}</li></br>
  <li>\embed{reply1,2}</li></br>
  <li>\embed{reply1,3}</li></br>
  <li>\embed{reply1,4}</li>
</ul>  
}

\answer{}{\cas;\(cos(\x)\),\(sin(\x)\),\(-cos(\x)\),\(-sin(\x)\)}{type=radio}
