\title{Terme général}
\language{fr}
\range{-5..5}
\author{Cyrille, Douriez}
\email{cyrille.douriee@ac-amiens.fr}
\keywords{sequence,geometric_sequence,arithmetic_sequence}
\computeanswer{no}
\format{html}
\precision{100}
\observation{En fonction de la configuration de l'exercice sur le module, il peut y avoir :
<ul><li> Que des suites arithmétiques</li>
<li>Que des suites géométriques</li>
<li>Aléatoirement l'un ou l'autre</li>
</ul>}
%%%%%%%%%%% MB : introduction du confparm2 : suite arithm (A) ou géom (G) ou les deux (AG)
\text{confparm2= items(\confparm2)=0 ? random(A,G,AG):\confparm2} %%% necessaire car non présent dans les premières versions
\if{\confparm2 == A}{\integer{type=1}}
\if{\confparm2 == G}{\integer{type=2}}
\if{\confparm2 == AG}{\integer{type=random(1,2)}}
%%%%%%%%%%%%%%%%%
\integer{U0=randint(1..10)*randint(-1,1)}
\integer{R=randint(2..10)}
\function{tg=(\type=1)? \U0+n*\R:\U0*\R^n}

\statement {Soit \((u_n)) la suite \if{\type=1}{arithmétique}{géométrique} de raison  \(\R) et de premier terme \(u_0=\U0).
<div class="wims_question">Donner le terme général de la suite \((u_n)) (autrement dit, exprimer \(u_n) en fonction de \(n)) :
</div>
Pour tout entier naturel \(n), <label for="reply1">\(u_n=)</label>\embed{r1,10}

<div class="wims_instruction">Ecrire * pour la multiplication et ^ pour la puissance.</div>}

\answer{}{\tg}{function}
