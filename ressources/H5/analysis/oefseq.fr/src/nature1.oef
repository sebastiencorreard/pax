\title{Nature de la suite ? (relation)}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\format{html}
\computeanswer(yes)
\keywords{sequence,geometric_sequence,arithmetic_sequence}
%%%%%MB
\observation{En fonction de la configuration de l'exercice sur le module, le vocabulaire utilisé est :
<ul><li>uniquement celui des suites arithmétiques</li>
<li>uniquement celui des suites géométriques</li>
<li>ou les deux</li>
</ul>
Rq : notion sur les augmentations, diminutions en pourcentage nécessaire pour les suites géométriques.}
%%% fin MB

##Suites géométriques à termes positifs \confparm1=P ou suite à termes réels : \confparm1=R
\text{confparm1= items(\confparm1)=0 ? randitem(P,R):\confparm1}
\if{\confparm1 issametext R}{
\integer{s=random(-1,1)}
}
{\integer{s=1}
}

%%%%%%%%%%%%%%%% MB : introduction du confparm2 : suite arithm (A) ou géom (G) ou les deux (AG)
\text{confparm2= items(\confparm2)=0 ? random(A,G,AG):\confparm2} %%% necessaire car non présent dans les premières versions
\if{\confparm2 == A}{
\text{proprep=est arithmétique,n'est pas arithmétique, je n'en sais rien}}
\if{\confparm2 == G}{
\text{proprep=n'est pas géométrique,est géométrique, je n'en sais rien}}
\if{\confparm2 == AG}{
\text{proprep=est arithmétique,est géométrique, je n'en sais rien}}
%%%%%%%%%%%%%%%%%%%%
\integer{type=random(1,1,2,2,3,3,4,5,6)}
##Paramètres et termes de la suite##
\integer{R=randint(1..20)}
\integer{q=randint(2..10)*\s}
\integer{p=randint(2..80)}

\integer{q=\type<4 ? \q:abs(\q)}
\text{relation=additionnant \R,soustrayant \R,multipliant par \q,divisant par \q,augmentant de \p%,diminuant de \p%}
\integer{rep=(\type<=2)? 1:2}
\rational{R1=1/\q}
\real{R2=1+(11-2*\type)*\p/100}
\text{raison=\R,-\R,\q,\R1,\R2,\R2}
\integer{Rabs=abs(\R)}

%%% gestion des réponses %%%
\if{\confparm2 == A}{
\if{\type=1 or \type=2}{
\text{temp=reply 1
reply 2}}
{\text{temp=reply 1}}
}


\if{\confparm2 == G}{
\if{\type<3}{
\text{temp=reply 1}}
{\text{temp=reply 1
reply 2}}
}

\if{\confparm2 == AG}{
\text{temp=reply 1
reply 2}}
\steps{\temp
}
%%%% Nom Nature
\text{nature=\type<3?arithmétique:géométrique}




\statement{On passe d'un terme de la suite \((U_n)) au suivant en \relation[\type].
<div class="wims_question">
\if{\step=1}{
Quelle est la <label for="reply1">nature de la suite</label> \((U_n)) ?
La suite \((U_n)) \embed{r1} }
\if{\step>1}{ La suite est \nature de <label for="reply2">raison</label> \embed{r2,3}.}
</div>}

\answer{}{\rep;\proprep}{type=menu}
\answer{}{\raison[\type]}{type=numeric}

\solution{On passe d'un terme au suivant en \if{\type<3}{\if{\type=1}{additionnant}{soustrayant}
\Rabs \if{\confparm2==A or \confparm2==AG}{donc la suite est arithmétique de raison \raison[\type].}{ donc la suite n'est pas géométrique}}
{
\if{\type=3}{multipliant par \q}
\if{\type=4}{divisant par \q c'est à dire en multipliant par \(\frac{1}{\q})}
\if{\type=5}{multipliant par \(1+\frac{\p}{100}=\raison[\type])}
\if{\type=6}{multipliant par \(1-\frac{\p}{100}=\raison[\type])}
\if{\confparm2==G or \confparm2==AG}{ donc la suite est géométrique de 
raison \raison[\type]}{donc la suite n'est pas arithmétique.}
}
}
