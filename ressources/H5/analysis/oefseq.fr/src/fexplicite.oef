\title{Suites arithmétiques ou géométriques : formule explicite}
\language{fr}
\author{Paul,Byache}
\email{paul@byache.fr}
\computeanswer{yes}
\format{html}
\precision{1000}
\keywords{sequence,geometric_sequence,arithmetic_sequence}
%%%%%%%%%%% MB :
\observation{En fonction de la configuration de l'exercice sur 
le module, l'exercice contiendra :
Que des suites arithmétiques, que celui des suites géométriques ou aléatoirement l'un ou l'autre.
}
%%%%%%%%%%% MB : introduction du confparm2 : suite arithm (A) ou géom (G) ou les deux (AG)
\text{confparm2= items(\confparm2)=0 ? random(A,G,AG):\confparm2} %%% necessaire car non présent dans les premières versions

\integer{u0=random(-1,1)*randint(1..10)}
\integer{n1=randint(10..20)}

%%%%%% ag : 1-> arith, 2 : géom
\if{\confparm2==A}{\integer{ag=1}}
\if{\confparm2==G}{\integer{ag=2}}
\if{\confparm2==AG}{\integer{ag=random(1,2)}}

%%%%% q est la raison
\if{\ag=1}{
\integer{q=random(-1,1)*randint(10..50)}
\text{type=arithmétique}
\integer{sol=\u0+\q*\n1}
\text{typerep=formal}
\text{solcalc=\u0+\q*\n1}
}{
\real{q=random(0.5,2,3,10,0.1,0.25)}
\text{type=géométrique}
\text{typerep=numeric}
\real{sol=\u0*\q^\n1}
\text{solcalc=\u0*\q^\n1}
}
%%%%% solution MB %%%%%
\text{qsol=\q<0?(\q):\q}
\if{\ag=1}{\text{solfeedback=Comme la suite est arithmétique, on sait que \(u_\n1=u_0+\n1 \times r\), où \(r\) est la raison.}}
\if{\ag=2}{\text{solfeedback=Comme la suite est géométrique, on sait que \(u_\n1=u_0 \times q^\n1\), où \(q\) est la raison.}}
\text{solfeedback=\solfeedback <br> Il suffit alors de remplacer par les valeurs.}
%%%%%%%%%%%%%%%%%%%%%%
\statement{<p>On considère une suite <b>\type</b> telle que \(u_{0}=\u0) et de raison \(\q).</p> 
<p>On peut calculer la valeur de\(u_{\n1}) directement à partir de la valeur de \(u_{0})</p>
<div class="wims_question">
<p>Saisir le calcul à effectuer : \embed{reply 1,16}</p>
<p>Ce qui donne : \(u_{\n1}=) \embed{reply 2,16}</p>
</div>
}

\answer{Calcul}{\solcalc}{type=algexp}
\answer{Valeur}{\sol}{type=\typerep}

\feedback{\sc_reply1 <1}{<div class="feedback">\solfeedback</div>}
