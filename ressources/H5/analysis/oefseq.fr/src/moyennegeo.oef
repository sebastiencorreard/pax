\title{Moyenne géométrique}
\language{fr}
\author{Cyrille, Douriez}
\email{wims.irem@u-picardiefr}
\keywords{sequence,geometric_sequence}
\integer{a=random(1..20)}
\integer{b=\a+random(1..20)}
\integer{p=(\a*\b)}
\integer{juste=(round(sqrt(\p))=sqrt(\p))? 1:0}
\text{m=sqrt(\p)}
\integer{mj=sqrt(\p)}

\statement{
<div class="wims_question">Calculer la moyenne géométrique de \(\a) et \(\b).</div>
La <label for="reply1">moyenne géométrique</label> est \embed{r1,4}.
<div class="wims_instruction">Pour \(\sqrt{}), écrire sqrt( )</div> }


\answer{}{\m}{type=formal}

\solution{La moyenne géométrique de \(\a) et \(\b) est égale à \(\sqrt{\a \times \b}=\sqrt{\p})\if{\juste=1}{\({}=\mj)}.}
