\title{Suite récurrente linéaire d'ordre 2}
\author{Cyrille,Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{sequence}

##U_(n+2)=a U_(n)+bU_n+c ##
\integer{a=randint(2..5)}
\integer{b=randint(2..7)*randint(-1,1)}

\integer{U0=randint(1..5)}
\integer{U1=randint(-5..9)}
\real{U2=\a*\U1+\b*\U0}
\real{U3=\a*\U2+\b*\U1}
\integer{n0=randitem(0,0,0,1)}
\integer{n1=\n0+1}
\integer{n2=\n1+1}
\integer{n3=\n2+1}
\text{u1=(\U1>0)? \U1:(\U1)}
\text{u2=(\U2>0)? \U2:(\U2)}

\statement{<p>
Soit \((U_{n})) la suite définie par \(U_\n0=\U0), \(U_\n1=\U1) et pour tout entier naturel
\if{\n0=0}{\(n)}{non nul \(n)} :</p>
<div class="wimscenter">\(U_{n+2}=\a U_{n+1})\if{\b>0}{\({}+{})}\(\b U_n)</div>
<div class=wims_question>Calculez les valeurs des termes suivants :
<ul><li><label for = "reply1">\(U_\n2=)</label>\embed{r1,4}</li>
<li><label for = "reply2">\(U_\n3=)</label>\embed{r2,4}</li>
</ul>
</div>}

\answer{}{\U2}{type=formal}
\answer{}{\U3}{type=formal}

\solution{\(U_\n2=\a U_{\n1})\if{\b>0}{\({}+{})}\(\b U_\n0=\a \times \u1)\if{\b>0}{\({}+{})}\(\b \times \U0=\U2)
<br> et \(U_\n3=\a U_{\n2})\if{\b>0}{\({}+{})}\(\b U_\n1=\a \times \u2)\if{\b>0}{\({}+{})}\(\b \times \u1=\U3).
}
