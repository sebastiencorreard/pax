\title{Suite géométrique (calcul 2) }
\language{fr}
\range{-5..5}
\author{Florence, Barreddine}
\keywords{sequence,geometric_sequence}

\computeanswer{no}
\format{html}
\precision{10000}

##Suites géométriques à termes positifs \confparm1=P ou suite à termes réels : \confparm1=R
\text{confparm1= items(\confparm1)=0 ? randitem(P,R):\confparm1}
\if{\confparm1 issametext R}{
\integer{s1=random(-1,1)}
\integer{s2=random(-1,1)}}
{\integer{s1=1}
\integer{s2=1}}

\integer{n=randint(1..20)}
\integer{q=\s1*random(2..4)}
\text{q1=(\q<0) ? (\q):\q}
\integer{u_n=\s2*random(2..6)}
\integer{k=random(1..3)}

\integer{i1=\n-1}
\integer{i2=\n+1}
\text{i=\i1,\i2}
\real{rep2=evalue(\u_n*\q)}
\rational{rep1=evalue(\u_n/\q)}
\text{rep=\rep1,\rep2}
\text{choix=wims(shuffle(1,2))}

\statement{<p>
Soit \( (u_n) ) la suite géométrique de raison \(q=\q) et telle que \(u_{\n}=\u_n).
</p>
<div class=wims_question>Calculer les termes \(u_\i[\choix[1]])
et \(u_\i[\choix[2]]) de cette suite.
<ul class="wims_nopuce"><li>
<label for="reply1">  \(u_{\i[\choix[1]]}) </label>=\embed{r1,3}
</li><li>
<label for="reply1">  \(u_{\i[\choix[2]]}) </label>= \embed{r2,3}
  </li>
</ul>
</div>
}

\reply{}{\rep[\choix[1]]}{type=numeric}
\reply{}{\rep[\choix[2]]}{type=numeric}

\solution{La raison de la suite géométrique est \(q=\q).
<br>\(u_{\i2}=u_{\n} \times q=\u_n \times \q1=\rep2),
<br>\(u_{\i1}=\frac{u_{\n}}{q}=\frac{\u_n}{\q}=\rep1).}
