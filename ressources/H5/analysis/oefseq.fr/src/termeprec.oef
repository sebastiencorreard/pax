\title{Terme précédent}
\author{Cyrille,Douriez}
\email{wims.irem@u-picardie.fr}
\keywords{sequence}
\observation{En fonction de la configuration de l'exercice sur le module, il peut y avoir :
<ul><li>Que des suites arithmétiques</li>
<li>Que des suites géométriques</li>
<li>Sinon, que des suites du type \(U_(n+1)=a U_(n)+b) ou des suites arithmétiques, ou des suites géométriques.</li>
</ul>}
%%%%%%%%%%% MB : introduction du confparm2 : suite arithm (A) ou géom (G) ou les deux (AG)
\text{confparm2= items(\confparm2)=0 ? random(A,G,AG):\confparm2} %%% necessaire car non présent dans les premières versions
\if{\confparm2 == A}{\integer{type=1}}
\if{\confparm2 == G}{\integer{type=2}}
\if{\confparm2 == AG}{\integer{type=random(0,1,2)}}
##U_(n+1)=a U_(n)+b##
\integer{a=\type=1?1:randint(2..8)*randint(-1,1)}
\integer{b=\type=2?0:randint(2..10)*randint(-1,1)}
%%%%%%% fin MB
\integer{U0=randint(-8..10)}
\integer{U1=\a*\U0+\b}
%%%% pour le corrigé%%%
\integer{c=\U1-\b}
\text{asol=\a=1 ? :\a}


\statement{<p>
Soit \((U_{n})) la suite vérifiant \(U_1=\U1) et pour tout entier naturel n :
</p><div class="wimscenter">
\if{\a=1}{\(U_{n+1}= U_{n})}{\(U_{n+1}=\a U_{n})}
\if{\b=0}{}{\if{\b>0}{\({}+{})}\(\b)}.</div>
<div class=wims_question>Déterminer la valeur de \(U_0) :
<br><label for="reply1">\(U_0=)</label>\embed{r1,4}.</div>}

\answer{U0}{\U0}{type=formal}

\solution{Grâce à la relation de récurrence donnée, on sait que :
\if{\a=1}{\(U_{n+1}= U_{n})}{\(U_{n+1}=\a U_{n})}
\if{\b=0}{}{\if{\b>0}{\({}+{})}\(\b)}
<br>&hArr; \(\U1=\asol U_0)\if{\b=0}{}{\if{\b>0}{\({}+{})}\(\b)}
<i>car \(U_1=\U1)</i>
<br>&hArr; \(\c=\asol U_0)
<br>&hArr; \(U_0=\U0).
}
