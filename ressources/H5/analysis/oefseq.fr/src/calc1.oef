\title{Calcul d'un terme (calculatrice)}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{sequence}
\computeanswer{yes}

\integer{n=randint(4..8)}
\integer{U0=randint(-20..20)}
\integer{n0=randitem(0,0,0,1,1)}
\integer{prter=\n0+1}
\integer{a=randint(2..5)*randint(-1,1)}
\integer{b=randint(1..10)*randint(-1,1)}
\function{U=maxima(\a*x+\b)}
\text{U=texmath(\U)}
\text{U=wims(replace internal x by U_n in \U)}
\integer{rep=\U0}
\text{listeterme=\U0}
\for{J=\prter to \n}{
\integer{rep=\a*(\rep)+\b}
\text{listeterme=wims(append item \rep to \listeterme)}}
\integer{babs=abs(\b)}
\text{listeterme=wims(replace internal , by <br> in \listeterme)}

\statement{\((U_n)) est la suite définie par \(U_\n0=\U0) et pour tout entier naturel n :
\(U_{n+1}=\U).
<div class="wims_question">A l'aide de la calculatrice, calculer \(U_\n).</div>}
\hint{Utiliser la touche Ans (ou Rep selon le modèle).}

\answer{\(U_\n)}{\rep}{type=formal}

\solution{On effectue : \U0, Entrée, \a*Ans\if{\b>0}{+\babs}{\b}, Entrée, Entrée, ...
pour obtenir les termes successivement. On peut également utiliser un tableau de valeurs.
<br> <b>L'affichage que l'on obtient est :</b>
<br>\listeterme
}
