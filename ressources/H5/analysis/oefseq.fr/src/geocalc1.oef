\title{Suite géométrique (calcul 1)}
\language{fr}
\range{-5..5}
\author{Florence, Barreddine}
\email{florence.barredine@ac-amiens.fr}
\keywords{sequence,geometric_sequence}

\computeanswer{no}
\format{html}
\precision{10000}

##Suites géométriques à termes positifs \confparm1=P ou suite à termes réels : \confparm1=R
\text{confparm1= items(\confparm1)=0 ? randitem(P,R):\confparm1}

\if{\confparm1 issametext R}{
\integer{s1=random(-1,1)}
\integer{s2=random(-1,1)}}
{\integer{s1=1}
\integer{s2=1}}

\integer{q=\s1*random(2..4)}
\text{q1=(\q<0) ? (\q):\q}
\integer{u0=\s2*random(2..10)}

\integer{k=random(1..3)}

\real{rep1=evalue(\u0*\q)}
\real{rep2=evalue(\rep1*\q)}
\real{rep3=evalue(\rep2*\q)}
\statement{
<p>
Soit \( (u_n) ) la suite géométrique de terme initial \( u_0 = \u0) et de raison \(q=\q).
</p>
<div class=wims_question>Calculer les termes \(u_1), \(u_2) et \(u_3) de cette suite.
<ul class="wims_nopuce"><li>
  <label for="reply1">\(u_1)</label> =\embed{r1,3}
</li><li>
 <label for="reply2"> \(u_2)</label> = \embed{r2,3}
</li><li>
<label for="reply3">  \(u_3)</label> = \embed{r3,3}
</li></ul>
</div>
}

\reply{\(u_1)}{\rep1}{numeric}
\reply{\(u_2)}{\rep2}{numeric}
\reply{\(u_3)}{\rep3}{numeric}

\solution{
La raison de la suite géométrique est \(q=\q).
<br>\(u_1=u_0 \times q=\u0 \times \q1=\rep1),
<br>\(u_2=u_1 \times q=\rep1 \times \q1=\rep2)
<br>et \(u_3=u_2 \times q=\rep2 \times \q1=\rep3).}
