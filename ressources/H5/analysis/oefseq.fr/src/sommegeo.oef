\title{Somme des premiers termes d'une suite géométrique}
\author{Cyrille, Douriez}
\email{wims.irem@u-picardie.fr}
\keywords{sequence,geometric_sequence}

\integer{U0=randint(1..6)*randitem(-1,1,1)}
\integer{q=randint(2..5)}
\integer{n=randint(4..10)}
\integer{n1=\n+1}
\rational{S=(\U0)(1-\q^(\n+1))/(1-\q)}

\statement{On considère la suite \((u_n)) géométrique de raison \(\q) et de premier terme \(u_0=\U0).
<div class="wims_question">Calculer la <label for="reply1">somme</label> \(u_0+u_1+\cdots+u_{\n}) :</div>
\(\displaystyle \sum_{k=0}^{\n} u_k=)\embed{r1,5}}

\answer{}{\S}{type=formal}

\solution{Si on note \(q) la raison de la suite, il y a \n1 termes à ajouter, donc :
\(u_0+u_1+\cdots+u_{\n}=u_0 \times \frac{1-q^{\n1}}{1-q}=\U0 \times \frac{1-\q^{\n1}}{1-\q}=\S).}
