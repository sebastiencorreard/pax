\title{Moyenne arithmétique}
\language{fr}
\keywords{sequence,arithmetic_sequence}
\author{Cyrille, Douriez}
\email{wims.irem@u-picardiefr}
\integer{a=random(-10..20)}
\integer{b=\a+random(1..20)}
\rational{m=(\a+\b)/2}

\statement{
Calculer la moyenne arithmétique de \(\a) et \(\b).
<div class="wims_question">La <label for ="reply1">moyenne arithmétique</label> est \embed{r1,4}.</div>}

\answer{}{\m}{type=formal}

\solution{La moyenne arithmétique de \(\a) et \(\b) est égale à \if{\b>=0}{\(\frac{\a+\b}{2}=\m)}{\(\frac{\a+(\b)}{2}=\m)}.}
