\title{Suite arithmétique (calcul 1) }
\language{fr}
\range{-5..5}
\author{Florence, Barreddine}
\email{florence.barredine@ac-amiens.fr}
\keywords{sequence,arithmetic_sequence}

\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=random(4..10)}
\integer{r=random(-1,1)*random(2..6)}
\integer{ra=abs(\r)}
\integer{u_i=random(-1,1)*random(2..6)}

\integer{type=randitem(1,-1)}
\integer{i=\n+\type}
\integer{j=\i+\type}
\integer{k=\j+\type}

\real{rep1=\u_i+\r*\type}
\real{rep2=\rep1+\r*\type}
\real{rep3=\rep2+\r*\type}
\statement{
<p>
Soit \( (u_n) ) la suite arithmétique   de raison \(r=\r) et telle que \(u_\n=\u_i).
</p>
<div class="wims_question">Calculer les termes \(u_\i), \(u_\j) et \(u_\k) de cette suite.
<ul><li>
  <label for="reply1">\(u_\i)</label> =\embed{r1,3}
</li><li>
  <label for="reply2">\(u_\j)</label> = \embed{r2,3}
</li><li>
  <label for="reply3">\(u_\k)</label> = \embed{r3,3}
</li></ul>
</div>
}

\reply{\(u_\i)}{\rep1}{numeric}
\reply{\(u_\j)}{\rep2}{numeric}
\reply{\(u_\k)}{\rep3}{numeric}

\solution{La raison de la suite arithmétique est \(r=\r).
<br> \if{\type=-1}{On sait que \(u_\n=u_\i+r) donc \(u_\i=u_\n-r).
<br> Dans notre cas :
\if{\r>0}{
 \(u_\i=u_\n-\r)
<br>\(u_\i=u_\n-\r=\u_i-\r=\rep1),
<br>\(u_\j=u_\i-\r=\rep1-\r=\rep2)
<br>et\(u_\k=u_\j-\r=\rep2-\r=\rep3).
}
{\(u_\i=u_\n-(\r)=u_\n+\ra)
<br>\(u_\i=u_\n+\ra=\u_i+\ra=\rep1),
<br>\(u_\j=u_\i+\ra=\rep1+\ra=\rep2)
<br>et \(u_\k=u_\j+\ra=\rep2+\ra=\rep3).}
}{On sait que \(u_\i=u_\n+r).
<br> Dans notre cas :
\if{\r>0}{
 \(u_\i=u_\n+\r)
<br>\(u_\i=u_\n+\r=\u_i+\r=\rep1),
<br>\(u_\j=u_\i+\r=\rep1+\r=\rep2)
<br>et\(u_\k=u_\j+\r=\rep2+\r=\rep3).
}
{\(u_\i=u_\n+(\r)=u_\n-\ra)
<br>\(u_\i=u_\n-\ra=\u_i-\ra=\rep1),
<br>\(u_\j=u_\i-\ra=\rep1-\ra=\rep2)
<br>et \(u_\k=u_\j-\ra=\rep2-\ra=\rep3).}


}}
