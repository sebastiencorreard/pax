\title{Suite arithmétique (calcul 2) }
\language{fr}
\range{-5..5}
\author{Cyrille,Douriez}##d'après une xercice de Florence Barredine##
\keywords{sequence,arithmetic_sequence}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(1..20)}
\integer{r=randint(2..10)*randitem(-1,1,1)}
\integer{u_n=randint(-10..20)}
\text{r1=(\r>0)?\r:(\r)}

\integer{i1=\n-1}
\integer{i2=\n+1}
\text{i=\i1,\i2}
\integer{rep2=\u_n+\r}
\integer{rep1=\u_n-\r}
\text{rep=\rep1,\rep2}
\text{choix=wims(shuffle(1,2))}

\statement{<p>
Soit \( (u_n) ) la suite arithmétique de raison \(r=\r) et telle que \(u_{\n}=\u_n)
</p>
<div class=wims_question>Calculer les termes \(u_\i[\choix[1]]) et \(u_\i[\choix[2]]) de cette suite.
<ul><li>
  <label for ="reply1">\(u_{\i[\choix[1]]})</label> =\embed{r1,3}
</li><li>
 <label for ="reply2"> \(u_{\i[\choix[2]]})</label> = \embed{r2,3}
</ul>
</div>
}

\reply{}{\rep[\choix[1]]}{type=numeric}
\reply{}{\rep[\choix[2]]}{type=numeric}

\solution{La raison de la suite arithmétique est \(r=\r).
<br>\(u_{\i2}=u_{\n} +r=\u_n +\r1=\rep2),
<br>\(u_{\i1}=u_{\n} -r=\u_n -\r1=\rep1).}
