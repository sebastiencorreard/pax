\title{Suite géométrique (spectateurs)}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\precision{1000}
\integer{p=randint(2..17)}
\real{p1=\p/100}
\real{q=1+\p1}
\integer{m=randint(0..15)}
\integer{U0=6000+200*\m}
\integer{annee=randitem(2016,2017,2018,2019)}
\integer{anneep1=\annee+1}
\integer{anneep3=\annee+3}
\integer{a=randint(3..7)}
\integer{Ua=\annee+\a}
\real{rep1=\U0*(1+\p/100)}
\real{rep2=round(\rep1*(1+\p/100))}
\real{rep7=round(\U0*\q^\a)}

\text{etap=r1
r2
r3,r4,r5
r6,r7}
\steps{\etap}
\statement{On admet que le nombre de spectateurs d'un festival augmente chaque année de \(\p&#8239;\% \). En \(\annee), il y a eu \(\U0) spectateurs. <br/>
On note \(U_n \) le nombre de spectateurs en \(\annee+n\) (par exemple \(U_3 \) est le nombre de spectateurs en \(\annee+3=\anneep3\) ).<br class="spacer"/>
\if{\step=1}{<div class=wims_question>1&#41; Quel est le nombre de spectateurs en \(\anneep1) ?
\embed{r1,4}</div>}
\if{\step=2 and \sc_reply1=0}{<span class="oef_indbad">Erreur : </span>\(U_1=)<span class="oef_indgood">\rep1</span>
(et non pas \reply1) donc \rep1 spectateurs en \anneep1.
<div class=wims_question> 2&#41; Calculer \(U_2 = \) \embed{r2,4}</div>}

\if{\step=2 and \sc_reply1=1}{<span class="oef_indgood"> Correct : </span>\(U_1=)<span class="oef_indgood">\rep1 </span> donc \rep1 spectateurs en \anneep1. <div class=wims_question>2&#41; Calculer \(U_2 =\) \embed{r2,4}</div>}
\if{\step=3}{<div class=wims_question>3&#41; Démontrer que la suite \((U_n) \) est une suite géométrique dont on donnera la raison et le premier terme.<br>
Pour tout entier naturel n, on a :<br>
\(U_{n+1} = U_n \times \) \embed{r3,2}.<br>
\((U_n) \) est donc la suite géométrique de raison \embed{r4,2} et de premier terme \(U_0 =\)\embed{r5,2}.</div>}
\if{\step=4}{\((U_n) \) est la suite géométrique de raison \(\q) et de premier terme \(U_0 = \U0 \).<br>
<div class=wims_question>4&#41; Combien y aura-t-il de spectateurs en \(\Ua) ? \(U \)<sub>\embed{r6,1}</sub>=\embed{r7,6}</div>}
<div class="wims_instruction">On arrondira les termes de la suite à l'unité. Pour la raison, donner la valeur exacte (mettre un point à la place de la virgule). </div>
}
\answer{}{\rep1}{type=numeric}{option=nonstop}
\answer{}{\rep2}{type=formal}{option=nonstop}
\answer{}{\q}{type=numeric}{option=nonstop}
\answer{}{\q}{type=numeric}{option=nonstop}
\answer{}{\U0}{type=numeric}{option=nonstop}
\answer{}{\a}{type=numeric}{option=nonstop}
\answer{}{\rep7}{type=formal}{option=nonstop}
