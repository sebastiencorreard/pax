\title{Suite géométrique (calcul 3)}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\keywords{sequence,geometric_sequence}
\computeanswer{yes}

##Suites géométriques à termes positifs \confparm1=P ou suite à termes réels : \confparm1=R
\text{confparm1= items(\confparm1)=0 ? randitem(P,R):\confparm1}
\if{\confparm1 issametext R}{
\integer{s=random(-1,1)}
}
{\integer{s=1}}

\integer{n0=randint(0..4)}
\integer{ecart=randint(2..5)}
\integer{n=\n0+\ecart}
\integer{U0=randint(1,2,3,4,5)}
\integer{q=randitem(2,3,4,5,10)*\s}
\text{q1=\q<0 ? (\q):\q}
\integer{U=\U0*(\q)^(\n-\n0)}

\statement{\(u) est la suite géométrique de raison \q telle que \(u_{\n0}=\U0).
<div class="wims_question">Calculer \(u_\n) :
<br> <label for="reply1">\(u_\n) </label>=\embed{r1,8}</div>}

\answer{\(u_\n)}{\U}{type=formal}

\solution{On passe d'un terme au suivant en  multipliant par \q donc :
<br>\(u_\n=u_\n0)\for{J=1 to \ecart}{\({}\times \q1)}\(=\U0 \times \q1^\ecart=\U).
}
