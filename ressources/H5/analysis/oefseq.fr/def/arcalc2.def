!set title=Suite arithmétique (calcul 2) 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
keywords=sequence,arithmetic_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 10

tmp=!nonempty items -1,1,1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 20

val8=$[rint($(tmp0))]

!ifval ($val7>0)
val9=$val7
!else
val9=($val7)
!endif
val10=$[rint($val6-1)]
val11=$[rint($val6+1)]
val12=$val10,$val11
val13=$[rint($val8+$val7)]
val14=$[rint($val8-$val7)]
val15=$val14,$val13
tmp0=!shuffle 1,2

tmp1=$(tmp0)

val16=$(tmp1)
replytype1=numeric
replyname1=
replygood1=$[$(val15[$(val16[1])])]
replytype2=numeric
replyname2=
replygood2=$[$(val15[$(val16[2])])]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soit 
!insmath  (u_n) 
$() la suite arithmétique de raison 
!insmath r=$val7
$() et telle que 
!insmath u_{$val6}=$val8
$()	</p>	<div class=wims_question>Calculer les termes 
!insmath u_$(val12[$(val16[1])])
$() et 
!insmath u_$(val12[$(val16[2])])
$() de cette suite.	<ul><li>	  <label for ="reply1">
!insmath u_{$(val12[$(val16[1])])}
$()</label> = 
!read oef/embed.phtml r1,3 
$()	</li><li>	 <label for ="reply2"> 
!insmath u_{$(val12[$(val16[2])])}
$()</label> =  
!read oef/embed.phtml r2,3 
$()	</ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La raison de la suite arithmétique est 
!insmath r=$val7
$().	<br>
!insmath u_{$val11}=u_{$val6} +r=$val8 +$val9=$val13
$(),	<br>
!insmath u_{$val10}=u_{$val6} -r=$val8 -$val9=$val14
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,14,16
embedcnt=2
