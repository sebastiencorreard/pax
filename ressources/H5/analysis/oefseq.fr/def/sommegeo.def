!set title=Somme des premiers termes d'une suite géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=wims.irem@u-picardie.fr
keywords=sequence,geometric_sequence

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 6

tmp=!nonempty items -1,1,1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]
tmp0=!randint 4, 10

val8=$[rint($(tmp0))]
val9=$[rint($val8+1)]
t_=!rawmath ($val6)(1-$val7^($val8+1))/(1-$val7)
val10=!exec pari print($t_)
replytype1=formal
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la suite 
!insmath (u_n)
$() géométrique de raison 
!insmath $val7
$() et de premier terme 
!insmath u_0=$val6
$().	<div class="wims_question">Calculer la <label for="reply1">somme</label> 
!insmath u_0+u_1+\cdots+u_{$val8}
$() :</div>	
!insmath \displaystyle \sum_{k=0}^{$val8} u_k=
$() 
!read oef/embed.phtml r1,5 
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Si on note 
!insmath q
$() la raison de la suite, il y a $val9 termes à ajouter, donc :	
!insmath u_0+u_1+\cdots+u_{$val8}=u_0 \times \frac{1-q^{$val9}}{1-q}=$val6 \times \frac{1-$val7^{$val9}}{1-$val7}=$val10
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=1
