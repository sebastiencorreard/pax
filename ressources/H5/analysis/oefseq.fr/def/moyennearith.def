!set title=Moyenne arithmétique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=sequence,arithmetic_sequence
author=Cyrille, Douriez
email=wims.irem@u-picardiefr
language=fr

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 20

val6=$[rint($(tmp0))]
tmp0=!randint 1, 20

val7=$[rint($val6+$(tmp0))]
t_=!rawmath ($val6+$val7)/2
val8=!exec pari print($t_)
replytype1=formal
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer la moyenne arithmétique de 
!insmath $val6
$() et 
!insmath $val7
$().	<div class="wims_question">La <label for ="reply1">moyenne arithmétique</label> est  
!read oef/embed.phtml r1,4 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La moyenne arithmétique de 
!insmath $val6
$() et 
!insmath $val7
$() est égale à 
!if $val7>=0 
$()
!insmath \frac{$val6+$val7}{2}=$val8
$() 
!else
$() 
!insmath \frac{$val6+($val7)}{2}=$val8
$() 
!endif
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
