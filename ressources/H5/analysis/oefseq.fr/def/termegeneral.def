!set title=Terme général
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriee@ac-amiens.fr
keywords=sequence,geometric_sequence,arithmetic_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefobservation=En fonction de la configuration de l'exercice sur le module, il peut y avoir : <ul><li> Que des suites arithmétiques</li> <li>Que des suites géométriques</li> <li>Aléatoirement l'un ou l'autre</li> </ul>

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val3


!ifval $(tmp0)=0 
tmp1=!randitem A,G,AG

val3= $(tmp1)
!else
val3=$val3
!endif
!if $val3 == A 
val6=$[rint(1)]
!endif
!if $val3 == G 
val6=$[rint(2)]
!endif
!if $val3 == AG 
tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]

!ifval ($val6=1)
val9=!rawmath  $val7+n*$val8
!else
val9=!rawmath $val7*$val8^n
!endif
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath (u_n)
$() la suite 
!if $val6=1 
$()arithmétique 
!else
$() géométrique 
!endif
$() de raison  
!insmath $val8
$() et de premier terme 
!insmath u_0=$val7
$().	<div class="wims_question">Donner le terme général de la suite 
!insmath (u_n)
$() (autrement dit, exprimer 
!insmath u_n
$() en fonction de 
!insmath n
$()) :	</div>	Pour tout entier naturel 
!insmath n
$(), <label for="reply1">
!insmath u_n=
$()</label> 
!read oef/embed.phtml r1,10 
$()		<div class="wims_instruction">Ecrire * pour la multiplication et ^ pour la puissance.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
