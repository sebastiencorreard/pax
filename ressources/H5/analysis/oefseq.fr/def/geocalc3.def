!set title=Suite géométrique (calcul 3)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=sequence,geometric_sequence
computeanswer=yes

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val2


!ifval $(tmp0)=0 
tmp=!nonempty items P,R

tmp1=!randitem $tmp
val2= $(tmp1)
!else
val2=$val2
!endif
!if $val2 issametext R 
tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
!else
val6=$[rint(1)]
!endif
tmp0=!randint 0, 4

val7=$[rint($(tmp0))]
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
val9=$[rint($val7+$val8)]
tmp0=!randitem 1,2,3,4,5

val10=$[rint($(tmp0))]
tmp=!nonempty items 2,3,4,5,10

tmp0=!randitem $tmp
val11=$[rint($(tmp0)*$val6)]

!ifval $val11<0 
val12= ($val11)
!else
val12=$val11
!endif
val13=$[rint($val10*($val11)^($val9-$val7))]
replytype1=formal
replyname1=\(u_$val9)
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!insmath u
$() est la suite géométrique de raison $val11 telle que 
!insmath u_{$val7}=$val10
$().	<div class="wims_question">Calculer 
!insmath u_$val9
$() :	<br> <label for="reply1">
!insmath u_$val9
$() </label>= 
!read oef/embed.phtml r1,8 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()On passe d'un terme au suivant en  multipliant par $val11 donc :	<br>
!insmath u_$val9=u_$val7
$() 
!for m_J=1 to $val8 
$()
!insmath {}\times $val12
$() 
!next
$()
!insmath =$val10 \times $val12^$val8=$val13
$().	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12,13
embedcnt=1
