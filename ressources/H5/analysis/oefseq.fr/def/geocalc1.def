!set title=Suite géométrique (calcul 1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Florence, Barreddine
email=florence.barredine@ac-amiens.fr
keywords=sequence,geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val2


!ifval $(tmp0)=0 
tmp=!nonempty items P,R

tmp1=!randitem $tmp
val2= $(tmp1)
!else
val2=$val2
!endif
!if $val2 issametext R 
tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
tmp0=!randitem -1,1

val7=$[rint($(tmp0))]
!else
val6=$[rint(1)]
val7=$[rint(1)]
!endif
tmp0=!randint 2, 4

val8=$[rint($val6*$(tmp0))]

!ifval ($val8<0) 
val9= ($val8)
!else
val9=$val8
!endif
tmp0=!randint 2, 10

val10=$[rint($val7*$(tmp0))]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=$val10*$val8

val12=$[$(tmp0)]
tmp0=$val12*$val8

val13=$[$(tmp0)]
tmp0=$val13*$val8

val14=$[$(tmp0)]
replyname1=\(u_1)
replygood1=$val12
replyname2=\(u_2)
replygood2=$val13
replyname3=\(u_3)
replygood3=$val14
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	Soit 
!insmath  (u_n) 
$() la suite géométrique de terme initial 
!insmath  u_0 = $val10
$() et de raison 
!insmath q=$val8
$().	</p>	<div class=wims_question>Calculer les termes 
!insmath u_1
$(), 
!insmath u_2
$() et 
!insmath u_3
$() de cette suite.	<ul class="wims_nopuce"><li>	  <label for="reply1">
!insmath u_1
$()</label> = 
!read oef/embed.phtml r1,3 
$()	</li><li>	 <label for="reply2"> 
!insmath u_2
$()</label> =  
!read oef/embed.phtml r2,3 
$()	</li><li>	<label for="reply3">  
!insmath u_3
$()</label> =  
!read oef/embed.phtml r3,3 
$()	</li></ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	La raison de la suite géométrique est 
!insmath q=$val8
$().	<br>
!insmath u_1=u_0 \times q=$val10 \times $val9=$val12
$(),	<br>
!insmath u_2=u_1 \times q=$val12 \times $val9=$val13
$()	<br>et 
!insmath u_3=u_2 \times q=$val13 \times $val9=$val14
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,12,13,14
embedcnt=3
