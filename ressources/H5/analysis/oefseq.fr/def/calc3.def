!set title=Suite récurrente linéaire d'ordre 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=sequence

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
tmp0=!randint 2, 7

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 9

val9=$[rint($(tmp0))]
val10=$[$val6*$val9+$val7*$val8]
val11=$[$val6*$val10+$val7*$val9]
tmp=!nonempty items 0,0,0,1

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
val13=$[rint($val12+1)]
val14=$[rint($val13+1)]
val15=$[rint($val14+1)]

!ifval ($val9>0)
val16= $val9
!else
val16=($val9)
!endif

!ifval ($val10>0)
val17= $val10
!else
val17=($val10)
!endif
replytype1=formal
replyname1=
replygood1=$val10
replytype2=formal
replyname2=
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soit 
!insmath (U_{n})
$() la suite définie par 
!insmath U_$val12=$val8
$(), 
!insmath U_$val13=$val9
$() et pour tout entier naturel	
!if $val12=0 
$()
!insmath n
$() 
!else
$() non nul 
!insmath n
$() 
!endif
$() :</p>	<div class="wimscenter">
!insmath U_{n+2}=$val6 U_{n+1}
$()
!if $val7>0 
$()
!insmath {}+{}
$() 
!endif
$()
!insmath $val7 U_n
$()</div>	<div class=wims_question>Calculez les valeurs des termes suivants :	<ul><li><label for = "reply1">
!insmath U_$val14=
$()</label> 
!read oef/embed.phtml r1,4 
$()</li>	<li><label for = "reply2">
!insmath U_$val15=
$()</label> 
!read oef/embed.phtml r2,4 
$()</li>	</ul>	</div>
$()
!exit

