:solution
$()
!insmath U_$val14=$val6 U_{$val13}
$()
!if $val7>0 
$()
!insmath {}+{}
$() 
!endif
$()
!insmath $val7 U_$val12=$val6 \times $val16
$()
!if $val7>0 
$()
!insmath {}+{}
$() 
!endif
$()
!insmath $val7 \times $val8=$val10
$()	<br> et 
!insmath U_$val15=$val6 U_{$val14}
$()
!if $val7>0 
$()
!insmath {}+{}
$() 
!endif
$()
!insmath $val7 U_$val13=$val6 \times $val17
$()
!if $val7>0 
$()
!insmath {}+{}
$() 
!endif
$()
!insmath $val7 \times $val16=$val11
$().	
$()
