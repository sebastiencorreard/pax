keywords=sequence
oefobservation=En fonction de la configuration de l'exercice sur le module, il peut y avoir : <ul><li>Que des suites arithmétiques</li> <li>Que des suites géométriques</li> <li>Sinon, que des suites du type \(U_(n+1)=a U_(n)+b) ou des suites arithmétiques, ou des suites géométriques.</li> </ul>

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
