 !exit
!endif

tmp0=!itemcnt $val3


!ifval $(tmp0)=0 
tmp1=!randitem A,G,AG

val3= $(tmp1)
!else
val3=$val3
!endif
!if $val3 == A 
val6=$[rint(1)]
!endif
!if $val3 == G 
val6=$[rint(2)]
!endif
!if $val3 == AG 
tmp0=!randitem 0,1,2

val6=$[rint($(tmp0))]
!endif

!ifval $val6=1
val7=$[rint(1)]
!else
tmp0=!randint 2, 8

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
!endif

!ifval $val6=2
val8=$[rint(0)]
!else
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
!endif
tmp0=!randint -8, 10

val9=$[rint($(tmp0))]
val10=$[rint($val7*$val9+$val8)]
val11=$[rint($val10-$val8)]

!ifval $val7=1 
val12= 
!else
val12=$val7
!endif
