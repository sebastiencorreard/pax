!set title=Suite géométrique (spectateurs)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no
precision=1000

ansorder=r,r,r,r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=7
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 17

val6=$[rint($(tmp0))]
val7=$[$val6/100]
val8=$[1+$val7]
tmp0=!randint 0, 15

val9=$[rint($(tmp0))]
val10=$[rint(6000+200*$val9)]
tmp=!nonempty items 2016,2017,2018,2019

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[rint($val11+1)]
val13=$[rint($val11+3)]
tmp0=!randint 3, 7

val14=$[rint($(tmp0))]
val15=$[rint($val11+$val14)]
val16=$[$val10*(1+$val6/100)]
val17=$[round($val16*(1+$val6/100))]
val18=$[round($val10*$val8^$val14)]
val19=r1	r2	r3,r4,r5	r6,r7
oefsteps=$val19 
nextstep=!nosubst $val19 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=nonstop 
replyname1=
replygood1=$[$val16]
replytype2=formal
replyoption2=nonstop 
replyname2=
replygood2=$val17
replytype3=numeric
replyoption3=nonstop 
replyname3=
replygood3=$[$val8]
replytype4=numeric
replyoption4=nonstop 
replyname4=
replygood4=$[$val8]
replytype5=numeric
replyoption5=nonstop 
replyname5=
replygood5=$[$val10]
replytype6=numeric
replyoption6=nonstop 
replyname6=
replygood6=$[$val14]
replytype7=formal
replyoption7=nonstop 
replyname7=
replygood7=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On admet que le nombre de spectateurs d'un festival augmente chaque année de 
!insmath $val6&#8239;\% 
$(). En 
!insmath $val11
$(), il y a eu 
!insmath $val10
$() spectateurs. <br/>	On note 
!insmath U_n 
$() le nombre de spectateurs en 
!insmath $val11+n
$() (par exemple 
!insmath U_3 
$() est le nombre de spectateurs en 
!insmath $val11+3=$val13
$() ).<br class="spacer"/>	
!if $m_step=1 
$()<div class=wims_question>1&#41; Quel est le nombre de spectateurs en 
!insmath $val12
$() ?	 
!read oef/embed.phtml r1,4 
$()</div> 
!endif
$()	
!if $m_step=2 and $m_sc_reply1=0 
$()<span class="oef_indbad">Erreur : </span>
!insmath U_1=
$()<span class="oef_indgood">$val16</span>	(et non pas $m_reply1) donc $val16 spectateurs en $val12.	<div class=wims_question> 2&#41; Calculer 
!insmath U_2 = 
$()  
!read oef/embed.phtml r2,4 
$()</div> 
!endif
$()		
!if $m_step=2 and $m_sc_reply1=1 
$()<span class="oef_indgood"> Correct : </span>
!insmath U_1=
$()<span class="oef_indgood">$val16 </span> donc $val16 spectateurs en $val12. <div class=wims_question>2&#41; Calculer 
!insmath U_2 =
$()  
!read oef/embed.phtml r2,4 
$()</div> 
!endif
$()	
!if $m_step=3 
$()<div class=wims_question>3&#41; Démontrer que la suite 
!insmath (U_n) 
$() est une suite géométrique dont on donnera la raison et le premier terme.<br>	Pour tout entier naturel n, on a :<br>	
!insmath U_{n+1} = U_n \times 
$()  
!read oef/embed.phtml r3,2 
$().<br>	
!insmath (U_n) 
$() est donc la suite géométrique de raison  
!read oef/embed.phtml r4,2 
$() et de premier terme 
!insmath U_0 =
$() 
!read oef/embed.phtml r5,2 
$().</div> 
!endif
$()	
!if $m_step=4 
$()
!insmath (U_n) 
$() est la suite géométrique de raison 
!insmath $val8
$() et de premier terme 
!insmath U_0 = $val10 
$().<br>	<div class=wims_question>4&#41; Combien y aura-t-il de spectateurs en 
!insmath $val15
$() ? 
!insmath U 
$()<sub> 
!read oef/embed.phtml r6,1 
$()</sub>= 
!read oef/embed.phtml r7,6 
$()</div> 
!endif
$()	<div class="wims_instruction">On arrondira les termes de la suite à l'unité. Pour la raison, donner la valeur exacte (mettre un point à la place de la virgule). </div>	
$()
