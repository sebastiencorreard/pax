!set title=Suite géométrique (calcul 2) 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Florence, Barreddine
keywords=sequence,geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val2


!ifval $(tmp0)=0 
tmp=!nonempty items P,R

tmp1=!randitem $tmp
val2= $(tmp1)
!else
val2=$val2
!endif
!if $val2 issametext R 
tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
tmp0=!randitem -1,1

val7=$[rint($(tmp0))]
!else
val6=$[rint(1)]
val7=$[rint(1)]
!endif
tmp0=!randint 1, 20

val8=$[rint($(tmp0))]
tmp0=!randint 2, 4

val9=$[rint($val6*$(tmp0))]

!ifval ($val9<0) 
val10= ($val9)
!else
val10=$val9
!endif
tmp0=!randint 2, 6

val11=$[rint($val7*$(tmp0))]
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
val13=$[rint($val8-1)]
val14=$[rint($val8+1)]
val15=$val13,$val14
tmp0=$val11*$val9

val16=$[$(tmp0)]
tmp0=$val11/$val9

t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
val18=$val17,$val16
tmp0=!shuffle 1,2

tmp1=$(tmp0)

val19=$(tmp1)
replytype1=numeric
replyname1=
replygood1=$[$(val18[$(val19[1])])]
replytype2=numeric
replyname2=
replygood2=$[$(val18[$(val19[2])])]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soit 
!insmath  (u_n) 
$() la suite géométrique de raison 
!insmath q=$val9
$() et telle que 
!insmath u_{$val8}=$val11
$().	</p>	<div class=wims_question>Calculer les termes 
!insmath u_$(val15[$(val19[1])])
$()	et 
!insmath u_$(val15[$(val19[2])])
$() de cette suite.	<ul class="wims_nopuce"><li>	<label for="reply1">  
!insmath u_{$(val15[$(val19[1])])}
$() </label>= 
!read oef/embed.phtml r1,3 
$()	</li><li>	<label for="reply1">  
!insmath u_{$(val15[$(val19[2])])}
$() </label>=  
!read oef/embed.phtml r2,3 
$()	  </li>	</ul>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La raison de la suite géométrique est 
!insmath q=$val9
$().	<br>
!insmath u_{$val14}=u_{$val8} \times q=$val11 \times $val10=$val16
$(),	<br>
!insmath u_{$val13}=\frac{u_{$val8}}{q}=\frac{$val11}{$val9}=$val17
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11,13,14,15,16,17,19
embedcnt=2
