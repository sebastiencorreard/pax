!set title=Nature de la suite ? (relation)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=sequence,geometric_sequence,arithmetic_sequence
oefobservation=En fonction de la configuration de l'exercice sur le module, le vocabulaire utilisé est : <ul><li>uniquement celui des suites arithmétiques</li> <li>uniquement celui des suites géométriques</li> <li>ou les deux</li> </ul> Rq : notion sur les augmentations, diminutions en pourcentage nécessaire pour les suites géométriques.

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val2


!ifval $(tmp0)=0 
tmp=!nonempty items P,R

tmp1=!randitem $tmp
val2= $(tmp1)
!else
val2=$val2
!endif
!if $val2 issametext R 
tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
!else
val6=$[rint(1)]
!endif
tmp0=!itemcnt $val3


!ifval $(tmp0)=0 
tmp1=!randitem A,G,AG

val3= $(tmp1)
!else
val3=$val3
!endif
!if $val3 == A 
val7=est arithmétique,n'est pas arithmétique, je n'en sais rien
!endif
!if $val3 == G 
val7=n'est pas géométrique,est géométrique, je n'en sais rien
!endif
!if $val3 == AG 
val7=est arithmétique,est géométrique, je n'en sais rien
!endif
tmp0=!randitem 1,1,2,2,3,3,4,5,6

val8=$[rint($(tmp0))]
tmp0=!randint 1, 20

val9=$[rint($(tmp0))]
tmp0=!randint 2, 10

val10=$[rint($(tmp0)*$val6)]
tmp0=!randint 2, 80

val11=$[rint($(tmp0))]

!ifval $val8<4 
val10=$[rint( $val10)]
!else
val10=$[rint(abs($val10))]
!endif
val12=additionnant $val9,soustrayant $val9,multipliant par $val10,divisant par $val10,augmentant de $val11%,diminuant de $val11%

!ifval ($val8<=2)
val13=$[rint( 1)]
!else
val13=$[rint(2)]
!endif
t_=!rawmath 1/$val10
val14=!exec pari print($t_)
val15=$[1+(11-2*$val8)*$val11/100]
val16=$val9,-$val9,$val10,$val14,$val15,$val15
val17=$[rint(abs($val9))]
!if $val3 == A 
!if $val8=1 or $val8=2 
val18=reply 1	reply 2
!else
val18=reply 1
!endif
!endif
!if $val3 == G 
!if $val8<3 
val18=reply 1
!else
val18=reply 1	reply 2
!endif
!endif
!if $val3 == AG 
val18=reply 1	reply 2
!endif

!ifval $val8<3
val19=arithmétique
!else
val19=géométrique
!endif
oefsteps=$val18 
nextstep=!nosubst $val18 
!readproc oef/steps.proc
replytype1=menu
replyname1=
replygood1=$val13;$val7
replytype2=numeric
replyname2=
replygood2=$[$(val16[$val8])]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On passe d'un terme de la suite 
!insmath (U_n)
$() au suivant en $(val12[$val8]).	<div class="wims_question">	
!if $m_step=1 
$()	Quelle est la <label for="reply1">nature de la suite</label> 
!insmath (U_n)
$() ?	La suite 
!insmath (U_n)
$()  
!read oef/embed.phtml r1 
$()  
!endif
$()	
!if $m_step>1 
$() La suite est $val19 de <label for="reply2">raison</label>  
!read oef/embed.phtml r2,3 
$(). 
!endif
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()On passe d'un terme au suivant en 
!if $val8<3 
$()
!if $val8=1 
$()additionnant 
!else
$() soustrayant 
!endif
$()	$val17 
!if $val3==A or $val3==AG 
$()donc la suite est arithmétique de raison $(val16[$val8]). 
!else
$()  donc la suite n'est pas géométrique 
!endif
$() 
!else
$()	 	
!if $val8=3 
$()multipliant par $val10 
!endif
$()	
!if $val8=4 
$()divisant par $val10 c'est à dire en multipliant par 
!insmath \frac{1}{$val10}
$() 
!endif
$()	
!if $val8=5 
$()multipliant par 
!insmath 1+\frac{$val11}{100}=$(val16[$val8])
$() 
!endif
$()	
!if $val8=6 
$()multipliant par 
!insmath 1-\frac{$val11}{100}=$(val16[$val8])
$() 
!endif
$()	
!if $val3==G or $val3==AG 
$() donc la suite est géométrique de 	raison $(val16[$val8]) 
!else
$() donc la suite n'est pas arithmétique. 
!endif
$()	 
!endif
$()	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=3,8,10,11,12,16,17,19
embedcnt=2
