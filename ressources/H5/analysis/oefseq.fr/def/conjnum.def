!insmath u
$() semble  
!read oef/embed.phtml r1 
$().</p> 
!endif
$()	
!if $m_step>1 
$()	<p>La suite est $val19 de <label for="reply2">raison</label>  
!read oef/embed.phtml r2,3 
$().</p> 
!endif
$()	</div>
$()
!exit

