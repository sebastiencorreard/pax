replyname1=\(U_$val10)
replygood1=$val13
replytype2=formal
replyname2=\(U_$val11)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

