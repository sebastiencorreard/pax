tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint($val9+1)]
val11=$[rint($val10+1)]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
val13=$[rint($val6*$val12+$val7*$val9+$val8)]
val14=$[rint($val6*$val13+$val7*$val10+$val8)]
