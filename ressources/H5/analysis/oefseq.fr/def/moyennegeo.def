!set title=Moyenne géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=wims.irem@u-picardiefr
keywords=sequence,geometric_sequence
language=fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

val6=$[rint($(tmp0))]
tmp0=!randint 1, 20

val7=$[rint($val6+$(tmp0))]
val8=$[rint(($val6*$val7))]

!ifval (round(sqrt($val8))=sqrt($val8))
val9=$[rint( 1)]
!else
val9=$[rint(0)]
!endif
val10=sqrt($val8)
val11=$[rint(sqrt($val8))]
replytype1=formal
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">Calculer la moyenne géométrique de 
!insmath $val6
$() et 
!insmath $val7
$().</div>	La <label for="reply1">moyenne géométrique</label> est  
!read oef/embed.phtml r1,4 
$().	<div class="wims_instruction">Pour 
!insmath \sqrt{}
$(), écrire sqrt( )</div> 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La moyenne géométrique de 
!insmath $val6
$() et 
!insmath $val7
$() est égale à 
!insmath \sqrt{$val6 \times $val7}=\sqrt{$val8}
$()
!if $val9=1 
$()
!insmath {}=$val11
$() 
!endif
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,11
embedcnt=1
