tmp0=!texmath $val11

val25=$(tmp0)
!endif

!ifval $val14=1
val26=
!else
tmp0=!texmath $val14

val26=$(tmp0)
!endif
t_=!replace internal \( by ( in $val8*x+$val11
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val27=!rawmath $(tmp1)
t_=!replace internal \( by ( in $val14*x+$val17
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val28=!rawmath $(tmp1)
tmp0=!texmath x^2

val29=!rawmath $(tmp0)
tmp0=!texmath $val14*($val8*x+$val11)^2+$val17

val30=!rawmath $(tmp0)
val31=\(\begin{array}{ccccccc}& $val27&&$val29&&$val28&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
val32=\(\begin{array}{ccccccc}& $val29&&$val27&&$val28&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
val33=\(\begin{array}{ccccccc}& $val27&&$val28&&$val29&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
val34=\(\begin{array}{ccccccc}& $val28&&$val29&&$val27&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
val35=\(\begin{array}{ccccccc}& $val29&&$val28&&$val27&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
val36=\(\begin{array}{ccccccc}& $val28&&$val27&&$val29&\\ x & \longmapsto &\cdots &\longmapsto & \cdots & \longmapsto & \cdots\end{array})
