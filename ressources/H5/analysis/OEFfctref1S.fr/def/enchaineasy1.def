tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6 / $val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val8=!exec pari print($t_)
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val9 / $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val11=!exec pari print($t_)
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val12 / $val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp0=!randint 1, 5

val15=$[rint($(tmp0))]
tmp0=!randint 1, 5

val16=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val15 / $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
tmp0=!randitem 1,-1

val18=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val19=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val20=$[rint($(tmp0))]

!ifval $val18=1
val21=
!else
val21=-
!endif

!ifval $val19=1
val22=+
!else
val22=-
!endif

!ifval $val20=1
val23=
!else
val23=-
