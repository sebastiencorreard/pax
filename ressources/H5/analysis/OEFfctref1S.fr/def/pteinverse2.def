!set title=Propriété de la fonction inverse 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=no

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -9, 9

val7=$[rint($(tmp0))]
tmp0=!randint -9, 9

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in 1/($val6*x+$val7)+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val9=$(tmp1)
t_=!rawmath -$val7/$val6
val10=!exec pari print($t_)
val11=$[rint($val8)]
replytype1=numeric
replyname1=abscisse
replygood1=$[$val10]
replytype2=numeric
replyname2=ordonnée
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelles sont les coordonnées du centre de symétrie de l'hyperbole,	courbe représentative de la fonction 
!insmath f
$() définie par	
!insmath f(x)=$val9
$().	<div class="wimscenter">	<label for="reply1">Abscisse du centre:</label> 
!read oef/embed.phtml reply1,4 
$()<br>	<label for="reply2">Ordonnée du centre:</label> 
!read oef/embed.phtml reply2,4 
$()	</div>	
$()
!exit

