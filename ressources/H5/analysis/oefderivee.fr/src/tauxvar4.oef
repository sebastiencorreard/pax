\title{Taux de variation 4}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\integer{choix=randitem(1,2,3,3)}
\integer{a=randint(0..4)}
\integer{b=\a+randint(1..15)}
\text{borne1=\a,\a,a}
\text{borne2=\b,t,b}

\integer{coef=randint(1..10)*randint(-1,1)}
\text{var=(\coef>0)? 2:3}
\text{var=(\choix<=2)? 1:\var}

\text{prop=on ne peut rien dire,elle est strictement croissante,elle est strictement décroissante}

\statement{Le taux de variation d'une fonction \(f) entre \(\borne1[\choix]) et \(\borne2[\choix]) est égal à \(\coef) \if{\choix=2}{pour tout \(t) appartenant à &#91;\(\a) ; \(\b)&#93;}
\if{\choix=3}{pour tous les réels \(a) et \(b) appartenant appartenant à &#91;\(\a) ; \(\b)&#93;}. 
<br/>Que peut-on en déduire sur la variation de la fonction \(f) sur &#91;\(\a) ; \(\b)&#93 ?}

\answer{Conclusion :}{\var;\prop}{type=menu}
