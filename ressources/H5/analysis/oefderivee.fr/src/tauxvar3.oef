\title{Taux de variation 3}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\integer{deg=randitem(1,2,2)}
\integer{a2=(\deg=2)? randitem(1,randint(1..5)*randint(-1,1)):0}
\integer{a1=(\deg=1)? randint(1..10)*randint(-1,1):randint(-8..8)}
\integer{a0=randint(-10..10)}
\function{f=maxima(\a2*x^2+\a1*x+\a0)}
\function{tauxvar=maxima(2*\a2*a+\a2*h+\a1)}
\text{f=texmath(\f)}
##Pour le corrigé##
\text{fa=wims(replace internal x by a in \f)}
\text{fah=wims(replace internal x by (a+h) in \f)}
\function{fah2=maxima(\a1*a+\a1*h+\a0)}
\text{fah2=texmath(\fah2)}
\if{\a1>0}{\text{numdeg2=(\a2=1)? (a^2+2ah+h^2)+\fah2-(\fa) :\a2(a^2+2ah+h^2)+\fah2-(\fa)}}{\text{numdeg2=(\a2=1)? (a^2+2ah+h^2)\fah2-(\fa) :\a2(a^2+2ah+h^2)\fah2-(\fa)}}
\function{num=maxima(2*\a2*a*h+\a2*h^2+\a1*h)}
\text{num=texmath(\num)}
\text{tvar=texmath(\tauxvar)}


\statement{Soit \(f) la fonction définie pour tout réel \(x) par : \(f(x)=\f). Soit \( a) un nombre réel et soit \(h) un nombre réel strictement positif.
<div class="wims_question">Calculer en fonction de \(a) et \(h), le taux de variation de \(f) entre \(a) et \(a+h) .</div>}

\answer{Taux de variation}{\tauxvar}{type=algexp}

\solution{Le taux de variation de \(f) entre \(a) et \(a+h) est 
\(\frac{f(a+h)-f(a)}{a+h-a}=\frac{\fah-(\fa)}{h})<br/>
\if{\deg=2}{\(\frac{\numdeg2}{h})}\(=\frac{\num}{h}=\tvar).}
