\title{Dérivée à factoriser (2)}
\language{fr}
\range{-5..5}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\format{html}
\precision{10000}

<!-- Cet exercice propose de calcule la dérivée d'une fonction polynomiale de degré 3 
puis de factoriser l'expression  de cette dérivée -->

\integer{x1=randint(2..5)*randint(-1,1,1)}##Solution de f'(x)=0##
\integer{x2=\x1+randint(2..8)*randint(-1,1)}##Solution de f'(x)=0##
\integer{d=randint(-15..15)}##terme constant de f(x)##
\function{f=maxima(expand(x^3/3-(\x1+\x2)/2*x^2+(\x1*\x2)*x+\d))}
\function{df=maxima(diff(\f,x))}##Dérivée de f##
\text{f=texmath(\f)}
\integer{x3=(\x2>\x1)? \x1-randint(2..4):\x1+randint(2..4)}##Valeur non solution de f'(x)=0##
\integer{x4=randitem(\x1+1,\x1-1)}##Valeur non solution de f'(x)=0##
\function{ff=maxima((x-\x1)*(x-\x2))}##Forme factorisée de f(x)##
##Pour le corrigé##
\integer{c=\x1*\x2}
\function{f1=maxima(x-\x1)}

\text{etapes=r1
r2
r3}
\steps{\etapes}

\statement{<p>On pose pour tout nombre réel \(x) : \(f(x)=\f).</p>
\if{\step=1}{1&#41;Calculer \(f'(x)) : \(f'(x)=)\embed{r1,12}}
\if{\step=2}{<p>\if{\sc_reply1=0}{<b><font color="red">Votre réponse est incorrecte :</font></b>}{<b><font color="green">Votre réponse est correcte :</font></b>}
\(f'(x)=\df) \if{\sc_reply1=0}{et pas \reply1}.</p>
<br />2&#41;Laquelle de ces valeurs est une solution de l'équation \(f'(x)=0) ? \embed{r2}}
\if{\step=3}{<p>Pour tout nombre réel \(x), \(f'(x)=\df)</p>
<p>\if{\sc_reply2=0}{<b><font color="red">Votre réponse est incorrecte :</font></b>}{<b><font color="green">Votre réponse est correcte :</font></b>}
\(\x1) est une solution de l'équation \(f'(x)=0) \if{\sc_reply2=0}{et pas \reply2}.</p>
<br />3&#41;Factoriser \(f'(x)) : \(f'(x)=)\embed{r3,8}</p>
<div class="wims_instruction">On écrira \(f'(x)) sous la forme \((x-a)(x-b)) où \(a) et \(b) sont deux nombres réels.</div>}}

\answer{}{\df}{type=function}{option=nonstop}
\answer{}{1;\x1,\x3,\x4}{type=menu}{option=nonstop,sort}
\answer{}{\ff}{type=algexp}

\solution{\(f'(x)) s'obtient en dérivant terme par terme et en utilisant les formules de dérivation.<br />
\(f'(\x1)=0) donc \(\x1) est une racine de \(f') et on peut factoriser \(f'(x)=\df) par \if{\x1>0}{ \(x-\x1)}{\(x-(\x1))}.\(f'(x)=(\f1)(x-k)) &rArr; \(\x1 k=\c) &rArr; \(k=\x2). En développant, on vérifie que \(f'(x)=\ff).}
