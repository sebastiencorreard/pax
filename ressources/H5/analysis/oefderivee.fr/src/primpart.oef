\title{Primitive particulière}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\format{html}

\integer{n3=randitem(1,1,2,4,-1,-2,-4)*randitem(0,0,1)}
\integer{n2=randitem(1,2,3,3,6)*randitem(0,1,-1)}
\integer{n1=randint(1..8)*randitem(-1,1)}
\integer{n0=randint(-15..15)}
\function{f=maxima(\n3*x^3+\n2*x^2+\n1*x+\n0)}
\text{f=texmath(\f)}
\function{G=maxima(\n3*x^4/4+\n2*x^3/3+\n1*x^2/2+\n0*x)}
\integer{x=randint(-3..3)}
\rational{img=wims(evalue(\G,x=\x))}
\rational{imgabs=abs(\img)}
\integer{y=randint(-8..8)}
\rational{k=\y-\img}
\function{F=maxima(\G+\k)}
\text{G=texmath(\G)}
\text{Fsol=texmath(\F)}
\text{enonce=prenant la valeur \(\y) en \(\x),dont l'image de \(\x) est \(\y),vérifiant \(F(\x)=\y)}
\integer{choixenonce=randint(1..3)}

\statement{Donner l'expression de la primitive \(F) sur \(\mathbb{R}) de la fonction \(f) d'expression \(f(x)=\f) et \enonce[\choixenonce].
}
\answer{\(F(x))}{\F}{type=formal}
\solution{Les primitives \(F) sur \(\mathbb{R}) de la fonction \(f) ont pour expression : \(F(x)=\G+k) avec \(k) nombre réel. \(F(\x)=\y) &hArr; \(\img+k=\y) 
\if{\img!=0}{&hArr; \if{\img>0}{\(k=\y-\img=\k)}{\(k=\y+\imgabs=\k)}}. Pour tout réel \(x), \(F(x)=\Fsol).}
