\title{Taux de variation 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\integer{deg=randitem(1,2,2,3)}
\integer{a3=(\deg>=3)? randitem(1,randint(2..3)*randint(-1,1)):0}
\integer{a2=(\deg=2)? randitem(1,randint(2..3)*randint(-1,1)):0}
\integer{a1=randint(1..5)*randint(-1,1)}
\integer{a0=randint(-10..10)}
\function{f=maxima(\a3*x^3+\a2*x^2+\a1*x+\a0)}
\integer{x1=randint(-2..3)}
\integer{y1=evalue(\f,x=\x1)}
\integer{x2=\x1+randint(1..7)}
\integer{y2=evalue(\f,x=\x2)}
\text{f=texmath(\f)}
\rational{tauxvar=(\y2-\y1)/(\x2-\x1)}
##Pour le corrigé##
\text{text1=(\x1>=0)? \x1:(\x1)}
\text{text2=(\y1>=0)? \y1:(\y1)}
\integer{num=\y2-\y1}
\integer{den=\x2-\x1}
\integer{ent=(maxima(floor(\tauxvar))=\tauxvar)? 1:0}

\statement{Soit \() la fonction définie pour tout réel x par : \(f(x)=\f).
<div class="wims_question">Calculer le taux de variation de \(f) entre \(\x1) et \(\x2).</div>}

\answer{Taux de variation}{\tauxvar}{type=formal}

\solution{Le taux de variation de \(f) entre \(\x1) et \(\x2) est 
\(\frac{f(\x2)-f(\x1)}{\x2-\text1}=\frac{\y2-\text2}{\x2-\text1})\if{\ent=1}{\(=\frac{\num}{\den})}
\(=\tauxvar).}
