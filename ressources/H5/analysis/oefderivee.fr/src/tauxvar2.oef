\title{Taux de variation 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\integer{a2=randitem(1,randint(1..5)*randint(-1,1))}
\integer{a1=randint(-10..10)}
\integer{a0=randint(-10..10)}
\function{f=maxima(\a2*x^2+\a1*x+\a0)}
\integer{x1=randint(-2..5)}
\integer{y1=evalue(\f,x=\x1)}
\function{tauxvar=maxima(simplify((\f-\y1)/(x-\x1)))}
\text{tauxvar=wims(replace internal x by t in \tauxvar)}
\text{f=texmath(\f)}
##Pour le corrigé##
\text{text1=(\x1>=0)? \x1:(\x1)}
\text{text2=(\y1>=0)? \y1:(\y1)}
\text{ft=wims(replace internal x by t in \f)}
\function{num=maxima(\a2*t^2+\a1*t+\a0-\y1)}
\text{num=texmath(\num)}
\function{den=maxima(t-\x1)}
\rational{x2=(\x1<>0)? (\a0-\y1)/(\a2*\x1):0}##f(t)-f(x1)=a2(t-x1)(t-x2) ou factorisable par t##
\function{ff=(\x1=0)? t*(\a2*t+\a1):\a2*(t-\x1)*(t-\x2)}
\text{ff=texmath(\ff)}
\text{tvar=texmath(\tauxvar)}

\statement{Soit \(f) la fonction définie pour tout réel x par : \(f(x)=\f).
<div class="wims_question">Calculer le taux de variation de \(f) entre \(\x1) et un réel \(t) (\(t>\x1)).</div>}
\hint{On pourra remarquer que \(\num=\ff).}

\answer{Taux de variation (en fonction de \(t))}{\tauxvar}{type=algexp}

\solution{Le taux de variation de \(f) entre \(\x1) et \(\t) est 
\(\frac{f(t)-f(\x1)}{t-\text1}=\frac{\ft-\text2}{\den}=\frac{\num}{\den}=\frac{\ff}{\den}=\tvar).}
