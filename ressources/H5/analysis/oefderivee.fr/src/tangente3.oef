\title{Exploiter l'équation d'une tangente}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\language{fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(2..15)*random(-1,1)}
\integer{b=random(1..30)*randint(-1,1)}
\integer{x=random(1..10)*random(-1,1)}
\function{t=maxima(\a*x+\b)}
\text{t=texmath(\t)}
\integer{sol=\a*\x+\b}
\statement{<p>Soit \(f) une fonction dérivable sur \(\mathbb{R}).</p>
<p>La tangente à la courbe représentative de f au point d'abscisse \(\x) à pour équation : \(y=\t).</p>
<p>Donner la valeur de \(f'(\x)) : \(f'(\x)=)\embed{r1,4}.</p>
<p>Calculer la valeur de \(f(\x)) : \(f(\x)=)\embed{r2,4}.</p>}

\hint{La tangente à la courbe représentative au point d'abscisse \(a) est une droite
passant par le point de coordonnées \((a; f(a))) et de coefficient directeur \(f'(a)).}
\answer{}{\a}{type=formal}
\answer{}{\sol}{type=formal}
\solution{\(f'(\x)) est le coefficient directeur de la tangente donc \( f'(\x)=\a).
La tangente passe par le point de coordonnées \((\x; f(\x))) donc \(f(\x)=\a*(\x)+\b=\sol). }