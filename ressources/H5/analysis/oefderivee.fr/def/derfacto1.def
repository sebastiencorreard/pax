val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,2,2

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1,1

val7=$[rint($(tmp0)*$(tmp1))]

!ifval ($val6=1)
val8=$[rint( -$val7)]
!else
val8=$[rint(0)]
!endif

!ifval ($val6=1)
tmp0=!randint 2, 5

tmp=!nonempty items 1,$(tmp0)^2

tmp1=!randitem $tmp
val9=$[rint( $(tmp1))]
!else
tmp2=!randint 1, 5

val9=$[rint($(tmp2)*$val7+1)]
!endif
val10=$[rint(sqrt($val9))]
tmp0=!randint -15, 15

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val9*x^3/3-($val7+$val8)/2*x^2+($val7*$val8)*x+$val11)
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val13=!rawmath $(tmp1)
tmp0=!texmath $val12

val12=$(tmp0)

!ifval ($val8>$val7)
tmp0=!randint 2, 4

val14=$[rint( $val7-$(tmp0))]
!else
tmp1=!randint 2, 4

val14=$[rint($val7+$(tmp1))]
!endif
tmp=!nonempty items $val7+2,$val7-1

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]

!ifval ($val6=1)
t_=!replace internal \( by ( in ($val10*x-$val7)*($val10*x-$val8)
tmp0=!exec maxima $t_

val16=!rawmath  $(tmp0)
!else
t_=!replace internal \( by ( in x*($val9*x-$val7)
tmp1=!exec maxima $t_

val16=!rawmath $(tmp1)
!endif
val17=r1	r2
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=function
replyoption1=nonstop 
replyname1=
replygood1=!rawmath $val13
