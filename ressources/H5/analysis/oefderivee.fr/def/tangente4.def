!set title=Tangente horizontale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(-2*$val7*$val6)]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x^2+$val8*x+$val9
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)
tmp0=!texmath $val10

val10=$(tmp0)
t_=!replace internal \( by ( in 2*$val7*x+$val8
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp0=!texmath $val11

val11=$(tmp0)
tmp0=!replace internal x by a in $val11

val12=$(tmp0)
replytype1=formal
replyname1=au point d'abscisse
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst La tangente est horizontale si et seulement si son coefficient directeur est nul.

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Soit 
!insmath f
$() la fonction définie pour tout réel 
!insmath x
$() par : 
!insmath f(x)=$val10
$().</p>	<div class="wims_question"> En quel point la tangente à la courbe représentative de 
!insmath f
$() est-elle parallèle à l'axe des abscisses (horizontale) ?</div>	<div>La tangente est horizontale au point d'abscisse  
!read oef/embed.phtml r1,5 
$().</div>	
$()
!exit

:hint
$()La tangente est horizontale si et seulement si son coefficient directeur est nul.
$()
!exit

:help
$()
$()
!exit

:solution
$()La tangente au point d'abscisse 
!insmath a
$() est horizontale si et seulement si son coefficient directeur est nul c'est à dire, par définition 	de la tangente, 
!insmath f'(a)=0
$(). Pour tout réel 
!insmath x
$(), 
!insmath f'(x)=$val11
$() donc 
!insmath f'(a)=0
$() &hArr; 
!insmath $val12=0
$() &hArr; 
!insmath a=$val6
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10,11,12
embedcnt=1
