!set title=Taux de variation 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem -1,1

tmp=!nonempty items 1,$(tmp0)*$(tmp1)

tmp2=!randitem $tmp
val6=$[rint($(tmp2))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val6*x^2+$val7*x+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randint -2, 5

val10=$[rint($(tmp0))]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val9-$val11)/(x-$val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val12=!rawmath $(tmp1)
tmp0=!replace internal x by t in $val12

val12=$(tmp0)
tmp0=!texmath $val9

val9=$(tmp0)

!ifval ($val10>=0)
val13= $val10
!else
val13=($val10)
!endif

!ifval ($val11>=0)
val14= $val11
!else
val14=($val11)
!endif
tmp0=!replace internal x by t in $val9

val15=$(tmp0)
t_=!replace internal \( by ( in $val6*t^2+$val7*t+$val8-$val11
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)
t_=!replace internal \( by ( in t-$val10
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)

!ifval ($val10<>0)
t_=!rawmath  ($val8-$val11)/($val6*$val10)
val18=!exec pari print($t_)
!else
t_=!rawmath 0
val18=!exec pari print($t_)
!endif

!ifval ($val10=0)
val19=!rawmath  t*($val6*t+$val7)
!else
val19=!rawmath $val6*(t-$val10)*(t-$val18)
!endif
tmp0=!texmath $val19

val19=$(tmp0)
tmp0=!texmath $val12

val20=$(tmp0)
replytype1=algexp
replyname1=Taux de variation (en fonction de \(t))
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath f
$() la fonction définie pour tout réel x par : 
!insmath f(x)=$val9
$().	<div class="wims_question">Calculer le taux de variation de 
!insmath f
$() entre 
!insmath $val10
$() et un réel 
!insmath t
$() (
!insmath t>$val10
$()).</div>
$()
!exit

:hint
$()On pourra remarquer que 
!insmath $val16=$val19
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()Le taux de variation de 
!insmath f
$() entre 
!insmath $val10
$() et 
!insmath \t
$() est 	
!insmath \frac{f(t)-f($val10)}{t-$val13}=\frac{$val15-$val14}{$val17}=\frac{$val16}{$val17}=\frac{$val19}{$val17}=$val20
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,13,14,15,16,17,19,20
embedcnt=0
