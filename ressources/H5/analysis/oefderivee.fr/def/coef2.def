!set title=Coefficients fonction degré 2 (2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
keywords=tangent 
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefdescription=
oefobservation=Retrouver les coefficients d'une fonction polynôme de degré 2, connaissant le point d'intersection avec l'axe des ordonnées et une tangente.

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint($val6*($val9)*($val9)+$val7*($val9)+$val8)]
val11=$[rint(2*$val6*$val9+$val7)]
t_=!replace internal \( by ( in expand(($val11)*(x-$val9)+$val10)
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!texmath $val12

val12=$(tmp0)
t_=!replace internal \( by ( in a*x^2+$val7*x+$val8
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp0=!texmath $val13

val13=$(tmp0)
val14=$[rint(($val9)^2)]

!ifval ($val9>0)
tmp0=!replace internal x by $val9 in $val12

val15= $(tmp0)
!else
tmp1=!replace internal x by ($val9) in $val12

val15=$(tmp1)
!endif
t_=!replace internal \( by ( in $val6*x^2+$val7*x+$val8
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)

!ifval ($val9>0)
val17= $val14 a+$val9 b+c
!else
val17=$val14 a$val9 b+c
!endif

!ifval ($val9>0)
val18= $val14 a+$val9 b
!else
val18=$val14 a$val9 b
!endif
val19=$[rint($val10-$val8)]
val20=$[rint(2*$val9)]
val21=$val20 a+b
replytype1=numeric
replyname1=\(a)
replygood1=$[$val6]
replytype2=numeric
replyname2=\(b)
replygood2=$[$val7]
replytype3=numeric
replyname3=\(c)
replygood3=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>La fonction du second degré 
!insmath f
$() a pour expression : 
!insmath f(x)=a x^2+b x+c
$().</p>	<p>On note 
!insmath C_f
$() la courbe représentative de 
!insmath f
$() dans un repère du plan.</p>	<p>On sait que 
!insmath C_f
$() coupe l'axe des ordonnées au point 
!insmath A(0 ; $val8)
$()	et que la tangente à 
!insmath C_f
$() au point d'abscisse 
!insmath $val9
$() a pour équation : 
!insmath y=$val12
$().</p>	<div class="wims_question">Déterminer les valeurs de 
!insmath a
$(), 
!insmath b
$() et 
!insmath c
$().</div>	
$()
!exit

:hint
$()Utiliser la première condition pour obtenir la valeur d'un des trois coefficients. Utiliser l'équation de la tangente pour obtenir un système avec les deux autres coefficients. 	La tangente à 
!insmath C_f
$() au point d'abscisse 
!insmath x_0 
$() est la droite	passant par le point de coordonnées 
!insmath (x_0; f(x_0))
$() et de coefficient directeur 
!insmath f'(x_0)
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath A(0; $val8)\in C_f
$() &hArr; 
!insmath f(0)=$val8
$() &hArr; 
!insmath c=$val8
$().</p>	La tangente à 
!insmath C_f
$() au point d'abscisse 
!insmath $val9
$() à pour équation : 
!insmath y=$val12
$() donc 
!insmath f'($val9)=$val11
$() (coefficient directeur de la tangente) 	et 
!insmath f($val9)=$val15=$val10
$()  (car le point de coordonnées 
!insmath x=$val9
$() et y=
!insmath f($val9)
$() appartient à 
!insmath C_f
$() et à la tangente).</p>	<p>
!insmath f($val9)=
$()
!if $val9>0 
$()
!insmath a \times $val9^2+b \times $val9+c=$val17
$() 
!else
$() 
!insmath a \times ($val9)^2+b \times ($val9)+c=$val17
$() 
!endif
$()	 et 
!insmath f($val9)=$val10
$() donc 
!insmath $val17=$val10
$() c'est à dire 
!insmath $val18=$val10-c=$val19
$(). </p>	<p>Pour tout réel 
!insmath x
$(), 
!insmath f'(x)=2ax+b
$() donc 
!insmath f'($val9)=
$()
!if $val9>0 
$()
!insmath 2a\times$val9+b=$val21
$() 
!else
$() 
!insmath 2a($val9)+b=$val21
$() 
!endif
$(). 	Comme 
!insmath f'($val9)=$val11
$(), 
!insmath $val21=$val11
$().</p>	<p>Les solutions du système 
!insmath \left \lbrace \begin{array}{l} $val18=$val19  \\ $val21=$val11 \end{array} \right .
$() sont (par combinaison linéaire ou substitution)	
!insmath a=$val6
$() et 
!insmath b=$val7
$(). Pour tout réel 
!insmath x
$(), 
!insmath f(x)=$val16
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,15,16,17,18,19,21
embedcnt=0
