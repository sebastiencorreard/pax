!set title=Taux de variation 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,2,2,3

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]

!ifval ($val6>=3)
tmp0=!randint 2, 3

tmp1=!randitem -1,1

tmp=!nonempty items 1,$(tmp0)*$(tmp1)

tmp2=!randitem $tmp
val7=$[rint( $(tmp2))]
!else
val7=$[rint(0)]
!endif

!ifval ($val6=2)
tmp0=!randint 2, 3

tmp1=!randitem -1,1

tmp=!nonempty items 1,$(tmp0)*$(tmp1)

tmp2=!randitem $tmp
val8=$[rint( $(tmp2))]
!else
val8=$[rint(0)]
!endif
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x^3+$val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp0=!randint -2, 3

val12=$[rint($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val13=$[rint($(tmp0))]
tmp0=!randint 1, 7

val14=$[rint($val12+$(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val15=$[rint($(tmp0))]
tmp0=!texmath $val11

val11=$(tmp0)
t_=!rawmath ($val15-$val13)/($val14-$val12)
val16=!exec pari print($t_)

!ifval ($val12>=0)
val17= $val12
!else
val17=($val12)
!endif

!ifval ($val13>=0)
val18= $val13
!else
val18=($val13)
!endif
val19=$[rint($val15-$val13)]
val20=$[rint($val14-$val12)]
t_=!replace internal \( by ( in floor($val16)
tmp0=!exec maxima $t_


!ifval ($(tmp0)=$val16)
val21=$[rint( 1)]
!else
val21=$[rint(0)]
!endif
replytype1=formal
replyname1=Taux de variation
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Soit 
!insmath 
$() la fonction définie pour tout réel x par : 
!insmath f(x)=$val11
$().	<div class="wims_question">Calculer le taux de variation de 
!insmath f
$() entre 
!insmath $val12
$() et 
!insmath $val14
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Le taux de variation de 
!insmath f
$() entre 
!insmath $val12
$() et 
!insmath $val14
$() est 	
!insmath \frac{f($val14)-f($val12)}{$val14-$val17}=\frac{$val15-$val18}{$val14-$val17}
$()
!if $val21=1 
$()
!insmath =\frac{$val19}{$val20}
$() 
!endif
$()	
!insmath =$val16
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,14,15,16,17,18,19,20,21
embedcnt=0
