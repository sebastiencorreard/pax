!set title=Taux de variation 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,2,3,3

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 0, 4

val7=$[rint($(tmp0))]
tmp0=!randint 1, 15

val8=$[rint($val7+$(tmp0))]
val9=$val7,$val7,a
val10=$val8,t,b
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]

!ifval ($val11>0)
val12= 2
!else
val12=3
!endif

!ifval ($val6<=2)
val12= 1
!else
val12=$val12
!endif
val13=on ne peut rien dire,elle est strictement croissante,elle est strictement décroissante
replytype1=menu
replyname1=Conclusion :
replygood1=$val12;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Le taux de variation d'une fonction 
!insmath f
$() entre 
!insmath $(val9[$val6])
$() et 
!insmath $(val10[$val6])
$() est égal à 
!insmath $val11
$() 
!if $val6=2 
$()pour tout 
!insmath t
$() appartenant à &#91;
!insmath $val7
$() ; 
!insmath $val8
$()&#93; 
!endif
$()	
!if $val6=3 
$()pour tous les réels 
!insmath a
$() et 
!insmath b
$() appartenant appartenant à &#91;
!insmath $val7
$() ; 
!insmath $val8
$()&#93; 
!endif
$(). 	<br/>Que peut-on en déduire sur la variation de la fonction 
!insmath f
$() sur &#91;
!insmath $val7
$() ; 
!insmath $val8
$()&#93 ?
$()
!exit

