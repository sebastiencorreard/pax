!set title=Exploiter l'équation d'une tangente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 15

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 30

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*x+$val7
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!texmath $val9

val9=$(tmp0)
val10=$[rint($val6*$val8+$val7)]
replytype1=formal
replyname1=
replygood1=$val6
replytype2=formal
replyname2=
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Soit 
!insmath f
$() une fonction dérivable sur 
!insmath \mathbb{R}
$().</p>	<p>La tangente à la courbe représentative de f au point d'abscisse 
!insmath $val8
$() à pour équation : 
!insmath y=$val9
$().</p>	<p>Donner la valeur de 
!insmath f'($val8)
$() : 
!insmath f'($val8)=
$() 
!read oef/embed.phtml r1,4 
$().</p>	<p>Calculer la valeur de 
!insmath f($val8)
$() : 
!insmath f($val8)=
$() 
!read oef/embed.phtml r2,4 
$().</p>
$()
!exit

:hint
$()La tangente à la courbe représentative au point d'abscisse 
!insmath a
$() est une droite	passant par le point de coordonnées 
!insmath (a; f(a))
$() et de coefficient directeur 
!insmath f'(a)
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath f'($val8)
$() est le coefficient directeur de la tangente donc 
!insmath  f'($val8)=$val6
$().	La tangente passe par le point de coordonnées 
!insmath ($val8; f($val8))
$() donc 
!insmath f($val8)=$val6*($val8)+$val7=$val10
$(). 
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=2
