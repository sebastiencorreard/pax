!set title=Exploiter le tracé d'une tangente
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 3,1,1,2,2	4,1,1,3,3	5,1,2,3,4	6,1,1,5,5
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp=!nonempty items $(val6[$val7;$val8])/$(val6[$val7;1]),$(tmp0)

tmp1=!randitem $tmp
tmp2=!randitem -1,1

t_=!rawmath $(tmp1)*$(tmp2)
val9=!exec pari print($t_)
tmp0=!randint -4, 4

val10=$[rint($(tmp0))]
!if abs($val9)<2 

!ifval (floor($val9)=$val9)
tmp0=!randint -4, 4

val11=$[rint( $(tmp0))]
!else
tmp=!nonempty items -$(val6[$val7;1]),0,$(val6[$val7;1])

tmp1=!randitem $tmp
val11=$[rint($(tmp1))]
!endif
!else
val12=$[rint(floor((-10-$val10)/$val9))]
val13=$[rint(floor((10-$val10)/$val9))]
!if $val9>0 
tmp0=!randint ($val12+1), ($val13-1)

val11=$[rint($(tmp0))]
!else
tmp0=!randint ($val13+1), ($val12-1)

val11=$[rint($(tmp0))]
!endif
!endif
val14=$[rint($val9*$val11+$val10)]

!ifval (floor($val9)=$val9)
val15=$[rint( 1)]
!else
val15=$[rint($val11)]
!endif
val16=$[rint($val9*($val15)+$val10)]

!ifval (floor($val9)=$val9)
val17=$[rint( 1)]
!else
val17=$[rint($val11+$(val6[$val7;1]))]
!endif
val18=$[rint($val9*($val17)+$val10)]

!ifval ($val11=0)
val19=$[rint( $val10)]
!else
tmp0=!randint 1, 3

val19=$[rint($val10+$(tmp0))]
!endif

!ifval ($val11=0)
t_=!rawmath  1
val20=!exec pari print($t_)
!else
t_=!rawmath ($val19-$val10)/($val11*$val11)
val20=!exec pari print($t_)
!endif

!ifval ($val11=0)
t_=!rawmath  $val9
val21=!exec pari print($t_)
!else
t_=!rawmath $val9-2*$val20*$val11
val21=!exec pari print($t_)
!endif
t_=!replace internal \( by ( in $val20*x^2+$val21*x+$val19
tmp0=!exec maxima $t_

val22=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'($val11))
replygood1=$val9
replytype2=formal
replyname2=\(f($val11))
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 
!read oef/draw.phtml 480,400 \
	xrange -12,12	yrange -10,10	parallel -12,-10,12,-10,0,1,20, grey	 parallel -12,-10,-12,10,1,0,24, grey	hline 0,0,black	vline 0,0,black	segment 1,-0.3,1,0.3,black	segment -0.3,1,0.3,1,black	text black , -0.5,-0.3,small , O	text black , 1,-0.3,small , I	text black , -0.5,1,small , J	linewidth 1.5	plot blue, $val9*x+$val10	plot black, $val22	 
$()<br/>	<p>
!insmath f
$() est une fonction dérivable sur 
!insmath \mathbb{R}
$().</p>	<p>La droite tracée est la tangente à 
!insmath C_f
$() au point d'abscisse 
!insmath $val11
$().</p>	<p>Donner 
!insmath f'($val11)
$() et 
!insmath f($val11)
$().</p>
$()
!exit

:hint
$()La tangente à 
!insmath C_f
$() au point d'abscisse 
!insmath a
$() est une droite	passant par le point de coordonnées 
!insmath (a; f(a))
$() et de coefficient directeur 
!insmath f'(a)
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath f'($val11)
$() est le coefficient directeur de la tangente. Comme 
!insmath A($val15,$val16)
$() et 
!insmath B($val17,$val18)
$() appartiennent à la tangente, le coefficient directeur est 
!insmath $val9
$() (graphiquement ou par la formule). La tangente et la courbe de 
!insmath f
$() passent par le point de coordonnées 	
!insmath ($val11; $val14)
$() donc 
!insmath f($val11)=$val14
$(). 
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,14,15,16,17,18,22
embedcnt=0
