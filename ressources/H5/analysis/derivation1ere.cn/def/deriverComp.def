!set title=复合函数的导数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=V閞onique,Royer
email=royer.veronique@wanadoo.fr
language=cn

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath $val6*x+$val7
t_=!rawmath -$val7/$val6
val10=!exec pari print($t_)
tmp0=!randitem 2,3

tmp1=!randitem 2,3

val11=!rawmath sqrt($val9),	 $val8/($val9),  	 $val8*($val9)^$(tmp0),	 ($val9)^$(tmp1)+$val8,	
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
tmp0=!texmath $val14

val15=$(tmp0)
tmp0=!texmath $val13

val16=$(tmp0)
val17=&#8734

!ifval $val12==1 and $val6>0
val18=\($val10)
!endif

!ifval $val12==1 and $val6>0
val19=+$val17
!endif

!ifval $val12==1 and $val6<0
val19=\($val10)
!endif

!ifval $val12==1 and $val6<0
val18=-$val17
!endif

!ifval $val12==1
val20= 区间 \(\langle) $val18 &#44; $val19 \(\rangle)
!endif

!ifval $val12==2
val20= \(\RR \setminus \{$val10\})
!endif

!ifval $val12>2
val20= \(\RR) 
!endif
replytype1=formal
replyname1=导函数 \(f'(x))
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 	<div>	<table width="80%" align="center">	<tr bgcolor=#FFCC66><td>	已知函数 : 
!insmath f(x) \,=\, $val16 
$() <br>	求它在 $val20 里的导函数<br>	</td></tr></table>	<p align="center"> 
!insmath f'(x)
$() =  
!read oef/embed.phtml reply1 , 40 
$()</p>		 
!if $val12==1 
$()<p>注意 : <i>输入 </i> "sqrt(ax+b)" <i> 以得到  
!insmath sqrt(ax+b)
$()</i></p> 
!endif
$()	</div>
$()
!exit

