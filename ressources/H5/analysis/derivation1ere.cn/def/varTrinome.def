tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val8=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val9=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randitem 1,2,3,5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val10=!exec pari print($t_)
val11=$val8*x^2+$val9*x+$val10,	$val8*x^2+$val9*x,	$val8*x^2+$val10,	$val8*($val7*x+$val6)^2
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)

!ifval $val12<3
t_=!rawmath -($val9)/(2*$val8) 
val15=!exec pari print($t_)
!endif

!ifval $val12==3
t_=!rawmath 0 
val15=!exec pari print($t_)
!endif

!ifval $val12==4
t_=!rawmath -($val6/$val7) 
val15=!exec pari print($t_)
!endif
evaltmp=$val13

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
val17=&#8734
val18=\(\langle) -&#8734; ; \($val15) \(\rangle)
val19=\(\langle) \($val15) ; +&#8734; \(\rangle)
val20=+,-

!ifval $val8>0
val21=$[rint(2)]
!else
val21=$[rint(1)]
!endif
val22=+,-

!ifval $val8>0
val23=$[rint(1)]
!else
val23=$[rint(2)]
!endif
val24=上升,下降
val25=$[rint($val21)]
val26=上升,下降
val27=$[rint($val23)]
val28=极小,极大
val29=$[rint($val27)]
tmp0=!exec pari printtex($val13)

val30=$(tmp0)
tmp0=!exec pari printtex($val14)

val31=$(tmp0)
oefsteps=reply1,reply2,	reply3,reply4,reply5,reply6,reply7,reply8 
nextstep=!nosubst reply1,reply2,	reply3,reply4,reply5,reply6,reply7,reply8 
!readproc oef/steps.proc
