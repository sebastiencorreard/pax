\title  {商的导数}
\author {V閞onique Royer}
\email  {royer.lyjamo@wanadoo.fr}
\format {html}
\language{cn}
\integer{a1=random(1..4)}
\integer{c1=random(1..4)*random(1,-1)}
\integer{c2=random(1..8)*random(1,-1)}
\integer{c3=random(1..4)*random(1,-1)}
\integer{c4=random(1..8)*random(1,-1)}

\text{ulist= \c1*x + \c2,
  x^2 + \c1,
 \c1*x^2 + \c2*x + \c3,
  \c1*random(x,x^2)
}
\text{vlist= \c3*x+\c4,
 (\c3*x+\c4)^2,
 \a1*random(x,x^2),
 x^2+\a1
}
\integer{casv=random(1..4)}
\integer{casu=(\casv==3)?random(1..3):random(1..4)}

\function{num=item(\casu , \ulist)}
\function{deno=item(\casv , \vlist)}
\rational{vi = \casv<3 ?-\c4 / \c3}
\rational{vi = \casv==3 ?0}
\rational{vi = \casv==4 ?0}
\integer{novi=\casv==4?1:0}
\text{ensder=\(\RR),\(\RR \setminus\{\vi\})}
\integer{rep5=\casv==4?1:2}

\function{dernum=diff(\num,x)}
\function{derdeno=diff(\deno,x)}
\function{f= (\num)/(\deno)}
\function{derf=diff(\f,x)}
\function{facderf=maxima(factor(\derf))}
\text{nicefacderf=wims(exec pari printtex(\facderf))}
\integer{casf=randint(1..3)}
\text{numA=u'v + uv'}
\text{numB=u'v - uv'}
\text{denoA=v^2}
\text{form1=\(f' = \numA)}
\text{form2=\(f' = \numB)}
\text{form3=\(f' = \frac{\numB}{\denoA})}
\text{form4=\(f' = \frac{u'}{v'})}
\text{form5=\(f' = \frac{\numA}{\denoA})}
\text{formules=\casf==3?\form1,\form2,\form3,\form4,\form5}
\text{formules=\casf==2?\form1,\form3,\form2,\form4,\form5}
\text{formules=\casf==1?\form3,\form1,\form2,\form4,\form5}
\integer{rep6=\casf}

\steps{reply1, reply2, reply3, reply4
reply5 , reply6
reply7}

\statement{<table width="80%" align="center" ><tr bgcolor=#FFCC66><td>
<p>已知 \if{\novi==1}{\RR}{\(\RR \setminus\{\vi \})} 上的函数 \(f) 定义为  \(f(x)  = (\num)/(\deno)).</p>
<p>我们分成几步求 \(f) 的导函数 :</p></td></tr></table>
\if{\step==1}{<ul><li> 把 \(f) 写成分式  \(\frac{u}{v}) , 其中函数 \(u) 和 \(v) 通过以下公式定义在 \RR 内 :
<center>\(u(x)\,=\,) \embed{reply1, 15}  &nbsp;和&nbsp;\(v(x)\,=\, ) \embed{reply2, 15}  </center><p></li>
<li>函数 \(u) 和 \(v) 在 \RR 内可微 :<center> \(u'(x)\,=\,)  \embed{reply3, 15}  &nbsp;和&nbsp;\(v'(x) \,=\, ) \embed{reply4, 15} </center></li>}
{<li>  \(f) = \(\frac{u}{v}) :<center> <p>\(u(x) = \num)  &nbsp;和&nbsp;\(u'(x) = \dernum)  </p>
<p>\(v(x) = \deno )  &nbsp;和&nbsp;\(v'(x) = \derdeno) </p></center></li>}
\if{\step==2}{<li> 分式  \(f = \frac{u}{v} ) 在以下区域可微 :  <center> \embed{reply5}</center></li>
<li>我们应用哪一个微分法则 :<center> \embed{reply6}</center></li>}
\if{\step==3}{<li> \(f) 在以下区域可微 \if{\novi==1}{\RR}{\(\RR \setminus\{\vi \})}. </li>
<li>我们应用哪一个微分法则 : \form3 </li>
<li>我们得到 : <center> \(f'(x)) =  \embed{reply7, 50}</center> </li>}</ol>}

\answer{分子 \(u) 定义为&nbsp;:&nbsp; \( u(x) ) }{\num}{type=formal}
\answer{分母 \(v) 定义为&nbsp;:&nbsp; \( v(x) ) }{\deno}{type=formal}
\answer{分子的导函数&nbsp;:&nbsp; \( u'(x) ) }{\dernum}{type=formal}
\answer{分母的导函数&nbsp;:&nbsp; \( v'(x) ) }{\derdeno}{type=formal}
\answer{在以下区域可微&nbsp;:&nbsp; }{\rep5 ; \ensder}{type=radio}
\answer{应用的法则&nbsp;:&nbsp; }{\rep6 ; \formules}{type=radio}
\answer{导函数 \(f') 定义为&nbsp;:&nbsp; \( f'(x) )}{\facderf}{type=formal}

\feedback{0==0}{<b>解.</b> 导函数 \(f') 定义为&nbsp; \( f'(x) \,=\,\nicefacderf ), 
\if{\novi==1}{对所有实数 \(x)}{对所有实数 \(x) 除去 \(\vi)} }
