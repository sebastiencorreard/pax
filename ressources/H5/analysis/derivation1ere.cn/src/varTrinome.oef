\title  {了解一个函数}
\author {V閞onique Royer}
\email  {royer.veronique@orange.fr}
\format {html}
\language{cn}

\integer{a1=random(1..3)*random(1,-1)}
\integer{a2=random(1..3)*random(1,-1)}
\rational{c1=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c2=randint(1..10)*random(1,-1)/randint(1,2,3,5)}
\rational{c3=randint(1..10)*random(1,-1)/randint(1,2,3,5)}

\text{flist=\c1*x^2+\c2*x+\c3,
\c1*x^2+\c2*x,
\c1*x^2+\c3,
\c1*(\a2*x+\a1)^2}

\integer{\cas=random(1..4)}
\function{f=item(\cas,\flist)}

\function{F=diff(\f,x)}

\rational{x0=\cas<3?-(\c2)/(2*\c1) }
\rational{x0=\cas==3?0 }
\rational{x0=\cas==4?-(\a1/\a2) }
\rational{valextr=evaluate(\f,x=\x0)}
\text{inf=&#8734}
\text{I1=\(\langle) -&#8734; ; \(\x0) \(\rangle)}
\text{I2=\(\langle) \(\x0) ; +&#8734; \(\rangle)}
\text{choix3=+,-}
\integer{rep3=\c1>0?2:1}
\text{choix4=+,-}
\integer{rep4=\c1>0?1:2}
\text{choix5=上升,下降}
\integer{rep5=\rep3}
\text{choix6=上升,下降}
\integer{rep6=\rep4}
\text{choix7=极小,极大}
\integer{rep7=\rep6}
\text{nicef=wims(exec pari printtex(\f))}
\text{niceF=wims(exec pari printtex(\F))}
\steps{reply1,reply2,
reply3,reply4,reply5,reply6,reply7,reply8
}


\statement{
<table width="80%" align="center">
<tr bgcolor=#FFCC66><td>
已知 \RR 内的函数 \(f) 定义为&nbsp;\(f(x) \,=\, \nicef).</p>
<p>
研究此函数并求出 \(f) 的极值和极值点.
</p>
</td></tr></table>
\if{\step==1}{
<ol>
<li>

函数 \(f) 在 \RR 内可微 :<br>
对所有实数 \(x) : &nbsp; \(f'(x)\,=\,) \embed{reply1,20}
</li>
<li>导函数 \(f') 的性质 :<br>
当 \(x)  =  \embed{reply2,10} 时导数 \(f') 等于 0
</li>
</ol>
}
\if{\step>1}{
<ol>
<li>\(f) 的导数 : 
<center> \(f'(x) \,=\, \niceF )</center>
</li>
<li>\(f') 的符号的性质 : 
<center>
<table border=1 border="solid" width="50%">
<tr>
<td width="10%" align="center"> \(x)</td><td  width="30%" align="left">-\inf</td><td  width="5%" align="center">\x0</td>
<td width="30%" align="right">+\inf</td>
</tr>
<tr>
<td width="10%" align="center">\(f'(x))</td><td width="30%" align="center"> \embed{reply3} </td><td  width="5%" align="center">0</td><td width="30%" align="center"> \embed{reply4}</td>
</tr>
</table>
</center>
</li>
<li>\(f) 的符号的性质 :
<ul>
<li>
\(f) 在区间 \I1 上 \embed{reply5}
/li>
<li>
\(f) 在区间 \I2 上 \embed{reply6}
</li>
</ul>
</li>
<li> \(f) 的极值 :
<ul>
<li> \(f) 在 \(\x0) 达到 \embed{reply7} 其值为 \embed{reply8, 10} 
</li>
</ul>
</li>
</ol>
}
}
\answer{导函数 \(f'(x))}{\F}{type=formal}
\answer{f'(x) 的零点是}{\x0}
\answer{f' 的符号 }{\rep3;\choix3}{type=menu}
\answer{f' 的符号 }{\rep4;\choix4}{type=menu}
\answer{f 上升}{\rep5;\choix5}{type=menu}
\answer{f 下降}{\rep6;\choix6}{type=menu}
\answer{极值的类型}{\rep7;\choix7}{type=menu}
\answer{\(f) 的极值的值}{\valextr}

\hint{当在一个特定的 x 值处导函数 f' 改变符号 ,<br> 
那么这就是 \(f) 的``局部''极值 (极小值或极大值). }
