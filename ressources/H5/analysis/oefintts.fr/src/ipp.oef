\title{Intégration par partie}

\integer{al=1}

\if{\al=1}{
\integer{a=random(-1,1)*randint(1..5)}
\integer{b=random(-10..10)}
\function{u=maxima(\a*x+\b)}
\integer{k=random(-1,1)*randint(1..5)}
\function{v1=maxima(exp(\k*x))}
\function{fonc=(\u)*(\v1)}
\text{tfonc=texmath(\fonc)}
\integer{m=0}
\integer{M=\m+randint(1..5)}
\text{integrale=maxima(int(\fonc,x,\m,\M))}

\function{u1=maxima(diff(\u,x))}
\function{v=maxima(int(\v1,x))}
\function{fonc2=maxima((\u1)*(\v))}
\text{intpart=maxima(int((\u1)*(\v),x,\m,\M))}
\text{crochet=maxima(subst(\M,x,(\u)*(\v))-subst(\m,x,(\u)*(\v)))}
\text{texintpart=texmath(\intpart)}
\text{texcrochet=texmath(\crochet)}
\text{texfonc2=texmath(\fonc2)}
}

\text{u=texmath(\u)}

\steps{
reply 1,reply 2
reply 3
reply 4
reply 5
}

\statement{<em>Cet exercice comporte quatre étapes.</em>
<div class="wimsleft">On considère la fonction \(f) définie par \(f(x)=\tfonc).<br>
On se propose de calculer \(I=integrate(f(x),x=\m..\M)\) en utilisant une intégration
par partie.</div>
<div>A cette fin, on pose \(u(x)=\u) et \(v'(x)=\v1).</div>
\if{\step=1}{
  <em>Question 1 :</em>
  On calcule alors
  <label for="reply1">\(u'(x)=)</label> \embed{reply 1, 10} et
  <label for="reply2">\(v(x)=)</label> \embed{reply 2, 10} .
}
\if{\step=2}{
  <em>Question 2</em>: Oui, \(u'(x)=\u1) et \(v(x)=\v).Dans ces conditions, on calcule :
  <div class="wimscenter"><label for="reply3">\([u(x)v(x)]_\m^\M=)</label> \embed{reply 3,30}.
  </div>
}
\if{\step=3}{
  <em>Question 3</em>:
  Enfin, on calcule l'intégrale
  <label for="reply4">\(integrate( u'(x)v(x),x=\m..\M)=integrate(\fonc2, x=\m..\M)\)=</label>
  \embed{reply 4,30}.
}
\if{\step=4}{
  <em>Question 4</em>: Les égalitées vues précédemment
  \([u(x)v(x)]_\m^\M=\texcrochet) d'une part et
  \(integrate(u'(x)v(x),x=\m..\M)=\intpart\)
  d'autre part, permettent finalement de calculer :
<div class="wimscenter"><label for="reply5">\(I=)</label> \embed{reply 5, 30}.</div>
}
}

\answer{u1}{\u1}{type=function}
\answer{v}{\v}{type=function}
\answer{Crochet}{\crochet}{type=formal}
\answer{Intégrale partielle}{\intpart}{type=formal}
\answer{Intégrale}{\integrale}{type=formal}

\hint{On rappelle que \(integrate(u(x)v'(x), x=a..b)\)=\([u(x)v(x)]_a^b-\)
  \(integrate(u'(x)v(x), x=a..b)\).
}
