\title{Aire entre deux courbes}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{u=random(-5..-1)}
\integer{a=\u+randint(1..3)}
\integer{v=\a+randint(1..3)}
\integer{b=\v+randint(1..3)}

\integer{k=random(-1,1)*random(1..2)}
\function{f0=maxima(expand(\k*(x-\u)*(x-\v)))}
\text{tf0=texmath(\f0)}

\rational{fa=maxima(subst(\a,x,\f0))}
\rational{fb=maxima(subst(\b,x,\f0))}

\function{gu=maxima(expand((x-\u)*\fa/(\a-\u)))}
\function{gv=maxima(expand((x-\v)*\fa/(\a-\v)))}

\text{tgu=texmath(\gu)}
\text{tgv=texmath(\gv)}

\rational{I1=maxima(integrate(\f0,\x,\a,\v))}

\rational{I2=maxima(integrate(\f0,\x,\v,\b))}


\rational{fvb=maxima(subst((\v+\b)/2,x,\f0)/2)}
\rational{fua=maxima((subst((\u+\a)/2,x,\f0)+subst((\u+\a)/2,x,\gu))/2)}
\rational{fva=maxima((subst((\v+\a)/2,x,\f0)+subst((\v+\a)/2,x,\gv))/2)}
\rational{gua=maxima(subst((\u+\a)/2,x,\gu)/2)}

\integer{al=randint(1..3)}

\if{\al=1}{
  \text{dom=\k>0?texmath(g(x) \geq y \geq f(x)):texmath(g(x)\leq y \leq f(x))}
  \rational{I=maxima(integrate((\f0)-(\gu),x,\u,\a))}
  \rational{I=abs(\I)}
  \text{hachure=
  fill (\u+\a)/2,\fua,green
  }
}

\if{\al=2}{
  \text{dom=\k>0?texmath(0 \geq y \geq Max(f(x),g(x))):texmath(0 \leq y \leq Min(f(x),g(x)))}
  \rational{I1=maxima(abs(integrate((\gu),x,\u,\a)))}
  \rational{I2=maxima(abs(integrate((\f0),x,\a,\v)))}
  \rational{I=\I1+\I2}
  \text{hachure=
  line \u,0,\v,0,green
  fill (\u+\a)/2,\gua,green
  }
}

\if{\al=3}{
  \text{dom=\k>0?texmath(f(x) \leq y \leq Max(g(x),h(x))):texmath(f(x) \geq y \geq Min(g(x),h(x)))}
  \rational{I1=maxima(abs(integrate((\f0)-(\gu),x,\u,\a)))}
  \rational{I2=maxima(abs(integrate((\f0)-(\gv),x,\a,\v)))}
  \rational{I=\I1+\I2}
  \text{hachure=
  fill (\u+\a)/2,\fua,green
  plot green,\gv
  fill (\v+\a)/2,\fva,green
  }
}

\if{\al=3}{
  \text{enonce=
  On considère les fonctions \(f,g,h), définies sur \(\,\RR) par \(f(x)=\tf0), \(g(x)=\tgu) et \(h(x)=\tgv),
  dont les représentations graphiques sont données ci-contre.
  }
  }{
  \text{enonce=
  On considère les fonctions \(f) et \(g), définies sur \(\,\RR) par \(f(x)=\tf0) et \(g(x)=\tgu),
  dont les représentations graphiques sont données ci-contre.
  }
}

\rational{p=evalue(\f0,x=\s)}
\integer{ym=-15}
\integer{yM=15}
\integer{ny=\yM-\ym+1}
\text{dessin=
xrange=-6,10
yrange \ym,\yM
linewidth 2
plot green,\f0
plot green,\gu
\hachure
linewidth 1
parallel -6,\ym,-6,\yM,1,0,17,blue
parallel -6,\ym,10,\ym,0,1,\ny,blue
linewidth 2
line -6,0,10,0,red
line 0,\ym,0,\yM,red
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">
\draw{300,300}{
\dessin}
</div>
 <div class="medium_size text_col">
\enonce
 <div>
 La partie du plan coloriée en vert, notée \(D), est définie par les équations \(\v \geq x \geq \u) et \(\dom).<br>
<label for="reply1">L'aire de \(D), exprimée en unités d'aire, est égale à</label>
\embed{reply 1,15}.
</div>
</div></div>
}

answer{Equations}{\al;\(\dom1),\(\dom2),\(\dom3)}{type=checkbox}
\answer{Aire}{\I}{type=rational}
