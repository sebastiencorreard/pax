!set title=Intégration par partie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r,r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(1)]
!if $val6=1 
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val10=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in exp($val10*x)
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
val12=!rawmath ($val9)*($val11)
tmp0=!texmath $val12

val13=$(tmp0)
val14=$[rint(0)]
tmp0=!randint 1, 5

val15=$[rint($val14+$(tmp0))]
tmp=!translate ;";': to $     $ in $val12,x,$val14,$val15 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val16=$(tmp1)
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val17=!rawmath $(tmp1)
tmp=!translate ;";': to $     $ in $val11,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val18=!rawmath $(tmp1)
t_=!replace internal \( by ( in ($val17)*($val18)
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in ($val17)*($val18),x,$val14,$val15 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val20=$(tmp1)
t_=!replace internal \( by ( in subst($val15,x,($val9)*($val18))-subst($val14,x,($val9)*($val18))
tmp0=!exec maxima $t_

val21=$(tmp0)
tmp0=!texmath $val20

val22=$(tmp0)
tmp0=!texmath $val21

val23=$(tmp0)
tmp0=!texmath $val19

val24=$(tmp0)
!endif
tmp0=!texmath $val9

val9=$(tmp0)
oefsteps=reply 1,reply 2	reply 3	reply 4	reply 5 
nextstep=!nosubst reply 1,reply 2	reply 3	reply 4	reply 5 
!readproc oef/steps.proc
replytype1=function
replyname1=u1
replygood1=!rawmath $val17
replytype2=function
replyname2=v
replygood2=!rawmath $val18
