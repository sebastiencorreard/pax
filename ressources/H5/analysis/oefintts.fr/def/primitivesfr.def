tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]
val8=$[$val7/2]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val7*(\x-$val6)+$val9*$val10)
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand((x-$val6)^2+$val10^2)
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!texmath $val12

val13=$(tmp0)
tmp0=!texmath ($val11)/($val12)

val14=$(tmp0)
t_=!replace internal \( by ( in (x-$val6)^2+$val10^2
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in 2*(x-$val6)
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in 1/$val10
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in (((x-$val6)/$val10)^2+1)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
tmp0=!texmath ($val16)/($val15)

val19=$(tmp0)
tmp0=!texmath ($val17)/($val18)

val20=$(tmp0)
tmp0=!texmath $val15

val15=$(tmp0)
t_=!replace internal \( by ( in $val7/2*(2*(x-$val6)/((x-$val6)^2+$val10^2))+$val9*((1/$val10)/(((x-$val6)/$val10)^2+1))
tmp0=!exec maxima $t_

val21=$(tmp0)
t_=!replace internal \( by ( in $val7/2
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val22=$(tmp1)
val21=$val22 $val19+$val9 $val20
t_=!replace internal \( by ( in ($val7/2)*log(expand((x-$val6)^2+$val10^2))+$val9*atan((x-$val6)/$val10)
tmp0=!exec maxima $t_

val23=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val7/2)*log((x-$val6)^2+$val10^2)+$val9*atan((x-$val6)/$val10)
tmp0=!exec maxima $t_

val24=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val7/2)*log((x-$val6)^2+$val10^2)+$val9*atan(x/$val10-$val6/$val10)
tmp0=!exec maxima $t_

val25=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val7/2)*log(expand((x-$val6)^2+$val10^2))+$val9*atan(x/$val10-$val6/$val10)
tmp0=!exec maxima $t_

val26=!rawmath $(tmp0)
tmp0=!texmath $val24

val27=$(tmp0)
