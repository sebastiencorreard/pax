!set title=Primitives de fractions rationnelles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r,r,r
varcnt=25
prevarcnt=20
postvarcnt=4
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

val10=$[rint($val6+$(tmp0))]
tmp0=!randitem -1,1

val11=$[rint($(tmp0)*$val8)]
t_=!replace internal \( by ( in expand($val8*($val9*x-$val10)+$val11*($val7*x-$val6))
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val7*x-$val6)*($val9*x-$val10)
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp0=!texmath ($val12)/($val13)

val14=$(tmp0)
t_=!replace internal \( by ( in u/($val7*x-$val6)+v/($val9*x-$val10)
tmp0=!exec maxima $t_

val15=$(tmp0)
tmp0=!texmath $val15

val15=$(tmp0)
t_=!replace internal \( by ( in $val8/($val7*x-$val6)+$val11/($val9*x-$val10)
tmp0=!exec maxima $t_

val16=$(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)
t_=!replace internal \( by ( in $val8/$val7*ln($val7*x-$val6)+$val11/$val9*ln($val9*x-$val10)
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in logcontract($val17)
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
tmp0=!texmath $val17

val18=$(tmp0)
t_=!replace internal \( by ( in $val7*x-$val6
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
tmp0=!texmath $val19

val20=$(tmp0)
t_=!replace internal \( by ( in $val9*x-$val10
tmp0=!exec maxima $t_

val21=!rawmath $(tmp0)
tmp0=!texmath $val21

val22=$(tmp0)
oefsteps=reply 1,reply 2	reply 3 
nextstep=!nosubst reply 1,reply 2	reply 3 
!readproc oef/steps.proc
replytype1=default
replyname1=u
replygood1=$val8
replytype2=default
replyname2=v
replygood2=$val11
replytype3=function
replyname3=F
replygood3=?analyze 23
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la fonction 
!insmath f
$(), définie par 
!insmath f(x)=$val14
$().	
!if $m_step=1 
$()	<div>	Déterminer deux réels 
!insmath u,v
$() tels que 
!insmath f(x)=$val15
$():	</div>	<div class="wimscenter">	 <label for="reply1">
!insmath u=
$()</label>  
!read oef/embed.phtml reply 1,5 
$() <label for="reply2">et 
!insmath v=
$()</label>	  
!read oef/embed.phtml reply 2,5 
$().	</div> 
!endif
$()	
!if $m_step=2 
$()	<div>	Effectivement, la fonction 
!insmath f
$() peut s'écrire sous la forme 
!insmath f(x)=$val16
$().	<p>	On se place sur un intervalle où 
!insmath $val20>0
$() et 
!insmath $val22>0
$().	Déduire de ce qui précède une primitive 
!insmath F
$() de 
!insmath f
$() :	</p>	</div>	<div class="wimscenter">	<label for="reply3">
!insmath F(x)=
$()</label>  
!read oef/embed.phtml reply 3, 30 
$()	</div>	<div class="wims_instruction">	Pour entrer la réponse, on utilise les conventions suivantes :<br>	La fonction logarithme népérien s'écrit <span class="tt">log</span>. Par exemple, on tape	<span class="tt">log(2)</span> pour écrire le réel <span class="tt">ln(2)</span>.<br>	Mettez * pour les multiplications.	</div> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Une primitive de 
!insmath f
$() est la fonction 
!insmath F
$() définie sur un intervalle où	
!insmath $val20>0
$() et 
!insmath $val22>0
$() par	<div class="wimscenter">	
!insmath F(x)=
$() 
!insmath $val18
$()	</div>	On rappelle que, plus généralement, si on se place sur un intervalle où	
!insmath $val20\not=0
$() et 
!insmath $val22\not=0
$() alors les primitives des fonctions	<div class="wimscenter">	
!insmath x\mapsto \frac{1}{$val20}
$() et 
!insmath x\mapsto \frac{1}{$val22}
$()	</div>	sont les fonctions	
!insmath x\mapsto \frac{1}{$val7} \ln|$val20|
$() et 
!insmath x\mapsto \frac{1}{$val9} \ln|$val22|
$()	
$()
!exit

:latex
$()
$()
!exit

:postdef
t_=!replace internal \( by ( in ($val17)-($val23)
tmp0=!exec maxima $t_

val24=!rawmath $(tmp0)
t_=!replace internal \( by ( in logcontract($val24)
tmp0=!exec maxima $t_

val24=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val24,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val24=!rawmath $(tmp1)
tmp=!translate ";': to $     $ in $val24

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=!rawmath $(tmp0)

!exit

