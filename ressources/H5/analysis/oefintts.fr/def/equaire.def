!set title=Détermination d'une aire donnée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
!if $val9=1 
tmp0=!randint 1, 3

tmp1=!randint 1, 5

t_=!rawmath $(tmp0)/$(tmp1)
val10=!exec pari print($t_)
t_=!replace internal \( by ( in $val8/($val6*x+$val7)
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val7*exp($val10*$val6/$val8)-$val7)/$val6
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
val13=$[$val12]
val14=$[$val8/($val6*$val12+$val7)]
val15=$[rint(0)]
val16=$[rint(-1)]
val17=$[rint(6)]
val18=$[$val8/$val7]
val19=$[$val8*0.5/($val6*($val15+$val13)/2+$val7)]
!endif
!if $val9=2 
tmp0=!randint 1, 5

t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in exp($val6*x+$val7)/$val8
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in (ln($val10*$val6*$val8+1)-$val7)/$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val12=!rawmath $(tmp1)
val13=$[$val12]
val14=$[exp($val6*$val13+$val7)/$val8]
t_=!rawmath -$val7/$val6
val15=!exec pari print($t_)
val18=$[1/$val8]
val19=$[exp($val6*($val15+$val13)/2+$val7)/(2*$val8)]
val16=$[rint(-1)]
val17=$[rint(6)]
!endif
tmp0=!texmath $val11

val20=$(tmp0)
val21=$[rint($val17-$val16+1)]
val22=xrange=-3,8	yrange $val16,$val17	linewidth 2	plot green,$val11	line $val15,0,$val15,$val18,green	line $val15,0,$val13,0,green	line $val13,0,$val13,$val14,green	fill ($val13+$val15)/2,$val19,green	line -6,0,10,0,red	line 0,$val16,0,$val17,red	arrow 0,0,1,0,10,red	arrow 0,0,0,1,10,red	line -6,0,10,0,red	line 0,$val16,0,$val17,red	linewidth 1	parallel -3,$val16,-3,$val17,1,0,11,blue	parallel -3,$val16,8,$val16,0,1,$val21,blue	
replytype1=formal
replyname1=Valeur de \(X)
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/draw.phtml 300,300 \
	$val22 
$()</div>	 <div class="medium_size text_col">	On considère la fonction 
!insmath f
$(), définie par 
!insmath f(x)=$val20
$(), dont la représentation graphique 
!insmath C_f
$()	 est donnée ci-contre.<br>	On note 
!insmath D
$() la partie du plan, coloriée en vert, et définie par les équations	<div class="wimscenter">	 
!insmath $val15 \leq x \leq a
$() et 
!insmath 0 \leq y \leq f(x)
$().</div>	Pour quelle valeur de 
!insmath a
$() l'aire de 
!insmath D
$() est-elle égale à 
!insmath $val10
$() unités d'aire ?<br>	Cette aire est égale à $val10 unités d'aire pour <label for="reply1">
!insmath a=
$()</label>  
!read oef/embed.phtml reply 1,15 
$().	<div class="wims_instruction">	  La valeur attendue est la valeur exacte de 
!insmath a
$().	</div>	</div>	</div>	
$()
!exit

:hint
$()L'aire de la partie du plan, coloriée en vert, est égale à	
!insmath integrate(f(x),x=$val15, X)
$().	 Cette intégrale pouvant aisément s'exprimer en fonction de 
!insmath X
$(),	 la résolution du problème se ramène à celle d'une équation d'inconnue 
!insmath X
$().
$()
!exit

