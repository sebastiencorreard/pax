 \title{Lire un angle 1}




\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}
\if{\confparm1=}{
\text{typarg=randitem(1,2,3,4)}
}{
\text{typarg=randitem(\confparm1,\confparm1)}
}

\text{k=0}




\text{al=\k*pi}
\real{Ax=cos(\al)}
\real{Ay=sin(\al)}
\if{\typarg=1}{
\text{k=randitem(1/2,1,3/2)}
}
\if{\typarg=2}{
\text{k=randitem(1/4,3/4,5/4,7/4)}
}
\if{\typarg=3}{
\text{k=randitem(1/3,2/3,4/3,5/3)}
}
\if{\typarg=4}{
\text{k=randitem(1/6,5/6,7/6,11/6)}
}
\text{bet=simplify(\k*pi)}
\real{Bx=cos(\bet+\al)}
\real{By=sin(\bet+\al)}

\text{s=1.3}
\text{ep=0.07}
\text{npix=400}
\text{cercle=trange 0,2*pi
plot blue,cos(t),sin(t)}
\text{angles=}
\for{i=-6 to 6}{
\real{x=cos(\i*pi/12)}
\real{y=sin(\i*pi/12)}
\text{angles=\angles
line -\x,-\y,\x,\y,gray}}
\text{quadrillage=}
\for{i=-4 to 4}{
\text{quadrillage=\quadrillage
line -1,\i/4, 1,\i/4,gray}}
\for{i=-4 to 4}{
\text{quadrillage=\quadrillage
line \i/4,-1, \i/4,1,gray}}
\text{points=disk \Ax,\Ay,10,black
text black,\Ax+\ep,\Ay+2*\ep,giant,A
disk \Bx,\By,10,black
text black,\Bx+\ep,\By+2*\ep,giant,B
}
\text{axes=
hline 0,0,black
arrow 0,0,\s,0,10,black
arrow 0,0,0,\s,10,black
vline 0,0,black
disk 0,0,10,black
text black,-2*\ep,-\ep,giant,O
}
\if{(\confparm2=) or (\confparm2=1)}{
\text{fond=\quadrillage}
}{
\text{fond=\angles}
}
\text{dessin= draw(\npix,\npix
xrange -\s,\s
yrange -\s,\s
\fond
\axes
\cercle
\points)}
\if{(\confparm3=) or (\confparm3=1)}{
\text{AOB=(\overrightarrow{OA},\overrightarrow{OB})}
}{
\text{AOB=\widehat{AOB}}
}
\statement{Quelle est la mesure (en radians) de l'angle \(\AOB\) représenté ci-dessous.
<div class="wimscenter">\draw{\npix,\npix}{
xrange -\s,\s
yrange -\s,\s
\fond
\axes
\cercle
\points
}
</div>
La mesure de l'angle \(\AOB\) est \embed{reply1,4}.
}
\answer{}{\rep}{type=function}{option=noanalyzeprint}
\real{diff=(cos(\rep)-cos(\bet))^2+(sin(\rep)-sin(\bet))^2}
\text{ok=0}
\if{\diff<0.0001}{\text{ok=1}}
\condition{Bonne réponse}{\ok=1}
\feedback{\ok=0}{L'angle mesure \(\bet\).}
