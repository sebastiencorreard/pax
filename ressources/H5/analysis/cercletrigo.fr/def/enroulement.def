!set title= Enroulement : Placer un point sur le cercle trigonométrique 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=trigonometric_circle,trigonometry,angles
author=Bruno, Mifsud;Communauté,MutuWIMS 
email=bmifsud@ac-aix-marseille.fr;communaute.mutuwims@laposte.net 
language=fr
oefobservation=L'angle est compris entre \(-pi) et \(pi)

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1/6,1/3,2/3,1/4,1/2,3/4,5/6,0/1

t_=!rawmath $(tmp0) 
val6=!exec pari print($t_)
val7=$[rint(1 )]
tmp0=!randint -1, 1

val8=$[rint(0.5*$(tmp0) )]
tmp=!translate ";': to $     $ in $val6 + $val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0) 
val6=!exec pari print($t_)
t_=!replace internal \( by ( in [numerator($val6) , denominator($val6)]
tmp0=!exec pari $t_

val9=$(tmp0) 
val10=!rawmath $(val9[1])*pi/$(val9[2]) 
val11=$[($val7)*cos($val6*pi) ]
val12=$[($val7)*sin($val6*pi) ]
val13=$[1.1*$val11]
val14=$[1.1*$val12]
tmp=!translate ";': to $     $ in $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
val16=\frac{$(val9[1]) \pi}{$(val9[2])}
!if $(val9[2])=1 and $(val9[1])=1 
val16=\pi 
!endif
!if $(val9[2])=1 and $(val9[1])=-1 
val16=-\pi
!endif
!if $(val9[1])=0  
val16=0
!endif
!if $(val9[2])=1 and ($(val9[1])>1 or $(val9[1])<-1) 
val16=$(val9[1])\pi
!endif
!if $(val9[2])>1 and $(val9[1])=1  
val16=\frac{\pi}{$(val9[2])}
!endif
!if $(val9[2])>1 and $(val9[1])=-1  
val16=\frac{-\pi}{$(val9[2])}
!endif
tmp=!translate ";': to $     $ in cos($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp=!translate ";': to $     $ in sin($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
val19=$[1.3 ]
val20=
!for val21  = 1 to 5  
val20=$val20	dline -2*$val19*cos($val21*pi/6),-2*$val19*sin($val21*pi/6),2*$val19*cos($val21*pi/6),2*$val19*sin($val21*pi/6),blue	dline -2*$val19*cos($val21*pi/4),-2*$val19*sin($val21*pi/4), 2*$val19*cos($val21*pi/4),2*$val19*sin($val21*pi/4),green 
!next
val22=$[400 ]
val23=linewidth 2	    xrange -$val19, $val19	    yrange -$val19, $val19	    hline 0,0,black	    arrow 0,0,$val19,0,6,black	    arrow 0,0,0,$val19,6,black	    vline 0,0,black	    vline 0.5,0,grey	    vline -0.5,0,grey	    hline 0,0.5,grey	    hline 0,-0.5,grey	    trange 0,2*pi	    text black,0.1,0.1,medium,0	    text black,1.1,0.1,medium,1	    text black,0.1,1.1,medium,1	    plot blue,cos(t),sin(t)	  
val24=crosshair $val11,$val12,10,blue	      text blue,$val13,$val14,large,M	      
!readproc oef/draw.phtml $val22,$val22 \
      $val23	      $val20	       
tmp0=$ins_url
val25=$(tmp0) 
!readproc slib/draw/convpixel $val11,$val12,$val22,$val22,-$val19,$val19,-$val19,$val19,0,pixels 
tmp0=$slib_out
val26=$(tmp0) 
val27=$[$(val26[1]) ]
val28=$[$(val26[2]) ]
replytype1=jsxgraphcurve

replyoption1=color1=black color2=green precision=8 
replyname1=
replygood1=$val25; points,$val27,$val28 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Cliquez sur le point 
!insmath M
$() du cercle associé à l'angle 
!insmath $val16 
$() par enroulement	de la droite réelle sur le cercle trigonométrique tracé ci dessous..</p>	    <div class="wimsquestion wimscenter">	        
!read oef/embed.phtml  reply1 ,400x400 
$()	    </div> 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval  $m_sc_reply1 !=1
 <div class='oef_feedbacks'>	<p>Le cercle vert sur la figure précédente était la bonne réponse.</p>	      <p>Rappel :</p>	      <div class="wimscenter"> 
!read oef/img.phtml $val1/cercletrigo0.png  
$().</div>	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=1,16
embedcnt=1
