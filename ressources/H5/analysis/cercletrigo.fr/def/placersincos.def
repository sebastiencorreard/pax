 <div class='oef_feedbacks'><br /> Voici la bonne réponse :	<div class="wimscenter"> 
!read oef/draw.phtml $val23,$val23 \
	xrange -$val21,$val21	yrange -$val21,$val21	$val25	$val28	$val24	$val27	disk $val12,$val13,10,green	text black,$val12-$val22,$val13-$val22,giant,B 
$()	</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,13,17,18,21,22,23,24,25,27,28,32
