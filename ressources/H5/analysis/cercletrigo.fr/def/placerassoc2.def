!set title=Placer un angle associé 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr

ansorder=r
varcnt=39
prevarcnt=38
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!if $val2= 
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
val6=$(tmp0)
!else
tmp=!nonempty items $val2,$val2

tmp0=!randitem $tmp
val6=$(tmp0)
!endif
val7=$[1]
val8=$[0]
tmp=!nonempty items 1/12,1/6,1/3,5/12

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items 1/2+$val9,-$val9

tmp0=!randitem $tmp
t_=!rawmath $(tmp0)
val9=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val9*pi

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
val11=$[cos($val10)]
val12=$[sin($val10)]
tmp0=!randint 1, 6

val13=$(tmp0)
tmp=!trim -\alpha,\frac{\pi}{2}-\alpha,\frac{\pi}{2}+\alpha,\pi-\alpha,\pi+\alpha,2\pi-\alpha	-$val10,pi/2-$val10,pi/2+$val10,pi-$val10,pi+$val10,2*pi-$val10
val14=!translate internal $	\
$ to ;; in $tmp
val15=$(val14[1;$val13])
val16=$(val14[2;$val13])
val17=$[cos($val16)]
val18=$[sin($val16)]
val19=1.3
val20=0.07
val21=400
val22=trange 0,2*pi	plot blue,cos(t),sin(t)
val23=
!for val13 =-6 to 6 
val24=$[cos($val13*pi/12)]
val25=$[sin($val13*pi/12)]
val23=$val23	line -$val24,-$val25,$val24,$val25,gray
!next
val26=
!for val13 =-4 to 4 
val26=$val26	line -1,$val13/4, 1,$val13/4,gray
!next
!for val13 =-4 to 4 
val26=$val26	line $val13/4,-1, $val13/4,1,gray
!next
val27=disk $val7,$val8,10,black	text black,$val7+$val20,$val8+2*$val20,giant,A	disk $val11,$val12,10,black	text black,$val11+$val20,$val12+2*$val20,giant,B	
val28=hline 0,0,black	arrow 0,0,$val19,0,10,black	arrow 0,0,0,$val19,10,black	vline 0,0,black	disk 0,0,10,black	text black,-2*$val20,-$val20,giant,O	
!if ($val3=) or ($val3=1) 
val29=$val26
!else
val29=$val23
!endif
!readproc oef/draw.phtml $val21,$val21 \
xrange -$val19,$val19	yrange -$val19,$val19	$val29	$val28	$val22	$val27 
tmp0=$ins_url
val30=$(tmp0)
val31=$[($val21*$val17/$val19+$val21)/2]
val32=$[(-$val21*$val18/$val19+$val21)/2]
val33=(\overrightarrow{OA},\overrightarrow{OM})
val34=(\overrightarrow{OA},\overrightarrow{OB})
replytype1=coord
replyname1=
replygood1=$val30;point,$val31,$val32
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Placer sur le cercle unité ci-dessous le point 
!insmath M
$() de sorte que l'angle 
!insmath $val33
$() ait une mesure égale à 
!insmath $val15
$(), où 
!insmath {\alpha}
$() désigne la mesure de l'angle 
!insmath $val34
$().	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_result1=-1
 <div class='oef_feedbacks'><br /> Voici la bonne réponse :	<div class="wimscenter"> 
!read oef/draw.phtml $val21,$val21 \
	xrange -$val19,$val19	yrange -$val19,$val19	$val29	$val28	$val22	$val27	disk $val17,$val18,10,green	text black,$val17-$val20,$val18-$val20,giant,M 
$()	</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=15,17,18,19,20,21,22,27,28,29,33,34
embedcnt=1
