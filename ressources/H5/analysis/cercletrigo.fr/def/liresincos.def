!set title= Enroulement : Lire les valeurs de cos et sin sur le cercle 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud;Communauté,MutuWIMS 
email=bmifsud@ac-aix-marseille.fr;communaute.mutuwims@laposte.net 
keywords=trigonometric_circle,trigonometry,angles,sinus,cosinus
language=fr
oefobservation=L'angle est compris entre \(-pi) et \(pi)

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1/6,1/3,2/3,1/4,1/2,3/4,5/6,0/1

t_=!rawmath $(tmp0) 
val6=!exec pari print($t_)
val7=$[rint(1 )]
tmp0=!randint -1, 1

val8=$[rint(0.5*$(tmp0) )]
tmp=!translate ";': to $     $ in $val6 + $val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0) 
val6=!exec pari print($t_)
t_=!replace internal \( by ( in [numerator($val6) , denominator($val6)]
tmp0=!exec pari $t_

val9=$(tmp0) 
val10=!rawmath $(val9[1])*pi/$(val9[2]) 
val11=$[($val7)*cos($val6*pi) ]
val12=$[($val7)*sin($val6*pi) ]
val13=$[1.1*$val11]
val14=$[1.1*$val12]
tmp=!translate ";': to $     $ in $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
val16=\frac{$(val9[1]) \pi}{$(val9[2])}
!if $(val9[2])=1 and $(val9[1])=1 
val16=\pi 
!endif
!if $(val9[2])=1 and $(val9[1])=-1 
val16=-\pi
!endif
!if $(val9[1])=0  
val16=0
!endif
!if $(val9[2])=1 and ($(val9[1])>1 or $(val9[1])<-1) 
val16=$(val9[1])\pi
!endif
!if $(val9[2])>1 and $(val9[1])=1  
val16=\frac{\pi}{$(val9[2])}
!endif
!if $(val9[2])>1 and $(val9[1])=-1  
val16=\frac{-\pi}{$(val9[2])}
!endif
tmp=!translate ";': to $     $ in cos($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp=!translate ";': to $     $ in sin($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
val19=$[1.3 ]
val20=
!for val21  = 1 to 5  
val20=$val20	dline -2*$val19*cos($val21*pi/6),-2*$val19*sin($val21*pi/6),2*$val19*cos($val21*pi/6),2*$val19*sin($val21*pi/6),blue	dline -2*$val19*cos($val21*pi/4),-2*$val19*sin($val21*pi/4), 2*$val19*cos($val21*pi/4),2*$val19*sin($val21*pi/4),green 
!next
val22=$[400 ]
val23=linewidth 2	    xrange -$val19, $val19	    yrange -$val19, $val19	    hline 0,0,black	    arrow 0,0,$val19,0,6,black	    arrow 0,0,0,$val19,6,black	    vline 0,0,black	    vline 0.5,0,grey	    vline -0.5,0,grey	    hline 0,0.5,grey	    hline 0,-0.5,grey	    trange 0,2*pi	    text black,0.1,0.1,medium,0	    text black,1.1,0.1,medium,1	    text black,0.1,1.1,medium,1	    plot blue,cos(t),sin(t)	  
val24=crosshair $val11,$val12,10,blue	      text blue,$val13,$val14,large,M	    dline $val11,0,$val11,$val12,red	    dline 0,$val12,$val11,$val12,red	    text black,0.5,0.1,medium,0.5	    crosshair 0.5,0,10,black	    text black,-0.5,0.1,medium,-0.5	    crosshair -0.5,0,10,black	    text black,0.1,0.5,medium,0.5	    crosshair 0,0.5,10,black	    text black,0.1,-0.5,medium,-0.5	    crosshair 0,0.5,10,black	      
tmp0=!randitem 1,2

val25=$[rint($(tmp0))]

!ifval $val25=1
val26=cosinus
!else
val26=sinus
!endif

!ifval $val25=1 
val27= $val17 
!else
val27= $val18
!endif
replytype1=algexp
replyname1=$val26
replygood1=$val27 
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Par lecture sur cercle trigonométrique, déterminer le $val26 de 
!insmath $val16 
$().	  <table>	  <tr> <td><div class="wimscenter">	      
!read oef/draw.phtml  $val22,$val22  \
	      $val23	      $val20	        
$()	       </td>	       <td>	     <div class="wims_question">	       Le $val26 de 
!insmath $val16 
$() vaut  
!read oef/embed.phtml reply1,10 
$() .	    </div>	    </td></tr>	    </table>	    <div class="wims_instruction">Si la bonne réponse est 
!insmath \sqrt{3}
$() saisir : sqrt(3). Aucune calculatrice n'est autorisée.</div>	    
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$() Voici la réponse, le point 
!insmath M
$() associé à 
!insmath $val16 
$() par enroulement	de la droite réelle sur le cercle trigonométrique est le point bleu sur la figure ci-dessous.	    <div class="wimscenter">	      
!read oef/draw.phtml  $val22,$val22  \
	      $val23	      $val20	      $val24	       
$() </div>	<p>Rappel :</p>	<p>L'abscisse du point 
!insmath M
$() est la valeur du cosinus.</p>	<p>L'ordonnée du point 
!insmath M
$() est la valeur du sinus</p>	<div class="wimscenter"> 
!read oef/img.phtml $val1/cercletrigo.png  
$().</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,16,20,22,23,24,26
embedcnt=1
