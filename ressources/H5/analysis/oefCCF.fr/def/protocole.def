!set title=1.2 (C2 et C4) Série stat à 2 var - fonction et dérivation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Moise,MULLER;Julien,LYOTARD
email=,Julien.Lyotard@ac-dijon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval Quel prix de vente moyen au m<sup>2</sup> peut-on prévoir en 2020 
val6=
!endif
val7=Une agence immobilière francilienne a récupéré un fichier contenant l'évolution des biens vendus	 sur la période 1991 - 2012. Les prix moyens de ventes sont calculés sur l'ensemble des 20	 arrondissements de Paris. Le gérant compte analyser les données pour prévoir l'évolution des prix	 à long terme et anticiper les fluctuations dues aux spéculateurs immobiliers.	Il assurera ainsi un service de qualité à ses clients en optimisant leurs profits.
val8=showToolBar=true	language=fr	customToolBar="0|40"	width=900	height=650	file=prixloyer.ggb	number=1	showAlgebraInput=false	enableRightClick=false	showToolBarHelp=false	
val9=<iframe scrolling="no" title="Évolution des prix des loyers" src="https://www.geogebra.org/material/iframe/id/ez592Mhv/width/900/height/650/border/888888/sfsb/true/smb/false/stb/false/stbh/false/ai/false/asb/false/sri/false/rc/false/ld/false/sdz/false/ctl/false" width="900px" height="650px" style="border:0px;"> </iframe></div>
tmp0=!record 0 of help/derive.txt

val10=$(tmp0)
tmp0=!record 0 of help/tableau.txt

val11=$(tmp0)
replytype1=symtext
replyoption1=nopunct nocs nomath noparentheses noquote 
replyname1=
replygood1=?analyze 12
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="encadre">	<div id="boited">	<img src="$val1/speculation3.jpg" alt="Spéculation immobilière" />	</div>	<p class="problematique"> $val6</p>	<div class="enonce">$val7 </div>	<br />	Après avoir regardé les ressources dans les liens suivants, répondre aux différentes questions.	<div></div>	<div class="wimscenter"> 
!read oef/special.phtml help derive, Ressource 1 
$()	 
!read oef/special.phtml help tableau, Ressource 2 
$()	 
!read oef/special.phtml help geogebra, Ressource 3 
$()	</div>	<br />	<div class="question">	Proposer un protocole qui permet de vérifier les données du modèle 1. <br/>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	<br/>	<div style="padding-left:70%;"><img src="$val1/Appel.jpg" alt="Appel" /><span style="font-weight:bold; text-decoration:underline">Appel 1 :</span>	 Présenter votre réponse à l'enseignant.</div>	</div>	<div style="padding-left:70%;"><img src="$val1/attention.png" alt="Attention" />	<b>Penser à transmettre le(s) fichier(s) réalisés à l'enseignant.</b></div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()	
!if  $m_help_subject issametext derive 
$()$val10 
!endif
$()	
!if  $m_help_subject issametext tableau 
$()	<div style="border: 2px solid var(--wims_bgcolor);margin:10px;padding:30px;border-radius 0px 0px 40px 40px;text-align: justify;line-height: 2em;background-color: var(--wims_ref_bgcolor);text-indent: 0px;">	<h2 class="wimscenter">Prix au m<sup>2</h2>	Après une petite recherche sur internet, on trouve le tableau suivant :	<a href="$val1/Tableau.ods">Évolution des prix au m<sup>2</sup></a> <br />	Prix au m<sup>2</sup> des appartements anciens par arrondissement<br />	Appartements anciens vendus libre de gré à gré en pleine propriété <br />	Indices Notaires - INSEE à base trimestrielle.	<br />&nbsp;&nbsp;<span style="font-weight:bold; text-decoration:underline">Source :</span> <a href=" http://www.base-bien.com" target="wims_external">Base-bien.com</a>	</div> 
!endif
$()	
!if  $m_help_subject issametext geogebra 
$()	<div style="border: 2px solid var(--wims_bgcolor);margin:10px;padding:30px;border-radius 0px 0px 40px 40px;text-align: justify;line-height: 2em;background-color: var(--wims_ref_bgcolor);text-indent: 0px;">	<h2 class="wimscenter">Modélisation des données</h2>	$val9	</div> 
!endif
$()
$()
!exit

