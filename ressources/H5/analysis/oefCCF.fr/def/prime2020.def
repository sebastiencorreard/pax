!set title=2.3 (C3) Série stat à 2 var - suites
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Julien,LYOTARD
email=julien.lyotard@ac-dijon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=COMMENT ESTIMER LA PRIME D'ASSURANCE DE LA VOITURE EN 2020 ?
val7=En consultant sur internet les bases de données de l'Institut national de la statistique	 et des études économiques (INSEE), on trouve l'évolution des primes d'assurances voitures. Le tableau	 donné en ressource présente le prix annuel de l'assurance voiture avec un prix de base de	 500 € en 2000. Elle ne tient pas compte des bonus malus que peuvent obtenir les conducteurs	 durant cette période.
tmp0=!record 0 of help/suite.txt

val8=$(tmp0)
replytype1=numeric
replyname1=Prime en 2020 :
replygood1=$[539.81]
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="encadre">	<div id="boiteg">	<img src="$val1/assurance.png" alt="Assurance voiture" />	</div>	<p class="problematique"> $val6</p>	<div class="enonce">$val7 </div>	<br />	Après avoir regardé les ressources dans les liens suivants, répondre aux différentes questions.	<div></div>	<div class="wimscenter"><a class="bouton" href="$val1/Tableau2.ods">Ressource 1</a>	 
!read oef/special.phtml help suite, Ressource 2 
$()	</div>	<br />	<div class="enonce">Le graphique obtenu aux questions précédentes est donné ci-dessous :	<br />	<div class="wimscenter">	<img src="$val1/corgraph.jpg" alt="Spéculation immobilière" />	</div>	</div>	<br />	<div class="question">	Si l'évolution perdure, déterminer la prime d'assurance en 2020.	<div class="wimscenter"> 
!read oef/embed.phtml reply1,10 
$() &euro;</div>	</div>	</div>
$()
!exit

