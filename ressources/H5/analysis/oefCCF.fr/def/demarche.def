!set title=2.1 (C2) Série stat à 2 var - suites
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Julien,LYOTARD
email=julien.lyotard@ac-dijon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=COMMENT ESTIMER LA PRIME D'ASSURANCE DE LA VOITURE EN 2020 ?
val7=En consultant sur internet les bases de données de l'Institut national de la statistique	 et des études économiques (INSEE), on trouve l'évolution des primes d'assurances voitures. Le tableau	 donné en ressource présente le prix annuel de l'assurance voiture avec un prix de base de	 500 € en 2000. Elle ne tient pas compte des bonus malus que peuvent obtenir les conducteurs	 durant cette période.
tmp0=!record 0 of help/suite.txt

val8=$(tmp0)
replytype1=symtext
replyoption1=nopunct nocs nomath noparentheses noquote 
replyname1=
replygood1=?analyze 9
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="encadre">	<div id="boiteg">	<img src="$val1/assurance.png" alt="Assurance voiture" />	</div>	<p class="problematique"> $val6</p>	<div class="enonce">$val7 </div>	<br />	Après avoir regardé les ressources dans les liens suivants, répondre aux différentes questions.	<div></div>	<div class="wimscenter"><a class="bouton" href="$val1/Tableau2.ods">Ressource 1</a>	 
!read oef/special.phtml help suite, Ressource 2 
$()	</div>	<br />	<div class="question">	Présenter une méthode rapide et détaillée pour répondre à la problématique de départ.<br />	<div style="padding-left:30px;font-style:italic;font-size:10px;"><img src="$val1/attention.png" alt="Attention" />	 La précision et la rigueur de la démarche tiendront pour une partie importante de la notation.</div>	<div class="wimscenter"> 
!read oef/embed.phtml reply1,6x50 
$()</div>	<br />	<div style="padding-left:70%;"><img src="$val1/Appel.jpg" alt="Appel" /><span class="bold" style="text-decoration: underline">Appel 1 :</span>	 Présenter la démarche choisie à l'examinateur.</div>	</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
!if $m_help_subject issametext suite 
$()$val8 
!endif
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval nuage de points isin $val9 and (courbe de tendance isin $val9 or droite de tendance isin $val9) and équation isin $val9
 condtest1=1
!else
 condtest1=0
!endif
condname1=Pour estimer la prime d'assurance\(,) on réalise un <u>nuage de points</u> puis la <u>droite de tendance</u>. On détermine l'<u>équation</u> de cette droite.	 Une simple substitution de x par sa valeur en 2020 permet de déterminer le montant prévisionnel de la prime.

!exit

:stat
vsavelist=1,6,7,8,9
embedcnt=2
