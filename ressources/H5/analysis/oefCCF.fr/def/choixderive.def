!set title=1.4 (C2) Série stat à 2 var - fonction et dérivation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Moise,MULLER;Julien,LYOTARD
email=,Julien.Lyotard@ac-dijon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval Quel prix de vente moyen au m<sup>2</sup> peut-on prévoir en 2020 
val6=
!endif
val7=Une agence immobilière francilienne a récupéré un fichier contenant l'évolution des biens vendus	 sur la période 1991 - 2012. Les prix moyens de ventes sont calculés sur l'ensemble des 20	 arrondissements de Paris. Le gérant compte analyser les données pour prévoir l'évolution des prix	 à long terme et anticiper les fluctuations dues aux spéculateurs immobiliers.	Il assurera ainsi un service de qualité à ses clients en optimisant leurs profits.
val8=showToolBar=true	language=fr	customToolBar="0|40"	width=900	height=650	file=prixloyer.ggb	number=1	showAlgebraInput=false	enableRightClick=false	showToolBarHelp=false	
val9=<iframe scrolling="no" title="Évolution des prix des loyers" src="https://www.geogebra.org/material/iframe/id/ez592Mhv/width/900/height/650/border/888888/sfsb/true/smb/false/stb/false/stbh/false/ai/false/asb/false/sri/false/rc/false/ld/false/sdz/false/ctl/false" width="900px" height="650px" style="border:0px;"> </iframe></div>
tmp0=!record 0 of help/derive.txt

val10=$(tmp0)
tmp0=!record 0 of help/tableau.txt

val11=$(tmp0)
val12=!rawmath -0.017x³+3.91x²-152.58x+4205.82
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
replytype1=radio
replyoption1=shuffle split 
replyname1=Modèle le plus simple :
replygood1=?analyze 14;Modèle 1, Modèle 2,Modèle 3
replytype2=radio
replyoption2=shuffle split 
replyname2=Modèle proche réalité :
replygood2=?analyze 15;Modèle 1, Modèle 2,Modèle 3
replytype3=formal
replyname3=Fonction dérivée
replygood3=$val13
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="encadre">	<div id="boited">	<img src="$val1/speculation3.jpg" alt="Spéculation immobilière" />	</div>	<p class="problematique"> $val6</p>	<div class="enonce">$val7 </div>	<br />	Après avoir regardé les ressources dans les liens suivants, répondre aux différentes questions.	<br /><br />	<div class="wimscenter"> 
!read oef/special.phtml help derive, Ressource 1 
$()	 
!read oef/special.phtml help tableau, Ressource 2 
$()	 
!read oef/special.phtml help geogebra, Ressource 3 
$()	</div>	<br />	<div class="question">	Quel est le modèle le plus simple à utiliser ?	<ul>	 
!for m_h = 1 to 3 
$()<li> 
!read oef/embed.phtml reply1,\h 
$()</li> 
!next
$()	</ul>	Quel est le modèle qui semble être le plus proche des variations de prix ?	<ul>	 
!for m_h = 1 to 3 
$()<li> 
!read oef/embed.phtml reply2,\h 
$()</li> 
!next
$()	</ul>	</div>	<div class="enonce">	L'agence immobilière utilise le modèle 3 pour établir ses prévisions. Afin de cibler les	spéculateurs immobiliers, elle cherche à connaître la période pendant laquelle les prix ont le	plus augmenté.	</div>	<div class="question">	<p>Le modèle mathématique utilisé est la fonction 
!insmath f(x)=$val12
$().</p>	Déterminer la fonction dérivée de 
!insmath f(x)
$() :	<div class="wimscenter">
!insmath f'(x)=
$() 
!read oef/embed.phtml reply3,30 
$()</div>	</div>	<div style="padding-left:70%;"><img src="$val1/attention.png" alt="Attention" />	<b>Penser à transmettre le(s) fichier(s) réalisés à l'enseignant.</b></div>	</div>
$()
!exit

