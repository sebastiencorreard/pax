!set title=Somme des termes d'une suite arithmétique	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randint 15, 30

val10=$[rint($val9+$(tmp0))]
val11=$[rint($val7+($val8)*($val9))]
val12=$[rint($val7+($val8)*($val10))]
val13=$[rint(($val11+$val12)*($val10-$val9+1)/2)]
!if $val6=1 
val14=$[rint($val13)]
!endif
!if $val6=2 
val14=$[rint($val8)]
!endif
!if $val6=3 
val14=$[rint($val7)]
!endif
replytype1=default
replyname1=Réponse
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$m_a1	
!if $val6=1 
$()On considère une suite arithmétique telle que 
!insmath u_{$val9}=$val11
$() et 
!insmath u_{$val10}=$val12
$().	<br/> Calculer la somme : 	
!insmath {\displaystyle S=\sum_{k=$val9}^{$val10} u_k = u_{$val9}+\cdots + u_{$val10} }
$()	<p class="wimscenter">	On a 
!insmath S=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>	 
!endif
$()	
!if $val6=2 
$()	On considère une suite arithmétique telle que 
!insmath u_{$val9}=$val11
$() et 	<p class="wimscenter">	
!insmath {\displaystyle S=\sum_{k=$val9}^{$val10} u_k=u_{$val9}+\cdots + u_{$val10} =$val13}
$().	</p>	Déterminer la raison de cette suite:	<p class="wimscenter">	On a 
!insmath r=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>	 
!endif
$()	
!if $val6=3 
$()	On considère une suite arithmétique telle que 
!insmath u_{$val9}=$val11
$() et 
!insmath {\displaystyle S=\sum_{k=$val9}^{$val10} u_k=$val13}
$(). 	Déterminer le terme initial de cette suite:	<p class="wimscenter">	On a 
!insmath u_0=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>	 
!endif
$()		
$()
!exit

:hint
$() On pourra utiliser la formule 
!insmath u_n+...+u_{n+p} = (p+1)*\frac{u_{n+p}+u_n}{2}
$(), c'est-à-dire nombre de termes * la moyenne des termes extrèmes.	
$()
!exit

