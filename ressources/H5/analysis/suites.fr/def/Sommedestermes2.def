!set title=Somme des termes d'une suite géométrique	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 6, 8

val10=$[rint($val9+$(tmp0))]
val11=$[$val7*($val8)^($val9)]
val12=$[$val7*($val8)^($val10)]
!if $val8=1 
t_=!rawmath ($val10-$val9+1)*$val11
val13=!exec pari print($t_)
!else
val13=$[($val11-$val12*$val8)/(1-$val8)]
!endif
replytype1=default
replyname1=Réponse
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère une suite géométrique de raison $val8 telle que 
!insmath u_{$val9}=$val11
$(). Calculer la somme 	
!insmath u_{$val9}+ \cdots + u_{$val10}
$().	<p class="wimscenter">	On a 
!insmath S=
$()  
!read oef/embed.phtml reply 1,16 
$()	</p>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11
embedcnt=1
