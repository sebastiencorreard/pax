!set title=Somme d'entiers
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -200, 20

val6=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint($val6+$val7)]
tmp0=!randint 20, 40

val9=$[rint($(tmp0))]
val10=$[rint($val6+$val7*$val9)]
t_=!replace internal \( by ( in sum(i=0,$val9,$val6+i*$val7)
tmp0=!exec pari $t_

val11=$[rint($(tmp0))]
replytype1=default
replyname1=S
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la somme suivante, sachant que les termes de cette	somme sont les termes d'une suite arithmétique.<br/>	<p class="wimscenter">	
!insmath S=$val6+$val8+...+$val10
$()	</p>	On a 
!insmath S=
$()  
!read oef/embed.phtml reply 1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()Pour calculer la somme des termes d'une suite arithmétique, 	il faut connaitre le nombre de termes intervenants dans cette suite. Pour cela	on peut utiliser l'expression 
!insmath u_n=u_0+n.r
$().
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

