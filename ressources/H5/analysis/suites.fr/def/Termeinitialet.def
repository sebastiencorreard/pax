!set title=Terme initial et raison d'une suite arithmétique	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randint 2, 6

val10=$[rint($val9+$(tmp0))]
val11=$[rint($val7+$val9*$val8)]
val12=$[rint($val7+$val10*$val8)]
!if $val6=1 
val13=le terme initial
val14=u_0
val15=$[rint($val7)]
!else
val13=la raison
val14=r
val15=$[rint($val8)]
!endif
replytype1=default
replyname1=Réponse
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère une suite arithmétique telle que 
!insmath u_{$val9}=$val11
$() et 
!insmath u_{$val10}=$val12
$(). Déterminer $val13 de cette suite.	<p class="wimscenter">	On a 
!insmath $val14=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>		
$()
!exit

