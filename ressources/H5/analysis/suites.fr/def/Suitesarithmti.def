!set title=Suites arithmétique	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
val6=$[rint(2)]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
!if $val6=1 
tmp0=!randint 2, 5

val9=$[rint($(tmp0))]
val10=$[rint($val7*($val8)^$val9)]
val11=géométrique
!else
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
val10=$[rint($val7+$val9*$val8)]
val11=arithmétique
!endif
replytype1=default
replyname1=Réponse
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer le terme de rang $val9 de la suite $val11 
!insmath (u_n)_{n \in \mathbb{N}}
$() 	de terme initial 
!insmath u_0=$val7
$() et de raison $val8.	<p class="wimscenter">	On a 
!insmath u_$val9=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>		
$()
!exit

:hint
$()La formule explicite du terme d'ordre 
!insmath n
$() d'une suite arithmétique de raison q et de premier terme 
!insmath u_0
$() est 	<p>	 
!insmath u_n= u_0 +n*q 
$() 	</p>		
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,11
embedcnt=1
