!set title=Signe des termes d'une suite arithmétique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 2, 10

val7=$[rint((-1)^($val6+1)*$(tmp0))]
tmp0=!randint 100, 1000

val8=$[rint($(tmp0)*(-1)^($val6))]
val9=$[rint(floor(-$val8/$val7)+1)]
tmp0=!item $val6 of négatifs,positifs

val10=$(tmp0)
replytype1=default
replyname1=t
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la suite arithmétique 
!insmath (u_n)
$(), dont le terme initial	est 
!insmath $val8
$() et la raison 
!insmath $val7
$(). Combien cette suite possède-t-elle de termes	$val10 ?<br/>	Cette suite possède  
!read oef/embed.phtml reply 1,10 
$() termes $val10.
$()
!exit

:hint
$()On pourra écrire la formule explicite du terme 
!insmath u_n
$() et résoudre une inéquation ...	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10
embedcnt=1
