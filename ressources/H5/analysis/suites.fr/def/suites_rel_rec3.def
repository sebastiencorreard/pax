!set title=Comportement asymptotique d'une suite récurrente	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
computeanswer=yes
precision=1000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint -4, 4

tmp1=!randint -4, 4

val7=$[2^$(tmp0)*5^$(tmp1)]
val8=$[1/$val7]
!if $val6=1 
tmp0=!random -$val8, $val8

val9=$[$(tmp0)]
!endif
!if $val6=2 
tmp0=!randitem -1,1

val10=$[rint($(tmp0))]
val9=$[$val10*$val8]
!endif
!if $val6=3 
tmp0=!random 1.1, 10

val11=$[$(tmp0)]
tmp0=!randitem -1,1

val9=$[$(tmp0)*$val8*$val11]
!endif
val12=converger vers 0,	converger vers $val8,	diverger	
replytype1=menu
replyname1=Réponse
replygood1=$val6;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la suite 
!insmath (u_n)
$() définie par 
!insmath u_0=$val9
$() et par la relation de récurrence 
!insmath u_{n+1}=a u_n^2
$(), 
!insmath a
$() étant un réel fixé.<br/>	En utilisant le graphique ci-dessous, effectuer une conjecture relativement au comportement asymptotique de la suite 
!insmath (u_n)
$().<br/>	La suite 
!insmath (u_n)
$() semble  
!read oef/embed.phtml reply 1,5 
$()<br/>	<p class="wimscenter">	 
!read oef/draw.phtml 200,300 \
	xrange -2,2	yrange -4,5	linewidth 2	line -10,0,10,0,black	line 0,-10,0,10,black	linewidth 2	plot red,x^2	plot blue,x	 
$()<br/>	Les abscisses des points d'intersection de 
!insmath C:y=a x^2
$() et 
!insmath d:y=x
$() sont 0 et $val8.	</p>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=1
