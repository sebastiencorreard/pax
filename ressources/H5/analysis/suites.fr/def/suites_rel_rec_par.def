!set title=Récurrence particulière
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*n+$val8
tmp0=!exec maxima $t_

val10=!rawmath $(tmp0)

!ifval $val2= 
val11=$[rint( 2)]
!else
val11=$[rint($val2)]
!endif
tmp0=!randint 2, $val11

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in 	%m=matrix(1,6);	%m[1,1]=$val9;	%for(i=2,6,m[1,i]=$val6*m[1,i-1]+$val7*(i-2)+$val8);	%print(m);	%
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
val14=$[rint($(val13[1;$val12+1]))]
val15=$[rint($val6*$val9+$val7*0+$val8)]
val16=$[rint($val6*$val15+$val7*1+$val8)]
t_=!replace internal \( by ( in $val6*x+$val7*y+$val8
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
tmp0=!replace internal y by n in $val17

val17=$(tmp0)
tmp0=!replace internal x by u_n in $val17

val17=$(tmp0)
tmp0=!texmath $val17

val18=$(tmp0)
replytype1=default
replyname1=Réponse u_1
replygood1=$val15
replytype2=default
replyname2=Réponse u_2
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la suite 
!insmath (u_n)
$() définie par 
!insmath u_0=$val9
$() et  la 	relation de récurrence 	<p class="wimscenter">	
!insmath u_{n+1}=$val18
$()	</p>	Calculer 
!insmath u_1
$() et 
!insmath u_2
$() .<br/>	<p class="wimscenter">	Le terme 
!insmath u_1
$()  vaut 
!insmath \;\;
$()  
!read oef/embed.phtml reply 1,5 
$()	</p>	<p class="wimscenter">	Le terme 
!insmath u_2
$()  vaut 
!insmath \;\;
$()  
!read oef/embed.phtml reply 2,5 
$()	</p>	
$()
!exit

:hint
$()Prenez garde à la formule de récurrence, si on exprime 
!insmath u_{n+1}
$() en fonction  de 
!insmath u_n
$() et 
!insmath n
$(), l'entier 
!insmath n
$() 	est l'entier qui précède 
!insmath n+1
$()...
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

