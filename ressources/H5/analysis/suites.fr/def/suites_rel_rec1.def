!set title=Utilisation d'une relation de récurrence	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 4, 8

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
val9=!rawmath $val6*x+$val8
tmp0=!randint 2, 4

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in subst($val9,x,subst($val9,x,a))
tmp0=!exec pari $t_

val11=!rawmath $(tmp0)
replytype1=default
replyname1=Réponse
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la suite 
!insmath (u_n)_{n \in \mathbb{N}}
$() définie par  la relation de récurrence 
!insmath u_{n+1}=f(u_n)
$() 	avec 
!insmath f(x)=$val9
$() et de premier terme 
!insmath u_0 = a
$().	<br/>	Exprimer 
!insmath u_2
$() en fonction de 
!insmath a
$().<br/>	<p class="wimscenter">	
!insmath u_2=
$()  
!read oef/embed.phtml reply 1,10 
$()	</p>	
$()
!exit

