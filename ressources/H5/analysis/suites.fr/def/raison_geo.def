!set title=Raison d'une suite géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 10

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 2, 4

tmp2=!randitem -1,1

tmp3=!randint 0, 3

tmp4=!randitem -1,1

tmp5=!randint 2, 4

tmp6=!randitem -1,1

tmp7=!randint 0, 3

val8=$(tmp0)*$(tmp1),$(tmp2)*$(tmp3),$(tmp4)*$(tmp5),$(tmp6)*$(tmp7)
tmp0=!item 1 of $val8

val6=$(tmp0)
tmp0=!item 1 of $val8

tmp1=!item 2 of $val8

t_=!replace internal \( by ( in ($(tmp0)*n+$(tmp1))
tmp2=!exec maxima $t_

val9=!rawmath $(tmp2)
tmp0=!item 3 of $val8

tmp1=!item 4 of $val8

t_=!replace internal \( by ( in ($(tmp0)*n+$(tmp1))
tmp2=!exec maxima $t_

val10=!rawmath $(tmp2)
tmp0=!texmath $val9

val11=$(tmp0)
tmp0=!texmath $val10

val12=$(tmp0)
tmp0=!item 1 of $val8

tmp1=!item 3 of $val8

t_=!replace internal \( by ( in a^($(tmp0))/b^($(tmp1))
tmp2=!exec maxima $t_

val13=!rawmath $(tmp2)
tmp0=!item 2 of $val8

tmp1=!item 4 of $val8

t_=!replace internal \( by ( in a^($(tmp0))/b^($(tmp1))
tmp2=!exec maxima $t_

val14=!rawmath $(tmp2)
replytype1=formal
replyname1=q
replygood1=$val13,a,b,n
replytype2=formal
replyname2=u0
replygood2=$val14,a,b,n
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On considère la suite géométrique 
!insmath (u_n)
$(), définie par la relation	<p class="wimscenter">	
!insmath u_n = \frac{a^{$val11}}{b^{$val12}}
$()	</p>	La suite 
!insmath (u_n)
$() est une suite géométrique de raison 
!insmath q=
$() 
!read oef/embed.phtml repy 1,10 
$() 	et dont le terme inital est 
!insmath u_0=
$()  
!read oef/embed.phtml reply 2, 10 
$().	
$()
!exit

:hint
$()Pour calculer la raison vous pouvez soit faire le rapport de deux termes consécutifs, soit exprimer 
!insmath u_n
$() sous la forme 
!insmath u_0*q^n
$().	Le calcul de 
!insmath u_0
$() ne pose pas de difficultés ! 	
$()
!exit

