!set title=Suites récurrentes et sens de variation	
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,1

val6=$[rint($(tmp0))]
tmp0=!randitem 0,1

val7=$[rint($(tmp0))]
val8=$[rint(2*$val6+$val7+1)]
tmp0=!randint -9, 9

val9=$[rint($(tmp0))]
!if $val6=0 
tmp0=!randint -7, $val9

val10=$[rint($(tmp0)-2)]
!else
tmp0=!randint $val9, 7

val10=$[rint($(tmp0)+2)]
!endif
!if $val7=0 
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
!else
tmp0=!randint 4, 17

val11=$[$(tmp0)/20]
!endif
val12=$[$val9-$val11*$val9]
t_=!replace internal \( by ( in $val11*x+$val12
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp=!trim 2,1,1,2
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!trim -\infty,$val9,+\infty,$val9
val15=!translate internal $	\
$ to ;; in $tmp
val16=$(val14[$val8])
val17=$(val15[$val8])
oefsteps=reply 1	reply 2 
nextstep=!nosubst reply 1	reply 2 
!readproc oef/steps.proc
replytype1=menu
replyname1=Réponse
replygood1=$val16;croissante,décroissante
replytype2=dragfill
replyname2=Limite
replygood2=\($val17);\($val9),\(+\infty),\(-\infty)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère la suite 
!insmath (u_n)
$() définie par 
!insmath u_0=$val10
$() et par la relation de récurrence 
!insmath u_{n+1}=f(u_n)
$() 	avec 
!insmath f
$() fonction affine.<br/>	<p class="wimscenter">	 
!read oef/draw.phtml 200,200 \
	xrange -10,10	yrange -10,10	parallel -10,-10,-10,10,1,0,21,black	parallel -10,-10,10,-10,0,1,21,black	linewidth 2	line -10,0,10,0,black	line 0,-10,0,10,black	linewidth 2	plot red,$val11*x+$val12	plot blue,x	 
$()<br/>		La fonction 
!insmath f
$() est représentée en rouge, une graduation correspondant à une unité.	</p>	
!if $m_step=1 
$()En utilisant le graphique, conjecturer le sens de variations de la suite 
!insmath (u_n)
$().<br/>	La suite 
!insmath (u_n)
$() semble être  
!read oef/embed.phtml reply 1,5 
$()<br/>	 
!endif
$()	
!if $m_step=2 
$()	Quelle semble être la limite de la suite 
!insmath (u_n)
$() ?	<p class="wimscenter">	 
!read oef/embed.phtml reply 2,50 40 
$()	</p>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12
embedcnt=2
