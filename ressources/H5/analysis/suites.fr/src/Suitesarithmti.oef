\integer{al=random(1..2)}
\integer{al=2}
\integer{u0=randint(-5..5)}
\integer{q=random(-1,1)*randint(1..5)}
\if{\al=1}{
\integer{n=randint(2..5)}
\integer{sol=\u0*(\q)^\n}
\text{type=géométrique}
}
{
\integer{n=randint(2..10)}
\integer{sol=\u0+\n*\q}
\text{type=arithmétique}
}

\statement{Déterminer le terme de rang \n de la suite \type \((u_n)_{n \in \mathbb{N}}) 
de terme initial \(u_0=\u0) et de raison \q.
<p class="wimscenter">
On a \(u_\n=) \embed{reply 1,10}
</p>

}

\answer{Réponse}{\sol}{type=default}

\hint{La formule explicite du terme d'ordre \(n) d'une suite arithmétique de raison q et de premier terme \(u_0) est 
<p>
 \(u_n= u_0 +n*q ) 
</p>

}
