\title{Suites arithmétiques et géométriques
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}









\integer{al=random(1..2)}
\integer{u0=random(-1,1)*randint(1..10)}
\if{\al=1}{\integer{q=random(-1,1)*randint(10..50)}}{\integer{q=random(-1,1)*randint(1..4)}}

\integer{n1=randint(2..7)}
\integer{n2=\n1+1}
\integer{aln=random(1,2)}

\if{\aln=1}{
\integer{n3=\n2+1}
}
{
\integer{n3=\n1-1}
}

\if{\al=1}
{
\integer{u1=\u0+\n1*(\q)}
\integer{u2=\u1+\q}
\text{type=arithmétique}
\if{\aln=1}{\rational{sol=\u2+\q}}{\rational{sol=\u1-\q}}
}
{
\integer{u1=\u0*(\q)^(\n1)}
\integer{u2=\u1*(\q)}
\text{type=géométrique}
\if{\aln=1}{\rational{sol=\u2*\q}}{\rational{sol=\u1/\q}}
}




\statement{On considère une suite <b>\type</b> telle que \(u_{\n1}=\u1) et \(u_{\n2}=\u2). Calculer \(u_{\n3}):
<p class="wimscenter">
On a \(u_{\n3}=) \embed{reply 1,16}
</p>

}

\answer{Réponse}{\sol}{type=default}
