\title{Signe des termes d'une suite arithmétique}
\author{Frédéric, Pitoun}
\integer{p=random(1..2)}

\integer{r=(-1)^(\p+1)*randint(2..10)}
\integer{u=randint(100..1000)*(-1)^(\p)}

\integer{t=floor(-\u/\r)+1}

\text{signe=item(\p,négatifs,positifs)}

\statement{On considère la suite arithmétique \((u_n)), dont le terme initial
est \(\u) et la raison \(\r). Combien cette suite possède-t-elle de termes
\signe ?<br/>
Cette suite possède \embed{reply 1,10} termes \signe.}

\answer{t}{\t}{type=default}
\hint{On pourra écrire la formule explicite du terme \(u_n) et résoudre une inéquation ...
}
