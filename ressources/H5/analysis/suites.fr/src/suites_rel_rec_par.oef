\title{Récurrence particulière}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=randint(-1,1)*randint(1..5)}
\integer{b=randint(1..5)}
\integer{c=randint(-1,1)*randint(1..5)}

\integer{u0=randint(-5..5)}
\function{f=maxima(\b*n+\c)}
\integer{p=\confparm1= ? 2:\confparm1}
\integer{n=randint(2..\p)}

% Il est suffisant de leur calculer simplement les termes u_1 et u_2. Du coup on peut faire un calcul plus élémentaire dans WIMS
%\matrix{suite=pari(
%m=matrix(1,6);
%m[1,1]=\u0;
%for(i=2,6,m[1,i]=\a*m[1,i-1]+\b*(i-2)+\c);
%print(m);
%)}

%\integer{rep=\suite[1;\n+1]}
\integer{rep1=\a*\u0+\b*0+\c}
\integer{rep2=\a*\rep1+\b*1+\c}

\function{fonc=maxima(\a*x+\b*y+\c)}
\text{fonc=wims(replace internal y by n in \fonc)}
\text{fonc=wims(replace internal x by u_n in \fonc)}

\text{rel=texmath(\fonc)}







\statement{
On considère la suite \((u_n)) définie par \(u_0=\u0) et  la 
relation de récurrence 
<p class="wimscenter">
\(u_{n+1}=\rel)
</p>
Calculer \(u_1) et \(u_2) .<br/>
<p class="wimscenter">
Le terme \(u_1\)  vaut \(\;\;\) \embed{reply 1,5}
</p>
<p class="wimscenter">
Le terme \(u_2\)  vaut \(\;\;\) \embed{reply 2,5}
</p>
}


\answer{Réponse u_1}{\rep1}{type=default}
\answer{Réponse u_2}{\rep2}{type=default}

\hint{Prenez garde à la formule de récurrence, si on exprime \(u_{n+1}) en fonction  de \(u_n) et \(n), l'entier \(n) 
est l'entier qui précède \(n+1)...}
