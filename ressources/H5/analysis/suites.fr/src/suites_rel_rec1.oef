\title{Utilisation d'une relation de récurrence
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=random(-1,1)*randint(4..8)}
\integer{b=random(-5..5)}
\integer{c=random(-1,1)*randint(1..5)}

\function{f=\a*x+\c}

\integer{n=randint(2..4)}

\function{sol=pari(subst(\f,x,subst(\f,x,a)))}

\statement{
On considère la suite \((u_n)_{n \in \mathbb{N}}) définie par  la relation de récurrence \(u_{n+1}=f(u_n)) 
avec \(f(x)=\f) et de premier terme \(u_0 = a).
<br/>
Exprimer \(u_2) en fonction de \(a).<br/>
<p class="wimscenter">
\(u_2=) \embed{reply 1,10}
</p>
}


\answer{Réponse}{\sol}{type=default}
