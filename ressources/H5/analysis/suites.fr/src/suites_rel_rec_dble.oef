\title{Récurrence double}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=randint(-1,1)*randint(1..5)}
\integer{b=randint(1..5)}

\integer{u0=randint(-5..5)}
\integer{u1=randint(-5..5)}
\integer{p=\confparm1= ? 2:\confparm1}
\integer{n=random(2..\p)}

\matrix{suite=pari(
m=matrix(1,6);
m[1,1]=\u0;
m[1,2]=\u1;
for(i=3,6,m[1,i]=\a*m[1,i-1]+\b*m[1,i-2]);
print(m);
)}

\integer{rep=\suite[1;\n+1]}





\text{A=slib(text/comblin [\a,\b],[u_{n+1},u_n])}


\statement{
On considère la suite \((u_n)_{n\in\mathbb{N}}) définie par \(u_0=\u0), \(u_1=\u1) et  la relation de récurrence

<p class="wimscenter">
\(u_{n+2}=\A)
</p>
  

 <br/>
Calculer \(u_\n).<br/>
<p class="wimscenter">
Le terme  \(u_\n) vaut \embed{reply 1,5}<br/>
</p>
}


\answer{Réponse}{\rep}{type=default}
