\title{Comportement asymptotique d'une suite récurrente
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a1=random(1..3)}

\real{a=2^randint(-4..4)*5^randint(-4..4)}
\real{l=1/\a}



\if{\a1=1}
{
\real{u=random(-\l..\l)}
}
\if{\a1=2}
{
\integer{s=randint(-1,1)}
\real{u=\s*\l}
}
\if{\a1=3}
{
\real{v=random(1.1..10)}
\real{u=randint(-1,1)*\l*\v}
}



\text{reponses=
converger vers 0,
converger vers \l,
diverger
}



\statement{
On considère la suite \((u_n)) définie par \(u_0=\u) et par la relation de récurrence \(u_{n+1}=a u_n^2), \(a) étant un réel fixé.<br/>
En utilisant le graphique ci-dessous, effectuer une conjecture relativement au comportement asymptotique de la suite \((u_n)).<br/>
La suite \((u_n)) semble \embed{reply 1,5}<br/>
<p class="wimscenter">
\draw{200,300}{
xrange -2,2
yrange -4,5
linewidth 2
line -10,0,10,0,black
line 0,-10,0,10,black
linewidth 2
plot red,x^2
plot blue,x
}<br/>
Les abscisses des points d'intersection de \(C:y=a x^2) et \(d:y=x) sont 0 et \l.
</p>

}


\answer{Réponse}{\a1;\reponses}{type=menu}

