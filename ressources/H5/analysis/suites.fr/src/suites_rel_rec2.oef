\title{Suites récurrentes et sens de variation
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a1=random(0,1)}
\integer{a0=random(0,1)}
\integer{v=2*\a1+\a0+1}

\integer{l=random(-9..9)}

\if{\a1=0}
{\integer{u=random(-7..\l)-2}}
{\integer{u=random(\l..7)+2}}

\if{\a0=0}
{\integer{a=random(2..4)}}
{\real{a=randint(4..17)/20}}

\real{b=\l-\a*\l}

\function{f=maxima(\a*x+\b)}

\matrix{solutions=2,1,1,2}
\matrix{limites=-\infty,\l,+\infty,\l}
\text{rep=\solutions[\v]}
\text{n=\limites[\v]}



\steps{
reply 1
reply 2
}

\statement{
On considère la suite \((u_n)) définie par \(u_0=\u) et par la relation de récurrence \(u_{n+1}=f(u_n)) 
avec \(f) fonction affine.<br/>
<p class="wimscenter">
\draw{200,200}{
xrange -10,10
yrange -10,10
parallel -10,-10,-10,10,1,0,21,black
parallel -10,-10,10,-10,0,1,21,black
linewidth 2
line -10,0,10,0,black
line 0,-10,0,10,black
linewidth 2
plot red,\a*x+\b
plot blue,x
}<br/>

La fonction \(f) est représentée en rouge, une graduation correspondant à une unité.
</p>
\if{\step=1}{En utilisant le graphique, conjecturer le sens de variations de la suite \((u_n)).<br/>
La suite \((u_n)) semble être \embed{reply 1,5}<br/>
}
\if{\step=2}{
Quelle semble être la limite de la suite \((u_n)) ?
<p class="wimscenter">
\embed{reply 2,50 40}
</p>
}
}


\answer{Réponse}{\rep;croissante,décroissante}{type=menu}
\answer{Limite}{\(\n);\(\l),\(+\infty),\(-\infty)}{type=dragfill}
