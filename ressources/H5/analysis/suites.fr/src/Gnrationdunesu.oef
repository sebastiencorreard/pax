\title{Suites récurrentes et suites explicites
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

définition de la fonction f
\integer{a=random(-1,1)*randint(4..8)}
\integer{b=random(-5..5)}
\integer{c=random(-1,1)*randint(1..5)}
\function{f=\a*x+\c}

calcul d'une suite récurrente, la ligne n+1 de mat donne le terme u_n.
\integer{u0=randint(1..5)}
\text{mat=\u0}
\integer{n=5}
\for{i=1 to \n}{
\integer{ut=evalue(\f,x=\mat[\i])}
\text{mat=\mat,\ut}
}
aléatoire al=1 cas u_n=f(n) et al=2 cas u_{n+1}=f(n)
\integer{al=random(1..2)}
\if{\al=1}{\integer{n=randint(2..5)}
\integer{u0=evalue(\f,x=0)}
\integer{sol=evalue(\f,x=\n)}
\integer{msol=\mat[\n+1]}
\text{retour= Etes-vous sûr de bien avoir lu l'énoncé? Il ne s'agit pas d'une suite récurrente.}
}
{\integer{p=\confparm1= ? 2:\confparm1}
\integer{n=randint(2..\p)}
\integer{sol=\mat[\n+1]}
calcul de f(n), la mauvaise solution
\integer{fn=evalue(\f,x=\n)}
\integer{msol=evalue(\f,x=\n)}
\text{indication= Il s'agit d'une suite définie par récurrence. 
Pour calculer \(u_n\) commencer par calculer \(u_1\) puis \(u_2\)...}

\text{retour= Etes-vous sûr de bien avoir lu l'énoncé? Il s'agit d'une suite récurrente.}}

\statement{Déterminer le terme de rang \n de la suite \((u_n)_{n \in \mathbb{N}}) définie par:<br/>
\if{\al=1}{
<ul>
<li>\(u_0=\u0)</li>
<li>\(u_n=f(n)) pour \(n >= 0)</li>
</ul>

}
{
<ul>
<li>\(u_0=\u0)</li>
<li>\(u_{n+1}=f(u_n)) pour \(n >= 0)</li>
</ul>

}
avec \(f(x)=\f).<br>
<p class="wimscenter">
Le terme \(u_\n\)  vaut \(\;\;\) \embed{reply 1,10}
</p>
}
\hint{\indication}
\answer{Réponse}{\sol}{type=default}
\feedback{(\al=1 and \reply1=\msol) or (\al=2 and \reply1=\msol)}{\retour}
