\title{Raison d'une suite géométrique}
\author{Frédéric, Pitoun}
\integer{a=random(-1,1)*randint(1..10)}
\integer{b=random(-1,1)*randint(1..10)}

\text{exposants=random(-1,1)*randint(2..4),random(-1,1)*randint(0..3),random(-1,1)*randint(2..4),random(-1,1)*randint(0..3)}
\text{a=item(1,\exposants)}

\function{en=maxima((item(1,\exposants)*n+item(2,\exposants)))}

\function{ed=maxima((item(3,\exposants)*n+item(4,\exposants)))}

\text{ent=texmath(\en)}

\text{edt=texmath(\ed)}

\function{q=maxima(a^(item(1,\exposants))/b^(item(3,\exposants)))}

\function{u=maxima(a^(item(2,\exposants))/b^(item(4,\exposants)))}

\statement{On considère la suite géométrique \((u_n)), définie par la relation
<p class="wimscenter">
\(u_n = \frac{a^{\ent}}{b^{\edt}})
</p>
La suite \((u_n)) est une suite géométrique de raison \(q=)\embed{repy 1,10} 
et dont le terme inital est \(u_0=) \embed{reply 2, 10}.
}


\answer{q}{\q,a,b,n}{type=formal}

\answer{u0}{\u,a,b,n}{type=formal}

\hint{Pour calculer la raison vous pouvez soit faire le rapport de deux termes consécutifs, soit exprimer \(u_n) sous la forme \(u_0*q^n).
Le calcul de \(u_0) ne pose pas de difficultés ! 
}
