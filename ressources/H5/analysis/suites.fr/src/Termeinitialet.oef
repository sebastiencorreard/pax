\title{Terme initial et raison d'une suite arithmétique
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}









\integer{al=random(1..2)}
\integer{u0=randint(-5..5)}
\integer{q=random(-1,1)*randint(1..5)}

\integer{n1=randint(2..10)}
\integer{n2=\n1+randint(2..6)}

\integer{u1=\u0+\n1*\q}
\integer{u2=\u0+\n2*\q}

\if{\al=1}{
\text{question=le terme initial}
\text{ques=u_0}
\integer{sol=\u0}
}
{
\text{question=la raison}
\text{ques=r}
\integer{sol=\q}
}

\statement{On considère une suite arithmétique telle que \(u_{\n1}=\u1) et \(u_{\n2}=\u2). Déterminer \question de cette suite.
<p class="wimscenter">
On a \(\ques=) \embed{reply 1,10}
</p>

}

\answer{Réponse}{\sol}{type=default}