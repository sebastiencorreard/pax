\title{Somme d'entiers}
\author{Frédéric, Pitoun}

\integer{a=random(-200..20)}
\integer{r=random(-1,1)*randint(1..5)}
\integer{a1=\a+\r}
\integer{n=randint(20..40)}
\integer{b=\a+\r*\n}

\integer{s=pari(sum(i=0,\n,\a+i*\r))}

\statement{Calculer la somme suivante, sachant que les termes de cette
somme sont les termes d'une suite arithmétique.<br/>
<p class="wimscenter">
\(S=\a+\a1+...+\b)
</p>
On a \(S=) \embed{reply 1}
}

\help{Pour calculer la somme des termes d'une suite arithmétique, 
il faut connaitre le nombre de termes intervenants dans cette suite. Pour cela
on peut utiliser l'expression \(u_n=u_0+n.r).}

\answer{S}{\s}{type=default}
