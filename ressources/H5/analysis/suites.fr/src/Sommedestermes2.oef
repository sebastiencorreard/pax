\title{Somme des termes d'une suite géométrique
}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{1000}









\integer{al=random(1..2)}
\integer{u0=random(-1,1)*randint(1..10)}
\integer{q=random(-1,1)*randint(1..3)}

\integer{n1=randint(1..3)}
\integer{n2=\n1+randint(6..8)}


\real{u1=\u0*(\q)^(\n1)}
\real{u2=\u0*(\q)^(\n2)}


\if{\q=1}{\rational{sol=(\n2-\n1+1)*\u1}}{
\real{sol=(\u1-\u2*\q)/(1-\q)}
}


\statement{On considère une suite géométrique de raison \q telle que \(u_{\n1}=\u1). Calculer la somme 
\(u_{\n1}+ \cdots + u_{\n2}).
<p class="wimscenter">
On a \(S=) \embed{reply 1,16}
</p>

}

\answer{Réponse}{\sol}{type=default}
