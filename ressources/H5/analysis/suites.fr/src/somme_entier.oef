\title{Somme d'entiers consécutifs}
\author{Frédéric, Pitoun}
\integer{a=randint(2..20)}
\integer{a1=\a+1}
\integer{b=randint(100..200)}

\integer{s=pari(sum(i=\a,\b,i))}

\statement{Déterminer l'entier \(n) tel que
<p class="wimscenter">
\(\a+\a1+...+n=\s)
</p>
On a \(n=) \embed{reply 1,5}
}

\answer{n}{\b}{type=default}
