!set title=A- Vocabulary 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Csilla, Ducrocq
email=csilla.ducrocq@u-psud.fr
oefcss=<style> .question {background-color: #FFFFCC; margin: 2% 5%; padding: 2%;} .reponse {background-color: #FFCC99; color: black; margin: 2% 5%; padding: 2%;} ol li {list-style: upper-alpha; } </style>
language=fr
computeanswer=no

ansorder=r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=vocabulary1
val7=$(val6[1])
tmp0=!subst 

val8=$(tmp0)
tmp0=!subst 

val9=$(tmp0)
val10=
val11=no
val12=no
val13=no
val14=no
val15=100x150x300

!ifval $val8 issametext 
tmp0=!getdef instruction in $val7

val8= $(tmp0)
!endif

!ifval $val9 issametext 
tmp0=!getdef instruction2 in $val7

val9= $(tmp0)
!endif

!ifval $val15 issametext 
tmp0=!getdef size in $val7

val15= $(tmp0)
!endif

!ifval $val12 issametext 
tmp0=!getdef reading_file in $val7

val12= $(tmp0)
!endif
tmp0=!record 0 of $val12

val16=$(tmp0)

!ifval $val11 issametext 
tmp0=!getdef audio_file in $val7

val11= $(tmp0)
!endif

!ifval $val11 notsametext  and  $val11 notsametext no
!readproc slib/media/audio $val1/$val11 
tmp0=$slib_out
val17=	<p class="wimscenter">$(tmp0)</p>
!endif

!ifval $val13 issametext 
tmp0=!getdef image_file in $val7

val13= $(tmp0)
!endif

!ifval $val13 notsametext  and  $val13 notsametext no
tmp0=!makelist <img src=$val1/x for x in $val13>

val18=	$(tmp0)
!endif

!ifval \video_file issametext 
tmp0=!getdef video_file in $val7

val19= $(tmp0)
!endif

!ifval $val19 notsametext  and  $val19 notsametext no
val20=	<a wims_target="external" href="$val1/$val19">[video] </a></p>
!endif

!ifval $val10 issametext 
tmp0=!getdef choice in $val7

val21= $(tmp0)
!else
val21=$val10
!endif
tmp0=!recordcnt $val7

val22=$[rint($(tmp0))]
val23=1
val24=1
val25=4
val24=$[rint(min($val22,$val24))]
val23=$[rint(min($val24*$val23,$val22))]
val26=

!ifval $val14 issametext yes 
tmp0=!shuffle $val22

val27= $(tmp0) 
!else
tmp1=!makelist x for x = 1 to $val22

val27=	$(tmp1)
!endif
tmp0=!randrecord $val6

tmp=!trim $(tmp0)
val28=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val28

tmp0=!rowcnt $tmp
val29=$[rint($(tmp0))]

!ifval $val25 issametext all 
val25=$[rint( $val29)]
!else
val25=$[rint(min($val29,$val25))]
!endif
tmp0=!shuffle $val29

val21=$(tmp0)
tmp=!trim $(val28[$(val21[1..$val25]);])
val28=!translate internal $	\
$ to ;; in $tmp
replytype1=correspond
replyname1=
replygood1=$(val28[1..$val25;1]); $(val28[1..$val25;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8	  
!if $val16 notsametext  
$() 
!read oef/special.phtml help reading,[à lire] 
$() 
!endif
$()	  
!if $val18 notsametext  
$() 
!read oef/special.phtml help image,[à regarder] 
$() 
!endif
$()	  $val17$val20	  <div class="wimscenter question"> 
!read oef/embed.phtml reply1,$val15 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
