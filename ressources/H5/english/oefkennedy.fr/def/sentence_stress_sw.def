!set title=H- Sentence stress: practice
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Csilla, Ducrocq
email=csilla.ducrocq@u-psud.fr
language=fr
computeanswer=no
oefcss=<style> .question {background-color: #FF9966;margin: 2% 5%;padding: 2%;} .reponse {background-color: #FFCC99;color: black;margin: 2% 5%;padding: 2%;} ol li {list-style: upper-alpha; } </style> 

ansorder=r
varcnt=55
prevarcnt=54
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=sentence_stress_practice
val7=$(val6[1])
tmp0=!subst Click on the words that should be stressed in the dialogue.

val8=$(tmp0)
tmp0=!subst Write one of the following words in the boxes below to explain why a particular word was emphasized:contrast, key word, adjective, quantity word

val9=$(tmp0)
val10=
val11=no
val12=no
val13=no
val14=yes
val15=15

!ifval $val8 issametext 
tmp0=!getdef instruction in $val7

val8= $(tmp0)
!endif

!ifval $val9 issametext 
tmp0=!getdef instruction2 in $val7

val9= $(tmp0)
!endif

!ifval $val15 issametext 
tmp0=!getdef size in $val7

val15= $(tmp0)
!endif

!ifval $val12 issametext 
tmp0=!getdef reading_file in $val7

val12= $(tmp0)
!endif
tmp0=!record 0 of $val12

val16=$(tmp0)

!ifval $val11 issametext 
tmp0=!getdef audio_file in $val7

val11= $(tmp0)
!endif

!ifval $val11 notsametext  and  $val11 notsametext no
!readproc slib/media/audio $val1/$val11 
tmp0=$slib_out
val17=	<p class="wimscenter">$(tmp0)</p>
!endif

!ifval $val13 issametext 
tmp0=!getdef image_file in $val7

val13= $(tmp0)
!endif

!ifval $val13 notsametext  and  $val13 notsametext no
tmp0=!makelist <img src=$val1/x for x in $val13>

val18=	$(tmp0)
!endif

!ifval \video_file issametext 
tmp0=!getdef video_file in $val7

val19= $(tmp0)
!endif

!ifval $val19 notsametext  and  $val19 notsametext no
val20=	<a target="wims_external" href="$val1/$val19">[video] </a></p>
!endif

!ifval $val10 issametext 
tmp0=!getdef choice in $val7

val21= $(tmp0)
!else
val21=$val10
!endif
tmp0=!recordcnt $val7

val22=$[rint($(tmp0))]
val23=1
val24=1
val25=3
val24=$[rint(min($val22,$val24))]
val23=$[rint(min($val24*$val23,$val22))]
val26=

!ifval $val14 issametext yes 
tmp0=!shuffle $val22

val27= $(tmp0) 
!else
tmp1=!makelist x for x = 1 to $val22

val27=	$(tmp1)
!endif
tmp=!trim 
val28=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 
val29=!translate internal $	\
$ to ;; in $tmp
val30=
tmp=!trim 
val31=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 
val32=!translate internal $	\
$ to ;; in $tmp
val33=
val34=
!for val35 = 1 to $val24 
tmp0=!record $(val27[$val35]) of $val6

val34=$val34 <br>	  $(tmp0)
!next
!readproc slib/text/markgroup $val34 
tmp0=$slib_out
tmp=!trim $(tmp0)
val34=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val34[1..-4;])
val31=!translate internal $	\
$ to ;; in $tmp
val36=$(val34[-2;])
tmp=!translate internal $	$ to ; in $val31

tmp0=!rowcnt $tmp
val37=$(tmp0)
tmp0=!replace internal ; by ,  in $val31

val38=$(tmp0)
val34=$(val34[-3;])
tmp0=!itemcnt $val34

val33=$(tmp0)
tmp0=!items2words $val34

val39=$(tmp0)
val40=
!for val35  = 1 to $val37 
val41=$(val34[$(val31[$val35;])])
tmp0=!items2words $val41

val41=$(tmp0)
val40=$val40,$val41
!next
tmp0=!nonempty items $val40

val40=$(tmp0)
tmp0=!makelist r x for x = 2 to $val37+1

val42=$(tmp0)
oefsteps=r1 
nextstep=!nosubst r1 
!readproc oef/steps.proc
replytype1=mark
replyoption1=split 
replyname1=
replygood1=$val38;$val34
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

