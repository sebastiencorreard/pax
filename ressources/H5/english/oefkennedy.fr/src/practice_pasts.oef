\title{E- Past tenses: practice}
\author{Csilla, Ducrocq}
\email{csilla.ducrocq@u-psud.fr}
\language{fr}
\computeanswer{no}
\format{html}
\text{file=practice_pasts}
\text{file0=\file[1]}
\text{instruction=asis(Complete the sentences with the
appropriate past tense: <b>simple past, past perfect,
 past progressive,
was/were to +verb, would+verb</b>.
Decide whether you have to use the <b>active</b> or the <b>passive</b> form. Write the <b>full form of the auxiliaries</b>)}
\text{instruction2=wims(subst )}
\text{choice=}
\text{audio_file=no}
\text{reading_file=no}
\text{image_file=no}
\text{alea=yes}
\text{size=16}
\text{instruction=\instruction issametext ? wims(getdef instruction in \file0)}
\text{instruction2=\instruction2 issametext ? wims(getdef instruction2 in \file0)}
\text{size=\size issametext ? wims(getdef size in \file0)}
\text{reading_file=\reading_file issametext ? wims(getdef reading_file in \file0)}
\text{reading = wims(record 0 of \reading_file)}

\text{audio_file = \audio_file issametext ? wims(getdef audio_file in \file0)}
\text{audio=\audio_file notsametext  and  \audio_file notsametext no?
<p class="wimscenter">slib(media/audio \imagedir/\audio_file)</p>}

\text{image_file=\image_file issametext ? wims(getdef image_file in \file0)}
\text{image=\image_file notsametext  and  \image_file notsametext no?
wims(makelist <img src=\imagedir/x for x in \image_file>)}

\text{video_file=\video_file issametext ? wims(getdef video_file in \file0)}
\text{video=\video_file notsametext  and  \video_file notsametext no?
<a target="wims_external" href="\imagedir/\video_file">[video] </a></p>}

peut ne servir à rien :
\text{choix=\choice issametext ? wims(getdef choice in \file0):\choice}


\css{<style>
 .question {background-color: #FFCCFF;margin: 2% 5%;padding: 2%;}
 .reponse {background-color: #FFCC99;color: black;margin: 2% 5%;padding: 2%;}
ol li {list-style: upper-alpha; }
 </style>
 }
\integer{cnt_question= wims(recordcnt \file0)}
\text{MAX=\cnt_question}
\text{N=1}
\text{M=3}
\integer{N = min(\cnt_question,\N)}
\integer{MAX=min(\N*\MAX,\cnt_question)}

\text{answer_given=}
\text{battage=\alea issametext yes ? shuffle(\cnt_question) :
wims(makelist x for x = 1 to \cnt_question)}
     \text{cnt_file=items(\file)}

\for{i = 2 to \cnt_file}{
  \integer{cnt= wims(recordcnt \file[\i])}
  \text{ v= shuffle(\cnt)}
  \matrix{battage=\battage
  \v[1..\N]}
}

\text{a =}
\for{i= 1 to \N}{
  \text{f = randint(1..\cnt_file)}
  \text{a = \a <p> wims(record \battage[\f;\i] of  \file[\f]) </p>}
}

text{a = wims(nonempty items \a)}
\text{a=wims(embraced randitem \a)}
en vue des modifications ultérieures de cutchoices (du coup
le test ne sert plus mais je le laisse)
\text{a=\a}
teste si le premier champ est une question
\text{testa= wims(nospace \a)}
\text{first = wims(replace internal ? by | in wims(char 1 of \testa))}
\text{u= \first issametext | ? 1 : 0}
\text{u1 = \u = 0 ? -1:1}
\matrix{A = slib(text/cutchoices \a)}
\text{cntrow=rows(\A)}
\integer{cntQ=(\cntrow+\u1*\cntrow%2)/2}

\matrix{good1 =}
\text{rep=}
\text{memoireCNT=}
\for{i= 1 to \cntQ}{
  \text{good=\A[2*\i -\u;]}
  \text{cnt = items(\good)}
  \text{mix = shuffle(\cnt)}
  \matrix{good1=\good1
  \good[\mix]}
  \text{rep = \rep,position(1,\mix)}
  \text{memoireCNT = \memoireCNT,\cnt}
}
\text{rep =wims(nonempty items \rep)}
\text{memoireCNT =wims(nonempty items \memoireCNT)}

\text{STEP = wims(makelist r x for x = 1 to \cntQ)}

\steps{\STEP}

MENU ou MARK ou CASE
     \statement{
\instruction
\if{\reading notsametext }{\special{help reading,[à lire]}
}
\if{\image notsametext }{\special{help image,[à regarder]}}
\audio\video
<div class="question">
 \for{k = 1 to \cntQ}{
    \A[2*\k-1-\u;]  \embed{\STEP[\k],\size}
 }
\A[2*\cntQ+1-\u;]
</div>
}

