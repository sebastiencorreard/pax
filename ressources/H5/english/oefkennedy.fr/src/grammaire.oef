  }
  \texte[2*\cntQ+1;]
}

\if{\format iswordof mark}
{
  \for{k = 1 to \cntQ}{
    \texte[2*\k-1;]  \if{r \k isitemof \nstep}{/
      \for{K = 1 to \listeCNT[\k]}{ \embed{\STEP[\k],\K}/}
   }{
       \if{\Trou[\k;] issametext \rep[\k;]}{<span class="oef_indgood">\trouV[\k;\Trou[\k;]]</span>}
