   \for{k = 1 to \cntQ}{
    \texte[2*\k-1;]  \if{r \k isitemof \nstep}{\embed{\STEP[\k]}}{
       \if{\Trou[\k;] issametext \rep[\k;]}{<span class="oef_indgood">\Trou[\k;]</span>}
