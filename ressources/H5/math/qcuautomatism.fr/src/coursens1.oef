\keywords{quizz,functions,reference_function}
%%% CD %%%%
\rational{c=randomitem(1/2,1/4)*randomitem(-1,-1,1)}
\integer{b=-1*randint(1..7)}
\integer{a=randint(2..12)}
\function{f=maxima(\a+\c*(x+\b)^2)}
\integer{x=randitem(-\b,-\b-2,-\b-4)}
\integer{imgf=evalue(\f,x=\x)}
\text{enonce=On considère la fonction \(f\) définie pour tout réel \(x\) par\(f(x)=\f\). <br>L'image de \(\x\) par la fonction \(f\) est &nbsp;&#58;}
\real{bad1=(\x==-\b)? \a+\c:randitem(0,\a+2*\c*(\x+\b))}
\real{bad2=(\x==-\b)? 0:(\a+\c)*(\x+\b)*(\x+\b)}
\real{bad3=(\x==-\b)? \a-\c:\a-\c*(\x+\b)*(\x+\b)}
\text{good=\imgf}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse était \good.<br> Il suffit de remplacer la variable \(x\) par \(\x\) pour calculer l'image \(f(\x)\).}
\text{qen10=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng10=position(1,\t)}
\text{repA10=\qrep[\t[1]]}
\text{repB10=\qrep[\t[2]]}
\text{repC10=\qrep[\t[3]]}
\text{repD10=\qrep[\t[4]]}
\text{qf10=\feedback}
\text{nq=\nq,606}
\text{vlatex=\vlatex,1}
\title{Question 211 NS Développer un carré}
\keywords{quizz,literal_calculation,trinomial}
\observation{Question du sujet zéro sujet-specialite-2_0.pdf publié sur EDUSCOL en juin 2025 }
\text{x=randomitem(x,n,t)}
\text{p=randomitem(3,4,3,5,3,2)}
\function{f=(x - \p)^2}
\integer{af=1}
\integer{bf=2*\p}
\integer{cf=\p^2}
\text{enonce=L’expression développée de \(( \x - \p)^2\) est&nbsp;&#58; }
\text{good=\(\x^2-\bf*\x+\cf\)}
%%%
\text{bad1=\(\x^2+\cf\)}
%%%
\text{bad2=\(\x^2-\cf\)}
%%%
\text{bad3=randomitem(\(\x^2-\bf*\x-\cf\),\(\x^2+\bf*\x-\cf\))}
%%%
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse est \good. <ul class="wims_nopuce"><li> Soit on développe <span class="nowrap">\((\x - \p)(\x - \p)\).</span><i>(double distributivité)</i></li><li>Soit on utilise l'identité remarquable <span class="nowrap">\((\x - \p)^2=\x^2-2\times\p\times \x+\p^2\).</span></li></ul>  }
\text{qen11=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng11=position(1,\t)}
\text{repA11=\qrep[\t[1]]}
\text{repB11=\qrep[\t[2]]}
\text{repC11=\qrep[\t[3]]}
\text{repD11=\qrep[\t[4]]}
\text{qf11=\feedback}
\text{nq=\nq,211}
\text{vlatex=\vlatex,1}
\title{Question 705 NS Comparaison de séries statistiques}
\keywords{quizz,median,mean}
\observation{Question du sujet zéro sujet-specifique-1_0.pdf publié sur EDUSCOL en juin 2025 }
\integer{cas=randomitem(1,2,3,4)}
\text{donnees=Les deux séries ont la même moyenne et la même médiane.,Les deux séries ont la même moyenne mais pas la même médiane.,Les deux séries ont la même médiane mais pas la même moyenne.,Les deux séries n’ont ni la même moyenne ni la même médiane.}
\if{\cas=1}{%%%Les deux séries ont la même moyenne et la même médiane.
  \text{good=\donnees[1]}
  \text{bad1=\donnees[2]}
  \text{bad2=\donnees[3]}
  \text{bad3=\donnees[4]}
  \integer{med=randint(7..11)}
  \integer{moy=\med}
  \text{templist=shuffle(\med-1)}
  \integer{temp=\templist[1]}
  \integer{A1=\moy-\temp}
  \integer{A2=\med}
  \integer{A3=\moy+\temp}
  \integer{temp=\templist[2]}
  \integer{B1=\med-\temp}
  \integer{B2=\med}
  \integer{B3=\med+\temp}
  }
\if{\cas=2}{%%%Les deux séries ont la même moyenne mais pas la même médiane.
  \text{good=\donnees[2]}
  \text{bad1=\donnees[3]}
  \text{bad2=\donnees[4]}
  \text{bad3=\donnees[1]}
  \text{templist=randint(1..10),randint(11..20),randint(40..60)}
  \integer{somme=\templist[1]+\templist[2]+\templist[3]}
  \integer{med=\templist[2]}
  \integer{A1=\templist[1]}
  \integer{A2=\med}
  \integer{A3=\templist[3]}
  \integer{temp=(3+\moy)/2}
  %%%%%%%%%%%%%%%%
  \integer{B2=\med+randomitem(2,1,-1,-2)}
  \integer{B1=randint(1..\med-2)}
  \integer{B3=\somme-\B1-\B2}
  }
\if{\cas=3}{%%%Les deux séries ont la même médiane mais pas la même moyenne.
  \text{good=\donnees[3]}
  \text{bad1=\donnees[2]}
  \text{bad2=\donnees[4]}
  \text{bad3=\donnees[1]}
  \text{templist=randint(3..10),randint(11..20),randint(40..60)}
  \integer{somme=\templist[1]+\templist[2]+\templist[3]}
  \integer{med=\templist[2]}
  \integer{A1=\templist[1]}
  \integer{A2=\med}
  \integer{A3=\templist[3]}
  \integer{temp=(3+\moy)/2}
  %%%%%%%%%%%%%%%%
  \integer{B2=\med}
  \integer{temp00=\templist[1]-randint(1,2)}
  \text{B1=randomitem(0.5,0.5,\temp00)}
  \integer{B3=randomitem(100,80,90,\somme-\B1-\B2+randomitem(10,20,30,40))}
  }
\if{\cas=4}{%%%Les deux séries n’ont ni la même moyenne ni la même médiane
  \text{good=\donnees[4]}
  \text{bad1=\donnees[2]}
  \text{bad2=\donnees[3]}
  \text{bad3=\donnees[1]}
  \text{templist=randint(3..10),randint(11..20),randint(40..60)}
  \integer{somme=\templist[1]+\templist[2]+\templist[3]}
  \integer{med=\templist[2]}
  \integer{A1=\templist[1]}
  \integer{A2=\med}
  \integer{A3=\templist[3]}
  \integer{temp=(3+\moy)/2}
  %%%%%%%%%%%%%%%%
  \integer{decal=randint(1..10)}
  \integer{B2=\A2+\decal}
  \integer{B1=\A1+\decal}
  \integer{B3=\A3+\decal}
  }
\text{enonce=Voici deux séries de valeurs. <br><span class="nowrap"><b>série A&nbsp;&#58; \A1 &#59; \A2 &#59; \A3 </b></span> <br> <span class="nowrap"><b>série B&nbsp;&#58; \B1 &#59; \B2 &#59; \B3 </b>.</span> <br>Une seule de ces affirmations est exacte&nbsp;&#58;}
\text{bads=\bad1,\bad2,\bad3}
\text{compmed=\A2=\B2?\(\A2=\B2\):\(\A2 \ne \B2\)}
\text{compmoy=\A1+\A2+\A3=\B1+\B2+\B3?\(\A1+\A2+\A3=\B1+\B2+\B3\):\(\A1+\A2+\A3\ne\B1+\B2+\B3\)}
\text{feedback=La bonne réponse est <b>"\good"</b>. <ul class="wims_nopuce"><li>Pour les médianes&nbsp;&#58;</li> <ul><li>Les trois nombres de chaque série sont classés par ordre croissant&#44; la médiane est donc la seconde.</li><li>Ici \compmed.</li></ul>
<li>Pour les moyennes&nbsp;&#58;</li> <ul><li>On peut comparer la somme des trois nombres (qu'il faudrait diviser par trois pour obtenir la moyenne).</li><li>Ici \compmoy.</li></ul></ul>}
\text{qen12=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng12=position(1,\t)}
\text{repA12=\qrep[\t[1]]}
\text{repB12=\qrep[\t[2]]}
\text{repC12=\qrep[\t[3]]}
\text{repD12=\qrep[\t[4]]}
\text{qf12=\feedback}
\text{nq=\nq,705}
\text{vlatex=\vlatex,1}
%%%%%%%
\text{enonce=\qen1,\qen2,\qen3,\qen4,\qen5,\qen6,\qen7,\qen8,\qen9,\qen10,\qen11,\qen12}
\text{repA=\repA1,\repA2,\repA3,\repA4,\repA5,\repA6,\repA7,\repA8,\repA9,\repA10,\repA11,\repA12},
\text{repB=\repB1,\repB2,\repB3,\repB4,\repB5,\repB6,\repB7,\repB8,\repB9,\repB10,\repB11,\repB12}
\text{repC=\repC1,\repC2,\repC3,\repC4,\repC5,\repC6,\repC7,\repC8,\repC9,\repC10,\repC11,\repC12}
\text{repD=\repD1,\repD2,\repD3,\repD4,\repD5,\repD6,\repD7,\repD8,\repD9,\repD10,\repD11,\repD12}
\text{feed=\qf1,\qf2,\qf3,\qf4,\qf5,\qf6,\qf7,\qf8,\qf9,\qf10,\qf11,\qf12},
