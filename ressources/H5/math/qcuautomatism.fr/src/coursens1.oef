  \for{tt=1 to \nbqap}{
    \if{\screp[\choix[\tt]]!=\empty and \screp[\choix[\tt]]!=1 }{
      <style>.feedmutu {
    border: 1px solid;
    border-radius: 5px;
    padding: .5em;}
    </style>
      <div class="feedmutu">\feed[\choix[\tt]]</div>
    }
  }
}
%%%% feedback version non step ou (step+laisser finir)
