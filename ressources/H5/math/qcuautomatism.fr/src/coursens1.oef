      <th>A. <br>\repA[\chn0]</th>
      <th>B. <br>\repB[\chn0]</th>
      <th>C. <br>\repC[\chn0]</th>
      <th>D. <br>\repD[\chn0]</th>
      </tr>
      </table>
      </div>
      <p><u>Indication pour trouver la bonne réponse&nbsp:</u></p>
      <p>\feed[\chn0]</p>
      </div>
    }
  }
