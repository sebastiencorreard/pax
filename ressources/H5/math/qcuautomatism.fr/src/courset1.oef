\title{Question 100 T Calculs avec les puissances}
\keywords{quizz,power,calculation,multiplication,division}
\observation{Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 }
\text{enonce=La seule égalité vraie est&nbsp;&#58;}
%%% une question par ligne, premier item vrai, second faux
%%%% proposition 1
\integer{a=randomitem(2,3,5)}
\integer{b=\a+randomitem(2,3)}
\integer{c=-\a-\b}
\integer{cbad=\b-\a}
\text{questions=\(\frac{10^{-\a}}{10^\b}=10^{\c}\),\(\frac{10^{-\a}}{10^\b}=10^{\cbad}\)}
\text{feedback=La bonne réponse est \(\frac{10^{-\a}}{10^{\b}}=10^{\c}\) puisque \(\frac{10^{-\a}}{10^{\b}}=10^{-\a-\b}\)}
%%%% proposition 2
\text{temp=shuffle(2,3,5)}
\integer{a=\temp[1]}
\integer{b=\temp[2]}
\integer{c=\temp[3]}
\integer{d=-\b*\c}
\integer{dbad=\c-\b}
\matrix{questions=\questions
\( (\a^{-\b})^\c=\a^{\d} \),\( (\a^{-\b})^\c=\a^{\dbad} \)}
\text{feedback=\feedback,La bonne réponse est \( (\a^{-\b})^{\c}=\a^{\d} \) puisque \( (\a^{-\b})^\c=\a^{-\b \times \c} \)}
%%%% proposition 3
\text{temp=shuffle(2,3,5)}
\integer{a=\temp[1]*10}
\integer{b=\temp[2]}
\integer{c=1-\b}
\integer{cbad=\b-1}
\matrix{questions=\questions
\(\a \times \frac{1}{\a^{\b}}=\a^{\c}\),\(\a \times \frac{1}{\a^{\b}}=\a^{\cbad}\) }
\text{feedback=\feedback,La bonne réponse est \(\a \times \frac{1}{\a^{\b}}=\a^{\c}\) puisque \(\a \times \frac{1}{\a^{\b}}=\a \times \a^{-\b}=\a^{1-\b}\)}
%%%% proposition 4
\integer{a=randomitem(8,9,10,11)}
\integer{b=randomitem(2,3,4)}
\integer{c=randomitem(5,6,7)}
\integer{d=\a*\b}
\integer{cbad=2*\c}
\matrix{questions=\questions
\( \b^{-\c} \times \a^{-\c}=\d^{-\c}\),\( \b^{-\c} \times \a^{-\c}=\d^{-\cbad}\) }
\text{feedback=\feedback,La bonne réponse est \( \b^{-\c} \times \a^{-\c}=\d^{-\c}\) puisque \( \b^{-\c} \times \a^{-\c}=(\a \times \b)^{-\c}\)}
%%% choix du bon
\integer{k=randomitem(1,2,3,4)}
%%%%
\text{good=\questions[\k;1]}
\text{bads=}
\for{k100=1 to 4}
  {\if{\k100!=\k}{
  \text{bads=\bads==?\questions[\k100;2]:\bads,\questions[\k100;2]}}
  }
\text{feedback=\feedback[\k]}
\text{qen4=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng4=position(1,\t)}
\text{repA4=\qrep[\t[1]]}
\text{repB4=\qrep[\t[2]]}
\text{repC4=\qrep[\t[3]]}
\text{repD4=\qrep[\t[4]]}
\text{qf4=\feedback}
\text{nq=\nq,100}
\text{vlatex=\vlatex,1}
\title{Question 102 T Calculs et conversions de longueurs}
\keywords{quizz,conversion,power,length}
\observation{Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 }
\integer{a=randomitem(50,60,70,80,90)}
\integer{n=randomitem(-3,-3,-4)}
\text{unite=\n=-3?mm:cm}
\integer{k=randint(2..4)*randomitem(100,1000)}
\real{temp1=\k*\a*10^(\n)} %%%% valeur en unite
\real{tempgood=\unite issametext mm?\temp1/10:\temp1*10} %%% valeur en cm / valeur en mm
\text{tempgood1=\unite issametext mm?\tempgood cm:\tempgood mm}
\text{good=\tempgood1}
\text{bad1=\unite issametext mm?\tempgood mm:\tempgood cm} %%% bonne valeur mauvaise unité
\real{tempbad=\unite issametext cm?\temp1/10:\temp1*10} %%%% mauvaise valeur
\text{bad2=\unite issametext mm?\tempbad cm:\tempbad mm} %%%% mauvaise valeur bonne unité
\text{bad3=\unite issametext mm?\tempbad mm:\tempbad cm} %%%% mauvais valeur et mauvaise unité
\text{bads=\bad1,\bad2,\bad3}
\text{enonce=L’épaisseur d’une feuille de papier est égale à <span class="nowrap">\(\a \times 10^{\n} \unite\).</span><br>L’épaisseur d’une pile de \( \k \) feuilles est égale à&nbsp;&#58;}
\text{feedback=Il faut effectuer le calcul suivant&nbsp;&#58; \(\k \times \a \times 10^{\n} \unite=\temp1 \unite\)<br><span class="nowrap">\({}= \good \).</span>}
\text{qen5=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng5=position(1,\t)}
\text{repA5=\qrep[\t[1]]}
\text{repB5=\qrep[\t[2]]}
\text{repC5=\qrep[\t[3]]}
\text{repD5=\qrep[\t[4]]}
\text{qf5=\feedback}
\text{nq=\nq,102}
