\title{Question 609 NS calcul du coefficient directeur}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\keywords{quizz,direction,line}
%%% CD %%%%
\rational{m=randomitem(0.5,0.2,0.25,0.1,2,4,5,10)*randitem(1,-1)}
\integer{k=(\m>1)? 1:(1/\m)*randitem(1,-1,2,-2,3,4)}
\integer{xA=\k*randint(-4..4)}
\integer{xB=\k*(\xA+randint(1..6))}
\integer{yA=randint(2..7)}
\integer{yB=\yA+\m*(\xB-\xA)}
\text{enonce=Dans un repère du plan&#44; on considère les points \(A(\xA; \yA)\) et \(B(\xB ; \yB)\).<br>
Le coefficient directeur de la droite \((AB)\) est&nbsp;&#58;}
\real{bad1=1/\m}
\real{bad2=-1/\m}
\real{bad3=-\m}
\text{good=\m}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse était \m.<br> Le coefficient directeur de la droite \((AB)\) se calcule avec la formule &nbsp;&#58; \(\frac{y_B-y_A}{x_B-x_A}\).}
\text{qen6=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng6=position(1,\t)}
\text{repA6=\qrep[\t[1]]}
\text{repB6=\qrep[\t[2]]}
\text{repC6=\qrep[\t[3]]}
\text{repD6=\qrep[\t[4]]}
\text{qf6=\feedback}
\text{nq=\nq,609}
\text{vlatex=\vlatex,1}
\title{Question 610 NS rôle du coefficient directeur}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\keywords{quizz,direction,line}
%%% CD %%%%
\integer{yA=randint(1..7)*randitem(1,1,-1)}
\real{m=randint(1..9)/10*randitem(-\yA/abs(\yA),-\yA/abs(\yA),\yA/abs(\yA))}
\text{enonce=Dans un repère du plan&#44; on considère la droite \(d\) de coefficient directeur \(\m\) et
passant par le point \(A(0 ; \yA)\).<br>
On note \(B\) le point de la droite \(d\) dont l’abscisse est égale à \(1\).<br>
L’ordonnée du point \(B\) est égale à &nbsp;&#58;}
\real{g=\yA+\m}
\real{bad1=\yA-\m}
\real{bad2=\yA+1}
\real{bad3=(\yA+\m)/2}
\text{good=\g}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse était \g.<br> En effet&#44; par propriété du coefficient directeur&#44; comme l'abscisse augmente de 1 entre celle de \(A\) et celle de \(B\) alors 
l'ordonnée évolue de \(\m\) entre celle de \(A\) et celle de \(B\).}
\text{qen7=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng7=position(1,\t)}
\text{repA7=\qrep[\t[1]]}
\text{repB7=\qrep[\t[2]]}
\text{repC7=\qrep[\t[3]]}
\text{repD7=\qrep[\t[4]]}
\text{qf7=\feedback}
\text{nq=\nq,610}
\text{vlatex=\vlatex,1}
\title{Question 212 NS Double distributivité}
\keywords{quizz,literal_calculation}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\integer{a=randint(3..9)*randitem(1,-1)}
\integer{b=(abs(\a)+randitem(1,-1))}
\integer{b=(\a>0)? -\b:\b*randitem(1,1,-1)}
\function{f=maxima((x+\a)(x+\b))}
\text{enonce=La forme développée de \(\f\) est&nbsp;&#58;}
\function{gd=maxima(x^2+(\a+\b)*x+\a*\b)}
\function{bad1=maxima(x^2+(\a+\b)*x-\a*\b)}
\function{bad2=maxima(x^2-(\a+\b)*x+\a*\b)}
\function{bad3=maxima(x^2-(\a+\b)*x-\a*\b)}
\text{bads=\(\bad1\),\(\bad2\),\(\bad3\)}
\text{good=\(\gd\)}
\integer{aabs=abs(\a)}
\integer{babs=abs(\b)}
\text{as=(\a>0)? +\aabs:-\aabs}
\text{bs=(\b>0)? +\babs:-\babs}
\integer{aabs=abs(\a)}
\integer{babs=abs(\b)}
\text{ps=(\a*\b)>0? +\aabs\times \babs:-\aabs\times \babs}
\text{feedback=La bonne réponse est \good. En effet, pour tout réel \(x\), \(\f=x\times x\as\times x\bs\times x\ps=\gd\). }
\text{qen8=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng8=position(1,\t)}
\text{repA8=\qrep[\t[1]]}
\text{repB8=\qrep[\t[2]]}
\text{repC8=\qrep[\t[3]]}
\text{repD8=\qrep[\t[4]]}
\text{qf8=\feedback}
\text{nq=\nq,212}
\text{vlatex=\vlatex,1}
n\title{Question 213 NS Isoler une variable}
\keywords{quizz,literal_calculation}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\matrix{preambule=Le volume \(\mathcal{V}\) d'un cylindre de rayon \(r\) et de hauteur \(h\) est \(\mathcal{V}=\pi r^2 h\)
Le volume \(\mathcal{V}\) d'un cône de rayon \(r\) et de hauteur \(h\) est \(\mathcal{V}=\frac{1}{3}\pi r^2 h\)
Le volume \(\mathcal{V}\) d'une pyramide de hauteur \(h\) et de base un carré de côté \(a\) est \(\mathcal{V}=\frac{1}{3}a^2 h\)
Le volume \(\mathcal{V}\) d'un tétraèdre de hauteur \(h\) et de base un triangle équilatéral de côté \(a\) est \(\mathcal{V}=\frac{\sqrt{3}}{12}a^2 h\)
Le volume \(\mathcal{V}\) d'un tore de rayon \(r\) et de distance à l'axe \(d\) est \(\mathcal{V}=2\pi ^2 r^2 d\)
L'aire latérale \(\mathcal{A}\) d'un cylindre de rayon \(r\) et de hauteur \(h\) est \(\mathcal{A}=2\pi r h\)
L'aire \(\mathcal{A}\) d'un tore de rayon \(r\) et de distance à l'axe \(d\) est \(\mathcal{A}=4\pi ^2 r d\)
L'aire \(\mathcal{A}\) d'une couronne de rayon intérieur \(r\) et de rayon extérieur \(R\) est \(\mathcal{A}=\pi R^2-\pi r^2\)
}
\matrix{variable=\(h\),\(r\)
\(h\),\(r\)
\(h\),\(a\)
\(h\),\(a\)
\(d\),\(r\)
\(h\),\(r\)
\(r\),\(d\)
\(R\),\(r\)
}
\matrix{mgood=\(h=\frac{\mathcal{V}}{\pi r^2}\),\(r=\sqrt{\frac{\mathcal{V}}{\pi h}}\)
\(h=\frac{3\mathcal{V}}{\pi r^2}\),\(r=\sqrt{\frac{3\mathcal{V}}{\pi h}}\)
\(h=\frac{3\mathcal{V}}{a^2}\),\(r=\sqrt{\frac{3\mathcal{V}}{h}}\)
\(h=\frac{12\mathcal{V}}{\sqrt{3}a^2}\),\(a=\sqrt{\frac{12\mathcal{V}}{\sqrt{3}h}}\)
\(d=\frac{\mathcal{V}}{2\pi^2 r^2}\),\(r=\frac{1}{\pi}\sqrt{\frac{\mathcal{V}}{2d}}\)
\(h=\frac{\mathcal{A}}{2\pi r}\),\(r=\frac{\mathcal{A}}{2\pi h}\)
\(r=\frac{\mathcal{A}}{4\pi^2 d}\),\(d=\frac{\mathcal{A}}{4\pi^2 r}\)
\(R=\sqrt{\frac{\mathcal{A}}{\pi}+r^2}\),\(r=\sqrt{R^2-\frac{\mathcal{A}}{\pi}}\)
}
\matrix{mbad1=\(h=\frac{\pi \mathcal{V}}{r^2}\),\(r=\sqrt{\frac{\pi \mathcal{V}}{h}}\)
\(h=\frac{\mathcal{V}}{3 \pi r^2}\),\(r=\sqrt{\frac{\mathcal{V}}{3\pi h}}\)
\(h=\frac{\mathcal{V}}{3a^2}\),\(r=\sqrt{\frac{\mathcal{V}}{3h}}\)
\(h=\frac{\mathcal{V}}{12\sqrt{3}a^2}\),\(a=\sqrt{\frac{\mathcal{V}}{12\sqrt{3}h}}\)
\(d=\frac{2\mathcal{V}}{(\pi r)^2}\),\(r=\frac{1}{\pi}\sqrt{\frac{2\mathcal{V}}{d}}\)
\(h=\frac{4\mathcal{A}}{\pi r}\),\(r=\frac{4\mathcal{A}}{\pi h}\)
\(r=\frac{4\mathcal{A}}{\pi^2 d}\),\(d=\frac{4\mathcal{A}}{\pi^2 r}\)
\(R=\sqrt{\frac{\mathcal{A}}{\pi}}+r\),\(r=R-\sqrt{\frac{\mathcal{A}}{\pi}}\)
}
\matrix{mbad2=\(h=\frac{\mathcal{V}^2}{\pi r}\),\(r=\sqrt{\frac{h}{\pi \mathcal{V}}}\)
\(h=\frac{3\mathcal{V}^2}{\pi r}\),\(r=\frac{3\mathcal{V}^2}{\pi h}\)
\(h=\frac{3\mathcal{V}^2}{a}\),\(r=\frac{3\mathcal{V}^2}{h}\)
\(h=\frac{12\mathcal{V}^2}{3a}\),\(a=\sqrt{\frac{4\mathcal{V}}{h}}\)
\(d=\frac{\mathcal{V}}{\sqrt{2}\pi r}\),\(r=\sqrt{\frac{\mathcal{V}}{\sqrt{2}\pi d}}\)
\(h=\frac{\mathcal{A}r}{2\pi }\),\(r=\frac{\mathcal{A}h}{2\pi }\)
\(r=\frac{\sqrt{\mathcal{A}}}{2\pi d}\),\(d=\frac{\sqrt{\mathcal{A}}}{2\pi r}\)
\(R=\sqrt{\frac{\mathcal{A}}{\pi}-r^2}\),\(r=\sqrt{\frac{\mathcal{A}}{\pi}-R^2}\)
}
\matrix{mbad3=\(h=\frac{\sqrt{\mathcal{V}}}{\pi r}\),\(r=\frac{\mathcal{V}}{\sqrt{\pi h}}\)
\(h=\frac{3\sqrt{\mathcal{V}}}{\pi r}\),\(r=\frac{3\mathcal{V}}{\sqrt{\pi h}}\)
\(h=\frac{3\sqrt{\mathcal{V}}}{a}\),\(r=\frac{3\mathcal{V}}{\sqrt{h}}\)
\(h=\frac{12}{a}\sqrt{\frac{\mathcal{V}}{3}}\),\(a=\frac{12\sqrt{\mathcal{V}}}{\sqrt{3}h}\)
\(d=\frac{\sqrt{\mathcal{V}}}{2\pi r}\),\(r=\frac{1}{2}\sqrt{\frac{\mathcal{V}}{\pi d}}\)
\(h=2\pi r \mathcal{A}\),\(r=2\pi h \mathcal{A}\)
\(r=\frac{\mathcal{A}}{2\pi \sqrt{d}}\),\(d=\frac{\mathcal{A}}{2\pi \sqrt{r}}\)
\(R=\sqrt{\frac{\mathcal{A}}{\pi r}}\),\(r=\sqrt{\frac{\mathcal{A}}{\pi R}}\)
}
\integer{c=randint(1..8)}
\integer{d=randitem(1,1,2)}
\text{pre=\preambule[\c;1]}
\text{q=\variable[\c;\d]}
\text{good=\mgood[\c;\d]}
\text{bads=\mbad1[\c;\d],\mbad2[\c;\d],\mbad3[\c;\d]}
\text{feedback=La bonne réponse est \good.}
\text{enonce=\pre. <br>On cherche à isoler la variable <span class="nowrap">\q.</span> On a&nbsp;&#58;}
\text{qen9=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng9=position(1,\t)}
\text{repA9=\qrep[\t[1]]}
\text{repB9=\qrep[\t[2]]}
\text{repC9=\qrep[\t[3]]}
\text{repD9=\qrep[\t[4]]}
\text{qf9=\feedback}
\text{nq=\nq,213}
\text{vlatex=\vlatex,0}
\title{Question 607 NS image par une fonction du second degré sous forme développée}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\keywords{quizz,functions,reference_function}
%%% CD %%%%
\rational{c=randomitem(1/2,1/4)*randomitem(-1,-1,1)}
\integer{a=randint(2..4)*-1}
\integer{b=randint(2..5)}
\integer{c=randint(2..9)}
\function{f=\a*x^2+\b*x+\c}
\integer{x=randint(2..4)*-1}
\integer{b=(\b==\a*\x)? \b+1:\b}%%éviter des réponses identiques%%
\integer{imgf=evalue(\f,x=\x)}
\text{enonce=On considère la fonction \(f\) définie pour tout réel \(x\) par\(f(x)=\f\). <br>L'image de \(\x\) par la fonction \(f\) est &nbsp;&#58;}
\real{bad1=-\a*(\x)^2+\b*\x+\c}
\real{bad2=\a*(\x)^2-\b*\x+\c}
\real{bad3=(\a*\x)^2+\b*\x+\c}
\text{good=\imgf}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse était \good.<br> Il suffit de remplacer la variable \(x\) par \(\x\) pour calculer l'image \(f(\x)\).}
\text{qen10=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng10=position(1,\t)}
\text{repA10=\qrep[\t[1]]}
\text{repB10=\qrep[\t[2]]}
\text{repC10=\qrep[\t[3]]}
\text{repD10=\qrep[\t[4]]}
\text{qf10=\feedback}
\text{nq=\nq,607}
\text{vlatex=\vlatex,1}
\title{Question 608 NS antécédent par une fonction du second degré sous forme développée}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\keywords{quizz,functions,reference_function}
\integer{a=randint(2..4)}
\integer{b=randint(2..5)*randitem(1,-1)}
\integer{c=randint(1..9)}
\function{f=\a*x^2+\b*x+\c}
\integer{x=randint(-2..2)}
\integer{imgf=evalue(\f,x=\x)}
\integer{imgb=evalue(\f,x=\imgf)}
\text{enonce=On considère la fonction \(f\) définie pour tout réel \(x\) par\(f(x)=\f\). <br>Un antécédent de \(\imgf\) par la fonction \(f\) est &nbsp;&#58;}
\real{bad1=\x+randitem(1,-1)}
\real{bad2=(\bad1>\x)? \x+randitem(-1,2):\x+randitem(1,-2)}
\real{bad3=(abs(\imgb-\x)<3)? \x+randitem(3,-3):\imgb}
\text{good=\x}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse était \good.<br> Il suffit de tester les images des réponses proprosées (on remplace la variable \(x\) par \(\x\) pour calculer l'image \(f(\x)\)).}
\text{qen11=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng11=position(1,\t)}
\text{repA11=\qrep[\t[1]]}
\text{repB11=\qrep[\t[2]]}
\text{repC11=\qrep[\t[3]]}
\text{repD11=\qrep[\t[4]]}
\text{qf11=\feedback}
\text{nq=\nq,608}
\text{vlatex=\vlatex,1}
\title{Question 704 NS Comparaison de séries statistiques}
\keywords{quizz,mean,standard_deviation}
\observation{Question du sujet zéro sujet-specifique-3.pdf publié sur EDUSCOL en juin 2025 }
\integer{N1=randint(10..13)}
\integer{N2=\N1-randitem(1,2)}
\integer{N3=2*\N1-\N2}
\text{serie1=\N2,\N1,\N1,\N3}
\integer{N4=\N1-randitem(3,4,5,6)}
\integer{N5=2*\N1-\N4}
\text{serie2=\N4,\N1,\N1,\N5}
\integer{a=randitem(-5,-4,-3,3,4,5)}
\integer{M1=\N1+\a}
\integer{M2=\N2+\a}
\integer{M3=\N3+\a}
\text{serie3=\M2,\M1,\M1,\M3}
\text{r3=(\a>0)? 2:1}
\text{r4=(\a>0)? 1:2}
\integer{cas=randitem(1,2,3,4)}%%1 et 2 -> même moyenne; 3 et 4 -> même écart-type%%
\matrix{donnees=\serie1,\serie2,4,1,2,3
\serie2,\serie1,3,1,2,4
\serie1,\serie3,\r3,3,4,\r4
\serie3,\serie1,\r4,3,4,\r3}
\text{enonce=On considère les deux séries suivantes&nbsp;&#58;
<ul class="wims_nopuce"><li><b>série A&nbsp;&#58; \donnees[\cas;1] &#59; \donnees[\cas;2] &#59; \donnees[\cas;3] &#59; \donnees[\cas;4]</b></li>
<li><b>série B&nbsp;&#58; \donnees[\cas;5] &#59; \donnees[\cas;6] &#59; \donnees[\cas;7] &#59; \donnees[\cas;8]</b></li></ul>
Indiquer laquelle de ces affirmations est vraie.}
\text{prop=La moyenne de la série A est strictement supérieure à la moyenne de la série B,La moyenne de la série B est strictement supérieure à la moyenne de la série A,L'écart-type de la série A est strictement supérieur à l'écart-type de la série B,L'écart-type de la série B est strictement supérieur à l'écart-type de la série A}
\text{good=\prop[\donnees[\cas;9]]}
\text{bad1=\prop[\donnees[\cas;10]]}
\text{bad2=\prop[\donnees[\cas;11]]}
\text{bad3=\prop[\donnees[\cas;12]]}
\text{bads=\bad1,\bad2,\bad3}
\text{feedback=La bonne réponse est <b>"\good"</b>. <br><b>Rappel&nbsp;&#58;</b> Plus l'écart-type d'une série statistique est grand&#44; plus les données sont dispersées.}
\text{qen12=\enonce}
\text{qrep=\good,\bads[1],\bads[2],\bads[3]}
\text{t=shuffle(4)}
\integer{ng12=position(1,\t)}
\text{repA12=\qrep[\t[1]]}
\text{repB12=\qrep[\t[2]]}
\text{repC12=\qrep[\t[3]]}
\text{repD12=\qrep[\t[4]]}
\text{qf12=\feedback}
\text{nq=\nq,704}
\text{vlatex=\vlatex,1}
%%%%%%%
\text{enonce=\qen1,\qen2,\qen3,\qen4,\qen5,\qen6,\qen7,\qen8,\qen9,\qen10,\qen11,\qen12}
\text{repA=\repA1,\repA2,\repA3,\repA4,\repA5,\repA6,\repA7,\repA8,\repA9,\repA10,\repA11,\repA12},
\text{repB=\repB1,\repB2,\repB3,\repB4,\repB5,\repB6,\repB7,\repB8,\repB9,\repB10,\repB11,\repB12}
\text{repC=\repC1,\repC2,\repC3,\repC4,\repC5,\repC6,\repC7,\repC8,\repC9,\repC10,\repC11,\repC12}
\text{repD=\repD1,\repD2,\repD3,\repD4,\repD5,\repD6,\repD7,\repD8,\repD9,\repD10,\repD11,\repD12}
\text{feed=\qf1,\qf2,\qf3,\qf4,\qf5,\qf6,\qf7,\qf8,\qf9,\qf10,\qf11,\qf12},
%%%% nombre de questions maximum
\integer{nbqap=items(\confparm1)} %%%%%% nombre de questions à poser
