\real{bad3=\prixn+(\m-\n)}
\text{bads=\bad1 euros,\bad2 euros,\bad3 euros}
\text{feedback=La bonne réponse est \good car \m croissants coûtent \(\frac{\prixn*\m}{\n}=\g) euros. }
