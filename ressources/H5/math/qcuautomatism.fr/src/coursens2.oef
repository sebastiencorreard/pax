\title{Question 123 NS Masse de liquide }
\keywords{quizz,skill_calculate,conversion}
\observation{Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 }
\matrix{liquide=d'huile,900
de miel,1400
