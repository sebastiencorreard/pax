\real{prixn=\n*randitem(1.15,1.2,1.25,1.3,1.4,1.5)}
\real{c=randitem(1.5,2.5)}
\integer{m=\n*\c}
\text{enonce=\n croissants coûtent \prixn euros. \m croissants coûtent&nbsp;&#58; }
\real{g=\m*\prixn/\n}
\text{good=\g euros}
