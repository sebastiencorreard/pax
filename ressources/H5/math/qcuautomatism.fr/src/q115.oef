\title{Question 115 NS Fraction en mots}
\keywords{quizz,fraction}
\observation{Question du sujet zéro sujet-specifique-1_0.pdf publié sur EDUSCOL en juin 2025 }
\text{ope=wims(shuffle moitié,tiers,quart)}
