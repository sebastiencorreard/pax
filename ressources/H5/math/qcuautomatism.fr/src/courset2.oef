\title{Question 700 T Equation et moyenne}
\keywords{quizz,equations,literal_calculation,mean}
\observation{Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 }
%%% a mettre aussi en q204.inc
%%% MB %%%%
\text{notes=randomrow(10,11,12;10,11,14;11,12,14;10,13,14;10,11,13)}
\text{moyenne=randomitem(15,14)}
\real{sol=(\moyenne*5-(\notes[1]+\notes[2]+\notes[3]))/2}
\text{x=randomitem(x,n)}
\text{enonce=Voici les notes sur vingt obtenues par un élève en mathématiques&nbsp;&#58;
<div class="wimscenter wims_scrollable">
<table class="wimsborder">
  <tr>
    <th>Notes</th>
    <th>\notes[1]</th>
    <th>\notes[2]</th>
    <th>\notes[3]</th>
    <th>\(\x\)</th>
  </tr>
  <tr>
    <td>Coefficient</td>
    <td>1</td>
    <td>1</td>
    <td>1</td>
    <td>2</td>
  </tr>
</table>
</div>
On cherche ce que doit valoir \(\x\) pour que la moyenne de l’élève soit égale à <span class="nowrap">\(\moyenne\).</span>}
\text{imposs=Impossible&nbsp;!<br> il faudrait une note strictement supérieure à vingt.}
\text{aucune=Aucune des solutions proposées.}
\if{\sol>20}{
  \text{good=\imposs}
  \integer{temp=randint(\moyenne+1..19)}
  \text{bads=\(\x=20\),\(\x=\moyenne \),\( \x=\temp\)}
  }
\if{\sol<20.001}{
  \integer{entsol=floor(\sol)}
  \if{\sol=\entsol}{%%% la solution est entière
    \text{good=\(\x=\sol\)}
    \text{temp=\sol=20?19:20}
    \text{bads=\(\x=\temp\),\(\x=\moyenne \),\imposs}
    }{ %% sinon ce n'est pas un entier
    \text{cas=randomitem(1,0)}
    \text{good=\cas=0?\aucune:\(\x=\sol\)}%%% on ne donne pas la valeur
    \if{\cas=0}{
      \text{temp=randomitem(17,18,19)}
      \text{bads=\(\x=20\),\(\x=\moyenne \),\(\x=\temp\)}
      }{
      \text{bads=\(\x=20\),\(\x=\moyenne \),\imposs}
      }
    }
}
%% feed plus long
\integer{som1=\notes[1]+\notes[2]+\notes[3]}
\integer{m2=5*\moyenne}
\real{xgood=(\m2-\som1)/2}
\text{feedback=La bonne réponse est <b>"\good"</b>. <br>On peut résoudre \(\frac{\notes[1]+\notes[2]+\notes[3]+2\x}{1+1+1+2}=\moyenne\)<br>\({}\Leftrightarrow \frac{\som1+2\x}{5}=\moyenne\)<br>\({}\Leftrightarrow \som1+2\x=\m2\)<br>\({}\Leftrightarrow{}\)<span class="nowrap">\(\x=\xgood\).</span><br>Puis interpréter le résultat.}
