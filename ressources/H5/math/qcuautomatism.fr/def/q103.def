!set title=Question 103 T Conversion temps
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,conversion,time
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 60,60,120

tmp0=!randitem $tmp
val8=$(tmp0)
val9=15
val10=$[rint($val8+$val9)]
val11=$[$val10/60]
val12=$[floor($val11)+$val9/100]
val13=$[($val8-$val9)/60]
tmp=!nonempty items -0.4,0.4

tmp0=!randitem $tmp
val14=$[floor($val11)+$(tmp0)]
val15=Une durée de $val10 minutes correspond à&nbsp;&#58;

!ifval $val11>1
val16=$val11 heures
!else
val16=$val11 heure
!endif

!ifval $val12>1
val17=$val12 heures
!else
val17=$val12 heure
!endif

!ifval $val13>1
val18=$val13 heures
!else
val18=$val13 heure
!endif

!ifval $val14>1
val19=$val14 heures
!else
val19=$val14 heure
!endif
val20=$val17,$val18,$val19
val21=La bonne réponse était $val16. <br>Rappel <br>60 minutes = 1 heure <br>et 15 minutes = 0.25 heure
val22=$val16,$val20
tmp0=!shuffle 4

val23=$(tmp0)
tmp0=!positionof item 1 in $val23

val24=$[rint($(tmp0))]
val25=\latexversion	    \item	    $val15	    \begin{radio}	    \item $(val22[1])	    \item $(val22[2])	    \item $(val22[3])	    \item $(val22[4])	    \end{radio}
val25=$val25 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val24;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val15	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val22[$(val23[1])]) </td><td>$(val22[$(val23[2])]) </td><td>$(val22[$(val23[3])]) </td><td>$(val22[$(val23[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val25 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val21	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,15,21,22,23,25
embedcnt=1
