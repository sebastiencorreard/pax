$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val29	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val31[$(val32[1])]) </td><td>$(val31[$(val32[2])]) </td><td>$(val31[$(val32[3])]) </td><td>$(val31[$(val32[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
