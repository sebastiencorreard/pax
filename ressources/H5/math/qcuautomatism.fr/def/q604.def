!set title=Question 604 NS résolution graphique d'une équation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,functions,equations
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=37
prevarcnt=36
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 3,4

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
!if $val8==3 
tmp=!nonempty items -2,-1

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval ($val9==-2)
tmp=!nonempty items -1,0,1

tmp0=!randitem $tmp
val10=$[rint( $(tmp0))]
!else
tmp=!nonempty items 0,1,2

tmp1=!randitem $tmp
val10=$[rint($(tmp1))]
!endif

!ifval ($val10==2)
val11=$[rint( 3)]
!else
tmp=!nonempty items 2,3

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
!endif

!ifval ($val11==3)
tmp0=!randint 7, 14

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val12=$[ 0.05*$(tmp0)*$(tmp1)]
!else
tmp2=!randint 4, 10

tmp=!nonempty items -1,1

tmp3=!randitem $tmp
val12=$[0.1*$(tmp2)*$(tmp3)]
!endif
val13=!rawmath $val12*(x-$val9)*(x-$val10)*(x-$val11)
val14=&#123;$val9;$val10;$val11&#125;
val15=&#91;$val9;$val11&#93;
val16=&#123;3&#125;
!else
tmp=!nonempty items -2,-1

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval ($val9==-2)
val10=$[rint(-1)]
!else
val10=$[rint(0)]
!endif

!ifval ($val10==0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
!else
tmp=!nonempty items 0,1

tmp1=!randitem $tmp
val11=$[rint($(tmp1))]
!endif

!ifval ($val11==2)
val17=$[rint( 3)]
!else
tmp=!nonempty items 2,3

tmp0=!randitem $tmp
val17=$[rint($(tmp0))]
!endif

!ifval ($val17==3)
tmp0=!randint 13, 20

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val12=$[ 0.02*$(tmp0)*$(tmp1)]
!else
tmp2=!randint 10, 20

tmp=!nonempty items -1,1

tmp3=!randitem $tmp
val12=$[0.05*$(tmp2)*$(tmp3)]
!endif
val13=!rawmath $val12*(x-$val9)*(x-$val10)*(x-$val11)*(x-$val17)
val14=&#123;$val9;$val10;$val11;$val17&#125;
val15=&#91;$val9;$val17&#93;
val16=&#123;4&#125;
!endif
val18=$[rint(-6)]
val19=$[rint(6)]
val20=$[rint(-6)]
val21=$[rint(6)]
val22=text black,5.5,1,giant,x	  text black,0.1,-0.2,giant,0	  text black,-1,5.8,giant,y	  text black,1.1,-0.2,giant,1	  text black,0.1,1,giant,1	  segment 1,-0.4,1,0.4,black	  segment -0.4,1,0.4,1,black	  
val23=range $val18,$val19,$val20,$val21	arrow $val18,0,$val19,0,15,black	arrow 0,$val20,0,$val21,15,black	parallel -6,-6,-6,6,1,0,13,grey	parallel -6,-6,6,-6,0,1,13,grey	hline 0,0,black	vline 0,0,black	$val22	linewidth 1	  plot black,$val13	
!readproc oef/draw.phtml 200,200 \
$val23	 
tmp0=$ins_url
val24=$(tmp0)
val25=<img src="$val24" alt="représentation graphique">
evaltmp=$val13

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val26=$[floor($(tmp0)*10)/10]
val27=&#123;$val26&#125;
val28=$val15,$val16,$val27
val29=Soit \(f\) une fonction définie sur \(\mathbb{R}\) dont la représentation graphique est donnée ci-dessous. <div class="wimscenter">$val25</div>	L’ensemble \(\mathcal{S}\) des solutions de l’équation \(f(x)=0\) est&nbsp;&#58;
val30=La bonne réponse est $val14. <br> Les solutions sont les abscisses des points d'intersection de la courbe avec l'axe des abscisses. 
val31=$val14,$val28
tmp0=!shuffle 4

val32=$(tmp0)
tmp0=!positionof item 1 in $val32

val33=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val33;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

