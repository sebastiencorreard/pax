!set title=Question 107 T Calculs avec les fractions 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,skill_calculate,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2,2

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items 3,3,6

tmp0=!randitem $tmp
val9=$(tmp0)
val10=On considère <span class="nowrap">\(T=\frac{$val8}{1-\frac{$val8}{$val9}}\).</span> Que vaut \(T\)&nbsp;&#63; 
t_=!rawmath $val8/(1-$val8/$val9)
val11=!exec pari print($t_)
val12=\($val11\)
tmp=!nonempty items -2,-1,0

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
val14=\($val13\)
tmp=!nonempty items 9,7,8

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
val16=\($val15\)
val17=\(\frac{$val8}{$val9}\)
val18=$val14,$val16,$val17
val19=$[rint($val9-$val8)]
val20=<span class="nowrap">\(T=\frac{$val8}{1-\frac{$val8}{$val9}}=\frac{$val8}{\frac{$val19}{$val9}}=$val8 \times \frac{$val9}{$val19}\).</span> <br>On utilise le fait que diviser par un nombre c'est multiplier par son inverse.
val21=La bonne réponse est $val12. <br>$val20 
val22=$val12,$val18
tmp0=!shuffle 4

val23=$(tmp0)
tmp0=!positionof item 1 in $val23

val24=$[rint($(tmp0))]
val25=\latexversion	    \item	    $val10	    \begin{radio}	    \item $(val22[1])	    \item $(val22[2])	    \item $(val22[3])	    \item $(val22[4])	    \end{radio}
val25=$val25 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val24;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val10	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val22[$(val23[1])]) </td><td>$(val22[$(val23[2])]) </td><td>$(val22[$(val23[3])]) </td><td>$(val22[$(val23[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

