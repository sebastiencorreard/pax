val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
val8=Le volume \(V\) d’un cylindre de hauteur \(h\) et de rayon \(r\) est égal à&nbsp;&#63; <div class="wimscenter">\(V=\pi r^2 h\)</div> On cherche à isoler <span class="nowrap">\(h\).</span> On a&nbsp;&#58; 
val9=\(h=\frac{V}{\pi r^2}\)
val10=\(h=\frac{\pi r^2}{V}\)
val11=\(h=\frac{r^2}{\pi V}\)
val12=\(h=\sqrt{\frac{V}{\pi r^2}}\)
val13=$val10,$val11,$val12
val14=On a \(V=\pi r^2 h\) \({}\Leftrightarrow \frac{V}{\pi}= r^2 h\) \({}\Leftrightarrow \frac{V}{\pi r^2}= h\) 
val15=La bonne réponse est $val9. <br>$val14 
val16=$val9,$val13
tmp0=!shuffle 4

val17=$(tmp0)
tmp0=!positionof item 1 in $val17

val18=$[rint($(tmp0))]
val19=\latexversion	    \item	    $val8	    \begin{radio}	    \item $(val16[1])	    \item $(val16[2])	    \item $(val16[3])	    \item $(val16[4])	    \end{radio}
val19=$val19 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val18;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val8	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val16[$(val17[1])]) </td><td>$(val16[$(val17[2])]) </td><td>$(val16[$(val17[3])]) </td><td>$(val16[$(val17[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

