ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!translate internal $	$ to ; in 10,11,12;10,11,14;11,12,14;10,13,14;10,11,13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp=!nonempty items 15,14

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[($val9*5-($(val8[1])+$(val8[2])+$(val8[3])))/2]
tmp=!nonempty items x,n

tmp0=!randitem $tmp
val11=$(tmp0)
val12=Voici les notes sur vingt obtenues par un élève en mathématiques&nbsp;&#58;	<div class="wimscenter wims_scrollable">	<table class="wimsborder">	  <tr>	    <th>Notes</th>	    <th>$(val8[1])</th>	    <th>$(val8[2])</th>	    <th>$(val8[3])</th>	    <th>\($val11\)</th>	  </tr>	  <tr>	    <td>Coefficient</td>	    <td>1</td>	    <td>1</td>	    <td>1</td>	    <td>2</td>	  </tr>	</table>	</div>	On cherche ce que doit valoir \($val11\) pour que la moyenne de l’élève soit égale à <span class="nowrap">\($val9\).</span>
val13=Impossible&nbsp;!<br> il faudrait une note strictement supérieure à vingt.
val14=Aucune des solutions proposées.
!if $val10>20 
val15=$val13
tmp0=!randint $val9+1, 19

val16=$[rint($(tmp0))]
val17=\($val11=20\),\($val11=$val9 \),\( $val11=$val16\)
!endif
!if $val10<20.001 
val18=$[rint(floor($val10))]
!if $val10=$val18 
val15=\($val11=$val10\)

!ifval $val10=20
val16=19
!else
val16=20
!endif
val17=\($val11=$val16\),\($val11=$val9 \),$val13
!else
tmp=!nonempty items 1,0

tmp0=!randitem $tmp
val19=$(tmp0)

!ifval $val19=0
val15=$val14
!else
val15=\($val11=$val10\)
!endif
!if $val19=0 
tmp=!nonempty items 17,18,19

tmp0=!randitem $tmp
val16=$(tmp0)
val17=\($val11=20\),\($val11=$val9 \),\($val11=$val16\)
!else
val17=\($val11=20\),\($val11=$val9 \),$val13
!endif
!endif
!endif
val20=$[rint($(val8[1])+$(val8[2])+$(val8[3]))]
val21=$[rint(5*$val9)]
val22=$[($val21-$val20)/2]
val23=La bonne réponse est <b>"$val15"</b>. <br>On peut résoudre \(\frac{$(val8[1])+$(val8[2])+$(val8[3])+2$val11}{1+1+1+2}=$val9\)<br>\({}\Leftrightarrow \frac{$val20+2$val11}{5}=$val9\)<br>\({}\Leftrightarrow $val20+2$val11=$val21\)<br>\({}\Leftrightarrow{}\)<span class="nowrap">\($val11=$val22\).</span><br>Puis interpréter le résultat.
val24=$val15,$val17
tmp0=!shuffle 4

val25=$(tmp0)
tmp0=!positionof item 1 in $val25

val26=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val26;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

