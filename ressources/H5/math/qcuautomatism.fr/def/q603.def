!set title=Question 603 NS Lecture graphique du coefficient directeur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,functions,affine_function
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items -4,-3,-2,-1,1,2,3,4

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp0=!randint 1, 4

val9=$[rint($(tmp0)*-$val8/abs($val8))]
val10=!rawmath $val8*x+$val9
val11=$[rint(-6)]
val12=$[rint(6)]
val13=$[rint(-6)]
val14=$[rint(6)]
val15=text black,5.7,1,medium,x	  text black,-5.3,-0.05,small,-5	  text black,-4.3,-0.05,small,-4	  text black,-3.3,-0.05,small,-3	  text black,-2.3,-0.05,small,-2	  text black,-1.3,-0.05,small,-1	  text black,0.9,-0.05,small,1	  text black,1.9,-0.05,small,2	  text black,2.9,-0.05,small,3	  text black,3.9,-0.05,small,4	  text black,4.9,-0.05,small,5	  text black,-1,5.8,medium,y	  text black,-0.8,-0.55,small,-1	  text black,-0.8,-1.55,small,-2	  text black,-0.8,-2.55,small,-3	  text black,-0.8,-3.55,small,-4	  text black,-0.8,-4.55,small,-5	  text black,-0.5,1.4,small,1	  text black,-0.5,2.4,small,2	  text black,-0.5,3.4,small,3	  text black,-0.5,4.4,small,4	  text black,-0.5,5.4,small,5	  
val16=range $val11,$val12,$val13,$val14	parallel -6,-6,-6,6,1,0,13,grey	parallel -6,-6,6,-6,0,1,13,grey	hline 0,0,black	vline 0,0,black	arrow $val11,0,$val12,0,12,black	arrow 0,$val13,0,$val14,12,black	$val15	linewidth 1	  plot black,$val10	
!readproc oef/draw.phtml 200,200 \
$val16	 
tmp0=$ins_url
val17=$(tmp0)
val18=<img src="$val17" alt="représentation graphique">
val19=$[rint($val8)]
val20=$[rint($val9)]

!ifval ($val9==-$val8)
val21=$[rint( $val9+$val9/abs($val9))]
!else
val21=$[rint(-$val8)]
!endif

!ifval ($val8<0)
val22=$[rint( $val8-1)]
!else
val22=$[rint($val8+1)]
!endif
val23=$val20,$val21,$val22
val24=On a représenté ci-dessous une droite <span class="nowrap">\(\mathcal{D}\).</span> <div class="wimscenter">$val18</div><br>	Le coefficient directeur de cette droite \(\mathcal{D}\) est&nbsp;&#58; 
val25=$[rint($val8+$val9)]

!ifval $val9<0
val26=($val9)
!else
val26=$val9
!endif
val27=La bonne réponse est $val19. <br> Les points A(0&#59;$val9) et B(1&#59;$val25) appartenant à la droite&#44; le coefficient directeur est <span class="nowrap">\(\frac{$val25-$val26}{1-0}\).</span> 
val28=$val19,$val23
tmp0=!shuffle 4

val29=$(tmp0)
tmp0=!positionof item 1 in $val29

val30=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val30;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val24	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val28[$(val29[1])]) </td><td>$(val28[$(val29[2])]) </td><td>$(val28[$(val29[3])]) </td><td>$(val28[$(val29[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val27!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val27	  </div>
$()</div>
!endif

!exit

:test

!exit

