!set title=Question 401 T Coeff. Mult. Evolution
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
val8=250,500,200,400
val9=200,400,250,500
tmp0=!itemcnt $val8

tmp1=!randint 1, $(tmp0)

val10=$(tmp1)
val8=$(val8[$val10])
val9=$(val9[$val10])
val11=$[$val9/$val8]
val12=$[$val8/$val9]
val13=$[2-$val11]
val14=$[$val8/$val9]

!ifval $val14<1
val14=$[$val14+1]
!else
val14=$[$val14-1]
!endif

!ifval $val8>$val9
val15=baissé
!else
val15=augmenté
!endif
val16=Le prix d’une tablette a $val15&#44; il est passé de $val8 euros à $val9 euros.<br> Cela signifie qu'il a été multiplié par&nbsp;&#58;
val17=\( $val11 \)
val18=\( $val12 \),\( $val13 \),\( $val14 \)
val19=La bonne réponse est $val17 puisque le coefficient multiplicateur est \( \frac{$val9}{$val8}={}\) $val17. 
val20=$val17,$val18
tmp0=!shuffle 4

val21=$(tmp0)
tmp0=!positionof item 1 in $val21

val22=$[rint($(tmp0))]
val23=\latexversion	    \item	    $val16	    \begin{radio}	    \item $(val20[1])	    \item $(val20[2])	    \item $(val20[3])	    \item $(val20[4])	    \end{radio}
val23=$val23 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val22;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val16	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val20[$(val21[1])]) </td><td>$(val20[$(val21[2])]) </td><td>$(val20[$(val21[3])]) </td><td>$(val20[$(val21[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val23 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val19	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,16,19,20,21,23
embedcnt=1
