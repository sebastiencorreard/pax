!set title=Question 104 NS Résolution de problème 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,mental_calculation,pbsolving
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randitem 10,10,10,6,8,9

val8=$[$(tmp0)]
tmp0=!randitem 0.60,0.70,0.80,0.90

val9=$[$(tmp0)]

!ifval $val8=8
val10=$[rint(2)]
!else
val10=$[rint(3)]
!endif
!readproc slib/numeration/ecriturelettre $val10 
tmp0=$slib_out
val11=$(tmp0)
val12=$[$val10*$val9]
val13=$[$val8*$val9]
val14=\($val8\) stylos coûtent en tout \($val13\)&euro;.<br> Le prix de $val11 stylos est égal à&nbsp;&#58; 
val15=&euro;
val16=$val12 euros
tmp=!nonempty items 0.3,0.25,0.20

tmp0=!randitem $tmp
tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val17=$[$val12+$(tmp0)*$(tmp1)]
val18=$[$val12+$val10]
val19=$[$val17+$val10]
val20=$val17 euros,$val18 euros,$val19 euros
val21=La bonne réponse est <b>$val16</b>. <br>Par une division&#44; un stylo coûte $val9 &euro;. Il reste ensuite à effectuer <span class="nowrap">\($val10\times $val9=$val12\).</span>
val22=$val16,$val20
tmp0=!shuffle 4

val23=$(tmp0)
tmp0=!positionof item 1 in $val23

val24=$[rint($(tmp0))]
val25=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val22[1])	    \item $(val22[2])	    \item $(val22[3])	    \item $(val22[4])	    \end{radio}
val25=$val25 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val24;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val22[$(val23[1])]) </td><td>$(val22[$(val23[2])]) </td><td>$(val22[$(val23[3])]) </td><td>$(val22[$(val23[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val25 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val21	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,21,22,23,25
embedcnt=1
