!set title=Question 453 NS Evolutions successives identiques
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,1,-1

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp0=!randint 1, 4

val9=$[rint(10*$(tmp0))]

!ifval ($val8==1)
val10= augmente
!else
val10=diminue
!endif

!ifval ($val8==1)
val11= augmentations
!else
val11=diminutions
!endif

!ifval ($val8==1)
val12= augmenté
!else
val12=diminué
!endif
val13=Un article $val10 de $val9% puis il $val10 encore de $val9%. Après ces deux	$val11 il a $val12 de&nbsp;&#58;
val14=$[(1+$val8*$val9/100)^2]
val15=$[rint(abs($val14-1)*100)]
val16=\($val15\%\)
val17=$[rint(2*$val9)]

!ifval ($val8==1)
val18=$[rint( $val15+1)]
!else
val18=$[rint($val15-1)]
!endif
val19=\(($val9\%)^2 \),\($val18\%\),\($val17\%\)
val20=$[$val9/100]

!ifval ($val8==1)
val21= En effet&#44; \(\left ( 1+\frac{$val9}{100}\right )\times \left ( 1+\frac{$val9}{100}\right )=$val14=1+\frac{$val15}{100}\).
!else
val21=En effet&#44; \(\left ( 1-\frac{$val9}{100}\right )\times \left ( 1-\frac{$val9}{100}\right )=$val14=1-\frac{$val15}{100}\). 
!endif
val22=\({}\):\({}=1-\frac{$val15}{100}\)
val23=La bonne réponse est $val16.<br> $val21
val24=$val16,$val19
tmp0=!shuffle 4

val25=$(tmp0)
tmp0=!positionof item 1 in $val25

val26=$[rint($(tmp0))]
val27=\latexversion	    \item	    $val13	    \begin{radio}	    \item $(val24[1])	    \item $(val24[2])	    \item $(val24[3])	    \item $(val24[4])	    \end{radio}
val27=$val27 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val26;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val27 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val13	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val24[$(val25[1])]) </td><td>$(val24[$(val25[2])]) </td><td>$(val24[$(val25[3])]) </td><td>$(val24[$(val25[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val27 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val23!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val23	  </div>
$()</div>
!endif

!exit

:test

!exit

