postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items x,n,t

tmp0=!randitem $tmp
val8=$(tmp0)
val9=2,4,10
tmp=!nonempty items 0.4,0.6

tmp0=!randitem $tmp
val10=0.5,0.5,$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val9=$[rint($(val9[$val11]))]
val10=$[$(val10[$val11])]
val12=!rawmath ($val9*x + $val10)^2
val13=$[rint($val9^2)]
val14=$[rint(2*$val9*$val10)]
val15=$[$val10^2]
val16=L’expression développée de \(($val9 $val8 + $val10)^2\) est&nbsp;&#58; 
val17=\($val13*$val8^2+$val14*$val8+$val15\)
val18=$[rint($val9*$val10)]
val19=\($val13*$val8^2+$val18*$val8+$val15\)
val20=$[rint(2*$val13)]
val21=\($val13*$val8^2+$val20*$val8+$val15\)
val22=$[rint(2*$val10)]
val23=\($val13*$val8^2+$val14*$val8+$val22\)
val24=$val19,$val21,$val23
val25=La bonne réponse est $val17. <ul class="wims_nopuce"><li> Soit on développe <span class="nowrap">\(($val9 $val8 + $val10)($val9 $val8 + $val10)\).</span><i>(double distributivité)</i></li><li>Soit on utilise l'identité remarquable <span class="nowrap">\(($val9 $val8 + $val10)^2=($val9 $val8)^2+2\times$val10\times$val9\times $val8+$val10^2\).</span></li></ul> On rappelle que&nbsp;&#58;<br> \(($val9 $val8)^2=$val9 $val8 \times $val9 $val8\)<br>\({}=$val9^2 $val8^2\)<br><span class="nowrap">\({}=$val13 $val8^2\).</span> 
val26=$val17,$val24
tmp0=!shuffle 4

val27=$(tmp0)
tmp0=!positionof item 1 in $val27

val28=$[rint($(tmp0))]
val29=\latexversion	    \item	    $val16	    \begin{radio}	    \item $(val26[1])	    \item $(val26[2])	    \item $(val26[3])	    \item $(val26[4])	    \end{radio}
val29=$val29 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val28;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val29 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val16	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val26[$(val27[1])]) </td><td>$(val26[$(val27[2])]) </td><td>$(val26[$(val27[3])]) </td><td>$(val26[$(val27[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
