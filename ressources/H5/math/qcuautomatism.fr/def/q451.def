!set title=Question 451 NS coefficient multiplicateur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 11, 79

val8=$[$(tmp0)/10]
tmp=!nonempty items 1,1,1,2

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval $val9=1
val10=diminue
!else
val10=augmente
!endif
val11=Par combien faut-il multiplier une quantité positive pour que celle-ci $val10 de \($val8 \%\)&nbsp;&#58;

!ifval ($val9==1)
val12=$[ 1-$val8/100]
!else
val12=$[1+$val8/100]
!endif

!ifval ($val9==1)
val13=$[ 1-$val8/10]
!else
val13=$[1+$val8/10]
!endif

!ifval ($val9==2)
val14=$[ 1-$val8/100]
!else
val14=$[1+$val8/100]
!endif

!ifval ($val9==2)
val15=$[ 1-$val8/10]
!else
val15=$[1+$val8/10]
!endif
val16=$val13,$val14,$val15

!ifval ($val9==1)
val17=\( 1-\frac{$val8}{100}\)
!else
val17= \( 1+\frac{$val8}{100}\)
!endif
val18=La bonne réponse est $val12 puisque le coefficient multiplicateur est égal à $val17. 
val19=$val12,$val16
tmp0=!shuffle 4

val20=$(tmp0)
tmp0=!positionof item 1 in $val20

val21=$[rint($(tmp0))]
val22=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val19[1])	    \item $(val19[2])	    \item $(val19[3])	    \item $(val19[4])	    \end{radio}
val22=$val22 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val21;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val19[$(val20[1])]) </td><td>$(val19[$(val20[2])]) </td><td>$(val19[$(val20[3])]) </td><td>$(val19[$(val20[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val22 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val18	  </div>
$()</div>
!endif

!exit

:test

!exit

