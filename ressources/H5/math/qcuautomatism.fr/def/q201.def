!set title=Question 201 T Signe fonction affine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,inequations,affine_function
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!shuffle 2,3,4

val9=$(tmp0)
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val10=$[rint($(val9[1])*$(tmp0))]
val11=$[rint(-$val8*$val10)]
val12=!rawmath $val10*x+$val11
val13=!rawmath x+$val8

!ifval $val10<0
val14=!rawmath  x-$val8
!else
val14=!rawmath $val8-x
!endif

!ifval $val10<0
val15=$[rint(-1*$(val9[2]))]
!else
val15=$[rint($(val9[2]))]
!endif
val16=!rawmath $val15*x+$val8
!readproc slib/function/tabsignes [[x,$val12],[-Inf,+Inf;$val8; ]],text=[\(f(x)\),replace,2] wimscenter wims_scrollable 
tmp0=$slib_out
val17=$(tmp0)
val18=On considère une fonction \(f\) définie sur \(RR\) dont le tableau de signes est donné ci-dessous. $val17 Quelle est la seule expression de \(f(x)\) possible&nbsp;&#63;
val19=\(f(x)=$val12\)
val20=\(f(x) = $val14 \),\(f(x) = $val13\) ,\(f(x) = $val16\)

!ifval $val10<0
val21=négatif
!else
val21=positif
!endif

!ifval $val10<0
val22=positive
!else
val22=négative
!endif

!ifval $val10<0
val23=négative
!else
val23=positive
!endif
val24=La bonne réponse était $val19.<br> Puisque \(f($val8)=0\) et que son coefficient directeur \($val10\) est $val21.<br><u>Rappel&nbsp;&#58;</u> la fonction est d'abord $val22 puis $val23 donc le coefficient directeur est $val21 .
val25=$val19,$val20
tmp0=!shuffle 4

val26=$(tmp0)
tmp0=!positionof item 1 in $val26

val27=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val27;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val18	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val25[$(val26[1])]) </td><td>$(val25[$(val26[2])]) </td><td>$(val25[$(val26[3])]) </td><td>$(val25[$(val26[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val24!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val24	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
