!set title=Question 301 S Equation carrée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,equations,squareroot
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items x,y,t

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items 6,8,10

tmp0=!randitem $tmp
tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(abs($val9/2))]
val11=On note \(\mathcal{S}\) l’ensemble des solutions de l’équation \($val8^2=$val9\) sur <span class="nowrap">\(RR\).</span> On a&nbsp;&#58;
val12=\sqrt{$val9}

!ifval $val9<0
val13=\(\mathcal{S}=\varnothing\)
!else
val13=\(\mathcal{S}=\left\{ -$val12 ; $val12 \right\} \)
!endif
val14=$[rint(abs($val9))]

!ifval $val9<0
val15=\(\mathcal{S}=\left\{ -\sqrt{$val14} ; \sqrt{$val14} \right\} \)
!else
val15=\(\mathcal{S}=\varnothing\)
!endif
val16=\(\mathcal{S}=\left\{ -$val10 ; $val10 \right\} \)
val17=\(\mathcal{S}=\left\{ -\sqrt{$val10} ; \sqrt{$val10} \right\} \),$val15,$val16
val18=Tous les carrés sont positifs. Aucun ne peut être égal à $val9.
val19=Si on l'a oublié&#44; on peut résoudre&nbsp;&#58; <br>\($val8^2-$val9=0\) \(\Leftrightarrow\) \(($val8-\sqrt{$val9})($val8+\sqrt{$val9})=0\)

!ifval $val9<0
val20=$val18
!else
val20=$val19
!endif
val21=La bonne réponse est "$val13".<br> $val20
val22=$val13,$val17
tmp0=!shuffle 4

val23=$(tmp0)
tmp0=!positionof item 1 in $val23

val24=$[rint($(tmp0))]
val25=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val22[1])	    \item $(val22[2])	    \item $(val22[3])	    \item $(val22[4])	    \end{radio}
val25=$val25 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val24;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val25 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val22[$(val23[1])]) </td><td>$(val22[$(val23[2])]) </td><td>$(val22[$(val23[3])]) </td><td>$(val22[$(val23[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val25 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val21!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val21	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,11,21,22,23,25
embedcnt=1
