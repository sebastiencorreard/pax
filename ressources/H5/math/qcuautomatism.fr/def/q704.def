ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 10, 13

val8=$[rint($(tmp0))]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val9=$[rint($val8-$(tmp0))]
val10=$[rint(2*$val8-$val9)]
val11=$val9,$val8,$val8,$val10
tmp=!nonempty items 3,4,5,6

tmp0=!randitem $tmp
val12=$[rint($val8-$(tmp0))]
val13=$[rint(2*$val8-$val12)]
val14=$val12,$val8,$val8,$val13
tmp=!nonempty items -5,-4,-3,3,4,5

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
val16=$[rint($val8+$val15)]
val17=$[rint($val9+$val15)]
val18=$[rint($val10+$val15)]
val19=$val17,$val16,$val16,$val18

!ifval ($val15>0)
val20= 2
!else
val20=1
!endif

!ifval ($val15>0)
val21= 1
!else
val21=2
!endif
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
val22=$[rint($(tmp0))]
tmp=!trim $val11,$val14,4,1,2,3	$val14,$val11,3,1,2,4	$val11,$val19,$val20,3,4,$val21	$val19,$val11,$val21,3,4,$val20
val23=!translate internal $	\
$ to ;; in $tmp
val24=On considère les deux séries suivantes&nbsp;&#58;	<ul class="wims_nopuce"><li><b>série A&nbsp;&#58; $(val23[$val22;1]) &#59; $(val23[$val22;2]) &#59; $(val23[$val22;3]) &#59; $(val23[$val22;4])</b></li>	<li><b>série B&nbsp;&#58; $(val23[$val22;5]) &#59; $(val23[$val22;6]) &#59; $(val23[$val22;7]) &#59; $(val23[$val22;8])</b></li></ul>	Indiquer laquelle de ces affirmations est vraie.
val25=La moyenne de la série A est strictement supérieure à la moyenne de la série B,La moyenne de la série B est strictement supérieure à la moyenne de la série A,L'écart-type de la série A est strictement supérieur à l'écart-type de la série B,L'écart-type de la série B est strictement supérieur à l'écart-type de la série A
val26=$(val25[$(val23[$val22;9])])
val27=$(val25[$(val23[$val22;10])])
val28=$(val25[$(val23[$val22;11])])
val29=$(val25[$(val23[$val22;12])])
val30=$val27,$val28,$val29
val31=La bonne réponse est <b>"$val26"</b>. <br><b>Rappel&nbsp;&#58;</b> Plus l'écart-type d'une série statistique est grand&#44; plus les données sont dispersées.
val32=$val26,$val30
tmp0=!shuffle 4

val33=$(tmp0)
tmp0=!positionof item 1 in $val33

val34=$[rint($(tmp0))]
val35=\latexversion	    \item	    $val24	    \begin{radio}	    \item $(val32[1])	    \item $(val32[2])	    \item $(val32[3])	    \item $(val32[4])	    \end{radio}
val35=$val35 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val34;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val35 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

