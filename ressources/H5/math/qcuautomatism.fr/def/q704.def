$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val24	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val32[$(val33[1])]) </td><td>$(val32[$(val33[2])]) </td><td>$(val32[$(val33[3])]) </td><td>$(val32[$(val33[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
