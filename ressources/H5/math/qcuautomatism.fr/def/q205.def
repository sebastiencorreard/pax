oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!translate internal $	$ to ; in 10,8,16;10,7,15;11,8,16;10,9,15;10,8,16

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val9=$[rint($(val8[3])-1)]
val10=$[$val9*3-($(val8[1])+$(val8[2])*2)]
tmp=!nonempty items x,c

tmp0=!randitem $tmp
val11=$(tmp0)
val12=Voici une série de notes avec les coefficients associés&nbsp;&#58;	<div class="wimscenter wims_scrollable">	<table class="wimsborder">	  <tr>	    <th>Notes</th>	    <th>$(val8[1])</th>	    <th>$(val8[2])</th>	    <th>$(val8[3])</th>	    </tr>	  <tr>	    <td>Coefficient</td>	    <td>1</td>	    <td>2</td>	    <td>\($val11\)</td>	  </tr>	</table>	</div>	On note \(&#119898;\) la moyenne de cette série. Que doit valoir \($val11\) pour que \(m=$val9\)&nbsp;&#63;
val13=Impossible
val14=Aucune des solutions proposées.

!ifval $val10>20
val15=$val13
!else
val15=$val10
!endif
val15=\($val11=$val15\)

!ifval $val10>20
val16=16
!else
val16=$val13
!endif
tmp0=!shuffle 3,4,5

val17=$(tmp0)
val18=$(val17[1])
val19=$(val17[2])
val20=\($val11=$val16\),\($val11 =$val18\),\($val11 =$val19\)
val21=La bonne réponse est <b>"$val15"</b>. On peut résoudre <span class="nowrap">\(\frac{$(val8[1])+2 \times $(val8[2])+$(val8[3])\times $val11}{1+2+$val11}=$val9\).</span><br>Puis interpréter le résultat.
val22=$val15,$val20
tmp0=!shuffle 4

val23=$(tmp0)
tmp0=!positionof item 1 in $val23

val24=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val24;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val12	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val22[$(val23[1])]) </td><td>$(val22[$(val23[2])]) </td><td>$(val22[$(val23[3])]) </td><td>$(val22[$(val23[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

