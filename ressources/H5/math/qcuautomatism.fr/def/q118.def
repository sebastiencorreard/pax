!set title=Question 118 NS Conversion de durée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,time,conversion
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim 75,5/4,3/4,0.25,1.5	80,4/3,0.8,1.2,5/8	90,1.5,1.3,0.9,2/3	120,2,1.2,1.6,1.12	100,5/3,2,1.4,4/3	105,7/4,1.45,9/4,1.05	135,2.25,1.35,2.15,11/4	140,7/3,8/3,1.4,2.2	150,2.5,1.5,11/6,7/6	160,8/3,1.6,2.4,7/3	200,10/3,2,4/3,3.2
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)

!ifval ($(val9[1])>=120)
val10= heures
!else
val10=heure
!endif
val11=$[rint(floor($(val9[1])/60))]
val12=$[rint($(val9[1])-60*$val11)]
val13=Une durée de $(val9[1]) minutes correspond à&nbsp;&#58; 
val14=\($(val9[2])\) $val10
val15=\($(val9[3])\) $val10,\($(val9[4])\) $val10,\($(val9[5])\) $val10
val16=La bonne réponse est $val14.<br> En effet&#44; 1h=60 min donc $(val9[1]) minutes correspondent à $val11 $val10 et $val12 minutes.
val17=$val14,$val15
tmp0=!shuffle 4

val18=$(tmp0)
tmp0=!positionof item 1 in $val18

val19=$[rint($(tmp0))]
val20=\latexversion	    \item	    $val13	    \begin{radio}	    \item $(val17[1])	    \item $(val17[2])	    \item $(val17[3])	    \item $(val17[4])	    \end{radio}
val20=$val20 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val19;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val13	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val17[$(val18[1])]) </td><td>$(val17[$(val18[2])]) </td><td>$(val17[$(val18[3])]) </td><td>$(val17[$(val18[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val16	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,13,16,17,18,20
embedcnt=1
