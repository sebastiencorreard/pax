!set title=Question 203 T Résolution d'équation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,equations,literal_calculation
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 14, 17

val8=$(tmp0)
tmp=!nonempty items 9,7,8

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[rint($val8*$val9)]
tmp=!nonempty items x,x,m,n,t,h

tmp0=!randitem $tmp
val11=$(tmp0)
val12=La solution de l’équation \(\frac{$val10}{$val11} = $val9 \) est&nbsp;&#58;
val13=\($val11=\frac{$val10}{$val9} \)
val14=\($val11=$val10 \times $val9\),\($val11=\frac{$val9}{$val10} \),\( $val11=-$val8\)
val15=Puisque l'équation est équivalente à <span class="nowrap">\($val10=$val9 \times $val11\).</span>,Puisque l'équation est équivalente à <span class="nowrap">\(\frac{$val11}{$val10} = \frac{1}{$val9} \).</span>
tmp=!nonempty items $val15

tmp0=!randitem $tmp
val15=$(tmp0)
val16=La bonne réponse est $val13. <br>$val15
val17=$val13,$val14
tmp0=!shuffle 4

val18=$(tmp0)
tmp0=!positionof item 1 in $val18

val19=$[rint($(tmp0))]
val20=\latexversion	    \item	    $val12	    \begin{radio}	    \item $(val17[1])	    \item $(val17[2])	    \item $(val17[3])	    \item $(val17[4])	    \end{radio}
val20=$val20 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val19;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val20 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val12	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val17[$(val18[1])]) </td><td>$(val17[$(val18[2])]) </td><td>$(val17[$(val18[3])]) </td><td>$(val17[$(val18[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val20 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val16	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,16,17,18,20
embedcnt=1
