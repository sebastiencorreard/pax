!set title=Question 452 NS Fréquence et effectif total
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 6, 12

val8=$[rint(100*$(tmp0))]
tmp=!nonempty items 4,5,8,10,20

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint($val9*$val8/100)]
tmp=!nonempty items étudient le latin,étudient le grec,font du théatre,suivent l'option musique

tmp0=!randitem $tmp
val11=$(tmp0)
val12=Dans un lycée&#44; \($val10\) élèves $val11&#44; ce qui représente \($val9 \%\) du nombre	d’élèves inscrits dans ce lycée.<br> Le nombre d’élèves inscrits dans ce lycée est égal à&nbsp;&#58;
val13=\($val8\)
val14=$[rint($val9*$val10/100)]
val15=$[rint($val10*$val10/($val9/2))]
val16=$[rint($val9*$val10)]
val17=\($val14 \),\($val15\),\($val16\)
val18=$[$val9/100]
val19=\($val9 \%\) de l'effectif de total de ce lycée donne <span class="nowrap">\($val10\).</span> <br>L'effectif total est solution de l'équation&nbsp;&#58; <br>\(x \times $val18=$val10\)<br> <span class="nowrap">\({}\Leftrightarrow x=$val10  \div $val18\).</span>
val20=La bonne réponse est "$val13".<br> $val19
val21=$val13,$val17
tmp0=!shuffle 4

val22=$(tmp0)
tmp0=!positionof item 1 in $val22

val23=$[rint($(tmp0))]
val24=\latexversion	    \item	    $val12	    \begin{radio}	    \item $(val21[1])	    \item $(val21[2])	    \item $(val21[3])	    \item $(val21[4])	    \end{radio}
val24=$val24 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val23;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val12	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val21[$(val22[1])]) </td><td>$(val21[$(val22[2])]) </td><td>$(val21[$(val22[3])]) </td><td>$(val21[$(val22[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

