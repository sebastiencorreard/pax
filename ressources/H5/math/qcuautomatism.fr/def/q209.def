choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
val8=la vitesse \(v\),le rayon \(\R\)
tmp=!nonempty items 1,1,2

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=\(v=\sqrt{a R}\),\(R=\frac{v^2}{a}\)
val11=Lorsqu’un point mobile suit une trajectoire circulaire de rayon \(R\)&#44; en mètre (m)&#44; son accélération centripète \(a\) (en m/s²) s’exprime en fonction de la vitesse \(v\) (en m/s) de la manière suivante&nbsp;&#58; <div class="wimscenter">\(a=\frac{v^2}{R}\)</div> L’expression permettant&#44; à partir de cette formule&#44; d’exprimer $(val8[$val9]) est&nbsp;&#58; 
val12=$(val10[$val9])
!if $val9=1 
val13=\(v=a R^2\)
val14=\(v=\sqrt{\frac{a}{R}}\)
val15=\(v=\frac{a^2}{R}\)
!endif
!if $val9=2 
val13=\(R=a v^2\)
val14=\(R=\sqrt{\frac{a}{v}}\)
val15=\(R=\frac{a^2}{v}\)
!endif
val16=$val13,$val14,$val15
val17=On a \(a=\frac{v^2}{R}\) \({}\Leftrightarrow a R=v^2\) 
val18=\({}\Leftrightarrow \sqrt{a R}=v\) <i>puisque \(v\) est positive.</i>, \({}\Leftrightarrow R=\frac{v^2}{a}\)
val19=La bonne réponse est $val12. <br>$val17 $(val18[$val9]) 
val20=$val12,$val16
tmp0=!shuffle 4

val21=$(tmp0)
tmp0=!positionof item 1 in $val21

val22=$[rint($(tmp0))]
val23=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val20[1])	    \item $(val20[2])	    \item $(val20[3])	    \item $(val20[4])	    \end{radio}
val23=$val23 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val22;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

