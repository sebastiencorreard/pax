!set title=Question 850 S Probabilités et arbre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=probability,conditional_probability,quizz
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 9

val8=$(tmp0)
val9=$[$(val8[1])/10]
val10=$[$(val8[2])/10]
val11=$[$(val8[3])/10]
val12=$[1-$val11]
val13=$[1-$val9]
val14=$[1-$val10]
val15=$[$val12*$val9]
val16=$[$val11*$val14]
val17=$[$val11*$val10]
val18=$[$val15+$val17]
val19=xrange 0,256	yrange 0,160	copy 0,160,-1,-1,-1,-1,850.png	text black,150,150,giant,$val9	text black,150,25,giant,$val14	text black,40,120,giant,$val12
!readproc oef/draw.phtml 256,160 \
$val19 
tmp0=$ins_url
val20=$(tmp0)
!readproc oef/draw.phtml 256,160 \
$val19	text green,150,105,giant,$val13	text green,40,55,giant,$val11	text green,150,70,giant,$val10 
tmp0=$ins_url
val21=$(tmp0)
val22=On considère l’arbre de probabilité ci-joint.<div class="wimscenter"><img src="$val20" alt="arbre"></div> On cherche la probabilité de l’évènement <span class="nowrap">\(B\).</span> <br>On a&nbsp;&#58;
val23=\(P(B)=$val18\)
val24=$[$val12*$val9]
val25=$[$val9]

!ifval $val9+$val16=$val18
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val26=$[$val18+$(tmp0)*0.01]
!else
val26=$[$val9+$val16]
!endif
val27=\(P(B)=$val24\),\(P(B)=$val25 \),\(P(B)=$val26\)
val28=La bonne réponse est <b>"$val23"</b>.<br> On complète l'arbre&nbsp;&#58;<div class="wimscenter"><img src="$val21" alt="arbre"></div> On utilise le fait que \(P(B)=P(A \cap B)+P(\bar{ A } \cap B)\)<br> Ici \(P(B)=$val12\times$val9+$val11\times$val10=$val18\) 
val29=$val23,$val27
tmp0=!shuffle 4

val30=$(tmp0)
tmp0=!positionof item 1 in $val30

val31=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val31;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val22	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val29[$(val30[1])]) </td><td>$(val29[$(val30[2])]) </td><td>$(val29[$(val30[3])]) </td><td>$(val29[$(val30[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val28!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val28	  </div>
$()</div>
!endif

!exit

:test

!exit

