!set title=Question 123 NS Masse de liquide 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,skill_calculate,conversion
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim d'huile,900	de miel,1400	de liquide vaisselle,1100	de sirop d'érable,1300	de kérosène,800	de sirop de grenadine,1200
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp=!nonempty items 250,750

tmp0=!randitem $tmp
tmp=!nonempty items 200,400,600,800

tmp1=!randitem $tmp
tmp=!nonempty items $(tmp0),$(tmp1)

tmp2=!randitem $tmp
val10=$[rint($(tmp2))]
val11=La masse d’un litre $(val9[1]) est égale à $(val9[2]) grammes.<br>	La masse de $val10 millilitres $(val9[1]) est égale à&nbsp;&#58; 
val12=$[$(val9[2])*$val10/1000]
val13=$[$val12/1000]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
val15=$[$val12*10]
val16=$[$val12/10]
val17=$[$val12/100]

!ifval ($val14==1)
val18= $val12 g
!else
val18=$val13 kg
!endif

!ifval ($val14==1)
val19= $val13 g
!else
val19=$val12 kg
!endif

!ifval ($val14==1)
val20= $val17 kg
!else
val20=$val17 g
!endif

!ifval ($val14==1)
val21= $val16 kg
!else
val21=$val15 g
!endif
val22=$val19,$val20,$val21
val23=La bonne réponse est $val18. <br>En effet, la masse de 1000 mL d'$(val9[1]) est égale à $(val9[2]) g donc la masse de $val10 millilitres de liquide est égale à 	$(val9[2])&times$val10/1000=$val12 g=$val13 kg. 
val24=$val18,$val22
tmp0=!shuffle 4

val25=$(tmp0)
tmp0=!positionof item 1 in $val25

val26=$[rint($(tmp0))]
val27=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val24[1])	    \item $(val24[2])	    \item $(val24[3])	    \item $(val24[4])	    \end{radio}
val27=$val27 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val26;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val27 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val24[$(val25[1])]) </td><td>$(val24[$(val25[2])]) </td><td>$(val24[$(val25[3])]) </td><td>$(val24[$(val25[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

