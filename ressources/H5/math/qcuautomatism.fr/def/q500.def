!set title=Question 500 T Calcul nouveau prix
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 11, 17

val8=$[rint($(tmp0)*10)]
tmp0=!randint 1, 9

val9=$[rint($(tmp0)*10)]
val10=$[$val9/100]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val11=$(tmp0)
val12=$[1$val11$val10]

!ifval $val11 issametext -
val13=baissé
!else
val13=augmenté
!endif
val14=Un sac coûte $val8 euros. Il a $val13 de <span class="nowrap">\( $val9 \%\).</span><br> Le nouveau prix est&nbsp;&#58;
tmp=!nonempty items \( $val8 \times $val12 \),\($val8 \times \left(1 $val11 \frac{$val9}{100} \right) \)

tmp0=!randitem $tmp
val15=$(tmp0)

!ifval $val11 issametext -
val16=+
!else
val16=-
!endif

!ifval evol issametext -
val17=-
!else
val17=
!endif
val18=$[1 $val16 $val10]

!ifval $val15 issametext \( $val8 \times $val12 \)
val19=\($val8 \times \left(1 $val16 \frac{$val9}{100}\right) \)
!else
val19=\( $val8 \times $val18 \)
!endif
val20=\($val8 \times $val10 \),\($val8 \times \left($val17 \frac{$val9}{100} \right) \) ,$val19 

!ifval $val15 issametext \( $val8 \times $val12 \)
val21=<br>Le calcul à produire est \($val8 \times \left(1 $val11 \frac{$val9}{100}\right) \) <br>\({}=$val8 \times \left(1 $val11 $val10\right)\) <br><span class="nowrap">\({}=$val8 \times $val12\).</span>
!else
val21=
!endif
val22=La bonne réponse est $val15. <br>$val21 
val23=$val15,$val20
tmp0=!shuffle 4

val24=$(tmp0)
tmp0=!positionof item 1 in $val24

val25=$[rint($(tmp0))]
val26=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val23[1])	    \item $(val23[2])	    \item $(val23[3])	    \item $(val23[4])	    \end{radio}
val26=$val26 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val25;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val26 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val23[$(val24[1])]) </td><td>$(val23[$(val24[2])]) </td><td>$(val23[$(val24[3])]) </td><td>$(val23[$(val24[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val26 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val22!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val22	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,22,23,24,26
embedcnt=1
