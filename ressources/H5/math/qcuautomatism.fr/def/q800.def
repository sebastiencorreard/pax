keywords=quizz,probability
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=42
prevarcnt=41
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,3,5

tmp0=!randitem $tmp
val8=$(tmp0)
val9=0.$val8
tmp=!nonempty items 3,6

tmp0=!randitem $tmp
val10=$(tmp0)
val11=1/$val10

!ifval $val10=3
val12=$[1]
!else
val12=$[2]
!endif
val13=$[0.$val12]
val14=$[rint($val10*10)]
val15=$[rint(($val8+$val12)*$val10+10)]
t_=!replace internal \( by ( in gcd($val14,$val15)
tmp0=!exec maxima $t_

val16=$[rint($(tmp0))]
val14=$[rint($val14/$val16)]
val15=$[rint($val15/$val16)]
val17=$[rint($val15)]
val18=$[rint($val14)]
val15=$[rint($val14-$val15)]
val19=$val15/$val14
tmp0=!shuffle $val9,$val11,$val13

val20=$(tmp0)
val9=$(val20[1])
val11=$(val20[2])
val13=$(val20[3])
tmp=!nonempty items x,x,y,p

tmp0=!randitem $tmp
val21=$(tmp0)
val22=On lance un dé à 4 faces. La probabilité d’obtenir chacune des faces est donnée dans le tableau ci-dessous&nbsp;&#58;	<div class="wimscenter wims_scrollable">	<table class="wimsborder">	  <tr>	    <th>Face numéro 1 </th>	    <th>Face numéro 2 </th>	    <th>Face numéro 3 </th>	    <th>Face numéro 4 </th>	  </tr>	  <tr>	    <td>\($val9\)</td>	    <td>\($val11\)</td>	    <td>\($val13\)</td>	    <td>\($val21\)</td>	    </tr>	</table>	</div>	On peut affirmer que&nbsp;&#58;
val19=\($val21=$val19\)
val23=$[rint($val8*$val10+10)]
val24=$[rint(10*$val10)]
t_=!replace internal \( by ( in gcd($val23,$val24)
tmp0=!exec maxima $t_

val16=$[rint($(tmp0))]
val23=$[rint($val23/$val16)]
val24=$[rint($val24/$val16)]
val25=$val23/$val24
val26=$[rint(floor(10*($val11+$val13)))]
val26=0.$val26
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val27=$[rint(floor(10-10*($val9+$val11+$val13))+$(tmp0))]
val27=0.$val27
val16=$[$val26+0.1]

!ifval $val27=$val26
val27=$val16
!else
val27=$val27
!endif
val28=\($val21=$val25\),\($val21=$val26 \),\( $val21=$val27\)
val29=La bonne réponse est <b>"$val19"</b>.<br> Il faut calculer \($val9+$val11+$val13\) <span class="nowrap">\({}=\frac{$val17}{$val18}\).</span><br>Puis <span class="nowrap">\(1-\frac{$val17}{$val18}\).</span>
val30=$val19,$val28
tmp0=!shuffle 4

val31=$(tmp0)
tmp0=!positionof item 1 in $val31

val32=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val32;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

