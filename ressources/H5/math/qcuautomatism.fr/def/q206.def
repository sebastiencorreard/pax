!set title=Question 206 T Isoler une variable
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,literal_calculation
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
!if $val8=1 
val9=\(\mathcal{C} = (1 + t)^2\)
val10=\(t = \sqrt{\mathcal{C}} - 1 \)
val11=\(t = 1-\sqrt{\mathcal{C}} \),\(t = \sqrt{\mathcal{C} - 1} \),\(t = \sqrt{1-\mathcal{C} } \)
val12=La bonne réponse est $val10.<br> Puisque \(\mathcal{C} = (1 + t)^2\) un calcul intermédiaire est <span class="nowrap">\( \sqrt{\mathcal{C}}=t + 1 \).</span>
!endif
!if $val8=2 
val9=\(\mathcal{C} = (1 - t)^2\)
val10=\(t = 1-\sqrt{\mathcal{C}} \)
val11=\(t = \sqrt{\mathcal{C}}+1 \),\(t = \sqrt{1-\mathcal{C} } \),\(t = \sqrt{\mathcal{C}+1 } \)
val12=La bonne réponse est $val10.<br> Puisque $val10 un calcul intermédiaire est <span class="nowrap">\( \sqrt{\mathcal{C}}=1-t \).</span>
!endif
!if $val8=3 
val9=\(\mathcal{C} = 1 - t^2\)
val10=\(t = \sqrt{1-\mathcal{C}} \)
val11=\(t = 1-\sqrt{\mathcal{C}} \),\(t = \sqrt{\mathcal{C} - 1} \),\(t = \sqrt{\mathcal{C}}+1 \)
val12=La bonne réponse est $val10.<br> Puisque $val10 un calcul intermédiaire est <span class="nowrap">\( t^2=1-\mathcal{C} \).</span>
!endif
!if $val8=4 
val9=\(\mathcal{C} = 1 + t^2\)
val10=\(t = \sqrt{\mathcal{C}-1} \)
val11=\(t = 1-\sqrt{\mathcal{C}} \),\(t = \sqrt{\mathcal{C} + 1} \),\(t = \sqrt{\mathcal{C}}+1 \)
val12=La bonne réponse est $val10.<br> Puisque $val10 un calcul intermédiaire est <span class="nowrap">\( \mathcal{C}-1=t^2\).</span>
!endif
val13=On considère la relation $val9. On cherche à isoler la variable <span class="nowrap">\(t\).</span> On a&nbsp;&#58;
val14=$val10,$val11
tmp0=!shuffle 4

val15=$(tmp0)
tmp0=!positionof item 1 in $val15

val16=$[rint($(tmp0))]
val17=\latexversion	    \item	    $val13	    \begin{radio}	    \item $(val14[1])	    \item $(val14[2])	    \item $(val14[3])	    \item $(val14[4])	    \end{radio}
val17=$val17 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val16;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val13	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val14[$(val15[1])]) </td><td>$(val14[$(val15[2])]) </td><td>$(val14[$(val15[3])]) </td><td>$(val14[$(val15[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
