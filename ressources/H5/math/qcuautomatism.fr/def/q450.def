!set title=Question 450 S Proportion de proportions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
val8=le quart,la moitié,le dixième,le cinquième
val9=0.25,0.50,0.10,0.20
val10=25,50,10,20
tmp0=!shuffle 4

val11=$(tmp0)
val12=$(val8[$(val11[1])])
val13=$(val8[$(val11[2])])
val14=Dans un lycée&#44; $val12 des élèves sont internes&#44; parmi eux&#44; $val13 sont des filles.<br>La proportion des filles internes par rapport à l’ensemble des élèves du lycée est égale à&nbsp;&#58;
val15=$[$(val9[$(val11[1])])*$(val9[$(val11[2])])*100]
val15=$val15 &#37;
tmp=!nonempty items 4,7,8

tmp0=!randitem $tmp
val16=$(tmp0)
val17=$(val10[$(val11[1])]) &#37;,$(val10[$(val11[2])]) &#37;,$val16 &#37;
val18=La bonne réponse est $val15 puisque le coefficient multiplicateur est égal à <span class="nowrap">\( $(val9[$(val11[1])])\times$(val9[$(val11[2])])\).</span> 
val19=$val15,$val17
tmp0=!shuffle 4

val20=$(tmp0)
tmp0=!positionof item 1 in $val20

val21=$[rint($(tmp0))]
val22=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val19[1])	    \item $(val19[2])	    \item $(val19[3])	    \item $(val19[4])	    \end{radio}
val22=$val22 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val21;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val19[$(val20[1])]) </td><td>$(val19[$(val20[2])]) </td><td>$(val19[$(val20[3])]) </td><td>$(val19[$(val20[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val22 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val18	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,18,19,20,22
embedcnt=1
