!set title=Question 202 T Résolution d'équation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,equations,literal_calculation
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 8

val8=$(tmp0)
tmp=!nonempty items x,x,m,n,t,h

tmp0=!randitem $tmp
val9=$(tmp0)
val10=La solution de l’équation \($val8$val9 = 0\) est&nbsp;&#58;
val11=\($val9=0\)
val12=\($val9=\frac{1}{$val8}\),\($val9=-\frac{1}{$val8}\),\($val9=-$val8\)
val13=La bonne réponse est $val11.<br> Puisque le produit est nul et que \($val8\) ne l'est pas&#44; c'est \($val9\) qui est nul.
val14=$val11,$val12
tmp0=!shuffle 4

val15=$(tmp0)
tmp0=!positionof item 1 in $val15

val16=$[rint($(tmp0))]
val17=\latexversion	    \item	    $val10	    \begin{radio}	    \item $(val14[1])	    \item $(val14[2])	    \item $(val14[3])	    \item $(val14[4])	    \end{radio}
val17=$val17 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val16;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val10	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val14[$(val15[1])]) </td><td>$(val14[$(val15[2])]) </td><td>$(val14[$(val15[3])]) </td><td>$(val14[$(val15[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val13!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val13	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,13,14,15,17
embedcnt=1
