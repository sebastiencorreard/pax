!set title=Question 110 NS Ordre de grandeur 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,skill_calculate
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique3.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,3,4

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 1,2,3,4,5

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
val10=$[rint(-$val9+10^$val8)]
val11=$[rint($val9+10^$val8)]
!readproc slib/numeration/ecriturenombre $val10,tex 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/numeration/ecriturenombre $val11,tex 
tmp0=$slib_out
val11=$(tmp0)
val12=$[rint(10^($val8))]
val13=Un ordre de grandeur de \($val10 \times $val11\) est &nbsp;&#58;
val14=$[rint(2*$val8)]
val15=\(10^{$val14}\)
val16=$[rint($val14-1)]
val17=$[rint($val14+1)]
val18=$[rint($val9^2)]
val16=\(10^{$val16}\)
val17=\(10^{$val17}\)
val18=\($val9\times 10^{$val8}\)
val19=$val16,$val17,$val18
val20=La bonne réponse est $val15. <br>En effet&#44; \($val10 \times $val11=($val12-$val9)($val12+$val9)=$val12^2-$val9^2\) dont un ordre de grandeur est $val15. 
val21=$val15,$val19
tmp0=!shuffle 4

val22=$(tmp0)
tmp0=!positionof item 1 in $val22

val23=$[rint($(tmp0))]
val24=\latexversion	    \item	    $val13	    \begin{radio}	    \item $(val21[1])	    \item $(val21[2])	    \item $(val21[3])	    \item $(val21[4])	    \end{radio}
val24=$val24 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val23;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val13	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val21[$(val22[1])]) </td><td>$(val21[$(val22[2])]) </td><td>$(val21[$(val22[3])]) </td><td>$(val21[$(val22[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val24 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val20	  </div>
$()</div>
!endif

!exit

:test

!exit

