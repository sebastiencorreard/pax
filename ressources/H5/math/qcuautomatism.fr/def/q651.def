val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 0.1,-0.1

tmp0=!randitem $tmp
val8=$[$(tmp0)]
val9=!rawmath $val8*(x+3)*(x-3)*(x-5)
tmp0=!randint 35, 40

val10=$[-0.1*$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
tmp0=!randint 15, 20

val12=$[-0.1*$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
val13=$[$(tmp0)]
tmp0=!randint 5, 20

val14=$[0.1*$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val15=$[$(tmp0)]
tmp0=!randint 35, 45

val16=$[0.1*$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst x=($val16) in $evaltmp
tmp0=($evaltmp)
val17=$[$(tmp0)]
val18=-6
val19=6
val20=-10
val21=10
val22=$[0.7]
val23=$[1]
val24=$[$val10-$val22]
val25=$[$val11+$val23]
val26=$[$val12-$val22]
val27=$[$val13+$val23]
val28=$[$val14+$val22]
val29=$[$val15+$val23]
val30=$[$val16+$val22]

!ifval $val8<0
val31=$[$val17+1.4*$val23]
!else
val31=$[$val17-0.2*$val23]
!endif
val32=$[rint(8)]
val33=fcircle $val10,$val11,$val32,black	 text black,$val24,$val25,big,A	 fcircle $val12,$val13,$val32,black	 text black,$val26,$val27,big,B	 fcircle $val14,$val15,$val32,black	 text black,$val28,$val29,big,R	  fcircle $val16,$val17,$val32,black	 text black,$val30,$val31,big,S 
val34=text black,-0.4,-0.2,big,O	  
val35=linewidth 2	  trange $val18,$val19	  plot red,$val9	  
val36=range $val18,$val19,$val20,$val21	linewidth 1	segment $val18,0,$val19,0,10,black	segment 0,$val20,0,$val21,10,black	$val34	
!readproc oef/draw.phtml 200,200 \
$val36	$val35	$val33	 
tmp0=$ins_url
val37=$(tmp0)
val38=<img src="$val37" alt="représentation graphique">
tmp=!nonempty items >,<

tmp0=!randitem $tmp
val39=$(tmp0)

!ifval $val39 issametext >
val40=&gt; 
!else
val40=&lt;
!endif
val41=On a représenté ci-dessous la courbe \(\mathcal{C}\) d’une fonction <span class="nowrap">\(f\).</span>	<br>Les points \(A\)&#44; \(B\)&#44; \(R\) et \(S\) appartiennent à la courbe <span class="nowrap">\(\mathcal{C}\).</span>	<br>Leurs abscisses sont notées respectivement \(x_A\)&#44; \(x_B\)&#44; \(x_R\) et <span class="nowrap">\(x_S\).</span>	<div class="wimscenter">$val38</div>	L’inéquation \(x \times f(x) $val40 0\) est vérifiée par&nbsp;&#58; 
val42=\(x_A\) et \(x_R\),\(x_A\) et \(x_B\),\(x_A\) et \(x_S),\(x_A\)&#44; \(x_B\) et \(x_R\),\(x_B\) et \(x_S\) 
!if $val8<0 
!if $val39 issametext > 
val43=$(val42[5])
tmp0=!shuffle 1,2,3,4

val44=$(tmp0)
val45=$(val42[$(val44[1])])
val46=$(val42[$(val44[2])])
val47=$(val42[$(val44[3])])
!else
val43=$(val42[1])
tmp0=!shuffle 5,2,3,4

val44=$(tmp0)
val45=$(val42[$(val44[1])])
val46=$(val42[$(val44[2])])
val47=$(val42[$(val44[3])])
!endif
!endif
!if $val8>0 
!if $val39 issametext > 
val43=$(val42[1])
tmp0=!shuffle 5,2,3,4

val44=$(tmp0)
val45=$(val42[$(val44[1])])
val46=$(val42[$(val44[2])])
val47=$(val42[$(val44[3])])
!else
val43=$(val42[5])
tmp0=!shuffle 1,2,3,4

val44=$(tmp0)
val45=$(val42[$(val44[1])])
val46=$(val42[$(val44[2])])
val47=$(val42[$(val44[3])])
!endif
!endif
val48=$val45,$val46,$val47

!ifval $val11<0
val49=négatif
!else
val49=positif
!endif

!ifval $val13<0
val50=négatif
!else
val50=positif
!endif

!ifval $val10*$val11>0
val51=positif
!else
val51=négatif
!endif

!ifval $val12*$val13>0
val52=positif
!else
val52=négatif
!endif

!ifval (($val39 issametext >) and ($val51 issametext positif)) or (($val39 issametext <) and ($val51 issametext négatif))
val53=vérifie l'inéquation
!else
val53=ne vérifie pas l'inéquation
!endif

!ifval (($val39 issametext >) and ($val52 issametext positif)) or (($val39 issametext <) and ($val52 issametext négatif))
val54=vérifie l'inéquation
!else
val54=ne vérifie pas l'inéquation
!endif
tmp=!nonempty items <ul><li>\(x_A) est négatif (abscisse de \(A\))</li><li> \(f(x_A)) est $val49 (ordonnée de \(A\))</li></ul>Le produit \(x_A \times f(x_A)\) est donc $val51&#44; \(x_A) $val53.,<ul><li>\(x_B) est négatif (abscisse de \(B\))</li><li> \(f(x_B)) est $val50 (ordonnée de \(B\))</li></ul>Le produit \(x_B \times f(x_B)\) est donc $val52&#44; \(x_B) $val54.

tmp0=!randitem $tmp
val55=$(tmp0)
val56=La bonne réponse est $val43.	<br>En observant la position des points par rapport aux axes&#44; on peut lire les signes des nombres \(x_A\)&#44; \(x_B\)&#44; \(x_R\) et \(x_S\) ainsi que les signes de leurs images.<br>	<br>Avec ces informations&#44; on peut tester chaque solution. Par exemple&nbsp;&#58;$val55
val57=$val43,$val48
tmp0=!shuffle 4

val58=$(tmp0)
tmp0=!positionof item 1 in $val58

val59=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val59;Réponse A,Réponse B,Réponse C,Réponse D
