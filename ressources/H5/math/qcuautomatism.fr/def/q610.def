!set title=Question 610 NS rôle du coefficient directeur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,direction,line
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 1, 7

tmp=!nonempty items 1,1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp=!nonempty items -$val8/abs($val8),-$val8/abs($val8),$val8/abs($val8)

tmp1=!randitem $tmp
val9=$[$(tmp0)/10*$(tmp1)]
val10=Dans un repère du plan&#44; on considère la droite \(d\) de coefficient directeur \($val9\) et	passant par le point \(A(0 ; $val8)\).<br>	On note \(B\) le point de la droite \(d\) dont l’abscisse est égale à \(1\).<br>	L’ordonnée du point \(B\) est égale à &nbsp;&#58;
val11=$[$val8+$val9]
val12=$[$val8-$val9]
val13=$[$val8+1]
val14=$[($val8+$val9)/2]
val15=$val11
val16=$val12,$val13,$val14
val17=La bonne réponse était $val11.<br> En effet&#44; par propriété du coefficient directeur&#44; comme l'abscisse augmente de 1 entre celle de \(A\) et celle de \(B\) alors 	l'ordonnée évolue de \($val9\) entre celle de \(A\) et celle de \(B\).
val18=$val15,$val16
tmp0=!shuffle 4

val19=$(tmp0)
tmp0=!positionof item 1 in $val19

val20=$[rint($(tmp0))]
val21=\latexversion	    \item	    $val10	    \begin{radio}	    \item $(val18[1])	    \item $(val18[2])	    \item $(val18[3])	    \item $(val18[4])	    \end{radio}
val21=$val21 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val20;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val10	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val18[$(val19[1])]) </td><td>$(val18[$(val19[2])]) </td><td>$(val18[$(val19[3])]) </td><td>$(val18[$(val19[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val17	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,17,18,19,21
embedcnt=1
