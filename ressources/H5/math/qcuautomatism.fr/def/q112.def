!set title=Question 112 S Quotient de puissances
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,power,calculation,division
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 7,8,9

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 2,3

tmp0=!randitem $tmp
val9=$[rint($val8-$(tmp0))]
tmp=!nonempty items 2,5,5

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
val11=On considère le nombre <span class="nowrap">\(N=\frac{10^$val8}{$val10^$val9}\).</span> On a&nbsp;&#58;

!ifval $val10=2
val12=$[rint(5)]
!else
val12=$[rint(2)]
!endif
val13=$[rint($val8-$val9)]
val14=$[rint(10^$val8/($val10^$val9))]
!readproc slib/numeration/ecriturenombre $val14,tex 
tmp0=$slib_out
val14=$(tmp0)
val15=$[rint(10^$val13)]
tmp0=!randint 1, 3

val16=$[rint($(tmp0))]
tmp0=!item $val16 of \(N= $val12^$val8 \times $val10^$val13\),\(N=$val12^$val9 \times 10^$val13\),\(N=$val14\)

val17=$(tmp0)
val18=\(\frac{10^$val8}{$val10^$val9}\)<br>\({}=\frac{($val10 \times $val12)^$val8}{$val10^$val9}\)<br>\({}=\frac{$val10^$val8 \times $val12^$val8}{$val10^$val9}\)<br>\({}=$val10^{$val8-$val9} \times $val12^$val8\)<br>\({}=$val10^{$val13} \times $val12^$val8\)
val19=\(\frac{10^$val8}{$val10^$val9}=\frac{10^$val9 \times 10^$val13}{$val10^$val9}\)<br>\({}=\left(\frac{10}{$val10}\right)^$val9 \times 10^$val13\)<br>\({}=$val12^$val9 \times 10^$val13\)
val20=$[rint(($val12)^$val9)]
val21=$val19 <br>\({}=$val20 \times $val15\)<br>\({}=$val14\)
tmp0=!item $val16 of $val18,$val19,$val21

val22=$(tmp0)
val23=\(N=$val12^{$val13}\)
val20=$[rint($val12*10^$val13)]
!readproc slib/numeration/ecriturenombre $val20,tex 
tmp0=$slib_out
val20=$(tmp0)
val24=\(N=$val20\)
val25=\(N=\frac{1}{10^$val13}\)
val26=$val23,$val24,$val25
val27=La bonne réponse est $val17.<br>En effet&nbsp;&#44; $val22
val28=$val17,$val26
tmp0=!shuffle 4

val29=$(tmp0)
tmp0=!positionof item 1 in $val29

val30=$[rint($(tmp0))]
val31=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val28[1])	    \item $(val28[2])	    \item $(val28[3])	    \item $(val28[4])	    \end{radio}
val31=$val31 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val30;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val31 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val28[$(val29[1])]) </td><td>$(val28[$(val29[2])]) </td><td>$(val28[$(val29[3])]) </td><td>$(val28[$(val29[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

