!set title=Question 109 S Calculs avec les fractions bis 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,skill_calculate,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items F,G,T,P

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!shuffle 2,3,4

val9=$(tmp0)
val10=$[rint($(val9[1]))]
tmp=!nonempty items 2,3

tmp0=!randitem $tmp
val11=$[rint($val10*$(tmp0))]
val12=$[rint($(val9[2]))]
tmp=!nonempty items 1,-1,-1

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
val14=On considère <span class="nowrap">\($val8=a+\frac{b}{c d}\).</span> <br>Lorsque \(a=\frac{1}{$val10}\)&#44; \(b=$val12\)&#44; \(c=$val11\)&#44; \(d=\frac{$val13}{$val11}\)&#44; la valeur de \($val8\) est égale à&nbsp;&#58; 
t_=!rawmath 1/$val10+$val12/($val11*($val13/$val11))
val15=!exec pari print($t_)
val16=\($val15\)
t_=!rawmath -$val15
val17=!exec pari print($t_)
val18=\($val17\)
t_=!rawmath 1/$val10*$val12/($val11*($val13/$val11))
val19=!exec pari print($t_)
val20=\($val19\)
val21=\(-$val19\)
val22=$val18,$val20,$val21

!ifval $val13=-1
val23=$[rint(1-$val10*$val12)]
!else
val23=$[rint(1+$val10*$val12)]
!endif

!ifval $val13=-1
val24=-
!else
val24=+
!endif
val25=$[rint($val12/$val13)]

!ifval $val25<0
val26=$val25
!else
val26=+$val25
!endif
val27=$[rint($val10*$val12)]
val28=On a <span class="nowrap">\(cd=$val11\times\frac{$val13}{$val11}=$val13\).</span><br>\(\frac{b}{c d}=\frac{$val12}{$val13}=$val25\) <br>Ainsi il faut calculer <span class="nowrap">\(\frac{1}{$val10}$val26=\frac{1}{$val10}$val24\frac{$val27}{$val10}=\frac{$val23}{$val10}\).</span> 
val29=La bonne réponse est $val16. <br>$val28 
val30=$val16,$val22
tmp0=!shuffle 4

val31=$(tmp0)
tmp0=!positionof item 1 in $val31

val32=$[rint($(tmp0))]
val33=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val30[1])	    \item $(val30[2])	    \item $(val30[3])	    \item $(val30[4])	    \end{radio}
val33=$val33 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val32;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val33 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val30[$(val31[1])]) </td><td>$(val30[$(val31[2])]) </td><td>$(val30[$(val31[3])]) </td><td>$(val30[$(val31[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val33 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val29!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val29	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,29,30,31,33
embedcnt=1
