val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val8=$(tmp0)
val9=$[rint($val8*10)]
val10=10,100,1000
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
!if $val11=1 
val12=$[rint(10)]
val13=$[rint(1000)]
val14=$[rint(100)]
!endif
!if $val11=2 
val12=$[rint(100)]
val13=$[rint(1000)]
val14=$[rint(10)]
!endif
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
val16=$[$val8/$val12]
val17=$[$val8/$val13]
tmp0=!item $val15 of $val16,\frac{$val8}{$val12}

val18=$(tmp0)
tmp0=!item $val15 of \frac{$val8}{$val13},$val17

val19=$(tmp0)
tmp=!nonempty items T,P,E

tmp0=!randitem $tmp
val20=$(tmp0)
val21=On considère <span class="nowrap">\($val20=$val9+$val18+$val19\).</span> On a&nbsp;&#58; 
val22=$[$val9+$val16+$val17]
val23=\($val20=$val22\)
tmp0=!item $val15 of \frac{$val8}{$val13},\frac{$val8}{$val12}

val24=$(tmp0)
val25=\($val20=$val24\)
val26=$[rint(2*$val9)]
val27=$[rint(max($val12,$val13))]
val26=\frac{$val26^{-1}}{$val27}
val28=\($val20=$val26\)
val29=$[$val8/$val27]
val30=$[$val9+$val8/$val14+$val29]
val31=\($val20=$val30\)
val32=$val25,$val28,$val31
tmp0=!item $val11 of \frac{$val8}{$val12}=$val16,\frac{$val8}{$val13}=$val17

val33=$(tmp0)
tmp0=!item $val11 of $val20=$val9+$val16+$val19,$val20=$val9+$val18+$val17

val34=$(tmp0)
val35=En effet&nbsp;&#58; \($val33\) <br>Donc <span class="nowrap">\($val34\).</span>
val36=La bonne réponse est $val23. <br>$val35 
val37=$val23,$val32
tmp0=!shuffle 4

val38=$(tmp0)
tmp0=!positionof item 1 in $val38

val39=$[rint($(tmp0))]
val40=\latexversion	    \item	    $val21	    \begin{radio}	    \item $(val37[1])	    \item $(val37[2])	    \item $(val37[3])	    \item $(val37[4])	    \end{radio}
val40=$val40 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val39;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val40 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

