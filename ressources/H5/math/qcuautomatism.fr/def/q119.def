$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val21	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val37[$(val38[1])]) </td><td>$(val37[$(val38[2])]) </td><td>$(val37[$(val38[3])]) </td><td>$(val37[$(val38[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
