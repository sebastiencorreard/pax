ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 2,3,4,5,10

tmp0=!randitem $tmp
val8=$[rint(12*$(tmp0))]
val9=$[rint($val8/2)]
val10=$[rint($val8/3)]
val11=$[rint($val8/4)]
val12=$[rint($val8/6)]
tmp=!trim 1,$val9 personnes dans le groupe 1, $val11 personnes dans le groupe 2 et les autres dans le groupe 3,la moitié dans le groupe 1 et le quart dans le groupe 2 donc le quart dans le groupe 3.	1,$val11 personnes dans le groupe 1, $val9 personnes dans le groupe 2 et les autres dans le groupe 3,le quart dans le groupe 1 et la moitié dans le groupe 2 donc le quart dans le groupe 3.	2,$val9 personnes dans le groupe 1, $val10 personnes dans le groupe 2 et les autres dans le groupe 3,la moitié dans le groupe 1 et le tiers dans le groupe 2 donc un sixième dans le groupe 3.	2,$val9 personnes dans le groupe 1, $val12 personnes dans le groupe 2 et les autres dans le groupe 3,la moitié dans le groupe 1 et le sixième dans le groupe 2 donc deux tiers dans le groupe 3.	3,$val10 personnes dans le groupe 1, $val12 personnes dans le groupe 2 et les autres dans le groupe 1,le tiers dans le groupe 1 et un sixième dans le groupe 2 donc la moitié dans le groupe 3.	3,$val11 personnes dans le groupe 1, les groupes 2 et 3 avec le même nombre de personnes,le quart dans le groupe 1 et la moitié de trois quart \(\frac{3}{8}\) dans les autres groupes.	3,$val11 personnes dans le groupe 2, les groupes 1 et 3 avec le même nombre de personnes,le quart dans le groupe 2 et la moitié de trois quart \(\frac{3}{8}\) dans les autres groupes.	4,plus de la moitié des personnes dans le groupe 1, les autres réparties équitablement dans les groupes 2 et 3,plus de la moitié dans le groupe 1 donc moins d'un quart pour les deux autres groupes avec les même effectifs.
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=imgq703a.png,imgq703b.png,imgq703c.png,imgq703d.png
val16=Les $val8 personnes présentes à une exposition sont réparties dans des groupes&nbsp;&#58; $(val14[2])&#44; $(val14[3]). <br>Quelle représentation décrit la situation&nbsp;&#58; 
val17=<img src="$val1/$(val15[$(val14[1])])" alt="" >

!ifval $(val14[1])=1
val18=2,3,4
!endif

!ifval $(val14[1])=2
val18=1,3,4
!endif

!ifval $(val14[1])=3
val18=2,1,4
!endif

!ifval $(val14[1])=4
val18=2,3,1
!endif
val19=<img src="$val1/$(val15[$(val18[1])])" alt="" >
val20=<img src="$val1/$(val15[$(val18[2])])" alt="" >
val21=<img src="$val1/$(val15[$(val18[3])])" alt="" >
val22=$val19,$val20,$val21
val23=La bonne réponse est&nbsp;&#58;<div class="wimscenter"><img src="$val1/$(val15[$(val14[1])])" width="15%" alt="" ></div> En effet on peut interpréter l'énoncé comme suit&nbsp;&#58; $(val14[4])
val24=$val17,$val22
tmp0=!shuffle 4

val25=$(tmp0)
tmp0=!positionof item 1 in $val25

val26=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val26;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

