!set title=Question 555 S Comparer les prix après évolutions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,decimals
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 10,20,30,40

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp0=!shuffle augmente,baisse

val9=$(tmp0)
val10=$[$val8/100]
val11=Le prix d’un article est noté <span class="nowrap">\(P\).</span> Ce prix $(val9[1]) de \($val8\%\) puis $(val9[2]) de <span class="nowrap">\($val8\%\).</span><br>A l’issue de ces deux variations&#44; le nouveau prix est noté <span class="nowrap">\(P_1\).</span> On peut affirmer que &nbsp;&#58;
val12=\(P_1 &lt;P\)
val13=$[10*\evolabs]
val14=ça dépend de \(P\)
val15=\(P_1=P\)
val16=\(P_1 &gt;P\)
val17=$val14,$val15,$val16 
val18=<br>\(P_1\) se calcule ainsi \(P_1=P\times (1-$val10)(1+$val10)\)<br>On reconnait \((1-$val10)(1+$val10)=1-$val10^2\) qui est plus petit que \(1)
val19=La bonne réponse est $val12. $val18 
val20=$val12,$val17
tmp0=!shuffle 4

val21=$(tmp0)
tmp0=!positionof item 1 in $val21

val22=$[rint($(tmp0))]
val23=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val20[1])	    \item $(val20[2])	    \item $(val20[3])	    \item $(val20[4])	    \end{radio}
val23=$val23 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val22;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val20[$(val21[1])]) </td><td>$(val20[$(val21[2])]) </td><td>$(val20[$(val21[3])]) </td><td>$(val20[$(val21[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val23 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val19	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,11,19,20,21,23
embedcnt=1
