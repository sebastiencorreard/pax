!set title=Question 404 NS Calcul de proportion
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
val8=20,25,75,50,10
val9=\frac{1}{5},\frac{1}{4},\frac{3}{4},\frac{1}{2},\frac{1}{10}
tmp=!nonempty items 1,2,3,4,5

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
val11=$(val8[$val10])
tmp0=!randint 21, 49

val12=$[rint($(tmp0)*10)]
val13=L’opération qui permet de calculer \($val11 \%\) de \($val12\) est&nbsp;&#58;
tmp=!nonempty items 1,2,3,3

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
val15=\frac{$val12 \times $val11}{100},$val11 \times $val12 \times 0.01,$(val9[$val10]) \times $val12
val16=\frac{$val12 }{$val11 \times 100}
val17=$val11 \times $val12 \times 0.1
val18=\frac{$val12 \times 100}{$val11}
val19=$(val15[$val14])
val19=\($val19\) 
val20=\($val16 \),\($val17 \),\( $val18 \)
val21=\({}=\frac{$val11}{100} \times $val12\)<br>\({}=\frac{$val12 \times $val11}{100}\),\({}=\frac{$val11}{100} \times $val12\)<br>\({}=\frac{$val12 \times $val11}{100}\)<br>\({}=$val12 \times $val11 \times \frac{1}{100}\),\({}=\frac{$val11}{100} \times $val12\)<br>\({}=$(val9[$val10]) \times $val12\)
val22=$(val21[$val14])
val23=La bonne réponse est <span class="nowrap">$val19.</span><br> En effet il faut faire le calcul suivant \(0.$val11 \times $val12\) $val22
val24=$val19,$val20
tmp0=!shuffle 4

val25=$(tmp0)
tmp0=!positionof item 1 in $val25

val26=$[rint($(tmp0))]
val27=\latexversion	    \item	    $val13	    \begin{radio}	    \item $(val24[1])	    \item $(val24[2])	    \item $(val24[3])	    \item $(val24[4])	    \end{radio}
val27=$val27 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val26;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val27 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val13	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val24[$(val25[1])]) </td><td>$(val24[$(val25[2])]) </td><td>$(val24[$(val25[3])]) </td><td>$(val24[$(val25[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val27 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val23!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val23	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
