$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val21	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val23[$(val24[1])]) </td><td>$(val23[$(val24[2])]) </td><td>$(val23[$(val24[3])]) </td><td>$(val23[$(val24[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

