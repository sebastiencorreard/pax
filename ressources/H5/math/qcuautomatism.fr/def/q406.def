!set title=Question 406 NS prix initial
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,1,1,-1

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]

!ifval ($val8==1)
tmp=!nonempty items 110,120,130,140,160

tmp0=!randitem $tmp
val9=$[rint( $(tmp0))]
!else
tmp=!nonempty items 90,80,70,60

tmp1=!randitem $tmp
val9=$[rint($(tmp1))]
!endif
val10=$[rint(abs($val9-100))]

!ifval ($val8==1)
val11= augmentation
!else
val11=réduction
!endif

!ifval ($val8==1)
val12= l'augmentation
!else
val12=la réduction
!endif

!ifval ($val8==1)
val13= augmenté
!else
val13=diminué
!endif
val14=$[rint($val9*$val10/100)]
val15=$[$val9*(1-$val10/100)]
val16=$[$val9*(1+$val10/100)]

!ifval ($val8==1)
val17= diminué
!else
val17=augmenté
!endif

!ifval ($val8==1)
val18=$[ 1+$val10/100]
!else
val18=$[1-$val10/100]
!endif
tmp=!trim le prix de l’article avant $val12 était égal à 100 euros,le prix de l’article avant $val12 était égal à $val15 euros,le prix a $val13 de $val14 euros,le prix a $val17 de $val14 euros	le prix a $val13 de $val10 euros,le prix a $val13 de $val14 euros,le prix de l’article avant $val12 était égal à $val15 euros,le prix de l’article avant $val12 était égal à $val16 euros
val19=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val19

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
val21=A l’issue d’une $val11 de $val10 %&#44; un article coûte $val9 euros.<br>	Laquelle des quatre propositions suivantes est vraie &nbsp;&#63;
val22=$(val20[1])
val23=$(val20[2]),$(val20[3]),$(val20[4])
val24=La bonne réponse est&nbsp;&#58; $val22. En effet&#44; le prix initial de l'article est \(\frac{$val9}{$val18}=100\). 
val25=$val22,$val23
tmp0=!shuffle 4

val26=$(tmp0)
tmp0=!positionof item 1 in $val26

val27=$[rint($(tmp0))]
val28=\latexversion	    \item	    $val21	    \begin{radio}	    \item $(val25[1])	    \item $(val25[2])	    \item $(val25[3])	    \item $(val25[4])	    \end{radio}
val28=$val28 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val27;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val28 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val21	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val25[$(val26[1])]) </td><td>$(val25[$(val26[2])]) </td><td>$(val25[$(val26[3])]) </td><td>$(val25[$(val26[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val28 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val24!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val24	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,21,24,25,26,28
embedcnt=1
