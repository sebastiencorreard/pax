!set title=Question 552 T Coeff. mult. après évolution
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 20,30,10

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val9=$[$val8/100]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val10=$(tmp0)
val11=$[1 $val10 $val9]

!ifval $val10 issametext +
val12=augmentations
!else
val12=baisses
!endif
val13=$[$val11*$val11]
val14=Le prix d’un article est noté <span class="nowrap">\(P\).</span><br> Il connait deux $val12 de <span class="nowrap">\($val8\%\).</span><br> Le prix après ces $val12 est&nbsp;&#58;
tmp=!nonempty items form,dev

tmp0=!randitem $tmp
val15=$(tmp0)

!ifval $val15 issametext form
val16=\(P \times $val11^2\)
!else
val16=\(P \times $val13\)
!endif

!ifval $val10 issametext +
val17=-
!else
val17=+
!endif
val18=\(P \times \left(1$val17\left(\frac{$val8}{100}\right)^2\right)\)
val19=$[1 $val10 2*$val8/100]
val20=\(P \times $val19\)
val21=\(\frac{P}{$val13}\)
val22=$val18, $val20,$val21

!ifval $val15 issametext \dev
val23==$val13
!else
val23=
!endif

!ifval $val10 issametext +
val24=l'augmente
!else
val24=le baisse
!endif

!ifval $val10 issametext +
val25=augmenter
!else
val25=baisser
!endif
val26=<br>Pour $val25 le prix \(P\) de \($val8\%\) on le multiplie par <span class="nowrap">\(1 $val10 \frac{$val8}{100}=$val11\).</span><br>Si on $val24 deux fois de \($val8\%\) il faut donc le multiplier par <span class="nowrap">\($val11 \times $val11 =$val11^2 $val23\).</span>
val27=La bonne réponse est $val16.<br> $val26 
val28=$val16,$val22
tmp0=!shuffle 4

val29=$(tmp0)
tmp0=!positionof item 1 in $val29

val30=$[rint($(tmp0))]
val31=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val28[1])	    \item $(val28[2])	    \item $(val28[3])	    \item $(val28[4])	    \end{radio}
val31=$val31 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val30;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val31 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val28[$(val29[1])]) </td><td>$(val28[$(val29[2])]) </td><td>$(val28[$(val29[3])]) </td><td>$(val28[$(val29[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val31 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val27!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val27	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,27,28,29,31
embedcnt=1
