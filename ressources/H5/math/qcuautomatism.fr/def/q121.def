val7=Félicitations toutes les réponses sont justes !
tmp=!trim (1/5)^2,(1/2)^5,0.05,(1/3)^3,3,2,1,4,1/25,1/32,1/20,1/27	(1/5)^2,(1/2)^5,1/15,(1/3)^3,3,2,1,4,1/25,1/32,1/15,1/27	(1/6)^2,(1/2)^6,1/16,(1/3)^3,3,2,1,4,1/36,1/64,1/16,1/27	(1/6)^2,(1/2)^6,1/60,(1/3)^3,4,2,1,3,1/36,1/64,1/60,1/27	(1/3)^2,(1/2)^3,0.04,(1/4)^4,2,4,1,3,1/9,1/8,1/25,1/256	(1/3)^2,(1/2)^3,0.01,(1/4)^4,2,4,1,3,1/9,1/8,1/100,1/256	(1/5)^2,(1/2)^5,1/5,(1/4)^4,3,4,1,2,1/25,1/32,1/5,1/256	(1/5)^2,(1/2)^5,0.02,(1/4)^4,1,4,2,3,1/25,1/32,1/50,1/256	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val9=$[rint($(tmp1))]
val10=$(val8[$val9;])
tmp=!nonempty items grand,petit

tmp0=!randitem $tmp
val11=$(tmp0)

!ifval $val11 issametext grand
val12=$[rint(5)]
!else
val12=$[rint(6)]
!endif
val13=E,F,G,H
val14=Voici quatre nombres&nbsp;&#58;<div class="wimscenter">\(E=$(val10[1])\)\(\;\)\(F=$(val10[2])\)\(\;\)\(G=$(val10[3]))\(\;\)\(H=$(val10[4])\)</div>Le plus $val11 de ces quatre nombres est&nbsp;&#58; 
val15=$(val10[$val12])
val16=$(val10[11-$val12])
val17=$(val10[4+7])
val18=$(val10[4+8])
val19=$val16,$val17,$val18
val20=En effet en utilisant l'écriture fractionnaire de chaque nombre on obtient&nbsp;&#58; <ul class="wims_nopuce"><li>\(E=$(val10[9])\)</li><li>\(F=$(val10[10])\)</li><li>\(G=$(val10[11])\)</li>	<li>\(H=$(val10[12])\)</li></ul>
val21=La bonne réponse est \($(val13[$(val10[$val12])])\). <br>$val20 <br> On utilise ensuite le fait que si \(0<a<b\) alors \(\frac{1}{b}<\frac{1}{a}\).
val22=\(E\),\(F\),\(G\),\(H\)
val23=$[rint($val15)]
val24=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val22[1])	    \item $(val22[2])	    \item $(val22[3])	    \item $(val22[4])	    \end{radio}
val24=$val24 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val15;\(E\),\(F\),\(G\),\(H\)
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

