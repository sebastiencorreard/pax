!set title=Question 304 S Reconnaitre l'équation d'une parabole
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,equations,graphing
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 10,20,30

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val9=x^2-$val8,-x^2-$val8,-x^2+$val8,-x^2+$val8 x
tmp0=!shuffle 4

val10=$(tmp0)
val11=x^2-4,-x^2-4,-x^2+4,-x^2+4*x
val12=!rawmath $(val11[$(val10[1])])
val13=-5
val14=5
val15=-10
val16=10

!ifval $(val10[1])=2
val17=$[2]
!else
val17=$[3]
!endif
evaltmp=$val12

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
val18=$[$val18+0.5]
val17=$[$val17+0.5]
val19=text black,3.5,-0.5,big,x	  segment -0.1,10,0.1,10,black	  text black,0.4,-0.4,big,0	  text black,-0.5,9,big,y	  
val20=linewidth 2	  trange $val13,$val14	  plot red,$val12	  text black,$val17,$val18,big,(P)
val21=range $val13,$val14,$val15,$val16	linewidth 1	arrow $val13,0,$val14,0,10,black	arrow 0,$val15,0,$val16,10,black	$val19	
!readproc oef/draw.phtml 200,200 \
$val21	$val20	 
tmp0=$ins_url
val22=$(tmp0)
val23=<img src="$val22" alt="représentation graphique">
val24=On a représenté ci-dessous une parabole <b>(P)</b>.<div class="wimscenter">$val23</div> Une seule des quatre fonctions ci-dessous est susceptible d’être représentée par la parabole (P).<br>Laquelle&nbsp;&#63; 
val25=\(x \mapsto $(val9[$(val10[1])])\)
val26=\(x \mapsto $(val9[$(val10[2])])\)
val27=\(x \mapsto $(val9[$(val10[3])])\)
val28=\(x \mapsto $(val9[$(val10[4])])\)
val29=$val26,$val27,$val28

!ifval $(val10[1])>1
val30=croissante puis décroissante
!else
val30=décroissante puis croissante
!endif

!ifval $(val10[1])>1
val31=négatif
!else
val31=positif
!endif
val32=négative,négative,positive,nulle
val32=$(val32[$(val10[1])])
val33=La bonne réponse est $val25.<br> En observant la courbe on sait que <ul><li>La fonction est $val30</li><li>L'image de zéro est $val32 </li></ul><u>Rappel&nbsp;&#58;</u> pour les polynômes du second degré&#44; lorsque le coefficient de \(x^2\) est $val31&#44; la fonction est $val30.
val34=$val25,$val29
tmp0=!shuffle 4

val35=$(tmp0)
tmp0=!positionof item 1 in $val35

val36=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val36;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val24	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val34[$(val35[1])]) </td><td>$(val34[$(val35[2])]) </td><td>$(val34[$(val35[3])]) </td><td>$(val34[$(val35[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val33!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val33	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,24,33,34,35
embedcnt=1
