!set title=Question 122 NS Un prix 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,skill_calculate
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 4,6,8,10

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items 1.15,1.2,1.25,1.3,1.4,1.5

tmp0=!randitem $tmp
val9=$[$val8*$(tmp0)]
tmp=!nonempty items 1.5,2.5

tmp0=!randitem $tmp
val10=$[$(tmp0)]
val11=$[rint($val8*$val10)]
val12=$val8 croissants coûtent $val9 euros. $val11 croissants coûtent&nbsp;&#58; 
val13=$[$val11*$val9/$val8]
val14=$val13 euros
val15=$[$val9*$val11]
val16=$[floor(100*$val9*$val9/$val8)/100]
val17=$[$val9+($val11-$val8)]
val18=$val15 euros,$val16 euros,$val17 euros
val19=La bonne réponse est $val14 car $val11 croissants coûtent \(\frac{$val9*$val11}{$val8}=$val13) euros. 
val20=$val14,$val18
tmp0=!shuffle 4

val21=$(tmp0)
tmp0=!positionof item 1 in $val21

val22=$[rint($(tmp0))]
val23=\latexversion	    \item	    $val12	    \begin{radio}	    \item $(val20[1])	    \item $(val20[2])	    \item $(val20[3])	    \item $(val20[4])	    \end{radio}
val23=$val23 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val22;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val23 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val12	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val20[$(val21[1])]) </td><td>$(val20[$(val21[2])]) </td><td>$(val20[$(val21[3])]) </td><td>$(val20[$(val21[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val23 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val19!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val19	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,19,20,21,23
embedcnt=1
