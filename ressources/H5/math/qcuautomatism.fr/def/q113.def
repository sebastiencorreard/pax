!set title=Question 113 S Conversion
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,power,calculation,conversion
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 4

tmp=!nonempty items 0.02,0.01,0.03

tmp1=!randitem $tmp
tmp=!nonempty items 1,-1

tmp2=!randitem $tmp
val8=$[$(tmp0)+$(tmp1)*$(tmp2)]
val9=$[rint(100/$val8)/100]
tmp0=!randint 15, 35

val10=$[$(tmp0)/10*$val8]
val10=$[rint($val10*100)/100]
tmp0=!randint 15, 35

val11=$[$(tmp0)*$val8]
val11=$[rint($val11*100)/100]
val12=$[3.6]
val13=$[rint($val12*$val8*10)]
val13=$[$val13/10]
val14=Un appareil a besoin d’une énergie de \($val13 \times 10^6\) Joules (J) pour se mettre en route.	<br>À combien de kiloWatts-heure (kWh) cela correspond-il&nbsp;&#63; <br><u><i>Données&nbsp;&#58;</i></u> \(1\) kWh \({}= $val12 \times 10^6 \) J
val15=\($val8 \thinspace kWh\)
val16=\($val9 \thinspace kWh\),\($val10 \thinspace kWh\),\($val11 \thinspace kWh\)
val17=$[rint($val8)]
val18=La bonne réponse est $val15.<br> On peut noter que \($val13 \times 10^6\) est environ égal à \($val17\) fois <span class="nowrap">\($val12 \times 10^6 \).</span><br> La réponse la plus proche est donc <span class="nowrap">$val15.</span>
val19=$val15,$val16
tmp0=!shuffle 4

val20=$(tmp0)
tmp0=!positionof item 1 in $val20

val21=$[rint($(tmp0))]
val22=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val19[1])	    \item $(val19[2])	    \item $(val19[3])	    \item $(val19[4])	    \end{radio}
val22=$val22 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val21;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val19[$(val20[1])]) </td><td>$(val19[$(val20[2])]) </td><td>$(val19[$(val20[3])]) </td><td>$(val19[$(val20[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

