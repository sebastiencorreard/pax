!set title=Question 550 T Evolution réciproque
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,-1,-1,-1

tmp0=!randitem $tmp
val8=$(tmp0)
!if $val8==-1 
val9=diminue,augmentation
tmp=!nonempty items 50,20,80

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
val11=$[rint(100*(100/(100-$val10)-1))]

!ifval $val10=50
val12=$[rint(150)]
!else
val12=$[rint(2*$val10)]
!endif

!ifval $val10=50
val13=$[rint(250)]
!else
val13=$[rint(3*$val10)]
!endif
val14=$[1-$val10/100]
val15=$[1/$val14]
val16=$[$val15-1]
val17=$[$val16*100]
val18=La bonne réponse est \( $val11 \% \) puisque&nbsp;&#58; <ul> <li>Réduire un nombre de \($val10 \% \)&#44; c'est le multiplier par \(1-0.$val10= $val14\)</li>  <li>Pour retrouver le prix initial il faut donc <b>diviser</b> par \($val14 \) ou <b>multiplier</b> par \(\frac{1}{$val14}=$val15\)</li><li>Puisque \($val15=1+$val16\)&#44; cela revient à faire une augmentation de \($val17 \%\)</li></ul>
!endif
!if $val8==1 
val9=augmente,baisse
tmp=!nonempty items 100,150

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]

!ifval $val10==100
val11=$[rint(50)]
!else
val11=$[rint(60)]
!endif
val12=$[rint(2*$val10)]
val13=$[rint(3*$val10)]
val14=$[1+$val10/100]
val19=$[$val10/100]
val15=$[1/$val14]
val16=$[1-$val15]
val17=$[$val16*100]
val18=La bonne réponse est \( $val11 \% \) puisque&nbsp;&#58; <ul> <li>Augmenter un nombre de \($val10 \% \)&#44; c'est le multiplier par \(1+$val19= $val14\)</li><li>Pour retrouver le prix initial il faut donc <b>diviser</b> par \($val14 \) ou <b>multiplier</b> par \(\frac{1}{$val14}=$val15\)</li><li>Puisque \($val15=1-$val16\)&#44; cela revient à faire une baisse de \($val17 \%\)</li></ul>
!endif
val20=Un prix $(val9[1]) de <span class="nowrap">\($val10 \% \).</span> Pour retrouver le prix initial&#44; il faut une $(val9[2]) de&nbsp;&#58;
val21=\( $val11 \% \)
val22=\($val10 \%\),\($val12 \%\),\($val13 \%\)
val23=$val21,$val22
tmp0=!shuffle 4

val24=$(tmp0)
tmp0=!positionof item 1 in $val24

val25=$[rint($(tmp0))]
val26=\latexversion	    \item	    $val20	    \begin{radio}	    \item $(val23[1])	    \item $(val23[2])	    \item $(val23[3])	    \item $(val23[4])	    \end{radio}
val26=$val26 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val25;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val26 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val20	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val23[$(val24[1])]) </td><td>$(val23[$(val24[2])]) </td><td>$(val23[$(val24[3])]) </td><td>$(val23[$(val24[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val26 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val18!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val18	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
