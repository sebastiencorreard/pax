!set title=Question 101 T Masse et forme d'écriture
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,scientific_notation
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=42
prevarcnt=41
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 20, 25

val8=$[rint($(tmp0))]
tmp0=!randint 2100, 8700

val9=$[$(tmp0)/1000]
val10=$[rint($val8+1)]
val11=$[rint($val10+1)]
val12=$[rint($val11+1)]
val13=$val8,$val10,$val11,$val12
tmp0=!randint 30, 100

val14=$[$val9-$(tmp0)/1000]
tmp0=!randint 50, 160

val15=$[$val9+$(tmp0)/1000]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
tmp0=!randint 500, 1200

val17=$[$val9+$val16*$(tmp0)/1000]
tmp0=!shuffle 1,2,3,4

val18=$(tmp0)
val19=$[10^$(val18[1])*$val9]
val20=$[rint($val8-$(val18[1]))]
val21=$val19 \times 10^{$val20}
val22=$[10^$(val18[2])*$val14]
val23=$[rint($val8-$(val18[2]))]
val24=$val22 \times 10^{$val23}
val25=$[10^$(val18[3])*$val15]
val26=$[rint($val8-$(val18[3])-1)]
val27=$val25 \times 10^{$val26}
val28=$[10^$(val18[4])*$val17]

!ifval ($val16>0)
val29=$[rint( $val8-$(val18[4])-1)]
!else
val29=$[rint($val8-$(val18[4]))]
!endif
val30=$val28 \times 10^{$val29}
tmp0=!shuffle $val21,$val24,$val27,$val30

val31=$(tmp0)
val32=Nur,Efros,Ramatis,Rill,Acamar,Aldea,Annaj,Bajor,Catulla,Lacerta,Acteon,Svoboda,Thalia,Lusus
val33=On donne la masse de 4 astres&nbsp;&#58;<ul><li> $(val32[1]) a une masse de \($(val31[1])\) kg </li><li> $(val32[2]) a une masse de \($(val31[2])\) kg </li><li>$(val32[3]) a une masse de \($(val31[3])\) kg </li><li> $(val32[4]) a une masse de \($(val31[4])\) kg. </li></ul>Lequel de ces astres a la plus grande masse&nbsp;&#63;
tmp0=!positionof item $val21 in $val31

val34=$[rint($(tmp0))]
val35=
!for val36 =1 to 4 
!if $val36==$val34 
!else
val35=$val35,$val36
!endif
!next
val35=$(val35[2..4])
val37=$(val32[$val34])
val38=$(val32[$(val35[1])]),$(val32[$(val35[2])]),$(val32[$(val35[3])])
val39=La bonne réponse est $(val32[$val34]).<br> Il suffit d'écrire les masses en écriture scientifique.
val40=$val37,$val38
tmp0=!shuffle 4

val17=$(tmp0)
tmp0=!positionof item 1 in $val17

val41=$[rint($(tmp0))]
val42=\latexversion	    \item	    $val33	    \begin{radio}	    \item $(val40[1])	    \item $(val40[2])	    \item $(val40[3])	    \item $(val40[4])	    \end{radio}
val42=$val42 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val41;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val42 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val33	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val40[$(val17[1])]) </td><td>$(val40[$(val17[2])]) </td><td>$(val40[$(val17[3])]) </td><td>$(val40[$(val17[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

