val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,4,5

val8=$(tmp0)
val9=$[rint($(val8[1]))]
val10=$[rint($(val8[2]))]
val11=$[rint($(val8[3]))]
val12=$[rint($(val8[4]))]
val13=$[$val12/10]
tmp0=!randint 591, 789

val14=$[rint($(tmp0))]
tmp=!nonempty items sqrt(2),sqrt(3),$val14,pi

tmp0=!randitem $tmp
val15=$(tmp0)
val16=$val9*x^2-($val10+$val9*x^2),$val9*x/$val10-($val11+1/$val15),($val9-$val11*x/ $val10)/$val13,$val9*x^2-($val10-$val11*x^2),($val9-$val11*x^2/ $val10)/$val12,$val9*x/$val10*($val11+x/$val15),$val9*x^2-($val10-$val9*x^2)
val17=$val9 x^2-\left($val10+$val9 x^2\right),\frac{$val9}{$val10}x-\left($val11+\frac{1}{$val15}\right),\frac{$val9-\frac{$val11}{$val10}x}{$val13},$val9 x^2-\left($val10-$val11 x^2\right),\frac{$val9-\frac{$val11}{ $val10}x^2 }{$val12},\frac{$val9}{$val10}x\left($val11+\frac{x}{$val15}\right),$val9 x^2-\left($val10-$val9 x^2\right)
tmp0=!replace internal sqrt(2) by \sqrt{2} in $val17

val17=$(tmp0)
tmp0=!replace internal sqrt(3) by \sqrt{3} in $val17

val17=$(tmp0)
tmp0=!replace internal pi by \pi in $val17

val17=$(tmp0)
tmp0=!shuffle 7

val18=$(tmp0)
val19=On considère trois fonctions définies sur \(\mathbb{R}\)&nbsp;&#58;<div class="wimscenter">	 \(f_1&nbsp;&#58;&nbsp;x \mapsto $(val17[$(val18[1])])\)&nbsp;&nbsp;&nbsp;&nbsp; \(f_2&nbsp;&#58;&nbsp;x \mapsto $(val17[$(val18[2])])\)&nbsp;&nbsp;&nbsp;&nbsp; \(f_3&nbsp;&#58;&nbsp;x \mapsto $(val17[$(val18[3])])\)	</div>Parmi ces trois fonctions&#44; celles qui sont des fonctions affines sont&nbsp;&#58; 
val20=

!ifval $(val18[1])<3.5
tmp0=!append item f_1 to $val20

val20=$(tmp0)
!else
val20=$val20
!endif

!ifval $(val18[2])<3.5
tmp0=!append item f_2 to $val20

val20=$(tmp0)
!else
val20=$val20
!endif

!ifval $(val18[3])<3.5
tmp0=!append item f_3 to $val20

val20=$(tmp0)
!else
val20=$val20
!endif
val21=

!ifval $(val18[1])>3.5
tmp0=!append item f_1 to $val21

val21=$(tmp0)
!else
val21=$val21
!endif

!ifval $(val18[2])>3.5
tmp0=!append item f_2 to $val21

val21=$(tmp0)
!else
val21=$val21
!endif

!ifval $(val18[3])>3.5
tmp0=!append item f_3 to $val21

val21=$(tmp0)
!else
val21=$val21
!endif
tmp0=!shuffle 3

val22=$(tmp0)
!if $val20 issametext  
val23=aucune
val24=toutes
val25=uniquement la fonction \(f_$(val22[1])\)
val26=uniquement les fonctions \(f_$(val22[2])\) et \(f_$(val22[3])\)
!endif
tmp0=!itemcnt $val20

!if $(tmp0)=1 
val23=uniquement la fonction \($val20\)
val24=toutes
val25=aucune
val26=uniquement les fonctions \($(val21[1])\) et \($(val21[2])\)
!endif
tmp0=!itemcnt $val20

!if $(tmp0)=2 
val23=uniquement les fonctions \($(val20[1])\) et \($(val20[2])\)
val24=toutes
val25=aucune
val26=uniquement la fonction \($val21\)
!endif
tmp0=!itemcnt $val20

!if $(tmp0)=3 
val23=toutes
val24=uniquement les fonctions \(f_$(val22[1])\) et \(f_$(val22[2])\)
val25=aucune
val26=uniquement la fonction \(f_$(val22[3])\)
!endif
val27=$val24,$val25,$val26
val28=La bonne réponse est <b>$val23</b>. <br>Pour s'en convaincre&#44; il faut essayer de réduire les expressions pour voir si on peut les écrire sous la forme \(m x+p\) caractéristique des fonction affines.<br> Si ce n'est pas le cas&#44; ce n'est pas une fonction affine.
val29=$val23,$val27
tmp0=!shuffle 4

val30=$(tmp0)
tmp0=!positionof item 1 in $val30

val31=$[rint($(tmp0))]
val32=\latexversion	    \item	    $val19	    \begin{radio}	    \item $(val29[1])	    \item $(val29[2])	    \item $(val29[3])	    \item $(val29[4])	    \end{radio}
val32=$val32 \end{enumerate}
replytype1=radio
