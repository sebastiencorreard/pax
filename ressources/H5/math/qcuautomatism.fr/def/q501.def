!set title=Question 501 S Interpréter un coeff. mult.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,decimals
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp=!nonempty items 2.5,3.5,1.5,4.5,0.2,0.3

tmp1=!randitem $tmp
val8=$[$(tmp0)*$(tmp1)]

!ifval $val8<0
val9=baisse
!else
val9=hausse
!endif

!ifval $val8>0
val10=baisse
!else
val10=hausse
!endif
tmp0=!randint 1, 9

val11=$[rint($(tmp0)*10)]
val12=$[$val11/100]
val13=$[1+$val8/100]
val14=$[abs($val8)]
val15=Le prix d’un article est multiplié par <span class="nowrap">\($val13\).</span><br>Cela signifie que le prix de cet article a connu&nbsp;&#58;
val16=une $val9 de \($val14\%\)
val17=$[10*$val14]
val18=une $val9 de \($val17\%\)
val19=une $val10 de \($val14\%\)
val20=une $val10 de \($val17\%\)
val21=$val18,$val19,$val20 

!ifval $val13<1
val22=&lt;
!else
val22=&gt;
!endif

!ifval $val13<1
val23=1-$val13
!else
val23=$val13-1
!endif

!ifval $val13<1
val24=$[1-$val13]
!else
val24=$[$val13-1]
!endif
val25=$[$val24*100]
val26=<br>Puisque \($val13 $val22 1\) c'est une $val9.<br>Calcul du taux&nbsp;&#58; \($val23=$val24\) soit \($val25 \%\)
val27=La bonne réponse est $val16. $val26 
val28=$val16,$val21
tmp0=!shuffle 4

val29=$(tmp0)
tmp0=!positionof item 1 in $val29

val30=$[rint($(tmp0))]
val31=\latexversion	    \item	    $val15	    \begin{radio}	    \item $(val28[1])	    \item $(val28[2])	    \item $(val28[3])	    \item $(val28[4])	    \end{radio}
val31=$val31 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val30;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val31 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val15	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val28[$(val29[1])]) </td><td>$(val28[$(val29[2])]) </td><td>$(val28[$(val29[3])]) </td><td>$(val28[$(val29[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

