!set title=Question 350 S Reconnaitre le tableau de signe
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,inequations,trinomial,roots
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,5

val8=$(tmp0)
tmp=!nonempty items 2,3,5

tmp0=!randitem $tmp
tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!shuffle +,-

val10=$(tmp0)
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val11=$[rint($(val8[1])*$(tmp0))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val12=$[rint($(val8[2])*$(tmp0))]
t_=!replace internal \( by ( in $val9*x-($val11)*$val9
tmp0=!exec pari $t_

val13=!rawmath $(tmp0)
t_=!replace internal \( by ( in x-($val12)
tmp0=!exec pari $t_

val14=!rawmath $(tmp0)
val15=!rawmath ($val13)*($val14)
!readproc slib/function/tabsignes [[x,$val15],[-Inf,+Inf;$val11,$val12;]],text=[\(f\),replace,2] 
tmp0=$slib_out
val16=$(tmp0)
val17=La fonction \(f\) définie sur \(RR\) par \(f(x)= ($val13)($val14)\) admet pour tableau de signes&nbsp;&#58; 
val18=$val16
val19=!rawmath -1*$val15
val20=$[rint(-1*$val11)]
val21=$[rint(-1*$val12)]
val22=!rawmath $val9*x-($val20)*$val9
val23=!rawmath x-($val21)
val24=!rawmath ($val22)*($val23)
val25=!rawmath -1*($val24)
!readproc slib/function/tabsignes [[x,$val19],[-Inf,+Inf;$val11,$val12;]],text=[\(f\),replace,2] 
tmp0=$slib_out
val26=$(tmp0)
!readproc slib/function/tabsignes [[x,$val24],[-Inf,+Inf;$val20,$val21;]],text=[\(f\),replace,2] 
tmp0=$slib_out
val27=$(tmp0)
!readproc slib/function/tabsignes [[x,$val25],[-Inf,+Inf;$val20,$val21;]],text=[\(f\),replace,2] 
tmp0=$slib_out
val28=$(tmp0)
val29=$val26
val30=$val27
val31=$val28
val32=$val29,$val30,$val31

!ifval $val9>0
val33=positif
!else
val33=négatif
!endif

!ifval $val9<0
val34=positif
!else
val34=négatif
!endif
val35=La bonne réponse est $val18 On note que&nbsp;&#58;<ul><li> les deux racines sont $val11 et $val12 </li><li> en développant le coefficient de \(x^2\) vaut $val9</li></ul> On sait donc que la fonction est de signe $val34 (l'opposé du signe de $val9) entre les racines&#44; $val33 sinon.
val36=$val18,$val32
tmp0=!shuffle 4

val37=$(tmp0)
tmp0=!positionof item 1 in $val37

val38=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val38;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val17	  <div class="wims_scrollable">	  <ul class="wims_nopuce" style="padding-left:0"><li> A. $(val36[1]) </li>	  <li>B. $(val36[2]) </li>	  <li>C. $(val36[3]) </li>	  <li>D. $(val36[4]) </li>	  </ul>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val35!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val35	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,17,35,36
embedcnt=1
