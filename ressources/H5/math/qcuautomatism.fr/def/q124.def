val7=Félicitations toutes les réponses sont justes !
tmp=!trim 1/2,1/3,4/3,5/3,8/3,1/6,5/6,2/7,4/7,1/4,2,3,3,3,3,6,6,7,7,4	1/3,1/2,3/2,5/2,7/2,6/5,9/5,6/7,9/7,3/7,3,2,2,2,2,5,5,7,7,7	2/3,1/2,5/2,7/2,9/2,6/5,9/5,6/7,3/7,1/4,3,2,2,2,2,5,5,7,7	5/3,1/2,5/2,7/2,3/4,1/4,6/7,9/7,6/11,9/11,3,2,2,2,4,4,7,7,11,11	8/3,1/2,3/2,5/2,1/4,3/4,3/5,6/5,3/7,6/7,3,2,2,2,4,4,5,5,7,7	1/6,1/2,3/2,5/2,7/2,1/4,3/5,6/5,12/5,6/7,6,2,2,2,2,4,5,5,5,7	5/6,1/2,3/2,5/2,7/2,1/4,3/4,6/5,6/7,6/11,6,2,2,2,2,4,4,5,7,11	2/7,1/2,7/2,1/3,7/3,14/3,1/4,3/4,7/5,7/6,7,2,2,3,3,3,4,4,5,6	4/7,1/2,7/2,1/3,7/3,14/3,1/4,3/4,7/5,7/6,1/2,7,2,2,3,3,3,4,4,5,7
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
t_=!rawmath $(val9[1])
val11=!exec pari print($t_)
t_=!rawmath $(val9[$val10])
val12=!exec pari print($t_)
tmp0=!texmath $val11

val13=$(tmp0)
tmp0=!texmath $val12

val14=$(tmp0)
val15=On considère \(A=$val13-$val13 \times $val14\).
val16=$[rint($(val9[11]))]
val17=$[rint($val11*$val16)]
val18=$[rint($(val9[9+$val10]))]
val19=$[rint($val12*$val18)]
t_=!rawmath $val11-$val11*$val12
val20=!exec pari print($t_)

!ifval ($val17-$val17*$val19==0)
t_=!rawmath  1
val21=!exec pari print($t_)
!else
t_=!rawmath ($val17-$val17*$val19)/($val16-$val16*$val18)
val21=!exec pari print($t_)
!endif

!ifval ($val17-$val17*$val18==0 or $val16-$val16*$val19==0)
tmp=!nonempty items -1,2

tmp0=!randitem $tmp
t_=!rawmath  $(tmp0)
val22=!exec pari print($t_)
!else
t_=!rawmath ($val17-$val17*$val18)/($val16-$val16*$val19)
val22=!exec pari print($t_)
!endif
t_=!rawmath 0
val23=!exec pari print($t_)
tmp0=!texmath $val20

val24=\(A=$(tmp0)\)
tmp0=!texmath $val21

val25=\(A=$(tmp0)\)
val26=\(A=$val22\)
val27=\(A=$val23\)
val28=$val25,$val26,$val27
t_=!rawmath $val11*$val12
val29=!exec pari print($t_)
tmp0=!texmath $val29

val30=$(tmp0)
tmp0=!texmath $val20

val31=La bonne réponse est $val24. <br>On commence par calculer \($val13 \times $val14=$val30\) puis \(A=$val13-$val30=$(tmp0)\). 
val32=$val24,$val28
tmp0=!shuffle 4

val33=$(tmp0)
tmp0=!positionof item 1 in $val33

val34=$[rint($(tmp0))]
val35=\latexversion	    \item	    $val15	    \begin{radio}	    \item $(val32[1])	    \item $(val32[2])	    \item $(val32[3])	    \item $(val32[4])	    \end{radio}
val35=$val35 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val34;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val35 \end{statement} \begin{solution} \end{solution} 


