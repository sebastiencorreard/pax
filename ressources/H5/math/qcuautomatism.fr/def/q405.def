!set title=Question 405 NS prix multiplié
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim doublé,100,2,200,50,2	triplé,200,3,300,100,3	quadruplé,300,400,4,40,4
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$(val9[1])
val11=$[rint($(val9[6]))]
val12=un prix a $val10. Cela signifie que le prix a augmenté de&nbsp;&#58;
val13=\( $(val9[2]) \% \)
val14=\( $(val9[3]) \% \),\( $(val9[4]) \% \),\( $(val9[5]) \% \)
val15=La bonne réponse est \( $(val9[2]) \% \) puisque augmenter de \($(val9[2])\) équivaut à multiplier par \(1+\frac{$(val9[2])}{100}=$val11 \).
val16=$val13,$val14
tmp0=!shuffle 4

val17=$(tmp0)
tmp0=!positionof item 1 in $val17

val18=$[rint($(tmp0))]
val19=\latexversion	    \item	    $val12	    \begin{radio}	    \item $(val16[1])	    \item $(val16[2])	    \item $(val16[3])	    \item $(val16[4])	    \end{radio}
val19=$val19 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val18;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val12	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val16[$(val17[1])]) </td><td>$(val16[$(val17[2])]) </td><td>$(val16[$(val17[3])]) </td><td>$(val16[$(val17[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val15!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val15	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,12,15,16,17,19
embedcnt=1
