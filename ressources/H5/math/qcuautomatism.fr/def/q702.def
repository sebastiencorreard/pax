!set title=Question 702 T Lire un diagramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,histogram
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-1_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val8=$(tmp0)

!ifval $val8=1
val9=plus
!else
val9=moins
!endif

!ifval $val8=1
val10=grande
!else
val10=petite
!endif
val11=Le diagramme en barres ci-dessous donne la production d’électricité&#44; en Twh (térawatt-heure) selon son origine (source&nbsp;&#58; INSEE) <div class="wimscenter"><img src="$val1/imgq702.png" alt="Histogramme" ></div>L’année où la production d’électricité d’origine hydraulique était la $val9 importante est&nbsp;&#58;

!ifval $val8=1
val12=2016
!else
val12=2006
!endif

!ifval $val8=2
val13=2016
!else
val13=2006
!endif
val13=$val13,2001,2011
val14=La bonne réponse était $val12. <br>Il faut comparer les hauteurs des rectangles au sommet des barres. On recherche la plus $val10.
val15=$val12,$val13
tmp0=!shuffle 4

val16=$(tmp0)
tmp0=!positionof item 1 in $val16

val17=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val17;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val15[$(val16[1])]) </td><td>$(val15[$(val16[2])]) </td><td>$(val15[$(val16[3])]) </td><td>$(val15[$(val16[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val14!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val14	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,11,14,15,16
embedcnt=1
