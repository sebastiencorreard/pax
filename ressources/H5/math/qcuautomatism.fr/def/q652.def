val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 2, 5

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
tmp2=!shuffle 0,$(tmp0)*$(tmp1)

val10=$(tmp2)
val11=$[rint($(val10[1]))]
val12=$[rint($val8*$val11+$val9)]
val13=$[rint($(val10[2]))]
val14=$[rint($val8*$val13+$val9)]
val15=Le plan est muni d’un repère orthogonal. <br>On note \(d\) la droite passant par les points	\(A($val11 &#59; $val12)\) et <span class="nowrap">\(B($val13 &#59; $val14)\).</span> <br>Le coefficient directeur de la droite \(d\) est égal à&nbsp;&#58; 
val16=\($val8\)
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val17=$[rint($val8+$(tmp0))]
val18=\($val17\)
val19=$[rint(abs($val8))]

!ifval $val8>0
val20=-
!else
val20=
!endif
val21=\($val20 \frac{1}{$val19}\)
val22=$[rint(abs($val17))]

!ifval $val20 issametext -
val23=
!else
val23=-
!endif
val24=\($val23 \frac{1}{$val22}\)
val25=$val18,$val21,$val24

!ifval $val13<0
val26=($val13)
!else
val26=$val13
!endif

!ifval $val14<0
val27=($val14)
!else
val27=$val14
!endif
val28=La bonne réponse est $val16. <br>On utilise la formule \(\frac{y_A-y_B}{x_A-x_B}\)<span class="nowrap">\({}=\frac{$val12-$val27}{$val11-$val26}=$val8\).</span>
val29=$val16,$val25
tmp0=!shuffle 4

val30=$(tmp0)
tmp0=!positionof item 1 in $val30

val31=$[rint($(tmp0))]
val32=\latexversion	    \item	    $val15	    \begin{radio}	    \item $(val29[1])	    \item $(val29[2])	    \item $(val29[3])	    \item $(val29[4])	    \end{radio}
val32=$val32 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val31;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val32 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

