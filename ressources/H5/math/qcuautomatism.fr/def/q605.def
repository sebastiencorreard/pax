val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!shuffle 2,3,5

val8=$(tmp0)
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val9=$[rint($(val8[1])*$(tmp0))]
val10=$[rint(-1*$val9)]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
val12=$[rint(-1*$val11)]
val13=!rawmath $val11*x+$val9
val14=$[rint(-6)]
val15=$[rint(6)]
val16=$[rint(-6)]
val17=$[rint(6)]
val18=text black,5.5,0.7,big,x	  text black,0.1,-0.4,big,0	  text black,-0.5,5.8,big,y	  
val19=$[$val9]
val20=$[1]
val21=range $val14,$val15,$val16,$val17	linewidth 1	arrow $val14,0,$val15,0,10,black	arrow 0,$val16,0,$val17,10,black	$val18	linewidth 2	  plot red,$val13	latex $val20,$val19,\mathcal{D}
!readproc oef/draw.phtml 300,300 \
$val21 
tmp0=$ins_url
val22=$(tmp0)

!ifval $val9<
val23=$val9
!else
val23=+$val9
!endif

!ifval $val11<0
val24=-x $val23
!else
val24=x $val23
!endif
val25=\(y=$val24\)

!ifval $val11>0
val26=-x $val23
!else
val26=x $val23
!endif
val27=\(y=$val26\)

!ifval $val10<0
val28=$val10
!else
val28=+$val10
!endif

!ifval $val11>0
val29=-x $val28
!else
val29=x $val28
!endif
val30=\(y=$val29\)

!ifval $val11<0
val31=-x $val28
!else
val31=x $val28
!endif
val32=\(y=$val31\)
val33=$val27,$val30,$val32
val34=On considère une droite \(\mathcal{D}\) représentée ci-dessous.	 <div class="wimscenter"><img src="$val22" alt=""></div>La seule équation pouvant correspondre à l’équation réduite de la droite \(\mathcal{D}\) est&nbsp;&#58;

!ifval $val11=-1
val35=décroissante
!else
val35=croissante
!endif

!ifval $val11=-1
val36=négatif
!else
val36=positif
!endif
val37=$[rint(\signa*\anum)]

!ifval $val9<0
val38=au-dessous
!else
val38=au-dessus
!endif

!ifval $val9<0
val39=négatif
!else
val39=positif
!endif
val40=La bonne réponse était $val25. <br> On peut lire sur le graphique les informations suivantes&nbsp;&#58; <ul><li>Dans les propositions les coefficients directeurs sont \(1\) ou \(-1\)</li><li>Dans les propositions les ordonnées à l'origine sont \($val9\) ou \($val10\)</li><li>La fonction affine associée est $val35 ce qui signifie que le coefficient directeur est $val36 (il est donc égal à \($val11\))</li><li>La droite coupe l'axe des ordonnées $val38 de l'origine&#44; l'ordonnée à l'origine est donc $val39 (elle est donc égal à \($val9\))</li></ul><b>
val41=$val25,$val33
tmp0=!shuffle 4

val42=$(tmp0)
tmp0=!positionof item 1 in $val42

val43=$[rint($(tmp0))]
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val43;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__

