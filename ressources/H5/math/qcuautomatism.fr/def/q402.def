!set title=Question 402 T Comparaison de proportions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents,fraction
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!trim quart,\(20\%\),tiers,D,C	tiers,\(20\%\),quart,B,C	cinquième,\(25\%\),tiers,A,C	tiers,\(25\%\),cinquième,C,A	dixième,\(30\%\),cinquième,A,D	dixième,\(8\%\),cinquième,B,D	
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp=!nonempty items 4,5

tmp0=!randitem $tmp
val10=$(tmp0)

!ifval $val10 issametext 4
val11=moins
!else
val11=plus
!endif
val12=Lors d’une élection&#44; le $(val9[1]) des électeurs a voté pour A&#44; $(val9[2]) a voté pour B&#44; un $(val9[3]) a voté pour C&#44; et le reste a voté pour D.<br>Le candidat ayant recueilli le <u>$val11</u> de votes est le candidat&nbsp;&#58;
val13=$(val9[$val10])
val14=
val15=<br><u>Rappel&nbsp;&#58;</u> <ul><li>Un quart correspond à \(25\%\)</li><li>Un cinquième correspond à \(20\%\)</li><li>Un tiers correspond à environ \(33.33\%\)</li><li>Un dixième correspond à \(10\%\)</li></ul>
val16=La bonne réponse est le candidat <b>$val13 </b>. <br>Pour comparer on peut comparer les pourcentages sachant que la somme de toutes les proportions doit faire <span class="nowrap">\(100\%\).</span> $val15
val17=A,B,C,D
tmp0=!positionof item $val13 in $val17

val18=$[rint($(tmp0))]
val19=\latexversion	    \item	    $val12	    \begin{radio}	    \item $(val17[1])	    \item $(val17[2])	    \item $(val17[3])	    \item $(val17[4])	    \end{radio}
val19=$val19 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val18;A,B,C,D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()	<div class="wims_question">	  $val12	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	  </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val16!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val16	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,16,19
embedcnt=1
