!set title=Question 211 NS Développer un carré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,literal_calculation,trinomial
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items x,n,t

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items 3,4,3,5,3,2

tmp0=!randitem $tmp
val9=$(tmp0)
val10=!rawmath (x - $val9)^2
val11=$[rint(1)]
val12=$[rint(2*$val9)]
val13=$[rint($val9^2)]
val14=L’expression développée de \(( $val8 - $val9)^2\) est&nbsp;&#58; 
val15=\($val8^2-$val12*$val8+$val13\)
val16=\($val8^2+$val13\)
val17=\($val8^2-$val13\)
tmp=!nonempty items \($val8^2-$val12*$val8-$val13\),\($val8^2+$val12*$val8-$val13\)

tmp0=!randitem $tmp
val18=$(tmp0)
val19=$val16,$val17,$val18
val20=La bonne réponse est $val15. <ul class="wims_nopuce"><li> Soit on développe <span class="nowrap">\(($val8 - $val9)($val8 - $val9)\).</span><i>(double distributivité)</i></li><li>Soit on utilise l'identité remarquable <span class="nowrap">\(($val8 - $val9)^2=$val8^2-2\times$val9\times $val8+$val9^2\).</span></li></ul>  
val21=$val15,$val19
tmp0=!shuffle 4

val22=$(tmp0)
tmp0=!positionof item 1 in $val22

val23=$[rint($(tmp0))]
val24=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val21[1])	    \item $(val21[2])	    \item $(val21[3])	    \item $(val21[4])	    \end{radio}
val24=$val24 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val23;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val24 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val14	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val21[$(val22[1])]) </td><td>$(val21[$(val22[2])]) </td><td>$(val21[$(val22[3])]) </td><td>$(val21[$(val22[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val24 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val20!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val20	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,14,20,21,22,24
embedcnt=1
