!set title=Question 207 S Isoler une variable
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,literal_calculation
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specialite-1.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items +,+,-

tmp0=!randitem $tmp
val8=$(tmp0)
val9=On considère \(x\)&#44; \(y\)&#44; \(u\) des réels non nuls tels que <span class="nowrap">\(\frac{1}{x}$val8\frac{1}{y}=\frac{1}{u}\).</span><br>On peut affirmer que&nbsp;&#58;

!ifval $val8 issametext +
val10=\(u=\frac{x y}{x+y}\)
!else
val10=\(u=\frac{x y}{y-x}\)
!endif

!ifval $val8 issametext +
val11=\(u=\frac{x+y}{x y}\)
!else
val11=\(u=\frac{x y}{x-y}\)
!endif

!ifval $val8 issametext +
val12=\(u=xy\)
!else
val12=\(u=-x y\)
!endif
tmp=!nonempty items \(u=x-y\),\(u=y-x\)

tmp0=!randitem $tmp
val13=$(tmp0)

!ifval $val8 issametext +
val14=\(u=x+y\)
!else
val14=$val13
!endif
val15=$val11,$val12,$val14

!ifval $val8 issametext +
val16=\frac{x+y}{x y}
!else
val16=\frac{y-x}{x y}
!endif
val17=<br> On peut remarquer que <span class="nowrap">\(\frac{1}{u}=\frac{1}{x}$val8\frac{1}{y}=$val16\).</span> <br>Par passage à l'inverse&#44; on obtient <span class="nowrap">\(u\).</span>
val18=La bonne réponse est $val10. $val17
val19=$val10,$val15
tmp0=!shuffle 4

val20=$(tmp0)
tmp0=!positionof item 1 in $val20

val21=$[rint($(tmp0))]
val22=\latexversion	    \item	    $val9	    \begin{radio}	    \item $(val19[1])	    \item $(val19[2])	    \item $(val19[3])	    \item $(val19[4])	    \end{radio}
val22=$val22 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val21;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val22 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val9	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val19[$(val20[1])]) </td><td>$(val19[$(val20[2])]) </td><td>$(val19[$(val20[3])]) </td><td>$(val19[$(val20[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

