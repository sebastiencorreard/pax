val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items 1,1,2

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!shuffle 10,100,1000

val10=$(tmp0)
val11=$[rint($(val10[1]))]
val12=$[rint($(val10[2]))]
tmp=!nonempty items T,P,E

tmp0=!randitem $tmp
val13=$(tmp0)
val14=On considère <span class="nowrap">\($val13=\frac{$val8}{$val11}+\frac{$val9}{$val12}\).</span> On a&nbsp;&#58; 
val15=$[$val8/$val11+$val9/$val12]
val16=\($val13=$val15\)
val17=$[$val8+$val9/$val12]
val18=\($val13=$val17\)
val19=$[rint($val8+$val9)]
val20=$[rint($val11*$val12)]
val21=\($val13=\frac{$val19}{$val20}\)
tmp=!nonempty items $val15/10,$val15*10

tmp0=!randitem $tmp
val22=$[$(tmp0)]
val23=\($val13=$val22\)
val24=$val18,$val21,$val23
val25=En effet&nbsp;&#58; <ul class="wims_nopuce"><li>\(\frac{1}{10}=0.1\)</li><li>\(\frac{1}{100}=0.01\)</li><li>\(\frac{1}{1000}=0.001\)</li><li>...</li></ul>
val26=La bonne réponse est $val16. <br>$val25 
val27=$val16,$val24
tmp0=!shuffle 4

val28=$(tmp0)
tmp0=!positionof item 1 in $val28

val29=$[rint($(tmp0))]
val30=\latexversion	    \item	    $val14	    \begin{radio}	    \item $(val27[1])	    \item $(val27[2])	    \item $(val27[3])	    \item $(val27[4])	    \end{radio}
val30=$val30 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val29;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val30 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

