!set title=Question 553 NS Evolution inverse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,percentage,percents
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-specifique-3_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp0=!randint 1, 8

val8=$[rint(10*$(tmp0))]
tmp0=!shuffle augmente,diminue

val9=$(tmp0)
val10=$[1-$val8^2/10000]
val11=Un prix $(val9[1]) de \($val8 \%\) puis $(val9[2]) de <span class="nowrap">\($val8 \%\).</span> <br>Après ces deux évolutions&#44; on peut affirmer que&nbsp;&#58;
val12=le prix est strictement inférieur au prix de départ
val13=le prix est strictement supérieur au prix de départ
val14=le prix est égal au prix de départ
val15=on ne peut pas savoir car cela dépend du prix de départ
val16=$val13, $val14,$val15
val17=La bonne réponse est <b>$val12</b>. <br>En effet le prix de départ est multiplié par \(\left( 1-\frac{$val8}{100}\right)\left( 1+\frac{$val8}{100}\right)=1-\left(\frac{$val8}{100}\right)^2\)<br>\({}=$val10\) <br>et <span class="nowrap">\($val10<1\).</span> 
val18=$val12,$val16
tmp0=!shuffle 4

val19=$(tmp0)
tmp0=!positionof item 1 in $val19

val20=$[rint($(tmp0))]
val21=\latexversion	    \item	    $val11	    \begin{radio}	    \item $(val18[1])	    \item $(val18[2])	    \item $(val18[3])	    \item $(val18[4])	    \end{radio}
val21=$val21 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val20;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val21 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val11	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val18[$(val19[1])]) </td><td>$(val18[$(val19[2])]) </td><td>$(val18[$(val19[3])]) </td><td>$(val18[$(val19[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val21 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val17!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val17	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,11,17,18,19,21
embedcnt=1
