tmp=!trim $val13	\($val9 \times \frac{1}{$val9^{$val10}}=$val9^{$val11}\),\($val9 \times \frac{1}{$val9^{$val10}}=$val9^{$val12}\) 
val13=!translate internal $	\
$ to ;; in $tmp
