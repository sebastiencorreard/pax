!set title=Question 600 T Reconnaître graphiquement une fct affine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Cyrille,Douriez
email=communaute.mutuwims@laposte.net;cyrille.douriez@ac-amiens.fr
keywords=quizz,affine_function
oefobservation=
oefcss=<style>.feedmutu { border: 1px solid; border-radius: 5px; padding: .5em;} </style>
oefobservation=Question du sujet zéro sujet-techno-2_0.pdf publié sur EDUSCOL en juin 2025 

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img style="float:left;width:20px;height:20px;" src="gifs/domains/general/calculator_not.svg" alt="Calculatrices interdites" >	<strong>La calculatrice n'est pas autorisée.</strong>
val7=Félicitations toutes les réponses sont justes !
tmp=!nonempty items 1,2,3

tmp0=!randitem $tmp
tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!shuffle 2,3,4

tmp1=!item 1 of $(tmp0)

tmp=!nonempty items -1,1

tmp2=!randitem $tmp
val9=$[rint($(tmp1)*$(tmp2))]
val10=!rawmath $val8*x+$val9
val11=!rawmath -$val8*x+$val9
val12=!rawmath -$val8*x-$val9
val13=!rawmath $val8*x-$val9
val14=range -5,5,-5,5	linewidth 1	arrow -5,0,5,0,10,black	arrow 0,-5,0,5,10,black	linewidth 2	  trange -5,5	
val15=$val14	  plot red,$val10
val16=$val14	  plot red,$val11
val17=$val14	  plot red,$val12
val18=$val14	  plot red,$val13
!readproc oef/draw.phtml 80,80 \
$val15	 
tmp0=$ins_url
val19=$(tmp0)
val20=<img src="$val19" alt="représentation graphique">
!readproc oef/draw.phtml 80,80 \
$val16	 
tmp0=$ins_url
val21=$(tmp0)
val22=<img src="$val21" alt="représentation graphique">
!readproc oef/draw.phtml 80,80 \
$val17	 
tmp0=$ins_url
val23=$(tmp0)
val24=<img src="$val23" alt="représentation graphique">
!readproc oef/draw.phtml 80,80 \
$val18	 
tmp0=$ins_url
val25=$(tmp0)
val26=<img src="$val25" alt="représentation graphique">
val27=La seule droite pouvant correspondre à l’équation \(y=$val10\) est&nbsp;&#58;
val28=$val20
val29=$val22,$val24 ,$val26

!ifval $val8<0
val30=négatif
!else
val30=positif
!endif

!ifval $val8<0
val31=décroissante
!else
val31=croissante
!endif

!ifval $val9<0
val32=négative
!else
val32=positive
!endif
val33=La bonne réponse était $val28.<br> Puisque le coefficient directeur \($val8\) est $val30 la fonction est donc $val31 et que \($val9\) est $val32.<br><u>Rappel&nbsp;&#58;</u> l'ordonnée à l'origine est l'ordonnée du point d'intersection de la droite et de l'axe des ordonnées.
val34=$val28,$val29
tmp0=!shuffle 4

val35=$(tmp0)
tmp0=!positionof item 1 in $val35

val36=$[rint($(tmp0))]
val37=\latexversion	    \item	    $val27	    \begin{radio}	    \item $(val34[1])	    \item $(val34[2])	    \item $(val34[3])	    \item $(val34[4])	    \end{radio}
val37=$val37 \end{enumerate}
replytype1=radio
replyoption1=nolegend noanalyzeprint 
replyname1=
replygood1=$val36;Réponse A,Réponse B,Réponse C,Réponse D
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val37 \end{statement} \begin{solution} \end{solution} 


!goto stat

!exit

:question
$()<div class="wims_instruction">$val6</div>	<div class="wims_question">	  $val27	  <div class="wimscenter wims_scrollable">	  <table class="wimsborder"><tr><th>	  A. </th><th>B. </th><th> C.</th><th> D.	  </th></tr>	  <tr><td>$(val34[$(val35[1])]) </td><td>$(val34[$(val35[2])]) </td><td>$(val34[$(val35[3])]) </td><td>$(val34[$(val35[4])]) </td></tr>	  </table>	  </div>	  <div class="wimscenter">	  <b>  
!read oef/embed.phtml r1 
$() </b>	  </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val37 $m_end{statement} $m_begin{solution} $m_end{solution} 
$()
!exit

:feedback
!ifval ($m_sc_reply1<1) and ($val33!=)
 <div class='oef_feedbacks'>	  <div class="feedmutu">$val33	  </div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,27,33,34,35,37
embedcnt=1
