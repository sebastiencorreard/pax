!insmath n
$()</b>	<br />	<b>
!insmath U_0
$() : 1<sup>er</sup> terme</b>	<br />	<b>
!insmath r
$() : raison de la suite</b>	<br />	<b>
!insmath n
$() : rang de la suite</b>	<br />	</td>	<td></td>	<td>	<b>
!insmath S_k
$() : Somme des termes de rang 
!insmath k
$()</b>	<br />	<b>
!insmath U_n
$() : terme de rang 
!insmath n
