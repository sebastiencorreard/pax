!read oef/special.phtml mathmlinput [\begin{array}{lcl}	U_n &=& U_0 \times (1+t)^n \\ \hline	reply12 &=& reply13 \times (1+reply14)^n \\ \hline	 reply15 &=& reply16 \times (reply17)^n \\ \hline	 \frac{reply18}{reply19} &=& (reply20)^n \\ \hline	log(reply21) &=& log(reply22)^n \\ \hline	log(reply23) &=& n \times log(reply24) \\ \hline	n&=&reply25	\end{array}],5	reply12,,color:blue;font-size:20px	reply13,,color:blue;font-size:20px	reply14,3,color:blue;font-size:20px	reply15,,color:blue;font-size:20px	reply16,,color:blue;font-size:20px	reply17,3,color:blue;font-size:20px	reply18,,color:blue;font-size:20px	reply19,,color:blue;font-size:20px	reply20,3,color:blue;font-size:20px	reply21,,color:blue;font-size:20px	reply22,3,color:blue;font-size:20px	reply23,,color:blue;font-size:20px	reply24,,color:blue;font-size:20px	reply25,3,color:blue;font-size:20px 
$()	</div>		<div class="Table">	<ul><li>$(val27[3])</li></ul>	<div class="wimscenter">	<div id="box" class="jxgbox" style="width:400px; height:300px;"></div>	<script>	var board = JXG.JSXGraph.initBoard('box', {originX: 50, originY: 220, unitX: 10, unitY: 0.05, axis:true,shownavigation:false, grid:false});		var s = board.createElement('slider', [[1,-500],[21,-500],[500,500,700]],{name:'Capital',strokeColor:'black',fillColor:'red',snapWidth:50});	var t = board.createElement('slider', [[1,-1000],[26,-1000],[3,3,8]],{name:'Taux',strokeColor:'black',fillColor:'red',snapWidth:1});		var yy = board.createElement('text',[3,3800,function(){	    return '<b>Capital acquis en &#8364;</b>';}],{fontSize:'14px'});	var xx = board.createElement('text',[20,500,function(){	    return '<b>Durée du placement en année</b>';}],{fontSize:'14px'});		var fct= board.createElement('functiongraph', [function(x){return s.Value()*board.pow(1+t.Value()/100,x);},0,20]);	var g1 = board.createElement('glider', [2, $(val24[2]), fct], {style:12,name:"Déplace moi", strokeColor:'#990000',highlightStrokeColor:'#000000'});		var pyy = board.createElement('point',[0 , function(){ return g1.Y();}], {name:'B',style:6,visible:false});	var pxx = board.createElement('point',[function(){ return g1.X();}, 0], {visible:false});		var fleyy = board.createElement('line',[pyy,g1], 	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});	var fleyy = board.createElement('line',[g1,pxx], 	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});	</script>	</div>	</div>		<div class="Table">	<ul><li>$(val27[4])</li></ul>	<div class="wimscenter">	<div id="box2" class="jxgbox" style="width:400px; height:300px;"></div>	<script>	var brd = JXG.JSXGraph.initBoard('box2', {originX: 50, originY: 220, unitX: 10, unitY: 0.05, axis:true,shownavigation:false, grid:false});	var ss = brd.createElement('slider', [[1,-500],[21,-500],[500,500,700]],{name:'Capital',strokeColor:'black',fillColor:'red',snapWidth:50});	var nn = brd.createElement('slider', [[1,-1000],[21,-1000],[1,3,10]],{name:'Durée du placement',strokeColor:'black',fillColor:'red',snapWidth:1});		var yyy = brd.createElement('text',[3,3800,function(){	    return '<b>Capital acquis en &#8364;</b>';}],{fontSize:'14px'});	var xxx = brd.createElement('text',[20,500,function(){	    return '<b>Taux en pourcentage</b>';}],{fontSize:'14px'});		var f= brd.createElement('functiongraph', [function(x){return ss.Value()*brd.pow(1+x/100,nn.Value());},0,20]);	var gg = brd.createElement('glider', [2, ss.Value()*brd.pow(1+2/100,nn.Value()), f], {style:12,name:"Déplace moi", strokeColor:'#990000',highlightStrokeColor:'#000000'});		var pyyy = brd.createElement('point',[0 , function(){ return gg.Y();}], {name:'B',style:6,visible:false});	var pxxx = brd.createElement('point',[function(){ return gg.X();}, 0], {visible:false});		var fleyyy = brd.createElement('line',[pyyy,gg], 	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});	var fleyyy = brd.createElement('line',[pxxx,gg], 	 {straightFirst:false, straightLast:false, strokeWidth:2, strokeColor:'#990000', dash:0,  lastArrow:true});	</script>	</div>	</div>		<div class="question">	<div class="etape">ÉTAPE $m_step sur 2</div>	<span class="bold" style="text-decoration:underline">Conclusion :</span><span class="bold"> La durée du placement doit donc être de	  
