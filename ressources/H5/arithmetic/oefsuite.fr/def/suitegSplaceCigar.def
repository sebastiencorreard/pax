replyoption6=nonstop 
replyname6=Valeur du capital acquis durant 1 mois
replygood6=$[$val21]
replytype7=numeric
replyoption7=nonstop 
replyname7=Valeur du capital acquis durant 2 mois
replygood7=$[$val23]
replytype8=menu
replyoption8=nonstop 
replyname8=
replygood8=2;arithmétique,géométrique,quelconque
replytype9=numeric
replyoption9=nonstop 
replyname9=1er terme \(U_0)
