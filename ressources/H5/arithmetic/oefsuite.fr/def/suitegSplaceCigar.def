replyoption10=nonstop 
replyname10=raison: q 
replygood10=$[1+$val17]
replytype11=numeric
replyoption11=nonstop 
replyname11=Bénéfice net mensuel
replygood11=$[$val27]
replytype12=numeric
replyoption12=nonstop 
replyname12=Valeur du capital placé
replygood12=$[$val27]
question=__EXECUTED_1692754_EXERCISE__

