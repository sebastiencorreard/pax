val23=$[$val22/100]
val24=$[1+$val17]
val25=$[$val15*(1-$val24^$val11)/(1-$val24)]
val26=$[rint($val25*100)]
val27=$[$val26/100]
val28=Quel est le prix réel de la consommation de tabac ?
val29=Un jeune décide d'arrêter de fumer à l'age de 15 ans. Sa consommation de cigarettes était de 1 paquet	 tous les 2 jours. Le prix d'un paquet est de 6.2 &#8364;.	<br />	 On réalise l'approximation suivante : l'ensemble des mois comporte 30 jours.	<br />	Il décide de placer l'argent sur un compte épargne rémunéré à un taux annuel de $val18 %.	<br />	Quelle est la somme d'argent qu'il aura à $val9 ans
dynsteps=yes
oefsteps=$val7 
nextstep=!nosubst $val7 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=nonstop 
replyname1=Montant placé chaque mois
