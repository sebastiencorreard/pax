val9=$[rint(18+$val8)]
val10=$[rint($val8+3)]
val11=$[rint(($val8+3)*12)]
val12=$[rint(($val8+3)*12-1)]
val13=$[rint(($val8+3)*12-2)]
val14=$[rint(($val8+3)*12-3)]
val15=$[93]
