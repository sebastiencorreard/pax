$()
$()
!exit

:help
$()
!if $m_help_subject issametext main 
$()	C'est à dire sans utiliser un logiciel ou un programme de calculatrice. 
!else
$() 	On peut faire un tableau où figurent les valeurs des variables.	<table class="wimsborder wimscenter">	<tr><td>k</td><td>u</td><td>k&le;$val7 ?</td></tr>	<tr><td>1</td><td>$val12</td><td>vrai</td></tr>	<tr><td>2</td><td>...</td><td>...</td></tr>	</table> 
!endif
$()	
$()
!exit

