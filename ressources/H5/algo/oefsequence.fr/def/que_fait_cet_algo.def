val20=<table class="algo">	<tr class="init"><th>Initialisation</th><td> u <span class="ielem">&larr;</span> $val7</td></tr>	<tr class="init"><th></th><td> s <span class="ielem">&larr;</span> 0</td></tr>	<tr class="traitement"><th>Traitement</th><td>  <span class="ielem">Pour</span> k <span class="ielem">de</span> 1 <span class="ielem">à</span> $val10 </td></tr>	<tr class="traitement"><th></th><td>  &nbsp; &nbsp; u <span class="ielem">&larr;</span> $val8 &times; u </td></tr>	<tr class="traitement"><th></th><td>  &nbsp; &nbsp; s <span class="ielem">&larr;</span> s+u </td></tr>	<tr class="traitement"><th></th><td>  <span class="ielem">Fin Pour</span> </td></tr>	<tr class="traitement"><th></th><td>  <span class="ielem">Afficher</span> s </td></tr>	</table>	
val21=<table class="algo">	<tr class="init"><th>Initialisation</th><td> u <span class="ielem">&larr;</span> $val7</td></tr>	<tr class="init"><th></th><td> n <span class="ielem">&larr;</span> $val6 </td></tr>	<tr class="traitement"><th>Traitement</th><td>  <span class="ielem">Tant que </span> u > $val14 </td></tr>	<tr class="traitement"><th></th><td>  &nbsp; &nbsp; u <span class="ielem">&larr;</span> $val8 &times; u </td></tr>	<tr class="traitement"><th></th><td>  &nbsp; &nbsp; n <span class="ielem">&larr;</span> n+1 </td></tr>	<tr class="traitement"><th></th><td>  <span class="ielem">Fin Tant que</span> </td></tr>	<tr class="sortie"><th>Sortie</th><td>  <span class="ielem">Afficher</span> n </td></tr>	</table>	
