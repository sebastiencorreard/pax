!set title=Lecture et exécution d'un algorithme (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, El Hmouzi
email=khalidhmouzi@gmail.com
language=fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
!if $val6=0 
val6=$[rint(13)]
!endif
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
val9=+,-
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
val11=$(val9[$val10])
tmp0=!randint -5, 5

val12=$[rint($(tmp0))]
val13=u <span class="ielem">&larr;</span> $val12,	<span class="ielem">Pour</span> k <span class="ielem">allant de</span> 1 <span class="ielem">à</span> $val7,	u <span class="ielem">&larr;</span> $val6 u+$val8, <span class="ielem">fin Pour</span>,	<span class="ielem">afficher</span> u
val14=$[rint($val12)]
!for val15 =1 to $val7  
val14=$[rint($val6*$val14+$val8)]
!next
replytype1=numeric
replyname1=La valeur affichée de u est :
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	On considère l'algorithme suivant :			<table class="algo">	  <tr class="init"><th> Initialisation :  </th><td>$(val13[1])</td></tr>	  <tr class="traitement"><th> Traitement :      </th><td>$(val13[2])</td></tr>	  <tr class="traitement"><th>                   </th><td>&nbsp; &nbsp; $(val13[3])</td></tr>	  <tr class="traitement"><th>                   </th><td>$(val13[4])</td></tr>	</table>	</div>		<div class="question">	Exécuter cet algorithme  
!read oef/special.phtml help, main,à la main 
$() et donner la valeur de u 	affichée à la sortie.	<div class="reponse">	u= 
!read oef/embed.phtml r1,400x40 
$()	</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
!if $m_help_subject issametext main 
$()	C'est à dire sans utiliser un logiciel ou un programme de calculatrice. 
!else
$() 	On peut faire un tableau où figurent les valeurs des variables.	<table class="wimsborder wimscenter">	<tr><td>k</td><td>u</td></tr>	<tr><td></td><td>$val12</td></tr>	<tr><td>1</td><td>...</td></tr>	<tr><td>2</td><td>...</td></tr>	</table> 
!endif
$()	
$()
!exit

:solution
