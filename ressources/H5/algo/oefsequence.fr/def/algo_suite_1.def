val6=$[rint($(tmp0))]
val7=+,-
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
val10=+,-
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
val13=u <span class="ielem">&larr;</span> $val12 ,	<span class="ielem">Pour</span> k <span class="ielem">allant de</span> 2 <span class="ielem">à</span> n,	u <span class="ielem"> &larr; </span> \($val6 u$(val10[$val11])$val9 \),	<span class="ielem">fin Pour</span>
