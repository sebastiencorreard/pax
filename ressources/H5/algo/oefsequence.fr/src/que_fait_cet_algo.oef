<tr class="traitement"><th></th><td>  <span class="ielem">Fin Tant que</span> </td></tr>
<tr class="sortie"><th>Sortie</th><td>  <span class="ielem">Afficher</span> n </td></tr>
</table>
}

\integer{n01=\n00+1}\integer{n02=\n00+2}
\integer{n1=\n+1}\integer{nmoins1=\n-1}
\if{\n00=0}{\text{un1=u<sub>\n</sub>}\text{un11=u<sub>\n1</sub>}}{\text{un1=u<sub>\n1</sub>}\text{un11=u<sub>\n</sub>}}
\if{\n00=0}{\text{un2=u<sub>\nmoins1</sub>}}{\text{un2=u<sub>\n</sub>}}
\if{\n00=0}{\text{un3=u<sub>\n</sub>}}{\text{un3=u<sub>\n1</sub>}}



\text{propositions=
Il affiche \n fois le terme u<sub>\n00</sub>,
Il affiche le terme \un1,
Il affiche tous les termes de u<sub>\n00</sub> à \un2,
Il affiche tous les termes de u<sub>\n01</sub> à \un3,
Il calcule la somme u<sub>\n00</sub>+u<sub>\n01</sub>+...+\un2,
Il calcule la somme u<sub>\n01</sub>+u<sub>\n02</sub>+...+\un3,
Il calcule le rang à partir duquel \(u_n\le \s),
Il calcule le rang à partir duquel \(u_n\ge \s),
Il affiche le terme \un11

}

\text{algo=\algo1,\algo2,\algo3, \algo4,\algo5,\algo6,\algo7,\algo8}




\statement{
<div id="enonce">
On considère la suite \((u_n)) définie par \(u_{\n00}=\u0) et  \(u_{n+1}=\q u_n) pour tout 
entier naturel n \if{\n00>0}{non nul}.
</div>

<div class="question">
Que fait cet algorithme ?
\algo[\i]

<div class="reponse">
\embed{r1,400x50}
</div>
</div>

}

\answer{}{\propositions[\i];\propositions}{type=clickfill}
