\text{algo5=
<table class="algo">
<tr class="init"><th>Initialisation</th><td> u <span class="ielem">&larr;</span> \u0</td></tr>
<tr class="init"><th></th><td> s <span class="ielem">&larr;</span> 0</td></tr>
<tr class="traitement"><th>Traitement</th><td>  <span class="ielem">Pour</span> k <span class="ielem">de</span> 1 <span class="ielem">à</span> \n </td></tr>
