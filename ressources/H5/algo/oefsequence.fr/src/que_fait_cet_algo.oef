\title{Que fait cet algorithme ?}

\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}\computeanswer{no}
\precision{1000}

\integer{n00=randint(0..1)}
\real{u0=randint(1..100)/10}
\real{q=1}\while{\q=1}{\real{q=randint(1..80)/40}}
\integer{nn=randint(5..10)}\integer{n=\n00+\nn}
\integer{i=randint(1..8)}
\real{s1=randitem(500,550,600,650,700,750,800,850,900,950,1000)}
\real{s2=randitem(0.1,0.05,0.01,0.005,0.001)}

\if{\q>1 and \i>=7}{\integer{i=8} \real{s=\s1}}
\if{\q<1 and \i>=7}{\integer{i=7} \real{s=\s2}}
\if{\i<7}{\real{s=\n}}


\text{algo1=
<table class="algo">
<tr class="traitement"><th></th><td>  <span class="ielem">Pour</span> k <span class="ielem">de</span> 1 <span class="ielem">à</span> \n </td></tr>
<tr class="traitement"><th></th><td> &nbsp; &nbsp; u <span class="ielem">&larr;</span> \u0</td></tr>
<tr class="traitement"><th></th><td>  &nbsp; &nbsp; <span class="ielem">Afficher</span> u </td></tr>
<tr class="traitement"><th></th><td>  &nbsp; &nbsp; u <span class="ielem">&larr;<span> \q &times; u </td></tr>
<tr class="traitement"><th></th><td>  <span class="ielem">Fin Pour</span> </td></tr>
</table>
}

