\text{algo7=
<table class="algo">
<tr class="init"><th>Initialisation</th><td> u <span class="ielem">&larr;</span> \u0</td></tr>
<tr class="init"><th></th><td> n <span class="ielem">&larr;</span> \n00 </td></tr>
<tr class="traitement"><th>Traitement</th><td>  <span class="ielem">Tant que </span> u > \s </td></tr>
<tr class="traitement"><th></th><td>  &nbsp; &nbsp; u <span class="ielem">&larr;</span> \q &times; u </td></tr>
<tr class="traitement"><th></th><td>  &nbsp; &nbsp; n <span class="ielem">&larr;</span> n+1 </td></tr>
<tr class="traitement"><th></th><td>  <span class="ielem">Fin Tant que</span> </td></tr>
