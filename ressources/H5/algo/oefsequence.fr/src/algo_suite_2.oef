\title{Algorithme de recherche du terme d'une suite (2)}
\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}
\css{<style>.blue {color:blue;}</style>}

\integer{a=randint(-10..10)}
\if{\a=0}{\integer{a=13}}

\integer{c=randint(-10..10)}
\if{\c=0}{\integer{c=13}}\if{\c=-1}{\text{c=-}}\if{\c=1}{\text{\c=}}


\integer{b=randint(1..10)}
\text{sb=-,+}\integer{s=randint(1..2)}

\text{tg=\frac{\a}{k},\frac{\a}{k^2},\frac{\c k}{k+\b},\c k,
\c k^2,\c k^3,\c k\sb[\s]\b,\c\cos(k) ,\c\sqrt{k},(\c k\sb[\s]\b)^2}

\test{taille_etiquette=300x50}

\integer{i=randint(1..10)}


\text{reponse=
<span class="ielem">demander</span> n,
u <span class="ielem">&larr;</span> 0,
<span class="ielem">Pour</span> k <span class="ielem">allant de</span> 1 <span class="ielem">à</span> n,
u <span class="ielem">&larr;</span> \(u+(\tg[\i])),
<span class="ielem">fin Pour</span>,
<span class="ielem">afficher</span> u}


\statement{
<div id="enonce">
On considère la suite \((u_{n})) définie, pour tout entier n>0, par
 
\(\displaystyle{u_{n}=\sum_{k=1}^{n}(\tg[\i])}).
</div>
 
<div class="question">
Écrire un algorithme permettant de calculer le terme \(u_n).

<p class="consigne">
L'utilisateur rentre la valeur de n et l'ordinateur affiche la valeur \(u_n).
</p>


<div class="reponse">

<table class="algo">
<tr class="entree"><th >Entrée</th><td>\embed{r1,300x50}</td></tr>
<tr class="init"><th>Initialisation</th><td>\embed{r2,\300x50}</td></tr>
<tr class="traitement"><th>Traitement</th><td>\embed{r3,300x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r4,300x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r5,300x50}</td></tr>
<tr class="sortie"><th>Sortie</th><td>\embed{r6,300x50}</td></tr>
</table>
</div>
</div>
}


\answer{}{\rep1;\reponse[1]}{type=clickfill}{option=shuffle}

\answer{}{\rep2;\reponse[2]}{type=clickfill}{option=shuffle}

\answer{}{\rep3;\reponse[3]}{type=clickfill}{option=shuffle}

\answer{}{\rep4;\reponse[4]}{type=clickfill}{option=shuffle}

\answer{}{\rep5;\reponse[5]}{type=clickfill}{option=shuffle}

\answer{}{\rep6;\reponse[6]}{type=clickfill}{option=shuffle}

\text{repeleve=\rep1,\rep2,\rep3,\rep4,\rep5,\rep6}
\text{test=\repeleve issametext \reponse?1:0}
\condition{Votre réponse est-elle juste ?}{\test=1}
\solution{
<table class="algo">
<tr class="entree"><th >Entrée</th><td>\reponse[1]</td></tr>
<tr class="init"><th>Initialisation</th><td>\reponse[2]</td></tr>
<tr class="traitement"><th>Traitement</th><td>\reponse[3]</td></tr>
<tr class="traitement"><th></th><td>\reponse[4]</td></tr>
<tr class="traitement"><th></th><td>\reponse[5]</td></tr>
<tr class="sortie"><th>Sortie</th><td>\reponse[6]</td></tr>
</table>}
