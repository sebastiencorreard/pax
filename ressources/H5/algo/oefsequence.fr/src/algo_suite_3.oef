\title{Algorithme de recherche du terme d'une suite (3)}
\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}
\integer{a=randint(2..10)}

\integer{b=randint(1..10)}
\text{sb=+,-} 
\integer{s=randint(1..2)}

\text{tg=\frac{\a}{k},
\frac{\a}{k^2},
\frac{\a k}{k+\b},
\a k,
\a k^2,
\a k^3,
\a k\sb[\s]\b,
\sqrt{k+\b},
\a\sqrt{k}\sb[\s]\b,
\a \times k^2\sb[\s]\b k}

\integer{i=randint(1..10)}

\text{reponse1=
 u <span class="ielem">&larr;</span> 0,
 k <span class="ielem">&larr;</span> 1,
 <span class="ielem">Tant que</span> k \(\leq) n,
 u <span class="ielem">&larr;</span> u+\(\tg[\i]),
 k <span class="ielem">&larr;</span> k+1,
<span class="ielem">fin Tant que</span>}

\text{reponse2=
 k <span class="ielem">&larr;</span> 1,
 u <span class="ielem">&larr;</span> 0,
 <span class="ielem">Tant que</span> k \(\leq) n,
 u <span class="ielem">&larr;</span> u+\(\tg[\i]),
 k <span class="ielem">&larr;</span> k+1,
<span class="ielem">fin Tant que</span>}

\statement{
<div id="enonce">
On considère la suite \((u_{n})) définie, pour tout entier n>0, par
\(\displaystyle{u_{n}=\sum_{k=1}^{n}(\tg[\i])}).
</div>

<div class="question">
Écrire un algorithme permettant de calculer le terme \(u_n).

<p class="consigne">
L'utilisateur rentre la valeur de n et l'ordinateur affiche la valeur \(u_n).
</p>

<div class="reponse">

<table class="algo">
<tr class="init"><th>Initialisation</th><td>\embed{r1,200x50}</td></tr>
<tr class="init"><th></th><td>\embed{r2,200x50}</td></tr>
<tr class="traitement"><th>Traitement</th><td>\embed{r3,200x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r4,200x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r5,200x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r6,200x50}</td></tr>
</table>
</div>
</div>
}


\answer{}{\rep1;\reponse1[1]}{type=clickfill}{option=shuffle}
\answer{}{\rep2;\reponse1[2]}{type=clickfill}{option=shuffle}
\answer{}{\rep3;\reponse1[3]}{type=clickfill}{option=shuffle}
\answer{}{\rep4;\reponse1[4]}{type=clickfill}{option=shuffle}
\answer{}{\rep5;\reponse1[5]}{type=clickfill}{option=shuffle}
\answer{}{\rep6;\reponse1[6]}{type=clickfill}{option=shuffle}


\text{rep=\rep1,\rep2,\rep3,\rep4,\rep5,\rep6}

\text{test=\rep issametext \reponse1 or \rep issametext \reponse2?1:0}
\condition{Votre algorithme est-elle juste ?}{\test=1}

\solution{Un algorithme correct est par exemple :
<table class="algo">
<tr class="init"><th>Initialisation</th><td>\reponse1[1]</td></tr>
<tr class="init"><th></th><td>\reponse1[2]</td></tr>
<tr class="traitement"><th>Traitement</th><td>\reponse1[3]</td></tr>
<tr class="traitement"><th></th><td>\reponse1[4]</td></tr>
<tr class="traitement"><th></th><td>\reponse1[5]</td></tr>
<tr class="traitement"><th></th><td>\reponse1[6]</td></tr>
</table>
}
