\title{Lecture et exécution d'un algorithme (1)}
\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}
\integer{a=randint(-10..10)}
\if{\a=0}{\integer{a=13}}
\integer{n=randint(2..5)}

\integer{b=randint(2..10)}
\text{signe=+,-}\integer{i=randint(1..2)}
\text{sb=\signe[\i]}

\integer{ui=randint(-5..5)}

\text{algo= u <span class="ielem">&larr;</span> \ui,
<span class="ielem">Pour</span> k <span class="ielem">allant de</span> 1 <span class="ielem">à</span> \n,
u <span class="ielem">&larr;</span> \a u+\b, <span class="ielem">fin Pour</span>,
<span class="ielem">afficher</span> u}

\integer{sol=\ui}
\for{q=1 to \n }{\integer{sol=\a*\sol+\b}}

\statement{
<div id="enonce">
On considère l'algorithme suivant :


<table class="algo">
  <tr class="init"><th> Initialisation :  </th><td>\algo[1]</td></tr>
  <tr class="traitement"><th> Traitement :      </th><td>\algo[2]</td></tr>
  <tr class="traitement"><th>                   </th><td>&nbsp; &nbsp; \algo[3]</td></tr>
  <tr class="traitement"><th>                   </th><td>\algo[4]</td></tr>
</table>
</div>

<div class="question">
Exécuter cet algorithme \special{help, main,à la main} et donner la valeur de u 
affichée à la sortie.
<div class="reponse">
u=\embed{r1,400x40}
</div>
</div>
}

\answer{La valeur affichée de u est : }{\sol}{type=numeric}
\help{\if{\help_subject issametext main}{
C'est à dire sans utiliser un logiciel ou un programme de calculatrice.}{
On peut faire un tableau où figurent les valeurs des variables.
<table class="wimsborder wimscenter">
<tr><td>k</td><td>u</td></tr>
<tr><td></td><td>\ui</td></tr>
<tr><td>1</td><td>...</td></tr>
<tr><td>2</td><td>...</td></tr>
</table>}
}
