\title{Algorithme de recherche du terme d'une suite (1)}
\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}

\integer{a=randint(2..10)}
\text{signa=+,-}\integer{sa=randint(1..2)}
\integer{b=randint(1..10)}
\text{signb=+,-}\integer{sb=randint(1..2)}
\integer{c=randint(-10..10)}


\text{reponse1=u <span class="ielem">&larr;</span> \c ,
<span class="ielem">Pour</span> k <span class="ielem">allant de</span> 2 <span class="ielem">à</span> n,
u <span class="ielem"> &larr; </span> \(\a u\signb[\sb]\b \),
<span class="ielem">fin Pour</span>}


\statement{
<div id="enonce">
On considère la suite \((u_{n})) définie par 
\(u_1=\c) et \(u_{n+1}=\a u_n\signb[\sb]\b), pour tout entier naturel n.
</div>

<div class="question">
Écrire un algorithme permettant de calculer le terme \(u_n) où n est un entier supérieur où égal à 2.

<p class="consigne">
L'utilisateur rentre la valeur de n et l'ordinateur affiche \(u_n).
</p>

<div class="reponse">
<table class="algo">
<tr class="init"><th>Initialisation</th><td>\embed{r1,200x50}</td></tr>
<tr class="traitement"><th>Traitement</th><td>\embed{r2,200x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r3,200x50}</td></tr>
<tr class="traitement"><th></th><td>\embed{r4,200x50}</td></tr>
</table>
</div>
</div>
}


\answer{}{\rep1;\reponse1[1]}{type=clickfill}{option=shuffle}
\answer{}{\rep2;\reponse1[2]}{type=clickfill}{option=shuffle}
\answer{}{\rep3;\reponse1[3]}{type=clickfill}{option=shuffle}
\answer{}{\rep4;\reponse1[4]}{type=clickfill}{option=shuffle}
\text{reponseleve=\rep1,\rep2,\rep3,\rep4}
\text{test=\reponseleve issametext \reponse1?1:0}
\condition{Votre algorithme est-il correct ?}{\test=1}
\solution{
<table class="algo">
<tr class="init"><th>Initialisation</th><td>\reponse1[1]</td></tr>
<tr class="traitement"><th>Traitement</th><td>\reponse1[2]</td></tr>
<tr class="traitement"><th></th><td>\reponse1[3]</td></tr>
<tr class="traitement"><th></th><td>\reponse1[4]</td></tr>
</table>
}
