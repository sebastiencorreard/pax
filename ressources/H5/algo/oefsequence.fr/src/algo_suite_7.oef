\title{Algorithme de seuil d'une suite géométrique}
\author{Khalid, El Hmouzi}
\email{khalidhmouzi@gmail.com}
\language{fr}
\format{html}\computeanswer{no}
\precision{1000}

\text{code=

def seuil(A):
  n = 0
  u = ??
  while u <A:
    n=n+1
    u=u*2
  print(n,u)
  
  
seuil(??)}
\text{A=slib(runcode [python,[\code]],id1,init theme=[ambiance,neat] fullscreen,Jouer le code)}

\integer{u0=randint(1..10)}
\integer{num=randint(1..10)}\integer{denom=randint(2..10)}
\if{\num=\denom}{\integer{num=\num+1}}
\real{q=\num/\denom}
\integer{n0=randint(0..1)}

\integer{u0=randint(1..10)}
\integer{num=randint(1..10)}\integer{denom=randint(2..10)}
\if{\num=\denom}{\integer{num=\num+1}}
\real{q=\num/\denom}
\integer{n0=randint(0..1)}

\if{\q>1}{\integer{rep1=1}}{\integer{rep1=2}}
\if{\q>1}{\integer{rep2=1}}{\integer{rep2=2}}

\if{\rep2=1}{\text{relation=\ge}}{\text{relation=\le}}
\if{\rep2=1}{\real{val=randint(100..1000)}}{\real{val=10^(randint(-3..-1))}}


\real{u=\u0}\integer{n=\n0}
\if{\rep2=1}{\while{\u<\val}{\real{u=\num/\denom*\u};\integer{n=\n+1}}}
{\while{\u>\val}{\real{u=\num/\denom*\u};\integer{n=\n+1}}}

\if{\q>1}{\text{rep3=\(+\infty)}}{\text{rep3=0}}

\text{algojuste=}
\text{etape=r1,r2,r3}
\nextstep{\etape}


\statement{

<div id="enonce">
On considère la suite \( (U_n) \) définie par \( U_{\n0}=\u0 \) et 
\(U_{n+1}=\frac{\num}{\denom} U_n) pour 
tout entier naturel \if{\n0>0}{\(n \ge 1\)}{\(n\)}.<br><br>
</div>

\if{\step=1}{
<div class="question">
Etudier les variations de cette suite.

<div class="reponse">
Cette suite est géométrique de raison <em>strictement positive</em> \(q\)\embed{r1} 
et de premier terme \( U_{\n0}\) <em> positif</em>. Elle est donc \embed{r2}.<br>
</div>
</div>

<div class="question">
Quelle est sa limite ?
<div class="reponse">
\(\displaystyle{\lim_{n\to+\infty}U_n})=\embed{r3}
</div>
</div>
}

\if{\step=2 and \sc_reply1=1 and \sc_reply2=1 and \sc_reply3=1}{
