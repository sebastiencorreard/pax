\text{code=

u=3
for i in range(1,10):
  print (i,u)
  u=7*u+4}
\text{A=slib(runcode [python,[\code]],id1,init theme=[ambiance,neat] fullscreen,Jouer le code)}

\integer{n=randint(5..10)}
\integer{n0=randint(0..1)}\integer{n00=\n0+1}
\integer{a=randint(2..10)}\integer{b=randint(1..10)}
\text{s=randitem(+,-)}\if{\s=+}{\text{sa=}}{\text{sa=-}}
\text{sb=randitem(+,-)}
\real{u0=randint(-10..10)}

\text{algo=u <span class="ielem">&larr;</span> \u0,
<span class="ielem">Pour</span> n <span class="ielem">allant de</span> 1 <span class="ielem">à</span> \n,
u <span class="ielem">&larr;</span> \sa\a.u \sb\b,
<span class="ielem">fin Pour</span>,
<span class="ielem">afficher</span> u
}

\integer{un=\u0}
\if{\n0=0}{
\for{k=1 to \n}{\real{un=\sa\a*\un\sb\b}}}

\if{\n0=1}{
\for{k=2 to \n}{\real{un=\sa\a*\un\sb\b}}}

\text{etape=r1,r2,r3,r4}
\nextstep{\etape}

\integer{diff=}

\statement{
<div id="enonce">
On considère la suite \( (U_n) \) définie par \( U_{\n0}=\u0 \)  et 
\( U_{n+1}=\sa\a U_n \sb\b \) pour tout entier naturel \if{\n0>0}{\(n \ge 1\)}{\(n\)}.
</div>


\if{\step=1}{
<div class="question">
Compléter l'algorithme suivant permettant de calculer \(U_{\n}\).<br>
<p class="consigne">La notation <span class="ielem">&larr;</span> signifie "prendre la valeur de".</p>
<div class="reponse">

<table class="algo">
<tr class="init"><th>Initialisation</th><td>u<span class="ielem">&larr;</span>\embed{r1,5}</td></tr>
<tr class="traitement"><th>Traitement</th><td><span class="ielem">Pour</span> n <span class="ielem">allant de</span> \embed{r2,5} <span class="ielem">à</span> \embed{r3,5}</td></tr>
<tr class="traitement"><th></th><td>&nbsp;u<span class="ielem">&larr;</span>\embed{r4,20}</td></tr>
<tr class="traitement"><th></th><td><span class="ielem">Fin Pour</span></td></tr>
</table>
</div>
</div>
}


\if{\step=2 and \sc_reply1=1 and \diff=0 and \sc_reply4=1}{

