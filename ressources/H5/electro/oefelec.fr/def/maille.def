!set title=Maille dans un circuit électrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env \lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Voici une maille dans un circuit électrique alimenté en continu&nbsp;	  Quelle est la valeur du potentiel \(U) manquant&nbsp;
val7=!translate internal $	\
$ to ;; in $tmp
val8=Vous devez écrire l'unité.
val9=Il s'agit de valeurs algébriques. Appliquer la loi des noeuds.
tmp0=!randint 5, 8

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10

val11=$[rint($(tmp0))]
val12=0
val13=xrange -2,2.2	  yrange -2,2.2	  polyline black,1,0, 
val14=
!for val15 =1 to $val10 
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val16=$(tmp0)

!ifval $val15<$val10
tmp0=!randint -10, 10

val17=$[rint( $(tmp0))]
!else
val17=$[rint( -($val16)*($val12))]
!endif
val12=$[$val12+($val17)*$val16]
!if $val15=1 
val18=$val17
!else
val18=$val18,$val17
!endif
val13=$val13 cos(2*pi*$val15/$val10),sin(2*pi*$val15/$val10),
!if $val16=1 
val14=$val14	  arrow 1.1*cos(2*pi*($val15+0.3)/$val10),1.1* sin(2*pi*($val15+0.3)/$val10),cos(2*pi*($val15+0.7)/$val10)*1.1,1.1*sin(2*pi*($val15+0.7)/$val10),10,black
!else
val14=$val14	arrow  1.1*cos(2*pi*($val15+0.7)/$val10),1.1* sin(2*pi*($val15+0.7)/$val10),cos(2*pi*($val15+0.3)/$val10)*1.1,1.1*sin(2*pi*($val15+0.3)/$val10),10,black
!endif
!if $val15 <>$val11 

!ifval $val15>$val10/4 and $val15<3*$val10/4
val14= $val14	  text blue, cos(2*pi*($val15+0.5)/$val10)*1.6,sin(2*pi*($val15+0.5)/$val10)*1.6,medium, $val17 V 
!else
val14=	  $val14	  text blue, cos(2*pi*($val15+0.5)/$val10)*1.4,sin(2*pi*($val15+0.5)/$val10)*1.4,medium, $val17 V
!endif
!else
val14=$val14	text red, cos(2*pi*($val15+0.5)/$val10)*1.5,sin(2*pi*($val15+0.5)/$val10)*1.5,medium, U
!endif
!next
tmp0=!item $val11 of $val18

val19=$(tmp0)
replytype1=units
replyname1=\(U)
replygood1=$val19 V
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val9


!goto stat

!exit

:question
$()Voici une maille dans un circuit électrique alimenté en continu :	<div class="wimscenter"> 
!read oef/draw.phtml 200,200 \
$val13	  $val14 
$()	</div>	Quelle est la valeur du potentiel 
!insmath U
$() manquant ?	<div class="wims_instruction">$val8</div>
$()
!exit

:hint
$()$val9
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,13,14
embedcnt=0
