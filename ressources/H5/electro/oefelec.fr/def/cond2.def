tmp0=!item $val20 of $val7

val21=$(tmp0)

!ifval $val20=1 
val22=$[ $val15+$val16+$val17+$val18]
!else
val22=$[(1/$val15+1/$val16+1/$val17+1/$val18)^(-1) ]
!endif
