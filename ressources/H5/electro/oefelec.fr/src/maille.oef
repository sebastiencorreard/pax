\title{Maille dans un circuit électrique}

\text{lang=slib(oef/env \lang)}

\matrix{name_statement=Voici une maille dans un circuit électrique alimenté en continu&nbsp;
  Quelle est la valeur du potentiel \(U) manquant&nbsp;}

\text{name_instruction=Vous devez écrire l'unité.}
\text{name_hint=Il s'agit de valeurs algébriques. Appliquer la loi des noeuds.}

\integer{n=random(5..8)}
\integer{m=randint(1..\n)}
\text{somme=0}
\text{dessin= xrange -2,2.2
  yrange -2,2.2
  polyline black,1,0, }
\text{dessin2=}
\for{i=1 to \n}{
  \text{signe=randitem(1,-1)}
  \integer{U=\i<\n? randint(-10..10): -(\signe)*(\somme)}
  \real{somme=\somme+(\U)*\signe}
  \if{\i=1}{\text{potentiel=\U}}{\text{potentiel=\potentiel,\U}
  }
  \text{dessin=\dessin cos(2*pi*\i/\n),sin(2*pi*\i/\n),}
  \if{\signe=1}{
    \text{dessin2=\dessin2
  arrow 1.1*cos(2*pi*(\i+0.3)/\n),1.1* sin(2*pi*(\i+0.3)/\n),cos(2*pi*(\i+0.7)/\n)*1.1,1.1*sin(2*pi*(\i+0.7)/\n),10,black}
    }
    {\text{dessin2=\dessin2
arrow  1.1*cos(2*pi*(\i+0.7)/\n),1.1* sin(2*pi*(\i+0.7)/\n),cos(2*pi*(\i+0.3)/\n)*1.1,1.1*sin(2*pi*(\i+0.3)/\n),10,black}
    }
  \if{\i <>\m}{\text{dessin2= \i>\n/4 and \i<3*\n/4? \dessin2
  text blue, cos(2*pi*(\i+0.5)/\n)*1.6,sin(2*pi*(\i+0.5)/\n)*1.6,medium, \U V :
  \dessin2
  text blue, cos(2*pi*(\i+0.5)/\n)*1.4,sin(2*pi*(\i+0.5)/\n)*1.4,medium, \U V}
  }
  {\text{dessin2=\dessin2
text red, cos(2*pi*(\i+0.5)/\n)*1.5,sin(2*pi*(\i+0.5)/\n)*1.5,medium, U}
  }
}
\text{rep=item(\m,\potentiel)}
\statement{Voici une maille dans un circuit électrique alimenté en continu :
<div class="wimscenter">\draw{200,200}{\dessin
  \dessin2}
</div>
Quelle est la valeur du potentiel \(U) manquant ?
<div class="wims_instruction">\name_instruction</div>}
\answer{\(U)}{\rep V}{type=units}
\hint{\name_hint}

