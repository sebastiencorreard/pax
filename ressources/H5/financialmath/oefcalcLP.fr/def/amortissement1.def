!set title=Tableau d'amortissement 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
keywords=geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 40, 80

val7=$[$(tmp0)/10]
val8=$[$val7/100]
val9=$[($val7/100)+1]
val10=$[rint($val6*$val8/(1-($val9^(-3)))*100)/100]
val11=$[rint($val6*$val7)/100]
val12=$[$val10-$val11]
val13=$[$val6-$val12]
val14=$[rint($val13*$val7)/100]
val15=$[$val10-$val14]
val16=$[$val13-$val15]
val17=$[$val16]
val18=$[$val10-$val17]
val19=$[$val11+$val14+$val18]
!readproc slib/lang/fname  
tmp0=$slib_out
val20=$(tmp0)
tmp=!trim Année,Capital restant dû,Amortissement,Intérêts,Annuité	1,$val6,$val12,$val11,$val10	2,$val13,$val15,$val14,$val10	3,$val16,$val17,$val18,$val10
val21=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val21],wimscenter wimsborder,TH=[1;1] 
tmp0=$slib_out
val22=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val10]
replytype2=mark
replyoption2=split 
replyname2=2
replygood2=1;constantes, dégressives, progressives, alternatives 
replytype3=mark
replyoption3=split 
replyname3=3
replygood3=2;constants, dégressifs, progressifs, alternatifs
replytype4=numeric
replyoption4=comma 
replyname4=4
replygood4=$[$val19]
replytype5=numeric
replyoption5=comma 
replyname5=5
replygood5=$[$val9]
replytype6=mark
replyoption6=split 
replyname6=6
replygood6=3;constants, dégressifs, progressifs, alternatifs
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val20 emprunte <span class="bold">$val6 &euro;</span> à la banque, au taux de <span class="bold">$val7 %</span> et rembourse son prêt en trois annuités. </p>	$val22			<div class="wims_question">	 <ol>	   <li>Quel est le <label for="reply1">montant d'une annuité</label> ?   
!read oef/embed.phtml reply1,6 
$() </li>	   <li>Les annuités sont <span class="bold"> 
!read oef/embed.phtml reply2,13 
$()</span> (cliquer sur la bonne réponse) </li>	   <li>Les intérêts sont<span class="bold"> 
!read oef/embed.phtml reply3,13 
$()</span> (cliquer sur la bonne réponse)</li>	   <li>Les amortissements sont<span class="bold"> 
!read oef/embed.phtml reply6,13 
$()</span> (cliquer sur la bonne réponse)</li>	   <li>Les amortissements forment une <span class="bold">suite géométrique</span>,	   quelle en est la <label for="reply5">raison</label> ?  
!read oef/embed.phtml reply5,6 
$()</li>	   <li>Quel est le <label for="reply4">coût du prêt</label>?  
!read oef/embed.phtml reply4,6 
$()</li>	 </ol>	</div>		
$()
!exit

