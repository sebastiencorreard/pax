!set title=Les soldes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=Norbert.Rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 35, 55

val6=$[rint($(tmp0)*10 )]
tmp0=!randint 3, 6

val7=$[rint($(tmp0)*10 )]
tmp0=!randint 20, 30

val8=$[rint($(tmp0)*10 )]
val9=$[$val6*$val7/100]
val10=$[$val6-$val9]

!ifval $val10<=$val8
val11=1
!else
val11=2
!endif
replytype1=numeric
replyoption1=comma 
replyname1=
replygood1=$[$val9 ]
replytype2=numeric
replyoption2=comma 
replyname2=
replygood2=$[$val10]
replytype3=radio
replyname3=
replygood3=$val11;oui je peux m'offrir l'enceinte,non je ne peux pas m'offrir l'enceinte,je ne peux pas savoir
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="flex_box">	   <div> 
!read oef/img.phtml $val1/solde.jpg alt="panneau soldes" 
$()</div>	  <div> C'est enfin la période des soldes, l'enceinte Bluetooth de mes rêves est à -$val7 %.<br>	  Durant les fêtes de fin d'année j'ai obtenu $val8 &euro; d'étrennes. <br> Le prix hors soldes	  de l'enceinte est de $val6 &euro;.</div>	  <div> 
!read oef/img.phtml $val1/enceinte.jpg alt="enceinte audio" 
$()</div>	</div>	<p class="center bold"><span class="wims_emph">Problématique : </span> Vais-je pouvoir m'offrir cette enceinte uniquement avec mes étrennes?</p>	<div class="wims_question">	<ol>	  <li> Quel est le montant de la réduction ?	    <div class="wimscenter">Le <label for="reply1">montant de la réduction</label> est de :	     
!read oef/embed.phtml reply1,5 
$() &euro;</div></li>	  <li> Quel est le prix soldé de l'enceinte ?	    <div class="wimscenter">Le <label for="reply2">prix soldé de l'enceinte</label> est de  
!read oef/embed.phtml reply2,5 
$() &euro;</div></li>	  <li> Mes étrennes sont-elles suffisantes ?	    <div class="wimscenter"> 
!read oef/embed.phtml reply3 
$()</div></li>	</ol>	</div>	
$()
!exit

