!set title=Amortissements constants
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert, Rey
email=norbert.rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 3, 10

val7=$[$(tmp0)]
val8=$[rint(($val6/$val7)*100)/100]
tmp0=!randint 40, 80

val9=$[$(tmp0)/10]
!readproc slib/lang/fname  
tmp0=$slib_out
val10=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val10 emprunte à la banque la somme de <span class="bold">$val6 &euro;</span>	  sur <strong>$val7</strong> ans, au taux de <span class="bold">$val9 %</span>	  et à amortissements constants.	</p>		<p class="wims_question"> Quelle est le <label for="reply1">montant annuel de l'amortissement</label> ?  
!read oef/embed.phtml reply1,6 
$() &euro; </p>	<div class="wims_instruction">Arrondir si besoin le résultat à 2 décimales.</div>	
$()
!exit

:hint
$()Formule pour le calcul de l'amortissement constant <strong>
!insmath A 
$()</strong>, d'un capital emprunté <strong>
!insmath C 
$()</strong> à un taux <strong>
!insmath t
$()</strong> pendant <strong>
!insmath n
$() </strong>périodes : 
!insmath A= C/n
$() pour chaque période. 
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10
embedcnt=1
