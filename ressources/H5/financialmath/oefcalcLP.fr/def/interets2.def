!set title=Intérêts composés
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
keywords=geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname  
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 100, 200

val7=$[rint($(tmp0)*100)]
tmp0=!randint 5, 15

val8=$[rint($(tmp0))]
tmp0=!randint 20, 40

val9=$[$(tmp0)/10]
val10=$[18-$val8]
val11=$[rint(100*$val7 * (1+($val9)/100)^($val10))/100]
val12=$[$val11-$val7]
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val10]
replytype2=numeric
replyoption2=comma 
replyname2=2
replygood2=$[$val11]
replytype3=numeric
replyoption3=comma 
replyname3=3
replygood3=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_right"> 
!read oef/img.phtml $val1/argent.jpg alt="billets en &euro;" 
$()</div>	<p>$val6 vient de toucher une somme de $val7 &euro; lors d'un héritage. $val6 ayant seulement $val8 ans,	ses parents décident de placer cette somme en attendant sa majorité.	La banque leur propose un placement à intérêts composés au taux annuel de $val9 % pour cette période.	</p>	<br class="clearall">	<div class="wims_question">	<ul>	  <li>Quelle sera la <label for="reply1">durée du placement</label> ?  
!read oef/embed.phtml reply1,5 
$() ans </li>	  <li>Quelle sera la <label for="reply2">valeur acquise par le capital</label>	  au bout de la période ?  
!read oef/embed.phtml reply2, 8 
$() &euro; </li>	  <li>Quel sera le <label for="reply3">montant total des intérêts</label> ?  
!read oef/embed.phtml reply3,5 
$() &euro;	  </li>	</ul>	</div>	<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,7,8,9
embedcnt=3
