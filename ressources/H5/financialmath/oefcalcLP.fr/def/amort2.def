!set title=Annuités constantes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert, Rey
email=norbert.rey@ac-lyon.fr
keywords=geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 40, 80

val7=$[$(tmp0)/10]
val8=$[$val7/100]
val9=$[($val7/100)+1]
tmp0=!randint 3, 10

val10=$[$(tmp0)]
val11=$[rint($val6*$val8/(1-($val9^(-$val10)))*100)/100]
!readproc slib/lang/fname  
tmp0=$slib_out
val12=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<p>$val12 emprunte <span class="bold">$val6 &euro;</span> à la banque,	  au taux de <span class="bold">$val7 %</span>, et rembourse cette somme en	  <strong>$val10</strong> annuités constantes.</p>		<p class="wims_question"> Quel est le <label for="reply1">montant d'une annuité</label>?	   
!read oef/embed.phtml reply1,6 
$() &euro;</p>	<div class="wims_instruction">Arrondir si besoin le résultat à 2 décimales.</div>	
$()
!exit

:hint
$()Formule pour le calcul de l'annuité constante <strong>
!insmath a
$() </strong> d'un capital emprunté <strong>
!insmath C 
$()</strong> à un taux <strong>
!insmath t
$()</strong> pendant <strong>
!insmath n
$() </strong> ans :	
!insmath a= C*(t/(1-(1+t)^-n)) 
$() 
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,12
embedcnt=1
