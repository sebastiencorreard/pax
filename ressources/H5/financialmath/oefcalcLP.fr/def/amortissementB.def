!set title=Tableau d'amortissement B
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 3, 10

val7=$[$(tmp0)]
tmp0=!randint 40, 80

val8=$[$(tmp0)/10]
val9=$[rint(($val6/3)*100)/100]
val10=$[$val6-$val9]
val11=$[$val10-$val9]
val12=$[rint(($val6*$val8/100)*100)/100]
val13=$[rint(($val10*$val8/100)*100)/100]
val14=$[rint(($val11*$val8/100)*100)/100]
val15=$[$val9+$val12]
val16=$[$val9+$val13]
val17=$[$val11+$val14]
val18=$[$val12+$val13+$val14]
!readproc slib/lang/fname  
tmp0=$slib_out
val19=$(tmp0)
tmp=!trim Année,Capital restant dû,Amortissement,Intérêts,Annuité	1,$val6,$val9,reply1,$val15	2,$val10,$val9,$val13,reply2	3,$val11,reply3,$val14,reply4
val20=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val20],wimscenter wimsborder,TH=[1;1] 
tmp0=$slib_out
val21=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val12]
replytype2=numeric
replyoption2=comma 
replyname2=2
replygood2=$[$val16]
replytype3=numeric
replyoption3=comma 
replyname3=3
replygood3=$[$val11]
replytype4=numeric
replyoption4=comma 
replyname4=4
replygood4=$[$val17]
replytype5=numeric
replyoption5=comma 
replyname5=5
replygood5=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val19 emprunte <span class="bold">$val6 &euro;</span> à la banque, au taux de <span class="bold">$val8 %</span> et rembourse son prêt en trois annuités à amortissements constants. </p>	<p class="wimscenter bold"> Compléter le tableau</p>	 
!read oef/special.phtml codeinput [$val21], 6,div	reply1	reply2	reply3	reply4		 
$()		<p class="wims_question"> Quel est le<label for="reply5">coût du prêt</label> ?  
!read oef/embed.phtml reply5,6 
$() € </p>	<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>		
$()
!exit

