replygood14=$[$val19]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val20 emprunte <span class="bold">
!insmath $val6
$() &euro;</span> à la banque, au taux de <span class="bold">
!insmath $val7
$() % </span> et rembourse son prêt en trois annuités constantes. </p>		
!if  $m_step = 1  
$()		<p class="wims_question"> Quel est le <label for="reply1">montant d'une annuité</label>?  
!read oef/embed.phtml reply1,6 
$() &euro; </p>	 
!endif
$()		
!if  $m_step = 2  
$()	<p class="oef_indgood">Bonne réponse, le montant d'une annuité est effectivement $val10 &euro; </p>	<p class="wimscenter bold"> Compléter le tableau</p>		 
!read oef/special.phtml codeinput [$val22], 6,div	reply2	reply3	reply4	reply5	reply6	reply7	reply8	reply9	reply10	reply11	reply12	reply13	 
$()		 
!endif
$()		
!if  $m_step = 3  
$()		<p class="oef_indgood">Très bien, les intérêts payés chaque année sont bien : 
!insmath I1 = $val11
$() &euro; , 
!insmath I2 = $val14 
$() &euro; et 
!insmath I3 = $val18 
$()&euro; </p>		<p class="wims_question"> Quel est le <label for="reply14">coût du prêt</label> ?  
!read oef/embed.phtml reply14,6 
$() &euro; </p>	 
!endif
$()	<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>	
$()
!exit

:hint
$()Formule pour le calcul de l'annuité constante <strong>
!insmath a
$() </strong> d'un capital emprunté <strong>
!insmath C 
$()</strong> à un taux <strong>
!insmath t
$()</strong> pendant <strong>
!insmath n
$() </strong> ans : 
!insmath a= C*(t/(1-(1+t)^-n)) 
$() 
$()
