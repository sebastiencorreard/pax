!set title=Tableau d’amortissement 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
keywords=geometric_sequence
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=14
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 40, 80

val7=$[$(tmp0)/10]
val8=$[$val7/100]
val9=$[($val7/100)+1]
val10=$[rint($val6*$val8/(1-($val9^(-3)))*100)/100]
val11=$[rint($val6*$val7)/100]
val12=$[$val10-$val11]
val13=$[$val6-$val12]
val14=$[rint($val13*$val7)/100]
val15=$[$val10-$val14]
val16=$[$val13-$val15]
val17=$[$val16]
val18=$[$val10-$val17]
val19=$[$val11+$val14+$val18]
!readproc slib/lang/fname  
tmp0=$slib_out
val20=$(tmp0)
tmp=!trim Année,Capital restant dû,Amortissement,Intérêts,Annuité	1,reply2,reply3,reply4,reply5	2,reply6,reply7,reply8,reply9	3,reply10,reply11,reply12,reply13
val21=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val21],wimscenter wimsborder,TH=[1;1] 
tmp0=$slib_out
val22=$(tmp0)
oefsteps=reply1	  reply2, reply3, reply4, reply5, reply6, reply7, reply8, reply9, reply10, reply11, reply12, reply13	  reply14 
nextstep=!nosubst reply1	  reply2, reply3, reply4, reply5, reply6, reply7, reply8, reply9, reply10, reply11, reply12, reply13	  reply14 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val10]
