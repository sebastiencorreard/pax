replyoption2=comma 
replyname2=2
replygood2=$[$val6]
replytype3=numeric
replyoption3=comma 
replyname3=3
replygood3=$[$val12]
replytype4=numeric
replyoption4=comma 
replyname4=4
replygood4=$[$val11]
replytype5=numeric
replyoption5=comma 
replyname5=5
replygood5=$[$val10]
replytype6=numeric
replyoption6=comma 
replyname6=6
replygood6=$[$val13]
replytype7=numeric
replyoption7=comma 
replyname7=7
replygood7=$[$val15]
replytype8=numeric
replyoption8=comma 
replyname8=8
replygood8=$[$val14]
