val16=$[$val9+$val13]
val17=$[$val11+$val14]
val18=$[$val12+$val13+$val14]
!readproc slib/lang/fname  
tmp0=$slib_out
val19=$(tmp0)
tmp=!trim Année,Capital restant dû,Amortissement,Intérêts,Annuité	1,$val6,reply1,reply2,reply3	2,reply4,reply5,reply6,reply7	3,reply8,reply9,reply10,reply11
val20=!translate internal $	\
$ to ;; in $tmp
!readproc slib/text/matrixhtml [$val20],wimscenter wimsborder,TH=[1;1] 
