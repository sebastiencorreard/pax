!set title=Tableau d'amortissement A
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=norbert.rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 50, 90

val6=$[rint($(tmp0)*100)]
tmp0=!randint 3, 10

val7=$[$(tmp0)]
tmp0=!randint 40, 80

val8=$[$(tmp0)/10]
val9=$[rint(($val6/3)*100)/100]
val10=$[$val6-$val9]
val11=$[$val10-$val9]
val12=$[rint(($val6*$val8/100)*100)/100]
val13=$[rint(($val10*$val8/100)*100)/100]
val14=$[rint(($val11*$val8/100)*100)/100]
val15=$[$val9+$val12]
val16=$[$val9+$val13]
val17=$[$val11+$val14]
val18=$[$val12+$val13+$val14]
!readproc slib/lang/fname  
tmp0=$slib_out
val19=$(tmp0)
!readproc slib/text/matrixhtml	      [année,Capital restant dû,amortissement,intérêt,annuité;	      1,$val6,$val9,$val12,$val15;	      2,$val10,$val9,$val13,$val16;	      3,$val11,$val11,$val14,$val17],1 wimscenter wimsborder,TH=[1;1]  
tmp0=$slib_out
val20=$(tmp0)
replytype1=numeric
replyoption1=comma 
replyname1=1
replygood1=$[$val15]
replytype2=mark
replyoption2=split 
replyname2=2
replygood2=2;constantes, dégressives, progressives, alternatives 
replytype3=mark
replyoption3=split 
replyname3=3
replygood3=2;constants, dégressifs, progressifs, alternatifs 
replytype4=mark
replyoption4=split 
replyname4=4
replygood4=1;constants, dégressifs, progressifs, alternatifs 
replytype5=numeric
replyoption5=comma 
replyname5=5
replygood5=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val19 emprunte <span class="bold">$val6 &euro;</span> à la banque,	au taux de <span class="bold">$val8 %</span> et rembourse son prêt en trois annuités.</p>	$val20		<div class="wims_question">	 <ol>	   <li>Quel est le <label for="reply1">montant de la première annuité</label>?  
!read oef/embed.phtml reply1,6 
$() &euro;</li>	   <li> Les annuités sont <span class="bold"> 
!read oef/embed.phtml reply2,13 
$()</span> (cliquer sur la bonne réponse) </li>	   <li>Les intérêts sont <span class="bold"> 
!read oef/embed.phtml reply3,13 
$()</span> (cliquer sur la bonne réponse)</li>	   <li>Les amortissements sont <span class="bold"> 
!read oef/embed.phtml reply4,13 
$()</span> (cliquer sur la bonne réponse)</li>	   <li>Quel est le <label for="reply5">coût du prêt</label>?  
!read oef/embed.phtml reply5,6 
$() &euro;</li>	</ol>	</div>		
$()
!exit

