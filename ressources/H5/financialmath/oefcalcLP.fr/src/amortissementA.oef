\title{Tableau d'amortissement A}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{C1=randint(50..90)*100}
\real{n=randint(3..10)}
\real{t=randint(40..80)/10}
\real {A=rint((\C1/3)*100)/100}
\real {C2=\C1-\A}
\real {C3=\C2-\A}
\real {I1=rint((\C1*\t/100)*100)/100}
\real {I2=rint((\C2*\t/100)*100)/100}
\real {I3=rint((\C3*\t/100)*100)/100}
\real {a1=\A+\I1}
\real {a2=\A+\I2}
\real {a3=\C3+\I3}
\real {IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}

\text{tab=slib(text/matrixhtml
      [année,Capital restant dû,amortissement,intérêt,annuité;
      1,\C1,\A,\I1,\a1;
      2,\C2,\A,\I2,\a2;
      3,\C3,\C3,\I3,\a3],1 wimscenter wimsborder,TH=[1;1] )}

\statement{
<p>\prenom emprunte <span class="bold">\C1 &euro;</span> à la banque,
au taux de <span class="bold">\t %</span> et rembourse son prêt en trois annuités.</p>
\tab

<div class="wims_question">
 <ol>
   <li>Quel est le <label for="reply1">montant de la première annuité</label>? \embed{reply1,6} &euro;</li>
   <li> Les annuités sont <span class="bold">\embed{reply2,13}</span> (cliquer sur la bonne réponse) </li>
   <li>Les intérêts sont <span class="bold">\embed{reply3,13}</span> (cliquer sur la bonne réponse)</li>
   <li>Les amortissements sont <span class="bold">\embed{reply4,13}</span> (cliquer sur la bonne réponse)</li>
   <li>Quel est le <label for="reply5">coût du prêt</label>? \embed{reply5,6} &euro;</li>
</ol>
</div>

}

\answer{1}{\a1}{type=numeric}{option=comma}
\answer{2}{2;constantes, dégressives, progressives, alternatives }{type=mark}{option=split}
\answer{3}{2;constants, dégressifs, progressifs, alternatifs }{type=mark}{option=split}
\answer{4}{1;constants, dégressifs, progressifs, alternatifs }{type=mark}{option=split}

\answer{5}{\IT}{type=numeric}{option=comma}
