\title{Tableau d’amortissement 4}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{geometric_sequence}

\integer{E1=randint(50..90)*100}
\real{t1=randint(40..80)/10}
\real{t2=\t1/100}
\real{K2=(\t1/100)+1}
\real {a=rint(\E1*\t2/(1-(\K2^(-3)))*100)/100}
\real{I1=rint(\E1*\t1)/100}
\real{A1=\a-\I1}
\real{E2=\E1-\A1}
\real{I2=rint(\E2*\t1)/100}
\real{A2=\a-\I2}
\real{E3=\E2-\A2}
\real{A3=\E3}
\real{I3=\a-\A3}
\real{IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}

\hint{Formule pour le calcul de l'annuité constante <strong>\(a) </strong> d'un capital emprunté <strong>\(C )</strong> à un taux <strong>\(t)</strong> pendant <strong>\(n) </strong> ans : \(a= C*(t/(1-(1+t)^-n)) ) }

\steps{
  reply1
  reply2, reply3, reply4, reply5, reply6, reply7, reply8, reply9, reply10, reply11, reply12, reply13
  reply14
}

\matrix{matrice=
Année,Capital restant dû,Amortissement,Intérêts,Annuité
1,reply2,reply3,reply4,reply5
2,reply6,reply7,reply8,reply9
3,reply10,reply11,reply12,reply13}
\text{tab=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;1])}

\statement{
<p>\prenom emprunte <span class="bold">\(\E1\) &euro;</span> à la banque, au taux de <span class="bold">\(\t1\) % </span> et rembourse son prêt en trois annuités constantes. </p>

\if{ \step = 1 } {

<p class="wims_question"> Quel est le <label for="reply1">montant d'une annuité</label>? \embed{reply1,6} &euro; </p>
}

\if{ \step = 2 }{
<p class="oef_indgood">Bonne réponse, le montant d'une annuité est effectivement \a &euro; </p>
<p class="wimscenter bold"> Compléter le tableau</p>

\special{codeinput [\tab], 6,div
reply2
reply3
reply4
reply5
reply6
reply7
reply8
reply9
reply10
reply11
reply12
reply13
}

}

\if{ \step = 3 }{

<p class="oef_indgood">Très bien, les intérêts payés chaque année sont bien : \(I1 = \I1\) &euro; , \(I2 = \I2 \) &euro; et \(I3 = \I3 \)&euro; </p>

<p class="wims_question"> Quel est le <label for="reply14">coût du prêt</label> ? \embed{reply14,6} &euro; </p>
}
<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>
}

\answer{1}{\a}{type=numeric}{option=comma}
\answer{2}{\E1}{type=numeric}{option=comma}
\answer{3}{\A1}{type=numeric}{option=comma}
\answer{4}{\I1}{type=numeric}{option=comma}
\answer{5}{\a}{type=numeric}{option=comma}
\answer{6}{\E2}{type=numeric}{option=comma}
\answer{7}{\A2}{type=numeric}{option=comma}
\answer{8}{\I2}{type=numeric}{option=comma}
\answer{9}{\a}{type=numeric}{option=comma}
\answer{10}{\E3}{type=numeric}{option=comma}
\answer{11}{\A3}{type=numeric}{option=comma}
\answer{12}{\I3}{type=numeric}{option=comma}
\answer{13}{\a}{type=numeric}{option=comma}
\answer{14}{\IT}{type=numeric}{option=comma}
