\title{Tableau d'amortissement C}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{C1=randint(50..90)*100}
\real{n=randint(3..10)}
\real{t=randint(40..80)/10}
\real {A=rint((\C1/3)*100)/100}
\real {C2=\C1-\A}
\real {C3=\C2-\A}
\real {I1=rint((\C1*\t/100)*100)/100}
\real {I2=rint((\C2*\t/100)*100)/100}
\real {I3=rint((\C3*\t/100)*100)/100}
\real {a1=\A+\I1}
\real {a2=\A+\I2}
\real {a3=\C3+\I3}
\real {IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}

\matrix{matrice=
Année,Capital restant dû,Amortissement,Intérêts,Annuité
1,\C1,reply1,reply2,reply3
2,reply4,reply5,reply6,reply7
3,reply8,reply9,reply10,reply11}
\text{tab=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;1])}

\statement{
<p>\prenom emprunte <span class="bold">\C1 &euro;</span> à la banque, au taux de <span class="bold">\t %</span>
et rembourse son prêt en trois annuités à amortissements constants. </p>
<p class="wimscenter bold"> Compléter le tableau</p>
\special{codeinput [\tab], 6,div
reply1
reply2
reply3
reply4
reply5
reply6
reply7
reply8
reply9
reply10
reply11
}

<p class="wims_question"> Quel est le <label for="reply12">coût du prêt</label> ? \embed{reply12,6} &euro; </p>
}

\answer{1}{\A}{type=numeric}{option=comma}
\answer{2}{\I1}{type=numeric}{option=comma}
\answer{3}{\a1}{type=numeric}{option=comma}
\answer{4}{\C2}{type=numeric}{option=comma}
\answer{5}{\A}{type=numeric}{option=comma}
\answer{6}{\I2}{type=numeric}{option=comma}
\answer{7}{\a2}{type=numeric}{option=comma}
\answer{8}{\C3}{type=numeric}{option=comma}
\answer{9}{\C3}{type=numeric}{option=comma}
\answer{10}{\I3}{type=numeric}{option=comma}
\answer{11}{\a3}{type=numeric}{option=comma}
\answer{11}{\IT}{type=numeric}{option=comma}
