\title{Annuités constantes}
\language{fr}
\range{-5..5}
\author{Norbert, Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{geometric_sequence}

\integer{E1=randint(50..90)*100}
\real{t1=randint(40..80)/10}
\real{T1=\t1/100}
\real{K1=(\t1/100)+1}
\real{n=randint(3..10)}
\real {a=rint(\E1*\T1/(1-(\K1^(-\n)))*100)/100}
\text{prenom=slib(lang/fname )}

\hint{Formule pour le calcul de l'annuité constante <strong>\(a) </strong> d'un capital emprunté <strong>\(C )</strong> à un taux <strong>\(t)</strong> pendant <strong>\(n) </strong> ans :
\(a= C*(t/(1-(1+t)^-n)) ) }

\statement{

<p>\prenom emprunte <span class="bold">\E1 &euro;</span> à la banque,
  au taux de <span class="bold">\t1 %</span>, et rembourse cette somme en
  <strong>\n</strong> annuités constantes.</p>

<p class="wims_question"> Quel est le <label for="reply1">montant d'une annuité</label>?
  \embed{reply1,6} &euro;</p>
<div class="wims_instruction">Arrondir si besoin le résultat à 2 décimales.</div>
}

\answer{1}{\a}{type=numeric}{option=comma}
