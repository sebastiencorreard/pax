\title{Amortissements constants}
\language{fr}
\range{-5..5}
\author{Norbert, Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{E1=randint(50..90)*100}
\real{n=randint(3..10)}
\real {A=rint((\E1/\n)*100)/100}
\real{t1=randint(40..80)/10}
\text{prenom=slib(lang/fname )}

\hint{Formule pour le calcul de l'amortissement constant <strong>\(A )</strong>, d'un capital emprunté <strong>\(C )</strong> à un taux <strong>\(t)</strong> pendant <strong>\(n) </strong>périodes : \(A= C/n) pour chaque période. }

\statement{
<p>\prenom emprunte à la banque la somme de <span class="bold">\E1 &euro;</span>
  sur <strong>\n</strong> ans, au taux de <span class="bold">\t1 %</span>
  et à amortissements constants.
</p>

<p class="wims_question"> Quelle est le <label for="reply1">montant annuel de l'amortissement</label> ? \embed{reply1,6} &euro; </p>
<div class="wims_instruction">Arrondir si besoin le résultat à 2 décimales.</div>
}

\answer{1}{\A}{type=numeric}{option=comma}
