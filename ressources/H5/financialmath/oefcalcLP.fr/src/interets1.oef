\title{Intérêts simples}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{v1=slib(lang/fname )}
\integer{v2=randint(100..200)*100}
\integer{v3=randint(5..15)}
\real{v4=randint(20..60)/10}
\real{x1=rint(\v2*\v3*\v4/12)/100}
\real{x2=\v2+\x1}

\statement{
<div class="float_right">\img{\imagedir/placement.jpg}{alt="de l'argent et une tirelire"}</div>
<p>\v1 vient de gagner une somme de \v2 &euro; lors d'une loterie. Cette somme lui servira dans
  \v3 mois pour monter son entreprise. En attendant, sa banque lui propose de placer ces \v2 &euro;
  au taux annuel de \v4 % à intérêts simples.
</p>
<div class="wims_question">
<ul>
  <li>Quel sera le <label for="reply1">montant des intérêts</label> au bout des \v3 mois ? \embed{reply1,5}€ </li>
  <li>Quelle sera la <label for="reply2">valeur acquise par le capital</label> en fin de placement ?
  \embed{reply2,5}&euro;</li>
</ul>
</div>
<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>
}

\answer{1}{\x1}{type=numeric}{option=comma}
\answer{2}{\x2}{type=numeric}{option=comma}
