\title{Tableau d'amortissement B}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{C1=randint(50..90)*100}
\real{n=randint(3..10)}
\real{t=randint(40..80)/10}
\real {A=rint((\C1/3)*100)/100}
\real {C2=\C1-\A}
\real {C3=\C2-\A}
\real {I1=rint((\C1*\t/100)*100)/100}
\real {I2=rint((\C2*\t/100)*100)/100}
\real {I3=rint((\C3*\t/100)*100)/100}
\real {a1=\A+\I1}
\real {a2=\A+\I2}
\real {a3=\C3+\I3}
\real {IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}
\matrix{matrice=
Année,Capital restant dû,Amortissement,Intérêts,Annuité
1,\C1,\A,reply1,\a1
2,\C2,\A,\I2,reply2
3,\C3,reply3,\I3,reply4}
\text{tab=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;1])}

\statement{
<p>\prenom emprunte <span class="bold">\C1 &euro;</span> à la banque, au taux de <span class="bold">\t %</span> et rembourse son prêt en trois annuités à amortissements constants. </p>
<p class="wimscenter bold"> Compléter le tableau</p>
\special{codeinput [\tab], 6,div
reply1
reply2
reply3
reply4

}

<p class="wims_question"> Quel est le<label for="reply5">coût du prêt</label> ? \embed{reply5,6} € </p>
<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>

}

\answer{1}{\I1}{type=numeric}{option=comma}
\answer{2}{\a2}{type=numeric}{option=comma}
\answer{3}{\C3}{type=numeric}{option=comma}
\answer{4}{\a3}{type=numeric}{option=comma}
\answer{5}{\IT}{type=numeric}{option=comma}
