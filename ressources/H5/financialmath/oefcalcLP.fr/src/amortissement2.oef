\title{Tableau d'amortissement 2}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{geometric_sequence}

\integer{E1=randint(50..90)*100}
\real{t1=randint(40..80)/10}
\real{t2=\t1/100}
\real{K2=(\t1/100)+1}
\real {a=rint(\E1*\t2/(1-(\K2^(-3)))*100)/100}
\real{I1=rint(\E1*\t1)/100}
\real{A1=\a-\I1}
\real{E2=\E1-\A1}
\real{I2=rint(\E2*\t1)/100}
\real{A2=\a-\I2}
\real{E3=\E2-\A2}
\real{A3=\E3}
\real{I3=\a-\A3}
\real{IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}
\matrix{matrice=
Année,Capital restant dû,Amortissement,Intérêts,Annuité
1,\E1,reply1,\I1,\a
2,\E2,\A2,reply2,\a
3,reply3,reply4,reply5,reply6}
\text{tab=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;1])}

\statement{
<p>\prenom emprunte <span class="bold">\E1 &euro;</span> à la banque, au taux de <span class="bold">\t1 %</span> et rembourse son prêt en trois annuités constantes. </p>
<p class="wimscenter bold"> Compléter le tableau</p>
\special{codeinput [\tab], 6,div
reply1
reply2
reply3
reply4
reply5
reply6
}

<p class="wims_question"> Quel est le <label for="reply7">coût du prêt </label>? \embed{reply7,6} &euro; </p>
<div class="wims_instruction">Arrondir si besoin les résultats à 2 décimales.</div>
}

\answer{1}{\A1}{type=numeric}{option=comma}
\answer{2}{\I2}{type=numeric}{option=comma}
\answer{3}{\E3}{type=numeric}{option=comma}
\answer{4}{\A3}{type=numeric}{option=comma}
\answer{5}{\I3}{type=numeric}{option=comma}
\answer{6}{\a}{type=numeric}{option=comma}
\answer{6}{\IT}{type=numeric}{option=comma}
