\title{Tableau d'amortissement 1}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{norbert.rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{geometric_sequence}

\integer{E1=randint(50..90)*100}
\real{t1=randint(40..80)/10}
\real{t2=\t1/100}
\real{K2=(\t1/100)+1}
\real {a=rint(\E1*\t2/(1-(\K2^(-3)))*100)/100}
\real{I1=rint(\E1*\t1)/100}
\real{A1=\a-\I1}
\real{E2=\E1-\A1}
\real{I2=rint(\E2*\t1)/100}
\real{A2=\a-\I2}
\real{E3=\E2-\A2}
\real{A3=\E3}
\real{I3=\a-\A3}

\real{IT=\I1+\I2+\I3}

\text{prenom=slib(lang/fname )}

\matrix{matrice=
Année,Capital restant dû,Amortissement,Intérêts,Annuité
1,\E1,\A1,\I1,\a
2,\E2,\A2,\I2,\a
3,\E3,\A3,\I3,\a}
\text{tab=slib(text/matrixhtml [\matrice],wimscenter wimsborder,TH=[1;1])}

\statement{
<p>\prenom emprunte <span class="bold">\E1 &euro;</span> à la banque, au taux de <span class="bold">\t1 %</span> et rembourse son prêt en trois annuités. </p>
\tab


<div class="wims_question">
 <ol>
   <li>Quel est le <label for="reply1">montant d'une annuité</label> ?  \embed{reply1,6} </li>
   <li>Les annuités sont <span class="bold">\embed{reply2,13}</span> (cliquer sur la bonne réponse) </li>
   <li>Les intérêts sont<span class="bold">\embed{reply3,13}</span> (cliquer sur la bonne réponse)</li>
   <li>Les amortissements sont<span class="bold">\embed{reply6,13}</span> (cliquer sur la bonne réponse)</li>
   <li>Les amortissements forment une <span class="bold">suite géométrique</span>,
   quelle en est la <label for="reply5">raison</label> ? \embed{reply5,6}</li>
   <li>Quel est le <label for="reply4">coût du prêt</label>? \embed{reply4,6}</li>
 </ol>
</div>

}

\answer{1}{\a}{type=numeric}{option=comma}
\answer{2}{1;constantes, dégressives, progressives, alternatives }{type=mark}{option=split}
\answer{3}{2;constants, dégressifs, progressifs, alternatifs}{type=mark}{option=split}
\answer{4}{\IT}{type=numeric}{option=comma}
\answer{5}{\K2}{type=numeric}{option=comma}
\answer{6}{3;constants, dégressifs, progressifs, alternatifs}{type=mark}{option=split}
