tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items 3,3,3,1,2

tmp0=!randitem $tmp
val12=$[rint($(tmp0)+3*($val11-1))]
val13=Tableau des codons ARN
val14=Si un codon STOP apparait, la traduction s'arrête,	  les codons ne sont plus traduits en acides aminés.
val15=Ala, Arg, Asn, Asp, Cys, Gln, Glu, Gly, His, Ile,	  Leu, Lys, Met, Phe, Pro, Prp, Ser, Thr, Trp, Tyr, Val
tmp0=!makelist A,U,G,U for x=1 to $val9

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val7=$(val7[1..$val10])
tmp0=!items2words $val7

tmp1=!nospace $(tmp0)

val7=$(tmp1)
tmp0=!text expand $val7 using 0111

val7=$(tmp0)
tmp0=!words2items $val7

val7=$(tmp0)
tmp0=!replace internal UGA by AUA in $val7

val7=$(tmp0)
tmp0=!replace internal UAA by AGU in $val7

val7=$(tmp0)
tmp=!nonempty items 0,1

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!randint $val9-4, $val9

val17=$[rint($(tmp0))]
val18=UAA,UAG,UGA
tmp=!nonempty items $val18

tmp0=!randitem $tmp
val19=$(tmp0)
tmp=!nonempty items A,U,G

tmp0=!randitem $tmp
val7=$val7,$val19,$(tmp0)

!ifval _U,A,A isin _$val7 
tmp0=!replace internal _U,A,A by G,A,G,U,U in _$val7

val7=	  $(tmp0)
!endif

!ifval _U,A,G isin _$val7 
tmp0=!replace internal _U,A,G by G,A,G,U,U in _$val7

val7=	  $(tmp0)
!endif

!ifval _U,G,A isin _$val7 
tmp0=!replace internal _U,G,A by G,A,G,U,U in _$val7

val7=	  $(tmp0)
!endif
tmp0=!shuffle A,A,A,G,G,G

val7=$(tmp0),U,$val7
tmp0=!items2words $val7

tmp1=!text expand $(tmp0) using 01

tmp2=!words2items $(tmp1)

val20=$(tmp2)
tmp0=!items2words $val7

tmp1=!nospace $(tmp0)

val7=$(tmp1)
tmp0=!charcnt $val7

val10=$(tmp0)
val21=$[rint($val10-2)]
!for val22 =1 to 3 
val12=$[rint(0)]
val23=$(val18[$val22])
!for val24 =1 to $val21 
!if $val12=0 
tmp0=!char $val24 to $val21+2 of $val7

tmp1=!text compare $(tmp0) and $val23

tmp2=!char 1 to 3 of $(tmp1)

val25=$(tmp2)

!ifval $val25=0
val12= $val24
!endif
!endif
!next

!ifval $val12<$val21 and $val12>0
val21= $val12
!endif
!next
val12=$[rint($val21)]
val26=$val7
val27=
!for val28 =1 to $val10 

!ifval $val28=$val12 or $val28=$val12+1 or $val28=$val12+2 
val27=	    $val27 <span class="oef_indgood">$(val20[$val28])</span>
!else
val27=$val27 $(val20[$val28])
!endif
!next
tmp0=!items2words $val7

val7=$(tmp0)
val29=5,3
tmp0=!nospace $val7

val7=$(tmp0)
tmp0=!char 1 to $val12-1 of $val7

val30=$(tmp0)
