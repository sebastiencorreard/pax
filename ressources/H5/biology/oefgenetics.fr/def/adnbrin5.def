tmp1=!lookup $val34$val36$val35 in codon2am

val32=$val32<td class="$(tmp0)">	      $(tmp1)</td>
!next
val33=$val33$val35
val32=$val32<th>$val35</th></tr>
!next
!next
val32=$val32</table>
