val31=$(tmp0)
tmp0=!text expand $val31 using 0111

val7=$(tmp0)
val32=<table class="wimscenter wimsborder">	<caption>Tableau des codons ARN</caption>	<tr>	<th rowspan="2">nucléotide 1</th>	<th colspan="4">nucléotide 2</th>	<th rowspan="2">nucléotide 3</th>	</tr><tr>	<th>U</th><th>C</th><th>A</th><th>G</th>	</tr>
val33=,U,C,A,G
!for val34  in U,C,A,G 
