tmp0=!items2words $val8

tmp1=!nospace $(tmp0)

val8=$(tmp1)
tmp0=!text expand $val8 using 0111

val8=$(tmp0)
tmp0=!words2items $val8

val8=$(tmp0)
tmp0=!replace internal UGA by AUA in $val8

val8=$(tmp0)
tmp0=!replace internal UAA by AGU in $val8

val8=$(tmp0)
tmp=!nonempty items 0,1

tmp0=!randitem $tmp
val17=$(tmp0)
tmp0=!randint 2, 4

val18=$[rint($(tmp0))]
