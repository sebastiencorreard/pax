tmp0=!items2words $val22

tmp1=!nospace $(tmp0)

val22=$(tmp1)
tmp0=!text expand $val22 using 0111

val22=$(tmp0)
tmp0=!words2items $val22

val22=$(tmp0)
tmp0=!itemcnt $val22

val23=$[rint($(tmp0))]
val24=
val25=0
!for val20 =1 to $val23 
!if $val25=0 
val26=$(val22[$val20])
!if $val20=$val23 
tmp0=!charcnt $val26

val27=$(tmp0)

!ifval $val27<3
val25= $val20
!endif
!endif
tmp0=!lookup $val26 in codon2am

val28=$(tmp0)

!ifval $val28 issametext STOP 
val25= $val20
!endif

!ifval $val25=0
tmp0=!append item $val28 to $val24

val24= $(tmp0)
!endif
!endif
!next
tmp0=!items2words $val8

val8=$(tmp0)
