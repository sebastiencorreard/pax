val11=$(tmp0)
val20=1
val13=0
!while j <= $val18 and $val13=0 
tmp0=!char $val20 to -1 of $val8

tmp1=!text compare $(tmp0) and AUG

tmp2=!char 1 to 3 of $(tmp1)

val21=$(tmp2)

!ifval $val21=0
val13= $val20
!endif
val20=$[rint($val20+1)]
!endwhile
tmp0=!items2words $val8

tmp1=!text expand $(tmp0) using 01

