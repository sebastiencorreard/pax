\title{Tennis et probabilités totales}
\author{Cyrille,Douriez}
\email{wims.irem@u-picardie.fr} 

\computeanswer{yes}

\integer{tf=5*randint(4..8)}##% femmes ##
\integer{th=100-\tf}##% hommes##
\integer{tfc=5*randint(1..6)}##% femmes classées ##
\integer{thc=5*randint(2..8)}##% hommes classées ##
\real{p=(\tfc*\tf/100+\thc*\th/100)/100}
\integer{cg=randitem(1,2)}
\text{genre=hommes,femmes}
\text{tg=\th,\tf}

##Pour le corrigé##
\real{pg=\tg[\cg]/100}
\real{pgcomp=1-\pg}
\real{pf=\tf/100}
\real{ph=\th/100}
\real{pfc=\tfc/100}
\real{phc=\thc/100}
\text{lettregenre=(\cg==1)? H:F}
\text{lettregenre2=(\cg==2)? H:F}

\statement{\(\tg[\cg] \%) des membres adultes d'un club de tennis sont des \genre[\cg]. \(\tfc \%\) des femmes et \(\thc \%\) des hommes sont classés 
au niveau national.<br>
On interroge un membre adulte du club au hasard.
<div class="wims_question">Quelle est la probabilité que la personne soit classée ?</div>
La probabilité est \embed{r1,5}.}

\answer{1}{\p}{type=numexp}

\solution{Notons \(H\) l'événement "la personne est un homme", \(F\) l'événement "la personne est une femme" et \(C\) l'événement : "la personne est classée".<br>
L'énoncé nous donne : \(p(\lettregenre)=\pg\), \(p_F(C)=\pfc\) et \(p_H(C)=\phc\).<br>
\(\left \{ F, H \right \}\) est une partition de l'univers, donc, d'après la formule des probabilités totales, 
\(p(C)=p_F(C)\times p(F)+p_{H}(C)\times p(H)\).<br>
\(p(\lettregenre)=\pg\) donc \(p(\lettregenre2)=1-\pg=\pgcomp\).
<br>On en déduit que \(p(C)=\pfc\times \pf+\phc\times \ph=\p\).

}
