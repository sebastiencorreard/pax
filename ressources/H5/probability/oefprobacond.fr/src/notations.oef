\title{Notations de probabilités}

\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\precision{100}
\format{html}

\text{let=sain,contaminé,positif,négatif}
\integer{m1=randint(1,2)}
\integer{m2=randint(3,4)}

\matrix{enonce=le plat est sain et le contrôle est négatif
le plat est sain et le contrôle est positif
le plat est contaminé et le contrôle est négatif
le plat est contaminé et le contrôle est positif
le contrôle portant sur un plat sain est négatif
le contrôle est positif sachant que le plat est sain
le contrôle est négatif sachant que le plat est contaminé
le contrôle portant sur un plat contaminé est positif
le plat est sain sachant que le contrôle est positif
le plat est contaminé sachant que le contrôle est négatif
le plat est sain ou le contrôle est négatif
le plat est contaminé ou le contrôle est positif}

\text{A=(\m1=1)? A:\overline{A}}
\text{Ac=(\m1=2)? A:\overline{A}}
\text{B=(\m2=3)? B:\overline{B}}
\text{Bc=(\m2=4)? B:\overline{B}}


\text{rep=\(p(\A \cap \Bc)\),\(p(\A \cap \B)\),\(p(\Ac \cap \Bc)\),\(p(\Ac \cap \B)\),\(p_\A(\Bc)\),\(p_\A(\B)\),\(p_\Ac(\Bc)\),
\(p_\Ac(\B)\),\(p_\B(\A)\),\(p_\Bc(\Ac)\),\(p(\A \cup \Bc)\),\(p(\Ac \cup \B)\)}

\integer{c1=randint(1..4)}
\integer{c2=randint(5..8)}
\integer{c3=randint(9..12)}


\statement{Un plat cuisiné est susceptible d'être contaminé par une bactérie. Des contrôles sont effectués à intervalle régulier pour vérifier la présence de la bactérie.
On note \(A\) l'événement : <i>"le plat est \let[\m1]"</i> et \(B\) l'événement <i>"le contrôle est \let[\m2]"</i>.

<ol><li>La probabilité de l'événement <i>"\enonce[\c1;1] "</i> se note : \embed{r1,100x40x1}</li>
<li>La probabilité de l'événement <i>"\enonce[\c2;1] "</i> se note : \embed{r2,100x40x1}</li>
<li>La probabilité de l'événement <i>"\enonce[\c3;1] "</i> se note : \embed{r3,100x40x1}</li></ol>
<div class="wims_instruction"> Indiquer le nombre correspondant à la bonne notation.</div>}

\answer{}{\rep[\c1];\rep}{type=clickfill}
\answer{}{\rep[\c2];\rep}{type=clickfill}
\answer{}{\rep[\c3];\rep}{type=clickfill}
