val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,2,3,3

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]

!ifval ($val6=2)
tmp=!nonempty items 3,3,3,4

tmp0=!randitem $tmp
val7=$[rint( $(tmp0))]
!else
tmp=!nonempty items 2,2,3,3

tmp1=!randitem $tmp
val7=$[rint($(tmp1))]
!endif
val8=$[rint(0)]
val9=blanche,noire,jaune,verte,rouge,bleue,grise
tmp0=!shuffle $val9

tmp1=$(tmp0)

val9=$(tmp1)
val10=$(val9[1..$val6])

!ifval ($val6*$val7<10)
val11=$[rint( 2)]
!else
val11=$[rint(3)]
!endif
val12=$(val10[1..$val11]),$(val9[($val6+1)..7])
val12=$(val12[1..$val7])
tmp=!trim 1	0.25	0.2,0.25	0.2,0.15,0.15	0.15,0.1,0.1,0.1
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 1	0.7	0.45,0.4	0.35,0.3,0.25	0.25,0.2,0.2,0.2
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!nonempty items 10,20,25,40,50

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
tmp0=!randint ($(val13[$val6;1])*$val15), ($(val14[$val6;1])*$val15)

val16=$[rint($(tmp0))]
val17=$val16

!ifval ($val16=1)
val18= $val16 boule $(val10[1])
!else
val18=$val16 boules $(val10[1])s
!endif
!for val19 =2 to ($val6-1) 
tmp0=!randint ($(val13[$val6;$val19])*$val15), ($(val14[$val6;$val19])*$val15)

val20=$[rint($(tmp0))]
val16=$[rint($val16+$val20)]
val17=$val17,$val20

!ifval ($val20=1)
val18= $val18, $val20 boule $(val10[$val19])
!else
val18=$val18, $val20 boules $(val10[$val19])s
!endif
!next
val20=$[rint($val15-$val16)]
val17=$val17,$val20

!ifval ($val20=1)
val18= $val18 et $val20 boule $(val10[$val6])
!else
val18=$val18 et $val20 boules $(val10[$val6])s
!endif
tmp=!nonempty items 10,20,25,40,50

tmp0=!randitem $tmp
val21=$[rint($(tmp0))]
tmp0=!randint ($(val13[$val7;1])*$val21), ($(val14[$val7;1])*$val21)

val22=$[rint($(tmp0))]
val23=$val22

!ifval ($val22=1)
val24= $val22 boule $(val12[1])
!else
val24=$val22 boules $(val12[1])s
!endif
!for val19 =2 to ($val7-1) 
tmp0=!randint ($(val13[$val7;$val19])*$val21), ($(val14[$val7;$val19])*$val21)

val25=$[rint($(tmp0))]
val22=$[rint($val22+$val25)]
val23=$val23,$val25

!ifval ($val25=1)
val24= $val24, $val25 boule $(val12[$val19])
!else
val24=$val24, $val25 boules $(val12[$val19])s
!endif
!next
val25=$[rint($val21-$val22)]
val23=$val23,$val25

!ifval ($val25=1)
val24= $val24 et $val25 boule $(val12[$val7])
!else
val24=$val24 et $val25 boules $(val12[$val7])s
!endif
!if $val8=1 
val12=$val10
val7=$[rint($val6)]
val23=$val17
val24=$val18
!endif
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val26=$[rint($(tmp0))]
val27=$[rint(3-$val26)]
t_=!rawmath ($(val17[$val26])/$val15)*($(val23[$val26])/$val21)
val28=!exec pari print($t_)

!ifval ($val6*$val7<13)
t_=!rawmath  ($(val17[1])/$val15)*($(val23[1])/$val21)+($(val17[2])/$val15)*($(val23[2])/$val21)
val29=!exec pari print($t_)
!else
t_=!rawmath ($(val17[1])/$val15)*($(val23[1])/$val21)+($(val17[2])/$val15)*($(val23[2])/$val21)+($(val17[3])/$val15)*($(val23[3])/$val21)
val29=!exec pari print($t_)
!endif
t_=!rawmath 1-$val29
val30=!exec pari print($t_)
t_=!rawmath $(val17[$val27])/$val15+(($val15-$(val17[$val27]))/$val15)*($(val23[$val27])/$val21)
val31=!exec pari print($t_)
replytype1=formal
replyname1=
replygood1=$val28
replytype2=formal
replyname2=
replygood2=$val29
replytype3=formal
replyname3=
replygood3=$val30
replytype4=formal
