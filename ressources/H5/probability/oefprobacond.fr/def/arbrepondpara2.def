 !exit
!endif

tmp0=!randint 4, 10

val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

val7=$[$(tmp0)/10]
val8=$[1-$val7]
val9=$[(1-2*$val6)*$val7-1]
val10=$[$val7*($val6-$val6^2)]
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp0=!texmath $val11

val11=$(tmp0)
val12=$[($val9)^2-4*($val8)*($val10)]
val13=$[(-$val9-sqrt($val12))/(2*$val8)]
val14=$[(-$val9+sqrt($val12))/(2*$val8)]
val15=$[round($val14*10)/10]

!ifval (floor($val14)=$val14)
val16=$[rint( $val14)]
!else
val16=$[rint(floor($val14)+1)]
!endif
!readproc slib/utilities/tooltip sans remise, on ne remet pas la première boule tirée dans l'urne avant de tirer la seconde boule 
tmp0=$slib_out
val17=$(tmp0)
t_=!replace internal \( by ( in x*(x-1)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in (x+$val6)*(x+$val6-1)
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
val20=1,2

!ifval ($val15=$val14)
val21=$[rint( 1)]
!else
val21=$[rint(0)]
!endif
t_=!replace internal \( by ( in $val8*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

val22=!rawmath $(tmp0)
val23=$[rint($val6-1)]
val24=$[rint($val6+$val23)]
val25=$[rint($val6*$val23)]
val26=$[$val7*$val24]
val27=$[$val7*$val25]
val28=r1,r2	r3,r4	r5,r6,r7	r8
oefsteps=$val28 
nextstep=!nosubst $val28 
!readproc oef/steps.proc
replytype1=function
replyoption1=nonstop 
replyname1=1
replygood1=!rawmath $val18
replytype2=function
replyoption2=nonstop 
replyname2=2
