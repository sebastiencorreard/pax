replygood7=$(val20[2]);-,+
replytype8=numeric
replyname8=8
replygood8=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Une urne contient 
!insmath $val6
$() boules vertes et 
!insmath x
$() boules rouges où 
!insmath x
$() est un entier naturel non nul.<br/>	On tire successivement $val17 deux boules de l'urne.<br>	<b>Le but est de déterminer la plus petite valeur de l'entier naturel 
!insmath x
$() telle que la probabilité d'obtenir deux boules rouges soit supérieure ou égale à 
!insmath $val7
$().</b>	
!if $m_step=1 
$()<div class="wims_question">1&#41;Ecrire la probabilité d'obtenir deux boules rouges, en fonction de 
!insmath x
$(), sous la forme d'une fraction rationnelle.</div>	La probabilité est 	  
!read oef/special.phtml mathmlinput [ \frac{reply1}{reply2}],2	reply1,7	reply2,7	 
$().		 
!endif
$()	
!if $m_step=2 
$()<br><br>La probabilité d'obtenir deux boules rouges est 
!insmath \frac{$val18}{$val19}
$().	<br>Déterminer l'entier 
!insmath x
$() se ramène à la résolution d'une inéquation de la forme 
!insmath $val8 x^2+b x+c \geq 0
$().	<div class="wims_question">2&#41;Déterminer la valeur des réels 
!insmath b
$() et 
!insmath c
$().</div>	
!insmath b
$()= 
!read oef/embed.phtml r3,4 
$() et 
!insmath c
$()= 
!read oef/embed.phtml r4,4 
$(). 
!endif
$()		
!if $m_step=3 
$()<br><br>Déterminer l'entier 
!insmath x
$() se ramène à la résolution de l'inéquation 
!insmath $val11 \geq 0
$().	<div class="wims_question">3&#41;Etudier le signe de 
!insmath $val11
$() sur &#91;0; +&infin;&#91;.</div>	<table class="wimsborder">	<tr><th>
!insmath x
$()</th><td align="left">0</td><td></td><td> 
!read oef/embed.phtml r5,4 
$()</td><td></td><td align="right">+&infin;</td></tr>	<tr><th>
!insmath $val11
$()</th><td align="left"></td><td> 
!read oef/embed.phtml r6,4 
$()</td><td>0</td><td> 
!read oef/embed.phtml r7,4 
$()</td><td></td></tr>	</table><br>	<div class="wims_instruction">On arrondira la racine positive de 
!insmath $val11
$() à 0,1 près.</div>	 
!endif
$()	
!if $m_step=4 
$()<br><br>Déterminer l'entier 
!insmath x
$() se ramène à la résolution de l'inéquation 
!insmath $val11 \geq 0
$().	<br>Le signe de 
!insmath $val11
$() est<br>	<table class="wimsborder">	<tr><th>
!insmath x
$()</th><td align="left">0</td><td></td><td>
!insmath $val15
$()</td><td></td><td align="right">+&infin;</td></tr>	<tr><th>
!insmath $val11
$()</th><td align="left"></td><td>-</td><td>0</td><td>+</td><td></td></tr>	</table>	<br>	<div class="wims_question">4&#41;En déduire la plus petite valeur de 
!insmath x
$() telle que la probabilité d'obtenir deux boules rouges soit supérieure ou égale à 
!insmath $val7
$().</div>	La valeur de 
!insmath x
$() est  
!read oef/embed.phtml r8,3 
$(). 
!endif
$()		
$()
!exit

