val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

val6=$[rint(20+50*$(tmp0))]
tmp0=!randint 2, 5

val7=$[rint(5*$(tmp0))]
tmp0=!randint 2, 8

val8=$[rint(5*$(tmp0))]
val9=$[rint($val6*$val7/100)]
val10=$[rint($val6-$val9)]
val11=$[rint($val9*$val8/100)]
val12=$[rint($val10*$val8/100)]
val13=$[rint($val11+$val12)]
val14=$[rint($val9-$val11)]
val15=$[rint($val10-$val12)]
val16=$[rint($val6-$val13)]
tmp0=$val9 / $val6

val17=$[$(tmp0)]
tmp0=$val11/ $val6

val18=$[$(tmp0)]
tmp0=$val11 / $val13

val19=$[$(tmp0)]
tmp0=$val12/$val10

val20=$[$(tmp0)]
val21=textmath($val11)
val22=$val12
t_=!rawmath $val9 / $val6
val17=!exec pari print($t_)
t_=!rawmath $val11/ $val6
val18=!exec pari print($t_)
t_=!rawmath $val11 / $val13
val19=!exec pari print($t_)
t_=!rawmath $val12/$val10
val20=!exec pari print($t_)
oefsteps=reply1,reply2,reply3,reply4,reply5,reply6,reply7,reply8,reply9	reply10,reply11,reply12,reply13 
nextstep=!nosubst reply1,reply2,reply3,reply4,reply5,reply6,reply7,reply8,reply9	reply10,reply11,reply12,reply13 
!readproc oef/steps.proc
replytype1=numeric
