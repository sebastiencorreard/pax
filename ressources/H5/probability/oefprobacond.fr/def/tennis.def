question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Lors ors d'une compétition de tennis, on a relevé que sur  $val6 compétiteurs,  $val9 sont des femmes.	<br>Parmi ces femmes,  $val11 sont classées. Parmi les compétiteurs hommes, $val12 sont classés.	
!if $m_step=1 
$()<div class="wims_question">Compléter le tableau ci-dessous à partir des informations données.</div>	<table class="wimscenter, wimsborder">	<tr><td></td><th>femmes</th><th>hommes</th><th>Total</th></tr>	<tr><th>classé</th><td> 
!read oef/embed.phtml r1,4 
$()</td><td> 
!read oef/embed.phtml r2,4 
$()</td><td> 
!read oef/embed.phtml r3,4 
$()</td></tr>	<tr><th>Non classé</th><td> 
!read oef/embed.phtml r4,4 
$()</td><td> 
!read oef/embed.phtml r5,4 
$()</td><td> 
!read oef/embed.phtml r6,4 
$()</td></tr>	<tr><th>Total</th><td> 
!read oef/embed.phtml r7,4 
$()</td><td> 
!read oef/embed.phtml r8,4 
$()</td><td> 
!read oef/embed.phtml r9,4 
$()</td></tr>	</table> 
!endif
$()	
!if $m_step=2 
$()<table class="wimscenter" width="80%">	<tr>	<td><table class="wimscenter, wimsborder">	<tr><td>Vos réponses <br>à la question 1</td><th>femmes</th><th>hommes</th><th>Total</th></tr>	<tr><th>classé</th><td>$m_reply1</td><td>$m_reply2</td><td>$m_reply3</td></tr>	<tr><th>Non classé</th><td>$m_reply4</td><td>$m_reply5</td><td>$m_reply6</td></tr>	<tr><th>Total</th><td>$m_reply7</td><td>$m_reply8</td><td>$m_reply9</td></tr></table>	</td>	<td> 	<table class="wimscenter, wimsborder">	<tr><td><font color="green"><b>Les bonnes réponses</b></font></td><th>femmes</th><th>hommes</th><th>Total</th></tr>	<tr><th>classé</th><td>$val11</td><td>$val12</td><td>$val13</td></tr>	<tr><th>Non classé</th><td>$val14</td><td>$val15</td><td>$val16</td></tr>	<tr><th>Total</th><td>$val9</td><td>$val10</td><td>$val6</td></tr></table>	</td>	</tr>	</table>	<br>On choisit au hasard une fiche parmi tous les compétiteurs.	<br>	On note 
!insmath F
$(): l'événement "La fiche est celle d'une femme" et on note 
!insmath C
$(): l'événement "la fiche est celle d'une personne classée"	<div class="wims_question">Calculer les probabilités ci-dessous.</div> 	<ul>	<li>	 
!insmath P(F)=
$() 
!read oef/embed.phtml r10,6 
$() </li>	<li>	
!insmath P(F \cap C)=
$() 
!read oef/embed.phtml r11,6 
$() </li>	<li>	
!insmath P_C(F)=
$() 
!read oef/embed.phtml r12,6 
$() </li>	<li>	
!insmath P_\overline{F}(C)=
$() 
!read oef/embed.phtml r13,6 
$() </li>	</li></ul>	<div class="wims_instruction">On donnera les résultats sous forme fractionnaire.</div>	 
!endif
$()
$()
!exit

