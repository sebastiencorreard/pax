!set title=Notations de probabilités
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=sain,contaminé,positif,négatif
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]
tmp0=!randitem 3,4

val8=$[rint($(tmp0))]
tmp=!trim le plat est sain et le contrôle est négatif	le plat est sain et le contrôle est positif	le plat est contaminé et le contrôle est négatif	le plat est contaminé et le contrôle est positif	le contrôle portant sur un plat sain est négatif	le contrôle est positif sachant que le plat est sain	le contrôle est négatif sachant que le plat est contaminé	le contrôle portant sur un plat contaminé est positif	le plat est sain sachant que le contrôle est positif	le plat est contaminé sachant que le contrôle est négatif	le plat est sain ou le contrôle est négatif	le plat est contaminé ou le contrôle est positif
val9=!translate internal $	\
$ to ;; in $tmp

!ifval ($val7=1)
val10= A
!else
val10=\overline{A}
!endif

!ifval ($val7=2)
val11= A
!else
val11=\overline{A}
!endif

!ifval ($val8=3)
val12= B
!else
val12=\overline{B}
!endif

!ifval ($val8=4)
val13= B
!else
val13=\overline{B}
!endif
val14=\(p($val10 \cap $val13)\),\(p($val10 \cap $val12)\),\(p($val11 \cap $val13)\),\(p($val11 \cap $val12)\),\(p_$val10($val13)\),\(p_$val10($val12)\),\(p_$val11($val13)\),	\(p_$val11($val12)\),\(p_$val12($val10)\),\(p_$val13($val11)\),\(p($val10 \cup $val13)\),\(p($val11 \cup $val12)\)
tmp0=!randint 1, 4

val15=$[rint($(tmp0))]
tmp0=!randint 5, 8

val16=$[rint($(tmp0))]
tmp0=!randint 9, 12

val17=$[rint($(tmp0))]
replytype1=clickfill
replyname1=
replygood1=$(val14[$val15]);$val14
replytype2=clickfill
replyname2=
replygood2=$(val14[$val16]);$val14
replytype3=clickfill
replyname3=
replygood3=$(val14[$val17]);$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Un plat cuisiné est susceptible d'être contaminé par une bactérie. Des contrôles sont effectués à intervalle régulier pour vérifier la présence de la bactérie.	On note 
!insmath A
$() l'événement : <i>"le plat est $(val6[$val7])"</i> et 
!insmath B
$() l'événement <i>"le contrôle est $(val6[$val8])"</i>.		<ol><li>La probabilité de l'événement <i>"$(val9[$val15;1]) "</i> se note :  
!read oef/embed.phtml r1,100x40x1 
$()</li>	<li>La probabilité de l'événement <i>"$(val9[$val16;1]) "</i> se note :  
!read oef/embed.phtml r2,100x40x1 
$()</li>	<li>La probabilité de l'événement <i>"$(val9[$val17;1]) "</i> se note :  
!read oef/embed.phtml r3,100x40x1 
$()</li></ol>	<div class="wims_instruction"> Indiquer le nombre correspondant à la bonne notation.</div>
$()
!exit

