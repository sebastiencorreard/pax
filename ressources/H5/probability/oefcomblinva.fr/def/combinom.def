tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!item  1 to $val9 of $val8 

val10=$(tmp0)
tmp0=!shuffle 6

val8=$(tmp0)
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!item  1 to $val11 of $val8 

val12=$(tmp0)
