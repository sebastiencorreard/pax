t_=!rawmath $val9/6
val14=!exec pari print($t_)
t_=!rawmath $val7
val15=!exec pari print($t_)
t_=!rawmath $val11/6
val16=!exec pari print($t_)
t_=!rawmath $val6*$val9/6+$val7*$val11/6
val17=!exec pari print($t_)
t_=!rawmath $val6*$val9*(6-$val9)/36+$val7*$val11*(6-$val11)/36
val18=!exec pari print($t_)
t_=!rawmath $val6*$val9/6
val19=!exec pari print($t_)
val20=$[rint($val6*$val9)]
t_=!rawmath $val7*$val11/6
val21=!exec pari print($t_)
val22=$[rint($val7*$val11)]
t_=!rawmath $val6*$val9*(6-$val9)/36
val23=!exec pari print($t_)
t_=!rawmath $val7*$val11*(6-$val11)/36
val24=!exec pari print($t_)
t_=!replace internal \( by ( in gcd($val6*$val9+$val7*$val11,6)
tmp0=!exec maxima $t_

val25=$[rint($(tmp0))]
val26=$[rint(($val6*$val9+$val7*$val11)/$val25)]
val27=$[rint(6/$val25)]

!ifval $val27=1
val28= $val26 
!else
val28= \frac{$val26}{$val27}
!endif
t_=!replace internal \( by ( in gcd($val6*$val9*(6-$val9)+$val7*$val11*(6-$val11),36)
tmp0=!exec maxima $t_

val29=$[rint($(tmp0))]
val30=$[rint(($val6*$val9*(6-$val9)+$val7*$val11*(6-$val11))/$val29)]
val31=$[rint(36/$val29)]

!ifval $val31=1
val32= $val30 
!else
val32= \frac{$val30}{$val31}
!endif

!ifval $val9=1
val33= est égal à $val10
!else
val33= appartient à l'ensemble \(\left\{$val10 \right\}\)
!endif

!ifval $val11=1
val34= est égal à $val12
!else
