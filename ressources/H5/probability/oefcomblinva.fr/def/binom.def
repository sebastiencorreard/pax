val26=($val17 \times $val9)^2+($val18 \times $val16)^2
t_=!replace internal \( by ( in $val23*($val9)*($val9)+$val24*($val16)*($val16)
tmp0=!exec maxima $t_

val27=$(tmp0)
!endif
