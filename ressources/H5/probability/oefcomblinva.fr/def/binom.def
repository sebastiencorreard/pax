tmp0=!exec pari $t_

val19=$(tmp0)
val20=On considère une autre variable aléatoire \(Y\), indépendante de \(X\)	  et telle que \( E( Y ) = $val12\) et \(V(Y)=$val15\). On définit ensuite la variable aléatoire  	  \(W\) par : \(W=$val19\).
t_=!replace internal \( by ( in $val17*$val6*0.5+$val18*$val12
tmp0=!exec maxima $t_

val21=$(tmp0)
t_=!replace internal \( by ( in sqrt(($val17*$val9)^2+($val18*$val16)^2)
tmp0=!exec maxima $t_

