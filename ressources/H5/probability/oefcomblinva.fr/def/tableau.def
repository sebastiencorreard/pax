$() 
!else
$() 
!insmath $val11 E(X)
$() 
!endif
$()
!insmath =$(val14[1])
$()</p>	    <p><b>Variance :</b>  
!insmath V($val13)=
$()	    
!if $val12<>0 
$()
!insmath {($val11)^2}V(X)+ {($val12)^2}V(Y)
$() 
!else
$() 
!insmath {($val11)^2}V(X)
$() 
!endif
$()
!insmath =$(val14[2])
$()</p>	    <p><b>Ecart-type :</b> Par définition : 
!insmath \sigma ($val15 )
$()	    
!insmath = \sqrt{V( $val15 )}
$()
!insmath =$(val14[3])
$()</p>	
