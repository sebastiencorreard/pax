!set title=Espérance, variance Ecart-type de aX+bY
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno,Mifsud;Hubert,Proal
email=communanute.mutuwims@laposte.net;hubert.proal@ac-aix-marseille.fr
keywords=random_variable,probability_distribution
computeanswer=yes
precision=1000

ansorder=r,r,r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=MutuWIMS
tmp0=!randint 0, 10

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in sqrt($val7)
tmp0=!exec maxima $t_

val8=$(tmp0)
val9=$val6,$val7,$val8
tmp0=!randint 0, 10

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in sqrt($val7)
tmp0=!exec maxima $t_

val8=$(tmp0)
val10=$val6,$val7,$val8
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

tmp2=!randint 2, 10

tmp3=!randitem -1,1

tmp4=!randitem 0,$(tmp0)*$(tmp1),$(tmp2)*$(tmp3)

val12=$[rint($(tmp4))]
t_=!replace internal \( by ( in $val11*X+$val12*Y
tmp0=!exec pari $t_

val13=$(tmp0)
val6=$[rint($val11*$(val9[1])+$val12*$(val10[1]))]
t_=!replace internal \( by ( in $val11*$val11*$(val9[2])+$val12*$val12*$(val10[2])
tmp0=!exec pari $t_

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in sqrt($val7)
tmp0=!exec maxima $t_

val8=$(tmp0)
val14=$val6,$val7,$val8

!ifval $val12<0 
val15=$val11 X $val12 Y
!else
val15=$val11 X +$val12 Y
!endif

!ifval $val12=0 
val15= $val11 X
!else
val15=$val15
!endif
val16=$[rint(10)]
replytype1=formal
replyname1=espérance de \($val11*X+$val12*Y\)
replygood1=$(val14[1])
replytype2=formal
replyname2=Variance de \($val11*X+$val12*Y\)
replygood2=$(val14[2])
replytype3=formal
replyname3=Ecart-type de X
replygood3=$(val9[3])
replytype4=formal
replyname4=Ecart-type de Y
replygood4=$(val10[3])
replytype5=formal
replyname5=Ecart-type de \($val11*X+$val12*Y\)
replygood5=$(val14[3])
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

