\title{Évènements (sports)}
\language{  fr}
\author{ Yvon,Charbonnière}
\format{ html }
\email{  yvon.charbonniere@ac-lyon.fr}
\precision{ 10000 }
\computeanswer{no}
\real{h=random(6000,6500,7000)}
\real{f=10000-\h}
\real{uf=\f-2050}
\real{ut=\f-2050+1250}
\real{jh=\h-6000}
\real{jt=\h-6000+200}
\real{pf=\f/10000}
\real{ph=\h/10000}
\real{pu=\ut/10000}
\real{n1=(\h+\uf)}
\real{p1=(\h+\uf)/10000}

\text{choix=Être un homme et une femme,Être un homme ou une femme,Être un homme et faire du sport exactement une fois par semaine,Être un homme ou faire du sport exactement une fois par semaine,Être une femme et faire du sport exactement une fois par semaine,Être une femme ou faire du sport exactement une fois par semaine}
\steps{
    reply1, reply2, reply3
    reply4, reply6, reply7
    reply5, reply8, reply9}


\statement{<span class="float_left"><img src="\imagedir/sport.jpg" alt="sport"></span>

<p>Le tableau suivant donne les résultats d'une enquête auprès de
10 000 personnes portant sur leur pratique d'une activité sportive.</p>
 <table class="wimsborder">
  <tr>
    <td> </td><th colspan="4">Nombre de fois par semaine</th> <td> </td>
    </tr>
    <tr>
        <td> </td> <td>jamais </td> <td> 1</td> <td>2 </td> <td>3 </td> <td>total</td>
   </tr>
   <tr>
        <td>femmes</td> <td>200 </td> <td> \uf</td> <td>850 </td> <td>1000 </td> <td>\f</td>
   </tr>
   <tr>
       <td>hommes</td> <td>\jh </td> <td> 1250</td> <td>4000 </td> <td>750 </td> <td>\h</td>
   </tr>
   <tr>
      <td>total</td> <td>\jt </td> <td> \ut</td> <td>4850 </td> <td>1750 </td> <td>10000</td>
   </tr>
  </table>

<p>On considère les évènements </p>
   <ul class="wims_emph">
    <li>  A:  Pratiquer un sport exactement une fois par semaine</li>
    <li>  B:  Être un homme</li>
    <li>  C:  Être une femme</li>
  </ul>
\if{ \step = 1 } { <div class="bold"> Première partie</div>
          Calculez \(p(A)\) :\embed{reply1,5}, \(p(B)\) : \embed{reply2,5}, \(p(C)\): \embed{reply3,5}}

\if{ \step = 2 } {<div class="oef_indgood"> Bien :  \(p(A)=\pu \);  \(p(B)=\ph \);  \(p(C)=\pf \) </div>
        <div class="bold"> Seconde partie</div>

         Choisissez la (ou les) phrase(s) définissant l'évènement \(A \cup B\).
  <ul>
    <li> \embed{r4,1}</li>
    <li>\embed{r4,2}</li>
    <li>\embed{r4,3}</li>
    <li> \embed{r4,4}</li>
    <li> \embed{r4,5}</li>
    <li>\embed{r4,6}</li>
  </ul>
       Combien cela concerne-t-il de personnes ?  \embed{reply6,5}
       </br>
      Calculez \(p( A \cup B)\) :\embed{reply7,5} }

\if{ \step = 3 } { <div class="oef_indgood"> Bien :  \(p(A)=\pu \);  \(p(B)=\ph \);  \(p(C)=\pf \); \(p( A \cup B) = \p1 \) </div>
        <div class="bold"> Troisième partie</div></P>
  Choisissez la (ou les) phrase(s) définissant l'évènement: \(B \cup C\).
  <ul>
    <li> \embed{r5,1}</li>
    <li> \embed{r5,2}</li>
    <li> \embed{r5,3}</li>
    <li> \embed{r5,4}</li>
    <li> \embed{r5,5}</li>
    <li> \embed{r5,6}</li>
                   </ul>
 Combien cela concerne-t-il de personnes? : \embed{reply8,5}<br \>
    Calculez \(p( B \cup C)\) : \embed{reply9,5}}
   }


\answer{1}{\pu}{type=numeric}{option=comma}
\answer{2}{\ph}{type=numeric}{option=comma}
\answer{3}{\pf}{type=numeric}{option=comma}
\answer{4}{4;\choix}{type=checkbox}{option=shuffle}
\answer{5}{2;\choix}{type=checkbox}{option=shuffle}
\answer{6}{\n1}{type=numeric}{option=comma}
\answer{7}{\p1}{type=numeric}{option=comma}
\answer{8}{10000}{type=raw}
\answer{9}{1}{type=raw}
