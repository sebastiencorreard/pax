<td> \embed{reply4,5}% </td>
<td> </td>
<td> \PB %</td>
 </tr>
<tr>
<th>total </th>
<td> \embed{reply7,5} %</td>
<td>  </td>
<td> 100% </td>
 </tr>
</table>}

\if{ \step = 3} {
Compléter la dernière partie du tableau, <strong>données exprimées en % du nombre total de bonbons</strong>.
<table class="wimscenter wimsborder">
<tr>
<td> </td>
<th>Bonbons rouges </th>
<th>autres couleurs </th>
<th>total </th>
 </tr>
<tr>
<th>Nounours </th>
<td> \Nnr %</td>
