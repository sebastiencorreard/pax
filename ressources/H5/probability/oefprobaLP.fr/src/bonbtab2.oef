<td> \PN %</td>
 </tr>
<tr>
<th>Bouteilles</th>
<td> \Btr %</td>
<td> \embed{reply5,5} %</td>
<td> \PB %</td>
 </tr>
<tr>
<th>total </th>
<td> \R %</td>
<td> \embed{reply8,5} %</td>
<td> 100 %</td>
 </tr>
</table>}

\if{ \step = 4 } {
<span class="oef_indgood">Bonnes réponses </span>

<table class="wimsborder wimscenter">
<tr>
<td> </td>
