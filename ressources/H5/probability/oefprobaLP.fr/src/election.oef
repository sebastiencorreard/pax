\title{Fluctuation (sondage électoral)}
\language{fr}
\range{-5..5}
\author{Norbert,Rey}
\email{Norbert.Rey@ac-lyon.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{prediction_interval}

\integer{xi=random(510..530)}
\integer{xs=random(540..560)}
\real{p=random(\xi,\xs)/1000}
\real {P=\p*100}
\real{b=\p-1/sqrt(1000)}
\real{B=\p+1/sqrt(1000)}
\real{m=rint(1000*\b)/1000}
\real{M=rint(1000*\B)/1000}
\integer{R= \p>0.535 ? 1:2}
\help { L'intervalle de fluctuation est donné par la formule
\(\left[p -\frac{1}{\sqrt{n}}  ; p +\frac{1}{\sqrt{n}} \right]\)</strong>}
\steps{
    reply1
    reply2
    reply3, reply4 }

\statement{
\img{\imagedir/sondage.jpg} Un sondage avant le second tour des élections est réalisé sur un panel de <strong>1000 personnes</strong>, représentatif des électeurs.<br>
<p>Lors de ce sondage, le candidat arrivant en tête recueille <strong> \P %</strong> des intentions de vote.\img{\imagedir/election.jpg}</p>
<div class="wims_emph wimscenter">Problématique : Peut-on affirmer que le candidat est certain d'être élu ?</div>
\if{ \step = 1 } {Déterminer la borne inférieure de l'intervalle de confiance au seuil de 95 %  : \embed{ reply 1,5 } <div class="wims_instruction">arrondir au millième</div>}
\if{ \step = 2 } {Déterminer la borne supérieure de l'intervalle de confiance au seuil de 95 %  : \embed{ reply 2,5 }<div class="wims_instruction">arrondir au millième</div>}
\if{ \step = 3 } { L'intervalle de confiance au seuil de 95 % est donc <span class="oef_indgood"> [\m ; \M ]</span>. <br>
Peut-on affirmer que le candidat est certain d'être élu ? <span class="wims_smallremark">Avec un risque d'erreur inférieur à 5 % </span><br>
  \embed{reply 3}   <br>
Quelle inégalité vous permet de justifier votre réponse ?  <br>  \embed{reply 4} }
}
\answer{}{\m}{type=default}{option=comma}
\answer{}{\M}{type=default}{option=comma}
\answer{}{\R;oui,non}{type=radio}
\answer{}{\R;\(\m>0.5 \),\(\m<0.5 \),\(\p>0.5 \),\(\M<0.5 \),\(\M>0.5 \)}{type=radio}{option = shuffle}
