!set title=Le test antigénique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Norbert,Rey
email=Norbert.Rey@ac-lyon.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss= <style>.bleu{color:darkblue;}</style> <style>.vert{color:green;}</style> <style>.violet{color:purple;}</style> <style>.cadre { color:grey; padding: 10px; border-style: double; margin-left:100px; margin-right:150px; }</style> 

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=14
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 245, 255

val6=$[rint($(tmp0) )]
tmp0=!randint 38, 48

val7=$[rint($(tmp0) )]
tmp0=!randitem 0,1,2,3,4

val8=$[rint($(tmp0) )]
tmp0=!randitem 8,9,10

val9=$[rint($(tmp0) )]
val10=$[rint($val7+$val8 )]
val11=$[rint($val6-$val10 )]
val12=$[rint($val11-$val9 )]
val13=$[rint($val7+$val9 )]
val14=$[rint($val8+$val12 )]
val15=$[rint(1000*$val7/$val13)/10 ]
val16=$[rint(1000*$val12/$val14)/10 ]

!ifval $val15<80
val17=1
!else
val17=2
!endif

!ifval $val16<99
val18=1
!else
val18=2
!endif

!ifval $val17+$val18<4
val19=1
!else
val19=2
!endif
!readproc slib/text/matrixhtml [	 ,malade,non malade,total;	test positif,Vrai Positif,Faux Positif,\(P);	test négatif,Faux Négatif,Vrai Négatif,\(\overline{P})   ;	total,\(M),\(\overline{M}),\(T)],wimscenter wimsborder,TH=[1;1]  
tmp0=$slib_out
val20=$(tmp0)
!readproc slib/text/matrixhtml [	,malade,non malade,total;	test positif,reply1,reply2,reply3;	test négatif,reply4,reply5,reply6;	total,reply7,reply8,reply9], wimsborder,TH=[1;1] CAPTION="test antigénique nocovformi" 
tmp0=$slib_out
val21=$(tmp0)
!readproc slib/text/matrixhtml [	,malade,non malade,total;	test positif,$val7,$val8,$val10;	test négatif,$val9,$val12,$val11;	total,$val13,$val14,$val6],wimscenter wimsborder,TH=[1;1]  
tmp0=$slib_out
val22=$(tmp0)
oefsteps=reply1, reply2, reply3, reply4, reply5, reply6, reply7, reply8, reply9	    reply10, reply11, reply12, reply13, reply14 
nextstep=!nosubst reply1, reply2, reply3, reply4, reply5, reply6, reply7, reply8, reply9	    reply10, reply11, reply12, reply13, reply14 
!readproc oef/steps.proc
