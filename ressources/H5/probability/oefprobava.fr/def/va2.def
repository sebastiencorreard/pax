!set title=Variable aléatoire - 1 probabilité et 1 valeur manquantes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 7

val8=$[rint($val7+$(tmp0))]
tmp0=!randint 1, 5

val9=$[rint($val8+$(tmp0))]
tmp0=!randint 1, 5

val10=$[rint($val9+$(tmp0))]
tmp0=!randint 1, 7

val11=$[rint($val10+$(tmp0))]
tmp0=!randint 3, 15

val12=$[$(tmp0)/100]
tmp0=!randint 2, 20

val13=$[$(tmp0)/100]
tmp0=!randint 5, 20

val14=$[$(tmp0)/100]
tmp0=!randint 10, 20

val15=$[$(tmp0)/100]
val16=

!ifval ($val6=3)
val17=$[ 1-$val12-$val13]
!else
val17=$[1-$val12-$val13-$val14]
!endif

!ifval ($val6=5)
val17=$[ $val17-$val15]
!else
val17=$[$val17]
!endif

!ifval ($val6=3)
val18=$[ $val12*$val7+$val13*$val8+$val17*$val9]
!else
val18=$[$val12*$val7+$val13*$val8+$val14*$val9+$val17*$val10]
!endif

!ifval ($val6=5)
val18=$[ $val18+$val17*$val11]
!else
val18=$[$val18]
!endif

!ifval ($val6=3)
val19=$[ $val12+$val13]
!else
val19=$[$val12+$val13+$val14]
!endif

!ifval ($val6=5)
val19=$[ $val19+$val15]
!else
val19=$[$val19]
!endif

!ifval ($val6=3)
val20=$[ $val13*$val8+$val17*$val9]
!else
val20=$[$val13*$val8+$val14*$val9+$val17*$val10]
!endif

!ifval ($val6=5)
val20=$[ $val20+$val17*$val11]
!else
val20=$[$val20]
!endif
val21=$[$val18-$val20]
replytype1=numexp
replyname1=\(t)
replygood1=$val17
replytype2=numexp
replyname2=\(a)
replygood2=$val7
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

