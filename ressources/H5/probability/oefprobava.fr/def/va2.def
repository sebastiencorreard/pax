:solution
$()La somme des probabilités est égale à 
!insmath 1
$() donc	
!if $val6=3 
$()
!insmath $val12+$val13+t=1
$() 
!else
$() 
!if $val6=4 
$()
!insmath $val12+$val13+$val14+t=1
$() 
!else
$() 
!insmath $val12+$val13+$val14+$val15+t=1
$() 
!endif
$() 
!endif
$(). D'où 
!insmath t+$val19=1
$() et 
!insmath t=1-$val19=$val17
$().	<br>
!if $val6=3 
$()
!insmath E(X)=$val12 \times a+$val13 \times $val8+$val17 \times $val9
$() 
!else
$() 
!if $val6=4 
$()
!insmath E(X)=$val12 \times a+$val13 \times $val8+$val14 \times $val9+$val17 \times $val10
$() 
!else
$() 
!insmath E(X)=$val12 \times a+$val13 \times $val8+$val14 \times $val9+$val15 \times $val10+$val17 \times $val11
$() 
!endif
$() 
!endif
$()	c'est à dire 
!insmath $val18=$val12 a+$val20
$(). <br>
!insmath $val12 a+$val20=$val18
$() &hArr; 
!insmath $val12 a=$val21
$() &hArr; 
!insmath a=$val7
$().
$()
!exit

