$()Le tableau ci-dessous décrit la loi d'une variable aléatoire 
!insmath X
$().	<div class="wimscenter">	<table class="wimscenter; wimsborder">	   <tr><th>
!insmath x
$()</th><td>
!insmath a
$()</td><td>
!insmath $val8
$()</td><td>
!insmath $val9
$()</td>
!if $val6>=4 
$()<td>
!insmath $val10
$()</td> 
!endif
$()
!if $val6=5 
$()<td>
!insmath $val11
$()</td> 
!endif
$()</tr>	   <tr><th>
!insmath p(X=x)
$()</th><td>
!insmath $val12
$()</td><td>
!insmath $val13
