!set title=Variable aléatoire - espérance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp=!translate ";': to $     $ in $(tmp0)*(-1)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val6=$[rint($(tmp1))]
val7=$[rint(0)]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp=!translate ";': to $     $ in $(tmp0)*0.1

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val9=$[$(tmp1)]
tmp0=!randint 1, 6

tmp=!translate ";': to $     $ in $(tmp0)*0.1

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val10=$[$(tmp1)]
tmp=!translate ";': to $     $ in 1-$val9-$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[$(tmp0)]
tmp=!translate ";': to $     $ in $val6*$val9+$val7*$val10+$val8*$val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$[$(tmp0)]
val13=équilibré,avantageux,désavantageux

!ifval ($val12>0)
val14=$[rint( 2)]
!else
val14=$[rint(3)]
!endif

!ifval ($val12=0)
val14=$[rint( 1)]
!else
val14=$[rint($val14)]
!endif
replytype1=numexp
replyname1=
replygood1=$val12
replytype2=menu
replyname2=
replygood2=$val14;$val13
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Le tableau ci-dessous décrit la loi d'une variable aléatoire 
!insmath X
$().	<div class="wimscenter"><table class="wimscenter; wimsborder">	<tr><th>
!insmath x
$()</th><td>
!insmath $val6
$()</td><td>
!insmath $val7
$()</td><td>
!insmath $val8
$()</td></tr>	<tr><th>
!insmath p(X=x)
$()</th><td>
!insmath $val9
$()</td><td>
!insmath $val10
$()</td><td>
!insmath $val11
$()</td></tr>	</table></div>	L'espérance de 
!insmath X
$() est égale à 
!insmath E(X)
$()= 
!read oef/embed.phtml r1,5 
$().<br>	Si 
!insmath X
$() représente le gain d'un jeu alors ce jeu est  
!read oef/embed.phtml r2 
$() pour le joueur.
$()
!exit

:hint
$()L'espérance de 
!insmath X
$() est la moyenne pondérée des valeurs possibles pour X par les probabilités que X prenne ces valeurs.
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath E(X)=$val6*$val9+$val7*$val10+$val8*$val11=$val12
$().	<br>Un jeu est (pour le joueur) :	<ul>	 <li>équilibré si 
!insmath E(X)=0
$(),</li>	 <li>avantageux si 
!insmath E(X)>0
$(),</li>	 <li>désavantageux si 
!insmath E(X)<0
$().</li>	</ul>	On en déduit que le jeu est $(val13[$val14]).	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,14
embedcnt=2
