:solution
$()<p>
!insmath p(X=0)=(1-$val7)^$val6=$val8^$val6
$()
!if $val19=$val12 
$()
!insmath =$val12
$() 
!else
$() 
!insmath \simeq$val19
$() 
!endif
$().</p>	<p>L'événement 
!insmath X=1
$() est formé des issues 
!if $val6=3 
$()$(val34[1;]) 
!else
$() $(val35[1;]) 
!endif
$(), chacune de probabilité 
!if $val6=3 
$()
!insmath $val7 \times $val8^2
$() 
!else
$() 
!insmath $val7 \times $val8^3
$() 
!endif
$() donc sa probabilité est	
!if $val6=3 
$()
!insmath 3 \times $val7 \times $val8^2
$() 
!else
$() 
!insmath 4 \times $val7 \times $val8^3
$() 
!endif
$()
!if $val22=$val13 
$()
!insmath =$val13
$() 
!else
$() 
!insmath \simeq$val22
$() 
!endif
$().</p>	<p>L'événement 
!insmath X=2
$() est formé des issues 
!if $val6=3 
$()$(val34[2;]) 
!else
$() $(val35[2;]) 
!endif
$(), chacune de probabilité 
!if $val6=3 
$()
!insmath $val7^2 \times $val8
$() 
!else
$() 
!insmath $val7^2 \times $val8^2
$() 
!endif
$() donc sa probabilité est	
!if $val6=3 
$()
!insmath 3 \times $val7^2 \times $val8
$() 
!else
$() 
!insmath 6 \times $val7^2 \times $val8^2
$() 
!endif
$()
!if $val25=$val14 
$()
!insmath =$val14
$() 
!else
$() 
!insmath \simeq$val25
$() 
!endif
$().</p> 	<p>
!if $val6=3 
$()
!insmath p(X=3)=$val7^$val6
$() 
!else
$() L'événement 
!insmath X=3
$() est formé des issues $(val35[3;]), chacune de probabilité 
!insmath $val7^3 \times $val8
$() donc sa probabilité est	
!insmath 4 \times $val7^3 \times $val8
$() 
!endif
$()
!if $val28=$val15 
$()
!insmath =$val15
$() 
!else
$() 
!insmath \simeq$val28
$() 
!endif
$().</p>	
!if $val6=4 
$()<p>
!insmath p(X=4)=$val7^$val6
$()
!if $val31=$val16 
$()
!insmath =$val16
$() 
!else
$() 
!insmath \simeq$val31
$() 
!endif
$().</p> 
!endif
