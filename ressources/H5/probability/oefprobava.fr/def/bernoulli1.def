val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 3,3,3,4,4

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

tmp1=!randint 11, 15

tmp=!nonempty items 0.05*$(tmp0),0.05*$(tmp1)

tmp2=!randitem $tmp
t_=!rawmath $(tmp2)
val7=!exec pari print($t_)
t_=!rawmath 1-$val7
val8=!exec pari print($t_)
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
val10=pile,face
val11=$[rint(3-$val9)]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!randint 1, ($val6-1)

val13=$[rint($(tmp0))]

!ifval ($val13==1)
val14= $val6 $(val10[$val9])s, toujours le même résultat,1 $(val10[$val12]),$val13 seul côté $(val10[$val9])
!else
val14=$val6 $(val10[$val9])s, toujours le même résultat,une fois $(val10[$val12]),$val13 $(val10[$val9])s
!endif
val15=!rawmath $val7^$val6
val16=!rawmath $val15+$val8^$val6

!ifval ($val12==$val9)
val17=!rawmath  1-$val8^$val6
!else
val17=!rawmath 1-$val15
!endif
val18=$[rint(binomial($val6,$val13))]
val19=$[rint($val6-$val13)]
val20=!rawmath $val18*($val7^$val13)*($val8^$val19)
val21=$[rint(3)]
t_=!replace internal \( by ( in round(10^$val21*$val15)/(10^$val21)
tmp0=!exec maxima $t_

val22=$[$(tmp0)]
t_=!replace internal \( by ( in round(10^$val21*$val16)/(10^$val21)
tmp0=!exec maxima $t_

val23=$[$(tmp0)]
t_=!replace internal \( by ( in round(10^$val21*$val17)/(10^$val21)
tmp0=!exec maxima $t_

val24=$[$(tmp0)]
t_=!replace internal \( by ( in round(10^$val21*$val20)/(10^$val21)
tmp0=!exec maxima $t_

val25=$[$(tmp0)]
val26=$(val10[$val9])
val27=$(val10[$val11])
tmp=!trim ($val26-$val27-$val27), ($val27-$val26-$val27), ($val27-$val27-$val26)	($val26-$val26-$val27), ($val26-$val27-$val26), ($val27-$val26-$val26)
val28=!translate internal $	\
$ to ;; in $tmp
tmp=!trim ($val26-$val27-$val27-$val27), ($val27-$val26-$val27-$val27), ($val27-$val27-$val26-$val27), ($val27-$val27-$val27-$val26)	($val26-$val26-$val27-$val27), ($val26-$val27-$val26-$val27), ($val26-$val27-$val27-$val26), ($val27-$val26-$val26-$val27), ($val27-$val26-$val27-$val26), ($val27-$val27-$val26-$val26)	($val26-$val26-$val26-$val27), ($val26-$val26-$val27-$val26), ($val26-$val27-$val26-$val26), ($val27-$val26-$val26-$val26)
val29=!translate internal $	\
$ to ;; in $tmp
val30=$[rint($val6-$val13)]
!readproc slib/stat/binomialpdf [$val13],$val6,$val7 
tmp0=$slib_out
val31=$[rint($(tmp0)/($val7^$val13*$val8^($val6-$val13)))]
replytype1=formal
