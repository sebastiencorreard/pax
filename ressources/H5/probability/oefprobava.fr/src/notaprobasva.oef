\integer{choix1=randint(1,2)}##nombre de bonnes réponses##
\text{listeb1=(\choix1==1)? 1:1,2}##place des bonnes réponses dans la liste data1##
\text{fausses1=wims(shuffle \fausses1)}##mélange des réponses fausses##
\if{\choix1==1}{
\text{bonnes1=\bonnes1[1]}##La bonne réponse déduite de l'énoncé##
\text{fausses1=\fausses1[1]
\fausses1[2]
\fausses1[3]}##3 mauvaises réponses##
}
{
\text{bonnes1=\bonnes1[1]
randitem(\bonnes1[2..items(\bonnes1)])}##2 bonnes réponses##
\text{fausses1=\fausses1[1]
\fausses1[2]}##2 mauvaises réponses##
}
\text{data1=asis(\enonce1
\listeb1
\bonnes1
\fausses1
)}

