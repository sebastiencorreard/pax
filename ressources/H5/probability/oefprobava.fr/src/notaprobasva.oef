\title{Notation de probabilités avec une variable aléatoire}
\author{David,Rousseau}
\email{david.rousseau@ac-amiens.fr}
\language{fr}
\computeanswer{no}
\format{html}


\text{instruction=asis(Lors d'un contrôle de qualité, on note \(X) la variable aléatoire discrète dénombrant le nombre de pièces défectueuses observées.
\(X) prend donc des valeurs entières.
<br>Pour chaque question, indiquer <u>toutes les bonnes réponses</u>.)}

\text{alea=oui}
\text{N=4}##Nombre maximum de questions par étape##
\text{MAX=1}##Nombre maximum d'étapes - au final 4 questions affichées en une fois##

\integer{a=randint(2..5)}
\integer{a1=\a+1}
\integer{a2=\a-1}
\integer{b=randint(9..11)}
\integer{b1=\b+1}
\integer{b2=\b-1}

##PARAMETRAGE QUESTIONS##
\text{enonce1=La probabilité que dans cet échantillon il y ait au moins \(\a) pièces défectueuses est :}
\text{bonnes1=\(P(X\geq \a)),\(P(X>\a2)),\(1-P(X\leq \a2))}
\text{fausses1=\(P(X>\a)),\(P(X<\a)),\(P(X\leq \a)),\(P(X\leq \a2)),\(1-P(X\leq \a))}

\text{enonce2=La probabilité que dans cet échantillon il y ait plus de \(\a) pièces défectueuses est :}
\text{bonnes2=\(P(X> \a)),\(P(X\geq\a1)),\(1-P(X\leq\a)),\(1-P(X< \a1))}
\text{fausses2=\(P(X\geq \a)),\(1-P(X\leq \a2)),\(P(X\leq \a)),\(P(X< \a1))}

\text{enonce3=La probabilité que dans cet échantillon il y ait moins de \(\a) pièces défectueuses est:}
\text{bonnes3=\(P(X<\a)),\(P(X\leq \a2))}
\text{fausses3=\(P(X\leq \a)),\(P(X\geq \a)),\(P(X\leq \a1))}

\text{enonce4=La probabilité que dans cet échantillon il y ait au plus \(\a) pièces défectueuses est :}
\text{bonnes4=\(P(X\leq \a)),\(P(X<\a1)),\(1-P(X\geq \a1))}
\text{fausses4=\(P(X< \a)),\(P(X> \a)),\(P(X\leq \a2)),\(P(X\leq \a1))}

\text{enonce5=La probabilité que dans cet échantillon il y ait plus de \(\a) pièces défectueuses mais moins de \(\b) est :}
\text{bonnes5=\(P(\a< X<\b)),\(P(\a1\leq X<\b)),\(P(\a1\leq X\leq \b2)\),\(P(X\leq \b2)-P(X\leq \a)\)}
\text{fausses5=\(P(\a1< X<\b)),\(P(\a\leq X\leq \b)),\(P(\a\leq X\leq \b2)),\(P(\a2\leq X\leq \b1))}

\text{enonce6=La probabilité que dans cet échantillon il y ait au moins \(\a) pièces défectueuses mais moins de \(\b) est :}
\text{bonnes6=\(P(\a\leq X<\b)),\(P(\a2< X<\b)\),\(P(\a \leq X \leq\b2)\),\(P(\a2< X<\b)),\(P(X\leq \b2)-P(X\leq \a2)),\(P(X<\b)-P(X< \a))}
\text{fausses6=\(P(\a< X<\b)),\(P(\a1\leq X\leq \b2)),\(P(\a< X\leq \b2)),\(P(X\leq\b)-P(X\leq \a))}

\text{enonce7=La probabilité que dans cet échantillon il y ait entre \(\a) et \(\b) pièces défectueuses (\(\a\) et \(\b\) incluses) est :}
\text{bonnes7=\(P(\a\leq X\leq\b)),\(P(\a2 <X<\b1)),\(P(X\leq\b)-P(X\leq \a2))}
\text{fausses7=\(P(\a<X<\b)),\(P(\a1\leq X\leq\b2)),\(P(\a1< X<\b2)),\(P(\a2\leq X\leq\b1)),\(P(X\leq\b)-P(X\leq \a))}
########################

