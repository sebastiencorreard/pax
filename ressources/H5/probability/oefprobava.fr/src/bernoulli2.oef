\title{Schéma de Bernoulli 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{yes}
\precision{100000}

\integer{n=randint(6..12)}##Nombre d'épreuves##
\rational{p=randitem(0.05*randint(5..9);0.05*randint(11..15))}##Probabilité du succès##
\rational{q=1-\p}

##Choix du succès##
\integer{q1=randint(1,2)}
\text{succes=pile,face}

##Paramètres questions##
\integer{q2=randint(1,2)}
\integer{q3=randint(1,2)}
\text{questions=\n \succes[\q2]s,au moins une fois \succes[\q3]}

##Réponses##
\text{rep1=(\q2=\q1)? (\p)^(\n):(\q)^(\n)}
\text{rep2=(\q3=\q1)? 1-(\q)^(\n):1-(\p)^(\n)}

\statement{On dispose d'une pièce truquée qui, à chaque fois qu'on la lance, donne "\succes[\q1]" avec une probabilité égale à \(\p\). On lance cette pièce \n fois de suite.
<ol><li>Calculer la probabilité d'avoir \questions[1] : \embed{reply1,6}</li>
<li>Calculer la probabilité d'avoir \questions[2]  : \embed{reply2,6}</li></ol>
<div class="wims_instruction">On donnera le calcul (par exemple 4*0.8^6) ou la valeur exacte des probabilités. <u>Pas de valeur approchée</u>. </div>
}
\answer{}{\rep1}{type=formal}
\answer{}{\rep2}{type=formal}

\solution{<p>1&#41;La probabilité d'avoir \questions[1] est \if{\q2=\q1}{\(\p^{\n}\)}{\((1-\p)^{\n}=\q^{\n}\)}.</p>
<p>2&#41;L'événement "avoir \questions[2]" est l'événement contraire de l'événement \if{\q3=\q1}{"n'avoir que des \succes[3-\q1]s"}{"n'avoir que des \succes[\q1]s"}
donc sa probabilité est \if{\q3=\q1}{\(1-\q^{\n}\)}{\(1-\p^{\n}\)}.}
