\title{Variable aléatoire - espérance}
\language{fr}
\author{Cyrille,Douriez}##d'après une proposition de Bérangère Prévost##
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{x1=simplify(randint(1..5)*(-1))}
\integer{x2=0}
\integer{x3=randint(1..5)}
\real{p1=simplify(randint(1..3)*0.1)}
\real{p2=simplify(randint(1..6)*0.1)}
\real{p3=simplify(1-\p1-\p2)}

\real{esperance=simplify(\x1*\p1+\x2*\p2+\x3*\p3)}
\text{textavantage=équilibré,avantageux,désavantageux}
\integer{avantage=(\esperance>0)? 2:3}
\integer{avantage=(\esperance=0)? 1:\avantage}

\statement{Le tableau ci-dessous décrit la loi d'une variable aléatoire \(X\).
<div class="wimscenter"><table class="wimscenter; wimsborder">
<tr><th>\(x\)</th><td>\(\x1\)</td><td>\(\x2\)</td><td>\(\x3\)</td></tr>
<tr><th>\(p(X=x)\)</th><td>\(\p1\)</td><td>\(\p2\)</td><td>\(\p3\)</td></tr>
</table></div>
L'espérance de \(X) est égale à \(E(X))=\embed{r1,5}.<br>
Si \(X) représente le gain d'un jeu alors ce jeu est \embed{r2} pour le joueur.}
\answer{}{\esperance}{type=numexp}
\answer{}{\avantage;\textavantage}{type=menu}

\hint{L'espérance de \(X\) est la moyenne pondérée des valeurs possibles pour X par les probabilités que X prenne ces valeurs.}

\solution{\(E(X)=\x1*\p1+\x2*\p2+\x3*\p3=\esperance).
<br>Un jeu est (pour le joueur) :
<ul>
 <li>équilibré si \(E(X)=0),</li>
 <li>avantageux si \(E(X)>0),</li>
 <li>désavantageux si \(E(X)<0).</li>
</ul>
On en déduit que le jeu est \textavantage[\avantage].
}
