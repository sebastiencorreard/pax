 \text{tU2=\(U_2=\lbrace ZZ;AZ;ZA;IZ;ZI;AA;AI;IA;II\rbrace\)}
 \text{tU1=\(U_1=\lbrace Z1Z1;Z2Z2;Z1Z2;Z2Z1;AZ1;Z1A;IZ1;Z1I;AZ2;Z2A;IZ2;Z2I;AA;AI;IA;II\rbrace\)}
