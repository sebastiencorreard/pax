!set title=Loi de probabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes en utilisant des fractions.
tmp0=!randint 3, 6

val7=$[rint($(tmp0))]
tmp0=!randint 3, 6

val8=$[rint($(tmp0))]

!ifval $val7=$val8
val8=$[rint($val8+1)]
!endif
tmp0=!randint 20, 30

val9=$[rint($(tmp0))]
tmp0=!randitem 50,80,100

val10=$[rint($(tmp0)-$val9)]
tmp0=!randint 36, 42

val11=$[rint($(tmp0)*1000)]
tmp0=!randint 200, 300

val12=$[rint($(tmp0))]
tmp0=!randint 20, 40

val13=$[rint($(tmp0))]
val14=un,deux,trois,quatre,cinq,six,sept,huit,neuf,dix
val15=« Survivre une heure sous un mètre de neige »,On a une chance sur $(val14[$val7]) de survivre une heure sous un mètre de neige,1/$val7	  « Partir en vacances d'hiver »,Un français sur $(val14[$val8]) part en vacances d'hiver,1/$val8	  « Être une femme »,Dans cette assemblée&#44; il y a $val9 femmes pour $val10 hommes,$val9/($val9+$val10)	  « Présenter un défaut »,$val11 voitures sont sorties en l'an 2000 de la chaîne de montage de cette entreprise dont $val12 présentaient un défaut,$val12/$val11	  « Faire de l'équitation »,Dans ce club de vacances&#44; $val13 % des personnes font de l'équitation,0.$val13	
tmp0=!shuffle 5

val16=$(tmp0)
val17=
val18=
val19=
!for val20 =1 to 3 
tmp=!translate internal $	$ to ; in $val15

tmp=!row $(val16[$val20]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
tmp0=!append item $(val21[1]) to $val17

val17=$(tmp0)
tmp0=!append item $(val21[2]) to $val18

val18=$(tmp0)
t_=!rawmath $(val21[3])
val22=!exec pari print($t_)
tmp0=!append item $val22 to $val19

val19=$(tmp0)
!next
replytype1=numexp
replyname1=Phrase 1
replygood1=$(val19[1])
replytype2=numexp
replyname2=Phrase 2
replygood2=$(val19[2])
replytype3=numexp
replyname3=Phrase 3
replygood3=$(val19[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Traduire, en termes de probabilité, les phrases suivantes	correspondant à l'événement 
!insmath A
$() :	<div class="wims_question">	<ol>	<li>
!insmath A
$() $(val17[1])<br>	 $(val18[1]) : <label for="reply1">
!insmath P(A)=
$()</label> 
!read oef/embed.phtml reply1,7 
$()</li>	<li>
!insmath A
$() $(val17[2])<br>	 $(val18[2]) : <label for="reply2">
!insmath P(A)=
$()</label> 
!read oef/embed.phtml reply2,7 
$()</li>	<li>
!insmath A
$() $(val17[3])<br>	 $(val18[3]) : <label for="reply3">
!insmath P(A)=
$()</label> 
!read oef/embed.phtml reply3,7 
$()</li>	</ol></div>	
$()
!exit

