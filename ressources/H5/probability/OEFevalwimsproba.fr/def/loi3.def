!set title=Loi de probabilité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes en utilisant des fractions.
tmp0=!randint 5, 10

val7=$[rint($(tmp0))]
tmp0=!randitem 5,10,15,20

val8=$[rint($(tmp0)+2*$val7)]
val9=$[rint(2*$val8)]
val10=$[rint($val9+$val7+$val8)]
t_=!rawmath $val9/$val10
val11=!exec pari print($t_)
t_=!rawmath $val7/$val10
val12=!exec pari print($t_)
t_=!rawmath $val8/$val10
val13=!exec pari print($t_)
replytype1=numexp
replyoption1=noreduction 
replyname1=p(Vert)
replygood1=$val11
replytype2=numexp
replyoption2=noreduction 
replyname2=p(Orange)
replygood2=$val12
replytype3=numexp
replyoption3=noreduction 
replyname3=p(rouge)
replygood3=$val13
replytype4=numeric
replyname4=Total
replygood4=$[1]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le cycle d'allumage d'un feu tricolore est le suivant :<br>	Feu vert pendant $val9 secondes, feu orange pendant $val7 secondes, feu rouge pendant $val8 secondes	<div class="wims_question">	En admettant qu'un automobiliste arrive au hasard devant	 l'une des trois positions possibles du feu tricolore, déterminer	 la loi de probabilité de cette expérience aléatoire.	<table class="wimscenter wimsborder">	<tr><th>Feu</th><th>Vert</th><th>Orange</th><th>Rouge</th><th>Total</th></tr>	<tr><th>Probabilité</th><td> 
!read oef/embed.phtml reply1,3 
$()</td><td> 
!read oef/embed.phtml reply2,3 
$()</td>	<td> 
!read oef/embed.phtml reply3,3 
$()</td><td> 
!read oef/embed.phtml reply4,3 
$()</td></tr>	</table></div>	<div class="wims_instruction">$val6</div>	
$()
!exit

