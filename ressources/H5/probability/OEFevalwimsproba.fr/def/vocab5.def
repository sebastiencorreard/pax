val8=Oui,Non
val9=Les événements
val10=et
val11=sont-ils
val12=contraires 
val13=incompatibles 
tmp=!trim On lance deux dés cubiques équilibrés, dont les faces sont numérotées de 1 à 6.	 On s'intéresse aux numéros visibles sur la face supérieure de chaque dé lorsque ceux-ci ne bougent plus.	 On considère les événements suivants 
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,3,5

val15=$(tmp0)
tmp0=!randint 3, 10

val16=$(tmp0)
tmp0=!randint 2, 12

val17=$(tmp0)

!ifval $val17>$val16
val18=$[rint(2)]
!else
val18=$[rint(1)]
!endif
tmp=!trim Obtenir exactement un numéro $val15	Obtenir au moins un numéro $val15	Obtenir au plus un numéro $val15	Obtenir deux nombres pairs	Obtenir une somme supérieure strictement à $val16	Obtenir une somme inférieure ou égale à $val16	Obtenir une somme égale à $val17
val19=!translate internal $	\
$ to ;; in $tmp
