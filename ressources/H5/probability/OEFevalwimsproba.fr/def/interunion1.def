!set title=Union et intersection d'événements 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes en utilisant des fractions.
tmp0=!randitem 20,25,32,40

val7=$[rint($(tmp0))]
tmp0=!randint 10, $val7-6

val8=$[rint($(tmp0))]
val9=$[rint($val7-$val8)]
tmp0=!randint 5, $val8

val10=$[rint($(tmp0))]
tmp0=!randint 5, $val9

val11=$[rint($(tmp0))]
val12=$[rint($val8-$val10)]
val13=$[rint($val9-$val11)]
val14=$[rint($val10+$val11)]
val15=$[rint($val12+$val13)]
t_=!rawmath $val10/$val7
val16=!exec pari print($t_)
t_=!rawmath $val12/$val7
val17=!exec pari print($t_)
t_=!rawmath $val11/$val7
val18=!exec pari print($t_)
t_=!rawmath $val13/$val7
val19=!exec pari print($t_)
t_=!rawmath $val9/$val7
val20=!exec pari print($t_)
t_=!rawmath $val15/$val7
val21=!exec pari print($t_)
replytype1=numexp
replyoption1=noreduction 
replyname1=un garçon
replygood1=$val20
replytype2=numexp
replyoption2=noreduction 
replyname2=une fille n'apprenant pas l'espagnol
replygood2=$val17
replytype3=numexp
replyoption3=noreduction 
replyname3=un garçon apprenant l'espagnol
replygood3=$val18
replytype4=numexp
replyoption4=noreduction 
replyname4=un élève n'apprenant pas l'espagnol
replygood4=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Dans une classe de 1ère S de $val7 élèves, il y a $val8 filles	et $val11 des $val14 élèves qui apprennent l'espagnol sont des garçons.	</p>		<p>On a complété le tableau à double entrée en nombres d'élèves.</p>	<table class="wimscenter wimsborder">	<tr><td>&nbsp;</td><th>Filles</th><th>Garçons</th><th>Total</th></tr>	<tr><th>apprenant l'espagnol</th><td>$val10</td><td>$val11</td><td>$val14</td></tr>	<tr><th>n'apprenant pas l'espagnol</th><td>$val12</td><td>$val13</td><td>$val15</td></tr>	<tr><th>Total</th><td>$val8</td><td>$val9</td><td>$val7</td></tr>	</table>	 On tire au hasard un élève de cette classe.	<div class="wims_question">Déterminer les probabilités des événements suivants :	<ul>	<li>
!insmath A
$() « c'est un garçon » :  
!read oef/embed.phtml reply1,3 
$()</li>	<li>
!insmath B
$() « c'est une fille n'apprenant pas l'espagnol » :  
!read oef/embed.phtml reply2,3 
$()</li>	<li>
!insmath C
$() « c'est un garçon apprenant l'espagnol » :  
!read oef/embed.phtml reply3,3 
$()</li>	<li>
!insmath D
$() « c'est un élève n'apprenant pas l'espagnol » :  
!read oef/embed.phtml reply4,3 
$()</li>	</ul></div>	<div class="wims_instruction">$val6</div>	
$()
