val6=Donner les valeurs sous forme de fractions.
tmp0=!randint 1, 6

val7=$[rint($(tmp0))]
tmp0=!randitem pairs,impairs

val8=$(tmp0)
tmp0=!randint 1, 6

val9=$[rint($(tmp0))]
val10=$[rint($val7+$val9)]
tmp0=!randint 1, 6

val11=$[rint($(tmp0))]
val12=$[rint($val11+$val9)]
val13=0,1,2,3,4,5,6,5,4,3,2,1
