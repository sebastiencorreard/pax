val16=!exec pari print($t_)
t_=!rawmath 1/4
val17=!exec pari print($t_)
t_=!rawmath 0
val18=!exec pari print($t_)
!for val19 =$val10+1 to 12 
t_=!rawmath $val18+$(val13[$val19])
val18=!exec pari print($t_)
!next
t_=!rawmath $val18/36
val18=!exec pari print($t_)
t_=!rawmath $(val13[$val12])/36
val20=!exec pari print($t_)
