tmp0=!randint 5, 300-$val10

val11=$[rint($(tmp0))]
val10=$[rint($val10+$val11)]
tmp0=!randint 2, 340-$val10

val12=$[rint($(tmp0))]
val10=$[rint($val10+$val12)]
val13=$[rint(360-$val10)]
tmp0=!shuffle $val7,$val8,$val9,$val11,$val12,$val13

val14=$(tmp0)
val15=$(val14[1]),$(val14[1])+$(val14[2]),$(val14[1])+$(val14[2])+$(val14[3]),$(val14[1])+$(val14[2])+$(val14[3])+$(val14[4]),$(val14[1])+$(val14[2])+$(val14[3])+$(val14[4])+$(val14[5])
tmp0=!shuffle red,green,blue,orange,yellow,gray,pink

val16=$(tmp0)
val17=xrange -5,5	 yrange -5,5	 circle 0,0,200,black	 segment 0,0,5,0,black	 segment 0,0,5*cos($(val14[1])*pi/180),5*sin($(val14[1])*pi/180),black	 fill 2*cos($(val14[1])*pi/360),2*sin($(val14[1])*pi/360),$(val16[1])	 segment 0,0,5*cos(($(val15[2]))*pi/180),5*sin(($(val15[2]))*pi/180),black	 fill 3*cos(($(val14[1])+$(val14[2])/2)*pi/180),3*sin(($(val14[1])+$(val14[2])/2)*pi/180),$(val16[2])	 segment 0,0,5*cos(($(val15[3]))*pi/180),5*sin(($(val15[3]))*pi/180),black	 fill 3*cos(($(val15[2])+$(val14[3])/2)*pi/180),3*sin(($(val15[2])+$(val14[3])/2)*pi/180),$(val16[3])	 segment 0,0,5*cos(($(val15[4]))*pi/180),5*sin(($(val15[4]))*pi/180),black	 fill 3*cos(($(val15[3])+$(val14[4])/2)*pi/180),3*sin(($(val15[3])+$(val14[4])/2)*pi/180),$(val16[4])	 segment 0,0,5*cos(($(val15[5]))*pi/180),5*sin(($(val15[5]))*pi/180),black	 fill 3*cos(($(val15[4])+$(val14[5])/2)*pi/180),3*sin(($(val15[4])+$(val14[5])/2)*pi/180),$(val16[5])	 fill 3*cos(($(val15[5])+$(val14[6])/2)*pi/180),3*sin(($(val15[5])+$(val14[6])/2)*pi/180),$(val16[6])	 text black,3*cos(($(val14[1])/2)*pi/180),3*sin(($(val14[1])/2)*pi/180),medium,A	 text black,3*cos(($(val14[1])+$(val14[2])/2)*pi/180),3*sin(($(val14[1])+$(val14[2])/2)*pi/180),medium,B	 text black,3*cos(($(val15[2])+$(val14[3])/2)*pi/180),3*sin(($(val15[2])+$(val14[3])/2)*pi/180),medium,C	 text black,3*cos(($(val15[3])+$(val14[4])/2)*pi/180),3*sin(($(val15[3])+$(val14[4])/2)*pi/180),medium,D	 text black,3*cos(($(val15[4])+$(val14[5])/2)*pi/180),3*sin(($(val15[4])+$(val14[5])/2)*pi/180),medium,E	 text black,3*cos(($(val15[5])+$(val14[6])/2)*pi/180),3*sin(($(val15[5])+$(val14[6])/2)*pi/180),medium,F	
val18=$(val14[1])/360,$(val14[2])/360,$(val14[3])/360,$(val14[4])/360,$(val14[5])/360,$(val14[6])/360
