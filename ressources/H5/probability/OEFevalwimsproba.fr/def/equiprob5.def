!set title=Cas de l'équiprobabilité 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs sous forme de fractions.
tmp0=!randint 8, 15

val7=$[rint($(tmp0))]
tmp0=!randint 5, $val7-1

val8=$[rint($(tmp0))]
tmp0=!randint 2, $val8-1

val9=$[rint($(tmp0))]
t_=!rawmath $val8/$val7
val10=!exec pari print($t_)
t_=!rawmath ($val7-$val9+1)/$val7
val11=!exec pari print($t_)
t_=!rawmath ($val8-$val9+1)/$val7
val12=!exec pari print($t_)
replytype1=numexp
replyname1=Valeur de \(n\)
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On a disposé dans une urne 
!insmath $val7
$() boules indiscernables numérotées de 
!insmath 1
$() à 
!insmath $val7
$().<br>	On choisit au hasard une boule dans cette urne.</p>	 On considère les événements :	<ul class="wims_nopuce">	<li>A « le numéro de la boule tirée est inférieur ou égal à 
!insmath $val8
$() ». </li>	<li>B « le numéro de la boule tirée est supérieur ou égal à 
!insmath n
$() »,	 où 
!insmath n
$() est un entier compris entre 
!insmath 1
$() et 
!insmath $val8
$().</li>	</ul>	<div class="wims_question">Déterminer la valeur de l'entier 
!insmath n
$(), sachant que 
!insmath P( A \cap B)=$val12
$().	<div class="wimscenter"> <label for="reply1">
!insmath n =
$()</label> 
!read oef/embed.phtml reply1,3 
$().</div>	</div>	
$()
!exit

