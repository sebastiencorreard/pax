!set title=Vocabulaire univers et événement 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Taper "vide" s'il n'y a pas d'élément ; s'il y a plusieurs éléments, les séparer par une virgule.
val7=Séparer les éléments de chaque ensemble par une virgule.
tmp0=!randint 15, 25

val8=$[rint($(tmp0))]
tmp0=!makelist x for x=1 to $val8

val9=$(tmp0)
val10=$[rint(floor($val8/2))]
val11=
!for val12 =1 to $val10 
val13=$[rint(2*$val12)]
tmp0=!append item $val13 to $val11

val11=$(tmp0)
!next
val14=$[rint(floor($val8/4))]
val15=
!for val12 =1 to $val14 
val13=$[rint(4*$val12)]
tmp0=!append item $val13 to $val15

val15=$(tmp0)
!next
val16=$[rint(floor($val8/5))]
val17=
!for val12 =1 to $val16 
val13=$[rint(5*$val12)]
tmp0=!append item $val13 to $val17

val17=$(tmp0)
!next
tmp0=!listcomplement $val15 in $val11

val18=$(tmp0)
val19=vide
tmp0=!listintersect $val11 and $val17

val20=$(tmp0)
val21=$val15
val22=15

!ifval $val8>=20
val23=8
!else
val23=6,8
!endif
val24=$val15
val25=$val11
val26=$val20
tmp0=!listunion $val11 and $val17

val27=$(tmp0)
val28=vide
val29=$val11,15
val30=15
val31=$val17
val32=$[rint(2*$val8)]
replytype1=fset
replyname1=\(A \cap B)
replygood1=$val24
replytype2=fset
replyname2=\(A \cup B)
replygood2=$val25
replytype3=fset
replyname3=\(A \cap C)
replygood3=$val26
replytype4=fset
replyname4=\(A \cup C)
replygood4=$val27
replytype5=fset
replyname5=\(A \cap H)
replygood5=$val28
replytype6=fset
replyname6=\(A \cup H)
replygood6=$val29
replytype7=fset
replyname7=\(C \cap H)
replygood7=$val30
replytype8=fset
replyname8=\(C \cup H)
replygood8=$val31
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On choisit au hasard un nombre entier entre 1 et $val8.</p>	On considère les événements suivants :	<ul class="wims_nopuce">	<li>A « le nombre tiré est un multiple de 2 » </li>	<li>B « le nombre tiré est un multiple de 4 » </li>	<li>C « le nombre tiré est un multiple de 5 » </li>	<li>D « le nombre tiré est un multiple de 2 mais pas de 2 » </li>	<li>E « le nombre tiré est un multiple de 4 mais pas de 2 » </li>	<li>F « le nombre tiré est un multiple de 2 et de 5 » </li>	<li>G « le nombre tiré est un multiple de 2 et de 4 » </li>	<li>H « le nombre tiré est 15 » </li>	</ul>	<div class="wims_question">	  Décrire de façon ensembliste les événements suivants :	<ol>	<li> <label for="reply1">
!insmath A \cap B
$()</label> =  
!read oef/embed.phtml reply1 
$()</li>	<li> <label for="reply2">
!insmath A \cup B
$()</label> =  
!read oef/embed.phtml reply2 
$()</li>	<li> <label for="reply3">
!insmath A \cap C
$()</label> =  
!read oef/embed.phtml reply3 
$()</li>	<li> <label for="reply4">
!insmath A \cup C
$()</label> =  
!read oef/embed.phtml reply4 
$()</li>	<li> <label for="reply5">
!insmath A \cap H
$()</label> =  
!read oef/embed.phtml reply5 
$()</li>	<li> <label for="reply6">
!insmath A \cup H
$()</label> =  
!read oef/embed.phtml reply6 
$()</li>	<li> <label for="reply7">
!insmath C \cap H
$()</label> =  
!read oef/embed.phtml reply7 
$()</li>	<li> <label for="reply8">
!insmath C \cup H
$()</label> =  
!read oef/embed.phtml reply8 
$()</li>	</ol>	</div>	<div class="wims_instruction">$val6</div>	
$()
!exit

