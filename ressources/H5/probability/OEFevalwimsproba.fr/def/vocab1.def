!set title=Vocabulaire univers et événement 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Taper "vide" s'il n'y a pas d'élément ; s'il y a plusieurs éléments, les séparer par une virgule.
val7=Séparer les éléments de chaque ensemble par une virgule.
tmp0=!randint 15, 25

val8=$[rint($(tmp0))]
tmp0=!makelist x for x=1 to $val8

val9=$(tmp0)
val10=$[rint(floor($val8/2))]
val11=
!for val12 =1 to $val10 
val13=$[rint(2*$val12)]
tmp0=!append item $val13 to $val11

val11=$(tmp0)
!next
val14=$[rint(floor($val8/4))]
val15=
!for val12 =1 to $val14 
val13=$[rint(4*$val12)]
tmp0=!append item $val13 to $val15

val15=$(tmp0)
!next
val16=$[rint(floor($val8/5))]
val17=
!for val12 =1 to $val16 
val13=$[rint(5*$val12)]
tmp0=!append item $val13 to $val17

val17=$(tmp0)
!next
tmp0=!listcomplement $val15 in $val11

val18=$(tmp0)
val19=vide
tmp0=!listintersect $val11 and $val17

val20=$(tmp0)
val21=$val15
val22=15

!ifval $val8>=20
val23=8
!else
val23=6,8
!endif
val24=$val15
val25=$val11
val26=$val20
tmp0=!listunion $val11 and $val17

val27=$(tmp0)
val28=vide
val29=$val11,15
val30=15
val31=$val17
val32=$[rint(2*$val8)]
val33=A,B,C,D,E,F,G,H
replytype1=fset
replyname1=univers
replygood1=$val9
replytype2=fset
replyname2=multiple de 2
replygood2=$val11
replytype3=fset
replyname3=multiple de 4
replygood3=$val15
replytype4=fset
replyname4=multiple de 5
replygood4=$val17
replytype5=fset
replyname5=multiple de 2 et pas de 4
replygood5=$val18
replytype6=fset
replyname6=multiple de 4 et pas de 2
replygood6=$val19
replytype7=fset
replyname7=multiple de 2 et de 5
replygood7=$val20
replytype8=fset
replyname8=multiple de 2 et de 4
replygood8=$val21
replytype9=fset
replyname9=le nombre est 15
replygood9=$val22
replytype10=checkbox
replyname10=événement élémentaire
replygood10=$val23;$val33
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On choisit au hasard un nombre entier entre 1 et $val8.	<div class="wims_question">	<ol>	<li>Quel est l'univers ? 
!insmath \Omega =
$()  
!read oef/embed.phtml reply1,$val32 
$()</li>	</ol>	<div class="wims_instruction">Ecrire les éléments de l'univers en les séparant par une virgule.</div>	<ol start="2">	<li>Décrire de façon ensembliste les événements suivants :	<ul>	<li><label for="reply2">A « le nombre tiré est un multiple de 2 »</label> :  
!read oef/embed.phtml reply2,$val8 
$()</li>	<li><label for="reply3">B « le nombre tiré est un multiple de 4 »</label> :  
!read oef/embed.phtml reply3,$val8 
$()</li>	<li><label for="reply4">C « le nombre tiré est un multiple de 5 »</label> :  
!read oef/embed.phtml reply4,$val8 
$()</li>	<li><label for="reply5">D « le nombre tiré est un multiple de 2 mais pas de 4 »</label> :  
!read oef/embed.phtml reply5,$val8 
$()</li>	<li><label for="reply6">E « le nombre tiré est un multiple de 4 mais pas de 2 »</label> :  
!read oef/embed.phtml reply6,$val8 
$()</li>	<li><label for="reply7">F « le nombre tiré est un multiple de 2 et de 5 »</label> :  
!read oef/embed.phtml reply7,$val8 
$()</li>	<li><label for="reply8">G « le nombre tiré est un multiple de 2 et de 4 »</label> :  
!read oef/embed.phtml reply8,$val8 
$()</li>	<li><label for="reply9">H « le nombre tiré est 15 »</label> :  
!read oef/embed.phtml reply9,$val8 
$()</li>	</ul></li></ol>	<div class="wims_instruction">$val6</div>	<ol start="3">	<li>Quels sont les événements élémentaires parmi les événements A à H ?	<div class="wimscenter"> 
!read oef/embed.phtml reply10 
$()</div></li></ol>	<div class="wims_instruction">Sélectionner toutes les événements élémentaires.</div>	</div>	
