!insmath A
$() et 
!insmath B
$() tels que	</p>	<div class="wimscenter">$val19.</div>	<div class="wims_question">	Calculer :	<ul>	<li><label for="reply1">$(val16[1])</label>= 
!read oef/embed.phtml reply1,3 
$()</li>	</ul>	</div>	
$()
