!set title=Union et intersection d'événements 0
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 80

val6=$[$(tmp0)/100]
val7=$[1-$val6]
tmp0=!randint 20, 80

val8=$[$(tmp0)/100]

!ifval $val6>$val8
tmp0=!randint 0, $val8*100

val9=$[$(tmp0)/100]
!else
tmp1=!randint 0, $val6*100

val9=$[$(tmp1)/100]
!endif
val10=$[$val6+$val8-$val9]
!if $val10>1 
val10=$[1]
val9=$[$val6+$val8-$val10]

!ifval abs($val9)<0.001
val9=$[0]
!endif
!endif
val11=\(P(A)\),$val6	\(P(B)\),$val8	\(P(A \cup B)\),$val10	\(P(A \cap B)\),$val9	
val12=
tmp0=!shuffle 4

val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row $(val13[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=$[$(val14[2])]
val16=$(val14[1])
val17=$(val14[2])
!for val18 =2 to 4 
tmp=!translate internal $	$ to ; in $val11

tmp=!row $(val13[$val18]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=$[$(val14[2])]
tmp0=!append item $(val14[1]) to $val16

val16=$(tmp0)
tmp0=!append item $val15 to $val17

val17=$(tmp0)
!next
val19=$(val16[4])\(=$(val17[4])\), $(val16[2])\(=$(val17[2])\) et $(val16[3])\(=$(val17[3])\)
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)/2

val13=$(tmp1)
!for val18 =1 to \nb 
tmp0=!randitem 1,0

tmp=!translate internal $	$ to ; in $val11

tmp=!row 2*$val18+$(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val14=$(tmp1)
val15=$[$(val14[2])]
tmp0=!append item $(val14[1]) to $val16

val16=$(tmp0)
tmp0=!append item $val15 to $val17

val17=$(tmp0)
!next
replytype1=numexp
replyname1=$(val16[1])
replygood1=$(val17[1])
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

