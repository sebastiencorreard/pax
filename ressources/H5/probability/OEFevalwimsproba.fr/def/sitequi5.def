!set title=Univers et équiprobabilité 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 6

val6=$[rint($(tmp0))]
val7=$[rint($val6^2)]
tmp0=!makelist x for x=1 to $val6

val8=$(tmp0)
val9=
!for val10 =1 to $val6 
!for val11 =$val10 to $val6 
val12=$val10 et $val11
tmp0=!append item $val12 to $val9

val9=$(tmp0)
!next
!next
replytype1=numexp
replyname1=Cardinal de \(U1\)
replygood1=$val7
replytype2=radio
replyname2=Univers équiprobable
replygood2=1;\(U_1\),\(U_2\)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Deux urnes indiscernables contiennent chacune $val6 boules numérotées de 1 à $val6.	On tire au hasard, simultanément, une boule dans chaque urne.	</p>	Pour modéliser cette expérience on considère les deux univers suivants :	<ul>	<li>
!insmath U_1
$() l'ensemble de tous les couples formés avec des éléments de l'ensemble 
!insmath \lbrace $val8 \rbrace
$().	</li>	<li>
!insmath U_2=\lbrace $val9 \rbrace
$()	</li>	</ul>	<div class="wims_question">	<ol><li><label for="reply1">Combien l'univers 
!insmath U_1
$() contient-il d'éléments</label> ?  
!read oef/embed.phtml reply1,5 
$().	</li><li>	Auquel de ces deux univers peut-on associer une loi de probabilité équirépartie ?	<div class="wimscenter">  
!read oef/embed.phtml reply2 
$()</div>	</li></ol>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9
embedcnt=2
