val6=Donner les valeurs exactes en utilisant des fractions.
tmp0=!randint 1, 4

val7=$[rint($(tmp0))]
val8=$[rint($val7+3)]
val9=$[rint(2*$val7)]
val10=
!for val11 =1 to 7 
tmp0=!append item $val9 to $val10

val10=$(tmp0)
val9=$[rint($val9+1)]
!next
val12=1/16,1/8,3/16,1/4,3/16,1/8,1/16
t_=!rawmath 0
val13=!exec pari print($t_)
t_=!rawmath 0
val14=!exec pari print($t_)
!for val11 =1 to 7 
t_=!rawmath $val13+$(val12[$val11])*$(val10[$val11])
val13=!exec pari print($t_)
t_=!rawmath $val14+$(val12[$val11])*($(val10[$val11]))^2
val14=!exec pari print($t_)
!next
t_=!rawmath $val14-$val13^2
val14=!exec pari print($t_)
val15=$[sqrt($val14)]
replytype1=numexp
replyoption1=noreduction 
replyname1=p1
replygood1=$(val12[1])
