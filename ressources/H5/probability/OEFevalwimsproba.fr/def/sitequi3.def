!set title=Univers et équiprobabilité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
!if $val6=1 
val7=On choisit au hasard une famille de deux enfants.<br />	 On s'intéresse au sexe de chaque enfant (on suppose l'équiprobabilité des sexes).
val8=\(U_1=\lbrace 2F;2G;1F1G\rbrace)
val9=\(U_2= \lbrace (F,F);(F,G);(G,F);(G,G) \rbrace)
val10=$[rint(2)]
!endif
!if $val6=2 
val7=On lance deux dés cubiques bien équilibrés dont les faces sont numérotées de 1 à 6.<br>	 On s'intéresse aux numéros obtenus.
val8=\(U_1) l'ensemble qui contient les 6 doubles et les 15 paires formées avec \(\lbrace 1;2;3.4;5;6 \rbrace\)
val9=\(U_2) l'ensemble des 36 couples formés avec les éléments de \(\lbrace 1;2;3.4;5;6 \rbrace\)
val10=$[rint(2)]
!endif
!if $val6=3 
val7=On écrit les quatre lettres du prénom AZIZ sur quatre	  cartons indiscernables que l'on place dans un sac.<br>	  On tire au hasard <b>simultanément</b> deux cartes de ce sac.<br>	  On s'intéresse aux lettres obtenues.
val9=\(U_2=\lbrace\) Z1 et Z2; A et Z1; A et Z2; I et Z1; I et Z2; A et I\(\rbrace) en numérotant les deux lettres Z
val8=\(U_1= \lbrace\) Z et Z; A et Z; I et Z; A et I\(\rbrace)
val10=$[rint(2)]
!endif
!if $val6=4 
val7=On écrit les quatre lettres du prénom AZIZ sur quatre	  cartons indiscernables que l'on place dans un sac.<br>	  On tire au hasard <b>successivement et avec remise</b>	  deux cartes de ce sac.<br>	  On s'intéresse aux lettres obtenues.
val9=\(U_2=\lbrace ZZ;AZ;ZA;IZ;ZI;AA;AI;IA;II\rbrace\)
val8=\(U_1=\lbrace Z1Z1;Z2Z2;Z1Z2;Z2Z1;AZ1;Z1A;IZ1;Z1I;AZ2;Z2A;IZ2;Z2I;AA;AI;IA;II\rbrace\)
val10=1
!endif
replytype1=radio
replyname1=Univers équiprobable
replygood1=$val10;\(U_1\),\(U_2\)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 <p>$val7</p>	Pour modéliser cette expérience, on considère les deux univers suivants :	<ul>	  <li>$val8.</li>	  <li>$val9.</li>	</ul>	<div class="wims_question">	Auquel de ces deux univers peut-on associer une loi de probabilité équirépartie ?	<div class="wimscenter"> 
