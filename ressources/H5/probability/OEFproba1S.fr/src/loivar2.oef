\real{esp=0}
\real{variance=0}
\for{i=1 to \nbx}{
  \real{esp=\esp+\px[\i]*\sx[\i]}
  \real{variance=\variance+\px[\i]*(\sx[\i])^2}
}
\real{variance=\variance -(\esp)^2}
\integer{repc=\esp=0?1:2}
\integer{repc=\esp<0?3}
