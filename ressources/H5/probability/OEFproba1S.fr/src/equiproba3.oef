\text{name_statement6=Calcola la probabilità dei seguenti eventi}
\text{name_cond1=I}
\text{name_cond2=tulipani rossi sono tutti gli uni accanto agli altri}
\text{name_cond3=I tulipani rossi e gialli sono alternati lungo il bordo}
\text{name_cond4=tulipani posti nella parte destra del bordo sono rossi}
\text{name_solution1=Se tutti i fiori sono differenti, si avranno}
\text{name_solution2=esiti possibili}
