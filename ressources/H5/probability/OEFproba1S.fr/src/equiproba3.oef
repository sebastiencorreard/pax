\text{name_solution4=tulipani rossi sono identici, è necessario dividere questo numero per}
\text{name_solution5=Allo stesso modo, i}
\text{name_solution6=tulipani gialli sono identici, è necessario quindi dividere ancora per}
\text{name_solution7=Quindi, si hanno}
\text{name_solution8=esiti possibili}
\text{name_solution9=Quanti tulipani gialli si possono avere a sinistra dei tulipani rossi}
\text{name_solution10=Quindi}
\text{name_solution11=La fila comincia con un tulipano rosso, oppure con un tulipano giallo}
\text{name_solution12=Dove possiamo mettere l'ultimo tulipano rosso}
\text{name_solution13=Si hanno}
