!set title=Equiprobabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=events,probability,combinatorics
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Equiprobabilità 1

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=sprinters participent à la finale du 100 mètres
val8=Combien de podium sont possibles\(\,\)
val9=On se place dans un cas d'équiprobabilité
val10=Quelle est la probabilité de chaque podium\(\,\)
val11=nombre de podiums
val12=probabilité
val13=Si vous donnez une valeur approchée de la probabilité, gardez au moins cinq décimales.
!if $val6=it 
val7=velocisti partecipano alla finale dei 100 metri
val8=Quanti sono i podi possibili
val9=Supponiamo di essere in condizioni di equiprobabilità
val10=Qual è la probabilità di ciascun podio
val11=numero di podi
val12=probabilità
val13=Se inserite un valore approssimato, indicate almeno cinque cifre decimali.
!endif
tmp0=!randint 6, 10

val14=$[rint($(tmp0))]
val15=$[rint($val14*($val14-1)*($val14-2))]
t_=!rawmath 1/$val15
val16=!exec pari print($t_)
replytype1=numexp
replyname1=$val11
replygood1=$val15
replytype2=numeric
replyoption2=absolute 
replyname2=$val12
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14 $val7. \begin{enumerate} \item $val8? \item $val9. $val10? \end{enumerate} \end{statement} 


!goto stat

!exit

:question
$()	 
!insmath $val14
$() $val7.	<div class="wims_question">	<ol>	<li><label for="reply1">$val8?</label>  
!read oef/embed.phtml reply1,6 
$()</li>	<li> $val9.<br>	<label for="reply2">$val10?</label>  
!read oef/embed.phtml reply2,8 
$()	</li>	</ol>	</div>	<div class="wims_instruction">$val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14 $val7. $m_begin{enumerate} $m_item $val8? $m_item $val9. $val10? $m_end{enumerate} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,13,14
embedcnt=2
