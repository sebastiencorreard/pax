val23=correspond à
!if $val6=it 
val18=un gioco equilibrato,un gioco vantaggioso,un gioco svantaggioso
val19=Sono dati un universo,munito di una probabilità,e una variabile aleatoria reale,con la legge di probabilità definita dalla tabella seguente
val20=Calcola l'aspettativa matematica di
val21=Calcola la varianza di
val22=La v.a.r.
val23=corrisponde a
!endif
val24=$[0]
val25=$[0]
!for val10 =1 to $val11 
val24=$[$val24+$(val16[$val10])*$(val15[$val10])]
val25=$[$val25+$(val16[$val10])*($(val15[$val10]))^2]
!next
val25=$[$val25 -($val24)^2]

!ifval $val24=0
val26=$[rint(1)]
!else
val26=$[rint(2)]
!endif

!ifval $val24<0
val26=$[rint(3)]
!endif
replytype1=numeric
replyname1=E(X)
replygood1=$[$val24]
replytype2=numeric
replyname2=V(X)
replygood2=$[$val25]
replytype3=radio
replyname3=
replygood3=$val26;$val18
question=__EXECUTED_1692754_EXERCISE__

