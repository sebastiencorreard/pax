!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=$[rint(0)]
val8=
tmp0=!randint 0, 50

val9=$[rint($(tmp0))]
!for val10 =1 to 4 
val7=$[rint($val7+$val9)]
val9=$[$val9/100]
tmp0=!append item $val9 to $val8

val8=$(tmp0)
tmp0=!randint 0, 100-$val7

val9=$[rint($(tmp0))]
!next
val9=$[rint(100-$val7)]
val9=$[$val9/100]
tmp0=!append item $val9 to $val8

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!randint 3, 4

val11=$[rint($(tmp0))]
val12=
tmp0=!randint -5, -1

tmp1=!randint 1, 5

val13=$(tmp0),0,$(tmp1)
!for val14  in $val13 
!for val10 =1 to $val11 
tmp0=!append item $val13 to $val12

val12=$(tmp0)
!next
!next
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!item 1 to 5 of $val12

val12=$(tmp0)
tmp0=!listuniq $val12

val15=$(tmp0)
tmp0=!sort numeric list $val15

val15=$(tmp0)
tmp0=!itemcnt $val15

val11=$[rint($(tmp0))]
val16=
!for val10 =1 to $val11 
val9=$[0]
!for val17 =1 to 5 
!if $(val12[$val17])=$(val15[$val10]) 
val9=$[$val9+$(val8[$val17])]
!endif
!next
tmp0=!append item $val9 to $val16

val16=$(tmp0)
!next
val18=un jeu équilibré, un jeu avantageux, un jeu désavantageux
val19=Soit un univers,muni d'une probabilité,une variable aléatoire réelle,dont la loi de probabilité est définie par le tableau suivant&nbsp;
val20=Calculer l'espérance mathématique de
val21=Calculer la variance de
