le="background-color: #FCFFE5;text-align:center;">B</td>	<td style="background-color: #FCFFE5;text-align:center;">AB</td>	</tr>	<tr>	<td style="color: #994C4C; background-color: #B2FFFF;text-align:center;">Rh+</td>	<td>39%</td>	<td>36&#160;%</td>	<td>7,5&#160;%</td>	<td>2,5&#160;%</td>	<td>85&#160;%</td>	</tr>	<tr>	<td style="color: #994C4C; background-color: #B2FFFF;text-align:center;">Rh-</td>	<td>7&#160;%</td>	<td>6&#160;%</td>	<td>1,5&#160;%</td>	<td>0,5&#160;%</td>	<td>15&#160;%</td>	</tr>	<tr>	<td style="background-color: #ECECEC;text-align:center;">Total&#160;:</td>	<td>46&#160;%</td>	<td>42&#160;%</td>	<td>9&#160;%</td>	<td>3&#160;%</td>	<td>100&#160;%</td>	</tr>	</table>			<table class="wimscenter wimsborder" style="display: inline-block;">	<tr>	<td colspan="2" style="background-color: #ECECEC;text-align:center;"><b>Exemples de répartition dans le monde</b></td>	</tr>	<tr>	<th style="color: #994C4C; background-color: #B2FFFF;text-align:center;"><b>Groupe sanguin</b></th>	<td style="background-color: #FCFFE5;text-align:center;"><b>Répartition mondiale</b></td>	</tr>	<tr>	<td style="text-align:center;"><i>O</i> <b>+</b></td>	<td style="text-align:center;">38&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>A</i> <b>+</b></td>	<td style="text-align:center;">34&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>B</i> <b>+</b></td>	<td style="text-align:center;">9&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>O</i> <b>-</b></td>	<td style="text-align:center;">7&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>A</i> <b>-</b></td>	<td style="text-align:center;">6&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>AB</i> <b>+</b></td>	<td style="text-align:center;">3&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>B</i> <b>-</b></td>	<td style="text-align:center;">2&#160;%</td>	</tr>	<tr>	<td style="text-align:center;"><i>AB</i> <b>-</b></td>	<td style="text-align:center;">1&#160;%</td>	</tr>	</table>			
