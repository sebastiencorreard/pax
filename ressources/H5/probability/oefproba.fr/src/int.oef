\integer{nn=randint(1..2)}
\integer{kk=randint(1..2)}
\text{sa=\nn=1?satisfaits:insatisfaits}
\text{iii=\kk=1?ininterrompue:coupée}

\text{alea=shuffle(3)}
\text{Titre=Tableau à double entrée,Premier arbre de probabilité,Deuxième arbre de probabilité}

\integer{oo=randint(1..10)}
\integer{clientenquete=\oo*1000}
\text{clientenquetee=\clientenquete}
\integer{clientC=\clientenquete*0.4}
\text{clientCC=\clientC}

\integer{pp=randint(0..5)}
\integer{pourcentageclientCS=70+\pp*5}

\integer{pss=randint(1..9)}
\integer{pourcentageclientDS=\pss*5}

\integer{qq=\clientenquete-\clientC}
\text{qqq=\qq}
\integer{ss=\clientC*\pourcentageclientCS/100}
\text{sss=\ss}
\integer{dd=\qq*\pourcentageclientDS/100}
\text{ddd=\dd}
\integer{bb=\clientC-\ss}
\text{bbb=\bb}
\integer{mm=\qq-\dd}
\text{mmm=\mm}
\integer{ll=\ss+\dd}
\text{lll=\ll}
\integer{az=\clientenquete-\ss-\dd}
\text{azz=\az}

\real{ff=\clientC/\clientenquete}
\text{aff=\clientC/\clientenquete}
\real{cff=1-\ff}
\text{acff=\cff}
\real{tre=1-\pourcentageclientCS/100}
\text{atre=\tre}
\real{zre=\pourcentageclientCS/100}
\text{zree=\zre}
\real{ere=1-\pourcentageclientDS/100}
\text{eree=\ere}
\real{yre=\pourcentageclientDS/100}
\text{yree=\yre}
\real{ure=\ff*(1-\pourcentageclientCS/100)}
\text{uree=\ure}
\real{ire=\ff*\pourcentageclientCS/100}
\text{iree=\ire}
\real{ore=(1-\ff)*(1-\pourcentageclientDS/100)}
\text{oree=\ore}
\real{pre=(1-\ff)*\pourcentageclientDS/100}
\text{pree=\pre}

\integer{fff=(\nn=1 and \kk=2)?\qq*\pourcentageclientDS/\clientenquete}
\integer{fff=(\nn=1 and \kk=1)?\ff*\pourcentageclientCS}
\integer{fff=(\nn=2 and \kk=1)?\ff*(1-\pourcentageclientCS/100)*100}
\integer{fff=(\nn=2 and \kk=2)?(1-\ff)*(1-\pourcentageclientDS/100)*100}

\integer{ccc=randint(1..3)}

inutile car le poids n'est pas attribué en dynamique
\text{www=}

\text{pro=Quel est le pourcentage de clients \sa dont la connexion internet a été \iii ?}

\text{enonce= Un fournisseur d'accès internet effectue une enquête de satisfaction sur un panel de \clientenquete
 clients dont l'abonnement a plus de 12 mois d'ancienneté.
 L'enquête revèle que :
 <ul><li>\clientC clients n'ont jamais subi d'interruption de leur connexion internet.</li>
 <li>\pourcentageclientCS % des clients n'ayant jamais subi de coupure prolongée se déclarent satisfaits du service fourni.</li>
 <li>\pourcentageclientDS % des clients ayant subi une déconnexion dans les 12 mois se déclarent satisfaits du service
  fourni.</li></ul>
  On considère les événements suivants :
  <ul><li>S : "Le client est satisfait"</li>
  <li>I : "Le client est insatisfait"</li>
  <li>C : "La connexion est continue"</li>
  <li>D : "La connexion est discontinue"</li></ul>
  }
  
