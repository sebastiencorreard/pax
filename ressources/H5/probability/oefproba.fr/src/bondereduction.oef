\text{alea=shuffle(3)}
\text{Titre=Tableau à double entrée,Premier arbre de probabilité,Deuxième arbre de probabilité}

\integer{oo=randint(0..6)}
\integer{pB=10+\oo*5}
\integer{hh=randint(0..3)}
\integer{pBV=70+5*\hh}
\integer{pNBV=\pBV-50}

\integer{ll=100-\pB}
\real{ss=\pB*\pBV/100}
\real{bb=\ll*\pNBV/100}
\real{wx=\ss+\bb}
\real{dd=\pB-\ss}
\real{mm=\ll-\bb}
\real{qq=100-\wx}

\real{pBB=\pB/100}
\real{cff=1-\pBB}
\real{pBVV=\pBV/100}
\real{zre=1-\pBVV}
\real{ere=\pNBV/100}
\real{yre=1-\ere}
\real{ure=\pBB*\pBVV}
\real{ire=\pBB*\zre}
\real{ore=\cff*\ere}
\real{pre=\cff*\yre}


\integer{ccc=randint(1..3)}

inutile car le poids n'est pas attribué en dynamique
\text{www=}

\text{pro=Quel est le pourcentage de clients qui achètent un vêtement ?}

\text{enonce= Suite à l'envoi de bons de réduction par internet, le service marketing
 d'un magasin de prêt-à-porter effectue une enquête sur ses clients.
<br>L'enquête revèle que :
 <ul><li>\pB % des clients possédaient un bon de réduction.</li>
 <li>\pBV % des clients munis d'un bon de réduction ont acheté un vêtement.</li>
 <li>\pNBV % des clients ne possédant pas de bon de réduction ont acheté un vêtement.</li></ul>
  On considère les événements suivants :
  <ul><li>B : "Le client avait un bon de réduction"</li>
  <li>V : "Le client a acheté un vêtement"</li>
  <li>PB : "Le client n'a pas reçu de bon de réduction"</li>
  <li>PV : "Le client n'a pas acheté de vêtement."</li></ul>
  }
  
