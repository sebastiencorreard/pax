<div class="question">
<div class="etape">ÉTAPE \step sur 5</div>
<ul><li>Quelle est la signification de \(\bar{B}) ?(Choisir la bonne réponse)<br>
\embed{reply17}</li>
<li>Quelle est la signification de \(B \cup \bar{S}) ?(Choisir la bonne réponse)<br>
\embed{reply18}</li>
<li>Quelle est la signification de \(\bar{B} \cap S) ?(Choisir la bonne réponse)<br>
\embed{reply19}</li></ul>
</div>}
\if{\step = 5}{<div class="solution">
<table class="wimscenter">
<tr><th></th>
<th>\nom[1]</th>
<th>\nom[2]</th>
<th>Total</th></tr>
<tr><th>\nom[3]</th>
<td><span class="good">\reponse[1]</span></td>
