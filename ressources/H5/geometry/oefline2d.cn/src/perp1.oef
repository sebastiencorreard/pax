\title{垂直线 I}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\b*(\x) - (\a)*(\y)}
\text{L=\a*x + \b*y = \c}
\function{eq=\b*x - \a*y = \t}

\statement{设 \(L) 是由以下方程定义的直线
<p><center>\(\L)&nbsp;.</center> <p>
求通过点
\((\x , \y)) 且与 \(L) 垂直的直线方程.
}

\answer{直线方程}{\eq}{type=equation}
