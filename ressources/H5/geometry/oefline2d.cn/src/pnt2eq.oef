\title{2 个点}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(-20..20)}
\integer{a2=random(-20..20)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=\b2-(\b1)}
\integer{b=\a1-(\a2)}
\integer{c=(\a1)*(\b2)-(\a2)*(\b1)}
\function{eq=\a*x + \b*y = \c}

\statement{求平面内包含点
(\a1&nbsp;,&nbsp;\b1) 与 (\a2&nbsp;,&nbsp;\b2) 的直线的方程.
<p><small>
此方程必须具有 \(ax + by = c) 的形式.</small>
}

\answer{直线方程}{\eq}{type=equation}
