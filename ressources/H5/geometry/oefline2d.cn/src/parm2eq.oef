\title{参数方程化一般方程}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(2..20)*random(-1,1)}
\integer{a2=random(2..20)*random(-1,1)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=-(\a2)}
\integer{b=\a1}
\integer{c=(\a)*(\b1)+(\b)*(\b2)}
\function{eq=\a*x + \b*y = \c}
\text{ex=\a1*t + \b1}
\text{ey=\a2*t + \b2}

\statement{设 \(L) 是由以下参数方程定义的直线
<p><center>
\(x = \ex)&nbsp;,
\(y = \ey) &nbsp;.
</center> <p>
写出 \(L) 的一般方程.
<p><small>
一般方程的形式是 \(ax + by = c).
</small>
}

\answer{\(L) 的方程}{\eq}{type=equation}
