tmp0=!randint 2, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
val10=$val6*x + $val7*y = $val8
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
