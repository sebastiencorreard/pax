val12=$(tmp0)
tmp0=!item $val11 of c,$val9

val13=$(tmp0)
tmp0=!item $val11 of ($val8-($val6)*($val9))/($val7),($val8-($val7)*($val9))/($val6)

val14=$[$(tmp0)]
replyname1=\(c)
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 
!insmath L
