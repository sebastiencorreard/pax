!set title=参数方程化一般方程
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=100

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val9=$[rint($(tmp0)*2+1)]
val10=$[rint(-($val7))]
val11=$[rint($val6)]
val12=$[rint(($val10)*($val8)+($val11)*($val9))]
val13=!rawmath $val10*x + $val11*y = $val12
val14=$val6*t + $val8
val15=$val7*t + $val9
replytype1=equation
replyname1=\(L) 的方程
replygood1=!rawmath $val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 
!insmath L
$() 是由以下参数方程定义的直线	<p><center>	
!insmath x = $val14
$()&nbsp;,	
!insmath y = $val15
$() &nbsp;.	</center> <p>	写出 
!insmath L
$() 的一般方程.	<p><small>	一般方程的形式是 
!insmath ax + by = c
$().	</small>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,15
embedcnt=0
