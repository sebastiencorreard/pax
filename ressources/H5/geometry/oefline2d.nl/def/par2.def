!set title=Parallel II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=en
leftrange=-5.000000
rightrange=5.000000
author=XIAO, Gang
email=xiao@unice.fr
computeanswer=no
precision=1000

ansorder=r
varcnt=13
