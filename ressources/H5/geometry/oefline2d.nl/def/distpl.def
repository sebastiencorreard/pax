tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
tmp0=!randint -20, 20

