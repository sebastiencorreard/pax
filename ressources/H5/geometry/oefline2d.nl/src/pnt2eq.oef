\title{2 points}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(-20..20)}
\integer{a2=random(-20..20)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=\b2-(\b1)}
\integer{b=\a1-(\a2)}
\integer{c=(\a1)*(\b2)-(\a2)*(\b1)}
\function{eq=\a*x + \b*y = \c}

\statement{Find an equation of the line in the plane containing the points
(\a1&nbsp;,&nbsp;\b1) and (\a2&nbsp;,&nbsp;\b2).
<p><small>
The equation must be of the form ax + by = c.</small>
}

\answer{Equation of the line}{\eq}{type=equation}

