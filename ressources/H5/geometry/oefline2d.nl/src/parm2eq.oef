\title{Parametrized to equation}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(2..20)*random(-1,1)}
\integer{a2=random(2..20)*random(-1,1)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=-(\a2)}
\integer{b=\a1}
\integer{c=(\a)*(\b1)+(\b)*(\b2)}
\function{eq=\a*x + \b*y = \c}
\text{ex=htmlmath(\a1*t + \b1)}
\text{ey=htmlmath(\a2*t + \b2)}

\statement{Let <i>L</i> be the plane line defined by the parametrized
equations:
<p><center>
x&nbsp;=&nbsp;\ex&nbsp;,
y&nbsp;=&nbsp;\ey&nbsp;.
</center> <p>
Find an equation of <i>L</i>.
<p><small>
The equation must be of the form ax + by = c.
</small>
}

\answer{Equation of L}{\eq}{type=equation}

