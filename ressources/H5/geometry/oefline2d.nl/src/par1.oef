\title{Parallel I}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a*(\x) + (\b)*(\y)}
\text{L=htmlmath(\a*x + \b*y = \c)}
\function{eq=\a*x + \b*y = \t}

\statement{Let <i>L</i> be the plane line defined by the equation
<p><center>\L&nbsp;.</center> <p>
Find an equation of the line containing the point
(\x&nbsp;,&nbsp;\y) and parallel to <i>L</i>.
}

\answer{Equation of the line}{\eq}{type=equation}

