\title{Parallel II}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a1=random(2..20)*random(-1,1)}
\integer{a2=random(2..20)*random(-1,1)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=-(\a2)}
\integer{b=\a1}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a*(\x) + (\b)*(\y)}
\function{eq=\a*x + \b*y = \t}
\text{ex=htmlmath(\a1*t + \b1)}
\text{ey=htmlmath(\a2*t + \b2)}

\statement{Let <i>L</i> be the plane line defined by the parametrized
equations:
<p><center>
x&nbsp;=&nbsp;\ex&nbsp;,
y&nbsp;=&nbsp;\ey&nbsp;.
</center> <p>
Find an equation of the line containing the point
(\x&nbsp;,&nbsp;\y) and parallel to <i>L</i>.
}

\answer{Equation of the line}{\eq}{type=equation}

