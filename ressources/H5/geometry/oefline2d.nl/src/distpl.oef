\title{Distance point-line I}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a*(\x) + (\b)*(\y)}
\text{L=htmlmath(\a*x + \b*y = \c)}
\real{dist=abs((\t-(\c))/sqrt((\a)^2+(\b)^2))}

\statement{Let <i>L</i> be the plane line defined by the equation
<p><center>\L&nbsp;.</center> <p>
Compute the distance between <i>L</i> and the point
(\x&nbsp;,&nbsp;\y)&nbsp;.
}

\answer{The distance}{\dist}

