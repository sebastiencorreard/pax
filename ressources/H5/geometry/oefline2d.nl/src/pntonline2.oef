\title{Point on line II}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(1..20)*random(-1,1)}
\integer{d=random(1..20)*random(-1,1)}
\integer{g=random(-20..20)}
\text{ex=htmlmath(\a*t + \c)}
\text{ey=htmlmath(\b*t + \d)}
\integer{ch=random(1,2)}
\text{x=item(\ch,\g,c)}
\text{y=item(\ch,c,\g)}
\real{sol=item(\ch,
	\d+(\b)*(\g-(\c))/(\a),
	\c+(\a)*(\g-(\d))/(\b)
	)}

\statement{Let <i>L</i> be the line defined by parametrized equations
<p><center>
x&nbsp;=&nbsp;\ex&nbsp;,
y&nbsp;=&nbsp;\ey&nbsp;.
</center> <p>
Find the value of c such that the point
(\x&nbsp;,&nbsp;\y) is on <i>L</i>.
}

\answer{c}{\sol}

