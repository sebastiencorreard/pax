\title{Point on line I}
\language{en}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{g=random(-20..20)}
\text{L=htmlmath(\a*x + \b*y = \c)}
\integer{ch=random(1,2)}
\text{x=item(\ch,\g,c)}
\text{y=item(\ch,c,\g)}
\real{sol=item(\ch,(\c-(\a)*(\g))/(\b),(\c-(\b)*(\g))/(\a))}

\statement{Let <i>L</i> be the line define by the equation
<p><center>\L&nbsp;.</center> <p>
Find the value of c such that the point
(\x&nbsp;,&nbsp;\y) is on <i>L</i>.
}

\answer{c}{\sol}

