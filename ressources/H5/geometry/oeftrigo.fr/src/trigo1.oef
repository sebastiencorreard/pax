\title{Trigonométrie I}

\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bernadette.m.riou@orange.fr}
\computeanswer{yes}
\format{html}

\precision{10000}

\text{name_instruction=Combien l'équation,a-t-elle de solutions dans l'intervalle}
\text{name_answer=Nombre de solutions}

\text{n=random(1,2,3,4)}
\text{sincos=random(sin,cos,tan)}
\text{pa=pari(randint(1..120)/60)}
\text{A=\pa*pi}
\if{floor((2*\n*\pa-1)/2)=(2*\n*\pa-1)/2 and (tan isin \sincos)}{
	\real{sa=(-1)^(\n)}
	\text{a=\sa*inf}}
	{\real{a=floor(10^7*\sincos(\n*\A))/10000000}}
\integer{u=randint(-50..50)}
\integer{v=\u+randint(7*pi..15*pi)}
\integer{k0=floor((\u-(\A))/(2*pi)*\n)}
\integer{k1= floor((\v-(\A))/(2*pi)*\n)}
\integer{k1=\k1=(\v-(\A))/(2*pi)*\n ? \k1-1}
\real{sol=\A+(2*(\k0+1)*pi/\n)}
\for{i=\k0+2 to \k1}{
	\real{so=\A+(2*(\i)*pi)/\n}
	\text{sol=\sol,\so}
}
\real{AA=sin isin \sincos ? pi/\n-(\A): -(\A)}
\real{AA= tan isin \sincos ? pi/\n+(\A)}
\integer{k2=floor((\u-(\AA))/(2*pi)*\n)}
\integer{k3=floor( (\v-(\AA))/(2*pi)*\n)}
\integer{k3=\k3=(\v-(\AA))/(2*pi)*\n? \k3-1}
\for{i=\k2+1 to \k3}{
	\real{so=\AA+(2*(\i)*pi)/\n}
	\text{sol=\sol,\so}
}
\text{sol=wims(sort numeric list \sol)}
\text{sol=wims(listuniq \sol)}
\text{nombre=wims(itemcnt \sol)}
\statement{\name_instruction[1]
<div class="wimscenter">\if{inf isin \a and - notin \a}{\( \sincos(\n*x) = +\a)
}
{ \( \sincos(\n*x) = \a)}</div>
\name_instruction[2] &#93;\( \u , \v) &#91; ?}
\answer{\name_answer}{\nombre}{type=default}

