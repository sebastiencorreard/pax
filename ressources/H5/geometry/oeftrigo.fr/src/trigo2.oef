\title{Trigonométrie, résolution d'équations II}

\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bernadette.m.riou@orange.fr}
\computeanswer{yes}
\format{html}

\precision{10000}

\text{name_instruction=Soit l'équation }
\text{name_instruction1=Combien a-t-elle de solutions dans l'intervalle}
\text{name_instruction2=Les \nombre solutions dans l'intervalle [0 , \(2*pi)] sont
  de la forme}
\matrix{name_instruction21=avec \(k) parcourant l'ensemble
  ou de la forme
  avec \(k) parcourant l'ensemble}
\matrix{name_inst=Écrire \(k) sous la forme d'un rationnel si cela en est un.
  Vous devez ainsi donner toutes les solutions une et une seule fois.}
\text{name_cond=L'ensemble des solutions est le bon}
\text{name_answer=Nombre}

\text{sincos1=randitem(sin,cos)}
\text{sincos2=randitem(sin,cos)}
\integer{n=randint(1..4)}
\integer{m=\n+randint(1..3)}
\real{a=random(1..4)}
\real{b=random(random(-3+(\a).. (\a)-1),random(\a+1..\a+3))}
\integer{nm=\m-(\n)}
\integer{nm1=\m+(\n)}
\text{f=simplify(\sincos1(\n*x+\a))}
\text{g=simplify(\sincos2(\m*x+\b))}
\text{liste=1000}
\real{a1=\a}
\real{b1=\b}
\if{\sincos1 notsametext \sincos2}{
	\real{a1=\sincos1 issametext cos ? \a+pi/2}
	\real{b1=\sincos2 issametext cos ? \b+pi/2}
	\text{op=pi}
	}
\if{\sincos1 issametext \sincos2}{\text{op=\sincos1 issametext cos? 0:pi}}
\for{k=0 to \nm-1}{
	\real{ss=(\a1-(\b1))/(\nm)+2*(\k)*pi/(\nm)}
	\real{ss=\ss-floor(\ss/(2*pi))*2*pi}
	\text{liste=\liste,\ss}
	}
\for{k=0 to \nm1-1}{
	\real{ss=(\op-(\a1+(\b1)))/(\nm1)+2*\k*pi/(\nm1)}
	\real{ss=\ss-floor(\ss/(2*pi))*2*pi}
	\text{liste=\liste,\ss}
 }
\text{nombre=wims(itemcnt \liste)}
\text{liste=item(2..\nombre,\liste)}
\text{liste1=wims(sort numeric list \liste)}
\integer{nombre=\nombre-1}
\text{conf=}
\for{j=1 to \nombre}{
	\real{confirm=evalue(\f,x=item(\j,\liste))-evalue(\g,x=item(\j,\liste))}
	\text{conf=\conf,\confirm}}
\steps{reply1
reply2, reply3,reply4,reply5
}
\statement{\name_instruction \(\f = \g).
\if{\step<=1}{\name_instruction1 \([0 , \ 2*\pi]\) ? }
\if{\step=2}{
<p> name_instruction2</p>
<div class="wimscenter">\embed{reply 2} + \(k*pi)
\name_instruction21[1;] \embed{reply 3}</div>
\name_instruction21[2;]
<div class="wimscenter"> \embed{reply 4} + \(k*pi)
\name_instruction21[3;] \embed{reply 5}</div>
<div class="wims_instruction">
\name_inst[1;] <p>\name_inst[2;].</p>
</div>}
}
\answer{\name_answer}{\nombre}{type=numeric}
\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=set}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=set}
\text{no1=wims(itemcnt \rep2)}
\text{no2=wims(itemcnt \rep4)}
\real{listerep=\rep1+item(1,\rep2)*pi}
\for{i=2 to \no1}{
	\real{s=\rep1+item(\i,\rep2)*pi}
	\text{listerep=\listerep,\s}
}
\for{i=1 to \no2}{
	\real{s=\rep3+item(\i,\rep4)*pi}
	\text{listerep=\listerep,\s}
}
\text{listerep1=wims(sort numeric list \listerep)}
\real{testnum=0}
\for{u =1 to \nombre}{
	\real{testnum=max(\testnum,abs(item(\u,\liste1)-item(\u,\listerep1)))}
	}
\text{test3=\testnum<0.001 ? 0:1}
\text{test1=wims(listcomplement \listerep in \liste)}
\text{test2=wims(listcomplement \liste in \listerep)}
\text{test1=wims(itemcnt \test1)}
\text{test2=wims(itemcnt \test2)}
\condition{\name_cond}{\test3=0}

