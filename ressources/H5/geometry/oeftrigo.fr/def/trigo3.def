!set title=Trigonométrie, résolution d'équations I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=33
prevarcnt=29
postvarcnt=3
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Trouver toutes les solutions de l'équation,	qui se trouvent dans l'intervalle ,en les mettant dans l'ordre croissant.
val8=Solutions
val9=Voici la courbe de la fonction, sur l'intervalle
val10=Une au moins de vos réponses n'est pas dans l'intervalle demandé.
tmp0=!randitem sin,cos,tan

val11=$(tmp0)
tmp0=!randint 0, 120

t_=!replace internal \( by ( in $(tmp0)/60
tmp1=!exec pari $t_

val12=$(tmp1)
val13=$val12*pi
!if ($val12=1/2 or $val12 = 3/2) and (tan isin $val11) 
val14=sign(1-$val12)*inf
!else
val14=$[$val11($val13)]
!endif
tmp0=!randint -50, 50

val15=$[rint($(tmp0))]
tmp0=!randint 3*pi, 5*pi

val16=$[rint($val15+$(tmp0))]
val17=$[rint(floor(($val15-($val13))/(2*pi)))]
val18=$[rint(floor(($val16-($val13))/(2*pi)))]

!ifval $val18=($val16-($val13))/(2*pi) 
val18=$[rint( $val18-1)]
!endif
val19=$[$val13+(2*($val17+1)*pi)]
!for val20 =$val17+2 to $val18 
val21=$[$val13+(2*($val20)*pi)]
val19=$val19,$val21
!next

!ifval sin isin $val11 
val22=$[ pi-($val13)]
!else
val22=$[ -($val13)]
!endif

!ifval tan isin $val11 
val22=$[ pi+($val13)]
!endif
val23=$[rint(floor(($val15-($val22))/(2*pi)))]
val24=$[rint(floor( ($val16-($val22))/(2*pi)))]

!ifval $val24=($val16-($val22))/(2*pi) 
val24=$[rint( $val24-1)]
!endif
!for val20 =$val23+1 to $val24 
val21=$[$val22+(2*($val20)*pi)]
val19=$val19,$val21
!next
tmp0=!sort numeric list $val19

val19=$(tmp0)

!ifval tan isin$val11 and $val12 != 1/2 and $val12 != 3/2 
val25= max(\abs($val14),3)
!else
val25=1.2
!endif
replytype1=vector
replyname1=$val8
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1])	<div class="wimscenter">
!insmath  $val11(x) = $val14
$()</div>	$(val7[2]) &#93;
!insmath  $val15 , $val16
$() &#91; $(val7[3])	
$()
!exit

:hint
$()$(val9[1]) $val11 $(val9[2]) [$val15 , $val16] :	<div class="wimscenter">  
!read oef/draw.phtml 150,150 \
	 xrange $val15,$val16	 yrange -$val25,$val25	 hline $val15,0, black	 linewidth 2	 plot green, $val11(x)	 hline $val15,$val14, navy	 
$()	</div>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val26=1
!for val27  in $m_reply1 

!ifval $val27 <= $val15 or $val27 >= $val16 
val26= 0
!endif
!next

!exit

:feedback
!ifval $val26 =0
 <div class='oef_feedbacks'>$val10
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,9,10,11,14,15,16,25
embedcnt=0
