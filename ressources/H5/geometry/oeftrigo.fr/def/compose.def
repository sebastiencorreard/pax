!set title=Composer
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=17
prevarcnt=12
postvarcnt=4
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Trouvez l'amplitude \(A > 0) et la phase \(p) de la fonction	  trigonométrique
val8=de sorte que
val9=La réponse est bonne
val10=L'amplitude,La phase \(p) (entre 0 et \(2*pi))
tmp=!nonempty items x,y,a,b,c,r,s,t

tmp0=!randitem $tmp
val11=$(tmp0)
tmp0=!randint 2, 9

val12=$(tmp0)
val13=!rawmath $val12*$val11
tmp0=!randint 5, 1000

tmp1=!randitem 0.01,-0.01

val14=$[$(tmp0)*$(tmp1)]
tmp0=!randint 5, 1000

tmp1=!randitem 0.01,-0.01

val15=$[$(tmp0)*$(tmp1)]
tmp0=!randitem sin,cos

val16=$(tmp0)
tmp0=!randitem $val14*cos($val13) + $val15*sin($val13),$val15*sin($val13) + $val14*cos($val13)

val17=!rawmath $(tmp0)
replytype1=numeric
replyname1=$(val10[1]) \(A)
replygood1=?analyze 18
replytype2=numeric
replyname2=$(val10[2])
replygood2=?analyze 19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	  
!insmath f($val11) = $val17
$() ,	</div>	  $val8	<div class="wimscenter">	  
!insmath f($val11) = A*$val16($val13 - p)
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp=!trim Vous avez donné une amplitude négative&nbsp;	  Un calcul rapide donne	  ce qui ne correspond pas à la fonction \(f) donnée.
val20=!translate internal $	\
$ to ;; in $tmp
val21=$[rint(1000*$val18*$val16(-($val19)))/1000]
val22=$[rint(1000*$val18*$val16(pi/2-($val19)))/1000]
val23=$[sqrt(($val14-($val21))^2+($val15-($val22))^2)]

!exit

:feedback
!ifval $val18 < 0
 <div class='oef_feedbacks'>$(val20[1;]);!
$()</div>
!endif
!ifval $val23 >= 0.01
 <div class='oef_feedbacks'>	 $(val20[2;])	 <div class="wimscenter">	  
!insmath $val18*$val16($val13 - $val19) = $val21*cos($val13) + $val22*sin($val13)
$() ,	 </div>	 $(val20[3;])	
$()</div>
!endif

!exit

:test

!ifval $val18 > 0 and $val23 <0.01
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val9

!exit

:stat
vsavelist=7,8,9,11,13,14,15,16,17,18,19
embedcnt=0
