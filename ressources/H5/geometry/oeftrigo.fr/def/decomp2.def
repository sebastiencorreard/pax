!set title=Décomposer II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
computeanswer=no
precision=10000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Trouvez les valeurs de \(a) et \(b) telles que
val8=-
tmp=!nonempty items x,y,r,s,t

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!randint 2, 9

val10=$(tmp0)
val11=!rawmath $val10*$val9
tmp0=!randint 50, 1000

val12=$[$(tmp0)/100]
tmp0=!randint 5, 628

tmp1=!randitem -0.01,0.01

val13=$[$(tmp0)*$(tmp1)]
tmp=!nonempty items sin,cos

tmp0=!randitem $tmp
val14=$(tmp0)
val15=!rawmath $val8$val12*$val14($val11 + $val13)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
!if $val16=1 
val17=!rawmath a*cos($val11) + b*sin($val11)
val18=$[$val8$val12*$val14($val13)]
val19=$[$val8$val12*$val14($val13+pi/2)]
!else
val17=!rawmath a*sin($val11) + b*cos($val11)
val19=$[$val8$val12*$val14($val13)]
val18=$[$val8$val12*$val14($val13+pi/2)]
!endif
replytype1=numeric
replyname1=\(a)
replygood1=$[$val18]
replytype2=numeric
replyname2=\(b)
replygood2=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	   
!insmath $val15 = $val17
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,15,17
embedcnt=0
