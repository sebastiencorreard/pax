tmp2=!randitem $(tmp0),$(tmp1)

val19=$[$(tmp2)]
val20=$[rint($val17-($val16))]
val21=$[rint($val17+($val16))]
tmp=!translate ";': to $     $ in $val14($val16*x+$val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val15($val17*x+$val19)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
val24=1000
val25=$[$val18]
val26=$[$val19]
!if $val14 notsametext $val15 

!ifval $val14 issametext cos 
val25=$[ $val18+pi/2]
!endif

!ifval $val15 issametext cos 
val26=$[ $val19+pi/2]
!endif
val27=pi
!endif
!if $val14 issametext $val15 

!ifval $val14 issametext cos
val27= 0
!else
val27=pi
!endif
!endif
!for val28 =0 to $val20-1 
val29=$[($val25-($val26))/($val20)+2*($val28)*pi/($val20)]
val29=$[$val29-floor($val29/(2*pi))*2*pi]
val24=$val24,$val29
!next
!for val28 =0 to $val21-1 
val29=$[($val27-($val25+($val26)))/($val21)+2*$val28*pi/($val21)]
val29=$[$val29-floor($val29/(2*pi))*2*pi]
val24=$val24,$val29
!next
tmp0=!itemcnt $val24

val30=$(tmp0)
tmp0=!item 2 to $val30 of $val24

val24=$(tmp0)
tmp0=!sort numeric list $val24

val31=$(tmp0)
val30=$[rint($val30-1)]
val32=
!for val33 =1 to $val30 
tmp0=!item $val33 of $val24

evaltmp=$val22

evaltmp=!mathsubst x=($(tmp0)) in $evaltmp
tmp1=($evaltmp)
tmp2=!item $val33 of $val24

evaltmp=$val23

evaltmp=!mathsubst x=($(tmp2)) in $evaltmp
tmp3=($evaltmp)
val34=$[$(tmp1)-$(tmp3)]
val32=$val32,$val34
!next
