!set title=Avec des triangles rectangles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 20

val6=$[rint($(tmp0))]
tmp0=!randint 10, 20

val7=$[rint($val6+$(tmp0))]
tmp0=!makelist x for x=$val6 to $val7

val8=$(tmp0)
tmp0=!shuffle $val7-$val6

val9=$(tmp0)
tmp0=!item 1 to 7 of $val9

val9=$(tmp0)
tmp0=!sort numeric list $val9

val9=$(tmp0)
val6=$[rint($(val8[$(val9[1])]))]
val10=$[rint($(val8[$(val9[2])]))]
val11=$[rint($(val8[$(val9[3])]))]
val12=$[rint($(val8[$(val9[4])]))]
val13=$[rint($(val8[$(val9[5])]))]
val14=$[rint($(val8[$(val9[6])]))]
val7=$[rint($(val8[$(val9[7])]))]
val15=$[rint($val13-$val11)]
val16=$[rint($val14-$val10)]
val17=$[rint($val7-$val6)]
val18=trirects.ggb
val19=
val20=
val21=file=$val18	width=500	height=400	showToolBar=true	customToolBar="0|3|4|5|19|40|41|42|"	showAlgebraInput =false
!readproc slib/geo2D/geogebra $val19; $val21 
tmp0=$slib_out
val22=$(tmp0)
val18=trirectsym.ggb
val23=file=$val18	width=500	height=400	showToolBar=true	customToolBar="0|3|4|5|19|40|41|42|"	showAlgebraInput=false
val24=50x20x1
val25=[B C],[A B],[A C],[C H],[C I],[I J],[I K],[J K],[H K],[H J]
val26=[B C]
val27=[J K]
val28=[U K],[J K],[U J],[V K],[U V]
val29=[U J]
oefsteps=r1,r2,r3,r4	r5 
nextstep=!nosubst r1,r2,r3,r4	r5 
!readproc oef/steps.proc
replytype1=clickfill
replyname1=lieu de S
replygood1=$val26;$val25
replytype2=clickfill
replyname2=lieu de N
replygood2=$val27;$val25
replytype3=case
replyname3=centre
replygood3=C
replytype4=numeric
replyname4=rapport
replygood4=$[0.5]
replytype5=clickfill
replyname5=nouveau lieu de N
replygood5=$val29;$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	
!if $m_step=1 
$()$val22 
!else
$() $m_applet2 
!endif
$()	</div>	 <div class="medium_size text_col">	
!if $m_step=1 
$()	   
!insmath A B C
$() est un triangle rectangle en 
!insmath C
$().<br>	   
!insmath M
$() est un point mobile sur 
!insmath [A B]
$() et 
!insmath R
$() est le point de 
!insmath [A C]
$()	   tel que le triangle 
!insmath A M R
$() est rectangle en 
!insmath R
$().<br>	   Les points 
!insmath I
$(), 
!insmath J
$(), 
!insmath K
$() sont les milieux des côtés du triangle	   
!insmath A B C
$() et le point 
!insmath H
$() est le pied de la hauteur issue de 
!insmath C
$().	  <ol>	  <li> Quel est le lieu du point 
!insmath S
$() tel que le triangle 
!insmath M S B
$() est rectangle en 
!insmath S
$() ?	  <div class="wimscenter"> 
!read oef/embed.phtml reply1,$val24 
$()</div></li>	  <li> Quel est le lieu du point 
!insmath N
$(), milieu du segment 
!insmath [R S]
$()?	  <div class="wimscenter"> 
!read oef/embed.phtml reply2,$val24 
$()</div></li>	  <li> Déterminer le centre et le rapport de l'homothétie qui envoie 
!insmath M
$() sur 
!insmath N
$().	  <div class="wimscenter">	  <label for="reply3">Centre:</label>  
!read oef/embed.phtml reply3,2 
$(),	  <label for="reply4">rapport:</label>  
!read oef/embed.phtml reply4,2 
$()</div></li>	  </ol>	 
!else
$() 	  On construit le point 
!insmath D
$() symétrique de 
!insmath C
$() par rapport à 
!insmath [A B]
$().<br>	  Les points 
!insmath U
$() et 
!insmath V
$() sont les milieux des segments 
!insmath [A D]
$() et 
!insmath [B D]
$().<br>	  Le point 
!insmath S
$() appartient maintenant au segment 
!insmath [B D]
$() tel que le triangle 
!insmath M S B
$() est rectangle en 
!insmath S
$().	  <p>	  Quel est le nouveau lieu du point 
!insmath N
$(), milieu du segment 
!insmath [R S]
$()?	  </p>	  <div class="wimscenter"> 
!read oef/embed.phtml reply5,$val24 
$()</div>	 
!endif
$()	</div></div>	
$()
!exit

