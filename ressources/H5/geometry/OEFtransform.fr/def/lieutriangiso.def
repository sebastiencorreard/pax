val17=linewidth=1	 circle 0,$val7/2,$val7*30,red	
val18=xrange -5,5	 yrange -5,5	 segment $val7,0,-$val7,0,blue	 dsegment 0,$val7,0,-$val7,blue	 circle 0,0,$val7*60,blue	 segment 0,0,$val8,$val9,blue	 dsegment $val8,$val9,$val10,$val11,orange	 dsegment $val13,$val14,0,$val7,orange	 linewidth 5	 points red,$val8,$val9	 points orange,$val10,$val11,$val13,$val14	 points blue,-$val7,0,$val7,0,0,$val7,0,-$val7	 text red,0,0,medium,O	 text blue,$val8,$val9,medium,M	 text orange,$val10,$val11,medium,H	 text orange,$val13,$val14,medium,N	 text blue,$val7,0,medium,B	 text blue,-$val7,0,medium,A	 text blue,0,$val7,medium,D	 text blue,0,-$val7,medium,C	
