val6=Déterminer le lieu du point \(H)
val7=!rawmath a/2
val8=Le triangle \(F H O) est rectangle en \(H), donc \(H) appartient au	cercle de diamètre \([F O]).<br>	Donc le centre \(\Omega) est le milieu du segment \([F O]) et le rayon est \(R=\frac{a}{2}).
val9=\(\overrightarrow{F \Omega}),\(\overrightarrow{F O}),\(\overrightarrow{F I}),\(\overrightarrow{F M}),\(\overrightarrow{O M}),\(\overrightarrow{O H}),\(\overrightarrow{F H}),\(\overrightarrow{I H}),\(\overrightarrow{I O})
tmp0=!randint 5, 10

t_=!rawmath $(tmp0)/12
val10=!exec pari print($t_)
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
val12=$[rint(-4)]
val13=$[rint(-2)]
val14=$[$val11*cos($val10*pi)]
val15=$[$val11*sin($val10*pi)]
val16=$[($val14+$val12)/2]
val17=$[($val15+$val13)/2]
val18=$[($val15-$val13)/($val14-$val12)]
val19=$[($val18*$val12-$val13)/($val18+1/$val18)]
val20=$[-$val19/$val18]
t_=!rawmath $val12/2
val21=!exec pari print($t_)
t_=!rawmath $val13/2
val22=!exec pari print($t_)
val23=$[($val12)^2+($val13)^2]
val24=$[sqrt($val23)]
val25=$[$val23-($val11)^2]
val26=$[($val12*($val11)^2-sqrt($val25))/$val23]
val27=$[($val12*($val11)^2+sqrt($val25))/$val23]
val28=$[(($val11)^2-$val12*$val26)/$val13]
val29=$[(($val11)^2-$val12*$val27)/$val13]
val30=$[sqrt($val14^2+$val15^2)]
val26=$[-$val11*($val13*sqrt($val25)-$val12*$val11)/$val23]
val27=$[$val11*($val13*sqrt($val25)+$val12*$val11)/$val23]
val28=$[$val11*($val12*sqrt($val25)+$val13*$val11)/$val23]
val29=$[-$val11*($val12*sqrt($val25)-$val13*$val11)/$val23]
val31=point $val21,$val22,red	 copy $val21,$val22,-1,-1,-1,-1,mathfonts/109/Omega.gif	 linewidth 1	 segment $val12,$val13,0,0,green	 circle $val21,$val22,$val24*30,green	 dsegment $val12,$val13,$val26,$val28,green	 dsegment $val12,$val13,$val27,$val29,green	 linewidth 5	 points green,$val26,$val28,$val27,$val29	 text black,$val26,$val28,medium,P	 text black,$val27,$val29,medium,Q	
val32=$[rint(3)]
val33=arc de cercle \(Q O P)
val34=80x50x1
val35=r1	r2,r3,r4	r5
val36=xrange -5,5	 yrange -5,5	 circle 0,0,$val11*60,blue	 segment $val12,$val13,$val14,$val15,blue	 dsegment 0,0,$val19,$val20,orange	 linewidth 5	 points red,0,0,$val12,$val13,$val14,$val15,$val16,$val17,$val19,$val20	 text red,0,0,medium,O	 text blue,$val12,$val13,medium,F	 text blue,$val14,$val15,medium,M	 text red,$val16,$val17,medium,I	 text orange,$val19,$val20,medium,H	
oefsteps=$val35 
nextstep=!nosubst $val35 
!readproc oef/steps.proc
replytype1=menu
replyname1=nature du lieu
replygood1=$val32;un point,un cercle, un arc de cercle, une droite
replytype2=clickfill
replyname2=
replygood2=?analyze 37;$val9
replytype3=numeric
replyname3=
replygood3=?analyze 38
replytype4=clickfill
replyname4=
replygood4=?analyze 39;$val9
replytype5=function
replyname5=
replygood5=!rawmath $val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

