!!reply$i=$(reply$i)<br>**********<br>debug : $deb options : $(replyoption$i)<br><br>yourlist_name : $yourlist_name<br><br>yourlist : $yourlist<br><br>yourlist3 : $yourlist3<br><br>mylist : $mylist<br><br>mylist2 : $mylist2<br><br>mylist3 : $mylist3<br><br>obj_score : $(obj_score) tot : $total_obj name_score : $(name_score) tot : $total_name <br>num_con_score : $(num_cond_score) formal_cond_score : $(formal_cond_score) <br>