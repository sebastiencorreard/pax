\answer{}{\rep6;\lstangle}{type=clickfill}
\answer{}{1;égaux,complémentaires,supplémentaires,opposés}{type=menu}
\answer{}{\segOD;\lstseg}{type=clickfill}
\answer{}{\segON;\lstseg}{type=clickfill}
\answer{angle}{90}{type=numeric}
\answer{nature du lieu}{2;un point,un cercle, un demi-cercle,une droite}{type=menu}
\answer{}{\segOD;\lstseg}{type=clickfill}
