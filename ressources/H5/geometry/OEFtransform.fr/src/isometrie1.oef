}
\integer{obsnb=wims(rowcnt \obsList)}

## la liste des proriétés éventuelles
\matrix{
propsList=
Translation de vecteur \(\overrightarrow{BC})
Translation de vecteur \(\overrightarrow{AB})
Rotation de centre O et d'angle \(pi/2)
Rotation de centre O et d'angle \(pi)
Symétrie centrale de centre O
Symétrie axiale d'axe (IK)
Symétrie axiale d'axe (JL)
Symétrie axiale d'axe (AC)
Symétrie axiale d'axe (BD)
<span style="color:magenta">Choix vide</span>
}
\integer{propsnb=wims(rowcnt \propsList)-1}

## liste des bonnes réponses par objet
\matrix{
propsrepList=
2
4,5
1
2,3,6
4,5,9
1,7
2
4,5,9
