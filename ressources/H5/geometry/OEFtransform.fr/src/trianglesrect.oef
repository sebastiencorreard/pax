\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}
\integer{xmin=randint(5..20)}
\integer{xmax=\xmin+randint(10..20)}
\text{lstval=wims(makelist x for x=\xmin to \xmax)}
\text{ind=shuffle(\xmax-\xmin)}
\text{ind=item(1..7,\ind)}
\text{ind=wims(sort numeric list \ind)}
\integer{xmin=\lstval[\ind[1]]}
\integer{D1=\lstval[\ind[2]]}
\integer{Q1=\lstval[\ind[3]]}
\integer{med=\lstval[\ind[4]]}
\integer{Q3=\lstval[\ind[5]]}
\integer{D9=\lstval[\ind[6]]}
\integer{xmax=\lstval[\ind[7]]}
\integer{intQ=\Q3-\Q1}
\integer{intD=\D9-\D1}
\integer{etendue=\xmax-\xmin}

\title{Avec des triangles rectangles}
\text{filename=trirects.ggb}
\text{appletcommand=}

\text{chkpt=}
\text{option=
file=\filename
width=500
height=400
showToolBar=true
customToolBar="0|3|4|5|19|40|41|42|"
showAlgebraInput =false}
\text{applet=slib(geo2D/geogebra \appletcommand; \option)}

\text{filename=trirectsym.ggb}
\text{option2=
file=\filename
width=500
height=400
showToolBar=true
customToolBar="0|3|4|5|19|40|41|42|"
showAlgebraInput=false}
text{applet2=slib(geo2D/geogebra \appletcommand; \option2)}
\text{size=50x20x1}
\text{lstrep=[B C],[A B],[A C],[C H],[C I],[I J],[I K],[J K],[H K],[H J]}
\text{rep1=[B C]}
\text{rep2=[J K]}
\text{lstrep2=[U K],[J K],[U J],[V K],[U V]}
\text{rep3=[U J]}
\steps{r1,r2,r3,r4
r5}
\statement{
<div class="wims_columns">
 <div class="medium_size img_col">
\if{\step=1}{\applet}{\applet2}
</div>
 <div class="medium_size text_col">
\if{\step=1}{
   \(A B C) est un triangle rectangle en \(C).<br>
   \(M\) est un point mobile sur \([A B]) et \(R) est le point de \([A C])
   tel que le triangle \(A M R) est rectangle en \(R).<br>
   Les points \(I\), \(J\), \(K) sont les milieux des côtés du triangle
   \(A B C) et le point \(H) est le pied de la hauteur issue de \(C).
  <ol>
  <li> Quel est le lieu du point \(S) tel que le triangle \(M S B) est rectangle en \(S) ?
  <div class="wimscenter">\embed{reply1,\size}</div></li>
  <li> Quel est le lieu du point \(N), milieu du segment \([R S])?
  <div class="wimscenter">\embed{reply2,\size}</div></li>
  <li> Déterminer le centre et le rapport de l'homothétie qui envoie \(M) sur \(N).
  <div class="wimscenter">
  <label for="reply3">Centre:</label> \embed{reply3,2},
  <label for="reply4">rapport:</label> \embed{reply4,2}</div></li>
  </ol>
}{
  On construit le point \(D) symétrique de \(C) par rapport à \([A B]).<br>
  Les points \(U) et \(V) sont les milieux des segments \([A D]) et \([B D]).<br>
  Le point \(S) appartient maintenant au segment \([B D]) tel que le triangle \(M S B) est rectangle en \(S).
  <p>
  Quel est le nouveau lieu du point \(N), milieu du segment \([R S])?
  </p>
  <div class="wimscenter">\embed{reply5,\size}</div>
}
</div></div>
}
\answer{lieu de S}{\rep1;\lstrep}{type=clickfill}
\answer{lieu de N}{\rep2;\lstrep}{type=clickfill}
\answer{centre}{C}{type=text}
\answer{rapport}{0.5}{type=numeric}
\answer{nouveau lieu de N}{\rep3;\lstrep2}{type=clickfill}

