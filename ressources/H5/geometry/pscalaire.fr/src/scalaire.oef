\title{Calcul de produit scalaire}
\observation{exercice de calcul d'un produit scalaire dans un triangle quelconque}

\language{fr}
\author{René, Chaffard}
\email{chafrene@club-internet.fr}
\computeanswer{no}
\format{html}
\precision{1000}

   pour faire varier la présentation de l'exercice
\text{liste=shuffle(A,B,C)}

\text{A=\liste[1]}
\text{B=\liste[2]}
\text{C=\liste[3]}
\integer{c1=randint(2..8)}
\integer{c2=randint(2..8)}
\integer{min=abs(\c1-\c2)+1}
\integer{max=\c1+\c2-1}
\integer{c3=randint(\min..\max)}
   les trois côtés du triangle sont définis

\integer{c12=(\c1)^2}
\integer{c22=(\c2)^2}
\integer{c32=(\c3)^2}
   valeurs utiles pour la correction

\text{ps=simplify((\c12+\c22-\c32)/2)}

\text{longueur=shuffle(\(\A \B = \c1 ) , \(\B \C = \c3) ,  \(\C \A = \c2))}
\statement{
On considère un triangle \(A B C) tel que
<p class="wimscenter"> \longueur[1],  \longueur[2], \longueur[3]. </p>
Calculer le produit scalaire
<p class="wimscenter">
\(\special{color=green} \vec{\A \B} \cdot \vec{\A \C} ) =
\embed{reply1} . </p>
}

\answer{Produit scalaire}{\ps}{type=numeric}

\solution{
\(\vec{\A \B} \cdot \vec{\A \C} ) = \((\A \B^2 + \A \C^2 - \B \C^2) /2 = (\c1^2 + \c2^2 - \c3^2)/2
= (\c12 + \c22 - \c32)/2 = \ps)
}

\hint{Puisque les trois côtés du triangle sont connus, on peut utiliser la définition
du produit scalaire utilisant  les distances :
<p class="wimscenter">\( \vec{\A \B} \cdot \vec{\A \C} = \frac{1}{2} (\A \B^2 + \A \C^2 - \B \C^2) )</p>}
