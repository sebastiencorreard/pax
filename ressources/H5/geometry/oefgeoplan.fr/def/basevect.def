!set title= Coordonnées de vecteurs dans une base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=100
oefcss= <style> .disp_columns{ display: flex; flex-wrap: wrap; } </style> 

ansorder=r,r
varcnt=38
prevarcnt=20
postvarcnt=17
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(4)]
val7=$[rint($val6*2)]
t_=!rawmath 0
val8=!exec pari print($t_)
val9=xrange -10,10	  yrange -10,10	  parallel -10-$val8/2,-10,-10+$val8/2,10,1,0,21,gray	  parallel -10,-10,10,-10,0,1,21,gray	
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
val14=$[rint($val10*($val13)-($val11)*($val12))]
!if $val14=0 
val12=$[rint($val12*(-1))]
!endif
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
val17=$[rint($val15*($val10)+($val16)*($val12))]
val18=$[rint($val15*($val11)+($val16)*($val13))]
!if $val17>0 
tmp0=!randint -$val7, $val7-$val17

val19=$[rint($(tmp0))]
!else
tmp0=!randint -$val7-($val17), $val7

val19=$[rint($(tmp0))]
!endif
!if $val18>0 
tmp0=!randint -$val7, $val7-$val18

val20=$[rint($(tmp0))]
!else
tmp0=!randint -$val7-($val18), $val7

val20=$[rint($(tmp0))]
!endif
val9=$val9	 linewidth 2	 arrow 0,0,$val10,$val11,10,red	 arrow 0,0,$val12,$val13,10,blue	 arrow $val19,$val20,$val19+$val17,$val20+$val18,10,green	 text red,$val10-0.5,$val11-0.5,large,u	 text blue,$val12-0.5,$val13-0.5,large,v	 text green,$val19+$val17-0.5,$val20+$val18-0.5,large,w	 
val21=$val9	 arrow $val19,$val20,$val19+$val15*$val10,$val20+$val15*$val11,10,red	 arrow $val19+$val15*$val10,$val20+$val15*$val11,$val19+$val17,$val20+$val18,10,blue	 linewidth 3	 arrow $val19,$val20,$val19+$val17,$val20+$val18,10,green	 text green,$val19+$val17-0.5,$val20+$val18-0.5,large,w	
replytype1=numeric
replyname1=Première coordonnée
replygood1=$[$val15]
replytype2=numeric
replyname2=Deuxième coordonnée
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="disp_columns">	  <div class="medium_size">	    <p>Dans le plan muni d'une base 
!insmath (\overrightarrow{u},\overrightarrow{v})
$() on a placé un vecteur <span class="nowrap">
!insmath \overrightarrow{w}
$().</span><br>	      L'objectif est d'exprimer le vecteur 
!insmath \overrightarrow{w}
$() en fonction des vecteurs 
!insmath \overrightarrow{u}
$() et <span class="nowrap">
!insmath \overrightarrow{v}
$().</span></p>	    <p>Déterminer les nombres 
!insmath a
$() et 
!insmath b
$() tels que <span class="nowrap">
!insmath \overrightarrow{w} = a \overrightarrow{u} + b \overrightarrow{v}
$().</span></p>	    <div><label for="reply1">
!insmath a
$()</label> =  
!read oef/embed.phtml reply1,3 
$()</div>	    <div class="spacer"><label for="reply2">
!insmath b
$()</label> =  
!read oef/embed.phtml reply2,3 
$()</div>	  </div>	  <div class="medium_size">	     
!read oef/draw.phtml 400,400 \
$val9 
$()	  </div>	</div>				
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!if $m_reply1=1 
val22=
!else
!if $m_reply1=-1 
val22=-
!else
tmp0=!texmath $m_reply1

val22=$(tmp0)
!endif
!endif
!if $m_reply2>0 
val23=+
!else
val23=-
!endif
!if $m_reply2=1 or $m_reply2=-1 
val24=
!else
t_=!rawmath abs($m_reply2)
val25=!exec pari print($t_)
tmp0=!texmath $val25

val24=$(tmp0)
!endif
!if $val15=1 
val26=
!else
!if $val15=-1 
val26=-
!else
tmp0=!texmath $val15

val26=$(tmp0)
!endif
!endif
!if $val16>0 
val27=+
!else
val27=-
!endif
!if $val16=1 or $val16=-1 
val28=
!else
t_=!rawmath abs($val16)
val29=!exec pari print($t_)
tmp0=!texmath $val29

val28=$(tmp0)
!endif
val30=$val9	 linewidth 2	 arrow $val19,$val20,$val19+$m_reply1*$val10,$val20+$m_reply1*$val11,10,red	 arrow $val19+$m_reply1*$val10,$val20+$m_reply1*$val11,$val19+$m_reply1*$val10+$m_reply2*$val12,$val20+$m_reply1*$val11+$m_reply2*$val13,10,blue	 arrow $val19,$val20,$val19+$m_reply1*$val10+$m_reply2*$val12,$val20+$m_reply1*$val11+$m_reply2*$val13,10,black	 linewidth 3	 arrow $val19,$val20,$val19+$val17,$val20+$val18,10,green	 text green,$val19+$val17-0.5,$val20+$val18-0.5,large,w	

!exit

:feedback
!ifval $val15 <>$m_reply1 or $val16<>$m_reply2
 <div class='oef_feedbacks'>	Voici, construit <strong>en noir</strong>, un représentant du vecteur 
!insmath \color{red}$val22\overrightarrow{u} \color{blue}$val23 $val24 \overrightarrow{v}
$() correspondant à votre réponse&nbsp;:	<div class="wimscenter"> 
!read oef/draw.phtml 400,400 \
$val30 
$()</div>	
$()</div>
!endif
!ifval 1=1
 <div class='oef_feedbacks'>	
!if $m_sc_reply1 = 1 and $m_sc_reply2=1 
$()Effectivement, la  
!else
$() La  
!endif
$() réponse exacte est <span class="nowrap">
!insmath \color{green}\overrightarrow{w} = \color{red}$val26\overrightarrow{u} \color{blue}$val27 $val28 \overrightarrow{v}
$()&nbsp;:</span>	<div class="wimscenter"> 
!read oef/draw.phtml 400,400 \
$val21 
$()</div>	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=9,10,11,12,13,15,16,17,18,19,20,21
embedcnt=2
