val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/draw/repere 400,400,20,-6,6,-6,6,1,1,black,grey 
tmp0=$slib_out
val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!item 1 of $val7

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val11=$[rint($(tmp0))]
tmp0=!line 3 to 6 of $val6

val12=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -2, 3

val15=$[rint($val8+$(tmp0)*$val10)]
tmp0=!randint -2, 2

val16=$[rint($val15+$(tmp0)*$val10)]
tmp0=!randint -2, 3

val17=$[rint($val8+$(tmp0)*$val10)]
tmp0=!randint -2, 2

val18=$[rint($val17+$(tmp0)*$val10)]
tmp0=!randint -2, 3

val19=$[rint($val9+$(tmp0)*$val11)]
tmp0=!randint -2, 2

val20=$[rint($val19+$(tmp0)*$val11)]
tmp0=!randint -2, 3

val21=$[rint($val9+$(tmp0)*$val11)]
tmp0=!randint -2, 2

val22=$[rint($val21+$(tmp0)*$val11)]

!ifval ($val20-$val19=0) and $val19=$val9
val19=$[rint($val19+2*$val11)]
!else
val19=$[rint($val19)]
!endif

!ifval ($val16-$val15=0) and $val15=$val8
val15=$[rint($val15+2*$val10)]
!else
val15=$[rint($val15)]
!endif

!ifval ($val15=$val16) and ($val19=$val20)
val15=$[rint($val15+$val10)]
!else
val15=$[rint($val15)]
!endif

!ifval ($val22-$val21=0) and $val21=$val9
val21=$[rint($val21+2*$val11)]
!else
val21=$[rint($val21)]
!endif

!ifval ($val18-$val17=0) and $val17=$val8
val17=$[rint($val17+2*$val10)]
!else
val17=$[rint($val17)]
!endif

!ifval ($val17=$val18) and ($val21=$val22)
val17=$[rint($val17+$val10)]
!else
val17=$[rint($val17)]
!endif
val23=arrow $val15,$val19,$val16,$val20,10,orange
val24=arrow $val17,$val21,$val18,$val22,10,blue

!ifval $val16-$val15>=0
val25=$[rint(-10)]
!else
val25=$[rint(10)]
!endif

!ifval $val20-$val19>=0
val26=$[rint(-5)]
!else
val26=$[rint(5)]
!endif

!ifval $val16-$val15>=0
val27=$[rint(10)]
!else
val27=$[rint(-10 )]
!endif

!ifval $val20-$val19>=0
val28=$[rint(5)]
!else
val28=$[rint(-5)]
!endif

!ifval $val18-$val17>=0
val29=$[rint(-10)]
!else
val29=$[rint(10)]
!endif

!ifval $val22-$val21>=0
val30=$[rint(-5)]
!else
val30=$[rint(5)]
!endif

!ifval $val18-$val17>=0
val31=$[rint(10)]
!else
val31=$[rint(-10 )]
!endif

!ifval $val22-$val21>=0
val32=$[rint(5)]
!else
val32=$[rint(-5)]
!endif
val33=$[rint($val8+($val16-$val15)+($val18-$val17))]
val34=$[rint($val9+($val20-$val19)+($val22-$val21))]

!ifval $val33-$val8>=0
val35=$[rint(10)]
!else
val35=$[rint(-10 )]
!endif

!ifval $val34-$val9>=0
val36=$[rint(10)]
!else
val36=$[rint(-10)]
!endif
val37=!rawmath (x-($val8))/$val10
val38=!rawmath (y-($val9))/$val11
evaltmp=$val37

evaltmp=!mathsubst x=($val33) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val39=$(tmp1)
evaltmp=$val38

evaltmp=!mathsubst y=($val34) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val40=$(tmp1)
val41=crosshair $val8,$val9,black	text black,$val8-10,$val9+5,medium,O	linewidth 2	$val23	text orange,$val15+$val25,$val19+$val26,medium,A	text orange,$val16+$val27,$val20+$val28,medium,B	$val24	text blue,$val17+$val29,$val21+$val30,medium,C	text blue,$val18+$val31,$val22+$val32,medium,D
!readproc oef/draw.phtml 400,400 \
$val12	$val41 
tmp0=$ins_url
val42=$(tmp0)
val43=dasharrow $val8,$val9,$val8+($val16-$val15),$val9+($val20-$val19),10,orange
val44=dasharrow $val8+($val16-$val15),$val9+($val20-$val19),$val33,$val34,10,blue
val45=$val12	$val41	$val43	$val44	arrow $val8,$val9,$val33,$val34,10,green	text green,$val33+$val35,$val34+$val36,medium,M	
replytype1=coord
replyname1=f($val13)
replygood1=$val42;circle,$val33,$val34,$val10/3
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le plan est rapporté à une grille sur laquelle sont représentés un point 
!insmath O
$() et deux vecteurs  
!insmath \overrightarrow{A B}
$() et <span class="nowrap">
!insmath \overrightarrow{C D}
$().</span>	<br>Le but de l'exercice est de construire le représentant d'origine 
!insmath O
$() du vecteur <span class="nowrap">
!insmath \overrightarrow{A B}+\overrightarrow{C D}
$().</span>		<div>Cliquer à l'emplacement de l'extrémité 
!insmath M
$() du vecteur	<span class="nowrap">
!insmath \overrightarrow{O M} = \overrightarrow{A B}+\overrightarrow{C D}
$().</span>	</div>		<div class="wimscenter unbreakable">	 
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	On peut commencer par construire :	<ul>	<li>le représentant du vecteur 
!insmath \overrightarrow{A B}
$() d'origine 
!insmath O
$() (en pointillé orange)&nbsp;;</li>	<li>puis le représentant du vecteur 
!insmath \overrightarrow{C D}
$() d'origine l'extrémité du vecteur construit précédemment (en pointillé bleu).</li>	</ul>	On en déduit le vecteur 
!insmath \overrightarrow{O M}
$() (en vert).		
!if $val39=0 and $val40=0 
$()<br>Ici 
!insmath  \overrightarrow{O M}
$()=
!insmath \overrightarrow{0}
$(), les points 
!insmath O
$() et 
!insmath M
$() sont confondus. 
!endif
$()	<div class="wimscenter">	 
!read oef/draw.phtml 400,400 \
$val45 
$()	</div>	
$()
!exit

