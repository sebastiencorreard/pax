!ifval $val26<0
val30=$val29  $val26
!endif
t_=!rawmath ($val7 - ($val26) + ($val21) * ($val9) ) / ($val28)
val31=!exec pari print($t_)
val27=$[rint(($val6-$val17)*($val7-$val23)-($val6-$val22)*($val7-$val18))]
!if $val7>=0 
