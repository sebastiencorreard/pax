tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

