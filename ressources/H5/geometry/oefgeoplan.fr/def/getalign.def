tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
val14=$[rint($val12*(-1)^$val10)]
val15=$[rint($val8*$val14)]
val16=$[rint($val9*$val14)]
val17=$[rint($val6+$val8*$val14)]
val18=$[rint($val7+$val9*$val14)]
tmp0=!randint 0, 1

val19=$[rint($(tmp0))]
tmp0=!randint 0, 1

val20=$[rint($(tmp0))]
val21=$[rint($val13*(-1)^$val11+$val19)]
val22=$[rint($val6+$val8*$val21)]
val23=$[rint($val7+$val9*$val13*(-1)^$val11+$val20*$val9)]
val24=$[rint($val8*$val21)]
tmp0=!randint 1, 5

val25=$[rint($(tmp0))]
tmp0=!randint -10, 10

val26=$[rint($(tmp0))]
tmp0=!randint 1, 2

val27=$[rint($(tmp0))]
val28=$[rint($val25*(-1)^$val27)]

!ifval $val28=1
val29=x
!endif

!ifval $val28=-1
val29= -x 
!endif

!ifval (($val28<>1) and ($val28<>-1))
val29=$val28 x  
