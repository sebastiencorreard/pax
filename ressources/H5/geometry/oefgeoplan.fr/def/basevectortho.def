$()&nbsp;:</span>	<div class="wimscenter"> 
!read oef/draw.phtml 400,400 \
$val26 
$()</div>	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=1,10,13,14,18,19,20,21,24,25,26
