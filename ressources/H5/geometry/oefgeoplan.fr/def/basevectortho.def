!set title= Coordonnées de vecteurs dans une base orthonormée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Euler,Académie de Versailles
email=euler.wims@ac-versailles.fr
precision=100
oefcss= <style> .disp_columns{ display: flex; flex-wrap: wrap; } </style> 

ansorder=r,r
varcnt=42
prevarcnt=24
postvarcnt=17
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(3)]
val7=$[rint($val6)]
t_=!rawmath 0
val8=!exec pari print($t_)
val9=$[rint(5)]
val10=xrange -$val9,$val9	  yrange -$val9,$val9	  parallel -$val9-$val8/2,-$val9,-$val9+$val8/2,$val9,1,0,2*$val9+1,gray	  parallel -$val9,-$val9,$val9,-$val9,0,1,2*$val9+1,gray	
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp=!nonempty items 0,pi/2,pi

tmp1=!randitem $tmp
val11=$(tmp0)*$(tmp1)
t_=!replace internal \( by ( in [cos($val11);sin($val11)]
tmp0=!exec pari $t_

val12=$(tmp0)
val13=$[$(val12[1;])]
val14=$[$(val12[2;])]
t_=!replace internal \( by ( in A=[0,-1;1,0];u=[$val12];A*u
tmp0=!exec pari $t_

val15=$(tmp0)
t_=!replace internal \( by ( in B=[0,1;-1,0];u=[$val12];B*u
tmp0=!exec pari $t_

val16=$(tmp0)
tmp=!nonempty items $val15,$val16

tmp0=!randitem $tmp
val17=$(tmp0)
val18=$[$(val17[1;])]
val19=$[$(val17[2;])]
tmp0=!randint 1, 2

tmp1=!randitem 1,-1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 2

tmp1=!randitem 1,-1

val21=$[rint($(tmp0)*$(tmp1))]
val22=$[rint($val20*($val13)+($val21)*($val18))]
val23=$[rint($val20*($val14)+($val21)*($val19))]
!if $val22>0 
tmp0=!randint -$val7, $val7-$val22

val24=$[rint($(tmp0))]
!else
tmp0=!randint -$val7-($val22), $val7

val24=$[rint($(tmp0))]
!endif
!if $val23>0 
tmp0=!randint -$val7, $val7-$val23

val25=$[rint($(tmp0))]
!else
tmp0=!randint -$val7-($val23), $val7

val25=$[rint($(tmp0))]
!endif
val10=$val10	 linewidth 2	 arrow 0,0,$val13,$val14,10,red	 arrow 0,0,$val18,$val19,10,blue	 arrow $val24,$val25,$val24+$val22,$val25+$val23,10,green	 text red,$val13-0.2,$val14-0.2,large,u	 text blue,$val18-0.2,$val19-0.2,large,v	 text green,$val24+$val22-0.2,$val25+$val23-0.2,large,w	 
val26=$val10	 darrow $val24,$val25,$val24+$val20*$val13,$val25+$val20*$val14,10,red	 darrow $val24+$val20*$val13,$val25+$val20*$val14,$val24+$val22,$val25+$val23,10,blue	
replytype1=numeric
replyname1=Première coordonnée
replygood1=$[$val20]
replytype2=numeric
replyname2=Deuxième coordonnée
replygood2=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<script>	function logoOEFTitle(){	  var elt=document.querySelector("h1.oeftitle");	  var elChild = document.createElement("IMG");	  elChild.setAttribute("src","$val1/logo_euler.png");	  elChild.setAttribute("width","48");	  elChild.setAttribute("height","36");	  elChild.setAttribute("style","float:right;margin-left:0.5em;margin-right:0.2em;");	  elChild.setAttribute("alt","Logo Euler Académie de Versailles");	  elChild.setAttribute("title","Euler Académie de Versailles");	  elt.insertBefore(elChild,elt.firstChild);	}		document.addEventListener("DOMContentLoaded", function(){	  logoOEFTitle();	});	</script>	<div class="disp_columns">	  <div class="medium_size">	    <p>Dans le plan muni d'une base orthonormée 
!insmath (\overrightarrow{u},\overrightarrow{v})
$() on a placé un vecteur <span class="nowrap">
!insmath \overrightarrow{w}
$().</span><br>	      L'objectif est d'exprimer le vecteur 
!insmath \overrightarrow{w}
$() en fonction des vecteurs 
!insmath \overrightarrow{u}
$() et <span class="nowrap">
!insmath \overrightarrow{v}
$().</span></p>	    <p>Déterminer les nombres 
!insmath a
$() et 
!insmath b
$() tels que <span class="nowrap">
!insmath \overrightarrow{w} = a \overrightarrow{u} + b \overrightarrow{v}
$().</span></p>	    <div><label for="reply1">
!insmath a
$()</label> =  
!read oef/embed.phtml reply1,3 
$()</div>	    <div class="spacer"><label for="reply2">
!insmath b
$()</label> =  
!read oef/embed.phtml reply2,3 
$()</div>	  </div>	  <div class="medium_size">	     
!read oef/draw.phtml 400,400 \
$val10 
$()	  </div>	</div>				
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!if $m_reply1=1 
val27=
!else
!if $m_reply1=-1 
val27=-
!else
tmp0=!texmath $m_reply1

val27=$(tmp0)
!endif
!endif
!if $m_reply2>0 
val28=+
!else
val28=-
!endif
!if $m_reply2=1 or $m_reply2=-1 
val29=
!else
t_=!rawmath abs($m_reply2)
val30=!exec pari print($t_)
tmp0=!texmath $val30

val29=$(tmp0)
!endif
!if $val20=1 
val31=
!else
!if $val20=-1 
val31=-
!else
tmp0=!texmath $val20

val31=$(tmp0)
!endif
!endif
!if $val21>0 
val32=+
!else
val32=-
!endif
!if $val21=1 or $val21=-1 
val33=
!else
t_=!rawmath abs($val21)
val34=!exec pari print($t_)
tmp0=!texmath $val34

val33=$(tmp0)
!endif
val35=$val10	 linewidth 2	 darrow $val24,$val25,$val24+$m_reply1*$val13,$val25+$m_reply1*$val14,10,red	 darrow $val24+$m_reply1*$val13,$val25+$m_reply1*$val14,$val24+$m_reply1*$val13+$m_reply2*$val18,$val25+$m_reply1*$val14+$m_reply2*$val19,10,blue	 arrow $val24,$val25,$val24+$m_reply1*$val13+$m_reply2*$val18,$val25+$m_reply1*$val14+$m_reply2*$val19,10,black	

!exit

:feedback
!ifval $val20 <>$m_reply1 or $val21<>$m_reply2
 <div class='oef_feedbacks'>	Voici, construit <strong>en noir</strong>, un représentant du vecteur 
!insmath \color{red}$val27\overrightarrow{u} \color{blue}$val28 $val29 \overrightarrow{v}
$() correspondant à votre réponse&nbsp;:	<div class="wimscenter"> 
!read oef/draw.phtml 400,400 \
$val35 
$()</div>	
$()</div>
!endif
!ifval 1=1
 <div class='oef_feedbacks'>	
!if $m_sc_reply1 = 1 and $m_sc_reply2=1 
$()Effectivement, la  
!else
$() La  
!endif
$() réponse exacte est <span class="nowrap">
