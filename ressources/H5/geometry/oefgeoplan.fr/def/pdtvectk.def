!ifval $m_reply1<0 and $val17>0
 <div class='oef_feedbacks'>Attention : les vecteurs 
!insmath $val15
$() et 
!insmath $val16
$() sont de même sens,	le coefficient doit donc être positif.
$()</div>
!endif
!ifval $m_reply1==$val18 and abs($val17)!=1 
 <div class='oef_feedbacks'> Attention : on a 
!insmath $val15= $val19 $val16
$() et 
