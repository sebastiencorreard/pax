tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 2, 7

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 7

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 7

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,3,5

val10=$[rint($(tmp0))]

!ifval $val6=1
val11=$[rint($val7)]
!else
val11=$[rint($val7*$val10)]
!endif

!ifval $val11+$val8=0
val8=$[rint(-1*($val8))]
!else
val8=$[rint($val8)]
!endif

!ifval $val8+$val9=0
val9=$[rint(-1*($val9))]
!else
val9=$[rint($val9)]
!endif

!ifval $val8<0
val12=-
!else
val12=+
!endif

!ifval $val8<0
val8=$[rint(-1*($val8))]
!endif
tmp=!translate ";': to $     $ in $val8/$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val9/$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp0=!texmath $val13

val15=$(tmp0)
tmp0=!texmath $val14

val16=$(tmp0)

!ifval $val13=1
val17= 
!else
tmp0=!texmath $val13

val17=$(tmp0)
!endif

!ifval $val14=1
val18= 
!else
tmp0=!texmath $val14

val18=$(tmp0)
!endif

!ifval $val18=-1
val18=-
!endif

!ifval $val6=1
val19= $val7 \overrightarrow{A P} $val12 $val8 \overrightarrow{B P} = $val9 \overrightarrow{A B}
!else
val19=$val7 \overrightarrow{A P} $val12 $val17 \overrightarrow{B P} = $val18 \overrightarrow{A B}
!endif

!ifval $val6=1
t_=!rawmath  (($val9)$val12($val8))/(($val7)$val12($val8))
val20=!exec pari print($t_)
!else
t_=!rawmath (($val9)$val12($val8))/(($val7)*$val10 $val12 ($val8))
val20=!exec pari print($t_)
!endif

!ifval $val6=1
val21= $val7 \overrightarrow{A P} $val12 $val8 \overrightarrow{B A} $val12 $val8 \overrightarrow{A P} = $val9 \overrightarrow{A B}
!else
val21=$val7 \overrightarrow{A P} $val12 $val17 \overrightarrow{B A} $val12 $val17 \overrightarrow{A P} = $val18 \overrightarrow{A B}
!endif

!ifval $val6=1
val22= ($val7 $val12 $val8) \overrightarrow{A P} = ($val9 $val12 $val8) \overrightarrow{A B}
!else
val22=($val7 $val12 $val15) \overrightarrow{A P} = ($val16 $val12 $val15) \overrightarrow{A B}
!endif
val23=$[rint((($val9)$val12($val8)))]

!ifval $val6=1
val24=$[rint((($val7)$val12($val8)))]
!else
val24=$[rint((($val7)*$val10 $val12 ($val8)))]
!endif
tmp=!translate ";': to $     $ in $val23 / ($val24)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
tmp0=!replace internal / by , in $val25

val25=$(tmp0)
tmp0=!itemcnt $val25


!ifval $(tmp0)>1
val25=\frac{$(val25[1])}{$(val25[2])}
!endif
!if $val25=1 
val25=
