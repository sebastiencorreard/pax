\statement{
Placer le point \(M\) défini par
<div class="wimscenter"> \(\tca \overrightarrow{A M} \s1 \tc \overrightarrow{B M}=\overrightarrow{0}).</div>
Cliquer à l'emplacement du point \(M\).
<div class="wimscenter  unbreakable">
\embed{r1}
</div>
 }

\answer{f(\X)}{\image;rectangle,\fxxm,0,\fxxp,64}{type=coord}
\hint{Transformer l'écriture \(\tca \overrightarrow{A M} \s1 \tc \overrightarrow{B M}=\overrightarrow{0}) pour obtenir une expression de la forme&nbsp;:
<div class="wimscenter"> \(\overrightarrow{A M}=k \overrightarrow{A B}) </div>}
\solution{
On commence par transformer l'écriture \(\tca \overrightarrow{A M}\s1 \tc \overrightarrow{B M}=\overrightarrow{0})
pour obtenir une expression de la forme&nbsp;:
<div class="wimscenter"> \(\overrightarrow{A M}=k \overrightarrow{A B}) </div>
On trouve \(\overrightarrow{A M}= \s11 \tc \overrightarrow{A B})
<p>
On peut alors facilement placer le point <span class="nowrap">\(M\)&nbsp;:</span>
</p>
<div class="wimscenter">
\draw{800,64}{\repimage}
</div>
}
