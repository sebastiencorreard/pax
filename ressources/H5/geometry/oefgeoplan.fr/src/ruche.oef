\title{Relation de Chasles et hexagone}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\real{a=sin(pi/3)}
\text{dessin=
 xrange -3,3
 yrange -3,3
linewidth 2
 polyline blue,-2,0,-5/2,\a,-2,2*\a,-1,2*\a,-1/2,3*\a,1/2,3*\a,1,2*\a,2,2*\a,5/2,\a,2,0
 polyline blue,2,0,5/2,-\a,2,-2*\a,1,-2*\a,1/2,-3*\a,-1/2,-3*\a,-1,-2*\a,-2,-2*\a,-5/2,-\a,-2,0
 polyline blue,-1,0,-1/2,\a,1/2,\a,1,0,1/2,-\a,-1/2,-\a,-1,0
 polyline blue,-1,2*\a,-1/2,\a,1/2,\a,1,2*\a
 polyline blue,-1,-2*\a,-1/2,-\a,1/2,-\a,1,-2*\a
 segment -2,0,-1,0,blue
 segment 1,0,2,0,blue

 text black,-2.6,\a,medium,G
 text black,-2.6,-\a,medium,O
 text black,-2.1,2*\a+0.2,medium,C
 text black,-2.2,0,medium,K
 text black,-2.1,-2*\a,medium,S
 text black,-1.1,2*\a+0.2,medium,D
 text black,-1.1,0,medium,L
 text black,-1.1,-2*\a,medium,T
 text black,-0.6,3*\a+0.2,medium,A
 text black,-0.7,\a,medium,H
 text black,-0.7,-\a,medium,P
 text black,-0.6,-3*\a,medium,W

 text black,2.6,\a,medium,J
 text black,2.6,-\a,medium,R
 text black,2.1,2*\a+0.2,medium,F
 text black,2.1,0,medium,N
 text black,2.1,-2*\a,medium,V
 text black,1.1,2*\a+0.2,medium,E
 text black,1.1,0,medium,M
 text black,1.1,-2*\a,medium,U
 text black,0.6,3*\a+0.2,medium,B
 text black,0.6,\a,medium,I
 text black,0.6,-\a,medium,Q
 text black,0.6,-3*\a,medium,Z

 segment -1/2,\a,1/2,-\a,red
 segment 1/2,\a,-1/2,-\a,red
 segment -1,0,1,0,red
}
\text{data2=\overrightarrow{K L}+3\overrightarrow{L H},K,B,
\overrightarrow{K L}+3\overrightarrow{T P},K,B,
\overrightarrow{P Q}+3\overrightarrow{G C},S,I,
\overrightarrow{M N}-3\overrightarrow{E I},W,N}
\integer{i=randint(1..4)}
integer{i=4}
\text{cedata=row(\i,\data2)}
\integer{k2=randint(1,2)}
\text{quest2=\cedata[1]}
\text{l2=\k2=1?\cedata[2]:\cedata[3]}
\text{rep2=\k2=1?\cedata[3]:\cedata[2]}

\text{data1=\overrightarrow{O K}+\overrightarrow{K L},I,F,
\overrightarrow{O K}+\overrightarrow{E F},I,F,
\overrightarrow{T P}+\overrightarrow{C D},L,I,
\overrightarrow{M N}-\overrightarrow{H L},H,E}
\integer{i=randint(1..4)}
integer{i=4}
\text{cedata=row(\i,\data1)}
\integer{k1=randint(1,2)}
\text{quest1=\cedata[1]}
\text{l1=\k1=1?\cedata[2]:\cedata[3]}
\text{rep1=\k1=1?\cedata[3]:\cedata[2]}

\text{data3=\overrightarrow{C D}+\overrightarrow{F J}+\overrightarrow{M Q},H,Q,
\overrightarrow{H I}-\overrightarrow{R N}+\overrightarrow{P T},K,T,
\overrightarrow{G K}+\overrightarrow{A B}+\overrightarrow{V R},L,M,
\overrightarrow{G K}-\overrightarrow{Z W}+\overrightarrow{I E},D,E}
\integer{i=randint(1..4)}
integer{i=4}
\text{cedata=row(\i,\data3)}
\integer{k3=randint(1,2)}
\text{quest3=\cedata[1]}
\text{l3=\k3=1?\cedata[2]:\cedata[3]}
\text{rep3=\k3=1?\cedata[3]:\cedata[2]}

\text{debut1=\k1=1?\l1}
\text{debut2=\k2=1?\l2}
\text{debut3=\k3=1?\l3}
\text{fin1=\k1=2?\l1}
\text{fin2=\k2=2?\l2}
\text{fin3=\k3=2?\l3}

\statement{
<div class="float_left spacer">
\draw{400,400}{\dessin}
</div>
<div class="float_left spacer">
La ruche d'abeille dessinée ici est formée d'hexagones réguliers.
<div class="wims_instruction"> Tous les segments représentés sont de même longueur.</div>

A l'aide du dessin, compléter les égalités vectorielles suivantes&nbsp;:
<div class="wimscenter">

\special{mathmlinput [\begin{matrix}
  \quest1 &=\overrightarrow{\debut1 reply1 \fin1}\\
  \quest2 &=\overrightarrow{\debut2 reply2 \fin2}\\
  \quest3 &=\overrightarrow{\debut3 reply3 \fin3}
\end{matrix}], 2
reply1
reply2
reply3
}
</div>
</div>
}
\answer{\(\quest1\)&nbsp;:}{\rep1}{type=text}
\answer{\(\quest2\)&nbsp;:}{\rep2}{type=text}
\answer{\(\quest3\)&nbsp;:}{\rep3}{type=text}
