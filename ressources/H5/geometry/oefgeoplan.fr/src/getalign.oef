\title{Obtenir un alignement}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x1=random(-5..5)}
\integer{y1=random(-5..5)}
\integer{x=random(1..10)}
\integer{y=random(1..10)}
\integer{d1=random(1..2)}
\integer{d2=random(1..2)}
\integer{k2=random(1..5)}
\integer{k3=random(1..5)}
\integer{difx12=\k2*(-1)^\d1}
\integer{v1x=\x*\difx12}
\integer{v1y=\y*\difx12}
\integer{x2=\x1+\x*\difx12}
\integer{y2=\y1+\y*\difx12}
\integer{e1=random(0..1)}
\integer{e2=random(0..1)}
\integer{difx13=\k3*(-1)^\d2+\e1}
\integer{x3=\x1+\x*\difx13}
\integer{y3=\y1+\y*\k3*(-1)^\d2+\e2*\y}
\integer{v2x=\x*\difx13}

\integer{m=random(1..5)}
\integer{p=random(-10..10)}
\integer{d=random(1..2)}
\integer{k=\m*(-1)^\d}

\text{mon=\k=1?x}
\text{mon=\k=-1? -x }
\text{mon=((\k<>1) and (\k<>-1))?\k x  }


\text{pol=\p>0?\mon + \p}
\text{pol=\p=0?\mon }
\text{pol=\p<0?\mon  \p}

\rational{sol=(\y1 - (\p) + (\difx13) * (\y) ) / (\k)}
\integer{d=(\x1-\x2)*(\y1-\y3)-(\x1-\x3)*(\y1-\y2)}

\if{\y1>=0}
  {\text{pol_y1=\pol-\y1}}
  {\text{pol_y1=\pol-(\y1)}}
\text{pol_y1red=pari(\k*x+(\p)-(\y1))}
\text{pol_y1red=wims(replace internal * by in \pol_y1red)}

\if{\v1y>=0}
  {\text{v1ys=\v1y}}
  {\text{v1ys=(\v1y)}}


\statement{
Déterminer la valeur du nombre réel \(x\) qui rend alignés les points <span class="nowrap">\(A\),</span>\(B\) et \(C\)
 dont les coordonnées dans un repère donné sont respectivement
 <span class="nowrap">\(\left(\x1 ; \y1 \right)\),</span>
 \(\left(\x2 ; \y2 \right)\) et
 <span class="nowrap">\(\left(\x3 ; \pol \right)\).</span>

<div>
<b>Condition d'alignement : </b>

<label for="reply1">\( x\)</label> =\embed{r1,4}
</div>
}

\answer{x}{\sol}{type=numeric}
\solution{Calculons les coordonnées des vecteurs \(\overrightarrow{A B}) et <span class="nowrap">\(\overrightarrow{A C})&nbsp;:</span><br>
\(\overrightarrow{A B})\(\left(\begin{array}{c} \v1x \\ \v1y \end{array}\right)) et
 \(\overrightarrow{A C})\(\left(\begin{array}{c} \v2x \\ \pol_y1 \end{array}\right))<br>
On résout donc l'équation \( \v1x \times (\pol_y1red)= \v2x \times \v1ys )<br>
Ce qui donne \(x=\sol\).
}
