\title{Somme de deux vecteurs}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{donnees=slib(draw/repere 460,460,20,-7,7,-7,7,1,1,black,grey)}

\text{tmp=row(1,\donnees)}
#coordonnéées de l'origine du repère
\integer{Ox=item(1,\tmp)}
\integer{Oy=item(2,\tmp)}

\text{tmp=row(2,\donnees)}
#échelle des axes
\integer{ex=item(1,\tmp)}
\integer{ey=item(2,\tmp)}

\text{grille=wims(line 3 to -1 of \donnees)}
#on a maintenant les axes non nommés et la grille
#pour placer l'origine, il faut écrire du texte
\integer{X=random(-1,1)*random(1..5)}
\integer{Y=random(-1,1)*random(1..5)}
#on ne veut pas X=0

#ensuite on place deux vecteurs (X,Y)
\integer{ax=\Ox+random(-2..3)*\ex}
\integer{bx=\ax+random(-2..2)*\ex}
\integer{cx=\Ox+random(-2..3)*\ex}
\integer{dx=\cx+random(-2..2)*\ex}
\integer{ay=\Oy+random(-2..3)*\ey}
\integer{by=\ay+random(-2..2)*\ey}
\integer{cy=\Oy+random(-2..3)*\ey}
\integer{dy=\cy+random(-2..2)*\ey}

controle des vecteurs
\integer{ay=(\by-\ay=0) and \ay=\Oy?\ay+2*\ey:\ay}
\integer{ax=(\bx-\ax=0) and \ax=\Ox?\ax+2*\ex:\ax}
\integer{ax=(\ax=\bx) and (\ay=\by)?\ax+\ex:\ax}
\integer{cy=(\dy-\cy=0) and \cy=\Oy?\cy+2*\ey:\cy}
\integer{cx=(\dx-\cx=0) and \cx=\Ox?\cx+2*\ex:\cx}
\integer{cx=(\cx=\dx) and (\cy=\dy)?\cx+\ex:\cx}



\text{vecAB=arrow \ax,\ay,\bx,\by,10,orange}
\text{vecCD=arrow \cx,\cy,\dx,\dy,10,blue}

calcul des pentes des vecteurs pour affichage des lettres
\integer{offax=\bx-\ax>=0?-10:10}
\integer{offay=\by-\ay>=0?-5:5}
\integer{offbx=\bx-\ax>=0?10:-10 }
\integer{offby=\by-\ay>=0?5:-5}
\integer{offcx=\dx-\cx>=0?-10:10}
\integer{offcy=\dy-\cy>=0?-5:5}
\integer{offdx=\dx-\cx>=0?10:-10 }
\integer{offdy=\dy-\cy>=0?5:-5}

calcul des coordonnées de M
\integer{fx=\Ox+(\bx-\ax)+(\dx-\cx)}
\integer{fy=\Oy+(\by-\ay)+(\dy-\cy)}
\integer{offmx=\fx-\Ox>=0?10:-10 }
\integer{offmy=\fy-\Oy>=0?5:-5}

\function{trx=(x-(\Ox))/\ex}
\function{try=(y-(\Oy))/\ey}
\text{fxx=simplify(evalue(\trx,x=\fx))}
\text{fyy=simplify(evalue(\try,y=\fy))}

affichage du dessin
\text{image=draw(460,460
\grille
text black,\Ox-10,\Oy+5,medium,O
text black,\Ox+30,\Oy+5,medium,I
text black,\Ox-15,\Oy-40,medium,J
linewidth 2
arrow \Ox,\Oy,\Ox+\ex,\Oy,10,red
arrow \Ox,\Oy,\Ox,\Oy+\ey,10,red
\vecAB
text orange,\ax+\offax,\ay+\offay,medium,A
text orange,\bx+\offbx,\by+\offby,medium,B
\vecCD
text blue,\cx+\offcx,\cy+\offcy,medium,C
text blue,\dx+\offdx,\dy+\offdy,medium,D)
}

réaffichage du dessin
\text{vecCDtr=dasharrow \bx,\by,\bx+\dx-\cx,\by+\dy-\cy,10,blue}
\text{vecOMtr=dasharrow \ax,\ay,\bx+\dx-\cx,\by+\dy-\cy,10,green}
\text{repimage=\grille
text black,\Ox-10,\Oy+5,medium,O
text black,\Ox+30,\Oy+5,medium,I
text black,\Ox-15,\Oy-40,medium,J
linewidth 2
arrow \Ox,\Oy,\Ox+\ex,\Oy,10,red
arrow \Ox,\Oy,\Ox,\Oy+\ey,10,red
\vecAB
text orange,\ax+\offax,\ay+\offay,medium,A
text orange,\bx+\offbx,\by+\offby,medium,B
\vecCD
text blue,\cx+\offcx,\cy+\offcy,medium,C
text blue,\dx+\offdx,\dy+\offdy,medium,D
\vecCDtr
\vecOMtr
arrow \Ox,\Oy,\fx,\fy,10,green
text green,\fx+\offmx,\fy+\offmy,medium,M
}

Exercice à étapes dynamiques
\text{mstep=r1
r2,r3
}
\steps{\mstep}

\statement{
<p>Le but de l'exercice est de construire le représentant d'origine \(O\)
 du vecteur <span class="nowrap">\(\overrightarrow{A B}+\overrightarrow{C D}\),</span>
 puis de déterminer les coordonnées du point \(M\) dans le repère <span class="nowrap">\((O, I, J)\).</span></p>
 
\if{\step=1}{

<p class="spacer">
1 - Cliquer à l'emplacement de l'extrémité \(M\) du vecteur
<span class="nowrap">\(\overrightarrow{O M} = \overrightarrow{A B}+\overrightarrow{C D}\).</span></p>

<div class="wimscenter unbreakable">
\embed{r1}
</div>
}{
<div class="wimscenter">
\draw{460,460}{\repimage}
</div>
<p>2 - Indiquer les coordonnées du point <span class="nowrap">\(M\) :</span>
<ul>
<li><label for="reply2">Abscisse de <span class="nowrap">\(M\) :</span></label> \embed{r2,6}
</li><li><label for="reply3">Ordonnée de <span class="nowrap">\(M\) :</span></label> \embed{r3,4}
</li></ul>

}}
answer{f(\X)}{\image;circle,\fx,\fy,\ex/3}{type=coord}
\answer{Point M}{\image;circle,\fx,\fy,\ex/3;rectangle,0,0,460,460}{type=coord}
\answer{abscisse de M}{\fxx}{type=numexp}
\answer{ordonnée de M}{\fyy}{type=numexp}
 if{\step=2}{\text{mstep=}}{\text{mstep=r2,r3}}

\solution{
<p>1 - On commence par construire le représentant du vecteur \(\overrightarrow{C D}\) d'origine \(B\)
(en pointillé bleu).
<br>
On en déduit le représentant du vecteur \(\overrightarrow{O M}\) d'origine \(A\) (en pointillé vert).
<br> Enfin on construit le vecteur \(\overrightarrow{O M}\) (en vert).</p>
<div class="wimscenter">
\draw{460,460}{\repimage}
</div>
<p>2 - Dans le repère <span class="nowrap">\((O, I, J)\),</span> <span class="nowrap">\(M \big(\fxx \,; \fyy \big)\).</span>
}
