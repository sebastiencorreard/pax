\title{Caractérisations vectorielles}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}
\css{
<style>
.flex_box{
  justify-content:flex-start;
}
</style>
}
\text{pt=A,B,C,D,E,F}
\integer{nbpt=items(\pt)}
\integer{pty=\Oy}
\text{listx=}
\text{listpt=}
\text{listquest=}
\text{listrep=}
\text{indlist=shuffle(\nbpt)}
## Liste des figures
\text{listefig=milieu.png,sym.png,para1.png}
\text{listalt=Segment AB de milieu C,C symétrique de A par rapport à B,ABCD parallélogramme}

## Liste des caratérisations
\text{listecar=C est le milieu du segment \([A B]\),
\(C\) est le symétrique de \(A\) par rapport à \(B\),
\(A B C D\) est un parallèlogramme}
## Caractérisations du milieu
# 1
\text{listmil=}
\text{carmil=\(\overrightarrow{A C}=\overrightarrow{C B})}
\text{listmil = wims( append item \carmil to \listmil) }
# 2
\text{carmil=\(\overrightarrow{B C}=\overrightarrow{C A})}
\text{listmil = wims( append item \carmil to \listmil) }
# 3
\text{carmil=\(\overrightarrow{A C}=\frac{1}{2}\overrightarrow{A B})}
\text{listmil = wims( append item \carmil to \listmil) }
# 4
\text{carmil=\(\overrightarrow{A C}=-\overrightarrow{B C})}
\text{listmil = wims( append item \carmil to \listmil) }
# 5
\text{carmil=\(\overrightarrow{B C}=-\overrightarrow{A C})}
\text{listmil = wims( append item \carmil to \listmil) }
# 6
\text{carmil=\(\overrightarrow{B C}=-\frac{1}{2}\overrightarrow{A B})}
\text{listmil = wims( append item \carmil to \listmil) }
#7
\text{carmil=\(\overrightarrow{A B}+\overrightarrow{A C}=3\overrightarrow{C B})}
\text{listmil = wims( append item \carmil to \listmil) }

## Caratérisations du symétrique
#7
\text{listsym=}
\text{carsym=\(\overrightarrow{A C}+\overrightarrow{A B}=3\overrightarrow{B C})}
\text{listsym = wims( append item \carsym to \listsym) }
# 1
\text{carsym=\(\overrightarrow{A B}=\overrightarrow{B C})}
\text{listsym = wims( append item \carsym to \listsym) }
# 2
\text{carsym=\(\overrightarrow{C B}=\overrightarrow{B A})}
\text{listsym = wims( append item \carsym to \listsym) }
# 3
\text{carsym=\(\overrightarrow{A B}=\frac{1}{2}\overrightarrow{A C})}
\text{listsym = wims( append item \carsym to \listsym) }
# 4
\text{carsym=\(\overrightarrow{A B}=-\overrightarrow{C B})}
\text{listsym = wims( append item \carsym to \listsym) }
# 5
\text{carsym=\(\overrightarrow{C B}=-\overrightarrow{A B})}
\text{listsym = wims( append item \carsym to \listsym) }
# 6
\text{carsym=\(\overrightarrow{C B}=-\frac{1}{2}\overrightarrow{A C})}
\text{listsym = wims( append item \carsym to \listsym) }

## Caractérisations du parallélogramme
# 1
\text{listpar=}
\text{carpar=\(\overrightarrow{A B}+\overrightarrow{A D}=\overrightarrow{A C})}
\text{listpar = wims( append item \carpar to \listpar) }
# 2
\text{carpar=\(\overrightarrow{B A}+\overrightarrow{B C}=\overrightarrow{B D})}
\text{listpar = wims( append item \carpar to \listpar) }
# 3
\text{carpar=\(\overrightarrow{C B}+\overrightarrow{C D}=\overrightarrow{C A})}
\text{listpar = wims( append item \carpar to \listpar) }
# 4
\text{carpar=\(\overrightarrow{D A}+\overrightarrow{D C}=\overrightarrow{D B})}
\text{listpar = wims( append item \carpar to \listpar) }

### Sélectionn aléatoire des questions
\text{listquest=}
\text{listquest=wims(append item randomitem(\listmil) to \listquest)}
\text{listquest=wims(append item randomitem(\listsym) to \listquest)}
\text{listquest=wims(append item randomitem(\listpar) to \listquest)}
\text{taille=100x150x150}
\statement{
Associer la propriété géométrique avec la caractérisation vectorielle&nbsp;:
<div class="wimscenter" \if{\sc_reply1 !=}{style="overflow-x:auto;"}>
  \embed{reply 1,\taille}
</div>
 }
\reply{Correspondance }{\listecar;\listquest}{type=correspond}

\solution{

<div class="flex_box">
    \for{kk=1 to 3}{
    <div class="wimscenter wims_question">
      <div>\listecar[\kk]</div>
      <img src="\imagedir/\listefig[\kk]" alt ="\listalt[\kk]">
      <div>\listquest[\kk]</div>
    </div>}
</div>


}
