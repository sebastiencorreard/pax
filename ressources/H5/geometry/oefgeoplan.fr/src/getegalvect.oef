\title{Obtenir une égalité vectorielle simple}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

choix parametre entier ou rationnel
\integer{choix=randitem(1,2)}
\integer{a=randint(2..7)*randint(1,-1)}
\integer{b=randint(2..7)*randint(1,-1)}
\integer{c=randint(2..7)*randint(1,-1)}
\integer{d=random(2,3,5)}

\integer{e=\choix=1?\a:\a*\d}
## on ne veut pas \e+\b=0
\integer{b=\e+\b=0?-1*(\b):\b}
## on ne veut pas \a+\b=0
\integer{c=\b+\c=0?-1*(\c):\c}
\text{s1=\b<0?-:+}
\integer{b=\b<0?-1*(\b)}
\rational{b2=simplify(\b/\d)}
\rational{c2=simplify(\c/\d)}
\text{tb3=texmath(\b2)}
\text{tc3=texmath(\c2)}
\text{tb2=\b2=1? :texmath(\b2)}
\text{tc2=\c2=1? :texmath(\c2)}
\text{tc2=\tc2=-1?-}
\text{rel=\choix=1? \a \overrightarrow{A P} \s1 \b \overrightarrow{B P} = \c \overrightarrow{A B}:\a \overrightarrow{A P} \s1 \tb2 \overrightarrow{B P} = \tc2 \overrightarrow{A B}}
\rational{sol=\choix=1? ((\c)\s1(\b))/((\a)\s1(\b)):((\c)\s1(\b))/((\a)*\d \s1 (\b))}
\text{relsol=\choix=1? \a \overrightarrow{A P} \s1 \b \overrightarrow{B A} \s1 \b \overrightarrow{A P} = \c \overrightarrow{A B}:\a \overrightarrow{A P} \s1 \tb2 \overrightarrow{B A} \s1 \tb2 \overrightarrow{A P} = \tc2 \overrightarrow{A B}}
\text{relsol2=\choix=1? (\a \s1 \b) \overrightarrow{A P} = (\c \s1 \b) \overrightarrow{A B}:(\a \s1 \tb3) \overrightarrow{A P} = (\tc3 \s1 \tb3) \overrightarrow{A B}}
\integer{solnum= ((\c)\s1(\b))}
\integer{solden=\choix=1?((\a)\s1(\b)):((\a)*\d \s1 (\b))}
\text{coefsol=simplify(\solnum / (\solden))}
\text{coefsol=wims(replace internal / by , in \coefsol)}
\text{coefsol=items(\coefsol)>1?\frac{\coefsol[1]}{\coefsol[2]}}
\if{\coefsol=1}
  {\text{coefsol=}}
\if{\coefsol=-1}
  {\text{coefsol=-}}

\text{relsol3= \overrightarrow{A P}= \coefsol \overrightarrow{A B}}
\statement{
Transformer la relation <div class="wimscenter"> \( \rel )</div>
afin d'obtenir une égalité vectorielle de la forme <div class="wimscenter">
\(\overrightarrow{A P} = k \overrightarrow{A B})</div>

<b>Egalité vectorielle&nbsp;:</b>

<div class="wimscenter">
<label for="reply1">\(\overrightarrow{A P}) =</label> \embed{r1,4}\(\overrightarrow{A B})
</div>
 }

\answer{coeff}{\sol}{type=numexp}
\hint{Décomposer le vecteur \(\overrightarrow{B P}) à l'aide de la relation de Chasles.
Quel point semble le plus judicieux pour cette décomposition&nbsp;?
}
\solution{
On commence par décomposer \(\overrightarrow{B P}) en
<span class="nowrap">\(\overrightarrow{B A}+\overrightarrow{A P}\).</span>
<br>
On obtient  \(\relsol)
<br>
Puis  \(\relsol2)
<br>
et enfin  \(\relsol3)
}
