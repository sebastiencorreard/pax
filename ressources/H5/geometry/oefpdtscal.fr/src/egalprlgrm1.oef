\title{Egalité du parallélogramme 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\matrix{lettre=A,M,E,M,R
B,A,F,N,S
C,T,G,P,T
D,H,H,R,U
}
\integer{choix=randitem(1,randint(1..5))}
\text{A=\lettre[1;\choix]}
\text{B=\lettre[2;\choix]}
\text{C=\lettre[3;\choix]}
\text{D=\lettre[4;\choix]}
\text{cote2=randitem(\A \D,\B \C)}
\integer{a=randint(4..10)}
\integer{d=randint(5..12)}
\integer{e=randint(1..(\a+\d-1))}
\integer{f2=2*\a^2+2*\d^2-\e^2}
\text{f=sqrt(\f2)}
<!-- pour le corrigé -->
\integer{somme=\a^2*2+2*\d^2}
\integer{e2=\e^2}
\integer{valex1=(floor(sqrt(\f2))=sqrt(\f2))? 1:0}
\integer{valex2=sqrt(\f2)}

\statement{<p>\(\A \B \C \D) est un parallélogramme tel que \(\A \B=\a) cm, \(\cote2=\d) cm et \(\A \C=\e) cm. 
Calculer la valeur exacte de \(\B \D).</p>
\(\B \D=)\embed{r1,4} cm.
<div class="wims_instruction">Pour \(\sqrt{...}), écrire : sqrt(...)</div>}
\answer{}{\f}{type=formal}
\solution{D'après l'égalité du parallélogramme dans \(\A \B \C \D), \(\A \B^2+\B \C^2+\C \D^2+\D \A^2=\A \C^2+\B \D^2).<br/>
\(\a^2+\d^2+\a^2+\d^2=\B \D^2+\e^2) &hArr; \(\somme=\B \D^2+\e2) &hArr; \(\B \D^2=\somme-\e2=\f2) &hArr; \(\B \D=\sqrt{\f2})
\if{\valex1=1}{\({}=\valex2)} cm.}
