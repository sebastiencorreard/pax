\title{Calcul analytique 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\computeanswer{no}
\precision{1000}
\integer{x1=randint(2..20)}
\integer{x2=randint(-10..10)}
\integer{y1=randint(-10..10)}
\integer{y2=\x2+randint(2..10)*randint(-1,1)}
\integer{ps=\x1*\x2+\y1*\y2}

<!-- pour le corrigé -->
\text{t2=(\x2<0)? (\x2):\x2}
\text{t3=(\y1<0)? (\y1):\y1}
\text{t4=(\y2<0)? (\y2):\y2}

\statement{<p>Calculer \(\overrightarrow{u}\cdot\overrightarrow{v}) avec
 \(\overrightarrow{u} \left ( \begin{array}{c}\x1\\\y1\end{array}\right )) et  \(\overrightarrow{v} \left ( \begin{array}{c}\x2\\\y2\end{array}\right )) dans un repère orthonormé.</p>
\(\overrightarrow{u}\cdot\overrightarrow{v})=\embed{r1,4}. }
\answer{}{\ps}{type=formal}
\solution{\(\overrightarrow{u}\cdot\overrightarrow{v}=\x1\times\t2+\t3\times\t4=\ps).}
