\title{Produit scalaire géométrique 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}

\integer{n1=randint(2..20)}
\integer{n2=randint(2..20)}
\integer{a=randint(0..36)*5}
\integer{choix=randint(1..6)}
\matrix{point=A,A,D,M,R,E
B,D,E,N,S,F
C,E,F,P,T,G}
\real{rep=maxima(\n1*\n2*cos(\a*pi/180))}
\real{rep=round(\rep*100)/100}

\statement{Calculer le produit scalaire \(\overrightarrow{\point[1;\choix] \point[2;\choix]}\cdot\overrightarrow{\point[1;\choix] \point[3;\choix]}) 
avec \(\point[1;\choix] \point[2;\choix]=\n1), \(\point[1;\choix] \point[3;\choix]=\n2) et 
\(\widehat{\point[2;\choix] \point[1;\choix] \point[3;\choix]}=\a^{\circ}) .<br/>
\(\overrightarrow{\point[1;\choix] \point[2;\choix]}\cdot\overrightarrow{\point[1;\choix] \point[3;\choix]})=\embed{r1,5}.
<div class="wims_instruction">On arrondira la réponse au centième. Utiliser le point comme séparateur décimal. </div>}

\answer{Produit scalaire}{\rep}{type=formal}

\solution{\(\overrightarrow{\point[1;\choix] \point[2;\choix]}\cdot\overrightarrow{\point[1;\choix] \point[3;\choix]}=\point[1;\choix] \point[2;\choix]\times \point[1;\choix] \point[3;\choix] \times cos\,\widehat{\point[2;\choix] \point[1;\choix] \point[3;\choix]}
=\n1 \times \n2 \times cos(\a))\if{\a=0 or \a=60 or \a=120 or \a=90 or \a=180}{\({}=\rep)}{\({}\simeq \rep)}.}
