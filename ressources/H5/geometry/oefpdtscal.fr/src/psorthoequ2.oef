\title{Orthogonalité 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\precision{1000}
\integer{sol1=randint(-8..3)}
\integer{sol2=randint(4..10)}
\integer{sol2=(\sol1+\sol2==0)? \sol2+1:\sol2}
\integer{a=randint(1,1,2,2,3)}
\integer{b=-\sol1-\sol2}
\text{x1=(\a=1)? x:\a x}
\text{x2=(\b>0)? x+\b:x\b}
\real{k=randitem(1,2,4,-2,-4,0.5,0.25,-0.5)}
\real{y1=\sol1*\sol2/\k}
\real{y2=\k*\a}
\function{equ=maxima(\a*x^2+(\a*\b)*x+\y1*\y2)}
\text{sol=\sol1,\sol2}
\integer{delta=(\a*\b)^2-4*\a*\y1*\y2}

\statement{<div class="wims_question">Déterminer l'ensemble des valeurs de \(x) pour lesquelles les vecteurs \(\overrightarrow{u} \left ( \begin{array}{c}\x1\\\y1\end{array}\right )) et \(\overrightarrow{v} \left ( \begin{array}{c}\x2\\\y2\end{array}\right )) sont orthogonaux.</div>
L'ensemble des valeurs de \(x) est \embed{r1,6}.
<div class="wims_instruction">Séparer les valeurs par une virgule.</div>} 

\answer{}{\sol}{type=fset}
\solution{\(\overrightarrow{u}) et \(\overrightarrow{v}) sont orthogonaux \(\Leftrightarrow) \(\overrightarrow{u}\cdot\overrightarrow{v}) 
\(\Leftrightarrow) \(\equ=0). \(\Delta=\delta>0), l'équation a donc deux solutions qui sont \(\sol1) et \(\sol2).}
