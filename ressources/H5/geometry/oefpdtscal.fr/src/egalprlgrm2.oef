\title{Egalité du parallélogramme 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\matrix{lettre=A,M,E,M,R
B,A,F,N,S
C,T,G,P,T
D,H,H,R,U
}
\integer{choix=randitem(1,randint(1..5))}
\text{A=\lettre[1;\choix]}
\text{B=\lettre[2;\choix]}
\text{C=\lettre[3;\choix]}
\text{D=\lettre[4;\choix]}
\text{cote2=randitem(\A \D,\B \C)}
\integer{e=randint(3..10)}
\integer{f=randint(2..12)}
\integer{borne=floor(sqrt((\e*\e+\f*\f-1)/2))}
\integer{a=randint(1..\borne)}
\real{b2=(\e*\e+\f*\f-2*\a*\a)/2}
\text{b=sqrt(\b2)}
<!-- pour le corrigé -->
\integer{somme1=\a^2*2}
\integer{somme2=\e^2+\f^2}
\integer{somme3=\somme2-\somme1}
\real{val=\somme3/2}
\integer{valex1=(floor(sqrt(\b2))=sqrt(\b2))? 1:0}
\integer{valex2=sqrt(\b2)}



\statement{<p>\(\A \B \C \D) est un parallélogramme tel que \(\A \B=\a) cm, \(\A \C=\e) cm et \(\B \D=\f) cm. 
Calculer la valeur exacte de \(\cote2).</p>
<p>\(\cote2=)\embed{r1,4} cm.</p>
<div class="wims_instruction">Pour \(\sqrt{...}), écrire : sqrt(...)</div>}
\answer{}{\b}{type=formal}

\solution{D'après l'égalité du parallélogramme dans \(\A \B \C \D), \(\A \B^2+\B \C^2+\C \D^2+\D \A^2=\A \C^2+\B \D^2).<br/>
\(\a^2+\cote2^2+\a^2+\cote2^2=\e^2+\f^2) &hArr; \(2\cote2^2+\somme1=\somme2) &hArr; \(2\cote2^2=\somme3) &hArr; \(\cote2^2=\val) &hArr; 
\(\cote2=\sqrt{\val})\if{\valex1=1}{\({}=\valex2)} cm.}
