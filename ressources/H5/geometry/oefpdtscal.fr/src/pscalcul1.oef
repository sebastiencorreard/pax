\title{Produit scalaire géométrique 1}
\author{Cyrille Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}

\integer{n1=randint(2..20)}
\integer{n2=randint(2..20)}
\integer{a=randint(0..36)*5}
\real{rep=maxima(\n1*\n2*cos(\a*pi/180))}
\real{rep=round(100*\rep)/100}
\text{intrep=\(\overrightarrow{u}.\overrightarrow{v})}

\statement{Calculer le produit scalaire \(\overrightarrow{u}\cdot\overrightarrow{v}) 
avec \(\||\overrightarrow{u}\||=\n1), \(\||\overrightarrow{v}\||=\n2) et une mesure de \((\overrightarrow{u},\overrightarrow{v})) est \(\a^\circ).
<div class="wims_instruction">On arrondira la réponse au centième. Utiliser le point comme séparateur décimal.</div>}

\answer{\intrep}{\rep}{type=formal}
\solution{\(\overrightarrow{u}\cdot\overrightarrow{v}=\||\overrightarrow{u}\||\times \||\overrightarrow{v}\||\times cos\,(\overrightarrow{u},\overrightarrow{v})=
\n1\times\n2\times cos(\a))\if{\a=0 or \a=60 or \a=120 or \a=90 or \a=180}{\({}=\rep)}{\({}\simeq \rep)}}
