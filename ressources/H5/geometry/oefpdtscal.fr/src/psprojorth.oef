\title{Projection orthogonale 1}

\integer{orientation=randitem(1,2)} ##vec(AB) : 1: horizontal, 2 : vertical##
\integer{norme=randint(1..5)}##1+||vec(AB)||##
\text{coordA=(\orientation=1)? 4,5:5,4}
\text{coordB=(\orientation=1)? 4+\norme,5:5,4+\norme}

\integer{x=(\orientation=1)? randint(-3..5):randint(1..4)*randitem(-1,1)}
\integer{y=(\orientation=1)? randint(1..4)*randint(-1,1):randint(-3..5)}
\text{coordC=\coordA[1]+\x,\coordA[2]+\y}

\rational{plctA=(\x>0)? -0.5:0.2}
\rational{plctC=(\x<0 and \y<0)? -0.5:0.2}

\text{dessin=canvasdraw(300,300
xrange 0,10
yrange 0,10
grid 1,1,black
linewidth 4
arrow \coordA[1],\coordA[2],\coordB[1],\coordB[2],8,black
arrow \coordA[1],\coordA[2],\coordC[1],\coordC[2],8,black
linewidth 3
crosshairs black,\coordA[1],\coordA[2],\coordB[1],\coordB[2],\coordC[1],\coordC[2]
text black,\coordA[1]+\plctA,\coordA[2]+0.2,large,A
text black,\coordB[1]+0.2,\coordB[2]+0.2,large,B
text black,\coordC[1]+\plctC,\coordC[2]+\plctC,large,C
)}

\integer{sol=(\orientation=1)? \x*\norme:\y*\norme}

\text{coordH=(\orientation=1)? \coordA[1]+\x,5:5,\coordA[2]+\y}

\text{dessinsol=canvasdraw(300,300
xrange 0,10
yrange 0,10
grid 1,1,black
linewidth 4
arrow \coordA[1],\coordA[2],\coordB[1],\coordB[2],8,black
arrow \coordA[1],\coordA[2],\coordC[1],\coordC[2],8,black
arrow \coordA[1],\coordA[2],\coordH[1],\coordH[2],8,blue
linewidth 3
crosshairs black,\coordA[1],\coordA[2],\coordB[1],\coordB[2],\coordC[1],\coordC[2]
crosshairs blue,\coordH[1],\coordH[2]
text black,\coordA[1]+\plctA,\coordA[2]+0.2,large,A
text black,\coordB[1]+0.2,\coordB[2]+0.2,large,B
text black,\coordC[1]+\plctC,\coordC[2]+\plctC,large,C
text blue,\coordH[1]+\plctA,\coordH[2]+0.2,large,H
dashed
segment \coordC[1],\coordC[2],\coordH[1],\coordH[2],blue
)}

\integer{norme2=(\orientation=1)? abs(\x):abs(\y)}

\statement{Calculer  \(\overrightarrow{A B}\cdot\overrightarrow{A C}) dans la situation suivante (l'unité est le carreau) :<br/>\dessin 

\(\overrightarrow{A B}\cdot\overrightarrow{A C} )=\embed{r1,4}}

\answer {}{\sol}{type=formal}

\solution{\if{\sol=0}{Les droites\((A B)) et \((A C)) étant perpendiculaires,\(\overrightarrow{A B}\cdot\overrightarrow{A C}=0).}{
\dessinsol
<p>En notant \(H) le projeté orthogonal de \(C) sur la droite \((A B)), on a \(\overrightarrow{A B}\cdot\overrightarrow{A C}=\overrightarrow{A B}\cdot\overrightarrow{A H}).</p>
<p>Les vecteurs \(\overrightarrow{A B}) et \(\overrightarrow{A H}) sont colinéaires de \if{\sol<0}{sens contraires donc \(\overrightarrow{A B}\cdot\overrightarrow{A C}=-A B \times A C=-\norme \times \norme2=\sol)}
{même sens donc \(\overrightarrow{A B}\cdot\overrightarrow{A C}=A B \times A H=\norme \times \norme2=\sol)}.
}
}
