\title{Produit scalaire géométrique 3}
\author{Cyrille,Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\integer{orientation=randint(1,2)} ##vec(AB) : 1: horizontal, 2 : vertical##
\integer{norme=randint(2..6)}
\integer{norme2=randint(2..8)}
\integer{signe=randitem(-1,1)}

\text{coordA=randint(1..3),randint(1..3)}

\if{\orientation=1}{
\text{coordB= \coordA[1]+\norme,\coordA[2]}
\integer{xC=(\signe>0)? randint(1..(9-\norme2)):randint((1+\norme2)..9)}
\integer{yC=randint(5..9)}
\integer{xD=(\signe>0)? \norme2+\xC:\xC-\norme2}
\integer{yD=\yC}
}{
\text{coordB=\coordA[1],\coordA[2]+\norme}
\integer{xC=randint(5..9)}
\integer{yC=(\signe>0)? randint(1..(9-\norme2)):randint((1+\norme2)..9)}
\integer{xD=\xC}
\integer{yD=(\signe>0)? \norme2+\yC:\yC-\norme2}
}

\integer{t1x=floor((\coordA[1]+\coordB[1])/2)}
\integer{t1y=floor((\coordA[2]+\coordB[2])/2)}
\integer{t2x=floor((\xC+\xD)/2)}
\integer{t2y=floor((\yC+\yD)/2)}

\text{dessin=canvasdraw(300,300
xrange 0,10
yrange 0,10
grid 1,1,black
linewidth 4
arrow \coordA[1],\coordA[2],\coordB[1],\coordB[2],10,blue
arrow \xC,\yC,\xD,\yD,10,green
linewidth 3
crosshairs blue,\coordA[1],\coordA[2],\coordB[1],\coordB[2]
crosshairs green,\xC,\yC,\xD,\yD
text blue,\t1x+0.2,\t1y+0.2,large,u
arrow \t1x+0.1,\t1y+0.7,\t1x+0.7,\t1y+0.7,8,blue
text green,\t2x+0.2,\t2y+0.2,large,v
arrow \t2x+0.1,\t2y+0.7,\t2x+0.7,\t2y+0.7,8,green
)}

\integer{sol=(\signe>0)? \norme*\norme2:\norme*\norme2*-1}

\statement{Calculer \(\overrightarrow{u}\cdot\overrightarrow{v}) dans la situation suivante (l'unité est le carreau) :<br/>\dessin 

\(\overrightarrow{u}\cdot\overrightarrow{v} )=\embed{r1,4}}

\answer {}{\sol}{type=formal}

\solution{Les vecteurs \(\overrightarrow{u}) et \(\overrightarrow{v}) sont colinéaires de \if{\signe<0}{sens contraires donc \(\overrightarrow{u}\cdot\overrightarrow{v}=-\|| \overrightarrow{u} \||  \times \|| \overrightarrow{v} \|| =-\norme \times \norme2=\sol)}
{même sens donc \(\overrightarrow{u}\cdot\overrightarrow{v}=\|| \overrightarrow{u} \||  \times \|| \overrightarrow{v} \||=\norme \times \norme2=\sol)}.}
