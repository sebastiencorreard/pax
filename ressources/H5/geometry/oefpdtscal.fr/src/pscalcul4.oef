\title{Calcul analytique 2}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}

\integer{xa=randint(2..20)}
\integer{xb=randint(-10..10)}
\integer{ya=randint(-10..10)}
\integer{yb=\ya+randint(2..10)*randint(-1,1)}
\integer{xc=\xa+randint(2..10)*randint(-1,1)}
\integer{yc=randint(-10..-1)}
\integer{ps=(\xb-\xa)*(\xc-\xa)+(\yb-\ya)*(\yc-\ya)}

<!-- pour le corrigé -->
\integer{x1=\xb-\xa}
\integer{y1=\yb-\ya}
\integer{x2=\xc-\xa}
\integer{y2=\yc-\ya}

\text{t2=(\x2<0)? (\x2):\x2}
\text{t3=(\y1<0)? (\y1):\y1}
\text{t4=(\y2<0)? (\y2):\y2}

\statement{<p>Calculer \(\overrightarrow{A B}\cdot\overrightarrow{A C}) avec \(A(\xa; \ya)), \(B(\xb; \yb)) et \(C(\xc; \yc)) dans un repère orthonormé. </p>
\(\overrightarrow{A B}\cdot\overrightarrow{A C})=\embed{r1,4}.}
\answer{}{\ps}{type=formal}
\solution{<p>Les coordonnées de \(\overrightarrow{A B}) sont \(\left ( \begin{array}{c}\x1\\\y1\end{array}\right )) et celles de \(\overrightarrow{A C}) sont 
\(\left ( \begin{array}{c}\x2\\\y2\end{array}\right )).</p>
<p>On en déduit : \(\overrightarrow{A B}\cdot\overrightarrow{A C}=\x1\times\t2+\t3 \times \t4=\ps).</p>}
