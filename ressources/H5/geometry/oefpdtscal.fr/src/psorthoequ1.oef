\title{Orthogonalité 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}
\precision{1000}
\integer{x1=randitem(2,4,5,8,10,-2,-4,-5)}
\integer{y1=randint(1..10)*randitem(1,-1)}
\integer{y2=randint(1..12)*randitem(1,-1)}
\function{equ=maxima(\x1*x+(\y1*\y2))}
\rational{x2=-(\y1*\y2)/\x1}

\statement{<div class="wims_question">Déterminer la valeur de \(x) pour laquelle les vecteurs \(\overrightarrow{u} \left ( \begin{array}{c}\x1\\\y1\end{array}\right )) et \(\overrightarrow{v} \left ( \begin{array}{c}x\\\y2\end{array}\right )) sont orthogonaux.</div>
\(x=)\embed{r1,4}.} 

\answer{}{\x2}{type=numeric}
\solution{\(\overrightarrow{u}) et \(\overrightarrow{v}) sont orthogonaux \(\Leftrightarrow) \(\overrightarrow{u}\cdot\overrightarrow{v}) \(\Leftrightarrow) \(\equ=0) \(\Leftrightarrow) \(x=\x2).}
