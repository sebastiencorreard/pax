\title{Projection orthogonale 2}

\integer{orientation=randitem(1,2)} ##vec(AB) : 1: horizontal, 2 : vertical##
\integer{norme=randint(2..5)}##||vec(AB)||##
\text{coordA=(\orientation=1)? 3,5:5,3}
\text{coordB=(\orientation=1)? 3+\norme,5:5,3+\norme}

\integer{xC=(\orientation=1)? randint(1..9):5+randint(1..4)*randint(-1,1)}
\integer{yC=(\orientation=1)? 5+randint(1..4)*randint(-1,1):randint(1..9)}
\integer{xD=(\orientation=1)? randint(1..9):5+randint(1..4)*randint(-1,1)}
\integer{yD=(\orientation=1)? 5+randint(1..4)*randint(-1,1):randint(1..9)}
\integer{yD=(\xC=\xD and \yC=\yD)? \yD+\randitem(-1,1):\yD}

\text{dessin=canvasdraw(300,300
xrange 0,10
yrange 0,10
grid 1,1,black
linewidth 4
arrow \coordA[1],\coordA[2],\coordB[1],\coordB[2],8,black
arrow \xC,\yC,\xD,\yD,8,black
linewidth 3
crosshairs black,\coordA[1],\coordA[2],\coordB[1],\coordB[2],\xC,\yC,\xD,\yD
text black,\coordA[1]+0.2,\coordA[2]+0.2,large,A
text black,\coordB[1]+0.2,\coordB[2]+0.2,large,B
text black,\xC+0.2,\yC+0.2,large,C
text black,\xD+0.2,\yD+0.2,large,D
)}

\integer{sol=(\orientation=1)? \norme*(\xD-\xC):\norme*(\yD-\yC)}

\text{coordH=(\orientation=1)? \xC,5:5,\yC}
\text{coordK=(\orientation=1)? \xD,5:5,\yD}

\text{dessinsol=canvasdraw(300,300
xrange 0,10
yrange 0,10
grid 1,1,black
linewidth 4
arrow \coordA[1],\coordA[2],\coordB[1],\coordB[2],8,black
arrow \xC,\yC,\xD,\yD,8,black
arrow \coordH[1],\coordH[2],\coordK[1],\coordK[2],8,blue
linewidth 3
crosshairs blue,\coordH[1],\coordH[2],\coordK[1],\coordK[2]
crosshairs black,\coordA[1],\coordA[2],\coordB[1],\coordB[2],\xC,\yC,\xD,\yD
text black,\coordA[1]+0.2,\coordA[2]+0.2,large,A
text black,\coordB[1]+0.2,\coordB[2]+0.2,large,B
text black,\xC+0.2,\yC+0.2,large,C
text black,\xD+0.2,\yD+0.2,large,D
text blue,\coordH[1]-0.5,\coordH[2]+0.2,large,H
text blue,\coordK[1]-0.5,\coordK[2]+0.2,large,K
dashed
segment \xC,\yC,\coordH[1],\coordH[2],blue
dashed
segment \xD,\yD,\coordK[1],\coordK[2],blue
)}

\integer{norme2=(\orientation=1)? abs(\coordH[1]-\coordK[1]):abs(\coordH[2]-\coordK[2])}


\statement{Calculer \(\overrightarrow{A B}\cdot\overrightarrow{C D}) dans la situation suivante (l'unité est le carreau) :<br/>\dessin 

\(\overrightarrow{A B}\cdot\overrightarrow{C D} )=\embed{r1,4}}

\answer {}{\sol}{type=formal}

\solution{\if{\sol=0}{Les droites\((A B)) et \((A C)) étant perpendiculaires,\(\overrightarrow{A B}.\overrightarrow{A C}=0).}
{\if{(\orientation=1 and \yC=\yD) or (\orientation=2 and \xC=\xD)}{Les vecteurs \(\overrightarrow{A B}) et \(\overrightarrow{C D}) sont colinéaires de \if{\sol<0}{sens contraires donc \(\overrightarrow{A B}\cdot\overrightarrow{C D}=-A B \times C D=-\norme \times \norme2=\sol)}
{même sens donc \(\overrightarrow{A B}\cdot\overrightarrow{C D}=A B \times C D=\norme \times \norme2=\sol)}.}
{\dessinsol
<p>En notant \(H) le projeté orthogonal de \(C) et \(K) celui de \(D) sur la droite \((A B)), on a \(\overrightarrow{A B}\cdot\overrightarrow{C D}=\overrightarrow{A B}\cdot\overrightarrow{H K}).</p>
<p>Les vecteurs \(\overrightarrow{A B}) et \(\overrightarrow{H K}) sont colinéaires de \if{\sol<0}{sens contraires donc \(\overrightarrow{A B}\cdot\overrightarrow{C D}=-A B \times  H K=-\norme \times \norme2=\sol)}
{même sens donc \(\overrightarrow{A B}\cdot\overrightarrow{C D}=A B \times H K=\norme \times \norme2=\sol)}.}}}
