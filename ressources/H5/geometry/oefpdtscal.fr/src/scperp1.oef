\title{Droites perpendiculaires ?}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\computeanswer{no}

\real{m1=randitem(0.25,0.5,1,2,4)*randint(-1,1)}
\integer{p1=randint(-8..8)}
\integer{ortho=randint(1,2)}
\real{m2=(\ortho=1)? -1/\m1:randitem(3,5,6,7,8)*randint(-1,1)}
\integer{p2=randint(-8..8)}
\integer{xa=randint(-10..10)}
\integer{xb=\xa+randint(1..7)*randint(-1,1)}
\real{ya=\m1*\xa+\p1}
\real{yb=\m1*\xb+\p1}
\integer{xc=randint(-10..10)}
\integer{xd=\xc+randint(1..7)*randint(-1,1)}
\real{yc=\m2*\xc+\p2}
\real{yd=\m2*\xd+\p2}
##Variables pour le corrigé##
\real{x1=\xb-\xa}
\real{x2=\xd-\xc}
\real{y1=\yb-\ya}
\real{y2=\yd-\yc}
\real{ps=(\x1)*(\x2)+(\y1)*(\y2)}
\text{t2=(\x2>0)? \x2:(\x2)}
\text{t3=(\y1>0)? \y1:(\y1)}
\text{t4=(\y2>0)? \y2:(\y2)}


\statement{<p>On donne dans un repère orthonormé, les points \(A(\xa; \ya)), \(B(\xb; \yb)), \(C(\xc; \yc)) et \(D(\xd; \yd)). </p>
<p> Les droites \((A B)) et \((C D)) sont-elles perpendiculaires ? \embed{r1}</p>}
\answer{}{\ortho;Oui,Non,Je ne sais pas}{type=menu}

\solution{Il suffit de vérifier si le produit scalaire \(\overrightarrow{A B}.\overrightarrow{C D}) est nul. \(\overrightarrow{A B}) a pour coordonnées
\(\left(\begin{array}{c} \x1 \\ \y1 \end{array}\right)) et \(\overrightarrow{C D}) a pour coordonnées \(\left(\begin{array}{c} \x2 \\ \y2 \end{array}\right)). 
\(\overrightarrow{A B}\cdot\overrightarrow{C D }=\x1\times \t2+\t3 \times \t4=\ps)\if{\ortho=1}{ donc les droites \((A B)) et  \((C D))
 sont perpendiculaires.}{\(\neq 0) donc les droites \((A B)) et  \((C D)) ne sont pas perpendiculaires.}  }
