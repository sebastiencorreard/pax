!set title=Egalité du parallélogramme 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim A,M,E,M,R	B,A,F,N,S	C,T,G,P,T	D,H,H,R,U	
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

tmp=!nonempty items 1,$(tmp0)

tmp1=!randitem $tmp
val7=$[rint($(tmp1))]
val8=$(val6[1;$val7])
val9=$(val6[2;$val7])
val10=$(val6[3;$val7])
val11=$(val6[4;$val7])
tmp=!nonempty items $val8 $val11,$val9 $val10

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!randint 3, 10

val13=$[rint($(tmp0))]
tmp0=!randint 2, 12

val14=$[rint($(tmp0))]
val15=$[rint(floor(sqrt(($val13*$val13+$val14*$val14-1)/2)))]
tmp0=!randint 1, $val15

val16=$[rint($(tmp0))]
val17=$[($val13*$val13+$val14*$val14-2*$val16*$val16)/2]
val18=sqrt($val17)
val19=$[rint($val16^2*2)]
val20=$[rint($val13^2+$val14^2)]
val21=$[rint($val20-$val19)]
val22=$[$val21/2]

!ifval (floor(sqrt($val17))=sqrt($val17))
val23=$[rint( 1)]
!else
val23=$[rint(0)]
!endif
val24=$[rint(sqrt($val17))]
replytype1=formal
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>
!insmath $val8 $val9 $val10 $val11
$() est un parallélogramme tel que 
!insmath $val8 $val9=$val16
$() cm, 
!insmath $val8 $val10=$val13
$() cm et 
!insmath $val9 $val11=$val14
$() cm. 	Calculer la valeur exacte de 
!insmath $val12
$().</p>	<p>
!insmath $val12=
$() 
!read oef/embed.phtml r1,4 
$() cm.</p>	<div class="wims_instruction">Pour 
!insmath \sqrt{...}
$(), écrire : sqrt(...)</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()D'après l'égalité du parallélogramme dans 
!insmath $val8 $val9 $val10 $val11
$(), 
!insmath $val8 $val9^2+$val9 $val10^2+$val10 $val11^2+$val11 $val8^2=$val8 $val10^2+$val9 $val11^2
$().<br/>	
!insmath $val16^2+$val12^2+$val16^2+$val12^2=$val13^2+$val14^2
$() &hArr; 
!insmath 2$val12^2+$val19=$val20
$() &hArr; 
!insmath 2$val12^2=$val21
$() &hArr; 
!insmath $val12^2=$val22
$() &hArr; 	
!insmath $val12=\sqrt{$val22}
$()
!if $val23=1 
$()
!insmath {}=$val24
$() 
!endif
$() cm.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11,12,13,14,16,19,20,21,22,23,24
embedcnt=1
