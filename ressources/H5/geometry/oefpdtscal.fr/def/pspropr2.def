!set title=Propriétés du produit scalaire 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille,Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 8, 16

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 4, 10

val7=$[rint($(tmp0))]
tmp0=!randint 0, 5

val8=$[rint(floor(abs($val6)/3)+$(tmp0))]

!ifval ($val7=$val8)
val8=$[rint( max($val7,$val8)+1)]
!endif
tmp0=!randint 2, 7

val9=$[rint($(tmp0))]
val10=\overrightarrow{AB}
val11=\overrightarrow{AC}
tmp=!trim BA,AC	AB,CA	BA,CA	AB,BC	AC,CB	BA,BC	BC,AC	
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!trim (-\overrightarrow{AB}),\overrightarrow{AC}	\overrightarrow{AB},(-\overrightarrow{AC})	(-\overrightarrow{AB}),(-\overrightarrow{AC})	\overrightarrow{AB},\overrightarrow{BA},\overrightarrow{AC},-AB^2+$val10.$val11,-$val7^2+$val6	\overrightarrow{AC},\overrightarrow{CA},\overrightarrow{AB},-AC^2+$val10.$val11,-$val8^2+$val6	\overrightarrow{BA},\overrightarrow{BA},\overrightarrow{AC},BA^2-$val10.$val11,$val7^2-$val6	\overrightarrow{BA},\overrightarrow{AC},\overrightarrow{AC},-$val10.$val11+AC^2,-$val6+$val8^2	
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!nonempty items 1,1,2,2,3

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
val15=\overrightarrow{$(val12[$val14;1])}
val16=\overrightarrow{$(val12[$val14;2])}
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val17=$[rint($(tmp0))]

!ifval ($val17=1)
val18= $val10
!else
val18=$val11
!endif
tmp=!nonempty items 4,4,5,5,6,7

tmp0=!randitem $tmp
val19=$[rint($(tmp0))]

!ifval ($val6>0)
val20= $val6
!else
val20=($val6)
!endif
val21=$[rint($val6)]

!ifval ($val14=3)
val22=$[rint( $val6)]
!else
val22=$[rint(-$val6)]
!endif

!ifval ($val17=1)
val23=$[rint( $val7^2)]
!else
val23=$[rint($val8^2)]
!endif

!ifval ($val17=1)
val24= ($val9 $val10+$val11)
!else
val24=$val10
!endif

!ifval ($val17=1)
val25= $val11
!else
val25=($val10+$val9 $val11)
!endif

!ifval ($val17=1)
val26=$[rint( $val9*$val6+($val8)^2)]
!else
val26=$[rint(($val7)^2+$val9*$val6)]
!endif

!ifval ($val17=1)
val27=$[rint( $val8^2)]
!else
val27=$[rint($val7^2)]
!endif
replytype1=formal
replyname1=
replygood1=$val21
replytype2=formal
replyname2=
replygood2=$val22
replytype3=formal
replyname3=
replygood3=$val23
replytype4=formal
replyname4=
replygood4=$val26
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On donne 
!insmath $val10 . $val11=$val6
$(), 
!insmath AB=$val7
$() et 
!insmath AC=$val8
$().<br>	<div class="wims_question">Que vaut 
!insmath $val11.$val10
$() ?  
!read oef/embed.phtml r1,4 
$()</div>	<div class="wims_question">Que vaut 
!insmath $val15.$val16
$() ?  
!read oef/embed.phtml r2,4 
$()</div>	<div class="wims_question">Que vaut 
!insmath $val18.$val18
$() ?  
!read oef/embed.phtml r3,4 
$()</div>	<div class="wims_question">Que vaut 
!insmath $val24.$val25
$() ?  
!read oef/embed.phtml r4,4 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()<ul><li>
!insmath $val11.$val10=$val10.$val11=$val6
$()</li>	<li>
!insmath $val15.$val16=$(val13[$val14;1]).$(val13[$val14;2])
$()
!if $val14=3 
$()
!insmath =$val10.$val11=$val22
$() 
!else
$() 
!insmath =-($val10.$val11)=$val22
$() 
!endif
$()</li>	<li>
!insmath $val18.$val18=
$()
!if $val17=1 
$()
!insmath AB^2=$val23
$() 
!else
$() 
!insmath AC^2=$val23
$() 
!endif
$()</li>	<li>Par linéarité du produit scalaire, <br>
!insmath $val24.$val25=
$()
!if $val17=1 
$()
!insmath $val9 $val10.$val11+$val11.$val11=$val9 \times $val20+$val27=$val26
$() 
!else
$() 
!insmath $val10.$val10+$val9 $val10.$val11=$val27+$val9 \times $val20=$val26
$() 
!endif
$()</li></ul>	
$()
!exit

:latex
$()
$()
