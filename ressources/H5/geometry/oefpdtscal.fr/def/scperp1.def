!set title=Droites perpendiculaires ?
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 0.25,0.5,1,2,4

tmp0=!randitem $tmp
tmp1=!randitem -1,1

val6=$[$(tmp0)*$(tmp1)]
tmp0=!randint -8, 8

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval ($val8=1)
val9=$[ -1/$val6]
!else
tmp=!nonempty items 3,5,6,7,8

tmp0=!randitem $tmp
tmp1=!randitem -1,1

val9=$[$(tmp0)*$(tmp1)]
!endif
tmp0=!randint -8, 8

val10=$[rint($(tmp0))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint 1, 7

tmp1=!randitem -1,1

val12=$[rint($val11+$(tmp0)*$(tmp1))]
val13=$[$val6*$val11+$val7]
val14=$[$val6*$val12+$val7]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]
tmp0=!randint 1, 7

tmp1=!randitem -1,1

val16=$[rint($val15+$(tmp0)*$(tmp1))]
val17=$[$val9*$val15+$val10]
val18=$[$val9*$val16+$val10]
val19=$[$val12-$val11]
val20=$[$val16-$val15]
val21=$[$val14-$val13]
val22=$[$val18-$val17]
val23=$[($val19)*($val20)+($val21)*($val22)]

!ifval ($val20>0)
val24= $val20
!else
val24=($val20)
!endif

!ifval ($val21>0)
val25= $val21
!else
val25=($val21)
!endif

!ifval ($val22>0)
val26= $val22
!else
val26=($val22)
!endif
replytype1=menu
replyname1=
replygood1=$val8;Oui,Non,Je ne sais pas
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>On donne dans un repère orthonormé, les points 
!insmath A($val11; $val13)
$(), 
!insmath B($val12; $val14)
$(), 
!insmath C($val15; $val17)
$() et 
!insmath D($val16; $val18)
$(). </p>	<p> Les droites 
!insmath (A B)
$() et 
!insmath (C D)
$() sont-elles perpendiculaires ?  
!read oef/embed.phtml r1 
$()</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Il suffit de vérifier si le produit scalaire 
!insmath \overrightarrow{A B}.\overrightarrow{C D}
$() est nul. 
!insmath \overrightarrow{A B}
$() a pour coordonnées	
!insmath \left(\begin{array}{c} $val19 \\ $val21 \end{array}\right)
$() et 
!insmath \overrightarrow{C D}
$() a pour coordonnées 
!insmath \left(\begin{array}{c} $val20 \\ $val22 \end{array}\right)
$(). 	
!insmath \overrightarrow{A B}\cdot\overrightarrow{C D }=$val19\times $val24+$val25 \times $val26=$val23
$()
!if $val8=1 
$() donc les droites 
!insmath (A B)
$() et  
!insmath (C D)
$()	 sont perpendiculaires. 
!else
$() 
!insmath \neq 0
$() donc les droites 
!insmath (A B)
$() et  
!insmath (C D)
$() ne sont pas perpendiculaires. 
!endif
$()  
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

