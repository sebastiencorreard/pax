!set title=Produit scalaire géométrique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randint 0, 36

val8=$[rint($(tmp0)*5)]
t_=!replace internal \( by ( in $val6*$val7*cos($val8*pi/180)
tmp0=!exec maxima $t_

val9=$[$(tmp0)]
val9=$[round(100*$val9)/100]
val10=\(\overrightarrow{u}.\overrightarrow{v})
replytype1=formal
replyname1=$val10
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer le produit scalaire 
!insmath \overrightarrow{u}\cdot\overrightarrow{v}
$() 	avec 
!insmath \||\overrightarrow{u}\||=$val6
$(), 
!insmath \||\overrightarrow{v}\||=$val7
$() et une mesure de 
!insmath (\overrightarrow{u},\overrightarrow{v})
$() est 
!insmath $val8^\circ
$().	<div class="wims_instruction">On arrondira la réponse au centième. Utiliser le point comme séparateur décimal.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \overrightarrow{u}\cdot\overrightarrow{v}=\||\overrightarrow{u}\||\times \||\overrightarrow{v}\||\times cos\,(\overrightarrow{u},\overrightarrow{v})=	$val6\times$val7\times cos($val8)
$()
!if $val8=0 or $val8=60 or $val8=120 or $val8=90 or $val8=180 
$()
!insmath {}=$val9
$() 
!else
$() 
!insmath {}\simeq $val9
$() 
!endif
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=0
