!set title=Produit scalaire géométrique 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randint 0, 36

val8=$[rint($(tmp0)*5)]
tmp0=!randint 1, 6

val9=$[rint($(tmp0))]
tmp=!trim A,A,D,M,R,E	B,D,E,N,S,F	C,E,F,P,T,G
val10=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in $val6*$val7*cos($val8*pi/180)
tmp0=!exec maxima $t_

val11=$[$(tmp0)]
val11=$[round($val11*100)/100]
replytype1=formal
replyname1=Produit scalaire
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer le produit scalaire 
!insmath \overrightarrow{$(val10[1;$val9]) $(val10[2;$val9])}\cdot\overrightarrow{$(val10[1;$val9]) $(val10[3;$val9])}
$() 	avec 
!insmath $(val10[1;$val9]) $(val10[2;$val9])=$val6
$(), 
!insmath $(val10[1;$val9]) $(val10[3;$val9])=$val7
$() et 	
!insmath \widehat{$(val10[2;$val9]) $(val10[1;$val9]) $(val10[3;$val9])}=$val8^{\circ}
$() .<br/>	
!insmath \overrightarrow{$(val10[1;$val9]) $(val10[2;$val9])}\cdot\overrightarrow{$(val10[1;$val9]) $(val10[3;$val9])}
$()= 
!read oef/embed.phtml r1,5 
$().	<div class="wims_instruction">On arrondira la réponse au centième. Utiliser le point comme séparateur décimal. </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \overrightarrow{$(val10[1;$val9]) $(val10[2;$val9])}\cdot\overrightarrow{$(val10[1;$val9]) $(val10[3;$val9])}=$(val10[1;$val9]) $(val10[2;$val9])\times $(val10[1;$val9]) $(val10[3;$val9]) \times cos\,\widehat{$(val10[2;$val9]) $(val10[1;$val9]) $(val10[3;$val9])}	=$val6 \times $val7 \times cos($val8)
$()
!if $val8=0 or $val8=60 or $val8=120 or $val8=90 or $val8=180 
$()
!insmath {}=$val11
$() 
!else
$() 
!insmath {}\simeq $val11
$() 
!endif
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=1
