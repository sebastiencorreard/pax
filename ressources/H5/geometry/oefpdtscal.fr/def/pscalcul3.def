!set title=Calcul analytique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no
precision=1000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val9=$[rint($val7+$(tmp0)*$(tmp1))]
val10=$[rint($val6*$val7+$val8*$val9)]

!ifval ($val7<0)
val11= ($val7)
!else
val11=$val7
!endif

!ifval ($val8<0)
val12= ($val8)
!else
val12=$val8
!endif

!ifval ($val9<0)
val13= ($val9)
!else
val13=$val9
!endif
replytype1=formal
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Calculer 
!insmath \overrightarrow{u}\cdot\overrightarrow{v}
$() avec	 
!insmath \overrightarrow{u} \left ( \begin{array}{c}$val6\\$val8\end{array}\right )
$() et  
!insmath \overrightarrow{v} \left ( \begin{array}{c}$val7\\$val9\end{array}\right )
$() dans un repère orthonormé.</p>	
!insmath \overrightarrow{u}\cdot\overrightarrow{v}
$()= 
!read oef/embed.phtml r1,4 
$(). 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \overrightarrow{u}\cdot\overrightarrow{v}=$val6\times$val11+$val12\times$val13=$val10
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13
embedcnt=1
