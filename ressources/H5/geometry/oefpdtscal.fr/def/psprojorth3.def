tmp0=!randint 4, 7

val6=$[rint(2*$(tmp0))]
tmp0=!randint 1, 3

val7=$[rint($val6-2*$(tmp0))]
!readproc oef/canvasdraw.phtml 320,216 \
xrange -1,9	yrange -1,7	linewidth 2	segment 0,0,8,0,black	segment 0,0,0,6,black	segment 8,0,8,6,black	segment 0,6,8,6,black	segment 0,0,8,6,black	segment 0,6,8,0,black	segment -0.2,3,0.2,3,black	segment 7.8,3,8.2,3,black	segment 4,5.8,4,6.2,black	segment 4,-0.2,4,0.2,black	text black,-0.4,-0.4,large,D	text black,8,-0.4,large,C	text black,-0.4,6,large,A	text black,8,6,large,B	text black,3.8,-0.7,large,K	text black,-0.6,2.8,large,L	text black,4,6.3,large,I	text black,8.3,2.8,large,J	text black,3.7,3.2,large,O	 
tmp0=$canvasdraw_out
val8=$(tmp0)
val9=<p>\(ABCD) est un rectangle, \({I}) est le milieu de \([AB]\), \({J}\) est le milieu de \([BC]\), \(K\) est le milieu de \([CD]\), \(L\) est le milieu de \([AD]\) et \(O\) est le milieu	de \([AC]\). </p>$val8
tmp=!trim AB,AC,$val6^2,AB	AB,AK,$val6^2/2,AI	AB,AO,$val6^2/2,AI	AB,DB,$val6^2,AB	AB,OB,$val6^2/2,IB	AI,AC,$val6^2/2,AB	AI,AO,$val6^2/4,AI	AI,DI,$val6^2/4,AI	IB,ID,-$val6^2/4,IA	IA,IC,-$val6^2/4,IB 
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val11=$[rint($(tmp1))]
tmp=!trim AD,AJ,$val7^2/2,AL	AD,AO,$val7^2/2,AL	AD,AK,$val7^2,AD	BC,BD,$val7^2,BC	BC,BL,$val7^2/2,BJ	CB,BD,-$val7^2,BC	AL,AC,$val7^2/2,AD	AL,AO,$val7^2/4,AL	LD,DB,-$val7^2/2,DA	LA,LC,-$val7^2/4,LD	JB,JD,-$val7^2/4,JC	JC,JA,-$val7^2/4,JB	LD,LI,-$val7^2/4,LA	JB,JK,-$val7^2/4,JC	AD,DO,-$val7^2/2,DL	BC,CL,-$val7^2/2,CJ 
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val12

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val13=$[rint($(tmp1))]
tmp=!trim AB,DO,$val6^2/2,AI	CD,LI,-$val6^2/2,DK	AD,JK,$val7^2/2,LD	BC,AO,$val7^2/2,BJ	AB,DJ,$val6^2,AB	AD,CI,-$val7^2,DA	CD,AJ,-$val6^2,DC	CB,KA,$val7^2,CB	AB,KJ,$val6^2/2,IB	AB,JK,-$val6^2/2,BI	AD,OB,-$val7^2/2,LA	AD,IJ,$val7^2/2,AL	AD,OC,$val7^2/2,LD	AI,KJ,$val6^2/4,IB	AI,OD,-$val6^2/4,IA	AI,OC,$val6^2/4,IB	BJ,LK,$val7^2/4,JC	AL,CO,-$val7^2/4,DL	AL,BO,$val7^2/4,AL
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val14

tmp0=!rowcnt $tmp
