:question
$()$val9. <p>On pose 
!insmath AB=$val6\, cm
$() et 
!insmath AD=$val7\, cm
$().</p>	Calculer les produits scalaires suivants :	<ul><li>
!insmath \overrightarrow{$(val10[$val11;1])}.\overrightarrow{$(val10[$val11;2])}
$()= 
!read oef/embed.phtml r1,4 
$()</li>	<li>
!insmath \overrightarrow{$(val12[$val13;1])}.\overrightarrow{$(val12[$val13;2])}
$()= 
!read oef/embed.phtml r2,4 
$()</li>	<li>
!insmath \overrightarrow{$(val14[$val15;1])}.\overrightarrow{$(val14[$val15;2])}
$()= 
!read oef/embed.phtml r3,4 
$()</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()En utilisant la projection orthogonale, <ul><li>
!insmath \overrightarrow{$(val10[$val11;1])}.\overrightarrow{$(val10[$val11;2])}=\overrightarrow{$(val10[$val11;1])}.\overrightarrow{$(val10[$val11;4])}={}
$()	
!if $(val10[$val11;3])>0 
$()
!insmath $(val10[$val11;1]) \times $(val10[$val11;4])=$val16
$() 
!if $(val10[$val11;1]) notsametext $(val10[$val11;4]) 
$()(
!insmath \overrightarrow{$(val10[$val11;1])}
$() et 
!insmath \overrightarrow{$(val10[$val11;4])}
$() sont colinéaires de même sens) 
!endif
$() 
!else
$() 
!insmath -$(val10[$val11;1]) \times $(val10[$val11;4])=$val16
$() (
!insmath \overrightarrow{$(val10[$val11;1])}
$() et 
!insmath \overrightarrow{$(val10[$val11;4])}
$() sont colinéaires de sens opposés) 
!endif
$()</li>	<li>
!insmath \overrightarrow{$(val12[$val13;1])}.\overrightarrow{$(val12[$val13;2])}=\overrightarrow{$(val12[$val13;1])}.\overrightarrow{$(val12[$val13;4])}={}
$()	
!if $(val12[$val13;3])>0 
$()
!insmath $(val12[$val13;1]) \times $(val12[$val13;4])=$val17
$() 
!if $(val12[$val13;1]) notsametext $(val12[$val13;4]) 
$()(
!insmath \overrightarrow{$(val12[$val13;1])}
$() et 
!insmath \overrightarrow{$(val12[$val13;4])}
$() sont colinéaires de même sens) 
!endif
$() 
!else
$() 
!insmath -$(val12[$val13;1]) \times $(val12[$val13;4])=$val17
$() (
!insmath \overrightarrow{$(val12[$val13;1])}
$() et 
!insmath \overrightarrow{$(val12[$val13;4])}
$() sont colinéaires de sens opposés) 
!endif
$()</li>	<li>
!insmath \overrightarrow{$(val14[$val15;1])}.\overrightarrow{$(val14[$val15;2])}=\overrightarrow{$(val14[$val15;1])}.\overrightarrow{$(val14[$val15;4])}={}
$()	
!if $(val14[$val15;3])>0 
$()
!insmath $(val14[$val15;1]) \times $(val14[$val15;4])=$val18
$() 
!if $(val14[$val15;1]) notsametext $(val14[$val15;4]) 
$()(
!insmath \overrightarrow{$(val14[$val15;1])}
$() et 
!insmath \overrightarrow{$(val12[$val13;4])}
$() sont colinéaires de même sens) 
!endif
$() 
!else
$() 
!insmath -$(val14[$val15;1]) \times $(val14[$val15;4])=$val18
$() (
!insmath \overrightarrow{$(val14[$val15;1])}
$() et 
!insmath \overrightarrow{$(val14[$val15;4])}
$() sont colinéaires de sens opposés) 
!endif
$()</li>	</ul>
$()
!exit

