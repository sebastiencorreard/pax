!set title=Orthogonalité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no
precision=1000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 2,4,5,8,10,-2,-4,-5

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 12

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*x+($val7*$val8)
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
t_=!rawmath -($val7*$val8)/$val6
val10=!exec pari print($t_)
replytype1=numeric
replyname1=
replygood1=$[$val10]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Déterminer la valeur de 
!insmath x
$() pour laquelle les vecteurs 
!insmath \overrightarrow{u} \left ( \begin{array}{c}$val6\\$val7\end{array}\right )
$() et 
!insmath \overrightarrow{v} \left ( \begin{array}{c}x\\$val8\end{array}\right )
$() sont orthogonaux.</div>	
!insmath x=
$() 
!read oef/embed.phtml r1,4 
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \overrightarrow{u}
$() et 
!insmath \overrightarrow{v}
$() sont orthogonaux 
!insmath \Leftrightarrow
$() 
!insmath \overrightarrow{u}\cdot\overrightarrow{v}
$() 
!insmath \Leftrightarrow
$() 
!insmath $val9=0
$() 
!insmath \Leftrightarrow
$() 
!insmath x=$val10
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=1
