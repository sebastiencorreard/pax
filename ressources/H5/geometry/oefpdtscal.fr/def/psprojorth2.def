!if $val15=0 
$()Les droites
!insmath (A B)
$() et 
!insmath (A C)
$() étant perpendiculaires,
!insmath \overrightarrow{A B}.\overrightarrow{A C}=0
$(). 
!else
$()	 
!if ($val6=1 and $val11=$val13) or ($val6=2 and $val10=$val12) 
$()Les vecteurs 
!insmath \overrightarrow{A B}
$() et 
!insmath \overrightarrow{C D}
$() sont colinéaires de 
!if $val15<0 
