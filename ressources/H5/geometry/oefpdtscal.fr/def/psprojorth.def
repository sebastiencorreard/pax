$()
!if $val16=0 
$()Les droites
!insmath (A B)
$() et 
!insmath (A C)
$() étant perpendiculaires,
!insmath \overrightarrow{A B}\cdot\overrightarrow{A C}=0
$(). 
!else
$() 	$val18	<p>En notant 
!insmath H
$() le projeté orthogonal de 
!insmath C
$() sur la droite 
!insmath (A B)
$(), on a 
!insmath \overrightarrow{A B}\cdot\overrightarrow{A C}=\overrightarrow{A B}\cdot\overrightarrow{A H}
$().</p>	<p>Les vecteurs 
!insmath \overrightarrow{A B}
$() et 
!insmath \overrightarrow{A H}
$() sont colinéaires de 
!if $val16<0 
$()sens contraires donc 
!insmath \overrightarrow{A B}\cdot\overrightarrow{A C}=-A B \times A C=-$val7 \times $val19=$val16
$() 
!else
$()	 même sens donc 
!insmath \overrightarrow{A B}\cdot\overrightarrow{A C}=A B \times A H=$val7 \times $val19=$val16
$() 
!endif
$().	 
!endif
$()	
