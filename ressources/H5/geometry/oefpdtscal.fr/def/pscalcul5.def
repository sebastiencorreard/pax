postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!randint 2, 6

val7=$[rint($(tmp0))]
tmp0=!randint 2, 8

val8=$[rint($(tmp0))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randint 1, 3

val10=$(tmp0),$(tmp1)
!if $val6=1 
val11=$(val10[1])+$val7,$(val10[2])

!ifval ($val9>0)
tmp0=!randint 1, (9-$val8)

val12=$[rint( $(tmp0))]
!else
tmp1=!randint (1+$val8), 9

val12=$[rint($(tmp1))]
!endif
tmp0=!randint 5, 9

val13=$[rint($(tmp0))]

!ifval ($val9>0)
val14=$[rint( $val8+$val12)]
!else
val14=$[rint($val12-$val8)]
!endif
val15=$[rint($val13)]
!else
val11=$(val10[1]),$(val10[2])+$val7
tmp0=!randint 5, 9

val12=$[rint($(tmp0))]

!ifval ($val9>0)
tmp0=!randint 1, (9-$val8)

val13=$[rint( $(tmp0))]
!else
tmp1=!randint (1+$val8), 9

val13=$[rint($(tmp1))]
!endif
val14=$[rint($val12)]

!ifval ($val9>0)
val15=$[rint( $val8+$val13)]
!else
val15=$[rint($val13-$val8)]
!endif
!endif
val16=$[rint(floor(($(val10[1])+$(val11[1]))/2))]
val17=$[rint(floor(($(val10[2])+$(val11[2]))/2))]
val18=$[rint(floor(($val12+$val14)/2))]
val19=$[rint(floor(($val13+$val15)/2))]
!readproc oef/canvasdraw.phtml 300,300 \
xrange 0,10	yrange 0,10	grid 1,1,black	linewidth 4	arrow $(val10[1]),$(val10[2]),$(val11[1]),$(val11[2]),10,blue	arrow $val12,$val13,$val14,$val15,10,green	linewidth 3	crosshairs blue,$(val10[1]),$(val10[2]),$(val11[1]),$(val11[2])	crosshairs green,$val12,$val13,$val14,$val15	text blue,$val16+0.2,$val17+0.2,large,u	arrow $val16+0.1,$val17+0.7,$val16+0.7,$val17+0.7,8,blue	text green,$val18+0.2,$val19+0.2,large,v	arrow $val18+0.1,$val19+0.7,$val18+0.7,$val19+0.7,8,green	 
tmp0=$canvasdraw_out
val20=$(tmp0)

!ifval ($val9>0)
val21=$[rint( $val7*$val8)]
!else
val21=$[rint($val7*$val8*-1)]
!endif
replytype1=formal
replyname1=
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

