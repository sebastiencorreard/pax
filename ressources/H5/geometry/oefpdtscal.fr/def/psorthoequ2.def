!set title=Orthogonalité 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
computeanswer=no
precision=1000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -8, 3

val6=$[rint($(tmp0))]
tmp0=!randint 4, 10

val7=$[rint($(tmp0))]

!ifval ($val6+$val7==0)
val7=$[rint( $val7+1)]
!else
val7=$[rint($val7)]
!endif
tmp0=!randitem 1,1,2,2,3

val8=$[rint($(tmp0))]
val9=$[rint(-$val6-$val7)]

!ifval ($val8=1)
val10= x
!else
val10=$val8 x
!endif

!ifval ($val9>0)
val11= x+$val9
!else
val11=x$val9
!endif
tmp=!nonempty items 1,2,4,-2,-4,0.5,0.25,-0.5

tmp0=!randitem $tmp
val12=$[$(tmp0)]
val13=$[$val6*$val7/$val12]
val14=$[$val12*$val8]
t_=!replace internal \( by ( in $val8*x^2+($val8*$val9)*x+$val13*$val14
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
val16=$val6,$val7
val17=$[rint(($val8*$val9)^2-4*$val8*$val13*$val14)]
replytype1=fset
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Déterminer l'ensemble des valeurs de 
!insmath x
$() pour lesquelles les vecteurs 
!insmath \overrightarrow{u} \left ( \begin{array}{c}$val10\\$val13\end{array}\right )
$() et 
!insmath \overrightarrow{v} \left ( \begin{array}{c}$val11\\$val14\end{array}\right )
$() sont orthogonaux.</div>	L'ensemble des valeurs de 
!insmath x
$() est  
!read oef/embed.phtml r1,6 
$().	<div class="wims_instruction">Séparer les valeurs par une virgule.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \overrightarrow{u}
$() et 
!insmath \overrightarrow{v}
$() sont orthogonaux 
!insmath \Leftrightarrow
$() 
!insmath \overrightarrow{u}\cdot\overrightarrow{v}
$() 	
!insmath \Leftrightarrow
$() 
!insmath $val15=0
$(). 
!insmath \Delta=$val17>0
$(), l'équation a donc deux solutions qui sont 
!insmath $val6
$() et 
!insmath $val7
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11,13,14,15,17
embedcnt=1
