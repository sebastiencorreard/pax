!set title=Egalité du parallélogramme 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim A,M,E,M,R	B,A,F,N,S	C,T,G,P,T	D,H,H,R,U	
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

tmp=!nonempty items 1,$(tmp0)

tmp1=!randitem $tmp
val7=$[rint($(tmp1))]
val8=$(val6[1;$val7])
val9=$(val6[2;$val7])
val10=$(val6[3;$val7])
val11=$(val6[4;$val7])
tmp=!nonempty items $val8 $val11,$val9 $val10

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!randint 4, 10

val13=$[rint($(tmp0))]
tmp0=!randint 5, 12

val14=$[rint($(tmp0))]
tmp0=!randint 1, ($val13+$val14-1)

val15=$[rint($(tmp0))]
val16=$[rint(2*$val13^2+2*$val14^2-$val15^2)]
val17=sqrt($val16)
val18=$[rint($val13^2*2+2*$val14^2)]
val19=$[rint($val15^2)]

!ifval (floor(sqrt($val16))=sqrt($val16))
val20=$[rint( 1)]
!else
val20=$[rint(0)]
!endif
val21=$[rint(sqrt($val16))]
replytype1=formal
replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>
!insmath $val8 $val9 $val10 $val11
$() est un parallélogramme tel que 
!insmath $val8 $val9=$val13
$() cm, 
!insmath $val12=$val14
$() cm et 
!insmath $val8 $val10=$val15
$() cm. 	Calculer la valeur exacte de 
!insmath $val9 $val11
$().</p>	
!insmath $val9 $val11=
$() 
!read oef/embed.phtml r1,4 
$() cm.	<div class="wims_instruction">Pour 
!insmath \sqrt{...}
$(), écrire : sqrt(...)</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()D'après l'égalité du parallélogramme dans 
!insmath $val8 $val9 $val10 $val11
$(), 
!insmath $val8 $val9^2+$val9 $val10^2+$val10 $val11^2+$val11 $val8^2=$val8 $val10^2+$val9 $val11^2
$().<br/>	
!insmath $val13^2+$val14^2+$val13^2+$val14^2=$val9 $val11^2+$val15^2
$() &hArr; 
!insmath $val18=$val9 $val11^2+$val19
$() &hArr; 
!insmath $val9 $val11^2=$val18-$val19=$val16
$() &hArr; 
!insmath $val9 $val11=\sqrt{$val16}
$()	
!if $val20=1 
$()
!insmath {}=$val21
$() 
!endif
$() cm.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11,12,13,14,15,16,18,19,20,21
embedcnt=1
