\title{Somme de deux vecteurs dans l'espace}
\language{fr}
\range{-5..5}
\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Calcul des coordonnées d'un vecteur somme de deux autres vecteurs.}

\integer{x1=randint(-15..15)}
\integer{x2=randint(-15..15)}
\integer{y1=randint(-15..15)}
\integer{y2=randint(-15..15)}
\integer{z1=randint(-15..15)}
\integer{z2=randint(-15..15)}

\integer{x3=\x2+\x1}
\integer{y3=\y2+\y1}
\integer{z3=\z2+\z1}

\statement{Dans l'espace muni d'un repère, on considère les vecteurs \(\vec{u})
et \(\vec{v})	de coordonnées respectives
\( \left( \x1, \y1, \z1\right) \) et \( \left( \x2 , \y2, \z2 \right) \).
<br/>
Les coordonnées du vecteur somme \( \overrightarrow{u+v} \) sont
( \embed{reply1,5}, \embed{reply2,5}, \embed{reply3,5}).
}
\hint{Pour obtenir l'abscisse du vecteur \( \overrightarrow{u+v} \), on calcule \(x_u +x_v). <br/>
Il faut ensuite faire de même pour les autres coordonnées. }
\answer{x}{\x3}{type=numexp}
\answer{y}{\y3}{type=numexp}
\answer{z}{\z3}{type=numexp}
