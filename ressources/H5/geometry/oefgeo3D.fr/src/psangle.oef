\title{Calcul d'angles dans l'espace}

\author{Solène, Charneau}
\email{solene.charneau@gmail.com}
\format{html}
\precision{1000}
\computeanswer{yes}
\description{Calcul d'un angle entre trois points dans l'espace, grâce au produit scalaire.}

\matrix{V=slib(matrix/invertible 3,3)}
///// coordonnées de A: matrice m
\matrix{a=slib(matrix/random 1,3,5)}
///// coordonnées de B: A+u
\matrix{u=\V[1;]}
\matrix{b=pari(print([\a]+[\u]))}
///// coordonnées de C: A+v
\matrix{v=\V[2;]}
\matrix{c=pari(print([\a]+[\v]))}
\integer{prec=randint(0..3)}
\if{\prec=0}{\text{precision=au}}{\text{precision=à \(10^{-\prec}\)}}
\integer{p=\u[1]*\v[1]+\u[2]*\v[2]+\u[3]*\v[3]}
\text{sign=\p<0? -:}
\text{nu=simplify(sqrt((\u[1])^2+(\u[2])^2+(\u[3])^2))}
\text{nv=simplify(sqrt((\v[1])^2+(\v[2])^2+(\v[3])^2))}
\text{cagl0=simplify(\p/(\nu*\nv))}

\rational{nunv=((\u[1])^2+(\u[2])^2+(\u[3])^2)*((\v[1])^2+(\v[2])^2+(\v[3])^2)}
\rational{cagl=simplify((\p)^2 /(\nunv))}

\text{tmp2=pari(core(denominator(\cagl),1))}
\text{tmp1=pari(core(numerator(\cagl),1))}
\text{cagl=\sign\tmp1[2]/\tmp2[2]*sqrt(\tmp1[1]/\tmp2[1])}
\text{cagl=simplify(\cagl)}
\text{texcagl=texmath(\cagl)}
\real{agl=rint(acos(\cagl)*180/pi*10^(\prec))*10^(-\prec)}
\integer{i=randint(1..3)}
\matrix{qu=A,B,C
B,A,B
C,C,A}
\text{A=\qu[1;\i]}
\text{B=\qu[2;\i]}
\text{C=\qu[3;\i]}

\text{ETAPE = r1 , r2, r3 , r4, r5, r6
r7
r8
r9,r10
r11
r12}

\text{angles= \(\widehat{BAC}\), \(\widehat{ABC}\), \(\widehat{ACB}\) }

\steps{\ETAPE}
\statement{
Soient trois points dans l'espace repéré :
<div class="wimscenter">
\if{\i=1}{
 \(\A(\a[1],\a[2], \a[3])), \(\B(\b[1],\b[2], \b[3])), \(\C(\c[1],\c[2], \c[3])).
}{\if{\i=2}{
\(\B(\b[1],\b[2], \b[3])), \(\A(\a[1],\a[2], \a[3])), \(\C(\c[1],\c[2], \c[3])).
}{
\(\C(\c[1],\c[2], \c[3])), \(\B(\b[1],\b[2], \b[3])), \(\A(\a[1],\a[2], \a[3])).
}}
</div>
<ol>
\if{\step = 1 }{<li> Calculer les coordonnées des vecteurs
\(\overrightarrow{\A \B} \) et \(\overrightarrow{\A \C}\) :

<div class="wimscenter">\(\overrightarrow{\A \B}\) (\embed{r1,2}, \embed{r2,2}, \embed{r3,2})
et \(\overrightarrow{\A \C} \) (\embed{r4,2}, \embed{r5,2}, \embed{r6,2}) </div></li>}
\if{\step >1}{
\if{\sc_reply1=0 or \sc_reply2=0 or \sc_reply3=0 or \sc_reply4=0 or \sc_reply5=0 or \sc_reply6=0}{
<li> Attention, les coordonnées des vecteurs \(\overrightarrow{\A \B} \) et \(\overrightarrow{\A \C}\) sont :
\(\overrightarrow{\A \B} \left(\u[1],\u[2],\u[3]\right)\) et \(\overrightarrow{\A \C} \left(\v[1],\v[2],\v[3]\right) \). </li>}{
<li> Les coordonnées des vecteurs \(\overrightarrow{\A \B} \) et \(\overrightarrow{\A \C}\) sont bien:
\(\overrightarrow{\A \B} \left(\u[1],\u[2],\u[3]\right)\) et \(\overrightarrow{\A \C} \left(\v[1],\v[2],\v[3]\right) \). </li>}}

\if{\step = 2 }{ <li>Calculer \(\overrightarrow{\A \B}\cdot\overrightarrow{\A \C}):
  <div class="wimscenter"> \(\overrightarrow{\A \B}\cdot\overrightarrow{\A \C}= \)
  \embed{r7,5} </div></li>}
\if{\step > 2 and \sc_reply7=1}{ <li>En effet,
  \(\overrightarrow{\A \B}\cdot\overrightarrow{\A \C}=\p\). </li>}
\if{\step > 2 and \sc_reply7=0}{ <li>Attention,
  \(\overrightarrow{\A \B}\cdot\overrightarrow{\A \C}=\p\). </li>}
\if{\step = 3 }{<li>Quel angle peut-on calculer avec ce produit scalaire ?
  <div class="wimscenter">\embed{r8} </div></li>
}
\if{\step > 3}{<li>Avec ce produit scalaire, nous allons calculer l'angle :
  \angles[\i].</li> }
\if{\step = 4 }{<li>Calculer les normes des vecteurs \(\overrightarrow{\A \B} \)
  et \(\overrightarrow{\A \C}\) :
  <div class="wimscenter"> \(\A \B = \) \embed{r9,5} et \(\A \C = \) \embed{r10,5}. </div>
</li>
}
\if{\step > 4}{
  \if{ \sc_reply9=0 or \sc_reply10=0}{
    <li>Attention, \(\A \B = \nu \) et \(\A \C = \nv \). </li>}
    {<li> En effet, \(\A \B = \nu \) et \(\A \C = \nv \). </li>}
}
\if{\step = 5}{
  <li>Déduire des questions précédentes la valeur du cosinus
  de l'angle \( \widehat{ \B \A \C}\) :
  <div class="wimscenter"> \( cos \left(\widehat{ \B \A \C}\right) = \) \embed{r11}. </div>
  </li>
}
\if{\step > 5 and \sc_reply11=1}{
  <li>En effet, \( cos \left(\widehat{ \B \A \C}\right) = \texcagl \).</li> }
\if{\step > 5 and \sc_reply11=0}{
  <li>Attention, \( cos \left(\widehat{ \B \A \C}\right) = \texcagl \).</li> }
\if{\step = 6}{
  <li>Enfin, trouver la valeur de l'angle arrondie \precision degré
  près de \( \widehat{ \B \A \C}\) :
  <div class="wimscenter"> \( \widehat{ \B \A \C}\) = \embed{r12} </div></li>
}
\if{\step > 6 and \sc_reply12=1}{
  <li>La valeur de l'angle arrondie au degré près de \( \widehat{ \B \A \C}\) est bien:
  <div class="wimscenter"> \( \widehat{ \B \A \C} = \agl \). </div></li> }
\if{\step > 6 and \sc_reply10=0}{
  <li>Non, la valeur de l'angle arrondie au degré près de \( \widehat{ \B \A \C}\) est :
<div class="wimscenter"> \( \widehat{ \B \A \C} = \agl \). </div></li> }
</ol>}

\answer{x}{\u[1]}{type=numeric}{option=nonstop}
\answer{y}{\u[2]}{type=numeric}{option=nonstop}
\answer{z}{\u[3]}{type=numeric}{option=nonstop}
\answer{x'}{\v[1]}{type=numeric}{option=nonstop}
\answer{y'}{\v[2]}{type=numeric}{option=nonstop}
\answer{z'}{\v[3]}{type=numeric}{option=nonstop}
\answer{produit scalaire}{\p}{type=numeric}{option=nonstop}
\answer{angle}{\i ; \angles}{ type=radio}{option=nonstop}
\answer{norme 1 }{\nu}{type=formal}{option=nonstop}
\answer{norme 2 }{\nv}{type=formal}{option=nonstop}
\answer{cos de l'angle}{\cagl}{type=numeric}{option=nonstop}
\answer{angle}{\agl}{type=numeric}
