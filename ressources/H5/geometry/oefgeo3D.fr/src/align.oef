\title{Alignement de trois points dans l'espace}
\language{fr}
\range{-5..5}
\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Etude de l'alignement de trois points. }

\integer{xA=randitem(-1,1)*randint(1..8)}
\integer{yA=randitem(-1,1)*randint(1..8)}
\integer{zA=randitem(-1,1)*randint(1..8)}
\integer{xB=randitem(-1,1)*randint(0..abs(\xA)-1)}
\integer{yB=randitem(-1,1)*randint(0..abs(\yA)-1)}
\integer{zB=randitem(-1,1)*randint(0..abs(\zA)-1)}
\integer{x1=\xB-\xA}
\integer{y1=\yB-\yA}
\integer{z1=\zB-\zA}
\rational{k=randint(1..10)/randint(1..5)}
\rational{xC=\x1 * \k +\xA}
\integer{de=randint(1,2)}
\rational{yC=\de==1?\y1 * \k +\yA:randitem(-1,1)*randint(0..8)}
\rational{zC=\de==1?\z1 * \k +\zA:randitem(-1,1)*randint(0..8)}
\rational{x2=\xC-\xA}
\rational{y2=\yC-\yA}
\rational{z2=\zC-\zA}
\rational{\rep8=\y2 / \y1}
\rational{\rep9=\z2 / \z1}

\steps{reply1,reply2,reply3,reply4,reply5,reply6
reply7, reply8, reply9
reply10}

\statement{
Dans l'espace muni d'un repère, on considère les trois points suivants :
<div class="wimscenter">
\(A \left( \xA ;\yA ; \zA \right) ) ;
\(B \left( \xB ; \yB ; \zB \right)) ; \(C \left( \xC ; \yC; \zC \right)).
</div>
<p><b>On se propose de déterminer si ces trois points sont
alignés ou non.</b>
</p><p>
Dans ce but, on examine si le vecteur \(\overrightarrow{AC})
est colinéaire au vecteur \(\overrightarrow{AB}).
</p>

\if{\step=1}
{
<ol>
<li>Les coordonnées des vecteur \(\overrightarrow{AB}) et \(\overrightarrow{AC}) sont :
<ul><li>
\(\overrightarrow{AB}) (\embed{reply1, 10} ; \embed{reply2, 10} ; \embed{reply3, 10} )
</li><li>
\(\overrightarrow{AC}) (\embed {reply4, 10} ; \embed{reply5, 10} ; \embed{reply6, 10} )
</li>
</ul>
</ol>
}
\if{\step=2}{
<ol>
<li><p>
\if{\sc_reply1=1 and \sc_reply2=1 and \sc_reply3=1 and \sc_reply4=1 and \sc_reply5=1 and \sc_reply6=1}
{<span class="oef_indgood">Bonne réponse !</span>}
{<span class="oef_indbad">Mauvaise réponse...</span>}
</p><p>
Les coordonnées des vecteur \(\overrightarrow{AB}) et \(\overrightarrow{AC}) sont : <br />
\(\overrightarrow{AB} \left(\x1 ; \y1 ; \z1 \right) )
<br />
\(\overrightarrow{AC} \left(\x2 ; \y2 ; \z2 \right) ).
</p></li>
<li>Compléter les égalités suivantes :
<div class="wimscenter">
\(\x2 = \x1 \times \) \embed{reply7, 10} <br />
\(\y2 = \y1 \times \) \embed{reply8, 10} <br />
\(\z2 = \z1 \times \) \embed{reply9, 10} <br />
 </div>
</li>
</ol>
}
\if{\step=3}{
<ol>
<li>
Les coordonnées des vecteur \(\overrightarrow{AB}) et \(\overrightarrow{AC}) sont : <br />
\( \overrightarrow{AB} \left(\x1 ; \y1 ; \z1 \right) )
<br/>
\(\overrightarrow{AC} \left(\x2 ; \y2 ; \z2 \right) ).
</li>
<li>
\if{\sc_reply7=1 and \sc_reply8=1 and \sc_reply9=1}
{<span class="oef_indgood">Bonne réponse !</span>}
{<span class="oef_indbad">Mauvaise réponse...</span>}
<ul>
<li>\(\x2 = \x1 \times \k )</li>
<li>\(\y2 = \y1 \times \rep8 )</li>
<li>\(\z2 = \z1 \times \rep9 )</li>
</ul>
<div>On conclut que les points \(A), \(B) et \(C)
\embed{reply10}.
 </div>
</li>
</ol>
}}

\answer{xAB}{\x1}{type=default}{option=nonstop}
\answer{yAB}{\y1}{type=default}{option=nonstop}
\answer{zAB}{\z1}{type=default}{option=nonstop}
\answer{xAC}{\x2}{type=default}{option=nonstop}
\answer{yAC}{\y2}{type=default}{option=nonstop}
\answer{zAC}{\z2}{type=default}{option=nonstop}

\answer{}{\k}{type=default}{option=nonstop}
\answer{}{\rep8}{type=default}{option=nonstop}
\answer{}{\rep9}{type=default}{option=nonstop}

\answer{C}{\rep4;sont alignés,ne sont pas alignés}{type=menu}{option=shuffle}{option=nonstop}
