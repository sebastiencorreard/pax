\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\format{html}
\precision{1000}
\computeanswer{yes}

\title{Recherche d'une coordonnée manquante (2)}
\description{Trouver la coordonnnée manquante d'un vecteur colinéaire à un autre}
\integer{ux=randint(-10..10)}
\integer{uy=randint(-10..10)}
\integer{uz=randint(-10..10)}
\rational{k=randint(-5..5)/randint(1..6)}
\rational{vx=\ux*\k}
\rational{vy=\uy*\k}
\rational{vz=\uz*\k}
\text{a=randomitem(x,y,z)}

\text{x=\ux}
\text{y=\uy}
\text{z=\uz}
\if{\a=x}{
  \text{x = x}
  \integer{rep = \ux}}
  {
    \if{\a=y}{
      \text{y = y}
      \integer{rep = \uy}
    }{
    \text{z = z}
    \integer{rep = \uz}
    }
  }

\statement{<p>
  L'espace est muni d'un repère orthonormal \((O,\vec{i},\vec{j},\vec{k})).</p><p>
  On considère les vecteurs \(\vec{u}\left(\begin{array}{c} \x \\ \y \\ \z \end{array}\right))
  et \(\vec{v}\left(\begin{array}{c} \vx \\ \vy \\ \vz \end{array}\right))
  où \(\a\) est un nombre réel tel que \( \vec{u}) et \( \vec{v}) soient colinéaires.</p><p>
  Déterminer \(\a\).</p>

<div class="wimscenter"> \(\a\) = \embed{reply1,5} </div>
}
\answer{}{\rep}{type=numeric}
