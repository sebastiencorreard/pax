\title{Distance AB dans l'espace}
\language{fr}
\range{-5..5}
\author{Bruno, Mifsud} de Solène, Charneau
\email{communaute.mutuwims@laposte.net}
\keywords{distance,analytic_geometry,coordinates}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Calcul de la distance AB à partir des coordonnées de A et de B.}

\integer{x1=randint(-9..9)}
\integer{x2=randint(-9..9)}
\integer{y1=randint(-9..9)}
\integer{y2=randint(-9..9)}
\integer{z1=randint(-9..9)}
\integer{z2=randint(-9..9)}

\integer{x3=\x2-\x1}
\integer{y3=\y2-\y1}
\integer{z3=\z2-\z1}
\integer{n=(\x3)^2+(\y3)^2+(\z3)^2}
\text{sol=simplify(sqrt(\n))}
%% feedback
\text{x1txt=\x1<0?(\x1):\x1}
\text{y1txt=\y1<0?(\y1):\y1}
\text{z1txt=\x1<0?(\z1):\z1}
\text{x3txt=\x3<0?(\x3):\x3}
\text{y3txt=\y3<0?(\y3):\y3}
\text{z3txt=\x3<0?(\z3):\z3}
%%%%
\statement{
Dans l'espace muni d'un repère orthonormé, on considère les points \(A\) et \(B\)
    de coordonnées respectives : \(\left( \x1,\y1,\z1\right)\) et \(\left( \x2,\y2,\z2\right)\).
<div class="wims_question">
  <label for="reply1">La distance  \( A B \) vaut</label> \embed{reply1,10}.
</div>
<div class="wims_instruction">
  Si besoin, saisi <b>sqrt(5)</b> si la réponse est \(\sqrt{5}\).</div>
}
\hint{La formule pour le calcul de la distance est :
<div class="wimscenter">
\(A B =\sqrt{(x_B-x_A)^2+(y_B-y_A)^2+(z_B-z_A)^2})
</div>}
\answer{}{\sol}{type=formal}{option=noanalyzeprint}
\real{test=pari(imag(\reply1))}
\feedback{\reply1<0}{Attention, une longueur ne peut pas être négative.}
\feedback{\test!=0}{Attention, on ne peut pas mettre de nombres négatifs sous une racine !!!}
\feedback{\sc_reply1<1}{<div class="feedback">La formule pour le calcul de la distance est :
<p>
\(A B =\sqrt{(x_B-x_A)^2+(y_B-y_A)^2+(z_B-z_A)^2}\)
<br>\({}=\sqrt{(\x2-\x1txt)^2+(\y2-\y1txt)^2+(\z2-\z1txt)^2}\)
<br>\({}=\sqrt{\x3txt^2+\y3txt^2+\z3txt^2}=\sqrt{\n}\)
</p></div>}
