\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\format{html}
\precision{1000}
\computeanswer{yes}

\title{Recherche d'une coordonnée manquante (1)}
\description{Trouver la coordonnnée manquante d'un vecteur dont la norme est donnée}
\integer{ux=randint(-10..10)}
\integer{uy=randint(-10..10)}
\integer{uz=randint(-10..10)}
\integer{p=\ux*\ux+\uy*\uy+\uz*\uz}
\text{a=randomitem(x,y,z)}

\text{vx=\ux}
\text{vy=\uy}
\text{vz=\uz}
\if{\a=x}{\text{vx = x} and \integer{rep = abs(\ux)}}{\if{\a=y}{\text{vy = y} and \integer{rep = abs(\uy)} }{\text{vz = z} and \integer{rep = abs(\uz)}}}

\statement{<p>
  L'espace est muni d'un repère orthonormal \((O,\vec{i},\vec{j},\vec{k})).
  </p><p>
  On considère le vecteur \(\vec{u}\left(\begin{array}{c} \vx \\ \vy \\ \vz \end{array}\right))
  où \(\a\) est un nombre réel positif ou nul tel que \( || \vec{u}|| = \sqrt{\p}).
  </p><p>
  Déterminer \(\a\).</p>

<div class="wimscenter"> \(\a\) = \embed{reply1,5} </div>
}
\answer{}{\rep}{type=numeric}
