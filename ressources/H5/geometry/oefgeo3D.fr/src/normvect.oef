\title{Norme d'un vecteur dans l'espace}
\language{fr}
\range{-5..5}
\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Calcul de la norme d'un vecteur à partir des coordonnées de ses extrémités.}

\integer{x1=randint(-15..15)}
\integer{x2=randint(-15..15)}
\integer{y1=randint(-15..15)}
\integer{y2=randint(-15..15)}
\integer{z1=randint(-15..15)}
\integer{z2=randint(-15..15)}

\integer{x3=\x2-\x1}
\integer{y3=\y2-\y1}
\integer{z3=\z2-\z1}
\integer{n=(\x3)^2+(\y3)^2+(\z3)^2}
\text{sol=simplify(sqrt(\n))}

\statement{Dans l'espace muni d'un repère, on considère les points \(A\) et \(B\)
  de coordonnées respectives \( \left( \x1, \y1, \z1\right) \) et \( \left( \x2, \y2, \z2 \right) \).
<div>
  La norme du vecteur \( \overrightarrow{A B} \) vaut \embed{reply1,5}.
</div>
<div class="wims_instruction">
  Pour entrer la racine carrée de \(x\), écrire
<span class="tt">sqrt(x)</span>.</div>
}
\hint{La formule pour le calcul de la norme d'un vecteur est :
<div class="wimscenter">
\(A B =\sqrt{(x_B-x_A)^2+(y_B-y_A)^2+(z_B-z_A)^2})
</div>}
\answer{}{\sol}{type=formal}
\real{test=pari(imag(\reply1))}
\solution{La norme du vecteur \( \overrightarrow{A B} \) vaut \(\n\).}
\feedback{\reply1<0}{Attention, une longueur ne peut pas être négative.}
\feedback{\test!=0}{Attention, on ne peut pas mettre de nombres négatifs sous une racine !!!}
