\title{Coordonnée du milieu de [AB] dans l'espace}
\language{fr}
\range{-5..5}
\author{Bruno, Mifsud} de Solène, Charneau
\email{communaute.mutuwims@laposte.net}
\keywords{coordinates,midpoint,analytic_geometry}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Calcul des coordonnées du milieu de [AB] à partir des coordonnées de A et de B.}

\integer{x1=randint(-15..15)}
\integer{x2=randint(-15..15)}
\integer{y1=randint(-15..15)}
\integer{y2=randint(-15..15)}
\integer{z1=randint(-15..15)}
\integer{z2=randint(-15..15)}

\integer{x3=\x2+\x1}
\integer{y3=\y2+\y1}
\integer{z3=\z2+\z1}
\real{xm=(\x1+\x2)/2}
\real{ym=(\y1+\y2)/2}
\real{zm=(\z1+\z2)/2}
%%% feedbback
\text{x2txt=\x2<0?(\x2):\x2}
\text{y2txt=\y2<0?(\y2):\y2}
\text{z2txt=\z2<0?(\z2):\z2}



\statement{Dans l'espace muni d'un repère, on considère les points \(A\) et \(B\)
  de coordonnées respectives : \(\left( \x1;\y1;\z1 \right)\) et \(\left( \x2;\y2;\z2 \right) \).
<div class="wims_question">
  Les coordonnées du point \(M\) milieu du segment \([AB]\) sont :
   \special{mathmlinput [\left( {reply1};{reply2};{reply3} \right) ],10,noanswer
 reply 1
 reply 2
 reply 3
 }
</div>
}
\hint{La formule pour les cordonnées de M le milieu de [AB]
<div class="wimscenter">
\(M \left(\frac{x_A+x_B}{2};\frac{y_A+y_B}{2};\frac{z_A+z_B}{2}\right)\)
</div>}
\answer{abscisse}{\xm}{type=numeric}{option=noanalyzeprint}
\answer{ordonnée}{\ym}{type=numeric}{option=noanalyzeprint}
\answer{côte}{\zm}{type=numeric}{option=noanalyzeprint}

\feedback{\sc_reply1<1 or \sc_reply2<1 or \sc_reply3<1}{<div class="feedback">La formule pour le calcul des coordonnées de M le milieu de [AB] est :
<p>
\(M \left(\frac{x_A+x_B}{2};\frac{y_A+y_B}{2};\frac{z_A+z_B}{2}\right)\)
<br>\({}=\left(\frac{\x1+\x2txt}{2};\frac{\y1+\y2txt}{2};\frac{\z1+\z2txt}{2}\right)\)
<br>\({}=\left(\xm;\ym;\zm\right)\)
</p></div>}
