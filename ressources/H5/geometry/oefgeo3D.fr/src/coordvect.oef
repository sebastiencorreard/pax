\title{Coordonnées d'un vecteur dans l'espace}
\language{fr}
\range{-5..5}
\author{Solène, Charneau}
\email{solene.charneau@ac-creteil.fr}
\computeanswer{yes}
\format{html}
\precision{10000}
\description{Calcul des coordonnées d'un vecteur à partir des coordonnées de ses extrémités.}

\integer{x1=randint(-15..15)}
\integer{x2=randint(-15..15)}
\integer{y1=randint(-15..15)}
\integer{y2=randint(-15..15)}
\integer{z1=randint(-15..15)}
\integer{z2=randint(-15..15)}

\integer{x3=\x2-\x1}
\integer{y3=\y2-\y1}
\integer{z3=\z2-\z1}

\statement{Dans l'espace muni d'un repère, on considère les points \(A\) et \(B\)	de
coordonnées respectives \( \left( \x1, \y1, \z1\right) \) et \( \left( \x2 , \y2, \z2 \right) \).
<div>
Les coordonnées du vecteur \( \overrightarrow{AB} \) sont
(\embed{reply1,5}, \embed{reply2,5}, \embed{reply3,5}).
</div>
}
\hint{Pour obtenir l'abscisse du vecteur \( \overrightarrow{A B} \),
on calcule \(x_B -x_A\).
Il faut ensuite faire de même pour les autres coordonnées. }
\answer{x}{\x3}{type=integer}
\answer{y}{\y3}{type=integer}
\answer{z}{\z3}{type=integer}

\solution{Le vecteur \(\overrightarrow{AB}\) a pour coordonnées \(\left( \x3, \y3, \z3 \right)).}
\feedback{\reply1=-\x3 or \reply2=-\y3 or \reply3=-\z3}{
  Attention, n'oubliez pas que pour calculer les coordonnées d'un vecteur, on soustrait
  les coordonnées de son origine aux coordonnées de son extrémité.}
