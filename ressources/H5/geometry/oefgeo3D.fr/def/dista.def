!set title=Distance AB dans l'espace
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=distance,analytic_geometry,coordinates
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
oefdescription=Calcul de la distance AB à partir des coordonnées de A et de B.

ansorder=r
varcnt=19
prevarcnt=17
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -9, 9

val6=$[rint($(tmp0))]
tmp0=!randint -9, 9

val7=$[rint($(tmp0))]
tmp0=!randint -9, 9

val8=$[rint($(tmp0))]
tmp0=!randint -9, 9

val9=$[rint($(tmp0))]
tmp0=!randint -9, 9

val10=$[rint($(tmp0))]
tmp0=!randint -9, 9

val11=$[rint($(tmp0))]
val12=$[rint($val7-$val6)]
val13=$[rint($val9-$val8)]
val14=$[rint($val11-$val10)]
val15=$[rint(($val12)^2+($val13)^2+($val14)^2)]
tmp=!translate ";': to $     $ in sqrt($val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$(tmp0)

!ifval $val6<0
val17=($val6)
!else
val17=$val6
!endif

!ifval $val8<0
val18=($val8)
!else
val18=$val8
!endif

!ifval $val6<0
val19=($val10)
!else
val19=$val10
!endif

!ifval $val12<0
val20=($val12)
!else
val20=$val12
!endif

!ifval $val13<0
val21=($val13)
!else
val21=$val13
!endif

!ifval $val12<0
val22=($val14)
!else
val22=$val14
!endif
replytype1=formal
replyoption1=noanalyzeprint 
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans l'espace muni d'un repère orthonormé, on considère les points 
!insmath A
$() et 
!insmath B
$()	    de coordonnées respectives : 
!insmath \left( $val6,$val8,$val10\right)
$() et 
!insmath \left( $val7,$val9,$val11\right)
$().	<div class="wims_question">	  <label for="reply1">La distance  
!insmath  A B 
$() vaut</label>  
!read oef/embed.phtml reply1,10 
$().	</div>	<div class="wims_instruction">	  Si besoin, saisi <b>sqrt(5)</b> si la réponse est 
!insmath \sqrt{5}
$().</div>	
$()
!exit

:hint
$()La formule pour le calcul de la distance est :	<div class="wimscenter">	
!insmath A B =\sqrt{(x_B-x_A)^2+(y_B-y_A)^2+(z_B-z_A)^2}
$()	</div>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
t_=!replace internal \( by ( in imag($m_reply1)
tmp0=!exec pari $t_

val23=$[$(tmp0)]

!exit

:feedback
!ifval $m_reply1<0
 <div class='oef_feedbacks'>Attention, une longueur ne peut pas être négative.
$()</div>
!endif
!ifval $val23!=0
 <div class='oef_feedbacks'>Attention, on ne peut pas mettre de nombres négatifs sous une racine !!!
$()</div>
!endif
!ifval $m_sc_reply1<1
 <div class='oef_feedbacks'><div class="feedback">La formule pour le calcul de la distance est :	<p>	
!insmath A B =\sqrt{(x_B-x_A)^2+(y_B-y_A)^2+(z_B-z_A)^2}
$()	<br>
!insmath {}=\sqrt{($val7-$val17)^2+($val9-$val18)^2+($val11-$val19)^2}
$()	<br>
!insmath {}=\sqrt{$val20^2+$val21^2+$val22^2}=\sqrt{$val15}
$()	</p></div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,15,17,18,19,20,21,22
embedcnt=1
