!set title=Alignement de trois points dans l'espace
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Solène, Charneau
email=solene.charneau@ac-creteil.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
oefdescription=Etude de l'alignement de trois points. 

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 1, 8

val6=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 1, 8

val7=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 1, 8

val8=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 0, abs($val6)-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 0, abs($val7)-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 0, abs($val8)-1

val11=$[rint($(tmp0)*$(tmp1))]
val12=$[rint($val9-$val6)]
val13=$[rint($val10-$val7)]
val14=$[rint($val11-$val8)]
tmp0=!randint 1, 10

tmp1=!randint 1, 5

t_=!rawmath $(tmp0)/$(tmp1)
val15=!exec pari print($t_)
t_=!rawmath $val12 * $val15 +$val6
val16=!exec pari print($t_)
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]

!ifval $val17==1
t_=!rawmath $val13 * $val15 +$val7
val18=!exec pari print($t_)
!else
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 0, 8

t_=!rawmath $(tmp0)*$(tmp1)
val18=!exec pari print($t_)
!endif

!ifval $val17==1
t_=!rawmath $val14 * $val15 +$val8
val19=!exec pari print($t_)
!else
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 0, 8

t_=!rawmath $(tmp0)*$(tmp1)
val19=!exec pari print($t_)
!endif
t_=!rawmath $val16-$val6
val20=!exec pari print($t_)
t_=!rawmath $val18-$val7
val21=!exec pari print($t_)
t_=!rawmath $val19-$val8
val22=!exec pari print($t_)
t_=!rawmath $val21 / $val13
val23=!exec pari print($t_)
t_=!rawmath $val22 / $val14
val24=!exec pari print($t_)
oefsteps=reply1,reply2,reply3,reply4,reply5,reply6	reply7, reply8, reply9	reply10 
nextstep=!nosubst reply1,reply2,reply3,reply4,reply5,reply6	reply7, reply8, reply9	reply10 
!readproc oef/steps.proc
replytype1=default
replyoption1=nonstop 
replyname1=xAB
replygood1=$val12
replytype2=default
replyoption2=nonstop 
replyname2=yAB
replygood2=$val13
replytype3=default
replyoption3=nonstop 
replyname3=zAB
replygood3=$val14
replytype4=default
replyoption4=nonstop 
replyname4=xAC
replygood4=$val20
replytype5=default
replyoption5=nonstop 
replyname5=yAC
replygood5=$val21
replytype6=default
replyoption6=nonstop 
replyname6=zAC
replygood6=$val22
replytype7=default
replyoption7=nonstop 
replyname7=
replygood7=$val15
replytype8=default
replyoption8=nonstop 
replyname8=
replygood8=$val23
replytype9=default
replyoption9=nonstop 
replyname9=
replygood9=$val24
replytype10=menu
replyoption10=shuffle 
replyoption10=nonstop 
replyname10=C
replygood10=?analyze 25;sont alignés,ne sont pas alignés
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans l'espace muni d'un repère, on considère les trois points suivants :	<div class="wimscenter">	
!insmath A \left( $val6 ;$val7 ; $val8 \right) 
$() ;	
!insmath B \left( $val9 ; $val10 ; $val11 \right)
$() ; 
!insmath C \left( $val16 ; $val18; $val19 \right)
$().	</div>	<p><b>On se propose de déterminer si ces trois points sont	alignés ou non.</b>	</p><p>	Dans ce but, on examine si le vecteur 
!insmath \overrightarrow{AC}
$()	est colinéaire au vecteur 
!insmath \overrightarrow{AB}
$().	</p>		
!if $m_step=1 
$()	<ol>	<li>Les coordonnées des vecteur 
!insmath \overrightarrow{AB}
$() et 
!insmath \overrightarrow{AC}
$() sont :	<ul><li>	
!insmath \overrightarrow{AB}
$() ( 
!read oef/embed.phtml reply1, 10 
$() ;  
!read oef/embed.phtml reply2, 10 
$() ;  
!read oef/embed.phtml reply3, 10 
$() )	</li><li>	
!insmath \overrightarrow{AC}
$() ( 
!read oef/embed.phtml reply4, 10 
$() ;  
!read oef/embed.phtml reply5, 10 
$() ;  
!read oef/embed.phtml reply6, 10 
$() )	</li>	</ul>	</ol>	 
!endif
$()	
!if $m_step=2 
$()	<ol>	<li><p>	
!if $m_sc_reply1=1 and $m_sc_reply2=1 and $m_sc_reply3=1 and $m_sc_reply4=1 and $m_sc_reply5=1 and $m_sc_reply6=1 
$()<span class="oef_indgood">Bonne réponse !</span> 
!else
$()	 <span class="oef_indbad">Mauvaise réponse...</span> 
!endif
$()	</p><p>	Les coordonnées des vecteur 
!insmath \overrightarrow{AB}
$() et 
!insmath \overrightarrow{AC}
$() sont : <br />	
!insmath \overrightarrow{AB} \left($val12 ; $val13 ; $val14 \right) 
$()	<br />	
!insmath \overrightarrow{AC} \left($val20 ; $val21 ; $val22 \right) 
$().	</p></li>	<li>Compléter les égalités suivantes :	<div class="wimscenter">	
!insmath $val20 = $val12 \times 
$()  
!read oef/embed.phtml reply7, 10 
$() <br />	
!insmath $val21 = $val13 \times 
$()  
!read oef/embed.phtml reply8, 10 
$() <br />	
!insmath $val22 = $val14 \times 
$()  
!read oef/embed.phtml reply9, 10 
$() <br />	 </div>	</li>	</ol>	 
!endif
$()	
!if $m_step=3 
$()	<ol>	<li>	Les coordonnées des vecteur 
!insmath \overrightarrow{AB}
$() et 
!insmath \overrightarrow{AC}
$() sont : <br />	
!insmath  \overrightarrow{AB} \left($val12 ; $val13 ; $val14 \right) 
$()	<br/>	
!insmath \overrightarrow{AC} \left($val20 ; $val21 ; $val22 \right) 
$().	</li>	<li>	
!if $m_sc_reply7=1 and $m_sc_reply8=1 and $m_sc_reply9=1 
$()<span class="oef_indgood">Bonne réponse !</span> 
!else
$()	 <span class="oef_indbad">Mauvaise réponse...</span> 
!endif
$()	<ul>	<li>
!insmath $val20 = $val12 \times $val15 
$()</li>	<li>
!insmath $val21 = $val13 \times $val23 
$()</li>	<li>
!insmath $val22 = $val14 \times $val24 
$()</li>	</ul>	<div>On conclut que les points 
!insmath A
$(), 
!insmath B
$() et 
!insmath C
$()	 
!read oef/embed.phtml reply10 
$().	 </div>	</li>	</ol>	 
!endif
$()
$()
!exit

