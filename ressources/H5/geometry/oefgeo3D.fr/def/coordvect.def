!set title=Coordonnées d'un vecteur dans l'espace
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Solène, Charneau
email=solene.charneau@ac-creteil.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
oefdescription=Calcul des coordonnées d'un vecteur à partir des coordonnées de ses extrémités.

ansorder=r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint -15, 15

val9=$[rint($(tmp0))]
tmp0=!randint -15, 15

val10=$[rint($(tmp0))]
tmp0=!randint -15, 15

val11=$[rint($(tmp0))]
val12=$[rint($val7-$val6)]
val13=$[rint($val9-$val8)]
val14=$[rint($val11-$val10)]
replytype1=integer

replyname1=x
replygood1=$val12
replytype2=integer

replyname2=y
replygood2=$val13
replytype3=integer

replyname3=z
replygood3=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans l'espace muni d'un repère, on considère les points 
!insmath A
$() et 
!insmath B
$() de	coordonnées respectives 
!insmath  \left( $val6, $val8, $val10\right) 
$() et 
!insmath  \left( $val7 , $val9, $val11 \right) 
$().	<div>	Les coordonnées du vecteur 
!insmath  \overrightarrow{AB} 
$() sont	( 
!read oef/embed.phtml reply1,5 
$(),  
!read oef/embed.phtml reply2,5 
$(),  
!read oef/embed.phtml reply3,5 
$()).	</div>	
$()
!exit

:hint
$()Pour obtenir l'abscisse du vecteur 
!insmath  \overrightarrow{A B} 
$(),	on calcule 
!insmath x_B -x_A
$().	Il faut ensuite faire de même pour les autres coordonnées. 
$()
!exit

:help
$()
$()
!exit

:solution
$()Le vecteur 
!insmath \overrightarrow{AB}
$() a pour coordonnées 
!insmath \left( $val12, $val13, $val14 \right)
$().
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply1=-$val12 or $m_reply2=-$val13 or $m_reply3=-$val14
 <div class='oef_feedbacks'>	  Attention, n'oubliez pas que pour calculer les coordonnées d'un vecteur, on soustrait	  les coordonnées de son origine aux coordonnées de son extrémité.
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,14
embedcnt=3
