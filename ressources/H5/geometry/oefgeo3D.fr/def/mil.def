!set title=Coordonnée du milieu de [AB] dans l'espace
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=communaute.mutuwims@laposte.net
keywords=coordinates,midpoint,analytic_geometry
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
oefdescription=Calcul des coordonnées du milieu de [AB] à partir des coordonnées de A et de B.

ansorder=r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint -15, 15

val9=$[rint($(tmp0))]
tmp0=!randint -15, 15

val10=$[rint($(tmp0))]
tmp0=!randint -15, 15

val11=$[rint($(tmp0))]
val12=$[rint($val7+$val6)]
val13=$[rint($val9+$val8)]
val14=$[rint($val11+$val10)]
val15=$[($val6+$val7)/2]
val16=$[($val8+$val9)/2]
val17=$[($val10+$val11)/2]

!ifval $val7<0
val18=($val7)
!else
val18=$val7
!endif

!ifval $val9<0
val19=($val9)
!else
val19=$val9
!endif

!ifval $val11<0
val20=($val11)
!else
val20=$val11
!endif
replytype1=numeric
replyoption1=noanalyzeprint 
replyname1=abscisse
replygood1=$[$val15]
replytype2=numeric
replyoption2=noanalyzeprint 
replyname2=ordonnée
replygood2=$[$val16]
replytype3=numeric
replyoption3=noanalyzeprint 
replyname3=côte
replygood3=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans l'espace muni d'un repère, on considère les points 
!insmath A
$() et 
!insmath B
$()	  de coordonnées respectives : 
!insmath \left( $val6;$val8;$val10 \right)
$() et 
!insmath \left( $val7;$val9;$val11 \right) 
$().	<div class="wims_question">	  Les coordonnées du point 
!insmath M
$() milieu du segment 
!insmath [AB]
$() sont :	    
!read oef/special.phtml mathmlinput [\left( {reply1};{reply2};{reply3} \right) ],10,noanswer	 reply 1	 reply 2	 reply 3	  
$()	</div>	
$()
!exit

:hint
$()La formule pour les cordonnées de M le milieu de [AB]	<div class="wimscenter">	
!insmath M \left(\frac{x_A+x_B}{2};\frac{y_A+y_B}{2};\frac{z_A+z_B}{2}\right)
$()	</div>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1<1 or $m_sc_reply2<1 or $m_sc_reply3<1
 <div class='oef_feedbacks'><div class="feedback">La formule pour le calcul des coordonnées de M le milieu de [AB] est :	<p>	
!insmath M \left(\frac{x_A+x_B}{2};\frac{y_A+y_B}{2};\frac{z_A+z_B}{2}\right)
$()	<br>
!insmath {}=\left(\frac{$val6+$val18}{2};\frac{$val8+$val19}{2};\frac{$val10+$val20}{2}\right)
$()	<br>
!insmath {}=\left($val15;$val16;$val17\right)
$()	</p></div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,15,16,17,18,19,20
embedcnt=1
