!set title=Recherche d'une coordonnée manquante (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Solène, Charneau
email=solene.charneau@ac-creteil.fr
precision=1000
computeanswer=yes
oefdescription=Trouver la coordonnnée manquante d'un vecteur dont la norme est donnée

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
val9=$[rint($val6*$val6+$val7*$val7+$val8*$val8)]
tmp=!nonempty items x,y,z

tmp0=!randitem $tmp
val10=$(tmp0)
val11=$val6
val12=$val7
val13=$val8
!if $val10=x 
val11=x
val14=$[rint(abs($val6))]
!else
!if $val10=y 
val12=y
val14=$[rint(abs($val7))]
!else
val13=z
val14=$[rint(abs($val8))]
!endif
!endif
replytype1=numeric
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  L'espace est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j},\vec{k})
$().	  </p><p>	  On considère le vecteur 
!insmath \vec{u}\left(\begin{array}{c} $val11 \\ $val12 \\ $val13 \end{array}\right)
$()	  où 
!insmath $val10
$() est un nombre réel positif ou nul tel que 
!insmath  || \vec{u}|| = \sqrt{$val9}
$().	  </p><p>	  Déterminer 
!insmath $val10
$().</p>		<div class="wimscenter"> 
!insmath $val10
$() =  
!read oef/embed.phtml reply1,5 
$() </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,12,13
embedcnt=1
