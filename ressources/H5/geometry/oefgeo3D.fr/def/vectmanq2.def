!set title=Recherche d'une coordonnée manquante (2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Solène, Charneau
email=solene.charneau@ac-creteil.fr
precision=1000
computeanswer=yes
oefdescription=Trouver la coordonnnée manquante d'un vecteur colinéaire à un autre

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

tmp1=!randint 1, 6

t_=!rawmath $(tmp0)/$(tmp1)
val9=!exec pari print($t_)
t_=!rawmath $val6*$val9
val10=!exec pari print($t_)
t_=!rawmath $val7*$val9
val11=!exec pari print($t_)
t_=!rawmath $val8*$val9
val12=!exec pari print($t_)
tmp=!nonempty items x,y,z

tmp0=!randitem $tmp
val13=$(tmp0)
val14=$val6
val15=$val7
val16=$val8
!if $val13=x 
val14=x
val17=$[rint($val6)]
!else
!if $val13=y 
val15=y
val17=$[rint($val7)]
!else
val16=z
val17=$[rint($val8)]
!endif
!endif
replytype1=numeric
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  L'espace est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j},\vec{k})
$().</p><p>	  On considère les vecteurs 
!insmath \vec{u}\left(\begin{array}{c} $val14 \\ $val15 \\ $val16 \end{array}\right)
$()	  et 
!insmath \vec{v}\left(\begin{array}{c} $val10 \\ $val11 \\ $val12 \end{array}\right)
$()	  où 
!insmath $val13
$() est un nombre réel tel que 
!insmath  \vec{u}
$() et 
!insmath  \vec{v}
$() soient colinéaires.</p><p>	  Déterminer 
!insmath $val13
$().</p>		<div class="wimscenter"> 
!insmath $val13
$() =  
!read oef/embed.phtml reply1,5 
$() </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14,15,16
embedcnt=1
