tmp0=!randint -10, 9

val14=$[rint($(tmp0)*2+1)]
val15=$[rint(-($val12))]
val16=$[rint($val11)]
tmp0=!randint -20, 20

val17=$[rint($(tmp0))]
tmp0=!randint -20, 20

