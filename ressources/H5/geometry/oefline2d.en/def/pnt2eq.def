!set title=2 points
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=100
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
!endif
!if $val6=fr 
!endif
val7=In the plane we consider the line passing through the points	  with coordinates
val8=A vector equation of this line is
val9=and
val10=The equation must be of the form
val11=Equation of the line
!if $val6=fr 
val7=Dans le plan muni d'un repère, on considère la droite	  passant par les points de coordonnées
val8=Une équation cartésienne de cette droite est
val9=et
val10=L'équation doit être de la forme
val11=Équation de la droite
!endif
!if $val6=nl 
val7=In the plane we consider the line passing through the points	  with coordinates
val8=A vector equation of this line is
val9=and
val10=The equation must be of the form
val11=Equation of the line
!endif
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -20, 20

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val15=$[rint($(tmp0)*2+1)]
val16=$[rint($val15-($val14))]
val17=$[rint($val12-($val13))]
val18=$[rint(($val12)*($val15)-($val13)*($val14))]
val19=!rawmath $val16*x + $val17*y = $val18
replytype1=equation
replyname1=$val11
replygood1=!rawmath $val19,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	
!insmath ($val12, $val14)
$() $val9 
!insmath ($val13, $val15)
$().	<label for="reply1">$val8</label>  
!read oef/embed.phtml reply1,15 
$().	<div class="wims_instruction">	$val10 
!insmath a x + b y = c
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,12,13,14,15
embedcnt=1
