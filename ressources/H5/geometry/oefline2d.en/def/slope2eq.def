!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
!endif
!if $val6=fr 
!endif
val7=The equation must be of the form
val8=Equation of the line
val9=Find an equation of the line in the plane containing the point
val10=and with slope equal to
val11=Equation of the line
!if $val6=fr 
val7=L'équation doit être de la forme
val8=Équation de la droite
