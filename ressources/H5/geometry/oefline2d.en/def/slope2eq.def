val10=dont le coefficient directeur est égal à
val11=Une équation de cette droite est
!endif
!if $val6=nl 
val7=The equation must be of the form
val8=Equation of the line
val9=Find an equation of the line in the plane containing the point
val10=and with slope equal to
val11=Equation of the line
!endif
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -20, 20

val13=$[rint($(tmp0))]
tmp0=!randitem 2,4,5,8,10,16

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem $val14-7,$val14-6,$val14-3,$val14-1,$val14+1,$val14+3,$val14+6,$val14+7

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
val16=$[-($val15)/($val14)]
val17=$[rint(($val15)*($val12) + ($val14)*($val13))]
val18=!rawmath $val15*x + $val14*y = $val17
replytype1=equation
replyname1=$val8
replygood1=!rawmath $val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

