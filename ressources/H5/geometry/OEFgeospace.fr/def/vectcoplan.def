val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2 = 
val2= 2 
!else
val2= $val2
!endif

!ifval $val2!=1 
val6= wims_question
!else
val6=wimscenter special1
!endif

!ifval $val2!=1 
val7= wims_question
!else
val7=wimscenter special2
!endif
val8=coplanaires,non coplanaires
val9=Les composantes des vecteurs sont proportionnelles,	  donc les points sont alignés.,	  Les composantes des vecteurs ne sont pas proportionnelles,	 donc les points ne sont pas alignés.
!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val10[1;])
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val10[2;])
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val10[3;])
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in print([$val11]*($val15)+[$val12]*($val16))
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
!if $val14=1 
val18=coplanaires
val19=\(=\)
!else
val18=non coplanaires
t_=!replace internal \( by ( in print([$val17]+[$val13])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
val19=\(\not =\)
!endif
tmp0=!texmath $(val11[1])*x+($(val12[1]))*y

val20=$(tmp0)
tmp0=!texmath $(val11[2])*x+($(val12[2]))*y

val21=$(tmp0)
tmp0=!texmath $(val11[3])*x+($(val12[3]))*y

val22=$(tmp0)
val23=$[rint(($(val11[1]))*($(val12[2]))-($(val11[2]))*($(val12[1])))]
val24=$[rint(($(val17[1]))*($(val12[2]))-($(val17[2]))*($(val12[1])))]
val25=$[rint(($(val11[1]))*($(val17[2]))-($(val11[2]))*($(val17[1])))]
val26=\(($(val11[3])) \times \frac{$val24}{$val23} + ($(val12[3])) \times \frac{$val25}{$val23})

!ifval $val14=1
val18= $(val8[1])
!else
val18=$(val8[2])
!endif
!if $val14=1 
val27=$(val9[1]):<br>	<div class="wimscenter">	\(\overrightarrow{B C}= \j \overrightarrow{A B})	</div>	$(val9[2])
!else
val27=$(val9[3]), $(val9[4])
!endif
choicename1=
choicegood1=$val18
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="$val6">	<p>	Les vecteurs 
!insmath \overrightarrow{u}
$(), 
!insmath \overrightarrow{v}
$() et 
!insmath \overrightarrow{w}
$()	 dont les coordonnées dans un repère donné sont respectivement	</p>	<div class="wimscenter">	  
!insmath \overrightarrow{u}\left(\begin{array}{c}$(val11[1])\\ $(val11[2])\\ $(val11[3])\end{array}\right)
$(),	  
!insmath \overrightarrow{v}\left(\begin{array}{c}$(val12[1])\\ $(val12[2])\\ $(val12[3])\end{array}\right)
$(),	  
!insmath \overrightarrow{w}\left(\begin{array}{c}$(val17[1])\\ $(val17[2])\\ $(val17[3])\end{array}\right)
$()	</div>	sont-ils coplanaires&nbsp;?	</div>	<div class="$val7">	 Votre réponse : Les vecteurs sont  
!read oef/embed.phtml choice1,\size 
$().	</div>	
$()
!exit

:hint
$()Si 
!insmath \overrightarrow{u}
$() et 
!insmath \overrightarrow{v}
$() ne sont pas colinéaires,	  il faut chercher (x,y) tel que	
!insmath \overrightarrow{w} = x \overrightarrow{u} + y \overrightarrow{v}
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()On constate tout d'abord que 
!insmath \overrightarrow{u}
$() et 
!insmath \overrightarrow{v}
$() ne sont pas colinéaires.<br>	Cherchons 
!insmath (x,y)
$() tel que	
!insmath \overrightarrow{w} = x \overrightarrow{u} + y \overrightarrow{u}
$().<br>	On doit résoudre le système:<br>	
!insmath \left \lbrace \begin{array}{rcl} $(val17[1])&=&$val20 \\ $(val17[2])&=&$val21 \\ $(val17[3])&=&$val22 \end{array}
$()<br>	On résoud le système formé des deux premières équations : le déterminant du système vaut $val23 donc il possède une unique solution.<br>	On trouve 
!insmath x = \frac{$val24}{$val23}
$() et 
!insmath y=\frac{$val25}{$val23}
$().<br>	Si les vecteurs sont coplanaires on doit avoir une égalité numérique en reportant les valeurs de 
!insmath x
$() et de 
!insmath y
$() dans la troisième équation:<br>	
!insmath $(val17[3])
$() $val19 $val26 donc les vecteurs sont $val18.	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
