tmp0=!append item $val31 to $val25

val25=$(tmp0)
val32=$(val20[$val31])
tmp0=!positionof item $val32 in $val20

val33=$[rint($(tmp0))]
tmp0=!append item $val33 to $val26

val26=$(tmp0)

!ifval ($val30 >= $val31 and $val31<8)
