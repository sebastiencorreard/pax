!endif
!if $val30==8 and $val31==8 
val30=$[rint(7)]
!endif
val34=$(val20[$val30])
tmp0=!positionof item $val34 in $val20

val35=$[rint($(tmp0))]
tmp0=!append item $val35 to $val27

val27=$(tmp0)
val36=$val32$val34
tmp0=!append item $val36 to $val22

