!set title=Points coplanaires 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .special1 {font-size:x-large;background-color:lightblue;} .special2 {font-size:x-large;background-color:MistyRose;} .nonspecial {} </style> 
precision=10000

ansorder=c
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2!=1 
val6= wims_question
!else
val6=wimscenter special1
!endif

!ifval $val2!=1 
val7= wims_question
!else
val7=wimscenter special2
!endif
val8=coplanaires,non coplanaires
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint 0, 10

val12=$[rint($(tmp0))]
tmp0=!randint 0, 10

val13=$[rint($(tmp0))]
tmp0=!randint 0, 10

val14=$[rint($(tmp0))]
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]
tmp0=!randint -5, 5

val16=$[rint($(tmp0))]
tmp0=!randint -5, 5

val17=$[rint($(tmp0))]
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
tmp0=!randint 1, 2

val20=$[rint($(tmp0))]
tmp0=!randint 1, 5

val21=$[rint($(tmp0))]
tmp0=!randint 2, 5

val22=$[rint($(tmp0))]
tmp0=!randitem 0,0,0,1,3,0,0

val23=$[rint($(tmp0))]
tmp0=!randitem 0,2,0,0,1,0,0

val24=$[rint($(tmp0))]
tmp0=!randitem 0,3,0,0,1,0,-1

val25=$[rint($(tmp0))]
val26=$[rint($val22*(-1)^$val19)]
val27=$[rint($val21*(-1)^$val18)]
val28=$[rint($val9+$val22*(-1)^$val19*($val12-$val9)+$val21*(-1)^$val18*($val15-$val9)+$val23*$val12)]
val29=$[rint($val10+$val22*(-1)^$val19*($val13-$val10)+$val21*(-1)^$val18*($val16-$val10)+$val24*$val10)]
val30=$[rint($val11+$val22*(-1)^$val19*($val14-$val11)+$val21*(-1)^$val18*($val17-$val11)+$val24*$val17)]
val31=$[rint(($val11-$val30)*(($val9-$val12)*($val10-$val16)-($val10-$val13)*($val9-$val15))-($val10-$val29)*(($val9-$val12)*($val11-$val17)-($val11-$val14)*($val9-$val15))+($val9-$val28)*(($val10-$val13)*($val11-$val17)-($val11-$val14)*($val10-$val16)))]

!ifval $val31=0
val32=$(val8[1])
!else
val32=$(val8[2])
!endif

!ifval $val31=0
val33=$(val8[2])
!else
val33=$(val8[1])
!endif

!ifval confparm1=1 
val34= 
!else
val34=x-large
!endif
choicename1=\(A\), \(B\), \(C\) et \(D\) sont coplan
choicegood1=$val32
choicebad1=$val33
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="$val6">	Les points 
!insmath A
$(), 
!insmath B
$(), 
!insmath C
$() et 
!insmath D
$()	 dont les coordonnées dans un repère donné sont respectivement	 
!insmath ($val9;$val10;$val11)
$(),	 
!insmath ($val12;$val13 ;$val14)
$(),	 
!insmath ($val15 ;$val16 ;$val17)
$()	 et 
!insmath ($val28 ; $val29 ; $val30)
$()	 sont-ils coplanaires ?	</div>	<div class="$val7">	 Votre réponse : Les points sont  
!read oef/embed.phtml choice1 
$()	</div>	
$()
!exit

