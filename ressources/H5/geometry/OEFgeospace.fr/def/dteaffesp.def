!set title=Droites affines dans l'espace 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .special1 {font-size:x-large;background-color:lightblue;} .special2 {font-size:x-large;background-color:MistyRose;} .nonspecial {} </style> 

ansorder=c
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2!=1 
val6= wims_question
!else
val6=wimscenter special1
!endif

!ifval $val2!=1 
val7= wims_question
!else
val7=wimscenter special2
!endif
val8=strictement parallèles, confondues, non coplanaires, sécantes

!ifval confparm1=1 
val9= 
!else
val9=x-large
!endif
!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val10[1;])
val11=!translate internal $	\
$ to ;; in $tmp
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val11]*t+[$val12])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]

!ifval $val14=1
tmp=!trim  $val11 
val15=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim $(val10[2;])
val15=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val16=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in print([$val15]*$val16)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val15=!translate internal $	\
$ to ;; in $tmp
!if $val14=1 
tmp0=!randint 0, 3

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in print([$(val10[2;])]*$val17+[$val12]-2*[$val11])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val18=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val15]*t+[$val18])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp

!ifval $val17=0
val20= confondues
!else
val20=strictement parallèles
!endif
!endif
!if $val14=2 
tmp0=!randint 1, 3

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in print([$val12]-$val17*[$val11])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val18=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val15]*t+[$val18])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp
val20=sécantes
!endif
!if $val14=3 
tmp0=!randint 0, 3

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in print([$(val10[3;])]+[$val12]-$val17*[$val11])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val18=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val15]*t+[$val18])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp
val20=non coplanaires
!endif
tmp0=!texmath $(val13[1;1])

tmp1=!texmath $(val13[1;2])

tmp2=!texmath $(val13[1;3])

tmp=!trim $(tmp0),$(tmp1),$(tmp2)
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!texmath $(val19[1;1])

tmp1=!texmath $(val19[1;2])

tmp2=!texmath $(val19[1;3])

tmp=!trim $(tmp0),$(tmp1),$(tmp2)
val19=!translate internal $	\
$ to ;; in $tmp
choicename1=
choicegood1=$val20
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="$val6">	<p>On considère deux droites de l'espace:</p>	<p> La droite 
!insmath d_1
$() passe par le point 
!insmath A($(val12[1]);$(val12[2]);$(val12[3]))
$() et a pour vecteur directeur 
!insmath \vec{u}
$()
!insmath ($val11)
$().</p>	<p> La droite 
!insmath d_2
$() passe par le point 
!insmath B($(val18[1]);$(val18[2]);$(val18[3]))
$() et a pour vecteur directeur 
!insmath \vec{v}
$()
!insmath ($val15)
$().</p>	On s'intéresse à leur position relative.	</div>	<div class="$val7">	 Votre réponse : Les deux droites sont  
!read oef/embed.phtml choice1 
$().	 </div>	
$()
!exit

:hint
$()<ul>	<li> Si les vecteurs 
!insmath \vec{u}
$() et 
!insmath \vec{v}
$() sont colinéaires, les droites sont strictement	parallèles ou confondues.	<ul>	<li> Elles sont confondues si 
!insmath \overrightarrow{A B}
$() et 
!insmath \vec{u}
$() sont colinéaires.	</li><li> Elles sont strictement parallèles sinon.	</li></ul></li>	<li> Si les vecteurs 
!insmath \vec{u}
$() et 
!insmath \vec{v}
$() ne sont pas colinéaires,	 les droites sont sécantes ou non coplanaires.	<ul>	<li> Elles sont sécantes si les vecteurs 
!insmath \vec{u}
$(), 
!insmath \vec{v}
$() et 
!insmath \overrightarrow{A B}
$()	sont coplanaires.	</li><li> Elles sont non coplanaires sinon.	</li></ul></li>	</ul>	
$()
!exit

