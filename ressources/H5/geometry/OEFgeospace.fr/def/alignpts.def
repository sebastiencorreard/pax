!set title=Points alignés I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .special1 {font-size:x-large;background-color:lightblue;} .special2 {font-size:x-large;background-color:MistyRose;} .nonspecial {} </style> 

ansorder=c
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2!=1 
val6= wims_question
!else
val6=wimscenter special1
!endif

!ifval $val2!=1 
val7= wims_question
!else
val7=wimscenter special2
!endif
val8=L'alignement des points \(A\), \(B\), \(C\) équivaut	  à la colinéarité des vecteurs
val9=et
val10=alignés,non alignés
val11=Composantes de 
val12=Calculons les composantes des vecteurs
val13=Les composantes des vecteurs sont proportionnelles,	  donc les points sont alignés.,	  Les composantes des vecteurs ne sont pas proportionnelles,	 donc les points ne sont pas alignés.
!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val14=!translate internal $	\
$ to ;; in $tmp
!readproc slib/matrix/random 1,3,5 
tmp0=$slib_out
tmp=!trim $(tmp0)
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val14[1;])
val16=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val15]+[$val16])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]

!ifval $val18=1
tmp=!trim  $val16 
val19=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim $(val14[2;])
val19=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in print([$val19]*$val20)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val19=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val17]+[$val19])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val21=!translate internal $	\
$ to ;; in $tmp

!ifval $val18=1
val22= $(val10[1])
!else
val22=$(val10[2])
!endif
!if $val18=1 
val23=$(val13[1]):	\(\overrightarrow{B C}= $val20 \overrightarrow{A B}\),	  $(val13[2])
!else
val23=$(val13[3]): $(val13[4])
!endif
choicename1=
choicegood1=$val22
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="$val6">	Les points 
!insmath A
$(),
!insmath B
$() et 
!insmath C
$()	 dont les coordonnées dans un repère donné sont respectivement	<div class="wimscenter">	 
!insmath A($(val15[1]);$(val15[2]);$(val15[3]))
$(), 
!insmath B($(val17[1]);$(val17[2]);$(val17[3]))
$(), 
!insmath C($(val21[1]);$(val21[2]);$(val21[3]))
$()	</div>	sont-ils alignés ?	</div>	<div>	 Votre réponse : les points sont  
!read oef/embed.phtml choice1,\size 
$().	</div>	
$()
!exit

:hint
$()$val8	
!insmath \overrightarrow{A B}
$() $val9	
!insmath \overrightarrow{B C}
$().	
$()
!exit

:help
$()
$()
!exit

:solution
$()	$val12 
!insmath \overrightarrow{A B}
$() $val9	
!insmath \overrightarrow{B C}
$()	:	
!insmath \overrightarrow{A B}
$()=
!insmath \left(\begin{array}{c} $(val16[1]) \\ $(val16[2]) \\ $(val16[3])\end{array}\right)
$()	$val9 
!insmath \overrightarrow{B C}
$()= 
!insmath \left(\begin{array}{c} $(val19[1]) \\ $(val19[2]) \\ $(val19[3])\end{array}\right)
$().<br>	$val23	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,12,15,16,17,19,21,23
embedcnt=1
