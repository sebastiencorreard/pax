!set title=Médiatrice d'un segment
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint($val6+$val8)]
val11=$[rint($val7+$val9)]
tmp0=!randitem 0,1

val12=$[rint($(tmp0))]
tmp0=!randitem 0,1

val13=$[rint($(tmp0))]
t_=!rawmath ($val6+$val10)/2
val14=!exec pari print($t_)
t_=!rawmath ($val7+$val11)/2
val15=!exec pari print($t_)
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
!if $val16=1 
val17=abscissses
t_=!rawmath ($val8*$val14+$val9*$val15)/$val8
val18=!exec pari print($t_)
t_=!rawmath 0
val19=!exec pari print($t_)
!endif
!if $val16=2 
val17=ordonnées
t_=!rawmath ($val8*$val14+$val9*$val15)/$val9
val19=!exec pari print($t_)
t_=!rawmath 0
val18=!exec pari print($t_)
!endif
replytype1=rational

replyname1=xM
replygood1=$val18
replytype2=rational

replyname2=yM
replygood2=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère orthonormé, 	on considère les points A($val6,$val7) et B($val10,$val11).<br />	La médiatrice du segment 
!insmath \lbrack AB \rbrack
$() coupe l'axe des $val17 en un point M dont les coordonnées sont:<br />	
!insmath x_M
$()=  
!read oef/embed.phtml reply 1,5 
$() et 
!insmath y_M
$()=  
!read oef/embed.phtml reply 2,5 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11,17
embedcnt=2
