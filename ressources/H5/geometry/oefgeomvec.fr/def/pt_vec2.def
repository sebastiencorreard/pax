!set title=Point défini par une égalité vectorielle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
val12=$[rint($val6+$val8*(-1)^($val10))]
val13=$[rint($val7+$val9*(-1)^($val11))]
tmp0=!randint 1, 5

val14=$[rint($(tmp0))]
tmp0=!randint 1, 5

val15=$[rint($(tmp0))]

!ifval $val14=1
val16=\overrightarrow{MA}
!else
val16=$val14\overrightarrow{MA}
!endif

!ifval $val15=1
val17=\overrightarrow{MB}
!else
val17=$val15\overrightarrow{MB}
!endif
tmp=!translate ";': to $     $ in ($val14*$val6+$val15*$val12)/($val14+$val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val14*$val7+$val15*$val13)/($val14+$val15)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=!rawmath $(tmp0)
replytype1=default
replyname1=Absicsse du point \(M)
replygood1=$val18
replytype2=default
replyname2=Ordonnée du point \(M)
replygood2=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans un repère, on considère les points 
!insmath A
$() et 
!insmath B
$() de coordonnées respectives 	
!insmath \left(  $val6, $val7 \right) 
$() et 
!insmath \left( $val12 , $val13 \right) 
$(). 	Déterminer les coordonnées du point 
!insmath M
$() tel que:	<div class="wimscenter">	
!insmath 	$val16+$val17=\overrightarrow{0}	
$()</div>
$()
!exit

:hint
$()Exprimer les coordonnées du vecteur 
!insmath $val16+$val17
$() en fonction des coordonnées de 
!insmath M
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()Le point 
!insmath M
$() a pour coordonnées 
!insmath \left(  $val18 , $val19  \right) 
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,12,13,16,17,18,19
embedcnt=0
