!set title=Aire d'un triangle isocèle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric,PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val8=$[rint($val6+$(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val9=$[rint($val7+$(tmp0)*$(tmp1))]
t_=!rawmath ($val6+$val8)/2
val10=!exec pari print($t_)
t_=!rawmath ($val7+$val9)/2
val11=!exec pari print($t_)
val12=$[rint($val8-$val6)]
val13=$[rint($val9-$val7)]
t_=!replace internal \( by ( in gcd($val12,$val13)
tmp0=!exec pari $t_

val14=$[rint($(tmp0))]
val12=$[rint($val12/$val14)]
val13=$[rint($val13/$val14)]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val15=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val10+$val15*(-1)*($val13)
val16=!exec pari print($t_)
t_=!rawmath $val11+$val15*$val12
val17=!exec pari print($t_)
t_=!rawmath ($val15)^2*(($val12)^2+($val13)^2)
val18=!exec pari print($t_)
t_=!rawmath $val14^2*(($val12)^2+($val13)^2)
val19=!exec pari print($t_)
t_=!replace internal \( by ( in sqrt($val19)
tmp0=!exec maxima $t_

val20=$(tmp0)
t_=!replace internal \( by ( in sqrt($val18)
tmp0=!exec maxima $t_

val21=$(tmp0)
tmp0=!texmath $val20

val22=$(tmp0)
tmp0=!texmath $val21

val23=$(tmp0)
t_=!rawmath sqrt($val18*$val19)/2
val24=!exec pari print($t_)
oefsteps=reply 1,reply 2	reply 3,reply 4	reply 5 
nextstep=!nosubst reply 1,reply 2	reply 3,reply 4	reply 5 
!readproc oef/steps.proc
replytype1=rational

replyname1=Abscisse de I
replygood1=$val10
replytype2=rational

replyname2=Ordonnée de I
replygood2=$val11
replytype3=default
replyname3=Longueur AB
replygood3=$val20
replytype4=default
replyname4=Longueur SI
replygood4=$val21
replytype5=rational

replyname5=Aire de SAB
replygood5=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère orthonormé, on considère les points 
!insmath A($val6,$val7)
$(), 
!insmath B($val8,$val9)
$()	et 
!insmath S($val16,$val17)
$(). 	On admet que le triangle SAB est isocèle de sommet S et on note 
!insmath I
$() le milieu du segment 
!insmath \lbrack AB \rbrack
$().<br>	Cet exercice comporte trois questions.<br> 	
!if $m_step=1 
$()	<b> Question 1:</b> <br>	Les coordonnées du point I sont (  
!read oef/embed.phtml reply 1,5 
$(),  
!read oef/embed.phtml reply 2,5 
$())	 
!endif
$()	
!if $m_step=2 
$()	<b> Question 2:</b> <br>	Oui, 
!insmath I($val10;$val11)
$(). Calculer les longeurs 
!insmath SI
$() et 
!insmath AB
$(). On a 
!insmath AB=
$()  
!read oef/embed.phtml reply 3,10 
$() et 
!insmath SI=
$()  
!read oef/embed.phtml reply 4,10 
$().	 
!endif
$()	
!if $m_step=3 
$()	<b> Question 3:</b> <br>	Oui, 
!insmath AB=$val22
$() et 
!insmath SI=$val23
$().<br>	L'aire du triangle 
!insmath SAB
$() est donc égale à :  
!read oef/embed.phtml reply 5,10 
$().	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
