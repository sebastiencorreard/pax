!set title=Alignement
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
val14=$[rint($val6+$val8*$val12*(-1)^$val10)]
val15=$[rint($val7+$val9*$val12*(-1)^$val10)]
tmp0=!randint 0, 1

val16=$[rint($(tmp0))]
tmp0=!randint 0, 1

val17=$[rint($(tmp0))]
val18=$[rint($val6+$val8*$val13*(-1)^$val11+$val16*$val8)]
val19=$[rint($val7+$val9*$val13*(-1)^$val11+$val17*$val9)]
val20=$[rint(($val6-$val14)*($val7-$val19)-($val6-$val18)*($val7-$val15))]

!ifval $val20=0
val21=Oui
!else
val21=Non
!endif

!ifval $val20=0
val22=Non
!else
val22=Oui
!endif
choicename1=\(A), \(B) et \(C) sont alignés
choicegood1=$val21
choicebad1=$val22
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Les points 
!insmath A
$(),
!insmath B
$() et 
!insmath C
$(), dont les coordonnées dans un repère donné sont 	respectivement 
!insmath \left( $val6 ,$val7 \right)
$(), 
!insmath \left($val14 , $val15\right)
$() et	 
!insmath \left( $val18 , $val19 \right)
$() sont-ils alignés ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Le déterminant des vecteurs 
!insmath \overrightarrow{AB}
$() et 
!insmath \overrightarrow{AC}
$() est égal à $val20.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
