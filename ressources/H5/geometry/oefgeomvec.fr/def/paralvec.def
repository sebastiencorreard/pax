!set title=Parallélogramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, -1

val10=$[rint($(tmp0))]
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val14=$[rint($val6+$val8*(-1)^$val12)]
val15=$[rint($val7+$val9*(-1)^$val12)]
val16=$[rint($val6+$val10*(-1)^$val12)]
val17=$[rint($val7+$val11*(-1)^$val12)]
tmp0=!randint 1, 3

val18=$[rint($(tmp0))]
tmp0=!item $val18 of A B C D,A C D B,A C B D,A B D C

val19=$(tmp0)
!if $val18=1 
val20=$[rint($val16+$val6-$val14)]
val21=$[rint($val17+$val7-$val15)]
!endif
!if $val18=2 
val20=$[rint($val14+$val16-$val6)]
val21=$[rint($val15+$val17-$val7)]
!endif
!if $val18=3 
val20=$[rint($val14+$val6-$val16)]
val21=$[rint($val15+$val7-$val17)]
!endif
!if $val18=4 
val20=$[rint($val16+$val14-$val6)]
val21=$[rint($val17+$val15-$val7)]
!endif

!ifval \d=0
val22=Oui
!else
val22=Non
!endif

!ifval \d=0
val23=Non
!else
val23=Oui
!endif
replytype1=default
replyname1=Abscisse du point \(D)
replygood1=$val20
replytype2=default
replyname2=Ordonnée du point \(D)
replygood2=$val21
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans un repère donné, on considère les  points	 
!insmath A
$()
!insmath \left( $val6 , $val7\right)
$(), 
!insmath B
$()
!insmath \left($val14 , $val15\right)
$() et 	 
!insmath C
$()
!insmath \left( $val16 , $val17\right)
$().	  Déterminer les coordonnées du point 
!insmath D
$() tel que le quadrilatère <b>
!insmath $val19
$()</b>	   soit un parallélogramme.	   <div class="wimscenter">	
!insmath x_D
$() =  
!read oef/embed.phtml reply 1,5 
$() <br />	
!insmath y_D
$() =  
!read oef/embed.phtml reply 2,5 
$() <br />	</div>
$()
!exit

