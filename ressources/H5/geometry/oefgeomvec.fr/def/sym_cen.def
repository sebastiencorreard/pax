!set title=Symétrie centrale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint -15, 15

val9=$[rint($(tmp0))]
val10=$[rint($val8+($val8-$val6))]
val11=$[rint($val9+($val9-$val7))]
replytype1=default
replyname1=Absicsse du point \(N)
replygood1=$val10
replytype2=default
replyname2=Ordnnée du point \(N)
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer les coordonnées du point 
!insmath N
$() symétrique de 
!insmath M
$() 	
!insmath \left( $val6 , $val7 \right) 
$() par rapport à 
!insmath I 
$() 	
!insmath \left( $val8 , $val9 \right) 
$().	<div class="wimscenter">	
!insmath x_N
$() =  
!read oef/embed.phtml reply 1,5 
$() <br />	
!insmath y_N
$() =  
!read oef/embed.phtml reply 2,5 
$() <br />	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	On obtient N 
!insmath 	 \left( 	 $val10 , $val11 	\right) 	
$()	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=2
