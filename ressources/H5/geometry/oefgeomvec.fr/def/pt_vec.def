!set title=Coordonnées d'un vecteur dans le plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -15, 15

val6=$[rint($(tmp0))]
tmp0=!randint -15, 15

val7=$[rint($(tmp0))]
tmp0=!randint -15, 15

val8=$[rint($(tmp0))]
tmp0=!randint -15, 15

val9=$[rint($(tmp0))]
tmp0=!randint -15, 15

val10=$[rint($(tmp0))]
tmp0=!randint -15, 15

val11=$[rint($(tmp0))]
tmp0=!randitem A,B,C

val12=$(tmp0)
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

val14=$[rint($(tmp0))]
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
val17=$[rint($val13*(-1)^$val15)]
val18=$[rint($val14*(-1)^$val16)]

!ifval $val12 issametext A
val19=$[rint($val6)]
!endif

!ifval $val12 issametext B
val19=$[rint($val8)]
!endif

!ifval $val12 issametext C
val19=$[rint($val10)]
!endif

!ifval $val12 issametext A
val20=$[rint($val7)]
!endif

!ifval $val12 issametext B
val20=$[rint($val9)]
!endif

!ifval $val12 issametext C
val20=$[rint($val11)]
!endif
val21=$[rint($val19+$val17*($val8-$val6)+$val18*($val10-$val6))]
val22=$[rint($val20+$val17*($val9-$val7)+$val18*($val11-$val7))]

!ifval $val17=1
val23=\overrightarrow{AB}
!endif

!ifval $val18=1
val24=+\overrightarrow{AC}
!endif

!ifval $val17=-1
val23=-\overrightarrow{AB}
!endif

!ifval $val18=-1
val24=-\overrightarrow{AC}
!endif

!ifval (($val17<>1) and ($val17<>-1))
val23=$val17\overrightarrow{AB}
!endif

!ifval $val18>1
val24=+$val18\overrightarrow{AC}
!endif

!ifval $val18<-1
val24=$val18\overrightarrow{AC}
!endif
replytype1=default
replyname1=Abscisse du point \(M)
replygood1=$val21
replytype2=default
replyname2=Ordonnée du point \(M)
replygood2=$val22
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans un repère donné, on considère les  points 
!insmath A
$() 	
!insmath \left( $val6, $val7\right)
$(), 
!insmath B
$()
!insmath \left( $val8 , $val9 \right)
$() et 
!insmath C
$()
!insmath \left( $val10 , $val11 \right)
$(). Déterminer les coordonnées du point 
!insmath M
$() défini par la relation suivante :		<div class="wimscenter">	
!insmath \overrightarrow{$val12 M}= $val23 $val24
$()	</div>
$()
!exit

:hint
$()On pourra commencer par rechercher les coordonnées du vecteur 
!insmath $val23 $val24
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()Le point 
!insmath M
$() a pour coordonnées 
!insmath \left( $val21 , $val22 \right)
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,21,22,23,24
embedcnt=0
