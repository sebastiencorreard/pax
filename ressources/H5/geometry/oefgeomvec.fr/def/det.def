!set title=Calcul de déterminant
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, PITOUN
email=frederic.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
val8=$[rint($val6*(-1)^($val7))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
val13=$[rint($val11*(-1)^$val12)]

!ifval $val13=1
val14=x
!endif

!ifval $val13=-1
val14= -x 
!endif

!ifval (($val13<>1) and ($val13<>-1))
val14=$val13 x  
!endif

!ifval $val7>0
val15=$val14 + $val7
!endif

!ifval $val7=0
val15=$val14 
!endif

!ifval $val7<0
val15=$val14  $val7
!endif
t_=!rawmath ( ($val9*$val10/$val8)-$val7)/$val13 
val16=!exec pari print($t_)
replytype1=rational

replyname1=Valeur de \(x)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Pour quelle valeur de 
!insmath x
$() les vecteurs 
!insmath \overrightarrow{u}
$() et 
!insmath \overrightarrow{v}
$()	 de coordonnées respectives 
!insmath \left($val8 , $val9 \right)
$() et 
!insmath  \left( $val10 , $val15 \right)
$() sont-ils colinéaires ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La bonne réponse est 
!insmath x
$() = $val16.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,15,16
embedcnt=0
