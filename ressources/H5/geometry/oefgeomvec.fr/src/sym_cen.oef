\integer{x1=random(-15..15)}
\integer{y1=random(-15..15)}
\integer{x2=random(-15..15)}
\integer{y2=random(-15..15)}
\integer{x=\x2+(\x2-\x1)}
\integer{y=\y2+(\y2-\y1)}
\statement{Déterminer les coordonnées du point \(N) symétrique de \(M) 
\(\left( \x1 , \y1 \right) ) par rapport à \(I ) 
\(\left( \x2 , \y2 \right) ).
<div class="wimscenter">
\(x_N) = \embed{reply 1,5} <br />
\(y_N) = \embed{reply 2,5} <br />
</div>
}


\answer{Absicsse du point \(N)}{\x}{type=default}
\answer{Ordnnée du point \(N)}{\y}{type=default}

\solution{
On obtient N \(
 \left( 
 \x , \y 
\right) 
)
}
