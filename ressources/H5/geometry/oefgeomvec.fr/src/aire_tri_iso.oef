\title{Aire d'un triangle isocèle}
\language{fr}
\range{-5..5}
\author{Frédéric,PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{xA=random(-10..10)}
\integer{yA=random(-10..10)}

\integer{xB=\xA+random(-1,1)*random(1..10)}
\integer{yB=\yA+random(-1,1)*random(1..10)}

\rational{xI=(\xA+\xB)/2}
\rational{yI=(\yA+\yB)/2}

\integer{xu=\xB-\xA}
\integer{yu=\yB-\yA}
\integer{d=pari(gcd(\xu,\yu))}

\integer{xu=\xu/\d}
\integer{yu=\yu/\d}

u est un vecteur normal à la médatrice de AB

\integer{k=random(-1,1)*randint(1..5)}
 
\rational{xS=\xI+\k*(-1)*(\yu)}
\rational{yS=\yI+\k*\xu}

\rational{nu=(\k)^2*((\xu)^2+(\yu)^2)}
\rational{ab=\d^2*((\xu)^2+(\yu)^2)}

\text{lab=maxima(sqrt(\ab))}
\text{lsi=maxima(sqrt(\nu))}

\text{tlab=texmath(\lab)}
\text{tlsi=texmath(\lsi)}


\rational{aire=sqrt(\nu*\ab)/2}

\steps{
reply 1,reply 2
reply 3,reply 4
reply 5
}

\statement{Dans le plan muni d'un repère orthonormé, on considère les points \(A(\xA,\yA)), \(B(\xB,\yB))
et \(S(\xS,\yS)). 
On admet que le triangle SAB est isocèle de sommet S et on note \(I) le milieu du segment \(\lbrack AB \rbrack).<br>
Cet exercice comporte trois questions.<br> 
\if{\step=1}{
<b> Question 1:</b> <br>
Les coordonnées du point I sont ( \embed{reply 1,5}, \embed{reply 2,5})
}
\if{\step=2}{
<b> Question 2:</b> <br>
Oui, \(I(\xI;\yI)). Calculer les longeurs \(SI) et \(AB). On a \(AB=) \embed{reply 3,10} et \(SI=) \embed{reply 4,10}.
}
\if{\step=3}{
<b> Question 3:</b> <br>
Oui, \(AB=\tlab) et \(SI=\tlsi).<br>
L'aire du triangle \(SAB) est donc égale à : \embed{reply 5,10}.
}
}


\answer{Abscisse de I}{\xI}{type=rational}
\answer{Ordonnée de I}{\yI}{type=rational}
\answer{Longueur AB}{\lab}{type=default}
\answer{Longueur SI}{\lsi}{type=default}
\answer{Aire de SAB}{\aire}{type=rational}
