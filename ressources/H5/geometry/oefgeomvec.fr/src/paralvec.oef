\title{Parallélogramme}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x1=random(-5..5)}
\integer{y1=random(-5..5)}
\integer{xl=random(1..5)}
\integer{yl=random(1..5)}
\integer{xL=random(-5..-1)}
\integer{yL=random(1..5)}
\integer{d1=random(1..2)}
\integer{d2=random(1..2)}
\integer{x2=\x1+\xl*(-1)^\d1}
\integer{y2=\y1+\yl*(-1)^\d1}
\integer{x3=\x1+\xL*(-1)^\d1}
\integer{y3=\y1+\yL*(-1)^\d1}

\integer{al=random(1..3)}
\text{plg=item(\al,A B C D,A C D B,A C B D,A B D C)}

\if{\al=1}{
\integer{x4=\x3+\x1-\x2}
\integer{y4=\y3+\y1-\y2}
}
\if{\al=2}{
\integer{x4=\x2+\x3-\x1}
\integer{y4=\y2+\y3-\y1}
}
\if{\al=3}{
\integer{x4=\x2+\x1-\x3}
\integer{y4=\y2+\y1-\y3}
}
\if{\al=4}{
\integer{x4=\x3+\x2-\x1}
\integer{y4=\y3+\y2-\y1}
}

\text{b=\d=0?Oui:Non}
\text{m=\d=0?Non:Oui}
\statement{Dans un repère donné, on considère les  points
 \(A)\(\left( \x1 , \y1\right)), \(B)\(\left(\x2 , \y2\right)) et 
 \(C)\(\left( \x3 , \y3\right)).
  Déterminer les coordonnées du point \(D) tel que le quadrilatère <b>\(\plg)</b>
   soit un parallélogramme.
   <div class="wimscenter">
\(x_D) = \embed{reply 1,5} <br />
\(y_D) = \embed{reply 2,5} <br />
</div>}


\answer{Abscisse du point \(D)}{\x4}{type=default}
\answer{Ordonnée du point \(D)}{\y4}{type=default}


\solution{On peut utiliser la propriété :  \(A B C D)
 parallélogramme \(\Leftrightarrow) \(\overrightarrow{AB}) = \(\overrightarrow{DC}).}
