\title{Calcul de déterminant}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{x0=random(1..10)}
\integer{p=random(1..2)}
\integer{x1=\x0*(-1)^(\p)}
\integer{x2=random(-10..10)}

\integer{x3=random(-10..10)}
\integer{m=random(1..5)}
\integer{p=random(-10..10)}
\integer{d=random(1..2)}
\integer{k=\m*(-1)^\d}

\text{mon=\k=1?x}
\text{mon=\k=-1? -x }
\text{mon=((\k<>1) and (\k<>-1))?\k x  }


\text{pol=\p>0?\mon + \p}
\text{pol=\p=0?\mon }
\text{pol=\p<0?\mon  \p}


\rational{sol= ( (\x2*\x3/\x1)-\p)/\k }

\statement{Pour quelle valeur de \(x) les vecteurs \(\overrightarrow{u}) et \(\overrightarrow{v})
 de coordonnées respectives \(\left(\x1 , \x2 \right)) et \( \left( \x3 , \pol \right)) sont-ils colinéaires ?}


\answer{Valeur de \(x)}{\sol}{type=rational}

\solution{La bonne réponse est \(x) = \sol.}
