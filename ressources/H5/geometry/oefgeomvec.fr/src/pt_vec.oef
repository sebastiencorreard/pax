\title{Coordonnées d'un vecteur dans le plan}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}


\integer{x1=random(-15..15)}
\integer{y1=random(-15..15)}
\integer{x2=random(-15..15)}

\integer{y2=random(-15..15)}

\integer{x3=random(-15..15)}

\integer{y3=random(-15..15)}

\text{o=random(A,B,C)}

\integer{l1=random(1..5)}
\integer{l2=random(1..5)}
\integer{d1=random(1..2)}
\integer{d2=random(1..2)}

\integer{k1=\l1*(-1)^\d1}
\integer{k2=\l2*(-1)^\d2}


\integer{x0=\o issametext A?\x1}
\integer{x0=\o issametext B?\x2}
\integer{x0=\o issametext C?\x3}


\integer{y0=\o issametext A?\y1}
\integer{y0=\o issametext B?\y2}
\integer{y0=\o issametext C?\y3}


\integer{x4=\x0+\k1*(\x2-\x1)+\k2*(\x3-\x1)}           
\integer{y4=\y0+\k1*(\y2-\y1)+\k2*(\y3-\y1)}   

\text{v1=\k1=1?\overrightarrow{AB}}
\text{v2=\k2=1?+\overrightarrow{AC}}

\text{v1=\k1=-1?-\overrightarrow{AB}}
\text{v2=\k2=-1?-\overrightarrow{AC}}

\text{v1=((\k1<>1) and (\k1<>-1))?\k1\overrightarrow{AB}}
\text{v2=\k2>1?+\k2\overrightarrow{AC}}
\text{v2=\k2<-1?\k2\overrightarrow{AC}}


\statement{Dans un repère donné, on considère les  points \(A) 
\(\left( \x1, \y1\right)), \(B)\(\left( \x2 , \y2 \right)) et \(C)\(\left( \x3 , \y3 \right)). Déterminer les coordonnées du point \(M) défini par la relation suivante :

<div class="wimscenter">
\(\overrightarrow{\o M}= \v1 \v2)
</div>} 

\hint{On pourra commencer par rechercher les coordonnées du vecteur \(\v1 \v2).}
\answer{Abscisse du point \(M)}{\x4}{type=default}
\answer{Ordonnée du point \(M)}{\y4}{type=default}


\solution{Le point \(M) a pour coordonnées \(\left( \x4 , \y4 \right)).}
