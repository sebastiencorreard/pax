\title{Point défini par une égalité vectorielle}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{x1=random(-10..10)}

\integer{y1=random(-10..10)}

\integer{l=random(1..10)}

\integer{L=random(1..10)}
\integer{d1=random(1..2)}
\integer{d2=random(1..2)}
\integer{x2=\x1+\l*(-1)^(\d1)}
\integer{y2=\y1+\L*(-1)^(\d2)}

\integer{k1=random(1..5)}
\integer{k2=random(1..5)}

\text{v1=\k1=1?\overrightarrow{MA}:\k1\overrightarrow{MA}}
\text{v2=\k2=1?\overrightarrow{MB}:\k2\overrightarrow{MB}}


\function{x=simplify((\k1*\x1+\k2*\x2)/(\k1+\k2))}
\function{y=simplify((\k1*\y1+\k2*\y2)/(\k1+\k2))}
\statement{Dans un repère, on considère les points \(A) et \(B) de coordonnées respectives 
\(\left(  \x1, \y1 \right) ) et \(\left( \x2 , \y2 \right) ). 
Déterminer les coordonnées du point \(M) tel que:
<div class="wimscenter">
\(
\v1+\v2=\overrightarrow{0}
)</div>}

\hint{Exprimer les coordonnées du vecteur \(\v1+\v2) en fonction des coordonnées de \(M).}
\answer{Absicsse du point \(M)}{\x}{type=default}
\answer{Ordonnée du point \(M)}{\y}{type=default}


\solution{Le point \(M) a pour coordonnées \(\left(  \x , \y  \right) )}
