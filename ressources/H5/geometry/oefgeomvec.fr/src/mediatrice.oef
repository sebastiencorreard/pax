\title{Médiatrice d'un segment}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000} 


\integer{xA=random(-10..10)}
\integer{yA=random(-10..10)}

\integer{xv=random(-1,1)*randint(1..5)}
\integer{yv=random(-1,1)*randint(1..5)}


\integer{xB=\xA+\xv}
\integer{yB=\yA+\yv}

\integer{px=random(0,1)}
\integer{py=random(0,1)}


\rational{xI=(\xA+\xB)/2}
\rational{yI=(\yA+\yB)/2}


\integer{al=randint(1..2)}

\if{\al=1}{
\text{axe=abscissses}
\rational{xM=(\xv*\xI+\yv*\yI)/\xv}
\rational{yM=0}
}

\if{\al=2}{
\text{axe=ordonnées}
\rational{yM=(\xv*\xI+\yv*\yI)/\yv}
\rational{xM=0}
}







\statement{Dans le plan muni d'un repère orthonormé, 
on considère les points A(\xA,\yA) et B(\xB,\yB).<br />
La médiatrice du segment \(\lbrack AB \rbrack) coupe l'axe des \axe en un point M dont les coordonnées sont:<br />
\(x_M)= \embed{reply 1,5} et \(y_M)= \embed{reply 2,5}
}

\answer{xM}{\xM}{type=rational}
\answer{yM}{\yM}{type=rational}
