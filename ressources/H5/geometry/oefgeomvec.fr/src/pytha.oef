\title{Triangles rectangles}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000} 


\integer{xA=random(-10..10)}
\integer{yA=random(-10..10)}

\integer{xv=random(-1,1)*randint(1..5)}
\integer{yv=random(-1,1)*randint(1..5)}

\integer{k=randint(1..4)}

\integer{xB=\xA+\xv}
\integer{yB=\yA+\yv}

\integer{px=random(0,1)}
\integer{py=random(0,1)}


\integer{xC=\xA+\k*-1*\yv+\px}
\integer{yC=\yA+\k*\xv+\py}


\integer{al=randint(1..6)}

\text{A=item(\al,A,B,C,A,B,C)}
\text{B=item(\al,B,C,A,C,A,B)}
\text{C=item(\al,C,A,B,B,C,A)}


\integer{x1=item(\al,\xA,\xC,\xB,\xA,\xB,\xC)}
\integer{y1=item(\al,\yA,\yC,\yB,\yA,\yB,\yC)}


\integer{x2=item(\al,\xB,\xA,\xC,\xC,\xA,\xB)}
\integer{y2=item(\al,\yB,\yA,\yC,\yC,\yA,\yB)}

\integer{x3=item(\al,\xC,\xB,\xA,\xB,\xC,\xA)}
\integer{y3=item(\al,\yC,\yB,\yA,\yB,\yC,\yA)}

\text{l1=maxima(sqrt((\xB-\xA)^2+(\yB-\yA)^2))}
\text{l2=maxima(sqrt((\xB-\xC)^2+(\yB-\yC)^2))}
\text{l3=maxima(sqrt((\xA-\xC)^2+(\yA-\yC)^2))}

\integer{test=\px+\py}

\if{\test>0}{
\integer{rep=1}
}{
\integer{rep=2}
}

\steps{
reply 1, reply 2,reply 3
reply 4
}


\statement{Dans le plan muni d'un repère orthonormé, 
on considère les points A(\x1,\y1), B(\x2,\y2) et C(\x3,\y3).<br>
Cet exercice comporte deux questions.<br>
\if{\step=1}{
<b> Question 1:</b> <br>
Calculer les longueurs des côtés de ce triangle. On a: <br>
<ul>
<li>\A\B=\embed{reply 1,8} </li>
<li>\B\C=\embed{reply 2,8} </li>
<li>\A\C=\embed{reply 3,8}</li>
</ul>
<b>Note: </b> Si vous trouvez un résultat de la forme racine carrée de \(\sqrt{a}), vous devez le noter <i> sqrt(a) </i>.
 
}
\if{\step=2}{
On vient de voir que \A\B=\(\l1), \B\C=\(\l2) et que \A\C=\(\l3).<br>
<b> Question 2:</b> <br>
Le triangle ABC \embed{reply 4}<br>}
}

\answer{\A\B}{\l1}{type=formal}

\answer{\B\C}{\l2}{type=formal}

\answer{\A\C}{\l3}{type=formal}

\answer{Choix}{\rep;n'est pas rectangle,est rectangle en \A,est rectangle en \B, est rectangle en \C}{type=menu}
