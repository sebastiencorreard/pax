\title{Alignement}
\language{fr}
\range{-5..5}
\author{Frédéric, PITOUN}
\email{frederic.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x1=random(-5..5)}
\integer{y1=random(-5..5)}
\integer{x=random(1..10)}
\integer{y=random(1..10)}
\integer{d1=random(1..2)}
\integer{d2=random(1..2)}
\integer{k2=random(1..5)}
\integer{k3=random(1..5)}
\integer{x2=\x1+\x*\k2*(-1)^\d1}
\integer{y2=\y1+\y*\k2*(-1)^\d1}
\integer{e1=random(0..1)}
\integer{e2=random(0..1)}
\integer{x3=\x1+\x*\k3*(-1)^\d2+\e1*\x}
\integer{y3=\y1+\y*\k3*(-1)^\d2+\e2*\y}

\integer{d=(\x1-\x2)*(\y1-\y3)-(\x1-\x3)*(\y1-\y2)}


\text{b=\d=0?Oui:Non}
\text{m=\d=0?Non:Oui}
\statement{Les points \(A),\(B) et \(C), dont les coordonnées dans un repère donné sont 
respectivement \(\left( \x1 ,\y1 \right)), \(\left(\x2 , \y2\right)) et
 \(\left( \x3 , \y3 \right)) sont-ils alignés ?}



\choice{\(A), \(B) et \(C) sont alignés}{\b}{\m}

\solution{Le déterminant des vecteurs \(\overrightarrow{AB}) et \(\overrightarrow{AC}) est égal à \d.}
