val23=!exec pari print($t_)
t_=!rawmath ($val21^2+$val20^2-$val19^2)/(2*$val21*$val20)
val24=!exec pari print($t_)
val25=$[rint($val20^2+$val19^2-$val21^2)]
val26=$[rint(2*$val20*$val19)]
val27=\frac{$val25}{$val26}
val28=$[rint($val19^2+$val21^2-$val20^2)]
val29=$[rint(2*$val19*$val21)]
val30=\frac{$val28}{$val29}
val31=$[rint($val21^2+$val20^2-$val19^2)]
val32=$[rint(2*$val21*$val20)]
val33=\frac{$val31}{$val32}
val34=\(A B=$val19\),\(A C=$val20\),\(\cos (\widehat{B A C})=$val27),\(\cos (\widehat{C B A})),\(\cos (\widehat{A C B})),\(B C\),$val23,$val24,$val21,	\(A B=$val19\),\(B C=$val21\),\(\cos(\widehat{C B A})=$val30),\(\cos(\widehat{A C B})\),\(A C\),\(\cos(\widehat{B A C})),$val24,$val20,$val22,	\(A C=$val20\),\(B C=$val21\),\(\cos(\widehat{A C B})=$val33),\(\cos(\widehat{B A C})),\(\cos(\widehat{C B A})),\(A B\),$val22,$val23,$val19,	\(A B=$val19\),\(\cos(\widehat{B A C})=$val27),\(\cos(\widehat{C B A})=$val30),\(\cos(\widehat{A C B})),\(A C\),\(B C\),$val24,$val20,$val21,	\(B C=$val21\),\(\cos(\widehat{C B A})=$val30),\(\cos(\widehat{A C B})=$val33),\(A B\),\(A C\),\(\cos(\widehat{B A C})),$val19,$val20,$val22,	\(A C=$val20\),\(\cos(\widehat{B A C})=$val27),\(\cos(\widehat{A C B})=$val33),\(A B\),\(B C\),\(\cos(\widehat{C B A})),$val19,$val21,$val23,	
