!if $val13=5 
val39=$val39<br>	     puis \(\cos{\widehat{A C B}}=\frac{A C^2+B C^2-A B^2}{2\times A C \times B C}=)\($val24)
!endif
!endif
!if $val35=2 
val39=On calcule \(A C) par \(A C^2 = A B^2+B C^2-2 A B \times B C \times\cos{\widehat{A B C}}) d'où \(A C =$val20)<br>
!if $val13=4 
val39=$val39 <br>	      puis \(\cos{\widehat{A C B}}=\frac{A C^2+B C^2-A B^2}{2\times A C \times B C}=$val24\).
!endif
!if $val13=6 
val39=$val39<br>	     puis \(\cos{\widehat{B A C}}=\frac{A C^2+A B^2-B C^2}{2\times A C \times A B}=$val22).
!endif
!endif
!if $val35=3 
val39=On calcule \(A B) par \(A B^2 = A C^2+B C^2-2 A C \times B C times\cos{\widehat{B C A}}),	  d'où \(A B=$val19)<br>
!if $val13=4 
val39=$val39<br>	      puis \(\cos{\widehat{B A C}}=\frac{A C^2+A B^2-B C^2}{2\times A C \times A B}=$val22).
!endif
!if $val13=5 
val39=$val39<br>	     puis \(\cos{\widehat{C B A}}=\frac{B C^2+A B^2-A C^2}{2\times B C \times A B}=$val23).
!endif
!endif
!if $val35=4 
val39=On commence par calculer \(\sin{\widehat{B A C}}=\sqrt{1-\cos^2{\widehat{B A C}}})	    et \(\sin{\widehat{C B A}}=\sqrt{1-\cos^2{\widehat{C B A}}}).
!if $val13=4 
val39=$val39<br>	      On peut alors calculer	    \(\cos{\widehat{A C B}}=\cos{\widehat{B A C}}\times \sin{\widehat{C B A}}+	    \cos{\widehat{C B A}}\times \sin{\widehat{B A C}}=$val24\).
!endif
!if $val13=5 
val39=$val39<br>	    On utilise alors la loi des sinus:<br>	    \(A C=A B \times \frac{\sin{\widehat{A B C}}}{\sin{\widehat{A C B}}}=$val20).
!endif
!if $val13=6 
val39=$val39<br>	    On utilise alors la loi des sinus:<br>	    \(B C=A B \times \frac{\sin{\widehat{B A C}}}{\sin{\widehat{A C B}}}=$val21).
!endif
!endif
!if $val35=5 
val39=On commence par calculer \(\sin{\widehat{A C B}}=\sqrt{1-\cos^2{\widehat{A C B}}})	 et \(\sin{\widehat{C B A}}=\sqrt{1-\cos^2{\widehat{C B A}}})
!if $val13=6 
val39=$val39<br>	On peut alors calculer	\(\cos{\widehat{B A C}}=\cos{\widehat{A C B}}\times\sin{\widehat{C B A}}+	  \cos{\widehat{C B A}}\times\sin{\widehat{A C B}}=$val22\)
!endif
!if $val13=4 
val39=$val39<br>	  On utilise alors la loi des sinus:<br>	  \(A B=B C \times \frac{\sin{\widehat{B C A}}}{\sin{\widehat{B A C}}}=$val19)
!endif
!if $val13=5 
val39=$val39<br>	On utilise alors la loi des sinus:<br>	\(A C=B C \times \frac{\sin{\widehat{C B A}}}{\sin{\widehat{B A C}}}=$val20)
