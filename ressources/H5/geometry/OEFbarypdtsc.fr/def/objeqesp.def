!set title=Trouver l'équation de l'objet de l'espace
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefcss=<style> .enonce { margin:2% 2%; padding:1em;} </style> 

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
t_=!rawmath ($val8)/($val11)
val13=!exec pari print($t_)
t_=!rawmath ($val8)
val13=!exec pari print($t_)
t_=!rawmath ($val9)/($val12)
val14=!exec pari print($t_)
t_=!rawmath ($val9)
val14=!exec pari print($t_)
t_=!rawmath ($val10)
val15=!exec pari print($t_)
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val18=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val19=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val21=$[rint($(tmp0)*$(tmp1))]
!if $val16=$val17 and $val18=$val19 and $val20=$val21 
val17=$[rint($val17+1)]
val19=$[rint($val19-1)]
!endif
tmp0=!randint -5, 5

val22=$[rint($(tmp0))]
tmp0=!randint -5, 5

val23=$[rint($(tmp0))]

!ifval ($val22=0 and $val23=0)
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val24=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val24=$[rint($(tmp2))]
!endif
!if $val6==1 
val25=La sphère de centre \(\Omega($val13,$val14,$val15)\) et de rayon \(R=$val7\)
tmp=!translate ";': to $     $ in (x-$val13)^2+(y-$val14)^2+(z-$val15)^2-($val7)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
!endif
!if $val6==2 
val25=La sphère de diamètre &#91;\(AB\)&#93; avec \(A($val16,$val18,$val20)\) et \(B($val17,$val19,$val21)\)
tmp=!translate ";': to $     $ in (x-$val16)*(x-$val17)+(y-$val18)*(y-$val19)+(z-$val20)*(z-$val21)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
!endif
!if $val6==3 
val25=Le plan de vecteur normal \(\overrightarrow{n}($val22,$val24,$val23)\) et passant par le point \(A($val16,$val18,$val20)\)
tmp=!translate ";': to $     $ in ($val22)*(x-$val16)+($val24)*(y-$val18)+($val23)*(z-$val20)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
!endif
replytype1=equation
replyname1=Équation de l'objet
replygood1=!rawmath $val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	Déterminer l'équation de l'objet de l'espace suivant:	<div class="wimscenter">$val25.</div>	</div>	<div class="wims_question">	<label for="reply1">Votre réponse:</label>  
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=25
embedcnt=1
