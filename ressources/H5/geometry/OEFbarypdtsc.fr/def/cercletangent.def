!set title=Cercle tangent à une droite
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefcss=<style> .enonce { margin:2% 2%; padding:1em;} </style> 

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
t_=!rawmath ($val7)/($val9)
val11=!exec pari print($t_)
t_=!rawmath ($val7)
val11=!exec pari print($t_)
t_=!rawmath ($val8)/($val10)
val12=!exec pari print($t_)
t_=!rawmath ($val8)
val12=!exec pari print($t_)
tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($val11+$(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val14=$[rint($val12+$(tmp0)*$(tmp1))]
val15=$[rint($val13-($val11))]
val16=$[rint($val14-($val12))]
tmp=!translate ";': to $     $ in (x-($val13))*($val15)+(y-($val14))*($val16)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp=!translate ";': to $     $ in (x-($val13))*($val15)+(y-($val14))*($val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
tmp0=!replace internal x by ($val11) in $val18

val18=$(tmp0)
tmp0=!replace internal y by ($val12) in $val18

val18=$(tmp0)
tmp0=!replace internal * by \times in $val18

val18=$(tmp0)
val19=$[rint(($val11-($val13))*($val15)+($val12-($val14))*($val16))]
t_=!rawmath ($val19)^2/(($val15)^2+($val16)^2)
val19=!exec pari print($t_)
tmp=!translate ";': to $     $ in (x-$val11)^2+(y-$val12)^2-$val19=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=$(tmp0)
tmp=!translate ";': to $     $ in x-$val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=$(tmp0)
tmp=!translate ";': to $     $ in y-$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
!if ($val11=0 and $val12 !=0) 
val23=x^2+($val22)^2=$val19
!endif
!if ($val12=0 and $val11 !=0) 
val23=($val21)^2+y^2=$val19
!endif
!if ($val11=0 and $val12=0) 
val23=x^2+y^2=$val19
!endif
!if ($val11!= 0 and $val12!= 0) 
val23=($val21)^2+($val22)^2=$val19
!endif
val24=Le rayon du cercle est donné par la distance du centre \(\Omega\) à la droite \(\Delta\):<br>	\(R=d(\Omega,\Delta))=\(\frac{|$val18|}{\sqrt{($val15)^2+($val16)^2}})=\(\sqrt{$val19})<br>	L'équation du cercle est donc \((x-($val11))^2+(y-($val12))^2=$val19) ou encore \($val23).
replytype1=equation
replyname1=Équation de l'objet
replygood1=!rawmath $val20
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val24


!goto stat

!exit

:question
$()	<div class="enonce">	 Déterminer l'équation du cercle de centre 
!insmath \Omega($val11,$val12)
$()	 et tangent à la droite 
!insmath \,\Delta
$() d'équation 
!insmath $val17
$().	</div>		<div class="wims_question">	 <label for="reply1">Votre réponse:</label>  
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

