 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp=!trim cercle, une droite, deux droites, une hyperbole, une parabole
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim (Ox),(Oy)
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
t_=!rawmath ($val10)/($val12)
val14=!exec pari print($t_)
t_=!rawmath ($val10)
val14=!exec pari print($t_)
t_=!rawmath ($val11)/($val13)
val15=!exec pari print($t_)
t_=!rawmath ($val11)
val15=!exec pari print($t_)
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val18=$[rint($(tmp0))]
tmp0=!randint 1, 5

val19=$[rint($(tmp0))]
tmp0=!randint -5, 5

val20=$[rint($(tmp0))]
tmp0=!randint -5, 5

val21=$[rint($(tmp0))]
val22=$(val7[$val6])
t_=!rawmath $val14
val23=!exec pari print($t_)
t_=!rawmath $val15
val24=!exec pari print($t_)
t_=!rawmath $val9
val25=!exec pari print($t_)
val26=$val16
val27=$val17
t_=!rawmath $val18 / $val19
val28=!exec pari print($t_)
t_=!rawmath (-1)*$val28
val29=!exec pari print($t_)
val30=$val16
val31=$val17
val32=$val16
val33=-$val17
val34=($val14,$val15)
t_=!replace internal \( by ( in expand((x-$val14)^2-($val14)^2)
tmp0=!exec maxima $t_

val35=$(tmp0)
t_=!replace internal \( by ( in expand((y-$val15)^2-($val15)^2)
tmp0=!exec maxima $t_

val36=$(tmp0)
t_=!rawmath ($val14)^2+($val15)^2-($val9)^2
val37=!exec pari print($t_)
tmp0=!texmath $val37 - ($val14)^2+($val15)^2

val38=$(tmp0)
val39=x=$val14
val40=y=$val15
val41=($val14,$val15)
tmp0=!randint 1, 2

val42=$[rint($(tmp0))]
!if $val42=1 
val43=x=$val14
!else
val43=y=$val15
!endif
val44=($val14,$val15)
!if $val6==1 
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)^2+($val16)*(y-$val15)^2-($val16)*($val9)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val46=Préciser son centre et son rayon
val47=r2,r3,r4
!endif
!if $val6==2 
tmp=!translate ";': to $     $ in ($val16)*(x-$val20)+($val17)*(y-$val21)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val46=Preciser la pente de son vecteur normal
val47=r5,r6
!endif
!if $val6==3 
tmp=!translate ";': to $     $ in ($val16)^2*(x-$val14)^2-($val17)^2*(y-$val15)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val46=Preciser leurs vecteurs normaux, en commençant par celui de pente positif, ainsi que les coordonnées de leur point d'intersection
val47=r7,r8,r9,r10,r11
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)-($val17)*(y-$val15)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val48=$(tmp0)
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)+($val17)*(y-$val15)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val49=$(tmp0)
!endif
!if $val6==4 
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)*(y-$val15)-($val16)*($val9)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val46=Préciser les équations de ses asymptotes et les cordonnées de son centre de symétrie
val47=r12,r13,r14
val48=$val15+$val9/(x-$val14)
!endif
!if $val6==5 
!if $val42=1 
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)^2+($val17)*y -($val17)*($val15)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val48=y=$val15-($val16)*(x-$val14)^2/($val17)
!else
tmp=!translate ";': to $     $ in ($val17)*(y-$val15)^2+($val16)*x-($val16)*($val14)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val45=$(tmp0)
val48=x=$val14-($val17)*(y-$val15)^2/($val16)
!endif
val46=Préciser l'équation de son axe de symétrie et les coordonnées de son sommet
val47=r15,r16
!endif
val50=r1
dynsteps=yes
oefsteps=$val50 
nextstep=!nosubst $val50 
!readproc oef/steps.proc
