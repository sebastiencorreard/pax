:postdef

!ifval $m_step=2
val50=$val47
!else
val50=
!endif

!exit

:feedback
!ifval $m_reply1 notsametext $val22
 <div class='oef_feedbacks'>
!if $val6==1 
$()La présence de 
!insmath x^2
$() et 
!insmath y^2
$() du même côté du signe égal indique qu'il s'agit d'un cercle.	 
!endif
$()	
!if $val6==2 
$()L'équation ne contient pas de termes carrés 
!insmath x^2
$() ou 
!insmath y^2
$(), ni de terme produit 
!insmath x\times y
$(), elle est donc linéaire en 
!insmath x
$() et en 
!insmath y
$(): il s'agit d'une équation de droite.	 
!endif
$()	
!if $val6==3 
$()Les variables 
!insmath x^2
$()et 
!insmath y^2
$() sont réparties de part et	 d'autre du signe égal. Ceci indique qu'il s'agit de deux droites.	 
!endif
$()	
!if $val6==4 
$()La présence d'un terme produit 
!insmath x \times y
$() indique qu'il s'agit d'une hyperbole.	 
!endif
$()	
!if $val6==5 
$()	Il manque un terme carré, il s'agit donc d'une parabole:	  
!if $val42=1 
$()	   La présence du terme 
!insmath x^2
$() indique qu'il s'agit d'une parabole verticale.	    
!else
$()	    	   La présence du terme 
!insmath y^2
$() indique qu'il s'agit d'une parabole horizontale.	    
!endif
$()	 
!endif
$()	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply2 <> $val14
 <div class='oef_feedbacks'>Pour trouver l'abscisse du centre: On regroupe les termes en x et on fait apparaître le début d'un carré:<p>	
!insmath $val35
$()...=
!insmath (x-$val14)^2
$()....	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply3 <> $val15
 <div class='oef_feedbacks'>Pour trouver l'ordonnée du centre: On regroupe les termes en y et on fait apparaître le début d'un carré:<p>	
!insmath $val36
$()...=
!insmath (y-$val15)^2
$()....	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply4 <> $val9
 <div class='oef_feedbacks'>Pour calculer le rayon du cercle, on fait:<br>	
!insmath r^2
$()=$val38	
$()</div>
!endif
!ifval $val6==2 and $m_step==2 and $val51*($val27)-$val52*($val26)<>0
 <div class='oef_feedbacks'>L'abscisse du vecteur normal correspond au coefficient devant 
!insmath x
$(), son ordonnée correspond au coefficient devant 
!insmath y
$()
$()</div>
!endif
!ifval $val6==3 and $m_step==2 and (($val53*($val31)-$val54*($val30)<>0) or ($val55*($val33)-$val56*($val32)<>0))
 <div class='oef_feedbacks'>	Les deux équations de droites sont:<br>	
!insmath $val48
$() et 
!insmath $val49
$()<br>	Le vecteur normal de pente positif est donc ($val30,$val31).	
$()</div>
!endif
!ifval $val6==4 and $m_step==2 
 <div class='oef_feedbacks'>	L'équation canonique de l'hyperbole est:<br>	
!insmath y= $val48
$()<br>	Les équations des asymptotes sont donc $val39 et $val40.	Le centre de symétrie est le point d'intersection des asymptotes.	
$()</div>
!endif
!ifval $val6==5 and $m_step==2 and ($m_reply16 notsametext $val44 or $m_reply15 notsametext $val43)
 <div class='oef_feedbacks'>L'équation canonique de la parabole est:<br>	
!insmath $val48
$()<br>	L'équation de l'axe de symétrie est donc $val39 .	Le sommet se situe sur cet axe.	
$()</div>
!endif
!ifval ($val6==2 and $val51*($val27)-$val52*($val26)=0)
 <div class='oef_feedbacks'>vecteur normal: <span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif
!ifval ($val6==3 and $val53*($val31)-$val54*($val30)=0)
 <div class='oef_feedbacks'>vecteur normal 1:<span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif
!ifval ($val6==3 and $val55*($val33)-$val56*($val32)=0)
 <div class='oef_feedbacks'>vecteur normal 2:<span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif

!exit

