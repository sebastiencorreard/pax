!set title=Objets du plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefcss=<style> .enonce { margin:2% 2%; padding:1em;} </style> 

ansorder=r,r,r,r,r,r,r,r,r,r,r
varcnt=50
prevarcnt=48
postvarcnt=1
replycnt=11
choicecnt=0
conditioncnt=3
feedbackcnt=9
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,1,1,1,1,1,2,2,2,3,3

val6=$[rint($(tmp0))]
tmp=!trim cercle, une droite, deux droites
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim (O x),(O y)
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
t_=!rawmath ($val10)/($val12)
val14=!exec pari print($t_)
t_=!rawmath ($val10)
val14=!exec pari print($t_)
t_=!rawmath ($val11)/($val13)
val15=!exec pari print($t_)
t_=!rawmath ($val11)
val15=!exec pari print($t_)
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val18=$[rint($(tmp0))]
tmp0=!randint 1, 5

val19=$[rint($(tmp0))]
tmp0=!randint -5, 5

val20=$[rint($(tmp0))]
tmp0=!randint -5, 5

val21=$[rint($(tmp0))]
val22=$(val7[$val6])
t_=!rawmath $val14
val23=!exec pari print($t_)
t_=!rawmath $val15
val24=!exec pari print($t_)
t_=!rawmath $val9
val25=!exec pari print($t_)
val26=$val16
val27=$val17
t_=!rawmath $val18 / $val19
val28=!exec pari print($t_)
t_=!rawmath (-1)*$val28
val29=!exec pari print($t_)
val30=$val16
val31=$val17
val32=$val16
val33=-$val17
val34=($val14,$val15)
t_=!replace internal \( by ( in expand((x-$val14)^2-($val14)^2)
tmp0=!exec maxima $t_

val35=$(tmp0)
t_=!replace internal \( by ( in expand((y-$val15)^2-($val15)^2)
tmp0=!exec maxima $t_

val36=$(tmp0)
t_=!rawmath ($val14)^2+($val15)^2-($val9)^2
val37=!exec pari print($t_)
tmp0=!texmath $val37 - ($val14)^2+($val15)^2

val38=$(tmp0)
!if $val6==1 
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)^2+($val16)*(y-$val15)^2-($val16)*($val9)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val39=$(tmp0)
val40=Préciser son centre et son rayon
val41=r2,r3,r4
!endif
!if $val6==2 
tmp=!translate ";': to $     $ in ($val16)*(x-$val20)+($val17)*(y-$val21)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val39=$(tmp0)
val40=Preciser la pente de son vecteur normal
val41=r5,r6
!endif
!if $val6==3 
tmp=!translate ";': to $     $ in ($val16)^2*(x-$val14)^2-($val17)^2*(y-$val15)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val39=$(tmp0)
val40=Preciser leurs vecteurs normaux, en commençant par celui de pente positif, ainsi que les coordonnées de leur point d'intersection
val41=r7,r8,r9,r10,r11
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)-($val17)*(y-$val15)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val42=$(tmp0)
tmp=!translate ";': to $     $ in ($val16)*(x-$val14)+($val17)*(y-$val15)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val43=$(tmp0)
!endif
val44=r1
dynsteps=yes
oefsteps=$val44 
nextstep=!nosubst $val44 
!readproc oef/steps.proc
replytype1=menu
replyname1=nature
replygood1=$val6;$val7
replytype2=numeric
replyname2=abscisse du centre
replygood2=$[$val23]
replytype3=numeric
replyname3=ordonnée du centre
replygood3=$[$val24]
replytype4=numeric
replyname4=rayon du cercle
replygood4=$[$val25]
replytype5=numeric
replyname5=abscisse du vecteur normal de la droite
replygood5=?analyze 45
replytype6=numeric
replyname6=ordonnée du vecteur normal de la droite
replygood6=?analyze 46
replytype7=numeric
replyname7=abscisse du vecteur normal 1
replygood7=?analyze 47
replytype8=numeric
replyname8=ordonnée du vecteur normal 1
replygood8=?analyze 48
replytype9=numeric
replyname9=abscisse du vecteur normal 2
replygood9=?analyze 49
replytype10=numeric
replyname10=ordonnée du vecteur normal 2
replygood10=?analyze 50
replytype11=vector
replyname11=point d'intersection
replygood11=$val34
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	On considère un objet du plan donné par son équation :	<div class="wimscenter"> 
!insmath $val39
$().</div>	</div>	<div class="wims_question">	
!if $m_step=1 
$()	Quelle est la nature de cet objet:  
!read oef/embed.phtml r1 
$() 
!else
$()	 $val40 
!endif
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef

!ifval $m_step=2
val44=$val41
!else
val44=
!endif

!exit

:feedback
!ifval $m_reply1 notsametext $val22
 <div class='oef_feedbacks'>
!if $val6==1 
$()	La présence de 
!insmath x^2
$() et 
!insmath y^2
$() du même côté du signe égal indique qu'il s'agit d'un cercle.	 
!endif
$()	
!if $val6==2 
$()	L'équation ne contient pas de termes carrés 
!insmath x^2
$() ou 
!insmath y^2
$(), ni de terme produit 
!insmath x\times y
$(),	elle est donc linéaire en 
!insmath x
$() et en 
!insmath y
$(): il s'agit d'une équation de droite.	 
!endif
$()	
!if $val6==3 
$()	Les variables 
!insmath x^2
$()et 
!insmath y^2
$() sont réparties de part et d'autre du signe égal.	Ceci indique qu'il s'agit de deux droites.	 
!endif
$()	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply2 <> $val14
 <div class='oef_feedbacks'>Pour trouver l'abscisse du centre: On regroupe les termes en x et on fait apparaître le début d'un carré:<p>	
!insmath $val35
$()...=
!insmath (x-$val14)^2
$()....	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply3 <> $val15
 <div class='oef_feedbacks'>Pour trouver l'ordonnée du centre: On regroupe les termes en y et on fait apparaître le début d'un carré:<p>	
!insmath $val36
$()...=
!insmath (y-$val15)^2
$()....	
$()</div>
!endif
!ifval $val6==1 and $m_step==2 and $m_reply4 <> $val9
 <div class='oef_feedbacks'>Pour calculer le rayon du cercle, on fait :<br>	
!insmath r^2
$()=
!insmath $val38
$()	
$()</div>
!endif
!ifval $val6==2 and $m_step==2 and $val45*($val27)-$val46*($val26)<>0
 <div class='oef_feedbacks'>L'abscisse du vecteur normal correspond au coefficient devant 
!insmath x
$(), son ordonnée correspond au coefficient devant 
!insmath y
$()
$()</div>
!endif
!ifval $val6==3 and $m_step==2 and (($val47*($val31)-$val48*($val30)<>0) or ($val49*($val33)-$val50*($val32)<>0))
 <div class='oef_feedbacks'>	Les deux équations de droites sont:<br>	
!insmath $val42
$() et 
!insmath $val43
$()<br>	Le vecteur normal de pente positif est donc ($val30,$val31).	
$()</div>
!endif
!ifval ($val6=2 and $val45*($val27)-$val46*($val26)=0)
 <div class='oef_feedbacks'>vecteur normal: <span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif
!ifval ($val6=3 and $val47*($val31)-$val48*($val30)=0)
 <div class='oef_feedbacks'>vecteur normal 1: <span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif
!ifval ($val6=3 and $val49*($val33)-$val50*($val32)=0)
 <div class='oef_feedbacks'>vecteur normal 2: <span class="oef_indgood"> bonne réponse</span>
$()</div>
!endif

!exit

:test
condoption1=hide 

!ifval ($val6=2 and $val45*($val27)-$val46*($val26)=0) or $val6!=2
 condtest1=1
!else
 condtest1=0
!endif
condname1=vecteur normal
condoption2=hide 

!ifval ($val6=3 and $val47*($val31)-$val48*($val30)=0) or $val6!=3
 condtest2=1
!else
 condtest2=0
!endif
condname2=vecteur normal 1
condoption3=hide 

!ifval ($val6=3 and $val49*($val33)-$val50*($val32)=0) or $val6!=3
 condtest3=1
!else
 condtest3=0
!endif
condname3=vecteur normal 2

!exit

:stat
vsavelist=6,9,14,15,22,26,27,30,31,32,33,35,36,38,39,40,41,42,43,45,46,47,48,49,50
