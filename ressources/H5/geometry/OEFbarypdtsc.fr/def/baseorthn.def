replyname2=ordonnée de u
replygood2=?analyze 43
replyname3=abscisse de v
replygood3=?analyze 44
replyname4=ordonnée de v
replygood4=?analyze 45
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst  $val41


