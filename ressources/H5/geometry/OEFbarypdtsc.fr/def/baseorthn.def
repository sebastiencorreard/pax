tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
!readproc slib/matrix/orthogonal 2,2 
tmp0=$slib_out
tmp=!trim $(tmp0)
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val7[1;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val7[2;])
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val10=$[rint($(tmp0))]
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in print([$val8]*$val10+[$val9]*$val11)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val8]*$val11-[$val9]*$val10)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val7=!translate internal $	\
$ to ;; in $tmp
val13=$[sqrt($val10^2+$val11^2)]
t_=!replace internal \( by ( in print([$val12]/$val13)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val14=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val7]/$val13)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val15=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val14]*(-1))
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val16=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in print([$val15]*(-1))
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
val18=$(val14[1])
val19=$(val15[1])
val20=$(val14[2])
val21=$(val15[2])
val22=$(val16[1])
val23=$(val17[1])
val24=$(val16[2])
val25=$(val17[2])
val26=$[rint(($(val14[1]))^2+($(val14[2]))^2)]
val27=$[($(val15[1]))^2+($(val15[2]))^2]
val28=$[rint(($val10)^2+($val11)^2)]
tmp=!translate ";': to $     $ in 1/sqrt(($val10)^2+($val11)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val29=$(tmp1)
tmp0=!texmath $val29

val30=$(tmp0)
tmp=!translate ";': to $     $ in $(val12[1])/sqrt(($val10)^2+($val11)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val31=$(tmp1)
tmp0=!texmath $val31

val32=$(tmp0)
tmp=!translate ";': to $     $ in $(val12[2])/sqrt(($val10)^2+($val11)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val33=$(tmp1)
tmp0=!texmath $val33

val34=$(tmp0)

!ifval (abs($(val14[1]))<0.001)
val35=0
!else
tmp=!translate ";': to $     $ in -($(val12[2]))/ ($(val12[1]))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val35=$(tmp1)
!endif
tmp0=!texmath $val35

val36=$(tmp0)
tmp=!translate ";': to $     $ in 1/sqrt(($val35)^2+1)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val37=$(tmp1)
tmp0=!texmath $val37

val38=$(tmp0)
tmp=!translate ";': to $     $ in -($(val12[2]))/ ($(val12[1]))*1/sqrt(($val35)^2+1)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val39=$(tmp1)
tmp0=!texmath $val39

val40=$(tmp0)
val41=\(\overrightarrow{u}\) est colinéaire à \( \overrightarrow{U} \left(\begin{array}{c}$(val12[1])\\	  $(val12[2])\end{array} \right) \Longrightarrow \overrightarrow{u}= k \overrightarrow{U}, k \in \mathbb{R}  \Longrightarrow	  \overrightarrow{u}\left(\begin{array}{c}$(val12[1]) k \\ $(val12[2])k  \end{array}	 \right),k \in \mathbb{R}\).	<p>Or \(\overrightarrow{u}\) est un vecteur unitaire donc on a :	<br>\(|| \overrightarrow{u} ||  =1  \Longrightarrow || \overrightarrow{u} ||^2  =1 \Longleftrightarrow	($(val12[1]) k)^2+($(val12[2]) k )^2=1  \Longrightarrow k = $val30 \Longrightarrow  \overrightarrow{u}	\left(\begin{array}{c} $val32 \\ $val34  \end{array} \right)\).	</p><p>	\(\overrightarrow{u}\) et \(\overrightarrow{v}\) constituent une base orthonormale donc on a:	<br>	\(\overrightarrow{u}\cdot \overrightarrow{v}=0 \Longleftrightarrow \left(\begin{array}{c} $(val12[1]) k\\	  $(val12[2]) k\end{array} \right) \cdot \left(\begin{array}{c} v_x \\ v_y \end{array} \right)=0 \Longleftrightarrow	k( $(val12[1]) v_x +   $(val12[2]) v_y ) =0 \Longrightarrow v_x=$val36 v_y \).	</p><p>	Or \(\overrightarrow{v}\) est un vecteur unitaire donc on a :	<br>\(|| \overrightarrow{v} ||  = 1  \Longrightarrow || \overrightarrow{v} ||^2  =1 \Longleftrightarrow	($val36 v_y)^2+(v_y )^2=1  \Longrightarrow v_y = $val38 \Longrightarrow  \overrightarrow{v}	\left(\begin{array}{c} $val40 \\ $val38  \end{array} \right)\).	</p>
replyname1=abscisse de u
