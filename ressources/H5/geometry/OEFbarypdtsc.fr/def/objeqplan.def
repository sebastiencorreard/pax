!set title=Trouver l'équation de l'objet du plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefcss=<style> .enonce { margin:2% 2%; padding:1em;} </style> 

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
t_=!rawmath ($val8)/($val10)
val12=!exec pari print($t_)
t_=!rawmath ($val8)
val12=!exec pari print($t_)
t_=!rawmath ($val9)/($val11)
val13=!exec pari print($t_)
t_=!rawmath ($val9)
val13=!exec pari print($t_)
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val17=$[rint($(tmp0)*$(tmp1))]
!if $val14=$val15 and $val16=$val17 
val15=$[rint($val15+1)]
val17=$[rint($val17-1)]
!endif
tmp0=!randint -5, 5

val18=$[rint($(tmp0))]

!ifval $val18=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val19=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val19=$[rint($(tmp2))]
!endif
val20=$[rint($val19)]
val21=$[rint(-$val18)]
!if $val6==1 
val22=Le cercle de centre \(\Omega($val12,$val13)\) et de rayon \(R=$val7\)
tmp=!translate ";': to $     $ in (x-$val12)^2+(y-$val13)^2-($val7)^2=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
!endif
!if $val6==2 
val22=Le cercle de diamètre &#91;\(AB\)&#93; avec \(A($val14,$val16)\) et \(B($val15,$val17)\)
tmp=!translate ";': to $     $ in (x-$val14)*(x-$val15)+(y-$val16)*(y-$val17)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
!endif
!if $val6==3 
val22=La droite  de vecteur directeur \(\overrightarrow{u}($val20,$val21)\) et passant par le point \(A($val14,$val16)\)
tmp=!translate ";': to $     $ in ($val21)*(x-$val14)-($val20)*(y-$val16)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
!endif
!if $val6==4 
val22=La droite  de vecteur normal \(\overrightarrow{n}($val18,$val19)\) et passant par le point \(A($val14,$val16)\)
tmp=!translate ";': to $     $ in ($val18)*(x-$val14)+($val19)*(y-$val16)=0

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
!endif
replytype1=equation
replyname1=Équation de l'objet
replygood1=!rawmath $val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce">	Déterminer l'équation de l'objet du plan suivant:	<div class="wimscenter">$val22.</div>	</div>	<div class="wims_question">	<label for="reply1">Votre réponse:</label>  
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=22
embedcnt=1
