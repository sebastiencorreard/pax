\title{Base orthonormale}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}

## k=1 alignés, k=2 non alignés
\integer{k=randint(1..2)}

** donnée de trois vecteurs indépendants
\matrix{V=slib(matrix/orthogonal 2,2)}

\matrix{s=\V[1;]}
\matrix{t=\V[2;]}
\integer{a=random(1..5)}
\integer{b=random(1..5)}
\matrix{U=pari(print([\s]*\a+[\t]*\b))}
\matrix{V=pari(print([\s]*\b-[\t]*\a))}
\real{n=sqrt(\a^2+\b^2)}
\matrix{u=pari(print([\U]/\n))}
\matrix{v=pari(print([\V]/\n))}

\matrix{u2=pari(print([\u]*(-1)))}
\matrix{v2=pari(print([\v]*(-1)))}
\text{grep1x=\u[1]}
\text{grep2x=\v[1]}
\text{grep1y=\u[2]}
\text{grep2y=\v[2]}
\text{g2rep1x=\u2[1]}
\text{g2rep2x=\v2[1]}
\text{g2rep1y=\u2[2]}
\text{g2rep2y=\v2[2]}
\integer{verifu=(\u[1])^2+(\u[2])^2}
\real{verifv=(\v[1])^2+(\v[2])^2}

\integer{varsol1=(\a)^2+(\b)^2}
\text{varsol11=maxima(simplify(1/sqrt((\a)^2+(\b)^2)))}
\text{varsol111=texmath(\varsol11)}

\text{varsol22=maxima(simplify(\U[1]/sqrt((\a)^2+(\b)^2)))}
\text{varsol222=texmath(\varsol22)}

\text{varsol33=maxima(simplify(\U[2]/sqrt((\a)^2+(\b)^2)))}
\text{varsol333=texmath(\varsol33)}

\text{varsol4=(abs(\u[1])<0.001)?0:maxima(simplify(-(\U[2])/ (\U[1])))}
\text{varsol44=texmath(\varsol4)}

\text{varsol5=maxima(simplify(1/sqrt((\varsol4)^2+1)))}
\text{varsol55=texmath(\varsol5)}

\text{varsol6=maxima(simplify(-(\U[2])/ (\U[1])*1/sqrt((\varsol4)^2+1)))}
\text{varsol66=texmath(\varsol6)}

## integer{a=random(1..10)}
#### matrix{U= pari(print([\u]*\a))}
\text{textsol=\(\overrightarrow{u}\) est colinéaire à \( \overrightarrow{U} \left(\begin{array}{c}\U[1]\\
  \U[2]\end{array} \right) \Longrightarrow \overrightarrow{u}= k \overrightarrow{U}, k \in \mathbb{R}  \Longrightarrow
  \overrightarrow{u}\left(\begin{array}{c}\U[1] k \\ \U[2]k  \end{array}
 \right),k \in \mathbb{R}\).
<p>Or \(\overrightarrow{u}\) est un vecteur unitaire donc on a :
<br>\(|| \overrightarrow{u} ||  =1  \Longrightarrow || \overrightarrow{u} ||^2  =1 \Longleftrightarrow
(\U[1] k)^2+(\U[2] k )^2=1  \Longrightarrow k = \varsol111 \Longrightarrow  \overrightarrow{u}
\left(\begin{array}{c} \varsol222 \\ \varsol333  \end{array} \right)\).
</p><p>
\(\overrightarrow{u}\) et \(\overrightarrow{v}\) constituent une base orthonormale donc on a:
<br>
\(\overrightarrow{u}\cdot \overrightarrow{v}=0 \Longleftrightarrow \left(\begin{array}{c} \U[1] k\\
  \U[2] k\end{array} \right) \cdot \left(\begin{array}{c} v_x \\ v_y \end{array} \right)=0 \Longleftrightarrow
k( \U[1] v_x +   \U[2] v_y ) =0 \Longrightarrow v_x=\varsol44 v_y \).
</p><p>
Or \(\overrightarrow{v}\) est un vecteur unitaire donc on a :
<br>\(|| \overrightarrow{v} ||  = 1  \Longrightarrow || \overrightarrow{v} ||^2  =1 \Longleftrightarrow
(\varsol44 v_y)^2+(v_y )^2=1  \Longrightarrow v_y = \varsol55 \Longrightarrow  \overrightarrow{v}
\left(\begin{array}{c} \varsol66 \\ \varsol55  \end{array} \right)\).
</p>}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
Déterminer les cordonnées des vecteurs \(\overrightarrow{u}) et \(\overrightarrow{v}),
 tels que:
<ol>
<li>\(\overrightarrow{u}) soit colinéaire à \(\overrightarrow{U} \left(\begin{array}{c}\U[1]\\ \U[2]\end{array}\right))
</li><li>
\(\overrightarrow{u}) et \(\overrightarrow{v}) constituent une base orthonormale.
</li></ol>
</div>
<div class="wims_question">
<ul><li>
<label for="reply1">\(\overrightarrow{u})</label> = (\embed{reply1, 7};\embed{reply2,7})
</li><li>
<label for="reply3">\(\overrightarrow{v})</label> = (\embed{reply3, 7};\embed{reply4,7})
</li>
</ul>
</div>
<div class="wims_instruction">
<h2>Aide à la saisie</h2>
<p>
Pour saisir une racine carrée, taper sqrt(..), ex pour \(\frac{\sqrt{2}}{2}),
taper <span class="tt">sqrt(2)/2</span>.
</p>
</div>
}

\answer{abscisse de u}{\rep1x}{\type=numexp}
\answer{ordonnée de u}{\rep1y}{\type=numexp}
\answer{abscisse de v}{\rep2x}{\type=numexp}
\answer{ordonnée de v}{\rep2y}{\type=numexp}
\condition{vecteur u}{(\rep1x=\grep1x and \rep1y=\grep1y) or (\rep1x=\g2rep1x and \rep1y=\g2rep1y)}
\condition{vecteur v}{(\rep2x=\grep2x and \rep2y=\grep2y) or (\rep2x=\g2rep2x and \rep2y=\g2rep2y)}
\solution{
\textsol}
