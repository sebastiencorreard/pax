\title{Changement de base dans le plan}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}

## k=1 alignés, k=2 non alignés
\integer{k=randint(1..2)}

** donnée de trois vecteurs indépendants
\matrix{V=slib(matrix/orthogonal 2,5)}


\matrix{u=\V[1;]}
\matrix{v=\V[2;]}
\if{\u[1]=0 or \u[2]=0}
{\matrix{u=pari(print([3/5,4/5]))}
\matrix{v=pari(print([4/5,-3/5]))}
}
\integer{a=random(-5..5)}
\integer{b=\a=0?random(1..5)*random(1,-1):random(-5,5)}
\matrix{w= pari(print([\u]*(\a)+ [\v]*(\b)))}
\integer{pdt=\u[1]*\v[1]+\u[2]*\v[2]}
\integer{k=\pdt=0?1:2}

 \text{textsol=La base \( (\overrightarrow{e_1},\overrightarrow{e_1})) étant orthonormale, les coordonnées dans la nouvelle base s'obtiennent à l'aide du produit scalaire par la formule:<br>
\(\overrightarrow{u})= \((\overrightarrow{u}| \overrightarrow{e_1})\overrightarrow{e_1}+(\overrightarrow{u}| \overrightarrow{e_2})\overrightarrow{e_2})<br>
Soit \(\overrightarrow{u})= \(((\w[1])\times (\u[1])+(\w[2])\times (\u[2]))\overrightarrow{e_1})<br>
\(+((\w[1])\times (\v[1])+(\w[2])\times (\v[2]))\overrightarrow{e_2})<br>
\(=\a \overrightarrow{e_1}+(\b) \overrightarrow{e_2})
}
\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
On considère trois vecteurs \(\overrightarrow{e_1}),\(\overrightarrow{e_2}) et
 \(\overrightarrow{u}) dont les coordonnées dans la base canonique
 \((\overrightarrow{i},\overrightarrow{j})) sont respectivement:
 <div class="wimscenter">
 \(\overrightarrow{e_1}\left(\begin{array}{c} \u[1] \\
 \u[2] \end{array}\right)) ,\(\overrightarrow{e_2}\left(\begin{array}{c} \v[1] \\ \v[2]\end{array}\right)) et
 \(\overrightarrow{u}\left(\begin{array}{c} \w[1] \\ \w[2] \end{array}\right)).
 </div></div>
<div class="wims_question">
Donner les cordonnées du vecteur \(\overrightarrow{u})
dans la base \((\overrightarrow{e_1},\overrightarrow{e_2})).
<div class="wimscenter">
<label for="reply1">\(\overrightarrow{u})=</label>
\embed{reply1,4}\(\overrightarrow{e_1})+\embed{reply2,4}<label for="reply2">\(\overrightarrow{e_2})
</label>.
</div>
</div>
}

\answer{abscisse}{\a}{type=numeric}
\answer{ordonnée}{\b}{type=numeric}
\solution{\textsol}
