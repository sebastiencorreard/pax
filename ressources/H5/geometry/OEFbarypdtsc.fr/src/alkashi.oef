\title{Autour du théorème d'Al-Kashi}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{coeflst=1/6,1/4,1/3,1/2,2/3,3/4,5/6,1}
\text{valcoslst=sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1}
\text{tvalcoslst=\frac{\sqrt{3}}{2},\frac{\sqrt(2)}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt(2)}{2},-\frac{\sqrt(3)}{2},-1}
\integer{nu=random(1..10)}
\rational{nu=\nu /random(1,1,1,2,2,3)}
\integer{nv=random(1..10)}
\rational{nv= \nv/random(1,1,1,2,2,3)}
\text{tnu=\nu}
\text{tnu=wims(replace internal / by , in \tnu)}
\text{tnu=items(\tnu)=1?\tnu:\frac{\tnu[1]}{\tnu[2]}}
\text{tnv=\nv}
\text{tnv=wims(replace internal / by , in \tnv)}
\text{tnv=items( \tnv)=1?\tnv:\frac{\tnv[1]}{\tnv[2]}}

\integer{ind=random(1..8)}
\real{pdt=\nu*\nv*\valcoslst[\ind]}
\text{signang=random( ,-)}

\text{tcoef=\coeflst[\ind]}
\text{tcoef=wims(replace internal / by , in \tcoef)}
\text{num=\tcoef[1]=1?\pi:\tcoef[1] \pi}
\text{num=\tcoef[1]=-1?-\pi}
\text{tcoef=items(\tcoef)=1?\num:\frac{\num}{\tcoef[2]}}
\text{quest=\overrightarrow{u} \cdot \overrightarrow{v} }

\integer{c=random(5..20)}
\integer{b=random(\c..\c+10)}
\integer{a=random(\b..\b+\c)}
\rational{csa=(\b^2+\c^2-\a^2)/(2*\b*\c)}
\rational{csb=(\c^2+\a^2-\b^2)/(2*\c*\a)}
\rational{csc=(\a^2+\b^2-\c^2)/(2*\a*\b)}

\\Amélioration affichage latex
\integer{ncsa=\b^2+\c^2-\a^2}
\integer{dcsa=2*\b*\c}
\text{tcsa=\frac{\ncsa}{\dcsa}}

\integer{ncsb=\c^2+\a^2-\b^2}
\integer{dcsb=2*\c*\a}
\text{tcsb=\frac{\ncsb}{\dcsb}}

\integer{ncsc=\a^2+\b^2-\c^2}
\integer{dcsc=2*\a*\b}
\text{tcsc=\frac{\ncsc}{\dcsc}}

\text{questlst=\(A B=\c\),\(A C=\b\),\(\cos (\widehat{B A C})=\tcsa),\(\cos (\widehat{C B A})),\(\cos (\widehat{A C B})),\(B C\),\csb,\csc,\a,
\(A B=\c\),\(B C=\a\),\(\cos(\widehat{C B A})=\tcsb),\(\cos(\widehat{A C B})\),\(A C\),\(\cos(\widehat{B A C})),\csc,\b,\csa,
\(A C=\b\),\(B C=\a\),\(\cos(\widehat{A C B})=\tcsc),\(\cos(\widehat{B A C})),\(\cos(\widehat{C B A})),\(A B\),\csa,\csb,\c,
\(A B=\c\),\(\cos(\widehat{B A C})=\tcsa),\(\cos(\widehat{C B A})=\tcsb),\(\cos(\widehat{A C B})),\(A C\),\(B C\),\csc,\b,\a,
\(B C=\a\),\(\cos(\widehat{C B A})=\tcsb),\(\cos(\widehat{A C B})=\tcsc),\(A B\),\(A C\),\(\cos(\widehat{B A C})),\c,\b,\csa,
\(A C=\b\),\(\cos(\widehat{B A C})=\tcsa),\(\cos(\widehat{A C B})=\tcsc),\(A B\),\(B C\),\(\cos(\widehat{C B A})),\c,\a,\csb,
}
\\Fin amélioration affichage latex
\integer{jj=random(1..6)}
\text{donnee=row(\jj,\questlst)}
\text{datatriangle=\donnee[1], \donnee[2] et \donnee[3]}
\integer{ind=random(4..6)}
\text{quest=\donnee[\ind]}
\text{rep=\donnee[\ind+3]}
\if{\jj=1}{
  \text{textsol=On calcule \(B C) par \(B C^2 = A C^2+A B^2-2 A C \times A B\times\cos{\widehat{B A C}}) d'où \(B C =\a)<br>}
  \if{\ind=4}{
     \text{textsol=\textsol<br>
     puis \(\cos{\widehat{C B A}}=\frac{A B^2+B C^2-A C^2}{2\times A B \times B C}=\csb)}
     }
  \if{\ind=5}{
     \text{textsol=\textsol<br>
     puis \(\cos{\widehat{A C B}}=\frac{A C^2+B C^2-A B^2}{2\times A C \times B C}=)\(\csc)}
  }
}
\if{\jj=2}{
  \text{textsol=On calcule \(A C) par \(A C^2 = A B^2+B C^2-2 A B \times B C \times\cos{\widehat{A B C}}) d'où \(A C =\b)<br>}
  \if{\ind=4}{
    \text{textsol=\textsol <br>
      puis \(\cos{\widehat{A C B}}=\frac{A C^2+B C^2-A B^2}{2\times A C \times B C}=\csc\).}
    }
  \if{\ind=6}{
    \text{textsol=\textsol<br>
     puis \(\cos{\widehat{B A C}}=\frac{A C^2+A B^2-B C^2}{2\times A C \times A B}=\csa).}
  }
}
\if{\jj=3}{
  \text{textsol=On calcule \(A B) par \(A B^2 = A C^2+B C^2-2 A C \times B C times\cos{\widehat{B C A}}),
  d'où \(A B=\c)<br>}
  \if{\ind=4}{
      \text{textsol=\textsol<br>
      puis \(\cos{\widehat{B A C}}=\frac{A C^2+A B^2-B C^2}{2\times A C \times A B}=\csa).}
  }
  \if{\ind=5}{
    \text{textsol=\textsol<br>
     puis \(\cos{\widehat{C B A}}=\frac{B C^2+A B^2-A C^2}{2\times B C \times A B}=\csb).}
  }
}
\if{\jj=4}{
  \text{textsol=On commence par calculer \(\sin{\widehat{B A C}}=\sqrt{1-\cos^2{\widehat{B A C}}})
    et \(\sin{\widehat{C B A}}=\sqrt{1-\cos^2{\widehat{C B A}}}).}
  \if{\ind=4}{
     \text{textsol=\textsol<br>
      On peut alors calculer
    \(\cos{\widehat{A C B}}=\cos{\widehat{B A C}}\times \sin{\widehat{C B A}}+
    \cos{\widehat{C B A}}\times \sin{\widehat{B A C}}=\csc\).}
  }
  \if{\ind=5}{
    \text{textsol=\textsol<br>
    On utilise alors la loi des sinus:<br>
    \(A C=A B \times \frac{\sin{\widehat{A B C}}}{\sin{\widehat{A C B}}}=\b).}
  }
  \if{\ind=6}{
     \text{textsol=\textsol<br>
    On utilise alors la loi des sinus:<br>
    \(B C=A B \times \frac{\sin{\widehat{B A C}}}{\sin{\widehat{A C B}}}=\a).}
  }
}
\if{\jj=5}{
  \text{textsol=On commence par calculer \(\sin{\widehat{A C B}}=\sqrt{1-\cos^2{\widehat{A C B}}})
 et \(\sin{\widehat{C B A}}=\sqrt{1-\cos^2{\widehat{C B A}}})}
  \if{\ind=6}{
    \text{textsol=\textsol<br>
On peut alors calculer
\(\cos{\widehat{B A C}}=\cos{\widehat{A C B}}\times\sin{\widehat{C B A}}+
  \cos{\widehat{C B A}}\times\sin{\widehat{A C B}}=\csa\)}
  }
  \if{\ind=4}{
    \text{textsol=\textsol<br>
  On utilise alors la loi des sinus:<br>
  \(A B=B C \times \frac{\sin{\widehat{B C A}}}{\sin{\widehat{B A C}}}=\c)}
  }
  \if{\ind=5}{
    \text{textsol=\textsol<br>
On utilise alors la loi des sinus:<br>
\(A C=B C \times \frac{\sin{\widehat{C B A}}}{\sin{\widehat{B A C}}}=\b)}
  }
}
\if{\jj=6}{
  \text{textsol=On commence par calculer \(\sin{\widehat{A C B}}=\sqrt{1-\cos^2{\widehat{A C B}}})
 et \(\sin{\widehat{B A C}}=\sqrt{1-\cos^2{\widehat{B A C}}})}
  \if{\ind=6}{
    \text{textsol=\textsol<br>
On peut alors calculer \(\cos{\widehat{C B A}}
\times\cos{\widehat{A C B}}\times\sin{\widehat{B A C}}+\cos{\widehat{B A C}}\times
\sin{\widehat{A C B}}=\csb\)}
  }
  \if{\ind=4}{
    \text{textsol=\textsol<br>
On utilise alors la loi des sinus:<br>
\(A B=A C \times \frac{\sin{\widehat{B C A}}}{\sin{\widehat{C B A}}}=\c)}
  }
  \if{\ind=5}{
    \text{textsol=\textsol<br>
On utilise alors la loi des sinus:<br>
\(B C=A C \times \frac{\sin{\widehat{B A C}}}{\sin{\widehat{CBA}}}=\a)}
  }
}
