## identifiants de l'exercice: titre, auteur, format
\title{Objets du plan II}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{k=random(1..5)}
**** integer{k=2}
\matrix{oliste= cercle, une droite, deux droites, une hyperbole, une parabole}
\matrix{axeliste= (Ox),(Oy)}
\integer{r=random(1..5)}
\integer{x=random(-5..5)}
\integer{y=random(-5..5)}
\integer{d1=random(1..3)}
\integer{d2=random(1..3)}
\rational{xc=(\x)/(\d1)}
\rational{xc=(\x)}
\rational{yc=(\y)/(\d2)}
\rational{yc=(\y)}
\integer{r=random(1..5)}
\integer{a=random(1..5)*random(1,-1)}
\integer{b=random(1..5)*random(1,-1)}
\integer{c=random(1..5)}
\integer{d=random(1..5)}
\integer{e=random(-5..5)}
\integer{f=random(-5..5)}
**** Réponses ****
\text{rep1=\oliste[\k]}
**** Pour le cercle *****
\rational{rep2=\xc}
\rational{rep3=\yc}
\rational{rep4=\r}
**** Pour la droite *****
\text{rep51=\a}
\text{rep61=\b}
**** Pour les deux droites *****
\rational{pentep=\c / \d}
\rational{penten=(-1)*\pentep}
\text{rep71=\a}
\text{rep81=\b}
\text{rep91=\a}
\text{rep101=-\b}
\text{rep11=(\xc,\yc)}
\text{feed2=maxima(expand((x-\xc)^2-(\xc)^2))}
\text{feed3=maxima(expand((y-\yc)^2-(\yc)^2))}
\rational{const=(\xc)^2+(\yc)^2-(\r)^2}
\text{feed4=texmath(\const - (\xc)^2+(\yc)^2)}
**** Pour l'hyperbole
\text{rep12=x=\xc}
\text{rep13=y=\yc}
\text{rep14=(\xc,\yc)}
**** Pour la parabole
\integer{axedir=random(1..2)}
 \if{\axedir=1}{
   \text{rep15=x=\xc}
  }
  {
   \text{rep15=y=\yc}
  }
\text{rep16=(\xc,\yc)}

\if{\k==1}{
   \text{equat=simplify((\a)*(x-\xc)^2+(\a)*(y-\yc)^2-(\a)*(\r)^2=0)}
   \text{question2= Préciser son centre et son rayon}
   \text{mstep2=r2,r3,r4}
}
\if{\k==2}{
   \text{equat=simplify((\a)*(x-\e)+(\b)*(y-\f)=0)}
   \text{question2= Preciser la pente de son vecteur normal}
 \text{mstep2=r5,r6}
}
\if{\k==3}{
   \text{equat=simplify((\a)^2*(x-\xc)^2-(\b)^2*(y-\yc)^2=0)}
   \text{question2= Preciser leurs vecteurs normaux, en commençant par celui de pente positif, ainsi que les coordonnées de leur point d'intersection}
 \text{mstep2=r7,r8,r9,r10,r11}
   \text{eqsol1=simplify((\a)*(x-\xc)-(\b)*(y-\yc)=0)}
   \text{eqsol2=simplify((\a)*(x-\xc)+(\b)*(y-\yc)=0)}
}
\if{\k==4}{
   \text{equat=simplify((\a)*(x-\xc)*(y-\yc)-(\a)*(\r)=0)}
   \text{question2= Préciser les équations de ses asymptotes et les cordonnées de son centre de symétrie}
   \text{mstep2=r12,r13,r14}
   \text{eqsol1=\yc+\r/(x-\xc)}
}
\if{\k==5}{
 \if{\axedir=1}{
   \text{equat=simplify((\a)*(x-\xc)^2+(\b)*y -(\b)*(\yc)=0)}
   \text{eqsol1=y=\yc-(\a)*(x-\xc)^2/(\b)}
  }{
   \text{equat=simplify((\b)*(y-\yc)^2+(\a)*x-(\a)*(\xc)=0)}
   \text{eqsol1=x=\xc-(\b)*(y-\yc)^2/(\a)}
  }
  \text{question2= Préciser l'équation de son axe de symétrie et les coordonnées de son sommet}
  \text{mstep2=r15,r16}
}


\text{\mstep=r1}
\nextstep{\mstep}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
On considère un objet du plan donné par son équation :
<div class="wimscenter"> \(\equat).</div>
</div>
<div class="wims_question">
\if{\step=1}{
Quelle est la nature de cet objet: \embed{r1}}
{\question2}
</div>
}
\text{mstep=\step=2?\mstep2:}

\answer{nature}{\k;\oliste}{type=menu}
\answer{abscisse du centre}{\rep2}{type=numeric}
\answer{ordonnée du centre}{\rep3}{type=numeric}
\answer{rayon du cercle}{\rep4}{type=numeric}
\answer{abscisse du vecteur normal de la droite}{\rep5}{type=numeric}
\answer{ordonnée du vecteur normal de la droite}{\rep6}{type=numeric}
\answer{abscisse du vecteur normal 1}{\rep7}{type=numeric}
\answer{ordonnée du vecteur normal 1}{\rep8}{type=numeric}
\answer{abscisse du vecteur normal 2}{\rep9}{type=numeric}
\answer{ordonnée du vecteur normal 2}{\rep10}{type=numeric}
\answer{point d'intersection}{\rep11}{type=vector}
\answer{asymptote verticale}{\rep12}{type=equation}
\answer{asymptote horizontale}{\rep13}{type=equation}
\answer{centre de symétrie}{\rep14}{type=vector}
\answer{axe de symétrie}{\rep15}{type=equation}
\answer{sommet}{\rep16}{type=vector}

\condition{vecteur normal}{(\k=2 and \rep5*(\rep61)-\rep6*(\rep51)=0) or \k!=2}{option=hide}
\condition{vecteur normal 1}{(\k=3 and \rep7*(\rep81)-\rep8*(\rep71)=0) or \k!=3}{option=hide}
\condition{vecteur normal 2}{(\k=3 and \rep9*(\rep101)-\rep10*(\rep91)=0) or \k!=3}{option=hide}
\feedback{\reply1 notsametext \rep1}
{\if{\k==1}
{La présence de \(x^2) et \(y^2) du même côté du signe égal indique qu'il s'agit d'un cercle.
}
\if{\k==2}
{L'équation ne contient pas de termes carrés \(x^2) ou \(y^2), ni de terme produit \(x\times y), elle est donc linéaire en \(x) et en \(y): il s'agit d'une équation de droite.
}
\if{\k==3}
{Les variables \(x^2)et \(y^2) sont réparties de part et
 d'autre du signe égal. Ceci indique qu'il s'agit de deux droites.
}
\if{\k==4}
{La présence d'un terme produit \(x \times y) indique qu'il s'agit d'une hyperbole.
}
\if{\k==5}
{
Il manque un terme carré, il s'agit donc d'une parabole:
  \if{\axedir=1}
   {
   La présence du terme \(x^2) indique qu'il s'agit d'une parabole verticale.
   }
   {
   La présence du terme \(y^2) indique qu'il s'agit d'une parabole horizontale.
   }
}
}
\feedback{\k==1 and \step==2 and \reply2 <> \xc}
{Pour trouver l'abscisse du centre: On regroupe les termes en x et on fait apparaître le début d'un carré:<p>
\(\feed2)...=\((x-\xc)^2)....
}
\feedback{\k==1 and \step==2 and \reply3 <> \yc}
{Pour trouver l'ordonnée du centre: On regroupe les termes en y et on fait apparaître le début d'un carré:<p>
\(\feed3)...=\((y-\yc)^2)....
}
\feedback{\k==1 and \step==2 and \reply4 <> \r}
{Pour calculer le rayon du cercle, on fait:<br>
\(r^2)=\feed4
}
\feedback{\k==2 and \step==2 and \rep5*(\rep61)-\rep6*(\rep51)<>0}
{L'abscisse du vecteur normal correspond au coefficient devant \(x), son ordonnée correspond au coefficient devant \(y)}

\feedback{\k==3 and \step==2 and ((\rep7*(\rep81)-\rep8*(\rep71)<>0) or (\rep9*(\rep101)-\rep10*(\rep91)<>0))}
{
Les deux équations de droites sont:<br>
\(\eqsol1) et \(\eqsol2)<br>
Le vecteur normal de pente positif est donc (\rep71,\rep81).
}
\feedback{\k==4 and \step==2 }
{
L'équation canonique de l'hyperbole est:<br>
\(y= \eqsol1)<br>
Les équations des asymptotes sont donc \rep12 et \rep13.
Le centre de symétrie est le point d'intersection des asymptotes.
}
\feedback{\k==5 and \step==2 and (\reply16 notsametext \rep16 or \reply15 notsametext \rep15)}
{L'équation canonique de la parabole est:<br>
\(\eqsol1)<br>
L'équation de l'axe de symétrie est donc \rep12 .
Le sommet se situe sur cet axe.
}
\feedback{(\k==2 and \rep5*(\rep61)-\rep6*(\rep51)=0)}{vecteur normal: <span class="oef_indgood"> bonne réponse</span>}
\feedback{(\k==3 and \rep7*(\rep81)-\rep8*(\rep71)=0)}{vecteur normal 1:<span class="oef_indgood"> bonne réponse</span>}
\feedback{(\k==3 and \rep9*(\rep101)-\rep10*(\rep91)=0)}{vecteur normal 2:<span class="oef_indgood"> bonne réponse</span>}
