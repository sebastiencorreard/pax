## identifiants de l'exercice: titre, auteur, format
\title{Trouver l'équation de l'objet de l'espace}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{k=random(1..3)}
#### integer{k=1}
\integer{r=random(1..5)}
\integer{x=random(-5..5)}
\integer{y=random(-5..5)}
\integer{z=random(-5..5)}
\integer{d1=random(1..3)}
\integer{d2=random(1..3)}
\rational{xc=(\x)/(\d1)}
\rational{xc=(\x)}
\rational{yc=(\y)/(\d2)}
\rational{yc=(\y)}
\rational{zc=(\z)}
\integer{r=random(1..5)}
\integer{xa=random(1..5)*random(1,-1)}
\integer{xb=random(1..5)*random(1,-1)}
\integer{ya=random(1..5)*random(1,-1)}
\integer{yb=random(1..5)*random(1,-1)}
\integer{za=random(1..5)*random(1,-1)}
\integer{zb=random(1..5)*random(1,-1)}
\if{\xa=\xb and \ya=\yb and \za=\zb}
 {\integer{xb=\xb+1}
  \integer{yb=\yb-1}
 }
\integer{nx=random(-5..5)}
\integer{nz=random(-5..5)}
\integer{ny=(\nx=0 and \nz=0)?random(1..5)*random(1,-1):random(-5..5)}
\if{\k==1}{
   \text{natobjet=La sphère de centre \(\Omega(\xc,\yc,\zc)\) et de rayon \(R=\r\)}
   \text{equat=simplify((x-\xc)^2+(y-\yc)^2+(z-\zc)^2-(\r)^2=0)}
}
\if{\k==2}{
   \text{natobjet=La sphère de diamètre &#91;\(AB\)&#93; avec \(A(\xa,\ya,\za)\) et \(B(\xb,\yb,\zb)\)}
   \text{equat=simplify((x-\xa)*(x-\xb)+(y-\ya)*(y-\yb)+(z-\za)*(z-\zb)=0)}
}
\if{\k==3}{
   \text{natobjet=Le plan de vecteur normal \(\overrightarrow{n}(\nx,\ny,\nz)\) et passant par le point \(A(\xa,\ya,\za)\)}
   \text{equat=simplify((\nx)*(x-\xa)+(\ny)*(y-\ya)+(\nz)*(z-\za)=0)}
}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
Déterminer l'équation de l'objet de l'espace suivant:
<div class="wimscenter">\natobjet.</div>
</div>
<div class="wims_question">
<label for="reply1">Votre réponse:</label> \embed{r1}
</div>
}

\answer{Équation de l'objet}{\equat}{type=equation}
