## identifiants de l'exercice: titre, auteur, format
\title{Cercle tangent à une droite}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{r=random(1..5)}
\integer{x=random(-5..5)}
\integer{y=random(-5..5)}
\integer{d1=random(1..3)}
\integer{d2=random(1..3)}
\rational{xc=(\x)/(\d1)}
\rational{xc=(\x)}
\rational{yc=(\y)/(\d2)}
\rational{yc=(\y)}
\integer{r=random(1..5)}
\integer{xa=\xc+random(1..5)*random(1,-1)}
\integer{ya=\yc+random(1..5)*random(1,-1)}
\integer{nx=\xa-(\xc)}
\integer{ny=\ya-(\yc)}

\text{eqdte=simplify((x-(\xa))*(\nx)+(y-(\ya))*(\ny)=0)}
\text{eqdist=simplify((x-(\xa))*(\nx)+(y-(\ya))*(\ny))}
\text{eqdist=wims(replace internal x by (\xc) in \eqdist)}
\text{eqdist=wims(replace internal y by (\yc) in \eqdist)}

\\Affichage latex
\text{eqdist=wims(replace internal * by \times in \eqdist)}
\\Fin affichage latex

\integer{rayonc=(\xc-(\xa))*(\nx)+(\yc-(\ya))*(\ny)}
\rational{rayonc=(\rayonc)^2/((\nx)^2+(\ny)^2)}
\text{equat=simplify((x-\xc)^2+(y-\yc)^2-\rayonc=0)}

\\Amélioration affichage solution
\text{t1 = simplify(x-\xc)}
\text{t2 = simplify(y-\yc)}

\if{(\xc=0 and \yc !=0)}{\text{eqfinal=x^2+(\t2)^2=\rayonc}}
\if {(\yc=0 and \xc !=0)}{\text{eqfinal=(\t1)^2+y^2=\rayonc}}
\if {(\xc=0 and \yc=0)}{\text{eqfinal=x^2+y^2=\rayonc}}
\if {(\xc!= 0 and \yc!= 0)}{\text{eqfinal = (\t1)^2+(\t2)^2=\rayonc}}
\\Fin

\text{textsol=Le rayon du cercle est donné par la distance du centre \(\Omega\) à la droite \(\Delta\):<br>
\(R=d(\Omega,\Delta))=\(\frac{|\eqdist|}{\sqrt{(\nx)^2+(\ny)^2}})=\(\sqrt{\rayonc})<br>
L'équation du cercle est donc \((x-(\xc))^2+(y-(\yc))^2=\rayonc) ou encore \(\eqfinal).}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}

\statement{
<div class="enonce">
 Déterminer l'équation du cercle de centre \(\Omega(\xc,\yc)\)
 et tangent à la droite \(\,\Delta) d'équation \(\eqdte).
</div>

<div class="wims_question">
 <label for="reply1">Votre réponse:</label> \embed{r1}
</div>
}
\answer{Équation de l'objet}{\equat}{type=equation}
\solution{\textsol}
