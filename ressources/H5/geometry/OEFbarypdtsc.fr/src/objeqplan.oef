## identifiants de l'exercice: titre, auteur, format
\title{Trouver l'équation de l'objet du plan}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{k=random(1..4)}
#### integer{k=1}
\integer{r=random(1..5)}
\integer{x=random(-5..5)}
\integer{y=random(-5..5)}
\integer{d1=random(1..3)}
\integer{d2=random(1..3)}
\rational{xc=(\x)/(\d1)}
\rational{xc=(\x)}
\rational{yc=(\y)/(\d2)}
\rational{yc=(\y)}
\integer{r=random(1..5)}
\integer{xa=random(1..5)*random(1,-1)}
\integer{xb=random(1..5)*random(1,-1)}
\integer{ya=random(1..5)*random(1,-1)}
\integer{yb=random(1..5)*random(1,-1)}
\if{\xa=\xb and \ya=\yb}
 {\integer{xb=\xb+1}
  \integer{yb=\yb-1}
 }
\integer{nx=random(-5..5)}
\integer{ny=\nx=0?random(1..5)*random(1,-1):random(-5..5)}
\integer{ux=\ny}
\integer{uy=-\nx}
\if{\k==1}{
   \text{natobjet=Le cercle de centre \(\Omega(\xc,\yc)\) et de rayon \(R=\r\)}
   \text{equat=simplify((x-\xc)^2+(y-\yc)^2-(\r)^2=0)}
}
\if{\k==2}{
   \text{natobjet=Le cercle de diamètre &#91;\(AB\)&#93; avec \(A(\xa,\ya)\) et \(B(\xb,\yb)\)}
   \text{equat=simplify((x-\xa)*(x-\xb)+(y-\ya)*(y-\yb)=0)}
}
\if{\k==3}{
   \text{natobjet=La droite  de vecteur directeur \(\overrightarrow{u}(\ux,\uy)\) et passant par le point \(A(\xa,\ya)\)}
   \text{equat=simplify((\uy)*(x-\xa)-(\ux)*(y-\ya)=0)}
}
\if{\k==4}{
   \text{natobjet=La droite  de vecteur normal \(\overrightarrow{n}(\nx,\ny)\) et passant par le point \(A(\xa,\ya)\)}
   \text{equat=simplify((\nx)*(x-\xa)+(\ny)*(y-\ya)=0)}
}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
Déterminer l'équation de l'objet du plan suivant:
<div class="wimscenter">\natobjet.</div>
</div>
<div class="wims_question">
<label for="reply1">Votre réponse:</label> \embed{r1}
</div>
}

\answer{Équation de l'objet}{\equat}{type=equation}
