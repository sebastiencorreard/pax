\title{Expression analytique dans le plan}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{10000}

## k=1 alignés, k=2 non alignés
\integer{k=randint(1..2)}

** donnée de trois vecteurs indépendants
\if{\k=1}
 {\matrix{V=slib(matrix/orthogonal 2,10)}}
 {\matrix{V=slib(matrix/invertible 2,10)}}

\matrix{u=\V[1;]}
\matrix{v=\V[2;]}
\integer{a=random(1..5)}
\integer{b=random(1..5)}
\matrix{u= pari(print([\u]*\a))}
\matrix{v= pari(print([\v]*\b))}
\integer{pdt=\u[1]*\v[1]+\u[2]*\v[2]}
\integer{k=\pdt=0?1:2}

\text{rep=\k=1? orthogonaux:non orthogonaux}
\text{liste=orthogonaux,non orthogonaux}

 \text{textsol=le produit scalaire vaut:<br>
 \(\overrightarrow{u}\cdot \overrightarrow{v})=\(\u[1]\times(\v[1])+(\u[2])\times(\v[2])=\pdt\)
<br>donc les vecteurs sont \rep}
\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
Les vecteurs \(\overrightarrow{u}\) et \(\overrightarrow{v}\),
 dont les coordonnées dans un repère orthonormal donné sont respectivement
 <div class="wimscenter">
 \(\overrightarrow{u}\left(\begin{array}{c} \u[1] \\ \u[2] \end{array}\right)\) ,
 \(\overrightarrow{v}\left(\begin{array}{c} \v[1] \\ \v[2]\end{array}\right)\).
 </div>
 sont-ils orthogonaux ?
</div>
<div class="wims_question">
Les vecteurs sont \embed{choice1}.
</div>
}

\choice{}{\rep}{\liste}
\hint{L'orthogonalité est assurée si le produit scalaire est nul!}
\solution{
\textsol}
