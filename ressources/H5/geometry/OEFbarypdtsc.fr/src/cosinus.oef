\title{Produit scalaire et cosinus}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{coeflst=1/6,1/4,1/3,1/2,2/3,3/4,5/6,1}
\text{valcoslst=sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1}
\text{tvalcoslst=\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2},-1}
\integer{nu=random(1..10)}
\rational{nu=\nu /random(1,1,1,2,2,3)}
\integer{nv=random(1..10)}
\rational{nv= \nv/random(1,1,1,2,2,3)}
\text{tnu=\nu}
\text{tnu=wims(replace internal / by , in \tnu)}
\text{tnu=items(\tnu)=1?\tnu:\frac{\tnu[1]}{\tnu[2]}}
\text{tnv=\nv}
\text{tnv=wims(replace internal / by , in \tnv)}
\text{tnv=items( \tnv)=1?\tnv:\frac{\tnv[1]}{\tnv[2]}}

\integer{ind=random(1..8)}
\rational{nuv=\nu*\nv}
\text{pdt=\nuv*\valcoslst[\ind]}
\text{pdtexact=texmath(\pdt)}
\rational{pdtorig=\pdt}
\real{pdt=\pdt}
\text{signang=random( ,-)}
\text{testapprox=wims(text select 0123456789 in \pdt)}
\text{testapprox=wims(charcnt \testapprox)<4 ? 1:0}
\text{tcoef=\coeflst[\ind]}
\text{tcoef=wims(replace internal / by , in \tcoef)}
\text{num=\tcoef[1]=1?\pi:\tcoef[1] \pi}
\text{num=\tcoef[1]=-1?-\pi}
\text{tcoef=items(\tcoef)=1?\num:\frac{\num}{\tcoef[2]}}
\text{quest=\overrightarrow{u} \cdot \overrightarrow{v} }
\text{textsol=La formule du produit scalaire est:}
\text{teq=\pdt==0 or \testapprox =1? = : \approx}
\text{textsol1=\( \quest= \Vert \overrightarrow{u} \Vert \times \Vert \overrightarrow{v}
\Vert \times cos \theta
= \tnu \times \tnv \times (\tvalcoslst[\ind]) = \pdtexact \teq \pdt)}

\css{<style>
.enonce { margin:2% 2%; padding:1em;}
</style>
}
\statement{
<div class="enonce">
On note \(\ \theta) une mesure de l'angle \((\overrightarrow{u},\overrightarrow{v}))
en radians.
</div>
<div class="wims_question">
Déterminer la valeur exacte du produit scalaire
  \( \overrightarrow{u} \cdot \overrightarrow{v}) lorsque:
<div class="wimscenter"> \( \Vert \overrightarrow{u} \Vert = \tnu),
  \( \Vert \overrightarrow{v} \Vert = \tnv)
  et \(\theta= \signang\tcoef)
</div>
<label for="reply1">\( \overrightarrow{u} \cdot \overrightarrow{v}) =</label> \embed{reply 1,10}.
</div>
<div class="wims_instruction">
<h2>Aide à la saisie</h2>
<p>
Pour saisir une racine carrée, taper sqrt(..), ex pour \(\frac{\sqrt{2}}{2}), taper
<span class="tt">sqrt(2)/2</span>.
</p>
</div>
}



\answer{\( \quest )}{\pdt}{type=numeric}
\solution{
\textsol
<div class="wimscenter">\textsol1</div>
}
