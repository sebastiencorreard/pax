!set title=Perpendiculaire I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=1000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L)	  d'équation cartésienne&nbsp;
tmp=!trim Une équation cartésienne de la droite passant par le point de coordonnées	  et perpendiculaire à \(L) est	
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val10=$[rint($(tmp0))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
val13=$[rint($val9*($val11) - ($val8)*($val12))]
val14=$val8*x + $val9*y = $val10
val15=!rawmath $val9*x - $val8*y = $val13
replytype1=equation
replyname1=\name_answer
replygood1=!rawmath $val15,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	  <div class="wimscenter">
!insmath $val14
$().</div>	  <label for="reply1">$(val7[1;]) 
!insmath ($val11, $val12)
$() $(val7[2;])</label>  
!read oef/embed.phtml reply1,15 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,12,14
embedcnt=1
