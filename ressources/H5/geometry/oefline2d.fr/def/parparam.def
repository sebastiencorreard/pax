!set title=Parallèle en rep. paramétrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-Claude,David
email=mcld@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r,r,r
varcnt=19
prevarcnt=14
postvarcnt=4
replycnt=4
choicecnt=0
conditioncnt=2
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L\)	dont une représentation paramétrique de paramètre réel \(t\) est
val7=Une représentation paramétrique de la droite \(L') passant par le point \(M\) de coordonnées	   et parallèle à \(L) est&nbsp;
tmp=!trim La représentation paramétrique donnée est celle d'une droite	  parallèle à	  passant par
val8=!translate internal $	\
$ to ;; in $tmp
val9=Une représentation paramétrique de \(L'\) est&nbsp;
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val13=$[rint($(tmp0)*2+1)]
tmp0=!randint -20, 20

val14=$[rint($(tmp0))]
tmp0=!randint -20, 20

val15=$[rint($(tmp0))]
tmp0=!texmath $val10*t + $val12

val16=$(tmp0)
tmp0=!texmath $val11*t + $val13

val17=$(tmp0)
tmp0=!texmath $val10*t + $val14

val18=$(tmp0)
tmp0=!texmath $val11*t + $val15

val19=$(tmp0)
replytype1=numeric
replyname1=\alpha
replygood1=?analyze 20
replytype2=numeric
replyname2=xx
replygood2=?analyze 21
replytype3=numeric
replyname3=\beta
replygood3=?analyze 22
replytype4=numeric
replyname4=yy
replygood4=?analyze 23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	<div class="wimscenter">	
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val16 \\ y &=&$val17 .	\end{array}\right.
$()	</div>	$(val7[1;]) 
!insmath ($val14, $val15)
$() $(val7[2;]):	<div class="wimscenter">	
!insmath x =
$()  
!read oef/embed.phtml reply1,7 
$()t+ 
!read oef/embed.phtml reply2,7 
$()<br/>	
!insmath y =
$()  
!read oef/embed.phtml reply3,7 
$()t+ 
!read oef/embed.phtml reply4,7 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val24=$[($val20)*$val11-($val22)*$val10]
val25=$[($val21)-$val14]
val26=$[($val23)-$val15]
val27=$[$val25*$val11-$val26*$val10]

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>$val9:	<div class="wimscenter">	
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val18 \\ y &=&$val19 .	\end{array}\right.
$()	</div>
$()</div>
!endif

!exit

:test
condweight1=0.3 

!ifval $val24 = 0
 condtest1=1
!else
 condtest1=0
!endif
condname1=$(val8[1;]) $(val8[2;]) \(L\)
condweight2=0.7 

!ifval $val27 = 0
 condtest2=1
!else
 condtest2=0
!endif
condname2=$(val8[1;]) $(val8[3;]) \(M\) 

!exit

:stat
