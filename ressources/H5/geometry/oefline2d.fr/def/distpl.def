!set title=Distance point-droite I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=1000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L)	  d'équation cartésienne&nbsp;
tmp=!trim Calculer la distance entre \(L) et le point de coordonnées
val7=!translate internal $	\
$ to ;; in $tmp
val8=Distance
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -20, 20

val13=$[rint($(tmp0))]
val14=$[rint($val9*($val12) + ($val10)*($val13))]
t_=!replace internal \( by ( in $val9*x + $val10*y
tmp0=!exec pari $t_

val15=$(tmp0) = $val11
val16=$[abs(($val14-($val11))/sqrt(($val9)^2+($val10)^2))]
replytype1=numeric
replyname1=$val8
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	  <p class="wimscenter">
!insmath $val15
$().</p>	  $val7 
!insmath ($val12, $val13)
$().	
$()
!exit

