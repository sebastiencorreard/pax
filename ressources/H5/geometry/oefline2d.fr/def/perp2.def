!set title=Perpendiculaire II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L\)	dont une représentation paramétrique de paramètre réel \(t\) est
tmp=!trim Une équation cartésienne de la droite passant par le point de coordonnées	  et perpendiculaire à \(L) est
val7=!translate internal $	\
$ to ;; in $tmp
val8=L'équation doit être de la forme
val9=Équation de la droite
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val13=$[rint($(tmp0)*2+1)]
tmp0=!randint -20, 20

val14=$[rint($(tmp0))]
tmp0=!randint -20, 20

val15=$[rint($(tmp0))]
val16=$[rint($val11*($val14) - ($val10)*($val15))]
val17=!rawmath $val11*x - $val10*y = $val16
tmp0=!texmath $val10*t + $val12

val18=$(tmp0)
tmp0=!texmath $val11*t + $val13

val19=$(tmp0)
replytype1=equation
replyname1=$val9
replygood1=!rawmath $val17,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6	<div class="wimscenter">	
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val18 \\ y &=&$val19.	\end{array}\right.
$()	</div>	$(val7[1;])
!insmath ($val14 , $val15)
$() $(val7[2;])  
!read oef/embed.phtml reply1,15 
$().	<div class="wims_instruction">	$val8 
!insmath a x + b y = c
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,14,15,18,19
embedcnt=1
