!set title=Parallèle (éq. cartésienne)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=1000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L)	  d'équation cartésienne&nbsp;
tmp=!trim Une équation de la droite passant par le point de coordonnées	  et parallèle à \(L) est
val7=!translate internal $	\
$ to ;; in $tmp
val8=Équation de la droite
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -20, 20

val13=$[rint($(tmp0))]
val14=$[rint(gcd($val9,$val10))]
val14=$[rint(gcd($val14,$val11))]
val9=$[rint($val9/$val14)]
val10=$[rint($val10/$val14)]
val11=$[rint($val11/$val14)]
val15=$[rint($val9*($val12) + ($val10)*($val13))]
t_=!replace internal \( by ( in $val9*x + $val10*y
tmp0=!exec pari $t_

val16=$(tmp0) = $val11
val17=!rawmath $val9*x + $val10*y = $val15
replytype1=equation
replyname1=$val8
replygood1=!rawmath $val17,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	  <div class="wimscenter">
!insmath $val16
$().</div>	  <label for="reply1">$(val7[1;]) 
!insmath ($val12, $val13)
$() $(val7[2;])</label>  
!read oef/embed.phtml reply1,15 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,12,13,16
embedcnt=1
