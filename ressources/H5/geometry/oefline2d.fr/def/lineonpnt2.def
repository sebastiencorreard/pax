!set title=Droite passant par un point II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=1000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L)	  d'équation cartésienne&nbsp;
tmp=!trim La droite \(L) passe par le point de coordonnées	  si et seulement si \(m\) est égal à
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
val12=$[rint($val8*($val10)+($val9)*($val11))]
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]

!ifval $val13=1
val14=$val9
!else
val14=$val8
!endif

!ifval $val13=1
val8=$val8
!else
val8=m
!endif

!ifval $val13=1
val9=m
!else
val9=$val9
!endif
val15=$val8*x + $val9*y = $val12
replytype1=numexp
replyname1=\(m)
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	<div class="wimscenter">
!insmath $val15
$().</div>	<label for="reply1">$(val7[1;]) 
!insmath ($val10, $val11)
$() $(val7[2;])</label>  
!read oef/embed.phtml reply1,10 
$().	
$()
!exit

