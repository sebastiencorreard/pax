val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L\)	dont une représentation paramétrique de paramètre réel \(t\) est
tmp=!trim Le point \(M\) de coordonnées	  appartient à \(L) si et seulement si \(m\) est égal à
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!texmath $val8*t + $val10

val13=$(tmp0)
tmp0=!texmath $val9*t + $val11

val14=$(tmp0)
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]
tmp0=!item $val15 of $val12,m

val16=$(tmp0)
tmp0=!item $val15 of m,$val12

val17=$(tmp0)
tmp0=!item $val15 of 	  $val11+($val9)*($val12-($val10))/($val8),	  $val10+($val8)*($val12-($val11))/($val9)	  

t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
replytype1=numexp
replyname1=\(m)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6	  <div class="wimscenter">	  
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val13 \\ y &=&$val14.	  \end{array}\right.
$()	  </div>	  <label for="reply1">	  $(val7[1;]) 
!insmath ($val16, $val17)
$() $(val7[2;])	  </label>	   
!read oef/embed.phtml reply1,10 
$().	
$()
