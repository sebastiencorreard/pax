!set title=Point et coefficient directeur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=L'équation doit être de la forme
val7=Équation de la droite
val8=Dans le plan muni d'un repère, trouver une équation de la droite	passant par le point de coordonnées
val9=dont le coefficient directeur est égal à
val10=Une équation de cette droite est
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randitem 2,4,5,8,10,16

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem $val13-7,$val13-6,$val13-3,$val13-1,$val13+1,$val13+3,$val13+6,$val13+7

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
val15=$[-($val14)/($val13)]
val16=$[rint(($val14)*($val11) + ($val13)*($val12))]
val17=!rawmath $val14*x + $val13*y = $val16
replytype1=equation
replyname1=$val7
replygood1=!rawmath $val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8 
!insmath ($val11,$val12)
$()	$val9 
!insmath $val15
$().<div>	<label for="reply1">$val10</label>  
!read oef/embed.phtml reply1,15 
$().	</div>	<div class="wims_instruction">	$val6 
!insmath a x + b y = c
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,10,11,12,15
embedcnt=1
