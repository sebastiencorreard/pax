!set title=Distance point-droite II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Calculer la distance entre \(L) et le point de coordonnées
val6=!translate internal $	\
$ to ;; in $tmp
val7=Distance
val8=Dans le plan muni d'un repère, on considère la droite \(L\)	dont une représentation paramétrique de paramètre réel \(t\) est
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val12=$[rint($(tmp0)*2+1)]
val13=$[rint(-($val10))]
val14=$[rint($val9)]
val15=$[rint($val13*($val11)+($val14)*($val12))]
tmp0=!randint -20, 20

val16=$[rint($(tmp0))]
tmp0=!randint -20, 20

val17=$[rint($(tmp0))]
val18=$[rint($val13*($val16) + ($val14)*($val17))]
tmp0=!texmath $val9*t + $val11

val19=$(tmp0)
tmp0=!texmath $val10*t + $val12

val20=$(tmp0)
val21=$[abs(($val18-($val15))/sqrt(($val13)^2+($val14)^2))]
replytype1=numeric
replyname1=$val7
replygood1=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8	<div class="wimscenter">	
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val19 \\ y &=&$val20 .	\end{array}\right.
$()	</div>	$val6 
!insmath ($val16,$val17)
$().	
$()
