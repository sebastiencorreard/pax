!set title=2 points
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=100
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite	  passant par les points de coordonnées
val7=Une équation cartésienne de cette droite est
val8=et
val9=L'équation doit être de la forme
val10=Équation de la droite
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0)*2)]
tmp0=!randint -10, 9

val14=$[rint($(tmp0)*2+1)]
val15=$[rint($val14-($val13))]
val16=$[rint($val11-($val12))]
val17=$[rint(($val11)*($val14)-($val12)*($val13))]
val18=!rawmath $val15*x + $val16*y = $val17
replytype1=equation
replyname1=$val10
replygood1=!rawmath $val18,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6	
!insmath ($val11, $val13)
$() $val8 
!insmath ($val12, $val14)
$().	<label for="reply1">$val7</label>  
!read oef/embed.phtml reply1,15 
$().	<div class="wims_instruction">	$val9 
!insmath a x + b y = c
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,11,12,13,14
embedcnt=1
