!set title=Rep. paramétrique vers éq. cartésienne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L\)	dont une représentation paramétrique de paramètre réel \(t\) est
tmp=!trim Une équation de \(L\) est 
val7=!translate internal $	\
$ to ;; in $tmp
val8=L'équation doit être de la forme
val9=Équation de la droite
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val12=$[rint($(tmp0)*$(tmp1)*2)]
tmp0=!randint -10, 9

val13=$[rint($(tmp0)*2+1)]
val14=$[rint(-($val11))]
val15=$[rint($val10)]
val16=$[rint(($val14)*($val12)+($val15)*($val13))]
val17=$[rint(gcd($val14,$val15))]
val17=$[rint(gcd($val17,$val16))]
val14=$[rint($val14/$val17)]
val15=$[rint($val15/$val17)]
val16=$[rint($val16/$val17)]
val18=!rawmath $val14*x + $val15*y = $val16
tmp0=!texmath $val10*t + $val12

val19=$(tmp0)
tmp0=!texmath $val11*t + $val13

val20=$(tmp0)
replytype1=equation
replyname1=$val9 \(L)
replygood1=!rawmath $val18,x,y
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	<div class="wimscenter">	
!insmath \left \lbrace \begin{array}{rcl}	  x &=&$val19 \\ y &=&$val20 .	\end{array}\right.
$()	</div>	$val7  
!read oef/embed.phtml reply1,15 
