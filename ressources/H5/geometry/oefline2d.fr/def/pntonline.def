!set title=Point sur droite I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
precision=1000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans le plan muni d'un repère, on considère la droite \(L)	  d'équation cartésienne&nbsp;
tmp=!trim Le point \(M\) de coordonnées	  appartient à \(L) si et seulement si \(m\) est égal à	
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val10=$[rint($(tmp0))]
tmp0=!randint -20, 20

val11=$[rint($(tmp0))]
tmp0=!randint -20, 20

val12=$[rint($(tmp0))]
tmp0=!randint -20, 20

val13=$[rint($(tmp0))]
val14=!rawmath $val8*x + $val9*y = $val10
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]
tmp0=!item $val15 of $val13,m

val11=$(tmp0)
tmp0=!item $val15 of m,$val13

val12=$(tmp0)
tmp0=!item $val15 of ($val10-($val8)*($val13))/($val9),($val10-($val9)*($val13))/($val8)

t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
replytype1=numexp
replyname1=\(m)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	<div class="wimscenter">
!insmath $val14
$().</div>	<label for="reply1">$(val7[1;]) 
!insmath ($val11, $val12)
$() $(val7[2;])</label>  
!read oef/embed.phtml reply1,10 
$().	
$()
