\title{Distance point-droite I}
\text{name_instruction=Dans le plan muni d'un repère, on considère la droite \(L)
  d'équation cartésienne&nbsp;}
\matrix{name_question=Calculer la distance entre \(L) et le point de coordonnées}
\text{name_answer=Distance}
\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a*(\x) + (\b)*(\y)}
\text{L=pari(\a*x + \b*y) = \c}
\real{dist=abs((\t-(\c))/sqrt((\a)^2+(\b)^2))}
\statement{\name_instruction:
  <p class="wimscenter">\(\L).</p>
  \name_question \((\x, \y)).
}
\answer{\name_answer}{\dist}{type=numeric}
