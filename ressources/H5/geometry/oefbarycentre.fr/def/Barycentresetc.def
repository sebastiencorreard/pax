!set title=Barycentres et coordonnées
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 10

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val10=$[rint($val7+$(tmp0))]
tmp0=!randint 1, 10

val11=$[rint($val8+$(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

val13=$[rint($val7-$(tmp0))]
tmp0=!randint 1, 10

val14=$[rint($val8-$(tmp0))]
val15=$[rint($val9-$val6-$val12)]
t_=!rawmath ($val6*$val7+$val12*$val10+$val15*$val13)/($val9) 
val16=!exec pari print($t_)
t_=!rawmath ($val6*$val8+$val12*$val11+$val15*$val14)/($val9) 
val17=!exec pari print($t_)
tmp0=!randint 1, 3

val18=$[rint($(tmp0))]
tmp0=!item $val18 of $val6,$val6,a

val19=$(tmp0)
tmp0=!item $val18 of $val12,a,$val12

val20=$(tmp0)
tmp0=!item $val18 of a,$val15,$val15

val21=$(tmp0)
tmp0=!item $val18 of $val15,$val12,$val6

t_=!rawmath $(tmp0)
val22=!exec pari print($t_)
replytype1=default
replyname1=Valeur de \(a)
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan muni d'un repère, on considère les points	
!insmath A
$() ( $val7;$val8), 
!insmath B
$() ( $val10;$val11) et 
!insmath C
$() ( $val13;$val14 ).	<p>	Le point 
!insmath G
$() a pour coordonnées ( 
!insmath $val16
$();
!insmath $val17
$() ). Déterminer 
!insmath a
$() tel que	
!insmath G
$() soit le barycentre des points pondérés	
!insmath ( A,$val19 )
$(), 
!insmath ( B,$val20 )
$() et 
!insmath ( C,$val21 )
$().	</p>	<div class="wims_instruction"><b> Attention:</b>	Les réponses seront données sous forme de fraction irréductible.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11,13,14,16,17,19,20,21
embedcnt=0
