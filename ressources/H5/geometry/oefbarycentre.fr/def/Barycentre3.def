!set title=Construction d'un barycentre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Frédéric, Pitoun
email=lva.pitoun@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 5, 15

val8=$[rint($(tmp0))]
val9=$[rint($val8-$val6-$val7)]
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of AG,BG,CG

val11=$(tmp0)
tmp0=!item $val10 of AB,BA,CA

val12=$(tmp0)
tmp0=!item $val10 of AC,BC,CB

val13=$(tmp0)
t_=!rawmath $val7/$val8
val14=!exec pari print($t_)
t_=!rawmath $val9/$val8
val15=!exec pari print($t_)
t_=!rawmath $val6/$val8
val16=!exec pari print($t_)
t_=!rawmath $val9/$val8
val17=!exec pari print($t_)
t_=!rawmath $val6/$val8
val18=!exec pari print($t_)
t_=!rawmath $val7/$val8
val19=!exec pari print($t_)
tmp0=!item $val10 of $val14,$val16,$val18

t_=!rawmath $(tmp0)
val20=!exec pari print($t_)
tmp0=!item $val10 of $val15,$val17,$val19

t_=!rawmath $(tmp0)
val8=!exec pari print($t_)
replytype1=rational

replyname1=Valeur de \(x)
replygood1=$val20
replytype2=rational

replyname2=Valeur de \(y)
replygood2=$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans le plan, on considère les points 
!insmath A
$(), 
!insmath B
$() et 
!insmath C
$(). On note	
!insmath G
$() le barycentre des points pondérés	
!insmath  \left( A,$val6 \right) 
$(), 
!insmath \left( B,$val7 \right) 
$() et 
!insmath \left( C,$val9 \right) 
$().	<p>	Déterminer les réels 
!insmath x
$() et 
!insmath y
$() tels que 
!insmath 	\overrightarrow{$val11} = x\overrightarrow{$val12} + y\overrightarrow{$val13}
$().</p>		<div class="wims_instruction">	<b>Attention:</b> Les réponses seront données sous forme de fraction irréductible.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()On obtient en utilisant la relation de Chasles:	<div class="wimscenter">	
!insmath 	\overrightarrow{$val11} = $val20 \overrightarrow{$val12} + $val20 \overrightarrow{$val13}	
$().</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,11,12,13,20
embedcnt=0
