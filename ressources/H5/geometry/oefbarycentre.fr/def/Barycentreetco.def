val7=$(tmp0)
tmp0=!item $val6 of B,C,A

val8=$(tmp0)
tmp0=!item $val6 of C,A,B

val9=$(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 5, 15

val12=$[rint($(tmp0))]
val13=$[rint($val12-$val10-$val11)]
tmp0=!item $val6 of $val10,$val13,$val11

val14=$[rint($(tmp0))]
tmp0=!item $val6 of $val11,$val10,$val13

val15=$[rint($(tmp0))]
tmp0=!item $val6 of $val13,$val11,$val10

val16=$[rint($(tmp0))]
t_=!rawmath $val11/$val12
val17=!exec pari print($t_)
t_=!rawmath $val13/$val12
val18=!exec pari print($t_)
tmp=!trim 
val19=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 
val20=!translate internal $	\
$ to ;; in $tmp
val21=$[rint()]
val22=$[rint()]

!ifval $val18>0
val23=+
!endif
