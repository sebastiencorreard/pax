\title{Barycentre graphique}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@gmail.com}
\computeanswer{yes}
\format{html}
\precision{100}
\integer{a=random(-8..-2)}
\integer{b=random(2..8)}
\integer{g0=random(-12..\a-1)}
\integer{g1=random(\a+1..\b-1)}
\integer{g2=random(\b+1..12)}
\integer{g=random(\g0,\g1,\g2)}
\integer{ka=\a-\g}
\integer{kb=\b-\g}

\function{al=simplify(\kb/(\kb-\ka))}

\function{be=simplify(-\ka/(\kb-\ka))}

\steps{
reply 1, reply 2
reply 3, reply 4
}

\statement{
  On a représenté sur la droite graduée ci-dessous trois points \(A), \(B) et \(G). On note
  \(\overrightarrow{u}) le vecteur représenté en vert.
<div class="wimscenter">
  \draw{512,64}
  {xrange -13,13
   yrange -1,1.5
  hline 0,0,red
  parallel -10,-0.4,-10,0.4,5,0,5,blue
  parallel -12,-0.2,-12,0.2,1,0,2,blue
  parallel -9,-0.2,-9,0.2,1,0,4,blue
  parallel -4,-0.2,-4,0.2,1,0,4,blue
  parallel 1,-0.2,1,0.2,1,0,4,blue
  parallel 6,-0.2,6,0.2,1,0,4,blue
  parallel 11,-0.2,11,0.2,1,0,4,blue
  text red,\a-0.1,0.75,medium,A
  text red,\b-0.1,0.75,medium,B
  text red,\g-0.1,-0.5,medium,G
  line \a,-0.2,\a,0.2,red
  line \b,-0.2,\b,0.2,red
  line \g,-0.2,\g,0.2,red
  line 0,0.8,0,1.2,green
  arrow 0,1,1,1,10,green
  }
</div>

\if{\step=1}{
Déterminer des réels \(a) et \(b) tels que \(\overrightarrow{GA} = a\overrightarrow{u}) et
\(\overrightarrow{GB} = b\overrightarrow{u})
}

\if{\step=2}{Oui, on a bien
\(\overrightarrow{GA} = \ka \overrightarrow{u}) et
\(\overrightarrow{GB} = \kb \overrightarrow{u}).

En déduire deux réels \(\alpha) et \(\beta) tels que:
<ul>
<li>
\(G=\lbrack \left(A,\alpha \right);\left( B,\beta \right) \rbrack)
</li>
<li> \(\alpha + \beta = 1)</li>
</ul>
}
}

\answer{Valeur de \(a)}{\ka}{type=numexp}
\answer{Valeur de \(b)}{\kb}{type=numexp}
\answer{Valeur de \(\alpha)}{\al}{type=numexp}
\answer{Valeur de \(\beta)}{\be}{type=numexp}

\hint{Pour le 2, on pourra utiliser la propriété :
<div class="wimscenter">
\(\lbrack \left(A,\alpha \right);\left( B,\beta \right) \rbrack
 = \lbrack \left(A,k.\alpha \right);\left( B,k.\beta \right) \rbrack,\forall k \in \RR^{*}
)
</div>
et choisir \(k) de sorte que \(k.\alpha + k.\beta = 1).
<div class="wims_instruction">
<b>Remarque:</b> Le symbole \(\forall) se lit "quel que soit".
</div>
}

