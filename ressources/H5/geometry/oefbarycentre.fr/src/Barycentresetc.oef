\title{Barycentres et coordonnées}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{k1=random(-1,1)*randint(1..5)}
\integer{x1=random(-10..10)}
\integer{y1=random(-10..10)}
\integer{s=random(-1,1)*randint(1..10)}
\integer{x2=\x1+randint(1..10)}
\integer{y2=\y1+randint(1..10)}
\integer{k2=random(-1,1)*randint(1..5)}
\integer{x3=\x1-randint(1..10)}
\integer{y3=\y1-randint(1..10)}
\integer{k3=\s-\k1-\k2}

\rational{xG= (\k1*\x1+\k2*\x2+\k3*\x3)/(\s) }
\rational{yG= (\k1*\y1+\k2*\y2+\k3*\y3)/(\s) }

\integer{al=random(1..3)}
\text{kb1=item(\al,\k1,\k1,a)}
\text{kb2=item(\al,\k2,a,\k2)}
\text{kb3=item(\al,a,\k3,\k3)}

\rational{rep=item(\al,\k3,\k2,\k1)}

\statement{Dans le plan muni d'un repère, on considère les points
\(A) ( \x1;\y1), \(B) ( \x2;\y2) et \(C) ( \x3;\y3 ).
<p>
Le point \(G) a pour coordonnées ( \(\xG);\(\yG) ). Déterminer \(a) tel que
\(G) soit le barycentre des points pondérés
\(( A,\kb1 )), \(( B,\kb2 )) et \(( C,\kb3 )).
</p>
<div class="wims_instruction"><b> Attention:</b>
Les réponses seront données sous forme de fraction irréductible.</div>
}

\answer{Valeur de \(a)}{\rep}{type=default}
