\title{Exemple de recherche de lieu géométrique}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a0=random(-1,1)*randint(1..10)}
\integer{b0=random(-1,1)*randint(1..10)}
\integer{c0=random(-1,1)*randint(1..10)}
\integer{s0=\a0+\b0+\c0}
\integer{a1=random(-1,1)*randint(1..10)}
\integer{b1=random(-1,1)*randint(1..10)}

\integer{al=random(1,2)}

\integer{xa=random(-1,1)*randint(1..20)}
\integer{xb=random(-1,1)*randint(1..20)}
\integer{xc=random(-1,1)*randint(1..20)}

\if{\al=1}{
\if{\s0=0}{
\integer{c0=\c0+1*\c0/abs(\c0)}
}
\integer{s0=\a0+\b0+\c0}
\integer{c1=\s0-\a1-\b1}
\integer{s1=\a1+\b1+\c1}
\rational{xg1=(\a0*\xa+\b0*\xb+\c0*\xc)/\s0}
\rational{xg2=(\a1*\xa+\b1*\xb+\c1*\xc)/\s1}
\rational{xm=(\xg1+\xg2)/2}
\text{lieu=une droite}
\text{prop=la droite perpendiculaire à \(d) passant par \(I)}
}

\if{\al=2}{
\if{\s0=0}{
\integer{c0=\c0+1*\c0/abs(\c0)}
}
\integer{s0=\a0+\b0+\c0}
\integer{c1=-\a1-\b1}
\integer{s1=\a1+\b1+\c1}
\text{lieu=un cercle}
\text{prop=le cercle de centre \(I)}
\rational{xc2=(\a0*\xa+\b0*\xb+\c0*\xc)/\s0}
\rational{r=abs(\a1*\xa+\b1*\xb+\c1*\xc)}
}

\if{\al=2}{
\rational{xr=\xc2}
}{
\rational{xr=\xm}
}

\text{v1=texmath(maxima(expand(\a0*x+\b0*y+\c0*z)))}
\text{v1=wims(replace x by \\overrightarrow{MA} in \v1)}
\text{v1=wims(replace y by \\overrightarrow{MB} in \v1)}
\text{v1=wims(replace z by \\overrightarrow{MC} in \v1)}

\text{v2=texmath(maxima(expand(\a1*x+\b1*y+\c1*z)))}
\text{v2=wims(replace x by \\overrightarrow{MA} in \v2)}
\text{v2=wims(replace y by \\overrightarrow{MB} in \v2)}
\text{v2=wims(replace z by \\overrightarrow{MC} in \v2)}

\steps{reply 1
reply 2
}

\statement{
On se propose de déterminer le lieu géométrique de l'ensemble des
points \(M) tels que
<div class="wimscenter">
  \(\|\v1\| =\|\v2\|)
</div>

\if{\step=1}{
Ce lieu géométrique est: \embed{reply 1}.
}
\if{\step=2}{
Effectivement, ce lieu géométrique est \lieu. Si on suppose en outre
que A, B et C sont situés sur une droite graduée \(d) et ont pour abscisses
respectives \xa,\xb,\xc. Quelle est l'abscisse du point I tel que le
lieu cherché soit \prop ?
<div class="spacer">
\(I) a pour abscisse: \embed{reply 2}.
</div>
}
}

\answer{Lieu}{\al;droite,cercle}{type=menu}
\answer{Abs}{\xr}{type=default}

\solution{}
