\title{Construction d'un barycentre}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{k1=random(-1,1)*randint(1..5)}
\integer{k2=random(-1,1)*randint(1..5)}

\integer{s=randint(5..15)}
\integer{k3=\s-\k1-\k2}
\integer{al=random(1..3)}
\text{v1=item(\al,AG,BG,CG)}
\text{v2=item(\al,AB,BA,CA)}
\text{v3=item(\al,AC,BC,CB)}

\rational{r1=\k2/\s}
\rational{s1=\k3/\s}
\rational{r2=\k1/\s}
\rational{s2=\k3/\s}
\rational{r3=\k1/\s}
\rational{s3=\k2/\s}

\rational{r=item(\al,\r1,\r2,\r3)}

\rational{s=item(\al,\s1,\s2,\s3)}

\statement{Dans le plan, on considère les points \(A), \(B) et \(C). On note
\(G) le barycentre des points pondérés
\( \left( A,\k1 \right) ), \(\left( B,\k2 \right) ) et \(\left( C,\k3 \right) ).
<p>
Déterminer les réels \(x) et \(y) tels que \(
\overrightarrow{\v1} = x\overrightarrow{\v2} + y\overrightarrow{\v3}).</p>

<div class="wims_instruction">
<b>Attention:</b> Les réponses seront données sous forme de fraction irréductible.
</div>}

\answer{Valeur de \(x)}{\r}{type=rational}
\answer{Valeur de \(y)}{\s}{type=rational}

\solution{On obtient en utilisant la relation de Chasles:
<div class="wimscenter">
\(
\overrightarrow{\v1} = \r \overrightarrow{\v2} + \r \overrightarrow{\v3}
).</div>
}
