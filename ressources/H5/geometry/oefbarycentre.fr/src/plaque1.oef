\title{Centre d'inertie d'une plaque évidée}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\matrix{
centres=
1/2,1/2
3/2,1/2
5/2,1/2
7/2,1/2
1/2,3/2
3/2,3/2
5/2,3/2
7/2,3/2
1/2,5/2
3/2,5/2
5/2,5/2
7/2,5/2
1/2,7/2
3/2,7/2
5/2,7/2
7/2,7/2
}

\text{
s=shuffle(16)
}

\integer{n=randint(3..5)}

\text{
dessin=
xrange -1,5
yrange -1,5
parallel 0,0,0,4,1,0,5,blue
parallel 0,0,4,0,0,1,5,blue
linewidth 2
arrow 0,0,1,0,10,red
arrow 0,0,0,1,10,red
linewidth 1
}
\for{i=1 to \n}{
\text{
dessin=\dessin
fill \centres[item(\i,\s);1],\centres[item(\i,\s);2],blue
}
}

\rational{xg=16*2}
\rational{yg=16*2}

\for{i=1 to \n}{
\rational{xg=\xg-\centres[item(\i,\s);1]}
\rational{yg=\yg-\centres[item(\i,\s);2]}
}

\rational{xg=\xg/(16-\n)}
\rational{yg=\yg/(16-\n)}

\statement{<div class="float_right">\draw{200,200}{\dessin}
<div class="wims_instruction">Les parties évidées sont les parties coloriées.</div></div>
On considère une plaque homogène évidée représentée
ci-contre.
Donner les coordonnées du centre d'inertie de cette plaque.
<div class="wims_spacer">
Le centre d'inertie de cette plaque a pour coordonnées
</div>
<div class="wimscenter">
(\embed{reply 1,5};\embed{reply 2,5})
</div>
<div class="wims_instruction">
Les résultats seront donnés sous forme de fraction.
</div>
}

\answer{Valeur de \(x)}{\xg}{type=rational}
\answer{Valeur de \(y)}{\yg}{type=rational}

\solution{}
