\title{Barycentre et coefficients}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{al=random(1..3)}
\text{A=item(\al,A,B,C)}
\text{B=item(\al,B,C,A)}
\text{C=item(\al,C,A,B)}

\integer{k1=random(-1,1)*randint(1..5)}
\integer{k2=random(-1,1)*randint(1..5)}
\integer{s=randint(5..15)}
\integer{k3=\s-\k1-\k2}

\integer{ka=item(\al,\k1,\k3,\k2)}
\integer{kb=item(\al,\k2,\k1,\k3)}
\integer{kc=item(\al,\k3,\k2,\k1)}

\rational{x=\k2/\s}
\rational{y=\k3/\s}

\matrix{mat0=}
\matrix{mat1=}
\integer{r0=}
\integer{r1=}

\text{signe=\y>0?+}

\statement{Dans le plan, on considère le point \(G) défini par la relation vectorielle
<div class="wimscenter">
 \(\overrightarrow{\A G} = \x\overrightarrow{\A \B } \signe \y \overrightarrow{ \A \C})
</div>
 \(A),\(B) et \(C) étant des points donnés. Trouver trois
 <b>entiers relatifs</b> \(\ \alpha,\beta,\gamma) tels que
\(G) soit le barycentre des points pondérés
\( ( A,\alpha )), \(( B,\beta ) ) et \(( C,\gamma ) ).
<div class="wimscenter">
On a \(G) = Bary &#91; (A,\embed{reply 1,8}) ; (B,\embed{reply 2,8}) ;
(C,\embed{reply 3,8}) &#93;
</div>
}

\answer{Valeur de \(\alpha):}{\rep1}{type=rational}
\answer{Valeur de \(\beta):}{\rep2}{type=rational}
\answer{Valeur de \(\gamma):}{\rep3}{type=rational}

\matrix{mat0=\rep1,\rep2,\rep3
\rep1,\rep2,\rep3
}
\if{\al=1}{
\matrix{mat1=\k1,\k2,\k3;\rep1,\rep2,\rep3}
}

\if{\al=2}{
\matrix{mat1=\k1,\k2,\k3;\rep2,\rep3,\rep1}
}

\if{\al=3}{
\matrix{mat1=\k1,\k2,\k3;\rep3,\rep1,\rep2}
}

\integer{r0=pari(matrank([\mat0]))}

\integer{r1=pari(matrank([\mat1]))}

\condition{Vérification}{\r1=1 and \r0=1}

\solution{On obtient en utilisant la relation de Chasles:
<div class="spacer">
\if{\al=1}{\(G=\text{Bary}\lbrack (A,\k1) (B,\k2) (C,\k3)\rbrack)}
\if{\al=2}{\(G=\text{Bary}\lbrack (A,\k3) (B,\k1) (C,\k2)\rbrack)}
\if{\al=3}{\(G=\text{Bary}\lbrack (A,\k2) (B,\k3) (C,\k1)\rbrack)}
</div>
}
