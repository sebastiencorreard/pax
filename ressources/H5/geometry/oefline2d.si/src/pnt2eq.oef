\title{Iz dveh toèk v enaèbo}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(-20..20)}
\integer{a2=random(-20..20)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=\b2-(\b1)}
\integer{b=\a1-(\a2)}
\integer{c=(\a1)*(\b2)-(\a2)*(\b1)}
\function{eq=\a*x + \b*y = \c}

\statement{Neka premica v ravnini vsebuje toèki
(\a1&nbsp;,&nbsp;\b1) in (\a2&nbsp;,&nbsp;\b2).
Zapi¹ite njeno enaèbo v implicitni obliki \(ax + by = c).
}

\answer{Enaèba premice}{\eq}{type=equation}
