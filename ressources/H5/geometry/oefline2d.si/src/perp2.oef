\title{Pravokotnost II}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{a1=random(2..20)*random(-1,1)}
\integer{a2=random(2..20)*random(-1,1)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a1*(\x) + (\a2)*(\y)}
\function{eq=\a1*x + \a2*y = \t}
\text{ex=\a1*t + \b1}
\text{ey=\a2*t + \b2}

\statement{Ravninska premica \(p) je doloèena 
s parametriènima enaèbama
<p><center>
\(x = \ex)&nbsp;,
\(y = \ey) &nbsp;.
</center> <p>
Doloèite enaèbo njej pravokotne premice, ki vsebuje toèko
\((\x , \y)).
}

\answer{Enaèba pravokotnice}{\eq}{type=equation}
