\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\b*(\x) - (\a)*(\y)}
\text{L=\a*x + \b*y = \c}
\function{eq=\b*x - \a*y = \t}

\statement{Ravninska premica \(p) je doloèena z enaèbo
<p><center>\(\L)&nbsp;.</center> <p>
Doloèite enaèbo njej pravokotne premice, ki vsebuje toèko
\((\x , \y)).
}

\answer{Enaèba pravokotnice}{\eq}{type=equation}
