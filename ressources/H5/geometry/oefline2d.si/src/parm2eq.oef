\title{Parametrièna enaèba v implicitno}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(2..20)*random(-1,1)}
\integer{a2=random(2..20)*random(-1,1)}
\integer{b1=random(-10..10)*2}
\integer{b2=random(-10..9)*2+1}
\integer{a=-(\a2)}
\integer{b=\a1}
\integer{c=(\a)*(\b1)+(\b)*(\b2)}
\function{eq=\a*x + \b*y = \c}
\text{ex=\a1*t + \b1}
\text{ey=\a2*t + \b2}

\statement{Premica \(p) v ravnini je podana s parametriènima enaèbama:
<p><center>
\(x = \ex)&nbsp;,
\(y = \ey) &nbsp;.
</center> <p>
Zapi¹ite enaèbo te premice v implicitni obliki \(ax + by = c).

}

\answer{Enaèba premice}{\eq}{type=equation}
