\integer{a=random(2..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\integer{c=random(-20..20)}
\integer{x=random(-20..20)}
\integer{y=random(-20..20)}
\integer{t=\a*(\x) + (\b)*(\y)}
\text{L=\a*x + \b*y = \c}
\real{dist=abs((\t-(\c))/sqrt((\a)^2+(\b)^2))}

\statement{Premica \(p) v ravnini je doloèena z enaèbo
<p><center>\(\L) &nbsp;.</center> <p>
Kolik¹na je razdalja med premico \(p) in toèko
\(T(\x ,\y))?
}

\answer{Razdalja\((p,T))}{\dist}
