!set title=Mesure principale 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
computeanswer=yes

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 15

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
tmp0=!randint 1, $val6

val9=$[rint($(tmp0))]
!else
tmp1=!randint 1, $val6

val9=$[rint(-$(tmp1))]
!endif
val10=$[rint(2*$val7*$val6+$val9)]
val11=\frac{$val10 \pi}{$val6}

!ifval $val9=-$val6
val9=$[rint($val6)]
!endif
val12=$[$val9*pi/$val6]
replytype1=numeric
replyname1=Mesure principale de \(\alpha)
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère un angle 
!insmath \alpha
$() dont une mesure en radian est 
!insmath $val11
$().	<p>	Donner une mesure de cet angle appartenant à l'intervalle &#93;
!insmath -\pi;\pi
$()&#93;.	</p><p>	Mesure principale de 
!insmath \alpha
$()= 
!read oef/embed.phtml reply1,5 
$()	</p>	<div class="wims_instruction"> Taper <span class="tt">pi</span> pour 
!insmath pi
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11
embedcnt=1
