val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=0,\frac{\pi}{6},\frac{\pi}{4},\frac{\pi}{3},\frac{\pi}{2},\frac{\2\pi}{3},\frac{3\pi}{4},\frac{5\pi}{6},\pi,-\frac{5\pi}{6},-\frac{3\pi}{4},-\frac{2\pi}{3},-\frac{\pi}{2},-\frac{\pi}{3},-\frac{\pi}{4},-\frac{\pi}{6}
val6=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,-5/6,-3/4,-2/3,-1/2,-1/3,-1/4,-1/6
val7=,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3)
val8=1,0.5,0.5,0.5,0,-0.5,-0.5,-0.5,-1,-0.5,-0.5,-0.5,0,0.5,0.5,0.5
val9=,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),
val10=0,0.5,0.5,0.5,1,0.5,0.5,0.5,0,-0.5,-0.5,-0.5,-1,-0.5,-0.5,-0.5
tmp0=!itemcnt $val6

val11=$[rint($(tmp0))]
tmp0=!randint 1, $val11

val12=$[rint($(tmp0))]
val13=$(val6[$val12])
tmp0=!randint 1, 10

val14=$[rint($(tmp0))]
val15=$[$val14*$(val8[$val12])]
val16=$val15 $(val7[$val12])
val17=$[$val14*$(val10[$val12])]
val18=$val17 $(val9[$val12])
replyname1=module
replygood1=$val14
replyname2=argument
replygood2=$(val6[$val12])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

