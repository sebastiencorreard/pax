tmp=!trim u,v,v,w,w,t,	-u,-v,-v,-w,-w,-t,	v,u,w,v,t,w,	-v,-u,-w,-v,-t,-w,	u,-v,v,-w,w,-t,	-u,v,-v,w,-w,t,	v,-u,w,-v,t,-w,	-v,u,-w,v,-t,w
val6=!translate internal $	\
$ to ;; in $tmp
