val8=
val9=
val10=
val11=
val12=
val13=
val14=
val15=
!for val16 =1 to 3 
tmp0=!randint 2, 11

val17=$[rint($(tmp0))]
tmp0=!randitem 1,2

val18=$[rint($(tmp0))]

!ifval $val18=1
tmp0=!randint 1, 15

val19=$[rint($(tmp0)*2+1)]
!else
tmp1=!randint 1, 15

val19=$[rint($(tmp1)*2)]
!endif
tmp0=!randint 1, $val17-1

val20=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val21=$[rint($(tmp0))]
val22=$[rint($val17*$val19+$val20)]
t_=!rawmath $val22*$val21 / $val17
val23=!exec pari print($t_)
tmp0=!append item $val23 to $val10

val10=$(tmp0)

!ifval $val21=1
val24=\frac{$val22}{$val17}
!else
val24=-\frac{$val22}{$val17}
!endif
tmp0=!append item $val24 to $val11

val11=$(tmp0)
tmp0=!randint 1, 4

val25=$[rint($(tmp0))]
tmp0=!randint 1, 2

val26=$[rint($(tmp0))]
val27=$[rint(2*($val25-1)+$val26)]
val28=\((\overrightarrow{$(val6[$val27;($val16-1)*2+1])},\overrightarrow{$(val6[$val27;($val16-1)*2+2])})=$val24 \pi+2k \pi)
tmp0=!append item $val28 to $val12

val12=$(tmp0)
!if $val25=1 
val22=$[rint($val22*$val21)]
val29=$val19
val30=$[rint($val18)]
val31=$[rint($val21)]
!endif
!if $val25=2 
val22=$[rint($val22*(-1)*$val21)]
val29=$val19
val30=$[rint($val18)]
val31=$[rint(-1*($val21))]
!endif
!if $val25=3 
val22=$[rint(($val22+$val17)*$val21)]
val29=$val19-1

!ifval $val18=1
val30=$[rint(2)]
!else
val30=$[rint(1)]
!endif
val31=$[rint($val21)]
!endif
!if $val25=4 
val22=$[rint(($val22*(-1)+$val17)*$val21)]
val29=$val19+1

!ifval $val18=1
val30=$[rint(2)]
!else
val30=$[rint(1)]
!endif
val31=$[rint(-1*($val21))]
!endif
tmp0=!append item $val22 to $val8

val8=$(tmp0)
tmp0=!append item $val17 to $val9

val9=$(tmp0)
val32=impair,pair
val33=,-,,-

!ifval $val31=1
val34= 
!else
val34=-
!endif
val35=,,+ \(pi),+\(pi)
val36=\((\overrightarrow{$(val6[$val27;($val16-1)*2+1])},\overrightarrow{$(val6[$val27;($val16-1)*2+2])})) = $(val33[$val25]) $(val7[$val16]) $(val35[$val25])
val37=et $(val7[$val16])=$val34 \(\frac{$val17 \times $val19 + $val20}{$val17})\(pi) $(val35[$val25]) + \(2k pi).	Comme $val29 est $(val32[$val30]) la mesure principale de $(val7[$val16]) est 
!if ($val25=1 and $val21=1 and $val18=1) or ($val25=2 and $val21=-1 and $val18=1) or ($val25=3 and $val21=1 and $val18=2) or ($val25=4 and $val21=-1 and $val18=2) 
t_=!rawmath ($val20-$val17)/ $val17
val38=!exec pari print($t_)
val37=$val37 \(\frac{($val20 - $val17)\pi}{$val17})
!endif
!if ($val25=1 and $val21=1 and $val18=2) or ($val25=2 and $val21=-1 and $val18=2) or ($val25=3 and $val21=1 and $val18=1) or ($val25=4 and $val21=-1 and $val18=1) 
t_=!rawmath $val20 /$val17
val38=!exec pari print($t_)
val37=$val37 \(\frac{$val20 \pi}{$val17})
!endif
!if ($val25=1 and $val21=-1 and $val18=1) or ($val25=2 and $val21=1 and $val18=1) or ($val25=3 and $val21=-1 and $val18=2) or ($val25=4 and $val21=1 and $val18=2) 
t_=!rawmath ($val17-$val20)/ $val17
val38=!exec pari print($t_)
val37=$val37 \(\frac{($val17 - $val20)\pi}{$val17})
!endif
!if ($val25=1 and $val21=-1 and $val18=2) or ($val25=2 and $val21=1 and $val18=2) or ($val25=3 and $val21=-1 and $val18=1) or ($val25=4 and $val21=1 and $val18=1) 
t_=!rawmath -$val20 /$val17
val38=!exec pari print($t_)
val37=$val37 \(-\frac{$val20 \pi}{$val17})
!endif
