\text{lstangsin2=\crog \(0) \ptvirg \(\pi) \crod, \crog \(0) \ptvirg \(2\pi) \crog,\crog \(2\pi) \ptvirg \(3\pi) \crod, \crog \(2\pi) \ptvirg \(4\pi) \crog}
