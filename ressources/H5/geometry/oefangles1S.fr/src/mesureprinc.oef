\title{Mesure principale }
\author{Régine, Mangeard}
\computeanswer{yes}
\integer{den=randint(2..15)}
\integer{k=randint(2..9)}
\integer{j=randint(1,2)}
\integer{v=\j=1?randint(1..\den):-randint(1..\den)}
\integer{num=2*\k*\den+\v}
\text{valr=\frac{\num \pi}{\den}}
\integer{v=\v=-\den?\den}
\real{valrp=\v*pi/\den}
\statement{
On considère un angle \(\alpha) dont une mesure en radian est \(\valr).
<p>
Donner une mesure de cet angle appartenant à l'intervalle &#93;\(-\pi;\pi)&#93;.
</p><p>
Mesure principale de \(\alpha)=\embed{reply1,5}
</p>
<div class="wims_instruction"> Taper <span class="tt">pi</span> pour \(pi).</div>
}
\answer{Mesure principale de \(\alpha)}{\valrp}{type=numeric}
