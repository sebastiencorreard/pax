\title{Nature d'un quadrilatère}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}
## choix des angles
\matrix{anglst=u,v,v,w,w,t,
-u,-v,-v,-w,-w,-t,
v,-u,w,-v,t,-w,
-v,u,-w,v,-t,w,
u,-v,v,-w,w,-t,
-u,v,-v,w,-w,t,
v,u,w,v,t,w,
-v,-u,-w,-v,-t,-w}

## choix de l'angle alpha
\text{numlst=}
\text{denlst=}
\text{coeflst=}
\text{tcoeflst=}
\text{donnee=}
\text{mplst=}
  \integer{a=random(2..11)}
  \integer{p=random(1,2)}
  \integer{b=\p=1?random(1..15)*2+1:random(1..15)*2}
  \integer{c=random(1..\a-1)}
  \integer{s=random(1,-1)}
  \integer{num=\a*\b+\c}
  \rational{coef=\num*\s / \a}
  \text{ta1=\s=1?\frac{\num}{\a}:-\frac{\num}{\a}}
  \integer{num=\num*\s}
  \if{\s=1}
    {
    \rational{a1=\p=2?\c /\a:(\c-\a)/ \a}
    }
    {
    \rational{a1=\p=2?-\c/\a:(\a-\c)/\a}
    }
    \text{mpa1=\a1}
    \text{mpa1=wims(replace internal / by  , in \mpa1)}
    \text{mpa1=items(\mpa1)=1?\mpa1:\frac{\mpa1[1]}{\mpa1[2]}}
## choix de la nature
\integer{cas=random(1..3)}
##integer{cas=3}
\text{repl=carré,rectangle, parallélogramme,quelconque}
\text{quad=M P Q T}
\if{\cas=2}
  {
## rectangle
  \integer{n2=\a-\num+2*\a*random(0..10)}
  \integer{n3=\a+\num+2*\a*random(0..10)}
  \integer{n4=\num*(-1)+2*\a*random(0..10)}
  \integer{d2=\a}
  \integer{d3=\a}
  \integer{d4=\a}
  \text{tfeed= \((\overrightarrow{O A},\overrightarrow{O P}))=\( \pi - (\overrightarrow{O A},\overrightarrow{O M}))<br>
\((\overrightarrow{O A},\overrightarrow{O Q}))=\( \pi + (\overrightarrow{O A},\overrightarrow{O M}))<br>
\((\overrightarrow{O A},\overrightarrow{O T}))=\( - (\overrightarrow{O A},\overrightarrow{O M}))<br>
Donc \(M P Q T) est un rectangle.}
  \rational{a2=\a1<0?-\a1-1:1-\a1}
  \rational{a3=\a1<=0?1+\a1:\a1-1}
  \rational{a4=-\a1}


  }
\if{\cas=1}
  {
## carré
  \integer{d2=2*\a}
  \integer{d3=\a}
  \integer{d4=2*\a}
  \integer{n2=\a+ 2*\num+4*\a*random(0..10)}
  \integer{n3=\a+\num+2*\a*random(0..10)}
  \integer{n4=3*\a+2*\num+4*\a*random(0..10)}
  \text{tfeed= \((\overrightarrow{O A},\overrightarrow{O P}))=\( \frac{\pi}{2} + (\overrightarrow{O A},\overrightarrow{O M}))<br>
\((\overrightarrow{O A},\overrightarrow{O Q}))=\( \pi + (\overrightarrow{O A},\overrightarrow{O M}))<br>
\((\overrightarrow{O A},\overrightarrow{O T}))=\( \frac{3\pi}{2}+ (\overrightarrow{O A},\overrightarrow{O M}))<br>
Donc \(M P Q T) est un carré.}
  \rational{a2=\a1>1/2?\a1-3/2:\a1+1/2}
  \rational{a3=\a1<=0?1+\a1:\a1-1}
  \rational{a4=\a1>-1/2?\a1-1/2:\a1+3/2}

  }
\if{\cas=3}
  {
## quelconque
  \integer{cas=4}
  \integer{d2=2*\a}
  \integer{d3=4*\a}
  \integer{d4=3*\a}
  \integer{n2=\a+ 2*\num+4*\a*random(0..10)}
  \integer{n3=5*\a+4*\num+8*\a*random(0..10)}
  \integer{n4=2*\a+3*\num+6*\a*random(0..10)}
  \text{tfeed= \((\overrightarrow{O A},\overrightarrow{O Q})\not =)\( \pi + (\overrightarrow{O A},\overrightarrow{O M}))<br>
Donc \(M P Q T) n'est pas un parallélogramme, il est quelconque.}
  \rational{a2=\a1>1/2?\a1-3/2:\a1+1/2}
  \rational{a3=\a1<=-3/4?5/4+\a1:\a1-3/4}
  \rational{a4=\a1<=1/3?\a1+2/3:\a1-1/3}

  }
\text{ta2=\frac{\n2}{\d2}}
\text{ta3=\frac{\n3}{\d3}}
\text{ta4=\frac{\n4}{\d4}}
    \text{mpa2=\a2}
    \text{mpa2=wims(replace internal / by  , in \mpa2)}
    \text{mpa2=items(\mpa2)=1?\mpa2:\frac{\mpa2[1]}{\mpa2[2]}}
    \text{mpa3=\a3}
    \text{mpa3=wims(replace internal / by  , in \mpa3)}
    \text{mpa3=items(\mpa3)=1?\mpa3:\frac{\mpa3[1]}{\mpa3[2]}}
    \text{mpa4=\a4}
    \text{mpa4=wims(replace internal / by  , in \mpa4)}
    \text{mpa4=items(\mpa4)=1?\mpa4:\frac{\mpa4[1]}{\mpa4[2]}}

\statement{

Soit \(A) un point du cercle
trigonométrique \((C)) de centre \(O). \(M) est un point de
\((C)) tel que l'angle orienté
\((\overrightarrow{O A},\overrightarrow{O M})=\ta1 \pi + 2k \pi).<br>
Soit les points \(P,Q,T) du cercle \((C)) tels que:

<ul><li>
 \((\overrightarrow{O A},\overrightarrow{O P}))=\(\ta2)\(pi +2k pi)
 </li><li>
 \((\overrightarrow{O A},\overrightarrow{O Q}))=\(\ta3)\(pi +2k pi)
 </li><li>
 \((\overrightarrow{O A},\overrightarrow{O T}))=\(\ta4)\(pi +2k pi)
 </li></ul>

Quelle est la nature du quadrilatère \(\quad)?
<div class="wimscenter"> \embed{reply 1}</div>
 }
\answer{nature}{\cas;\repl}{type=menu}
\feedback{1=1}{Calculons les mesures principales des angles:<br>
\((\overrightarrow{O A},\overrightarrow{O M})=\mpa1 \pi )<br>
 \((\overrightarrow{O A},\overrightarrow{O P}))=\(\mpa2 \pi)<br>
 \((\overrightarrow{O A},\overrightarrow{O Q}))=\(\mpa3 \pi)<br>
 \((\overrightarrow{O A},\overrightarrow{O T}))=\(\mpa4 \pi)<br>
Donc \tfeed}
