\title{Coordonnées cartésiennes vers polaires}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{no}
\format{html}
\precision{100}


## choix de l'angle
\text{lstangle=0,\frac{\pi}{6},\frac{\pi}{4},\frac{\pi}{3},\frac{\pi}{2},\frac{\2\pi}{3},\frac{3\pi}{4},\frac{5\pi}{6},\pi,-\frac{5\pi}{6},-\frac{3\pi}{4},-\frac{2\pi}{3},-\frac{\pi}{2},-\frac{\pi}{3},-\frac{\pi}{4},-\frac{\pi}{6}}
\text{lstangle=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,-5/6,-3/4,-2/3,-1/2,-1/3,-1/4,-1/6}
\text{lstabsf=,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3)}
\text{lstabsm=1,0.5,0.5,0.5,0,-0.5,-0.5,-0.5,-1,-0.5,-0.5,-0.5,0,0.5,0.5,0.5}
\text{lstordf=,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),,,,sqrt(2),sqrt(3),,sqrt(3),sqrt(2),}
\text{lstordm=0,0.5,0.5,0.5,1,0.5,0.5,0.5,0,-0.5,-0.5,-0.5,-1,-0.5,-0.5,-0.5}
\integer{nbang=items(\lstangle)}
\integer{indang=random(1..\nbang)}
\text{tangle=\lstangle[\indang]}
\integer{modu=random(1..10)}
\real{abs=\modu*\lstabsm[\indang]}
\text{tabs=\abs \lstabsf[\indang]}
\real{ord=\modu*\lstordm[\indang]}
\text{tord=\ord \lstordf[\indang]}

\statement{
Déterminer les coordonnées polaires du point \(M) de coordonnées cartésiennes:
<div class="wimscenter"> \((\tabs;\tord))</div>
 Votre réponse
<ul><li>
Module =\embed{reply 1,4}
</li><li>
Mesure principale de l'argument =\embed{reply 2,4}\(\pi)
</li></ul>
 }
\answer{module}{\modu}{numeric}
\answer{argument}{\lstangle[\indang]}{numeric}
