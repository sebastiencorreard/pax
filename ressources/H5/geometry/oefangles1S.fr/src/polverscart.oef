\title{Coordonnées polaires vers cartésiennes}
\language{fr}
\range{-5..5}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{100}


## choix de l'angle
\integer{num=random(0..10)}
\integer{den=random(2..5)}
\text{tangle=\num=0?0:\frac{\num \pi}{\den}}
\integer{s=random(1,-1)}
\rational{angle=\s*\num / \den}
\if{\angle!=0} {
\text{tangle=\s=-1?-\tangle}}

## choix du module
\integer{numM=random(1..10)}
\integer{denM=random(2..5)}
\rational{modu=simplify(\numM / \denM)}
\text{tmodl=\modu}
\text{tmodl=wims(replace internal / by , in \tmodl)}
\text{tmod=items(\tmodl)=1?\tmodl[1]:\frac{\tmodl[1]}{\tmodl[2]}}

## calcul de la réponse
\real{a=evalue(\modu* cos(x*pi), x=\angle)}
\real{b=evalue(\modu* sin(x*pi), x=\angle)}

\statement{
Déterminer les coordonnées cartésiennes du point \(M) de coordonnées polaires:
<div class="wimscenter"> &#91;\(\tmod;\tangle)&#93;</div>
 Votre réponse
<div class="wimscenter">abscisse =\embed{reply 1,10} <br>
ordonnée =\embed{reply 2,10}
</div>
<div class="wims_instruction">
Aide à la saisie: pour saisir une racine carrée, taper
<span class="tt">sqrt(..)</span>, ex pour \(\frac{\sqrt(2)}{2}), taper
<span class="tt">sqrt(2)/2</span>.
</div>
 }
\answer{abscisse}{\a}{numeric}
\answer{ordonnée}{\b}{numeric}
