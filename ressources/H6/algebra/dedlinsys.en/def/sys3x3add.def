!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Solve the linear system
val8=The solution is
!if $val6=fr 
val7=Résoudre le système linéaire
val8=La solution est
!endif
m_environ=QQ
m_options=nofloat fixedgoal
m_minsteps=6
m_methods=eq/lincomb, eq/addnum, eq/mulnum, eq/divnum, eq/exsides, eq/addterm
tmp0=!randitem a,b,c,d,r,s,t,x,y,z

val9=$(tmp0)
val9=x
val10=y
val11=z
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
val16=$[rint(abs(($val13)*($val15)/($val12)))]

!ifval $val16>11
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val17=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val16+2, $val16+6

tmp3=!randitem -1,1

val17=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val18=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val19=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
val16=$[rint(abs((($val19)*($val17)*($val14)-($val19)*($val18)*($val13)+($val20)*($val18)*($val12)-($val20)*($val15)*($val14))	  /(($val12)*($val17)-($val13)*($val15))))]

!ifval $val16>11
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val16+2, $val16+6

tmp3=!randitem -1,1

val21=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint -20, 20

val22=$[rint($(tmp0))]
tmp0=!randint -20, 20

val23=$[rint($(tmp0))]
tmp0=!randint -20, 20

val24=$[rint($(tmp0))]
val25=$[rint(($val12)*($val22)+($val13)*($val23)+($val14)*($val24))]
val26=$[rint(($val15)*($val22)+($val17)*($val23)+($val18)*($val24))]
val27=$[rint(($val19)*($val22)+($val20)*($val23)+($val21)*($val24))]
val28=!rawmath $val12*$val9 + $val13*$val10 + $val14*$val11
val29=!rawmath $val15*$val9 + $val17*$val10 + $val18*$val11
val30=!rawmath $val19*$val9 + $val20*$val10 + $val21*$val11
val31=$val9 = $val22
val32=$val10 = $val23
val33=$val11 = $val24
m_context=$val28 = $val25	$val29 = $val26	$val30 = $val27
m_goal=$val31	$val32	$val33	
tmp0=!texmath $val28 = $val25

val34=$(tmp0)
tmp0=!texmath $val29 = $val26

val35=$(tmp0)
tmp0=!texmath $val30 = $val27

val36=$(tmp0)
tmp0=!replace internal = by &= in	  $val34\\$val35\\$val36

val37=$(tmp0)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

