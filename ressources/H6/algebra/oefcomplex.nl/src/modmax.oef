\title{Modulus II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\real{mod=sqrt((\a)^2+(\b)^2)}
\integer{modz=random(1..9)}
\real{re=\a*\modz/\mod}
\real{im=\b*\modz/\mod}

\statement{
Zoek uit complexe getallen z met |z|=\modz ,<br>
het complexe getal waarvoor geldt dat de modulus  \a\B\i+z maximaal is.}

\answer{Re(z)}{\re}
\answer{Im(z)}{\im}

