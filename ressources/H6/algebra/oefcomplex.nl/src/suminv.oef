\title{Som met inverse}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{sign=random(1,2)}
\text{right=item(\sign,-1,1)}
\text{X=X}
\text{z=z}
\integer{power=random(100..999)}
\integer{sol=\power%3=0?2:-1}
\integer{sol=\sign=1 or \power%2=0?\sol:-(\sol)}

\statement{
Gegeven het complexe getal \z met z+1/z=\right.<br>
Bepaal het getal w=\z<sup>\power</sup>+\z<sup>-\power</sup>&nbsp;?}

\answer{Re(w)}{\sol}
\answer{Im(w)}{0}


