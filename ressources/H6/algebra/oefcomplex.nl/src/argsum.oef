\title{Modulus en Argument III}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a1=random(-20..20)}
\integer{b1=random(2..20)*random(-1,1)}
\integer{a2=random(-20..20)}
\integer{b2=random(2..20)*random(-1,1)}
\integer{b2=\b1+(\b2)=0?\b1}
\integer{a=\a1+(\a2)}
\integer{b=\b1+(\b2)}
\text{B1=\b1>=0?+\b1:\b1}
\text{B2=\b2>=0?+\b2:\b2}
\real{mod=sqrt((\a)^2+(\b)^2)}
\real{ar=\b>0?pi/2:-pi/2}
\real{at=\a=0?\ar:arctan(\b/(\a))}
\real{Arg=\a<0?\at+pi:\at}

\statement{Gegeven z<sub>1</sub>=\a1\B1\i en  z<sub>2</sub>=\a2\B2\i.
<br>
Geef modulus en argument van:  z=z<sub>1</sub>+z<sub>2</sub>.}

\answer{|z|}{\mod}
\answer{Arg(z)}{\arg}
\condition{\arg is een argument van z}
	{abs((\arg-\Arg)/(2*pi)-round((\arg-\Arg)/(2*pi)))<0.0001}
