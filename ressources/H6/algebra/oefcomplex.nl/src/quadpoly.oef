\title{Vierkants wortel IV}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\text{X=<i>X</i>}
\text{r1=<i>r</i><sub>1</sub>}
\text{r2=<i>r</i><sub>2</sub>}
\real{re1=random(-1,1)*randint(2..50)/10}
\real{im1=random(-1,1)*randint(2..50)/10}
\real{re2=random(-1,1)*randint(2..50)/10}
\real{im2=random(-1,1)*randint(2..50)/10}
\real{rec1=-(\re1)-(\re2)}
\real{imc1=-(\im1)-(\im2)}
\real{rec2=(\re1)*(\re2)-(\im1)*(\im2)}
\real{imc2=(\re1)*(\im2)+(\re2)*(\im1)}
\text{imC1=\imc1>=0?+\imc1:\imc1}
\text{imC2=\imc2>=0?+\imc2:\imc2}

\statement{
Bepaal de twee wortels van de polynoom<p><center>
<i>P</i>(\X) = \X<sup>2</sup> + (\rec1\imC1\i)\X + (\rec2\imC2\i).
</center> <p>
Je mag de twee wortels  \r1,\r2 in elke volgorde ingeven.
}
\answer{Re(\r1)}{\rer1}
\answer{Im(\r1)}{\imr1}
\answer{Re(\r2)}{\rer2}
\answer{Im(\r2)}{\imr2}

\condition{\r1 is een wortel}
{(\rer1=\re1 and \imr1=\im1) or (\rer1=\re2 and \imr1=\im2)}
\condition{\r2 is de andere wortel}
{((\rer2=\re1 and \imr2=\im1) or (\rer2=\re2 and \imr2=\im2))
 and \rer1+\rer2=-(\rec1)}
