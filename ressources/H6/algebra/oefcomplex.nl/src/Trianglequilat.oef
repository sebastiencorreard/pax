\title{Gelijkzijdige driehoek}
\language{nl}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=random(0..9)}
\integer{b=random(0..9)}
\integer{c=random(1..9)}
\integer{d=random(1..9)}
\integer{cc=\c-\a}
\integer{dd=\d-\b}
\real{r= \a+(\cc-\dd*3^(1/2))/2}
\real{r1= \a+(\cc+\dd*3^(1/2))/2} 
\real{j= \b+ (\cc*3^(1/2)+\dd)/2}
\real{j1= \b+ (-\cc*3^(1/2)+\dd)/2}
\complex{z= \a+\b*i}
\complex{z1= \c+\d*i}

\statement{Laat \(A ) en \(B) punten zijn in het complexe vlak, corresponderend met \(\z) en \(\z1).<br>
Bepaal het complexe getal van het punt \(M) , zo dat de driehoek \(ABM) gelijkzijdig is.
}

\hint{\(AM) is het beeld van \(AB) bij een rotatie. Welke rotatie?}
\answer{\(Re(z))}{\rep}{type=default}
\answer{\(Im(z))}{\ima}{type=default}

\condition{\( z=\rep+\ima *i)}{(\rep=\r  and \ima=\j) or (\ima=\j1 and \rep=\r1)}
