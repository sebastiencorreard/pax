\title{Pentaroot}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\text{z3=z<sub>3</sub>}
\text{z4=z<sub>4</sub>}
\integer{type=random(1,2)}
\integer{power=\type=1?5*random(20..99)+random(1..4):5*random(20..99)}
\integer{sol=\type=1?-1:4}

\statement{Laat \z1,\z2,\z3,\z4 de vier (complexe) wortels zijn van de polynoom
X<sup>4</sup>+X<sup>3</sup>+X<sup>2</sup>+X+1.
<br>
Wat is dan het getal w waarvoor geldt:
w=\z1<sup>\power</sup>+\z2<sup>\power</sup>+\z3<sup>\power</sup>+\z4<sup>\power</sup> ?}

\answer{Re(w)}{\sol}
\answer{Im(w)}{0}
