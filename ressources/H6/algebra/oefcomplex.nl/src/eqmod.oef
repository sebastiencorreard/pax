\title{Vergelijkingen I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{3000}

\text{i=<i>i</i>}
\integer{a=random(1..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\integer{type=random(1,2)}
\text{sign=item(\type,+,-)}
\text{s2=item(\type,,-)}
\real{im=\b}
\real{re=((\a)^2-(\b)^2)/(2*(\a))}
\function{z=(\a>0 and \type=1) or (\a<0 and \type=2)?\re+(\im)*i:0+0*i}

\statement{Los de onderstaande vergelijking op in $m_CC <br>
z\sign|z|&nbsp;=&nbsp;\a\B\i.
<p>(Geef <tt>0</tt> of
<tt>0+0*i</tt> als je denkt dat er geen oplossing mogelijk is.)
}

\answer{z}{\z}
\hint{In het complexe vlak , vormen de Oorsprong en punten \s2|z| en \a\B\i een gelijkzijdige driehoek... waarom?.}

