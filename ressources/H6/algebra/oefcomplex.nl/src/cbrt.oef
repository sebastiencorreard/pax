\title{CBRT}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{sign=random(1,2)}
\text{st=item(\sign,+,-)}
\text{X=X}
\text{z=z}
\integer{power=random(100..999)}
\integer{sol=\power%3=0?2:-1}
\integer{sol=\sign=1 or \power%2=0?\sol:-(\sol)}
\text{style=random(een complex getal zijn&sbquo; zo dat
	\z<sup>2</sup>\st\z+1=0,
	een (complexe) wortel zijn van de polynoom X<sup>2</sup>\st\X+1)}
\statement{Laat \z \style .<br>
Wat is dan het getal w , waarvoor geldt: w&nbsp;=&nbsp;\z<sup>\power</sup>+\z<sup>-\power</sup>&nbsp;?}
\answer{Re(w)}{\sol}
\answer{Im(w)}{0}

