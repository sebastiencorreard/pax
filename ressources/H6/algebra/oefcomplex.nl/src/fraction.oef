\title{Breuken I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a1=random(-10..10)}
\integer{b1=random(2..10)*random(-1,1)}
\integer{a2=random(1..10)*random(-1,1)}
\integer{b2=random(2..10)*random(-1,1)}
\text{B1=\b1>=0?+\b1:\b1}
\text{B2=\b2>=0?+\b2:\b2}
\real{mod=(\a2)^2+(\b2)^2}
\real{re=(\a1*(\a2)+(\b1)*(\b2))/\mod}
\real{im=(\b1*(\a2)-(\a1)*(\b2))/\mod}

\statement{
Bepaal het re&euml;le en imaginaire deel van het onderstaande complexe getal:
<p><center><table border=0 cellspacing=0 cellpadding=0>
<tr><td align=center><u>\a1\B1\i</u></td><tr><td align=center>\a2\B2\i</td>
</table></center>}

\answer{Re&euml;le deel}{\re}
\answer{Imaginaire deel}{\im}

