\title{Vierkants wortel II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\text{aa=<i>a</i>}
\text{bb=<i>b</i>}
\text{w=<i>w</i>}
\integer{re=random(1..10)*random(-1,1)}
\integer{im=random(2..10)*random(-1,1)}
\integer{a=-2*(\re)}
\integer{b=-2*(\im)}
\text{B=\b>0?+\b:\b}
\integer{Re=(\re)^2-(\im)^2}
\integer{Im=2*(\re)*(\im)}
\text{IM=\Im>=0?+\Im:\Im}
\text{iM=\im>=0?+\im:\im}

\statement{
Voor welke -complexe- waarde van \w heeft de polynoom
<p><center>
X<sup>2</sup>+(\a\B\i)X+\w
</center> <p>een complexe dubbel wortel?}
\answer{\w}{\Re\IM*i}
\answer{De dubbele wortel}{\re\iM*i}

