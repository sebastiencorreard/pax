\title{Twee wortels I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{impur=puur imaginair}
\text{real=ree&euml;l}
\text{zero=gelijk aan nul}
\text{nor=niet ree&euml;l en niet imaginair}
\text{choices=\real,\impur,\zero,\nor}
\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{type=random(1,2)}
\text{p=item(\type,\real,\impur)}
\text{good=item(\type,\impur,\real)}

\statement{Laat \z1,\z2 de twee wortels van een polynoom
P(X)=X<sup>2</sup>+pX+q zijn, waarin p is \p, q is ree&euml;l.<br>
Veronderstel \z1 en \z2 nog ree&euml;l , nog puur imaginair zijn.
Dan is het getal \z1-\z2 : ____________.}

\choice{}{\good}{\choices}

