\title{Wortels en co&euml;fficienten}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{im=random(1..20)*random(-1,1)}
\integer{sq=(\im)^2}

\statement{Laat P(X)=X<sup>2</sup>+pX+q
een polynoom zijn met re&euml;le co&euml;fficienten p en q.<br>
Gegeven is dat P een complexe wortel heeft, waarvan het imaginaire gedeelte gelijk is aan \im.<br> 
Dan is er een relatie tussen de co&euml;fficienten p en q.<br>
Bepaal deze realatie, en geeft q als functie van p. }

\answer{q}{\sq+0.25*p^2}
\solution{Als z=a+(\im)*\i, dan is de andere wortel w van P:  w=a-(\im)*\i.
En dus is p=-2a, of a=-0.5*p. en q=z*w=a^2+(\im)^2=(\im)^2+0.25*p^2.}
