\title{Modulus IV}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{type=random(1,2)}
\text{sign=item(\type,+,-)}
\integer{m1=random(2..10)}
\integer{m2=random(2..10)}
\integer{ang=random(10..170)}
\real{\m3=sqrt(\m1^2+\m2^2\sign 2*\m1*\m2*cos(\ang*pi/180))}

\statement{Laat \z1 en \z2 twee complexe getallen zijn met
|\z1|=\m1, |\z2|=\m2, en Arg(\z1/\z2)=\ang <sup>o</sup> (graden).
Bepaal de modulus van \z1\sign\z2&nbsp;.}

\answer{|\z1\sign\z2|}{\m3}
\hint{
Denk aan de cosinus:<br>
Als een driehoek met zijden <i>a,b,c</i>, en met <i>A</i> als de hoek tegenover zijde <i>a</i>,dan geldt:<p><center>
<i>a</i><sup>2</sup>&nbsp;=&nbsp;<i>b</i><sup>2</sup>+<i>c</i><sup>2</sup
>-2<i>bc</i>&nbsp;cos(<i>A</i>)&nbsp;.
</center>}

