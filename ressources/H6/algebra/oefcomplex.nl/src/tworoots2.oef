\title{Twee wortels II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{X=X}
\text{impur=puur imaginair}
\text{real=ree&euml;l}
\text{zero=gelijk aan nul}
\text{nor=nog ree&euml;l &sbquo; nog puur imaginair}
\text{choices=\real,\impur,\zero,\nor}
\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{c=random(2..8)*random(-1,1)}
\text{C=\c>0?+\c:\c}
\integer{type=random(1,2)}
\text{I=\type=2?\i:}
\integer{type2=random(1,2)}
\text{dir=\type2=1?&gt;100:&lt;-100}
\text{good=\type2=1?\impur:\real}

\statement{Laat \z1,\z2 de twee wortels van de polynoom
P(X)=X<sup>2</sup>\C\I\X+q zijn, met daar in  q\dir als een ree&euml;l getal.
Dab is  \z1-\z2 een ____________ getal.}

\choice{}{\good}{\choices}

