\title{Modulus en Argument II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\real{mod=randint(1..100)/10}
\real{a1=randint(1..100)/10*random(-1,1)}
\integer{type=random(1,2)}
\real{arg=\type=1?\a1:\a1*pi}
\text{Arg=\type=1?\a1:\a1*pi}
\real{re=cos(\Arg)*\mod}
\real{im=sin(\Arg)*\mod}

\statement{Bepaal het re&euml;le en imaginaire deel van het complexe getal z , met als modulus |z|=\mod , en argument \Arg .}

\answer{Re(z)}{\re}
\answer{Im(z)}{\im}

