\title{Modulus I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\real{mod=sqrt((\a)^2+(\b)^2)}
\integer{modz=random(1..99)}
\integer{type=random(1,2)}
\text{mum=item(\type,maximum,minimum)}
\real{sol=item(\type,\mod+\modz,abs(\mod-\modz))}

\statement{Wat is het \mum van de modulus |\a\B\i+z|, waarin z 
een complex getal is met |z|=\modz ?}

\answer{\mum of module}{\sol}

