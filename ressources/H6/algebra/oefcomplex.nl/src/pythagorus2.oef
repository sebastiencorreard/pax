\title{Pythagoras II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\text{l1=      1,      1,      2,3, 5, 7}
\text{l2=      1,      2,      2,4,12,24}
\text{l3=sqrt(2),sqrt(5),sqrt(8),5,13,25}
\integer{n=items(\l1)}
\integer{t=random(1..\n)}
\real{n1=item(\t,\l1)}
\real{n2=item(\t,\l2)}
\text{m3=item(\t,\l3)}
\integer{exchange=random(1,2)}
\text{m1=item(\exchange,\n1,\n2)}
\text{m2=item(\exchange,\n2,\n1)}

\statement{
Laat \z1 en \z2 twee complexe getallen zijn met
|\z1|=\m1 en |\z1+\z2|=|\z1-\z2|=\m3.<br>
Wat is dan de waarde van |\z2|&nbsp;?}

\answer{Je antwoord}{\m2}
\hint{Denk aan Pythagoras ! Wat is het verschil tussen Arg(\z1) en Arg(\z2)?}
