!set title=Modulus III
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
val7=z<sub>1</sub>
val8=z<sub>2</sub>
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of +,-

val10=$(tmp0)
tmp0=!item $val9 of -,+

val11=$(tmp0)
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
tmp0=!randint $val12, $val12+10

val13=$[rint($(tmp0))]
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of Yes,No

val15=$(tmp0)
tmp0=!randint $val13, $val12+$val13

tmp1=!randint $val12+$val13+1, $val12+$val13+6

tmp2=!item $val14 of $(tmp0),$(tmp1)

val16=$[rint($(tmp2))]
tmp0=!randint 1, 6

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val12,$val12,$val13,$val13,$val16,$val16

val18=$(tmp0)
tmp0=!item $val17 of $val13,$val16,$val12,$val16,$val13,$val12

val19=$(tmp0)
tmp0=!item $val17 of $val16,$val13,$val16,$val12,$val12,$val13

val20=$(tmp0)
choicename1=Je antwoord
choicegood1=$val15
choicebad1=Ja,Nee
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Bestaan er twee complexe getallen $val7 en $val8 zo dat geldt:	|$val7|=$val18 , |$val8|=$val19 , |$val7$val10$val8|=$val20 ?
$()
!exit

:hint
$()Welke voorwaarden zijn er voor de lengtes van de 3 zijden van een driehoek ...?
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,18,19,20
embedcnt=0
