!set title=Gelijkzijdige driehoek
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette PERRIN-RIOU
email=bpr@math.u-psud.fr
computeanswer=yes
precision=1000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 9

val6=$[rint($(tmp0))]
tmp0=!randint 0, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
val10=$[rint($val8-$val6)]
val11=$[rint($val9-$val7)]
val12=$[$val6+($val10-$val11*3^(1/2))/2]
val13=$[$val6+($val10+$val11*3^(1/2))/2]
val14=$[$val7+ ($val10*3^(1/2)+$val11)/2]
val15=$[$val7+ (-$val10*3^(1/2)+$val11)/2]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
t_=!rawmath $val8+$val9*i
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
replytype1=default
replyname1=\(Re(z))
replygood1=?analyze 18
replytype2=default
replyname2=\(Im(z))
replygood2=?analyze 19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Laat 
!insmath A 
$() en 
!insmath B
$() punten zijn in het complexe vlak, corresponderend met 
!insmath $val16
$() en 
!insmath $val17
$().<br>	Bepaal het complexe getal van het punt 
!insmath M
$() , zo dat de driehoek 
!insmath ABM
$() gelijkzijdig is.	
$()
!exit

:hint
$()
!insmath AM
$() is het beeld van 
!insmath AB
$() bij een rotatie. Welke rotatie?
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val18=$val12  and $val19=$val14) or ($val19=$val15 and $val18=$val13)
 condtest1=1
!else
 condtest1=0
!endif
condname1=\( z=$val18+$val19 *i)

!exit

:stat
vsavelist=12,13,14,15,16,17,18,19
embedcnt=0
