!set title=Vierkants wortel I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]

!ifval $val7>=0
val8=+$val7
!else
val8=$val7
!endif
val9=<i>i</i>
replyname1=Re(w)
replygood1=?analyze 10
replyname2=Im(w)
replygood2=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Bepaal het re&euml;le en imaginaire deel van de vierkants wortel w van het complexe getal:	z&nbsp;=&nbsp;$val6$val8$val9 .	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val10)^3-3*($val10)*($val11)^2=$val6
 condtest1=1
!else
 condtest1=0
!endif
condname1=Re(w<sup>3</sup>)=$val6

!ifval 3*($val10)^2*($val11)-($val11)^3=$val7
 condtest2=1
!else
 condtest2=0
!endif
condname2=Im(w<sup>3</sup>)=$val7

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=0
