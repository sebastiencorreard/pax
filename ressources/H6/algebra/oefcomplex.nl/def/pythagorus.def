!set title=Pythagoras I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
val7=z<sub>1</sub>
val8=z<sub>2</sub>
val9=1,      1,      2,3, 5, 7
val10=1,      2,      2,4,12,24
val11=sqrt(2),sqrt(5),sqrt(8),5,13,25
tmp0=!itemcnt $val9

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val12

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val9

val14=$[$(tmp0)]
tmp0=!item $val13 of $val10

val15=$[$(tmp0)]
tmp0=!item $val13 of $val11

val16=$(tmp0)
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val14,$val15

val18=$(tmp0)
tmp0=!item $val17 of $val15,$val14

val19=$(tmp0)
tmp0=!randitem 1,2

val20=$[rint($(tmp0))]
tmp0=!item $val20 of +,-

val21=$(tmp0)
tmp0=!item $val20 of -,+

val22=$(tmp0)
replyname1=Je antwoord
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Laat $val7 en $val8 twee complexe getallen zijn met 	|$val7|=$val18, |$val8|=$val19, |$val7$val21$val8|=$val16. 	<br>Wat is dan de waarde van |$val7$val22$val8|&nbsp;?
$()
!exit

:hint
$()	Denk aan Pythagoras !	Wat is het verschil tussen Arg($val7) en Arg($val8)?
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,16,18,19,21,22
embedcnt=0
