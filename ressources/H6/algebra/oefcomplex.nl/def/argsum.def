!set title=Modulus en Argument III
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val8+($val10)=0
val10=$[rint($val8)]
!endif
val11=$[rint($val7+($val9))]
val12=$[rint($val8+($val10))]

!ifval $val8>=0
val13=+$val8
!else
val13=$val8
!endif

!ifval $val10>=0
val14=+$val10
!else
val14=$val10
!endif
val15=$[sqrt(($val11)^2+($val12)^2)]

!ifval $val12>0
val16=$[pi/2]
!else
val16=$[-pi/2]
!endif

!ifval $val11=0
val17=$[$val16]
!else
val17=$[arctan($val12/($val11))]
!endif

!ifval $val11<0
val18=$[$val17+pi]
!else
val18=$[$val17]
!endif
replyname1=|z|
replygood1=$val15
replyname2=Arg(z)
replygood2=?analyze 19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Gegeven z<sub>1</sub>=$val7$val13$val6 en  z<sub>2</sub>=$val9$val14$val6.	<br>	Geef modulus en argument van:  z=z<sub>1</sub>+z<sub>2</sub>.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval abs(($val19-$val18)/(2*pi)-round(($val19-$val18)/(2*pi)))<0.0001
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val19 is een argument van z

!exit

:stat
vsavelist=6,7,9,13,14,18,19
embedcnt=0
