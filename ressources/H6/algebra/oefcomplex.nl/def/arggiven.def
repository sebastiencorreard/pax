tmp0=!randint 1, 100

tmp1=!randitem -1,1

val8=$[$(tmp0)/10*$(tmp1)]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval $val9=1
val10=$[$val8]
!else
val10=$[$val8*pi]
!endif

!ifval $val9=1
