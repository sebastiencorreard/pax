!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randint 100, 200

val8=$[rint($(tmp0))]
val9=$[rint($val7+1)]
val10=$[rint($val7+2)]
val11=$[rint($val7%4+1)]
val12=$[rint(($val8+1-$val7)%4)]

!ifval $val12=0
val13=$[0]
!endif

!ifval $val12=0
val14=$[0]
!endif

!ifval $val12=1
tmp0=!item $val11 of 1,0,-1,0

val13=$[$(tmp0)]
!endif

!ifval $val12=1
tmp0=!item $val11 of 0,1,0,-1

val14=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of 1,-1,-1,1

val13=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of 1,1, -1,-1

val14=$[$(tmp0)]
!endif

!ifval $val12=3
tmp0=!item $val11 of 0,-1,0,1

val13=$[$(tmp0)]
!endif

!ifval $val12=3
tmp0=!item $val11 of 1,0,-1,0

val14=$[$(tmp0)]
!endif
replyname1=Re(S)
replygood1=$val13
replyname2=Im(S)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

