!set title=Vierkants wortel IV
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
val7=<i>X</i>
val8=<i>r</i><sub>1</sub>
val9=<i>r</i><sub>2</sub>
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val10=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val11=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val12=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val13=$[$(tmp0)*$(tmp1)/10]
val14=$[-($val10)-($val12)]
val15=$[-($val11)-($val13)]
val16=$[($val10)*($val12)-($val11)*($val13)]
val17=$[($val10)*($val13)+($val12)*($val11)]

!ifval $val15>=0
val18=+$val15
!else
val18=$val15
!endif

!ifval $val17>=0
val19=+$val17
!else
val19=$val17
!endif
replyname1=Re($val8)
replygood1=?analyze 20
replyname2=Im($val8)
replygood2=?analyze 21
replyname3=Re($val9)
replygood3=?analyze 22
replyname4=Im($val9)
replygood4=?analyze 23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Bepaal de twee wortels van de polynoom<p><center>	<i>P</i>($val7) = $val7<sup>2</sup> + ($val14$val18$val6)$val7 + ($val16$val19$val6).	</center> <p>	Je mag de twee wortels  $val8,$val9 in elke volgorde ingeven.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val20=$val10 and $val21=$val11) or ($val20=$val12 and $val21=$val13)
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val8 is een wortel

!ifval (($val22=$val10 and $val23=$val11) or ($val22=$val12 and $val23=$val13))	 and $val20+$val22=-($val14)
 condtest2=1
!else
 condtest2=0
!endif
condname2=$val9 is de andere wortel

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,14,16,18,19,20,21,22,23
embedcnt=0
