!set title=和的次数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=100000

ansorder=c,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>P</i>
val7=<i>Q</i>
val8=<i>X</i>
tmp0=!randint 2, 20

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!item $val10 of $val9,$(tmp0)

val11=$[rint($(tmp1))]
tmp0=!randint 1, 6

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val6($val8)+$val7($val8),$val6($val8)-$val7($val8),	            $val6($val8)$val7($val8),$val6($val8)$val7($val8),	            $val6($val7($val8)),$val7($val6($val8))

val13=$(tmp0)
val14=$[rint(max($val9,$val11))]
tmp0=!item $val12 of $val14,$val14,$val9+$val11,$val9+$val11,$val9*$val11,$val9*$val11

val15=$[rint($(tmp0))]
val16=大于或等于数 d
val17=小于或等于数 d
val18=等于数 d

!ifval $val12<=2 and $val9=$val11
val19=$val17
!else
val19=$val18
!endif
replyname1=其中 d
replygood1=$val15
choicename1=次数
choicegood1=$val19
choicebad1=$val16,$val17,$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val6($val8) 和 $val7($val8) 是两个多项式. 问:	<p>	若 deg($val6)=$val9 及 deg($val7)=$val11,	则 $val13 是一个多项式, 它的次数为	
$()
