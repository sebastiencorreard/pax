!set title=2次参数方程
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=c,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>m</i>
tmp0=!randint 1, 10

tmp1=!randitem -2,2

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -2,2

val9=$[rint($(tmp0)*$(tmp1)+1)]
tmp0=!randint 1, 10

tmp1=!randitem -2,2

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val8>0
val11=+$val8
!else
val11=$val8
!endif

!ifval $val9>0
val12=+$val9
!else
val12=$val9
!endif

!ifval $val10>0
val13=+$val10
!else
val13=$val10
!endif
val14=$[$val9-$val8-$val10]
tmp0=!randitem 1,2,3

val15=$[rint($(tmp0))]
tmp0=!item $val15 of 两个单实根,	    一对共轭复根,	    一个二重根

val16=$(tmp0)

!ifval $val14>0
tmp0=!item $val15 of $val7&gt;c,$val7&lt;c,$val7=c

val17=$(tmp0)
!endif

!ifval $val14<0
tmp0=!item $val15 of $val7&lt;c,$val7&gt;c,$val7=c

val17=$(tmp0)
!endif
val18=$[-0.25*(($val9)^2-4*($val8)*($val10))/($val14)]
replyname1=其中 c
replygood1=$val18
choicename1=条件是
choicegood1=$val17
choicebad1=$val7&gt;c,$val7&lt;c,$val7=c
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()参数 $val7 取什么实数值时, 多项式	<p><center>	($val7$val11)$val6<sup>2</sup> + (2$val7$val12)$val6 + $val7$val13	</center> <p>	有$val16? (假设 $val7$val11 $m_ne 0.)
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,12,13,16
embedcnt=0
