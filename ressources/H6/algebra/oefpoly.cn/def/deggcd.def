!set title=与导数的最大公因式次数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>i</i>
tmp0=!randint 1, 8

tmp1=!randitem 0,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

val9=$[rint($(tmp0)*2)]

!ifval $val8=0
tmp0=!randint 1, 10

val10=$[rint( $(tmp0)*2)]
!else
tmp1=!randint 2, 20

val10=$[rint($(tmp1))]
!endif
tmp0=!randint 1, 100

val11=$[rint($(tmp0))]
val12=$[rint(46)]

!ifval $val11>$val12
val13=实
!else
val13=复
!endif
val14=$[rint($val8+$val9+$val10)]
replyname1=最大公因式次数
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst <i>P</i> 的重根也是 gcd(<i>P</i>(x),<i>P'</i>(x)) 的根.


!goto stat

!exit

:question
$()设 <i>P</i>(x) 是一个 $val14 次$val13系数多项式,	它有 $val8 个不同的实根和 $val9 个不同的复根	(不计重数).	设 <i>P'</i>(x) 是 <i>P</i>(x) 的导数.	问	gcd(<i>P</i>(x),<i>P'</i>(x))&nbsp;的次数是多少?
$()
!exit

:hint
$()<i>P</i> 的重根也是 gcd(<i>P</i>(x),<i>P'</i>(x)) 的根.
$()
