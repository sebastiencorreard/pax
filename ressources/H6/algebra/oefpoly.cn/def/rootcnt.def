!set title=用导数计算根的个数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>i</i>
tmp0=!randint 1, 8

tmp1=!randitem 0,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

val9=$[rint($(tmp0)*2)]

!ifval $val8=0
tmp0=!randint 1, 10

val10=$[rint( $(tmp0)*2)]
!else
tmp1=!randint 2, 20

val10=$[rint($(tmp1))]
!endif
val11=$[rint($val8+$val9+$val10)]
tmp0=!randint 1, 100

val12=$[rint($(tmp0))]
val13=$[rint(46)]

!ifval $val12>$val13
val14=实
!else
val14=复
!endif
replyname1=不同根的个数
replygood1=$val8+$val9
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst gcd(<i>P</i>(x),<i>P'</i>(x)) 的根正是 <i>P</i> 的重根.


!goto stat

!exit

:question
$()设 <i>P</i>(x) 是 $val11 次$val14系数多项式,	且设 <i>P'</i>(x) 是 <i>P</i>(x) 的导数.	已知 gcd(<i>P</i>(x),<i>P'</i>(x)) 是一个	$val10 次多项式.	问 <i>P</i>(x) 的<b><em>不同的</em></b>根的个数是多少?	(包括实根与复根)
$()
!exit

:hint
$()gcd(<i>P</i>(x),<i>P'</i>(x)) 的根正是 <i>P</i> 的重根.
$()
!exit

