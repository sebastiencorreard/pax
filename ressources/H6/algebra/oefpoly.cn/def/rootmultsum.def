!set title=和或积的根的重数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=100000

ansorder=c,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>P</i>
val7=<i>Q</i>
val8=<i>X</i>
tmp0=!randint -50, 50

val9=$[rint($(tmp0))]
tmp0=!randint 2, 20

val10=$[rint($(tmp0))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!item $val11 of $val10,$(tmp0)

val12=$[rint($(tmp1))]
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val6($val8)+$val7($val8),$val6($val8)-$val7($val8),	            $val6($val8)$val7($val8),$val6($val8)$val7($val8)

val14=$(tmp0)
val15=$[rint(min($val10,$val12))]
tmp0=!item $val13 of $val15,$val15,$val10+$val12,$val10+$val12

val16=$[rint($(tmp0))]
val17=大于或等于 m
val18=小于或等于 m
val19=等于 m

!ifval $val13<=2 and $val10=$val12
val20=$val17
!else
val20=$val19
!endif
replyname1=其中 m
replygood1=$val16
choicename1=重数
choicegood1=$val20
choicebad1=$val17,$val18,$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val6($val8) 和 $val7($val8) 是两个多项式. 填空:	<p>	若 $val9 是 $val6($val8) 的 $val10 重根也是 $val7($val8)	的 $val12 重根,	则 $val9 是 $val14 的 ________ 重根.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,12,14
embedcnt=0
