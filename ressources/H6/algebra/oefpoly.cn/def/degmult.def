!set title=有重根的最小次数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=3000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>i</i>
tmp0=!randint 2, 8

val8=$[rint($(tmp0))]
tmp0=!randint 2, 8

val9=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]

!ifval $val11>0
val12=+$val11
!else
val12=$val11
!endif
tmp0=!randitem 1,2,3,4

val13=$[rint($(tmp0))]

!ifval $val13=4
val14=$[rint(-$val10)]
!else
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
!endif

!ifval $val13=2
val14=$[rint($val10)]
!endif

!ifval $val13=2
val15=$[rint(-$val11)]
!else
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
!endif

!ifval $val13=4
tmp0=!randitem -1,1

val15=$[rint($val11*$(tmp0))]
!endif

!ifval $val13!=1 and $val10=$val14 and $val11=$val15
val14=$[rint( $val14+sign($val14))]
!endif

!ifval $val15>0
val16=+$val15
!else
val16=$val15
!endif

!ifval $val13=1
val17=$val14
!else
val17=$val14$val16$val7
!endif

!ifval $val13=1
val18=$[rint($val8*2+$val9)]
!else
val18=$[rint($val8*2+$val9*2)]
!endif

!ifval $val10=$val14 and $val11=-($val15) and $val8!=$val9
val18=$[rint(-1)]
!endif

!ifval $val10=$val14 and $val11=-($val15) and $val8=$val9
val18=$[rint($val8+$val9)]
!endif
tmp0=!randint 1, 100

val19=$[rint($(tmp0))]

!ifval $val19>35
val20=实
!else
val20=复
!endif

!ifval $val19<=35
val18=$[rint($val8+$val9)]
!endif
replyname1=最小次数
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()满足以下条件的$val20系数多项式	<i>P</i>(x) 的最小次数是多少?	<ul>	 <li> $val10$val12$val7 是 $val8 重根;	 <li> $val17 是 $val9 重根?	</ul>	如果你认为这样的多项式不存在. 则回答 <tt>-1</tt>.	
$()
!exit

