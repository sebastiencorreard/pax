val14=$[rint($(tmp0)*$(tmp1)+$val9)]
tmp0=!item $val13 of $val12,$val12,$val12,($val9)^2

val15=$[rint($(tmp0))]

!ifval $val15>=0
val16=+$val15
!else
val16=$val15
!endif
val17=$[rint(($val14)^2+($val10)*($val14)+($val15))]
tmp0=!item $val13 of $val6($val7($val8)),$val6($val8),$val6($val7($val8)),$val7($val6($val8))

val18=$(tmp0)
tmp0=!randint -20, 20

tmp1=!item $val13 of $val14,$val12-($val9)^2,$val14,$(tmp0)

val19=$[rint($(tmp1))]
tmp0=!item $val13 of $val17,$val9,-($val10)-$val14,$val9

val20=$[rint($(tmp0))]
tmp0=!item $val13 of  _____ 是 $val6($val8) 的根,	            _____ 是 $val6($val7($val8)) 的根,	            _____ 也是 $val6($val7($val8)) 的根,	            $val6($val19)&nbsp;=&nbsp;_____

val21=$(tmp0)
