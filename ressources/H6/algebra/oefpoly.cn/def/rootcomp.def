val8=<i>X</i>
tmp0=!randint 1, 18

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(-2*($val9))]

!ifval $val10>=0
val11=+$val10
!else
val11=$val10
!endif
tmp0=!randint 1, 19

tmp1=!randitem -1,1

