!set title=2次多项式的实根
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=3000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=3
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
tmp0=!randint 2, 4

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint($val7*($val8)^2)]
val11=$[rint(2*($val7)*($val8)*($val9))]
tmp0=!randint 1, 30

val12=$[rint($(tmp0)*sign($val10))]
val13=$[rint($val7*($val9)^2-($val12))]

!ifval $val11>=0
val9=+$val11
!else
val9=$val11
!endif

!ifval $val13>=0
val14=+$val13
!else
val14=$val13
!endif

!ifval $val11=0
val15=
!else
val15=$val9$val6
!endif
replyname1=<i>r</i><sub>1</sub>
replygood1=?analyze 16
replyname2=<i>r</i><sub>2</sub>
replygood2=?analyze 17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()求以下多项式的两个根 <i>r</i><sub>1</sub>,	<i>r</i><sub>2</sub><p>	<center>	$val10$val6<sup>2</sup> $val15 $val14&nbsp;.	<p></center>	(根是实数, 次序不计.)
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val10)*($val16)^2+($val11)*($val16)=-($val13)
 condtest1=1
!else
 condtest1=0
!endif
condname1=<i>r</i><sub>1</sub> 是根

!ifval ($val10)*($val17)^2+($val11)*($val17)=-($val13)
 condtest2=1
!else
 condtest2=0
!endif
condname2=<i>r</i><sub>2</sub> 是根

!ifval -($val10)*($val16+($val17))=$val11 and $val10*($val16)*($val17)=$val13
 condtest3=1
!else
 condtest3=0
!endif
condname3=没有其它根

!exit

:stat
vsavelist=6,10,11,13,14,15,16,17
embedcnt=0
