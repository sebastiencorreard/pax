!set title=三项式的因式分解
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@localhost
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 25

val6=$(tmp0)
tmp0=!randitem 1,-1,0,0

val7=$[rint($(tmp0))]
tmp0=!item 1 of $val6

tmp1=!randitem 2,-2

val8=$[rint((1+$(tmp0))*$(tmp1)+$val7)]
tmp0=!item 2 of $val6

tmp1=!randitem 2,-2

val9=$[rint((1+$(tmp0))*$(tmp1)+$val7)]
val10=$[rint($val8+$val9)]
val11=$[rint($val10/2)]
val12=$[rint($val8*($val9))]
val13=!rawmath x^2 + $val10*x + $val12
val14=$[rint(($val11)^2)]
val15=$[rint(abs($val12-$val14))]
val16=$[rint(sqrt($val15))]
val17=$[rint($val11+$val16)]
val18=$[rint($val11-$val16)]
val19=!rawmath x+$val17
val20=!rawmath x+$val18
oefsteps=reply 1,reply 2	reply 3,reply 4	reply 5,reply 6 
nextstep=!nosubst reply 1,reply 2	reply 3,reply 4	reply 5,reply 6 
!readproc oef/steps.proc
replytype1=numeric
replyname1=平方展开的常数项
replygood1=$[$val14]
replytype2=numeric
replyname2=平方内部的常数项
replygood2=$[$val11]
replytype3=numeric
replyname3=补偿项
replygood3=$[$val15]
replytype4=numeric
replyname4=B
replygood4=$[$val16]
replytype5=litexp
replyname5=A+B
replygood5=$val19
replytype6=litexp
replyname6=A-B
replygood6=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()因式分解 
!insmath $val13
$(). <p>	 
!if $m_step=1 
$()	第 1 步. 你把 
!insmath x
$() 项化成完全平方:	<p><center>	 
!insmath x^2 + $val10*x + 
$()  
!read oef/embed.phtml reply 1,5 
$() = (
!insmath x +
$()  
!read oef/embed.phtml reply 2,4 
$())<sup>2</sup>.	</center>	 
!else
$() 	我们有 
!insmath x^2+ $val10*x + $val14 = (x + $val11)^2
$().	 
!if $m_step=2 
$()	<p> 第 2 步. 所以	<p><center><table border=0>	<tr><td align=right>
!insmath $val13 =
$()<td>
!insmath x^2 + $val10*x + $val14
$()<td> -  
!read oef/embed.phtml reply 3,5 
$()	<tr><td align=right>=<td>
!insmath (x + $val11)^2
$()<td> -  
!read oef/embed.phtml reply 4,4 
$()<sup>2</sup> .	</table></center>	 
!else
$() 	所以	<p><center><table border=0>	<tr><td align=right>
!insmath $val13 =
$()<td>
!insmath x^2 + $val10*x + $val14
$()<td> - $val15	<tr><td align=right>=<td>
!insmath (x + $val11)^2
$()<td>
!insmath  - $val16^2
$()	</table></center>	<p>  
!if $m_status notsametext end 
$()第 3 步. 
!endif
$()	现在我们应用公式 
!insmath A^2-B^2 = (A+B)(A-B)
$() :	<p><center>	 
!insmath (x + $val11)^2 - $val16^2 =
$() ( 
!read oef/embed.phtml reply 5,10 
$())( 
!read oef/embed.phtml reply 6,10 
$()).	</center> <p>	 
!endif
$()	 
!if $m_status issametext end 
$()	结果: 
!insmath $val13 = ($val19)($val20)
$(). 
!else
$() 	(你应该输入化简后的表达式.)	 
!endif
$() 
!endif
$()
$()
!exit

