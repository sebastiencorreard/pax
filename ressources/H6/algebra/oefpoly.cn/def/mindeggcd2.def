 !exit
!endif

val6=<i>X</i>
val7=<i>i</i>
tmp0=!randint 1, 8

tmp1=!randitem 0,0,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

val9=$[rint($(tmp0)*2)]

!ifval $val8=0
tmp0=!randint 1, 20

val10=$[rint( $(tmp0)*2)]
!else
tmp1=!randint 2, 40

val10=$[rint($(tmp1))]
!endif
tmp0=!randint 1, 100

val11=$[rint($(tmp0))]
val12=$[rint(36)]

!ifval $val11>$val12
val13=实
!else
val13=复
!endif
val14=$[rint($val8+$val9+$val10)]
val15=$[rint($val10-$val8-$val9)]

!ifval $val15>=0
val16=$[rint($val15)]
!else
val16=$[rint(0)]
!endif
replyname1=deg(gcd) 的极小值
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  <i>P</i> 的重数 &gt;2 的根 也是 gcd(<i>P</i>(x),<i>P''</i>(x)) 的根.


!goto stat

!exit

:question
$()设 <i>P</i>(x) 是一个 $val14 次$val13系数多项式,	它有 $val8 个不同实根与 $val9 个不同复根	(不计重数).	设 <i>P''</i>(x) 是 <i>P</i>(x) 的 2 阶导数.	问最大公因式	gcd(<i>P</i>(x),<i>P''</i>(x)) 次数的最小值是多少?
$()
!exit

:hint
$() <i>P</i> 的重数 &gt;2 的根 也是 gcd(<i>P</i>(x),<i>P''</i>(x)) 的根.
