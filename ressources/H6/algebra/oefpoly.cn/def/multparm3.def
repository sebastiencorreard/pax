!set title=3 次含参数多项式的重根
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=XIAO, Gang
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=9
postvarcnt=4
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!makelist x for x=-20 to 20

tmp1=!shuffle $(tmp0)

val6=$(tmp1)
val7=$[rint(2)]
val8=$(val6[1])
tmp0=!item 1  to  3 of $val8,$val6

val6=$(tmp0)
tmp0=!makelist (x - y) for y in $val6

val9=$(tmp0)
tmp=!nonempty items 1,-1,2,-2,3,-3

tmp0=!randitem $tmp
tmp1=!translate internal , to * in $val9

val9=!rawmath $(tmp0)*$(tmp1)
tmp0=!randint 0, 2

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in P=$val9;cc=polcoeff(P,$val10);P+(m-cc)*x^$val10
tmp0=!exec pari $t_

val11=!rawmath $(tmp0)
t_=!replace internal \( by ( in cc
tmp0=!exec pari $t_

val12=$[rint($(tmp0))]
replytype1=numeric
replyname1=\(m)
replygood1=?analyze 13
replytype2=numeric
replyname2=重根
replygood2=?analyze 14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()求 
!insmath m
$() 的一个值使以下多项式有一个重根,	并求出这个重根.	<p><center>	
!insmath P(x) = $val11
$()	</center>	<b>警告</b>. 本练习的回答中不能有近似数!	解都是整数. 找找看.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:postdef
tmp0=!mathsubst m=$val13 in $val11

val15=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
evaltmp=$val15

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val17=$[$(tmp0)]
evaltmp=$val16

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]

!exit

:feedback
!ifval $val17 != 0
 <p>	 
!insmath $val14
$() 甚至不是 
!insmath $val15
$() 的根! 错了.	
$()
!endif
!ifval $val17 = 0 and $val18 != 0
 <p>	 
!insmath $val14
$() 实际上是 
!insmath P(x) = $val15 的根
$(). 为了使它成为重根,	
!insmath $val14
$() 也应该是 
!insmath P(x)
$() 的导数的根,	可惜不是. 请重新验算一下.	
$()
!endif

!exit

:test

!ifval $val17 = 0 and $val18 = 0
 condtest1=1
!else
 condtest1=0
!endif
condname1=\($val14) 是 \($val15) 的重根

!exit

:stat
vsavelist=11,13,14
embedcnt=0
