!set title=3次多项式根的函数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=0.200000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=3000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>a</i>
val8=<i>r</i><sub>1</sub>
val9=<i>r</i><sub>2</sub>
val10=<i>r</i><sub>3</sub>
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2,3

val13=$[rint($(tmp0))]

!ifval $val11>0
val14=+$val11
!else
val14=$val11
!endif

!ifval $val12>0
val15=+$val12
!else
val15=$val12
!endif
tmp0=!item $val13 of $val14,$val14,+$val7

val16=$(tmp0)
tmp0=!item $val13 of $val15,+$val7,$val14

val17=$(tmp0)
tmp0=!item $val13 of +$val7,$val15,$val15

val18=$(tmp0)
tmp0=!item $val13 of ($val11)^2-2*($val12),($val11)^2,2*($val11)

val19=$[$(tmp0)]
tmp0=!item $val13 of $val19,$val19-2*a,a^2-$val19

val20=!rawmath $(tmp0)
tmp0=!item $val13 of -$val12,-$val12,-$val11/($val12)

val21=$[$(tmp0)]
tmp0=!item $val13 of $val21/a,a/($val21),$val21

val22=!rawmath $(tmp0)
tmp0=!randitem 1,2

val23=$[rint($(tmp0))]
tmp0=!item $val23 of $val8<sup>2</sup>+$val9<sup>2</sup>+$val10<sup>2</sup>,	    1/$val8+1/$val9+1/$val10

val24=$(tmp0)
tmp0=!item $val23 of $val20,$val22

val25=$(tmp0)
replyname1=<i>t</i>
replygood1=$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val8, $val9, $val10 是以下多项式的 3 个根	<p><center>	$val6<sup>3</sup> $val16$val6<sup>2</sup> $val17$val6 $val18&nbsp;,	</center> <p>	其中 $val7 是非零实数. 问	<i>t</i>&nbsp;=&nbsp;$val24&nbsp;	的值是什么?	(这个值是 $val7 的函数.)
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,16,17,18,24
embedcnt=0
