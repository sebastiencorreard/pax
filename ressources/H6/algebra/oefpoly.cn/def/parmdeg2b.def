val14=$[rint($val14+sign($val14))]
val15=$[rint(($val11)^2*($val12)+($val11)*($val13)+($val14))]
!endif

!ifval $val8>0
val16=+$val8
!else
val16=$val8
!endif

!ifval $val9>0
val17=+$val9
!else
val17=$val9
!endif

!ifval $val10>0
val18=+$val10
!else
val18=$val10
!endif
