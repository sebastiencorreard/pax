!set title=2次多项式根的函数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=3000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>a</i>
val8=<i>r</i><sub>1</sub>
val9=<i>r</i><sub>2</sub>
tmp0=!randint 2, 20

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]

!ifval $val10>0
val12=+$val10
!else
val12=$val10
!endif
tmp0=!item $val11 of $val12,+$val7

val13=$(tmp0)
tmp0=!item $val11 of +$val7,$val12

val14=$(tmp0)
tmp0=!item $val11 of ($val10)^2,2*($val10)

val15=$[rint($(tmp0))]
tmp0=!item $val11 of $val15-2*a,a^2-$val15

val16=!rawmath $(tmp0)
replyname1=<i>t</i>
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 我们有 $val8<sup>2</sup>+$val9<sup>2</sup> = ($val8+$val9)<sup>2</sup>-2$val8$val9. 再利用多项式的根与系数关系.


!goto stat

!exit

:question
$()设 $val8, $val9 是以下多项式的 2 个根	<p><center>	$val6<sup>2</sup> $val13$val6 $val14&nbsp;,	</center> <p>	其中 $val7 是实数. 问	<i>t</i>&nbsp;=&nbsp;$val8<sup>2</sup>+$val9<sup>2</sup>&nbsp;	的值是什么?	(这个值是 $val7 的函数.)
$()
!exit

:hint
$()我们有 $val8<sup>2</sup>+$val9<sup>2</sup> = ($val8+$val9)<sup>2</sup>-2$val8$val9. 再利用多项式的根与系数关系.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,13,14
embedcnt=0
