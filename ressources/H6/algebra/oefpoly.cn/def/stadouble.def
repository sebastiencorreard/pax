!set title=2次多项式根的情况
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000000

ansorder=c
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=一个实根和一个虚根
val8=一个二重实根
val9=一个二重虚根
val10=两个单实根
val11=两个共轭复根
val12=$val8,$val10,$val11,$val7,$val9
tmp0=!randitem 1,2,3

val13=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val16=$[rint($(tmp0)*$(tmp1))]
val17=$[rint(($val15)^2*($val14))]
val18=$[rint(2*($val15)*($val16)*($val14))]
val19=$[rint(($val16)^2*($val14))]
tmp0=!randint 1, 10

val20=$[rint($(tmp0)*sign($val17))]

!ifval $val13=1
val19=$[rint($val19-($val20))]
!endif

!ifval $val13=2
val19=$[rint($val19+($val20))]
!endif

!ifval $val18>=0
val21=+$val18
!else
val21=$val18
!endif

!ifval $val19>=0
val22=+$val19
!else
val22=$val19
!endif
tmp0=!item $val13 of $val10,$val11,$val8

val23=$(tmp0)
choicename1=根的情况
choicegood1=$val23
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()以下二次多项式有怎样的根?	<p><center>	$val17$val6<sup>2</sup> $val21$val6 $val22	<p></center>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

