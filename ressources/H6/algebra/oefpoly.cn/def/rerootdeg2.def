!set title=2次多项式根的实部
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=3000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>b</i>
tmp0=!randint 2, 25

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 25

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]

!ifval $val9>0
val10=+$val9
!else
val10=$val9
!endif
val11=$[-0.5*($val9)/($val8)]
replyname1=Re(<i>r</i>)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 <i>P</i>($val6) = $val8$val6<sup>2</sup> $val10$val6 +$val7 	是有一对共轭复根的实系数多项式. 	问根 <i>r</i> 的实部是什么?
$()
