!set title=已知3次多项式的根
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>i</i>
val8=<i>a</i>
val9=<i>b</i>
tmp0=!randitem -1,1

tmp1=!randint 2, 40

val10=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 12, 40

val11=$[$(tmp0)*$(tmp1)/10]

!ifval $val11>0
val12=+$val11
!else
val12=$val11
!endif
val13=$val10$val12$val7
tmp0=!randitem -1,1

tmp1=!randint 20, 300

val14=$[$(tmp0)*$(tmp1)/100]
tmp0=!randitem 1,2,3

val15=$[rint($(tmp0))]
val16=$[-(2*($val10)+$val14)]
val17=$[2*($val14)*($val10)+($val10)^2+($val11)^2]
val18=$[-($val14)*(($val10)^2+($val11)^2)]

!ifval $val16>=0
val19=+$val16
!else
val19=$val16
!endif

!ifval $val17>=0
val20=+$val17
!else
val20=$val17
!endif

!ifval $val18>=0
val21=+$val18
!else
val21=$val18
!endif
tmp0=!item $val15 of $val19,+$val8,+$val8

val22=$(tmp0)
tmp0=!item $val15 of +$val8,$val20,+$val9

val23=$(tmp0)
tmp0=!item $val15 of +$val9,+$val9,$val21

val24=$(tmp0)
tmp0=!item $val15 of $val17,$val16,$val16

val25=$[$(tmp0)]
tmp0=!item $val15 of $val18,$val18,$val17

val26=$[$(tmp0)]
replyname1=$val8
replygood1=$val25
replyname2=$val9
replygood2=$val26
replyname3=实根
replygood3=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()求多项式<p><center>	<i>P</i>($val6) = $val6<sup>3</sup>$val22$val6<sup>2</sup>$val23$val6$val24 ,	</center> <p>已知 $val8 和 $val9 是实数, 	$val13 是一个根.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,13,22,23,24
embedcnt=0
