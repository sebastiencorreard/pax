!set title=3次多项式的三重根
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>X</i>
val7=<i>a</i>
val8=<i>b</i>
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

val10=$[rint($(tmp0))]
val11=$[0.001]
replyname1=$val7
replygood1=?analyze 12
replyname2=$val8
replygood2=?analyze 13
replyname3=三重根 <i>r</i>
replygood3=?analyze 14
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 如果 <i>r</i> 是 <i>P</i> 的三重根, 那么 <p><center>$val10$val7=-3<i>r</i> (或 $val7=-(3/$val10)<i>r</i>), $val8=3<i>r</i><sup>2</sup>, 以及<p> -<i>r</i><sup>3</sup>=$val9-$val7=$val9+(3/$val10)<i>r</i>. </center> <p>所以 <i>r</i> 是多项式 $val9+(3/$val10)$val6+$val6<sup>3</sup> 的 (实) 根.


!goto stat

!exit

:question
$()在以下多项式里参数 $val7 和 $val8 取什么实数值时会有三重根	<p><center>	<i>P</i>($val6) = $val6<sup>3</sup> + $val10$val7$val6<sup>2</sup> + $val8$val6 + ($val9-$val7)&nbsp;?	</center> <p>	
$()
!exit

:hint
$()如果 <i>r</i> 是 <i>P</i> 的三重根, 那么 <p><center>$val10$val7=-3<i>r</i> (或 $val7=-(3/$val10)<i>r</i>), $val8=3<i>r</i><sup>2</sup>, 以及<p> -<i>r</i><sup>3</sup>=$val9-$val7=$val9+(3/$val10)<i>r</i>. </center> <p>所以 <i>r</i> 是多项式 $val9+(3/$val10)$val6+$val6<sup>3</sup> 的 (实) 根.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval abs($val10*($val12)+3*($val14))<$val11 and 	abs($val13-3*($val14)^2)<$val11 and 	abs($val9-($val12)+($val14)^3)<$val11
 condtest1=1
!else
 condtest1=0
!endif
condname1=<i>r</i> 是三重根

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,14
embedcnt=0
