\title{与高阶导数的最大公因式的最小次数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{n1=random(1..8)*random(0,0,1)}
\integer{n2=random(1..4)*2}
\integer{n=random(2..6)}
\integer{excess=\n1=0? random(\n..30)*2:random(2*\n..60)}
\integer{coef=random(1..100)}
\integer{seuil=36}
\text{ctext=\coef>\seuil?实:复}
\integer{deg=\n1+\n2+\excess}
\integer{test=\deg-\n*(\n1+\n2)}
\integer{ans=\test>=0?\test:0}

\statement{设 <i>P</i>(x) 是一个 \deg 次\ctext系数多项式,
它有 \n1 个不同实根与 \n2 个不同复根
(不计重数).
设 <i>P</i><sup>(\n)</sup>(x) 是 <i>P</i>(x) 的 \n 阶导数.
问最大公因式
gcd(<i>P</i>(x),<i>P</i><sup>(\n)</sup>(x)) 次数的最小值是多少?}

\answer{deg(gcd) 的极小值}{\ans}
