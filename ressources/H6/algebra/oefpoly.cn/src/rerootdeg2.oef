\title{2次多项式根的实部}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{3000}

\text{X=<i>X</i>}
\text{tb=<i>b</i>}
\integer{c2=random(2..25)*random(1,-1)}
\integer{c1=random(2..25)*random(-1,1)}
\text{C1=\c1>0?+\c1:\c1}
\real{ans=-0.5*(\c1)/(\c2)}

\statement{设 <i>P</i>(\X) = \c2\X<sup>2</sup> \C1\X +\tb 
是有一对共轭复根的实系数多项式. 
问根 <i>r</i> 的实部是什么?}

\answer{Re(<i>r</i>)}{\ans}
