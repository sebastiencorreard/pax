\title{2次参数方程}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{X=<i>X</i>}
\text{m=<i>m</i>}
\integer{a=random(1..10)*random(-2,2)}
\integer{b=random(1..9)*random(-2,2)+1}
\integer{c=random(1..10)*random(-2,2)}
\text{A=\a>0?+\a:\a}
\text{B=\b>0?+\b:\b}
\text{C=\c>0?+\c:\c}
\real{side=\b-\a-\c}
\integer{type=random(1,2,3)}
\text{roottype=item(\type,两个单实根,
    一对共轭复根,
    一个二重根)}
\text{ctype=\side>0?item(\type,\m&gt;c,\m&lt;c,\m=c)}
\text{ctype=\side<0?item(\type,\m&lt;c,\m&gt;c,\m=c)}
\real{cc=-0.25*((\b)^2-4*(\a)*(\c))/(\side)}

\statement{参数 \m 取什么实数值时, 多项式
<p><center>
(\m\A)\X<sup>2</sup> + (2\m\B)\X + \m\C
</center> <p>
有\roottype? (假设 \m\A \ne 0.)}

\choice{条件是}{\ctype}{\m&gt;c,\m&lt;c,\m=c}
\answer{其中 c}{\cc}
