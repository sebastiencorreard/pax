\title{已知3次多项式的根}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\text{x=<i>X</i>}
\text{i=<i>i</i>}
\text{a=<i>a</i>}
\text{b=<i>b</i>}
\real{re=random(-1,1)*randint(2..40)/10}
\real{im=random(-1,1)*randint(12..40)/10}
\text{iM=\im>0?+\im:\im}
\text{rr=\re\iM\i}
\real{r=random(-1,1)*randint(20..300)/100}
\integer{type=random(1,2,3)}
\real{c1=-(2*(\re)+\r)}
\real{c2=2*(\r)*(\re)+(\re)^2+(\im)^2}
\real{c3=-(\r)*((\re)^2+(\im)^2)}
\text{C1=\c1>=0?+\c1:\c1}
\text{C2=\c2>=0?+\c2:\c2}
\text{C3=\c3>=0?+\c3:\c3}
\text{coef1=item(\type,\C1,+\a,+\a)}
\text{coef2=item(\type,+\a,\C2,+\b)}
\text{coef3=item(\type,+\b,+\b,\C3)}
\real{ansa=item(\type,\c2,\c1,\c1)}
\real{ansb=item(\type,\c3,\c3,\c2)}

\statement{求多项式<p><center>
<i>P</i>(\x) = \x<sup>3</sup>\coef1\x<sup>2</sup>\coef2\x\coef3 ,
</center> <p>已知 \a 和 \b 是实数, 
\rr 是一个根.}

\answer{\a}{\ansa}
\answer{\b}{\ansb}
\answer{实根}{\r}
