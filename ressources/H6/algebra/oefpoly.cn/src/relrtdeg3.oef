\title{3次多项式根的函数}
\language{cn}
\range{0.2..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{3000}

\text{X=<i>X</i>}
\text{a=<i>a</i>}
\text{r1=<i>r</i><sub>1</sub>}
\text{r2=<i>r</i><sub>2</sub>}
\text{r3=<i>r</i><sub>3</sub>}
\integer{mm=random(2..10)*random(1,-1)}
\integer{nn=random(2..10)*random(1,-1)}
\integer{type=random(1,2,3)}
\text{m=\mm>0?+\mm:\mm}
\text{n=\nn>0?+\nn:\nn}
\text{c2=item(\type,\m,\m,+\a)}
\text{c1=item(\type,\n,+\a,\m)}
\text{c0=item(\type,+\a,\n,\n)}
\real{cons1=item(\type,(\mm)^2-2*(\nn),(\mm)^2,2*(\mm))}
\function{ans1=item(\type,\cons1,\cons1-2*a,a^2-\cons1)}
\real{cons2=item(\type,-\nn,-\nn,-\mm/(\nn))}
\function{ans2=item(\type,\cons2/a,a/(\cons2),\cons2)}
\integer{qtype=random(1,2)}
\text{quest=item(\qtype,\r1<sup>2</sup>+\r2<sup>2</sup>+\r3<sup>2</sup>,
    1/\r1+1/\r2+1/\r3)}
\text{ans=item(\qtype,\ans1,\ans2)}

\statement{设 \r1, \r2, \r3 是以下多项式的 3 个根
<p><center>
\X<sup>3</sup> \c2\X<sup>2</sup> \c1\X \c0&nbsp;,
</center> <p>
其中 \a 是非零实数. 问
<i>t</i>&nbsp;=&nbsp;\quest&nbsp;
的值是什么?
(这个值是 \a 的函数.)}

\answer{<i>t</i>}{\ans}
