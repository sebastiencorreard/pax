\title{和的次数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100000}

\text{P=<i>P</i>}
\text{Q=<i>Q</i>}
\text{X=<i>X</i>}
\integer{d1=random(2..20)}
\integer{t=random(1,2)}
\integer{d2=item(\t,\d1,random(2..20))}
\integer{type=random(1..6)}
\text{composed=item(\type,\P(\X)+\Q(\X),\P(\X)-\Q(\X),
            \P(\X)\Q(\X),\P(\X)\Q(\X),
            \P(\Q(\X)),\Q(\P(\X)))}
\integer{max=max(\d1,\d2)}
\integer{d=item(\type,\max,\max,\d1+\d2,\d1+\d2,\d1*\d2,\d1*\d2)}
\text{sup=大于或等于数 d}
\text{inf=小于或等于数 d}
\text{equ=等于数 d}
\text{good=\type<=2 and \d1=\d2?\inf:\equ}

\statement{设 \P(\X) 和 \Q(\X) 是两个多项式. 问:
<p>
若 deg(\P)=\d1 及 deg(\Q)=\d2,
则 \composed 是一个多项式, 它的次数为
}

\choice{次数}{\good}{\sup,\inf,\equ}
\answer{其中 d}{\d}
