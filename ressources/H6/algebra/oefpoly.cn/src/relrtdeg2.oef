\title{2次多项式根的函数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{3000}

\text{X=<i>X</i>}
\text{a=<i>a</i>}
\text{r1=<i>r</i><sub>1</sub>}
\text{r2=<i>r</i><sub>2</sub>}
\integer{mm=random(2..20)*random(1,-1)}
\integer{type=random(1,2)}
\text{m=\mm>0?+\mm:\mm}
\text{c1=item(\type,\m,+\a)}
\text{c0=item(\type,+\a,\m)}
\integer{const=item(\type,(\mm)^2,2*(\mm))}
\function{ans=item(\type,\const-2*a,a^2-\const)}

\statement{设 \r1, \r2 是以下多项式的 2 个根
<p><center>
\X<sup>2</sup> \c1\X \c0&nbsp;,
</center> <p>
其中 \a 是实数. 问
<i>t</i>&nbsp;=&nbsp;\r1<sup>2</sup>+\r2<sup>2</sup>&nbsp;
的值是什么?
(这个值是 \a 的函数.)}

\answer{<i>t</i>}{\ans}

\hint{我们有 \r1<sup>2</sup>+\r2<sup>2</sup> =
(\r1+\r2)<sup>2</sup>-2\r1\r2. 再利用多项式的根与系数关系.}
