\title{三项式的因式分解}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@localhost}
\computeanswer{no}
\format{html}
\precision{10000}

\text{roots=shuffle(25)}
\integer{bias=random(1,-1,0,0)}
\integer{r1=(1+item(1,\roots))*random(2,-2)+\bias}
\integer{r2=(1+item(2,\roots))*random(2,-2)+\bias}
\integer{c1=\r1+\r2}
\integer{chalf=\c1/2}
\integer{c0=\r1*(\r2)}
\function{poly=x^2 + \c1*x + \c0}
\integer{sqr=(\chalf)^2}
\integer{diff=abs(\c0-\sqr)}
\integer{sqrt=sqrt(\diff)}
\integer{t1=\chalf+\sqrt}
\integer{t2=\chalf-\sqrt}
\function{aplusb=x+\t1}
\function{aminusb=x+\t2}

\steps{reply 1,reply 2
reply 3,reply 4
reply 5,reply 6
}

\statement{因式分解 \(\poly). <p>
\if{\step=1}{
第 1 步. 你把 \(x) 项化成完全平方:
<p><center>
 \(x^2 + \c1*x + ) \embed{reply 1,5} = (\(x +) \embed{reply 2,4})<sup>2</sup>.
</center>
}{
我们有 \(x^2+ \c1*x + \sqr = (x + \chalf)^2).
\if{\step=2}{
<p> 第 2 步. 所以
<p><center><table border=0>
<tr><td align=right>\(\poly =)<td>\(x^2 + \c1*x + \sqr)<td> - \embed{reply 3,5}
<tr><td align=right>=<td>\((x + \chalf)^2)<td> - \embed{reply 4,4}<sup>2</sup> .
</table></center>
}{
所以
<p><center><table border=0>
<tr><td align=right>\(\poly =)<td>\(x^2 + \c1*x + \sqr)<td> - \diff
<tr><td align=right>=<td>\((x + \chalf)^2)<td>\( - \sqrt^2)
</table></center>
<p> \if{\status notsametext end}{第 3 步.}
现在我们应用公式 \(A^2-B^2 = (A+B)(A-B)) :
<p><center>
 \((x + \chalf)^2 - \sqrt^2 =) (\embed{reply 5,10})(\embed{reply 6,10}).
</center> <p>
}
\if{\status issametext end}{
结果: \(\poly = (\aplusb)(\aminusb)).}{
(你应该输入化简后的表达式.)
}}}

\answer{平方展开的常数项}{\sqr}{type=number}
\answer{平方内部的常数项}{\chalf}{type=number}
\answer{补偿项}{\diff}{type=number}
\answer{B}{\sqrt}{type=number}
\answer{A+B}{\aplusb}{type=litexp}
\answer{A-B}{\aminusb}{type=litexp}
