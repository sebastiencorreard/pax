\title{复合多项式的根}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{100000}

\text{P=<i>P</i>}
\text{Q=<i>Q</i>}
\text{X=<i>X</i>}
\integer{droot=random(1..18)*random(-1,1)}
\integer{c1=-2*(\droot)}
\text{C1=\c1>=0?+\c1:\c1}
\integer{mc0=random(1..19)*random(-1,1)}
\integer{type=random(1..4)}
\integer{moveroot=random(1..9)*random(-1,1)+\droot}
\integer{c0=item(\type,\mc0,\mc0,\mc0,(\droot)^2)}
\text{C0=\c0>=0?+\c0:\c0}
\integer{moveval=(\moveroot)^2+(\c1)*(\moveroot)+(\c0)}
\text{p1=item(\type,\P(\Q(\X)),\P(\X),\P(\Q(\X)),\Q(\P(\X)))}
\integer{r1=item(\type,\moveroot,\mc0-(\droot)^2,\moveroot,random(-20..20))}
\integer{r2=item(\type,\moveval,\droot,-(\c1)-\moveroot,\droot)}
\text{text2=item(\type, _____ 是 \P(\X) 的根,
            _____ 是 \P(\Q(\X)) 的根,
            _____ 也是 \P(\Q(\X)) 的根,
            \P(\r1)&nbsp;=&nbsp;_____)}

\statement{设 \P(\X) 是多项式, 
\Q(\X)&nbsp;=&nbsp;\X<sup>2</sup>\C1\X\C0 是另一多项式.
考虑复合多项式 \P(\Q(\X)) 和 \Q(\P(\X)). 填空:
<p>
若 \r1 是 \p1 的一个根, 则\text2.
}

\answer{填空的数应为}{\r2}
