\title{3次多项式的三重根}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{X=<i>X</i>}
\text{a=<i>a</i>}
\text{b=<i>b</i>}
\integer{c1=random(1..10)*random(1,-1)}
\integer{c2=random(2..20)}
\real{tolerance=0.001}

\statement{在以下多项式里参数 \a 和 \b 取什么实数值时会有三重根
<p><center>
<i>P</i>(\X) = \X<sup>3</sup> + \c2\a\X<sup>2</sup> + \b\X + (\c1-\a)&nbsp;?
</center> <p>
}

\answer{\a}{\aa}
\answer{\b}{\bb}
\answer{三重根 <i>r</i>}{\r}

\condition{<i>r</i> 是三重根}
{abs(\c2*(\aa)+3*(\r))<\tolerance and 
abs(\bb-3*(\r)^2)<\tolerance and 
abs(\c1-(\aa)+(\r)^3)<\tolerance}

\hint{如果 <i>r</i> 是 <i>P</i> 的三重根, 那么
<p><center>\c2\a=-3<i>r</i> (或 \a=-(3/\c2)<i>r</i>),
\b=3<i>r</i><sup>2</sup>, 以及<p>
-<i>r</i><sup>3</sup>=\c1-\a=\c1+(3/\c2)<i>r</i>.
</center> <p>所以 <i>r</i> 是多项式 \c1+(3/\c2)\X+\X<sup>3</sup>
的 (实) 根.}
