\title{3次多项式的三重根 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{X=<i>X</i>}
\text{a=<i>a</i>}
\text{b=<i>b</i>}
\integer{c1=random(1..10)*random(1,-1)}
\integer{c2=random(2..10)*random(1,-1)}
\integer{c3=random(2..10)*random(1,-1)}
\text{C2=\c2>0?+\c2:\c2}
\text{C3=\c3>0?+\c3:\c3}
\real{tolerance=0.001}

\statement{在以下多项式里参数 \a 和 \b 取什么实数值时会有三重根
<p><center>
<i>P</i>(\X) = \X<sup>3</sup> \C2\a\X<sup>2</sup> \C3\b\X +(\c1+\a+\b)&nbsp;?
</center> <p>
(可有多个解.)
}

\answer{\a}{\aa}
\answer{\b}{\bb}
\answer{三重根 <i>r</i>}{\r}

\condition{<i>r</i> 是三重根}
{abs((\c2)*(\aa)+3*(\r))<\tolerance and 
abs((\c3)*(\bb)-3*(\r)^2)<\tolerance and 
abs(\c1+(\aa)+(\bb)+(\r)^3)<\tolerance}
