\title{Quelle  formule de calcul ?}
\language{fr}
\range{-5..5}
\author{Véronique Royer}
\email{royer.veronique@orange.fr}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{cas=randomitem(1,1,2,3)}
\text{unit=\cas=1? : pour cent}.
\text{ajoutant=\cas=1? lui ajoutant}
\text{ajoutant=\cas=2? l'augmentant de}
\text{ajoutant=\cas=3? le diminuant de}
\real{t=0.1*randint(10..80)}
\if{\cas=1}{\real{t=\t=1?10}}

\real{q=\cas = 2 or \cas=1?1+0.01*\t}
\real{q=\cas = 3 ?1-0.01*\t}
\real{q2=\cas = 3?1+0.01*\t}
\real{q2=\cas = 2?1-0.01*\t}
\integer{p=randint(0..5)}
\text{tinit=\(u_0),\(u_1)}
\text{\tinit=\p>1?\tinit,\(u_\p)}

\integer{n=randint(10..30)}
\integer{prec=\n-1}
\integer{succ=\n+1}
\integer{nmoinsp=\n-\p}
!! bonnes réponses multiples pour u_r + np | np + u_r
\text{\goodrep=\cas=1 and \p=0?\(u_0),+,\n,\(times),\t|\(u_0),+,\t,\(times),\n| \n,\(times),\t,+,\(u_0)|\t,\(times),\n,+,\(u_0)}
\text{\goodrep=\cas=1 and \p=1?\(u_1),+,\prec,\(times),\t|\(u_1),+,\t,\(times),\prec|\prec,\(times),\t,+,\(u_1)|\t,\(times),\prec,+,\(u_1)}
\text{\goodrep=\cas=1 and \p>1?\(u_\p),+,\nmoinsp,\(times),\t|\(u_\p),+,\t,\(times),\nmoinsp|\nmoinsp,\(times),\t,+,\(u_\p)|\t,\(times),\nmoinsp,+,\(u_\p)}
\text{\goodrep=\cas>1 and \p=0?\(u_0),\(times),\q,^,\n|\q,^,\n,\(times),\(u_0)}
\text{\goodrep=\cas>1 and \p=1?\(u_1),\(times),\q,^,\prec|\q,^,\prec,\(times),\(u_1)}
\text{\goodrep=\cas>1 and \p>1?\(u_\p),\(times),\q,^,\nmoinsp|\q,^,\nmoinsp,\(times),\(u_\p)}


\text{\badrep=\n,\prec,\succ,\nmoinsp,\tinit,\(u_{\prec}),\(u_{\succ}),\(u_{\nmoinsp}),\(times),+,-,^,\q,\q2,\t}
\text{tabform=\goodrep;\badrep}


\statement{

<div style="background-color:#FFFF66">

<p><font color=blue>
On  considère une  suite \((u_n)) dans laquelle chaque terme s'obtient à partir du terme précédent
en \ajoutant  \t \unit .
<br>
On connaît la valeur du terme \(u_\p).
<br>
Avec  ces seules données, quelle formule permet de calculer  directement le terme \(u_n) de rang \(n = \n) ?
</font></p>

<center>\(u_\n) =  \embed{reply1,40x30x5}</center>
</div>
}

\answer{}{\tabform}{type=clickfill}
