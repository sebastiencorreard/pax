!ifval $m_step=5
 <div class='oef_feedbacks'>	  
!if $m_reply6!=$val28 
$()<font color=red>Erreur à la question 5 : </br>	D'après la  formule de somme d'une suite $val22 :	  
!if $val8=1 
$()
!insmath  S = u_0+u_1+...+u_n = (n+1)\times \frac{u_0+u_n}{2}
$() 
!else
$()	              
!insmath  S = u_0+u_1+...+u_n = u_0\times \frac{1-q^{n+1}}{1-q}
$() 
!endif
$()	 </br pour 
!insmath  n = $val23
$(), on obtient 
!insmath S = $val28
$(). </font> 
!endif
$()	  
$()</div>
