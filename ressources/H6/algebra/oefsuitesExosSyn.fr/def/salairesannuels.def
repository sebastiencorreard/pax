!set title=Cumul de salaires annuels
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle Exact,Bien,Juste,Bravo,Bonne réponse,Oui

val6=$(tmp0)
tmp0=!shuffle Erreur,Faux,Hélas,Inexact,Mauvaise réponse,Non

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=
!else
val9=(arrondi à l'entier)
!endif

!ifval $val8=1
val10=valeur
!else
val10=valeur arrondie à l'entier
!endif

!ifval $val8=1
tmp=!nonempty items 5,10,15,20,25,30

tmp0=!randitem $tmp
val11=$[$(tmp0)]
!else
tmp1=!randint 20, 60

val11=$[ $(tmp1)*0.01]
!endif

!ifval $val8=1
val12=$[12*$val11]
!else
val12=$[1+0.01*$val11]
!endif

!ifval $val8=1
val13=euros
!else
val13=%
!endif
tmp0=!randint 1, 10

val14=$[rint(1000+$(tmp0)*25)]
val15=$[rint(12*$val14)]

!ifval $val8=1
val16=!rawmath $val15+n*$val12
!else
val16=!rawmath $val15*$val12^n
!endif

!ifval $val8=1
val17=!rawmath $val14+n*$val11
!else
val17=!rawmath $val14*$val12^n
!endif
evaltmp=$val16

evaltmp=!mathsubst n=(1) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
evaltmp=$val17

evaltmp=!mathsubst n=(1) in $evaltmp
tmp0=($evaltmp)
val19=$[$(tmp0)]
t_=!replace internal \( by ( in round($val18)
tmp0=!exec pari $t_

val20=$[rint($(tmp0))]
val21=arithmétique,géométrique
tmp0=!item $val8 of $val21

val22=$(tmp0)
tmp0=!randint 5, 12

val23=$[rint($(tmp0))]
val24=$[rint(2007+$val23)]
evaltmp=$val16

evaltmp=!mathsubst n=($val23) in $evaltmp
tmp0=($evaltmp)
val25=$[$(tmp0)]
t_=!replace internal \( by ( in round($val25)
tmp0=!exec pari $t_

val26=$[rint($(tmp0))]

!ifval $val8=1
val27=$[($val23+1)*($val15+$val25)/2]
!else
val27=$[$val15*(1-$val12^($val23+1))/(1-$val12)]
!endif
t_=!replace internal \( by ( in round($val27)
tmp0=!exec pari $t_

val28=$[rint($(tmp0))]
tmp0=!randitem Léo,Léa

val29=$(tmp0)
oefsteps=reply1	reply2	reply3,reply4	reply5	reply6 
nextstep=!nosubst reply1	reply2	reply3,reply4	reply5	reply6 
!readproc oef/steps.proc
replytype1=integer

replyoption1=nonstop 
replyname1=Salaire annuel initial
replygood1=$val15
replytype2=numeric
replyoption2=nonstop 
replyname2=Salaire mensuel la deuxième année
replygood2=$[$val20]
replytype3=menu
replyoption3=nonstop 
replyname3=Nature
replygood3=$val8;$val21
replytype4=numeric
replyoption4=nonstop 
replyname4=Raison
replygood4=$[$val12]
replytype5=integer

replyoption5=nonstop 
replyname5=Salaire l'année n
replygood5=$val26
replytype6=integer

replyname6=Salaires cumulés
replygood6=$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="background-color:#FFFF66">		<p>Le premier janvier 2007, $val29 a signé un contrat de travail aux conditions suivantes :	<ul><li>	pendant la première année, son salaire <b>mensuel</b> est fixé à 
!insmath $val14
$() euros ; </li>	<li>au premier janvier de chaque nouvelle année, son salaire mensuel augmente de $val11 $val13.</li>	</ul>	On note 
!insmath u_n
$() le salaire <b>annuel</b> de $val29 pour l'année 2007+
!insmath n
$().	</p>	<ul>	<li>	<b>Question 1 : </b> Quel  est le salaire annuel initial ?	 <center> 
!insmath u_0
$() =   
!read oef/embed.phtml reply1,8 
$()</center>	</li>		
!if $m_step>1 
$()	   
!if $m_reply1=$val15 
$()<font color=green>$(val6[1]) !</font> 
!else
$()	       <font color=red>$(val7[1])...  
!insmath u_0 = $val14 \times 12 = $val15
$().</font>  
!endif
$()	   <li><b>Question 2 </b>: Quelle  est la $val10 du salaire annuel en 2008 ?	           <center> 
!insmath u_1
$() =   
!read oef/embed.phtml reply2,8 
$()   &nbsp;$val9 </center>	    </li>	 
!endif
$()		
!if $m_step>2 
$()	   
!if $m_reply2=$val20 
$()<font color=green>$(val6[2]) !</font> 
!else
$()	       <font color=red>$(val7[2])... <br>	      
!if $val8=1 
$()
!insmath m_1 = $val14 + $val11 = $val19 
$() 
!else
$()   
!insmath m_1 = $val14 \times $val12  = $val19 
$()   
!endif
$()	       et 
!insmath u_1 = $val19 \times 12 = $val18
$()	      
!if $val8=2 
$()soit  $val20 en arrondissant à l'entier 
!endif
$().</font>  
!endif
$()	   <li><b>Question 3 </b>: De quelle nature est la suite des  salaires annuels (
!insmath u_n
$()) ?	<center> C'est une suite   
!read oef/embed.phtml reply3 
$() de raison   
!read oef/embed.phtml reply4,5 
$() </center>	    </li>	 
!endif
$()		
!if $m_step>3 
$()	   
!if $m_reply3=$val22 and $m_reply4=$val12 
$()<font color=green>$(val6[3]) !</font> 
!else
$()	       <font color=red>$(val7[3])...  La suite est $val22 de raison 
!insmath $val12
$().</font>  
!endif
$()	   <li><b>Question 5 </b>: Quelle est la $val10  du salaire annuel en  $val24 ?	<center> 
!insmath u_$val23
$() =   
!read oef/embed.phtml reply5,8 
$()  &nbsp;$val9</center>	    </li>	 
!endif
$()		
!if $m_step>4 
$()	   
!if $m_reply5=$val26 
$()<font color=green>$(val6[4]) !</font> 
!else
$()	       <font color=red>$(val7[4])...	        
!if $val8=1 
$()On a 
!insmath u_{$val23} = u_0 + $val23 \times $val12 = $val25
$(). 
!else
$()	                    On a 
!insmath u_{$val23}= u_0 \times  $val12^{$val23} = $val25
$() soit 
!insmath u_{$val23} \simeq $val26
$() en arrondissant à l'entier. 
!endif
$()	      </font> 
!endif
$()	   <li><b>Question 6 </b>: Si $val29 restait dans cette entreprise du premier janvier 2007 au 31 décembre	  $val24, quelle serait la somme  totale des salaires perçus par $val29  ?	<center> S =    
!read oef/embed.phtml reply6, 12 
$() &nbsp;$val9</center>	    </li>	 
!endif
$()			</ul></div>	
$()
!exit

