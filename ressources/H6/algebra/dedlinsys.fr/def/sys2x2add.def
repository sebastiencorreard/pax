!set title=Linsys 2x2 par addition
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang Xiao
email=xiao@unice.fr
language=fr

varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=0
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Résoudre le système linéaire
val8=La solution est
m_environ=QQ
m_options=nofloat fixedgoal
m_minsteps=2
m_methods=eq/lincomb, eq/addnum, eq/mulnum, eq/divnum, eq/exsides, eq/addterm
tmp0=!randitem a,b,c,d,r,s,t,x,y,z

val9=$(tmp0)
val9=x
val10=y
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
val14=$[rint(abs(($val12)*($val13)/($val11)))]

!ifval $val14>21
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val14+2, $val14+10

tmp3=!randitem -1,1

val15=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint -20, 20

val16=$[rint($(tmp0))]
tmp0=!randint -20, 20

val17=$[rint($(tmp0))]
val18=$[rint(($val11)*($val16)+($val12)*($val17))]
val19=$[rint(($val13)*($val16)+($val15)*($val17))]
val20=!rawmath $val11*$val9 + $val12*$val10
val21=!rawmath $val13*$val9 + $val15*$val10
val22=$val9 = $val16
val23=$val10 = $val17
m_context=$val20 = $val18	$val21 = $val19
m_goal=$val22	$val23
tmp0=!texmath $val20 = $val18

val24=$(tmp0)
tmp0=!texmath $val21 = $val19

val25=$(tmp0)
tmp0=!replace internal = by &= in	  $val24\\$val25

val26=$(tmp0)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	  
!insmath \begin{cases} $val26\end{cases}
$()	</div>	$val8 
!insmath  $val22 
$(), 
!insmath  $val23 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

