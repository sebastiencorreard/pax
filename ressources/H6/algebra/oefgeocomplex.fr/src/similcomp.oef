\title{Composition de similitudes}

\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\precision{1000}
\computeanswer{no}
\integer{a1=randint(1..5)*random(1,-1)}
\integer{a2=randint(1..5)*random(1,-1)}
\integer{b1=randint(1..5)*random(1,-1)}
\integer{b2=randint(1..5)*random(1,-1)}
\complex{a=\a1+i*(\a2)}
\complex{b=\b1+i*(\b2)}

\integer{aa1=randint(1..5)*random(1,-1)}
\integer{aa2=randint(1..5)*random(1,-1)}
\integer{bb1=randint(1..5)*random(1,-1)}
\integer{bb2=randint(1..5)*random(1,-1)}
\complex{aa=\aa1+i*(\aa2)}
\complex{bb=\bb1+i*(\bb2)}
raa circ ra
\complex{A=(\aa)*(\a)}
\complex{B=(\aa)*(\b)+(\bb)}

\complex{B1=(\a)*(\bb)+(\b)}
\text{choix=randint(1,2)}
\if{\choix=1}{
  \text{A1=\a}
  \text{B1=\b}
  \text{A2=\A}
  \text{B2=\B}
  \text{Arep=\aa}
  \text{Brep=\bb}
  \text{z1=z_1}
  \text{z2=z_2}
 }
 {
  \text{A1=\A}
  \text{B1=\B1}
  \text{A2=\aa}
  \text{B2=\bb}
  \text{Arep=\a}
  \text{Brep=\b}
  \text{z1=z_2}
  \text{z2=z_1}
 }

\statement{Soit \(r_1) la similitude qui  à un point \(M)
d'affixe \(z) associe le point \(M_1) d'affixe \(z_1) donné
par
<p class="wimscenter">\( z_1= (\A1)*z + \B1) </p>
Soit \(r_2) la similitude qui  à un point \(M)
d'affixe \(z) associe le point \(M_2) d'affixe \(z_2) donné
par
<p class="wimscenter">\( z_2 = (\A2)*z + \B2)</p>

Calculer la transformation \(f) qui envoie
\if{\choix=1}{\(M_1) sur \(M_2)}{\(M_2) sur \(M_1)}
par son écriture complexe

<p class="wimscenter"> \(\z2) = \embed{reply1} \(\z1) + \embed{reply2} </p>
}

\answer{\(a) }{\Arep} {type=complex}
\answer{\(b) }{\Brep} {type=complex}
