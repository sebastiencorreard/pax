\text{lettre=randrow(
A,B,C,D
B,C,D,A
C,D,A,B
D,A,B,C)}
\text{A=\lettre[1]}
\text{B=\lettre[2]}
\text{C=\lettre[3]}
\text{D=\lettre[4]}

\text{rectangle=randitem(rectangle,losange,triangle)}
\if{\rectangle issametext rectangle}{
 \text{s=randint(2..4)}
 \text{ABCD = A B C D}
 \text{AB=randitem(\A \B,\D \C)}
 \text{AD=randitem(\A \D,\B \C)}
 \text{enonce=\(\AD) = \s \(\AB)}
 \rational{s1=\s^2+1}
 \real{angle=acos(1/sqrt(\s1))}
 \real{angle1=pi/2-\angle}
 \text{cote=randrow(\A \B,\A \D, \A, pi/2,1/\s
\A \D, \A \B,\A,pi/2,\s
\A \C,\A \B,\A,\angle,sqrt(\s1)
\A \B,\A \C,\A,\angle,1/sqrt(\s1)
\A \D,\A \C,\A,\angle1,\s/sqrt(\s1)
\A \C,\A \D,\A,\angle1,sqrt(\s1)/\s
)}
}
\if{\rectangle issametext losange}{
   \text{angle0= randitem(3,2,3/2)}
   \text{rapport=\angle0=3 ? sqrt(3)}
   \text{rapport=\angle0=2 ? sqrt(2)}
   \text{rapport=\angle0=3/2? 1}
   \text{rapport1=\angle0=3/2? 1 : 1/\rapport}
   \rational{angle1=1/(\angle0)}
   \rational{angle2= \angle1/2}
   \text{angle=\angle1*pi}
   \text{angle_text = \angle1=2/3 ? 2\pi/3: \pi/\angle0}
   \text{angle2= \angle2*pi}
   \text{ABCD = A B C D}
   \text{AB=randitem(\A \B,\D \C)}
   \text{AD=randitem(\A \D,\B \C)}
   \text{cote=randrow(\A \B,\A \D, \A,\angle,1
   \A \D,\A \B,\A,\angle,1
   \A \C,\A \B,\A,\angle2,\rapport
   \A \B,\A \C,\A,\angle2,\rapport1)
   }
}

\if{\rectangle issametext triangle}{
   \text{lettre=randrow(A,B,C
B,C,A
C,A,B)}
\text{A=\lettre[1]}
\text{B=\lettre[2]}
\text{C=\lettre[3]}
   \text{angle= randitem(3,4,6)}
   \text{s=randint(2..4)}
   \text{ABCD = A B C}
   \text{AB=\A \B}
   \text{AC=\A \C}
   \text{cote=randrow(\A \B,\A \C,\A, pi/\angle,1/\s
   \A \C, \A \B,\A,pi/\angle,\s
   )}
}
   \text{pointI= wims(char 2 of \cote[1])}
   \text{pointD= wims(char 2 of \cote[2])}
\text{STEPS=reply1,reply2,reply3
reply4,reply5,reply6,reply7
}

\steps{\STEPS}
\statement{
Soit \(\ABCD) un \rectangle tel que
\if{\rectangle issametext rectangle}{\(\AD) = \s \(\AB).}
\if{\rectangle iswordof triangle}{\(\AC) = \s \(\AB) et
tel que l'angle en \(\A) soit de mesure \pi/\angle.}
\if{\rectangle iswordof losange}{l'angle en \(\A) soit de mesure \(\angle_text).}

\if{\step=1}{
Alors \([\cote[1]]) est l'image de \([\cote[2]]) par une similitude directe
<div class="wimscenter">
 de centre \embed{reply1,8}, d'angle \pm \embed{reply2,8} et de rapport
\embed{reply3,12}
</div>
}
\if{\step=2}{<div class="oef_indgood">En effet, \([\cote[1]]) est l'image de \([\cote[2]]) par une
similitude directe de centre \(\cote[3]), d'angle \pm \(\cote[4]) et de rapport
\(\cote[5]).
</div>


En notant l'affixe d'un point \(M) par \(z_M), l'affirmation suivante se traduit
par l'égalité de nombres complexes :
<div class="wimscenter">
\(z_\pointI) - \(z) <sub>\embed{reply4,8}</sub> = \embed{reply5,8} * exp(\pm \embed{reply6,8}) *
(\(z_\pointD) - \(z) <sub>\embed{reply7,8}</sub>.)
</div>

}
}
\answer{centre}{\cote[3]}{type=nocase}
\answer{angle}{\cote[4]}{type=complex}
\answer{rapport}{\cote[5]}

\answer{centre}{\cote[3]}{type=nocase}
\answer{rapport}{\cote[5]}{type=complex}
\answer{angle}{\cote[4]*i}{type=complex}
\answer{centre}{\cote[3]}{type=nocase}
