\title{Triangle équilatéral}
\language{fr}
\range{-5..5}
\author{Chantal,Causse}
\email{chantal.causse@noos.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=random(0..9)}
\integer{b=random(0..9)}
\integer{c=random(1..9)}
\integer{d=random(1..9)}
\integer{d= \c=\a and \d=\b? \d+1}
\integer{cc=\c-\a}
\integer{dd=\d-\b}
\text{r= \a+(\cc-(\dd)*3^(1/2))/2}
\text{r1= \a+(\cc+(\dd)*3^(1/2))/2}
\text{j= \b+ ((\cc)*3^(1/2)+(\dd))/2}
\text{j1= \b+ (-(\cc)*3^(1/2)+(\dd))/2}

\complex{z= \a + (\b)*i}
\complex{z1= \c + (\d)*i}
\text{M1=simplify(\r1+(\j1)*i)}
\text{M2=simplify(\r+(\j)*i)}

\statement{Si \(A) et \(B) sont des points du plan d'affixes \(\z) et \(\z1),
trouver l'affixe d'un point \(M) tel que le triangle \(A B M) soit équilatéral.}

\hint{\(M) est l'image de \(B) par une rotation. Laquelle ?}
\answer{\(Re(z))}{\rep}{type=numeric}
\answer{\(Im(z))}{\ima}{type=numeric}

\condition{ \(z = \rep+\ima *i)}{(\rep=\r and \ima=\j) or (\ima=\j1 and \rep=\r1)}


\solution{\(M) est l'image de \(B) par la rotation de centre \(A)
et d'angle \(+ \pi/3) ou par la rotation de centre \(A) et
 d'angle \(- \pi/3).
L'affixe de \(M) se trouve donc par la formule :
<div class="wimscenter"> \( z - (\z)) = \((\cos(\pi/3) + i\sin(\pi/3)))\(((\z1) - (\z)))
</div>
ou bien
<div class="wimscenter">
\( z - (\z)) = \((\cos(-\pi/3) + i\sin(-\pi/3)))\(((\z1) - (\z))).</div>
Ce qui donne \(z = \M2) ou \(z = \M1)}
