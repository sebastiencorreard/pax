\title{Triangle isocèle}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{chantal.causse@noos.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=random(0..9)}
\integer{b=random(0..9)}
\integer{c=random(1..9)}
\integer{d=random(1..9)}
\integer{d=\c=\a and \d=\b? \d+1}
\integer{cc=\c-\a}
\integer{dd=\d-\b}
\integer{angle=5*random(1..35)}
\real{rad=\angle*pi/180}
\real{r2= \a+(cos(\rad))*(\cc)+(sin(\rad))*(\dd)}
\real{r1= \a+(cos(\rad))*(\cc)-(sin(\rad))*(\dd)}
\real{j2= \b+(cos(\rad))*(\dd)-(sin(\rad))* (\cc)}
\real{j1= \b+(cos(\rad))*(\dd)+(sin(\rad))*(\cc)}

\complex{z= \a + (\b)*i}
\complex{z1= \c + (\d)*i}

\complex{M1=\r1 + (\j1)*i}
\complex{M2=\r2+(\j2)*i}

\statement{Si \(A) et \(B) sont des points du plan d'affixe \(\z) et \(\z1),
trouver l'affixe d'un point \(M) tel que le triangle \(A B M) soit isocèle en
\(A) et d'angle \(\widehat{B A M}) égal à \angle degrés.
}

\hint{\(M) est l'image de \(B) par une rotation. Laquelle ?}
\answer{\(Re(z))}{\rep}{type=default}
\answer{\(Im(z))}{\ima}{type=default}

\condition{ \(z = \rep + \ima *i)}{(\rep=\r2 and \ima=\j2) or (\ima=\j1 and \rep=\r1)}

\solution{\(M) est l'image de \(B) par la rotation de centre \(A) et d'angle + \angle °
ou par la rotation de centre \(A) et d'angle - \angle °.
 L'affixe de \(M) se trouve donc par la formule
<p class="wimscenter">\( z - (\z)) = \((\cos(\angle &deg;)
+ i\sin(\angle &deg;)))\times \(((\z1) - (\z))).
</p>
ou bien
<p class="wimscenter">\( z - (\z)) = \((\cos(-\angle &deg;)
+ i\sin(-\angle &deg;)))\times \(((\z1) - (\z))).
</p>
Ce qui donne \(z = \M1) ou \(z = \M2)}
