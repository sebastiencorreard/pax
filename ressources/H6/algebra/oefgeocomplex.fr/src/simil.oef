\title{Nature des transformations complexes}
\computeanswer{yes}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\precision{1000}
angles remarquables :
\matrix{remarquable= 0, 1
pi/6,(sqrt(3)+i)/2
pi/4,sqrt(2)*(1+i)/2
pi/3,(1 + sqrt(3)*i)/2
pi/2,i
2*pi/3,(-1 + sqrt(3)*i)/2
}

\text{a=randrow(\remarquable)}
\text{c=random(1,1,1,1,sqrt(2),2,3,4,sqrt(3))}
\text{A	=maxima(\c*\a[2])}
\text{A = + isin \A or - isin \A ? (\A): \A}
text{B=maxima(arg(\a[2]))}
\complex{b=randint(-2..2) + random(1,-1) + randint(-3..3)*i}

\text{Nature=translation, homothétie,rotation, similitude directe}
\text{nature= \A=1 ? 1 : 4}
\text{nature= \A != 1 and \a[1]=0 ? 2}
\text{nature= \a[1]<>0 and abs(\c) = 1 ? 3}
\text{centre=\A != 1 ? maxima(expand(rectform((\b)/(1-(\A)))))}

\text{STEP = reply1
reply2,reply3}
\text{STEP = \A !=1 ? \STEP,reply4: \STEP,reply5}

\steps{\STEP}
\css{<style type="text/css">
 .question  {
  background-color: #FFFFCC;
  margin : 2% 5%;
  padding : 2%;
  text-align:center;}
  .reponse {background-color : #ffcc99;
          color : black;
          margin : 2% 5%;
          padding : 2%;
          text-align:center;
  }
 </style>
 }

\statement{
La transformation qui à un point \(M)
d'affixe \(z) associe le point \(M') d'affixe \(z') donné
par
<div class="question">
\if{\b=0}{\( z'= \A * z) }{\( z'= \A * z + \b)} </div>
\if{\step=1}{est une
<div class="reponse"> \embed{reply1}</div>
<p><i>Donner la réponse la plus précise. </i></p>}
\if{\step=2}{est une similitude directe
\if{\nature notsametext 4}{et plus précisément une \Nature[\nature[1]]}.
Préciser ses éléments caractéristiques :

<table class="wimsborder wimscenter"><tr>
\if{\A!=1}{<th>centre</th>}{<th>translation</th>}
<th>angle</th><th>rapport</th></tr>
<tr><td>
\if{\A!=1}{\embed{reply4}}{\embed{reply5}}</td><td>\embed{reply2,5}</td><td>\embed{reply3,5}</td>
</tr></table>
}
}
\answer{}{\nature;\Nature}{type=radio}
\answer{Angle}{\a[1]}{type=numeric}
\answer{Rapport}{\c}{type=complex}
\answer{Centre}{\centre1}{type=complex}
\answer{Vecteur}{\b}{type=complex}

\text{test=\A!=1? pari(abs(\reply4-(\centre)))}
\condition{Centre}{\test < 0.0001}
\feedback{\test > 0.0001}{Le centre est \(\centre)}
