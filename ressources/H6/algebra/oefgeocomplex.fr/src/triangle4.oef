\title{Triangle rectangle isocèle2}
\language{fr}
\range{-5..5}
\author{Chantal,Causse}
\email{chantal.causse@noos.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{a=random(0..9)}
\integer{b=random(0..9)}
\integer{c=random(1..9)}
\integer{d=random(1..9)}
\integer{d=\c=\a and \d=\b? \d+1}
\integer{cc=\c-\a}
\integer{dd=\d-\b}
\text{r= (\a+\c+\b-\d)/2}
\text{r1=(\a+\c+\d-\b)/2 }
\text{j= (\b+ \d+\c-\a)/2}
\text{j1=(\b+ \d+\a-\c)/2 }

\complex{z= \a + (\b)*i}
\complex{z1= \c + (\d)*i}

\text{M1=simplify(\r1+(\j1)*i)}
\text{M2=simplify(\r+(\j)*i)}

\statement{Si \(A) et \(B) sont des points du plan d'affixe \(\z) et \(\z1),
trouver l'affixe d'un point \(M) tel que le triangle \(A B M) soit rectangle
isocèle en \(M).}

\hint{On peut utiliser une rotation, ou une similitude...}
\answer{\(Re(z))}{\rep}{type=numeric}
\answer{\(Im(z))}{\ima}{type=numeric}

\condition{ \(z = \rep + \ima *i)}{(\rep=\r and \ima=\j) or (\ima=\j1 and \rep=\r1)}

\solution{\(M) est l'image de \(B) par la similitude directe de centre \(A),
de rapport \(1/\sqrt{2}) et d'angle + \pi/4 ou d'angle - \pi/4.<p>
On peut aussi utiliser une rotation de centre \(M) inconnu et d'angle + \pi/2 ou -\pi/2.
</p>
On obtient : \(z = \M1) ou \(z = \M2)}
