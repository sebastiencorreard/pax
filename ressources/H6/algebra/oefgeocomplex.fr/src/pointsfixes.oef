transformation dans l'énoncé
\text{zprim=\signe>0 and \b=0 ?texmath(\A * z) }
\text{zprim=\signe>0 and \b=0 and (\A)=1 ? texmath(z) }
\text{zprim=\signe>0 and \b=0 and (\A)=-1 ? texmath(-z) }
\text{zprim=\signe > 0 and \b !=0  ? texmath(\A * z + \b)}
