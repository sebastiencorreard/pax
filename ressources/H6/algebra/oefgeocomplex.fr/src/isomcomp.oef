\integer{signe=randitem(1,-1,-2)}
pour signe=2 translation
pour signe=1 rotation
pour signe=-1 réflexion
pour signe=-2 symétrie glissée

\text{a=\signe<0 ? randrow(\remarquable2):randrow(\remarquable1)}
\text{A	=maxima(\a[2])}
\if{\A= 1 and \signe > 0}{\integer{signe=\signe + 1}}{\integer{signe=\signe}}
text{A = + isin \A or - isin \A ? (\A): \A}
\if{\signe > 0}{
\complex{b=randint(-2..2) + randint(-3..3)*i}
centre de la rotation
\text{c=\signe=1 ? maxima((\b)/(1-\a[2])): 0}
\text{point=centre}
\text{point= \signe = 2 ? bonne réponse}
angle de la rotation
\text{angle=\a[1]}
vecteur de la translation
\complex{u=\b}
}
{choix de b selon réflexion ou symétrie glissée
\text{b=\signe=-2 ? \a[5]:\a[4]}
\text{bbar=\signe=-2 ? \a[6]:0}
point de l'axe
\text{c=maxima((\b)/2)}
\text{point=point de l'axe}
vecteur de la symétrie glissée
\text{u=maxima(((\A)*(\bbar) +(\b))/2)}
angle de l'axe avec l'axe des x
\text{angle=(\a[1])/2}}

\text{centre=maxima(expand(rectform(\c)))}
\text{vecteur=maxima(expand(rectform(\u)))}
\text{ANGLE=maxima(expand(rectform(\angle)))}

transformation dans l'énoncé
\text{zprim=\signe>0 and \b=0 ?texmath(\A * z) }
\text{zprim=\signe>0 and \b=0 and (\A)=1 ? texmath(z) }
\text{zprim=\signe>0 and \b=0 and (\A)=-1 ? texmath(-z) }
\text{zprim=\signe > 0 and \b !=0  ? texmath(\A * z + \b)}
\text{zprim=\signe > 0 and \b !=0 and (\A)=1 ? texmath( z + \b)}
\text{zprim=\signe > 0 and \b !=0 and (\A)=-1? texmath(- z + \b)}
\text{zprim=\signe<0 and \b=0 ? texmath(\A ) \bar{z} }
\text{zprim=\signe<0 and \b=0 and (\A)=1 ? texmath(\bar{z}) }
\text{zprim=\signe<0 and \b=0 and (\A)=-1 ? texmath(-\bar{z}) }
\text{zprim=\signe < 0 and \b !=0 ? texmath(\A ) \bar{z}+ texmath(\b)}
\text{zprim=\signe < 0 and \b !=0 and (\A)=1? \bar{z}+ texmath(\b)}
\text{zprim=\signe < 0 and \b !=0 and (\A)=-1 ? - \bar{z}+ texmath(\b)}

question 1
\text{nature1=positive, négative}
\text{rep1=\signe >0 ? 1:2}

question2
\if{\signe >0}
{\text{nature2=translation, rotation}
\text{rep2=\A=1 ? 1 : 2}}
{\text{nature2=réflexion, symétrie glissée}
\text{rep2=\signe=-1 ? 1 : 2}
}


Etapes
\text{STEP = reply1
reply2}
\if{\signe =2}{
\text{STEP=\STEP
reply5}
}
\if{\signe=1}{
\text{STEP = \STEP
reply3,reply4}
}

\if{\signe=-1}{
\text{STEP = \STEP
reply3,reply4}
}
\if{\signe=-2}{
\text{STEP = \STEP
reply3,reply5}
}

\steps{\STEP}

\css{<style type="text/css">
  .question {background-color : #FFFFCC;
          margin : 2% 5%;
          padding : 2%;
          text-align:center;
  		}
 	</style>}

\statement{On  se place dans le plan affine euclidien muni d'un repère orthonormé direct d'origine \(O\).
La transformation \(f\) qui à un point \(M)
d'affixe \(z) associe le point \(M') d'affixe \(z') donné
par <div class="question">\(z'=\zprim \). </div>
\if{\step=1}{<p>est une isométrie \embed{reply1}</p>}
\if{\step=2}{<p>est une isométrie \nature1[\rep1] puisque \(f\) est de la forme
\if{\signe>0}{ \(z'=a z + b\) avec \(|a|=1\)}{ \(z'=a \bar{z} + b\) avec \(|a|=1\)}.</p>
<div>Plus précisément \(f\) est une \embed{reply2}.</div>}
\if{\step=3}{<p>est une \nature2[\rep2].</p>
<div>\if{\signe=2}{L'affixe de son vecteur est \embed{reply5}.}
\if{\signe=1}{Préciser ses éléments caractéristiques :<br>
Son centre a pour affixe \embed{reply3} et son angle a pour mesure \embed{reply4,5}.
<hr><i>Donner la mesure principale de l'angle en radian et pour \(\pi\), écrire
<span class="tt">pi</span>.</i>}
\if{\signe=-1}{Préciser ses éléments caractéristiques : <br>
Son axe passe par le point  d'affixe \embed{reply3} et
fait un angle de  mesure \embed{reply4,5} avec l'axe des \(x\).
<hr><em>Donner la mesure principale de l'angle en radian et pour \(\pi\), écrire
<span class="tt">pi</span></em>.}
\if{\signe=-2}{<p>Alors \(f\) est la composée d'une réflexion d'axe \(\Delta\)
et d'une  translation de vecteur \(\vec u\) qui dirige \(\Delta\).</p>
L'axe \(\Delta\) passe par le point  d'affixe \embed{reply3}, l'affixe du
vecteur \(\vec u\) est \embed{reply5}.}
</div>}
}
\answer{L'isométrie est}{\rep1;\nature1}{type=radio}
\answer{L'isométrie est une}{\rep2;\nature2}{type=radio}
\answer{\point}{\centre1}{type=complex}
\answer{Angle}{\angle}{type=numeric}
\answer{Vecteur}{\u}{type=complex}

conditions
pour la translation, il ne devrait pas avoir de condition
\if{\signe=2}{\text{test=0}}
\if{\signe=1}{
\text{test=pari(abs(\reply3-(\c)))}
}
pour la réflexion, tout point de la droite passant par \c et faisant un angle de \angle avec l'axe (Ox) est bon.
\if{\signe<0}{
\text{testaxe=pari(if(\reply3-(\c)==0,0,abs(arg(\reply3-(\c))-(\angle))))}
text{testaxe=\reply3=\c ? 0:pari(abs(arg(\reply3-(\c))-(\angle)))}
arg(x): argument of x,such that -pi<arg(x)<=pi.
\text{testaxe= \testaxe !=0 and pari(abs(\testaxe - pi))<0.001 ? 0}
\text{test=\testaxe}}
\condition{\point}{\test < 0.0001}

\feedback{\signe=1}{Le centre de la rotation est \(\centre). Son angle est \(\ANGLE\).}
\feedback{\signe = -1}{Un point fixe de \(f\) est \(\centre).
 C'est le milieu du segment d'extrémités \(O\) et \(f(O)\).
 L'angle de l'axe de la réflexion avec l'axe des \(x\) est \(\ANGLE\).}
\feedback{\signe = -2}{Un point de \(\Delta\) est \(\centre). C'est le milieu du segment d'extrémités \(O\) et \(f(O)\). Le vecteur de la translation de la symétrie glissée a pour affixe \(\vecteur\)}
\feedback{\signe=2}{Le vecteur de la translation a pour affixe \(\vecteur\)}
