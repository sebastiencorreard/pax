!set title=Nature des transformations complexes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
computeanswer=yes
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
precision=1000
oefcss=<style type="text/css">	 .question  {	  background-color: #FFFFCC;	  margin : 2% 5%;	  padding : 2%;	  text-align:center;}	  .reponse {background-color : #ffcc99;	          color : black;	          margin : 2% 5%;	          padding : 2%;	          text-align:center;	  }	 </style>	 

ansorder=r,r,r,r,r
varcnt=15
prevarcnt=13
postvarcnt=1
replycnt=5
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 0, 1	pi/6,(sqrt(3)+i)/2	pi/4,sqrt(2)*(1+i)/2	pi/3,(1 + sqrt(3)*i)/2	pi/2,i	2*pi/3,(-1 + sqrt(3)*i)/2	
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!randitem 1,1,1,1,sqrt(2),2,3,4,sqrt(3)

val8=$(tmp0)
t_=!replace internal \( by ( in $val8*$(val7[2])
tmp0=!exec maxima $t_

val9=$(tmp0)

!ifval + isin $val9 or - isin $val9 
val9= ($val9)
!else
val9= $val9
!endif
tmp0=!randint -2, 2

tmp1=!randitem 1,-1

tmp2=!randint -3, 3

t_=!rawmath $(tmp0) + $(tmp1) + $(tmp2)*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
val11=translation, homothétie,rotation, similitude directe

!ifval $val9=1 
val12= 1 
!else
val12= 4
!endif

!ifval $val9 != 1 and $(val7[1])=0 
val12= 2
!endif

!ifval $(val7[1])<>0 and abs($val8) = 1 
val12= 3
!endif

!ifval $val9 != 1 
t_=!replace internal \( by ( in expand(rectform(($val10)/(1-($val9))))
tmp0=!exec maxima $t_

val13= $(tmp0)
!endif
val14=reply1	reply2,reply3

!ifval $val9 !=1 
val14= $val14,reply4
!else
val14= $val14,reply5
!endif
oefsteps=$val14 
nextstep=!nosubst $val14 
!readproc oef/steps.proc
replytype1=radio
replyname1=
replygood1=$val12;$val11
replytype2=numeric
replyname2=Angle
replygood2=$[$(val7[1])]
replytype3=complex

replyname3=Rapport
replygood3=$val8
replytype4=complex

replyname4=Centre
replygood4=?analyze 15
replytype5=complex

replyname5=Vecteur
replygood5=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La transformation qui à un point 
!insmath M
$()	d'affixe 
!insmath z
$() associe le point 
!insmath M'
$() d'affixe 
!insmath z'
$() donné	par	<div class="question">	
!if $val10=0 
$()
!insmath  z'= $val9 * z
$()  
!else
$() 
!insmath  z'= $val9 * z + $val10
$() 
!endif
$() </div>	
!if $m_step=1 
$()est une	<div class="reponse">  
!read oef/embed.phtml reply1 
$()</div>	<p><i>Donner la réponse la plus précise. </i></p> 
!endif
$()	
!if $m_step=2 
$()est une similitude directe	
!if $val12 notsametext 4 
$()et plus précisément une $(val11[$(val12[1])]) 
!endif
$().	Préciser ses éléments caractéristiques :		<table class="wimsborder wimscenter"><tr>	
!if $val9!=1 
$()<th>centre</th> 
!else
$() <th>translation</th> 
!endif
$()	<th>angle</th><th>rapport</th></tr>	<tr><td>	
!if $val9!=1 
$() 
!read oef/embed.phtml reply4 
$() 
!else
$()  
!read oef/embed.phtml reply5 
$() 
!endif
$()</td><td> 
!read oef/embed.phtml reply2,5 
$()</td><td> 
!read oef/embed.phtml reply3,5 
$()</td>	</tr></table>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef

!ifval $val9!=1
t_=!replace internal \( by ( in abs($m_reply4-($val13))
tmp0=!exec pari $t_

val16= $(tmp0)
!endif

!exit

:feedback
!ifval $val16 > 0.0001
 <div class='oef_feedbacks'>Le centre est 
!insmath $val13
$()
$()</div>
!endif

!exit

:test

!ifval $val16 < 0.0001
 condtest1=1
!else
 condtest1=0
!endif
condname1=Centre

!exit

:stat
vsavelist=9,10,11,12,13,15
embedcnt=5
