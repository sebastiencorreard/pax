!set title=Angles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr
computeanswer=yes
precision=10000
leftrange=-5.000000
rightrange=5.000000

ansorder=r,r,r
varcnt=30
prevarcnt=28
postvarcnt=1
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 1

val6=$(tmp0)
val7=0
!while $val7=0 
!if $val6=1 
tmp=!nonempty items -4,-3,-2,-1,1,2,3,4

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items -2,-1,1,2

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items $val8,$val8*i,$val8+$val8*i,$val8-$val8*i

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items -4,-3,-2,-1,1,2,3,4

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items -2,-1,1,2

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items $val8+$val8*i,$val8-$val8*i

tmp0=!randitem $tmp
val11=$(tmp0)
!else
tmp=!nonempty items -4,-3,-2,-1,1,2,3,4

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items -2,-1,1,2

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items $val8,$val8*i,2*$val9+$val9*i,2*$val9-$val9*i,$val9+2*$val9*i,$val9-2*$val9*i

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items -4,-3,-2,-1,1,2,3,4

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items -2,-1,1,2

tmp0=!randitem $tmp
val9=$(tmp0)
tmp=!nonempty items 2*$val9+$val9*i,2*$val9-$val9*i,$val9+2*$val9*i,$val9-2*$val9*i

tmp0=!randitem $tmp
val11=$(tmp0)
!endif
tmp=!nonempty items -2,-1,1,2

tmp0=!randitem $tmp
tmp=!nonempty items -2,-1,1,2

tmp1=!randitem $tmp
t_=!rawmath $(tmp0)+($(tmp1)*i)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
t_=!rawmath ($val12)+($val10)
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
t_=!rawmath ($val12)+($val11)
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!rawmath ($val11-($val12))/($val10-($val12))
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
t_=!replace internal \( by ( in round(arg($val13)/pi*12)/12
tmp0=!exec pari $t_

val7=$(tmp0)
tmp=!translate ";': to $     $ in $val7*pi

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val7=$(tmp0)
!endwhile
val14=$val12,$val10,$val11
tmp0=!shuffle A,B,C

val15=$(tmp0)
val16=\((\overrightarrow{$(val15[1])$(val15[2])},\overrightarrow{$(val15[1])$(val15[3])})\)
val17=\((z_$(val15[3])-z_$(val15[1]))/(z_$(val15[2])-z_$(val15[1]))\),\((z_$(val15[2])-z_$(val15[1]))/(z_$(val15[3])-z_$(val15[1]))\),\((z_$(val15[3])-z_$(val15[2]))/(z_$(val15[1])-z_$(val15[2]))),\((z_$(val15[3])-z_$(val15[1]))/(z_$(val15[1])-z_$(val15[2]))),\((z_$(val15[1])-z_$(val15[2]))/(z_$(val15[3])-z_$(val15[2]))),\((z_$(val15[2])-z_$(val15[3]))/(z_$(val15[1])-z_$(val15[3]))),\((z_$(val15[1])-z_$(val15[3]))/(z_$(val15[2])-z_$(val15[3]))),\((z_$(val15[2])-z_$(val15[3]))/(z_$(val15[3])-z_$(val15[1])))
tmp0=!positionof item A in $val15

val18=$[rint($(tmp0))]
tmp0=!positionof item B in $val15

val19=$[rint($(tmp0))]
tmp0=!positionof item C in $val15

val20=$[rint($(tmp0))]
val21=$[rint(1)]
oefsteps=reply 1	reply 2	reply 3 
nextstep=!nosubst reply 1	reply 2	reply 3 
!readproc oef/steps.proc
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=$val21;$val17
replytype2=complex

replyname2=
replygood2=$val13
replytype3=function
replyname3=
replygood3=?analyze 22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		On considère les points 
!insmath A
$(), 
!insmath B
$() et 
!insmath C
$() d'affixes respectives : <br>	<div class="wimscenter"> 
!insmath z_A = 
$() 
!insmath $(val14[$val18])
$(), &nbsp;	
!insmath z_B = 
$() 
!insmath $(val14[$val19])
$(), &nbsp; et &nbsp;	
!insmath z_C = 
$()
!insmath  $(val14[$val20])
$()</div>	<i>Cet exercice comprend 3 étapes.</i><br>	1. On cherche à calculer l'angle $(val16[$val21]). De quel nombre complexe cet angle est-il un argument ?<br>	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
!if $m_step > 1 
$()	 <br>	 2. Ecrire ce quotient sous la forme 
!insmath a+b i
$().<br>	        <div class="wimscenter">$(val17[$val21]) =  
!read oef/embed.phtml reply2,8 
$()</div>	  
!endif
$()	
!if $m_step >2 
$()	 3. Déterminer une mesure de l'angle $val16 (en radians) ? <br>	        <div class="wimscenter"> 
!read oef/embed.phtml reply3,8 
$()</div>	  
!endif
$()	
$()
!exit

