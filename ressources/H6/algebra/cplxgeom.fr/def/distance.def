!set title=Distance entre deux points
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

tmp1=!randint -5, 5

t_=!rawmath $(tmp0)+i*$(tmp1)
t_=!exec pari print($t_)
val6=!mathsubst I=i in $t_
tmp0=!randint -5, 5

tmp1=!randint -5, 5

t_=!rawmath $(tmp0)+i*$(tmp1)
t_=!exec pari print($t_)
val7=!mathsubst I=i in $t_
t_=!replace internal \( by ( in norm($val7-($val6))
tmp0=!exec pari $t_

val8=$(tmp0)
tmp=!translate ";': to $     $ in sqrt($val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la distance entre les points 
!insmath A
$() et 
!insmath B
$() d'affixes respectives : <br>	<div class="wimscenter"> 
!insmath z_A = 
$() 
!insmath $val6
$() &nbsp; et &nbsp;	
!insmath z_B = 
$()
!insmath  $val7
$()</div>	La distance entre les points 
!insmath A
$() et 
!insmath B
$() vaut  
!read oef/embed.phtml reply1,6 
$().</div>	
$()
!exit

