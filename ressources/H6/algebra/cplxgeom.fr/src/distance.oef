\title{Distance entre deux points}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\complex{zA=randint(-5..5)+i*randint(-5..5)}
\complex{zB=randint(-5..5)+i*randint(-5..5)}
\text{dist=pari(norm(\zB-(\zA)))}
\text{dist=simplify(sqrt(\dist))}

\statement{Calculer la distance entre les points \(A) et \(B) d'affixes respectives : <br>
<div class="wimscenter"> \(z_A = ) \(\zA\) &nbsp; et &nbsp;
\(z_B = )\( \zB\)</div>
La distance entre les points \(A\) et \(B\) vaut \embed{reply1,6}.</div>
}

\answer{}{\dist}{type=formal}
