!set title=Quadrilateral
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000
title_fr=Quadrilatère

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=We have a quadrilateral in the cartesian plane with	  4 vertices \(A\), \(B\), \(C\), \(D\) such that
val8=The middle of the side,is
val9=What is the middle \((x,y)) of the side\(D A\)
!if $val6=fr 
val7=Les quatre sommets \(A\), \(B\), \(C\), \(D\) d'un quadrilatère	  dans le plan cartésien vérifient&nbsp;
val8=Le milieu du côté,est
val9=Quel est le milieu \((x,y)) du côté \(D A\)&nbsp;
!endif
tmp0=!randint -199, 199

val10=$[rint($(tmp0))]
tmp0=!randint -199, 199

val11=$[rint($(tmp0))]
tmp0=!randint -199, 199

val12=$[rint($(tmp0))]
tmp0=!randint -199, 199

val13=$[rint($(tmp0))]
tmp0=!randint -199, 199

val14=$[rint($(tmp0))]
tmp0=!randint -199, 199

val15=$[rint($(tmp0))]
val16=$[rint($val10+($val12)-($val11))]
val17=$[rint($val13+($val15)-($val14))]
replyname1=\(x)
replygood1=$val16
replyname2=\(y)
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	<ul><li>$(val8[1]) 
!insmath A B
$() $(val8[2]) ($val10 , $val13).	</li><li>$(val8[1]) 
!insmath B C
$() $(val8[2]) ($val11 , $val14).	</li><li>$(val8[1]) 
!insmath C D
$() $(val8[2]) ($val12 , $val15).	</li></ul>	$val9?	
$()
!exit

