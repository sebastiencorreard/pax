val18=$[rint(($val11+$val15)/2)]
val19=$[rint(($val13+$val15)/2)]
val20=$[rint(($val12+$val14)/2)]
val21=$[rint(($val12+$val16)/2)]
val22=$[rint(($val14+$val16)/2)]
