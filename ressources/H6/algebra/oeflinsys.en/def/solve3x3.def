tmp0=!randint 2, 10

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val16=$[rint($(tmp0)*$(tmp1))]
val12=$[rint(abs((($val15)*($val13)*($val10)-($val15)*($val14)*($val9)+($val16)*($val14)*($val8)-($val16)*($val11)*($val10))	  /(($val8)*($val13)-($val9)*($val11))))]

!ifval $val12>11
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val17=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val12+2, $val12+6

tmp3=!randitem -1,1

val17=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint -10, 10

val18=$[rint($(tmp0))]
tmp0=!randint -10, 10

val19=$[rint($(tmp0))]
tmp0=!randint -10, 10

val20=$[rint($(tmp0))]
val21=$[($val8)*($val13)*($val17)+($val9)*($val14)*($val15)+($val10)*($val11)*($val16)	 -($val9)*($val11)*($val17)-($val8)*($val14)*($val16)-($val10)*($val13)*($val15)]
val22=$[(($val18)*($val13)*($val17)+($val9)*($val14)*($val20)+($val10)*($val19)*($val16)	 -($val9)*($val19)*($val17)-($val18)*($val14)*($val16)-($val10)*($val13)*($val20))/($val21)]
val23=$[(($val8)*($val19)*($val17)+($val18)*($val14)*($val15)+($val10)*($val11)*($val20)	 -($val18)*($val11)*($val17)-($val8)*($val14)*($val20)-($val10)*($val19)*($val15))/($val21)]
val24=$[(($val8)*($val13)*($val20)+($val9)*($val19)*($val15)+($val18)*($val11)*($val16)	 -($val9)*($val11)*($val20)-($val8)*($val19)*($val16)-($val18)*($val13)*($val15))/($val21)]

!ifval $val9>=0
