!ifval $val12>11
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val12+2, $val12+6

tmp3=!randitem -1,1

val13=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint 2, 10

tmp1=!randitem -1,1

