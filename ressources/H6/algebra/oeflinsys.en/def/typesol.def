!set title=Type of solutions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
computeanswer=no
leftrange=-5.000000
rightrange=5.000000
precision=10000
title_fr=Type de solutions

ansorder=c,c,c
varcnt=38
prevarcnt=37
postvarcnt=0
replycnt=0
choicecnt=3
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Yes
val8=No
tmp=!trim We have a system of,in	  Among the following propositions, which are true
val9=!translate internal $	\
$ to ;; in $tmp
val10=The system may have no solution.,	  The system may have a unique solution.,	  The system may have infinitely many solutions.
val11=At least one variable is in each equation.
val12=homogeneous,homogeneous
val13=non zero,non zero
val14=non
val15=linear equations,linear equation
val16=variables,variable
val17=is true
!if $val6=fr 
val7=Oui
val8=Non
tmp=!trim Soit un système de,en	  Parmi les propositions suivantes, lesquelles sont vraies&nbsp;
val9=!translate internal $	\
$ to ;; in $tmp
val10=Le système peut ne pas avoir de solution.,	  Le système peut avoir une solution unique.,	  Le système peut avoir une infinité de solutions.
val11=On suppose qu'au moins une variable apparait	  effectivement dans chaque équation.
val12=homogènes,homogène
val13=non nulles,non nulle
val14=non
val15=équations linéaires,équation linéaire
val16=variables,variable
val17=est vraie
!endif
tmp0=!randitem 1,1,2,3,4,5

val18=$[rint($(tmp0))]
tmp0=!randint $val18+1, $val18+5

val19=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

val20=$[rint($(tmp0))]
tmp0=!item $val20 of $val18,$val18,$val19

val21=$[rint($(tmp0))]
tmp0=!item $val20 of $val18,$val19,$val18

val22=$[rint($(tmp0))]
tmp0=!randitem 0,1

val23=$[rint($(tmp0))]

!ifval $val21>1
val24=$(val12[1])
!else
val24=$(val12[2])
!endif

!ifval $val21>1
val25=$(val13[1])
!else
val25=$(val13[1])
!endif

!ifval $val23=1
val26=$val24
!else
val26=$val14 $val24
!endif

!ifval $val21>1
val27=$(val15[1])
!else
val27=$(val15[2])
!endif

!ifval $val22>1
val28=variables
!else
val28=variable
!endif

!ifval $val23=0 and $val21>1
val29=$val7
!else
val29=$val8
!endif

!ifval $val21>=$val22
val30=$val7
!else
val30=$val8
!endif

!ifval $val22>1
val31=$val7
!else
val31=$val8
!endif
choicename1=A $val17
choicegood1=$val29
choicebad1=$val7,$val8
choicename2=B $val17
choicegood2=$val30
choicebad2=$val7,$val8
choicename3=C $val17
choicegood3=$val31
choicebad3=$val7,$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val9[1;1]) $val21 $val27 $val26 $(val9[1;2]) $val22 $val28. $(val9[2;])?	<ul><li>	A. $(val10[1])	</li><li>	B. $(val10[2])	</li><li>	C. $(val10[3])	</li></ul>	<div class="wims_instruction">	$val11	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,21,22,26,27,28
embedcnt=0
