!set title=Equal distances
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO,Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000
title_fr=Distances égales

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Find the coordinates of the point \(p = (x,y)\)	  in the cartesian plane, such that
val8=The distance between,ean,d, equals that between
val9=The set of points with equal distance towards two points	  \(q_1\) and \(q_2\) form a straight line.	  Find first the equation of this line in function of the	  coordinates of \(q_1) and \(q_2).
!if $val6=fr 
val7=Trouver les coordonnées du point \(p = (x,y)\) dans le plan	  cartésien, tel que
val8=La distance entre,et, égale celle entre
val9=L'ensemble de points à distance égale vers deux points	  \(q_1\) et \(q_2\) forment une droite. Trouvez d'abord l'équation de cette droite	  en fonction de coordonnées de \(q_1) et \(q_2).
!endif
tmp0=!randint -10, 2

val10=$[rint($(tmp0))]
tmp0=!randint $val10+1, 10

val11=$[rint($(tmp0))]
tmp0=!randint -10, 5

val12=$[rint($(tmp0))]
tmp0=!randint $val12, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 2

val14=$[rint($(tmp0))]
tmp0=!randint -5, 10

val15=$[rint($(tmp0))]
tmp0=!randint $val14+1, 10

val16=$[rint($(tmp0))]
tmp0=!randint -10, $val15-1

val17=$[rint($(tmp0))]
val18=$[2*($val10-($val11))]
val19=$[2*($val12-($val13))]
val20=$[($val12)^2-($val13)^2+($val10)^2-($val11)^2]
val21=$[2*($val14-($val16))]
val22=$[2*($val15-($val17))]
val23=$[($val14)^2-($val16)^2+($val15)^2-($val17)^2]
val24=$[($val18)*($val22)-($val21)*($val19)]
val25=$[(($val20)*($val22)-($val23)*($val19))/($val24)]
val26=$[(($val18)*($val23)-($val21)*($val20))/($val24)]
replyname1=\(x)
replygood1=$val25
replyname2=\(y)
replygood2=$val26
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val9


!goto stat

!exit

:question
$()$val7:	<ol><li>	 $(val8[1]) 
!insmath p
$() $(val8[2]) 
!insmath q_1
$()=($val10,$val12) $(val8[3])	  
!insmath p
$() $(val8[2]) 
!insmath q_2
$() = ($val11,$val13).	</li><li>	  $(val8[1]) 
!insmath p
$() $(val8[2]) 
!insmath r_1
$()=($val14,$val15) $(val8[3])	   
!insmath p
$() $(val8[2]) 
!insmath r_2
$() = ($val16,$val17).	</li></ol>
$()
!exit

:hint
$()$val9
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

