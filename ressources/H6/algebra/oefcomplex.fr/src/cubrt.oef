\title{Racine cubique}

\integer{a=random(1..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\complex{z1=\a+\b*i}

\text{lang=slib(oef/env lang)}


/* note for translators: keep commas */
\text{name_statement=Trouver une racine cubique \(w) du nombre complexe,en donnant sa partie réelle et partie imaginaire}




































































































































\statement{\name_statement[1] \(z=\z1), \name_statement[2].}
\answer{\(Re(w))}{\re}
\answer{\(Im(w))}{\im}
\condition{\(Re(w^3)=\a)}{(\re)^3-3*(\re)*(\im)^2=\a}
\condition{\(Im(w^3)=\b)}{3*(\re)^2*(\im)-(\im)^3=\b}

