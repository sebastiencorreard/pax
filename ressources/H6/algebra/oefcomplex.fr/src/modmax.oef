\title{Module maximal}

\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\real{mod=sqrt((\a)^2+(\b)^2)}
\integer{modz=random(1..9)}
\real{re=\a*\modz/\mod}
\real{im=\b*\modz/\mod}

\text{lang=slib(oef/env lang)}







































































































/* note for translators: keep commas */
\text{name_statement=Parmi tous les nombres complexes \(z) de module,
trouver celui pour qui le module de,est maximal}








































\statement{\name_statement[1] \modz,
  \name_statement[2] \(\a+\b*i+z) \name_statement[3].}
\answer{\(Re(z))}{\re}
\answer{\(Im(z))}{\im}

