!set title=Racine carrée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=1000
computeanswer=yes

ansorder=r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
!readproc slib/oef/env lang 
tmp0=$slib_out
val8=$(tmp0)
val9=Trouver une racine carrée \(w) du nombre complexe,	en donnant sa partie réelle et partie imaginaire
replytype1=numeric
replyname1=\(Re(w))
replygood1=?analyze 10
replytype2=numeric
replyname2=\(Im(w))
replygood2=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val9[1])	
!insmath z = $val6+$val7*i
$(), $(val9[2]).	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val10)^2-($val11)^2=$val6
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(Re(w^2 )) = $val6

!ifval 2*($val10)*($val11)=$val7
 condtest2=1
!else
 condtest2=0
!endif
condname2=\(Im(w^2 )) = $val7

!exit

:stat
vsavelist=6,7,9,10,11
embedcnt=0
