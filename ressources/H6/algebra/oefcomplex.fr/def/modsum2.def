 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of +,-

val7=$(tmp0)
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randint 10, 170

val10=$[rint($(tmp0))]
val11=$[sqrt($val8^2+$val9^2$val7 2*$val8*$val9*cos($val10*pi/180))]
!readproc slib/oef/env lang 
tmp0=$slib_out
val12=$(tmp0)
val13=et
val14=Soient,deux nombres complexes avec,degrés,Calculer le module de
val15=Rappelez-vous du théorème de cosinus&nbsp;: si un triangle a	trois côtés de longueurs \(a), \(b), \(c) et si l'on note par	\(A) l'angle opposé au côté \(a), alors
replyname1=\(|z_1$val7 z_2|)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[1]) 
!insmath z_1
$() $val13 
!insmath z_2
$() $(val14[2])	
!insmath |z_1|=$val8
$(), 
!insmath |z_2|=$val9
$() $val13 
!insmath Arg(z_1/z_2)=$val10
$() $(val14[3]).	$(val14[4])	
!insmath z_1$val7 z_2
$()&nbsp;.
$()
!exit

:hint
