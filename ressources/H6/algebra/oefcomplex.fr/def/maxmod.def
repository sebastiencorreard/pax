!set title=Maximum de module
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -20, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[sqrt(($val6)^2+($val7)^2)]
tmp0=!randint 1, 99

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val8+$val9,abs($val8-$val9)

val11=$[$(tmp0)]
!readproc slib/oef/env lang 
tmp0=$slib_out
val12=$(tmp0)
val13=maximum,minimum
val14=Quel est le,du module,où \(z) est un nombre complexe de module
val15=du module
tmp0=!item $val10 of $val13

val16=$(tmp0)
replyname1=$val16 $val15
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[1]) $val16 $(val14[2]) 
!insmath |$val6+$val7*i+z |
$(),	  $(val14[3]) 
!insmath |z|= $val9
$()&nbsp;?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,14,16
embedcnt=0
