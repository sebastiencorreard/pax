!set title=Pythagore II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=complex_plane
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=1,      1,      2,3, 5, 7
val7=1,      2,      2,4,12,24
val8=sqrt(2),sqrt(5),sqrt(8),5,13,25
tmp0=!itemcnt $val6

val9=$[rint($(tmp0))]
tmp0=!randint 1, $val9

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val6

val11=$[$(tmp0)]
tmp0=!item $val10 of $val7

val12=$[$(tmp0)]
tmp0=!item $val10 of $val8

val13=$(tmp0)
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val11,$val12

val15=$(tmp0)
tmp0=!item $val14 of $val12,$val11

val16=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val17=$(tmp0)
val18=et
val19=Soient,deux nombres complexes avec,Quelle est la valeur de
val20=Votre réponse
val21=Pensez au théorème de Pythagore&nbsp;! Quelle est la différence entre
replyname1=$val20
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val19[1]) 
!insmath z_1 
$() $val18 
!insmath z_2
$() $(val19[2])	
!insmath |z_1 |=$val15
$(), 
!insmath |z_1 +z_2 |=|z_1 -z_2|=$val13
$(). $(val19[3])	
!insmath |z_2 |
$()&nbsp;?
$()
!exit

:hint
$()$val21	
!insmath Arg(z_1 )
$() $val18 
!insmath Arg(z_2 )
$()&nbsp;?
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,15,18,19,21
embedcnt=0
