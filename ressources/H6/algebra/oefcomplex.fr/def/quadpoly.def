!set title=Racines d'un polynôme quadratique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 2, 50

val6=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val7=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val8=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val9=$[$(tmp0)*$(tmp1)/10]
val10=$[-($val6)-($val8)]
val11=$[-($val7)-($val9)]
val12=$[($val6)*($val8)-($val7)*($val9)]
val13=$[($val6)*($val9)+($val8)*($val7)]
!readproc slib/oef/env lang 
tmp0=$slib_out
val14=$(tmp0)
val15=Calculer les deux racines du polynôme
val16=Vous pouvez entrer les deux racines \(r1) et \(r2) dans n'importe quel ordre.
val17=est une racine
val18=est l'autre racine
replyname1=\(Re(r1))
replygood1=?analyze 19
replyname2=\(Im(r1))
replygood2=?analyze 20
replyname3=\(Re(r2))
replygood3=?analyze 21
replyname4=\(Im(r2))
replygood4=?analyze 22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val15	<div class="wimscenter">	
!insmath P(X) = X^2 + ($val10+$val11*i)X + ($val12+$val13 *i)
$().	</div>	<div class="wims_instruction">	$val16	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val19=$val6 and $val20=$val7) or ($val19=$val8 and $val20=$val9)
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(r_1) $val17

!ifval (($val21=$val6 and $val22=$val7) or ($val21=$val8 and $val22=$val9))	 and $val19+$val21=-($val10)
 condtest2=1
!else
 condtest2=0
!endif
condname2=\(r_2) $val18

!exit

:stat
vsavelist=6,7,8,9,10,11,12,13,15,16,17,18,19,20,21,22
embedcnt=0
