!set title=Somme de i
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp0=!randint 100, 200

val7=$[rint($(tmp0))]
val8=$[rint($val6+1)]
val9=$[rint($val6+2)]
val10=$[rint($val6%4+1)]
val11=$[rint(($val7+1-$val6)%4)]

!ifval $val11=0
val12=$[0]
!endif

!ifval $val11=0
val13=$[0]
!endif

!ifval $val11=1
tmp0=!item $val10 of 1,0,-1,0

val12=$[$(tmp0)]
!endif

!ifval $val11=1
tmp0=!item $val10 of 0,1,0,-1

val13=$[$(tmp0)]
!endif

!ifval $val11=2
tmp0=!item $val10 of 1,-1,-1,1

val12=$[$(tmp0)]
!endif

!ifval $val11=2
tmp0=!item $val10 of 1,1, -1,-1

val13=$[$(tmp0)]
!endif

!ifval $val11=3
tmp0=!item $val10 of 0,-1,0,1

val12=$[$(tmp0)]
!endif

!ifval $val11=3
tmp0=!item $val10 of 1,0,-1,0

val13=$[$(tmp0)]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val14=$(tmp0)
val15=Calculer la somme
replyname1=\(Re(S))
replygood1=$val12
replyname2=\(Im(S))
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val15	<div class="wimscenter">	
!insmath S=i^$val6 +i^$val8 +i^$val9 +...+i^$val7
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

