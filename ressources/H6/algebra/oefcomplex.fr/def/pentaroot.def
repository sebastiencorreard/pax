!set title=Pentaroot
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=roots
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]

!ifval $val6=1
tmp0=!randint 20, 99

tmp1=!randint 1, 4

val7=$[rint(5*$(tmp0)+$(tmp1))]
!else
tmp2=!randint 20, 99

val7=$[rint(5*$(tmp2))]
!endif

!ifval $val6=1
val8=$[rint(-1)]
!else
val8=$[rint(4)]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val9=$(tmp0)
val10=Soient,les 4 racines (complexes) du polynôme,Quel est le nombre
replyname1=\(Re(w))
replygood1=$val8
replyname2=\(Im(w))
replygood2=0
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath z_1
$(), 
!insmath z_2
$(), 
!insmath z_3
$(), 
!insmath z_4
$() $(val10[2])	
!insmath X^4 +X^3 +X^2 +X+1
$(). $(val10[3])	
!insmath w=z_1^$val7+z_2^$val7+z_3^$val7+z_4^$val7
$() ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10
embedcnt=0
