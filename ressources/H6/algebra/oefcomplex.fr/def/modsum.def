!set title=Module de somme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of +,-

val7=$(tmp0)
tmp0=!item $val6 of -,+

val8=$(tmp0)
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
tmp0=!randint $val9, $val9+10

val10=$[rint($(tmp0))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
!readproc slib/oef/env lang 
tmp0=$slib_out
val12=$(tmp0)
val13=Oui,Non
val14=Existe-t-il deux nombres complexes \(z_1) et \(z_2) tels que
val15=Quelles sont des conditions sur les longueurs des	  3 côtés d'un triangle&nbsp;?
val16=Votre réponse
tmp0=!item $val11 of $val13

val17=$(tmp0)
tmp0=!randint $val10, $val9+$val10

tmp1=!randint $val9+$val10+1, $val9+$val10+6

tmp2=!item $val11 of $(tmp0),$(tmp1)

val18=$[rint($(tmp2))]
tmp0=!randint 1, 6

val19=$[rint($(tmp0))]
tmp0=!item $val19 of $val9,$val9,$val10,$val10,$val18,$val18

val20=$(tmp0)
tmp0=!item $val19 of $val10,$val18,$val9,$val18,$val10,$val9

val21=$(tmp0)
tmp0=!item $val19 of $val18,$val10,$val18,$val9,$val9,$val10

val22=$(tmp0)
choicename1=$val16
choicegood1=$val17
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val15


!goto stat

!exit

