!set title=Argument demandé
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -20, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val8=!mathsubst I=i in $t_
val9=$[sqrt(($val6)^2+($val7)^2)]

!ifval $val7>0
val10=$[pi/2]
!else
val10=$[-pi/2]
!endif

!ifval $val6=0
val11=$[$val10]
!else
val11=$[arctan($val7/($val6))]
!endif

!ifval $val6<0
val12=$[$val11+pi]
!else
val12=$[$val11]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Donner le module et un argument du nombre complexe
val15=est un argument de
replytype1=numeric
replyname1=\(|z|)
replygood1=$[$val9]
replytype2=numeric
replyname2=\(Arg(z))
replygood2=?analyze 16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14 
!insmath $val8
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs(($val16-$val12)/(2*pi)-round(($val16-$val12)/(2*pi)))<0.0001
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val16 $val15 \(z)

!exit

:stat
vsavelist=8,12,14,15,16
embedcnt=0
