!set title=Somme avec inverse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of -1,1

val7=$(tmp0)
tmp0=!randint 100, 999

val8=$[rint($(tmp0))]

!ifval $val8%3=0
val9=$[rint(2)]
!else
val9=$[rint(-1)]
!endif

!ifval $val6=1 or $val8%2=0
val9=$[rint($val9)]
!else
val9=$[rint(-($val9))]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Soit \(z) un nombre complexe avec,Calculez
replyname1=\(Re(w))
replygood1=$val9
replyname2=\(Im(w))
replygood2=0
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val11[1]) 
!insmath z+1/z=$val7
$(). $(val11[2])	
!insmath w=z^$val8 +z^(-$val8 )
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11
embedcnt=0
