!set title=Quadratique racine double
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(-2*($val6))]
val9=$[rint(-2*($val7))]

!ifval $val9>0
val10=+$val9
!else
val10=$val9
!endif
val11=$[rint(($val6)^2-($val7)^2)]
val12=$[rint(2*($val6)*($val7))]

!ifval $val12>=0
val13=+$val12
!else
val13=$val12
!endif

!ifval $val7>=0
val14=+$val7
!else
val14=$val7
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val15=$(tmp0)
val16=Pour quelle valeur complexe \(w) le polynôme,a-t-il une racine double (complexe)&nbsp;
val17=La racine double
replyname1=\(w)
replygood1=$val11$val13*i
replyname2=$val17
replygood2=$val6$val14*i
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val16[1])	<div class="wimscenter">	
!insmath X^2+($val8+$val10*i)*X+w
$()	</div>	$(val16[2])?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,16
embedcnt=0
