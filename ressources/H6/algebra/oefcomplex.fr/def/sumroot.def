!set title=Somme de racines d'unité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=roots
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 6,6,3,5,7

val6=$[rint($(tmp0))]
val7=$[rint($val6-1)]

!ifval $val6=6
val8=$[rint(3)]
!else
val8=$[rint($val6)]
!endif

!ifval $val6=3
tmp0=!randitem 2,4

val9=$[rint($(tmp0))]
!endif

!ifval $val6=5
tmp0=!randitem 2,4,6,8

val9=$[rint($(tmp0))]
!endif

!ifval $val6=6
tmp0=!randitem ,-,5,7

val9=$(tmp0)
!endif

!ifval $val6=7
tmp0=!randitem 2,4,6,8,10,12

val9=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 10

val10=$[rint($(tmp0))]

!ifval $val10>1
val11=$val10
!else
val11=
!endif
val12=$[rint($val10+1)]
val13=$[rint($val10+2)]
val14=$[rint($val10+3)]
val15=$[rint($val10+4)]
val16=$[rint($val10+5)]
val17=$[rint($val10+6)]

!ifval $val6=3
val18=w^{$val11}+w^{$val12}+w^{$val13}
!endif

!ifval $val6=5
val18=w^{$val11}+w^{$val12}+w^{$val13}+w^{$val14}+w^{$val15}
!endif

!ifval $val6=6
val18=w^{$val11}+w^{$val12}+w^{$val13}+w^{$val14}+w^{$val15}+w^{$val16}
!endif

!ifval $val6=7
val18=w^{$val11}+w^{$val12}+w^{$val13}+w^{$val14}+w^{$val15}+w^{$val16}+w^{$val17}
!endif

!ifval $val6=3
val19=X^2 +X+1
!else
val19=X^$val7 +....+X+1
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val20=$(tmp0)
val21=Soit,Quelle est la valeur de
val22=est une racine du polynôme
replyname1=\(Re(S))
replygood1=0
replyname2=\(Im(S))
replygood2=0
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val21[1]) 
!insmath w=\cos{$val9\pi\over $val8}+i\sin{$val9\pi\over $val8}
$().	$(val21[2])	<div class="wimscenter">
!insmath S=$val18
$() ? </div>
$()
!exit

:hint
$()
!insmath w
$() $val22 
!insmath X^$val6 -1 =	(X-1)(X^$val7 +....+X+1)
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,18,21,22
embedcnt=0
