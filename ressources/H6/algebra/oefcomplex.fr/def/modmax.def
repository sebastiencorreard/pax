!set title=Module maximal
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -20, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[sqrt(($val6)^2+($val7)^2)]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
val10=$[$val6*$val9/$val8]
val11=$[$val7*$val9/$val8]
!readproc slib/oef/env lang 
tmp0=$slib_out
val12=$(tmp0)
val13=Parmi tous les nombres complexes \(z) de module,	trouver celui pour qui le module de,est maximal
replyname1=\(Re(z))
replygood1=$val10
replyname2=\(Im(z))
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val13[1]) $val9,	  $(val13[2]) 
!insmath $val6+$val7*i+z
$() $(val13[3]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,13
embedcnt=0
