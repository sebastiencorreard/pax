!set title=Racine cubique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val8=!mathsubst I=i in $t_
!readproc slib/oef/env lang 
tmp0=$slib_out
val9=$(tmp0)
val10=Trouver une racine cubique \(w) du nombre complexe,en donnant sa partie réelle et partie imaginaire
replyname1=\(Re(w))
replygood1=?analyze 11
replyname2=\(Im(w))
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath z=$val8
$(), $(val10[2]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val11)^3-3*($val11)*($val12)^2=$val6
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(Re(w^3)=$val6)

!ifval 3*($val11)^2*($val12)-($val12)^3=$val7
 condtest2=1
!else
 condtest2=0
!endif
condname2=\(Im(w^3)=$val7)

!exit

:stat
vsavelist=6,7,8,10,11,12
embedcnt=0
