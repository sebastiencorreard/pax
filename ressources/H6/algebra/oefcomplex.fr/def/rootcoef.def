!set title=Racine et coefficients
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=roots
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
val7=$[rint(($val6)^2)]
!readproc slib/oef/env lang 
tmp0=$slib_out
val8=$(tmp0)
val9=Soit \(P(X)=X^2 + p X + q) un polynôme où les coefficients	\(p) et \( q) sont réels. On sait que \(P) a une racine complexe \( z) dont la	partie imaginaire est égale à
val10=Dans ce cas, il y a une relation entre les coefficients	\( p) et \(q). Déterminez cette relation en donnant \( q) comme	une fonction de \(p).
val11=Si,l'autre racine de \(P) est,Donc,ou,Et
replyname1=\(q)
replygood1=$val7+0.25*p^2
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9 
!insmath $val6
$(). $val10
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$(val11[1]) 
!insmath z=a+$val6*i
$(), $(val11[2]) 
!insmath w=a-$val6*i
$().	$(val11[3]) 
!insmath p=-2a
$(), $(val11[4]) 
!insmath a=-0.5*p
$().	$(val11[5]) 
!insmath q=z*w=a^2+($val6)^2=($val6)^2+0.25*p^2
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,11
embedcnt=0
