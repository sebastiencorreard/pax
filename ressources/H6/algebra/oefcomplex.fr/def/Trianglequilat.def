!set title=Triangle équilatéral
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=complex_plane
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=1000
computeanswer=yes

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 9

val6=$[rint($(tmp0))]
tmp0=!randint 0, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
val10=$[rint($val8-$val6)]
val11=$[rint($val9-$val7)]
val12=$[$val6+($val10-$val11*3^(1/2))/2]
val13=$[$val6+($val10+$val11*3^(1/2))/2]
val14=$[$val7+ ($val10*3^(1/2)+$val11)/2]
val15=$[$val7+ (-$val10*3^(1/2)+$val11)/2]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
t_=!rawmath $val8+$val9*i
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
!readproc slib/oef/env lang 
tmp0=$slib_out
val18=$(tmp0)
val19=et
val20=Si \(A) et \(B) sont des points du plan d'affixe,	trouver l'affixe d'un point \(M) tel que le triangle \(ABM) soit équilatéral
val21=\(AM) est l'image de \(AB) par une rotation. Laquelle ?
replytype1=default
replyname1=\(Re(z))
replygood1=?analyze 22
replytype2=default
replyname2=\(Im(z))
replygood2=?analyze 23
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val21


!goto stat

!exit

:question
$()$(val20[1]) 
!insmath $val16
$() $val19 
!insmath $val17
$(),	$(val20[2]).
$()
!exit

:hint
$()$val21
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val22=$val12 and $val23=$val14) or ($val23=$val15 and $val22=$val13)
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(z=$val22+$val23 *i)

!exit

:stat
vsavelist=12,13,14,15,16,17,19,20,21,22,23
embedcnt=0
