!set title=Quadratique racine double II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=a
val7=b
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint(-2*($val8))]
val11=$[rint(-2*($val9))]

!ifval $val11>0
val12=$val11
!else
val12=$val11
!endif
val13=$[rint(($val8)^2-($val9)^2)]

!ifval $val13>=0
val14=+$val13
!else
val14=$val13
!endif
val15=$[rint(2*($val8)*($val9))]

!ifval $val15>=0
val16=+$val15
!else
val16=$val15
!endif
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val11,$val10

val18=$(tmp0)
tmp0=!item $val17 of $val10,$val6

val10=$(tmp0)
tmp0=!item $val17 of $val6,$val11

val12=$(tmp0)

!ifval $val9>=0
val19=+$val9
!else
val19=$val9
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val20=$(tmp0)
val21=et
val22=Pour quelles valeurs réelles de,le polynôme,a-t-il une racine double (complexe)&nbsp;
val23=La racine double
replyname1=\($val6)
replygood1=$val18
replyname2=\($val7)
replygood2=$val13
replyname3=$val23
replygood3=$val8$val19*i
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val22[1]) 
!insmath $val6
$() $val21 
!insmath $val7
$()	$(val22[2])	<div class="wimscenter">	
!insmath X^2 +($val10+$val12*i)X+$val7+$val15*i
$()	</div>	$(val22[3])?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,12,15,21,22
embedcnt=0
