!set title=Argument donné
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 100

val6=$[$(tmp0)/10]
tmp0=!randint 1, 100

tmp1=!randitem -1,1

val7=$[$(tmp0)/10*$(tmp1)]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=$[$val7]
!else
val9=$[$val7*pi]
!endif

!ifval $val8=1
val10=$val7
!else
val10=$val7*pi
!endif
val11=$[cos($val10)*$val6]
val12=$[sin($val10)*$val6]
!readproc slib/oef/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Calculer la partie réelle et la partie imaginaire du nombre	complexe \(z) ayant,comme module et,comme argument
replytype1=numeric
replyname1=\(Re(z))
replygood1=$[$val11]
replytype2=numeric
replyname2=\(Im(z))
replygood2=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[1]) 
!insmath $val6
$() $(val14[2]) 
!insmath $val10
$() $(val14[3]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10,14
embedcnt=0
