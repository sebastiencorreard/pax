!set title=Puissance conjuguée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 30

val6=$[rint($(tmp0))]
val7=$[rint($val6+1)]
val8=$[rint($val7+1)]
!readproc slib/oef/env lang 
tmp0=$slib_out
val9=$(tmp0)
val10=Combien y a-t-il de nombres complexes \(z) tels que,égale le conjugué de \(z)&nbsp;
val11=Le nombre
val12=Soit \(w) le conjugué de \(z). On constate d'abord que,	implique \(|z|=1) ou 0. Quand \(|z|=1) on a,	donc les nombres complexes \(z) qui vérifient la condition du problème sont exactement les racines du polynôme
val13=ou
replyname1=$val11
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath z^$val6
$()	$(val10[2])?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$(val12[1])	
!insmath z^$val6=w
$() $(val12[2]) 
!insmath w=1/z
$(),	$(val12[3])	
!insmath X^{$val7} - 1
$() $val13 0.
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,12,13
embedcnt=0
