!set title=Argument de somme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -20, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val8=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]

!ifval $val7+($val9)=0
val9=$[rint($val7)]
!endif
val10=$[rint($val6+($val8))]
val11=$[rint($val7+($val9))]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
t_=!rawmath $val8+$val9*i
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
val14=$[sqrt(($val10)^2+($val11)^2)]

!ifval $val11>0
val15=$[pi/2]
!else
val15=$[-pi/2]
!endif

!ifval $val10=0
val16=$[$val15]
!else
val16=$[arctan($val11/($val10))]
!endif

!ifval $val10<0
val17=$[$val16+pi]
!else
val17=$[$val16]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val18=$(tmp0)
val19=Soient,Donner le module et un argument de
val20=est un argument de
replyname1=\(|z|)
replygood1=$val14
replyname2=\(Arg(z))
replygood2=?analyze 21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val19[1]) 
!insmath z_1=$val12
$(), 
!insmath z_2=$val13
$().	$(val19[2]) 
!insmath z=z_1+z_2
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs(($val21-$val17)/(2*pi)-round(($val21-$val17)/(2*pi)))<0.0001
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val21 $val20 \(z)

!exit

:stat
vsavelist=12,13,17,19,20,21
embedcnt=0
