!set title=Somme de j
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0))]
tmp0=!randint 100, 200

val7=$[rint($(tmp0))]
val8=$[rint($val6+1)]
val9=$[rint($val6+2)]
val10=$[rint($val6%3+1)]
val11=$[rint(($val7+1-$val6)%3)]

!ifval $val11=0
val12=$[0]
!endif

!ifval $val11=0
val13=$[0]
!endif

!ifval $val11=1
tmp0=!item $val10 of 1,     -0.5,      -0.5

val12=$[$(tmp0)]
!endif

!ifval $val11=1
tmp0=!item $val10 of 0,sqrt(3)/2,-sqrt(3)/2

val13=$[$(tmp0)]
!endif

!ifval $val11=2
tmp0=!item $val10 of       0.5,-1,       0.5

val12=$[$(tmp0)]
!endif

!ifval $val11=2
tmp0=!item $val10 of sqrt(3)/2, 0,-sqrt(3)/2

val13=$[$(tmp0)]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val14=$(tmp0)
val15=Soit,Calculez la somme
replyname1=\(Re(S))
replygood1=$val12
replyname2=\(Im(S))
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val15[1]) 
!insmath j=\cos{2\pi\over 3}+i\sin{2\pi\over 3}
$().	$(val15[2])	<div class="wimscenter"> 
!insmath S=j^{$val6}+j^{$val8}+j^{$val9}+...+j^{$val7}\quad.
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,15
embedcnt=0
