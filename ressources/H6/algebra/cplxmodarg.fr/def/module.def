!set title=Module d'un nombre complexe
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 10

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val8=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in sqrt(($val6)^2+($val7)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
replytype1=algexp
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div>Calculer le module du nombre complexe 
!insmath z=$val8
$().</div><br>		<div>
!insmath |z|
$()= 
!read oef/embed.phtml reply1,10 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
