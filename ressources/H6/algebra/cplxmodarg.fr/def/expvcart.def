!set title=Forme exponentielle -> forme cartésienne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David Doyen
email=david.doyen@u-pem.fr
language=fr

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!if $val2= 
tmp=!nonempty items 1,2,3,4

tmp0=!randitem $tmp
val6=$(tmp0)
!else
tmp=!nonempty items $val2,$val2

tmp0=!randitem $tmp
val6=$(tmp0)
!endif
!if $val6=1 
tmp=!nonempty items 0,1/2,1,3/2

tmp0=!randitem $tmp
val7=$(tmp0)
!endif
!if $val6=2 
tmp=!nonempty items 1/4,3/4,5/4,7/4

tmp0=!randitem $tmp
val7=$(tmp0)
!endif
!if $val6=3 
tmp=!nonempty items 1/3,2/3,4/3,5/3

tmp0=!randitem $tmp
val7=$(tmp0)
!endif
!if $val6=4 
tmp=!nonempty items 1/6,5/6,7/6,11/6

tmp0=!randitem $tmp
val7=$(tmp0)
!endif
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp=!translate ";': to $     $ in $(tmp0)*$val7*pi

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val7=$(tmp1)
tmp=!translate ";': to $     $ in $val7*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val8=$(tmp0)
tmp0=!randint 1, 4

val9=$(tmp0)
tmp=!translate ";': to $     $ in $val9*cos($val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
tmp=!translate ";': to $     $ in $val9*sin($val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
replytype1=algexp
replyname1=
replygood1=$val10
replytype2=algexp
replyname2=
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div>Ecrire le nombre complexe 
!insmath $val9*e^($val8)
$() sous la forme 
!insmath a+b i
$(), où 
!insmath a
$() et 
!insmath b
$() sont des nombres réels.</div><br>		<div>
!insmath $val9*e^($val8)
$()
!insmath  = 
$() 
!read oef/embed.phtml reply1,6 
$()
!insmath {+}
$() 
!read oef/embed.phtml reply2,6 
$() 
!insmath {i}
$()</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=2
