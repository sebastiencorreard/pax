\title{Forme exponentielle -> forme cartésienne}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\if{\confparm1=}{
\text{typarg=randitem(1,2,3,4)}
}{
\text{typarg=randitem(\confparm1,\confparm1)}
}

\if{\typarg=1}{
\text{c=randitem(0,1/2,1,3/2)}
}
\if{\typarg=2}{
\text{c=randitem(1/4,3/4,5/4,7/4)}
}
\if{\typarg=3}{
\text{c=randitem(1/3,2/3,4/3,5/3)}
}
\if{\typarg=4}{
\text{c=randitem(1/6,5/6,7/6,11/6)}
}
\text{c=simplify(randitem(-1,1)*\c*pi)}
\text{ic=simplify(\c*i)}
\text{m=randint(1..4)}
\text{a=simplify(\m*cos(\c))}
\text{b=simplify(\m*sin(\c))}

\statement{<div>Ecrire le nombre complexe \(\m*e^(\ic)\) sous la forme \(a+b i\), où \(a\) et \(b\) sont des nombres réels.</div><br>

<div>\(\m*e^(\ic)\)\( = \)\embed{reply1,6}\({+}\)\embed{reply2,6} \({i}\)</div></div>}

\answer{}{\a}{type=algexp}
\answer{}{\b}{type=algexp}
