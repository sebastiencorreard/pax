\title{Interprétation géométrique du module et de l'argument}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\if{\confparm1=}{
\text{typarg=randitem(1,2,3,4)}
}{
\text{typarg=randitem(\confparm1,\confparm1)}
}

\if{\typarg=1}{
\text{c=randitem(0,1/2,1,3/2)}
}
\if{\typarg=2}{
\text{c=randitem(1/4,3/4,5/4,7/4)}
}
\if{\typarg=3}{
\text{c=randitem(1/3,2/3,4/3,5/3)}
}
\if{\typarg=4}{
\text{c=randitem(1/6,5/6,7/6,11/6)}
}
\text{c=simplify(randitem(-1,1)*\c*pi)}
\text{m=randint(1..3)}

\real{pointx=(\m)*cos(\c)}
\real{pointy=(\m)*sin(\c)}

\real{s=3.1}
\text{dessin=trange 0,2*pi
plot blue,cos(t),sin(t)
plot blue,2*cos(t),2*sin(t)
plot blue,3*cos(t),3*sin(t)}
%Dessin en pointillé du quadrillage
\text{dessin1=}
\for{i=-6 to  6}{
\text{dessin1=\dessin1
dline -3,\i/2, 3,\i/2,blue}}
\for{i=-6 to  6}{
\text{dessin1=\dessin1
dline \i/2,-3, \i/2,3,blue}}
\text{dessin1=\dessin1
text black,1.1,0.3,giant,1
text black,0.1,1.3,giant,i}
%Axes
\real{taille=400}
\text{Axes=
hline 0,0,black
arrow  0,0,1,0,10,black
arrow 0,0,0,1,10,black
vline 0,0,black
}

\text{AA=
draw(\taille,\taille
xrange -\s,\s
yrange -\s,\s
\Axes
\dessin
\dessin1)}

Passage en pixels
\real{Px=(\taille*\pointx/\s+\taille)/2}
\real{Py=(-\taille*\pointy/\s+\taille)/2}

\statement{Soit \(z\) le nombre complexe de module \(\m\) et d'argument \(\c\). Cliquer sur le point d'affixe \(z\).
<div class=wimscenter>\embed{reply1}</div>
}
\answer{}{\AA;point,\Px,\Py}{type=coord}

\feedback{\result1=-1}{Voici la réponse
<center> \draw{\taille,\taille}{
xrange -\s,\s
yrange -\s,\s
hline 0,0,black
arrow  0,0,1,0,10,black
arrow 0,0,0,1,10,black
vline 0,0,black
disk \pointx,\pointy,10,blue
\Axes
\dessin
\dessin1}
</center>}
