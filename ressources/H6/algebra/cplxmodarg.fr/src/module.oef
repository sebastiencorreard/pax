\title{Module d'un nombre complexe}
\language{fr}

\integer{a=randint(2..10)*randitem(-1,1)}
\integer{b=randint(2..10)*randitem(-1,1)}
\complex{z=\a+\b*i}
\text{mod=simplify(sqrt((\a)^2+(\b)^2))}

\statement{<div>Calculer le module du nombre complexe \(z=\z\).</div><br>

<div>\(|z|\)=\embed{reply1,10}</div>}

\answer{}{\mod}{type=algexp}
