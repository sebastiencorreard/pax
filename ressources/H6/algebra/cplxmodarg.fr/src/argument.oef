\title{Argument d'un nombre complexe}
\language{fr}
\author{David Doyen}
\email{david.doyen@u-pem.fr}

\if{\confparm1=}{
\text{typarg=randitem(1,2,3,4)}
}{
\text{typarg=randitem(\confparm1,\confparm1)}
}

\if{\typarg=1}{
\text{c=randitem(2,3,6,9,1,2,3,6,9,sqrt(2),sqrt(3),2*sqrt(2),2*sqrt(3),3*sqrt(2),3*sqrt(3),sqrt(2)/2,sqrt(3)/2,1/sqrt(2),1/sqrt(3),1/(2*sqrt(2)),1/(2*sqrt(3)))}
\text{z=randitem(\c*i,\c)}
\text{z=randitem(1,-1)*\z}
}

\if{\typarg=2}{
\text{c=randitem(2,3,6,9,1,2,3,6,9,sqrt(2),sqrt(3),2*sqrt(2),2*sqrt(3),3*sqrt(2),3*sqrt(3),sqrt(2)/2,sqrt(3)/2,1/sqrt(2),1/sqrt(3),1/(2*sqrt(2)),1/(2*sqrt(3)))}
\text{a=randitem(1,-1)*\c}
\text{b=randitem(1,-1)*\c}
\text{z=randitem(\a+\b*i,\b*i+\a)}
}

\if{\typarg>=3}{
\text{cas2=randint(1..3)}
\if{\cas2=1}{
\text{c=randitem(1/2,1/3,2,3,6,9)}
\if{\typarg=3}{\text{l=1,sqrt(3)}}{\text{l=sqrt(3),1}}
\text{a=randitem(1,-1)*\l[1]*\c}
\text{b=randitem(1,-1)*\l[2]*\c}
}
\if{\cas2=2}{
\text{c=randitem(1/2,1/3,2,3,6,9)}
\if{\typarg=3}{\text{l=1/sqrt(3),1}}{\text{l=1,1/sqrt(3)}}
\text{a=randitem(1,-1)*\l[1]*\c}
\text{b=randitem(1,-1)*\l[2]*\c}
}
\if{\cas2=3}{
\text{c=randitem(1/2,1/3,1,2,3)}
\if{\typarg=3}{\text{l=\c*sqrt(3),simplify(\c*3)}}{\text{l=simplify(\c*3),\c*sqrt(3)}}
\text{a=randitem(1,-1)*\l[1]}
\text{b=randitem(1,-1)*\l[2]}
}
\text{z=randitem(\a+\b*i,\b*i+\a)}
}

\text{theta=pari(round(arg(\z)/pi*12)/12)}
\text{theta=simplify(\theta*pi)}

\statement{<div> Déterminer un argument du nombre complexe \(z=\z).</div><br>
<div> Un argument de \(z\) est \embed{reply1,10}.</div>
}

\answer{}{\t}{type=function}{option=noanalyzeprint}
\real{ok=abs((\theta-\t)/(2*pi)-round((\theta-\t)/(2*pi)))}
\condition{Bonne réponse}{(\ok<0.0001)}
\feedback{(\ok>=0.0001)}{Un argument de \(z\) est \(\theta\)}
