!set title=Quadrilatères sur droites
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Quadrilaterals on lines
title_nl=Vierhoeken en lijnen

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Nous avons 2 droites parallèles dans le plan. Sur la première	  droite il y a XXXX points, et sur la deuxième, YYYY points.
val9=Combien de quadrilatères peut-on former avec ces, points&nbsp;?
val7=Nombre de quadrilatères
!if $val6=en 
val7=Number of ways
val8=We have 2 parallel lines in the plane. On the first line we	have XXXX points, and on the second, YYYY points.
val9=How many quadrilaterals can be formed by these, points
val7=Number of quadrilaterals
!endif
!if $val6=nl 
val7=Aantal manieren
val8=We nemen twee parallele lijnen in het platte vlak. Op de eerste lijn	  zijn XXXX punten, en op de tweede lijn zijn er YYYY punten.
val9=Hoeveel vierhoeken kunnen worden gevormd door deze, punten
val7=Aantal vierhoekens
!endif
tmp0=!randint 4, 15

val10=$[rint($(tmp0))]
tmp0=!randint 4, 15

val11=$[rint($(tmp0))]
val12=$[rint($val10+$val11)]
val13=$[rint($val10*($val10-1)*$val11*($val11-1)/4)]
tmp0=!replace internal XXXX by $val10 in $val8

val14=$(tmp0)
tmp0=!replace internal YYYY by $val11 in $val14

val14=$(tmp0)
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14	<p>$(val9[1]) $val12 $(val9[2])?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12,14
embedcnt=0
