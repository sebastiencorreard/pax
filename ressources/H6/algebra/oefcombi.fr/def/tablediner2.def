!set title=Table de dîner 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Dinner table 2
title_nl=Etentje 2

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=couples dînent ensemble. Combien de façons différentes y a-t-il pour ces,	  personnes de s'asseoir autour de la table de manière que
val9=chaque monsieur soit assis à côté de deux dames
val10=et que tous les maris et femmes soient assis ensemble
!if $val6=en 
val7=Number of ways
val8=couples take dinner together. How many ways there are for these,	  people to sit around the table such that
val9=each gentleman is between two ladies
val10=and each husband is at the side of his wife
!endif
!if $val6=nl 
val7=Aantal manieren
val8=<em>hetero</em> paren hebben een etentje. Op hoeveel manieren kunnen deze,	  personen aan één tafel zitten
val9=onder de voorwaarde dat elke heer tussen twee dames moet zitte
val10=en elke man naast zijn vrouw moet zitten
!endif
tmp0=!randint 3, 8

val11=$[rint($(tmp0))]
val12=$[rint(4*factorial($val11))]
val13=$[rint(2*$val11)]
replyname1=$val7
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 $(val8[1])	$val13 $(val8[2])	<p>$val9		?	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,11,13
embedcnt=0
