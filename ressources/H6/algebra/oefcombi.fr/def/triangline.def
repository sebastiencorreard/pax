!set title=Triangles sur droites
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Triangles on lines
title_nl=Driehoeken en lijnen II

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Nous avons deux droites parallèles dans le plan. Sur la première	  droite il y a LLLL points, et sur la deuxième, MMMM points.
val9=Combien de triangles peut-on former avec ces TTTT points&nbsp;
val7=Nombre de triangles
!if $val6=en 
val7=Number of ways
val8=We have 2 parallel lines in the plane. On the first line we	have LLLL points, and on the second, MMMM points.
val9=How many triangles can be formed by these TTTT points
val7=Number of triangles
!endif
!if $val6=nl 
val7=Aantal manieren
val8=We hebben twee parallele lijnen in het platte vlak.	  Op de eerste lijn liggen LLLL punten. Op de tweede lijn liggen, MMMM punten.
val9=Hoeveel driehoeken kunnen door deze TTTT punten worden gevormd
val7=Aantal driehoeken
!endif
tmp0=!randint 4, 15

val10=$[rint($(tmp0))]
tmp0=!randint 4, 15

val11=$[rint($(tmp0))]
val12=$[rint($val10+$val11)]
val13=$[rint($val10*$val11*($val10+$val11-2)/2)]
tmp0=!replace internal LLLL by $val10 in $val8

val14=$(tmp0)
tmp0=!replace internal MMMM by $val11 in $val14

val14=$(tmp0)
tmp0=!replace internal TTTT by $val12 in $val9

val15=$(tmp0)
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14	<p>$val15?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

