!set title=Groupes d'élèves
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Groups of pupils
title_nl=Groepen leerlingen

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=De combien de façons distinctes peut-on diviser	  une classe de, élèves en, groupes de , élèves chacun&nbsp;
!if $val6=en 
val7=Number of ways
val8=In how many ways can one divide a class of,	  pupils into, groups of , pupils each
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Op hoeveel manieren kunnen we een klas van ,	  leerlingen opsplitsen in, groepjes van elk , leerlingen
!endif
tmp0=!randint 1, 14

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 2,4,3,2,5,2,6,3,4,2,7,3,5,8

val10=$[rint($(tmp0))]
tmp0=!item $val9 of 4,2,3,5,2,6,2,4,3,7,2,5,3,2

val11=$[rint($(tmp0))]
val12=$[rint($val10*$val11)]
val13=$[rint(factorial($val12)/(factorial($val11)*factorial($val10)^$val11))]
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val12 $(val8[2]) $val11	  $(val8[3]) $val10 $(val8[4])?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,12
embedcnt=0
