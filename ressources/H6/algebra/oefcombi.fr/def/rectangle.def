!set title=Rectangles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Rectangles
title_nl=Rechthoeken

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Soient XXXX droites dans le plan, dont YYYY horizontales et	  ZZZZ verticales.
val9=Combien de rectangles peut-on former avec ces,droites&nbsp;
!if $val6=en 
val7=Number of ways
val8=We have XXXX lines in the plane, of which YYYY are horizontal,	  and ZZZZ are vertical.
val9=How many rectangles are formed by these,lines
!endif
!if $val6=nl 
val7=Aantal manieren
val8=We hebben XXXX lijnen in het platte vlak, waarvan YYYY horizontaal,	  en ZZZZ vertikaal zijn.
val9=Hoeveel rechthoeken worden gevormd door deze,lijne
!endif
tmp0=!randint 3, 8

val10=$[rint($(tmp0))]
tmp0=!randint 3, 8

val11=$[rint($(tmp0))]
val12=$[rint($val10+$val11)]
val13=$[rint(($val10*$val11*($val10-1)*($val11-1))/4)]
tmp0=!replace internal XXXX by $val12 in $val8

val14=$(tmp0)
tmp0=!replace internal YYYY by $val10 in $val14

val14=$(tmp0)
tmp0=!replace internal ZZZZ by $val11 in $val14

val14=$(tmp0)
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14	  <p>$(val9[1]) $val12 $(val9[2])?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12,14
embedcnt=0
