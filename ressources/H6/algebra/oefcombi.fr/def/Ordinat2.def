!set title=Salle informatique 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Computer room 2
title_nl=Computer lokaal 2

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Une école a une salle informatique avec XXXX ordinateurs numérotés.	  Un groupe de YYYY élèves suit un cours dans cette salle.
val9=Combien de façons différentes y a-t-il	  pour répartir les élèves sur les ordinateurs pour que chaque ordinateur reçoive ZZZZ	  élèves&nbsp;
!if $val6=en 
val7=Number of ways
val8=A school has a computer room with XXXX PC's.	  A group of YYYY pupils take a lesson in this computer room.
val9=How many different ways there are to distribute the pupils over the PC's,	  such that each PC receives ZZZZ pupils
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Een school heeft een computer lokaal met XXXX PC's.	  Een klas van YYYY leerlingen heeft les in dit lokaal.
val9=Op hoeveel verschillende manieren kunnen we deze leerlingen verdelen over de	  aanwezige PC's, zo dat achter elke PC ZZZZ leerlingen zitten
!endif
tmp0=!randint 2, 3

val10=$[rint($(tmp0))]
tmp0=!randint 3, 12/$val10

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val10)]
val13=$[rint(factorial($val12))]
tmp0=!item $val10 of 1,2,6

val14=$[rint($(tmp0))]
val15=$[rint($val14^$val11)]
val16=$[rint($val13/$val15)]
tmp0=!replace internal XXXX by $val11 in $val8

val17=$(tmp0)
tmp0=!replace internal YYYY by $val12 in $val17

val17=$(tmp0)
tmp0=!replace internal ZZZZ by $val10 in $val9

val18=$(tmp0)
replyname1=$val7
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val17 <p>$val18?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=17,18
embedcnt=0
