!set title=Points d'intersection 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Intersection points 2
title_nl=Snijpunten 2

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Dans le plan, deux droites ont au plus un point d'intersection.
val9=Combien de points d'intersection y a-t-il au plus entre,droites
val7=Nombre de points
val10=dont,sont,(donc parallèles entre elles)&nbsp;
val11=horizontales,verticales
!if $val6=en 
val7=Number of ways
val8=In the plane, two lines has at most one intersection point.
val9=How many intersection points there are at most among,lines
val7=Number of points
val10=of which,are ,(therefore parallel)
val11=horizontal,vertical
!endif
!if $val6=nl 
val7=Aantal manieren
val8=In het platte vlak hebben twee rechte lijnen maximaal één snijpunt.
val9=Hoeveel snijpunten zijn er maximaal tussen,rechte lijnen
val7=Maximaal aantal snijpunten
val10=waarvan er,,  zijn en dus parallel
val11=horizontaal,vertikaal
!endif
tmp0=!randint 15, 40

val12=$[rint($(tmp0))]
tmp0=!randint 3, 8

val13=$[rint($(tmp0))]
val14=$[rint(binomial($val12,2)-binomial($val13,2))]
tmp=!nonempty items $val11

tmp0=!randitem $tmp
val15=$(tmp0)
replyname1=$val7
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8<p>	$(val9[1]) $val12 $(val9[2])		$(val10[1]) $val13 $(val10[2]) $val15	$(val10[3])?		</p>
$()
!exit

