!set title=Triangles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Triangles
title_nl=Driehoeken en lijnen I

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Nous avons LLLL droites dans le plan, dont XXXX passent par	  l'origine du plan. Il n'y a aucun autre point placé sur plus de deux	  droites, ni aucune droite parallèle à une autre.
val9=Combien de triangles peut-on former avec ces,droites&nbsp;
val7=Nombre de triangles
!if $val6=en 
val7=Number of ways
val8=We haves LLLL lines in the plane, of which XXXX contains the	  origin of the plane. There is no other point contained in more than two lines,	  nor any line parallel to another.
val9=How many triangles are formed by these,lines
val7=Number of triangles
!endif
!if $val6=nl 
val7=Aantal manieren
val8=We hebben LLLL lijnen in het platte vlak.<br>	  Van deze LLLL lijnen lopen er XXXX door de Oorsprong (0:0).	  Er is geen punt waardoor meer dan twee lijnen lopen.	  Verder zijn er geen lijnen parallel aan elkaar.
val9=Hoeveel driehoeken worden door deze,lijnen gevormd
val7=Aantal driehoeken
!endif
tmp0=!randint 7, 15

val10=$[rint($(tmp0))]
tmp0=!randint 3, $val10-3

val11=$[rint($(tmp0))]
tmp0=!randint 3, 8

val12=$[rint($(tmp0))]
val13=$[rint(\hori+$val12)]
val14=$[rint($val10*($val10-1)*($val10-2)/6-$val11*($val11-1)*($val11-2)/6)]
tmp0=!replace internal XXXX by $val11 in $val8

val15=$(tmp0)
tmp0=!replace internal LLLL by $val10 in $val15

val15=$(tmp0)
replyname1=$val7
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val15	<p>$(val9[1]) $val10 $(val9[2])?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
