!set title=Salle informatique 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Computer room 1
title_nl=Computer lokaal 1

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Une école a une salle informatique avec XXXX ordinateurs numérotés.	  Un groupe de YYYY élèves suit un cours dans cette salle.
val9=Combien de façons différentes y a-t-il d'attribuer chaque élève	  à un ordinateur (distinct)&nbsp;
!if $val6=en 
val7=Number of ways
val8=A school has a computer room with XXXX PC's.	  A group of YYYY pupils take a lesson in this computer room.
val9=How many different ways there are to attribute each pupil to	  a (distinct) PC
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Een school heeft een computer lokaal met XXXX PC's.	  Een klas van YYYY leerlingen heeft les in dit lokaal.
val9=Op hoeveel verschillende manieren kan elke leerling een	  computer toegewezen krijgen
!endif
tmp0=!randint 8, 12

val10=$[rint($(tmp0))]
tmp0=!randint ceil($val10/2), $val10-3

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in binomial($val10,$val11)*	  truncate(factorial($val11))
tmp0=!exec pari $t_

val12=$(tmp0)
tmp0=!replace internal XXXX by $val10 in $val8

val13=$(tmp0)
tmp0=!replace internal YYYY by $val11 in $val13

val13=$(tmp0)
tmp0=!replace internal ZZZZ by \group in $val9

val14=$(tmp0)
replyname1=$val7
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val13 <p>$val14?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14
embedcnt=0
