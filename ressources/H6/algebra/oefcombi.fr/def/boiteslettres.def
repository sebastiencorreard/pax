!set title=Boîtes à lettres
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Letterboxes
title_nl=Letters op een leesplank

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Combien de façons différentes y a-t-il de mettre,	  lettres dans ,boîtes à lettres&nbsp;
!if $val6=en 
val7=Number of ways
val8=How many different ways there are to put,	  letters into ,letterboxes
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Op hoeveel verschillende manieren kun je,	  letters op ,leesplankjes leggen
!endif
tmp0=!randint 3, 7

val9=$[rint($(tmp0))]
tmp0=!randint 3, 8

val10=$[rint($(tmp0))]
val11=$[rint($val10^$val9)]
replyname1=$val7
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val9 $(val8[2]) $val10 $(val8[3])?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10
embedcnt=0
