!set title=Hélicoptère
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Helico
title_nl=Helicopters

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=On a,hélicoptères de tourisme, pilotes et, hôtesses de l'air.
val9=Combien de façons différentes y a-t-il d'attribuer	  les pilotes et hôtesses de l'air aux hélicoptères de manière que chaque	  hélicoptère ait un pilote et deux hôtesses de l'air&nbsp;
!if $val6=en 
val7=Number of ways
val8=We have,tourism helicopters, pilots and, hostesses.
val9=How many different ways there are to attribute the pilots	  and hostesses to the helicopters, such that each helicopter has one pilot	  and two hostesses
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Een vliegmaatschappij heeft,helicopters. Als personeel hebben ze,	  piloten en, stewardessen in dienst.
val9=Op hoeveel verschillende manieren kunnen ze de piloten en stewardessen	  verdelen over de helicopters, zo dat elke helicopter één	  piloot en twee stewardessen aan boord heeft
!endif
tmp0=!randint 2, 4

val10=$[rint($(tmp0))]
val11=$[rint(2*$val10)]
val12=$[rint(factorial($val10))]
tmp0=!item $val10 of 1,6,90,2520,113400

val13=$[rint($(tmp0))]
val14=$[rint($val12*$val13)]
replyname1=$val7
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val10 $(val8[2]), $val10 $(val8[3])	$val11 $(val8[4])	<p>$val9?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11
embedcnt=0
