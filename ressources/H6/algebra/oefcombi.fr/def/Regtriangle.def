!set title=Triangles dans polygone
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Triangles in polygon
title_nl=Driehoeken in een polygoon

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Soit \(P\) un polygône régulier de,côtés
val9=Combien de triangles distincts dont les trois sommets	  sont des sommets de \(P\) y a-t-il
val7=Nombre de triangles
!if $val6=en 
val7=Number of ways
val8=Let \(P\) be a regular polygon of,sides
val9=How many distinct triangles are there, whose 3 vertices are	  vertices of \(P\)
val7=Number of triangles
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Gegeven is de regelmatige veelhoek (polygoon) met,zijden
val9=Hoeveel verschillende driehoeken zijn er, waarvan de 3 hoeken ook hoekpunten zijn	  van polygoo \(P\)
val7=Het aantal verschillende driehoeken
!endif
tmp0=!randint 5, 17

val10=$[rint($(tmp0))]
val11=$[rint($val10*($val10-1)*($val10-2)/6)]
replyname1=$val7
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val10 $(val8[2]).	<p>$val9?</p>
$()
!exit

