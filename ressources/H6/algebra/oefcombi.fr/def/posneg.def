tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Soit \(S\) un ensemble contenant, entiers positifs et,	  entiers négatifs. Les valeurs absolues de ces, entiers sont des	  nombres premiers distincts.
val9=Quel est le nombre, de deux nombres différents dans \(S\)&nbsp;
val10=d'entiers négatifs qui sont des produits,	  d'entiers positifs qui sont des produits,	  de nombres rationnels négatifs qui sont des rapports,	  de nombres rationnels positifs qui sont des rapports
val7=Le nombre
!if $val6=en 
val7=Number of ways
val8=Let \(S\) be a set containing, positive integers and,	  negative integers. The absolute values of these, integers are	  distinct prime numbers.
val9=What is the number of, of two different numbers in \(S\)&nbsp;
val10=negative numbers which are products,	positive numbers which are products,	negative rational numbers which are quotients,	positive rational numbers which are quotients
val7=The number
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Laat \(S\) een set zijn van, positieve integers en,	  negatieve integers. De absolute waarde van deze, integers	  zijn priem getallen.
val9=Wat is het aantal, van twee verschillende getallen uit \(S\)
val10=negatieve getallen welke producten zijn,	positieve getallen welke producten zijn,	negatieve rationele getallen welke quoti&euml;nten zijn,	positieve rationele getallen welke quoti&euml;nten zijn
val7=Het aantal
!endif
tmp0=!randint 3, 8

val11=$[rint($(tmp0))]
tmp0=!randint 3, 8

val12=$[rint($(tmp0))]
val13=$[rint($val11+$val12)]
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val10

val15=$(tmp0)
val16=$val11*$val12,$val11*($val11-1)+$val12*($val12-1),	  2*$val11*$val12,2*($val11*($val11-1)+$val12*($val12-1))
tmp0=!item $val14 of $val16

val17=$[rint($(tmp0))]
replyname1=$val7
replygood1=$val17
