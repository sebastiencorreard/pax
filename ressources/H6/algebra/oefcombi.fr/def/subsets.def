val9=$[rint($(tmp0))]
tmp0=!randint 3, 6

val10=$[rint($(tmp0))]
val11=$[rint(binomial($val9,$val10))]
replyname1=|\(S\)|
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

