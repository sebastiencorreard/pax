!set title=Double langues
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Double languages
title_nl=Twee talen

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Parmi, élèves d'une classe, parlent anglais,	  parlent allemand. Tout élève parle soit anglais soit allemand.
val9=Maintenant il faut en choisir deux, dont l'un	  parle anglais et l'autre parle allemand. Combien de choix possibles y	  a-t-il&nbsp;
val7=Nombre de choix
!if $val6=en 
val7=Number of ways
val8=Among, pupils of a class, speak French,	  speak German. Each pupil speaks either French or German.
val9=Now we have to choose two among these, such that one	  speaks French, the other speaks German.  How many possible	  choices are there
val7=Number of choices
!endif
!if $val6=nl 
val7=Aantal manieren
val8=In een klas zitten, leerlingen, leerlingen spreken Frans,	  leerlingen spreken Duits. Elke leerling spreekt in elk geval 1 taal: of Frans of Duits
val9=We kiezen twee leerlingen uit deze groep van, zo dat er eentje	  Frans spreekt en de andere spreekt Duits.	 Hoeveel mogelijke combinaties zijn er
val7=Aantal keuzemogelijkheden
!endif
tmp0=!randint 10, 26

val10=$[rint($(tmp0))]
tmp0=!randint ceil($val10/2), $val10-2

val11=$[rint($(tmp0))]
tmp0=!randint ceil($val10/2), $val10-2

val12=$[rint($(tmp0))]
val13=$[rint($val11+$val12-$val10)]
val14=$[rint($val11-$val13)]
val15=$[rint($val12-$val13)]
val16=$[rint($val14*$val12+$val13*($val12-1)-$val13*($val13-1)/2)]
replyname1=$val7
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val10 $(val8[2]), $val11 $(val8[3]),	$val12 $(val8[4])	<p>$val9?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
