!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Combien y a-t-il d'entiers de la forme,	  où les exposants,	  sont des entiers non négatifs avec
val7=Nombre d'entiers
val9=Les bases XXXX étant premières entre elles,	  ces entiers sont différents pour tous choix différents de XXXX.	  Il suffit donc d'évaluer le nombre de possibilités d'écriture YYYY
!if $val6=en 
val7=Number of ways
val8=How many integers are there of the form,	  where the exponents,	  are non-negative integers with
val7=Number of integers
val9=The bases XXXX being coprime,	  these integers are different for any different choices of XXXX.	  Hence it suffices to evaluate the number of possibilities of writing
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Hoeveel integers zijn er in de vorm,	  met daarin de niet-negatieve exponenten,	  waarvoor geldt
val7=Het aantal integers
val9=De basis getallen XXXX zijn relatief priem,	  en deze integers zijn verschillend bij de keuzes van XXXX.	  Dus is het afdoende uit te rekenen
!endif
tmp0=!randint 1, 11

val10=$[rint($(tmp0))]
tmp0=!item $val10 of 2, 2,2, 2,3, 3,4, 4, 5,5, 5

val11=$[rint($(tmp0))]
tmp0=!item $val10 of 3, 3,5, 5,4, 5,5, 5, 6,7, 7

val12=$[rint($(tmp0))]
tmp0=!item $val10 of 5, 7,7, 7,5, 7,7, 9, 7,8, 9

val13=$[rint($(tmp0))]
tmp0=!item $val10 of 7,11,9,11,7,11,9,11,11,9,11

val14=$[rint($(tmp0))]
tmp0=!randint 2, 9

val15=$[rint($(tmp0))]
val16=$[rint(($val15+3)*($val15+2)*($val15+1)/6)]
tmp0=!replace internal XXXX by $val11, $val12, $val13, $val14 in $val9

val17=$(tmp0)
tmp0=!replace internal YYYY by \(a+b+c+d=$val15\) in $val17

val17=$(tmp0)
replyname1=$val7
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val17


!goto stat

!exit

