!set title=Points d'intersection 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Intersection points 1
title_nl=Snijpunten 1

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Dans le plan, deux droites ont au plus un point d'intersection.
val9=Combien de points d'intersection y a-t-il au plus entre,droites
val7=Nombre de points
!if $val6=en 
val7=Number of ways
val8=In the plane, two lines has at most one intersection point.
val9=How many intersection points there are at most among,lines
val7=Number of points
!endif
!if $val6=nl 
val7=Aantal manieren
val8=In het platte vlak hebben twee rechte lijnen maximaal één snijpunt.
val9=Hoeveel snijpunten zijn er maximaal tussen,rechte lijnen
val7=Maximaal aantal snijpunten
!endif
tmp0=!randint 15, 40

val10=$[rint($(tmp0))]
val11=$[rint(binomial($val10,2))]
replyname1=$val7
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8<p>	$(val9[1]) $val10 $(val9[2])		?		</p>
$()
!exit

