val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Un long couloir dans un hôtel est éclairé par, lampes alignées.
val9=Pour économiser de l'énergie, l'hôtel éteint, de ces lampes	  pendant la nuit.
val10=Pour avoir un minimum d'éclairage, on ne peut pas éteindre des lampes	  adjacentes, ni les lampes aux extrémités du couloir. Dans ce cas,	  combien de façons différentes y a-t-il d'éteindre
val11=lampes&nbsp;
!if $val6=en 
val7=Number of ways
val8=A hotel has a long corridor lit by, aligned lamps.
val9=In order to save energy, the hotel turns off, of these lamps	  during the night.
val10=To have a minimum of lighting, one cannot turn off adjacent lamps, nor	  lamps at the extremities of the corridor. In this case, how many different	  ways there are to turn off
val11=lamps
!endif
!if $val6=nl 
val7=Aantal manieren
val8=In een hotel is een lange gang verlicht door een rij van, lampen.
val9=In het kader van energie besparing worden,, lampen's nachts uitgeschakeld
val10=Voor een minimale verlichting , mogen er geen twee achter elkaar liggende lampen worden gedoofd.	Ook de lampen aan de uiteinden van de gang moeten blijven branden.	Op hoeveel verschillende manieren kan het hotel
val11=lampen
!endif
tmp0=!randint 10, 20

val12=$[rint($(tmp0))]
tmp0=!randint 2, 4

val13=$[rint($(tmp0))]
val14=$[rint(binomial($val12-$val13-1,$val13))]
replyname1=$val7
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

