val14=$[rint($(tmp0))]
tmp0=!item $val13 of 0,1,1,2,1,2,3,2

val15=$[rint($(tmp0))]
val16=$[rint($val14*$val10+$val15*$val11)]
tmp0=!item $val13 of  $val8

val17=$(tmp0)
tmp0=!randint 3, 7

val18=$[rint($(tmp0))]
val19=$[rint($val16+$val18)]
val20=$[rint(binomial($val18+$val12-1,$val18))]
