!set title=Table de dîner 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Dinner table 4
title_nl=Etentje 4

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=couples dînent ensemble. Combien de façons différentes y a-t-il pour ces,	  personnes de s'asseoir autour de la table de manière que
val9=chaque monsieur soit assis à côté de deux dames
val10=et qu'aucun mari soit assis à côté de sa femme
!if $val6=en 
val7=Number of ways
val8=couples take dinner together. How many ways there are for these,	  people to sit around the table such that
val9=each gentleman is between two ladies
val10=and that no husband is at the side of his wife
!endif
!if $val6=nl 
val7=Aantal manieren
val8=<em>hetero</em> paren hebben een etentje. Op hoeveel manieren kunnen deze,	  personen aan één tafel zitten
val9=onder de voorwaarde dat elke heer tussen twee dames moet zitte
val10=en dat geen enkele echtgenoot naast zijn eigen echtgenote zit
!endif
tmp0=!randitem 3,4

val11=$[rint($(tmp0))]
tmp0=!item $val11-2 of 1,2

val12=$[rint($(tmp0))]
val13=$[rint(2*factorial($val11)*$val12)]
val14=$[rint(2*$val11)]
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 $(val8[1])	$val14 $(val8[2])	<p>$val9		?	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,11,14
embedcnt=0
