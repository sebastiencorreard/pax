!set title=Coefficients de binôme 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Binomial coefficients 1
title_nl=Binomiale co&euml;fficienten 1

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Soit \(n\) un entier positif tel que
val9=Quelle est la valeur de
val7=Votre réponse
!if $val6=en 
val7=Number of ways
val9=Let \(n\) be a positive integer such that
val9=What is the value of 
val7=Your answer
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Laat \(n\) een positieve integer zijn zo dat
val9=Wat is dan de waarde van 
val7=Your answer
!endif
tmp0=!randint 10, 30

val10=$[rint($(tmp0))]
tmp0=!randint 2, floor($val10/3)

val11=$[rint($(tmp0))]
val12=$[rint($val10-$val11)]
val13=$val9 \(n\)&nbsp;
val14=$val9 \(C_n^$val11\)&nbsp;
tmp=!nonempty items 0,1

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]

!ifval $val15=0
val16=$val13
!else
val16=$val14
!endif

!ifval $val15=0
val17=$[rint($val10)]
!else
val17=$[rint(binomial($val10,$val11))]
!endif
replyname1=$val7
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8 
!insmath C_n^$val11=C_n^$val12
$(). $val16 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,11,12,16
embedcnt=0
