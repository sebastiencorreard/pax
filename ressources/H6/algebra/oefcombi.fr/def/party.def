!set title=Poignées de main
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Handshakes
title_nl=Handenschudden

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=XXXX couples et YYYY personnes non mariées	  se rencontrent pendant une soirée. Au début de la soirée, chaque	  participant se serre la main avec chaque autre participant une fois,	  sauf qu'il n'y a pas de poignée de main entre mari et femme.
val9=Combien de poignées de main ont eu lieu au total&nbsp;
val7=Poignées de main
!if $val6=en 
val7=Number of ways
val8=XXXX couples and YYYY non-maried people meet during a party.	  At the start of the party, each participant shake hands with each other	  participant once, except that there is no handshake between husband and	  wife.
val9=How many handshakes have occurred in total
val7=Handshakes
!endif
!if $val6=nl 
val7=Aantal manieren
val8=XXXX paren en YYYY niet-getrouwde personen ontmoeten elkaar op een feestje.	  Elke feestgangen schud één keer de hand van een andere feestganger,	  behalve de getrouwde paren, deze schudden natuurlijk geen handen met elkaar...
val9=Hoeveel "handcontacten" vonden er plaats
val7=Aantal "handcontacten"
!endif
tmp0=!randint 5, 10

val10=$[rint($(tmp0))]
tmp0=!randint 10, 20

val11=$[rint($(tmp0))]
val12=$[rint(2*$val10+$val11)]
val13=$[rint(($val12*($val12-1))/2-$val10)]
tmp0=!replace internal XXXX by $val10 in $val8

val14=$(tmp0)
tmp0=!replace internal YYYY by $val11 in $val14

val14=$(tmp0)
replyname1=$val7
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14 <p>$val9?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,14
embedcnt=0
