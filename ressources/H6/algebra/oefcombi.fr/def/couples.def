!set title=Couples
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000000
title_en=Couples
title_nl=Paren

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nombre de façons
val8=Combien de possibilités y a-t-il pour former,	  couples à partir de , hommes et , femmes&nbsp;
!if $val6=en 
val7=Number of ways
val8=How many possibilities are there to form,	  couples from , men and, women
val7=Number of possibilities
!endif
!if $val6=nl 
val7=Aantal manieren
val8=Op hoeveel manieren kunnen we een,	  heteroparen vormen uit ,mannen en and, vrouwen
!endif
tmp0=!randint 3, 5

val9=$[rint($(tmp0))]
tmp0=!randint $val9, 7

val10=$[rint($(tmp0))]
tmp0=!randint $val9, 7

val11=$[rint($(tmp0))]
val12=$[rint(factorial($val10)/factorial($val9)/factorial($val10-$val9)*factorial($val11)/factorial($val11-$val9))]
replyname1=$val7
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

