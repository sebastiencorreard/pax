\title{Quadrilatères sur droites}
\title_en{Quadrilaterals on lines}
\title_nl{Vierhoeken en lijnen}

\text{name_answer=Nombre de façons}

\text{name_enonce=Nous avons 2 droites parallèles dans le plan. Sur la première
  droite il y a XXXX points, et sur la deuxième, YYYY points.}
\text{name_question=Combien de quadrilatères peut-on former avec ces, points&nbsp;?}
\text{name_answer=Nombre de quadrilatères}

\if{\lang=en}{

\text{name_answer=Number of ways}

\text{name_enonce=We have 2 parallel lines in the plane. On the first line we
have XXXX points, and on the second, YYYY points.}
\text{name_question=How many quadrilaterals can be formed by these, points}
\text{name_answer=Number of quadrilaterals}

}
\if{\lang=nl}{

\text{name_answer=Aantal manieren}

\text{name_enonce=We nemen twee parallele lijnen in het platte vlak. Op de eerste lijn
  zijn XXXX punten, en op de tweede lijn zijn er YYYY punten.}
\text{name_question=Hoeveel vierhoeken kunnen worden gevormd door deze, punten}
