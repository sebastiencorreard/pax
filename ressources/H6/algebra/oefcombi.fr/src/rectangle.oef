\text{name_answer=Nombre de façons}
\text{name_enonce=Soient XXXX droites dans le plan, dont YYYY horizontales et
  ZZZZ verticales.}
\text{name_question=Combien de rectangles peut-on former avec ces,droites&nbsp;}
\if{\lang=en}{
