\text{lang=slib(oef/env lang)}

\title{Salle informatique 2}
\title_en{Computer room 2}
\title_nl{Computer lokaal 2}

\text{name_answer=Nombre de façons}

\text{name_enonce=Une école a une salle informatique avec XXXX ordinateurs numérotés.
  Un groupe de YYYY élèves suit un cours dans cette salle.}

\text{name_question=Combien de façons différentes y a-t-il
  pour répartir les élèves sur les ordinateurs pour que chaque ordinateur reçoive ZZZZ
  élèves&nbsp;}

\if{\lang=en}{

\text{name_answer=Number of ways}

\text{name_enonce=A school has a computer room with XXXX PC's.
  A group of YYYY pupils take a lesson in this computer room.}

\text{name_question=How many different ways there are to distribute the pupils over the PC's,
  such that each PC receives ZZZZ pupils}

}
\if{\lang=nl}{

\text{name_answer=Aantal manieren}

\text{name_enonce=Een school heeft een computer lokaal met XXXX PC's.
  Een klas van YYYY leerlingen heeft les in dit lokaal.}

\text{name_question=Op hoeveel verschillende manieren kunnen we deze leerlingen verdelen over de
  aanwezige PC's, zo dat achter elke PC ZZZZ leerlingen zitten}



}

\precision{1000000}

\integer{group=randint(2..3)}
\integer{computers=randint(3..12/\group)}
\integer{students=\computers*\group}
\integer{pro=factorial(\students)}
\integer{gro=item(\group,1,2,6)}
\integer{ddd=\gro^\computers}
\integer{distr=\pro/\ddd}

\text{enonce=wims(replace internal XXXX by \computers in \name_enonce)}
\text{enonce=wims(replace internal YYYY by \students in \enonce)}
\text{question=wims(replace internal ZZZZ by \group in \name_question)}
\statement{\enonce <p>\question?</p>}
\answer{\name_answer}{\distr}

