val6=$[rint(15)]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 3, $val6

val10=$[rint($(tmp0))]
val11=$[sqrt(($val7)^2+($val8)^2+($val9)^2)]
tmp0=!randint 1, floor($val10*$val11)-2

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
val13=$[sqrt($val10^2-($val12/$val11)^2)*$val11]
replyname1=长度
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 把 v 分解成两个向量 v<sub>1</sub> 与 v<sub>2</sub> 之和, 其中 v<sub>1</sub> 与 u 垂直, 而 v<sub>2</sub> 与 u 成比例.


!goto stat

!exit

:question
$()设 u=($val7,$val8,$val9) 是空间向量. 向量 v 的长度是$val10.  	已知内积 &lt;u,v&gt;&nbsp;=&nbsp;$val12, 问外积	u 
!insmath \times
$() v	的长是多少?
$()
!exit

:hint
$()把 v 分解成两个向量 v<sub>1</sub> 与 v<sub>2</sub> 之和, 其中 v<sub>1</sub> 与 u 垂直, 而 v<sub>2</sub> 与 u 成比例.
$()
