\title{3个整数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{a=random(-499..499)}
\integer{b=random(-499..499)}
\integer{c=random(-499..499)}
\integer{m1=\a+\b}
\integer{m2=\b+\c}
\integer{m3=\c+\a}
\integer{ra=2*\a}
\integer{rb=2*\b}
\integer{rc=2*\c}

\statement{有 3 个整数 <i>a,b,c</i> 满足:<ul>
<li><i>a</i> 和 <i>b</i> 的平均值是 \m1.
<li><i>b</i> 和 <i>c</i> 的平均值是 \m2.
<li><i>c</i> 和 <i>a</i> 的平均值是 \m3.
</ul>
这 3 个整数等于多少?}


\answer{<i>a</i>}{\ra}
\answer{<i>b</i>}{\rb}
\answer{<i>c</i>}{\rc}
