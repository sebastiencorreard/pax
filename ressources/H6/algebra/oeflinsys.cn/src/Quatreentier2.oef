\title{4个整数 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\text{a=<i>a</i>}
\text{b=<i>b</i>}
\text{c=<i>c</i>}
\text{d=<i>d</i>}
\integer{m1=random(-499..499)}
\integer{m2=random(-499..499)}
\integer{m3=random(-499..499)}
\integer{m4=\m1+(\m3)-(\m2)}

\statement{有 4 个整数 <i>a,b,c,d</i> 满足:<ul>
<li>\a 和 \b 的平均值是 \m1.
<li>\b 和 \c 的平均值是 \m2.
<li>\c 和 \d 的平均值是 \m3.
</ul>
问 \d 和 \a 的平均值是多少?}

\answer{(\d+\a)/2}{\m4}
\hint{<i>t</i> 取什么值时以下线性方程组有解?
<p><center><table border=0 cellspacing=2>
<tr><td>0.5\a+0.5\b<td>=&nbsp;\m1
<tr><td>0.5\b+0.5\c<td>=&nbsp;\m2
<tr><td>0.5\c+0.5\d<td>=&nbsp;\m3
<tr><td>0.5\d+0.5\a<td>=&nbsp;<i>t</i>
</table></center> <p>}
