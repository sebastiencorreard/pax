\title{6个整数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\text{a=<i>a</i>}
\text{b=<i>b</i>}
\text{c=<i>c</i>}
\text{d=<i>d</i>}
\integer{m1=random(-499..499)}
\integer{m2=random(-499..499)}
\integer{m3=random(-499..499)}
\integer{m4=\m1+(\m3)-(\m2)}

\text{a1=<i>a</i><sub>1</sub>}
\text{a2=<i>a</i><sub>2</sub>}
\text{a3=<i>a</i><sub>3</sub>}
\text{a4=<i>a</i><sub>4</sub>}
\text{a5=<i>a</i><sub>5</sub>}
\text{a6=<i>a</i><sub>6</sub>}
\integer{m1=random(-199..199)}
\integer{m2=random(-199..199)}
\integer{m3=random(-199..199)}
\integer{m4=random(-199..199)}
\integer{m5=random(-199..199)}
\integer{m6=\m1+(\m3)+(\m5)-(\m2)-(\m4)}

\statement{有 6 个整数 \a1,\a2,\a3,\a4,\a5,\a6 满足:<ul>
<li>\a1 和 \a2 的平均值是 \m1.
<li>\a2 和 \a3 的平均值是 \m2.
<li>\a3 和 \a4 的平均值是 \m3.
<li>\a4 和 \a5 的平均值是 \m4.
<li>\a5 和 \a6 的平均值是 \m5.
</ul>
问 \a1 和 \a6 的平均值是多少?}

\answer{(\a1+\a6)/2}{\m6}
