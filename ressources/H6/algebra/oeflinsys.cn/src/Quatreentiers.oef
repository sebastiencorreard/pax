\title{4个整数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{a=random(-333..333)}
\integer{b=random(-333..333)}
\integer{c=random(-333..333)}
\integer{d=random(-333..333)}
\integer{m1=\a+\b+\c}
\integer{m2=\b+\c+\d}
\integer{m3=\c+\d+\a}
\integer{m4=\d+\a+\b}
\integer{ra=\a*3}
\integer{rb=\b*3}
\integer{rc=\c*3}
\integer{rd=\d*3}

\statement{有 4 个整数 <i>a,b,c,d</i> 满足:<ul>
<li><i>a</i>, <i>b</i> 和 <i>c</i> 的平均值是 \m1.
<li><i>b</i>, <i>c</i> 和 <i>d</i> 的平均值是 \m2.
<li><i>c</i>, <i>d</i> 和 <i>a</i> 的平均值是 \m3.
<li><i>d</i>, <i>a</i> 和 <i>b</i> 的平均值是 \m4.
</ul>
这 4 个整数等于多少?}


\answer{<i>a</i>}{\ra}
\answer{<i>b</i>}{\rb}
\answer{<i>c</i>}{\rc}
\answer{<i>d</i>}{\rd}
