\title{等距}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\integer{m1=random(-10..2)}
\integer{m2=random(\m1+1..10)}
\integer{n1=random(-10..5)}
\integer{n2=random(\n1..10)}
\integer{k1=random(-10..2)}
\integer{l1=random(-5..10)}
\integer{k2=random(\k1+1..10)}
\integer{l2=random(-10..\l1-1)}
\real{a1=2*(\m1-(\m2))}
\real{b1=2*(\n1-(\n2))}
\real{c1=(\n1)^2-(\n2)^2+(\m1)^2-(\m2)^2}
\real{a2=2*(\k1-(\k2))}
\real{b2=2*(\l1-(\l2))}
\real{c2=(\k1)^2-(\k2)^2+(\l1)^2-(\l2)^2}
\real{det=(\a1)*(\b2)-(\a2)*(\b1)}
\real{x=((\c1)*(\b2)-(\c2)*(\b1))/(\det)}
\real{y=((\a1)*(\c2)-(\a2)*(\c1))/(\det)}

\statement{找出平面上点 p=(x,y) 的坐标使得:
<ol>
<li>p 和 q<sub>1</sub>=(\m1,\n1) 的距离等于
p 和 q<sub>2</sub>=(\m2,\n2) 的距离.
<p><li>p 和 r<sub>1</sub>=(\k1,\l1) 的距离等于
p 和 r<sub>2</sub>=(\k2,\l2) 的距离.
</ol>}

\hint{与两个点
q<sub>1</sub> 和 q<sub>2</sub> 等距的点的集合是一条直线.
首先利用 q<sub>1</sub> 和 q<sub>2</sub> 的坐标写出这条直线的方程.}

\answer{x}{\x}
\answer{y}{\y}
