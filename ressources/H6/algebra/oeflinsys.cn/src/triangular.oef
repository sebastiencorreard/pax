\title{三角形方程组}
\language{cn}
\range{5..50}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{x=x}
\text{n=<i>n</i>}
\integer{sign=random(1,2)}
\text{s1=\sign=1?:-}
\text{s2=\sing=1?-:+}
\integer{type=random(1..5)}
\text{r1  =item(\type,1,\n,    1,   \n - 1,0)}
\text{r2  =item(\type,1,\n - 1,2,   \n - 2,1)}
\text{r3  =item(\type,1,\n - 2,3,   \n - 3,2)}
\text{rn1 =item(\type,1,2,   \n - 1,1,     \n - 2)}
\text{rn  =item(\type,1,1,   \n,    0,     \n - 1)}
\text{abs=item(\type,0,1,-1,1,-1)}
\integer{ans=\sign=1?\abs:-(\abs)}

\statement{在以下含 \n 个方程和 \n 个未知量 (\n&gt;3) 的方程组里,
确定解 \x<sub>1</sub> 的值.
<p><center><table border=0 cellspacing=3>
<tr><td align=right>\x<sub>1</sub>+\x<sub>2</sub>+\x<sub>3</sub>+...+\x<sub>\n</sub><td>=&nbsp;\s1\r1
<tr><td align=right>\x<sub>2</sub>+\x<sub>3</sub>+...+\x<sub>\n</sub><td>=&nbsp;\s1\r2
<tr><td align=center colspan=2><b>. . .</b>
<tr><td align=right>\x<sub>\n-1</sub>+\x<sub>\n</sub><td>=&nbsp;\s1\rn1
<tr><td align=right>\x<sub>\n</sub><td>=&nbsp;\s1\rn
</table></center> <p>}

\answer{\x<sub>1</sub>}{\ans}
