\title{解的类型}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{yes=对}
\text{no=不对}
\integer{min=random(1,1,2,3,4,5)}
\integer{max=random(\min+1..\min+5)}
\integer{type=random(1,2,3)}
\integer{equs=item(\type,\min,\min,\max)}
\integer{vars=item(\type,\min,\max,\min)}
\integer{homo=random(0,1)}
\text{gene=\equs>1?齐次:齐次}
\text{Homo=\homo=1?\gene:非\gene}
\text{Equ=\equs>1?方程:方程}
\text{Var=\vars>1?变量:变量}
\text{gooda=\homo=0 and \equs>1?\yes:\no}
\text{goodb=\equs>=\vars?\yes:\no}
\text{goodc=\vars>1?\yes:\no}

\statement{有一个由 \equs 个\Homo线性\Equ和 \vars 个变量组成的线性方程组.
以下性质中哪些是正确的?<ul>
<li>A. 方程组无解.
<li>B. 方程组有唯一解.
<li>C. 方程组有无穷多解.
</ul>
}

\choice{A 正确}{\gooda}{\yes,\no}
\choice{B 正确}{\goodb}{\yes,\no}
\choice{C 正确}{\goodc}{\yes,\no}
