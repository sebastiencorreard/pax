\title{圆的方程}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{p=<i>p</i>}
\text{a=<i>a</i>}
\text{b=<i>b</i>}
\text{c=<i>c</i>}
\text{x=x}
\text{y=y}
\real{tolerance=0.0005}
\integer{x1=random(10..50)}
\integer{y1=random(10..30)}
\integer{x2=random(-50..-10)}
\integer{y2=random(10..30)}
\integer{x3=random(-20..20)}
\integer{y3=random(-50..-10)}

\statement{平面上的圆方程总可以写成以下形式
<p><center> 
\x<sup>2</sup>+\y<sup>2</sup>&nbsp;=&nbsp;\a\x+\b\y+\c,
</center> <p>
其中 \a,\b,\c 是实数. <p>
求出 \a,\b,\c 以得到过下列 3 点的圆 <i>C</i> 的方程
<p><center>
\p<sub>1</sub>=(\x1,\y1) ,
\p<sub>2</sub>=(\x2,\y2) ,
\p<sub>3</sub>=(\x3,\y3) .
</center> <p>
}

\answer{\a}{\aa}
\answer{\b}{\ab}
\answer{\c}{\ac}
\condition{<i>C</i> 通过 \p<sub>1</sub>}
{abs((\x1)^2+(\y1)^2-(\aa)*(\x1)-(\ab)*(\y1)-(\ac))<\tolerance}
\condition{<i>C</i> 通过 \p<sub>2</sub>}
{abs((\x2)^2+(\y2)^2-(\aa)*(\x2)-(\ab)*(\y2)-(\ac))<\tolerance}
\condition{<i>C</i> 通过 \p<sub>3</sub>}
{abs((\x3)^2+(\y3)^2-(\aa)*(\x3)-(\ab)*(\y3)-(\ac))<\tolerance}
