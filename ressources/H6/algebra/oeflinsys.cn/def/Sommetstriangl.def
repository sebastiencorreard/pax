!set title=三角形的顶点
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
