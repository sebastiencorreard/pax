val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -20, 20

val6=$[rint(2*$(tmp0))]
tmp0=!randint -20, 20

val7=$[rint(2*$(tmp0))]
tmp0=!randint -20, 20

val8=$[rint(2*$(tmp0))]
tmp0=!randint -20, 20

val9=$[rint(2*$(tmp0))]
tmp0=!randint -20, 20

val10=$[rint(2*$(tmp0))]
tmp0=!randint -20, 20

val11=$[rint(2*$(tmp0))]
val12=$[rint(($val6+$val8)/2)]
val13=$[rint(($val6+$val10)/2)]
val14=$[rint(($val8+$val10)/2)]
val15=$[rint(($val7+$val9)/2)]
val16=$[rint(($val7+$val11)/2)]
val17=$[rint(($val9+$val11)/2)]
replyname1=x<sub>1</sub>
replygood1=$val6
replyname2=y<sub>1</sub>
replygood2=$val7
replyname3=x<sub>2</sub>
replygood3=$val8
replyname4=y<sub>2</sub>
replygood4=$val9
replyname5=x<sub>3</sub>
replygood5=$val10
replyname6=y<sub>3</sub>
replygood6=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有一个平面三角形 ABC 满足:	<ul>	<li>边 AB 的中点是 ($val12,$val15).	<li>边 BC 的中点是 ($val14,$val17).	<li>边 AC 的中点是 ($val13,$val16).	</ul>	求三角形 3 个顶点 A, B, C 的坐标?	<p>这里假设	A=(x<sub>1</sub>,y<sub>1</sub>),	B=(x<sub>2</sub>,y<sub>2</sub>),	C=(x<sub>3</sub>,y<sub>3</sub>).
$()
!exit

