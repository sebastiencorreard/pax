!set title=解 2x2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
val7=y
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$[rint(abs(($val9)*($val10)/($val8)))]

!ifval $val11>11
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint $val11+2, $val11+6

tmp3=!randitem -1,1

val12=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
val15=$[($val8)*($val12)-($val10)*($val9)]
val16=$[(($val13)*($val12)-($val14)*($val9))/($val15)]
val17=$[(($val8)*($val14)-($val10)*($val13))/($val15)]

!ifval $val9>=0
val18=+$val9
!else
val18=$val9
!endif

!ifval $val12>=0
val19=+$val12
!else
val19=$val12
!endif
replyname1=x
replygood1=$val16
replyname2=y
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()求以下方程组的解.	<p><center><table border=0>	<tr><td align=right>$val8$val6<td align=right>$val18$val7<td>=&nbsp;$val13	<tr><td align=right>$val10$val6<td align=right>$val19$val7<td>=&nbsp;$val14	</table></center> <p>
$()
!exit

