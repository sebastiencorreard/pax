!set title=四边形
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>A</i>
val7=<i>B</i>
val8=<i>C</i>
val9=<i>D</i>
tmp0=!randint -199, 199

val10=$[rint($(tmp0))]
tmp0=!randint -199, 199

val11=$[rint($(tmp0))]
tmp0=!randint -199, 199

val12=$[rint($(tmp0))]
tmp0=!randint -199, 199

val13=$[rint($(tmp0))]
tmp0=!randint -199, 199

val14=$[rint($(tmp0))]
tmp0=!randint -199, 199

val15=$[rint($(tmp0))]
val16=$[rint($val10+($val12)-($val11))]
val17=$[rint($val13+($val15)-($val14))]
replyname1=x
replygood1=$val16
replyname2=y
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有一个平面四边形, 其顶点	$val6,$val7,$val8,$val9, 满足:<ul>	<li>边 $val6$val7 的中点是 ($val10 , $val13).	<li>边 $val7$val8 的中点是 ($val11 , $val14).	<li>边 $val8$val9 的中点是 ($val12 , $val15).	</ul>	问边 $val9$val6 的中点 (x,y) 是什么?
$()
!exit

