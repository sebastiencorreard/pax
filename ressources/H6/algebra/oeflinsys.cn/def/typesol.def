!set title=解的类型
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=c,c,c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=3
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=对
val7=不对
tmp0=!randitem 1,1,2,3,4,5

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, $val8+5

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val8,$val8,$val9

val11=$[rint($(tmp0))]
tmp0=!item $val10 of $val8,$val9,$val8

val12=$[rint($(tmp0))]
tmp0=!randitem 0,1

val13=$[rint($(tmp0))]

!ifval $val11>1
val14=齐次
!else
val14=齐次
!endif

!ifval $val13=1
val15=$val14
!else
val15=非$val14
!endif

!ifval $val11>1
val16=方程
!else
val16=方程
!endif

!ifval $val12>1
val17=变量
!else
val17=变量
!endif

!ifval $val13=0 and $val11>1
val18=$val6
!else
val18=$val7
!endif

!ifval $val11>=$val12
val19=$val6
!else
val19=$val7
!endif

!ifval $val12>1
val20=$val6
!else
val20=$val7
!endif
choicename1=A 正确
choicegood1=$val18
choicebad1=$val6,$val7
choicename2=B 正确
choicegood2=$val19
choicebad2=$val6,$val7
choicename3=C 正确
choicegood3=$val20
choicebad3=$val6,$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有一个由 $val11 个$val15线性$val16和 $val12 个变量组成的线性方程组.	以下性质中哪些是正确的?<ul>	<li>A. 方程组无解.	<li>B. 方程组有唯一解.	<li>C. 方程组有无穷多解.	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,15,16
embedcnt=0
