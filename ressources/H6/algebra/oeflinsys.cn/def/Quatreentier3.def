!set title=4个整数 III
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000000

ansorder=r,r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=4
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>a</i>
val7=<i>b</i>
val8=<i>c</i>
val9=<i>d</i>
tmp0=!randint -99, 99

val10=$[rint($(tmp0))]
tmp0=!randint -99, 99

val11=$[rint($(tmp0))]
tmp0=!randint -99, 99

val12=$[rint($(tmp0))]
tmp0=!randint -99, 99

val13=$[rint($(tmp0))]
val14=$[rint($val10+($val11))]
val15=$[rint($val11+($val12))]
val16=$[rint($val12+($val13))]
val17=$[rint($val13+($val10))]
replyname1=$val6
replygood1=?analyze 18
replyname2=$val7
replygood2=?analyze 19
replyname3=$val8
replygood3=?analyze 20
replyname4=$val9
replygood4=?analyze 21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()求 4 个整数 <i>a,b,c,d</i> 使得:<ul>	<li>$val6 和 $val7 的平均值是 $val14.	<li>$val7 和 $val8 的平均值是 $val15.	<li>$val8 和 $val9 的平均值是 $val16.	<li>$val9 和 $val6 的平均值是 $val17.	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval floor($val18)+floor($val19)=2*$val14
 condtest1=1
!else
 condtest1=0
!endif
condname1=($val6+$val7)/2=$val14

!ifval floor($val19)+floor($val20)=2*$val15
 condtest2=1
!else
 condtest2=0
!endif
condname2=($val7+$val8)/2=$val15

!ifval floor($val20)+floor($val21)=2*$val16
 condtest3=1
!else
 condtest3=0
!endif
condname3=($val8+$val9)/2=$val16

!ifval floor($val21)+floor($val18)=2*$val17
 condtest4=1
!else
 condtest4=0
!endif
condname4=($val9+$val6)/2=$val17

!exit

:stat
vsavelist=6,7,8,9,14,15,16,17,18,19,20,21
embedcnt=0
