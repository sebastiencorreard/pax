!set title=3个瓶子
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=1000

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 30

val6=$[rint(6*$(tmp0))]
tmp0=!randint 5, 30

val7=$[rint(6*$(tmp0))]
tmp0=!randint 5, 30

val8=$[rint(6*$(tmp0))]
tmp0=!randint 2, 4

val9=$[rint($(tmp0))]
tmp0=!randint 2, 4

val10=$[rint($(tmp0))]
val11=$[rint(1)]
val12=$[($val9)*($val10)-1]
val13=$[$val6*($val9+1)]
val14=$[$val7*($val10+1)]
val15=$[2*$val8]
val16=$[(($val13)*($val10)*($val11)+($val14)*($val11)+($val15))/($val12)]
val17=$[(($val13)+($val14)*($val9)*($val11)+($val15)*($val9))/($val12)]
val18=$[(($val13)*($val10)+($val14)+($val15)*($val9)*($val10))/($val12)]
replyname1=A 瓶
replygood1=$val16
replyname2=B 瓶
replygood2=$val17
replyname3=C 瓶
replygood3=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有 3 个水瓶.	<ul>	<li>如果从 A 瓶倒 $val6 cl 的水到 B 瓶, 	B 瓶的水将是 A 瓶的 $val9 倍.	<li>如果从 B 瓶倒 $val7 cl 的水到 C 瓶, 	C 瓶的水将是 B 瓶的 $val10 倍.	<li>如果从 C 瓶倒 $val8 cl 的水到 A 瓶, 	A 瓶的水将与 C 瓶一样多.	</ul>	每个瓶里各有多少水 (以 cl 为单位)?
$()
