!set title=三角形方程组
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=5.000000
rightrange=50.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=x
val7=<i>n</i>
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=
!else
val9=-
!endif

!ifval \sing=1
val10=-
!else
val10=+
!endif
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!item $val11 of 1,$val7,    1,   $val7 - 1,0

val12=$(tmp0)
tmp0=!item $val11 of 1,$val7 - 1,2,   $val7 - 2,1

val13=$(tmp0)
tmp0=!item $val11 of 1,$val7 - 2,3,   $val7 - 3,2

val14=$(tmp0)
tmp0=!item $val11 of 1,2,   $val7 - 1,1,     $val7 - 2

val15=$(tmp0)
tmp0=!item $val11 of 1,1,   $val7,    0,     $val7 - 1

val16=$(tmp0)
tmp0=!item $val11 of 0,1,-1,1,-1

val17=$(tmp0)

!ifval $val8=1
val18=$[rint($val17)]
!else
val18=$[rint(-($val17))]
!endif
replyname1=$val6<sub>1</sub>
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()在以下含 $val7 个方程和 $val7 个未知量 ($val7&gt;3) 的方程组里,	确定解 $val6<sub>1</sub> 的值.	<p><center><table border=0 cellspacing=3>	<tr><td align=right>$val6<sub>1</sub>+$val6<sub>2</sub>+$val6<sub>3</sub>+...+$val6<sub>$val7</sub><td>=&nbsp;$val9$val12	<tr><td align=right>$val6<sub>2</sub>+$val6<sub>3</sub>+...+$val6<sub>$val7</sub><td>=&nbsp;$val9$val13	<tr><td align=center colspan=2><b>. . .</b>	<tr><td align=right>$val6<sub>$val7-1</sub>+$val6<sub>$val7</sub><td>=&nbsp;$val9$val15	<tr><td align=right>$val6<sub>$val7</sub><td>=&nbsp;$val9$val16	</table></center> <p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,12,13,15,16
embedcnt=0
