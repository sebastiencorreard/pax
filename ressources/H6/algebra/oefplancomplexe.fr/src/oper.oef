\title{Affixe et opérations}
\language{fr}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\format{html}

\text{Confparm2= items(\confparm2)=0 ? random(ALG,XP,TRI) : \confparm2}
\text{test= ALG iswordof \Confparm2 ? randitem(\Confparm2):\Confparm2}
\text{Confparm2=\test iswordof ALG ? ALG : wims(listcomplement ALG in \Confparm2)}

\if{\Confparm2 issametext ALG}{
\real{a=randint(-6..6)/2}
\real{b=randint(-6..6)/2}

\real{pointx=\a}
\real{pointy=\b}

\complex{z=\a+\b*i}

\real{a1=randint(-6..6)/2}
\real{b1=randint(-6..6)/2}
\real{a2=randint(-2..2)}
\real{b2=randint(1..2)*random(-1,1)}
\integer{d=randint(2..4)}

\real{a3=\a-\a1}
\real{b3=\b-\b1}
\real{a4=-\a3}
\real{b4=-\b3}
\real{a5=\d*\a}
\real{b5=\d*\b}
\real{a6=\a*\a2-\b*\b2}
\real{b6=\a*\b2+\b*\a2}
\real{a7=(\a*\a2+\b*\b2)/((\a2)^2+(\b2)^2)}
\real{b7=(-\a*\b2+\b*\a2)/((\a2)^2+(\b2)^2)}
\real{a11=\a6-\a1}
\real{b11=\b1-\b6}


\complex{z1=\a1+\b1*i}
\complex{z2=\a2+\b2*i}
\complex{z3=\a3+\b3*i}
\complex{z4=\a4+\b4*i}
\complex{z5=\a5+\b5*i}
\complex{z6=\a6+\b6*i}
\complex{z7=\a7+\b7*i}
\complex{z8=\a-\b*i}
\complex{z9=\a7-\b7*i}
\complex{z10=\a6-\b6*i}
\complex{z11=\a11+\b11*i}


\text{z1b=texmath(\z1)}
\text{z2b=texmath(\z2)}
\text{z3b=texmath(\z3)}
\text{z4b=texmath(\z4)}
\text{z5b=texmath(\z5)}
\text{z6b=texmath(\z6)}
\text{z8b=texmath(\z8)}
\text{z9b=texmath(\z9)}
\text{z10b=texmath(\z10)}
\text{z11b=texmath(\z11)}



\text{confparm3= items(\confparm3)=0 ? random(1,2,3) : \confparm3}
\text{confparm3 = randitem(\confparm3)}

\integer{q= \confparm3 issametext 1 ? random(1,2,3)}
\integer{q= \confparm3 issametext 2 ? random(4,5,6)}
\integer{q= \confparm3 issametext 3 ? random(7,8,9)}

\text{question=item(\q,\((\z1b) + (\z3b)),\(\z1b - (\z4b)),\(\frac{\z5b}{\d}), \((\z2)(\z7)),\(\overline{\z8b}),\((\z2b)\times\overline{(\z9b)}) 
,\(\frac{\z6b}{\z2b}),\(\frac{\overline{\z10b}}{\z2b})
,\(\frac{\z1b \;+\; \overline{\z11b}}{\z2b})
)}

}

\if{ALG notwordof \Confparm2}{
\text{confparm3= items(\confparm3)=0 ? random(1,2,3) : \confparm3}
\text{confparm3 = randitem(\confparm3)}

\integer{choix= \confparm3 issametext 1 ? random(1,3,5,7)}
\integer{choix= \confparm3 issametext 2 ? random(2,4,6,8)}
\integer{choix= \confparm3 issametext 3 ? random(9,10)}



\integer{na= \choix = 7 or \choix =8 ? 2*random(1..6) : random(0..11)}
\rational{a=\na/12}
\integer{b=random(-1..1)}
\rational{a=\a+\b}

\integer{r=randint(1..3)*random(1,-1)}
\integer{r= \choix = 7 or \choix = 8 ? randint(1..3)}
sert à afficher joliment
\text{c=pari([numerator(\a),denominator(\a)])}
\text{api=\c[1]=1? \frac{\pi}{\c[2]}:\frac{\c[1] \pi}{\c[2]}}
\text{api=\c[1]=-1? \frac{-\pi}{\c[2]}}
\text{api=\c[2]=1? \c[1] \pi}
\text{api=\a=1?  \pi}
\text{api=\a=-1? - \pi}
\text{api=\a=0? 0}

\text{rt=\r=1? :\r}
\text{rt=\r=-1? - :\rt}
\real{pointx=(\r)*cos(\a*pi)}
\real{pointy=(\r)*sin(\a*pi)}

\integer{k = random(1..5)*random(-1,1)}

\rational{r1 = randint(1..5)*randint(-1,1)/randint(1..5)}
\text{rr=pari([numerator(\r1),denominator(\r1)])}
\text{rr1= \rr[2] = 1 ? \rr[1]: \frac{\rr[1]}{\rr[2]}}
\text{rt1=\r1=1? :\rr1}
\text{rt1=\r1=-1? - :\rt1}
\integer{na1= random(1..11)}
\rational{a1 = \na1/12 +randint(-1..1)}
\text{c=pari([numerator(\a1),denominator(\a1)])}
\text{a1pi=\c[1]=1? \frac{\pi}{\c[2]}:\frac{\c[1] \pi}{\c[2]}}
\text{a1pi=\c[1]=-1? \frac{-\pi}{\c[2]}}
\text{a1pi=\c[2]=1? \c[1] \pi}
\text{a1pi=\a1=1?  \pi}
\text{a1pi=\a1=-1? - \pi}
\text{a1pi=\a1=0? 0}


\rational{r2 = randint(1..5)*randint(-1,1)/randint(1..5)}
\text{rr=pari([numerator(\r2),denominator(\r2)])}
\text{rr2= \rr[2] = 1 ? \rr[1]: \frac{\rr[1]}{\rr[2]}}
\text{rt2=\r2=1? :\rr2}
\text{rt2=\r2=-1? - :\rt2}

\integer{na2= random(1..11)}
\rational{a2 = \na2/12 +randint(-1..1)}
\text{c=pari([numerator(\a2),denominator(\a2)])}
\text{a2pi=\c[1]=1? \frac{\pi}{\c[2]}:\frac{\c[1] \pi}{\c[2]}}
\text{a2pi=\c[1]=-1? \frac{-\pi}{\c[2]}}
\text{a2pi=\c[2]=1? \c[1] \pi}
\text{a2pi=\a2=1?  \pi}
\text{a2pi=\a2=-1? - \pi}
\text{a2pi=\a2=0? 0}

\rational{r3=item(\choix,\r/(\r1),\r/(\r1),\r1/(\r),\r,\k/(\r),\k/(\r),0,0,(\r1)*(\r2)/(\r),(\r1)*(\r2)/(\r))}
\text{rr=pari([numerator(\r3),denominator(\r3)])}
\text{rr3= \rr[2] = 1 ? \rr[1]: \frac{\rr[1]}{\rr[2]}}
\text{rr3= \choix = 7 or \choix = 8 ? \sqrt{\r} : \rr3}
\real{r3= \choix = 7 or \choix = 8 ? simplify(sqrt(\r)) : \r3}
\text{rt3=\r3=1 ? :\rr3}
\text{rt3=\r3=-1? - :\rt3}

\rational{a3 = item(\choix,\a-\a1,\a1-\a,\a1-\a,-\a,-\a,\a,\a/2,(\a+1)/2,\a1+\a2-\a,\a1-\a2-\a)}
\text{c=pari([numerator(\a3),denominator(\a3)])}
\text{a3pi=\c[1]=1? \frac{\pi}{\c[2]}:\frac{\c[1] \pi}{\c[2]}}
\text{a3pi=\c[1]=-1? \frac{-\pi}{\c[2]}}
\text{a3pi=\c[2]=1? \c[1] \pi}
\text{a3pi=\a3=1?  \pi}
\text{a3pi=\a3=-1? - \pi}
\text{a3pi=\a3=0? 0}

\text{question= item(\choix,\(z z'),\(z' \overline{z}),\(\frac{z'}{z}),\(\overline{z}),\(\frac{\k}{z}),
\(\frac{\k}{\overline{z}}),\(z^2),\(-(z^2)),\(z'  \frac{z''}{z}),\(\frac{z' \overline{z''}}{z}))}
}




Choix du type de l'énoncé


\text{Ez1 = randitem(\Confparm2)}
\text{Ez1 = \Ez1 issametext XP ? \rt1 e^{\a1pi i}:
  \rt1(\cos \a1pi +i \sin{\a1pi})}


\text{Ez2 = randitem(\Confparm2)}
\text{Ez2 = \Ez2 issametext XP ? \rt2  e^{\a2pi i} :
 \rt2(\cos \a2pi+i \sin{\a2pi})}

\text{Ez3 = randitem(\Confparm2)}
\text{Ez3 = \Ez3 issametext XP ? \rt3 e^{\a3pi i}:
  \rt3(\cos \a3pi+i \sin{\a3pi})}

\text{donnees = \choix < 4 ? z = \Ez3  \;\;\;\rm{ et } \;\;\; z' = \Ez1 : z =  \Ez3}
\text{donnees = \choix > 8 ? z = \Ez3 \;\; ,\;\; z' =  \Ez1 \;\;\;\rm{ et }\;\;\; z'' = \Ez2: \donnees}

\real{s=3.1}
Dessin des droites d'angle  "remarquables" et des cercles
\text{dessin=}
\for{i=1 to 5}{
\text{dessin=\dessin
dsegment -2*\s*cos(\i*pi/12),-2*\s*sin(\i*pi/12), 2*\s*cos(\i*pi/12),2*\s*sin(\i*pi/12),blue}}
\for{i=7 to 11}{
\text{dessin=\dessin
dsegment -2*\s*cos(\i*pi/12),-2*\s*sin(\i*pi/12), 2*\s*cos(\i*pi/12),2*\s*sin(\i*pi/12),blue}}
\text{dessin=\dessin
trange 0,2*pi
plot blue,cos(t),sin(t)
plot blue,2*cos(t),2*sin(t)
plot blue,3*cos(t),3*sin(t)}

Dessin en pointillé du quadrillage
\text{dessin1=}
\for{i=-3 to  3}{
\text{dessin1=\dessin1
dsegment -3,\i, 3,\i,blue}}
\for{i=-3 to  3}{
\text{dessin1=\dessin1
dsegment \i,-3, \i,3,blue}}

Axes
\real{taille=200}
\text{Axes=
hline 0,0,black
arrow  0,0,1,0,6,black
arrow 0,0,0,1,6,black
vline 0,0,black
}
\text{Axes=
hline 0,0,dimgrey
vline 0,0,dimgrey
linewidth 3
arrow  0,0,1,0,8,orangered
arrow 0,0,0,1,8,orangered
linewidth 1
}

A tracer selon choix au départ
\text{quad= A isitemof \confparm1 ? \dessin1 :}
\text{angl= B isitemof \confparm1 ? \dessin :}

\text{AA=
draw(\taille,\taille
xrange -\s,\s
yrange -\s,\s
\Axes
\quad
\angl)}

passage en pixels
\real{Px=(\taille*\pointx/\s+\taille)/2}
\real{Py=(-\taille*\pointy/\s+\taille)/2}


\statement{
\if{TRI isitemof\Confparm2 or XP isitemof \Confparm2}{Soit
<div class="wimscenter">\(\donnees). </div> }
Cliquez sur le point d'affixe \question :
<div class="wimscenter">\embed{reply1}</div>

}
\answer{}{\AA;point,\Px,\Py}{type=coord}

\feedback{\result1=-1}{Voici la réponse
