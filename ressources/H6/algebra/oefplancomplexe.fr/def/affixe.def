	xrange -$val18,$val18	yrange -$val18,$val18	hline 0,0,black	arrow  0,0,1,0,6,black	arrow 0,0,0,1,6,black	vline 0,0,black	disk $val8,$val9,10,blue	$val23	$val24	$val25 
$()	</div>
$()</div>
