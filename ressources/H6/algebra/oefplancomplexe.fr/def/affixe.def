!set title=Affixe
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal, Causse
email=Chantal.Causse@noos.fr
language=fr

ansorder=r
varcnt=47
prevarcnt=46
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!itemcnt $val3


!ifval $(tmp0)=0 
val3= XP 
!else
val3= $val3
!endif
tmp=!nonempty items $val3

tmp0=!randitem $tmp
val3=$(tmp0)
!if $val3 issametext ALG 
tmp0=!randint -6, 6

val6=$[$(tmp0)/2]
tmp0=!randint -6, 6

val7=$[$(tmp0)/2]
val8=$[$val6]
val9=$[$val7]
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
val11=\($val10)
!endif
!if $val3 iswordof XP TRI 
tmp0=!randitem 1/6,1/3,2/3,1/4,1/2,3/4,5/6,0/1

t_=!rawmath $(tmp0)
val6=!exec pari print($t_)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -1, 1

val7=$[rint($(tmp0))]
t_=!rawmath $val6+$val7
val6=!exec pari print($t_)
t_=!replace internal \( by ( in [numerator($val6),denominator($val6)]
tmp0=!exec pari $t_

val13=$(tmp0)

!ifval $(val13[1])=1
val14= \frac{\pi}{$(val13[2])}
!else
val14=\frac{$(val13[1]) \pi}{$(val13[2])}
!endif

!ifval $(val13[1])=-1
val14= \frac{-\pi}{$(val13[2])}
!endif

!ifval $(val13[2])=1
val14= $(val13[1]) \pi
!endif

!ifval $val6=1
val14=  \pi
!endif

!ifval $val6=-1
val14= - \pi
!endif

!ifval $val6=0
val14= 0
!endif

!ifval $val12=1
val15= 
!else
val15=$val12
!endif

!ifval $val12=-1
val15= - 
!else
val15=$val15
!endif
val8=$[($val12)*cos($val6*pi)]
val9=$[($val12)*sin($val6*pi)]
val16=\($val15 e^{$val14 i})
val17=\($val15(\cos{$val14}+i \sin{$val14}))

!ifval $val3 issametext XP 
val11=$val16
!endif

!ifval $val3 issametext TRI 
val11=$val17
!endif
!endif
val18=$[3.1]
val19=
!for val20 =1 to 5 
val19=$val19	dsegment -2*$val18*cos($val20*pi/12),-2*$val18*sin($val20*pi/12), 2*$val18*cos($val20*pi/12),2*$val18*sin($val20*pi/12),blue
!next
!for val20 =7 to 11 
val19=$val19	dsegment -2*$val18*cos($val20*pi/12),-2*$val18*sin($val20*pi/12), 2*$val18*cos($val20*pi/12),2*$val18*sin($val20*pi/12),blue
!next
val19=$val19	trange 0,2*pi	plot blue,cos(t),sin(t)	plot blue,2*cos(t),2*sin(t)	plot blue,3*cos(t),3*sin(t)
val21=
!for val20 =-3 to  3 
val21=$val21	dsegment -3,$val20, 3,$val20,blue
!next
!for val20 =-3 to  3 
val21=$val21	dsegment $val20,-3, $val20,3,blue
!next
val22=$[200]
val23=hline 0,0,dimgrey	vline 0,0,dimgrey	linewidth 3	arrow  0,0,1,0,8,orangered	arrow 0,0,0,1,8,orangered	linewidth 1	

!ifval A isitemof $val2 
val24= $val21 
!else
val24=
!endif

!ifval B isitemof $val2 
val25= $val19 
!else
val25=
!endif
!readproc oef/draw.phtml $val22,$val22 \
xrange -$val18,$val18	yrange -$val18,$val18	$val23	$val24	$val25 
tmp0=$ins_url
val26=$(tmp0)
val27=$[($val22*$val8/$val18+$val22)/2]
val28=$[(-$val22*$val9/$val18+$val22)/2]
replytype1=coord
replyname1=
replygood1=$val26;point,$val27,$val28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

