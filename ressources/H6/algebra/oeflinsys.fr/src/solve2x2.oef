\computeanswer{no}
\format{html}
\range{-5..5}
\precision{10000}
\text{lang=slib(oef/env lang)}
\title{Résoudre 2x2}
  \text{name_question=Trouvez la solution du système suivant.}
\integer{c11=random(2..10)*random(-1,1)}
\integer{c12=random(2..10)*random(-1,1)}
\integer{c21=random(2..10)*random(-1,1)}
\integer{t=abs((\c12)*(\c21)/(\c11))}
\integer{c22=\t>11?random(2..10)*random(-1,1):random(\t+2..\t+6)*random(-1,1)}
\integer{b1=random(-10..10)}
\integer{b2=random(-10..10)}
\real{det=(\c11)*(\c22)-(\c21)*(\c12)}
\real{sx=((\b1)*(\c22)-(\b2)*(\c12))/(\det)}
\real{sy=((\c11)*(\b2)-(\c21)*(\b1))/(\det)}
\text{C12=\c12>=0?+\c12:\c12}
\text{C22=\c22>=0?+\c22:\c22}
\statement{
\name_question
<div class="wimscenter">
\(\left\lbrace
\begin{array}{cccc}
\c11 x&\C12 y&=&\b1\\ \c21 x&\C22 y&=&\b2

\end{array}
\right .
\)
</div>
}
\answer{x}{\sx}
\answer{y}{\sy}
