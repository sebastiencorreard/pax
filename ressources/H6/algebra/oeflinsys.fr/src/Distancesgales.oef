\text{lang=slib(oef/env lang)}
\title{Distances égales}
\text{name_question=Trouver les coordonnées du point \(p = (x,y)\) dans le plan
  cartésien, tel que}
\text{name_question2=La distance entre,et, égale celle entre}
\text{name_hint=L'ensemble de points à distance égale vers deux points
  \(q_1\) et \(q_2\) forment une droite. Trouvez d'abord l'équation de cette droite
  en fonction de coordonnées de \(q_1) et \(q_2).}
\integer{m1=random(-10..2)}
\integer{m2=random(\m1+1..10)}
\integer{n1=random(-10..5)}
\integer{n2=random(\n1..10)}
\integer{k1=random(-10..2)}
\integer{l1=random(-5..10)}
\integer{k2=random(\k1+1..10)}
\integer{l2=random(-10..\l1-1)}
\real{a1=2*(\m1-(\m2))}
\real{b1=2*(\n1-(\n2))}
\real{c1=(\n1)^2-(\n2)^2+(\m1)^2-(\m2)^2}
\real{a2=2*(\k1-(\k2))}
\real{b2=2*(\l1-(\l2))}
\real{c2=(\k1)^2-(\k2)^2+(\l1)^2-(\l2)^2}
\real{det=(\a1)*(\b2)-(\a2)*(\b1)}
\real{x=((\c1)*(\b2)-(\c2)*(\b1))/(\det)}
\real{y=((\a1)*(\c2)-(\a2)*(\c1))/(\det)}
\statement{\name_question:
<ol><li>
 \name_question2[1] \(p) \name_question2[2] \(q_1\)=(\m1,\n1) \name_question2[3]
  \(p\) \name_question2[2] \(q_2\) = (\m2,\n2).
</li><li>
  \name_question2[1] \(p\) \name_question2[2] \(r_1\)=(\k1,\l1) \name_question2[3]
   \(p\) \name_question2[2] \(r_2\) = (\k2,\l2).
</li></ol>}
\hint{\name_hint}
\answer{\(x)}{\x}
\answer{\(y)}{\y}
