!set title=Système triangulaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=5.000000
rightrange=50.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Déterminez la valeur de \(x_1\) dans la solution du système	  linéaire suivant de \(n\) équations et \(n\) inconnues, pour \(n \ge 3\).
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=
!else
val9=-
!endif

!ifval $val8=1
val10=-
!else
val10=+
!endif
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!item $val11 of 1,\n, 1, \n $val10 1,0

val12=$(tmp0)
tmp0=!item $val11 of 1,\n $val10 1,2, \n $val10 2,1

val13=$(tmp0)
tmp0=!item $val11 of 1,\n $val10 2,3, \n $val10 3,2

val14=$(tmp0)
tmp0=!item $val11 of 1,2, \n $val10 1,1, \n $val10 2

val15=$(tmp0)
tmp0=!item $val11 of 1,1, \n, 0, \n $val10 1

val16=$(tmp0)
val17=$val9 $val16

!ifval $val16=0 
val17= 0
!else
val17= $val17
!endif
tmp0=!item $val11 of 0,1,-1,1,-1

val18=$(tmp0)

!ifval $val8=1
val19=$[rint($val18)]
!else
val19=$[rint(-($val18))]
!endif

!ifval $val12=0 
val20= 0
!else
val20=$val9$val12
!endif
replyname1=\(x_1\)
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">
!insmath \left\lbrace	\begin{array}{cccccc}	x_1&+x_2&+x_3&+...&+x_n&=&$val20	\\&x_2&+x_3&+...&+x_n&=&$val9$val13	\\&&&\vdots	\\&&&x_{n-1}&+ x_{n}&=&$val9$val15\\&&&&x_{n}&=&$val17	\end{array}	\right .	
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,13,15,17,20
embedcnt=0
