!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Trois bouteilles contiennent chacune une certaine quantité d'eau.
val8=Si l'on verse,d'eau de la bouteille, à la bouteille,a,	  fois plus d'eau que,a la même quantité d'eau que
val9=Combien d'eau y a-t-il dans chaque bouteille (en centilitres)&nbsp;
val10=Bouteille
tmp0=!randint 5, 30

val11=$[rint(6*$(tmp0))]
tmp0=!randint 5, 30

val12=$[rint(6*$(tmp0))]
tmp0=!randint 5, 30

val13=$[rint(6*$(tmp0))]
tmp0=!randint 2, 4

val14=$[rint($(tmp0))]
tmp0=!randint 2, 4

val15=$[rint($(tmp0))]
val16=$[rint(1)]
val17=$[($val14)*($val15)-1]
val18=$[$val11*($val14+1)]
val19=$[$val12*($val15+1)]
val20=$[2*$val13]
val21=$[(($val18)*($val15)*($val16)+($val19)*($val16)+($val20))/($val17)]
val22=$[(($val18)+($val19)*($val14)*($val16)+($val20)*($val14))/($val17)]
val23=$[(($val18)*($val15)+($val19)+($val20)*($val14)*($val15))/($val17)]
replyname1=$val10 A
replygood1=$val21
replyname2=$val10 B
replygood2=$val22
replyname3=$val10 C
replygood3=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<ul><li>	$(val8[1]) $val11 cl $(val8[2]) A $(val8[3]) B, B $(val8[4]) $val14 $(val8[5]) A.	</li><li>	$(val8[1]) $val12 cl $(val8[2]) B $(val8[3]) C, C $(val8[4]) $val15 $(val8[5]) B.	</li><li>	$(val8[1]) $val13 cl $(val8[2]) C $(val8[3]) A, A $(val8[6]) C.	</li></ul>	$val9?
$()
