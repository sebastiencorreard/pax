!set title=3 solutions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=37
prevarcnt=36
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=
!readproc slib/oef/env lang 
tmp0=$slib_out
val7=$(tmp0)
tmp=!trim cations,de cations	  anions,d'anions
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim calcium,magnésium,sodium,potassium	  chlorure,sulfate,nitrate,nitrite,carbonate
val8=!translate internal $	\
$ to ;; in $tmp
val9=Type,Solution
val10=Trois solutions ont des teneurs en ppm (partie par million),	  données par le tableau ci-dessous.
val11=Nous voulons former,	  centilitres d'une solution avec,	  ppm de,	  en mélangeant les 3 solutions. Combien de centilitres devons-nous prendre de	  chacune&nbsp;
val12=$[rint(10)]
val13=$[rint(200)]
val14=random
val15=0
val16=
val17=$[rint(0)]
!while $val17<10 and ($val17<3 or $val15<$val13^2) 
t_=!replace internal \( by ( in matrix(3,3,x,y,$val14($val13-($val12))+($val12))
tmp0=!exec pari $t_

val18=$(tmp0)
t_=!replace internal \( by ( in abs(matdet([$val18]))
tmp0=!exec pari $t_

val19=$(tmp0)
!if $val19>$val15 
val16=$val18
val15=$val19
!endif
val17=$[rint($val17+1)]
!endwhile
tmp0=!randint $val12, $val13

tmp1=!randint $val12, $val13

tmp2=!randint $val12, $val13

val20=$(tmp0),$(tmp1),$(tmp2)
t_=!replace internal \( by ( in [$val20]*[$val16]~
tmp0=!exec pari $t_

val21=$(tmp0)
tmp0=!random $val12, $val13

tmp1=!random $val12, $val13

tmp2=!random $val12, $val13

val20=$(tmp0),$(tmp1),$(tmp2)
val22=$[$(val20[1])+$(val20[2])+$(val20[3])]
t_=!replace internal \( by ( in ([$val20]*[$val16]~)/$val22
tmp0=!exec pari $t_

val21=$(tmp0)
val23=$[rint($(val21[1]))]
val24=$[rint($(val21[2]))]
val25=$[rint($(val21[3]))]
val21=$val23,$val24,$val25
val22=$[rint($val22)]
t_=!replace internal \( by ( in ([$val21]*([$val16]^-1)~)*$val22.0
tmp0=!exec pari $t_

val20=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
!if $(tmp0) = 1 
val26=$(val8[1;1])
val27=$(val8[1;2])
tmp0=!shuffle $(val8[1;])

val28=$(tmp0)
!else
val26=$(val8[2;1])
val27=$(val8[2;1])
tmp0=!shuffle $(val8[2;])

val28=$(tmp0)
!endif
val29=A,B,C
replyname1=Solution A en cL
replygood1=$(val20[1])
replyname2=Solution B en cL
replygood2=$(val20[2])
replyname3=Solution C en cL
replygood3=$(val20[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10	<table class="wimscenter wimsborder"><tr><th>$(val9[1])</th>	<th>$(val28[1])</th><th>$(val28[2])</th><th>$(val28[3])</th></tr>	 
!for m_m=1 to 3 
$()	 <tr><th>$(val9[2]) $(val29[$m_m])</th>	  
!for m_n=1 to 3 
$()<td>$(val16[$m_n;$m_m])</td> 
!next
$()	 </tr>	 
!next
$()	</table>	$(val11[1]) $val22 $(val11[2]) $(val21[1]) $(val11[3])	$(val28[1]), $(val21[2]) $(val11[3]) $(val28[2]), $(val21[3]) $(val11[3]) $(val28[3])	$(val11[4])?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

