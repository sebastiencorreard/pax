\title{Équation du second degré à coefficients complexes (C;J)}
\language{fr}
\author{Christine, Sacré}
\email{christine.sacre@univ-lille.fr}
\observation{Dans cet exercice, les racines de l'équation sont des éléments de \(\mathbb{Z}[i]\). 
(Il en est de même pour les coefficients de l'équation, le discriminant et ses racines carrées.)
Il y a trois étapes : calculer le discriminant ; donner ses deux racines carrées ; donner les solutions de l'équation.
Il est possible mais peu probable que le discriminant soit réel ou imaginaire pur.
}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{a1=random(1,-1)*randint(1..3)}
\integer{a2=random(1,-1)*randint(0..3)}
\integer{u1=random(1,-1)*randint(0..3)}
\integer{u2=random(1,-1)*randint(0..3)}
\integer{v1=random(1,-1)*randint(0..3)}
\integer{v2=random(1,-1)*randint(0..3)}

\complex{a=\a1+(\a2)*i} %% coefficient de z**2 
\complex{z1=\u1+(\v1)*i} %% z1 et z2 sont les solutions de l'équation
\complex{z2=\u2+(\v2)*i}

\complex{b=(\a)*(-1)*((\z1)+(\z2))} %% b est le coefficient de z
\complex{c=(\a)*(\z1)*(\z2)} %% c est le coefficient constant


\function{pol=maxima(expand((\a)*z^2+(\b)*z+(\c)))}

\complex{d=(\b)^2-4*(\a)*(\c)} %% d est le discriminant de l'équation pol = 0
\text{dd=texmath(\d)}


\text{sol=\z1,\z2}
\complex{d1=2*(\a)*(\z1)+\b} %% d1 et d2 sont les deux racines carrées du discriminant
\complex{d2=2*(\a)*(\z2)+\b}
\text{sol1= \d1,\d2 }

\text{STEPS =  reply1
reply2
reply3
}

\steps{\STEPS}

\text{textsol= Le discriminant est \(\Delta = \dd \). Dans \(\mathbb{C}\), les racines carrées du discriminant sont \(\sol1) . 
Dans \(\mathbb{C}\), les  solutions de l'équation sont <br\>
<div class="wimscenter">
\(\z1) et \(\z2)
</div>}


\statement{On considère l'équation du second degré : \(\pol=0\). On veut résoudre cette équation dans \(\mathbb{C}).
\if{\step=1}{<p>Calculez le discriminant \({\Delta} \) de l'équation.
<div class="wimscenter"> \(\Delta=\) \embed{reply1} </div>
}
\if{\step=2}{<p>Oui, le discriminant \({\Delta} \) est bien égal à \(\d\).  
<p>Calculez maintenant ses racines carrées.
<p>Les racines carrées du discriminant sont :
<div class="wimscenter">
 \embed{reply2,20}.
</div>
<div class="wims_instruction">
<b>Attention :</b> Séparer les racines par une virgule.
</span></div>
}
\if{\step=3}{<p>Oui, les racines carrées du discriminant sont bien \sol1 . 
<p> Calculez maintenant les solutions de l'équation.
 <div class="wimscenter">
Ensemble des solutions : \embed{reply3,20}.
</div>
<div class="wims_instruction">
<b>Attention :</b> Séparez les racines par une virgule.
</span></div>
}

}

\hint{Le discriminant \({\Delta} \) d'une équation du second degré \( a z^2+b z+c=0 \)
est \(\Delta =b^2-4 a c \). 
<p>Ici, \( a=\a \), \( b=\b \) et \( c=\c \).
<p>Les racines carrées de \({\Delta} \) sont \( x+iy \) et \( -x-iy \) 
où \( x \) et \( y \) vérifient les 3 équations :
\(x^2-y^2={\rm Re}(\Delta) \) (égalité des parties réelles) ; \( 2x y={\rm Im}(\Delta)\) (égalité des parties imaginaires) ; 
\(x^2+y^2=\vert\Delta\vert \) (égalité des modules).
<p>Les solutions de l'équation sont \(\dfrac{-b\pm\delta}{2a}), 
où \({\delta} \) est une racine carrée du discriminant  \({\Delta} \).}

\answer{Discriminant}{\d}{type=complex}
\answer{racines carrées du discriminant}{\sol1}{type=fset}
\answer{ensemble des solutions}{\sol}{type=fset}

\solution{\textsol}
