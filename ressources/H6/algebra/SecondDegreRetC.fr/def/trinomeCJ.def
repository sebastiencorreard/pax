!set title=Équation du second degré (C,J)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr
keywords=equations,trinomial
language=fr
precision=1000
oefobservation=Dans cet exercice, la résolution se fait dans l'ensemble des complexes.<br>Il y a deux solutions complexes conjuguées dans 60% des cas. <br>Les solutions tombent "juste" (les élèves n'auront pas à saisir de racine carrée dans le champ de réponse).

ansorder=r,r,r,r
varcnt=40
prevarcnt=39
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=X
val7=deux solutions réelles, une solution réelle double,deux solutions complexes conjuguées
tmp0=!randitem 1,2,3,3,3

val8=$[rint($(tmp0))]
val9=z_1
val10=CC
!if $val8=1 
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val12=$[rint($val11+$(tmp0))]

!ifval $val12==0
t_=!rawmath $val11/2
val12=!exec pari print($t_)
!endif
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val13*(z-$val11)*(z-$val12))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
val15=$[-($val13)*(($val11)+($val12))]
val16=$[($val13)*($val11)*($val12)]
val17=r1	  r2
val18=Quelles sont ces solutions réelles \(x_1) et \( x_2) &#63;
!endif
!if $val8=2 
tmp0=!randint 2, 5

val19=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)/$val19
val11=!exec pari print($t_)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$val19^2*$(tmp1))]
t_=!replace internal \( by ( in expand($val13*(z-$val11)^2)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
val15=$[-($val13)*2*($val11)]
val16=$[($val13)*($val11)^2]
val17=r1	  r3
val18=Quelle est cette solution réelle double \($val9) &#63;
!endif
!if $val8=3 
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint 1, 10

val20=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val11-$val20*i
t_=!exec pari print($t_)
val21=!mathsubst I=i in $t_
t_=!rawmath $val11+$val20*i
t_=!exec pari print($t_)
val22=!mathsubst I=i in $t_
t_=!replace internal \( by ( in expand($val13*(z-$val21)*(z-$val22))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
val15=$[-($val13)*($val11)*2]
val16=$[($val13)*(($val11)^2+($val20)^2)]
val17=r1	  r4
val18=Quelles sont ces solutions complexes \(z_1) et \(z_2) &#63;
!endif
val23=$[rint(5)]
val24=aset
val25=$[($val15)^2-4*($val13)*($val16)]

!ifval $val13<0 
val26= ($val13) 
!else
val26= $val13
!endif

!ifval $val15<0 
val27= ($val15) 
!else
val27= $val15
!endif

!ifval $val16<0 
val28= ($val16) 
!else
val28= $val16
!endif
val29=Pour savoir combien il y a de solutions, on peut calculer le discriminant de l'équation : \(\Delta=b^2-4ac)<br>	Ici, on a \(a=$val13), \(b=$val15) et \(c=$val16). Donc le calcul du discriminant se fait ainsi :<br>	\(\Delta=$val27^2-4\times $val26 \times $val28=$val25)
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
replytype1=radio
replyname1=type de solutions
replygood1=$val8;$val7
replytype2=$val24

replyoption2=distinct_inputs 
replyname2=\(x_1) et \(x_2)
replygood2=$val11,$val12
replytype3=numexp
replyname3=\($val9)
replygood3=$val11
replytype4=$val24

replyoption4=distinct_inputs 
replyname4=\(z_1) et \(z_2)
replygood4=$val21,$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère l'équation 
!insmath (E) : $val14=0
$().	<br>On veut résoudre cette équation sur 
!insmath $val10
$().	</p>	
!if $m_step=1 
$()	L'équation 
!insmath (E)
$() possède :	<div class="wims_question"><ul class="wims_nopuce">	<li> 
!read oef/embed.phtml reply1,1 
$()</li>	<li> 
!read oef/embed.phtml reply1,2 
$()</li>	<li> 
!read oef/embed.phtml reply1,3 
$()</li>	</ul></div>	  
!else
$()	  	
!if $val8=1 
$()L'équation 
!insmath (E)
$() possède $(val7[$val8]).	$val18	<div class="wims_question"><div class="wimscenter">Donner l'ensemble de ces deux solutions :  
!read oef/embed.phtml reply2,$val23 
$()</div></div>	  
!endif
$()	
!if $val8=2 
$()L'équation 
!insmath (E)
$() possède $(val7[$val8]).	$val18	<div class="wims_question"><div class="wimscenter"> 
!insmath $val9
$()= 
!read oef/embed.phtml reply3,$val23 
$()</div></div>	  
!endif
$()	
!if $val8=3 
$()L'équation 
!insmath (E)
$() possède $(val7[$val8]).	$val18	<div class="wims_question"><div class="wimscenter">Donner l'ensemble de ces deux solutions :  
!read oef/embed.phtml reply4,$val23 
$()</div></div>	  
!endif
$()	
!if $val6 notsametext X 
$()<br/><br/><div class=wims_instruction>$val6</div> 
!endif
$()	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_step=1
 <div class='oef_feedbacks'><div class="feedback">$val29</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,14,18,23,29
embedcnt=6
