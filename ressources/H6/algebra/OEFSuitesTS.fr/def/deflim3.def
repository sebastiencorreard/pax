!set title=Limites: Définition 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

tmp1=!randitem 1,1,1,2,3

tmp=!translate ";': to $     $ in $(tmp0)/$(tmp1)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp2)
val6=!exec pari print($t_)
tmp0=!randitem 1,1/2,10^(-8)

t_=!rawmath $(tmp0)
val7=!exec pari print($t_)
tmp0=!randitem 10,1000,4000

val8=$[rint($(tmp0))]
val9=abs(u-$val6)<$val7,n<$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,4,	abs(u-$val6)<$val7,n>$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,4,	abs(u-$val6)>$val7,n>$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,2,	abs(u-$val6)<$val7/n,n>$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,1,	abs(u-$val6)<$val7/n,n<$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,4,	abs(u-$val6)>$val7/n,n>$val8,la suite converge vers $val6, la suite ne converge pas vers $val6, la suite diverge, on ne peut rien dire,4,	
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
t_=!replace internal \( by ( in $(val10[1])
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
tmp0=!replace internal u by u_n in $val11

val11=$(tmp0)
tmp0=!texmath $(val10[2])

val12=$(tmp0)
tmp0=!item 3 to -1 of $val10

val13=$(tmp0)
tmp0=!itemcnt $val13

val14=$[rint($(tmp0)-1)]
tmp0=!item $val14 of $val13

val15=$[rint($(tmp0))]
tmp0=!item 1 to $val14-1 of $val13

val16=$(tmp0)
replytype1=radio
replyname1=
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère une suite 
!insmath (u_n)
$(), qui vérifie :	  <div class="wimscenter"> 
!insmath $val11
$() pour tout 
!insmath $val12
$()</div>	  Que peut-on dire de cette suite ?	  <div class="wims_instruction">Choisir l'affirmation la plus pertinente.</div>	  <ul>	   
!for m_i=1 to $val14-1 
$()	  <li> 
!read oef/embed.phtml reply1,\i 
$()</li>	   
!next
$()	  </ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,14
embedcnt=1
