!set title=Calcul de limite 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(+ \infty)
val7=\(- \infty)
val8=$val6, $val7
val9=a une limite finie nulle, a une limite finie non nulle, a une limite infinie, n'a pas de limite
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]
tmp0=!randint 1, 3

val16=$[rint($(tmp0))]

!ifval $val16=1
t_=!replace internal \( by ( in expand(($val10*x+$val11)*($val12*x+$val13))
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
!else
t_=!replace internal \( by ( in expand(($val10*x+$val11)*($val12*x+$val13)*($val14*x+$val15))
tmp1=!exec maxima $t_

val17=!rawmath $(tmp1)
!endif

!ifval $val16=1
val18=$[rint($val10*$val12)]
!else
val18=$[rint($val10*$val12*$val14)]
!endif
tmp0=!randint 1, 6

tmp1=!randitem 1,-1

val19=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val20=$[rint($(tmp0))]
tmp0=!randint -5, 5

val21=$[rint($(tmp0))]

!ifval $val16<3
t_=!replace internal \( by ( in expand(($val19*x^2+$val20*x+$val20)*($val14*x+$val15))
tmp0=!exec maxima $t_

val22=!rawmath $(tmp0)
!else
t_=!replace internal \( by ( in ($val19*x^2+$val20*x+$val20)
tmp1=!exec maxima $t_

val22=!rawmath $(tmp1)
!endif

!ifval $val16<3
val23=$[rint($val19*$val14)]
!else
val23=$[rint($val19)]
!endif
t_=!rawmath $val23/$val18
val24=!exec pari print($t_)
t_=!replace internal \( by ( in limit(($val22)/($val17),x,INF)
tmp0=!exec maxima $t_

val25=$(tmp0)	
!if inf isin \lim 
val26=+\infty
!endif
!if minf isin \lim 
val26=-\infty
!endif
!if inf notin \lim 
val26=\lim
!endif
tmp0=!replace internal x by n in $val22

val27=$(tmp0)
tmp0=!replace internal x by n in $val17

val28=$(tmp0)

!ifval $val16=1
val29=3
!else
val29=2
!endif

!ifval $val16=3
val29=1
!endif
!if $val16=1 
val30=r1	  r3
!if $val24>0 
val31=$val6
!else
val31=$val7
!endif
!else
!if $val16=2 
val30=r1	                 r2
!else
val30=r1
!endif
!endif
val19=($val27)/($val28)
oefsteps=$val30 
nextstep=!nosubst $val30 
!readproc oef/steps.proc
replytype1=menu
replyname1=type limite
replygood1=$val29;$val9
replytype2=numexp
replyname2=
replygood2=$val25
replytype3=clickfill
replyname3=
replygood3=$val31;$val7,$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

