!insmath u
$() définie pour 
!insmath n \ge 1
$() par	  <div class="wimscenter">
!insmath u_n = $val19
$()</div>	  
!if $m_step=1 
$()	  Choisissez la bonne réponse:<br>	  La suite 
!insmath u
$()  
!read oef/embed.phtml reply 1 
$()	   
!endif
$()	  
!if $m_step=2 
$()	    
!if $val29=2 
$()	    Quelle est la limite finie de 
!insmath u
$() ?<br>	    <label for="reply2">
!insmath \displaystyle{\lim_{n \to +\infty}u_n = }
$()</label>  
!read oef/embed.phtml reply 2 
$()	    
!else
