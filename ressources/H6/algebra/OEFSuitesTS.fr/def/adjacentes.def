!set title=Suites adjacentes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
val7=$[rint(2*$val6)]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($val8+$(tmp0))]
tmp0=!randitem 1,3,5,7,9

val10=$[rint($(tmp0))]
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val9)]
val13=$[rint($val8+$val6*$val11)]
tmp0=!randint 1, 3

val14=$[rint(-$val8-$(tmp0)+$val6*$val11)]
tmp0=!texmath $val6+$val8/n

tmp1=!texmath $val6-$val9/n

tmp2=!texmath $val6+$val8/n

tmp3=!texmath $val6+$val9/n

tmp4=!texmath $val6+(-1)^{n+1}/n

tmp5=!texmath $val6+(-1)^{n}/n

tmp6=!texmath n+$val6/n

tmp7=!texmath n-$val6/n

tmp8=!texmath 10^{-3}+1/n

tmp9=!texmath 10^{-4}-1/n

tmp10=!texmath 1/(2*n+$val10)

tmp11=!texmath 1/(2*n-$val10)

tmp12=!texmath $val6+1/($val8*n+1)

tmp13=!texmath $val6-1/($val9*n+1)

tmp14=!texmath ($val6*n+$val13)/($val9*n+$val12)

tmp15=!texmath ($val6*n+$val14)/($val9*n+$val12)

tmp16=!texmath ($val6*n+$val13)/($val9*n+$val12)

tmp17=!texmath ($val7*n+$val14)/($val9*n+$val12)

val15=$(tmp0),$(tmp1),1,$val6,	$(tmp2),$(tmp3),2,1,	$(tmp4),$(tmp5),2,1,	$(tmp6),$(tmp7),2,1,	$(tmp8),$(tmp9),2,2,	$(tmp10),$(tmp11),2,1,	$(tmp12),$(tmp13),1,$val6,	$(tmp14),$(tmp15),1,$val6/$val9,	$(tmp16),$(tmp17),2,2,	
tmp=!translate internal $	$ to ; in $val15

tmp0=!rowcnt $tmp
val16=$[rint($(tmp0))]
tmp0=!randint 1, $val16

val17=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val19=$(val18[1])
val20=$(val18[2])
val21=$[rint($(val18[3]))]
!if $val21=1 
t_=!rawmath $(val18[4])
val22=!exec pari print($t_)
val23=Les deux conditions sont bien remplies et la limite commune est \($val22).
!else

!ifval $(val18[4])=1
val23=Ici,la deuxième condition n'est pas remplie.
!else
val23=	  Ici, la première condition n'est pas remplie.
!endif
!endif
replytype1=radio
replyname1=adjacentes
replygood1=$val21;Oui,Non
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère les suites 
!insmath (a_n)
$() et 
!insmath (b_n)
$() définies par	  <div class="wimscenter">
!insmath  a_n=$val19
$() et 
!insmath b_n=$val20
$()</div>	  Les suites 
!insmath (a_n)
$() et 
!insmath (b_n)
$() sont-elles adjacentes ?	  <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Pour avoir deux suites adjacentes, il faut remplir deux conditions:	<ol>	<li> 
!insmath \displaystyle\lim (a_n-b_n)=0
$()</li>	<li> une suite doit être croissante et l'autre décroissante,à partir d'un certain rang.</li>	</ol>	$val23
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
