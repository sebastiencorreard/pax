!set title=Suite arithmético-géométrique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp1=!randint 1, 10

tmp=!translate ";': to $     $ in $(tmp0)/$(tmp1)

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp3=!randitem 1,-1

t_=!rawmath $(tmp2)*$(tmp3)
val7=!exec pari print($t_)

!ifval $val7=1
t_=!rawmath 2
val7=!exec pari print($t_)
!endif
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=\(\displaystyle\lim u_n=+\infty\)
val10=\(\displaystyle\lim u_n=-\infty\)
val11=On ne peut rien dire
val12=\((u_n)\) n'a pas de limite
val13=\((u_n)\) a une limite finie
val14=$val9,$val10,$val12,$val13
t_=!replace internal \( by ( in $val7*x+$val8
tmp0=!exec pari $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
tmp0=!replace internal x by u_n in $val15

val15=$(tmp0)
tmp=!translate ";': to $     $ in $val8/(1-$val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val6-$val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)

!ifval $val17>0 
val18=$val16+$val17*($val7)^n
!else
val18=$val16 $val17*($val7)^n 
!endif

!ifval $val17=0 
val18= $val16
!endif
!if $val7>0 
!if $val17>0 

!ifval $val7>1
val19=$[rint(1)]
!else
val19=$[rint(4)]
!endif
!else

!ifval $val7>1
val19=$[rint(2)]
!else
val19=$[rint(4)]
!endif
!endif
!else

!ifval $val7<=-1
val19=$[rint(3)]
!else
val19=$[rint(4)]
!endif

!ifval $val7=-1 and $val8=2*$val6 
val19=$[rint(4)]
!endif
!endif
val20=$[rint($val16)]

!ifval $val19=4
val21=r1,r2	r3
!else
val21=r1,r2
!endif
oefsteps=$val21 
nextstep=!nosubst $val21 
!readproc oef/steps.proc
replytype1=formal
replyname1=terme général
replygood1=$val18
replytype2=radio
replyname2=convergence
replygood2=$val19;$val14
replytype3=numexp
replyname3=limite
replygood3=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la suite 
!insmath (u_n)
$() définie par:	  <div class="wimscenter">	  
!insmath  \left \lbrace \begin{array}{l} u_0=$val6 \\ u_{n+1}=$val15 \end{array} \right .
$()	  </div>	  
!if $m_step=1 
$()	    <ol>	    <li>Donner une formule explicite de 
!insmath u_n
$():	    <div class="wimscenter">	    <label for="reply1">
!insmath u_n
$()=</label> 
!read oef/embed.phtml reply1 
$()	    </div></li>	    <li>Que peut-on dire ?	    <ul>	     
!for m_j=1 to 4 
$()<li> 
!read oef/embed.phtml reply2,\j 
$()</li>	      
!next
$()	    </ul>	    </li>	    </ol>	   
!else
$() 	  <label for="reply3">Quelle est la limite finie de 
!insmath (u_n)
$()</label> ?  
!read oef/embed.phtml reply3,5 
$()	   
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
