!set title=Théorème de convergence monotone
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
val7=La suite est convergente et \(\displaystyle\lim u_n=$val6)
val8=La suite est convergente et \(\displaystyle\lim u_n \leq $val6)
val9=La suite est convergente et \(\displaystyle\lim u_n \geq $val6)
val10=La suite est convergente et \(\displaystyle\lim u_n < $val6)
val11=La suite est convergente et \(\displaystyle\lim u_n > $val6)
val12=La suite tend vers \(\ +\infty)
val13=La suite tend vers \(\ -\infty)
val14=On ne peut rien dire
val15=Il n'existe pas de suites vérifiant les propriétés de l'énoncé.
val16=La suite \((u_n)) est croissante et non majorée,1,$val12,$val13,	La suite \((u_n)) est décroissante et non majorée,200,$val12,$val13,	La suite \((u_n)) est décroissante et non minorée,2,$val12,$val13,	La suite \((u_n)) est croissante et non minorée,200,$val12,$val13,	La suite \((u_n)) est décroissante et minorée par $val6,2,$val7,$val9,$val11,$val12,	La suite \((u_n)) est croissante et majorée par $val6,2,$val7,$val8,$val10,$val13,	La suite \((u_n)) est croissante et minorée par $val6,100,$val7,$val9,$val11,$val12,	La suite \((u_n)) est décroissante et majorée par $val6,100,$val7,$val8,$val10,$val13,	
tmp=!translate internal $	$ to ; in $val16

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val17=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val16

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!itemcnt $val18

val19=$[rint($(tmp0)-1)]
val20=$(val18[1])
val21=$[rint($(val18[2]))]
tmp0=!item 3 to $val19 of $val18

val22=$(tmp0),$val14,$val15

!ifval $val21=200
val21=$[rint($val19)]
!endif

!ifval $val21=100
val21=$[rint($val19-1)]
!endif
replytype1=radio
replyname1=Conclusion
replygood1=$val21;$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>$val20.</p>	Que peut-on dire de cette suite ?	<ul class="wims_nopuce spacer">	 
!for m_j=1 to $val19 
$()	  <li> 
!read oef/embed.phtml reply1,\j 
$()</li>	  
!next
$()	 </ul>	
$()
!exit

