!set title=Limites: Définition 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!texmath ($val6*n^2+$val7*n+$val8)/($val9*n+$val10)

val11=$(tmp0)
val12=\(u_n=$val11\) pour tout \(n \in \mathbb{N}\)

!ifval $val6>0
val13=\(+\infty\)
!else
val13=\(-\infty\)
!endif

!ifval $val6>0
val14=&#93; \(A\); \(+\infty\) &#91;
!else
val14=&#93; \(-\infty\);\(A\) &#91;
!endif

!ifval $val6>0
val15=positif
!else
val15=négatif
!endif
tmp0=!randint 2, 3

val16=$[rint($(tmp0))]

!ifval $val6>0
val17=10^$val16
!else
val17=-10^$val16
!endif
val18=$[rint(($val7-$val17*$val9)^2-4*$val6*($val8-$val10*$val17))]
val19=$[rint(ceil((-$val7+$val17*$val9+sqrt($val18))/(2*$val6)))]
val20=$[rint(ceil((-$val7+$val17*$val9-sqrt($val18))/(2*$val6)))]

!ifval $val19>$val20
val21=$[rint($val19)]
!else
val21=$[rint($val20)]
!endif
replytype1=numeric
replyname1=Rang \(n_0\)
replygood1=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la suite 
!insmath (u_n)
$() définie par :	  <div class="wimscenter"> $val12.</div>	  On veut montrer que cette suite diverge et que sa limite est $val13.<br>	  Pour cela, étant donné un entier $val15 
!insmath A
$(), il existe un rang 
!insmath n_0
$()	  à partir duquel tous les termes de la suite sont dans l'intervalle	  <div class="wimscenter">$val14.</div>	  Déterminer le plus petit entier 
!insmath n_0
$() vérifiant cette propriété pour 
!insmath A=$val17
$().	  <div class="wimscenter"><label for="reply1">
!insmath n_0
$()=</label> 
!read oef/embed.phtml reply1 
$() </div>	
$()
!exit

