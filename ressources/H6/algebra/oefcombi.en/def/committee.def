!set title=Commitee of class
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=en
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 9

val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]

!ifval $val9=1
val11=boy
!else
val11=boys
!endif

!ifval $val10=1
val12=girl
!else
val12=girls
!endif
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val14=$[rint($val9+$val10+$val13)]
val15=$[rint(factorial($val6)/(factorial($val9)*factorial($val6-$val9)))]
val16=$[rint(factorial($val7)/(factorial($val10)*factorial($val7-$val10)))]
val17=$[rint(factorial($val6)/(factorial($val9+1)*factorial($val6-$val9-1)))]
val18=$[rint(factorial($val7)/(factorial($val10+1)*factorial($val7-$val10-1)))]
val19=$[rint(factorial($val6)/(factorial($val9+2)*factorial($val6-$val9-2)))]
val20=$[rint(factorial($val7)/(factorial($val10+2)*factorial($val7-$val10-2)))]

!ifval $val13=1
val21=$[rint($val15*$val18+$val17*$val16)]
!else
val21=$[rint(	 $val15*$val20+$val17*$val18+$val19*$val16)]
!endif
replyname1=Number of possibilities
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We have a class of $val6 boys and $val7 girls.	How many possibilities are there to compose a committee of class with	$val14 puples, knowing that there must be at least $val9 $val11 and	$val10 $val12 in the committee?
$()
!exit

