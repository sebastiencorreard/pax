!set title=Groups of pupils
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=en
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 14

val6=$[rint($(tmp0))]
tmp0=!item $val6 of 2,4,3,2,5,2,6,3,4,2,7,3,5,8

val7=$[rint($(tmp0))]
tmp0=!item $val6 of 4,2,3,5,2,6,2,4,3,7,2,5,3,2

val8=$[rint($(tmp0))]
val9=$[rint($val7*$val8)]
val10=$[rint(factorial($val9)/(factorial($val8)*factorial($val7)^$val8))]
replyname1=Number of ways
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()In how many ways can one divide a class of $val9 pupils	into $val8 groups of $val7 pupils each?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=0
