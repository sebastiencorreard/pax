tmp0=!randint 2, 6

val6=$[rint($(tmp0))]
tmp0=!randint 2, 6

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 8

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 1,0,1,1,2,2,2,3

val10=$[rint($(tmp0))]
tmp0=!item $val9 of 0,1,1,2,1,2,3,2

val11=$[rint($(tmp0))]
val12=$[rint($val10*$val6+$val11*$val7)]
tmp0=!item $val9 of 	 each girl gets at least one,	 each boy gets at least one,	 each child gets at least one,	 each girl gets at least 1 and each boy gets at least 2,	 each girl gets at least 2 and each boy gets at least 1,	 each child gets at least 2,	 each girl gets at least 2 and each boy gets at least 3,	 each girl gets at least 3 and each boy gets at least 2,	

val13=$(tmp0)
tmp0=!randint 3, 7

val14=$[rint($(tmp0))]
val15=$[rint($val12+$val14)]
val16=$[rint(binomial($val14+$val8-1,$val14))]
replyname1=Number of ways
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()How many ways there are to distribute	$val15 sweets to $val6 girls and $val7 boys, so that $val13?
$()
