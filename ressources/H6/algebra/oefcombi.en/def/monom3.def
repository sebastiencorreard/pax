!set title=Monomial 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=en
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

val6=$[rint($(tmp0))]
tmp0=!item $val6 of 2,2,2,3,3,4,5,5

val7=$[rint($(tmp0))]
tmp0=!item $val6 of 3,3,5,4,5,5,6,7

val8=$[rint($(tmp0))]
tmp0=!item $val6 of 5,7,7,5,7,7,7,8

val9=$[rint($(tmp0))]
tmp0=!randint 4, 15

val10=$[rint($(tmp0))]
val11=$[rint(($val10+2)*($val10+1)/2)]
replyname1=Number of integers
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()How many integers are there of the form	$val7<sup><i>a</i></sup>&middot;$val8<sup><i>b</i></sup>&middot;$val9<sup><i>c</i></sup>,	where the exponents <i>a,b,c</i> are non-negative integers with	<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;$val10?
$()
!exit

:hint
$()The bases $val7, $val8, $val9 being coprime, these integers are different	for any different choices of <i>a,b,c</i>. Hence it suffices to evaluate	the number of possibilities of writing	<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;$val10.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10
embedcnt=0
