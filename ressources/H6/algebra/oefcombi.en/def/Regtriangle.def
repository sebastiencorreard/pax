 !exit
!endif

tmp0=!randint 5, 17

val6=$[rint($(tmp0))]
val7=$[rint($val6*($val6-1)*($val6-2)/6)]
replyname1=Number of triangles
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let P be a regular polygon of $val6 sides.	How many distinct triangles are there, whose 3 vertices are	vertices of P?
