\title{Rectangles}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{hori=random(3..8)}
\integer{vert=random(3..8)}
\integer{tot=\hori+\vert}
\integer{sol=(\hori*\vert*(\hori-1)*(\vert-1))/4}

\statement{We have \tot lines in the plane, of which \hori are horizontal,
and \vert are vertical. <p>
How many rectangles are formed by these \tot lines?}

\answer{Number of rectangles}{\sol}

