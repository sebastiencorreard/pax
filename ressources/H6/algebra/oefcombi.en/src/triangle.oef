\title{Triangles}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{line=random(7..15)}
\integer{orig=random(3..\line-3)}
\integer{vert=random(3..8)}
\integer{tot=\hori+\vert}
\integer{sol=\line*(\line-1)*(\line-2)/6-\orig*(\orig-1)*(\orig-2)/6}

\statement{We have \line lines in the plane, of which \orig contains the
origin of the plane. There is no other point contained in more than two lines,
nor any line parallel to another. <p>
How many triangles are formed by these \line lines?}

\answer{Number of triangles}{\sol}

