\title{Monomial 4}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{type=random(1..11)}
\integer{a=item(\type,2, 2,2, 2,3, 3,4, 4, 5,5, 5)}
\integer{b=item(\type,3, 3,5, 5,4, 5,5, 5, 6,7, 7)}
\integer{c=item(\type,5, 7,7, 7,5, 7,7, 9, 7,8, 9)}
\integer{d=item(\type,7,11,9,11,7,11,9,11,11,9,11)}
\integer{degree=random(2..9)}
\integer{sol=(\degree+3)*(\degree+2)*(\degree+1)/6}

\statement{How many integers are there of the form
\a<sup><i>a</i></sup>&middot;\b<sup><i>b</i></sup>&middot;\c<sup><i>c</i></sup>&middot;\d<sup><i>d</i></sup>,
where the exponents <i>a,b,c,d</i> are non-negative integers with
<i>a</i>+<i>b</i>+<i>c</i>+<i>d</i>&nbsp;=&nbsp;\degree?}

\hint{The bases \a, \b, \c, \d being coprime, these integers are different
for any different choices of <i>a,b,c,d</i>. Hence it suffices to evaluate
the number of possibilities of writing
<i>a</i>+<i>b</i>+<i>c</i>+<i>d</i>&nbsp;=&nbsp;\degree.}
\answer{Number of integers}{\sol}