\title{Fixed partitions}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{dist=random(3..10)}
\integer{parts=random(4..9)}
\integer{min=random(0..3)}
\integer{n=\dist+\min*\parts}
\text{order=random(increasing,decreasing)}
\integer{sol=binomial(\dist+\parts-1,\parts-1)}

\statement{In how many ways can we write
<p><center>
 \n&nbsp;=&nbsp;<i>n</i><sub>1</sub>+<i>n</i><sub>2</sub>+...+<i>n</i><sub>\parts</sub>&nbsp;,
</center> <p>
where the <i>n</i><sub><i>i</i></sub> are integers greater than or equal to
\min, arranged in \order order?}

\answer{Number of ways}{\sol}