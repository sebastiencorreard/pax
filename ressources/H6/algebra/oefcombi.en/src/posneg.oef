\title{Positive negative}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{pos=random(3..8)}
\integer{neg=random(3..8)}
\integer{tot=\pos+\neg}
\text{qlist=negative numbers which are products,
positive numbers which are products,
negative rational numbers which are quotients,
positive rational numbers which are quotients}
\integer{type=random(1..4)}
\text{question=item(\type,\qlist)}
\text{slist=\pos*\neg,\pos*(\pos-1)+\neg*(\neg-1),
2*\pos*\neg,2*(\pos*(\pos-1)+\neg*(\neg-1))}
\integer{sol=item(\type,\slist)}

\statement{Let <i>S</i> be a set containing \pos positive integers and
\neg negative integers. The absolute values of these \tot integers are
distinct prime numbers. <p>
What is the number of \question of two different numbers in <i>S</i>?}

\answer{The number}{\sol}

