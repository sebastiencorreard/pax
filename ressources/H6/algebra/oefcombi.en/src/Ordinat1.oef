\title{Computer room I}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{12}

\integer{computers=random(8..12)}
\integer{students=random(ceil(\computers/2)..\computers-3)}
\text{distr=pari(binomial(\computers,\students)*
truncate(factorial(\students)))}

\statement{A school has a computer room with \computers PC's.
A group of \students pupils take a lesson in this computer room.
How many different ways there are to attribute each pupil to
a (distinct) PC?}

\answer{Number of ways}{\distr}