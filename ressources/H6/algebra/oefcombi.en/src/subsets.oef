\title{Subsets}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(10..25)}
\integer{first=random(3..6)}
\integer{binom=binomial(\tot,\first)}

\statement{A finite set <i>S</i> has \binom
subsets of \first elements. What is the number of
elements of <i>S</i>&nbsp;?}

\answer{|<i>S</i>|}{\tot}



