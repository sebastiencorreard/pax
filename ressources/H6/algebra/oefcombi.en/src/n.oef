\title{Binomial coefficients}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{tot=random(10..30)}
\integer{first=random(2..floor(\tot/3))}
\integer{second=\tot-\first}
\text{q1=What is the value of <i>n</i>?}
\text{q2=What is the value of C<sub><i>n</i></sub><sup>\first</sup>?}
\integer{choice=random(0,1)}
\text{q=\choice=0?\q1:\q2}
\integer{sol=\choice=0?\tot:binomial(\tot,\first)}

\statement{Let <i>n</i> be a positive integer such that
C<sub><i>n</i></sub><sup>\first</sup>=C<sub><i>n</i></sub><sup>\second</sup>.
\q}

\answer{Your reply}{\sol}

