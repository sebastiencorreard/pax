\title{Double languages}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(10..26)}
\integer{english=random(ceil(\tot/2)..\tot-2)}
\integer{german=random(ceil(\tot/2)..\tot-2)}
\integer{both=\english+\german-\tot}
\integer{enonly=\english-\both}
\integer{geonly=\german-\both}
\integer{ans=\enonly*\german+\both*(\german-1)-\both*(\both-1)/2}
\statement{Amont \tot pupils of a class, \english speak French,
\german speak German. (Each pupil speaks either French or German.)
<p>
Now we have to choose two among these \tot pupils, such that one 
speaks French, the other speaks German. How many possible
choices are there?}

\answer{Number of choices}{\ans}

