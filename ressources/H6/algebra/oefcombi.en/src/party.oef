\title{Handshakes}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{couple=random(5..10)}
\integer{single=random(10..20)}
\integer{total=2*\couple+\single}
\integer{ans=(\total*(\total-1))/2-\couple}

\statement{\couple couples and \single non-maried people meet during a party.
At the start of the party, each participant shake hands with each other
participant once, except that there is no handshake between husband and
wife. How many handshakes have occurred in total?}

\answer{Handshakes}{\ans}



