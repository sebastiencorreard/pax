\title{Intersection points III}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{coinc=random(3..8)}
\integer{sol=binomial(\tot,2)-binomial(\coinc,2)+1}

\statement{In the plane, two lines has at most one intersection point. <p>
How many intersection points there are at most among \tot lines,
of which \coinc contains the origin of the plane?}

\answer{Number of points}{\sol}

