\title{Dinner table}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3..7)}
\integer{tot=2*\pairs}
\integer{sol=2*factorial(\pairs)^2}

\statement{\pairs couples take dinner together. How many ways there are for
these \tot people to sit around the table, such that each gentleman 
is between two ladies?}

\answer{Number of ways}{\sol}



