\title{Binomial coefficients II}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{tot=random(10..30)}
\integer{first=random(3..\tot-3)}
\integer{binom=binomial(\tot,\first)}

\statement{If 
C<sub><i>n</i></sub><sup>\first</sup>=\binom,
What is the value of <i>n</i>&nbsp;?}

\answer{<i>n</i>}{\tot}



