\title{Intersection points II}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{par=random(3..8)}
\text{dir=random(horizontal,vertical)}
\integer{sol=binomial(\tot,2)-binomial(\par,2)}

\statement{In the plane, two lines has at most one intersection point. <p>
How many intersection points there are at most among \tot lines,
of which \par are \dir (therefore parallel)?}

\answer{Number of points}{\sol}

