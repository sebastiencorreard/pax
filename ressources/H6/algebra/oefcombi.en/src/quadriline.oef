\title{Quadrilaterals on lines}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{l1=random(4..15)}
\integer{l2=random(4..15)}
\integer{tot=\l1+\l2}
\integer{sol=\l1*(\l1-1)*\l2*(\l2-1)/4}

\statement{We have 2 parallel lines in the plane. On the first line we
have \l1 points, and on the second, \l2 points.
How many quadrilaterals can be formed by these \tot points?}

\answer{Number of quadrilaterals}{\sol}

