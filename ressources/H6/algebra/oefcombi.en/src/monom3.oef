\title{Monomial 3}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{type=random(1..8)}
\integer{a=item(\type,2,2,2,3,3,4,5,5)}
\integer{b=item(\type,3,3,5,4,5,5,6,7)}
\integer{c=item(\type,5,7,7,5,7,7,7,8)}
\integer{degree=random(4..15)}
\integer{sol=(\degree+2)*(\degree+1)/2}

\statement{How many integers are there of the form
\a<sup><i>a</i></sup>&middot;\b<sup><i>b</i></sup>&middot;\c<sup><i>c</i></sup>,
where the exponents <i>a,b,c</i> are non-negative integers with
<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;\degree?}

\hint{The bases \a, \b, \c being coprime, these integers are different
for any different choices of <i>a,b,c</i>. Hence it suffices to evaluate
the number of possibilities of writing
<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;\degree.}
\answer{Number of integers}{\sol}