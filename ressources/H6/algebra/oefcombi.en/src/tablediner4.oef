\title{Dinner table}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3,4)}
\integer{tot=2*\pairs}
\integer{coef=item(\pairs-2,1,2)}
\integer{sol=2*factorial(\pairs)*\coef}

\statement{\pairs couples take dinner together. How many ways there are for
these \tot people to sit around the table, such that each gentleman is
between two ladies, and that no husband is at the side of his wife?}

\answer{Number of ways}{\sol}

