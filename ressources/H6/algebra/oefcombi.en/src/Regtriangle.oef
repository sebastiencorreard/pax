\title{Triangles in polygon}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{sides=random(5..17)}
\integer{sol=\sides*(\sides-1)*(\sides-2)/6}

\statement{Let P be a regular polygon of \sides sides.
How many distinct triangles are there, whose 3 vertices are
vertices of P?}

\answer{Number of triangles}{\sol}



