\title{Computer room II}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{group=random(2..3)}
\integer{computers=random(3..12/\group)}
\integer{students=\computers*\group}
\integer{pro=factorial(\students)}
\integer{gro=item(\group,1,2,6)}
\integer{ddd=\gro^\computers}
\integer{distr=\pro/\ddd}
\statement{A school has a computer room with \computers PC's.
A group of \students pupils take a lesson in this computer room.
How many different ways there are to distribute the pupils over the PC's,
such that each PC receives \group pupils?}

\answer{Number of ways}{\distr}



