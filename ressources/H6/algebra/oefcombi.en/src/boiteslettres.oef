\title{Letterboxes}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{letters=random(3..7)}
\integer{boxes=random(3..8)}
\integer{methods=\boxes^\letters}
\statement{How many different ways there are, to put \letters letters
into \boxes letterboxes?}


\answer{Number of ways}{\methods}



