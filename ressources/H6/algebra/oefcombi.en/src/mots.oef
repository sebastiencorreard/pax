\title{Words}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(6..10)}
\integer{adj=random(2..4)}
\text{lett=item(\adj,A,A B,A B C,A B C D)}
\integer{sol=factorial(\tot-\adj+1)*factorial(\adj)}

\statement{How many distinct words can be formed from the \tot first
letters of the alphabet, knowing that each letter is used exactly once
in each word, and that the \adj first letters {\lett} must appear grouped 
in each word?}

\hint{First consider the \adj first letters as one element.}
\answer{Number of words}{\sol}



