\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{num=random(3..6)}
\integer{distr=factorial(\num)^2}
\statement{There are \num bus, \num drivers et \num controllers. 
How many ways there are to attribute the drivers and controllers
to the bus, such that each bus has one driver and one controller?}

\answer{Number of ways}{\distr}



