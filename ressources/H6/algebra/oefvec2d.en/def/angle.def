!set title=Angle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Angle

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=We have 3 points in the plane
val8=Compute the angle \(\widehat{BAC})	  (in degrees, between 0 and 180).
val9=Use the relation between the scalar product of two vectors and	  the angle between them.
val10=The angle
!if $val6=fr 
val7=Soient trois points dans le plan&nbsp;
val8=Calculer l'angle \(\widehat{B A C})	  (en degrés, compris entre 0 et 180).
val9=Utiliser la relation entre le produit scalaire de deux vecteurs et	  l'angle entre leur angle.
val10=Angle
!endif
val11=$[rint(8)]
val12=$[rint($val11*2)]
tmp0=!randint -$val11, $val11-2

val13=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val14=$[rint(2*$(tmp0))]
tmp0=!randint -$val12, $val12

val15=$[rint($(tmp0))]
tmp0=!randint -$val12, $val12

val16=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11-2

val17=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val12, $val12

val18=$[rint($(tmp0))]
tmp0=!randint -$val12, $val12

val19=$[rint($(tmp0))]
tmp0=!randint -$val12, $val12

val20=$[rint($(tmp0))]
tmp0=!randint -$val12, $val12

val21=$[rint($(tmp0))]
val22=$[rint($val19+$val13)]
val23=$[rint($val20+$val14)]
val24=$[rint($val21+$val15)]
val25=$[rint($val19+$val16)]
val26=$[rint($val20+$val17)]
val27=$[rint($val21+$val18)]
val28=$[rint($val13*$val16+$val14*$val17)]
val29=$[sqrt(($val13)^2+($val14)^2)]
val30=$[sqrt(($val16)^2+($val17)^2)]
val31=$[acos($val28/($val29*$val30))*180/pi]
replyname1=$val10
replygood1=$val31
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val9


!goto stat

!exit

