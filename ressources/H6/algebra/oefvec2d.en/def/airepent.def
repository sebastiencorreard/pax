!set title=Area of pentagon
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Aire de pentagone

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compute the area of the pentagon \(A B C D E\) in the cartesian	  plane whose 5 vertices are
val8=Area
!if $val6=fr 
val7=Calculer l'aire du pentagone \(A B C D E) dans le plan cartésien	  dont les 5 sommets sont
val8=Aire
!endif
val9=$[rint(6)]
val10=$[rint(13)]
tmp0=!randint $val10-2, $val10+4

val11=$[rint($(tmp0))]
tmp0=!randint -2, 2

val12=$[rint($(tmp0))]
tmp0=!randint $val9, $val10

val13=$[rint($(tmp0))]
tmp0=!randint $val9+3, $val10+3

val14=$[rint($(tmp0))]
tmp0=!randint -$val9, -$val10

val15=$[rint($(tmp0))]
tmp0=!randint $val9, $val10

val16=$[rint($(tmp0))]
tmp0=!randint -$val9, -$val10

val17=$[rint($(tmp0))]
tmp0=!randint -$val9, -$val10

val18=$[rint($(tmp0))]
tmp0=!randint $val9, $val10

val19=$[rint($(tmp0))]
tmp0=!randint -$val9-3, -$val10-3

val20=$[rint($(tmp0))]
val21=$[rint($val13-$val11)]
val22=$[rint($val14-$val12)]
val23=$[rint($val15-$val11)]
val24=$[rint($val16-$val12)]
val25=$[rint($val17-$val11)]
val26=$[rint($val18-$val12)]
val27=$[rint($val19-$val11)]
val28=$[rint($val20-$val12)]
val29=$[rint($val21*$val24-$val23*$val22)]
val30=$[rint($val23*$val26-$val25*$val24)]
val31=$[rint($val25*$val28-$val27*$val26)]
val32=$[0.5*abs($val29+$val30+$val31)]
tmp0=!randitem 0,1

val33=$[rint($(tmp0))]

!ifval $val33=1
val34=$val13,$val14
!else
val34=$val19,$val20
!endif

!ifval $val33=1
val35=$val19,$val20
!else
val35=$val13,$val14
!endif

!ifval $val33=1
val36=$val15,$val16
!else
val36=$val17,$val18
!endif

!ifval $val33=1
val37=$val17,$val18
!else
val37=$val15,$val16
!endif
replyname1=$val8
replygood1=$val32
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	 
!insmath A
$() = ($val11,$val12), 
!insmath B
$() = ($val34),	 
!insmath C
$() = ($val36), 
!insmath D
$() = ($val37), 
!insmath E
$() = ($val35).	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11,12,34,35,36,37
embedcnt=0
