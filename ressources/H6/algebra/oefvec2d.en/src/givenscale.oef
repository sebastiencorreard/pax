\title{Given scalar products}
\title_fr{Produits scalaires donnés}

\text{name_instruction=Let, be two vectors in the plane. Find the vector \(v\) having the following scalar products:}
\text{name_hint=Here, \(\langle \cdot, \cdot \rangle) is the scalar product.}

\if{\lang=fr}{

\text{name_instruction=Soit, deux vecteurs dans le plan. Trouvez le vecteur \(v) tel que&nbsp;}
\text{name_hint=Ici, \(\langle \cdot, \cdot \rangle) est le produit scalaire.}

}

\integer{mid=8}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=2*random(-\mid..\mid)}
\integer{a2=random(-\range..\range)}
\integer{b2=2*random(-\mid..\mid-2)+1}
\integer{a=random(1..\range)*random(-1,1)}
\integer{b=random(1..\range)*random(-1,1)}
\integer{A=\a1*\a+\b1*\b}
\integer{B=\a2*\a+\b2*\b}
\statement{
  \name_instruction[1]
  <div class="wimscenter">\(v_1=(\a1,\b1)), \(v_2 = (\a2,\b2)).</div>
  \name_instruction[2]:
  <div class="wimscenter">
  	\(\langle v,v_1\rangle = \A ), \(\langle v,v_2\rangle = \B) .
  </div>
  \name_hint
}
\answer{\(v)}{\a,\b}{type=vector}

