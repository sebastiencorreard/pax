!set title=Fixed partitions
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 10

val6=$[rint($(tmp0))]
tmp0=!randint 4, 9

val7=$[rint($(tmp0))]
tmp0=!randint 0, 3

val8=$[rint($(tmp0))]
val9=$[rint($val6+$val8*$val7)]
tmp0=!randitem toenemende,afnemende

val10=$(tmp0)
val11=$[rint(binomial($val6+$val7-1,$val7-1))]
replyname1=Aantal manieren
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Op hoeveel manieren kunnen we schrijven:	<p><center>	 $val9&nbsp;=&nbsp;<i>n</i><sub>1</sub>+<i>n</i><sub>2</sub>+...+<i>n</i><sub>$val7</sub>&nbsp;,	</center> <p>	waarin <i>n</i><sub><i>i</i></sub> integers zijn groter of gelijk aan $val8 en gerangschikt in $val10 volgorde?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10
embedcnt=0
