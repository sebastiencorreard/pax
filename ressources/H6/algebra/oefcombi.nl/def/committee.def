!set title=klasse commissie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 9

val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]

!ifval $val9=1
val11=jongen
!else
val11=jongens
!endif

!ifval $val10=1
val12=meisje
!else
val12=meisjes
!endif
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val14=$[rint($val9+$val10+$val13)]
val15=$[rint(factorial($val6)/(factorial($val9)*factorial($val6-$val9)))]
val16=$[rint(factorial($val7)/(factorial($val10)*factorial($val7-$val10)))]
val17=$[rint(factorial($val6)/(factorial($val9+1)*factorial($val6-$val9-1)))]
val18=$[rint(factorial($val7)/(factorial($val10+1)*factorial($val7-$val10-1)))]
val19=$[rint(factorial($val6)/(factorial($val9+2)*factorial($val6-$val9-2)))]
val20=$[rint(factorial($val7)/(factorial($val10+2)*factorial($val7-$val10-2)))]

!ifval $val13=1
val21=$[rint($val15*$val18+$val17*$val16)]
!else
val21=$[rint(	 $val15*$val20+$val17*$val18+$val19*$val16)]
!endif
replyname1=Aantal mogelijkheden
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	In een klas zitten $val7 meisjes en $val6 jongens.<br>	Op hoeveel verschillende manieren kunnen we een <em>klasse commissie</em> 	samenstellen met $val14 deelnemers uit deze groep leerlingen,<br>	onder voorwaarde dat er tenminste $val9 $val11 en $val10 $val12 zitting nemen in deze commissie? 	
$()
