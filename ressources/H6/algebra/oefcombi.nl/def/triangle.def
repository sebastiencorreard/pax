!set title=Driehoeken en lijnen I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
