val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 7, 15

val6=$[rint($(tmp0))]
tmp0=!randint 3, $val6-3

val7=$[rint($(tmp0))]
tmp0=!randint 3, 8

val8=$[rint($(tmp0))]
val9=$[rint(\hori+$val8)]
val10=$[rint($val6*($val6-1)*($val6-2)/6-$val7*($val7-1)*($val7-2)/6)]
replyname1=Aantal driehoeken
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	We hebben $val6 lijnen in het platte vlak.<br>	Van deze $val6 lijnen lopen er $val7 door de Oorsprong (0:0).<br>	Er is geen punt waardoor meer dan twee lijnen lopen.<br>	Verder zijn er geen lijnen parallel aan elkaar.<br>	Hoeveel driehoeken worden door deze $val6 lijnen gevormd ?	
$()
!exit

