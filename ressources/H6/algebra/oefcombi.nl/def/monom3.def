replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Hoeveel integers zijn er in de vorm:<br>	$val7<sup><i>a</i></sup>&middot;$val8<sup><i>b</i></sup>&middot;$val9<sup><i>c</i></sup><br>	met daarin de niet-negatieve exponenten <i>a,b,c</i> waarvoor geldt:<br><i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;$val10?
$()
!exit

:hint
$()<em>Twee gehele getallen worden ten opzichte van elkaar relatief priem genoemd,<br>	wanneer er geen positief geheel getal groter dan 1 bestaat dat beide deelt</em><br>	De basis getallen $val7, $val8, $val9 zijn <en>relatief priem</em>,	en deze integers zijn verschillend bij de keuzes van <i>a,b,c</i>. 	Dus is het afdoende uit te rekenen:<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;$val10.
$()
!exit

