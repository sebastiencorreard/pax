tmp0=!randint 5, 10

val6=$[rint($(tmp0))]
tmp0=!randint 10, 20

val7=$[rint($(tmp0))]
val8=$[rint(2*$val6+$val7)]
val9=$[rint(($val8*($val8-1))/2-$val6)]
