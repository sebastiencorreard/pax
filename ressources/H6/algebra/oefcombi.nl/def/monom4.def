val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 11

val6=$[rint($(tmp0))]
tmp0=!item $val6 of 2, 2,2, 2,3, 3,4, 4, 5,5, 5

val7=$[rint($(tmp0))]
tmp0=!item $val6 of 3, 3,5, 5,4, 5,5, 5, 6,7, 7

val8=$[rint($(tmp0))]
tmp0=!item $val6 of 5, 7,7, 7,5, 7,7, 9, 7,8, 9

val9=$[rint($(tmp0))]
tmp0=!item $val6 of 7,11,9,11,7,11,9,11,11,9,11

val10=$[rint($(tmp0))]
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
val12=$[rint(($val11+3)*($val11+2)*($val11+1)/6)]
replyname1=Aantal integers
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Hoeveel integers zijn er in de vorm:<br>	$val7<sup><i>a</i></sup>&middot;$val8<sup><i>b</i></sup>&middot;$val9<sup><i>c</i></sup>&middot;$val10<sup><i>d</i></sup>,	met daarin de niet-negatieve integer exponenten <i>a,b,c,d</i> ,<br>	waarvoor geldt:<i>a</i>+<i>b</i>+<i>c</i>+<i>d</i>&nbsp;=&nbsp;$val11?
$()
!exit

:hint
$()	<em>	Twee gehele getallen worden ten opzichte van elkaar relatief priem genoemd,<br>	wanneer er geen positief geheel getal groter dan 1 bestaat dat beide deelt.</em><br>		De basis $val7, $val8, $val9, $val10 zijn <em>relatief priem</em>	en deze integers zijn verschillend bij elke keuze van <i>a,b,c,d</i>. <br>	Het volstaat de uit te rekenen:<i>a</i>+<i>b</i>+<i>c</i>+<i>d</i>&nbsp;=&nbsp;$val11.
$()
!exit

