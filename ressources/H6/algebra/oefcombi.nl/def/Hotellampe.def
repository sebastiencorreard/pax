 !exit
!endif

tmp0=!randint 10, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 4

val7=$[rint($(tmp0))]
val8=$[rint(binomial($val6-$val7-1,$val7))]
replyname1=Aantal manieren
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	In een hotel is een lange gang, verlicht door een rij van $val6 lampen.	<br>	In het kader van <em>energie besparing</em> worden  $val7 lampen 's nachts uitgeschakeld.	<br>	Voor een minimale verlichting , mogen er geen twee achter elkaar liggende lampen worden gedoofd.<br>	Ook de lampen aan de uiteinden van de gang moeten blijven branden.	<br>	Op hoeveel verschillende manieren kan het hotel $val7 lampen uitschakelen ?
$()
!exit

