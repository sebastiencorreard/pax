!set title=Helicopters
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 4

val6=$[rint($(tmp0))]
val7=$[rint(2*$val6)]
val8=$[rint(factorial($val6))]
tmp0=!item $val6 of 1,6,90,2520,113400

val9=$[rint($(tmp0))]
val10=$[rint($val8*$val9)]
replyname1=Aantal manieren
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Een vliegmaatschappij heeft $val6 helicopters.<br>	Als personeel hebben ze $val6 piloten en $val7 stewardessen in dienst.<br>	Op hoeveel verschillende manieren kunnen ze de piloten en stewardessen verdelen over de helicopters,	<br> zo dat elke helicopter &eacute;&eacute;n piloot en twee stewardessen aan boord heeft?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=0
