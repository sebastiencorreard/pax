tmp0=!randint 2, 6

val6=$[rint($(tmp0))]
tmp0=!randint 2, 6

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 8

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 1,0,1,1,2,2,2,3

val10=$[rint($(tmp0))]
tmp0=!item $val9 of 0,1,1,2,1,2,3,2

val11=$[rint($(tmp0))]
val12=$[rint($val10*$val6+$val11*$val7)]
tmp0=!item $val9 of 	 elk meisje er op z'n minst &eacute;&eacute;n krijgt,	 elke jongen er op z'n minst &eacute;&eacute;n krijgt,	 elk kind er op z'n minst &eacute;&eacute;n krijgt,	 elk meisje er op z'n minst &eacute;&eacute;n en elke jongen er op z'n minst &eacute;&eacute;n krijgen,	 elk meisje er op z'n minst twee en elke jongen krijgt er op z'n minst &eacute;&eacute;n krijgen,	 elk kind er op z'n minst twee krijgt,	 elk meisje er op z'n minst twee en elke jongen er op z'n minst drie krijgt,	 elk meisje er op z'n minst drie en elke jongen er op z'n minst twee krijgt	

val13=$(tmp0)
tmp0=!randint 3, 7

val14=$[rint($(tmp0))]
val15=$[rint($val12+$val14)]
val16=$[rint(binomial($val14+$val8-1,$val14))]
