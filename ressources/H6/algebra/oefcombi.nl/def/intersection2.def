!set title=Snijpunten II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 40

val6=$[rint($(tmp0))]
tmp0=!randint 3, 8

val7=$[rint($(tmp0))]
tmp0=!randitem horizontaal,vertikaal

val8=$(tmp0)
val9=$[rint(binomial($val6,2)-binomial($val7,2))]
replyname1=Maximaal aantal snijpunten
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	In het platte vlak hebben twee rechte lijnen maximaal &eacute;&eacute;n snijpunt.	<br>	Hoeveel snijpunten zijn er maximaal tussen $val6 rechte lijnen waarvan er $val7 $val8 zijn (en dus parallel)?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=0
