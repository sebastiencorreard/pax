\title{Etentje IV}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3,4)}
\integer{tot=2*\pairs}
\integer{coef=item(\pairs-2,1,2)}
\integer{sol=2*factorial(\pairs)*\coef}

\statement{\pairs <em>hetero</em> paren hebben samen een etentje...<br>
Op hoeveel manieren kunnen deze \tot personen aan &eacute;&eacute;n tafel zitten,<br>
onder voorwaarde dat elke man zit tussen twee vrouwen<br>en dat geen enkele echtgenoot naast zijn eigen echtgenote zit?
}
\answer{Aantal manieren}{\sol}

