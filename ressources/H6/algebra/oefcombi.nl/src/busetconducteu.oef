\title{Bussen}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{num=random(3..6)}
\integer{distr=factorial(\num)^2}
\statement{
Een busmaatschappij heeft \num bestuurders , \num controleurs en  \num bussen .<br>
Op hoeveel verschillende manieren kunnen ze de bestuurders en controleurs verdelen over de bussen,<br>
zo dat elke bus &eacute;&eacute;n bestuurder en &eacute;&eacute;n controleur heeft?
}

\answer{Aantal manieren}{\distr}



