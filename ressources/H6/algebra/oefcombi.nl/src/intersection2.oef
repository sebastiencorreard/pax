\title{Snijpunten II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{par=random(3..8)}
\text{dir=random(horizontaal,vertikaal)}
\integer{sol=binomial(\tot,2)-binomial(\par,2)}
\statement{
In het platte vlak hebben twee rechte lijnen maximaal &eacute;&eacute;n snijpunt.
<br>
Hoeveel snijpunten zijn er maximaal tussen \tot rechte lijnen waarvan er \par \dir zijn (en dus parallel)?
}
\answer{Maximaal aantal snijpunten}{\sol}