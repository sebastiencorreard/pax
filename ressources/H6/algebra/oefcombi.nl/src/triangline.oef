\title{Driehoeken en lijnen II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{l1=random(4..15)}
\integer{l2=random(4..15)}
\integer{tot=\l1+\l2}
\integer{sol=\l1*\l2*(\l1+\l2-2)/2}

\statement{
We hebben twee parallele lijnen in het platte vlak.<br>
Op de eerste lijn liggen \l1 punten.<br>
Op de tweede lijn liggen \l2 punten.<br>
Hoeveel driehoeken kunnen door deze \tot punten worden gevormd?
}
\answer{aantal driehoeken}{\sol}

