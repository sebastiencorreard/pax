\title{Computer lokaal I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{12}

\integer{computers=random(8..12)}
\integer{students=random(ceil(\computers/2)..\computers-3)}
\text{distr=pari(binomial(\computers,\students)*
truncate(factorial(\students)))}

\statement{
Een school heeft een computer lokaal met \computers PC's.<br>
Een klas van \students leerlingen heeft les in dit lokaal.<br>
Op hoeveel verschillende manieren kan elke leerling een computer toegewezen krijgen?
}
\answer{Aantal verschillende manieren}{\distr}