\title{Binomiale co&euml;fficienten II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{tot=random(10..30)}
\integer{first=random(3..\tot-3)}
\integer{binom=binomial(\tot,\first)}

\statement{Als geldt: 
C<sub><i>n</i></sub><sup>\first</sup>=\binom
<br>
Wat is dan waarde van <i>n</i>&nbsp;?}

\answer{<i>n</i>}{\tot}



