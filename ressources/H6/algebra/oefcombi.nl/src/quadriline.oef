\title{Vierhoeken en lijnen}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{l1=random(4..15)}
\integer{l2=random(4..15)}
\integer{tot=\l1+\l2}
\integer{sol=\l1*(\l1-1)*\l2*(\l2-1)/4}

\statement{
We nemen twee parallele lijnen in het platte vlak.<br>
Op de eerste lijn zijn \l1 punten, en op de tweede lijn zijn er \l2 punten.<br>
Hoeveel vierhoeken kunnen worden gevormd door deze \tot punten ?}
\answer{aantal vierhoeken}{\sol}

