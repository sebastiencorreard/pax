\title{Binomiale co&euml;fficienten I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{tot=random(10..30)}
\integer{first=random(2..floor(\tot/3))}
\integer{second=\tot-\first}
\text{q1=Wat is dan de waarde van <i>n</i>?}
\text{q2=Wat is dan de waarde van C<sub><i>n</i></sub><sup>\first</sup>?}
\integer{choice=random(0,1)}
\text{q=\choice=0?\q1:\q2}
\integer{sol=\choice=0?\tot:binomial(\tot,\first)}

\statement{Laat <i>n</i> een positieve integer zijn, zo dat
C<sub><i>n</i></sub><sup>\first</sup>=C<sub><i>n</i></sub><sup>\second</sup>.<br>
\q}

\answer{n=}{\sol}

