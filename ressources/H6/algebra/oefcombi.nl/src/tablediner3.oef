\title{Etentje III}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3..7)}
\integer{tot=2*\pairs}
\integer{sol=2*factorial(\pairs)*2^\pairs}

\statement{
\pairs <em>hetero</em> paren hebben samen een etentje...
<br>
Op hoeveel manieren kunnen deze \tot personen aan &eacute;&eacute;n tafel zitten,<br>
onder de voorwaarde dat elke vrouw naast haar eigen man moet zitten...
}
\answer{Aantal manieren}{\sol}

