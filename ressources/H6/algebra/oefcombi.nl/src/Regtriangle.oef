\title{Driehoeken in een polygoon}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{sides=random(5..17)}
\integer{sol=\sides*(\sides-1)*(\sides-2)/6}

\statement{
Gegeven is de regelmatige veelhoek (polygoon) met \sides zijden.<br>
Hoeveel verschillende driehoeken zijn er,<br>waarvan de 3 hoeken ook hoekpunten zijn van polygoon P ?
}

\answer{Het aantal verschillende driehoeken}{\sol}



