\title{Etentje II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3..8)}
\integer{tot=2*\pairs}
\integer{sol=4*factorial(\pairs)}

\statement{
\pairs <em>hetero</em> paren hebben een etentje...<br>
Op hoeveel manieren kunnen deze \tot personen aan &eacute;&eacute;n tafel zitten,<BR>
onder voorwaarde dat elke heer tussen twee dames zit,<br>en elke man naast zijn vrouw moet zitten?
}

\answer{Aantal manieren}{\sol}

