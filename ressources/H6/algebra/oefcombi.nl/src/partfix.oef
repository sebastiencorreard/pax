\title{Fixed partitions}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{dist=random(3..10)}
\integer{parts=random(4..9)}
\integer{min=random(0..3)}
\integer{n=\dist+\min*\parts}
\text{order=random(toenemende,afnemende)}
\integer{sol=binomial(\dist+\parts-1,\parts-1)}

\statement{
Op hoeveel manieren kunnen we schrijven:
<p><center>
 \n&nbsp;=&nbsp;<i>n</i><sub>1</sub>+<i>n</i><sub>2</sub>+...+<i>n</i><sub>\parts</sub>&nbsp;,
</center> <p>
waarin <i>n</i><sub><i>i</i></sub> integers zijn groter of gelijk aan \min en gerangschikt in \order volgorde?}

\answer{Aantal manieren}{\sol}