\title{Etentje I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3..7)}
\integer{tot=2*\pairs}
\integer{sol=2*factorial(\pairs)^2}

\statement{
\pairs <em>hetero</em> paren hebben een etentje...<br>
Op hoeveel manieren kunnen deze \tot mensen aan &eacute;&eacute;n tafel zitten,<br>
onder de voorwaarde dat elke heer tussen twee dames moet zitten?
}
\answer{Aantal manieren}{\sol}



