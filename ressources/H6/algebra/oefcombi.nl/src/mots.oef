\title{Woorden}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(6..10)}
\integer{adj=random(2..4)}
\text{lett=item(\adj,A,A B,A B C,A B C D)}
\integer{sol=factorial(\tot-\adj+1)*factorial(\adj)}

\statement{
Hoeveel verschillende woorden kunnen worden gevormd uit de \tot eerste letters van het alfabet,<br>
met als voorwaarde dat elke letter maar &eacute;&eacute;n keer mag voorkomen in elk woord,<br>en
dat de \adj eerste letters (<tt> \lett </tt>) als groep moeten voorkomen in elk woord?
}
\hint{Bekijk de \adj eerste letters eerst als &eacute;&eacute;n element.}
\answer{Aantal woorden}{\sol}



