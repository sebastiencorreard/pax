\title{Computer lokaal II}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{group=random(2..3)}
\integer{computers=random(3..12/\group)}
\integer{students=\computers*\group}
\integer{pro=factorial(\students)}
\integer{gro=item(\group,1,2,6)}
\integer{ddd=\gro^\computers}
\integer{distr=\pro/\ddd}
\statement{
Een school heeft een computer lokaal met \computers PC's.<br>
Een klas van \students leerlingen heeft les in dit lokaal.<br>
Op hoeveel verschillende manieren kunnen we deze leerlingen verdelen over de 
aanwezige PC's ,<br>
 zo dat achter elke PC \group leerlingen zitten ?}
\answer{Het aantal manieren}{\distr}




