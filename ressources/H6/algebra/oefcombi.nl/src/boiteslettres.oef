\title{Letters op een leesplank}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{letters=random(3..7)}
\integer{boxes=random(3..8)}
\integer{methods=\boxes^\letters}
\statement{
Op hoeveel verschillende manieren kun je \letters letters
op \boxes leesplankjes leggen ?}


\answer{Aantal verschillende manieren}{\methods}



