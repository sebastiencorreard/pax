\title{Rechthoeken}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{hori=random(3..8)}
\integer{vert=random(3..8)}
\integer{tot=\hori+\vert}
\integer{sol=(\hori*\vert*(\hori-1)*(\vert-1))/4}

\statement{
We hebben \tot lijnen in het platte vlak, waarvan \hori horizontaal,
en \vert vertikaal zijn. <p>
Hoeveel rechthoeken worden gevormd door deze \tot lijnen?}
\answer{Aantal rechthoeken}{\sol}

