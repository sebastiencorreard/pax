\title{Positief Negatief}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{pos=random(3..8)}
\integer{neg=random(3..8)}
\integer{tot=\pos+\neg}
\text{qlist=
negatieve getallen welke producten zijn,
positieve getallen welke producten zijn,
negatieve rationele getallen welke quoti&euml;nten zijn,
positieve rationele getallen welke quoti&euml;nten zijn
}

\integer{type=random(1..4)}
\text{question=item(\type,\qlist)}
\text{slist=\pos*\neg,\pos*(\pos-1)+\neg*(\neg-1),
2*\pos*\neg,2*(\pos*(\pos-1)+\neg*(\neg-1))}
\integer{sol=item(\type,\slist)}

\statement{Laat <i>S</i> een set zijn van \pos positieve integers en
\neg negatieve integers. <br>
De absolute waarde van deze \tot integers zijn priem getallen. <p>
Wat is het aantal \question van twee verschillende getallen uit <i>S</i>?}

\answer{Het aantal}{\sol}

