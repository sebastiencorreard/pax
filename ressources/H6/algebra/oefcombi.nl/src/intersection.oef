\title{Snijpunten I}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{sol=binomial(\tot,2)}

\statement{
In het platte vlak hebben twee rechte lijnen maximaal &eacute;&eacute;n snijpunt.
<br>
Hoeveel snijpunten zijn er maximaal tussen \tot rechte lijnen?
}
\answer{Maximaal aantal snijpunten}{\sol}

