\title{Paren}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{couple=random(3..5)}
\integer{man=random(\couple..7)}
\integer{woman=random(\couple..7)}
\integer{sol=factorial(\man)/factorial(\couple)/factorial(\man-\couple)*factorial(\woman)/factorial(\woman-\couple)}

\statement{
Op hoeveel manieren kunnen we een \couple  <em>hetero</em>paren vormen uit \man mannen en \woman vrouwen?
}
\answer{Aantal manieren}{\sol}



