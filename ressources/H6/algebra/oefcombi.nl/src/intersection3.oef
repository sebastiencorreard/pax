\title{Snijpunten III}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{coinc=random(3..8)}
\integer{sol=binomial(\tot,2)-binomial(\coinc,2)+1}
\statement{
In het platte vlak hebben twee rechte lijnen maximaal &eacute;&eacute;n snijpunt.
<br>
Hoeveel snijpunten zijn er maximaal tussen \tot rechte lijnen<br>
waarvan er \coinc door de oorsprong (0:0) gaan ?}
\answer{Maximaal aantal snijpunten}{\sol}