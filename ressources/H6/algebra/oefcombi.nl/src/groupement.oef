\title{Groepen leerlingen}
\language{nl}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{type=random(1..14)}
\integer{each=item(\type,2,4,3,2,5,2,6,3,4,2,7,3,5,8)}
\integer{grps=item(\type,4,2,3,5,2,6,2,4,3,7,2,5,3,2)}
\integer{tot=\each*\grps}
\integer{sol=factorial(\tot)/(factorial(\grps)*factorial(\each)^\grps)}

\statement{
Op hoeveel manieren kunnen we een klas van \tot leerlingen
opsplitsen in \grps groepjes van elk \each leerlingen?}

\answer{Aantal manieren}{\sol}



