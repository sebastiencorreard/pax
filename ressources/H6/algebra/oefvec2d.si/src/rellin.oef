\title{Linearna relacija}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{c11=random(2..10)*random(-1,1)}
\integer{c12=random(2..10)*random(-1,1)}
\integer{c13=random(2..10)*random(-1,1)}
\integer{c21=random(2..10)*random(-1,1)}
\integer{c22=random(2..10)*random(-1,1)}
\integer{c23=random(2..10)*random(-1,1)}

\statement{Dani so vektorji
<p><center>
 v<sub>1</sub> = (\c11,\c21),
 v<sub>2</sub> = (\c12,\c22),
 v<sub>3</sub> = (\c13,\c23).
</center> <p>

Poi¹èite 3 cela ¹tevila a,b,c, ki niso vsa enaka niè, tako da bo
<p><center>
	a v<sub>1</sub> + b v<sub>2</sub> + c v<sub>3</sub> = 0.
</center> <p>
}

\answer{a}{\sx}
\answer{b}{\sy}
\answer{c}{\sz}

\condition{©tevila a,b,c so cela in niso vsa enaka niè.}
{
abs(\sx)+abs(\sy)+abs(\sz)>0 and
abs(round(\sx)-(\sx))<=0 and
abs(round(\sy)-(\sy))<=0 and
abs(round(\sz)-(\sz))<=0
}

\condition{Linearni izraz je enak 0.}
{
(\c11)*(\sx)+(\c12)*(\sy)+(\c13)*(\sz)=0 and
(\c21)*(\sx)+(\c22)*(\sy)+(\c23)*(\sz)=0
}
