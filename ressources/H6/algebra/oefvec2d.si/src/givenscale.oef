\title{Dana skalarna produkta}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{mid=8}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=2*random(-\mid..\mid)}
\integer{a2=random(-\range..\range)}
\integer{b2=2*random(-\mid..\mid-2)+1}
\integer{a=random(1..\range)*random(-1,1)}
\integer{b=random(1..\range)*random(-1,1)}
\integer{A=\a1*\a+\b1*\b}
\integer{B=\a2*\a+\b2*\b}

\statement{Dana sta vektorja
<p><center>
v<sub>1</sub> = (\a1,\b1),
v<sub>2</sub> = (\a2,\b2).
</center> <p>
Doloèite vektor v z lastnostjo
<p><center>
	vv<sub>1</sub> = \A, in
	vv<sub>2</sub> = \B.
</center> <p>
}

\answer{v}{\a,\b}{type=vector}
