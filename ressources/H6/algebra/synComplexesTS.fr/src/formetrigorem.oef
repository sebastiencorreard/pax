\title{Module et argument remarquable}
\language{fr}
\range{-5..5}
\author{Hélène, Brion; Véronique, Royer}
\email{royer.veronique@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

/*** Les modules ***/
\matrix{vmod=1/3,1/2,1,2,3,sqrt(2)/3,sqrt(2)/2,sqrt(2),2*sqrt(2),3*sqrt(2),sqrt(3)/3,sqrt(3)/2,sqrt(3),2*sqrt(3),3*sqrt(3)}

/*** Table des coefficients en format texte ***/
\text{tabcoef=\(\frac{1}{3}),\(\frac{1}{2}),1,\(2),\(3),
\(sqrt(2)/3),\(sqrt(2)/2),\(sqrt(2)),\(2*sqrt(2)),\(3*sqrt(2)),
\(sqrt(3)/3),\(sqrt(3)/2),\(sqrt(3)),\(2*sqrt(3)),\(3*sqrt(3)),
\(sqrt(3)/6), \(sqrt(3)/4),\(sqrt(3)/2),\(sqrt(3)),\(3*sqrt(3)/2),
\(sqrt(6)/6),\(sqrt(6)/4),\(sqrt(6)/2),\(sqrt(6)),\(3sqrt(6)/2),
\(\frac{1}{2}),\(\frac{3}{4}),\(\frac{3}{2}),\(3),\(\frac{9}{2}),
\(sqrt(2)/6), \(sqrt(2)/4),\(sqrt(2)/2),\(sqrt(2)),\(3*sqrt(2)/2),
\(\frac{1}{3}),\(\frac{1}{2}),1,\(2),\(3),
\(sqrt(6)/6),\(sqrt(6)/4),\(sqrt(6)/2),\(sqrt(6)),\(3*sqrt(6)/2),
\(\frac{1}{6}),\(\frac{1}{4}),\(\frac{1}{2}),1,\(\frac{3}{2}),
\(sqrt(2)/6),\(sqrt(2)/4),\(sqrt(2)/2),\(sqrt(2)),\(3*sqrt(2)/2),
\(sqrt(3)/6),\(sqrt(3)/4),\(sqrt(3)/2),\(sqrt(3)),\(3*sqrt(3)/2)}

/*** Table des différents angles en format texte ***/
\text{tabangle=\(pi/6),\(pi/4),\(pi/3),
\(-pi/6),\(-pi/4),\(-pi/3),
\(5pi/6),\(3pi/4),\(2pi/3),
\(-5pi/6),\(-3pi/4),\(-2pi/3),
\(-pi/2),0,\(pi/2),\(pi)}

/*** Choix d'un module et d'un angle au hasard***/
\integer{nmod=random(1..15)}
\integer{axe=random(1..4)}
\if{\axe=1}{\integer{nanglefinal=random(13..16)}}
\if{\axe>1}{
	\integer{nangleinitial=random(1..3)}
	\integer{signangle=random(0,1)}
	\integer{obtus=random(0,1)}
	\integer{nanglefinal=\nangleinitial + 6*\obtus + 3*\signangle}
	}

/*** Ecriture de z en format text ***/
\if {\axe=1}{
	\text{tabaxe=- &nbsp; \tabcoef[\nmod]i,\tabcoef[\nmod],\tabcoef[\nmod]i,-\tabcoef[\nmod]}
	\if{\vmod[\nmod]=1}{\text{tabaxe=-i,1,i,-1}}
	\text{ztext=\tabaxe[\nanglefinal-12]}
		}
\if{\axe>1}{
	\text{signcos= ,- }
	\text{signsin=+ ,- }
	\text{valcos=\tabcoef[15*\nangleinitial+\nmod]}
	\text{valsin = \tabcoef[60-15*\nangleinitial+\nmod]}
	\if{\valsin=1}{\text{valsin= }}
	\text{ztext=\signcos[\obtus+1]&nbsp;\valcos \signsin[\signangle+	1]&nbsp;i &nbsp;\valsin}
	}

\steps{reply 1
reply 2}

    \statement{
    Soit le complexe \(z) tel que \(z = ) \ztext .
    <ul><li>
    On cherche le module de \(z).<br>
    \if{\step>1}{
       \if{\sc_reply1=1}
       {<span style="color:green"> Bien !</span><br>
       Le module de \(z) est bien \tabcoef[\nmod]}
       {<b><span style="color:red"> Non ! Le module de \(z) n'est pas
    \reply1.</span><br>
       Le module de \(z) vaut \tabcoef[\nmod]</b>}
       </li>
       <li> On cherche maintenant un argument de \(z).</li>
       }
    </li></ul>
    }

\answer{\(|z|)}{\vmod[\nmod]}{option=nonstop}
\answer{Un argument de \(z) est }{\nanglefinal;\tabangle}{type=checkbox}
\hint{
Soit \(z) de forme algébrique \(z = x + ) i\(y). Le module de |z| vaut : \(|z|=\sqrt{x^2+y^2}).<br>

\(z) s'écrit aussi sous forme trigonométrique \(z) = r(cos\(\theta) + i sin\(\theta)) avec \(r) réel positif.
<br>
On a alors : \(|z| = r ) &nbsp; et &nbsp; arg(\(z)) = \(\theta) modulo \(2\pi).
<br>
\(\theta) est une mesure de l'angle orienté \((\vec{u},\overrightarrow{OM})), où \(M) est le point d'affixe \(z).
<br>
On a aussi : cos\(\theta) = \(\frac{x}{|z|}) &nbsp; et &nbsp; sin\(\theta) = \(\frac{y}{|z|}).
}
