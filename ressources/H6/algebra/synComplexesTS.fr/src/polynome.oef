\title{Polynômes à coefficients complexes}
\author{Hélène, Brion ; Véronique, Royer}
\email{royer.veronique@orange.fr}
\computeanswer{yes}
\format{html}
\precision{100}

\integer{a1=random(-1,1)*randint(1..3)}
\integer{a=\a1}
\integer{b=random(-1,1)*randint(1..3)}
\integer{c=random(-1,1)*randint(1..3)}

/*** Choix de la version : version 1 racine imaginaire ci et coeff a et b réels, version 2 racine réelle c et coef a imaginaire***/
\integer{version=random(1,2)}
\if {\version =1}{\complex{c = (\c)*i}}
\if {\version =2}{\complex{a = (\a)*i}}
\text{nature=imaginaire,réelle}


/*** Calcul des coefficients ***/
\complex{d=simplify(\a - \c)}
\complex{e=simplify(\b -(\a)*(\c))}
\complex{f=simplify(-(\b)*(\c))}

/*** Racines de x^2+ax + b ***/

\integer{delta=(\a)^2-4*(\b)}
\if{\version=2}{\integer{delta = - (\a1)^2-4*(\b)}}
\if{\delta<0}{\complex{racine1 = (-(\a) + i*sqrt(-(\delta)))/2}
		\complex{racine2 = (-(\a) - i*sqrt(-(\delta)))/2}
		}

\if{\delta>0 or \delta=0}{\complex{racine1 = ((-\a) + sqrt((\delta)))/2}
		\complex{racine2 = ((-\a) - sqrt((\delta)))/2}
		}

/*** Indications ***/
\text{x=\(y),\(x)}
\text{poly=\(P(iy)),\(P(x))}
\text{racine=\(iy),\(x)}
\text{indic1= Prendre un réel \x[\version]. <br>Ecrire \poly[\version] sous forme algébrique et utiliser l'équivalence : \poly[\version] est nul si et seulement si sa partie réelle et sa partie imaginaire sont nulles. <br> En déduire \(x). La racine \nature[\version] est alors \racine[\version].}
\text{indic2= Développer \((z-\c)(z^2 + a z + b)) et identifier ses coefficients avec ceux de \(P(z)).}
\text{indic3=\version=1?Pour trouver les racines de \(z^2 + a z + b) &#58; calculer son discriminant \(Delta). On doit trouver \(Delta) =\delta.}
\text{indic3=\version=2?Pour trouver les racines de \(z^2 + a z + b) &#58; mettre le polynôme sous forme canonique \((z + \frac{a}{2})^2 - \frac{\Delta}{4}). On doit trouver \(Delta) = \delta.}
\text{indic = \indic1, \indic2, \indic3}
\steps{reply 1
reply 2,reply 3
reply 4,reply 5}

\statement{Soit \(P(z) = z^3+ (\d)z^2 + (\e)z + \f).

Le but de l'exercice est de trouver les racines de P.
<ul>
<li><b>ETAPE 1</b> : P possède une racine \nature[\version] \(r_1). Calculer \(r_1).
<div class="wimscenter">\(r_1 = )\embed{reply1,5}</div>
\if{\step > 1}{
	\if{\sc_reply1=1}{<span style="color:green"> Bien !</span>}
   {<span style="color:red"> Erreur... La bonne réponse est : \(r_1 = \c).} </span>
	</li><li><b>ETAPE 2</b> : Déterminer les complexes \(a) et \(b) tels que, pour tout complexe \(z), on ait :
	<div class="wimscenter">\(P(z) = (z-\c)(z^2 + a z + b)) &nbsp; avec &nbsp;
	\(a) = \embed{reply2, 5} et \(b) = \embed{reply3, 5}
 </div>
	}
\if{\step > 2}{<br>
	\if{\reply2=\a and \reply3=\b}{<span style="color:green"> Bien !</span>}
              {<span style="color:red"> Erreur... Les bonnes réponses sont : \(a = \a) et \(b = \b).</span>} <br>
	</li><li><b>ETAPE 3</b> : Déterminer alors les deux autres racines de P (éventuellement identiques).<br>
<span style="color:blue"><i>Donner comme première racine celle possédant la plus grande partie réelle, et en cas d'égalité, celle possédant la plus grande partie imaginaire.
On donnera des valeurs réelles décimales approchées à 0.01 près.</i></span>
  <div class="wimscenter"> r2= \embed{reply4, 15} et r3 = \embed{reply5, 15}</div>
	}
	</li></ul>
}
\answer{r1 }{\c}{option=nonstop}
\answer{a }{\a}{option=nonstop}
\answer{b }{\b}{option=nonstop}
\answer{r2 }{\racine1}
\answer{r3 }{\racine2}
\hint{\indic[\step]}

