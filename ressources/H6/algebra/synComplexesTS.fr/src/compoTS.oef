\title{Composée d'une translation et d'une symétrie centrale }
\language{fr}
\range{-5..5}
\author{Marie-Claude, David; Véronique, Royer}
\email{Marie-Claude.DAVID@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-5..5)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{d=random(-5..5)}

/*** Vecteur de translation***/
\complex{z1=simplify(\a+\b*i)}

/*** Centre, rapport de l'homothétie et expression complexe de l'homothétie***/
\complex{z2=simplify(\c+\d*i)}
\rational{A=-1}
\complex{B=simplify(2*(\z2))}

\text{liste=une translation, une symétrie centrale}

/***Selon la version, z'=Az+C est l'expression complexe de hot ou toh nommée f***/
\integer{version=random(1,2)}
\if {\version = 1} {\complex{C= simplify(-(\z1)+\B)}
	\text{f=s \circ t}}
\if {\version = 2} {\complex{C= simplify(\z1+\B)}
	\text{f=t \circ s}}

/*** Calcul de I affixe du point invariant ***/
\complex{I=simplify((\C)/2)}


/*** Exercice en 5 étapes (translation, homothétie, composée, point invariant, vérification)***/
\steps{reply 1,
reply 2,
reply 3, reply 4, reply 5
reply 6
reply 7, reply 8
}


\statement{<i>Cet exercice comporte cinq étapes.</i>
<p>On considère successivement plusieurs transformations du plan complexe, dont on va
 déterminer l'écriture complexe.
<ol>
<li>Soit \(t) la translation de vecteur \(u(\z1)).
L'écriture complexe de la translation \(t) est
\(z' = z + ) \embed{rep1, 7}
\if{\step>1}{<div class="wimscenter">
	\if{\sc_reply1=1}
         {<span class="oef_indgood"> Bonne réponse !}
         {<span class="oef_indbad"> Mauvaise réponse...}
        L'écriture complexe de \(t\) est \(z' = z + \z1\).</span></div>
        </li>
	<li>
	Soit \(s\) la symétrie centrale de centre \(C(\z2)). L'écriture complexe de \(s\) est \(z' = ) \(-z ) + \embed{rep2, 7}
	}
\if{\step>2}{<div class="wimscenter">
	\if{\sc_reply2=1}
         {<span class="oef_indgood"> Bonne réponse !}
         {<span class="oef_indbad"> Mauvaise réponse...}
        L'écriture complexe de \(s\) est \( z' = -z + \B\). </span></div> </li>
	<li>
	La composée \(f = \f\) est \embed{reply3,1}, \embed{reply3,2}. <br>
	L'écriture  complexe de la transformation \(f) est
	\(z' = ) \embed{rep4, 5}\(z )+ \embed{rep5, 7}
	}

\if{\step>3}{<div class="wimscenter">
	\if{\sc_reply3=1 and \sc_reply4=1 and \sc_reply5=1}
         {<span class="oef_indgood"> Bonne réponse !}
         {<span class="oef_indbad"> Mauvaise réponse...}
         \if{(\sc_reply3=0 and \sc_reply4=1) or (\sc_reply3=1 and \sc_reply4=0)}
         {<span class="oef_indbad">L'écriture complexe proposée est incompatible avec la nature de \(f\).}
         L'écriture complexe de la symétrie centrale \(f \) est \( z' = -z + \C\) .</span></div></li>
	<li>
	L'affixe \(z_I\) du centre \(I\) de \(f) est \(z_I = )\embed{rep6, 7}
	}

\if{\step>4}{<div class="wimscenter">
	\if{\sc_reply6=1}
         {<span class="oef_indgood"> Bonne réponse !}
         {<span class="oef_indbad"> Mauvaise réponse...}
         On a \(z_I = \I) .</span><div class="wimscenter">
         </li>
	<li> L'écriture complexe de la symétrie \(\sigma_I\) de centre \(I\) est
	\(z' = ) \embed{rep7, 5}\(z) + \embed{rep8, 7}
	}
</li></ol>
}

\answer{translation}{\z1}{type=complex}{option=nonstop}
\answer{ consth}{\B}{type=complex}{option=nonstop}
\answer{nature}{2;\liste}{type=radio}
\answer{ coeff}{\A}{type=complex}{option=nonstop}
\answer{ constf}{\C}{type=complex}{option=nonstop}
\answer{ zI}{\I}{type=complex}{option=nonstop}
\answer{ coeff1}{\A}{type=complex}
\answer{ constf1}{\C}{type=complex}

\feedback{\sc_reply7=0 or \sc_reply8=0}{<b>Les transformations \(f\) et \(\sigma_I\) sont égales, donc ont même écriture complexe.</b>}
