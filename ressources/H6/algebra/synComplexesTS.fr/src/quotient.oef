\title{Quotient de deux complexes}
\language{fr}
\range{-5..5}
\author{Hélène, Brion ; Véronique, Royer}
\email{royer.veronique@orange.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-5..5)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{d=random(-5..5)}
\integer{d= \d=0 and \c=0? randint(1..5)*random(1,-1)}
\rational{A=simplify((\a*\c + \b*\d)/((\c)^2+(\d)^2))}
\rational{B=simplify((\b*\c - \d*\a)/((\c)^2+(\d)^2))}
\rational{A1=simplify((\a*\c -\b*\d)/((\c)^2+(\d)^2))}
\rational{B1=simplify((\b*\c + \d*\a)/((\c)^2+(\d)^2))}
\rational{A2=simplify((\a*\c + \b*\d)/((\c)^2-(\d)^2))}
\rational{B2=simplify((\b*\c - \d*\a)/((\c)^2-(\d)^2))}
\complex{z1=simplify(\a+\b*i)}
\complex{z2=simplify(\c+\d*i)}


\statement{On pose \(z_1 = \z1) et \(z_2 = \z2).<br>

Calculer \((z_1)/(z_2)).
<div class="wimscenter">\((z_1)/(z_2)) = \embed{rep1, 5} + \embed{rep2, 5} i</div>

}

\answer{ partie réelle}{\A}{type=default}
\answer{ partie imaginaire }{\B}{type=default}
\feedback{\reply1 = \A1 and \reply2=\B1}{
<span style="color:red">Il faut multiplier par
le CONJUGUE</span>}
\feedback{\reply1 = \A2 and \reply2=\B2}{
<span style="color:red"> Au dénominateur on doit trouver \(c^2+d^2) et non \(c^2-d^2)</span>}
\hint{<span style="color:green">Pour calculer un quotient de deux complexes, on multiplie numérateur et dénominateur par le conjugué du dénominateur
<br> \((a+bi)/(c+di)=((a+bi)(c-di))/(c^2+d^2))</span>}
