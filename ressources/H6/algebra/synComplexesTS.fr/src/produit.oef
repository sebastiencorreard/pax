\title{Produit de deux complexes}
\language{fr}
\range{-5..5}
\author{Hélène, Brion ; Véronique, Royer}
\email{royer.veronique@orange.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-5..5)}
\integer{b=random(-5..5)}
\integer{c=random(-5..5)}
\integer{d=random(-5..5)}
\integer{A=simplify(\a*\c - \b*\d)}
\integer{B=simplify(\b*\c + \d*\a)}
\complex{z1=simplify(\a+\b*i)}
\complex{z2=simplify(\c+\d*i)}


\statement{On pose \(z_1 = \z1) et \(z_2 = \z2).<br>

Calculer \(z_1 times z_2).
<div class="wimscenter">\(z_1 times z_2) = \embed{rep1, 5} + \embed{rep2, 5} i</div>

}

\answer{ partie réelle}{\A}{type=default}
\answer{ partie imaginaire }{\B}{type=default}
