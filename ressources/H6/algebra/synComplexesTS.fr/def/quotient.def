!set title=Quotient de deux complexes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Hélène, Brion ; Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]

!ifval $val9=0 and $val8=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint( $(tmp0)*$(tmp1))]
!endif
tmp=!translate ";': to $     $ in ($val6*$val8 + $val7*$val9)/(($val8)^2+($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val7*$val8 - $val9*$val6)/(($val8)^2+($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val11=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val6*$val8 -$val7*$val9)/(($val8)^2+($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val12=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val7*$val8 + $val9*$val6)/(($val8)^2+($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val13=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val6*$val8 + $val7*$val9)/(($val8)^2-($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val7*$val8 - $val9*$val6)/(($val8)^2-($val9)^2)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val6+$val7*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in $val8+$val9*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
replytype1=default
replyname1=partie réelle
replygood1=$val10
replytype2=default
replyname2=partie imaginaire
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On pose 
!insmath z_1 = $val16
$() et 
!insmath z_2 = $val17
$().<br>		Calculer 
!insmath (z_1)/(z_2)
$().	<div class="wimscenter">
!insmath (z_1)/(z_2)
$() =  
!read oef/embed.phtml rep1, 5 
$() +  
!read oef/embed.phtml rep2, 5 
$() i</div>		
$()
!exit

:hint
$()<span style="color:green">Pour calculer un quotient de deux complexes, on multiplie numérateur et dénominateur par le conjugué du dénominateur	<br> 
!insmath (a+bi)/(c+di)=((a+bi)(c-di))/(c^2+d^2)
$()</span>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply1 = $val12 and $m_reply2=$val13
 <div class='oef_feedbacks'>	<span style="color:red">Il faut multiplier par	le CONJUGUE</span>
$()</div>
!endif
!ifval $m_reply1 = $val14 and $m_reply2=$val15
 <div class='oef_feedbacks'>	<span style="color:red"> Au dénominateur on doit trouver 
!insmath c^2+d^2
$() et non 
!insmath c^2-d^2
$()</span>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,13,14,15,16,17
embedcnt=2
