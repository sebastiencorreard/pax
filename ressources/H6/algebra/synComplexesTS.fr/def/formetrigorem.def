val7=\(\frac{1}{3}),\(\frac{1}{2}),1,\(2),\(3),	\(sqrt(2)/3),\(sqrt(2)/2),\(sqrt(2)),\(2*sqrt(2)),\(3*sqrt(2)),	\(sqrt(3)/3),\(sqrt(3)/2),\(sqrt(3)),\(2*sqrt(3)),\(3*sqrt(3)),	\(sqrt(3)/6), \(sqrt(3)/4),\(sqrt(3)/2),\(sqrt(3)),\(3*sqrt(3)/2),	\(sqrt(6)/6),\(sqrt(6)/4),\(sqrt(6)/2),\(sqrt(6)),\(3sqrt(6)/2),	\(\frac{1}{2}),\(\frac{3}{4}),\(\frac{3}{2}),\(3),\(\frac{9}{2}),	\(sqrt(2)/6), \(sqrt(2)/4),\(sqrt(2)/2),\(sqrt(2)),\(3*sqrt(2)/2),	\(\frac{1}{3}),\(\frac{1}{2}),1,\(2),\(3),	\(sqrt(6)/6),\(sqrt(6)/4),\(sqrt(6)/2),\(sqrt(6)),\(3*sqrt(6)/2),	\(\frac{1}{6}),\(\frac{1}{4}),\(\frac{1}{2}),1,\(\frac{3}{2}),	\(sqrt(2)/6),\(sqrt(2)/4),\(sqrt(2)/2),\(sqrt(2)),\(3*sqrt(2)/2),	\(sqrt(3)/6),\(sqrt(3)/4),\(sqrt(3)/2),\(sqrt(3)),\(3*sqrt(3)/2)
val8=\(pi/6),\(pi/4),\(pi/3),	\(-pi/6),\(-pi/4),\(-pi/3),	\(5pi/6),\(3pi/4),\(2pi/3),	\(-5pi/6),\(-3pi/4),\(-2pi/3),	\(-pi/2),0,\(pi/2),\(pi)
tmp0=!randint 1, 15

val9=$[rint($(tmp0))]
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
!if $val10=1 
tmp0=!randint 13, 16

val11=$[rint($(tmp0))]
!endif
!if $val10>1 
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
tmp0=!randitem 0,1

val13=$[rint($(tmp0))]
tmp0=!randitem 0,1

val14=$[rint($(tmp0))]
val11=$[rint($val12 + 6*$val14 + 3*$val13)]
!endif
!if $val10=1 
val15=- &nbsp; $(val7[$val9])i,$(val7[$val9]),$(val7[$val9])i,-$(val7[$val9])
!if $(val6[$val9])=1 
val15=-i,1,i,-1
!endif
val16=$(val15[$val11-12])
