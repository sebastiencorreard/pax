!set title=Lieux de points (conditions aléatoires)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Hélène, Brion
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=72
prevarcnt=71
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!record 1 to 4 of formulaire

val6=$(tmp0)
tmp0=!randint -3, 3

val7=$[rint($(tmp0))]
tmp0=!randint -3, 3

val8=$[rint($(tmp0))]
tmp0=!randint -3, -1,1..3

val9=$[rint($(tmp0))]
tmp0=!randint -3, -1,1..3

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7+$val8*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in $val7+$val9+($val8+$val10)*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=\frac{z-z_A}{z-z_B},\frac{z-z_B}{z-z_A},\frac{z-z_A}{z_B-z_A}
val15=$(val14[$val13])
val16=\(\frac{\pi}{2} + 2k\pi),\(\frac{\pi}{2} + k\pi),\(0 + k\pi),\(\pi + 2k\pi)
tmp0=!randint 1, 4

val17=$[rint($(tmp0))]
tmp0=!shuffle Exact,Bien,Juste,Bravo,Bonne réponse,Oui

val18=$(tmp0)
tmp0=!shuffle Erreur,Faux,Hélas,Inexact,Mauvaise réponse,Non

val19=$(tmp0)
tmp0=!randint 1, 3

val20=$[rint($(tmp0))]
tmp0=!randint 1, 3

val21=$[rint($(tmp0))]

!ifval $val21>1
val22=$val21
!else
val22=
!endif
tmp0=!randint 1, 3

val23=$[rint($(tmp0))]
val24=\(z_A),\(z_B),\(z_C)
val25=\([0;2\pi]),\([0;\pi]),\([0;\pi/2])
val26=$(val24[$val20]) + $val22 \(e^{i\theta}) avec \(\theta) appartenant à $(val25[$val23])
tmp0=!randint 1, 5

val27=$[rint($(tmp0))]
val28=\($val15) est réel,\($val15) est imaginaire pur, \(\left|$val15 \right| = 1), \( arg \left( $val15 \right)) = $(val16[$val17]),z = $val26
val29=une droite,un cercle
!if ($val13<3 and $val27=2) or ($val13=3 and $val27=3) or ($val13<3 and $val27=4 and $val17 < 3) or $val27=5 
val30=$[rint(2)]
!else
val30=$[rint(1)]
!endif
val31=un cercle, un cercle privé d'un point, un cercle privé de deux points, un demi-cercle,un quart de cercle
val32=une droite, une droite privée d'un point, une droite privée de deux points, un segment, une demi-droite
!if $val30=1 
val33=$val32
!if ($val13=3 and $val27<3) or $val27=3 
val34=$[rint(1)]
!endif
!if ($val13<3 and $val27=1) or	   ($val27=4 and $val13 = 3 and ($val17=2 or $val17=3)) 
val34=$[rint(2)]
!endif
!if $val13<3 and $val27=4 and $val17=3 
val34=$[rint(3)]
!endif
!if $val13<3 and $val27=4 and $val17=4 
val34=$[rint(4)]
!endif
!if $val13=3 and $val27=4 and ($val17=4 or $val17=1) 
val34=$[rint(5)]
!endif
!else
val33=$val31
!if $val27=3 or ($val27=5 and $val23=1) 
val34=$[rint(1)]
!endif
!if $val27=2 
val34=$[rint(2)]
!endif
!if $val27=4 and $val17=2 
val34=$[rint(3)]
!endif
!if ($val27=4 and $val17 = 1) or ($val27=5 and $val23=2) 
val34=$[rint(4)]
!endif
!if $val27=5 and $val23=3 
val34=$[rint(5)]
!endif
!endif
val35=A,B,C,aucun
val36=$[rint(4)]
!if $val27=1 and $val13=1 
val36=1,3
!endif
!if $val27=1 and $val13=2 
val36=2,3
!endif
!if $val27=1 and $val13=3 
val36=1,2,3
!endif
!if $val27=2 and $val13<>2 
val36=1
!endif
!if ($val27=2 and $val13=2) or ($val27=3 and $val13=3) 
val36=2
!endif
!if  $val13<3 and ($val27=3 or ($val27=4 and $val17>2)) 
val36=3
!endif
!if  $val13=3 and $val27=4 and $val17=3 
val36=2,3
!endif
!if $val30=1 
t_=!rawmath ($val10)/($val9)
val37=!exec pari print($t_)
t_=!rawmath -1/($val37)
val38=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val37)
val39=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val38)
val40=!exec pari print($t_)
t_=!rawmath ($val8)+($val10)*(.5) - (($val7)+($val9)*.5)*($val38)
val41=!exec pari print($t_)
val42=!rawmath $val37*x+$val39
val43=!rawmath $val38*x+$val40
val44=!rawmath $val38*x+$val41
val45=\( y = $val42),\(y = $val43),\(y = $val44)
!if $val27=1 or ($val27=4 and $val17>2) 
val46=$[rint(1)]
!endif
!if $val27=2 or ($val27=4 and $val17<3) 
val46=$[rint(2)]
!endif
!if $val27=3 
val46=$[rint(3)]
!endif
!else
val47=$[sqrt(($val9)^2+($val10)^2)]
val48=$[($val47)/2]
!if $val27=5 
val49=$(val35[$val20])
!else
!if $val13<3 
val49=C
!else
val49=A
!endif
!endif
val45=centre $val49 et rayon $val21,	   centre A et rayon $val47, centre C et rayon $val48 
!if $val27=5 
val46=$[rint(1)]
!else
!if $val13<3 
val46=$[rint(3)]
!else
val46=$[rint(2)]
!endif
!endif
!endif
val50=On rappelle que	<ul>	<li>Un argument de \(\frac{z_C-z_A}{z_B-z_A}) est une mesure de l'angle \( (\overrightarrow{AB};\overrightarrow{AC})).</li>	<li>Le complexe z est réel si et seulement z est nul ou arg(z) = \(0+k\pi) où \(k) est un entier relatif.</li>	<li>Le complexe z est imaginaire si et seulement z est nul ou arg(z) = \(\frac{\pi}{2}+k\pi) où \(k) est un entier relatif.</li>	</ul>
oefsteps=reply 1	reply 2	reply 3	reply 4 
nextstep=!nosubst reply 1	reply 2	reply 3	reply 4 
!readproc oef/steps.proc
replytype1=checkbox
replyoption1=nonstop 
replyname1=L'ensemble (E) est tout ou partie d'
replygood1=$val30;$val29
replytype2=checkbox
replyoption2=nonstop 
replyname2=l'ensemble (E) est
replygood2=$val34;$val33
replytype3=checkbox
replyoption3=nonstop 
replyname3=Les points de (E) sont
replygood3=$val36;$val35
replytype4=checkbox
replyoption4=shuffle 
replyname4=
replygood4=$val46;$val45
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val50

help=!nosubst $val6


!goto stat

!exit

:question
$()		Soient A(
!insmath z_A
$()) &nbsp;et&nbsp; B(
!insmath z_B
$()) deux points distincts du plan complexe. On appelle C(
!insmath z_C
$()) le milieu de [AB].<br>	On pose : <div class="wimscenter"> 
!insmath z_A = $val11
$() &nbsp;et&nbsp; 
!insmath z_B = $val12
$()</div>	On appelle (E) l'ensemble des points M(z) tels que :	<div class="wimscenter"> $(val28[$val27])</div>	<ul>	<li><b>ETAPE 1</b> : L'ensemble (E) est tout ou partie de :	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	<br>	
!if $m_step>1 
$()
!if $m_reply1=$(val29[$val30]) 
$()<span style="color:green"> $(val18[1]) ! </span> 
!else
$()	                   <span style="color:red"> $(val19[1])... L'ensemble (E) est tout ou partie d'$(val29[$val30]).</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 2</b> : L'ensemble (E) est plus précisément :	  <div class="wimscenter"> 
!read oef/embed.phtml reply2 
$()</div>		   
!endif
$()	
!if $m_step>2 
$()<br>	  
!if $m_reply2=$(val33[$val34]) 
$()<span style="color:green"> $(val18[2]) !</span>  
!else
$()	    <span style="color:red"> $(val19[2])...(E) est $(val33[$val34])</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 3</b> : Cocher dans la liste suivante tous les points appartenant à (E) :	  <div class="wimscenter"> 
!read oef/embed.phtml reply3 
$()</div>	   
!endif
$()	
!if $m_step>3 
$()<br>	  
!if $m_reply3=$(val35[$val36]) 
$()<span style="color:green"> $(val18[3]) !</span>  
!else
$()	    <span style="color:red"> $(val19[3])... Le(s) point(s) appartenant à (E) sont : $(val35[$val36])</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 4</b>: On rappelle que les points A et B ont pour affixe :	  <div class="wimscenter"> 
!insmath z_A = $val11
$() &nbsp;et&nbsp; 
!insmath z_B = $val12
$()</div>	  
!if $val30=1 
$()La droite support de (E) a pour équation : 
!else
$()	     Le cercle support de (E) a pour : 
!endif
$()	                   <div class="wimscenter">  
!read oef/embed.phtml reply 4 
$()</div>	   
!endif
$()	</li></ul>	
$()
!exit

