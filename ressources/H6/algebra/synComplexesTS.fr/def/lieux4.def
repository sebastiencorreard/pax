$()<span style="color:green"> $(val17[1]) ! </span> 
!else
$()	                   <span style="color:red"> $(val18[1])... L'ensemble (E) est tout ou partie d'$(val28[$val29]).</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 2</b> : L'ensemble (E) est plus précisément :	  <div class="wimscenter"> 
!read oef/embed.phtml reply2 
$()</div>		   
!endif
$()	
!if $m_step>2 
$()<br>	  
!if $m_reply2=$(val32[$val33]) 
$()<span style="color:green"> $(val17[2]) !</span>  
!else
$()	    <span style="color:red"> $(val18[2])...(E) est $(val32[$val33])</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 3</b> : Cocher dans la liste suivante tous les points appartenant à (E) :	  <div class="wimscenter"> 
!read oef/embed.phtml reply3 
$()</div>	   
!endif
$()	
!if $m_step>3 
$()<br>	  
!if $m_reply3=$(val34[$val35]) 
$()<span style="color:green"> $(val17[3]) !</span>  
!else
$()	    <span style="color:red"> $(val18[3])... Le(s) point(s) appartenant à (E) sont : $(val34[$val35])</span> 
!endif
$()	  <br>	  </li><li><b>ETAPE 4</b>: On rappelle que les points A et B ont pour affixe :	  <div class="wimscenter"> 
!insmath z_A = $val10
$() &nbsp;et&nbsp; 
!insmath z_B = $val11
$()</div>	  
!if $val29=1 
$()La droite support de (E) a pour équation : 
!else
$()	     Le cercle support de (E) a pour : 
!endif
