!endif
!if $val25=2 and $val13<>2 
val34=1
!endif
!if ($val25=2 and $val13=2) or ($val25=3 and $val13=3) 
val34=2
!endif
!if  $val13<3 and ($val25=3 or ($val25=4 and $val17>2)) 
val34=3
!endif
!if  $val13=3 and $val25=4 and $val17=3 
val34=2,3
!endif
!if $val28=1 
t_=!rawmath ($val10)/($val9)
val35=!exec pari print($t_)
t_=!rawmath -1/($val35)
val36=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val35)
val37=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val36)
val38=!exec pari print($t_)
t_=!rawmath ($val8)+($val10)*(.5) - (($val7)+($val9)*.5)*($val36)
val39=!exec pari print($t_)
val40=!rawmath $val35*x+$val37
val41=!rawmath $val36*x+$val38
val42=!rawmath $val36*x+$val39
val43=\(y = $val40),\(y = $val41), \(y = $val42)
!if $val25=1 or ($val25=4 and $val17>2) 
val44=$[rint(1)]
!endif
!if $val25=2 or ($val25=4 and $val17<3) 
val44=$[rint(2)]
!endif
!if $val25=3 
val44=$[rint(3)]
!endif
!else
val45=$[sqrt(($val9)^2+($val10)^2)]
val46=$[($val45)/2]
!if $val25=5 
val47=$(val33[$val18])
!else
!if $val13<3 
val47=C
!else
val47=A
!endif
!endif
val43=centre $val47 et rayon $val19,	   centre A et rayon $val45, centre C et rayon $val46 
!if $val25=5 
val44=$[rint(1)]
!else
!if $val13<3 
val44=$[rint(3)]
!else
val44=$[rint(2)]
!endif
!endif
!endif
