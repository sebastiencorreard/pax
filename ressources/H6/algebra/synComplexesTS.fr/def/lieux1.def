!if ($val13<3 and $val25=2) or ($val13=3 and $val25=3) or ($val13<3 and $val25=4 and $val17 < 3) or $val25=5 
val28=$[rint(2)]
!else
val28=$[rint(1)]
!endif
val29=un cercle, un cercle privé d'un point, un cercle privé de deux points, un demi-cercle,un quart de cercle
val30=une droite, une droite privée d'un point, une droite privée de deux points, un segment, une demi-droite
!if $val28=1 
val31=$val30
!if ($val13=3 and $val25<3) or $val25=3 
val32=$[rint(1)]
!endif
!if ($val13<3 and $val25=1) or	   ($val25=4 and $val13 = 3 and ($val17=2 or $val17=3)) 
