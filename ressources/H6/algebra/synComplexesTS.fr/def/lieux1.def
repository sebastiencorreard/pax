tmp0=!record 1 to 4 of formulaire

val6=$(tmp0)
tmp0=!randint -3, 3

val7=$[rint($(tmp0))]
tmp0=!randint -3, 3

val8=$[rint($(tmp0))]
tmp0=!randint -3, -1,1..3

val9=$[rint($(tmp0))]
tmp0=!randint -3, -1,1..3

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7+$val8*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in $val7+$val9+($val8+$val10)*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=\(\frac{z-z_A}{z-z_B}),\(\frac{z-z_B}{z-z_A}),\(\frac{z-z_A}{z_B-z_A})
val15=$(val14[$val13])
val16=\(\frac{\pi}{2} + 2k\pi),\(\frac{\pi}{2} + k\pi),\(0 + k\pi),\(\pi + 2k\pi)
tmp0=!randint 1, 4

val17=$[rint($(tmp0))]
tmp0=!randint 1, 3

val18=$[rint($(tmp0))]
tmp0=!randint 1, 3

val19=$[rint($(tmp0))]
tmp0=!randint 1, 3

val20=$[rint($(tmp0))]
tmp0=!randint 1, 3

val19=$[rint($(tmp0))]

!ifval $val19 >1 
val21= $val19
!endif
val22=\(z_A),\(z_B),\(z_C)
val23=\([0;2\pi]),\([0;\pi]),\([0;\pi/2])
val24=$(val22[$val18]) + $val21 \(e^{i\theta}) avec \(\theta) appartenant à $(val23[$val20])
tmp0=!randint 1, 5

val25=$[rint($(tmp0))]
val25=$[rint(1)]
val26=$val15 est réel, $val15 est imaginaire, Module de $val15 = 1, Argument de $val15 = $(val16[$val17]) où \(k) est un entier relatif,z = $val24
