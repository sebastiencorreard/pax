val32=$[rint(5)]
!endif
!else
val31=$val29
!if $val25=3 or ($val25=5 and $val20=1) 
val32=$[rint(1)]
!endif
!if $val25=2 
val32=$[rint(2)]
!endif
!if $val25=4 and $val17=2 
val32=$[rint(3)]
!endif
!if ($val25=4 and $val17 = 1) or ($val25=5 and $val20=2) 
val32=$[rint(4)]
!endif
!if $val25=5 and $val20=3 
val32=$[rint(5)]
!endif
!endif
val33=A,B,C,aucun
val34=$[rint(4)]
!if $val25=1 and $val13=1 
val34=1,3
!endif
!if $val25=1 and $val13=2 
val34=2,3
!endif
!if $val25=1 and $val13=3 
