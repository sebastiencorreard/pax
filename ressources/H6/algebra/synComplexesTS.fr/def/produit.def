!set title=Produit de deux complexes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Hélène, Brion ; Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6*$val8 - $val7*$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7*$val8 + $val9*$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6+$val7*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in $val8+$val9*i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
replytype1=default
replyname1=partie réelle
replygood1=$val10
replytype2=default
replyname2=partie imaginaire
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On pose 
!insmath z_1 = $val12
$() et 
!insmath z_2 = $val13
$().<br>		Calculer 
!insmath z_1 times z_2
$().	<div class="wimscenter">
!insmath z_1 times z_2
$() =  
!read oef/embed.phtml rep1, 5 
$() +  
!read oef/embed.phtml rep2, 5 
$() i</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=2
