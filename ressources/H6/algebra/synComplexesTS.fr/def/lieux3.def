val26=3
!endif
!if $val20=1 
t_=!rawmath ($val10)/($val9)
val27=!exec pari print($t_)
t_=!rawmath -1/($val27)
val28=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val27)
val29=!exec pari print($t_)
t_=!rawmath ($val8) - ($val7)*($val28)
val30=!exec pari print($t_)
t_=!rawmath ($val8)+($val10)*(.5) - (($val7)+($val9)*.5)*($val28)
val31=!exec pari print($t_)
val32=!rawmath $val27*x+$val29
val33=!rawmath $val28*x+$val30
val34=!rawmath $val28*x+$val31
val35=\(y = $val32), \(y = $val33),\(y = $val34)
!if $val16=3 
val36=$[rint(3)]
!endif
!else
val37=$[sqrt(($val9)^2+($val10)^2)]
