!set title=Polynômes à coefficients complexes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Hélène, Brion ; Véronique, Royer
email=royer.veronique@orange.fr
computeanswer=yes
precision=100

ansorder=r,r,r,r,r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 3

val6=$[rint($(tmp0)*$(tmp1))]
val7=$[rint($val6)]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 1, 3

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
!if $val10 =1 
t_=!rawmath ($val9)*i
t_=!exec pari print($t_)
val9=!mathsubst I=i in $t_
!endif
!if $val10 =2 
t_=!rawmath ($val7)*i
t_=!exec pari print($t_)
val7=!mathsubst I=i in $t_
!endif
val11=imaginaire,réelle
tmp=!translate ";': to $     $ in $val7 - $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in $val8 -($val7)*($val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
tmp=!translate ";': to $     $ in -($val8)*($val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
t_=!exec pari print($t_)
val14=!mathsubst I=i in $t_
val15=$[rint(($val7)^2-4*($val8))]
!if $val10=2 
val15=$[rint(- ($val6)^2-4*($val8))]
!endif
!if $val15<0 
t_=!rawmath (-($val7) + i*sqrt(-($val15)))/2
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
t_=!rawmath (-($val7) - i*sqrt(-($val15)))/2
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
!endif
!if $val15>0 or $val15=0 
t_=!rawmath ((-$val7) + sqrt(($val15)))/2
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
t_=!rawmath ((-$val7) - sqrt(($val15)))/2
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
!endif
val18=\(y),\(x)
val19=\(P(iy)),\(P(x))
val20=\(iy),\(x)
val21=Prendre un réel $(val18[$val10]). <br>Ecrire $(val19[$val10]) sous forme algébrique et utiliser l'équivalence : $(val19[$val10]) est nul si et seulement si sa partie réelle et sa partie imaginaire sont nulles. <br> En déduire \(x). La racine $(val11[$val10]) est alors $(val20[$val10]).
val22=Développer \((z-$val9)(z^2 + a z + b)) et identifier ses coefficients avec ceux de \(P(z)).

!ifval $val10=1
val23=Pour trouver les racines de \(z^2 + a z + b) &#58; calculer son discriminant \(Delta). On doit trouver \(Delta) =$val15.
!endif

!ifval $val10=2
val23=Pour trouver les racines de \(z^2 + a z + b) &#58; mettre le polynôme sous forme canonique \((z + \frac{a}{2})^2 - \frac{\Delta}{4}). On doit trouver \(Delta) = $val15.
!endif
val24=$val21, $val22, $val23
oefsteps=reply 1	reply 2,reply 3	reply 4,reply 5 
nextstep=!nosubst reply 1	reply 2,reply 3	reply 4,reply 5 
!readproc oef/steps.proc
replyoption1=nonstop 
replyname1=r1
replygood1=$val9
replyoption2=nonstop 
replyname2=a
replygood2=$val7
replyoption3=nonstop 
replyname3=b
replygood3=$val8
replyname4=r2
replygood4=$val16
replyname5=r3
replygood5=$val17
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $(val24[$m_step])


!goto stat

!exit

:question
$()Soit 
!insmath P(z) = z^3+ ($val12)z^2 + ($val13)z + $val14
$().		Le but de l'exercice est de trouver les racines de P.	<ul>	<li><b>ETAPE 1</b> : P possède une racine $(val11[$val10]) 
!insmath r_1
$(). Calculer 
!insmath r_1
$().	<div class="wimscenter">
!insmath r_1 = 
$() 
!read oef/embed.phtml reply1,5 
$()</div>	
!if $m_step > 1 
$()	 
!if $m_sc_reply1=1 
$()<span style="color:green"> Bien !</span> 
!else
$()	    <span style="color:red"> Erreur... La bonne réponse est : 
!insmath r_1 = $val9
$(). 
!endif
$() </span>	 </li><li><b>ETAPE 2</b> : Déterminer les complexes 
!insmath a
$() et 
!insmath b
$() tels que, pour tout complexe 
!insmath z
$(), on ait :	 <div class="wimscenter">
!insmath P(z) = (z-$val9)(z^2 + a z + b)
$() &nbsp; avec &nbsp;	 
!insmath a
$() =  
!read oef/embed.phtml reply2, 5 
$() et 
!insmath b
$() =  
!read oef/embed.phtml reply3, 5 
$()	 </div>	  
!endif
$()	
!if $m_step > 2 
$()<br>	 
!if $m_reply2=$val7 and $m_reply3=$val8 
$()<span style="color:green"> Bien !</span> 
!else
$()	               <span style="color:red"> Erreur... Les bonnes réponses sont : 
!insmath a = $val7
$() et 
!insmath b = $val8
$().</span> 
!endif
$() <br>	 </li><li><b>ETAPE 3</b> : Déterminer alors les deux autres racines de P (éventuellement identiques).<br>	<span style="color:blue"><i>Donner comme première racine celle possédant la plus grande partie réelle, et en cas d'égalité, celle possédant la plus grande partie imaginaire.	On donnera des valeurs réelles décimales approchées à 0.01 près.</i></span>	  <div class="wimscenter"> r2=  
!read oef/embed.phtml reply4, 15 
$() et r3 =  
!read oef/embed.phtml reply5, 15 
$()</div>	  
!endif
$()	 </li></ul>	
$()
!exit

:hint
$()$(val24[$m_step])
$()
