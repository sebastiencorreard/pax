\title{Dani vektorski produkt}
\language{si}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{mid=8}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=random(1..\range)*random(-1,1)}
\integer{c1=random(1..\range)*random(-1,1)}
\integer{a2=random(1..\mid)*random(-2,2)}
\integer{b2=2*random(-\mid..\mid-2)+1}
\integer{c2=random(1..\range)*random(-1,1)}
\integer{v1=\b1*\c2-\c1*\b2}
\integer{v2=\c1*\a2-\a1*\c2}
\integer{v3=\a1*\b2-\b1*\a2}
\integer{scal=\a1*\a2+\b1*\b2+\c1*\c2}

\statement{Dan je vektor u=(\a1,\b1,\c1). Doloèite neznani koordinati vektorja
v=(\a2,b,c) z lastnostjo
<p><center>
\(u\times v=(\v1,\v2,\v3)).
</center> <p>
}

\answer{b}{\b2}
\answer{c}{\c2}
