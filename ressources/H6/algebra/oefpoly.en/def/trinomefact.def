!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!shuffle 25

val7=$(tmp0)
tmp0=!randitem 1,-1,0,0

val8=$[rint($(tmp0))]
tmp0=!item 1 of $val7

tmp1=!randitem 2,-2

val9=$[rint((1+$(tmp0))*$(tmp1)+$val8)]
tmp0=!item 2 of $val7

tmp1=!randitem 2,-2

val10=$[rint((1+$(tmp0))*$(tmp1)+$val8)]
val11=$[rint($val9+$val10)]
val12=$[rint($val11/2)]
val13=$[rint($val9*($val10))]
val14=!rawmath x^2 + $val11*x + $val13
val15=$[rint(($val12)^2)]
val16=$[rint(abs($val13-$val15))]
val17=$[rint(sqrt($val16))]
val18=$[rint($val12+$val17)]
val19=$[rint($val12-$val17)]
val20=!rawmath x+$val18
val21=!rawmath x+$val19
val22=Step
val23=Factor
val24=We put the terms of \(x\) into a complete square
val25=We have
val26=Therefore
val27=Now we apply the formula
val28=Result
val29=You should enter the simplified expressions.
val30=Constant term of development of square
val31=Constant term in the square
val32=Compensation term
oefsteps=reply 1,reply 2	reply 3,reply 4	reply 5,reply 6 
nextstep=!nosubst reply 1,reply 2	reply 3,reply 4	reply 5,reply 6 
!readproc oef/steps.proc
