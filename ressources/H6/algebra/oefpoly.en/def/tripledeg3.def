!set title=Triple root deg 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

val8=$[rint($(tmp0))]
val9=$[0.001]
val10=and
val11=For which real values of the parameters,the polynomial,has a triple root
val12=The triple root
val13=is a triple root
val14=If \(r\) is a triple root of \(P\), then
val15=is therefore a (real) root of the polynomial
val16=where
replyname1=a
replygood1=?analyze 17
replyname2=b
replygood2=?analyze 18
replyname3=$val12 \(r\)
replygood3=?analyze 19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val11[1]) 
!insmath a
$() $val10 
!insmath b
$() $(val11[2])	<div class="wimscenter">	
!insmath P(X) = X^3 + $val8 a X^2 + b X + ($val7-a)
$()	</div>	$(val11[3])&nbsp;?
$()
!exit

:hint
$()$val14	<div class="wimscenter">
!insmath $val8\a=-3 r
$() ($val16 
!insmath \a=-(3/$val8) r
$()),	
!insmath b=3 r^2
$(), $val10	<p>	
!insmath -r^3=$val7-\a=$val7+(3/$val8) r
$().</p>	</div>
!insmath r
$() 	$val15 
!insmath $val7+(3/$val8)X+ X^3
$().	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs($val8*($val17)+3*($val19))<$val9 and	abs($val18-3*($val19)^2)<$val9 and	abs($val7-($val17)+($val19)^3)<$val9
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(r\) $val13

!exit

:stat
vsavelist=7,8,9,10,11,13,14,15,16,17,18,19
embedcnt=0
