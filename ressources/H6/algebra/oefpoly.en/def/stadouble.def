!set title=Root status deg 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=c
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=What is the type of roots of the following degree 2 polynomial
val8=Type of roots
val9=one real root and one complex non-real root,one real double root,one non-real double root,two simple real roots,two conjugate complex roots
val10=$(val9[1])
val11=$(val9[2])
val12=$(val9[3])
val13=$(val9[4])
val14=$(val9[5])
val15=$val11,$val13,$val14,$val10,$val12
tmp0=!randitem 1,2,3

val16=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,1

val17=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val18=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

tmp1=!randitem -1,1

val19=$[rint($(tmp0)*$(tmp1))]
val20=$[rint(($val18)^2*($val17))]
val21=$[rint(2*($val18)*($val19)*($val17))]
val22=$[rint(($val19)^2*($val17))]
tmp0=!randint 1, 10

val23=$[rint($(tmp0)*sign($val20))]

!ifval $val16=1
val22=$[rint($val22-($val23))]
!endif

!ifval $val16=2
val22=$[rint($val22+($val23))]
!endif

!ifval $val21>=0
val24=+$val21
!else
val24=$val21
!endif

!ifval $val22>=0
val25=+$val22
!else
val25=$val22
!endif
tmp0=!item $val16 of $val13,$val14,$val11

val26=$(tmp0)
choicename1=$val8
choicegood1=$val26
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7?	<div class="wimscenter">	
!insmath $val20 X^2 $val24 X $val25
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,20,24,25
embedcnt=0
