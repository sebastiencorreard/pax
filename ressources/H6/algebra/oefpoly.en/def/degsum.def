!set title=Degree of sum
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=c,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!item $val8 of $val7,$(tmp0)

val9=$[rint($(tmp1))]
tmp0=!randint 1, 6

val10=$[rint($(tmp0))]
tmp0=!item $val10 of  P(X)+ Q(X), P(X)- Q(X),	    P(X) Q( X), P(X) Q( X),	    P(Q(X)), Q(P(X))

val11=$(tmp0)
val12=$[rint(max($val7,$val9))]
tmp0=!item $val10 of $val12,$val12,$val7+$val9,$val7+$val9,$val7*$val9,$val7*$val9

val13=$[rint($(tmp0))]
val14=Let \(P(X)\) and \(Q(X)\) be two polynomials. Complete
val15=greater than or equal to a number d
val16=less than or equal to a number d
val17=equal to a number d
val18=If,then,is a polynomial of degree
val19=The degree is
val20=Where
val21=and

!ifval $val10<=2 and $val7=$val9
val22=$val16
!else
val22=$val17
!endif
replyname1=$val20 d
replygood1=$val13
choicename1=$val19
choicegood1=$val22
choicebad1=$val15,$val16,$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14:	<div class="wims_question">	$(val18[1]) 
!insmath deg(P)=$val7
$() $val21 
!insmath deg(Q)=$val9
$(),	$(val18[2]) 
!insmath $val11
$() $(val18[3]) ________.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11,14,18,21
embedcnt=0
