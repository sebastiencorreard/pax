!set title=Parametric multiplicity degree 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=26
prevarcnt=21
postvarcnt=4
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!makelist x for x=-20 to 20

tmp1=!shuffle $(tmp0)

val7=$(tmp1)
val8=$[rint(2)]
val9=$(val7[1])
tmp0=!item 1  to  4 of $val9,$val7

val7=$(tmp0)
tmp0=!makelist (x - y) for y in $val7

val10=$(tmp0)
tmp=!nonempty items 1,-1,2,-2,3,-3

tmp0=!randitem $tmp
tmp1=!translate internal , to * in $val10

val10=!rawmath $(tmp0)*$(tmp1)
tmp0=!randint 0, 2

val11=$[rint($(tmp0))]
t_=!replace internal \( by ( in P=$val10;cc=polcoeff(P,$val11);P+(m-cc)*x^$val11
tmp0=!exec pari $t_

val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in cc
tmp0=!exec pari $t_

val13=$[rint($(tmp0))]
val14=Find a value of \(m\) so that the following polynomial has a multiple root, and find this multiple root.
val15=WARNING
val16=This exercise does not accept approximative replies! There is always an integer solution. Find it.
val17=The multiple root
val18=is a multiple root of
val19=is not even a root of
val20=All wrong.
val21=is in fact a root of
val22=In order for it to be a multiple root, 
val23=must also be a root of the derivative of
val24=which is unfortunately not the case. Verify your computation.
replytype1=numeric
replyname1=\(m)
replygood1=?analyze 25
replytype2=numeric
replyname2=$val17
replygood2=?analyze 26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14	<div class="wimscenter">	
!insmath P(x) = $val12
$()	</div>	<div class="wims_instruction">	<strongo>$val15</strong>. $val16	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!mathsubst m=$val25 in $val12

val27=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val27,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val28=!rawmath $(tmp0)
evaltmp=$val27

evaltmp=!mathsubst x=($val26) in $evaltmp
tmp0=($evaltmp)
val29=$[$(tmp0)]
evaltmp=$val28

evaltmp=!mathsubst x=($val26) in $evaltmp
tmp0=($evaltmp)
val30=$[$(tmp0)]

!exit

:feedback
!ifval $val29 != 0
 <div class='oef_feedbacks'>	 
!insmath $val26
$() $val19 
!insmath $val27
$()&nbsp;! $val20	
$()</div>
!endif
!ifval $val29 = 0 and $val30 != 0
 <div class='oef_feedbacks'>	 
!insmath $val26
$() $val21 
!insmath P(x) = $val27
$(). $val22 
!insmath $val26
$()	 $val23 
!insmath P(x)
$(),	 $val24	
$()</div>
!endif

!exit

:test

!ifval $val29 = 0 and $val30 = 0
 condtest1=1
!else
 condtest1=0
!endif
condname1=\($val26) $val18 \($val27)

!exit

:stat
vsavelist=12,14,15,16,18,19,20,21,22,23,24,25,26
embedcnt=0
