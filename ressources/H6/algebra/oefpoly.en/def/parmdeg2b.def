!set title=Parametrized deg 2 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
val14=$[rint(($val10)^2*($val11)+($val10)*($val12)+($val13))]
!if $val14 = 0 
val13=$[rint($val13+sign($val13))]
val14=$[rint(($val10)^2*($val11)+($val10)*($val12)+($val13))]
!endif

!ifval $val7>0
val15=+$val7
!else
val15=$val7
!endif

!ifval $val8>0
val16=+$val8
!else
val16=$val8
!endif

!ifval $val9>0
val17=+$val9
!else
val17=$val9
!endif
val18=$[-(($val10)^2*($val7)+($val10)*($val8)+($val9))/($val14)]
val19=For which real value of the parameter,the polynomial,has a root equal to,Under the condition that
replyname1=\(m)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val19[1]) 
!insmath m
$() $(val19[2])	<div class="wimscenter">	
!insmath ($val11 m$val15)X^2 + ($val12 m$val16)X + ($val13 m$val17)
$()	</div>	$(val19[3]) 
!insmath $val10
$()&nbsp;? ($(val19[4]) 
!insmath $val11{}m$val15 \ne 0
$().)
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,15,16,17,19
embedcnt=0
