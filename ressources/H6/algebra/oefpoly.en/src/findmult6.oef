\title{Find multiple root degree 6}

\text{roots=shuffle(wims(makelist x for x=-20 to 20))}
\integer{mult=randint(2 .. 6 - 1)}
\text{rootm=\roots[1]}
\text{roots=item(1 .. 6,wims(makelist \rootm for x=1 to \mult),item(2..-1,\roots))}
\text{poly=wims(makelist (x - y) for y in \roots)}
\function{poly=randitem(1,-1,2,-2,3,-3)*wims(translate internal , to * in \poly)}
\function{dev=pari(\poly)}


































































































































































\text{name_statement=The following polynomial has a multiple root. Find this root}
\text{name_answer=The multiple root}










\statement{\name_statement.
<div class="wimscenter">
\(P(x) = \dev)
</div>
}
\answer{\name_answer}{\rootm}{type=number}

