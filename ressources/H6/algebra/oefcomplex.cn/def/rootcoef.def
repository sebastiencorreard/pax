!set title=根与系数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint(($val7)^2)]
replyname1=q
replygood1=$val8+0.25*p^2
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst 若 z=a+($val7)*$val6, P 的另一根是 w=a-($val7)*$val6. 因此 p=-2a, 或 a=-0.5*p. 而 q=z*w=a^2+($val7)^2=($val7)^2+0.25*p^2.


!goto stat

!exit

:question
$()设 P(X)=X<sup>2</sup>+pX+q 是实系数	p 和 q 的多项式. 已知 P 有虚部为 $val7 的复数根.	这时系数 p 与 q 间有一个关系.	把 q 作为 p 的函数表示此关系.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()若 z=a+($val7)*$val6, P 的另一根是 w=a-($val7)*$val6. 因此 p=-2a, 或 a=-0.5*p. 而 q=z*w=a^2+($val7)^2=($val7)^2+0.25*p^2.
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=0
