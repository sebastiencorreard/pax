!set title=二次重根
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
val7=<i>a</i>
val8=<i>b</i>
val9=<i>w</i>
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
val12=$[rint(-2*($val10))]
val13=$[rint(-2*($val11))]

!ifval $val13>0
val14=+$val13
!else
val14=$val13
!endif
val15=$[rint(($val10)^2-($val11)^2)]
val16=$[rint(2*($val10)*($val11))]

!ifval $val16>=0
val17=+$val16
!else
val17=$val16
!endif

!ifval $val11>=0
val18=+$val11
!else
val18=$val11
!endif
replyname1=$val9
replygood1=$val15$val17*i
replyname2=重根
replygood2=$val10$val18*i
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()对怎样的复数 $val9 多项式 <p><center>	X<sup>2</sup>+($val12$val14$val6)X+$val9	</center> <p>有重根?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,12,14
embedcnt=0
