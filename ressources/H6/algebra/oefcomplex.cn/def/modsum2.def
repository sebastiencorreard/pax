tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of +,-

val10=$(tmp0)
tmp0=!randint 2, 10

val11=$[rint($(tmp0))]
tmp0=!randint 2, 10

val12=$[rint($(tmp0))]
tmp0=!randint 10, 170

val13=$[rint($(tmp0))]
val14=$[sqrt($val11^2+$val12^2$val10 2*$val11*$val12*cos($val13*pi/180))]
