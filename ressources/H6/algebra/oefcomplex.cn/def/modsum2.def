replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 回忆余弦定理: 如果三角形三边之长是 <i>a,b,c</i>, 且用 <i>A</i> 表示 <i>a</i> 边的对角, 则<p><center> <i>a</i><sup>2</sup>&nbsp;=&nbsp;<i>b</i><sup>2</sup>+<i>c</i><sup>2</sup >-2<i>bc</i>&nbsp;cos(<i>A</i>)&nbsp;. </center>


!goto stat

!exit

:question
$()设 $val7 和 $val8 是满足	|$val7|=$val11, |$val8|=$val12 的两个复数, 且 Arg($val7/$val8)=$val13 度. 计算	$val7$val10$val8&nbsp;的模.
$()
!exit

:hint
$()回忆余弦定理: 如果三角形三边之长是 <i>a,b,c</i>, 且用 <i>A</i> 表示 <i>a</i> 边的对角, 则<p><center> <i>a</i><sup>2</sup>&nbsp;=&nbsp;<i>b</i><sup>2</sup>+<i>c</i><sup>2</sup >-2<i>bc</i>&nbsp;cos(<i>A</i>)&nbsp;. </center>
