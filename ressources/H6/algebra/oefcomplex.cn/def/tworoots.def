val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=纯虚数
val7=实数
val8=等于零
val9=既非实数也非纯虚数
val10=$val7,$val6,$val8,$val9
val11=<i>i</i>
val12=z<sub>1</sub>
val13=z<sub>2</sub>
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val7,$val6

val15=$(tmp0)
tmp0=!item $val14 of $val6,$val7

val16=$(tmp0)
choicename1=
choicegood1=$val16
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val12,$val13 是多项式	P(X)=X<sup>2</sup>+pX+q 的两个根, 其中 p 是$val15, q 是实数. 	假设 $val12 和 $val13 既非实数也非纯虚数.	则数 $val12-$val13 是 ____________.
$()
!exit

