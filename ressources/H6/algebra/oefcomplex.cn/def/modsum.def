!set title=和的模
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
val7=z<sub>1</sub>
val8=z<sub>2</sub>
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of +,-

val10=$(tmp0)
tmp0=!item $val9 of -,+

val11=$(tmp0)
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
tmp0=!randint $val12, $val12+10

val13=$[rint($(tmp0))]
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of 是,否

val15=$(tmp0)
tmp0=!randint $val13, $val12+$val13

tmp1=!randint $val12+$val13+1, $val12+$val13+6

tmp2=!item $val14 of $(tmp0),$(tmp1)

val16=$[rint($(tmp2))]
tmp0=!randint 1, 6

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val12,$val12,$val13,$val13,$val16,$val16

val18=$(tmp0)
tmp0=!item $val17 of $val13,$val16,$val12,$val16,$val13,$val12

val19=$(tmp0)
tmp0=!item $val17 of $val16,$val13,$val16,$val12,$val12,$val13

val20=$(tmp0)
choicename1=你的回答
choicegood1=$val15
choicebad1=是,否
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 三角形 3 条边的长度之间有什么关系?


!goto stat

!exit

:question
$()是否存在两个复数 $val7 和 $val8 使得	|$val7|=$val18, |$val8|=$val19, |$val7$val10$val8|=$val20?
$()
!exit

:hint
$()三角形 3 条边的长度之间有什么关系?
$()
!exit

