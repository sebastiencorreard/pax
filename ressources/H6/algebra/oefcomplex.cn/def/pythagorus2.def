val6=<i>i</i>
val7=z<sub>1</sub>
val8=z<sub>2</sub>
val9=1,      1,      2,3, 5, 7
val10=1,      2,      2,4,12,24
val11=sqrt(2),sqrt(5),sqrt(8),5,13,25
tmp0=!itemcnt $val9

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val12

val13=$[rint($(tmp0))]
