val14=$[$(tmp0)]
tmp0=!item $val13 of $val10

val15=$[$(tmp0)]
tmp0=!item $val13 of $val11

val16=$(tmp0)
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val14,$val15

val18=$(tmp0)
tmp0=!item $val17 of $val15,$val14

val19=$(tmp0)
replyname1=你的回答
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 考虑勾股定理! 辐角 Arg($val7) 与 Arg($val8) 之差是多少?


!goto stat

!exit

