!set title=分数 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=i
val7=1+$val6,-1-$val6,1-$val6,$val6-1
val8=1,-3,-1,3
tmp0=!randint 1, 8

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 1,1,2,2,3,3,4,4

val10=$[rint($(tmp0))]
tmp0=!item $val9 of 3,4,3,4,1,2,1,2

val11=$[rint($(tmp0))]
tmp0=!item $val10 of $val7

val12=$(tmp0)
tmp0=!item $val11 of $val7

val13=$(tmp0)
tmp0=!item $val10 of $val8

val14=$[rint($(tmp0))]
tmp0=!item $val11 of $val8

val15=$[rint($(tmp0))]
tmp0=!randint 20, 50

val16=$[rint($(tmp0))]
tmp0=!randint $val16-6, $val16+6

val17=$[rint($(tmp0))]
val18=$[2^(($val16-$val17)/2)]
val19=$[($val15*$val16-($val14*$val17)+1000)%8]
val20=$[$val18*cos($val19*pi/4)]
val21=$[$val18*sin($val19*pi/4)]

!ifval abs($val20)<0.000001
val20=$[0]
!endif

!ifval abs($val21)<0.000001
val21=$[0]
!endif
replyname1=Re(z)
replygood1=$val20
replyname2=Im(z)
replygood2=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()计算以下复数的实部与虚部	 
!insmath z={($val13)^{$val16}\over ($val12)^{$val17}}
$(). 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,16,17
embedcnt=0
