!set title=含有模的方程
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=3000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>i</i>
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val8>=0
val9=+$val8
!else
val9=$val8
!endif
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of +,-

val11=$(tmp0)
tmp0=!item $val10 of ,-

val12=$(tmp0)
val13=$[$val8]
val14=$[(($val7)^2-($val8)^2)/(2*($val7))]

!ifval ($val7>0 and $val10=1) or ($val7<0 and $val10=2)
val15=!rawmath $val14+($val13)*i
!else
val15=!rawmath 0+0*i
!endif
replyname1=z
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 在复数平面内, 原点以及对应于 $val12|z| 与 $val7$val9$val6 的点应该构成一个等腰三角形 (顶点在哪里, 为什么?).


!goto stat

!exit

:question
$()在复数 <b>C</b> 内解方程 z$val11|z|=$val7$val9$val6.	<p>(若你认为方程无解, 输入 <tt>0</tt> 或	<tt>0+0*i</tt>.)	
$()
!exit

:hint
$()在复数平面内, 原点以及对应于 $val12|z| 与 $val7$val9$val6 的点应该构成一个等腰三角形 (顶点在哪里, 为什么?).
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,11,12
embedcnt=0
