\title{两个根}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{impur=纯虚数}
\text{real=实数}
\text{zero=等于零}
\text{nor=既非实数也非纯虚数}
\text{choices=\real,\impur,\zero,\nor}
\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{type=random(1,2)}
\text{p=item(\type,\real,\impur)}
\text{good=item(\type,\impur,\real)}

\statement{设 \z1,\z2 是多项式
P(X)=X<sup>2</sup>+pX+q 的两个根, 其中 p 是\p, q 是实数. 
假设 \z1 和 \z2 既非实数也非纯虚数.
则数 \z1-\z2 是 ____________.}

\choice{}{\good}{\choices}
