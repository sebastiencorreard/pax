\title{和的模 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{type=random(1,2)}
\text{sign=item(\type,+,-)}
\integer{m1=random(2..10)}
\integer{m2=random(2..10)}
\integer{ang=random(10..170)}
\real{\m3=sqrt(\m1^2+\m2^2\sign 2*\m1*\m2*cos(\ang*pi/180))}

\statement{设 \z1 和 \z2 是满足
|\z1|=\m1, |\z2|=\m2 的两个复数, 且 Arg(\z1/\z2)=\ang 度. 计算
\z1\sign\z2&nbsp;的模.}

\answer{|\z1\sign\z2|}{\m3}
\hint{回忆余弦定理: 如果三角形三边之长是
<i>a,b,c</i>, 且用 <i>A</i> 表示
<i>a</i> 边的对角, 则<p><center>
<i>a</i><sup>2</sup>&nbsp;=&nbsp;<i>b</i><sup>2</sup>+<i>c</i><sup>2</sup
>-2<i>bc</i>&nbsp;cos(<i>A</i>)&nbsp;.
</center>}
