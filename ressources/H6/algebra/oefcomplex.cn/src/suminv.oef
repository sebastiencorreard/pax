\title{与倒数之和}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{sign=random(1,2)}
\text{right=item(\sign,-1,1)}
\text{X=X}
\text{z=z}
\integer{power=random(100..999)}
\integer{sol=\power%3=0?2:-1}
\integer{sol=\sign=1 or \power%2=0?\sol:-(\sol)}

\statement{设 \z 是使得 z+1/z=\right 的复数. 数
w=\z<sup>\power</sup>+\z<sup>-\power</sup>&nbsp;等于多少?}

\answer{Re(w)}{\sol}
\answer{Im(w)}{0}
