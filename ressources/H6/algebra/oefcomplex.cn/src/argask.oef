\title{求辐角}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\real{mod=sqrt((\a)^2+(\b)^2)}
\real{ar=\b>0?pi/2:-pi/2}
\real{at=\a=0?\ar:arctan(\b/(\a))}
\real{Arg=\a<0?\at+pi:\at}

\statement{给出复数 z=\a\B\i 的模与辐角.}

\answer{|z|}{\mod}
\answer{Arg(z)}{\arg}
\condition{\arg 是 z 的一个辐角}
    {abs((\arg-\Arg)/(2*pi)-round((\arg-\Arg)/(2*pi)))<0.0001}
