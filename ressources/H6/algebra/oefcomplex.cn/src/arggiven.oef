\title{已知辐角}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\real{mod=randint(1..100)/10}
\real{a1=randint(1..100)/10*random(-1,1)}
\integer{type=random(1,2)}
\real{arg=\type=1?\a1:\a1*pi}
\text{Arg=\type=1?\a1:\a1*pi}
\real{re=cos(\Arg)*\mod}
\real{im=sin(\Arg)*\mod}

\statement{设有复数 z, 满足 |z|=\mod, 辐角为 \Arg,
请计算 z 的实部和虚部.} 

\answer{Re(z)}{\re}
\answer{Im(z)}{\im}
