\title{单位根的和}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{n=random(6,6,3,5,7)}
\integer{minus=\n-1}
\integer{denom=\n=6?3:\n}
\integer{a=\n=3?random(2,4)}
\integer{a=\n=5?random(2,4,6,8)}
\text{a=\n=6?random(,-,5,7)}
\integer{a=\n=7?random(2,4,6,8,10,12)}
\integer{b=random(1..10)}
\text{b1=\b>1?\b:}
\integer{b2=\b+1}
\integer{b3=\b+2}
\integer{b4=\b+3}
\integer{b5=\b+4}
\integer{b6=\b+5}
\integer{b7=\b+6}
\text{sum=\n=3?w^{\b1}+w^{\b2}+w^{\b3}}
\text{sum=\n=5?w^{\b1}+w^{\b2}+w^{\b3}+w^{\b4}+w^{\b5}}
\text{sum=\n=6?w^{\b1}+w^{\b2}+w^{\b3}+w^{\b4}+w^{\b5}+w^{\b6}}
\text{sum=\n=7?w^{\b1}+w^{\b2}+w^{\b3}+w^{\b4}+w^{\b5}+w^{\b6}+w^{\b7}}
\text{addit=\n=3?X<sup>2</sup>+X+1:X<sup>\minus</sup>+....+X+1}

\statement{设 \(w=\cos{\a\pi\over \denom}+i\sin{\a\pi\over \denom}).
\(S=\sum) 的值是什么?}

\answer{Re(S)}{0}
\answer{Im(S)}{0}
\hint{<i>w</i> 是多项式 X<sup>\n</sup>-1 =
(X-1)(X<sup>\minus</sup>+....+X+1) 的根.}
