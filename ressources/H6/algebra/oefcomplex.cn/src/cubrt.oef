\title{立方根}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a=random(1..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\text{i=<i>i</i>}
\statement{求复数
z&nbsp;=&nbsp;\a\B\i 的立方根 w 的实部与虚部.}

\answer{Re(w)}{\re}
\answer{Im(w)}{\im}
\condition{Re(w<sup>3</sup>)=\a}{(\re)^3-3*(\re)*(\im)^2=\a}
\condition{Im(w<sup>3</sup>)=\b}{3*(\re)^2*(\im)-(\im)^3=\b}
