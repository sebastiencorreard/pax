\title{模的极值}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\real{mod=sqrt((\a)^2+(\b)^2)}
\integer{modz=random(1..99)}
\integer{type=random(1,2)}
\text{mum=item(\type,极大值,极小值)}
\real{sol=item(\type,\mod+\modz,abs(\mod-\modz))}

\statement{设 z 是有 |z|=\modz 的复数,
模 |\a\B\i+z| 的\mum是什么 ?}

\answer{模的\mum}{\sol}
