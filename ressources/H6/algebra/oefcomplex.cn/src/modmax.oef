\title{极大模}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{i=<i>i</i>}
\integer{a=random(-20..20)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\real{mod=sqrt((\a)^2+(\b)^2)}
\integer{modz=random(1..9)}
\real{re=\a*\modz/\mod}
\real{im=\b*\modz/\mod}

\statement{在所有满足 |z|=\modz 的复数 z 中, 找出使
\a\B\i+z 的模为最大的数.}

\answer{Re(z)}{\re}
\answer{Im(z)}{\im}
