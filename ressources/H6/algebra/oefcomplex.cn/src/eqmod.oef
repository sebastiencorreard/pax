\title{含有模的方程}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{3000}

\text{i=<i>i</i>}
\integer{a=random(1..20)*random(-1,1)}
\integer{b=random(2..20)*random(-1,1)}
\text{B=\b>=0?+\b:\b}
\integer{type=random(1,2)}
\text{sign=item(\type,+,-)}
\text{s2=item(\type,,-)}
\real{im=\b}
\real{re=((\a)^2-(\b)^2)/(2*(\a))}
\function{z=(\a>0 and \type=1) or (\a<0 and \type=2)?\re+(\im)*i:0+0*i}

\statement{在复数 <b>C</b> 内解方程 z\sign|z|=\a\B\i.
<p>(若你认为方程无解, 输入 <tt>0</tt> 或
<tt>0+0*i</tt>.)
}

\answer{z}{\z}
\hint{在复数平面内, 原点以及对应于
\s2|z| 与 \a\B\i 的点应该构成一个等腰三角形 (顶点在哪里, 为什么?).}
