\title{两个根 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{X=X}
\text{impur=纯虚数}
\text{real=实数}
\text{zero=等于零}
\text{nor=既非实数也非纯虚数}
\text{choices=\real,\impur,\zero,\nor}
\text{i=<i>i</i>}
\text{z1=z<sub>1</sub>}
\text{z2=z<sub>2</sub>}
\integer{c=random(2..8)*random(-1,1)}
\text{C=\c>0?+\c:\c}
\integer{type=random(1,2)}
\text{I=\type=2?\i:}
\integer{type2=random(1,2)}
\text{dir=\type2=1?&gt;100:&lt;-100}
\text{good=\type2=1?\impur:\real}

\statement{设 \z1,\z2 是多项式
P(X)=X<sup>2</sup>\C\I\X+q 的两个根, 其中 q\dir 是实数. 
假设 \z1 和 \z2 既非实数也非纯虚数.
则数 \z1-\z2 是 ____________数.}

\choice{}{\good}{\choices}
