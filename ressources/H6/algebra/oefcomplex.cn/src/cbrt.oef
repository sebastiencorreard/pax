\title{根的方幂和}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{sign=random(1,2)}
\text{st=item(\sign,+,-)}
\text{X=X}
\text{z=z}
\integer{power=random(100..999)}
\integer{sol=\power%3=0?2:-1}
\integer{sol=\sign=1 or \power%2=0?\sol:-(\sol)}
\text{style=random(使得 \z<sup>2</sup>\st\z+1=0 的复数,
    多项式 X<sup>2</sup>\st\X+1 的一个复根)}

\statement{设 \z 是\style. 数
w&nbsp;=&nbsp;\z<sup>\power</sup>+\z<sup>-\power</sup>&nbsp;等于什么?}

\answer{Re(w)}{\sol}
\answer{Im(w)}{0}
