:test

!ifval abs($val12)+abs($val13)+abs($val14)>0 and	abs(round($val12)-($val12))<=0 and	abs(round($val13)-($val13))<=0 and	abs(round($val14)-($val14))<=0	
 condtest1=1
!else
 condtest1=0
!endif
condname1=a,b,c 是不全为零的整数

!ifval ($val6)*($val12)+($val7)*($val13)+($val8)*($val14)=0 and	($val9)*($val12)+($val10)*($val13)+($val11)*($val14)=0	
 condtest2=1
!else
 condtest2=0
!endif
