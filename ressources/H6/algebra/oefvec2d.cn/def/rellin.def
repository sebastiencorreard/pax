replygood1=?analyze 12
replyname2=b
replygood2=?analyze 13
replyname3=c
replygood3=?analyze 14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()已知 3 个平面向量:	<p><center>	 v<sub>1</sub> = ($val6,$val9) ,	 v<sub>2</sub> = ($val7,$val10) ,	 v<sub>3</sub> = ($val8,$val11) ,	</center> <p>		求 3 个整数 a,b,c 使得	<p><center>	    a v<sub>1</sub> + b v<sub>2</sub> + c v<sub>3</sub> = 0 ,	</center> <p>	但是这些整数 a,b,c 必须不全为零.	
$()
