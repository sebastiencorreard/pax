\title{Suite arithmétique}
\language{fr}
\range{-5..5}
\author{Eric, Sénéchal}
\email{ericsen@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{100}
\integer{b=random(1..1000)}
\real{r=(\b/randitem(1,10,100,1000,10000))*randitem(-1,0,1)}
\integer{a=random(1..1000)}
\function{u=(\a+n*\r)}
\real{u0=evalue(\u,n=0)}
\real{u1=evalue(\u,n=1)}
\real{u2=evalue(\u,n=2)}
\real{u3=evalue(\u,n=3)}
\real{u4=evalue(\u,n=4)}

\statement{Voici les premiers termes d'une suite arithmétique :
 <div class="wimscenter">
 \(u_0) = \u0 ; \(u_1) = \u1 ; \(u_2) = \u2 ; \(u_3) = \u3 </div>
 Quelle est sa raison ? Quel est le terme suivant ?
<ul>
  <li>Raison = \embed{reply 1,10} </li>
  <li>\(u_4) = \embed{reply 2,10}.</li>
</ul>
}
\answer{Raison}{\r}{type=default}
\answer{\(u_4)}{\u4}{type=default}
