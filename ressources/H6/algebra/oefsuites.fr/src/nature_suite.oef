\title{Suite arithmétique ou géométrique ?}
\language{fr}
\range{-5..5}
\author{Eric, Sénéchal}
\email{ericsen@wanadoo.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\text{l=arithmétique, géométrique, constante, quelconque}
\real{q=randitem(0.1,0.2,0.5,1,1,1,1,1,2,5)}
\integer{r=randitem(0,0,0,-1,1,-2,2)}
\integer{a=random(1..1000)}

\real{u0=\a}
\real{u1=\u0*\q+\r}
\real{u2=\u1*\q+\r}
\real{u3=\u2*\q+\r}
\real{u4=\u3*\q+\r}
\if{\q=1 and \r=0}{\text{rep=3}}{\if{\q=1}{\text{rep=1}}{\if{\r=0}{\text{rep=2}}{\text{rep=4}}}}
\text{H=\rep issametext 2 ? \q}
\text{nature=\rep issametext 1 ? arithmétique}
\text{nature=\rep issametext 2 ? géométrique}
\text{test=\rep issametext 2 ? le rapport \(\frac{u_{n+1}}{u_n})}
\text{test=\rep issametext 1 ? la différence \(u_(n+1) - u_n)}
\text{H=\rep issametext 1 ? \r}
\text{fb=\rep issametext 1 or \rep issametext 2 ? r1
r2
r3}
\text{fb=\rep issametext 3 or \rep issametext 4 ? r1}
\steps{\fb}
\statement{
\if{\step=1}{Voici les premiers termes d'une suite numérique :
 <div class="wimscenter">
  \(u_0) = \u0 ; \(u_1) = \u1 ; \(u_2) = \u2 ; \(u_3) = \u3
 </div>
Elle est : \embed{reply1}}
\if{\step=2}{Voici les premiers termes d'une suite numérique :
<div class="wimscenter">
\(u_0) = \u0 ; \(u_1) = \u1 ; \(u_2) = \u2 ; \(u_3) = \u3
</div>
<div class="oef_indgood">
Ce sont bien les premiers termes d'une suite \nature car \test des termes consécutifs
est bien un nombre constant !</div>
Quelle est la raison de la suite ?}
\if{\step=3}{Voici les premiers termes d'une suite numérique :
<div class="wimscenter">
 \(u_0) = \u0 ; \(u_1) = \u1 ; \(u_2) = \u2 ; \(u_3) = \u3
</div>
<class="oef_indgood">
Vous avez pu vérifier que \test des termes consécutifs vaut toujours \H.
</span>
<div class="wimscenter"> C'est la raison de la suite !</div>
Quel est le terme suivant ?}}
\answer{}{\rep;\l}{type=menu}
\answer{Raison }{\H}{type=default}
\answer{\(u_4)}{\u4}{type=default}
