!set title=Suite arithmétique simple
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Sénéchal
email=ericsen@wanadoo.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 1000

val7=$[rint($(tmp0))]
val8=!rawmath ($val7+n*$val6)
evaltmp=$val8

evaltmp=!mathsubst n=(0) in $evaltmp
tmp0=($evaltmp)
val9=$[$(tmp0)]
evaltmp=$val8

evaltmp=!mathsubst n=(1) in $evaltmp
tmp0=($evaltmp)
val10=$[$(tmp0)]
evaltmp=$val8

evaltmp=!mathsubst n=(2) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
evaltmp=$val8

evaltmp=!mathsubst n=(3) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
evaltmp=$val8

evaltmp=!mathsubst n=(4) in $evaltmp
tmp0=($evaltmp)
val13=$[$(tmp0)]
replytype1=default
replyname1=Raison
replygood1=$val6
replytype2=default
replyname2=\(u_4)
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici les premiers termes d'une suite arithmétique :	<div class="wimscenter">	 
!insmath u_0
$() = $val9 ; 
!insmath u_1
$() = $val10 ; 
!insmath u_2
$() = $val11 ; 
!insmath u_3
$() = $val12 </div>	 Quelle est sa raison ? Quel est le terme suivant ?	<ul>	  <li>Raison =  
!read oef/embed.phtml reply 1,10 
$() </li>	  <li>
!insmath u_4
$() =  
!read oef/embed.phtml reply 2,10 
$().	</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,12
embedcnt=2
