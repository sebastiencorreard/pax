!set title=Suite arithmétique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Sénéchal
email=ericsen@wanadoo.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 1000

val6=$[rint($(tmp0))]
tmp=!nonempty items 1,10,100,1000,10000

tmp0=!randitem $tmp
tmp=!nonempty items -1,0,1

tmp1=!randitem $tmp
val7=$[($val6/$(tmp0))*$(tmp1)]
tmp0=!randint 1, 1000

val8=$[rint($(tmp0))]
val9=!rawmath ($val8+n*$val7)
evaltmp=$val9

evaltmp=!mathsubst n=(0) in $evaltmp
tmp0=($evaltmp)
val10=$[$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst n=(1) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst n=(2) in $evaltmp
tmp0=($evaltmp)
val12=$[$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst n=(3) in $evaltmp
tmp0=($evaltmp)
val13=$[$(tmp0)]
evaltmp=$val9

evaltmp=!mathsubst n=(4) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
replytype1=default
replyname1=Raison
replygood1=$val7
replytype2=default
replyname2=\(u_4)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici les premiers termes d'une suite arithmétique :	 <div class="wimscenter">	 
!insmath u_0
$() = $val10 ; 
!insmath u_1
$() = $val11 ; 
!insmath u_2
$() = $val12 ; 
!insmath u_3
$() = $val13 </div>	 Quelle est sa raison ? Quel est le terme suivant ?	<ul>	  <li>Raison =  
!read oef/embed.phtml reply 1,10 
$() </li>	  <li>
!insmath u_4
$() =  
!read oef/embed.phtml reply 2,10 
$().</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13
embedcnt=2
