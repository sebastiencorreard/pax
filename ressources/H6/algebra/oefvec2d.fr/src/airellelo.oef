\title{Aire de parallélogramme}


\text{name_instruction=Calculer l'aire du parallélogramme dans le plan cartésien
  dont les 4 sommets sont}
\text{name_hint=The area of the parallelogram is the length of the vector product
  of the two vectors representing two adjacent sides of the parallelogram.}
\text{name_answer=Aire}

\integer{mid=8}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=2*random(-\mid..\mid)}
\integer{a2=random(-\range..\range)}
\integer{b2=2*random(-\mid..\mid-2)+1}
\integer{x1=random(-\range..\range)}
\integer{y1=random(-\range..\range)}
\integer{x2=\x1+\a1}
\integer{y2=\y1+\b1}
\integer{x3=\x1+\a2}
\integer{y3=\y1+\b2}
\integer{x4=\x2+\a2}
\integer{y4=\y2+\b2}
\integer{aire=abs(\a1*\b2-\a2*\b1)}
\statement{\name_instruction
<div class="wimscenter">
 (\x1,\y1) , (\x2,\y2) , (\x3,\y3) , (\x4,\y4).
</div>
}
\answer{\name_answer}{\aire}
\hint{\name_hint}

