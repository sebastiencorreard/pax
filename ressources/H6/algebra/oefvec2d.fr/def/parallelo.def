!set title=Sommet de parallélogramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer l'aire du parallélogramme dans le plan cartésien	  dont les 4 sommets sont
val8=Calculez les coordonnées du quatrième sommet
val9=$[rint(8)]
val10=$[rint($val9*2)]
tmp0=!randint -$val9, $val9-2

val11=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val9, $val9

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val10, $val10

val13=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9-2

val14=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val15=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val16=$[rint($(tmp0))]
val17=$[rint($val15+$val11)]
val18=$[rint($val16+$val12)]
val19=$[rint($val15+$val13)]
val20=$[rint($val16+$val14)]
val21=$[rint($val17+$val13)]
val22=$[rint($val18+$val14)]
val23=$[rint(abs($val11*$val14-$val13*$val12))]
replytype1=vector
replyname1=\(D)
replygood1=$val19,$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">
!insmath A =($val15,$val16)
$(), 
!insmath B =($val17,$val18) 
$(), 
!insmath C =($val21,$val22)
$().</div>	$val8 
!insmath D
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,15,16,17,18,21,22
embedcnt=0
