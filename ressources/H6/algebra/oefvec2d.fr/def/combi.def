!set title=Combinaison
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soient, deux vecteurs dans le plan. Calculez le vecteur
val8=$[rint(8)]
val9=$[rint($val8*2)]
tmp0=!randint -$val8, $val8-2

val10=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val8, $val8

val11=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val12=$[rint($(tmp0))]
tmp0=!randint -$val8, $val8-2

val13=$[rint(2*$(tmp0)+1)]
tmp0=!randint 2, $val9

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, $val9

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
val16=$val14*v1 + $val15*v2
val17=$[rint($val10*$val14+$val12*$val15)]
val18=$[rint($val11*$val14+$val13*$val15)]
replytype1=vector
replyname1=\(v)
replygood1=$val17,$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $(val7[1])	  <div class="wimscenter">
!insmath v_1 = ($val10,$val11)
$(), 
!insmath v_2 = ($val12,$val13)
$().</div>	  $(val7[2])	  <div class="wimscenter">
!insmath v = $val16 
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,13,16
embedcnt=0
