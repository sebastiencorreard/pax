!set title=Aire de parallélogramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer l'aire du parallélogramme dans le plan cartésien	  dont les 4 sommets sont
val8=The area of the parallelogram is the length of the vector product	  of the two vectors representing two adjacent sides of the parallelogram.
val9=Aire
val10=$[rint(8)]
val11=$[rint($val10*2)]
tmp0=!randint -$val10, $val10-2

val12=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val13=$[rint(2*$(tmp0))]
tmp0=!randint -$val11, $val11

val14=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10-2

val15=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val16=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val17=$[rint($(tmp0))]
val18=$[rint($val16+$val12)]
val19=$[rint($val17+$val13)]
val20=$[rint($val16+$val14)]
val21=$[rint($val17+$val15)]
val22=$[rint($val18+$val14)]
val23=$[rint($val19+$val15)]
val24=$[rint(abs($val12*$val15-$val14*$val13))]
replyname1=$val9
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val8


!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	 ($val16,$val17) , ($val18,$val19) , ($val20,$val21) , ($val22,$val23).	</div>	
$()
!exit

:hint
$()$val8
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,16,17,18,19,20,21,22,23
embedcnt=0
