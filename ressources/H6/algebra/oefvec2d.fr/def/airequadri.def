!set title=Aire de quadrilatère
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer l'aire du quadrilatère \(A B C D) dans le plan cartésien	  dont les 4 sommets sont
val8=Vous pouvez couper le quadrilatère en 2 triangles et calculer	l'aire de chaque triangle par le produit vectoriel.
val9=Aire
val10=$[rint(5)]
val11=$[rint(13)]
tmp0=!randint $val10, $val11

val12=$[rint($(tmp0))]
tmp0=!randint $val10, $val11

val13=$[rint($(tmp0))]
tmp0=!randint -$val10, -$val11

val14=$[rint($(tmp0))]
tmp0=!randint $val10, $val11

val15=$[rint($(tmp0))]
tmp0=!randint -$val10, -$val11

val16=$[rint($(tmp0))]
tmp0=!randint -$val10, -$val11

val17=$[rint($(tmp0))]
tmp0=!randint $val10, $val11

val18=$[rint($(tmp0))]
tmp0=!randint -$val10, -$val11

val19=$[rint($(tmp0))]
val20=$[rint($val14-$val12)]
val21=$[rint($val15-$val13)]
val22=$[rint($val16-$val12)]
val23=$[rint($val17-$val13)]
val24=$[rint($val18-$val12)]
val25=$[rint($val19-$val13)]
val26=$[rint($val20*$val23-$val22*$val21)]
val27=$[rint($val22*$val25-$val24*$val23)]
val28=$[0.5*abs($val26+$val27)]
tmp0=!randitem 0,1

val29=$[rint($(tmp0))]

!ifval $val29=1
val30=$val14,$val15
!else
val30=$val18,$val19
!endif

!ifval $val29=1
val31=$val18,$val19
!else
val31=$val14,$val15
!endif
replyname1=$val9
replygood1=$val28
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val8


!goto stat

!exit

:question
$()	<div class="float_left spacer">	 
!read oef/draw.phtml 200,200 \
	 xrange -15,15	 yrange -15,15	 arrow -15,0,15,0,10,grey	 arrow 0,-15,0,15,10,grey	 linewidth 2	 polygon red,$val12,$val13,$val14,$val15,$val16,$val17,$val18,$val19	 linewidth 4	 points blue,$val12,$val13,$val14,$val15,$val16,$val17,$val18,$val19	 
$()	</div>	$val7	<div class="wimscenter">	 
!insmath A
$() = ($val12,$val13), 
!insmath B
$() = ($val30), 
!insmath C
$() = ($val16,$val17), 
!insmath D
$() = ($val31).	</div>	
$()
!exit

:hint
$()$val8
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,12,13,14,15,16,17,18,19,30,31
embedcnt=0
