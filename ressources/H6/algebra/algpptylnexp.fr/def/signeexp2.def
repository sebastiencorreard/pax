choicegood5=$val37
choicebad5=+,-
choiceoption6=noidontknow 
choicename6=Tableau de signes b.
choicegood6=$val38
choicebad6=+,-
choiceoption7=noidontknow 
choicename7=Tableau de signes
choicegood7=$val39
choicebad7=+,-
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On veut étudier en fonction de 
!insmath $val17
$() le signe de : 
!insmath $val19
$() .	  
!if $m_step=1 
$()	  <p>	  Pour ce faire, on commence par regarder si ce signe peut être déterminé de manière immédiate.	  </p>	  Sachant que 
!insmath e^{$val17}>0
$() pour tout réel $val17, on conclut que le signe de 
!insmath $val19
$()	   
!read oef/embed.phtml choice1 
$().	   
!endif
$()	  
!if $m_step=2 && $val24=1 
$()	    Le signe de 
!insmath f
$() ne pouvant pas être trouvé de manière immédiate,	    on résout l'inéquation : 
!insmath $val35
$().	   On peut écrire les équivalences suivantes :	    <div class="wimscenter">	      ($val35) 
!insmath \Longleftrightarrow
$() 
!insmath e^($val18)
$()  
!read oef/embed.phtml choice2 
$()  
!read oef/embed.phtml reply1,5 
$()	    </div><div class="wimscenter">	    
!insmath \Longleftrightarrow
$() 
!insmath $val18
$()  
!read oef/embed.phtml choice3 
$()  
!read oef/embed.phtml reply2,10 
$().	    </div><div class="wimscenter">	    
!insmath \Longleftrightarrow
$() 
!insmath $val17
$()  
!read oef/embed.phtml choice4 
$()  
!read oef/embed.phtml reply3 
$().	    </div>	   
!endif
$()	  
!if $m_step=2 && $val24=2 
$()	    <div>	    Sachant que 
!insmath e^{t}>0
$() pour tout réel 
!insmath t
$(),	    le signe de 
!insmath $val19
$() <span style="color:blue">$val26</span>.	    </div>	    On dresse alors le tableau de signes suivant :	    <table style="width:60%" class="wimsborder wimscenter">	    <tr>	    <td style="width:15%;">
!insmath $val17
$()</td>	    <td style="width:5%;">
!insmath -\infty
$()</td>	    <td style="width:75%;"></td>	    <td style="width:5%;"> 
!insmath +\infty
$()</td>	    </tr><tr>	    <td>
!insmath $val19
$()</td>	    <td></td>	    <td> 
!read oef/embed.phtml choice7 
$()</td>	    <td></td>	    </tr>	    </table>	   
!endif
$()	  
!if $m_step=3 && $val24=1 
$()	    <p>En résolvant 
!insmath $val35
$() on obtient :</p>	    <div class="wimscenter">
!insmath $val35
$() 
!insmath \Longleftrightarrow
$() 
!insmath $val17
$() $val28 
!insmath $val34
$()</font>.	    </div>	    Posons 
!insmath \alpha = $val34 
$().	    On dresse alors le tableau de signes suivant :	    <table style="width:75%" class="wimsborder wimscenter">	    <tr>	    <td style="width:15%;">
!insmath $val17
$()</td>	    <td style="width:40%;text-align:left">
!insmath -\infty
$()</td>	    <td style="width:5%;">
!insmath \,\alpha
$()</td>	    <td style="width:40%;text-align:right"> 
!insmath +\infty
$()</td>	    </tr><tr>	    <td>
!insmath $val19
$()</td>	    <td> 
!read oef/embed.phtml choice5 
$()</td>	    <td>0</td>	    <td> 
!read oef/embed.phtml choice6 
$()</td>	    </tr>	    </table>	   
!endif
$()	
$()
!exit

