language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c,c,r,c,r,c,r,c,c,c
varcnt=46
prevarcnt=45
postvarcnt=0
replycnt=3
choicecnt=7
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=ne peut pas être déterminé sans calcul supplémentaire,est toujours le signe +,est toujours le signe -
val7=positif,négatif,nul
tmp0=!randitem 1,-1

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
val10=$[rint($val9*$val8)]
tmp0=!randitem 1,-1

val11=$[rint($(tmp0))]
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
val13=$[rint($val12*$val11)]
tmp0=!randitem 1,-1

val14=$[rint($(tmp0))]
tmp0=!randint 1, 10

val15=$[rint($(tmp0)*$val14)]
tmp0=!randint -10, 10

val16=$[rint($(tmp0))]
tmp=!nonempty items x,t

tmp0=!randitem $tmp
val17=$(tmp0)

!ifval ($val13=0)
val18=!rawmath $val10$val17
!else
val18=!rawmath $val10$val17+$val13
!endif

!ifval ($val16=0)
val19=!rawmath  $val15*e^($val18)
!else
val19=!rawmath $val15*e^($val18) - $val16
!endif
val20=>

!ifval ($val15>0)
val21=$val20
!else
val21=<
!endif
t_=!rawmath $val16/$val15
val22=!exec pari print($t_)

!ifval ($val22=0)
val23=$(val7[3])
!endif

!ifval ($val22>0)
val23=$(val7[1])
!endif

!ifval ($val22<0)
val23=$(val7[2])
!endif

!ifval ($val23 issametext $(val7[1]))
val24=$[rint(1)]
!else
val24=$[rint(2)]
!endif
val25=$[rint(1)]
!if $val24=2 

!ifval ($val15 > 0)
val25=$[rint(2)]
!else
val25=$[rint(3)]
!endif
!endif
tmp0=!item $val25 of $val6

val26=$(tmp0)
val27=$[rint($val10*$val15)]

!ifval ($val27>0)
val28=$val20
!else
val28=<
!endif
val29=!rawmath ln($val22)

!ifval ($val10=1)
val30=!rawmath ln($val22)-$val13
!else
val30=!rawmath (ln($val22)-$val13)/($val10)
!endif

!ifval ($val10=-1)
val30=!rawmath $val13-ln($val22)
!endif

!ifval ($val13<0)
val31=+$val12
!else
val31=-$val13
!endif

!ifval ($val10=1)
val32=\ln($val22) $val31
!else
val32=\frac{\ln($val22) $val31}{$val10}
!endif

!ifval ($val10<0 || $val22=1)
val33=$[rint(1)]
!else
val33=$[rint(0)]
!endif
!if $val33=1 

!ifval ($val22=1)
t_=!rawmath -$val13/$val10
val34=!exec pari print($t_)
!endif

!ifval ($val22!=1 && $val10<0)
val34=\frac{$val13 - \ln($val22)}{$val9}
!endif

!ifval ($val22!=1 && $val10=-1)
val34=$val13 - \ln($val22)
!endif
!else
val34=$val32
!endif
val35=$val19 $val20 0
!if $val24=2 

!ifval ($val21 issametext <)
val36=$[rint(1)]
!else
val36=$[rint(2)]
!endif
!endif
!if $val24=1 

!ifval $val28 issametext <
val37=+
!else
val37=-
!endif

!ifval $val28 issametext <
val38=-
!else
val38=+
!endif
!endif
!if $val24=2 

!ifval $val36=2
val39=+
!else
val39=-
!endif
!endif
val40=la règle \(e^u $val21 v \Longleftrightarrow u $val21 ln(v)\)
!if $val24=1 
val41=choice2,reply1,choice3,reply2,choice4,reply3
val42=choice5,choice6
!else
val41=choice7
!endif
oefsteps=choice1	$val41	$val42 
nextstep=!nosubst choice1	$val41	$val42 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=nonstop 
replyname1=Deuxième question a2.
replygood1=$val22
replytype2=formal
replyoption2=nonstop 
replyname2=Deuxième question b2.
replygood2=$val29
replytype3=formal
replyweight3=2 
replyoption3=nonstop 
replyname3=Deuxième question c2.
replygood3=$val30
choiceoption1=noidontknow 
choicename1=Première question
choicegood1=$val26
choicebad1=$val6
choiceoption2=nonstop  noidontknow 
choicename2=Deuxième question a1.
choicegood2=$val21
choicebad2=<,>
choiceoption3=nonstop  noidontknow 
choicename3=Deuxième question b1.
choicegood3=$val21
choicebad3=<,>
