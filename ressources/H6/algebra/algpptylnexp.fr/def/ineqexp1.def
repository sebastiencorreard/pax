choicegood4=$val40
choicebad4=+,-
choicename5=Tableau de signes b.
choicegood5=$val41
choicebad5=+,-
choicename6=Tableau de signes
choicegood6=$val42
choicebad6=+,-
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On veut étudier en fonction de 
!insmath $val19
$() le signe de :	
!insmath f($val19) = $val22
$() .	Pour ce faire, on commence par résoudre l'inéquation 
!insmath $val36
$().	<p>	Résolvez l'inéquation sur papier libre	puis complétez les affirmations suivantes.	</p>	
!if $m_step=1 
$()	<ul><li>	On peut écrire l'équivalence suivante :	<div class="wimscenter">	  $val37 
!insmath \Longleftrightarrow e^{$val21}
$()	   
!read oef/embed.phtml choice1 
$()  
!read oef/embed.phtml reply1,5 
$()	</div>	</li><li>	On  
!read oef/embed.phtml reply2 
$() appliquer $val39 car	le deuxième membre de l'inéquation est  
!read oef/embed.phtml choice2 
$().	</li></ul>	 
!endif
$()	
!if $m_step=2 && $val27=1 
$()	<ul><li>	On peut écrire l'équivalence suivante :	<div class="wimscenter">	  $val37 
!insmath \Longleftrightarrow e^{$val21} $val24 $val25 
$()	</div>	</li>	<li>	 On peut appliquer $val39, car	le deuxième membre de l'inéquation est <span class="bold"$val26</span>.	</li>	<li>	En appliquant cette règle, on obtient :	<div class="wimscenter">	$val37 
!insmath \Longleftrightarrow $val19
$() 
!read oef/embed.phtml choice3 
$()  
!read oef/embed.phtml reply3 
$().</div>	</li></ul> 
!endif
$()	
!if $m_step=2 && $val27=2 
$()	<ul>	<li>On peut écrire l'équivalence suivante :	<div class="wimscenter">	 $val37 
!insmath \Longleftrightarrow e^($val21) $val24 $val25
$()	</div>	</li><li>	On <font color=blue>ne peut pas</font> appliquer $val39 , car	le deuxième membre de l'inéquation est <font color=blue>$val26</font>.	</li>	<li> Sachant que 
!insmath e^{t}>0
$() pour tout réel t, on conclut que	l'inéquation $val37  
!read oef/embed.phtml reply4 
$().	</li></ul> 
!endif
$()	
!if $m_step=3 && $val27=1 
$()	  <ul><li>	  En résolvant 
!insmath $val36
$() on obtient :	  <div class="wimscenter">
!insmath $val36
$() 
!insmath \Longleftrightarrow
$()	  
!insmath $val19
$() <font color=blue> $val29 
!insmath $val35
$()</font>.</div>	  </li>	  <li>	  Posons 
!insmath $val19 _{0} = $val35 
$(). On dresse alors le tableau de signes suivant :	  <table style="width:75%" class="wimscenter wimsborder">	  <tr>	  <td style="width:5%;text-align:center">
!insmath $val19
$()</td>	  <td style="width:45%;text-align:left">
!insmath -\infty
$()</td>	  <td style="width:5%;text-align:center">
!insmath $val19 _{0}
$()</td>	  <td style="width:45%;text-align:right"> 
!insmath +\infty
$()</td>	  </tr><tr>	  <td style="text-align:center">
!insmath f($val19)
$()</td>	  <td style="text-align:center"> 
!read oef/embed.phtml choice4 
$()</td>	  <td style="text-align:center">0</td>	  <td style="text-align:center"> 
!read oef/embed.phtml choice5 
$()</td>	  </tr>	  </table>	  </li></ul>	   
!endif
$()	  
!if $m_step=3 && $val27=2 
$()	  <ul>	  <li>En résolvant 
!insmath $val36
$() on obtient que l'inéquation	  
!if $val38=1 
$()n'a aucune solution 
!else
