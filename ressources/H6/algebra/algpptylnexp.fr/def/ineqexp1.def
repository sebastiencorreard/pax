val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=positif,négatif,nul
val7=10
val8=5
val9=x,u,z,t
tmp0=!randitem 1,-1

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val10)]
tmp0=!randitem 1,-1

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val14=$[rint($(tmp0))]
val15=$[rint($val14*$val13)]
tmp0=!randitem 1,-1

val16=$[rint($(tmp0))]
tmp0=!randint 1, $val8

val17=$[rint($(tmp0)*$val16)]
tmp0=!randint -$val7, $val7

val18=$[rint($(tmp0))]
tmp=!nonempty items $val9

tmp0=!randitem $tmp
val19=$(tmp0)

!ifval ($val15=0)
val20=!rawmath $val12$val19
!else
val20=!rawmath $val12$val19+$val15
!endif
tmp0=!texmath $val20

val21=$(tmp0)

!ifval ($val18=0)
val22=!rawmath  $val17*e^($val20)
!else
val22=!rawmath $val17*e^($val20) - $val18
!endif
val23=>

!ifval ($val17>0)
val24=$val23
!else
val24=<
!endif
t_=!rawmath $val18/$val17
val25=!exec pari print($t_)

!ifval ($val25=0)
val26=$(val6[3])
!endif

!ifval ($val25>0)
val26=$(val6[1])
!endif

!ifval ($val25<0)
val26=$(val6[2])
!endif

!ifval ($val26 issametext $(val6[1]))
val27=$[rint(1)]
!else
val27=$[rint(2)]
!endif
val28=$[rint($val12*$val17)]

!ifval ($val28>0)
val29=$val23
!else
val29=<
!endif

!ifval ($val25=1)
val30=0
!else
val30=ln($val25)
!endif

!ifval ($val12=1)
val31=!rawmath $val30-$val15
!else
val31=!rawmath ($val30-$val15)/($val12)
!endif

!ifval ($val12=-1)
val31=!rawmath $val15-$val30
!endif

!ifval ($val25=1)
tmp=!translate ";': to $     $ in $val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath $(tmp0)
!endif

!ifval ($val15<0)
val32=+$val14
!else
val32=-$val15
!endif

!ifval ($val12=1)
val33=\ln($val25) $val32
!else
val33=\frac{\ln($val25) $val32}{$val12}
!endif

!ifval ($val12<0 || $val25=1)
val34=$[rint(1)]
!else
val34=$[rint(0)]
!endif
!if $val34=1 

!ifval ($val25=1)
t_=!rawmath -$val15/$val12
val35=!exec pari print($t_)
!endif

!ifval ($val25!=1 && $val12<0)
val35=\frac{$val15 - \ln($val25)}{$val11}
!endif

!ifval ($val25!=1 && $val12=-1)
val35=$val15 - \ln($val25)
!endif
!else
val35=$val33
!endif
val36=f($val19) $val23 0
val37=\($val36\)
!if $val27=2 

!ifval ($val24 issametext <)
val38=$[rint(1)]
!else
val38=$[rint(2)]
!endif
!endif
val39=la règle \(e^u $val24 v \Longleftrightarrow u $val24 ln(v)\)
!if $val27=1 

!ifval $val29 issametext <
val40=+
!else
val40=-
!endif

!ifval $val29 issametext <
val41=-
!else
val41=+
!endif
!endif
!if $val27=2 

!ifval $val38=2
val42=+
!else
val42=-
!endif
!endif
!if $val27=1 
val43=choice3,reply3
val44=choice4,choice5
!else
val43=reply4
val44=choice6
!endif
oefsteps=choice1,reply1,reply2,choice2	$val43	$val44 
nextstep=!nosubst choice1,reply1,reply2,choice2	$val43	$val44 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=nonstop 
replyname1=Première question b.
replygood1=$val25
replytype2=menu
replyoption2=nonstop 
replyname2=Deuxième question a.
replygood2=$val27;peut,ne peut pas
