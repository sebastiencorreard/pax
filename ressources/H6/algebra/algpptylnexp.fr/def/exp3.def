!set title=Exponentielles et notation puissance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle x,y,z,u,v

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!randint 2, 15

val8=$[rint($(tmp0))]
tmp0=!shuffle 2,3,5,7,11,13

val6=$(tmp0)
tmp0=!item 1 of $val6

val9=$[rint($(tmp0))]
tmp0=!randitem -1,1

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val11=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val12=$[rint($(tmp0)*$val10)]

!ifval $val10=1
val13=$val9$val7+$val12
!else
val13=$val9$val7-$val11
!endif

!ifval $val10=1
val14=-$val9$val7-$val12
!else
val14=-$val9$val7+$val11
!endif
val15=$val8,$val8^{$val7},$val8^{$val13},e^{$val13},$val8 e^{$val7},\frac{1}{e^{$val13}},\frac{1}{$val8^{$val13}}
val16=ln($val8),$val7*ln($val8),ln($val8)($val13),$val13,$val7 + ln($val8),$val14,ln($val8)($val14)
tmp0=!randint 1, 7

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val15

val18=!rawmath $(tmp0)
tmp0=!item $val17 of $val16

val19=!rawmath $(tmp0)
replytype1=formal
replyname1=
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">	  On considère l'expression 
!insmath A = $val18 
$().	  Réécrire 
!insmath A
$() sous la forme exp(
!insmath B
$()).	<div class="wims_instruction">	exp désigne la fonction exponentielle de base e.	</div>	<div class="wimscenter">	<label for="reply1">
!insmath A 
$() = exp </label> ( 
!read oef/embed.phtml reply1,15 
$()).</div>	</div>
$()
!exit

:hint
$()	Les règles de calcul des exponentielles sont :	<div class="wimscenter">	
!insmath  e = exp(1)
$() et 
!insmath  e^x = exp( x )
$() <br>	
!insmath  a^x = e^{x ln(a)} = exp(x ln(a))
$() avec 
!insmath a > 0 
$() et 
!insmath  x \in \RR
$().	<br>	
!insmath \exp (a + b) = \exp(a) \times \exp(b) 
$()<br>	
!insmath \exp ( a - b ) = \frac{\exp(a)}{\exp(b)}
$()<br>	
!insmath \exp(n\times a) = \exp(a)^n 
$() <br>	
!insmath \exp(-a) = \frac{1}{\exp(a)} 
$()	</div>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 0=0
 <div class='oef_feedbacks'>	Voici un corrigé :<br>	
!if $val17=1 
$()
!insmath  $val8 = e^{\ln($val8)} = \exp(\ln($val8)) 
$() 
!endif
$()	
!if $val17=2 
$()Par définition de la fonction exponentielle de base 
!insmath $val8
$() : 
!insmath  $val8^{t} = e^{\ln($val8) \times t} = \exp( t \ln($val8))
$() . 
!endif
$()	
!if $val17=3 
$()Par définition de la fonction exponentielle de base 
!insmath $val8
$() : 
!insmath $val8^{t} = e^{\ln($val8) \times t} = \exp( \ln($val8) \times t)
$() .<br>	  Donc 
!insmath  $val8^{$val13} = \exp( \ln($val8) \times ($val13))
$(). 
!endif
$()	
!if $val17=4 
$() 
!insmath  e^{$val13} = \exp($val13) 
$() (notation puissance). 
!endif
$()	
!if $val17=5 
$()
!insmath $val8 = e^{\ln($val8)}
$() donc 
!insmath $val8 e^{$val7} = e^{\ln($val8)}\times e^{$val7} = e^{\ln($val8)+$val7} = \exp(\ln($val8)+$val7)
$() 
!endif
$()	
!if $val17=6 
$()
!insmath  \frac{1}{e^{$val13}} = e^{-($val13)} = \exp($val14)
$() 
!endif
$()	
!if $val17=7 
$()
!insmath  \frac{1}{$val8^{$val13}} = $val8^{-($val13)} = $val8^{$val14} = e^{\ln($val8)($val14)} = \exp(\ln($val8)($val14))
$() 
!endif
$()	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,8,13,14,17,18
embedcnt=1
