!set title=Simplifications de base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Simplifier l'expression suivante sous forme d'un entier relatif.
tmp0=!randint 1, 15

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

val8=$[rint($val7*$(tmp0))]
tmp0=!randint 2, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
val10=$[rint($val9*$val7)]
val11=$[rint($val9*$val8)]
val12=$[rint($val9+$val7)]
val13=$[rint($val9+$val8)]
val14=ln(1),e^0,ln(e),ln(e^$val8),e^(ln($val7)),$val9 ln(e^$val8),$val9 e^(ln($val7)), $val9 + ln(e^$val8),$val9 + e^(ln($val7)) 
val15=0,1,1,$val8,$val7,$val11,$val10,$val13,$val12
tmp=!nonempty items 1,2,3,4,4,5,5,6,6,7,7,8,8,9,9

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
tmp0=!item $val16 of $val14

val17=$(tmp0)
tmp0=!item $val16 of $val15

val18=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class=wims_question>$val6</div>	<div class="wimscenter"><label for="reply1">
!insmath $val17 
$() =</label>  
!read oef/embed.phtml reply1,8 
$().</div>	
$()
!exit

:hint
$()Evidemment, il faut penser à la réciprocité	des fonctions logarithme et exponentielle.	<div class="wimscenter">pour tout réel 
!insmath t>0
$() on a :	
!insmath  e^{\ln(t)} = t 
$().</div>	<div class="wimscenter">pour tout réel 
!insmath t
$() on a :	
!insmath  \ln(e^{t}) = t 
$().</div>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,17
embedcnt=1
