!ifval ($val12<0 && $val18=1)
tmp0=!item 2 of <,>

val21=$(tmp0)
!endif

!ifval ($val12<0 && $val18=2)
tmp0=!item 1 of <,>

val21=$(tmp0)
!endif
t_=!rawmath $val13/$val12
val22=!exec pari print($t_)
val23=$[rint($val7*$val12)]

!ifval ($val23>0)
val24=$val17
!endif

!ifval ($val23<0 && $val18=1)
tmp0=!item 2 of <,>

val24=$(tmp0)
!endif

!ifval ($val23<0 && $val18=2)
tmp0=!item 1 of <,>

val24=$(tmp0)
!endif
val25=!rawmath (exp($val22)-$val10)/($val7)

!ifval ($val10<0)
val26=+$val9
!else
val26=-$val10
!endif
val27=\frac{e^{$val22} $val26}{$val7}
val28=$val12*ln($val15) $val17 $val13 
