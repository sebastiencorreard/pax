tmp0=!randitem 1,-1

val12=$[rint($(tmp0))]
tmp0=!randint 1, 50

val13=$[rint($(tmp0)*$val12)]
tmp0=!randitem 1,10,100

val14=$[rint($(tmp0))]
val13=$[rint($val13*$val14)]
!if $val11<1 

!ifval ($val12=1)
val15=$[rint(0)]
!else
val15=$[rint(1)]
!endif
!endif
!if $val11>1 

!ifval ($val12=1)
val15=$[rint(1)]
!else
val15=$[rint(0)]
!endif
!endif

!ifval (/ isin $val11)
val16=($val11)
!else
val16=\times$val11
!endif
t_=!replace internal \( by ( in floor($val11)
tmp0=!exec pari $t_

val17=$[rint($(tmp0))]

!ifval ($val11>1)
tmp0=!randint 10, 50

tmp1=!randint 5, 12

val18=$[rint($(tmp0)*$val14*$val17^$(tmp1))]
!endif

!ifval ($val11>1 && $val15=0)
val18=$[rint($val13-$val18)]
!endif

!ifval ($val11>1 && $val15=0)
val19=$[rint(3)]
!endif

!ifval ($val11>1 && $val15=1)
val18=$[rint($val13+$val18)]
!endif

!ifval ($val11>1 && $val15=1)
val19=$[rint(2)]
!endif

!ifval ($val11<1)
tmp0=!randitem 10,100,1000,1000,10^4

t_=!rawmath 1/$(tmp0)
val18=!exec pari print($t_)
!endif

!ifval ($val11<1)
tmp0=!randitem 10^-(1),10^(-2),10^(-3),10^(-4),10^(-5)

t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
!endif

!ifval ($val11<1 && $val12=-1)
t_=!rawmath -$val18
val18=!exec pari print($t_)
!endif

!ifval ($val11<1)
val19=$[rint(1)]
!endif

!ifval $val15=0
val20=<,>
!endif
tmp0=!randitem <,>

val20=$(tmp0)
tmp0=!positionof item $val20 in <,>

val21=$(tmp0)
val22=$val13*log($val11)

!ifval ($val13>0)
val23=$val20
!endif

!ifval ($val13<0 && $val21=1)
tmp0=!item 2 of <,>

val23=$(tmp0)
!endif

!ifval ($val13<0 && $val21=2)
tmp0=!item 1 of <,>

val23=$(tmp0)
!endif

!ifval ($val22>0)
val24=$val20
!endif

!ifval ($val22<0 && $val21=1)
tmp0=!item 2 of <,>

val24=$(tmp0)
!endif

!ifval ($val22<0 && $val21=2)
tmp0=!item 1 of <,>

val24=$(tmp0)
!endif

!ifval ($val24 issametext <)
val25=\le
!else
val25=\ge
!endif

!ifval ($val13=1)
val26=$val16^{n} 
!else
val26=$val13 $val16^{n}
!endif
val27=$val26 $val20 $val18 

!ifval ($val24 issametext <)
