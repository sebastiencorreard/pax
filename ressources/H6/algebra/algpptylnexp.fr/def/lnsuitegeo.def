val30=!exec pari print($t_)
val31=$[log($val18/$val13)/log($val11)]

!ifval ($val28=1)
t_=!replace internal \( by ( in  floor($val31)
tmp0=!exec pari $t_

val31=$[rint($(tmp0))]
!else
