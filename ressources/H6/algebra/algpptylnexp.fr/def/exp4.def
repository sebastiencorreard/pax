!set title=Réécrire avec une seule exponentielle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items x,t,y,a

tmp0=!randitem $tmp
val6=$(tmp0)
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val7=$[rint($val8*$val7)]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*$val6+$val9
tmp0=!exec pari $t_

val10=$(tmp0)
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
tmp1=!randint 2, 5

val11=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[rint($(tmp0))]
tmp0=!texmath $val10

val12=$(tmp0)
tmp0=!texmath $val11

val13=$(tmp0)
tmp=!nonempty items 2,3,5,7,11,13,17,19,23

tmp0=!randitem $tmp
val14=$(tmp0)
tmp0=!randint 1, 3

val15=$[rint($(tmp0))]
tmp0=!item $val15 of (e^($val10))/($val14),$val14*e^($val10),($val14*e^($val10))^($val11)

val16=$(tmp0)
tmp0=!item $val15 of \frac{e^{$val12}}{$val14},$val14\times e^{$val12},\left($val14\times e^{$val12}\right)^{$val13}

val17=$(tmp0)
t_=!replace internal \( by ( in ($val11)*($val10)
tmp0=!exec pari $t_

tmp1=!item $val15 of $val10-ln($val14),$val10+ln($val14),$(tmp0)+($val11)*ln($val14)

val18=$(tmp1)
replytype1=algexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">	Écrire 
!insmath $val17
$() sous la forme 
!insmath e^{u($val6)}
$(), où l'exposant 
!insmath u($val6)
$() est développé :	<div class="wimscenter">	
!insmath $val17
$() = 
!insmath e
$()&nbsp;<sup> 
!read oef/embed.phtml reply 1,10 
$()</sup>	</div>	</div>	
$()
!exit

:hint
$()	Pour tout réel 
!insmath a
$() strictement positif, il existe une unique réel 
!insmath b
$()	tel que 
!insmath a = exp(b) = e^{b}
$().	<br>	On nomme ce réel 
!insmath b
$() le logarithme néperien de 
!insmath a
$() ; on le note 
!insmath ln(a)
$() ou ln&nbsp;a .	<br>Tout réel 
!insmath a
$() strictement positif peut donc s'écrire 
!insmath a = e^{\ln(a)}
$().	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,17
embedcnt=1
