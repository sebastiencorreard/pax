!set title=Réécriture avec des exponentielles (2)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, Royer
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle x,y,z,u,v

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!shuffle 2,3,5,7,11,13

val6=$(tmp0)
tmp0=!item 1 of $val6

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!item 2 of $val6

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in ($val9*$val7)+($val10*$val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)
val12=!rawmath $val9*$val7
tmp=!translate ";': to $     $ in -($val9*$val7)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val9*$val7)+($val10*$val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val9*$val7)-($val10*$val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=!rawmath $(tmp0)
val16=exp($val7)^$val9*exp($val8)^$val10,exp($val7)^$val9,1/((exp($val7))^$val9),exp($val9*$val7)*exp($val10*$val8),(exp($val9*$val7))/(exp($val10*$val8))
val17=$val11,$val12,$val13,$val14,$val15
tmp0=!randint 1, 5

val18=$[rint($(tmp0))]
tmp0=!item $val18 of $val16

val19=!rawmath $(tmp0)
tmp0=!item $val18 of $val17

val20=!rawmath $(tmp0)
replytype1=formal
replyname1=
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">	On donne 
!insmath A = $val19 
$(), où exp désigne la fonction exponentielle.	<p>	Réécrire 
!insmath A
$() sous la forme exp(
!insmath p
$()), où 
!insmath p
$() est	une expression sans exponentielle.	</p>	<div class="wimscenter">	<label for="reply1">
!insmath A 
$() = exp </label> ( 
!read oef/embed.phtml reply1,15 
$()).</div>	</div>
$()
!exit

:hint
$()	Les règles de calcul des exponentielles sont :	<div class="wimscenter">	
!insmath \exp (a + b) = \exp(a) \times \exp(b) 
$()<br>	
!insmath \exp ( a - b ) = \frac{\exp(a)}{\exp(b)}
$()<br>	
!insmath \exp(n\times a) = \exp(a)^n 
$() <br>	
!insmath \exp(-a) = \frac{1}{\exp(a)} 
$()	</div>	
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=19
embedcnt=1
