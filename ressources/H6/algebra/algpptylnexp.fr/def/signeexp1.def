val6=Étudier en fonction de \(x\) le signe de l'expression 
tmp=!trim Commencer, si besoin, par mettre en facteur	Se souvenir qu'une exponentielle est toujours strictement positive.	On est alors ramené à l'étude du signe d'une expression de la forme
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 0,1

tmp1=!randint 1, 4

val8=$[rint((-1)^$(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val9=$[rint($(tmp0))]
t_=!rawmath -$val9/$val8
val10=!exec pari print($t_)
tmp=!translate ";': to $     $ in $val8 *x + $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val9=$[rint($(tmp0))]
t_=!rawmath -$val9/$val8
val10=!exec pari print($t_)
val11=!rawmath $val8 *x + $val9
tmp=!translate ";': to $     $ in $val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)

!ifval $val8>0
val12=-
!else
val12=+
!endif

!ifval $val8>0
val13=+
!else
val13=-
!endif
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]
t_=!replace internal \( by ( in ($val11)*e^($val14*x+$val15)
tmp0=!exec maxima $t_

val16=!rawmath $(tmp0)
t_=!replace internal \( by ( in e^($val14*x+$val15)
tmp0=!exec maxima $t_

val17=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val16)
tmp0=!exec maxima $t_

val18=!rawmath $(tmp0)
tmp0=!randint -10, 10

val19=$[rint($(tmp0))]
tmp0=!randint -10, 10

val20=$[rint($(tmp0))]
val21=$[rint($val8 - $val19)]
val22=$[rint($val9 - $val20)]
val23=$[rint($val8 + $val19)]
val24=$[rint($val9 + $val20)]
t_=!replace internal \( by ( in ($val19*x + $val20)*e^($val14*x+$val15)
tmp0=!exec maxima $t_

val25=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val21*x + $val22)*e^($val14*x+$val15)
tmp0=!exec maxima $t_

val26=!rawmath $(tmp0)
t_=!replace internal \( by ( in ($val23*x + $val24)*e^($val14*x+$val15)
tmp0=!exec maxima $t_

val27=!rawmath $(tmp0)
tmp0=!randint 1, 4

val28=$[rint($(tmp0))]
tmp0=!item $val28 of $val16,$val18,$val26 + $val25, $val27 -$val25

val29=!rawmath $(tmp0)
t_=!rawmath -$val9/$val8
val30=!exec pari print($t_)
val31=-,+,0
val32=-,+,0
val33=-,+,0

