\title{Réécrire avec une seule exponentielle}
!!!! les exposants
\text{x=randitem(x,t,y,a)}
\integer{m1=randint(1..5)}
\integer{s1=randitem(1,-1)}
\integer{m1=\s1*\m1}
\integer{p1=randint(-5..5)}
\text{u=pari(\m1*\x+\p1)}
\integer{v=randitem(-1,1)*randint(2..5)}
\integer{v=simplify(\v)}
\text{tu=texmath(\u)}
\text{tv=texmath(\v)}
!!! les bases ; les expressions
\text{nb=randitem(2,3,5,7,11,13,17,19,23)}
\integer{ind=randint(1..3)}
\text{exp=item(\ind,(e^(\u))/(\nb),\nb*e^(\u),(\nb*e^(\u))^(\v))}
\text{ppexp=item(\ind,\frac{e^{\tu}}{\nb},\nb\times e^{\tu},\left(\nb\times e^{\tu}\right)^{\tv})}
\text{sol=item(\ind,\u-ln(\nb),\u+ln(\nb),pari((\v)*(\u))+(\v)*ln(\nb))}
\statement{
<div class="wims_question">
Écrire \(\ppexp) sous la forme \(e^{u(\x)}), où l'exposant \(u(\x)) est développé :
<div class="wimscenter">
\(\ppexp) = \(e)&nbsp;<sup>\embed{reply 1,10}</sup>
</div>
</div>
}
\answer{}{\sol}{type=algexp}
\hint{
Pour tout réel \(a) strictement positif, il existe une unique réel \(b)
tel que \(a = exp(b) = e^{b}\).
<br>
On nomme ce réel \(b) le logarithme néperien de \(a) ; on le note \(ln(a)) ou ln&nbsp;a .
<br>Tout réel \(a) strictement positif peut donc s'écrire \(a = e^{\ln(a)}\).
}
