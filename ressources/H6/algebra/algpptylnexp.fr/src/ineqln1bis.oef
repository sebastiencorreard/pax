{\text{def2= &#93; -&#8734; ; \rep2 &#91;}}
{\text{def2= &#93; \rep2 ; +&#8734;&#91;}}
!!! ens def non vide ?
!!! ensdef : vide (1) / a,b (2) / a,+inf (3) / -inf,a (4)
\if{\symb1 issametext \symb2}{
