\integer{mm=random(2..4)*random(1,-1)}
\integer{a=random(1..6)*random(-1,1)}
\integer{b=random(1..6)*random(-1,1)}
\integer{c2=\mm*(\a)^2}
\integer{c1=2*(\mm)*(\a)*(\b)}
\integer{move=random(1..30)*sign(\c2)}
\integer{c0=\mm*(\b)^2-(\move)}
\text{b=\c1>=0?+\c1:\c1}
\text{c=\c0>=0?+\c0:\c0}
\text{t1=\c1=0?:\b\X}













































































































































