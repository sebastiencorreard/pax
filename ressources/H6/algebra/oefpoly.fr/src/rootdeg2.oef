\answer{\(r_1\)}{\root1}
\answer{\(r_2\)}{\root2}
\condition{\(r_1\) \name_condition1}
{(\c2)*(\root1)^2+(\c1)*(\root1)=-(\c0)}
\condition{\(r_2\) \name_condition1}
{(\c2)*(\root2)^2+(\c1)*(\root2)=-(\c0)}
\condition{\name_condition2}
{-(\c2)*(\root1+(\root2))=\c1 and \c2*(\root1)*(\root2)=\c0}

