!set title=Trouver racine multiple degré 6
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
computeanswer=no
precision=10000
title_it=Trovare radici multiple di grado 6
title_en=Find multiple root degree 6

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!makelist x for x=-20 to 20

tmp1=!shuffle $(tmp0)

val7=$(tmp1)
tmp0=!randint 2 ,  6 - 1

val8=$[rint($(tmp0))]
val9=$(val7[1])
tmp0=!makelist $val9 for x=1 to $val8

tmp1=!item 2 to -1 of $val7

tmp2=!item 1  to  6 of $(tmp0),$(tmp1)

val7=$(tmp2)
tmp0=!makelist (x - y) for y in $val7

val10=$(tmp0)
tmp=!nonempty items 1,-1,2,-2,3,-3

tmp0=!randitem $tmp
tmp1=!translate internal , to * in $val10

val10=!rawmath $(tmp0)*$(tmp1)
t_=!replace internal \( by ( in $val10
tmp0=!exec pari $t_

val11=!rawmath $(tmp0)
val12=Le polynôme suivant a une racine multiple. Trouver cette racine
val13=La racine multiple
!if $val6=it 
val12=Il polinomio seguente ha una radice multipla. Trova questa radice
val13=La radice multipla
!endif
!if $val6=en 
val12=The following polynomial has a multiple root. Find this root
val13=The multiple root
!endif
replytype1=numeric
replyname1=$val13
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val12.	<div class="wimscenter">	
!insmath P(x) = $val11
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12
embedcnt=0
