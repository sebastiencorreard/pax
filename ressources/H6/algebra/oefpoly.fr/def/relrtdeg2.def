tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val7>0
val9=+$val7
!else
val9=$val7
!endif
