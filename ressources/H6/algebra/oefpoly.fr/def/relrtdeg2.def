val10=$(tmp0)
tmp0=!item $val8 of +a,$val9

val11=$(tmp0)
tmp0=!item $val8 of ($val7)^2,2*($val7)

val12=$[rint($(tmp0))]
tmp0=!item $val8 of $val12-2*a,a^2-$val12

val13=!rawmath $(tmp0)
val14=Soient \(r_1), \(r_2) les deux racines du polynôme
val15=où \(a) est un coefficient réel. Quelle est la valeur de
