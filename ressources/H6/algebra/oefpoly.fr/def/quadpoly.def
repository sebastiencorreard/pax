:test

!ifval ($val24=$val9 and $val25=$val10) or ($val24=$val11 and $val25=$val12)
 condtest1=1
!else
 condtest1=0
!endif
condname1=\($val7\) $val22

!ifval (($val26=$val9 and $val27=$val10) or ($val26=$val11 and $val27=$val12))	 and $val24+$val26=-($val13)
 condtest2=1
!else
 condtest2=0
!endif
condname2=\($val8\) $val23

!exit

:stat
vsavelist=7,8,9,10,11,12,13,15,17,18,20,21,22,23,24,25,26,27
