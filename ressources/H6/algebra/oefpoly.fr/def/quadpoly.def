!set title=Racines polynome complexe deg 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=Radici di un polinomio complesso di grado 2
title_en=Roots complex polynomial deg 2

ansorder=r,r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=r_1
val8=r_2
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val9=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val10=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val11=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem -1,1

tmp1=!randint 2, 50

val12=$[$(tmp0)*$(tmp1)/10]
val13=$[-($val9)-($val11)]
val14=$[-($val10)-($val12)]
val15=$[($val9)*($val11)-($val10)*($val12)]
val16=$[($val9)*($val12)+($val11)*($val10)]

!ifval $val14>=0
val17=+$val14
!else
val17=$val14
!endif

!ifval $val16>=0
val18=+$val16
!else
val18=$val16
!endif
val19=et
val20=Calculer les deux racines du polynôme
val21=Vous pouvez entrer les deux racines \($val7\) $val19 \($val8\) dans n'importe quel ordre.
val22=est une racine
val23=est l'autre racine
!if $val6=it 
val19=e
val20=Calcola le due radici del polinomio
val21=Puoi inserire le due radici \($val7\) $val19 \($val8\) in qualunque ordine.
val22=è una radice
val23=è l'altra radice
!endif
!if $val6=en 
val19=and
val20=Compute the two roots of the polynomial
val21=You may enter the two roots \($val7\) $val19 \($val8\) in any order.
val22=is a root
val23=is another root
!endif
replyname1=\(Re($val7))
replygood1=?analyze 24
replyname2=\(Im($val7)\)
replygood2=?analyze 25
replyname3=\(Re($val8)\)
replygood3=?analyze 26
replyname4=\(Im($val8)\)
replygood4=?analyze 27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val20	<div class="wimscenter">	
!insmath P (X) = X^2 + ($val13$val17 i) X + ($val15$val18 i)
$().	</div>	<div class="wims_instruction">	$val21	</div>	
$()
!exit

