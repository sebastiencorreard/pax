!set title=Racine triple deg 3 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
title_it=Radici triple grado 3 II
title_en=Triple root deg 3 II

ansorder=r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]

!ifval $val8>0
val10=+$val8
!else
val10=$val8
!endif

!ifval $val9>0
val11=+$val9
!else
val11=$val9
!endif
val12=$[0.001]
val13=et
val14=Pour quelles valeurs réelles des paramètres,le polynôme,a-t-il une racine triple
val15=La racine triple
val16=est une racine triple
val17=La solution n'est pas forcément unique.
!if $val6=it 
val13=e
val14=Per quali valori dei parametri reali,il polinomio,ha una radice tripla
val15=La radice tripla
val16=è una radice tripla
val17=La soluzione non è necessariamente unica.
!endif
!if $val6=en 
val13=and
val14=For which real values of the parameters,the polynomial,has a triple root
val15=The triple root
val16=is a triple root
val17=There may be several solutions.
!endif
replyname1=\(a)
replygood1=?analyze 18
replyname2=\(b)
replygood2=?analyze 19
replyname3=$val15 \(r\)
replygood3=?analyze 20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[1]) 
!insmath a
$() $val13 
!insmath b
$() $(val14[2])	<div class="wimscenter">	
!insmath P(X) = X^3 $val10 a X^2 $val11 b X +($val7+ a+b)
$()	</div>	$(val14[3])?	<div class="wims_instruction">$val17</div>
$()
!exit

