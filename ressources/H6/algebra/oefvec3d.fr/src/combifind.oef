\title{Trouver combinaison 3 vecteurs}
\title_en{Find combination 3 vectors}

\text{name_enonce=Soit,3 vecteurs dans l'espace.}
\text{name_question=Exprimer \(v=(\A, \B, \C)\) comme combinaison linéaire de}



\if{\lang=en}{

\text{name_enonce=Let,be 3 space vectors.}
\text{name_question=Try to express \(v=(\A, \B, \C)\) as a linear combination ofe}

