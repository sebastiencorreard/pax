\title{Volume de tétraèdre}
\title_en{Volume of tetrahedron}

\precision{10000}

\text{name_enonce=Calculer le volume du tétraèdre dans l'espace cartésien dont les 4 sommets sont}
\text{name_hint1=Un tétraèdre est un polyèdre dans l'espace avec 4 sommets.}
\text{name_hint2=Si l'on prend 4 sommets adjacents d'un parallélépipède, le tétraèdre
  engendré par ces 4 sommets a un volume qui est 1/6 celui du parallélépipède.}
\text{name_hint3=Le volume du parallélépipède se calcule par le produit mixte des vecteurs.}
\text{name_answer=Volume}



\if{\lang=en}{

\text{name_enonce=Compute the volume of the tegrahedron in the cartesian space whose 4 vertices are}
\text{name_hint1=A tetrahedron is a polyhedron in the space with 4 vertices.}
\text{name_hint2=If one takes 4 adjacent vertices of a parallelepiped, the tetrahedron
  generated by these 4 vertices has a volume which is 1/6 that of the
  parallelepiped.}
\text{name_hint3=The volume of the parallelepiped can be computed via the cross product of vectors.}
\text{name_answer=Volume}

}

\integer{mid=5}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=2*random(-\mid..\mid)}
\integer{c1=random(-\range..\range)}
\integer{a2=random(-\range..\range)}
\integer{b2=2*random(-\mid..\mid-2)+1}
\integer{c2=random(-\range..\range)}
\integer{a3=random(-\range..\range)}
\integer{b3=random(-\range..\range)}
\integer{c3=2*random(-\mid..\mid-2)+1}
\integer{x1=random(-\range..\range)}
\integer{y1=random(-\range..\range)}
\integer{z1=random(-\range..\range)}
\integer{x2=\x1+\a1}
\integer{y2=\y1+\b1}
\integer{z2=\z1+\c1}
\integer{x3=\x1+\a2}
\integer{y3=\y1+\b2}
\integer{z3=\z1+\c2}
\integer{x4=\x1+\a3}
\integer{y4=\y1+\b3}
\integer{z4=\z1+\c3}
\real{d1=\a1*\b2-\a2*\b1}
\real{d2=\b1*\c2-\b2*\c1}
\real{d3=\c1*\a2-\c2*\a1}
\real{vol=abs(\a1*\b2*\c3+\a2*\b3*\c1+\a3*\b1*\c2
	 -\a1*\b3*\c2-\a2*\b1*\c3-\a3*\b2*\c1)/6}
