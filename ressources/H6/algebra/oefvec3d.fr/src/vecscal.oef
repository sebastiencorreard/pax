\text{lang=slib(oef/env lang)}


\title{Produits vectoriel et scalaire}
\title_en{Scalar and vector products}

\precision{10000}

\text{name_enonce=Soit, un vecteur dans l'espace. Trouvez le vecteur
  \(v\) connaissant son produit scalaire et son produit vectoriel avec \(u\)&nbsp;}



\if{\lang=en}{

\text{name_enonce=Let, be a space vector. Find the vector
  \(v\) such that the scalar product and the vector product with \(u\) are}

}

\integer{mid=8}
\integer{range=\mid*2}
\integer{a1=2*random(-\mid..\mid-2)+1}
\integer{b1=random(1..\range)*random(-1,1)}
\integer{c1=random(1..\range)*random(-1,1)}
\integer{a2=2*random(-\mid..\mid)}
\integer{b2=random(1..\range)*random(-1,1)}
\integer{c2=random(1..\range)*random(-1,1)}
\integer{v1=\b1*\c2-\c1*\b2}
\integer{v2=\c1*\a2-\a1*\c2}
\integer{v3=\a1*\b2-\b1*\a2}
\integer{scal=\a1*\a2+\b1*\b2+\c1*\c2}
\statement{
  \name_enonce[1] \(u=(\a1,\b1,\c1)) \name_enonce[2]:
  <div class="wimscenter">
  \(\langle u, v\rangle = \scal), \(u\wedge v =(\v1,\v2,\v3)).
  </div>
}
\answer{\(v\)}{\a2,\b2,\c2}{type=vector}

