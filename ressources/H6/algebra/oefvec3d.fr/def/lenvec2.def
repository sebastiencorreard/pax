tmp0=$slib_out
val6=$(tmp0)
val7=Soit, un vecteur dans l'espace. Soit un vecteur \(v\) de longueur ,	  Étant donné que le produit scalaire \(\langle u,v \rangle\) est égal à ,	  quelle est la longueur du produit vectoriel
val8=Longueur
val9=Décomposez \(v\) en somme de deux vecteurs \(v_1\) et \(v_2\),	  où \(v_1\) est perpendiculaire à \(u\), et \(v_2\) est proportionnel à \(u\).
!if $val6=en 
val7=Let, be a space vector. We have another vector \(v\) whose length is ,	 Given that the scalar product \(\langle u,v \rangle\) equals ,	  what is the length of the vector product
val8=Longueur
val9=Decompose \(v\) into the sum of two vectors \(v_1\) and \(v_2\),	  where \(v_1\) is perpendicular to \(u\), and \(v_2) is proportional to
!endif
val10=$[rint(15)]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 3, $val10

val14=$[rint($(tmp0))]
val15=$[sqrt(($val11)^2+($val12)^2+($val13)^2)]
tmp0=!randint 1, floor($val14*$val15)-2

tmp1=!randitem -1,1

val16=$[rint($(tmp0)*$(tmp1))]
val17=$[sqrt($val14^2-($val16/$val15)^2)*$val15]
replyname1=$val8
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val9


!goto stat

!exit

