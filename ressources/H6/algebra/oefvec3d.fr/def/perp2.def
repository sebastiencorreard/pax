!set title=Perpendiculaire à deux vecteurs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Perpendicular to two vectors

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soient, deux vecteurs dans l'espace. Trouvez un vecteur,	  qui est perpendiculaire à la fois à,et à
val8=Le produit vectoriel de \(v_1\) et \(v_2\) est	  perpendiculaire à la fois à \(v_1\) et à \(v_2\).
!if $val6=en 
val7=Let, two space vectors. Find a vector,	  perpendicular to both,and 
val8=The vector product of \(v_1\) and \(v_2\) is	  perpendicular to both \(v_1\) and \(v_2\).
!endif
val9=$[rint(8)]
val10=$[rint($val9*2)]
tmp0=!randint -$val9, $val9-2

val11=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val9, $val9

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val10, $val10

val13=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val14=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9-2

val15=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val16=$[rint($(tmp0))]
val17=$[rint($val12*$val16-$val13*$val15)]
val18=$[rint($val13*$val14-$val11*$val16)]
val19=$[rint($val11*$val15-$val12*$val14)]
tmp0=!randint 1, 2*$val10

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
val21=$[$val20/$val19]
val22=$[$val17*$val21]
val23=$[$val18*$val21]
replyname1=\(a\)
replygood1=$val22
replyname2=\(b\)
replygood2=$val23
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val8


!goto stat

!exit

:question
$()$(val7[1])	<div class="wimscenter">	
!insmath v_1 = ($val11,$val12,$val13)
$(),	
!insmath v_2 = ($val14,$val15,$val16)
$()	</div>	$(val7[2]) 
!insmath v=(a,b,$val20)
$() $(val7[3]) 
!insmath v_1
$() $(val7[4]) 
!insmath v_2
$().	
$()
!exit

:hint
$()$val8
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11,12,13,14,15,16,20
