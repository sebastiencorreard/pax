!set title=Combinaison 2 vecteurs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
precision=10000
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
title_en=Combination 2 vectors

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soient, 2 vecteurs dans l'espace. Calculez le vecteur
!if $val6=en 
val7=Let, be 2 space vectors. Compute the vector
!endif
val8=$[rint(5)]
val9=$[rint($val8*2)]
tmp0=!randint -$val8, $val8-2

val10=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val8, $val8

val11=$[rint(2*$(tmp0))]
tmp0=!randint -$val8, $val8

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val13=$[rint($(tmp0))]
tmp0=!randint -$val8, $val8-2

val14=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val8, $val8

val15=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val16=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9

val17=$[rint($(tmp0))]
tmp0=!randint -$val8, $val8-2

val18=$[rint(2*$(tmp0)+1)]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val19=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
val22=$[rint($val10*$val19+$val13*$val20)]
val23=$[rint($val11*$val19+$val14*$val20)]
val24=$[rint($val12*$val19+$val15*$val20)]
val25=$val19*v1 + $val20*v2
replytype1=vector
replyname1=\(v\)
replygood1=$val22,$val23,$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1])	  <div class="wimscenter">	  
!insmath v_1 = ($val10,$val11,$val12)
$(),	  
!insmath v_2 = ($val13,$val14,$val15)
$(),		  </div>	  $(val7[2])	  <div class="wimscenter">	  
!insmath v = $val25
$().	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,13,14,15,25
embedcnt=0
