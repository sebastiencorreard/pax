!set title=Produit vectoriel et longueur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Vector product and length

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit , un vecteur dans l'espace. Soit un vecteur \(v\)	  perpendiculaire à \(u\). Etant donné que la longueur de \(v\)	  est égale à, quelle est la longueur du produit vectoriel \(u\wedge v\)&nbsp;
val8=Longueur
!if $val6=en 
val7=Let , be a space vector. We have another vector \(v\)	  which is perpendicular to \(u\). Given that the length of \(v\)	  is equal to, what is the length of the vector product
val8=Length
!endif
val9=$[rint(8)]
val10=$[rint($val9*2)]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

val14=$[rint($(tmp0))]
val15=$[$val14*sqrt(($val11)^2+($val12)^2+($val13)^2)]
replyname1=$val8
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) 
!insmath u=($val11,$val12,$val13) 
$() $(val7[2]) $val14, $(val7[3])?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11,12,13,14
embedcnt=0
