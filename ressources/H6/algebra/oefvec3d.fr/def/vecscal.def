!set title=Produits vectoriel et scalaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Scalar and vector products

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit, un vecteur dans l'espace. Trouvez le vecteur	  \(v\) connaissant son produit scalaire et son produit vectoriel avec \(u\)&nbsp;
!if $val6=en 
val7=Let, be a space vector. Find the vector	  \(v\) such that the scalar product and the vector product with \(u\) are
!endif
val8=$[rint(8)]
val9=$[rint($val8*2)]
tmp0=!randint -$val8, $val8-2

val10=$[rint(2*$(tmp0)+1)]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -$val8, $val8

val13=$[rint(2*$(tmp0))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
val16=$[rint($val11*$val15-$val12*$val14)]
val17=$[rint($val12*$val13-$val10*$val15)]
val18=$[rint($val10*$val14-$val11*$val13)]
val19=$[rint($val10*$val13+$val11*$val14+$val12*$val15)]
replytype1=vector
replyname1=\(v\)
replygood1=$val13,$val14,$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $(val7[1]) 
!insmath u=($val10,$val11,$val12)
$() $(val7[2]):	  <div class="wimscenter">	  
!insmath \langle u, v\rangle = $val19
$(), 
!insmath u\wedge v =($val16,$val17,$val18)
$().	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,16,17,18,19
embedcnt=0
