!set title=Angle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=200
title_en=Angle

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nous avons trois points dans l'espace&nbsp;
val8=Calculer l'angle \(\widehat{B A C}\) (en degrés, compris entre 0 et 180)
val9=L'angle
!if $val6=en 
val7=We have 3 points in the space
val8=Compute the angle \(\widehat{B A C}) (in degrees, between 0 and 180)
val9=The angle
!endif
val10=$[rint(8)]
val11=$[rint($val10*2)]
tmp0=!randint -$val10, $val10-2

val12=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val13=$[rint(2*$(tmp0))]
tmp0=!randint -$val11, $val11

val14=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val15=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10-2

val16=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val17=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val18=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val19=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val20=$[rint($(tmp0))]
val21=$[rint($val18+$val12)]
val22=$[rint($val19+$val13)]
val23=$[rint($val20+$val14)]
val24=$[rint($val18+$val15)]
val25=$[rint($val19+$val16)]
val26=$[rint($val20+$val17)]
val27=$[rint($val12*$val15+$val13*$val16+$val14*$val17)]
val28=$[sqrt(($val12)^2+($val13)^2+($val14)^2)]
val29=$[sqrt(($val15)^2+($val16)^2+($val17)^2)]
val30=$[acos($val27/($val28*$val29))*180/pi]
replyname1=$val9
replygood1=$val30
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	  <div class="wimscenter">	  
!insmath A($val18,$val19,$val20)
$(), 
!insmath B($val21,$val22,$val23)
$(), 
!insmath C($val24,$val25,$val26)
$().	  </div>	 $val8.	
$()
!exit

:hint
$()$m_name_hint
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,18,19,20,21,22,23,24,25,26
embedcnt=0
