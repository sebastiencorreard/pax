!set title=Trouver combinaison 3 vecteurs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Find combination 3 vectors

ansorder=r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit,3 vecteurs dans l'espace.
val8=Exprimer \(v=(\A, \B, \C)\) comme combinaison linéaire de
!if $val6=en 
val7=Let,be 3 space vectors.
val8=Try to express \(v=(\A, \B, \C)\) as a linear combination ofe
!endif
val9=$[rint(5)]
val10=$[rint($val9*2)]
tmp0=!randint -$val9, $val9-2

val11=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val9, $val9

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val13=$[rint(2*$(tmp0))]
tmp0=!randint -$val10, $val10

val14=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9-2

val15=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val9, $val9

val16=$[rint(2*$(tmp0))]
tmp0=!randint -$val10, $val10

val17=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val18=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9-2

val19=$[rint(2*$(tmp0)+1)]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val10

tmp1=!randitem -1,1

val22=$[rint($(tmp0)*$(tmp1))]
val23=$[rint($val11*$val20+$val14*$val21+$val17*$val22)]
val24=$[rint($val12*$val20+$val15*$val21+$val18*$val22)]
val25=$[rint($val13*$val20+$val16*$val21+$val19*$val22)]
replyname1=\(a\)
replygood1=$val20
replyname2=\(b\)
replygood2=$val21
replyname3=\(c\)
replygood3=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1])	  <div class="wimscenter">	  
!insmath v_1 = ($val11,$val12,$val13)
$(),	  
!insmath v_2 = ($val14,$val15,$val16)
$(),		  
!insmath v_3 = ($val17,$val18,$val19)
$()		  </div>	  $(val7[2])	  $val8 
!insmath v_1
$(), 
!insmath v_2
$()	  	  , 
!insmath v_3
$()	  	  <div class="wimscenter">		  
!insmath v = a v_1 + b v_2 + c v_3
$().		  </div>	
$()
!exit

