!set title=Volume de parallélépipède
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Volume of parallelepiped

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer le volume du parallélépipède dans l'espace cartésien	  ayant un sommet, et dont les 3 sommets adjacents à \(A\) sont
val8=Volume
val9=Le volume du parallélépipède se calcule par le produit mixte	  des vecteurs.
!if $val6=en 
val7=Compute the volume of the parallelepiped in the cartesian space	  having a vertex, and such that the 3 vertices adjacent to \(A\) are
val8=Volume
val9=The volume of parallelepiped is given by the cross product of vectors.
!endif
val10=$[rint(5)]
val11=$[rint($val10*2)]
tmp0=!randint -$val10, $val10-2

val12=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val13=$[rint(2*$(tmp0))]
tmp0=!randint -$val11, $val11

val14=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val15=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10-2

val16=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val17=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val18=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val19=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10-2

val20=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val21=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val22=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val23=$[rint($(tmp0))]
val24=$[rint($val21+$val12)]
val25=$[rint($val22+$val13)]
val26=$[rint($val23+$val14)]
val27=$[rint($val21+$val15)]
val28=$[rint($val22+$val16)]
val29=$[rint($val23+$val17)]
val30=$[rint($val21+$val18)]
val31=$[rint($val22+$val19)]
val32=$[rint($val23+$val20)]
val33=$[$val12*$val16-$val15*$val13]
val34=$[$val13*$val17-$val16*$val14]
val35=$[$val14*$val15-$val17*$val12]
val36=$[abs($val12*$val16*$val20+$val15*$val19*$val14+$val18*$val13*$val17	  -$val12*$val19*$val17-$val15*$val13*$val20-$val18*$val16*$val14)]
replyname1=$val8
replygood1=$val36
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val9


!goto stat

!exit

:question
$()$(val7[1]) 
!insmath A=($val21,$val22,$val23)
$(), $(val7[2])	<div class="wimscenter">	  
!insmath B
$() = ($val24,$val25,$val26),	  
!insmath C
$() = ($val27,$val28,$val29),	  
!insmath D
$() = ($val30,$val31,$val32).	</div>	
$()
!exit

:hint
$()$val9
$()
!exit

