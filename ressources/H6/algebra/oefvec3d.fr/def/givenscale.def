!set title=Produits scalaires donnés
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Given scalar products

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soient,	  trois vecteurs dans l'espace. Trouvez le vecteur \(v\) ayant les produits	  scalaires suivants&nbsp;
!if $val6=en 
val7=Let,	   three space vectors. Find the vector \(v\) having the following scalar	products
!endif
val8=$[rint(5)]
val9=$[rint($val8*2)]
tmp0=!randint -$val8, $val8-2

val10=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val8, $val8

val11=$[rint(2*$(tmp0))]
tmp0=!randint -$val8, $val8

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val13=$[rint($(tmp0))]
tmp0=!randint -$val8, $val8-2

val14=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val8, $val8

val15=$[rint(2*$(tmp0))]
tmp0=!randint -$val9, $val9

val16=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9

val17=$[rint($(tmp0))]
tmp0=!randint -$val8, $val8-2

val18=$[rint(2*$(tmp0)+1)]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val19=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val9

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
val22=$[rint($val10*$val19+$val11*$val20+$val12*$val21)]
val23=$[rint($val13*$val19+$val14*$val20+$val15*$val21)]
val24=$[rint($val16*$val19+$val17*$val20+$val18*$val21)]
replytype1=vector
replyname1=\(v\)
replygood1=$val19,$val20,$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1])	  <div class="wimscenter">	  
!insmath v_1 = ($val10,$val11,$val12)
$(),	  
!insmath v_2 = ($val13,$val14,$val15)
$(),	  
!insmath v_3 = ($val16,$val17,$val18)
$()	  </div>	  $(val7[2]):	  <div class="wimscenter">	   
!insmath \langle v,v_1\rangle = $val22 
$(),	   
!insmath \langle v,v_2\rangle = $val23 
$(),	   
!insmath \langle v,v_3\rangle = $val24 
$().	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,13,14,15,16,17,18,22,23,24
embedcnt=0
