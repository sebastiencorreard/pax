!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer l'aire du parallélogramme dans l'espace euclidien dont les 4 sommets sont
val8=L'aire du parallélogramme est la longueur du produit vectoriel	  des deux vecteurs représentant deux côtés adjacents du parallélogramme.
val9=Aire
!if $val6=en 
val7=Compute the area of the parallelogram in the cartesian space whose 4 vertices are
val8=The area of the parallelogram is the length of the vector product	  of the two vectors representing two adjacent sides of the parallelogram.
val9=Aera
!endif
val10=$[rint(5)]
val11=$[rint($val10*2)]
tmp0=!randint -$val10, $val10-2

val12=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val13=$[rint(2*$(tmp0))]
tmp0=!randint -$val11, $val11

val14=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val15=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10-2

val16=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val11, $val11

val17=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val18=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val19=$[rint($(tmp0))]
tmp0=!randint -$val11, $val11

val20=$[rint($(tmp0))]
val21=$[rint($val18+$val12)]
val22=$[rint($val19+$val13)]
val23=$[rint($val20+$val14)]
val24=$[rint($val18+$val15)]
val25=$[rint($val19+$val16)]
val26=$[rint($val20+$val17)]
val27=$[rint($val21+$val15)]
val28=$[rint($val22+$val16)]
val29=$[rint($val23+$val17)]
val30=$[$val12*$val16-$val15*$val13]
val31=$[$val13*$val17-$val16*$val14]
val32=$[$val14*$val15-$val17*$val12]
val33=$[sqrt(($val30)^2+($val31)^2+($val32)^2)]
replyname1=$val9
replygood1=$val33
