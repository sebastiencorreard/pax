!set title=Sommet de parallélogramme
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Vertex of parallelogram

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nous avons un parallélogramme \(A B C D) dans l'espace cartésien,	  dont les 3 premiers sommets sont de coordonnées
val8=Calculez les coordonnées du quatrième sommet \(D\).
!if $val6=en 
val7=We have a parallelogram \(ABCD) in the cartesian space,	  whose 3 first vertices are at the coordinates
val8=Compute the coordinates of the fourth vertex \(D\).
!endif
val9=$[rint(5)]
val10=$[rint($val9*2)]
tmp0=!randint -$val9, $val9-2

val11=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val9, $val9

val12=$[rint(2*$(tmp0))]
tmp0=!randint -$val10, $val10

val13=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val14=$[rint($(tmp0))]
tmp0=!randint -$val9, $val9-2

val15=$[rint(2*$(tmp0)+1)]
tmp0=!randint -$val10, $val10

val16=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val17=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val18=$[rint($(tmp0))]
tmp0=!randint -$val10, $val10

val19=$[rint($(tmp0))]
val20=$[rint($val17+$val11)]
val21=$[rint($val18+$val12)]
val22=$[rint($val19+$val13)]
val23=$[rint($val17+$val14)]
val24=$[rint($val18+$val15)]
val25=$[rint($val19+$val16)]
val26=$[rint($val20+$val14)]
val27=$[rint($val21+$val15)]
val28=$[rint($val22+$val16)]
val29=$[$val11*$val15-$val14*$val12]
val30=$[$val12*$val16-$val15*$val13]
val31=$[$val13*$val14-$val16*$val11]
val32=$[sqrt(($val29)^2+($val30)^2+($val31)^2)]
replytype1=vector
replyname1=\(D\)
replygood1=$val23,$val24,$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	<div class="wimscenter">	 
!insmath A
$() = ($val17,$val18,$val19), 
!insmath B
$() = ($val20,$val21,$val22), 
!insmath C
$() = ($val26,$val27,$val28).	</div>	$val8	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,17,18,19,20,21,22,26,27,28
embedcnt=0
