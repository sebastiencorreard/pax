!set title=Pentaroot
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=roots
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_it=Pentaroot
title_es=Pentaroot
title_fr=Pentaroot
title_nl=Pentaroot

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]

!ifval $val7=1
tmp0=!randint 20, 99

tmp1=!randint 1, 4

val8=$[rint(5*$(tmp0)+$(tmp1))]
!else
tmp2=!randint 20, 99

val8=$[rint(5*$(tmp2))]
!endif

!ifval $val7=1
val9=$[rint(-1)]
!else
val9=$[rint(4)]
!endif
val10=Let,be the 4 (complex) roots of the polynomial,What is the number
!if $val6=it 
val10=Siano,le 4 radici (complesse) del polinomio,Qual è il numero
!endif
!if $val6=es 
val10=Sean,las cuatro raíces (complejas) del polinomio,¿Cuál es el número
!endif
!if $val6=fr 
val10=Soient,les 4 racines (complexes) du polynôme,Quel est le nombre
!endif
!if $val6=nl 
val10=Laat,de vier (complexe) wortels zijn van de polynoom,	  Wat is dan het getal w waarvoor geldt
!endif
replyname1=\(Re(w)\)
replygood1=$val9
replyname2=\(Im(w)\)
replygood2=0
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath z_1
$(), 
!insmath z_2
$(), 
!insmath z_3
$(), 
!insmath z_4
$() $(val10[2])	
!insmath X^4 +X^3 +X^2 +X+1
$(). $(val10[3])	
!insmath w=z_1^$val8+z_2^$val8+z_3^$val8+z_4^$val8
$() ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=0
