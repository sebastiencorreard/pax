!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -20, 20

val9=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val8+($val10)=0
val10=$[rint($val8)]
!endif
val11=$[rint($val7+($val9))]
val12=$[rint($val8+($val10))]
t_=!rawmath $val7+$val8*i
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
t_=!rawmath $val9+$val10*i
t_=!exec pari print($t_)
val14=!mathsubst I=i in $t_
val15=$[sqrt(($val11)^2+($val12)^2)]

!ifval $val12>0
val16=$[pi/2]
!else
val16=$[-pi/2]
!endif

!ifval $val11=0
val17=$[$val16]
!else
val17=$[arctan($val12/($val11))]
!endif

!ifval $val11<0
val18=$[$val17+pi]
!else
val18=$[$val17]
!endif
