!set title=Two roots II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=roots
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Due radici II
title_es=Dos raíces II
title_fr=Deux racines II
title_nl=Twee wortels II

ansorder=c
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=pure imaginary
val8=real
val9=equal to zero
val10=neither real nor pure imaginary
val11=Let,be the two roots of a polynomial,where,is a real number.	  Then \(z_1 - z_2\) is a number
!if $val6=it 
val7=immaginairio puro
val8=reale
val9=uguale a zero
val10=né reale né immaginario
val11=Siano,le due radici di un polinomio,dove,è un numero reale. Allora \(z_1 - z_2\) è un numero
!endif
!if $val6=es 
val7=imaginario puro
val8=real
val9=igual a cero
val10=ni real ni imaginario puro
val11=Sean,las dos raíces de un polinomio,donde,es un número real. Luego \(z_1 - z_2\) es un número
!endif
!if $val6=fr 
val7=imaginaire pur
val8=réel
val9=égal à zéro
val10=ni réel ni imaginaire pur
val11=Soient,les deux racines d'un polynôme,où,est un nombre réel. Alors \(z_1 - z_2\) est un nombre
!endif
!if $val6=nl 
val7=puur imaginair
val8=ree&euml;l
val9=gelijk aan nul
val10=niet ree&euml;l en niet imaginair
val11=Let,be the two roots of a polynomial,where,is a real number.	  Then \(z_1 - z_2\) is a number
!endif
val12=$val8,$val7,$val9,$val10
tmp0=!randint 2, 8

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]

!ifval $val13>0
val14=+$val13
!else
val14=$val13
!endif
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]

!ifval $val15=2
val16=i
!else
val16=1
!endif
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]

!ifval $val17=1
val18={>}100
!else
val18={<}-100
!endif

!ifval $val17=1
val19=$val7
!else
val19=$val8
!endif
choicename1=
choicegood1=$val19
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val11[1]) 
!insmath z_1
$(), 
!insmath z_2
$() $(val11[2])	
!insmath P(X)=X^2+$val13*$val16*X+q
$(), $(val11[3])	
!insmath q$val18
$() $(val11[4]) ____________.
$()
!exit

