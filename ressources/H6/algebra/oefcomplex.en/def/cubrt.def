!set title=Cubic root
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Radice cubica
title_es=Raíz cúbica
title_fr=Racine cubique
title_nl=Vierkants wortel I

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val7+$val8*i
t_=!exec pari print($t_)
val9=!mathsubst I=i in $t_
val10=Find a cubic root \(w\) of the complex number,	by giving its real part and imaginary part
!if $val6=it 
val10=Calcolare una radice cubica \(w\) del numero complesso,e dire quali siano la sua parte reale e immaginaria
!endif
!if $val6=es 
val10=Encuentre una raíz cúbica \(w\) del número complejo,	entregando su parte real y parte imaginaria
!endif
!if $val6=fr 
val10=Trouver une racine cubique \(w\) du nombre complexe,en donnant sa partie réelle et partie imaginaire
!endif
!if $val6=nl 
val10=Bepaal het re&euml;le en imaginaire deel van de vierkants wortel	  \(w\) van het complexe getal
!endif
replyname1=\(Re(w)\)
replygood1=?analyze 11
replyname2=\(Im(w)\)
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val10[1]) 
!insmath z=$val9
$(), $(val10[2]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val11)^3-3*($val11)*($val12)^2=$val7
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(Re(w^3)=$val7\)

!ifval 3*($val11)^2*($val12)-($val12)^3=$val8
 condtest2=1
!else
 condtest2=0
!endif
condname2=\(Im(w^3)=$val8\)

!exit

:stat
vsavelist=7,8,9,10,11,12
embedcnt=0
