:solution
$()$(val11[1]) 
!insmath z=a+$val7*i
$(), $(val11[2]) 
!insmath w=a-$val7*i
$().	$(val11[3]) 
!insmath p=-2a
$(), $(val11[4]) 
!insmath a=-0.5*p
$().	$(val11[5]) 
!insmath q=z*w=a^2+($val7)^2=($val7)^2+0.25*p^2
