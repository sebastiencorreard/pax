!set title=Given argument
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_it=Argomento dato
title_es=Argumento dado
title_fr=Argument donné
title_nl=Modulus en Argument II

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 100

val7=$[$(tmp0)/10]
tmp0=!randint 1, 100

tmp1=!randitem -1,1

val8=$[$(tmp0)/10*$(tmp1)]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval $val9=1
val10=$[$val8]
!else
val10=$[$val8*pi]
!endif

!ifval $val9=1
val11=$val8
!else
val11=$val8*pi
!endif
val12=$[cos($val11)*$val7]
val13=$[sin($val11)*$val7]
val14=Compute the real part and imaginary part of the complex number \(z\) having,as module and having,as an argument
!if $val6=it 
val14=Calcolare la parte reale e la parte immaginaria del numero complesso \(z\) avente,come modulo e,come argomento
!endif
!if $val6=es 
val14=Calcule la parte real e imaginaria del número complejo \(z\) que tiene a, como módulo y que tiene a,como un argumento
!endif
!if $val6=fr 
val14=Calculer la partie réelle et la partie imaginaire du nombre	complexe \(z\) ayant,comme module et,comme argument
!endif
!if $val6=nl 
val14=CBepaal het re&euml;le en imaginaire deel van het complexe getal	  \(z\) met als modulus,en argument
!endif
replytype1=numeric
replyname1=\(Re(z)\)
replygood1=$[$val12]
replytype2=numeric
replyname2=\(Im(z)\)
replygood2=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[1]) 
!insmath $val7
$() $(val14[2]) 
!insmath $val11
$() $(val14[3]).
$()
!exit

