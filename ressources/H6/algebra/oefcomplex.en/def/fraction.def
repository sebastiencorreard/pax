!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val7+i*$val8
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!rawmath $val9+i*$val10
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp0=!texmath $val11

val13=$(tmp0)
tmp0=!texmath $val12

val14=$(tmp0)

!ifval $val8>=0
val15=+$val8
!else
val15=$val8
!endif

!ifval $val10>=0
val16=+$val10
!else
val16=$val10
!endif
val17=$[($val9)^2+($val10)^2]
val18=$[($val7*($val9)+($val8)*($val10))/$val17]
val19=$[($val8*($val9)-($val7)*($val10))/$val17]
val20=Compute the real part and imaginary part of the following complex number
