!set title=Sum of j
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Somme di j
title_es=Suma de j
title_fr=Somme de j
title_nl=Som van j

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randint 100, 200

val8=$[rint($(tmp0))]
val9=$[rint($val7+1)]
val10=$[rint($val7+2)]
val11=$[rint($val7%3+1)]
val12=$[rint(($val8+1-$val7)%3)]

!ifval $val12=0
val13=$[0]
!endif

!ifval $val12=0
val14=$[0]
!endif

!ifval $val12=1
tmp0=!item $val11 of 1,     -0.5,      -0.5

val13=$[$(tmp0)]
!endif

!ifval $val12=1
tmp0=!item $val11 of 0,sqrt(3)/2,-sqrt(3)/2

val14=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of       0.5,-1,       0.5

val13=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of sqrt(3)/2, 0,-sqrt(3)/2

val14=$[$(tmp0)]
!endif
val15=Let,Compute the sum
!if $val6=it 
val15=Sia,Calcolare la somma
!endif
!if $val6=es 
val15=Sea,Calcule la suma
!endif
!if $val6=fr 
val15=Soit,Calculez la somme
!endif
!if $val6=nl 
val15=Gegeven, Bereken de som
!endif
replyname1=\(Re(S)\)
replygood1=$val13
replyname2=\(Im(S)\)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val15[1]) 
!insmath j=\cos{2\pi\over 3}+i\sin{2\pi\over 3}
$().	$(val15[2])	<div class="wimscenter"> 
!insmath S=j^{$val7}+j^{$val9}+j^{$val10}+...+j^{$val8}\quad.
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,15
embedcnt=0
