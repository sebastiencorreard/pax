!set title=Square root
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=1000
computeanswer=yes
title_it=Radice quadrata
title_es=Raíz cuadrada
title_fr=Racine carrée
title_nl=Vierkants wortel V

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
val9=Find a square root \(w\) of the complex number,	by giving its real part and imaginary part
!if $val6=it 
val9=Determinare una radice quadrata \(w\) del numero complesso,	fornendo parte reale e parte immaginaria
!endif
!if $val6=es 
val9=Encuentre una raíz cuadrada \(w\) del número complejo,	entregando su parte real y parte imaginaria
!endif
!if $val6=fr 
val9=Trouver une racine carrée \(w\) du nombre complexe,	en donnant sa partie réelle et partie imaginaire
!endif
!if $val6=nl 
val9=Bepaal het re&euml;le en imaginaire deel van de vierkants wortel	  \(w\) van het complexe getal
!endif
replytype1=numeric
replyname1=\(Re(w)\)
replygood1=?analyze 10
replytype2=numeric
replyname2=\(Im(w)\)
replygood2=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val9[1])	
!insmath z = $val7+$val8*i
$(), $(val9[2]).	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val10)^2-($val11)^2=$val7
 condtest1=1
!else
 condtest1=0
!endif
condname1=\(Re(w^2 )\) = $val7

!ifval 2*($val10)*($val11)=$val8
 condtest2=1
!else
 condtest2=0
!endif
condname2=\(Im(w^2 )\) = $val8

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=0
