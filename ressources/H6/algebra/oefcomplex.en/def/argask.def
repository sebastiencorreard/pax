!set title=Asked argument
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_it=Trova l'argomento
title_es=Encontrar el argumento
title_fr=Argument demandé
title_nl=Modulus en Argument I

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val7+$val8*i
t_=!exec pari print($t_)
val9=!mathsubst I=i in $t_
val10=$[sqrt(($val7)^2+($val8)^2)]

!ifval $val8>0
val11=$[pi/2]
!else
val11=$[-pi/2]
!endif

!ifval $val7=0
val12=$[$val11]
!else
val12=$[arctan($val8/($val7))]
!endif

!ifval $val7<0
val13=$[$val12+pi]
!else
val13=$[$val12]
!endif
val14=Give the module and argument of the complex number
val15=is an argument of
!if $val6=it 
val14=Dare il modulo e l'argomento del numero complesso
val15=è un argomento di
!endif
!if $val6=es 
val14=Entregue el módulo y un argumento del número complejo
val15=es un argumento de
!endif
!if $val6=fr 
val14=Donner le module et un argument du nombre complexe
val15=est un argument de
!endif
!if $val6=nl 
val14=Geef Modulus en Argument van het complexe getal
val15=is het argument van
!endif
replytype1=numeric
replyname1=\(|z|\)
replygood1=$[$val10]
replytype2=numeric
replyname2=\(Arg(z)\)
replygood2=?analyze 16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val14 
!insmath $val9
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs(($val16-$val13)/(2*pi)-round(($val16-$val13)/(2*pi)))<0.0001
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val16 $val15 \(z\)

!exit

:stat
vsavelist=9,13,14,15,16
embedcnt=0
