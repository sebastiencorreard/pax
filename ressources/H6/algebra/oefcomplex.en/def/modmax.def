!set title=Maximal module
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Modulo massimo
title_es=Módulo máximo
title_fr=Module maximal
title_nl=Modulus II

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint -20, 20

val7=$[rint($(tmp0))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[sqrt(($val7)^2+($val8)^2)]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
val11=$[$val7*$val10/$val9]
val12=$[$val8*$val10/$val9]
val13=Among all complex numbers \(z\) with module,	find the one for which the module of,is maximal
!if $val6=it 
val13=Tra tutti i numeri complessi \(z\) di modulo,	trovare quello per il quale il modulo di,è massimo
!endif
!if $val6=es 
val13=Entre todos los complejos \(z\) de módulo,	encuentre aquel para el cual el módulo de,es maximal
!endif
!if $val6=fr 
val13=Parmi tous les nombres complexes \(z\) de module,	trouver celui pour qui le module de,est maximal
!endif
!if $val6=nl 
val13=Zoek uit complexe getallen \(z\) met,	  het complexe getal waarvoor geldt dat de modulus,maximaal is
!endif
replyname1=\(Re(z)\)
replygood1=$val11
replyname2=\(Im(z)\)
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val13[1]) $val10,	  $(val13[2]) 
!insmath $val7+$val8*i+z
$() $(val13[3]).
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
