!set title=Sum of i
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_it=Somme di i
title_es=Suma de i
title_fr=Somme de i
title_nl=Som van i

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
tmp0=!randint 100, 200

val8=$[rint($(tmp0))]
val9=$[rint($val7+1)]
val10=$[rint($val7+2)]
val11=$[rint($val7%4+1)]
val12=$[rint(($val8+1-$val7)%4)]

!ifval $val12=0
val13=$[0]
!endif

!ifval $val12=0
val14=$[0]
!endif

!ifval $val12=1
tmp0=!item $val11 of 1,0,-1,0

val13=$[$(tmp0)]
!endif

!ifval $val12=1
tmp0=!item $val11 of 0,1,0,-1

val14=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of 1,-1,-1,1

val13=$[$(tmp0)]
!endif

!ifval $val12=2
tmp0=!item $val11 of 1,1, -1,-1

val14=$[$(tmp0)]
!endif

!ifval $val12=3
tmp0=!item $val11 of 0,-1,0,1

val13=$[$(tmp0)]
!endif

!ifval $val12=3
tmp0=!item $val11 of 1,0,-1,0

val14=$[$(tmp0)]
!endif
val15=Compute the sum
!if $val6=it 
val15=Calcolare la somma
!endif
!if $val6=es 
val15=Calcule la suma
!endif
!if $val6=fr 
val15=Calculer la somme
!endif
!if $val6=nl 
val15=Bereken de som
!endif
replyname1=\(Re(S)\)
replygood1=$val13
replyname2=\(Im(S)\)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val15	<div class="wimscenter">	
!insmath S=i^$val7 +i^$val9 +i^$val10 +...+i^$val8
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,15
embedcnt=0
