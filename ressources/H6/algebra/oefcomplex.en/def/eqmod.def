!set title=Equation with module
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=equations
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=3000
computeanswer=yes
title_it=Equazioni con modulo
title_es=Ecuación con módulo
title_fr=Équation avec module
title_nl=Vergelijkingen I

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val7+$val8*i
t_=!exec pari print($t_)
val9=!mathsubst I=i in $t_
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of +,-

val11=$(tmp0)
tmp0=!item $val10 of ,-

val12=$(tmp0)
val13=$[$val8]
val14=$[(($val7)^2-($val8)^2)/(2*($val7))]

!ifval ($val7>0 and $val10=1) or ($val7<0 and $val10=2)
t_=!rawmath $val14+($val13)*i
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
!else
t_=!rawmath 0+0*i
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
!endif
val16=Solve in \(\mathbb{C}\) the equation
val17=Type,if you think that the equation has no solution
val18=In the complex plane,the origin and the points corresponding to,should form a rhombus (why?)
!if $val6=it 
val16=Risolvere in \(\mathbb{C}\) l'equazione
val17=Inserire,se pensate che l'equazione non abbia soluzione
val18=Nel piano complesso,l'origine e i punti corrispondenti ai numeri,formano un parallelogramma (perché?)
!endif
!if $val6=es 
val16=Resuelva en \({}\mathbb{C}\) la ecuación
val17=Escriba,si piensa que la ecuación no tiene solución
val18=En el plano complejo, el origen y los puntos que corresponden a,deben formar un rombo (¿por qué?)
!endif
!if $val6=fr 
val16=Résoudre dans \(\mathbb{C}\) l'équation
val17=Tapez,si vous pensez que l'équation n'a pas de solution
val18=Dans le plan complexe,l'origine et les points d'affixe,doivent former un losange (pourquoi?)
!endif
!if $val6=nl 
val16=Los de onderstaande vergelijking op in \(\CC\)
val17=Geef,als je denkt dat er geen oplossing mogelijk is
val18=In het complexe vlak, vormen de Oorsprong en punten,een gelijkzijdige driehoek...(waarom?)
!endif
replytype1=complex

replyname1=\(z\)
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val16 
!insmath z$val11|z|=$val9
$().	<div class="wims_instruction">	$(val17[1]) <span class="tt">0</span> $(val17[2]).	</div>	
$()
!exit

:hint
$()$(val18[1]), $(val18[2]) 
!insmath z
$(), 
!insmath $val12|z|
$(),	
!insmath $val9
$() $(val18[3]).
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,11,12,16,17,18
embedcnt=0
