!set title=Quadratic double root
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Quadratica radice doppia
title_es=Cuadrática raíz doble
title_fr=Quadratique racine double
title_nl=Vierkants wortel II

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint(-2*($val7))]
val10=$[rint(-2*($val8))]

!ifval $val10>0
val11=+$val10
!else
val11=$val10
!endif
val12=$[rint(($val7)^2-($val8)^2)]
val13=$[rint(2*($val7)*($val8))]

!ifval $val13>=0
val14=+$val13
!else
val14=$val13
!endif

!ifval $val8>=0
val15=+$val8
!else
val15=$val8
!endif
val16=For which complex value of \(w\) the polynomial,has a (complex) double root
val17=The double root
!if $val6=it 
val16=Per quale valore complesso \(w\) il polinomio,ha una radice doppia (complessa)
val17=La radice doppia
!endif
!if $val6=es 
val16=¿Para qué valor de \(w\) el polinomio,tiene una raíz doble (compleja)
val17=La raíz doble
!endif
!if $val6=fr 
val16=Pour quelle valeur complexe \(w\) le polynôme,a-t-il une racine double (complexe)&nbsp;
val17=La racine double
!endif
!if $val6=nl 
val16=Voor welke -complexe- waarde van \(w\) heeft de polynoom,	  een complexe dubbel wortel
val17=De dubbele wortel
!endif
replyname1=\(w\)
replygood1=$val12$val14*i
replyname2=$val17
replygood2=$val7$val15*i
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val16[1])	<div class="wimscenter">	
!insmath X^2+($val9+$val11*i)*X+w
$()	</div>	$(val16[2])?
$()
!exit

