val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 0, 9

val7=$[rint($(tmp0))]
tmp0=!randint 0, 9

val8=$[rint($(tmp0))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
val11=$[rint($val9-$val7)]
val12=$[rint($val10-$val8)]
val13=$[$val7+($val11-$val12*3^(1/2))/2]
val14=$[$val7+($val11+$val12*3^(1/2))/2]
val15=$[$val8+ ($val11*3^(1/2)+$val12)/2]
val16=$[$val8+ (-$val11*3^(1/2)+$val12)/2]
t_=!rawmath $val7+$val8*i
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
t_=!rawmath $val9+$val10*i
t_=!exec pari print($t_)
val18=!mathsubst I=i in $t_
val19=and
val20=If \(A\) and \(B\) are points in the complex plane corresponding to,	find the complex number of the point \(M\) such that the triangle \(ABM\) is equilateral
val21=\(AM) is the image of \(AB\) by a rotation. Which rotation?
!if $val6=it 
val19=e
val20=Se \(A\) e \(B\) sono dei punti del piano corrispondenti a,	trovare il numero complesso corrispondente al punto \(M\) tale che il triangolo \(ABM\) sia equilatero
val21=\(AM\) è l'immagine di \(AB\) attraverso una rotazione. Quale?
!endif
!if $val6=es 
val19=y
val20=Si \(A\) y \(B\) son los puntos en el plano complejo que corresponden a,	encuentre el número complejo \(M\) tal que el triángulo \(ABM\) es equilátero
val21=\(AM\) es la imagen de \(AB\) por una rotación. ¿Cuál rotación?
!endif
!if $val6=fr 
val19=et
val20=Si \(A\) et \(B\) sont des points du plan d'affixe,	trouver l'affixe d'un point \(M\) tel que le triangle \(ABM\) soit équilatéral
val21=\(AM\) est l'image de \(AB\) par une rotation. Laquelle ?
!endif
!if $val6=nl 
val19=en
val20=Laat \(A\) en \(B\) punten zijn in het complexe vlak corresponderend met,	  Bepaal het complexe getal van het punt \(M\) zo dat de driehoek \(ABM\) gelijkzijdig is
val21=\(AM) is het beeld van \(AB) bij een rotatie. Welke rotatie?
!endif
replytype1=default
replyname1=\(Re(z)\)
