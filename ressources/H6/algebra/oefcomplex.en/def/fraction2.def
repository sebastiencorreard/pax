!set title=Fraction II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_it=Frazione II
title_es=Fracción II
title_fr=Fraction II
title_nl=Breuken II

ansorder=r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=i
val8=1+$val7,-1-$val7,1-$val7,$val7-1
val9=1,-3,-1,3
tmp0=!randint 1, 8

val10=$[rint($(tmp0))]
tmp0=!item $val10 of 1,1,2,2,3,3,4,4

val11=$[rint($(tmp0))]
tmp0=!item $val10 of 3,4,3,4,1,2,1,2

val12=$[rint($(tmp0))]
tmp0=!item $val11 of $val8

val13=$(tmp0)
tmp0=!item $val12 of $val8

val14=$(tmp0)
tmp0=!item $val11 of $val9

val15=$[rint($(tmp0))]
tmp0=!item $val12 of $val9

val16=$[rint($(tmp0))]
tmp0=!randint 20, 50

val17=$[rint($(tmp0))]
tmp0=!randint $val17-6, $val17+6

val18=$[rint($(tmp0))]
val19=$[2^(($val17-$val18)/2)]
val20=$[($val16*$val17-($val15*$val18)+1000)%8]
val21=$[$val19*cos($val20*pi/4)]
val22=$[$val19*sin($val20*pi/4)]

!ifval abs($val21)<0.000001
val21=$[0]
!endif

!ifval abs($val22)<0.000001
val22=$[0]
!endif
val23=Compute the real part and imaginary part of the following complex number
val24=Real part
val25=Imaginary part
!if $val6=it 
val23=Calcolare parte reale e parte immaginaria del	seguente numero complesso
val24=Parte reale
val25=Parte immaginaria
!endif
!if $val6=es 
val23=Calcule la parte real e imaginaria del siguiente número complejo
val24=Parte real
val25=Parte imaginaria
!endif
!if $val6=fr 
val23=Calculer la partie réelle et la partie imaginaire du nombre	complexe suivant&nbsp;
val24=Partie réelle
val25=Partie imaginaire
!endif
!if $val6=nl 
val23=Bepaal het re&euml;le en imaginaire deel van het onderstaande complexe getal
val24=Re&euml;le deel
val25=Imaginaire deel
!endif
replyname1=\(Re(z)\)
replygood1=$val21
replyname2=\(Im(z)\)
replygood2=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

