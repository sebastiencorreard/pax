!set title=Sum with inverse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_it=Somma con inverso
title_es=Suma con inverso
title_fr=Somme avec inverse
title_nl=Som met inverse

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]
tmp0=!item $val7 of -1,1

val8=$(tmp0)
tmp0=!randint 100, 999

val9=$[rint($(tmp0))]

!ifval $val9%3=0
val10=$[rint(2)]
!else
val10=$[rint(-1)]
!endif

!ifval $val7=1 or $val9%2=0
val10=$[rint($val10)]
!else
val10=$[rint(-($val10))]
!endif
val11=Let \(z\) be a complex number with,Compute
!if $val6=it 
val11=Sia \(z\) un numero complesso con,Calcolare
!endif
!if $val6=es 
val11=Sea \(z\) un número complejo con,Calcule
!endif
!if $val6=fr 
val11=Soit \(z\) un nombre complexe avec,Calculez
!endif
!if $val6=nl 
val11=Gegeven het complexe getal \(z\) met,Bepaal het getal
!endif
replyname1=\(Re(w)\)
replygood1=$val10
replyname2=\(Im(w)\)
replygood2=0
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val11[1]) 
!insmath z+1/z=$val8
$(). $(val11[2])	
!insmath w=z^$val9 +z^(-$val9 )
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,11
embedcnt=0
