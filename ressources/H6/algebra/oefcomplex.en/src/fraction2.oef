\text{i=i}
\text{l=1+\i,-1-\i,1-\i,\i-1}
\text{a=1,-3,-1,3}
\integer{perm=random(1..8)}
\integer{di=item(\perm,1,1,2,2,3,3,4,4)}
\integer{ni=item(\perm,3,4,3,4,1,2,1,2)}
\text{den=item(\di,\l)}
\text{num=item(\ni,\l)}
\integer{da=item(\di,\a)}
\integer{na=item(\ni,\a)}
\integer{np=random(20..50)}
\integer{dp=random(\np-6..\np+6)}
\real{module=2^((\np-\dp)/2)}
\real{arg=(\na*\np-(\da*\dp)+1000)%8}
\real{re=\module*cos(\arg*pi/4)}
\real{im=\module*sin(\arg*pi/4)}
\real{re=abs(\re)<0.000001?0}
\real{im=abs(\im)<0.000001?0}



