\title{直升机}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{num=random(2..4)}
\integer{num2=2*\num}
\integer{pro=factorial(\num)}
\integer{ddd=item(\num,1,6,90,2520,113400)}
\integer{distr=\pro*\ddd}
\statement{有 \num 架旅游直升机, \num 位驾驶员和
\num2 位空服员. 现在每架直升机需要一位驾驶员和 2 位空服员,
问有多少种分配方法?}

\answer{方法数}{\distr}
