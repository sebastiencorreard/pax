\title{晚餐桌 4}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3,4)}
\integer{tot=2*\pairs}
\integer{coef=item(\pairs-2,1,2)}
\integer{sol=2*factorial(\pairs)*\coef}

\statement{有 \pairs 对夫妻围着饭桌共进晚餐. 
有多少种方法为这 \tot 个人安排座位,
使得每位男士位于两位女士的中间, 而且没有一对夫妇坐在一起?}

\answer{方法数}{\sol}
