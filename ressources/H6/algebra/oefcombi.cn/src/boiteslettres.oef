\title{信箱}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{letters=random(3..7)}
\integer{boxes=random(3..8)}
\integer{methods=\boxes^\letters}
\statement{有多少种不同方式把 \letters 
封信投入 \boxes 个信箱内?}


\answer{可能方式数}{\methods}
