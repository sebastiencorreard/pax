\title{三角形}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{line=random(7..15)}
\integer{orig=random(3..\line-3)}
\integer{vert=random(3..8)}
\integer{tot=\hori+\vert}
\integer{sol=\line*(\line-1)*(\line-2)/6-\orig*(\orig-1)*(\orig-2)/6}

\statement{平面上有 \line 条直线, 其中 \orig 条通过原点.
没有其它的点会位于多于两条直线上,
没有两条直线互相平行. <p>
这 \line 条直线可以构成多少个三角形?}

\answer{三角形个数}{\sol}
