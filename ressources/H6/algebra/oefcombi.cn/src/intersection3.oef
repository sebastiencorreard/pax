\title{交点 III}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{coinc=random(3..8)}
\integer{sol=binomial(\tot,2)-binomial(\coinc,2)+1}

\statement{平面内两条直线至多有一个交点.
现在有 \tot 条直线, 其中 \coinc 条通过原点,
问这些直线间至多有多少个交点?}

\answer{交点数}{\sol}
