\title{握手}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{couple=random(5..10)}
\integer{single=random(10..20)}
\integer{total=2*\couple+\single}
\integer{ans=(\total*(\total-1))/2-\couple}

\statement{\couple 对夫妻和 \single 位单身男女一起参加一次聚会.
聚会开始时每个参加者都要相互握一次手, 但夫妻之间不握手.
问总共有几次握手?}

\answer{握手数}{\ans}
