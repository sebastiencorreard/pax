\title{组合数 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{tot=random(10..30)}
\integer{first=random(3..\tot-3)}
\integer{binom=binomial(\tot,\first)}

\statement{若 
C<sub><i>n</i></sub><sup>\first</sup>=\binom,
问 <i>n</i>&nbsp;等于多少 ?}

\answer{<i>n</i>}{\tot}
