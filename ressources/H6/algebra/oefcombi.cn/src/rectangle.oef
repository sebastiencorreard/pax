\title{长方形}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{hori=random(3..8)}
\integer{vert=random(3..8)}
\integer{tot=\hori+\vert}
\integer{sol=(\hori*\vert*(\hori-1)*(\vert-1))/4}

\statement{平面上有 \tot 条直线, 其中 \hori 条水平线,
\vert 条竖直线. <p>
问这 \tot 条直线构成多少个长方形?}

\answer{长方形个数}{\sol}
