\title{晚餐桌 3}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{pairs=random(3..7)}
\integer{tot=2*\pairs}
\integer{sol=2*factorial(\pairs)*2^\pairs}

\statement{有 \pairs 对夫妻围着饭桌共进晚餐. 
有多少种方法为这 \tot 个人安排座位,
使得每位丈夫坐在妻子的旁边?}

\answer{方法数}{\sol}
