\title{糖果}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{girls=random(2..6)}
\integer{boys=random(2..6)}
\integer{children=\girls+\boys}
\integer{type=random(1..8)}
\integer{girlmin=item(\type,1,0,1,1,2,2,2,3)}
\integer{boymin =item(\type,0,1,1,2,1,2,3,2)}
\integer{correct=\girlmin*\girls+\boymin*\boys}
\text{method=item(\type,
    每个女孩至少得到一颗,
    每个男孩至少得到一颗,
    每个小孩至少得到一颗,
    每个女孩至少得到一颗而每个男孩至少得到 2 颗,
    每个女孩至少得到 2 颗而每个男孩至少得到一颗,
    每个小孩至少得到 2 颗,
    每个女孩至少得到 2 颗而每个男孩至少得到 3 颗,
    每个女孩至少得到 3 颗而每个男孩至少得到 2 颗,
)}
\integer{dist=random(3..7)}
\integer{bonbons=\correct+\dist}
\integer{sol=binomial(\dist+\children-1,\dist)}

\statement{有 \bonbons 颗糖果分给 \girls 个女孩和 \boys 个男孩,
要求\method, 问有多少种分法?}

\answer{分法}{\sol}
