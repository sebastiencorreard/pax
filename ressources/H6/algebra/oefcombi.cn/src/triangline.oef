\title{直线上的三角形}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{l1=random(4..15)}
\integer{l2=random(4..15)}
\integer{tot=\l1+\l2}
\integer{sol=\l1*\l2*(\l1+\l2-2)/2}

\statement{平面内有 2 条平行线. 第一条直线上有
\l1 个点, 第二条直线上有 \l2 个点.
这 \tot 个点可以构成多少个三角形?}

\answer{三角形个数}{\sol}
