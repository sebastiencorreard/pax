\title{子集}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(10..25)}
\integer{first=random(3..6)}
\integer{binom=binomial(\tot,\first)}

\statement{一个有限集 <i>S</i> 含有 \binom
个由 \first 个元素构成的子集. 
问 <i>S</i>&nbsp;有多少个元素?}

\answer{|<i>S</i>|}{\tot}
