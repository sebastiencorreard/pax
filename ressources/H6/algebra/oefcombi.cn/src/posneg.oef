\title{正负数}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{1000000}

\integer{pos=random(3..8)}
\integer{neg=random(3..8)}
\integer{tot=\pos+\neg}
\text{qlist=小于零的乘积,
大于零的乘积,
小于零的商,
大于零的商}
\integer{type=random(1..4)}
\text{question=item(\type,\qlist)}
\text{slist=\pos*\neg,\pos*(\pos-1)+\neg*(\neg-1),
2*\pos*\neg,2*(\pos*(\pos-1)+\neg*(\neg-1))}
\integer{sol=item(\type,\slist)}

\statement{设 <i>S</i> 是由 \pos 个正整数和
\neg 个负整数构成的集合. 这 \tot 个整数的绝对值都是不同的素数. <p>
那么 <i>S</i> 中两个不同数的\question有多少个?}

\answer{个数}{\sol}
