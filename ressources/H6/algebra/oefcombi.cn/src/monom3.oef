\title{单项式 3}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{type=random(1..8)}
\integer{a=item(\type,2,2,2,3,3,4,5,5)}
\integer{b=item(\type,3,3,5,4,5,5,6,7)}
\integer{c=item(\type,5,7,7,5,7,7,7,8)}
\integer{degree=random(4..15)}
\integer{sol=(\degree+2)*(\degree+1)/2}

\statement{有多少个如下形式的整数
\a<sup><i>a</i></sup>&middot;\b<sup><i>b</i></sup>&middot;\c<sup><i>c</i></sup>,
其中指数 <i>a,b,c</i> 是满足
<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;\degree 的非负整数?}

\hint{底数 \a, \b, \c 是互素的, 对于不同的 <i>a,b,c</i>,
这些整数互不相同. 因此只需考虑使
<i>a</i>+<i>b</i>+<i>c</i>&nbsp;=&nbsp;\degree 的不同可能性.}
\answer{整数个数}{\sol}
