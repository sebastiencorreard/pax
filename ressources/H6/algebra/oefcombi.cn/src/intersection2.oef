\title{交点 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{tot=random(15..40)}
\integer{par=random(3..8)}
\text{dir=random(水平线,竖直线)}
\integer{sol=binomial(\tot,2)-binomial(\par,2)}

\statement{平面内两条直线至多有一个交点.
现在有 \tot 条直线, 其中 \par 条是\dir
(因而是平行的).
问这些直线间至多有多少个交点?}

\answer{交点数}{\sol}
