\title{公交车和司机}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{num=random(3..6)}
\integer{distr=factorial(\num)^2}
\statement{有 \num 辆公交车, \num 位司机和 \num 位售票员. 
要给每辆公交车各配一位司机和一位售票员, 问有多少种分配法?}

\answer{方法数}{\distr}
