\title{定长分划}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{1000000}

\integer{dist=random(3..10)}
\integer{parts=random(4..9)}
\integer{min=random(0..3)}
\integer{n=\dist+\min*\parts}
\text{order=random(递增,递减)}
\integer{sol=binomial(\dist+\parts-1,\parts-1)}

\statement{有多少个方法写成
<p><center>
 \n&nbsp;=&nbsp;<i>n</i><sub>1</sub>+<i>n</i><sub>2</sub>+...+<i>n</i><sub>\parts</sub>&nbsp;,
</center> <p>
其中 <i>n</i><sub><i>i</i></sub> 是大于或等于
\min 的元素, 按\order次序排列?}

\answer{方法数}{\sol}
