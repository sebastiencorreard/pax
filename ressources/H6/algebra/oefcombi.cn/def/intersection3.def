 !exit
!endif

tmp0=!randint 15, 40

val6=$[rint($(tmp0))]
tmp0=!randint 3, 8

val7=$[rint($(tmp0))]
val8=$[rint(binomial($val6,2)-binomial($val7,2)+1)]
replyname1=交点数
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()平面内两条直线至多有一个交点.	现在有 $val6 条直线, 其中 $val7 条通过原点,	问这些直线间至多有多少个交点?
$()
