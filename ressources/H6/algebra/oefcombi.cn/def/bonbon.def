tmp0=!randint 2, 6

val6=$[rint($(tmp0))]
tmp0=!randint 2, 6

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 8

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 1,0,1,1,2,2,2,3

val10=$[rint($(tmp0))]
tmp0=!item $val9 of 0,1,1,2,1,2,3,2

val11=$[rint($(tmp0))]
val12=$[rint($val10*$val6+$val11*$val7)]
tmp0=!item $val9 of 	    每个女孩至少得到一颗,	    每个男孩至少得到一颗,	    每个小孩至少得到一颗,	    每个女孩至少得到一颗而每个男孩至少得到 2 颗,	    每个女孩至少得到 2 颗而每个男孩至少得到一颗,	    每个小孩至少得到 2 颗,	    每个女孩至少得到 2 颗而每个男孩至少得到 3 颗,	    每个女孩至少得到 3 颗而每个男孩至少得到 2 颗,	

val13=$(tmp0)
tmp0=!randint 3, 7

val14=$[rint($(tmp0))]
val15=$[rint($val12+$val14)]
val16=$[rint(binomial($val14+$val8-1,$val14))]
replyname1=分法
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

