tmp0=!randint 3, 8

val6=$[rint($(tmp0))]
tmp0=!randint 3, 8

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=小于零的乘积,	大于零的乘积,	小于零的商,	大于零的商
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val9

val11=$(tmp0)
val12=$val6*$val7,$val6*($val6-1)+$val7*($val7-1),	2*$val6*$val7,2*($val6*($val6-1)+$val7*($val7-1))
tmp0=!item $val10 of $val12

val13=$[rint($(tmp0))]
replyname1=个数
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

