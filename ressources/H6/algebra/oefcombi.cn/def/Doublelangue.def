!set title=两种语言
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 26

val6=$[rint($(tmp0))]
tmp0=!randint ceil($val6/2), $val6-2

val7=$[rint($(tmp0))]
tmp0=!randint ceil($val6/2), $val6-2

val8=$[rint($(tmp0))]
val9=$[rint($val7+$val8-$val6)]
val10=$[rint($val7-$val9)]
val11=$[rint($val8-$val9)]
val12=$[rint($val10*$val8+$val9*($val8-1)-$val9*($val9-1)/2)]
replyname1=选择数
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()在一个班级的 $val6 个学生中, $val7 个学英语,	$val8 个学法语. (每个学生至少学一种.)	<p>	现在从这 $val6 个学生中挑选 2 人, 要求一个学英语,	另一个学法语. 有多少种可能的选法?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

