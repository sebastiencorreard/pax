!set title=计算机房 I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=12

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 8, 12

val6=$[rint($(tmp0))]
tmp0=!randint ceil($val6/2), $val6-3

val7=$[rint($(tmp0))]
t_=!replace internal \( by ( in binomial($val6,$val7)*	truncate(factorial($val7))
tmp0=!exec pari $t_

val8=$(tmp0)
replyname1=方式数
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()学校有一个计算机房, 其中有 $val6 台机器.	有 $val7 个学生的小组在内上课.	有多少种方式使每个学生各分配到一台机器?
$()
!exit

