!set title=班委会
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=1000000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 9

val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
val12=$[rint($val9+$val10+$val11)]
val13=$[rint(factorial($val6)/(factorial($val9)*factorial($val6-$val9)))]
val14=$[rint(factorial($val7)/(factorial($val10)*factorial($val7-$val10)))]
val15=$[rint(factorial($val6)/(factorial($val9+1)*factorial($val6-$val9-1)))]
val16=$[rint(factorial($val7)/(factorial($val10+1)*factorial($val7-$val10-1)))]
val17=$[rint(factorial($val6)/(factorial($val9+2)*factorial($val6-$val9-2)))]
val18=$[rint(factorial($val7)/(factorial($val10+2)*factorial($val7-$val10-2)))]

!ifval $val11=1
val19=$[rint($val13*$val16+$val15*$val14)]
!else
val19=$[rint(	    $val13*$val18+$val15*$val16+$val17*$val14)]
!endif
replyname1=可能方式数
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()班级里有 $val6 个男孩和 $val7 个女孩.	为了组成一个 $val12 人的班委会, 要求其中至少 $val9 个男孩和	$val10 女孩, 问有多少种可能方式?
$()
!exit

