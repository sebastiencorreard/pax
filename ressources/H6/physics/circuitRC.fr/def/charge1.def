val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=!rawmath 1-exp(-temps/tau)
tmp0=!random -3, -2

val7=$[$(tmp0)]
val8=$[round(100000*10^$val7)/100000]
tmp0=!randitem 10000,33000,47000,56000,100000

val9=$[$(tmp0)]
val10=$[$val8/$val9]
val11=$[3.1415927]
val12=$[rint(300)]
val13=$[rint($val12/4)]
val14=$[rint($val13/2)]
val15=$[8*$val11/10]
val16=$[1*$val11/10]
val17=51,51,51
val18=hline 0, $val12/10 ,$val17	hline 0, 2*$val12/10 ,$val17	hline 0, 3*$val12/10 ,$val17	hline 0, 4*$val12/10 ,$val17	hline 0, 5*$val12/10 ,white	hline 0, 6*$val12/10 ,$val17	hline 0, 7*$val12/10 ,$val17	hline 0, 8*$val12/10 ,$val17	hline 0, 9*$val12/10 ,$val17	vline $val12/10, 0 ,$val17	vline 2*$val12/10, 0 ,$val17	vline 3*$val12/10, 0 ,$val17	vline 4*$val12/10, 0 ,$val17	vline 5*$val12/10, 0 ,white	vline 6*$val12/10, 0 ,$val17	vline 7*$val12/10, 0 ,$val17	vline 8*$val12/10, 0 ,$val17	vline 9*$val12/10, 0 ,$val17	
val19=0.1,0.05,0.02,0.01,0.005,0.002,0.001,0.0005
val20=100 ms/c, 50 ms/c, 20 ms/c, 10 ms/c, 5 ms/c, 2 ms/c, 1 ms/c, 500 us/c
!for val21 =1 to 8 
val22=$[$val12/10/$(val19[$val21])]
tmp0=!replace tau by $val8 in $val6

val23=!rawmath $val12*(1-($(tmp0)))
tmp0=!replace internal temps by x/$val22 in $val23

val23=!rawmath $(tmp0)
val24=!rawmath $val12*(1-x/$val22/$val8)
!readproc oef/draw.phtml $val12, $val12 \
    fill $val12/2,$val12/2,black	    $val18	    plot green, $val23	    plot darkslategrey, $val24	    
tmp0=$ins_url
val25=$(tmp0)	  
val26=$[$val15+($val16-$val15)/8*($val21-1)]
val27=$[1.8]
val28=$[8]
!for val29 =1 to 8 
val30=$[$val15+($val16-$val15)/8*($val29-1)]
val31=$[cos($val30)]
val32=$[sin($val30)]
val33=$[$val13/2+($val13/$val27/2+4)*$val31]
val34=$[$val13/2-($val13/$val27/2+4)*$val32]
val35=$[$val13/2+($val13/$val27/2+9)*$val31]
val36=$[$val13/2-($val13/$val27/2+9)*$val32]
!if j=1 
val37=segment $val33,$val34,$val35,$val36,grey
!else
val37=$val37	                      segment $val33,$val34,$val35,$val36,black
!endif
!next
val31=$[cos($val26)]
val32=$[sin($val26)]
val38=$[$val13/2+($val13/$val27/2-4)*$val31]
val39=$[$val13/2-($val13/$val27/2-4)*$val32]
val40=$[$val13/2-($val13/$val27/2-4)*$val31]
val41=$[$val13/2+($val13/$val27/2-4)*$val32]
val33=$[$val13/2+($val13/$val27/2+$val28)*$val31]
val34=$[$val13/2-($val13/$val27/2+$val28)*$val32]
val35=$[$val13/2+($val13/$val27/2)*$val31+$val28/2*$val32]
val36=$[$val13/2-($val13/$val27/2)*$val32+$val28/2*$val31]
val42=$[$val13/2+($val13/$val27/2)*$val31-$val28/2*$val32]
val43=$[$val13/2-($val13/$val27/2)*$val32-$val28/2*$val31]
!readproc oef/draw.phtml $val13, $val13 \
    fcircle $val13/2, $val13/2, $val13/$val27+3, black	    fpoly black,$val33,$val34,$val35,$val36,$val42,$val43	    fcircle $val13/2, $val13/2, $val13/$val27, slategrey	    segment $val38, $val39, $val40, $val41, white	    fcircle $val38, $val39, 5, red	    $val37	    text black, 10, $val13-15, medium, $(val20[$val21])	    text blue, 10,0,medium, -	    text blue, $val13-15,0,medium, +	    
tmp0=$ins_url
val44=$(tmp0)	  
!if $val21=1 
val45=$val25
val46=$val44
!else
val45=$val45 , $val25
val46=$val46, $val44
!endif
!next
replytype1=units
replyname1=-
replygood1=$val8 s
replytype2=units
replyname2=-
replygood2=$val10 F
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

