!for m_l=1 to 8 
$()	 bouton[$m_l-1] = '$(val46[$m_l])';	 
!next
$()	 
!for m_m=1 to 8 
$()	 basetemps[$m_m-1] = '$(val20[$m_m])';	 
!next
