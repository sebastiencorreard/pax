!set title=identification graphiques2 (circuit RC)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
author=M.Markey
email=benoit.markey@ac-lille.fr
computeanswer=no
precision=10

ansorder=r,r,r,r
varcnt=40
prevarcnt=39
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 6

val6=$[rint($(tmp0))]
val7=1e5,5e5
tmp0=!shuffle $val7

val8=$(tmp0)
val9=2e-6,4e-6
tmp0=!shuffle $val9

val10=$(tmp0)
val11=$[$(val8[1])*$(val10[1])]
val12=$[rint($(val8[1])/1000)]
val13=$[rint($(val8[2])/1000)]
val14=$[rint($(val10[1])*1e6)]
val15=$[rint($(val10[2])*1e6)]
val16=$[$(val8[2])*$(val10[1])]
val17=$[$(val8[1])*$(val10[2])]
val18=$[$(val8[1])*$(val10[2])]
val19=$[$(val8[2])*$(val10[2])]
val20=$[$(val8[2])*$(val10[1])]
val21=$[$val6/5]
val22=$[2*$val6/5]
val23=$[3*$val6/5]
val24=$[4*$val6/5]
val25=$[$val6/2]
val26=$[2*$val11]
val27=$[2*$val26]
val28=$[3*$val26]
val29=$[4*$val26]
val30=!rawmath $val6*(1-exp(-x/$val11))
val31=!rawmath $val6/2*(1-exp(-x/$val16))
val32=!rawmath $val6/2*(1-exp(-x/$val11))
val33=!rawmath $val6*(1-exp(-x/$val17))
tmp=!trim $val12,$val14,$val6,rouge	$val13,$val14,$val25,noire	$val12,$val14,$val25,violette	$val12,$val15,$val6,verte
val34=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 3

val35=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val34

tmp=!row $val35 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val36=$(tmp0)
!for val37 =$val35+1 to 4 
tmp=!translate internal $	$ to ; in $val34

tmp=!row $val37 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val36=$val36,$(tmp0)
!next
!for val38 =1 to $val35-1 
tmp=!translate internal $	$ to ; in $val34

tmp=!row $val38 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val36=$val36,$(tmp0)
!next
val39=$(val36[1])
val40=$(val36[2])
val41=$(val36[3])
val42=$(val36[4])
replytype1=dragfill
replyname1=reponse1
replygood1=$(val36[4])
replytype2=dragfill
replyname2=reponse2
replygood2=$(val36[8])
replytype3=dragfill
replyname3=reponse3
replygood3=$(val36[12])
replytype4=dragfill
replyname4=reponse4
replygood4=$(val36[16])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()			A l'aide d'un logiciel adapté, un élève simule la charge d'un condensateur de capacité C.	 Il trace dans chaque cas la courbe représentant les variations de u<sub>c</sub>,	 tension aux bornes du condensateur, en fonction du temps t. Il renouvelle le tracé de courbes	 pour différentes valeurs de R, résistance du conducteur ohmique du circuit, de C et de E, 	tension sous laquelle le condensateur est chargé. Il obtient les 4 courbes suivantes:<p>	<center>	 
!read oef/draw.phtml 300,300 \
xrange 0,10*$val11	yrange 0,1.1*$val6	parallel 0,0,0,1.1*$val6,10*$val11/10,0,11,blue	parallel 0,0,10*$val11,0,0,0.1*$val6,11,blue	arrow 0,$val6/100,10*$val11,$val6/100,10,black	arrow $val11/50,0,$val11/50,1.1*$val6,10,black	text green,9*$val11,($val6/10),small,t(s)	text green, $val11/10,1.1*$val6,small, uc(V)	text black, $val11/10,$val6/5,small,$val21	text black, $val11/10,2*$val6/5,small,$val22	text black, $val11/10,3*$val6/5,small,$val23	text black, $val11/10,4*$val6/5,small,$val24	text black, $val11/10,$val6,small,$val6	text black, 2*$val11,$val6/15,small,$val26	text black, 4*$val11,$val6/15,small,$val27	text black, 6*$val11,$val6/15,small,$val28	text black, 8*$val11,$val6/15,small,$val29	text black, $val11/10,$val6/15,small,0	plot red,$val30	plot black,$val31	plot purple,$val32	plot green,$val33	 
$()</center>	<p>	Compléter le tableau en associant les courbes (repérées par leurs couleurs)	 avec les différents cas. Pour cela cliquer et déplacer une étiquette bleue pour l'amener à sa place dans le tableau:<p>	<center><table border =2>		<tr><th>cas</th><th>cas a</th><th>cas b</th><th>cas c</th><th>cas d</th></tr>		<tr><th>R(kohm)</th><th>$(val36[1])</th><th>$(val36[5])</th><th>$(val36[9])</th><th>$(val36[13])</th></tr>		<tr><th>C(µF)</th><th>$(val36[2])</th><th>$(val36[6])</th><th>$(val36[10])</th><th>$(val36[14])</th></tr>	<tr><th>E(V)</th><th>$(val36[3])</th><th>$(val36[7])</th><th>$(val36[11])</th><th>$(val36[15])</th></tr>		<tr><th>Courbe</th><td> 
!read oef/embed.phtml reply1 
$()</td><td> 
!read oef/embed.phtml reply2 
$()</td><td> 
!read oef/embed.phtml reply3 
$()</td><td> 
!read oef/embed.phtml reply4 
$()</td></tr>	</table></center>	
$()
!exit

