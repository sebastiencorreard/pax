 <tr> 
  <td rowspan="3"> <img src=\imagedir/RC2.png>
 </td> 
<td> \embed{reply 1,150x50}
</td>  </tr>
<tr><td>\embed{reply 2,150x50} </td> </tr>
<tr><td> \embed{reply 3,150x50}</td> </tr>  
</table>}

\if{\im[1] issametext RC3.png}{
    <table> 

 <tr> 
  <td rowspan="3"> <img src=\imagedir/RC3.png>
 </td> 
<td> \embed{reply 3,150x50}
</td>  </tr>
<tr><td>\embed{reply 2,150x50} </td> </tr>
<tr><td> \embed{reply 1,150x50}</td> </tr>  
</table>}

\if{\im[1] issametext RC4.png}{
    <table> 
<tr><td> \embed{reply 3,150x50}</td><td>&nbsp; </td>
 <tr> 
  <td rowspan="3"> <img src=\imagedir/RC4.png>
 </td> 
<td> \embed{reply 2,150x50}
</td>  </tr>
<tr><td>&nbsp; </td> </tr>
<tr><td> \embed{reply 1,150x50}</td> </tr>  
</table>
}


 }
\if{\step=2}{
<script language="javascript">
  var ecran = new Array(8);
  var bouton = new Array(8);
  var choix = 0;
  var basetemps = new Array(8);
\for{k=1 to 8}{
 /* this is a bug from wims 3.32 (12 October 2003) : var j is not usable !!! */
 ecran[\k-1] = '\ecrans[\k]';
}
\for{l=1 to 8}{
 bouton[\l-1] = '\boutons[\l]';
}
\for{m=1 to 8}{
 basetemps[\m-1] = '\basetemps[\m]';
}

  function inc_choix(){
    if (choix < 7){
      choix = choix + 1;
    }
  }

  function dec_choix(){
    if (choix > 0){
      choix = choix - 1;
    }
  }
  function redraw(){
      document.images['ecran'].src=ecran[choix];
      document.images['bouton'].src=bouton[choix];
  }
</script>
<map name="map1">
  <area shape="rect" coords="0,0,\diam2,\diam" 
    alt=  "tourne à gauche"
    title="tourne à gauche" 
    self.status="tourne à gauche"
    href="javascript:dec_choix();redraw();">
  <area shape="rect" coords="\diam2,0,\diam,\diam" 
    alt=  "tourne à droite"
    title="tourne à droite" 
    self.status="tourne à droite"
    href="javascript:inc_choix();redraw();">
</map>
(étape 2/2)<p>
Un condensateur de capacité C est déchargé au travers d'une résistance R 
( \R \(Omega)). 
Voici l'oscillogramme enregistrant la tension du condensateur précédent. <p>Les puissances de 10 seront tapées selon le modéle: pour entrer 1.8*10<sup>-7</sup>, taper 1.8e-7. Les unités doivent être précisées<p><br>
<table><tr>
<td><img src="\ecrans[1]" name="ecran"></td>
<td align="center">
<font size="-1"><i>L'axe des tensions est gradué en V<p>Réglez la base de temps 
<br>de l'oscillogramme
<br> avec les boutons + et -</i></font><br>
<br><img src='\boutons[1]' name='bouton' border='0' usemap='#map1'>
<br><b>Base de temps</b>
</td>
</tr></table>
<table><tr>
<td align='right'>&Eacute;valuez le temps de relaxation \(tau) : </td>
<td>\embed{reply 4} </td>
</tr><tr>
<td align='right'>Puis calculez la valeur de la capacité C : </td>
<td>\embed{reply 5} </td></tr><tr>
<td align='right'>En déduire la valeur de l'énergie libérée par ce condensateur : </td>
<td>\embed{reply 6} </td></tr>
</tr></table>
}}
\reply{}{Aucun branchement}{type=dragfill}
\reply{}{Voie Ya de l'oscilloscope}{type=dragfill}
\reply{}{Masse}{type=dragfill}
\reply{-}{\tau s}{type=units}
\reply{-}{\C F}{type=units}
\reply{-}{\W J}{type=units}
