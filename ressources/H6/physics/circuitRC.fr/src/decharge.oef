\title{Décharge d'un condensateur}
\author{Georges Khaznadar & B.Markey}
\email{benoit.markey@ac-lille.fr}
\format{html}
\computeanswer{no}
\precision{10}
\function{f=exp(-temps/tau)}
\real {logtau=random(-3..-2)}
\real {tau=round(100000*10^\logtau)/100000}
\real {R=random(10000,33000,47000,56000,100000)}
\real {C=\tau/\R}
\real{E=randint(1..6)}
\real{E9=9*\E/10}
\real{E8=8*\E/10}
\real{E7=7*\E/10}
\real{E6=6*\E/10}
\real{E5=5*\E/10}
\real{E4=4*\E/10}
\real{E3=3*\E/10}
\real{E2=2*\E/10}
\real{E1=\E/10}
\real{W=0.5*\C*\E*\E}

\real{pi=3.1415927}
\integer{dim=300}          \comment{la taille de l'écran d'oscillo}
\integer{diam=\dim/4}      \comment{le diamètre d'un bouton}
\integer{diam2=\diam/2}    \comment{le rayon d'un bouton}
\real{startangle=8*\pi/10} \comment{positions extrêmes ...}
\real{stopangle=1*\pi/10}  \comment{... pour la rotation du bouton}
\text{g20=51,51,51}        \comment{grey 20% -- 255*20%=51}

\text{grille=
hline 0, \dim/10 ,\g20
hline 0, 2*\dim/10 ,\g20
hline 0, 3*\dim/10 ,\g20
hline 0, 4*\dim/10 ,\g20
hline 0, 5*\dim/10 ,\g20
hline 0, 6*\dim/10 ,\g20
hline 0, 7*\dim/10 ,\g20
hline 0, 8*\dim/10 ,\g20
hline 0, 9*\dim/10 ,\g20
arrow 0,\dim,0,0,10, white
text white,0,\dim/10,small,\E9
text white,0,2*\dim/10,small,\E8
text white,0,3*\dim/10,small,\E7
text white,0,4*\dim/10,small,\E6
text white,0,5*\dim/10,small,\E5
text white,0,6*\dim/10,small,\E4
text white,0,7*\dim/10,small,\E3
text white,0,8*\dim/10,small,\E2
text white,0,9*\dim/10,small,\E1
text white,0,0.97*\dim,small,0
arrow 0,\dim,\dim,\dim,10, white
vline \dim/10, 0 ,\g20
vline 2*\dim/10, 0 ,\g20
vline 3*\dim/10, 0 ,\g20
vline 4*\dim/10, 0 ,\g20
vline 5*\dim/10, 0 ,\g20
vline 6*\dim/10, 0 ,\g20
vline 7*\dim/10, 0 ,\g20
vline 8*\dim/10, 0 ,\g20
vline 9*\dim/10, 0 ,\g20
}

\text{bt=0.1,0.05,0.02,0.01,0.005,0.002,0.001,0.0005}
\text{basetemps= 100 ms/c, 50 ms/c, 20 ms/c, 10 ms/c, 5 ms/c, 2 ms/c, 1 ms/c, 500 us/c}
\comment{bt and basetemps have the same meaning, the first is for the machine and the second for humans}

\for {i=1 to 8}{
  \real{div=\dim/10/\bt[\i]}
  \comment{the width dim of the image represents 10*bt[i] seconds}
  \function {f1=\dim*(1-(wims(replace tau by \tau in \f)))}
  \function {f1=wims(replace internal temps by x/\div in \f1)}
  \function {f2=\dim*(x/\div/\tau)}
  \text{ecran1= draw(\dim, \dim
    fill \dim/2,\dim/2,grey
    \grille
    plot green, \f1
    plot darkslategrey, \f2
   )
  }
  \real{angle=\startangle+(\stopangle-\startangle)/8*(\i-1)}
  \real{bratio=1.8} \comment{increase bratio will decrease the button}
  \real{pointe=8}   \comment{pointe : length of the rotating index}
  \for{j=1 to 8}{
      \real{a=\startangle+(\stopangle-\startangle)/8*(\j-1)}
      \real{c=cos(\a)}
      \real{s=sin(\a)}
      \real{x1=\diam/2+(\diam/\bratio/2+4)*\c}
      \real{y1=\diam/2-(\diam/\bratio/2+4)*\s}
      \real{x2=\diam/2+(\diam/\bratio/2+9)*\c}
      \real{y2=\diam/2-(\diam/\bratio/2+9)*\s}
      \if{j=1}{\text{graduations= segment \x1,\y1,\x2,\y2,grey}}
              {\text{graduations= \graduations
                      segment \x1,\y1,\x2,\y2,black}
              }
  }
  \real{c=cos(\angle)}
  \real{s=sin(\angle)}
  \real{xcred=\diam/2+(\diam/\bratio/2-4)*\c}
  \real{ycred=\diam/2-(\diam/\bratio/2-4)*\s}
  \real{xcred1=\diam/2-(\diam/\bratio/2-4)*\c}
  \real{ycred1=\diam/2+(\diam/\bratio/2-4)*\s}
  \real{x1=\diam/2+(\diam/\bratio/2+\pointe)*\c}
  \real{y1=\diam/2-(\diam/\bratio/2+\pointe)*\s}
  \real{x2=\diam/2+(\diam/\bratio/2)*\c+\pointe/2*\s}
  \real{y2=\diam/2-(\diam/\bratio/2)*\s+\pointe/2*\c}
  \real{x3=\diam/2+(\diam/\bratio/2)*\c-\pointe/2*\s}
  \real{y3=\diam/2-(\diam/\bratio/2)*\s-\pointe/2*\c}
  \text{bouton1= draw(\diam, \diam
    fcircle \diam/2, \diam/2, \diam/\bratio+3, black
    fpoly black,\x1,\y1,\x2,\y2,\x3,\y3
    fcircle \diam/2, \diam/2, \diam/\bratio, slategrey
    segment \xcred, \ycred, \xcred1, \ycred1, white
    fcircle \xcred, \ycred, 5, red
    \graduations
    text black, 10, \diam-15, medium, \basetemps[\i]
    text blue, 10,0,medium, -
    text blue, \diam-15,0,medium, +
   )
  }
  \if{\i=1}{
    \text{ecrans=\ecran1}
    \text{boutons=\bouton1}
  }{
    \text{ecrans=\ecrans , \ecran1}
    \text{boutons=\boutons, \bouton1}
  }
}

\hint{ 
<p>Le temps de relaxation se calcule selon : \(tau) = R \(times) C<p>
L'écart entre la tension instantanée du condensateur et sa limite est
divisé par 2 au bout d'une durée 0,69 \(times) \(tau).<p>
La tangente à la courbe à l'instant t=0 coupe l'asymptote à l'abscisse
t = \(tau).<p>
Quelquefois, le temps de montée de la tension est si court qu'on ne voit
rien sur l'oscillogramme, tant que la base de temps n'est pas bien
réglée.
}
\text{image=RC1.png,RC2.png,RC3.png,RC4.png}
\text{im=shuffle(\image)}



\steps{reply1, reply2, reply3
reply4, reply5,reply6}

\statement{
\if{\step=1}{(étape 1/2)<p>Placer correctement les connexions de l&#8217;oscilloscope afin d&#8217;observer la tension Uc aux bornes du condensateur. Le condensateur est étudié en convention récepteur. Les 3 étiquettes doivent être placées.<p> <font size="5" face="times" color="green"> ATTENTION:pour accéder à la deuxième étape, vous DEVEZ réussir cette premiére étape</font><p>


\if{\im[1] issametext RC1.png}{
