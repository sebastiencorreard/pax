\title{identification graphiques1 (circuit RC)}
\language{fr}

\author{M.Markey}
\email{benoit.markey@ac-lille.fr}
\computeanswer{no}
\format{html}
\precision{10}


\integer{E=randint(1..6)}
\text{res=1e5,5e5}
\text{R=shuffle(\res)}
\text{cap=2e-6,4e-6}
\text{C=shuffle(\cap)}
\real{tau=\R[1]*\C[1]}
\real{e1=\E/5}

\real{e=\E/\R[1]}
\real{e2=\e/5}
\real{t=2*\tau}
\real{t1=\R[1]*\C[2]}
\real{t2=\R[2]*\C[2]}
\real{t3=\R[2]*\C[1]}
\real{p2=2*\t}
\real{p3=3*\t}
\real{p4=4*\t}
\function{f1=\E*(1-exp(-x/\tau))}
\function{f2=\E*exp(-x/\tau)}
\function{g1=\e*exp(-x/\tau)}
\function{g2=-\e*exp(-x/\tau)}
\text{fonc=\f1,\f2}
\integer{i=randint(1..2)}
\function{f=\fonc[\i]}
\text{rep1=\i=1?charge:décharge}
\text{rep2=\i=1?décharge:charge}

\text{gonc=\g1,\g2}
\integer{ig=randint(1..2)}
\function{g=\gonc[\ig]}
\text{rep3=\ig=1?charge:décharge}
\text{rep4=\ig=1?décharge:charge}
\real{e3=\ig=1?\e:-\e}
\text{yrange=\ig=1?0,1.1*\e:-1.1*\e,0}
\text{fleche=\ig=1?\tau/50,0,\tau/50,1.1*\e3,10,black:\tau/50,1.1*\e3,\tau/50,0,10,black}
\statement{

A l'aide d'un logiciel adapté, un élève simule la charge et la décharge d'un condensateur de capacité C. 
Il trace et imprime un ensemble de courbes, mais il a oublié de préciser sur ses courbes s'il s'agissait de 
la charge ou de la décharge du condensateur. Pour les deux courbes ci-dessous, aidez le à annoter ses courbes.<br>
ATTENTION: les deux courbes ne correspondent pas forcément au même phénomène. Par ailleurs la courbe rouge est 
l'évolution de la tension uc en fonction du temps et la courbe violette correspond à l'évolution du courant dans 
le circuit en fonction du temps, mais dans tous les cas il s'agit du même condensateur<p>
<center>
<table border=2>
<tr><th>
\draw{250,250}{xrange -\tau/10,10*\tau
yrange 0,1.1*\E
parallel 0,0,0,1.1*\E,10*\tau/10,0,11,blue
parallel 0,0,10*\tau,0,0,0.1*\E,11,blue
arrow 0,\E/100,10*\tau,\E/100,10,black
arrow \tau/50,0,\tau/50,1.1*\E,10,black
text green,9*\tau,(\E/10),small,t(s)
text green, \tau/10,\E,small, uc(V)
text black, \tau/10,\E/4,small,\E
text black, 2*\tau,\E/15,small,\t
text black, 4*\tau,\E/15,small,\p2
text black, 6*\tau,\E/15,small,\p3
text black, 8*\tau,\E/15,small,\p4
text black, \tau/10,\E/15,small,0
plot red,\f
}
</th>
<th>
\draw{250,250}{xrange -\tau/10,10*\tau
yrange \yrange
parallel 0,0,0,1.1*\e3,10*\tau/10,0,11,blue
parallel 0,0,10*\tau,0,0,0.1*\e3,11,blue
arrow 0,\e3/100,10*\tau,\e3/100,10,black
arrow \fleche
text green,9*\tau,(\e3/10),small,t(s)
text green, \tau/10,\e3,small, i(A)
text black, \tau/10,\e3/4,small,\e3
text black, 2*\tau,\e3/15,small,\t
text black, 4*\tau,\e3/15,small,\p2
text black, 6*\tau,\e3/15,small,\p3
text black, 8*\tau,\e3/15,small,\p4
text black, \tau/10,\e3/15,small,0
plot purple,\g
}

</th>
</td>
</table>
</center>
}
\choice{la courbe rouge est celle de la }{\rep1 du condensateur}{\rep2 du condensateur}
\choice{la courbe violette est celle de la }{\rep3 du condensateur}{\rep4 du condensateur}
\choice{La constante de temps de la courbe rouge vaut}{\tau s}{\t1 s,\t2 s,\t3 s}