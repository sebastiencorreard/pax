\integer{D=randint(2..7)}
\integer{d1=randint(10..50)}
\real{d2=\d1/10}


\text{d=slib(text/sigunits \d2 cm,2,,cm)}
\real{sol1=(2*\l*\D/\d2)*1e-4}
\text{sol=slib(text/sigunits \sol1 ,2)}

