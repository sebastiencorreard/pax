tmp0=$ins_url
val22=$(tmp0)
val15=0.25,0.5,0.75,1.25
tmp0=!shuffle $val15

val16=$(tmp0)
tmp0=!randint 2, 5

val23=$[rint($(tmp0))]
val18=$val7*2
val24=segment $val18,0,$val18,50,green
!for val25 =2 to $val23 
val18=$val18,$val7*$val25
