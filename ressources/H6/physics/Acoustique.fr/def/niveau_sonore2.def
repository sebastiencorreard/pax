!set title=Niveau sonore 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoît Markey
email=benoit.markey@ac-lille.fr
computeanswer=yes
precision=100

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[1e-12]
tmp0=!randint 10, 139

val7=$[rint($(tmp0))]
val8=$[$val6*10^($val7/10)]
!if $val7<30 
val9=calme
!endif
!if $val7>30 and $val7<61 
val9=bruits courants
!endif
!if $val7>61 and $val7<67 
val9=bruyant
!endif
!if $val7>67 and $val7<90 
val9=pénible
!endif
!if $val7>90 and $val7<120 
val9=dangereux
!endif
!if $val7>120 
val9=seuil de douleur
!endif
val10=calme,bruits courants,bruyant,pénible,dangereux,seuil de douleur
tmp0=!positionof item $val9 in $val10

val11=$[rint($(tmp0))]
replytype1=numeric
replyname1=reponse 1
replygood1=$[$val8 ]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<h2>L' intensité sonore</h2>	Le niveau d'intensité sonore perçue par une personne s'élève à $val7 dB.	 Sachant que le seuil d'audibilité est de 1,0&times;10<sup>-12</sup> W.m<sup>-2</sup>,	calculer l'intensité sonore I correspondant.<br>	I= 
!read oef/embed.phtml reply1, 10 
$()W.m<sup>-2</sup><br>				
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=1
