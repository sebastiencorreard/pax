\title{Acoustique musicale 5}
\author{Benoît Markey}
\email{benoit.markey@ac-lille.fr}
\format{html}
\computeanswer{no}
\precision{100}


----------Détermination fréquence------------
\integer{f=randint(1..5)}
\integer{f0=\f*100}

-----graduations axes-----------
\text{grad_spectre=}
\for{i1=1 to 25}{
\text{grad_spectre=\grad_spectre
segment \i1*100,-3,\i1*100,3,black
segment -10,\i1*4,10,\i1*4,3,black}
}
\text{grad_spectre=\grad_spectre
arrow 0,0,0,100,10,black
arrow 0,0,2600,0,10,black
text black,450,-2,small,500
text black,950,-2,small,1000
text black,1450,-2,small,1500
text black,1950,-2,small,2000
text black, 2500,-3,small, f(Hz)}


------------Spectre1-------------
\text{segA1=segment \f0,0,\f0,50,green}
\text{spectre1=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA1
\grad_spectre
)}



----------spectre2------------
\text{tir1=0.2,0.3,0.5,0.7,1,1.1,1.3,1.5,1.7,1.9}
\text{tir=shuffle(\tir1)}

\integer{n2=randint(2..10)}
\text{segA2=segment \f0,0,\f0,50,green}
\integer{comp=1}
\for{i3=2 to \n2}{
\if{\f0*\i3<2501}{\integer{comp=\comp+1}}
\text{segA2=\segA2
segment \f0*\i3,0,\f0*\i3,50*\tir[\i3],green}
}

\text{spectre2=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA2
\grad_spectre
)}



----------spectre3------------
\text{tir1=0.1,0.3,0.5,0.7,1,1.1,1.3,1.5,1.7,1.9}
\text{tir=shuffle(\tir1)}
\integer{n3=randint(2..10)}
\text{segA3=segment \f0,0,\f0,50,green}
\text{f2=1,2.5,2.8,3.3,4.7,5.5,6.3,6.6,7.5,8.5}
\text{f1=shuffle(\f2)}
\for{i5=2 to \n3}{
\text{f=\f0*\f1[\i5]/4}

\text{segA3=\segA3
segment \f,0,\f,50*\tir[\i5],green}
}

\text{spectre3=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA3
\grad_spectre
)}



------------Spectre4-------------
\text{segA4=segment \f0*3,0,\f0*3,50,green}
\text{spectre4=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA4
\grad_spectre
)}





------------
\matrix{rep1=<img src = "\spectre1">,spectre 1
<img src = "\spectre2">,spectre 2
<img src = "\spectre3">,spectre 3
<img src = "\spectre4">,spectre 4}

\text{choix=shuffle(4)}

\matrix{rep=\rep1[\choix[1];]
\rep1[\choix[2];]
\rep1[\choix[3];]
\rep1[\choix[4];]}

\text{pos1=position(1,\choix)}
\text{pos2=position(2,\choix)}
\text{pos3=position(3,\choix)}
\text{pos4=position(4,\choix)}


\statement{
<h3>
Le spectre A du son obtenu avec un instrument de musique se présente sous la forme:<br></h3>
<center>Spectre A: <br>\rep1[1;1]</center><br>
<h4>On souhaite comparer ce son avec celui obtenu avec d'autres instruments. Voici quelques spectres:</br></h4>
<table>
<tr><th>\rep[1;1]</th><th>\rep[2;1]</th></tr>
<tr><th>Spectre1</th><th>Spectre2</th></tr>
<tr><th>\rep[3;1]</th><th>\rep[4;1]</th></tr>
<tr><th>Spectre3</th><th>Spectre4</th></tr>
</table>
<br>
Parmi les  4 spectres numérotés présentés, (<i>Compléter les champs de réponse uniquement avec des chiffres
 correspondants au numéro du spectre</i>)
<ul>
<li>Le spectre A et le spectre \embed{r1,2} sont égaux</li>
<li>Le spectre A et le spectre \embed{r2,2} sont de même hauteur, mais non égaux.</li>
<li>Les spectres \embed{r3,2} (<i>compléter en séparant par une virgule</i>)
correspondent à des sons purs.</li>
<li>Le spectre correspondant au son le plus aigu est le spectre \embed{r4,2}.</li>
<li>Le spectre \embed{r5,2} correspond à du bruit.</li>
<li>Le spectre \embed{r6,2} correspond à un son complexe et comprend \embed{r7,2} harmoniques (dont la
fondamentale).</li>
</ul>
}
\answer{}{\pos1}{type=text}
\answer{}{\pos2}{type=text}
\answer{}{\pos1,\pos4|\pos4,\pos1}{type=text}
\answer{}{\pos4}{type=text}
\answer{}{\pos3}{type=text}
\answer{}{\pos2}{type=text}
\answer{}{\comp}{type=text}
