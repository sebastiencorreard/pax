\title{Acoustique musicale 4}
\author{Benoît Markey}
\email{benoit.markey@ac-lille.fr}
\format{html}
\computeanswer{no}
\precision{100}


----------Détermination fréquence------------
\integer{f=randint(1..5)}
\integer{f0=\f*100}

-----graduations axes-----------
\text{grad_spectre=}
\for{i1=1 to 25}{
\text{grad_spectre=\grad_spectre
segment \i1*100,-3,\i1*100,3,black}
}
\text{grad_spectre=\grad_spectre
arrow 0,0,0,100,10,black
arrow 0,0,2600,0,10,black
text black,450,-2,small,500
text black,950,-2,small,1000
text black,1450,-2,small,1500
text black,1950,-2,small,2000
text black, 2500,-3,small, f(Hz)}

\text{grad_signal=}
\for{i2=1 to 15}{
\text{grad_signal=\grad_signal
segment \i2*10,-1,\i2*10,1,black}
}
\text{grad_signal=arrow 0,0,0,9,10,black
arrow -1,0,49,0,10,black
\grad_signal
text black,9,-2,small,10
text black,19,-2,small,20
text black,29,-2,small,30
text black,39,-2,small,40
text black, 45,-3,small, t(ms)}


------------Spectre1-------------
\text{segA1=segment \f0,0,\f0,50,green}
\text{spectre1=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA1
\grad_spectre
)}

-----------signal1-------------
\text{signal1=draw(400,200
xrange -1, 50
yrange -10, 10
plotstep 5000
plot red,8*(sin(2*\f0*3.14*x/1000))
\grad_signal
)}

----------spectre2------------
\text{tir1=0.25,0.5,0.75,1.25}
\text{tir=shuffle(\tir1)}

\integer{n2=randint(2..5)}
\text{freq=\f0}
\text{segA2=segment \f0,0,\f0,50,green}

\for{i3=2 to \n2}{
\text{freq=\freq,\f0*\i3}
\text{segA2=\segA2
segment \f0*\i3,0,\f0*\i3,50*\tir[\i3],green}
}

\text{spectre2=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA2
\grad_spectre
)}

-----------signal2-------------
\text{signal2=draw(400,200
xrange -1, 50
yrange -10, 10
plotstep 5000
plot red,4*(sin(2*\f0*3.14*x/1000)+sin(2*2*\f0*3.14*x/1000))
\grad_signal

)}

----------spectre3------------
\text{tir1=0.25,0.5,0.75,1.25}
\text{tir=shuffle(\tir1)}

\integer{n3=randint(2..5)}
\text{freq=\f0*2}
\text{segA3=segment \freq,0,\freq,50,green}

\for{i5=2 to \n3}{
\text{freq=\freq,\f0*\i5}
\text{segA3=\segA3
segment \f0*2*\i5,0,\f0*2*\i5,50*\tir[\i5],green}
}

\text{spectre3=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA3
\grad_spectre
)}

-----------signal3-------------
\text{signal3=draw(400,200
xrange -1, 50
yrange -10, 10
plotstep 5000
plot red,4*(sin(2*\f0*2*3.14*x/1000)+sin(2*2*\f0*2*3.14*x/1000))
\grad_signal

)}

------------Spectre4-------------
\text{segA4=segment \f0*2,0,\f0*2,50,green}
\text{spectre4=draw(400,200
xrange -100, 2700
yrange -10, 100
\segA4
\grad_spectre
)}

-----------signal4-------------
\text{signal4=draw(400,200
xrange -1, 50
yrange -10, 10
plotstep 5000
plot red,8*(sin(2*\f0*2*3.14*x/1000))
\grad_signal
)}



------------
\text{choix1= <img src = "\spectre1">,<img src = "\spectre2">,<img src = "\spectre3">,<img src = "\spectre4">}
\text{choix2=<img src = "\signal1">,<img src = "\signal2">,<img src = "\signal3">,<img src = "\signal4">}


\statement{
On réalise l'acquisition de différents signaux musicaux dont on trace le spectre.</br>
Associer chaque spectre à son signal.</br>
\embed{reply1, 200 x 400 x 400}
}
\answer{Réponse }{\choix1;\choix2 }{ type=correspond }{option=split}
