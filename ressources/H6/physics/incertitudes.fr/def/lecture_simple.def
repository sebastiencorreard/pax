tmp0=!randitem 0.1,0.5,1,2,10

val6=$[$(tmp0)]
!if $val6=0.1 
val7=$[rint(3)]
!readproc slib/text/sigunits 0.1,1 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!random 20, 70

val9=$[$(tmp0)]
!endif
!if $val6=0.5 
val7=$[rint(3)]
!readproc slib/text/sigunits 0.3,1 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!random 20, 70

val9=$[$(tmp0)]
!endif
!if $val6=1 
val7=$[rint(2)]
!readproc slib/text/sigunits 1,1 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!random 20, 70

val9=$[$(tmp0)]
!endif
!if $val6=2 
val7=$[rint(2)]
!readproc slib/text/sigunits 2,1 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!random 20, 59

val9=$[$(tmp0)]
!endif
!if $val6=10 
val7=$[rint(1)]
!readproc slib/text/sigunits 10,1 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!random 20, 25.5

val9=$[$(tmp0)]
!endif
val10=$val8
val11=$val8
val12=$[($val9-20)*$val6+20]
!readproc slib/text/sigunits $val12,$val7 
tmp0=$slib_out
val13=$(tmp0)
!if $val6=0.5 
val14=$[$val13-floor($val12)]
val15=$[floor($val12)]
val16=$[$val15+0.5]
val17=$[$val15+1]
!if $val14<0.35 
!readproc slib/text/sigunits $val15,$val7 
tmp0=$slib_out
val13=$(tmp0)
!endif
!if $val14>0.35 and $val14<0.75 
!readproc slib/text/sigunits $val16,$val7 
tmp0=$slib_out
val13=$(tmp0)
!endif
!if $val14>0.75 
!readproc slib/text/sigunits $val17,$val7 
tmp0=$slib_out
val13=$(tmp0)
!endif
!endif
!if $val6=2 
val15=$[floor($val12)]
val14=$[$val15%2]
val17=$[$val15+1]
!if $val14=0 
!readproc slib/text/sigunits $val15,$val7 
tmp0=$slib_out
val13=$(tmp0)
!else
!readproc slib/text/sigunits $val17,$val7 
tmp0=$slib_out
val13=$(tmp0)
!endif
!endif
val18=$val13
val19=$[rint(20+10*$val6)]
tmp=!trim $val19
val20=!translate internal $	\
$ to ;; in $tmp
val21=$[rint(21)]
val22=text black,25,21,small,20°C	
!for val23 =1 to 5 
val24=$[rint(20+(10*$val6)*$val23)]
val21=$[rint($val21+10)]
tmp=!trim $val20,$val24
val20=!translate internal $	\
$ to ;; in $tmp
val22=$val22	text black,25,$val21,small,$(val20[$val23+1])°C
