!readproc oef/draw.phtml 100,500 \
xrange -0.5, 10*4-0.5	yrange 0, 10*8	fill 1,1,grey	linewidth 1	parallel 18, 20, 22, 20, 0, 1, 10*6+1, 255,220,180	linewidth 3	parallel 18, 20, 22, 20, 0, 10, 10*6+1, 255,220,180	linewidth 2	segment 20,0,20,$val9-0.4,red	fcircle 20,5,62,red	$val22	 
