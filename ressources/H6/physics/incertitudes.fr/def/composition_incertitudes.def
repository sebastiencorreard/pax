 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1000, 3000

val6=$[rint($(tmp0))]
tmp0=!randint 1000, 1500

val7=$[rint($(tmp0))]
val8=$[$val6/$val7]
!readproc slib/text/sigunits $val8,4 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!randitem 10,20,30,40,50,60

val10=$[$(tmp0)]
tmp0=!randitem 10,20,50,100

val11=$[$(tmp0)]
val12=$[$val9*sqrt(($val10/$val7)^2+($val11/$val6)^2)]
!if $val12<0.1 
val13=$[ceil($val12*100)/100]
!readproc slib/text/sigunits $val13,1 
tmp0=$slib_out
val14=$(tmp0)
!else
val13=$[ceil($val12*10)/10]
!readproc slib/text/sigunits $val13,1 
tmp0=$slib_out
val14=$(tmp0)
!endif
!if $val13<0.1 
val15=$[rint(3)]
!else
val15=$[rint(2)]
!endif
!readproc slib/text/sigunits $val8,$val15 
tmp0=$slib_out
val16=$(tmp0)
val17=$val14
val18=v=$val9<br>t=$val7<bt>d=$val6<br>Ut=$val10<br>Ud=$val11<br>Uv=$val12<br>
replytype1=sigunits
replyname1=v
replygood1=$val9
replytype2=numeric
replyname2=U(v)
replygood2=$[$val12]
replytype3=sigunits
replyname3=U(v)
replygood3=$val14
replytype4=sigunits
replyname4=v
replygood4=$val16
replytype5=sigunits
replyname5=U(v)
