\title{Méthode d'Euler}
\author{Benoît,Markey}
\email{benoit.markey@ac-lille.fr}
\computeanswer{no}
\precision{1000}
\integer{d1=randint(7..20)}
\text{d11=slib(text/sigunits \d1,2)}
\real{d=\d1/1000}
\real{V=4/3*pi*(\d/2)^3}
\integer{qb=randint(8000..9000)}
\integer{ql=randint(900..1200)}
\real{m=\qb*\V}
\integer{n=randint(1..2)}
\integer{vis1=randint(8..20)}
\real{vis=\vis1/100}
\real{k= \n=1? 3*pi*\vis*\d : 44/100*pi*(\d*\d)*\ql/8}
\text{ktext=\n=1? 3*\pi*\eta*d :0,44*\pi*d^2*\rho liq/8}
\text{kunit=\n=1? kg/s:kg/m}
\text{vtext=\n=1? v:v^2}
\text{deriveetext = texmath(a*\vtext+b)}
\integer{dt1=randint(3..8)}
\real{dt=\dt1/100}

\real{a=-\k/(\qb*\V)}
\text{a1=slib(text/sigunits \a,2)}
\real{b=9.81*(1-\ql/\qb)}
\text{b1=slib(text/sigunits \b,2)}
\real{vlim=\n=1?-\b1/\a1:(-\b1/\a1)^0.5}
\text{unita= \n=1? s^-1:m^-1}
\integer{t=0}
\integer{v=0}
\integer{temps=0}
\integer{vitesse=0}
\integer{sol=0}
\for{i=1 to 10}{
    \real{t=\t+\dt}
    \text{temps=\temps,\t}
    \real{v=\v+(\a*\v^\n+\b)*\dt}
    \text{v=slib(text/sigunits \v,2)}
    \text{sol=\sol,\v}
    \text{vitesse=\vitesse,\v}
}
\text{v4=slib(text/sigunits \sol[4],2)}
\text{v8=slib(text/sigunits \sol[8],2)}
\text{v10=slib(text/sigunits \sol[10],2)}

\statement{<p><span style="color:#0000FF;">Soit l'équation différentielle suivante:\(\frac{dv}{dt} = \deriveetext\). On cherche à la résoudre la méthode d'Euler.
<br>En prenant \(a=\a1\) et \(b=\b1\), 
compléter le tableau suivant (avec 2 chiffres significatifs):</span></p>
<table class="wimsborder wimscenter">
    <tr><th>\(t\) (s)</th><th>\(v \ (\textrm{m}\cdot \textrm{s}^{-1})\)</th></tr>
\for{j=1 to 3}{
<tr><td>\temps[\j]</td><td>\(\vitesse[\j]\)</td></tr>}
<tr><td>\temps[4]</td><td>\embed{reply1,7}</td></tr>
\for{j2=5 to 7}{
<tr><td>\temps[\j2]</td><td>\(\vitesse[\j2]\)</td></tr>
}
<tr><td>\temps[8]</td><td>\embed{reply2,7}</td></tr>
<tr><td>\temps[9]</td><td>\(\vitesse[9]\)</td></tr>
<tr><td>\temps[10]</td><td>\embed{reply3,7}</td></tr>
</table>}



\answer{v4}{\v4}{type=sigunits}
\answer{v8}{\v8}{type=sigunits}
\answer{v10}{\v10}{type=sigunits}
\feedback{1=1}{La notation 2e-2 signifie \(2.10^{-2}\)}
