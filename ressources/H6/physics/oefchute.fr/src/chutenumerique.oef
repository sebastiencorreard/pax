\title{Chute libre verticale bis}
\author{Benoît,Markey; Marie-Claude, David}
\email{benoit.markey@ac-lille.fr}
\computeanswer{no}
\precision{1000}

Altitude initiale
\integer{z0=randint(1..10)}
\text{z1=slib(text/sigunits \z0,2)}
text{z11=slib(text/sigunits \z0 m,2)}

vitesse initiale
\integer{v2=randint(0..10)}
\integer{s=random(-1,1)}
\real{v0=\s*\v2/10}
\real{v1=abs(\v0)}
\text{v1=slib(text/sigunits \v0 ,2)}
\text{v11=slib(text/sigunits \v1 m/s,2)}

expression de la vitesse et de l'altitude pour l'indication\text{vm=texmath(-gt+\s*v0)}
\text{zm=texmath(-g/2*t^2+\s*v_0*t+z0)}

réponses
\real{t1=(\v0+sqrt(\v0^2+2*9.81*\z0))/(9.81)}
\text{t=slib(text/sigunits \t1 ,2)}
\real{vf1=abs(-9.81*\t+\v0)}
avec les unités
\text{vf=slib(text/sigunits \vf1 m.s^-1,2)}
\text{t=slib(text/sigunits \t1 s,2)}
Pour le dessin du vecteur vitesse
\integer{z3=-40*(\z0+\s*1.5)+480}

