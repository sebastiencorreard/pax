\answer{v<sub>lim1</sub>}{\b3_rep }{type=sigunits}
\answer{\tau<sub>1</sub>}{\c_rep}{type=sigunits}
\answer{v<sub>lim2</sub>}{\vlim2_rep1}{type=sigunits}
\answer{\tau<sub>1</sub>}{\tau_rep1}{type=sigunits}
\answer{v<sub>lim2</sub>}{\vlim2_rep2}{type=sigunits}
\answer{\tau<sub>1</sub>}{\tau_rep2}{type=sigunits}
\answer{v<sub>lim2</sub>}{\vlim2_rep3}{type=sigunits}
\answer{\tau<sub>1</sub>}{\tau_rep3}{type=sigunits}

\help{Le temps caractéristique \tau se détermine en prenant
 l'abscisse du point d'intersection de l'asymptote horizontale 
et de la tangente à l'origine. Voir <a href="http://www.chimix.com/an8/bac8/image/ant803.gif" target="_blank">ici</a>}
