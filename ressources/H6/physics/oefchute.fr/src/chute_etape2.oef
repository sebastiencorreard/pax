\title{Chute libre verticale 2 (par étape)}
\author{Benoît,Markey ; Marie-Claude, David}
\email{benoit.markey@ac-lille.fr}
\computeanswer{no}
\precision{1000}

Altitude initiale
\integer{z0=randint(1..10)}
\text{z1=slib(text/sigunits \z0,2)}
text{z11=slib(text/sigunits \z0 m,2)}

vitesse initiale
\integer{v2=randint(0..10)}
\integer{s=1}
\real{v0=\s*\v2}
\real{v1=abs(\v0)}
\text{v1=slib(text/sigunits \v0 ,2)}
\text{v11=slib(text/sigunits \v1 m/s,2)}

expression de la vitesse et de l'altitude pour renvoyer les réponses de A à l'étape B
\text{vm=texmath(-gt+\s*v0)}
\text{zm=texmath(-g/2*t^2+\s*v_0*t+z0)}

réponses de l'étape B
\real{t1=\v0/9.8}
\text{t=slib(text/sigunits \t1 s,2,s)}

\real{zmax1=\v0^2/(2*9.8)+\z0}
\text{zmax=slib(text/sigunits \zmax1 m,2,m)}

