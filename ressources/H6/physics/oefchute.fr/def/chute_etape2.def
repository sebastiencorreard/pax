!readproc slib/text/sigunits $val15 s,2,s 
tmp0=$slib_out
val16=$(tmp0)
val17=$[$val10^2/(2*9.8)+$val6]
!readproc slib/text/sigunits $val17 m,2,m 
tmp0=$slib_out
val18=$(tmp0)
val19=$[rint(-40*($val6+$val9*1.5)+480)]
!readproc oef/draw.phtml 150,500 \
frect 0,0,150,500,skyblue	arrow 75,500,75,5,10,black	text black,85,10,medium,z	frect 0,500,150,480,brown	text black,70,485,medium,SOL	segment 72,480,78,480,black	segment 72,440,78,440,black	segment 72,400,78,400,black	segment 72,360,78,360,black	segment 72,320,78,320,black	segment 72,280,78,280,black	segment 72,240,78,240,black	segment 72,200,78,200,black	segment 72,160,78,160,black	segment 72,120,78,120,black	segment 72,80,78,80,black	segment 72,40,78,40,black	text black,82,475,small,0	text black,82,435,small,1	text black,82,395,small,2	text black,82,355,small,3	text black,82,315,small,4	text black,82,275,small,5	text black,82,235,small,6	text black,82,195,small,7	text black,82,155,small,8	text black,82,115,small,9	text black,82,75,small,10	text black,82,35,small,11	arrow 75,480,75,440,10,blue	text blue,85,460,medium,i	arrow 77,455,97,455,7,blue	fcircle 75,-40*$val6+480,10,red	text red,90,-40*$val6+480-5,medium,A	arrow 70,-40*$val6+480,70,$val19,10,green	text green,40,(-40*$val6+480+$val19)/2,medium,v	text green,48,(-40*$val6+480+$val19)/2+5,small,0	arrow 32,(-40*$val6+480+$val19)/2-5,52,(-40*$val6+480+$val19)/2-5,7,green 
