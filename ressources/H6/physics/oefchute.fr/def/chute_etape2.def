val7=$(tmp0)
tmp0=!randint 0, 10

val8=$[rint($(tmp0))]
val9=$[rint(1)]
val10=$[$val9*$val8]
val11=$[abs($val10)]
!readproc slib/text/sigunits $val10 ,2 
tmp0=$slib_out
val11=$(tmp0)
!readproc slib/text/sigunits $val11 m/s,2 
tmp0=$slib_out
val12=$(tmp0)
tmp0=!texmath -gt+$val9*v0

val13=$(tmp0)
tmp0=!texmath -g/2*t^2+$val9*v_0*t+z0

val14=$(tmp0)
