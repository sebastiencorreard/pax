$()	<tr><td>$(val33[8])</td><td> 
!read oef/embed.phtml reply8,7 
$()</td></tr>	<tr><td>$(val33[9])</td><td>
!insmath $(val34[9])
$()</td></tr>	<tr><td>$(val33[10])</td><td> 
