!set title=Décroissance radioactive
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit Markey
email=benoit.markey@ac-lille.fr
author=Markey Benoît
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=100

ansorder=r,r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

val6=$[rint($(tmp0))]
tmp0=!randint 1, 20

val7=$[rint($(tmp0))]
val8=$[$val6*10^($val7)]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

val10=$[rint($(tmp0))]
val11=$[$val9*10^($val10)]
val12=$[5*$val11]
tmp0=!randint 2, 4

val13=$[rint($val12/$(tmp0))]
val14=$val8*e^(-x/$val11)
!readproc slib/graphpaper/func_milli ,,0,,$val12 max t(s),$val8 max noyaux,,,,$val14 
tmp0=$slib_out
val15=$(tmp0)
!readproc oef/draw.phtml 300,300 \
	$val15 
tmp0=$ins_url
val16=$(tmp0)
val17=<img src="$val16" alt="graphe">
val18=$[rint(ln(2)*$val11)]
val19=$[5*$val11/80]
val20=$[$val18-$val19]
val21=$[$val18+$val19]
val22=$[1/$val11]
val23=$[$val22*$val8]
replytype1=range
replyname1=
replygood1=!rawmath $val20,$val21
replytype2=numeric
replyname2=
replygood2=$[$val22]
replytype3=numeric
replyname3=
replygood3=$[$val23]
replytype4=case
replyname4=
replygood4=Bq
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On considère une population initiale de $val8 noyaux d'isotopes 	radioactifs et on suit l'évolution du nombre de noyaux radioactifs 	au cours du temps. <br>			<div>	$val17</div>					A l'aide de la courbe précédente déterminez:	<ol>	<li>La demi-vie radioactive de cet isotope:  
!read oef/embed.phtml reply1,10 
$() s	<li>La constante radioactive:  
!read oef/embed.phtml reply2,10 
$() s<sup>-1</sup>	<li>L'activité initiale de cet échantillon:  
!read oef/embed.phtml reply3,10 
$()	<li>Quelle est le symbole de son unité?:  
!read oef/embed.phtml reply4,10 
$()	</ol>			
$()
