\title{Décroissance radioactive}
\author{Benoit Markey}
\email{benoit.markey@ac-lille.fr}


\range{-5..5}
\author{Markey Benoît}

\computeanswer{yes}
\format{html}
\precision{100}


\integer{N01=randint(1..9)}
\integer{N02=randint(1..20)}
\real{N0=\N01*10^(\N02)}
\integer{t01=randint(1..9)}
\integer{t02=randint(1..5)}

\real{td=\t01*10^(\t02)}
\real{tmax=5*\td}
\integer{t1=\tmax/randint(2..4)}

\text{N=\N0*e^(-x/\td)}
\text{B=slib(graphpaper/func_milli ,,0,,\tmax max t(s),\N0 max noyaux,,,,\N)}
\text{A=draw(300,300

\B)}
\text{graph=<img src="\A" alt="graphe">}
\integer{rep1=ln(2)*\td}
\real{marge=5*\td/80}
\real{rep1min=\rep1-\marge}
\real{rep1max=\rep1+\marge}
\real{rep2=1/\td}
\real{rep3=\rep2*\N0}
\statement{
On considère une population initiale de \N0 noyaux d'isotopes 
radioactifs et on suit l'évolution du nombre de noyaux radioactifs 
au cours du temps. <br>


<div>
\graph</div>




A l'aide de la courbe précédente déterminez:
<ol>
<li>La demi-vie radioactive de cet isotope: \embed{reply1,10} s
<li>La constante radioactive: \embed{reply2,10} s<sup>-1</sup>
<li>L'activité initiale de cet échantillon: \embed{reply3,10}
<li>Quelle est le symbole de son unité?: \embed{reply4,10}
</ol>


}
\answer{}{\rep1min,\rep1max}{type=range}
\answer{}{\rep2}{type=numeric}
\answer{}{\rep3}{type=numeric}
\answer{}{Bq}{type=text}
