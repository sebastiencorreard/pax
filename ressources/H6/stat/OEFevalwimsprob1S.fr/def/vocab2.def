 !exit
!endif

tmp0=!randitem 4,6

val6=$[rint($(tmp0))]

!ifval $val6=4
val7=tétraédriques
!else
val7=cubiques
!endif
!if $val6=4 
val8=11,22,33,44
val9=12,23,34
val10=13,24
val11=23
val12=11,12,14,23,34
