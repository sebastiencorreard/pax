val10=13,15,35,24,26,46
val11=23,25,35
val12=11,12,14,16,23,25,34,56
!endif
replytype1=fset
replyname1=2 nombres identiques
replygood1=$val8
replytype2=fset
replyname2=2 nombres consécutifs
replygood2=$val9
replytype3=fset
replyname3=2 nombres distincts et de même parité
replygood3=$val10
replytype4=fset
replyname4=2 nombres premiers
replygood4=$val11
replytype5=fset
replyname5=La somme est un nombre premier
replygood5=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On lance deux dés $val7 dont les faces sont numérotées de 1 à $val6.	 On note le résultat du lancer réalisé sous la forme d'un nombre	formé par les deux numéros obtenus, rangés dans l'ordre croissant.	</p>	<div class="wims_question">	Décrire les événements suivants :	<ul><li><label for="reply1">A "les deux nombres sont identiques" :</label>  
!read oef/embed.phtml reply1 
$()</li>	<li><label for="reply2">B  "les deux nombres sont consécutifs" :</label>  
!read oef/embed.phtml reply2 
$()</li>	<li><label for="reply3">C  "les deux nombres sont distincts et de même parité" :</label>  
!read oef/embed.phtml reply3 
$()</li>	<li><label for="reply4">D  "les deux nombres sont premiers et distincts" :</label>  
!read oef/embed.phtml reply4 
$()</li>	<li><label for="reply5">E  "la somme obtenue est un nombre premier" :</label>  
!read oef/embed.phtml reply5 
$()</li>	</ul>	</div>	
$()
