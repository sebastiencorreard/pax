!set title=Loi de probabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 6

val6=$[rint($(tmp0))]
tmp0=!randint 3, 6

val7=$[rint($(tmp0))]

!ifval $val6=$val7
val7=$[rint($val7+1)]
!endif
tmp0=!randint 20, 30

val8=$[rint($(tmp0))]
tmp0=!randitem 50,80,100

val9=$[rint($(tmp0)-$val8)]
tmp0=!randint 36, 42

val10=$[rint($(tmp0)*1000)]
tmp0=!randint 200, 300

val11=$[rint($(tmp0))]
tmp0=!randint 20, 40

val12=$[rint($(tmp0))]
val13=un,deux,trois,quatre,cinq,six,sept,huit,neuf,dix
val14=Survivre une heure sous un mètre de neige,On a une chance sur $(val13[$val6]) de survivre une heure sous un mètre de neige,1/$val6	Partir en vacances d'hiver,Un français sur $(val13[$val7]) part en vacances d'hiver,1/$val7	Etre une femme,Dans cette assemblée&#44; il y a $val8 femmes pour $val9 hommes,$val8/($val8+$val9)	Présenter un défaut,$val10 voitures sont sorties en l'an 2000 de la chaîne de montage de cette entreprise dont $val11 présentaient un défaut,$val11/$val10	Faire de l'équitation,Dans ce club de vacances&#44; $val12 % des personnes font de l'équitation,0.$val12	
tmp0=!shuffle 5

val15=$(tmp0)
val16=
val17=
val18=
!for val19 =1 to 3 
tmp=!translate internal $	$ to ; in $val14

tmp=!row $(val15[$val19]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val20=$(tmp0)
tmp0=!append item $(val20[1]) to $val16

val16=$(tmp0)
tmp0=!append item $(val20[2]) to $val17

val17=$(tmp0)
t_=!rawmath $(val20[3])
val21=!exec pari print($t_)
tmp0=!append item $val21 to $val18

val18=$(tmp0)
!next
replytype1=numexp
replyname1=Phrase 1
replygood1=$(val18[1])
replytype2=numexp
replyname2=Phrase 2
replygood2=$(val18[2])
replytype3=numexp
replyname3=Phrase 3
replygood3=$(val18[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Traduire, en termes de probabilité, les phrases suivantes	correspondant à l'événement A :</p>	<ol>	<li> <span class="wims_emph">A : $(val16[1])</span><br>	 $(val17[1]) : <label for="reply1">
!insmath P(A) =
$()</label>  
!read oef/embed.phtml reply1,7 
$()</li>	<li> <span class="wims_emph">A : $(val16[2])</span><br>	 $(val17[2]) : <label for="reply2">
!insmath P(A) =
$()</label>   
!read oef/embed.phtml reply2,7 
$()</li>	<li> <span class="wims_emph">A : $(val16[3])</span><br>	 $(val17[3]) : <label for="reply3">
!insmath P(A) =
$()</label>  
!read oef/embed.phtml reply3,7 
$()</li>	</ol>	<div class="wims_instruction">	Donner les valeurs exactes éventuellement sous forme de fractions irréductibles.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
