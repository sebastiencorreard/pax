!set title=Univers et équiprobabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
!if $val6=1 
val7=On lance un dé cubique bien équilibré.<br>	On s'intéresse à la sortie du numéro 6.
val8=\(U_1=\lbrace\) le 6 sort; le 6 ne sort pas \(\rbrace\)
val9=\(U_2= \lbrace 1;2;3;4;5;6 \rbrace\)
val10=$[rint(2)]
!endif
!if $val6=2 
val7=On tire au hasard (de manière équiprobable) simultanément deux boules d'une urne	 contenant deux boules rouges et deux boules noires.<br> On s'intéresse aux couleurs des boules	obtenues.
val8=\(U_1=\lbrace\) 2 rouges; 1 rouge et une noire; 2 noires \(\rbrace\)
val9=\(U_2= \lbrace N1N2;R1N1;R1N2;R2N1;R2N2;R1R2 \rbrace\) où on a numéroté N1 et N2 les deux boules noires et R1 et R2 les deux boules rouges
val10=$[rint(2)]
!endif
!if $val6=3 
val7=On lance deux fois une pièce équilibrée.<br> On s'intéresse aux faces	obtenues.<br>On note \(p) l'obtention de pile et \(f) celle de face.
val8=\(U_1 = \lbrace (p,p);(p,f);(f,p);(f,f)\rbrace\)
val9=\(U_2 = \lbrace 2p;2f;1p1f \rbrace\)
val10=$[rint(1)]
!endif
!if $val6=4 
val7=On répartit au hasard (de manière équiprobable) deux boules \(	 b1\) et \(b2\) dans deux boîtes \(A\) et \(B\).<br>	 On s'intéresse au nombre de boules présentes dans la boîte \(A\).
val8=\(U_1 = \lbrace\) 2 dans A; 2 dans B; \(b1\) dans A et \(b2\) dans B; \(b2\) dans A et \(b1\) dans B \(\rbrace\)
val9=\(U_2 = \lbrace 0;1;2 \rbrace\) 
val10=1
!endif
replytype1=radio
replyname1=Univers équiprobable
replygood1=$val10;\(U_1\),\(U_2\)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	$val7</p>	Pour modéliser cette expérience on considère les deux univers suivants :	<ol>	<li> $val8 </li>	<li> $val9 </li>	</ol>	Dans quel univers la loi de probabilité correspondant à l'expérience est-elle équirépartie ?	<div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	
