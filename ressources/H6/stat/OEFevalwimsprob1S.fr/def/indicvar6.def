$().		<table class="wimscenter wimsborder"><tr><th>
!insmath s
$()</th><td> $(val7[1]) </td><td> $(val7[2])	</td><td>$(val7[3])</td><td>$(val7[4])</td><td>$(val7[5])</td></tr>	<tr><th>
!insmath P(S=s)
$()</th><td> 
!read oef/embed.phtml reply1,4 
$()</td><td> 
!read oef/embed.phtml reply2,4 
$()</td><td> 
!read oef/embed.phtml reply3,4 
$()</td>	<td> 
!read oef/embed.phtml reply4,4 
$()</td><td> 
!read oef/embed.phtml reply5,4 
$()</td></tr>	</table>		Calculer l'espérance mathématique de 
!insmath S
$() : <label for="reply6">
!insmath E(S)=
$()</label> 
!read oef/embed.phtml reply6,3 
$()	<p>	Déterminer le nombre de points à attribuer au passage en L	 pour avoir 
!insmath E(S)=$val17
$().</p>	<div class="wimscenter"> <label for="reply7">Nombre de points pour L :</label>  
