!set title=Univers et équiprobabilité 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
!if $val6=1 
val7=On lance un dé tétraédrique bien équilibré dont les faces portent les	numéros 1;1;2;3.<br> On s'intéresse au numéro porté par la face cachée du dé.
val8=\(U_1 = \lbrace 1;2;3\rbrace\)
val9=\(U_2 = \lbrace 1a;1b;2;3 \rbrace) où on appelle \(a\) et \(b\) les faces qui portent le numéro 1
val10=$[rint(2)]
!endif
!if $val6=2 
val7=On tire au hasard (de manière équiprobable) une boule dans une urne contenant	une boule rouge et trois boules noires.<br> On s'intéresse à la couleur de	la boule obtenue.
val8=\(U_1 = \lbrace R;N \rbrace\)
val9=\(U_2 = \lbrace R;N1,N2;N3 \rbrace\) où on a numéroté N1,N2 et N3 les trois boules noires
val10=$[rint(2)]
!endif
!if $val6=3 
val7=On tire au hasard (de manière équiprobable) <b>successivement et avec remise</b>	deux boules d'une urne contenant	une boule rouge et deux boules noires.<br> On s'intéresse aux couleurs des boules	obtenues.
val8=\(U_1 = \lbrace (R,R);(R,N1);(N1,R);(R,N2);(N2,R);(N1,N1);(N1,N2);(N2,N1);(N2,N2)\rbrace\)
val9=\(U_2 = \lbrace\) R et R; R et N1; R et N2; N1 et N1; N1 et N2; N2 et N2\( \rbrace\)
val10=$[rint(1)]
!endif
!if $val6=4 
val7=On tire au hasard (de manière équiprobable) <b>successivement et sans remise</b>	deux boules d'une urne contenant	une boule rouge et trois boules noires.<br> On s'intéresse aux couleurs des boules	obtenues.
val8=\(U_1=\lbrace (R,N1);(N1,R);(R,N2);(N2,R);(R,N3);(N3,R);(N1,N2);(N2,N1);(N1,N3);(N3,N1);(N2,N3);(N3,N2)\rbrace\)
val9=\(U_2= \lbrace\) R et N1; R et N2; R et N3; N1 et N2; N1 et N3; N2 et N3\( \rbrace\)
val10=1
!endif
replytype1=radio
replyname1=Univers équiprobable
replygood1=$val10;\(U_1\),\(U_2\)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	$val7</p>	Pour modéliser cette expérience on considère les deux univers suivants :	<ol>	<li> $val8 </li>	<li> $val9 </li>	</ol>	Dans quel univers la loi de probabilité correspondant à l'expérience est-elle équirépartie ?	<div class="wimscenter"> 
