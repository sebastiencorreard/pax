 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=1,3,6,6,3,1
val7=4,2,1,1,2,4
val8=$[rint(20)]
val9=+100,+200,-300
tmp0=!shuffle $val9

tmp1=!shuffle $val9

val9=$(tmp0),$(tmp1)
val10=
val11=
val12=$[rint(0)]
val13=$[rint(0)]
!for val14 =1 to 3 
val15=$[rint($(val9[$val14]))]

!ifval $val15>0
val16=green
!else
val16=red
!endif
tmp0=!append item $val16 to $val10

val10=$(tmp0)

!ifval $val15>0
val12=$[rint($val12+$(val6[$val14])*$(val7[$val14]))]
!endif

!ifval $val15<0
val13=$[rint($val13+$(val6[$val14])*$(val7[$val14]))]
!endif
val15=$[rint($(val9[$val14+3]))]

!ifval $val15>0
val16=blue
!else
val16=orange
!endif
tmp0=!append item $val16 to $val11

val11=$(tmp0)

!ifval $val15>0
val12=$[rint($val12+$(val6[$val14+3])*$(val7[$val14+3]))]
!endif

!ifval $val15<0
val13=$[rint($val13+$(val6[$val14+3])*$(val7[$val14+3]))]
!endif
!next

!ifval $val12>$val13
val17=$[rint(1)]
!else
val17=$[rint(2)]
!endif
tmp0=!positionof item -300 in $val9

val18=$(tmp0)
t_=!rawmath ($(val6[$(val18[1])])*$(val7[$(val18[1])])+$(val6[$(val18[2])])*$(val7[$(val18[2])]))/32
val19=!exec pari print($t_)
tmp0=!positionof item +100 in $val9

val20=$(tmp0)
t_=!rawmath ($(val6[$(val20[1])])*$(val7[$(val20[1])])+$(val6[$(val20[2])])*$(val7[$(val20[2])]))/32
val21=!exec pari print($t_)
tmp0=!positionof item +200 in $val9

val22=$(tmp0)
t_=!rawmath ($(val6[$(val22[1])])*$(val7[$(val22[1])])+$(val6[$(val22[2])])*$(val7[$(val22[2])]))/32
val23=!exec pari print($t_)
t_=!rawmath $val19*(-300)+$val21*100+$val23*200
val24=!exec pari print($t_)
t_=!rawmath $val19*(-300)^2+$val21*100^2+$val23*200^2-($val24)^2
val25=!exec pari print($t_)
val26=$[round(100*sqrt($val25))/100]
val27=xrange -1,18	 yrange -2,13	 fpoly black,0,3,3,3,3,4,1,4,1,6,3,6,3,7,1,7,1,9,3,9,3,10,0,10	 fpoly black,0,-1,15,-1,15,1,13,1,13,0,11,0,11,1,9,1,9,0,7,0,7,1,5,1,5,0,3,0,3,1,0,1	 fpoly black,5,3,7,3,7,4,5,4	 fpoly black,5,6,7,6,7,7,5,7	 fpoly black,5,9,7,9,7,10,5,10	 fpoly black,9,3,11,3,11,4,9,4	 fpoly black,9,6,11,6,11,7,9,7	 fpoly black,9,9,11,9,11,10,9,10	 fpoly black,13,3,15,3,15,4,13,4	 fpoly black,13,6,15,6,15,7,13,7	 fpoly black,13,9,15,9,15,10,13,10	 dsegment 0,2,15,2,magenta	 dsegment 4,5,15,5,magenta	 dsegment 4,8,15,8,magenta	 dsegment 4,2,4,10,magenta	 dsegment 8,2,8,10,magenta	 dsegment 12,2,12,10,magenta	 circle 4,2,25,magenta	 circle 4,5,25,magenta	 circle 4,8,25,magenta	 circle 8,2,25,magenta	 circle 8,5,25,magenta	 circle 8,8,25,magenta	 circle 12,2,25,magenta	 circle 12,5,25,magenta	 circle 12,8,25,magenta	 text black,3.9,2.3,medium,?	 text black,3.9,5.3,medium,?	 text black,3.9,8.3,medium,?	 text black,7.9,2.3,medium,?	 text black,7.9,5.3,medium,?	 text black,7.9,8.3,medium,?	 text black,11.9,2.3,medium,?	 text black,11.9,5.3,medium,?	 text black,11.9,8.3,medium,?	 text $(val10[1]),3.2,11,medium,$(val9[1])	 text $(val10[2]),7.2,11,medium,$(val9[2])	 text $(val10[3]),11.2,11,medium,$(val9[3])	 text $(val11[1]),15,8,medium,$(val9[4])	 text $(val11[2]),15,5,medium,$(val9[5])	 text $(val11[3]),15,2,medium,$(val9[6])	 text red,-0.8,2,medium,depart	
replytype1=numexp
replyname1=nb total chemins
