val10=$[rint(-$(tmp0))]
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
val12=$[rint(ceil(-$val11/2-1/4-$val10/4))]
t_=!rawmath $val12/2+$val11/4+(1+$val10)/8
val13=!exec pari print($t_)

!ifval $val13=0
val12=$[rint($val12+1)]
!endif
