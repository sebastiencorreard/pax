val11=$[rint($(tmp0))]
val9=$[rint($val9+$val11)]
val12=$[rint(360-$val9)]
tmp0=!shuffle $val6,$val7,$val8,$val10,$val11,$val12

val13=$(tmp0)
val14=$(val13[1]),$(val13[1])+$(val13[2]),$(val13[1])+$(val13[2])+$(val13[3]),$(val13[1])+$(val13[2])+$(val13[3])+$(val13[4]),$(val13[1])+$(val13[2])+$(val13[3])+$(val13[4])+$(val13[5])
tmp0=!shuffle red,green,blue,orange,yellow,gray,pink

val15=$(tmp0)
val16=xrange -5,5	 yrange -5,5	 circle 0,0,150,black	 segment 0,0,5,0,black	 segment 0,0,5*cos($(val13[1])*pi/180),5*sin($(val13[1])*pi/180),black	 fill 2*cos($(val13[1])*pi/360),2*sin($(val13[1])*pi/360),$(val15[1])	 segment 0,0,5*cos(($(val14[2]))*pi/180),5*sin(($(val14[2]))*pi/180),black	 fill 3*cos(($(val13[1])+$(val13[2])/2)*pi/180),3*sin(($(val13[1])+$(val13[2])/2)*pi/180),$(val15[2])	 segment 0,0,5*cos(($(val14[3]))*pi/180),5*sin(($(val14[3]))*pi/180),black	 fill 3*cos(($(val14[2])+$(val13[3])/2)*pi/180),3*sin(($(val14[2])+$(val13[3])/2)*pi/180),$(val15[3])	 segment 0,0,5*cos(($(val14[4]))*pi/180),5*sin(($(val14[4]))*pi/180),black	 fill 3*cos(($(val14[3])+$(val13[4])/2)*pi/180),3*sin(($(val14[3])+$(val13[4])/2)*pi/180),$(val15[4])	 segment 0,0,5*cos(($(val14[5]))*pi/180),5*sin(($(val14[5]))*pi/180),black	 fill 3*cos(($(val14[4])+$(val13[5])/2)*pi/180),3*sin(($(val14[4])+$(val13[5])/2)*pi/180),$(val15[5])	 fill 3*cos(($(val14[5])+$(val13[6])/2)*pi/180),3*sin(($(val14[5])+$(val13[6])/2)*pi/180),$(val15[6])	 text black,3*cos(($(val13[1])/2)*pi/180),3*sin(($(val13[1])/2)*pi/180),medium,A	 text black,3*cos(($(val13[1])+$(val13[2])/2)*pi/180),3*sin(($(val13[1])+$(val13[2])/2)*pi/180),medium,B	 text black,3*cos(($(val14[2])+$(val13[3])/2)*pi/180),3*sin(($(val14[2])+$(val13[3])/2)*pi/180),medium,C	 text black,3*cos(($(val14[3])+$(val13[4])/2)*pi/180),3*sin(($(val14[3])+$(val13[4])/2)*pi/180),medium,D	 text black,3*cos(($(val14[4])+$(val13[5])/2)*pi/180),3*sin(($(val14[4])+$(val13[5])/2)*pi/180),medium,E	 text black,3*cos(($(val14[5])+$(val13[6])/2)*pi/180),3*sin(($(val14[5])+$(val13[6])/2)*pi/180),medium,F	
val17=$(val13[1])/360,$(val13[2])/360,$(val13[3])/360,$(val13[4])/360,$(val13[5])/360,$(val13[6])/360
