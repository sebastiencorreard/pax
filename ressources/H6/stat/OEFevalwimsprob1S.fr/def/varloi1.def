!set title=Variable aléatoire, loi de probabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes.
tmp0=!randint 3, 5

val7=$[rint($(tmp0))]
tmp0=!randint 2, 4

val8=$[rint($val7+$(tmp0))]
tmp0=!randint 3, 5

val9=$[rint($val8+$(tmp0))]
t_=!rawmath ($val7/$val9)^2
val10=!exec pari print($t_)
t_=!rawmath ($val8/$val9)^2-$val10
val11=!exec pari print($t_)
t_=!rawmath 1-$val10-$val11
val12=!exec pari print($t_)
t_=!rawmath $val12
val13=!exec pari print($t_)
t_=!rawmath $val11
val14=!exec pari print($t_)
t_=!rawmath $val10
val15=!exec pari print($t_)
replytype1=numexp
replyoption1=noreduction 
replyname1=Dans la zone 1
replygood1=$val10
replytype2=numexp
replyoption2=noreduction 
replyname2=Dans la zone 2
replygood2=$val11
replytype3=numexp
replyoption3=noreduction 
replyname3=Dans la zone 3
replygood3=$val12
replytype4=numexp
replyoption4=noreduction 
replyname4=\(P(G=1)\)
replygood4=$val13
replytype5=numexp
replyoption5=noreduction 
replyname5=\(P(G=3)\)
replygood5=$val14
replytype6=numexp
replyoption6=noreduction 
replyname6=\(P(G=10)\)
replygood6=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère une cible comportant 3 cercles concentriques de rayon $val7 cm,	 $val8 cm et $val9 cm. </p>	On suppose que toutes les flèches lancées atteignent la cible,	et que la probabilité d'atteindre une zone de la cible est proportionnelle à l'aire	de cette zone.	<div class="wims_question">	Déterminer la probabilité de lancer la flèche à l'intérieur	du cercle de rayon $val7 cm (zone 1),	 entre les cercles de rayon $val7 cm et $val8 cm (zone 2),	 entre les cercles de rayon $val8 cm et $val9 cm (zone 3).	 <ul>	<li> <label for="reply1">probabilité de lancer la flèche dans la zone 1 :</label>  
!read oef/embed.phtml reply1,5 
$()</li>	<li> <label for="reply2">probabilité de lancer la flèche dans la zone 2 :</label>  
!read oef/embed.phtml reply2,5 
$()</li>	<li> <label for="reply3">probabilité de lancer la flèche dans la zone 3 :</label>  
!read oef/embed.phtml reply3,5 
$()</li>	</ul>	</div>	On considère la variable aléatoire 
!insmath G
$() associée au gain de ce jeu,	 pour lequel le gain est de 10 euros lorsqu'on atteint la zone 1,	 de 3 euros lorsqu'on atteint la zone 2 et	 de 1 euro lorsqu'on atteint la zone 3.	<div class="wims_question">	Déterminer la loi de probabilité de 
!insmath G
$().	<table class="wimsborder wimscenter">	<tr><td>
!insmath g
$()</td><td>1 euro</td><td> 3 euros </td><td> 10 euros</td></tr>	<tr><td>
!insmath P(G=g)
$()</td><td> 
!read oef/embed.phtml reply4,5 
$()</td><td> 
!read oef/embed.phtml reply5,5 
$()</td><td> 
!read oef/embed.phtml reply6,5 
$()</td></tr>	</table>	</div>	<div class="wims_instruction">$val6</div>	
$()
