!set title=Vocabulaire univers et événement 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 25

val6=$[rint($(tmp0))]
tmp0=!makelist x for x=1 to $val6

val7=$(tmp0)
val8=$[rint(floor($val6/2))]
val9=
!for val10 =1 to $val8 
val11=$[rint(2*$val10)]
tmp0=!append item $val11 to $val9

val9=$(tmp0)
!next
val12=$[rint(floor($val6/4))]
val13=
!for val10 =1 to $val12 
val11=$[rint(4*$val10)]
tmp0=!append item $val11 to $val13

val13=$(tmp0)
!next
val14=$[rint(floor($val6/5))]
val15=
!for val10 =1 to $val14 
val11=$[rint(5*$val10)]
tmp0=!append item $val11 to $val15

val15=$(tmp0)
!next
tmp0=!listcomplement $val13 in $val9

val16=$(tmp0)
val17=vide
tmp0=!listintersect $val9 and $val15

val18=$(tmp0)
val19=$val13
val20=15

!ifval $val6>=20
val21=H
!else
val21=F,H
!endif
val22=$val13
val23=$val9
val24=$val18
tmp0=!listunion $val9 and $val15

val25=$(tmp0)
val26=vide
val27=$val9,15
val28=15
val29=$val15
replytype1=fset
replyname1=\(A \cap B\)
replygood1=$val22
replytype2=fset
replyname2=\(A \cup B\)
replygood2=$val23
replytype3=fset
replyname3=\(A \cap C\)
replygood3=$val24
replytype4=fset
replyname4=\(A \cup C\)
replygood4=$val25
replytype5=fset
replyname5=\(A \cap H\)
replygood5=$val26
replytype6=fset
replyname6=\(A \cup H\)
replygood6=$val27
replytype7=fset
replyname7=\(C \cap H\)
replygood7=$val28
replytype8=fset
replyname8=\(C \cup H\)
replygood8=$val29
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On choisit au hasard (de manière équiprobable) un nombre entier entre 1 et $val6.</p>	<div class="wims_columns">	  <div class="medium_size text_col">	On considère les événements suivants :	<ul>	<li>A "le nombre tiré est un multiple de 2"</li>	<li>B "le nombre tiré est un multiple de 4"</li>	<li>C "le nombre tiré est un multiple de 5"</li>	<li>D "le nombre tiré est un multiple de 2 mais pas de 2"</li>	<li>E "le nombre tiré est un multiple de 4 mais pas de 2"</li>	<li>F "le nombre tiré est un multiple de 2 et de 5"</li>	<li>G "le nombre tiré est un multiple de 2 et de 4"</li>	<li>H "le nombre tiré est 15"</li>	</ul>	</div>	<div class="medium_size text_col">	<div class="wims_question">	Décrire de façon ensembliste les événements suivants :	<ol>	<li><label for="reply1"> 
!insmath A \cap B
$():</label>  
!read oef/embed.phtml reply1 
$()</li>	<li><label for="reply2"> 
!insmath A \cup B
$():</label>  
!read oef/embed.phtml reply2 
$()</li>	<li><label for="reply3"> 
