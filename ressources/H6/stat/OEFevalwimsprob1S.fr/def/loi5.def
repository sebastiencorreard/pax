!set title=Loi de probabilité 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=11
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
val7=$[rint($val6+3)]
val8=$[rint(2*$val6)]
val9=
!for val10 =1 to 7 
tmp0=!append item $val8 to $val9

val9=$(tmp0)
val8=$[rint($val8+1)]
!next
val11=1/16,1/8,3/16,1/4,3/16,1/8,1/16
t_=!rawmath 0
val12=!exec pari print($t_)
t_=!rawmath 0
val13=!exec pari print($t_)
!for val10 =1 to 7 
t_=!rawmath $val12+$(val11[$val10])*$(val9[$val10])
val12=!exec pari print($t_)
t_=!rawmath $val13+$(val11[$val10])*($(val9[$val10]))^2
val13=!exec pari print($t_)
!next
t_=!rawmath $val13-$val12^2
val13=!exec pari print($t_)
val14=$[round(sqrt($val13)*100)/100]
replytype1=numexp
replyoption1=noreduction 
replyname1=p1
replygood1=$(val11[1])
replytype2=numexp
replyoption2=noreduction 
replyname2=p2
replygood2=$(val11[2])
replytype3=numexp
replyoption3=noreduction 
replyname3=p3
replygood3=$(val11[3])
replytype4=numexp
replyoption4=noreduction 
replyname4=p4
replygood4=$(val11[4])
replytype5=numexp
replyoption5=noreduction 
replyname5=p5
replygood5=$(val11[5])
replytype6=numexp
replyoption6=noreduction 
replyname6=p6
replygood6=$(val11[6])
replytype7=numexp
replyoption7=noreduction 
replyname7=p7
replygood7=$(val11[7])
replytype8=numexp
replyname8=espérance
replygood8=$val12
replytype9=numexp
replyname9=variance
replygood9=$val13
replytype10=numexp
replyname10=écart type
replygood10=$val14
replytype11=numexp
replyname11=Total
replygood11=1
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On lance deux dés tétraèdriques numérotés de $val6 à $val7, puis on calcule	la somme des numéros obtenus. </p>	<div class="wims_question">	Déterminer la loi de probabilité de cette expérience.	<table class="wimsborder wimscenter">	<tr><th>Issue</th><td>$(val9[1])</td><td>$(val9[2])</td><td>$(val9[3])</td><td>$(val9[4])</td><td>$(val9[5])</td><td>$(val9[6])</td><td>$(val9[7])</td><th>Total</th></tr>	<tr><th>Probabilité</th><td> 
!read oef/embed.phtml reply1,3 
$()</td><td> 
!read oef/embed.phtml reply2,3 
$()</td><td> 
!read oef/embed.phtml reply3,3 
$()</td><td> 
!read oef/embed.phtml reply4,3 
$()</td><td> 
!read oef/embed.phtml reply5,3 
$()</td><td> 
!read oef/embed.phtml reply6,3 
$()</td><td> 
!read oef/embed.phtml reply7,3 
$()</td><td> 
!read oef/embed.phtml reply11,3 
$()</td>	</tr></table>	Calculer les indicateurs suivants :	<ul>	<li>Espérance mathématique : <label for="reply8"> 
!read oef/embed.phtml reply8,7 
$()</label></li>	<li>Variance : <label for="reply9"> 
!read oef/embed.phtml reply9,7 
$()</label></li>	<li>Ecart-type : <label for="reply10"> 
!read oef/embed.phtml reply10,7 
$()</label><i> arrondi au centième</i></li>	</ul>	<div class="wims_instruction">Donner les valeurs exactes éventuellement sous forme de fractions.</div>	</div>	
$()
!exit

