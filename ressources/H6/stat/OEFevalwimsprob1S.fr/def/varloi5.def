!set title=Variable aléatoire, loi de probabilité 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes.
tmp0=!randitem 4,5

val7=$[rint($(tmp0))]
val8=0,1,2,3,4,5,6
tmp0=!makelist r x for x= 2 to $val7+2

val9=$(tmp0)
tmp0=!nospace $val9

val9=$(tmp0)
val10=$[rint($val7 !)]
!if $val7=4 
t_=!rawmath 1/$val10
val11=!exec pari print($t_)
t_=!rawmath 0
val12=!exec pari print($t_)
t_=!rawmath 6/$val10
val13=!exec pari print($t_)
t_=!rawmath 8/$val10
val14=!exec pari print($t_)
t_=!rawmath 9/$val10
val15=!exec pari print($t_)
!endif
!if $val7=5 
t_=!rawmath 1/$val10
val16=!exec pari print($t_)
t_=!rawmath 0
val11=!exec pari print($t_)
t_=!rawmath 10/$val10
val12=!exec pari print($t_)
t_=!rawmath 20/$val10
val13=!exec pari print($t_)
t_=!rawmath 45/$val10
val14=!exec pari print($t_)
t_=!rawmath 44/$val10
val15=!exec pari print($t_)
!endif
val17=$val15,$val14,$val13,$val12,$val11,$val16
val18=$[rint(0)]
!for val19 =2 to \k+1 
t_=!rawmath $val18+$(val17[$val19])*$(val8[$val19])
val18=!exec pari print($t_)
!next
oefsteps=r1,$val9 
nextstep=!nosubst r1,$val9 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=noreduction 
replyname1=Espérance
replygood1=$val18
replytype2=numexp
replyoption2=noreduction 
replyname2=\(P(X=0)\)
replygood2=$(val17[1])
replytype3=numexp
replyoption3=noreduction 
replyname3=\(P(X=1)\)
replygood3=$(val17[2])
replytype4=numexp
replyoption4=noreduction 
replyname4=\(P(X=2)\)
replygood4=$(val17[3])
replytype5=numexp
replyoption5=noreduction 
replyname5=\(P(X=3)\)
replygood5=$(val17[4])
replytype6=numexp
replyoption6=noreduction 
replyname6=\(P(X=4)\)
replygood6=$(val17[5])
replytype7=numexp
replyoption7=noreduction 
replyname7=\(P(X=5)\)
replygood7=$(val17[6])
replytype8=numexp
replyoption8=noreduction 
replyname8=\(P(X=6)\)
replygood8=$(val17[7])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On place dans une urne $val7 boules numérotées de 1 à $val7. On tire au hasard,	successivement et sans remise les $val7 boules de cette urne.</p><p>	 Soit 
!insmath X
$() la variable aléatoire qui, à chaque issue,	 associe le nombre de boules pour lesquelles le numéro	coïncide avec le numléro de tirage.<br>	Exemple: tirer la boule n<sup>o</sup>1 au 1<sup>er</sup> tirage; la boule n<sup>o</sup>3 au 3<sup>ème</sup> tirage.	</p>	<div class="wims_question">	 Déterminer la loi de 
!insmath X
$() et son espérance mathématique.	<table class="wimsborder wimscenter">	<tr><td> 
!insmath x
$() </td>	 
!for m_j=2 to $val7+2 
$()	<td>$(val8[$m_j-1])</td>	 
!next
$()	</tr><tr><td>
!insmath P(X=x)
$()</td>	 
!for m_j=2 to $val7+2 
$()	<td> 
!read oef/embed.phtml reply\j,4 
$()</td>	 
!next
$()	</tr></table>	<div class="wimscenter"><label for="reply1">
!insmath E(X)=
$()</label>  
!read oef/embed.phtml reply1,7 
$()</div>	<div class="wims_instruction">$val6</div>	</div>	
$()
!exit

