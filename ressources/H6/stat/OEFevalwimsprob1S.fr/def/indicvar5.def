tmp0=!randint 6, 10

val6=$[rint($(tmp0))]
val7=Bernoulli, Fermat, Gauss, Kolmogorov, Laplace, Pascal, Poincaré, Tchebychev, Markov, Galton
tmp0=!item 1 to $val6 of $val7

val8=$(tmp0)
val9=$[rint($val6^4)]
t_=!rawmath 1/$val6^3
val10=!exec pari print($t_)
t_=!rawmath $val6*($val6-1)*4/$val9
val11=!exec pari print($t_)
t_=!rawmath $val6*($val6-1)*($val6-2)*($val6-3)/$val9
val12=!exec pari print($t_)
t_=!rawmath 1-$val10-$val11-$val12
val13=!exec pari print($t_)
val14=$val13,$val12,$val11,$val10
t_=!rawmath 0
val15=!exec pari print($t_)
t_=!rawmath 0
val16=!exec pari print($t_)
val17=-1,0,4,49
!for val18 =1 to 4 
t_=!rawmath $val15+$(val14[$val18])*$(val17[$val18])
val15=!exec pari print($t_)
t_=!rawmath $val16+$(val14[$val18])*($(val17[$val18]))^2
val16=!exec pari print($t_)
!next
t_=!rawmath $val16-($val15)^2
val16=!exec pari print($t_)
val19=$[round(100*sqrt($val16))/100]

!ifval $val15<0
val20=$[rint(1)]
!else
val20=$[rint(2)]
!endif
