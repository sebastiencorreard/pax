!set title=Cas de l'équiprobabilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes en utilisant des fractions si c'est nécessaire.
tmp0=!randint 4, 6

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 4

val9=$[rint($val8+$(tmp0))]
tmp0=!randitem $val8,$val9

val10=$[rint($(tmp0)*10^($val7-1))]
val11=$[rint(2^$val7)]
t_=!rawmath 1/2
val12=!exec pari print($t_)
t_=!rawmath 1/$val11
val13=!exec pari print($t_)
t_=!rawmath 2/$val11
val14=!exec pari print($t_)

!ifval $val10=$val8*10^($val7-1)
t_=!rawmath 1
val15=!exec pari print($t_)
!else
t_=!rawmath 1/2
val15=!exec pari print($t_)
!endif
replytype1=numexp
replyoption1=noreduction 
replyname1=P(A)
replygood1=$val12
replytype2=numexp
replyoption2=noreduction 
replyname2=P(B)
replygood2=$val12
replytype3=numexp
replyoption3=noreduction 
replyname3=P(C)
replygood3=$val13
replytype4=numexp
replyoption4=noreduction 
replyname4=P(D)
replygood4=$val14
replytype5=numexp
replyoption5=noreduction 
replyname5=P(E)
replygood5=$val15
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst  « Au hasard » signifie que tous les nombres à $val7 chiffres constitués uniquement des chiffres $val8 et $val9 ont la même probabilité d'être choisis. 


!goto stat

!exit

:question
$()<p>	On compose au  
!read oef/special.phtml help alea,hasard 
$() un nombre de $val7 chiffres avec uniquement des $val8 et des $val9.	</p>	Quelle est la probabilité des événements suivants ?	<ul>	<li>A <span class="wims_emph">« le nombre commence par un $val8 »</span> : P(A) =  
!read oef/embed.phtml reply1,3 
$()</li>	<li>B <span class="wims_emph">« le nombre se termine par un $val9 »</span> : P(B) =  
!read oef/embed.phtml reply2,3 
$()</li>	<li>C <span class="wims_emph">« le nombre ne contient que des $val8 »</span> : P(C) =  
!read oef/embed.phtml reply3,3 
$()</li>	<li>D <span class="wims_emph">« les chiffres $val8 et $val9 alternent »</span> : P(D) =  
!read oef/embed.phtml reply4,3 
$()</li>	<li>E <span class="wims_emph">« le nombre est supérieur à $val10 »</span> : P(E) =  
!read oef/embed.phtml reply5,3 
$()</li>	</ul>	<div class="wims_instruction">$val6</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$() « Au hasard » signifie que tous les nombres à $val7 chiffres constitués uniquement des chiffres $val8 et $val9 ont la même probabilité d'être choisis. 
$()
!exit

