!set title=Union et intersection d'événements 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=90

ansorder=r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=
val7=
val8=0
!for val9 =1 to 6 
tmp0=!randint 1, 10

val10=$[rint($(tmp0))]
tmp0=!append item $val10 to $val6

val6=$(tmp0)
val8=$[rint($val8+$val10)]
!next
!for val9 =1 to 6 
tmp0=!append item $(val6[$val9])/$val8 to $val7

val7=$(tmp0)
!next
t_=!rawmath $(val7[2])+$(val7[4])+$(val7[6])
val11=!exec pari print($t_)
t_=!rawmath $(val7[1])+$(val7[2])+$(val7[3])
val12=!exec pari print($t_)
t_=!rawmath $(val7[2])+$(val7[3])+$(val7[5])
val13=!exec pari print($t_)
t_=!rawmath 1-$(val7[5])
val14=!exec pari print($t_)
t_=!rawmath $(val7[2])+$(val7[3])
val15=!exec pari print($t_)
t_=!rawmath 1-$val11
val16=!exec pari print($t_)
replytype1=numexp
replyoption1=noreduction 
replyname1=\(P(A)\)
replygood1=$val11
replytype2=numexp
replyoption2=noreduction 
replyname2=\(P(B)\)
replygood2=$val12
replytype3=numexp
replyoption3=noreduction 
replyname3=\(P(C)\)
replygood3=$val13
replytype4=numexp
replyoption4=noreduction 
replyname4=\(P(A \cup B)\)
replygood4=$val14
replytype5=numexp
replyoption5=noreduction 
replyname5=\(P(B \cap C)\)
replygood5=$val15
replytype6=numexp
replyoption6=noreduction 
replyname6=\(P(\bar{A})\)
replygood6=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

