!set title=Variable aléatoire, loi de probabilité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner les valeurs exactes.
val7=un,deux,trois,quatre,cinq
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
val8=$[rint(2)]

!ifval $val8=1
val9=$[rint(3)]
!else
val9=$[rint(4)]
!endif

!ifval $val8=1
val10=$[rint(4)]
!else
val10=$[rint(3)]
!endif

!ifval $val8=3
val9=$[rint(3)]
!endif
val11=1,2,3,4
val12=$[rint($val9^$val10)]
!if $val8=1 
t_=!rawmath $val9/$val12
val13=!exec pari print($t_)
t_=!rawmath binomial($val9,2)*(2^$val10-2)/$val12
val14=!exec pari print($t_)
t_=!rawmath 1-$val14-$val13
val15=!exec pari print($t_)
val16=$val13,$val14,$val15
t_=!rawmath $val14+$val15
val17=!exec pari print($t_)
!endif
!if $val8=2 
t_=!rawmath $val9/$val12
val13=!exec pari print($t_)
t_=!rawmath binomial($val9,2)*(2^$val10-2)/$val12
val14=!exec pari print($t_)
t_=!rawmath 0
val18=!exec pari print($t_)
t_=!rawmath 1-$val13-$val14-$val18
val15=!exec pari print($t_)
val16=$val13,$val14,$val15,$val18
t_=!rawmath $val15+$val18
val17=!exec pari print($t_)
!endif
!if $val8=3 
t_=!rawmath $val9/$val12
val13=!exec pari print($t_)
t_=!rawmath binomial($val9,2)*(2^$val10-2)/$val12
val14=!exec pari print($t_)
t_=!rawmath 0
val18=!exec pari print($t_)
t_=!rawmath 1-$val13-$val14-$val18
val15=!exec pari print($t_)
val16=$val13,$val14,$val15,$val18
t_=!rawmath $val14+$val15
val17=!exec pari print($t_)
!endif
!if $val8=4 
t_=!rawmath $val9/$val12
val13=!exec pari print($t_)
t_=!rawmath binomial($val9,2)*(2^$val10-2)/$val12
val14=!exec pari print($t_)
t_=!rawmath $val10!*$val9/(2*$val12)
val18=!exec pari print($t_)
t_=!rawmath 1-$val13-$val14-$val18
val15=!exec pari print($t_)
val16=$val13,$val14,$val15,$val18
t_=!rawmath $val15+$val18
val17=!exec pari print($t_)
!endif
tmp0=!makelist r x for x= 2 to $val9+1

val19=$(tmp0)
tmp0=!nospace $val19

val19=$(tmp0)
oefsteps=r1,$val19 
nextstep=!nosubst r1,$val19 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=noreduction 
replyname1=P(au moins 2 médecins sont appelés)
replygood1=$val17
replytype2=numexp
replyoption2=noreduction 
replyname2=\(P(T=1)\)
replygood2=$(val16[1])
replytype3=numexp
replyoption3=noreduction 
replyname3=\(P(T=2)\)
replygood3=$(val16[2])
replytype4=numexp
replyoption4=noreduction 
replyname4=\(P(T=3)\)
replygood4=$(val16[3])
replytype5=numexp
replyoption5=noreduction 
replyname5=\(P(T=4)\)
replygood5=$(val16[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Dans une petite ville, $(val7[$val9]) médecins sont de garde le week-end	 et $(val7[$val10]) malades appellent au hasard l'un d'entre eux.	</p><p>	 On appelle 
!insmath T
$() la variable aléatoire qui, à chaque configuration d'appels,	 associe le nombre de médecins appelés.</p>	<div class="wims_question">	Déterminer la loi de probabilité de 
!insmath T
$().<br>	<table class="wimsborder wimscenter">	<tr><td> t </td>	 
!for m_j=2 to $val9+1 
$()	<td>$(val11[$m_j-1])</td>	 
!next
$()	</tr><tr><td>
!insmath P(T=t)
$()</td>	 
!for m_j=2 to $val9+1 
$()	<td> 
!read oef/embed.phtml reply\j,4 
$()</td>	 
!next
$()	</tr></table>	<label for="reply1">Quelle est la probabilité qu'au moins $(val7[$val9-1]) des $(val7[$val9]) médecins soient appelés ?</label>	 <div class="wimscenter">  
!read oef/embed.phtml reply1,5 
$()</div>	 <div class="wims_instruction">$val6</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10,11
embedcnt=2
