!set title=Vocabulaire univers et événement 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r,r,r,r,r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=10
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 25

val6=$[rint($(tmp0))]
tmp0=!makelist x for x=1 to $val6

val7=$(tmp0)
val8=$[rint(floor($val6/2))]
val9=
!for val10 =1 to $val8 
val11=$[rint(2*$val10)]
tmp0=!append item $val11 to $val9

val9=$(tmp0)
!next
val12=$[rint(floor($val6/4))]
val13=
!for val10 =1 to $val12 
val11=$[rint(4*$val10)]
tmp0=!append item $val11 to $val13

val13=$(tmp0)
!next
val14=$[rint(floor($val6/5))]
val15=
!for val10 =1 to $val14 
val11=$[rint(5*$val10)]
tmp0=!append item $val11 to $val15

val15=$(tmp0)
!next
tmp0=!listcomplement $val13 in $val9

val16=$(tmp0)
val17=vide
tmp0=!listintersect $val9 and $val15

val18=$(tmp0)
val19=$val13
val20=15

!ifval $val6>=20
val21=H
!else
val21=F,H
!endif
val22=$val13
val23=$val9
val24=$val18
tmp0=!listunion $val9 and $val15

val25=$(tmp0)
val26=vide
val27=$val9,15
val28=15
val29=$val15
replytype1=fset
replyname1=univers
replygood1=$val7
replytype2=fset
replyname2=multiple de 2
replygood2=$val9
replytype3=fset
replyname3=multiple de 4
replygood3=$val13
replytype4=fset
replyname4=multiple de 5
replygood4=$val15
replytype5=fset
replyname5=multiple de 2 et pas de 4
replygood5=$val16
replytype6=fset
replyname6=multiple de 4 et pas de 2
replygood6=$val17
replytype7=fset
replyname7=multiple de 2 et de 5
replygood7=$val18
replytype8=fset
replyname8=multiple de 2 et de 4
replygood8=$val19
replytype9=fset
replyname9=le nombre est 15
replygood9=$val20
replytype10=fset
replyname10=événement élémentaire
replygood10=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On choisit au hasard (de manière équiprobable) un nombre entier entre 1 et $val6.	</p><ol>	<li>Quel est l'univers ? <label for="reply1">
!insmath \Omega =
$() </label>  
!read oef/embed.phtml reply1,\n 
$()</li>	<li>Décrire de façon ensembliste les événements suivants :	<ul>	<li><label for="reply2">A "le nombre tiré est un multiple de 2" :</label>  
!read oef/embed.phtml reply2 
$()</li>	<li><label for="reply3">B "le nombre tiré est un multiple de 4" :</label>  
!read oef/embed.phtml reply3 
$()</li>	<li><label for="reply4">C "le nombre tiré est un multiple de 5" :</label>  
!read oef/embed.phtml reply4 
$()</li>	<li><label for="reply5">D "le nombre tiré est un multiple de 2 mais pas de 4" :</label>  
!read oef/embed.phtml reply5 
$()</li>	<li><label for="reply6">E "le nombre tiré est un multiple de 4 mais pas de 2" :</label>  
!read oef/embed.phtml reply6 
$()</li>	<li><label for="reply7">F "le nombre tiré est un multiple de 2 et de 5" :</label>  
!read oef/embed.phtml reply7 
$()</li>	<li><label for="reply8">G "le nombre tiré est un multiple de 2 et de 4" :</label>  
!read oef/embed.phtml reply8 
$()</li>	<li><label for="reply9">H "le nombre tiré est 15" :</label>  
!read oef/embed.phtml reply9 
$()</li>	</ul></li>	</ol>	<div class="wims_instruction">Taper "vide" s'il n'y a pas d'élément ;	s'il y a plusieurs éléments, les séparer par une virgule.</div>	<ol start="3">	<li><label for="reply9">Quels sont les événements élémentaires (c'est-à-dire qui ne comportent qu'une issue)	parmi les événements A à H ?</label>  
!read oef/embed.phtml reply10 
$()</li>	</ol>	
