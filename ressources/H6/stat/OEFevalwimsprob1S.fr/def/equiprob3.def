val14=!exec pari print($t_)
!else
t_=!rawmath 3/8
val14=!exec pari print($t_)
!endif

!ifval $val7=3
t_=!rawmath 1/6
val15=!exec pari print($t_)
!else
t_=!rawmath 1/12
val15=!exec pari print($t_)
!endif
