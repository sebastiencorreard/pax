val7=$[rint($(tmp0))]
val8=Aurore, Béatrice, Chloé, Danielle, Elisabeth
val9=Aurore
!for val10 =2 to $val7-1 
val9=$val9,&nbsp;$(val8[$val10])
!next
val9=$val9 et $(val8[$val7])
val11=$[rint($val7 !)]
t_=!rawmath 1/$val11
val12=!exec pari print($t_)

!ifval $val7=3
t_=!rawmath 1/2
val13=!exec pari print($t_)
