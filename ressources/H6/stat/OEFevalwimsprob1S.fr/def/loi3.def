!set title=Loi de probabilité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 10

val6=$[rint($(tmp0))]
tmp0=!randitem 5,10,15,20

val7=$[rint($(tmp0)+2*$val6)]
val8=$[rint(2*$val7)]
val9=$[rint($val8+$val6+$val7)]
t_=!rawmath $val8/$val9
val10=!exec pari print($t_)
t_=!rawmath $val6/$val9
val11=!exec pari print($t_)
t_=!rawmath $val7/$val9
val12=!exec pari print($t_)
replytype1=numexp
replyoption1=noreduction 
replyname1=p(Vert)
replygood1=$val10
replytype2=numexp
replyoption2=noreduction 
replyname2=p(Orange)
replygood2=$val11
replytype3=numexp
replyoption3=noreduction 
replyname3=p(rouge)
replygood3=$val12
replytype4=numexp
replyname4=Total
replygood4=1
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Le cycle d'allumage d'un feu tricolore est le suivant :<br>	Feu vert pendant $val8 secondes, feu orange pendant $val6 secondes, feu rouge pendant $val7 secondes.	</p>	<div class="wims_question">	En admettant qu'un automobiliste arrive au hasard devant	 l'une des trois positions possibles du feu tricolore,	déterminer la loi de probabilité de cette expérience aléatoire.	<table class="wimsborder wimscenter">	<tr><th> Feu</th><td>Vert</td><td>Orange</td><td>Rouge</td><th>Total</th></tr>	<tr><th> Probabilité</th><td> 
!read oef/embed.phtml reply1,3 
$()</td><td> 
!read oef/embed.phtml reply2,3 
$()</td><td> 
!read oef/embed.phtml reply3,3 
$()</td><th> 
!read oef/embed.phtml reply4,3 
$()</th></tr>	</table>	<div class="wims_instruction">Donner les valeurs exactes éventuellement sous forme de fractions.</div>	</div>	
$()
!exit

