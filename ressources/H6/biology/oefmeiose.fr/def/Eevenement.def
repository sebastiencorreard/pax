!set title=E-Associer une étape de la méiose et les événements associés
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jonathan, Faivre
email=prof.svt.lc@gmail.com

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(4)]
val7=$[rint(50)]
val8=$[rint(250)]
val9=$[rint(450)]
tmp=!trim La prophase I,  Au cours de cette étape les chromosomes se condensent progressivement et le noyau se fragmente pour disparaître	L'anaphase I,  Chaque chromosomes homologues migre vers l'un des deux pôles de la cellule de manière aléatoire	La métaphase II,  Chaque chromosome se positionne au niveau de la plaque équatoriale par leur centromère	La télophase II,  Au cours de cette étape les chromosomes se décondensent progressivement et le noyau se reforme
val10=!translate internal $	\
$ to ;; in $tmp
val11=Établissez la correspondance entre les étapes de la méiose et la description des événements :
tmp0=!item 2 of 1 oui, 2 non

val12=$(tmp0)
tmp0=!word 1 of $val12

val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
val13=$[rint($(tmp0))]

!ifval $val6>$val13
val6=$[rint($val13)]
!endif
tmp0=!shuffle $val13

tmp1=!item 1 to $val6 of $(tmp0)

val14=$(tmp1)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)

!ifval $val12=1
tmp0=!embraced randitem $val10

val10= $(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val10

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$(val7[])x$(val8[])x$val9

!ifval $val12=1
tmp0=!embraced randitem $val11

val11= $(tmp0)
!endif
replytype1=correspond
replyname1=La réponse
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11		<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val17 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,17
embedcnt=1
