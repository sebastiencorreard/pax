!set title=B-Les étapes de la méiose (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jonathan, Faivre
email=prof.svt.lc@gmail.com

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=20
choicecnt=0
conditioncnt=0
feedbackcnt=0
