val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(8)]
val7=80x40
val8=prophase I, métaphase I, anaphase I, télophase I, Prophase II, Métaphase II, Anaphase II, Télophase II
val9=Classer les différentes étiquettes pour que la méiose se déroule dans le bon ordre :
tmp0=!item 1 of 1 oui, 2 non

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!word 1 of $val10

val10=$(tmp0)

!ifval $val10=1 
tmp0=!embraced randitem $val8

val8= $(tmp0)
!endif
tmp0=!itemcnt $val8

val11=$[rint($(tmp0))]
val6=$[rint(min(20,min($val6,$val11)))]
!if $val6<$val11 
tmp0=!shuffle $val11

val12=$(tmp0)
tmp0=!sort numeric items $(val12[1..$val6])

val12=$(tmp0)
tmp0=!item $val12 of $val8

val8=$(tmp0)
!endif
tmp0=!makelist r x for x=1 to $val6

val13=$(tmp0)
oefsteps=$val13 
nextstep=!nosubst $val13 
!readproc oef/steps.proc
