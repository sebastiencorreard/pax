oefcss=<style> table.ans_multipleclick1 {margin-left:auto;margin-right:auto} </style> 

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=meiose6.png,prophase I	meiose4.png,anaphase I	meiose1.png,anaphase II	meiose7.png,télophase II	meiose5.png,prophase II	meiose3.png,métaphase II
val7=$[rint(4)]
val8=100
!if \sizeh notsametext  
tmp0=!nospace $val8 px

val9=style="height:$(tmp0)"
!endif
tmp0=!embraced randitem $val6

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val10=$(tmp0)
val11=
!while $val11 issametext  
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val11=$(val12[2])
!endwhile
val13=$(val12[1])
tmp0=!lowercase $val13

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val14=$(tmp2)
val15=Clique sur $val11.
tmp=!translate internal $	$ to ; in $val6

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!positionof item $val11 in $val17

val18=$(tmp0)
tmp0=!makelist x for x=1 to $val10

val19=$(tmp0)
tmp0=!shuffle $val19

val19=$(tmp0)
val19=$(val19[1..$val7])
tmp0=!listintersection $val18 and $val19

val20=$(tmp0)
!if $val20= 
tmp0=!itemcnt $val18

val21=$[rint($(tmp0))]

!ifval $val21 >1 
tmp=!nonempty items $val18

tmp0=!randitem $tmp
val18= $(tmp0)
!endif
val19=$val18,$(val19[1..$val7-1])
tmp0=!shuffle $val19

val19=$(tmp0)
!endif
tmp=!trim $val6
val6=!translate internal $	\
$ to ;; in $tmp
val16=$(val6[$val19;1])
val17=$(val6[$val19;2])
tmp0=!itemcnt $val16

val7=$(tmp0)
val22=
!for val23 =1 to $val7 

!ifval / isin $(val16[$val23]) 
tmp0=!append item $(val16[$val23]) to $val22

val22= $(tmp0)
!else
tmp1=!append item $val1/$(val16[$val23]) to $val22

val22=	  $(tmp1)
!endif
!next
tmp0=!makelist <img src="x" alt="" $val9> for x in $val22

val16=$(tmp0)
tmp0=!positionof item $val11 in $val17

val18=$(tmp0)
replytype1=multipleclick

replyoption1=shuffle 
replyname1=
replygood1=$val18;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

