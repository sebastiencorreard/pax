!set title=Calcul direct de dérivée 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in -$val10/$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val11=!exec pari print($t_)
tmp0=!randint 3, 5

val12=$[rint($(tmp0))]
val13=$val6*x^2+$val7*x+$val8/x+$val9*sqrt(x),\(\rbrack 0; +\infty \rbrack)	($val6*x^2+$val7*x+$val8)*($val9*x+$val10),\(\;\RR)	($val6*x+$val7)*sqrt(x),\(\rbrack 0; +\infty \rbrack)	($val6*x+$val7)/($val9*x+$val10),\(\RR \setminus \lbrace $val11 \rbrace)	($val6*x+$val7)/($val9*x^2+$val10),\(\;\RR)	($val6*x^2+$val7)/($val9*x+$val10),\(\RR \setminus \lbrace $val11 \rbrace)	($val6*x+$val7)^$val12,\(\;\RR)	1/($val9*x+$val10)^$val12,\(\RR \setminus \lbrace $val11 \rbrace)	($val9*x+$val10)^(-$val12),\(\RR \setminus \lbrace $val11 \rbrace)	sqrt($val9*x+$val10),\(\rbrack $val11; +\infty \rbrack)	cos($val6*x+$val7),\(\;\RR)	sin($val6*x+$val7),\(\;\RR)	
tmp0=!randitem 4,5,6

val14=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val13

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$(val15[1])
tmp0=!texmath $val16

val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
val19=$(val15[2])
replytype1=formal
replyname1=fonction dérivée
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère la fonction 
!insmath f
$() définie sur $val19 par:	</p>	<div class="wimscenter"> 
!insmath f(x)=$val17
$().</div>	<div class="wims_question">	Calculer 
!insmath f'(x)
$():	<div class="wimscenter"><label for="reply1">
!insmath f'(x)=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	</div>	<div class="wims_instruction">Taper <span class="tt">sqrt(x)</span> pour 
!insmath \sqrt{x}
$().</div>	
$()
