!set title=Calcul de dérivée composée 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val7=$[rint($val6+$(tmp0))]

!ifval $val7=0
tmp0=!randint 1, 5

val7=$[rint($val7+$(tmp0))]
!endif
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint($val6/$val8)]
val10=\(\RR \setminus \lbrace $val6 \rbrace)
val11=\(\RR \setminus \lbrace $val6 ; $val7 \rbrace)
val12=\( \rbrack $val6; +\infty \rbrack)
val13=\( \lbrack -\infty ; $val6 \lbrack)
val14=\( \rbrack $val6; $val7 \lbrack)
val15=\(\rbrack -\infty; $val6 \lbrack \cup \rbrack $val7; +\infty \lbrack)

!ifval $val8>0
val16=$val12
!else
val16=$val13
!endif

!ifval $val8<0
val17=$val14
!else
val17=$val15
!endif
tmp0=!randint 3, 5

val18=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand($val8*(x-$val6)*(x-$val7))
tmp0=!exec maxima $t_

val19=$(tmp0)
val20=($val19)^$val18,1/($val19),sqrt($val19),cos($val19),sin($val19)
tmp0=!randint 1, 5

val21=$[rint($(tmp0))]
tmp0=!item $val21 of $val20

val22=$(tmp0)

!ifval $val21=2
val23=$val11
!else
val23=\(\,\RR)
!endif

!ifval $val21=3
val23=$val17
!endif
tmp0=!texmath $val22

val24=$(tmp0)
tmp=!translate ;";': to $     $ in $val22,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val25=!rawmath $(tmp0)
replytype1=formal
replyname1=fonction dérivée
replygood1=$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur $val23 par	  <div class="wimscenter">
!insmath f(x) = $val24
$().</div>	  <div class="wims_question">	  Calculer 
!insmath f'(x)
$().	  <div class="wimscenter"><label for="reply1">
!insmath f'(x)=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	  </div>	  <div class="wims_instruction">	   Taper <span class="tt">sqrt(x)</span> pour 
!insmath \sqrt{x}
$().</div>	  
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=23,24
embedcnt=1
