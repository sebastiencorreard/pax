!set title=Calcul de dérivée composée 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val7=$[rint($val6+$(tmp0))]

!ifval $val7=0
tmp0=!randint 1, 5

val7=$[rint($val7+$(tmp0))]
!endif
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
val9=$[rint($val6/$val8)]
val10=\(\RR \setminus \lbrace $val6 \rbrace)
val11=\(\RR \setminus \lbrace $val6 ; $val7 \rbrace)
val12=\( \rbrack $val6; +\infty \rbrack)
val13=\( \lbrack -\infty ; $val6 \lbrack)
val14=\( \rbrack $val6; $val7 \lbrack)
val15=\(\rbrack -\infty; $val6 \lbrack \cup \rbrack $val7; +\infty \lbrack)

!ifval $val8>0
val16=$val12
!else
val16=$val13
!endif

!ifval $val8<0
val17=$val14
!else
val17=$val15
!endif
tmp0=!randint 3, 5

val18=$[rint($(tmp0))]
val19=$[rint(abs(2*$val8))]
tmp0=!randitem cos($val8*x),sin($val8*x)

val20=$(tmp0)
val21=($val20)^$val18,1/($val20),sqrt($val20)
tmp0=!randint 1, 3

val22=$[rint($(tmp0))]
tmp0=!item $val22 of $val21

val23=$(tmp0)

!ifval $val22=1
val24=\(\;\RR)
!else
val24=\(\RR \setminus \lbrace \frac{k\pi}{$val19}, k \in \ZZ \rbrace)
!endif
tmp0=!texmath $val23

val25=$(tmp0)
tmp=!translate ;";': to $     $ in $val23,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val26=!rawmath $(tmp0)
replytype1=formal
replyname1=fonction dérivée
replygood1=$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère la fonction 
!insmath f
$() définie sur $val24 par	  <div class="wimscenter">
!insmath f(x) = $val25
$().</div>	  <div class="wims_question">	  Calculer 
!insmath f'(x)
$().	  <div class="wimscenter"><label for="reply1">
!insmath f'(x)=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	  </div>	  <div class="wims_instruction">	   Taper <span class="tt">sqrt(x)</span> pour 
!insmath \sqrt{x}
$().</div>	  
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=24,25
embedcnt=1
