!set title=Calcul de dérivées successives 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.Fr
precision=100
computeanswer=yes

ansorder=r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
val9=($val6*x+$val7)^$val8,(-$val6*x+$val7)^$val8,1/($val6*x+$val7)^$val8,sqrt($val6*x+$val7),cos($val6*x+$val7),sin($val6*x+$val7)
tmp=!nonempty items $val9

tmp0=!randitem $tmp
val10=$(tmp0)
t_=!replace internal \( by ( in $val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val12=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
replytype1=formal
replyname1=fonction dérivée
replygood1=$val12
replytype2=formal
replyname2=fonction dérivée seconde
replygood2=$val13
replytype3=formal
replyname3=fonction dérivée troisième
replygood3=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  On considère la fonction 
!insmath f
$() définie par</p>	  <div class="wimscenter">
!insmath f(x)=$val11
$().</div>	  Calculer 
!insmath f'(x), f^{(2)}(x)
$() et 
!insmath f^{(3)}(x)
$():	  <div class="wims_question">	  <ul><li>	  <label for="reply1">
!insmath f'(x)=
$()</label>  
!read oef/embed.phtml reply1 
$()	  </li><li>	  <label for="reply2">
!insmath f^{(2)}(x)=
$()</label>  
!read oef/embed.phtml reply2 
$()	  </li><li><label for="reply3">
!insmath f^{(3)}(x)=
$()</label>  
!read oef/embed.phtml reply3 
$()	  </li></ul>	  </div>	  <div class="wims_instruction">	  Taper <span class="tt">sqrt(x)</span> pour 
!insmath \sqrt{x}
$().	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11
embedcnt=3
