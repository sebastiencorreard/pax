tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
val7=cos($val6*x),sin($val6*x),cos(-$val6*x),sin(-$val6*x)
val8=($val6)^n*cos($val6*x+n*pi/2),($val6)^n*sin($val6*x+n*pi/2),($val6)^n*cos($val6*x+n*pi/2),-($val6)^n*sin($val6*x+n*pi/2)
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
tmp0=!item $val9 of $val7

val10=$(tmp0)
tmp0=!texmath $val10

val11=$(tmp0)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val12=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
tmp0=!item $val9 of $val8

val16=$(tmp0)
replytype1=formal
replyname1=fonction dérivée
