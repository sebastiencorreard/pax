tmp0=!randint -2, 2

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($val6+$(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=a*x+b,\(x \leq $val6),$val8*x^2+$val9*x+$val10,\({x > $val6}),2*$val8*$val6+$val9,-$val8*($val6)^2+$val10, \mathbb{R}	a*x+b,\(x \leq $val6),$val8/(x-$val7),\({x > $val6}),-$val8/($val6-$val7)^2,$val8*(2*$val6-$val7)/($val6-$val7)^2, \mathbb{R} \setminus \lbrace $val7 \rbrace	x^2+a*x+b,\(x \leq $val6),$val8*x^2+$val9*x+$val10,\({x > $val6}),2($val8-1)*$val6+$val9,-($val8-1)*($val6)^2+$val10, \mathbb{R}	-x^2+a*x+b,\(x \leq $val6),$val8*x^2+$val9*x+$val10,\({x > $val6}),2*($val8+1)*$val6+$val9,-($val8+1)*($val6)^2+$val10, \mathbb{R}	x^2+a*x+b,\(x \leq $val6),$val8/(x-$val7)+$val9,\({x > $val6}),-$val8/($val6-$val7)^2 -2*$val6,$val8*(2*$val6-$val7)/($val6-$val7)^2 +($val6)^2 +$val9, \mathbb{R} \setminus \lbrace $val7 \rbrace	
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val12=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
t_=!replace internal \( by ( in $(val13[1])
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
t_=!replace internal \( by ( in $(val13[3])
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
val16=\(f(x)=$val14) pour $(val13[2]) et \(f(x)=$val15) pour $(val13[4])
t_=!rawmath $(val13[5])
val17=!exec pari print($t_)
t_=!rawmath $(val13[6])
val18=!exec pari print($t_)
replytype1=numexp
replyname1=\(a)
replygood1=$val17
replytype2=numexp
replyname2=\(b)
