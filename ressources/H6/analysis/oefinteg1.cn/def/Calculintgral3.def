 !exit
!endif

tmp0=!randitem -2,-1,1,2

val6=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val7=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val8=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2,3,4

val10=$[rint($(tmp0))]

!ifval ($val10=1)
tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
!endif
val11=$[rint(-$val9/$val6)]

!ifval ($val6>0)
tmp0=!randitem $val11+2,$val11+3

val12=$[rint($(tmp0))]
!else
tmp1=!randitem $val11-3,$val11-2

val12=$[rint($(tmp1))]
!endif

!ifval ($val6>0)
tmp0=!randint $val11+4, 6

val13=$[rint($(tmp0))]
!else
tmp1=!randint -6, $val11-4

val13=$[rint($(tmp1))]
!endif
tmp0=!item $val10 of ($val7*x+$val8)*log($val6*x),($val7*x+$val8)*e^($val6*x)	,($val6*x+$val9)*log(x),($val6*x+$val9)*e^x	

val14=!rawmath $(tmp0)
tmp0=!item $val10 of $val7*x+$val8,e^($val6*x),$val6*x+$val9,e^x

val15=!rawmath $(tmp0)
tmp0=!item $val10 of log($val6*x),$val7*x+$val8,log(x),$val6*x+$val9

val16=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val15,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val17=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
tmp0=!texmath $val15

val19=$(tmp0)
tmp0=!texmath $val16

val20=$(tmp0)
tmp0=!texmath $val17

val21=$(tmp0)
tmp0=!texmath $val18

val22=$(tmp0)

!ifval ($val10=3)
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
!endif

!ifval ($val10=3)
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
!endif

!ifval ($val13=$val12) and ($val10=3)
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
!endif

!ifval ($val13=$val12) and ($val10=3)
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
!endif

!ifval ($val10=4)
tmp0=!randint -2, 2

val13=$[rint($(tmp0))]
!endif

!ifval ($val10=4)
tmp0=!randint -2, 2

val12=$[rint($(tmp0))]
!endif

!ifval ($val13=$val12) and ($val10=4)
tmp0=!randint -2, 2

val12=$[rint($(tmp0))]
!endif

!ifval ($val13=$val12) and ($val10=4)
tmp0=!randint -2, 2

val12=$[rint($(tmp0))]
!endif
tmp0=!texmath $val14

val23=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val24=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(x=$val12,$val24)-subst(x=$val13,$val24);
tmp0=!exec maxima $t_

val25=$(tmp0)
tmp0=!texmath $val25

val26=$(tmp0)
replytype1=auto

replyname1=I 的值
