\title{三角函数的积分}
\language{cn}
\range{-5..5}
\author{Michel Gosse}
\email{michel.gosse@ac-poitiers.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-2,-1,1,2)}
\integer{a1=random(1,2)}
\integer{b=random(1,2,3)}
\integer{choixinf=random(1..18)}
\integer{choixsup=random(1..18)}
\integer{choixsup=(\choixinf=\choixsup)?random(1..18)}
\integer{choixsup=(\choixinf=\choixsup)?random(1..18)}
\text{inf=item(\choixinf,0,
\pi/6,\pi/4,\pi/2,\pi/3,\pi,
-\pi/6,-\pi/4,-\pi/2,-\pi/3,-\pi,
2\pi/3,3\pi/4,5\pi/6,
-2\pi/3,-3\pi/4,-5\pi/6,2\pi
)}
\text{sup=item(\choixsup,0,\pi/6,\pi/4,\pi/2,\pi/3,\pi,
-\pi/6,-\pi/4,-\pi/2,-\pi/3,-\pi,
2\pi/3,3\pi/4,5\pi/6,
-2\pi/3,-3\pi/4,-5\pi/6,2\pi
)}

\text{minf=item(\choixinf,0,%pi/6,%pi/4,%pi/2,%pi/3,%pi,
-%pi/6,-%pi/4,-%pi/2,-%pi/3,-%pi,
2*%pi/3,3*%pi/4,5*%pi/6,
-2*%pi/3,-3*%pi/4,-5*%pi/6,2*%pi
)}
\text{msup=item(\choixsup,0,%pi/6,%pi/4,%pi/2,%pi/3,%pi,
-%pi/6,-%pi/4,-%pi/2,-%pi/3,-%pi,
2*%pi/3,3*%pi/4,5*%pi/6,
-2*%pi/3,-3*%pi/4,-5*%pi/6,2*%pi
)}

\function{f=random(\a*cos(\b*x),\a*sin(\b*x),cos(\a1*x)^2,
sin(\a1*x)^2,\a*cos(x+pi),\a*sin(x+pi),\a*cos(x+pi/2),
\a*sin(x+pi/2))}
\function{g=int(\f,x)}
\text{rep=maxima(expand(subst(x=\msup,\g)-subst(x=\minf,\g));)}

\text{f1=texmath(\f)}
\text{g1=texmath(\g)}

\statement{计算以下积分的精确值 :
<center>
\(I=\int_{\inf}^{\sup} \f1 \,dx)
</center>
平方根函数记为 sqrt. 例如, sqrt(2)=\(\sqrt{2}). 数 \(\pi) 记为 pi.}

\hint{回想求导公式 :
<center>
\((\cos(u))'=-u'\times \sin(u) \qquad (\sin(u))'=u'\times \cos(u))</center>
以及三角函数的一些特殊值 :
<center>
<table border="1" width="50%">
  <tbody>
    <tr>
      <td> <i>x</i> </td>
      <td> 0 </td>
      <td> \(\frac{\pi}{6}) </td>
      <td> \(\frac{\pi}{4}) </td>
      <td> \(\frac{\pi}{3}) </td>
      <td> \(\frac{\pi}{2}) </td>
    </tr>
    <tr>
      <td> \(\cos x) </td>
      <td> 1 </td>
      <td> \(\frac{\sqrt{3}}{2}) </td>
      <td> \(\frac{\sqrt{2}}{2}) </td>
      <td> \(\frac{1}{2}) </td>
      <td> 0 </td>
    </tr>
    <tr>
      <td> \(\sin x) </td>
      <td> 0 </td>
      <td> \(\frac{1}{2}) </td>
      <td> \(\frac{\sqrt{2}}{2}) </td>
      <td> \(\frac{\sqrt{3}}{2}) </td>
      <td>1  </td>
    </tr>
  </tbody>
</table>
</center>
和以下三角公式 :
<center>
\(\cos (2x)=2\cos^2x-1),\quad \(\cos (2x)=1-2\sin^2x)
</center>
}

\answer{I 的值}{\rep}{type=formal}
\solution{函数
<center>
\(x \rightarrow \f1)
</center>
的原函数是 :
<center>
\(x \rightarrow \g1)
</center>
}
