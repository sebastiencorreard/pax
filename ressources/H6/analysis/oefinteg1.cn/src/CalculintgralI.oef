\title{积分学 I}
\language{cn}
\range{-5..5}
\author{Michel Gosse}
\email{michel.gosse@ac-poitiers.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a=random(-2,-1,1,2)}
\integer{c=random(-2,-1,1,2)}
\integer{b=random(-2,-1,1,2)}
\integer{n=-\b/\a}
\integer{p=random(2,3)}
\integer{p1=random(-2,-1,1,2)}
\integer{a1=\p1*(\a)^2}
\integer{b1=\p1*\b*\a}
\integer{c1=(\a)^2}
\integer{d1=2*\b*\a}
\integer{e1=(\b)^2}
\integer{d=(\a>0)?random(\n+1..5):random(-5..\n-1)}
\integer{e=(\a>0)?random(\n+1..5):random(-5..\n-1)}

\integer{tmp=(\a>0)?random(\n+1..5):random(-5..\n-1)}
\integer{e=(\e=\d)?\tmp:\e}

\function{f=random((\a*x+\b)^\p,1/(\a*x+\b)^\p,\c/(\a*x+\b),
(\a1*x+\b1)/(\c1*x^2+\d1*x+\e1),\c/sqrt(\a*x+\b),\c*e^(\a*x),
\c*e^(\a*x+\b),(\a1*x+\b1)*e^(\c1*x^2+\d1*x+\e1),
\a*x^2+\b*x+\c
)}
\text{f1=texmath(\f)}
\function{g=int(\f,x)}
\text{g1=texmath(\g)}
\text{rep=maxima(subst(x=\e,\g)-subst(x=\d,\g);)}
\text{rep1=\texmath(\rep)}
\statement{计算以下积分的精确值 :
<center>
\(I=\int_{\d}^{\e} \f1 \, dx)
</center><br>
在输入回答时, 可利用以下的协定:<br>
自然对数写成 <i>log</i>. 例如, 输入
<i>log(2)</i> 代表实数 <i>ln(2)</i>. 反之, 软件用 <i>log</i> 代表 <i>ln</i>. <br>
平方根函数写成 <i>sqrt</i>. 例如, 输入
<i>sqrt(2)</i> 代表实数 \(\sqrt{2}). <br>
最后, 指数函数写成 <i>exp</i>. 例如, 输入
<i>exp(2)</i> 代表实数 \(e^2). 
也可以记为 <i>e^2</i>.
}

\hint{回想求导公式 :<br>
\((\frac{1}{u})'=-\frac{u'}{u^2}) <br>
\(\texmath(e^u)'=u'e^u)<br>
\(\texmath(\ln u)'=\frac{u'}{u})<br>
\(\texmath(u^n)'=nu^{n-1}u')<br>
\(\texmath(\sqrt{u})'=\frac{u'}{2\sqrt{u}})
}

\answer{I 的值}{\rep}{type=auto}
\solution{函数
<center>
\(x \rightarrow \f1)
</center>
的原函数是 :
<center>
\(x \rightarrow \g1)
</center>
这样就能求出积分的值.
}
