\title{函数与积分}
\language{cn}
\range{-5..5}
\author{Michel Gosse}
\email{michel.gosse@ac-poitiers.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{b=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\integer{c=random(1..10)}
\integer{e=random(1..10)}
\integer{d=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\function{f=random(\b*sqrt(\c+\e*x^2),\b/(\c+\e*x^2),
\b*exp(\d*x^2),\b*log(1+\c+\e*x^2))}
\text{f=maxima(\f;)}
\text{ftex=\texmath(\f)}
\integer{a=random(-10..10)}
\real{val=evalue(\f,x=0)}
\text{bon=(\val>0)?递增:递减}
\text{bon1=(\val>0)?>0:<0}
\text{faux=(\val>0)?,递减:递增}

\text{g=maxima(subst(x=t,\f);)}
\text{gtex=texmath(\g)}

\statement{考虑由下式定义的 \(\RR) 上的函数 <i>F</i> :
<center>
\(F(x)=\int_{\a}^{x}\gtex \, dt)
</center>
在 \(\RR) 上, 函数 <i>F</i> 是 :
}

\hint{根据定义, 函数 <i>F</i> 是函数
<center>
\(t \rightarrow \gtex) 
</center>
在 \(\RR) 上的在 \a 取零值的唯一原函数.}

\choice{方向 :}{\bon}{\faux}

\solution{对 \(\RR) 的所有 <i>x</i>, 函数 <i>F</i> 的导数可表示成 :
<center>
\(F'(x)=\ftex)
</center>
由于 \(F'(x)\bon1), 可以推断函数 <i>F</i> 在 \(\RR) 上是\bon的.}
