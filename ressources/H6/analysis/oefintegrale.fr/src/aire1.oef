\title{Aire entre une courbe et l'axe des x}
\language{fr}
\range{-5..5}
\author{Chantal,Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{n = random(1..5)}

remplacement de la fonction affine par l'axe abscisses
\integer{aa=0}
\integer{bb= 0}

bornes de l'intervalle
\integer{a = \n>3? randint(1..4) : randint(-2..2)}
\integer{b = \a+ randint(1..3)}

position courbe/axe
\integer{signe = random(-1,1)}

fonction

\integer{c=random(1..3)*random(-1,1)}
\integer{c2=random(1..3)*random(-1,1)}
\integer{d=random(-3..3)}
\integer{d2=random(-3..3)}
\integer{e=random(-5..5)}

\function{f = item(\n,
\c*x^2 + \d*x,
\c*x^3 + \d*x,
\c*x^3 + \d*x^2+\e*x,
\c*x,
\c*x^2

)}

Pour que f soit positive
\text{A=slib(function/bounds \f, x,\a,\b)}
\integer{min = round(\A[1]) - 1}
\function{f = \f - \min }

\text{ft=texmath(\f)}

Pour que la fonction qu'on ajoute à lin soit du signe voulu
\function{ff = maxima(expand((\f)*\signe))}

\function{lin = pari(\aa*x+\bb)}
\text{lint=texmath(\lin)}
\function{s = simplify((\ff) + (\lin))}
\text{st=texmath(\s)}

\function{g=int(\f,x)}
\rational{Ha = maxima(subst(x=\a,\g))}
\rational{Hb = maxima(subst(x=\b,\g))}
\text{gt=texmath(\g)}

coordonnées d'un point dans le domaine
\real{xmil = (\a + \b)/2}
\real{ymil = (maxima(subst(x=\xmil,\s))+maxima(subst(x=\xmil,\lin)))/2}

\real{xmin=\a-0.3}
\real{xmax=\b+0.3}

\text{B=slib(function/bounds \s, x,\xmin,\xmax)}
\text{C=slib(function/bounds \lin, x,\xmin,\xmax)}

\text{I=slib(function/integrate \f,x,\a,\b,fast)}

\real{ymin= min(\B[1],\C[1])-1}
\real{ymax= max(\B[2],\C[2])+1}


\text{position= \signe = 1?au dessus:en dessous}
\text{expl = \signe = 1? (\s) - (\lin) : (\lin) - (\s)}

\feedback{\reply1<0}{Attention, une aire ne peut pas être négative ! }

\statement{
Déterminer la valeur exacte de l'aire du domaine compris entre <span style="color:blue">
la courbe représentative</span> de la fonction \(f) définie par :

\(f(x)=\st), <span style="color:red">l'axe des abscisses </span>,
et les <span style="color:green">droites verticales</span> d'équations \(x=\a) et \(x=\b).
<p>
L'allure de la courbe représentative de \(f) est donnée ci-dessous ; le domaine est
colorié en jaune.
<br>
Le rectangle noir indique l'unité d'aire.
</p>
<div class="wimscenter">
\draw{500,300}{
xrange \xmin,\xmax
yrange \ymin,\ymax

linewidth 2
segment \b,\ymin,\b,\ymax,green
segment \a,\ymin,\a,\ymax,green
plot blue,\s
plot red,\lin
linewidth 1

fill \xmil,\ymil,yellow
textup green,\b,\ymin,medium,x = \b
textup green,\a,\ymin,medium,x = \a

rect \a,\ymax-1,\a +1,\ymax,black

}
</div>
}

\hint{La courbe de la fonction \(f) est \position de l'axe des abscisses
sur l'intervalle [\a,\b], donc l'aire cherchée est donnée en unités d'aires par :

<div class="wimscenter">
\if{\signe = 1}{\(A= integrate(\st,x=\a..\b)\)
}{\(A=-integrate(\s,x=\a..\b)=integrate(-(\s),x=\a..\b)\)}.
</div>
Il faut commencer par chercher une primitive de \(f) pour enfin calculer l'intégrale.
}

\answer{Valeur de l'aire (en unités d'aire)}{\I}{type=formal}
\solution{La courbe de la fonction \(f\) est \position de l'axe des abscisses sur [\a,\b],
donc l'aire cherchée est donnée en unités d'aires par :
<div class="wimscenter">
\(A= integrate(\f,x=\a..\b)\)
</div>
 Une primitive de \(x \mapsto f(x) = \ft) est \(F\) définie par \(F(x) = \gt).
<br>
On a  : \(F(\a) = \Ha) et \(F(\b) = \Hb) et on en déduit
\(A= integrate(\expl,x=\a..\b)=F(\b) - F(\a) = \Hb - (\Ha) = \I\).

}
