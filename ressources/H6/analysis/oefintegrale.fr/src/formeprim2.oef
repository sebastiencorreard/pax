\title  {Primitive de forme donnée 2}
\author {Chantal,Causse}
\email  {Chantal.Causse@noos.fr}
\format {html}

\integer{a1=random(1..5)*random(1,-1)}
\integer{a2=random(1..5)*random(1,-1)}
\integer{c1=random(1..3)}
\integer{c2=random(1..5)}

\function{F=(\a1*x+\a2)/(\c1*x^2+\c2)}
\text{D=texmath(\c1*x^2+\c2)}
\function{f=simplify(diff(\F,x))}
\text{ft=texmath(\f)}
\statement{Déterminer les nombres \(a) et \(b) pour que la fonction \(F)
définie par \(F(x) = \frac{a x + b}{\D}) soit une primitive de la fonction
\(f) définie par \(f(x) = \ft).

<br>En déduire ensuite l'expression de \(F(x)).
}

\answer{\(a\)}{\a1}{type=integer}
\answer{\(b\)}{\a2}{type=integer}
\answer{\(F(x)\)}{\F}{type=formal}

\hint{\(F) est une primitive de \(f) si et seulement si \(F'(x) = f(x)).
<br>
En calculant \(F'(x)) et en l'identifiant à \(f(x)), on trouve
des équations permettant de trouver \(a) et \(b).}
