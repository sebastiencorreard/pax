\title  {Formules de dérivées et primitives 7 (sin et cos)} 
\author {Sophie,Lemaire}
\email  {sophie.lemaire@math.u-psud.fr}
\format {html}

\text{confparm2 = \confparm2 = ? X : \confparm2}
\text{var = \confparm2 issametext X ? x}
\text{var = \confparm2 issametext T ? t}
\text{var = \confparm2 issametext XT ?randitem(x,t)}

\integer{k=randint(-4..4)}
\integer{k1=random(1..5)*random(-1,1)}
\integer{k2=random(1..5)*random(-1,1)}
\integer{a1=random(1..5)*random(-1,1)}
\integer{a2=random(1..5)*random(-1,1)}
\integer{a3=random(1..5)*random(-1,1)}
\integer{a4=random(1..5)*random(-1,1)}
\integer{a5=random(1..5)*random(-1,1)}
\integer{a6=random(1..5)*random(-1,1)}
\integer{a7=random(1..5)}\integer{a8=random(1..5)}
\integer{n=randint(2..6)}
\rational{u5=simplify(-(\a6)/(\a5))}
\text{liste1 = cos(\a1*\var+(\k1)),sin(\a2*\var+\k2),cos(\a1*\var),sin(\a2*\var)}
\text{dliste1 = -(\a1)*sin(\a1*\var+(\k1)),(\a2)*cos(\a2*\var+(\k2)),-(\a1)*sin(\a1*\var),(\a2)*cos(\a2*\var)}
\text{Fliste1 = 1/(\a1)*sin(\a1*\var+(\k1)),-1/(\a2)*cos(\a2*\var+(\k2)), 1/(\a1)*sin(\a1*\var),-1/(\a2)*cos(\a2*\var)}
\text{liste2 = (cos(\var))^(\n),(sin(\var))^(\n),1/cos(\var),1/sin(\var),\cos(\var)/sin(\var),\sin(\var)/cos(\var)}
\text{dliste2 = -\n*sin(\var)*(cos(\var))^(\n-1),\n*cos(\var)*(sin(\var))^(\n-1),sin(\var)/(cos(\var))^(2),-cos(\var)/(sin(\var))^(2),-1/(sin(\var))^2,1/(cos(\var)^2)}
\text{liste3 = sin(\var)*(cos(\var))^(\n),cos(\var)*(sin(\var))^(\n),cos(\var)/(sin(\var))^(\n),sin(\var)/(cos(\var))^(\n)}
\text{Fliste3 = -(cos(\var))^(\n+1)/(\n+1),(sin(\var))^(\n+1)/(\n+1),(sin(\var))^(1-\n)/(1-\n),-(cos(\var))^(1-\n)/(1-\n)}
\rational{binf=\k/2}\rational{bsup=(\k+1)/2}
\if{\k=0}{\text{interv=0,texmath(pi/2)}}
   {\if{\k=-1}{\text{interv=texmath(-pi/2),0} }
       {\text{interv=texmath(\binf*pi),texmath(\bsup*pi)}}
   }
\text{v1 = randint(1..4)}
\text{v2 = randint(1..6)}
\text{v3 = randint(1..4)}
\text{v4 = randint(1..4)}
\text{f1 = \a3*\liste1[\v1]}
\text{df1 = simplify(\a3*\dliste1[\v1])}

\text{f2 = simplify(\a4*\liste2[\v2])}
\text{df2 = simplify(\a4*\dliste2[\v2])}

\text{f3 = simplify(\a5*\liste1[\v3])}
\text{F3 = simplify(\a5*\Fliste1[\v3])}

\text{f4 = simplify(\a6*\liste3[\v4])}
\text{F4 = simplify(\a6*\Fliste3[\v4])}

\text{f1t = texmath(\f1)}
\text{f2t = texmath(\f2)}
\text{f3t = texmath(\f3)}
\text{f4t = texmath(\f4)}

\text{df1t = texmath(\df1)}
\text{df2t = texmath(\df2)}
\text{F3t = texmath(\F3)}
\text{F4t = texmath(\F4)}

\statement{
<ol><li>
<label for="reply1">
La dérivée de \( \var \mapsto \f1t\) sur  \({\RR}\)</label> est la fonction \(\var\mapsto \) \embed{reply1,25}</li>
<li>
<label for="reply2">La dérivée de \(\var\mapsto\f2t\)  sur
\(\left\rbrack\interv\right\lbrack\)</label> est la fonction \(\var\mapsto \) \embed{reply2,25}</li>

<li>La fonction  \(\var\mapsto \) \embed{reply3,25} est <label for="reply3">une primitive  de \(\var \mapsto \f3t\) sur \({\RR}\). </label> </li>
<li>La fonction \(\var\mapsto \) \embed{reply4,25}  est <label for="reply4">une primitive de \(\var \mapsto \f4t\) sur \(\left\rbrack\interv\right\lbrack\)</label></li>
</ol>
}
\hint{Les réponses s'expriment à l'aide de fonctions cosinus et sinus}
\answer{Dérivée de \(\f1t)}{\df1}{type=formal}
\answer{Dérivée de \(\f2t)}{\df2}{type=formal}
\answer{Primitive de \(\f3t)}{\good3}{type=function}
\answer{Primitive de \(\f4t)}{\good4}{type=function}

\text{test3=maxima(if constantp(fullratsimp((\good3)-(\F3)))  then 1 else 0;)}
\text{test4=maxima(if constantp(fullratsimp((\good4)-(\F4)))  then 1 else 0;)}

\condition{La réponse est bonne}{\test3=1}
\condition{La réponse est bonne}{\test4=1}
\solution{<ol><li>La dérivée de \(\var\mapsto \f1t\) en tout point \(\var\in \RR\) est \(\df1t).</li>
<li>La dérivée de \(\var\mapsto \f2t\) en tout point \(\var\in\) &#93;\(\interv\)&#91;  est  \(\df2t\).</li>
<li>La fonction \(\var\mapsto \F3t\) est une primitive de \(\var\mapsto \f3t\) sur \({\RR}\).</li>
<li>La fonction\(\var\mapsto \F4t\) est une primitive de \(\var\mapsto \f4t\) sur  l'intervalle  &#93;\(\interv\)&#91; .</li></ol>
Les autres primitives s'obtiennent à partir de celles-ci en ajoutant une constante.}
