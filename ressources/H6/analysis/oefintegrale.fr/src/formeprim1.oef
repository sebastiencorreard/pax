\title  {Primitive de forme donnée 1}
\author {Chantal,Causse}
\email  {Chantal.Causse@noos.fr}
\format {html}

\integer{a1=random(1..5)*random(1,-1)}
\integer{a2=random(1..5)*random(1,-1)}
\integer{c1=random(1..3)}
\integer{c2=random(1..5)}

\integer{c1 = (\a1)*(\c2)-(\a2)*(\c1)=0 ? \c1 + 1 : \c1}


\function{F=(\a1*x+\a2)/(\c1*x+\c2)}
\text{D=texmath(\c1*x+\c2)}
\function{f=simplify(diff(\F,x))}
\text{ft=texmath(\f)}

\integer{choix = random(1,2)}
\text{question = item(\choix, (a x + \a2)/(\D),(\a1 x + a)/(\D))}
\text{rep=item(\choix,\a1,\a2)}

\statement{Déterminer le nombre \({a}) pour que la fonction \(F)
 définie par \(F(x) = \question) soit une primitive de la fonction \(f) définie
 par \(f(x) = \ft).
<br>
En déduire ensuite l'expression de \(F(x)).
}

\answer{\(a\)}{\rep}{type=integer}

\answer{\(F(x)\)}{\F}{type=formal}

\hint{\(F) est une primitive de \(f) si et seulement si \(F'(x) = f(x)).
<br>
En calculant \(F'(x)) et en l'identifiant à \(f(x)), on trouve une équation
permettant de trouver \(a).}
