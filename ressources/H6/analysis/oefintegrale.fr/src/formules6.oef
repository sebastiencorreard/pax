\title  {Formules de dérivées et primitives 6 (puiss ent et fract)}
S. L variante de l'exercice de Chantal Causse
"Formules de dérivées et primitives 4"
module=H6/analysis/oefintegrale.fr&cmd=new&exo=formules4
\author {Sophie, Lemaire}
\email  {sophie.lemaire@math.u-psud.fr}
\format {html}

\text{confparm2 = \confparm2 = ? X : \confparm2}
\text{var = \confparm2 issametext X ? x}
\text{var = \confparm2 issametext T ? t}
\text{var = \confparm2 issametext XT ?randitem(x,t)}

\integer{k=random(1..8)*random(-1,1)}
\integer{a1=random(1..5)*random(-1,1)}
\integer{a2=random(1..5)*random(-1,1)}
\integer{a3=random(1..5)*random(-1,1)}
\integer{a4=random(1..5)*random(-1,1)}
\integer{a5=random(1..5)*random(-1,1)}
\integer{a6=random(1..5)*random(-1,1)}
\integer{a7=random(1..5)*random(-1,1)}
\rational{b1=randint(1..9)/10}
\rational{b2=randint(1..9)/10}

\text{liste1 = random(\k,1/\k),random(\a1*\var,\a1*\var,\var/\a1),random(\a2*\var^2,\a2*\var^2,\var^2/\a2),random(\a3*\var^3,\a3*\var^3,\var^3/\a3),random(\a4*\var^4,\a4*\var^4,\var^4/\a4)}
\text{liste1 = shuffle(\liste1)}
\text{liste2 = \a5*\var^(\b1),\a7*\var^(-\b2)}
\text{Liste = shuffle(random(\a6/\var^2,1/(\a6*\var^2)),random(\a7/\var^3,1/(\a7*\var^3)),random(\a2/\var^4,1/(\a2*\var^4)),random(\a3/\var^5,1/(\a3*\var^5)))}
\text{f1 = \liste1[1]+\liste1[4]}
\text{f2 = \liste1[2]+\liste2[1]}
\text{f3 = \Liste[1]+\Liste[2]}
\text{f4 = \liste1[1]+\liste1[5]}
\text{f5 = \liste1[3]+\liste2[2]}
\text{f6 = \Liste[3]+\Liste[4]}

\text{f1t = texmath(\f1)}
\text{f2t = texmath(\f2)}
\text{f3t = texmath(\f3)}
\text{f4t = texmath(\f4)}
\text{f5t = texmath(\f5)}
\text{f6t = texmath(\f6)}


\function{d1 = diff(\f1,\var)}
\function{d2 = diff(\f2,\var)}
\function{d3 = diff(\f3,\var)}
\function{F4=integrate(\f4,\var)}
\function{F5=integrate(\f5,\var)}
\function{F6=integrate(\f6,\var)}
\text{d1t = texmath(\d1)}
\text{d2t = texmath(\d2)}
\text{d3t = texmath(\d3)}
\text{F4t = texmath(\F4)}
\text{F5t = texmath(\F5)}
\text{F6t = texmath(\F6)}
\statement{
<div>1. <label for="reply1">
La dérivée de \( \var \mapsto \f1t\) sur \({\RR}\)</label>
 est la fonction \(\var \mapsto \) \embed{reply1,18}</div>
<div>2. <label for="reply2">
La dérivée de \(\var \mapsto \f2t\) sur \({\RR^{*}_+}\) </label> 
est la fonction \(\var \mapsto \) \embed{reply2,18}</div>
<div>3. <label for="reply3">
La dérivée de \(\var \mapsto \f3t\) sur \({\RR^*}\)</label>
 est la fonction \(\var \mapsto \)\embed{reply3,18}</div>
<div>4. <label for="reply4">
La fonction \(\var \mapsto \) \embed{reply4,20} est une primitive  de \(\var \mapsto \f4t\) sur \({\RR}\)</label>
 </div>
<div>5. <label for="reply5">La fonction \(\var\mapsto \) \embed{reply5,20} est une primitive de \(\var \mapsto \f5t\) sur \({\RR^{*}_+}\)</label></div>
<div>6. <label for="reply6">La fonction \(\var\mapsto \) \embed{reply6,20} est une primitive de \(\var \mapsto \f6t\) sur \({\RR^{*}_+}\)</label> 
</div>}

\answer{Dérivée de \(\f1)}{\d1}{type=formal}
\answer{Dérivée de \(\f2)}{\d2}{type=formal}
\answer{Dérivée de \(\f3)}{\d3}{type=formal}
\answer{Primitive de \(\f4)}{\good4}{type=function}
\answer{Primitive de \(\f5)}{\good5}{type=function}
\answer{Primitive de \(\f6)}{\good6}{type=function}

\text{test4=maxima(if constantp(fullratsimp((\good4)-(\F4)))  then 1 else 0;)}
\text{test5=maxima(if constantp(fullratsimp((\good5)-(\F5)))  then 1 else 0;)}
\text{test6=maxima(if constantp(fullratsimp((\good6)-(\F6)))  then 1 else 0;)}

\condition{La réponse est bonne}{\test4=1}
\condition{La réponse est bonne}{\test5=1}
\condition{La réponse est bonne}{\test6=1}

\solution{<ol><li>La dérivée de \(\var\mapsto \f1t\) sur \(\RR\) est la fonction \(\var\mapsto \d1t).</li>
<li>La dérivée de \(\var \mapsto \f2t\) sur \(\RR^{*}_+\) est la fonction \(\var \mapsto \d2t\).</li>
<li>La dérivée de \(\var \mapsto \f3t) sur \(\RR^*\) est la fonction \(\var \mapsto \d3t\).</li>
<li>La fonction \(\var \mapsto \F4t\) est une primitive de \(\var \mapsto \f4t\) sur \(\RR\).</li>
<li>La fonction\(\var \mapsto \F5t\) est une primitive de \(\var \mapsto \f5t\) sur \(\RR^{*}_+\).</li>
<li>La fonction\(\var \mapsto \F6t\) est une primitive de \(\var \mapsto \f6t\) sur \(\RR^{*}_{+}\).</li>
</ol>
Les autres primitives s'obtiennent à partir de celles-ci en ajoutant une constante.}
