\title{Aire entre deux courbes}
\language{fr}
\range{-5..5}
\author{Chantal,Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

droite
\integer{aa=randint(-3..3)}
\integer{bb= \aa = 0 ?randint(1..3)*random(-1,1): randint(-3..3)}

bornes de l'intervalle
\integer{a = randint(-2..2)}
\integer{b = \a+ randint(1..3)}

fonction
\integer{signe = random(-1,1)}

\integer{c=random(1..3)}
\integer{d=random(-3..3)}
\integer{e=random(-5..5)}

\function{f = random(
\c*x^2 + \d*x+\e,
\c*x^3 + \d*x+\e,
\c*x^3 + \d*x^2+\e*x
)}
Pour que f soit positive
\text{A=slib(function/bounds \f, x,\a,\b)}
\integer{min = round(\A[1]) - 1}
\function{f = \f - \min }
\function{f = pari(\f)}
\text{ft=texmath(\f)}

Pour que la fonction qu'on ajoute à lin soit du signe voulu
\function{ff = pari((\f)*\signe)}

\function{lin = pari(\aa*x^2+\bb*x)}
\text{lint=texmath(\lin)}
\function{s = pari((\ff) + (\lin))}
\text{st=texmath(\s)}

\function{g=int(\f,x)}
\rational{Ha = maxima(subst(x=\a,\g))}
\rational{Hb = maxima(subst(x=\b,\g))}
\text{gt=texmath(\g)}

coordonnées d'un point dans le domaine
\real{xmil = (\a + \b)/2}
\real{ymil = (maxima(subst(x=\xmil,\s))+maxima(subst(x=\xmil,\lin)))/2}

\real{xmin=\a-0.3}
\real{xmax=\b+0.3}

\text{B=slib(function/bounds \s, x,\xmin,\xmax)}
\text{C=slib(function/bounds \lin, x,\xmin,\xmax)}

\text{I=slib(function/integrate \f,x,\a,\b,fast)}

\real{ymin=min(\B[1],\C[1])-1}
\real{ymax=max(\B[2],\C[2])+1}
\real{ymm = \ymin+(\ymax - \ymin)/20}

\text{position= \signe = 1?au dessus:en dessous}
\text{expl = \signe = 1? (\s) - (\lin) : (\lin) - (\s)}
\text{explt = \signe = 1? (\st) - (\lint) : (\lint) - (\st)}

\feedback{\reply1<0}{Attention, une aire ne peut pas être négative ! }

\statement{ La courbe représentative de la fonction \(f) définie par :

\(f(x) = \st) est dessinée ci-dessous en bleu.
<br>
La courbe représentative de la fonction \(g) définie par : \(g(x) = \lint) est dessinée en rouge.
<br>
Les droites dessinées en noir ont comme équations \(x = \a) et \(x = \b).
<br>
L'aire du rectangle noir est 1 unité d'aire.

<div class="wimscenter">
\draw{500,300}{
xrange \xmin,\xmax
yrange \ymin,\ymax
linewidth 2
segment \b,\ymin,\b,\ymax,black
segment \a,\ymin,\a,\ymax,black
plot blue,\s
plot red,\lin
fill \xmil,\ymil,yellow
textup black,\b,\ymin,small,x = \b
textup black,\a,\ymin,small,x = \a
rect \a,\ymax-1,\a +1,\ymax,black

}
</div>
 Déterminer la valeur exacte de l'aire du domaine colorié en jaune.
}

\hint{La courbe de la fonction \(f) est \position de la courbe de la fonction \(g) sur
 l'intervalle [\a,\b], donc l'aire cherchée est donnée en unités d'aires par :
<div class="wimscenter">>
\(A=integrate(\expl,x=\a..\b)\)
</div>
Il faut commencer par réduire \(\expl), puis en chercher une primitive pour
enfin calculer l'intégrale.

}

\answer{Valeur de l'aire (en unités d'aire)}{\I}{type=formal}
\solution{La courbe de la fonction \(f) est \position 
de la courbe de la fonction \(g) sur l'intervalle [\a,\b], 
donc l'aire cherchée est donnée en unités d'aires par :
<div class="wimscenter">
\(A= integrate(\expl,x=\a..\b)\)
</div>
D'une part, on a : \(\expl = \ft), d'autre part une primitive de \(x \mapsto h(x) = \ft) est 
\(H\) définie par \(H(x) = \gt) avec
\(H(\a) = \Ha) et \(H(\b) = \Hb).  On obtient donc
<p class="wimscenter">\(A= integrate(\expl,x=\a..\b)=H(\b) - H(\a) = \Hb - (\Ha) = \I\).</p>
}
