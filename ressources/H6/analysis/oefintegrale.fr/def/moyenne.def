!set title=Moyenne de fonction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=Chantal.Causse@noos.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 2

val6=$[$(tmp0)]
tmp0=!randint $val6+1, $val6+5

val7=$[$(tmp0)]
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
val11=!rawmath $val8*x^2+$val9 *x+$val10,	 $val8 *x^3+$val9* x+$val10,	 $val9*x^2+$val10	
tmp0=!itemcnt $val11

tmp1=!randint 1, $(tmp0)

val12=$[rint($(tmp1))]
tmp0=!item $val12 of $val11

val13=!rawmath $(tmp0)
tmp0=!texmath $val13

val14=$(tmp0)
evaltmp=$val13

evaltmp=!mathsubst x=(t) in $evaltmp
tmp0=($evaltmp)
val15=!rawmath $(tmp0)
!readproc slib/function/bounds $val13, x,$val6-0.5,$val7+0.5 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/function/integrate $val13,x,$val6,$val7,fast 
tmp0=$slib_out
val17=$(tmp0)
t_=!rawmath ($val17)/($val7-($val6))
val18=!exec pari print($t_)
!readproc slib/function/bounds $val13, x,$val6,$val7 
tmp0=$slib_out
val19=$(tmp0)
val20=$[max($(val19[1]),floor(($(val19[1])+2*$val18)/3))]
val21=$[min($(val19[2]),ceil(($(val19[2])+2*$val18)/3))]
val22=$[min(-1,$val6-0.5)]
val23=$[max($val7+0.5,1)]
val24=$[min(0,$(val16[1]))]
val25=$[max($(val16[2]),0)]
val26=$[rint(max(1,5*round(($val25-$val24)/50)))]
val24=$[min(-$val26,$(val16[1])-$val26)]
val25=$[max($(val16[2])+$val26,$val26)]
val27=$[rint($val26*floor($val24/$val26))]
val28=$[rint($val26*floor($val25/$val26))]
val29=$[rint(floor($val22)+1)]
val30=$[rint(floor($val23))]
tmp0=!mathsubst  x=($val6)  in  $val13

val31=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath $(tmp0)
tmp0=!mathsubst  x=($val7)  in  $val13

val32=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val32

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val32=!rawmath $(tmp0)
val33=xrange  $val22, $val23	        yrange $val24,$val25		 parallel $val29,$val24,$val29,$val25,1,0,$val30-($val29)+1,grey	 parallel $val22,$val27,$val23,$val27,0,$val26,$val28-($val27)+1,grey	hsegment 0,0,black	arrow  0,0,1,0,6,black		vsegment 0,0,black	plot blue, $val13	fcircle $val6,$val31,7, green	fcircle $val7,$val32,7 , green	fcircle 0,0,7 , black	text black,0.1,0,medium,O	text black,1,0,medium,1	text black,0,$val26,medium,$val26	text green,0.1,$val31,medium,$val31	text green,0.1,$val32,medium,$val32		text green,$val6,0,medium,$val6	text green,$val7,0,medium,$val7		dsegment $val6,0,$val6,$val31,green	dsegment $val7,0,$val7,$val32,green	dsegment 0,$val31,$val6,$val31,green	dsegment 0,$val32,$val7,$val32,green	trange $val6,$val7	linewidth 3	plot green,t, $val15
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=range
replyoption1=noanalyzeprint 
replyname1=Ordre de grandeur de la valeur moyenne
replygood1=!rawmath $val20,$val21
replytype2=numexp
replyname2=Valeur moyenne
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $m_step=1 
$()La courbe représentative d'une fonction 
!insmath f
$() est dessinée ci-dessous :	<br> 
!read oef/draw.phtml 500,300 \
$val33 
$()	<p>Déterminer graphiquement l'ordre de grandeur de la valeur moyenne	sur l'intervalle [$val6,$val7] de la fonction 
!insmath f
$().</p> 
!endif
$()	
!if $m_step=2 
$()	 
!read oef/draw.phtml 500,300 \
$val33 
$()<p>	Vous avez trouvé que l'ordre de grandeur de la	valeur moyenne sur l'intervalle [$val6,$val7] de la fonction 
!insmath f
$() est $m_reply1.	</p><p>	Pour faire le calcul exact de la valeur moyenne sur l'intervalle	[$val6,$val7] de la fonction 
!insmath f
$(), on donne l'expression de la fonction 
!insmath f
$() :
!insmath f(x)=$val14
$().	</p>		Calculez la valeur moyenne sur l'intervalle [$val6,$val7] de la fonction 
!insmath f
$().	 
!endif
$()
$()
!exit

:hint
$()	
!if $m_step=1 
$()C'est uniquement l'ordre de grandeur de la valeur moyenne	qui est demandé. La réponse est considérée comme juste dans un intervalle	assez large autour de la valeur exacte. 
!else
$() 	La valeur moyenne de 
!insmath f
$() sur l'intervalle [a ; b] est égale à 
!insmath \frac{1}{b - a}
$() 
!insmath integrate(f(x),x=a, b) 
$() 
!endif
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>	La valeur moyenne de cette fonction sur l'intervalle [$val6;$val7] est $val18.	<br>	Toute valeur comprise entre $val20 et $val21 était acceptée comme ordre de grandeur.	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,14,18,20,21,33
embedcnt=0
