!set title=Primitive de forme donnée 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=Chantal.Causse@noos.fr

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]

!ifval ($val6)*($val9)-($val7)*($val8)=0 
val8=$[rint( $val8 + 1 )]
!else
val8=$[rint( $val8)]
!endif
val10=!rawmath ($val6*x+$val7)/($val8*x+$val9)
tmp0=!texmath $val8*x+$val9

val11=$(tmp0)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val12=!rawmath $(tmp1)
tmp0=!texmath $val12

val13=$(tmp0)
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of  (a x + $val7)/($val11),($val6 x + a)/($val11)

val15=$(tmp0)
tmp0=!item $val14 of $val6,$val7

val16=$(tmp0)
replytype1=integer

replyname1=\(a\)
replygood1=$val16
replytype2=formal
replyname2=\(F(x)\)
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer le nombre 
!insmath {a}
$() pour que la fonction 
!insmath F
$()	 définie par 
!insmath F(x) = $val15
$() soit une primitive de la fonction 
!insmath f
$() définie	 par 
!insmath f(x) = $val13
$().	<br>	En déduire ensuite l'expression de 
!insmath F(x)
$().	
$()
!exit

:hint
$()
!insmath F
$() est une primitive de 
!insmath f
$() si et seulement si 
!insmath F'(x) = f(x)
$().	<br>	En calculant 
!insmath F'(x)
$() et en l'identifiant à 
!insmath f(x)
$(), on trouve une équation	permettant de trouver 
!insmath a
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,15
embedcnt=0
