tmp0=!randint -3, 3

val6=$[rint($(tmp0))]

!ifval $val6 = 0 
tmp0=!randint 1, 3

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -3, 3

val7=$[rint( $(tmp2))]
!endif
tmp0=!randint -2, 2

val8=$[rint($(tmp0))]
tmp0=!randint 1, 3

val9=$[rint($val8+ $(tmp0))]
tmp0=!randitem -1,1

val10=$[rint($(tmp0))]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!randint -3, 3

val12=$[rint($(tmp0))]
tmp0=!randint -5, 5

val13=$[rint($(tmp0))]
tmp0=!randitem 	$val11*x^2 + $val12*x+$val13,	$val11*x^3 + $val12*x+$val13,	$val11*x^3 + $val12*x^2+$val13*x	

val14=!rawmath $(tmp0)
!readproc slib/function/bounds $val14, x,$val8,$val9 
tmp0=$slib_out
val15=$(tmp0)
val16=$[rint(round($(val15[1])) - 1)]
val14=!rawmath $val14 - $val16 
t_=!replace internal \( by ( in $val14
tmp0=!exec pari $t_

val14=!rawmath $(tmp0)
tmp0=!texmath $val14

val17=$(tmp0)
t_=!replace internal \( by ( in ($val14)*$val10
tmp0=!exec pari $t_

val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val6*x^2+$val7*x
tmp0=!exec pari $t_

val19=!rawmath $(tmp0)
tmp0=!texmath $val19

val20=$(tmp0)
t_=!replace internal \( by ( in ($val18) + ($val19)
tmp0=!exec pari $t_

val21=!rawmath $(tmp0)
tmp0=!texmath $val21

val22=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val23=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(x=$val8,$val23)
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val24=!exec pari print($t_)
t_=!replace internal \( by ( in subst(x=$val9,$val23)
tmp0=!exec maxima $t_

t_=!rawmath $(tmp0)
val25=!exec pari print($t_)
tmp0=!texmath $val23

val26=$(tmp0)
val27=$[($val8 + $val9)/2]
t_=!replace internal \( by ( in subst(x=$val27,$val21)
tmp0=!exec maxima $t_

t_=!replace internal \( by ( in subst(x=$val27,$val19)
tmp1=!exec maxima $t_

val28=$[($(tmp0)+$(tmp1))/2]
val29=$[$val8-0.3]
val30=$[$val9+0.3]
!readproc slib/function/bounds $val21, x,$val29,$val30 
tmp0=$slib_out
val31=$(tmp0)
!readproc slib/function/bounds $val19, x,$val29,$val30 
tmp0=$slib_out
val32=$(tmp0)
!readproc slib/function/integrate $val14,x,$val8,$val9,fast 
tmp0=$slib_out
val33=$(tmp0)
val34=$[min($(val31[1]),$(val32[1]))-1]
val35=$[max($(val31[2]),$(val32[2]))+1]
val36=$[$val34+($val35 - $val34)/20]

!ifval $val10 = 1
val37=au dessus
!else
val37=en dessous
