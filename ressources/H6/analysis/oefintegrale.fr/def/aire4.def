!set title=Calcul d'aire (avec exp)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=Chantal.Causse@noos.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=37
prevarcnt=36
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 0,1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val7=$[rint($val6*$(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val8=$[rint($val6*$(tmp0)*$(tmp1))]
tmp0=!randint -2, 2

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($val9+ $(tmp0))]
tmp0=!randitem -1,1

val11=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem x,x^2

tmp1=!randitem x,x^2

tmp2=!randitem 	e^($val12*x),	e^(x/$val12),	e^($val12*x+$val13),	e^(x/$val12+$val13),	e^($val12*x) + $val13*$(tmp0),	e^(x/$val12)+$val13*$(tmp1)	

val14=!rawmath $(tmp2)
!readproc slib/function/bounds $val14, x,$val9,$val10 
tmp0=$slib_out
val15=$(tmp0)
val16=$[rint(round($(val15[1])) - 1)]
val14=!rawmath $val14 - $val16 
t_=!replace internal \( by ( in expand($val14)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
tmp0=!texmath $val14

val17=$(tmp0)
tmp=!translate ";': to $     $ in ($val14)*$val11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val7*x+$val8
tmp0=!exec pari $t_

val19=!rawmath $(tmp0)
tmp0=!texmath $val19

val20=$(tmp0)
tmp0=!item $val6+1 of l'axe des abscisses, la droite d'équation \(y = $val20)

val21=$(tmp0) 
t_=!replace internal \( by ( in expand(($val18) + ($val19))
tmp0=!exec maxima $t_

val22=!rawmath $(tmp0)
tmp0=!texmath $val22

val23=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val24=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(x=$val9,$val24)
tmp0=!exec maxima $t_

val25=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(x=$val10,$val24)
tmp0=!exec maxima $t_

val26=!rawmath $(tmp0)
tmp0=!texmath $val24

val27=$(tmp0)
val28=$[($val9 + $val10)/2]
t_=!replace internal \( by ( in subst(x=$val28,$val22)
tmp0=!exec maxima $t_

t_=!replace internal \( by ( in subst(x=$val28,$val19)
tmp1=!exec maxima $t_

val29=$[($(tmp0)+$(tmp1))/2]
val30=$[$val9-0.3]
val31=$[$val10+0.3]
!readproc slib/function/bounds $val22, x,$val30,$val31 
tmp0=$slib_out
val32=$(tmp0)
!readproc slib/function/bounds $val19, x,$val30,$val31 
tmp0=$slib_out
val33=$(tmp0)
!readproc slib/function/integrate $val14,x,$val9,$val10,fast 
tmp0=$slib_out
val34=$(tmp0)
t_=!replace internal \( by ( in expand($val34)
tmp0=!exec maxima $t_

val34=$(tmp0)
val35=$[min($(val32[1]),$(val33[1]))-1]
val36=$[max($(val32[2]),$(val33[2]))+1]

!ifval $val11 = 1
val37=au dessus
!else
val37=en dessous
!endif

!ifval $val11 = 1
val38= ($val22) - ($val19) 
!else
val38= ($val19) - ($val22)
!endif
replytype1=formal
replyname1=Valeur de l'aire (en unités d'aire)
replygood1=$val34
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Déterminer la <em>valeur exacte</em> de l'aire du domaine compris entre la courbe	  représentative de la fonction 
!insmath f
$() définie par :	
!insmath f(x)=$val22
$(), $val21, et les droites verticales d'équations 
!insmath x=$val9
$() et 
!insmath x=$val10
$().	<p>	La courbe représentative de 
!insmath f
$() est tracée en bleu, et $val21  en rouge ;	le domaine est colorié en jaune.	</p>	Le rectangle noir indique l'unité d'aire.	<div class="wimscenter">	 
!read oef/draw.phtml 500,300 \
	xrange $val30,$val31	yrange $val35,$val36		segment $val10,$val35,$val10,$val36,green	segment $val9,$val35,$val9,$val36,green	linewidth 2	plot blue,$val22	plot red,$val19	fill $val28,$val29,yellow	textup green,$val10,$val35,medium,x = $val10	textup green,$val9,$val35,medium,x = $val9		rect $val9,$val36-1,$val9 +1,$val36,black	 
$()	</div>	
$()
!exit

:hint
$()La courbe de la fonction 
!insmath f
$() est $val37 de l'axe des abscisses	sur l'intervalle [$val9,$val10], donc l'aire cherchée est donnée en unités d'aires par :		<div class="wimscenter">	
!insmath A=integrate($val38, x=$val9, $val10)
$().	</div>	Il faut commencer par chercher une primitive de 
!insmath f
$() pour enfin calculer l'intégrale.	
$()
!exit

:help
$()
$()
!exit

:solution
$()La courbe de la fonction 
!insmath f
$() est $val37 de l'axe des	abscisses sur [$val9,$val10], donc l'aire cherchée est donnée en unités d'aires par :		<div class="wimscenter">	
!insmath A= $val11*integrate($val22,x=$val9, $val10)
$().	</div>	 Une primitive de 
!insmath x \mapsto f(x) = $val17
$() est la fonction 
!insmath F
$() définie par 
!insmath F(x) = $val27
$() avec 	
!insmath F($val9) = $val25
$() et 
!insmath F($val10) = $val26
$(). On obtient donc	<div class="wimscenter">	
!insmath A= integrate($val38,x=$val9, $val10) = F($val10) - F($val9) = $val26 - ($val25) = $val34
$().	</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply1<0
 <div class='oef_feedbacks'>Attention, une aire ne peut pas être négative ! 
$()</div>
!endif

!exit

:test

!exit

