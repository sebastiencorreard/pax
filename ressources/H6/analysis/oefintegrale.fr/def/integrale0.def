!set title=Calcul d'une intégrale_0
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
oefobservation=variante de l'exercice integrale.oef évitant les primitives de (ax+b)²
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,3,4

val10=$[rint($(tmp0))]
tmp0=!randitem -1,1

val11=$[rint($(tmp0))]

!ifval $val6 > 3
tmp0=!randint 1, 5

val12=$[rint( $(tmp0)*$val11 )]
!else
tmp1=!randint -5, 5

val12=$[rint( $(tmp1))]
!endif

!ifval $val6 > 3
tmp0=!randint 1, 5

val13=$[rint( $(tmp0)*$val11 )]
!else
tmp1=!randint -5, 5

val13=$[rint( $(tmp1))]
!endif

!ifval ($val13=$val12)
val13=$[rint($val13+1)]
!else
val13=$[rint($val13)]
!endif
!if $val12 > $val13 
val14=$[rint($val12)]
val12=$[rint($val13)]
val13=$[rint($val14)]
!endif
tmp0=!item $val6 of 	$val7*x+$val8,	$val7*x^$val10+$val8*x+$val9,	$val7*x^2+$val8*x+$val9,	$val7/x^2,	$val8*x+$val9+$val7/x^2,	($val7*x+$val8)^2	

val15=!rawmath $(tmp0)
tmp0=!texmath $val15

val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val15,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val17=!rawmath $(tmp0)
tmp0=!texmath $val17

val18=$(tmp0)
t_=!replace internal \( by ( in subst(x=$val13,$val17)-subst(x=$val12,$val17);
tmp0=!exec maxima $t_

val19=$(tmp0)
t_=!replace internal \( by ( in subst(x=$val12,$val17)
tmp0=!exec maxima $t_

val20=$(tmp0)
t_=!replace internal \( by ( in subst(x=$val13,$val17)
tmp0=!exec maxima $t_

val21=$(tmp0)
tmp0=!texmath $val19

val22=$(tmp0)
replytype1=auto

replyname1=Valeur de I
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la valeur exacte de l'intégrale :	<div class="wimscenter">	
!insmath I=integrate($val15,x=$val12, $val13)
$().</div>	<div class=wims_instruction>Donner la valeur <b>exacte</b> sous forme de fraction, ou sous forme décimale utilisant le point comme séparateur.<br>	Ainsi, si la réponse juste est 
!insmath \frac{1}{100}
$(), on acceptera 1/100 ou 0.01 mais pas 0,01 </div>	
$()
!exit

:hint
$()
!insmath integrate(f(x),x=a, b)= F(b)-F(a)
$() où 
!insmath F
$() est une primitive de 
!insmath f
$().	
$()
!exit

:help
$()
$()
!exit

:solution
$()Une primitive de la fonction 
!insmath f
$() :	
!insmath x \mapsto $val16
$() est la fonction 
!insmath F
$() :	
!insmath x \mapsto $val18
$().	<p class="wimscenter">	
!insmath F($val12) = $val20
$() et 
!insmath F($val13) = $val21
$().	</p>	On en déduit que	
!insmath integrate(f(x),x=$val12, $val13)
$() vaut 
!insmath F($val13) - F($val12)
$() 
!insmath = $val21 -($val20) = $val22
$()	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,15,16,18,20,21,22
embedcnt=0
