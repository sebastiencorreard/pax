!set title=Primitive de forme donnée 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=Chantal.Causse@noos.fr

ansorder=r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
val10=!rawmath ($val6*x+$val7)/($val8*x^2+$val9)
tmp0=!texmath $val8*x^2+$val9

val11=$(tmp0)
tmp=!translate ;";': to $     $ in $val10,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val12=!rawmath $(tmp1)
tmp0=!texmath $val12

val13=$(tmp0)
replytype1=integer

replyname1=\(a\)
replygood1=$val6
replytype2=integer

replyname2=\(b\)
replygood2=$val7
replytype3=formal
replyname3=\(F(x)\)
replygood3=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Déterminer les nombres 
!insmath a
$() et 
!insmath b
$() pour que la fonction 
!insmath F
$()	définie par 
!insmath F(x) = \frac{a x + b}{$val11}
$() soit une primitive de la fonction	
!insmath f
$() définie par 
!insmath f(x) = $val13
$().		<br>En déduire ensuite l'expression de 
!insmath F(x)
$().	
$()
!exit

:hint
$()
!insmath F
$() est une primitive de 
!insmath f
$() si et seulement si 
!insmath F'(x) = f(x)
$().	<br>	En calculant 
!insmath F'(x)
$() et en l'identifiant à 
!insmath f(x)
$(), on trouve	des équations permettant de trouver 
!insmath a
$() et 
!insmath b
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13
embedcnt=0
