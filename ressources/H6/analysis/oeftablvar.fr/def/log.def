tmp1=!randitem 1,1,1,2,3,4

t_=!rawmath $(tmp0)/$(tmp1)
val11=!exec pari print($t_)

!ifval $val7 =4 
t_=!rawmath  -($val11) 
val11=!exec pari print($t_)
!else
t_=!rawmath  $val11 
val11=!exec pari print($t_)
!endif

!ifval $val10 = $val11 
t_=!rawmath  $val11 +1 
val11=!exec pari print($t_)
!else
t_=!rawmath  $val11
val11=!exec pari print($t_)
!endif
t_=!rawmath (-1)*($val10+$val11)
val12=!exec pari print($t_)
t_=!rawmath ($val10)*($val11)
val13=!exec pari print($t_)
tmp0=!randitem 1,-1

val14=$[rint($(tmp0))]
t_=!rawmath ($val14)
val15=!exec pari print($t_)
t_=!rawmath ($val14)*($val12)
val12=!exec pari print($t_)
t_=!rawmath ($val14)*($val13)
val13=!exec pari print($t_)
tmp0=!randint 1, 3

val16=$[rint($(tmp0)*$val14)]
tmp0=!randint 1-$val16*$val10, 7-$val16*$val10

val17=$[rint($(tmp0))]
tmp0=!randint 1, 5

val18=$[rint($(tmp0)*$val14 )]

!ifval $val7 = 2 
t_=!rawmath (-$val16)/($val10*$val16+$val17)
val18=!exec pari print($t_)
!else
t_=!rawmath $val18
val18=!exec pari print($t_)
!endif
tmp0=!randint -6, 6

val19=$[rint($(tmp0))]

!ifval $val7 >2 
t_=!replace internal \( by ( in expand(($val15)*x^2+2*($val12)*x+$val19+2*($val13)*log(x))
tmp0=!exec maxima $t_

val20=!rawmath  $(tmp0)
!else
t_=!replace internal \( by ( in expand($val18*x+$val19+log($val16*x+$val17))
tmp1=!exec maxima $t_

val20=!rawmath $(tmp1) 
!endif
tmp=!translate ;";': to $     $ in $val20,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val21=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val21

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=!rawmath $(tmp0)
tmp0=!texmath $val20

val22=$(tmp0)
tmp0=!replace internal log by ln in $val22

val22=$(tmp0)
tmp0=!texmath $val21

val23=$(tmp0)

!ifval $val8 = 2 
t_=!rawmath  $val10 
val24=!exec pari print($t_)
!else
t_=!rawmath  max($val10,$val11)
val24=!exec pari print($t_)
!endif

!ifval $val8 = 2 
t_=!rawmath  $val10 
val25=!exec pari print($t_)
!else
t_=!rawmath  min($val10,$val11)
val25=!exec pari print($t_)
!endif

!ifval $val16 < 0
val26= - \infty
!else
tmp=!translate ";': to $     $ in -($val17)/($val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26= $(tmp0)
!endif

!ifval $val16 > 0
val27= + \infty
!else
tmp=!translate ";': to $     $ in -($val17)/($val16)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27= $(tmp0)
!endif
tmp0=!item $val7 of $val26,$val26,0,0

val26=$(tmp0)
tmp0=!item $val7 of $val27,$val27,+ \infty,+ \infty

val27=$(tmp0)
evaltmp=$val20

evaltmp=!mathsubst x=($val25) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val28=!rawmath $(tmp1)
evaltmp=$val20

evaltmp=!mathsubst x=($val24) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val29=!rawmath $(tmp1)
tmp0=!replace internal log by ln in $val28

val28=$(tmp0)
tmp0=!replace internal log by ln in $val29

val29=$(tmp0)
val30=+ , - 
val31=\(\nearrow\),\(\searrow\)

!ifval $val14>0 
tmp=!translate internal $	$ to ; in 1	1,2	1,2,1	2,1	

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val32= $(tmp0)
!else
tmp=!translate internal $	$ to ; in 2	1,2	2,1,2	1,2	

tmp=!row $val7 of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val32=$(tmp1)
!endif
val33=$(val30[$val32])
val11=$(val31[$val32])
val34=Pour  \(x\), entrer sa valeur exacte.	 Pour \(f(x)\), indiquer soit la valeur exacte, soit une valeur approchée en gardant	 au moins 5 chiffres significatifs.	 
