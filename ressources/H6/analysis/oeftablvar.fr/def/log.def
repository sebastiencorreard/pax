:solution
$()La dérivée de 
!insmath f
$() en 
!insmath x
$() est 
!insmath $val23
$(). <br/> Cette dérivée	
!if $val8=1 
$() ne s'annule pas dans 
!insmath \rbrack $val26 ; $val27 \lbrack
$(). 
!endif
$()	
!if $val8=2 
$() s'annule une fois dans 
!insmath \rbrack $val26 ; $val27 \lbrack
$() : pour 
!insmath x = $val25
$(). 
!endif
$()	
!if $val8=3 
$() s'annule deux fois dans 
!insmath \rbrack $val26 ; $val27 \lbrack
$() : pour 
!insmath x = $val25
$() et pour 
!insmath x = $val24
$(). 
!endif
$()	<p>Le tableau de variations de 
!insmath f
$() sur 
!insmath \rbrack $val26 ; $val27 \lbrack
$() est : </p>	<table class="wimscenter wimsborder" style="width:70%;">	<tr>	<td style="width:10%;"> 
!insmath x
$()</td><td style="width:5%;text-align:left">
!insmath $val26
$()</td>	<td style="width:25%;"></td>	
!if $val8>1 
$()<td style="width:5%;">
!insmath $val25
$()</td><td style="width:25%;"></td>	
!if $val8>2 
$()<td style="width:5%;">
!insmath $val24
$()</td><td style="width:25%;"></td> 
!endif
$() 
!endif
$()	<td style="width:5%;text-align:right">
!insmath $val27
$()</td>	</tr><tr>	<td>
!insmath f'(x)
$()</td><td></td><td> $(val33[1]) </td>	
!if $val8>1 
$()<td>0</td><td> $(val33[2]) </td>	
!if $val8>2 
$()<td>0</td><td> $(val33[3])</td> 
!endif
$() 
!endif
$()	<td></td>	</tr><tr>	<td>
!insmath f(x)
$()</td><td></td><td> $(val11[1]) </td>	
!if $val8>1 
$()<td>
!insmath $val28
$()</td><td> $(val11[2]) </td>	
!if $val8>2 
$()<td>
!insmath $val29
$()</td><td> $(val11[3])</td> 
!endif
$() 
!endif
