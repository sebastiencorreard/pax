!set title=Variations avec logarithme 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal, Causse
email=Chantal.Causse@noos.fr
keywords=derivative,function_variation,logarithm
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=9000
oefdescription=Calcul de la dérivée d'une fonction et construction de son tableau de variations
oefobservation=Construction du tableau de variations d'une fonction de la forme c(ax + b)log(ax+b)+dx

ansorder=r,r,r,r,r,r,r
varcnt=29
prevarcnt=26
postvarcnt=2
replycnt=7
choicecnt=0
conditioncnt=0
feedbackcnt=6
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=45x40
tmp0=!randitem -1,1

val7=$[rint($(tmp0))]
tmp0=!randint 1, 4

val8=$[rint($val7*$(tmp0))]
tmp0=!randint -3, 3

val9=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -2, 2

tmp1=!randitem 1,2

t_=!rawmath $(tmp0)/$(tmp1)
val11=!exec pari print($t_)
val12=!rawmath ((e^($val11)-$val9)/$val8)
t_=!replace internal \( by ( in expand($val12)
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val10*(x+$val9/$val8))
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val8*x+$val9)
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(-(1+$val11)*$val10*x)
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)

!ifval $val15=0 
val16=!rawmath  ($val13)*ln($val14)
!else
val16=!rawmath ($val13)*ln($val14)+$val15
!endif
tmp0=!texmath $val16

val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp0=!texmath $val18

val19=$(tmp0)
tmp0=!replace internal log by ln in $val19

val19=$(tmp0)

!ifval $val8 < 0
val20= - \infty
!else
tmp=!translate ";': to $     $ in -($val9)/($val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20= $(tmp0)
!endif

!ifval $val8 > 0
val21= + \infty
!else
tmp=!translate ";': to $     $ in -($val9)/($val8)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21= $(tmp0)
!endif
evaltmp=$val16

evaltmp=!mathsubst x=($val12) in $evaltmp
tmp0=($evaltmp)
t_=!replace internal \( by ( in expand($(tmp0))
tmp1=!exec maxima $t_

val22=$(tmp1)
val23=+ , - 
val24=\(\nearrow\),\(\searrow\)

!ifval $val8*$val10>0
val25=2,1
!else
val25=1,2
!endif
val26=$(val23[$val25])
val27=$(val24[$val25])
val28=Donner soit les valeurs exactes, soit des valeurs approchées	en gardant au moins 5 chiffres significatifs.
replytype1=formal
replyoption1=noanalyzeprint 
replyname1=
replygood1=$val18
replytype2=function
replyname2=
replygood2=!rawmath $val12
replytype3=clickfill
replyname3=
replygood3=$(val26[1]);	\(\nearrow\), + , - ,\(\searrow\) 
replytype4=clickfill
replyname4=
replygood4=$(val26[2]) 
replytype5=clickfill
replyname5=
replygood5=$(val27[1]) 
replytype6=clickfill
replyname6=
replygood6=$(val27[2]) 
replytype7=function
replyoption7=noanalyzeprint 
replyname7=
replygood7=!rawmath $(val22[1])
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p> Calculer la dérivée puis construire le tableau de variations de la fonction 
!insmath f
$()	définie sur 
!insmath  \rbrack $val20 ; $val21 \lbrack 
$() par <div class="wimscenter"">
!insmath f(x) = $val17
$().</div>	<div>
!insmath f'(x) = 
$() 
!read oef/embed.phtml reply1 
$()</div>		<table class="wimscenter wimsborder" style="width:90%;">	<tr>	<td style="width:8%;"> 
!insmath x
$()</td>	<td style="width:12%;text-align:left">
!insmath $val20
$()</td>	<td style="width:25%;"></td><td style="width:12%;"> 
!read oef/embed.phtml reply2,10 
$()</td><td style="width:25%;"></td><td style="width:12%;text-align:right">
!insmath $val21
$()</td>	</tr>	<tr>	<td>
!insmath f'(x)
$()</td><td></td><td>	 
!read oef/embed.phtml reply3,$val6 
$() </td><td>0</td><td>	 
!read oef/embed.phtml reply4,$val6 
$()</td><td ></td>	</tr>	<tr>	<td>
!insmath f(x)
$()</td><td style="text-align:left">	</td><td style="width:25%;">  
!read oef/embed.phtml reply5,$val6 
$() </td>	<td > 
!read oef/embed.phtml reply7,10 
$()</td><td>  
!read oef/embed.phtml reply6,$val6 
$()</td><td> </td>	</tr>	</table>	</p>	<div class="wims_instruction">$val28</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath f'(x) = $val19
$(). Le tableau de variations de 
!insmath f
$() est :	<table class="wimscenter wimsborder">	<tr>	<td style="width:8%;"> 
!insmath x
$()</td><td style="width:12%;text-align:left">
!insmath $val20
$()</td>	<td style="width:25%;"></td>	<td style="width:12%;">
!insmath $val12
$()</td><td style="width:25%;"></td>	<td style="width:12%;text-align:right">
!insmath $val21
$()</td>	</tr><tr>	<td>
!insmath f'(x)
$()</td><td></td><td> $(val26[1]) </td><td>0</td><td> $(val26[2])</td><td></td>	</tr><tr>	<td>
!insmath f(x)
$()</td><td style="text-align:left"></td><td> $(val27[1]) </td><td> 
!insmath $val22
$()</td><td> $(val27[2])</td>	<td style="text-align:right"></td>	</tr>	</table>	
$()
!exit

:latex
$()
$()
!exit

:postdef
val29=vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.
val30=vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.

!exit

