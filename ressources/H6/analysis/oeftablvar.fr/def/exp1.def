!set title=Variations avec exponentielle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal, Causse
email=Chantal.Causse@noos.fr
keywords=derivative, function_variation, exponential
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefdescription=Calcul de la dérivée d'une fonction et construction de son tableau de variations
oefobservation=Construction du tableau de variations d'une fonction de la forme (ax+b)exp(cx)

ansorder=r,r,r,r,r,r,r,r,r
varcnt=28
prevarcnt=25
postvarcnt=2
replycnt=9
choicecnt=0
conditioncnt=0
feedbackcnt=6
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=45x40
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -6, 6

val8=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val9=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath -($val7+$val8*$val9)/($val9*$val7)
val10=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val7 *x + $val8)*exp($val9*x)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=!rawmath $(tmp0)
tmp0=!texmath $val11

val12=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val13)*exp(-$val9*x)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
tmp0=!texmath ($val14)*e^($val9*x)

val15=$(tmp0)
tmp0=!randint -10, $val10 - 1

val16=$[rint($(tmp0))]
tmp0=!randint $val10 + 1, 10

val17=$[rint($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=($val16) in $evaltmp
tmp0=($evaltmp)
val18=$(tmp0)
tmp=!translate ";': to $     $ in $val18

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val19=$(tmp0)
tmp=!translate ";': to $     $ in $val19

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
evaltmp=$val11

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val20=$(tmp0)
tmp=!translate ";': to $     $ in $val20

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=$(tmp0)
val21=+ , - 
val22=\(\nearrow\),\(\searrow\)

!ifval $val7*$val9>0
val23=2,1
!else
val23=1,2
!endif
val24=$(val21[$val23])
val25=$(val22[$val23])
val26=On demande les valeurs <strong>exactes</strong> de \(x\) et de \(f(x)\)	 (pour les fractions utiliser / ; pour l'exponentielle utiliser e^(..) ou exp(..)).
replytype1=formal
replyname1=
replygood1=$val13
replytype2=numexp
replyname2=
replygood2=$val10
replytype3=clickfill
replyname3=
replygood3=$(val24[1]);\(\nearrow\), + , - ,\(\searrow\) 
replytype4=clickfill
replyname4=
replygood4=$(val24[2]) 
replytype5=clickfill
replyname5=
replygood5=$(val25[1]) 
replytype6=clickfill
replyname6=
replygood6=$(val25[2]) 
replytype7=function
replyname7=
replygood7=!rawmath $(val19[1])
replytype8=formal
replyname8=
replygood8=$val18
replytype9=formal
replyname9=
replygood9=$val20
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer la dérivée puis construire le tableau de variations de la fonction	
!insmath f
$() définie sur 
!insmath \ \RR
$()	par <div class="center">
!insmath f(x) = $val12
$().</div>	<div>
!insmath f'(x) = 
$() 
!read oef/embed.phtml reply1 
$()</div>	Puis construire son tableau de variations sur l'intervalle 
!insmath \lbrack $val16, $val17\rbrack
$().		<table class="wimscenter wimsborder" style="width:90%;">	<tr>	<td style="width:8%;"> 
!insmath x
$()</td><td style="width:12%;text-align:left">
!insmath $val16
$()</td>	<td style="width:25%;"></td><td style="width:12%;"> 
!read oef/embed.phtml reply2,5 
$()</td><td style="width:25%;"></td><td style="width:12%;text-align:right">
!insmath $val17
$()</td>	</tr>	<tr>	<td>
!insmath f'(x)
$()</td><td></td><td>  
!read oef/embed.phtml reply3,$val6 
$() </td><td>0</td>	<td>  
!read oef/embed.phtml reply4,$val6 
$()</td><td ></td>	</tr>	<tr>	<td>
!insmath f(x)
$()</td><td style="text-align:left">  
!read oef/embed.phtml reply8,12 
$() </td>	<td style="width:25%;">  
!read oef/embed.phtml reply5,$val6 
$() </td><td> 
!read oef/embed.phtml reply7,12 
$()</td>	<td>  
!read oef/embed.phtml reply6,$val6 
$()</td><td>  
!read oef/embed.phtml reply9,12 
$() </td>	</tr>	</table>	<div class="wims_instruction">$val26</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La dérivée 
!insmath f'(x) = $val15
$() a le même signe que 
!insmath $val14 
$(). On en déduit le tableau de variations de 
!insmath f
$() :	<table class="wimscenter wimsborder" style="width:90%;">	<tr>	<td style="width:8%;"> 
!insmath x
$()</td><td style="width:12%;text-align:left">
!insmath $val16
$()</td><td style="width:25%;"></td><td style="width:12%;">
!insmath $val10
$()</td><td style="width:25%;"></td><td style="width:12%;text-align:right">
!insmath $val17
$()</td>	</tr>	<tr>	<td>
!insmath f'(x)
$()</td><td></td><td>$(val24[1]) </td><td>0</td><td> $(val24[2])</td><td></td>	</tr>	<tr>	<td>
!insmath f(x)
$()</td><td style="text-align:left"> 
!insmath $val18
$() </td><td> $(val25[1]) </td><td>
!insmath  $(val19[1])
$()</td><td> $(val25[2])</td><td style="text-align:right"> 
!insmath $val20 
$()</td>	</tr>	</table>
$()
!exit

:latex
$()
$()
!exit

:postdef
val27=vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.
val28=vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.

!exit

:feedback
