 <div class='oef_feedbacks'>Ce sont les VARIATIONS de la fonction 
!insmath f(x)
$() qu'on cherche, et pas son signe.
$()</div>
!endif
!ifval $m_reply3 isitemof - and $m_reply5 isitemof \(\nearrow\)
 <div class='oef_feedbacks'>Incohérence dans la première colonne du tableau : $val27
$()</div>
!endif
!ifval $m_reply3 isitemof + and $m_reply5 isitemof \(\searrow\)
 <div class='oef_feedbacks'>Incohérence dans la première colonne du tableau : $val28
$()</div>
!endif
!ifval $m_reply4 isitemof - and $m_reply6 isitemof \(\nearrow\)
 <div class='oef_feedbacks'>Incohérence dans la deuxième colonne du tableau : $val27
$()</div>
!endif
!ifval $m_reply4 isitemof + and $m_reply6 isitemof \(\searrow\)
 <div class='oef_feedbacks'>Incohérence dans la deuxième colonne du tableau : $val28
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,12,14,15,16,17,18,19,20,21,22,24,25,26
