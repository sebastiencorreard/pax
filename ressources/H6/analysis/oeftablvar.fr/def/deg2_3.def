:solution
$()La dérivée de 
!insmath f
$() est <div class="center">
!insmath $val23
$().</div>	Cette dérivée	
!if $val8=1 
$() ne s'annule pas dans [$val26 ; $val27]. 
!endif
$()	
!if $val8=2 
$() s'annule une fois dans [$val26 ; $val27] : pour 
!insmath x = $val25
$(). 
!endif
$()	
!if $val8=3 
$() s'annule deux fois dans [$val26 ; $val27] : pour 
!insmath x = $val25
$() et pour 
!insmath x = $val24
$(). 
!endif
$()	<p>Le tableau de variations de 
!insmath f
$() sur [$val26 ; $val27] est : </p>	<table class="wimscenter wimsborder" style="width:70%;">	<tr>	<td style="width:10%;"> 
!insmath x
$()</td><td style="width:5%;text-align:left">
!insmath $val26
$()</td><td style="width:25%;"></td>	
!if $val8>1 
$()<td style="width:5%;">
!insmath $val25
$()</td><td style="width:25%;"></td>	
!if $val8>2 
$()<td style="width:5%;">
!insmath $val24
$()</td><td style="width:25%;"></td> 
!endif
$() 
!endif
$()	<td style="width:5%;text-align:right">
!insmath $val27
$()</td>	</tr>	<tr>	<td style="width:10%;">
!insmath f'(x)
$()</td><td style="width:5%;"></td><td style="width:25%;"> $(val35[1]) </td>	
!if $val8>1 
$()<td style="width:5%;">0</td><td style="width:25%;"> $(val35[2]) </td>	
!if $val8>2 
$()<td style="width:5%;">0</td><td style="width:25%;"> $(val35[3])</td> 
!endif
$() 
!endif
$()	<td style="width:5%;"></td>	</tr>	<tr>	<td style="width:10%;">
!insmath f(x)
$()</td><td style="width:5%;text-align:left"> 
!insmath $val28 
$()</td><td style="width:25%;"> $(val12[1]) </td>	
!if $val8>1 
$()<td style="width:5%;">
!insmath $val29
$()</td><td style="width:25%;"> $(val12[2]) </td>	
!if $val8>2 
$()<td style="width:5%;">
!insmath $val30
$()</td><td style="width:25%;"> $(val12[3])</td> 
!endif
$() 
!endif
$()	<td style="width:5%;text-align:right"> 
!insmath $val31
$() </td>	</tr>	</table>	
$()
