tmp1=!randint 1, 6

tmp2=!randitem 1,1,1,2,3,4

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val12=!exec pari print($t_)

!ifval $val11 = $val12 
t_=!rawmath  $val12 + 1 
val12=!exec pari print($t_)
!else
t_=!rawmath  $val12
val12=!exec pari print($t_)
!endif
tmp0=!item $val7 of 1,1,1,0

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!item $val7 of $(tmp0),-2*$val11,(-1)*($val11+$val12),1

t_=!rawmath $(tmp1)
val14=!exec pari print($t_)
tmp0=!randint ($val14)^2/4+1, ($val14)^2/4+6

tmp1=!item $val7 of $(tmp0),($val11)^2,($val11)*($val12),(-$val11)

t_=!rawmath $(tmp1)
val15=!exec pari print($t_)
t_=!rawmath ($val10)*($val13)
val16=!exec pari print($t_)
t_=!rawmath ($val10)*($val14)
val17=!exec pari print($t_)
t_=!rawmath ($val10)*($val15)
val18=!exec pari print($t_)
tmp0=!randint -6, 6

val19=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(($val16)*x^2+($val17)*x+$val18)
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand(($val16)*x^3/3+($val17)*x^2/2+($val18)*x+$val19)
tmp0=!exec maxima $t_

val21=!rawmath $(tmp0)
tmp0=!texmath $val21

val22=$(tmp0)
tmp0=!texmath $val20

val23=$(tmp0)

!ifval $val8 = 2 
t_=!rawmath  $val11 
val24=!exec pari print($t_)
!else
t_=!rawmath  max($val11,$val12)
val24=!exec pari print($t_)
!endif

!ifval $val8 = 2 
t_=!rawmath  $val11 
val25=!exec pari print($t_)
!else
t_=!rawmath  min($val11,$val12)
val25=!exec pari print($t_)
!endif
tmp0=!randint -10, $val25 - 1

val26=$[rint($(tmp0))]
tmp0=!randint $val24 + 1, 10

val27=$[rint($(tmp0))]
evaltmp=$val21

evaltmp=!mathsubst x=($val26) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val28=!exec pari print($t_)
evaltmp=$val21

evaltmp=!mathsubst x=($val25) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val29=!exec pari print($t_)
evaltmp=$val21

evaltmp=!mathsubst x=($val24) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val30=!exec pari print($t_)
evaltmp=$val21

evaltmp=!mathsubst x=($val27) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val31=!exec pari print($t_)
val32=+ , - 
val33=\(\nearrow\),\(\searrow\)

!ifval $val10>0 
tmp=!translate internal $	$ to ; in 1	1,1	1,2,1	2,1	

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val34= $(tmp0)
!else
tmp=!translate internal $	$ to ; in 2	2,2	2,1,2	1,2	

tmp=!row $val7 of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val34=$(tmp1)
!endif
val35=$(val32[$val34])
val12=$(val33[$val34])
