!set title=Variations degré 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal, Causse
email=Chantal.Causse@noos.fr
keywords=derivative, function_variation, polynomials
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100
oefdescription=Calcul de la dérivée d'une fonction et construction de son tableau de variations
oefobservation=construction du tableau de variations pour un polynome de degré 2

ansorder=r,r,r,r,r,r,r,r,r
varcnt=22
prevarcnt=19
postvarcnt=2
replycnt=9
choicecnt=0
conditioncnt=0
feedbackcnt=6
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=45x40
tmp0=!randitem -1,1

tmp1=!randint 1, 4

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -6, 6

val8=$[rint($(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
t_=!rawmath -$val8/(2*$val7)
val10=!exec pari print($t_)
t_=!replace internal \( by ( in $val7 *x^2 + $val8*x + $val9
tmp0=!exec pari $t_

val11=!rawmath $(tmp0)
tmp0=!texmath $val11

val12=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
tmp0=!randint -10, $val10 - 1

val14=$[rint($(tmp0))]
tmp0=!randint $val10 + 1, 10

val15=$[rint($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val16=$[rint($(tmp0))]
evaltmp=$val11

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
evaltmp=$val11

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
val18=$[rint($(tmp0))]
val19=+ , - 
val20=\(\nearrow\),\(\searrow\)

!ifval $val7>0
val21=2,1
!else
val21=1,2
!endif
val22=$(val19[$val21])
val23=$(val20[$val21])
val24=On demande les valeurs <strong>exactes</strong> de \(x) et de \(f(x)) (pour les fractions, utiliser /).
replytype1=formal
replyname1=
replygood1=$val13
replytype2=numexp
replyname2=
replygood2=$val10
replytype3=clickfill
replyoption3=shuffle 
replyname3=
replygood3=$(val22[1]) 
replytype4=clickfill
replyoption4=shuffle 
replyname4=
replygood4=$(val22[2]) 
replytype5=clickfill
replyoption5=shuffle 
replyname5=
replygood5=$(val23[1]) 
replytype6=clickfill
replyoption6=shuffle 
replyname6=
replygood6=$(val23[2]) 
replytype7=numexp
replyname7=
replygood7=$(val17[1])
replytype8=numexp
replyname8=
replygood8=$val16
replytype9=numexp
replyname9=
replygood9=$val18
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer la dérivée puis construire le tableau de variations de la fonction 
!insmath f
$() définie sur 
!insmath \lbrack$val14 ; $val15\rbrack
$() par	<div class="center">
!insmath f(x) = $val12
$().</div>	<div>
!insmath f'(x) = 
$()  
!read oef/embed.phtml reply1 
$()</div>	<table class="wimscenter wimsborder" style="width:60%;">	<tr>	<td style="width:10%;"> 
!insmath x
$()</td><td style="width:5%;text-align:left">
!insmath $val14
$()</td><td style="width:25%;"></td><td style="width:5%;"> 
!read oef/embed.phtml reply2,5 
$()</td>	<td style="width:25%;"></td><td style="width:5%;text-align:right">
!insmath $val15
$()</td>	</tr>	<tr>	<td style="width:10%;">
!insmath f'(x)
$()</td><td style="width:5%;"></td><td style="width:25%;">  
!read oef/embed.phtml reply3,$val6 
$() </td><td style="width:5%;">0</td><td style="width:25%;">  
!read oef/embed.phtml reply4,$val6 
$()</td><td style="width:5%;"></td>	</tr>	<tr>	<td style="width:10%;">
!insmath f(x)
$()</td><td style="width:5%;text-align:left">  
!read oef/embed.phtml reply8,5 
$() </td><td style="width:25%;">  
!read oef/embed.phtml reply5,$val6 
$() </td><td style="width:5%;">  
!read oef/embed.phtml reply7,5 
$()</td><td style="width:25%;">	 
!read oef/embed.phtml reply6,$val6 
$()</td><td style="width:5%;text-align:right">  
!read oef/embed.phtml reply9,5 
$() </td>	</tr>	</table>	<div class="wims_instruction"> $val24</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath f'(x) = $val13
$() et le tableau de variations de 
!insmath f
$() est	<table class="wimscenter wimsborder" style="width:60%;">	<tr>	<td style="width:10%;"> 
!insmath x
$()</td><td style="width:5%;text-align:left">
!insmath $val14
$()</td><td style="width:25%;"></td><td style="width:5%;">
!insmath $val10
$()</td>	<td style="width:25%;"></td><td style="width:5%;text-align:right">
!insmath $val15
$()</td>	</tr>	<tr>	<td style="width:10%;">
!insmath f'(x)
$()</td><td style="width:5%;"></td><td style="width:25%;"> $(val22[1]) </td><td style="width:5%;">0</td><td style="width:25%;"> $(val22[2])</td><td style="width:5%;"></td>	</tr>	<tr>	<td style="width:10%;">
!insmath f(x)
$()</td><td style="width:5%;text-align:left"> 
!insmath $val16 
$()</td><td style="width:25%;"> $(val23[1]) </td><td style="width:5%;">
!insmath  $(val17[1])
$()</td><td style="width:25%;"> $(val23[2])</td><td style="width:5%;text-align:right"> 
!insmath $val18 
$()</td>	</tr>	</table> 
$()
!exit

:latex
$()
$()
!exit

:postdef
val25=vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.
val26=vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.

!exit

:feedback
!ifval $m_reply3 isitemof $val20 or $m_reply4 isitemof $val20
 <div class='oef_feedbacks'>Pour obtenir les variations de 
!insmath f
$(), on indique le SIGNE de la dérivée 
!insmath f'(x)
$().
$()</div>
!endif
!ifval $m_reply5 isitemof $val19 or $m_reply6 isitemof $val19
 <div class='oef_feedbacks'>Ce sont les VARIATIONS de la fonction 
!insmath f(x)
$() qu'on cherche, et pas son signe.
$()</div>
!endif
!ifval $m_reply3 isitemof - and $m_reply5 isitemof \(\nearrow\)
 <div class='oef_feedbacks'>Incohérence dans la première colonne du tableau : $val25
$()</div>
!endif
!ifval $m_reply3 isitemof + and $m_reply5 isitemof \(\searrow\)
 <div class='oef_feedbacks'>Incohérence dans la première colonne du tableau : $val26
$()</div>
!endif
!ifval $m_reply4 isitemof - and $m_reply6 isitemof \(\nearrow\)
 <div class='oef_feedbacks'>Incohérence dans la deuxième colonne du tableau : $val25
$()</div>
!endif
!ifval $m_reply4 isitemof + and $m_reply6 isitemof \(\searrow\)
 <div class='oef_feedbacks'>Incohérence dans la deuxième colonne du tableau : $val26
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,12,13,14,15,16,17,18,19,20,22,23,24
embedcnt=9
