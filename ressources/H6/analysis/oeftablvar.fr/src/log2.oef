\title{Variations avec logarithme 2}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\keywords{derivative,function_variation,logarithm}
\precision{9000}
\description{Calcul de la dérivée d'une fonction et construction de son tableau de variations}
\observation{Construction du tableau de variations d'une fonction de la forme c(ax + b)log(ax+b)+dx}
\text{taille=45x40}

\integer{A = random(-1,1)}
\integer{a = \A*random(1..4)}
\integer{b = random(-3..3)}
\integer{c= random(-1,1)*random(1..4)}
\rational{u=randint(-2..2)/randint(1,2)}

\function{zero=((e^(\u)-\b)/\a)}
\function{zero=maxima(expand(\zero))}

\function{f1= maxima(expand(\c*(x+\b/\a)))}
\function{f2= maxima(expand(\a*x+\b))}
\function{f3= maxima(expand(-(1+\u)*\c*x))}
\function{f= \f3=0 ? (\f1)*ln(\f2):(\f1)*ln(\f2)+\f3}
\text{ft=texmath(\f)}
*****text{ft=wims(replace internal log by ln in \ft)}
\function{d=diff(\f,x)}
\function{d=simplify(\d)}
\text{dt=texmath(\d)}
\text{dt=wims(replace internal log by ln in \dt)}

\text{inf = \a < 0? - \infty: simplify(-(\b)/(\a))}
\text{sup = \a > 0? + \infty: simplify(-(\b)/(\a))}

\text{fz=maxima(expand(evalue(\f,x=\zero)))}

\text{signes= + , - }
\text{variations = \(\nearrow\),\(\searrow\)}


***par colonnes : 1 pour croissant, 2 pour décroissant

\text{cc=\a*\c>0?2,1:1,2}
\text{s=\signes[\cc]}
\text{v=\variations[\cc]}
\text{instruction=Donner soit les valeurs exactes, soit des valeurs approchées
en gardant au moins 5 chiffres significatifs.}

\statement{
<p> Calculer la dérivée puis construire le tableau de variations de la fonction \(f\)
définie sur \( \rbrack \inf ; \sup \lbrack \) par <div class="wimscenter"">\(f(x) = \ft\).</div>
<div>\(f'(x) = \)\embed{reply1}</div>

<table class="wimscenter wimsborder" style="width:90%;">
<tr>
<td style="width:8%;"> \(x\)</td>
<td style="width:12%;text-align:left">\(\inf\)</td>
<td style="width:25%;"></td><td style="width:12%;">\embed{reply2,10}</td><td style="width:25%;"></td><td style="width:12%;text-align:right">\(\sup\)</td>
</tr>
<tr>
<td>\(f'(x)\)</td><td></td><td>
\embed{reply3,\taille} </td><td>0</td><td>
\embed{reply4,\taille}</td><td ></td>
</tr>
<tr>
<td>\(f(x)\)</td><td style="text-align:left">
</td><td style="width:25%;"> \embed{reply5,\taille} </td>
<td >\embed{reply7,10}</td><td> \embed{reply6,\taille}</td><td> </td>
</tr>
</table>
</p>
<div class="wims_instruction">\instruction</div>
}

\answer{}{\d}{type=formal}{option=noanalyzeprint}
\answer{}{\zero}{type=function}
\answer{}{\s[1];
\(\nearrow\), + , - ,\(\searrow\) }{type=clickfill}
\answer{}{\s[2] }{type=clickfill}
\answer{}{\v[1] }{type=clickfill}
\answer{}{\v[2] }{type=clickfill}
\answer{}{\fz[1]}{type=function}{option=noanalyzeprint}


\text{err1 = vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.}
\text{err2 = vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.}

\feedback{\reply3 isitemof \variations or \reply4 isitemof \variations }{Pour obtenir les variations de \(f\), on indique le SIGNE de la dérivée \(f'(x)\).}
\feedback{\reply5 isitemof \signes or \reply6 isitemof \signes}{Ce sont les VARIATIONS de la fonction \(f(x)\) qu'on cherche, et pas son signe.}
\feedback{\reply3 isitemof - and \reply5 isitemof \(\nearrow\)}{Incohérence dans la première colonne du tableau : \err1}
\feedback{\reply3 isitemof + and \reply5 isitemof \(\searrow\)}{Incohérence dans la première colonne du tableau : \err2}
\feedback{\reply4 isitemof - and \reply6 isitemof \(\nearrow\)}{Incohérence dans la deuxième colonne du tableau : \err1}
\feedback{\reply4 isitemof + and \reply6 isitemof \(\searrow\)}{Incohérence dans la deuxième colonne du tableau : \err2}

\solution{\(f'(x) = \dt\). Le tableau de variations de \(f\) est :
<table class="wimscenter wimsborder">
<tr>
<td style="width:8%;"> \(x\)</td><td style="width:12%;text-align:left">\(\inf\)</td>
<td style="width:25%;"></td>
<td style="width:12%;">\(\zero\)</td><td style="width:25%;"></td>
<td style="width:12%;text-align:right">\(\sup\)</td>
</tr><tr>
<td>\(f'(x)\)</td><td></td><td> \s[1] </td><td>0</td><td> \s[2]</td><td></td>
</tr><tr>
<td>\(f(x)\)</td><td style="text-align:left"></td><td> \v[1] </td><td> \(\fz\)</td><td> \v[2]</td>
<td style="text-align:right"></td>
</tr>
</table>
}
