\title{Variations degré 2}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\precision{100}
\keywords{derivative, function_variation, polynomials}
\description{Calcul de la dérivée d'une fonction et construction de son tableau de variations}
\observation{construction du tableau de variations pour un polynome de degré 2}
\text{taille=45x40}
\integer{a = random(-1,1)*random(1..4)}
\integer{b = random(-6..6)}
\integer{c = random(-10..10)}


\rational{zero=-\b/(2*\a)}
\function{f=pari(\a *x^2 + \b*x + \c)}
\text{ft=texmath(\f)}
\function{d=diff(\f,x)}

\integer{inf=random(-10..\zero - 1)}
\integer{sup=random(\zero + 1..10)}

\integer{fi=evalue(\f,x=\inf)}
\rational{fz=evalue(\f,x=\zero)}
\integer{fs=evalue(\f,x=\sup)}


\text{signes= + , - }
\text{variations = \(\nearrow\),\(\searrow\)}

***par colonnes : 1 pour croissant, 2 pour décroisant

\text{cc=\a>0?2,1:1,2}
\text{s=\signes[\cc]}
\text{v=\variations[\cc]}
\text{instruction=On demande les valeurs <strong>exactes</strong> de \(x) et de \(f(x)) (pour les fractions, utiliser /).}

\statement{
Calculer la dérivée puis construire le tableau de variations de la fonction \(f\) définie sur \(\lbrack\inf ; \sup\rbrack\) par
<div class="center">\(f(x) = \ft\).</div>
<div>\(f'(x) = \) \embed{reply1}</div>
<table class="wimscenter wimsborder" style="width:60%;">
<tr>
<td style="width:10%;"> \(x)</td><td style="width:5%;text-align:left">\(\inf)</td><td style="width:25%;"></td><td style="width:5%;">\embed{reply2,5}</td>
<td style="width:25%;"></td><td style="width:5%;text-align:right">\(\sup)</td>
</tr>
<tr>
<td style="width:10%;">\(f'(x))</td><td style="width:5%;"></td><td style="width:25%;"> \embed{reply3,\taille} </td><td style="width:5%;">0</td><td style="width:25%;"> \embed{reply4,\taille}</td><td style="width:5%;"></td>
</tr>
<tr>
<td style="width:10%;">\(f(x))</td><td style="width:5%;text-align:left"> \embed{reply8,5} </td><td style="width:25%;"> \embed{reply5,\taille} </td><td style="width:5%;"> \embed{reply7,5}</td><td style="width:25%;">
\embed{reply6,\taille}</td><td style="width:5%;text-align:right"> \embed{reply9,5} </td>
</tr>
</table>
<div class="wims_instruction"> \instruction</div>
}

\answer{}{\d}{type=formal}
\answer{}{\zero}{type=numexp}
\answer{}{\s[1] }{type=clickfill}{option = shuffle}
\answer{}{\s[2] }{type=clickfill}{option = shuffle}
\answer{}{\v[1] }{type=clickfill}{option = shuffle}
\answer{}{\v[2] }{type=clickfill}{option = shuffle}
\answer{}{\fz[1]}{type=numexp}
\answer{}{\fi}{type=numexp}
\answer{}{\fs}{type=numexp}


\text{err1 = vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.}
\text{err2 = vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.}

\feedback{\reply3 isitemof \variations or \reply4 isitemof \variations}{Pour obtenir les variations de \(f\), on indique le SIGNE de la dérivée \(f'(x)\).}
\feedback{\reply5 isitemof \signes or \reply6 isitemof \signes}{Ce sont les VARIATIONS de la fonction \(f(x)\) qu'on cherche, et pas son signe.}
\feedback{\reply3 isitemof - and \reply5 isitemof \(\nearrow\)}{Incohérence dans la première colonne du tableau : \err1}
\feedback{\reply3 isitemof + and \reply5 isitemof \(\searrow\)}{Incohérence dans la première colonne du tableau : \err2}
\feedback{\reply4 isitemof - and \reply6 isitemof \(\nearrow\)}{Incohérence dans la deuxième colonne du tableau : \err1}
\feedback{\reply4 isitemof + and \reply6 isitemof \(\searrow\)}{Incohérence dans la deuxième colonne du tableau : \err2}

\solution{\(f'(x) = \d) et le tableau de variations de \(f\) est
<table class="wimscenter wimsborder" style="width:60%;">
<tr>
<td style="width:10%;"> \(x)</td><td style="width:5%;text-align:left">\(\inf)</td><td style="width:25%;"></td><td style="width:5%;">\(\zero\)</td>
<td style="width:25%;"></td><td style="width:5%;text-align:right">\(\sup)</td>
</tr>
<tr>
<td style="width:10%;">\(f'(x))</td><td style="width:5%;"></td><td style="width:25%;"> \s[1] </td><td style="width:5%;">0</td><td style="width:25%;"> \s[2]</td><td style="width:5%;"></td>
</tr>
<tr>
<td style="width:10%;">\(f(x))</td><td style="width:5%;text-align:left"> \(\fi \)</td><td style="width:25%;"> \v[1] </td><td style="width:5%;">\( \fz[1]\)</td><td style="width:25%;"> \v[2]</td><td style="width:5%;text-align:right"> \(\fs \)</td>
</tr>
</table> }
