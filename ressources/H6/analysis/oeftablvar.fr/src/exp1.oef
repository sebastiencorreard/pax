\title{Variations avec exponentielle 1}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{derivative, function_variation, exponential}
\description{Calcul de la dérivée d'une fonction et construction de son tableau de variations}
\observation{Construction du tableau de variations d'une fonction de la forme (ax+b)exp(cx)}
\text{taille=45x40}

\integer{a = random(-1,1)*random(1..4)}
\integer{b = random(-6..6)}
\integer{c= random(-1,1)*random(1..4)}
\rational{zero=-(\a+\b*\c)/(\c*\a)}
\function{f=simplify((\a *x + \b)*exp(\c*x))}
\text{ft=texmath(\f)}
\function{d=diff(\f,x)}
\function{d=simplify(\d)}
\function{sgd=simplify((\d)*exp(-\c*x))}
\text{dt=texmath((\sgd)*e^(\c*x))}

\integer{inf=random(-10..\zero - 1)}
\integer{sup=random(\zero + 1..10)}

\text{fi=evalue(\f,x=\inf)}
\text{fi=simplify(\fi)}
\text{fz=evalue(\f,x=\zero)}
\text{fz=simplify(\fz)}
\text{fs=evalue(\f,x=\sup)}
\text{fs=simplify(\fs)}


\text{signes= + , - }
\text{variations = \(\nearrow\),\(\searrow\)}


***par colonnes : 1 pour croissant, 2 pour décroissant

\text{cc=\a*\c>0?2,1:1,2}
\text{s=\signes[\cc]}
\text{v=\variations[\cc]}
\text{instruction=On demande les valeurs <strong>exactes</strong> de \(x\) et de \(f(x)\)
 (pour les fractions utiliser / ; pour l'exponentielle utiliser e^(..) ou exp(..)).}

\statement{
Calculer la dérivée puis construire le tableau de variations de la fonction
\(f\) définie sur \(\ \RR\)
par <div class="center">\(f(x) = \ft\).</div>
<div>\(f'(x) = \)\embed{reply1}</div>
Puis construire son tableau de variations sur l'intervalle \(\lbrack \inf, \sup\rbrack\).

<table class="wimscenter wimsborder" style="width:90%;">
<tr>
<td style="width:8%;"> \(x\)</td><td style="width:12%;text-align:left">\(\inf\)</td>
<td style="width:25%;"></td><td style="width:12%;">\embed{reply2,5}</td><td style="width:25%;"></td><td style="width:12%;text-align:right">\(\sup\)</td>
</tr>
<tr>
<td>\(f'(x)\)</td><td></td><td> \embed{reply3,\taille} </td><td>0</td>
<td> \embed{reply4,\taille}</td><td ></td>
</tr>
<tr>
<td>\(f(x)\)</td><td style="text-align:left"> \embed{reply8,12} </td>
<td style="width:25%;"> \embed{reply5,\taille} </td><td>\embed{reply7,12}</td>
<td> \embed{reply6,\taille}</td><td> \embed{reply9,12} </td>
</tr>
</table>
<div class="wims_instruction">\instruction</div>
}

\answer{}{\d}{type=formal}
\answer{}{\zero}{type=numexp}
\answer{}{\s[1];\(\nearrow\), + , - ,\(\searrow\) }{type=clickfill}
\answer{}{\s[2] }{type=clickfill}
\answer{}{\v[1] }{type=clickfill}
\answer{}{\v[2] }{type=clickfill}
\answer{}{\fz[1]}{type=function}
\answer{}{\fi}{type=formal}
\answer{}{\fs}{type=formal}


\text{err1 = vous avez trouvé que la dérivée \(f'(x)\) est négative ; vous devriez donc dire que la fonction \(f\) est décroissante sur cet intervalle.}
\text{err2 = vous avez trouvé que la dérivée \(f'(x)\) est positive ; vous devriez donc dire que la fonction \(f\) est croissante sur cet intervalle.}

\feedback{\reply3 isitemof \variations or \reply4 isitemof \variations }{Pour obtenir les variations de \(f\), on indique le SIGNE de la dérivée \(f'(x)\).}
\feedback{\reply5 isitemof \signes or \reply6 isitemof \signes}{Ce sont les VARIATIONS de la fonction \(f(x)\) qu'on cherche, et pas son signe.}
\feedback{\reply3 isitemof - and \reply5 isitemof \(\nearrow\)}{Incohérence dans la première colonne du tableau : \err1}
\feedback{\reply3 isitemof + and \reply5 isitemof \(\searrow\)}{Incohérence dans la première colonne du tableau : \err2}
\feedback{\reply4 isitemof - and \reply6 isitemof \(\nearrow\)}{Incohérence dans la deuxième colonne du tableau : \err1}
\feedback{\reply4 isitemof + and \reply6 isitemof \(\searrow\)}{Incohérence dans la deuxième colonne du tableau : \err2}

\solution{La dérivée \(f'(x) = \dt\) a le même signe que \(\sgd \). On en déduit le tableau de variations de \(f\) :
<table class="wimscenter wimsborder" style="width:90%;">
<tr>
<td style="width:8%;"> \(x)</td><td style="width:12%;text-align:left">\(\inf)</td><td style="width:25%;"></td><td style="width:12%;">\(\zero\)</td><td style="width:25%;"></td><td style="width:12%;text-align:right">\(\sup\)</td>
</tr>
<tr>
<td>\(f'(x))</td><td></td><td>\s[1] </td><td>0</td><td> \s[2]</td><td></td>
</tr>
<tr>
<td>\(f(x))</td><td style="text-align:left"> \(\fi\) </td><td> \v[1] </td><td>\( \fz[1]\)</td><td> \v[2]</td><td style="text-align:right"> \(\fs \)</td>
</tr>
</table>}
