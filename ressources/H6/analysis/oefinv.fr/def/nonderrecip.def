!set title=Réciproque non dérivable
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang,XIAO
email=xiao@unice.fr
language=fr
computeanswer=yes
precision=10000
leftrange=-0.900000
rightrange=0.900000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim La fonction, définie par	  est bijective, mais il y a un point	  tel que la fonction réciproque	  n'est pas dérivable en	  Trouvez
val7=!translate internal $	\
$ to ;; in $tmp
val8=x_0
tmp0=!randint 5, 20

tmp1=!randitem -1,1

val9=$[$(tmp0)*$(tmp1)/10]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val10=$[$(tmp0)*$(tmp1)]
val11=$[-3*($val10)*($val9)]
val12=$[3*($val10)*($val9)^2]
tmp0=!randint 5, 100

tmp1=!randitem -1,1

val13=$[$(tmp0)*$(tmp1)/10]
val14=!rawmath $val10*x^3+$val11*x^2+$val12*x+$val13
evaltmp=$val14

evaltmp=!mathsubst x=($val9) in $evaltmp
tmp0=($evaltmp)
val15=$[$(tmp0)]
replyname1=\($val8)
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1;1]) 
!insmath f: \RR \to \RR
$() $(val7[1;2])	  <div class="wimscenter">
!insmath f(x) = $val14
$()</div>	  $(val7[2;]) 
!insmath $val8 \in \RR
$() $(val7[3;])	   
!insmath f^{-1}
$() $(val7[4;]) 
!insmath $val8
$().	  $(val7[5;]) 
!insmath $val8
$().	
$()
!exit

