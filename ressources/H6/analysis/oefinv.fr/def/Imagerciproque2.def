$()
$()
!exit

:feedback
!if $m_choice1= $val13 or $m_choice1= $val12
 <div class='oef_feedbacks'>	  
!insmath f^{ -1} \circ f (I)
$() contient toujours 
!insmath I
$(). Votre réponse est donc impossible. 
$()</div>
!endif
!if $m_choice1!= $val29 and $val29=$val10
 <div class='oef_feedbacks'>	  Faites un dessin : vous verrez que l'intervalle 
!insmath I
$() est symétrique par rapport	  à la 
!insmath x
$()-coordonnée de l'extremum de la parabole qui est $val20.	
$()</div>
!endif

!exit

:test

!exit

