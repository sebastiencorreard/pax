rightrange=2.000000
computeanswer=yes
precision=100000

ansorder=c
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Soit la fonction \(f) définie sur \(\displaystyle{\RR}\) par	  Soit, Que peut-on dire de
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim est-il égal à l'intervalle \(I\)	  est-il strictement contenu dans \(I\)	  contient-il strictement \(I\)	  aucune de ces possibilités
val8=!translate internal $	\
$ to ;; in $tmp
val9=est toujours contenu dans \(I\). Votre réponse est donc impossible.
val10=est égal à \(I\)
val11=contient strictement \(I\)
val12=est strictement contenu dans \(I\)
val13=aucune de ces possibilités
val14=l'ensemble vide
val15=un intervalle non vide
val16=la réunion de deux intervalles disjoints et maximaux
tmp=!trim Soit la fonction \(f) définie sur \(\displaystyle{\RR}\) par	  Soit, Que peut-on dire de
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim est-il égal à l'intervalle \(I)	  est-il strictement contenu dans \(I)	  contient-il strictement \(I)	  aucune de ces possibilités
val8=!translate internal $	\
$ to ;; in $tmp
val9=est toujours contenu dans \(I). Votre réponse est donc impossible.
val10=est égal à \(I)
val11=contient strictement \(I)
val12=est strictement contenu dans \(I)
val13=aucune de ces possibilités
val14=l'ensemble vide
val15=un intervalle non vide
val16=la réunion de deux intervalles disjoints et maximaux
tmp0=!randitem 1,-1

val17=$[rint($(tmp0))]
tmp0=!randint 1, 15

tmp1=!randitem -1,1

val18=$[rint($(tmp0)*$(tmp1))]
val19=$[rint($val18*2)]
val20=$[-($val18)/($val17)]
tmp0=!randint 1, 50

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
val22=!rawmath $val17*x^2 + $val19*x + $val21
evaltmp=$val22

evaltmp=!mathsubst x=($val20) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
tmp0=!randitem 1,2,3,4,4

val24=$[rint($(tmp0))]
tmp0=!randint $val20-20, $val20-9

tmp1=!randint $val20-6, $val20-2

tmp2=!randint $val20+2, $val20+8

tmp3=!randint $val20-6, $val20-2

tmp4=!item $val24 of $(tmp0),	   $(tmp1),	   $(tmp2),	   $(tmp3)

val25=$[rint($(tmp4))]
tmp0=!randint $val20-8, $val20-2

tmp1=!randint $val20+7, $val20+16

tmp2=!randint $val20+9, $val20+20

tmp3=!item $val24 of $(tmp0),	   $(tmp1),	   $(tmp2),	   2*$val20-$val25

val26=$[rint($(tmp3))]
tmp0=!shuffle $val10,$val11,$val12,$val13

val27=$(tmp0)
val28=$val11,$val11,$val11,$val10
tmp0=!item $val24 of $val28

val29=$(tmp0)
choicename1=Il
choicegood1=$val29
choicebad1=$val27
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Chercher l'extremum de la parabole et faites un dessin.


!goto stat

!exit

:question
$()$(val7[1;])	  <div class="wimscenter">
!insmath f(x) = $val22
$().</div>	  $(val7[2;1]) 
!insmath I
$() = [$val25, $val26].	  $(val7[2;2]) 
!insmath f^( -1)(f( I ))
$():	  $(val8[1;]) 
!insmath I
$()?	  $(val8[2;]) 
!insmath I
$()?	  $(val8[3;]) 
!insmath I
$()?	  $(val8[4;])?	
$()
!exit

:hint
$()Chercher l'extremum de la parabole et faites un dessin.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

