replyname4=4
replygood4=$val11
replyname5=5
replygood5=$val12
replyname6=6
replygood6=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>$val29 
!insmath  u_1 
$() = $val8.</p>	$(val14[1;])	 
!for m_k=1 to 2 
$()	 
