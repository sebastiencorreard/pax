val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 100,200,300,400,500

val6=$[rint($(tmp0))]
val7=$[1+$val6/10000]
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp0=!randint 10, 15

val9=$[rint($(tmp0))]
val10=$[$val8+$val6/1000]
val11=$[$val10+$val6/1000]
val12=$[$val8+$val6*($val9-1)/1000]
val13=$[$val9 *($val8+$val12)/2]
val14=Chaque semaine la distance parcourue est égale à la distance parcourue	la semaine précédente ?? à laquelle on ajoute $val6 m, multipliée par $val6,multipliée par $val7 ??.	<br>La suite \(( u_{n})\) est donc ??arithmétique,géométrique, ni l'un ni l'autre ??. 
tmp0=!singlespace $val14

val14=$(tmp0)
tmp0=!embraced randitem $val14

val14=$(tmp0)
!readproc slib/text/cutchoice2 $val14 
tmp0=$slib_out
val14=$(tmp0)
val15=$[rint(6)]
val16=
val17=
!for val18 =1 to $val15 
val19=$(val14[2*$val18;])
val20=$(val19[1])
tmp0=!sort items $val19

val19=$(tmp0)
tmp0=!positionof item $val20 in $val19

val20=$(tmp0)
val16=$val16$val20,
val17=$val17$val19;
!next
tmp0=!embraced randitem \pre

val21=$(tmp0)
tmp0=!embraced randitem \post

val22=$(tmp0)
tmp0=!makelist reply x for x=1 to $val15

val23=$(tmp0)
val24=$val6 m
val25=boy,girl
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val26=$(tmp0)
val25=$(val25[$val26])
!readproc slib/lang/fname ,$val25 
tmp0=$slib_out
val27=$(tmp0)
val28=Il,Elle
val29=Après une blessure, $val27 reprend son entrainement en natation. $(val28[$val26]) met au point	  un programme d'entrainement qui va se dérouler sur $val9 semaines.	  $(val28[$val26]) décide de parcourir $val8 km la première semaine et d'augmenter ensuite	  chaque semaine la distance parcourue de $val24.	  On note \( u_n \) la distance parcourue la \(n\)-ième semaine.	  Pour la première semaine, on a donc	
val30=Arrondir les valeurs au centième.
val31=Calculer les termes \(u_2\), \(u_3\) et \(u_$val9\) de cette suite.
val32=Calculer la distance totale parcourue pendant ces $val9 semaines
val33=distance totale parcourue
val34=et
oefsteps=$val23 
nextstep=!nosubst $val23 
!readproc oef/steps.proc
replytype1=menu
replyname1=Champ 1
replygood1=$(val16[1]);$(val17[1;])
replytype2=menu
