$() $(val14[2*$m_k+1;]) 
!next
$()	<p>	$val31	</p>	<div class="wims_instruction">$val30</div>	<ul><li>	 <label for="reply3"> 
!insmath u_2
$() =</label>  
!read oef/embed.phtml reply 3,3 
$() km	</li><li>	  <label for="reply4">
!insmath u_3
$() =</label>  
!read oef/embed.phtml reply 4,3 
$() km	</li><li>	  <label for="reply5">
!insmath u_$val9
$()</label> =  
!read oef/embed.phtml reply 5,3 
$() km	</li></ul>		$val32	<label for="reply6">$val33 =</label>  
