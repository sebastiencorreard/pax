!set title=Calculer des termes d'une suite 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe,Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soit \( (u_n) \) la suite de terme définie sur \(\,\NN\) par la relation
val7=Calculer les termes,et, de cette suite.
val8=Arrondir les valeurs au centième.
val9=et
tmp0=!randitem -3,-2,2,4,5

val10=$[rint($(tmp0))]
tmp0=!randint 5, 10

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2,3,4,5,10

val12=$[rint($(tmp0))]
tmp0=!randitem 20,30,50

val13=$[rint($(tmp0))]
tmp0=!randitem 100,200,500

val14=$[rint($(tmp0))]
val15=$[$val10*$val12^2/($val12+$val11)]
val16=$[$val10*$val13^2/($val13+$val11)]
val17=$[$val10*$val14^2/($val14+$val11)]
val18=3
replytype1=numeric
replyname1=\(u_1\)
replygood1=$[$val15]
replytype2=numeric
replyname2=\(u_1\)
replygood2=$[$val16]
replytype3=numeric
replyname3=\(u_1\)
replygood3=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>		$val6:		</p>	<div class="wimscenter">		
!insmath  u_{n} = \frac{$val10 n^2}{ n+$val11}
$().		</div>	<p>	$(val7[1]) 
!insmath u_$val12
$(), 
!insmath u_$val13
$() $(val7[2]) 
!insmath u_$val14
$() $(val7[3])	</p>		<div class="wims_instruction">$val8</div>		<ul><li>	  <label for="reply1">
!insmath u_$val12
$() =</label>  
!read oef/embed.phtml reply 1,$val18 
$()	</li><li>	  <label for="reply1">
!insmath u_$val13
$() =</label>  
!read oef/embed.phtml reply 2,$val18 
$()	</li><li>	  <label for="reply1">
!insmath u_$val14
$() =</label>  
!read oef/embed.phtml reply 3,$val18 
$()	</li></ul>	
$()
!exit

