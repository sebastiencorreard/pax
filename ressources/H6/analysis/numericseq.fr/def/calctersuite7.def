!set title=Déterminer la suite A
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe,Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Soit \( (u_n) \) une suite arithmétique de premier terme \(u_0\) telle que	  Calculer sa raison \(r\) et son terme initial
val6=!translate internal $	\
$ to ;; in $tmp
val7=et
tmp0=!randint 10, 50

val8=$[rint($(tmp0))]
tmp0=!randint 2, 15

tmp1=!randitem -1,1

val9=$[rint($(tmp0) *$(tmp1) )]
tmp0=!randint 2, 8

val10=$[rint($(tmp0))]
tmp0=!randint 5, 12

val11=$[rint($val10+$(tmp0))]
val12=$[rint($val8+$val9*$val10)]
val13=$[rint($val8+$val9*$val11)]
replyname1=
replygood1=$val9
replyname2=
replygood2=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	$(val6[1;])	
!insmath  u_$val10 = $val12
$() $val7 
!insmath  u_$val11 = $val13 
$().	</p><p>	$(val6[2;]) 
!insmath u_0
$():	</p>	<ul><li>	  <label for="reply1">
!insmath r
$() =</label>  
!read oef/embed.phtml reply 1,3 
$()	</li><li>	  <label for="reply2">
!insmath u_0
$() =</label>  
!read oef/embed.phtml reply 2,3 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11,12,13
embedcnt=2
