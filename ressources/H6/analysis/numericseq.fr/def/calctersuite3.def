!set title=Calculer des termes d'une suite 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe,Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soit \( (u_n) \) la suite de terme initial,	  et définie pour tout entier naturel par la relation de récurrence
val7=Calculer les termes,et, de cette suite.
val8=Arrondir les valeurs au centième.
val9=et
tmp0=!randitem -3,-2,2,4,5

val10=$[rint($(tmp0))]
tmp0=!randint 1, 10

val11=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val12=$[rint($(tmp0))]
!if $val12==1 
val13=+
!else
val13=
!endif
val11=$[rint($val11*$val12)]
tmp0=!randitem 1,2,3,4,5,10

val14=$[rint($(tmp0))]
val15=$[$val10*$val14+$val11]
val16=$[$val10*$val15+$val11]
val17=$[$val10*$val16+$val11]
val18=3
val19=$[rint(1)]
val20=$[rint(2)]
val21=$[rint(3)]
replytype1=numeric
replyname1=\(u_1\)
replygood1=$[$val15]
replytype2=numeric
replyname2=\(u_1\)
replygood2=$[$val16]
replytype3=numeric
replyname3=\(u_1\)
replygood3=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>		$(val6[1]) 
!insmath u_0 = $val14
$() $(val6[2]):		</p>	<div class="wimscenter">		
!insmath  u_{n+1} = $val10{ u_{n}}$val13$val11
$().		</div>	<p>	$(val7[1]) 
!insmath u_$val19
$(), 
!insmath u_$val20
$() $(val7[2]) 
!insmath u_$val21
$() $(val7[3])	</p>		<ul><li>	  <label for="reply1">
!insmath u_$val19
$() =</label>  
!read oef/embed.phtml reply 1,$val18 
$()	</li><li>	  <label for="reply1">
!insmath u_$val20
$() =</label>  
!read oef/embed.phtml reply 2,$val18 
$()	</li><li>	  <label for="reply1">
!insmath u_$val21
$() =</label>  
!read oef/embed.phtml reply 3,$val18 
$()	</li></ul>	
$()
