!set title=Calculer des termes d'une suite 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe,Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soit \( (u_n) \) la suite de terme initial,	  et définie pour tout entier naturel par la relation de récurrence
val7=Calculer les termes,et, de cette suite.
val8=Arrondir les valeurs au centième.
val9=et
tmp0=!randitem 1,2,3,4,5,10

val10=$[rint($(tmp0))]
val11=$[100/($val10)^2]
val12=$[100/($val11)^2]
val13=$[100/($val12)^2]
val14=5
val15=$[rint(1)]
val16=$[rint(2)]
val17=$[rint(3)]
replytype1=numeric
replyname1=\(u_1\)
replygood1=$[$val11]
replytype2=numeric
replyname2=\(u_1\)
replygood2=$[$val12]
replytype3=numeric
replyname3=\(u_1\)
replygood3=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>		$(val6[1]) 
!insmath u_0 = $val10
$() $(val6[2]):		</p>	<div class="wimscenter">		
!insmath  u_{n+1} = \frac{100}{ u_{n}^2}
$().		</div>	<p>	$(val7[1]) 
!insmath u_$val15
$(), 
!insmath u_$val16
$() $(val7[2]) 
!insmath u_$val17
$() $(val7[3])	</p>		<div class="wims_instruction">$val8</div>		<ul><li>	  <label for="reply1">
!insmath u_$val15
$() =</label>  
!read oef/embed.phtml reply 1,$val14 
$()	</li><li>	  <label for="reply1">
!insmath u_$val16
$() =</label>  
!read oef/embed.phtml reply 2,$val14 
$()	</li><li>	  <label for="reply1">
!insmath u_$val17
$() =</label>  
!read oef/embed.phtml reply 3,$val14 
$()	</li></ul>	
$()
!exit

