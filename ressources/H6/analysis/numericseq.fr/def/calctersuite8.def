!set title=Déterminer la suite G
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe,Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Soit \((u_n)\) une suite géométrique de premier terme \(u_0\) telle que	  Calculer sa raison \(q\) et son terme initial
val6=!translate internal $	\
$ to ;; in $tmp
val7=Pour faire ces calculs, on utilisera tous les chiffres des nombres
val8=et
tmp0=!randitem -1,1

val9=$[rint($(tmp0))]
!if $val9=1 
tmp0=!randint 10, 20

val10=$[$(tmp0)/1000]
tmp0=!randint 2, 6

val11=$[rint($(tmp0))]
!endif
!if $val9=-1 
tmp0=!randint 100, 200

val10=$[rint($(tmp0))]
tmp0=!randint 2, 5

val11=$[$(tmp0)/10]
!endif
tmp0=!randint 2, 4

val12=$[rint($(tmp0))]
tmp0=!randint 2, 5

val13=$[rint($val12+$(tmp0))]
val14=$[$val10*$val11^$val12]
val15=$[$val10*$val11^$val13]
replytype1=numeric
replyname1=
replygood1=$[$val11]
replytype2=numeric
replyname2=
replygood2=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	$(val6[1;])	
!insmath  u_$val12 
$()=$val14 $val8 
!insmath  u_$val13 
$()=$val15.	</p><p>	$(val6[2;]) 
!insmath u_0
$().	</p>	<div class="wims_instruction">	 $val7 
!insmath  u_$val12 
$() $val8 
!insmath  u_$val13 
$().	</div>	<ul><li>	  <label for="reply1">
!insmath q
$() =</label>  
!read oef/embed.phtml reply 1,3 
$()	</li><li>	  <label for="reply2">
!insmath u_0
$() =</label>  
!read oef/embed.phtml reply 2,3 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,12,13,14,15
embedcnt=2
