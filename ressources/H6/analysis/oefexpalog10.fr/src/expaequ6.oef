\text{reputilm=(\var)/ln(10)}

\real{equ=10^(\reputilm)}




\condition{Réponse correcte ?}{(\s<=0 and \var issametext aucune) or (\s>0 and \var==\sol) or (\s>0 and (log isin \var) and \equ==\c)}
