\title{Taux moyen}
\author{Cyrille,Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\integer{n=randint(2..6)}##Nombre d'évolutions##
\integer{choixevol=randint(-1,1)}
\text{typevol=(\choixevol=1)? augmentation:réduction}
\real{p=5*randint(1..8)}
\text{evol=\typevol de \(\p \%\)}##évolutions successives##
\real{coef1=(1+\choixevol*\p/100)}
\real{t=\coef1}##taux successifs##
\text{cm=\(\coef1\)}##coefficients multiplicateurs##
\for{i=2 to \n}{
\integer{choixevol=randint(-1,1)}
\text{typevol=(\choixevol=1)? augmentation:réduction}
\real{p=5*randint(1..8)}
\text{evol=\evol, \typevol de \(\p \%\)}
\real{coef=(1+\choixevol*\p/100)}
\real{t=\t*\coef}
\text{cm=\cm, \(\coef\)}
}
\real{tm=(\t)^(1/\n)}
\integer{entier=(floor(\tm)=\tm)? 1:0}##Pour le corrigé##
\real{tmarr=round(\tm*1000)/1000}##Pour le corrigé##
\real{tmoyen=(\tm>1)? \tm-1:1-\tm}
\real{tmoyen=round(\tmoyen*1000)/1000}##Pour le corrigé##
\real{pmoyen=\tmoyen*100}
\integer{evolmoyen=(\t>1)? 1:2}

\statement{Une valeur subit les évolutions successives suivantes : \evol.
<div class="wims_question">Quel est le taux d'évolution moyen équivalent à ces \(\n\) évolutions ?</div>
L'évolution moyenne est une \embed{r1} de \embed{r2,4}\(\%\).
<div class="wims_instruction">Donner le pourcentage arrondi à \(0.1\%\) près. Utiliser le point comme séparateur décimal.</div>}

\answer{}{\evolmoyen;augmentation,réduction}{type=menu}
\answer{}{\pmoyen}{type=formal}

\solution{Les coefficients multiplicateurs associées aux évolutions successives sont \cm.
<br>Pour les \(\n\) évolutions successives, le coefficient multiplicateur global est \if{\n=2}{\(\coef1 \times \coef=\t\)}{\(\coef1 \times \dots \times \coef=\t\)}.
<br>Le coefficient multiplicateur moyen est alors \(\t^\frac{1}{\n})\if{\entier=1}{\(=\tm\)}{\(\simeq \tmarr)}.
<br>\(\tmarr=1\)\if{\tm>1}{\({}+ \tmoyen\)}{\(-\tmoyen\)} donc l'évolution moyenne est une \if{\tm>1}{augmentation}{réduction} de \(\pmoyen \%\) \if{\entier=0}{environ}.}
