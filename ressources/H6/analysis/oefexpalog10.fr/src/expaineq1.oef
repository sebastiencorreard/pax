\title{Inéquation avec une exponentielle de base a 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\format{html}
\language{fr}
\range{-5..5}

\real{base=randitem(randint(2..10),randint(1..9)/10)}
\integer{b=randint(2..50)}
\text{ineg=>,\geq,\leq,<}
\text{inegrep=>,>=,<=,<}
\integer{choixineg=randint(1..4)}
\integer{inegx=(\base>1)? \choixineg:5-\choixineg}
\real{sol=log(\b)/log(\base)}

\statement{Les solutions de l'inéquation :
\( \base^x \ineg[\choixineg] \b \) sont les réels \(x\) vérifiant <br>
\(x\) \embed{reply1,2}\embed{reply2,12}.
<div class="wims_instruction">Choisir le symbole d'inégalite (>= pour &ge; ; <= pour &le;) dans la première case et écrire la valeur dans la seconde case (ne pas simplifier).</div>}
\answer{Inégalité}{\inegx;\inegrep}{type=menu}
\answer{}{\var}{type=raw}

\condition{Réponse correcte ?}{(\var==\sol) or ((log isin \var) and \base^(\var)==\b)}

\solution{\(\base^x \ineg[\choixineg] \b \) &hArr; \(log(\base^{x})\ineg[\choixineg] log(\b)\) &hArr; \(x log(\base)\ineg[\choixineg] log(\b)\) &hArr; \(x\ineg[\inegx]\frac{log(\b)}{log(\base)}\)
 car \if{\base<1}{\(log(\base)<0\)}{\(log(\base)>0\)}.}
