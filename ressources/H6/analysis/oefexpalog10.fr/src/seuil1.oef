\title{Recherche de seuil 1}
\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}
\format{html}
\language{fr}
\range{-5..5}

\real{base=randitem(randint(11..32)/10,randint(1..9)/10)}
\real{c=(\base>1)? randint(500..9990)*1000:randint(1..100)/100000}
\text{ineg=(\base>1)? >:<}
\text{t=slib(numeration/ecriturenombre \c,tex)}

\real{s=log(\c)/log(\base)}
\real{sol=floor(\s)+1}
\integer{cond=(floor(\s)<\s)? 1:0}
\text{cor=wims(exec moneyprint \s 3)}

\statement{<div class="wims_question">Déterminer le plus petit entier naturel \(n\) tel que \(\base^n \ineg \t\).</div>
\(n=)\embed{r1,3}.}

\answer{\(n)}{\sol}{type=formal}

\solution{\(\base^n \ineg \t\) &hArr; \(log(\base^n) \ineg log(\t)\) &hArr; \(n \times log(\base) \ineg log(\t) \)
&hArr; \(\n > \frac{log(\t)}{log(\base)}\) car \if{\base>1}{\(log(\base)>0\)}{\(log(\base)<0\)}.<br/>
\if{\cond=1}{\(\frac{log(\t)}{log(\base)}\simeq \cor\) donc la}{La} valeur de \(n\) est \(\sol\).}
