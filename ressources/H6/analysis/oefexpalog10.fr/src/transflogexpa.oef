\title{Transformation d'écritures avec log et exp}
\language{fr}
\author{Cyrille, Douriez}##adaptation d'un module de David Doyen sur ln et exp##
\email{cyrille.douriez@ac-amiens.fr}

\real{val=randint(1..100)/10}
\text{val=(\val=1)? randitem(0.5,0.8,1.6,2.4,3.7):\val}
\if{\confparm1=}{
\text{type=1}
}{
\text{type=randitem(\confparm1,\confparm1)}
}

\text{typerep=numexp}

\text{l=shuffle(2,3,4,5,6)}
\text{p=\l[1]}
\text{q=\l[2]}

\if{\type=1}{
\text{u=randint(2..4)}
\text{a=simplify(\p^(\u))}
\text{expr=\u log (\p)}
\text{corrige=On utilise la propriété du logarithme : \(n \times log(a)=log(a^n)).}
}
\if{\type=2}{
\text{u=randint(-4..-2)}
\text{a=simplify(\p^(\u))}
\text{expr=\u log (\p)}
\text{corrige=On utilise la propriété du logarithme : \(n \times log(a)=log(a^n)).}
}
\if{\type=3}{
\text{a=simplify(\p*\q)}
\text{expr=log(\p)+log(\q)}
\text{corrige=On utilise la propriété du logarithme : \(log(a)+log(b)=log(a \times b)).}
}
\if{\type=4}{
\text{a=simplify(\p/\q)}
\text{expr=randitem(log(\p)-log(\q),-log(\q)+log(\p))}
\text{corrige=On utilise la propriété du logarithme : \(log(a)-log(b)=log \left(\frac{a}{b} \right)).}

}
\if{\type=5}{
\text{l1=shuffle(1,randitem(2,3,4))}
\integer{u=\l1[1]}
\integer{v=\l1[2]}
\text{expr=\u*log(\p)+\v*log(\q)}
\text{a=simplify(\p^(\u)*\q^(\v))}
\text{corrige=On utilise les propriétés du logarithme : \(log(a)+log(b)=log(a \times b)\) et \(n \times log(a)=log(a^n)\).}
}
\if{\type=6}{
\text{a=simplify(\p/\q)}
\text{l1=shuffle(1,randitem(2,3,4))}
\text{l2=shuffle(-1,1)}
\integer{u=\l1[1]*\l2[1]}
\integer{v=\l1[2]*\l2[2]}
\text{expr=\u*log(\p)+\v*log(\q)}
\text{a=simplify(\p^(\u)*\q^(\v))}
\text{corrige=On utilise les propriétés du logarithme : \(log(a)+log(b)=log(a \times b)) ; \(log(a)-log(b)=log \left( \frac{a}{b} \right)\) et \(n \times log(a)=log(a^n)\).}

}
\if{\type=7}{
\text{a=simplify(\p/\q)}
\text{l1=shuffle(2,3,4)}
\integer{u=\l1[1]}
\integer{v=\l1[2]}
\text{expr=\u*log(\p)+\v*log(\q)}
\text{a=simplify(\p^(\u)*\q^(\v))}
\text{corrige=On utilise les propriétés du logarithme : \(log(a)+log(b)=log(a \times b)\) et \(n \times log(a)=log(a^n)\).}

}
\if{\type=8}{
\text{a=simplify(\p/\q)}
\text{l1=shuffle(2,3,4)}
\text{l2=shuffle(-1,1)}
\integer{u=\l1[1]*\l2[1]}
\integer{v=\l1[2]*\l2[2]}
\text{expr=\u*log(\p)+\v*log(\q)}
\text{a=simplify(\p^(\u)*\q^(\v))}
\text{corrige=On utilise les propriétés du logarithme : \(log(a)+log(b)=log(a \times b)\) ; \(log(a)-log(b)=log \left( \frac{a}{b} \right)\) et \(n \times log(a)=log(a^n)\).}

}
\if{\type=9}{
\text{typerep=algexp}
\text{expr=randitem(log(\p)+\q,\q+log(\p))}
\text{a=simplify(\p*10^(\q))}
\text{corrige=On utilise les propriétés du logarithme : \(\q=log(10^{\q})\) et \(log(a)+log(b)=log(a \times b)\).}

}
\if{\type=10}{
\text{typerep=formal}
\text{l1=shuffle(-1,1)}
\integer{s1=\l1[1]}
\integer{s2=\l1[2]}
\text{expr=randitem(\s1*log(\p)+\s2*\q,\s2*\q+\s1*log(\p))}
\text{a=simplify((\p^\s1)*10^(\s2*\q))}
\text{corrige=On utilise les propriétés du logarithme : \(\q=log(10^{\q}))&#44; \(log(a)+log(b)=log(a \times b))&#44; \(log(a)-log(b)=log \left( \frac{a}{b} \right)) et \(n \times log(a)=log(a^n)).}
}
\if{\type=11}{
\text{typerep=algexp}
\text{u=randint(2..4)}
\text{expr=randitem(\u*log(\p)+\q,\q+\u*log(\p))}
\text{a=simplify(\p^(\u)*10^(\q))}
\text{corrige=On utilise les propriétés du logarithme : \(\q=log(10^{\q}))&#44; \(log(a)+log(b)=log(a \times b)) et \(n \times log(a)=log(a^n)).}

}
\if{\type=12}{
\text{typerep=algexp}
\text{u=randint(2..4)}
\text{l1=shuffle(-1,1)}
\integer{s1=\l1[1]}
\integer{s2=\l1[2]}
\text{expr=randitem(\s1*\u*log(\p)+\s2*\q,\s2*\q+\s1*\u*log(\p))}
\text{a=simplify(\p^(\s1*\u)*10^(\s2*\q))}
\text{corrige=On utilise les propriétés du logarithme : \(\q=log(10^{\q}))&#44; \(log(a)+log(b)=log(a \times b))&#44; \(log(a)-log(b)=log \left( \frac{a}{b} \right)) et \(n \times log(a)=log(a^n)).}
}

\text{l=shuffle(2,3,4,5)}
\integer{p=randitem(-1,1)*\l[1]}
\integer{q=randitem(-1,1)*\l[2]}

\if{\type=13}{
\integer{u=randitem(-1,1)*randint(2..4)}
\text{a=simplify((\p)*(\u))}
\text{expr=\left ( \val^{\p} \right )^{\u}}
\text{corrige=On utilise la propriété de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}).}
}
\if{\type=14}{
\integer{u=randitem(-1,1)*randint(2..4)}
\text{a=simplify((-\p)*(\u))}
\text{expr=\frac{1}{\left ( \val^{\p}\right )^{\u}}}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \(\frac{1}{a^x}=a^{-x}).}
}
\if{\type=15}{
\text{a=simplify(\p+\q)}
\text{expr=\val^{\p}\times \val^{\q}}
\text{corrige=On utilise la propriété de l'exponentielle de base \(a) : \( a^x \times a^y=a^{x+y}).}
}
\if{\type=16}{
\text{a=simplify(\p-\q)}
\text{expr=\frac{\val^{\p}}{\val^{\q}}}
\text{corrige=On utilise la propriété de l'exponentielle de base \(a) : \(\frac{a^x}{a^y}=a^{x-y}).}
}
\if{\type=17}{
\integer{u=randitem(-1,1)*randint(2..4)}
\text{expr=randitem(\left ( \val^{\p} \right )^{\u} \times \val^{\q},\val^{\q} \times \left ( \val^{\p} \right )^{\u})}
\text{a=simplify((\p)*(\u) +\q)}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \( a^x \times a^y=a^{x+y}).}
}
\if{\type=18}{
\integer{u=randitem(-1,1)*randint(2..4)}
\if{randitem(1,2)=1}{
\text{expr=\frac{\left ( \val^{\p} \right )^{\u}}{\val^{\q}}}
\text{a=simplify(\p*(\u)-(\q))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \(\frac{a^x}{a^y}=a^{x-y}).}

}{
\text{expr=\frac{\val^{\q}}{\left ( \val^{\p} \right )^{\u}}}
\text{a=simplify(\q-(\p)*(\u))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \(\frac{a^x}{a^y}=a^{x-y}).}
}
}
\if{\type=19}{
\text{l1=shuffle(2,3,4)}
\integer{u=randitem(-1,1)*\l1[1]}
\integer{v=randitem(-1,1)*\l1[2]}
\text{expr=\left ( \val^{\p} \right )^{\u} \times \left ( \val^{\q} \right )^{\v}}
\text{a=simplify((\p)*(\u)+(\q)*(\v))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \( a^x \times a^y=a^{x+y}).}

}
\if{\type=20}{
\text{l1=shuffle(2,3,4)}
\integer{u=randitem(-1,1)*\l1[1]}
\integer{v=randitem(-1,1)*\l1[2]}
\text{expr=\frac{\left ( \val^{\p} \right )^{\u}}{\left ( \val^{\q} \right )^{\v}}}
\text{a=simplify((\p)*(\u)-(\q)*(\v))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(\left ( a^x \right ) ^y=a^{x \times y}) et \(\frac{a^x}{a^y}=a^{x-y}).}

}
\if{\type=21}{
\text{val=10}
\text{typerep=algexp}
\integer{q=abs(\q)}
\text{expr=randitem(\val^{\p}\times \q,\q \times \val^{\p})}
\text{a=simplify(\p+log(\q))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(a=10^{log(a)}) et \( a^x \times a^y=a^{x+y}).}

}
\if{\type=22}{
\text{val=10}
\text{typerep=algexp}
\integer{q=abs(\q)}
\if{randitem(1,2)=1}{
\text{expr=\frac{\val^{\p}}{\q}}
\text{a=simplify(\p-log(\q))}
}{
\text{expr=\frac{\q}{\val^{\p}}}
\text{a=simplify(log(\q)-\p)}
}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(a=10^{log(a)}) et \(\frac{a^x}{a^y}=a^{x-y}).}

}
\if{\type=23}{
\text{val=10}
\text{typerep=algexp}
\integer{q=abs(\q)}
\integer{u=randitem(-1,1)*randint(2..4)}
\text{expr=randitem(\left ( \val^{\p} \right )^{\u}\times \q,\q \times \left ( \val^{\p} \right )^{\u})}
\text{a=simplify((\p)*(\u)+log(\q))}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(a=10^{log(a)}), \(\left ( a^x \right ) ^y=a^{x \times y}) et \( a^x \times a^y=a^{x+y}).}

}
\if{\type=24}{
\text{val=10}
\text{typerep=algexp}
\integer{q=abs(\q)}
\integer{u=randitem(-1,1)*randint(2..4)}
\if{randitem(1,2)=1}{
\text{expr=\frac{\left ( \val^{\p} \right )^{\u}}{\q}}
\text{a=simplify((\p)*(\u)-log(\q))}
}{
\text{expr=\frac{\q}{\left( \val^{\p} \right)^{\u}}}
\text{a=simplify(log(\q)-(\p)*(\u))}
}
\text{corrige=On utilise les propriétés de l'exponentielle de base \(a) : \(a=10^{log(a)}), \(\left ( a^x \right ) ^y=a^{x \times y}) et \(\frac{a^x}{a^y}=a^{x-y}).}

}


\statement{<div>Ecrire l'expression suivante sous la forme \if{\type<13}{\(log(a) \), où \(a\) est un nombre.}{\(\val^x\), où \(x\) est un nombre.}</div>

<div>\if{\type<13}{\(\expr= log\)(\embed{reply1,6})}{
\special{mathmlinput [\expr= \val^reply1],1
reply1,6
}}
</div>
}
\answer{}{\a}{type=\typerep}
\solution{\corrige}
