\title{Variation d'une fonction exponentielle}
\author{David,Rousseau}##adapté à modtool par Cyrille Douriez##

\real{a1=randint(11..99)/10}
\real{a2=randint(11..99)/10}
\real{a3=randint(1..99)/100}
\real{a4=randint(1..99)/100}

\integer{k1=randint(1..9)}
\integer{k2=randint(-15..-2)}
\integer{k3=randint(1..24)}
\integer{k4=randint(-9..-1)}

\function{f1=\k1 *\a1^x}
\function{f2=\k2 *\a2^x}
\function{f3=\k3 *\a3^x}
\function{f4=\k4 *\a4^x}
\text{f1=texmath(\f1)}
\text{f2=texmath(\f2)}
\text{f3=texmath(\f3)}
\text{f4=texmath(\f4)}

\matrix{data=\f1,2,\(\a1>1) et \(\k1>0) donc la fonction \(x\mapsto \f1) est strictement croissante sur \(\mathbb{R}).
\f2,1,\(\a2>1) et \(\k2<0) donc la fonction \(x\mapsto \f2) est strictement décroissante sur \(\mathbb{R}).
\f3,1,\(0<\a3<1) et \(\k3>0) donc la fonction \(x\mapsto \f3) est strictement décroissante sur \(\mathbb{R}).
\f4,2,\(0<\a4<1) et \(\k4<0) donc la fonction \(x\mapsto \f4) est strictement croissante sur \(\mathbb{R}).}
\text{ordre=wims(shuffle 1,2,3,4)}

\statement{<div class="wims_question">Donner le sens de variation sur \(\mathbb{R}) des fonctions ci-dessous :</div>
<div style="background-color: #F2F9FC;"><b>1.</b>La fonction \(x\mapsto \data[\ordre[1];1]) est<br>
\embed{r1}</div><br>

<div style="background-color: #F2F9FC;"><b>2.</b>La fonction \(x\mapsto \data[\ordre[2];1]) est<br>
\embed{r2}</div>
<div style="background-color: #F2F9FC;"><b>3.</b>La fonction \(x\mapsto \data[\ordre[3];1]) est<br>
\embed{r3}</div>}

\answer{Q1}{\data[\ordre[1];2];strictement décroissante,strictement croissante}{type=radio}
\answer{Q2}{\data[\ordre[2];2];strictement décroissante,strictement croissante}{type=radio}
\answer{Q3}{\data[\ordre[3];2];strictement décroissante,strictement croissante}{type=radio}

\solution{\data[\ordre[1];3]
<br>\data[\ordre[2];3]
<br>\data[\ordre[3];3]}
