\title{Equation avec une fonction puissance 1}

\author{Cyrille, Douriez}
\email{cyrille.douriez@ac-amiens.fr}

\real{a=randint(3..20)}
\integer{b=randint(2..80)*randitem(1,1,1,-1)}
\text{equat=x^{\a}=\b}
\text{q=log(\b)/\a}
\text{sol=10^(\q)}
\text{sol=(\b<=0)? aucune:\sol}
\text{racine= \b^(1/\a)}
\text{corrigeancien=\(x^{\a}=\b) &hArr; \(log(x^{\a})=log(\b)\) &hArr; \(\a log(x)=log(\b)\) &hArr; \(log(x)=\frac{log(\b)}{\a}\) &hArr; \(x=10^{\frac{log(\b)}{\a}}\).}
\text{corrige=(\b<0)? \(\b\leq 0\) donc il n'y a pas de solution.:Par définition \(x^{\a}=\b) &hArr;  \(x=\b ^{\frac{1}{\a}}\).}
\statement{
<div class="wims_question">Résoudre dans \(\mathbb{R}_{{}+{}}) l'équation :
\( \equat \)
<br>La solution est \(x=\)\embed{reply1,8}.</div>
<div class="wims_instruction">En cas d'absence de solution, écrire : aucune.</div>}

\answer{Ensemble des solutions}{\var}{type=function}
\real{numval=\var}
\real{test=\numval^(\a)}
\condition{Solution correcte ?}{(\var issametext \sol) or (\b>0 and \var issametext \racine) or (\b>0 and abs(\test-\b)<0.00001)}
\real{testval=\var}
\real{test=\testval^(\a)}
\feedback{\sc_reply1<1}{<div class="feedback">\corrige</div> }
