\frac{\base^x+\base^{-x}}{\base^x-\base^{-x}},\frac{\base^{2x}+1}{\base^{2x}-1},\frac{1+\base^{-2x}}{1-\base^{-2x}},\frac{\base^{-x}+1}{\base^{-x}-1}
