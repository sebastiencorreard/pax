!set title=Equation avec une exponentielle de base a 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randint 0, 20

tmp1=!randitem -1,-1,-1,1

val8=$[rint($val6*$(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val6*x^2+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!texmath $val9

val9=$(tmp0)
val10=$val7^{$val9}=1
t_=!rawmath -$val8/$val6
val11=!exec pari print($t_)

!ifval ($val11>=0)
val12=$[rint( 2)]
!else
val12=$[rint(1)]
!endif
val13=sqrt($val11)
val14=-sqrt($val11)

!ifval ($val12=1)
val15= aucune
!else
val15=$val13,$val14
!endif

!ifval ($val11=0)
val15= 0
!else
val15=$val15
!endif
val16=fset
val17=$[rint(abs($val8))]
val18=\($val7^{$val9}=1) &hArr; \($val9=0)

!ifval ($val8>=0)
val18= $val18 <br>&hArr; \($val6 x^2=-$val8)
!else
val18=$val18 <br>&hArr; \($val6 x^2=$val17)
!endif
val18=$val18 <br>&hArr; \( x^2=$val11)
!if $val11=0 
val18=$val18<br> &hArr; \(x=0).
!else

!ifval ($val11<0)
val18= $val18. <br>\(x^2 \geq 0) et \($val11<0) donc il n'y a pas de solution. 
!else
val18=$val18<br> &hArr; \(x=\sqrt{$val11}) ou \(x=-\sqrt{$val11}).
!endif
!endif
val19=$[rint(1)]
val20=Séparer les solutions éventuelles par une virgule. Pour \(\sqrt{...}), écrire : sqrt(...).</div>

!ifval $val15 issametext aucune 
val21=r1
!else
val21=r1;r2
!endif
val22=$[rint(2)]

!ifval $val15 issametext aucune 
val23=$[rint(2)]
!else
val23=$[rint(1)]
!endif
oefsteps=$val21 
nextstep=!nosubst $val21 
!readproc oef/steps.proc
replytype1=radio
replyweight1=1 
replyname1=
replygood1=$val23;Oui,Non
replytype2=$val16

replyoption2=absolute comma 
replyweight2=3 
replyname2=
replygood2=$val15
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val18


!goto stat

!exit

:question
$()	On considère l'équation 
!insmath  $val10 
$() dans 
!insmath \mathbb{R}
$().	
!if $m_step=1 and $val22>1 
$()<div class="wims_question">Cette équation a-t-elle des solutions ?  
!read oef/embed.phtml reply1,10 
$() </div> 
!endif
$()	
!if $m_step=1 and $val22=1 
$()<div class="wims_question">	
!if $val16 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	 
!endif
$()	
!if $m_step=2 
$()<div class="wims_question">	
!if $val16 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	
!if $val19=1 
$()<div class="wims_instruction">$val20</div>  
!endif
$() 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val18
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,16,18,19,20,22
embedcnt=3
