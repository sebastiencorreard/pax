!set title=Equation avec une exponentielle de base a 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 20

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]

!ifval ($val8==10)
tmp0=!randint 1, 9

val8=$[rint( $(tmp0))]
!else
val8=$[rint($val8)]
!endif
val9=$val7^{x}=$val8
val10=$[log($val8)/log($val7)]
!if $val8<0 
val11=aucune
!else
val11=$[$val10]
!endif
val12=function

!ifval ($val8<0)
val13= \($val8\leq 0) et \($val7^{x}>0) donc il n'y a pas de solution
!else
val13=\($val7^{x}=$val8) &hArr; \(log($val7^{x})=log($val8)) &hArr; \(x log($val7)=log($val8)) &hArr; \(x=\frac{log($val8)}{log($val7)})
!endif

!ifval (floor($val10)=$val10)
val13= $val13\(=$val10).
!else
val13=$val13.
!endif
val14=$[rint(0)]

!ifval $val11 issametext aucune 
val15=r1
!else
val15=r1;r2
!endif
val16=$[rint(2)]

!ifval $val11 issametext aucune 
val17=$[rint(2)]
!else
val17=$[rint(1)]
!endif
oefsteps=$val15 
nextstep=!nosubst $val15 
!readproc oef/steps.proc
replytype1=radio
replyweight1=1 
replyname1=
replygood1=$val17;Oui,Non
replytype2=$val12

replyoption2=absolute comma 
replyweight2=3 
replyname2=
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val13


!goto stat

!exit

:question
$()	On considère l'équation 
!insmath  $val9 
$() dans 
!insmath \mathbb{R}
$().	
!if $m_step=1 and $val16>1 
$()<div class="wims_question">Cette équation a-t-elle des solutions ?  
!read oef/embed.phtml reply1,10 
$() </div> 
!endif
$()	
!if $m_step=1 and $val16=1 
$()<div class="wims_question">	
!if $val12 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	 
!endif
$()	
!if $m_step=2 
$()<div class="wims_question">	
!if $val12 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	
!if $val14=1 
$()<div class="wims_instruction">$m_instruction</div>  
!endif
$() 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val13
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12,13,14,16
embedcnt=3
