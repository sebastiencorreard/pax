!set title=Equation avec une exponentielle de base a 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 20

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]

!ifval ($val8==10)
tmp0=!randint 1, 9

val8=$[rint( $(tmp0))]
!else
val8=$[rint($val8)]
!endif
t_=!replace internal \( by ( in $val6*x+$val8
tmp0=!exec maxima $t_

val9=!rawmath $(tmp0)
tmp0=!texmath $val9

val9=$(tmp0)
tmp=!nonempty items 1,1,1,1,0,-1

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
val11=$val7^{$val9}=$val10
!if $val10==1 
t_=!rawmath -$val8/$val6
val12=!exec pari print($t_)
!else
val12=aucune
!endif
val13=numeric

!ifval ($val10<1)
val14= \($val7^{$val9}>0) donc il n'y a aucune solution.
!else
val14=\($val7^{$val9}=1) &hArr; \($val9=0) &hArr; \(x=$val12).
!endif
val15=$[rint(0)]

!ifval $val12 issametext aucune 
val16=r1
!else
val16=r1;r2
!endif
val17=$[rint(2)]

!ifval $val12 issametext aucune 
val18=$[rint(2)]
!else
val18=$[rint(1)]
!endif
oefsteps=$val16 
nextstep=!nosubst $val16 
!readproc oef/steps.proc
replytype1=radio
replyweight1=1 
replyname1=
replygood1=$val18;Oui,Non
replytype2=$val13

replyoption2=absolute comma 
replyweight2=3 
replyname2=
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val14


!goto stat

!exit

:question
$()	On considère l'équation 
!insmath  $val11 
$() dans 
!insmath \mathbb{R}
$().	
!if $m_step=1 and $val17>1 
$()<div class="wims_question">Cette équation a-t-elle des solutions ?  
!read oef/embed.phtml reply1,10 
$() </div> 
!endif
$()	
!if $m_step=1 and $val17=1 
$()<div class="wims_question">	
!if $val13 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	 
!endif
$()	
!if $m_step=2 
$()<div class="wims_question">	
!if $val13 issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply2,8 
$().</div>	
!if $val15=1 
$()<div class="wims_instruction">$m_instruction</div>  
!endif
$() 
!endif
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val14
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13,14,15,17
embedcnt=3
