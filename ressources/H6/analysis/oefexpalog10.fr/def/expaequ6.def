!set title=Equation avec une exponentielle de base a 6
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r
varcnt=13
prevarcnt=10
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp=!nonempty items 1,1,1,-1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
val8=10^{\x}=$val7
!if $val7<=0 
val9=aucune
!else
val9=$[log($val7)/log(10)]
!endif
val10=1
val11=En cas d'absence de solution, écrire : aucune
!if $val7<=0 
val12=\(10^{x}>0) et \($val7\leq 0) donc il n'y a pas de solution.
!else
val12=\(10^{x}=$val7) &hArr; \(x=log($val7))
!endif
val13=$[rint($val7)]
replytype1=raw
replyoption1=absolute comma 
replyname1=
replygood1=?analyze 14
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val12


!goto stat

!exit

:question
$()	<div class="wims_question">Résoudre dans 
!insmath \mathbb{R}
$() l'équation :	
!insmath  $val8 
$()</div>	
!if $m_typesol issametext fset 
$()L'ensemble des solutions est 
!else
$() La solution est  
!endif
$()  
!read oef/embed.phtml reply1,8 
$().	
!if $val10=1 
$()<div class="wims_instruction">$val11</div> 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val12
$()
!exit

:latex
$()
$()
!exit

:postdef
val15=($val14)/ln(10)
val16=$[10^($val15)]

!exit

:feedback

!exit

:test

!ifval ($val13<=0 and $val14 issametext aucune) or ($val13>0 and $val14==$val9) or ($val13>0 and (log isin $val14) and $val16==$val7)
 condtest1=1
!else
 condtest1=0
!endif
condname1=Réponse correcte ?

!exit

:stat
vsavelist=7,8,9,10,11,12,13,14
embedcnt=1
