!set title=Variation d'une fonction exponentielle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David,Rousseau

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

val6=$[$(tmp0)/10]
tmp0=!randint 11, 99

val7=$[$(tmp0)/10]
tmp0=!randint 1, 99

val8=$[$(tmp0)/100]
tmp0=!randint 1, 99

val9=$[$(tmp0)/100]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!randint -15, -2

val11=$[rint($(tmp0))]
tmp0=!randint 1, 24

val12=$[rint($(tmp0))]
tmp0=!randint -9, -1

val13=$[rint($(tmp0))]
val14=!rawmath $val10 *$val6^x
val15=!rawmath $val11 *$val7^x
val16=!rawmath $val12 *$val8^x
val17=!rawmath $val13 *$val9^x
tmp0=!texmath $val14

val14=$(tmp0)
tmp0=!texmath $val15

val15=$(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)
tmp0=!texmath $val17

val17=$(tmp0)
tmp=!trim $val14,2,\($val6>1) et \($val10>0) donc la fonction \(x\mapsto $val14) est strictement croissante sur \(\mathbb{R}).	$val15,1,\($val7>1) et \($val11<0) donc la fonction \(x\mapsto $val15) est strictement décroissante sur \(\mathbb{R}).	$val16,1,\(0<$val8<1) et \($val12>0) donc la fonction \(x\mapsto $val16) est strictement décroissante sur \(\mathbb{R}).	$val17,2,\(0<$val9<1) et \($val13<0) donc la fonction \(x\mapsto $val17) est strictement croissante sur \(\mathbb{R}).
val18=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 1,2,3,4

val19=$(tmp0)
replytype1=radio
replyname1=Q1
replygood1=$(val18[$(val19[1]);2]);strictement décroissante,strictement croissante
replytype2=radio
replyname2=Q2
replygood2=$(val18[$(val19[2]);2]);strictement décroissante,strictement croissante
replytype3=radio
replyname3=Q3
replygood3=$(val18[$(val19[3]);2]);strictement décroissante,strictement croissante
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $(val18[$(val19[1]);3]) <br>$(val18[$(val19[2]);3]) <br>$(val18[$(val19[3]);3])


!goto stat

!exit

:question
$()<div class="wims_question">Donner le sens de variation sur 
!insmath \mathbb{R}
$() des fonctions ci-dessous :</div>	<div style="background-color: #F2F9FC;"><b>1.</b>La fonction 
!insmath x\mapsto $(val18[$(val19[1]);1])
$() est<br>	 
!read oef/embed.phtml r1 
$()</div><br>		<div style="background-color: #F2F9FC;"><b>2.</b>La fonction 
!insmath x\mapsto $(val18[$(val19[2]);1])
$() est<br>	 
!read oef/embed.phtml r2 
$()</div>	<div style="background-color: #F2F9FC;"><b>3.</b>La fonction 
!insmath x\mapsto $(val18[$(val19[3]);1])
$() est<br>	 
!read oef/embed.phtml r3 
$()</div>
$()
