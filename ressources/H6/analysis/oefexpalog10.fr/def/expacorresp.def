val18=$[rint(2*$val8-$val7)]
val19=$val6^{$val7 x}\times $val6^{$val8 x},$val6^{$val11 x},\frac{$val6^{$val7 x}}{ $val6^{$val8 x}},$val6^{$val10 x},	\frac{$val6^{$val8 x}}{ $val6^{$val7 x}},$val6^{$val12 x},\frac{$val6^{$val7 x}}{ ($val6^{$val8 x})^2},$val6^{$val13 x},	$val6^{$val7 x}\times ($val6^{$val8 x})^2,$val6^{$val14 x},($val6^{$val7 x})^2\times $val6^{$val8 x},$val6^{$val15 x},\frac{$val6^{$val8 x}}{ ($val6^{$val7 x})^2},$val6^{$val16 x},	\frac{($val6^{$val7 x})^2}{ $val6^{$val8 x}},$val6^{$val17 x},	\frac{($val6^{$val8 x})^2}{ $val6^{$val7 x}},$val6^{$val18 x}	
