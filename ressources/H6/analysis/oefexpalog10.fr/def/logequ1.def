!set title=Equation avec un logarithme décimal 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -2, 9

val6=$[rint($(tmp0))]
t_=!rawmath 10^($val6)
val7=!exec pari print($t_)
val8=log(x)=$val6
val9=\(log(x)=$val6) &hArr;  \(x=10^{$val6}).
replytype1=formal
replyname1=La solution est
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val9


!goto stat

!exit

:question
$()<div class="wims_question">Résoudre dans 
!insmath \mathbb{R}
$() l'équation :	
!insmath  $val8 
$()</div>	La solution est  
!read oef/embed.phtml reply1,8 
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val9
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=1
