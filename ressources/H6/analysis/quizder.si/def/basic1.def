!set title=Enostavni odvodi I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
val12=!rawmath $val8*x+$val9
tmp0=!randitem sin,cos

val13=$(tmp0)
tmp0=!randitem 2,3

tmp1=!randitem 2,3

tmp=!nonempty items 	 $val8*x^$(tmp0) + $val9,	 $val8*x^$(tmp1) + $val9*x,	 $val6*$val13(x+$val8),	 $val6*$val13($val8*x),	 sqrt($val8*x+$val9),	 (x+$val8)^2,	 $val6*exp(x+$val8),	 $val6*exp($val8*x),	 $val6*log(x+$val8),	 $val6*log($val8*x)	

tmp2=!randitem $tmp
val14=!rawmath $(tmp2)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
replytype1=formal
replyname1=Odvod \(f'(x))
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

