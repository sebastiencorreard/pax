val6=<i>f</i>
val7=<i>g</i>
val8=<b>R</b>
tmp0=!randitem 1,2,4,5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$[rint($val10*2)]
val12=$[-($val10)/($val9)]
val13=$[($val10)^2/($val9)]

!ifval $val9>0
tmp0=!randint $val13-10, $val13-3

val14=$[rint($(tmp0))]
!else
tmp1=!randint $val13+3, $val13+10

val14=$[rint($(tmp1))]
!endif
val15=!rawmath $val9*x^2 + $val11*x + $val14
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]

!ifval $val16=1
tmp0=!randint floor($val12)-4, floor($val12)-1

val17=$[rint($(tmp0))]
!else
tmp1=!randint ceil($val12)+1, ceil($val12)+4

val17=$[rint(	           $(tmp1))]
!endif

!ifval $val16=1
tmp0=!randint $val17-4, $val17-1

val11=$[rint($(tmp0))]
!else
tmp1=!randint $val17+1, $val17+4

val11=$[rint($(tmp1))]
!endif
val18=$[rint(min($val11,$val17))]
val19=$[rint(max($val17,$val11))]
evaltmp=$val15

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val17=$[$(tmp0)]
evaltmp=$val15

evaltmp=!mathsubst x=($val19) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
val20=$[min($val17,$val11)]
val21=$[max($val17,$val11)]
val22=$[rint(($val10)^2-($val9)*($val14))]

!ifval $val17<$val11
val23=!rawmath (-$val10+sqrt($val9*x+$val22))/($val9)
!else
val23=!rawmath 	            (-$val10-sqrt($val9*x+$val22))/($val9)
!endif
tmp0=!htmlmath $val15

val24=$(tmp0)
replyname1=$val6<sup>-1</sup>(x)
replygood1=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val6: [$val18,$val19] -&gt; [$val20,$val21] 是一个函数, 定义为	<p><center>	$val6(x) = $val24 .	</center> <p>	验证 $val6 是双射的, 并计算逆函数	$val6<sup>-1</sup>:&nbsp;[$val20,$val21]&nbsp;-&gt;&nbsp;[$val18,$val19].	<p>	你可以用 <tt>sqrt(2)</tt> 表示 2 的平方根.	
$()
