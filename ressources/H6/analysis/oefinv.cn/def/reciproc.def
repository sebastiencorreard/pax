!set title=逆函数的导数
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=100000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>f</i>
val7=<i>g</i>
val8=<b>R</b>
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint abs($val9)+1, abs($val9)+3

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sin,cos

val13=$(tmp0)
tmp0=!randitem +,-

val14=$(tmp0)
val15=!rawmath $val10*x $val14 $val13($val9*x+$val11) + $val12
tmp0=!randint -100, 100

val16=$[rint($(tmp0))]
tmp=!replace internal .. by , in $val15 - ($val16),x=-1000..1000 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val17=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
evaltmp=$val18

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val19=$[1/$(tmp0)]
tmp0=!htmlmath $val15

val20=$(tmp0)
replyname1=$val7&nbsp;<tt>'</tt>($val16)
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()设 $val6: $val8 -> $val8 是一个函数, 定义为	<p><center>	$val6(x) = $val20 .	</center> <p>	验证 $val6 是双射的, 所以我们有一个逆函数	$val7(x)&nbsp;=&nbsp;$val6<sup>-1</sup>(x). 计算导数值	$val7&nbsp;<tt>'</tt>($val16)&nbsp;.	<p>	你的回答必须精确到 4 位有效数字.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,16,20
embedcnt=0
