\title{不可微逆函数}
\language{cn}
\range{-0.9..0.9}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\text{if=<i>f</i>}
\text{BR=<b>R</b>}
\text{x0=x<sub>0</sub>}
\real{a=randint(5..20)*random(-1,1)/10}
\real{c3=randint(1..10)*random(-1,1)}
\real{c2=-3*(\c3)*(\a)}
\real{c1=3*(\c3)*(\a)^2}
\real{c0=randint(5..100)*random(-1,1)/10}
\function{f=\c3*x^3+\c2*x^2+\c1*x+\c0}
\text{ft=htmlmath(\f)}
\real{v0=evalue(\f,x=\a)}

\statement{函数 \if: \BR -> \BR 定义为
<p><center>
\if(x)&nbsp;=&nbsp;\ft
</center> <p>
它是双射的, 但存在一个点
\x0&nbsp;<img src=\imagedir/in.gif>&nbsp;\BR
使得逆函数 \if<sup>-1</sup>(x) 在 \x0 上不可微.
求 \x0.
}

\answer{\x0}{\v0}
