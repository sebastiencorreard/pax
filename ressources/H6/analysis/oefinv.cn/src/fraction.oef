\title{分式}
\language{cn}
\range{-2..2}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{100000}

\text{if=<i>f</i>}
\text{ig=<i>g</i>}
\text{BR=<b>R</b>}
\integer{a=random(1,2,4,5)*random(-1,1)}
\integer{c=-random(3..15)*sign(\a)}
\integer{A2=\a*2}
\function{f=\a*x + \c/x}
\integer{r=random(1,2)}
\integer{A=\r=1?random(-5,-4,-2,-1):random(1,2,4,5)}
\integer{B=\r=1?random(-25,-20,-16,-10,-8):random(8,10,16,20,25)}
\integer{a1=min(\B,\A)}
\integer{b1=max(\A,\B)}
\real{A=evalue(\f,x=\a1)}
\real{B=evalue(\f,x=\b1)}
\real{a2=min(\A,\B)}
\real{b2=max(\A,\B)}
\integer{delta=-4*(\a)*(\c)}
\function{inv=\a1*(\a)>0?(x+sqrt(x^2+\delta))/(\A2):
            (x-sqrt(x^2+\delta))/(\A2)}
\text{hf=htmlmath(\f)}

\statement{设 \if: [\a1,\b1] -&gt; [\a2,\b2] 是一个函数, 定义为
<p><center>
\if(x) = \hf .
</center> <p>
验证 \if 是双射的, 并计算其逆函数
\if<sup>-1</sup>:&nbsp;[\a2,\b2]&nbsp;-&gt;&nbsp;[\a1,\b1].
<p>
你可以用 <tt>sqrt(2)</tt> 表示 2 的平方根.
}

\answer{\if<sup>-1</sup>(x)}{\inv}
