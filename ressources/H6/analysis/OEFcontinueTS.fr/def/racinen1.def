!set title=La fonction racine n-ième 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=inequalities

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction	  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:	  <div class="wimscenter"> \(z \leq x < z+1\).</div>
val7=Oui,Non
val8=Comparer les nombres suivants, <strong>sans l'aide d'une calculatrice</strong>&nbsp;
val9=<,>
tmp0=!randint 2, 6

val10=$[rint($(tmp0))]
tmp0=!randint 2, 6

val11=$[rint($(tmp0))]

!ifval $val11=$val10
tmp0=!randitem 1,-1

val11=$[rint($val10+$(tmp0))]
!endif
tmp0=!randint 2, 8

val12=$[rint($(tmp0))]
tmp0=!randint 2, 8

val13=$[rint($(tmp0))]

!ifval $val13=$val12
tmp0=!randitem 1,-1

val13=$[rint($val12+$(tmp0))]
!endif
val14=$val10^(1/$val12),$val11^(1/$val13)	$val11*($val10)^(1/$val12),$val10*($val11)^(1/$val13)	
val15=$val10^{\frac{1}{$val12}},$val11^{\frac{1}{$val13}}	$val11\displaystyle\sqrt[$val12]{$val10},$val10\displaystyle\sqrt[$val13]{$val11}	
tmp=!translate internal $	$ to ; in $val14

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val16=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val19=$[$(val17[1])]
val20=$(val18[1])
val21=$[$(val17[2])]
val22=$(val18[2])

!ifval $val19<$val21
val23=<
!else
val23=>
!endif
replytype1=clickfill
replyname1=comparaison
replygood1=$val23;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

