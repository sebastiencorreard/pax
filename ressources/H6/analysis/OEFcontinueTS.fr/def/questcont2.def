val6=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction	  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:	  <div class="wimscenter"> \(z \leq x < z+1\).</div>
val7=Oui,Non
val8=On considère la fonction \(f\) définie sur,par&nbsp;,	  La fonction \(f\) est-elle continue&nbsp;
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint 1, 10

val14=$[rint($(tmp0))]
val15=$[rint($val14+1)]
tmp0=!randint -10, -2

val16=$[rint($(tmp0))]
val17=$[rint($val16+1)]
tmp0=!randint 20, 30

val18=$[rint($val13+$(tmp0))]
val19=E(x),\(\lbrack $val14;$val15 \rbrack\),2	E(x),\(\rbrack $val14;$val15 \rbrack\),2	E(x),\(\lbrack $val14;$val15 \lbrack\),1	E(x),\(\lbrack $val16;$val17 \rbrack\),2	E(x),\(\rbrack $val16;$val17 \rbrack\),2	E(x),\(\lbrack $val16;$val17 \lbrack\),1	E(x),\(\rbrack \frac{-1}{$val10}; \frac{1}{$val10} \lbrack\),2
tmp=!translate internal $	$ to ; in $val19

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val20=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val19

tmp=!row $val20 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
val22=$(val21[2])
tmp0=!texmath f(x)=$(val21[1])

val23=$(tmp0)
val23=\($val23\)
val24=$[rint($(val21[3]))]
val25=$val6
replytype1=radio
replyname1=
replygood1=$val24;$val7
