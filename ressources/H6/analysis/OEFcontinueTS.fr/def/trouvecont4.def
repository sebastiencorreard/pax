val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction	  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:	  <div class="wimscenter"> \(z \leq x < z+1\).</div>
val7=Oui,Non
val8=On attend des valeurs exactes pour les bornes.
val9=On considère la fonction \(f\) définie par,	  Déterminer le plus grand intervalle contenant,	  sur lequel la fonction \(f\) est continue.
val10=Borne gauche,Borne droite
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

tmp2=!randitem 2,3,5

tmp=!translate ";': to $     $ in $(tmp0)*$(tmp1)/$(tmp2)

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp3)
val11=!exec pari print($t_)
tmp0=!randint 1, 9

tmp1=!randitem 1,-1

tmp2=!randitem 2,3,5

tmp=!translate ";': to $     $ in $(tmp0)*$(tmp1)/$(tmp2)

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp3)
val12=!exec pari print($t_)
tmp0=!randint -5, 5

val13=$[rint($(tmp0))]
val14=$[rint(floor($val11*$val13+$val12))]
tmp=!translate ";': to $     $ in ($val14-$val12)/($val11)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val14+1-$val12)/($val11)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val16=!exec pari print($t_)

!ifval $val15<$val16
t_=!rawmath $val15
val17=!exec pari print($t_)
!else
t_=!rawmath $val16
val17=!exec pari print($t_)
!endif

!ifval $val15<$val16
t_=!rawmath $val16
val18=!exec pari print($t_)
!else
t_=!rawmath $val15
val18=!exec pari print($t_)
!endif
tmp0=!texmath $val11*x+$val12

val19=$(tmp0)
val19=\(f(x)=E($val19))
val20=&#91;
val21=&#93;
val22=$val20,$val21
val23=50x20x1

!ifval $val15<$val16
val24=$val20
!else
val24=$val21
!endif

!ifval $val15<$val16
val25=$val20
!else
val25=$val21
!endif
replytype1=clickfill
replyname1=
replygood1=$val24;$val22
replytype2=numexp
replyname2=$(val10[1])
replygood2=$val17
replytype3=numexp
replyname3=$(val10[2])
replygood3=$val18
replytype4=clickfill
replyname4=
replygood4=$val25;$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

