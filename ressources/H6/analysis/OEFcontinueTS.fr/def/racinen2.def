val9=Puissance,Coeff,Puissance dérivée
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
tmp0=!randint 2, 5

val11=$[rint($(tmp0))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0))]
val13=x\displaystyle\sqrt[$val11]{x},1+1/$val11	x^$val10\displaystyle\sqrt[$val11]{x},$val10+1/$val11	x\displaystyle\sqrt[$val11]{x^$val12},1+$val12/$val11	x^$val10\displaystyle\sqrt[$val11]{x^$val12},$val10+$val12/$val11	\displaystyle\frac{\sqrt[$val11]{x}}{x},-1+1/$val11	\displaystyle\frac{\sqrt[$val11]{x}}{x^$val10},-$val10+1/$val11	\displaystyle\frac{\sqrt[$val11]{x^$val12}}{x},-1+$val12/$val11	\displaystyle\frac{\sqrt[$val11]{x^$val12}}{x^$val10},-$val10+$val12/$val11	\displaystyle\frac{x}{\sqrt[$val11]{x}},1-1/$val11	\displaystyle\frac{x^$val10}{\sqrt[$val11]{x}},$val10-1/$val11	\displaystyle\frac{x}{\sqrt[$val11]{x^$val12}},1-$val12/$val11	\displaystyle\frac{x^$val10}{\sqrt[$val11]{x^$val12}},$val10-$val12/$val11	\frac{1}{x\displaystyle\sqrt[$val11]{x}},-1-1/$val11	\frac{1}{x^$val10\displaystyle\sqrt[$val11]{x}},-$val10-1/$val11	\frac{1}{x\displaystyle\sqrt[$val11]{x^$val12}},-1-$val12/$val11	\frac{1}{x^$val10\displaystyle\sqrt[$val11]{x^$val12}},-$val10-$val12/$val11
