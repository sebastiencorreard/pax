!set title=TVI: Méthode de balayage 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=real_function,continuity

ansorder=r,r,r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction	  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:	  <div class="wimscenter"> \(z \leq x < z+1\).</div>
val7=Oui,Non
val8=croissante, décroissante
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
val10=$(val8[$val9])
tmp0=!randint 3, 10

val11=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val12=$[rint(3*$(tmp0))]
tmp0=!randitem 37,38,50,51,52,63

val13=$[rint($(tmp0))]
t_=!rawmath (($val12)^2-$val13)/4
val14=!exec pari print($t_)
t_=!replace internal \( by ( in expand(($val11*x+1)*(x^2-($val12)*x+($val14)))
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
val16=$[($val12+sqrt($val13))/2]
val17=$[rint(floor($val16))]
val18=$[rint($val17+1)]
evaltmp=$val15

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val19=!exec pari print($t_)
evaltmp=$val15

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val20=!exec pari print($t_)
val21=$[floor(10*$val16)/10]
val22=$[$val21+0.1]
evaltmp=$val15

evaltmp=!mathsubst x=($val21) in $evaltmp
tmp0=($evaltmp)
val23=$[$(tmp0)]
evaltmp=$val15

evaltmp=!mathsubst x=($val22) in $evaltmp
tmp0=($evaltmp)
val24=$[$(tmp0)]
val25=$[floor(100*$val16)/100]
val26=$[$val25+0.01]
tmp0=!texmath $val15

val27=$(tmp0)
oefsteps=r1,r2	r3,r4 
nextstep=!nosubst r1,r2	r3,r4 
!readproc oef/steps.proc
replytype1=numeric
replyname1=borne gauche 1
replygood1=$[$val21]
replytype2=numeric
replyname2=borne droite 1
replygood2=$[$val22]
replytype3=numeric
replyname3=borne gauche 2
replygood3=$[$val25]
replytype4=numeric
replyname4=borne droite 2
replygood4=$[$val26]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  On considère une fonction 
!insmath f
$() définie sur &#91; $val17 ; $val18 &#93; par:	  <div class="wimscenter"> 
!insmath f(x)=$val27
$().</div>	  On constate que 
!insmath f
$() est strictement monotone sur &#91; $val17 ; $val18 &#93; et que:	  <div class="wimscenter"> 
!insmath f($val17) =$val19
$() et 
!insmath f($val18) =$val20
$().</div>	  <p>	  Le théorème des valeurs intermédiaires permet d'affirmer que l'équation 
!insmath f(x)=0
$()	  admet une solution unique, notée 
!insmath \;\alpha
$(), sur l'intervalle &#91; $val17 ; $val18 &#93;.	  </p>	  On désire déterminer la valeur de 
!insmath \alpha\;
$() à 0.01 près par <strong>balayage</strong>.	  
!if $m_step=1 
$()	  <p>	  Faire, à l'aide de la calculatrice, un tableau de valeurs avec un pas de 0.1 sur &#91; $val17; $val18 &#93; de la fonction 
!insmath f
$()	  et déterminer un encadrement à 0.1 près de 
!insmath \alpha\;
$():</p>	  <div class="wimscenter">  
!read oef/embed.phtml reply1,5 
$() 
!insmath < \alpha <
$()  
!read oef/embed.phtml reply2,5 
$().</div>	   
!else
$() 	  <p>	  On a 
!insmath f($val21)=$val23
$() et 
!insmath f($val22)=$val24
$(), donc 
!insmath $val21 < \alpha < $val22
$(). </p>	  <p>Faire, à l'aide de la calculatrice, un tableau de valeurs	  avec un pas de 0.01 sur &#91; $val21; $val22 &#93; de la fonction 
!insmath f
$()	   et déterminer un encadrement à 0.01 près de 
!insmath \alpha\;
$():</p>	  <div class="wimscenter">  
!read oef/embed.phtml reply3,5 
$() 
!insmath < \alpha <
$()  
!read oef/embed.phtml reply4,5 
$().</div>	   
!endif
$()	
$()
!exit

