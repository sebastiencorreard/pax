val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction	  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:	  <div class="wimscenter"> \(z \leq x < z+1\).</div>
val7=Oui,Non
val8=On attend une valeur exacte.
val9=Peut-on trouver une valeur de \(k\) telle que la fonction \(f\) définie sur,	  par,soit continue&nbsp;
val10=La valeur de \(k\) est&nbsp;
val11=si,et
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val15=$[rint($(tmp0)*$(tmp1))]
val16=$[rint(-$val15*$val14)]
tmp=!translate ";': to $     $ in -$val13/$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val17=!exec pari print($t_)

!ifval $val12*$val15+$val13=0
tmp=!translate ";': to $     $ in $val12/$val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
!else
t_=!rawmath $val12*$val15+$val13
val18=!exec pari print($t_)
!endif
val19=$[rint($val12*$val15+$val13)]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val20=$[rint($val19+$(tmp0)*$(tmp1))]
val21=k/($val14*x+$val16),\(x \not = $val15\),$val18,\(\displaystyle{\RR}\),2,$val13	expand(($val12*x+$val13)*($val14*x+$val16))/($val14*x+$val16),\(x \not = $val15\),k,\(\displaystyle{\RR}\),1,$val19	($val14*x+$val16)/(expand(($val12*x+$val13)*($val14*x+$val16))),\(x \not = $val15\),k,\(\RR- \lbrace $val17 \rbrace\),1,1/$val19
tmp=!translate internal $	$ to ; in $val21

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val22=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val21

tmp=!row $val22 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val23=$(tmp0)
val24=$(val23[4])
t_=!replace internal \( by ( in $(val23[1])
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val25=$(tmp1)
t_=!replace internal \( by ( in $(val23[3])
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val26=$(tmp1)
val27=\(f(x)=$val25) $(val11[1]) $(val23[2]) $(val11[2]) \(f($val15)=$val26)

!ifval $val22!=3 or $val19!= 0
val28=$[rint( $(val23[5]))]
!else
val28=$[rint(2)]
!endif
t_=!rawmath $(val23[6])
val29=!exec pari print($t_)

!ifval $val28=2
val30=r1
!else
val30=r1	r2
!endif
oefsteps=$val30 
nextstep=!nosubst $val30 
!readproc oef/steps.proc
replytype1=radio
replyname1=
replygood1=$val28;$val7
replytype2=numexp
replyname2=k
replygood2=$val29
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

