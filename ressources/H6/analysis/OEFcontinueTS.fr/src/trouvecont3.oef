\text{data=k/(\c*x+\d),\(x \not = \x0\),\e,\(\displaystyle{\RR}\),2,\b
expand((\a*x+\b)*(\c*x+\d))/(\c*x+\d),\(x \not = \x0\),k,\(\displaystyle{\RR}\),1,\f
(\c*x+\d)/(expand((\a*x+\b)*(\c*x+\d))),\(x \not = \x0\),k,\(\RR- \lbrace \x1 \rbrace\),1,1/\f}
