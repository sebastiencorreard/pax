E(x),\(\rbrack \bgp;\bgp2 \rbrack\),2
E(x),\(\lbrack \bgp;\bgp2 \lbrack\),1
E(x),\(\lbrack \bgn;\bgn2 \rbrack\),2
E(x),\(\rbrack \bgn;\bgn2 \rbrack\),2
E(x),\(\lbrack \bgn;\bgn2 \lbrack\),1
E(x),\(\rbrack \frac{-1}{\ap}; \frac{1}{\ap} \lbrack\),2}
