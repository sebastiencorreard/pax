\integer{e=\a*\x0+\b-\c*(\x0)^2}
\integer{f=\a*\x0+\b-\c}
\rational{x00=-\x0+\a/\c}
\rational{x01=-(\c-\a*\x1)/\a}

\text{data=\a*x+k,\(x \leq 0),-sin(\a*x),\(x > 0),0
\a*x+\b,\(x \leq \x0),\c*x+k,\(x > \x0),\d
\a*x+k,\(x \leq \x0),\c*x^2+\e,\(x > \x0),\b
\a*x+\b,\(x \leq \x0),\c/(x-\x1)+k,\(x > \x0),\f
}
