\format{html}



\title{TVI: Méthode de dichotomie }

\text{name_rappel=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction
  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:
  <div class="wimscenter"> \(z \leq x < z+1\).</div>}
\text{lstrep=Oui,Non}


\text{sensvar=croissante, décroissante}

\text{name_feed=la valeur proposée ne convient pas car }

\keywords{real_function,continuity}
\integer{sv=randint(1,2)}
\text{sensvarf=\sensvar[\sv]}

\integer{nstep=randint(2..4)}
\real{xmin=randint(10..99)/10}
\real{e=randint(0.1,0.2,0.5)}
\text{precision=\(\e)}
\real{xmax=\xmin+(2^\nstep-1)*\e}
\real{ymin=(-1)^\sv*randint(10..99)/10}
\real{ymax=-(-1)^\sv*randint(10..99)/10}
\real{x1=(\xmin+\xmax)/2}
\real{y1=\sv=1?randint(100*\ymin+10..100*\ymax-10)/100:randint(100*\ymax+10..100*\ymin-10)/100}
\real{y1=\y1=0?0.1}
\real{bg1=\y1*\ymin<0?\xmin:\x1}
\real{bd1=\y1*\ymin<0?\x1:\xmax}
\real{y1min=\y1*\ymin<0?\ymin:\y1}
\real{y1max=\y1*\ymin<0?\y1:\ymax}
\real{x2=(\bg1+\bd1)/2}
\real{y2=\sv=1?randint(1000*\y1min+100..1000*\y1max-100)/1000:randint(1000*\y1max+100..1000*\y1min-100)/1000}
\real{y2=\y2=0?0.01}
\real{bg2=\y2*\y1min<0?\bg1:\x2}
\real{bd2=\y2*\y1min<0?\x2:\bd1}
\real{y2min=\y2*\y1min<0?\y1min:\y2}
\real{y2max=\y2*\y1min<0?\y2:\y1max}
\real{x3=(\bg2+\bd2)/2}
\real{y3=\sv=1?randint(10000*\y2min+1000..10000*\y2max-1000)/10000:randint(10000*\y2max+1000..10000*\y2min-1000)/10000}
\real{y3=\y3=0?0.001}
\real{bg3=\y3*(\y2min)<0?\bg2:\x3}
\real{bd3=\y3*(\y2min)<0?\x3:\bd2}
\real{e1g=}
\real{e1d=}
\real{e2g=}
\real{e2d=}
\real{e3g=}
\real{e3d=}
\if{\nstep=2}
 {\text{mstep=r1
 r2,r3,r10}
  \real{x0=\x2}
 }
\if{\nstep=3}
 {\text{mstep=r1
 r2,r3,r4
 r5,r6,r10}
  \real{x0=\x3}
 }
\if{\nstep=4}
 {\text{mstep=r1
 r2,r3,r4
 r5,r6,r7
 r8,r9,r10}
 \real{x0=(\bg3+(\bd3))/2}
 }
\steps{\mstep}
\statement{
  On considère une fonction \(f) définie sur &#91; \xmin ; \xmax &#93;,
  strictement \sensvarf et telle que:
<div class="wimscenter"> \(f(\xmin) =\ymin) et \(f(\xmax) =\ymax).</div>
<p>
  Le théorème des valeurs intermédiaires permet d'affirmer que l'équation \(f(x)=0)
  admet une solution unique, notée \(\;\alpha\), sur l'intervalle &#91; \xmin ; \xmax &#93;.
</p>
  On désire déterminer la valeur de \(\alpha\;) à \precision près par <strong>dichotomie</strong>.
\if{\step=1}{
  <div>Quelle valeur de \(f) doit-on calculer? On calcule \(f) en
    <label for="reply1">\(x_1=\)</label>\embed{reply1,3}.</div>
 }{
 <p>On donne \(f(\x1)=\y1).</p>
 \if{\step=2}{
   <p>Quel encadrement de \(\alpha\;\) peut-on en déduire?</p>
   <div class="wimscenter"> \embed{reply2,3} \(< \alpha <) \embed{reply3,3}.</div>
   \if{\nstep=2}{
   <div><label for="reply10">En déduire une valeur de \(\alpha\;) à \precision près:</label> \embed{reply10,7}.</div>
    }{
    <div>Quelle valeur de \(f) doit-on calculer? On calcule \(f\) en <label for="reply4">\(x_2=\)</label>
    \embed{reply4,3}.</div>
    }
   }{
    <p>On donne \(f(\x2)=\y2\).</p>
    \if{\step=3}
     {
     <p> Quel encadrement de  \(\alpha\;) peut-on en déduire?</p>
      <div class="wimscenter"> \embed{reply5,3} \(< \alpha <) \embed{reply6,3}.</div>
      \if{\nstep=3}
       {<div><label for="reply10">En déduire une valeur de \(\alpha\;) à \precision près</label>:
       \embed{reply10,7}</div>
       }{
       <div>Quelle valeur de \(f\) doit-on calculer? On calcule \(f\) en
       <label for="reply7">\(x_3\)=</label>\embed{reply7,7}.</div>
       }
     }{
        <p>On donne \(f(\x3)=\y3).</p>
        <p>Quel encadrement de \(\alpha\;) peut-on en déduire?</p>
        <div class="wimscenter"> \embed{reply8,7} \(< \alpha <) \embed{reply9,7}.</div>
        <div><label for="reply10">En déduire une valeur de \(\alpha\;) à \precision près:</label> \embed{reply10,7}.</div>
     }
   }
 }
}
\answer{\(x_1)}{\x1}{type=numexp}
\answer{borne gauche 1}{\bg1}{type=numexp}
\answer{borne droite 1}{\bd1}{type=numexp}
\answer{\(x_2)}{\x2}{type=numexp}
\answer{borne gauche 2}{\bg2}{type=numexp}
\answer{borne droite 2}{\bd2}{type=numexp}
\answer{\(x_3)}{\x3}{type=numexp}
\answer{borne gauche 3}{\bg3}{type=numexp}
\answer{borne droite 3}{\bd3}{type=numexp}
\answer{\(\alpha)}{\rep}{type=numeric}
\real{e1d=\bd1-\rep}
\real{e1g=\rep-\bg1}
\real{e2d=\bd2-\rep}
\real{e2g=\rep-\bg2}
\real{e3d=\bd3-\rep}
\real{e3g=\rep-\bg3}
\condition{(\nstep=2 and \e1d <= \e and \e1g <= \e)
  or (\nstep=3 and \e2d <= \e and \e2g <= \e)
  or (\nstep=4 and \e3d <= \e and \e3g <= \e)}
\feedback{\nstep=2}{
\if{\e1d > \e}{\name_feed \bd1-\rep=\e1d > \e!}
\if{\e1g > \e}{\name_feed \rep-\bg1=\e1g > \e!}
}
\feedback{\nstep=3}{
\if{\e2d > \e}{\name_feed \bd2-\rep=\e2d > \e!}
\if{\e2g > \e}{\name_feed \rep-\bg2=\e2g > \e!}
}
\feedback{\nstep=4}{\name_feed
\if{\e3d > \e}{\name_feed \bd3-\rep=\e3d > \e!}
\if{\e3g > \e}{\name_feed \rep-\bg3=\e3g > \e!}
}

