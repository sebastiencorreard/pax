\title{Rendre une fonction continue 4}

\text{name_rappel=Rappel: la fonction partie entière, notée \(E(x)\), est la fonction
  qui à tout \(x \in \RR\) associe l'entier relatif \(z\) tel que:
  <div class="wimscenter"> \(z \leq x < z+1\).</div>}
\text{lstrep=Oui,Non}


\text{instruct=On attend des valeurs exactes pour les bornes.}
\text{name_enonce=On considère la fonction \(f\) définie par,
  Déterminer le plus grand intervalle contenant,
  sur lequel la fonction \(f\) est continue.}
\text{name_answer=Borne gauche,Borne droite}

\rational{a=simplify(randint(1..9)*randint(1,-1)/randint(2,3,5))}
\rational{b=simplify(randint(1..9)*randint(1,-1)/randint(2,3,5))}
\integer{x0=randint(-5..5)}
\integer{c=floor(\a*\x0+\b)}
\rational{b1=simplify((\c-\b)/(\a))}
\rational{b2=simplify((\c+1-\b)/(\a))}
\rational{bg=\b1<\b2?\b1:\b2}
\rational{bd=\b1<\b2?\b2:\b1}
\text{ft=texmath(\a*x+\b)}
\text{ft=\(f(x)=E(\ft))}
\text{crocg=&#91;}
\text{crocd=&#93;}
\text{lstcroc=\crocg,\crocd}
\text{size=50x20x1}
\text{crg=\b1<\b2?\crocg:\crocd}
\text{crd=\b1<\b2?\crocg:\crocd}
\statement{
  <div class="wims_instruction">\name_rappel</div>
  <p>\name_enonce[1]</p>
  <div class="wimscenter"> \ft. </div>
  <p>\name_enonce[2] \(\x0\) \name_enonce[3]</p>
