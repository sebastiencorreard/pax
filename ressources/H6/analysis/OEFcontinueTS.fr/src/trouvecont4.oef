    \embed{reply3,5} \embed{reply4,\size} </div>
  <div class="wims_instruction">\instruct</div>
}
\answer{}{\crg;\lstcroc}{type=clickfill}
\answer{\name_answer[1]}{\bg}{type=numexp}
