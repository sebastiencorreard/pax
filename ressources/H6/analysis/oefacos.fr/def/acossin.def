!set title=arccos(sin)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=yes
title_en=arccos(sin)

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Écrire,sous la forme,avec \(a\) et \(b\) des nombres rationnels. 
val8=Attention, on demande que \(a\) et \(b\)	  soient des nombres rationnels, ils sont en fait décimaux.	  Vérifier qu'il n'y a alors qu'une seule solution.
!if $val6=en 
val7=Compute,writing it under the form,where \(a\) and \(b\) are rational numbers.
val8=Attention, on demande que \(a\) et \(b\)	  soient des nombres rationnels, ils sont en fait décimaux.	  Vérifier qu'il n'y a alors qu'une seule solution.
!endif
tmp0=!randitem -1,1

tmp1=!random 10, 150

val9=$[$(tmp0)*floor($(tmp1))/10]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of 0,pi/2

val11=$[$(tmp0)]
tmp0=!item $val10 of cos,sin

val12=$(tmp0)
tmp0=!item $val10 of sin,cos

val13=$(tmp0)
val14=$[$val9+$val11]
val15=$[floor($val14/pi)]
val16=$[floor($val15/2)]

!ifval $val15%2=0
val17=$[-$val9]
!else
val17=$[$val9]
!endif
tmp0=!item $val10 of -1.5,-0.5

val18=$[$(tmp0)]

!ifval $val15%2=0
val19=$[2*$val16+0.5]
!else
val19=$[-2*$val16+$val18]
!endif
val20=arc$val13
replyname1=\(a\)
replygood1=$val17
replyname2=\(b\)
replygood2=$val19
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val8


!goto stat

!exit

:question
$()$(val7[1]) 
!insmath x = $val20($val12($val9))
$() $(val7[2])	  
!insmath x = a + b pi
$() $(val7[3])	
$()
!exit

:hint
$()$val8
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,12,20
embedcnt=0
