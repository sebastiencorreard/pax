val7=Choisissez les intervalles les plus pertinents dans les énoncés suivants.
val8=La fonction, est définie sur l'intervalle
val9=Son image est
val10=Intervalle de définition,Image
!endif
val11=&#91;
val12=&#93;
val13=\(-infty)
val14=\(infty)
val15=\(-pi/2)
val16=\(pi/2)
val17=$val11 -1 &#44; 1 $val12
val18=$val12 -1 &#44; 1 $val11
val19=$val11\(-pi) &#44; \(pi)$val12
val20=$val12\(-pi) &#44; \(pi)$val11
val21=$val11 0 &#44; \(pi)$val12
val22=$val12 0 &#44; \(pi)$val11
val23=$val11 0 &#44; 1$val12
val24=$val12 0 &#44; 1$val11
val25=$val12 0 &#44; 1$val12
val26=$val11-1 &#44; 0$val12
val27=$val12-1 &#44; 0$val11
val28=$val11$val15 &#44; $val16$val12
val29=$val12$val15 &#44; $val16$val11
val30=$val11$val13 &#44; $val14$val12
val31=$val12$val13 &#44; $val14$val11
val32=$val11 0 &#44; $val14$val12
val33=$val12 0 &#44; $val14$val11
tmp=!translate internal $	$ to ; in 	arcsin(cos(x)), $val31, $val28	arccos(sin(x)), $val31, $val21	sin(arccos(x)), $val17, $val23	cos(arcsin(x)), $val17, $val23	tan(arcsin(x)), $val18, $val31	sin(arctan(x)), $val31, $val18	cos(arctan(x)), $val31, $val25	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)
val34=!translate internal $	\
$ to ;; in $tmp
val35=$val17,$val18,$val19,$val20,$val21,$val22,$val28,$val29,$val30,$val31,$val23,$val24,$val26,$val27,$val32,$val33,$val25
val36=110x40
replytype1=clickfill
replyname1=$(val10[1])
replygood1=$(val34[2]);$val35
replytype2=clickfill
replyname2=$(val10[2])
replygood2=$(val34[3]);$val35
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

