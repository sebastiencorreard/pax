!set title=Zone composée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Composed range

ansorder=r,r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Considérons la fonction \(f\) définie par,	  Déterminer l'intervalle (maximal) de définition \(I) et l'intervalle d'image \(J) de \(f\).
val8=Pour donner la réponse, soit \(I =\ [a,b]\) (ouvert ou fermé),	  \(J =\ [c,d]\) (ouvert ou fermé). Écrire "<span class="tt">pi</span>",	  "<span class="tt">F</span>" ou "<span class="tt">-F</span>" pour désigner
val9=ou
!if $val6=en 
val7=Consider the function \(f\) defined byr,	  Determine the (maximal) interval of definition \(I) and the image interval \(J) of \(f\).
val8=To give your reply, Let \(I =\ [a,b]\) (open or closed),	  \(J =\ [c,d]\) (open or closed). Write "<span class="tt">pi</span>",	  "<span class="tt">F</span>" or "<span class="tt">-F</span>" to designate 
val9=or
!endif
val10=arccos(cos(x)),arcsin(sin(x)),arccos(sin(x)),arcsin(cos(x)),cos(arccos(x)),	 sin(arcsin(x)),cos(arcsin(x)),sin(arccos(x)),cos(-arcsin(x)),sin(-arccos(x)),	 tg(arctg(x)),arctg(sin(x))
val11=-F,-F,-F,-F,-1, -1,-1,-1,-1,-1,	 -F,-F,
val12=F,F,F,F,1,1,1,1,1,1,	 F,F,
val13=0,-pi/2,0,-pi/2,-1, -1,0,0,0,-1,	 -F,-pi/4,
val14=pi,pi/2,pi,pi/2,1, 1,1,1,1,0,	 F,pi/4,	
tmp0=!itemcnt $val10

tmp1=!randint 1, $(tmp0)

val15=$[rint($(tmp1))]
tmp0=!item $val15 of $val10

val16=$(tmp0)
tmp0=!item $val15 of $val11

val17=$(tmp0)
tmp0=!item $val15 of $val12

val18=$(tmp0)
tmp0=!item $val15 of $val13

val19=$(tmp0)
tmp0=!item $val15 of $val14

val20=$(tmp0)
replyname1=\(a\)
replygood1=$val17,F
replyname2=\(b\)
replygood2=$val18,F
replyname3=\(c\)
replygood3=$val19,F
replyname4=\(d\)
replygood4=$val20,F
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) 
!insmath f(x) = $val16
$(). $(val7[2])	<div class="wims_instruction">	$val8	
!insmath \pi
$(), 
!insmath \infty
$() $val9 
!insmath -\infty
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
