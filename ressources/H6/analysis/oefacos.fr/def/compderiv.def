!set title=Dérivabilité de composée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000
computeanswer=no
title_en=Composed differentiability

ansorder=c
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Oui,Non
val8=La fonction \(f\) définie par, est-elle dérivable dans l'intervalle
val9=Réponse
!if $val6=en 
val7=Yes,No
val8=Is the function \(f\) defined by, differentiable in the interval
val9=Answer
!endif
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
tmp0=!item $val10 of cos,sin,cos,sin

val11=$(tmp0)
tmp0=!item $val10 of cos,cos,sin,sin

val12=$(tmp0)
tmp0=!item $val10 of 0,0,pi/2,pi/2

val13=$[$(tmp0)]
val14=$val7
tmp0=!randint 1, 19

val15=$[rint($(tmp0))]
val16=$[rint($val15+2)]
tmp0=!randitem -1,1

val17=$[rint($(tmp0))]

!ifval $val17<0
val18=$[rint(-$val16)]
!else
val18=$[rint($val15)]
!endif

!ifval $val17<0
val19=$[rint(-$val15)]
!else
val19=$[rint($val16)]
!endif
val20=$[rint(floor(($val18+$val13)/pi))]
val21=$[rint(floor(($val19+$val13)/pi))]

!ifval $val20=$val21
val22=$(val7[1])
!else
val22=$(val7[2])
!endif
choicename1=$val9
choicegood1=$val22
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) 
!insmath f(x) = arc$val11($val12(x))
$() $(val8[2]) [$val18,$val19]?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,11,12,18,19
embedcnt=0
