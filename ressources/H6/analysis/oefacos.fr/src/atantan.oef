\title{arctg(tg)}
\title_en{arctg(tg)}

\text{name_enonce=Écrire,sous la forme,avec \(a\) et \(b\) des nombres rationnels. }
\text{name_hint=Attention, on demande que \(a\) et \(b\)
  soient des nombres rationnels, ils sont en fait décimaux.
  Vérifier qu'il n'y a alors qu'une seule solution.}



\if{\lang=en}{

\text{name_enonce=Compute,writing it under the form,where \(a\) and \(b\) are rational numbers.}
\text{name_hint=Attention, on demande que \(a\) et \(b\)
  soient des nombres rationnels, ils sont en fait décimaux.
  Vérifier qu'il n'y a alors qu'une seule solution.}

}

\computeanswer{yes}
\real{x=random(-1,1)*floor(random(10..150))/10}
\real{r=\x+pi/2}
\real{c=floor(\r/pi)}
\real{a=\x}
\real{b=-(\c)}
\statement{\name_enonce[1] \(x = arctg(tg(\x))\) \name_enonce[2]
\(x = a + b pi\) \name_enonce[3].
}
\answer{\(a\)}{\a}
\answer{\(b\)}{\b}
\hint{\name_hint.}

