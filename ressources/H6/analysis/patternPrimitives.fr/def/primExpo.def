!set title=Fonctions avec exponentielle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, ROYER
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

val6=$[rint($(tmp0))]
tmp0=!randint 1, 4

val7=$[rint($val6*$(tmp0))]
tmp0=!randint 1, 4

val8=$[rint($val6*$(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,3

val10=$[rint($(tmp0))]
tmp0=!randitem 1,-1,-2,2

val11=$[rint($(tmp0))]
val12=$[rint($val11*($val7)^2)]
val13=$[rint($val11*$val8*$val7)]
val14=$[rint(($val7)^2)]
val15=$[rint(2*$val8*$val7)]
val16=$[rint(($val8)^2)]
val17=!rawmath $val9/sqrt($val7*x+$val8),	$val9 sqrt($val7*x+$val8),	$val9/($val7*x+$val8)^$val10,	$val9*x/($val7*x^2+$val8)^$val10,	$val9*($val7*x+$val8)^$val10,	$val9*x($val7*x^2+$val8)^$val10, 	$val9*e^($val7*x+$val8),	($val12*x+$val13)*e^($val14*x^2+$val15*x+$val16)	
tmp0=!randint 7, 8

val18=$[rint($(tmp0))]
tmp0=!item $val18 of $val17

val19=!rawmath $(tmp0)
t_=!rawmath -($val8)/($val7)
val20=!exec pari print($t_)
tmp0=!texmath $val20

val21=$(tmp0)

!ifval $val18<3 and $val6>0
val22= \(\left\rbrack $val21 , +\infty  \right\lbrack\)
!endif

!ifval $val18<3 and $val6<0
val22= \(\left\rbrack-\infty  , $val21 \right\lbrack\)
!endif

!ifval ($val18==3  and $val6>0)
val22=\(\left\rbrack $val21 , +\infty  \right\lbrack\)
!endif

!ifval ($val18==3  and $val6<0)
val22=\(\left\rbrack -\infty  , $val21 \right\lbrack\)
!endif

!ifval $val18>3
val22=\(\mathbb{R}\)
!endif

!ifval $val18>4
t_=!rawmath $val20
val23=!exec pari print($t_)
!endif

!ifval $val18==4
t_=!rawmath 0
val23=!exec pari print($t_)
!endif

!ifval $val18<4
t_=!rawmath (1-$val8)/($val7)
val23=!exec pari print($t_)
!endif
tmp0=!item $val18 of (2*$val9)/($val7),(2*$val9)/(3*$val7), ($val9)/($val7*(1-$val10)),($val9*$val8^(1-$val10))/(2*$val7*(1-$val10)),0,0,($val9)/($val7),($val11)/(2)

t_=!rawmath $(tmp0)
val24=!exec pari print($t_)
t_=!rawmath -$val24
val25=!exec pari print($t_)
tmp0=!texmath $val19

val26=$(tmp0)

!ifval $val18==5
val27=!rawmath ($val9)/($val7*($val10+1))($val7*x+$val8)^($val10+1)
!else
tmp=!translate ;";': to $     $ in $val19,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val27=!rawmath $(tmp0)
!endif

!ifval $val24==0
val28=!rawmath $val27
!else
val28=!rawmath $val27-$val24
!endif
tmp0=!texmath $val28

val29=$(tmp0)
tmp0=!texmath $val27

val30=$(tmp0)
replytype1=formal
replyname1=Valeur de F(x)
replygood1=$val28
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<p>Soit la fonction 
!insmath f
$() définie sur $val22 par  :</p>	<div class="wimscenter">
!insmath f(x) =  $val26 
$()</div>	<p>	La primitive 
!insmath F
$() de  
!insmath f
$() sur  $val22  qui s'annule en 
!insmath $val23
$() est définie par :</p>	<div class="wimscenter"><label for="reply1">
!insmath F(x)
$()</label> =  
!read oef/embed.phtml reply1 , 30 
$()</div>		<div class="wims_instruction">	<b>Consignes de saisie</b>  :	 <span class="tt">a/b</span> pour le rational 
!insmath (a)/(b)
$() ;  	  <span class="tt">sqrt(a)</span> pour le réel 
!insmath \sqrt{a}
$() ; 	  <span class="tt">exp(a)</span> ou <span class="tt">e^a</span> pour le réel 
!insmath e^{a}
$(). 	</div>	
$()
!exit

:hint
$()<span style="color:blue;">On rappelle les formules d'intégration suivantes, dans lesquelles 	
!insmath f
$() désigne une fonction continue sur 
!insmath I
$(),  
!insmath F
$() une de ses primitives sur 
!insmath I
$() et 
!insmath c
$() une constante réelle : </span> 	<ul>	<li>Si 
!insmath  f = u' u^\alpha
$() et 
!insmath \alpha \neq -1
$() &nbsp;alors&nbsp; 
!insmath F = \frac{u^{\alpha+1}}{\alpha+1} + c 
$() 	</li><li>Si 
!insmath  f = \frac{u'}{\sqrt{u}} 
$() &nbsp;alors&nbsp;
!insmath F = 2\sqrt{u} + c 
$() 	</li><li>Si 
!insmath  f = u'e^u 
$() &nbsp;alors&nbsp;
!insmath F = e^u + c 
$() 	</li></ul>
$()
!exit

:help
$()
$()
!exit

:solution
$()<p>Une primitive de la fonction 	
!insmath f : x \mapsto $val26
$() est de la forme 	
!insmath F : x \mapsto $val30 + c
$().</p>	<p>Pour que 
!insmath F
$() s'annule en 
!insmath $val23
$(), il faut : 
!insmath $val24 + c = 0
$() donc 
!insmath c = $val25
$().		On obtient la solution : 
!insmath F : x \mapsto $val29
$().</p>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=22,23,24,25,26,29,30
embedcnt=1
