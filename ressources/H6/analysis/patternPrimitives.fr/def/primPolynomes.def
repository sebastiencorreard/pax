!set title=Fonctions polynômes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Véronique, ROYER
email=royer.veronique@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 4

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randitem -1,0,1

val10=$[rint($(tmp0))]
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]
tmp0=!randint 3, 4

val12=$[rint($(tmp0))]
val13=$[rint($val12+1)]
val14=$[rint(($val6*$val13))]
tmp0=!randint 1, 5

val15=$[rint($(tmp0))]
val16=!rawmath $val6*x+$val8,$val6*x^2+$val8*x+$val7,$val6*(x^3+$val8*x^2+$val7*x+$val9),($val6*x+$val8)^$val12,$val6*($val8-x)^$val12
tmp0=!item $val15 of $val16

val17=!rawmath $(tmp0)

!ifval $val15<4
tmp=!translate ;";': to $     $ in $val17,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val18=!rawmath $(tmp0)
!endif

!ifval $val15==4
val18=!rawmath (($val6*x+$val8)^$val13)/($val14)
!endif
t_=!rawmath -($val6)/($val13)
val19=!exec pari print($t_)

!ifval $val15==5
val18=!rawmath $val19*($val8-x)^$val13
!endif
evaltmp=$val18

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
t_=!rawmath $(tmp0)
val20=!exec pari print($t_)
t_=!rawmath $val11-$val20
val21=!exec pari print($t_)
val22=!rawmath $val18+$val21
tmp0=!texmath $val17

val23=$(tmp0)
tmp0=!texmath $val22

val24=$(tmp0)
tmp0=!texmath $val18

val25=$(tmp0)
replytype1=formal
replyname1=Valeur de F(x)
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()			<p>	Soit la fonction polynôme 
!insmath f
$() définie  par  : 	
!insmath f(x) =  $val23 
$() .	</p>		<p>	La primitive 
!insmath F
$() de  
!insmath f
$() sur  
!insmath \mathbb{R}
$(),  telle 
!insmath F($val10) = $val11
$(), est la fonction définie sur  
!insmath \mathbb{R}
$() par :</p>	<div class="wimscenter">	<label for="reply1">
!insmath F(x)
$()</label> =  
!read oef/embed.phtml reply1 , 30 
$()	</div>		
$()
!exit

:hint
$()	<span style="color:blue;">	
!if $val15<4 
$()Ici, on intégrera 
!insmath f
$() terme à terme 
!else
$() Ici, développer serait bien fastidieux ! Quelle est la dérivée de 	
!insmath x\mapsto (ax+b)^{n+1}
$()?  
!endif
$().</span>	<p><span style="color:blue;">On rappelle les formules d'intégration suivantes, où 	
!insmath u
$() et 
!insmath v
$() désignent des fonctions continues sur un intervalle 
!insmath I
$(), ayant respectivement pour primitives     
!insmath U
$() et 
!insmath V
$() 	sur 
!insmath I
$(), et où 
!insmath c
$() désigne une constante  : </span>	<ul><li>	Si &nbsp;
!insmath  u : x \mapsto  x^n
$()&nbsp; , alors &nbsp;
!insmath U : x \mapsto \frac{x^{n+1}}{n+1} + c
$() <br>	</li><li>Si &nbsp;
!insmath  f = k u  
$()&nbsp; avec 
!insmath k
$()  une constante,  alors 
!insmath f
$() a pour  primitive   &nbsp;
!insmath F  = k U + c
$()   <br/>	</li><li>Si &nbsp;
!insmath  f  = u  + v  
$()&nbsp;, alors 
!insmath f
$() a pour primitive &nbsp;
!insmath F = U + V + c
$() </p>	</li><li>Deux primitives 
!insmath F
$() et 
!insmath G
$() d'une même fonction 
!insmath f
$() sur 
!insmath I
$() diffèrent d'une constante : 	<center>pour tout réel 
!insmath x
$() de 
!insmath I
$(), 
!insmath G(x) - F(x) = c
$() où 
!insmath c
$() est une constante.</center>	</li></ul>	
$()
!exit

:help
$()
$()
!exit

:solution
$()Toute primitive sur 
!insmath I
$() de 
!insmath f
$()	s'écrit &nbsp;
!insmath F : x \rightarrow $val25 + c
$()&nbsp;, où 
!insmath c
$() est une constante.<br/>		Pour 
!insmath x = $val10
$() on a 
!insmath F($val10) = $val20 + c
$(). <br/>	Pour que 
!insmath F($val10) = $val11
$(), il faut donc choisir 
!insmath c = $val11 -$val20 = $val21
$().	<br/>	La solution est  donc  
!insmath F : x \mapsto $val24
$()	.	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,15,20,21,23,24,25
embedcnt=1
