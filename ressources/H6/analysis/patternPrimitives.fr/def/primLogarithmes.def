tmp0=!randitem -1,1

tmp1=!randint 2, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 2, 5

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 2, 5

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem -1,1

tmp1=!randint 2, 5

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val10=$[rint($(tmp0))]
tmp0=!randint 1, 8

val11=$[rint($(tmp0))]
t_=!rawmath ($val7)/($val6)
val12=!exec pari print($t_)
t_=!rawmath ($val12/2)
val13=!exec pari print($t_)
t_=!rawmath $val13*$val8
val14=!exec pari print($t_)
val15=!rawmath $val6*x+$val8
val16=!rawmath $val6*x^2+$val8*x+$val9
val17=$[rint(2*$val6)]
val18=!rawmath $val17*x+$val8
val19=!rawmath $val7*x+$val14
tmp0=!texmath $val19

val20=$(tmp0)
tmp0=!texmath $val6*x+$val8

val21=$(tmp0)
tmp0=!texmath $val6*x^2+$val8*x+$val9

val22=$(tmp0)
tmp0=!texmath $val18

val23=$(tmp0)

!ifval ($val11>4)
val24=$[rint(1)]
!else
tmp0=!randitem -1,1

val24=$[rint($(tmp0))]
!endif

!ifval $val24==1
val25=positive
!else
val25=négative
!endif

!ifval $val24==1
val26=
!else
val26=-
!endif

!ifval $val24==1
val27=!rawmath $val15
!else
val27=!rawmath -$val6*x-$val8
!endif

!ifval $val24==1
val28=!rawmath $val16
!else
val28=!rawmath -$val6*x^2-$val8*x-$val9
!endif
val29=!rawmath $val7/($val15),($val19)/($val16),	$val7 cos($val15)/sin($val15),$val7 sin($val15)/cos($val15),	$val7 ln($val15)/($val15),$val7/(($val15)ln($val15)),	\frac{$val7 e^{$val21}}{e^{$val21}+$val10},\frac{($val20) e^{$val22}}{e^{$val22}+$val10}
val30=!rawmath $val12 ln($val27),$val13 ln($val28),	$val12 ln($val26 sin($val15)), -$val12 ln($val26 cos($val15)),	$val13 ln($val15)^2,$val12 ln($val26 ln($val15)),	$val12 ln(e^($val15)+$val10),$val13 ln(e^($val16)+$val10)
tmp0=!item $val11 of $val29

val31=!rawmath $(tmp0)
tmp0=!item $val11 of $val30

val32=!rawmath $(tmp0)

!ifval $val11<7
tmp0=!item $val11 of $val21,$val22,\sin($val21),\cos($val21),$val21,$val21

val33=$(tmp0)
!endif
tmp0=!texmath $val31

val34=$(tmp0)
tmp0=!texmath $val32

