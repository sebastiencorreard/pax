$()
$()
!exit

:solution
$()	
!if $val11==1 
$()<p>On reconnaît un schéma de dérivée 
!insmath u'\times u 
$()	avec 
!insmath u(x) = $val21
$() et  
!insmath  u'(x) = $val6
$().</p> 
!endif
$()			
!if $val11==2 
$()<p>On reconnaît un schéma de dérivée 
!insmath u'\times u 
$()	avec 
!insmath u(x) = $val22
$() et  
!insmath  u'(x) = $val23
$().</p> 
!endif
$()		
!if $val11==3 
$()<p>On reconnaît un schéma de dérivée 
!insmath u'\times u 
$()	avec 
!insmath u(x) = \sin($val21)
$() et 
!insmath  u'(x) = $val6\cos($val21)
$().</p> 
!endif
$()		
!if $val11==4 
$()<p>On reconnaît un schéma de dérivée 
!insmath u'\times u 
$()	avec 
!insmath u(x) = \cos($val21)
$() et  
!insmath  u'(x) = $val6(-\sin($val21))
$().</p> 
!endif
$()		
!if $val11==5 
$()<p>On reconnaît un schéma de dérivée 
!insmath u'\times u 
$()	avec 
!insmath u(x) = \ln($val21)
$() et  
!insmath  u'(x) = \frac{$val6}{$val21}
$().</p> 
!endif
$()		
!if $val11==6 
$()<p>On reconnaît un schéma de dérivée 
!insmath \frac{u'}{u} 
$()	avec 
!insmath u(x) = \ln($val21)
$() et  
!insmath  u'(x) = \frac{$val6}{$val21}
$().</p> 
!endif
$()		
!if $val11==7 
$()<p>On reconnaît un schéma de dérivée 
!insmath \frac{u'}{u} 
$()	avec 
!insmath u(x) = e^{$val21}+$val10
$() et  
!insmath  u'(x) = $val6*e^{$val21}
$().</p> 
!endif
$()			
!if $val11==8 
$()<p>On reconnaît un schéma de dérivée 
!insmath \frac{u'}{u} 
$()	avec 
!insmath u(x)=e^{$val22}+$val10
$() et 
!insmath  u'(x)= ($val23)\times e^{$val22} 
$().</p> 
!endif
$()		Toute primitive sur 
!insmath I
$() de la fonction 	
!insmath f 
$()	est de la forme 
!insmath F : x \mapsto $val35 + c
$() où 
!insmath c
$() est une constante	réelle quelconque.	
$()
