\title{Fonctions avec logarithme}
\language{fr}
\range{-5..5}
\author{Véronique, ROYER}
\email{royer.veronique@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a=random(-1,1)*random(2..5)}
\integer{c=random(-1,1)*random(2..5)}
\integer{b=random(-1,1)*random(2..5)}
\integer{d=random(-1,1)*random(2..5)}
\integer{j=random(1..5)}

!!!! avec dérivées  logarithmiques 

\integer{cas=random(1..8)}

\rational{k=(\c)/(\a)}
\rational{h=(\k/2)}
\rational{e=\h*\b}
\function{u=\a*x+\b}
\function{v=\a*x^2+\b*x+\d}
\integer{a2=2*\a}
\function{dv=\a2*x+\b}
!! w = h * v' 
\function{w=\c*x+\e}
\text{w1=texmath(\w)}
\text{u1=texmath(\a*x+\b)}
\text{v1=texmath(\a*x^2+\b*x+\d)}
\text{dv1=texmath(\dv)}

\integer{s=(\cas>4)?1:random(-1,1)}
\text{signe=\s==1?positive:négative}
\text{s1=\s==1?:-}
\function{su=\s==1?\u:-\a*x-\b}
\function{sv=\s==1?\v:-\a*x^2-\b*x-\d}


\function{flist=\c/(\u),(\w)/(\v),
\c cos(\u)/sin(\u),\c sin(\u)/cos(\u),
\c ln(\u)/(\u),\c/((\u)ln(\u)),
\frac{\c e^{\u1}}{e^{\u1}+\j},\frac{(\w1) e^{\v1}}{e^{\v1}+\j}}

\function{Flist=\k ln(\su),\h ln(\sv),
\k ln(\s1 sin(\u)), -\k ln(\s1 cos(\u)),
\h ln(\u)^2,\k ln(\s1 ln(\u)),
\k ln(e^(\u)+\j),\h ln(e^(\v)+\j)}

\function{f=item(\cas,\flist)}
\function{F=item(\cas,\Flist)}
condition pour les 6 premières fonctions.
\text{fcu=\cas<7?item(\cas,\u1,\v1,\sin(\u1),\cos(\u1),\u1,\u1)}

\text{f1=texmath(\f)}
\text{F1=texmath(\F)}

\statement{
<p>
Soit la fonction \(f) définie sur un intervalle \(I) par  :</p>
<div class="wimscenter">
\(f(x) =  \f1 ) 
\if{\cas>6}{.}{,}
 \if{\cas<6}{
où la fonction \( x \mapsto \fcu) est strictement \signe 
sur \(I).}
\if{\cas==6}{
où pour tout élément \(x) de \(I)  on a 
\if{\s==1}{\( \fcu > 1)}{\(0 < \fcu < 1) }.}
</div>
<p>
Les primitives \(F) de  \(f) sur  \(I) sont de la forme  :</p>
<div  class="wimscenter">
<label for="reply1">\(F : x \mapsto )</label> \embed{reply1 , 20} + \(c), où \(c) est une constante réelle.
</div>
}

\hint{
<span style="color:blue;">On réécrira \(f) sous la forme \if{cas!=3}{ \(k \frac{u'}{u}) }{ \(k u' u)}
avec \(k) une constante multiplicative réelle.</span>
<p>
On rappelle les formules d'intégration suivantes, où 
\(f) désigne une fonction continue et non nulle sur un intervalle \(I) et  \(F) est une  primitive de \(f) sur \(I)  : </p>
<ul><li>Pour \( u > 0 ) sur \(I) et \( f = \frac{u'}{u} ), on a : \(F = \ln u ) 
</li><li>Pour \( u < 0 ) sur \(I) et \( f = \frac{u'}{u} ), on a : \(F = \ln(-u) ) 
</li></ul>
}

\answer{Valeur de F(x)}{\F}{type=formal}
\solution{
\if{\cas==1}{<p>On reconnaît un schéma de dérivée \(u'\times u )
avec \(u(x) = \u1) et  \( u'(x) = \a).</p>}


\if{\cas==2}{<p>On reconnaît un schéma de dérivée \(u'\times u )
avec \(u(x) = \v1) et  \( u'(x) = \dv1).</p>}

\if{\cas==3}{<p>On reconnaît un schéma de dérivée \(u'\times u )
avec \(u(x) = \sin(\u1)) et \( u'(x) = \a\cos(\u1)).</p>}

\if{\cas==4}{<p>On reconnaît un schéma de dérivée \(u'\times u )
avec \(u(x) = \cos(\u1)) et  \( u'(x) = \a(-\sin(\u1))).</p>}

\if{\cas==5}{<p>On reconnaît un schéma de dérivée \(u'\times u )
avec \(u(x) = \ln(\u1)) et  \( u'(x) = \frac{\a}{\u1}).</p>}

\if{\cas==6}{<p>On reconnaît un schéma de dérivée \(\frac{u'}{u} )
avec \(u(x) = \ln(\u1)) et  \( u'(x) = \frac{\a}{\u1}).</p>}

\if{\cas==7}{<p>On reconnaît un schéma de dérivée \(\frac{u'}{u} )
avec \(u(x) = e^{\u1}+\j) et  \( u'(x) = \a*e^{\u1}).</p>}


\if{\cas==8}{<p>On reconnaît un schéma de dérivée \(\frac{u'}{u} )
avec \(u(x)=e^{\v1}+\j) et \( u'(x)= (\dv1)\times e^{\v1} ).</p>}

Toute primitive sur \(I) de la fonction 
\(f )
est de la forme \(F : x \mapsto \F1 + c) où \(c) est une constante
réelle quelconque.
}
