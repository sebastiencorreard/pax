\title{Fonctions trigonométriques}
\language{fr}
\range{-5..5}
\author{Véronique, ROYER}
\email{royer.veronique@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)*random(1..5)}
\integer{b=random(-1,1)*random(1..4)}
\integer{c=random(-1,1)*random(1..4)}
\integer{n=random(2,3,4)}

\integer{cas=random(1..8)}


\function{flist=\a*cos(\b*x),
\a*sin(\b*x),
\a*cos(\b*x)^2,
\a*sin(\b*x)^2,
\a*cos(\b*x+\c),
\a*sin(\b*x+\c),
\a*sin(\b*x+\c)*cos^\n(\b*x+\c),
\a*cos(\b*x+\c)*sin^\n(\b*x+\c)}

\function{f=item(\cas,\flist)}
\function{g0=int(\f,x)}
\rational{x0=(\cas<5)?0 : -(\c)/(\b)}
\rational{y0=0}
\rational{y0=(\cas isitemof 2,6)?(\a)/(\b)}
\rational{y0=(\cas ==7)?(\a)/((\n+1)*\b)}

\function{g=\y0==0?\g0:\g0+\y0}

\text{f1=texmath(\f)}
\text{g1=texmath(\g)}

\statement{
<p>
Soit la fonction \(f) définie sur \RR par :</p>
<div  class="wimscenter">
\(f(x) =  \f1 )
</div>

<p>
La primitive \(F) de  \(f) sur  \RR  qui s'annule en \(\x0) est définie par :</p>
<div  class="wimscenter">
<label for="reply1">\(F(x))</label> = \embed{reply1 , 30}
</div>


}

\hint{
<p><span style="color:blue;">On rappelle les formules de dérivation suivantes, 
où \(u) est une fonction dérivable sur \(I) :</span>
<ul><li>
\((\cos(u))'=-u'\times \sin(u)) 
</li><li> \((\sin(u))'=u'\times \cos(u))
</li></ul>
<font color=blue>ainsi que les formules de duplication d'angle :</font>

<ul><li>
\(\cos (2a)= \cos^2a-\sin^2a = 2\cos^2a-1 = 1-2\sin^2a) 
</li><li>\(\sin(2a)=2\sin a \cos a)
</li></ul>
}
\answer{Valeur de F(x)}{\g}{type=formal}
\solution{Une  primitive \(F) de la fonction
\(x \rightarrow \f1) 
est de la forme  
\(F : x \mapsto \g0 + c).<br/>
Pour que \(F) s'annule en \(\x0) il faut choisir \(c = \y0).
}
