\title{Fonctions avec exponentielle}
\language{fr}
\range{-5..5}
\author{Véronique, ROYER}
\email{royer.veronique@orange.fr}
\computeanswer{yes}
\format{html}
\precision{10000}



\integer{sa=random(-1,1)}
\integer{a=\sa*random(1..4)}
\integer{b=\sa*random(1..4)}
\integer{c=random(-1,1)*random(1..5)}

\integer{p=random(2,3)}
\integer{s=random(1,-1,-2,2)}
\integer{a1=\s*(\a)^2}
\integer{b1=\s*\b*\a}
\integer{c1=(\a)^2}
\integer{d1=2*\b*\a}
\integer{e1=(\b)^2}

!!!!pas de dérivées  logarithmiques 

\function{flist=\c/sqrt(\a*x+\b),
\c sqrt(\a*x+\b),
\c/(\a*x+\b)^\p,
\c*x/(\a*x^2+\b)^\p,
\c*(\a*x+\b)^\p,
\c*x(\a*x^2+\b)^\p, 
\c*e^(\a*x+\b),
(\a1*x+\b1)*e^(\c1*x^2+\d1*x+\e1)
}

\integer{cas=random(7..8)}

\function{f=item(\cas,\flist)}

!!! x0 tjs negatif
\rational{x0=-(\b)/(\a)}
\text{x0tex=texmath(\x0)}
!!!ensdef

 \text{ensdef=\cas<3 and \sa>0? \(\left\rbrack \x0tex , +\infty  \right\lbrack\)}
\text{ensdef=\cas<3 and \sa<0? \(\left\rbrack-\infty  , \x0tex \right\lbrack\)}
!!! i est choisi tel que ai+b=1 donc i = 1/a + x0 ; choisir ensdef de sorte que i soit dedans
\text{ensdef=(\cas==3  and \sa>0)?\(\left\rbrack \x0tex , +\infty  \right\lbrack\)}
\text{ensdef=(\cas==3  and \sa<0)?\(\left\rbrack -\infty  , \x0tex \right\lbrack\)}
\text{ensdef=\cas>3?\(\mathbb{R}\)}

!!!! si i = x0 alors expression ax+b et consors sont nuls 
!!!! sinon i verifie ai+b=1
\rational{i=\cas>4?\x0}
\rational{i=\cas==4?0}
\rational{i=\cas<4?(1-\b)/(\a)}


!!! j=g0(i)
\rational{j=item(\cas,(2*\c)/(\a),(2*\c)/(3*\a), (\c)/(\a*(1-\p)),(\c*\b^(1-\p))/(2*\a*(1-\p)),0,0,(\c)/(\a),(\s)/(2))}
\rational{j1=-\j}

\text{f1=texmath(\f)}
!!! NB : dans le cas (ax+b)^2 la commande wims \int donne le polynome developpe
\function{g0=\cas==5?(\c)/(\a*(\p+1))(\a*x+\b)^(\p+1):int(\f,x)}

\function{g=\j==0?\g0:\g0-\j}
\text{g1=texmath(\g)}
\text{G0=texmath(\g0)}

\statement{

<p>Soit la fonction \(f) définie sur \ensdef par  :</p>
<div class="wimscenter">\(f(x) =  \f1 )</div>
<p>
La primitive \(F) de  \(f) sur  \ensdef  qui s'annule en \(\i) est définie par :</p>
<div class="wimscenter"><label for="reply1">\(F(x))</label> = \embed{reply1 , 30}</div>

<div class="wims_instruction">
<b>Consignes de saisie</b>  :
 <span class="tt">a/b</span> pour le rational \((a)/(b)) ;  
  <span class="tt">sqrt(a)</span> pour le réel \(\sqrt{a}) ; 
  <span class="tt">exp(a)</span> ou <span class="tt">e^a</span> pour le réel \(e^{a}). 
</div>
}


\hint{<span style="color:blue;">On rappelle les formules d'intégration suivantes, dans lesquelles 
\(f) désigne une fonction continue sur \(I),  \(F) une de ses primitives sur \(I) et \(c) une constante réelle : </span> 
<ul>
<li>Si \( f = u' u^\alpha) et \(\alpha \neq -1) &nbsp;alors&nbsp; \(F = \frac{u^{\alpha+1}}{\alpha+1} + c ) 
</li><li>Si \( f = \frac{u'}{\sqrt{u}} ) &nbsp;alors&nbsp;\(F = 2\sqrt{u} + c ) 
</li><li>Si \( f = u'e^u ) &nbsp;alors&nbsp;\(F = e^u + c ) 
</li></ul>}

\answer{Valeur de F(x)}{\g}{type=formal}

\solution{<p>Une primitive de la fonction 
\(f : x \mapsto \f1) est de la forme 
\(F : x \mapsto \G0 + c).</p>
<p>Pour que \(F) s'annule en \(\i), il faut : \(\j + c = 0) donc \(c = \j1).

On obtient la solution : \(F : x \mapsto \g1).</p>
}
