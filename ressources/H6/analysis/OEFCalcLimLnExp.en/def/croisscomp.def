!set title=Compared growth : basic properties
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Véronique Royer
email=veronique.royer@orange.fr
computeanswer=no
precision=100

ansorder=r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=&#8734;
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]

!ifval $val7!=1
val7=$val7
!else
val7=
!endif
tmp0=!randitem x,t,X,\alpha

val8=$(tmp0)
val9=e^{$val8}
val10=\ln($val8)
val11=$val8^{$val7}
tmp=!trim en \(+\infty)&#44; \($val11) dominates \($val9),2	at \(+\infty)&#44; \($val9) dominates \($val11),1	at \(-\infty)&#44; \($val11) dominates  \($val9),2	at \(-\infty)&#44; \($val9) dominates  \($val11),1	at \(+\infty)&#44; \($val10) dominates  \($val11),2	at \(+\infty)&#44; \($val11) dominates  \($val10),1	as $val8 approaches to 0&#44; \($val10) dominates   \($val11),2	as $val8 approaches to 0&#44; \($val11) dominates  \($val10),1	
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 8

val13=$(tmp0)
tmp0=!item 1 of $val13

val13=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$[rint($(tmp0))]
tmp0=!item $val16 of true,false

val17=$(tmp0)
!if $val16=1 
!else
val13=$[rint($val13+1)]
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val18=$(tmp0)
!endif
tmp=!trim \lim_{$val8\to+\infty} \frac{$val9}{$val11},+inf	\lim_{$val8\to-\infty} $val11 \times $val9,0	\lim_{$val8\to+\infty} \frac{$val10}{$val11},0	\lim_{$val8\to 0} $val11 \times $val10,0
val19=!translate internal $	\
$ to ;; in $tmp
val13=$[rint($val13/2)]
tmp=!translate internal $	$ to ; in $val19

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val20=$(tmp0)
tmp0=!item 2 of $val14

val21=$(tmp0)
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=radio
replyoption1=nonstop 
replyname1=$val15 :
replygood1=$val16;true,false
replytype2=raw
replyoption2=nospace 
replyname2=\($val20 ) :
replygood2=$val21
question=__EXECUTED_1692754_EXERCISE__
help=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="font-family: verdana,  sans-serif ;  font-size: 10pt ; background-color: yellow ;">	<p> 	The exercise deals with the basic rules of "compared growth" between	on one hand  logarithms or exponentials of a given variable and on the other hand	powers of this variable.		</p>	<b> 
!read oef/special.phtml help saisie,Typing hints 
$()</b>	</div>		<ul>	 
!if $m_step=1 
$()<li>The sentence &#171;<b> $val15 </b> &#187;  is:  
!read oef/embed.phtml reply1 
$() </li>	 
!endif
$()		 
!if $m_step>1 
$()<li><font color=blue>The sentence</font> 	&#171;<b> $val15 </b>&#187; <font color=blue> is $val17.</font><br/>	 
!if $val16=2 
$()<font color=blue>The true sentence is: </font>&#171;<b> $val18 </b>&#187;. 
!endif
$()	</li>	 
!endif
$()		 
!if $m_step=2 
$()<li>	Formally,  this means that:  
!insmath $val20 
$() =  
!read oef/embed.phtml reply2,5 
$()	</li>	 
!endif
$()		</ul>	
$()
!exit

