val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!randint 1, 5

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val7=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 8

val8=$[rint($(tmp0)*$(tmp1))]
val9=$val8

!ifval $val8=-1
val9=-
!endif

!ifval $val8=1
val9=
!endif
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
t_=!rawmath -$val7/$val6
val11=!exec pari print($t_)
val12=&#8734;

!ifval $val6>0
val13=+
!else
val13=-
!endif

!ifval ($val13 issametext +)
val14=$[rint(1)]
!else
val14=$[rint(-1)]
!endif
val15=$val13$val12
val16=$val13\infty

!ifval $val6>0
val17= &#93;  $val11 ; $val15 &#91; 
!endif

!ifval $val6>0
val18=from above
!else
val18=from below
!endif

!ifval $val6>0
val19=>
!else
val19=<
!endif

!ifval $val6<0
val17= &#93;$val15 ; $val11 &#91; 
!endif
tmp0=!randitem 1,2

val20=$[rint($(tmp0))]
tmp0=!item $val20 of $val11,$val15

val21=$(tmp0)
tmp0=!item $val20 of $val11,$val16

val22=$(tmp0)
t_=!replace internal \( by ( in expand($val6*x + $val7)
tmp0=!exec maxima $t_

val23=!rawmath $(tmp0)
tmp0=!texmath $val23

val23=$(tmp0)
val24=\ln(t)
val25=\ln(u)
val26=\ln(u(x))
val27=!rawmath \ln($val23)
tmp0=!item $val10 of $val9 $val27, \frac{$val8}{$val27}

val28=$(tmp0)
tmp0=!item $val10 of  k $val25, \frac{k}{$val25}

val29=$(tmp0)
tmp0=!texmath $val28

val30=$(tmp0)
!if $val20=1 
val31=0,0
!else
val31=+inf,+\infty
!endif
tmp0=!item 1 of $val31

val32=$(tmp0)
tmp0=!item 2 of $val31

val33=$(tmp0)
!if $val20=1 
val34=\begin{array}{l}x\to $val11\\x $val19$val11\end{array}
val35=\begin{array}{l}t\to 0\\t > 0\end{array}
!else
val34=x\to $val22
val35=t\to $val33
!endif

!ifval $val32 issametext 0
val36=-inf,-\infty
!else
val36=+inf,+\infty
!endif
val37=0
val38=0

!ifval $val32 issametext 0
val39=+inf
!else
val39=-inf
!endif
tmp0=!item 1 of $val36

val40=$(tmp0)
tmp0=!item 2 of $val36

val41=$(tmp0)
val42=$val40
val43=$val41
!if $val10=1 

!ifval $val8>0
val44=$val42
!else
val44=$val39
!endif
!else

!ifval $val8>0
val44=$val37
!else
val44=$val38
!endif
!endif
