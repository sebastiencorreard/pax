\title{Compared growth : basic properties}
\language{fr}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{inf=&#8734;}
\integer{n=random(1..3)}
\text{n=\n!=1?\n:}
\text{x=random(x,t,X,\alpha)}
\text{ex=e^{\x}}
\text{lnx=\ln(\x)}
\text{powx=\x^{\n}}
\** faux=2 // vrai = 1 **\
\matrix{mataff=en \(+\infty)&#44; \(\powx) dominates \(\ex),2
at \(+\infty)&#44; \(\ex) dominates \(\powx),1
at \(-\infty)&#44; \(\powx) dominates  \(\ex),2
at \(-\infty)&#44; \(\ex) dominates  \(\powx),1
at \(+\infty)&#44; \(\lnx) dominates  \(\powx),2
at \(+\infty)&#44; \(\powx) dominates  \(\lnx),1
as \x approaches to 0&#44; \(\lnx) dominates   \(\powx),2
as \x approaches to 0&#44; \(\powx) dominates  \(\lnx),1
}
\text{tmp=shuffle(8)}
\integer{tmp=item(1,\tmp)}
\text{row=row(\tmp,\mataff)}
\text{laff=item(1,\row)}
\integer{rep1=item(2,\row)}
\text{sol1=item(\rep1,true,false)}
\if{\rep1=1}
{taff=\laff}
{\integer{tmp=\tmp+1}
 \text{row=row(\tmp,\mataff)}
 \text{taff=item(1,\row)} }
\matrix{leslim=
\lim_{\x\to+\infty} \frac{\ex}{\powx},+inf
\lim_{\x\to-\infty} \powx \times \ex,0
\lim_{\x\to+\infty} \frac{\lnx}{\powx},0
\lim_{\x\to 0} \powx \times \lnx,0}
\integer{tmp=\tmp/2}
\text{row=row(\tmp,\leslim)}
\text{lalim=item(1,\row)}
\text{rep2=item(2,\row)}

\steps{reply1
reply2}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 10pt ; background-color: yellow ;">
<p> 
The exercise deals with the basic rules of "compared growth" between
on one hand  logarithms or exponentials of a given variable and on the other hand
powers of this variable.

</p>
<b>\special{help saisie,Typing hints}</b>
</div>

<ul>
\if{\step=1}
{<li>The sentence &#171;<b> \laff </b> &#187;  is: \embed{reply1} </li>
}

\if{\step>1}
{<li><font color=blue>The sentence</font> 
&#171;<b> \laff </b>&#187; <font color=blue> is \sol1.</font><br/>
\if{\rep1=2}
{<font color=blue>The true sentence is: </font>&#171;<b> \taff </b>&#187;.}
</li>
}

\if{\step=2}
{<li>
Formally,  this means that:  \(\lalim ) = \embed{reply2,5}
</li>
}

</ul>
}

\answer{\laff : }{\rep1;true,false}{type=radio}{option=nonstop}
\answer{\(\lalim ) :}{\rep2}{type=raw}{option=nospace}

\help{
 \if{\help_subject issametext saisie}{
<b>Typing hints:</b><br/>
type <b>+inf</b> for \(+\infty)  ;<br> type  <b>-inf</b> for \(-\infty). 
   }
}
