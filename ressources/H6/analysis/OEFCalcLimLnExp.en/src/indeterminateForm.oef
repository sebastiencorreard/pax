\title{Indeterminate forms with ln or exp}
\language{fr}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..5)}
\integer{b = random(-8..8)}
\integer{c= random(-1,1)*random(1..5)}
\integer{d = random(-8..8)}
\text{sk=random(-,+)}
\integer{op=random(1..4)}


\function{u=maxima(expand(\a*x + \b))}
\function{v=maxima(expand(\c*x + \d))}
\text{u=texmath(\u)}
\text{v=texmath(\v)}
\integer{cas=random(1,2)}
\text{g=\cas=1?e^{t}:\ln(t)}
\text{gg=\cas=1?e^{u}:\ln(u)}
\text{ggx=\cas=1?e^{u(x)}:\ln(u(x))}
\function{gdeu=\cas=1?e^{\u}:\ln(\u)}
\text{f=item(\op,\v \sk  \gdeu,(\v)\times \gdeu, \frac{\v}{\gdeu},\frac{\gdeu}{\v})}
\text{ff=item(\op,v \sk  \gg, v \times \gg, \frac{v}{\gg},\frac{\gg}{v})}
\text{tf=texmath(\f)}
\rational{x0=-\b/\a}
\text{inf=&#8734;}
\text{sx=\cas=1?random(-,+)}
\text{sx=\cas=2 and \a>0?+}
\text{sx=\cas=2 and \a<0?-}
\integer{ssx=(\sx issametext +)?1:-1}
\text{xlim=\sx\inf}
\text{texlim=\sx\infty}
\text{ensdef=\cas=2 and \a>0?&#93;  \x0 ; \xlim &#91;}
\text{ensdef=\cas=2 and \a<0? &#93;\xlim ; \x0 &#91; }
\text{ensdef=\cas=1?\RR}
\text{vlim=(\c*\ssx)>0?+inf,+\infty,1:-inf,-\infty,-1}
\text{rep1=item(1,\vlim)}
\text{sol1=item(2,\vlim)}
\text{ulim=(\a*\ssx)>0?+inf,+\infty:-inf,-\infty}
\text{rep2=item(1,\ulim)}
\text{sol2=item(2,\ulim)}
\text{glim=\cas=1 and \rep2 issametext -inf?0,0,0:+inf,+\infty,1}
\text{rep3=item(1,\glim)}
\text{sol3=item(2,\glim)}
\text{rep4=\rep3}
\text{sol4=\sol3}
\text{\typeindet=Yes because there is no indeterminate form,
No because there is an indeterminate form  0 x \inf, 
No because there is an indeterminate form  0 / 0,
No because there is an indeterminate form \inf / \inf ,
No because there is an indeterminate form -\inf + (+\inf)
}
\text{\fi=, 0 x \inf,  0 / 0, \inf / \inf , -\inf + (+\inf)}
\integer{tmp=item(3,\vlim)}
\integer{tmp2=item(3,\glim)}
\integer{tmp2=\tmp*\tmp2}
\text{rep5=1}
\text{rep5=\op=1 and \sk issametext + and \tmp2<0?5}
\text{rep5=\op=1 and \sk issametext - and \tmp2>0?5}
\text{rep5=\op=2 and \tmp2=0?2}
\text{rep5=\op>2 and \tmp2!=0?4}
\text{lafi=item(\rep5,\fi)}
\if{\op=4}{\text{rep6=\tmp=1?+inf:-inf}}
\matrix{filims=\rep4,\rep1
\rep4,\rep1
0,\rep1
\rep6,0}
\if{\rep5=1}
{\text{sol6=\op!=4?\rep1:0}}
{\text{tmp=row(\op,\filims)}
 \text{sol6=item(\cas,\tmp)}
}
\steps{reply1
reply2
reply3
reply4
reply5
reply6}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
Let \(f) be the function  defined over \(\ensdef) by:
\(f(x) = \f).
</p><p>
So we have \(f = \ff )  where, for any real \(x) in \(\ensdef), 
\(u(x) = \u)  &nbsp; and  &nbsp; \(v(x) = \v).
</p><p> 
The aim of the exercise is to evaluate step by step the limit of \(f) at \xlim.
</p>
<small><b>\special{help saisie,Typing hints}</b></small>
</div>

<ul>



\if{\step=1}
{<li>Evaluate the limit of \(v) at \xlim : 
<center>\(\lim_{x\to\texlim} \v ) = \embed{reply1,5}</center>
</li>}
\if{\step>1}
{<li><font color = blue> The limit of  \(v) at \xlim is</font>:  
<center>\(\lim_{x\to\texlim} v(x) = \lim_{x\to\texlim} \v  = \sol1)</center>
</li>
}


\if{\step=2}
{<li>Evaluate the limit of  \(u) at \xlim : 
<center>\(\lim_{x\to\texlim} \u ) = \embed{reply2,5}</center>
</li>
}
\if{\step>2}
{<li><font color = blue> The limit of   \(u) at \xlim  is</font>:  
<center>\(\lim_{x\to\texlim} u(x) = \lim_{x\to\texlim} \u  = \sol2)</center>
</li>
}


\if{\step=3}
{<li>Evaluate the limit of \(\g) at \(\sol2) : 
<center>\(\lim_{t\to\sol2} \g ) = \embed{reply3,5}</center>
</li>
}


\if{\step=4}
{<li>By variable renaming \(t = \u), knowing that\(\lim_{t\to\sol2} \g  = \sol3), it comes that: 
<center>\( \lim_{x\to\texlim} \gdeu ) = \embed{reply4,5}</center>
</li> 
}
\if{\step>4}
{<li>
<font color = blue>The limit of \(\gg) at \xlim is</font>:
<center>\(\lim_{x\to\texlim} \ggx =\lim_{x\to\texlim} \gdeu  = \lim_{t\to\sol2} \g = \sol4). </center> 
</li>
}

\if{\step=5}
{<li> Can we deduce the limit at \xlim  of \(f = \ff) by applying the computational rules of limits ? 
<center>\embed{reply5,size=5}</center> 
</li>
}

\if{\step=6}
{<li><font color=blue>
\if{\rep5=1}{
The computational rules of limits are valid, because there is no indeterminate form.</font> }
{The computational rules of limits are <b>not</b> valid, because there is an indeterminate form \lafi .
</font> <br/> We use instead the properties of "compared growth":
<i>\if{\cas=1}{the exponential function dominates any polynom function}{any polynom function dominates the logarithm function}.</i>
.}
<br/>
Then it comes:
<center>\(\lim_{x\to\texlim} f(x)) = \embed{reply6,5} </center>
</li>} 

</ul>
}

\answer{limite de v : }{\rep1}{type=raw}{option=nospace,nonstop}
\answer{limite de u : }{\rep2}{type=raw}{option=nospace,nonstop}
\answer{limite de \(\g) : }{\rep3}{type=raw}{option=nospace,nonstop}
\answer{limite de \(\gg) : }{\rep4}{type=raw}{option=nospace,nonstop}
\answer{forme indéterminée :}{\rep5;\typeindet}{type=select}{option=nonstop}
\answer{limite de f : }{\sol6}{type=raw}{option=nospace}



\solution{ }

\help{
  
 \if{\help_subject issametext saisie}{
<b>Typing hints:</b><br/>
type <b>+inf</b> for \(+\infty)  ;<br/> type  <b>-inf</b> for \(-\infty). 
   }
}
