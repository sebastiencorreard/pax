\title{Limit of  k.ln(ax+b) or k/ln(ax+b)}
\language{fr}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..5)}
\integer{b = random(-8..8)}
\integer{k=random(-1,1)*random(1..8)}
\text{tk=\k}
\text{tk=\k=-1?-}
\text{tk=\k=1?}
\integer{op=random(1,2)}
\rational{x0=-\b/\a}
\text{inf=&#8734;}
\text{sx=\a>0?+:-}
\integer{ssx=(\sx issametext +)?1:-1}
\text{xinf=\sx\inf}
\text{texinf=\sx\infty}
\text{ensdef=\a>0? &#93;  \x0 ; \xinf &#91; }
\text{natlim=\a>0?from above:from below}
\text{ineg=\a>0?>:<}
\text{ensdef=\a<0? &#93;\xinf ; \x0 &#91; }
\integer{cas=random(1,2)}
\text{xlim=item(\cas,\x0,\xinf)}
\text{texlim=item(\cas,\x0,\texinf)}
\function{u=maxima(expand(\a*x + \b))}
\text{u=texmath(\u)}
\text{g=\ln(t)}
\text{gg=\ln(u)}
\text{ggx=\ln(u(x))}
\function{lnu=\ln(\u)}
\text{f=item(\op,\tk \lnu, \frac{\k}{\lnu})}
\text{ff=item(\op, k \gg, \frac{k}{\gg})}
\text{tf=texmath(\f)}
\if{\cas=1}{\text{ulim=0,0}}
{\text{ulim=+inf,+\infty}}
\text{rep3=item(1,\ulim)}
\text{sol3=item(2,\ulim)}
\if{\cas=1}
{\text{xtol=\begin{array}{l}x\to \x0\\x \ineg\x0\end{array}}
 \text{ttol=\begin{array}{l}t\to 0\\t > 0\end{array}}}
{\text{xtol=x\to \texlim}
 \text{ttol=t\to \sol3}}
\text{glim=\rep3 issametext 0?-inf,-\infty:+inf,+\infty}
\text{invlim=0}
\text{neginvlim=0}
\text{neglim=\rep3 issametext 0?+inf:-inf}
\text{rep4=item(1,\glim)}
\text{sol4=item(2,\glim)}
\text{rep5=\rep4}
\text{sol5=\sol4}
\if{\op=1}
{\text{rep6=\k>0?\rep5:\neglim}}
{\text{rep6=\k>0?\invlim:\neginvlim}}

\steps{reply1,reply2
reply3
reply4
reply5
reply6}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
Let \(f) be the function defined over \(\ensdef) by: \(f(x) = \tf ).
</p><p> 
The aim of the exercise is to evaluate step by step the limit of  \(f) at \xlim 
\if{\cas=1}{\natlim}.
</p>
<small><b>\special{help saisie,Typing hints}</b></small>
</div>

<ul>


\if{\step=1}
{
<li>The function  \(f) is of the form \(\ff) with:
<center>\(u(x)) = \embed{reply1,5} and  \(k) = \embed{reply2,5} </center>
</li>
}
\if{\step>1}
{<li><font color = blue> The function  \(f) is of the form  \(\ff) with
\(u(x) = \u ) and \(k = \k).</font> 
</li>
}


\if{\step=2}
{
<li>Evaluate the limit of \(u) at \xlim : <small>(\special{help saisie,typing hints})</small>
<center>\(\lim_{\xtol} \u ) = \embed{reply3,5}</center>
</li>
}
\if{\step>2}
{<li><font color = blue> The limit of \(u) at \xlim  is</font>:  
<center>\(\lim_{\xtol} u(x) = \lim_{\xtol} \u  = \sol3)</center>
</li>
}

\if{\step=3}
{<li>Evaluate the limit of \(\g) ar \(\sol3): <small>(\special{help saisie,typing hints})</small>
<center>\(\lim_{\ttol} \g ) = \embed{reply4,5}</center>
</li>
}

\if{\step>3}
{<li><font color = blue>From the properties of the logarithm function, we know that</font>:  
<center>\(\lim_{\ttol} \g   = \sol4)</center>
</li>
}


\if{\step=4}
{<li>By variable renaming \(t = u(x)) and by composition of limits, it comes that: <small>(\special{help saisie,typing hints})</small>
<center>\( \lim_{\xtol} \ggx   =  \lim_{\xtol} \lnu ) = \embed{reply5,5}</center>
</li> 
}

\if{\step>4}
{<li><font color = blue>By composition, the limit of \(\gg) at \xlim is</font>:
<center>
\(\lim_{\xtol} \ggx  =  \lim_{\xtol} \lnu  = \lim_{\ttol} \g = \sol5).
</center> 
</li> 
}

\if{\step=5}
{<li>Eventually, by the computational rules of the limits, it comes that: <small>(\special{help saisie,Typing hints})</small>
<center>\( \lim_{\xtol} \f)   = \embed{reply6,5}</center>
</li> 
}

</ul>
}
\answer{exposant u(x)}{\u}{type=formal}{option=nonstop}
\answer{coefficient k}{\k}{type=numeric}{option=nonstop}
\answer{limite de u = }{\rep3}{type=raw}{option=nospace,nonstop}
\answer{limite de \(\g) = }{\rep4}{type=raw}{option=nospace,nonstop}
\answer{limite de \(\gg) = }{\rep5}{type=raw}{option=nospace,nonstop}
\answer{limite de \(f) = }{\rep6}{type=raw}


\solution{ }

\help{
  
 \if{\help_subject issametext saisie}{
<b>Typing hints :</b><br/>
type <b>+inf</b> for \(+\infty)  ;<br/> type  <b>-inf</b> for \(-\infty). 
}
}
