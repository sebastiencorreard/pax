    wims(sort reverse numeric items \yl)}
 \text{ymiddles=\ymiddles\yl;}
}

\text{xmiddles=\vx[1,2];\vx[4,5];\vx[7,8];\vx[10,11]}
\text{xs=-\infty, \vx[3,6,9], +\infty}
\text{xshow=wims(makelist \(x) for x in \xs)}
\text{yshow=wims(makelist \(x) for x in \ys)}
\text{arrowlen=1}



\text{leftbrack=&#91;}
\text{rightbrack=&#93;}
\text{empty=}

\text{bsize=20x30x1}
