:postdef
tmp0=!replace internal \ by in $val42

val44=$(tmp0)
tmp0=!replace internal \ by in $val43

val45=$(tmp0)
val41=
tmp0=!positionof item $val42 in $val36

val46=$(tmp0)
tmp0=!positionof item $val43 in $val36

val47=$(tmp0)
!if $val44<$val45 
val48=$val46
val49=$val47
!else
val48=$val47
val49=$val46
!endif
val50=$(val37[$val48])
val51=$(val37[$val49])
tmp0=!itemcnt $val46

tmp1=!itemcnt $val47


!ifval $(tmp0)=1 and $(tmp1)=1 and $val44<$val45 and	      $val50=$val51
val40=1
!else
val40=0
!endif

!ifval $val40>0 and $m_step=2
val41=r3
