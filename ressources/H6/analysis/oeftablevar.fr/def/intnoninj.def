!ifval $(tmp0)>8
val20=+\infty
!else
val20=$(val17[1])
!endif
tmp0=!random 0, 10


!ifval $(tmp0)>8
val21=+\infty
!else
val21=$(val17[3])
!endif
val22=$val20,$(val16[1]),$(val17[2]),$(val16[2]),$val21
val23=top,bottom,top,bottom,top
!endif
