val10=$val10,	ln(2),ln(3),ln(4),ln(5),ln(8),ln(10),ln(15),ln(20),ln(30),ln(50)	
!endif

!ifval exp isitemof $val2
val10=$val10,	2^e,3^e,2^pi,3^pi,pi^e,e^pi,pi^pi,e^e,	4^e,5^e,2^-e,2^-pi,pi^-e,e^-pi	
!endif
tmp0=!makelist -x for x in $val10

val10=$(tmp0),0,$val10
tmp0=!sort numeric items $val10

val10=$(tmp0)
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]
val12=$[rint(4)]
