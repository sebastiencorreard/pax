val24=$(tmp0)
val25=
!for val26 =1 to 4 
val27=
!for val28  in $val10 
!if $val28>min($(val24[$val26]),$(val24[$val26+1])) and $val28<max($(val24[$val26]),$(val24[$val26+1])) 
tmp0=!append item $val28 to $val27

val27=$(tmp0)
!endif
!next
