val32=$(tmp0)
val33=1
val34=&#91;
val35=&#93;
val36=
val37=70x40x1
tmp0=!randitem 1,2,3

val13=$[rint($(tmp0))]
val13=$val13,$val13+1
val38=$(val13[1]),$(val13[1]),$(val13[2]),$(val13[2])
val39=$(val29[$(val13[1]);]),$(val29[$(val13[2]);])
