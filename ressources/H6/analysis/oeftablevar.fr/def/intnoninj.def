tmp1=!item 1 to 11 of $(tmp0)

tmp2=!sort numeric items $(tmp1)

val13=$(tmp2)
tmp0=!item $val13 of $val10

val14=$(tmp0)
tmp0=!randint $val11/4, $val11*3/4

val15=$[rint($(tmp0))]
tmp0=!item 3 to $val15-3 of $val10

tmp1=!shuffle $(tmp0)

val16=$(tmp1)
tmp0=!item $val15+3 to $val11-2 of $val10

tmp1=!shuffle $(tmp0)

val17=$(tmp1)
tmp0=!randitem 1,2

val18=$[rint($(tmp0))]
!if $val18=1 
val19=ne,se,ne,se
tmp0=!random 0, 10


!ifval $(tmp0)>8
val20=-\infty
!else
val20=$(val16[1])
!endif
tmp0=!random 0, 10


!ifval $(tmp0)>8
val21=-\infty
!else
val21=$(val16[3])
!endif
val22=$val20,$(val17[1]),$(val16[2]),$(val17[2]),$val21
