val39=$(tmp0)
val40=$(val22[$(val13[1])+1])
tmp0=!randitem 1,2

val41=$(val25[$(val13[1]);$(tmp0)])
tmp0=!randitem 1,2

val42=$(val25[$(val13[2]);$(tmp0)])
val43=$val7
tmp0=!itemcnt $val43

val44=$[rint($(tmp0))]
tmp0=!shuffle $val44

val13=$(tmp0)
val43=$(val43[$val13])
tmp0=!positionof item 1 in $val13

