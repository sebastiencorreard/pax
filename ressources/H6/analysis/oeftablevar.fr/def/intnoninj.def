tmp1=!item 1 to 2 of $(tmp0)

val27=$(tmp1)

!ifval $(val19[$val26]) issametext ne
tmp0=!sort numeric items $val27

val27=	    $(tmp0)
!else
tmp1=!sort reverse numeric items $val27

val27=	    $(tmp1)
!endif
val25=$val25$val27;
!next
