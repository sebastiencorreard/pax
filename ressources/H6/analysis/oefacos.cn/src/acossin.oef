\title{arccos(sin)}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ia=<i>a</i>}
\text{ib=<i>b</i>}
\real{x=random(-1,1)*floor(random(10..150))/10}
\integer{ra=random(1,2)}
\real{add=item(\ra,0,pi/2)}
\text{cos=item(\ra,cos,sin)}
\text{sin=item(\ra,sin,cos)}
\real{r=\x+\add}
\real{c=floor(\r/pi)}
\real{d=floor(\c/2)}
\real{a=\c%2=0?-\x:\x}
\real{e2=item(\ra,-1.5,-0.5)}
\real{b=\c%2=0?2*\d+0.5:-2*\d+\e2}

\statement{计算 x=arc\sin(\cos(\x)), 把它写成
x=\ia+\ib<img src=\imagedir/pi.gif> 的形式, 其中 \ia 和 \ib
是有理数.
}

\answer{\ia}{\a}
\answer{\ib}{\b}
