\title{线性 arccos(cos)}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ia=<i>a</i>}
\text{ib=<i>b</i>}
\text{if=<i>f</i>}
\text{ix=x}
\real{x=random(-1,1)*random(2..15)}
\integer{ra=random(1,2)}
\real{add=item(\ra,0,pi/2)}
\text{cos=item(\ra,cos,sin)}
\real{r=\x+\add}
\real{c=floor(\r/pi)}
\real{d=floor(\c/2)}
\real{a=\c%2=0?1:-1}
\integer{e=item(\ra,2,1)}
\real{b=\c%2=0?-2*\d:2*\d+\e}
\integer{next=floor((\r+1)/pi)}
\integer{x=floor(\x)}
\integer{a1=\next=\c?\x:\x-1}
\integer{a2=\next=\c?\x+1:\x}
\function{bpi=\b*pi}

\statement{对于区间 [\a1,\a2] 里的 x, 
可以把函数 \if(x)=arc\cos(\cos(x)) 简化成形如
\ia\ix + \ib 的线性函数. 问这个线性函数是怎样的?
}

\answer{\ia}{\a}
\answer{\ib}{\bpi}
