\title{arctg(tg)}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ia=<i>a</i>}
\text{ib=<i>b</i>}
\real{x=random(-1,1)*floor(random(10..150))/10}
\real{r=\x+pi/2}
\real{c=floor(\r/pi)}
\real{a=\x}
\real{b=-(\c)}

\statement{计算 x=arctg(tg(\x)), 把它写成
x=\ia+\ib<img src=\imagedir/pi.gif> 的形式, 其中 \ia 和 \ib
是有理数.
}

\answer{\ia}{\a}
\answer{\ib}{\b}
