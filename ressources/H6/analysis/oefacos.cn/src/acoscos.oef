\title{arccos(cos)}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ia=<i>a</i>}
\text{ib=<i>b</i>}
\real{x=random(-1,1)*floor(random(10..150))/10}
\integer{ra=random(1,2)}
\real{add=item(\ra,0,pi/2)}
\text{cos=item(\ra,cos,sin)}
\real{r=\x+\add}
\real{c=floor(\r/pi)}
\real{d=floor(\c/2)}
\real{a=\c%2=0?\x:-\x}
\integer{e=item(\ra,2,1)}
\real{b=\c%2=0?-2*\d:2*\d+\e}

\statement{计算 x=arc\cos(\cos(\x)), 把它写成
x=\ia+\ib<img src=\imagedir/pi.gif> 的形式, 其中 \ia 和 \ib
是有理数.
}

\answer{\ia}{\a}
\answer{\ib}{\b}
