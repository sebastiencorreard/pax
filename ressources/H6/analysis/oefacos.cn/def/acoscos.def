!set title=arccos(cos)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>a</i>
val7=<i>b</i>
tmp0=!randitem -1,1

tmp1=!random 10, 150

val8=$[$(tmp0)*floor($(tmp1))/10]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 0,pi/2

val10=$[$(tmp0)]
tmp0=!item $val9 of cos,sin

val11=$(tmp0)
val12=$[$val8+$val10]
val13=$[floor($val12/pi)]
val14=$[floor($val13/2)]

!ifval $val13%2=0
val15=$[$val8]
!else
val15=$[-$val8]
!endif
tmp0=!item $val9 of 2,1

val16=$[rint($(tmp0))]

!ifval $val13%2=0
val17=$[-2*$val14]
!else
val17=$[2*$val14+$val16]
!endif
replyname1=$val6
replygood1=$val15
replyname2=$val7
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()计算 x=arc$val11($val11($val8)), 把它写成	x=$val6+$val7<img src=$val1/pi.gif> 的形式, 其中 $val6 和 $val7	是有理数.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,7,8,11
embedcnt=0
