!set title=复合可微分性
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=c
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=是
val7=否
val8=<i>f</i>
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
tmp0=!item $val9 of cos,sin,cos,sin

val10=$(tmp0)
tmp0=!item $val9 of cos,cos,sin,sin

val11=$(tmp0)
tmp0=!item $val9 of 0,0,pi/2,pi/2

val12=$[$(tmp0)]
val13=$val6,$val7
tmp0=!randint 1, 19

val14=$[rint($(tmp0))]
val15=$[rint($val14+2)]
tmp0=!randitem -1,1

val16=$[rint($(tmp0))]

!ifval $val16<0
val17=$[rint(-$val15)]
!else
val17=$[rint($val14)]
!endif

!ifval $val16<0
val18=$[rint(-$val14)]
!else
val18=$[rint($val15)]
!endif
val19=$[rint(floor(($val17+$val12)/pi))]
val20=$[rint(floor(($val18+$val12)/pi))]

!ifval $val19=$val20
val21=$val6
!else
val21=$val7
!endif
choicename1=回答
choicegood1=$val21
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()函数 $val8(x)=arc$val10($val11(x)) 在区间	[$val17,$val18] 是可微的吗?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,17,18
embedcnt=0
