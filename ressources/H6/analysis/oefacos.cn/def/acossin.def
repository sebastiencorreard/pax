!set title=arccos(sin)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<i>a</i>
val7=<i>b</i>
tmp0=!randitem -1,1

tmp1=!random 10, 150

val8=$[$(tmp0)*floor($(tmp1))/10]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 0,pi/2

val10=$[$(tmp0)]
tmp0=!item $val9 of cos,sin

val11=$(tmp0)
tmp0=!item $val9 of sin,cos

val12=$(tmp0)
val13=$[$val8+$val10]
val14=$[floor($val13/pi)]
val15=$[floor($val14/2)]

!ifval $val14%2=0
val16=$[-$val8]
!else
val16=$[$val8]
!endif
tmp0=!item $val9 of -1.5,-0.5

val17=$[$(tmp0)]

!ifval $val14%2=0
val18=$[2*$val15+0.5]
!else
val18=$[-2*$val15+$val17]
!endif
replyname1=$val6
replygood1=$val16
replyname2=$val7
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()计算 x=arc$val12($val11($val8)), 把它写成	x=$val6+$val7<img src=$val1/pi.gif> 的形式, 其中 $val6 和 $val7	是有理数.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,7,8,11,12
embedcnt=0
