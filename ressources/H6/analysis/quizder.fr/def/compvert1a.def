val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soit \(f) une fonction dérivable, de dérivée \(f').	  Calculez la dérivée de la fonction \(g) définie par
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
!readproc slib/data/randline src/simple1.data 
tmp0=$slib_out
val13=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val9,c1,subst($val10,c2,subst($val11,c3,subst($val12,c4,$val13))))
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(f(x),x,$val13)
tmp0=!exec maxima $t_

val14=$(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(f(x),x,$val15)
tmp0=!exec maxima $t_

val16=$(tmp0)
tmp=!translate ";': to $     $ in ($val16)*fprime

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp0=!replace internal fprime by f'(x) in $val17

val18=$(tmp0)
replytype1=formal
replyname1=\(g'(x))
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 
!insmath g(x) = $val14
$().	$m_name_question	
$()
