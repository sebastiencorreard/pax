val6=Calculez la dérivée de la fonction \(f) définie par
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
val13=!rawmath $val9*x+$val10
tmp0=!randitem sin,cos

val14=$(tmp0)
tmp0=!randitem $val12,$val12*x

tmp1=!randint 3, 6

tmp=!nonempty items 	 $val7/(x^2+$val9*x+$val10),	 ($val9*x+$val10)/($val11*x+$val12),	 $val9*x/(x^2+$val10*x+$val11),	 ($val9*x+$val10)/($val11*x^2+$(tmp0)),	 ($val9*x+$val10)/x^$(tmp1)	

tmp2=!randitem $tmp
val15=!rawmath $(tmp2)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'(x))
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 
!insmath f(x) = $val15
$().	
$()
