!set title=Croissance et signe 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr

ansorder=c
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=est croissante
val7=est décroissante
val8=est strictement croissante
val9=est strictement décroissante
val10=a des valeurs positives ou nulles
val11=a des valeurs négatives ou nulles
val12=a des valeurs strictement positives
val13=a des valeurs strictement négatives
val14=on ne peut rien dire
val15=Soit \(f) une fonction continue et dérivable	  sur un intervalle [a,b] et \(f') sa dérivée. Remplissez
val16=Si
val17=Il faut choisir la réponse la plus pertinente.
val18=La case à remplir
tmp0=!randitem $val10,$val12

tmp1=!randitem $val11,$val13

tmp2=!randitem $val6,$val8

tmp3=!randitem $val7,$val9

tmp=!translate internal $	$ to ; in 	 f,$val6,f',$val10,$val12,$val6,$val8,$val14	 f,$val7,f',$val11,$val13,$val7,$val9,$val14	 f,$val8,f',$val10,$val12,$val6,$val8,$val14	 f,$val9,f',$val11,$val13,$val7,$val9,$val14	 f,$val12,f',$val14,$val8,$val6,$val12,$val10	 f',$val10,f,$val6,$val8,$val10,$val12,$val14	 f',$val11,f,$val7,$val9,$val11,$val13,$val14	 f',$val12,f,$val8,$val6,$val10,$val12,$val14	 f',$val13,f,$val9,$val7,$val11,$val13,$val14	 f,$(tmp0),f',$val14,$val6,$val8,$val10,$val12	 f,$(tmp1),f',$val14,$val7,$val9,$val11,$val13	 f',$(tmp2),f,$val14,$val10,$val12,$val6,$val8	 f',$(tmp3),f,$val14,$val11,$val13,$val7,$val9	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp4=!translate internal $\
$ to ; in $tmp
val19=$(tmp4)
tmp0=!item 1 of $val19

val20=$(tmp0)
tmp0=!item 2 of $val19

val21=$(tmp0)
tmp0=!item 3 of $val19

val22=$(tmp0)
tmp0=!item 4 of $val19

val23=$(tmp0)
tmp0=!item 5 to -1 of $val19

val24=$(tmp0)
choicename1=$val18
choicegood1=$val23
choicebad1=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

