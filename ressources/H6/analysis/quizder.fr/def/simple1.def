!set title=Dérivées simples I 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Calculez la dérivée de la fonction \(f) définie par
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
!readproc slib/data/randline src/simple1.data 
tmp0=$slib_out
val13=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val9,c1,subst($val10,c2,subst($val11,c3,subst($val12,c4,$val13))))
tmp0=!exec maxima $t_

val13=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'(x))
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 
!insmath f(x) = $val13
$().	
$()
!exit

