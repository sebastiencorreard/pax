\title{Etude de la convexité}
\author{Bruno,Mifsud}
\email{bmifsud@ac-aix-marseille.fr}


\text{choix=est concave, est convexe, change de convexité}

%% Choix de 4 coefficients
\integer{a0=random(-4..5)}
\integer{a1=random(-4..5)}
\integer{a2=random(-4..5)}
\integer{a3=random(1..5)*random(1,-1)}
\text{f=simplify(\a3*x^3+\a2*x^2+\a1*x+\a0)}
\text{f1=diff(\f,x)}
\text{f2=diff(\f1,x)}
\real{r=solve(\f2=0,x=-100..100)}
\integer{r0=floor(\r)-1}
\integer{r1=floor(\r)+1}

\integer{q0=\r0-random(5..15)}
\integer{q1=\r1+random(5..15)}

%%% différents cas
\integer{cas=random(1..3)}
%%fonction concave à gauche de \r
\if{evalue(\f2,x=\r0)<0}
{

\if{\cas==1}{
\integer{a=\q0}
\integer{b=\r0}
\text{ans=\choix[1]}}

\if{\cas==2}{
\integer{a=\q0}
\integer{b=\q1}
\text{ans=\choix[3]}}

\if{\cas==3}{
\integer{a=\r1}
\integer{b=\q1}
\text{ans=\choix[2]}}
}
%%%% concave à droite de \r, sinon
\if{evalue(\f2,x=\r0)>0}
{
\if{\cas==1}
{
\integer{a=\q0}
\integer{b=\r0}
\text{ans=\choix[2]}
}

\if{\cas==2}
{
\integer{a=\q0}
\integer{b=\q1}
\text{ans=\choix[3]}
}

\if{\cas==3}
{
\integer{a=\r1}
\integer{b=\q1}
\text{ans=\choix[1]}
}
}


