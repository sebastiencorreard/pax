tmp0=!randint 20, 100

val6=$[$(tmp0)]
tmp0=!randint 30, 150

val7=$[rint($(tmp0))]
val8=$[$val6/sqrt(4*pi*$val7)]
replyname1=半径增加速度
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

