!set title=圆 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 100

val6=$[$(tmp0)/10]
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
val8=$[sqrt($val7/pi)]
val9=$[2*pi*$val8*$val6]
replyname1=面积增加速度
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有一圆, 其半径以每秒 $val6 厘米的定速度增加.	当面积等于 $val7 平方厘米时,	它的面积增加的速度如何 (以 cm<sup>2</sup>/s 为单位)?	
$()
!exit

