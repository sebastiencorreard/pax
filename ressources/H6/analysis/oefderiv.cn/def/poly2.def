!set title=多项式 II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 200

tmp1=!randitem -1,1

val6=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val7=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val8=$[$(tmp0)/10*$(tmp1)]
val9=!rawmath (x+$val6)*(x+$val7)*(x+$val8)
tmp0=!htmlmath $val9

val10=$(tmp0)
tmp=!translate ;";': to $     $ in $val9,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val11=!rawmath $(tmp0)
replyname1=\(f '(x))
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()计算以下函数的导数	
!insmath f(x) = $val9
$().
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=0
