!set title=多项式 I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=yes
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 6

tmp1=!randitem -1,1

val6=$[$(tmp0)*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val7=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val8=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val9=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
val11=!rawmath $val6*x^3+$val7*x^2+$val8*x+$val9
tmp0=!htmlmath $val11

val12=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
evaltmp=$val13

evaltmp=!mathsubst x=($val10) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
replyname1=<i>f</i> '($val10)
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst 我们有 <i>f</i> '(x)=$val13, 所以 <i>f</i> '($val10)=$val14.


!goto stat

!exit

:question
$()计算以下函数的导数	<i>f</i>(x) = $val12, 对 x=$val10.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()我们有 <i>f</i> '(x)=$val13, 所以 <i>f</i> '($val10)=$val14.
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,12,13,14
embedcnt=0
