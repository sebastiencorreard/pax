!set title=长方形 I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=XIAO, Gang
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$(tmp0)
tmp0=!item $val6 of 递增,递减

val7=$(tmp0)
tmp0=!item $val6 of +,-

val8=$(tmp0)
tmp0=!randint 15, 50

val9=$[$(tmp0)/10]
tmp0=!randitem 1,2

val10=$(tmp0)
tmp0=!item $val10 of 长度,宽度

val11=$(tmp0)
tmp0=!randint 10, 30

val12=$[rint($(tmp0))]
tmp0=!randint $val12+5, 2*$val12+10

val13=$[rint($(tmp0))]
val14=$[rint(2*($val12+$val13))]
val15=$[rint($val12*$val13)]
tmp0=!item $val10 of 宽度,长度

val16=$(tmp0)
tmp0=!item $val10 of $val12,$val13

val17=$(tmp0)
val18=厘米
val19=$val11
val20=$val11
tmp0=!item $val10 of $val13,$val12

val21=$(tmp0)
val22=厘米
val23=$[rint($val17)]
val24=$[$val8($val23)*$val9]
val25=cm<sup>2</sup>/s
val26=它的面积
replyname1=速度
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()有一个长方形,	它的$val19以每秒 $val9 厘米的定速$val7,	但是它的$val16保持不变, 为 $val17 $val18.	当$val20等于 $val21 $val22时,	$val26变化的速度 (以 $val25 为单位) 是多少?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,16,17,18,19,20,21,22,25,26
embedcnt=0
