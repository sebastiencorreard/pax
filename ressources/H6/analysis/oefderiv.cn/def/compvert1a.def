!set title=链条件 Ia
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
!readproc slib/data/randline src/simple1.data 
tmp0=$slib_out
val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val8,c1,subst($val9,c2,subst($val10,c3,subst($val11,c4,$val12))))
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(f(x),x,$val12)
tmp0=!exec maxima $t_

val13=$(tmp0)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst(f(x),x,$val14)
tmp0=!exec maxima $t_

val15=$(tmp0)
tmp=!translate ";': to $     $ in ($val15)*fprime

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$(tmp0)
tmp0=!replace internal fprime by f'(x) in $val16

val17=$(tmp0)
replytype1=formal
replyname1=导函数 \(g'(x))
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

