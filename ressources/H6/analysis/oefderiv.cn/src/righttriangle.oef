\title{直角三角形}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{ab=randint(30..100)}
\integer{ac=random(\ab/4..\ab/2)}
\integer{speed=randint(2..20)}
\integer{r=random(10..30)}
\real{sol=\speed*\ac/sqrt(\ac^2+\ab^2)}
\integer{dir=random(1,2)}
\text{direction=\dir=1?递增:递减}
\real{sol=\dir=1?\sol:-\sol}
\text{unit=random(cm,mm,m)}

\statement{有一个直角三角形, 其中
AB=\ab \unit, 且 AC 以 \speed \unit/s 的定速度\direction.
当 AC=\ac \unit 时, 问 BC 变化的速度是什么 (以 \unit/s 为单位)?
<p><center><img src=\imagedir/pic.gif></center>
}

\answer{BC 的速度 (\unit/s)}{\sol}
