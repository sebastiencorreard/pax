\title{多项式 II}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..200)/10*random(-1,1)}
\real{b=randint(20..200)/10*random(-1,1)}
\real{c=randint(20..200)/10*random(-1,1)}
\function{p=(x+\a)*(x+\b)*(x+\c)}
\text{hp=htmlmath(\p)}
\function{der=diff(\p,x)}

\statement{计算以下函数的导数
\(f(x) = \p).}

\answer{\(f '(x))}{\der}
