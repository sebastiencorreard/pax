\integer{x0=random(-3..3)}
\integer{c1=item(\x0+4,\c11,\c12,\c13,\c14,\c15,\c16,\c17)}
\integer{c2=item(\x0+4,\c21,\c22,\c23,\c24,\c25,\c26,\c27)}
\integer{b1=item(\c1+4,\b11,\b12,\b13,\b14,\b15,\b16,\b17)}
\integer{b2=item(\c1+4,\b21,\b22,\b23,\b24,\b25,\b26,\b27)}
\integer{a1=item(\b1+4,\a11,\a12,\a13,\a14,\a15,\a16,\a17)}
\integer{a2=item(\b1+4,\a21,\a22,\a23,\a24,\a25,\a26,\a27)}
\integer{sol=\a2*(\b2)*(\c2)}

\text{align=right}

\statement{有 3 个可微函数 <i>f</i>(x), <i>g</i>(x)
与 <i>h</i>(x),
其导数值如下表所示.
<p><center><table border=2 cellpadding=3>
<tr><th>x<th>-3<th>-2<th>-1<th>0<th>1<th>2<th>3</th></tr>
<tr><th><i>f</i>(x)
<td align=\align>\a11<td align=\align>\a12<td align=\align>\a13
<td align=\align>\a14<td align=\align>\a15<td align=\align>\a16
<td align=\align>\a17</td></tr>
<tr><th><i>f</i> '(x)
<td align=\align>\a21<td align=\align>\a22<td align=\align>\a23
<td align=\align>\a24<td align=\align>\a25<td align=\align>\a26
<td align=\align>\a27</td></tr>
<tr><th><i>g</i>(x)
<td align=\align>\b11<td align=\align>\b12<td align=\align>\b13
<td align=\align>\b14<td align=\align>\b15<td align=\align>\b16
<td align=\align>\b17</td></tr>
<tr><th><i>g</i>'(x)
<td align=\align>\b21<td align=\align>\b22<td align=\align>\b23
<td align=\align>\b24<td align=\align>\b25<td align=\align>\b26
<td align=\align>\b27</td></tr>
<tr><th><i>h</i>(x)
<td align=\align>\c11<td align=\align>\c12<td align=\align>\c13
<td align=\align>\c14<td align=\align>\c15<td align=\align>\c16
<td align=\align>\c17</td></tr>
<tr><th><i>h</i>'(x)
<td align=\align>\c21<td align=\align>\c22<td align=\align>\c23
<td align=\align>\c24<td align=\align>\c25<td align=\align>\c26
<td align=\align>\c27</td></tr>
</table></center> <p>
设 s(x) = <i>f</i>(<i>g</i>(<i>h</i>(x))). 计算导数
s'(\x0).
}

\answer{s'(\x0)}{\sol}
