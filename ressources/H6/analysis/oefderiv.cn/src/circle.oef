\title{圆}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)/10}
\integer{r=random(10..30)}
\real{sol=2*pi*\r*\a}

\statement{有一圆, 其半径以每秒 \a 厘米的定速度增加.
当半径等于 \r 厘米时,
它的面积增加的速度如何 (以 cm<sup>2</sup>/s 为单位)?
}

\answer{面积增加速度}{\sol}
