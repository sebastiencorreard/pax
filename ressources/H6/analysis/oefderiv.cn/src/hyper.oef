\title{双曲函数 I}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a1=randint(2..9)*random(-1,1)}
\integer{a2=randint(2..9)*random(-1,1)}
\integer{a3=randint(2..9)*random(-1,1)}
\integer{b1=randint(1..9)*random(-1,1)}
\integer{b2=randint(1..9)*random(-1,1)}
\integer{b3=randint(1..9)*random(-1,1)}
\integer{p1=randint(2..5)}
\integer{p2=randint(2..5)}

\function{p=random(
    sh(\a1*x+\b1),
    ch(\a1*x+\b1),
    sh(\a1*x)+ch(\a2*x),
    sh(\a1*x)+th(\a2*x),
    ch(\a1*x)+th(\a2*x),
    \a1*sh(\a2*x+\b1),
    \a1*ch(\a2*x+\b1),
    \a1*x*sh(\a2*x+\b1),
    \a1*x*ch(\a2*x+\b1),
    sh(\a1*x^\p1),
    ch(\a1*x^\p1),
    th(\a1*x+\b1)
)}
\text{hp=htmlmath(\p)}
\function{der=diff(\p,x)}

\statement{计算以下函数的导数
<i>f</i>(x) = \hp.}

\answer{<i>f</i> '(x)}{\der}{type=formal}
