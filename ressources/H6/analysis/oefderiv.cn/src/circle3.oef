\title{圆 III}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)}
\integer{area=randint(30..150)}
\real{sol=\a/sqrt(4*pi*\area)}

\statement{有一圆, 其面积以每秒 \a 平方厘米的定速度增加.
当面积等于 \area 平方厘米时,
它的半径增加的速度如何 (以 cm/s 为单位)?
}

\answer{半径增加速度}{\sol}
