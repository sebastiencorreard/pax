\title{有理函数 I}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{tex}
\precision{10000}

\integer{a1=randint(2..9)*random(-1,1)}
\integer{a2=randint(2..9)*random(-1,1)}
\integer{a3=randint(2..9)*random(-1,1)}
\integer{b1=randint(1..9)*random(-1,1)}
\integer{b2=randint(1..9)*random(-1,1)}
\integer{b3=randint(1..9)*random(-1,1)}
\integer{p1=randint(2..5)}
\integer{p2=randint(2..5)}

\function{p=random(
    \b1/x+\b2/x^2+\b3/x^3,
    (x+\b1)/(x+\b2),
    \b1/(\a1*x+\b2),
    (\a1*x+2)/(\a2*x+5),
    (\a1*x^2+\a2*x+\b1)/(x+\b2),
    \a1*x/(\a2*x+1)^\p1,
    \b1/(x+\b2)^\p1,
    x^\p1/(\a1*x+\b1)
)}
\text{hp=texmath(\p)}
\function{der=diff(\p,x)}

\statement{计算以下函数的导数
$$ f(x) = \hp\,\,. $$}

\answer{<i>f</i> '(x)}{\der}{type=formal}
