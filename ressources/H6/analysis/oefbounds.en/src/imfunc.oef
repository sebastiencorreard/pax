\title{Image of a function}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{bo=bounded}
\text{mino=lower-bounded}
\text{majo=upper-bounded}
\text{no=not necessarily bounded from either side}
\integer{o=random(1,2,3)}
\text{direct=item(\o,\mino,\majo,\bo)}
\text{reverse=item(\o,\majo,\mino,\bo)}
\text{strong=item(\o,\no,\no,\bo)}
\integer{dir=random(1,2)}
\matrix{data=a bijective, \no, \no
a continuous, \strong, \no
a continuous and bijective, \strong, \strong
a continuous and differentiable, \strong, \no
a continuous and periodic, \bo, \no
an increasing, \direct, \no
an increasing and periodic, \bo, \no
an increasing and surjective, \direct, \direct
a decreasing, \reverse, \no
a decreasing and periodic, \bo, \no
a decreasing and surjective, \reverse, \reverse
an odd, \no, \no
an odd and increasing, \direct, \no
an odd and decreasing, \reverse, \no
an injective, \no, \no
an even, \no, \no
an even and increasing, \bo, \no
an even and decreasing, \bo, \no
a periodic, \no, \no
a strictly increasing, \direct, \no
a strictly decreasing, \reverse, \no
}
\text{data=randomrow(\data)}
\text{cond=item(1,\data)}
\text{dimage=item(2,\data)}
\text{rimage=item(3,\data)}

\statement{Let \(f: \RR \rightarrow \RR\) be \cond function, and let
\(A\) be a \direct subset of \(\displaystyle{\RR}\).
Consider the image B=\f(A) and the inverse
image \(C=f^{-1}(A)\) of \(A\).
<p>
What can be said about \(B\) and \(C\)?
</p>
<div class="wims_instruction">
You must choose the most precise replies.
</div>
}

\choice{\(B\) is }{\dimage}{\bo,\mino,\majo,\no,}
\choice{\(C\) is }{\rimage}{\bo,\mino,\majo,\no,}
