\title{Bounder and union}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{o=random(1,2)}
\text{bounded=item(\o,bounded from above, bounded from below)}
\text{bounder=item(\o,upper bounder, lower bounder)}
\text{yes=It is always true}
\text{no=sometimes true and sometimes false}
\text{bad=It is never true}
\matrix{meth=a,\yes,\no
b,\yes,\no
item(\o,max,min)(a,b),\yes,\yes
item(\o,min,max)(a,b),\yes,\no
a+b,\no,\no
item(\o,|a|+|b|,-|a|-|b|),\yes,\yes
item(\o,-|a|-|b|,|a|+|b|),\no,\no
item(\o,|a+b|,-|a+b|),\yes,\no
item(\o,-|a+b|,|a+b|),\no,\no
}
\text{meth=randomrow(\meth)}
\text{rant=item(1,\meth)}
\text{good1=item(2,\meth)}
\text{good2=item(3,\meth)}
\statement{Let \(A\) and \(B\) be two subsets of \(\displaystyle{\RR}\).
Suppose that \(A\) (resp. \(B\)) is \bounded
by \(a\) (resp. by \(b\)). Are the following two statements true?
<ul><li>
I. \(A \cap B\) is \bounded by \(\rant\).
</li><li>
II. \(A \cup B\) is \bounded by \(\rant\).
</li>
</ul>}

\choice{I. intersection}{\good1}{\yes,\no,\bad}
\choice{II. union}{\good2}{\yes,\no,\bad}
