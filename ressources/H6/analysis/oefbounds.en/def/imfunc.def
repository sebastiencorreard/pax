!set title=Image of a function
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c,c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=2
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=bounded
val7=lower-bounded
val8=upper-bounded
val9=not necessarily bounded from either side
tmp0=!randitem 1,2,3

val10=$[rint($(tmp0))]
tmp0=!item $val10 of $val7,$val8,$val6

val11=$(tmp0)
tmp0=!item $val10 of $val8,$val7,$val6

val12=$(tmp0)
tmp0=!item $val10 of $val9,$val9,$val6

val13=$(tmp0)
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
tmp=!trim a bijective, $val9, $val9	a continuous, $val13, $val9	a continuous and bijective, $val13, $val13	a continuous and differentiable, $val13, $val9	a continuous and periodic, $val6, $val9	an increasing, $val11, $val9	an increasing and periodic, $val6, $val9	an increasing and surjective, $val11, $val11	a decreasing, $val12, $val9	a decreasing and periodic, $val6, $val9	a decreasing and surjective, $val12, $val12	an odd, $val9, $val9	an odd and increasing, $val11, $val9	an odd and decreasing, $val12, $val9	an injective, $val9, $val9	an even, $val9, $val9	an even and increasing, $val6, $val9	an even and decreasing, $val6, $val9	a periodic, $val9, $val9	a strictly increasing, $val11, $val9	a strictly decreasing, $val12, $val9	
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$(tmp0)
tmp0=!item 2 of $val15

val17=$(tmp0)
tmp0=!item 3 of $val15

val18=$(tmp0)
choicename1=\(B\) is 
choicegood1=$val17
choicebad1=$val6,$val7,$val8,$val9,
choicename2=\(C\) is 
choicegood2=$val18
choicebad2=$val6,$val7,$val8,$val9,
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath f: \RR \rightarrow \RR
$() be $val16 function, and let	
!insmath A
$() be a $val11 subset of 
!insmath \displaystyle{\RR}
$().	Consider the image B=$m_f(A) and the inverse	image 
!insmath C=f^{-1}(A)
$() of 
!insmath A
$().	<p>	What can be said about 
!insmath B
$() and 
!insmath C
$()?	</p>	<div class="wims_instruction">	You must choose the most precise replies.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

