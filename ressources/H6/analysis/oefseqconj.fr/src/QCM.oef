\real{u8 = evalue(\un, n=8)}
\real{u9 = evalue(\un, n=9)}
\real{u10 = evalue(\un, n=10)}
\real{u15 = evalue(\un, n=15)}
\real{u20 = evalue(\un, n=20)}
\text{points =1,\u1,2,\u2,3,\u3,4,\u4,5,\u5,10,\u10,15,\u15,20,\u20}
\text{GR1 =canvasdraw(600,600
xrange -1,23
yrange -12,12
axis
axisnumbering
xlabel x
ylabel y
precision 0
grid 2,2,grey,2,2,5,grey
precision 1000
linewidth 2
\tracef
crosshairs green,\points
)
}
\text{introC = \type issametext G and \r < 0 ? : La courbe représentant la fonction \(f) définie par \(f(x) =\fx ) peut donner une idée de cette limite : on regarde l'ordonnée d'un point de la courbe dont l'abscisse est un entier qui se rapproche de \(+\infinity).}
\text{solcorrT= \introC
\GR1
<br> \(u_1 = \u1\)
<br> \(u_5 = \u2 \)
<br> \(u_10 = \u3 \)
<br> \(u_15 = \u4 \)
<br> \(u_20 = \u5 \)
<br> \(u_25 = \u6 \) }
 }
\text{solcorr =}
\text{solcorr = \mode issametext T ? \solcorrT }
\text{solcorr = \mode issametext R ? \solcorrR }
\text{solcorr = \mode issametext S ? \solcorrS }

\text{liste = wims(listuniq \liste)}
\integer{nb = items(\liste) }
\statement{
<p>On considère la suite \enonce.</p>
<p class="wims_emph">\aide1
\special{help ,cliquer ici } ou sur le bouton Aide.<br>\aide2 </p>
<p>Quelle semble être la limite de cette suite ?</p>
<ul>\for{h=1 to \nb}{<li>\embed{reply1,\h}</li>}</ul>
\infodebug
}
\answer{}{1;\liste}{type = radio}{option=sort}

\text{repOK = La limite que vous avez conjecturée est
  effectivement la limite de cette suite. Il resterait à le démontrer pour en être sûr.}
\text{repOK1=On peut avoir des idées sur la limite d'une suite en utilisant différentes
  méthodes. Ci-dessous une ou plusieurs idées pouvant servir pour cette suite. }
\text{repnonOK = La limite que vous avez conjecturée
  n'est pas la limite de cette suite. On le verrait en cherchant une démonstration.
}
\text{repnonOK1=Mais faire des conjectures qui ne sont pas vérifiées par la suite
  n'est pas mauvais en soi !
  Cela fait partie du travail tout à fait normal en mathématiques.
  On apprend souvent beaucoup de choses en comprenant pourquoi une conjecture
  n'était pas bonne.}
\text{repnonOK2=On peut avoir des idées sur la limite d'une suite en utilisant différentes méthodes.
Ci-dessous une ou plusieurs idées pouvant servir pour cette suite.}
\feedback{\sc_reply1 =1}{<div class="oef_indgood">\repOK</div>
<p>\repOK1</p>
\solcorr}
\feedback{\sc_reply1 <1}{<div class ="oef_indprec">\repnonOK</div>
<div class ="wims_emph">\repnonOK1</div>
<p>repnonOK2</p>
\solcorr}
