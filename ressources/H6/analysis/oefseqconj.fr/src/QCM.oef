***********suite arithmétique
\if{\type issametext A}
{
\real{u0 = random(randint(-5..5),randint(-30..30)/5)}
\integer{cas = \mode issametext T ? random(2..5):random(1,2,2,2,3,3,4,4,4,5,5)}
\text{r = item(\cas,0,randint(1..5), pari(randint(5..30)/10),randint(-5..-1),pari( -randint(5..30)/10))}
\text{un = randitem(pari(\u0 + \r *n),wims(\u0 + \r *n),simplify(\u0 + \r *n))}
\text{relrec = \(\L _(n+1) = \L _n + \r \) }
\function{frec = x + \r}

\text{liste = \cas = 1 ? \(pari(\u0) \),+ \(inf), \(- inf), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 2 ? + \(inf), \(pari(\u0) \),\(- inf), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 3 ? + \(inf), \(pari(\u0) \),\(- inf), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 4 ? \(- inf),+ \(inf), \(pari(\u0) \), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 5 ? \(- inf),+ \(inf), \(pari(\u0) \), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}

\if{\mode issametext T}{\text{enonce = de terme général \(\L _n = \un \) pour tout entier naturel \(n \) }}
\if{\mode issametext R}{\text{enonce = définie par \(\L _0 = \u0 \) et, pour tout entier naturel \(n \), par la relation de récurrence : \(\L _(n+1) = \L _n + \r \) }
}
\if{\mode issametext S}{\text{enonce = arithmétique de premier terme \(\u0 \) et de raison \(\r \) }
}
\text{solcorrR= C'est une suite arithmétique. Pour passer d'un terme au suivant, si on ajoute toujours :
<ul>
<li> <b>le même nombre strictement positif</b>, alors \(\L _n) pourra être supérieur à n'importe quel réel en prenant \(n) assez grand. Donc la limite est \(+\infinity) ;
</li>
<li> <b>le même nombre strictement négatif</b>, alors \(\L _n) pourra être inférieur à n'importe quel réel en prenant \(n) assez grand. Donc la limite est \(-\infinity) ;
</li>
<li> <b>le nombre 0</b>, alors la suite est constante et sa limite est égale à cette constante.
</li></ul>
}
\text{solcorrS= \solcorrR}
}
************suite géométrique
\if{\type issametext G}
{
\integer{cas = \mode issametext T ? random(3..7): randitem(1,2,3,3,3,4,4,4,5,5,5,6,6,6,7,7,7)}
\real{u0 = item(\cas,0,pari(random(-1,1)*randint(20..50)/10),pari(randint(1..25)/10),-pari(randint(1..25)/10),pari(randint(20..60)/10),pari(randint(20..60)/10),pari(random(-1,1)*randint(20..30)/10))}
\text{r = item(\cas,pari(random(-1,1)*randint(1..15)/5),1, pari(random(randint(2..4),(randint(6..20)/5))),pari(random(randint(2..4),(randint(6..20)/5))),pari(random(1/randint(2..4),(randint(1..9)/10))), pari(random(1/randint(2..4),(randint(1..9)/10))),pari(random(-randint(1..4),(-randint(6..10)/randint(3..6)))) )}
\text{un = random(wims(\u0 * (\r) ^n),simplify(\u0 * (\r) ^n))}
\text{relrec = \(\L _(n+1) = \r * \L _n \) }
\function{frec = \r * x}

\text{liste = \cas = 1 ? \(0 \),+ \(inf), \(- inf), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 2 ? \(pari(\u0) \),+ \(inf), \(- inf), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 3 ? + \(inf), \(pari(\u0) \),\(- inf), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 4 ? \(- inf),+ \(inf), \(pari(\u0) \), \(0 \), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 5 ? \(0 \),\(pari(\u0) \),+ \(inf), \(- inf), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 6 ? \(0 \),\(pari(\u0) \),+ \(inf), \(- inf), \non, \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}
\text{liste = \cas = 7 ? \non, \(- inf),+ \(inf), \(pari(\u0) \), \(0 \), \(pari(\r) \), \(pari(random(-1,1)*randint(1..10)) \)}

\if{\mode issametext T}{\text{enonce = de terme général \(\L _n = \un \) pour tout entier naturel \(n \) }}
\if{\mode issametext R}{\text{enonce = définie par \(\L _0 = \u0 \) et, pour tout entier naturel \(n \), par la relation de récurrence : \relrec }}
\if{\mode issametext S}{\text{enonce = géométrique de premier terme \(\u0 \) et de raison \(\r \) }
}
\text{solcorrR=C'est une suite géométrique. Pour passer d'un terme au suivant, si on multiplie toujours par :
<ul><li><b>un nombre strictement positif</b>, alors tous les termes de la suite ont le même signe ; </li>
<li><b>un nombre strictement négatif</b>, alors les termes sont alternativement positif, négatif, positif, négatif, etc. ; </li>
<li> <b> le nombre 0</b>, alors la suite est nulle à partir du rang 1 ;</ul>
<ul>
</li><li><b>un même nombre dont la valeur absolue est strictement inférieure à 1</b>, alors la valeur absolue de \(\L _n) se rapproche de zéro ;
</li><li><b>un même nombre dont la valeur absolue est strictement supérieure à 1</b>, alors la valeur absolue de \(\L _n) se rapproche de \(+\infinity \) ;
</li><li><b> le nombre \(-1\) ou \(1\)</b>, alors la valeur absolue de \(\L _n) est constante.</li>
</ul>
En combinant ces deux éléments, on peut avoir une idée de la limite.
}
\text{solcorrS= \solcorrR}
}
