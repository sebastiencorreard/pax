\title{Conjecture sur la limite (QCM)}

\author {Chantal, Causse}
\email {Chantal.Causse@noos.fr}
\format {html}
\precision {100}
*** manière de dire qu'il n'y a pas de limite

\text{non = pas de limite}

\text{confparm1= items(\confparm1)=0 ? randitem(A,G,X):\confparm1}
*** A : arithmétique G : géométrique
    X : autre
\text{type = randitem(\confparm1)}
\text{confparm2= items(\confparm2)=0 ? randitem(T,R,S):\confparm2}
***  T : terme général R : relation de récurrence S : premier terme et raison ou phrase de def
\text{mode = randitem(\confparm2)}
\text{L = randitem (u,U,v,V)}
