\text{inf=&#8734;}
\integer{n=random(1..3)}
\text{n=\n!=1?\n:}
\text{x=random(x,t,X,\alpha)}
\text{ex=e^{\x}}
\text{lnx=\ln(\x)}
\text{powx=\x^{\n}}
// faux=2 // vrai = 1
\matrix{mataff=\name_at \(+\infty\)&#44; \(\powx\) \name_emporte \(\ex\),2
  \name_at \(+\infty\)&#44; \(\ex\) \name_emporte \(\powx\),1
  \name_at \(-\infty\)&#44; \(\powx\) \name_emporte \(\ex\),2
  \name_at \(-\infty\)&#44; \(\ex\) \name_emporte \(\powx\),1
  \name_at \(+\infty\)&#44; \(\lnx\) \name_emporte \(\powx\),2
  \name_at \(+\infty\)&#44; \(\powx\) \name_emporte \(\lnx\),1
  \name_atneigh 0&#44; \(\lnx\) \name_emporte \(\powx\),2
  \name_atneigh 0&#44; \(\powx\) \name_emporte \(\lnx\),1
}
\text{tmp=shuffle(8)}
\integer{tmp=item(1,\tmp)}
\text{row=row(\tmp,\mataff)}
\text{laff=item(1,\row)}
\integer{rep1=item(2,\row)}
\text{sol1=item(\rep1,\name_truefalse)}
\if{\rep1=1}{
  \text{taff=\laff}
}{
  \integer{tmp=\tmp+1}
  \text{row=row(\tmp,\mataff)}
  \text{taff=item(1,\row)}
}
\matrix{leslim=
\lim_{\x\to+\infty} \frac{\ex}{\powx},+inf
\lim_{\x\to-\infty} \powx \times \ex,0
\lim_{\x\to+\infty} \frac{\lnx}{\powx},0
\lim_{\x\to 0} \powx \times \lnx,0}
\integer{tmp=\tmp/2}
\text{row=row(\tmp,\leslim)}
\text{lalim=item(1,\row)}
\text{rep2=item(2,\row)}
\text{prelim=wims(replace internal NNNN by 2 in \name_prelim)}
\steps{reply1
reply2}
\statement{
<p><i>\prelim</i> \name_aim</p>
\if{\step=1}{
  <div>1. \name_question1[1] &#171;<b>\laff</b> &#187; \name_question1[2] :
  \embed{reply1} </div>
}
\if{\step>1}{
<p>1. <span class="oef_indgood">\name_question1[1]</span>
&#171;<b> \laff </b>&#187;
<span class="oef_indgood">\name_question1[2] \sol1.</span></p>
\if{\rep1=2}{
