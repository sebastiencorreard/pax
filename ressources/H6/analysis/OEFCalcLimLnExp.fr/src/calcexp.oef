}
\integer{k=randitem(-1,1)*random(1..8)}
\text{tk=\k}
\text{tk=\k=-1?-}
\text{tk=\k=1?}
\function{u1=maxima(expand(\a*x + \b))}
\function{u2=maxima(expand(\a*x + \b)^2)}
\function{u3=sqrt(\u1)}
\text{u1=(\u1)}
\text{u=item(\cas,\u1,\u2,\u3)}
