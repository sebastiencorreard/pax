!set title=Dérivée avec exponentielle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x+$val9
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val10=$(tmp1)
t_=!replace internal \( by ( in $val6*x+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=($val7*x+$val9)*exp($val6*x+$val8),($val7*x+$val9)/exp($val6*x+$val8),exp($val6*x+$val8)/($val7*x+$val9)
val13=($val10)e^{$val11},\frac{$val10}{e^{$val11}},\frac{e^{$val11}}{$val10}
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val12

val15=$(tmp0)
tmp0=!item $val14 of $val13

val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val17=!rawmath $(tmp1)
replytype1=formal
replyname1=dérivée
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  On considère la fonction 
!insmath f
$() définie par 
!insmath f(x)=\displaystyle $val16
$().</p>	  Calculer 
!insmath f'(x)
$()= 
