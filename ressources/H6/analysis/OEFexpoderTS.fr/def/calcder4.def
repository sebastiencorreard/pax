!set title=Dérivée avec exponentielle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

tmp2=!randitem 1,$(tmp0)*$(tmp1)

val6=$[rint($(tmp2))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x+$val9
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val10=$(tmp1)
t_=!replace internal \( by ( in $val6*x+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=($val7*x+$val9)*exp($val6*x+$val8)
val13=($val10)e^{$val11}
val14=(a_n x+b_n)e^{$val11}
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val15=!rawmath $(tmp1)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val16=!rawmath $(tmp1)

!ifval $val6=1
val17=a_n
!else
val17=$val6*a_n
!endif

!ifval $val6=1
val18=b_n+$val7
!else
val18=$val6*b_n+a_n
!endif

!ifval $val6=1
val19=$[rint(1)]
!else
val19=$[rint(3)]
!endif

!ifval $val6=1
val20=$[rint(2)]
!else
val20=$[rint(5)]
!endif
val21=constante, arithmétique, géométrique, arithmético-géométrique, quelconque
replytype1=formal
replyname1=dérivée
replygood1=$val15
replytype2=formal
replyname2=dérivée seconde
replygood2=$val16
replytype3=formal
replyname3=\(a_{n+1})
replygood3=$val17
replytype4=formal
replyname4=\(b_{n+1})
replygood4=$val18
replytype5=menu
replyname5=nature de \((a_n))
replygood5=$val19;$val21
replytype6=menu
replyname6=nature de \((b_n))
replygood6=$val20;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  On considère la fonction 
!insmath f
$() définie par 
!insmath f(x)=\displaystyle $val13
$().</p>	<ol>	<li>Calculer 
!insmath f'(x)
$() et 
!insmath f''(x)
$():	<div class="wimscenter">
!insmath f'(x)
$()= 
!read oef/embed.phtml reply1 
$()</div>	<div class="wimscenter">
!insmath f''(x)
$()= 
!read oef/embed.phtml reply2 
$()</div>	</li>	<li>En supposant qu'il existe des suites 
!insmath (a_n)
$() et 
!insmath (b_n)
$(), telles que pour tout	  entier 
!insmath n
$(), la dérivée d'ordre 
!insmath n
$() est donnée par 
!insmath f^{(n)}(x)=$val14
$(),	  exprimer les termes 
!insmath a_{n+1}
$() et 
!insmath b_{n+1}
$() en fonction de 
!insmath a_n
$() et 
!insmath b_n
$():	<div class="wims_instruction">Taper <span class="tt">a_n</span> pour 
!insmath a_n
$() et	<span class="tt">b_n</span> pour 
!insmath b_n
$()</div>	<div class="wimscenter">
!insmath a_{n+1}
$()= 
!read oef/embed.phtml reply3 
$()</div>	<div class="wimscenter">
!insmath b_{n+1}
$()= 
!read oef/embed.phtml reply4 
$()</div>	</li>	<li>En déduire la nature des suites 
!insmath (a_n)
$() et 
!insmath (b_n)
$():	<div class="wimscenter">la suite 
!insmath (a_n)
$() est une suite  
!read oef/embed.phtml reply5 
$()</div>	<div class="wimscenter">la suite 
!insmath (b_n)
$() est une suite  
!read oef/embed.phtml reply6 
$()</div>	</li></ol>	
