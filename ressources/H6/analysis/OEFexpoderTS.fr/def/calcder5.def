!set title=Dérivée avec exponentielle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r,r,r,r,r,r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

tmp2=!randitem 1,$(tmp0)*$(tmp1)

val6=$[rint($(tmp2))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in $val7*x^2+$val9*x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
t_=!replace internal \( by ( in x+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val12=$(tmp1)
val13=($val7*x^2+$val9*x+$val10)*exp(x+$val8)
val14=($val11)e^{$val12}
val15=(a_n x^2+b_n x+c_n)e^{$val12}
tmp=!translate ;";': to $     $ in $val13,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val16=!rawmath $(tmp1)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val17=!rawmath $(tmp1)
val18=a_n
val19=b_n+2*a_n
val20=c_n+b_n
val21=$[rint(1)]
val22=$[rint(2)]
val23=$[rint(5)]
val24=constante, arithmétique, géométrique, arithmético-géométrique, quelconque
replytype1=formal
replyname1=dérivée
replygood1=$val16
replytype2=formal
replyname2=dérivée seconde
replygood2=$val17
replytype3=formal
replyname3=\(a_{n+1})
replygood3=$val18
replytype4=formal
replyname4=\(b_{n+1})
replygood4=$val19
replytype5=formal
replyname5=\(c_{n+1})
replygood5=$val20
replytype6=menu
replyname6=nature de \((a_n))
replygood6=$val21;$val24
replytype7=menu
replyname7=nature de \((b_n))
replygood7=$val22;$val24
replytype8=menu
replyname8=nature de \((c_n))
replygood8=$val23;$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  On considère la fonction 
!insmath f
$() définie par 
!insmath f(x)=\displaystyle $val14
$().</p>	<ol>	<li>Calculer 
!insmath f'(x)
$() et 
!insmath f''(x)
$():	<div class="wimscenter">
!insmath f'(x)
$()= 
!read oef/embed.phtml reply1 
$()</div>	<div class="wimscenter">
!insmath f''(x)
$()= 
!read oef/embed.phtml reply2 
$()</div>	</li><li>	  En supposant qu'il existe des suites 
!insmath (a_n),(b_n)
$() et 
!insmath (c_n)
$(), telles que pour tout entier	  
!insmath n
$(), la dérivée d'ordre 
!insmath n
$() est donnée par 
!insmath f^{(n)}(x)=$val15
$(),	  exprimer les termes 
!insmath a_{n+1},b_{n+1}
$() et 
!insmath c_{n+1}
$() en fonction de 
!insmath a_n,b_n
$() et 
!insmath c_n
$().	<div class="wimscenter">
!insmath a_{n+1}
$()= 
!read oef/embed.phtml reply3 
$()</div>	<div class="wimscenter">
!insmath b_{n+1}
$()= 
!read oef/embed.phtml reply4 
$()</div>	<div class="wimscenter">
!insmath c_{n+1}
$()= 
!read oef/embed.phtml reply5 
$()</div>	<div class="wims_instruction"> Taper <span class="tt">a_n</span>	  pour 
!insmath a_n
$() et <span class="tt">b_n</span> pour 
!insmath b_n
$()</div>	</li><li>En déduire la nature des suites 
!insmath (a_n), (b_n)
$() et 
!insmath (c_n)
$():	<div class="wimscenter">la suite 
!insmath (a_n)
$() est une suite  
!read oef/embed.phtml reply6 
$()</div>	<div class="wimscenter">la suite 
!insmath (b_n)
$() est une suite  
!read oef/embed.phtml reply7 
$()</div>	<div class="wimscenter">la suite 
!insmath (c_n)
$() est une suite  
!read oef/embed.phtml reply8 
$()</div>	</li></ol>	
