!set title=Dérivée avec exponentielle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
val10=$val6*x+$val8,$val6*x^2+$val8*x+$val9,$val7/x,($val7*x+$val9)/($val6*x+$val8)
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val11=$(tmp0)
t_=!replace internal \( by ( in $val11
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val12=$(tmp1)
val13=e^{\displaystyle $val12}
tmp=!translate ;";': to $     $ in exp($val11),x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val14=!rawmath $(tmp1)
replytype1=formal
replyname1=dérivée
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  On considère la fonction 
!insmath f
$() définie par 
!insmath f(x)=\displaystyle $val13
$().</p>	  Calculer 
!insmath f'(x)
$()= 
!read oef/embed.phtml reply1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

