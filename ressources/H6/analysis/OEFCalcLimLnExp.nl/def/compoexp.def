tmp0=!exec maxima $t_

val11=!rawmath $(tmp0)
tmp0=!texmath $val11

val11=$(tmp0)
val12=e^{t}
val13=e^{u}
val14=e^{u(x)}
val15=!rawmath e^{$val11}
tmp0=!item $val10 of $val9 $val15, \frac{$val8}{$val15}

val16=$(tmp0)
tmp0=!item $val10 of  k $val13, \frac{k}{$val13}

val17=$(tmp0)
tmp0=!texmath $val16

val18=$(tmp0)
val19=&#8734;
tmp0=!randitem -,+

val20=$(tmp0)

!ifval ($val20 issametext +)
val21=$[rint(1)]
!else
val21=$[rint(-1)]
!endif
val22=$val20$val19
val23=$val20\infty
val24=\RR

!ifval ($val6*$val21)>0
val25=+inf,+\infty
!else
val25=-inf,-\infty
!endif
tmp0=!item 1 of $val25

val26=$(tmp0)
tmp0=!item 2 of $val25

val27=$(tmp0)

!ifval $val26 issametext -inf
val28=0,0
!else
val28=+inf,+\infty
!endif

!ifval $val26 issametext -inf
val29=+inf
!else
val29=0
!endif

!ifval $val26 issametext -inf
val30=-inf
!else
val30=0
!endif

!ifval $val26 issametext -inf
val31=-inf
!else
val31=0
!endif
tmp0=!item 1 of $val28

val32=$(tmp0)
tmp0=!item 2 of $val28

val33=$(tmp0)
val34=$val32
val35=$val33
!if $val10=1 

!ifval $val8>0
val36=$val34
!else
val36=$val30
!endif
!else

