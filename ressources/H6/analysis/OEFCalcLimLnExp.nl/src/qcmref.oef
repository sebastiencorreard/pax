\title{Limieten [basis]}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{x=random(x,t,\alpha)}
\integer{n=random(1,1,2,3,4)}
\text{xn=\n>1?\x^\n:\x}
\text{sn=\n=1 or \n=3?-:+}
\text{inf=&#8734;}
\integer{a = random(-1,1)*random(1..8)}
\text{\sa=\a>0?+:-}
\text{\soa=\a>0?-:+}
\integer{b=random(0,0,1,2,3,4)}
\integer{b=random(-1,1)*\b}
\function{u=maxima(expand(\a*x + \b))}
\text{u=wims(replace internal x by \x in \u)}
\text{u=texmath(\u)}
\rational{x0=-\b/\a}
\integer{k=random(-1,1)*random(1..8)}
\text{\sk=\k>0?+:-}
\text{\sok=\k>0?-:+}
\text{ineg=\a>0?>:<}
\matrix{forms=\(\lim_{\x \to +\infty}e^{\x})
\(\lim_{\x \to -\infty}e^{\x})
\(\lim_{\x \to +\infty}\ln(\x))
\(\lim_{\x \downarrow 0 } \ln(\x))
\(\lim_{\x \to +\infty} \k e^{\x})
\(\lim_{\x \to -\infty} \k e^{\x})
\(\lim_{\x \to +\infty} \k \ln(\x))
\(\lim_{\x \uparrow 0 } \k \ln(\x))
\(\lim_{\x \to +\infty} e^{\u})
\(\lim_{\x \to -\infty} e^{\u})
\(\lim_{\x \to \sa\infty} \ln(\u))
\(\lim_{\x \downarrow \x0} \ln(\u))
\(\lim_{\x \to +\infty} \frac{e^{\x}}{\xn})
\(\lim_{\x \to -\infty} \xn \times e^{\x})
\(\lim_{\x \to +\infty}\frac{\ln(\x)}{\xn})
\(\lim_{\x \downarrow 0 } \xn \times \ln(\x))
\(\lim_{\x \to +\infty}\frac{\xn}{e^{\x}})
\(\lim_{\x \to -\infty}\xn\times e^{-\x})
\(\lim_{\x \to +\infty}\frac{\xn}{\ln(\x)})
\(\lim_{\x \uparrow 0 }\frac{\xn}{\ln(\x)})
\(\lim_{\x \to 1}\frac{\ln(\x)}{\x-1})
\(\lim_{\x \to 0}\frac{e^{\x}-1}{\x})
}

\text{reps=+inf,0,+inf,-inf,\sk inf,0,\sk inf,\sok inf}
\text{rep9=\a>0?+inf:0}
\text{rep10=\a>0?0:+inf}
\text{rep11=+inf}
\text{rep12=-inf}
\text{reps=\reps,\rep9,\rep10,\rep11,\rep12,+inf,0,0,0,0,\sn inf,+inf,0,1,1}

\text{nums=shuffle(22)}
\text{nums=item(1..6,\nums)}
\text{quest=row([\nums],\forms)}
\text{answ=item([\nums],\reps)}
\text{q1=row(1,\quest)}
\text{q2=row(2,\quest)}
\text{q3=row(3,\quest)}
\text{q4=row(4,\quest)}
\text{q5=row(5,\quest)}
\text{q6=row(6,\quest)}
\text{a1=item(1,\answ)}
\text{a2=item(2,\answ)}
\text{a3=item(3,\answ)}
\text{a4=item(4,\answ)}
\text{a5=item(5,\answ)}
\text{a6=item(6,\answ)}


\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
Deze oefening test je kennis van de basale limieten van logaritmische en exponentiele functies.<br>
Antwoord zo snel als je kunt !
</p>
<small><b>\special{help saisie,Syntax tips}</b></small>


<p><center>
<table cellpadding="10">
<tr>
<td align="right">\q1</td><td>=</td><td align="left">\embed{reply1, 5}</td><td></td><td align="right">\q2 </td><td>=</td><td align="left">\embed{reply2, 5}</td>
</tr><tr>
<td align="right">\q3 </td><td>=</td><td align="left">\embed{reply3, 5}</td><td>&nbsp;</td><td align="right">\q4 </td><td>=</td><td align="left">\embed{reply4, 5}</td>
</tr><tr>
<td align="right">\q5 </td><td>=</td><td align="left">\embed{reply5, 5}</td><td></td><td align="right">\q6 </td><td>=</td><td align="left">\embed{reply6, 5}</td>
</tr></table>
</center></p>
</div>
}

\answer{}{\a1}{type=raw}{option=nospace}
\answer{}{\a2}{type=raw}{option=nospace}
\answer{}{\a3}{type=raw}{option=nospace}
\answer{}{\a4}{type=raw}{option=nospace}
\answer{}{\a5}{type=raw}{option=nospace}
\answer{}{\a6}{type=raw}{option=nospace}

\help{
 \if{\help_subject issametext saisie}{
<b>Syntax tips:</b><br/>
schrijf <b>+inf</b> voor\(+\infty)  ;<br> schrijf  <b>-inf</b> voor\(-\infty). 
   }
}
