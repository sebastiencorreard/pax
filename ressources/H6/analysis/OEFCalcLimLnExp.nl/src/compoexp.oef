\title{De limiet van k*exp(ax+b) of k/exp(ax+b)}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..5)}
\integer{b = random(-8..8)}
\integer{k=random(-1,1)*random(1..8)}
\text{tk=\k}
\text{tk=\k=-1?-}
\text{tk=\k=1?}
\integer{op=random(1..2)}

\function{u=maxima(expand(\a*x + \b))}
\text{u=texmath(\u)}
\text{g=e^{t}}
\text{gg=e^{u}}
\text{ggx=e^{u(x)}}
\function{expu=e^{\u}}
\text{f=item(\op,\tk \expu, \frac{\k}{\expu})}
\text{ff=item(\op, k \gg, \frac{k}{\gg})}
\text{tf=texmath(\f)}

\text{inf=&#8734;}
\text{sx=random(-,+)}
\integer{ssx=(\sx issametext +)?1:-1}
\text{xlim=\sx\inf}
\text{texlim=\sx\infty}
\text{ensdef=\RR}

\text{ulim=(\a*\ssx)>0?+inf,+\infty:-inf,-\infty}
\text{rep3=item(1,\ulim)}
\text{sol3=item(2,\ulim)}

\text{glim=\rep3 issametext -inf?0,0:+inf,+\infty}
\text{invlim=\rep3 issametext -inf?+inf:0}
\text{neglim=\rep3 issametext -inf?-inf:0}
\text{neginvlim=\rep3 issametext -inf?-inf:0}

\text{rep4=item(1,\glim)}
\text{sol4=item(2,\glim)}

\text{rep5=\rep4}
\text{sol5=\sol4}

\if{\op=1}
{\text{rep6=\k>0?\rep5:\neglim}}
{\text{rep6=\k>0?\invlim:\neginvlim}}

\steps{reply1,reply2
reply3
reply4
reply5
reply6}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
Laat de functie \(f) in \(\ensdef) gedefinieerd zijn door: \(f(x) = \tf ).
</p><p> 
De bedoeling van deze serie oefeningen is het stap voor stap bepalen van de limiet van \(f) in \xlim
</p>
<small><b>\special{help saisie,Syntax tips}</b></small>
</div>

<ul>


\if{\step=1}
{
<li>De functie \(f) is van het type  \(\ff) met:
<center>\(u(x)) = \embed{reply1,5} <br>en<br> \(k) = \embed{reply2,5} </center>
</li>
}
\if{\step>1}
{<li><font color = blue> De functie \(f) is van het type \(\ff) met
\(u(x) = \u ) en \(k = \k).</font> 
</li>
}


\if{\step=2}
{
<li>Bepaal de limiet van \(u) in \xlim : <small>(\special{help saisie,Syntax tips})</small>
<center>\(\lim_{x\to\texlim} \u ) = \embed{reply3,5}</center>
</li>
}
\if{\step>2}
{<li><font color = blue>De limiet van \(u) in \xlim is</font>:  
<center>\(\lim_{x\to\texlim} u(x) = \lim_{x\to\texlim} \u  = \sol3)</center>
</li>
}

\if{\step=3}
{<li>Bepaal de limiet van \(\g) in \(\sol3): <small>(\special{help saisie,Syntax tips})</small>
<center>\(\lim_{t\to\sol3} \g ) = \embed{reply4,5}</center>
</li>
}

\if{\step>3}
{<li><font color = blue>Uit de eigenschappen van de exponentiele functie weten we dat</font>:
<center>\(\lim_{t\to\sol3} \g   = \sol4)</center>
</li>
}


\if{\step=4}
{<li>Door substitutie van \(t = u(x)), en het gegeven dat \(\lim_{t\to\sol3} \g  = \sol4), wordt: <small>(\special{help saisie,Syntax tips})</small>
<center>\( \lim_{x\to\texlim} \ggx   =  \lim_{x\to\texlim} \expu ) = \embed{reply5,5}</center>
</li> 
}

\if{\step>4}
{<li><font color = blue> De limiet van \(\gg) in \xlim is</font>:
<center>
\(\lim_{x\to\texlim} \ggx  =  \lim_{x\to\texlim} \expu  = \lim_{t\to\sol3} \g = \sol5).
</center> 
</li> 
}

\if{\step=5}
{<li>En door toepassing van de rekenregels voor limieten, volgt dat: <small>(\special{help saisie,Syntax tips})</small>
<center>\( \lim_{x\to\texlim} \f)   = \embed{reply6,5}</center>
</li> 
}

</ul>
}
\answer{exponent u(x)}{\u}{type=formal}{option=nonstop}
\answer{coefficient k}{\k}{type=numeric}{option=nonstop}
\answer{de limiet van u = }{\rep3}{type=raw}{option=nospace,nonstop}
\answer{de limiet van \(\g) = }{\rep4}{type=raw}{option=nospace,nonstop}
\answer{de limiet van \(\gg) = }{\rep5}{type=raw}{option=nospace,nonstop}
\answer{de limiet van \(f) = }{\rep6}{type=raw}{option=nospace}


\solution{ }

\help{
  
 \if{\help_subject issametext saisie}{
<b>Syntax tips:</b><br/>
schrijf  <b>+inf</b> for \(+\infty)  ;<br/> schrijf  <b>-inf</b> voor \(-\infty). 
   }
}
