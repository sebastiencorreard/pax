\title{De limiet van u(x)*exp(kx)}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}


\integer{a = random(-1,1)*random(1..8)}
\if{\cas<3}{\integer{b= random(-1,1)*random(0,0,1,2,3,4)}}
{\integer{b= random(-1,1)*random(1..8)}}
\integer{k=random(-1,1)*random(1..8)}
\text{tk=\k}
\text{tk=\k=-1?-}
\text{tk=\k=1?}

\function{u1=maxima(expand(\a*x + \b))}
\function{u2=maxima(expand(\a*x + \b)^2)}
\function{u3=sqrt(\u1)}
\integer{cas=random(1,2,3)}
\text{u1=(\u1)}
\text{u=item(\cas,\u1,\u2,\u3)}
\text{u=texmath(\u)}
\text{v=e^{\tk x}}
\function{f=\u \times \v}
\text{inf=&#8734;}
\if{\cas<3}
{
\text{lim1=-\inf}
\text{lim2=+\inf}
\text{tolim1=x\to-\infty}
\text{tolim2=x\to+\infty}
\text{ensdef=\(\RR)}
}
\if{\cas=1}{
\text{ulim=\a>0?-inf,-\infty,+inf,+\infty:+inf,+\infty,-inf,-\infty}
\text{ucod=\a>0?-1,1:1,-1}
\text{vlim=\k>0?0,0,+inf,+\infty:+inf,+\infty,0,0}
\text{vcod=\k>0?0,1:1,0}
}
\if{\cas=2}{
\text{ulim=+inf,+\infty,+inf,+\infty}
\text{ucod=1,1}
\text{vlim=\k>0?0,0,+inf,+\infty:+inf,+\infty,0,0}
\text{vcod=\k>0?0,1:1,0}
}
\if{\cas=3}
{
\rational{x0=-\b/\a}
\text{sx=\a>0?+:-}
\integer{ssx=(\sx issametext +)?1:-1}
\text{xinf=\sx\inf}
\text{texinf=\sx\infty}
\text{ensdef=\a>0? &#93;  \x0 ; \xinf &#91; }
\text{natlim=\a>0?from above:from below}
\text{ineg=\a>0?>:<}
\text{ensdef=\a<0? &#93;\xinf ; \x0 &#91; }
\text{lim1=\a>0?\x0:\xinf}
\text{lim2=\a>0?\xinf:\x0}
\text{tolim1=\a>0? x \downarrow \x0 :x\to\texinf}
\text{tolim2=\a>0?x\to\texinf:x \uparrow \x0}
\text{ulim=\a>0?0,0,+inf,+\infty:+inf,+\infty,0,0}
\text{ucod=\a>0?0,1:1,0}
\rational{x1=\k*\x0}
\text{c=exp(\x1)}
\text{tc=e^{\x1}}
\if{\a>0}{\text{vlim=\k>0?\c,\tc,+inf,+\infty:\c,\tc,0,0}
          \text{vcod=\k>0?2,1:2,0}}
         {\text{vlim=\k>0?0,0,\c,\tc:+inf,+\infty,\c,\tc}
          \text{vcod=\k>0?0,2:1,2}}
}
\text{rep1=item(1,\ulim)}
\text{rep2=item(3,\ulim)}
\text{sol1=item(2,\ulim)}
\text{sol2=item(4,\ulim)}
\text{rep3=item(1,\vlim)}
\text{rep4=item(3,\vlim)}
\text{sol3=item(2,\vlim)}
\text{sol4=item(4,\vlim)}
\integer{ul1=item(1,\ucod)}
\integer{ul2=item(2,\ucod)}
\integer{vl1=item(1,\vcod)}
\integer{vl2=item(2,\vcod)}
\integer{tmp=\ul1*\vl1}
\integer{rep5=\vl1=0?2:1}
\text{sol5=item(\rep5,produkt,groeifactor)}
\if{\tmp=0}{\text{fl1=0,0}}
{\if{\tmp>0}{\text{fl1=+inf,+\infty}}{\text{fl1=-inf,-\infty}}}
\integer{tmp=\ul2*\vl2}
\integer{rep7=\vl2=0?2:1}
\if{\tmp=0}{\text{fl2=0,0}}
{\if{\tmp>0}{\text{fl2=+inf,+\infty}}{\text{fl2=-inf,-\infty}}}
\text{rep6=item(1,\fl1)}
\text{sol6=item(2,\fl1)}
\text{rep8=item(1,\fl2)}
\text{sol8=item(2,\fl2)}

\steps{reply1,reply2
reply3,reply4
reply5,reply6
reply7,reply8
}

\statement{

<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 

We nemen de functie \(f(x) = \f ) gedefinieerd in \ensdef. <br/> 
De bedoeling van deze oefening is om stap voor stap de limieten van \(f) in \lim1 en in \lim2 te berekenen.

</p>
<small><b>\special{help typing,Syntax tips}</b></small>
</div>



<ul>

\if{\step=1}
{
<li> Laat \(u) de functie \( u(x) = \u) zijn, gedefinieerd in \ensdef.
 <br/>
Bepaal de limieten van \(u) in \lim1 en in \lim2 : 
<small>(\special{help typing,Syntax tips})</small>
<center>\(\lim_{\tolim1} \u ) = \embed{reply1,5} <br>en<br> \(\lim_{\tolim2} \u ) = \embed{reply2,5} </center>
</li>
}
\if{\step>1}
{<li><font color = blue>De limieten van  \(u) in \lim1 en in \lim2 zijn</font>:
<center>\(\lim_{\tolim1} \u = \sol1)  en  \(\lim_{\tolim2} \u = \sol2)  </center>
</li>
}

\if{\step=2}
{
<li>Nu gaan we de limieten van  \(\v) in  \lim1 en in \lim2 bepalen : 
 <small>(\special{help typing,Syntax tips})</small>
<center>\(\lim_{\tolim1} \v ) = \embed{reply3,8} <br>en<br> \(\lim_{\tolim2} \v ) = \embed{reply4,8}  </center>
</li>
}
\if{\step>2}
{<li><font color = blue>De limieten van de exponenti&euml;le functie in \lim1 en in \lim2 zijn</font>:
<center>\(\lim_{\tolim1} \v = \sol3)  &nbsp; en &nbsp;  \(\lim_{\tolim2} \v = \sol4)  </center>
</li>
}


\if{\step=3}
{<li>Uit de voorafgaande berekeningen kunnen we de limiet van \(f) in \lim1 afleiden door \embed{reply5} te gebruiken:
<center>\( \lim_{\tolim1} \f)   = \embed{reply6,5}
</li> 
}


\if{\step>3}
{<li><font color = blue>
Uit de voorafgaande berekeningen en \sol5 kunnen we herleiden dat</font>:
<center>\( \lim_{\tolim1} \f = \sol6)  
</li>
}



\if{\step=4}
{<li>
Uit de voorafgaande berekeningen kunnen we - met \embed{reply7} - de limiet van \(f) in \lim2 herleiden :
<center>\( \lim_{\tolim2} \f)   = \embed{reply8,5}
</li> 
}


</ul>
}
\answer{De limiet van \(u) op \lim1}{\rep1}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(u) op \lim2}{\rep2}{type=raw}{option=nospace,nonstop}
\answer{De limiet van exp(\tk x) op \lim1}{\rep3}{type=raw}{option=nospace,nonstop}
\answer{De limiet van exp(\tk x) op \lim2}{\rep4}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(f) op \lim1 }{\rep5;de regel mbt limiet van producten,het principe van de winnende functie}{type=select}{option=nonstop}
\answer{De limiet van \(f) op \lim1 }{\rep6}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(f) op \lim1 }{\rep7;de regel mbt limiet van producten, het principe van de winnende functie}{type=select}{option=nonstop}
\answer{De limiet van \(f) op \lim2 }{\rep8}{type=raw}{option=nospace}



\solution{ }

\help{

\if{\help_subject issametext typing}{
<b>Syntax tips:</b><br/>
Bereik en Domein notatie:<br>
&#93; -inf ; 5 &#93; == &lt;-inf : 5&#93;<br> 
&#93; -5 ; 5 &#91; == &lt; -5 : 5 &gt;
<br>
schrijf <b>+inf</b> voor \(+\infty)  ;<br/>
schrijf <b>-inf </b> voor \(-\infty) ;<br/>
schrijf <b>exp(x)</b> voor \(e^{x}) ;<br/>
(<font color=red>gebruik niet e^x </font>)
}
 \if{\help_subject issametext product}{Met "produkt" bedoelen we: de rekenregels voor de limieten van produkten.
 Dat wil zeggen: de limiet van een produkt is gelijk aan het produkt der limieten (uitgezonderd de tussenvormen).
 <p>
 Een voorbeeld van <em>het principe van de winnende functie</em> is: een exponenti&euml;le functie [met groeifactor &gt;1] 
 stijgt sneller dat een polynoom.   
} 
}
