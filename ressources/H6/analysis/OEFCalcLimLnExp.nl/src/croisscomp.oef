\title{Stijgen en dalen : basis eigenschappen}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\text{inf=&#8734;}
\integer{n=random(1..3)}
\text{n=\n!=1?\n:}
\text{x=random(x,t,X,\alpha)}
\text{ex=e^{\x}}
\text{lnx=\ln(\x)}
\text{powx=\x^{\n}}
\** faux=2 // vrai = 1 **\
\matrix{mataff=in&nbsp;&nbsp; \(+\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\powx) wint het van&nbsp;&nbsp; \(\ex),2
in&nbsp;&nbsp; \(+\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\ex)&nbsp;&nbsp; wint het van&nbsp;&nbsp; \(\powx),1
in&nbsp;&nbsp; \(-\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\powx)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\ex),2
in&nbsp;&nbsp; \(-\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\ex)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\powx),1
in&nbsp;&nbsp; \(+\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\lnx)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\powx),2
in&nbsp;&nbsp; \(+\infty)&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\powx)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\lnx),1
wanneer \x gaat naar 0&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\lnx)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\powx),2
wanneer \x gaat naar 0&nbsp;&nbsp;&#44;&nbsp;&nbsp; \(\powx)&nbsp;&nbsp; wint het van&nbsp;&nbsp;  \(\lnx),1
}
\text{tmp=shuffle(8)}
\integer{tmp=item(1,\tmp)}
\text{row=row(\tmp,\mataff)}
\text{laff=item(1,\row)}
\integer{rep1=item(2,\row)}
\text{sol1=item(\rep1,waar,onwaar)}
\if{\rep1=1}
{taff=\laff}
{\integer{tmp=\tmp+1}
 \text{row=row(\tmp,\mataff)}
 \text{taff=item(1,\row)} }
\matrix{leslim=
\lim_{\x\to+\infty} \frac{\ex}{\powx},+inf
\lim_{\x\to-\infty} \powx \times \ex,0
\lim_{\x\to+\infty} \frac{\lnx}{\powx},0
\lim_{\x\to 0} \powx \times \lnx,0}
\integer{tmp=\tmp/2}
\text{row=row(\tmp,\leslim)}
\text{lalim=item(1,\row)}
\text{rep2=item(2,\row)}

\steps{reply1
reply2}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 10pt ; background-color: yellow ;">
<p>
Deze oefening behandeld de basis regels mbt de groeisnelheid van 
logaritmische dan wel exponenti&euml;le functies van een gegeven variabele en machten van deze variabele. 
</p>
<b>\special{help saisie,Syntax tips}</b>
</div>

<ul>
\if{\step=1}
{<li>De stelling:<br>  &#171;<b> \laff </b> &#187;  <br>is: \embed{reply1} </li>
}

\if{\step>1}
{<li><font color=blue>De stelling:<br></font> 
&#171;<b> \laff </b>&#187; <font color=blue> is \sol1.</font><br/>
\if{\rep1=2}
{<font color=blue>Er geldt: </font>&#171;<b> \taff </b>&#187;.}
</li>
}

\if{\step=2}
{<li>
Formeel geldt:  \(\lalim ) = \embed{reply2,5}
</li>
}

</ul>
}

\answer{\laff : }{\rep1;waar,onwaar}{type=radio}{option=nonstop}
\answer{\(\lalim ) :}{\rep2}{type=raw}{option=nospace}

\help{
 \if{\help_subject issametext saisie}{
