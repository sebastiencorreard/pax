\title{De limiet van u(x)*ln(kx)}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..8)}
\text{\sa=\a>0?+:-}
\text{\soa=\a>0?-:+}
\integer{b=random(0,0,1,2,3,4)}
\integer{b=random(-1,1)*\b}
\text{bc=\b>0?2:-2}
\text{bc=\b=0?0}
\integer{k=random(-1,1)*random(1..8)}
\function{u1=maxima(expand(\a*x + \b))}
\function{u2=maxima(expand(\a*x + \b)^2)}
\function{u3=1/(\u1)}
\integer{cas=random(1,2,3,3)}
/** interdire x1=1 qui donnerait limite  ln(t)/(t-1) avec t->1**/
\if{\cas=3}{
\rational{x0=-\b/\a}
\rational{x1=\k*\x0}
\if{\x1=1}{\integer{k=-\k}}
}
\text{tk=\k}
\text{tk=\k=-1?-}
\text{tk=\k=1?}
\text{u1=(\u1)}
\text{u=item(\cas,\u1,\u2,\u3)}
\text{u=texmath(\u)}
\text{v=\ln(\tk x)}
\function{f=\u \times \v}
\text{inf=&#8734;}
\text{ic=1}
\if{\k>0}
{
\text{lim1=0}
\text{lim2=+\inf}
\text{tolim1= x \downarrow 0}
\text{tolim2=x\to+\infty}
\text{natlim=van boven benaderd}
}
{
\text{lim2=0}
\text{lim1=-\inf}
\text{tolim2= x \uparrow 0}
\text{tolim1=x\to-\infty}
\text{natlim=van onderen benaderd}
}
\if{\cas=1}{
\text{ulim=\k>0?\b,\b,\sa inf,\sa\infty:\soa inf,\soa\infty,\b,\b}
\text{ucod=\k>0?\bc,\sa\ic:\soa\ic,\bc}
\text{vlim=\k>0?-inf,-\infty,+inf,+\infty:+inf,+\infty,-inf,-\infty}
\text{vcod=\k>0?-1,1:1,-1}
}
\if{\cas=2}{
\integer{b2=(\b)^2}
\integer{tmp=\b=0?0:2}
\text{ulim=\k>0?\b2,\b2,+inf,+\infty:+inf,+\infty,\b2,\b2}
\text{ucod=\k>0?\tmp,1:1,\tmp}
\text{vlim=\k>0?-inf,-\infty,+inf,+\infty:+inf,+\infty,-inf,-\infty}
\text{vcod=\k>0?-1,1:1,-1}
}
\if{\cas=3}
{
\rational{ib=1/(\b)}
\integer{s=\x1>0?1:-1}
\integer{s=\x1=0?0}
\if{\k>0}
{\text{lim1=\s>0?\x0}
\text{tolim1=\s>0? x \downarrow \x0}}
{\text{lim2=\s>0? \x0}
\text{tolim2=\s>0? x \uparrow \x0 }}
\if{\k>0}{
\text{tmp=\s>=0?\sa inf,\sa\infty:\ib,\ib}
\text{tc=\s>=0?\sa\ic:\bc}}
{\text{tmp=\s>=0?\soa inf,\soa\infty:\ib,\ib}
\text{tc=\s>=0?\soa\ic:\bc}}
\text{ulim=\k>0?\tmp,0,0:0,0,\tmp}
\text{ucod=\k>0?\tc,0:0,\tc}
\text{c=ln(\x1)}
\text{tc=\ln(\x1)}
\text{cc=\x1>1?2:-2}
\text{cc=\x1=1?0}
\if{\k>0}{\text{vlim=\s=1?\c,\tc,+inf,+\infty:-inf,-\infty,+inf,+\infty}
          \text{vcod=\s=1?\cc,1:-1,1}}
         {\text{vlim=\s=1?+inf,+\infty,\c,\tc:+inf,+\infty,-inf,-\infty}
          \text{vcod=\s=1?1,\cc:1,-1}}
}
\text{ensdef=&#93;  \lim1 ; \lim2 &#91; }
\text{rep1=item(1,\ulim)}
\text{rep2=item(3,\ulim)}
\text{sol1=item(2,\ulim)}
\text{sol2=item(4,\ulim)}
\text{rep3=item(1,\vlim)}
\text{rep4=item(3,\vlim)}
\text{sol3=item(2,\vlim)}
\text{sol4=item(4,\vlim)}
\integer{ul1=item(1,\ucod)}
\integer{ul2=item(2,\ucod)}
\integer{vl1=item(1,\vcod)}
\integer{vl2=item(2,\vcod)}
\integer{tmp=\ul1*\vl1}
\integer{rep5=\tmp=0?2:1}
\text{sol5=item(\rep5,regel mbt limiet van producten,het principe van de winnende functie)}
\if{\tmp=0}{\text{fl1=0,0}}
{\if{\tmp>0}{\text{fl1=+inf,+\infty}}{\text{fl1=-inf,-\infty}}}
\integer{tmp=\ul2*\vl2}
\integer{rep7=\tmp=0?2:1}
\if{\tmp=0}{\text{fl2=0,0}}
{\if{\tmp>0}{\text{fl2=+inf,+\infty}}{\text{fl2=-inf,-\infty}}}
\text{rep6=item(1,\fl1)}
\text{sol6=item(2,\fl1)}
\text{rep8=item(1,\fl2)}
\text{sol8=item(2,\fl2)}

\steps{reply1,reply2
reply3,reply4
reply5,reply6
reply7,reply8
}



\statement{

<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
We nemen de functie \(f(x) = \f ) gedefinieerd op \ensdef. <br/>                                                                           
De bedoeling van deze oefening is om stap voor stap de limieten van \(f) in \lim1 en in \lim2 te berekenen. 

</p>
<small><b>\special{help saisie,Syntax tip}</b></small>
</div>


<ul>

\if{\step=1}
{
<li> 
Laat \(u) de functie \( u(x) = \u) zijn, gedefinieerd in \ensdef.
 <br/>  
Bepaal de limieten van \(u) in \lim1 en in \lim2 : 
<small>(\special{help saisie,Syntax tip})</small>
<center>\(\lim_{\tolim1} \u ) = \embed{reply1,5} <br>en<br> \(\lim_{\tolim2} \u ) = \embed{reply2,5}  </center>
</li>
}
\if{\step>1}
{<li><font color = blue>De limieten van  \(u) in \lim1 en in \lim2 zijn</font>:
<center>\(\lim_{\tolim1} \u = \sol1) &nbsp; en &nbsp; \(\lim_{\tolim2} \u = \sol2)  </center>
</li>
}

\if{\step=2}
{
<li> Nu gaan we de limieten van  \(\v) op  \lim1 en in \lim2 bepalen : 
 <small>(\special{help saisie,Syntax tip})</small>
<center>\(\lim_{\tolim1} \v ) = \embed{reply3,5} <br>en<br> \(\lim_{\tolim2} \v ) = \embed{reply4,5}  </center>
</li>
}
\if{\step>2}
{<li><font color = blue>De limieten van de logaritmische functie in \lim1 en in \lim2 zijn</font>:
<center>\(\lim_{\tolim1} \v = \sol3)  &nbsp; en &nbsp;  \(\lim_{\tolim2} \v = \sol4)  </center>
</li>
}


\if{\step=3}
{<li>Uit de voorafgaande berekeningen kunnen we de limiet van \(f) in \lim1 afleiden door \embed{reply5} te gebruiken:
<center>\( \lim_{\tolim1} \f)   = \embed{reply6,5}
</li> 
}


\if{\step>3}
{<li>Uit de voorafgaande berekeningen en \sol5 kunnen we herleiden dat</font>:
<center>\( \lim_{\tolim1} \f = \sol6)  
</li>
}



\if{\step=4}
{<li>
Uit de voorafgaande berekeningen kunnen we - met \embed{reply7} - de limiet van \(f) in \lim2 herleiden : 
<center>\( \lim_{\tolim2} \f)   = \embed{reply8,5}
</li> 
}


</ul>
}
\answer{De limiet van \(u) op \lim1 is gelijk aan}{\rep1}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(u) op \lim2 is gelijk aan }{\rep2}{type=raw}{option=nospace,nonstop}
\answer{De limiet van exp(\tk x) op \lim1 is gelijk aan}{\rep3}{type=raw}{option=nospace,nonstop}
\answer{De limiet van exp(\tk x) op \lim2 is gelijk aan}{\rep4}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(f) op \lim1 berekend aan de hand van}{\rep5;regel mbt limiet van producten,het principe van de winnende functie}{type=select}{option=nonstop}
\answer{De limiet van \(f) op \lim1 is gelijk aan}{\rep6}{type=raw}{option=nospace,nonstop}
\answer{De limiet van \(f) op \lim1 berekend aan de hand van}{\rep7;regel mbt limiet van producten,het principe van de winnende functie}{type=select}{option=nonstop}
\answer{De limiet van \(f) op \lim2 is gelijk aan}{\rep8}{type=raw}{option=nospace}



\solution{ }
\help{
<b>Syntax tips:</b><br/> 
Bereik en Domein notatie:<br> 
&#93; -inf ; 5 &#93; == &lt;-inf : 5&#93;<br> 
&#93; -5 ; 5 &#91; == &lt; -5 : 5 &gt; 
<br> 
schrijf <b>+inf</b> voor \(+\infty) ;<br/> 
schrijf <b>-inf </b> voor \(-\infty) ;<br/> 
schrijf <b>exp(x)</b> voor \(e^{x}) ;<br/> 
(<font color=red>gebruik niet e^x </font>)  
 \if{\help_subject issametext product}{Met "produkt" bedoelen we: de rekenregels voor de limieten van produkten. 
 Dat wil zeggen: de limiet van een produkt is gelijk aan het produkt der limieten (uitgezonderd de tussenvormen) 
} 
}
