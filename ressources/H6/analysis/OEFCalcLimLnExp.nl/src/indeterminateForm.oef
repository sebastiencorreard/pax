\title{Onbepaalde vorm met ln of exp}
\language{nl}
\range{-5..5}
\author{Véronique Royer}
\email{veronique.royer@orange.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a = random(-1,1)*random(1..5)}
\integer{b = random(-8..8)}
\integer{c= random(-1,1)*random(1..5)}
\integer{d = random(-8..8)}
\text{sk=random(-,+)}
\integer{op=random(1..4)}


\function{u=maxima(expand(\a*x + \b))}
\function{v=maxima(expand(\c*x + \d))}
\text{u=texmath(\u)}
\text{v=texmath(\v)}
\integer{cas=random(1,2)}
\text{g=\cas=1?e^{t}:\ln(t)}
\text{gg=\cas=1?e^{u}:\ln(u)}
\text{ggx=\cas=1?e^{u(x)}:\ln(u(x))}
\function{gdeu=\cas=1?e^{\u}:\ln(\u)}
\text{f=item(\op,\v \sk  \gdeu,(\v)\times \gdeu, \frac{\v}{\gdeu},\frac{\gdeu}{\v})}
\text{ff=item(\op,v \sk  \gg, v \times \gg, \frac{v}{\gg},\frac{\gg}{v})}
\text{tf=texmath(\f)}
\rational{x0=-\b/\a}
\text{inf=&#8734;}
\text{sx=\cas=1?random(-,+)}
\text{sx=\cas=2 and \a>0?+}
\text{sx=\cas=2 and \a<0?-}
\integer{ssx=(\sx issametext +)?1:-1}
\text{xlim=\sx\inf}
\text{texlim=\sx\infty}
\text{ensdef=\cas=2 and \a>0?&#93;  \x0 ; \xlim &#91;}
\text{ensdef=\cas=2 and \a<0? &#93;\xlim ; \x0 &#91; }
\text{ensdef=\cas=1?\RR}
\text{vlim=(\c*\ssx)>0?+inf,+\infty,1:-inf,-\infty,-1}
\text{rep1=item(1,\vlim)}
\text{sol1=item(2,\vlim)}
\text{ulim=(\a*\ssx)>0?+inf,+\infty:-inf,-\infty}
\text{rep2=item(1,\ulim)}
\text{sol2=item(2,\ulim)}
\text{glim=\cas=1 and \rep2 issametext -inf?0,0,0:+inf,+\infty,1}
\text{rep3=item(1,\glim)}
\text{sol3=item(2,\glim)}
\text{rep4=\rep3}
\text{sol4=\sol3}
\text{\typeindet=Ja omdat er geen onbepaalde vorm is,
Nee omdat er een onbepaalde vorm is: 0 * \inf, 
Nee omdat er een onbepaalde vorm is: 0 / 0,
Nee omdat er een onbepaalde vorm is:  \inf / \inf ,
Nee omdat er een onbepaalde vorm is: -\inf + (+\inf)
}
\text{\fi=, 0 x \inf,  0 / 0, \inf / \inf , -\inf + (+\inf)}
\integer{tmp=item(3,\vlim)}
\integer{tmp2=item(3,\glim)}
\integer{tmp=\tmp*\tmp2}
\text{rep5=1}
\text{rep5=\op=1 and \sk issametext + and \tmp<0?5}
\text{rep5=\op=1 and \sk issametext - and \tmp>0?5}
\text{rep5=\op=2 and \tmp=0?2}
\text{rep5=\op>2 and \tmp!=0?4}
\text{lafi=item(\rep5,\fi)}
\matrix{filims=\rep4,\rep1
\rep4,\rep1
0,\rep1
\rep4,0}
\if{\rep5=1}
{\text{sol6=\op!=4?\rep1:0}}
{\text{tmp=row(\op,\filims)}
 \text{sol6=item(\cas,\tmp)}
}
\steps{reply1
reply2
reply3
reply4
reply5
reply6}

\statement{
<div style="font-family: verdana,  sans-serif ;  font-size: 11pt ; background-color: yellow ;">
<p> 
Laat de functie \(f) in \(\ensdef) gedefinieerd zijn door:
\(f(x) = \f).
</p><p>
De we hebben \(f = \ff )  waarbij, voor elke re&euml;ele \(x) in \(\ensdef) geldt, 
\(u(x) = \u)  &nbsp; en  &nbsp; \(v(x) = \v).
</p><p>
De bedoeling van deze oefening is het stap voor stap bepalen van de limiet van 
\(f) in \xlim.
</p>
<small><b>\special{help saisie,Syntax tips}</b></small>
</div>

<ul>



\if{\step=1}
{<li>Bepaal de limiet van \(v) in \xlim : 
<center>\(\lim_{x\to\texlim} \v ) = \embed{reply1,5}</center>
</li>}
\if{\step>1}
{<li><font color = blue> De limiet van  \(v) in \xlim is</font>:  
<center>\(\lim_{x\to\texlim} v(x) = \lim_{x\to\texlim} \v  = \sol1)</center>
</li>
}


\if{\step=2}
{<li>Bepaal de limiet van \(u) in \xlim : 
<center>\(\lim_{x\to\texlim} \u ) = \embed{reply2,5}</center>
</li>
}
\if{\step>2}
{<li><font color = blue> De limiet van \(u) in \xlim  is</font>:  
<center>\(\lim_{x\to\texlim} u(x) = \lim_{x\to\texlim} \u  = \sol2)</center>
</li>
}


\if{\step=3}
{<li>Bepaal de limiet van  \(\g) in \(\sol2) : 
<center>\(\lim_{t\to\sol2} \g ) = \embed{reply3,5}</center>
</li>
}


\if{\step=4}
{<li>Door substitutie van \(t = \u), en het gegeven \(\lim_{t\to\sol2} \g  = \sol3), concluderen we: 
<center>\( \lim_{x\to\texlim} \gdeu ) = \embed{reply4,5}</center>
</li> 
}
\if{\step>4}
{<li>
<font color = blue>De limiet van \(\gg) in \xlim is</font>:
<center>\(\lim_{x\to\texlim} \ggx =\lim_{x\to\texlim} \gdeu  = \lim_{t\to\sol2} \g = \sol4). </center> 
</li>
}

\if{\step=5}
{<li>
Kunnen we nu de limiet van \(f = \ff) in \xlim afleiden door gebruik te maken van de "limieten rekenregels" ?
<center>\embed{reply5,size=5}</center> 
</li>
}

\if{\step=6}
{<li><font color=blue>
\if{\rep5=1}{
De "limieten rekenregels" zijn van toepassing, omdat er geen onbepaalde vorm is.</font> }
{De "limieten rekenregels" zijn <b>niet</b> van toepassing, vanwege de onbepaalde vorm: \lafi .
</font> <br/> In plaats daarvan gebruiken we de "algemene groei" regels:
<i>\if{\cas=1}{de exponentiele functie groeit harder dan een polynoom }{elke polynoom groeit harder dan een logaritmische functie}.</i>
.}
<br/>
Hieruit volgt:
<center>\(\lim_{x\to\texlim} f(x)) = \embed{reply6,5} </center>
</li>} 

</ul>
}

\answer{de limiet van v : }{\rep1}{type=raw}{option=nospace,nonstop}
\answer{de limiet van u : }{\rep2}{type=raw}{option=nospace,nonstop}
\answer{de limiet van \(\g) : }{\rep3}{type=raw}{option=nospace,nonstop}
\answer{de limiet van \(\gg) : }{\rep4}{type=raw}{option=nospace,nonstop}
\answer{de onbepaalde vorm :}{\rep5;\typeindet}{type=select}{option=nonstop}
\answer{de limiet van f : }{\sol6}{type=raw}{option=nospace}



\solution{ }

\help{
  
 \if{\help_subject issametext saisie}{
<b>Syntax tips:</b><br/>
schrijf <b>+inf</b> voor \(+\infty)  ;<br/> schrijf  <b>-inf</b> voor \(-\infty). 
   }
}
