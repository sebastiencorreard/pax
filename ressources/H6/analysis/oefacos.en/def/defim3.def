val24=$val7$val10 &#44; $val11$val6
val25=$val6$val8 &#44; $val9$val7
val26=$val7$val8 &#44; $val9$val6
val27=$val6 0 &#44; $val9$val7
val28=$val7 0 &#44; $val9$val6
tmp=!translate internal $	$ to ; in 	arcsin(cos(x)), $val26,  $val23	arccos(sin(x)), $val26,  $val16	sin(arccos(x)), $val12,  $val18	cos(arcsin(x)), $val12,  $val18	tan(arcsin(x)), $val13,  $val26	sin(arctan(x)), $val26,  $val13	cos(arctan(x)), $val26,  $val20	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)
val29=!translate internal $	\
$ to ;; in $tmp
val30=$val12,$val13,$val14,$val15,$val16,$val17,$val23,$val24,$val25,$val26,$val18,$val19,$val21,$val22,$val27,$val28,$val20
val31=110x60
replytype1=clickfill
replyname1=Intervalle de définition
replygood1=$(val29[2]);$val30
replytype2=clickfill
replyname2=Image
replygood2=$(val29[3]);$val30
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

