!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=&#91;
val7=&#93;
val8=\(-infty)
val9=\(infty)
val10=\(-pi/2)
val11=\(pi/2)
val12=$val6 -1 &#44; 1 $val7
val13=$val7 -1 &#44; 1 $val6
val14=$val6\(-pi) &#44; \(pi)$val7
val15=$val7\(-pi) &#44; \(pi)$val6
val16=$val6 0 &#44; \(pi)$val7
val17=$val7 0 &#44; \(pi)$val6
val18=$val6 0 &#44; 1$val7
val19=$val7 0 &#44; 1$val6
val20=$val7 0 &#44; 1$val7
val21=$val6-1 &#44; 0$val7
val22=$val7-1 &#44; 0$val6
