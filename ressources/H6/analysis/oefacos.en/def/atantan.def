!set title=arctg(tg)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!random 10, 150

val6=$[$(tmp0)*floor($(tmp1))/10]
val7=$[$val6+pi/2]
val8=$[floor($val7/pi)]
val9=$[$val6]
val10=$[-($val8)]
replyname1=\(a\)
replygood1=$val9
replyname2=\(b\)
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compute 
!insmath x=arctg(tg($val6))
$(), writing it under the form	
!insmath x = a + b pi
$(), where 
!insmath a
$() and 
!insmath b
$()	are rational numbers.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=0
