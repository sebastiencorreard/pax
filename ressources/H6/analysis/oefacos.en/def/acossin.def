!set title=arccos(sin)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -1,1

tmp1=!random 10, 150

val6=$[$(tmp0)*floor($(tmp1))/10]
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]
tmp0=!item $val7 of 0,pi/2

val8=$[$(tmp0)]
tmp0=!item $val7 of cos,sin

val9=$(tmp0)
tmp0=!item $val7 of sin,cos

val10=$(tmp0)
val11=$[$val6+$val8]
val12=$[floor($val11/pi)]
val13=$[floor($val12/2)]

!ifval $val12%2=0
val14=$[-$val6]
!else
val14=$[$val6]
!endif
tmp0=!item $val7 of -1.5,-0.5

val15=$[$(tmp0)]

!ifval $val12%2=0
val16=$[2*$val13+0.5]
!else
val16=$[-2*$val13+$val15]
!endif
replyname1=\(a\)
replygood1=$val14
replyname2=\(b\)
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compute 
!insmath x=arc$val10($val9($val6))
$(), writing it under the form	
!insmath x = a + b \pi
$(), where 
!insmath a
$() and 
!insmath b
$()	are rational numbers.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10
embedcnt=0
