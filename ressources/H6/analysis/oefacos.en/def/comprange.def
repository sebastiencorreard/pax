!set title=Composed range
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=arccos(cos(x)),arcsin(sin(x)),arccos(sin(x)),arcsin(cos(x)),cos(arccos(x)),	 sin(arcsin(x)),cos(arcsin(x)),sin(arccos(x)),cos(-arcsin(x)),sin(-arccos(x)),	 tg(arctg(x)),arctg(sin(x))		
val7=-F,-F,-F,-F,-1, -1,-1,-1,-1,-1,	 -F,-F,	
val8=F,F,F,F,1,  1,1,1,1,1,	 F,F,	
val9=0,-pi/2,0,-pi/2,-1, -1,0,0,0,-1,	 -F,-pi/4,	
val10=pi,pi/2,pi,pi/2,1, 1,1,1,1,0,	 F,pi/4,	
tmp0=!itemcnt $val6

tmp1=!randint 1, $(tmp0)

val11=$[rint($(tmp1))]
tmp0=!item $val11 of $val6

val12=$(tmp0)
tmp0=!item $val11 of $val7

val13=$(tmp0)
tmp0=!item $val11 of $val8

val14=$(tmp0)
tmp0=!item $val11 of $val9

val15=$(tmp0)
tmp0=!item $val11 of $val10

val16=$(tmp0)
replyname1=\(a\)
replygood1=$val13,F
replyname2=\(b\)
replygood2=$val14,F
replyname3=\(c\)
replygood3=$val15,F
replyname4=\(d\)
replygood4=$val16,F
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Consider the function 
!insmath f
$() defined by 
!insmath f(x) = $val12
$(). Determine the (maximal) interval	of definition 
!insmath I
$() and the image interval 
!insmath J
$() of $m_if.	<div class="wims_instruction">	To give your reply, let 
!insmath I=\ [a,b]
$() (open or closed), 
!insmath J=\ [c,d]
$()	(open or closed). Write "<span class="tt">pi</span>", "<span class="tt">F</span>" or	"<span class="tt">-F</span>" to designate	
!insmath \pi
$(), 
!insmath \infty
$() or 
!insmath -\infty
$().	</div>	
$()
