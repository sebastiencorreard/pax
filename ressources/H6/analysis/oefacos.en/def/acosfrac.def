tmp0=!randitem Arcsin, Arccos

val6=$(tmp0)
tmp0=!randint 4, 7

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]

!ifval $val7=$val9
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val9=$[rint( $val7 +($(tmp0)*$(tmp1)))]
!endif

!ifval $val7=-$val9
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val9=$[rint( -($val7) +($(tmp0)*$(tmp1)))]
!endif
tmp0=!randint 1, 7

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in (($val7)*x+($val8))/(($val9)*x+($val10))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)
tmp0=!texmath $val11

val12=$(tmp0)
val13=(($val7)-($val9))*x+($val8)-($val10)
val14=$[rint(($val7)-($val9))]
val15=$[rint(($val8)-($val10))]
val16=(($val7)+($val9))*x+($val8)+($val10)
val17=$[rint(($val7)+($val9))]
val18=$[rint(($val8)+($val10))]
val19=$[max(-($val15)/($val14), -($val10)/($val9))]
val20=$[min(-($val15)/($val14), -($val10)/($val9))]
val21=$[max(-($val18)/($val17), -($val10)/($val9))]
val22=$[min(-($val18)/($val17), -($val10)/($val9))]
val23=$[max($val19,$val21)]
val24=$[min($val20,$val22)]
val25=$[max($val19,$val22)]
val26=$[min($val21,$val20)]

!ifval ($val14)*($val9)>0 and ($val17)*($val9)<0 
val27=	$val24, $val23
!endif

!ifval ($val14)*($val9)>0 and ($val17)*($val9)>0 
val27=	$val20, $val22	$val21,$val19	 
!endif

!ifval ($val14)*($val9)<0 and ($val17)*($val9)>0 
val27=	-inf,$val24	 $val23,inf	
!endif

!ifval ($val14)*($val9)<0 and ($val17)*($val9)<0 
val27=	 $val22,$val26	 $val25, $val21	
!endif
tmp=!translate internal $	$ to ; in $val27

tmp0=!rowcnt $tmp
val28=$[rint($(tmp0))]
val29=
!for val30 =1 to $val28 
tmp=!translate internal $	$ to ; in $val27

tmp=!row $val30 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val31=$(tmp0)
tmp0=!item 1 of $val31

tmp1=!item 2 of $val31

tmp2=!item 1 of $val31

tmp3=!item 2 of $val31


!ifval $(tmp0)<$(tmp1) or inf isin $(tmp2) or inf isin $(tmp3) 
tmp=!trim  $val29	$val31
val29=!translate internal $	\
$ to ;; in $tmp
!endif
!next
tmp=!translate internal $	$ to ; in $val29

tmp0=!rowcnt $tmp
val32=$[rint($(tmp0))]
val33=$val29
!if $val32=2 
tmp=!translate internal $	$ to ; in $val29

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 2 of $(tmp0) 

tmp=!translate internal $	$ to ; in $val29

tmp=!row 2 of $tmp
tmp2=!translate internal $\
$ to ; in $tmp
tmp3=!item 1 of $(tmp2) 


!ifval $(tmp1)>= $(tmp3)
tmp=!translate internal $	$ to ; in $val29

tmp=!row 1 of $tmp
tmp4=!translate internal $\
$ to ; in $tmp
tmp5=!item 1 of $(tmp4)

tmp=!translate internal $	$ to ; in $val29

tmp=!row 2 of $tmp
tmp6=!translate internal $\
$ to ; in $tmp
tmp7=!item 1 of $(tmp6)

tmp=!translate internal $	$ to ; in $val29

tmp=!row 1 of $tmp
tmp8=!translate internal $\
$ to ; in $tmp
tmp9=!item 2 of $(tmp8)

tmp=!translate internal $	$ to ; in $val29

tmp=!row 2 of $tmp
tmp10=!translate internal $\
$ to ; in $tmp
tmp11=!item 2 of $(tmp10)

val33=	 min($(tmp5), $(tmp7)),max($(tmp9), $(tmp11))
!endif
!endif
tmp=!translate internal $	$ to ; in $val29

tmp0=!rowcnt $tmp
val32=$[rint($(tmp0))]
val34=
!for val30 =1 to $val32 
tmp=!translate internal $	$ to ; in $val33

tmp=!row $val30 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 1 of $(tmp0)

tmp=!translate internal $	$ to ; in $val33

tmp=!row $val30 of $tmp
tmp2=!translate internal $\
$ to ; in $tmp
tmp3=!item 1 of $(tmp2)


!ifval $(tmp1)<-($val10)/($val9) and	-($val10)/($val9)< $(tmp3) 
tmp=!translate internal $	$ to ; in $val33

tmp=!row $val30 of $tmp
tmp4=!translate internal $\
$ to ; in $tmp
tmp5=!item 1 of $(tmp4)

tmp=!translate internal $	$ to ; in $val33

tmp=!row $val30 of $tmp
tmp6=!translate internal $\
$ to ; in $tmp
tmp7=!item 1 of $(tmp6)

val34= $val34	$(tmp5), -($val10)/($val9)	-($val10)/($val9), $(tmp7)
!else
val34=	$val33
!endif
!next

!ifval $val32=2 
tmp=!translate internal $	$ to ; in $val34

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val35= $(tmp0)
!else
val35=$val34
!endif

!ifval $val32=2
tmp=!translate internal $	$ to ; in $val34

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val36= $(tmp0)
!endif
tmp0=!item 1 of $val35

val37=$(tmp0)
tmp0=!item 2 of $val35

val38=$(tmp0)
tmp0=!item 1 of $val36

val39=$(tmp0)
tmp0=!item 2 of $val36

val40=$(tmp0)

!ifval $val32=1
tmp=!trim  reply 1	reply 2, reply 3	
val41=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim reply 1	reply 2, reply 3, reply 4 ,reply 5
val41=!translate internal $	\
$ to ;; in $tmp
!endif

!ifval $val32=2 
val42= \(\rbrack)
!else
val42=\(\lbrack)
!endif
oefsteps=$val41 
