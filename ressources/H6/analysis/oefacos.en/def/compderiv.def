!set title=Composed differentiability
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Yes
val7=No
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!item $val8 of cos,sin,cos,sin

val9=$(tmp0)
tmp0=!item $val8 of cos,cos,sin,sin

val10=$(tmp0)
tmp0=!item $val8 of 0,0,pi/2,pi/2

val11=$[$(tmp0)]
val12=$val6,$val7
tmp0=!randint 1, 19

val13=$[rint($(tmp0))]
val14=$[rint($val13+2)]
tmp0=!randitem -1,1

val15=$[rint($(tmp0))]

!ifval $val15<0
val16=$[rint(-$val14)]
!else
val16=$[rint($val13)]
!endif

!ifval $val15<0
val17=$[rint(-$val13)]
!else
val17=$[rint($val14)]
!endif
val18=$[rint(floor(($val16+$val11)/pi))]
val19=$[rint(floor(($val17+$val11)/pi))]

!ifval $val18=$val19
val20=$val6
!else
val20=$val7
!endif
choicename1=Reply
choicegood1=$val20
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Is the function 
!insmath f
$() definded by 
!insmath f(x)=arc$val9($val10(x))
$() differentiable	in the interval [$val16,$val17]&nbsp;?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,16,17
embedcnt=0
