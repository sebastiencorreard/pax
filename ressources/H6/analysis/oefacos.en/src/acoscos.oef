\title{arccos(cos)}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{x=random(-1,1)*floor(random(10..150))/10}
\integer{ra=random(1,2)}
\real{add=item(\ra,0,pi/2)}
\text{cos=item(\ra,cos,sin)}
\real{r=\x+\add}
\real{c=floor(\r/pi)}
\real{d=floor(\c/2)}
\real{a=\c%2=0?\x:-\x}
\integer{e=item(\ra,2,1)}
\real{b=\c%2=0?-2*\d:2*\d+\e}

\statement{Compute \(x = arc\cos(\cos(\x))\), writing it under the form
\(x = a + b pi), where \(a\) and \(b\)
are rational numbers.
}

\answer{\(a\)}{\a}
\answer{\(b\)}{\b}

