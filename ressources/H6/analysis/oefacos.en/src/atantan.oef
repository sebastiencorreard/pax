\title{arctg(tg)}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{x=random(-1,1)*floor(random(10..150))/10}
\real{r=\x+pi/2}
\real{c=floor(\r/pi)}
\real{a=\x}
\real{b=-(\c)}

\statement{Compute \(x=arctg(tg(\x))\), writing it under the form
\(x = a + b pi), where \(a\) and \(b\)
are rational numbers.
}

\answer{\(a\)}{\a}
\answer{\(b\)}{\b}
