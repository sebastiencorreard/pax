\title{Composed differentiability}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{tyes=Yes}
\text{tno=No}

\integer{ra=random(1..4)}
\text{cos1=item(\ra,cos,sin,cos,sin)}
\text{cos2=item(\ra,cos,cos,sin,sin)}
\real{add=item(\ra,0,0,pi/2,pi/2)}
\text{bad=\tyes,\tno}
\integer{t=random(1..19)}
\integer{s=\t+2}
\integer{sign=random(-1,1)}
\integer{a=\sign<0?-\s:\t}
\integer{b=\sign<0?-\t:\s}
\integer{f1=floor((\a+\add)/pi)}
\integer{f2=floor((\b+\add)/pi)}
\text{good=\f1=\f2?\tyes:\tno}

\statement{Is the function \(f\) definded by \(f(x)=arc\cos1(\cos2(x))\) differentiable
in the interval [\a,\b]&nbsp;?
}

\choice{Reply}{\good}{\bad}

