\title{Right triangle}
\language{en}
\range{-5..5}
\author{Gang ,XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{ab=randint(30..100)}
\integer{ac=random(\ab/4..\ab/2)}
\integer{speed=randint(2..20)}
\integer{r=random(10..30)}
\real{sol=\speed*\ac/sqrt(\ac^2+\ab^2)}
\integer{dir=random(1,2)}
\text{direction=\dir=1?increases:decreases}
\real{sol=\dir=1?\sol:-\sol}
\text{unit=random(cm,mm,m)}

\statement{We have a right triangle as follows, where
AB=\ab \unit, and AC \direction at a constant speed of \speed \unit/s.
At the moment when AC=\ac \unit, what is the speed at which
BC changes (in \unit/s)?
<div class="wimscenter"><img src="\imagedir/pic.gif" alt="image" /></div>
}

\answer{Speed of BC in \unit/s}{\sol}
