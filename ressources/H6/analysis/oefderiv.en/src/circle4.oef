\title{Circle IV}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)}
\real{r=randint(10..30)}
\real{area=pi*\r^2}
\real{sol=\a/sqrt(4*pi*\area)}

\statement{We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?
}

\answer{Radius speed}{\sol}

