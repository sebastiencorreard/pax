\title{Circle III}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)}
\integer{area=randint(30..150)}
\real{sol=\a/sqrt(4*pi*\area)}

\statement{We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when the area equals \area
cm<sup>2</sup>, what is the speed at which its radius increases (in cm/s)?
}

\answer{Radius speed}{\sol}

