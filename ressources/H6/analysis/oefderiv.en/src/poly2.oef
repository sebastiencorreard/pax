\title{Polynomial II}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..200)/10*random(-1,1)}
\real{b=randint(20..200)/10*random(-1,1)}
\real{c=randint(20..200)/10*random(-1,1)}
\function{p=(x+\a)*(x+\b)*(x+\c)}
\text{hp=texmath(\p)}
\function{der=diff(\p,x)}

\statement{Compute the derivative of the function \(f\) defined by
\(f(x) = \hp\).}

\answer{\(f '(x)\)}{\der}{type=formal}
