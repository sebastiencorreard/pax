\title{Circle II}
\language{en}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)/10}
\integer{area=randint(10..40)}
\real{r=sqrt(\area/pi)}
\real{sol=2*pi*\r*\a}

\statement{We have a circle whose radius increases at a constant speed of
\a centimeters per second. At the moment when its area equals \area
square centimeters,
what is the speed at which the area increases (in \(cm^2\)/s)?
}

\answer{Area speed}{\sol}
