\title{Circle}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\real{a=randint(20..100)/10}
\integer{r=random(10..30)}
\real{sol=2*pi*\r*\a}

\statement{We have a circle whose radius increases at a constant speed of
\a centimeters per second. At the moment when the radius equals \r centimeters,
what is the speed at which its area increases (in \(cm^2\)/s)?
}

\answer{Area speed}{\sol}
