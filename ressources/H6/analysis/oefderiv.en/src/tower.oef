\title{Tower}
\language{en}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\real{speed=randint(11..25)/10}
\integer{height=randint(100..200)}
\integer{dist=randint(100..300)}
\real{sol=\speed*\dist/sqrt(\dist^2+\height^2)}

\statement{Somebody walks towards a tower at a constant speed of
\speed meters per second. If the height of the tower is \height meters,
at what speed (in m/s) does the distance between the man and the top of the tower
decrease, when the distance between him and the foot of the tower is
\dist meters?
}

\answer{Speed rate}{\sol}
