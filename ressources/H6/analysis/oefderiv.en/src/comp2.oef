\integer{b14=random(-3..3)}
\integer{b15=random(-3..3)}
\integer{b16=random(-3..3)}
\integer{b17=random(-3..3)}
\integer{b21=random(-\range..\range)}
\integer{b22=random(-\range..\range)}
