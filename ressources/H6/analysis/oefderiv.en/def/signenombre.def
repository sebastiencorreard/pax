tmp0=!randitem $tmp
tmp1=!randitem 1,-1

val20=$[$(tmp0)*$(tmp1)]
val21=$[-($val20)]
val22=$[1+$val20]
val23=$[1-$val20]
val24=$[2+$val20]
val25=$[2-$val20]

!ifval $val20>0
val26=[0,$val20]
!else
val26=[$val20,0]
!endif
tmp0=!replace internal x+1 by $val22 in $val13

val27=$(tmp0)
tmp0=!replace internal x+2 by $val24 in $val27

val27=$(tmp0)
tmp0=!mathsubst x=$val20 in $val27

val27=$(tmp0)
tmp0=!replace internal x+1 by $val23 in $val14

val28=$(tmp0)
tmp0=!replace internal x+2 by $val25 in $val28

val28=$(tmp0)
tmp0=!mathsubst x=$val21 in $val28

val28=$(tmp0)
tmp0=!mathsubst x=-x in $val14

val14=$(tmp0)
tmp0=!randitem 1,2

val29=$(tmp0)
tmp0=!item $val29 of $val13 $val19 $val14,$val14 $val19 $val13

val30=!rawmath $(tmp0)
tmp0=!item $val29 of $val27 $val19 $val28,$val28 $val19 $val27

val31=!rawmath $(tmp0)
evaltmp=$val30

evaltmp=!mathsubst x=(0) in $evaltmp
tmp0=($evaltmp)
val32=$[$(tmp0)]
!if $val32 != 0 
val30=!rawmath $val30 - $val32
val31=!rawmath $val31 - $val32
!endif
tmp0=!mathsubst x=-x in $val30

val33=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val30,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val34=!rawmath $(tmp0)
tmp=!translate ;";': to $     $ in $val33,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
