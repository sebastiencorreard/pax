!set title=Rectangle VI
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=en
computeanswer=no
precision=10000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$(tmp0)
tmp0=!item $val6 of increases,decreases

val7=$(tmp0)
tmp0=!item $val6 of +,-

val8=$(tmp0)
tmp0=!randint 15, 50

val9=$[$(tmp0)/10]
tmp0=!randitem 1,2

val10=$(tmp0)
tmp0=!item $val10 of length,width

val11=$(tmp0)
tmp0=!randint 10, 30

val12=$[rint($(tmp0))]
tmp0=!randint $val12+5, 2*$val12+10

val13=$[rint($(tmp0))]
val14=$[rint(2*($val12+$val13))]
val15=$[rint($val12*$val13)]
val16=area
val17=$val15
val18=square centimeters
val19=$val11
tmp0=!item $val10 of width,length

val20=the $(tmp0)
tmp0=!item $val10 of $val12,$val13

val21=$(tmp0)
val22=centimeters
tmp0=!item $val10 of $val13,$val12

val23=$[$(tmp0)]
val24=$[$val8 2*(1-$val15/($val23^2))*$val9]
val25=cm/s
val26=its perimeter
replyname1=The speed
replygood1=$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We have a rectangle	whose $val19 $val7 at a constant speed of $val9 centimeters per second,	but whose $val16 stays constant at $val17 $val18.	At the moment when $val20 equals $val21 $val22,	what is the speed (in $val25) at which $val26 changes?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,16,17,18,19,20,21,22,25,26
embedcnt=0
