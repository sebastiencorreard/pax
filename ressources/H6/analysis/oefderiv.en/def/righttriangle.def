!set title=Right triangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang ,XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 30, 100

val6=$[rint($(tmp0))]
tmp0=!randint $val6/4, $val6/2

val7=$[rint($(tmp0))]
tmp0=!randint 2, 20

val8=$[rint($(tmp0))]
tmp0=!randint 10, 30

val9=$[rint($(tmp0))]
val10=$[$val8*$val7/sqrt($val7^2+$val6^2)]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]

!ifval $val11=1
val12=increases
!else
val12=decreases
!endif

!ifval $val11=1
val10=$[$val10]
!else
val10=$[-$val10]
!endif
tmp0=!randitem cm,mm,m

val13=$(tmp0)
replyname1=Speed of BC in $val13/s
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We have a right triangle as follows, where	AB=$val6 $val13, and AC $val12 at a constant speed of $val8 $val13/s.	At the moment when AC=$val7 $val13, what is the speed at which	BC changes (in $val13/s)?	<div class="wimscenter"><img src="$val1/pic.gif" alt="image" /></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,7,8,12,13
embedcnt=0
