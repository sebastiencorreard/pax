val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(15)]
tmp0=!randint -$val6, $val6

val7=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val8=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val9=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val10=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val11=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val12=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val13=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val14=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val15=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val16=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val17=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val18=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val19=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val20=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val21=$[rint($(tmp0))]
tmp0=!randint -2, 2

val22=$[rint($(tmp0))]
tmp0=!item $val22+3 of $val7,$val8,$val9,$val10,$val11

val23=$[rint($(tmp0))]
tmp0=!item $val22+3 of $val12,$val13,$val14,$val15,$val16

val24=$[rint($(tmp0))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val25=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val26=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val27=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val28=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val29=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val30=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val31=$[rint($(tmp0))]
tmp0=!randitem 	 ($val25*x^2+$val26*x+$val28),	 ($val25*x^2+$val26*x+$val28),	 sin($val25*x+$val28),	 cos($val25*x+$val28),	 ($val25*x+$val28)^$val31,	 ($val25*sin(x)+$val26*cos(x))	

val32=!rawmath $(tmp0)
evaltmp=$val32

evaltmp=!mathsubst x=($val22) in $evaltmp
tmp0=($evaltmp)
val33=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val32,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val34=!rawmath $(tmp0)
tmp0=!texmath $val32

val35=$(tmp0)
evaltmp=$val34

evaltmp=!mathsubst x=($val22) in $evaltmp
tmp0=($evaltmp)
val36=$[$(tmp0)]
val37=$[$val23*($val36)+($val24)*($val33)]
replytype1=numeric
replyname1=\(h'($val22)\)
replygood1=$[$val37]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

