tmp0=!randint 20, 100

val6=$[$(tmp0)]
tmp0=!randint 30, 150

val7=$[rint($(tmp0))]
val8=$[$val6/sqrt(4*pi*$val7)]
replyname1=Radius speed
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We have a circle whose area increases at a constant speed of	$val6 square centimeters per second. At the moment when the area equals $val7	cm<sup>2</sup>, what is the speed at which its radius increases (in cm/s)?	
$()
