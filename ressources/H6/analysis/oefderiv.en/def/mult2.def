!insmath f ''(x)
$()</th>	<td>$val17</td><td>$val18</td><td>$val19</td><td>$val20</td><td>$val21</td></tr>	<tr><th>
!insmath g(x)
$()</th>	<td>$val22</td><td>$val23</td><td>$val24</td><td>$val25</td><td>$val26</td></tr>	<tr><th>
!insmath g'(x)
$()</th>	<td>$val27</td><td>$val28</td><td>$val29</td><td>$val30</td><td>$val31</td></tr>	<tr><th>
!insmath g''(x)
$()</th>	<td>$val32</td><td>$val33</td><td>$val34</td><td>$val35</td><td>$val36</td></tr>	</table>	Let 
!insmath h = f*g
$(). Compute the second derivative 
!insmath h''($val37)
$().	
