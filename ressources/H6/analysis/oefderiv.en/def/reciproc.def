!set title=Inverse derivative
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint abs($val6)+1, abs($val6)+3

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sin,cos

val10=$(tmp0)
tmp0=!randitem +,-

val11=$(tmp0)
val12=!rawmath $val7*x $val11 $val10($val6*x+$val8) + $val9
tmp0=!randint -100, 100

val13=$[rint($(tmp0))]
tmp=!replace internal .. by , in $val12 - ($val13),x=-1000..1000 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val14=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
evaltmp=$val15

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val16=$[1/$(tmp0)]
replyname1=\(g'($val13)\)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath f: \RR \to \RR
$() be the function defined by	<div class="wimscenter">	
!insmath f(x) = $val12 
$().	</div>	Verify that 
!insmath f
$() is bijective, therefore we have an inverse function	
!insmath g = f^{-1}
$(). Calculate the value of its derivative	
!insmath g'($val13)
$() at  
!insmath $val13
$().	<div class="wims_instruction">	You must reply with a precision of at least 4	significant digits.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=0
