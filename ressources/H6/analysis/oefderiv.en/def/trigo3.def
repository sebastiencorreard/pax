tmp0=!randint 2, 9

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0))]
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
tmp0=!randitem 	 sin($val6*x+$val9),	 cos($val6*x+$val9),	 sin($val6*x)+cos($val7*x),	 sin($val6*x)+tan($val7*x),	 cos($val6*x)+tan($val7*x),	 $val6*sin($val7*x+$val9),	 $val6*cos($val7*x+$val9),	 $val6*x*sin($val7*x+$val9),	 $val6*x*cos($val7*x+$val9),	 sin($val6*x^$val12),	 cos($val6*x^$val12),	 tan($val6*x+$val9)	

val14=!rawmath $(tmp0)
tmp0=!randint -4, 4

val15=$[rint($(tmp0))]
tmp0=!texmath $val14

val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
evaltmp=$val17

evaltmp=!mathsubst x=($val15) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
replyname1=\(f '($val15)\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

