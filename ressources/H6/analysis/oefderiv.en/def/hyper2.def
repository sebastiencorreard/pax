!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0))]
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
tmp0=!randitem ch,sh,th

val14=$(tmp0)
tmp0=!randitem ch,sh,th

val15=$(tmp0)
tmp0=!randitem 	 $val14($val15($val6*x)+$val9),	 $val14($val6*x)^$val12,	 $val6/$val14($val7*x+$val9),	 $val6*x/$val14($val7*x+$val9),	 $val6*x^$val12*$val14($val7*x),	 ($val6*$val14(x)+$val9)/($val7*$val15(x)+$val10),	 $val14($val15($val6*x)^$val12)^$val13,	 x/$val14($val6*x)^$val12	

val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f '(x)\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

