 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(15)]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -$val6, $val6

val12=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val13=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val14=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val15=$[rint($(tmp0))]
tmp0=!randint -$val6, $val6

val16=$[rint($(tmp0))]
tmp0=!randint -2, 2

val17=$[rint($(tmp0))]
tmp0=!item $val17+3 of $val7,$val8,$val9,$val10,$val11

val18=$[rint($(tmp0))]
tmp0=!item $val17+3 of $val12,$val13,$val14,$val15,$val16

val19=$[rint($(tmp0))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val21=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, $val6

tmp1=!randitem -1,1

val22=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val23=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val24=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, $val6

tmp1=!randitem -1,1

val25=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val26=$[rint($(tmp0))]
tmp0=!randitem 	  ($val20*x^2+$val21*x+$val23),	  ($val20*x^2+$val21*x+$val23),	  sin($val20*x+$val23),	  cos($val20*x+$val23),	  ($val20*x+$val23)^$val26,	  ($val20*sin(x)+$val21*cos(x))	

val27=!rawmath $(tmp0)
evaltmp=$val27

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val28=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val27,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val29=!rawmath $(tmp0)
tmp0=!texmath $val27

val30=$(tmp0)
evaltmp=$val29

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val31=$[$(tmp0)]
val32=$[($val18*($val31)-($val19)*($val28))/($val18)^2]
replyname1=\(h'($val17)\)
replygood1=$val32
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()We have a differentiable function 
!insmath f
$(),	with values and derivatives shown in the following table.	<table class="wimscenter wimsborder">	<tr><th>x</th><th>-2</th><th>-1</th><th>0</th><th>1</th><th>2</th></tr>	<tr><th>
!insmath f(x)
$()</th>	<td>$val7</td><td>$val8</td><td>$val9</td><td>$val10</td><td>$val11</td></tr>	<tr><th>
!insmath f '(x)
$()</th>	<td>$val12</td><td>$val13</td><td>$val14</td><td>$val15</td><td>$val16</td></tr>	</table>	Let 
!insmath h
$() defined by  
!insmath h(x) = $val30 / f(x)
$(). Compute the derivative	
!insmath h'($val17)
$().	
$()
!exit

:hint
$()First compute the value and derivative of the function 
!insmath $val30
$() at the	point 
!insmath x_0=$val17
$(), then apply the formula of division.
$()
!exit

:help
$()
$()
!exit

:solution
$()Let 
!insmath g(x)=$val30
$(). We have 
!insmath g($val17)=$val28
$(),	
!insmath g'($val17)=$val31
$(), hence	<div class="wimscenter">	 
!insmath h'($val17) = \frac{f($val17)g'($val17) - f '($val17)g($val17)}	 {f($val17)^2}
$()	 <br />= 
!insmath \frac{($val18)($val31) - ($val19)($val28)}{($val18)^2} = $val32
$().	</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

