!set title=Virtual chain Ib
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
!readproc slib/data/randline src/simple1.data 
tmp0=$slib_out
val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val8,c1,subst($val9,c2,subst($val10,c3,subst($val11,c4,$val12))))
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
val13=f($val12)
tmp=!translate ;";': to $     $ in $val12,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val14=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val14)*fprime

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp0=!replace internal fprime by f'($val12) in $val15

val16=$(tmp0)
replytype1=formal
replyname1=The derivative \(g'(x))
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Let 
!insmath f
$() be a differentiable function, with derivative 
!insmath f'
$().	Compute the derivative of 
!insmath g(x) = $val13
$().	
$()
!exit

