!set title=Rational functions I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=en
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0))]
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
tmp0=!randitem 	 $val9/x+$val10/x^2+$val11/x^3,	 (x+$val9)/(x+$val10),	 $val9/($val6*x+$val10),	 ($val6*x+2)/($val7*x+5),	 ($val6*x^2+$val7*x+$val9)/(x+$val10),	 $val6*x/($val7*x+1)^$val12,	 $val9/(x+$val10)^$val12,	 x^$val12/($val6*x+$val9)	

val14=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=$(tmp0)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f '(x)\)
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compute the derivative of the function	
!insmath  f(x) = $val15
$()
$()
!exit

