!set lang_exists=yes


!! present.phtml

!set name_present1=!nosubst 看下面的两个图像. 左边是 $fcnt 个函数 $fs&nbsp; 的图像;\
右边是线性组合的函数图像

!set name_present2=!nosubst 你的目标是找出这个线性组合的系数,\
越精确越好. 为了做这个, 你可以有 $maxreply 次尝试.



!! main.phtml

!set name_giveupnote=放弃你的分数



!! intro.phtml

!set name_intro1=!nosubst 原理非常的简单: 如果给了你两个函数\
$mf<sub>1</sub>(x) 与 $mf<sub>2</sub>(x) 和两个系数\
c<sub>1</sub> 与 c<sub>2</sub>, 你当然知道怎么样算出它们的线性组合

!set name_intro2=我们知道每个函数和它的图像一一对应.\
不过就图像而言, 函数的和很难表示出来,\
因为你不再有一种明显的方法来计算.

!set name_intro3=这正是本练习的目的: 给出函数的图像,\
要求你求出相加函数前的系数以得到这些图像.\
和很多 WIMS 的练习一样, 经过练习的训练,\
 会让你增强从图像识别函数的能力.

!distribute items 函数类型,允许的尝试次数,得分的难度\
into name_introtype, name_introtry,name_severity

!set name_related=Coincidence, functions, addition


!! form.phtml

!distribute items 第,最后一次尝试的平均偏差是\
into name_form1,name_form2

!set name_form1bis=!nosubst 次尝试 (总共 $maxreply)

!set name_formbest=!nosubst 你最佳答案是第 $bestreply 次尝试, \
平均偏差是
!set name_formnote=相对应的试评分是
!set name_bestanswer=这是你迄今为止最好的答案
!set name_formend=结束练习查看分数



!! answer.phtml

!set name_already=你现在已经完成了这个练习.
!set name_answer1=!nosubst 你只做了 $replycnt 次尝试, 没有达到允许的 \
  $maxreply 次,
!set name_answer2=!nosubst 你做了 $maxreply 次尝试, 结束了本次练习,
!set name_answer3=得分

!set name_best=!nosubst 你最好的答案是第 $bestreply 次尝试, 组合为 $bestgx,\
 平均偏差是 $bestdiff, 如下图所示.
!set name_last= !nosubst  你最好的答案是最后一次尝试, 组合为 $gx,\
 平均偏差是 $bestdiff.
!set name_thefunction=正确答案是

!set name_myreply=my reply

