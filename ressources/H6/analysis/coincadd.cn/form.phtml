
!form reply
<input type="submit" value="$wims_name_send" /> $name_form1 $[$replycnt+1] 
$name_form1bis :<p>

<span style="color:#$color7">$mf(x)</span> = 
!for i=1 to $fcnt
 !if $i>1
  +
 !endif
<input size="6" name="c$i" value="$(c$i)" />&nbsp;<span style="color:#$(color$i)">$mf<sub>$i</sub>(x)</span>
!next i
</p>
!formend

!if $diff>0 and $replycnt>0
 <p>$name_form2:
 !htmlmath $diff
, $name_formnote
$[rint(-$score_coef1*ln($diff*$score_coef2))/10]/10.
 !if $bestreply>0
  !if $bestreply<$replycnt
   <p>$name_formbest
   !htmlmath $bestdiff
, $name_formnote
$[rint(-$score_coef1*ln($bestdiff*$score_coef2))/10]/10.
  !else
   !if $replycnt>1
    $name_bestanswer.
   !endif
  !endif
 !endif
 </p>
!endif

!if $replycnt>0
!set wims_ref_class=wims_button
 !href cmd=reply&shortcut=yes $name_formend

!endif
