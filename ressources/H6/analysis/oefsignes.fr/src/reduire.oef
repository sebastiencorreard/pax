\title{Réduire une fraction rationnelle}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\precision{100}


\integer{a2=randint(1..8)*random(-1,1)}
\integer{b=randint(-10..10)}
\integer{a1= (\b = 0)? randint(1..8) : randint(1..8)*random(-1,1)}
\integer{c=randint(-10..10)}
\integer{d=randint(-10..10)}
\integer{e=randint(1..10)*randint(-1,1)}
\function{f=random(
\a2+(\e/(\a1*x+\b)),
\a2-(\e/(\a1*x+\b)) ,
\a2*x+\c+(\e/(\a1*x+\b)),
\a2+((\e*x+\d)/(\a1*x+\b)),
\a2-((\e*x+\d)/(\a1*x+\b)) ,
\a2*x+\c+((\e*x+\d)/(\a1*x+\b))
)}
\function{f = maxima(\f)}
\text{ft=texmath(\f)}
\function{num =(\f)*(\a1*x+\b)}
\function{num = pari(\num)}

\function{den=maxima(\a1*x+\b)}
\text{dt=texmath(\den)}

\statement{Ecrire l'expression \(\ft) sous forme d'une seule fraction :
\(\frac{N(x)}{\dt}).
<div class="wims_instruction">
Ecrire comme réponse seulement le numérateur \(N(x)).
</div>}
\answer{N(x)}{\num}{type = formal}


\solution{\(\ft) = \((\num)/(\den))}
