\title{De quelle expression étudier le signe ?#}
\language{fr}
\range{-5..5}
\author{Muriel, Rey;Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..5)*random(-1,1)}
\integer{b=random(-5..5)}
\integer{c=random(1..8)}
\integer{d=random(1..5)*random(-1,1)}
\integer{e=random(-5..5)}
\integer{i=random(-5..5)}

\integer{n = random(1,2)}

\integer{a= (\a=\d) ? \a+1 : \a}
\integer{b= (\b=\e) ? \b+1 : \b}

\function{f=item(\n,\a*x^2 + \b*x + \c,
\a*x^3 + \b*x^2 + \c*x)}
\function{f = pari(\f)}
\text{ftex=texmath(\f)}

\function{g=item(\n,\d*x^2 + \e*x + \i,
\d*x^3 + \e*x^2 + \i*x)}
\function{g = pari(\g)}
\text{gtex=texmath(\g)}

\text{fp=diff(\f,x)}
\text{gp=diff(\g,x)}

\function{y = \c*x + \e}
\text{y=pari(\y)}
\text{ytex=texmath(\y)}

\function{\h=(\f-(\g))}
\function{h=pari(\h)}
\text{htex=texmath(\h)}

\function{\hfaux=(\f-\g)}
\function{hfaux=pari(\hfaux)}
\text{hfauxtex=texmath(\hfaux)}

\function{\k=(\f-(\y))}
\function{k=pari(\k)}
\text{ktex=texmath(\k)}

\function{\m=(\g-(\y))}
\function{m=pari(\m)}
\text{mtex=texmath(\m)}

\function{\l=(\g+(\f))}
\function{l=pari(\l)}
\text{ltex=texmath(\l)}

\text{liste=shuffle(1,2,3,4,5,6,7)}


\text{\questions=
Pour étudier <b>la position de la courbe de \(f) par rapport à l'axe des abscisses </b>&#44; on étudie le signe de,
Pour étudier <b>la position de la courbe de \(g) par rapport à l'axe des abscisses</b>&#44; on étudie le signe de,
Pour étudier <b>la position de la courbe de \(f) par rapport à la courbe de \(g)</b>&#44; on étudie le signe de,
Pour étudier <b>les variations de la fonction \(f)</b>&#44; on étudie le signe de,
Pour étudier <b>les variations de la fonction \(g)</b>&#44; on étudie le signe de,
Pour étudier <b>la position de la courbe de \(f) par rapport à la droite d'équation \(y = \ytex)</b>&#44; on étudie le signe de,
Pour étudier <b>la position de la courbe de \(g) par rapport à la droite d'équation \(y = \ytex)</b>&#44; on étudie le signe de,
}

\text{\reponses=\(\f),\(\g),\(\h),\(\fp), \(\gp), \(\k), \(\m), \(\y) , \(\l), \(\hfaux) }

\text{\solutions=
Pour étudier <b>la position de \(C_f) par rapport à l'axe des abscisses </b>&#44; on étudie le signe de \(f(x) = \ftex).,
Pour étudier <b>la position de \(C_g) par rapport à l'axe des abscisses </b>&#44; on étudie le signe de \(g(x) = \gtex).,
Pour étudier <b>la position de \(C_f) par rapport à \(C_g)</b>&#44; on étudie le signe de \(f(x)-g(x))</b> donc on étudie le signe de \(\f - (\g)) =\(\h) <br> (Attention à ne pas oublier les parenthèses autour de \(g(x)) lors de la soustraction.) ,
Pour étudier <b>les variations de la fonction \(f)</b>&#44; on étudie le signe de sa dérivée donc on calcule \(f'(x)) <br> sachant que la dérivée de \(x^n) est \(nx^(n-1)) on trouve que \(f'(x) = \fp). ,
Pour étudier <b>les variations de la fonction \(g) </b>&#44; on étudie le signe de sa dérivée donc on calcule \(g'(x)) <br> sachant que la dérivée de \(x^n) est \(nx^(n-1)) on trouve que \(g'(x) = \gp). ,
Pour étudier <b>la position de \(C_f) par rapport à la droite d'équation \(y = \ytex)</b>&#44; on étudie le signe de \(\f - (\y) = \k) <br> (Attention à ne pas oublier les parenthèses autour de \(\y) lors de la soustraction.),
Pour étudier <b>la position de \(C_g) par rapport à la droite d'équation \(y = \ytex) </b>&#44; on étudie le signe de \(\g - (\y) = \m) <br> (Attention à ne pas oublier les parenthèses autour de \(\y) lors de la soustraction.)
 }

\text {question1 = item (\liste[1], \questions)}
\text {rep1 = item (\liste[1], \reponses)}
\text {sol1 = item (\liste[1], \solutions)}

\text {question2 = item (\liste[2], \questions)}
\text {rep2 = item (\liste[2], \reponses)}
\text {sol2 = item (\liste[2], \solutions)}

\text {question3 = item (\liste[3], \questions)}
\text {rep3 = item (\liste[3], \reponses)}
\text {sol3 = item (\liste[3], \solutions)}

\text {question4 = item (\liste[4], \questions)}
\text {rep4 = item (\liste[4], \reponses)}
\text {sol4 = item (\liste[4], \solutions)}



\statement{
On considère la fonction
\(f) définie sur \RR par \(f(x) = \ftex) et la fonction
\(g) définie sur \RR par \(g(x) = \gtex).
<ul>
<li> \question1 : <div class="wimscenter"> \embed{rep1,235x30} </div></li>
<li> \question2 : <div class="wimscenter"> \embed{rep2,235} </div></li>
<li> \question3 : <div class="wimscenter"> \embed{rep3,235} </div></li>
<li> \question4 : <div class="wimscenter"> \embed{rep4,235} </div></li>
</ul>
}


\answer{}{\rep1;\reponses}{type = clickfill}
\answer{}{\rep2;\reponses}{type = clickfill}
\answer{}{\rep3;\reponses}{type = clickfill}
\answer{}{\rep4;\reponses}{type = clickfill}


\hint{<ul>
<li>Pour étudier la position de \(C_f) par rapport à l'axe des abscisses, on étudie le signe de \(f(x)).</li>
<li>Pour étudier la position de \(C_f) par rapport à \(C_g), on étudie le signe de \(f(x)-g(x)). (ne pas oublier les parenthèses autour de \(g(x))) </li>
<li>Pour étudier la position de \(C_f) par rapport à la droite d'équation \(y = ax + b), on étudie le signe de \(f(x)-(ax + b)). </li>
<li>Pour étudier les variations d'une fonction, on étudie le signe de sa dérivée.</li>
 <li>La dérivée de \(x^n) est \(nx^(n-1)) </li></ul>
}

\feedback{1=1}{
<ul>
<li> [1] \sol1</li>
<li> [2] \sol2</li>
<li> [3] \sol3</li>
<li> [4] \sol4 </li>
</ul>
}
