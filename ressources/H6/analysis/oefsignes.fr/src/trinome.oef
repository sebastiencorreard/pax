<td style="width:20%"></td><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td></td><td>\signes[\s2] </td><td>0</td><td>\signes[\s1]</td><td></td>
</tr>
</table>}
\if{\cas=1}{<table class="tab_var">
<tr>
<th>\(x)</th><td style="width:5%; text-align:left">\(\inf)</td><td style="width:40%"></td><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td style="width:5%"></td><td style="width:40%">\signes[\s1] </td><td style="width:5%"></td>
</tr>
</table>}
}
