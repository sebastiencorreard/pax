\title{Signe d'un trinôme}
\language{fr}
\range{-5..5}
\author{Chantal, Causse}
\email{Chantal.Causse@noos.fr}
\computeanswer{no}
\format{html}
\precision{100}

\css{<style type="text/css">
table.tab_var {margin-left:auto;margin-right:auto;
   border:solid 1px black;width:80%}
table.tab_var tr, table.tab_var td, table.tab_var th {
   padding:7pt;margin-top:10px; margin-bottom:10px;
   text-align:center; border-collapse:collapse; min-width:10pt;
   }
table.tab_var th { border:solid 1px black;width:20%}
table.tab_var tr { border:solid 1px black}
</style>
}


\integer{cas=random(1,2,2,3,3)}
\text{etapes= reply2}
\text{etapes= \cas > 1 ? \etapes,reply3,reply4 : \etapes}
\text{etapes= \cas = 3 ? \etapes,reply5,reply6 : \etapes}

\steps{reply1
\etapes}



\integer{a=random(1,-1)*randint(1,2,3,6)}

\rational{u=random(1,-1)*randint(1..6)/random(1,1,1,2,3,4)}
\rational{v=random(1,-1)*randint(1..6)/random(1,1,1,2,3,4)}
\rational{v= \u = \v ? 0 : \v}
\rational{b0=item(\cas,randint(1..5)/random(1,2,3),-2*\u,(-1)*(\u+\v))}
\rational{c0=item(\cas,randint((\b0)^2/4+1..(\b0)^2/4+6),(\u)^2,(\u)*(\v))}

\rational{b=(\a)*(\b0)}
\rational{c=(\a)*(\c0)}


\function{d=maxima(expand((\a)*x^2+(\b)*x+\c))}
\rational{delta = (\b)^2-4*(\a)*(\c)}

\text{dt=texmath(\d)}

\rational{zero1= \cas = 2 ? \u : max(\u,\v)}
\rational{zero2= \cas = 2 ? \u : min(\u,\v)}

\text{inf=- \infty}
\text{sup= + \infty}

\text{signes=-,+}

\text{s1=\a>0?2:1}
\text{s2=\a>0?1:2}
\text{s2= \cas=2 ? \s1 : \s2}
\text{s3=\s1}

\statement{
\if{\step=1}{Le but de l'exercice est d'étudier, selon les valeurs de \(x),
le signe de l'expression \(\dt).
<p>On considère d'abord l'équation : \(\dt = 0).<br>
Combien cette équation a-t-elle de solutions ? \embed{reply1}
</p>
}
\if{\step=2}{
Compléter le tableau de signes de l'expression : \(\dt) :
\if{\cas=3}{
<table class="tab_var">
<tr>
<th>\(x)</th><td style="width:5%; text-align:left">\(\inf)</td><td style="width:15%"></td><td style="width:5%">\embed{reply5,5}</td><td style="width:15%"></td><td style="width:5%">\embed{reply3,5}</td>
<td style="width:15%"></th><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td style="width:5%"></td><td>\embed{reply6} </td><td>0</td><td>\embed{reply4} </td><td>0</td><td>\embed{reply2}</td><td></td>
</tr>
</table>}
\if{\cas=2}{<table class="tab_var">
<tr>
<th>\(x)</th><td style="width:5%; text-align:left">\(\inf)</td><td style="width:20%"></td><td style="width:5%">\embed{reply3,5}</td>
<td style="width:20%"></td><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td></td><td>\embed{reply4} </td><td>0</td><td>\embed{reply2}</td><td></td>
</tr>
</table>}
\if{\cas=1}{<table class="tab_var">
<tr>
<th>\(x)</th><td style="width:5%; text-align:left">\(\inf)</td><td style="width:40%"></td><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td style="width:5%"></td><td style="width:40%">\embed{reply2} </td><td style="width:5%"></td>
</tr>
</table>}
}
}

\answer{}{\cas ; 0,1,2,3,autre}{type=menu}
\answer{}{\s1 ; \signes}{type=menu}
\answer{}{\zero1}{type=rational}
\answer{}{\s2 ; \signes}{type=menu}
\answer{}{\zero2}{type=rational}
\answer{}{\s3 ; \signes}{type=menu}

\solution {\(\Delta = \delta)
\if{\cas=3}{
<table class="tab_var">
<tr>
<th>\(x)</th><td style="width:5%; text-align:left">\(\inf)</td><td style="width:25%"></td><td style="width:5%">\zero2</td><td style="width:25%"></td><td style="width:5%">\zero1</td>
<td style="width:25%"></td><td style="width:5%; text-align:right">\(\sup)</td>
</tr><tr>
<th>\(\dt)</th><td style="width:5%"></td><td>\signes[\s3] </td><td>0</td><td>\signes[\s2] </td><td>0</td><td>\signes[\s1]</td><td></td>
</tr>
</table>}
\if{\cas=2}{<table class="tab_var">
<tr>
