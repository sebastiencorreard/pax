postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2,2,3,3

val6=$[rint($(tmp0))]
val7=reply2

!ifval $val6 > 1 
val7= $val7,reply3,reply4 
!else
val7= $val7
!endif

!ifval $val6 = 3 
val7= $val7,reply5,reply6 
!else
val7= $val7
!endif
tmp0=!randitem 1,-1

tmp1=!randitem 1,2,3,6

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 6

tmp2=!randitem 1,1,1,2,3,4

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val9=!exec pari print($t_)
tmp0=!randitem 1,-1

tmp1=!randint 1, 6

tmp2=!randitem 1,1,1,2,3,4

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val10=!exec pari print($t_)

!ifval $val9 = $val10 
t_=!rawmath  0 
val10=!exec pari print($t_)
!else
t_=!rawmath  $val10
val10=!exec pari print($t_)
!endif
tmp0=!randint 1, 5

tmp1=!randitem 1,2,3

tmp2=!item $val6 of $(tmp0)/$(tmp1),-2*$val9,(-1)*($val9+$val10)

t_=!rawmath $(tmp2)
val11=!exec pari print($t_)
tmp0=!randint ($val11)^2/4+1, ($val11)^2/4+6

tmp1=!item $val6 of $(tmp0),($val9)^2,($val9)*($val10)

t_=!rawmath $(tmp1)
val12=!exec pari print($t_)
t_=!rawmath ($val8)*($val11)
val13=!exec pari print($t_)
t_=!rawmath ($val8)*($val12)
val14=!exec pari print($t_)
t_=!replace internal \( by ( in expand(($val8)*x^2+($val13)*x+$val14)
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
t_=!rawmath ($val13)^2-4*($val8)*($val14)
val16=!exec pari print($t_)
tmp0=!texmath $val15

val17=$(tmp0)

!ifval $val6 = 2 
t_=!rawmath  $val9 
val18=!exec pari print($t_)
!else
t_=!rawmath  max($val9,$val10)
val18=!exec pari print($t_)
!endif

!ifval $val6 = 2 
t_=!rawmath  $val9 
val19=!exec pari print($t_)
!else
t_=!rawmath  min($val9,$val10)
val19=!exec pari print($t_)
!endif
val20=- \infty
val21=+ \infty
val22=-,+

!ifval $val8>0
val23=2
!else
val23=1
!endif

!ifval $val8>0
val24=1
!else
val24=2
!endif

!ifval $val6=2 
val24= $val23 
!else
val24= $val24
!endif
val25=$val23
oefsteps=reply1	$val7 
nextstep=!nosubst reply1	$val7 
!readproc oef/steps.proc
replytype1=menu
replyname1=
replygood1=$val6 ; 0,1,2,3,autre
replytype2=menu
replyname2=
replygood2=$val23 ; $val22
replytype3=rational

replyname3=
replygood3=$val18
