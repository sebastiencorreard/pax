!set title=Réduire une fraction rationnelle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal, Causse
email=Chantal.Causse@noos.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 8

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]

!ifval ($val7 = 0)
tmp0=!randint 1, 8

val8=$[rint( $(tmp0) )]
!else
tmp1=!randint 1, 8

tmp2=!randitem -1,1

val8=$[rint( $(tmp1)*$(tmp2))]
!endif
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 	$val6+($val11/($val8*x+$val7)),	$val6-($val11/($val8*x+$val7)) ,	$val6*x+$val9+($val11/($val8*x+$val7)),	$val6+(($val11*x+$val10)/($val8*x+$val7)),	$val6-(($val11*x+$val10)/($val8*x+$val7)) ,	$val6*x+$val9+(($val11*x+$val10)/($val8*x+$val7))	

val12=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val12
tmp0=!exec maxima $t_

val12=!rawmath $(tmp0)
tmp0=!texmath $val12

val13=$(tmp0)
val14=!rawmath ($val12)*($val8*x+$val7)
t_=!replace internal \( by ( in $val14
tmp0=!exec pari $t_

val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in $val8*x+$val7
tmp0=!exec maxima $t_

val15=!rawmath $(tmp0)
tmp0=!texmath $val15

val16=$(tmp0)
replytype1=formal
replyname1=N(x)
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Ecrire l'expression 
!insmath $val13
$() sous forme d'une seule fraction :	
!insmath \frac{N(x)}{$val16}
$().	<div class="wims_instruction">	Ecrire comme réponse seulement le numérateur 
!insmath N(x)
$().	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath $val13
$() = 
!insmath ($val14)/($val15)
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14,15,16
embedcnt=0
