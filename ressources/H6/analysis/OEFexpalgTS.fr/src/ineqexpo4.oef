e^{2 x}-e^{\t1} \symb e^{x+1}-e^{\sing1p},\sing1,1
e^{2 x}-(e^{\sing1}+\frac{1}{e})e^x+e^{\sing1m} \symb 0,\sing1,-1
e^{2 x}-e^{\t1}+e^{\sing1m} \symb e^{x-1},\sing1,-1
e^{2 x}-e^{\t1} \symb e^{x-1}-e^{\sing1m},\sing1,-1
