\title{Équation avec exponentielle 6}

\text{name_statement=Résoudre dans \(\,\RR\) l'équation}
\text{name_instruction=Pour écrire votre réponse,
  <ul><li>écrire <span class="tt">vide</span> s'il n'y a pas de solution.
  </li><li>s'il y a plusieurs solutions, les séparer par une virgule.
  </li></ul>
}
\text{name_answer=Ensemble de solutions}

\integer{sing1=randint(2..8)*randint(1,-1)}
\integer{sing2=randint(2..8)*randint(1,-1)}
\integer{sing2=\sing2=\sing1?2*\sing1}
\integer{sing2=\sing2=-\sing1?2*\sing2}
\integer{s=\sing1+\sing2}
\integer{p=\sing1*\sing2}
\integer{bp=randint(1..5)+2*ln(exp(\sing1)+exp(\sing2))-ln(4)}
\text{t1=texmath(maxima(x+\sing1))}
\text{t2=texmath(maxima(x+\sing2))}

!!!!! On est ramené à une équation du second degré en X que l'on ne peut pas résoudre avec les outils de terminale :
!! on ne dispose pas du théorème avec la somme et les produits de racines.
\text{t3=texmath(maxima(2*x-(\s)))}
\text{t4=texmath(maxima(-x+(\s)))}
\text{t5=texmath(maxima(x-\sing1))}
\text{data=\frac{e^{\t1}-e^{\s}}{-e^{\sing2}+e^x}=e^{x},\sing1
\frac{e^{\sing1}}{1-e^{\t5}+e^{\t3}}=e^{\t4},\sing1,\sing2
\frac{e^{\sing1}+e^{\sing2}}{1+e^{\t3}}=e^{\t4},\sing1,\sing2
\frac{e^{\t1}-e^{\bp}}{-e^{\sing2}+e^x}=e^{x},vide
}
!!! Pour la première ligne de data sing2 ne peut pas être solution (valeur interdite)

\integer{nb=rows(\data)}
\integer{i=randint(1..\nb)}
integer{i=22}
\text{cedata=row(\i,\data)}
\text{equat=\cedata[1]}
\text{rep=item(2..-1,\cedata)}






\if{items(\rep)=2}{
  \integer{sing1=\rep[1]}
  \integer{sing2=\rep[2]}
  }{
    \if{\i>=16 and \i<20}{\integer{sing2=-1}}
    \if{\i>=19 and \i<22}{
      \integer{sing2=\sing1}
      \integer{sing1=-1}
    }
  }
\text{trep=\rep issametext vide?\rep:\sing1,\sing2}
\integer{ts=\trep[1]+\trep[2]}
\integer{tp=\rep issametext vide?\bp:\ts}
\text{X1=\rep issametext vide?e^{\sing1}:e^{\trep[1]}}
\text{X2=\rep issametext vide?e^{\sing2}:e^{\trep[2]}}


\text{name_sol=En posant \(X=e^x\) avec \(x\neq \sing2\) (\(\sing2\) est une valeur
  interdite), l'équation de départ est équivalente à \(X^2-(\X1+\X2)X+e^{\tp}=0\).
  On résout cette équation du second degré en \(X\).
  On trouve \(X_1=\X1\) et \(X_2=\X2\).
  On résout alors, pour \(x\neq \sing2\), les équations \(e^x=\X1\) et \(e^x=\X2\),
  ce qui donne pour unique solution : \(\rep[1]\).}


\text{name_tsol1=En posant \(X=e^x\), l'équation de départ est équivalente à
  \(X^2-(\X1-\X2)X-e^{\tp}=0\).
  On résout cette équation du second degré en \(X\): on trouve \(X_1=\X1\) et \(X_2=-\X2\).<br>
  On résout alors les équations \(e^x=\X1\), ce qui donne une solution \(x_1=\rep[1]\)
  et \(e^x=-\X2\) qui n'a pas de solution dans \(\,\RR\).}
\text{name_tsol2=En posant \(X = e^x\), l'équation de départ est équivalente à \(X^2-(\X1+\X2)X+e^{\tp}=0\).
  On résout cette équation du second degré en \(X\).}
\text{name_tsol3=Il n'y a pas de solution dans \(\,\RR\), donc l'équation initiale n'a pas de solution.}
\text{name_tsol4=On trouve \(X_1=\X1\) et \(X_2=\X2\).
  On résout alors les équations \(e^x=\X1\) et \(e^x=\X2\),
  ce qui donne deux solutions \(x_1=\rep[1]\) et \(x_2=\rep[2]\).}

\if{\i>=16}{
  \text{tsol=\name_tsol1}
  }{
    \text{tsol=\name_tsol2}
    \text{tsol=\rep issametext vide? \tsol \name_tsol3:\tsol \name_tsol4}
  }




