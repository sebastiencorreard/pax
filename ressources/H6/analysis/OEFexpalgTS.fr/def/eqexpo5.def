val6=Résoudre dans \(\,\RR\) l'équation
val7=Pour écrire votre réponse,	  <ul><li>écrire <span class="tt">vide</span> s'il n'y a pas de solution.	  </li><li>s'il y a plusieurs solutions, les séparer par une virgule.	  </li></ul>	
val8=Ensemble de solutions
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val10=$val9
val10=$[rint(2*$val9)]
!endif

!ifval $val10=-$val9
val10=$[rint(2*$val10)]
!endif
val11=$[rint($val9+$val10)]
val12=$[rint($val9*$val10)]
tmp0=!randint 1, 5

val13=$[rint($(tmp0)+2*ln(exp($val9)+exp($val10))-ln(4))]
t_=!replace internal \( by ( in x+$val9
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
t_=!replace internal \( by ( in x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
val16=$[rint($val9+1)]
val17=$[rint($val9-1)]
val18=e^{2 x}-(e^{$val9}+e^{$val10})e^x+e^{$val11}=0,$val9,$val10	e^{2 x}-e^{$val14}+e^{$val11}=e^{$val15},$val9,$val10	e^{2 x}-e^{$val14}=e^{$val15}-e^{$val11},$val9,$val10	e^{2 x}-(e^{$val9}+e^{$val10})e^x+e^{$val13}=0,vide	e^{2 x}-e^{$val14}+e^{$val13}=e^{$val15},vide	e^{2 x}-e^{$val14}=e^{$val15}-e^{$val13},vide	e^{2 x}-(e^{$val9}+1)e^x+e^{$val9}=0,$val9,0	e^{2 x}-e^{$val14}+e^{$val9}=e^{x},$val9,0	e^{2 x}-e^{$val14}=e^{x}-e^{$val9},$val9,0	e^{2 x}-(e^{$val9}+e)e^x+e^{$val16}=0,$val9,1	e^{2 x}-e^{$val14}+e^{$val16}=e^{x+1},$val9,1	e^{2 x}-e^{$val14}=e^{x+1}-e^{$val16},$val9,1	e^{2 x}-(e^{$val9}+\frac{1}{e})e^x+e^{$val17}=0,$val9,-1	e^{2 x}-e^{$val14}+e^{$val17}=e^{x-1},$val9,-1	e^{2 x}-e^{$val14}=e^{x-1}-e^{$val17},$val9,-1	e^{2 x}-(e^{$val9}-\frac{1}{e})e^x-e^{$val17}=0,$val9	e^{2 x}-e^{$val14}-e^{$val17}=-e^{x-1},$val9	e^{2 x}-e^{$val14}=-e^{x-1}+e^{$val17},$val9	e^{2 x}-(-e^{$val9}+\frac{1}{e})e^x-e^{$val17}=0,-1	e^{2 x}+e^{$val14}-e^{$val17}=e^{x-1},-1	e^{2 x}+e^{$val14}=e^{x-1}+e^{$val17},-1	e^{2 x}-(e^{$val9}-e^{$val10})e^x-e^{$val11}=0,$val9	e^{2 x}-e^{$val14}-e^{$val11}=-e^{$val15},$val9	e^{2 x}-e^{$val14}=-e^{$val15}+e^{$val11},$val9	
tmp=!translate internal $	$ to ; in $val18

tmp0=!rowcnt $tmp
val19=$[rint($(tmp0))]
tmp0=!randint 1, $val19

val20=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val18

tmp=!row $val20 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
val22=$(val21[1])
tmp0=!item 2 to -1 of $val21

val23=$(tmp0)
tmp0=!itemcnt $val23

!if $(tmp0)=2 
val9=$[rint($(val23[1]))]
val10=$[rint($(val23[2]))]
!else
!if $val20>=16 and $val20<20 
val10=$[rint(-1)]
!endif
!if $val20>=19 and $val20<22 
val10=$[rint($val9)]
val9=$[rint(-1)]
!endif
!endif

!ifval $val23 issametext vide
val24=$val23
!else
val24=$val9,$val10
!endif
val25=$[rint($(val24[1])+$(val24[2]))]

!ifval $val23 issametext vide
val26=$[rint($val13)]
!else
val26=$[rint($val25)]
!endif

!ifval $val23 issametext vide
val27=e^{$val9}
!else
val27=e^{$(val24[1])}
