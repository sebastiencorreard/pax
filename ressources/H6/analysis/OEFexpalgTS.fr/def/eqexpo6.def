leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=46
prevarcnt=45
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Résoudre dans \(\,\RR\) l'équation
val7=Pour écrire votre réponse,	  <ul><li>écrire <span class="tt">vide</span> s'il n'y a pas de solution.	  </li><li>s'il y a plusieurs solutions, les séparer par une virgule.	  </li></ul>	
val8=Ensemble de solutions
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val10=$val9
val10=$[rint(2*$val9)]
!endif

!ifval $val10=-$val9
val10=$[rint(2*$val10)]
!endif
val11=$[rint($val9+$val10)]
val12=$[rint($val9*$val10)]
tmp0=!randint 1, 5

val13=$[rint($(tmp0)+2*ln(exp($val9)+exp($val10))-ln(4))]
t_=!replace internal \( by ( in x+$val9
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
t_=!replace internal \( by ( in x+$val10
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val15=$(tmp1)
t_=!replace internal \( by ( in 2*x-($val11)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val16=$(tmp1)
t_=!replace internal \( by ( in -x+($val11)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val17=$(tmp1)
t_=!replace internal \( by ( in x-$val9
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
val19=\frac{e^{$val14}-e^{$val11}}{-e^{$val10}+e^x}=e^{x},$val9	\frac{e^{$val9}}{1-e^{$val18}+e^{$val16}}=e^{$val17},$val9,$val10	\frac{e^{$val9}+e^{$val10}}{1+e^{$val16}}=e^{$val17},$val9,$val10	\frac{e^{$val14}-e^{$val13}}{-e^{$val10}+e^x}=e^{x},vide	
tmp=!translate internal $	$ to ; in $val19

tmp0=!rowcnt $tmp
val20=$[rint($(tmp0))]
tmp0=!randint 1, $val20

val21=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val19

tmp=!row $val21 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val22=$(tmp0)
val23=$(val22[1])
tmp0=!item 2 to -1 of $val22

val24=$(tmp0)
tmp0=!itemcnt $val24

!if $(tmp0)=2 
val9=$[rint($(val24[1]))]
val10=$[rint($(val24[2]))]
!else
!if $val21>=16 and $val21<20 
val10=$[rint(-1)]
!endif
!if $val21>=19 and $val21<22 
val10=$[rint($val9)]
val9=$[rint(-1)]
!endif
!endif

!ifval $val24 issametext vide
val25=$val24
!else
val25=$val9,$val10
!endif
val26=$[rint($(val25[1])+$(val25[2]))]

!ifval $val24 issametext vide
val27=$[rint($val13)]
!else
val27=$[rint($val26)]
!endif

!ifval $val24 issametext vide
val28=e^{$val9}
!else
val28=e^{$(val25[1])}
!endif

!ifval $val24 issametext vide
val29=e^{$val10}
!else
val29=e^{$(val25[2])}
!endif
val30=En posant \(X=e^x\) avec \(x\neq $val10\) (\($val10\) est une valeur	  interdite), l'équation de départ est équivalente à \(X^2-($val28+$val29)X+e^{$val27}=0\).	  On résout cette équation du second degré en \(X\).	  On trouve \(X_1=$val28\) et \(X_2=$val29\).	  On résout alors, pour \(x\neq $val10\), les équations \(e^x=$val28\) et \(e^x=$val29\),	  ce qui donne pour unique solution : \($(val24[1])\).
val31=En posant \(X=e^x\), l'équation de départ est équivalente à	  \(X^2-($val28-$val29)X-e^{$val27}=0\).	  On résout cette équation du second degré en \(X\): on trouve \(X_1=$val28\) et \(X_2=-$val29\).<br>	  On résout alors les équations \(e^x=$val28\), ce qui donne une solution \(x_1=$(val24[1])\)	  et \(e^x=-$val29\) qui n'a pas de solution dans \(\,\RR\).
val32=En posant \(X = e^x\), l'équation de départ est équivalente à \(X^2-($val28+$val29)X+e^{$val27}=0\).	  On résout cette équation du second degré en \(X\).
val33=Il n'y a pas de solution dans \(\,\RR\), donc l'équation initiale n'a pas de solution.
val34=On trouve \(X_1=$val28\) et \(X_2=$val29\).	  On résout alors les équations \(e^x=$val28\) et \(e^x=$val29\),	  ce qui donne deux solutions \(x_1=$(val24[1])\) et \(x_2=$(val24[2])\).
!if $val21>=16 
val35=$val31
!else
val35=$val32

!ifval $val24 issametext vide
val35= $val35 $val33
!else
val35=$val35 $val34
!endif
!endif
val30=En posant \(X=e^x\) avec \(x\neq $val10\) (\($val10\) est une valeur	  interdite), l'équation de départ est équivalente à \(X^2-($val28+$val29)X+e^{$val27}=0\).	  On résout cette équation du second degré en \(X\).	  On trouve \(X_1=$val28\) et \(X_2=$val29\).	  On résout alors, pour \(x\neq $val10\), les équations \(e^x=$val28\) et \(e^x=$val29\),	  ce qui donne pour unique solution : \($(val24[1])\).
val31=En posant \(X=e^x\), l'équation de départ est équivalente à	  \(X^2-($val28-$val29)X-e^{$val27}=0\).	  On résout cette équation du second degré en \(X\): on trouve \(X_1=$val28\) et \(X_2=-$val29\).<br>	  On résout alors les équations \(e^x=$val28\), ce qui donne une solution \(x_1=$(val24[1])\)	  et \(e^x=-$val29\) qui n'a pas de solution dans \(\,\RR\).
val32=En posant \(X = e^x\), l'équation de départ est équivalente à \(X^2-($val28+$val29)X+e^{$val27}=0\).	  On résout cette équation du second degré en \(X\).
val33=Il n'y a pas de solution dans \(\,\RR\), donc l'équation initiale n'a pas de solution.
val34=On trouve \(X_1=$val28\) et \(X_2=$val29\).	  On résout alors les équations \(e^x=$val28\) et \(e^x=$val29\),	  ce qui donne deux solutions \(x_1=$(val24[1])\) et \(x_2=$(val24[2])\).

!ifval $val21==1 
val35= $val30
!endif
