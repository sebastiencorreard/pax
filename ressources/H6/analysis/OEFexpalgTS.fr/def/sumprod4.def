val17=$[rint($val9-2*$val8)]
val18=$[rint(2*$val8-$val9)]
val19=$[rint(2*$val9-$val8)]
val20=exp($val8 x)\times exp($val9 x),$val12*x,\frac{exp($val8 x)}{ exp($val9 x)},$val11*x,	\frac{exp($val9 x)}{ exp($val8 x)},$val13*x,\frac{exp($val8 x)}{ (exp($val9 x))^2},$val14*x,	exp($val8 x)\times (exp($val9 x))^2,$val15*x,(exp($val8 x))^2\times exp($val9 x),$val16*x,\frac{exp($val9 x)}{(exp($val8 x))^2},$val17*x,	\frac{(exp($val8 x))^2}{ exp($val9 x)},$val18*x,	\frac{(exp($val9 x))^2}{ exp($val8 x)},$val19*x	
