!set title=Équation avec exponentielle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Il n'y a pas de solution, car la fonction exponentielle	  prend des valeurs strictement positives sur \(\,\RR).
val7=Résoudre dans \(\,\RR\) l'équation
val8=Pour écrire votre réponse,	  <ul><li>écrire <span class="tt">vide</span> s'il n'y a pas de solution.	  </li><li>s'il y a plusieurs solutions, les séparer par une virgule.	  </li></ul>	
val9=Ensemble de solutions
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

val11=$[rint($(tmp0))]
tmp0=!randint 0, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 0, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in $val14/$val10
tmp0=!exec pari $t_

t_=!replace internal \( by ( in ($val14-($val11))/$val10
tmp1=!exec pari $t_

t_=!replace internal \( by ( in ($val14+($val11))/$val10
tmp2=!exec pari $t_

t_=!replace internal \( by ( in (1+($val11))/$val10
tmp3=!exec pari $t_

t_=!replace internal \( by ( in (-1-($val11))/$val10
tmp4=!exec pari $t_

t_=!replace internal \( by ( in (-1+($val11))/$val10
tmp5=!exec pari $t_

val15=e^{$val10 x}=e^{$val14},$(tmp0)	e^{$val10 x+$val11}=e^{$val14},$(tmp1)	e^{$val10 x-$val11}=e^{$val14},$(tmp2)	e^{$val10 x+$val11}=0,vide	e^{$val10 x-$val11}=0,vide	e^{$val10 x+$val11}=1,-$val11/$val10	e^{$val10 x-$val11}=e,$(tmp3)	e^{$val10 x+$val11}=-1,vide	e^{$val10 x-$val11}=-1,vide	e^{$val10 x+$val11}=-e,vide	e^{$val10 x-$val11}=-e,vide	e^{$val10 x+$val11}=\frac{1}{e},$(tmp4)	e^{$val10 x-$val11}=\frac{1}{e},$(tmp5)	
!if $val10==1 
tmp0=!replace internal $val10 x by x in $val15

val15=$(tmp0)
!endif
!if $val10==-1 
tmp0=!replace internal $val10 x by -x in $val15

val15=$(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val15

tmp0=!rowcnt $tmp
val16=$[rint($(tmp0))]
tmp0=!randint 1, $val16

val17=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val19=$(val18[1])
tmp0=!item 2 to -1 of $val18

val20=$(tmp0)
t_=!replace internal \( by ( in $val20
tmp0=!exec maxima $t_

val20=$(tmp0)

!ifval $val20 issametext vide
val21=$val6
!endif
replytype1=fset
replyname1=$val9
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val21


!goto stat

!exit

:question
$()	  $val7 
!insmath $val19
$().	<div class="wimscenter"><label for="reply1">
!insmath S=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	<div class="wims_instruction">$val8</div>	
$()
!exit

