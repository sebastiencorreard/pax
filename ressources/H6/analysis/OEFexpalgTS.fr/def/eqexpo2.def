!set title=Équation avec exponentielle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine,Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Résoudre dans \(\,\RR\) l'équation
val7=Pour écrire votre réponse,	  <ul><li>écrire <span class="tt">vide</span> s'il n'y a pas de solution.	  </li><li>s'il y a plusieurs solutions, les séparer par une virgule.	  </li></ul>	
val8=Ensemble de solutions
val9=On utilise l'équivalence
tmp0=!randint 0, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 0, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
val12=$[rint($val10+$val11)]
val13=$[rint($val10*$val11)]
tmp0=!randint 1, 5

val14=$[rint($(tmp0))]
val15=$[rint(-$val13)]
val16=$[rint(($val14+($val12)^2)/4+1)]
t_=!replace internal \( by ( in $val12*x-$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val17=$(tmp1)
t_=!replace internal \( by ( in x^2+$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
t_=!replace internal \( by ( in x^2-$val12*x
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val19=$(tmp1)
t_=!replace internal \( by ( in $val12*x-$val16
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val20=$(tmp1)
t_=!replace internal \( by ( in x^2+$val16
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val21=$(tmp1)
t_=!replace internal \( by ( in x^2-$val12*x+$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val22=$(tmp1)
t_=!replace internal \( by ( in x^2-$val12*x+$val13+1
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val23=$(tmp1)
t_=!replace internal \( by ( in x^2+$val13
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
t_=!replace internal \( by ( in x^2-$val12*x
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val19=$(tmp1)
tmp0=!randint 2, 4

tmp1=!randitem 1,-1

val24=$[rint($(tmp0)*$(tmp1))]
val25=$[rint($val13-$val24)]
t_=!replace internal \( by ( in $val12*x-($val25)
tmp0=!exec pari $t_

tmp1=!texmath $(tmp0)

val26=$(tmp1)
t_=!replace internal \( by ( in x^2+($val24)
tmp0=!exec pari $t_

tmp1=!texmath $(tmp0)

val27=$(tmp1)
val28=e^{x^2}=e^{$val17},$val10,$val11	e^{$val18}=e^{$val12 x},$val10,$val11	e^{$val19}=e^{$val15},$val10,$val11	e^{x^2}=e^{$val20},vide	e^{$val21}=e^{$val12 x},vide	e^{$val19}=e^{-$val16},vide	e^{$val22}=1,$val10,$val11	e^{$val23}=e,$val10,$val11	e^{$val26}=e^{$val27},$val10,$val11	
!if $val12==1 
tmp0=!replace internal $val12 x by x in $val28

val28=$(tmp0)
!endif
!if $val12==-1 
tmp0=!replace internal $val12 x by -x in $val28

val28=$(tmp0)
!endif
val29=$val9 \(e^{u(x)}=e^{v(x)} \Leftrightarrow u(x)=v(x)\).
tmp=!translate internal $	$ to ; in $val28

tmp0=!rowcnt $tmp
val30=$[rint($(tmp0))]
tmp0=!randint 1, $val30

val31=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val28

tmp=!row $val31 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val32=$(tmp0)
val33=$(val32[1])
tmp0=!item 2 to -1 of $val32

val34=$(tmp0)
replytype1=fset
replyname1=$val8
replygood1=$val34
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val29


!goto stat

!exit

:question
$()	  $val6 
!insmath $val33
$().	<div class="wimscenter"><label for="reply1">
!insmath S=
$()</label>  
!read oef/embed.phtml reply1 
$() </div>	<div class="wims_instruction">$val7</div>	
$()
!exit

