val6=$[rint($(tmp0))]
tmp0=!randint 1000, 5000

val7=$[rint($(tmp0))]
val8=$[log(2)/$val6]
t_=!replace internal \( by ( in expand(\y0*exp(-$val6*\x0)*exp($val6*x));
