!set title=Problème 1b
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sophie, Lemaire
email=Sophie.lemaire@math.u-psud.fr
language=fr
computeanswer=no
precision=100

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,4,5,6,7,8,9,10

val6=$[rint($(tmp0))]
tmp0=!randint 1000, 5000

val7=$[rint($(tmp0))]
val8=$[log(2)/$val6]
t_=!replace internal \( by ( in expand($val7*exp($val6*t));
tmp0=!exec maxima $t_

val9=$(tmp0)
tmp0=!texmath $val9

val10=$(tmp0)
replytype1=formal
replyoption1=noanalyzeprint 
replyname1=La solution de l'équation est :
replygood1=$val9
replytype2=numeric
replyoption2=noanalyzeprint 
replyname2=Le temps cherché est :
replygood2=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On désigne par 
!insmath p(t)
$() le nombre de bactéries dans un milieu de culture	 à l'instant 
!insmath t
$(), le temps étant mesuré en heures.	On suppose que 
!insmath p(0) =  $val7
$() et que pour tout 
!insmath t\geq 0
$(), 
!insmath p'(t) = $val6 p(t)
$() . <br>	Compléter les deux affirmations suivantes :	<ul><li>le nombre de bactéries au temps 
!insmath t
$()	est 
!insmath p(t) = 
$()  
!read oef/embed.phtml reply1,18 
$()  pour tout 
!insmath t\geq 0
$() ;</li>	<li>le nombre de bactéries est le double de son nombre initial	au temps 
!insmath t = 
$() 
!read oef/embed.phtml reply2,10 
$().	</li></ul>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La solution de l'équation 
!insmath p' = $val6 p
$() avec comme condition initiale	
!insmath p(0) = $val7
$() est  
!insmath p(t) = $val10
$() pour tout réel	
!insmath t
$(). Donc, le nombre de bactéries au temps 
!insmath t
$()	est 
!insmath p(t) = $val10
$() pour tout 
!insmath t\geq 0
$(). De plus,	 le nombre de bactéries  est le double de son nombre initial au	 temps 
!insmath t
$() vérifiant 
!insmath p(t) = 2p(0)
$(), c'est-à-dire au	 temps 
!insmath t = $val8
$().
$()
!exit

:latex
$()
$()
!exit

