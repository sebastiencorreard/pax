\title{Problème 1}
\language{fr}
\range{-5..5}
\author{Michel, Gosse}
\email{mgosse3@gmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(2,3,4,5,6,7,8,9,10)}
\integer{p0=random(1000..5000)}
\real{t=log(2)/\a}
\text{f=maxima(expand(\y0*exp(-\a*\x0)*exp(\a*x));)}
\statement{Dans une culture de bactéries, 
on désigne par \(p(t)\) la population à l'instant \(t\), 
le temps étant mesuré en heures. On sait que \(p'=\a p\) et 
qu'à l'instant 0 la population est égale à \p0. Au bout de combien de temps
la population a-t-elle doublé ?
}


\answer{Le temps cherché est : }{\t}{type=auto}
