!set lang_exists=yes


!! present.phtml

!set name_present1=!nosubst Vous voyez ci-dessous deux dessins. A gauche, les \
graphes de $fcnt fonctions $fs&nbsp;; à droite, celui d'une fonction combinée

!set name_present2=!nosubst Votre but est de trouver les coefficients de cette combinaison (addition),\
aussi proches que possible. Et vous disposez de $maxreply essais graphiques pour le faire.

!! main.phtml

!set name_giveupnote=en abandonnant votre note

!! intro.phtml

!set name_intro1=!nosubst Le principe est très simple&nbsp;: si l'on donne deux fonctions\
\(f_1(x)\) et \(f_2(x)\) ainsi que deux coefficients\
\(c_1\) et \(c_2\), vous savez certainement calculer la combinaison

!set name_intro2=Et vous savez tout aussi bien qu'à chaque fonction correspond son graphe.\
Mais sur le plan graphique, l'addition de fonctions parait plus difficile,\
car vous ne disposez plus de moyens de calcul évidents.

!set name_intro3= C'est précisément ce que vous propose cet exercice&nbsp;: on donne les\
graphes des fonctions et on vous demande de retrouver les coefficients de combinaison. \
Comme beaucoup d'autres exercices sur WIMS, l'entrainement sur cet exercice vous permettra\
d'accroitre votre capacité de reconnaissance graphique de fonctions.

!distribute items Type de fonctions,Nombre d'essais autorisés,Sévérité du score\
into name_introtype, name_introtry,name_severity

!set name_related=Coincidence, fonctions, addition

!! form.phtml

!distribute items votre essai numéro,Ecart moyen du dernier essai,\
into name_form1,name_form2

!set name_form1bis=!nosubst ( / $maxreply)

!set name_formbest=!nosubst Votre meilleure réponse est l'essai numéro $bestreply, \
  avec un écart moyen de
!set name_formnote=correspondant à une note virtuelle de
!set name_bestanswer=C'est votre meilleure réponse jusqu'ici.
!set name_formend=Terminer cet exercice et voir la note

