!set title=Triangle droit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
precision=10000
computeanswer=yes
precision=10000
title_en=Right triangle

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit un triangle droit comme suit, où,	et, à une vitesse constante de
val8=Au moment où, quelle est la vitesse du changement de,	  en
val9=Vitesse de BC en
val10=augmente,diminue
!if $val6=en 
val7=We have a right triangle as follows, where,	and, at a constant speed of
val8=At the moment when, what is the change speed of,	  in
val9=Speed of BC in
val10=increases,decreases
!endif
tmp0=!randint 30, 100

val11=$[rint($(tmp0))]
tmp0=!randint $val11/4, $val11/2

val12=$[rint($(tmp0))]
tmp0=!randint 2, 20

val13=$[rint($(tmp0))]
tmp0=!randint 10, 30

val14=$[rint($(tmp0))]
val15=$[$val13*$val12/sqrt($val12^2+$val11^2)]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val16=$[rint($(tmp0))]
val17=$(val10[$val16])

!ifval $val16=1
val15=$[$val15]
!else
val15=$[-$val15]
!endif
tmp0=!randitem cm,mm,m

val18=$(tmp0)
replyname1=$val9 $val18/s
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]), $(val7[2])	AB=$val11 $val18, $(val7[3]) AC $val17 $(val7[4]) $val13 $val18/s.	$(val8[1]) AC=$val12 $val18, $(val8[2])	BC (en $val18/s)?	<div class="wimscenter"><img src="$val1/pic.gif" alt="image" /></div>	
$()
!exit

