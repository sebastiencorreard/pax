!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer la dérivée de la fonction \(f\) définie par
!if $val6=en 
val7=Compute the derivative of the function \(f\) defined by
!endif
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val14=$[rint($(tmp0))]
tmp0=!randint 2, 5

val15=$[rint($(tmp0))]
tmp0=!randitem 	 sin($val8*x+$val11),	 cos($val8*x+$val11),	 sin($val8*x)+cos($val9*x),	 sin($val8*x)+tan($val9*x),	 cos($val8*x)+tan($val9*x),	 $val8*sin($val9*x+$val11),	 $val8*cos($val9*x+$val11),	 $val8*x*sin($val9*x+$val11),	 $val8*x*cos($val9*x+$val11),	 sin($val8*x^$val14),	 cos($val8*x^$val14),	 tan($val8*x+$val11)	

val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$(tmp0)
tmp0=!texmath $val16

val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f'(x)\)
replygood1=$val18
