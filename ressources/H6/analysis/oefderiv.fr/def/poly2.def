!set title=Polynome II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
language=fr
precision=10000
computeanswer=yes
precision=10000
title_en=Polynomial II

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer la dérivée de la fonction \(f\) définie par
!if $val6=en 
val7=Compute the derivative of the function \(f\) defined by
!endif
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val8=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val9=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val10=$[$(tmp0)/10*$(tmp1)]
val11=!rawmath (x+$val10)*(x+$val8)*(x+$val9)
tmp0=!texmath $val11

val12=$(tmp0)
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val13=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f '(x)\)
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	
!insmath f(x) = $val12
$()		.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,12
embedcnt=0
