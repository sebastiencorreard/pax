!set title=Cercle II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
language=fr
precision=10000
computeanswer=yes
precision=10000
title_en=Circle II

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit un cercle dont le rayon augmente à une vitesse	  constante de, centimètres par seconde.
val8=Vitesse d'aire
val9=À l'instant où son aire égale,centimètres carrés,	  quelle est la vitesse d'augmentation de son aire
!if $val6=en 
val7=We have a circle whose area increases at a constant speed of,	  centimeters per second.
val8=Area speed
val9=At the moment when its aera equals,square centimeters,	  qwhat is the speed at which its area increases
!endif
tmp0=!randint 20, 100

val10=$[$(tmp0)/10]
tmp0=!randint 10, 40

val11=$[rint($(tmp0))]
val12=$[sqrt($val11/pi)]
val13=$[2*pi*$val12*$val10]
val14=$val11, \(cm^2\),\(cm^2\)/s
val15=en
replyname1=$val8
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) $val10 $(val7[2]) $(val9[1])	  $(val14[1]) $(val9[2]), $(val9[3]) ($val15 $(val14[3]))?	
$()
