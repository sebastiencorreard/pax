!set title=Fonctions rationnelles II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
language=fr
precision=10000
computeanswer=yes
precision=10000
title_en=Rational functions II

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer la dérivée de la fonction \(f\) définie par
!if $val6=en 
val7=Compute the derivative of the function \(f\) defined by
!endif
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 9

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val14=$[rint($(tmp0))]
tmp0=!randint 2, 5

val15=$[rint($(tmp0))]
tmp0=!randitem 	 $val8*x/($val9*x^2+$val10*x+$val11),	 (x^2+$val8*x+1)/(x^2+$val9*x-1),	 $val8*x/((x+$val11)*(x+$val12)*(x+$val13)),	 (2*x+$val11)^$val14/(7*x+$val12)^$val15,	 (x^2+$val9*x+$val11)/($val10*x^3+$val12)	

val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
replytype1=formal
replyname1=\(f '(x)\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath  f(x) = $val17
$().
$()
!exit

