!set title=Dérivée réciproque
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
precision=10000
computeanswer=yes
precision=1000
title_en=Inverse derivative

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit,la fonction définie par
val8=Vérifiez que \(f\) est bijective, elle a donc une fonction réciproque
val9=Calculez la valeur,de sa dérivée en
val10=Vous devez répondre avec une précision d'au moins 4 chiffres significatifs.
!if $val6=en 
val7=Let, be the function defined by
val8=Verify that \(f\) is bijective, therefore we have an inverse function
val9=Calculate the value, of its derivative at
val10=You must reply with a precision of at least 4 significant digits.
!endif
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint abs($val11)+1, abs($val11)+3

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sin,cos

val15=$(tmp0)
tmp0=!randitem +,-

val16=$(tmp0)
val17=!rawmath $val12*x $val16 $val15($val11*x+$val13) + $val14
tmp0=!randint -100, 100

val18=$[rint($(tmp0))]
tmp=!replace internal .. by , in $val17 - ($val18),x=-1000..1000 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val19=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val17,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val20=!rawmath $(tmp0)
evaltmp=$val20

evaltmp=!mathsubst x=($val19) in $evaltmp
tmp0=($evaltmp)
val21=$[1/$(tmp0)]
replyname1=\(g'($val18)\)
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) 
!insmath f: \RR \to \RR
$() $(val7[2])	<div class="wimscenter">
!insmath f(x) = $val17 
$().</div>	$val8 
!insmath g = f^{-1}
$(). $(val9[1]) 
!insmath g'($val18)
$() $(val9[2]) 
!insmath $val18
$().	<div class="wims_instruction">	$val10</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,17,18
embedcnt=0
