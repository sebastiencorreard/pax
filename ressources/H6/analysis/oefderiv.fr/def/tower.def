!set title=Tour
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
precision=10000
computeanswer=no
precision=10000
title_en=Tower

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Quelqu'un marche vers une tour à une vitesse constante de,	  mètres par seconde.
val8=Si la hauteur de la tour est de,mètres,	  à quelle vitesse (en m/s) la distance entre lui et le sommet de la tour	  diminue-t-elle quand la distance entre lui et le pied de la tour est de, mètres&nbsp;
val9=Vitesse en
!if $val6=en 
val7=Somebody walks towards a tower at a constant speed of,	  meters per second.
val8=If the height of the tower is,meters,	  at what speed (in m/s) does the distance between the man and the top of the tower	  decrease when the distance between him and the foot of the tower is, meters
val9=Speed rate
!endif
tmp0=!randint 11, 25

val10=$[$(tmp0)/10]
tmp0=!randint 100, 200

val11=$[rint($(tmp0))]
tmp0=!randint 100, 300

val12=$[rint($(tmp0))]
val13=$[$val10*$val12/sqrt($val12^2+$val11^2)]
replyname1=$val9 m/s
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1])	$val10 $(val7[2]) $(val8[1]) $val11 $(val8[2]) ,	$(val8[3]) $val12 $(val8[4]) ?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11,12
embedcnt=0
