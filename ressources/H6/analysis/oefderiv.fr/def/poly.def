!set title=Polynome I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
language=fr
precision=10000
computeanswer=yes
precision=10000
title_en=Polynomial I

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer la dérivée de la fonction \(f\) définie par
val8=On a, donc
val9=en
!if $val6=en 
val7=Compute the derivative of the function \(f\) defined by
val8=We have, hence
val9=for
!endif
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val10=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val11=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 2, 6

tmp1=!randitem -1,1

val12=$[$(tmp0)*$(tmp1)]
tmp0=!randint 20, 200

tmp1=!randitem -1,1

val13=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
val15=!rawmath $val12*x^3+$val10*x^2+$val11*x+$val13
tmp0=!texmath $val15

val16=$(tmp0)
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
evaltmp=$val17

evaltmp=!mathsubst x=($val14) in $evaltmp
tmp0=($evaltmp)
val18=$[$(tmp0)]
replytype1=numeric
replyname1=\(f '($val14)\)
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	
!insmath f(x) = $val16
$()		$val9 
!insmath x=$val14
$()		.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$(val8[1]) 
!insmath f '(x)=$val17
$(),	$(val8[2]) 
!insmath f '($val14)=$val18
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,14,16,17,18
embedcnt=0
