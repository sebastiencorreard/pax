\text{lang=slib(oef/env lang)}


\title{Fonctions hyperboliques II}
\title_en{Hyperbolic functions II}

\text{name_enonce=Calculer la dérivée de la fonction \(f\) définie par}

\if{\lang=en}{

\text{name_enonce=Compute the derivative of the function \(f\) defined by}

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


}

\integer{a1=randint(2..9)*random(-1,1)}
\integer{a2=randint(2..9)*random(-1,1)}
\integer{a3=randint(2..9)*random(-1,1)}
\integer{b1=randint(1..9)*random(-1,1)}
\integer{b2=randint(1..9)*random(-1,1)}
\integer{b3=randint(1..9)*random(-1,1)}
\integer{p1=randint(2..5)}
\integer{p2=randint(2..5)}

\text{tfun1=random(ch,sh,th)}
\text{tfun2=random(ch,sh,th)}
\function{p=random(
	\tfun1(\tfun2(\a1*x)+\b1),
	\tfun1(\a1*x)^\p1,
	\a1/\tfun1(\a2*x+\b1),
	\a1*x/\tfun1(\a2*x+\b1),
	\a1*x^\p1*\tfun1(\a2*x),
	(\a1*\tfun1(x)+\b1)/(\a2*\tfun2(x)+\b2),
	\tfun1(\tfun2(\a1*x)^\p1)^\p2,
	x/\tfun1(\a1*x)^\p1
)}

\text{p=simplify(\p)}
\text{hp=texmath(\p)}
\function{der=diff(\p,x)}
\statement{\name_enonce \(f(x) = \hp\).}
\answer{\(f '(x)\)}{\der}{type=formal}

