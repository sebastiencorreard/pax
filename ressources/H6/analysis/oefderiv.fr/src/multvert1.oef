\title{Multiplication virtuelle}
\title_en{Virtual multiplication I}

\text{name_enonce=Soit \(f\) une fonction dérivable de dérivée \(f'\).
  Calculer la dérivée de la fonction \(g\) définie par}
\text{name_answer=Dérivée }

\if{\lang=en}{

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


\text{name_enonce=Let \(f\) be a differentiable function, with derivative \(f'\).
  Compute the derivative de la fonction \(g\) définie par}
\text{name_answer=Derivative }

}

\integer{a1=random(2..8)*random(1,-1)}
\integer{a2=random(2..8)*random(1,-1)}
\integer{c1=random(2..8)*random(1,-1)}
\integer{c2=random(2..8)*random(1,-1)}
\integer{c3=random(2..8)*random(1,-1)}
\integer{c4=random(2..8)*random(1,-1)}
\function{f1=slib(data/randline src/simple1.data)}
\function{f1=maxima(subst(\c1,c1,subst(\c2,c2,subst(\c3,c3,subst(\c4,c4,\f1)))))}
\text{g=simplify((\f1)*f(x))}
\text{F1=simplify((diff(\f1,x))*f(x)+(\f1)*fprime)}
\text{F=wims(replace internal fprime by f'(x) in \F1)}
\statement{\name_enonce \(g(x) = \g\).
}
\answer{\name_answer \(g'(x)\)}{\F}{type=formal}

