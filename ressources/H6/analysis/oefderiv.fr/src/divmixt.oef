\name_question[1] \(h\) \name_question[2] \(h(x) = \hg / f(x)\).
\name_question[3]  \(h'(\x0)\).}
\answer{\(h'(\x0)\)}{\sol}{type=numeric}
\hint{\name_hint[] \(\hg\) \name_hint[2] \(x_0=\x0\), \name_hint[3]}
\solution{\name_feed[1] \(g(x)=\hg\). \name_feed[2] \(g(\x0)=\b1\),
\(g'(\x0)=\b2\), \name_feed[3]
<div class="wimscenter">
 \(h'(\x0) = \frac{f(\x0)g'(\x0) - f '(\x0)g(\x0)}{f(\x0)^2}\)
 <br>= \(\frac{(\a1)(\b2) - (\a2)(\b1)}{(\a1)^2} = \sol\).
</div>
