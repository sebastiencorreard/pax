\text{lang=slib(oef/env lang)}

\title{Dérivée réciproque}
\title_en{Inverse derivative}

\text{name_enonce=Soit,la fonction définie par}
\text{name_enonce2=Vérifiez que \(f\) est bijective, elle a donc une fonction réciproque}
\text{name_question=Calculez la valeur,de sa dérivée en}
\text{name_instruction=Vous devez répondre avec une précision d'au moins 4 chiffres significatifs.}

\if{\lang=en}{

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


\text{name_enonce=Let, be the function defined by}.
\text{name_enonce2=Verify that \(f\) is bijective, therefore we have an inverse function}
\text{name_question=Calculate the value, of its derivative at}
\text{name_instruction=You must reply with a precision of at least 4 significant digits.}

}

\computeanswer{yes}
\format{html}
\precision{1000}
\integer{a=random(1..5)*random(-1,1)}
\integer{b=random(abs(\a)+1..abs(\a)+3)*random(-1,1)}
\integer{c1=random(1..20)*random(-1,1)}
\integer{c2=random(1..20)*random(-1,1)}
\text{sincos=random(sin,cos)}
\text{sign=random(+,-)}
\function{f=\b*x \sign \sincos(\a*x+\c1) + \c2}
\integer{y0=random(-100..100)}
\real{x0=solve(\f - (\y0),x=-1000..1000)}
\function{der=diff(\f,x)}
\real{sol=1/evalue(\der,x=\x0)}
\statement{\name_enonce[1] \(f: \RR \to \RR\) \name_enonce[2]
<div class="wimscenter">\(f(x) = \f \).</div>
\name_enonce2 \(g = f^{-1}\). \name_question[1] \(g'(\y0)) \name_question[2] \(\y0\).
<div class="wims_instruction">
\name_instruction</div>
}
\answer{\(g'(\y0)\)}{\sol}

