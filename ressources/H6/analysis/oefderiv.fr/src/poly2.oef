\title{Polynome II}
\title_en{Polynomial II}

\text{name_enonce=Calculer la dérivée de la fonction \(f\) définie par}

\if{\lang=en}{

\text{name_enonce=Compute the derivative of the function \(f\) defined by}

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


}

\computeanswer{yes}
\format{html}
\precision{10000}
\real{b=randint(20..200)/10*random(-1,1)}
\real{c=randint(20..200)/10*random(-1,1)}

\real{a=randint(20..200)/10*random(-1,1)}
\function{p=(x+\a)*(x+\b)*(x+\c)}

\text{hp=texmath(\p)}
\function{der=diff(\p,x)}

\statement{\name_enonce
\(f(x) = \hp\)

.}

\answer{\(f '(x)\)}{\der}{type=formal}

