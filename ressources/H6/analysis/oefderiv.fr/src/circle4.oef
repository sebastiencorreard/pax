\title{Cercle IV}
\title_en{Circle IV}

\text{name_enonce=Soit un cercle dont l'aire augmente à une vitesse
  constante de, centimètres carrés par seconde.}
\text{name_answer=Vitesse de rayon}

\text{name_question=À l'instant où son rayon égale,centimètres,
  quelle est la vitesse d'augmentation de son rayon}

\if{\lang=en}{

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


\text{name_enonce=We have a circle whose area increases at a constant speed of,
  square centimeters per second.}
\text{name_answer=Radius speed}

\text{name_question=At the moment when its radius equals,centimeters,
   what is the speed at which the radius increases}

}

\real{a=randint(20..100)}
\real{r=randint(10..30)}
\real{area=pi*\r^2}
\real{sol=\a/sqrt(4*pi*\area)}

\text{var=\r,cm,cm/s}

\text{name_in=en}
\statement{\name_enonce[1] \a \name_enonce[2] \name_question[1]
  \var[1] \name_question[2], \name_question[3] (\name_in \var[3])?
}
\answer{\name_answer}{\sol}

