\title{Arc et Arg}
\title_en{Arc and Arg}

\text{name_enonce=Établissez la correspondance entre les fonctions et leurs
  dérivées dans le tableau suivant.}

\if{\lang=en}{

We have a circle whose area increases at a constant speed of
\a square centimeters per second. At the moment when its radius equals \r
cm, what is the speed at which the radius increases (in cm/s)?


\text{name_enonce=Establish the correspondence between the fucntions and their derivatives
in the following table.}

}

\matrix{data=arccos(x),-1/sqrt(1-x^2)
arcsin(x),1/sqrt(1-x^2)
arctan(x),1/(1+x^2)
argch(x),1/sqrt(x^2-1)
argsh(x),1/sqrt(x^2+1)
argth(x),1/(1-x^2)
sqrt(x^2+1),x/sqrt(x^2+1)
sqrt(x^2-1),x/sqrt(x^2-1)
sqrt(1-x^2),-x/sqrt(1-x^2)
ln(1+x^2),2x/(1+x^2)
ln(1-x^2),-2x/(1-x^2)
}
\integer{datacnt=rows(\data)}
\text{sh=shuffle(\datacnt)}
\matrix{data=\data[\sh[1..5];]}
\text{fn=wims(makelist \(x) for x in \data[;1])}
\text{der=wims(makelist \(x) for x in \data[;2])}
\statement{\name_enonce
<div class="wimscenter">
\embed{r1,60x120}
</div>
}
