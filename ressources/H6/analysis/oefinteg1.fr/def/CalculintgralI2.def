!set title=Calcul intégral II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Michel, Gosse
email=michel.gosse@ac-poitiers.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem -2,-1,1,2

val6=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val7=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val8=$[rint($(tmp0))]
val9=$[rint(-$val8/$val6)]
tmp0=!randitem 2,3

val10=$[rint($(tmp0))]
tmp0=!randitem -2,-1,1,2

val11=$[rint($(tmp0))]
val12=$[rint($val11*($val6)^2)]
val13=$[rint($val11*$val8*$val6)]
val14=$[rint(($val6)^2)]
val15=$[rint(2*$val8*$val6)]
val16=$[rint(($val8)^2)]

!ifval ($val6>0)
tmp0=!randitem $val9+1,$val9+2

val17=$[rint($(tmp0))]
!else
tmp1=!randitem $val9-2,$val9-1

val17=$[rint($(tmp1))]
!endif

!ifval ($val6>0)
tmp0=!randint $val9+3, 6

val18=$[rint($(tmp0))]
!else
tmp1=!randint -6, $val9-3

val18=$[rint($(tmp1))]
!endif

!ifval ($val18<$val17)
val19=$[rint(1)]
!else
val19=$[rint(0)]
!endif

!ifval ($val19=1)
val20=$[rint($val17)]
!else
val20=$[rint($val18)]
!endif

!ifval ($val19=1)
val21=$[rint($val18)]
!else
val21=$[rint($val17)]
!endif
tmp0=!randitem ($val6*x+$val8)^$val10,1/($val6*x+$val8)^$val10,$val7/($val6*x+$val8),	($val12*x+$val13)/($val14*x^2+$val15*x+$val16),$val7/sqrt($val6*x+$val8),$val7*e^($val6*x),	$val7*e^($val6*x+$val8),($val12*x+$val13)*e^($val14*x^2+$val15*x+$val16),	$val6*x^2+$val8*x+$val7	

val22=!rawmath $(tmp0)
tmp0=!texmath $val22

val23=$(tmp0)
tmp=!translate ;";': to $     $ in $val22,x 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val24=!rawmath $(tmp0)
t_=!replace internal \( by ( in 1/($val20-$val21)*(subst(x=$val20,$val24)-subst(x=$val21,$val24));
tmp0=!exec maxima $t_

val25=$(tmp0)
tmp0=!texmath $val25

val26=$(tmp0)
tmp0=!texmath $val24

val27=$(tmp0)
val28=\,\textrm{d}x
replytype1=auto

replyname1=Valeur de I
replygood1=$val25
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Calculer la valeur moyenne sur l'intervalle 
!insmath \lbrack$val21;$val20\rbrack
$() de la fonction 
!insmath f
$() définie par&nbsp;:	<div class="wimscenter">	
!insmath f(x)=$val23
$()	</div>	<div class="wims_instruction">	Pour entrer la réponse, on utilise les conventions suivantes&nbsp;:<br>	La fonction logarithme népérien s'écrit <span class="tt">log</span>. Par exemple, on tape	<span class="tt">log(2)</span> pour écrire le réel <span class="nowrap">
!insmath ln(2)
$().</span> <br>	La fonction racine carrée s'écrit <span class="tt">sqrt</span>. Par exemple, on entre	<span class="tt">sqrt(2)</span> pour écrire le réel <span class="nowrap">
!insmath \sqrt{2}
$().</span> <br>	Enfin, la fonction exponentielle s'écrit <span class="tt">exp</span>. Par exemple, on tape	<span class="tt">exp(2)</span> pour désigner le réel <span class="nowrap">
!insmath e^2
$().</span> Il est aussi possible de simplifier	la notation en écrivant <span class="tt">e^2</span>.	</div>	
$()
!exit

:hint
$()La valeur moyenne 
!insmath V
$() d'une fonction 
!insmath f
$() sur un intervalle	
!insmath \lbrack a,b\rbrack
$() avec	
!insmath a
$() strictement inférieur à 
!insmath b
$() est donnée par la formule&nbsp;:	<div class="wimscenter">	
!insmath V=\frac{1}{b-a}\int_{a}^{b}f(x)$val28
$()	</div>	On doit donc calculer&nbsp;:	<div class="wimscenter">	
!insmath \frac{1}{($val20)-($val21)} \int_{$val21}^{$val20} $val23$val28
$()	</div>	On rappelle les formules de dérivation&nbsp;:	<p>	
!insmath \left(\dfrac{1}{u}\right)^'=-\dfrac{u^'}{u^2}
$() <br>	
!insmath (e^u)^{'}=u^'e^u
$()<br>	
!insmath (\ln u)^'=\dfrac{u^'}{u}
$()<br>	
!insmath (u^n)^'=n u^{n-1}u^'
$()<br>	
!insmath (\sqrt{u})^'=\dfrac{u^'}{2\sqrt{u}}
$()	</p>	
$()
!exit

:help
$()
$()
!exit

:solution
$()Une primitive de la fonction&nbsp;:	<div class="wimscenter">	
!insmath x \longmapsto $val23
$()	</div>	est la fonction&nbsp;:	<div class="wimscenter">	
!insmath x \longmapsto $val27
$()	</div>	ce qui permet de calculer la valeur moyenne donnée par&nbsp;:	<div class="wimscenter">	
!insmath \frac{1}{($val20)-($val21)} \int_{$val21}^{$val20} $val23$val28=$val26
$()	</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=20,21,23,26,27,28
embedcnt=0
