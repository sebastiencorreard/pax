\title{Fonction et intégrale}
\language{fr}
\range{-5..5}
\author{Michel, Gosse}
\email{michel.gosse@ac-poitiers.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{b=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\integer{c=random(1..10)}
\integer{e=random(1..10)}
\integer{d=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\function{f=random(\b*sqrt(\c+\e*x^2),\b/(\c+\e*x^2),
\b*exp(\d*x^2),\b*log(1+\c+\e*x^2))}
\text{f=maxima(\f;)}
\text{ftex=texmath(\f)}
\integer{a=random(-10..10)}
\real{val=evalue(\f,x=0)}
\text{bon=(\val>0)?croissante:décroissante}
\text{bon1=(\val>0)?>0:<0}
\text{faux=(\val>0)?,décroissante:croissante}

\text{g=maxima(subst(x=t,\f);)}
\text{gtex=texmath(\g)}

\statement{On considère la fonction \(F\) définie sur \(\,\RR\) par&nbsp;:
<div class="wimscenter">
\(F(x)=integrate(\g,t=\a..x)\)
</div>
Sur \(\,\RR), la fonction \(F\) est&nbsp;:
}

\hint{Par définition, la fonction \(F\) désigne l'unique primitive sur \(\,\RR\) de la fonction
<div class="wimscenter">
\(t \longmapsto \gtex)
</div>
qui s'annule en <span class="nowrap">\(\a\).</span>}

\choice{Sens :}{\bon}{\faux}

\solution{On peut dire que pour tout \(x\) de <span class="nowrap">\(\,\RR\),</span>
la dérivée de la fonction \(F\) a pour expression&nbsp;:
<div class="wimscenter">
\(F^{'}(x)=\ftex)
</div>
Comme <span class="nowrap">\(F^{'}(x)\bon1\),</span> on en déduit que la fonction \(F\) est \bon sur <span class="nowrap">\(\,\RR\).</span>}
