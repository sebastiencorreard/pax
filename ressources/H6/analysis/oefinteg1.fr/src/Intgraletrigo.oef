\title{Intégrale trigo}
\language{fr}
\range{-5..5}
\author{Michel, Gosse}
\email{michel.gosse@ac-poitiers.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-2,-1,1,2)}
\integer{a1=random(1,2)}
\integer{b=random(1,2,3)}
\integer{choixinf=random(1..18)}
\integer{choixsup=random(1..18)}
\integer{choixsup=(\choixinf=\choixsup)?random(1..18)}
\integer{choixsup=(\choixinf=\choixsup)?random(1..18)}
\text{inf=item(\choixinf,0,
pi/6,pi/4,pi/2,pi/3,pi,
-pi/6,-pi/4,-pi/2,-pi/3,-pi,
2pi/3,3pi/4,5pi/6,
-2pi/3,-3pi/4,-5pi/6,2pi
)}
\text{sup=item(\choixsup,0,pi/6,pi/4,pi/2,pi/3,pi,
-pi/6,-pi/4,-pi/2,-pi/3,-pi,
2*pi/3,3pi/4,5pi/6,
-2*pi/3,-3*pi/4,-5pi/6,2*pi
)}

\text{minf=item(\choixinf,0,%pi/6,%pi/4,%pi/2,%pi/3,%pi,
-%pi/6,-%pi/4,-%pi/2,-%pi/3,-%pi,
2*%pi/3,3*%pi/4,5*%pi/6,
-2*%pi/3,-3*%pi/4,-5*%pi/6,2*%pi
)}
\text{msup=item(\choixsup,0,%pi/6,%pi/4,%pi/2,%pi/3,%pi,
-%pi/6,-%pi/4,-%pi/2,-%pi/3,-%pi,
2*%pi/3,3*%pi/4,5*%pi/6,
-2*%pi/3,-3*%pi/4,-5*%pi/6,2*%pi
)}

\function{f=random(\a*cos(\b*x),\a*sin(\b*x),cos(\a1*x)^2,
sin(\a1*x)^2,\a*cos(x+pi),\a*sin(x+pi),\a*cos(x+pi/2),
\a*sin(x+pi/2))}
\function{g=int(\f,x)}
\text{rep=maxima(expand(subst(x=\msup,\g)-subst(x=\minf,\g));)}

\text{f1=texmath(\f)}
\text{g1=texmath(\g)}

\statement{Calculer la valeur exacte de l'intégrale
<div class="wimscenter">
\(I=integrate(\f,x=\inf..\sup)\)
</div>
<div class="wims_instruction">
La fonction racine carrée se note <span class="tt">sqrt</span>.
Par exemple, le nombre \(\sqrt{2}\) se note <span class="tt">sqrt(2)</span>.</span>
<br>Le nombre \(\pi\) se note <span class="tt">pi</span>.
</div>}

\hint{On rappelle les formules de dérivation&nbsp;:
<div class="wimscenter">
\((cos(u))^{'}=-u^'\times sin(u)\)<br> 
\((sin(u))^{'}=u^'\times cos(u)\)
</div>
On rappelle aussi les valeurs remarquables des lignes trigonométriques&nbsp;:
<table class="wimscenter wimsborder wims_scrollable" width="50%">
  <tbody>
    <tr>
      <td>\(x\)</td>
      <td>\(0\)</td>
      <td>\(\frac{\pi}{6})</td>
      <td>\(\frac{\pi}{4})</td>
      <td>\(\frac{\pi}{3})</td>
      <td>\(\frac{\pi}{2})</td>
    </tr>
    <tr>
      <td>\(cos x\)</td>
      <td>\(1\)</td>
      <td>\(\frac{\sqrt{3}}{2})</td>
      <td>\(\frac{\sqrt{2}}{2})</td>
      <td>\(\frac{1}{2})</td>
      <td>\(0\)</td>
    </tr>
    <tr>
      <td>\(sin x\)</td>
      <td>\(0\)</td>
      <td>\(\frac{1}{2})</td>
      <td>\(\frac{\sqrt{2}}{2})</td>
      <td>\(\frac{\sqrt{3}}{2})</td>
      <td>\(1\)</td>
    </tr>
  </tbody>
</table>
ainsi que les formules trigonométriques suivantes&nbsp;:
<div class="wimscenter">
\(\cos (2x)=2 cos^2 x-1\) et \(cos (2x)=1-2 sin^2 x\)
</div>
}

\answer{Valeur de I}{\rep}{type=formal}
\solution{Une primitive de la fonction
<div class="wimscenter">
\(x \longmapsto \f1)
</div>
est la fonction&nbsp;:
<div class="wimscenter">
\(x \longmapsto \g1)
</div>
}
