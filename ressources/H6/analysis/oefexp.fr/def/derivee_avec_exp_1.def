!set title=Dérivée avec exponentielle (1)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 100

tmp1=!randitem -1,1

val6=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint 1, 100

tmp1=!randitem -1,1

val7=$[$(tmp0)/10*$(tmp1)]
tmp0=!randint -100, 100

val8=$[$(tmp0)/10]
tmp0=!randint -100, 100

val9=$[$(tmp0)/10]
tmp0=!randint -100, 100

val10=$[$(tmp0)/10]
val11=!rawmath $val7*x
val12=!rawmath $val7*x+$val8
val13=!rawmath $val9*x
val14=!rawmath $val9*x+$val10
val15=$[$val6*$val7]
tmp0=!randint 1, 5

val16=$[rint($(tmp0))]
val17=$val6*e^($val11),$val6*e^($val12),$val6*e^($val11)+$val13,$val6*e^($val11)+$val14,$val6*e^($val12)+$val14
!if $val16=1 
val18=!rawmath $val15*e^($val11)
!endif
!if $val16=2 
val18=!rawmath $val15*e^($val12)
!endif
!if $val16=3 or $val16=4 
val18=!rawmath $val15*exp($val11)+$val9
!endif
!if $val16=5 
val18=!rawmath $val15*exp($val12)+$val9
!endif
replytype1=algexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div id="enonce">	Soit 
!insmath f
$() la fonction définie sur 
!insmath \mathbb{R}
$() par 
!insmath f(x)=$(val17[$val16])
$().<br>	<div class="question">Calculer 
!insmath f'(x)
$().</div>	<div class="reponse">	
!insmath f'(x)
$()= 
!read oef/embed.phtml r1 
$()	</div>	</div>	
$()
!exit

:hint
$()<div class="indication">	La dérivée de  
!insmath k\times e^{u(x)}
$() (où 
!insmath k
$() est une constante) est 
!insmath k\times u'(x)\times e^{u(x)}
$().	
!if $val16>=3 
$()<br>Et la dérivée d'une somme est la somme des dérivées. 
!endif
$()	</div>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,17
embedcnt=1
