tmp0=!randint 1, 50

val6=$[$(tmp0)/10]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val7=$(tmp0)
!if $val7=+ 
val7=
!endif
val8=$[$val7$val6]
tmp0=!randint 1, 50

val9=$[$(tmp0)/10]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val10=$(tmp0)
!if $val10=+ 
val10=
!endif
val11=$[$val10$val9]
tmp0=!randint 1, 50

val12=$[$(tmp0)/10]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val13=$(tmp0)
!if $val13=+ 
val13=
!endif
val14=$[$val13$val12]
val15=\(e^{$val8}\times e^{$val11})
val16=\(\frac{e^{$val8}}{e^{$val11}})
val17=\(\frac{e^{$val8}\times e^{$val11}}{e^{$val14}})
val18=\(\left(e^{$val8}\right)^{$val11})
val19=\(\left(e^{$val8}\right)^{$val11}\times e^{$val14})
val20=\(\sqrt{e^{$val8}})
val21=\(e^{$val8}\times \sqrt{e^{$val11}})
tmp0=!randint 1, 7

val22=$[rint($(tmp0))]
val23=$val15,$val16,$val17,$val18,$val19,$val20,$val21
!if $val22=1 
val24=$[$val8+$val11]
!endif
!if $val22=2 
val24=$[$val8-$val11]
!endif
!if $val22=3 
val24=$[$val8+$val11-$val14]
!endif
!if $val22=4 
