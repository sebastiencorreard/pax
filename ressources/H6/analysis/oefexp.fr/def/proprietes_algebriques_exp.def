!endif
!if $val22=5 
val24=$[$val8*$val11+$val14]
!endif
!if $val22=6 
val24=$[$val8/2]
!endif
!if $val22=7 
val24=$[$val8+$val11/2]
!endif
replytype1=numeric
replyname1=
replygood1=$[$val24]
