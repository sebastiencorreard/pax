\title{Inéquations avec exponentielle}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\precision{1000000000}

\integer{a=randint(-1,1)*randint(1..15)}
\integer{b=randint(-1,1)*randint(1..15)}
\integer{k=randint(-15..15)}
\integer{i=randint(1..3)}
\if{\i=2}{\while{\a=1}{\integer{a=randint(-1,1)*randint(1..15)}}}
\text{equ=e^x,\a*e^x,\a*e^x+\b}
\integer{j=randint(1..4)}
\text{rel = <,<=,>,>=}
\text{relo = >,>=,<,<=}




\text{og=&#93;}\text{fg=&#91;}\text{fd=&#93;}\text{od=&#91;}\text{pv=&#59;}
\text{ag=&#123;}\text{ad=&#125;}

\if{\i=1}{\integer{K=\k}}
\if{\i=2}{\rational{K=\k/\a}\if{\a>0}{\text{relo=\rel}}\text{rep3=\j}\text{rep4=\K}}
\if{\i=3}{\rational{K=(\k-\b)/\a}\if{\a>0}{\text{relo=\rel}}\text{rep3=\j}\text{rep4=\K}}

\text{intervalles=\og-\(\infty) \pv ln(\K)\od,\og-\(\infty) \pv ln(\K)\fd,\og ln(\K) \pv +\(\infty)\od,\fg ln(\K) \pv +\(\infty)\od,\(\mathbb R),\ag\K\ad,\ag ln(\K)\ad,\og-\(\infty) \pv \K\od,\og-\(\infty) \pv \K\fd,\og \K \pv +\(\infty)\od,\fg \K \pv +\(\infty)\od}
\if{\K<0}{\rational{L=-\K}\text{intervalles=\og-\(\infty) \pv ln(\L)\od,\og-\(\infty) \pv ln(\L)\fd,\og ln(\L) \pv +\(\infty)\od,\fg ln(\L) \pv +\(\infty)\od,\(\mathbb R)},\ag\K\ad,\ag ln(\K)\ad,\og-\(\infty) \pv \K \od,\og-\(\infty) \pv \K\fd,\og \K \pv +\(\infty)\od,\fg \K \pv +\(\infty)\od}
\if{\K=0}{\text{intervalles=\og-\(\infty) \pv 0\od,\og-\(\infty) \pv 0\fd,\og 0 \pv +\(\infty)\od,\fg 0 \pv +\(\infty)\od,\(\mathbb R),\ag\K\ad}}


\if{\i=1}{\text{etape=r1}}
\if{\i=2 or \i=3}{\text{etape=r3,r4}}

\nextstep{\etape}

\if{\i=1}{
\if{\j<=2 and \k<=0}{\text{rep1=2}}{\text{rep1=1}}
\if{\k<=0 and \j>=3}{\text{rep2=\intervalles[5]}}
\if{\k>0 and \j=1}{\text{rep2=\intervalles[\j]}}
\if{\k>0 and \j=2}{\text{rep2=\intervalles[\j]}}
\if{\k>0 and \j=3}{\text{rep2=\intervalles[\j]}}
\if{\k>0 and \j=4}{\text{rep2=\intervalles[\j]}}
}

\if{(\i=2 or \i=3) and \a>0}{
\if{\j<=2 and \K<=0}{\text{rep5=2}}{\text{rep5=1}}
\if{\K<=0 and \j>=3}{\text{rep6=\intervalles[5]}}
\if{\K>0 and \j=1}{\text{rep6=\intervalles[1]}}
\if{\K>0 and \j=2}{\text{rep6=\intervalles[2]}}
\if{\K>0 and \j=3}{\text{rep6=\intervalles[3]}}
\if{\K>0 and \j=4}{\text{rep6=\intervalles[4]}}
}

\if{(\i=2 or \i=3) and \a<0}{
\if{\j>=3 and \K<=0}{\text{rep5=2}}{\text{rep5=1}}
\if{\K<=0 and \j<=2}{\text{rep6=\intervalles[5]}}
\if{\K>0 and \j=1}{\text{rep6=\intervalles[3]}}
\if{\K>0 and \j=2}{\text{rep6=\intervalles[4]}}
\if{\K>0 and \j=3}{\text{rep6=\intervalles[1]}}
\if{\K>0 and \j=4}{\text{rep6=\intervalles[2]}}
}



\statement{
<div id="enonce">
On souhaite résoudre l'inéquation \(\equ[\i] \rel[\j] \k).
\if{\i=1}{
\if{r1 isin \etape}{<div class="reponse">Cette équation a t-elle des solutions \embed{r1}.</div>}
\if{\step>=2 and \rep1=1}{<div class="reponse">L'ensemble des solutions est \embed{r2,200x25}</div>}
}

\if{\i=2 or \i=3}{
\if{\step=1}{<div class="reponse">Cette inéquation est équivalente à \(e^x) \embed{r3} \embed{r4,7}.</div>}
\if{\step=2 and \sc_reply3=1 and \sc_reply4=1}{
<div class="oui">Effectivement \(e^x\relo[\j]\rep4)</div>
<div class="reponse">Cette inéquation possède t-elle des solutions ? \embed{r5}.</div>}
\if{\step=2 and (\sc_reply3!=1 or \sc_reply4!=1)}{
<div class="non">Attention, on a \(e^x\relo[\j]\rep4)</div>
<div class="reponse">Cette inéquation possède  t-elle des solutions ?\embed{r5}.</div>}
\if{\step>=3 and \rep5=1}{
\if{\sc_reply3=1 and \sc_reply4=1}{<div class="oui">\(e^x\relo[\j]\rep4)</div>}{<div class="non">\(e^x\relo[\j]\rep4)</div>}
<div class="reponse">L'ensemble des solutions est : \embed{r6,200x25}</div>
}
}

</div>}


\answer{y a t-il des solutions ?}{\rep1;oui,non}{type=menu}
\answer{Ensemble des solutions}{\rep2;\intervalles}{type=dragfill}
\if{\i=1 and \sc_rep1y1!=1}{\text{etape=}\text{cond=}}
\if{\i=1 and \sc_reply1=1}{\if{\rep1=1}{\text{etape=r2}}{\text{etape=}}}
\if{\i=1 and \step>2}{\text{etape=}}

\answer{ordre}{\rep3;\relo}{type=menu}{option=nonstop}
\answer{valeur}{\rep4}{type=formal}{option=nonstop}
\answer{y a t-il des solutions ?}{\rep5;oui,non}{type=menu}
\if{\step=2}{\hint{Pour savoir si l'inéquation possède ou non des solutions, utiliser le signe de l'exponentielle. Par exemple \(e^x) ne peut pas être plus petite qu'un nombre négatif}}
\answer{ensemble des solutions}{\rep6;\intervalles}{type=dragfill}
\if{(\i=2 or \i=3) and \step=2}{\text{etape=r5}}
\if{(\i=2 or \i=3) and \sc_reply5!=1 and \step=3}{\text{etape=}}
\if{(\i=2 or \i=3) and \sc_reply5=1 and \step=3}{\if{\rep5=2}{\text{etape=}}{\text{etape=r6}}}
\if{(\i=2 or \i=3) and \step>3}{\text{etape=}}
