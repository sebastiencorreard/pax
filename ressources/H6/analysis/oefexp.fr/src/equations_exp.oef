\title{Equations avec exponentielle}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}

\integer{a=randint(-1,1)*randint(1..15)}
\integer{b=randint(-1,1)*randint(1..15)}
\integer{k=randint(-15..15)}
\integer{i=randint(1..3)}
\if{\i=2}{\while{\a=1}{\integer{a=randint(-1,1)*randint(1..15)}}}
\text{equ=e^x,\a*e^x,\a*e^x+\b}

\text{cond=}
\if{\i=1}{\text{etape=r1}}
\if{\i=2 or \i=3}{\text{etape=r3}}

\nextstep{\etape}
\conditions{\cond}

\if{\i=1}{\if{\k<=0}{\text{rep1=1}}{\text{rep1=2} \real{v_exact=ln(\k)} \real{rep2=rint(ln(\k)*1000)/1000}}}
\if{\i=2}{\rational{rep3=\k/\a}\if{\rep3<=0}{\text{rep4=1}}{\text{rep4=2}\real{v_exact=ln(\rep3)} \real{rep5=rint(ln(\rep3)*1000)/1000}}}
\if{\i=3}{\rational{rep3=(\k-\b)/\a}\if{\rep3<=0}{\text{rep4=1}}{\text{rep4=2} \real{v_exact=ln(\rep3)}\real{rep5=rint(ln(\rep3)*1000)/1000}}}


\statement{
<div id="enonce">
On souhaite résoudre l'équation \(\equ[\i]=\k).
\if{\i=1}{
\if{r1 isin \etape}{<div class="reponse">Cette équation possède \embed{r1} solution.</div>}
\if{\step>=2 and \rep1=2}{<div class="reponse">La solution arrondie au millième est \(x)=\embed{r2}</div>}
}

\if{\i=2 or \i=3}{
\if{r3 isin \etape}{<div class="reponse">Cette équation peut s'écrire \(e^x=) \embed{r3}.</div>}
\if{r4 isin \etape and \sc_reply3=1 or (\step>2 and \sc_reply3=1)}{
<div class="oui">Effectivement \(e^x=\rep3)</div>
<div class="reponse">Cette équation possède \embed{r4} solution.</div>}
\if{r4 isin \etape and \sc_reply3!=1 or (\step>2 and \sc_reply3!=1)}{
<div class="non">Attention, on a \(e^x=\rep3)</div>
<div class="reponse">Cette équation possède \embed{r4} solution.</div>}

\if{\step>=3 and \rep4=2}{<div class="reponse">La solution arrondie au millième est \embed{r5}</div>}
}

</div>}


\answer{Nombre de solution}{\rep1;0,1}{type=menu}
\feedback{\sc_reply1=0 and \rep1=1}{
<font color=green>\(e^x) est toujours strictement positif et donc ne prend jamais la veleur \k.</font>}
\answer{Valeur approchée de la solution : }{\saisie2}{type=numeric}
\condition{La valeur approchée est-elle correcte ?}{abs(\saisie2-\rep2)<=.001}
\feedback{\i=1 and \sc_reply1=1 and \rep1=2 and abs(\saisie2-\v_exact)>.001}{On a \(x=ln(\k)\simeq \rep2)}
\if{\i=1 and \sc_rep1y1!=1}{\text{etape=}\text{cond=}}
\if{\i=1 and \sc_reply1=1}{\if{\rep1=1}{\text{etape=}\text{cond=}}{\text{etape=r2}\text{cond=1}}}
\if{\i=1 and \step>2}{\text{etape=}}

\answer{\(e^x)}{\rep3}{type=formal}{option=nonstop}
\answer{nombre de solution}{\rep4;0,1}{type=menu}
\answer{valeur approchée}{\saisie5}{type=numeric}
\condition{Valeur approchée correcte ?}{abs(\saisie5-\v_exact)<=.001}
\feedback{(\i=2 or \i=3) and \sc_reply4=1 and \rep4=2 and abs(\saisie5-\v_exact)>.001}{On a \(x=ln(\rep3)\simeq \rep5)}
\if{(\i=2 or \i=3) and \step=2}{\text{etape=r4}\text{cond=}}
\if{(\i=2 or \i=3) and \sc_reply4!=1 and \step=3}{\text{etape=}\text{cond=}}
\if{(\i=2 or \i=3) and \sc_reply4=1 and \step=3}{\if{\rep4=1}{\text{etape=}\text{cond=}}{\text{etape=r5}\text{cond=2}}}
\if{(\i=2 or \i=3) and \step>3}{\text{etape=}}
