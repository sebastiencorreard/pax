\title{Propriétés algébriques de l'exponentielle}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\precision{100000}
\format{html}

\real{\absa=randint(1..50)/10}\text{sa=randitem(+,-)}\if{\sa=+}{\text{sa=}}\real{a=\sa\absa}
\real{\absb=randint(1..50)/10}\text{sb=randitem(+,-)}\if{\sb=+}{\text{sb=}}\real{b=\sb\absb}
\real{\absc=randint(1..50)/10}\text{sc=randitem(+,-)}\if{\sc=+}{\text{sc=}}\real{c=\sc\absc}



\text{calcul1=\(e^{\a}\times e^{\b})}
\text{calcul2=\(\frac{e^{\a}}{e^{\b}})}
\text{calcul3=\(\frac{e^{\a}\times e^{\b}}{e^{\c}})}
\text{calcul4=\(\left(e^{\a}\right)^{\b})}
\text{calcul5=\(\left(e^{\a}\right)^{\b}\times e^{\c})}
\text{calcul6=\(\sqrt{e^{\a}})}
\text{calcul7=\(e^{\a}\times \sqrt{e^{\b}})}

\integer{i=randint(1..7)}
\text{calcul=\calcul1,\calcul2,\calcul3,\calcul4,\calcul5,\calcul6,\calcul7}

\if{\i=1}{\real{rep1=\a+\b}}
\if{\i=2}{\real{rep1=\a-\b}}
\if{\i=3}{\real{rep1=\a+\b-\c}}
\if{\i=4}{\real{rep1=\a*\b}}
\if{\i=5}{\real{rep1=\a*\b+\c}}
\if{\i=6}{\real{rep1=\a/2}}
\if{\i=7}{\real{rep1=\a+\b/2}}



\statement{

<div id="enonce">
Ecrire sous la forme \(e^A) où \(A) est un réel.
<div class="reponse">
\calcul[\i]=\(e^A) avec \(A)=\embed{r1}.</div>
</div>
}

\answer{}{\rep1}{type=numeric}
