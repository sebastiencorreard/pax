}




}

\answer{a=}{\rep1}{type=numeric}{option=nonstop}
\answer{b=}{\rep2}{type=numeric}{option=nonstop}
\answer{}{\rep3;\(\rep1*x+\rep2),\(e^(\c*x)),\(\a*x+\b)}{type=clickfill}{option=nonstop}
\answer{}{\rep4;\(\rep1*x+\rep2),\(e^(\c*x))}{type=clickfill}{option=nonstop}
