\title{étude d'une fonction avec exponentielle}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{10000}

\real{a=randint(1..50)/10*random(-1,1)}
\real{k=randint(-50..50)/10}
\real{b=\k*\a}
\real{c=random(1,2,4,5,8,10,20,25,0.5,0.25,0.2,0.125,0.1,0.05,0.04)*random(-1,1)}
\real{a1=\c*\a}
\real{b1=\a+\c*\b}
\real{x0=-\b1/\a1}
\real{fx0=(\a*\x0+\b)*exp(\c*\x0)}

\while{\fx0>1000000 or \fx0<-1000000}{
\real{c=random(1,2,4,5,8,10,20,25,0.5,0.25,0.2,0.125,0.1,0.05,0.04)*random(-1,1)}
\real{a1=\c*\a}
\real{b1=\a+\c*\b}
\real{x0=-\b1/\a1}
\real{fx0=(\a*\x0+\b)*exp(\c*\x0)}
}


\real{fx0_arrondi=rint(\fx0*1000)/1000}

\text{urldd=draw(150,25
arrow 10,2.5,140,22.5,10,black)}
\text{dd=<img src="\urldd">}

\text{urlcc=draw(150,25
arrow 10,22.5,140,2.5,10,black)}
\text{cc=<img src="\urlcc">}

\text{urlplus=draw(150,25
line 67.5,12.5,82.5,12.5,10,black
line 75,5,75,20,10,black
)}
\text{plus=<img src="\urlplus">}

\text{urlmoins=draw(150,25
line 67.5,12.5,82.5,12.5,10,black
)}
\text{moins=<img src="\urlmoins">}


\text{rep1=\a1}
\text{rep2=\b1}
\text{rep3=\(\a1*x+\b1)}
\text{rep4=\(e^(\c*x))}
\text{rep5=\x0}
\text{rep7=1}
\if{\a1>0}{\text{rep6=\moins}\text{rep8=\plus}}{\text{rep6=\plus}\text{rep8=\moins}}
\if{\a1>0}{\text{rep9=\dd}\text{rep11=\cc}}{\text{rep9=\cc}\text{rep11=\dd}}
\text{rep10=\fx0}
\if{\a1>0}{\text{rep12=1}}{\text{rep12=2}}
\text{rep13=\fx0_arrondi}
\text{rep14=\x0}

\if{\b!=0}{\text{f=(\a*x+\b)*e^(\c*x)}}{\text{f=\a*x*e^(\c*x)}}

\steps{r1,r2
r3,r4,r5,r6,r7,r8,r9,r10,r11
r12,r13,r14
}

\statement{
<div id="enonce">
Soit \(f(x)=\f).

\if{\step=1}{
<div class="question">Calculer au brouillon \(f '(x)) et l'écrire sous la forme \((a*x+b)e^(\c*x)).</div>
<div class="reponse">
a=\embed{r1,10}<br>
b=\embed{r2,10}
</div>
}

\if{\step=2 and \sc_reply1=1 and \sc_reply2=1}{
<div class="oui">
Effectivement, \(f '(x)=(\rep1*x+\rep2)e^(\c x)).
</div>
<div class="question">
Donner le tableau de variation de \(f).<br>
</div>

<div class="reponse">
\(f '(x)) est du signe de \embed{r3,150x25} car \embed{r4} est strictement positif.
<br>
<table border="1">
<tr>
<td>\(x)</td><td>\(-\infty)</td><td></td><td>\embed{r5,10}</td><td></td><td>\(+\infty)</td>
</tr>

<tr>
<td>Signe de \(f '(x))</td><td></td><td>\embed{r6}</td><td>\embed{r7}</td><td>\embed{r8}</td><td></td>
</tr>

<tr>
<td>Variations de \(f)</td><td></td><td>\embed{r9}</td><td>\embed{r10,10}</td><td>\embed{r11}</td><td></td>
</tr>

</table>
<span class="consigne"> Précision attendue : \(10^(-3)).</span>
</div>
}

\if{\step=2 and (\sc_reply1!=1 or \sc_reply2!=1)}{
<div class="non">
Vous avez répondu \(f '(x)=)(\reply1 \(x+)\reply2)\(e^(\c*x)),
c'est faux. La bonne réponse est \(f '(x)=(\rep1*x+\rep2)e^(\c*x)).<br>
Poursuivez l'exercice avec la bonne réponse.
</div>

<div class="question">
Donner le tableau de variation de f.<br>
</div>

<div class="reponse">
\(f '(x)) est du signe de \embed{r3,150x25} car \embed{r4} est strictement positif.<br>

<table border="1">
<tr>
<td>\(x)</td><td>\(-\infty)</td><td></td><td>\embed{r5,10}</td><td></td><td>\(+\infty)</td>
</tr>

<tr>
<td>Signe de \(f '(x))</td><td></td><td>\embed{r6}</td><td>\embed{r7}</td><td>\embed{r8}</td><td></td>
</tr>

<tr>
<td>Variat>ions de \(f)</td><td></td><td>\embed{r9}</td><td>\embed{r10,10}</td><td>\embed{r11}</td><td></td>
</tr>

</table>
<span class="consigne"> Précision attendue : \(10^(-3)).</span>
</div>
}

\if{\step=3 and \sc_reply3=1 and \sc_reply4=1 and \sc_reply5=1 and \sc_reply6=1 and \sc_reply8=1 and \sc_reply9=1
 and \abs(\reply_10-\rep10)<=.001 and  \sc_reply11=1}
{
<div class="oui">
Effectivement, le tableau de variation de \(f) est :<br>
<table border="1">
<tr>
<td>\(x)</td><td>\(-\infty)</td><td></td><td>\rep5</td><td></td><td>\(+\infty)</td>
</tr>

<tr>
<td>Signe de \(f '(x))</td><td></td><td>\rep6</td><td>0</td><td>\rep8</td><td></td>
</tr>

<tr>
<td>Variations de \(f)</td><td></td><td>\rep9</td><td>\fx0_arrondi</td><td>\rep11</td><td></td>
</tr></table>
</div>

<div class="reponse">
D'après ce tableau, \(f) présente un \embed{r12} en \embed{r14,10}
qui vaut \embed{r13,150x20}.
</div>
}


\if{\step=3 and (\sc_reply3!=1 or \sc_reply4!=1 or \sc_reply5!=1 or \sc_reply6!=1 or \sc_reply8!=1 or \sc_reply9!=1
or \abs(\reply_10-\rep10)>.001 or \sc_reply11!=1)}
{
<div class="non">
Attention, vous avez fait au moins une erreur à la question précédente. Le tableau de variation de \(f) est :<br>
