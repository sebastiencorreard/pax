\title{Série d'équations avec exp}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}


\text{saut=<br>}
\integer{k=randint(-15..15)}
\integer{a=randint(-10..10)}\while{\a=0}{\integer{a=randint(-10..10)}}
\integer{b=randint(-10..10)}
\integer{u=randint(-10..10)}\while{\u=0}{\integer{u=randint(-10..10)}}
\integer{v=randint(-10..10)}
\integer{w=randint(-10..10)}

\text{rep1=\k>0?1:2}
\if{\rep1=1}{\real{rep2=rint(ln(\k)*1000)/1000}}
\rational{rep3=\b/\a}
\text{rep4=\rep3>0?1:2}
\if{\rep4=1}{\real{rep5=rint(ln(\rep3)*1000)/1000}}
\rational{rep6=(\w-\v)/\u}
\text{rep7=\rep6>0?1:2}
\if{\rep7=1}{\real{rep8=rint(ln(\rep6)*1000)/1000}}


\text{etape=r1}
\nextstep{\etape}
\text{cas=1}

\statement{
<div id="enonce">
\if{\cas>=1}{
	Cet exercice est composé de 3 équations à résoudre dans \(\mathbb R).\saut
	<div class="question">Equation 1 :  \(e^x=\k)</div>
	<div class="reponse">
	Cette équation a \embed{r1} solution.
	</div>
	\if{r2 isin \etape or \sc_reply2!=}{
		<div class="reponse">
		Une valeur approchée à \(10^(-3)) de la solution est \embed{r2}
		</div>
	}

}

\if{\cas>=2}{
	<div class="question">Equation 2 : \(\a*e^x=\b)</div>

	<div class="reponse">
	Cette équation est équivalente à \(e^x=)\embed{r3}
	</div>


	\if{(r4 isin \etape or \sc_reply4!=) and \sc_reply3=1}{
		<div class="reponse">
		Cette équation a \embed{r4} solution.
		</div>
	}
	\if{(r4 isin \etape or \sc_reply4!=) and \sc_reply3!=1}{
		<div class="non">Attention, l'équation est équivalente à \(e^x=\rep3)</div>
		<div class="reponse">
		Cette équation a \embed{r4} solution.
		</div>
	}
	\if{r5 isin \etape or \sc_reply5!=}{
		<div class="reponse">
		Une valeur approchée à \(10^(-3)) de la solution est \embed{r5}
		</div>
	}
}

\if{\cas>=3}{
	<div class="question">Equation 3 : \(\u*e^x+\v=\w)</div>

	<div class="reponse">
	Cette équation est équivalente à \(e^x=)\embed{r6}
	</div>
	\if{(r7 isin \etape or \sc_reply7!=) and \sc_reply6=1}{
		<div class="reponse">
		Cette équation a \embed{r7} solution.
		</div>
	}
	\if{(r7 isin \etape or \sc_reply7!=) and \sc_reply6!=1}{
		<div class="non">Attention, l'équation est équivalente à \(e^x=\rep6)</div>
		<div class="reponse">
		Cette équation a \embed{r7} solution.
		</div>
	}
	\if{r8 isin \etape or \sc_reply8!=}{
		<div class="reponse">
		Une valeur approchée à \(10^(-3)) de la solution est \embed{r8}
		</div>
	}

}
</div>
}

\answer{nbre de sol de equ1}{\rep1;1,0}{type=menu}{option=nonstop}
\answer{sol de equ1}{\rep2}{type=numeric}{option=nonstop}
\answer{equ2 équiv}{\rep3}{type=numeric}{option=nonstop}
\answer{}{\rep4;1,0}{type=menu}{option=nonstop}
\answer{}{\rep5}{type=numeric}{option=nonstop}
\answer{}{\rep6}{type=numeric}{option=nonstop}
\answer{}{\rep7;1,0}{type=menu}{option=nonstop}
\answer{}{\rep8}{type=numeric}

\if{\cas=1}{
	\if{\sc_reply1=1}{\if{\rep1=1}{\text{etape=r2}}{\text{etape=r3}\text{cas=2}}}
	\if{\sc_reply1!=1}{\text{etape=r3}\text{cas=2}}
}

\if{\sc_reply2!=}{\text{cas=2}\text{etape=r3}}

\if{\cas=2}{
	\if{\sc_reply3!=}{\text{etape=r4}}
}

\if{\cas=2 and \sc_reply4!=}{
	\if{\sc_reply4=1}{\if{\rep4=1}{\text{etape=r5}}{\text{etape=r6}\text{cas=3}}}
	\if{\sc_reply4!=1}{\text{etape=r6}\text{cas=3}}
}

\if{\sc_reply5!=}{\text{cas=3}\text{etape=r6}}

\if{\cas=3}{
	\if{\sc_reply6!=}{\text{etape=r7}}
}

\if{\cas=3 and \sc_reply7!=}{
	\if{\sc_reply7=1}{\if{\rep7=1}{\text{etape=r8}}{\text{etape=}}}
	\if{\sc_reply7!=1}{\text{etape=}}
}

\if{\sc_reply8!=}{\text{etape=}}
