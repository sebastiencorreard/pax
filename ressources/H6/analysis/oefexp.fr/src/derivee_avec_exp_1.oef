\title{Dérivée avec exponentielle (1)}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}

\real{k=randint(1..100)/10*random(-1,1)}
\real{a=randint(1..100)/10*random(-1,1)}
\real{b=randint(-100..100)/10}
\real{c=randint(-100..100)/10}
\real{d=randint(-100..100)/10}

\function{A1=\a*x}
\function{A2=\a*x+\b}
\function{B1=\c*x}
\function{B2=\c*x+\d}
\real{K=\k*\a}


\integer{j=randint(1..5)}

\text{f=\k*e^(\A1),\k*e^(\A2),\k*e^(\A1)+\B1,\k*e^(\A1)+\B2,\k*e^(\A2)+\B2}
\if{\j=1}{\function{df=\K*e^(\A1)}}
\if{\j=2}{\function{df=\K*e^(\A2)}}
\if{\j=3 or \j=4}{\function{df=\K*exp(\A1)+\c}}
\if{\j=5}{\function{df=\K*exp(\A2)+\c}}


\statement{
<div id="enonce">
Soit \(f) la fonction définie sur \(\mathbb{R}) par \(f(x)=\f[\j]).<br>
<div class="question">Calculer \(f'(x)).</div>
<div class="reponse">
\(f'(x))=\embed{r1}
</div>
</div>
}
\answer{}{\df}{type=algexp}
\hint{<div class="indication">
La dérivée de  \(k\times e^{u(x)}) (où \(k) est une constante) est \(k\times u'(x)\times e^{u(x)}).
\if{\j>=3}{<br>Et la dérivée d'une somme est la somme des dérivées.}
</div>}
