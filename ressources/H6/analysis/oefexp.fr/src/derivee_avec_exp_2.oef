\title{Dérivée avec exponentielle (2)}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}

\real{a=randint(1..50)/10*random(-1,1)}
\real{b=randint(-50..50)/10}
\real{c=randint(1..50)/10*random(-1,1)}

\function{A=\a*x+\b}
\real{a1=\c*\a}
\real{b1=\a+\c*\b}

\text{rep1=\a1}
\text{rep2=\b1}

\function{f=(\A)*e^(\c*x)}
\function{df=diff(\f,x)}
\statement{

<div id="enonce">
Soit \(f(x)=\f).<br>
<div class="question">Calculer au brouillon \(f '(x)) et l'écrire sous la forme \((a*x+b)*e^(\c*x)).</div>

<div class="reponse">
\(a)=\embed{r1,6}<br>
\(b)=\embed{r2,6}
</div>
</div>
}

\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}

\hint{<div id="indication">Remarquer que \(f(x)=u(x)\times v(x)).</div>}
