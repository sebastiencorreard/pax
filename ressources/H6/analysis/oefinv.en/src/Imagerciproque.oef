\integer{a=random(1,-1)}
\integer{b=random(1..15)*random(-1,1)}
\integer{B=\b*2}
\real{cent=-(\b)/(\a)}
\integer{c=random(1..50)*random(-1,1)}
\function{f=\a*x^2 + \B*x + \c}
\real{base=evalue(\f,x=\cent)}

\integer{zone=random(1,2,3)}
\integer{A1=item(\zone,random(\base-20..\base-9),
