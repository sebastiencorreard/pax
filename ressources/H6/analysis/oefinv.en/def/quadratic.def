!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
!endif
tmp=!trim Let,be the function defined by	  Verify that \(f\) is bijective, and compute the inverse function	
val7=!translate internal $	\
$ to ;; in $tmp
val8=You may type <span class="tt">sqrt(2)</span>	  for the square root of 2 for example.
!if $val6=fr 
tmp=!trim Soit,la fonction définie par	  Vérifiez que \(f\) est bijective et calculez la fonction réciproque	
val7=!translate internal $	\
$ to ;; in $tmp
val8=Vous pouvez taper <span class="tt">sqrt(2)</span> pour	  la racine carrée de 2 par exemple.
!endif
tmp0=!randitem 1,2,4,5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 7

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$[rint($val10*2)]
val12=$[-($val10)/($val9)]
val13=$[($val10)^2/($val9)]

!ifval $val9>0
tmp0=!randint $val13-10, $val13-3

val14=$[rint($(tmp0))]
!else
tmp1=!randint $val13+3, $val13+10

val14=$[rint($(tmp1))]
!endif
val15=!rawmath $val9*x^2 + $val11*x + $val14
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]

!ifval $val16=1
tmp0=!randint floor($val12)-4, floor($val12)-1

val17=$[rint($(tmp0))]
!else
tmp1=!randint ceil($val12)+1, ceil($val12)+4

val17=$[rint(	  $(tmp1))]
!endif

!ifval $val16=1
tmp0=!randint $val17-4, $val17-1

val11=$[rint($(tmp0))]
!else
tmp1=!randint $val17+1, $val17+4

val11=$[rint($(tmp1))]
!endif
val18=$[rint(min($val11,$val17))]
val19=$[rint(max($val17,$val11))]
evaltmp=$val15

evaltmp=!mathsubst x=($val18) in $evaltmp
tmp0=($evaltmp)
val17=$[$(tmp0)]
evaltmp=$val15

evaltmp=!mathsubst x=($val19) in $evaltmp
tmp0=($evaltmp)
val11=$[$(tmp0)]
val20=$[min($val17,$val11)]
val21=$[max($val17,$val11)]
val22=$[rint(($val10)^2-($val9)*($val14))]

!ifval $val17<$val11
val23=!rawmath (-$val10+sqrt($val9*x+$val22))/($val9)
!else
val23=!rawmath 	  (-$val10-sqrt($val9*x+$val22))/($val9)
!endif
replyname1=\(f^{-1}(x)\)
replygood1=$val23
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement}$(val7[1;1]) \(f: [$val18,$val19] \to [$val20,$val21]\) $(val7[1;2]) \begin{center}\(f(x) = $val15\).\end{center} $(val7[2;]) \(f^{-1}:[$val20,$val21] \to [$val18,$val19]\). <div class="wims_instruction"> $val8 </div> \end{statement} 


