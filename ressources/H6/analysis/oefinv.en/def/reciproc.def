!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
!endif
val7=You must reply with a precision of at least 4 significant digits.
tmp=!trim Let, be the function defined by	  Verify that \(f\) is bijective, therefore we have an inverse function
val8=!translate internal $	\
$ to ;; in $tmp
!if $val6=fr 
val7=Vous devez répondre avec une précision d'au moins 4 chiffres significatifs.
tmp=!trim Soit, la fonction définie par	  Vérifiez que \(f\) est bijective, elle a donc une fonction réciproque
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $val8	  Calculez la valeur,de la dérivée en
val8=!translate internal $	\
$ to ;; in $tmp
!endif
tmp0=!randint 1, 5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint abs($val9)+1, abs($val9)+3

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem sin,cos

val13=$(tmp0)
tmp0=!randitem +,-

val14=$(tmp0)
val15=!rawmath $val10*x $val14 $val13($val9*x+$val11) + $val12
tmp0=!randint -100, 100

val16=$[rint($(tmp0))]
tmp=!replace internal .. by , in $val15 - ($val16),x=-1000..1000 

!distribute items $tmp into tmp1,tmp2,tmp3
tmp2=!replace internal = by , in $tmp2
!distribute items $tmp2 into tmp4,tmp5
tmp0=!solve $tmp1 for $tmp4 = $tmp5 to $tmp3 
val17=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val15,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val18=!rawmath $(tmp0)
evaltmp=$val18

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val19=$[1/$(tmp0)]
replyname1=\(g'($val16)\)
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
