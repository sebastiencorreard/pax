val6=$(tmp0)
!if $val6=fr 
!endif
tmp=!trim Let,be the function defined by	  Verify that \(f\) is bijective, and compute the inverse function	
val7=!translate internal $	\
$ to ;; in $tmp
val8=You may type <span class="tt">sqrt(2)</span>	  for the square root of 2 for example.
!if $val6=fr 
tmp=!trim Soit,la fonction définie par	  Vérifiez que \(f\) est bijective et calculez la fonction réciproque	
val7=!translate internal $	\
$ to ;; in $tmp
val8=Vous pouvez taper <span class="tt">sqrt(2)</span> pour	  la racine carrée de 2 par exemple.
!endif
tmp0=!randitem 1,2,4,5

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 3, 15

val10=$[rint(-$(tmp0)*sign($val9))]
val11=$[rint($val9*2)]
val12=!rawmath $val9*x + $val10/x
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]

!ifval $val13=1
tmp0=!randitem -5,-4,-2,-1

val14=$[rint($(tmp0))]
!else
tmp1=!randitem 1,2,4,5

val14=$[rint($(tmp1))]
!endif

!ifval $val13=1
tmp0=!randitem -25,-20,-16,-10,-8

val15=$[rint($(tmp0))]
!else
tmp1=!randitem 8,10,16,20,25

val15=$[rint($(tmp1))]
!endif
val16=$[rint(min($val15,$val14))]
val17=$[rint(max($val14,$val15))]
evaltmp=$val12

evaltmp=!mathsubst x=($val16) in $evaltmp
tmp0=($evaltmp)
val14=$[$(tmp0)]
evaltmp=$val12

evaltmp=!mathsubst x=($val17) in $evaltmp
tmp0=($evaltmp)
val15=$[$(tmp0)]
val18=$[min($val14,$val15)]
val19=$[max($val14,$val15)]
val20=$[rint(-4*($val9)*($val10))]

!ifval $val16*($val9)>0
val21=!rawmath (x+sqrt(x^2+$val20))/($val11)
!else
val21=!rawmath 	  (x-sqrt(x^2+$val20))/($val11)
!endif
replyname1=\(f^{-1}(x)\)
replygood1=$val21
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1;1]) \(f: [$val16,$val17] \to [$val18,$val19]\) $(val7[1;2]) \begin{center}\(f(x) = $val12 \).\end{center} $(val7[2;]) \(f^{-1}:[$val18,$val19] \to [$val16,$val17]\). \end{statement} 


