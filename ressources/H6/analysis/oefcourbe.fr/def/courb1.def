!set title=Détermination d'une fonction 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=Chantal.Causse@noos.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=45
prevarcnt=44
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!replace internal A by 1,2 in $val2

val6=$(tmp0)
tmp0=!replace internal B by 3 in $val6

val6=$(tmp0)
tmp0=!replace internal C by 4,5,6 in $val6

val6=$(tmp0)
tmp0=!replace internal D by 8 in $val6

val6=$(tmp0)
tmp0=!replace internal E by 7,9 in $val6

val6=$(tmp0)

!ifval $val6 = 
tmp0=!randint 1, 9

val7=$[rint( $(tmp0))]
!else
tmp=!nonempty items $val6

tmp1=!randitem $tmp
val7=$[rint( $(tmp1))]
!endif

!ifval $val7 >=7 
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val8=$[rint( $(tmp0)*$(tmp1))]
!else
tmp2=!randint 1, 5

tmp3=!randitem -1,1

val8=$[rint($(tmp2)*$(tmp3))]
!endif
tmp0=!randint -5, 5

val9=$[rint($(tmp0))]
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!item $val7 of $val8*(x)^2 + $val9*x + $val10,	$val8*x^3 + $val9*(x)^2 + $val10*x,	$val9*x + $val10 + $val8/(x + 1),	$val9*x + $val10 + $val8*ln(x + 1),	$val8*ln(x) + $val9*x + $val10,	$val8*ln(2*x + 1) + $val9*x + $val10,	$val9*x + $val10 + $val8*sqrt(x + 1),	$val8*sqrt(x) + $val9*x + $val10,	$val8*sqrt(2*x + 1) + $val9*x + $val10

val11=!rawmath $(tmp0)
tmp0=!item $val7 of a*x^2 + b*x + c,	a*x^3 + b*x^2 + c*x,	a/(x + 1) + b*x + c,	a*ln(x + 1) + b*x + c,	a*ln(x) + b*x + c,	a*ln(2*x + 1) + b*x + c,	a*sqrt(x + 1) + b*x + c,	a*sqrt(x) + b*x + c,	a*sqrt(2*x + 1) + b*x + c

val12=$(tmp0)	
tmp0=!texmath $val12

val12=$(tmp0)
tmp0=!item $val7 of 0,1,0,0,1,0,0,4,4

val13=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randitem 1,2

tmp2=!randitem -2,-1,2

tmp3=!randitem -3,-2,1,2

tmp4=!randitem 1,2,3

tmp5=!randitem 2,3,4,8,9

tmp6=!randitem 1,2,3,4

tmp7=!randitem -1,3,6,4

tmp8=!randitem 0,1,7,5

tmp9=!randitem 0,2,3

tmp10=!item $val7 of $(tmp0)*$(tmp1),$(tmp2),$(tmp3),$(tmp4),$(tmp5),$(tmp6),$(tmp7),$(tmp8),$(tmp9)

val14=$[rint($(tmp10))]
tmp=!translate ;";': to $     $ in $val11,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val15=!rawmath $(tmp0)
tmp0=!mathsubst x=$val13 in $val11

val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=!rawmath $(tmp0)
tmp0=!mathsubst x=$val14 in $val11

val17=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=!rawmath $(tmp0)
tmp0=!replace internal log(4) by 2*log(2) in $val17

val17=!rawmath $(tmp0)
tmp0=!replace internal log(8) by 3*log(2) in $val17

val17=!rawmath $(tmp0)
tmp0=!replace internal log(9) by 2*log(3) in $val17

val17=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=!rawmath $(tmp0)
tmp0=!replace internal log by ln in $val17

val17=!rawmath $(tmp0)
tmp0=!texmath $val17

val18=$(tmp0)
val19=$[min(min($val13-2,$val14-1),-1)]
val20=$[max(max($val13+2,$val14+1),1)]
val21=$[min(min($val16-1,$val17-1),-1)]
val22=$[max(max($val16+1,$val17+1),1)]
tmp0=!mathsubst x=$val13 in $val15

val23=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=!rawmath $(tmp0)

!ifval $val16-$val23 <$val21+1 and $val16+$val23>$val22-1 
val21=$[ $val16-$val23 -1 ]
!else
val21=$[ $val21]
!endif

!ifval $val16+$val23 <$val21+1 and $val16-$val23>$val22-1 
val21=$[ $val16+$val23 -1 ]
!else
val21=$[ $val21]
!endif

!ifval $val22-$val21 > 40 
val21=$[ $val21-1]
!endif

!ifval $val16-$val23 >$val21 and $val16-$val23<$val22 
val24=$[ $val13-1 ]
!else
val24=$[ $val13+1]
!endif

!ifval $val16-$val23 >$val21 and $val16-$val23<$val22 
val25=$[ $val16-$val23 ]
!else
val25=$[ $val16+$val23]
!endif

!ifval abs($val23)>8 or (abs($val23)> 3 and $val22-$val21 >25) 
val26=	fcircle $val24,$val25,5, red	dsegment 0,$val25,$val24,$val25,red	text red , 0.1 , $val25, medium,$val25
!endif

!ifval floor($val17)<>$val17 or $val22 - $val21 > 25
val27=	text blue, 0.1,$val17,medium,$val17	dsegment 0,$val17,$val14,$val17,blue	
!endif

!ifval $val22 - $val21 >25 
val28=	dsegment 0,$val16,$val13,$val16,blue	text blue, 0.1,$val16,medium,$val16	
!endif
val29=$[rint(floor($val21))]
val30=$[rint(floor($val22)+1)]
val31=<p>La fonction \(f) représentée par la courbe bleue ci-dessous	est de la forme : \(f(x)) = \($val12).</p>	<p>Cette courbe passe par \(A) et \(B) et sa tangente en \(A) est tracée	en vert.</p>	<p>Déterminer graphiquement le coefficient directeur de	cette tangente, puis calculer \(a), \(b) et \(c).</p>	
val32=
val32=$val28	$val27	$val26
replytype1=numeric
replyname1=\(a)
replygood1=$[$val8]
replytype2=numeric
replyname2=\(b)
replygood2=$[$val9]
replytype3=numeric
replyname3=\(c)
replygood3=$[$val10]
replytype4=numeric
replyname4=coefficient directeur
replygood4=$[$val23]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val31	 
!read oef/draw.phtml 500,300 \
	  xrange $val19, $val20	  yrange $val21,$val22	  parallel $val19,$val29,$val19,$val30,1,0,$val20 - $val19 +1,grey	  parallel $val19,$val29,$val20,$val29,0,1,$val30 -$val29 +1,grey	  hline 0,0,black	  arrow 0,0,1,0,6,black	  arrow 0,0,0,1,6,black	  vline 0,0,black	  plot blue, $val11	  fcircle $val13,$val16,7, green	  fcircle $val14,$val17,7 , green	  plot green, $val16+(x-$val13)*$val23	  text black,$val13,$val16,medium,A	  text black,$val14,$val17,medium,B	$val32	 
$()	<ul class="wims_nopuce">	<li><label for="reply4">Coefficient directeur de la tangente :</label>  
!read oef/embed.phtml reply4,7 
$() </li>	<li><label for="reply1">
!insmath a
$() =</label>  
!read oef/embed.phtml reply1,7 
$() </li>	<li><label for="reply2">
!insmath b
$() =</label>  
!read oef/embed.phtml reply2,7 
$() </li>	<li><label for="reply3">
!insmath c
$() =</label>  
!read oef/embed.phtml reply3,7 
$() </li>	</ul>	
$()
!exit

:hint
$()<p>Le coefficient directeur d'une droite est égal à	
!insmath \frac{\Delta y}{\Delta x}
$().</p>	Exprimer les trois conditions sur la courbe en utilisant 
!insmath f
$() et 
!insmath f'
$().	<p>	Calculer 
!insmath f'(x)
$() pour pouvoir transformer ces conditions	en système de trois équations à trois inconnues.</p>	
$()
