\title{Choix d'une représentation graphique}
\language{fr}
\author{Régine,Mangeard}
\email{regine@mangeard.fr}
\format{html}

## couleur des grilles
\text{gridcolor=lightblue}
### cadre générique ###
\text{cadre=xrange -2,2
yrange -3.5,3.5
gridfill 0,0,5,5,\gridcolor
linewidth 3
vline 1,0,\gridcolor
vline 2,0,\gridcolor
vline -1,0,\gridcolor
vline -2,0,\gridcolor
hline 0,1,\gridcolor
hline 0,2,\gridcolor
hline 0,3,\gridcolor
hline 0,-1,\gridcolor
hline 0,-2,\gridcolor
hline 0,-3,\gridcolor
linewidth 1
vline 0,0,black
hline 0,0,black
arrow 0,0,1,0,10,magenta
arrow 0,0,0,1,10,magenta
text red,0.7,-0.1,medium,i
text red,-0.2,0.7,medium,j
text black,-0.2,-0.1,medium,O
}
## fin du cadre générique ##
## liste des fonctions##
\real{a=random(1,0.5,2)*randint(1,-1)}
\integer{b=randint(-2..2)}
\integer{d=randint(1..3)*randint(1,-1)}
\integer{c=2*randint(1,-1)}
\integer{n1=randint(1..3)*randint(1,-1)}
\integer{n2=randint(1..3)*randint(1,-1)}
\text{foncsList=\a*exp(\n1*x)+\b,\a*exp(-\n1*x)+\b,\a*exp(\n1*x^2)+\b,\d/(\c*exp(\n2*x)+\d),
(\a*exp(\n1*x)+\c*\a*exp(-\n1*x))/(\c*\d*exp(\n1*x)+\d*exp(-\n1*x))}
## choix aléatoire de 4 fonctions dans la liste ci-dessus ##
\text{permutfoncs=shuffle(5)}
\integer{f1=item(1,\permutfoncs)}
\integer{f2=item(2,\permutfoncs)}
\integer{f3=item(3,\permutfoncs)}
\integer{f4=item(4,\permutfoncs)}
\text{tf1=\foncsList[\f1]}
\text{tf1=maxima(expand(\tf1);)}
\text{tf1=texmath(\tf1)}
\text{tf2=\foncsList[\f2]}
\text{tf2=maxima(expand(\tf2);)}
\text{tf2=texmath(\tf2)}
\text{tf3=\foncsList[\f3]}
\text{tf3=maxima(expand(\tf3);)}
\text{tf3=texmath(\tf3)}
\text{tf4=\foncsList[\f4]}
\text{tf4=maxima(expand(\tf4);)}
\text{tf4=texmath(\tf4)}

%% on choisit d'afficher la première formule dans foncsList (après permutatation) ##
\integer{i=randint(1..4)}
\integer{ind=\permutfoncs[\i]}
\text{f=item(\ind,\foncsList)}
\text{f=maxima(\f;)}
\text{f=texmath(\f)}
%% la bonne réponse ##
\integer{brep=\i}
## codes des quatre graphes à afficher ##
\text{couleurs=shuffle(red,blue,orange,green)}
\text{graphList=}
\for{k=1 to 4}{
  \text{graph=\cadre
plot \couleurs[\k],\foncsList[\permutfoncs[\k]]}
\text{graphList=wims(append item draw(200,200
\graph) to \graphList)}
}
%% enoncé de l'exo
\text{name_prelim=Dans le plan muni d'un repère orthonormé
  \((O,\overrightarrow{i},\overrightarrow{j})\)}
\text{name_statement=on considère la fonction
  réelle \(f\) définie sur l'intervalle \( [-2,\ 2]\) par,
  Indiquez dans la liste ci-dessous le graphe de}
\text{name_graph=Le graphe, est le graphe de}
\statement{
  <p>
  \name_prelim, \name_statement[1] \(f(x)=\f\). \name_statement[2] \(f\).
  </p>
  <ul class="wims_nopuce inline">
  <li>\embed{reply 1,1,<img src="\graphList[1]" alt="1">}</li>
  <li>\embed{reply 1,2,<img src="\graphList[2]" alt="2">}</li>
  <li>\embed{reply 1,3,<img src="\graphList[3]" alt="3">}</li>
  <li>\embed{reply 1,4,<img src="\graphList[4]" alt="4">}</li>
  </ul>
}
%%% soumission de réponse
\reply{\rep}{\brep;1,2,3,4}{type=radio}
\feedback{1=1}{<ul>
<li>\name_graph[1] 1 \name_graph[2] \(x\mapsto\tf1\).</li>
<li>\name_graph[1] 2 \name_graph[2] \(x\mapsto\tf2\).</li>
<li>\name_graph[1] 3 \name_graph[2] \(x\mapsto\tf3\).</li>
<li>\name_graph[1] name_graph 4 \name_graph[2] \(x\mapsto\tf4\).</li>
</ul>
}
