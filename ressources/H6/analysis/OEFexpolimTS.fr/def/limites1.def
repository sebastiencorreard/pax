!ifval $val45 issametext $val6 and $val18=4 and $(tmp0)=-1
val54=$val7
!endif

!ifval $val45 issametext $val6 and $val18=3 
val54=$val53
!endif
tmp=!trim $val54,$val37	$val54,$val37	$val53,$val37	$val54,$val53
val55=!translate internal $	\
$ to ;; in $tmp
!if $val51=1 

!ifval $val18!=4
val56=$val37
!else
val56=$val53
!endif
!else
tmp=!translate internal $	$ to ; in $val55

