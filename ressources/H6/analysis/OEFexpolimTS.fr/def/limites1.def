tmp1=!randint 1, 5

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val13=$[rint($(tmp0))]
tmp0=!randitem -1,1

tmp1=!randint 1, 5

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -8, 8

val15=$[rint($(tmp0))]
tmp0=!randitem -,+

val16=$(tmp0)

!ifval ($val16 issametext +)
val17=$[rint(1)]
!else
val17=$[rint(-1)]
!endif
tmp0=!randint 1, 4

val18=$[rint($(tmp0))]
t_=!replace internal \( by ( in expand(($val12*x + $val13)*($val14*x+$val15))
tmp0=!exec maxima $t_

val19=!rawmath $(tmp0)
t_=!replace internal \( by ( in expand($val14*x + $val15)
tmp0=!exec maxima $t_

val20=!rawmath $(tmp0)
tmp0=!texmath $val19

val19=$(tmp0)
tmp0=!texmath $val20

val20=$(tmp0)
val21=e^{t}
val22=e^{u}
val23=e^{u(x)}
val24=!rawmath e^{$val19}
tmp0=!item $val18 of $val20 $val16 $val24,($val20)\times $val24, \frac{$val20}{$val24},\frac{$val24}{$val20}

val25=$(tmp0)
tmp0=!item $val18 of v $val16 $val22, v \times $val22, \frac{v}{$val22},\frac{$val22}{v}

val26=$(tmp0)
tmp0=!texmath $val25

val27=$(tmp0)
t_=!rawmath -$val13/$val12
val28=!exec pari print($t_)
val29=&#8734;
tmp0=!randitem -,+

val30=$(tmp0)

!ifval ($val30 issametext +)
val31=$[rint(1)]
!else
val31=$[rint(-1)]
!endif
val32=$val30$val29
val33=$val30\infty
val34=\,\RR
val35=$[rint($val12*$val14)]

!ifval ($val14*$val31)>0
val36=$val6,+\infty,1
!else
val36=$val7,-\infty,-1
!endif
tmp0=!item 1 of $val36

val37=$(tmp0)
tmp0=!item 2 of $val36

val38=$(tmp0)

!ifval $val35>0
val39=$val6,+\infty
!else
val39=$val7,-\infty
!endif
tmp0=!item 1 of $val39

val40=$(tmp0)
tmp0=!item 2 of $val39

val41=$(tmp0)

!ifval $val40 issametext $val7
val42=$val9,0^+,0
!else
val42=$val6,+\infty,1
!endif
tmp0=!item 1 of $val42

val43=$(tmp0)
tmp0=!item 2 of $val42

val44=$(tmp0)
val45=$val43
val46=$val44
val47=Oui car on n'a aucune forme indéterminée,	Non car on a une forme indéterminée de type 0 x $val29,	Non car on a une forme indéterminée de type 0 / 0,	Non car on a une forme indéterminée de type $val29 / $val29 ,	Non car on a une forme indéterminée de type -$val29 + (+$val29)	
val48=, 0 x $val29, 0 / 0, $val29 / $val29 , -$val29 + (+$val29)
tmp0=!item 3 of $val36

val49=$[rint($(tmp0))]
tmp0=!item 3 of $val42

val50=$[rint($(tmp0))]
val49=$[rint($val49*$val50)]
