val22=$(tmp0)
tmp0=!texmath $val22

val22=$(tmp0)
val23=$(val14[$val19])
t_=!replace internal \( by ( in expand($val23);
tmp0=!exec maxima $t_

val23=$(tmp0)
tmp0=!texmath $val23

val23=$(tmp0)
tmp0=!shuffle $val14

val14=$(tmp0)
val24=
!for val25 =1 to 4 
val26=$(val14[$val25])
t_=!replace internal \( by ( in $val26
tmp0=!exec maxima $t_

val26=$(tmp0)
tmp0=!texmath $val26

val26=\($(tmp0)\)
tmp0=!append item $val26 to $val24

val24=$(tmp0)
!next
tmp0=!shuffle red,blue,orange,green

val27=$(tmp0)
val28=160
val29=
!for val25 =1 to 4 
!readproc oef/draw.phtml $val28,$val28 \
    $val7	    plot $(val27[$val25]),$(val14[$val25])	     
tmp0=$ins_url
