tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
val14=$val8*exp($val12*x)+$val9,$val8*exp(-$val12*x)+$val9,$val8*exp($val12*x^2)+$val9,$val10/($val11*exp($val13*x)+$val10),	($val8*exp($val12*x)+$val11*$val8*exp(-$val12*x))/($val11*$val10*exp($val12*x)+$val10*exp(-$val12*x))
