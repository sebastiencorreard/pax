val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$[rint($(tmp0))]
tmp0=!item 2 of $val15

val17=$[rint($(tmp0))]
tmp0=!item 3 of $val15

val18=$[rint($(tmp0))]
tmp0=!item 4 of $val15

val19=$[rint($(tmp0))]
val20=$(val14[$val16])
t_=!replace internal \( by ( in expand($val20);
tmp0=!exec maxima $t_

val20=$(tmp0)
tmp0=!texmath $val20

val20=$(tmp0)
val21=$(val14[$val17])
t_=!replace internal \( by ( in expand($val21);
