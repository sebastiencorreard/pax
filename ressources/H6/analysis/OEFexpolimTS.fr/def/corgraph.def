val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 1,-1

val11=$[rint(2*$(tmp0))]
