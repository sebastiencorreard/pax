\language{fr}
\range{-5..5}
\author{Gérard, Lauton}
\computeanswer{yes}
\format{html}
\precision{10000}






\title{Somme }

\text{name_and=et}
\text{name_hint=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes
  sont atteintes.}

\text{name_enonce=Soient \(x\) et \(y\) deux réels vérifiant}

\text{name_graph=Les valeurs possibles de \(x\) et \(y\) sont figurées ci-dessous
  en <span style="color:red">rouge</span> pour \(x\) et
  <span style="color:green">en vert</span> pour \(y\).}

\text{name_question=Trouvez le meilleur encadrement de la somme de \(x\) et de \(y\)}
\text{name_feed1=La réponse n'a pas de sens car}
\text{name_feed2=Votre encadrement est juste, mais n'est pas le meilleur possible.}

\real{a=randint(1..8)*random(-1,1)}
\real{b=randint(\a+2..10)}
\real{c=randint(1..8)*random(-1,1)}
\while{\c=\a}{
  \real{c=randint(0..8)*random(-1,1)}
}
\real{d=randint(\c+2..10)}
\integer{res1=\a+\c}
\integer{res2=\b+\d}
\integer{res3=\res1} (pour le graphe)
\integer{res4=\res2}
\integer{r=pari(vecmin([\res3,0,\a,\c])-2)}
\integer{R=pari(vecmax([\res4,0,\b,\d])+2)}
\text{eq=-x+\res3,-x+\res4}

%% AXE GRADUÉ x'x avec demi-graduations %%
\text{taille=17}
\text{taille1=12}
\text{epsil=0.18}
\text{epsil2=0}
\text{epsil3=3}
\text{grad1=text blue,-10-0.25,-1.5,medium,-10}
\for{k= -9 to -1}{
  \text{grad1=\grad1
text blue,\k-0.25,-1.5,medium,\k}}

\text{grad2=text blue,0,-1.5,medium,0}
\for{k= 1 to 10}{
  \text{grad2=\grad2
text black,\k,-1.5,medium,\k}}

\text{Axe =
range -12,12,-8,8
linewidth 1
parallel -12,-1,-12,1,1,0,25,red
parallel -12,-0.5,-12,0.5,0.5,0,48,red
linewidth 3
arrow -12.0,0,12.0,0,20,blue
fcircle 0,0,\taille,blue
\grad1
\grad2
hline 0,0,black}

%% dessin des intervalles décrits par x et y %%

\real{xa=\a>0?\a:\a-0.25}
\real{xb=\b>0?\b:\b-0.25}
\real{xc=\c>0?\c:\c-0.25}
\real{xd=\d>0?\d:\d-0.25}

\text{dessin=
\Axe
fcircle 0,0,\taille1,blue
fcircle \a,\epsil2,\taille1,red
fcircle \b,\epsil2,\taille1,red
fcircle \c,-0.5,\taille1,green
fcircle \d,-0.5,\taille1,green
linewidth 4
segment \a,\epsil,\b,\epsil,red
segment \c,-0.5,\d,-0.5,green
text red,\xa,\epsil3,medium,\a
text red,\xb,\epsil3,medium,\b
text green,\xc,5,medium,\c
text green,\xd,5,medium,\d
}
%%# Visuel figurant le rectangle des paires (x,y) %%#

\integer{N=\R-\r+1}

\text{Encadrement=
   xrange \r,\R
   yrange \r,\R
   parallel \r,\r,\R,\r,0,1,\N, grey
   parallel \r,\r,\r,\R,1,0,\N, grey
   fpoly red,\a,\c,\b,\c,\b,\d,\a,\d
   arrow \r,0,\R,0,8,black
   arrow 0,\r,0,\R,8,black
   arrow 0,0,1,0,8, black
   arrow 0,0,0,1,8, black
   plot green, \eq[1]
   plot green, \eq[2]
   fcircle 0,0,10,black
   fcircle \res3,0,10,green
   fcircle \res4,0,10,green
   text black,-0.3,-0.5,times, O
   text black,\R-0.5,1,times, x
   text black,0.5,\R-0.25,times, y
   text black,\res3 -0.3,-0.5,times,\res3
   text black,\res4 -0.3,-0.5,times,\res4
}

\text{Explication=<p>Dans le plan muni d'un repère
  \(( O \overrightarrow{x}\textrm{,} O \overrightarrow{y} )\),
  l'ensemble des points de coordonnées \((x,y)\) vérifiant les inégalités
  \({\a < x < \b}\) et \({\c < y <\d}\)
  est le rectangle <span style="color:red";>rouge</span>
  situé dans la bande délimitée par les deux droites vertes
  d'équations \(x + y = \res1\) et \(x + y = \res2\).</p>
  <p>Ces droites sont parallèles à la droite d'équation \(x + y = 0\),
  seconde bissectrice de l'angle
  \(( O \overrightarrow{x}\textrm{,} O \overrightarrow{y} )\).
  Leurs ordonnées en \(0\) sont les bornes \(m\) et \(M\)
  qui encadrent la somme \(x+y\) pour tous les points \((x,y)\) du rectangle rouge.</em>
  </p>
}

\statement{
  \name_enonce:
  \({\a < x < \b}\) \name_and \({\c < y < \d}\).
  <p>\name_graph</p>
  <p class="wimscenter">\draw{900,100}{\dessin}</p>
  <label for="reply1">\name_question:</label>
  <div class="wimscenter">\embed{r1,3}
  <label for="reply2">\({< x + y <}\)</label> \embed{r2,3}.
  </div>}
\answer{}{\res1}{type=numexp}
\answer{}{\res2}{type=numexp}
\hint{\name_hint}
\solution{<p>En additionnant terme à terme les bornes de l'encadrement
\({\a < x < \b}\) de \(x\) et de celui \({\c < y < \d}\) de \(y\), on obtient :
</p>
<p class="wimscenter">\({\res1 < x + y < \res2}\).</p>
<p><em>On peut visualiser cet encadrement de la somme \(x + y\)
par la figure ci-dessous.</em>
\Explication</p>
<p class="wimscenter">\draw{400,400 }{\Encadrement}</p>
}
\feedback{\reply1>\reply2}{\name_feed1 \reply1 > \reply2.}
\feedback{\reply1<\res1 and \reply22\res2}{\name_feed1}

