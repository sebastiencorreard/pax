\title{Encadrement de nombres réels 1}

\text{name_and=et}
\text{name_hint=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes
  sont atteintes.}

\text{name_bestappr=Trouvez le meilleur encadrement de}

\text{name_of=de}
\text{name_carre=et de la racine carrée de}
\text{name_supinf=est supérieur à,est inférieur à,est supérieure à,est inférieure à}
\text{name_carre2=La racine carrée de}
\text{name_answer=La racine carrée de \(x^2\) est}

\text{name_enonce=Soient \(x\) et \(y\) deux réels vérifiant}

\real{a=randint(0..9)*random(-1,1)}
\real{b=randint(\a+1..10)}
\real{c=randint(0..9)*random(-1,1)}
\real{d=randint(\c+1..10)}
\real{ac=\a*\c}
\real{bd=\b*\d}
\real{ad=\a*\d}
\real{bc=\b*\c}
\real{res1=min(min(\ac,\bc),min(\ad,\bd))}
\real{res2=max(max(\ac,\bc),max(\ad,\bd))}
\real{res3= \a-\d}
\real{res4=\b-\c}
\real{res5=max(abs(\a),abs(\b))}
\real{res6=min(abs(\a),abs(\b))}
\real{res6=\a < 0 and \b>0 ? 0}
\real{d1= -(\d)}
\statement{\name_enonce \a &lt; \(x) &lt; \b \name_and \c &lt; \(y) &lt; \d.
\name_bestappr \(x - y\), \name_of \(x y) \name_carre \(x^2).
<ul class="wims_nopuce">
<li>
<label for="reply1">\(x - y\) \name_supinf[1]</label> \embed{r1}.
</li><li>
<label for="reply2">\(x - y\) \name_supinf[2]</label> \embed{r2}.
</li><li>
<label for="reply3">\(x y\) \name_supinf[1]</label> \embed{r3}.
</li><li>
<label for="reply4">\(x y\) \name_supinf[2]</label> \embed{r4}.
</li><li>
<label for="reply5">\name_carre2 \(x^2\) \name_supinf[3]</label> \embed{r5}.
</li><li>
<label for="reply6">\name_carre2 \(x^2\) \name_supinf[4]</label> \embed{r6}.
</li></ul>
}
\answer{\(x - y\) \name_supinf[1]}{\res3}{type=numeric}
\answer{\(x - y\) \name_supinf[2]}{\res4}{type=numeric}
\answer{\(x y\) \name_supinf[1]}{\res1}{type=numeric}
\answer{\(x y\) \name_supinf[2]}{\res2}{type=numeric}
\answer{\name_answer > }{\res6}{type=numeric}
\answer{\name_answer < }{\res5}{type=numeric}
\text{name_feedadd=La règle de compatibilité de l'addition avec les inéquations
  (structure d'ordre de \(\,\RR\)) est la suivante&nbsp;:}
\text{name_feedmult=La règle de compatibilité de la multiplication avec les inéquations
  (structure d'ordre de \(\,\RR\)) est la suivante&nbsp;:}
\feedback{\reply1<>\res3 and \reply2<>\res4}{
  \name_feedadd
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) et \(a\) sont des réels
  et si \(x < y\), alors \(x + a < y + a\).
  </p>
  Ainsi, pour minorer \(x - y\), il faut se ramener d'une manière ou d'une autre
  à cette règle en utilisant la règle
  <p class="wimscenter" style="color:green">si \(x < y\), alors \(-y < -x\).</p>
  Ainsi, \(\a < x\) donc \(\a - y < x - y \) ; \(y < \d\) donc \(-\d < -y\)
  donc \(\a - \d < \a - y\).
  Finalement, \( \res3 = \a - \d < \a - y < x - y \).</p>
}
\feedback{\reply1<>\res3 and \reply2=\res4}{
  \name_feedadd
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) et \(a\) sont des réels
  et si \(x < y\), alors \(x + a < y + a\).
  </p>
  Ainsi, pour minorer \(x - y\), il faut se ramener d'une manière ou d'une autre
  à cette règle en utilisant la règle
  <p class="wimscenter" style="color:green">si \(x < y\), alors \(-y < -x\).</p>
  <p>
  Ainsi, \(\a < x) donc \(\a - y < x - y\) ; \(y < \d\) donc \(-\d < -y\)
  et \(\a - \d < \a - y\).
  Finalement, \(\res3 < \a - y < x - y\).</p>
}
\feedback{\reply1=\res3 and \reply2<>\res4}{
  \name_feedadd
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) et \(a\) sont des réels
  et si \(x < y\), alors \(x + a < y + a\).
  </p>
  Ainsi, pour majorer \(x - y), il faut se ramener d'une manière ou d'une autre
  à cette règle en utilisant la règle
  <p class="wimscenter" style="color:green">
   si \(x < y\), alors \(-y < -x\).
  </p><p>
  Ainsi,\(x < \b) donc \(x - y < \b - y\) ; \(\c < y\) donc \(-y < -\c\) donc
  \(\b - y<\b - (\c)\).
  Finalement, \(x-y < \b-y < \res4\). </p>
}
\feedback{(\reply3<>\res1 or \reply4<>\res2 ) and 0<\c and \a>0 and \b>0}{
  \name_feedmult
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) sont des réels et si \(a\) est un réel strictement positif,
  si \(x < y\), alors \(x a < y a\).
  </p>
  Pour majorer et minorer \(x y\)&nbsp;:
  comme \(0 < \c < y < \d\) et \( \a < x < \b \), on a \( \a y < x y < \b y \).
  Comme \(0 < \a\) et \(\c < y\), \(\res1 < \a y < x y\) ;
  comme \(y < \d\), \(x y < \b y < \res2\).
}
\feedback{(\reply3<>\res1 or \reply4<>\res2 ) and 0<\c and \a<0 and \b>0}{
  \name_feedmult
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) sont des réels et si \(a\) est un réel strictement positif,
  si \(x < y\), alors \(x a < y a\).
  </p>
  Pour majorer et minorer \(x y\)&nbsp;:
  comme \(0 < \c < y < \d\) et \( \a < x < \b \), on a \( \a y < x y < \b y \).
  Comme \(0 > \a\) et \(y < \d \),\(\res1 < \a y < x y\) ;
  comme \(\b > 0\), \(\b y < \res2\), donc \(x y < \res2\).
}
\feedback{(\reply3<>\res1 or \reply4<>\res2 ) and 0<\c and \a<0 and \b<0}{
  \name_feedmult
  <p class="wimscenter" style="color:green">
  si \(x\), \(y\) sont des réels et si \(a\) est un réel strictement positif,
  si \(x < y\), alors \(x a < y a\).
  </p>
  Pour majorer et minorer \(x y\)&nbsp;:
  comme \(0 < \c < y < \d\) et \( \a < x < \b \), on a \( \a y < x y < \b y \).
  Comme \(0 > \a\) et \(y < \d \),\(\res1 < \a y < x y\) ;
  comme \(\b < 0\), \(\b y < \b \c\), donc \(x y < \res2\).
}

