\title{Encadrement d'un produit 2}
\text{name_and=et}
\text{name_hint=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes
  sont atteintes.}
\text{name_enonce=Soient \(x\) et \(y\) deux réels vérifiant}
\text{name_graph=Les valeurs possibles de \(x\) et \(y\) sont figurées ci-dessous
  en <span style="color:red">rouge</span> pour \(x\) et
  <span style="color:green">en vert</span> pour \(y\).}
\text{name_help=Lorsque \(x\) ou \(y\) ne sont pas de signe constant, c'est-à-dire encadrés par
  des nombres de signes différents,
  séparez votre encadrement de \(x\) (ou de \(y\)) en deux autres encadrements
  de façon à ne travailler que sur des inégalités entre nombres de même signe.}
\text{name_feed1=Votre encadrement n'a pas de sens puisqu'on a :}
\text{name_feed2=Faites attention aux signes.}
\text{name_feed3=Votre encadrement est juste mais n'est pas le meilleur possible.}
\integer{a = randint(1..8)}
\integer{b = randint(\a+2..10)}
\integer{absc = randint(1..8)}
\integer{absd = randint(\absc+2..10)}
\integer{s = -1}
\integer{sgn=randint(1..2)}
\integer{t = \sgn=1? -1:1}
\integer{c = \s * \absc}
\integer{d = \t * \absd}
\integer{e = min(\c,\d)}
\integer{f = max(\c,\d)}
\integer{c = \e}
\integer{d = \f}
\integer{absc = abs(\c)}
\integer{absd = abs(\d)}
\integer{oppc=-\c}
\integer{oppd=-\d}
\integer{ac=\a*\c}
\integer{ad=\a*\d}
\integer{bc=\b*\c}
\integer{bd=\b*\d}
\real{res1=min(min(\ac,\bc),min(\ad,\bd))}
\real{res2=max(max(\ac,\bc),max(\ad,\bd))}
\integer{r=pari(vecmin([0,\a,\b,\c,\d])-4)}
\integer{R=pari(vecmax([\a,\b,\c,\d,0])+4)}
\text{eq=\res1 / x,\res2 / x}
\real{ab=\a*\b}
\real{cd=\c*\d}
\real{oppa=-\a}
\real{oppb=-\b}
\real{oppc=-\c}
\real{oppd=-\d}
\real{oppac=-\ac}
%% 1 %%
\if{\a>=0 and \c>=0}{
  \text{SOL=Les deux réels \(x\) et \(y\) sont positifs et vérifient les double-inégalités \({\a < x < \b}\) et \({\c < y < \d}\). On les multiplie terme à terme et l'on obtient :
  \({\ac < x \times y < \bd}\).}}
%% 2 %%
\if{\b<=0 and \d<=0}{
  \text{SOL=Les réels \(x\) et \(y\) sont négatifs. Les deux réels positifs \(-x\) et \(-y\)
  vérifient les double-inégalités
  \({\oppb < -x < \oppa}\) et \({\oppd < -y < \oppc}\). On les multiplie
  terme à terme et l'on obtient : \({\bd < x \times y < \ac}\).
  }
}
%% 3 %%
\if{\a>=0 and \d<=0}{
  \text{SOL=Le réel \(x\) est positif et \(y\) est négatif. Les deux réels positifs \(x\) et \(-y\) vérifient les double-inégalités
  \({\a < x < \b}\) et \({\oppd < -y < \oppc}\). On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement de \(x\times y\) :
  \({\bc < x \times y < \ad}\).
  }
}
%% 4 %%
\if{\c>=0 and \b<=0}{
  \text{SOL=Le réel \(x\) est négatif et \(y\) est positif. Les deux réels positifs \(-x\) et \(y\) vérifient les double-inégalités
  \({\oppb < -x < \oppa}\) et \({\c < x < \d}\). On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement de \(x\times y\) :
  \({\ad < x \times y < \bc}\).
  }
}
%% 5 %%
\if{\a>=0 and \cd<0}{
  \text{SOL=Le réel \(x\) est positif mais le signe de \(y\) varie selon sa position entre les bornes \(\c\) et \(\d\).
  <p>Dans le cas où \({\c < y \leq 0}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités \({\a < x < \b}\) et \({0 \leq -y < \oppc}\).
  On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement partiel de \(x\times y\) :
   \({\bc < x \times y \leq 0}\).</p>
  <p>Dans le cas où \(0 \leq y < \d\), les réels positifs \(x\) et \(y\) vérifient les double-inégalités
  \({\a < x < \b}\) et \({0 \leq y < \d}\).
  On les multiplie terme à terme pour obtenir cet encadrement partiel de
  \(x \times y\) :
  \({0 \leq x \times y < \bd}\).</p>
  En joignant les deux cas, on obtient l'encadrement final \({\bc < x \times y < \bd}\).
  }
}
%% 6 %%
\if{\b<=0 and \cd<0}{
  \text{SOL=Le réel \(x\) est négatif mais le signe de \(y\) varie selon sa position entre les bornes \(\c\) et \(\d\).
  <p>Dans le cas où \({\c < y \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités
  \({\oppb < -x < \oppa}\) et \({0 \leq -y < \oppc}\).
  On les multiplie terme à terme pour obtenir cet encadrement partiel de \(x\times y\) :
  \({0 \leq x \times y \leq \ac}\).</p>
  <p>Dans le cas où \({0 \leq y < \d}\), les deux réels positifs \(-x\) et \(y\) vérifient les double-inégalités \({\oppb < -x < \oppa}\) et \({0 \leq y < \d}\).
  On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement partiel de \(x\times y\) : \({\ad \leq x \times y \leq 0}\).</p>
  En joignant les deux cas on obtient l'encadrement final \({\ad < x \times y < \ac}\).
  }
}
%% 7 %%
\if{\ab<0 and \c>=0}{
  \text{SOL=On a \({y > 0}\), mais le signe de \(x\) varie selon sa position entre les bornes \(\a\) et \(\b\).
  <p>Dans le cas où \({\a < x \leq 0}\), les réels positifs \(-x\) et \(y\) vérifient les double-inégalités
  \({0 \leq -x < \oppa}\) et \({\c < y < \d}\).
  On multiplie leur produit terme à terme par \(-1\), d'où l'encadrement \({\ad < x \times y \leq 0}\).</p>
  <p>Dans le cas où \({0 \leq x < \b}\), les réels positifs \(x\) et \(y\) vérifient les double-inégalités
  \({0 \leq x < \b}\) et \({\c < y < \d}\).
  On les multiplie terme à terme, d'où \({0 \leq x \times y < \bd}\).</p>
  En joignant les deux cas on obtient l'encadrement \({\ad < x \times y < \bd}\).
  }
}
%% 8 %%
\if{\ab<0 and \d<=0}{
  \text{SOL=On a \({y < 0}\), mais le signe de \(x\) varie selon sa position entre les bornes \(\a\) et \(\b\).
  <p>Dans le cas où \({\a < x \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités
  \({0 \leq -x < \oppa}\) et \({\oppd < -y < \oppc}\).
  On les multiplie terme à terme, d'où \({0 \leq x \times y < \ac}\).</p>
  <p>Dans le cas où \({\0 \leq x < \b}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités
  \({\0 \leq x < \b}\) et \({\oppd < -y < \oppc}\).
  On les multiplie terme à terme ces et on multiplie le tout par \(-1\), d'où
  \({\bc \leq x \times y \leq 0}\).</p>
  En joignant les deux cas on obtient l'encadrement \({\bc < x \times y < \ac}\).
  }
}
%% 9 %%
\if{\ab<0 and \cd<0}{
  \text{SOL=Le signe de \(x\) varie selon sa position entre les bornes \(\a\) et \(\b\) et celui de \(y\) entre les bornes \(\c\) et \(\d\).
  <p>Dans le cas où \({0 \leq x < \b}\) et \({0 \leq y < \d}\), les deux réels \(x\) et \(y\) sont positifs. On multiplie terme à terme ces double-inégalités, d'où \({0 \leq x \times y < \bd}\).</p>
  <p>Dans le cas où \({\a < x \leq 0}\) et \({\c < y \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités \({0 \leq -x < \oppa}\) et \({0 \leq -y < \oppc}\).
  On les multiplie terme à terme, d'où \({0 \leq x \times y < \ac}\).</p>
  <p>Dans le cas où \({\a < x \leq 0}\) et \({0 \leq y < \d}\), les réels positifs \(-x\) et \(y\) vérifient les double-inégalités \({0 \leq -x < \oppa}\) et \({0 \leq y \d}\).
  On les multiplie terme à terme et on multiplie le tout par \(-1\), d'où \({\ad < x \times y \leq 0}\).</p>
  <p>Dans le cas où \({0 \leq x < \b}\) et \({\c < y \leq 0}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités \({0 \leq x < \b}\) et \({0 \leq -y < \oppc}\).
  On les multiplie terme à terme et on multiplie le tout par \(-1\), d'où \({\bc < x \times y \leq 0}\).</p>
  En joignant les quatre cas on obtient l'encadrement \({P_1 < x \times y < P_2}\) avec pour bornes : \({P_1 = min(\ad, \bc) = \res1}\) et \({P_2 = max(\ac, \bd) = \res2}\).
  }
}
\text{Explication=<p>Dans le plan muni d'un repère
  \(( O \overrightarrow{x}\textrm{,} O \overrightarrow{y} )\),
  l'ensemble des points de coordonnées \((x,y)\) vérifiant les inégalités
  \({\a < x < \b}\) et \({\c < y <\d}\)
  est le rectangle <span style="color:red";>rouge</span> situé entre les deux courbes vertes
  (hyperboles) d'équations \(y = \frac{\res1}{x}\) et \(y = \frac{\res2}{x}\).</p>
  <p>Les coefficients \(\res1\) et \(\res2\) figurent les bornes
  qui encadrent le produit \(P = x\cdot y\) pour tout point \((x,y)\)
  du rectangle rouge.</em></p>
}
%% AXE GRADUÉ x'x avec demi-graduations %%
\text{taille=15}
\text{taille1=12}
\text{epsil=0.2}
\text{epsil2=0.2}
\text{epsil3=3.5}
\text{grad1=text blue,-10-0.25,-1.5,medium,-10}
\for{k= -9 to -1}{
  \text{grad1=\grad1
text blue,\k-0.25,-1.5,medium,\k}}
\text{grad2=text blue,0,-1.5,medium,0}
\for{k= 1 to 10}{
  \text{grad2=\grad2
text black,\k,-1.5,medium,\k}}
\text{Axe =
range -12,12,-8,8
linewidth 1
parallel -12,-1,-12,1,1,0,25,red
parallel -12,-0.5,-12,0.5,0.5,0,48,red
linewidth 3
arrow -12.0,0,12.0,0,20,blue
fcircle 0,0,\taille,blue
\grad1
\grad2
hline 0,0,black}
%% dessin des intervalles décrits par x et y %%
\real{xa=\a>0?\a:\a-0.25}
\real{xb=\b>0?\b:\b-0.25}
\real{xc=\c>0?\c:\c-0.25}
\real{xd=\d>0?\d:\d-0.25}
\text{dessin=
\Axe
fcircle 0,0,\taille1,blue
fcircle \a,\epsil2,\taille1,red
fcircle \b,\epsil2,\taille1,red
fcircle \c,-0.5,\taille1,green
fcircle \d,-0.5,\taille1,green
linewidth 4
segment \a,\epsil,\b,\epsil,red
segment \c,-0.5,\d,-0.5,green
text red,\xa,\epsil3,medium,\a
text red,\xb,\epsil3,medium,\b
text green,\xc,5,medium,\c
text green,\xd,5,medium,\d
}
%%# Visuel figurant le rectangle des paires (x,y) %%#
\integer{N=\R-\r+1}
\text{Encadrement=
   xrange \r,\R
   yrange \r,\R
   parallel \r,\r,\R,\r,0,1,\N, grey
   parallel \r,\r,\r,\R,1,0,\N, grey
   fpoly red,\a,\c,\b,\c,\b,\d,\a,\d
   arrow \r,0,\R,0,8,black
   arrow 0,\r,0,\R,8,black
   arrow 0,0,1,0,8, black
   arrow 0,0,0,1,8, black
   plot green, \eq[1]
   plot green, \eq[2]
   fcircle 0,0,10,black
   text black,-0.3,-0.5,times, O
   text black,\R-0.5,1,times, x
   text black,0.5,\R-0.25,times, y
   text red,\a-0.25,-0.5,times,\a
   text red,\b+0.25,-0.5,times,\b
   text green,-0.5,\c,times,\c
   text green,-0.5,\d,times,\d
}
\statement{
\name_enonce
  <div class="wimscenter">
\({\a < x < \b}\) et \({\c < y < \d}\).
</div>
<p>\name_graph</p><p class="wimscenter">\draw{900,100}{\dessin}</p>
<label for="reply1">Trouver le meilleur encadrement de \(x y):</label>
 <div class="wimscenter">
  \embed{r1, 3} <label for="reply2">\(\;\leq x y \;\leq\)</label> \embed{r2,3 }.
</div>
}
\answer{\(P_1\)}{\res1}{type=numexp}
\answer{\(P_2\)}{\res2}{type=numexp}
\solution{
<p><strong>Solution au cas par cas :</strong></p>
<p>\SOL</p>
<p><strong>Solution globale</strong> : on calcule les quatre produits deux à deux des bornes \(a=\a\),
\(b=\b\) qui encadrent le réel \(x\) et des bornes \(c=\c\) et \(d=\d\)
qui encadrent le réel \(y\) :</p>
<ul>
<li>\(P_{ac} = \a \times \c = \ac\).</li>
<li>\(P_{ad} = \a \times \d = \ad\).</li>
<li>\(P_{bc} = \b \times \c = \bc\).</li>
<li>\(P_{bd} = \b \times \d = \bd\).</li>
</ul>
<p>Le nombre \(\res1\) est le plus petit et \(\res2\) est le plus grand de ces 4 produits,
d'où l'encadrement :</p>
<p class="wimscenter">\(\res1 < x \times y < \res2\).</p>
<p><em>On peut visualiser cet encadrement du produit \(x \times y\) par la figure ci-dessous.</em>
\Explication</p>
<p class="wimscenter">\draw{400,400 }{\Encadrement}</p>
}
\hint{\name_hint}
\help{\name_help}
\feedback{\reply1>\reply2}{\name_feed1 \(\reply1 > \reply2\).}
\feedback{(\reply1<>\res1 and \reply1=\ac) or (\reply2<>\res2 and \reply2=\bd)}{
  \name_feed2
}
\feedback{\reply1<\res1 and \reply2>\res2}{\name_feed3}
