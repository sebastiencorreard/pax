!set title=Inéquations 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Huayi, Chen
language=fr

ansorder=r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=Donnez l'ensemble des solutions de l'inéquation
val9=Construire l'ensemble (de gauche à droite) en cliquant sur	  les éléments en dessous.
val7=Dressez un tableau de la valeur des expressions avec valeur absolue selon \(x\).
tmp0=!randint -5, 5

val10=$[rint($(tmp0))]
tmp0=!randint 2, 4

val11=$[rint($val10+$(tmp0))]
tmp=!nonempty items +,-

tmp0=!randitem $tmp
val12=$(tmp0)
tmp0=!randitem 1,2

val13=$(tmp0)
tmp0=!item $val13 of \leq,\geq

val14=$(tmp0)
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]

!ifval $val12 issametext + 
tmp0=!randint 1, 5

val15=$[rint( ($val11)-($val10)+$(tmp0))]
!endif

!ifval $val12 issametext - 
tmp0=!randint 1, 3

val15=$[rint( ($val11)-($val10)-$(tmp0))]
!endif
tmp=!translate ";': to $     $ in x-($val10)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$(tmp0)
tmp=!translate ";': to $     $ in x-($val11)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
val18=$val15
!if $val12 issametext + 
!if $val13=2 
val19=\(-\infty)
t_=!rawmath (($val10)+($val11)-($val15))/2
val20=!exec pari print($t_)
t_=!rawmath (($val10)+($val11)+($val15))/2
val21=!exec pari print($t_)
val22=\(+\infty)
!endif
!if $val13=1 
t_=!rawmath (($val10)+($val11)-($val15))/2
val19=!exec pari print($t_)
t_=!rawmath (($val10)+($val11)+($val15))/2
val20=!exec pari print($t_)
!endif
!endif
!if $val12 issametext - 
!if $val13=2 
t_=!rawmath (($val10)+($val11)+($val15))/2
val19=!exec pari print($t_)
val20=\(+\infty)
!endif
!if $val13=1 
val19=\(-\infty)
t_=!rawmath (($val10)+($val11)+($val15))/2
val20=!exec pari print($t_)
!endif
!endif

!ifval $val12 issametext + and $val13=2 
val23=	\(\rbrack),$val19,&#44;,$val20,\(\rbrack),\(\cup),	\(\lbrack),$val21,&#44;,$val22,\(\lbrack)| ,	\(\lbrack),$val21,&#44;,$val22,\(\lbrack), \(\cup),\(\rbrack),	$val19,&#44;,$val20,\(\rbrack)
!endif

!ifval $val12 issametext + and $val13=1 
val23=\(\lbrack),$val19,&#44;,	$val20,\(\rbrack)
!endif

!ifval $val12 issametext - and $val13=2 
val23= \(\lbrack),	$val19,&#44;,$val20,\(\lbrack)
!endif

!ifval $val12 issametext - and $val13=1 
val23=	 \(\rbrack),$val19,&#44;,$val20,\(\rbrack)
!endif
t_=!rawmath (($val10)+($val11)+($val15))/2
val24=!exec pari print($t_)
t_=!rawmath (($val10)+($val11)-($val15))/2
val25=!exec pari print($t_)
val26=$val24,$val25,0,1/2,1,3/2,2,5/2,3,7/2,4,9/2,5,-1/2,-1,-3/2,	-2,-5/2,-3,-7/2,-4,-9/2,-5,\(\lbrack),\(\rbrack),\(+\infty),\(-\infty),\(\cup)
replytype1=compose
replyname1=Solution
replygood1=$val23;$val26
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val7


!goto stat

!exit

