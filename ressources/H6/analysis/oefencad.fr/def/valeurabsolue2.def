!set title=Valeur absolue 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Michel, Gosse
email=michel.gosse@ac-poitiers.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=Déterminer les entiers \(a\) et \(r\) tels que	  l'intervalle, soit égal à l'ensemble des réels \(x\) qui vérifient l'équation 
val7=On rappelle que \(a\) est le milieu de l'intervalle,	  tandis que \(r\) en est le rayon.
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 10

val10=$[rint($(tmp0))]
val11=$[rint($val9+$val10)]
val12=$[rint($val9-$val10)]
replytype1=default
replyname1=Valeur de \(a\)
replygood1=$val9
replytype2=default
replyname2=Valeur de \(r\)
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val7


!goto stat

!exit

:question
$()$(val8[1]) [$val12,$val11] $(val8[2]) 
!insmath |x-a| \leq r
$().
$()
!exit

:hint
$()$val7
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11,12
embedcnt=0
