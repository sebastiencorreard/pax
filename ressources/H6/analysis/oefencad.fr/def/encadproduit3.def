val48=$val43	fcircle 0,0,$val36,blue	fcircle $val13,$val38,$val36,red	fcircle $val14,$val38,$val36,red	fcircle $val15,-0.5,$val36,green	fcircle $val16,-0.5,$val36,green	linewidth 4	segment $val13,$val37,$val14,$val37,red	segment $val15,-0.5,$val16,-0.5,green	text red,$val44,$val39,medium,$val13	text red,$val45,$val39,medium,$val14	text green,$val46,5,medium,$val15	text green,$val47,5,medium,$val16	
val49=$[rint($val24-$val23+1)]
val50=xrange $val23,$val24	   yrange $val23,$val24	   parallel $val23,$val23,$val24,$val23,0,1,$val49, grey	   parallel $val23,$val23,$val23,$val24,1,0,$val49, grey	   fpoly red,$val13,$val15,$val14,$val15,$val14,$val16,$val13,$val16	   arrow $val23,0,$val24,0,8,black	   arrow 0,$val23,0,$val24,8,black	   arrow 0,0,1,0,8, black	   arrow 0,0,0,1,8, black	   plot green, $(val25[1])	   plot green, $(val25[2])	   fcircle 0,0,10,black	   text black,-0.3,-0.5,times, O	   text black,$val24-0.5,1,times, x	   text black,0.5,$val24-0.25,times, y	   text red,$val13-0.25,-0.5,times,$val13	   text red,$val14+0.25,-0.5,times,$val14	   text green,-0.5,$val15,times,$val15	   text green,-0.5,$val16,times,$val16	
