!set title=Encadrement d'un produit 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=57
prevarcnt=56
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=Soient \(x\) et \(y\) deux réels vérifiant
val9=Les valeurs possibles de \(x\) et \(y\) sont figurées ci-dessous	  en <span style="color:red">rouge</span> pour \(x\) et	  <span style="color:green">en vert</span> pour \(y\).
val10=Votre encadrement n'a pas de sens puisqu'on a :
val11=Faites attention aux signes.
val12=Votre encadrement est juste mais n'est pas le meilleur possible.
tmp0=!randint 1, 8

tmp1=!randitem -1,-1,1

val13=$[$(tmp0)*$(tmp1)]
tmp0=!randint $val13+2, 10

val14=$[$(tmp0)]
tmp0=!randint 1, 8

tmp1=!randitem -1,-1,1

val15=$[$(tmp0)*$(tmp1)]
tmp0=!randint $val15+2, 10

val16=$[$(tmp0)]
val17=$[rint($val13*$val15)]
val18=$[rint($val13*$val16)]
val19=$[rint($val14*$val15)]
val20=$[rint($val14*$val16)]
val21=$[min(min($val17,$val19),min($val18,$val20))]
val22=$[max(max($val17,$val19),max($val18,$val20))]
t_=!replace internal \( by ( in vecmin([0,$val13,$val14,$val15,$val16])-4
tmp0=!exec pari $t_

val23=$[rint($(tmp0))]
t_=!replace internal \( by ( in vecmax([$val13,$val14,$val15,$val16,0])+4
tmp0=!exec pari $t_

val24=$[rint($(tmp0))]
val25=$val21 / x,$val22 / x
val26=$[$val13*$val14]
val27=$[$val15*$val16]
val28=$[-$val13]
val29=$[-$val14]
val30=$[-$val15]
val31=$[-$val16]
val32=$[-$val17]
!if $val13>=0 and $val15>=0 
val33=Les deux réels \(x\) et \(y\) sont positifs et vérifient les double-inégalités	  \({$val13 < x < $val14}\) et \({$val15 < y < $val16}\). On les multiplie terme à terme et	  l'on obtient :	  \({$val17 < x \times y < $val20}\).
!endif
!if $val14<=0 and $val16<=0 
val33=Les réels \(x\) et \(y\) sont négatifs. Les deux réels positifs \(-x\) et \(-y\)	  vérifient les double-inégalités	  \({$val29 < -x < $val28}\) et \({$val31 < -y < $val30}\). On les multiplie	  terme à terme et l'on obtient :	  \({$val20 < x \times y < $val17}\).	  
!endif
!if $val13>=0 and $val16<=0 
val33=Le réel \(x\) est positif	  et \(y\) est négatif.	  Les deux réels positifs \(x\) et \(-y\) vérifient les double-inégalités	  \({$val13 < x < $val14}\) et \({$val31 < -y < $val30}\). On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement de \(x\times y\) :	  \({$val19 < x \times y < $val18}\).	  
!endif
!if $val15>=0 and $val14<=0 
val33=Le réel \(x\) est négatif	  et \(y\) est positif.	  Les deux réels positifs \(-x\) et \(y\) vérifient les double-inégalités	  \({$val29 < -x < $val28}\) et \({$val15 < x < $val16}\). On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement de \(x\times y\) :	  \({$val18 < x \times y < $val19}\).	  
!endif
!if $val13>=0 and $val27<0 
val33=Le réel \(x\) est positif mais le signe de \(y\) varie selon sa position entre les bornes \($val15\) et \($val16\).	  <p>Dans le cas où \({$val15 < y \leq 0}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités	  \({$val13 < x < $val14}\) et \({0 \leq -y < $val30}\).	  On les multiplie terme à terme puis on multiplie l'encadrement de \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement partiel de \(x\times y\) :	   \({$val19 < x \times y \leq 0}\).</p>	  <p>Dans le cas où \(0 \leq y < $val16\), les réels positifs \(x\) et \(y\) vérifient les double-inégalités	  \({$val13 < x < $val14}\) et \({0 \leq y < $val16}\).	  On les multiplie terme à terme pour obtenir cet encadrement partiel de \(x\times y\) :	  \({0 \leq x \times y < $val20}\).</p>	  En joignant les deux cas, on obtient l'encadrement final \({$val19 < x \times y < $val20}\).	  
!endif
!if $val14<=0 and $val27<0 
val33=Le réel \(x\) est négatif mais le signe de \(y\) varie selon sa position entre les bornes \($val15\) et \($val16\).	  <p>Dans le cas où \({$val15 < y \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités	  \({$val29 < -x < $val28}\) et \({0 \leq -y < $val30}\).	  On les multiplie terme à terme pour obtenir cet encadrement partiel de \(x\times y\) :	  \({0 \leq x \times y \leq $val17}\).</p>	  <p>Dans le cas où \({0 \leq y < $val16}\), les deux réels positifs \(-x\) et \(y\) vérifient les double-inégalités \({$val29 < -x < $val28}\) et \({0 \leq y < $val16}\).	  On les multiplie terme à terme puis on multiplie l'encadrement de	  \(-(x\times y)\) par \(-1\) pour obtenir cet encadrement partiel de \(x\times y\) :	  \({$val18 \leq x \times y \leq 0}\).</p>	  En joignant les deux cas on obtient l'encadrement final \({$val18 < x \times y < $val17}\).	  
!endif
!if $val26<0 and $val15>=0 
val33=On a \({y > 0}\), mais le signe de \(x\) varie selon sa position entre les bornes \($val13\) et \($val14\).	  <p>Dans le cas où \({$val13 < x \leq 0}\), les réels positifs \(-x\) et \(y\) vérifient les double-inégalités	  \({0 \leq -x < $val28}\) et \({$val15 < y < $val16}\).	  On multiplie leur produit terme à terme par \(-1\), d'où l'encadrement \({$val18 < x \times y \leq 0}\).</p>	  <p>Dans le cas où \({0 \leq x < $val14}\), les réels positifs \(x\) et \(y\) vérifient les double-inégalités	  \({0 \leq x < $val14}\) et \({$val15 < y < $val16}\).	  On les multiplie terme à terme, d'où \({0 \leq x \times y < $val20}\).</p>	  En joignant les deux cas on obtient l'encadrement \({$val18 < x \times y < $val20}\).	  
!endif
!if $val26<0 and $val16<=0 
val33=On a \({y < 0}\), mais le signe de \(x\) varie selon sa position entre les bornes \($val13\) et \($val14\).	  <p>Dans le cas où \({$val13 < x \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités	  \({0 \leq -x < $val28}\) et \({$val31 < -y < $val30}\).	  On les multiplie terme à terme, d'où	  \({0 \leq x \times y < $val17}\).</p>	  <p>Dans le cas où \({\0 \leq x < $val14}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités	  \({\0 \leq x < $val14}\) et \({$val31 < -y < $val30}\).	  On les multiplie terme à terme ces et on multiplie le tout par \(-1\), d'où	  \({$val19 \leq x \times y \leq 0}\).</p>	  En joignant les deux cas on obtient l'encadrement \({$val19 < x \times y < $val17}\).	  
!endif
!if $val26<0 and $val27<0 
val33=Le signe de \(x\) varie selon sa position entre les bornes \($val13\) et \($val14\) et celui de \(y\) entre les bornes \($val15\) et \($val16\).	  <p>Dans le cas où \({0 \leq x < $val14}\) et \({0 \leq y < $val16}\), les deux réels \(x\) et \(y\) sont positifs. On multiplie terme à terme ces double-inégalités,	  d'où \({0 \leq x \times y < $val20}\).</p>	  <p>Dans le cas où \({$val13 < x \leq 0}\) et \({$val15 < y \leq 0}\), les réels positifs \(-x\) et \(-y\) vérifient les double-inégalités	  \({0 \leq -x < $val28}\) et \({0 \leq -y < $val30}\).	  On les multiplie terme à terme, d'où	  \({0 \leq x \times y < $val17}\).</p>	  <p>Dans le cas où \({$val13 < x \leq 0}\) et \({0 \leq y < $val16}\), les réels positifs \(-x\) et \(y\) vérifient les double-inégalités \({0 \leq -x < $val28}\) et \({0 \leq y < $val16}\).	  On les multiplie terme à terme et on multiplie le tout par \(-1\), d'où \({$val18 < x \times y \leq 0}\).</p>	  <p>Dans le cas où \({0 \leq x < $val14}\) et \({$val15 < y \leq 0}\), les réels positifs \(x\) et \(-y\) vérifient les double-inégalités \({0 \leq x < $val14}\) et \({0 \leq -y < $val30}\).	  On les multiplie terme à terme et on multiplie le tout par \(-1\), d'où	  \({$val19 < x \times y \leq 0}\).</p>	  En joignant les quatre cas on obtient l'encadrement \({P_1 < x \times y < P_2}\) avec pour bornes : \({P_1 = min($val18, $val19) = $val21}\) et \({P_2 = max($val17, $val20) = $val22}\).	  
!endif
val34=<p>Dans le plan muni d'un repère	  \(( O \overrightarrow{x}\textrm{,} O \overrightarrow{y} )\),	  l'ensemble des points de coordonnées \((x,y)\) vérifiant les inégalités	  \({$val13 < x < $val14}\) et \({$val15 < y <$val16}\)	  est le rectangle <span style="color:red";>rouge</span> situé entre les deux courbes vertes	  (hyperboles) d'équations \(y = \frac{$val21}{x}\) et \(y = \frac{$val22}{x}\).</p>	  <p>Les coefficients \($val21\) et \($val22\) figurent les bornes	  qui encadrent le produit \(P = x\cdot y\) pour tout point \((x,y)\)	  du rectangle rouge.</em></p>	
val35=15
