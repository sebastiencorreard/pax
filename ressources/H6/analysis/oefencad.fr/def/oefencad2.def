!set title=Encadrement de nombres réels 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou;Gérard,Lauton
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=100

ansorder=r,r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=Soient \(x\) et \(y\) deux réels vérifiant
val7=On demande ici le meilleur encadrement possible. Pensez à faire	  apparaître des carrés.
val9=Le meilleur encadrement de,est le suivant 
tmp0=!randint 0, 9

tmp1=!randitem -1,1

val10=$[$(tmp0)*$(tmp1)]
tmp0=!randint $val10+1, 10

val11=$[$(tmp0)]
tmp0=!randint 0, 9

tmp1=!randitem -1,1

val12=$[$(tmp0)*$(tmp1)]
tmp0=!randint $val12+1, 10

val13=$[$(tmp0)]
tmp0=!randint -9, 9

val14=$[rint($(tmp0))]
tmp0=!randitem 1,-1

tmp1=!randint 1, 9

val15=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -9, 9

val16=$[rint($(tmp0))]
val17=(x-($val14))^2+($val15)*(y-($val16))^2
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=!rawmath $(tmp0)
tmp0=!texmath $val18

val18=$(tmp0)
tmp0=!texmath $val17

val17=$(tmp0)
tmp0=!texmath x-($val14)

val19=$(tmp0)
tmp0=!texmath y-($val16)

val20=$(tmp0)
val21=$[$val11-($val14)]
val22=$[$val10-($val14)]
val23=$[max(($val21)^2,($val22)^2)]
val24=$[min(min(($val21)^2,($val22)^2),max(0,($val22)*($val21)))]
val25=$[$val13-($val16)]
val26=$[$val12-($val16)]
val27=$[max(($val25)^2,($val26)^2)]
val28=$[min(min(($val25)^2,($val26)^2),max(0,($val26)*($val25)))]
val29=$[$val15 * $val28]
val30=$[$val15 * $val27]
val31=$[min($val24+($val15)*($val28),$val24+($val15)*($val27))]
val32=$[max($val23+($val15)*($val28),$val23+($val15)*($val27))]
replytype1=default
replyname1=Minimum
replygood1=$val31
replytype2=default
replyname2=Maximum
replygood2=$val32
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val7

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8 
!insmath {$val10 < x < $val11}
$() $val6 
!insmath {$val12 < y < $val13}
$().	  <label for="reply1">$(val9[1]) 
!insmath $val18
$() $(val9[2]) :</label>	  <div class="wimscenter"> 
!read oef/embed.phtml reply 1,8 
$()	  <label for="reply2">
!insmath < $val18 < 
$()</label> 
!read oef/embed.phtml reply 2,8 
$().</div>	
$()
!exit

:hint
$()$val7
$()
!exit

:help
$()
$()
