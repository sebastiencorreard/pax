!set title=Valeur absolue 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Michel, Gosse
email=michel.gosse@ac-poitiers.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=L'ensemble des réels \(x\) qui vérifient l'équation, est égal à
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 10

val10=$[rint($(tmp0))]
t_=!replace internal \( by ( in x-$val9;
tmp0=!exec maxima $t_

val11=$(tmp0)
val12=$[rint($val9+$val10)]
val13=$[rint($val9-$val10)]
val14=$[rint($val10+$val9)]
val15=$[rint($val10-$val9)]
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
tmp0=!item $val16 of \le,=

val17=$(tmp0)
val18=[$val13,$val12]
val19={$val13,$val12}
tmp0=!item $val16 of $val18,$val19

val20=$(tmp0)
val21=[$val15,$val14]
val22={$val15,$val14}
choicename1=S=
choicegood1=$val20
choicebad1=$val18,$val19,$val21,$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1])	  <div class="wimscenter">
!insmath |$val11| $val17 $val10
$()</div>	  $(val8[2]):	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,17
embedcnt=0
