!endif
val56=$val51	fcircle 0,0,$val44,blue	fcircle $val14,$val46,$val44,red	fcircle $val15,$val46,$val44,red	fcircle $val21,-0.5,$val44,green	fcircle $val22,-0.5,$val44,green	linewidth 4	segment $val14,$val45,$val15,$val45,red	segment $val21,-0.5,$val22,-0.5,green	text red,$val52,$val47,medium,$val14	text red,$val53,$val47,medium,$val15	text green,$val54,5,medium,$val21	text green,$val55,5,medium,$val22	
val57=$[rint($val34-$val33+1)]
val58=xrange $val33,$val34	   yrange $val33,$val34	   parallel $val33,$val33,$val34,$val33,0,1,$val57, grey	   parallel $val33,$val33,$val33,$val34,1,0,$val57, grey	   fpoly red,$val14,$val21,$val15,$val21,$val15,$val22,$val14,$val22	   arrow $val33,0,$val34,0,8,black	   arrow 0,$val33,0,$val34,8,black	   arrow 0,0,1,0,8, black	   arrow 0,0,0,1,8, black	   plot green, $(val35[1])	   plot green, $(val35[2])	   fcircle 0,0,10,black	   text black,-0.3,-0.5,times, O	   text black,$val34-0.5,1,times, x	   text black,0.5,$val34-0.25,times, y	   text red,$val14-0.25,-0.5,times,$val14	   text red,$val15+0.25,-0.5,times,$val15	   text green,-0.5,$val21,times,$val21	   text green,-0.5,$val22,times,$val22	
