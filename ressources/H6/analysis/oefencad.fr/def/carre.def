!set title=Encadrement d'un carré 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Noémie,Cochi;Olivier,Dupuy
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=et
val7=Le type d'inégalités est imposé, on ne cherche pas à savoir si les bornes	  sont atteintes.
val8=Trouvez le meilleur encadrement de
val9=Soit \(x\) un réel vérifiant
val10=Votre encadrement n'a pas de sens car
val11=Votre encadrement n'est pas bon car \(0), par exemple, n'est	  pas compris entre
val12=Regardez la représentation graphique de la fonction carré.
tmp0=!randint 1, 9

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val13=$[$(tmp0)*$(tmp1)]
tmp0=!randint $val13+1, 10

val14=$[$(tmp0)]
val15=$[$val14*$val14]
val16=$[$val13*$val13]
val17=$[$val16]
val18=$[$val15]

!ifval $val13<0 and $val14>0 
val17=$[ 0]
!endif

!ifval $val13<0 and $val14>0 
val18=$[ max($val16,$val15)]
!endif

!ifval $val13<0 and $val14<=0 
val17=$[ $val15]
!endif

!ifval $val13<0 and $val14<=0 
val18=$[ $val16]
!endif
replytype1=numeric
replyname1=
replygood1=$[$val17]
replytype2=numeric
replyname2=
replygood2=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9 
!insmath  $val13 \; \leq \; x \ \leq \; $val14 
$().	  <label for="reply1">$val8 
!insmath x^2
$()</label>&nbsp;:	  <div class="wimscenter"> 
!read oef/embed.phtml r1,3 
$()	  <label for="reply2">
!insmath \; \leq \; x^2 \; \leq \; 
$() </label> 
!read oef/embed.phtml r2,3 
$().</div> 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($m_reply1>$m_reply2 )
 <div class='oef_feedbacks'>$val10 
!insmath $m_reply1 > $m_reply2
$().
$()</div>
!endif
!ifval ($m_reply1>0 or $m_reply2<0 ) and $val13<=0 and $val14>0
 <div class='oef_feedbacks'>	  Votre encadrement n'est pas bon car 
!insmath 0
$(), par exemple, n'est	  pas compris entre 
!insmath $m_reply1
$() $val6 
!insmath $m_reply2
$().	  $val12	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,9,10,12,13,14
embedcnt=2
