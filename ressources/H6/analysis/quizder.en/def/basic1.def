!set title=Basic derivatives 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr
language=en
title_fr=Dérivées de base 

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compute the derivative of
!if $val6=fr 
val7=Calculez la dérivée de la fonction \(f\) définie par
!endif
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
val14=!rawmath $val10*x+$val11
tmp0=!randitem sin,cos

val15=$(tmp0)
tmp0=!randitem 2,3

tmp1=!randitem 2,3

tmp=!nonempty items 	 $val10*x^$(tmp0) + $val11,	 $val10*x^$(tmp1) + $val11*x,	 $val8*$val15(x+$val10),	 $val8*$val15($val10*x),	 sqrt($val10*x+$val11),	 (x+$val10)^2,	 $val8*exp(x+$val10),	 $val8*exp($val10*x),	 $val8*log(x+$val10),	 $val8*log($val10*x)	

tmp2=!randitem $tmp
val16=!rawmath $(tmp2)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
val18=\(f'(x)\)
tmp0=!texmath $val16

val16=$(tmp0)
replytype1=formal
replyname1=\(f'(x)\)
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 \(f(x) = $val16\). \end{statement} 


!goto stat

!exit

:question
$()$val7 
!insmath f(x) = $val16
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 
!insmath f(x) = $val16
$(). $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,16
embedcnt=0
