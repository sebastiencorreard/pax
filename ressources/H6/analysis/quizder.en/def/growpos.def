!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=is increasing
val8=is decreasing
val9=is strictly increasing
val10=is strictly decreasing
val11=has positives or zero values
val12=has negative or zero values
val13=has strictly positive values
val14=has strictly negative values
val15=nothing can be said
val16=Let \(f\) be a continuous and differentiable function on an interval	  [a,b], with \(f'\) its derivative. Fill in
val17=If
val18=You must choose the most relevant reply.
val19=The good sentence
!if $val6=fr 
val7=est croissante
val8=est décroissante
val9=est strictement croissante
val10=est strictement décroissante
val11=a des valeurs positives ou nulles
val12=a des valeurs négatives ou nulles
val13=a des valeurs strictement positives
val14=a des valeurs strictement négatives
val15=on ne peut rien dire
val16=Soit \(f\) une fonction continue et dérivable	  sur un intervalle [a,b] et \(f'\) sa dérivée. Remplissez
val17=Si
val18=Il faut choisir la réponse la plus pertinente.
val19=La case à remplir
!endif
tmp0=!randitem $val11,$val13

tmp1=!randitem $val12,$val14

tmp2=!randitem $val7,$val9

tmp3=!randitem $val8,$val10

tmp=!translate internal $	$ to ; in 	 f,$val7,f',$val11,$val13,$val7,$val9,$val15	 f,$val8,f',$val12,$val14,$val8,$val10,$val15	 f,$val9,f',$val11,$val13,$val7,$val9,$val15	 f,$val10,f',$val12,$val14,$val8,$val10,$val15	 f,$val13,f',$val15,$val9,$val7,$val13,$val11	 f',$val11,f,$val7,$val9,$val11,$val13,$val15	 f',$val12,f,$val8,$val10,$val12,$val14,$val15	 f',$val13,f,$val9,$val7,$val11,$val13,$val15	 f',$val14,f,$val10,$val8,$val12,$val14,$val15	 f,$(tmp0),f',$val15,$val7,$val9,$val11,$val13	 f,$(tmp1),f',$val15,$val8,$val10,$val12,$val14	 f',$(tmp2),f,$val15,$val11,$val13,$val7,$val9	 f',$(tmp3),f,$val15,$val12,$val14,$val8,$val10	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp4=!translate internal $\
$ to ; in $tmp
val20=$(tmp4)
tmp0=!item 1 of $val20

val21=$(tmp0)
tmp0=!item 2 of $val20

val22=$(tmp0)
tmp0=!item 3 of $val20

val23=$(tmp0)
tmp0=!item 4 of $val20

val24=$(tmp0)
tmp0=!item 5 to -1 of $val20

val25=$(tmp0)
tmp0=!shuffle $val24,$val25

val26=$(tmp0)
tmp0=!replace internal , by \item \($val23\)&#36; &#36; in $val26

val26=\begin{radio}\item \($val23\)	  $(tmp0)\end{radio}	
choicename1=$val19
choicegood1=$val24
choicebad1=$val25
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val17 \($val21\) $val22, $val26 \emph{$val18} \end{statement} 


!goto stat

!exit

