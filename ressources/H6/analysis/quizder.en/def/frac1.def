!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compute the derivative of
!if $val6=fr 
val7=Calculez la dérivée de la fonction \(f\) définie par
!endif
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
val14=!rawmath $val10*x+$val11
tmp0=!randitem sin,cos

val15=$(tmp0)
tmp0=!randint 3, 8

tmp1=!randint 2, 6

tmp=!nonempty items 	 $val8/($val10*x+$val11),	 $val8/(x^$(tmp0)+$val10),	 ($val10*x+$val11)/x^$(tmp1)	

tmp2=!randitem $tmp
val16=!rawmath $(tmp2)
tmp=!translate ;";': to $     $ in $val16,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val17=!rawmath $(tmp0)
tmp0=!texmath $val16

val16=$(tmp0)
replytype1=formal
replyname1=\(f'(x)\)
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

