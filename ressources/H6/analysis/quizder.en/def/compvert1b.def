!set title=Virtual chain Ib
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO Gang
email=xiao@unice.fr
language=en
title_fr=Composition virtuelle Ib

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Let \(f\) be a differentiable function, with derivative \(f'\).	  Compute the derivative of
!if $val6=fr 
val7=Soit \(f\) une fonction dérivable, de dérivée \(f'\).	  Calculez la dérivée de la fonction \(g\) définie par
!endif
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 8

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
!readproc slib/data/randline src/simple1.data 
tmp0=$slib_out
val14=!rawmath $(tmp0)
t_=!replace internal \( by ( in subst($val10,c1,subst($val11,c2,subst($val12,c3,subst($val13,c4,$val14))))
tmp0=!exec maxima $t_

val14=!rawmath $(tmp0)
val15=f($val14)
tmp=!translate ;";': to $     $ in $val14,x

tmp=!lower $tmp
tmp0=!exec maxima diff($tmp);
val16=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val16)*fprime

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp0=!replace internal fprime by f'($val14) in $val17

val18=$(tmp0)
val19=\(g'(x)\)
tmp0=!texmath $val15

val15=$(tmp0)
replytype1=formal
replyname1=\(g'(x)\)
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 \(g(x) = $val15\). \end{statement} 


!goto stat

!exit

:question
$()$val7 
!insmath g(x) = $val15
$().	
$()
!exit

