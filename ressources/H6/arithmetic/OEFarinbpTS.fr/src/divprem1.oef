\title{Diviseurs premiers 1}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\text{data=3,1,3
4,2,2,2
5,1,5
6,2,2,3
7,1,7
8,3,2,2,2
9,2,3,3
10,2,2,5
11,1,11
12,3,2,2,3
14,2,2,7
15,2,3,5
25,2,5,5
}

 \text{cedata=randomrow(\data)}
 \integer{ndiv=\cedata[1]}
 \integer{ndp=\cedata[2]}
 \text{decomp=}
 \text{nl=}
 \for{j=1 to \ndp}
  {
   \text{decomp=\decomp p_\j^{\alpha_\j}}
   \integer{e=\cedata[2+\j]-1}
   \text{nl=wims(append item \e to \nl)}
  }
\text{ineg=\ndp=2?avec \(\alpha_1 \leq \alpha_2): avec \(\alpha_1 \leq \alpha_2 \leq \alpha_3)}
\text{ineg=\ndp=1? }

\text{mstep=wims(makelist r x for x= 1 to \ndp)}
\text{mstep=wims(nospace \mstep)}
\steps{r4
\mstep}

\statement{
\if{\step=1}
{
Quel est le nombre maximum de diviseurs premiers que peut posséder un
entier naturel \(n) si son nombre de diviseurs est \ndiv ?
<div class="wimscenter"> Nombre maximum de diviseurs premiers : \embed{reply4,4}</div>
}
{
On suppose que la décomposition en facteurs premiers du nombre \(n)
 est \(\decomp) \ineg et que son nombre de diviseurs est \ndiv.
<p>
Déterminer les valeurs des exposants de cette décomposition.
</p>
<ul>
\for{i=1 to \ndp}
 {
 <li> \alpha<sub>\i</sub> =\embed{reply\i,3}</li>
 }
</ul>
}
}
\answer{\(\alpha_1\)}{\nl[1]}{type=numeric}
\answer{\(\alpha_2\)}{\nl[2]}{type=numeric}
\answer{\(\alpha_3\)}{\nl[3]}{type=numeric}

\answer{nb de diviseurs premiers}{\ndp}{type=numeric}
\solution{Attention: si \(n = p_1^{\alpha_1}p_2^{\alpha_2}p_3^{\alpha_3}),
 son nombre de diviseurs est \((\alpha_1+1)(\alpha_2+1)(\alpha_3+1))!}
