\title{Diviseurs premiers 2}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\text{lstp=shuffle(2,3,5,7)}
\integer{nbd=random(1,2,2,2,3,3)}
\if{\nbd=1}
 {
 \text{tnbp=qu'un seul diviseur premier}
 \integer{n=randint(3..6)}
 \integer{possible=1}
 \integer{a=\lstp[1]^(\n-1)}
 \text{rep=\a}
 }
\if{\nbd=2}
 {
 \text{data=2,2
3,2
4,1,2,2
5,2
6,1,2,3
7,2
8,1,4,2
9,1,3,3
10,1,5,2
}
 \text{tnbp=que deux diviseurs premiers distincts}
 \text{cedata=randomrow(\data)}
 \integer{n=\cedata[1]}
 \integer{possible=\cedata[2]}
 \if{\possible=1}
  {
  \integer{n1=\cedata[3]-1}
  \integer{n2=\cedata[4]-1}
  \text{rep=\n1=\n2?\lstp[1]^\n1*\lstp[2]^\n2:\lstp[1]^\n1*\lstp[2]^\n2,\lstp[1]^\n2*\lstp[2]^\n1}
  }
 }
\if{\nbd=3}
 {
 \text{data=3,2
4,2
8,1,2,2,2
9,2
12,1,2,2,3
15,2
18,1,3,3,2
}
 \text{tnbp=que trois diviseurs premiers distincts}
 \text{cedata=randomrow(\data)}
 \integer{n=\cedata[1]}
 \integer{possible=\cedata[2]}
 \if{\possible=1}
  {
  \integer{n1=\cedata[3]-1}
  \integer{n2=\cedata[4]-1}
  \integer{n3=\cedata[5]-1}
  \text{rep=\n2=\n3?(\lstp[1]*\lstp[2]*\lstp[3])^\n3:(\lstp[1]*\lstp[2])^\n1*\lstp[3]^\n3,(\lstp[1]*\lstp[3])^\n1*\lstp[2]^\n3,(\lstp[3]*\lstp[2])^\n1*\lstp[1]^\n3}
  }
 }
\text{listp=item(1..\nbd,\lstp)}

\text{mstep=\possible=2?r1:r1
r2}
\steps{\mstep}

\statement{
<p>
Soit \(n\) un entier naturel ne possédant \tnbp.
</p>
\if{\step=1}
{
Est-il possible que son nombre de diviseurs soit \n&nbsp;?
<div class="wimscenter"> \embed{reply1} </div>
}
{
Sachant que le nombre \(n) ne possède \tnbp: \listp<br>
et que son nombre de diviseurs est \n,
quelles sont les valeurs possibles pour \(n)&nbsp;?
<div class="wimscenter"> \embed{reply2,20}</div>
<div class="wims_instruction">
S'il y a plusieurs valeurs possibles, les séparer par une virgule.
</div>
}
}
\answer{est-ce possible}{\possible;Oui,Non}{type=radio}
\answer{valeurs possibles pour n}{\rep}{type=fset}
