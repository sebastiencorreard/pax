!set title=Diviseurs premiers 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,5,7

val6=$(tmp0)
tmp0=!randitem 1,2,2,2,3,3

val7=$[rint($(tmp0))]
!if $val7=1 
val8=qu'un seul diviseur premier
tmp0=!randint 3, 6

val9=$[rint($(tmp0))]
val10=$[rint(1)]
val11=$[rint($(val6[1])^($val9-1))]
val12=$val11
!endif
!if $val7=2 
val13=2,2	3,2	4,1,2,2	5,2	6,1,2,3	7,2	8,1,4,2	9,1,3,3	10,1,5,2	
val8=que deux diviseurs premiers distincts
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val9=$[rint($(val14[1]))]
val10=$[rint($(val14[2]))]
!if $val10=1 
val15=$[rint($(val14[3])-1)]
val16=$[rint($(val14[4])-1)]

!ifval $val15=$val16
val12=$(val6[1])^$val15*$(val6[2])^$val16
!else
val12=$(val6[1])^$val15*$(val6[2])^$val16,$(val6[1])^$val16*$(val6[2])^$val15
!endif
!endif
!endif
!if $val7=3 
val13=3,2	4,2	8,1,2,2,2	9,2	12,1,2,2,3	15,2	18,1,3,3,2	
val8=que trois diviseurs premiers distincts
tmp=!translate internal $	$ to ; in $val13

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val9=$[rint($(val14[1]))]
val10=$[rint($(val14[2]))]
!if $val10=1 
val15=$[rint($(val14[3])-1)]
val16=$[rint($(val14[4])-1)]
val17=$[rint($(val14[5])-1)]

!ifval $val16=$val17
val12=($(val6[1])*$(val6[2])*$(val6[3]))^$val17
!else
val12=($(val6[1])*$(val6[2]))^$val15*$(val6[3])^$val17,($(val6[1])*$(val6[3]))^$val15*$(val6[2])^$val17,($(val6[3])*$(val6[2]))^$val15*$(val6[1])^$val17
!endif
!endif
!endif
tmp0=!item 1 to $val7 of $val6

val18=$(tmp0)

!ifval $val10=2
val19=r1
!else
val19=r1	r2
!endif
oefsteps=$val19 
nextstep=!nosubst $val19 
!readproc oef/steps.proc
replytype1=radio
replyname1=est-ce possible
replygood1=$val10;Oui,Non
replytype2=fset
replyname2=valeurs possibles pour n
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	Soit 
!insmath n
$() un entier naturel ne possédant $val8.	</p>	
!if $m_step=1 
$()	Est-il possible que son nombre de diviseurs soit $val9&nbsp;?	<div class="wimscenter">  
!read oef/embed.phtml reply1 
$() </div>	 
!else
$()	 	Sachant que le nombre 
!insmath n
$() ne possède $val8: $val18<br>	et que son nombre de diviseurs est $val9,	quelles sont les valeurs possibles pour 
!insmath n
$()&nbsp;?	<div class="wimscenter">  
!read oef/embed.phtml reply2,20 
$()</div>	<div class="wims_instruction">	S'il y a plusieurs valeurs possibles, les séparer par une virgule.	</div>	 
!endif
$()	
$()
!exit

