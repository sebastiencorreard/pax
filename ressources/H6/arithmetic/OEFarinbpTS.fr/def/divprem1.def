!set title=Diviseurs premiers 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=3,1,3	4,2,2,2	5,1,5	6,2,2,3	7,1,7	8,3,2,2,2	9,2,3,3	10,2,2,5	11,1,11	12,3,2,2,3	14,2,2,7	15,2,3,5	25,2,5,5	
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val8=$[rint($(val7[1]))]
val9=$[rint($(val7[2]))]
val10=
val11=
!for val12 =1 to $val9 
val10=$val10 p_$val12^{\alpha_$val12}
val13=$[rint($(val7[2+$val12])-1)]
tmp0=!append item $val13 to $val11

val11=$(tmp0)
!next

!ifval $val9=2
val14=avec \(\alpha_1 \leq \alpha_2)
!else
val14= avec \(\alpha_1 \leq \alpha_2 \leq \alpha_3)
!endif

!ifval $val9=1
val14= 
!endif
tmp0=!makelist r x for x= 1 to $val9

val15=$(tmp0)
tmp0=!nospace $val15

val15=$(tmp0)
oefsteps=r4	$val15 
nextstep=!nosubst r4	$val15 
!readproc oef/steps.proc
replytype1=numeric
replyname1=\(\alpha_1\)
replygood1=$[$(val11[1])]
replytype2=numeric
replyname2=\(\alpha_2\)
replygood2=$[$(val11[2])]
replytype3=numeric
replyname3=\(\alpha_3\)
replygood3=$[$(val11[3])]
replytype4=numeric
replyname4=nb de diviseurs premiers
replygood4=$[$val9]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $m_step=1 
$()	Quel est le nombre maximum de diviseurs premiers que peut posséder un	entier naturel 
!insmath n
$() si son nombre de diviseurs est $val8 ?	<div class="wimscenter"> Nombre maximum de diviseurs premiers :  
!read oef/embed.phtml reply4,4 
$()</div>	 
!else
$()	 	On suppose que la décomposition en facteurs premiers du nombre 
!insmath n
$()	 est 
!insmath $val10
$() $val14 et que son nombre de diviseurs est $val8.	<p>	Déterminer les valeurs des exposants de cette décomposition.	</p>	<ul>	 
!for m_i=1 to $val9 
$()	 <li> $m_alpha<sub>$m_i</sub> = 
!read oef/embed.phtml reply\i,3 
$()</li>	  
!next
$()	</ul>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Attention: si 
!insmath n = p_1^{\alpha_1}p_2^{\alpha_2}p_3^{\alpha_3}
$(),	 son nombre de diviseurs est 
!insmath (\alpha_1+1)(\alpha_2+1)(\alpha_3+1)
$()!
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,14
embedcnt=2
