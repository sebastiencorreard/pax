!set title=Division euclidienne 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 9, 15

val6=$[rint($(tmp0))]
tmp0=!randint 5, 12

val7=$[rint($(tmp0))]
tmp0=!randint 1, $val7-1

val8=$[rint($(tmp0))]
val9=$[rint($val6*$val7+$val8)]
tmp0=!randint 2, 4

val10=$[rint($(tmp0))]
val11=$[rint($val10*$val7+$val8)]
tmp0=!texmath $val7*B+$val11

val12=$(tmp0)
val13=$val10+B
val14=$[rint($val8)]
val15=-$val10-1-B
val16=$[rint($val7-$val8)]
tmp0=!randint 2, 4

val17=$[rint($(tmp0))]
tmp0=!randint 10, 19

val18=$[rint($(tmp0))]
val19=$[rint(floor(($val17*$val8+$val18)/$val7))]
val20=$[rint(($val17*$val8+$val18)-$val19*$val7)]
val21=$val17*$val10+$val19+$val17*B
replytype1=formal
replyname1=Quotient 1
replygood1=$val13
replytype2=numeric
replyname2=Reste 1
replygood2=$[$val14]
replytype3=formal
replyname3=Quotient 2
replygood3=$val15
replytype4=numeric
replyname4=Reste 2
replygood4=$[$val16]
replytype5=formal
replyname5=Quotient 3
replygood5=$val21
replytype6=numeric
replyname6=Reste 3
replygood6=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soient 
!insmath A
$() et 
!insmath B
$() deux entiers naturels vérifiant 
!insmath A=$val12
$().	Écrire la division euclidienne de:	</p><ol>	<li>
!insmath A
$() par $val7: 
!insmath A
$()=( 
!read oef/embed.phtml reply1,5 
$()) 
!insmath \times $val7 +
$()  
!read oef/embed.phtml reply2,3 
$()</li>	<li>
!insmath -A
$() par $val7: 
!insmath -A
$()=( 
!read oef/embed.phtml reply3,5 
$()) 
!insmath \times $val7 +
$()  
!read oef/embed.phtml reply4,3 
$()</li>	<li>
!insmath $val17 A + $val18
$() par $val7: 
!insmath $val17 A + $val18
$()=( 
!read oef/embed.phtml reply5,7 
$()) 
!insmath \times $val7 +
$()  
!read oef/embed.phtml reply6,3 
$()</li>	</ol>	
$()
!exit

