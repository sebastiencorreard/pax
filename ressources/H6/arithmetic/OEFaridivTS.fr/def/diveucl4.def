!set title=Division euclidienne 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,5,7,11,13

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
val9=$[rint($(val6[3]))]
val10=$[rint($val7*$val8*$val9)]
val11=$[rint($val7*$val8)]
val12=$[rint($val8*$val9)]

!ifval $val11<$val12
val13=$[rint($val12+1)]
!else
val13=$[rint($val11+1)]
!endif
tmp0=!randint $val13, $val10-1

val14=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($val14,$val7))
tmp0=!exec pari $t_

val15=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($val14,$val8))
tmp0=!exec pari $t_

val16=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($val14,$val9))
tmp0=!exec pari $t_

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($val14,$val11))
tmp0=!exec pari $t_

val18=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($val14,$val12))
tmp0=!exec pari $t_

val19=$[rint($(tmp0))]
replytype1=numeric
replyname1=Reste par $val7
replygood1=$[$val15]
replytype2=numeric
replyname2=Reste par $val8
replygood2=$[$val16]
replytype3=numeric
replyname3=Reste par $val9
replygood3=$[$val17]
replytype4=numeric
replyname4=Reste par $val11
replygood4=$[$val18]
replytype5=numeric
replyname5=Reste par $val12
replygood5=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Soit 
!insmath a
$() un entier naturel.	Le reste de la division euclidienne de 
!insmath a
$() par $val10 est $val14.	<p>	Quel est le reste de la division euclidienne de 
!insmath a
$()	</p>	<ol>	<li><label for="reply1">par $val7</label> :  
!read oef/embed.phtml reply1,5 
$()</li>	<li><label for="reply2">par $val8</label> :  
!read oef/embed.phtml reply2,5 
$()</li>	<li><label for="reply3">par $val9</label> :  
!read oef/embed.phtml reply3,5 
$()</li>	<li><label for="reply4">par $val11</label> :  
!read oef/embed.phtml reply4,5 
$()</li>	<li><label for="reply5">par $val12</label> :  
!read oef/embed.phtml reply5,5 
$()</li>	</ol>	
$()
!exit

