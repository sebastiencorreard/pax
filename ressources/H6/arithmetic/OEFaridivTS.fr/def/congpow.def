replycnt=8
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2,3,2	2,5,4	2,6,3	2,7,3	4,3,1	3,4,2,1	3,5,4	3,6,2	3,5,4	3,6,2	3,7,6	5,3,2,1	5,4,1	4,5,2,1	4,6,2	5,7,6	7,3,1	7,4,2,1	6,5,1	5,6,2,1	11,3,2,1	9,4,1	7,5,4	7,6,1	8,7,1	13,3,1	11,4,2,1	8,5,4	10,6,2	10,7,6	17,3,2,1	11,6,2,1	11,7,3	13,5,4	13,6,1	13,7,2,1	
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val7=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
val10=$[rint($(val9[1]))]
val11=$[rint($(val9[2]))]
tmp0=!itemcnt $val9

val12=$[rint($(tmp0))]
tmp0=!makelist r x for x=1 to $(val9[3])

val13=$(tmp0)
tmp0=!nospace $val13

val13=$(tmp0)
val14=
!for val15 =1 to $(val9[3]) 
t_=!replace internal \( by ( in lift(Mod($val10^$val15,$val11))
tmp0=!exec pari $t_

val16=$[rint($(tmp0))]
tmp0=!append item $val16 to $val14

val14=$(tmp0)
!next
tmp0=!randint 100, 200

val17=$[rint($(tmp0)*$(val9[3]))]
tmp0=!randint 1, $(val9[3])

val18=$[rint($(tmp0))]
val17=$[rint($val17+$val18)]
val16=$[rint($(val14[$val18]))]
val19=
!for val20 =1 to $(val9[3]) 
tmp0=!append item \($val10^$val20 \equiv $(val14[$val20]) ($val11)) to $val19

val19=$(tmp0)
!next
val21=Cela suffit pour mettre en évidence une période.
!if $(val9[3])=1 or ($(val9[3])=2 and $(val14[1])=$(val14[2])) 
val22=D'après le tableau précédent, pour tout \(n > 0), le reste vaut $val16.
!else

!ifval $val18=$(val9[3])
val18=$[rint(0)]
!endif
val22=On effectue la division euclidienne de $val17 par $(val9[3]),	    qui a pour reste $val18. Donc \($val10^{$val17} \equiv $val10^$val18 \equiv $val16 ($val11)\).
!endif
oefsteps=r8	$val13,r7 
nextstep=!nosubst r8	$val13,r7 
!readproc oef/steps.proc
replytype1=numeric
replyname1=Reste de \($val10^1) par $val11
replygood1=$[$(val14[1])]
replytype2=numeric
replyname2=Reste de \($val10^2) par $val11
replygood2=$[$(val14[2])]
replytype3=numeric
replyname3=Reste de \($val10^3) par $val11
replygood3=$[$(val14[3])]
replytype4=numeric
replyname4=Reste de \($val10^4) par $val11
replygood4=$[$(val14[4])]
replytype5=numeric
replyname5=Reste de \($val10^5) par $val11
replygood5=$[$(val14[5])]
replytype6=numeric
replyname6=Reste de \($val10^6) par $val11
replygood6=$[$(val14[6])]
replytype7=numeric
replyname7=Reste de \($val10^$val17) par $val11
replygood7=$[$val16]
replytype8=numeric
replyname8=Nombre de lignes
replygood8=?analyze 23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!if $m_step=1 
$()	Pour déterminer le reste de 
!insmath a^n
$() par 
!insmath b
$(), par disjonction des cas,	on construit un tableau de la forme:	<table class="wimscenter wimsborder"><tr><td>
!insmath n
$()</td><td> reste de la division de 
!insmath a^n
$() par 
!insmath b
$()</td></tr>	<tr><td>1</td><td> ? </td></tr>	<tr><td>2</td><td> ? </td></tr>	<tr><td> ...</td><td> ... </td></tr>	</table>	Combien de lignes faut-il remplir dans ce tableau si 
!insmath a=$val10
$() et 
!insmath b=$val11
$()?	<div class="wimscenter"><label for="reply8">Nombre de lignes nécessaires:</label>  
!read oef/embed.phtml reply8 
$()</div>	 
!else
$() 	Compléter le tableau suivant:	<table class="wimscenter wimsborder"><tr><td>
!insmath n
$()</td>	<td>reste de la division de 
!insmath $val10^n
$() par 
!insmath $val11
$()</td></tr>	 
!for m_k=1 to $(val9[3]) 
$()	 <tr><td>$m_k</td><td>  
!read oef/embed.phtml reply\k,3 
$() </td></tr>	 
!next
$()	</table>	Puis en déduire le <label for="reply7">reste de la division euclidienne de 
!insmath $val10^{$val17}
$() par $val11</label>:  
!read oef/embed.phtml reply7,3 
$()	 
!endif
$()	
$()
!exit

