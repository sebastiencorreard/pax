!set title=Fraction entière
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

val6=$[rint($(tmp0))]
tmp0=!randint -5, 5

val7=$[rint($(tmp0))]
tmp0=!randint 4, 9

val8=$[rint($(tmp0))]
val9=$[rint($val6+$val7)]
val10=$[rint($val6*$val7+$val8)]
val11=$[rint($val6*$val8)]
t_=!replace internal \( by ( in n^3+$val9*n^2+$val10*n
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val12=$(tmp1)
val13=n+$val6
t_=!replace internal \( by ( in n^2+$val7*n+$val8
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val14=$(tmp1)
val15=$val12+$val11
val16=$[rint($val11-$val6)]
val17=
val18=
!for val19 =0 to $val16 
val20=$[rint($val19+$val6)]
t_=!replace internal \( by ( in lift(Mod($val11,$val20))
tmp0=!exec pari $t_

val21=$[rint($(tmp0))]
tmp0=!append item $val21 to $val17

val17=$(tmp0)
!if $val21=0 
tmp0=!append item $val19 to $val18

val18=$(tmp0)
!endif
!next
replytype1=formal
replyname1=Développement
replygood1=$val15
replytype2=fset
replyname2=Valeurs de n
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Soit 
!insmath n
$() un entier naturel.	</p>	<ol>	<li>Développer <label for="reply1">
!insmath ($val13)($val14)
$()</label>= 
!read oef/embed.phtml reply1 
$().</li>	<li>En déduire les valeurs de 
!insmath n
$() pour lesquelles la fraction	
!insmath \frac{$val12}{$val13}
$() est un entier.	<div class="wimscenter"><label for="reply2">Valeurs de 
!insmath n
$():</label>  
!read oef/embed.phtml reply2 
$().	</div>	<div class="wims_instruction">	S'il y a plusieurs valeurs possibles, les séparer par une virgule.	</div></li></ol>	
$()
!exit

