!set title=Division euclidienne 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,5,7,11

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]

!ifval $val9=1
val10=$[rint(2)]
!else
val10=$[rint(1)]
!endif

!ifval $val7<$val8
val11=$[rint($val7)]
!else
val11=$[rint($val8)]
!endif
tmp0=!randint 1, $val11-1

val12=$[rint($(tmp0))]
val13=$[rint($val7^$val9*$val8^$val10+$val12)]
val14=$[rint($val7*$val8)]

!ifval $val9=1
val15=$[rint($val8^2)]
!else
val15=$[rint($val7^2)]
!endif

!ifval $val9=1
val16=$[rint($val7*$val8^2)]
!else
val16=$[rint($val7^2*$val8)]
!endif
val17=$val7,$val8,$val14,$val15,$val16
replytype1=fset
replyname1=Valeurs de b
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Dans la division euclidienne de 
!insmath a
$() par 
!insmath b
$(), (
!insmath b > 1
$()),	on note 
!insmath q
$() le quotient et 
!insmath r
$() le reste.	</p><p>	Si 
!insmath a=$val13
$() et 
!insmath r=$val12
$(), déterminer les valeurs possibles de 
!insmath b
$().	</p>	<div class="wimscenter"><label for="reply1">Valeurs possibles de 
!insmath b
$():</label> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=1
