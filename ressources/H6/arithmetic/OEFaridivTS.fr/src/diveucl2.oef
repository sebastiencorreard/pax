\title{Division euclidienne 2}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\text{lstp=shuffle(2,3,5,7,11)}
\integer{p1=\lstp[1]}
\integer{p2=\lstp[2]}
\integer{n1=randint(1,2)}
\integer{n2=\n1=1?2:1}
\integer{q=\p1<\p2?\p1:\p2}
\integer{r=randint(1..\q-1)}
\integer{a=\p1^\n1*\p2^\n2+\r}
\integer{p3=\p1*\p2}
\integer{p4=\n1=1?\p2^2:\p1^2}
\integer{p5=\n1=1?\p1*\p2^2:\p1^2*\p2}
\text{blist=\p1,\p2,\p3,\p4,\p5}

\statement{<p>
Dans la division euclidienne de \(a) par \(b), (\(b > 1)),
on note \(q) le quotient et \(r) le reste.
</p><p>
Si \(a=\a) et \(r=\r), déterminer les valeurs possibles de \(b).
</p>
<div class="wimscenter"><label for="reply1">Valeurs possibles de \(b):</label>\embed{reply1}</div>
}
\answer{Valeurs de b}{\blist}{type=fset}
