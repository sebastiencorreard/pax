\title{Congruences et puissances}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}


\text{data=2,3,2
2,5,4
2,6,3
2,7,3
4,3,1
3,4,2,1
3,5,4
3,6,2
3,5,4
3,6,2
3,7,6
5,3,2,1
5,4,1
4,5,2,1
4,6,2
5,7,6
7,3,1
7,4,2,1
6,5,1
5,6,2,1
11,3,2,1
9,4,1
7,5,4
7,6,1
8,7,1
13,3,1
11,4,2,1
8,5,4
10,6,2
10,7,6
17,3,2,1
11,6,2,1
11,7,3
13,5,4
13,6,1
13,7,2,1
}

\integer{ni=rows(\data)}
\integer{i=randint(1..\ni)}
integer{i=6}
\text{cedata=row(\i,\data)}
\integer{a=\cedata[1]}
\integer{b=\cedata[2]}
\integer{nj=items(\cedata)}

\text{stepl=wims(makelist r x for x=1 to \cedata[3])}
\text{stepl=wims(nospace \stepl)}
\steps{r8
\stepl,r7}
\text{rl=}

\for{j=1 to \cedata[3]}
  {
  \integer{r=pari(lift(Mod(\a^\j,\b)))}
  \text{rl=wims(append item \r to \rl)}
  }
\integer{n=randint(100..200)*\cedata[3]}
\integer{ir=randint(1..\cedata[3])}
\integer{n=\n+\ir}
\integer{r=\rl[\ir]}

\text{\textr=}
\for{l=1 to \cedata[3]}
  {
  \text{textr=wims(append item \(\a^\l \equiv \rl[\l] (\b)) to \textr)}
  }
\text{textper=Cela suffit pour mettre en évidence une période.}

\if{\cedata[3]=1 or (\cedata[3]=2 and \rl[1]=\rl[2])}
{  \text{feedreste=D'après le tableau précédent, pour tout \(n > 0), le reste vaut \r.}
}
{
   \integer{ir=\ir=\cedata[3]?0}
    \text{feedreste=On effectue la division euclidienne de \n par \cedata[3],
    qui a pour reste \ir. Donc \(\a^{\n} \equiv \a^\ir \equiv \r (\b)\).}
}
\text{}
\statement{
\if{\step=1}{
Pour déterminer le reste de \(a^n) par \(b), par disjonction des cas,
on construit un tableau de la forme:
<table class="wimscenter wimsborder"><tr><td>\(n\)</td><td> reste de la division de \(a^n\) par \(b)</td></tr>
<tr><td>1</td><td> ? </td></tr>
<tr><td>2</td><td> ? </td></tr>
<tr><td> ...</td><td> ... </td></tr>
</table>
Combien de lignes faut-il remplir dans ce tableau si \(a=\a) et \(b=\b)?
<div class="wimscenter"><label for="reply8">Nombre de lignes nécessaires:</label> \embed{reply8}</div>
}{
Compléter le tableau suivant:
<table class="wimscenter wimsborder"><tr><td>\(n\)</td>
<td>reste de la division de \(\a^n\) par \(\b)</td></tr>
\for{k=1 to \cedata[3]}{
 <tr><td>\k</td><td> \embed{reply\k,3} </td></tr>
}
</table>
Puis en déduire le <label for="reply7">reste de la division euclidienne de \(\a^{\n}) par \b</label>: \embed{reply7,3}
}
}
\answer{Reste de \(\a^1) par \b}{\rl[1]}{type=numeric}
\answer{Reste de \(\a^2) par \b}{\rl[2]}{type=numeric}
\answer{Reste de \(\a^3) par \b}{\rl[3]}{type=numeric}
\answer{Reste de \(\a^4) par \b}{\rl[4]}{type=numeric}
\answer{Reste de \(\a^5) par \b}{\rl[5]}{type=numeric}
\answer{Reste de \(\a^6) par \b}{\rl[6]}{type=numeric}

\answer{Reste de \(\a^\n) par \b}{\r}{type=numeric}
\answer{Nombre de lignes}{\nbl}{type=numeric}
\condition{Cohérence}{\reply8=\cedata[3] or (\nj=4 and \reply8=\cedata[4])}
\feedback{(\reply8<>\cedata[3] and \nj=3) or (\nj=4 and (\reply8<>\cedata[4] and \reply8<>\cedata[3]))}{
il faut remplir \cedata[3] ligne(s) du tableau, car:
<div class="wimscenter">\textr</div>
\textper
}
\feedback{\reply7<>\r}{
\feedreste}
