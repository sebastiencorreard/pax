\title{Division euclidienne 1}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\integer{q=randint(9..15)}
\integer{b=randint(5..12)}
\integer{r=randint(1..\b-1)}
\integer{a=\q*\b+\r}
\integer{d=randint(2..4)}
\integer{e=\d*\b+\r}
\text{rel=texmath(\b*B+\e)}
\text{q1=\d+B}
\integer{r1=\r}

\text{q2=-\d-1-B}
\integer{r2=\b-\r}

\integer{x=randint(2..4)}
\integer{y=randint(10..19)}

\integer{k=floor((\x*\r+\y)/\b)}
\integer{r3=(\x*\r+\y)-\k*\b}
\text{q3=\x*\d+\k+\x*B}

\statement{<p>
Soient \(A) et \(B) deux entiers naturels vérifiant \(A=\rel).
Écrire la division euclidienne de:
</p><ol>
<li>\(A) par \b: \(A)=(\embed{reply1,5}) \(\times \b +) \embed{reply2,3}</li>
<li>\(-A) par \b: \(-A)=(\embed{reply3,5}) \(\times \b +) \embed{reply4,3}</li>
<li>\(\x A + \y) par \b: \(\x A + \y)=(\embed{reply5,7}) \(\times \b +) \embed{reply6,3}</li>
</ol>
}
\answer{Quotient 1}{\q1}{type=formal}
\answer{Reste 1}{\r1}{type=numeric}
\answer{Quotient 2}{\q2}{type=formal}
\answer{Reste 2}{\r2}{type=numeric}
\answer{Quotient 3}{\q3}{type=formal}
\answer{Reste 3}{\r3}{type=numeric}
