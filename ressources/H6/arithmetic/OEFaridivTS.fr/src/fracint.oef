\title{Fraction entière}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\integer{a=randint(1..9)}
\integer{b=randint(-5..5)}
\integer{c=randint(4..9)}
\integer{d=\a+\b}
\integer{e=\a*\b+\c}
\integer{f=\a*\c}
\text{num=texmath(maxima(n^3+\d*n^2+\e*n))}
\text{den=n+\a}
\text{quot=texmath(maxima(n^2+\b*n+\c))}
\text{dev=\num+\f}
\integer{s1=\f-\a}
\text{rlist}
\text{sol=}
\for{n=0 to \s1}{
  \integer{m=\n+\a}
  \integer{r=pari(lift(Mod(\f,\m)))}
  \text{rlist=wims(append item \r to \rlist)}
  \if{\r=0}
  {
  \text{sol=wims(append item \n to \sol)}
  }
}
text{sol=\s1}
\statement{<p>
Soit \(n) un entier naturel.
</p>
<ol>
<li>Développer <label for="reply1">\((\den)(\quot))</label>=\embed{reply1}.</li>
<li>En déduire les valeurs de \(n) pour lesquelles la fraction
\(\frac{\num}{\den}) est un entier.
<div class="wimscenter"><label for="reply2">Valeurs de \(n\):</label> \embed{reply2}.
</div>
<div class="wims_instruction">
S'il y a plusieurs valeurs possibles, les séparer par une virgule.
</div></li></ol>
}
\answer{Développement}{\dev}{type=formal}
\answer{Valeurs de n}{\sol}{type=fset}
