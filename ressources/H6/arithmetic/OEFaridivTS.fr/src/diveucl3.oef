\title{Division euclidienne 3}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\integer{q=randint(3..9)}
\integer{k=randint(3..7)}
\integer{f=\q*\k}

\statement{<p>
Dans une division euclidienne, on a augmenté le dividende de \f et le diviseur de \k.
Le quotient et le reste sont inchangés.
</p><p>
Quel est le quotient&nbsp;?
</p>
<div class="wimscenter"><label for="reply1">Quotient =</label> \embed{reply1,5}</div>
}
\answer{Quotient}{\q}{type=numeric}
