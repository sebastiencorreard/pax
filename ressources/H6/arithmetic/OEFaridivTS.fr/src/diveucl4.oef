\title{Division euclidienne 4}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\text{lstp=shuffle(2,3,5,7,11,13)}
\integer{p1=\lstp[1]}
\integer{p2=\lstp[2]}
\integer{p3=\lstp[3]}

\integer{q=\p1*\p2*\p3}
\integer{q1=\p1*\p2}
\integer{q2=\p2*\p3}
\integer{rmin=\q1<\q2?\q2+1:\q1+1}
\integer{r=randint(\rmin..\q-1)}

\integer{r1=pari(lift(Mod(\r,\p1)))}
\integer{r2=pari(lift(Mod(\r,\p2)))}
\integer{r3=pari(lift(Mod(\r,\p3)))}
\integer{r4=pari(lift(Mod(\r,\q1)))}
\integer{r5=pari(lift(Mod(\r,\q2)))}

\statement{
Soit \(a) un entier naturel.
Le reste de la division euclidienne de \(a) par \q est \r.
<p>
Quel est le reste de la division euclidienne de \(a)
</p>
<ol>
<li><label for="reply1">par \p1</label> : \embed{reply1,5}</li>
<li><label for="reply2">par \p2</label> : \embed{reply2,5}</li>
<li><label for="reply3">par \p3</label> : \embed{reply3,5}</li>
<li><label for="reply4">par \q1</label> : \embed{reply4,5}</li>
<li><label for="reply5">par \q2</label> : \embed{reply5,5}</li>
</ol>
}

\answer{Reste par \p1}{\r1}{type=numeric}
\answer{Reste par \p2}{\r2}{type=numeric}
\answer{Reste par \p3}{\r3}{type=numeric}
\answer{Reste par \q1}{\r4}{type=numeric}
\answer{Reste par \q2}{\r5}{type=numeric}
