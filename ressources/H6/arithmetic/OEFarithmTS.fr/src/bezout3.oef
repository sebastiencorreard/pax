\integer{p1=\lstprime[1]}
\integer{p2=\lstprime[2]}
\integer{a=randint(1..10)*\p1}
\integer{b=randint(1..5)*\p1+randint(1..10)*\p2}
\integer{q4=randint(2..5)}
\integer{b4=randint(1..6)}
\integer{q3=\b4*\q4+1}
