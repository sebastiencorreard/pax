val18=$[rint(1+$val12*$val14)]
val19=$[rint($val18*$val16+$val12)]
val20=$[rint(1+$val16* $val17)]
val29=$[rint(-$val16)]
val30=$[rint($val20)]
val21=$[rint(-$val16*$val27)]
val22=$[rint($val20*$val27)]
val23=L'algorithme d'Euclide donne:<br>	<span class="red">$val9</span>	= \($val17 \times )<span class="red">$val10</span>+<span class="orange">	$val15</span><br>	\($val10= $val16 \times $val15+)<span class="green">$val13</span><br>	\($val15= $val14 \times $val13)<p>	  Donc PGCD($val9,$val10)=$val13.</p>

!ifval $val24=1
val23= $val23	  Or $val13 divise $val28.<br>	  On obtient les coefficients de Bezout en remontant l'algorithme.<p>	\($val13= )<span class="red">$val10</span>\( - $val16 \times )<span class="orange">$val15</span><br>	\($val13= )<span class="red">$val10</span>\( - $val16 \times )	( <span class="red">$val9</span>\( - $val17 \times) <span class="red">$val10</span>)<br>	\($val13= $val20 \times )<span class="red">$val10</span>\(- $val16 \times )<span class="red">$val9</span>	</p>	  donc	\($val28= $val21 \times) <span class="red">$val9</span>\( +$val22 \times) <span class="red">$val10</span>	
!else
val23= $val23	  Mais $val13 ne divise pas $val28, on ne peut donc pas trouver de couples (u,v) vérifiant l'équation. 
!endif
