!set title=Equation linéaire modulaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,5,7,11

val6=$[rint($(tmp0))]
tmp0=!randitem 2,3,5,7,11

val7=$[rint($(tmp0))]
val8=$[rint($val7*$val6)]
tmp0=!randint 2, 15

val9=$[rint($(tmp0))]
val10=$[rint(gcd($val9,$val8))]
val11=$[rint($val9/$val10)]
tmp0=!randint 2, 15

tmp1=!randint 2, 15

tmp2=!randint 2, 15

tmp3=!randitem $(tmp0), $(tmp1), $(tmp2)*$val10

val12=$[rint($(tmp3))]
val13=$[rint($val12%$val10)]

!ifval $val13=0
val14=$val10
!else
val14=0
!endif
val15=$[rint($val8/$val10)]
val16=$[rint($val12/$val10)]
val17=PGCD($val9,$val8)=$val10 divise $val12, on est ramené à résoudre \( $val11 x \equiv $val16\) mod $val15 dans $val10 ensembles de nombres distincts. Ce genre d'équations admet $val10 solutions distinctes.

!ifval $val10=1
val17= les nombres $val9 et $val8 sont premiers entre eux, ce genre d'équation admet une solution unique.
!endif

!ifval $val13>0 and $val10>1
val17= les nombres $val9 et $val8 ne sont pas premiers entre eux, et leur PGCD $val10 ne divise pas $val12.	Ce genre d'équation n'admet aucune solution.
!endif
replytype1=numeric
replyname1=Nombre de solutions
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val17


!goto stat

!exit

:question
$()Quel est le nombre de solutions dans 
!insmath \lbrace 1,2,\cdots,$val8\rbrace
$() de l'équation	<p class="wimscenter">
!insmath  $val9*x
$() $m_equiv $val12 mod $val8</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val17
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,12,17
embedcnt=0
