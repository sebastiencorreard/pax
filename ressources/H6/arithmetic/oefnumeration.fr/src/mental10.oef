\title{Calcul mental en base décimale}
\title_it{Calcolo mentale in base decimale}
\text{base=10}
\text{a=pari(random\(100000000) + 7000)}
\text{b=pari(random\(\a-6000))}
\text{ c = pari (\a-\b)}
\real{p = floor(log(\b)/log(\base))+1}
\text{differ = pari(10^(\p) - \b)}
\text{somme = pari(\a + \differ)}

\text{lang=slib(oef/env lang)}

\text{name_statement=Calculer rapidement \( \a - \b \) en utilisant la
