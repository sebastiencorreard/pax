\text{name_statement=Écrire la valeur de la succession de notes
  suivantes comme un nombre binaire fractionnaire}
\text{name_answer=Valeur du thème}
\text{name_condition=Votre réponse :}
\text{name_feedback=La valeur est}
\text{name_list_notes=noire,blanche,ronde,croche,double croche}
\text{name_help1=La notation musicale s'écrit naturellement
   dans le système binaire fractionnaire.}
\text{name_help2=Prenons une noire comme l'unité de base (1).
  La blanche vaut deux noires, la ronde vaut quatre noires,
  la croche vaut la moitié d'une noire, la double croche vaut le quart
  d'une noire.
  Seules interviennent dans les rapports précédents des puissances
  de 2. }
\text{name_help3=Pour écrire une valeur + la moitié de cette valeur,
  on fait suivre la valeur d'un point. Deux points
  signifient la valeur + sa moitié + son quart.}
\text{name_help4=On est donc dans un système binaire fractionnaire.}
\text{name_explanation=explication}



\if{\lang=it}{

\text{name_statement=Scrivere il valore della seguente successione di note
  come un numero binario decimale}
\text{name_answer=Valore del tema}
\text{name_condition=La tua risposta:}
\text{name_feedback=Il valore è}
\text{name_list_notes=semiminima,minima,semibreve,croma,semicroma}
\text{name_help1=La notazione musicale corrisponde naturalmente
   a un sistema binario decimale.}
\text{name_help2=Prendiamo una semiminima come unità di base (1).
    La minima vale due semiminime, la semibreve vale quattro semiminime,
  la croma vale la metà di una semiminima, la semicroma vale un quarto di
  una semiminima.
  Nei rapporti precedenti intervegono solo potenze di 2.}
\text{name_help3=Per scrivere un valore + la metà di questo valore,
  facciamo seguire il valore da un punto. Due punti
  significano il valore + la sua metà + il suo quarto.}
\text{name_help4=Siamo quindi in un sistema binario decimale.}
\text{name_explanation=spiegazione}



