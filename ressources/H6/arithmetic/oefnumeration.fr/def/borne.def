!set title=Plus grand/petit nombre dans une base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=bpr@math.u-psud.fr
author=Bernadette, Perrin-Riou
language=fr
title_it=Numero più grande/piccolo in una base

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 7

val6=$[rint($(tmp0))]
tmp0=!randint 3, 9

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1 
val9=$[rint( $val7^$val6 - 1)]
!else
val9=$[rint( $val7^($val6-1))]
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=grand,petit
tmp0=!item $val8 of $val11

val12=$(tmp0)
val13=Donner le plus $val12 nombre (écrit dans le système décimal) ayant $val6 chiffres dans le système à base $val7.
!if $val10=it 
val11=grande,piccolo
tmp0=!item $val8 of $val11

val12=$(tmp0)
val13=Trovare il più $val12 numero (scritto nel sistema di	  numerazione decimale) avente $val6 cifre nel sistema di numerazione in base $val7.
!endif
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst $val13


!goto stat

!exit

:question
$()$val13
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$val13
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13
embedcnt=0
