!insmath $val7 \times $val8 = $val14
$() $(val24[2]) 
!insmath b=$val9
$().
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!replace internal char number $val11 by $val26 in $val7

val28=$(tmp0)
tmp0=!replace internal char number $val16 by $val27 in $val14

val29=$(tmp0)
tmp0=!exec float_calc	obase=$val25; ibase=$val25; $val28*$val8 - $val29

val30=$(tmp0)
tmp0=!exec float_calc	obase=$val25; ibase=$val25; $val26 - $val25

val31=$(tmp0)
tmp0=!charcnt $val26

val32=$(tmp0)
tmp0=!exec float_calc	obase=$val25; ibase=$val25; $val27 - $val25

val33=$(tmp0)
tmp0=!charcnt $val27

val34=$(tmp0)

!exit

:feedback

!exit

:test

!ifval $val25>=2
 condtest1=1
!else
 condtest1=0
!endif
condname1=base > 1

!ifval base > 1 and $val31 <= 0 and $val32 =1
 condtest2=1
!else
 condtest2=0
!endif
condname2=$val26 $val22 $val25

!ifval base > 1 and $val33 <= 0 and $val34 =1
 condtest3=1
!else
 condtest3=0
!endif
condname3=$val27 $val22 $val25

!ifval base > 1 and $val30 = 0
 condtest4=1
!else
 condtest4=0
!endif
condname4=$val28 \(\times\) $val8 = $val29 $val23 $val25 ? 

