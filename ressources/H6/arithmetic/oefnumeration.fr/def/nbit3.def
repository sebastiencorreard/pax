!set title=Nombre de chiffres et base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=bpr@math.u-psud.fr
author=Bernadette, Perrin-Riou
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000
title_it=Numero di cifre e base

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

t_=!replace internal \( by ( in random\(100000000)
tmp0=!exec pari $t_

val6=$(tmp0)
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]
tmp0=!randint 7, 20

val8=$[rint($(tmp0))]
val9=$[floor(log($val6)/log($val7))+1]
val10=$[floor(log($val6)/log($val8))+1]
t_=!replace internal \( by ( in ceil($val7^($val9/$val10))
tmp0=!exec pari $t_

val11=$[rint($(tmp0))]
!readproc slib/oef/env lang 
tmp0=$slib_out
val12=$(tmp0)
val13=Un entier \(n\) a $val9 chiffres en base $val7 .	    Donner la plus petite base \(b\) dans laquelle il a sûrement	    moins de $val10 chiffres.
val14=base
!if $val12=it 
val13=Un intero \(n\) ha $val9 cifre in base $val7 .	    Dire qual è la più piccola base \(b\) nella quale tale numero ha sicuramente	    meno di $val10 ciffre.
val14=base
!endif
replyname1=$val14 \(b\)
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val13
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13
embedcnt=0
