val12=$(tmp0)
tmp0=!exec float_calc	obase=10; ibase=$val7;$val12

val13=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val14=$(tmp0)
val15=En quelle base la multiplication suivante est-elle valable ?
val16=Il y a une autre solution \(b = $val7\) .
val17=En base, on a,La réponse est
val18=En base \(b\), tous les chiffres des nombres doivent	  être strictement inférieurs à \(b\). Ce n'est pas le cas ici avec
val19=Base
!if $val14=it 
val15=In quale base la moltiplicazione seguente ha senso?
val16=C'è un'altra soluzione \(b = $val7\) .
val17=In base, si ha,La risposta è
val18=In base \(b\), tutte le cifre devono essere	  strettamente inferiori a \(b\). Questo non succederebbe qui se fosse
val19=Base
!endif
