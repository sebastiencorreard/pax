!set title=Division dans une base
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=bpr@math.u-psud.fr
author=Bernadette, Perrin-Riou
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000
title_it=Divisione in base b

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint  5, 14

val6=$(tmp0)
tmp0=!randint 5, 16

val7=$(tmp0)
tmp0=!randint 6, 20

val8=$(tmp0)
tmp0=!randint 0, $val8-1

val9=$(tmp0)
val10=$val8*$val7 + $val9
tmp0=!exec float_calc	obase=$val6; ibase=10;$val8

val8=$(tmp0)
tmp0=!exec float_calc	obase=$val6; ibase=10;$val9

val9=$(tmp0)
tmp0=!exec float_calc	obase=$val6; ibase=10;$val7

val7=$(tmp0)
tmp0=!exec float_calc	obase=$val6; ibase=10;$val10

val10=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val11=$(tmp0)
val12=Effectuer la division euclidienne de,dans le système de numération de base $val6.
val13=par
val14=Quotient
val15=Reste
!if $val11=it 
val12=Effettuare la divisione euclidea di,nel sistema di numerazione in base $val6.
val13=per
val14=Quoziente
val15=Resto
!endif
replytype1=nocase
replyname1=$val14
replygood1=$val7
replytype2=nocase
replyname2=$val15
replygood2=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val12[1])	
!insmath \overline {$val10}
$() $val13 
!insmath \overline{$val8}
$()	 $(val12[2])	<div class="wimscenter"> 
!insmath \overline {$val10}
$() =  
!read oef/embed.phtml reply1,7 
$() $m_times 
!insmath \overline {$val8}
$() +  
!read oef/embed.phtml reply2,7 
$()</div>	
$()
!exit

