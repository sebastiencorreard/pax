tmp0=!randint 3, 9

val6=$[rint($(tmp0))]
val7=$[rint($val6-1)]
tmp0=!randint 0, $val7

tmp1=!randint 0, $val7

tmp2=!randint 0, $val7

val8=$(tmp0),$(tmp1),$(tmp2)
tmp0=!randint 0, $val7

tmp1=!randint 0, $val7

tmp2=!randint 0, $val7

val9=$(tmp0),$(tmp1),$(tmp2)
t_=!replace internal \( by ( in lift(Mod($(val8[3])+$(val9[3]),$val6))
tmp0=!exec pari $t_

val10=$[rint($(tmp0))]
val11=$[rint(floor(($(val8[3])+$(val9[3]))/$val6))]
t_=!replace internal \( by ( in lift(Mod($(val8[2])+$(val9[2])+$val11,$val6))
tmp0=!exec pari $t_

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in floor(($(val8[2])+$(val9[2])+$val11)/$val6)
tmp0=!exec pari $t_

val13=$[rint($(tmp0))]
t_=!replace internal \( by ( in lift(Mod($(val8[1])+$(val9[1])+$val13,$val6))
tmp0=!exec pari $t_

val14=$[rint($(tmp0))]
val15=$[rint(floor(($(val8[1])+$(val9[1])+$val13)/$val6))]
tmp0=!items2words $val8

val16=$(tmp0)
tmp0=!items2words $val9

val17=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
