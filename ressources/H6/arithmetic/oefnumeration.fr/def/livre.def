val9=$[rint($(tmp0))]
val10=$[rint($(val6[$val8]) + ($val8+1)*($val9 -10^($val8)))]
tmp0=!randitem 1,2

val11=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
