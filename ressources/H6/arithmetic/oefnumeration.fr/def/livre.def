val14=!translate internal $	\
$ to ;; in $tmp
val15=caractères
val16=pages
val17=Nombre de
!if $val12=it 
val13=Impaginiamo un libro e contiamo il numero di cifre utlizzate.
tmp=!trim Il libro ha $val9 pagine. Quanti caratteri sono stati utilizzati per scrivere i numeri di pagina	Abbiamo utilizzato $val10 caratteri per scrivere i nuemri di pagina. Quante pagine ha il libro
val14=!translate internal $	\
$ to ;; in $tmp
val15=caratteri
val16=pagine
val17=Numero di
!endif
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)

!ifval $val11=1 
val19= $val10 
!else
