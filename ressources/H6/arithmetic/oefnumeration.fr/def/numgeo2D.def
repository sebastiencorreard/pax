!set title=Point dans le plan en numération binaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=bpr@math.u-psud.fr
author=Bernadette, Perrin-Riou
language=fr
title_it=Punti nel piano in base 2

ansorder=r
varcnt=22
prevarcnt=20
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 5

val6=$[rint($(tmp0))]
val7=6
!readproc slib/stat/random $val6, 0,1,Z 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/stat/random $val6, 0,1,Z 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!positionof item 0 in $val8

val10=$(tmp0)
tmp0=!itemcnt $val10


!ifval $(tmp0)>($val6+1)/2 
tmp1=!replace item number $(val10[1]) by 1 in $val8

val8= $(tmp1)
!endif
tmp0=!items2words $val8

tmp1=!nospace $(tmp0)

val11=0.$(tmp1)
tmp0=!items2words $val9

tmp1=!nospace $(tmp0)

val12=0.$(tmp1)
val13=0
val14=0
!for val15  = 1 to $val6 
val13=$[$val13 + 2^(-$val15)*$(val8[$val15])]
val14=$[$val14 + 2^(-$val15)*$(val9[$val15])]
!next
val16=xrange -0.2,1.1	yrange -0.2,1.1	parallel 0,-0.05,0,1.1,2^(-$val7+1),0,2^($val7+1),grey	parallel 0,-0.1,0,1.1,2^(-$val7+2),0,2^($val7+1),red	parallel 0,-0.15,0,1.1,2^(-$val7+3),0,2^($val7+1),blue	parallel 0,-0.2,0,1.1,2^(-$val7+4),0,2^($val7+1),green	parallel 0,-0.2,0,1.1,2^(-$val7+5),0,2^($val7+1),black	parallel -0.05,0,1.1,0,0,2^(-$val7+1),2^($val7+1),grey	parallel -0.1,0,1.1,0,0,2^(-$val7+2),2^($val7+1),red	parallel -0.15,0,1.1,0,0,2^(-$val7+3),2^($val7+1),blue	parallel -0.2,0,1.1,0,0,2^(-$val7+4),2^($val7+1),green	parallel -0.2,0,1.1,0,0,2^(-$val7+5),2^($val7+1),black	hline black,0,0	vline black,0,0	text black,1,0,large,1	text black,0,0,large,0	text black,-0.05,1.02,large,1	
val17=$val16	linewidth 10	point $val13,$val14,green
!readproc slib/draw/convpixel $val13,$val14,500,500,-0.2,1.1,-0.2,1.1,0,pixels 
tmp0=$slib_out
val18=$(tmp0)
!readproc oef/draw.phtml 500,500 \
$val16 
tmp0=$ins_url
val16=$(tmp0)	
!readproc slib/oef/env lang 
tmp0=$slib_out
val19=$(tmp0)
val20=Placer le point du plan dont les coordonnées	  écrites en numération binaire sont 
!if $val19=it 
val20=Posizionare nel piano il punto le cui cordinate scritte	    nel sistema di numerazione binario sono 
!endif
replytype1=coord
replyname1=
replygood1=$val16;point,$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div>$val20	    <strong>($val11,$val12)</strong> :</div>	<div class="wimscenter">  
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!if $m_sc_reply1<1 
!readproc oef/draw.phtml 500,500 \
$val17 
tmp0=$ins_url
val21=$(tmp0)	
!endif

!exit

:feedback
!ifval $m_sc_reply1<1
 <div class='oef_feedbacks'><div class="wimscenter">	<img src="$val21" alt="">	</div>	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=11,12,17,20
embedcnt=1
