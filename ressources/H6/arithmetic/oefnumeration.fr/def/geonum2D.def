!set title=Coordonnées dans le plan en binaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=bpr@math.u-psud.fr
author=Bernadette, Perrin-Riou
language=fr
precision=10000000
title_it=Coordinate nel piano in base 2

ansorder=r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 5

val6=$[rint($(tmp0))]
val7=6
!readproc slib/stat/random $val6, 0,1,Z 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/stat/random $val6, 0,1,Z 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!positionof item 0 in $val8

val10=$(tmp0)
tmp0=!itemcnt $val10


!ifval $(tmp0)>($val6+1)/2 
tmp1=!replace item number $(val10[1]) by 1 in $val8

val8= $(tmp1)
!endif
tmp0=!items2words $val8

tmp1=!nospace $(tmp0)

val11=0.$(tmp1)
tmp0=!items2words $val9

tmp1=!nospace $(tmp0)

val12=0.$(tmp1)
val13=0
val14=0
!for val15  = 1 to $val6 
val13=$[$val13 + 2^(-$val15)*$(val8[$val15])]
val14=$[$val14 + 2^(-$val15)*$(val9[$val15])]
!next
val16=xrange -0.2,1.1	yrange -0.2,1.1	parallel 0,-0.05,0,1.1,2^(-$val7+1),0,2^($val7+1),grey	parallel 0,-0.1,0,1.1,2^(-$val7+2),0,2^($val7+1),red	parallel 0,-0.15,0,1.1,2^(-$val7+3),0,2^($val7+1),blue	parallel 0,-0.2,0,1.1,2^(-$val7+4),0,2^($val7+1),green	parallel 0,-0.2,0,1.1,2^(-$val7+5),0,2^($val7+1),black	parallel -0.05,0,1.1,0,0,2^(-$val7+1),2^($val7+1),grey	parallel -0.1,0,1.1,0,0,2^(-$val7+2),2^($val7+1),red	parallel -0.15,0,1.1,0,0,2^(-$val7+3),2^($val7+1),blue	parallel -0.2,0,1.1,0,0,2^(-$val7+4),2^($val7+1),green	parallel -0.2,0,1.1,0,0,2^(-$val7+5),2^($val7+1),black	hline black,0,0	vline black,0,0	text black,1,0,large,1	text black,-0.02,0,large,0	text black,-0.02,1,large,1	
val17=$val16	linewidth 10	point $val13,$val14,green
!readproc slib/draw/convpixel $val13,$val14,500,500,-0.2,1.1,-0.2,1.1,0,pixels 
tmp0=$slib_out
val18=$(tmp0)
!readproc oef/draw.phtml 500,500 \
$val17 
tmp0=$ins_url
val16=$(tmp0)
!readproc oef/drawtikz.phtml 500,500 \
$val17 
tmp0=$ins_tikz
val19=$(tmp0)
!readproc slib/oef/env lang 
tmp0=$slib_out
val20=$(tmp0)
val21=Utilisez le point comme séparateur pour les décimales.
val22=Donner les coordonnées du point du plan dessiné, écrites en numération binaire :
!if $val20=it 
val21=Come separatore per i decimali utilizza il punto.
val22=Scrivere le coordinate del punto del piano indicato, scritte utilizzando la notazione binaria:
!endif
replytype1=numeric
replyoption1=comma 
replyname1=
replygood1=$[$val11]
replytype2=numeric
replyoption2=comma 
replyname2=
replygood2=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} \begin{center} $val19 \end{center} $val22 \end{statement} 


!goto stat

!exit

