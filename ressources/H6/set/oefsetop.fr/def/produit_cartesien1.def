!set title=Produit cartésien
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=David, Doyen
email=david.doyen@u-pem.fr
language=fr
title_it=Prodotto cartesiano
title_es=Producto cartesiano

ansorder=r
varcnt=42
prevarcnt=41
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=0,1,2,3,4
val8=a,b,c,d,e
!if $val2=1 
val9=$val7
!endif
!if $val2=2 
val9=$val8
!endif
!if ($val2=3) or ($val2=) 
tmp0=!randitem 1,2

!if $(tmp0)=1 
val9=$val7
!else
val9=$val8
!endif
!endif
val10=1,3;2,2;2,3;3,3
tmp0=!randint 1, 4

val11=$(tmp0)
tmp0=!shuffle $(val10[$val11;])

val12=$(tmp0)
val13=$(val12[1])
val14=$(val12[2])
tmp0=!shuffle $val9

val9=$(tmp0)
val15=$(val9[1..$val13])
tmp0=!shuffle $val9

val9=$(tmp0)
val16=$(val9[1..$val14])
tmp0=!shuffle 2

val17=$(tmp0)
val18=A,B
val19=$(val18[$(val17[1])]) \times $(val18[$(val17[2])])
val20=
!for val11 =1 to $val13 
!for val21 =1 to $val14 
val22=$(val15[$val11]),$(val16[$val21])
val23=($(val22[$(val17[1])]),$(val22[$(val17[2])]))
tmp0=!append item $val23 to $val20

val20=$(tmp0)
!next
!next
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val24=vide
val25=et
val26=On considère les ensembles
val27=Déterminer
val28=Écrire les couples sous la forme <span class="tt">(a,b)</span> sans utiliser d'espace. Les couples doivent également être séparés par des virgules.
!if $val6=it 
val24=vuoto
val25=e
val26=Si considerino gli insiemi
val27=Determinare
val28=Non inserire spazi nelle coppie di elementi: per esempio scrivere <span class="tt">(a,b)</span> e non <span class="tt">(a, b)</span>. Le diverse coppie devono essere separate da virgole.
!endif
!if $val6=es 
val24=vacío
val25=y
val26=Considere los conjuntos
val27=Determine
val28=Al ingresar su respuesta, no inserte espacios en pares	de elementos: por ejemplo, escriba <span class="tt">(a,b)</span> y no <span	class="tt">(a, b)</span>
!endif
replytype1=set
replyname1=
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

