 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=0,1,2,3,4
val8=a,b,c,d,e
!if $val2=1 
val9=$val7
!endif
!if $val2=2 
val9=$val8
!endif
!if ($val2=3) or ($val2=) 
tmp0=!randitem 1,2

!if $(tmp0)=1 
val9=$val7
!else
val9=$val8
!endif
!endif
val10=1,2,2;1,2,3;2,2,2;1,3,3
tmp0=!randint 1, 4

val11=$(tmp0)
tmp0=!shuffle $(val10[$val11;])

val12=$(tmp0)
val13=$(val12[1])
val14=$(val12[2])
val15=$(val12[3])
tmp0=!shuffle $val9

val9=$(tmp0)
val16=$(val9[1..$val13])
tmp0=!shuffle $val9

val9=$(tmp0)
val17=$(val9[1..$val14])
tmp0=!shuffle $val9

val9=$(tmp0)
val18=$(val9[1..$val15])
tmp0=!shuffle 3

val19=$(tmp0)
val20=A,B,C
val21=$(val20[$(val19[1])]) \times $(val20[$(val19[2])])\times $(val20[$(val19[3])])
val22=
!for val11 =1 to $val13 
!for val23 =1 to $val14 
!for val24 =1 to $val15 
val25=$(val16[$val11]),$(val17[$val23]),$(val18[$val24])
val26=($(val25[$(val19[1])]),$(val25[$(val19[2])]),$(val25[$(val19[3])]))
tmp0=!append item $val26 to $val22

val22=$(tmp0)
!next
!next
!next
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val27=vide
val28=et
val29=On considère les ensembles
val30=Déterminer
val31=Écrire les triplés sous la forme <span class="tt">(a,b,c)</span> sans utiliser d'espace. Les triplés doivent également être séparés par des virgules.
!if $val6=it 
val27=vuoto
val28=e
val29=Si considerino gli insiemi
val30=Determinare
val31=Non inserire spazi nelle terne di elementi: per esempio scrivere <span class="tt">(a,b,c)</span> e non <span class="tt">(a, b, c)</span>. Le diverse terne devono essere separate da virgole.
!endif
!if $val6=es 
val27=vacío
val28=y
val29=Considere los conjuntos
val30=Determine
val31=Al ingresar su respuesta, no inserte espacios en una	tupla de elementos: por ejemplo, escriba <span class="tt">(a,b,c)</span> y no	<span class="tt">(a, b, c)</span>
!endif
replytype1=set
replyname1=
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

