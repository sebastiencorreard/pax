val17=Determine
val18=Para denotar el conjunto vacío, escriba la palabra <span class="tt">$val14</span> en el campo de respuesta.
!endif
tmp0=!listcomplement $val13 in $val11

val19=$(tmp0)
tmp0=!listcomplement $val11 in $val13

val20=$(tmp0)
