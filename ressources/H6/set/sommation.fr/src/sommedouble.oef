\title{Sommation double 1}

\language{fr}
\format{html}

\author{Bernadette,Perrin-Riou;Sophie,Lemaire}
\email{bernadette.m.riou@orange.fr,sophie.lemaire@universite-paris-saclay.fr}
\computeanswer{no}

\description{Somme d'une famille de nombres indexés par des couples d'entiers}
\integer{m=randint(1..4)}
\integer{n=randint(7..10)}
\text{sgn=randitem(-,+)}
\integer{ar=randint(-4..4)}
\integer{br=randint(7..10)}
\integer{choix1=random(1,2)}
\integer{choix2=random(1,2)}
\text{s1=item(\choix1,\leq,<)}
\text{s2=item(\choix2,\leq,<)}
\integer{R=random(1,2)}
\text{i1= \R=1? i: j}
\text{i2= \R=1? j: i}
\integer{a= \choix1=1? \ar: \ar+1}
\integer{b= \choix2=1? \br: \br-1}
\integer{rep1=\m}
\integer{rep2=\n}
\if{\R=1}{
   \if{\sgn issametext +}{
    \text{rep3= simplify(\a-i)}
    \text{rep4= simplify(\b-i)}
    \integer{MM=\b-\m}
    \integer{mm=\a-\n}
   }
   {\text{rep3= simplify(i-(\b))}
    \text{rep4= simplify(i-(\a))}
    \integer{MM=\n-(\a)}
    \integer{mm=\m-(\b)}
  }
 \integer{xmin=\m}\integer{xmax=\n}\integer{ymin=\mm}\integer{ymax=\MM}
}{
  \if{\sgn issametext +}{
    \text{rep3= simplify(\a-j)}
    \text{rep4= simplify(\b-j)}
    \integer{MM=\b-\m}
    \integer{mm=\a-\n}
   }
   {\text{rep3= simplify(\a+j)}
    \text{rep4= simplify(\b+j)}
    \integer{MM=\n+(\b)}
    \integer{mm=\m+(\a)}
  }
 \integer{ymin=\m}\integer{ymax=\n}\integer{xmin=\mm}\integer{xmax=\MM}
}
\integer{nbmax=max(\MM-(\mm),\n-(\m))}
\text{condition= \sgn issametext +? i+j: i-j}
\integer{bornex=\xmin+\nbmax}
\integer{borney=\ymin+\nbmax}
\text{dessin1=xrange \xmin-2,\bornex+4
yrange \ymin-2,\borney+2
parallel \xmin,\ymin,\xmin,\ymin+\nbmax, 1,0,\nbmax+1,grey
parallel \xmin,\ymin,\xmin+\nbmax,\ymin,0,1,\nbmax+1,grey
text black,\xmin-1,\ymin+\nbmax,medium,j
text black,\xmin+\nbmax,\ymin, medium,i
text black,\xmin-2,\ymin-0.2,,(\xmin,\ymin)
text black,\bornex-1.3,\borney+0.8,,(\bornex,\borney)
}
\if{\R=1}{
\for{i=\m to \n}{
  \for{j=\mm to \MM}{
    \real{r=evalue(\condition, i=\i,j=\j)}
    \if{\r >=\a and \r<=\b}{
      \text{dessin1= \dessin1
        disk \i,\j, 6,red}
    }
  }
}
\text{dessin1=\dessin1
arrow \xmin,\ymin-2,\xmin,\ymin-1,8,blue}
}{
\for{j=\m to \n}{
  \for{i=\mm to \MM}{
    \real{r=evalue(\condition, i=\i,j=\j)}
    \if{\r >=\a and \r<=\b}{
      \text{dessin1= \dessin1
        disk \i,\j, 6,red}
    }
  }
}
\text{dessin1=\dessin1
arrow \xmin-2.5,\ymin,\xmin-0.8,\ymin,8,blue}
}
\text{des1=draw(200,200
 \dessin1)}
\statement{On considère l'ensemble \(E\) des couples
\((i , j)\in \ZZ^2\) tels que
<div class="wimscenter">
 \(\m \leq \i1 \leq \n\) et \(\ar \s1 i \sgn j \s2 \br\). </div>
 <div class="wims_question">Écrire la somme des nombres \(p_{i,j}\) pour \((i, j) \in E\)
  sous la forme d'une somme double :
<div class="wimscenter">
\special{mathmlinput [\displaystyle{\large{\sum_{(i,j)\in E}p_{i,j}=\sum_{\i1=reply1}^{reply2}\left(\sum_{\i2=reply3}^{reply4} p_{i,j}\right)}}],5,noanswer
reply 1
reply 2
reply 3
reply 4
}
</div></div>
}
\answer{}{\rep1}{type=formal}
\answer{}{\rep2}{type=formal}
\answer{}{\rep3}{type=formal}
\answer{}{\rep4}{type=formal}
\feedback{\i2 isin \reply1 or \i2 isin \reply1}{Attention, cela n'a pas de sens de faire dépendre
les bornes de la première somme de \(\i2\) qui est l'indice de sommation de la seconde somme.}
\solution{(indications)
Les éléments de \(E\) sont représentés comme des points rouges sur la figure : <p class="wimscenter">
<img src="\des1" alt=""></p>
En parcourant l'ensemble de ces points rouges \if{\R=2}{de bas en haut, ligne après ligne,}
{de gauche à droite, colonne après colonne,} on obtient
<div class="wimscenter">
\(\displaystyle{\sum_{(i,j) \in E}p_{i,j} = \sum_{\i1=\rep1}^{\rep2} \big(\sum_{\i2=\rep3}^{\rep4}p_{i,j}\big)}\).
</div>}

