\description{Ecrire de deux façons différentes une même somme double}
\integer{m=randint(7..12)}
\integer{n=randint(7..12)}
\integer{M=max(\m,\n)}
\text{sgn=randitem(-,+)}
\integer{ar=randint(-4..4)}
\integer{br=randint(\M-2..\M+2)}
\integer{choix1=random(1,2)}
\integer{choix2=random(1,2)}
\text{s1=item(\choix1,\(\leq),\(<))}
\text{s2=item(\choix2,\(\leq),\(<))}
\integer{R=random(1,2)}
\text{i1= \R=1? i: j}
\text{i2= \R=1? j: i}
\integer{a= \choix1=1? \ar: \ar+1}
\integer{b= \choix2=1? \br: \br-1}
\if{\sgn issametext +}{
  \integer{repa1= max(1,\a-\n) }
  \integer{repa2= min(\m,\b-1) }
  \function{fa3=simplify(\a-i)}\function{fa4=simplify(\b-i)}
  \text{repa31= max(1,\fa3)}
  \text{repa41= min(\n,\fa4)}
}{
  \integer{repa1= max(1+\a,1)}
  \integer{repa2= min(\b+\n,\m)}
  \function{fa3=simplify(i-\b)}\function{fa4=simplify(i-(\a))}
  \text{repa31= max(1,\fa3)}
  \text{repa41= min(\n,\fa4)}
}
\real{ua31=evalue(\repa31,i=\repa1)}
\real{va31=evalue(\repa31,i=\repa2)}
\if{\ua31=\va31}{\integer{repa3=1}}
  {
  \real{ua31=evalue(\fa3,i=\repa1)}
  \real{va31=evalue(\fa3,i=\repa2)}
  \if{\ua31>=1 and \va31>=1}{\text{repa3=\fa3}}{\text{repa3=\repa31}}
  }
\real{ua41=evalue(\repa41,i=\repa1)}
\real{va41=evalue(\repa41,i=\repa2)}
\if{\ua41=\va41}
   {\integer{repa4=\n}}
   {\real{ua41=evalue(\fa4,i=\repa1)}
    \real{va41=evalue(\fa4,i=\repa2)}
    \if{\ua41<=\n and \va41<=\n}{\text{repa4=\fa4}}
       {\text{repa4=\repa41}}
   }
 \if{\sgn issametext +}{
    \integer{repb1= max(1,\a-\m) }
    \integer{repb2= min(\n,\b-1) }
    \function{fb3=simplify(\a-j)}
    \function{fb4=simplify(\b-j)}
    \text{repb31= max(1,\fb3)}
    \text{repb41= min(\m,\fb4)}
    }
   {\integer{repb1= max(1-\b,1)}
    \integer{repb2= min(\m-\a,\n)}
    \function{fb3=simplify(\a+j)}
    \function{fb4=simplify(\b+j)}
    \text{repb31= max(1,\fb3)}
    \text{repb41= min(\m,\fb4)}
    }
\real{ub31=evalue(\repb31,j=\repb1)}
\real{vb31=evalue(\repb31,j=\repb2)}
\if{\ub31=\vb31}
   {\integer{repb3=1}}{
     \real{ub31=evalue(\fb3,j=\repb1)}
     \real{vb31=evalue(\fb3,j=\repb2)}
     \if{\ub31>=1 and \vb31 >=1}{\text{repb3=\fb3}}
       {\text{repb3=\repb31}}}
\real{ub41=evalue(\repb41,j=\repb1)}
\real{vb41=evalue(\repb41,j=\repb2)}
\if{\ub41=\vb41}
   {\integer{repb4=\m}}
   {\real{ub41=evalue(\fb4,j=\repb1)}
    \real{vb41=evalue(\fb4,j=\repb2)}
    \if{\ub41<=\m and \vb41<=\m}{\text{repb4=\fb4}}
     {\text{repb4=\repb41}}}
\text{ix1=\i2}\text{ix2=\i1}
\if{\R=1}{\text{rep1=\repa1}\text{rep2=\repa2}\text{rep3=\repa3}\text{rep4=\repa4}
\text{x1=\repb1}\text{x2=\repb2}\text{x3=\repb3}\text{x4=\repb4}}
{\text{rep1=\repb1}\text{rep2=\repb2}\text{rep3=\repb3}\text{rep4=\repb4}
\text{x1=\repa1}\text{x2=\repa2}\text{x3=\repa3}\text{x4=\repa4}}
\integer{A=random(1,2)}
\text{condition= \sgn issametext +? i+j: i-j}
\text{ncondition= \sgn issametext +? i-j: i+j}
\integer{da=randint(1..2)*random(-1,1)}
\integer{db=randint(1..2)}
\text{dessin1=xrange -1,\M+1
yrange -1,\M+1
parallel 0,0,0,\M, 1,0,\M+1,grey
parallel 0,0,\M, 0,0,1,\M+1,grey
text black,0,\M,medium,j
text black,\M,0, medium,i
hline 0,0,black
vline 0,0,black}
\for{i=1 to \m}{
  \for{j=1 to \n}{
    \real{r=evalue(\condition, i=\i,j=\j)}
    \real{nr=evalue(\ncondition, i=\i,j=\j)}
    \if{\r >=\a and \r<=\b}{
      \text{dessin1= \dessin1
        disk \i,\j, 8,red}
    }
  }
}
\text{des1=draw(200,200
 \dessin1)}
\statement{
  Soit \(\{p_{i,j}, i\in\NN, j\in \NN\}\) une famille de réels.
  On pose \(S = \displaystyle{\sum_{\ix1=\x1}^{\x2}\Big(\sum_{\ix2=\x3}^{\x4}p_{i,j}\Big)}\).
 <div class="wims_question"> Lorsqu'on intervertit les deux sommes, on obtient :
