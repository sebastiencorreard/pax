!set title=Indices et sommation 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette,Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
computeanswer=no
oefdescription=Travail sur l'indice de sommation

ansorder=r,r
varcnt=13
prevarcnt=11
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2
tmp0=!randint 1, 3

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 7, 12

val8=$[rint($(tmp0))]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items i,j,k,m,n,r

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val8+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$[rint($(tmp0))]

!ifval $val6=1
val13=$[rint( $val11 )]
!else
val13=$[rint( $val12)]
!endif
tmp=!translate ";': to $     $ in $val10-$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
val15=
replytype1=formal
replyname1=
replygood1=$val13
replytype2=formal
replyname2=
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On désigne par 
!insmath f
$() une fonction définie sur les entiers et on pose :	
!insmath \displaystyle{ S = \sum_{$val10 = $val7}^{$val8} f ( $val10 )}
$().	<div class="wims_question">Donner une autre expression de 
!insmath S
$() en faisant une translation sur la variable :	
!if $val6=1 
$()	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [S=\displaystyle{\sum_{$val10=reply1}^{$val12}f(reply2)}],4,noanswer	reply1,3	reply2 
$()	</div>	 
!else
$() 	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [S=\displaystyle{\sum_{$val10=$val11}^{reply1}f(reply2)}],4,noanswer	reply1,3	reply2 
$()	</div>	 
!endif
$()	</div>	
!if $val15=1 and ($m_sc_reply1 <1 or $m_sc_reply2 <1) 
$()<span class="oef_indbad">Expression incorrecte,</span>	 <p class="wimscenter">	
!insmath \displaystyle{\sum_{$val10 = $val7}^{$val8}f($val10) = \sum_{$val10 = $val11}^{$val12}f($val14)}.
$()	</p>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
!readproc slib/oef/env presentgood 
tmp0=$slib_out
val15=$(tmp0)

!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10,11,12,14,15
embedcnt=2
