tmp0=!randint 1, 3

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 7, 12

val7=$[rint($(tmp0))]
val8=$[rint($val7-$val6+1)]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

val10=$[rint($(tmp0))]
val11=h,j,k,m,n,r,t
val12=$(val11[$val10])
val13=$(val11[$val10+1])
tmp0=!randint 2, 3

val14=$[rint($(tmp0))]
val15=$[rint($val14-1)]
tmp0=!randint 2, 4

tmp1=!randitem 1,-1

val16=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items $val16*($val14)^$val12,$val14*$val12+($val16),$val16*$val12^($val15),($val16*$val12)^$val14,$val16*exp(-$val14*$val12)

tmp0=!randitem $tmp
val17=$(tmp0)
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
tmp0=!texmath $val18

val19=$(tmp0)
val20=$[0]
!for val21 =$val6 to $val7 
evaltmp=$val18

evaltmp=!mathsubst $val12=($val21) in $evaltmp
tmp0=($evaltmp)
val20=$[$val20+$(tmp0)]
!next
val22=$val19
tmp0=!randitem 1,2

val23=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$[rint($(tmp0))]

!ifval $val23=1
val26=$[rint( $val24 )]
!else
val26=$[rint( $val25)]
!endif
tmp=!translate ";': to $     $ in $val12-$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=$(tmp0)
!if $val23=1 
val28=!rawmath $val12 + $val9
val24=$[rint($val6+$val9)]
val25=$[rint($val7+$val9)]
evaltmp=$val18

evaltmp=!mathsubst $val12=($val13-$val9) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val29=!rawmath $(tmp1)
!else
val28=!rawmath $val9 - $val12
val24=$[rint($val9-$val7)]
val25=$[rint($val9-$val6)]
evaltmp=$val18

evaltmp=!mathsubst $val12=($val9-$val13) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val29=!rawmath $(tmp1)
!endif
tmp0=!texmath $val29

val30=$(tmp0)
val31=$[rint(1)]
val32=$[rint(0)]
val33=!rawmath 0
val34=$[rint(0)]
val35=$[rint(0)]
val36=$[rint(1)]
val37=
val38=!rawmath 0
val39=!rawmath 0
val40=!rawmath 0
val41=reply1,reply2,reply3
dynsteps=yes
oefsteps=$val41 
nextstep=!nosubst $val41 
!readproc oef/steps.proc
