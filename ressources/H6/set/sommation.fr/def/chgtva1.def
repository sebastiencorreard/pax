val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 7, 12

val7=$[rint($(tmp0))]
val8=$[rint($val7-$val6+1)]
tmp0=!randint 1, 4

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 6

val10=$[rint($(tmp0))]
val11=h,j,k,m,n,r,t
val12=$(val11[$val10])
val13=$(val11[$val10+1])
val14=!rawmath $val12
val15=f ( $val12 )
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val6+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val7+$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$[rint($(tmp0))]

!ifval $val16=1
val19=$[rint( $val17 )]
!else
val19=$[rint( $val18)]
!endif
tmp=!translate ";': to $     $ in $val12-$val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=$(tmp0)
!if $val16=1 
val21=!rawmath $val12 + $val9
val17=$[rint($val6+$val9)]
val18=$[rint($val7+$val9)]
val22=!rawmath $val13-$val9
!else
val21=!rawmath $val9 - $val12
val17=$[rint($val9-$val7)]
val18=$[rint($val9-$val6)]
val22=!rawmath $val9-$val13
!endif
tmp0=!texmath $val22

val23=$(tmp0)
val24=$[rint(1)]
val25=$[rint(0)]
val26=!rawmath 0
val27=$[rint(0)]
val28=$[rint(0)]
val29=$[rint(1)]
val30=
val31=!rawmath 0
val32=!rawmath 0
val33=!rawmath 0
val34=reply1,reply2,reply3
dynsteps=yes
oefsteps=$val34 
nextstep=!nosubst $val34 
!readproc oef/steps.proc
replytype1=formal
replyoption1=nonstop 
replyweight1=3 
replyname1=en-dessous de la somme
