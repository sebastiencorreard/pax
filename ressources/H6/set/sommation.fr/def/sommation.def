!ifval $val11 <> $m_reply1
 <div class='oef_feedbacks'><div style="$val28"> Le nombre de termes	n'est pas bon car la règle du jeu est qu'il y en ait 
!insmath $val6
$(). </div>
$()</div>
!endif
!ifval $val33 = 1 and $val11 <> $m_reply1 
 <div class='oef_feedbacks'><div style="$val28">Cependant, l'expression du terme général	$val16 est correcte. Faites attention au nombre de termes la prochaine fois.</div> 
$()</div>
!endif
!ifval $val34=0
 <div class='oef_feedbacks'><div style="$val28">Attention au nom de l'indice de sommation.</div> 
$()</div>
