!ifval $val13 issametext + 
val32=$[rint( 0)]
!else
val32=$[rint(1)]
!endif
!for val23 =$val10 to $m_reply1 
evaltmp=$val31

evaltmp=!mathsubst $val9=($val23) in $evaltmp
tmp0=($evaltmp)
val24=$[rint($(tmp0))]
val32=$[rint($val32 $val13 $val24)]
!next
t_=!replace internal \( by ( in print($val21 - ($m_reply2) == 0)
tmp0=!exec pari $t_

val33=$(tmp0)

!ifval $val9 isvariableof $m_reply2 
val34= 1
!else
val34= 0
!endif

!exit

:feedback
!ifval $val32<>$val26
 <div class='oef_feedbacks'>Une réponse est	<div class="wimscenter">	
!if $val13 issametext + 
$()
!insmath \displaystyle{\sum_{$val9=$val10}^{$val11}}
$() 
!else
$()	 
!insmath \displaystyle{\prod_{$val9=$val10}^{$val11}}
$() 
!endif
$()
!insmath $val22
$().</div>	
$()</div>
