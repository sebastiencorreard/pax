!set title=Sommation 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette,Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
oefdescription=Une suite de nombre est proposée. Il s'agit d'écrire la somme ou le produit de ces nombres à l'aide des opérateurs somme ou produit.
oefobservation=L'énoncé propose soit un produit, soit une somme à compléter. Le terme général est de la forme b*a^n, a*n+b, b*n^(a-1) ou (b*n)^a

ansorder=r,r
varcnt=36
prevarcnt=29
postvarcnt=6
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=4
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 6, 9

val6=$[rint($(tmp0))]
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 4

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items n,i,j,t,r

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!randint -1, 2

val10=$[rint($(tmp0))]
val11=$[rint($val6+$val10-1)]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of +,*

val13=$(tmp0)
tmp0=!item $val12 of \sum,\prod

val14=$(tmp0)
tmp0=!item $val12 of la somme, le produit

val15=$(tmp0)
tmp0=!item $val12 of de la somme, du produit

val16=$(tmp0)
tmp0=!item $val12 of d'une somme, d'un produit

val17=$(tmp0)
tmp0=!item $val12 of La somme est correcte, Le produit est correct

val18=$(tmp0)
!if $val12=1 
tmp=!nonempty items $val8*$val7^$val9,$val7*$val9+($val8), $val8*$val9^($val7-1),($val8*$val9)^$val7

tmp0=!randitem $tmp
val19=$(tmp0)
!else
val20=$[rint(abs($val8))]
tmp=!nonempty items $val8*$val7^$val9,$val7*$val9+$val20,-$val7*$val9-$val20,$val8*$val9^($val7-1),($val8*$val9)^$val7

tmp0=!randitem $tmp
val19=$(tmp0)
!endif
tmp=!translate ";': to $     $ in $val19

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=$(tmp0)
evaltmp=$val19

evaltmp=!mathsubst $val9=(($val9-$val10+1)) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val21=$(tmp1)
tmp0=!texmath $val21

val22=$(tmp0)
!for val23 =1 to $val6 
evaltmp=$val19

evaltmp=!mathsubst $val9=($val23) in $evaltmp
tmp0=($evaltmp)
val24=$[$(tmp0)]
!if $val23=1 
val25=$val24
val26=$[rint($val24)]
!else
val25=$val25,  $val24
val26=$[rint($val26$val13 $val24)]
!endif
!next
val27=background-color: #FFEECD;	  margin : 5% 5%;	  text-align : center ;	  color : black;	  padding :1%;	
val28=border-left:2px solid red;	  margin : 0 2%;	  color : black;	  padding : 1%;
val29=Plus grande valeur pour l'indice
val30=Terme général
replytype1=formal
replyname1=$val29
replygood1=$val11
replytype2=formal
replyname2=$val30
replygood2=?analyze 31
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici un ensemble d'entiers :	<p style="$val27">$m_leftbrace1 $val25 $m_rightbrace1</p>	<div class="wims_question">	On peut écrire $val15 de ses éléments sous la forme $val17	ayant le même nombre de termes,	en trouver l'expression :	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\large{\displaystyle{$val14 _{$val9 = $val10}^{reply1}reply2}}],2	reply1	reply2,7 
$()	</div>	</div>	
$()
!exit

