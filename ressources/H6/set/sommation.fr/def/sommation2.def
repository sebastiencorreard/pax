!set title=Sommation 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette,Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
oefdescription=Simplifier une expression comportant deux sommes ayant le même nombre de termes

ansorder=r
varcnt=39
prevarcnt=30
postvarcnt=8
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 3

tmp1=!randitem -1,1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 0, 3

tmp1=!randitem -1,1

val7=$[rint($(tmp0)*$(tmp1))]

!ifval $val7=$val6
tmp0=!randint 1, 3

val7=$[rint( $val7+$(tmp0))]
!endif
tmp0=!randint 5, 6

val8=$[rint($(tmp0))]
val9=$[rint($val6+$val8-1)]
val10=$[rint($val7+$val8-1)]
tmp0=!randint 2, 3

val11=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp=!nonempty items n,i,j,t,r

tmp0=!randitem $tmp
val13=$(tmp0)
tmp=!nonempty items $val12*$val11^$val13,$val11*$val13+($val12),$val12*$val13^($val11-1),($val12*$val13)^$val11

tmp0=!randitem $tmp
val14=$(tmp0)
tmp=!translate ";': to $     $ in $val14

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
tmp0=!texmath $val14

val15=$(tmp0)
tmp=!nonempty items $val12*$val11^$val13,$val11*$val13+($val12),$val12*$val13^($val11-1),($val12*$val13)^$val11

tmp0=!randitem $tmp
val16=$(tmp0)
tmp=!translate ";': to $     $ in $val16

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val16=$(tmp0)
tmp0=!texmath $val16

val17=$(tmp0)
val18=$[0]
!for val19 =$val6 to $val9 
evaltmp=$val14

evaltmp=!mathsubst $val13=($val19) in $evaltmp
tmp0=($evaltmp)
val18=$[$val18+$(tmp0)]
!next
val20=$[0]
!for val19 =$val7 to $val10 
evaltmp=$val16

evaltmp=!mathsubst $val13=($val19) in $evaltmp
tmp0=($evaltmp)
val20=$[$val20+$(tmp0)]
!next
val21=$[$val18+$val20]
evaltmp=$val14

evaltmp=!mathsubst $val13=($val13+$val6-1) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val22=$(tmp1)
evaltmp=$val16

evaltmp=!mathsubst $val13=($val13+$val7-1) in $evaltmp
tmp0=($evaltmp)
tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
val23=$(tmp1)
tmp=!translate ";': to $     $ in $val22+$val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
tmp0=!texmath $val22

val25=$(tmp0)
tmp0=!texmath $val23

val26=$(tmp0)
tmp0=!texmath $val24

val27=$(tmp0)
val28=$[rint(0)]
val29=$[rint(0)]
replytype1=formal
replyname1=
replygood1=?analyze 30
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div>On note 
!insmath S
$() l'expression suivante</div>	<div class="wimscenter">	
!insmath \displaystyle{S = \sum_{$val13 = $val6 }^{$val9 } $val15 }
$() +	
!insmath \displaystyle{\sum_{$val13=$val7 }^{$val10 } $val17}
$()	</div>	<div class="wims_question">	  Écrire 
!insmath S
$() sous la forme d'une somme unique :	  <div class="wimscenter">	  <label for="reply1">
!insmath \displaystyle{\large{S=\sum_{$val13=1}^$val8 }}
$()</label>  
!read oef/embed.phtml reply 1,10 
$()	  </div>	</div>	
$()
!exit

:hint
$()Voici deux exemples montrant comment écrire des expressions dans les champs de réponse :	<ul><li> 
!insmath $val11$val13
$() s'écrit <span class="tt">$val11*$val13</span></li><li> 
!insmath $val13^2
$()	  s'écrit <span class="tt">$val13^2</span></li></ul> 
$()
!exit

:help
$()
$()
!exit

:solution
$()	
!if $val28=0 or $val29=0 
$()Une réponse est :	<div class="wimscenter">
!insmath \displaystyle{ S = \sum_{$val13=1 }^{$val8 }($val27)}
$() .</div> 
!else
$()	 Une façon de mener la transformation est de faire un changement de variable sur chaque somme pour se ramener à des sommes dont l'indice varie de 1 à $val8 :	<div class="wimscenter">
!insmath \displaystyle{S = \sum_{$val13=1}^{$val8} ($val25)} 
$() + 
!insmath \displaystyle{\sum_{$val13=1}^{$val8} ($val26) }
$().</div>	On peut maintenant regrouper les deux sommes en une seule :	<div class="wimscenter">
!insmath \displaystyle{S = \sum_{$val13=1}^{$val8} ($val27)}
$() .</div> 
!endif
$()	
$()
!exit

:latex
$()
$()
!exit

:postdef
val31=$[0]
tmp0=!rawmath $val30

val32=$(tmp0)
!for val19 =1 to $val8 
evaltmp=$val32

evaltmp=!mathsubst $val13=($val19) in $evaltmp
tmp0=($evaltmp)
val31=$[$val31+$(tmp0)]
!next
val33=border:1px solid #ffcc66;	  margin:0 5%;	  color:black;	  padding:0.5%;	  margin:0 5%;	
!if $val13 isvariableof $val32 
val29=$[rint(1)]
!else
val29=$[rint(0)]
!endif
tmp=!translate ";': to $     $ in $val14+($val16)-($m_reply1)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28=$[rint($(tmp0))]

!exit

:feedback
!ifval $val29=0
 <div class='oef_feedbacks'><div style="$val33">Attention au nom de l'indice de sommation.</div> 
$()</div>
!endif
!ifval $val28=0 and $val31!=$val21
 <div class='oef_feedbacks'><div style="$val33">	  Pour pouvoir regrouper les termes généraux de deux sommes,	  il faut que les indices des deux sommes varient dans le même ensemble d'entiers.	  </div>
$()</div>
!endif

!exit

:test

!ifval $val31=$val21
 condtest1=1
!else
 condtest1=0
!endif
condname1=Somme exacte

!exit

:stat
vsavelist=6,7,8,9,10,11,13,14,15,16,17,19,21,25,26,27,28,29,30
embedcnt=1
