!set title=Sommation double 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette,Perrin-Riou;Sophie,Lemaire
email=bernadette.m.riou@orange.fr,sophie.lemaire@universite-paris-saclay.fr
language=fr
computeanswer=no
oefdescription=Somme d'une famille de nombres indexés par des couples d'entiers

ansorder=r,r,r,r
varcnt=57
prevarcnt=56
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
tmp0=!randint 7, 10

val7=$[rint($(tmp0))]
tmp=!nonempty items -,+

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!randint -4, 4

val9=$[rint($(tmp0))]
tmp0=!randint 7, 10

val10=$[rint($(tmp0))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!item $val11 of \leq,<

val13=$(tmp0)
tmp0=!item $val12 of \leq,<

val14=$(tmp0)
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]

!ifval $val15=1
val16= i
!else
val16= j
!endif

!ifval $val15=1
val17= j
!else
val17= i
!endif

!ifval $val11=1
val18=$[rint( $val9)]
!else
val18=$[rint( $val9+1)]
!endif

!ifval $val12=1
val19=$[rint( $val10)]
!else
val19=$[rint( $val10-1)]
!endif
val20=$[rint($val6)]
val21=$[rint($val7)]
!if $val15=1 
!if $val8 issametext + 
tmp=!translate ";': to $     $ in $val18-i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val19-i

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
val24=$[rint($val19-$val6)]
val25=$[rint($val18-$val7)]
!else
tmp=!translate ";': to $     $ in i-($val19)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in i-($val18)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
val24=$[rint($val7-($val18))]
val25=$[rint($val6-($val19))]
!endif
val26=$[rint($val6)]
val27=$[rint($val7)]
val28=$[rint($val25)]
val29=$[rint($val24)]
!else
!if $val8 issametext + 
tmp=!translate ";': to $     $ in $val18-j

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val19-j

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
val24=$[rint($val19-$val6)]
val25=$[rint($val18-$val7)]
!else
tmp=!translate ";': to $     $ in $val18+j

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val19+j

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
val24=$[rint($val7+($val19))]
val25=$[rint($val6+($val18))]
!endif
val28=$[rint($val6)]
val29=$[rint($val7)]
val26=$[rint($val25)]
val27=$[rint($val24)]
!endif
val30=$[rint(max($val24-($val25),$val7-($val6)))]

!ifval $val8 issametext +
val31= i+j
!else
val31= i-j
!endif
val32=$[rint($val26+$val30)]
val33=$[rint($val28+$val30)]
val34=xrange $val26-2,$val32+4	yrange $val28-2,$val33+2	parallel $val26,$val28,$val26,$val28+$val30, 1,0,$val30+1,grey	parallel $val26,$val28,$val26+$val30,$val28,0,1,$val30+1,grey	text black,$val26-1,$val28+$val30,medium,j	text black,$val26+$val30,$val28, medium,i	text black,$val26-2,$val28-0.2,,($val26,$val28)	text black,$val32-1.3,$val33+0.8,,($val32,$val33)	
!if $val15=1 
!for val35 =$val6 to $val7 
!for val36 =$val25 to $val24 
evaltmp=$val31

evaltmp=!mathsubst i=($val35) in $evaltmp
evaltmp=!mathsubst j=($val36) in $evaltmp
tmp0=($evaltmp)
val37=$[$(tmp0)]
!if $val37 >=$val18 and $val37<=$val19 
val34=$val34	        disk $val35,$val36, 6,red
!endif
!next
!next
val34=$val34	arrow $val26,$val28-2,$val26,$val28-1,8,blue
!else
!for val36 =$val6 to $val7 
!for val35 =$val25 to $val24 
evaltmp=$val31

evaltmp=!mathsubst i=($val35) in $evaltmp
evaltmp=!mathsubst j=($val36) in $evaltmp
tmp0=($evaltmp)
val37=$[$(tmp0)]
!if $val37 >=$val18 and $val37<=$val19 
val34=$val34	        disk $val35,$val36, 6,red
!endif
!next
!next
val34=$val34	arrow $val26-2.5,$val28,$val26-0.8,$val28,8,blue
!endif
!readproc oef/draw.phtml 200,200 \
 $val34 
tmp0=$ins_url
val38=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val20
replytype2=formal
replyname2=
replygood2=$val21
