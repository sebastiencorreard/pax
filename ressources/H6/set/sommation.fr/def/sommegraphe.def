!insmath (i, j) \in\NN^2
$()	  tels que 
!insmath $val21 \leq $val17 \leq $val22
$() et 
!insmath $val29 \leq $val18 \leq $val32.
$() Il	   
!else
$()	   L'ensemble 
!insmath E
$() 
!endif
$()	  est représenté sur le dessin 
!if $val52=1 
