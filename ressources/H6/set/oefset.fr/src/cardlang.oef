\text{lang=slib(oef/env lang)}
\integer{A= random(100..200)}
\integer{Al= random(50..150)}
\integer{E= random(100..150)}
\integer{AAlE= random(5..20)}
\integer{AE= random(100..500)}
\integer{AAl= random(50..300)}
\integer{AlE= random(50..100)}
\integer{ptout= \A+\AE+\AAl+\AAlE+\E+\Al+\AlE}
\integer{rien=random(10..50)}
\integer{N= \rien+\ptout}
\integer{Ang= \A+\AE+\AAl+\AAlE}
\integer{Esp= \E+\AE+\AlE+\AAlE}
\integer{All= \Al+\AlE+\AAl+\AAlE}
\integer{aa= \AAl+\AAlE}
\integer{ae=\AE+\AAlE}
\integer{ale=\AlE+\AAlE}
\text{instruction=
Sur les \N élèves d'un lycée, \Ang suivent des cours d'anglais,
\All ceux d'allemand, \Esp ceux d'espagnol. Parmi eux,
\ae apprennent au moins l'anglais et l'espagnol, \aa apprennent au moins l'anglais
et l'allemand et \ale apprennent au moins
l'allemand et l'espagnol.
Enfin, \AAlE d'entre eux apprennent les trois langues.
}
\matrix{question=Combien n'apprennent aucune de ces trois langues
Combien d'élèves font uniquement de l'anglais et de l'espagnol}
\matrix{label=Aucune de ces langues
Anglais et espagnol uniquement}
\if{\lang=it}{
\title_it{C4 - Ripartizione degli studenti in opzioni}
\text{instruction=
Su \N studenti di un liceo, \Ang seguono corsi di inglese,
\All quelli di tedesco, \Esp quelli di spagnolo. Tra loro,
\ae studiano almeno l'inglese e lo spagnolo, \aa studiano almeno l'inglese e il tedesco e \ale studiano almeno
il tedesco e lo spagnolo.
Infine, \AAlE tra loro studiano tutte e tre le lingue.
}
\matrix{question=Quanti non studiano nessuna di queste tre lingue
Quanti studenti fanno unicamente inglese e spagnolo}
\matrix{label=Nessuna delle lingue
Unicamente inglese e spagnolo}
}
\if{\lang=es}{
\title_es{C4 - Distribución de estudiantes en opciones}
\text{instruction=
De los \N alumnos de un liceo, \Ang siguen los cursos de inglés,
\All siguen los de alemán, \Esp los de español. Entre ellos,
\ae estudian al menos inglés y español, \aa estudian al menos inglés y alemán y \ale estudian al menos alemán y español.
Finalmente, \AAlE de ellos estudian las tres lenguas.
}
\matrix{question= Cuántos no estudian ninguna de esas tres lenguas
 Cuántos estudiantes estudian solamente inglés y español }
\matrix{label=Ninguna de esas lenguas
Solamente inglés y español}
}
