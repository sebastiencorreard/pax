!set title=C4 - Répartition d'élèves dans des options
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=combinatorics,set_theory
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
oefdescription=exercice de dénombrement
oefobservation=Les chiffres dans l'énoncé sont les seules données variables.
language=fr
computeanswer=no
precision=10000
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
title_it=C4 - Ripartizione degli studenti in opzioni
title_es=C4 - Distribución de estudiantes en opciones

ansorder=r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 100, 200

val7=$[rint($(tmp0))]
tmp0=!randint 50, 150

val8=$[rint($(tmp0))]
tmp0=!randint 100, 150

val9=$[rint($(tmp0))]
tmp0=!randint 5, 20

val10=$[rint($(tmp0))]
tmp0=!randint 100, 500

val11=$[rint($(tmp0))]
tmp0=!randint 50, 300

val12=$[rint($(tmp0))]
tmp0=!randint 50, 100

val13=$[rint($(tmp0))]
val14=$[rint($val7+$val11+$val12+$val10+$val9+$val8+$val13)]
tmp0=!randint 10, 50

val15=$[rint($(tmp0))]
val16=$[rint($val15+$val14)]
val17=$[rint($val7+$val11+$val12+$val10)]
val18=$[rint($val9+$val11+$val13+$val10)]
val19=$[rint($val8+$val13+$val12+$val10)]
val20=$[rint($val12+$val10)]
val21=$[rint($val11+$val10)]
val22=$[rint($val13+$val10)]
val23=Sur les $val16 élèves d'un lycée, $val17 suivent des cours d'anglais,	$val19 ceux d'allemand, $val18 ceux d'espagnol. Parmi eux,	$val21 apprennent au moins l'anglais et l'espagnol, $val20 apprennent au moins l'anglais	et l'allemand et $val22 apprennent au moins	l'allemand et l'espagnol.	Enfin, $val10 d'entre eux apprennent les trois langues.	
tmp=!trim Combien n'apprennent aucune de ces trois langues	Combien d'élèves font uniquement de l'anglais et de l'espagnol
val24=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Aucune de ces langues	Anglais et espagnol uniquement
val25=!translate internal $	\
$ to ;; in $tmp
!if $val6=it 
val23=Su $val16 studenti di un liceo, $val17 seguono corsi di inglese,	$val19 quelli di tedesco, $val18 quelli di spagnolo. Tra loro,	$val21 studiano almeno l'inglese e lo spagnolo, $val20 studiano almeno l'inglese e il tedesco e $val22 studiano almeno	il tedesco e lo spagnolo.	Infine, $val10 tra loro studiano tutte e tre le lingue.	
tmp=!trim Quanti non studiano nessuna di queste tre lingue	Quanti studenti fanno unicamente inglese e spagnolo
val24=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Nessuna delle lingue	Unicamente inglese e spagnolo
val25=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val6=es 
val23=De los $val16 alumnos de un liceo, $val17 siguen los cursos de inglés,	$val19 siguen los de alemán, $val18 los de español. Entre ellos,	$val21 estudian al menos inglés y español, $val20 estudian al menos inglés y alemán y $val22 estudian al menos alemán y español.	Finalmente, $val10 de ellos estudian las tres lenguas.	
tmp=!trim Cuántos no estudian ninguna de esas tres lenguas	 Cuántos estudiantes estudian solamente inglés y español 
val24=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Ninguna de esas lenguas	Solamente inglés y español
val25=!translate internal $	\
$ to ;; in $tmp
!endif
replyname1=$(val25[1;])
replygood1=$val15
replyname2=$(val25[2;])
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="color1">	$val23</div>	<div class="wims_question">	<ol><li>	  $(val24[1;])	   
