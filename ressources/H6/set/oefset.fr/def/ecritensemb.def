val10=$(tmp0)
tmp0=!item $val7 of  $val9

val11=$(tmp0)
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
val13=\(A\) ,\(B\) ,\(A^c\) ,\(B^c\) ,\(\cup\),\(\cap\)
tmp=!trim l'événement $val10 est réalisé	$val10 n'est pas réalisé	au moins un des deux événements est réalisé	parmi les 2 événements&#44; seul l'événément $val10 est réalisé	les événéments $val10 et $val11 sont réalisés	aucun des 2 événements n'est réalisé	$val11 est réalisé ou $val10 n'est pas réalisé	au moins un des deux événements n'est pas réalisé	ni \($val10)&#44; ni \($val11) n'est réalisé
val14=!translate internal $	\
$ to ;; in $tmp
val15=On désigne par \(\A\) et \(\B\) deux événements qui	peuvent se réaliser au cours de cette expérience. Par abus de notations,	\(\A\) et \(\B\) désignent aussi les parties de \({\Omega}\) qui décrivent ces événements.	
val16=Quelle est l'écriture ensembliste de l'événement \(F\) suivant&nbsp;
val17=<b>Remarque :</b> l'écriture la plus simple de l'événement \(F\) est
!if $val6=it 
tmp=!trim l'evento $val10 si è verificato	$val10 non si è verificato	almeno uno de due eventi si è verificato	tra i 2 eventi&#44; solo l'evento $val10 si è verificato	gli eventi $val10 e $val11 si sono verificati	nessuno dei 2 eventi si è verificato	$val11 si è verificato o $val10 non si è verificato	almeno uno dei due eventi non si è verificato	né \($val10)&#44; né \($val11) si è verificato
val14=!translate internal $	\
$ to ;; in $tmp
val15=Si indicano con \(\A\) e \(\B\) due eventi che possono verificarsi nel corso di questo esperimento. Con abuso di notazione,	\(\A\) e \(\B\) indicano anche le parti di \({\Omega}\) che descrivono questi eventi.	
val16=Qual è la scrittura insiemistica dell'evento \(F\) seguente
val17=<b>Nota:</b> la scrittura più semplice dell'evento \(F\) è
!endif
!if $val6=es 
tmp=!trim el evento $val10 sí ocurre	$val10 no ocurre	al menos uno de los dos eventos ocurre	entre los dos eventos&#44; solo el evento $val10 ocurre	los eventos $val10 y $val11 ocurren	ninguno de los 2 eventos ocurre	$val11 ocurre o $val10 no ocurre	al menos uno de los eventos no ocurre	ni \($val10)&#44; ni \($val11) ocurren
val14=!translate internal $	\
$ to ;; in $tmp
val15=Denotamos por \(\A\) y \(\B\) dos eventos que pueden ocurrir en el transcurso de esta experiencia. Abusando de la notación,	\(\A\) y \(\B\) también denotan los subconjuntos de \({\Omega}\) que describen esto eventos.	
val16=¿Cuál es la escritura como conjunto del siguiente evento \(F\) 
val17=<b>Nota:</b> la escritura más simple de \(F\) es
!endif
tmp=!trim $(val14[1;]), \($val10\)|\($val10\),\(\cup\),\($val10\)|\($val10\),\(\cap\),\($val10\)	$(val14[2;]),\($val10^c\)| \($val10^c\),\(\cap\),\($val10^c\) | \($val10^c\),\(\cup\),\($val10^c\)	$(val14[3;]),\(A\), \(\cup\),\(B\) | \(B\),\(\cup\),\(A\)	$(val14[4;]),\($val10\),\(\cap\),\($val11^c\) |\($val11^c\),\(\cap\),\($val10\)	$(val14[5;]), \($val10\),\(\cap\),\($val11\)|\($val11\),\(\cap\),\($val10\)	$(val14[6;]),\(A^c\),\(\cap\),\(B^c\)|\(B^c\),\(\cap\),\(A^c\)	$(val14[7;]), \($val10^c\),\(\cup\),\($val11\) | \($val11\),\(\cup\),\($val10^c\)	$(val14[8;]),\($val10^c\),\(\cup\),\($val11^c\)|\($val11^c\),\(\cup\),\($val10^c\)	$(val14[9;]),\($val10^c\),\(\cap\),\($val11^c\) | \($val11^c\),\(\cap\),\($val10^c\)
