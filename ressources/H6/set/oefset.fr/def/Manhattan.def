!set title=C5 - Distance de Manhattan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sophie, Lemaire
email=sophie.lemaire@universite-paris-saclay.fr
computeanswer=yes
oefdescription=exercice de modélisation comportant deux questions dont une de dénombrement.
oefobservation=exercice de dénombrement d'un ensemble de chemins. Un codage des chemins est suggéré dans un feedback.
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
precision=100000
title_it=C5 - Distanze a Manhattan
title_es=C5 - Distancia en Manhattan

ansorder=r,r
varcnt=66
prevarcnt=52
postvarcnt=13
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=4
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 50

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 50

val9=$[rint($(tmp0))]
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
tmp0=!randitem 0,1

val11=$[rint($(tmp0))]
tmp0=!randitem 0,1

val12=$[rint($(tmp0))]
val13=$[rint($val9+$val10)]
val14=$[rint($val7+$val8)]
!if $val12=0 
val15=$[rint($val9*10)]
val16=$[rint($val13*10)]
val17=+
!else
val15=$[rint($val13*10)]
val16=$[rint($val9*10)]
val17=-
!endif
val18=+
!if $val11=1 
val19=$[rint($val7)]
val7=$[rint($val14)]
val14=$[rint($val19)]
val18=-
!endif
val20=$[rint($val8+$val10)]
val21=$[rint(binomial($val20,$val8))]
val22=$[rint($val15+10)]
val23=$[rint($val7-1)]
val24=On suppose que les avenues de Manhattan sont quadrillées de telle sorte que le taxi peut	changer d'avenue tous les 10 numéros et on suppose que le compteur du taxi avance	d'un dollar à chaque croisement.
val25=Combien coûtera la course si le taxi est honnête&nbsp;
val26=Combien de fois le taxi peut-il faire cette course sans emprunter le même trajet	(en supposant toujours que le chauffeur est honnête)&nbsp;
val27=Une personne se trouve au numéro $val15 de la $val7 ème avenue
val28=Il désire prendre un taxi pour se rendre au numéro $val16 de la $val14 ème avenue
val29=Avec 2 dollars, le taxi pourra par exemple vous amener du numéro $val15	de la $val7 ème avenue au numéro $val22 de la $val23 ème avenue.
val30=<b>Indication</b> : Un trajet peut être codé en utilisant uniquement les	symboles 0 et 1 (à vous de dire comment) ; l'ensemble des trajets est	alors représenté par un sous-ensemble de \(\{0,1\}^$val20\).	Il suffit d'écrire explicitement ce sous-ensemble, puis de déterminer son cardinal.
tmp=!trim Coût (en dollars)	Nb de parcours différents
val31=!translate internal $	\
$ to ;; in $tmp
val32=Bonne réponse ! La course coûtera $val20 dollars.
!if $val6=it 
val24=Si suppone che le strade di Manhattan formino una griglia quadrettata in modo tale che il taxi possa	cambiare strada ogni 10 numeri e si suppone che il tassametro del taxi avanzi di un dollaro ad ogni	incrocio.
val25=Quanto costerà la corsa se il tassista è onesto
val26=Quante volte il taxi può fare questa corsa senza imboccare lo stesso tragitto (supponendo sempre che il tassista sia onesto)
val27=Una persona si trova al numero $val15 della $val7-esima avenue
val28=Desidera prendere un taxi per recarsi al numero $val16 della $val14-esima avenue
val29=Con 2 dollari, il taxi vi potrebbe portare, per esempio, dal numero $val15 della $val7 -esima avenue al numero $val22 della $val23 -esima avenue.
val30=<b>Suggerimento</b>: Un tragitto può essere codificato utilizzando unicamente i simboli 0 e 1 (sta a voi dire come); l'insieme dei tragitti è allora rappresentato da un sottoinsieme di \(\{0,1\}^$val20\). È sufficiente scrivere esplicitamente questo sottoinsieme per poi determinare la sua cardinalità.
tmp=!trim Costo (in dollari)	Numero di percorsi differenti
val31=!translate internal $	\
$ to ;; in $tmp
val32=Risposta corretta! La corsa costerà $val20 dollari.
!endif
!if $val6=es 
val24=Supongamos que las avenidas de Manhattan forman una grilla cuadrada de modo que el taxi puede cambiar de avenida cada 10 números. Supongamos además que el taxímetro del taxi aumenta en un dólar en cada cruce.
val25=¿Cuánto costará la carrera si el taxista es honesto
val26=¿Cuántas veces puede el taxi hacer esta carrera sin tomar la misma ruta (siempre suponiendo que el taxista es honesto)
val27=Una persona se encuentra en el número $val15 de la $val7-ésima avenida
val28=Esta persona desea tomar un taxi para llegar al número $val16 de la $val14-ésima avenida
val29=Con 2 dólares, el taxi podría, por ejemplo, llevar a la persona del número $val15 de la $val7-ésima avenida al número $val22 de la $val23-ésima avenida.
val30=<b>Indicación</b>: Un trayecto puede ser codificado utilizando solamente los símbolos 0 y 1 (usted debe determinar cómo); el conjunto de trayectos se puede entonces representar como un subconjunto de \(\{0,1\}^$val20\). Basta escribir explícitamente este subconjunto, y luego determinar su cardinal.
tmp=!trim Costo (en dólares)	Número de trayectos diferentes
val31=!translate internal $	\
$ to ;; in $tmp
val32=Respuesta correcta! La carrera costará $val20 dólares.
!endif
!readproc oef/draw.phtml 190,190 \
frect 10,10,60,60,gray	frect 70,10,120,60,gray	frect 130,10,180,60,gray	frect 10,70,60,120,gray	frect 70,70,120,120,gray	frect 130,70,180,120,gray	frect 10,130,60,180,gray	frect 70,130,120,180,gray	frect 130,130,180,180,gray	fcircle 70,70,5,red	fcircle 130,130,5,green	text black, 10,60,,avenue $val7	text black, 75,65,, $val15	text black, 10,120,,avenue $val23	text black, 135,125,, $val22 
tmp0=$ins_url
val33=$(tmp0)
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=numeric
replyname1=1- $(val31[1;])
replygood1=$[$val20]
replytype2=numeric
replyname2=2- $(val31[2;])
replygood2=?analyze 34
