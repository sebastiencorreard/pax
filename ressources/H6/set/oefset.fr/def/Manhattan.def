:postdef
t_=!replace internal \( by ( in if($val34-$val21,0,1)
tmp0=!exec pari $t_

val35=$[rint($(tmp0))]
val36=$[$m_reply1-floor($m_reply1)]
val37=$[rint($val7$val18 min($m_reply1,$val8))]
val38=$[rint($val15 $val17 10*max($m_reply1-$val8,0))]
val39=Avec $m_reply1 dollars, vous pouvez aller jusqu'au numéro	$val38 de la $val14 ème avenue (si ce numéro existe !).
val40=Avec $m_reply1 dollars, vous ne pouvez aller que	jusqu'au numéro $val38 de la $val37 ème avenue.
tmp=!trim 2- Bonne réponse ! Il y a $val21 trajets différents pour faire cette course.	2- Votre réponse est incorrecte. Il y a $val21 trajets différents pour faire cette course.
val41=!translate internal $	\
$ to ;; in $tmp
!if $val6=it 
val39=Con $m_reply1 dollari potete andare fino al numero $val38 della $val14-esima avenue (se questo indirizzo esiste !).
val40=Con $m_reply1 dollari potete arrivare solo al numero $val38 della $val37-esima avenue.
tmp=!trim 2- Risposta corretta! Ci sono $val21 tragitti differenti per fare questa corsa.	2- La risposta è sbagliata. Ci sono $val21 tragitti differenti per fare questa corsa.
val41=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val6=es 
val39=Con $m_reply1 dólares, puede llegar hasta el número $val38 de la $val14-ésima avenida (si es que ese número existe !).
val40=Con $m_reply1 dólares, puede llegar solamente hasta el número $val38 de la $val37-ésima avenida.
tmp=!trim 2- Respuesta correcta! Hay $val21 trayectos diferentes para hacer esta carrera.	2- Su respuesta es incorrecta.  Hay $val21 trayectos diferentes para hacer esta carrera.
val41=!translate internal $	\
$ to ;; in $tmp
!endif

!exit

