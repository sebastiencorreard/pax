!set title=A1 - Description des éléments d'un ensemble
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=set_theory
author=Sophie, Lemaire; Bernadette, Perrin-Riou
email=sophie.lemaire@universite-paris-saclay.fr,bernadette.m.riou@orange.fr
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
oefdescription=exercice permettant de se familiariser avec les notations ensemblistes.
language=fr
computeanswer=no
title_it=A1 - Descrizione degli elementi di un insieme
title_es=A1 - Descripción de los elementos de un conjunto

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit \(A\), \(B\) et \(C\) trois ensembles.
val8=Faire correspondre les affirmations équivalentes.
!if $val6=it 
val7=Siano \(A\), \(B\) e \(C\) tre insiemi.
val8=Far corrispondere le affermazioni equivalenti.
!endif
!if $val6=es 
val7=Sean \(A\), \(B\) y \(C\) tres conjuntos.
val8=Haga corresponder afirmaciones equivalentes.
!endif
val9=3
tmp0=!record $val9 of tableau.$val6

tmp=!trim $(tmp0)
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!record 2 of tableau.$val6

tmp=!trim $(tmp0)
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
val12=$(tmp0)
val13=4
tmp0=!shuffle $val12

tmp1=!item 1 to $val13 of  $(tmp0)

val14=$(tmp1)
tmp0=!shuffle A,B,C

val15=$(tmp0)
val16=$(val10[$val14;1]) 
val17=$(val11[$val14;1]) 
tmp0=!replace internal XXX by \($(val15[1])\) in $val16

val16=$(tmp0)
tmp0=!replace internal YYY by \($(val15[2])\) in $val16

val16=$(tmp0)
tmp0=!replace internal ZZZ by \($(val15[3])\) in $val16

val16=$(tmp0)
tmp0=!replace internal XXX by $(val15[1]) in $val17

val17=$(tmp0)
tmp0=!replace internal YYY by $(val15[2]) in $val17

val17=$(tmp0)
tmp0=!replace internal ZZZ by $(val15[3]) in $val17

val17=$(tmp0)
tmp0=!replace internal uuu by \(x\) in $val16

val16=$(tmp0)
tmp0=!makelist x \in S for S in $val17

val17=$(tmp0)
!for val18  = 1 to $val13 
tmp0=!replace internal item number $val18 by \($(val17[$val18])\) in $val17

val17=$(tmp0)
!next
tmp0=!record 1 of notations.$val6

val19=$(tmp0)
tmp0=!record 3 of notations.$val6

tmp1=!record 4 of notations.$val6

tmp2=!record 5 of notations.$val6

val20=$(tmp0) $(tmp1) $(tmp2)
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$val16;$val17
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst $val19


!goto stat

!exit

:question
$()		$val7	<div class="wims_question">		$val8		<div class="wimscenter"> 
!read oef/embed.phtml reply 1,90 x 230 x 320 
$()</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()$val19
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,19
embedcnt=1
