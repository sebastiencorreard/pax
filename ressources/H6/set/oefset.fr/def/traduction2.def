!set title=A2 - Ensembles : description mathématique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=set_theory
author=Sophie, Lemaire; Bernadette, Perrin-Riou
email=sophie.lemaire@universite-paris-saclay.fr,bernadette.m.riou@orange.fr
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
oefdescription=exercice permettant de se familiariser avec les notations ensemblistes.
language=fr
computeanswer=no
title_it=A2 - Insiemi: descrizione formale
title_es=A2 - Conjuntos: descripción formal

ansorder=r
varcnt=31
prevarcnt=30
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Soit \(A\), \(B\) et \(C\) trois ensembles.
val8=La colonne de droite contient les descriptions des éléments	 de quatre ensembles différents. Lesquels&nbsp;
val9=Associer l'ensemble correspondant à chaque description.
!if $val6=it 
val7=Siano \(A\), \(B\) e \(C\) tre insiemi.
val8=La colonna di destra contiene le scritture formali di quattro insiemi diversi. Quali
val9=Associare gli insiemi corrispondenti a ciascuna descrizione.
!endif
!if $val6=es 
val7=Sean \(A\), \(B\) y \(C\) tres conjuntos.
val8=La columna de la derecha contiene la descripción formal de los elementos de cuatro conjuntos diferentes ¿Cuáles son
val9=Asociar el conjunto correspondiente a cada descripción.
!endif
val10=3
tmp0=!record $val10 of tableau.$val6

tmp=!trim $(tmp0)
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!record 2 of tableau.$val6

tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
val13=$(tmp0)
val14=4
tmp0=!shuffle $val13

tmp1=!item 1 to $val14 of  $(tmp0)

val15=$(tmp1)
tmp0=!shuffle A,B,C

val16=$(tmp0)
val17=$(val11[$val15;1]) 
val18=$(val12[$val15;1]) 
tmp0=!replace internal XXX by \($(val16[1])\) in $val17

val17=$(tmp0)
tmp0=!replace internal YYY by \($(val16[2])\) in $val17

val17=$(tmp0)
tmp0=!replace internal ZZZ by \($(val16[3])\) in $val17

val17=$(tmp0)
tmp0=!replace internal XXX by $(val16[1]) in $val18

val18=$(tmp0)
tmp0=!replace internal YYY by $(val16[2]) in $val18

val18=$(tmp0)
tmp0=!replace internal ZZZ by $(val16[3]) in $val18

val18=$(tmp0)
tmp0=!replace internal uuu by \(x\) in $val17

val17=$(tmp0)
!for val19  = 1 to $val14 
tmp0=!replace internal item number $val19 by \($(val18[$val19])\) in $val18

val18=$(tmp0)
!next
tmp0=!record 1 of notations.$val6

val20=$(tmp0)
tmp0=!record 3 of notations.$val6

tmp1=!record 4 of notations.$val6

tmp2=!record 5 of notations.$val6

val21=$(tmp0) $(tmp1) $(tmp2)
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$val17;$val18
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst $val20


!goto stat

!exit

:question
$()		$val7	<div class="wims_question">		$val8?<br>	$val9		<div class="wimscenter"> 
!read oef/embed.phtml reply 1,90 x 230 x 320 
$()</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()$val20
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,20
embedcnt=1
