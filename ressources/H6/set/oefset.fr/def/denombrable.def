!set title=E1 - Dénombrabilité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=set_theory
author=Mounir, Mensi
email=mounirmensi@yahoo.fr
oefdescription=exercice de type QCM sur la définition d'ensembles dénombrables.
oefobservation=La question porte sur un ensemble simple choisi parmi 13 ensembles.
language=fr
leftrange=1.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_it=E1 - Numerabilità
title_es=E1 - Numerabilidad

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim \NN,\NN^\ast,\QQ,\ZZ,\{1/n; n\in\NN^\ast \},\{\frac{1}{n m}; (n,m)\in\NN^\ast\times\NN^\ast\},\NN^2,\ZZ^2	\displaystyle{\lbrack 0, 1 \rbrack}, \RR,\{0, 1\}^{\NN},\RR_{+},\displaystyle{\lbrack 0, 1 \rbrack^2}	
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val8=$(tmp0)
tmp=!nonempty items $(val7[$val8;])

tmp0=!randitem $tmp
val9=$(tmp0)
val10=L'ensemble \($val9\) est-il dénombrable&nbsp;
val11=oui,non
!if $val6=it 
val10=L'ensemble \($val9\) est-il dénombrable&nbsp;
val11=oui,non
!if $val6=it 
val10=L'insieme \($val9\) è numerabile
val11=sì,no
!endif
!endif
!if $val6=es 
val10=L'ensemble \($val9\) est-il dénombrable&nbsp;
val11=oui,non
!if $val6=es 
val10=¿Es el conjunto \($val9\) numerable
val11=sí,no
!endif
!endif
replytype1=radio
replyname1=
replygood1=$val8;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10?	<div class="wimscenter">  
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=1
