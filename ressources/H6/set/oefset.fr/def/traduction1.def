!set title=D2 - Associer événements et ensembles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=set_theory,events
author=Sophie, Lemaire; Bernadette, Perrin-Riou
email=sophie.lemaire@universite-paris-saclay.fr,bernadette.m.riou@orange.fr
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
oefdescription=exercice permettant de se familiariser avec la description ensembliste d'un événement.
oefobservation=Les événements sont décrits à partir d'opérations sur au plus 3 ensembles.
language=fr
computeanswer=no
title_it=D2 - Associare eventi e insiemi
title_es=D2 - Asociar eventos y conjuntos

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Mettre en correspondance les formulations probabilistes équivalentes.
!if $val6=it 
val7=Mettere in corrispondenza le formulazioni probabilistiche qui sotto.
!endif
!if $val6=es 
val7=Haga corresponder formulaciones probabilistas equivalentes.
!endif
val8=1
tmp0=!record $val8 of tableau.$val6

tmp=!trim $(tmp0)
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!record 2 of tableau.$val6

tmp=!trim $(tmp0)
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val9

tmp0=!rowcnt $tmp
val11=$(tmp0)
val12=4
tmp0=!shuffle $val11

tmp1=!item 1 to $val12 of  $(tmp0)

val13=$(tmp1)
tmp0=!shuffle A,B,C

val14=$(tmp0)
val15=$(val9[$val13;1]) 
val16=$(val10[$val13;1]) 
tmp0=!replace internal XXX by \($(val14[1])\) in $val15

val15=$(tmp0)
tmp0=!replace internal YYY by \($(val14[2])\) in $val15

val15=$(tmp0)
tmp0=!replace internal ZZZ by \($(val14[3])\) in $val15

val15=$(tmp0)
tmp0=!replace internal XXX by $(val14[1]) in $val16

val16=$(tmp0)
tmp0=!replace internal YYY by $(val14[2]) in $val16

val16=$(tmp0)
tmp0=!replace internal ZZZ by $(val14[3]) in $val16

val16=$(tmp0)
!for val17  = 1 to $val12 
tmp0=!replace internal item number $val17 by \($(val16[$val17])\) in $val16

val16=$(tmp0)
!next
tmp0=!record 1 of notations.$val6

val18=$(tmp0)
tmp0=!record 3 of notations.$val6

tmp1=!record 4 of notations.$val6

tmp2=!record 5 of notations.$val6

val19=$(tmp0) $(tmp1) $(tmp2)
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst $val18


!goto stat

!exit

:question
$()		<div class="color1">	$val19	</div>	<div class="wims_question">	$val7		<div class="wimscenter"> 
!read oef/embed.phtml reply 1,90 x 230 x 320 
$()</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()$val18
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,18,19
embedcnt=1
