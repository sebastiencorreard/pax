tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Soit \(\A\) un sous-ensemble d'un ensemble \(E\) et soit \(\B\) un sous-ensemble d'un ensemble \(F\)	Soient \(\A\) et \(\B\) deux sous-ensembles d'un ensemble \(E\)
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Donner l'expression de la fonction indicatrice de l'ensemble	au point	en notant	
val8=!translate internal $	\
$ to ;; in $tmp
val9=Par définition, \(1_A\) est alors une fonction à valeurs dans	\(\{0,1\}\) définie sur \(\Omega\) par \(1_{A}(x) = 1 \)	si et seulement si \( x\in A \).
!if $val6=it 
tmp=!trim Sia \(\A\) un sottoinsieme di un insieme \(E\) e sia \(\B\) un sottoinsieme di un insieme \(F\)	Siano \(\A\) e \(\B\) due sottoinsiemi di un insieme \(E\)
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Dare l'espressione della funzione indicatrice dell'insieme	nel punto	indicando	
val8=!translate internal $	\
$ to ;; in $tmp
val9=Sotto tali ipotesi, \(1_A\) è una funzione da \(\Omega\) a valori in \(\{0,1\}\) definita in questo modo: \(1_{A}(x) = 1 \) se e soltanto se \( x\in A \). In altre parole \(1_{A}(x) = 0\) se e soltanto se \( x\in \Omega \setminus A \).
!endif
!if $val6=es 
tmp=!trim Sea \(\A\) un subconjunto de un conjunto \(E\) y sea \(\B\) un subconjunto de un conjunto \(F\)	Sean \(\A\) y \(\B\) dos subconjuntos de un conjunto \(E\)
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Entregue la expresión de la función indicatriz del conjunto	en el punto	escribiendo	
val8=!translate internal $	\
$ to ;; in $tmp
val9=Por definición, \(1_A\) es una función de \(\Omega\) en \(\{0,1\}\) definida como: \(1_{A}(x) = 1 \) si y solamente si \( x\in A \). Dicho de otro modo, \(1_{A}(x) = 0\) si y solamente si \( x\in \Omega \setminus A \).
!endif
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

val12=$[rint($(tmp0))]
tmp0=!item $val12 of \cup,\cap,\times

val13=$(tmp0)

!ifval $val10=1
val14= a
!else
val14= (1-a)
!endif

!ifval $val11=1
val15= b
!else
val15= (1-b)
!endif

!ifval $val12=1
val16= $val14 + $val15 - $val14*$val15
!endif

!ifval $val12=2
val16= $val14*$val15
!endif

!ifval $val12=3
val16= $val14*$val15
!endif

!ifval $val12=3 
val17= $(val7[1;])
!else
val17=$(val7[2;])
!endif
!if $val11=1 

!ifval $val10=1
val18= A $val13 B
!else
val18= A^c $val13 B
!endif
!else

!ifval $val10=1
val18= A $val13 B^c
!else
val18= A^c $val13 B^c
!endif
!endif
tmp0=!replace internal a by \(1_A(x)\) in $val16

val19=$(tmp0)
!if $val12=3 
val20=y
val21=(x,y)
tmp0=!replace internal b by \(1_B(y)\) in $val19

val19=$(tmp0)
!else
val20=x
val21=x
tmp0=!replace internal b by \(1_B(x)\) in $val19

val19=$(tmp0)
!endif
tmp0=!replace internal * by in $val19

