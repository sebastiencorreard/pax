$()<div class="color1">$(val7[1;]):	<ul><li>
!insmath A
$() = {$val19}</li>	    <li> 
!insmath B
$() = {$val20} </li></ul>	</div>	<div class="wims_question">	$(val7[2;]):	<ul>  
