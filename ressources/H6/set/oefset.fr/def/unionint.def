val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 30, 48

val7=$[rint($(tmp0))]
tmp0=!randitem 2,3,5

val8=$[rint($(tmp0))]
tmp0=!randitem 2,3,5

val9=$[rint($(tmp0))]
val10=$[rint($val9*$val8)]
tmp0=!randitem 2,3,4,5,7

val11=$[rint($(tmp0))]

!ifval \r%$val8=0 or \r%$val9 =0 
val12=$[rint( 7)]
!else
val12=$[rint($val11)]
!endif
val13=
val14=$[rint(floor($val7/$val8))]
!for val15 =1 to $val14 
val16=$[rint($val15*$val8)]
val13=$val13,$val16
!next
val17=
!for val15  in $val13 

!ifval $val15%$val10=0
val16= $val15
!else
val16=NNN
!endif

!ifval $val16 notsametext NNN 
val17=$val17,$val16
!endif
!next
tmp0=!nonempty items $val17

val17=$(tmp0)
val18=
!for val15  in $val13 

!ifval $val15%$val12=0
val16= $val15
!else
val16=NNN
!endif

!ifval $val16 notsametext NNN 
val18= $val18,$val16
!endif
!next
tmp0=!nonempty items $val18

val18=$(tmp0)
val19=$[rint(1)]
tmp0=!item $val19 of ($val17),($val18)

val20=$(tmp0)
tmp0=!declosing $val20

val20=$(tmp0)
tmp0=!item 3-$val19 of ($val17),($val18)

val21=$(tmp0)
tmp0=!declosing $val21

val21=$(tmp0)
tmp0=!listintersect $val20 and $val21

val22=$(tmp0)
tmp0=!listunion $val20 and $val21

val23=$(tmp0)
tmp0=!listcomplement $val22 in $val13

val24=$(tmp0)
tmp0=!listcomplement $val23 in $val13

val25=$(tmp0)
tmp0=!listcomplement $val20 in $val13

val26=$(tmp0)
tmp0=!listcomplement $val21 in $val13

val27=$(tmp0)
tmp0=!listcomplement $val21 in $val20

val28=$(tmp0)
tmp0=!listcomplement $val20 in $val21

val29=$(tmp0)
tmp0=!listcomplement $val22 in $val23

val30=$(tmp0)
tmp0=!listunion $val26 and $val27

val31=$(tmp0)
tmp=!trim de la réunion du complémentaire de \(A) dans \(S) et du complémentaire de \(B) dans \(S)	de la différence \(A - B)	de la différence \(B - A)	de la différence symétrique de \(A) et de \(B)	de la réunion de \(A) et de \(B)	de l'intersection de \(A) et de \(B)	du complémentaire de l'intersection de \(A) et de \(B) dans \(S)	du complémentaire de la réunion de \(A) et de \(B) dans \(S)	
val32=!translate internal $	\
$ to ;; in $tmp
val33=Soit \(S\) l'ensemble des entiers de 1 à $val7 multiples de $val8.	Soit \(A) le sous-ensemble de \(S\) formé des multiples de $val10 et \(B)	le sous-ensemble de \(S) formé des multiples de $val12.	
val34=Donner explicitement la liste \(C\) des éléments 
val35=Si \(C\) est vide, écrire 0.
!if $val6=it 
tmp=!trim dell'unione del complementare di \(A) in \(S) e del complementare di \(B) in \(S)	della differenza \(A - B)	della differenza \(B - A)	della differenza simmetrica di \(A) e \(B)	dell'unione di \(A) e \(B)	dell'intersezione di \(A) e \(B)	del complementare dell'intersezione di \(A) e \(B) in \(S)	del complementare dell'unione di \(A) e \(B) in \(S)	
val32=!translate internal $	\
$ to ;; in $tmp
val33=Sia \(S\) l'insieme degli interi da 1 a $val7 multipli di $val8.	Sia \(A) il sottoinsieme di \(S\) formato dai multipli di $val10 e \(B)	il sottoinsieme di \(S) formato dai multipli di $val12.	
val34=Dare esplicitamente la lista \(C\) degli elementi 
val35=Se \(C\) è vuoto, scrivere 0.
!endif
!if $val6=es 
tmp=!trim de la unión del complemento de \(A) en \(S) y del complemento de \(B) en \(S)	de la diferencia \(A - B)	de la diferencia \(B - A)	de la diferencia simétrica de \(A) y \(B)	de la unión de \(A) y \(B)	de la intersección de \(A) y \(B)	del complemento de la intersección de \(A) y \(B) en \(S)	del complemento de la unión de \(A) y \(B) en \(S)	
val32=!translate internal $	\
$ to ;; in $tmp
val33=Sea \(S\) el conjunto de enteros entre 1 y $val7 que son múltiplos de $val8.	Sea \(A) el subconjunto de \(S\) formado por múltiplos de $val10 y \(B)	el subconjunto de \(S) formado por múltiplos de $val12.	
val34=Entregue explícitamente la lista \(C\) de los elementos 
val35=Si \(C\) es vacío, escribir 0.
!endif
tmp=!trim $(val32[1;]), $val31	$(val32[2;]), $val28	$(val32[3;]), $val29	$(val32[4;]), $val30	$(val32[5;]), $val23	$(val32[6;]), $val22	$(val32[7;]), $val24	$(val32[8;]),$val25	
val36=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val36

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val37=$(tmp0)
tmp0=!item 1 of $val37

val38=$(tmp0)
tmp0=!itemcnt $val37

val39=$[rint($(tmp0))]
tmp0=!item 2 to -1 of $val37

val40=$(tmp0)

!ifval $val39>1 
val41= $val40
!else
val41=0
!endif
tmp0=!sort numeric item $val41

val41=$(tmp0)
replytype1=set
replyname1=\(C\)
replygood1=$val41
question=__EXECUTED_1692754_EXERCISE__

