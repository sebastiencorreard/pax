!set title=B2 - Ensembles de multiples
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=set_theory
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
oefdescription=il s'agit de décrire trouver les éléments d'un ensemble à partir de sa description.
oefobservation=Exercice sur la réunion, l'intersection et la différence de 2 ensembles.
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
oefcss=<style> .color1 {color:#000080;} .color2 {color:#008000;} </style>
title_it=B2 - Insiemi di multipli
title_es=B2 - Conjuntos de múltiplos

ansorder=r
