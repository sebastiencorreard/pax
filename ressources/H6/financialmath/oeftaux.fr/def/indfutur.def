!set title=Indice simple futur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Sénéchal
email=ericsen@wanadoo.fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 200

val6=$[$(tmp0)]
tmp0=!randint -$val6/2, $val6/2

val7=$[$val6+$(tmp0)]
val8=$[100*$val7/$val6]
val9=Un article coûtait $val6 euros l'an dernier dans un magasin. Cette année, il coûte $val7 euros.	Si on attribue l'indice 100 à l'année dernière, quel est l'indice de cette année ?
tmp0=!embraced randitem $val9

val9=$(tmp0)
replytype1=numeric
replyname1=Ma réponse
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=0
