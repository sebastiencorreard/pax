!set title=Evolution globale
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Sénéchal
email=ericsen@wanadoo.fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 20

val6=$[$(tmp0)]
tmp0=!randint 5, 20

val7=$[$(tmp0)]
val8=$[((1+$val6/100)*(1-$val7/100)-1)*100]
val9=Un vêtement de mode a augmenté de $val6 % depuis l'an dernier dans un magasin mais, pendant la période des soldes, le magasin affichera une baisse de $val7 % sur cet article. Quel sera alors son taux d'évolution global (en %) ?
tmp0=!embraced randitem $val9

val9=$(tmp0)
replytype1=numeric
replyname1=Ma réponse
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=0
