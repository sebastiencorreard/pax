!set title=Capital actualisé
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Eric, Sénéchal
email=ericsen@wanadoo.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 20

val6=$[$(tmp0)*500]
tmp0=!randint 2, 20

val7=$[$(tmp0)]
tmp0=!randint 1, 7

val8=$[$(tmp0)]
val9=$[rint($val6/(1+$val8/100)^$val7)]
val10=Je désire disposer dans $val7 années d'un capital de $val6 euros. Sachant qu'on me propose un taux d'intérêts composés annuel de $val8 %, quel est le capital que je dois placer aujourd'hui ? On donnera ce capital actualisé arrondi à l'euro près.
tmp0=!embraced randitem $val10

val10=$(tmp0)
replytype1=numeric
replyname1=Ma réponse
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10
embedcnt=0
