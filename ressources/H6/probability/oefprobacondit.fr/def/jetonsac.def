!set title=Des jetons dans des sacs
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sophie, Lemaire
email=sophie.lemaire@universite-paris-saclay.fr
keywords=conditional_probability
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=900

ansorder=r,r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 3

val6=$[rint($(tmp0))]
tmp0=!randint 6, 20

val7=$[rint($(tmp0))]
tmp0=!randint 6, 20

val8=$[rint($(tmp0))]
val9=$[rint($val7+$val8)]
!for val10 =2 to $val6 
tmp0=!randint 3, 10

val11=$[rint($(tmp0))]
tmp0=!randint 3, 10

val12=$[rint($(tmp0))]
val7=$val7,$val11
val8=$val8,$val12
val13=$[rint($val11+$val12)]
val9=$val9,$val13
!next
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
!if $val6=2 
val15=$[rint($val14+1)]
!else
tmp0=!randint $val14+2, 6

val15=$[rint($(tmp0))]
!endif
tmp=!trim $val14/6, (7-$val15)/6,($val15-1-$val14)/6
val16=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
tmp0=!item $val17 of noir,blanc

val18=$(tmp0)
tmp0=!randint 1, $val6

val19=$[rint($(tmp0))]
val20=$[0]
t_=!replace internal \( by ( in b=Mat([$val7]);N=Mat([$val9]);pc=vector($val6,i,0); for(i=1,$val6,pc[i]=b[1,i]/N[1,i]);print(pc)
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val21=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in p=Mat([$val16]);s=0;for(i=1,$val6,s=s+pc[i]*p[1,i]);print(s)
tmp0=!exec pari $t_

val20=$[$(tmp0)]

!ifval $val17=1 
val20=$[ $val20 ]
!else
val20=$[ 1-$val20]
!endif

!ifval $val17=1 
val22=$[ $(val21[1;$val19])]
!else
val22=$[ 1-$(val21[1;$val19])]
!endif
val22=$[$val22*$(val16[1;$val19])/$val20]
tmp0=!item 1 of $val7

tmp1=!item 1 of $val8

val23=<ul> <li>Il y a $(tmp0) jetons noirs et $(tmp1) jetons blancs dans le premier sac.</li>
tmp0=!item 2 of $val7

tmp1=!item 2 of $val8

val23=$val23 <li> Il y a $(tmp0) jetons noirs et $(tmp1) jetons blancs dans le deuxième sac.</li>
!if $val6=3 
tmp0=!item 3 of $val7

tmp1=!item 3 of $val8

val23=$val23 <li> Il y a $(tmp0) jetons noirs et $(tmp1) jetons blancs dans le troisième sac.</li>
!endif
val23=$val23 </ul>

!ifval $val14=1 
val24= $val14
!else
val24= un nombre inférieur ou égal à $val14
!endif

!ifval $val15=6 
val25= $val15
!else
val25= un nombre supérieur ou égal à $val15
!endif
val26=<ul> <li> Si elle obtient $val24, elle tire au hasard un jeton dans le premier sac.</li> 
!if $val6=2 
val26=$val26 <li> Sinon elle tire au hasard un jeton dans le deuxième sac.</li></ul>
!else
val26=$val26<li> Si elle obtient $val25, elle tire au hasard un jeton dans le deuxième sac.</li>	<li> Dans les autres cas, elle tire au hasard un jeton dans le troisième sac.</li></ul>
!endif
!if $val19=1 
val27=premier
!else

!ifval $val19=2
val27=deuxième
!else
val27=troisième
!endif
!endif
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=numeric
replyname1=1- La probabilité est
replygood1=$[$val20]
replytype2=numeric
replyname2=2- La probabilité est
replygood2=$[$val22]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Lorsque l'événement observé est le résultat d'une succession d'expériences aléatoires, penser à décomposer cet événement en fonction des résultats des expériences précédentes.


!goto stat

!exit

:question
$()	On dispose de $val6 sacs contenant des jetons noirs et blancs :	$val23	Une personne lance un dé à 6 faces. $val26 	<div class="wims_question">	<ol class="spacer"><li> Quelle est la probabilité pour que le jeton tiré soit 	
!if $m_step=1 
$()<label for="reply1">$val18 ?</label> 
!read oef/embed.phtml reply1 
$() 
!endif
$()	
!if $m_step>1 
$()$val18 ? <div class="oef_indgood"> Bonne réponse, la probabilité de tirer un jeton	$val18 est $val20.</div>	</li><li>	 On sait que la personne a tiré un jeton $val18.	<label for="reply2">Quelle est la probabilité pour que ce jeton ait été tiré dans le $val27 sac ?</label>  
!read oef/embed.phtml reply2 
$() 
!endif
$()	</li></ol>	</div>	<div class="wims_instruction">Ecrire le résultat en gardant au moins quatre chiffres significatifs. 	</div>	
$()
!exit

:hint
$()Lorsque l'événement observé est le résultat d'une succession d'expériences aléatoires, penser à décomposer cet événement en fonction des résultats des expériences précédentes.
$()
