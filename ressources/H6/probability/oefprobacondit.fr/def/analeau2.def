val6=$[rint(1)]
val7=$[rint(3)]
t_=!rawmath $val7/2
val8=!exec pari print($t_)
tmp0=!randint floor($val8+1), $val7

val9=$[rint($(tmp0))]
tmp0=!randitem 0,1

val10=$[rint($(tmp0))]
!if $val10=1 
val11=non polluée
val12=est saine
val13=$[rint($val7-$val9)]
val14=$[rint($val9)]
!else
val11=polluée
val12=est polluée
val13=$[rint($val9)]
val14=$[rint($val7-$val9)]
!endif
tmp0=!randint 2, 16

val15=$[$(tmp0)*5/100]
tmp0=!randint 70, 98

val16=$[rint($(tmp0))]
tmp0=!randint 70, 98

val17=$[rint($(tmp0))]
t_=!rawmath $val16/100
val18=!exec pari print($t_)
t_=!rawmath $val17/100
val19=!exec pari print($t_)
!if $val10=1 
val20=$[rint(0)]
val21=$[rint(1)]
!else
val20=$[rint(1)]
val21=$[rint(0)]
!endif
t_=!rawmath ($val18)^($val20)*((1-$val18)^($val21))*($val15)
val22=!exec pari print($t_)
t_=!rawmath (($val19)^($val21)*(1-$val19)^($val20))*(1-$val15)
val23=!exec pari print($t_)
t_=!rawmath ($val22)/($val22+$val23)
val24=!exec pari print($t_)
val25=!rawmath (($val18)^($val20)*((1-$val18)^($val21))*x)/(($val18)^($val20)*((1-$val18)^($val21))*x+($val19)^($val21)*(1-$val19)^($val20)*(1-x))
!if $val10=0 
val26=$[1-$val24]
tmp=!translate ";': to $     $ in 1-$val25

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=!rawmath $(tmp0)
!else
val26=$[$val24]
tmp=!translate ";': to $     $ in $val25

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=!rawmath $(tmp0)
!endif
t_=!rawmath ($val18)^($val13)*((1-$val18)^($val14))*($val15)
val28=!exec pari print($t_)
t_=!rawmath (($val19)^($val14)*(1-$val19)^($val13))*(1-$val15)
val29=!exec pari print($t_)
t_=!rawmath ($val28)/($val28+$val29)
val30=!exec pari print($t_)
val31=!rawmath (($val18)^($val13)*((1-$val18)^($val14))*x)/(($val18)^($val13)*((1-$val18)^($val14))*x+($val19)^($val14)*(1-$val19)^($val13)*(1-x))
!if $val10=0 
val32=$[1-$val30]
tmp=!translate ";': to $     $ in 1-$val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val33=!rawmath $(tmp0)
!else
val32=$[$val30]
tmp=!translate ";': to $     $ in $val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val33=!rawmath $(tmp0)
!endif
val34=-0.1,1.1
val35=-0.1,1.1
val36=$[rint($(val34[2])-$(val34[1]))]
val37=$[rint($(val35[2])-$(val35[1]))]
val38=rangex $val34	rangey $val35	parallel $(val34[1]),0,$(val34[2]),0, 0,0.1,12,grey	parallel 0,$(val35[1]),0,$(val35[2]),0.1,0,12,grey	arrow 0,-0.1,0,1.05,10,black	arrow -0.1,0,1.05,0,10,black	text black,-0.07,-0.03,,0	segment 0.1,-0.01,0.1,0.01,black	text black,0.07,-0.03,,0.1	segment -0.01,0.1,0.01,0.1,black	text black,-0.1,0.16,,0.1	text black,-0.1,0.8,,y	text black,0.6,-0.03,,x	
!readproc oef/draw.phtml 200,200 \
