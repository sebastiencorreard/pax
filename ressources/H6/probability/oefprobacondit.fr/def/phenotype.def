tmp0=$slib_out
tmp=!trim $(tmp0)
val30=!translate internal $	\
$ to ;; in $tmp
!for val31 =2 to $val6 
tmp0=!shuffle $val28

!readproc slib/stat/multinomial 1,100,[$(tmp0)] 
tmp1=$slib_out
tmp=!trim $val30 ; $(tmp1)
val30=!translate internal $	\
$ to ;; in $tmp
!next
val32=$(val29[1])% de phénotypes A
!for val31 =2 to $val6 
