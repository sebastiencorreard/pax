\title{Probabilité conditionnelle}
\language{fr}
\author{Sophie, Lemaire}
\email{Sophie.Lemaire@universite-paris-saclay.fr}
\computeanswer{no}
\format{html}
\keywords{conditional_probability}
\description{en renouvelant l'exercice, les données de l'énoncé et la probabilité à calculer peuvent changer.}
\observation{suivant les données de l'énoncé, il y a 5 à 6 types possibles de probabilités à calculer.}
\precision{1000}
\if{\confparm1= }{
\integer{c1=randint(1..4)}
\integer{c2=randint(1..6)}
}
{\if{\confparm1=1}{\integer{c1=randint(1..2)}
                   \integer{c2=randint(1..4)}
                   }
                  {\integer{c1=randint(1..4)}
                   \integer{c2=\confparm1=2 ? randint(1..3) :randint(4..6)}}
}

\text{Ta=P ( A )}
\text{Tb= P ( B )}
\text{Taeb = P( A cap B)}
\if{\confparm2 issametext oui}{
\text{Tbsa=P_{A} ( B )}
\text{Tbsac=P_{\bar{A}}( B )}
\text{Tasb=P_{B} ( A )}
\text{Tasbc=P_{\bar{B}}( A )}
\text{Taebc=P (A \cap \bar{B} )}
\text{Taceb=P (\bar{A} \cap B )}
\text{Tacebc=P (\bar{A} \cap \bar{B} )}
}
{
\text{Tbsa=P ( B | A )}
\text{Tbsac=P( B | A ^c )}
\text{Tasb=P( A | B )}
\text{Tasbc=P( A | B ^c )}
\text{Taebc=P (A cap B^c )}
\text{Taceb=P (A^c cap B )}
\text{Tacebc=P (A^c cap B^c )}
}

\if{\c1=1}{\text{para1=\Ta}
          \text{para2=\Tb}
          \text{para3=\Tasb}
\text{quest=\Tbsa,\Taeb,\Taceb,\Taebc,\Tbsac,\Tasbc}
P(B cap A),P(A^c cap B),P(A cap B^c),P(B | A ^c),P(A | B ^c)
          \text{sol=[bsa,aeb,aceb,aebc,bsac,asbc]}
          \text{a=p}\text{b=q}\text{asb=r}
          \text{bsa=bsa}\text{aeb=aeb}\text{aceb=aceb}\text{aebc=aebc}
          \text{bsac=bsac}\text{asbc=asbc}}
\if{\c1=2}{\text{para1=\Ta}
    \text{para2=\Tb}
    \text{para3=\Tbsa}
\text{quest=\Tasb,\Taeb,\Taceb,\Taebc,\Tbsac,\Tasbc}
P(A | B),P(B cap A),P(A ^c cap B),P(A cap B^c), P(B | A ^c),P(A | B^c)
    \text{sol=[asb,aeb,aceb,aebc,bsac,asbc]}
    \text{a=p}\text{b=q}\text{bsa=r}
    \text{asb=asb}\text{aeb=aeb}\text{aceb=aceb}\text{aebc=aebc}
    \text{bsac=bsac}\text{asbc=asbc}}
\if{\c1=3}{
    \text{para1=\Ta}
    \text{para2=\Tbsa}
    \text{para3=\Tbsac}
\text{quest=\Taeb,\Taceb,\Taebc,\Tasb,\Tb,\Tasbc}
P(B cap A),P(A^c cap B),P(A cap B^c),P(A | B),P(B),P(A | B^c)
    \text{sol=[aeb,aceb,aebc,asb,b,asbc]}
    \text{a=p}\text{bsa=q}\text{bsac=r}
    \text{b=b}\text{asb=asb}\text{aeb=aeb}\text{aceb=aceb}
    \text{aebc=aebc}\text{asbc=asbc}
}
\if{\c1=4}{
    \text{para1=\Tb}
    \text{para2=\Tasb}
    \text{para3=\Tasbc}
\text{quest=\Taeb,\Taceb,\Taebc,\Tbsa,\Ta,\Tbsac}
P(B cap A),P(A^c cap B),P(A cap B^c),P(B | A),P(A),P(B | A^c)
    \text{sol=[aeb,aceb,aebc,bsa,a,bsac]}
    \text{a=a}\text{asb=q}\text{asbc=r}
    \text{b=p}\text{bsa=bsa}\text{aeb=aeb}\text{aceb=aceb}
    \text{aebc=aebc}\text{bsac=bsac}
}
\text{para4=item(\c2,\quest)}

\matrix{T=maxima(algsys([\a*\bsa=\asb*\b,\a*\bsa=\aeb,\asb*\b=\aeb,
\aceb=\b-\aeb,\aebc=\a-\aeb,\bsac=\aceb/(1-\a),\asbc=\aebc/(1-\b)],\sol))}
\text{u=wims( declosing \T)}
\text{v=item(\c2,\u)}
\text{uu=wims( declosing \sol)}
\text{vv=item(\c2,\uu)}
\text{v=wims(replace internal \vv by in \v)}
\text{v=wims(replace internal ; by in \v)}
\text{rep=wims(replace internal = by in \v)}
\text{repaff=texmath(\rep)}
\text{bac=wims(replace internal p by \para1 in \rep)}
\text{bac=wims(replace internal q by \para2 in \bac)}
\text{bac=wims(replace internal r by \para3 in \bac)}
\text{bac=wims(replace internal | by \mid in \bac)}
\text{bac=wims(replace internal * by in \bac)}
\text{NB=wims(record 1 of notations)<p>wims(record 2 of notations)</p>}
\statement{On considère une expérience aléatoire dont l'ensemble des résultats est noté \(\Omega).
On note \(P) une probabilité sur \(\Omega) associée à cette expérience aléatoire.
On s'intéresse à deux événements \(A\) et \(B\) qui ont une probabilité strictement comprise entre 0 et 1 d'être réalisés.
On suppose connu <div class="wimscenter">\(p = \para1), \(q = \para2\) et \(r = \para3\).</div>
<div class="wims_question">
Donner l'expression de \(\para4\) en fonction de \(p\), \(q\) et \(r\).
<div class="wimscenter"><label for="reply1">\(\para4\) = </label> \embed{reply1}</div>
<div class="wims_instruction" style="font-style:italic;"> Ne pas oublier de mettre l'opérateur * pour multiplier deux expressions.</div>
</div> }
\answer{\(\para4\)=}{\rep}{type=formal}{option=noanalyzeprint}
\help{\NB}
\if{\sc_reply1=1}{
\text{affrep=wims(replace internal p by \para1 in \reply1)}
\text{affrep=wims(replace internal q by \para2 in \affrep)}
\text{affrep=wims(replace internal r by \para3 in \affrep)}
\text{affrep=wims(replace internal | by \vert in \affrep)}
\text{affrep=wims(replace internal * by in \affrep)}
}
{
\text{affrep=\bac}
}
text{affrep=texmath(\affrep)}
\feedback{\sc_reply1=1}{\(\para4\) = \(\reply1\) = \(\affrep\).}
\feedback{\sc_reply1<1}{La probabilité \(\para4\) n'est pas égale à \reply1.
 Avec les notations de l'exercice, \(\para4\) peut s'écrire \rep. Autrement dit,
  <div class="wimscenter">\(\para4\) = \( \repaff\) = \( \affrep\).</div>}
