\title{Traduction probabiliste}
\language{fr}
\author{Sophie, Lemaire}
\email{Sophie.Lemaire@universite-paris-saclay.fr}
\keywords{conditional_probability,modelling}
\computeanswer{no}
\format{html}
\integer{nb=4}
\integer{n=randint(1..\nb)}
\if{\confparm2 issametext oui}{
    \text{Ac=\bar{A}}
    \text{Bc=\bar{B}}
   }
   {\text{Ac=A^c}
    \text{Bc=B^c}
   }
\matrix{enonce=On dispose d'un test médical servant à détecter une maladie \(m\). On effectue le test sur une personne. 
On effectue un contrôle d'alcoolémie sur un conducteur. 
Une personne consulte pour un mal de gorge.
Une entreprise dispose de deux machines pour fabriquer des pièces métalliques. Un controleur examine une pièce provenant de cette usine.}
\text{enonce=\enonce[\n;]}
\text{notA=la personne a la maladie \(m\),le conducteur est en état d'ébriété, la patiente fume, la pièce a un défaut}
\text{notA=item(\n,\notA)}
\text{notB=le test est positif, l'alcootest est positif, la patiente a une bronchite chronique, la pièce a été fabriquée par la première machine }
\text{notB=item(\n,\notB)}
\matrix{quest= la personne ait  la maladie si le test est positif, le conducteur soit en état débriété si l'alcotest s'est révélé positif, la patiente qui a une bronchite chronique fume, la pièce qui a été fabriquée par la 1ère machine ait un défaut, \(A\),\(\mid\),\(B\)
la personne n'ait pas la maladie lorsque le test est négatif, le conducteur ne soit pas en état d'ébriété si l'alcotest s'est révélé négatif, la patiente ne fume pas sachant qu'elle n'a pas une bronchite chronique, la pièce fabriquée par la 2ème machine soit sans défaut,\(\Ac\),\(\mid\),\(\Bc\)
le test soit positif pour une personne malade, l'alcotest soit positif lorsque le conducteur est en état d'ébriété, la patiente qui fume  ait une bronchite chronique, la pièce ait été fabriquée par la 1ère machine si elle a un défaut, \(B\),\(\mid\),\(A\)
le test soit négatif  pour une personne saine, l'alcotest soit négatif pour quelqu'un qui n'est pas en état d'ébriété, la patiente qui ne fume pas n'ait pas de bronchite chronique, la pièce qui n'a pas de défaut ait été fabriquée par la 2ème machine, \(\Bc\),\(\mid\),\(\Ac\)
le test soit négatif pour une personne malade, l'alcotest soit négatif alors que le conducteur est en état d'ébriété, la patiente n'ait pas une bronchite chronique sachant qu'elle fume, la pièce qui a un défaut ait été fabriquée par la 2ème machine,\(\Bc\),\(\mid\),\(A\)
le test soit positif pour une personne saine,l'alcotest se révèle positif alors que le conducteur n'est pas en état d'ébriété, la patiente ait une bronchite chronique sachant qu'elle ne fume pas, la pièce qui n'a pas de défaut ait été fabriquée par la 1ère machine, \(B\),\(\mid\),\(\Ac\) 
le test soit positif et que la personne soit saine,  le conducteur ne soit pas en état d'ébriété et que l'alcotest soit positif, la patiente ait une bronchite chronique et qu'elle ne fume pas,  la pièce n'ait pas de défaut et ait  été fabriquée par la 1ère machine,\(B\),\(\cap\),\(\Ac\)|\(\Ac\),\(\cap\),\(B\)
le test soit négatif et que la personne soit saine, le test soit négatif et que le conducteur ne soit pas en état d'ébriété, la patiente n'ait pas une bronchite chronique et qu'elle ne fume pas, la pièce n'ait pas  de défaut et ait  été fabriquée par la 2ème machine,\(\Bc\),\(\cap\),\(\Ac\)|\(\Ac\),\(\cap\),\(\Bc\)
le test soit négatif et que la personne soit malade, le conducteur soit en état d'ébriété et que l'alcotest soit négatif, la patiente fume et qu'elle n'ait pas une bronchite chronique, la pièce ait un défaut et ait  été fabriquée par la 2ème machine,\(\Bc\),\(\cap\),\(A\)|\(A\),\(\cap\),\(\Bc\)
le test soit positif et que la personne soit malade, l'alcotest soit positif et que le conducteur soit en état d'ébriété, la patiente ait une bronchite chronique et qu'elle fume,la pièce ait un défaut et ait  été fabriquée par la 1ère machine,\(B\),\(\cap\),\(A\)|\(A\),\(\cap\),\(B\)}

\text{rem=la valeur prédictive du test, la valeur prédictive négative du test, la sensibilité du test, la spécificité du test}
\integer{c=randint(1..10)}

\text{symb=\(A\) ,\(B\) ,\(\Ac\) ,\(\Bc\),\(\cup\),\(\cap\),\(\mid\)}
\text{ligne=\quest[\c;]}
\integer{cnt = items(\ligne)}
\text{questc = \ligne[\n]}
\text{choix=\ligne[\nb+1..\cnt]}
\if{\c<=4}{\text{rem=item(\c,\rem)}}

\text{NB=wims(record 1 of notations)<p>wims(record 2 of notations)</p>}
\steps{reply1}
\statement{\enonce On note 
<ul>
<li>\(A\) l'événement <span class="wims_emph">"\notA",</span></li>
<li> \(B\) l'événement <span class="wims_emph">"\notB".</span></li>
</ul>
<div class="wims_question">Compléter l'assertion suivante  : <b>la probabilité pour que  \questc </b> s'écrit :
<div class="wimscenter">P(\embed{reply1,50x30x3})</div></div>
}
\help{\NB}
\answer{Ensemble \(F) : }{\choix;\symb}{type=clickfill}
