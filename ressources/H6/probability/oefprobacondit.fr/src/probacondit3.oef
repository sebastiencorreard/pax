\title{Infection virale}
\language{fr}
\author{Sophie, Lemaire}
\email{Sophie.Lemaire@universite-paris-saclay.fr}
\computeanswer{yes}
\format{html}
\keywords{conditional_probability,modelling}
\precision{1000}
\integer{Ab=randint(70..99)} Po(A/B)
\integer{A=randint(2..(\Ab-1))} Po(A)
\integer{Abc=randint(1..(\A-1))}
\real{b=(\A-\Abc)/(\Ab-\Abc)}
\integer{n1=randint(1..2)}
\integer{n2=randint(1..2)}
\real{ab=\Ab*\b/\A} P(B/A)
\real{c=(100-\Ab)*\b/(100-\A)}
\text{quest= soit, ne soit pas}
\text{quest1=item(\n1,\quest)}
\text{quest2=item(\n2,\quest)}
\text{quest3=item(3-\n2,\quest)}
\text{r1=I }
\text{Ic=\confparm2 issametext oui ? \bar{I}:I ^c}
\if{\n1=1}{
      \real{prob1=\b}
         }
   {  \real{prob1=1-\b}
      \text{r1=\Ic}
       }

\if{\n2=1}{
      \real{prob2=\ab}
      \real{prob3=1-\c}
      \text{r2=I}
      \text{r3=\Ic}
         }
   {  \real{prob2=1-\ab}
      \real{prob3=\c}
      \text{r2=\Ic}
      \text{r3=I}
       }
\if{\confparm2 issametext oui}{
  \text{Ncond=\(P_{I}( S )\), \(P_{\bar{I}}( S )\)}
  \text{Nquest2=\(P_{S}( \r2 )\)}
  \text{Nquest3=\(P_{\bar{S}}( \r3 )\)}
 }
 {
  \text{Ncond=\(P( S | I )), \(P( S | I ^c)\)}
  \text{Nquest2=\(P( \r2 | S )\)}
  \text{Nquest3=\(P( \r3 | S^c )\)}
  }
\text{NB=<ul><li>wims(record 1 of notations)</li><li>wims(record 2 of notations)</li></ul>}
\steps{reply 1
reply 2
reply 3}

\statement{Dans une population donnée, \Ab % des victimes d'une infection virale présente un symptôme qui
n'atteint que \Abc % de la population non infectée.
On sait de plus que \A % de la population présente ce symptôme. 
<div class="wims_question">
<ol>
<li>Quelle est la probabilité qu'un individu choisi au hasard dans cette population \quest1 infecté ?
<br>
\if{\step>1}{<div class="oef_indgood"> Bonne réponse,
la probabilité qu'un individu choisi au hasard dans cette population \quest1 infecté est \prob1.
</div>
</li><li>
 Quelle est la probabilité qu'un individu présentant le symptôme \quest2 infecté ?}
\if{\step>2}{<div class="oef_indgood">
Bonne réponse, la probabilité qu'un individu présentant le symptôme,
\quest2 infecté  est \prob2. </div>
</li><li>
Quelle est la probabilité qu'un individu ne présentant pas le symptôme, \quest3 infecté ?}
</li></ol></div>
<div class="wims_instruction"> Ecrire la probabilité en gardant quatre chiffres significatifs. </div>
}
\answer{Question 1}{\prob1}{type=numeric}
\answer{Question 2}{\prob2}{type=numeric}
\answer{Question 3}{\prob3}{type=numeric}
\feedback{1=1}{<b> Indications pour rédiger : </b>
Notons <span style="color:#000080;font-weigth:bold;">
\(S) </span> l'événement
<span style="color:#000080;font-style:italic;">
la personne considérée a le symptôme</span>
et <span style="color:#000080;font-weigth:bold;">\(I\)</span> l'événement
<span style="color:#000080;font-style:italic;">la personne considérée est
infectée</span>. On note <span style="color:#000080;font-weigth:bold;">\(P\) </span>
 l'équiprobabilité sur l'ensemble de la population étudiée.
Dans l'énoncé on vous donne les valeurs de <span style="color:#000080;font-weigth:bold;">
\Ncond et \(P( S )\)</span>.
<ol><li>
 On demande de calculer \(P( \r1 )\).
Une façon d'obtenir une expression de \(P( \r1 )\) est de décomposer \(S\) suivant que l'événement
\(I\) est ou n'est pas réalisé,  puis d'utiliser les probabilités conditionnelles. 
\if{\step>1}{
</li><li> On demande de calculer \Nquest2.}
\if{\step>2}{
</li><li> On demande de calculer \Nquest3.}
</li></ol>
<span class="wims_emph">Rappel sur les notations :</span> \NB }
