\title{Calculs avec des événements indépendants}
\language{fr}
\author{Sophie, Lemaire;Bernadette, Perrin-Riou}
\email{sophie.lemaire@universite-paris-saclay.fr,bernadette.perrin-riou@universite-paris-saclay.fr}
\computeanswer{no}
\format{html}
\keywords{probability,independent_events}
\precision{10000}
\integer{u1=random(1,2)} Choix de l'oper entre le 1er ens et les autres
\integer{u2=random(1,2)} Choix de l'oper entre les 2 derniers
\integer{v1=random(1,2)} Choix du 1er ens
\integer{v2=random(1,2)} choix des 2 autres 
\if{\confparm2 issametext oui}
   {\text{Ac=\bar{A}}\text{Cc=\bar{C}}\text{Bc=\bar{B}}}
   {\text{Ac=A^c}\text{Cc=C^c}\text{Bc=B^c}}

\if{\v1=1}{\text{p1=a}\text{e1=A}\text{f1=\Ac}
}
{\text{e1=\Ac}\text{f1=A}\text{p1=(1-a)}
}
\if{\v2=1}{
\text{e2=B}\text{e3=C}\text{f2=\Bc}\text{f3=\Cc}
\text{p2=b}\text{p3=c}
}
{\text{e2=\Bc}\text{e3=\Cc}\text{f2=B}\text{f3=C} \text{p2=(1-b)}\text{p3=(1-c)}
}
\if{\u2=1}{
\text{oset2=\cup}\text{vset2=\cap}\text{prob2=(\p2+\p3-\p2*\p3)}
}
{\text{oset2=\cap}\text{vset2=\cup}\text{prob2=(\p2*\p3)}
}
\if{\u1=1}{
\text{oset1=\cup}\text{vset1=\cap}\text{prob=\p1+\prob2-\p1*\prob2}
}
{\text{oset1=\cap}\text{vset1=\cup}\text{prob=\p1*\prob2}
}
\text{ens=\e1\oset1 (\e2\oset2 \e3)}
\text{alt1=\(\f1\oset1 (\f2\oset2 \f3)\)}
\text{alt2=\(\f1\vset1 (\f2\oset2 \f3)\)}
\text{alt3=\(\f1\vset1 (\f2\vset2 \f3)\)}
\text{alt4=\(\e1\vset1 (\e2\vset2 \e3)\)}
\text{alt5=\(\e1\vset1 (\e2\oset2 \e3)\)} 
\text{alt6=\(\e1\oset1 (\e2\vset2 \e3)\)}
\text{alt7= \(\f1\vset1 (\e2\oset2 \e3)\)}
\text{alt8=\(\f1\vset1 (\e2\vset2 \e3)\)} 
\text{alt9=\(\e1\vset1 (\f2\vset2 \f3)\)}
\text{alt10=\(\e1\oset1 (\f2\vset2 \f3)\)}
\text{alt11= \(\e1\vset1 (\f2\oset2 \f3)\)}
\text{alt12=\(\e1\vset1 (\f2\vset2 \f3)\)}
\text{listerep= \alt1,\alt2,\alt3,\alt4,\alt5,\alt6,\alt7,\alt8,
\alt9,\alt10,\alt11,\alt12}
\text{choix1=slib(data/random 3, \listerep)}
\text{listchoix=\ens,\choix1}
\text{choixrep=slib(data/random 4,,\listchoix)}
\text{rep=position(\ens,\choixrep)}
\text{prob=maxima(Expand(\prob))}
\text{NB=wims(record 1 of notations)}
\statement{On suppose que \(A\), \(B\) et \(C\) sont des événements indépendants de probabilité respectivement \(a\), \(b\) et \(c\). <p>
<div class="wims_question">
Exprimer en fonction de \(a\), \(b\) et \(c\) la probabilité de l'événement \(F = \ens\) :
<div class="wimscenter"><label for="reply1">\(P ( F ) =\)</label> \embed{reply1}</div>
</div>}

\answer{\(P(F)=\)}{\prob,a,b,c}{type=function}
\help{\NB}
