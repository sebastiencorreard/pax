\title{Des jetons dans des sacs}
\language{fr}
\range{-5..5}
\author{Sophie, Lemaire}
\email{sophie.lemaire@universite-paris-saclay.fr}
\computeanswer{yes}
\format{html}
\keywords{conditional_probability}
\precision{900}
\integer{n=randint(2..3)}
\integer{black=random(6..20)}
\integer{white=random(6..20)}
\integer{total=\black+\white}
\for{i=2 to \n}{
  \integer{b=random(3..10)}
  \integer{w=random(3..10)}
  \text{black=\black,\b}
  \text{white=\white,\w}
  \integer{t=\b+\w}
  \text{total=\total,\t}
}
\integer{k1=randint(1..4)}
\if{\n=2}{
      \integer{k2=\k1+1}}
     {\integer{k2=randint(\k1+2..6)}}

\matrix{p=\k1/6, (7-\k2)/6,(\k2-1-\k1)/6}
\integer{q1=random(1,2)}
\text{coul=item(\q1,noir,blanc)}
\integer{num=randint(1..\n)}
\real{pcoul=0}
\matrix{ptir=pari(b=Mat([\black]);N=Mat([\total]);pc=vector(\n,i,0); for(i=1,\n,pc[i]=b[1,i]/N[1,i]);print(pc))}
\real{pcoul=pari(p=Mat([\p]);s=0;for(i=1,\n,s=s+pc[i]*p[1,i]);print(s))}
\real{pcoul=\q1=1 ? \pcoul : 1-\pcoul}
\real{pnum=\q1=1 ? \ptir[1;\num]: 1-\ptir[1;\num]}
\real{pnum=\pnum*\p[1;\num]/\pcoul}

\text{compo= <ul> <li>Il y a item(1,\black) jetons noirs et item(1,\white) jetons blancs dans le premier sac.</li>}
\text{compo=\compo <li> Il y a item(2,\black) jetons noirs et item(2,\white) jetons blancs dans le deuxième sac.</li>}
\if{\n=3}{\text{compo=\compo <li> Il y a item(3,\black) jetons noirs et item(3,\white) jetons blancs dans le troisième sac.</li>}}
\text{compo=\compo </ul>}
\text{c1=\k1=1 ? \k1: un nombre inférieur ou égal à \k1}
\text{c2=\k2=6 ? \k2: un nombre supérieur ou égal à \k2}
\text{choix= <ul> <li> Si elle obtient \c1, elle tire au hasard un jeton dans le premier sac.</li> }
\if{\n=2}{
   \text{choix= \choix <li> Sinon elle tire au hasard un jeton dans le deuxième sac.</li></ul>}}
{\text{choix= \choix<li> Si elle obtient \c2, elle tire au hasard un jeton dans le deuxième sac.</li>
<li> Dans les autres cas, elle tire au hasard un jeton dans le troisième sac.</li></ul>}
}
\if{\num=1}{\text{numsac=premier}}
           {\text{numsac=\num=2?deuxième:troisième}}
\steps{reply1
reply2}

\statement{
On dispose de \n sacs contenant des jetons noirs et blancs :
\compo
Une personne lance un dé à 6 faces. \choix 
<div class="wims_question">
<ol class="spacer"><li> Quelle est la probabilité pour que le jeton tiré soit 
\if{\step=1}{<label for="reply1">\coul ?</label>\embed{reply1}}
\if{\step>1}{\coul ? <div class="oef_indgood"> Bonne réponse, la probabilité de tirer un jeton
\coul est \pcoul.</div>
</li><li>
 On sait que la personne a tiré un jeton \coul.
<label for="reply2">Quelle est la probabilité pour que ce jeton ait été tiré dans le \numsac sac ?</label> \embed{reply2}}
</li></ol>
</div>
<div class="wims_instruction">Ecrire le résultat en gardant au moins quatre chiffres significatifs. 
</div>
}

\answer{1- La probabilité est }{\pcoul}{type=numeric}
\answer{2- La probabilité est }{\pnum}{type=numeric}
\hint{Lorsque l'événement observé est le résultat d'une succession d'expériences aléatoires,
penser à décomposer cet événement en fonction des résultats des expériences précédentes.}
