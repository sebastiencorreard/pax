  \function{fpoll0=((\p1)^(\np0)*((1-\p1)^(\ns0))*x)/((\p1)^(\np0)*((1-\p1)^(\ns0))*x+(\q1)^(\ns0)*(1-\q1)^(\np0)*(1-x))}
