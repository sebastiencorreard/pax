  \remark[\datac2[6];1].
 \comex1 \comex2 deuxième affirmation : <div style="font-style:italic">
<ul><li>\remark[\datac2[6];2]</li><li>\remark[\datac2[6];3]</li>
\if{\remark[\datac2[6];4]=}{}{<li>\remark[\datac2[6];4]</li>}</ul></div>
}}

\feedback{\nivex=2 and \rep3=2 and \sc_reply3=0}{
 \if{\datac3[6]=}{}{<b>Affirmation 3.</b>
\remark[\datac3[6];1].  \comex1 \comex2 troisième affirmation :<div style="font-style:italic">
