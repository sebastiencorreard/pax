\text{NB=wims(record 1 of notations)<p>wims(record 2 of notations)</p>}
\if{\nivex=1}{\text{STEP=reply1,reply2}}
{\text{STEP=reply1,reply2,reply3}}
\steps{\STEP}
\statement{
Soit  (\(\Omega,\mathcal{A},P\)) un espace de probabilité et \(A\), \(B\) et \(C\) trois événements.
Les affirmations suivantes sont-elles toujours vraies ?
<div class="wims_question">1. Si \if{\hypo1=}{}{\hypo1 et si } \ass11, alors \ass21.</div>
<div class="wimscenter">\embed{reply1}</div>
<div class="wims_question"> 2. Si \if{\hypo2=}{}{ \hypo2 et si } \ass12, alors \ass22.</div>
<div class="wimscenter">\embed{reply2}</div>
\if{\nivex>1}{
<div class="wims_question">3. Si \if{\hypo3=}{}{\hypo3 et si } \ass13, alors \ass23.</div>
<div class="wimscenter">\embed{reply3}</div>}}
\help{\NB
 \if{\nivex=2}{Si G est un événement tel que \(P( G ) > 0\). 
 On dit que deux événements \(E\) et \(F\) sont indépendants conditionnement à l'événement 
 \(G\) si \(P( E \cap F | G ) = P( E | G )P( F | G )\).}  }
\answer{Question 1}{\rep1;\choix}{type=radio}
\answer{Question 2}{\rep2;\choix}{type=radio}
\answer{Question 3}{\rep3;\choix}{type=radio}

\feedback{\rep1=2 and \sc_reply1=0}{
 \if{\datac1[6]=}{}{<b>Affirmation 1.</b>\remark[\datac1[6];1].
\comex1 \comex2 première affirmation :<div style="font-style:italic">
<ul><li>\remark[\datac1[6];2]</li><li>\remark[\datac1[6];3]</li>
\if{\remark[\datac1[6];4]=}{}{<li>\remark[\datac1[6];4]</li>}</ul></div>
}}

\feedback{\rep2=2 and \sc_reply2=0}{
