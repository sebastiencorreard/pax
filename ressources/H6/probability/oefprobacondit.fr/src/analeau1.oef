\real{a=randint(2..16)*5/100}
\integer{p=randint(70..98)}
\integer{q=randint(70..98)}
\rational{p1=\p/100}\rational{q1=\q/100}
\rational{numpoll=(\p1)^(\np)*((1-\p1)^(\ns))*(\a)}
\rational{denpoll=((\q1)^(\ns)*(1-\q1)^(\np))*(1-\a)}
\rational{respoll=(\numpoll)/(\numpoll+\denpoll)}
\function{fpoll=((\p1)^(\np)*((1-\p1)^(\ns))*x)/((\p1)^(\np)*((1-\p1)^(\ns))*x+(\q1)^(\ns)*(1-\q1)^(\np)*(1-x))}
\if{\c=0}{\real{res=1-\respoll}
          \function{f=simplify(1-\fpoll)}}
         {\real{res=\respoll}
          \function{f=simplify(\fpoll)}}
