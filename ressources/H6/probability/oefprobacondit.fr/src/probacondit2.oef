\title{Efficacité d'un vaccin}
\language{fr}
\author{Sophie, Lemaire}
\email{Sophie.Lemaire@universite-paris-saclay.fr}
\computeanswer{yes}
\format{html}
\keywords{conditional_probability,modelling}
\precision{1000}
\integer{A=randint(3..95)} pourc vaccine
\rational{V=\A/100}
\rational{MeV=randint(1..(\A-2))/100} prop M et V
\rational{aux1=max(1,(100*\MeV-2))}
\rational{aux2=99-\A}
\if{\aux1>=\aux2}{\rational{\aux1=1}}
\rational{MeVc=randint(\aux1..\aux2)/100} prop M et non V
\rational{Mv=\MeV/(\V)} prop de malades parmi les vaccines
\rational{M=\MeV+\MeVc} prop malades
\rational{Vm=\MeV/(\M)} prop vaccine parmi les malades
\real{Vmr=\Vm}
\real{Mvr=\Mv}
\rational{Mvc=\MeVc/(1-\V)} prop de malades parmi les non vaccines

\integer{n1=randint(1..2)}
\text{quest= ont été, n'ont pas été}
\text{quest1=item(\n1,\quest)}
\if{\n1=1}{
      \real{prob1=100*\M}
         }
   {  \real{prob1=(100*(1-\M))} 
       }
\real{prob2=\Mvc}
\integer{conc= \Mvc>\Mv ? 1 : 2}

\steps{reply 1
reply 2
reply 3}
\statement{\A % de la population a été vacciné contre une maladie contagieuse. 
Au cours d'une épidémie, on constate que la proportion de vaccinés parmi les malades est de 
\Vm=\Vmr. 
On sait de plus qu'au cours de cette épidémie, il y avait une proportion de \Mv=\Mvr malades 
parmi les vaccinés. 
<div class="wims_question">
<ol>
<li> Quel est le pourcentage de personnes qui \quest1 malades durant cette  épidémie ? <br>
\if{\step=1}{</li>}
\if{\step>1}{<div class="oef_indgood">Bonne réponse, au cours de cette épidémie, \prob1 % des 
personnes \quest1 malades. </div></li>
<li> En se basant uniquement sur ces informations, quelle est la probabilité de tomber 
malade pour une personne non vaccinée ? <br>
\if{\step=2}{<div class="wims_instruction"> Ecrire la probabilité en gardant au moins quatre chiffres significatifs. </div>
</li>}}
\if{\step>2}{ <div class="oef_indgood"> Bonne réponse, la probabilité de tomber malade 
pour une personne non vaccinée est \prob2.  </div></li>
<li>Le vaccin est-il efficace ?</li>}
</ol></div>}
\answer{Question 1 (en %) }{\prob1}{type=numeric}
\answer{Question 2 }{\prob2}{type=numeric}
\answer{Question 3 : }{\conc;oui,non}{type=radio}
\hint{ \if{\step <= 2}{Uniquement pour la question 3} 
\if{\step>2}{Le vaccin est efficace si on a moins de chance d'être malade en étant 
vacciné qu'en ne l'étant pas.}}
