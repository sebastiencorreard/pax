!set title=Loi exponentielle : calcul II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, MIFSUD
email=bmifsud@bmifsud@ac-aix-marseille.fr
language=fr
computeanswer=yes
precision=1000

ansorder=r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[$(tmp0)/100]
tmp0=!randint 2, 20

val7=$[$(tmp0)/10]
tmp0=!randint 1, 100

val8=$[$val7+$(tmp0)/10]
val9=!rawmath $val6*exp(-$val6*x)
val10=l'espérance de \(X\)
val11=\(E(X)\)
tmp=!translate ;";': to $     $ in x*$val9,x,0, INF 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val12=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val9,x,0, $val7 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val13=$[$(tmp0)]
tmp=!translate ;";': to $     $ in $val9,x,$val7, $val8 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
val14=$[$(tmp0)]
replytype1=numeric
replyname1=\(P( X<$val7 )\)
replygood1=$[$val13]
replytype2=numeric
replyname2=\(P( $val7<X<$val8 )\)
replygood2=$[$val14]
replytype3=numeric
replyname3=$val10
replygood3=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="enonce"> Soit 
!insmath X
