!set title=Intervalle de confiance : élection
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r,r,r,r,r,r
varcnt=25
prevarcnt=19
postvarcnt=5
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=le candidat, la candidate
val7=M., Mme
tmp0=!randint 5, 60

val8=$[rint($(tmp0))]
tmp0=!randint 2, 37

val9=$[$(tmp0)/100]
val10=$[4/($val9)^2]
t_=!replace internal \( by ( in floor($val10)
tmp0=!exec maxima $t_

val11=$[$(tmp0)]
t_=!replace internal \( by ( in floor($val10)+1
tmp0=!exec maxima $t_

val12=$[$(tmp0)]
!if $val11!=$val10 
val11=$[$val12]
!endif
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val14=$[$val8/100]

!ifval $val11>=30 and $val11*$val14>=5 and $val11*(1-$val14)>=5
val15=1
!else
val15=2
!endif
val16=$[($val14-1/sqrt($val11))*1000]
val17=$[($val14+1/sqrt($val11))*1000]
val18=$[floor($val16)/10]
!if $val18<0 
val18=$[0]
!endif
val19=$[floor($val17)-$val17]
!if $val19!=0 
val20=$[floor($val17+1)/10]
!else
val20=$[floor($val17)/10]
!endif
!if $val20>100 
!endif
val21=r1
dynsteps=yes
oefsteps=$val21 
nextstep=!nosubst $val21 
!readproc oef/steps.proc
replytype1=numeric
replyoption1=nonstop 
replyname1=taille de l'échantillon
replygood1=$[$val11]
replytype2=numeric
replyoption2=nonstop 
replyname2=n
replygood2=$[$val11]
replytype3=numeric
replyoption3=nonstop 
replyname3=fréquence observée
replygood3=$[$val14]
replytype4=menu
replyoption4=nonstop 
replyname4=conditions vérifiées
replygood4=$val15;sont vérifiées.,ne sont pas vérifiées.
replytype5=numeric
replyname5=pourcentage 1
replygood5=$[$val18]
replytype6=numeric
replyname6=pourcentage 2
replygood6=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()				<div class="enonce">	Lors d'une élection, un institut de sondage souhaite estimer le pourcentage de votants pour	$(val6[$val13]) $(val7[$val13]) X. Pour ce faire, il constitue un échantillon de taille 
!insmath n
$()	afin de déterminer un intervalle de confiance de la proportion de votants pour $(val7[$val13]) X.	
!if $m_step=2 and $m_sc_reply1!=1 
$()	 
!endif
$()		</div>		
!if $m_step=1 
$()	<div class="question">	Quelle doit être la taille minimale de l'échantillon pour que l'amplitude de l'intervalle de confiance,	 au niveau de confiance 0.95, soit inférieure ou égale à $val9.	<p class="reponse">n= 
!read oef/embed.phtml r1,5 
$()</p>	</div>	 
!endif
$()			
!if $m_step>=2 
$()	<div class="question">		
!if $m_sc_reply1!=1 
$()<p class="non">	La taille minimale de l'échantillon est n=$val11 </p><br> 
!endif
$()		On interroge aléatoirement $val11 personnes, $val8 % ont l'intention de voter pour $(val7[$val13]) X.<br>	En déduire un encadrement par intervalle de confiance, au niveau de confiance 0.95, du pourcentage  de	votant pour $(val6[$val13]) $(val7[$val13]) X.			
!if $m_step=2 
$()	<p class="consigne">	On note f<sub>obs</sub> la fréquence observée dans l'échantillon.<br>	On arrondira les fréquences au centième et les pourcentages au dixième.	</p> 
!endif
$()		
!if $m_step=2 
$()	<p class="reponse">	On a n= 
!read oef/embed.phtml r2,5 
$(), f<sub>obs</sub>= 
!read oef/embed.phtml r3,5 
$().<br>	Les conditions n&ge; 30,  n.f<sub>obs</sub>&ge;5 et n.(1-f<sub>obs</sub>)&ge;5  
!read oef/embed.phtml r4 
$()	</p>	 
!endif
$()		
!if $m_step>=3 and $val15=1 
$()		
!if $m_sc_reply2!=1 or $m_sc_reply3!=1 or $m_sc_reply4!=1 
$()	<p class="non">	
!if $m_sc_reply2!=1 
$()n=$val11 <br> 
!endif
$()	
!if $m_sc_reply3!=1 
$()f<sub>obs</sub>=$val14 <br> 
!endif
$()	
!if $m_sc_reply4!=1 
$()Les conditions d'approximation sont vérifiées. 
!endif
$()	</p> 
!endif
$()					<p class="reponse">	Au niveau de confiance 0.95, le pourcentage de votants pour $(val6[$val13]) $(val7[$val13]) X.,	se situe entre  
!read oef/embed.phtml r5,5 
$()% et  
!read oef/embed.phtml r6,5 
$()%.	</p>	</div>		 
!endif
$()	 
!endif
$()	
$()
!exit

