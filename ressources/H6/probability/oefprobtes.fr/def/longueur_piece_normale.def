!set title=Loi normale : longueur d'une pièce
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Khalid, EL HMOUZI
email=khalidhmouzi@gmail.com
language=fr
computeanswer=no
precision=100000

ansorder=r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=de variance, d'écart-type
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
tmp=!nonempty items de moyenne, d'espérance

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!randint 5, 100

val9=$[$(tmp0)]
tmp0=!randint 1, 20

val10=$[($(tmp0)/10)^2]
val11=$[sqrt($val10)]
!if $val7=1 
val12=$val10
!else
val12=$val11
!endif
tmp0=!randint 1, 10

val13=$[$(tmp0)/5]
val14=$[$val9-$val13*$val11]
val15=$[$val9+$val13*$val11]
val16=99,95
tmp0=!randint 1, 2

val17=$[rint($(tmp0))]
tmp=!translate ;";': to $     $ in 1/sqrt(2*pi)*exp(-x^2/2),x,-$val13,$val13 
tmp=!lower $tmp
!readproc slib/function/integrate $tmp
tmp0=$slib_out
t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec maxima $t_

val18=$[$(tmp1)]
val19=$[rint($val18*1000)/10]
!if $val17=1 
val20=$[rint((($val15-$val9)/3)*1000)/1000]
!else
val20=$[rint((($val15-$val9)/2)*1000)/1000]
!endif
!if $val17=1 
val21=$[rint((($val15-$val9)/2.58)*1000)/1000]
!else
val21=$[rint((($val15-$val9)/1.96)*1000)/1000]
!endif
replytype1=numeric
replyname1=
replygood1=$[$val19]
replytype2=numeric
replyname2=
replygood2=?analyze 22
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val20 (en terminale ES) ou $val21 (en terminale S)


!goto stat

!exit

:question
$()	<div class="enonce">	Une machine produit des pièces dont la longueur est une variable aléatoire X qui suit une loi	normale $val8 $val9 mm et $(val6[$val7]) $val12 
!if $val7=1 
$()mm<sup>2</sup> 
!else
$() mm 
!endif
$().<br>		Une pièce est "acceptable" si sa longueur est comprise entre $val14 mm et $val15 mm.	</div>		<div class="question">	Quel est le pourcentage, arrondi au dixième,	de pièces acceptables produites par cette machine ?	<div class="reponse">	p &asymp;  
!read oef/embed.phtml r1,5 
$()%.	</div>	</div>			<div class="question">	On souhaite régler l'écart-type &sigma; de cette machine (l'espérance restant inchangée)	pour que $(val16[$val17]) % des pièces soient acceptées.<br>	Déterminer la valeur de &sigma; arrondie à 10<sup>-3</sup>.	<div class="reponse">	&sigma; &asymp;  
!read oef/embed.phtml r2,5 
$()	</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val20 (en terminale ES) ou $val21 (en terminale S)
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval abs($val22-$val20)<=.001 or	abs($val22-$val21)<=.001
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ecart-type correct ?

!exit

:stat
vsavelist=6,7,8,9,12,14,15,16,17,20,21,22
embedcnt=2
