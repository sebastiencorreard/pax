\title{Loi exponentielle : calcul II}
\language{fr}

\author{Bruno, MIFSUD}
\email{bmifsud@bmifsud@ac-aix-marseille.fr}
\computeanswer{yes}
\format{html}
\precision{1000}



\real{lambda=randint(2..20)/100}
\real{a=randint(2..20)/10}
\real{b=\a+randint(1..100)/10}


\function{f=\lambda*exp(-\lambda*x)}
  
    
        \text{mom=l'espérance de \(X\)}
        \text{momtex=\(E(X)\)}
        \real{moment=int(x*\f,x=0..INF)}

      

           \real{Prob1=int(\f,x=0..\a)}
           \real{Prob2=int(\f,x=\a..\b)}
          


\statement{
<div class="enonce"> Soit \(X\) une variable aléatoire suivant la loi exponentielle de paramètre \(\lambda).
<p class="consigne">Garder au moins 4 chiffres significatifs</p>
</div>

<div class="question">
 Calculer la probabilité que l'événement \(X<\a)  se réalise. 
 <div class="reponse">
\(P( X<\a ) =) \embed{reply1,20} 
</div>
</div>

<div class="question"> Calculer la probabilité que l'événement \(\a<X<\b)  se réalise. 
<div class="reponse">
\(P( \a<X<\b ) =) \embed{reply2,20} 
</div>
</div>

<div class="question"> Déterminer \mom.
<div class="reponse">\momtex = \embed{reply3} 
</div>
</div>

}

\answer{\(P( X<\a )\)}{\Prob1}{type=numeric}
\answer{\(P( \a<X<\b )\)}{\Prob2}{type=numeric}
\answer{\mom}{\moment}{type=numeric}

\solution{
Pour une loi exponentielle de paramètre \(\lambda) sur \(\RR^{+}) on sait que :
<ul><li>
\momtex = \(1/\lambda) </li>
<li>\(P( \a < X < \b )= e^{-\lambda \times \a}-e^{-\lambda \times \b})</li>
<li>\(P(  X < \a )= 1-e^{-\lambda \times \a})</li>
<li>\(P(  \a < X )= e^{-\lambda \times \a})</li>
</ul>}
