\title{Loi à densité}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{u=randint(1..5)}
\integer{v=randint(6..10)}
\integer{b=0}
\while{\b=0}{\integer{b=randint(-2..2)}}


\text{const=1/(\v-\u),2/(\v^2-\u^2),\u*\v/(\v-\u),\b/((\v)^(\b)-(\u)^(\b)),
1/(\v-\u)}

\integer{iconst=randint(1..5)}
\if{\iconst=4}{\if{\u=1}{\text{u=0}}{\text{u=ln(\u)}} \text{v=ln(\v)}}
\if{\iconst=5}{\if{\u=1}{\text{u=e}}{\text{u=e^\u}} \text{v=e^\v}}
\rational{a=\const[\iconst]}
\text{f=\a,\a x,\a/x^2,\a*e^(\b*x), \a/x}
\real{int=maxima(integrate(\f[\iconst],x,\u,\v))}

\integer{ucentnon=floor(\u*100)-1}
\integer{ucentoui=floor(\u*100)+1}
\integer{vcentoui=floor(\v*100)-1}
\integer{vcentnon=floor(\v*100)+1}

\real{xnon=randint(\ucentnon-100..\ucentnon)/100}
\real{ynon=randint(\vcentnon..\vcentnon+100)/100}
\real{xoui=randint(\ucentoui..\vcentoui-1)/100}
\real{youi=randint(100*\xoui..\vcentoui)/100}

\real{unum=maxima(\u)}
\real{vnum=maxima(\v)}

\real{rep31=maxima(integrate(\f[\iconst],x,\xoui,\youi))}
\real{rep3=rint(\rep31*1000)/1000}
\real{rep41=maxima(integrate(\f[\iconst],x,\u,\xoui))}
\real{rep4=rint(\rep41*1000)/1000}
\real{rep51=maxima(integrate(\f[\iconst],x,\youi,\v))}
\real{rep5=rint(\rep51*1000)/1000}
\real{rep61=maxima(\rep31/integrate(\f[\iconst],x,\u,\youi))}
\real{rep62=maxima(\rep3/integrate(\f[\iconst],x,\u,\youi))}
\real{rep6a=rint(\rep61*1000)/1000}
\real{rep6b=rint(\rep62*1000)/1000}



\statement{

<div class="enonce">
Soit X une variable aléatoire qui suit une loi de densité la fonction \(f) 
définie sur 
l'intervalle [\(\u);\(\v)] par \(f(x)=\f[\iconst]).
<p class="consigne">
Les probabilités seront arrondies au millième.</p>
</div>


<div class="question">
Quelles sont les valeurs possibles de X ?
<div class="reponse">
\embed{r1,5} &le; X &le; \embed{r2,5}
</div>
</div>

<div class="question">
Quelle est la probabilité que X soit compris entre \xoui et \youi ?
<div class="reponse">
P(X &isin; [\xoui,\youi]) &asymp; \embed{r3,5}
</div>
</div>


<div class="question">
Quelle est la probabilité que X soit compris entre \xnon et \xoui ?
<div class="reponse">
P(X &isin; [\xnon;\xoui]) &asymp; \embed{r4,5}
</div>
</div>

<div class="question">
Quelle est la probabilité que X soit compris entre \youi et \ynon ?
<div class="reponse">
P(X&isin;[\youi;\ynon]) &asymp; \embed{r5,5}
</div>
</div>

<div class="question">
Sachant que X &le; \youi, quelle est la probabilité que X &ge; \xoui ?
<div class="reponse">
P<sub>(X&le;\youi)</sub>(X &ge; \xoui) &asymp; \embed{r6,5}
</div>
</div>

}

\answer{}{\u}{type=algexp}
\answer{}{\v}{type=algexp}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=numeric}
\answer{}{\rep5}{type=numeric}
\answer{}{\rep6}{type=numeric}
\condition{\rep6=\rep6a or \rep6=\rep6b}
