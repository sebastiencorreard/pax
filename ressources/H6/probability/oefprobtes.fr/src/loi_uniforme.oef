\title{Loi uniforme : choix d'un nombre au hasard}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\integer{a=randint(-5..10)}
\integer{b=randint(15..20)}
\integer{xnon=randint(-6..\a-1)}
\integer{xoui=randint(\a+1..\b-1)}
\integer{youi=randint(\xoui..\b)}
\integer{ynon=randint(\b+1..25)}

\text{comp=inférieur, supérieur}
\integer{icomp=randint(1..2)}
\if{\icomp=1}{\text{infsup=&le;}}{\text{infsup=&ge;}}

\real{rep1=rint((\youi-\xoui)/(\b-\a)*1000)/1000}

\real{rep2=rint((\youi-\a)/(\b-\a)*1000)/1000}
\if{\icomp=1}{\real{rep3=rint((\xoui-\a)/(\b-\a)*1000)/1000}}{\real{rep3=rint((\b-\xoui)/(\b-\a)*1000)/1000}}
\rational{rep4=rint((\youi-\xoui)/(\youi-\a)*1000)/1000}
\real{rep5=(\a+\b)/2}

\statement{
<div class="enonce">
On choisit un nombre réel X au hasard entre \a et \b. On suppose que X suit la loi 
uniforme sur l'intervalle [\a,\b].
<div class="consigne">
Les probabilités seront arrondies au millième.
</div>
</div>


<div class="question">
Quelle est la probabilité que X soit compris entre \xoui et \youi ? 
<div class="reponse">
P(\xoui &le; X &le; \youi)=\embed{r1,5}
</div>
</div>

<div class="question">
Quelle est la probabilité que X soit compris entre \xnon et \youi ?
<div class="reponse">
P(\xnon &le; X &le; \youi)=\embed{r2,5}
</div>
</div>

<div class="question">
Quelle est la probabilité que X soit \comp[\icomp] ou égal à \xoui ?
<div class="reponse">
P(X \infsup \xoui)=\embed{r3,5}
</div>
</div>

<div class="question">
Sachant que le nombre choisi est inférieur ou égal à \youi, quelle est la probabilité qu'il soit 
supérieur ou égal à \xoui ?
<div class="reponse">
P<sub><sub>(X &le;\youi)</sub></sub>(X &ge; \xoui)=\embed{r4,5}
</div>
</div>

<div class="question">
Quelle est l'espérance de X ? 
<div class="reponse">
E(X)=\embed{r5,5}
</div>
</div>
}

\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}
\answer{}{\rep3}{type=numeric}
\answer{}{\rep4}{type=numeric}
\answer{}{\rep5}{type=numeric}
