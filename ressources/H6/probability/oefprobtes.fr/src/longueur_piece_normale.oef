\title{Loi normale : longueur d'une pièce}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\text{dispersion=de variance, d'écart-type}
\integer{i=randint(1..2)}
\text{moyenne=randitem(de moyenne, d'espérance)}

\real{m=randint(5..100)}
\real{variance=(randint(1..20)/10)^2}
\real{sig=sqrt(\variance)}
\if{\i=1}{\text{s=\variance}}{\text{s=\sig}}
\real{coeff=randint(1..10)/5}
\real{b1=\m-\coeff*\sig}
\real{b2=\m+\coeff*\sig}

\text{pourcent=99,95}\integer{j=randint(1..2)}

\real{p=maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,-\coeff,\coeff))}
\real{pourcentage=rint(\p*1000)/10}

\if{\j=1}{\real{rep21=rint(((\b2-\m)/3)*1000)/1000}}{\real{rep21=rint(((\b2-\m)/2)*1000)/1000}}
\if{\j=1}{\real{rep22=rint(((\b2-\m)/2.58)*1000)/1000}}{\real{rep22=rint(((\b2-\m)/1.96)*1000)/1000}}


\statement{
<div class="enonce">
Une machine produit des pièces dont la longueur est une variable aléatoire X qui suit une loi
normale \moyenne \m mm et \dispersion[\i] \s \if{\i=1}{mm<sup>2</sup>}{mm}.<br>

Une pièce est "acceptable" si sa longueur est comprise entre \b1 mm et \b2 mm.
</div>

<div class="question">
Quel est le pourcentage, arrondi au dixième,
de pièces acceptables produites par cette machine ?
<div class="reponse">
p &asymp; \embed{r1,5}%.
</div>
</div>


<div class="question">
On souhaite régler l'écart-type &sigma; de cette machine (l'espérance restant inchangée)
pour que \pourcent[\j] % des pièces soient acceptées.<br>
Déterminer la valeur de &sigma; arrondie à 10<sup>-3</sup>.
<div class="reponse">
&sigma; &asymp; \embed{r2,5}
</div>
</div>
}


\answer{}{\pourcentage}{type=numeric}
\answer{}{\rep2}{type=numeric}
\condition{Ecart-type correct ?}{abs(\rep2-\rep21)<=.001 or
abs(\rep2-\rep22)<=.001}
\solution{\rep21 (en terminale ES) ou \rep22 (en terminale S)}
