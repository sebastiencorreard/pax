\title{Loi normale : taille, poids d'une personne}
\language{fr}
\author{Khalid, EL HMOUZI}
\email{khalidhmouzi@gmail.com}
\format{html}
\computeanswer{no}
\precision{100000}

\text{age=4,7,11,16,18}
\text{mtf=100,118,141,163,164}
\text{stf=4,4.5,5,5,5}
\text{mtg=101,119,141,171,175}
\text{stg=4,5,5,6,5}
\text{mpg=15,23,33,58,64}
\text{spg=1.5,1.5,3.3,6,6}
\text{mpf=16,21,33,52,52}
\text{spf=1.5,2.5,5,6,6}
\integer{j=randint(1..5)}

\text{sexe=garçon,fille}
\text{c=taille,poids}
\integer{is=randint(1..2)}
\integer{ic=randint(1..2)}
\if{\ic=1}{\text{unit=cm}}{\text{unit=kg}}

\real{coeff1=randint(1..30)/10}
\real{coeff2=randint(1..30)/10}

\if{\is=1 and \ic=1}{\real{borne2=\mtg[\j]+\coeff2*\stg[\j]}} 
\if{\is=1 and \ic=2}{\real{borne2=\mpg[\j]+\coeff2*\spg[\j]}}
\if{\is=2 and \ic=1}{\real{borne2=\mtf[\j]+\coeff2*\stf[\j]}}
\if{\is=2 and \ic=2}{\real{borne2=\mpf[\j]+\coeff2*\spf[\j]}}

\if{\is=1 and \ic=1}{\real{borne1=\mtg[\j]-\coeff1*\stg[\j]}} 
\if{\is=1 and \ic=2}{\real{borne1=\mpg[\j]-\coeff1*\spg[\j]}}
\if{\is=2 and \ic=1}{\real{borne1=\mtf[\j]-\coeff1*\stf[\j]}}
\if{\is=2 and \ic=2}{\real{borne1=\mpf[\j]-\coeff1*\spf[\j]}}


\text{compar1=inférieure,supérieure}
\text{compar2=inférieur,supérieur}
\integer{icompar=randint(1..2)}
\text{pm=moins, plus}
\integer{ipm=randint(1..2)}

\if{\ic=1}{\text{compar=\compar1[\icompar]}}{\text{compar=\compar2[\icompar]}}

\if{\icompar=1}{\text{rep1=\(\le)}}{\text{rep1=\(\ge)}}
\if{\icompar=1}{\real{rep21=maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,-10^99,\coeff2))}}
\if{\icompar=2}{\real{rep21=maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,\coeff2,10^99))}}
\real{rep2=rint(\rep21*1000)/1000}

\if{\ipm=1}{\text{rep3=\(\ge)}}{\text{rep3=\(\le)}}
\if{\ipm=1}{\real{rep41=maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,-\coeff1,10^99))}}
\if{\ipm=2}{\real{rep41=maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,-10^99,-\coeff1))}}
\real{rep4=rint(\rep41*1000)/1000}

\real{rep51=100*maxima(integrate(1/sqrt(2*pi)*exp(-x^2/2),x,-\coeff1,\coeff2))}
\real{rep5=rint(\rep51*10)/10}
\text{symboles=\(\le),\(\ge)}

\statement{
<div class="enonce">
\if{\ic=1}{La}{Le} \c[\ic], en \unit, \if{\is=1}{d'un}{d'une} \sexe[\is] \if{\is=1}{agé}{agée}
 de \age[\j] ans, est une variable aléatoire X qui suit une loi normale d'espérance m=
\if{\is=1 and \ic=1}{\mtg[\j]} 
\if{\is=1 and \ic=2}{\mpg[\j]}
\if{\is=2 and \ic=1}{\mtf[\j]}
\if{\is=2 and \ic=2}{\mpf[\j]} \unit et d'écart-type \(\sigma)= 
\if{\is=1 and \ic=1}{\stg[\j]} 
\if{\is=1 and \ic=2}{\spg[\j]}
\if{\is=2 and \ic=1}{\stf[\j]}
\if{\is=2 and \ic=2}{\spf[\j]} \unit.
<div class="icon-consigne">
Les probabilités seront arrondies au millième et les pourcentages au dixième.
</div>
</div>



<div class="question">
Quelle est la probabilité que \if{\ic=1}{la}{le} \c[\ic] \if{\is=1}{d'un}{d'une} \sexe[\is] de cet âge 
soit \compar à  \borne2 \unit ?
<div class="reponse">
P(X\embed{r1,50}\borne2) &asymp; \embed{r2,5}
</div>
</div>

<div class="question">
Quelle est la probabilité qu'\if{\is=1}{il}{elle} \if{\ic=1}{mesure}{pèse} au \pm[\ipm] \borne1 
\unit ?
<div class="reponse">
P(X\embed{r3,50}\borne1) &asymp; \embed{r4,5}
</div>
</div>

<div class="question">
Quelle est le pourcentage de \sexe[\is] de \age[\j] ans, \if{\ic=1}{mesurant}{pesant} entre
 entre \borne1 \unit et \borne2 \unit ?
<div class="reponse">  
p &asymp; \embed{r5,5} %
</div>
</div>
}

\answer{}{\rep1;\symboles}{type=clickfill}
\answer{}{\rep2}{type=numeric}
\answer{}{\rep3;\symboles}{type=clickfill}
\answer{}{\rep4}{type=numeric}
\answer{}{\rep5}{type=numeric}
