\title{Loi exponentielle : calcul I}
\language{fr}

\author{Bruno, MIFSUD}
\email{bmifsud@bmifsud@ac-aix-marseille.fr}
\computeanswer{yes}
\format{html}
\precision{1000}

\real{lambda=randint(2..20)/100}
\real{a=randint(2..20)/10}
\real{b=\a+randint(1..100)/10}

\function{f1=e^(-\lambda*x)}
\function{f=\lambda* \f1}



        \text{mom=l'espérance de \(X)}
        \text{momtex=\(E(X))}
        \real{moment=int(x*\f,x=0..INF)}

 \integer{n0=randint(1..3)}

 \real{Fdeb=int(\f,x=0..\deb)}
\if{\n0=1}{\text{ev= X < \a}
           \real{Prob=int(\f,x=0..\a)}}
\if{\n0=2}{\text{ev= X > \a}
           \real{Prob=1 - int(\f,x=0..\a)} }
\if{\n0=3}{\text{ev= \a < X < \b}
          \real{Prob=int(\f,x=\a..\b)}}

\text{indic=Garder au moins 4 chiffres significatifs.}

\statement{
<div class="enonce">
Soit \(X) une variable aléatoire de densité \(f), où la fonction \(f) est définie par : <br>
\(f(x)=\f) si \(x>0) et \(f(x)=0)  sinon.

 <div class="consigne">\indic</div>
</div>

<div class="question">
 Calculer la probabilité que l'événement  \(\ev)  se réalise.
 <div class="reponse">
\(P( \ev ) =) \embed{reply1,20}
</div>
</div>

<div class="question"> Déterminer \mom.
<div class="reponse">\momtex = \embed{reply2}
</div>
</div>



}

\answer{\(P( \ev ))}{\Prob}{type=numeric}
\answer{\mom}{\moment}{type=numeric}

\solution{

Pour une loi exponentielle de paramètre \(\lambda) sur \(\RR^{+}) on sait que :
<ul><li>
\momtex = \(1/\lambda) </li>
<li>\(P( \a < X < \b )= e^{-\lambda \times \a}-e^{-\lambda \times \b})</li>
<li>\(P(  X < \a )= 1-e^{-\lambda \times \a})</li>
<li>\(P(  \a < X )= e^{-\lambda \times \a})</li>
</ul>
}
