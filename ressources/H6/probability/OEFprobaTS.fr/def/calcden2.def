!set title=E. Calcul de dénombrement 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=combinatorics
precision=1000
oefdescription=Dénombrement des anagrammes d'un mot

ansorder=r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=SPORT,5	TABLE,5	COURSE,6	DEPART,6	ROUGE,5	TRAIN,5	LECON,5	JOIE,4	SURF,4	VIRUS,5	ESPOIR,6	CRISTAL,7	
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val8=$(val7[1])
val9=$[rint($(val7[2])!)]
tmp0=!texmath $(val7[2])!

val10=$(tmp0)
val11=$[rint($(val7[2])^$(val7[2]))]
val12=TASSE,5!,2,il y une lettre en double	TOIT,4!,2, il y a une lettre en double	SPORTS,6!,2, il y a une lettre en double	PARABOLE,8!,2, il y a une lettre en double	COUCOU,6!,(2!*2!*2!), il y a trois lettres en double	ARTISTES, 8!,(2!*2!), il y a deux lettres en double	BALLE,5!,2,il y a une lettre en double	IRIS,4!,2!,il y a une lettre en double	MEDECIN,7!,2!, il y a une lettre en double	VACCIN,6!,2!,il y a une lettre en double	ENTETE,6!,(3!*2!), il y a une lettre en double et une lettre en triple	ACACIA, 6!,(3!*2!), il y a une lettre en double et une lettre en triple	RASSURER, 8!,(3!*2!),il y a une lettre en double et une lettre en triple	MALARIA, 7!,3!, il y a une lettre en triple	MANGA,5!,2!, il y a une lettre en double	EXEMPLE,7!,3!, il y a une lettre en triple	AVATAR,6!,3!, il y a une lettre en triple	TERROIR,7!,3!,il y a une lettre en triple	
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$(val13[1])
val15=$[rint($(val13[2])/$(val13[3]))]
tmp0=!texmath $(val13[2])

val16=$(tmp0)
val17=$[rint(1)]
!if $val17=1 
val18=$val8
val19=$[rint($val9)]
val20=$val10
val21=$val14
val22=$[rint($val15)]
val23=$val16
val24=car il y a $(val7[2]) lettres distinctes
val25=car $(val13[4])
!endif
!if $val17=2 
val21=$val8
val22=$[rint($val9)]
val23=$val10
val18=$val14
val19=$[rint($val15)]
val20=$val16
val25=car il y a $(val7[2]) lettres distinctes
val24=car $(val13[4])
!endif
val26=De combien de façons différentes peut-on ordonner les lettres du mot
val27=il y a
val28=façons différentes d'ordonner les lettres du mot
val29=Le mot $val18 comporte $(val7[2]) lettres toutes différentes, on peut donc	voir une suite constituée avec les lettres de ce mot comme une permutation d'un ensemble ayant $(val7[2]) éléments.
val30=Si on distingue les lettres qui apparaissent plusieurs fois dans $val21 en leur ajoutant un numéro,	il y aurait \($(val13[2])\) façons différentes d'ordonner	les lettres de ce mot. Il suffit ensuite de déterminer combien de fois on peut changer l'ordre des numéros des lettres	qui sont en plusieurs exemplaires, pour savoir combien de suites sont réellement différentes si on oublie les numéros attribués	à certaines lettres. 
val31=Donc
oefsteps=reply1	reply2 
nextstep=!nosubst reply1	reply2 
!readproc oef/steps.proc
replytype1=numexp
replyname1=$val18
replygood1=$val19
replytype2=numexp
replyname2=$val21
replygood2=$val22
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} \begin{enumerate} \item $val26 $val18 ? \item $val26 $val21 ? \end{enumerate} \end{statement} \begin{solution} \begin{enumerate} \item $val29 $val31, $val27 $val19 $val28 $val18. \item $val30 $val31, $val27 $val22 $val28 $val21. \end{enumerate} \end{solution} 


!goto stat

!exit

:question
$()<ol>	<li>	
!if $m_step=1 
$()<label for="reply1">$val26 $val18 ?</label>	  
!read oef/embed.phtml reply1,7 
$()	  
!else
$() $val26 $val18 ? <span class="oef_indgood">$m_reply1</span> 
!endif
$()	</li>
!if $m_step>=2 
$()<li>	<label for="reply2">$val26 $val21 ?</label>  
!read oef/embed.phtml reply2,7 
$()	</li> 
!endif
$()	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()<b>Indications</b>	<p>$val29 </p>	
!if $m_sc_reply1=1 
$()<p>$val30</p>  
!endif
$()	
$()
!exit

:latex
$() $m_begin{statement} $m_begin{enumerate} $m_item $val26 $val18 ? $m_item $val26 $val21 ? $m_end{enumerate} $m_end{statement} $m_begin{solution} $m_begin{enumerate} $m_item $val29 $val31, $val27 $val19 $val28 $val18. $m_item $val30 $val31, $val27 $val22 $val28 $val21. $m_end{enumerate} $m_end{solution} 
$()
!exit

:feedback
!ifval $m_reply1 <$val19
 <div class='oef_feedbacks'>Il y a plus de façons différentes d'ordonner les $(val7[2]) lettres de ce mot.
$()</div>
!endif
!ifval $m_reply1 =$val11
 <div class='oef_feedbacks'>Le nombre que vous avez donné correspond au nombre de suite de lettres que l'on peut	constituer si on disposait d'autant d'exemplaires des lettres du mot $val18 que nécessaire.
$()</div>
!endif
!ifval $m_sc_reply1=1 and $m_sc_reply2 < 1
 <div class='oef_feedbacks'>A la différence du $val18, remarquez que certaines lettres du mot $val21 apparaissent plusieurs fois.
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,11,18,19,21,22,26,27,28,29,30,31
embedcnt=2
