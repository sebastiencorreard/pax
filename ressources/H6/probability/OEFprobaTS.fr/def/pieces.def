!set title=F1. Pièces
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=events,modelling,probability
language=fr
computeanswer=no
precision=1000
oefdescription=Exercice de modélisation
oefobservation=L'exercice porte sur une pièce équilibrée

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 50

val6=$[rint($(tmp0))]
tmp0=!randint $val6/3, 2*$val6/3

val7=$[rint($(tmp0))]
val8=$[binomial($val6,$val7)/(2^$val6)]
!readproc slib/text/approximation $val8,3 
tmp0=$slib_out
val9=$(tmp0)
val10=On suppose que chaque fois qu'on jette une pièce, la probabilité	  d'obtenir face dessus est exactement de 1/2.
val11=Si l'on jette $val6 fois la pièce
val12=quelle est la probabilité d'obtenir exactement $val7 fois la face&nbsp;
val13=La réponse est demandée avec au moins 3 chiffres significatifs.
val14=La probabilité est égale à
val15=Il y a
val16=façons distinctes de répartir les $val7 faces parmi les $val6 jets de pièce.	 Et chaque répartition particulière a une probabilité de
val17=d'être réalisée
val18=Donc, la probabilité d'obtenir exactement $val7 fois la face est
replytype1=range
replyname1=$val14
replygood1=!rawmath $(val9[1..2]),$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val10\newline $val11, $val12 ? (\emph{$val13}) \end{statement} \begin{solution} $val15 \(\displaystyle\binom{$val6}{$val7}\) $val16 \((1/2)^{$val6}\) $val17. $val18 \(\displaystyle\binom{$val6}{$val7}\times (1/2)^{$val6}\simeq $(val9[3]).\) \end{solution} 


!goto stat

!exit

:question
$()$val10	<div class="wims_question">	  $val11, <label for="reply1">$val12?</label> 
!read oef/embed.phtml reply1,5 
$()	<div class="wims_instruction">	  $val13	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val15 
!insmath \displaystyle\binom{$val6}{$val7}
$() $val16	 
!insmath (1/2)^{$val6}
$(). $val18 
!insmath \displaystyle\binom{$val6}{$val7}\times (1/2)^{$val6}\simeq $(val9[3]).
$()
$()
!exit

:latex
$()$m_begin{statement} $val10$m_newline $val11, $val12 ? ($m_emph{$val13}) $m_end{statement} $m_begin{solution} $val15 
!insmath \displaystyle\binom{$val6}{$val7}
$() $val16 
!insmath (1/2)^{$val6}
$() $val17. $val18 
!insmath \displaystyle\binom{$val6}{$val7}\times (1/2)^{$val6}\simeq $(val9[3]).
$() $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10,11,12,13,15,16,17,18
embedcnt=1
