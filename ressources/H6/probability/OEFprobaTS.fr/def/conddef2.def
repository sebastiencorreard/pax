!set title=G. Probabilité conditionnelle : définition 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=conditional_probability,independent_events
computeanswer=no
precision=199
oefdescription=Pour se familiariser avec la définition de probabilité conditionnelle

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 80

val6=$[$(tmp0)/100]
tmp0=!randint 10, 80

val7=$[$(tmp0)/100]
tmp0=!randint 1, 9

val8=$[$val7-$(tmp0)/100]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]

!ifval $val9=1
val11=\(P_B(A)\)
!else
val11=\(P_A(B)\)
!endif
val12=On considère deux événements \(A\) et \(B\).
val13=On connaît les probabilités suivantes
val14=Calculer
val15=Les événements \(A\) et \(B\) sont-ils indépendants 
val16=Indépendance de \(A\) et \(B\)
val17=Oui,Non
val18=\begin{radio}\item $(val17[1]) \item $(val17[2])\end{radio}
val19=$(val17[$val10])

!ifval $val9=2
val20=P_B(A)
!else
val20=P_A(B)
!endif

!ifval $val10=1
val21=$[$val6*$val7]
!else
val21=$[$val6*$val8]
!endif

!ifval $val9=2
val22=$[$val21/$val7]
!else
val22=$[$val21/$val6]
!endif
val22=$[round($val22*100)/100]

!ifval $val9=1
val23=$[$val22*$val6/$val7]
!else
val23=$[$val22*$val7/$val6]
!endif
val24=$[round($val23*100)/100]
!if $val23=$val24 
val25=\(=$val23\)
!else
val25=\(\simeq $val24\)
!endif
val26=Arrondir à \(10^{-2}\).
val27=\($val20=$val22\).
replytype1=numeric
replyoption1=absolute 
replyname1=$val11
replygood1=$[$val24]
replytype2=radio
replyname2=$val16
replygood2=$val10;$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12 $val13 : \[P(A)=$val6\quad P(B)=$val7 \text{ et }P(A\cap B)=$val21.\] \begin{enumerate} \item $val14 $val11 (\emph{\small $val26}) \item $val15 ? $val18 \end{enumerate} \end{statement} \begin{solution} \begin{enumerate} \item $val11 $val25. \item $val15 ? $val19 \end{enumerate} \end{solution} 


!goto stat

!exit

:question
