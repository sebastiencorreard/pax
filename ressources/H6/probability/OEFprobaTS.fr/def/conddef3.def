!set title=G. Probabilité conditionnelle : définition 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=conditional_probability
computeanswer=no
precision=199
oefdescription=Pour se familiariser avec la définition de probabilité conditionnelle
oefobservation=cas où A est inclus dans B ou l'inverse

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]

!ifval $val6=1
val7=\(A \subset B\)
!else
val7=\(B \subset A\)
!endif
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]

!ifval $val8=1
val9=\(P_B(A)\)
!else
val9=\(P_A(B)\)
!endif
!if $val6=1 

!ifval $val8=1
val10=P(A)/P(B)
!else
val10=1
!endif
!else

!ifval $val8=2
val10=P(B)/P(A)
!else
val10=1
!endif
!endif
val11=On considère deux événements \(A\) et \(B\) de probabilité non nulle, tels que
val12=Exprimer
val13=en fonction de \(P(A)\) et de \(P(B)\)
replytype1=formal
replyname1=$val9
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val11 $val7.\newline $val12 $val9 $val13. \end{statement} \begin{solution} $val9 = $val10 \end{solution} 


!goto stat

!exit

:question
$()$val11	$val7.	<div class="wims_question">	  $val12 $val9 $val13 :	<div class="wimscenter"><label for="reply1">$val9 =</label>  
!read oef/embed.phtml reply1,10 
$().</div>	</div>	
$()
!exit

