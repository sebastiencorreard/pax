val6=Il y a 
val7=balles
val8=et
val9=dans un sac
val10=du sac
val11=Si
val12=sont tirées
val13=quelle est la probabilité d'obtenir 
val14=aléatoirement
val15=La probabilité est égale à 
val16=La réponse est demandée avec au moins 3 chiffres significatifs.
val17=façons de tirer
val18=Donc la probabilité demandée est
val19=parmi
val20=signifie que l'on suppose que toutes les balles du sac ont la même chance d'être tirée.
val21=noires
val22=blanches
val23=deux
tmp0=!randint 6, 20

val24=$[rint($(tmp0))]
tmp0=!randint 6, 20

val25=$[rint($(tmp0))]
val26=$[rint($val24+$val25)]
tmp0=!randint 1, 3

val27=$[rint($(tmp0))]
tmp0=!item $val27 of une noire et une blanche,deux noires,deux blanches

val28=$(tmp0)
tmp0=!item $val27 of 2*$val24*$val25/($val26*($val26-1)),	    $val24*($val24-1)/($val26*($val26-1)),	    $val25*($val25-1)/($val26*($val26-1))

val29=$[$(tmp0)]
!readproc slib/text/approximation $val29,3 
tmp0=$slib_out
val30=$(tmp0)
val31=$(val30[3])
val32=$[rint($val24-1)]
val33=$[rint($val25-1)]
val34=$[rint($val26-1)]
tmp0=!texmath $val26*$val34

val35=$(tmp0)
tmp0=!item $val27 of \(\displaystyle\binom{$val24}{1}\times\displaystyle\binom{$val25}{1}\),\(\displaystyle\binom{$val24}{2}\),\(\displaystyle\binom{$val25}{2}\)

val36=$(tmp0)
tmp0=!item $val27 of 2*$val24*$val25,$val24*$val32,$val25*$val33

val37=$(tmp0)
tmp0=!texmath $val37

val37=$(tmp0)
val38=$val6 $val24 $val7 $val21 $val8 $val25 $val22 $val9.
replytype1=range
replyname1=$val15
replygood1=!rawmath $(val30[1..2]),$val29
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst <span class=wims_emph>"$val14"</span> $val20

solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val38 \newline $val11 $val23 $val7 $val12 $val14 $val10, $val13 $val28~? (\emph{\small $val16}) \end{statement} \begin{solution} $val6 \(\displaystyle\binom{$val26}{2}\) $val17 $val23 $val7 $val19 $val26 $val7.\newline $val6 $val36 $val17 $val28. \newline $val18~: \(\frac{$val37}{$val35}\simeq $val31\). \end{solution} 


