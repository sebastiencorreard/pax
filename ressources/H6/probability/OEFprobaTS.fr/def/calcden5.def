!set title=E. Calcul de dénombrement 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=combinatorics
precision=1000
oefdescription=Dénombrement pour trois types de tirages

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans chacun des cas suivants, dénombrer les façons de tirer
val7=Une urne contient, indiscernables au toucher numérotées de 1 à
val8=successivement et avec remise,successivement et sans remise,simultanément
val9=boules
val10=Il y a, façons de tirer, dans cette urne
val11=boules noires, boules blanches
val12=On est dans la même situation que si on avait
val13=et
tmp0=!randint 5, 10

val14=$[rint($(tmp0))]
tmp0=!randint 5, 10

val15=$[rint($(tmp0))]
val16=$[rint($val14+$val15)]
tmp0=!randint 2, 5

val17=$[rint($(tmp0))]
val18=$[rint(binomial($val16,$val17))]
t_=!replace internal \( by ( in $val16^$val17
tmp0=!exec pari $t_

t_=!replace internal \( by ( in ($val16!)/(($val16-$val17)!)
tmp1=!exec pari $t_

val19=$(tmp0),$(tmp1),$val18
tmp0=!shuffle 3

val20=$(tmp0)
val21=$(val7[1]) $val14 $(val11[1]) $(val7[2]) $val14	  $val13 $val15 $(val11[2]) $(val7[2]) $val15.
val22=\begin{enumerate}	 \item $(val8[$(val20[1])])	 \item $(val8[$(val20[2])])	 \item $(val8[$(val20[3])])	 \end{enumerate} 
val23=$(val10[1]) \begin{enumerate}	 \item $(val19[$(val20[1])]) $(val10[2]) $(val8[$(val20[1])]) $val17 $val9 $(val10[3]).	 \item $(val19[$(val20[2])]) $(val10[2]) $(val8[$(val20[2])]) $val17 $val9 $(val10[3]).	 \item $(val19[$(val20[3])]) $(val10[2]) $(val8[$(val20[3])]) $val17 $val9 $(val10[3]).	 \end{enumerate} 
replytype1=numexp
replyname1=$(val8[$(val20[1])])
replygood1=$(val19[$(val20[1])])
replytype2=numexp
replyname2=$(val8[$(val20[2])])
replygood2=$(val19[$(val20[2])])
replytype3=numexp
replyname3=$(val8[$(val20[3])])
replygood3=$(val19[$(val20[3])])
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val12 $val16 $val9 $(val7[2]) $val16.

latex=!nosubst  \begin{statement} $val21\newline $val6 $val17 $val9 $val22 \end{statement} \begin{solution} $val23 \end{solution} 


!goto stat

!exit

:question
$()	 $val21	<div class="wims_question">	  $val6 $val17 $val9	<ol class="spacer">	<li><label for="reply1">$(val8[$(val20[1])]) :</label>  
!read oef/embed.phtml reply1,7 
$()</li>	<li><label for="reply2">$(val8[$(val20[2])]) :</label>  
!read oef/embed.phtml reply2,7 
$()</li>	<li><label for="reply3">$(val8[$(val20[3])]) :</label> 
!read oef/embed.phtml reply3,7 
$()</li>	</ol>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val12 $val16 $val9 $(val7[2]) $val16.
$()
!exit

:latex
$() $m_begin{statement} $val21$m_newline $val6 $val17 $val9 $val22 $m_end{statement} $m_begin{solution} $val23 $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,12,16,17,20,21,22,23
embedcnt=3
