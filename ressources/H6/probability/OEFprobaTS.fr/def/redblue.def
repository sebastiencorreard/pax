val6=Il y a 
val7=balles
val8=et
val9=dans un sac
val10=du sac
val11=Si
val12=sont tirées
val13=quelle est la probabilité d'obtenir 
val14=aléatoirement
val15=La probabilité est égale à 
val16=La réponse est demandée avec au moins 3 chiffres significatifs.
val17=façons de tirer
val18=Donc la probabilité demandée est
val19=parmi
val20=signifie que l'on suppose que toutes les balles du sac ont la même chance d'être tirée.
val21=rouges,rouge
val22=vertes,verte
val23=deux
val24=une
val25=balle
tmp0=!randint 8, 20

val26=$[rint($(tmp0))]
tmp0=!randint 8, 20

val27=$[rint($(tmp0))]
val28=$[rint($val26+$val27)]
tmp0=!randint 3, 7

val29=$[rint($(tmp0))]
tmp0=!randint 1, $val29-1

val30=$[rint($(tmp0))]
val31=$[rint($val29-$val30)]
val32=$[binomial($val26,$val30)*binomial($val27,$val31)/binomial($val28,$val29)]
!readproc slib/text/approximation $val32,3 
tmp0=$slib_out
val33=$(tmp0)
val34=$(val33[3])
val35=$val6 $val26 $val7 $(val21[1]) $val8 $val27 $(val22[1]) $val9.
!if $val30=1 
val36=$val24
val37=$(val21[2])
val38=$val25
!else
val36=$val30
val37=$(val21[1])
val38=$val7
!endif
!if $val31=1 
val39=$val24
val40=$(val22[2])
val41=$val25
!else
val39=$val31
val40=$(val22[1])
val41=$val7
!endif
val42=$val13 $val36 $val37 $val8 $val39 $val40
val43=$val17 $val29 $val7 $val19 $val28 $val7
val44=$val17 $val36 $val38 $val37 $val19 $val26 $val7 $(val21[1])
val45=$val17 $val39 $val41 $val40 $val19 $val27 $val7 $(val22[1])
replytype1=range
replyname1=$val15
replygood1=!rawmath $(val33[1..2]),$val32
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst <span class=wims_emph>"$val14"</span> $val20

solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val35 \newline $val11 $val29 $val7 $val12 \special{help alea, $val14} $val10, $val42~? (\emph{\small $val16}) \end{statement} \begin{solution} $val6 \begin{enumerate} \item \(\displaystyle\binom{$val28}{$val29}\) $val43~; \item \(\displaystyle\binom{$val26}{$val30}\) $val44~; \item \(\displaystyle\binom{$val27}{$val31}\) $val45. \end{enumerate} $val18~: \(\frac{\displaystyle\binom{$val26}{$val30}\times \displaystyle\binom{$val27}{$val31}}{\displaystyle\binom{$val28}{$val29}}\simeq $val34\). \end{solution} 


