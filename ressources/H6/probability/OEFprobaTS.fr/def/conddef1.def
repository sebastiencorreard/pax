!set title=G. Probabilité conditionnelle : définition 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=conditional_probability,independent_events
computeanswer=no
precision=199
oefdescription=Pour se familiariser avec la définition de probabilité conditionnelle

ansorder=r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 80

val6=$[$(tmp0)/100]
tmp0=!randint 10, 80

val7=$[$(tmp0)/100]
tmp0=!randint 1, 9

val8=$[$val7-$(tmp0)/100]
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
tmp0=!randitem 1,2

val10=$[rint($(tmp0))]

!ifval $val9=1
val11=\(P_B(A)\)
!else
val11=\(P_A(B)\)
!endif
val12=On considère deux événements \(A\) et \(B\).
val13=On connaît les probabilités suivantes
val14=Calculer
val15=Les événements \(A\) et \(B\) sont-ils indépendants 
val16=Indépendance de \(A\) et \(B\)
val17=Oui,Non
val18=\begin{radio}\item $(val17[1]) \item $(val17[2])\end{radio}
val19=$(val17[$val10])

!ifval $val10=1
val20=$[$val6*$val7]
!else
val20=$[$val6*$val8]
!endif

!ifval $val9=1
val21=$[$val20/$val7]
!else
val21=$[$val20/$val6]
!endif
val22=$[round(100*$val21)/100]
!if $val21=$val22 
val23=\(=$val21\)
!else
val23=\(\simeq $val22\)
!endif
val24=Donner le résultat avec au moins 2 chiffres significatifs.
val25=\(P(A\cap B)=$val20\).
replytype1=numeric
replyoption1=absolute noanalyzeprint 
replyname1=$val11
replygood1=$[$val22]
replytype2=radio
replyname2=$val16
replygood2=$val10;$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12 $val13 : \[P(A)=$val6\quad P(B)=$val7 \text{ et }P(A\cap B)=$val20.\] \begin{enumerate} \item $val14 $val11 (\emph{\small $val24}) \item $val15 ? $val18 \end{enumerate} \end{statement} \begin{solution} \begin{enumerate} \item $val11 $val23. \item $val15 ? $val19 \end{enumerate} \end{solution} 


!goto stat

!exit

:question
$()	  $val12 $val13 :	<ul class="inline">	<li class="spacer">	 
!insmath P(A)=$val6
$()	</li><li class="spacer">	 
!insmath P(B)=$val7
$()	</li><li class="spacer">	$val25	</li></ul>	<div class="wims_question">	<ol>	<li>$val14 $val11 :	<div class="wimscenter"><label for="reply1">$val11 = </label> 
!read oef/embed.phtml reply1,5 
$()</div>	<div class="wims_instruction">$val24</div>	</li><li>$val15 ?	 
!read oef/embed.phtml reply2 
$()</li>	</ol>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val12 $val13 : \[P(A)=$val6$m_quad P(B)=$val7 $m_text{ et }P(A$m_cap B)=$val20.\] $m_begin{enumerate} $m_item $val14 $val11 ($m_emph{$m_small $val24}) $m_item $val15 ? $val18 $m_end{enumerate} $m_end{statement} $m_begin{solution} $m_begin{enumerate} $m_item $val11 $val23. $m_item $val15 ? $val19 $m_end{enumerate} $m_end{solution} 
$()
!exit

:feedback
