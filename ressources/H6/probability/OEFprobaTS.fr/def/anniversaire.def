!set title=F4. Anniversaires
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=events,modelling,probability
language=fr
oefdescription=Exercice de modélisation
oefobservation=Seul le nombre de personnes choisies peut varier lorsqu'on recommence l'exercice
computeanswer=no
precision=9000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 60

val6=$[rint($(tmp0))]
tmp0=!item $val6-19 of 	0.4114383835,	0.4436883351,	0.4756953076,	0.5072972343,	0.5383442579,	0.5686997039,	0.5982408201,	0.6268592822,	0.6544614723,	0.6809685374,	0.7063162427,	0.7304546337,	0.7533475278,	0.7749718541,	0.7953168646,	0.8143832388,	0.8321821063,	0.8487340082,	0.8640678210,	0.8782196643,	0.8912318098,	0.9031516114,	0.9140304715,	0.9239228556,	0.9328853685,	0.9409758994,	0.9482528433,	0.9547744028,	0.9605979728,	0.9657796093,	0.9703735795,	0.9744319933,	0.9780045093,	0.9811381134,	0.9838769627,	0.9862622888,	0.9883323548,	0.9901224593,	0.9916649794,	0.9929894484,	0.9941226608

val7=$[$(tmp0)]
val8=$[1-$val7]
val9=Si l'on suppose que les jours d'anniversaire sont	 répartis équitablement parmi les 365 jours de l'année et si l'on	 choisit $val6 personnes au hasard dans l'annuaire, quelle est la probabilité	 pour que deux au moins de ces $val6 personnes aient leur anniversaire le même jour&nbsp;
val10=La réponse est demandée avec au moins 4 chiffres significatifs.
val11=Calculer plutôt la probabilité pour que ces $val6 personnes	 aient toutes leur anniversaire un jour différent.
val12=La probabilité est égale à
val13=Soit \(A\) l'événement&nbsp; <span class="wims_emph">"les $val6 personnes ont toutes leur anniversaire un jour différent".	</span>
val14=où
val15=désigne le nombre d'arrangements de $val6 éléments parmi 365 soit
val16=Donc la probabilité cherchée est
replytype1=numeric
replyname1=$val12
replygood1=$[$val7]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val11

solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val9 (\emph{\small $val10}) \end{statement} \begin{solution} $val13\newline \(P(A)=\frac{A_{365}^{$val6}}{365^{$val6}}=$val8\) $val14 \(A_{365}^{$val6}\) $val15 \(\frac{365!}{(365-$val6)!}\). \newline $val16 \(1-P(A)\simeq$val7\). \end{solution} 


!goto stat

!exit

:question
$()$val9?	<div class="wimscenter"><label for="reply1">$val12</label>  
