!insmath P(A)=\frac{A_{365}^{$val6}}{365^{$val6}}=$val8
$()	$val14 
!insmath A_{365}^{$val6}
$() $val15 
!insmath \frac{365!}{(365-$val6)!}
$().	</p><p>	$val16 
!insmath 1-P(A)\simeq$val7
$().	</p>	
$()
!exit

:latex
$() $m_begin{statement} $val9 ($m_emph{$m_small $val10}) $m_end{statement} $m_begin{solution} $val13$m_newline 
!insmath P(A)=\frac{A_{365}^{$val6}}{365^{$val6}}=$val8
$() $val14 
!insmath A_{365}^{$val6}
$() $val15 
!insmath \frac{365!}{(365-$val6)!}
$(). $m_newline $val16 
!insmath 1-P(A)\simeq$val7
$(). $m_end{solution} 
$()
