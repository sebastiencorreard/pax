!set title=B. Coefficients binomiaux 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=combination
precision=1000
oefdescription=Pour se familiariser avec l'expression des coefficients binomiaux

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 5

val6=$[rint($(tmp0))]
tmp0=!randint $val6, $val6+10

val7=$[rint($(tmp0))]
val8=$[rint(binomial($val7,$val6))]
val9=Calculer le coefficient binomial&nbsp;
replytype1=numexp
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val9 \(\left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right )\). \end{statement} \begin{solution} \(\left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right) =$val8.\) \end{solution} 


!goto stat

!exit

:question
$()	  $val9 
!insmath \left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right )
$().	  <div class="wimscenter">	 <label for="reply1">
!insmath \left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right )=
$()</label> 
!read oef/embed.phtml reply1 
$()	 </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Si 
!insmath n
$() et 
!insmath k
$() désignent des entiers positifs tels que 
!insmath k\leq n
$() alors	
!insmath \left ( \begin{array}{c}n \\ k \end{array} \right )=\frac{n!}{k!\times(n-k)!}
$().
$()
!exit

:latex
$() $m_begin{statement} $val9 
!insmath \left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right )
$(). $m_end{statement} $m_begin{solution} 
!insmath \left ( \begin{array}{c}$val7 \\ $val6 \end{array} \right) =$val8.
$() $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=1
