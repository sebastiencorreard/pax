!set title=E. Calcul de dénombrement 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
keywords=combinatorics
precision=1000
oefdescription=Dénombrement pour trois types de tirages

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Dans chacun des cas suivants, dénombrer les façons de tirer
val7=Une urne contient, indiscernables au toucher numérotées de 1 à
val8=successivement et avec remise,successivement et sans remise,simultanément
val9=boules
val10=Il y a, façons de tirer, dans cette urne
tmp0=!randint 10, 20

val11=$[rint($(tmp0))]
tmp0=!randint 2, 5

val12=$[rint($(tmp0))]
val13=$[rint(binomial($val11,$val12))]
t_=!replace internal \( by ( in ($val11!)/(($val11-$val12)!)
tmp0=!exec pari $t_

val14=$[rint($(tmp0))]
val15=$[rint($val11^$val12)]
val16=$val15,$val14,$val13
val17=\($val11^$val12\),\(\frac{$val11!}{($val11-$val12)!}\),\(\frac{$val11!}{$val12!($val11-$val12)!}\)
tmp0=!shuffle 3

val18=$(tmp0)
val19=$(val7[1]) $val11 $val9 $(val7[2]) $val11.
val20=\begin{enumerate}	 \item $(val8[$(val18[1])])	 \item $(val8[$(val18[2])])	 \item $(val8[$(val18[3])])	 \end{enumerate} 
val21=$(val10[1]) \begin{enumerate}	 \item $(val16[$(val18[1])]) $(val10[2]) $(val8[$(val18[1])]) $val12 $val9 $(val10[3]).	 \item $(val16[$(val18[2])]) $(val10[2]) $(val8[$(val18[2])]) $val12 $val9 $(val10[3]).	 \item $(val16[$(val18[3])]) $(val10[2]) $(val8[$(val18[3])]) $val12 $val9 $(val10[3]).	 \end{enumerate} 
replytype1=numexp
replyname1=$(val8[$(val18[1])])
replygood1=$(val16[$(val18[1])])
replytype2=numexp
replyname2=$(val8[$(val18[2])])
replygood2=$(val16[$(val18[2])])
replytype3=numexp
replyname3=$(val8[$(val18[3])])
replygood3=$(val16[$(val18[3])])
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19\newline $val6 $val12 $val9 $val20 \end{statement} \begin{solution} $val21 \end{solution} 


!goto stat

!exit

:question
$()	 $val19	<div class="wims_question">	  $val6 $val12 $val9	<ol class="spacer">	<li><label for="reply1">$(val8[$(val18[1])]) :</label>  
!read oef/embed.phtml reply1,7 
$()</li>	<li><label for="reply2">$(val8[$(val18[2])]) :</label>  
!read oef/embed.phtml reply2,7 
$()</li>	<li><label for="reply3">$(val8[$(val18[3])]) :</label> 
!read oef/embed.phtml reply3,7 
$()</li>	</ol>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19$m_newline $val6 $val12 $val9 $val20 $m_end{statement} $m_begin{solution} $val21 $m_end{solution} 
$()
!exit

:feedback
!ifval $m_sc_reply1 < 1
 <div class='oef_feedbacks'><div>$(val10[1]) $(val17[$(val18[1])]) $(val10[2]) $val12 $val9 $(val8[$(val18[1])]) $(val10[3]).</div>
$()</div>
!endif
!ifval $m_sc_reply2 < 1
 <div class='oef_feedbacks'><div>$(val10[1]) $(val17[$(val18[2])]) $(val10[2]) $val12 $val9 $(val8[$(val18[2])]) $(val10[3]).</div>
$()</div>
!endif
!ifval $m_sc_reply3 < 1
 <div class='oef_feedbacks'><div>$(val10[1]) $(val17[$(val18[3])]) $(val10[2]) $val12 $val9 $(val8[$(val18[3])]) $(val10[3]).</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,8,9,10,12,17,18,19,20,21
embedcnt=3
