\text{name_extract=sont tirées}
\text{name_quest=quelle est la probabilité d'obtenir }
\text{name_alea=aléatoirement}
\text{name_prob=La probabilité est égale à }
\text{name_consigne=La réponse est demandée avec au moins 3 chiffres significatifs.}
\text{name_tirer= façons de tirer}
\text{name_concl=Donc la probabilité demandée est}
\text{name_in=parmi}
\text{name_defalea=signifie que l'on suppose que toutes les balles du sac ont la même chance d'être tirée.}
\text{name_coul1=rouges,rouge}
\text{name_coul2=vertes,verte}
\text{name_nb=deux}
\text{name_one=une}
\text{name_ballone=balle}
\integer{black=random(8..20)}
\integer{white=random(8..20)}
\integer{total=\black+\white}
\integer{extract=random(3..7)}
\integer{eblack=random(1..\extract-1)}
\integer{ewhite=\extract-\eblack}
\real{sol=binomial(\black,\eblack)*binomial(\white,\ewhite)/binomial(\total,\extract)}
\text{solarr=slib(text/approximation \sol,3)}
\text{solsign=\solarr[3]}
\text{enonce=\name_il \black \name_ball \name_coul1[1] \name_and \white \name_coul2[1] \name_sac1.}
\if{\eblack=1}{\text{nbblack=\name_one}\text{coul1=\name_coul1[2]}\text{ball1=\name_ballone}}
              {\text{nbblack=\eblack}\text{coul1=\name_coul1[1]}\text{ball1=\name_ball}}
\if{\ewhite=1}{\text{nbwhite=\name_one}\text{coul2=\name_coul2[2]}\text{ball2=\name_ballone}}
              {\text{nbwhite=\ewhite}\text{coul2=\name_coul2[1]}\text{ball2=\name_ball}}
\text{quest=\name_quest \nbblack \coul1 \name_and \nbwhite \coul2}
\text{textsol1=\name_tirer \extract \name_ball \name_in \total \name_ball}
\text{textsol2=\name_tirer \nbblack \ball1 \coul1 \name_in \black \name_ball \name_coul1[1]}
\text{textsol3=\name_tirer \nbwhite \ball2 \coul2 \name_in \white \name_ball \name_coul2[1]}
\statement{\enonce
<div class="wims_question"> \name_if \extract \name_ball \name_extract \special{help alea, \name_alea}
 \name_sac2, \quest&nbsp;?
 <div class="wimscenter"><label for="reply1">\name_prob</label> \embed{reply1}</div>
</div>
<div class="wims_instruction"> \name_consigne</div> }
\answer{\name_prob}{\solarr[1..2],\sol}{type=range}
\solution{\name_il
<ul><li>\(\displaystyle\binom{\total}{\extract}\) \textsol1 ;</li>
<li> \(\displaystyle\binom{\black}{\eblack}\) \textsol2 ;</li>
<li> \(\displaystyle\binom{\white}{\ewhite}\) \textsol3.</li>
</ul>
  \name_concl&nbsp;: \(\frac{\displaystyle\binom{\black}{\eblack}\times
