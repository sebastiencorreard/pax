\title{Noires et blanches}

\integer{black=random(6..20)}
\integer{white=random(6..20)}
\integer{total=\black+\white}

\text{name_answer=La probabilité}


\text{name_statement=Il y a \black balles noires et \white balles blanches dans
  un sac. Si deux balles sont tirées aléatoirement du sac, quelle est
  la probabilité d'obtenir}
\text{name_space=&nbsp;}
\text{name_balls=une noire et une blanche,deux noires,deux blanches}

\integer{type=random(1..3)}
\text{balls=item(\type,\name_balls)}
