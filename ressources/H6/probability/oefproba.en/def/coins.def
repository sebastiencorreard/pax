!set title=Coins
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Pièces
title_it=Monete

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 20, 50

val7=$[rint($(tmp0))]
tmp0=!randint $val7/3, 2*$val7/3

val8=$[rint($(tmp0))]
val9=$[binomial($val7,$val8)/2^$val7]
val10=The probability
val11=We suppose that each time we toss a coin, the probability of	  obtaining face up is exactly 1/2.
val12=If we toss $val7 times the coin, what is the probability of obtaining	exactly $val8 times the face up?
val13=There are \(C_$val7^$val8) distinct	  ways for the $val8 faces to be distributed among the $val7 tosses	 of the coin. And each particular distribution has a probability of	 \(1/2^($val7)\).
!if $val6=fr 
val10=La probabilité
val11=On suppose que chaque fois qu'on jette une pièce, la probabilité	  d'obtenir face dessus est exactement de 1/2.
val12=Si l'on jette $val7 fois la pièce, quelle est la probabilité d'obtenir	  exactement $val8 fois la face&nbsp;?
val13=Il y a \(C_$val7^$val8) façons distinctes	  pour les $val8 faces de répartir parmi les $val7 jets de pièce.	  Et chaque répartition particulière a une probabilité de	  1/2^($val7).
!endif
!if $val6=it 
val10=Probabilità
val11=Supponiamo che ogni volta che lanciamo una moneta la probabilità	  di ottenere testa sia esattamente 1/2.
val12=Se lanciamo $val7 volte la moneta, qual è la probabilità di ottenere	  esattamente $val8 volte testa?
val13=Ci sono \(C_$val7^$val8) differenti modi	  in cui le $val8 facce possono essere distibuite nei $val7 lanci	 della moneta. E ogni modo ha probabilità \(1/2^($val7)\).
!endif
replyname1=$val10
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val13


!goto stat

!exit

