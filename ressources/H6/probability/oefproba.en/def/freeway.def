!set title=Walking on highway
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Marche sur autoroute
title_it=Camminare lungo una autostrada

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 15, 25

val7=$[$(tmp0)/100]
tmp0=!randint 8, 15

val8=$[rint($(tmp0))]
val9=$[(1-$val7)^$val8]
val10=The probability
val11=According to the statistics, a pedestrian walking on a certain	  portion of highway during 1 minute has a probability of $val7 to be	  knocked down by a car.
val12=Mr. X wants to make a bet of walking on this portion of highway during $val8	  minutes, without becoming victime of accident. What is his chance to	  win this crazy bet?
val10=His chance
!if $val6=fr 
val10=La probabilité
val11=D'après les statistiques, un piéton marchant sur un certain tronçon	  d'autoroute pendant 1 minute a une probabilité de $val7 d'être renversé par une voiture.
val12=Monsieur X veut faire le pari de marcher sur ce tronçon d'autoroute	  pendant $val8 minutes, sans être victime d'un accident. Quelle est	  sa chance de gagner ce pari fou&nbsp;?
val10=Sa chance
!endif
!if $val6=it 
val10=Probabilità
val11=Stando alle statistiche, un pedone che cammina lungo un certo tratto	  di autostrada nel tempo di 1 minuto ha probabilità $val7 di essere investito	  da un'auto.
val12=Il Sig. X scommette di riuscire a camminare su questo tratto di	  autostrada per $val8 minuti senza diventare vittima di un incidente.	  Qual è la probabilità che il Sig. X vinca questa assurda scommessa?
val10=Probabilità di vittoria
!endif
replyname1=$val10
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

