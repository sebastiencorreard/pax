!set title=Black and white
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Noires et blanches
title_it=Bianco e nero

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 6, 20

val7=$[rint($(tmp0))]
tmp0=!randint 6, 20

val8=$[rint($(tmp0))]
val9=$[rint($val7+$val8)]
val10=The probability
val11=We have $val7 black balls and $val8 white balls in a bag.	  If two balls are randomly extracted from the bag, what is the probability	  for them to be \balls?
val12=
val13=one black and one white, both black,both white
!if $val6=fr 
val10=La probabilité
val11=Il y a $val7 balles noires et $val8 balles blanches dans	  un sac. Si deux balles sont tirées du sac en même temps et au hasard, quelle est	  la probabilité d'obtenir
val12=&nbsp;
val13=une noire et une blanche,deux noires,deux blanches
!endif
!if $val6=it 
val10=Probabilità
val11=In un sacchetto sono contenute $val7 palline nere e $val8 palline bianche.	  Se estraiamo due palline a caso dal sacchetto, qual è la probabilità che le due palline siano
val12=
val13=una nera e una bianca,entrabe nere,entrambe bianche
!endif
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val13

val15=$(tmp0)
tmp0=!item $val14 of 2*$val7*$val8/($val9*($val9-1)),	  $val7*($val7-1)/($val9*($val9-1)),	  $val8*($val8-1)/($val9*($val9-1))

val16=$[$(tmp0)]
replyname1=$val10
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 $val15$val12?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,15
embedcnt=0
