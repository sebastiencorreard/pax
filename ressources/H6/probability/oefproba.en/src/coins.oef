\title{Coins}
\title_fr{Pièces}
\title_it{Monete}
\integer{times=random(20..50)}
\integer{faces=random(\times/3..2*\times/3)}
\real{sol=binomial(\times,\faces)/2^\times}
\text{name_answer=The probability}
\text{name_statement1=We suppose that each time we toss a coin, the probability of
  obtaining face up is exactly 1/2.}
\text{name_statement2=If we toss \times times the coin, what is the probability of obtaining
exactly \faces times the face up?}
\text{name_solution=There are \(C_\times^\faces) distinct
  ways for the \faces faces to be distributed among the \times tosses
 of the coin. And each particular distribution has a probability of
 \(1/2^(\times)\).}
\if{\lang=fr}{
\text{name_answer=La probabilité}
\text{name_statement1=On suppose que chaque fois qu'on jette une pièce, la probabilité
  d'obtenir face dessus est exactement de 1/2.}
\text{name_statement2=Si l'on jette \times fois la pièce, quelle est la probabilité d'obtenir
