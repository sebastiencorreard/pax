\text{name_answer=The probability}
\text{name_statement=If we suppose that people's birthdays are fairly distributed among
  the 365 days of the year, and if we randomly pick up \people persons from the
  phone directory, what is the probability for that at least two of these
  \people persons have the same birthday?
}
\text{name_hint=Compute rather the probability for these \people persons to all have
  different birthdays.}
\if{\lang=fr}{
\text{name_answer=La probabilité}
\text{name_statement=Si l'on suppose que les jours d'anniversaire sont
  répartis équitablement parmi les 365 jours de l'année et si l'on
  choisit \people personnes différentes au hasard dans l'annuaire, quelle est la probabilité
  pour qu'au moins deux de ces \people personnes aient leur anniversaire le même jour&nbsp;?
}
\text{name_hint=Calculer plutôt la probabilité pour que ces \people personnes
 aient toutes leur anniversaire un jour différent.}
}
\if{\lang=it}{
\text{name_answer=Probabilità}
\text{name_statement=Supponiamo che i compleanni di una certa popolazione siano distribuiti
  uniformemente nei 365 giorni dell'anno. Se prendiamo a caso \people persone
  dall'elenco telefonico, qual è la probabilità che almeno due di queste 
  \people persone compiano gli anni lo stesso giorno?
}
\text{name_hint=Prova a calcolare invece la probabilità che queste \people persone compiano
