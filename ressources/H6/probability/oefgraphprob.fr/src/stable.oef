\title{Etat stable}
\real{mu1=\p2/(\p1+\p2)}
\real{mu2=\p1/(\p1+\p2)}
\integer{mu1a=10000*\mu1}
\real{mu1a=\mu1a/10000}
\text{enonce=L'évolution de l'état d'un système entre deux unités de temps
