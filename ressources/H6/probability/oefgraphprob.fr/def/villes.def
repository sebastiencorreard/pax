!set title=Mouvement de populations
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Sophie,Lemaire
email=Sophie.Lemaire@math.u-psud.fr

ansorder=r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=A
val7=B
tmp0=!randint 5, 50

val8=$[rint($(tmp0))]
tmp0=!randint 2, 30

val9=$[rint($(tmp0))]
val10=$[rint(100-$val8)]
val11=$[rint(100-$val9)]
tmp0=!randint 10, 50

val12=$[rint($(tmp0)*1000)]
val13=Deux villes A et B totalisent une population de $val12 habitants.	  La ville A est plus agréable, mais la ville B offre de meilleures perspectives de carrières.	  On observe que : 
val14=$val8 % des habitants de A partent chaque année habiter B, $val10 % des habitants de A habitent encore en A l'année suivante
val15=$val9 % des habitants de B partent chaque année habiter A, $val11 % des habitants de B habitent encore en B l'année suivante
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
tmp0=!randitem 1,2

val18=$[rint($(tmp0))]
!if $val18=1 
tmp0=!item $val16 of $val14

val19=$(tmp0)
tmp0=!item $val17 of $val15

val20=$(tmp0)
!else
tmp0=!item $val16 of $val14

val19=$(tmp0)
tmp0=!item $val17 of $val15

val20=$(tmp0)
!endif
val21=$[$val8/100]
val22=$[1-$val21]
val23=$[$val9/100]
val24=$[1-$val23]
tmp=!trim $val22, $val21	$val23, $val24
val25=!translate internal $	\
$ to ;; in $tmp
val26=xrange -6,6	yrange -2,2	circle -4,0, 16,black	circle 4,0, 16,black	text black,-4.15,0.2,,$val6	text black,3.9,0.2,,$val7	arc -5,0, 2,2, 35,335,blue	arc 5,0, 2,2, 215,515,blue	arc 0,0, 8,3.5, 15,165,blue	arc 0,0, 8,3.5, 205,345,blue	arrow -4.2,0.55,-4,0.35,10,blue	arrow 4.2,-0.55,4,-0.35,10,blue	arrow 3.8,0.45,3.9,0.35,10,blue	arrow -3.8,-0.45,-3.9,-0.35,10,blue	
!readproc oef/draw.phtml 200,100 \
$val26 
tmp0=$ins_url
val27=$(tmp0)
replytype1=formal
replyname1=
replygood1=$val21
replytype2=formal
replyname2=
replygood2=$val22
replytype3=formal
replyname3=
replygood3=$val24
replytype4=formal
replyname4=
replygood4=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val13	<ul><li>$val19,</li>	<li> $val20.</li></ul>	<p>	  Entrer les poids des arêtes du graphe suivant afin d'obtenir le graphe probabiliste	  associé à ce modèle.	</p>	<table class="wimscenter">	<tr><td></td><td>  
!read oef/embed.phtml reply1,6 
$()</td><td></td></tr>	<tr><td> 
!read oef/embed.phtml reply2,6 
$()</td><td>	<img src="$val27" alt=""></td><td> 
!read oef/embed.phtml reply3,6 
$()</td></tr>	<tr><td></td><td>  
!read oef/embed.phtml reply4,6 
$()</td><td></td></tr>	</table>	
$()
!exit

