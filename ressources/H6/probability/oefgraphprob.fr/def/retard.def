val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=H
val7=R
tmp0=!randint 5, 40

val8=$[rint($(tmp0))]
tmp0=!randint 60, 95

val9=$[rint($(tmp0))]
val10=$[rint(100-$val8)]
val11=$[rint(100-$val9)]
val12=s'il est en retard un jour alors il a $val11 % de chance d'être en retard le	  lendemain, s'il est en retard un jour alors il a $val9 % de chance d'être à l'heure le	  lendemain
val13=s'il est à l'heure un jour alors il a $val8 % de chance d'être	  en retard le lendemain, s'il est à l'heure un jour alors il a $val10 % de chance d'être	  encore à l'heure le lendemain
val14=Un employé arrive en retard à son travail suivant les probabilité suivantes :
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]
tmp0=!randitem 1,2

val17=$[rint($(tmp0))]
!if $val17=1 
tmp0=!item $val15 of $val12

val18=$(tmp0)
tmp0=!item $val16 of $val13

val19=$(tmp0)
!else
tmp0=!item $val15 of $val12

val18=$(tmp0)
tmp0=!item $val16 of $val13

val19=$(tmp0)
!endif
val20=$[$val8/100]
val21=$[1-$val20]
val22=$[$val9/100]
val23=$[1-$val22]
tmp=!trim $val21, $val20	$val22, $val23
val24=!translate internal $	\
$ to ;; in $tmp
val25=xrange -6,6	yrange -2,2	circle -4,0, 16,black	circle 4,0, 16,black	text black,-4.15,0.2,,$val6	text black,3.9,0.2,,$val7	arc -5,0, 2,2, 35,335,blue	arc 5,0, 2,2, 215,515,blue	arc 0,0, 8,3.5, 15,165,blue	arc 0,0, 8,3.5, 205,345,blue	arrow -4.2,0.55,-4,0.35,10,blue	arrow 4.2,-0.55,4,-0.35,10,blue	arrow 3.8,0.45,3.9,0.35,10,blue	arrow -3.8,-0.45,-3.9,-0.35,10,blue	
!readproc oef/draw.phtml 200,100 \
$val25 
tmp0=$ins_url
val26=$(tmp0)
replytype1=formal
