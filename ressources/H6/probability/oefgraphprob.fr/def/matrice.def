format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 95

val6=$[$(tmp0)/100]
tmp0=!randint 5, 95

val7=$[$(tmp0)/100]
val8=$[1-$val6]
val9=$[1-$val7]
tmp=!trim $val8,$val6	$val7,$val9
val10=!translate internal $	\
$ to ;; in $tmp
val11=xrange -8,8	yrange -3,3	circle -4,0, 16,black	circle 4,0, 16,black	text black,-4.1,0.2,,1	text black,3.9,0.2,,2	arc -5,0, 2,2, 35,335,blue	arc 5,0, 2,2, 215,515,blue	arc 0,0, 8,3.5, 15,165,blue	arc 0,0, 8,3.5, 205,345,blue	arrow -4.2,0.55,-4,0.35,10,blue	arrow 4.2,-0.55,4,-0.35,10,blue	arrow 3.8,0.45,3.9,0.35,10,blue	arrow -3.8,-0.45,-3.9,-0.35,10,blue	text navy, -0.2,2.5,,$val6	text navy, -0.2,-2,,$val7	text navy, -7.2,0.1,,$val8	text navy, 6.2,0.1,,$val9	
!readproc oef/draw.phtml 400,150 \
$val11 
tmp0=$ins_url
val12=$(tmp0)
val13=reply1,reply2,reply3,reply4
val14=Donner la matrice de transition du graphe probabiliste suivant :
!readproc oef/draw.phtml 25,50 \
xrange -1,2	yrange -1.1,1.2	arc 0,0, 1,2, 100,260,black 
tmp0=$ins_url
val15=$(tmp0)
!readproc oef/draw.phtml 25,50 \
xrange -1,2	yrange -1.1,1.2	arc 0,0, 1,2, 260,100,black 
tmp0=$ins_url
val16=$(tmp0)
oefsteps=$val13 
nextstep=!nosubst $val13 
!readproc oef/steps.proc
replytype1=formal
replyweight1=\poids1 
replyoption1=noanalyzeprint 
replyname1=
replygood1=$(val10[1;1])
replytype2=formal
replyweight2=\poids1 
