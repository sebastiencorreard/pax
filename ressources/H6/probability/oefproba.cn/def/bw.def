tmp0=!randint 6, 20

val6=$[rint($(tmp0))]
tmp0=!randint 6, 20

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!item $val9 of 一黑一红, 两个黑球,全是红球

val10=$(tmp0)
tmp0=!item $val9 of 2*$val6*$val7/($val8*($val8-1)),	        $val6*($val6-1)/($val8*($val8-1)),	        $val7*($val7-1)/($val8*($val8-1))

val11=$[$(tmp0)]
replyname1=概率
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

