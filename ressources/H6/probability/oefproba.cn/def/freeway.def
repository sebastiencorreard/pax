 !exit
!endif

tmp0=!randint 15, 25

val6=$[$(tmp0)/100]
tmp0=!randint 8, 15

val7=$[rint($(tmp0))]
val8=$[(1-$val6)^$val7]
replyname1=取胜机会
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()根据统计, 在某一段公路上行走的步行者在 1 分钟内被车撞倒的概率是 $val6.  	<p>	X 先生要打赌在这段公路上行走 $val7 分钟而不发生任何车祸.	问他赢得这个疯狂赌局的概率是多少?
$()
