tmp0=!randint 8, 20

val6=$[rint($(tmp0))]
tmp0=!randint 8, 20

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 3, 7

val9=$[rint($(tmp0))]
tmp0=!randint 1, $val9-1

val10=$[rint($(tmp0))]
val11=$[rint($val9-$val10)]
val12=$[binomial($val6,$val10)*binomial($val7,$val11)/binomial($val8,$val9)]
replyname1=概率
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

