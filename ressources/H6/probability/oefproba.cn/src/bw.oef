\title{黑与白}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{black=random(6..20)}
\integer{white=random(6..20)}
\integer{total=\black+\white}
\integer{type=random(1..3)}
\text{balls=item(\type,一黑一红, 两个黑球,全是红球)}
\real{sol=item(\type,2*\black*\white/(\total*(\total-1)),
        \black*(\black-1)/(\total*(\total-1)),
        \white*(\white-1)/(\total*(\total-1)))}

\statement{袋内有 \black 个黑球和 \white 个白球.
如果从袋内随机取出 2 个球,
那么拿到 \balls的概率是多少?} 

\answer{概率}{\sol}
