\title{Quadriques et coupe par un plan}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\matrix{A=PEz+.jpg, x^2+y^2=2*z,x^2+y^2-2*z, paraboloïde elliptique
PEx+.jpg, z^2+y^2=2*x,z^2+y^2-2*x,paraboloïde elliptique
PEy+.jpg, x^2+z^2=2*y,x^2+z^2-2*y,paraboloïde elliptique
PEy-.jpg,x^2+z^2=-2*y, x^2+z^2+2*y,paraboloïde elliptique
PEz-.jpg,x^2+y^2=-2*z ,x^2+y^2+2*z,paraboloïde elliptique
PEx-.jpg, z^2+y^2=-2*x,z^2+y^2+2*x ,paraboloïde elliptique
PHz+.jpg, x^2-y^2=2*z, x^2-y^2-2*z,paraboloïde hyperbolique
PHy+.jpg, x^2-z^2=2*y,x^2-z^2-2*y,paraboloïde hyperbolique
PHx+.jpg, z^2-y^2=2*x,z^2-y^2-2*x ,paraboloïde hyperbolique
PHy-.jpg, x^2-z^2=-2*y,x^2-z^2+2*y ,paraboloïde hyperbolique
 PHz-.jpg, x^2-y^2=-2*z,x^2-y^2+2*z,paraboloïde hyperbolique
PHx-.jpg, z^2-y^2=-2*x,z^2-y^2+2*x,paraboloïde hyperbolique
H1z.jpg,x^2+y^2-z^2=1,x^2+y^2-z^2-1 ,hyperboloïde à une nappe
H1y.jpg,x^2-y^2+z^2=1,x^2-y^2+z^2-1,hyperboloïde à une nappe
H2z.jpg,x^2+y^2-z^2=-1 , x^2+y^2-z^2+1,hyperboloïde à deux nappes
H2y.jpg,x^2-y^2+z^2=-1,x^2-y^2+z^2+1,hyperboloïde à deux nappes
Ex.jpg,2*x^2+y^2+z^2 =1,2*x^2+y^2+z^2 -1 ,ellipsoïde
Ey.jpg, x^2+2*y^2+z^2 =1,x^2+2*y^2+z^2 -1,ellipsoïde
Ez.jpg, x^2+y^2+2*z^2 =1,x^2+y^2+2*z^2 -1 ,ellipsoïde}

\text{choix=randint(1..19)}
\text{xyz=shuffle(x,y,z)}
\text{x=item(1,\xyz)}
\text{y=item(2,\xyz)}
\text{z=item(3,\xyz)}
\text{a=random(1,-1)*randint(1..3)}
\text{b=random(1,-1)}
\text{eq1=simplify(\a*\x+(\b)*\y)}
\text{eq2= \a <>0 ? -(\b)*\x+(\a)*\y: \x+(\b)*\y}
\text{eq3= evalue(\eq1, \x=\z)}
\text{eq3=evalue(\eq3,\y=\x)}

\text{images= row(item(1,\choix),\A)}
\text{image=item(1,\images)}
\text{equation=item(2,\images)}
\text{f=item(3,\images)}
\text{nom=item(4,\images)}
\function{f1z=evalue(\f,\z=(\eq1))}
\text{f1z=simplify(\f1z)}
\function{g1z=evalue(\f1z,\x=X)}
\function{g1z=evalue(\g1z,\y=Y)}
\function{g1z=evalue(\g1z,X=x)}
\function{g1z=evalue(\g1z,Y=y)}
\text{g1z=simplify(\g1z)}
\function{f2z=evalue(\f,\z=(\eq2))}
\text{f2z=simplify(\f2z)}
\function{g2z=evalue(\f2z,\x=X)}
\function{g2z=evalue(\g2z,\y=Y)}
\function{g2z=evalue(\g2z,X=x)}
\function{g2z=evalue(\g2z,Y=y)}
\text{g2z=simplify(\g2z)}
\function{f3z=evalue(\f,\y=(\eq3))}
\text{f3z=simplify(\f3z)}
\function{g3z=evalue(\f3z,\x=X)}
\function{g3z=evalue(\g3z,\z=Y)}
\function{g3z=evalue(\g3z,X=x)}
\function{g3z=evalue(\g3z,Y=y)}
\text{g3z=simplify(\g3z)}
\text{s=shuffle(3)}
\text{liste=\g1z,\g2z,\g3z}
\text{h1z=item(item(1,\s),\liste)}
\text{h2z=item(item(2,\s),\liste)}
\text{h3z=item(item(3,\s),\liste)}
\text{rep=position(1,\s)}
\text{range=3}
\statement{Voici une quadrique (\nom) d'équation \(\equation)
<div class="wimscenter"> <img src="\imagedir/\image" alt=""></div>
<p>
On la coupe selon le plan \(\z=\eq1). Parmi les dessins suivants, lequel représente cette coupe ?
</p>
<table class="wimscenter"><tr><td>\draw{150,150}{
	xrange -\range,\range
	yrange -\range,\range
	hline 0,0, black
	vline 0,0,black
	arrow 0,0,0,1, 6,black
	arrow 0,0,1,0, 6,black
	levelcurve red, \h1z,0
	text black,0,\range,medium,\y
	text black,\range-0.5,0,medium,\x
}
</td><td>
\draw{150,150}{
	xrange -\range,\range
	yrange -\range,\range
	arrow 0,0,0,1, 6,black
	arrow 0,0,1,0, 6,black
	hline 0,0, black
	text black,0,\range,medium,\y
	text black,\range-0.5,0,medium,\x
	vline 0,0,black
	levelcurve red, \h2z,0
}
</td><td>
\draw{150,150}{
	xrange -\range,\range
	yrange -\range,\range
	arrow 0,0,0,1, 6,black
	arrow 0,0,1,0, 6,black
	hline 0,0, black
	vline 0,0,black
	text black,0,\range,medium,\y
	text black,\range-0.5,0,medium,\x
	levelcurve red, \h3z,0
}
</td></tr>
<tr><td>\embed{reply 1,1}</td><td>\embed{reply 1,2}</td><td>\embed{reply 1,3}</td></tr>
 </table>
}
