\title{Equation d'un plan 2}
\language{fr}
\range{-5..5}
\author{Nicolas, Moreau;Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\matrix{liste=1,1,1,111.jpeg
0,1,1,011.jpeg
1,0,1,101.jpeg
1,1,0,110.jpeg
-1,1,1,-111.jpeg
1,-1,1,1-11.jpeg
0,1,-1,01-1.jpeg
-1,0,1,-101.jpeg
1,-1,0,1-10.jpeg}

\text{choix=shuffle(9)}
\integer{j=item(1,\choix)}
\integer{k=item(2,\choix)}
\integer{l=item(3,\choix)}
\text{A1=row(\j,\liste)}
\text{A2=row(\k,\liste)}
\text{A3=row(\l,\liste)}
\text{plan1=item(4,\A1)}
\text{plan2=item(4,\A2)}
\text{plan3=item(4,\A3)}

\integer{a1=item(1,\A1)}
\integer{b1=item(2,\A1)}
\integer{c1=item(3,\A1)}
\text{P1=simplify((\a1)*x+(\b1)*y+(\c1)*z)}
\integer{a2=item(1,\A2)}
\integer{b2=item(2,\A2)}
\integer{c2=item(3,\A2)}
\text{P2=simplify((\a2)*x+(\b2)*y+(\c2)*z)}
\integer{a3=item(1,\A3)}
\integer{b3=item(2,\A3)}
\integer{c3=item(3,\A3)}
\text{P3=simplify((\a3)*x+(\b3)*y+(\c3)*z)}

\text{listeplan=shuffle(1,2,3)}

\text{plans=\plan1,\plan2,\plan3}
\text{plans1=item(item(1,\listeplan),\plans)}
\text{plans2=item(item(2,\listeplan),\plans)}
\text{plans3=item(item(3,\listeplan),\plans)}

\text{rep=position(1,\listeplan)}

\statement{Lequel de ces trois plans a pour équation <b>\(\P1 = 0) ?</b>

