\title{Equation d'un plan 4}
\language{fr}
\range{-5..5}
\author{Nicolas, Moreau;Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\matrix{liste=0,1,-1,-1,01-1-1.jpeg
1,-1,0,-1,1-10-1.jpeg
0,1,-1,1,01-11.jpeg
1,-1,0,1,1-101.jpeg
0,0,1,0,001.jpeg
1,0,-1,-1,10-1-1.jpeg
0,1,0,0,010.jpeg
0,1,1,-1,011-1.jpeg
1,0,0,0,100.jpeg
1,0,1,-1,101-1.jpeg
1,1,0,-1,110-1.jpeg
0,1,1,1,0111.jpeg
1,0,1,1,1011.jpeg
1,1,0,1,1101.jpeg}

\text{choix=shuffle(14)}
\integer{j=item(1,\choix)}
\integer{k=item(2,\choix)}
\integer{l=item(3,\choix)}
\text{A1=row(\j,\liste)}
\text{A2=row(\k,\liste)}
\text{A3=row(\l,\liste)}
\text{plan1=item(5,\A1)}
\text{plan2=item(5,\A2)}
\text{plan3=item(5,\A3)}

\integer{a1=item(1,\A1)}
\integer{b1=item(2,\A1)}
\integer{c1=item(3,\A1)}
\integer{d1=item(4,\A1)}
\text{P1=simplify((\a1)*x+(\b1)*y+(\c1)*z-(\d1))}
\integer{a2=item(1,\A2)}
\integer{b2=item(2,\A2)}
\integer{c2=item(3,\A2)}
\integer{d2=item(4,\A2)}
\text{P2=simplify((\a2)*x+(\b2)*y+(\c2)*z-(\d2))}
\integer{a3=item(1,\A3)}
\integer{b3=item(2,\A3)}
\integer{c3=item(3,\A3)}
\integer{d3=item(4,\A3)}
\text{P3=simplify((\a3)*x+(\b3)*y+(\c3)*z-(\d3))}

\text{listeplan=shuffle(1,2,3)}

\text{plans=\plan1,\plan2,\plan3}
\text{plans1=item(item(1,\listeplan),\plans)}
\text{plans2=item(item(2,\listeplan),\plans)}
\text{plans3=item(item(3,\listeplan),\plans)}

\text{rep=position(1,\listeplan)}

\statement{Lequel de ces trois plans a-t-il pour équation <b>\(\P1 = 0) ?</b>
<table class="wimscenter wimsnoborder"><tr>
<td><img src="\imagedir/\plans1" alt=""></td>
<td><img src="\imagedir/\plans2" alt=""></td>
<td><img src="\imagedir/\plans3" alt=""></td>
</tr><tr>
<td>\embed{reply 1,1}</td>
<td>\embed{reply 1,2}</td>
<td>-\embed{reply 1,3}</td>
</tr>
 </table>}

\answer{}{\rep;A,B,C}{type=click}
