!set title=Equation d'un plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nicolas, Moreau;Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=c
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 1,1,1,111.jpeg	0,1,1,011.jpeg	1,0,1,101.jpeg	1,1,0,110.jpeg	-1,1,1,-111.jpeg	1,-1,1,1-11.jpeg	0,1,-1,01-1.jpeg	-1,0,1,-101.jpeg	1,-1,0,1-10.jpeg
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 9

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val9=$[rint($(tmp0))]
tmp0=!item 3 of $val7

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 1 of $val11

val14=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val15=$[rint($(tmp0))]
tmp0=!item 3 of $val11

val16=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val14)*x+($val15)*y+($val16)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
tmp0=!item 4 of $val11

val18=$(tmp0)
tmp0=!item 1 of $val12

val19=$[rint($(tmp0))]
tmp0=!item 2 of $val12

val20=$[rint($(tmp0))]
tmp0=!item 3 of $val12

val21=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val19)*x+($val20)*y+($val21)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp0=!item 1 of $val13

val23=$[rint($(tmp0))]
tmp0=!item 2 of $val13

val24=$[rint($(tmp0))]
tmp0=!item 3 of $val13

val25=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val23)*x+($val24)*y+($val25)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
tmp0=!shuffle $val17=0,$val22=0,$val26=0

val27=$(tmp0)
choicename1=
choicegood1=$val17=0
choicebad1=$val27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Quelle est l'équation de ce plan ?	<div class="wimscenter"><img src="$val1/$val18" alt=""></div>
$()
!exit

