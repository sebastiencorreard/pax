tmp=!trim 0,1,-1,-1,01-1-1.jpeg	1,-1,0,-1,1-10-1.jpeg	0,1,-1,1,01-11.jpeg	1,-1,0,1,1-101.jpeg	0,0,1,0,001.jpeg	1,0,-1,-1,10-1-1.jpeg	0,1,0,0,010.jpeg	0,1,1,-1,011-1.jpeg	1,0,0,0,100.jpeg	1,0,1,-1,101-1.jpeg	1,1,0,-1,110-1.jpeg	0,1,1,1,0111.jpeg	1,0,1,1,1011.jpeg	1,1,0,1,1101.jpeg
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 14

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val9=$[rint($(tmp0))]
tmp0=!item 3 of $val7

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 5 of $val11

val14=$(tmp0)
tmp0=!item 5 of $val12

val15=$(tmp0)
tmp0=!item 5 of $val13

val16=$(tmp0)
tmp0=!item 1 of $val11

val17=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val18=$[rint($(tmp0))]
tmp0=!item 3 of $val11

val19=$[rint($(tmp0))]
tmp0=!item 4 of $val11

val20=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val17)*x+($val18)*y+($val19)*z-($val20)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val21=$(tmp0)
tmp0=!item 1 of $val12

val22=$[rint($(tmp0))]
tmp0=!item 2 of $val12

val23=$[rint($(tmp0))]
tmp0=!item 3 of $val12

val24=$[rint($(tmp0))]
tmp0=!item 4 of $val12

val25=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val22)*x+($val23)*y+($val24)*z-($val25)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
tmp0=!item 1 of $val13

val27=$[rint($(tmp0))]
tmp0=!item 2 of $val13

val28=$[rint($(tmp0))]
tmp0=!item 3 of $val13

val29=$[rint($(tmp0))]
tmp0=!item 4 of $val13

val30=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val27)*x+($val28)*y+($val29)*z-($val30)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=$(tmp0)
tmp0=!shuffle 1,2,3

val32=$(tmp0)
val33=$val14,$val15,$val16
tmp0=!item 1 of $val32

tmp1=!item $(tmp0) of $val33

val34=$(tmp1)
tmp0=!item 2 of $val32

tmp1=!item $(tmp0) of $val33

val35=$(tmp1)
tmp0=!item 3 of $val32

tmp1=!item $(tmp0) of $val33

val36=$(tmp1)
