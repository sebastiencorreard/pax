!set title=Equation d'un plan 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nicolas, Moreau;Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim 1,1,1,111.jpeg	0,1,1,011.jpeg	1,0,1,101.jpeg	1,1,0,110.jpeg	-1,1,1,-111.jpeg	1,-1,1,1-11.jpeg	0,1,-1,01-1.jpeg	-1,0,1,-101.jpeg	1,-1,0,1-10.jpeg
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 9

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val9=$[rint($(tmp0))]
tmp0=!item 3 of $val7

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 4 of $val11

val14=$(tmp0)
tmp0=!item 4 of $val12

val15=$(tmp0)
tmp0=!item 4 of $val13

val16=$(tmp0)
tmp0=!item 1 of $val11

val17=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val18=$[rint($(tmp0))]
tmp0=!item 3 of $val11

val19=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val17)*x+($val18)*y+($val19)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val20=$(tmp0)
tmp0=!item 1 of $val12

val21=$[rint($(tmp0))]
tmp0=!item 2 of $val12

val22=$[rint($(tmp0))]
tmp0=!item 3 of $val12

val23=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val21)*x+($val22)*y+($val23)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
tmp0=!item 1 of $val13

val25=$[rint($(tmp0))]
tmp0=!item 2 of $val13

val26=$[rint($(tmp0))]
tmp0=!item 3 of $val13

val27=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val25)*x+($val26)*y+($val27)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28=$(tmp0)
tmp0=!shuffle 1,2,3

val29=$(tmp0)
val30=$val14,$val15,$val16
tmp0=!item 1 of $val29

tmp1=!item $(tmp0) of $val30

val31=$(tmp1)
tmp0=!item 2 of $val29

tmp1=!item $(tmp0) of $val30

val32=$(tmp1)
tmp0=!item 3 of $val29

tmp1=!item $(tmp0) of $val30

val33=$(tmp1)
tmp0=!positionof item 1 in $val29

val34=$(tmp0)
replytype1=click
replyname1=
replygood1=$val34;A,B,C
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Lequel de ces trois plans a pour équation <b>
!insmath $val20 = 0
$() ?</b>		<table class="wimscenter wimsnoborder"><tr>	<td><img src="$val1/$val31" alt="" style="width:85%"></td>	<td><img src="$val1/$val32" alt="" style="width:85%"></td>	<td><img src="$val1/$val33" alt="" style="width:85%"></td>	</tr><tr>	<td> 
!read oef/embed.phtml reply 1,1 
$()</td>	<td> 
!read oef/embed.phtml reply 1,2 
$()</td>	<td> 
!read oef/embed.phtml reply 1,3 
$()</td>	</tr>	</table>
$()
!exit

