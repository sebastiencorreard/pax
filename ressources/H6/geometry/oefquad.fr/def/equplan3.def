tmp=!trim 0,1,-1,-1,01-1-1.jpeg	1,-1,0,-1,1-10-1.jpeg	0,1,-1,1,01-11.jpeg	1,-1,0,1,1-101.jpeg	0,0,1,0,001.jpeg	1,0,-1,-1,10-1-1.jpeg	0,1,0,0,010.jpeg	0,1,1,-1,011-1.jpeg	1,0,0,0,100.jpeg	1,0,1,-1,101-1.jpeg	1,1,0,-1,110-1.jpeg	0,1,1,1,0111.jpeg	1,0,1,1,1011.jpeg	1,1,0,1,1101.jpeg
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 14

val7=$(tmp0)
tmp0=!item 1 of $val7

val8=$[rint($(tmp0))]
tmp0=!item 2 of $val7

val9=$[rint($(tmp0))]
tmp0=!item 3 of $val7

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!item 1 of $val11

val14=$[rint($(tmp0))]
tmp0=!item 2 of $val11

val15=$[rint($(tmp0))]
tmp0=!item 3 of $val11

val16=$[rint($(tmp0))]
tmp0=!item 4 of $val11

val17=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val14)*x+($val15)*y+($val16)*z-($val17)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
tmp0=!item 5 of $val11

val19=$(tmp0)
tmp0=!item 1 of $val12

val20=$[rint($(tmp0))]
tmp0=!item 2 of $val12

val21=$[rint($(tmp0))]
tmp0=!item 3 of $val12

val22=$[rint($(tmp0))]
tmp0=!item 4 of $val12

val23=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val20)*x+($val21)*y+($val22)*z-($val23)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
tmp0=!item 1 of $val13

val25=$[rint($(tmp0))]
tmp0=!item 2 of $val13

val26=$[rint($(tmp0))]
tmp0=!item 3 of $val13

val27=$[rint($(tmp0))]
tmp0=!item 4 of $val13

val28=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val25)*x+($val26)*y+($val27)*z-($val28)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val29=$(tmp0)
tmp0=!shuffle $val18=0,$val24=0,$val29=0

val30=$(tmp0)
choicename1=
choicegood1=$val18=0
