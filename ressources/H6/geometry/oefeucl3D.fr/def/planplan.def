tmp0=$slib_out
val6=$(tmp0)
val7=parallèles, non parallèles
val8=distance,cosinus
tmp=!trim Considérons les deux plans de \(\RR^3) d'équations respectives	  et	  Ils sont	  Calculer la distance entre les deux plans parallèles.	  Calculer le cosinus de l'angle que font les deux plans non parallèles.	  Les deux plans sont	  Une distance est un réel positif.	  Le cosinus d'un angle est compris entre -1 et 1. 
val9=!translate internal $	\
$ to ;; in $tmp
val10=Pour calculer l'angle que forment entre eux	  deux plans non parallèles, on peut calculer l'angle que font entre eux	  deux vecteurs \(\vec{n}_1) et \(\vec{n}_2) normaux respectivement	  aux plans. Le cosinus de l'angle cherché est alors donné par
val11=Pour calculer la distance entre deux plans parallèles,	  on peut calculer la distance entre un point d'un des deux plans et l'autre plan.	  On peut aussi ramener les équations des deux plans sous la forme similaire	  \(a x + b y + c z = d_1) et \(a x + b y + c z = d_2).	  La distance entre les deux plans est alors égale à
!if $val6=en 
val7=parallel, non-parallel
val8=distance,cosine
tmp=!trim Consider the two planes in \(\RR^3) with equations	and	They are	Compute the distance between the two parallel planes.	Compute the cosine of the angle between the two non-parallel planes.	The two planes are	A distance is a nonnegative real number.	The cosine of an angle lies between -1 and 1. 
val9=!translate internal $	\
$ to ;; in $tmp
val10=To compute the angle between two	non-parallel planes, one can compute the angle between	two vectors \(\vec{n}_1) and \(\vec{n}_2) orthogonal to	the planes. Le cosine sought for is then given by
val11=To compute the distance between two parallel planes,	 one can compute the distance between a point on one of the two planes and the other plane.	 One may also write similar equations for the two planes	 \(a x + b y + c z = d_1) and \(a x + b y + c z = d_2).	 The distance between the two planes is then
!endif
!if $val6=es 
val7=paralelos, no paralelos
val8=distancia, coseno
tmp=!trim Consideremos los dos planos de \(\RR^3) de ecuaciones respectivas	y	Estos planos son	Calcular la distancia entre los dos planos paralelos.	Calcular el coseno del ángulo formado por los dos planos no paralelos.	Ambos planes son	Una distancia es un real positivo.	El coseno de un ángulo está comprendido entre -1 y 1. 
val9=!translate internal $	\
$ to ;; in $tmp
val10=Para calcular el ángulo entre ellos	dos planos no paralelos, podemos calcular el ángulo entre los	dos vectoress \(\vec{n}_1) i \(\vec{n}_2) normales respectivamente	a los planos. El coseno del ángulo buscado viene dado por
val11=Para calcular la distancia entre dos planos paralelos,	  se puede calcular la distancia entre un punto de uno de los dos planos y el otro plano.	  También podemos pasar las ecuaciones de los dos planos a la forma general	  \(a x + b y + c z = d_1) y \(a x + b y + c z = d_2).	  La distancia entre los dos planos es entonces igual a
!endif
!if $val6=ca 
val7=paral·lels, no paral·lels
val8=distància,cosinus
tmp=!trim Considerem els dos plans de \(\RR^3) d'equacions respectives	i	Aquests plans són	Calcular la distància entre els dos plans paral·lels.	Calcular el cosinus de l'angle que formen els dos plans no paral·lels.	Tots dos plans són	Una distància és un real positiu.	El cosinus d'un angle està comprès entre -1 i 1. 
val9=!translate internal $	\
$ to ;; in $tmp
val10=Per calcular l'angle que formen entre ells	  dos plans no paral·lels, podem calcular l'angle entre els	  dos vectors \(\vec{n}_1) i \(\vec{n}_2) normals respectivament	  als plans. El cosinus de l'angle cercat ve donat per
val11=Per calcular la distància entre dos plans paral·lels,	  es pot calcular la distància entre un punt d'un dels dos plans i l'altre pla.	  També podem passar les equacions dels dos plans a la forma general	  \(a x + b y + c z = d_1) i \(a x + b y + c z = d_2).	  Llavors la distància entre els dos plans és igual a
!endif
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
!if ($val12)^2+($val13)^2+($val14)^2=0 
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
!endif
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]
tmp0=!randint -5, 5

val16=$[rint($(tmp0))]
tmp0=!randint -1, 1

val17=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val18=$[rint($(tmp0)*$(tmp1))]
val19=$[($val12)*($val15)+($val13)*($val16)+($val14)*($val17)]
tmp0=!randitem 1,2

val20=$(tmp0)

!ifval $val20=1 
tmp0=!randint -10, 10

val21=$[rint( $(tmp0))]
!else
val21=$[rint( $val18*($val12))]
!endif

!ifval $val20=1 
tmp0=!randint -10, 10

val22=$[rint( $(tmp0))]
!else
val22=$[rint( $val18*($val13))]
!endif

!ifval $val20=1 
tmp0=!randint -10, 10

val23=$[rint( $(tmp0))]
!else
val23=$[rint( $val18*($val14))]
!endif

!ifval ($val21)^2+($val22)^2+($val23)^2=0
tmp0=!randint 1, 4

val21=$[rint( $(tmp0))]
!endif
tmp0=!randint -10, 10

val24=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val21)*x + ($val22)*y + ($val23)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in ($val12)*x + ($val13)*y + ($val14)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=!rawmath $(tmp0)
val27=$[(($val21)*($val13)-($val22)*($val12))^2+(($val23)*($val13)-($val22)*($val14))^2+(($val21)*($val14)-($val23)*($val12))^2]

!ifval $val27=0 
tmp0=!item 1 of $val7

val28= $(tmp0)
!else
tmp1=!item 2 of $val7

val28= $(tmp1)
!endif

!ifval $val27=0 
val29=$[	abs(($val21)*($val15)+($val22)*($val16)+($val23)*($val17)-($val24))/(($val21)^2+($val22)^2+($val23)^2)^(1/2)]
!else
val29=$[	(abs(($val12)*($val21)+($val13)*($val22)+($val14)*($val23)))/((($val21)^2+($val22)^2+($val23)^2)^(1/2)*(($val12)^2+($val13)^2+($val14)^2)^(1/2))]
!endif

!ifval $val27=0 
val30= $(val8[1])
!else
val30=$(val8[2])
!endif
