!set title=Distance d'un point à une droite
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
title_en=Distance Between a Point and a Line
title_es=Distancia de un punto a una recta
title_ca=Distància d'un punt a una recta

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint -10, 10

val10=$[rint($(tmp0))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
tmp0=!randint -10, 10

val12=$[rint($(tmp0))]
tmp0=!randint -10, 10

val13=$[rint($(tmp0))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
tmp0=!randint -10, 10

val15=$[rint($(tmp0))]

!ifval ($val13-($val10))^2+($val14-($val11))^2+($val15-($val12))^2=0 
val10=$[rint( $val13+1)]
!endif
val16=$val13 - ($val10) , $val14 - ($val11) , $val15 - ($val12)
val17=$val7 - ($val10) , $val8 - ($val11) , $val9 - ($val12)
tmp0=!item 2 of $val16

tmp1=!item 3 of $val17

tmp2=!item 3 of $val16

tmp3=!item 2 of $val17

tmp4=!item 3 of $val16

tmp5=!item 1 of $val17

tmp6=!item 1 of $val16

tmp7=!item 3 of $val17

tmp8=!item 1 of $val16

tmp9=!item 2 of $val17

tmp10=!item 2 of $val16

tmp11=!item 1 of $val17

val18=$[(($(tmp0))*($(tmp1))-($(tmp2))*($(tmp3)))^2	+(($(tmp4))*($(tmp5))-($(tmp6))*($(tmp7)))^2	+(($(tmp8))*($(tmp9))-($(tmp10))*($(tmp11)))^2	]
tmp0=!item 1 of $val16

tmp1=!item 2 of $val16

tmp2=!item 3 of $val16

val19=$[(($val18)/(($(tmp0))^2+($(tmp1))^2+($(tmp2))^2))^(1/2)]
val20=Quelle est la distance du point \(P) de coordonnées ($val7 , $val8 , $val9)	  à la droite \(D) passant par les deux points
tmp=!trim et	distance
val21=!translate internal $	\
$ to ;; in $tmp
val22=La distance d'un point \(P) à une droite passant par deux points	\(Q) et \(R) est donnée par	
val23=Pour le voir, on se place dans le plan contenant \(P), \(Q) et \(R).	  Le nombre \(||\vec{QR}\wedge\vec{QP}||) est l'aire du parallélogramme construit	  à partir de \(P), \(Q) et \(R). C'est aussi le produit de la longueur	  \(QR) par la distance de \(P) à la droite \(QR).	
!if $val6=en 
val20=What is the distance between the point \(P) with coordinates ($val7 , $val8 , $val9)	and the line \(D) passing through the two points
tmp=!trim and	distance
val21=!translate internal $	\
$ to ;; in $tmp
val22=The distance between a point \(P) and the line \(D) passing through	the two points \(Q) and \(R) is given by	
val23=To see that, one considers the plane containing \(P), \(Q) and \(R).	It contains the parallelogram constructed from \(P), \(Q) and \(R), the area of which is	\(||\vec{Q R}\wedge\vec{Q P}||). It is also the product of the length	\(QR) and the distance from \(P) to the line \(Q R).	
!endif
!if $val6=es 
val20=¿Cuál es la distancia desde el punto \(P) de coordenadas ($val7 , $val8 , $val9)	a la recta \(D) que pasa por los dos puntos
tmp=!trim y	distancia
val21=!translate internal $	\
$ to ;; in $tmp
val22=La distancia desde un punto \(P) a una recta que pasa por dos puntos	\(Q) y \(R) viene dada por	
val23=Para verlo, nos colocamos en el plano que contiene \(P), \(Q) y \(R).	El número \(||\vec{QR}\wedge\vec{QP}||) es el área del paralelogramo construido	a partir de \(P), \(Q) y \(R). También es el producto de la longitud del segemnto	\(QR) por la distancia de \(P) a la recta \(QR).	
!endif
!if $val6=ca 
val20=Quina és la distància del punt \(P) de coordenades ($val7 , $val8 , $val9)	a la recta \(D) que passa pels dos punts
tmp=!trim i	distància
val21=!translate internal $	\
$ to ;; in $tmp
val22=La distància d'un punt \(P) a una recta que passa per dos punts	\(Q) i \(R) ve donada per	
val23=Per veure-ho, ens situem al pla que conté \(P), \(Q) i \(R).	El número \(||\vec{QR}\wedge\vec{QP}||) és l'àrea del paral·lelogram construït	a partir de \(P), \(Q) i \(R). També és el producte de la longitud del segment	\(QR) per la distància de \(P) a la recta \(QR).	
!endif
replytype1=numeric
replyname1=$(val21[2])
replygood1=$[$val19]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val20	
!insmath Q
$() = ($val10 , $val11 , $val12) $(val21[1;]) 
!insmath R
$() = ($val13 , $val14 , $val15).	
$()
!exit

:hint
$()$val22	<div class="wimscenter">	
!insmath \frac{||\vec{QR} \wedge \vec{QP}||}{||QR||}
$().	</div>	$val23	
$()
!exit

