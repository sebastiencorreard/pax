tmp6=!randint 1, 2

tmp7=!randint -2, -1

tmp8=!randitem $(tmp6), $(tmp7)

val11=$(tmp2),$(tmp5),$(tmp8)
val12=$val8,$val9,$val10
tmp0=!item 1 of $val11

tmp1=!item 1 of $val12

tmp2=!item 2 of $val11

tmp3=!item 2 of $val12

tmp4=!item 3 of $val11

tmp5=!item 3 of $val12

tmp=!translate ";': to $     $ in ($(tmp0))*($(tmp1))+($(tmp2))*($(tmp3))+($(tmp4))*($(tmp5))

tmp=!lower $tmp
tmp6=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp6)
val13=!exec pari print($t_)
