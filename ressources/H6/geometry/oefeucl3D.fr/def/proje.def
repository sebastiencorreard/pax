tmp1=!item 2 of $val12

tmp2=!item 3 of $val12

tmp=!translate ";': to $     $ in ($(tmp0))^2+($(tmp1))^2+($(tmp2))^2

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp3)
val14=!exec pari print($t_)
tmp0=!item 1 of $val11

tmp1=!item 1 of $val12

t_=!rawmath $(tmp0)-($val13)/$val14*($(tmp1))
val15=!exec pari print($t_)
