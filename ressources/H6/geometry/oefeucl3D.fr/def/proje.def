tmp=!translate ";': to $     $ in ($val8)*x + ($val9)*y + ($val10)*z

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val19=$(tmp0)
val20=Soit \(\RR^3) muni de son produit scalaire usuel et	\(F) le sous-espace vectoriel d'équation
