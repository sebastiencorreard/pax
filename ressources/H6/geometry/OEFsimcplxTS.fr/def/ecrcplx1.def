val6=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,-5/6,-3/4,-2/3,-1/2,-1/3,-1/4,-1/6
val7=1,sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1,-sqrt(3)/2,-sqrt(2)/2,-1/2,0,1/2,sqrt(2)/2,sqrt(3)/2
val8=0,1/2,sqrt(2)/2,sqrt(3)/2,1,sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1,-sqrt(3)/2,-sqrt(2)/2,-1/2
val9=1,\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2},-1,-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2},,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2}
val10=0,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2},1,\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2},-1,-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2}
tmp0=!randint -5, 5

val11=$[rint($(tmp0))]

!ifval $val11=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val12=$[rint($(tmp2))]
!endif
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
!if $val13=1 
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
val12=$[rint(0)]
!endif
!if $val13=2 
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
val11=$[rint(0)]
!endif
!if $val13=3 
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val12=$[rint($val11*$(tmp0))]
!endif
tmp=!nonempty items 1,2,3,1/2,2/3,1/4

tmp0=!randitem $tmp
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp=!nonempty items 1,2,3,1/2

tmp0=!randitem $tmp
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp0=!texmath $val14

val15=$(tmp0)
tmp0=!itemcnt $val6

tmp1=!randint 1, $(tmp0)

val16=$[rint($(tmp1))]
t_=!rawmath $(val6[$val16])
val17=!exec pari print($t_)
t_=!replace internal \( by ( in $val17*x
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val18=$(tmp1)
tmp0=!replace internal x by \pi in $val18

val18=$(tmp0)
t_=!rawmath $val11+i*$val12
t_=!exec pari print($t_)
val19=!mathsubst I=i in $t_
tmp0=!texmath $val19

val20=$(tmp0)
val21=$val14*($(val7[$val16])+i*$(val8[$val16]))*(z-($val19))+$val19
val22=$val14*($(val7[$val16])+i*$(val8[$val16]))
t_=!rawmath ($val19)*(1-$val14*($(val7[$val16])+i*$(val8[$val16])))
t_=!exec pari print($t_)
val23=!mathsubst I=i in $t_
val24=$val14*($(val9[$val16])+i*$(val10[$val16]))*(z-($val19))+$val19
replytype1=complex

replyname1=a
replygood1=$val22
replytype2=complex

replyname2=b
replygood2=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

