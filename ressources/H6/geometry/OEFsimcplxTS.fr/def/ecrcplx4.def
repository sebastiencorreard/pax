!set title=Ecriture complexe 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
computeanswer=yes

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=0,1/6,1/4,1/3,1/2,2/3,3/4,5/6,1,-5/6,-3/4,-2/3,-1/2,-1/3,-1/4,-1/6
val7=1,sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1,-sqrt(3)/2,-sqrt(2)/2,-1/2,0,1/2,sqrt(2)/2,sqrt(3)/2
val8=0,1/2,sqrt(2)/2,sqrt(3)/2,1,sqrt(3)/2,sqrt(2)/2,1/2,0,-1/2,-sqrt(2)/2,-sqrt(3)/2,-1,-sqrt(3)/2,-sqrt(2)/2,-1/2
val9=1,\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2},-1,-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2},,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2}
val10=0,\frac{1}{2},\frac{\sqrt{2}}{2},\frac{\sqrt{3}}{2},1,\frac{\sqrt{3}}{2},\frac{\sqrt{2}}{2},\frac{1}{2},0,-\frac{1}{2},-\frac{\sqrt{2}}{2},-\frac{\sqrt{3}}{2},-1,-\frac{\sqrt{3}}{2},-\frac{\sqrt{2}}{2},-\frac{1}{2}
tmp0=!makelist x for x=-5 to 5

val11=$(tmp0)
tmp0=!shuffle  $val11

val11=$(tmp0)
tmp0=!randint -5, 5

t_=!rawmath $(val11[1])+$(tmp0)*i
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
tmp0=!randint -5, 5

t_=!rawmath $(val11[2])+$(tmp0)*i
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
tmp0=!randint -5, 5

t_=!rawmath $(val11[3])+$(tmp0)*i
t_=!exec pari print($t_)
val14=!mathsubst I=i in $t_
tmp0=!randint -5, 5

t_=!rawmath $(val11[4])+$(tmp0)*i
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
t_=!rawmath (($val13)-($val15))/(($val12)-($val14))
t_=!exec pari print($t_)
val16=!mathsubst I=i in $t_
t_=!rawmath (($val12)*($val15)-($val14)*($val13))/(($val12)-($val14))
t_=!exec pari print($t_)
val17=!mathsubst I=i in $t_
replytype1=complex

replyname1=a
replygood1=$val16
replytype2=complex

replyname2=b
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Déterminer les nombres complexes 
!insmath a
$() et 
!insmath b
$() tels que	la similitude directe d'écriture complexe 
!insmath z'=a z+b
$()	envoie le point 
!insmath A($val12)
$() sur le point 
!insmath B($val13)
$()	et le point 
!insmath C($val14)
$() sur le point 
!insmath D($val15)
$().	</p>	<div class="wimscenter"> 
!insmath a=
$()  
!read oef/embed.phtml reply1 
$() et 
!insmath b=
$()  
!read oef/embed.phtml reply2 
$()</div>	
$()
!exit

