tmp=!trim On considère l'ensemble des points de \(\RR^3\) vérifiant en	  De quel type de lieu s'agit-il	  Le demi-cône est-il orienté vers le haut ou vers le bas&nbsp;	  Donnez l'équation cartésienne du cône qui le contient&nbsp;	  La demi-droite est-elle orientée vers le haut ou vers le bas&nbsp;	  Donnez l'équation cartésienne (polynomiale en x, y et z)	  Donnez l'équation cartésienne (polynomiale en x, y et z) du plan qui le contient	  Donnez l'équation cartésienne (polynomiale en x, y et z) du cône qui le contient
val11=!translate internal $	\
$ to ;; in $tmp
val12=type de surface,équation cartésienne,orientation
tmp=!trim Faites un dessin&nbsp;	  Pour obtenir l'équation du cône, partez de l'équation
val13=!translate internal $	\
$ to ;; in $tmp
val14=1
tmp0=!randitem 1,2

val15=$(tmp0)

!ifval $val15=1
val16= theta.gif
!else
val16= varphi.gif
!endif

!ifval $val15=1
val17= varphi.gif
!else
val17=theta.gif
!endif

!ifval $val15=1 
val18= \theta
!else
val18= \varphi
!endif

!ifval $val15=1 
val19= \varphi
!else
val19=\theta
!endif

!ifval $val14=1 
val20= $(val10[$val14]), r,\theta , z 
!else
val20= $(val10[$val14]) , r, $val18, $val19
!endif

!ifval $val14=1 
tmp0=!randitem 1,2,2,3,3,4

val21= $(tmp0)
!else
tmp1=!randitem 1,2,2,3,3

val21=$(tmp1)
!endif
tmp0=!item 1 of $val20

val22=$(tmp0)
tmp0=!item 3 of $val20

val23=$(tmp0)
!if $val14=2 
tmp0=!item 4 of $val20 

val24=$(tmp0)
!endif
tmp0=!randint 4, 9

val25=$[$(tmp0)]
tmp0=!randint 0, $val25

val26=$[$(tmp0)]

!ifval $val21<4
tmp0=!item $val21+1 of $val20

val27= $(tmp0)
!else
val27= z
!endif

!ifval z notin $val27 and r notsametext $val27 
tmp=!translate ";': to $     $ in ($val26)/$val25

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28= $(tmp0)
!else
val28=$val25
!endif

!ifval z isin $val27 and $val21=4
val28= r
!endif

!ifval $val14=1 and $val21=1 
val29= 2
!else
val29= 5
!endif

!ifval $val14=1 and $val21=2 
val29= 1
!endif

!ifval $val14=1 and $val21=4 
val29= 4
!endif

!ifval $val14=2 and $val21=1 
val29= 3
!endif

!ifval $val14=2 and $val21=3 
val29= 4
