!endif

!ifval $val14=2 and $val21=3 and $val28=1/2 
val29= 5
!endif
val30=$[($val28)^2]

!ifval $val14=1 and $val21=1 
tmp=!translate ";': to $     $ in x^2+y^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31= $(tmp0)=$val30
!endif

!ifval $val14=1 and $val21=2 
tmp=!translate ";': to $     $ in cos($val28*pi)*y-sin($val28*pi)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath  $(tmp0)
!endif

!ifval $val14=1 and $val21=2 
val31= $val31=0
!endif

!ifval $val14=1 and $val21=3 
val31= z=$val28
!endif

!ifval $val14=1 and $val21=4 
val31= z^2=x^2+y^2
!endif

!ifval $val14=2 and $val21=1 
val31= x^2+y^2+z^2=$val30
!endif

!ifval $val14=2 and $val21=3
tmp=!translate ";': to $     $ in sin($val28*\pi)^2*(x^2+y^2)-cos($val28*\pi)^2*z^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath  $(tmp0)
!endif

!ifval $val14=2 and $val21=3
val31= $val31=0
!endif

!ifval $val14=2 and $val21=3 and $val28=1/2
val31=z=0
!endif

!ifval $val14=2 and $val21=2 
tmp=!translate ";': to $     $ in cos($val28*\pi)*y-sin($val28*\pi)*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=!rawmath  $(tmp0)
!endif

!ifval $val14=2 and $val21=2 
val31= $val31=0
!endif

!ifval $val14=2 and $val21=3 and $val28<1/2
val32=1
!else
val32=2
!endif

!ifval $val14=2 and $val21=3 and $val28=0
val32=1
!endif

!ifval $val14=2 and $val21=3 and $val28=1
val32=2
!endif
val33=arrow 0,0,3,0,10,black	arrow 0,0,0,3, 10,black	arrow 0,0,-1.6,-1.6, 10,black	text blue, -1.8,-1.8, medium, x	text blue,0.5,2.9, medium, z	text blue,2.8, 0.5,medium, y	
!if $val14=2 
val34=xrange -3,3	yrange -3,3	$val33	linewidth 2	segment 0,0,2.2,2.2,green	segment 0,0, 2.2,-0.5,green	dsegment 2.2,-0.5,2.2,2.2,black	dsegment 0,2.5,2.2,2.2,black	trange 5*pi/4,2*pi-pi/16	plot , cos(t),sin(t)	arrow cos(-pi/16-0.2),sin(-pi/16-0.2),cos(-pi/16),sin(-pi/16),10, red	trange pi/4, pi/2	plot , cos(t),sin(t)	arc 0, 0, 2, 2, 45, 90, red	arc 0, 0, 2, 2, 225,348.75, red	text black, 1.1, 0.8, large, r	arrow cos(pi/4+0.2),sin(pi/4+0.2),cos(pi/4),sin(pi/4),10, red	copy 1.3*cos(3*pi/8),1.3*sin(3*pi/8),-1,-1,-1,-1,mathfonts/109/$val17	copy 1.3*cos(3*pi/2+0.2),1.3*sin(3*pi/2+0.2),-1,-1,-1,-1,mathfonts/109/$val16	  
!else
val34=xrange -3,3	yrange -3,3	$val33	linewidth 2	segment 0,0,2.2,2.2,green	segment 0,0, 2.2,-0.8,green	dsegment 2.2,-0.8,2.2,2.2,black	dsegment 0,2.8,2.2,2.2,black	arrow cos(-pi/16-0.4),sin(-pi/16-0.4),cos(-pi/16-0.2),sin(-pi/16-0.2),10, red	text black, 1.3, -0.6, medium, r	text black, -0.2, 1.5, medium, z	arc 0, 0, 2, 2, 225,335, red	copy 1.3*cos(3*pi/2+0.2),1.3*sin(3*pi/2+0.2),-1,-1,-1,-1,mathfonts/109/theta.gif	
!endif

!ifval $val14=2 and $val21=3 and ($val28 <> 1/2 and $val28 <> 0 and $val28<>1) 
val35= r1	r3, r2
!else
val35=	r1	r2
