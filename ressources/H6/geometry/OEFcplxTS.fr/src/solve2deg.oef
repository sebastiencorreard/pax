\title{Résolution d'une équation du second degré}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}

\text{lstrep=deux solutions réelles, une solution réelle double,deux solutions complexes conjuguées}
\integer{rep=randint(1,2,3,3,3)}
\if{\rep=1}{
  \integer{x1=randint(1..10)*randint(1,-1)}
  \integer{x2=\x1+randint(2..5)}
  \rational{x2=\x2=0?\x1/2}
  \integer{a=randint(1..3)*randint(1,-1)}
  \text{equat=texmath(maxima(expand(\a*(z-\x1)*(z-\x2))))}
  \text{mstep=r1
  r2,r3}
}
\if{\rep=2}{
  \rational{x1=randint(1..10)*randint(1,-1)/randint(1..5)}
  \integer{a=randint(1..3)*randint(1,-1)}
  \text{equat=texmath(maxima(expand(\a*(z-\x1)^2)))}
  \text{mstep=r1
  r2}
}
\if{\rep=3}{
  \integer{x1=randint(-10..10)}
  \integer{y1=randint(1..10)}
  \integer{a=randint(1..3)*randint(1,-1)}
  \complex{z1=\x1-\y1*i}
  \complex{z2=\x1+\y1*i}
  \text{equat=texmath(maxima(expand(\a*(z-\z1)*(z-\z2))))}
  \text{mstep=r1
  r4,r5}
}

\steps{\mstep}
\statement{<p>
On considère l'équation \((E):\equat=0).
</p>
\if{\step=1}{
L'équation \((E)) possède :
<ul><li>\embed{reply1,1}</li>
<li>\embed{reply1,2}</li>
<li>\embed{reply1,3}</li>
</ul>
}{
  L'équation \((E)) possède \lstrep[\rep].
  \if{\rep=1}{
  Quelles sont ces solutions réelles \(x_1 < x_2) ?
  <div class="wimscenter"><label for="reply2">\(x_1)</label>=\embed{reply2,5}</div>
  <div class="wimscenter"><label for="reply3">\(x_2)</label>=\embed{reply3,5}</div>
   }
  \if{\rep=2}{
  Quelle est cette solution réelle double \(x_1) ?
  <div class="wimscenter"><label for="reply2">\(x_1)</label>=\embed{reply2,5}</div>
   }
  \if{\rep=3}{
  Quelles sont ces solutions complexes conjuguées \(z_1 et z_2)?
  <div class="wims_instruction"> On prendra pour \(z_1) la solution de partie imaginaire négative.</div>
  <div class="wimscenter"> <label for="reply4">\(z_1)</label>=\embed{reply4,5}</div>
  <div class="wimscenter"> <label for="reply5">\(z_2)</label>=\embed{reply5,5}</div>
   }
}
}
\answer{type de solutions}{\rep;\lstrep}{type=radio}
\answer{\(x_1)}{\x1}{type=numexp}
\answer{\(x_2)}{\x2}{type=numexp}
\answer{\(z_1)}{\z1}{type=formal}
\answer{\(z_2)}{\z2}{type=formal}
