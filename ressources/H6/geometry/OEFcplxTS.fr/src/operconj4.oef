\rational{azp=\azp>1?simplify(\azp-2)}
\rational{azp=\azp<=-1?simplify(\azp+2)}
\rational{azc=\azc>1?simplify(\azc-2)}
\rational{azc=\azc<=-1?simplify(\azc+2)}
