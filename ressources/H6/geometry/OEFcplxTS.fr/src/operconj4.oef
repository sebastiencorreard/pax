\integer{d2=\d1}
\rational{a1=\n1=\d1?simplify((\n1+1)/\d1):simplify(\n1/\d1)}
\rational{a1=\a1>1?simplify(\a1-2)}
\rational{a1=\a1<=-1?simplify(\a1+2)}
