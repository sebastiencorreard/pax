\title{Opérations et conjugués 4}
\integer{x1=randint(-5..5)}
\integer{y1=\x1=0?randint(1..5)*randint(1,-1):randint(-5..5)}
\integer{x2=randint(-5..5)}
\integer{y2=\x2=0?randint(1..5)*randint(1,-1):randint(-5..5)}
\complex{z1=\x1+\y1*i}
