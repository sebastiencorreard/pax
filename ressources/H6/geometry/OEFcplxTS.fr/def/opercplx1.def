!set title=Opérations et complexes 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
computeanswer=no

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]

!ifval $val6=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val7=$[rint($(tmp2))]
!endif
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]

!ifval $val8=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val9=$[rint($(tmp2))]
!endif
t_=!rawmath $val6+($val7)*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
t_=!rawmath $val8+($val9)*i
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val12*($val6+($val7)*i)+$val13*($val8+($val9)*i)
t_=!exec pari print($t_)
val14=!mathsubst I=i in $t_
tmp0=!texmath $val12*u+$val13*v

val15=$(tmp0)
tmp0=!replace internal u by z_1 in $val15

val15=$(tmp0)
tmp0=!replace internal v by z_2 in $val15

val15=$(tmp0)
replytype1=complex

replyname1=\($val15)
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Soient les nombres complexes 
!insmath z_1=$val10
$() et 
!insmath z_2=$val11
$().</p>	   Calculer 
!insmath $val15
$():	<div class="wimscenter">	<label for="reply1">
!insmath $val15
$()=</label> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,15
embedcnt=1
