!set title=Opérations et complexes 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
computeanswer=no

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]

!ifval $val6=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val7=$[rint($(tmp2))]
!endif
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]

!ifval $val8=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val9=$[rint($(tmp2))]
!endif
t_=!rawmath $val6+($val7)*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
t_=!rawmath $val8+($val9)*i
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
t_=!rawmath ($val6+($val7)*i)*($val8+($val9)*i)
t_=!exec pari print($t_)
val12=!mathsubst I=i in $t_
t_=!rawmath ($val6+($val7)*i)^2
t_=!exec pari print($t_)
val13=!mathsubst I=i in $t_
replytype1=complex

replyname1=\(z_1 \times z_2)
replygood1=$val12
replytype2=complex

replyname2=\(z_1^2)
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Soient les nombres complexes 
!insmath z_1=$val10
$() et 
!insmath z_2=$val11
$().</p>	   Calculer:	<ol>	<li><label for="reply1">
!insmath z_1 \times z_2
$()=</label> 
!read oef/embed.phtml reply1 
$()</li>	<li><label for="reply2">
!insmath z_1^2
$()=</label> 
!read oef/embed.phtml reply2 
$()</li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=2
