!set title=Opérations et conjugués 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
computeanswer=yes

ansorder=r
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -5, 5

val6=$[rint($(tmp0))]

!ifval $val6=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val7=$[rint($(tmp2))]
!endif
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]

!ifval $val8=0
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
!else
tmp2=!randint -5, 5

val9=$[rint($(tmp2))]
!endif
t_=!rawmath $val6+$val7*i
t_=!exec pari print($t_)
val10=!mathsubst I=i in $t_
t_=!rawmath $val8+$val9*i
t_=!exec pari print($t_)
val11=!mathsubst I=i in $t_
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
!if $val14=1 
t_=!rawmath $val12*($val6-$val7*i)+$val13*($val8+$val9*i)
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
val16=\overline{z_1}
val17=z_2
tmp0=!texmath $val12*u+$val13*v

val18=$(tmp0)
tmp0=!replace internal v by $val17 in $val18

val18=$(tmp0)
tmp0=!replace internal u by $val16 in $val18

val18=$(tmp0)
!endif
!if $val14=2 
t_=!rawmath $val12*($val6+$val7*i)+$val13*($val8-$val9*i)
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
val17=\overline{z_2}
val16=z_1
tmp0=!texmath $val12*u+$val13*v

val18=$(tmp0)
tmp0=!replace internal u by $val16 in $val18

val18=$(tmp0)
tmp0=!replace internal v by $val17 in $val18

val18=$(tmp0)
!endif
!if $val14=3 
t_=!rawmath $val12*($val6-$val7*i)+$val13*($val8-$val9*i)
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
val16=z_1
val17=z_2
tmp0=!texmath $val12*u+$val13*v

val18=$(tmp0)
tmp0=!replace internal u by $val16 in $val18

val18=$(tmp0)
tmp0=!replace internal v by $val17 in $val18

val18=$(tmp0)
val18=\overline{($val18)}
!endif
!if $val14=4 
t_=!rawmath $val12*($val6-$val7*i)+$val13*($val8+$val9*i)
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
val17=\overline{z_2}
val16=z_1
tmp0=!texmath $val12*u+$val13*v

val18=$(tmp0)
tmp0=!replace internal v by $val17 in $val18

val18=$(tmp0)
tmp0=!replace internal u by $val16 in $val18

val18=$(tmp0)
val18=\overline{$val18}
!endif
replytype1=complex

replyname1=\($val18)
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>Soient les nombres complexes 
!insmath z_1=$val10
$() et 
!insmath z_2=$val11
$().</p>	Calculer 
!insmath $val18
$():	<div class="wimscenter"><label for="reply1">
!insmath $val18
$()=</label> 
!read oef/embed.phtml reply1 
$()</div>	
$()
!exit

