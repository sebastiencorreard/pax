!set title=Résolution d'une équation du second degré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r,r,r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=deux solutions réelles, une solution réelle double,deux solutions complexes conjuguées
tmp0=!randitem 1,2,3,3,3

val7=$[rint($(tmp0))]
!if $val7=1 
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 5

val9=$[rint($val8+$(tmp0))]

!ifval $val9=0
t_=!rawmath $val8/2
val9=!exec pari print($t_)
!endif
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val10*(z-$val8)*(z-$val9))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=r1	  r2,r3
!endif
!if $val7=2 
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

tmp2=!randint 1, 5

t_=!rawmath $(tmp0)*$(tmp1)/$(tmp2)
val8=!exec pari print($t_)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in expand($val10*(z-$val8)^2)
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=r1	  r2
!endif
!if $val7=3 
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint 1, 10

val13=$[rint($(tmp0))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val8-$val13*i
t_=!exec pari print($t_)
val14=!mathsubst I=i in $t_
t_=!rawmath $val8+$val13*i
t_=!exec pari print($t_)
val15=!mathsubst I=i in $t_
t_=!replace internal \( by ( in expand($val10*(z-$val14)*(z-$val15))
tmp0=!exec maxima $t_

tmp1=!texmath $(tmp0)

val11=$(tmp1)
val12=r1	  r4,r5
!endif
oefsteps=$val12 
nextstep=!nosubst $val12 
!readproc oef/steps.proc
replytype1=radio
replyname1=type de solutions
replygood1=$val7;$val6
replytype2=numexp
replyname2=\(x_1)
replygood2=$val8
replytype3=numexp
replyname3=\(x_2)
replygood3=$val9
replytype4=formal
replyname4=\(z_1)
replygood4=$val14
replytype5=formal
replyname5=\(z_2)
replygood5=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère l'équation 
!insmath (E):$val11=0
$().	</p>	
!if $m_step=1 
$()	L'équation 
!insmath (E)
$() possède :	<ul><li> 
!read oef/embed.phtml reply1,1 
$()</li>	<li> 
!read oef/embed.phtml reply1,2 
$()</li>	<li> 
!read oef/embed.phtml reply1,3 
$()</li>	</ul>	 
!else
$() 	  L'équation 
!insmath (E)
$() possède $(val6[$val7]).	  
!if $val7=1 
$()	  Quelles sont ces solutions réelles 
!insmath x_1 < x_2
$() ?	  <div class="wimscenter"><label for="reply2">
!insmath x_1
$()</label>= 
!read oef/embed.phtml reply2,5 
$()</div>	  <div class="wimscenter"><label for="reply3">
!insmath x_2
$()</label>= 
!read oef/embed.phtml reply3,5 
$()</div>	    
!endif
$()	  
!if $val7=2 
$()	  Quelle est cette solution réelle double 
!insmath x_1
$() ?	  <div class="wimscenter"><label for="reply2">
!insmath x_1
$()</label>= 
!read oef/embed.phtml reply2,5 
$()</div>	    
!endif
$()	  
!if $val7=3 
$()	  Quelles sont ces solutions complexes conjuguées 
!insmath z_1 et z_2
$()?	  <div class="wims_instruction"> On prendra pour 
!insmath z_1
$() la solution de partie imaginaire négative.</div>	  <div class="wimscenter"> <label for="reply4">
!insmath z_1
$()</label>= 
!read oef/embed.phtml reply4,5 
$()</div>	  <div class="wimscenter"> <label for="reply5">
!insmath z_2
$()</label>= 
!read oef/embed.phtml reply5,5 
$()</div>	    
!endif
$()	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11
embedcnt=8
