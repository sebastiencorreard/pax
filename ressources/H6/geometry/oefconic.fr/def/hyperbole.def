tmp=!translate ";': to $     $ in ($val8)*x^2-($val9+3)*y^2=-$val10

tmp=!lower $tmp
tmp5=!exec maxima fullratsimp($tmp);
val13=\($(tmp0)=$val10),	\($(tmp1)=$val10),	\( $(tmp2)),	\( $(tmp3)),	\( $(tmp4)),	\( $(tmp5))	
tmp=!translate ";': to $     $ in ($val8)*x^2-($val9+3)*y^2-$val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in ($val8+3)*x^2-($val9)*y^2-$val10

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in ($val8)*x^2-($val9)*y^2+$val10

tmp=!lower $tmp
