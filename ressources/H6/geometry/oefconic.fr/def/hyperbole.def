tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=\($(tmp0)=$val10)
tmp=!translate ";': to $     $ in ($val8)*x^2-($val9+3)*y^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in ($val8+3)*x^2-($val9)*y^2

tmp=!lower $tmp
