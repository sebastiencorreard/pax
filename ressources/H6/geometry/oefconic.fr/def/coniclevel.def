!set title=Coniques et courbes de niveau
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!random 2, 10

tmp1=!randitem 1,-1

val7=$[floor($(tmp0)*10)/10*$(tmp1)]
tmp0=!random 2, 10

val8=$[floor($(tmp0)*10)/10*sign($val7)]
tmp=!nonempty items 1,4,9,1.21,1.49,2.5

tmp0=!randitem $tmp
val9=$[$(tmp0)]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val10=$[rint(2*(ceil(sqrt($(tmp0)+$val7*$val8))+1)*$(tmp1))]
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val11=$[rint(2*(floor(sqrt(-$(tmp0)+$val7*$val8))-1)*$(tmp1))]
val12=$[2*sqrt($val9)*abs($val7)]
tmp=!translate ";': to $     $ in $val7*x^2+($val10)*x*y+ ($val8)*y^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val13=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val7*x^2+($val11)*x*y+ ($val8)*y^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=!rawmath $(tmp0)
tmp=!translate ";': to $     $ in $val7*x^2+($val12)*x*y+ ($val7*$val9)*y^2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val15=!rawmath $(tmp0)
val16=
tmp0=!shuffle  $val13,$val14,$val15

val17=$(tmp0)
!for val18 =1 to 3 
!readproc slib/function/bounds2 $(val17[$val18]),[x,y],  -5,5,-5,5 
tmp0=$slib_out
val19=$(tmp0)
tmp0=!values x*$(val19[2])/10 for x =-12 to 12

val20=$(tmp0)
!readproc oef/draw.phtml 150,150 \
xrange -5,5	yrange  -5,5	hline black,0,0	vline black,0,0	parallel -5,0,5,0,0,1,10,grey	parallel -5,0,5,0,0,-1,10,grey	parallel 0,-5,0,5,1,0,10,grey	parallel 0,-5,0,5,-1,0,10,grey	levelcurve blue,$(val17[$val18]),$val20	disk 0,0,7,blue	text black,0,0,small,(a,b) 
tmp0=$ins_url
val16=$val16, <img src="$(tmp0)" alt="">
!next
tmp0=!nonempty items $val16

val16=$(tmp0)

!ifval $val6=1 
val21= $val16
!else
val21= A,B,C
!endif
tmp0=!randint 1, 3

val22=$[rint($(tmp0))]
tmp0=!randint -3, 3

val23=!rawmath $(tmp0)+$(val17[$val22])
tmp0=!listcomplement $val22 in 1,2,3

val24=$(tmp0)
replytype1=click
replyname1=
replygood1=$val22;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()
!if $val6=1 
$()	 Cliquer sur le dessin représentant les courbes de niveau de la fonction 
!insmath f
$() définie par	 <p class="wimscenter">
!insmath f(x , y) = $val23
$().</p>	 <div class="wimscenter"> 
!read oef/embed.phtml reply1 
$()</div>	 Les autres courbes de niveau sont celles des fonctions 
!insmath $(val17[$(val24[1])])
$(), 
!insmath $(val17[$(val24[2])])
$().	 
!endif
$()		 
!if $val6=2 
$()	  De quelle fonction a-t-on représenté les courbes de niveau sur le dessin suivant ?	  <p class="wimscenter">$(val16[$val22])</p>	  <ul>	    
!for m_k=1 to 3 
$()<li> 
!read oef/embed.phtml reply1,\k 
$() :   
!insmath $(val17[$m_k])
$()</li> 
!next
$()	  </ul>	  
!endif
$()	
$()
!exit

