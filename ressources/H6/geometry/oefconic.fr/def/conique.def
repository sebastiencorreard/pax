!set title=Coniques
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$(tmp0)
tmp0=!randint 1, 2

tmp1=!randitem 1,-1

val7=$(tmp0)*$(tmp1)
tmp0=!randint 1, 2

tmp1=!randitem 1,-1

val8=$(tmp0)*$(tmp1)
tmp0=!randint 1, 3

tmp1=!randitem 1,-1

val9=$(tmp0)*$(tmp1)
tmp=!nonempty items x^2-$val6*y^2 + $val7*x + $val8*y + $val9, (x-$val7)*(y-$val8)+$val9

tmp0=!randitem $tmp
tmp=!nonempty items x^2 + $val7*x + $val8*y + $val9, y^2 + $val7*x + $val8*y + $val9

tmp1=!randitem $tmp
val10=$(tmp0)	(x-$val7)^2 + $val6*(y-$val8)^2 -$val9 	$(tmp1)
tmp0=!randint 3

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate ";': to $     $ in $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
val12=d'une hyperbole,d'une ellipse,d'une parabole

!ifval $val11>=2 
val13= -5+$val7,5+$val8 
!else
val13=-5,5
!endif
val14=xrange $val13	yrange $val13	levelcurve red,$val10	
replytype1=checkbox
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()L'équation 
!insmath $val10 = 0
$() est l'équation 	<ul><li> 
!read oef/embed.phtml reply1,1 
$()</li>	<li> 
!read oef/embed.phtml reply1,2 
$()</li>	<li> 
!read oef/embed.phtml reply1,3 
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'><p class="wimscenter"> 
!read oef/draw.phtml 200,200 \
$val14 
$()</p>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=10,14
embedcnt=3
