\title{Coniques et courbes de niveau}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{N=randint(1,2)}
\real{A=floor(random(2..10)*10)/10*random(1,-1)}
\real{C=floor(random(2..10)*10)/10*sign(\A)}
\real{c=randitem(1,4,9,1.21,1.49,2.5)}
\integer{B=2*(ceil(sqrt(randint(1..3)+\A*\C))+1)*random(1,-1)}
\integer{B2=2*(floor(sqrt(-randint(1..3)+\A*\C))-1)*random(1,-1)}
\real{B3=2*sqrt(\c)*abs(\A)}
\function{f1= simplify(\A*x^2+(\B)*x*y+ (\C)*y^2)}
\function{f2= simplify(\A*x^2+(\B2)*x*y+ (\C)*y^2)}
function{f3= simplify((\A-3)*x^2+(\B)*x*y+ (\C)*y^2)}
function{f4= simplify((\A+3)*x^2+(\B2)*x*y+ (\C)*y^2)}
\function{f5= simplify(\A*x^2+(\B3)*x*y+ (\A*\c)*y^2)}

\text{dessin=}
\text{F=shuffle( \f1,\f2,\f5)}
\for{i=1 to 3}{
	\text{u=slib(function/bounds2 \F[\i],[x,y],  -5,5,-5,5)}
	\text{niveau=wims(values x*\u[2]/10 for x =-12 to 12)}
	\text{dessin=\dessin, <img src="draw(150,150
xrange -5,5
yrange  -5,5
hline black,0,0
vline black,0,0
parallel -5,0,5,0,0,1,10,grey
parallel -5,0,5,0,0,-1,10,grey
parallel 0,-5,0,5,1,0,10,grey
parallel 0,-5,0,5,-1,0,10,grey
levelcurve blue,\F[\i],\niveau
disk 0,0,7,blue
text black,0,0,small,(a,b))" alt="">}
}
\text{dessin=wims(nonempty items \dessin)}
\text{choix=\N=1 ? \dessin: A,B,C}
\integer{H=randint(1..3)}
\function{FF=randint(-3..3)+\F[\H]}
\text{HH=wims(listcomplement \H in 1,2,3)}
\statement{\if{\N=1}{
 Cliquer sur le dessin représentant les courbes de niveau de la fonction \(f) définie par
 <p class="wimscenter">\(f(x , y) = \FF).</p>
 <div class="wimscenter">\embed{reply1}</div>
 Les autres courbes de niveau sont celles des fonctions \(\F[\HH[1]]), \(\F[\HH[2]]).
}

 \if{\N=2}{
  De quelle fonction a-t-on représenté les courbes de niveau sur le dessin suivant ?
  <p class="wimscenter">\dessin[\H]</p>
  <ul>
   \for{k=1 to 3}{<li>\embed{reply1,\k} :   \(\F[\k])</li>}
  </ul>
 }
}
\answer{}{\H;\choix}{type=click}
