\title{Hyperboles}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{liste=shuffle(3)}
\text{N=random(1,2)}
\integer{a=item(1,\liste)+1}
\integer{b=item(2,\liste)+1}
\integer{c=randint(1..5)*random(1,-1)}
\text{eq=simplify((\a)*x^2-(\b)*y^2-\c)}
\text{f=\(simplify((\a)*x^2-(\b)*y^2)=\c)}
\text{listeq= \(simplify((\a)*x^2-(\b+3)*y^2)=\c),
\(simplify((\a+3)*x^2-(\b)*y^2)=\c),
\( simplify((\a)*x^2-(\b)*y^2=-\c)),
\( simplify((\b)*x^2-(\a)*y^2=-\c)),
\( simplify((\a+3)*x^2-(\b)*y^2=-\c)),
\( simplify((\a)*x^2-(\b+3)*y^2=-\c))
}
\text{hyp=simplify((\a)*x^2-(\b+3)*y^2-\c),
simplify((\a+3)*x^2-(\b)*y^2-\c),
simplify((\a)*x^2-(\b)*y^2+\c),
simplify((\b)*x^2-(\a)*y^2+\c),
simplify((\a+3)*x^2-(\b)*y^2+\c),
simplify((\a)*x^2-(\b+3)*y^2+\c)
}
\text{nrows=rows(\hyp)}
\text{choix=item(1..3,shuffle(\nrows))}
\text{cho=shuffle(4)}
\text{hyp=\hyp[\choix],\eq}
\text{hyp=\hyp[\cho]}
\text{listeq= \listeq[\choix],\f}
\text{listeq=\listeq[\cho]}
\text{rep=position(4,\cho)}
\rational{ab=\a/\b}
\text{asympt1= y = sqrt(\ab) * x}
\text{asympt2= y = - sqrt(\ab) * x}
\text{dessin=xrange -5,5
yrange -5,5
parallel -5,0,5,0,0,1,10,grey
parallel -5,0,5,0,0,-1,10,grey
parallel 0,-5,0,5,1,0,10,grey
parallel 0,-5,0,5,-1,0,10,grey
hline 0,0,black
vline 0,0,black
}

\text{listedessin=}
\for{i=1 to 4}{
	\text{listedessin= \listedessin,<img src="draw(150,150
	\dessin
	levelcurve blue,\hyp[\i])" alt="">
	}
}
\text{listedessin=wims(nonempty items \listedessin)}
\text{listechoix=\N=1 ? \listedessin:A,B,C,D}

\steps{reply1
reply2, reply3
}
\statement{
\if{\step=1}{\if{\N=1}{
Parmi les dessins suivants, lequel représente-t-il l'hyperbole d'équation
<p class="wimscenter">\f</p>
<p class="wimscenter">\embed{reply 1}</p>
}{
Parmi les équations suivantes, laquelle représente-t-elle le dessin d'hyperbole suivant :
<p class="wimscenter">\listedessin[\rep]</p>
<ul>\for{k=1 to 4}{<li>\embed{reply1,\k} : \listeq[\k] </li>}</ul>}
}

\if{\step=2}{
 Donner les équations des asymptotes de l'hyperbole d'équation \f
<p class="wimscenter">\listedessin[\rep]</p>
<p class="wimscenter"> \(y = ) \embed{reply2}, \(y = ) \embed{reply3}</p>

<em>On donnera d'abord l'équation de l'asymptote de pente positive.</em>}
}

\answer{}{\rep;\listechoix}{type=click}
\answer{Première asymptote}{sqrt(\ab)*x}{type=function}
\answer{Deuxième asymptote}{-sqrt(\ab)*x}{type=function}
