\text{e=randint(1..2)}
\text{a=randint(1..2)*random(1,-1)}
\text{b=randint(1..2)*random(1,-1)}
\text{c=randint(1..3)*random(1,-1)}

\text{f=randitem(x^2-\e*y^2 + \a*x + \b*y + \c, (x-\a)*(y-\b)+\c)
(x-\a)^2 + \e*(y-\b)^2 -\c 
randitem(x^2 + \a*x + \b*y + \c, y^2 + \a*x + \b*y + \c)}
\text{H=randint(3)}
\text{f=row(\H,\f)}
\text{f=simplify(\f)}
\text{choix=d'une hyperbole,d'une ellipse,d'une parabole}
\text{range=\H>=2 ? -5+\a,5+\b :-5,5}
\text{dessin=xrange \range
yrange \range
levelcurve red,\f
}


\statement{L'équation \(\f = 0) est l'équation 
<ul><li>\embed{reply1,1}</li>
<li>\embed{reply1,2}</li>
<li>\embed{reply1,3}</li>
</ul>
}

\answer{}{\H;\choix}{type=checkbox}
\feedback{1=1}{<p class="wimscenter">\draw{200,200}{\dessin}</p>}
