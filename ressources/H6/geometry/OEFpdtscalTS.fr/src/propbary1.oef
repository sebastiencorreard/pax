\integer{b=randint(1..10)*randint(1,-1)}
\integer{d=randint(2,4,5,8,10)*randint(1,-1)}
\integer{c=\d-\a-\b}
\rational{xG=simplify((\a*\u[1]+\b*\v[1]+\c*\w[1])/\d)}
\rational{yG=simplify((\a*\u[2]+\b*\v[2]+\c*\w[2])/\d)}
\rational{zG=simplify((\a*\u[3]+\b*\v[3]+\c*\w[3])/\d)}
