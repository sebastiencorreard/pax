!set title=Produit scalaire dans l'espace 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint -10, 10

val8=$[rint($(tmp0))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val10=$[rint($val9+$(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val11=$[rint($(tmp0))]
val12=$[rint($val6*$val9+$val7*$val10+$val8*$val11)]
replytype1=numeric
replyname1=produit scalaire
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	  L'espace est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j},\vec{k})
$().	  On considère les vecteurs 
!insmath \vec{u}\left(\begin{array}{c} $val6 \\ $val7 \\ $val8 \end{array}\right)
$()	  et 
!insmath \vec{v}\left(\begin{array}{c} $val9 \\ $val10 \\ $val11 \end{array}\right)
$() :</p><p>	  Calculer 
!insmath \vec{u}\cdot\vec{v}
$().</p>	<div class="wimscenter">	  <label for="reply1">
!insmath \vec{u}\cdot\vec{v}
$() =</label>  
!read oef/embed.phtml reply1,5 
$() </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11
embedcnt=1
