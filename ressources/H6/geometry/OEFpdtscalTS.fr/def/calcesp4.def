!set title=Produit scalaire dans l'espace 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r
varcnt=37
prevarcnt=36
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/random 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
!if $val9=1 
val10=$[rint($(val7[1]))]

!ifval $(val7[2])=0
val11=$[rint($(val7[1]))]
!else
val11=$[rint($(val7[2]))]
!endif
val12=$[rint($(val7[3]))]
val13=$[rint($(val8[3]))]
val14=$[rint($(val8[1]))]
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]

!ifval $val15=0
val16=x
!else
tmp0=!texmath x+$val15

val16=$(tmp0)
!endif
t_=!rawmath -($val10*$val14+$val12*$val13)/$val11-$val15
val17=!exec pari print($t_)
!endif
!if $val9=2 
val11=$[rint($(val7[2]))]

!ifval $(val7[1])=0
val10=$[rint($(val7[2]))]
!else
val10=$[rint($(val7[1]))]
!endif
val12=$[rint($(val7[3]))]
val13=$[rint($(val8[3]))]
val16=$[rint($(val8[2]))]
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]

!ifval $val15=0
val14=x
!else
tmp0=!texmath x+$val15

val14=$(tmp0)
!endif
t_=!rawmath -($val11*$val16+$val12*$val13)/$val10-$val15
val17=!exec pari print($t_)
!endif
!if $val9=3 
val14=$[rint($(val8[1]))]

!ifval $(val8[2])=0
val16=$[rint($(val8[1]))]
!else
val16=$[rint($(val8[2]))]
!endif
val12=$[rint($(val7[3]))]
val13=$[rint($(val8[3]))]
val10=$[rint($(val7[1]))]
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]

!ifval $val15=0
val11=x
!else
tmp0=!texmath x+$val15

val11=$(tmp0)
!endif
t_=!rawmath -($val10*$val14+$val12*$val13)/$val16-$val15
val17=!exec pari print($t_)
!endif
!if $val9=4 
val16=$[rint($(val8[2]))]

!ifval $(val8[1])=0
val14=$[rint($(val8[2]))]
!else
val14=$[rint($(val8[1]))]
!endif
val12=$[rint($(val7[3]))]
val13=$[rint($(val8[3]))]
val11=$[rint($(val7[2]))]
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]

!ifval $val15=0
val10=x
!else
tmp0=!texmath x+$val15

val10=$(tmp0)
!endif
t_=!rawmath -($val11*$val16+$val12*$val13)/$val14-$val15
val17=!exec pari print($t_)
!endif
replytype1=numexp
replyname1=\(x\)
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	 L'espace est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j},\vec{k})
$().	 Soient	 
!insmath \vec{u}\left(\begin{array}{c} $val10 \\ $val11 \\ $val12\end{array}\right)
$()	 et 
!insmath \vec{v}\left(\begin{array}{c} $val14 \\ $val16 \\ $val13\end{array}\right)
$().	 Déterminer la ou les valeurs de 
!insmath x
$() pour que les vecteurs 
!insmath \vec{u}
$() et 
!insmath \vec{v}
$()	 soient orthogonaux :</p>	<div class="wimscenter"><label for="reply1">
!insmath x
$()=</label>  
!read oef/embed.phtml reply1,3 
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14,16
embedcnt=1
