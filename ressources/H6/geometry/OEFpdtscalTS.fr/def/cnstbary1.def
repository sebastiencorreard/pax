!set title=Calcul et construction de barycentre 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 4

val6=$[rint($(tmp0))]
tmp0=!randitem 2,3,5,6,7

val7=$[rint($(tmp0))]
val8=$[rint($val6*$val7)]
val9=$[rint($val6*($val7-1))]
tmp0=!randint 10000, 25000

val10=$[rint($(tmp0))]
val11=$[rint($val6*$val10)]
val12=$val7 \pi,$val8 \pi,	\frac{\sqrt{$val7}-1}{$val9},\frac{1}{1+\sqrt{$val7}}	$val10,$val11	
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$(val13[1])
val15=$(val13[2])
!readproc slib/draw/repere 806,64,0,-10,40,-1,3,1,1,black,grey 
tmp0=$slib_out
val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$[rint($(tmp0))]
tmp0=!item 2 of $val17

val19=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val16

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val20=$[rint($(tmp0))]
tmp0=!item 2 of $val17

val21=$[rint($(tmp0))]
t_=!rawmath 30*$val6/(1+$val6)
val22=!exec pari print($t_)
val23=$[rint(0)]
t_=!rawmath $val18+$val20*$val22
val24=!exec pari print($t_)
t_=!rawmath $val24-0.3*$val20
val25=!exec pari print($t_)
t_=!rawmath $val24+0.3*$val20
val26=!exec pari print($t_)
!readproc oef/draw.phtml 806,64 \
  xrange -10,40	  yrange -1,3	  hline 0,0,red	  parallel -9,-0.2,-9,0.2,1,0,50,blue	  linewidth 2	  parallel -5,-0.4,-5,0.4,10,0,5,green	  parallel -10,-0.4,-10,0.4,10,0,6,red	  text red,-0.1,1.5,medium,A	  text red,30-0.1,1.5,medium,B	  linewidth 5	  points red,0,0,30,0 
tmp0=$ins_url
val27=$(tmp0)	  
val28=xrange -10,40	  yrange -1,3	  hline 0,0,red	  parallel -9,-0.2,-9,0.2,1,0,50,blue	  linewidth=2	  parallel -5,-0.4,-5,0.4,10,0,5,green	  parallel -10,-0.4,-10,0.4,10,0,6,red	  text red,-0.1,1.5,medium,A	  text red,30-0.1,1.5,medium,B	  linewidth 5	  points red,0,0,30,0,$val22,0	  text red,$val22-0.1,-0.5,medium,M	  
replytype1=coord
replyname1=
replygood1=$val27;rectangle,$val25,0,$val26,64
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	 On a représenté ci-dessous un segment 
!insmath \lbrack A B \rbrack
$(), de longueur non	 nulle. Placer le barycentre des points 
!insmath A
$() et 
!insmath B
$(),	 affectés des coefficients 
!insmath \alpha=$val14
$() et 
!insmath \beta=$val15
$().	 </p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	<div class="wimscenter">	 
!read oef/draw.phtml 800,64 \
$val28 
$()	</div>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,15,28
embedcnt=0
