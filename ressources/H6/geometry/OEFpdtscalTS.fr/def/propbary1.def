!set title=Propriétés des barycentres 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r,r,r,r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,4,5,8,10

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
val13=$[rint($val12-$val10-$val11)]
tmp=!translate ";': to $     $ in ($val10*$(val7[1])+$val11*$(val8[1])+$val13*$(val9[1]))/$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val14=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val10*$(val7[2])+$val11*$(val8[2])+$val13*$(val9[2]))/$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val15=!exec pari print($t_)
tmp=!translate ";': to $     $ in ($val10*$(val7[3])+$val11*$(val8[3])+$val13*$(val9[3]))/$val12

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
val17=$[rint(-$(val7[1])-$(val8[1]))]
val18=$[rint(-$(val7[2])-$(val8[2]))]
val19=$[rint(-$(val7[3])-$(val8[3]))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val20=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val21=$[rint($(tmp0)*$(tmp1))]
val22=$[rint(1-$val20-$val21)]
val17=$[rint($val20*$(val7[1])+$val21*$(val8[1])+$val22*$(val9[1]))]
val18=$[rint($val20*$(val7[2])+$val21*$(val8[2])+$val22*$(val9[2]))]
val19=$[rint($val20*$(val7[3])+$val21*$(val8[3])+$val22*$(val9[3]))]
replytype1=numeric
replyname1=\(\alpha)
replygood1=$[$val10]
replytype2=numeric
replyname2=\(\beta)
replygood2=$[$val11]
replytype3=numeric
replyname3=\(\gamma)
replygood3=$[$val13]
replytype4=numeric
replyname4=a
replygood4=$[$val20]
replytype5=numeric
replyname5=a
replygood5=$[$val21]
replytype6=numeric
replyname6=a
replygood6=$[$val22]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	 On rapporte l'espace à un repère 
!insmath (0,\vec{i},\vec{j},\vec{k})
$().	 On considère les points 
!insmath A($(val7[1]),$(val7[2]),$(val7[3])),B($(val8[1]),$(val8[2]),$(val8[3]))
$() et 
!insmath C($(val9[1]),$(val9[2]),$(val9[3]))
$().<p>	 </p>	 Déterminer les réels 
!insmath \,\alpha
$(), 
!insmath \,\beta
$() et 
!insmath \,\gamma
$() tels que le point 
!insmath G($val14,$val15,$val16)
$()	 soit le barycentre de 
!insmath (A,\alpha),(B,\beta),(C,\gamma)
$(), avec 
!insmath \alpha+\beta+\gamma=$val12
$().	<div class="wimscenter">	
!insmath \,\alpha=
$() 
!read oef/embed.phtml reply1,3 
$()	
!insmath \,\beta=
$() 
!read oef/embed.phtml reply2,3 
$()	
!insmath \,\gamma=
$() 
!read oef/embed.phtml reply3,3 
$()	</div>	 Déterminer les réels 
!insmath a,b
$() et 
!insmath c
$() tels que le point 
!insmath D($val17,$val18,$val19)
$() soit	 le barycentre de 
!insmath (A,a),(B,b)
$() et 
!insmath (C,c)
$() avec 
!insmath a+b+c=1
$().	<div class="wimscenter">	
!insmath a=
$() 
!read oef/embed.phtml reply4,3 
$() &nbsp;&nbsp; 
!insmath b
$() 
!read oef/embed.phtml reply5,3 
$() &nbsp;&nbsp; 
!insmath c=
$() 
!read oef/embed.phtml reply6,3 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,12,14,15,16,17,18,19
embedcnt=6
