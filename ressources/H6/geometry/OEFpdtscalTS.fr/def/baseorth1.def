!set title=Base orthonormale 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r,r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint -10, 10

val6=$[rint($(tmp0))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
val8=$[rint(($val6)^2+($val7)^2)]
tmp=!translate ";': to $     $ in $val6/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val9=!exec pari print($t_)
tmp0=!texmath $val9

val10=$(tmp0)\sqrt{$val8}
tmp=!translate ";': to $     $ in $val7/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val11=!exec pari print($t_)
tmp0=!texmath $val11

val12=$(tmp0)\sqrt{$val8}
tmp0=!texmath -$val11

val13=$(tmp0)\sqrt{$val8}
replytype1=numeric
replyname1=abscisse 1
replygood1=?analyze 14
replytype2=numeric
replyname2=ordonnée 1
replygood2=?analyze 15
replytype3=numeric
replyname3=abscisse 2
replygood3=?analyze 16
replytype4=numeric
replyname4=ordonnée 2
replygood4=?analyze 17
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	 Le plan est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j})
$().	 Soit 
!insmath \vec{u}\left(\begin{array}{c} $val6 \\ $val7 \end{array}\right)
$().	 </p>	 <ul><li>	 Trouver un vecteur de norme 1 colinéaire à 
!insmath \vec{u}
$():	<div class="wimscenter"> ( 
!read oef/embed.phtml reply1,10 
$(),  
!read oef/embed.phtml reply2,10 
$()).</div>	</li><li>	 Trouver un vecteur de norme 1 orthogonal à 
!insmath \vec{u}
$().	<div class="wimscenter"> ( 
!read oef/embed.phtml reply3,10 
$(),  
!read oef/embed.phtml reply4,10 
$()).</div>	</li></ul>	<div class="wims_instruction">Taper "sqrt(a)" pour 
!insmath \sqrt{a}
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()une solution possible est:	<ul class="wims_nopuce"><li>	 vecteur colinéaire et de norme 1: 
!insmath \left(\begin{array}{c} $val10 \\ $val12 \end{array}\right)
$() ou son opposé	 </li><li>	 vecteur orthogonal et de norme 1 
!insmath \left(\begin{array}{c} $val13 \\ $val10 \end{array}\right)
$() ou son opposé	</li></ul>	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val14)^2+($val15)^2=1 and $val14*$val7-$val15*$val6=0
 condtest1=1
!else
 condtest1=0
!endif
condname1=vecteur colinéaire

!ifval ($val16)^2+($val17)^2=1 and $val16*$val6+$val17*$val7=0
 condtest2=1
!else
 condtest2=0
!endif
condname2=vecteur orthogonal

!exit

:stat
vsavelist=6,7,10,12,13,14,15,16,17
embedcnt=4
