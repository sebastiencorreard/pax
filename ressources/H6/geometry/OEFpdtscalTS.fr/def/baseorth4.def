val13=$(tmp0)
val14=!rawmath $val9*sqrt($val8)*x+$val10*sqrt($val8)*y
val15=!rawmath -$val10*sqrt($val8)*x+$val9*sqrt($val8)*y
val16=$[-$val10*sqrt($val8)]
val17=$[$val9*sqrt($val8)]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val18=$[rint($(tmp0)*$(tmp1))]
