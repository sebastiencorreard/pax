!set title=Base orthonormale 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r,r,r,r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/orthogonal 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in print($val10*[$val7]+$val11*[$val8])
tmp0=!exec pari $t_

tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
replytype1=numeric
replyname1=abscisse de b
replygood1=?analyze 13
replytype2=numeric
replyname2=ordonnée de b
replygood2=?analyze 14
replytype3=numeric
replyname3=cote de b
replygood3=?analyze 15
replytype4=numeric
replyname4=abscisse de b
replygood4=?analyze 16
replytype5=numeric
replyname5=ordonnée de b
replygood5=?analyze 17
replytype6=numeric
replyname6=cote de b
replygood6=?analyze 18
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>	 L'espace est muni d'un repère orthonormal 
!insmath (O,\vec{i},\vec{j},\vec{k})
$().	 On considère le vecteur unitaire	
!insmath \vec{a}\left(\begin{array}{c} $(val7[1]) \\ $(val7[2]) \\ $(val7[3]) \end{array}\right)
$()	 et un vecteur 
!insmath \vec{v}\left(\begin{array}{c} $(val12[1]) \\ $(val12[2]) \\ $(val12[3]) \end{array}\right)
$().	 </p>	<ol>	<li>Déterminer les coordonnées d'un vecteur unitaire 
!insmath \vec{b}
$() orthogonal à 
!insmath \vec{a}
$() et qui s'expriment comme combinaison linéaire des vecteurs 
!insmath \vec{a}
$() et 
!insmath \vec{v}
$().	<div class="wimscenter">
!insmath \vec{b}
$()=( 
!read oef/embed.phtml reply1,7 
$(), 
!read oef/embed.phtml reply2,7 
$(), 
!read oef/embed.phtml reply3,7 
$())</div>	</li><li>	Déterminer les coordonnées d'un vecteur unitaire 
!insmath \vec{c}
$() orthogonal à	
!insmath \vec{a}
$() et 
!insmath \vec{b}
$().	<div class="wimscenter">
!insmath \vec{c}
$()=( 
!read oef/embed.phtml reply4,7 
$(), 
!read oef/embed.phtml reply5,7 
$(), 
!read oef/embed.phtml reply6,7 
$())</div>	</li>	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$() On peut choisir 
!insmath \vec{b}($(val8[1]),$(val8[2]),$(val8[3]))
$() ou son opposé.<p>	 On peut choisir 
!insmath \vec{c}($(val9[1]),$(val9[2]),$(val9[3]))
$() ou son opposé.</p>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val13=$(val8[1]) and $val14=$(val8[2]) and $val15=$(val8[3])) or  ($val13=-$(val8[1]) and $val14=-$(val8[2]) and $val15=-$(val8[3]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=vecteur b

!ifval ($val16=$(val9[1]) and $val17=$(val9[2]) and $val18=$(val9[3])) or  ($val16=-$(val9[1]) and $val17=-$(val9[2]) and $val18=-$(val9[3]))
 condtest2=1
!else
 condtest2=0
!endif
condname2=vecteur c

!exit

:stat
vsavelist=7,8,9,12,13,14,15,16,17,18
embedcnt=6
