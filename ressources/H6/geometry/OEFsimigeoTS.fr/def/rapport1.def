!set title=Rapport de similitude 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,4,5,1/2,2/3,3/4,1/4,1/3

tmp1=!randitem 1,-1,-1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val6=!exec pari print($t_)
tmp0=!texmath $val6

val7=$(tmp0)
tmp0=!randitem 2,3,4,6

val8=$[rint($(tmp0))]
val9=d'une homothétie de rapport \($val7),abs($val6)	d'une rotation d'angle \(\frac{\pi}{$val8}),1	d'une symétrie axiale,1	d'une translation,1
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val11=$(val10[1])
t_=!rawmath $(val10[2])
val12=!exec pari print($t_)
replytype1=numexp
replyname1=rapport
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Quel est le rapport de similitude $val11 ?	</p>	<div class="wimscenter"> <label for="reply1">rapport de similitude =</label>  
!read oef/embed.phtml reply1,4 
$()</div>	
$()
!exit

