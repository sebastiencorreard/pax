val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=ruche.ggb
val7=
val8=file=$val6	width=500	height=400	showToolBar=true	customToolBar="40|41|42|"	showAlgebraInput =false
!readproc slib/geo2D/geogebra $val7 , $val8 
tmp0=$slib_out
val9=$(tmp0)
val10=3,1/3,2/3,P,T,R,H,L,J,K,O,M,C,G,E	1/3,3,2/3,P,R,L,H,J,D,S,U,O,K,M,G	2/3,3/2,1/3,P,R,I,H,J,B,S,U,L,K,M,D	3/2,2/3,1/3,P,Z,R,H,Q,J,K,T,M,C,L,E	2,1/2,1/3,P,Q,I,H,I,B,S,T,L,K,L,D	1/2,2,1/3,P,Z,Q,H,Q,I,K,T,L,C,L,D	1/3,3,2/3,Q,O,U,I,G,M,F,D,J,N,L,R	3,1/3,3,2/3,Q,M,O,I,E,G,N,J,L,V,R,T	3/2,2/3,1/3,Q,H,O,I,A,G,V,M,T,N,E,L	2/3,3/2,1/3,Q,O,W,I,G,P,F,D,M,N,L,U	1/2,2,1/3,Q,H,P,I,A,H,N,E,M,V,M,U	2,1/2,1/3,Q,P,W,I,H,P,F,E,M,N,M,U	2*sqrt(3)/3,sqrt(3)/2,1/6,P,M,I,H,E,B,M,H,L,E,A,B,I,L,P,Q,T,W	sqrt(3)/2,2*sqrt(3)/3,1/6,Q,H,L,I,A,D,Z,P,T,H,Q,M,I,P,Q,Q,W,Z,P,Z,U	sqrt(3),sqrt(3)/3,5/6,P,Q,K,H,I,C,Q,M,T,I,E,L,H,L,E,P,T,M	sqrt(3)/3,sqrt(3),5/6,P,S,Q,H,K,I,Q,L,U,I,D,M,H,M,D,P,U,L	sqrt(3),sqrt(3)/3,1/2,H,I,A,P,Q,H,Q,M,L,I,E,D,M,I,P,E,B,H	sqrt(3)/3,sqrt(3),1/2,I,B,H,Q,I,P,M,H,Q,E,A,I,I,L,M,B,D,E	
tmp=!translate internal $	$ to ; in $val10

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]

!ifval $val12=1
val13=$(val11[1])
!else
val13=$(val11[2])
!endif

!ifval $val12=1
t_=!rawmath $(val11[3])
val14=!exec pari print($t_)
!else
t_=!rawmath -$(val11[3])
val14=!exec pari print($t_)
!endif
val15=la similitude directe de centre
tmp0=!itemcnt $val11

val16=$[rint($(tmp0)/3)]
tmp0=!shuffle $val16-1

val17=$(tmp0)

!ifval $val12=1
val18= $(val11[3*$(val17[2])+2])
!else
val18=$(val11[3*$(val17[2])+3])
!endif

!ifval $val12=2
val19= $(val11[3*$(val17[2])+2])
!else
val19=$(val11[3*$(val17[2])+3])
!endif
val20=$(val11[3*$(val17[2])+1])
val21=la similitude directe de centre $val20 qui envoie $val18 sur $val19
replytype1=numeric
replyname1=rapport
replygood1=$[$val13]
replytype2=numexp
replyname2=angle
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val9</div>	 <div class="medium_size text_col">	<p>Tous les hexagones sont réguliers.</p>	 Déterminer le rapport et l'angle de la similitude directe de centre $val20 qui envoie $val18 sur $val19:	<div class="wimscenter"><label for="reply1">rapport=</label> 
!read oef/embed.phtml reply1,10 
$()</div>	<div class="wimscenter"><label for="reply2">angle=</label> 
!read oef/embed.phtml reply2,5 
$()
!insmath \pi
$()</div>	<div class="wims_instruction">Utiliser le zoom si les points n'apparaissent pas.<br>	Taper sqrt(3) pour 
!insmath \sqrt{3}
$()	</div>	</div>	</div>	
$()
