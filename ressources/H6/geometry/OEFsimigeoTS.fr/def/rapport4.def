!set title=Rapport de similitude 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

tmp1=!randint 1, 5

tmp2=!randitem 1,-1

t_=!rawmath $(tmp0)/$(tmp1)*$(tmp2)
val6=!exec pari print($t_)
tmp0=!randint -3, 3

val7=$[rint($(tmp0))]
tmp0=!randint -5, 5

val8=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val9=$[rint($val8+$(tmp0)*$(tmp1))]
t_=!rawmath $val6*$val8+$val7
val10=!exec pari print($t_)
t_=!rawmath $val6*$val9+$val7
val11=!exec pari print($t_)
tmp0=!randint -3, 3

val12=$[rint($(tmp0))]
tmp0=!randint -5, 5

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randitem 1,-1

val14=$[rint($val13+$(tmp0)*$(tmp1))]
t_=!rawmath -$val13/$val6+$val12
val15=!exec pari print($t_)
t_=!rawmath -$val14/$val6+$val12
val16=!exec pari print($t_)
t_=!rawmath abs(($val14-$val13)/($val6*($val9-$val8)))
val17=!exec pari print($t_)
replytype1=numexp
replyname1=rapport
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Le plan est muni d'un repère orthonormé 
!insmath (O;\vec{i},\vec{j})
$().</p>	Quel est le rapport de la similitude qui transforme le point 
!insmath A($val8;$val10)
$()	en 
!insmath C($val13;$val15)
$() et le point 
!insmath B($val9;$val11)
$() en 
!insmath D($val14;$val16)
$()?	<div class="wimscenter"><label for="reply1">rapport de similitude =</label>  
!read oef/embed.phtml reply1,4 
$()</div>	
$()
!exit

