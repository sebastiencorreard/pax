!set title=Angle de similitude directe 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,4,5,1/2,2/3,3/4,1/4,1/3

tmp1=!randitem 1,-1,-1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val6=!exec pari print($t_)
tmp0=!texmath $val6

val7=$(tmp0)
tmp0=!randitem 2,3,4,6

val8=$[rint($(tmp0))]
tmp0=!randint 1, $val8-1

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val9/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
val11=$val10
tmp0=!replace internal / by , in $val11

val11=$(tmp0)

!ifval $(val11[1])=1
val9=
!else
val9=$(val11[1])
!endif

!ifval $(val11[1])=-1
val9=-
!endif
val8=$[rint($(val11[2]))]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]

!ifval $val12=1
val13= d'une homothétie de rapport \($val7)
!else
val13=d'une rotation d'angle \(\frac{$val9 \pi}{$val8})
!endif

!ifval $val12=2
val14= d'une homothétie de rapport \($val7)
!else
val14=d'une rotation d'angle \(\frac{$val9 \pi}{$val8})
!endif

!ifval $val6>0
t_=!rawmath $val10
val10=!exec pari print($t_)
!else
tmp=!translate ";': to $     $ in $val10+1

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
!endif

!ifval $val10>1
tmp=!translate ";': to $     $ in $val10-2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
!endif
val15=
replytype1=numexp
replyname1=angle
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Quel est l'angle de la similitude directe composée $val13 et $val15 $val14 ?	</p>	<div class="wimscenter"><label for="reply1">angle de similitude =</label> 
!read oef/embed.phtml reply1,4 
$()
!insmath \pi
$()</div>	
$()
!exit

