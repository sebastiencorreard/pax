!set title=Propriété des similitudes 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000
computeanswer=yes

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 10

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)/2
val6=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)/2
val7=!exec pari print($t_)
tmp0=!randint 0, 10

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)/2
val8=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)/2
val9=!exec pari print($t_)
tmp0=!randint 0, 3

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val10=!exec pari print($t_)
tmp0=!randint 0, 3

tmp1=!randitem 1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val11=!exec pari print($t_)
tmp0=!randint 10, 50

t_=!rawmath $(tmp0)/20
val12=!exec pari print($t_)
t_=!rawmath $val10+$val12*($val6-$val10)
val13=!exec pari print($t_)
t_=!rawmath $val11+$val12*($val7-$val11)
val14=!exec pari print($t_)
t_=!rawmath $val10+$val12*($val8-$val10)
val15=!exec pari print($t_)
t_=!rawmath $val11+$val12*($val9-$val11)
val16=!exec pari print($t_)
t_=!replace internal \( by ( in vecmax([$val6,$val7,$val8,$val9,$val13,$val14,$val15,$val16])+2
tmp0=!exec pari $t_

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in vecmin([$val6,$val7,$val8,$val9,$val13,$val14,$val15,$val16])-2
tmp0=!exec pari $t_

val18=$[rint($(tmp0))]
val19=findhomothetie.ggb
val20=setCoordSystem($val18,$val17,$val18,$val17)	A=($val6,$val7)	B=($val13,$val14)	C=($val8,$val9)	D=($val15,$val16)	setFixed('A',true)	setFixed('B',true)	setFixed('C',true)	setFixed('D',true)	setLabelVisible('A',true)	setLabelVisible('B',true)	setLabelVisible('C',true)	setLabelVisible('D',true)	
val21=$val20	a=Line[A,B]	b=Line[C,D]	O=($val10,$val11)
val22=n,abs(x_O-($val10))<0.3&abs(y_O-($val11))<0.3,O est le centre de l'homothétie
val23='O'
val24=file=$val19	width=500	height=500	showToolBar=true	customToolBar="0|2|3|4|5|19|40|41|42"	enableRightClick=true	
val25=$val24	setLabelVisible('O',true)
replytype1=geogebra

replyoption1=check=$val23 precision=2 output=formal max=50 extra=yes weight=0&0.2&1 
replyname1=centre homothétie
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	 
!read oef/embed.phtml r1, 500x500	$val24	$val20 
$()	</div>	 <div class="medium_size text_col">	On considère l'homothétie 
!insmath h
$() par laquelle les points 
!insmath B
$() et 
!insmath D
$()	 sont les images respectives des points 
!insmath A
$() et 
!insmath C
$().	 <p>	 Construire le point 
!insmath O
$() centre de l'homothétie 
!insmath h
$().	 </p>	 <div class="wims_instruction">	 Utiliser le zoom si les points n'apparaissent pas.	 <br>	 Ne pas oublier de renommer le point créé par un click droit afin qu'il s'appelle 
!insmath O
$().	 </div>	 </div></div>	
