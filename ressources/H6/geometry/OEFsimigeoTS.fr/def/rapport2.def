!set title=Rapport de similitude 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3,4,5,1/2,2/3,3/4,1/4,1/3

tmp1=!randitem 1,-1,-1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val6=!exec pari print($t_)
tmp0=!texmath $val6

val7=$(tmp0)
tmp0=!randitem 2,3,4,5,1/2,2/3,3/4,1/4,1/3

tmp1=!randitem 1,-1,-1,-1

t_=!rawmath $(tmp0)*$(tmp1)
val8=!exec pari print($t_)
tmp0=!texmath $val8

val9=$(tmp0)
tmp0=!randitem 2,3,4,6

val10=$[rint($(tmp0))]
tmp0=!randitem 2,3,4,6

val11=$[rint($(tmp0))]
val12=d'une homothétie de rapport \($val7),abs($val6)	d'une homothétie de rapport \($val9),abs($val8)	d'une rotation d'angle \(\frac{\pi}{$val10}),1	d'une rotation d'angle \(-\frac{\pi}{$val11}),1	d'une symétrie axiale,1	d'une translation,1	
tmp=!translate internal $	$ to ; in $val12

tmp0=!rowcnt $tmp
tmp1=!shuffle $(tmp0)-1

val13=$(tmp1)
tmp=!translate internal $	$ to ; in $val12

tmp=!row $(val13[1])+1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=$(val14[1])
t_=!rawmath $(val14[2])
val16=!exec pari print($t_)
tmp=!translate internal $	$ to ; in $val12

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val17=$(val14[1])
t_=!rawmath $(val14[2])
val18=!exec pari print($t_)
val19=$val15,$val17
tmp0=!randitem 1,2

val20=$[rint($(tmp0))]
t_=!rawmath $val16*$val18
val16=!exec pari print($t_)
val21=
replytype1=numexp
replyname1=rapport
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Quel est le rapport de similitude de la composée $(val19[$val20]) et $val21 $(val19[3-$val20]) ?	</p>	<div class="wimscenter"><label for="reply1">rapport de similitude =</label>  
!read oef/embed.phtml reply1,4 
$()</div>	
