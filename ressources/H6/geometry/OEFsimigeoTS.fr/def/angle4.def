!set title=Angle de similitude directe 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 1/2,1/3,1/4,1/5,1/6,2/5,3/5

val6=$(tmp0)
tmp0=!randitem 1,-1

t_=!rawmath $(val6[1])*$(tmp0)
val7=!exec pari print($t_)
tmp0=!randitem 1,-1

t_=!rawmath $(val6[2])*$(tmp0)
val8=!exec pari print($t_)
tmp0=!texmath $val7*x

val9=$(tmp0)
tmp0=!texmath -$val7*x

val10=$(tmp0)
tmp0=!texmath $val8*x

val11=$(tmp0)
tmp0=!replace internal x by \pi in $val9

val9=$(tmp0)
tmp0=!replace internal x by \pi in $val10

val10=$(tmp0)
tmp0=!replace internal x by \pi in $val11

val11=$(tmp0)
val12=\((\overrightarrow{AB},\overrightarrow{CD})=$val9),\((\overrightarrow{BA},\overrightarrow{DC})=$val9),\((\overrightarrow{CD},\overrightarrow{AB})=$val10),\((\overrightarrow{DC},\overrightarrow{BA})=$val10)
val13=\((\overrightarrow{AC},\overrightarrow{BD})=$val11),\((\overrightarrow{CA},\overrightarrow{DB})=$val11),\((\overrightarrow{AD},\overrightarrow{BC})=$val11),\((\overrightarrow{DA},\overrightarrow{BC})=$val11)
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
!if $val14=1 
tmp=!nonempty items $val12

tmp0=!randitem $tmp
val15=$(tmp0)
tmp=!nonempty items $val13

tmp0=!randitem $tmp
val16=$(tmp0)
!endif
!if $val14=2 
tmp=!nonempty items $val13

tmp0=!randitem $tmp
val15=$(tmp0)
tmp=!nonempty items $val12

tmp0=!randitem $tmp
val16=$(tmp0)
!endif
replytype1=numexp
replyname1=angle
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	On considère 4 points 
!insmath A,B,C
$() et 
!insmath D
$() du plan tels que:	</p>	<div class="wimscenter"> $val15 et $val16</div>	Quel est l'angle de la similitude directe qui envoie 
!insmath A
$() sur 
!insmath C
$() et 
!insmath B
$() sur 
!insmath D
$()?	<div class="wimscenter"><label for="reply1">angle de similitude =</label>  
!read oef/embed.phtml reply1,4 
$()
!insmath \pi
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15,16
embedcnt=1
