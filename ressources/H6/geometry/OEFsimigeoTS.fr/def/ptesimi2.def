val12=la similitude directe de centre 
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val13=$[rint($(tmp1))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]
tmp0=!randint 1, 5

val17=$[rint($(tmp0))]

!ifval $val16=1
val18=$(val14[1])
!else
val18=$(val14[2])
!endif

!ifval $val16=1
val19=$(val15[1])
!else
val19=$(val15[2])
!endif

!ifval $val16=1
