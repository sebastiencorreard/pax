\answer{¾àÀë}{\dist}{type=numeric}
\rational{ortho1=\rep1[1]*\ux+\rep1[2]*\uy+\rep1[3]*\uz}
\rational{ortho2=\rep1[1]*\vx+\rep1[2]*\vy+\rep1[3]*\vz}

