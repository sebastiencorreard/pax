\language{cn}
\author{Regine, Mangeard}
\email{regine@mangeard.fr}
\format{html}
\precision{1000}
\matrix{V=slib(matrix/invertible 3,3)}
\matrix{u=\V[1;]}
\matrix{v=\V[2;]}
\matrix{w=\V[3;]}
\integer{ux=\V[1;1]}
\integer{uy=\V[1;2]}
\integer{uz=\V[1;3]}
\integer{vx=\V[2;1]}
\integer{vy=\V[2;2]}
\integer{vz=\V[2;3]}
\integer{wx=\V[3;1]}
\integer{wy=\V[3;2]}
\integer{wz=\V[3;3]}
\integer{xa=randint(-9..9)}
\integer{ya=randint(-9..9)}
\integer{za=randint(-9..9)}
\integer{xb=\xa+\wx}
\integer{yb=\ya+\wy}
\integer{zb=\za+\wz}

//// Equation paramétrique de D1
\text{eqx1=x=simplify(\ux*t+(\xa))}
\text{eqy1=y=simplify(\uy*t+(\ya))}
\text{eqz1=z=simplify(\uz*t+(\za))}
//// Equation paramétrique de D2
\text{eqx2=x=simplify(\vx*t+(\xb))}
\text{eqy2=y=simplify(\vy*t+(\yb))}
\text{eqz2=z=simplify(\vz*t+(\zb))}

//// vecteur orthogonal à u et v
\integer{nx=\uy*(\vz) - (\uz)*(\vy)}
\integer{ny=\uz*(\vx) - (\ux)*(\vz)}
\integer{nz=\ux*(\vy) - (\uy)*(\vx)}

//// Plan (D1,n)
//// vecteur normal à P1
\integer{n1x=(\uy)*(\nz) - (\uz)*(\ny)}
\integer{n1y=(\uz)*(\nx) - (\ux)*(\nz)}
\integer{n1z=(\ux)*(\ny) - (\uy)*(\nx)}
\integer{d1=(\n1x)*(\xa)+(\n1y)*(\ya)+(\n1z)*(\za)}
\text{eqpl1=simplify((\n1x)*x+(\n1y)*y+(\n1z)*z -(\d1))=0}

//// intersection Plan (D1,n) et D2
\rational{t2=((\d1) - (\n1x)*(\xb)-(\n1y)*(\yb)-(\n1z)*(\zb))/((\n1x)*(\vx)+(\n1y)*(\vy)+(\n1z)*(\vz))}
\rational{hx=(\vx)*(\t2)+(\xb)}
\rational{hy=\vy*(\t2)+(\yb)}
\rational{hz=\vz*(\t2)+(\zb)}
\matrix{cH=\hx,\hy,\hz}

//// Plan (D2,n)
//// vecteur normal à P2
\integer{n2x=\ny*(\vz) - (\nz)*(\vy)}
\integer{n2y=\nz*(\vx) - (\nx)*(\vz)}
\integer{n2z=\nx*(\vy) - (\ny)*(\vx)}
\integer{d2=\n2x*(\xb)+(\n2y)*(\yb)+(\n2z)*(\zb)}
\text{eqpl2=simplify((\n2x)*x+(\n2y)*y+(\n2z)*z -(\d2))=0}

//// intersection Plan (D2,n) et D1
\rational{t1=(\d2 - (\n2x)*(\xa)-(\n2y)*(\ya)-(\n2z)*(\za))/((\n2x)*(\ux)+(\n2y)*(\uy)+(\n2z)*(\uz))}
\rational{kx=\ux*(\t1)+(\xa)}
\rational{ky=\uy*(\t1)+(\ya)}
\rational{kz=\uz*(\t1)+(\za)}
\matrix{cK=\kx,\ky,\kz}

////distance HK
\real{dist=pari(sqrt((\kx-(\hx))^2+(\ky-(\hy))^2+(\kz-(\hz))^2))}

\statement{
¿¼ÂÇ¿Õ¼äÄÚÓÉ²ÎÊı·½³Ì¶¨ÒåµÄÁ½ÌõÖ±Ïß \(D_1) ºÍ \(D_2):
