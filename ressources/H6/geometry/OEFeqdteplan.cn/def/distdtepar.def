!set title=平行直线的距离
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=Regine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[1;1]))]
val14=$[rint($(val6[1;2]))]
val15=$[rint($(val6[1;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
val22=$[rint($val19+$val16)]
val23=$[rint($val20+$val17)]
val24=$[rint($val21+$val18)]
tmp=!translate ";': to $     $ in $val10*t+($val19)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=x=$(tmp0)
tmp=!translate ";': to $     $ in $val11*t+($val20)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=y=$(tmp0)
tmp=!translate ";': to $     $ in $val12*t+($val21)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=z=$(tmp0)
tmp=!translate ";': to $     $ in $val13*t+($val22)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28=x=$(tmp0)
tmp=!translate ";': to $     $ in $val14*t+($val23)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val29=y=$(tmp0)
tmp=!translate ";': to $     $ in $val15*t+($val24)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val30=z=$(tmp0)
val31=$[rint($val10*($val19)+($val11)*($val20)+($val12)*($val21))]
tmp=!translate ";': to $     $ in ($val10)*x+($val11)*y+($val12)*z -($val31)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val32=$(tmp0)=0
t_=!rawmath ($val31 - ($val10)*($val22)-($val11)*($val23)-($val12)*($val24))/($val10*($val13)+($val11)*($val14)+($val12)*($val15))
val33=!exec pari print($t_)
t_=!rawmath $val13*($val33)+($val22)
val34=!exec pari print($t_)
t_=!rawmath $val14*($val33)+($val23)
val35=!exec pari print($t_)
t_=!rawmath $val15*($val33)+($val24)
val36=!exec pari print($t_)
tmp=!trim $val34,$val35,$val36
val37=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in sqrt(($val19-($val34))^2+($val20-($val35))^2+($val21-($val36))^2)
tmp0=!exec pari $t_

val38=$[$(tmp0)]
replytype1=equation
replyname1=\(P_1) 的方程
replygood1=!rawmath $val32
replytype2=vector
replyname2=\(H) 的坐标
replygood2=$val37
replytype3=numeric
replyname3=距离
replygood3=$[$val38]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	已知由参数方程定义的两条空间直线 
!insmath D_1
$() 与 
!insmath D_2
$():	<center>	<table>	<tr><td>
!insmath D1
$():</td><td>
!insmath $val25
$()</td><td>
!insmath $val26
$()</td><td>
!insmath $val27
$()</td></tr>	<tr><td>
!insmath D2
$():</td><td>
!insmath $val28
$()</td><td>
!insmath $val29
$()</td><td>
!insmath $val30
$()</td></tr>	</table>	</center>	要求计算这两条直线的距离.	<ol>	<li> 确定通过直线 
!insmath D_1
$() 上的点 
!insmath A($val19,$val20,$val21)
$() 且与 
!insmath D_1
$() 	垂直的平面 
!insmath P_1
$() 的一般方程:	<center>
!insmath P_1
$() 的方程: 
!read oef/embed.phtml reply1 
$()</center>	</li>	<li>确定 
!insmath P_1
$() 和 
!insmath D_2
$() 的交点 
!insmath H
$() 的坐标:	<center> 
!insmath H
$()= 
!read oef/embed.phtml reply2 
$()</center>	</li>	<li>因此欲求的距离就是距离 
!insmath AH
$():	<center> 
!insmath AH
$()= 
!read oef/embed.phtml reply3 
$()</center>	</li>	</ol>	
$()
!exit

