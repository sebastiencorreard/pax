!set title=异面直线的距离
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
author=Regine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r,r,r,r
varcnt=52
prevarcnt=49
postvarcnt=2
replycnt=6
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
val22=$[rint($val19+$val16)]
val23=$[rint($val20+$val17)]
val24=$[rint($val21+$val18)]
tmp=!translate ";': to $     $ in $val10*t+($val19)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=x=$(tmp0)
tmp=!translate ";': to $     $ in $val11*t+($val20)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=y=$(tmp0)
tmp=!translate ";': to $     $ in $val12*t+($val21)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=z=$(tmp0)
tmp=!translate ";': to $     $ in $val13*t+($val22)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val28=x=$(tmp0)
tmp=!translate ";': to $     $ in $val14*t+($val23)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val29=y=$(tmp0)
tmp=!translate ";': to $     $ in $val15*t+($val24)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val30=z=$(tmp0)
val31=$[rint($val11*($val15) - ($val12)*($val14))]
val32=$[rint($val12*($val13) - ($val10)*($val15))]
val33=$[rint($val10*($val14) - ($val11)*($val13))]
val34=$[rint(($val11)*($val33) - ($val12)*($val32))]
val35=$[rint(($val12)*($val31) - ($val10)*($val33))]
val36=$[rint(($val10)*($val32) - ($val11)*($val31))]
val37=$[rint(($val34)*($val19)+($val35)*($val20)+($val36)*($val21))]
tmp=!translate ";': to $     $ in ($val34)*x+($val35)*y+($val36)*z -($val37)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val38=$(tmp0)=0
t_=!rawmath (($val37) - ($val34)*($val22)-($val35)*($val23)-($val36)*($val24))/(($val34)*($val13)+($val35)*($val14)+($val36)*($val15))
val39=!exec pari print($t_)
t_=!rawmath ($val13)*($val39)+($val22)
val40=!exec pari print($t_)
t_=!rawmath $val14*($val39)+($val23)
val41=!exec pari print($t_)
t_=!rawmath $val15*($val39)+($val24)
val42=!exec pari print($t_)
tmp=!trim $val40,$val41,$val42
val43=!translate internal $	\
$ to ;; in $tmp
val44=$[rint($val32*($val15) - ($val33)*($val14))]
val45=$[rint($val33*($val13) - ($val31)*($val15))]
val46=$[rint($val31*($val14) - ($val32)*($val13))]
val47=$[rint($val44*($val22)+($val45)*($val23)+($val46)*($val24))]
tmp=!translate ";': to $     $ in ($val44)*x+($val45)*y+($val46)*z -($val47)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val48=$(tmp0)=0
t_=!rawmath ($val47 - ($val44)*($val19)-($val45)*($val20)-($val46)*($val21))/(($val44)*($val10)+($val45)*($val11)+($val46)*($val12))
val49=!exec pari print($t_)
t_=!rawmath $val10*($val49)+($val19)
val50=!exec pari print($t_)
t_=!rawmath $val11*($val49)+($val20)
val51=!exec pari print($t_)
t_=!rawmath $val12*($val49)+($val21)
val52=!exec pari print($t_)
tmp=!trim $val50,$val51,$val52
val53=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in sqrt(($val50-($val40))^2+($val51-($val41))^2+($val52-($val42))^2)
tmp0=!exec pari $t_

val54=$[$(tmp0)]
replytype1=vector
replyname1=\(\vec{n})
replygood1=?analyze 55
replytype2=equation
replyname2=\(P_1) 的方程
replygood2=!rawmath $val38
replytype3=vector
replyname3=\(H) 的坐标
replygood3=$val43
replytype4=equation
replyname4=\(P_2) 的方程
replygood4=!rawmath $val48
replytype5=vector
replyname5=\(K) 的坐标
replygood5=$val53
replytype6=numeric
replyname6=距离
replygood6=$[$val54]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	考虑空间内由参数方程定义的两条直线 
!insmath D_1
$() 和 
!insmath D_2
$():	<center>	<table>	<tr><td>
!insmath D1
$():</td><td>
!insmath $val25
$()</td><td>
!insmath $val26
$()</td><td>
!insmath $val27
$()</td></tr>	<tr><td>
!insmath D2
$():</td><td>
!insmath $val28
$()</td><td>
!insmath $val29
$()</td><td>
!insmath $val30
$()</td></tr>	</table>	</center>	欲计算这两条直线的距离.	<ol>	<li> 确定与 
!insmath D_1
$() 和 
!insmath D_2
$() 都垂直的方向向量 
!insmath \vec{n}
$():	<center> 
!insmath \vec{n}
$()= 
!read oef/embed.phtml reply1 
$()</center>	</li>	<li> 确定通过 
!insmath D_1
$() 且包含方向直线 
!insmath \vec{n}
$() 的平面 
!insmath P_1
$() 的一般方程:	<center> 
!insmath P_1
$() 的方程: 
!read oef/embed.phtml reply2 
$()</center>	</li>	<li> 确定 
!insmath P_1
$() 和 
!insmath D_2
$() 的交点 
!insmath H
$() 的坐标:	<center> 
!insmath H
$()= 
!read oef/embed.phtml reply3 
$()</center>	</li>		<li> 确定通过 
!insmath D_2
$() 且包含方向直线 
!insmath \vec{n}
$() 的平面 
!insmath P_2
$() 的一般方程:	<center> 
!insmath P_2
$() 的方程: 
!read oef/embed.phtml reply4 
$()</center>	</li>	<li> 确定 
!insmath P_2
$() 和 
!insmath D_1
$() 的交点 
!insmath K
$() 的坐标:	<center> 
!insmath K
$()= 
!read oef/embed.phtml reply5 
$()</center>	</li>	<li> 欲求距离就是距离 
!insmath HK
$():	<center> 
!insmath HK
$()= 
!read oef/embed.phtml reply6 
$()</center>	</li>	</ol>	
$()
