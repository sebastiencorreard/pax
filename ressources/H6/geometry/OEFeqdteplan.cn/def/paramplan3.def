evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val37=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val38=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
