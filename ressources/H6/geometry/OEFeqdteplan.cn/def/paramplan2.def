!set title=平面的参数方程 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=R間ine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val19+$val10*t+$val13*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val20+$val11*t+$val14*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $val21+$val12*t+$val15*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
val25=$[rint($val11*$val15-$val12*$val14)]
val26=$[rint($val12*$val13-$val10*$val15)]
val27=$[rint($val10*$val14-$val11*$val13)]
val28=$[rint($val19*$val25+$val20*$val26+$val21*$val27)]
tmp0=!texmath $val25*x+$val26*y+$val27*z-$val28=0

val29=$(tmp0)
val30=
tmp0=!texmath $val22

val31=$(tmp0)
tmp0=!texmath $val23

val32=$(tmp0)
tmp0=!texmath $val24

val33=$(tmp0)
replytype1=equation
replyname1=一般方程
replygood1=!rawmath $val29
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	考虑由变量 
!insmath t
$() 和 
!insmath s
$() 的参数方程组定义的平面 
!insmath (P)
$():	<center>	x=
!insmath $val31
$()<br>	y=
!insmath $val32
$()<br>	z=
!insmath $val33
$()<br>	</center>	给出平面 
!insmath (P)
$() 的一般方程.	<p>	 
!read oef/embed.phtml reply1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

