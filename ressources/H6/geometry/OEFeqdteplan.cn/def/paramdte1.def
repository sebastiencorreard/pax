!set title=直线的参数方程 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=R間ine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=55
prevarcnt=33
postvarcnt=21
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
val22=$val19+$val10*t
val23=$val20+$val11*t
val24=$val21+$val12*t
tmp=!translate ";': to $     $ in $val22

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
tmp=!translate ";': to $     $ in $val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
tmp=!translate ";': to $     $ in $val24

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=$(tmp0)
val28=$[rint($val11*$val15-$val12*$val14)]
val29=$[rint($val12*$val13-$val10*$val15)]
val30=$[rint($val10*$val14-$val11*$val13)]
val31=$[rint($val19*$val28+$val20*$val29+$val21*$val30)]
tmp=!translate ";': to $     $ in $val28*x+$val29*y+$val30*z-$val31

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val32=$(tmp1)
val33=$[rint($val11*$val18-$val12*$val17)]
val34=$[rint($val12*$val16-$val10*$val18)]
val35=$[rint($val10*$val17-$val11*$val16)]
val36=$[rint($val19*$val33+$val20*$val34+$val21*$val35)]
tmp=!translate ";': to $     $ in $val33*x+$val34*y+$val35*z-$val36

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val37=$(tmp1)
val38=
replyweight1=0 
replyname1=x 的方程
replygood1=?analyze 39
replyweight2=0 
replyname2=y 的方程
replygood2=?analyze 40
replyweight3=0 
replyname3=z 的方程
replygood3=?analyze 41
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	请给出以 
!insmath t
$() 为变量的直线 
!insmath (D)
$() 的参数方程组,	直线 
!insmath (D)
$() 通过点 
!insmath A($val19,$val20,$val21)
$() 而且方向向量是	
!insmath \vec{u}\left(\begin{array}{c}$(val7[1])\\ $(val7[2])\\ $(val7[3])\end{array}\right)
$().	<center>	
!insmath x
$() 的方程, 以 
!insmath t
$() 为变量:x= 
!read oef/embed.phtml reply1 
$()<br>	
!insmath y
$() 的方程, 以 
!insmath t
$() 为变量:y= 
!read oef/embed.phtml reply2 
$()<br>	
!insmath z
$() 的方程, 以 
!insmath t
$() 为变量:z= 
!read oef/embed.phtml reply3 
$()<br>	</center>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
evaltmp=$m_reply1

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val42=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val43=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val44=$[$(tmp0)]
evaltmp=$m_reply1

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val45=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val46=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val47=$[$(tmp0)]
val48=$[($val45-$val42)*$val11 - ($val46 - $val43)*$val10]
val49=$[($val46-$val43)*$val12 - ($val47 - $val44)*$val11]
val50=$[($val47-$val44)*$val10 - ($val45 - $val42)*$val12]
val51=$[($val45-$val19)*$val11 - ($val46 - $val20)*$val10]
val52=$[($val46-$val20)*$val12 - ($val47 - $val21)*$val11]
val53=$[($val47-$val21)*$val10 - ($val45 - $val19)*$val12]

!ifval $val42=$val19 and $val43=$val20 and $val44=$val21
val54=$[rint(1)]
!else
val54=$[rint(0)]
!endif

!ifval $val48=0 and $val49=0 and $val50=0
val55=$[rint(1)]
!else
val55=$[rint(0)]
!endif

!ifval $val51=0 and $val52=0 and $val53=0
val56=$[rint(1)]
!else
val56=$[rint(0)]
!endif

!ifval $val55=1 and $val56=1
val57=$[rint(1)]
!else
val57=$[rint(0)]
!endif

!ifval $val57=1
val58=绿色
!else
val58=红色
!endif

!ifval $val57=1
val38=是对的</font>
!else
val38=不对</font><br>	这里是一个可能的解:<center> \(x=$val25) <br> \(y=$val26) <br> \(z=$val27) </center>
!endif

!ifval $val54=0 and $val57=1
val38= $val38 尽管这不是我所期待的, 实际上有许多可能的解,<br>	例如 <br>	<center> \(x=$val25) <br> \(y=$val26) <br> \(z=$val27) </center>
!endif

!ifval $val55=0
val38= $val38, 向量 u 不是由这些方程所定义的直线的方向向量
!endif

!ifval $val56=0
val38= $val38, 点 A 不属于由这些方程所定义的直线
!endif

!exit

:feedback
!ifval 1=1
 <p><font color=$val58>你的解$val38
$()
!endif

!exit

:test
condweight1=100000 
condoption1=hide 

!ifval $val57=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=7,10,11,12,19,20,21,25,26,27,38,39,40,41
embedcnt=3
