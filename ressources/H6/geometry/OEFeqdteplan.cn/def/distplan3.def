!set title=平行平面间的距离
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=R間ine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r
varcnt=44
prevarcnt=43
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val19+$val10*t+$val13*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val20+$val11*t+$val14*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $val21+$val12*t+$val15*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
val25=$[rint($val11*($val15)-($val12)*($val14))]
val26=$[rint(($val12)*($val13)-($val10)*($val15))]
val27=$[rint(($val10)*($val14)-($val11)*($val13))]
val28=$[rint(($val19)*($val25)+($val20)*($val26)+($val21)*($val27))]
tmp=!translate ";': to $     $ in $val25*x+$val26*y+$val27*z-$val28

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val29=$(tmp1)
tmp0=!randint 5, 20

tmp1=!randitem 1,-1

val30=$[rint($val28+$(tmp0)*$(tmp1))]
tmp=!translate ";': to $     $ in $val25*x+$val26*y+$val27*z-$val30

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val31=$(tmp1)
val32=
tmp0=!texmath $val22

val33=$(tmp0)
tmp0=!texmath $val23

val34=$(tmp0)
tmp0=!texmath $val24

val35=$(tmp0)
tmp0=!randint -9, 9

val36=$[rint($(tmp0))]
tmp0=!randint -9, 9

val37=$[rint($(tmp0))]
tmp0=!randint -9, 9

val38=$[rint($(tmp0))]
!if $val25=0 
!if $val26=0 
val36=$[rint(0)]
val37=$[rint(0)]
t_=!rawmath $val30 / ($val27)
val38=!exec pari print($t_)
!else
val36=$[rint(0)]
val38=$[rint(0)]
t_=!rawmath $val30 / ($val26)
val37=!exec pari print($t_)
!endif
!else
val37=$[rint(0)]
val38=$[rint(0)]
t_=!rawmath $val30 / ($val25)
val36=!exec pari print($t_)
!endif
t_=!replace internal \( by ( in abs($val25*($val36) + ($val26)*($val37) + ($val27)*($val38) -($val28)) /sqrt(($val25)^2+($val26)^2+($val27)^2)
tmp0=!exec pari $t_

val39=$[$(tmp0)]
replytype1=numeric
replyname1=距离
replygood1=$[$val39]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	考虑由以下一般方程定义的平面 
!insmath (P)
$():</p>	<center>	
!insmath  $val29
$().	</center>	以及由以下一般方程定义的平行平面 
!insmath (Q)
$():	<center>	
!insmath  $val31
$().	</center>	计算平面 
!insmath (P)
$() 到平面 
!insmath (Q)
$() 的距离	<br>	<center>距离= 
!read oef/embed.phtml reply1,7 
$()</center>	
$()
!exit

:hint
$()设有 
!insmath (P)
$() 的点 
!insmath A
$(). 
!insmath A
$() 到 
!insmath (Q)
$() 的距离与 
!insmath A
$() 的选取无关.
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=29,31
embedcnt=1
