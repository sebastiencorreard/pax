!set title=Représentation paramétrique de droite 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=58
prevarcnt=36
postvarcnt=21
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
val22=$val19+$val10*t
val23=$val20+$val11*t
val24=$val21+$val12*t
tmp=!translate ";': to $     $ in $val22

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=$(tmp0)
tmp=!translate ";': to $     $ in $val23

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=$(tmp0)
tmp=!translate ";': to $     $ in $val24

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=$(tmp0)
tmp0=!texmath $val25

val28=$(tmp0)
tmp0=!texmath $val26

val29=$(tmp0)
tmp0=!texmath $val27

val30=$(tmp0)
val31=$[rint($val11*$val15-$val12*$val14)]
val32=$[rint($val12*$val13-$val10*$val15)]
val33=$[rint($val10*$val14-$val11*$val13)]
val34=$[rint($val19*$val31+$val20*$val32+$val21*$val33)]
tmp=!translate ";': to $     $ in $val31*x+$val32*y+$val33*z-$val34

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val35=$(tmp1)
val36=$[rint($val11*$val18-$val12*$val17)]
val37=$[rint($val12*$val16-$val10*$val18)]
val38=$[rint($val10*$val17-$val11*$val16)]
val39=$[rint($val19*$val36+$val20*$val37+$val21*$val38)]
tmp=!translate ";': to $     $ in $val36*x+$val37*y+$val38*z-$val39

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=!texmath $(tmp0)=0

val40=$(tmp1)
val41=
replyweight1=0 
replyname1=Équation en x
replygood1=?analyze 42
replyweight2=0 
replyname2=Équation en y
replygood2=?analyze 43
replyweight3=0 
replyname3=Équation en z
replygood3=?analyze 44
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donner une représentation paramétrique de variable 
!insmath t
$() de la droite 
!insmath (D)
$(),	passant par le point 
!insmath A($val19,$val20,$val21)
$() et de vecteur directeur 
!insmath \vec{u}\left(\begin{array}{c}$(val7[1])\\ $(val7[2])\\ $(val7[3])\end{array}\right)
$().	<ul><li>	Expression de 
!insmath x
$() en fonction de 
!insmath t
$() : 
!insmath x
$() =  
!read oef/embed.phtml reply1 
$()	</li><li>	Expression de 
!insmath y
$() en fonction de 
!insmath t
$() : 
!insmath y
$() =  
!read oef/embed.phtml reply2 
$()	</li><li>	Expression de 
!insmath z
$() en fonction de 
!insmath t
$() : 
!insmath z
$() =  
!read oef/embed.phtml reply3 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
evaltmp=$m_reply1

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val45=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val46=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(0) in $evaltmp
tmp0=($evaltmp)
val47=$[$(tmp0)]
evaltmp=$m_reply1

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val48=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val49=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(1) in $evaltmp
tmp0=($evaltmp)
val50=$[$(tmp0)]
val51=$[($val48-$val45)*$val11 - ($val49 - $val46)*$val10]
val52=$[($val49-$val46)*$val12 - ($val50 - $val47)*$val11]
val53=$[($val50-$val47)*$val10 - ($val48 - $val45)*$val12]
val54=$[($val48-$val19)*$val11 - ($val49 - $val20)*$val10]
val55=$[($val49-$val20)*$val12 - ($val50 - $val21)*$val11]
val56=$[($val50-$val21)*$val10 - ($val48 - $val19)*$val12]

!ifval $val45=$val19 and $val46=$val20 and $val47=$val21
val57=$[rint(1)]
!else
val57=$[rint(0)]
!endif

!ifval $val51=0 and $val52=0 and $val53=0
val58=$[rint(1)]
!else
val58=$[rint(0)]
!endif

!ifval $val54=0 and $val55=0 and $val56=0
val59=$[rint(1)]
!else
val59=$[rint(0)]
!endif

!ifval $val58=1 and $val59=1
val60=$[rint(1)]
!else
val60=$[rint(0)]
!endif

!ifval $val60=1
val61=oef_indgood
!else
val61=oef_indbad
!endif

!ifval $val60=1
val41= est bonne</span>
!else
val41= est mauvaise</span>.<br>	Voici une solution possible:<div class="wimscenter">	\(\left\lbrace	\begin{array}{l}	x=$val28\\ y=$val29\\ z=$val30	\end{array}\)
!endif

!ifval $val57=0 and $val60=1
val41= $val41 même si ce n'est pas celle que j'attendais, il y a en effet plusieurs solutions possibles,<br>	par exemple	<div class="wimscenter">\(\left\lbrace	\begin{array}{l}	x=$val28\\ y=$val29\\ z=$val30	\end{array}\)</div>
!endif

!ifval $val58=0
val41= $val41, le vecteur \(u) n'est pas un vecteur directeur de la droite définie par ces équations
!endif

!ifval $val59=0
val41= $val41, le point \(A) n'appartient à la droite définie par ces équations
!endif

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'><span class="$val61"> Votre solution $val41
$()</div>
!endif

!exit

:test
condweight1=100000 
condoption1=hide 

!ifval $val60=1
 condtest1=1
!else
 condtest1=0
