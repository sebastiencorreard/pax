!set title=Représentation paramétrique de plan 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Régine, Mangeard
email=regine@mangeard.fr
precision=1000

ansorder=r,r,r
varcnt=52
prevarcnt=28
postvarcnt=23
replycnt=3
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val19+$val10*t+$val13*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val22=$(tmp0)
tmp=!translate ";': to $     $ in $val20+$val11*t+$val14*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val23=$(tmp0)
tmp=!translate ";': to $     $ in $val21+$val12*t+$val15*s

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val24=$(tmp0)
val25=$[rint($val11*$val15-$val12*$val14)]
val26=$[rint($val12*$val13-$val10*$val15)]
val27=$[rint($val10*$val14-$val11*$val13)]
val28=$[rint($val19*$val25+$val20*$val26+$val21*$val27)]
tmp0=!texmath $val25*x+$val26*y+$val27*z-$val28=0

val29=$(tmp0)
val30=
tmp0=!texmath $val22

val31=$(tmp0)
tmp0=!texmath $val23

val32=$(tmp0)
tmp0=!texmath $val24

val33=$(tmp0)
replyweight1=0 
replyname1=Équation en x
replygood1=?analyze 34
replyweight2=0 
replyname2=Équation en y
replygood2=?analyze 35
replyweight3=0 
replyname3=Équation en z
replygood3=?analyze 36
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p>	Donner une représentation paramétrique de variables 
!insmath t
$() et 
!insmath s
$() du plan 
!insmath (P)
$(),	définie par l'équation cartésienne:	</p>	<div class="wimscenter">	
!insmath  $val29
$().	</div>	Équation en 
!insmath x
$() ,
!insmath t
$() et 
!insmath s
$() : 
!insmath x
$() =  
!read oef/embed.phtml reply1 
$()<br>	Équation en 
!insmath y
$() ,
!insmath t
$() et 
!insmath s
$() : 
!insmath y
$() =  
!read oef/embed.phtml reply2 
$()<br>	Équation en 
!insmath z
$() ,
!insmath t
$() et 
!insmath s
$() : 
!insmath z
$() =  
!read oef/embed.phtml reply3 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
evaltmp=$m_reply1

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val37=$[$(tmp0)]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val38=$[$(tmp0)]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val39=$[$(tmp0)]
evaltmp=$m_reply1

evaltmp=!mathsubst t=(1) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val40=$[$(tmp0)-$val37]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(1) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val41=$[$(tmp0)-$val38]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(1) in $evaltmp
evaltmp=!mathsubst s=(0) in $evaltmp
tmp0=($evaltmp)
val42=$[$(tmp0)-$val39]
evaltmp=$m_reply1

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(1) in $evaltmp
tmp0=($evaltmp)
val43=$[$(tmp0)-$val37]
evaltmp=$m_reply2

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(1) in $evaltmp
tmp0=($evaltmp)
val44=$[$(tmp0)-$val38]
evaltmp=$m_reply3

evaltmp=!mathsubst t=(0) in $evaltmp
evaltmp=!mathsubst s=(1) in $evaltmp
tmp0=($evaltmp)
val45=$[$(tmp0)-$val39]
val46=$[rint($val40*$val25+$val41*$val26+$val42*$val27)]
val47=$[rint($val43*$val25+$val44*$val26+$val45*$val27)]
val48=$[$val43*$val41 - $val44*$val40]
val49=$[$val44*$val42 - $val45*$val41]
val50=$[$val45*$val40 - $val43*$val42]

!ifval $val48=0 and $val49=0 and $val50=0
val51=$[rint(1)]
!else
val51=$[rint(0)]
!endif
val52=$[rint($val37*$val25+$val38*$val26+$val39*$val27-$val28)]

!ifval $val46=0 and $val47=0 and $val51=0 and $val52=0
val53=$[rint(1)]
!else
val53=$[rint(0)]
!endif

!ifval $val53=1
val54=oef_indgood
!else
val54=oef_indbad
!endif

!ifval $val53=1
val30= est bonne</span>
!else
val30= est mauvaise</span><br>
!endif

!ifval $val46=0
val30=$val30
!else
val30= $val30 les coefficients devant \(t) ne définissent pas un vecteur de ce plan,<br>
!endif

!ifval $val47=0
val30=$val30
!else
val30= $val30 les coefficients devant \(s) ne définissent pas un vecteur de ce plan,<br>
!endif

!ifval $val51=0
val30=$val30
!else
val30= $val30, les coefficients devant \(t) et \(s) ne définissent pas deux vecteurs indépendants de ce plan,<br>
!endif

!ifval $val52=0
val30=$val30
!else
val30= $val30, le point obtenu pour \(t=0) et \(s=0) n'appartient pas à \((P)):$val52=$val37*$val25+$val38*$val26+$val39*$val27-$val28
!endif

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'> <span class="$val54">Votre solution $val30
$()</div>
!endif

!exit

:test
condweight1=100000 
condoption1=hide 

!ifval $val53=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=Votre solution

!exit

:stat
vsavelist=25,26,27,28,29,30,34,35,36
embedcnt=3
