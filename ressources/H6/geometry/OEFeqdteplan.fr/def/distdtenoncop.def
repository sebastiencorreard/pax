 !exit
!endif

!readproc slib/matrix/invertible 3,3 
tmp0=$slib_out
tmp=!trim $(tmp0)
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[1;])
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[2;])
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val6[3;])
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint($(val6[1;1]))]
val11=$[rint($(val6[1;2]))]
val12=$[rint($(val6[1;3]))]
val13=$[rint($(val6[2;1]))]
val14=$[rint($(val6[2;2]))]
val15=$[rint($(val6[2;3]))]
val16=$[rint($(val6[3;1]))]
val17=$[rint($(val6[3;2]))]
val18=$[rint($(val6[3;3]))]
tmp0=!randint -9, 9

val19=$[rint($(tmp0))]
tmp0=!randint -9, 9

val20=$[rint($(tmp0))]
tmp0=!randint -9, 9

val21=$[rint($(tmp0))]
val22=$[rint($val19+$val16)]
val23=$[rint($val20+$val17)]
val24=$[rint($val21+$val18)]
tmp=!translate ";': to $     $ in $val10*t+($val19)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val25=x=$(tmp0)
tmp=!translate ";': to $     $ in $val11*t+($val20)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val26=y=$(tmp0)
tmp=!translate ";': to $     $ in $val12*t+($val21)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val27=z=$(tmp0)
tmp0=!texmath $val25

val28=$(tmp0)
tmp0=!texmath $val26

val29=$(tmp0)
tmp0=!texmath $val27

val30=$(tmp0)
tmp=!translate ";': to $     $ in $val13*t+($val22)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val31=x=$(tmp0)
tmp=!translate ";': to $     $ in $val14*t+($val23)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val32=y=$(tmp0)
tmp=!translate ";': to $     $ in $val15*t+($val24)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val33=z=$(tmp0)
tmp0=!texmath $val31

val34=$(tmp0)
tmp0=!texmath $val32

val35=$(tmp0)
tmp0=!texmath $val33

val36=$(tmp0)
val37=$[rint($val11*($val15) - ($val12)*($val14))]
val38=$[rint($val12*($val13) - ($val10)*($val15))]
val39=$[rint($val10*($val14) - ($val11)*($val13))]
val40=$[rint(($val11)*($val39) - ($val12)*($val38))]
val41=$[rint(($val12)*($val37) - ($val10)*($val39))]
val42=$[rint(($val10)*($val38) - ($val11)*($val37))]
val43=$[rint(($val40)*($val19)+($val41)*($val20)+($val42)*($val21))]
tmp=!translate ";': to $     $ in ($val40)*x+($val41)*y+($val42)*z -($val43)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val44=$(tmp0)=0
t_=!rawmath (($val43) - ($val40)*($val22)-($val41)*($val23)-($val42)*($val24))/(($val40)*($val13)+($val41)*($val14)+($val42)*($val15))
val45=!exec pari print($t_)
t_=!rawmath ($val13)*($val45)+($val22)
val46=!exec pari print($t_)
t_=!rawmath $val14*($val45)+($val23)
val47=!exec pari print($t_)
t_=!rawmath $val15*($val45)+($val24)
val48=!exec pari print($t_)
tmp=!trim $val46,$val47,$val48
val49=!translate internal $	\
$ to ;; in $tmp
val50=$[rint($val38*($val15) - ($val39)*($val14))]
val51=$[rint($val39*($val13) - ($val37)*($val15))]
val52=$[rint($val37*($val14) - ($val38)*($val13))]
val53=$[rint($val50*($val22)+($val51)*($val23)+($val52)*($val24))]
tmp=!translate ";': to $     $ in ($val50)*x+($val51)*y+($val52)*z -($val53)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val54=$(tmp0)=0
t_=!rawmath ($val53 - ($val50)*($val19)-($val51)*($val20)-($val52)*($val21))/(($val50)*($val10)+($val51)*($val11)+($val52)*($val12))
val55=!exec pari print($t_)
t_=!rawmath $val10*($val55)+($val19)
val56=!exec pari print($t_)
t_=!rawmath $val11*($val55)+($val20)
val57=!exec pari print($t_)
t_=!rawmath $val12*($val55)+($val21)
val58=!exec pari print($t_)
tmp=!trim $val56,$val57,$val58
val59=!translate internal $	\
$ to ;; in $tmp
t_=!replace internal \( by ( in sqrt(($val56-($val46))^2+($val57-($val47))^2+($val58-($val48))^2)
tmp0=!exec pari $t_

val60=$[$(tmp0)]
replytype1=vector
replyname1=\(\vec{n}\)
replygood1=?analyze 61
replytype2=equation
replyname2=Équation de \(P_1\)
