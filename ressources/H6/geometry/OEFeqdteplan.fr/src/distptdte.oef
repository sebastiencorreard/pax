\title{Distance d'un point à une droite }
\language{fr}
\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\computeanswer{yes}
\format{html}
\precision{100}
\integer{dim=3}


\integer{range=40}
\integer{range2=10}

\text{sh=shuffle(\range)}
\integer{x1=\sh[1]*random(1,-1)}
\integer{y1=\sh[2]*random(1,-1)}
\integer{z1=\sh[3]*random(1,-1)}
\text{sh2=shuffle(\range2)}
\integer{xv=\sh2[1]*random(1,-1)}
\integer{yv=\sh2[2]*random(1,-1)}
\integer{zv=random(1,2,5)*random(1,-1)}
\integer{x2=\x1+\xv}
\integer{y2=\y1+\yv}
\integer{z2=\z1+\zv}

## détermination de H à coordonnées décimales
\integer{t=random(2,3,1/2,3/2,1/4,3/4)*randint(1,-1)}
\real{xi=\x1+\t*\xv}
\real{yi=\y1+\t*\yv}
\real{zi=\z1+\t*\zv}

## détermination du plan perpendiculaire à (AB) passant par H
\real{di=\xv*\xi + \yv*\yi + \zv*\zi}
\text{eqplan=\xv*x + \yv*y + \zv*z - \di=0}

## choix d'un point dans ce plan

\integer{x0=randint(-\range2..\range2)}
\integer{y0=randint(-\range2..\range2)}
\real{z0=(\di - \xv*\x0 - \yv*\y0)/ (\zv)}
\integer{d0=\xv*(\x0) + \yv*(\y0) + \zv*(\z0)}

\matrix{vecH=\xi,\yi,\zi}

\real{dist=pari(sqrt\((\x0-(\xi))^2+(\y0-(\yi))^2+(\z0-(\zi))^2))}

\steps{r1
r2
r3}

\statement{Dans \(RR^\dim),
On cherche à calculer la distance entre le point
<span style="color:red">\(P(\x0 , \y0 , \z0)) </span> et la droite
 déterminée par les points
 <div class="wimscenter">
 <span style="color:blue">\(A(\x1 , \y1 , \z1))</span> et <span style="color:blue">\(B(\x2 , \y2 , \z2))</span>.
 </div>
\if{\step=1}
{
Pour cela, déterminer l'équation du plan \((Q)) perpendiculaire à la droite \((A B)\) et passant par le point \(P\).
<div class="wimscenter">\embed{reply1}</div>
}
{
Le plan \((Q)\) perpendiculaire à \((A B)\) et passant par \(P\) a pour équation:
<div class="wimscenter"><span class="oef_indgood">\reply1 </span></div>
}
\if{\step=2}
{
Déterminer les coordonnées du point \(H) intersection de \((Q)) et de \((A B)):
<div class="wimscenter"> coordonnées de \(H\) : \embed{reply2,7} </div>
}
\if{\step=3}
{
Les coordonnées du point \(H) intersection de \((Q)) et de \((A B)) sont :
<div class="wimscenter"><span class="oef_indgood">(\reply2)</span></div>
En déduire la distance de \(P) à \((A B)):
<div class="wimscenter">distance = \embed{reply3} </div>
}
}
\answer{Equation du plan \((Q))}{\eqplan}{type=equation}
\answer{Point d'intersection}{\vecH}{type=vector}
\answer{distance}{\dist}
