\title{Représentation paramétrique de droite 1}

\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}
\precision{1000}
\matrix{V=slib(matrix/invertible 3,3)}
\matrix{u=\V[1;]}
\matrix{v=\V[2;]}
\matrix{w=\V[3;]}
\integer{ux=\V[1;1]}
\integer{uy=\V[1;2]}
\integer{uz=\V[1;3]}
\integer{vx=\V[2;1]}
\integer{vy=\V[2;2]}
\integer{vz=\V[2;3]}
\integer{wx=\V[3;1]}
\integer{wy=\V[3;2]}
\integer{wz=\V[3;3]}
\integer{xa=randint(-9..9)}
\integer{ya=randint(-9..9)}
\integer{za=randint(-9..9)}
%%%% equation paramétrique de D(A,u)
\text{eqx=\xa+\ux*t}
\text{eqy=\ya+\uy*t}
\text{eqz=\za+\uz*t}
\text{eqxx=simplify(\eqx)}
\text{eqyy=simplify(\eqy)}
\text{eqzz=simplify(\eqz)}
\text{eqxxtex=texmath(\eqxx)}
\text{eqyytex=texmath(\eqyy)}
\text{eqzztex=texmath(\eqzz)}
%%%% equation du plan (A,u,v)
\integer{nx=\uy*\vz-\uz*\vy}
\integer{ny=\uz*\vx-\ux*\vz}
\integer{nz=\ux*\vy-\uy*\vx}
\integer{d1=\xa*\nx+\ya*\ny+\za*\nz}
\text{eqpl1=texmath(simplify(\nx*x+\ny*y+\nz*z-\d1)=0)}
%%%% equation du plan (A,u,w)
\integer{mx=\uy*\wz-\uz*\wy}
\integer{my=\uz*\wx-\ux*\wz}
\integer{mz=\ux*\wy-\uy*\wx}
\integer{d2=\xa*\mx+\ya*\my+\za*\mz}
\text{eqpl2=texmath(simplify(\mx*x+\my*y+\mz*z-\d2)=0)}
\text{txtsol=}

\statement{
Donner une représentation paramétrique de variable \(t) de la droite \((D)),
passant par le point \(A(\xa,\ya,\za)) et de vecteur directeur \(\vec{u}\left(\begin{array}{c}\u[1]\\ \u[2]\\ \u[3]\end{array}\right)).
<ul><li>
Expression de \(x) en fonction de \(t) : \(x\) = \embed{reply1}
</li><li>
Expression de \(y) en fonction de \(t) : \(y\) = \embed{reply2}
</li><li>
Expression de \(z) en fonction de \(t) : \(z\) = \embed{reply3}
</li></ul>
}

\answer{Équation en x}{\eqx2}{weight=0}
\answer{Équation en y}{\eqy2}{weight=0}
\answer{Équation en z}{\eqz2}{weight=0}
\real{vxa=evaluate(\reply1,t,t=0)}
\real{vya=evaluate(\reply2,t,t=0)}
\real{vza=evaluate(\reply3,t,t=0)}
\real{vxb=evaluate(\reply1,t,t=1)}
\real{vyb=evaluate(\reply2,t,t=1)}
\real{vzb=evaluate(\reply3,t,t=1)}
\real{colin1=(\vxb-\vxa)*\uy - (\vyb - \vya)*\ux}
\real{colin2=(\vyb-\vya)*\uz - (\vzb - \vza)*\uy}
\real{colin3=(\vzb-\vza)*\ux - (\vxb - \vxa)*\uz}
\real{colinb1=(\vxb-\xa)*\uy - (\vyb - \ya)*\ux}
\real{colinb2=(\vyb-\ya)*\uz - (\vzb - \za)*\uy}
\real{colinb3=(\vzb-\za)*\ux - (\vxb - \xa)*\uz}
\integer{condannexe=\vxa=\xa and \vya=\ya and \vza=\za?1:0}
\integer{macond1=\colin1=0 and \colin2=0 and \colin3=0?1:0}
\integer{macond2=\colinb1=0 and \colinb2=0 and \colinb3=0?1:0}
\integer{macondition=\macond1=1 and \macond2=1?1:0}
\text{col=\macondition=1?oef_indgood:oef_indbad}
\text{txtsol=\macondition=1? est bonne</span>: est mauvaise</span>.<br>
Voici une solution possible:<div class="wimscenter">
\(\left\lbrace
\begin{array}{l}
x=\eqxxtex\\ y=\eqyytex\\ z=\eqzztex
\end{array}\)}
\text{txtsol=\condannexe=0 and \macondition=1? \txtsol même si ce n'est pas celle que j'attendais, il y a en effet plusieurs solutions possibles,<br>
par exemple
<div class="wimscenter">\(\left\lbrace
\begin{array}{l}
x=\eqxxtex\\ y=\eqyytex\\ z=\eqzztex
\end{array}\)</div>}

\text{txtsol=\macond1=0? \txtsol, le vecteur \(u) n'est pas un vecteur directeur de la droite définie par ces équations}
\text{txtsol=\macond2=0? \txtsol, le point \(A) n'appartient à la droite définie par ces équations}

\condition{\macondition=1}{weight=100000}{option=hide}
