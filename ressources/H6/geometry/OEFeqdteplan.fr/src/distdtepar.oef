\title{Distance entre droites parallèles}

\author{Régine, Mangeard}
\email{regine@mangeard.fr}
\format{html}
\precision{1000}
\matrix{V=slib(matrix/invertible 3,3)}
\matrix{u=\V[1;]}
\matrix{v=\V[2;]}
\matrix{w=\V[3;]}
\integer{ux=\V[1;1]}
\integer{uy=\V[1;2]}
\integer{uz=\V[1;3]}
\integer{vx=\V[1;1]}
\integer{vy=\V[1;2]}
\integer{vz=\V[1;3]}
\integer{wx=\V[3;1]}
\integer{wy=\V[3;2]}
\integer{wz=\V[3;3]}
\integer{xa=randint(-9..9)}
\integer{ya=randint(-9..9)}
\integer{za=randint(-9..9)}
\integer{xb=\xa+\wx}
\integer{yb=\ya+\wy}
\integer{zb=\za+\wz}

## Equation paramétrique de D1
\text{eqx1=x=simplify(\ux*t+(\xa))}
\text{eqy1=y=simplify(\uy*t+(\ya))}
\text{eqz1=z=simplify(\uz*t+(\za))}
\text{eqx1tex=texmath(\eqx1)}
\text{eqy1tex=texmath(\eqy1)}
\text{eqz1tex=texmath(\eqz1)}
## Equation paramétrique de D2
\text{eqx2=x=simplify(\vx*t+(\xb))}
\text{eqy2=y=simplify(\vy*t+(\yb))}
\text{eqz2=z=simplify(\vz*t+(\zb))}
\text{eqx2tex=texmath(\eqx2)}
\text{eqy2tex=texmath(\eqy2)}
\text{eqz2tex=texmath(\eqz2)}
## Plan orthogonal à D1 passant par A
## vecteur normal à P1
\integer{d1=\ux*(\xa)+(\uy)*(\ya)+(\uz)*(\za)}
\text{eqpl1=simplify((\ux)*x+(\uy)*y+(\uz)*z -(\d1))=0}

## intersection Plan  et D2
\rational{t2=(\d1 - (\ux)*(\xb)-(\uy)*(\yb)-(\uz)*(\zb))/(\ux*(\vx)+(\uy)*(\vy)+(\uz)*(\vz))}
\rational{hx=\vx*(\t2)+(\xb)}
\rational{hy=\vy*(\t2)+(\yb)}
\rational{hz=\vz*(\t2)+(\zb)}
\matrix{cH=\hx,\hy,\hz}


##distance AH
\real{dist=pari(sqrt((\xa-(\hx))^2+(\ya-(\hy))^2+(\za-(\hz))^2))}

\statement{
On considère deux droites \(D_1\) et \(D_2\) de l'espace définies par des
équations paramétriques
<div class="wimscenter">
\(D1\) :
\(\left \lbrace
\begin{array}{l}
\eqx1tex\\
\eqy1tex\\
\eqz1tex
\end{array} \)

&nbsp;&nbsp;

\(D2\) :
\(\left \lbrace
\begin{array}{l}
\eqx2tex\\
\eqy2tex\\
\eqz2tex
\end{array} \)
</div>
On veut calculer la distance entre ces deux droites.
<ol>
<li> Déterminer l'équation cartésienne du plan \(P_1\) perpendiculaire
 à \(D_1\) et passant par le point \(A(\xa,\ya,\za)\) de \(D_1\) :
<div class="wimscenter"> Équation de \(P_1\) : \embed{reply1}</div>
</li><li>
Déterminer les coordonnées du point \(H\) intersection de \(P_1\) et \(D_2\) :
<div class="wimscenter"> \(H\) = \embed{reply2}</div>
</li><li>
La distance cherchée est donc la distance \(A H\) :
<div class="wimscenter"> \(A H\)=\embed{reply3}</div>
</li></ol>
}
\answer{Équation de \(P_1\)}{\eqpl1}{type=equation}
\answer{Coordonnées de \(H\)}{\cH}{type=vector}
\answer{distance}{\dist}{type=numeric}
