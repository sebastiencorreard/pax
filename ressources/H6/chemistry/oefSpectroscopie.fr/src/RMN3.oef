\title{Spectroscopie RMN -nom molecule(1)}
\author{Benoit Markey}
\email{benoit.markey@ac-lille.fr}
\integer{taille=600}


\matrix{fonc=wims(record 1 of RMN-liste2)}
\matrix{fonc11=shuffle(\fonc)}
-------------spectre 1-------------------------------------------------------
\matrix{fonc2=\fonc11[1]}
\matrix{molecule11=wims(record 1 of \fonc2[1])}
\integer{tri=rows(\molecule11)}
\matrix{tri2=shuffle(\tri)}
\text{molecule1=row(\tri2[1],\molecule11)}
\matrix{sp1=wims(record 1 of \molecule1[1])}
\integer{nb=rows(\sp1)}
\text{sp2x=column(1,\sp1)}
\text{sp2y=column(2,\sp1)}
\integer{xmax=ceil(\sp2x[1])}
\real{xmax2=\taille/(5*\xmax)}
\text{grad=parallel 0,198,0,202,\xmax2,0,5*\xmax+1,black
text blue,0,205,small,\xmax}

\for{j=1 to \xmax}{
\integer{n=\xmax-\j}
\text{grad=\grad
text blue,\j*\taille/\xmax-1,205,small,\n}
}

\text{sp2x2=\taille}
\text{sp2y2=200-10}
\text{pic=segment \sp2x2,200,\sp2x2,\sp2y2,red}
\for{i=1 to \nb}{
\text{sp2x2=\taille*(1-\sp2x[\i]/\xmax)}
\text{sp2y2=2*(100-\sp2y[\i])}
\text{pic=\pic
segment \sp2x2,200,\sp2x2,\sp2y2,green}
}


-------------spectre 2-------------------------------------------------------

\matrix{fonc2bis=\fonc11[2]}
\matrix{molecule11bis=wims(record 1 of \fonc2bis[1])}
\integer{tribis=rows(\molecule11bis)}
\matrix{tri2bis=shuffle(\tribis)}
\text{moleculebis=row(\tri2bis[1],\molecule11bis)}
\matrix{sp1bis=wims(record 1 of \moleculebis[1])}
\integer{nbbis=rows(\sp1bis)}
\text{sp2xbis=column(1,\sp1bis)}
\text{sp2ybis=column(2,\sp1bis)}
\integer{xmaxbis=ceil(\sp2xbis[1])}
\real{xmax2bis=\taille/(5*\xmaxbis)}
\text{gradbis=parallel 0,198,0,202,\xmax2bis,0,5*\xmaxbis+1,black
text blue,0,205,small,\xmaxbis}

\for{jbis=1 to \xmaxbis}{
\integer{nbis=\xmaxbis-\jbis}
\text{gradbis=\gradbis
text blue,\jbis*\taille/\xmaxbis-1,205,small,\nbis}
}

\text{sp2x2bis=\taille}
\text{sp2y2bis=200-10}
\text{picbis=segment \sp2x2bis,200,\sp2x2bis,\sp2y2bis,red}

\for{ibis=1 to \nbbis}{
\text{sp2x2bis=\taille*(1-\sp2xbis[\ibis]/\xmaxbis)}
\text{sp2y2bis=2*(100-\sp2ybis[\ibis])}
\text{picbis=\picbis
segment \sp2x2bis,200,\sp2x2bis,\sp2y2bis,green}
}


-------------spectre 3-------------------------------------------------------

\matrix{fonc2ter=\fonc11[3]}
\matrix{molecule11ter=wims(record 1 of \fonc2ter[1])}
\integer{triter=rows(\molecule11ter)}
\matrix{tri2ter=shuffle(\triter)}
\text{moleculeter=row(\tri2ter[1],\molecule11ter)}
\matrix{sp1ter=wims(record 1 of \moleculeter[1])}
\integer{nbter=rows(\sp1ter)}
\text{sp2xter=column(1,\sp1ter)}
\text{sp2yter=column(2,\sp1ter)}
\integer{xmaxter=ceil(\sp2xter[1])}
\real{xmax2ter=\taille/(5*\xmaxter)}
\text{gradter=parallel 0,198,0,202,\xmax2ter,0,5*\xmaxter+1,black
text blue,0,205,small,\xmaxter}

\for{jter=1 to \xmaxter}{
\integer{nter=\xmaxter-\jter}
\text{gradter=\gradter
text blue,\jter*\taille/\xmaxter-1,205,small,\nter}
}

\text{sp2x2ter=\taille}
\text{sp2y2ter=200-10}
\text{picter=segment \sp2x2ter,200,\sp2x2ter,\sp2y2ter,red}
\text{sp2x2ter=\taille*(1-\sp2xter[1]/4000)}
\text{sp3ter=\taille*(1-\sp2xter[1]/4000),2*(100-\sp2yter[1]*\moleculeter[2])}
\for{iter=1 to \nbter}{
\text{sp2x2ter=\taille*(1-\sp2xter[\iter]/\xmaxter)}
\text{sp2y2ter=2*(100-\sp2yter[\iter])}
\text{picter=\picter
segment \sp2x2ter,200,\sp2x2ter,\sp2y2ter,green}
}



\text{axes=arrow 910,200,2,200,10,black
text blue,7,185,small,d (ppm)
text brown,\taille/2,205,small,déplacement chimique
arrow 2,200,2,2,10,black
parallel 0,200,4,200,0,-20,10,black
dhline 0,160,red
dhline 0,120,red
dhline 0,80,red
dhline 0,40,red
dhline 0,0,red
text black,8,160,small,20
text black,8,120,small,40
text black,8,80,small,60
text black,8,40,small,80
text black,8,0,small,100
textup red,20,150,small,Intensité du signal (%)
}
\text{graph2=draw(\taille+10,220
\pic
\axes
\grad
)}

\text{graph2bis=draw(\taille+10,220
\picbis
\axes
\gradbis
)}


\text{graph2ter=draw(\taille+10,220
\picter
\axes
\gradter
)}

\text{graph=<img src="\graph2">}
\text{graphbis=<img src="\graph2bis">}
\text{graphter=<img src="\graph2ter">}
\text{choix1= <img src = "\graph2" >,<img src = "\graph2bis" >,<img src = "\graph2ter" > }
\text{choix=shuffle(\choix1)}
\integer{rep=position(<img src = "\graph2" >,\choix)}

\text{schema=<img src=\imagedir/../\molecule1[4]>}
\comment{
\text{schemabis=<img src=\imagedir/../\moleculebis[4]>}
\text{schemater=<img src=\imagedir/../\moleculeter[4]>}
}

\statement{On s'intéresse à la molécule: <h2>\molecule1[3]</h2>
<br>
Ci dessous, voici 3 spectres de molécules différentes, cliquer sur le spectre correspondant à cette molécule
<div class="wimscenter">
   \embed{ reply1,1}\embed{ reply1,2}\embed{ reply1,3 } </div> 
<br>
En cliquant sur le bouton <b>aide</b>, vous trouverez une table des déplacements chimiques.<br>

}
\answer{ }{ \rep ; \choix }{ type=click } 
