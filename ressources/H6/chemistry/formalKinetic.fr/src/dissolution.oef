\title{4. Dissolution d'un composé chimique}

\language{fr}
\author{Sophie,Lemaire,Céline,Dablemont;Thomas,Pugnat}
\email{sophie.lemaire@universite-paris-scalay.fr,celine.dablemont@universite-paris-saclay.fr}
\decription{exercice comportant 4 questions}
\keywords{chemistry,chemical_kinetics,reaction_rate,integrated_rate_law,rate_law}

\css{<style>
.prompt{color:gray;}
</style>}

// Données

\text{repres = \confparm1 = ? 0 : \confparm1} 0 : arrêt à la 1ère erreur, 1 sinon

\integer{time=randint(1..10)}
\integer{masstime=randint(2..100)}
\integer{mass0=2*\masstime}
\real{alpha =log(2)/\time}
\real{alpha=slib(text/sigunits \alpha,3)}
\text{liste=tiers,quart,cinquième, sixième, septième, huitième}
\text{fract = randitem(\liste)}
\integer{u=2+position(\fract,\liste)}

// Intitulés
\text{name_intro=On étudie la dissolution d'un composé chimique dans l'eau. Pour cela, on place \(m(0) = \mass0\) g du composé dans l'eau
à l'instant initial (0 min).}

\matrix{name_enonc1=La
vitesse de dissolution
de ce composé est proportionelle à la masse du composé à l'instant \(t\) avec pour coefficient de proportionnalité \(a > 0\).}
\text{name_quest1=Donner l'équation différentielle satisfaite par \(m\).}
\text{repq1=-a*m}
\text{name_repq1=\(m'=\repq1[1]\)}

\text{name_enonc2=La masse \(m\) du composé est la solution de l'équation différentielle (E)
 : \(m' = -a m\) sur \(\lbrack 0, +\infty \lbrack\) qui vérifie la condition
initiale décrite dans l'énoncé.}
\text{name_quest2=Donner son expression à l'instant \(t\) en fonction de \(a\) et de \(t\).}
\text{repq2=\mass0 *e^-(a*t),a,t}
\text{repq2tex=texmath(\repq2[1])}
\text{name_repq2=\(m(t)=\repq2tex\) g.}

\matrix{name_enonc3=On observe que le
  temps de demi-réaction
  est \time min.}
\text{name_quest3=En déduire la valeur de \(a\), puis l'expression de la masse du composé en fonction de \(t\) uniquement.}
\text{repq4=\mass0 *e^-(\alpha*t),t}
\text{name_repq4=\(m(t)=\repq4[1]\) g}

\text{name_enonc4=On note \(s\) le temps au bout duquel, il ne restera plus qu'un \fract de la masse initiale.}
\text{name_quest4=Donner sa valeur.}
\real{repq5=ln(\u)/\alpha}
\real{repq5=slib(text/sigunits \repq5,3)}
\text{name_repq5=\(s=\repq5\) min}
\text{name_signif= Donner la valeur de, avec 3 chiffres significatifs.}

\text{condtps= pour tout \(t\geq 0\)}

\text{sol= La masse à l'instant \(t\) est solution de l'équation différentielle (E) : \(m' = -a m.\);
 La fonction \(m\) est solution de l'équation (E) sur \(\lbrack 0, +\infty\lbrack\) si et seulement s'il existe une constante \(C\) telle que
\(m(t) = Ce^{-a t}\) pour tout \(t\geq 0\).
Comme \(m(0) = \mass0\) g, on en déduit que \(m(t) = \mass0 e^{-a t}\) g pour tout \(t \geq 0\).;
 Le temps de demi-réaction est \time min signifie que \(m(\time ) = \mass0 /2\) g. Donc, le coefficient \(a\) vaut \(\ln(2)/\time\simeq \alpha\) et la
masse du composé à l'instant \(t\) est \(m(t) = \mass0 e^{-\alpha t}\) g pour tout \(t\geq 0\).;
 Le temps \(s\) est le temps au bout duquel la masse du composé est \(m(s) = \mass0 /\u\) g. Donc \(s\) vérifie \(e^{-\alpha s} = 1/\u\),
c'est-à-dire \(s = \ln(\u)/\alpha\simeq \repq5\) min.
}

\text{name_rep=<span class="prompt">Votre réponse</span>}
\text{feedgood=<span class="oef_indgood"> Bonne réponse. </span>}
\text{feedbad=<span class="oef_indbad"> Mauvaise réponse</span><span>, la bonne réponse est </span>}
\text{feedpart=<span class="oef_indpartial"> Réponse partielle bonne </span>}

\text{listrep=r1}
\nextstep{\listrep}

\text{presentgood=slib(oef/env presentgood)}
\integer{lpos=4}  \text{listscrep=}

\text{enoncelatex=\name_intro \begin{enumerate}
\item \name_enonc1[1;] \name_enonc1[2;] \name_enonc1[3;]\newline \name_quest1
\item \name_enonc2\newline \name_quest2
\item \name_enonc3[1;]\name_enonc3[2;]\name_enonc3[3;]\newline \name_quest3 (\emph{\small \name_signif[1] \(a\) \name_signif[2]})
\item \name_enonc4\newline \name_quest4 (\emph{\small \name_signif[1] \(s\) \name_signif[2]})
\end{enumerate}
}
\statement{
\name_intro
\if{\step==1}{
     <ol class="spacer"><li>\name_enonc1[1;] \special{help dissol,\name_enonc1[2;]} \name_enonc1[3;] <div class="wims_question">\name_quest1
<div class="wimscenter"><label for="reply1"> \(m'\) = </label> \embed{reply1,10}</div>
</div></li></ol>
}{
<ol class="spacer"><li>\name_enonc1[1;] \special{help dissol,\name_enonc1[2;]} \name_enonc1[3;]<br/> \name_quest1
<div class="wimscenter"> \name_rep : \(m'\) =  \reply1</div>
\if{\presentgood=1}{\if{\sc_reply1=1}{\feedgood}{\feedbad : \name_repq1}}</li></ol>
}
\if{\step==2 and (\repres issametext 1 or (\repres issametext 0 and \sc_reply1==1))}{
<ol start="2" class="spacer"><li>\name_enonc2
<div class="wims_question"> \name_quest2
<div class="wimscenter"><label for="reply2">  \(m(t)\) = </label> \embed{reply2,10} g \condtps. </div></div></li></ol>
}
\if {\step>2}{
<ol start="2" class="spacer"><li>\name_enonc2
\name_quest2
<div class="wimscenter"> \name_rep : \(m(t)\) = \reply2 g \condtps.</div>
\if{\presentgood=1}{\if{\sc_reply2=1}{\feedgood}{\feedbad : \name_repq2 \condtps.}}</li></ol>
}
\if{\step==3 and (\repres issametext 1 or (\repres issametext 0 and \sc_reply2==1))}{
<ol start="3" class="spacer"><li>\name_enonc3[1;] \special{help demi,\name_enonc3[2;]} \name_enonc3[3;]
<div class="wims_question"> \name_quest3
<ul class="wims_nopuce"><li><label for="reply3"> \(a\) = \embed{reply3,10}</label></li>
<li><label for="reply4">\(m(t)\) = </label>\embed{reply4,10} g \condtps.</li></ul>
<div class="wims_instruction">
 \name_signif[1] \(a\) \name_signif[2]
</div></div>
</li></ol>
}
\if {\step>3}{
<ol start="3" class="spacer"><li>\name_enonc3[1;] \special{help demi,\name_enonc3[2;]} \name_enonc3[3;]  \name_quest3
<div class="wimscenter">\name_rep : \(a\)=\reply3 et donc \(m(t)\) = \reply4 g \condtps. </div>
\if{\presentgood=1}{
    \if{\sc_reply3==1 && \sc_reply4==1 }{\feedgood}
    {
        \if{\sc_reply3==1 or \sc_reply4==1}{\feedpart}{\feedbad} : \(a\) = \alpha et donc \name_repq4 \condtps.}
}</li></ol>
}
\if{\step==4 and (\repres issametext 1 or (\repres issametext 0 and \sc_reply3=1 and \sc_reply4=1))}{
<ol start="4" class="spacer"><li>\name_enonc4 
<div class="wims_question">\name_quest4
<div class="wimscenter"><label for="reply5"> \(s\) = </label> \embed{reply5,10} min.</div>
<div class="wims_instruction">\name_signif[1] \(s\) \name_signif[2]</div>
</div>
</li></ol>
}
\if{\step==5}{
<ol start="4" class="spacer"><li>\name_enonc4<br/> \name_quest4
<div class="wimscenter">\name_rep : \(s\) = \reply5 min.</div>
\if{\presentgood=1}{\if{\sc_reply5=1 }{\feedgood}{\feedbad : \name_repq5 }}</li></ol>
}
}

\answer{Equat diff}{\repq1}{type=formal}{option=nonstop noanalyzeprint}
\answer{\(m(t)\) en fonction de \(a\) et \(t\)}{\repq2,t=[0,5],a=[0,1]}{type=function}{option=nonstop noanalyzeprint}
\answer{Valeur de \(a\)}{\alpha#3}{type=sigunits}{option=nonstop noanalyzeprint}
\answer{\(m(t)\) en fonction de \(t\)}{\repq4}{type=function}{option=nonstop noanalyzeprint}
\answer{Valeur de \(s\)}{\repq5#3}{type=sigunits}{option=nonstop noanalyzeprint}

\integer{screpq3=\sc_reply3*\sc_reply4}

\if{\step==2}{
    \if{\repres issametext 1 or (\repres issametext 0 and \sc_reply1=1) }{\text{listrep=r2}}
