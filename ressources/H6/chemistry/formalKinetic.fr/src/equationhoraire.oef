\title{3. Equation horaire}
\author{Céline, Dablemont }
\email{ celine.dablemont@u-psud.fr}
\language{ fr }
\computeanswer{ no }
\precision{ 10000 }
\keywords{chemistry,chemical_kinetics,reaction_order,reaction_rate,integrated_rate_law,rate_law}

données 
réactions, ordre, rang de la bonne réponse
\matrix{data=\(A \rightarrow B\),0,1,
\(A \rightarrow B\),1,2,
\(A \rightarrow B\),2,4,
\(A + B \rightarrow C\),1,4, en A et d'ordre 1 en B réalisée dans les proportions stoechiométriques
\(A + B \rightarrow C\),1,3, en A et d'ordre 1 en B réalisée en large excès de B}
\integer{n=rows(\data)}
\integer{p=random(1..\n)}
\text{liste= \([A] = [A]_0-k t\),\([A] = [A]_0\exp(-k t)\),\([A] = [A]_0\exp(-k[B]_0t)\),\(\frac{1}{[A]}=\frac{1}{[A]_0} +k t\)}

\statement{ Cocher l'équation horaire correspondant à la réaction \data[\p;1] d'ordre \data[\p;2] \data[\p;4].
<ul style="list-style-type:none">\for{h=1 to 4}{<li>\embed{reply1,\h}</li>}</ul>
}
\answer{ }{\data[\p;3];\liste }{type=radio }{option=shuffle}{weight= }
