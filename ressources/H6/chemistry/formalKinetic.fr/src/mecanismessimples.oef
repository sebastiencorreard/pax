\title{5. Mécanismes simples}
\author{Céline, Dablemont }
\email{ celine.dablemont@u-psud.fr}
\language{ fr }
\computeanswer{ no }
\precision{ 10000 }
\keywords{chemistry,chemical_kinetics,reaction_rate,integrated_rate_law,rate_law,kinetic_mechanism,elementary_reaction}

\integer{p=random(1..5)}
integer{p=5}

---liste des réponses---
type vitesse
\text{prop11=\(v_1 \gg v_2\)}
\text{prop12=\(v_1 = v_2\) à tout moment}
\text{prop13=\(v_1 = v_2\) après un certain temps uniquement}
type dérivée
\text{prop21=\(\frac{d[B]}{dt} = 0\) à tout moment}
\text{prop22=\(\frac{d[B]}{dt} = 0\) après un certain temps uniquement}
\text{prop23=\(\frac{d[A]}{dt} = 0\) à tout moment}
\text{prop24=\(\frac{d[A]}{dt} = 0\) après un certain temps uniquement}
\text{prop25=\(\frac{d[C]}{dt} = k_2[B]\)} ne convient pas pour p=5
type loi en [A]
\text{prop31=\([A] = [A]_0 \exp(-k_1 t)\)}
\text{prop32=\([A] = [A]_0 \exp[-(k_1+k_2) t]\)}
\text{prop33=\([A] = [A]_0 \exp[-(k_1+k_2)[B]_0 t]\)}
\text{prop34=\([A] = [A]_0 \exp[-(k_1 [B]_0+k_2[C]_0) t]\)}
\text{prop35=\([A] = [A]_0 \left(\frac{k_2}{k_1+k_2}+\frac{k_1}{k_1+k_2}\exp[-(k_1+k_2) t]\right)\)}
type loi en [B]
\text{prop41=\([B] = \frac{k_1[A]_0}{k_1+k_2}[1-\exp(-(k_1+k_2) t)]\)}
\text{prop42=\([B] = \frac{k_1[A]_0}{k_2-k_1}[\exp(-k_1 t)-\exp(-k_2 t)]\)}
type loi en [C]
\text{prop51=\([C] = [A]_0 [1-\exp(-k_1 t)]\)}
\text{prop52=\([C] = [A]_0 \left(1-\exp(-k_1 t)-\frac{k_1}{k_2-k_1}[\exp(-k_1t)-\exp(-k_2t)]\right)\)}
\text{prop53=\([C] = \frac{k_1[A]_0}{k_1+k_2}\bigg(1-\exp[-(k_1+k_2) [B]_0 t]\bigg)\)}
\text{prop54=\([C]\) est proportionnel à \(\frac{k_1}{k_1+k_2}\)}
type loi en [D]
\text{prop61=\([D] = \frac{k_2[A]_0}{k_1+k_2}\bigg(1-\exp[-(k_1+k_2) [B]_0 t]\bigg)\)}
\text{prop62=\([D]\) est proportionnel à \(\frac{k_1}{k_1+k_2}\)}
type loi en [X]
\text{prop71=\([X] = \frac{k_1[A]_0 [B]_0}{k_1[B]_0+k_2[C]_0}\bigg(1- \exp[-(k_1 [B]_0+k_2[C]_0) t]\bigg)\)}
\text{prop72=\([X] = \frac{k_1[A]_0 [C]_0}{k_1[C]_0+k_2[B]_0}\bigg(1- \exp[-(k_1 [C]_0+k_2[B]_0) t]\bigg)\)}
type loi en [Y]
\text{prop81=\([Y] = \frac{k_2[A]_0 [C]_0}{k_1[B]_0+k_2[C]_0}\bigg(1- \exp[-(k_1 [B]_0+k_2[C]_0) t]\bigg)\)}
\text{prop82=\([Y] = \frac{k_2[A]_0 [B]_0}{k_1[C]_0+k_2[B]_0}\bigg(1- \exp[-(k_1 [C]_0+k_2[B]_0) t]\bigg)\)}
type divers
\text{prop91=\(K = \frac{[B]}{[A]}\)}

\if{\p=1}{
  \text{enonce=On considère les réactions élémentaires consécutives quelconques
    <p class="wimscenter"> A \(\overset{k_1}{\longrightarrow}\) B \(\overset{k_2}{\longrightarrow}\) C </p>
  Cocher la ou les bonnes réponses.}
  \text{listevrai=shuffle(\prop25,\prop31,\prop42,\prop52)}
  \text{listefaux=shuffle(\prop11,\prop12,\prop13,\prop21,\prop22,\prop23,\prop24,\prop32,\prop33,\prop34,\prop35,\prop41,\prop51,\prop53,\prop54)}
  }

\if{\p=2}{
  \text{enonce=On considère qu'on applique l'hypothèse de l'état quasi-stationnaire aux réactions consécutives
    <p class="wimscenter"> A \(\overset{k_1}{\longrightarrow}\) B \(\overset{k_2}{\longrightarrow}\) C </p>
    Cocher la ou les bonnes réponses.}
  \text{listevrai=shuffle(\prop12,\prop21,\prop25,\prop31,\prop42,\prop51,\prop52)}
  \text{listefaux=shuffle(\prop11,\prop13,\prop22,\prop23,\prop24,\prop32,\prop33,\prop34,\prop35,\prop41,\prop53,\prop54)}
  }

\if{\p=3}{
  \text{enonce=On considère deux réactions jumelles élémentaires pour lesquelles \([A]_0 \ll [B]_0\)
    <p class="wimscenter"> A+B \(\overset{k_1}{\longrightarrow}\) C et A+B \(\overset{k_2}{\longrightarrow}\) D </p>
    Cocher la ou les bonnes réponses.}
  \text{listevrai=shuffle(\prop33,\prop53,\prop54,\prop61)}
  \text{listefaux=shuffle(\prop11,\prop12,\prop13,\prop21,\prop22,\prop23,\prop24,\prop25,\prop31,\prop32,\prop34,\prop35,\prop41,\prop42,\prop51,\prop52,\prop62)}
  }

\if{\p=4}{
  \text{enonce=On considère deux réactions compétitives élémentaires pour lesquelles \([A]_0 \ll [B]_0\) et \([A]_0 \ll [C]_0\)
    <p class="wimscenter"> A+B \(\overset{k_1}{\longrightarrow}\) X et A+C \(\overset{k_2}{\longrightarrow}\) Y </p>
    Cocher la ou les bonnes réponses.}
  \text{listevrai=shuffle(\prop34,\prop71,\prop81)}
  \text{listefaux=shuffle(\prop11,\prop12,\prop13,\prop21,\prop22,\prop23,\prop24,\prop25,\prop31,\prop32,\prop33,\prop35,\prop41,\prop42,\prop51,\prop52,\prop53,\prop54,\prop72,\prop82)}
  
}

\if{\p=5}{
  \text{enonce=On considère les réactions élémentaires équilibrées et sous contrôle cinétique
    <p class="wimscenter"> A \(\overset{k_1}\underset{k_2}{\rightleftharpoons}\) B </p>
    Cocher la ou les bonnes réponses.}
  \text{listevrai=shuffle(\prop13,\prop22,\prop24,\prop35,\prop41)}
  \text{listefaux=shuffle(\prop11,\prop12,\prop21,\prop23,\prop31,\prop32,\prop33,\prop42,\prop91)}
}
  \integer{v=random(1..3)}
  \integer{f1=4-\v}
  \integer{f2=6-\v}
  \integer{f=random(\f1..\f2)}
  \integer{h=\v+\f}
  \text{liste = item(1..\v,\listevrai),item(1..\f,\listefaux)}
  \text{rep=shuffle(\v)}

\statement{
\enonce
<ul style="list-style-type:none">\for{j=1 to \h}{
<li>\embed{reply1,\j}</li>}
</ul>}
\answer{}{\rep;\liste}{type=checkbox}{option=shuffle,noanalyzeprint}
\feedback{1=1}{Les bonnes réponses sont :
<ul>\for{j=1 to \v}{
<li>\listevrai[\j]</li>}
</ul>}
