\email{ celine.dablemont@u-psud.fr}
\language{ fr }
\computeanswer{ no }
\precision{ 10000 }
\keywords{chemistry,chemical_kinetics,reaction_rate}

\matrix{nstep=reply1,reply2}
\nextstep{\nstep}

\text{rep1=}
\text{rep2=}
\text{cc=red}
\text{ccc=red}

\text{reptm=}
\text{rep2M=}
\text{rept=}
\text{reptt=}


integer{p=6}
\integer{p=randint(1..10)}
\if{\p=1}{
  \text{equation = \mathrm{N}_{2} + 3 \mathrm{H}_{2} \rightarrow 2 NH_{3}}
  \text{type=industrielle de synthèse de l'ammoniac}
  \matrix{L=-1/3,H_2
    -1,N_2
    1/2,NH_3}
  \integer{k=1}
  \text{produit=H_2,N_2,NH_3}}
\if{\p=2}{
  \text{equation = \mathrm{C}_6\mathrm{H}_{12}\mathrm{O}_6 \rightarrow 2 \mathrm{C}_2\mathrm{H}_5OH + 2 CO_2}
  \text{type=de fermentation alcoolique}
  \matrix{L=-1,C_6H_12O_6
    1/2,C_2H_5OH
    1/2,CO_2}
  \integer{k=1}
  \text{produit=C_6H_12O_6,C_2H_5OH,CO_2}}
\if{\p=3}{
  \text{equation = CO + 3 \mathrm{H}_2 \rightarrow CH_4 + \mathrm{H}_2\mathrm{O}}
  \text{type=de méthanation du monoxyde de carbone}
  \matrix{L=-1,CO
    -1/3,H_2
    1,CH_4
    1,H_2O}
  \integer{k=1}
  \text{produit=CO,H_2,CH_4,H_2O}}
\if{\p=4}{
  \text{equation = NH_3 + 2 \mathrm{O}_2 \rightarrow HNO_3 + \mathrm{H}_2\mathrm{O}}
  \text{type=du procédé Ostwald pour la synthèse de l'acide nitrique}
  \matrix{L=-1,NH_3
    -1/2,O_2
    1,HNO_3
    1,H_2O}
  \integer{k=1}
  \text{produit=NH_3,O_2,HNO_3,H_2O}}
\if{\p=5}{
  \text{equation = Cl_2 + 2 OH^- \rightarrow Cl^- + ClO^- + \mathrm{H}_2\mathrm{O}}
  \text{type=de synthèse de l'eau de Javel}
  \matrix{L=-1,Cl_2
    -1/2,OH^-
    1,Cl^-
    1,ClO^-
    1,H_2O}
  \integer{k=1}
  \text{produit=Cl_2,OH^-,Cl^-,ClO^-,H_2O}}
\if{\p=6}{
  \text{equation = 4 HCl + \mathrm{O}_2 \rightarrow 2 \mathrm{H}_2\mathrm{O} + 2 Cl_2}
  \text{type=du procédé Deacon pour la synthèse du dichlore}
  \matrix{L=-1/4,HCl
    -1,O_2
    1/2,H_2O
    1/2,Cl_2}
  \integer{k=1}
  \text{produit=HCl,O_2,H_2O,Cl_2}}
\if{\p=7}{
  \text{equation = \mathrm{C}_3\mathrm{H}_8 + 3 NH_3 \rightarrow 3 HCN + 7 \mathrm{H}_2}
  \text{type=du procédé Shawinigan pour la synthèse de l'acide cyanhydrique}
  \matrix{L=-1,C_3H_8
    -1/3,NH_3
    1/3,HCN
    1/7,H_2}
  \integer{k=1}
  \text{produit=C_3H_8,NH_3,HCN,H_2}}
\if{\p=8}{
  \text{equation = 3 \mathrm{C}_2\mathrm{H}_2 \rightarrow \mathrm{C}_6\mathrm{H}_6}
  \text{type=de la méthode de Berthelot pour la synthèse du benzène}
  \matrix{L=-1/3,C_2H_2
    1,C_6H_6}
  \integer{k=1}
  \text{produit=C_2H_2,C_6H_6}}
\if{\p=9}{
  \text{equation = CH_4 + 2 \mathrm{O}_2 \rightarrow CO_2 + 2 \mathrm{H}_2\mathrm{O}}
  \text{type=de combustion du méthane}
  \matrix{L=-1,CH_4
    -1/2,O_2
    1,CO_2
    1/2,H_2O}
  \integer{k=1}
  \text{produit=CH_4,O_2,CO_2,H_2O}}
\if{\p=10}{
  \text{equation = 2 CH_3CHO + \mathrm{O}_2 \rightarrow 2 CH_3COOH}
  \text{type=d'oxydation de l'acétaldéhyde pour la synthèse de l'acide acétique}
  \matrix{L=-1/2,CH_3CHO
    -1,O_2
    1/2,CH_3COOH}
  \integer{k=1}
  \text{produit=CH_3CHO,O_2,CH_3COOH}}
\statement{
\if{\step=1}{La vitesse de la réaction \type \(\equation\) peut être définie comme :
<div class="wimscenter">
  \special{mathmlinput [v=reply1.\dfrac{\mathrm{d} \lbrack reply2 \rbrack}{d t}], 5,noanswer
    reply1,4
    reply2
  }</div>

<div class="wims_instruction">Le composé \(\mathrm{H}_2\) doit être entré H_2,
le composé \(Cl^-\) doit être entré Cl^-.
 Le coefficient doit être un nombre (un simple signe ne suffit pas).
 Vous devez respecter les majuscules.</div>}
\if{\step=2}{Votre réponse pour la vitesse de la réaction \type \(\equation\) est :
<div class="wimscenter">
\(v= \color{\cc} {\reptm }\color{black}{.}\frac{\mathrm{d}\lbrack \color{\ccc}{ \rept }\color{black}{ \rbrack}}{dt} \)
</div>}
}

\text{rep1=\reply1}
\text{rep2=\reply2}
\text{reptm=texmath(\rep1)}
\text{rep2M=wims(upper \reply2)}
Converti les expressions chimiques en tex puis replace internal
\text{rept=slib(chemistry/chemeq_tex \rep2)}
text{repf=wims(char 1 of \rep2)}
text{repfM=wims(char 1 of \rep2M)}



le coefficient est analysé plus tard en fonction du produit choisi.
\answer{}{\coeff}{type=numeric}{option=noanalyzeprint nonstop}
Choisir le produit n'est pas une grande réussite donc 0 point mais un feedback dans la condition
\answer{}{Alt:\produit}{type=raw}{weight=0}{option=noanalyzeprint symtext case nonstop}
\condition{Vous avez choisi un composé qui intervient dans la réaction}{\sc_reply2=1 and (\rep2 isin \produit)}{weight=0}
ensuite quand le produit est bon, on teste le coefficient :
Ce test n'est pas une bonne idée Cl^-=> and (\repf issamecase \repfM)


\if{(\sc_reply2=1 and (\rep2 isin \produit))}{\text{ccc=green}
  \while{\L[\k;2]  notsamecase \reply2}{\integer{k=\k+1}}
  \feedback{\coeff<>\L[\k;1] and \sc_reply2=1 and (\rep2 isin \produit)}{<span class="oef_indbad">Vous n'avez pas donné le coefficient correspondant au composé considéré.</span>}
  \feedback{\coeff=\L[\k;1] and \sc_reply2=1 and (\rep2 isin \produit)}{<span class="oef_indgood">Vous avez donné le coefficient correspondant au composé considéré.</span>}
  \condition{Vous avez donné le coefficient correspondant au composé considéré}{\coeff=\L[\k;1] and \sc_reply2=1 and (\rep2 isin \produit)}{option=hide}{weight=10}
\if{\coeff=\L[\k;1]}{\text{cc=green}}
}
\text{nstep=(\step=2)?}
