\title{1. Unité de la constante}
\author{Céline, Dablemont }
\email{celine.dablemont@u-psud.fr}
\language{ fr }
\computeanswer{ no }
\precision{ 10000 }
\keywords{chemistry,chemical_kinetics,reaction_order,rate_constant}

liste des réponses
\text{liste=\(\rm{s}^{-1}\),\(\rm{L}.\rm{mol}^{-1}.\rm{s}^{-1}\),\(\rm{L}^2.\rm{mol}^{-2}.\rm{s}^{-1}\),\(\rm{mol}.\rm{L}^{-1}.\rm{s}^{-1}\),\(\rm{L}^3.\rm{mol}^{-3}.\rm{s}^{-1}\)
}
réaction et rang de la bonne réponse
\matrix{data=A \rightarrow B + C, 1
2 A + B \rightarrow 3C, 3
A + B \rightarrow C, 2
A + 2 B \rightarrow 3C, 3}
choix de la ligne pour la question
\integer{ n = randint(1..rows(\data)) }
bonne réponse
\text{rep=item(\data[\n;2],\liste)}

\statement{Pour la réaction élémentaire \(\data[\n;1]\), la constante de vitesse \(k\) s'exprime en :
<ul style="list-style-type:none">\for{h=1 to 5}{<li>\embed{reply1,\h}</li>}</ul>
}
\answer{ }{\data[\n;2];\liste }{type=radio }{option=}{weight= }
\feedback{\n=1}{La réaction est d'ordre 1 donc l'unité de la constante est \rep.}
\feedback{\n=2 or \n=4}{La réaction est d'ordre 3 donc l'unité de la constante est \rep.}
\feedback{\n=3}{La réaction est d'ordre 2 donc l'unité de la constante est \rep.}
