!set title=1. Unité de la constante
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Céline, Dablemont 
email=celine.dablemont@u-psud.fr
keywords=chemistry,chemical_kinetics,reaction_order,rate_constant
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(\rm{s}^{-1}\),\(\rm{L}.\rm{mol}^{-1}.\rm{s}^{-1}\),\(\rm{L}^2.\rm{mol}^{-2}.\rm{s}^{-1}\),\(\rm{mol}.\rm{L}^{-1}.\rm{s}^{-1}\),\(\rm{L}^3.\rm{mol}^{-3}.\rm{s}^{-1}\)	
tmp=!trim A \rightarrow B + C, 1	2 A + B \rightarrow 3C, 3	A + B \rightarrow C, 2	A + 2 B \rightarrow 3C, 3
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp0=!rowcnt $tmp
tmp1=!randint 1, $(tmp0)

val8=$[rint($(tmp1) )]
tmp0=!item $(val7[$val8;2]) of $val6

val9=$(tmp0)
replytype1=radio
replyoption1= 
replyweight1= 
replyname1=
replygood1=$(val7[$val8;2]);$val6 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Pour la réaction élémentaire 
!insmath $(val7[$val8;1])
$(), la constante de vitesse 
!insmath k
$() s'exprime en :	<ul style="list-style-type:none"> 
!for m_h=1 to 5 
$()<li> 
!read oef/embed.phtml reply1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $val8=1
 <div class='oef_feedbacks'>La réaction est d'ordre 1 donc l'unité de la constante est $val9.
$()</div>
!endif
!ifval $val8=2 or $val8=4
 <div class='oef_feedbacks'>La réaction est d'ordre 3 donc l'unité de la constante est $val9.
$()</div>
!endif
!ifval $val8=3
 <div class='oef_feedbacks'>La réaction est d'ordre 2 donc l'unité de la constante est $val9.
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=1
