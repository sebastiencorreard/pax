!set title=3. Equation horaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Céline, Dablemont 
email=celine.dablemont@u-psud.fr
keywords=chemistry,chemical_kinetics,reaction_order,reaction_rate,integrated_rate_law,rate_law
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim \(A \rightarrow B\),0,1,	\(A \rightarrow B\),1,2,	\(A \rightarrow B\),2,4,	\(A + B \rightarrow C\),1,4, en A et d'ordre 1 en B réalisée dans les proportions stoechiométriques	\(A + B \rightarrow C\),1,3, en A et d'ordre 1 en B réalisée en large excès de B
val6=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val7=$[rint($(tmp0))]
tmp0=!randint 1, $val7

val8=$[rint($(tmp0))]
val9=\([A] = [A]_0-k t\),\([A] = [A]_0\exp(-k t)\),\([A] = [A]_0\exp(-k[B]_0t)\),\(\frac{1}{[A]}=\frac{1}{[A]_0} +k t\)
replytype1=radio
replyoption1=shuffle 
replyweight1= 
replyname1=
replygood1=$(val6[$val8;3]);$val9 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Cocher l'équation horaire correspondant à la réaction $(val6[$val8;1]) d'ordre $(val6[$val8;2]) $(val6[$val8;4]).	<ul style="list-style-type:none"> 
!for m_h=1 to 4 
$()<li> 
!read oef/embed.phtml reply1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=1
