tmp0=!randint 1, 5

val6=$[rint($(tmp0))]
val7=\(v_1 \gg v_2\)
val8=\(v_1 = v_2\) à tout moment
val9=\(v_1 = v_2\) après un certain temps uniquement
val10=\(\frac{d[B]}{dt} = 0\) à tout moment
val11=\(\frac{d[B]}{dt} = 0\) après un certain temps uniquement
val12=\(\frac{d[A]}{dt} = 0\) à tout moment
val13=\(\frac{d[A]}{dt} = 0\) après un certain temps uniquement
val14=\(\frac{d[C]}{dt} = k_2[B]\)
val15=\([A] = [A]_0 \exp(-k_1 t)\)
val16=\([A] = [A]_0 \exp[-(k_1+k_2) t]\)
val17=\([A] = [A]_0 \exp[-(k_1+k_2)[B]_0 t]\)
val18=\([A] = [A]_0 \exp[-(k_1 [B]_0+k_2[C]_0) t]\)
val19=\([A] = [A]_0 \left(\frac{k_2}{k_1+k_2}+\frac{k_1}{k_1+k_2}\exp[-(k_1+k_2) t]\right)\)
val20=\([B] = \frac{k_1[A]_0}{k_1+k_2}[1-\exp(-(k_1+k_2) t)]\)
val21=\([B] = \frac{k_1[A]_0}{k_2-k_1}[\exp(-k_1 t)-\exp(-k_2 t)]\)
val22=\([C] = [A]_0 [1-\exp(-k_1 t)]\)
val23=\([C] = [A]_0 \left(1-\exp(-k_1 t)-\frac{k_1}{k_2-k_1}[\exp(-k_1t)-\exp(-k_2t)]\right)\)
val24=\([C] = \frac{k_1[A]_0}{k_1+k_2}\bigg(1-\exp[-(k_1+k_2) [B]_0 t]\bigg)\)
val25=\([C]\) est proportionnel à \(\frac{k_1}{k_1+k_2}\)
val26=\([D] = \frac{k_2[A]_0}{k_1+k_2}\bigg(1-\exp[-(k_1+k_2) [B]_0 t]\bigg)\)
val27=\([D]\) est proportionnel à \(\frac{k_1}{k_1+k_2}\)
val28=\([X] = \frac{k_1[A]_0 [B]_0}{k_1[B]_0+k_2[C]_0}\bigg(1- \exp[-(k_1 [B]_0+k_2[C]_0) t]\bigg)\)
val29=\([X] = \frac{k_1[A]_0 [C]_0}{k_1[C]_0+k_2[B]_0}\bigg(1- \exp[-(k_1 [C]_0+k_2[B]_0) t]\bigg)\)
val30=\([Y] = \frac{k_2[A]_0 [C]_0}{k_1[B]_0+k_2[C]_0}\bigg(1- \exp[-(k_1 [B]_0+k_2[C]_0) t]\bigg)\)
val31=\([Y] = \frac{k_2[A]_0 [B]_0}{k_1[C]_0+k_2[B]_0}\bigg(1- \exp[-(k_1 [C]_0+k_2[B]_0) t]\bigg)\)
val32=\(K = \frac{[B]}{[A]}\)
!if $val6=1 
val33=On considère les réactions élémentaires consécutives quelconques	    <p class="wimscenter"> A \(\overset{k_1}{\longrightarrow}\) B \(\overset{k_2}{\longrightarrow}\) C </p>	  Cocher la ou les bonnes réponses.
tmp0=!shuffle $val14,$val15,$val21,$val23

