val35=$(tmp0)
!endif
!if $val6=4 
val33=On considère deux réactions compétitives élémentaires pour lesquelles \([A]_0 \ll [B]_0\) et \([A]_0 \ll [C]_0\)	    <p class="wimscenter"> A+B \(\overset{k_1}{\longrightarrow}\) X et A+C \(\overset{k_2}{\longrightarrow}\) Y </p>	    Cocher la ou les bonnes réponses.
tmp0=!shuffle $val18,$val28,$val30

val34=$(tmp0)
tmp0=!shuffle $val7,$val8,$val9,$val10,$val11,$val12,$val13,$val14,$val15,$val16,$val17,$val19,$val20,$val21,$val22,$val23,$val24,$val25,$val29,$val31

val35=$(tmp0)
!endif
!if $val6=5 
