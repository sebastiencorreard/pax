\title{Polarité et détermination des porteurs de charge d'une pile}
\author{Benoit Markey}
\mail{benoit.markey@ac-lille.fr}


\integer{nreac=wims(recordcnt couples_piles.dat)}
\integer{i=randint(1..\nreac-1)}
\integer{j=randint(\i+1..\nreac)}

\text{reac1=wims (record \i of couples_piles.dat)}
\text{reac2=wims (record \j of couples_piles.dat)}
\text{tension=\reac1[;2];\reac2[;2]}
\text{i=shuffle(1,2)}
\real{U=\tension[\i[1];]-\tension[\i[2];]}
\text{metal=\reac1[;5];\reac2[;5]}
\text{ion=\reac1[;4];\reac2[;4]}

####Dessin de pile
\text{pile1=draw(200,200
fsquare 5,135,60,skyblue
segment 5,120,5,195,black
segment 65,120,65,195,black
segment 5,195,65,195,black
fsquare 135,135,60,yellow
segment 135,120,135,195,black
segment 195,120,195,195,black
segment 135,195,195,195,black
linewidth 5
segment 50,90,50,150,green
segment 50,90,150,90,green
segment 150,90,150,150,green
segment 10,100,15,160,grey
segment 190,100,185,160,grey
linewidth 1
segment 10,100,10,30, black
segment 10,30,190,30,black
segment 190,30,190,100,black
fcircle 95,30,50,white
linewidth 3
circle 95,30,50,red
text red,75,25,small,\U V
text red,125,15,small,COM
text black,15,90,small,\metal[\i[1];]
text black,170,90,small,\metal[\i[2];]
text black,15,180,small,\ion[\i[1];]
text black,150,180,small,\ion[\i[2];]
text green,100,70,small,NH4^+
text green,100,100,small,NO3^-

)}
\text{pile=<img src="\pile1">}

\text{plus1=draw(20,20
frect 0,0,20,20,232,232,232
text black,8,3,medium,+
circle 10,10,18,black)}
\text{plus=<img src="\plus1">}

\text{moins1=draw(20,20
frect 0,0,20,20,232,232,232
text black,8,3,medium,-
circle 10,10,18,black)}
\text{moins=<img src="\moins1">}

\matrix{rep1=\plus,\(\reac1[;5]),\(\reac2[;5])
\moins,\(\reac2[;5]),\(\reac1[;5])}
\integer{j=randint(1..2)}
\integer{j1=randint(1..2)}
\integer{j2=randint(1..2)}
\matrix{rep2=NH<sub>4</sub><sup>+</sup>,\reac1[;4],\reac2[;4]
NO<sub>3</sub><sup>-</sup>,\reac2[;4],\reac1[;4]}


\matrix{rep3=la reduction,\(\reac1[;5]),\(\reac2[;5])
l'oxydation,\(\reac2[;5]),\(\reac1[;5])}

\statement{
On considére la pile électrochimique suivante:<br>
<table>
<tr><th>
\pile
</th><td><ol><li>Déterminer le pôle \rep1[\j;1] de la pile<br>
\embed{\(reply1 ,10x20)}<br>
<li>Le pont salin est constitué d'ions NH<sub>4</sub><sup>+</sup> et d'ions NO<sub>3</sub><sup>-</sup>,
Déterminez dans quel sens vont se déplacer les ions \rep2[\j;1]<br>
\embed{reply2}<br>
<li>Quelle est l'électrode siège de \rep3[\j;1]?<br>
\embed{reply3}<br>
<li>Dans quel sens se déplacent les électrons?<br>
\embed{reply4}<br>
<li>Quel est le sens du courant électrique?</td></ol></tr>
</table>
}
\choice{1. le pôle \rep1[\j;1] est la lame de}{\rep1[\j;2]}{\rep1[\j;3]}{shuffle}
\choice{2. les ions \rep2[\j1;1] vont vers }{\rep2[\j1;2]}{\rep2[\j1;3]}{shuffle}
\choice{3. \rep3[\j2;1] a lieu sur la lame de}{\rep3[\j2;2]}{\rep3[\j2;3]}{shuffle}
\choice{4. Les électrons vont vers la lame de}{\reac1[;5]}{\reac2[;5]}{shuffle}
\choice{5. Le courant électrique va vers la lame de}{\reac2[;5]}{\reac1[;5]}{shuffle}
