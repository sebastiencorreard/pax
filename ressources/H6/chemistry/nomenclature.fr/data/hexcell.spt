select none;
# carbon as atoms
# nitrogen as tetra sites
# oxygen as octa sites
#select (carbon);spacefill 2.500000;
#select (nitrogen);spacefill 0.561862;
#select (oxygen); spacefill 1.035534;
define ~at (within(5.05,({C23})) or  within(5.05,({C5}))) and (carbon)
define ~tetra (within(5.05,({C23})) or  within(5.05,({C5}))) and (nitrogen)
define ~octa (within(5.05,({C23})) or  within(5.05,({C5}))) and (oxygen)
define ~cell (within(6.5,({C23})) or  within(6.5,({C5}))) and (phosphorus)
define ~good (_Y)
define ~bad (_No)
select ~at;
color atoms blue;
select ~tetra or ~octa;
color atoms gray;
select ~cell;
color atoms gray;
connect 5.1 (~cell) (~cell) create;
wireframe .07;
#select ~tetra ;spacefill 0.561862;
#select ~octa ; spacefill 1.035534;
select ~tetra ;spacefill 0.18;
select ~octa ; spacefill 0.18;
select ~cell ; spacefill 0.;
select ~at ;spacefill 1.000000;
color background white;
select none;
display ~at or ~tetra or ~octa or ~cell or ~good or ~bad
