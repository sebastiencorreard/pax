 dir=p2-p1;
 d1=distance(p2,p1);
 dir=dir/d1
 pt1=p1-dir*dist
 pt2=p2+dir*dist
 addextat(pt1,pt2,sc,colo,lab)
 drawhex(dir,pt1,sc,colo,lab+'1_')
 drawhex(dir,pt2,sc,colo,lab+'2_')
 strsc='draw id "'+lab+'axe" width '+@{sc/5.0}+' color '+colo+' '+@pt1+' '+@pt2
 script inline @strsc
