function drawA6b(p1,p2,dist,sc,colo,lab){
 dir=p2-p1;
 d1=distance(p2,p1);
 dir=dir/d1
 pt1=p1-dir*dist
 pt2=p2+dir*dist
 addextat(pt1,pt2,sc,colo,lab)
 drawhex(dir,pt1,sc,colo,lab+'1_')
 drawtri(dir,pt1,sc,colo,lab+'2_')
 drawhex(dir,pt2,sc,colo,lab+'3_')
 drawtri(dir,pt2,sc,colo,lab+'4_')
 strsc='draw id "'+lab+'axe" width '+@{sc/5.0}+' color '+colo+' '+@pt1+' '+@pt2
 script inline @strsc
}
  
function drawm(pts,dist,sc,colo){
 var nbt=nbsommets+nbaretes+nbfaces;
 var p1=pts[1];
 var p2=pts[2];
 var p3=pts[3];
 dist=dist+1.0;
 sc=sc*0.1;
 select within (0,plane,@{plane(p1,p2,p3)})
 var mysel={selected and atomno<=nbt}
 var lab="op_0_"+mysel.size+"_"+(atx2n(mysel)).join("_")
 tsorted=around(mysel);
 var cent={selected}.xyz
var before={*}[0].atomno
 var strat='data "append ex"|'+mysel.size+'||';
 for(var iat=1;iat<mysel.size;iat++){
  var a1=mysel[tsorted[iat]].xyz 
  var v1=a1-cent;
  var cv1=distance(a1,cent)
  var n1=v1/cv1
  var d1=n1*dist
  a1=a1*dist;
  var a2=mysel[tsorted[iat+1]].xyz 
  var v2=a2-cent;
  var cv2=distance(a2,cent)
  var n2=v2/cv2
  var d2=n2*dist
  a2=a2*dist;
  var strsc='draw id "'+lab+'_tri_'+iat+'" color '+colo+' '+cent+' '+a1+' '+a2+' translucent '+translMirror+' ;'
  strsc=strsc+'draw id "'+lab+'_border_'+iat+'" width '+sc+' color '+colo+' '+a1+' '+a2+';'
  strat=strat+'X ';
  strat=strat+a1.x+' '+a1.y+' '+a1.z+' |';
  script inline @strsc
 }
  var a1=mysel[tsorted[1]].xyz 
  var v1=a1-cent;
  var cv1=distance(a1,cent)
  var n1=v1/cv1
  var d1=n1*dist
  a1=a1*dist;
  var a2=mysel[tsorted[mysel.size]].xyz 
  var v2=a2-cent;
  var cv2=distance(a2,cent)
  var n2=v2/cv2
  var d2=n2*dist
  a2=a2*dist;
  var strsc='draw id "'+lab+'_tri_'+mysel.size+'" color '+colo+' '+cent+' '+a1+' '+a2+' translucent '+translMirror+';'
  strsc=strsc+'draw id "'+lab+'_border_'+iat+'" width '+sc+' color '+colo+' '+a1+' '+a2+';'
  script inline @strsc
  strat=strat+'X ';
  strat=strat+a1.x+' '+a1.y+' '+a1.z+' |';
  strat=strat+'end "append ex"';
  script inline @strat;
var after={*}[0].atomno
  tabptsdrawn[nbdrawn]={atomno>before and atomno<=after};
  selectionhalos on
  select within (0,plane,@{plane(p1,p2,p3)}) and atomno>nbt
  color atoms @colo;
 connect ({selected}) (*) delete;
 spacefill 0.0;
  select none
 set drawhover false;
}
 
function isaligned(tabat){
 var ans=false;
 var sz=tabat.size;
 var p1={0 0 0};
 var p2={0 0 0};
 var p3={0 0 0};
 var v1={0 0 0};
 var v2={0 0 0};
 var tol=0.0001;
 var ans=true;
 if(sz>1){
  if(sz>2){
   var tabxyz=array()
   var mysel=n2atx(tabat)
   tabxyz=for(vx;@mysel;vx.xyz);
   for(var iat=1;iat<=sz-2;iat++){
    p1=tabxyz[iat]
    p2=tabxyz[iat+1]
    p3=tabxyz[iat+2]
    v1=p2-p1;
    v2=p3-p1;
    n1=sqrt(v1*v1);
    n2=sqrt(v2*v2);
    if(abs(v1*v2)/(n1*n2)<1-tol){
     ans=false
    }
   }
  }else{
   ans=true;
  }
 }else{
  ans=false;
 }
 return ans;
}

function resizeop(){
 distAxe=distAxe*sizeop;
 distMirror=distMirror*sizeop;
 distInv=distInv*sizeop;
 scAxe=scAxe*sizeop;
 scMirror=scMirror*sizeop;
 scInv=scInv*sizeop;
}
function clickaxe(){
 resizeop();
 taille=mataille();
 select none;
 selectionhalos on;
 color selectionhalos @colhalos;
 var sz=sizeatome
 showpoignees(@colpoignees,sz)
 set drawhover false;
 hover off;
 set picking select;
 changealltransp(0.4);
 updateallfaces();
}

