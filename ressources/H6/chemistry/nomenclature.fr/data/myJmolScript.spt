 select savesel;
}

function showfaces(colo,sz){
 var savesel={(selected)};
 select (_F);
 spacefill @sz ;
 color atoms @colo;
 select savesel;
}

function drawAxe(iord,sel,dist,sc,colo){
 dist=dist*1.05
 var nbt=nbsommets+nbaretes+nbfaces;
 if(sel.size==2){
  var allsel=n2atx(allaligned2(sel[1],sel[2]))
  sel=maxdistaxe2(allsel);
  var p1=sel[1].xyz
  var p2=sel[2].xyz
   nbdrawn=nbdrawn+1;
   topdrawnorder[nbdrawn]=iord;
   myinv=allaligned2(sel[1],sel[2]);
   topdrawninvariant[nbdrawn]=n2atx(allaligned2(sel[1],sel[2]));
  lab='op_'
  lab=lab+iord+'_'+myinv.size+'_'+myinv.join('_')+'_';
   listnotdel[nbdrawn]=true;
  if(iord==2){
   drawA2(p1,p2,dist,sc,colo,lab);
  }
  if(iord==3){
   drawA3(p1,p2,dist,sc,colo,lab);
  }
  if(iord==-3){
   drawA3b(p1,p2,dist,sc,colo,lab);
  }
  if(iord==4){
   drawA4(p1,p2,dist,sc,colo,lab);
  }
  if(iord==-4){
   drawA4b(p1,p2,dist,sc,colo,lab);
  }
  if(iord==6){
   drawA6(p1,p2,dist,sc,colo,lab);
  }
  if(iord==-6){
   drawA6b(p1,p2,dist,sc,colo,lab);
  }
  select none;
 }else{
  javascript alert("Vous devez sélectionner 2 points pour dessiner un axe de rotation");
 }
}

function drawMirror(sel,dist,sc,colo){
 var nbt=nbsommets+nbaretes+nbfaces;
 if(sel.size==3){
  var pts=for(p;sel;p.xyz)
  var iat=for(p;sel;p.atomno)
  if(isaligned(iat)){
   javascript alert("Vous devez sélectionner 3 points non alignés pour dessiner un miroir");
  }else{
   nbdrawn=nbdrawn+1;
   var p1=pts[1];
   var p2=pts[2];
   var p3=pts[3];
   var mysel={ within (0,plane,@{plane(p1,p2,p3)}) and atomno<=nbt}
   topdrawnorder[nbdrawn]=0;
   topdrawninvariant[nbdrawn]=@mysel
   var inv=atx2n(mysel)
   listnotdel[nbdrawn]=true;
   drawm(mysel,dist,sc,colo);
   select none;
  }
 }else{
  javascript alert("Vous devez sélectionner 3 points non alignés pour dessiner un miroir");
 }
}

function drawInversion(sc,colo){
 var nbt=nbsommets+nbaretes+nbfaces;
 sc=sc*0.3;
 draw id "op_-1_0_" width @sc color @colo {0,0,0}
   nbdrawn=nbdrawn+1;
   topdrawnorder[nbdrawn]=-1;
   topdrawninvariant[nbdrawn]={within(0.01,{0 0 0}) and atomno<=nbt}
   listnotdel[nbdrawn]=true;
   addcenter(sc,colo,"op_-1_0_")
}

function around(sel){
if(sel.size==3){return [1 2 3]}
 var cen={sel}.xyz;
 var atsel=within(0.01,({sel}).xyz)
 var tsorted=array()
 tsorted[1]=1;
 var nbsorted=1;
 var talready=array();
 for(var i=2;i<=sel.size;i++){
  talready[i]=sel[i].xyz==atsel.xyz
 }
 talready[1]=true;
 for(var nbsorted=1;nbsorted<sel.size;nbsorted++){
  for(var i=2;i<=sel.size;i++){
   if(! talready[i]){
    if(cbetweenab(sel[tsorted[nbsorted-1]],sel[i],sel[tsorted[nbsorted]],({sel}).xyz)){
     next=i;
     break;
    }
   }
  }
  var tmp=tsorted[nbsorted];
  for(var j=2;j<=sel.size;j++){
   if((! talready[j]) && j!=next){
    var a=sel[tmp]
    var b=sel[next]
    var c=sel[j]
    if(cbetweenab(a,b,c,({sel}).xyz) ){
     next=j
    }
   }
  }
  talready[next]=true;
  tsorted[nbsorted+1]=next;
 }
 return tsorted
}

function isplaneorigined(tabat){
var aa=angle(tabat[1],tabat[2],tabat[3],{0,0,0});
aa=(aa<-90 ? aa+180 : aa)
aa=(aa>90 ? aa-180 : aa)
return abs(aa)<0.5
}

function allaligned(at1,at2){
 var tol=0.001;
 var nbat={*}[0].atomno;
 var nbaligned=2;
 var tabaligned=array();
 var v1=at2.xyz-at1.xyz;
 var n1=sqrt(v1*v1);
 var iat1=at1.atomno;
 var iat2=at2.atomno;
 tabaligned[1]=iat1;
 tabaligned[2]=iat2;
 for(var iat=1;iat<=nbat;iat++){
  if(iat!=iat1 && iat!=iat2){
   var v2={atomno=iat}.xyz-at1.xyz;
   var n2=sqrt(v2*v2);
   if(1-abs(v1*v2/(n1*n2))<tol){
    nbaligned=nbaligned+1;
    tabaligned[nbaligned]=iat;
   }
  }
 }
 return atx2n(n2atx(tabaligned));
}

function nbtrue(t){
 var nt=0;
 var n=t.size;
 if(n<0){
  nt=(t ? 1 : 0 );
 }else{
  for(var i=1;i<=n;i++){
   if(t[i]){nt++}
  }
 }
 return nt;
}

function update_bigstr(){
 javascript vide(1);
 var str=tabop2str(topdrawnorder,topdrawninvariant)
 var strsc="javascript imprim('"+str+"',1);"
 script inline @strsc
}

function printfin(){

print tabop2str(topdrawnorder,topdrawninvariant)
}

function get3foraplane(tab){
var nat=tab.size;
var notfound=true;
var tol=0.01;
var iat=0;
while(notfound){
 iat++;
 notfound=abs(angle(tab[iat],tab[iat+1],tab[iat+2])-90)>90-tol;
 }
 return tab[iat][iat+2]
}

function maxdistaxe(tab){
var ia=tab[1];
var ib=tab[2];
 tab=n2atx(allaligned(ia,ib));
var tt=array();
var tmax=array();
var mymax=0;
 for(var ii=1;ii<=tab.size;ii++){
  tt=for(jj;tab;jj.distance(tab[ii]));
  tmax[ii]=tt.max;
 }
 mymax=tmax.max;
 for(var ii=1;ii<=tab.size;ii++){
  tt=for(jj;tab;jj.distance(tab[ii]));
  if(tt.max==mymax){
   ia=tab[ii];
   for(var kk=1;kk<=tab.size;kk++){
    if(abs(tab[kk].distance(ia)-mymax)<0.001){
     ib=tab[kk];
     var found=true;
     break;
    }
   }
  }
  if(found==true){break}
 }
 return {ia or ib}
}


function tabop2str(taborder,tabinvar){
 var bigstr="";
 if(taborder.size>0){
 bigstr=bigstr+taborder.size+"|";
 for(var iop=1;iop<=taborder.size;iop++){
  bigstr=bigstr+taborder[iop]+"_"
  var tt=atx2n(tabinvar[iop]);
  var nbinv=tt.size
  bigstr=bigstr+nbinv+"_";
  for(var iinv=1;iinv<nbinv;iinv++){
   bigstr=bigstr+tt[iinv]+"_";
  }
  if(iop==taborder.size){
   bigstr=bigstr+tt[nbinv];
  }else{
   bigstr=bigstr+tt[nbinv]+"|";
  }
 }
 }else{
  bigstr=bigstr+taborder+"_"
  var tt=atx2n(tabinvar);
  var nbinv=tt.size
  bigstr=bigstr+nbinv+"_";
  for(var iinv=1;iinv<nbinv;iinv++){
   bigstr=bigstr+tt[iinv]+"_";
  }
  bigstr=bigstr+tt[nbinv];
 }
 return bigstr;
}

function str2draw(str){
 var taborder=array();
 var tabinv=array();
 var tmp1=str.split("|");
 if(tmp1.size>1){
  var nb=tmp1[1];
  var decal=1;
 }else{
  var nb=1
  var decal=0;
 }
 for(var iop=1;iop<=nb;iop++){
  tmp2=tmp1[iop+decal].split("_");
  taborder[iop]=tmp2[1];
  tabinv[iop]=n2atx(tmp2[3][0]);
 }
 return [taborder tabinv];
}

function drawstrop(str,colo){
 var tmp=str2draw(str);
 var torder=tmp[1];
 var nb=torder.size;
 var tinv=tmp[2]
 for(var iop=1;iop<=nb;iop++){
  var ninv=tinv[iop].size;
  if(torder[iop]==-1){
    var lab="-1_0_";
    drawInversion(@{scInv*sizeop},colo)
  }
  if(torder[iop]==0){
    var sel=get3foraplane(tinv[iop]);
    drawMirror(sel,distMirror,@{scMirror*sizeop},colo)
  }
  if(torder[iop]>=2){
    var sel=maxdistaxe(tinv[iop]);
    print @{scAxe*sizeop}
    drawAxe(torder[iop],sel,distAxe,scAxe,colo)
  }
    nbdrawn++;
    topdrawnorder[nbdrawn]=torder[iop]
    topdrawninvariant[nbdrawn]=tinv[iop]
 }
}
 
function removedrawn(idraw){
 var str='op_'+tabop2str(topdrawnorder[idraw],topdrawninvariant[idraw])
 changecolordrawn(str,@colpoigneesop,0.0)
 hidedrawpt();
 
 var strsc='javascript maconfirm("Voulez vous supprimer cet élément de symmétrie",'+idraw+')';
 script inline @strsc ;
 }

function removedrawnok(idraw){
  var ats=tabptsdrawn[idraw];
  delete ats
  if(idraw<=nbdrawn && idraw>0){
   var tmpO=array()
   var tmpI=array()
   var tmpP=array()
   var inew=0;
   for(var idr=1;idr<=nbdrawn;idr++){
    if(idr==idraw){
     var lab='op_'+ tabop2str(topdrawnorder[idr],topdrawninvariant[idr])+'*'
     strsc='draw id "'+lab+'" delete'
     script inline @strsc
    }else{
     inew++ ;
     tmpO[inew]=topdrawnorder[idr]
     tmpI[inew]=topdrawninvariant[idr]
     tmpP[inew]=tabptsdrawn[idr]
    }
   }
   topdrawnorder=tmpO;
   topdrawninvariant=tmpI;
   tabptsdrawn=tmpP;
   nbdrawn=nbdrawn-1
  }
}
function removedrawncancel(idraw){
  var str='op_'+tabop2str(topdrawnorder[idraw],topdrawninvariant[idraw])
  if(topdrawnorder[idraw]==0){
   tr=translMirror;
  }else{
   tr=0.0;
  }
  changecolordrawn(str,@colpoignees,tr)
 }

function changecolordrawn(lab,colo,transl){
 var strsc='draw id "'+lab+'"* color '+colo +' translucent '+transl+' ;'
 strsc=strsc+'draw id "'+lab+'_border"* color '+colo +' translucent '+0.0+' ;'
 script inline @strsc
}

function getorder(iop){
 var descr=symop(iop,"description").split(" ")[1];
 if(descr[1]=="C"){
  return (1*descr[2]);
 }else{
  if(descr.find("bar")>0){
   return (-1*descr[1]);
  }else{
   if(descr=="inversion"){
    return -1
   }else{
    if(descr=="mirror"){
     return 0
    }else{
     if(descr=="identity"){
     return 1
     }
    }
   }
  }
 }
}
function buildreptabs(){
 var nbt=nbsommets+nbaretes+nbfaces;
 for(var i=1;i<=nbop;i++){
  reptaborder[i]=getorder(i);
  var tmp=n2atx(getinvariant(i));
  tmp={tmp and atomno<=nbt};
  reptabinvariant[i]=tmp;
 }
 getelem();
}

function drawrep(){
 resizeop();
 if(strgood != 0){ drawstrop(strgood,"green")};
 if(strbad != 0){ drawstrop(strbad,"red")};
 if(strforget != 0){ drawstrop(strforget,"orange")};
 set echo myechof [5 90%];font echo 18 serif bold;color echo orange;echo Oublié
 set echo myechob [5 85%];font echo 18 serif bold;color echo red;echo Incorrect
 set echo myechog [5 80%];font echo 18 serif bold;color echo green;echo Correct
}

function faceon(){
draw id face* on
}

function faceoff(){
draw id face* off
}

function colorAllFaces(colo,trans){
 faceon();
 draw id face* color @colo translucent @trans;
}

function effacedraw(){
hidepoignees()
 showdrawpt()
 set pickcallback "eff"
}

function effacedraw2(str){
 var sat=str.split(' ')[1];
  var iat={atomname=sat}.atomno;
  var xxat=n2atx(iat);
 var nbt=nbsommets+nbaretes+nbfaces;
 if(iat>nbt){
  for(var iop=1;iop<=nbdrawn;iop++){
   tpp=tabptsdrawn[iop];
   if({xxat and tpp}.size>0){
      removedrawn(iop);
      break;
    }
  }
 }
 set pickcallback none
 selectionhalos on;
 hidedrawpt()
 showpoignees(@colpoignees,sizeatome)
}

function ptsofdrawn(idr){
 var iorder=topdrawnorder[idr];
 var nbt=nbsommets+nbaretes+nbfaces;
 if(abs(iorder)>1 ){
  var sel=topdrawninvariant[idr];
 }else{
  if(iorder==-1 ){
   var sel={within(0.01,{0.0,0.0,0.0})};
  }else{
   var tab=get3foraplane(topdrawninvariant[idr]);
   var sel=within(0,plane,@{plane(tab[1],tab[2],tab[3])});
   sel={sel and atomno>nbt};
  }
 }
 return sel;
}

function allinplane(sel){
 var mysel=get3foraplane(sel);
 return within(0,plane,@{plane(mysel[1],mysel[2],mysel[3])});
}

function drawfa(ifa){
 var nbt=nbsommets+nbaretes+nbfaces;
 var sstart=debfaces(ifa);
 var send=debfaces(ifa+1);
 var tsn=tsommets[sstart+1][tsend];
 var mysel=allinplane(n2atx(tsn));
 mysel={mysel and atomno<nbt};
 var ptcent={mysel}.xyz;
 }


function getelem(){
 var already=array();
  already[1]=true;
 var centrosym=false;
 var nbelem=1

 for(var iop=2;iop<=nbop;iop++){
  if(reptaborder[iop]==-1){
   centrosym=true;
  }
  already[iop]=false;
 }
 if(centrosym){
  for(var iop=2;iop<=nbop;iop++){reptaborder[iop2]=abs(reptaborder[iop2])}
 }
 for(var iop=2;iop<=nbop;iop++){
  if(! already[iop]){
   repelem[nbelem]=iop;
   var inv=reptabinvariant[iop];
   var sz=inv.size;
   var io=reptaborder[iop];
   for(var iop2=iop+1;iop2<=nbop;iop2++){
    if(! already[iop2]){
     var inv2=reptabinvariant[iop2];
     var sz2=inv2.size;
     if(sz==sz2){
      var mysel={inv and inv2}
      if(mysel.size==sz){
       var io2=reptaborder[iop2];
       if(centrosym){
        if(io2>io){
         repelem[nbelem]=iop2;
        }
       }else{
        if(io2<0){
         if(abs(io2)>abs(io)){
          repelem[nbelem]=iop2;
         }
        }
       }
       already[iop2]=true;
      }
     }
     already[iop]=true;
    }
   }
   nbelem=nbelem+1;
  }
 }
}

function onlyelem(t,e){
 var t2=array();
 for (var i=1;i<=e.size;i++){
  t2[i]=t[e[i]];
 }
 return t2;
}

function maxdistaxe2(sel){
 var nbt=nbsommets+nbaretes+nbfaces;
 return {sel and atomno<=nbt}
}

function allaligned2(s1,s2){
 var nbt=nbsommets+nbaretes+nbfaces;
 var sel=n2atx(allaligned(s1,s2));
 sel={sel and atomno<=nbt};
 return atx2n(sel)
}

function updateallfaces(){
  strsc='';
 for(var ifa=1;ifa<=nbfaces;ifa++){
  strsc=strsc+'draw id "face_'+ifa+'_*" color '+tcolorface[ifa]+' translucent '+ttransp[ifa]+' ;'
 }
 script inline @strsc ;
}

function mataille(){
var tt=for(aa;{*};aa.distance({0,0,0}))
return tt.max;
}

function hidedrawpt(){
 var nbt=nbsommets+nbaretes+nbfaces;
 var nbt1=nbt+1
 {atomno<=nbt}.spacefill=sizeatome
 select atomno>nbt;
 spacefill 0.00;
 color halos @colpoignees
select none;
}
function showdrawpt(){
 var nbt=nbsommets+nbaretes+nbfaces;
 var sf=sizeatome*2
 select atomno>nbt;
 spacefill @sf
 color atoms @colpoigneesop
 color halos @colpoigneesop
select none;
}
function printrep(){
 buildreptabs();
 for(var i=1;i<=repelem.size;i++){print 'opnum :'+i+'  order:'+reptaborder[repelem[i]]+'  inv :'+reptabinvariant[repelem[i]]}
}
