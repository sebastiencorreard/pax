distMirror=0.3;
scMirror=1.2;
colorMirror="purple"
if(! translMirror>0){translMirror=0.8}
distAxe=2.3;
scAxe=0.7;
colorAxe="purple"
scInv=5.0;
colorInv="purple"
colpoignees="purple"
colpoigneesop="yellow"
colhalos="purple"
nbdrawn=0;
reptabinvariant=array();
reptaborder=array();
repelem=array()
topdrawninvariant=array();
topdrawnorder=array();
tabptsdrawn=array();
listnotdel=array();
set appendnew false;

function drawfacetab(tab,style,colorface,coloredge){
 if(style.find("opaque","i")>0){
  transl=0.0;
 }else{
  if(style.find("none","i")>0){
    transl=1.0;
  }else{
   if(style.find("trans","i")>0){
    transl=0.5;
   }else{
    transl=0.0+style;
   }
  }
 }
 sall="({"+(tab[1]-1)+" ";
 s1=sall+"})";
 s2="({"+(tab[2]-1)+"})";
 connect @s1 @s2 single create;

 for(s=2;s<tab.size;s++){
  sall=sall+" "+(tab[s]-1);
  s2="({"+(tab[s]-1)+"})";
  s3="({"+(tab[s+1]-1)+"})";
  ch_face="face_"+tab[1]+"_"+tab[s]+"_"+tab[s+1];
  connect @s2 @s3 single create;
  
  draw ID @ch_face  @s1 @s2 @s3 color @colorface translucent @transl;
 }
 s2="({"+(tab[0]-1)+"})";
 connect @s1 @s2 single create;

 sall=sall+" "+(tab[0]-1)+"})";
 select sall; color bonds @coloredge ;
}



function myface (numface,colorbords,colorface){
 sel=tabface[numface]
 select sel;
 color bonds @{colorbords};
 nbvert={sel}.size;
 tabvert=array({sel}[1]);
 voisins={sel} and connected(tabvert[1]);
 tabvert+={voisins}[1];
 last={voisins}[2];

 ch_fa="face_"+numface;

 for(var i=2;i<nbvert;i++){
  tabvert+={sel} and connected(tabvert[i]) and not tabvert[i-1];
  ch_face=ch_fa+"_"+@{i-1};
  draw @ch_face 0 @{tabvert[1]} @{tabvert[i]} @{tabvert[i+1]} color @colorface
 }
}

function sym(op,at){
 var atx=n2atx(at);
 var temp=all.symop(op,@atx);
 atx=within(0.0001,@temp);
 if(atx.size>0){
  return atx2n(atx);
 }else{
   return " ";
 }
}

function symtab(op,tab){
 var tim=array();
 for(nat=1;nat<=tab.size;nat++){
  tim+=sym(op,tab[nat]);
 }
 return tim;
}

function tabsym(tabop,at){
 var tim=array();
 for(iop=1;iop<=tabop.size;iop++){
  op=tabop[iop];
  tim+=sym(op,at);
 }
 return tim;
}

function atx2n(chat){
 tabnumat=for(xx;{chat};xx.atomno)
/* var sz=(@chat).size;
 var tabnumat=array();
 chat=""+chat;
 chat=chat[3][-2];
 if(sz >1){
  tabnumat= chat.split(" ");
 }else{
  tabnumat[1]= chat.;
 }
 for(var i=1;i<=sz;i=i+1){
  tabnumat[i]=@{tabnumat[i]+1};
 }*/
 return tabnumat;
}
function n2atx(tabnumat){
 var old={selected}
 select none;
 if(tabnumat.size<0){
  expr={atomno=tabnumat}
 }else{
  for(var i=1;i<=tabnumat.size;i++){
   ii=tabnumat[i];
   select {selected} or atomno=ii 
  };
  expr={selected}
 }
 select old ;
 return expr;
}
function isinvariant(op,tab){
 var tim=array();
 for(nat=1;nat<=tab.size;nat++){
  temp1=tab[nat];
  temp2=sym(op,temp1);
  temp1=n2atx(temp1)
  temp2=n2atx(temp2)
  if(temp2==temp1){
   tim+=TRUE;
  }else{
   tim+=FALSE;
  }
 }
 return tim;
}
function alltrue(tab){
 var b=true;
 for(i=1;i<=tab.size;i++){
  b=b & tab[i] ;
 }
 return b;
}
function sommetsOfArete(a){
 if(a>nbsommets){
  s1=tsommets[taretes[a-nbsommets]];
  s2=tsommets2[taretes[a-nbsommets]];
  return [s1 s2];
 }else{
  return "";
 }
}
function drawpoly(){
 connect (*) (*) delete;
 for(fa=1;fa<=nbfaces;fa++){
  drawface(fa,ttransp[fa]);  
 }
 select all;
 color atoms @atomecolor;
 wireframe @sizearete;
 hideclic(hidec);
# spacefill @sizeatome;
}
function drawface(nf,style){
 deb=debfaces[nf]+1;
 fin=debfaces[nf+1];
 tab=tsommets[deb][fin];
 colorf=tcolorface.lines[nf];
 colore=tcoloredge.lines[nf];
 drawfacetab(tab,style,colorf,colore);
}
function drawSelectedOp(){
 tab={selected};
 dim=tab.size;
 if(dim==2){
  draw ID drawnOp 200 {@tab[1]} {@tab[2]};
 }else{
  if(dim==3){
   draw ID drawnOp 300  {@tab[1]} {@tab[2]} {@tab[3]};
  }
 }
}
function myload(a,b,c,al,be,ga,spgr){
 load "" {555 555 0} SPACEGROUP @spgr unitcell {@a @b @c @al @be @ga};
 unitcell off;
 set axes off;
}
function hideclic(type){
# 1 : Sommets
# 2 : Aretes
# 4 : Faces
 select all;spacefill @sizeatome
 if(type%2==1){
  select _S;spacefill 0.0;
  type=type-1;
 }
 if(type%4==2){
  select _Ar;spacefill 0.0;
  type=type-2;
 }
 if(type==4){
  select _F;spacefill 0.0;
  type=type-2;
 }
 select none;
}
function changealltransp(type){
 for(ifa=1;ifa<ttransp.size;ifa=ifa+1){ttransp[ifa]=type;}
}
function allequiv(nat){
 tabequiv=array();
 for(var i=1;i<=nbsymop;i++){
  tabequiv=tabequiv+sym(@i,nat);
 }
 return tabequiv
}
function loadvarsop(){
 nbA2=0;
 nbA3=0;
 nbA4=0;
 nbA6=0;
 nbm=0;
 nbi=0;
 tabA2=array();
 tabA3=array();
 tabA4=array();
 tabA6=array();
 tabm=array();
 tabi=array();
 ch_space=script("show spacegroup").lines
  ch_space=ch_space.replace("C2 axis","|Rotation d\'ordre 2")
  ch_space=ch_space.replace("C3 axis","|Rotation d\'ordre 3")
  ch_space=ch_space.replace("C4 axis","|Rotation d\'ordre 4")
  ch_space=ch_space.replace("C6 axis","|Rotation d\'ordre 6")
  ch_space=ch_space.replace("inversion center","|Inversion")
  ch_space=ch_space.replace("mirror plane","|Réflexion")
 nbsymop=ch_space.find("symmetry operations").split(" ")[1]
 temp=1-nbsymop;
 tabsymop=ch_space[temp][0];
 var tabgrpop=array()
 for(var i=1;i<=nbsymop;i++){
  tabgrpop=symop(i,'array');
  if(tabgrpop[3].find("C2")>0){
   nbA2++;
   tabA2[nbA2]=i;
  }
  if(tabgrpop[3].find("C3")>0){
   nbA3++;
   tabA3[nbA3]=i;
  }
  if(tabgrpop[3].find("C4")>0){
   nbA4++;
   tabA4[nbA4]=i;
  }
  if(tabgrpop[3].find("C6")>0){
   nbA6++;
   tabA6[nbA6]=i;
  }
  if(tabgrpop[3].find("mirror")>0){
   nbm++;
   tabm[nbm]=i;
  }
  if(tabgrpop[3].find("inversion")>0){
   nbi++;
   tabi[nbi]=i;
  }
 }
}
function showsallop(){
 for(var iop=2;iop<=nbop;iop++){
 shows1op(iop);
  delay 2 ;
 }
}

function shows1op(iop){
 tabdeb=array();
 tabfin=array();
 tabstep=array();
 var nbstep=10;
  strop=tabsymop[iop]
  echo @strop
  if (symop(iop,"description").find("axis","v")){
   tabdeb=for(vx;{*};vx.xyz);
   tabfin=for(vx;{*};symop(iop,vx));
   tabstep=for(vx;{*};(symop(iop,vx)-vx.xyz)/(nbstep));
    for(var iat=1;iat<=tabstep.size;iat++){
     select {*}[iat];
     if({selected}.elemno=16){
      p1=point(tabdeb[iat])
      p2=point(tabfin[iat])
      strdraw='draw id line'+@iat+' width 0.01 color black '+@p1+' '+@p2
      delay 0.02
      script inline @strdraw
     }
    }
 delay 1
   for(var ii=0;ii<nbstep;ii++){
    for(var iat=1;iat<=tabstep.size;iat++){
     select {*}[iat];
     translateSelected  @{tabstep[iat]}
    }
    delay 0.1
   }
#  drawpoly();
  } else {
  select all; spin symop @{iop} 140 ;
  }
 delay 2
 draw id line* delete;
}
function getinvariant(iop){
 var tabdeb=array();
 var tabfin=array();
 var tabinvar=array();
 var vx={*}
 var wx={*}
   tabdeb=for(wx;{*};wx.xyz);
   var io=getorder(iop)
   if(io<-1){
    tabfin=for(vx;{*};-symop(iop,vx));
   }else{
    tabfin=for(vx;{*};symop(iop,vx));
   }
    for(var iat=1;iat<=tabdeb.size;iat++){
     if(distance(tabdeb[iat],tabfin[iat])<0.01){
       tabinvar=tabinvar+@iat;
  }
 }
 return tabinvar;
}
function drawplane(tabat){
var tabxyz=array()
var mysel=n2atx(tabat);
var strspt='';
var ii=0;
tabxyz=for(vx;@mysel;vx.xyz);
tabxyz=tabmultscal(tabxyz,1.3);
 for(var it1=1;it1<tabxyz.size;it1++){
  for(var it2=it1+1;it2<=tabxyz.size;it2++){
   ii++;
   strspt='draw id platom'+ii+' @{tabxyz[it1]}  @{tabxyz[it2]} {0.0,0.0,0.0}';
   script inline @strspt ;
}
}
}

function normvec(vec){
 if(vec.size<0){
  return sqrt(vec.x*vec.x+vec.y*vec.y+vec.z*vec.z);
 }else{
  var tn=array();
  for(var it=1;it<=vec.size;it++){
   tn[it]=sqrt(vec[it].x*vec[it].x+vec[it].y*vec[it].y+vec[it].z*vec[it].z);
  }
  return tn;
 }
}

function tabmulttab(t1,t2){
  tm=array();
 if(t1.size<t2.size){minsize=t1.size}else{minsize=t2.size}
 for(var it=1;it<=minsize;it++){
  tm[it]=t1[it]*t2[it];
 }
 return tm;
}

function tabdivtab(t1,t2){
  td=array();
 if(t1.size<t2.size){minsize=t1.size}else{minsize=t2.size}
 for(var it=1;it<=minsize;it++){
  td[it]=t1[it]*1.0/t2[it];
 }
 return td;
}

function tabmultscal(tab,scal){
 for(var it=1;it<=tab.size;it++){
  tab[it]=tab[it]*scal;
 }
  return tab;
}

function crossprod(v1,v2){
 return point(v1.y*v2.z-v2.y*v1.z, v1.z*v2.x-v2.z*v1.x, v1.x*v2.y-v2.x*v1.y)
}

function sumtab(tab){
var sumt=0;
 for(var it=1;it<=tab.size;it++){
  sumt=sumt+tab[it]
 }
  return sumt;
}

function cbetweenab(a,b,c,centr){
var tol=0.1
 return abs(angle(a,centr,c)+angle(b,centr,c)-angle(a,centr,b))<tol
}

function drawcross(p,sz,lab){
hg=point(-sz,sz,0);
hd=point(sz,sz,0);
bg=point(-sz,-sz,0);
bd=point(sz,-sz,0);
sz=sz/2;
p1=p-hg;
p2=p-bd;
p3=p-hd;
p4=p-bg;
strscr ='draw id '+lab+'_1 width @sz color black @p1 @p2 '
script inline @strscr
strscr ='draw id '+lab+'_2 width @sz color black @p3 @p4 '
script inline @strscr
}
 
function drawcirc(p,sz,lab){
sz=sz*2.2
strscr ='draw id '+lab+'_1 circle @p diameter @sz ;draw id '+lab+'_1 color [4,4,4]'
script inline @strscr
sz=sz*0.70
strscr ='draw id '+lab+'_2 circle color white @p diameter @sz fill'
script inline @strscr
}
function drawprojst(sz){
 draw id cerclwulf color black circle {0 0 0} {0 0 1} diameter @{2*sz} mesh nofill
 for(var i=1;i<=tprojst.size;i++){
  if(tprojstup[i]){
   strscr='drawcross('+tprojst[i]*@sz+','+@{sz/25}+',"stfa'+i+'")'; 
  }else{
   strscr='drawcirc('+tprojst[i]*@sz+','+@{sz/20}+',"stfa'+i+'")'; 
  }
  script inline @strscr
 }
}

function ortho(pos){
var u=pos.x;
var v=pos.y;
var w=pos.z;
if(w!=0.0){
var y1=1.0
var z1=-v/w
var n1=sqrt(1+z1*z1);
}else{
var y1=0.0
var z1=1.0
var n1=1.0}
var oh1=point(0.0,@y1/@n1,@z1/@n1)
var x2=v*z1-w*y1
var y2=-u*z1
var z2=u*y1
var n2=sqrt(x2*x2+y2*y2+z2*z2);
var oh2=point(@x2/@n2,@y2/@n2,@z2/@n2)
var tortho=array(@oh1,@oh2)
return tortho
}

function draweye(normal,pos,sc,colo,lab){
var tortho=ortho(normal);
var oh1=tortho[1]*sc/(2.5);
var oh2=tortho[2]*sc/1.0;
sc=sc/5.0;
var oh1p=oh1+pos
var oh1m=pos-oh1
var oh2p=oh2+pos
var oh2m=pos-oh2
var strscr='draw id "'+lab+'eye1" width '+sc+' color '+colo+' curve '+@oh2m+' '+@oh1p+' '+@oh2p+';'
script inline @strscr
 strscr='draw id "'+lab+'eye2" width '+sc+' color '+colo+' curve '+@oh2m+' '+@oh1m+' '+@oh2p+';'
script inline @strscr
}

function drawtri(normal,pos,sc,colo,lab){
var tortho=ortho(normal);
var oh1=tortho[1]*sc;
var oh2=tortho[2]*sc*(2.0);
sc=sc/5.0;
var h=sqrt(3)/2.0
var t1=pos+oh1/1.0-oh2*sqrt(3)/6.0
var t2=pos+oh2*sqrt(3)/3.0
var t3=pos-oh1/1.0-oh2*sqrt(3)/6.0
var strscr='draw id "'+lab+'tri1" width '+sc+' color '+colo+' '+@t1+' '+@t2+';'
script inline @strscr
var strscr='draw id "'+lab+'tri2" width '+sc+' color '+colo+' '+@t2+' '+@t3+';'
script inline @strscr
var strscr='draw id "'+lab+'tri3" width '+sc+' color '+colo+' '+@t3+' '+@t1+';'
script inline @strscr
}

function drawcerc(normal,pos,sc,colo,lab){
 var tortho=ortho(normal);
 var oh1=tortho[1]*sc/2.5;
 var oh2=tortho[2]*sc/2.5;
 sc=sc/5.0;
 var strcurv='draw id "'+lab+'cerc" width '+sc+' color '+colo+' curve'
 for(ang=0;ang<=360;ang=ang+30){
  var c=cos(ang);
  var s=sin(ang);
  var p=pos+oh1*c+oh2*s;
  strcurv=strcurv+" "+p;
 }
 strcurv=strcurv+";"
 script inline @strcurv
}

function drawtribar(normal,pos,sc,colo,lab){
 drawtri(normal,pos,sc,colo,lab);
 drawcerc(normal,pos,sc,colo,lab);
}

function drawsq(normal,pos,sc,colo,lab){
var tortho=ortho(normal);
var oh1=tortho[1]*sc/1.0;
var oh2=tortho[2]*sc/1.0;
sc=sc/5.0;
var ed1=pos+oh1;
var ed2=pos+oh2;
var ed3=pos-oh1;
var ed4=pos-oh2
var strscr='draw id "'+lab+'sq1" width '+sc+' color '+colo+' '+@ed1+' '+@ed2+';'
script inline @strscr
var strscr='draw id "'+lab+'sq2" width '+sc+' color '+colo+' '+@ed2+' '+@ed3+';'
script inline @strscr
var strscr='draw id "'+lab+'sq3" width '+sc+' color '+colo+' '+@ed3+' '+@ed4+';'
script inline @strscr
var strscr='draw id "'+lab+'sq4" width '+sc+' color '+colo+' '+@ed4+' '+@ed1+';'
script inline @strscr
}

function drawhex(normal,pos,sc,colo,lab){
var tortho=ortho(normal);
var oh1=tortho[1]*sc*(1.0);
var oh2=tortho[2]*sc*(2.0);
sc=sc/5.0;
var h=sqrt(3)/2.0
var t1=pos+oh1/1.0-oh2*sqrt(3)/6.0
var t2=pos+oh1/1.0+oh2*sqrt(3)/6.0
var t3=pos+oh2*sqrt(3)/3.0
var t4=pos-oh1/1.0+oh2*sqrt(3)/6.0
var t5=pos-oh1/1.0-oh2*sqrt(3)/6.0
var t6=pos-oh2*sqrt(3)/3.0
var strscr='draw id "'+lab+'hex1" width '+sc+' color '+colo+' '+@t1+' '+@t2+';'
script inline @strscr
var strscr='draw id "'+lab+'hex2" width '+sc+' color '+colo+' '+@t2+' '+@t3+';'
script inline @strscr
var strscr='draw id "'+lab+'hex3" width '+sc+' color '+colo+' '+@t3+' '+@t4+';'
script inline @strscr
var strscr='draw id "'+lab+'hex4" width '+sc+' color '+colo+' '+@t4+' '+@t5+';'
script inline @strscr
var strscr='draw id "'+lab+'hex5" width '+sc+' color '+colo+' '+@t5+' '+@t6+';'
script inline @strscr
var strscr='draw id "'+lab+'hex6" width '+sc+' color '+colo+' '+@t6+' '+@t1+';'
script inline @strscr
}

function addextat(pt1,pt2,sc,colo,lab){
 var strat='data "append ex"|2||';
 strat=strat+'X ';
 strat=strat+pt1.x+' '+pt1.y+' '+pt1.z+' |';
 strat=strat+'X ';
 strat=strat+pt2.x+' '+pt2.y+' '+pt2.z+' |';
 strat=strat+'end "append ex"';
 script inline @strat;
 selectionhalos on;
 select within(0.001,pt1) or within(0.001,pt2);
 color atoms @colo
 connect ({selected}) (*) delete;
 spacefill 0.0;
 tabptsdrawn[nbdrawn]={selected};
 select none;
}

function addcenter(sc,colo,lab){
 var strat='data "append ex"|1||';
 strat=strat+'X 0.0 0.0 0.0 |';
 strat=strat+'end "append ex"';
 script inline @strat;
 selectionhalos on;
 select within(0.001,{0,0,0}) 
 color atoms "grey";
 connect ({selected}) (*) delete;
 spacefill 0.0;
 tabptsdrawn[nbdrawn]={selected};
 select none;
}
function drawA2(p1,p2,dist,sc,colo,lab){
 dir=p2-p1;
 d1=distance(p2,p1);
 dir=dir/d1
 pt1=p1-dir*dist
 pt2=p2+dir*dist
 addextat(pt1,pt2,sc,colo,lab)
 draweye(dir,pt1,sc,colo,lab+'1_')
 draweye(dir,pt2,sc,colo,lab+'2_')
 strsc='draw id "'+lab+'axe" width '+@{sc/5.0}+' color '+colo+' '+@pt1+' '+@pt2
 script inline @strsc
}

function drawA3(p1,p2,dist,sc,colo,lab){
 dir=p2-p1;
 d1=distance(p2,p1);
 dir=dir/d1
 pt1=p1-dir*dist
 pt2=p2+dir*dist
 addextat(pt1,pt2,sc,colo,lab)
 drawtri(dir,pt1,sc,colo,lab+'1_')
 drawtri(dir,pt2,sc,colo,lab+'2_')
 strsc='draw id "'+lab+'axe" width '+@{sc/5.0}+' color '+colo+' '+@pt1+' '+@pt2
 script inline @strsc
}

