 showpoignees(@colpoignees,0.0);
}

function showpoignees(colo,sz){
 showsommets(colo,sz);
 showaretes(colo,sz);
 showfaces(colo,sz);
}

function showsommets(colo,sz){
 var savesel={(selected)};
 select (_S);
print sz
 spacefill @sz ;
