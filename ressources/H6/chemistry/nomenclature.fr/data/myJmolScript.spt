 dir=p2-p1;
 d1=distance(p2,p1);
 dir=dir/d1
 pt1=p1-dir*dist
 pt2=p2+dir*dist
 addextat(pt1,pt2,sc,colo,lab)
 drawsq(dir,pt1,sc,colo,lab+'1_')
