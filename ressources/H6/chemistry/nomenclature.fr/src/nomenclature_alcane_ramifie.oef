\title{Nomenclature des alcanes ramifiés}
\author{Benoit, Markey}
\mail{benoit.markey@ac-lille.fr}
\text{pref=méth,éth,prop,but,pent,hex,hept,oct}
\text{suf=ane}
\integer{j=randint(3..8)}


\if{\j=4}{
\integer{tir=randint(1..2)}
\if{\tir=1}{
\integer{n=ceil(\j/2)}
\text{K=}
\for{i=1 to \n}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i2=\n+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\text{nom1=méthyl\pref[\j]\suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
\if{\tir=2}{
\integer{n=ceil(\j/2)}
\integer{m=randint(\n..\j-1)}
\text{K=}
\for{i=1 to \n}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i2=\n+1 to \m}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i3=\m+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\integer{p=\j-\n+1}
\integer{q=\j-\m+1}
\text{nom1=\q,\p-diméthyl\pref[\j]\suf}
\if{\n=\m}{
\text{nom1=\n,\n-diméthyl\pref[\j]\suf}
}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
}

\if{\j>4}{
\integer{tir=randint(1..3)}

\integer{n=ceil(\j/2)-1}
\if{\tir=1}{

\text{K=}
\for{i=1 to \n}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i2=\n+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\text{nom1=\n-méthyl\pref[\j]\suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
\if{\tir=2}{

\integer{m=randint(\n..\j-2)}
\text{K=}
\for{i=1 to \n}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i2=\n+1 to \m}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i3=\m+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\integer{p=\j-\n+1}
\integer{q=\j-\m+1}

\text{nom1=\n,\m-diméthyl\pref[\j]\suf}
\if{\n=\m}{
\text{nom1=\n,\n-diméthyl\pref[\j]\suf}
}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
\if{\tir=3}{
\integer{m=randint(3..4)}
\if{\j=5 or \j=6}{\integer{m=3}}
\text{K=}
\for{i=1 to \m}{
\text{K=\K C}
}
\text{K=\K(CC)}
\for{i2=\m+1 to \j}{
\text{K=\K C}
}

\text{mol=slib(text/whitespace ,,\K)}

\text{nom1=\m-éthyl\pref[\j]\suf}

\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
}

\if{\j<4}{
\integer{n=ceil(\j/2)}
\text{K=}
\for{i=1 to \n}{
\text{K=\K C}
}
\text{K=\K(C)}
\for{i2=\n+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\text{nom1=méthyl\pref[\j]\suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}

\statement{<div class="wims_question">Quel est le nom de cette molécule?</div>
<div class="wimscenter">\B</div>
<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>
}
\answer{Nom=}{\nom1}{type=raw}{option=nospace}
