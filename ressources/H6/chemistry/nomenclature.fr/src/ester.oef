\title{Nomenclature des esters}
\author{Benoit, Markey}
\mail{benoit.markey@ac-lille.fr}
\text{pref1=méthan,éthan,propan,butan,pentan,hexan,heptan,octan}
\text{suf1=oate}
\integer{j1=randint(1..8)}
\text{pref2=méth,éth,prop,but,pent,hex,hept,oct}
\text{suf2=yle}
\integer{j2=randint(1..8)}



\text{nom1=\pref1[\j1] \suf1 }
\text{nom1bis=slib(text/whitespace ,,\nom1)}

\text{nom2=\pref2[\j2] \suf2}
\text{nom2bis=slib(text/whitespace ,,\nom2)}


\text{nom3=\nom1bis de \nom2bis}
\text{nom=slib(lang/frapostrophe \nom3)}

\text{K=}
\for{i=1 to \j1-1}{
\text{K=\K C}
}
\text{K=\K C(=O)O}
\for{i2=1 to \j2}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}



\statement{<div class="wims_question">Quel est le nom de cette molécule?</div>
<div class="wimscenter">\B</div>
<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>
}
\answer{Nom=}{\nom}{type=atext}
