\title{Nomenclature des alcools}
\author{Benoit, Markey}
\mail{benoit.markey@ac-lille.fr}
\text{pref=méthan,éthan,propan,butan,pentan,hexan,heptan,octan}
\text{suf=ol}
\integer{j=randint(1..8)}


\if{\j=1 or \j=2}{
\text{nom1=\pref[\j] \suf}
\text{nom2=\pref[\j]-1- \suf}
\text{nom=slib(text/whitespace ,,\nom1)|slib(text/whitespace ,,\nom2)}
\text{K=}
\for{i=1 to \j}{
\text{K=\K C}
}
\text{K=\K(O)}
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
{---------------icij>2--------------
\integer{n=floor(\j/2)}
\integer{p=randint(1..\n)}
\text{nom1=\pref[\j]-\p-\suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{K=}
\for{i=1 to \p}{
\text{K=\K C}
}
\text{K=\K(O)}
\for{i2=\p+1 to \j}{
\text{K=\K C}
}

\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}

\statement{<div class="wims_question">Quel est le nom de cette molécule?</div>
<div class="wimscenter">\B</div>
<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>

}
\answer{Nom=}{\nom}{type=atext}
