\title{Nomenclature des amines}
\author{Benoit, Markey}
\mail{benoit.markey@ac-lille.fr}
\text{pref=méth,éth,prop,but,pent,hex,hept,oct}
\text{pref_num=5,2,8,1,7,4,3,6} #ordre alphabétique des prefixes: utile pour nomme les amines tertiaires (n=3)
\text{suf=amine}
\integer{n=randint(1..3)}

--------------n=1------------------
\if{\n=1}{
\integer{j=randint(1..8)}

\if{\j=1 or \j=2}{
\text{nom1=\pref[\j] an \suf}
\text{nom2=\pref[\j] an -1- \suf}
\text{nom=slib(text/whitespace ,,\nom1)|slib(text/whitespace ,,\nom2)}
\text{K=}
\for{i=1 to \j}{
\text{K=\K C}
}
\text{K=\K N }
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
{---------------icij>2--------------
\integer{n1=floor(\j/2)}
\integer{p=randint(1..\n1)}
\text{nom1=\pref[\j] an-\p-\suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{K=}
\for{i=1 to \p}{
\text{K=\K C}
}
\text{K=\K (N)}
\for{i2=\p+1 to \j}{
\text{K=\K C}
}

\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
}

-----------------n=2--------------------
\if{\n=2}{
\text{pref1=N-}
\text{suf2=yl}
\integer{j=randint(2..8)}
\integer{k=randint(1..\j-1)}


\if{\j=1 or \j=2}{
\text{nom1=\pref1 \pref[\k] \suf2 \pref[\j] an \suf}
\text{nom2=\pref1 \pref[\k] \suf2 \pref[\j] an -1- \suf}
\text{nom=slib(text/whitespace ,,\nom1)|slib(text/whitespace ,,\nom2)}
\text{K=}
\for{i=1 to \j}{
\text{K=\K C}
}
\text{K=\K N }
\for{i2=1 to \k}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
{---------------icij>2--------------
\integer{n2=floor(\j/2)}
\integer{p=randint(1..\n2)}
\text{nom1=\pref1 \pref[\k] \suf2 \pref[\j] an -\p- \suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{K=}
\for{i=1 to \p}{
\text{K=\K C}
}
\text{K2= N }
\for{i2=1 to \k}{
\text{K2=\K2 C}
}
\text{K=\K (\K2)}
\for{i3=\p+1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}
}
}

-------------n=3-----------
\if{\n=3}{
\text{suf2=yl}
\integer{j=randint(2..8)}

\integer{k=randint(2..\j-1)}
\integer{l=randint(2..\k-1)}


\integer{n2=floor(\j/2)}
\integer{p=randint(1..\n2)}
\text{K1=}
\text{K2=}
\text{K3=}
\text{K4=}
\for{i=1 to \p}{
\text{K1=\K1 C}
}
\for{i4=\p+1 to \j}{
\text{K4=\K4 C}
}
\for{i2=1 to \k}{
\text{K2=\K2 C}
}

\for{i3=1 to \l}{
\text{K3=\K3 C}
}
\text{K=\K1(\K4)N(\K3)(\K2)}
\text{mol=slib(text/whitespace ,,\K) }
\text{B=slib(chemistry/jmolshow @\mol,500,400)}

\if{\k=\l}{
\text{nom1=N-di \pref[\k] \suf2 \pref[\j] an -\p- \suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{nom=N,\nom}}
{
#rangement par ordre alphabétique#####
\if{\pref_num[\l]<\pref_num[\k]}{
\text{nom1=N-\pref[\l] \suf2 - N-\pref[\k] \suf2 \pref[\j] an -\p- \suf}
}{
\text{nom1=N-\pref[\k] \suf2 - N-\pref[\l] \suf2 \pref[\j] an -\p- \suf}
}
\text{nom=slib(text/whitespace ,,\nom1)}
}
\if{\j=1 or \j=2}{
\text{nom2=N-\pref[\k] \suf2 - N-\pref[\l] \suf2 \pref[\j] an \suf}
\text{nom=slib(text/whitespace ,,\nom1)|slib(text/whitespace ,,\nom2)}
}
}


\statement{
<div class="wims_question">Quel est le nom de cette molécule?</div>
<div class="wimscenter">\B</div>
<div class="wims_instruction">ATTENTION aux accents, à l'orthographe et aux tirets.
<ul>
<li>
  L'atome représenté en bleu est un atome d'azote (symbole N).
</li>
<li>
  On écrira le nom de cette molécule sans mettre d'espace entre les différents caractères.
</li>
<li>Les ramifications sur l'amine (quand il y en a plus d'une) sont normalement listées dans l'ordre alphabétique selon IUPAC
</li>
</ul>
</div>
}
\answer{Nom=}{\nom}{type=atext}