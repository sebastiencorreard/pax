\title{Nomenclature des alcanes (correspondance)}
\author{Benoit, Markey}
\mail{benoit.markey@ac-lille.fr}
\text{pref=méth,éth,prop,but,pent,hex,hept,oct}
\text{suf=ane}

---------------tirage molecule 1----------------
\integer{j=randint(2..7)}
\text{nom1=\pref[\j] \suf}
\text{nom=slib(text/whitespace ,,\nom1)}
\text{K=}
\for{i=1 to \j}{
\text{K=\K C}
}
\text{mol=slib(text/whitespace ,,\K)}
\text{A=slib(chemistry/jmolshow @\mol,250,200,,,0)}

---------------tirage molecule 2----------------
\integer{jbis=randint(1..\j-1)}
\text{nom1bis=\pref[\jbis] \suf}
\text{nombis=slib(text/whitespace ,,\nom1bis)}
\text{Kbis=}
\for{ibis=1 to \jbis}{
\text{Kbis=\Kbis C}
}
\text{molbis=slib(text/whitespace ,,\Kbis)}
\text{Abis=slib(chemistry/jmolshow @\molbis,250,200,,,1)}

---------------tirage molecule 3----------------
\integer{jter=randint(\j+1..8)}
\text{nom1ter=\pref[\jter] \suf}
\text{nomter=slib(text/whitespace ,,\nom1ter)}
\text{Kter=}
\for{iter=1 to \jter}{
\text{Kter=\Kter C}
}
\text{molter=slib(text/whitespace ,,\Kter)}
\text{Ater=slib(chemistry/jmolshow @\molter,250,200,,,2)}



\statement{<div class="wims_question">Retrouver le nom de chaque molécule.</div>

<table class="wimsborder wimscenter">
<tr><th>molécule 1</th><th>molécule 2</th><th>molécule 3</th></tr>
<tr><td>\A</td><td>\Abis</td><td>\Ater</td></tr>
<tr><td>\embed{reply1,120}</td><td>\embed{reply2,120}</td><td>\embed{reply3,120}</td></tr>
</table>
}

\answer{Réponse1 }{1;\nom, \nombis, \nomter }{ type=menu }{option=shuffle}
\answer{Réponse2 }{2;\nom, \nombis, \nomter }{ type=menu }{option=shuffle}
\answer{Réponse3 }{3;\nom, \nombis, \nomter }{ type=menu }{option=shuffle}
