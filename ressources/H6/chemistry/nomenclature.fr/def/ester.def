!set title=Nomenclature des esters
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit, Markey

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=méthan,éthan,propan,butan,pentan,hexan,heptan,octan
val7=oate
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
val9=méth,éth,prop,but,pent,hex,hept,oct
val10=yle
tmp0=!randint 1, 8

val11=$[rint($(tmp0))]
val12=$(val6[$val8]) $val7 
!readproc slib/text/whitespace ,,$val12 
tmp0=$slib_out
val13=$(tmp0)
val14=$(val9[$val11]) $val10
!readproc slib/text/whitespace ,,$val14 
tmp0=$slib_out
val15=$(tmp0)
val16=$val13 de $val15
!readproc slib/lang/frapostrophe $val16 
tmp0=$slib_out
val17=$(tmp0)
val18=
!for val19 =1 to $val8-1 
val18=$val18 C
!next
val18=$val18 C(=O)O
!for val20 =1 to $val11 
val18=$val18 C
!next
!readproc slib/text/whitespace ,,$val18 
tmp0=$slib_out
val21=$(tmp0) 
!readproc slib/chemistry/jmolshow @$val21,500,400 
tmp0=$slib_out
val22=$(tmp0)
replytype1=atext
replyname1=Nom
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Quel est le nom de cette molécule?</div>	<div class="wimscenter">$val22</div>	<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>	
$()
!exit

