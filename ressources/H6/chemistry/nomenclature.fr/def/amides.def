!set title=Nomenclature des amides
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit, Markey

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=méthan,éthan,propan,butan,pentan,hexan,heptan,octan
val7=amide
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
val9=$(val6[$val8])$val7
val10=$val9
val11=
!for val12 =1 to $val8 
val11=$val11 C
!next
val11=$val11(N)=O
!readproc slib/text/whitespace ,,$val11 
tmp0=$slib_out
val13=$(tmp0)
!readproc slib/chemistry/jmolshow @$val13,500,400 
tmp0=$slib_out
val14=$(tmp0)
replytype1=atext
replyname1=Nom
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Quel est le nom de cette molécule?</div>	<div class="wimscenter">$val14</div>	<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14
embedcnt=0
