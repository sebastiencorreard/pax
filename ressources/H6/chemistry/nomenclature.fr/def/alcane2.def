!set title=Nomenclature des alcanes (correspondance)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit, Markey

ansorder=r,r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=méth,éth,prop,but,pent,hex,hept,oct
val7=ane
tmp0=!randint 2, 7

val8=$[rint($(tmp0))]
val9=$(val6[$val8]) $val7
!readproc slib/text/whitespace ,,$val9 
tmp0=$slib_out
val10=$(tmp0)
val11=
!for val12 =1 to $val8 
val11=$val11 C
!next
!readproc slib/text/whitespace ,,$val11 
tmp0=$slib_out
val13=$(tmp0)
!readproc slib/chemistry/jmolshow @$val13,250,200,,,0 
tmp0=$slib_out
val14=$(tmp0)
tmp0=!randint 1, $val8-1

val15=$[rint($(tmp0))]
val16=$(val6[$val15]) $val7
!readproc slib/text/whitespace ,,$val16 
tmp0=$slib_out
val17=$(tmp0)
val18=
!for val19 =1 to $val15 
val18=$val18 C
!next
!readproc slib/text/whitespace ,,$val18 
tmp0=$slib_out
val20=$(tmp0)
!readproc slib/chemistry/jmolshow @$val20,250,200,,,1 
tmp0=$slib_out
val21=$(tmp0)
tmp0=!randint $val8+1, 8

val22=$[rint($(tmp0))]
val23=$(val6[$val22]) $val7
!readproc slib/text/whitespace ,,$val23 
tmp0=$slib_out
val24=$(tmp0)
val25=
!for val26 =1 to $val22 
val25=$val25 C
!next
!readproc slib/text/whitespace ,,$val25 
tmp0=$slib_out
val27=$(tmp0)
!readproc slib/chemistry/jmolshow @$val27,250,200,,,2 
tmp0=$slib_out
val28=$(tmp0)
replytype1=menu
replyoption1=shuffle 
replyname1=Réponse1
replygood1=1;$val10, $val17, $val24 
replytype2=menu
replyoption2=shuffle 
replyname2=Réponse2
replygood2=2;$val10, $val17, $val24 
replytype3=menu
replyoption3=shuffle 
replyname3=Réponse3
replygood3=3;$val10, $val17, $val24 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Retrouver le nom de chaque molécule.</div>		<table class="wimsborder wimscenter">	<tr><th>molécule 1</th><th>molécule 2</th><th>molécule 3</th></tr>	<tr><td>$val14</td><td>$val21</td><td>$val28</td></tr>	<tr><td> 
!read oef/embed.phtml reply1,120 
$()</td><td> 
!read oef/embed.phtml reply2,120 
$()</td><td> 
!read oef/embed.phtml reply3,120 
$()</td></tr>	</table>	
$()
!exit

