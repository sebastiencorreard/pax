!set title=Nomenclature des alcools
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit, Markey

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=méthan,éthan,propan,butan,pentan,hexan,heptan,octan
val7=ol
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
!if $val8=1 or $val8=2 
val9=$(val6[$val8]) $val7
val10=$(val6[$val8])-1- $val7
!readproc slib/text/whitespace ,,$val9 
tmp0=$slib_out
!readproc slib/text/whitespace ,,$val10 
tmp1=$slib_out
val11=$(tmp0)|$(tmp1)
val12=
!for val13 =1 to $val8 
val12=$val12 C
!next
val12=$val12(O)
!readproc slib/text/whitespace ,,$val12 
tmp0=$slib_out
val14=$(tmp0) 
!readproc slib/chemistry/jmolshow @$val14,500,400 
tmp0=$slib_out
val15=$(tmp0)
!else
val16=$[rint(floor($val8/2))]
tmp0=!randint 1, $val16

val17=$[rint($(tmp0))]
val9=$(val6[$val8])-$val17-$val7
!readproc slib/text/whitespace ,,$val9 
tmp0=$slib_out
val11=$(tmp0)
val12=
!for val13 =1 to $val17 
val12=$val12 C
!next
val12=$val12(O)
!for val18 =$val17+1 to $val8 
val12=$val12 C
!next
!readproc slib/text/whitespace ,,$val12 
tmp0=$slib_out
val14=$(tmp0) 
!readproc slib/chemistry/jmolshow @$val14,500,400 
tmp0=$slib_out
val15=$(tmp0)
!endif
replytype1=atext
replyname1=Nom
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Quel est le nom de cette molécule?</div>	<div class="wimscenter">$val15</div>	<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=0
