!set title=Nomenclature des acides carboxyliques
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Benoit, Markey

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=méthan,éthan,propan,butan,pentan,hexan,heptan,octan
val7=acide
val8=oïque
tmp0=!randint 1, 8

val9=$[rint($(tmp0))]
!if $val9<3 
val10=$(val6[$val9])$val8
!endif
!if $val9>2 
val10=$(val6[$val9])-1-$val8
!endif
val10=$(val6[$val9])$val8
!readproc slib/text/whitespace ,,$val10 
tmp0=$slib_out
val11=$(tmp0)
val12=$val7 $val11
val13=
!for val14 =1 to $val9 
val13=$val13 C
!next
val13=$val13(O)=O
!readproc slib/text/whitespace ,,$val13 
tmp0=$slib_out
val15=$(tmp0)
!readproc slib/chemistry/jmolshow @$val15,500,400 
tmp0=$slib_out
val16=$(tmp0)
replytype1=atext
replyname1=Nom
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question">Quel est le nom de cette molécule?</div>	<div class="wimscenter">$val16</div>	<div class="wims_instruction">ATTENTION aux accents et à l'orthographe.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

