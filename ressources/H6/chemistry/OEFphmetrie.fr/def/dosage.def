:postdef
val32=$val31
tmp=!translate internal $	$ to ; in $val31

tmp0=!rowcnt $tmp
val33=$[rint($(tmp0))]
val34=$(val32[1;])
!for val35 =1 to $val33-1 
val34=$val34,$(val32[$val35+1;])
!next
val36=line 10+5*$(val32[1;1]),10+5*$(val32[1;2]),10+5*$(val32[2;1]),10+5*$(val32[2;2]),red
!for val35 =1 to $val33-2 
val36=$val36	line 10+5*$(val32[$val35+1;1]),10+5*$(val32[$val35+1;2]),10+5*$(val32[$val35+2;1]),10+5*$(val32[$val35+2;2]),red
!next
!readproc slib/graphpaper/millimetre 13,8,1,1,2 V(mL),2 pH,,,,$val34 
tmp0=$slib_out
val37=$(tmp0)
!readproc oef/draw.phtml 100,100 \
$val37	$val36	 
tmp0=$ins_url
val38=$(tmp0)
val29=<img src="$val38">

!exit

