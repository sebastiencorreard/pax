val6=CH3COOH + H2O -> CH3COO- + H3O+,2,2,CH_3COOH,H_2O,CH_3COO^-,H_3O^+,1,1,1,1,4.75,éthanoïque;	C6H5COOH + H2O -> C6H5COO- + H3O+,2,2,C_6H_5COOH,H_2O,C_6H_5COO^-,H_3O^+,1,1,1,1,4.20,benzoïque;	HCOOH + H2O -> HCOO- + H3O+,2,2,HCOOH,H_2O,HCOO^-,H_3O^+,1,1,1,1,3.75,méthanoïque;	HClO + H2O -> HClO- + H3O+,2,2,HClO,H_2O,HClO^-,H_3O^+,1,1,1,1,7.30,hypochloreux;	HF + H2O -> F- + H3O+,2,2,HF,H_2O,F^-,H_3O^+,1,1,1,1,3.2,fluorhydrique;		
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val8=$[rint($(val7[2]))]
val9=$[rint($(val7[3]))]
val10=$[rint($val8 + $val9)]
tmp0=!randitem 50,100,125,150,200

val11=$[rint($(tmp0))]
tmp0=!randint 2, 10

val12=$[rint($(tmp0))]
val13=$[$val11*$val12*1e-6]
val14=$[rint(9)]
tmp0=!randint 1, 9

val15=$[rint($(tmp0))]
tmp0=!randint 1, 9

val16=$[rint($(tmp0))]
val17=$[rint(0)]
