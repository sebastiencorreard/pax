val22=$val17,$val18,$val19,$val20
val23=$[rint(3+2*$val8+2*$val9)]
val24=$[rint(1+ $val23-$val8-$val9)]
val25=$[rint($val23-$val9+1)]
tmp=!translate ";': to $     $ in $(val21[1])-$(val7[$val24+1-1])*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=$(tmp0)

val26=$(tmp1)
!for val27 =2 to $val8 
tmp=!translate ";': to $     $ in $(val21[$val27])-$(val7[$val24+$val27-1])*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=$(tmp0)

val26=$val26,$(tmp1)
!next
tmp=!translate ";': to $     $ in $(val22[1])+$(val7[$val25+1-1])*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=$(tmp0)

val28=$(tmp1)
!for val29 =2 to $val9 
tmp=!translate ";': to $     $ in $(val22[$val29])+$(val7[$val25+$val29-1])*x

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp1=$(tmp0)

val28=$val28,$(tmp1)
!next
val30=$[$val13]
val31=$[0.1]
!while $val12*(1e-3)<10^(-$val31) 
val31=$[$val31+0.1]
!endwhile
val32=$[0]
!while 2*$val31+lg($val12*(1e-3)-(10^(-$val31)))<$(val7[12]) 
val32=$[$val31]
val31=$[$val31+0.01]
!endwhile
val33=$[$val11*1e-3*10^(-$val32)]
val34=$[10^(-$val32)/($val12*1e-3)]
val35=$(val26[1])
!for val36 =1 to $val9 
val35=$val35,$(val28[$val36])
!next
val35=$val35,$val30
tmp0=!replace x by $val30 in $(val26[1])

tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp2=$(tmp1)

val35=$val35,$(tmp2)
!for val37 =1 to $val9 
tmp0=!replace x by $val30 in $(val28[$val37])

tmp=!translate ";': to $     $ in $(tmp0)

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp2=$(tmp1)

val35=$val35,$(tmp2)
!next
val35=$val35,$val33,$val30-$val33,$val33,$val33,$val34
val38=reply 1
!for val39 =2 to 2*$val10+4 
val38=$val38,reply $val39
