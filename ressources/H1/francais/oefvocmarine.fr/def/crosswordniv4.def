!set title=Les noms de la marine. Niveau excellent. MC
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Anne, Dumont-Védrines; Sylvain, Dumont

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!record 1 of crossword4

val6=$(tmp0)
val7=

!ifval $val2 iswordof 3 4 5 
val8=$[rint( $val2 + 2 )]
!else
val8=$[rint( 5)]
!endif
val9=allhelp
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
val11=$(val10[1..$val8])
tmp=!trim $val6
val6=!translate internal $	\
$ to ;; in $tmp
val6=$(val6[$val11;])
!readproc slib/text/crossword $val6 
tmp0=$slib_out
val6=$(tmp0) 
replytype1=crossword

replyoption1=$val9 
replyname1=
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()  
!read oef/embed.phtml r1 
$() 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=
embedcnt=1
