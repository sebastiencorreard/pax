tmp0=!rowcnt $tmp
val16=$(tmp0)
tmp0=!shuffle $val16

val17=$(tmp0)
val17=$(val17[1..$val7])
tmp0=!sort numeric item $val17

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!trim $val12
val18=!translate internal $	\
$ to ;; in $tmp
