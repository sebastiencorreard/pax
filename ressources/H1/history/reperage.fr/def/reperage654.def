val20=$[rint(4*$val10)]
val19=$val19,$val20
val21=xrange $val14	yrange $val15	lines $val8,$val13,1,-1,1,-1,-1,$val13,-1,$val13,-2,$val7+0.5,0,$val13,2,$val13,1	fill 0,\0,$val8	

!ifval $val11=0 
tmp0=!values x for x=1 to 2*$val7

val22= $(tmp0)
!endif

!ifval $val11=1 
tmp0=!values 2*x-1 for x=1 to $val7

val22= $(tmp0)
!endif

!ifval $val11=2 
tmp0=!values 2*x for x=1 to $val7

val22= $(tmp0)
!endif
tmp0=!makelist r x for x in  $val22

val22=$(tmp0)
val23=
val24=
!for val25 =0 to $val7-1 

!ifval $val11=0 or $val11=1 
val21= $val21	  line $val25-0.1,-1,$val25-0.1,-2,$val8
!endif

!ifval $val11=0 or $val11=2 
