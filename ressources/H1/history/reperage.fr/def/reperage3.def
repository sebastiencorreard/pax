val9=100
val10=$[rint(100)]
val11=0
val12=28-juin-14,Attentat de Sarajevo	août-14,Début 1ère guerre mondiale	1916,Bataille de Verdun	1917,Mutineries	1917,Révolutions russes	11-nov-18,Armistice	1929,Collectivisations des terres en URSS	1929,Crise économique mondiale	30-janv-33,Hitler, chancelier	1935,Lois de Nuremberg	1936,Lois sociales du Front populaire	1939,Début de la 2nd guerre mondiale	1939,Invasion de la Pologne	18-juin-40,Appel du général De Gaulle	1944,Droit de vote pour les femmes	08-mai-45,Capitulation allemande	06-août-45,Bombe atomique sur Hiroshima	02-sept-45,Capitulation japonaise – fin de la guerre	1945,Création de la sécurité sociale	1945 - 1954,Guerre d’Indochine	1947 - 1958,4ème république	1947,Indépendance de l’Inde	1947,Plan Marshall	1949,Proclamation République populaire de Chine	1953,Mort de Staline	1954 - 1962,Guerre d’Algérie	1957,Traité de Rome	1958 - 1969,Charles De Gaulle	1958,Début de la 5ème république	1969 - 1974,Georges Pompidou	1974 - 1981,Valéry Giscard d’Estaing	1981 - 1995,François Mitterrand	1989,Chute du mur de Berlin	1990,Réunification de l’Allemagne	1991,Eclatement de l’URSS	1992,Traité de Maastricht	1995 - 2007,Jacques Chirac	11-sept-01,Attentat des World Trade Center	2007 - 2012,Nicolas Sarkozy	2011,Le printemps arabe
