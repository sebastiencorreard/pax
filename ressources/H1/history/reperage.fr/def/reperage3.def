!endif

!ifval $val11=0 or $val11=2 
val21= $val21	  line $val25-0.1,0.7,$val25-0.1,2,$val8
!endif
t_=!replace internal \( by ( in [2*$val25+1,2*$val25+2]
tmp0=!exec pari $t_

