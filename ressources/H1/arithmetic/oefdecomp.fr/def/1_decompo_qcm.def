val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in bigomega($val9)
tmp0=!exec pari $t_

val13=$(tmp0)
t_=!replace internal \( by ( in factor($val9)
tmp0=!exec pari $t_

val14=$(tmp0)
val15=$(val14[;1])
val16=$(val14[;2])
t_=!replace internal \( by ( in omega($val10)
tmp0=!exec pari $t_

val17=$[rint($(tmp0))]
t_=!replace internal \( by ( in bigomega($val10)
tmp0=!exec pari $t_

val18=$(tmp0)
t_=!replace internal \( by ( in factor($val10)
tmp0=!exec pari $t_

val19=$(tmp0)
val20=$(val19[;1])
val21=$(val19[;2])
t_=!replace internal \( by ( in omega($val11)
tmp0=!exec pari $t_

val22=$[rint($(tmp0))]
t_=!replace internal \( by ( in bigomega($val11)
tmp0=!exec pari $t_

val23=$(tmp0)
t_=!replace internal \( by ( in factor($val11)
tmp0=!exec pari $t_

val24=$(tmp0)
val25=$(val24[;1])
val26=$(val24[;2])
!readproc slib/numeration/ecriturenombre $val9,tex 
tmp0=$slib_out
val27=$(tmp0)
val28=
!for val29 =1 to $val12 
!for val30 =1 to $(val16[$val29]) 
tmp0=!append item $(val15[$val29]) to $val28

val28=$(tmp0)
!next
!next
tmp0=!replace internal , by \times in $val28

val31=$(tmp0)
val32=
!for val29 =1 to $val17 
!for val30 =1 to $(val21[$val29]) 
tmp0=!append item $(val20[$val29]) to $val32

val32=$(tmp0)
!next
!next
tmp0=!replace internal , by \times in $val32

val32=$(tmp0)
val33=
!for val29 =1 to $val22 
!for val30 =1 to $(val26[$val29]) 
tmp0=!append item $(val25[$val29]) to $val33

val33=$(tmp0)
!next
!next
tmp0=!replace internal , by \times in $val33

val33=$(tmp0)
tmp0=!makelist x for x=1 to $val13

val34=$(tmp0)
!readproc slib/data/random 2,item, $val34 
tmp0=$slib_out
val35=$(tmp0)
val36=$val28
!for val37 =1 to 2 
!if $(val35[$val37])!=1 
tmp0=!replace item number $(val35[$val37]) by (-$(val28[$(val35[$val37])])) in $val36 

val36=$(tmp0)
!else
tmp0=!replace item number $(val35[$val37]) by -$(val28[$(val35[$val37])]) in $val36 

val36=$(tmp0)
!endif
!next
tmp0=!replace internal , by \times in $val36

val36=$(tmp0)
t_=!replace internal \( by ( in 	facteurs=[$val15];	puissances=[$val16];	sumpuis=$val13;	nb=$val9;	v=vector(sumpuis);	k=0;	for(j=1,#facteurs,for(i=1,puissances[j],v[i+k]=facteurs[j]);k=k+puissances[j]);	sol=vector(sumpuis,i,m=v[1..i];concat(m,nb/prod(t=1,#m,m[t])))	
tmp0=!exec pari $t_

val38=$(tmp0)
tmp0=!declosing $(val38[-3])

val39=$(tmp0)
tmp0=!replace internal , by \times in $val39

val39=$(tmp0)
tmp0=!declosing $(val38[-3])

val40=$(tmp0)
val40=$[rint($(val40[-1]))]
t_=!replace internal \( by ( in numdiv($val40)
tmp0=!exec pari $t_

val41=$(tmp0)
t_=!replace internal \( by ( in divisors($val40)
tmp0=!exec pari $t_

val42=$(tmp0)
val43=$(val42[1..-2])
tmp0=!randint 0, 1

val44=$[rint($(tmp0))]
!if alea=0 
val45=$val32
!else
val45=$val33
!endif
!if $val13>2 
tmp=!trim \($val31\),\($val36\),\($val39\),\($val45\),1
val46=!translate internal $	\
$ to ;; in $tmp
!else
tmp=!trim \($val31\),\($val36\),\($val32\),\($val33\),1
val46=!translate internal $	\
$ to ;; in $tmp
!endif
val47=Parmi les quatre propositions suivantes, une seule est la décomposition en produit de facteurs premiers du nombre \($val27\). Laquelle&nbsp;?
val48=2,3,5,7
tmp0=!randitem $val48

val49=$[rint($(tmp0))]
tmp0=!replace item number $val8 by  in $val6

val50=$(tmp0)
tmp0=!replace item number $val8-1 by  in $val6

val50=$(tmp0)
tmp0=!replace item number $val8+1 by  in $val6

val50=$(tmp0)
tmp0=!nonempty item $val50

val50=$(tmp0)
tmp0=!randitem $val50

val51=$[rint($(tmp0))]
t_=!replace internal \( by ( in divisors($val51)
tmp0=!exec pari $t_

val52=$(tmp0)
val53=$(val52[1..-2])
t_=!replace internal \( by ( in numdiv($val51)
tmp0=!exec pari $t_

val54=$(tmp0)
t_=!replace internal \( by ( in omega($val51)
tmp0=!exec pari $t_

val55=$[rint($(tmp0))]
t_=!replace internal \( by ( in bigomega($val51)
tmp0=!exec pari $t_

val56=$(tmp0)
t_=!replace internal \( by ( in factor($val51)
tmp0=!exec pari $t_

val57=$(tmp0)
val58=$(val57[;1])
val59=$(val57[;2])
val60=
!for val29 =1 to $val55 
!for val30 =1 to $(val59[$val29]) 
tmp0=!append item $(val58[$val29]) to $val60

val60=$(tmp0)
!next
!next
tmp0=!replace internal , by \times in $val60

val61=$(tmp0)
