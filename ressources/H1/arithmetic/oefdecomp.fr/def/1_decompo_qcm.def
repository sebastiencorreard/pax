!set title=1- Retrouver la décomposition en facteurs premiers d'un entier (QCM)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Euler,Versailles
email=euler.wims@ac-versailles.fr
keywords=
language=fr
oefdescription=Dans ce QCM, vous devez retrouver, parmi quatre propositions, la décomposition en produit de facteurs premiers d'un nombre entier non premier généré par le serveur.
oefobservation=Dans ce QCM, il est demandé de retrouver, parmi quatre propositions, la décomposition en produit de facteurs premiers d'un nombre entier non premier généré aléatoirement par le serveur. Le nombre entier non premier généré est inférieur ou égal à 200 et sa décomposition en produit de facteurs premiers ne fait intervenir que des nombres parmi 2, 3, 5 et 7. L'écriture demandée ne fait intervenir aucun exposant.
computeanswer=no

ansorder=r
varcnt=80
prevarcnt=78
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

