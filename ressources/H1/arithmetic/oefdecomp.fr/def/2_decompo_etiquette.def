val18=$(tmp0)
t_=!replace internal \( by ( in 	(PermutList(liste)=	  my(position,result,temp);	  position=vector((#liste)!,i,numtoperm(#liste, i));	  position=vecsort(position);	  result=vector((#liste)!);	  for(j=1,(#liste)!,result[j]=vector(#liste,i,liste[position[j][i]]));	  result	);	PermutList([$val14])	
tmp0=!exec pari $t_

val19=$(tmp0)
