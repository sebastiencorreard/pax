!set title=Fraction décimale 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter l'égalité&nbsp;
tmp0=!shuffle 4

val7=$(tmp0)
tmp0=!item 1 to 2 of $val7

val7=$(tmp0)
tmp0=!sort items $val7

val7=$(tmp0)
tmp0=!shuffle 9

val8=$(tmp0)
val9=$[$(val8[1])+$(val8[2])/10^$(val7[1])+$(val8[3])/10^$(val7[2])]
val10=$[rint($(val8[2])*10^($(val7[2])-$(val7[1]))+$(val8[3]))]
val11=$[rint(10^$(val7[2]))]
val12=$val6
val13=$[rint(3)]
replytype1=numeric
replyname1=
replygood1=$[$(val8[1])]
replytype2=numeric
replyname2=
replygood2=$[$val10]
replytype3=numeric
replyname3=
replygood3=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12 \($val9 = \dots\dots + \frac{\dots\dots}{\dots\dots}\) \end{statement} 


!goto stat

!exit

:question
$()$val12	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [ $val9= reply1 + \frac{reply2}{reply3} ],$val13	reply1	reply2	reply3 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val12 
!insmath $val9 = \dots\dots + \frac{\dots\dots}{\dots\dots}
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12,13
embedcnt=1
