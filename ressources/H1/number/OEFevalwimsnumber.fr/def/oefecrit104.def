!set title=Écriture décimale 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter&nbsp;
tmp0=!randint 3, 5

val7=$[rint($(tmp0))]
tmp0=!shuffle 9

val8=$(tmp0)
val9=
!for val10 =1 to $val7 
tmp0=!append item $(val8[$val10]) to $val9

val9=$(tmp0)
!next
tmp0=!append item 0 to $val9

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
tmp0=!append item $(val8[$val7 + 1]) to $val9

val9=$(tmp0)
val11=$[rint(0)]
!for val12 =2 to $val7 + 2 
val11=$[rint($val11+$(val9[$val12])*10^($val12-2))]
!next
tmp0=!shuffle $val7+1

val13=$(tmp0)
val14=1,10,100,1 000,10 000,100 000
val15=$[rint(5)]
replytype1=numeric
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<div class="wimscenter">	 
!for m_b=1 to $val7 
$()
!if $(val9[$(val13[$m_b])+1])<>0 
$()($(val9[$(val13[$m_b])+1]) x $(val14[$(val13[$m_b])])) + 
!endif
$() 
!next
$()	($(val9[$(val13[$val7 + 1])+1]) x $(val14[$(val13[$val7 + 1])]))	=	 
!read oef/embed.phtml r1,$val15 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,13,14,15
embedcnt=1
