!set title=Écriture décimale suite 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes
val7=Écrire le nombre décimal suivant sans zéro inutile&nbsp;
tmp0=!randint 3, 5

val8=$[rint($(tmp0))]
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
tmp0=!randint 11, 99

val10=$[rint($(tmp0))]
val11=$[$val9+$val10/10^($val8-1)]
val12=$val7
val13=$[rint(8)]
val14=$val9 $(val6[1]) $val10 $(val6[$val8])=
replytype1=atext
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12: \begin{center} $val14 \(\dots\dots\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val12:	<div class="wimscenter">	$val14	 
!read oef/embed.phtml r1,$val13 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val12: $m_begin{center} $val14 
!insmath \dots\dots
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,14
embedcnt=1
