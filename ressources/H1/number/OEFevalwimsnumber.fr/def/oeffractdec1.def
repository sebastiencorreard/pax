!set title=Fraction décimale 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes
val7=Compléter l'égalité&nbsp;
tmp=!trim 1,2,4	1,2,5	1,3,4	1,3,5	1,4,5
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val10=2,3,4,5,6,7,8,9
tmp0=!shuffle $val10

val10=$(tmp0)
val11=$[$(val10[1])+$(val10[2])/10^($(val8[2])-1)+$(val10[3])/10^($(val8[3])-1)]
val12=$[rint(10^($(val8[2])-1))]
val13=$[rint(10^($(val8[3])-1))]
val14=$val7
val15=$[rint(3)]
replytype1=numeric
replyname1=
replygood1=$[$val12]
replytype2=numeric
replyname2=
replygood2=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14 \($val11= $(val10[1]) + \frac{$(val10[2])}{\dots}+\frac{$(val10[3])}{\dots}\) \end{statement} 


!goto stat

!exit

:question
$()$val14	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [$val11 = $(val10[1]) + \frac{$(val10[2])}{reply1}+\frac{$(val10[3])}{reply2}], $val15	reply1	reply2 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14 
!insmath $val11= $(val10[1]) + \frac{$(val10[2])}{\dots}+\frac{$(val10[3])}{\dots}
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,14,15
embedcnt=1
