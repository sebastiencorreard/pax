!set title=Fraction décimale 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver le nombre décimal&nbsp;
tmp0=!shuffle 4

val7=$(tmp0)
tmp0=!item 1 to 2 of $val7

val7=$(tmp0)
tmp0=!sort items $val7

val7=$(tmp0)
tmp0=!shuffle 9

val8=$(tmp0)
val9=$[$(val8[1])+$(val8[2])/10^$(val7[1])+$(val8[3])/10^$(val7[2])]
val10=$[rint($(val8[2])*10^($(val7[2])-$(val7[1]))+$(val8[3]))]
val11=$[rint(10^$(val7[2]))]
val12=$[rint(8)]
val13=$val6: <div class="wimscenter">\($(val8[1]) + \frac{$val10}{$val11} \)	
replytype1=atext
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 = \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()$val13 =  
!read oef/embed.phtml r1,$val12 
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 = 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=1
