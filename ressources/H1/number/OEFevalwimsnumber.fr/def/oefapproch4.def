!set title=Valeur approchée 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
language=fr
precision=10000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=à l'unité par défaut,au dixième par défaut,au centième par défaut,	  à l'unité par excès,au dixième par excès,au centième par excès
val7=Nous avons le nombre,Relier les valeurs approchées&nbsp;
tmp0=!randint 1, 9

tmp1=!randint 1, 8

tmp2=!randint 0, 9

tmp3=!randint 0, 9

tmp4=!randint 1, 9

val8=$[rint($(tmp0)*10000+$(tmp1)*1000+$(tmp2)*100+$(tmp3)*10+$(tmp4))]
tmp0=!randint 0, 99

val9=$[rint($(tmp0))]
val10=+,-
val11=$[$val9+$val8/100000]
val12=$[rint(floor($val11))]
val13=$[rint(ceil($val11))]
val14=$[floor($val11*10)/10]
val15=$[ceil($val11*10)/10]
val16=$[floor($val11*100)/100]
val17=$[ceil($val11*100)/100]
!if $val13=$val15 
val15=$val15.0
!endif
val18=$val12,$val14,$val16,$val13,$val15,$val17
!readproc slib/numeration/ecriturenombre $val11 
tmp0=$slib_out
val11=$(tmp0)
tmp0=!replace internal . by , in $val11

val11=$(tmp0)
replytype1=correspond
replyname1=
replygood1=$val6;$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

