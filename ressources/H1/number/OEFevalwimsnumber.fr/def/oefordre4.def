val8=Cocher le nombre
val9=Pour choisir, la décision se fait grâce au chiffre des 
tmp0=!shuffle 9

val10=$(tmp0)
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
tmp0=!item 1 to 4 of $val10

val12=$(tmp0)
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
val14=$[rint(0)]
!for val15 =1 to $val11 
val14=$[$val14+$(val12[$val15])/10^($val13+$val15-$val11)]
!next
tmp0=!randint 1, 9

val16=$[rint($(tmp0))]
tmp0=!randitem -1,1

val17=$[rint($(tmp0))]
val18=$[$val14+$val17*$val16/10^($val13+1)]
val19=$val14,$val18
tmp0=!randitem -1,1

val20=$[rint($(tmp0))]
!if $val14*$val20>$val18*$val20 
val21=$[rint(2)]
!else
val21=$[rint(1)]
!endif
val22=$[rint($val13+3+(1+$val17)/2)]
val23=$val8 $(val7[$val20/2+1.5]) :
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=$val21;$val19
replytype2=checkbox
replyname2=
replygood2=$val22;$val6
