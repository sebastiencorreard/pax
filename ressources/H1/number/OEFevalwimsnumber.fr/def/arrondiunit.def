!set title=Arrondi à l'unité 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
language=fr
precision=10000
oefcss=<style> .macss{background-color: #FAFAD2;} </style>

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère le nombre,On veut déterminer son arrondi 
val7=à l'unité,au dixième,au centième
val8=unités,dixièmes,centièmes
val9=par défaut,par excès
val10=Compléter la phrase suivante&nbsp;
val11=Vous semblez confondre les valeurs par défaut et par excès	  (par défaut...il en manque et par excès...il y en a trop).
tmp=!trim Le chiffre des,du nombre,est	  Donc l'arrondi,du nombre,est la valeur approchée, qui est égale à
val12=!translate internal $	\
$ to ;; in $tmp
val13=chiffre des,arrondi
val14=On note
val15=L'arrondi ,du nombre ,vaut
val16=L'<b>arrondi</b> XXXX d'un nombre est la valeur approchée XXXX	  (par défaut ou par excès)<b> la plus proche</b> de ce nombre.</p>	  <p>En pratique, comment trouver l'arrondi XXXX&nbsp;:</p>	  <ul><li>Lorsque le chiffre des YYYY du nombre est 0, 1, 2, 3 ou 4,	  l'arrondi XXXX est la valeur approchée XXXX par défaut.</li>	  <li>Lorsque le chiffre des YYYY du nombre est 5, 6, 7, 8 ou 9,	  l'arrondi XXXX est la valeur approchée XXXX par excès.</li></ul>
tmp0=!randint 0, 999

val17=$[rint($(tmp0))]
tmp0=!randint 0, 9999

val18=$[rint($(tmp0))]
val19=$[$val17+$val18/10000]
val20=$[rint(floor($val18/1000))]
tmp0=!replace internal . by , in $val19

val21=$(tmp0)
val22=$[rint($val17+1)]
val23=$[rint($val17)]
val24=$[rint($val22)]
val25=<span style="color:red"><b>$(val7[1])</b></span>
val26=<span style="color:blue"><b>$(val8[2])</b></span>
val27=$(val6[1]) \($val21\). $(val6[2]) $val25.
tmp0=!replace internal XXXX by $val25 in $val16

val16=$(tmp0)
tmp0=!replace internal YYYY by $val26 in $val16

val16=$(tmp0)
!if $val20<5 
val28=$[rint(1)]
val29=$[rint($val17)]
!else
val28=$[rint(2)]
val29=$[rint($val22)]
!endif
replytype1=numexp
replyname1=$(val13[2])
replygood1=$val29
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst $val16

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val27<br>	  $val10:<br>	  <label for="reply1">	  $(val15[1]) $val25 $(val15[2]) 
!insmath $val21
$()	  $(val15[3])</label>  
!read oef/embed.phtml r1,3 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()$val16
$()
!exit

:solution
$()$(val12[1;1]) $val26 $(val12[1;3])
!insmath $val20
$().	  $(val12[2;1]) $val25 $(val12[2;2]) 
!insmath $val21
$()	  $(val12[2;3]) $(val9[$val28]) : 
!insmath $val29
$().<p>	  $val14 
!insmath $val21 \approx $val29 
$().</p>
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval ($val20<5 and $m_reply1=$val22) or ($val20>4 and $m_reply1=$val17)
 <div class='oef_feedbacks'>	  <div class="macss">$val11</div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=9,10,11,12,14,15,16,17,20,21,22,25,26,27,28,29
embedcnt=1
