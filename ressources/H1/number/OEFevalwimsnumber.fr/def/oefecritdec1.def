!set title=Écriture d'un nombre décimal 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes,cent millièmes
val7=unités,dizaines,centaines,milliers,dix milliers,cent milliers
tmp=!trim Voici un nombre	  Dans ce nombre, quelle est la partie entière&nbsp;?
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 9

val9=$(tmp0)
tmp0=!randint 4, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10-3

val11=$[rint($(tmp0))]
val12=$[rint(0)]
!for val13 =1 to $val10 
val12=$[rint($val12+$(val9[$val13])*10^($val10-$val13))]
!next
val12=$[$val12/10^$val11]
val14=$(val8[1;]) $val12. $(val8[2;])
val15=$[rint(floor($val12))]
val16=$[rint(8)]
replytype1=atext
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14: \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()	$val14	 
!read oef/embed.phtml r1,$val16 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14: 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,16
embedcnt=1
