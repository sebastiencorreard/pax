!set title=Fraction décimale 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver le nombre décimal&nbsp;
tmp=!trim 1,2,4	1,2,5	1,3,4	1,3,5	1,4,5
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val9=1,2,3,4,5,6,7,8,9
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$[$(val9[1])+$(val9[2])/10^($(val7[2])-1)+$(val9[3])/10^($(val7[3])-1)]
val11=$[rint(10^($(val7[2])-1))]
val12=$[rint(10^($(val7[3])-1))]
val13=$[rint(8)]
val14=$val6:	  <div class="wimscenter">\($(val9[1]) + \frac{$(val9[2])}{$val11} + \frac{$(val9[3])}{$val12} \)	
replytype1=atext
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14 = \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()$val14 =  
!read oef/embed.phtml r1,$val13 
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14 = 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14
embedcnt=1
