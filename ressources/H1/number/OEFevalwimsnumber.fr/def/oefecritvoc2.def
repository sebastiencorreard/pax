!set title=Vocabulaire sur le rang 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dizaines,centaines,milliers,dizaines de milliers,centaines de milliers,millions,dizaines de millions,centaines de millions,milliards
val7=Compléter&nbsp;
val8=Dans le nombre,est le chiffre des 
tmp0=!shuffle 9

val9=$(tmp0)
tmp0=!randint 3, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10

val11=$[rint($(tmp0))]
val12=$[rint(18)]
val13=
!for val14 =1 to $val10 
tmp0=!append item $(val9[$val14]) to $val13

val13=$(tmp0)
!next
val15=$[rint(0)]
!for val16 =1 to $val10 
val15=$[rint($val15+$(val13[$val16])*10^($val10-$val16))]
!next
val17=$(val8[1]) $val15, $(val9[$val11]) $(val8[2]) 
val18=$(val6[$val10-$val11+1])
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7: $val17 \(\dots\dots\). \end{statement} 


!goto stat

!exit

:question
$()	$val7: $val17  
!read oef/embed.phtml r1,$val12 
$().
$()
!exit

