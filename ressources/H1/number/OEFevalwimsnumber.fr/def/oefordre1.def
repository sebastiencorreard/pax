val6=centaines,dizaines,unités,dixièmes,centièmes,millièmes
val7=supérieur,inférieur
val8=Cocher le nombre
val9=Pour choisir, la décision se fait grâce au chiffre des 
tmp0=!shuffle 9

val10=$(tmp0)
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
tmp0=!item 1 to 3 of $val10

val12=$(tmp0)
val13=
!for val14 =1 to 3 
!if $val14<>$val11 
val13=$val13,$(val12[$val14])
!else
val13=$val13,0
!endif
!next
tmp0=!item 2 to 4 of $val13

val13=$(tmp0)
val15=$[rint(0)]
val16=$[rint(0)]
!for val14 =1 to 3 
val15=$[$val15+$(val12[$val14])*10^(3-$val14)]
val16=$[$val16+$(val13[$val14])*10^(3-$val14)]
!next
val17=$val15,$val16
tmp0=!randitem -1,1

val18=$[rint($(tmp0))]
!if $val15*$val18>$val16*$val18 
val19=$[rint(2)]
!else
val19=$[rint(1)]
!endif
val20=$[rint($val11)]
val21=$val8 $(val7[$val18/2+1.5]) :
replytype1=checkbox
replyoption1=shuffle 
replyname1=
replygood1=$val19;$val17
replytype2=checkbox
replyname2=
replygood2=$val20;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

