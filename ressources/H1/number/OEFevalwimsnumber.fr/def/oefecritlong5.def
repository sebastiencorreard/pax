!set title=Mesure de longueur 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter l'égalité&nbsp;
val7=km,hm,dam,m,dm,cm,mm
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 6

val9=$[rint($(tmp0))]
tmp0=!randint $val9+1, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val11=$(tmp0),$(tmp1),$(tmp2)
val12=$[$(val11[1])*10^($val8-$val8)+$(val11[2])*10^($val8-$val9)+$(val11[3])*10^($val8-$val10)]
val13=$[$(val11[2])*10^($val10-$val9)+$(val11[3])*10^($val10-$val10)]
val14=$val6
val15=$val12 $(val7[$val8])
replytype1=menu
replyname1=
replygood1=$val8;$val7
replytype2=menu
replyname2=
replygood2=$val10;$val7
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14 \begin{center} $val15=$(val11[1]) \(\dots\dots\) + $(val11[2]) \(\dots\dots\). \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val14:	<div class="wimscenter">	$val15=$(val11[1])  
!read oef/embed.phtml r1,\larg 
$() + $val13  
!read oef/embed.phtml r2,\larg 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val14 $m_begin{center} $val15=$(val11[1]) 
!insmath \dots\dots
$() + $(val11[2]) 
!insmath \dots\dots
$(). $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13,14,15
embedcnt=2
