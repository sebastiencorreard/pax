!set title=Écriture décimale suite 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes
val7=Écrire le nombre décimal suivant sans zéro inutile&nbsp;
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
tmp0=!randint 11, 999

val9=$[rint($(tmp0))]
val10=$[$val9/10^($val8-1)]
val11=$val7
val12=$[rint(8)]
val13=$val9 $(val6[$val8])=
replytype1=atext
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val11: \begin{center} $val13 \(\dots\dots\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val11:	<div class="wimscenter">	$val13	 
!read oef/embed.phtml r1,$val12 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val11: $m_begin{center} $val13 
!insmath \dots\dots
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,13
embedcnt=1
