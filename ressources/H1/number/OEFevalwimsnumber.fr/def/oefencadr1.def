!set title=Encadrer 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Choisir les deux nombres les plus proches
val7=\(\Large{< }\),\(\Large{>}\), \(\Large{=}\)
tmp0=!randint 0, 4

tmp1=!randint 1, 9

tmp2=!randint 2, 9

val8=$(tmp0),$(tmp1),$(tmp2)
val9=$(val8[1]),$(val8[2]),0
tmp0=!randint 1, $(val8[3])-1

val10=$(val8[1]),$(val8[2]),$(tmp0)
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
val12=$[rint(0)]
val13=$[rint(0)]
val14=$[rint(0)]
!for val15 =1 to 3 
val12=$[$val12+$(val8[$val15])*10^(3-$val15)]
val13=$[$val13+$(val9[$val15])*10^(3-$val15)]
val14=$[$val14+$(val10[$val15])*10^(3-$val15)]
!next
val16=$[rint($val13+10)]
val17=$[rint($val12+100)]
val18=$val13,$val16,$val17,$val14
!if $val11=1 
tmp0=!sort numeric items $val18

val18=$(tmp0)
!else
tmp0=!sort reverse numeric items $val18

val18=$(tmp0)
!endif
val19=$val6
val20=$(val7[$val11]) $val12 $(val7[$val11]) 
tmp=!trim $(val18[2])	$(val18[1])
val21=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $(val18[3])	$(val18[4])
val22=!translate internal $	\
$ to ;; in $tmp
val23=50x32
val24=dragfill
tmp0=!replace internal ; by , in $val21,$val22

val25=$(tmp0)
tmp0=!shuffle $val25

val25=$(tmp0)
tmp0=!replace internal , by ,&#36; &#36; in $val25

val25=$(tmp0)
replytype1=$val24

replyname1=
replygood1=$val21
replytype2=$val24

replyname2=
replygood2=$val22
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19: \begin{center} \(\dots\dots\) $val20 \(\dots\dots\) \end{center} $val25 \end{statement} 


!goto stat

!exit

:question
$()$val19: <div class="wimscenter"> 
!read oef/embed.phtml r1,$val23 
$()	$val20  
!read oef/embed.phtml r2,$val23 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val19: $m_begin{center} 
!insmath \dots\dots
$() $val20 
!insmath \dots\dots
$() $m_end{center} $val25 $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=19,20,23,25
embedcnt=2
