!set title=Fraction décimale 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter l'égalité&nbsp;
tmp=!trim 1,2,4	1,2,5	1,3,4	1,3,5	1,4,5
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
val9=1,2,3,4,5,6,7,8,9
tmp0=!shuffle $val9

val9=$(tmp0)
val10=$[$(val9[1])+$(val9[2])/10^($(val7[2])-1)+$(val9[3])/10^($(val7[3])-1)]
val11=$[rint(10^($(val7[2])-1))]
val12=$[rint(10^($(val7[3])-1))]
val13=$val6
val14=$[rint(3)]
replytype1=numeric
replyname1=
replygood1=$[$(val9[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val9[2])]
replytype3=numeric
replyname3=
replygood3=$[$(val9[3])]
replytype4=numeric
replyname4=
replygood4=$[$val11]
replytype5=numeric
replyname5=
replygood5=$[$val12]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 \($val10 = \dots + \frac{\dots}{\dots} + \frac{\dots}{\dots}\) \end{statement} 


!goto stat

!exit

:question
$()$val13	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [$val10 = reply1 + \frac{reply2}{reply4} + \frac{reply3}{reply5} ],$val14	reply1	reply2	reply3	reply4	reply5 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 
!insmath $val10 = \dots + \frac{\dots}{\dots} + \frac{\dots}{\dots}
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,13,14
embedcnt=1
