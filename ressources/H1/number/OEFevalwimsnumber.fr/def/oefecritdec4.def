!set title=Écriture d'un nombre décimal 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000000

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes,cent millièmes
val7=unités,dizaines,centaines,milliers,dix milliers,cent milliers
val8=Recopier le nombre,sans les zéros inutiles&nbsp;
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=
!for val11 =1 to $val9 
val10=$val10 0
!next
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!for val11 =1 to $val12 
tmp0=!randint 1, 9

val10=$val10 $(tmp0)
!next
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
!for val11 =1 to $val13 
val10=$val10 0
!next
val10=$val10 .
tmp0=!randint 0, 3-$val13

val14=$[rint($(tmp0))]
!for val11 =1 to $val14 
val10=$val10 0
!next
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
!for val11 =1 to $val15 
tmp0=!randint 1, 9

val10=$val10 $(tmp0)
!next
tmp0=!randint 1, 4-$val14

val16=$[rint($(tmp0))]
!for val11 =1 to $val16 
val10=$val10 0
!next
val17=$[$val10]
val18=$val8
val19=$val17
val20=$[rint(15)]
tmp0=!nospace $val10

val10=$(tmp0)
val18=$(val8[1]) $val10 $(val8[2]): 
replytype1=atext
replyname1=
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18: \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()	$val18	 
!read oef/embed.phtml r1,$val20 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18: 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18,20
embedcnt=1
