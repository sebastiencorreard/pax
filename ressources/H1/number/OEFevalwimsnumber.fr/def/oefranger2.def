!set title=Ranger 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r,r,r,r
varcnt=51
prevarcnt=50
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=croissant,décroissant
val7=
val8=Ranger les nombres, en ordre
val9=\(\Large{<}\),\(\Large{>}\),\(\Large{=}\)
val10=$val6
tmp0=!shuffle 9

val11=$(tmp0)
tmp0=!item 1 to 3 of $val11

val12=$(tmp0)
val13=
!for val14 =1 to 3 
!if $val14<>1 
val13=$val13,$(val12[$val14])
!else
val13=$val13,0
!endif
!next
tmp0=!item 2 to 4 of $val13

val13=$(tmp0)
val15=
!for val14 =1 to 3 
!if $val14<>2 
val15=$val15,$(val12[$val14])
!else
val15=$val15,0
!endif
!next
tmp0=!item 2 to 4 of $val15

val15=$(tmp0)
val16=
!for val14 =1 to 3 
!if $val14<>3 
val16=$val16,$(val12[$val14])
!else
val16=$val16,0
!endif
!next
tmp0=!item 2 to 4 of $val16

val16=$(tmp0)
val17=$[rint(0)]
val18=$[rint(0)]
val19=$[rint(0)]
val20=$[rint(0)]
!for val14 =1 to 3 
val17=$[$val17+$(val12[$val14])*10^(3-$val14)]
val18=$[$val18+$(val13[$val14])*10^(3-$val14)]
val19=$[$val19+$(val15[$val14])*10^(3-$val14)]
val20=$[$val20+$(val16[$val14])*10^(3-$val14)]
!next
val21=$val17,$val18,$val19,$val20
tmp0=!randitem 1,2

val22=$[rint($(tmp0))]
!if $val22=1 
tmp0=!sort numeric items $val21

val21=$(tmp0)
!else
tmp0=!sort reverse numeric items $val21

val21=$(tmp0)
!endif
val23=$(val10[$val22])&nbsp;
val24=; 
val25=; 
val26=; 
val27=$(val21[1])
val28=$(val21[2])
val29=$(val21[3])
val30=$(val21[4])
val31=50x32
val32=dragfill
val6=
val33=$val27,$val28,$val29,$val30
tmp0=!replace internal ; by , in $val33

val33=$(tmp0)
tmp0=!listuniq $val33

val33=$(tmp0)
tmp0=!shuffle $val33

val33=$(tmp0)
replytype1=dragfill
replyname1=
replygood1=$val27
replytype2=dragfill
replyname2=
replygood2=$val28
replytype3=dragfill
replyname3=
replygood3=$val29
replytype4=$val32

replyname4=
replygood4=$val30;$val6
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val8[1]) $val33 $(val8[2]) $val23 \begin{center} \(\ldots\) $val24 \(\ldots\) $val25 \(\ldots\) $val26 \(\ldots\) \end{center} $val7 \end{statement} 


!goto stat

!exit

:question
$()	$(val8[1]) $(val8[2]) $val23:	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val31 
$()	$val24  
!read oef/embed.phtml r2,$val31 
$()	$val25  
!read oef/embed.phtml r3,$val31 
$()	$val26  
!read oef/embed.phtml r4,$val31 
$()	</div>	$val7	
$()
!exit

