!set title=Écriture d'un nombre décimal 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes,cent millièmes
val7=unités,dizaines,centaines,milliers,dix milliers,cent milliers
val8=Recopier, en plaçant la virgule pour que le nombre soit compris entre
val9=et
tmp0=!shuffle 9

val10=$(tmp0)
tmp0=!randint 4, 7

val11=$[rint($(tmp0))]
tmp0=!randint 1, $val11-1

val12=$[rint($(tmp0))]
val13=$[rint(0)]
!for val14 =1 to $val11 
val13=$[rint($val13+$(val10[$val14])*10^($val11-$val14))]
!next
val15=$[$val13/10^$val12]
val16=$[rint(floor($val15/10)*10)]
val17=$[rint(ceil($val15/10)*10)]
val18=$(val8[1]) $val13 $(val8[2]) $val16 $val9 $val17.
val19=$[rint(10)]
replytype1=atext
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val18: \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()	$val18	 
!read oef/embed.phtml r1,$val19 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val18: 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18,19
embedcnt=1
