!set title=Mesure de longueur 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner l'écriture décimale de la longueur suivante sans zéro inutile&nbsp;
val7=km,hm,dam,m,dm,cm,mm
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 6

val9=$[rint($(tmp0))]
tmp0=!randint $val9+1, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val11=$(tmp0),$(tmp1),$(tmp2)
val12=$[$(val11[1])*10^(4-$val8)+$(val11[2])*10^(4-$val9)+$(val11[3])*10^(4-$val10)]
val13=$val6
val14=$(val11[1]) $(val7[$val8]) + $(val11[2]) $(val7[$val9]) + $(val11[3]) $(val7[$val10])
val15=$[rint(4)]
val16=$[rint(8)]
replytype1=atext
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 \begin{center}$val14 = \(\dots\dots\) $(val7[$val15])\end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val13: <div class="wimscenter">$val14 =  
!read oef/embed.phtml r1,$val16 
$() $(val7[$val15])</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 $m_begin{center}$val14 = 
!insmath \dots\dots
$() $(val7[$val15])$m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,13,14,15,16
embedcnt=1
