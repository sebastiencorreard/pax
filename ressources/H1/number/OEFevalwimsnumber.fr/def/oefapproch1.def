!set title=Valeur approchée 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
language=fr
precision=10000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Relier un nombre avec sa valeur approchée au dixième près&nbsp;
tmp0=!randint 0, 9

tmp1=!randint 0, 9

val7=$[rint($(tmp0)*100+$(tmp1)*10)]
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
val9=
val10=
!for val11 =1 to 4 
val12=$[rint($val8+$val11)]
val13=$[($val7+$val8+$val11)/10]
tmp0=!append item $val13 to $val9

val9=$(tmp0)
!if $val12<>10 
!readproc slib/numeration/ecriturenombre $val13 
tmp0=$slib_out
val13=$(tmp0)
!else
!readproc slib/numeration/ecriturenombre $val13 
tmp0=$slib_out
val13=$(tmp0).0
!endif
tmp0=!append item $val13 to $val10

val10=$(tmp0)
!next
tmp0=!randint 501, 999

val14=$[$(val9[2])-$(tmp0)/10000]
!readproc slib/numeration/ecriturenombre $val14 
tmp0=$slib_out
val14=$(tmp0)
tmp0=!randint 1, 499

val15=$[$(val9[2])-$(tmp0)/10000]
!readproc slib/numeration/ecriturenombre $val15 
tmp0=$slib_out
val15=$(tmp0)
tmp0=!randint 501, 999

val16=$[$(val9[4])-$(tmp0)/10000]
!readproc slib/numeration/ecriturenombre $val16 
tmp0=$slib_out
val16=$(tmp0)
tmp0=!randint 1, 499

val17=$[$(val9[4])-$(tmp0)/10000]
!readproc slib/numeration/ecriturenombre $val17 
tmp0=$slib_out
val17=$(tmp0)
val18=$val14,$val15,$val16,$val17
replytype1=correspond
replyname1=
replygood1=$val18;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<div class="wimscenter">  
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

