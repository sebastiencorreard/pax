!set title=Rang 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes,cent millièmes
val7=unités,dizaines,centaines,milliers,dix milliers,cent milliers
val8=Réécrire,	  en plaçant correctement la virgule pour que le chiffre,soit le chiffre des 
tmp0=!shuffle 9

val9=$(tmp0)
tmp0=!randint 4, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
!if $val11=1 
tmp0=!randint 1, $val10-3

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val10-$val12

val13=$[rint($(tmp0))]
!else
tmp0=!randint $val10-2, $val10-1

val12=$[rint($(tmp0))]
tmp0=!randint 2, $val12

val13=$[rint($(tmp0))]
!endif
val14=$[rint(0)]
!for val15 =1 to $val10 
val14=$[rint($val14+$(val9[$val15])*10^($val10-$val15))]
!next
val16=$[$val14/10^$val12]
!if $val11=1 
val17=$[rint($(val9[$val10-$val12-$val13+1]))]
val18=$(val7[$val13])
!else
val17=$[rint($(val9[$val10-$val12+$val13-1]))]
val18=$(val6[$val13])
!endif
val19=$(val8[1]) $val14 $(val8[2]) $val17 $(val8[3]) $val18.
val20=$[rint(10)]
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val19 \(\dots\dots\) \end{statement} 


!goto stat

!exit

