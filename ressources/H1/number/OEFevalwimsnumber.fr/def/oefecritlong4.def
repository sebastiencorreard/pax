!set title=Mesure de longueur 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter l'égalité&nbsp;
val7=km,hm,dam,m,dm,cm,mm
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 6

val9=$[rint($(tmp0))]
tmp0=!randint $val9+1, 7

val10=$[rint($(tmp0))]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val11=$(tmp0),$(tmp1),$(tmp2)
val12=$[$(val11[1])*10^(4-$val8)+$(val11[2])*10^(4-$val9)+$(val11[3])*10^(4-$val10)]
val13=$val6
val14=$val12 m
val15=$[rint(8)]
replytype1=menu
replyname1=
replygood1=$val8;$val7
replytype2=menu
replyname2=
replygood2=$val9;$val7
replytype3=menu
replyname3=
replygood3=$val10;$val7
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val13 \begin{center} $val14=$(val11[1]) \(\dots\dots\) + $(val11[2]) \(\dots\dots\) + $(val11[3]) \(\dots\dots\)?. \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val13:	<div class="wimscenter">	$val14=$(val11[1])  
!read oef/embed.phtml r1,$val15 
$() + $(val11[2])  
!read oef/embed.phtml r2,$val15 
$() + $(val11[3])  
!read oef/embed.phtml r3,$val15 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val13 $m_begin{center} $val14=$(val11[1]) 
!insmath \dots\dots
$() + $(val11[2]) 
!insmath \dots\dots
$() + $(val11[3]) 
!insmath \dots\dots
$()?. $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,13,14,15
embedcnt=3
