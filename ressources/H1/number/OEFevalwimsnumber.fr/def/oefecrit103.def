val6=Compléter&nbsp;
tmp0=!randint 2, 3

val7=$[rint($(tmp0))]
tmp0=!shuffle 9

val8=$(tmp0)
val9=
!for val10 =2 to $val7 
tmp0=!append item $(val8[$val10]) to $val9

val9=$(tmp0)
!next
tmp0=!append item 0 to $val9

val9=$(tmp0)
tmp0=!shuffle $val9

val9=$(tmp0)
val9=$(val8[1]),$val9
tmp0=!append item $(val8[$val7 + 1]) to $val9

val9=$(tmp0)
val11=$[rint(0)]
!for val12 =1 to $val7 + 2 
val11=$[rint($val11+$(val9[$val12])*10^($val12-1))]
!next
val13=
!for val10 =1 to $val7 + 2 
tmp0=!positionof item 0 in $val9

val13=$(tmp0)
!next
val14=$[rint(0)]
!for val12 =1 to $val13 - 1 
val14=$[rint($val14+$(val9[$val12])*10^($val12-1))]
!next
val15=$[rint(0)]
!for val12 =$val13 + 1  to $val7 + 2 
val15=$[rint($val15+$(val9[$val12])*10^($val12-1-$val13))]
!next
val16=1,10,100,1 000,10 000,100 000
val17=$[rint(5)]
val18=$(val16[$val13 + 1])
val19=1
replytype1=numeric
replyname1=
replygood1=$[$val18]
replytype2=numeric
replyname2=
replygood2=$[$val19]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val6: \($val11 = ($val15 x \cdots\cdots) + ($val14 x \cdots)\) \end{statement} 


!goto stat

!exit

