!set title=Fraction décimale suite 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver le nombre décimal
val7=Trouver le nombre décimal&nbsp;
tmp0=!shuffle 3

val8=$(tmp0)
tmp0=!item 1 to 2 of $val8

val8=$(tmp0)
tmp0=!sort items $val8

val8=$(tmp0)
tmp0=!randint 1, 10^$(val8[1])-1

val9=$[rint($(tmp0))]
tmp0=!randint 10^$(val8[2])-$val9*10^($(val8[2])-$(val8[1])), 10^$(val8[2])-1

val10=$[rint($(tmp0))]
val11=$[$val9/10^$(val8[1])+$val10/10^$(val8[2])]
val12=$[rint(10^$(val8[1]))]
val13=$[rint(10^$(val8[2]))]
val14=$[rint(8)]
val15=$[rint(0)]

!ifval $val15<>0 
val16= $val15 +
!else
val16=
!endif
replytype1=atext
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7: \begin{center}\( $val16 \frac{$val9}{$val12} + \frac{$val10}{$val13} =\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()$val7&nbsp;:	<div class="wimscenter">	<label for="reply1">
!insmath 	$val16	\frac{$val9}{$val12} + \frac{$val10}{$val13} 
$()</label>	= 
!read oef/embed.phtml r1,$val14 
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7: $m_begin{center}
!insmath  $val16 \frac{$val9}{$val12} + \frac{$val10}{$val13} =
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,12,13,14,16
embedcnt=1
