!set title=Intercaler 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver un nombre à intercaler&nbsp;
val7=\(\Large{<}\),\(\Large{>}\),\(\Large{=}\)
tmp0=!randint 100, 999

val8=$[rint($(tmp0))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
val10=$[rint($val8+$val9)]
val8=$[$val8/10]
val10=$[$val10/10]
val11=$val6
val12=$(val7[$m_1]) $val10
val13=6
replytype1=numeric
replyname1=
replygood1=?analyze 14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val11 \begin{center} $val8 $(val7[1]) \(\dots\dots\) $val12 \end{center} \end{statement} 


!goto stat

!exit

:question
$()$val11&nbsp;:	  <div class="wimscenter">	  <label for="reply1">$val8 $(val7[1])</label>  
!read oef/embed.phtml r1,$val13 
$() $val12	  </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val11 $m_begin{center} $val8 $(val7[1]) 
!insmath \dots\dots
$() $val12 $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!ifval $val14>$val8 and $val14<$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=7,8,10,11,12,13,14
embedcnt=1
