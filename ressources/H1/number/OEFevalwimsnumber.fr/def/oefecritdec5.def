!set title=Écriture d'un nombre décimal 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000000

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes,cent millièmes
val7=unités,dizaines,centaines,milliers,dix milliers,cent milliers
val8=Recopier le nombre,sans les zéros inutiles&nbsp;
val9=0
val9=$val9 .
tmp0=!randint 0, 3

val10=$[rint($(tmp0))]
!for val11 =1 to $val10 
val9=$val9 0
!next
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!for val11 =1 to $val12 
tmp0=!randint 1, 9

val9=$val9 $(tmp0)
!next
tmp0=!randint 1, 5-$val10

val13=$[rint($(tmp0))]
!for val11 =1 to $val13 
val9=$val9 0
!next
tmp0=!nospace $val9

val9=$(tmp0)
val14=$[$val9]
val15=$(val8[1]) $val9 $(val8[2]): 
val16=$val14
val17=$[rint(15)]
replytype1=atext
replyname1=
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val15: \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()	$val15	 
!read oef/embed.phtml r1,$val17 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val15: 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15,17
embedcnt=1
