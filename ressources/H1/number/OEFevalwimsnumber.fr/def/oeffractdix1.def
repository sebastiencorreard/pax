!set title=Fraction décimale suite 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Trouver le nombre décimal
val7=Trouver le nombre décimal&nbsp;
val8=$[rint(2)]
tmp0=!randint 1, 99

val9=$[rint($(tmp0))]
tmp0=!randint 1, 99-$val9

val10=$[rint($(tmp0))]
val11=$[($val9+$val10)/10^2]
val12=$[rint(100)]
val13=$[rint(100)]
val14=$[rint(8)]
val15=$[rint(0)]

!ifval $val15<>0 
val16= $val15 +
!else
val16=
!endif
replytype1=atext
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7: \begin{center}\( $val16 \frac{$val9}{$val12} + \frac{$val10}{$val13} =\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()$val7&nbsp;:	<div class="wimscenter">	<label for="reply1">
!insmath 	$val16	\frac{$val9}{$val12} + \frac{$val10}{$val13} 
$()</label>	= 
!read oef/embed.phtml r1,$val14 
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7: $m_begin{center}
!insmath  $val16 \frac{$val9}{$val12} + \frac{$val10}{$val13} =
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,12,13,14,16
embedcnt=1
