 !exit
!endif

val6=Encadrer le nombre à l'unité près
val7=\(\Large{< }\),\(\Large{>}\), \(\Large{=}\)
tmp0=!randint 0, 9

tmp1=!randint 1, 9

tmp2=!randint 1, 9

tmp3=!randint 1, 9

val8=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
val9=$(val8[1]),$(val8[2]),0,0
val10=$[rint(0)]
val11=$[rint(0)]
!for val12 =1 to 4 
val10=$[$val10+$(val8[$val12])/10^($val12-2)]
val11=$[$val11+$(val9[$val12])/10^($val12-2)]
!next
val13=$[$val11+1]
val14=$val6
val15=$(val7[1]) $val10 $(val7[1]) 
val16=6
val17=atext
val18=
replytype1=$val17

replyname1=
replygood1=$val11
replytype2=$val17

replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val14: \begin{center} \(\dots\dots\) $val15 \(\dots\dots\) \end{center} $val18 \end{statement} 


!goto stat

!exit

:question
$()$val14: <div class="wimscenter"> 
!read oef/embed.phtml r1,$val16 
$()	$val15  
!read oef/embed.phtml r2,$val16 
$()	</div>
$()
!exit

