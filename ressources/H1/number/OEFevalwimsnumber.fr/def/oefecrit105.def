val6=Compléter&nbsp;
tmp0=!randint 1, 3

val7=$[rint($(tmp0))]
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!shuffle 9

val10=$(tmp0)
val11=
!for val12 =1 to $val7 
tmp0=!append item $(val10[$val12]) to $val11

val11=$(tmp0)
!next
val13=
!for val12 =1 to $val8 
tmp0=!append item $(val10[$val7+$val12]) to $val13

val13=$(tmp0)
!next
val14=$[rint(0)]
!for val15 =1 to $val7 
val14=$[rint($val14+$(val11[$val15])*10^($val7-$val15))]
!next
val16=$[rint(0)]
!for val15 =1 to $val8 
val16=$[rint($val16+$(val13[$val15])*10^($val8-$val15))]
!next
val17=$[rint($val14*10^($val9+$val8)+$val16)]
tmp0=!shuffle \n+1

val18=$(tmp0)
val19=1,10,100,1 000,10 000,100 000
val20=$[rint(5)]
replytype1=numeric
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val6: ($val14 x $(val19[$val8+$val9 + 1])) + ($val16 x 1) \end{statement} 


!goto stat

!exit

