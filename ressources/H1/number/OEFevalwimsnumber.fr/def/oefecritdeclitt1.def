!set title=Écriture décimale suite 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=unités,dixièmes,centièmes,millièmes,dix millièmes
val7=Écrire le nombre décimal suivant sans zéro inutile&nbsp;
tmp=!trim 1,2,4	1,2,5	1,3,4	1,3,5	1,4,5
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val10=2,3,4,5,6,7,8,9
tmp0=!shuffle $val10

val10=$(tmp0)
val11=$[$(val10[1])+$(val10[2])/10^($(val8[2])-1)+$(val10[3])/10^($(val8[3])-1)]
val12=$val7
val13=$[rint(8)]
val14=$(val10[1]) $(val6[1]) $(val10[2]) $(val6[$(val8[2])]) $(val10[3]) $(val6[$(val8[3])])=
replytype1=atext
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12: \begin{center} $val14 \(\dots\dots\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val12:	<div class="wimscenter">	$val14	 
!read oef/embed.phtml r1,$val13 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val12: $m_begin{center} $val14 
!insmath \dots\dots
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,14
embedcnt=1
