!set title=Valeur approchée 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
language=fr
precision=10000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le nombre, est la valeur approchée,près, du nombre
val7=à l'unité,au dixième,au centième,au millième,à la dizaine,à la centaine
tmp0=!randitem +,-

val8=$(tmp0)
tmp0=!randint 0, 9

tmp1=!randint 1, 9

val9=$[rint($(tmp0)*100+$(tmp1)*10)]
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!randint 10^($val10-1), 10^$val10

val11=$[rint($(tmp0))]
val9=$[$val9-$val11/10^($val10-1)]
tmp0=!randint 1, 499

val12=$[rint($(tmp0))]
val13=$[$val9$val8$val12/10^($val10+2)]
!readproc slib/numeration/ecriturenombre $val13 
tmp0=$slib_out
val13=$(tmp0)
tmp0=!replace internal . by , in $val13

val13=$(tmp0)
!readproc slib/numeration/ecriturenombre $val9 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!replace internal . by , in $val9

val9=$(tmp0)
replytype1=menu
replyname1=
replygood1=$val10;$val7
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val6[1]) $val9 $(val6[2]) \(\cdots\) $(val6[3]) $(val6[4]) $val13. \end{statement} 


!goto stat

!exit

:question
$()	$(val6[1]) $val9 $(val6[2])  
!read oef/embed.phtml r1 
$() $(val6[3]) $(val6[4]) $val13.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val6[1]) $val9 $(val6[2]) 
!insmath \cdots
$() $(val6[3]) $(val6[4]) $val13. $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,13
embedcnt=1
