!set title=Associer une situation à une opération
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=addition,subtraction,relative_number
computeanswer=no
precision=10000
oefcss=<style> .macss{background-color: #FAFAD2;} .underline {text-decoration-line: underline;} </style>

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 2, 10

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
tmp=!trim La température descend de $val8&nbsp°C puis descend de $val7&nbsp;°C.,\( (-$val8) + (-$val7) \),\( - $val8 - $val7 \)	La température monte de $val8&nbsp;°C puis monte de $val7&nbsp;°C., \( (+$val8) + (+$val7) \),\( $val8 + $val7 \)	La température monte de $val8&nbsp;°C puis descend de $val7&nbsp;°C., \( (+$val8) + (-$val7) \),\( $val8 - $val7 \)	La température descend de $val8&nbsp;°C puis monte de $val7&nbsp;°C., \( (-$val8) + (+$val7) \),\( -$val8 + $val7 \)
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $val6 descend de $val8 étages puis descend de $val7 étages.,\( (-$val8) + (-$val7) \),\( - $val8 - $val7\)	$val6 monte de $val8 étages puis monte de $val7 étages., \( (+$val8) + (+$val7) \),\( $val8 + $val7 \)	$val6 monte de $val8 étages puis descend de $val7 étages., \( (+$val8) + (-$val7) \),\( $val8 - $val7 \)	$val6 descend de $val8 étages puis monte de $val7 étages., \( (-$val8) + (+$val7) \),\( -$val8 + $val7 \)
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!trim $val6 perd $val8&nbsp;€ puis perd $val7&nbsp;€.,\( (-$val8) + (-$val7) \),\( - $val8 - $val7\)	$val6 gagne $val8&nbsp;€ puis gagne $val7&nbsp;€., \( (+$val8) + (+$val7) \),\( $val8 + $val7 \)	$val6 gagne $val8&nbsp;€ puis perd $val7&nbsp;€., \( (+$val8) + (-$val7) \),\( $val8 - $val7 \)	$val6 perd $val8&nbsp;€ puis gagne $val7&nbsp;€., \( (-$val8) + (+$val7) \),\( -$val8 + $val7 \)
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 3

val12=$[rint($(tmp0))]
!if $val12=1 
tmp=!trim $val9
val13=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val12=2 
tmp=!trim $val10
val13=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val12=3 
tmp=!trim $val11
val13=!translate internal $	\
$ to ;; in $tmp
!endif
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$(val13[;1]);$(val13[;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Associer chaque phrase à l'addition qui lui correspond.	
!if $val12=3 
$()<p>Lors d'un jeu de hasard,</p> 
!endif
$()	<div class="wimscenter"> 
!read oef/embed.phtml reply1,75x160x2x3 
$()</div>
$()
!exit

