!set title=Nombre relatif
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=addition,subtraction,relative_number
computeanswer=no
precision=10000
oefcss=<style> .macss{background-color: #FAFAD2;} .underline {text-decoration-line: underline;} </style>

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 100

val6=$[rint($(tmp0))]
val7=+,-
tmp0=!randitem +,-

val8=$(tmp0)
!if $val8=+ 
val9=positif
val10=\plus
!else
val9=négatif
val10=\minus
!endif
val11=positif,négatif
replytype1=clickfill
replyname1=
replygood1=$val9;$val11
replytype2=numeric
replyname2=
replygood2=$[$val6]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Un nombre relatif est composé d'un signe ( positif ou négatif ) et d'une partie numérique appelée distance à zéro.

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Compléter les phrases suivantes :	<ul>	<li>Le signe de 
!insmath $val10 $val6
$() est ...  
!read oef/embed.phtml r1,60x30 
$().</li>	<li><label for="reply2">La distance à zéro de 
!insmath  $val10 $val6 
$() est ...</label>  
!read oef/embed.phtml reply2,3 
$().</li>	</ul>
$()
!exit

:hint
$()Un nombre relatif est composé d'un signe ( positif ou négatif ) et d'une partie numérique appelée distance à zéro.
$()
!exit

:help
$()
$()
!exit

:solution
$()	<ul>	<li>Le signe de 
!insmath  $val10 $val6 
$() est ... $val9.</li>	<li>La distance à zéro de 
!insmath  $val10 $val6 
$() est ... 
!insmath $val6
$().</li>	</ul>
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply2<0
 <div class='oef_feedbacks'><div class="macss"><b>Une distance à zéro est toujours positive.</b></div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,9,10
embedcnt=2
