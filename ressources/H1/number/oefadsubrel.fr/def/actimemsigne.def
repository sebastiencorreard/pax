!endif

tmp0=!shuffle +,-

val6=$(tmp0)
val7=$(val6[1])
!if $val7=+ 
val8=positif,positifs
val9=\plus
!else
val8=négatif,négatifs
val9=\minus
!endif
val10=$val7
val11=$val9
val12=$val8
!if $val10=+ 
val13=positif,positifs
val14=\plus
!else
val13=négatif,négatifs
val14=\minus
!endif
tmp0=!makelist x for x=1 to 10

val15=$(tmp0)
!readproc slib/data/random 2,item, $val15 
tmp0=$slib_out
val16=$(tmp0)
val17=$[rint($(val16[1]))]
val18=$[rint($(val16[2]))]
val19=$[$val7$val17+$val10$val18]
!if $val19>0 
val20=\plus
!endif
val21=$[rint(abs($val19))]
val22=$[rint($val17+$val18)]
val23=$[rint(abs($val17-$val18))]
!if $val17>$val18 
val24=\($val17 - $val18 = $val21 \)
val11=$val9
val12=$val8
val25=<ul><li>On détermine le signe de \(A\) en comparant les distances à zéro des termes de la somme&nbsp;:	<p>Comme \($val17>$val18\) et que \($val9$val17\) est $(val8[1]) alors le signe de \(A\) est $(val12[1]).</p></li>	<li>On effectue la différence des distances à zéro $val24.</li>	</ul>
!else
val24=\($val18 - $val17 = $val21 \)
val11=$val14
val12=$val13
val25=<ul><li>On détermine le signe de \(A\) en comparant les distances à zéro des termes de la somme&nbsp;:	<p>Comme \($val18>$val17\) et que \($val14$val18\) est $(val13[1]) alors le signe de \(A\) est $(val12[1]).</p></li>	<li>On effectue la différence des distances à zéro $val24.</li>	</ul>
!endif
!if $val7=+ 
val26=$[rint(-1)]
val27=$[rint($val17+$val18+2)]
!endif
!if $val7=- 
val27=$[rint(1)]
val26=$[rint(-$val17-$val18-2)]
!endif
val28=$[rint(600)]
val29=$[rint(40)]
val30=$[($val28-2*$val29)/($val27-$val26)]
val31=$[$val26-$val29/$val30]
val32=$[$val27+$val29/$val30]
val33=$[rint($val27-$val26+1)]
val34=$[rint($val27-$val26)]
val35=$[4/$val30]
val36=
!for val37 =0 to $val34 
val38=$[rint($val26+$val37)]
val39=$[$val26+$val37-$val35]
val40=text black,$val39,-0.75,giant,$val38
tmp0=!append line $val40 to $val36

val36=$(tmp0)
!next
val41=range $val31,$val32,-3,3	linewidth 2	arrow $val31,0,$val32,0,$val29/2,black	linewidth 3	parallel $val26,-0.5,$val26,0.5,1,0,$val33,black	$val36
!readproc oef/draw.phtml 600,150 \
$val41	arrow 0,1,$val7 $val17,1,10,blue	text blue,($val7 $val17)/2,1,giant,$val7 $val17	arrow 0,1.5,$val10 $val18,1.5,10,red	text red,($val10 $val18)/2,1.5,giant,$val10 $val18	 
tmp0=$ins_url
val42=$(tmp0)
!readproc oef/draw.phtml 600,150 \
$val41	arrow 0,1,$val7 $val17,1,10,blue	text blue,($val7 $val17)/2,1,giant,$val7 $val17	translate $val7 $val17,0	arrow 0,1.5,$val10 $val18,1.5,10,red	text red,($val10 $val18)/2,1.5,giant,$val10 $val18	killtranslate	 
tmp0=$ins_url
val43=$(tmp0)
