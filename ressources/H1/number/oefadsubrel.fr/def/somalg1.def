!set title=Calcul d'une somme algébrique 1 (guidé)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=addition,subtraction,relative_number
computeanswer=no
precision=10000
oefcss=<style> .macss{background-color: #FAFAD2;} .underline {text-decoration-line: underline;} </style>

ansorder=r,r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

tmp1=!randitem +,-

tmp2=!randitem +,-

val6=+,-,$(tmp0),$(tmp1),$(tmp2)
tmp0=!shuffle $val6

val6=$(tmp0)
val7=$(val6[1])
val8=r1,r2	r3
tmp0=!randitem +,+

tmp1=!randitem +,+

tmp2=!randitem +,+

tmp3=!randitem +,+

val9=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
!for val10 =2 to 5 
!if $(val9[$val10-1])=$(val6[$val10]) 
val7=$val7,+
!else
val7=$val7,-
!endif
!next
tmp0=!shuffle 9

val11=$(tmp0)
val12=$(val6[1])$(val11[1])
!for val13 =2 to 5 
val12=$val12,$(val9[$val13-1])($(val6[$val13]) $(val11[$val13]))
!next
val14=$[$(val12[1])+$(val12[2])+$(val12[3])+$(val12[4])+$(val12[5])]
val15=$[0]
val16=$[0]
val17=
val18=
!for val19 =1 to 5 
!if $(val6[$val19])=+ 
val15=$[$(val6[$val19])$(val11[$val19])+$val15]
val17=$val17,($(val6[$val19])$(val11[$val19]))
!else
val16=$[$(val6[$val19])$(val11[$val19])+$val16]
val18=$val18,($(val6[$val19])$(val11[$val19]))
!endif
!next
tmp0=!nonempty item $val17

val17=$(tmp0)
tmp0=!replace internal , by \plus in $val17

val20=$(tmp0)
tmp0=!nonempty item $val18

val18=$(tmp0)
tmp0=!replace internal , by \plus in $val18

val21=$(tmp0)
oefsteps=$val8 
nextstep=!nosubst $val8 
!readproc oef/steps.proc
replytype1=numexp
replyname1=Somme des nombres positifs
replygood1=$val15
replytype2=numexp
replyname2=Somme des nombres négatifs
replygood2=$val16
replytype3=numexp
replyname3=A
replygood3=$val14
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Pour calculer une somme algébrique, on effectue la somme des nombres positifs et la somme des nombres négatifs puis on conclut.

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On veut calculer l'expression&nbsp;:	<p><span class="nowrap">
!insmath A=
$()	 
!for m_i=1 to 5 
$()
!insmath ( $(val6[$m_i]) $(val11[$m_i]) ) $(val9[$m_i])
$() 
!next
$().</span></p>	
!if $m_step=1 
$()<b class="underline">Étape 1&nbsp;:</b> Calculer les sommes suivantes&nbsp;:	<ul>	<li><label for="reply1">La somme des nombres positifs&nbsp;: </label> 
!read oef/embed.phtml r1,3 
$().</li>	<li><label for="reply2">La somme des nombres négatifs&nbsp;: </label> 
!read oef/embed.phtml r2,3 
$().</li>	</ul> 
!endif
$()	
!if $m_step=2 
$()
!insmath  A = \left( + $val15 \right) + \left( $val16 \right)
$()	<p><b class="underline">Étape 2&nbsp;:</b> Conclure</p>	<label for="reply3">
!insmath  A=
$()</label> 
!read oef/embed.phtml r3,3 
$(). 
!endif
$()
$()
!exit

:hint
$()Pour calculer une somme algébrique, on effectue la somme des nombres positifs et la somme des nombres négatifs puis on conclut.
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath A=( $(val6[1]) $(val11[1]) ) $(val9[1]) ( $(val6[2]) $(val11[2]) ) $(val9[2]) ( $(val6[3]) $(val11[3]) ) $(val9[3]) ( $(val6[4]) $(val11[4]) ) $(val9[4]) ( $(val6[5]) $(val11[5]) )
$()	<p>
!insmath A=$val20 + $val21
$()	<ul><li>La somme des nombres positifs est <span class="nowrap">
!insmath  $val20 = $val15 
$().</span></li>	<li>La somme des nombres négatifs est <span class="nowrap">
!insmath  $val21 = $val16 
$().</span></li></ul>	<p>Ainsi,</p>	
!insmath A=( $(val6[1]) $(val11[1]) ) $(val9[1]) ( $(val6[2]) $(val11[2]) ) $(val9[2]) ( $(val6[3]) $(val11[3]) ) $(val9[3]) ( $(val6[4]) $(val11[4]) ) $(val9[4]) ( $(val6[5]) $(val11[5]) )
$()	<p>
!insmath A=$val20 + $val21
$()</p>	
!insmath  A = ( + $val15 ) + ( $val16 )
$()	<p>
!insmath  A= $val14
$()</p>
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,11,14,15,16,20,21
embedcnt=3
