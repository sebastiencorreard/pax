!set title=Addition de nombres relatifs de signes contraires
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel, Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=addition,subtraction,relative_number
computeanswer=no
precision=10000
oefcss=<style> .macss{background-color: #FAFAD2;} .underline {text-decoration-line: underline;} </style>

ansorder=r
varcnt=32
prevarcnt=30
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle +,-

val6=$(tmp0)
val7=positif,négatif
val8=$(val6[1])
!if $val8=+ 
val9=\plus
val10=positif,positifs
!else
val9=\minus
val10=négatif,négatifs
!endif
val11=$(val6[2])
!if $val11=+ 
val12=\plus
val13=positif,positifs
!else
val12=\minus
val13=négatif,négatifs
!endif
tmp0=!makelist x for x=1 to 50

val14=$(tmp0)
!readproc slib/data/random 2,item, $val14 
tmp0=$slib_out
val15=$(tmp0)
val16=$[rint($(val15[1]))]
val17=$[rint($(val15[2]))]
val18=$[$val8$val16+$val11$val17]
val19=$[rint(abs($val18))]
val20=$[rint($val16+$val17)]
val21=$[rint(abs($val16-$val17))]
!if $val16>$val17 
val22=\($val16 - $val17 = $val19 \)
val23=$val9
val24=$val8
val25=$(val10[1])
val26=Comme les deux nombres sont de signes contraires et que <span class="nowrap">\($val16>$val17\),</span>	<ul><li>le signe de \(A\) est $(val25[1]),</li>	<li>la distance à zéro de \(A\) est <span class="nowrap">$val22.</span></li>	</ul>
!else
val22=\($val17 - $val16 = $val19 \)
val23=$val12
val24=$val11
val25=$(val13[1])
val26=Comme les deux nombres sont de signes contraires et que <span class="nowrap">\($val17>$val16\),</span>	<ul><li>le signe de \(A\) est $(val25[1]),</li>	<li>la distance à zéro de \(A\) est <span class="nowrap">$val22.</span></li>	</ul>
!endif
replytype1=numexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst La somme de deux nombres de signes contraires &nbsp;: <ul> <li>a pour signe&nbsp;: le signe du nombre qui a la plus grande distance à zéro,</li> <li>a pour distance à zéro &nbsp;: la différence des distances à zéro.</li></ul>

solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression&nbsp;:	<p>
!insmath A=( $val9 $val16 ) + ( $val12 $val17 )
$()</p>	<label for="reply1">
!insmath A=
$()</label> 
!read oef/embed.phtml r1,3 
$().	
$()
!exit

:hint
$()La somme de deux nombres de signes contraires &nbsp;: <ul> <li>a pour signe&nbsp;: le signe du nombre qui a la plus grande distance à zéro,</li> <li>a pour distance à zéro &nbsp;: la différence des distances à zéro.</li></ul>
$()
!exit

:help
$()
$()
!exit

:solution
$() $val26	<p>
!insmath A=( $val9 $val16 ) + ( $val12 $val17 )
$()</p>	<span class="nowrap">
!insmath A = $val18 
$().</span>
$()
!exit

:latex
$()
$()
!exit

:postdef
val21=$[rint($val16+$val17)]

!exit

:feedback
!ifval $m_reply1=$val21
 <div class='oef_feedbacks'><div class="macss">Vous avez additionné les distances à zéro au lieu de les soustraire.</div>
$()</div>
!endif
!ifval ($m_reply1<0 and $val18>0 ) or ($m_reply1>0 and $val18<0 )
 <div class='oef_feedbacks'><div class="macss">Vous vous êtes trompé dans le signe de <span class="nowrap">
!insmath A
$().</span></div>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=9,12,16,17,18,21,26
embedcnt=1
