\title{Soustraction de nombres relatifs}
\integer{nb1=randint(11..19)}
\integer{nb2=randint(4..9)}
\text{sign1=random(+,-)}
\text{sign2=random(+,-)}
\text{liste=+,-}
\if{\sign2=+}{\integer{rep=-\nb2}
\text{trep=\minus \nb2}}{\text{rep=+\nb2}
\text{trep=\plus \nb2}
}
\real{res=\sign1\nb1-\sign2\nb2}
\if{\res>0}{\text{signres=positif}}
\if{\res<0}{\text{signres=négatif}}
\statement{<p>Calculer&nbsp;: \( A = ( \sign1 \nb1 ) - ( \sign2 \nb2 ) \)</p>
<label for="reply1">\(A=\)</label>\embed{reply1,4}}
\answer{}{\res}{type=numexp}
\hint{Soustraire un nombre, c'est ajouter son opposé.}
\solution{\( A = ( \sign1 \nb1 ) - ( \sign2 \nb2 ) \)
<p>On transforme la soustraction en addition de l'opposé.</p>
\( A=( \sign1 \nb1 ) + ( \trep )\)
<p>On conclut.</p>
\(A=\res\)}
\feedback{\reply1=-\res}{<div class="macss">Attention, vous avez donné l'opposé de la bonne réponse.
