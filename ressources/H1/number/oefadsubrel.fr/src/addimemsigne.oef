\title{Addition de nombres relatifs de même signe}
\text{signe=shuffle(+,-)}
\text{ttsigne=positif,négatif}
\text{sign1=\signe[1]}
\if{\sign1=+}{\text{tsign1=\plus}
\text{ttsign1=positif,positifs}}{\text{tsign1=\minus}
\text{ttsign1=négatif,négatifs}}
\text{sign2=\sign1}
\text{signerep=\sign1}
\text{ttsignerep=\ttsign1[1]}



\if{\sign2=+}{\text{tsign2=\plus}
\text{ttsign2=positif,positifs}}{\text{tsign2=\minus}
\text{ttsign2=négatif,négatifs}}
\text{liste=wims(makelist x for x=1 to 50)}
\text{A=slib(data/random 2,item, \liste)}
\integer{nb1=\A[1]}
\integer{nb2=\A[2]}
\real{res=\sign1\nb1+\sign2\nb2}
\integer{daz=abs(\res)}
\integer{nb=\nb1+\nb2}
\integer{er=abs(\nb1-\nb2)}
\if{\nb1>\nb2}{\text{dist=\(\nb1 - \nb2 = \daz \)}
\text{tsignerep=\tsign1}
\text{signerep=\sign1}
\text{ttsignerep=\ttsign1[1]}
\text{solu=Comme les deux nombres sont de signes contraires et que <span class="nowrap">\(\nb1>\nb2\),</span>
<ul><li>le signe de \(A\) est \ttsignerep[1],</li>
<li>la distance à zéro de \(A\) est <span class="nowrap">\dist.</span></li>
</ul>}
}{\text{dist=\(\nb2 - \nb1 = \daz \)}
\text{tsignerep=\tsign2}
\text{signerep=\sign2}
\text{ttsignerep=\ttsign2[1]}
\text{solu=Comme les deux nombres sont de signes contraires et que <span class="nowrap">\(\nb2>\nb1\),</span>
<ul><li>le signe de \(A\) est \ttsignerep[1],</li>
<li>la distance à zéro de \(A\) est <span class="nowrap">\dist.</span></li>
</ul>}
}
\statement{
Calculer l'expression&nbsp;:
<p>\(A=( \tsign1 \nb1 ) + ( \tsign2 \nb2 )\)</p>
<label for="reply1">\(A=\)</label>\embed{r1,3}.
}
\answer{}{\res}{type=numexp}
\hint{La somme de deux nombres relatifs de même signe&nbsp;:
<ul>
<li>a pour signe&nbsp;: le signe commun aux deux nombres.</li>
<li>a pour distance à zéro&nbsp;: la somme des deux distances à zéro.</li>
</ul>}
\integer{er=abs(\nb1-\nb2)}
\feedback{abs(\reply1)=\er}{<div class="macss">Vous avez soustrait les distances à zéro au lieu de les additionner.</div>}
\feedback{(\reply1<0 and \res>0 ) or (\reply1>0 and \res<0 )}{<div class="macss">Vous vous êtes trompé dans le signe de <span class="nowrap">\(A\).</span></div>}
\solution{<p>Pour calculer l'expression \(A=( \sign1 \nb1 ) + ( \sign1 \nb2 )\).</p>
On détermine son signe et sa distance à zéro&nbsp;:
<ul>
<li>\(A\) est \ttsign1[1] car \(A\) est la somme de deux nombres \ttsign1[2].</li>
<li>la distance à zéro de \(A\) est <span class="nowrap">\(\nb1+\nb2=\nb\).</span></li>
</ul>
\(A=( \tsign1 \nb1 ) + ( \tsign1 \nb2 )\)
<p><span class="nowrap">\(A= \res\).</span></p>}
