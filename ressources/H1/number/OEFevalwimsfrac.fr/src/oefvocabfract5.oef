\title{Vocabulaire 5}

\integer{f=randint(1..3)}
\if{\f=1}{\integer{d1=randint(1..9)}
\integer{d2=randint(2..20)}
\integer{n=random(2,3,4,5,6,10)}
\integer{d3=\d1*\n}
\integer{d4=\d2*\n}}

\if{\f=2}{\integer{d1=randint(1..9)}
\integer{d2=randint(2..20)}
\integer{d4=randint(2..20)}
\if{\d2=\d4}{\integer{d4=\d4+1}}
\integer{d3=\d1}}

\if{\f=3}{\integer{d1=randint(1..9)}
\integer{d2=randint(2..20)}
\integer{d3=randint(1..9)}
\if{\d1=\d3}{\integer{d3=\d3+1}}
\integer{d4=\d2}}
\text{enonc=Le deux fractions ont le même }
\text{rep=\nomb[\a]}

\integer{large=12}

\statement
{Nous avons les fractions suivantes :
<div class="wimscenter"> \(\frac{\d1}{\d2}) et  \(\frac{\d3}{\d4}) </div>
<div>\enonc \embed{r1,\large}</div>}

\answer{}{\f;quotient,numérateur,dénominateur,facteur,moniteur}{type=menu}
