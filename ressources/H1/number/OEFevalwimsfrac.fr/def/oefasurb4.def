!set title=Fraction et valeur décimale 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=correspond
val7=60x60
val8=1,2;1,4;2,4;3,4;1,5;2,5;3,5;4,5;3,6;1,8;2,8;3,8;4,8;5,8;6,8;7,8;1,10;2,10;3,10;4,10;5,10;6,10;7,10;8,10;9,10
tmp0=!shuffle 25

val9=$(tmp0)
val10=
val11=
val12=
val13=
!for val14 =1 to 4 
tmp=!translate internal $	$ to ; in $val8

tmp=!row $(val9[$val14]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$[$(val15[1])/$(val15[2])]
tmp0=!append item $(val15[1]) to $val10

val10=$(tmp0)
tmp0=!append item $(val15[2]) to $val11

val11=$(tmp0)
tmp0=!append item $val16 to $val12

val12=$(tmp0)
!next
val17=Mettre en relation la fraction avec sa valeur décimale :	<div class="wimscenter">
val18=\(\frac{$(val10[1])}{$(val11[1])}),\(\frac{$(val10[2])}{$(val11[2])}),\(\frac{$(val10[3])}{$(val11[3])}),\(\frac{$(val10[4])}{$(val11[4])})
val19=$(val12[1]),$(val12[2]),$(val12[3]),$(val12[4])
replytype1=$val6

replyoption1=shuffle 
replyname1=
replygood1=$val18;$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

