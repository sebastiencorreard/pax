!set title=Reconnaître une opération 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mettre en relation les fractions représentant le même nombre :
val7=correspond
val8=50x220
val9=a,demi,tiers,quarts,cinquièmes,a,a,a,a,dixièmes
tmp=!trim 3,10,2	3,10,4	3,10,5	3,5,2	3,5,4	3,5,10	3,4,2	3,4,5	3,4,10	4,10,2	4,10,3	4,10,5	4,5,2	4,5,3	4,5,10	5,10,2	5,10,3	5,10,4
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 18

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val12=Prendre les $(val10[3]) $(val9[$(val10[1])]) de $(val10[2]),	Prendre les $(val10[1]) $(val9[$(val10[2])]) de $(val10[3]),	Prendre les $(val10[2]) $(val9[$(val10[1])]) de $(val10[3]),	Prendre les $(val10[3]) $(val9[$(val10[2])]) de $(val10[1])
val13=\($(val10[2]) \times \frac{$(val10[3])}{$(val10[1])}),	\($(val10[3]) \times \frac{$(val10[1])}{$(val10[2])}),	\($(val10[3]) \times \frac{$(val10[2])}{$(val10[1])}),	\($(val10[1]) \times \frac{$(val10[3])}{$(val10[2])})
replytype1=$val7

replyoption1=shuffle 
replyname1=
replygood1=$val12;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val8 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=1
