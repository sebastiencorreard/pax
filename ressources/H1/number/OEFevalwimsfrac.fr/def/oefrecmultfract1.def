!set title=Reconnaître une opération 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Mettre en relation les fractions représentant le même nombre :
val7=correspond
val8=50x200
val9=2,3,4,5,10
tmp0=!randint 1, 5

val10=$[rint($(tmp0))]
tmp0=!randint 2, 9

val11=$[rint($(val9[$val10])*$(tmp0))]
val12=demi,tiers,quart,cinquième,dixième
val13=Calculer la différence entre $val11 et $(val9[$val10]),	Faire le produit de $val11 par $(val9[$val10]),	Trouver la somme de $val11 et $(val9[$val10]),	Prendre le $(val12[$val10]) de $val11
val14=\($val11 - $(val9[$val10])),	\($val11 \times $(val9[$val10])),	\($val11 + $(val9[$val10])),	\($val11 \times \frac{1}{$(val9[$val10])})	
replytype1=$val7

replyoption1=shuffle 
replyname1=
replygood1=$val13;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val8 
$()	</div>	
$()
!exit

