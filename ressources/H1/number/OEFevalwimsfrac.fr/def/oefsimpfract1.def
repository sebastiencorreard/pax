val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
!if $val6=2 
tmp0=!randitem 3,5,7,9

val7=$[rint($(tmp0))]
!endif
!if $val6=3 
tmp0=!randitem 2,4,5,7,8

val7=$[rint($(tmp0))]
!endif
!if $val6=4 
