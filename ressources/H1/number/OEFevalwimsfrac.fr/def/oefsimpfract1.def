val7=$[rint($(tmp0))]
!endif
!if $val6=8 
tmp0=!randitem 3,5,7,9

val7=$[rint($(tmp0))]
!endif
!if $val6=9 
tmp0=!randitem 2,4,5,7,8

val7=$[rint($(tmp0))]
!endif
!if $val6=$val7 
val7=$[rint($val6+1)]
!endif
val8=$[rint(2)]
val9=$[rint($val6*$val8)]
val10=$[rint($val7*$val8)]
val11=$val6
val12=$val7
val13=$[rint(3)]
replyname1=
replygood1=$val11
replyname2=
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Simplifier la fraction le mieux possible :	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\frac{$val9}{$val10} = \frac{reply1}{reply2}],$val13	reply1	reply2 
$()	</div>	
$()
!exit

