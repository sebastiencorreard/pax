!set title=Multiplication par 0,5 0,25 0,75 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

tmp1=!randitem 2,4,6

val6=$(tmp0),$(tmp1)
val7=$[rint($(val6[1])$(val6[2]))]
val8=$[rint($val7*4)]
val9=$[0.75]
val10=$[$val8*$val9]
!readproc slib/numeration/ecriturenombre $val10 
tmp0=$slib_out
val10=$(tmp0)
tmp0=!translate . to , in $val10

val10=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donnez le résultat de la multiplication :	<div class="wimscenter">	 $val8 
!insmath \times
$() $val9 =  
!read oef/embed.phtml r1,8 
$()	</div>	<div class="wims_instruction">Vous utiliserez la virgule comme séparateur décimal,	et vous respecterez l'espace tous les trois chiffres et éviterez les zéros inutiles.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=1
