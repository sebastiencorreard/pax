!set title=Lecture graphique 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni; Bernadette, Perrin-Riou
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=15
prevarcnt=13
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(2)]
val7=$[rint(10)]
val8=$[rint(3)]
val9=$[rint(0)]
val10=0
val11=
!for val12 =$val9 to $val8 
val10=$[rint($val12*1)]
val13=$[rint($val12)]
val11=$val11	      text blue, $val13,-1, medium,$val10
!next
val14=10
tmp0=!randint  11, 29

val15=$(tmp0)
t_=!rawmath $val15/$val14
val10=!exec pari print($t_)
replyname1=numérateur
replygood1=?analyze 16
replyname2=dénominateur
replygood2=?analyze 17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Nous avons une droite graduée. Le point indiqué par la flèche	a pour abscisse le quotient de deux entiers.	<p>Donner ce quotient :</p>	<table class="wimscenter wimsnoborder">	<tr><td> 
!read oef/embed.phtml reply1,3 
$()</td></tr>	<tr><td><hr></td></tr>	<tr><td> 
!read oef/embed.phtml reply2,3 
$()</td></tr>	</table>	<div class="wimscenter"> 
!read oef/draw.phtml 600,80 \
xrange $val9-0.1,$val8+0.1	yrange -2,2.2	hline black,0,0	parallel $val9,-0.8,$val9,0.4,1/$val6,0, 40, blue	parallel $val9,-0.3,$val9,0.3,1/$val7,0, 200, blue	parallel $val9,-0.8,$val9,0.6,1,0, 40, red	$val11	arrow $val10,2,$val10,0, 8, black	 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef

!ifval round($val16)=$val16 
val18= 1
!else
val18=0
!endif

!exit

:feedback

!exit

:test

!ifval $val18=1 and $val16/$val17=$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=6,7,8,9,10,11,16,17
embedcnt=2
