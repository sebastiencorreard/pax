!set title=Multiplier par une fraction 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
val9=$[rint(floor(9999/$val8))]
tmp0=!randint 3, $val9

val9=$[rint($(tmp0))]
val10=$[$val9*$val8/100]
val11=$[$val9*$val7/100]
val12=Calculer et donner le résultat :
!readproc slib/numeration/ecriturenombre $val11 
tmp0=$slib_out
val11=$(tmp0)
tmp0=!translate . to , in $val11

val11=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12	<div class="wimscenter">	
!insmath $val10 \times \frac{$val7}{$val8} 
$() =  
!read oef/embed.phtml r1,5 
$()	</div>	<div class="wims_instruction">Vous utiliserez la virgule comme séparateur décimal	et respecterez l'espace tous les trois chiffres et éviterez les zéros inutiles	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,12
embedcnt=1
