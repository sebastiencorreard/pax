!set title=Placer une fraction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(2)]
val7=$[rint(10)]
val8=$[rint(3)]
val9=$[rint(0)]
val10=0
val11=
!for val12 =$val9 to $val8 
val10=$[rint($val12*1)]
val13=$[rint($val12)]
val11=$val11	      text blue, $val13,-1, medium,$val10
!next
val14=10
tmp0=!randint  11, 29

val15=$(tmp0)
t_=!rawmath $val15/$val14
val10=!exec pari print($t_)
!readproc oef/draw.phtml 600,80 \
xrange $val9-0.1,$val8+0.1	yrange -2,2.2	hline black,0,0	parallel $val9,-0.8,$val9,0.4,1/$val6,0, 40, blue	parallel $val9,-0.3,$val9,0.3,1/$val7,0, 200, blue	parallel $val9,-0.8,$val9,0.6,1,0, 40, red	$val11 
tmp0=$ins_url
val16=$(tmp0)	
val17=$[rint(600/($val8*10+2))]
val18=$[rint($val17+(600-2*$val17)*$val15/($val8*$val14))]
replytype1=coord
replyname1=numérateur
replygood1=$val16;rectangle,$val18-3,35,$val18+3,45
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Nous avons une droite graduée. Placer le quotient	
!insmath \frac{$val15}{$val14}
$() en cliquant sur l'axe gradué.	<div class="wimscenter">	 
!read oef/embed.phtml r1 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,15
embedcnt=1
