oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=clickfill
val7=120x50
val8=228,Combien de kilomètres faut-il parcourir pour faire les \(\frac{2}{3}) d'un voyage de 228 km ?,	93,Jules a dans sa poche 93 billes. <br>Malheureusement &#44; sa poche a un trou &#44; et il en perd les \(\frac{2}{3}).<br>Combien de billes a-t-il perdues ?,	75,Un jardin rectangulaire a une longueur de 75 m.<br>Sa largeur est les \(\frac{2}{3}) de sa longueur.<br> Quelle est la largeur du terrain ?,	48,Au milieu du mois &#44; j'ai encore 48 &euro; d'argent de poche. <br>Je  consacre les \(\frac{2}{3}) à un cadeau.<br> Quelle somme d'argent ai-je dépensée pour le cadeau ?,	414,Dans un collège de 414 élèves &#44; les \(\frac{2}{3}) des élèves viennent à pied.<br>Combien d'élèves viennent à pied ?	
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val10=$(val8[2])	<p>Pour trouver la réponse, je choisis le calcul suivant :</p>
val11=\($(val8[1]) \times \frac{2}{3})
val12=\($(val8[1]) \div \frac{2}{3}),	\($(val8[1]) + \frac{2}{3}),	\($(val8[1]) - \frac{2}{3})	
replytype1=$val6

replyoption1=shuffle 
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

