!set title=Vocabulaire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
!if $val6<3 
tmp0=!randitem 2,4,5,8,10,16

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9

val8=$[rint($(tmp0))]
!if $val8=$val7 
val8=$[rint($val8+1)]
!endif
!else
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
!if $val8=$val7 
val7=$[rint($val7+1)]
!endif
val8=$[rint($val7*$val8)]
!endif
val9=$[$val8/$val7]
val10=numérateur,dénominateur,quotient
val11=$val8,$val7,$val9
tmp0=!shuffle 3

val12=$(tmp0)
val13=Le $(val10[$(val12[1])]) de la fraction est le nombre 
val14=$(val11[$(val12[1])])
val15=Le $(val10[$(val12[2])]) de la fraction est le nombre 
val16=$(val11[$(val12[2])])
val17=Le $(val10[$(val12[3])]) de la fraction est le nombre 
val18=$(val11[$(val12[3])])
val19=$[rint(5)]
replyname1=
replygood1=$val14
replyname2=
replygood2=$val16
replyname3=
replygood3=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

