!set title=Calculatrice et multiplication par une fraction 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 98

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val7=$[rint($(tmp0)*10+$(tmp1))]
val8=$[rint($val6/$val7)]
val9=$[$val6/$val7]
!if $val8=$val9 
val6=$[rint($val6+1)]
!endif
tmp0=!randint 1, 9

tmp1=!randint 0, 9

tmp2=!randint 0, 9

tmp3=!randint 0, 9

tmp4=!randint 1, 9

val10=$[rint($(tmp0)*10000+$(tmp1)*1000+$(tmp2)*100+$(tmp3)*10+$(tmp4))]
val11=$[rint($val10*$val6/$val7*10)]
val11=$[$val11/10]
val12=
val8=$[rint($val11)]
val9=$[$val11]
!if $val8=$val9 
val12=,0
!endif
!readproc slib/numeration/ecriturenombre $val10 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/numeration/ecriturenombre $val11 
tmp0=$slib_out
val11=$(tmp0)
tmp0=!translate . to , in $val10

val10=$(tmp0)
tmp0=!translate . to , in $val11

val11=$(tmp0)$val12
val13=Vous donnerez un résultat approché au dixième, en précisant le dixième.
replytype1=raw
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Utiliser la calculatrice pour donner le résultat :	
!if $val13!= 
$()<p>$val13</p> 
!endif
$()	<div class="wimscenter">	$val10 
!insmath \times \frac{$val6}{$val7} 
$() =	 
!read oef/embed.phtml r1,10 
$()	</div>	<div class="wims_instruction">Vous utiliserez la virgule comme séparateur décimal,	et vous respecterez l'espace tous les trois chiffres et éviterez les zéros inutiles.</div>	
$()
!exit

