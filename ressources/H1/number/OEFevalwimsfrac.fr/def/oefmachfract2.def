!set title=Calculatrice et multiplication par une fraction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(1)]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val7=$[rint($(tmp0)*10+$(tmp1))]
tmp0=!randint 1, 9

tmp1=!randint 0, 9

tmp2=!randint 0, 9

tmp3=!randint 1, 9

val8=$[rint($(tmp0)*1000+$(tmp1)*100+$(tmp2)*10+$(tmp3))]
tmp0=!randint 1, 3

val8=$[$val8/10^$(tmp0)]
val9=$[$val8*$val7]
!readproc slib/numeration/ecriturenombre $val9 
tmp0=$slib_out
val9=$(tmp0)
!readproc slib/numeration/ecriturenombre $val8 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!translate . to , in $val9

val9=$(tmp0)
tmp0=!translate . to , in $val8

val8=$(tmp0)
val10=
replytype1=raw
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Utiliser la calculatrice pour donner le résultat :	
!if $val10!= 
$()<p>$val10</p> 
!endif
$()	<div class="wimscenter">	$val9 
!insmath \times \frac{$val6}{$val7} 
$() =	 
!read oef/embed.phtml r1,10 
$()	</div>	<div class="wims_instruction">Vous utiliserez la virgule comme séparateur décimal,	et vous respecterez l'espace tous les trois chiffres et éviterez les zéros inutiles.</div>	
$()
!exit

