!set title=Egalités de fractions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 9

val6=$(tmp0)
val7=
val8=
!for val9 =1 to 4 
val10=$(val6[$val9])
val11=$[rint(10)]
tmp0=!append item $val10 to $val7

val7=$(tmp0)
tmp0=!append item $val11 to $val8

val8=$(tmp0)
!next
val12=
val13=
!for val9 =1 to 4 
val10=$[rint($(val7[$val9])*10)]
val11=$[rint($(val8[$val9])*10)]
tmp0=!append item $val10 to $val12

val12=$(tmp0)
tmp0=!append item $val11 to $val13

val13=$(tmp0)
!next
val14=\(\frac{$(val7[1])}{$(val8[1])}),\(\frac{$(val7[2])}{$(val8[2])}),\(\frac{$(val7[3])}{$(val8[3])}),\(\frac{$(val7[4])}{$(val8[4])})
val15=\(\frac{$(val12[1])}{$(val13[1])}),\(\frac{$(val12[2])}{$(val13[2])}),	\(\frac{$(val12[3])}{$(val13[3])}),\(\frac{$(val12[4])}{$(val13[4])})
replytype1=correspond
replyname1=
replygood1=$val14;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Mettre en relation les fractions représentant le même nombre :	<div class="wimscenter">	 
!read oef/embed.phtml r1,60x50 
$()	</div>	
$()
!exit

