!set title=Multiplication par 0,5 0,25 0,75 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 9

tmp1=!randitem 1,3,5,7,9

tmp2=!randitem 0,2,4,6,8

val6=$(tmp0),$(tmp1),$(tmp2)
val7=$[0.5]
val8=$[rint($(val6[1])$(val6[2])$(val6[3]))]
val9=$[$val8*$val7]
!readproc slib/numeration/ecriturenombre $val9 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!translate . to , in $val9

val9=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donnez le résultat de la multiplication :	<div class="wimscenter">	 $val8 
!insmath \times
$() $val7 =  
!read oef/embed.phtml r1,8 
$()	</div>	<div class="wims_instruction">Vous utiliserez la virgule comme séparateur décimal,	et vous respecterez l'espace tous les trois chiffres et éviterez les zéros inutiles.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=1
