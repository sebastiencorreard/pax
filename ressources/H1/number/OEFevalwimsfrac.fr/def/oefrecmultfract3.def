!set title=Reconnaître une opération 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

val6=$[rint($(tmp0))]
tmp0=!randint 11, 59

val7=$[rint($(tmp0))]
val8=Calculer les $val6 % de $val7.	<p>Pour trouver le résultat, je choisis le calcul suivant :</p>
val9=clickfill
val10=120x50
val11=\($val7 \times \frac{$val6}{100})
val12=\($val7 \times 100),	\($val7 \times $val6),	\($val7 \times \frac{1}{$val6}),	\($val7 \times \frac{100}{$val6})	
replytype1=$val9

replyoption1=shuffle 
replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val10 
$()	</div>	
$()
!exit

