!set title=Fraction et valeur décimale 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=clickfill
val7=120x50
val8=1,2;1,4;2,4;3,4;1,5;2,5;3,5;4,5;3,6;1,8;2,8;3,8;4,8;5,8;6,8;7,8;1,10;2,10;3,10;4,10;5,10;6,10;7,10;8,10;9,10
tmp0=!randint 1, 25

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
val10=$[$(val8[1])/$(val8[2])]
val11=Nous avons l'égalité suivante : $val10 \(\times) $(val8[2]) = $(val8[1])	  donc <i>(Choisir la bonne égalité)</i> : <div class="wimscenter">
val12=\(\frac{$(val8[1])}{$(val8[2])}) = $val10 
val13=\(\frac{$(val8[2])}{$(val8[1])}) = $val10 ,	\(\frac{$val10}{$(val8[2])}) = $(val8[1]),	\(\frac{$val10}{$(val8[1])}) = $(val8[2])	
replytype1=$val6

replyoption1=shuffle 
replyname1=
replygood1=$val12;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11	 
!read oef/embed.phtml r1,$val7 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11
embedcnt=1
