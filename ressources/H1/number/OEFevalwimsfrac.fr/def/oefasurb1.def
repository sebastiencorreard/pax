!set title=Fraction et valeur décimale 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=clickfill
val7=60x40
tmp0=!randint 2, 12

val8=$[rint($(tmp0))]
tmp0=!randint 1, $val8-1

val9=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in $val9/$val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
val11=$[rint(0)]
val12=$[rint(0)]
!while $val11<1 
val12=$[rint($val12+1)]
val13=$[$val12*$val10]
val14=$[rint($val12*$val10)]
!if $val13=$val14 
val11=$[rint(1)]
!endif
!endwhile
val15=$[rint($val10*$val12)]
val16=Nous avons la fraction \(\frac{$val15}{$val12}).	<p>Compléter l'égalité :</p> <div class="wimscenter">\(\frac{$val15}{$val12}) = 
val17=\($val15 \div $val12)
val18=\($val12 \div $val15),	\($val15 \times $val12),	\($val15 + $val12),	\($val15 - $val12),	$val15\(,)$val12	
replytype1=$val6

replyoption1=shuffle 
replyname1=
replygood1=$val17;$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val16	 
!read oef/embed.phtml r1,$val7 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,16
embedcnt=1
