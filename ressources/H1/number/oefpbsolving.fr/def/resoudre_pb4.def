!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 400, 600

val6=$[$(tmp0)/100]
tmp0=!randint 80, 110

val7=$[$(tmp0)/100]
tmp0=!randint 120, 220

val8=$[$(tmp0)/100]
tmp0=!randint 230, 300

val9=$[$(tmp0)/100]
tmp0=!randint 310, 380

val10=$[$(tmp0)/100]
tmp=!trim classeurs,effaceurs,paquets de 100 feuilles,stylos, cahiers	$val6,$val7,$val8,$val9,$val10	classeur,effaceur, paquet de 100 feuilles,stylo, cahier
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 3

val12=$[rint($(tmp0))]
val13=$[rint($val12+1)]
tmp0=!shuffle 5

val14=$(tmp0)
val15=$[$val12*$(val11[2;$(val14[1])])+$(val11[2;$(val14[2])])+$val13*$(val11[2;$(val14[3])])]
!if $val15>20 
val16=$[rint(50)]
!else
tmp0=!randitem 20,50

val16=$[rint($(tmp0))]
!endif
val17=$[$val16-$val15]
replytype1=numeric
replyname1=
replygood1=$[$val12*$(val11[2;$(val14[1])])]
replytype2=numeric
replyname2=
replygood2=$[$(val11[2;$(val14[2])])]
replytype3=numeric
replyname3=
replygood3=$[$val13*$(val11[2;$(val14[3])])]
replytype4=numeric
replyname4=
replygood4=$[$val15]
replytype5=numeric
replyname5=
replygood5=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans un magasin vendant des articles de bureau, on a relevé la liste de prix ci-dessous:	<ul><li>	prix d'un classeur : $val6 &euro; ; </li><li>	prix d'un effaceur : $val7 &euro; ;</li><li>	prix d'un paquet de 100 feuilles : $val8 &euro; ;</li><li>	prix d'un stylo : $val9 &euro; ;</li><li>	prix d'un cahier : $val10 &euro;.</li>	</ul>		Hervé achète $val12 $(val11[1;$(val14[1])]), un $(val11[3;$(val14[2])]) et $val13 $(val11[1;$(val14[3])]).	Il paye avec un billet de $val16 &euro;,	combien va-ton lui rendre &#63;	<div class="wims_instruction"> Arrondir les résultats au centime d'euro.</div>	<ul><li>	<label for="reply1">Prix des $(val11[1;$(val14[1])]) :</label> 
!read oef/embed.phtml reply 1,4 
$()&euro;</li><li>	<label for="reply2">Prix d'un $(val11[3;$(val14[2])]) :</label> 
!read oef/embed.phtml reply 2,4 
$()&euro;</li><li>	<label for="reply3">Prix des $(val11[1;$(val14[3])]) :</label> 
!read oef/embed.phtml reply 3,4 
$()&euro;</li>	</ul>	<label for="repl41">Au total, il paye</label>  
!read oef/embed.phtml reply 4,4 
$()&euro;.	<label for="reply5">On lui rend</label>  
!read oef/embed.phtml reply 5,4 
$()&euro;.	
$()
