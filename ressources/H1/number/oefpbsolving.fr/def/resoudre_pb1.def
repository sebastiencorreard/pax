!set title=Résoudre un problème 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 16

val6=$[rint($(tmp0))]
tmp0=!randitem 20,50

val7=$[rint($(tmp0))]
val8=$[rint($val7-$val6)]
replytype1=numeric
replyname1=
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Pour son anniversaire, Marc achète un gâteau à la boulangerie. Ce gâteau coûte $val6 &euro;	et il paye avec un billet de $val7 &euro;.	Calculer la somme d'argent que va lui rendre la boulangère.	<div><label for="reply1">Elle va lui rendre </label>  
!read oef/embed.phtml reply 1,3 
$() &euro;.</div>	
$()
!exit

