!set title=Résoudre un problème 5 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net
computeanswer=no
precision=100

ansorder=r,r,r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 90, 70

val6=$[$(tmp0)/100]
tmp0=!randint 240, 320

val7=$[$(tmp0)/100]
tmp0=!randint 110, 220

val8=$[$(tmp0)/100]
tmp0=!randint 300, 500

val9=$[$(tmp0)/100]
tmp0=!randint 310, 380

val10=$[$(tmp0)/100]
tmp0=!randint 13, 18

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val11=$[$(tmp0)+$(tmp1)/10+ $(tmp2)/100]
tmp0=!randint 1, 8

tmp1=!randint 1, 9

val12=$[2+$(tmp0)/10+ $(tmp1)/100]
tmp=!trim des baguettes, des gâteaux,du lait , des ampoules, des éponges	$val6,$val7,$val8,$val9,$val10	d'une baguette, du gâteau, du litre de lait, d'une ampoule,d'une éponge	baguettes, gâteaux, litres de lait , ampoules, éponges	une baguette, un gâteau, un litre de lait , une ampoule, une éponge
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!trim de la viande, des oranges,	$val11,$val12	de viande, d'oranges
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 2, 3

val15=$[rint($(tmp0))]
tmp0=!randint 1, 2

tmp1=!randint 1, 9

val16=$[$(tmp0)+$(tmp1)/10]
tmp0=!shuffle 5

val17=$(tmp0)
tmp0=!shuffle 2

val18=$(tmp0)
val19=$[$val15*$(val13[2;$(val17[1])])+$(val13[2;$(val17[2])])+$val16*$(val14[2;$(val18[1])])]
!if $val19>20 
val20=$[rint(50)]
!else
tmp0=!randitem 20,50

val20=$[rint($(tmp0))]
!endif
val21=$[$val20-$val19]
replytype1=numeric
replyname1=
replygood1=$[$val15*$(val13[2;$(val17[1])])]
replytype2=numeric
replyname2=
replygood2=$[$(val13[2;$(val17[2])])]
replytype3=numeric
replyname3=
replygood3=$[$val16*$(val14[2;$(val18[1])])]
replytype4=numeric
replyname4=
replygood4=$[$val19]
replytype5=numeric
replyname5=
replygood5=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans un  grand magasin, on a relevé la liste de prix ci-dessous:	<ul><li>	prix d'une baguette : $val6 &euro; ;</li><li>	prix d'un gâteau : $val7 &euro; ;</li><li>	prix d'un litre de lait : $val8 &euro; ;</li><li>	prix d'une ampoule : $val9 &euro; ;</li><li>	prix d'une éponge : $val10 &euro; ;</li><li>	prix d'un kg de viande : $val11 &euro; ;</li><li>	prix d'un kg d'orange : $val12 &euro;	</li></ul>	<p>	Hervé achète $val15 $(val13[4;$(val17[1])]), $(val13[5;$(val17[2])]) et $val16 kg $(val14[3;$(val18[1])]).	Il paye avec un billet de $val20 &euro;, <br>	combien va-t-on lui rendre &#63; </p>		<div class="wims_instruction">	Pour les resultats ayant 3 chiffres apres la virgule, les arrondir au centieme.	</div>	<ul><li>	<label for="reply1">Prix $(val13[1;$(val17[1])])</label> : 
!read oef/embed.phtml reply 1,4 
$()&euro; </li><li>	<label for="reply2">Prix $(val13[3;$(val17[2])])</label> : 
!read oef/embed.phtml reply 2,4 
$()&euro; </li><li>	<label for="reply3">Prix $(val14[1;$(val18[1])])</label> : 
!read oef/embed.phtml reply 3,4 
$()&euro;</li>	</ul>	<div>	Au total, <label for="reply4">il paye</label>  
!read oef/embed.phtml reply 4,4 
$()&euro;.	<label for="reply5">On lui rend</label>  
!read oef/embed.phtml reply 5,4 
$()&euro;.	</div>	
$()
!exit

