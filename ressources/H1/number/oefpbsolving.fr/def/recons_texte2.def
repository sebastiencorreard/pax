tmp0=!randint 110, 250

val8=$[$(tmp0)/100]
tmp0=!randint 1100, 1800

val9=$[$(tmp0)/100]
val10=$[$val6 + $val7*5 + $val8]
val11=$[$val10-$val9]
!if $val11=$val6 
val6=$[$val6+1]
val10=$[$val6 + $val7*5 + $val8]
