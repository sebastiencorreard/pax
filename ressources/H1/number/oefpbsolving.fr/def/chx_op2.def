!set title=Choix opération 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net
computeanswer=no
precision=100

ansorder=r,r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 160, 175

val6=$[$(tmp0)/100]
tmp0=!randint 5, 10

val7=$[rint($(tmp0))]
tmp0=!randint 30, 50

tmp1=!randint 1, 9

val8=$[$(tmp0)+$(tmp1)/10]
val9=$[$val7 * $val6]
val10=$[$val7-$val6]
val11=$[$val6-$val7]
val12=$[$val7 + $val6]
val13=$[rint(100*$val7 / $val6)/100]
val14=$[rint(100*$val6/$val7)/100]
val15=$[$val8 * $val6]
val16=$[$val8-$val6]
val17=$[$val6-$val8]
val18=$[$val8 + $val6]
val19=$[rint(100*$val8 / $val6)/100]
val20=$[rint(100*$val6/$val8)/100]
val21=<p>	Dans une station service, un litre d'essence coûte $val6 &euro;.	Paul met $val7 L dans le réservoir de son scooter.	Pour calculer ce que Paul doit payer, on fait :?? $val7 x $val6 = $val9,$val7 - $val6 = $val10,$val6 - $val7=$val11,$val7 + $val6=$val12, $val7 : $val6 = $val13,$val6 : $val7=$val14??.	</p><p>	Au même moment, dans la même station service, Marie met $val8 L dans le réservoir de sa voiture.	Pour calculer ce que Marie doit payer, on fait :?? $val8 x $val6 = $val15,$val8 - $val6 = $val16,$val6 - $val8=$val17,$val8 + $val6=$val18, $val8 : $val6 = $val19,$val6 : $val8=$val20??.	</p>	
tmp0=!singlespace $val21

val21=$(tmp0)
tmp0=!embraced randitem $val21

val21=$(tmp0)
!readproc slib/text/cutchoice2 $val21 
tmp0=$slib_out
val21=$(tmp0)
tmp=!translate internal $	$ to ; in $val21

tmp0=!rowcnt $tmp
val22=$[rint(min(20,floor($(tmp0)/2)))]
val23=
val24=
!for val25 =1 to $val22 
val26=$(val21[2*$val25;])
val27=$(val26[1])
tmp0=!sort items $val26

val26=$(tmp0)
tmp0=!positionof item $val27 in $val26

val27=$(tmp0)
val23=$val23$val27,
val24=$val24$val26;
!next
tmp0=!embraced randitem \pre

val28=$(tmp0)
tmp0=!embraced randitem \post

val29=$(tmp0)
tmp0=!makelist reply x for x=1 to $val22

val30=$(tmp0)
oefsteps=$val30 
nextstep=!nosubst $val30 
!readproc oef/steps.proc
replytype1=menu
replyname1=Champ 1
replygood1=$(val23[1]);$(val24[1;])
replytype2=menu
replyname2=Champ 2
replygood2=$(val23[2]);$(val24[2;])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val21[1;])	 
!for m_k=1 to $val22 
$()	 
!read oef/embed.phtml r \k,\len 
$() $(val21[2*$m_k+1;])	 
!next
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

