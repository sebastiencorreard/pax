!set title=Résoudre un problème 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 250, 400

tmp1=!randint 1, 9

val6=$[$(tmp0)/10+$(tmp1)/100]
tmp0=!randint 120, 200

tmp1=!randint 1, 9

val7=$[$(tmp0)/10+$(tmp1)/100]
tmp0=!randint 14, 18

val8=$[rint($(tmp0))]
val9=$[($val6+$val7)*$val8]
replytype1=default
replyname1=Prix en euros
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Cette année, au club de Foot de la ville de Pleincadre,	  l'entraineur Niplati dispose de $val8 joueurs.	  Pour cette saison, le club offre un short et un maillot neufs à tous les joueurs.	  Chez le fournisseur du club, le maillot est à $val6 &euro; et le short à $val7 &euro;.	  Combien le club va-t-il payer pour équiper tous ses joueurs cette saison ?	<div class="wims_instruction">	On donnera la réponse arrondie au centime d'euro.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=0
