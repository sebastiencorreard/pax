\title{Reconstituer un texte 2}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
:Données principales.
Les questions à poser doivent être mises entre une paire de
double-point d'interrogation "??".
On peut poser plusieurs questions dans une même phrase (jusqu'à 20).
help

\integer{porte_monnaie=randint(20..49)}
\integer{nrb_billet=random(2,3)}
\real{monnaie=randint(110..250)/100}
\real{prix_CD=randint(1100..1800)/100}
\real{somme_totale=\porte_monnaie + \nrb_billet*5 + \monnaie}
\real{solde=\somme_totale-\prix_CD}

\if {\solde=\porte_monnaie} {
  \real{porte_monnaie=\porte_monnaie+1}
  \real{somme_totale=\porte_monnaie + \nrb_billet*5 + \monnaie}
  \real{solde=\somme_totale-\prix_CD}
}

\text{data=Utilise les opérations pour compléter le texte ci-dessous: <ul>
<li>
\porte_monnaie + (\nrb_billet x 5) + \monnaie =\somme_totale
</li><li>
\somme_totale &minus; \prix_CD =\solde. </li></ul>

Pierre a ??\porte_monnaie,\nrb_billet,5,\monnaie ,\somme_totale,\prix_CD,\solde?? &euro; dans son porte-monnaie ;
 il y ajoute les ??\nrb_billet,\porte_monnaie,5,\monnaie ,\somme_totale,\prix_CD,\solde?? billets
 de ??5,\porte_monnaie,\nrb_billet ,\monnaie ,\somme_totale,\prix_CD,\solde?? &euro; gagnées en lavant
  la voiture de son grand-père et les ??\monnaie,\porte_monnaie,\nrb_billet ,5,\somme_totale,\prix_CD,\solde?? &euro; de monnaie que lui a laissé sa tante quand il est
allé faire des courses pour elle. Il va chez le marchand de disques. En rentrant, il fait ses comptes :
il a dépensé ??\prix_CD,\porte_monnaie,\nrb_billet ,5,\monnaie ,\somme_totale,\solde?? &euro;
pour s'offrir un C.D. de musique et il lui reste ??\solde,\porte_monnaie,\nrb_billet ,5,\monnaie ,\somme_totale,\prix_CD?? &euro;.}

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\text{data=wims(singlespace \data)}
\text{data=wims(embraced randitem \data)}
\text{data=slib(text/cutchoice2 \data)}
\integer{qs=min(20,floor(rows(\data)/2))}

\text{good=}
\text{field=}
\for{i=1 to \qs}{
 \text{f=\data[2*\i;]}
 \text{g=\f[1]}
 \text{f=wims(sort items \f)}
 \text{g=positionof(\g,\f)}
 \text{good=\good\g,}
 \text{field=\field\f;}
}

\text{pre=wims(embraced randitem \pre)}
\text{post=wims(embraced randitem \post)}
\text{qlist=wims(makelist reply x for x=1 to \qs)}
\steps{\qlist}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.
\statement{
\data[1;]
\for{k=1 to \qs}{
\embed{r \k,\len} \data[2*\k+1;]
}}

:%%%%%%%%%%%%% Rien à modifier ci-après. %%%%%%%%%%%%%%%%%5

\answer{Champ 1}{\good[1];\field[1;]}{type=menu}
\answer{Champ 2}{\good[2];\field[2;]}{type=menu}
\answer{Champ 3}{\good[3];\field[3;]}{type=menu}
\answer{Champ 4}{\good[4];\field[4;]}{type=menu}
\answer{Champ 5}{\good[5];\field[5;]}{type=menu}
\answer{Champ 6}{\good[6];\field[6;]}{type=menu}
