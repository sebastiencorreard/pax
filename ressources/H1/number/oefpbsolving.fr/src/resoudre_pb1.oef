\title{Résoudre un problème 1}
\language{fr}
\range{-5..5}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{ prix=randint(11..16)}
\integer{billet=random(20,50)}
\integer {mr=\billet-\prix}

\statement{
Pour son anniversaire, Marc achète un gâteau à la boulangerie. Ce gâteau coûte \prix &euro;
et il paye avec un billet de \billet &euro;.
Calculer la somme d'argent que va lui rendre la boulangère.
<div><label for="reply1">Elle va lui rendre </label> \embed{reply 1,3} &euro;.</div>
}

\answer {}{\mr}{type=numeric}
