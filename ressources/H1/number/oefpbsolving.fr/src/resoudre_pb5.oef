\title{Résoudre un problème 5 }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}
\precision{100}

\real{prix_baguette=randint(90..70)/100}
\real{prix_gateau=randint(240..320)/100}
\real{prix_lait=randint(110..220)/100}
\real{prix_ampoule=randint(300..500)/100}
\real{prix_eponge=randint(310..380)/100}
\real{prix_viande=randint(13..18)+randint(1..9)/10+ randint(1..9)/100}
\real{prix_orange=2+randint(1..8)/10+ randint(1..9)/100}

\matrix{article= des baguettes, des gâteaux,du lait , des ampoules, des éponges
\prix_baguette,\prix_gateau,\prix_lait,\prix_ampoule,\prix_eponge
d'une baguette, du gâteau, du litre de lait, d'une ampoule,d'une éponge
baguettes, gâteaux, litres de lait , ampoules, éponges
une baguette, un gâteau, un litre de lait , une ampoule, une éponge}

\matrix{aukilo= de la viande, des oranges,
\prix_viande,\prix_orange
de viande, d'oranges}

\integer{nbr1=randint(2..3)}
\real{nbr2=randint(1..2)+randint(1..9)/10}
\text{choix=shuffle(5)}
\text{chxkilo=shuffle(2)}

\real{prix_total=\nbr1*\article[2;\choix[1]]+\article[2;\choix[2]]+\nbr2*\aukilo[2;\chxkilo[1]]}
\if{\prix_total>20}{\integer{billet=50}}{\integer{billet=random(20,50)}}
\real{monnaie=\billet-\prix_total}

\statement{
Dans un  grand magasin, on a relevé la liste de prix ci-dessous:
<ul><li>
prix d'une baguette : \prix_baguette &euro; ;</li><li>
prix d'un gâteau : \prix_gateau &euro; ;</li><li>
prix d'un litre de lait : \prix_lait &euro; ;</li><li>
prix d'une ampoule : \prix_ampoule &euro; ;</li><li>
prix d'une éponge : \prix_eponge &euro; ;</li><li>
prix d'un kg de viande : \prix_viande &euro; ;</li><li>
prix d'un kg d'orange : \prix_orange &euro;
</li></ul>
<p>
Hervé achète \nbr1 \article[4;\choix[1]], \article[5;\choix[2]] et \nbr2 kg \aukilo[3;\chxkilo[1]].
Il paye avec un billet de \billet &euro;, <br>
combien va-t-on lui rendre &#63; </p>

<div class="wims_instruction">
Pour les resultats ayant 3 chiffres apres la virgule, les arrondir au centieme.
</div>
<ul><li>
<label for="reply1">Prix \article[1;\choix[1]]</label> :\embed{reply 1,4}&euro; </li><li>
<label for="reply2">Prix \article[3;\choix[2]]</label> :\embed{reply 2,4}&euro; </li><li>
<label for="reply3">Prix \aukilo[1;\chxkilo[1]]</label> :\embed{reply 3,4}&euro;</li>
</ul>
<div>
Au total, <label for="reply4">il paye</label> \embed{reply 4,4}&euro;.
<label for="reply5">On lui rend</label> \embed{reply 5,4}&euro;.
</div>
}

\answer {}{\nbr1*\article[2;\choix[1]]}{type=numeric}
\answer {}{\article[2;\choix[2]]}{type=numeric}
\answer {}{\nbr2*\aukilo[2;\chxkilo[1]]}{type=numeric}
\answer {}{\prix_total}{type=numeric}
\answer {}{\monnaie}{type=numeric}
