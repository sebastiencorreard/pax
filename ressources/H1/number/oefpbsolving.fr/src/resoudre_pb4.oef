\title{Résoudre un problème 4 }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}

\real{prix_classeur=randint(400..600)/100}
\real{prix_effaceur=randint(80..110)/100}
\real{prix_feuilles=randint(120..220)/100}
\real{prix_stylo=randint(230..300)/100}
\real{prix_cahier=randint(310..380)/100}

\matrix{article=classeurs,effaceurs,paquets de 100 feuilles,stylos, cahiers
\prix_classeur,\prix_effaceur,\prix_feuilles,\prix_stylo,\prix_cahier
classeur,effaceur, paquet de 100 feuilles,stylo, cahier}

\integer{nbr1=randint(2..3)}
\integer{nbr2=\nbr1+1}
\text{choix=shuffle(5)}

\real{prix_total=\nbr1*\article[2;\choix[1]]+\article[2;\choix[2]]+\nbr2*\article[2;\choix[3]]}
\if{\prix_total>20}{\integer{billet=50}}{\integer{billet=random(20,50)}}
\real{monnaie=\billet-\prix_total}

\statement{
Dans un magasin vendant des articles de bureau, on a relevé la liste de prix ci-dessous:
<ul><li>
prix d'un classeur : \prix_classeur &euro; ; </li><li>
prix d'un effaceur : \prix_effaceur &euro; ;</li><li>
prix d'un paquet de 100 feuilles : \prix_feuilles &euro; ;</li><li>
prix d'un stylo : \prix_stylo &euro; ;</li><li>
prix d'un cahier : \prix_cahier &euro;.</li>
</ul>

Hervé achète \nbr1 \article[1;\choix[1]], un \article[3;\choix[2]] et \nbr2 \article[1;\choix[3]].
Il paye avec un billet de \billet &euro;,
combien va-ton lui rendre &#63;
<div class="wims_instruction"> Arrondir les résultats au centime d'euro.</div>
<ul><li>
<label for="reply1">Prix des \article[1;\choix[1]] :</label>\embed{reply 1,4}&euro;</li><li>
<label for="reply2">Prix d'un \article[3;\choix[2]] :</label>\embed{reply 2,4}&euro;</li><li>
<label for="reply3">Prix des \article[1;\choix[3]] :</label>\embed{reply 3,4}&euro;</li>
</ul>
<label for="repl41">Au total, il paye</label> \embed{reply 4,4}&euro;.
<label for="reply5">On lui rend</label> \embed{reply 5,4}&euro;.
}

\answer {}{\nbr1*\article[2;\choix[1]]}{type=numeric}
\answer {}{\article[2;\choix[2]]}{type=numeric}
\answer {}{\nbr2*\article[2;\choix[3]]}{type=numeric}
\answer {}{\prix_total}{type=numeric}
\answer {}{\monnaie}{type=numeric}
