\title{Réordonner la solution d'un exo 1}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}

\integer{tot=6}
\text{size=80x40}

\real{prix_classeur=randint(400..600)/100}
\real{prix_effaceur=randint(80..110)/100}
\real{prix_livre=randint(600..1200)/100}
\real{prix_stylo=randint(100..300)/100}
\real{prix_cahier=randint(100..300)/100}

\matrix{article=classeur,effaceur,livre,stylo,cahier
\prix_classeur,\prix_effaceur,\prix_livre,\prix_stylo,\prix_cahier}

\integer{nbr=randint(2..3)}
\text{choix=shuffle(5)}
\real{prix_nbr=\nbr*\article[2;\choix[1]]}
\real{prix_total=\prix_nbr+\article[2;\choix[2]]}
\if{\prix_total>20}{\integer{billet=50}}{\integer{billet=random(20,50)}}
\real{monnaie=\billet-\prix_total}

\matrix{ A=\nbr \(\times\) \article[2;\choix[1]]= \prix_nbr,\prix_nbr+\article[2;\choix[2]]= \prix_total, \billet-\prix_total = \monnaie
Le prix de \nbr \article[1;\choix[1]]s est de \prix_nbr &euro;, Le prix total à payer est de \prix_total&euro;.,La caissière lui rend \monnaie &euro;.}
\matrix{chiffre=1,2,3}
\matrix{lettre=A,B,C}
\matrix{alpha=A,B,C}

\text{ordre1=shuffle(3)}
\text{ordre2=shuffle(3)}
\matrix{T=\A[1;\ordre1[1]],\A[1;\ordre1[2]],\A[1;\ordre1[3]]
\A[2;\ordre2[1]],\A[2;\ordre2[2]],\A[2;\ordre2[3]]}

\for {i=1 to 3} {
                 \if {\ordre1[1;\i]=1} {\matrix{chiffre=\i,\chiffre[2],\chiffre[3]}}
                 \if {\ordre1[1;\i]=2} {\matrix{chiffre=\chiffre[1],\i,\chiffre[3]}}
                 \if {\ordre1[1;\i]=3} {\matrix{chiffre=\chiffre[1],\chiffre[2],\i}}
                 }
\for {i=1 to 3} {
  \if {\ordre2[1;\i]=1} {\matrix{lettre=\alpha[\i],\lettre[2],\lettre[3]}}
  \if {\ordre2[1;\i]=2} {\matrix{lettre=\lettre[1],\alpha[\i],\lettre[3]}}
  \if {\ordre2[1;\i]=3} {\matrix{lettre=\lettre[1],\lettre[2],\alpha[\i]}}
}

\text{data=\chiffre[1]°&#41;,\lettre[1] &#41;,\chiffre[2]°&#41;,\lettre[2] &#41;,\chiffre[3]°&#41;,\lettre[3] &#41;}

\text{explain=Dans un grand magasin un \article[1;\choix[1]] coûte \article[2;\choix[1]] &euro; et un \article[1;\choix[2]] coûte \article[2;\choix[2]] &euro;.
Eric achète \nbr \article[1;\choix[1]]s et un \article[1;\choix[2]].
Il paye en donnant un billet de \billet &euro;, combien la caissière va-t-elle lui rendre de monnaie ?
<p>
 Dans la colonne de gauche du tableau ci-dessous, on donne dans le désordre la liste des opérations qui conduisent au résultat.
 Dans la colonne de droite, on donne dans le désordre la liste des conclusions à mettre après les résultats des opérations précédentes.
</p>
<table class="wimscenter wimsborder">
<tr><th style="width:200px"> Liste des opérations</th><th style="width:500px">Liste des conclusions</th></tr>
<tr><td>1° &#41; \T[1;1]</td><td>A&#41; \T[2;1]</td></tr>
<tr><td>2° &#41; \T[1;2]</td><td>B&#41; \T[2;2]</td></tr>
<tr><td>3° &#41; \T[1;3]</td><td>C&#41; \T[2;3]</td></tr>
</table>

<div class="wims_instruction">
Il faut mettre dans les cases ci-dessous alternativement un chiffre et une lettre afin de reconstituer dans le bon ordre la solution rédigée de cet exercice.
ATTENTION, il faut commencer par un chiffre.
</div>}

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\integer{datacnt=items(\data)}
\integer{tot=min(20,min(\tot,\datacnt))}
\if{\tot<\datacnt}{
 \text{sh=shuffle(\datacnt)}
 \text{sh=wims(sort numeric items \sh[1..\tot])}
 \text{data=item(\sh,\data)}
}

\text{st=wims(makelist r x for x=1 to \tot)}
\steps{\st}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.

\statement{\explain
<table class="wimsnoborder"><tr>
\for{k=1 to \tot}{<td>\embed{r\k,\size}</td>}
</tr></table>
}

:%%%%%%%%%%%%% Rien à modifier ci-après. %%%%%%%%%%%%%%%%%5

\answer{1}{\data[1]}{type=dragfill}
\answer{2}{\data[2]}{type=dragfill}
\answer{3}{\data[3]}{type=dragfill}
\answer{4}{\data[4]}{type=dragfill}
\answer{5}{\data[5]}{type=dragfill}
\answer{6}{\data[6]}{type=dragfill}
