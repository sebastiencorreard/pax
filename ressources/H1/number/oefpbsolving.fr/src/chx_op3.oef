\title{Choix opérations 3 }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}

\real{prix_kg_achat=randint(150..200)/100}
\real{prix_kg_vente=\prix_kg_achat + randint(150..200)/100}
\integer{prix_essence=randint(40..60)}
\integer{nbr_kg_achat=randint(200..300)}
\integer{nbr_kg_perte=randint(10..20)}

\real{prix_producteur=\prix_kg_achat * \nbr_kg_achat}
\real{calcul_faux1=\prix_kg_achat + \nbr_kg_achat}
\real{kg_vendu=\nbr_kg_achat-\nbr_kg_perte}
\real{calcul_faux2=\prix_essence+\nbr_kg_perte}
\real{calcul_faux3=\prix_kg_vente+\kg_vendu}
\real{cout_total=\prix_producteur+\prix_essence}
\real{recette=\prix_kg_vente*\kg_vendu}
\real{calcul_faux4=\prix_kg_vente*\nbr_kg_achat}
\real{benefice=\recette-\cout_total}
\real{calcul_faux5=\calcul_faux4-\cout_total}

\text{data=
Un marchand de fruits de Cayenne achète \nbr_kg_achat kg de ramboutans à un producteur d'Iracoubo au prix de \prix_kg_achat &euro; le kilogramme
et dépense \prix_essence &euro; pour les transporter. Il les vend au prix
de \prix_kg_vente&euro; le kilogramme; mais le ramboutan étant un produit périssable, il doit en jeter \nbr_kg_perte kg .
<p>Calcule le bénéfice réalisé par ce marchand de fruits.</p>
<ul><li>
Calcul du prix payé au producteur d'Iracoubo:?? \prix_kg_achat x \nbr_kg_achat = \prix_producteur, \prix_kg_achat + \nbr_kg_achat = \calcul_faux1,\nbr_kg_achat - \nbr_kg_perte = \kg_vendu,\prix_essence + \nbr_kg_perte = \calcul_faux2,\prix_producteur + \prix_essence = \cout_total,\prix_kg_vente x \kg_vendu = \recette,\recette - \cout_total = \benefice,\prix_kg_vente + \kg_vendu = \calcul_faux3,\prix_kg_vente x \nbr_kg_achat = \calcul_faux4,\calcul_faux4 - \cout_total = \calcul_faux5 ??&euro;.
</li><li>
Calcul du prix payé au producteur plus le transport:??\prix_producteur + \prix_essence = \cout_total, \prix_kg_achat x \nbr_kg_achat = \prix_producteur, \prix_kg_achat + \nbr_kg_achat = \calcul_faux1,\nbr_kg_achat - \nbr_kg_perte = \kg_vendu,\prix_essence + \nbr_kg_perte = \calcul_faux2,\prix_kg_vente x \kg_vendu = \recette,\recette - \cout_total = \benefice,\prix_kg_vente + \kg_vendu = \calcul_faux3,\prix_kg_vente x \nbr_kg_achat = \calcul_faux4,\calcul_faux4 - \cout_total = \calcul_faux5 ??&euro;.
</li><li>
Calcul du nombre de kg vendu:??\nbr_kg_achat - \nbr_kg_perte = \kg_vendu,\prix_producteur + \prix_essence = \cout_total, \prix_kg_achat x \nbr_kg_achat = \prix_producteur, \prix_kg_achat + \nbr_kg_achat = \calcul_faux1,\prix_essence + \nbr_kg_perte = \calcul_faux2,\prix_kg_vente x \kg_vendu = \recette,\recette - \cout_total = \benefice,\prix_kg_vente + \kg_vendu = \calcul_faux3,\prix_kg_vente x \nbr_kg_achat = \calcul_faux4,\calcul_faux4 - \cout_total= \calcul_faux5?? kg.
</li><li>
Calcul de la recette:??\prix_kg_vente x \kg_vendu = \recette,\nbr_kg_achat - \nbr_kg_perte = \kg_vendu,\prix_producteur + \prix_essence = \cout_total, \prix_kg_achat x \nbr_kg_achat = \prix_producteur, \prix_kg_achat + \nbr_kg_achat = \calcul_faux1,\prix_essence + \nbr_kg_perte = \calcul_faux2,\recette - \cout_total = \benefice,\prix_kg_vente + \kg_vendu = \calcul_faux3,\prix_kg_vente x \nbr_kg_achat = \calcul_faux4,\calcul_faux4 - \cout_total = \calcul_faux5 ??&euro;.
</li><li>
Calcul du bénéfice:??\recette - \cout_total = \benefice,\nbr_kg_achat - \nbr_kg_perte = \kg_vendu,\prix_producteur + \prix_essence = \cout_total, \prix_kg_achat x \nbr_kg_achat = \prix_producteur, \prix_kg_achat + \nbr_kg_achat = \calcul_faux1,\prix_essence + \nbr_kg_perte = \calcul_faux2,\prix_kg_vente x \kg_vendu = \recette,\prix_kg_vente + \kg_vendu = \calcul_faux3,\prix_kg_vente x \nbr_kg_achat = \calcul_faux4,\calcul_faux4 - \cout_total = \calcul_faux5??&euro;.
</li></ul>
}

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\text{data=wims(singlespace \data)}
\text{data=wims(embraced randitem \data)}
\text{data=slib(text/cutchoice2 \data)}
\integer{qs=min(20,floor(rows(\data)/2))}

\text{good=}
\text{field=}
\for{i=1 to \qs}{
 \text{f=\data[2*\i;]}
 \text{g=\f[1]}
 \text{f=wims(sort items \f)}
 \text{g=positionof(\g,\f)}
 \text{good=\good\g,}
 \text{field=\field\f;}
}

\text{pre=wims(embraced randitem \pre)}
\text{post=wims(embraced randitem \post)}
\text{qlist=wims(makelist reply x for x=1 to \qs)}
\steps{\qlist}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.
\statement{
\data[1;]
\for{k=1 to \qs}{
\embed{r \k,\len} \data[2*\k+1;]
}}

