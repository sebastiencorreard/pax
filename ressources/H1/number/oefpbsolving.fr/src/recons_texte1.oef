\title{Reconstituer un texte 1}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\real{prix_unitaire=randint(105..135)/100}
\integer{nrb_croissants=randint(2..5)}
\integer{billet=random(10,20)}
\real{prix_croissants=\nrb_croissants*\prix_unitaire}
\real{solde=\billet-\prix_croissants}
\real{fausse_reponse=randint(80..99)/10}

\text{data=Utilise les opérations pour compléter le texte ci-dessous: <ul>
<li>\nrb_croissants x \prix_unitaire = \prix_croissants </li>
<li>\billet - \prix_croissants = \solde </li>
</ul>
A la boulangerie, un croissant coûte ??\prix_unitaire,\nrb_croissants,\solde,\fausse_reponse,\billet ??.
Anne achète ??\nrb_croissants,\prix_unitaire,\solde,\fausse_reponse,\billet ?? croissants et
paye avec un billet de ??\billet,\prix_unitaire,\nrb_croissants,\solde,\fausse_reponse ?? &euro;.
La caissière lui rend ??\solde,\nrb_croissants,\prix_unitaire,\fausse_reponse,\billet ?? &euro;. }

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\text{data=wims(singlespace \data)}
\text{data=wims(embraced randitem \data)}
\text{data=slib(text/cutchoice2 \data)}
\integer{qs=min(20,floor(rows(\data)/2))}

\text{good=}
\text{field=}
\for{i=1 to \qs}{
 \text{f=\data[2*\i;]}
 \text{g=\f[1]}
 \text{f=wims(sort items \f)}
 \text{g=positionof(\g,\f)}
 \text{good=\good\g,}
 \text{field=\field\f;}
}

\text{pre=wims(embraced randitem \pre)}
\text{post=wims(embraced randitem \post)}
\text{qlist=wims(makelist reply x for x=1 to \qs)}
\steps{\qlist}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.
\statement{
\data[1;]
\for{k=1 to \qs}{
\embed{r \k,\len} \data[2*\k+1;]
}}

:%%%%%%%%%%%%% Rien à modifier ci-après. %%%%%%%%%%%%%%%%%5

\answer{Champ 1}{\good[1];\field[1;]}{type=menu}
\answer{Champ 2}{\good[2];\field[2;]}{type=menu}
\answer{Champ 3}{\good[3];\field[3;]}{type=menu}
\answer{Champ 4}{\good[4];\field[4;]}{type=menu}
\answer{Champ 5}{\good[5];\field[5;]}{type=menu}
\answer{Champ 6}{\good[6];\field[6;]}{type=menu}
