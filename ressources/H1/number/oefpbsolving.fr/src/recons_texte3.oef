\title{Reconstituer un texte 3}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
:Données principales.
Les questions à poser doivent être mises entre une paire de
double-point d'interrogation "??".
On peut poser plusieurs questions dans une même phrase (jusqu'à 20).
help

\integer{nbr_litre=randint(4..6)}
\real{Pix_1L_jus=randint(150..250)/100}
\real{prix_haricot=randint(180..270)/100}
\integer{nbr_kg=randint(2..3)}
\real{prix_1kg_viande=randint(1800..2700)/100}
\integer{billet=random(50,100)}
\real{prix_des_jus=\nbr_litre*\Pix_1L_jus}
\real{prix_viande=\nbr_kg*\prix_1kg_viande}
\real{prix_total=\prix_viande+\prix_haricot+\prix_des_jus}
\if {\prix_total>49.99}{\integer{billet=100}}
\real{somme_rendue=\billet-\prix_total }

\text{data=Utilise les opérations pour complèter le texte de ci-dessous:
<ul><li>\nbr_litre x \Pix_1L_jus = \prix_des_jus </li><li>
\nbr_kg x \prix_1kg_viande= \prix_viande </li><li>
\prix_des_jus + \prix_haricot + \prix_viande=\prix_total</li><li>
\billet - \prix_total=\somme_rendue</li></ul>

Hubert achète ??\nbr_litre,\Pix_1L_jus,\prix_des_jus,\nbr_kg,\prix_1kg_viande,\prix_viande,\prix_haricot,\billet,\prix_total,\somme_rendue?? litres de jus de fruits à ??\Pix_1L_jus,\nbr_litre,\prix_des_jus,\nbr_kg,\prix_1kg_viande,\prix_viande,\prix_haricot,\billet,\prix_total,\somme_rendue?? &euro; le litre, une boîte de haricots verts extra-fins
à ??\prix_haricot,\nbr_litre,\Pix_1L_jus,\prix_des_jus,\nbr_kg,\prix_1kg_viande,\prix_viande,\billet,\prix_total,\somme_rendue?? &euro; et ??\nbr_kg,\nbr_litre,\Pix_1L_jus,\prix_des_jus,\prix_1kg_viande,\prix_viande,\prix_haricot,\billet,\prix_total,\somme_rendue?? kg de viande à ??\prix_1kg_viande,\nbr_litre,\Pix_1L_jus,\prix_des_jus,\nbr_kg,\prix_viande,\prix_haricot,\billet,\prix_total,\somme_rendue?? &euro; le kilogramme. Il paie avec un billet de ??\billet,\nbr_litre,\Pix_1L_jus,\prix_des_jus,\nbr_kg,\prix_1kg_viande,\prix_viande,\prix_haricot,\prix_total,\somme_rendue??
&euro; ; le marchand lui rend ??\somme_rendue,\nbr_litre,\Pix_1L_jus,\prix_des_jus,\nbr_kg,\prix_1kg_viande,\prix_viande,\prix_haricot,\billet,\prix_total?? &euro;.}

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\text{data=wims(singlespace \data)}
\text{data=wims(embraced randitem \data)}
\text{data=slib(text/cutchoice2 \data)}
\integer{qs=min(20,floor(rows(\data)/2))}

\text{good=}
\text{field=}
\for{i=1 to \qs}{
 \text{f=\data[2*\i;]}
 \text{g=\f[1]}
 \text{f=wims(sort items \f)}
 \text{g=positionof(\g,\f)}
 \text{good=\good\g,}
 \text{field=\field\f;}
}

\text{pre=wims(embraced randitem \pre)}
\text{post=wims(embraced randitem \post)}
\text{qlist=wims(makelist reply x for x=1 to \qs)}
\steps{\qlist}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.
\statement{
\data[1;]
\for{k=1 to \qs}{
\embed{r \k,\len} \data[2*\k+1;]
}}

:%%%%%%%%%%%%% Rien à modifier ci-après. %%%%%%%%%%%%%%%%%5

\answer{Champ 1}{\good[1];\field[1;]}{type=menu}
