\title{Choix opération 1 }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}
\precision{100}

\real{prix_orange_kg=randint(201..285)/100}
\integer{nbr_g=randint(5..9)*100}
\real{nbr_kg=\nbr_g*0.001}

\real{calcul_P1=rint(100*\nbr_g * \prix_orange_kg)/100}
\real{calcul_P2=\nbr_g-\prix_orange_kg}
\real{calcul_P3=\prix_orange_kg-\nbr_g}
\real{calcul_P4=\nbr_g  + \prix_orange_kg}
\real{calcul_P5=rint(100*\nbr_g / \prix_orange_kg)/100}
\real{calcul_P6=\prix_orange_kg-\nbr_kg }
\real{calcul_P7=rint(100*\nbr_kg / \prix_orange_kg)/100}
\real{calcul_P8=rint(100*\nbr_kg * \prix_orange_kg)/100}
\real{calcul_P9=\nbr_kg+\prix_orange_kg}

\text{data=
Au marché, un kilogramme d'oranges coûte \prix_orange_kg &euro;.
Paméla achète \nbr_g grammes d'oranges.
Pour calculer ce que Paméla doit payer,
on fait : ??\nbr_kg x \prix_orange_kg = \calcul_P8, \nbr_g x \prix_orange_kg = \calcul_P1,\nbr_g  -
 \prix_orange_kg  = \calcul_P2,\prix_orange_kg - \nbr_g=\calcul_P3,\nbr_g  +  \prix_orange_kg=\calcul_P4, \nbr_g :
 \prix_orange_kg = \calcul_P5,\prix_orange_kg - \nbr_kg = \calcul_P6,\nbr_kg : \prix_orange_kg =\calcul_P7 ,\nbr_kg +
 \prix_orange_kg= \calcul_P9?? .

}

:%%%%%%%%%%%%%% Rien à modifier avant l'énoncé %%%%%%%%%%%%%%%%

\text{data=wims(singlespace \data)}
\text{data=wims(embraced randitem \data)}
\text{data=slib(text/cutchoice2 \data)}
\integer{qs=min(20,floor(rows(\data)/2))}

\text{good=}
\text{field=}
\for{i=1 to \qs}{
 \text{f=\data[2*\i;]}
 \text{g=\f[1]}
 \text{f=wims(sort items \f)}
 \text{g=positionof(\g,\f)}
 \text{good=\good\g,}
 \text{field=\field\f;}
}

\text{pre=wims(embraced randitem \pre)}
\text{post=wims(embraced randitem \post)}
\text{qlist=wims(makelist reply x for x=1 to \qs)}
\steps{\qlist}

:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%

::Vous n'avez pas besoin de modifier ceci en général.
\statement{
\data[1;]
\for{k=1 to \qs}{
\embed{r \k,\len} \data[2*\k+1;]
}}

:%%%%%%%%%%%%% Rien à modifier ci-après. %%%%%%%%%%%%%%%%%5

\answer{Champ 1}{\good[1];\field[1;]}{type=menu}
\answer{Champ 2}{\good[2];\field[2;]}{type=menu}
