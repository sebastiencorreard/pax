\title{Résoudre un problème 3}
\language{fr}
\range{-5..5}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\real{maillot=randint(250..400)/10+randint(1..9)/100}
\real{short=randint(120..200)/10+randint(1..9)/100}
\integer{joueur= randint(14..18)}
\real{prix=(\maillot+\short)*\joueur}

\statement{ Cette année, au club de Foot de la ville de Pleincadre,
  l'entraineur Niplati dispose de \joueur joueurs.
  Pour cette saison, le club offre un short et un maillot neufs à tous les joueurs.
  Chez le fournisseur du club, le maillot est à \maillot &euro; et le short à \short &euro;.
  Combien le club va-t-il payer pour équiper tous ses joueurs cette saison ?
<div class="wims_instruction">
On donnera la réponse arrondie au centime d'euro.
</div>
}

\answer{Prix en euros}{\prix}{type=default}
