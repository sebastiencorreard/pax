\title{Résoudre un problème 2}
\language{fr}
\range{-5..5}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{eleve1=random( Bernard, Laura , Jean, Sonia, Marie , Sylvie, José)}
\text{eleve2=random( Marc, Simon, Michel, Judith, Nathalie , Sophie, Katia)}
\text{eleve3=random( Francis, Hervé, David, Caroline , Mélissa , Pierre)}
\integer{argenteleve1=randint(30..75)}
\integer{enplus=randint(20..50)}
\integer{enmoins=randint(10..45)}
\integer{argenteleve2=\argenteleve1+\enplus}
\integer{argenteleve3=\argenteleve2+\enmoins}

\statement{\eleve2 possède \enplus &euro; de plus que \eleve1 et \enmoins de moins que \eleve3.
 En sachant que \eleve1 possède \argenteleve1 &euro;, complète la phrases ci-dessous:
<div>
<label for="reply1">\eleve2 possède</label> \embed{reply 1,3} &euro;
et <label for="reply2">\eleve3 possède</label>
\embed{reply 2,3} &euro;.
</div>
 }

\answer {}{\argenteleve2}{type=numeric}
\answer {}{\argenteleve3}{type=numeric}
