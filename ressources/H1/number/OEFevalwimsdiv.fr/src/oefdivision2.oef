  \text{\rep=\rep,0}}{\integer{l=2}}
\for{i=1 to \l}{
  \text{chif=wims(char \i to \i of \rest)}
  \if{chif=}{}{\text{rep=wims(append item \chif to \rep)}}}
\integer{ldivid1=\ldd[3]\ldd[2]}
