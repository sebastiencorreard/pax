  \text{rep=wims(append item \chif to \rep)}}
\text{rep=\rep,\q2,\q1}
\integer{rest=\ldd[3]\ldd[2]-\m}
\text{lrest=\rest}
\integer{test=10-\rest}
\if{\test>0}{
  \integer{l=1}
  \text{\rep=\rep,0}}{\integer{l=2}}
\for{i=1 to \l}{
