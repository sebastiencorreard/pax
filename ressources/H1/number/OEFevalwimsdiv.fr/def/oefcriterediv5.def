val6=Le nombre,est-il divisible,par
val7=Oui,Non
val8=est,n'est pas
tmp=!trim Un nombre entier est divisible par \(2\) lorsque son chiffre des unités est \(0\) &#59; \(2\) &#59; \(4\) &#59; \(6\) ou \(8\).<p>, se termine par, donc,divisible par \(2\).</p>	Un nombre entier est divisible par \(5\) lorsque son chiffre des unités est \(0\) ou \(5\).<p>,se termine par,donc,divisible par \(5\).</p>,	Un nombre entier est divisible par \(10\) lorsque son chiffre des unités est \(0\).<p>, se termine par, donc,divisible par \(10\).</p>
val9=!translate internal $	\
$ to ;; in $tmp
val10=2,3,4,5,7,9,10,11,13,15,18
tmp0=!shuffle $val10

val10=$(tmp0)
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
val12=$[rint(1)]
!for val13 =1 to $val11 
val12=$[rint($val12*$(val10[$val11]))]
!next
val14=$[rint(500-$val12)]
!if $val14>0 
val12=$[rint($val12*$(val10[4]))]
!endif
val14=$[rint(500-$val12)]
!if $val14>0 
val12=$[rint($val12*$(val10[5]))]
!endif
val14=$[rint(500-$val12)]
!if $val14>0 
val12=$[rint($val12+300)]
!endif
t_=!replace internal \( by ( in digits($val12,10)
tmp0=!exec pari $t_

tmp1=!char -1 of $(tmp0)

val15=$(tmp1)
!readproc slib/numeration/ecriturenombre $val12,tex 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/numeration/ecriturenombre $val12 
tmp0=$slib_out
val12=$(tmp0)
val17=$[$val12/2]
val18=$[ceil($val12/2)]
val19=$[$val12/5]
val20=$[ceil($val12/5)]
val21=$[$val12/10]
val22=$[ceil($val12/10)]
!if $val17=$val18 
val23=$[rint(1)]
!else
val23=$[rint(2)]
!endif
!if $val19=$val20 
val24=$[rint(1)]
!else
val24=$[rint(2)]
!endif
!if $val21=$val22 
val25=$[rint(1)]
!else
val25=$[rint(2)]
!endif
replytype1=menu
replyname1=
replygood1=$val23;$val7
replytype2=menu
replyname2=
replygood2=$val24;$val7
replytype3=menu
replyname3=
replygood3=$val25;$val7
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

