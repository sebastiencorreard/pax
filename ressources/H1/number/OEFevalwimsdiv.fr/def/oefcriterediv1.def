!set title=Critères de divisibilité 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
oefcss= <style> .wrap { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1rem; } .bloc { flex: 0 0 auto; width: max-content; max-width: 100%; border: none; padding: 1rem; } .divposee { width: auto; border-collapse: collapse; font-size: large; display: table; table-layout: auto; } .divposee td,.divposee th { padding: .45em .7em; text-align: center; vertical-align: middle; } .top{vertical-align: top } .vline-left { border-left: 1px solid #000; } .vline-right { border-right: 1px solid #000; } .bord-bas { border-bottom: 1px solid #000; } .border-bottom { border-bottom:2px solid; } .border-thin { border-bottom:1px solid gray; } .border-right { border-right:2px solid; } .pre { font-family:monospace; font-size:20px; } .espace-ligne { line-height: 2.5; } .mark_label{ margin-left:1.2em; margin-right:1.2em; } .inline { display: inline-block; margin: 1em; } .solution-wrap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: start; } .solution-bloc { min-width: 0; } .solution-bloc.tableau { text-align: center; font-size: 2em; line-height: 1.5; } .solution-bloc.tableau > table{ display: table; } .solution-bloc.tableau table.divposee { width: 75%; max-width: none; table-layout: auto; text-align: center; border-collapse: collapse; } .solution-bloc.tableau table.divposee td, .solution-bloc.tableau table.divposee th { padding: .45em .7em; text-align: center; vertical-align: middle; box-sizing: border-box; background:#fff; } .solution-bloc.tableau table.divposee td.sgn-cell, .solution-bloc.tableau table.divposee td.sgn-cell { text-align: right; vertical-align: middle; padding: 0em; } .centre{ text-align: center; } .mul-line.navy-hl { font-weight: 600; } .blue{color:#0b63ff; background:#fff; } .red{color:#d60000; background:#fff; } .black{color:#000; background:#fff; } .ghost{ visibility: hidden; border-bottom: none ; background:#fff; } .green{ color:#1a7f37; font-weight:700; } .match-green{ color:#1a7f37; font-weight:700; background:#eaf7ea; } .mul-line.match-green{ color:#1a7f37; } .stmt-scroll { position:relative; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; } .stmt-scroll td, .stmt-scroll th { position: relative; } .stmt-scroll td embed, .stmt-scroll td object, .stmt-scroll td iframe, .stmt-scroll td img, .stmt-scroll td svg { position: static; display: inline-block; max-width: none; vertical-align: middle; } .stmt-row { display: flex; align-items: flex-start; gap: .5rem; } .col-left { flex: 0 0 auto; overflow-x: visible; -webkit-overflow-scrolling: touch; } .col-left > table { width: max-content; table-layout: auto; border-collapse: collapse; white-space: nowrap; } .col-right { flex: 0 1 auto; min-width: 16rem; text-align:center; } .col-right .centre { display: inline-block; text-align: center; width: auto; max-width: min(42ch, 100%); } .stmt-scroll { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; } .stmt-scroll > table.divposee { display: inline-block; width: max-content; max-width: none; table-layout: auto; border-collapse: collapse; white-space: nowrap; } .stmt-mult { flex: 0 0 auto; min-width: 10ch; max-width: 40ch; } .stmt-mult .mul-line { margin: 0 0 .25em 0; line-height: 1.2; white-space: nowrap; } /**** div avec liserés de couleur et background ****/ .euler_quest_nobg { border-left:0.3em solid blue; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; } .euler_rep_good_nobg { border-left:0.3em solid green; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; } .euler_answer { border-left:0.3em solid grey; border-radius:3px; background-color:#f0f0f0; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; -moz-box-shadow: 6px 6px 12px #888; -webkit-box-shadow: 6px 6px 12px #888; box-shadow:6px 6px 12px #888; } .euler_answer_nobg { border-left:0.3em solid grey; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; } .euler_rep_bad_nobg { border-left:0.3em solid red; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; } .tick::before{ content : "\002713"; color:#008000; font-weight:bold; font-size:1.3em; margin-left:0.4em; margin-top:0; margin-right:0.4em; } .cross::before{ content : "\002717"; color:#b50000; font-weight:bold; font-size:1.3em; margin-left:0.4em; margin-top:0; margin-right:0.4em; } div.tick::before { font-size:2em; position: absolute; left: 0; top: 0; display: grid; place-items: center; box-sizing:border-box; } div.cross::before { font-size:2em; position: absolute; left: 0; top: 0; display: grid; place-items: center; box-sizing:border-box; } div.tick,div.cross { position: relative; background-size: 100% 1px; background-repeat: no-repeat; background-position: 0 0; overflow: hidden; padding-left:2.5em; } </style> 
precision=10000

ansorder=r
varcnt=12
prevarcnt=8
postvarcnt=3
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=à tous les chiffres du nombre,	au dernier chiffre du nombre,	à la somme des chiffres du nombre,	à la somme des deux derniers chiffres du nombre,	au premier chiffre du nombre,	au nombre formé par les deux derniers chiffres du nombre
val7=Pour savoir si un nombre entier est divisible par,je m'intéresse 
val8=Ainsi&#44; pour savoir si un nombre entier est divisible par,je m'intéresse 
tmp=!trim 2,2	5,2	10,2
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 3

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 1 of $(tmp0)

val11=$(tmp1)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 2 of $(tmp0)

val12=$(tmp1)
val13=euler_quest_nobg
replytype1=menu
replyname1=
replygood1=$val12;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="$val13">$(val7[1]) $(val9[$val10;1]), $(val7[2])  
!read oef/embed.phtml r1 
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val14=$[rint(1-$m_sc_reply1)]
!if $val14>0 
val13=euler_rep_bad_nobg cross
!else
val13=euler_rep_good_nobg tick
!endif

!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,13
embedcnt=1
