.mul-line.match-green{ color:#1a7f37; } .stmt-scroll { position:relative; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; } .stmt-scroll td, .stmt-scroll th { position: relative; } .stmt-scroll td embed, .stmt-scroll td object, .stmt-scroll td iframe, .stmt-scroll td img, .stmt-scroll td svg { position: static; display: inline-block; max-width: none; vertical-align: middle; } .stmt-row { display: flex; align-items: flex-start; gap: .5rem; } .col-left { flex: 0 0 auto; overflow-x: visible; -webkit-overflow-scrolling: touch; } .col-left > table { width: max-content; table-layout: auto; border-collapse: collapse; white-space: nowrap; } .col-right { flex: 0 1 auto; min-width: 16rem; text-align:center; } .col-right .centre { display: inline-block; text-align: center; width: auto; max-width: min(42ch, 100%); } .stmt-scroll { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; } .stmt-scroll > table.divposee { display: inline-block; width: max-content; max-width: none; table-layout: auto; border-collapse: collapse; white-space: nowrap; } .stmt-mult { flex: 0 0 auto; min-width: 10ch; max-width: 40ch; } .stmt-mult .mul-line { margin: 0 0 .25em 0; line-height: 1.2; white-space: nowrap; } /**** div avec liserés de couleur et background ****/ .euler_quest_nobg { border-left:0.3em solid blue; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; } .euler_rep_good_nobg { border-left:0.3em solid green; border-radius:3px; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; } .euler_answer { border-left:0.3em solid grey; border-radius:3px; background-color:#f0f0f0; padding:0.3em 0.3em 0.3em 0.5em; margin-top: 0.3em; margin-bottom: 0.3em; margin-left:0.3em; -moz-box-shadow: 6px 6px 12px #888; -webkit-box-shadow: 6px 6px 12px #888; box-shadow:6px 6px 12px #888; } .euler_answer_nobg { border-left:0.3em solid grey; border-radius:3px; padding:0.3em 0.3em