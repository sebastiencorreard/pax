!set title=Table de multiplication 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Cyrille, Douriez
email=cyrille.douriez@ac-amiens.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000000
oefobservation=Suivant la configuration de l'exercice sur le module, il est possible d'exclure certaines tables.

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=16
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<div class="wims_instruction">L'usage de la calculatrice <b>n'est pas autorisé</b>.</div>
tmp0=!itemcnt $val2

!if $(tmp0)>0 
val7=2,3,4,5
!for val8 =6 to 9 
tmp0=!positionof item $val8 in $val7


!ifval $(tmp0) issametext 
val7= $val7
!else
val7=$val7,$val8
!endif
tmp0=!shuffle $val7

val7=$(tmp0)
!next
tmp0=!item 1 to 3 of $val7

val9=$(tmp0)
val10=
!for val8 =2 to 9 
tmp0=!positionof item $val8 in $val9


!ifval $(tmp0) issametext 
tmp1=!append item $val8 to $val10

val11= $(tmp1)
!endif
!next
val9=$val7,$val11
!else
tmp0=!shuffle 2,3,4,5,6,7,8,9

val9=$(tmp0)
!endif
tmp0=!sort numeric list $(val9[1..3])

val12=$(tmp0)
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
tmp0=!sort numeric list $(val12[$val13]),$(val9[4..6])

val14=$(tmp0)
val15=
!for val16 =1 to 3 
!for val17 =1 to 3 
val18=$[rint($(val12[$val16])*$(val14[$val17]))]
val15=$val15,$val18
!next
!next
tmp=!trim ,$val14	$(val12[1]),$(val15[2..4])	$(val12[2]),$(val15[5..7])	$(val12[3]),$(val15[8..10])
val19=!translate internal $	\
$ to ;; in $tmp
val20=r6,r7,r8,r10,r11,r12,r14,r15,r16
tmp=!trim ,1,1,1	1,0,0,0	1,0,0,0	1,0,0,0
val21=!translate internal $	\
$ to ;; in $tmp
val22=Chaque case intérieure du tableau est le produit des entiers contenus dans les cases situées en haut et à gauche.
dynsteps=yes
oefsteps=$val20 
nextstep=!nosubst $val20 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=comma 
replyname1=
replygood1=0
