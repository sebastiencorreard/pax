val6=<div class="wims_instruction">L'usage de la calculatrice <b>n'est pas autorisé</b>.</div>
tmp=!trim 2,1,1,3,3,5,7	3,1,2,1,2,4,5	4,1,1,3,3,5,7	5,1,2,3,4,6,8	8,1,3,3,5,7,9	9,2,4,5,7,8,10	10,1,1,3,7,9,11
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 1,2,3,4,5,6,7

val8=$(tmp0)
val9=
!for val10 =1 to 3 
tmp0=!randint 2, 7

val11=$[rint($(tmp0))]
t_=!rawmath $(val7[$(val8[$val10]);$val11])/$(val7[$(val8[$val10]);1])
val12=!exec pari print($t_)
val9=$val9,$val12
!next
val9=$(val9[2..4])
val13=
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp0=!shuffle $(val8[$val14]),$(val8[4..7])

val8=$(tmp0)
!for val10 =1 to 3 
tmp0=!randint 2, 7

val11=$[rint($(tmp0))]
t_=!rawmath $(val7[$(val8[$val10]);$val11])/$(val7[$(val8[$val10]);1])
val12=!exec pari print($t_)
val13=$val13,$val12
!next
val13=$(val13[2..4])
val15=différence entre les
val16=de soustraction
val17=soustractions
val18=-
val19=
!for val10 =1 to 3 
!for val20 =1 to 3 
t_=!rawmath $(val9[$val10])-$(val13[$val20])
val12=!exec pari print($t_)
val19=$val19,$val12
!next
!next
val21=Chaque case intérieure du tableau est la $val15 des nombres rationnels (fractions) en gras contenus dans les cases situées à gauche (premier nombre) et en haut.
val22=Chaque entier dans le tableau est la différence entre le nombre rationnel situé à gauche (dans la première colonne) et le nombre rationnel situé au dessus (dans la première ligne).
tmp=!trim ,$val13	$(val9[1]),$(val19[2..4])	$(val9[2]),$(val19[5..7])	$(val9[3]),$(val19[8..10])
val23=!translate internal $	\
$ to ;; in $tmp
val24=Compléter le tableau suivant en utilisant des $val17 sans utiliser de calculatrice.
val25=r6,r7,r8,r10,r11,r12,r14,r15,r16
tmp=!trim ,1,1,1	1,0,0,0	1,0,0,0	1,0,0,0
val26=!translate internal $	\
$ to ;; in $tmp
