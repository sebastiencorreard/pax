val6=<div class="wims_instruction">L'usage de la calculatrice <b>n'est pas autorisé</b>.</div>
tmp0=!shuffle -1,-2,-3,-4,-5,-6,-7,-8,-9,1,2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp0=!sort numeric list $(val7[1..3])

val8=$(tmp0)
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!sort numeric list $(val8[$val9]),$(val7[4..5])

val10=$(tmp0)
!if $(val8[1])>0 
val11=$[rint($(val8[1])*(-1))]
val8=$val11,$(val8[2]),$(val8[3])
!endif
!if $(val10[1])>0 
val11=$[rint($(val10[1])*(-1))]
val10=$val11,$(val10[2]),$(val10[3])
!endif
val12=différence entre les
val13=soustractions
val14=de soustraction
val15=-
val16=
!for val17 =1 to 3 
!for val18 =1 to 3 
val19=$[rint($(val8[$val17])-$(val10[$val18]))]
val16=$val16,$val19
!next
!next
val20=Chaque entier dans le tableau est la différence entre l'entier situé à gauche (dans la première colonne) et l'entier situé au dessus (dans la première ligne).
val21=Chaque case intérieure du tableau est la $val12 entiers en gras contenus dans les cases situées à gauche (premier nombre) et en haut.
tmp=!trim ,$val10	$(val8[1]),$(val16[2..4])	$(val8[2]),$(val16[5..7])	$(val8[3]),$(val16[8..10])
val22=!translate internal $	\
$ to ;; in $tmp
val23=r6,r7,r8,r10,r11,r12,r14,r15,r16
tmp=!trim ,1,1,1	1,0,0,0	1,0,0,0	1,0,0,0
val24=!translate internal $	\
$ to ;; in $tmp
val25=Compléter la table $val14 suivante sans utiliser de calculatrice.
