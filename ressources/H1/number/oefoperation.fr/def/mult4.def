val6=<div class="wims_instruction">L'usage de la calculatrice <b>n'est pas autorisé</b>.</div>
tmp0=!shuffle -9,-8,-7,-6,-5,-4,-3,-2,2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp0=!sort numeric list $(val7[1..3])

val8=$(tmp0)
!if $(val8[1])>0 
val9=$[rint($(val8[1])*(-1))]
val8=$val9,$(val8[2]),$(val8[3])
!endif
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
tmp0=!sort numeric list $(val8[$val10]),$(val7[4..6])

val11=$(tmp0)
!if $(val11[1])>0 
val9=$[rint($(val11[1])*(-1))]
val11=$val9,$(val11[2]),$(val11[3])
!endif
val12=
!for val13 =1 to 3 
!for val14 =1 to 3 
val15=$[rint($(val8[$val13])*$(val11[$val14]))]
val12=$val12,$val15
!next
!next
tmp=!trim ,$val11	$(val8[1]),$(val12[2..4])	$(val8[2]),$(val12[5..7])	$(val8[3]),$(val12[8..10])
val16=!translate internal $	\
$ to ;; in $tmp
val17=r6,r7,r8,r10,r11,r12,r14,r15,r16
tmp=!trim ,1,1,1	1,0,0,0	1,0,0,0	1,0,0,0
val18=!translate internal $	\
$ to ;; in $tmp
val19=Chaque case intérieure du tableau est le produit des entiers contenus dans les cases situées en haut et à gauche.
dynsteps=yes
oefsteps=$val17 
nextstep=!nosubst $val17 
!readproc oef/steps.proc
