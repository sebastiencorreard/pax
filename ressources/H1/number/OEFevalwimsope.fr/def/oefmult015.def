tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 0, 9

tmp1=!randint 1, 9

val7=$(tmp0),$(tmp1)
val8=$[rint($(val7[1])$(val7[2]))]
tmp0=!randint 2, 4-$val6

val9=$[rint($(tmp0))]
t_=!replace internal \( by ( in 1.*$val8/10^$val9
tmp0=!exec pari $t_

val8=$(tmp0)
!readproc slib/utilities/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Donnez le résultat de la multiplication&nbsp;
t_=!replace internal \( by ( in 1.*10^-$val6
tmp0=!exec pari $t_

val12=$(tmp0)
t_=!replace internal \( by ( in 1.*($val8)*10^-$val6
tmp0=!exec pari $t_

val13=$(tmp0)
replytype1=numeric
replyname1=$val8 x $val12 
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

