!set title=Calcul mental d'additions 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
!if $val6=$val7 
val7=$[rint($val6+1)]
!endif
tmp0=!randint 1, 7

tmp1=!randint 2, 9

val8=$[($(tmp0)*10+$(tmp1))/10^$val6]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val9=$[($(tmp0)*10+$(tmp1))/10^$val7]
!readproc slib/utilities/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Donnez le résultat de l'addition&nbsp;
val12=$[$val8+$val9]
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11 :	<div class="wimscenter">	 $val8 + $val9 =  
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,11
embedcnt=1
