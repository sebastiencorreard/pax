!set title=Multiplication par 10, 100, 1000 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 0, 9

tmp1=!randint 1, 9

val7=$(tmp0),$(tmp1)
val8=$[rint($(val7[1])$(val7[2]))]
!readproc slib/utilities/env lang 
tmp0=$slib_out
val9=$(tmp0)
val10=Donnez le résultat de la multiplication&nbsp;
val11=$[rint(10^$val6)]
t_=!replace internal \( by ( in 1.*$val8*$val11
tmp0=!exec pari $t_

val12=$(tmp0)
replytype1=numeric
replyname1=$val8 x $val11 
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10:	<div class="wimscenter">	 $val8 
!insmath \times
$() $val11 =  
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11
embedcnt=1
