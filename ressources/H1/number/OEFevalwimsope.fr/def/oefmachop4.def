!set title=Utilisation de la calculatrice 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 5

val6=$[rint($(tmp0))]
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp0=!randint 11, 990

val8=$[rint($(tmp0))]
tmp0=!randint 11, 999

val9=$[rint($(tmp0))]
val8=$[$val8/10^$val6]
val9=$[$val9/10^$val7]
val10=$[$val8 * $val9]
!readproc slib/numeration/ecriturenombre $val8 
tmp0=$slib_out
val8=$(tmp0)
!readproc slib/numeration/ecriturenombre $val9 
tmp0=$slib_out
val9=$(tmp0)
tmp0=!translate . to , in $val8

val8=$(tmp0)
tmp0=!translate . to , in $val9

val9=$(tmp0)
val11=$val8 \(\times) $val9 =
val12=$[rint(10)]
!readproc slib/utilities/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Trouver le résultat avec la calculatrice&nbsp;
val15=Attention : il faut respecter l'espace tous les trois chiffres	  et utiliser la virgule comme séparateur décimal.
!readproc slib/numeration/ecriturenombre $val10 
tmp0=$slib_out
val10=$(tmp0)
tmp0=!translate . to , in $val10

val10=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14:	<div class="wimscenter">	 $val11  
!read oef/embed.phtml r1,$val12 
$()	</div>	<div class="wims_instruction">$val15</div>	
$()
!exit

