!readproc slib/utilities/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Donnez le résultat de la multiplication&nbsp;
t_=!replace internal \( by ( in 1.*10^-$val6
tmp0=!exec pari $t_

val15=$(tmp0)
t_=!replace internal \( by ( in 1.*($val11)*10^-$val6
tmp0=!exec pari $t_

val16=$(tmp0)
replytype1=numeric
