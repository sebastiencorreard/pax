val17=
val18=
!for val19 =1 to $val16 
tmp0=!char $val19 to $val19 of $val15

val18=$(tmp0)
!if $val18= 
!else
tmp0=!append item $val18 to $val17

val17=$(tmp0)
!endif
!next
val18=
val19=$[rint($val16+1)]
