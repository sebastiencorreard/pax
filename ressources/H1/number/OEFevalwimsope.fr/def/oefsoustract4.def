val18=$(tmp0)
tmp0=!append item $val18&#44; to $val17

val17=$(tmp0)
val18=
!for val19 = $val16+2 to 4 
tmp0=!char $val19 to $val19 of $val15

val18=$(tmp0)
!if $val18= 
!else
tmp0=!append item $val18 to $val17

val17=$(tmp0)
!endif
!next
