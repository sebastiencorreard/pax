 !exit
!endif

tmp0=!randint 2, 9

val6=$[rint($(tmp0))]
tmp0=!randint 0, 5

val7=$[rint($val6*10+$(tmp0))]
tmp0=!randint 1, $val6-1

tmp1=!randint 6, 9

val8=$[rint($(tmp0)*10+$(tmp1))]
!readproc slib/utilities/env lang 
tmp0=$slib_out
