!set title=Multiplication par 10, 100, 1000 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 2, 4

val7=$[rint($(tmp0))]
val8=
!for val9 =1 to $val7 
tmp0=!randint 1, 9

val10=$(tmp0)
tmp0=!append item $val10 to $val8

val8=$(tmp0)
!next
val11=$[rint($(val8[1])$(val8[2])$(val8[3])$(val8[4]))]
tmp0=!randint 1, $val7-1

val12=$[rint($(tmp0))]
t_=!replace internal \( by ( in 1.*$val11/10^$val12
tmp0=!exec pari $t_

val11=$(tmp0)
!readproc slib/utilities/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Donnez le résultat de la multiplication&nbsp;
val15=$[rint(10^$val6)]
t_=!replace internal \( by ( in 1.*$val11*$val15
tmp0=!exec pari $t_

val16=$(tmp0)
replytype1=numeric
replyname1=$val11 x $val15 
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14:	<div class="wimscenter">	 $val11 
!insmath \times
$() $val15 =  
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,14,15
embedcnt=1
