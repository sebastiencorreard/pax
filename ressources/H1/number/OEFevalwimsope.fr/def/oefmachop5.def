!set title=Utilisation de la calculatrice 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 2

val6=$[rint($(tmp0))]
tmp0=!randint 0, 2

val7=$[rint($(tmp0))]
tmp0=!randint 0, 3

val8=$[rint($(tmp0))]
tmp0=!randint 0, 4

val9=$[rint($(tmp0))]
tmp0=!randint 11, 99

val10=$[rint($(tmp0))]
tmp0=!randint 11, 99

val11=$[rint($(tmp0))]
tmp0=!randint 11, 99

val12=$[rint($(tmp0))]
tmp0=!randint 11, 99

val13=$[rint($(tmp0))]
tmp0=!shuffle $val10,$val11,$val12,$val13

val14=$(tmp0)
val10=$[$(val14[1])/10^$val6]
val11=$[$(val14[2])/10^$val7]
val12=$[$(val14[3])/10^$val6]
val13=$[$(val14[4])/10^$val7]
val15=$[$val10 * $val11 * $val12 * $val13]
!readproc slib/numeration/ecriturenombre $val10 
tmp0=$slib_out
val10=$(tmp0)
!readproc slib/numeration/ecriturenombre $val11 
tmp0=$slib_out
val11=$(tmp0)
!readproc slib/numeration/ecriturenombre $val12 
tmp0=$slib_out
val12=$(tmp0)
!readproc slib/numeration/ecriturenombre $val13 
tmp0=$slib_out
val13=$(tmp0)
tmp0=!translate . to , in $val10

val10=$(tmp0)
tmp0=!translate . to , in $val11

val11=$(tmp0)
tmp0=!translate . to , in $val12

val12=$(tmp0)
tmp0=!translate . to , in $val13

val13=$(tmp0)
val16=$val10 \(\times) $val11 \(\times) $val12 \(\times) $val13 =
val17=$[rint(12)]
!readproc slib/utilities/env lang 
tmp0=$slib_out
val18=$(tmp0)
val19=Trouver le résultat avec la calculatrice&nbsp;
val20=Attention : il faut respecter l'espace tous les trois chiffres	  et utiliser la virgule comme séparateur décimal.
!readproc slib/numeration/ecriturenombre $val15 
tmp0=$slib_out
val15=$(tmp0)
tmp0=!translate . to , in $val15

val15=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val19:	<div class="wimscenter">	 $val16  
!read oef/embed.phtml r1,$val17 
$()	</div>	<div class="wims_instruction">$val20</div>	
$()
!exit

