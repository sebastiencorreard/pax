!set title=Utilisation de la calculatrice 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 110, 9900

val6=$[rint($(tmp0))]
tmp0=!randint 110, 9999

val7=$[rint($(tmp0))]
val8=$[rint($val6 * $val7)]
!readproc slib/numeration/ecriturenombre $val6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/numeration/ecriturenombre $val7 
tmp0=$slib_out
val7=$(tmp0)
val9=$val6 \(\times) $val7 =
val10=$[rint(10)]
!readproc slib/utilities/env lang 
tmp0=$slib_out
val11=$(tmp0)
val12=Trouver le résultat avec la calculatrice&nbsp;
val13=Attention : il faut respecter l'espace tous les trois chiffres	  et utiliser la virgule comme séparateur décimal.
!readproc slib/numeration/ecriturenombre $val8 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!translate . to , in $val8

val8=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12:	<div class="wimscenter">	 $val9  
!read oef/embed.phtml r1,$val10 
$()	</div>	<div class="wims_instruction">$val13</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
