!set title=Vocabulaire 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/utilities/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=$[rint(12)]
val8=3,4,5,6,7,8,9,11,12,13,14,15,16,17,18
tmp0=!shuffle $val8

val8=$(tmp0)
val9=$[rint($(val8[1])*$(val8[2]))]
val10=$[rint($(val8[3])+$(val8[4]))]
val11=$[rint(abs($(val8[5])-$(val8[6])))]
!if $(val8[5])>$(val8[6]) 
val8=$(val8[1]),$(val8[2]),$(val8[3]),$(val8[4]),$(val8[5]),$(val8[6]),$val9,$val10,$val11
!else
val8=$(val8[1]),$(val8[2]),$(val8[3]),$(val8[4]),$(val8[6]),$(val8[5]),$val9,$val10,$val11
!endif
val8=$(val8[1]),$(val8[2]),$(val8[3]),$(val8[4]),$(val8[5]),$(val8[6]),$val9,$val10,$val11
val12=<li>$(val8[1]) \(\times) $(val8[2]) = $(val8[7])</li>	<li>$(val8[3]) + $(val8[4]) = $(val8[8])</li>	<li>$(val8[5]) - $(val8[6]) = $(val8[9])</li>
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
val14=$[rint(($val13)/2)]
val15=$[rint($val14*2-$val13+1)]
val16=un facteur,un facteur,un terme,un terme,un terme,un terme,un produit,une somme,une différence
val17=Le nombre $(val8[$val13]) est 
val18=.
replyname1=
replygood1=$(val16[$val13])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <ul>$val12</ul>	  <div class="spacer">$val17  
!read oef/embed.phtml r1,$val7 
$() $val18</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,12,17,18
embedcnt=1
