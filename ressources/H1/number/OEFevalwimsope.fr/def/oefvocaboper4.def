!set title=Vocabulaire 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/utilities/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=$[rint(12)]
tmp0=!randint 20, 49

val8=$(tmp0)
tmp0=!randint 6, 19

val9=$(tmp0)
val10=$[rint($val8*$val9)]
tmp0=!randint 1, $val10-3

val11=$[rint($(tmp0))]
val12=$[rint($val10-$val11)]
val13=$[rint($val11+$val10)]
val14=$val8,$val9,$val11,$val12,$val13,$val11
val15=<li>$val8 \(\times) $val9 = $val10</li>	<li> $val11 + $val12 = $val10</li>	<li>$val13 - $val11 = $val10</li>
tmp0=!randint 1, 6

val16=$[rint($(tmp0))]
val17=$[rint(($val16)/2)]
val18=$[rint($val17*2-$val16+1)]
val19=facteur, terme, terme
val20=du produit,de la somme,de la différence
val21=deuxième,premier
val22=facteur,facteur,terme,terme,terme,terme
val23=Le nombre $(val14[$val16]) est le $(val21[$val18])
val24=$(val20[$val17]) qui donne $val10.
replyname1=
replygood1=$(val22[$val16])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <ul>$val15</ul>	  <div class="spacer">$val23  
!read oef/embed.phtml r1,$val7 
$() $val24</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,15,23,24
embedcnt=1
