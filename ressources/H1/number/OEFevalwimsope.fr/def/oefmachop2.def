conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11000, 990000

val6=$[rint($(tmp0))]
tmp0=!randint 1111000, 9999000

val7=$[rint($(tmp0))]
tmp0=!randint 11, 99000

val8=$[rint($(tmp0))]
tmp0=!shuffle + $val7,- $val8

val9=$(tmp0)
val10=$[rint($val6 + $val7 - $val8)]
!readproc slib/numeration/ecriturenombre $val6 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/numeration/ecriturenombre $(val9[1]) 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/numeration/ecriturenombre $(val9[2]) 
tmp0=$slib_out
val8=$(tmp0)
val11=$[rint(10)]
val12=$val6 $val7 $val8 =
!readproc slib/utilities/env lang 
tmp0=$slib_out
val13=$(tmp0)
val14=Trouver le résultat avec la calculatrice&nbsp;
val15=Attention : il faut respecter l'espace tous les trois chiffres	  et utiliser la virgule comme séparateur décimal.
!readproc slib/numeration/ecriturenombre $val10 
tmp0=$slib_out
val10=$(tmp0)
tmp0=!translate . to , in $val10

val10=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14:	<div class="wimscenter">	 $val12  
