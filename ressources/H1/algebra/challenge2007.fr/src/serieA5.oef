\title{Série A 5}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{p=randint(150..230)}
\integer{L=\p*10}

\integer{min=floor(\p/60)}
\integer{s=\p-\min*60}

\statement{
Dans ce village un automobiliste ne doit pas dépasser 36km/h.
La traversée totale du village fait \L mètres.
<p>
Quel temps peut mettre un automobiliste à traverser ce village, s'il n'a jamais à
ralentir et sans dépasser la vitesse autorisée ?
</p>
<b>Votre réponse</b> : \embed{r1,5} min \embed{r2,5} s.}

\answer{}{\min}{type=numeric}
\answer{}{\s}{type=numeric}
