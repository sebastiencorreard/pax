\text{good=\(-\frac{3}{4})}
\text{bad=1,-1,c'est impossible,\(\frac{3}{4})}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Les nombres a, b, c sont trois termes consécutifs d'une suite arithmétique de raison k (un réel non nul) et les nombres a, c, b sont trois termes consécutifs d'une suite géométrique de raison a (un réel non nul).
<p>
Combien vaut le quotient k/a ?</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
