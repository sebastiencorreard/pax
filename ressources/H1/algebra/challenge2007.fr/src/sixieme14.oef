\title{Sixième 14}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{P=randint(9..23)}
\text{good=simplify(\P-8) H}
\text{bad=simplify(\P-3) H,simplify(\P+8) H,\P H,simplify(\P-7) H}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Quand il est midi en France il est 7H à Montréal et 15H à Moscou.<p>
Quelle heure est-il à Montréal quand il est \P H à Moscou ?
</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
