\language{fr}


\integer{p=randint(8..11)}
\integer{q=randint(6..9)}
\integer{r=\p+\q-3}

\real{good=\p*\q-3*(\p+\q)+4.5}
\text{bad=simplify(\p*\q - 4.5),simplify(\p*\q-3*\p),simplify(\p+\q+9),simplify(2*\p*\q-6*(\p+\q)+9)}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Un triangle ABC a pour côtés AB = \p ; BC = \q ; CA = \r
<p>
Calculez le produit scalaire suivant :
\(\overrightarrow{AB}.\overrightarrow{BC})
</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
