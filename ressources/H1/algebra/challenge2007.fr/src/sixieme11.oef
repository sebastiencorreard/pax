\author{Fabrice, Guerimand}
\language{fr}

\integer{den=randitem(5,7)}
\integer{num=randint(2..\den-2)}
\integer{N=(\den-\num)*randint(55..125)}
\integer{good=\N*\den/(\den-\num)}
\integer{t=\good/100}
\text{frac=\num/\den}
\text{bad=\N,simplify(\N*\den),simplify(\N*\num),simplify(\t*100)}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Un réservoir contient \N litres de gazole. Le \(\frac) du réservoir est alors vide.
<p>
Donner la capacité de ce réservoir.
</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
