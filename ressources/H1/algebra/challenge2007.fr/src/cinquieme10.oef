\title{Cinquième 10}
\language{fr}

\integer{ch=randint(6..7)}
\text{image=item(\ch,,,,,,T6.gif,T7.gif)}
\integer{good=\ch+14}
\text{bad=Il n'y en a pas,14,16,13,15}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Dans le dessin ci-dessous, combien y-a-t-il de triangles visibles en tout ?

<div class="wimscenter"><img src="\imagedir/T3.gif" alt="">&nbsp;<img src="\imagedir/\image" alt="">&nbsp;<img src="\imagedir/T11.gif" alt=""></div>
<b>Votre réponse</b> : \embed{r1,5} triangles.}
\answer{Choisissez}{\good}{type=numeric}
