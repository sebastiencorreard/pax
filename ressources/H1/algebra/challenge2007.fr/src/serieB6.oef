\title{Série B 6}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{p=randint(2..9)}

\text{good=1}
\text{bad=0,\p,simplify(\p+1),2}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Dans cet énoncé, E(x) désigne l'entier immédiatement inférieur au réel x, c'est-à-dire que l'on a :
<div class="wimscenter">
\(E(x) \leq x < E(x) +1)</div>
On considère la fonction :
<div class="wimscenter">
\(f(x) = E(\frac{2x^2}{1+x^2}))</div>
Quelle est la valeur de f(\p) ?
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
