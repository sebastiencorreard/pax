\text{good=95°}
\text{bad=50°,73°,82°,On ne peut pas la trouver !}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Un quadrilatère ABCD est tel que :
<ul>
<li>  L'angle B mesure trois degrés de plus que l'angle A.</li>
<li>  L'angle C mesure cinq degrés de moins que l'angle B.</li>
<li>  L'angle D mesure neuf degrés de plus que l'angle C.</li>
</ul>
Quelle est la mesure de l'angle D ?
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
