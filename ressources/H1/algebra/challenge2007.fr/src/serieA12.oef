\title{Série A 12}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{p=randint(20..24)}
\integer{p=16}

\integer{good=5}
\for{k=0 to 4}{\integer{good=\good+floor((\p-5*\k)/2)}}
\text{bad=simplify(\p+11),simplify(\p+8),simplify(\p+14),simplify(\p+16)}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}
\text{name=slib(lang/fname girl,fr)}

\statement{
\name dispose dans son porte monnaie de pièce de 1 et de 2 euros ainsi que des billets de 5 euros.
Elle vient d'acheter \p euros un bel ouvrage de mathématiques amusantes contenant des petits
problèmes à résoudre.
Elle se demande alors de combien de manières différentes elle peut obtenir \p euros avec les pièces et les billets de son porte monnaie ?
<p>
De combien de manières différentes peut-on payer un achat de \p euros en pièces
de 1, et 2 euros, et billets de 5 euros ?</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
