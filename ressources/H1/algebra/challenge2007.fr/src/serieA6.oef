\title{Série A 6}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{p=randint(7..12)}
\integer{p3=3*\p}
\integer{good=\p<10?4:3}
\integer{p2=\p-2}

\text{list=\(2^\p),\(\p^3),\(3^\p2),\(\p2^4),-2<sup>-\p3</sup>}
\integer{nb=items(\list)}

\statement{
Quel est le plus grand des nombres suivants ?
<table>
\for{l=1 to \nb}{
 <tr><td>\embed{r1,\l}</td></tr>
}
</table>}

\answer{}{\good;\list}{type=radio}{options=shuffle}
