\title{Jour de la semaine}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\text{lday=Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi,Dimanche}
\text{lt=\lday,\lday}
\integer{ch=randint(1..7)}
\integer{ch2=randint(1..7)}
\integer{nombre=randint(6..14)*7+\ch2}
\text{good=item(\ch+\ch2,\lt)}
\text{bad=wims(listcomplement \good in \lday)}
\text{bad=shuffle(\bad)}
\text{bad=item(1 to 4,\bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
Nous sommes un \lday[\ch]. Quel jour serons-nous dans \nombre jours ?}

\choice{Choisissez}{\good}{\bad}
