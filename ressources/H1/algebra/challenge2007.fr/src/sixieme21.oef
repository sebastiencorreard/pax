\title{Sixième 21}
\language{fr}

\text{don=randrow(6_21_1.gif,50
6_21_2.gif,80
6_21_3.gif,70
6_21_4.gif,90
6_21_5.gif,30
6_21_6.gif,60)}

\integer{t=floor(\don[2]/10*10)/10}
\text{good=\t km}
\text{bad=2.5 km,3 km,4 km,5 km,7 km}
\text{bad=wims(listcomplement \good in \bad)}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\text{name=slib(lang/fname boy,fr)}

\statement{
<div class="float_right"><img src="\imagedir/\don[1]" alt=""></div>
\name roule en scooter. Il est très respectueux des limitations de vitesse mais
il veut rouler le plus vite possible sans être en infraction tout en parcourant
la distance la plus grande possible.
<p>
Il veut rouler pendant 6 minutes. Parmi les distances données quelle est celle
qu'il pourrait parcourir toute en respectant les contraintes fixées ?
</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}
}
\choice{Choisissez}{\Good}{\Bad}
