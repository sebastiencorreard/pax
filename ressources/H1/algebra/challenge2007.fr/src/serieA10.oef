\title{Série A 10}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{K=5*randint(2..5)}
\real{A=randint(24..28)/10}
\real{P=\A*\K}
\real{rep=rint(\A/0.9*100)/100}


\statement{
Un marchand de fruits et légumes vend \P euros un cageot de \K kg d'abricots, en faisant
une perte de 10% sur son prix d'achat.
<p>
Combien avait-il payé le kilo d'abricots ?
</p><b>Votre réponse</b> : \embed{r1,5}.}
\answer{}{\rep}{type=numexp}
