\text{d=randrow(18,3
20,4
24,4
28,4
30,6
32,4
36,4)}


\integer{g=\d[1]/\d[2]}
\text{good=\g élèves}
\text{bad=ça dépend à quel jeu on doit jouer,simplify(\g-1) élèves car il faut un arbitre,simplify(\g+1) élèves,simplify(\g+2) élèves,12 élèves}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}


\statement{
Les \d[1] élèves d'une classe sont répartis en \d[2] équipes de même effectif.
<p>Combien y-a-t-il d'élèves par équipe ?</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
