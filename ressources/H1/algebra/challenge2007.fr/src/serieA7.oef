\title{Série A 7}
\email{fwguerima@free.fr}
\author{Fabrice, Guerimand}
\language{fr}

\integer{a=randitem(5,10,17)}
\integer{b=\a-2}

\real{rep=4*sqrt(\a-1)}

\text{l=shuffle(A,B,C)}
\text{A=\l[1]}
\text{B=\l[2]}
\text{C=\l[3]}
\text{H=H}

\statement{
Soit un triangle \A\B\C tel que \A\B = \A\C = \a, et la hauteur \A\H = \b.
<p>
Quelle est la longueur \B\C ?
</p>
<b>Votre réponse</b> : \embed{r1,5}.
<div class="wims_instruction">Tapez <span class="tt">sqrt(2)</span> pour \(\sqrt{2}).</div>}
\answer{\A\H}{\rep}{type=algexp}
