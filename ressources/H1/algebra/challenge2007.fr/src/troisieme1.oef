\text{good=\(4\sqrt{5})}
\text{bad=\(13\sqrt{2}),1.5,\(10\sqrt{3}),C'est impossible}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=Réponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{<ul><li>
Le triangle ABC est isocèle de sommet A.
Sa hauteur mesure 2 de moins que le côté [AB] ( qui est de même longueur que [AC]).
</li><li>
AC est un nombre entier inférieur à 10 et divisible par 2 et par 3.
</li></ul>
<p>
Quelle est la longueur de [BC] ?
</p>
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul><b>Votre réponse</b> : \embed{c1}}
\choice{Choisissez}{\Good}{\Bad}
