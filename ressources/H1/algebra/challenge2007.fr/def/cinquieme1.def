!set title=Cinquième 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 6_7_1.gif,4 points	6_7_2.gif,2 points	6_7_4.gif,5 points	6_7_5.gif,1 points

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$(val6[2])
val8=0 point,2 points,3 points,4 points,6 points
tmp0=!listcomplement $val7 in $val8

val8=$(tmp0)
tmp0=!shuffle $val7,$val8

val9=$(tmp0)
val10=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val9

val11=$[rint($(tmp0))]
val12=
val13=
!for val14 =1 to $val11 
tmp0=!item $val14 of $val9

val15=$(tmp0)
val16=Réponse $(val10[$val14])
!if $val15 isitemof $val7 
tmp0=!append item $val16 to $val12

val12=$(tmp0)
!else
tmp0=!append item $val16 to $val13

val13=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right"><img src="$val1/$(val6[1])" alt=""></div>	Une fourmi savante parcours le trajet dessiné sur l'image ci-contre en additionnant le nombre	de points de chaque domino rencontré. A la sortie elle trouve un nombre divisible par 6.	<p>La case noircie comporte comme marque :</p>	<ul>	 
!for m_l=1 to $val11 
$()	 <li>$(val10[$m_l]) : $(val9[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,9,10,11
embedcnt=1
