!set title=Sixième 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 100,100 \
poly black,10,10,10,90,90,90,50,10 
tmp0=$ins_url
val6=$(tmp0)
!readproc oef/draw.phtml 100,100 \
square 10,10,80,black 
tmp0=$ins_url
val7=$(tmp0)
!readproc oef/draw.phtml 100,100 \
rect 10,25,90,75,black 
tmp0=$ins_url
val8=$(tmp0)
!readproc oef/draw.phtml 100,100 \
circle 50,50,90,black 
tmp0=$ins_url
val9=$(tmp0)
!readproc oef/draw.phtml 100,100 \
poly black,10,10,10,80,90,45,45,10 
tmp0=$ins_url
val10=$(tmp0)
tmp0=!shuffle $val6,$val7,$val8,$val9,$val10

val11=$(tmp0)
tmp0=!positionof item $val10 in $val11

val12=$[rint($(tmp0))]
replytype1=click
replyoption1=shuffle 
replyname1=
replygood1=$val12;<img src="$(val11[1])" alt="">,<img src="$(val11[2])" alt="">,<img src="$(val11[3])" alt="">,<img src="$(val11[4])" alt="">,<img src="$(val11[5])" alt="">
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La figure à laquelle Wims pense possède exactement deux droites perpendiculaires.	<p>	Cliquez sur la figure qui peut convenir.	</p>	<div class="wimscenter">	 
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=
embedcnt=1
