tmp0=!randint 20, 24

val6=$[rint($(tmp0))]
val6=$[rint(16)]
val7=$[rint(5)]
!for val8 =0 to 4 
val7=$[rint($val7+floor(($val6-5*$val8)/2))]
!next
tmp=!translate ";': to $     $ in $val6+11

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val6+8

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val6+14

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val6+16

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
val9=$(tmp0),$(tmp1),$(tmp2),$(tmp3)
tmp0=!listcomplement $val7 in $val9

val9=$(tmp0)
tmp0=!shuffle $val7,$val9

val10=$(tmp0)
val11=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val10

val12=$[rint($(tmp0))]
val13=
val14=
!for val8 =1 to $val12 
tmp0=!item $val8 of $val10

val15=$(tmp0)
