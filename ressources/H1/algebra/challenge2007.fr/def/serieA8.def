!set title=Série A 8
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=L'aire de ABCD = h (IO + OJ)
val7=Ce trapèze est isocèle,Ce trapèze est rectangle,Les points ABCD sont sur un même cercle,La figure est impossible
tmp0=!shuffle $val6,$val7

val8=$(tmp0)
val9=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
val11=
val12=
!for val13 =1 to $val10 
tmp0=!item $val13 of $val8

val14=$(tmp0)
val15=Réponse $(val9[$val13])
!if $val14 isitemof $val6 
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!else
tmp0=!append item $val15 to $val12

val12=$(tmp0)
!endif
!next
tmp0=!shuffle A,B,C,D

val16=$(tmp0)
val17=$(val16[1])
val18=$(val16[2])
val19=$(val16[3])
val20=$(val16[4])
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans un trapèze $val17$val18$val19$val20 de bases parallèles ($val17$val18) et ($val19$val20), les diagonales ($val17$val19) et ($val18$val20) se coupent en O à angle droit. On a noté I le milieu de [$val17$val18], J le milieu de [$val20$val19] et h la distance entre les bases (la hauteur du trapèze).	<p>	Quelle propriété est vraie ?</p>	<ul>	 
!for m_m=1 to $val10 
$()	 <li>$(val9[$m_m]) : $(val8[$m_m])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

