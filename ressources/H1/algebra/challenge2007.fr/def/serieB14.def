!set title=Série B 14
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
val9=$[rint(2*$val8)]
val10=-1
val11=ln($val7),0,1,$val9 ln($val7)
tmp0=!listcomplement $val10 in $val11

val11=$(tmp0)
tmp0=!shuffle $val10,$val11

val12=$(tmp0)
val13=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val12

val14=$[rint($(tmp0))]
val15=
val16=
!for val17 =1 to $val14 
tmp0=!item $val17 of $val12

val18=$(tmp0)
val19=Réponse $(val13[$val17])
!if $val18 isitemof $val10 
tmp0=!append item $val19 to $val15

val15=$(tmp0)
!else
tmp0=!append item $val19 to $val16

val16=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val15
choicebad1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Combien vaut, une fois simplifiée, la quantité suivante ?	<div class="wimscenter">	
!insmath \frac{\ln($val7^$val8)}{\ln($val7^{-$val8})}
$()</div>	<ul>	 
!for m_l=1 to $val14 
$()	 <li>$(val13[$m_l]) : $(val12[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

