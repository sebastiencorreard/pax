!set title=Cinquième 8
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=A
val7=B,C,D,E
tmp0=!shuffle $val6,$val7

val8=$(tmp0)
val9=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
val11=
val12=
!for val13 =1 to $val10 
tmp0=!item $val13 of $val8

val14=$(tmp0)
val15=Réponse $(val9[$val13])
!if $val14 isitemof $val6 
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!else
tmp0=!append item $val15 to $val12

val12=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Trois élèves d'un même collège jouent chacun un instrument de musique différent : violon, flûte et	guitare. Ils sont dans des classes différentes : sixième cinquième et quatrième. On sait que l'élève de	quatrième joue de la flûte, que Lucien joue de la guitare et que Mohamed est en sixième.	<p>	Parmi les répartitions des élèves dans les classes, quelle est celle qui convient ?	</p>	<table class="wimsborder wimscenter">	 <tr><td></td><th>A</th><th>B</th><th>C</th><th>D</th><th>E</th></tr>	 <tr><th>Sixième</th><td>Mohamed</td><td>Marjorie</td><td>Mohamed</td><td>Lucien</td><td>Marjorie</td></tr>	 <tr><th>Cinquième</th><td>Lucien</td><td>Lucien</td><td>Marjorie</td><td>Marjorie</td><td>Mohamed</td></tr>	 <tr><th>Quatrième</th><td>Marjorie</td><td>Mohamed</td><td>Lucien</td><td>Mohamed</td><td>Lucien</td></tr>	</table>	<div class="wims_spacer"><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()</div>
