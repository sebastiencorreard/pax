!set title=Série A 6
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 7, 12

val6=$[rint($(tmp0))]
val7=$[rint(3*$val6)]

!ifval $val6<10
val8=$[rint(4)]
!else
val8=$[rint(3)]
!endif
val9=$[rint($val6-2)]
val10=\(2^$val6),\($val6^3),\(3^$val9),\($val9^4),-2<sup>-$val7</sup>
tmp0=!itemcnt $val10

val11=$[rint($(tmp0))]
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val8;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quel est le plus grand des nombres suivants ?	<table>	 
!for m_l=1 to $val11 
$()	 <tr><td> 
!read oef/embed.phtml r1,\l 
$()</td></tr>	 
!next
$()	</table>
$()
!exit

