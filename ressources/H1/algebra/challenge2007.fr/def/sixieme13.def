val7=$(tmp0)
tmp=!translate internal $	$ to ; in 3<img src="$val1/rightup.gif" alt="">,2<img src="$val1/up.gif" alt="">,1<img src="$val1/leftup.gif" alt="">,1<img src="$val1/leftdown.gif" alt="">,2<img src="$val1/right.gif" alt="">,1<img src="$val1/leftup.gif" alt="">,1<img src="$val1/leftdown.gif" alt="">,2<img src="$val1/down.gif" alt="">,3<img src="$val1/rightdown.gif" alt="">		2<img src="$val1/rightdown.gif" alt="">,3<img src="$val1/right.gif" alt="">,1<img src="$val1/leftdown.gif" alt="">,7<img src="$val1/left.gif" alt="">,1<img src="$val1/leftup.gif" alt="">,2<img src="$val1/right.gif" alt="">,2<img src="$val1/leftup.gif" alt="">

tmp=!row $val6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
