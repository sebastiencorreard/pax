!set title=Quatrième 10
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=202
val7=198,206,225,229
tmp0=!shuffle $val6,$val7

val8=$(tmp0)
val9=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
val11=
val12=
!for val13 =1 to $val10 
tmp0=!item $val13 of $val8

val14=$(tmp0)
val15=Réponse $(val9[$val13])
!if $val14 isitemof $val6 
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!else
tmp0=!append item $val15 to $val12

val12=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le professeur d'Oscar a montré en classe divers triplets de nombres ayant une propriété curieuse :	<ul>	<li>
!insmath 3^2+4^2=5^2
$()</li>	<li>
!insmath 5^2+12^2=13^2
$()</li>	<li>
!insmath 7^2+24^2=25^2
$()</li>	</ul>	4 et 5, 12 et 13, 24 et 25 sont des nombres consécutifs.	<ul><li>	Déterminer de tels nombres consécutifs pour 9 (
!insmath 9^2+(\cdots)^2=(\cdots)^2
$()) et pour 11 (
!insmath 11^2+(\cdots)^2=(\cdots)^2
$()).	</li><li>	Combien vaut la somme de ces quatre nombres ?	</li></ul>	<ul>	 
!for m_l=1 to $val10 
$()	 <li>$(val9[$m_l]) : $(val8[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

