!set title=Sixième 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 18,3	20,4	24,4	28,4	30,6	32,4	36,4

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$[rint($(val6[1])/$(val6[2]))]
val8=$val7 élèves
tmp=!translate ";': to $     $ in $val7-1

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val7+1

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val7+2

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
val9=ça dépend à quel jeu on doit jouer,$(tmp0) élèves car il faut un arbitre,$(tmp1) élèves,$(tmp2) élèves,12 élèves
tmp0=!shuffle $val8,$val9

val10=$(tmp0)
val11=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val10

val12=$[rint($(tmp0))]
val13=
val14=
!for val15 =1 to $val12 
tmp0=!item $val15 of $val10

val16=$(tmp0)
val17=Réponse $(val11[$val15])
!if $val16 isitemof $val8 
tmp0=!append item $val17 to $val13

val13=$(tmp0)
!else
tmp0=!append item $val17 to $val14

val14=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val13
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Les $(val6[1]) élèves d'une classe sont répartis en $(val6[2]) équipes de même effectif.	<p>Combien y-a-t-il d'élèves par équipe ?</p>	<ul>	 
!for m_l=1 to $val12 
$()	 <li>$(val11[$m_l]) : $(val10[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

