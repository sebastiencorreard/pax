val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 8

val6=$[rint($(tmp0))]
val7=$[rint($val6^3)]
val8=$[rint($val6^2)]
val9=$val8
val10=\(\frac{1}{$val8}),\(-\frac{1}{$val8}),-$val8,Ce n'est pas un réel
tmp0=!listcomplement $val9 in $val10

val10=$(tmp0)
tmp0=!shuffle $val9,$val10

val11=$(tmp0)
val12=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val11

val13=$[rint($(tmp0))]
val14=
val15=
!for val16 =1 to $val13 
tmp0=!item $val16 of $val11

val17=$(tmp0)
val18=Réponse $(val12[$val16])
!if $val17 isitemof $val9 
tmp0=!append item $val18 to $val14

val14=$(tmp0)
!else
tmp0=!append item $val18 to $val15

val15=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val14
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

