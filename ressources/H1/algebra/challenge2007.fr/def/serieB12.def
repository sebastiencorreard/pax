$()	Combien vaut 
!insmath (-\frac{1}{$val7})^{-(2/3)}
$()	<ul>	 
!for m_l=1 to $val13 
$()	 <li>$(val12[$m_l]) : $(val11[$m_l])</li>	 
!next
