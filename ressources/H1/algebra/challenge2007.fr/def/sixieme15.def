!set title=Sixième 15
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=2.00 m
val7=50 cm,1.50 m,2.50 m,3.00 m
tmp0=!shuffle $val6,$val7

val8=$(tmp0)
val9=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
val11=
val12=
!for val13 =1 to $val10 
tmp0=!item $val13 of $val8

val14=$(tmp0)
val15=Réponse $(val9[$val13])
!if $val14 isitemof $val6 
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!else
tmp0=!append item $val15 to $val12

val12=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La longueur d'une table avec ses deux rallonges est de 3 m. Dans cette position, elle mesure	6 fois plus que la largeur d'une rallonge.	<p>Combien mesure la table lorsque les rallonges sont repliées ?</p>	<ul>	 
!for m_l=1 to $val10 
$()	 <li>$(val9[$m_l]) : $(val8[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

