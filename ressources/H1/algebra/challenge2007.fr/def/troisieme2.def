!set title=Troisième 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/draw/clock 10:30:00,200,1,nosecond 
tmp0=$slib_out
val6=$(tmp0)
!readproc oef/draw.phtml 200,200 \
$val6 
tmp0=$ins_url
val6=$(tmp0)
val7=10H22
val8=10H15,10H18,10H25,10H30
tmp0=!shuffle $val7,$val8

val9=$(tmp0)
val10=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val9

val11=$[rint($(tmp0))]
val12=
val13=
!for val14 =1 to $val11 
tmp0=!item $val14 of $val9

val15=$(tmp0)
val16=Réponse $(val10[$val14])
!if $val15 isitemof $val7 
tmp0=!append item $val16 to $val12

val12=$(tmp0)
!else
tmp0=!append item $val16 to $val13

val13=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right"><img src="$val6" alt=""></div>	<ul><li>	Sur une horloge, à midi, les aiguilles sont superposées en position verticale.	</li><li>	Mais à 10HXX elles forment un angle plat.	</li><li>	Quelle est l'heure pour laquelle l'angle se rapproche le plus d'un angle plat ?	</li></ul>	<ul>	 
!for m_l=1 to $val11 
$()	 <li>$(val10[$m_l]) : $(val9[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,11
embedcnt=1
