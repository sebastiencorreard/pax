!set title=Série B 8
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

val6=$[rint($(tmp0))]
val7=-4
val8=-1,1,Il n'y a pas de solution réelle,\(\sqrt{5})
tmp0=!listcomplement $val7 in $val8

val8=$(tmp0)
tmp0=!shuffle $val7,$val8

val9=$(tmp0)
val10=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val9

val11=$[rint($(tmp0))]
val12=
val13=
!for val14 =1 to $val11 
tmp0=!item $val14 of $val9

val15=$(tmp0)
val16=Réponse $(val10[$val14])
!if $val15 isitemof $val7 
tmp0=!append item $val16 to $val12

val12=$(tmp0)
!else
tmp0=!append item $val16 to $val13

val13=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	On pose f(x) = 1 + 2/x et g(x) = 3 + 4/x.	<p>	Quelle est la plus petite solution réelle de l'équation f(f(x)) = g(g(x)).	</p>	<ul>	 
!for m_l=1 to $val11 
$()	 <li>$(val10[$m_l]) : $(val9[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

