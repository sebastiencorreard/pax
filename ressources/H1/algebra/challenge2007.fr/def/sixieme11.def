!set title=Sixième 11
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 5,7

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint 2, $val6-2

val7=$[rint($(tmp0))]
tmp0=!randint 55, 125

val8=$[rint(($val6-$val7)*$(tmp0))]
val9=$[rint($val8*$val6/($val6-$val7))]
val10=$[rint($val9/100)]
val11=$val7/$val6
tmp=!translate ";': to $     $ in $val8*$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val8*$val7

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in $val10*100

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
val12=$val8,$(tmp0),$(tmp1),$(tmp2)
tmp0=!listcomplement $val9 in $val12

val12=$(tmp0)
tmp0=!shuffle $val9,$val12

val13=$(tmp0)
val14=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val13

val15=$[rint($(tmp0))]
val16=
val17=
!for val18 =1 to $val15 
tmp0=!item $val18 of $val13

val19=$(tmp0)
val20=Réponse $(val14[$val18])
!if $val19 isitemof $val9 
tmp0=!append item $val20 to $val16

val16=$(tmp0)
!else
tmp0=!append item $val20 to $val17

val17=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val16
choicebad1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Un réservoir contient $val8 litres de gazole. Le 
!insmath $val11
$() du réservoir est alors vide.	<p>	Donner la capacité de ce réservoir.	</p>	<ul>	 
!for m_l=1 to $val15 
$()	 <li>$(val14[$m_l]) : $(val13[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

