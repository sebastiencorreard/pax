!set title=Jour de la semaine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi,Dimanche
val7=$val6,$val6
tmp0=!randint 1, 7

val8=$[rint($(tmp0))]
tmp0=!randint 1, 7

val9=$[rint($(tmp0))]
tmp0=!randint 6, 14

val10=$[rint($(tmp0)*7+$val9)]
tmp0=!item $val8+$val9 of $val7

val11=$(tmp0)
tmp0=!listcomplement $val11 in $val6

val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!item 1 to 4 of $val12

val12=$(tmp0)
tmp0=!shuffle $val11,$val12

val13=$(tmp0)
val14=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val13

val15=$[rint($(tmp0))]
val16=
val17=
!for val18 =1 to $val15 
tmp0=!item $val18 of $val13

val19=$(tmp0)
val20=Réponse $(val14[$val18])
!if $val19 isitemof $val11 
tmp0=!append item $val20 to $val16

val16=$(tmp0)
!else
tmp0=!append item $val20 to $val17

val17=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Nous sommes un $(val6[$val8]). Quel jour serons-nous dans $val10 jours ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,10
embedcnt=0
