!set title=Sixième 6
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 6,8,15,20,17,18,21,22	4,6,10,15,12,13,14,16

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$(val6[4])
tmp0=!item 5 to -1 of $val6

val8=$(tmp0)
tmp0=!shuffle $val7,$val8

val9=$(tmp0)
val10=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val9

val11=$[rint($(tmp0))]
val12=
val13=
!for val14 =1 to $val11 
tmp0=!item $val14 of $val9

val15=$(tmp0)
val16=Réponse $(val10[$val14])
!if $val15 isitemof $val7 
tmp0=!append item $val16 to $val12

val12=$(tmp0)
!else
tmp0=!append item $val16 to $val13

val13=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val12
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Une poule pond $(val6[1]) oeufs en $(val6[2]) jours. Combien faut-il de jours pour avoir $(val6[3]) oeufs ? <ul>	 
!for m_l=1 to $val11 
$()	 <li>$(val10[$m_l]) : $(val9[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,11
embedcnt=1
