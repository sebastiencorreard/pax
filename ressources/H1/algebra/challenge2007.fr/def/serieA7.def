!set title=Série A 7
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 5,10,17

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
val7=$[rint($val6-2)]
val8=$[4*sqrt($val6-1)]
tmp0=!shuffle A,B,C

val9=$(tmp0)
val10=$(val9[1])
val11=$(val9[2])
val12=$(val9[3])
val13=H
replytype1=algexp
replyname1=$val10$val13
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Soit un triangle $val10$val11$val12 tel que $val10$val11 = $val10$val12 = $val6, et la hauteur $val10$val13 = $val7.	<p>	Quelle est la longueur $val11$val12 ?	</p>	<b>Votre réponse</b> :  
!read oef/embed.phtml r1,5 
$().	<div class="wims_instruction">Tapez <span class="tt">sqrt(2)</span> pour 
!insmath \sqrt{2}
$().</div>
$()
!exit

