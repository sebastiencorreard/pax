!set title=Sixième 8
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi,Dimanche
val7=$val6,Lundi,Mardi
tmp0=!randint 1, 7

val8=$[rint($(tmp0))]
tmp0=!item $val8+2 of $val7

val9=$(tmp0)
val6=Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi,Dimanche
tmp0=!listcomplement $val9 in $val6

val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!item 1 to 4 of $val6

val6=$(tmp0)
tmp0=!shuffle $val9,$val6

val10=$(tmp0)
val11=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val10

val12=$[rint($(tmp0))]
val13=
val14=
!for val15 =1 to $val12 
tmp0=!item $val15 of $val10

val16=$(tmp0)
val17=Réponse $(val11[$val15])
!if $val16 isitemof $val9 
tmp0=!append item $val17 to $val13

val13=$(tmp0)
!else
tmp0=!append item $val17 to $val14

val14=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val13
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Nous sommes un $(val6[$val8]). Quel jour serons-nous dans 100 jours ?	<ul>	 
!for m_l=1 to $val12 
$()	 <li>$(val11[$m_l]) : $(val10[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

