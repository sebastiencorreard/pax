!set title=Série B 11
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand
language=fr

ansorder=c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint($(val6[1]))]
val8=$[rint($(val6[2]))]
val9=$[rint($val7+1)]
val10=$[rint($val8+1)]
val11=\(\sqrt{$val9})
val12=1,\(\infty),0,\(\sqrt{$val10})
tmp0=!listcomplement $val11 in $val12

val12=$(tmp0)
tmp0=!shuffle $val11,$val12

val13=$(tmp0)
val14=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val13

val15=$[rint($(tmp0))]
val16=
val17=
!for val18 =1 to $val15 
tmp0=!item $val18 of $val13

val19=$(tmp0)
val20=Réponse $(val14[$val18])
!if $val19 isitemof $val11 
tmp0=!append item $val20 to $val16

val16=$(tmp0)
!else
tmp0=!append item $val20 to $val17

val17=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val16
choicebad1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath \lim_{x\mapsto +\infty} \sqrt{1 + \frac{$val7 e^x + $val8}{1 + e^x}}
$()	<ul>	 
!for m_l=1 to $val15 
$()	 <li>$(val14[$m_l]) : $(val13[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()
$()
!exit

