!set title=Sixième 18
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 6, 7

val6=$[rint($(tmp0))]
tmp0=!item $val6 of ,,,,,T6.gif,T7.gif

val7=$(tmp0)
val8=$[rint($val6+14)]
val9=Il n'y en a pas,14,16,13,15
tmp0=!listcomplement $val8 in $val9

val9=$(tmp0)
tmp0=!shuffle $val8,$val9

val10=$(tmp0)
val11=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val10

val12=$[rint($(tmp0))]
val13=
val14=
!for val15 =1 to $val12 
tmp0=!item $val15 of $val10

val16=$(tmp0)
val17=Réponse $(val11[$val15])
!if $val16 isitemof $val8 
tmp0=!append item $val17 to $val13

val13=$(tmp0)
!else
tmp0=!append item $val17 to $val14

val14=$(tmp0)
!endif
!next
choicename1=Choisissez
choicegood1=$val13
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans le dessin ci-dessous, combien y-a-t-il de triangles visibles en tout ?	<div class="wimscenter"><img src="$val1/T3.gif" alt="">	&nbsp;<img src="$val1/$val7" alt="">&nbsp;<img src="$val1/T11.gif" alt=""></div>		<ul>	 
!for m_l=1 to $val12 
$()	 <li>$(val11[$m_l]) : $(val10[$m_l])</li>	 
!next
$()	</ul><b>Votre réponse</b> :  
!read oef/embed.phtml c1 
$()	
$()
!exit

