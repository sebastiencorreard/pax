!set title=Quatrième 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr
author=Fabrice, Guerimand

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 100,100 \
poly black,10,10,10,90,90,90,50,10 
tmp0=$ins_url
val6=$(tmp0)
!readproc oef/draw.phtml 100,100 \
square 10,10,80,black 
tmp0=$ins_url
val7=$(tmp0)
!readproc oef/draw.phtml 100,100 \
circle 50,50,90,black 
tmp0=$ins_url
val8=$(tmp0)
!readproc oef/draw.phtml 100,100 \
polygon black,10,10,10,90,60,90,90,60,90,10 
tmp0=$ins_url
val9=$(tmp0)
tmp0=!shuffle <img src="$val6" alt="">,<img src="$val7" alt="">,<img src="$val9" alt="">,<img src="$val8" alt="">

val10=$(tmp0)
choicename1=
choicegood1=C'est impossible
choicebad1=Figure A,Figure B,Figure C,Figure D
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	La figure à laquelle WIMS pense est un quadrilatère qui a exactement trois angles droits.	<p>	De quelle figure s'agit-il ?	</p>	<table class="wimscenter">	<tr>	 <td>$(val10[1])</td>	 <td>$(val10[2])</td>	 <td>$(val10[3])</td>	 <td>$(val10[4])</td>	</tr><tr>	 <td>Figure A</td>	 <td>Figure B</td>	 <td>Figure C</td>	 <td>Figure D</td>	</tr>	</table>	<b>Votre réponse :</b>  
!read oef/embed.phtml c1 
$()
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

