tmp0=!randint 86, 89

val6=$[rint($(tmp0))]
val7=$[rint(6000/(90-$val6))]
val8=$[rint(5000)]
val9=$[rint(4000)]
choicename1=Distance en kilomètres
choicegood1=$val7
choicebad1=5000,4000,3500,4500
