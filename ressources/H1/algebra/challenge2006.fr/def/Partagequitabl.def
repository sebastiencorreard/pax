!set title=Partage équitable d'un champ carré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand;Rallye mathématiques du centre
email=fwguerima@free.fr

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,M,N

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
tmp0=!item 5 of $val6

val11=$(tmp0)
tmp0=!item 6 of $val6

val12=$(tmp0)
!readproc oef/draw.phtml 200,200 \
range 0,5,0,5	rect 1,1,4,4,black	segment 4,4,1,2,black	segment 4,4,2,1,black	text black,4.1,4.3,medium,$val7	text black,0.7,4.3,medium,$val8	text black,0.7,0.8,medium,$val9	text black,4.1,0.8,medium,$val10	text black,0.7,2,medium,$val11	text black,2,0.8,medium,$val12 
tmp0=$ins_url
val13=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=$val9$val11
replygood1=1/3
replytype2=numexp
replyoption2=noreduction 
replyname2=$val9$val12
replygood2=1/3
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-8">	    Un paysan décide de partager un champ carré, $val7$val8$val9$val10, en trois parcelles $val7$val8$val11, $val7$val11$val9$val12, et $val7$val12$val10.<br>	    Où doit-il placer les points $val11 et $val12 sur les segments 
!insmath [$val9$val8]
$() et 
!insmath [$val9$val10]
$() pour que les trois parcelles aient la même aire ?	    <u><b>Votre réponse </b></u>:	    <ul>	      <li> 
!insmath $val9$val11 =
$() 
!read oef/embed.phtml r1,5 
$() 
!insmath $val9$val8
$().</li>	      <li> 
!insmath $val9$val12 =
$() 
!read oef/embed.phtml r2,5 
$() 
!insmath $val9$val10
$().</li>	    </ul>	    <div class="wims_instruction">Ecrire chaque résultat sous forme de fraction. Ecrire 3/4 pour 
!insmath \frac{3}{4}
$()</div>	  </div>	  <div class="cell small-12 medium-6 large-4">	    <img alt="Dessin du champ" src="$val13">	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12,13
embedcnt=2
