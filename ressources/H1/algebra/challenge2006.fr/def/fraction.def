!set title=Une petite fraction (4&3)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr

ansorder=c
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(\frac{16}{17})
val7=\(\frac{1}{17}),\(8\;),\(\frac{1}{2}),\(\frac{2}{34})
tmp0=!shuffle $val6,$val7

val8=$(tmp0)
val9=A,B,C,D,E,F,G,H,I
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
val11=
val12=
!for val13 =1 to $val10 
tmp0=!item $val13 of $val8

val14=$(tmp0)
val15=R&eacute;ponse $(val9[$val13])
!if $val14 isitemof $val6 
tmp0=!append item $val15 to $val11

val11=$(tmp0)
!else
tmp0=!append item $val15 to $val12

val12=$(tmp0)
!endif
!next
tmp0=!texmath 4/(5-(3/4)) 

val16=$(tmp0)
choicename1=Choisissez
choicegood1=$val11
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	
!insmath $val16
$() vaut ...	<ul>	 
!for m_l=1 to $val10 
$()	 <li>$(val9[$m_l]) : $(val8[$m_l])</li>	 
!next
$()	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,16
embedcnt=0
