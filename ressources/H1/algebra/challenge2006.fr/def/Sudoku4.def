:postdef
val40=$(val8[1]),$val10,$val11,$val12	$(val8[2]),$val13,$val14,$val15	$(val8[3]),$val16,$val17,$val18	$(val8[4]),$val19,$val20,$val21	$val10,$val13,$val16,$val19	$val11,$val14,$val17,$val20	$val12,$val15,$val18,$val21	$(val8[1]),$val13,$val17,$val21	$(val8[4]),$val16,$val14,$val12
val41=
!for val42 =1 to 9 
tmp=!translate internal $	$ to ; in $val40

tmp=!row $val42 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val43=$(tmp0)
tmp0=!listuniq $val43

val43=$(tmp0)
tmp0=!itemcnt $val43

val43=$(tmp0)
tmp0=!append item $val43 to $val41

val41=$(tmp0)
!next
tmp0=!listuniq $val41

val41=$(tmp0)

!exit

