!goto stat

!exit

:question
$()	Compléter la grille suivante de telle sorte que chaque chiffre n'apparaisse qu'une seule fois dans chaque ligne, chaque colonne et les deux diagonales.	<table class="wimscenter wimsborder">	  
!for m_k=1 to $val6 
$()	  <tr>	   <td>$(val8[$m_k])</td>	   
!for m_l=2 to $val6 
$()	   <td > 
!read oef/embed.phtml $(val9[($m_k-1)*($val6-1)+$m_l-1]),$val7 
$()</td>	   
!next
$()	  </tr>	  
!next
$()	</table>	
$()
