!set title=La basse-cour
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Joseph,Cesaro;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint($(val6[1])$(val6[1]))]
val8=$[rint($(val6[2])$(val6[2]))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of coq,coqs

val10=$(tmp0)
val11=$[rint(4*$val7+2*$val8+2*$val9)]
replytype1=numexp
replyname1=Réponse
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Dans une basse-cour il y a $val7 lapins, $val8 poules et $val9 $val10.<br>		Combien y-a-t-il de pattes en tout ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10
embedcnt=0
