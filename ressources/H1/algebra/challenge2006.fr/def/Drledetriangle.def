!set title=Drôle de triangle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
!readproc slib/lang/fname fr,boy girl,1 
tmp0=$slib_out
val10=$(tmp0)
choicename1=Titre 1
choicegood1=Il est plat
choicebad1=Il est rectangle,Il est isocèle, il est 	équilatéral
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10 a dessiné un triangle $val7$val8$val9 	tel que la médiane issue de $val7 	est perpendiculaire à la hauteur issue de $val8.	Que peut on dire de ce triangle ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10
embedcnt=0
