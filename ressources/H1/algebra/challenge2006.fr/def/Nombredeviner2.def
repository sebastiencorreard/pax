val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 19

val6=$[rint($(tmp0))]
tmp0=!randint 2, 4

val7=$[rint($(tmp0))]
tmp0=!randint 13, 15

val8=$[rint($(tmp0))]
tmp0=!randint 11, 19

val9=$[rint($(tmp0))]
val10=$[rint(($val8*$val6+$val9)/$val7)]
replytype1=numexp
replyname1=Réponse
replygood1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Je pense à un nombre entier,	<ul>	 <li>si je le multiplie par $val8,</li>	 <li>puis j'ajoute $val9,</li>	 <li>je divise par $val7 le résultat obtenu,</li>	 <li>et enfin je l'arrondis à l'unité près.</li>	</ul>	je trouve $val10.<br>	A quel nombre pensais-je ?
$()
!exit

