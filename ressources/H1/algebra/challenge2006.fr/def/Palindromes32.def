tmp0=!randint 1, 9

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 6

val9=$[rint($(tmp0))]
val10=$[rint($val9+3)]
val11=$[rint($val10$val6$val9)]
val12=$[rint($val9$val7$val8)]
val13=$[rint(10*(-$val9+$val10)+$val6-$val7)]
tmp0=!randint 1, 9

val14=$[rint($(tmp0))]
tmp0=!randint 1, 9

val15=$[rint($(tmp0))]
replytype1=numexp
replyname1=Réponse
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Un nombre palindrome est un nombre dont l'écriture peut se lire indifféremment	  de gauche à droite et de droite à gauche en conservant la même valeur.	<br>	  Par exemple : $val14$val15$val15$val14 est un palindrome.	<br>	Combien y-a-t-il de palindromes compris entre 
!insmath $val12
$() et 
!insmath $val11
$() ?
$()
