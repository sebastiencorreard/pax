tmp0=!randitem 7,8,9,10,11

val6=$[rint($(tmp0))]
tmp0=!randint 3, 5

val7=$[rint($val6*10*$(tmp0))]
val8=$[rint($val6*100)]
val9=$[(1440*$val7)/$val8]
replyname1=réponse
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Un robinet fuit à raison d'une goutte par minute.	On considère qu'il faut $val8 gouttes pour remplir une bouteille de 1 litre.	Quel sera le nombre de litres perdus en $val7 jours ?	<br><b><u>Réponse</u></b> :<br>	On perdra  
!read oef/embed.phtml r1,10 
$() litres.	
$()
