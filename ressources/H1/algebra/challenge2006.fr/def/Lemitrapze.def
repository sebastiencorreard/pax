!set title=Le mi-trapèze.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
tmp0=!item 5 of $val6

val11=$(tmp0)
replytype1=default
replyname1=$val7$val11 mesure (en kilomètres)
replygood1=28
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ul>	  <li>Un trapèze $val7$val8$val9$val10 a deux côtés parallèles [$val7$val8] et [$val9$val10].</li>	  <li>Ces côtés mesurent $val7$val8=40 et $val9$val10=16 (ce sont des kilomètres...).</li>	  <li>On cherche le point $val11 appartenant à [$val7$val8] tel que le segment [$val10$val11] coupe le trapèze en deux parties 	d'aires égales.</li>	</ul>	Combien mesure $val7$val11 ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=0
