val6=$[rint($(tmp0))]
tmp0=!randint 3, 4

val7=$[rint($(tmp0))]
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
val9=$[rint(10*$val6)]
val10=$[rint(10*$val7)]
val11=$[rint(10*$val8)]
val12=$[rint(30-3*$val6-3*$val7+3*$val8)]
