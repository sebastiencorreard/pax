!set title=Multiplication
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr

ansorder=r
varcnt=8
prevarcnt=4
postvarcnt=3
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname fr,boy girl 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!shuffle 3,7,13,11,37

val7=$(tmp0)
tmp0=!randint 1, 5

val8=$[rint($(tmp0))]
val9=$[rint($(val7[1])*$(val7[2])*$(val7[3])*$val8)]
replytype1=numexp
replyname1=Réponse
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6 a multiplié $val9 par un entier et n'a trouvé que des $val8.	Quel est cet entier ?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val11=$[rint($val10*$val9)]
tmp0=!text select $val8 in $val11

val12=$(tmp0)

!ifval $val12=$val11
val12=1
!else
val12=0
!endif

!exit

:feedback
!ifval $val12=0
 <div class='oef_feedbacks'>
!insmath $val10 \times $val9 = $val11
$() qui ne contient pas que des $val8.
$()</div>
!endif

!exit

:test

!ifval $val12=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bon nombre

!exit

:stat
vsavelist=6,8,9,10
embedcnt=0
