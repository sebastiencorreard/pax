!set title=Palindromes 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand;Joseph,Cesaro
email=fwguerima@free.fr
language=fr
oefobservation=Il y a 4 exercices Palindromes de difficulté différente (1 le plus difficile à 4 le plus facile).

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
tmp0=!randint 1, 9-$val6-3

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, 9-$val6

val9=$[rint($(tmp0))]
val10=$[rint($val9$val7$val8)]
val11=$[rint($val10+$val6*100)]
val12=$[rint(10*$val6)]
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
tmp0=!randint 1, 9

val14=$[rint($(tmp0))]
replytype1=numexp
replyname1=Réponse
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Un nombre palindrome est un nombre dont l'écriture peut se lire indifféremment	  de gauche à droite et de droite à gauche en conservant la même valeur.	<br>	  Par exemple : $val13$val14$val14$val13 est un palindrome.	<br>	Combien y-a-t-il de palindromes compris entre 
!insmath $val10
$() et 
!insmath $val11
$() ?
$()
!exit

