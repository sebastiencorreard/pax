!set title=Le grand tournoi.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Fabrice,Guerimand
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
tmp0=!randint 5, 9

val7=$[rint($(tmp0))]
val8=$[rint($val7-1)]
val9=$[rint(0.5*$val6*$val7*$val8)]
replytype1=default
replyname1=Le nombre total de parties est :
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Lors d'un tournoi d'échecs, chaque joueur a joué $val6 parties 	avec chacun des autres, il y a $val7 joueurs. 	Combien de parties ont été jouées dans ce tournoi ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=0
