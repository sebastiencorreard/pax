!set title=Somme et produit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Joseph,Cesaro;Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in (24;3),(3;12),(15;7),(8;11)	(47;2),(17;2),(53;1),(24;4),(5;12)

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 to -1 of $val6

val8=$(tmp0)
choicename1=Réponse
choicegood1=$val7
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Pour le couple (9,9) on obtient :	<div class="wimscenter">	
!insmath 9 + 9 = 18 \quad \quad ; \quad\quad 9 \times 9 = 81
$()	</div>	Il y a inversion des chiffres du résultat.	<br>	Parmi les couples suivants quel est celui qui a la même propriété ?
$()
!exit

