!set title=Périmètre
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand;Rallye Mathématiques d'indre et loire
email=fwguerima@free.fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(3)]
tmp=!nonempty items 8,9,11,12,13

tmp0=!randitem $tmp
val7=$[rint(4*$val6*$(tmp0))]
val8=$[$val7/2*(1+1/$val6)]
!readproc oef/draw.phtml 200,200 \
range 0,$val6+2,0,$val6+2	rect 1,1,$val6+1,$val6+1,black	parallel 2,1,2,$val6+1,1,0,$val6-1,black 
tmp0=$ins_url
val9=$(tmp0)
replytype1=numexp
replyname1=Périmètre
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-8">	    Le périmètre d'un terrain carré mesure $val7 mètres.<br>	    On le divise en $val6 parcelles rectangulaires identiques comme ci-dessous :	    Quelle est la mesure du périmètre de chacune des parcelles ?	    <br><u><b>Votre réponse </b></u><br>	     La mesure du périmètre de chacune des parcelles est de  
!read oef/embed.phtml r1,8 
$() mètres.	  </div>	  <div class="cell small-12 medium-6 large-4">	    <img alt="Dessin du terrain" src="$val9">	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9
embedcnt=1
