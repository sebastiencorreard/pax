!set title=Soustraction à trous
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 21, 49

val6=$[rint($(tmp0)*10+7)]
tmp0=!randint 11, 19

val7=$[rint($(tmp0)*10+5)]
val8=$[rint($val6+$val7)]
tmp0=!char 1 of $val8

val9=$[rint($(tmp0))]
tmp0=!char 2 of $val8

val10=$[rint($(tmp0))]
tmp0=!char 3 of $val8

val11=$[rint($(tmp0))]
replytype1=numexp
replyname1=Le chiffre manquant est :
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Il y a cette soustraction : 	<div class="wimscenter"> $val9@$val11 - $val7 = $val6,</div> 	où un chiffre a été effacé et remplacé par le signe @.<br>	Retrouvez ce chiffre !
$()
!exit

