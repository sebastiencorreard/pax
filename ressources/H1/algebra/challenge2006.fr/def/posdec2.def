!set title=Ranger des décimaux
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r
varcnt=16
prevarcnt=14
postvarcnt=1
replycnt=4
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=60x30x1
tmp0=!randint 11, 59

val7=$[rint($(tmp0))]
tmp0=!randint 6, 9

val8=$[rint($(tmp0))]
tmp0=!randint 1, $val8-2

val9=$[rint($(tmp0))]
val10=$val7.$val8
val11=$val7.$val9$val8
val12=$[$val7.$val8$val9/10]
val13=$val8.$val9$val8$val9
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]

!ifval $val14=1
val15=$val12,$val13,$val11,$val10
!else
val15=$val10,$val11,$val13,$val12
!endif
val16=du plus petit au plus grand,du plus grand au plus petit
val17=&lt;,&gt;
val17=$(val17[$val14])
val18=r1,r2,r3,r4
replytype1=dragfill
replyname1=Premier
replygood1=?analyze 19;$val15
replytype2=dragfill
replyname2=Deuxième
replygood2=?analyze 20
replytype3=dragfill
replyname3=Troisième
replygood3=?analyze 21
replytype4=dragfill
replyname4=Quatrième
replygood4=?analyze 22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ranger les nombres ci-dessous, $(val16[$val14]).	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val6 
$()	 
!for m_t=2 to 4 
$()	 $val17  
!read oef/embed.phtml $(val18[$m_t]),$val6 
$()	 
!next
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val23=$val19,$val20,$val21,$val22

!exit

:feedback

!exit

:test

!ifval $val23 issametext $val15
 condtest1=1
!else
 condtest1=0
!endif
condname1=Ordre correct

!exit

:stat
vsavelist=6,14,15,16,17,18,19,20,21,22
embedcnt=2
