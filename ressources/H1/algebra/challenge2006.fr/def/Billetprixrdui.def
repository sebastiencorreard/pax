!set title=Billet à prix réduit
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Fabrice,Guerimand
email=fwguerima@free.fr
computeanswer=no
precision=100

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 4

val6=$[rint($(tmp0))]
val7=$[rint(10*$val6)]
val8=$[$val6/10]
val9=$[1-$val8]
tmp0=!randint 6, 12

val10=$[rint($(tmp0))]
val11=$[rint(10*$val10)]
val12=$[$val11/$val9]
replytype1=default
replyname1=Indiquez le prix en euros :
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Après réduction de $val7%, le prix d'un vol aller retour Quimper 	Hambourg	est de $val11 euros. Quel serait le prix, sans réduction ?	Indiquez votre réponse au centime inférieur d'euro près.
$()
!exit

