val6=$[rint($(tmp0))]
val7=$[rint($val6-3)]
tmp0=!randint 5, 9

val8=$[rint($(tmp0))]
val9=$[rint(14-$val8)]
replytype1=default
replyname1=Le chiffre manquant est :
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

