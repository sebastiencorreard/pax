!set title=Pliages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 4

val6=$[rint($(tmp0))]
tmp0=!randint 8, 12

val7=$[rint($(tmp0))]
val8=$[rint($val7*(2*$val6+1))]
val9=$[rint(2*$val8)]
val10=$[rint($val7*$val6)]
val11=$[rint($val6+1)]
replytype1=default
replyname1=La largeur de la feuille était :
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Une feuille de métal rectangulaire de périmètre $val9 a été 	pliée $val6 fois dans le sens de la largeur et 	$val11 fois dans le sens de la longueur, et on a ainsi obtenu 	un carré.<br>		Quelle était la largueur de la feuille avant pliage ?
$()
!exit

