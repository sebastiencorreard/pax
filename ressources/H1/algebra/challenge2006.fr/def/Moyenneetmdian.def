!set title=Moyenne et médiane
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=fwguerima@free.fr

ansorder=r,r
varcnt=11
prevarcnt=2
postvarcnt=8
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(4)]
val7=$[4.5]
replytype1=auto

replyname1=Réponse 1
replygood1=?analyze 8
replytype2=auto

replyname2=Réponse 2
replygood2=?analyze 9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ol>	 <li>	   Donnez un exemple d'une série de cinq valeurs dont la médiane vaut $val6 et la moyenne $val7.	   <br><u><b> Votre réponse : </b></u>  
!read oef/embed.phtml r1 
$().	 </li>	 <li>	   Donnez un exemple d'une série de cinq valeurs dont la moyenne vaut $val6 et la médiane $val7.	   <br><u><b> Votre réponse : </b></u>  
!read oef/embed.phtml r2 
$().	 </li>	</ol>	<div class="wims_instruction">Vous devez séparer les valeurs par des virgules. Le séparateur décimal est le point.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!itemcnt $val8

val10=$[rint($(tmp0))]
tmp0=!replace internal , by + in $val8

val11=$[$(tmp0)]
val11=$[$val11/$val10]
!readproc slib/stat/median [$val8] 
tmp0=$slib_out
val12=$[$(tmp0)]
tmp0=!itemcnt $val9

val13=$[rint($(tmp0))]
tmp0=!replace internal , by + in $val9

val14=$[$(tmp0)]
val14=$[$val14/$val13]
!readproc slib/stat/median [$val9] 
tmp0=$slib_out
val15=$[$(tmp0)]

!exit

:feedback

!exit

:test

!ifval ($val10=5 and $val11=$val7) and $val12=$val6
 condtest1=1
!else
 condtest1=0
!endif
condname1=Première liste

!ifval ($val13=5 and $val14=$val6) and $val15=$val7
 condtest2=1
!else
 condtest2=0
!endif
condname2=Première liste

!exit

:stat
vsavelist=6,7,8,9
embedcnt=2
