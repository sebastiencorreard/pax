!set title=Drôle de triangle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F

val6=$(tmp0)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp0=!item 4 of $val6

val10=$(tmp0)
!readproc slib/lang/fname fr,boy girl,1 
tmp0=$slib_out
val11=$(tmp0)
choicename1=Titre 1
choicegood1=$val7'$val10 = $val8$val9/2
choicebad1=\($val8$val9^2=$val7$val8^2+$val7$val9^2),$val10 est au milieu de [$val7$val8], 	$val7$val8$val9 est rectangle en $val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 a dessiné un triangle $val7$val8$val9 	tel que la médiane issue de $val8 et celle issue de $val9 se coupent en $val10 	suivant un angle droit. $val7' est le milieu de [$val8$val9].	Que peut on dire de ce triangle ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=0
