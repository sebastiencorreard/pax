!set title=Chez l'épicier
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/lang/fname girl,fr 
tmp0=$slib_out
val6=$(tmp0)
!readproc slib/lang/fname boy,fr 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 2, 3

val8=$[rint($(tmp0))]
tmp0=!randint 2, 3

val9=$[rint($(tmp0))]
tmp0=!randint 4, 5

val10=$[rint($(tmp0))]
tmp0=!randint 6, 9

val11=$[rint($(tmp0))]
tmp0=!randint 2, 4

val12=$[rint($(tmp0))]
tmp0=!randint 2, 4

val13=$[rint($(tmp0))]
tmp0=!randint 12, 19

val14=$[$(tmp0)/10]
tmp0=!randint 5, 11

val15=$[$(tmp0)/10]
tmp0=!randint 2, 4

val16=$[$(tmp0)]
val17=$[rint($val9*$val8+$val12)]
val18=$[rint($val10*$val8+$val13)]
val19=$[rint($val11*$val8)]
tmp=!nonempty items poires,pommes,pêches,bananes

tmp0=!randitem $tmp
val20=$(tmp0)
tmp=!nonempty items lait,jus d'orange,jus d'ananas

tmp0=!randitem $tmp
val21=$(tmp0)
tmp=!nonempty items chocolats,caramels,carambars

tmp0=!randitem $tmp
val22=$(tmp0)
val23=$[$val9*$val14+$val10*$val15+$val11*$val16]
val24=$[$val17*$val14+$val18*$val15+$val19*$val16]
val25=$[$val12*$val14+$val13*$val15]
replytype1=numexp
replyname1=somme à payer
replygood1=$val25
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ul>	 <li>Chez l'épicier, $val6 a acheté $val9 kilogrammes de $val20, $val10 litres de $val21 et $val11 $val22 et elle a payé $val23 euros.</li>	 <li>Chez le même épicier, $val7 a acheté $val17 kilogrammes de $val20, $val18 litres de $val21 et $val19 $val22 et il a payé $val24 euros.</li>	</ul> 	Combien paierez-vous si vous achètez dans cette épicerie $val12 kilogrammes de $val20 et $val13 litres de $val21 ?	<br><b><u>Votre réponse :</u></b><br>	Somme à payer :  
!read oef/embed.phtml r1,5 
$() euros.
$()
!exit

