\integer{a=random(101..998)}
\statement{L'entier \a\a est divisible par \a, et le quotient est 
encore divisible par trois nombres inférieurs à 20.
Lesquels ?
<br>
<div class="wims_instruction">
Répondez en les donnant dans l'ordre croissant.
</div>}


\answer{réponse 1}{7}{type=default}
\answer{réponse 2}{11}{type=default}
\answer{réponse 3}{13}{type=default}
