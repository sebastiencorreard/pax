\title{Trouver l'intrus}
\author{Joseph,Cesaro;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\text{listpair=wims(values 2*v for v=1 to 9)}
\text{listimpair=wims(values 2*v+1 for v=1 to 9)}
\integer{ch=randint(1..2)}
\if{\ch=1}{
 \text{listimpair=shuffle(\listimpair)}
 \text{bad=item(1 to 6,\listimpair)}
 \text{good=randint(\listpair)}
}{
 \text{listpair=shuffle(\listpair)}
 \text{bad=item(1 to 6,\listpair)}
 \text{good=randint(\listimpair)}
}

\statement{
Parmi les 7 nombres suivants, indiquez quel est l'intrus.}

\choice{Intru}{\good}{\bad}
