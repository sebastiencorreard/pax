\title{Le plus grand}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\language{fr}


\real{nb=randint(10000..1000000)/100}
\real{N1=\nb/1000}
\text{n1=\(\N1 \times 100)}
\real{N2=\nb*100}
\text{n2=\(\N2 : 1000\;)}
\real{N3=\nb/10000}
\text{n3=\(\N3 \times 100000)}


\statement{Parmi ces écritures laquelle désigne le plus grand nombre ?}

\choice{Réponse}{\n3}{\n1,\n2}
