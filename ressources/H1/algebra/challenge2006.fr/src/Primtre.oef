\title{Périmètre}
\author{Fabrice,Guerimand;Rallye Mathématiques d'indre et loire}
\email{fwguerima@free.fr}
\format{html}

\integer{nb=3}
\integer{peri=4*\nb*randitem(8,9,11,12,13)}
\real{rep=\peri/2*(1+1/\nb)}

\text{image=draw(200,200
range 0,\nb+2,0,\nb+2
rect 1,1,\nb+1,\nb+1,black
parallel 2,1,2,\nb+1,1,0,\nb-1,black)}


\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    Le périmètre d'un terrain carré mesure \peri mètres.<br>
    On le divise en \nb parcelles rectangulaires identiques comme ci-dessous :
    Quelle est la mesure du périmètre de chacune des parcelles ?
    <br><u><b>Votre réponse </b></u><br>
     La mesure du périmètre de chacune des parcelles est de \embed{r1,8} mètres.
  </div>
  <div class="cell small-12 medium-6 large-4">
    <img alt="Dessin du terrain" src="\image">
  </div>
</div>
}

\answer{Périmètre}{\rep}{type=numexp}
