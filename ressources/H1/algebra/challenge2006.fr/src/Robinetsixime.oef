\title{Robinet sixième}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\language{fr}
\format{html}

\integer{p=randint(7,8,9,10,11)}
\integer{jo=\p*10*randint(3..5)}
\integer{nbgoutte=\p*100}
\real{rep=(1440*\jo)/\nbgoutte}

\statement{Un robinet fuit à raison d'une goutte par minute.
On considère qu'il faut \nbgoutte gouttes pour remplir une bouteille de 1 litre.
Quel sera le nombre de litres perdus en \jo jours ?
<br><b><u>Réponse</u></b> :<br>
On perdra \embed{r1,10} litres.
}

\reply{réponse}{\rep}{numexp}
