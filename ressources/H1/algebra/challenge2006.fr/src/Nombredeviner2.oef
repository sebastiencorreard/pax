\title{Nombre à deviner 2}
\author{Joseph,Cesaro;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\integer{N=randint(11..19)}
\integer{div=randint(2..4)}
\integer{mult=randint(13..15)}
\integer{a=randint(11..19)}
\integer{result=(\mult*\N+\a)/\div}


\statement{
Je pense à un nombre entier,
<ul>
 <li>si je le multiplie par \mult,</li>
 <li>puis j'ajoute \a,</li>
 <li>je divise par \div le résultat obtenu,</li>
 <li>et enfin je l'arrondis à l'unité près.</li>
</ul>
je trouve \result.<br>
A quel nombre pensais-je ?}

\answer{Réponse}{\N}{type=numexp}
