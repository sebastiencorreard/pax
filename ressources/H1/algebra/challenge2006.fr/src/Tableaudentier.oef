\title{Tableau d'entiers}
\author{Fabrice,Guerimand;Rallye Mathématiques de Maine et loire}
\email{fwguerima@free.fr}
\format{html}

\integer{nb=randint(5..9)}
\text{chiffre=wims(values v for v=1 to \nb*5)}
\integer{nombre=randint(234..285)}

\integer{lig=ceil(\nombre/\nb)}
\integer{col=\nombre-(\lig-1)*\nb}
\real{tst=rint(\lig/2)-\lig/2}
\integer{col=\tst=0?\nb-\col+1}

\statement{
On écrit les nombres à partir de 1 dans un tableau à \nb colonnes.<br>
On écrit une ligne dans un sens et une ligne dans l'autre sens  et ainsi de suite comme représenté ci-dessous.
<table class="wimscenter wimsborder">
   \for{k=1 to 5}{
    <tr>
     \for{l=1 to \nb}{
        <td>
      \if{\k isin 1,3,5}{
       \chiffre[(\k-1)*\nb+\l]       
      }{
       \chiffre[(\k-1)*\nb+\nb-\l+1] 
      }
      </td>
     }
    </tr>
   }
   </table>
Dans quelle colonne et dans quelle ligne du tableau place-t-on le nombre \nombre ?
}

\answer{Colonne}{\col}{type=auto}
\answer{Ligne}{\lig}{type=auto}
