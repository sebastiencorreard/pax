\title{Robinet}
\author{Fabrice,Guerimand}
\language{fr}
\format{html}

\text{good=4320}
\text{bad=432,43200,1555200000}
\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=R&eacute;ponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{Un robinet fuit à raison d'une goutte par seconde.
On considère qu'il faut 600 gouttes pour remplir une bouteille de 100 millilitres.
Quel sera le nombre de litres perdus en 300 jours ?
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul>}
\choice{Choisissez}{\Good}{\Bad}
