\title{Prendre l'avion}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\text{name=slib(lang/fname boy,fr)}
\integer{ch=randint(2..4)}
\integer{dvol=randint(9..11)}
\integer{hhouston=randint(2..4)}
\integer{hparis=randint(22..23)}

\text{escales=d'une heure,d'une heure quinze,d'une heure et demi,d'une heure trois quart}
\text{escale=item(\ch,\escales)}
\integer{smin=(\ch-1)*15}
\integer{duree=24-\hparis+7+\hhouston}
\integer{hrio=\hhouston+\dvol+4}

\statement{
\name part de Paris à \hparis H 00 pour Rio de Janeiro. 
Son avion se pose à Houston à 0\hhouston H 00 (heure locale) pour une escale \escale.<br>
Le vol entre Houston et Rio de Janeiro dure \dvol heures.<br>
Houston est à l'ouest de Paris et il y a 7 heures de décalage horaire entre ces deux villes.<br>
Rio de Janeiro est à l'est de Houston et il y a 3 heures de décalage horaire entre ces deux villes.
<ol>
 <li> Quelle est la durée du vol entre Paris et Houston ?
 <br><u><b> Votre réponse </b></u><br>
 Le vol dure \embed{r1,5} heures.</li>
 <li> A quelle heure (heure locale) \name arrive-t-il à Rio de Janeiro ?
 <br><u><b> Votre réponse </b></u><br>
Il arrive a \embed{r2,3}H\embed{r3,3}min.</li>
</ol>}

\answer{Durée}{\duree}{type=numexp}
\answer{Heure d'arrivée}{\hrio}{type=numexp}
\answer{minute d'arrivée}{\smin}{type=numexp}
