\title{Multiplication}
\auteur{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\text{name=slib(lang/fname fr,boy girl)}

\text{lt=shuffle(3,7,13,11,37)}
\integer{c=randint(1..5)}
\integer{nombre=\lt[1]*\lt[2]*\lt[3]*\c}


\statement{\name a multiplié \nombre par un entier et n'a trouvé que des \c.
Quel est cet entier ?
}

\answer{Réponse}{\rep}{type=numexp}

\integer{p=\rep*\nombre}
\text{tst=wims(text select \c in \p)}
\text{tst=\tst=\p?1:0}
\condition{Bon nombre}{\tst=1}
\feedback{\tst=0}{\(\rep \times \nombre = \p) qui ne contient pas que des \c.}
