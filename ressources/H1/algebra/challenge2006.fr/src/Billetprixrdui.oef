\title{Billet à prix réduit}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{p=random(1..4)}
\integer{a=10*\p}
\real{c=\p/10}
\real{d=1-\c}
\integer{q=random(6..12)}
\integer{b=10*\q}
\real{r=\b/\d}
\statement{Après réduction de \a%, le prix d'un vol aller retour Quimper 
Hambourg
est de \b euros. Quel serait le prix, sans réduction ?
Indiquez votre réponse au centime inférieur d'euro près.}


\answer{Indiquez le prix en euros :}{\r}{type=default}
