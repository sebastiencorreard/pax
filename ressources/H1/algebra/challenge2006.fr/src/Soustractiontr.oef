\title{Soustraction à trous}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{S=randint(21..49)*10+7}
\integer{N2=randint(11..19)*10+5}
\integer{N1=\S+\N2}
\integer{c1=wims(char 1 of \N1)}
\integer{c2=wims(char 2 of \N1)}
\integer{c3=wims(char 3 of \N1)}

\statement{
Il y a cette soustraction : 
<div class="wimscenter"> \c1@\c3 - \N2 = \S,</div> 
où un chiffre a été effacé et remplacé par le signe @.<br>
Retrouvez ce chiffre !}


\answer{Le chiffre manquant est :}{\c2}{type=numexp}
