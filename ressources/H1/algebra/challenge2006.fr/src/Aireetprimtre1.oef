\title{Périmètre 1}
\author{Fabrice,Guerimand}

\text{name=slib(lang/fname fr,boy)}

\text{a=shuffle(2,3)}
\integer{p=randitem(83,89,79,73,97)}
\integer{k=1}
\integer{nombre=\a[1]^3*\a[2]*\p}
\integer{long=2*\k*(\a[1]^3*\a[2]+\p)}

\statement{
\name dispose de \nombre cubes dont les arêtes mesurent \k cm. 
Il les dispose en une seule épaisseur de façon à former un rectangle.<br>
Il les entoure ensuite avec une ficelle.
Quelle est la longueur minimale de ficelle dont a besoin \name ?
<br><b><u>Votre réponse :</u></b><br>
Il lui faut \embed{r1,5} cm de ficelle.}

\answer{longueur}{\long}{type=numexp}
