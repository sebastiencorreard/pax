# analyse de réponse
\text{tableau=\list[1],\rep1,\rep2,\rep3,\rep4
\list[2],\rep5,\rep6,\rep7,\rep8
\list[3],\rep9,\rep10,\rep11,\rep12
\list[4],\rep13,\rep14,\rep15,\rep16
\list[5],\rep17,\rep18,\rep19,\rep20
\rep1,\rep5,\rep9,\rep13,\rep17
\rep2,\rep6,\rep10,\rep14,\rep18
\rep3,\rep7,\rep11,\rep15,\rep19
\rep4,\rep8,\rep12,\rep16,\rep20
\list[1],\rep5,\rep10,\rep15,\rep20
\list[5],\rep13,\rep10,\rep7,\rep4}
\text{cpt=}
\for{k=1 to 11}{
 \text{ligne=row(\k,\tableau)}
 \text{ligne=wims(listuniq \ligne)}
 \text{ligne=items(\ligne)}
 \text{cpt=wims(append item \ligne to \cpt)}
}
\text{cpt=wims(listuniq \cpt)}
\condition{Grille correcte}{\cpt=\nb}
