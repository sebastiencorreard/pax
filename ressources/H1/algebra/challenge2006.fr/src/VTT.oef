\title{VTT}
\author{Fabrice,Guerimand;Tournoi APMEP rennes 1992}
\email{fwguerima@free.fr}
\format{html}

\integer{lc=randint(2..5)*10}
\integer{nb=randint(11..19)*10}
\real{rep=4*\lc*\nb/100}

\text{name=slib(lang/fname fr,boy)} 

\statement{
\name possède un vélo dont les roues sont des carrés dont les côtés mesurent \lc cm.
<br>
Quelle distance, en mètres, aura-t-il parcouru si la roue avant de son vélo fait \nb tours ?
<br><b><u> Votre réponse :</u></b><br>
Il aura parcouru \embed{r1,8} mètres.}

\answer{Distance}{\rep}{type=numexp}
