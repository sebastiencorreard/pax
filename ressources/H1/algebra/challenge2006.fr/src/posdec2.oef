\title{Ranger des décimaux}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\text{size=60x30x1}

\integer{a=randint(11..59)}
\integer{b=randint(6..9)}
\integer{c=randint(1..\b-2)}

\text{nb1=\a.\b}
\text{nb2=\a.\c\b}
\real{nb3=\a.\b\c/10}
\text{nb4=\b.\c\b\c}

\integer{ordre=randint(1..2)}
\text{good=\ordre=1?\nb3,\nb4,\nb2,\nb1:\nb1,\nb2,\nb4,\nb3}
\text{tordre=du plus petit au plus grand,du plus grand au plus petit}
\text{tsymb=&lt;,&gt;}
\text{tsymb=\tsymb[\ordre]}
\text{r=r1,r2,r3,r4}

\statement{
Ranger les nombres ci-dessous, \tordre[\ordre].
<div class="wimscenter">
\embed{r1,\size}
\for{t=2 to 4}{
 \tsymb \embed{\r[\t],\size}
}
</div>
}

\answer{Premier}{\rep1;\good}{type=dragfill}
\answer{Deuxième}{\rep2}{type=dragfill}
\answer{Troisième}{\rep3}{type=dragfill}
\answer{Quatrième}{\rep4}{type=dragfill}

\text{rep=\rep1,\rep2,\rep3,\rep4}

\condition{Ordre correct}{\rep issametext \good}
