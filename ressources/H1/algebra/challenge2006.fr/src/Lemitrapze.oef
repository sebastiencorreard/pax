\title{Le mi-trapèze.}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{lettres=shuffle(A,B,C,D,E,F)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}
\text{D=item(4,\lettres)}
\text{P=item(5,\lettres)}


\statement{
<ul>
  <li>Un trapèze \A\B\C\D a deux côtés parallèles [\A\B] et [\C\D].</li>
  <li>Ces côtés mesurent \A\B=40 et \C\D=16 (ce sont des kilomètres...).</li>
  <li>On cherche le point \P appartenant à [\A\B] tel que le segment [\D\P] coupe le trapèze en deux parties 
d'aires égales.</li>
</ul>
Combien mesure \A\P ?}


\answer{\A\P mesure (en kilomètres)}{28}{type=default}
