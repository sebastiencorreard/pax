\title{Pyramide entiers}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{a=wims(values v for v=2 to 9)}
\text{a=shuffle(\a)}

\text{dessin=draw(200,200
range 0,18,0,6
linewidth 2
rect 1,1,17,2,black
rect 3,2,15,3,black
rect 5,3,13,4,black
rect 7,4,11,5,black
parallel 5,1,5,2,4,0,3,black
parallel 7,2,7,3,4,0,2,black
parallel 9,3,9,4,4,0,1,black
text black,2.6,1.7,geant,\a[1]
text black,6.6,1.7,geant,\a[2]
text black,10.6,1.7,geant,\a[3]
text black,14.6,1.7,geant,\a[4])}

\integer{b1=abs(\a[1]-\a[2])}
\integer{b2=abs(\a[2]-\a[3])}
\integer{b3=abs(\a[3]-\a[4])}
\integer{c1=abs(\b1-\b2)}
\integer{c2=abs(\b2-\b3)}
\integer{rep=abs(\c1-\c2)}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    Voici une pyramide ayant un nombre dans chaque case.
    La règle qui permet de compléter la pyramide est la suivante : <br>
    <div class="wimscenter"><i>Le nombre d'une case est la différence des nombres se trouvant dans les deux cases se trouvant juste au dessous.</i></div>
    Quel est le nombre qui se trouve dans la case au sommet de la pyramide ci-contre ?
  </div>
  <div class="cell small-12 medium-6 large-4">
    <img alt="Dessin de la pyramide" src="\dessin">
  </div>
</div>}

\answer{Réponse}{\rep}{type=numexp}
