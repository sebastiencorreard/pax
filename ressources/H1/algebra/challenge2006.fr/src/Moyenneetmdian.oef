\title{Moyenne et médiane}
\auteur{Jean-Pierre,Boudine;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\integer{val1=4}
\real{val2=4.5}

\statement{
<ol>
 <li>
   Donnez un exemple d'une série de cinq valeurs dont la médiane vaut \val1 et la moyenne \val2.
   <br><u><b> Votre réponse : </b></u> \embed{r1}.
 </li>
 <li>
   Donnez un exemple d'une série de cinq valeurs dont la moyenne vaut \val1 et la médiane \val2.
   <br><u><b> Votre réponse : </b></u> \embed{r2}.
 </li>
</ol>
<div class="wims_instruction">Vous devez séparer les valeurs par des virgules. Le séparateur décimal est le point.</div>
}

\answer{Réponse 1}{\liste1}{type=auto}
\answer{Réponse 2}{\liste2}{type=auto}

\integer{nb1=items(\liste1)}
\real{moy1=wims(replace internal , by + in \liste1)}
\real{moy1=\moy1/\nb1}
\real{med1=slib(stat/median [\liste1])}
\condition{Première liste}{(\nb1=5 and \moy1=\val2) and \med1=\val1}

\integer{nb2=items(\liste2)}
\real{moy2=wims(replace internal , by + in \liste2)}
\real{moy2=\moy2/\nb2}
\real{med2=slib(stat/median [\liste2])}
\condition{Première liste}{(\nb2=5 and \moy2=\val1) and \med2=\val2}
