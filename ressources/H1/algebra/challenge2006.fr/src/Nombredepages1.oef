\title{Nombre de pages 1}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}


\integer{page=randint(200..900)}
\integer{nombre=189+3*(\page-100+1)}


\statement{
Pour numéroter les pages d'un livre, un imprimeur a utilisé \nombre caractères.
Combien de pages possède ce livre ?
<div class="wims_instruction">On commence à numéroter les pages à 1.</div>}

\answer{nombre de pages}{\page}{type=numexp}
