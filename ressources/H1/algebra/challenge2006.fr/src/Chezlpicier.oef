\title{Chez l'épicier}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\text{name1=slib(lang/fname girl,fr)}
\text{name2=slib(lang/fname boy,fr)}

\integer{k=randint(2..3)}
\integer{p1=randint(2..3)}
\integer{q1=randint(4..5)}
\integer{n1=randint(6..9)}
\integer{a=randint(2..4)}
\integer{b=randint(2..4)}

\real{pr1=randint(12..19)/10}
\real{pr2=randint(5..11)/10}
\real{pr3=randint(2..4)}

\integer{p2=\p1*\k+\a}
\integer{q2=\q1*\k+\b}
\integer{n2=\n1*\k}
\text{fruit=randitem(poires,pommes,pêches,bananes)}
\text{jus=randitem(lait,jus d'orange,jus d'ananas)}
\text{bonbon=randitem(chocolats,caramels,carambars)}

\real{prix1=\p1*\pr1+\q1*\pr2+\n1*\pr3}
\real{prix2=\p2*\pr1+\q2*\pr2+\n2*\pr3}
\real{rep=\a*\pr1+\b*\pr2}

\statement{
<ul>
 <li>Chez l'épicier, \name1 a acheté \p1 kilogrammes de \fruit, \q1 litres de \jus et \n1 \bonbon et elle a payé \prix1 euros.</li>
 <li>Chez le même épicier, \name2 a acheté \p2 kilogrammes de \fruit, \q2 litres de \jus et \n2 \bonbon et il a payé \prix2 euros.</li>
</ul> 
Combien paierez-vous si vous achètez dans cette épicerie \a kilogrammes de \fruit et \b litres de \jus ?
<br><b><u>Votre réponse :</u></b><br>
Somme à payer : \embed{r1,5} euros.}

\answer{somme à payer}{\rep}{type=numexp}
