\title{Drôle de triangle 3}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{lettres=shuffle(A,B,C,D,E,F)}
\text{A=item(1,\lettres)}
\text{B=item(2,\lettres)}
\text{C=item(3,\lettres)}
\text{G=item(4,\lettres)}
\text{name=slib(lang/fname fr,boy girl,1)}

\statement{\name a dessiné un triangle \A\B\C 
tel que la médiane issue de \B et celle issue de \C se coupent en \G 
suivant un angle droit. \A' est le milieu de [\B\C].
Que peut on dire de ce triangle ?}



\choice{Titre 1}{\A'\G = \B\C/2}{\(\B\C^2=\A\B^2+\A\C^2),\G est au milieu de [\A\B], 
\A\B\C est rectangle en \A}
