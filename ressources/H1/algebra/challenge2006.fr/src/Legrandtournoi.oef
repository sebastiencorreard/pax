\title{Le grand tournoi.}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{p=random(2..5)}
\integer{q=random(5..9)}
\integer{a=\q-1}
\integer{r=0.5*\p*\q*\a}
\statement{Lors d'un tournoi d'échecs, chaque joueur a joué \p parties 
avec chacun des autres, il y a \q joueurs. 
Combien de parties ont été jouées dans ce tournoi ?}


\answer{Le nombre total de parties est :}{\r}{type=default}



