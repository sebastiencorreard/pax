\integer{p=random(15..29)}
\integer{q=3*\p}
\statement{Trois copains ont mangé tous les bonbons d'un paquet en contenant \q. Ils ont tous mangé le même nombre de bonbons.
<br>
Combien chacun en a-t-il eu ?}

\answer{réponse}{\p}{type=numexp}
