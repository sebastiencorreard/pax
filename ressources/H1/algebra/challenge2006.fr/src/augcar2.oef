\title{Augmentation d'un carré}
\language{fr}
\author{Fabrice,Guerimand}
\format{html}


\integer{sg=randitem(1,-1)}
\integer{sg=-1}
\integer{good=randint(1..4)*10}
\if{\sg=1}{
 \text{sens=augmenté}
 \text{sens2=l'augmentation}
 \real{Airepourt=((1+\good/100)^2-1)*100}
}{
 \text{sens=diminué}
 \text{sens2=la diminution}
 \real{Airepourt=(1-(1-\good/100)^2)*100}
}

\real{bad1=rint(sqrt(\Airepourt)*10)/10}
\real{bad2=\Airepourt/2}
\text{bad=\bad1 %,\bad2 %,\Airepourt %}
\text{good=\good %}

\text{list=shuffle(\good,\bad)}
\text{lettres=A,B,C,D,E,F,G,H,I}
\integer{nb=items(\list)}
\text{Good=}
\text{Bad=}
\for{k=1 to \nb}{
 \text{tmp=item(\k,\list)}
 \text{et=R&eacute;ponse \lettres[\k]}
 \if{\tmp isitemof \good}{
  \text{Good=wims(append item \et to \Good)}
 }{
  \text{Bad=wims(append item \et to \Bad)}
 }
}

\statement{
L'aire d'un carré a \sens de \Airepourt %. <br>
Quel a été le pourcentage de \sens2 de la longueur des côtés de ce carré ?
<ul>
\for{l=1 to \nb}{
 <li>\lettres[\l] : \list[\l]</li>
}
</ul>}
\choice{Choisissez}{\Good}{\Bad}
