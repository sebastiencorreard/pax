\title{La basse-cour}
\author{Joseph,Cesaro;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\text{l=shuffle(3,4,5,6,7,8,9)}
\integer{n1=\l[1]\l[1]}
\integer{n2=\l[2]\l[2]}
\integer{n3=randint(1..2)}
\text{coq=item(\n3,coq,coqs)}

\integer{rep=4*\n1+2*\n2+2*\n3}

\statement{
Dans une basse-cour il y a \n1 lapins, \n2 poules et \n3 \coq.<br>

Combien y-a-t-il de pattes en tout ?}

\answer{Réponse}{\rep}{type=numexp}
