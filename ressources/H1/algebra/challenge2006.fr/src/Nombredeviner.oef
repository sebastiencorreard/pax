\title{Nombre à deviner}
\author{Joseph,Cesaro;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\integer{N=randint(11..19)}

\integer{rep=(2*\N+14)/3}


\statement{
Soit le nombre \N.
<ul>
 <li>Je le multiplie par deux,</li>
 <li>j'ajoute 14,</li>
 <li>je divise par 3 le résultat obtenu,</li>
 <li>je l'arrondis à l'unité près.</li>
</ul>
Quel est ce nombre ?}

\answer{Réponse}{\rep}{type=numexp}
