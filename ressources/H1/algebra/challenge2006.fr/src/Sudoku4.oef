\title{Sudoku 4}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\integer{nb=4}

\text{size=30x30x1}
\text{list=wims(values v for v=1 to 4)}
\text{list=shuffle(\list)}
\text{r=wims(values v for v=1 to \nb*(\nb-1))}
\text{r=wims(replace internal , by ,r in \r)}
\text{r=r\r}

\steps{\r}

\statement{
Compléter la grille suivante de telle sorte que chaque chiffre n'apparaisse qu'une seule fois dans chaque ligne, chaque colonne et les deux diagonales.
<table class="wimscenter wimsborder">
 \for{k=1 to \nb}{
  <tr>
   <td>\list[\k]</td>
  \for{l=2 to \nb}{
   <td >\embed{\r[(\k-1)*(\nb-1)+\l-1],\size}</td>
  }
  </tr>
 }
</table>
}
\answer{}{\rep1;\list}{type=clickfill}
\answer{}{\rep2}{type=clickfill}
\answer{}{\rep3}{type=clickfill}
\answer{}{\rep4}{type=clickfill}
\answer{}{\rep5}{type=clickfill}
\answer{}{\rep6}{type=clickfill}
\answer{}{\rep7}{type=clickfill}
\answer{}{\rep8}{type=clickfill}
\answer{}{\rep9}{type=clickfill}
\answer{}{\rep10}{type=clickfill}
\answer{}{\rep11}{type=clickfill}
\answer{}{\rep12}{type=clickfill}
\answer{}{\rep13}{type=clickfill}
\answer{}{\rep14}{type=clickfill}
\answer{}{\rep15}{type=clickfill}
\answer{}{\rep16}{type=clickfill}
\answer{}{\rep17}{type=clickfill}
\answer{}{\rep18}{type=clickfill}
\answer{}{\rep19}{type=clickfill}
\answer{}{\rep20}{type=clickfill}
\answer{}{\rep21}{type=clickfill}
\answer{}{\rep22}{type=clickfill}
\answer{}{\rep23}{type=clickfill}
\answer{}{\rep24}{type=clickfill}
\answer{}{\rep25}{type=clickfill}
\answer{}{\rep26}{type=clickfill}
\answer{}{\rep27}{type=clickfill}
\answer{}{\rep28}{type=clickfill}
\answer{}{\rep29}{type=clickfill}
\answer{}{\rep30}{type=clickfill}

# analyse de réponse
\text{tableau=\list[1],\rep1,\rep2,\rep3
\list[2],\rep4,\rep5,\rep6
\list[3],\rep7,\rep8,\rep9
\list[4],\rep10,\rep11,\rep12
\rep1,\rep4,\rep7,\rep10
\rep2,\rep5,\rep8,\rep11
\rep3,\rep6,\rep9,\rep12
\list[1],\rep4,\rep8,\rep12
\list[4],\rep7,\rep5,\rep3}
\text{cpt=}
\for{k=1 to 9}{
 \text{ligne=row(\k,\tableau)}
 \text{ligne=wims(listuniq \ligne)}
 \text{ligne=items(\ligne)}
 \text{cpt=wims(append item \ligne to \cpt)}
}
\text{cpt=wims(listuniq \cpt)}
\condition{Grille correcte}{\cpt=\nb}
