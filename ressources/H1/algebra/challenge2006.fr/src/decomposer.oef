\title{Décomposer en somme et produit}
\author{Joseph,Cesaro;Fabrice,Guerimand}
\email{fwguerima@free.fr}
\format{html}

\integer{N1=randitem(2,3,5)}
\integer{N2=randitem(11,13,17,19)}
\integer{N=\N1*\N2}

\statement{
Décomposer \N en une somme et un produit de nombres entiers supérieurs ou égaux à 2.
<ul>
 <li>\embed{r1,5} \(\times) \embed{r2,5} \(=\; \N).</li>
 <li>\embed{r3,5} \(+\;)\embed{r4,5} \(=\; \N)</li>
</ul>}

\answer{Premier facteur}{\p1}{type=numexp}
\answer{Deuxième facteur}{\p2}{type=numexp}
\answer{Premier terme}{\s1}{type=numexp}
\answer{Deuxième terme}{\s2}{type=numexp}

\text{tst1=\s1\s2}
\integer{n1=\s1>=2 and \s2>=2 and . notin \tst1?1:0}
\text{tst2=\p1\p2}
\integer{n2=\p1>=2 and \p2>=2 and . notin \tst2?1:0}

\condition{Condition de produit}{\p1*\p2=\N and \n2=1}
\condition{Condition de somme}{\s1+\s2=\N and \n1=1}

\feedback{\n1!=1 or \n2!=1}{Vous n'avez pas tous les points car certains nombres que vous avez donnés ne sont pas des entiers plus grands que 2 !!!}
