\title{Pyramide de briques}
\language{fr}
\range{-5..5}
\author{Fabrice,Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{dessin=draw(200,200
range 0,18,0,6
linewidth 2
rect 1,1,17,2,black
rect 3,2,15,3,black
rect 5,3,13,4,black
rect 7,4,11,5,black
parallel 5,1,5,2,4,0,3,black
parallel 7,2,7,3,4,0,2,black
parallel 9,3,9,4,4,0,1,black)}

\text{name=slib(lang/fname girl,fr)}
\integer{h=randint(60..70)}
\integer{rep=randint(10..50)}
\integer{nombre=\h*(\h+1)/2+\rep}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    \name fabrique des pyramides en utilisant des briques en forme de pavé. 
    Elle les place comme indiqué sur le schéma.
    Elle dispose de \nombre briques et elle fabrique la plus grande pyramide possible.
    Combien de briques lui restera-t-elle ?
  </div>
  <div class="cell small-12 medium-6 large-4">
    <img alt="Dessin de la pyramide" src="\dessin">
  </div>
</div>}

\answer{Réponse}{\rep}{type=numexp}
