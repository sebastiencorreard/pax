   \BB  
   </th>
   </tr><tr>
   <th>
    \AA &nbsp;&nbsp;&nbsp; \embed{reply 3,6}&nbsp;&nbsp;&nbsp; \CC 
 </th>
  </tr><tr>
 
 <th>
