{xrange -\m-0.1,3
yrange -2,2
hline black,0,0
arrow  2.5,0,3,0,10,black
parallel  -\m,-0.8,-\m,0.4,1/2,0, 40, blue
parallel  -\m,-0.3,-\m,0.3,1/10,0, 200, blue
parallel  -\m,-0.8,-\m,0.6,1,0, 40, red
\dessin
}
</th>
 </tr>
