\title{Links of Rechts van een punt ? }
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{A= random(1,-1)*randint(1..7)}
\text{A=\A>0 ? +\A}
\integer{B= randint(abs(\A)+1..11)}
\text{liste=rechts, links}
\text{choix=random(1,2)}
\text{droite=item(\choix,\liste)}
\integer{absc=\choix=1 and \B>\A? \B}
\integer{absc=\choix=1 and \B<\A? -\B}
\integer{absc=\choix=2 and \B>\A? -\B}
\integer{absc=\choix=1 and \B<\A? \B}
\text{absc=\absc>0? +\absc}
\statement{ Het punt <b>\(B) </b> kan coordinaten <b>+\B of -\B</b> op de getallenlijn hebben.<br>
Verder hebben we nog punt <b>\(A)</b> op de getallen lijn met coordinaat \A.<br>
 Als we nu weten dat punt \(B) \droite van punt \(A) ligt.
 Wat is dan de coordinaat van punt \(B) ? 
}
\answer{de coordinaat van \(B):}{\absc}{type=number}
