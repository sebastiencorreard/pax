\integer{A= randint(1..7)}
\text{liste=rechts, links}
\text{choix=random(1,2)}
\text{droite=item(\choix,\liste)}
\text{absc=\choix=1? \A:-\A}

\statement{ Het <b>punt \(A )</b> kan op de getallenlijn de coordinaten <b> +\A of -\A </b> hebben<br>
Als we nu ook nog weten dat het <b>punt \(A )</b> \droite van de Oorsprong (punt met coordinaat 0) ligt,
geef dan de coordinaat van<b> \(A)</b> }
\answer{Het getal A is:}{\absc}{type=number}
