\title{Probleme104}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\e=random(321..499)}
\integer{\b=random(12..16)}
\integer{\nb=ceil(\e/\b)}
\statement{Le collège Jean Cavaillès organise un spectacle.
On fait asseoir les élèves sur des bancs.
<p>Combien de bancs faut-il prévoir sachant que nous avons \e élèves
et que nous pouvons installer \b élèves par banc ?
</p>
}


\answer{Nombre de bancs}{\nb}{type=default}
