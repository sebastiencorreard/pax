\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\pc=random(351..399)}
\integer{\hc=random(3..7)}
\real{\p=\pc/100}
\real{\h=\hc/10}
\real{\n=\p+\h}
\statement{La revue "Math et Avenir" qui coûtait \p euros a subi une hausse de \h euros.
<p>Quel est son nouveau prix ?</p>
}


\answer{Prix en euros}{\n}{type=default}
