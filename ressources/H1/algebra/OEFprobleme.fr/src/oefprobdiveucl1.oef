\language{fr}
\range{-5..5}
\title{Problèmes Division Euclidienne 1}
\precision{10000}

\matrix{t=Je veux partager,pièces d'or entre,personnes.,Combien de pièces d'or manque-t-il pour faire un partage équitable ?,11,49,3,9,pièce(s)
Je veux partager,bonbons entre,camarades.,Combien de bonbons manque-t-il pour faire un partage équitable ?,11,49,3,9,bonbon(s)
Je veux partager,chewing-gum entre,camarades.,Combien de chewing-gum manque-t-il pour faire un partage équitable ?,11,49,3,9,chewing-gum
Un fabricant veut expédier,DVD à un client. Les disques sont emballés dans des boîtes. Chaque boîte contient,DVD.,Combien de DVD manque-t-il dans la dernière boîte ?,21,59,11,19,DVD
Un éditeur veut expédier,livres à un client. Les livres sont placés dans des cartons. Chaque carton contient,livres.,Combien de livres manque-t-il dans le dernier carton ?,21,59,11,19,livre(s)
Un artisan veut expédier,objets en bois à un client. Les objets sont placés dans des cartons. Chaque carton contient,objets soigneusement emballés.,Combien d'objets manque-t-il dans le dernier carton ?,21,59,11,19,objet(s)
}

\integer{a=randint(1..6)}
\text{t=row(\a,\t)}

\integer{v1=randint(\t[5]..\t[6])}
\integer{v2=randint(\t[7]..\t[8])}
\integer{r=randint(1..\v2-1)}
\integer{q=\v1*\v2+\r}
\integer{rep=\v2-\r}

\statement{\t[1] \q \t[2] \v2 \t[3]
<p>\t[4]</p>
<ul class="wims_nopuce"><li>Il manque \embed{r1,4} \t[9],</li>
<li>car \q = ( \v2 \(\times) \embed{r2,4} ) + \embed{r3,4}
</li><li>et \v2 - \embed{r4,4} = \embed{r5,4}
</li></ul>}

\answer{}{\rep}{type=raw}
\answer{}{\v1}{type=raw}
\answer{}{\r}{type=raw}
\answer{}{\r}{type=raw}
\answer{}{\rep}{type=raw}
