\title{Problème 3 Franc Pacifique}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\tc=random(310..490)}
\integer{\mc=random(150..290)}
\integer{\vc=random(110..250)}
\integer{\ttc=\tc+\mc}
\integer{\ftc=\tc-\tc}
\integer{\r=\ttc-\vc}

\text{enonc=Je,calcule,la quantité,d'argent,de Vaihere :}
\text{calcul1=+,\mc}
\text{calcul2=\ttc,-,\vc}

\statement{Toanui a \tc francs. Sa maman lui donne \mc francs.
 En tout il a maintenant \vc francs de plus que sa soeur Vaihere.
<p>Quelle quantité d'argent possède Vaihere ?</p>

<ul class="wims_nopuce"><li>
phrase 1: Je calcule la quantité d'argent de Toanui
<div class="wimscenter">calcul en ligne : \tc \embed{r1,100x30}
= \embed{r2,5} francs </div>
</li><li>
phrase 2: \embed{r3,100x30}
<div class="wimscenter"> calcul en ligne : \pc \embed{r4,100x30}= \embed{r5,5} francs
</div>
</li></ul>
}
\answer{}{\calcul1;\calcul1,\(times),\(div)}{type=clickfill}{option=shuffle}
\answer{ en francs}{\ttc}{type=default}
\answer{}{\enonc;\enonc,de Toanui :}{type=clickfill}{option=shuffle}
\answer{}{\calcul2;\calcul2,\(times),\(div)}{type=clickfill}{option=shuffle}
\answer{ en francs}{\r}{type=default}
