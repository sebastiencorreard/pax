\title{Probleme302}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\nb=random(30..50)}
\integer{\b=\nb*15}
\integer{\nc=random(12..18)}
\integer{\uc=random(50..60)}
\integer{\u=\uc*10}
\real{\c=(\nc*5)*100}
\real{\cc=\c/1000}
\real{\ca=\b*\u+\c}
\real{\ck=\ca/1000}
\integer{\f=random(75..99)}
\integer{\l=floor((\u-140-\f)/20)}
\integer{\ff=\u-140-20*\l}
\statement{
<ul><li>Une palette de \b boîtes de conserve pèse \ck kg. La palette vide pèse \cc kg.
</li><li>Combien pèse chaque boîte de conserve ?
</li><li> Chaque boîte contient 20 litchis d'environ \l g chacun et 140 g de jus,
</li><li>Combien pèse la boîte de conserve vide ?
</li></ul>}

\answer{Convertir \ck kg en grammes :}{\ca}{type=default}
\answer{Masse d'une boîte pleine en g ? :}{\u}{type=default}
\answer{Masse d'une boîte vide en g ? :}{\ff}{type=default}
