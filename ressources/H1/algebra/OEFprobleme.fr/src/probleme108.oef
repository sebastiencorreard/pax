\title{Probleme108}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\nh=random(12..16)}
\integer{\a=random(6..14)}
\integer{\lh=\a*10}
\integer{\lc=random(22..30)}
\integer{\l=\lc*100}
\real{\r=\l-\lh*(\nh-1)-60}
\statement{
<ul class="wims_nopuce"><li>
Un parcours d'obstacles comporte \nh haies espacées régulièrement de \lh m.
</li><li>
On sait que la première haie est à 60 m du départ et que le parcours est de \l m.
</li></ul>
<p>A quelle distance de l'arrivée se situe la dernière haie ?</p>
}


\answer{distance en m ? :}{\r}{type=default}
