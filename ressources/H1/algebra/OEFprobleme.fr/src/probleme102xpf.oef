\title{Problème 102 Franc Pacifique}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{j=randint(1..28)}
\text{m=janvier,février,mars,avril, mai,juin,juillet,aout,septembre,octobre,novembre,décembre}
\integer{i=randint(1..12)}
\integer{a=randint(2005..2007)}
\integer{c=randint(2..6)}
\integer{pc=randint(11..99)}
\integer{pc=\c*100+\pc}
\integer{hc=randint(20..99)}
\integer{\nc=\pc+\hc}

\text{enonc=Je,calcule,le nouveau,prix,du magazine :}
\text{calcul=+,\hc}

\statement{Le \j \m[\i] \a , le magazine "Math et Avenir" qui coûtait \pc francs a subi
une augmentation de \hc francs.
<p>Quel est son nouveau prix ?</p>

<ul class="wims_nopuce"><li>phrase :\embed{r1,100x40}</li>
<li>calcul en ligne : \pc \embed{r2,100x40}
= \embed{r3,5} francs
</li></ul>
}

\answer{}{\enonc;\enonc,l'ancien}{type=dragfill}{option=shuffle}
\answer{}{\calcul;\calcul,\(-),\(times),\(div),\j,\a}{type=dragfill}{option=shuffle}
\answer{Prix en francs}{\nc}{type=default}
