\title{Probleme101}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\m=random(51..99)}
\integer{\u=random(61..99)}
\real{\p=(\m*\u)/100}
\statement{Un commerçant achète une grosse quantité de pommes.
Il paye à l'agriculteur \p euros les \m kg.
<p>Quel est le prix en centimes d'euros du kilogramme de pommes ?</p>
}


\answer{Prix en centimes d'euros}{\u}{type=default}
