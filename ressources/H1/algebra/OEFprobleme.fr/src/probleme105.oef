\title{Probleme105}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\jc=random(310..490)}
\integer{\mc=random(150..290)}
\integer{\ic=random(110..250)}
\real{\j=\jc*10/100}
\real{\m=\mc/10}
\real{\i=\ic/10}
\real{\r=\j+\m-\i}
\statement{Jean a \j euros dans sa tirelire. Sa mère lui donne \m euros.
 En tout il a maintenant \i euros de plus que sa soeur Isabelle.
<p>Quelle somme d'argent possède Isabelle ?</p>
}


\answer{Somme en euros :}{\r}{type=default}
