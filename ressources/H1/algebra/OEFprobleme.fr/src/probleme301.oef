\title{Probleme301}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\r=random(200..300)}
\integer{\b=random(11..15)}
\integer{\p=random(9..14)}
\integer{\nb=floor(\r/\b)}
\integer{\rt=\r-\nb*\b}
\real{\v=\nb*\p+1.5*\rt}
\statement{Un fleuriste vient de recevoir un lot de \r roses rouges,
afin de composer des bouquets de \b roses qu'il vend \p &euro;.
Il vendra ensuite les roses restantes à 1,5 &euro; l'unité.
<ul><li> Combien fait-il de bouquets ?
</li><li> Combien lui reste-t-il de roses ?
</li><li>Combien la vente de toutes ces fleurs lui rapportera-t-elle ?
</li></ul>
}


\answer{nombre de bouquets ? :}{\nb}{type=default}
\answer{nombre de roses ? :}{\rt}{type=default}
\answer{vente en euros ? :}{\v}{type=default}
