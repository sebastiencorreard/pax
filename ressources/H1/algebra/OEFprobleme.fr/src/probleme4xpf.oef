\title{Problème 4}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{\lo=random(4..9)}
\integer{\la=random(3..6)}
\integer{\h=random(2..5)}
\integer{\uc=random(30..60)*10}
\integer{\nb=\la*\lo*\h}
\integer{\pd=\nb*\uc}
\real{\f=randint(75..99)/10}
\real{\ca=\f+\pd/1000}
\statement{Une caisse contient \nb boîtes de conserve.
Une boîte pèse \uc g. La caisse vide pèse \f kg.
<ul class="wims_nopuce"><li>
Combien pèsent toutes les boîtes de conserve ?
</li><li>Combien pèse la caisse pleine ?
</li></ul>
<div class="wims_instruction">Tu utiliseras <span class="tt">*</span>
pour la multiplication,
et le point <span class="tt">.</span> comme séparateur décimal.</div>
<ul class="wims_nopuce"><li>
Je calcule le poids des boîtes de conserve :
<div class="wimscenter">\embed{r1} = \embed{r2,5} g</div>
</li><li>Je calcule le poids de la caisse pleine :
<div class="wimscenter">\embed{r3} =\embed{r4,5} kg</div>
</li></ul>

}
\answer{}{\pd}{type=function}
\answer{}{\pd}{type=default}
\answer{}{\ca}{type=function}
\answer{}{\ca}{type=default}
