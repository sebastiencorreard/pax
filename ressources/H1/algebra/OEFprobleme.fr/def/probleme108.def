!set title=Probleme108
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 12, 16

val6=$[rint($(tmp0))]
tmp0=!randint 6, 14

val7=$[rint($(tmp0))]
val8=$[rint($val7*10)]
tmp0=!randint 22, 30

val9=$[rint($(tmp0))]
val10=$[rint($val9*100)]
val11=$[$val10-$val8*($val6-1)-60]
replytype1=default
replyname1=distance en m ? :
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ul class="wims_nopuce"><li>	Un parcours d'obstacles comporte $val6 haies espacées régulièrement de $val8 m.	</li><li>	On sait que la première haie est à 60 m du départ et que le parcours est de $val10 m.	</li></ul>	<p>A quelle distance de l'arrivée se situe la dernière haie ?</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

