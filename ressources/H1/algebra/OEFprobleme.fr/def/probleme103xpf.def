!set title=Problème 103 Franc Pacifique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 28

val6=$[rint($(tmp0))]
val7=janvier,février,mars,avril, mai,juin,juillet,aout,septembre,octobre,novembre,décembre
tmp0=!randint 1, 12

val8=$[rint($(tmp0))]
tmp0=!randint 2005, 2007

val9=$[rint($(tmp0))]
tmp0=!randint 2, 6

val10=$[rint($(tmp0))]
tmp0=!randint 11, 99

val11=$[rint($(tmp0))]
val11=$[rint($val10*100+$val11)]
tmp0=!randint 20, 99

val12=$[rint($(tmp0))]
val13=$[rint($val11+$val12)]
val14=Je,calcule,l'ancien,prix,du magazine :
val15=\(-),$val12
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val14;$val14,le nouveau
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val15;$val15,+,\(times),\(div),$val6,$val9
replytype3=default
replyname3=Prix en francs
replygood3=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le magazine "Math et Avenir" coûte aujourd'hui $val13 francs. Le $val6 $(val7[$val8]) $val9 elle a subi une augmentation de $val12 francs.	<p>Quel est son ancien prix ?</p>		<ul class="wims_nopuce"><li>phrase :  
!read oef/embed.phtml r1,100x40 
$()	</li><li>calcul en ligne : $val13  
!read oef/embed.phtml r2,100x40 
$()	=  
!read oef/embed.phtml r3,5 
$() francs	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

