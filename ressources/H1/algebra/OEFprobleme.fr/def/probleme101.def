val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 51, 99

val6=$[rint($(tmp0))]
tmp0=!randint 61, 99

val7=$[rint($(tmp0))]
val8=$[($val6*$val7)/100]
replytype1=default
replyname1=Prix en centimes d'euros
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Un commerçant achète une grosse quantité de pommes.	Il paye à l'agriculteur $val8 euros les $val6 kg.	<p>Quel est le prix en centimes d'euros du kilogramme de pommes ?</p>	
$()
!exit

