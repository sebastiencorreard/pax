!set title=Probleme301
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 200, 300

val6=$[rint($(tmp0))]
tmp0=!randint 11, 15

val7=$[rint($(tmp0))]
tmp0=!randint 9, 14

val8=$[rint($(tmp0))]
val9=$[rint(floor($val6/$val7))]
val10=$[rint($val6-$val9*$val7)]
val11=$[$val9*$val8+1.5*$val10]
replytype1=default
replyname1=nombre de bouquets ? :
replygood1=$val9
replytype2=default
replyname2=nombre de roses ? :
replygood2=$val10
replytype3=default
replyname3=vente en euros ? :
replygood3=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Un fleuriste vient de recevoir un lot de $val6 roses rouges,	afin de composer des bouquets de $val7 roses qu'il vend $val8 &euro;.	Il vendra ensuite les roses restantes à 1,5 &euro; l'unité.	<ul><li> Combien fait-il de bouquets ?	</li><li> Combien lui reste-t-il de roses ?	</li><li>Combien la vente de toutes ces fleurs lui rapportera-t-elle ?	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=0
