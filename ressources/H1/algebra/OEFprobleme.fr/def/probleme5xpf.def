!set title=Probleme 5 Franc Pacifique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100000

ansorder=r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 100, 200

val6=$[rint($(tmp0))]
tmp0=!randint 6, 12

val7=$[rint($(tmp0))]
tmp0=!randint 5, 10

val8=$[rint($(tmp0)*10*$val7)]
val9=$[rint(floor($val6/$val7))]
val10=$[rint($val6-$val9*$val7)]
val11=$[$val9*$val8+40*$val10]
replytype1=default
replyname1=
replygood1=$val9
replytype2=default
replyname2=
replygood2=$val10
replytype3=default
replyname3=
replygood3=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<ul class="wims_nopuce"><li>	Un fleuriste vient de recevoir un lot de $val6 oiseaux du paradis.	</li><li>Il utilise $val7 oiseaux du paradis pour faire un bouquet qu'il vend $val8 F.	</li><li>Il vendra ensuite les oiseaux du paradis restants à 40 F l'unité.	</li><li> Combien fait-il de bouquets ?	</li><li> Combien lui reste-t-il d'oiseaux du paradis ?	</li><li>Combien la vente de toutes ces fleurs lui rapportera-t-elle ?	</li></ul>	<div class="wims_instruction">Tu ne donneras que le résultat. </div>	<ul class="wims_nopuce"><li>	Je calcule le nombre de bouquets :  
!read oef/embed.phtml r1,7 
$()	</li><li>	Je calcule le nombre d'oiseaux du paradis restants : 
!read oef/embed.phtml r2,7 
$()	</li><li>	Je calcule la recette :  
!read oef/embed.phtml r3,7 
$() F	</li></ul>	
$()
!exit

