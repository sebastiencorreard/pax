!set title=Problème 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 9

val6=$[rint($(tmp0))]
tmp0=!randint 3, 6

val7=$[rint($(tmp0))]
tmp0=!randint 2, 5

val8=$[rint($(tmp0))]
tmp0=!randint 30, 60

val9=$[rint($(tmp0)*10)]
val10=$[rint($val7*$val6*$val8)]
val11=$[rint($val10*$val9)]
tmp0=!randint 75, 99

val12=$[$(tmp0)/10]
val13=$[$val12+$val11/1000]
replytype1=function
replyname1=
replygood1=!rawmath $val11
replytype2=default
replyname2=
replygood2=$val11
replytype3=function
replyname3=
replygood3=!rawmath $val13
replytype4=default
replyname4=
replygood4=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Une caisse contient $val10 boîtes de conserve.	Une boîte pèse $val9 g. La caisse vide pèse $val12 kg.	<ul class="wims_nopuce"><li>	Combien pèsent toutes les boîtes de conserve ?	</li><li>Combien pèse la caisse pleine ?	</li></ul>	<div class="wims_instruction">Tu utiliseras <span class="tt">*</span>	pour la multiplication,	et le point <span class="tt">.</span> comme séparateur décimal.</div>	<ul class="wims_nopuce"><li>	Je calcule le poids des boîtes de conserve :	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$() =  
!read oef/embed.phtml r2,5 
$() g</div>	</li><li>Je calcule le poids de la caisse pleine :	<div class="wimscenter"> 
!read oef/embed.phtml r3 
$() = 
!read oef/embed.phtml r4,5 
$() kg</div>	</li></ul>		
$()
!exit

