!set title=Problèmes Division Euclidienne 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000

ansorder=r,r,r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Je veux partager,pièces d'or entre,personnes.,Combien de pièces d'or manque-t-il pour faire un partage équitable ?,11,49,3,9,pièce(s)	Je veux partager,bonbons entre,camarades.,Combien de bonbons manque-t-il pour faire un partage équitable ?,11,49,3,9,bonbon(s)	Je veux partager,chewing-gum entre,camarades.,Combien de chewing-gum manque-t-il pour faire un partage équitable ?,11,49,3,9,chewing-gum	Un fabricant veut expédier,DVD à un client. Les disques sont emballés dans des boîtes. Chaque boîte contient,DVD.,Combien de DVD manque-t-il dans la dernière boîte ?,21,59,11,19,DVD	Un éditeur veut expédier,livres à un client. Les livres sont placés dans des cartons. Chaque carton contient,livres.,Combien de livres manque-t-il dans le dernier carton ?,21,59,11,19,livre(s)	Un artisan veut expédier,objets en bois à un client. Les objets sont placés dans des cartons. Chaque carton contient,objets soigneusement emballés.,Combien d'objets manque-t-il dans le dernier carton ?,21,59,11,19,objet(s)	
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 6

val7=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!randint $(val6[5]), $(val6[6])

val8=$[rint($(tmp0))]
tmp0=!randint $(val6[7]), $(val6[8])

val9=$[rint($(tmp0))]
tmp0=!randint 1, $val9-1

val10=$[rint($(tmp0))]
val11=$[rint($val8*$val9+$val10)]
val12=$[rint($val9-$val10)]
replytype1=raw
replyname1=
replygood1=$val12
replytype2=raw
replyname2=
replygood2=$val8
replytype3=raw
replyname3=
replygood3=$val10
replytype4=raw
replyname4=
replygood4=$val10
replytype5=raw
replyname5=
replygood5=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val11 $(val6[2]) $val9 $(val6[3])	<p>$(val6[4])</p>	<ul class="wims_nopuce"><li>Il manque  
!read oef/embed.phtml r1,4 
$() $(val6[9]),</li>	<li>car $val11 = ( $val9 
!insmath \times
$()  
!read oef/embed.phtml r2,4 
$() ) +  
!read oef/embed.phtml r3,4 
$()	</li><li>et $val9 -  
!read oef/embed.phtml r4,4 
$() =  
!read oef/embed.phtml r5,4 
$()	</li></ul>
$()
!exit

