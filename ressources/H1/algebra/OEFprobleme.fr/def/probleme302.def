format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 30, 50

val6=$[rint($(tmp0))]
val7=$[rint($val6*15)]
tmp0=!randint 12, 18

val8=$[rint($(tmp0))]
tmp0=!randint 50, 60

val9=$[rint($(tmp0))]
val10=$[rint($val9*10)]
val11=$[($val8*5)*100]
val12=$[$val11/1000]
val13=$[$val7*$val10+$val11]
val14=$[$val13/1000]
tmp0=!randint 75, 99

val15=$[rint($(tmp0))]
val16=$[rint(floor(($val10-140-$val15)/20))]
val17=$[rint($val10-140-20*$val16)]
