 !exit
!endif

tmp0=!randint 5, 15

val6=$[rint($(tmp0)*10)]
tmp0=!randint 40, 70

val7=$[rint($(tmp0)*10)]
val8=$[$val7*$val6/1000]
replytype1=default
replyname1=Área
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La densidad de población de un país es de	$val6 habitantes/km<sup>2</sup>.	Su población es $val8 millions.	¿Cuál es su área (en miles de km<sup>2</sup>)?
$()
!exit

