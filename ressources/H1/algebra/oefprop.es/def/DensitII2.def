 !exit
!endif

tmp0=!randint 5, 15

val6=$[rint($(tmp0)*10)]
tmp0=!randint 40, 70

val7=$[rint($(tmp0)*10)]
val8=$[$val7*$val6/1000]
replytype1=default
replyname1=población
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La superficie de un país es de $val7 mil km<sup>2</sup> y su	densidad es de $val6 habitantes/km<sup>2</sup>. ¿Cuál es su 	población (en millones)?
$()
