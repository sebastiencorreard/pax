\title{Alfombra}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\f=random(20,25,30,35,40,45,50,55,60)*100}
\integer{\s=random(10..40)}
\integer{t=random(1,2)}
\text{t1=item(\t,sube,baja)}
\text{t2=item(\t,baja,sube)}
\statement{Una alfombra costaba \f francos en noviembre, \t1 el \s % 
en diciembre, después \t2 el \s % en enero. ¿Cuál es su nuevo precio?}



\choice{El nuevo precio es}{\f francos menos}{\f francos más, el mismo precio}


