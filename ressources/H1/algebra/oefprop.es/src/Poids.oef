\title{Pesos}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\c=random(8,10)}
\integer{\s=random(4,5)}
\integer{\p=random(8..12)}
\real{\v=\p/\c}
\integer{\t=\p*\s}
\statement{Un camión es \c veces más pesado que un coche, mientras que el camión es
\s veces más ligero que un tanque. Sabiendo que el camión pesa \p toneladas,
calcular los pesos (in toneladas) del coche y del tanque.}


\answer{Peso del coche}{\v}{type=default}
\answer{Peso del tanque}{\t}{type=default}



