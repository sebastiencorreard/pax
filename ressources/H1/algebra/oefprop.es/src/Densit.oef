\title{Densidad}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{La densidad de población de un país es de
\d habitantes/km<sup>2</sup>.
Su población es \p millions.
¿Cuál es su área (en miles de km<sup>2</sup>)?}


\answer{Área}{\s}{type=default}
