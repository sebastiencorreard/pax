\title{Gasolina}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\l=random(8,10,12,14,16)}
\integer{\k=random(4*\l..7*\l)}
\real{\a=(\k/\l)*100}
\statement{Un vehículo consume \l litros de gasolina a los 100 km. Su
depósito puede contener \k litros de gasolina, ¿cuál es su 
autonomía?}


\answer{Autonomía (en km)}{\a}{type=default}



