\title{Rebajas}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\r=random(20,25,40,50)}
\integer{\e=random(100..160)}
\real{\p=(100/\r)*\e}
\statement{Con un \r% de descuento, me ahorro \e francos en un par de 
botines. ¿Qué precio tenían antes de las rebajas?}


\answer{Precio (en francos)}{\p}{type=default}



