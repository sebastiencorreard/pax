\title{Densidad III}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{La superficie de un país es de \s mil km<sup>2</sup> y su
densidad es de \d habitantes/km<sup>2</sup>. ¿Cuál es su 
población (en millones)?}


\answer{población}{\p}{type=default}
