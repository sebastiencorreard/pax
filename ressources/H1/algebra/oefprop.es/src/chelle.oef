\title{Escala}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\e=random(15,20,25,50,100,200,250,500)*1000}
\integer{\a=random(3..15)}
\real{\d=(\a*\e)/100000}

\statement{Un mapa de carreteras está en la escala 1/\e. ¿Qué distancia real (en \(km)) representa \a \(cm) 
<br>en el mapa?}


\answer{Distancia real}{\d}{type=default}
