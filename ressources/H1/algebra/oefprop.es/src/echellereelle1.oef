\title{escalareal1}
\language{es}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@tele2.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{lc=randint(60..250)}
\integer{e=randint(12..90)}
\integer{ee=\e*10}
\real{l=\lc/10}
\integer{lr=\lc*\e}
\real{lm=\lr/100}
\integer{s=1}
\statement{Tenemos un plano a escala 1/\ee.
<br> Hemos medido sobre este plano una distancia de \l cm. 
<br>complete la tabla:
<table align="center" border=1>
<tr align="center"><td>Distancias sobre el plano en cm <td>\embed{reply 1}</td><td>\l</td></tr>
<tr align="center"><td>Distancias reales en cm<td>\embed{reply 2}</td>
<td>
\embed{reply 3}</td>
</tr>
</table>
<p> La distancia real correspondiente es de \embed{reply 4} m.
}
\answer{}{\s}{type=numeric}
\answer{}{\ee}{type=numeric}
\answer{}{\lr}{type=numeric}
\answer{}{\lm}{type=numeric}
