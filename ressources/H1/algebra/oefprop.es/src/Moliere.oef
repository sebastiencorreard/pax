\title{Molière}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\a=random(15..30)}
\integer{\r=random(2..10)}
\real{\f=randint(50..100)/2}
\real{\p=(\f*\a)-(\r*\a)}
\statement{El profesor de francés ha comprado \a ejemplares de El Avaro.
El librero le ha hecho un descuento de \r francos por libro. Ha
pagado \p francos. ¿Qué vale un libro sin el descuento?}


\answer{Precio (en francos)}{\f}{type=default}



