\precision{10000}

\integer{\c=random(2..10)}
\integer{\u=random(10..50)}
\integer{\l=random(80..200)}
\integer{\t=(\c*\u)+\l}
\statement{He comprado un lector de CD y \c CD roms. 
 He pagado \t dólares. ¿Cuál es el precio del lector de CD si
 los CD roms valen \u dólares cada uno?
}


\answer{Precio (en dólares)}{\l}{type=default}



