\title{velocidad1}
\language{es}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@tele2.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{du=randint(70..180)}
\integer{vi=randint(85..165)}
\real{vk=\vi*6/10}
\integer{h=floor(\du/60)}
\integer{m=\du-60*\h}
\real{di=\du*\vi/100}
\integer{s=60}
\statement{Un vehículo ha recorrido una distancia de \di km en \h h \m min.
<br> Complete la tabla:
<table align="center" border=1>
<tr align="center"><td>Duración en min<td>\embed{reply 1}</td><td>\embed{reply 2}</td></tr>
<tr align="center"><td>Distancia en km <td>\di</td>
<td>
\embed{reply 3}</td>
</tr>
</table>
<p> La velocidad media es de \embed{reply 4}   km / h.
}
\answer{}{\du}{type=numeric}
\answer{}{\s}{type=numeric}
\answer{}{\vk}{type=numeric}
\answer{}{\vk}{type=numeric}
