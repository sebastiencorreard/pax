\title{Densidad II}
\language{es}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{La superficie de un país es de \s km<sup>2</sup> y su
población es de \p millones. ¿Cuál es su densidad?}


\answer{densidad}{\d}{type=default}
