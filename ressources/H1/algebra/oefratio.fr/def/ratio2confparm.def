:question
$()<div class="wims_question">$val6 et $val7 se partagent 
!insmath $val12
$() $(val21[$val26]) selon le ratio 
!insmath $val28
$().	<p>Déterminer le nombre $val27$(val21[$val26]) que recevra chaque personne.</div>	
!if $val29=1 
$()	On commence par déterminer le nombre total de parts.	<br>On peut illustrer la situation par le dessin suivant :	<br>Part de $val6 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val7 <span class="unepart part_2 ecrit_2">AAA</span>	$val34	<br><label for="reply1">Avec le ratio 
!insmath $val28
$(), $val6 reçoit  
!read oef/embed.phtml r1,3 
$() $val23</label><label for="reply2"> pendant que $val7 reçoit  
!read oef/embed.phtml r2,3 
$()$val25</label>.	<br><label for="reply3">Le partage est donc composé de</label> 
!read oef/embed.phtml r3,3 
$() parts égales.	<br>Comme il y a $val12 $(val21[$val26]),<label for="reply4"> chaque part est composée de</label>  
!read oef/embed.phtml r4,3 
$() $(val21[$val26]).	<br><label for="reply5">$val6 reçoit</label>  
!read oef/embed.phtml reply5,3 
$() $(val21[$val26]).	<br><label for="reply6">$val7 reçoit</label>  
!read oef/embed.phtml reply6,3 
$() $(val21[$val26]). 
!endif
$()	
!if $val29=2 
$()	<p>Avec le ratio 
!insmath  $val13 : $val14 
$(), on peut faire le dessin suivant :</p>	<br>Part de $val6 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val7 <span class="unepart part_2 ecrit_2">AAA</span>	$val34	<label for="reply7">le partage est composé de</label> 
!read oef/embed.phtml r7,3 
$() parts égales.<br>	<span class="unbreakable">$val6 reçoit alors	 
!read oef/special.phtml mathmlinput [\frac{reply8}{reply9}], 3	reply8	reply9 
$()	des  
!read oef/embed.phtml r10,3 
$() $(val21[$val26]).</span><br>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply11}{reply12} \times {reply13}={reply14}], 3	reply11	reply12	reply13	reply14 
$().</span><br>	<span class="unbreakable">De même, $val7 reçoit  
!read oef/special.phtml mathmlinput [\frac{reply15}{reply16}], 3	reply15	reply16 
$()	des  
!read oef/embed.phtml r17,3 
$() $(val21[$val26]).</span><br>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply18}{reply19} \times {reply20}={reply21}], 3	reply18	reply19	reply20	reply21 
$()	.</span><br>	Ainsi,<label for="reply22"> $val6 reçoit</label> 
!read oef/embed.phtml r22,3 
$() $(val21[$val26]) et<label for="reply23"> $val7 reçoit</label> 
!read oef/embed.phtml r23,3 
$() $(val21[$val26]). 
!endif
$()	
!if $val29=3 
$()Comme le ratio est une situation de proportionnalité, on complète ce tableau de proportionnalité en commençant par le remplir grâce aux données de l'énoncé.	<div class="unbreakable">	<table class="wimscenter wimsborder">	<tr>	<td colspan="1"><label for="reply24">$val6</label></td>	<td colspan="1"><label for="reply25">$val7</label></td>	<td colspan="1"><label for="reply26">Total</label></td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r24,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r25,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r26,3 
$()</td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r27,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r28,3 
$()</td>	<td colspan="1">$val12</td>	</tr>	</table>	</div>	puis on conclut :	<br class="spacer">	<label for="reply29">$val6 recevra</label>  
!read oef/embed.phtml r29,3 
$() $(val21[$val26])	<br class="spacer">	et <label for="reply30">$val7 recevra</label>  
!read oef/embed.phtml r30,3 
$() $(val21[$val26]). 
!endif
$()	
!if $val29=4 or $val29=5 or $val29=6 
$()	<br><label for="reply31">$val6 reçoit</label>  
!read oef/embed.phtml reply31,3 
$() $(val21[$val26]).	<br><label for="reply32">$val7 reçoit</label>  
!read oef/embed.phtml reply32,3 
$() $(val21[$val26]). 
!endif
