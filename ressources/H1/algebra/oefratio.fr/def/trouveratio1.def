!set title=Trouver un ratio à partir d'un dessin
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel,Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=ratio, proportion,proportionality
language=fr
computeanswer=no
precision=100000000
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .macss{background-color: #FAFAD2;} .damier {width:3px;height:3px;} .col1 {background-color:#FFFF00} .col2 {background-color:#FF0000} .wims_matrix td{padding:0} .unepart{width:100%;height:1em} .part_1{background-color:red} .part_2{background-color:blue} .part_3{background-color:maroon} .ecrit_1{color:red} .ecrit_2{color:blue} .ecrit_3{color:maroon} </style>

ansorder=r,r
varcnt=39
prevarcnt=37
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=2
feedbackcnt=2
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
!while $val6=$val7 
tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
!endwhile
val8=$[rint(gcd($val6,$val7))]
val9=$[rint($val6/$val8)]
val10=$[rint($val7/$val8)]
val11=pomme.jpg,	banane.jpg
val12=<img src="$val1/$(val11[1])" alt="dessin d'une pomme" />
val13=<img src="$val1/$(val11[2])" alt="dessin d'une banane" />
val14=$val12,$val13
!if $val6>1 
!for val15  = 1 to $val6-1 
val14=$val14,$val13
!next
!endif
!if $val7>1 
!for val16  = 1 to $val7-1 
val14=$val14,$val12
!next
!endif
val17=$[rint($val6+$val7)]
tmp0=!shuffle $val14

val14=$(tmp0)
val18=1,2
!if $val6=1 
val19=les pommes,la banane
val20=Les pommes,La banane
val21=pommes,banane
!endif
!if $val7=1 
val19=la pomme,les bananes
val20=La pomme,Les bananes
val21=pomme,bananes
!endif
!if $val6<>1 and $val7<>1 
val19=les pommes,les bananes
val20=Les pommes,Les bananes
val21=pommes,bananes
!endif
tmp0=!shuffle $val18

val22=$(tmp0)
!if $(val22[1])=1 
val23=$[rint($val9)]
val24=$[rint($val10)]
val25=$[rint($val6)]
val26=$[rint($val7)]
!else
val23=$[rint($val10)]
val24=$[rint($val9)]
val25=$[rint($val7)]
val26=$[rint($val6)]
!endif
t_=!rawmath $val23/$val24
val27=!exec pari print($t_)
replytype1=numexp
replyname1=
replygood1=$val23
replytype2=numexp
replyname2=
replygood2=$val24
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dans quel ratio sont <b>$(val19[$(val22[2])])</b> et <b>$(val19[$(val22[1])])</b>&nbsp;?	 
!for m_k=1 to $val17 
$()$(val14[$m_k]) 
!next
$()	<div class="spacer"><b>$(val20[$(val22[2])])</b> et <b>$(val19[$(val22[1])])</b>	sont dans le ratio <span class="nowrap"> 
!read oef/embed.phtml reply1,3 
$(): 
!read oef/embed.phtml reply2,3 
$().</span></div>	<div class="wims_instruction">On donnera le ratio sous forme simplifiée lorsque cela est possible.</div>	
$()
!exit

:hint
$()Simplifier un ratio (quand c'est possible), c'est diviser chaque nombre du ratio par un diviseur commun aux nombres du ratio.	<p>Par exemple, pour simplifier le ratio 
!insmath 16:18
$(), on cherche un diviseur commun à 
!insmath 16
$() et 
!insmath 18
$().</p>	<p>
!insmath 16
$() et 
!insmath 18
$() sont divisibles par 
!insmath 2
$() et on a <span class="nowrap">
!insmath  16 = 2 \times 8 
$() et 
!insmath  18 = 2 \times 9
$().</span></p>	<p>Donc le ratio 
!insmath 16:18
$() se simplifie en <span class="nowrap">
!insmath 8:9
$().</span></p>
$()
!exit

:help
$()
$()
!exit

:solution
$()Il y a $val25 $(val21[$(val22[2])]) et $val26 $(val21[$(val22[1])]).	<br>$(val20[$(val22[2])]) et $(val19[$(val22[1])]) sont dans le ratio 
!insmath $val25 : $val26
$().	
!if $val8=1 
$()<p>Ce ratio ne peut pas être simplifié.</p> 
!else
$()	 <p>Comme $val25 et $val26 sont divisibles par $val8, le ratio se simplifie en <span class="nowrap">
!insmath $val23 : $val24
$().</span></p> 
!endif
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val28=$[rint(gcd($m_reply1,$m_reply2))]

!exit

:feedback
!ifval $m_reply1/$m_reply2=$val23/$val24 and $val28<>1
 <div class='oef_feedbacks'><div class="macss"> Vous pouvez simplifier votre réponse par $val8.</div>
$()</div>
!endif
!ifval $m_reply1=$val24 and $m_reply2=$val23
 <div class='oef_feedbacks'><div class="macss">Vous avez inversé les nombres de la réponse.<p>Le premier nombre correspond aux $(val21[$(val22[2])]) et le second nombre correspond aux $(val21[$(val22[2])]).</p></div>
$()</div>
!endif

!exit

:test
condweight1=3 

!ifval $m_reply1/$m_reply2=$val27
 condtest1=1
!else
 condtest1=0
!endif
condname1=Avez-vous le bon ratio&nbsp;?
condweight2=1 

!ifval $m_reply1/$m_reply2=$val27 and $val28=1
 condtest2=1
!else
 condtest2=0
!endif
condname2=Avez-vous donné le bon ratio sous forme simplifiée (quand c'est possible)&nbsp;?

!exit

:stat
vsavelist=8,14,17,19,20,21,22,23,24,25,26,27
embedcnt=2
