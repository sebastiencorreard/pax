!set title=Trouver 1 grandeur à partir d'un ratio et d'une autre grandeur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel,Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=ratio, proportion,proportionality
language=fr
computeanswer=no
precision=100000000
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .macss{background-color: #FAFAD2;} .damier {width:3px;height:3px;} .col1 {background-color:#FFFF00} .col2 {background-color:#FF0000} .wims_matrix td{padding:0} .unepart{width:100%;height:1em} .part_1{background-color:red} .part_2{background-color:blue} .part_3{background-color:maroon} .ecrit_1{color:red} .ecrit_2{color:blue} .ecrit_3{color:maroon} </style>

ansorder=r,r,r,r,r,r,r,r,r,r,r,r
varcnt=70
prevarcnt=60
postvarcnt=9
replycnt=12
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=1,2,3,4
val7=1,2,3,4
val8=gifs/images/methods/
val9=julie.png,	operater.png,	fraction.png,	tableau.png
val9=$(val9[$val6])
tmp0=!itemcnt $val6

val10=$[rint($(tmp0))]
val11=pour répondre directement,	  pour calculer la quantité d'une part du partage,	  pour utiliser des proportions,	  pour utiliser un tableau de proportionnalité
val12=$(val11[$val6])
val13=Je sais répondre <b>sans aide</b>.,	Je choisis de calculer la quantité d'une <b>part</b> du partage.,	Je choisis de calculer des <b>proportions</b>.,	Je choisis d'utiliser un <b>tableau de proportionnalité</b>.	
val13=$(val13[$val7])
val14=yellow,lightblue,lightgrey,paleturquoise,lightsalmon
val14=$(val14[$val6])
!readproc slib/text/balloon [$(val13[1])],$(val14[1]),250,100,triangle=left-in 
tmp0=$slib_out
val15=$(tmp0)
!readproc slib/text/balloon [$(val13[2])],$(val14[2]),250,100,triangle=left-in 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/text/balloon [$(val13[3])],$(val14[3]),250,100,triangle=left-in 
tmp0=$slib_out
val17=$(tmp0)
!readproc slib/text/balloon [$(val13[4])],$(val14[4]),250,100,triangle=left-in 
tmp0=$slib_out
val18=$(tmp0)
val19=<p>Répondre directement ou choisir l'aide.</p>
val20=répondre,part,tableau
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val21=<span class="ecrit_1">$(tmp0)</span>
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val22=<span class="ecrit_2">$(tmp0)</span>
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val23=<span class="ecrit_3">$(tmp0)</span>
tmp0=!shuffle $val21,$val22,$val23

val24=$(tmp0)
tmp0=!listuniq $val24

val24=$(tmp0)
tmp0=!itemcnt $val24

val25=$[rint($(tmp0))]
!if $val25<3 
tmp0=!shuffle Pierre,Diane,Albane

val24=$(tmp0)
val21=<span class="ecrit_1">$(val24[1])</span>
val22=<span class="ecrit_2">$(val24[2])</span>
val23=<span class="ecrit_3">$(val24[3])</span>
!endif
tmp0=!randint 1, 10

val26=$[rint($(tmp0))]
tmp0=!randint 1, 10

val27=$[rint($(tmp0))]
!if $val27=$val26 
val27=$[rint($val27+1)]
!endif
val28=$[rint(gcd($val26,$val27))]
val26=$[rint($val26/$val28)]
val27=$[rint($val27/$val28)]
tmp0=!randint $val26, 10

val29=$[rint($(tmp0)*$val26)]
val30=$[rint($val29/$val26)]
val31=$[rint($val27*$val30)]
val32=$val26,$val27
val33=gâteaux,billes,&oelig;ufs de Pâques,euros
!if $val26=1 
val34=gâteau,bille,&oelig;uf,euro
val35=part
!else
val34=$val33
val35=parts
!endif
!if $val27=1 
val36=gâteau,bille,&oelig;uf,euro
val37=part
!else
val36=$val33
val37=parts
!endif
tmp0=!randint 1, 4

val38=$[rint($(tmp0))]

!ifval $val38>2
val39= d'
!else
val39= de 
!endif
val40=\textcolor{red}{$val26} : \textcolor{blue}{$val27}
val41=1
val42=r1
val43=Nombre total de parts
val44=
!for val45 =1 to $val26  
val44=$val44<div class="unepart part_1" title=""> </div>
!if  $val45 < $val26  
val44=$val44,
!endif
!next
!for val46 =1 to $val27 
!if  $val46 < $val27  
!endif
val44=$val44,<div class="unepart part_2" title=""> </div>
!next
!readproc slib/text/matrixhtml	  [$val44],	  wimscenter wimsborder,	  TH=1	  CAPTION="Nombre total de parts"	  COLSPAN=[1,1,$val26;1,$val45$val27]	 
tmp0=$slib_out
val47=$(tmp0)
dynsteps=yes
oefsteps=$val42 
nextstep=!nosubst $val42 
!readproc oef/steps.proc
replytype1=click
replyoption1=nonstop 
replyweight1=0 
replyname1=Méthode
replygood1=?analyze 48;$val20
replytype2=numexp
replyname2=
replygood2=$val31
replytype3=numexp
replyname3=
replygood3=$val26
replytype4=numexp
replyname4=
replygood4=$val27
replytype5=numexp
replyname5=
replygood5=$val26
replytype6=numexp
replyname6=
replygood6=$val30
replytype7=numexp
replyname7=
replygood7=$val31
replytype8=numexp
replyname8=
replygood8=$val26
replytype9=numexp
replyname9=
replygood9=$val27
replytype10=numexp
replyname10=
replygood10=$val29
replytype11=numexp
replyname11=
replygood11=$val31
replytype12=numexp
replyname12=
replygood12=$val31
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_question"><span style="font-weight:bold">$val21</span> et	<span style="font-weight:bold">$val22</span> se partagent des $(val33[$val38]) selon le ratio	<span class="nowrap" style="font-weight:bold">
!insmath $val40
$()</span>.	<p> Sachant que $val21 a reçu $val29 $(val33[$val38]), on veut déterminer	le nombre $val39$(val33[$val38]) que recevra $val22.</p></div>	
!if $m_step=1 
$()		$val19				<ul class="inline"><li>	 
!read oef/embed.phtml reply1,1,<img src="$val8/$(val9[1])" alt="$(val11[2])"> 
$()	$val15	</li><li>	 
!read oef/embed.phtml reply1,2,<img src="$val8/$(val9[2])" alt="$(val11[2])"> 
$()	$val16	</li><li>	 
!read oef/embed.phtml reply1,3,<img src="$val8/$(val9[4])" alt="$(val11[4])"> 
$()	$val18	</li>	</ul>		 
!endif
$()	
!if $m_step=2 and $val48=répondre 
$()	<br><label for="reply2">$val22 reçoit</label>  
!read oef/embed.phtml reply2,3 
$() $(val33[$val38]). 
!endif
$()	
!if $m_step=2 and $val48==part 
$()	<br>On commence par déterminer la quantité $val39$(val33[$val38]) que représente une part.	<br>On peut illustrer la situation par le dessin suivant&nbsp;:	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>	$val47	<br><label for="reply3">Avec le ratio 
!insmath $val40
$(), $val21 reçoit  
!read oef/embed.phtml r3,3 
$() $val35</label><label for="reply4"> pendant que $val22 reçoit  
!read oef/embed.phtml r4,3 
$()$val37</label>.	<br><label for="reply5">Comme $val21 reçoit $val29 $(val33[$val38]) et que cela représente</label> 
!read oef/embed.phtml r5,3 
$() $val35 alors <label for="reply6"><b>une part</b> représente  
!read oef/embed.phtml r6,3 
$() $(val33[$val38]).</label>	<br><label for="reply7">Donc $val22 a reçu  
!read oef/embed.phtml reply7,3 
$() $(val33[$val38]).</label> 
!endif
$()	
!if $m_step=2 and $val48==tableau 
$()Comme le ratio est une situation de proportionnalité, on complète ce tableau de proportionnalité en commençant par le remplir grâce aux données de l'énoncé.	<table class="wimscenter wimsborder">	<tr>	<td colspan="1"><label for="reply8">$val21</label></td>	<td colspan="1"><label for="reply9">$val22</label></td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r8,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r9,3 
$()</td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r10,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r11,3 
$()</td>	</tr>	</table>	Puis conclure&nbsp;:<div> <label for="reply12">$val22 va recevoir</label>  
!read oef/embed.phtml r12,3 
$() $(val33[$val38]).</div>	 
!endif
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	
!if $val48=~3 
$()On complète le tableau grâce aux données de l'énoncé.	<div class="unbreakable">	<table class="wimscenter wimsborder">	<tr>	<td colspan="1">$val21</td>	<td colspan="1">$val22</td>	</tr><tr>	<td colspan="1">$(val32[1])</td>	<td colspan="1">$(val32[2])</td>	</tr><tr>	<td colspan="1">$val29</td>	<td colspan="1"></td>	</tr>	</table>	</div>	<p>Le ratio traduisant une situation de proportionnalité, ce tableau est un tableau de proportionnalité	dont le coefficient est égal à <span class="nowrap">
!insmath \frac{$val29}{$val26}=$val30
$().</span></p>	<p>On multiplie $val27 par $val30 : <span class="nowrap">
!insmath  $val27 \times $val30 = $val31 
$().</span></p>	On finit de compléter le tableau&nbsp;:	<div class="unbreakable">	<table class="wimscenter wimsborder">	<tr>	<td colspan="1">$val21</td>	<td colspan="1">$val22</td>	</tr>	<tr>	<td colspan="1">$(val32[1])</td>	<td colspan="1">$(val32[2])</td>	</tr>	<tr>	<td colspan="1">$val29</td>	<td colspan="1">$val31</td>	</tr>	</table>	</div>	Puis on conclut : $val22 va recevoir $val31 $(val33[$val38]). 
!endif
$()	
!if $val48=~1 or $val48=~2 
$()On commence par déterminer la quantité $val39$(val33[$val38]) que représente une part.	<br>Avec le ratio 
!insmath $val40
$(), $val21 reçoit $val26 $val35 pendant que $val22 reçoit $val27 $val37.	<br>Comme $val21 reçoit $val29 $(val33[$val38]) et que cela représente $val26 $val35 alors <b>une part</b> représente 
!insmath \frac{$val29}{$val26}=$val30
$() $(val33[$val38]).	<br>Donc $val22 a reçu 
!insmath  $val30 \times $val27 = $val31
$() $(val33[$val38]). 
!endif
$()	
$()
!exit

:latex
$()
$()
!exit

