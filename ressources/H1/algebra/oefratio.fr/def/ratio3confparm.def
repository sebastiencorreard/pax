!if $val32=1 
$()<ul class="wims_nopuce">	<li>On commence par déterminer le nombre total de parts.</li>	<li>On peut illustrer la situation par le dessin suivant :</li>	<li>Part de $val6 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val7 <span class="unepart part_2 ecrit_2">AAA</span>	Part de $val8 <span class="unepart part_3 ecrit_3">AAA</span>	$val39</li>	<li><label for="reply1">Avec le ratio 
!insmath $val31
$(), $val6 reçoit  
!read oef/embed.phtml r1,3 
$() $val24 </label><label for="reply2"> pendant que $val7 reçoit  
!read oef/embed.phtml r2,3 
$() $val26 </label> et	<label for="reply3">$val8 reçoit  
!read oef/embed.phtml r3,3 
$() $val28 </label>.</li>	<li><label for="reply4">Le partage est donc composé de </label> 
!read oef/embed.phtml r4,3 
$() parts égales.</li>	<li>Comme il y a $val16 $(val22[$val29]),<label for="reply5"> chaque part est composée de</label>	 
!read oef/embed.phtml r5,3 
$() $(val22[$val29]).</li>	<li><label for="reply6">$val6 reçoit</label>  
!read oef/embed.phtml reply6,3 
$() $(val22[$val29]).</li>	<li><label for="reply7">$val7 reçoit</label>  
!read oef/embed.phtml reply7,3 
$() $(val22[$val29]).</li>	<li><label for="reply8">$val8 reçoit</label>  
!read oef/embed.phtml reply8,3 
$() $(val22[$val29]).</li>	</ul>	 
!endif
$()	
!if $val32=2 
$()<br>On peut illustrer la situation par le dessin suivant :	<br>Part de $val6 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val7	<span class="unepart part_2 ecrit_2">AAA</span>	Part de $val8 <span class="unepart part_3 ecrit_3">AAA</span></span>	$val39	<br><label for="reply9">Avec le ratio 
!insmath $val31
$(), $val6 reçoit</label>  
!read oef/embed.phtml r9,3 
$() $val24,<label for="reply10">$val7 reçoit</label>  
!read oef/embed.phtml r10,3 
$() $val26	et <label for="reply11">$val8 reçoit</label>  
!read oef/embed.phtml r11,3 
$() $val28.	<br><label for="reply12">Par conséquent, le partage est composé de</label> 
!read oef/embed.phtml r12,3 
$() parts égales.	<span class="unbreakable">$val6 reçoit alors	 
!read oef/special.phtml mathmlinput [\frac{reply13}{reply14}], 3	reply13	reply14 
$()	des  
!read oef/embed.phtml r15,3 
$() $(val22[$val29]).</span><br>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply16}{reply17} \times {reply18}={reply19}], 3	reply16	reply17	reply18	reply19 
$().</span><br>	<span class="unbreakable">De même, $val7 reçoit  
