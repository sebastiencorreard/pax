$() $(val22[$val29]).<br></span>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply23}{reply24} \times {reply25}={reply26}], 3	reply23	reply24	reply25	reply26 
$()	.</span><br>	Et $val8 reçoit  
