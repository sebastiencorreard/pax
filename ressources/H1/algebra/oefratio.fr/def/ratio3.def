!read oef/embed.phtml reply1,2,<img src="$val8/$(val9[2])" alt="$(val11[2])"> 
$()	$val16	</li><li>	 
!read oef/embed.phtml reply1,3,<img src="$val8/$(val9[3])" alt="$(val11[3])"> 
$()	$val17	</li><li>	 
!read oef/embed.phtml reply1,4,<img src="$val8/$(val9[4])" alt="$(val11[4])"> 
$()	$val18	</li>	</ul>	 
!endif
$()	
!if $m_step=2 and $val55==part 
$()<br>On commence par déterminer le nombre total de parts.	<br>On peut illustrer la situation par le dessin suivant :	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>	Part de $val23 <span class="unepart part_3 ecrit_3">AAA</span>	<br>$val54	<br><label for="reply2">Avec le ratio 
!insmath $val46
$(), $val21 reçoit  
!read oef/embed.phtml r2,3 
$() $val39 </label><label for="reply3"> pendant que $val22 reçoit  
!read oef/embed.phtml r3,3 
$() $val41 </label> et	<label for="reply4">$val23 reçoit  
!read oef/embed.phtml r4,3 
$() $val43 </label>.	<br><label for="reply5">Le partage est donc composé de </label> 
!read oef/embed.phtml r5,3 
$() parts égales.	<br>Comme il y a $val31 $(val37[$val44]),<label for="reply6"> chaque part est composée de</label>  
!read oef/embed.phtml r6,3 
$() $(val37[$val44]).	<br><label for="reply7">$val21 reçoit</label>  
!read oef/embed.phtml reply7,3 
$() $(val37[$val44]).	<br><label for="reply8">$val22 reçoit</label>  
!read oef/embed.phtml reply8,3 
$() $(val37[$val44]).	<br><label for="reply9">$val23 reçoit</label>  
!read oef/embed.phtml reply9,3 
$() $(val37[$val44]).	 
!endif
$()	
!if $m_step=2 and $val55==proportion 
$()<br>On peut illustrer la situation par le dessin suivant :	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span>	Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>	Part de $val23 <span class="unepart part_3 ecrit_3">AAA</span>	<br>$val54	<br><label for="reply10">Avec le ratio 
!insmath $val46
$(), $val21 reçoit</label>  
!read oef/embed.phtml r10,3 
$() $val39,<label for="reply11">$val22 reçoit</label>  
!read oef/embed.phtml r11,3 
$() $val41 et <label for="reply12">$val23 reçoit</label>  
!read oef/embed.phtml r12,3 
$() $val43.	<br><label for="reply13">Par conséquent, le partage est composé de</label> 
!read oef/embed.phtml r13,3 
$() parts égales.<br />	<span class="unbreakable">$val21 reçoit alors	 
!read oef/special.phtml mathmlinput [\frac{reply14}{reply15}], 3	reply14	reply15 
$()	des  
!read oef/embed.phtml r16,3 
$() $(val37[$val44]).</span><br />	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply17}{reply18} \times {reply19}={reply20}], 3	reply17	reply18	reply19	reply20 
$() $(val37[$val44]).</span><br />	<span class="unbreakable">De même, $val22 reçoit  
