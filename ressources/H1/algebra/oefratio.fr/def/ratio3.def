$() $(val37[$val44]).<br /></span>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply24}{reply25} \times {reply26}={reply27}], 3	reply24	reply25	reply26	reply27 
$() $(val37[$val44]).</span><br />	Et $val23 reçoit  
