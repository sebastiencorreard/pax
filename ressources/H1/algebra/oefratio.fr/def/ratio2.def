:question
$()<div class="wims_question">$val21 et $val22 se partagent 
!insmath $val27
$() $(val36[$val41]) selon le ratio 
!insmath $val43
$().	<p>Déterminer le nombre $val42$(val36[$val41]) que recevra chaque personne.</div>	
!if $m_step=1 
$()	$val19	<ul class="inline"><li>	 
!read oef/embed.phtml reply1,1,<img src="$val8/$(val9[1])" alt="$(val11[1])"> 
$()	$val15	</li><li>	 
!read oef/embed.phtml reply1,2,<img src="$val8/$(val9[2])" alt="$(val11[2])"> 
$()	$val16	</li><li>	 
!read oef/embed.phtml reply1,3,<img src="$val8/$(val9[3])" alt="$(val11[3])"> 
$()	$val17	</li><li>	 
!read oef/embed.phtml reply1,4,<img src="$val8/$(val9[4])" alt="$(val11[4])"> 
$()	$val18	</li>	</ul>	 
!endif
$()	
!if $m_step=2 and $val51==part 
$()On commence par déterminer le nombre total de parts.	<br>On peut illustrer la situation par le dessin suivant :	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>	$val50	<br><label for="reply2">Avec le ratio 
!insmath $val43
$(), $val21 reçoit  
!read oef/embed.phtml r2,3 
$() $val38</label><label for="reply3"> pendant que $val22 reçoit  
!read oef/embed.phtml r3,3 
$()$val40</label>.	<br><label for="reply4">Le partage est donc composé de</label> 
!read oef/embed.phtml r4,3 
$() parts égales.	<br>Comme il y a $val27 $(val36[$val41]),<label for="reply5"> chaque part est composée de</label> 
!read oef/embed.phtml r5,3 
$() $(val36[$val41]).	<br><label for="reply6">$val21 reçoit</label>  
!read oef/embed.phtml reply6,3 
$() $(val36[$val41]).	<br><label for="reply7">$val22 reçoit</label>  
!read oef/embed.phtml reply7,3 
$() $(val36[$val41]).  
!endif
$()	
!if $m_step=2 and $val51=proportion 
$()	<p>Avec le ratio 
!insmath  $val43 
$(), on peut faire le dessin suivant :</p>	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>	$val50	<label for="reply8">Le partage est composé de</label> 
!read oef/embed.phtml r8,3 
$() parts égales.<br>	<span class="unbreakable">$val21 reçoit alors	 
!read oef/special.phtml mathmlinput [\frac{reply9}{reply10}], 3	reply9	reply10 
$()	des  
!read oef/embed.phtml r11,3 
$() $(val36[$val41]).</span><br>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply12}{reply13} \times {reply14}={reply15}], 3	reply12	reply13	reply14	reply15 
$() $(val36[$val41]).</span><br>	<span class="unbreakable">De même, $val22 reçoit  
!read oef/special.phtml mathmlinput [\frac{reply16}{reply17}], 3	reply16	reply17 
$()	des  
!read oef/embed.phtml r18,3 
$() $(val36[$val41]).</span><br>	<span class="unbreakable">C'est à dire  
!read oef/special.phtml mathmlinput [\frac{reply19}{reply20} \times {reply21}={reply22}], 3	reply19	reply20	reply21	reply22 
$()	$(val36[$val41]).</span><br>	Ainsi,<label for="reply23"> $val21 reçoit</label> 
!read oef/embed.phtml r23,3 
$() $(val36[$val41]) et	<label for="reply24">$val22 reçoit</label> 
!read oef/embed.phtml r24,3 
$() $(val36[$val41]). 
!endif
$()	
!if $m_step=2 and $val51=tableau 
$()	Comme le ratio est une situation de proportionnalité, on complète ce tableau de proportionnalité en commençant par le remplir grâce aux données de l'énoncé.	<div class="unbreakable">	<table class="wimscenter wimsborder">	<tr>	<td colspan="1"><label for="reply25">$val21</label></td>	<td colspan="1"><label for="reply26">$val22</label></td>	<td colspan="1"><label for="reply27">Total</label></td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r25,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r26,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r27,3 
$()</td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r28,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r29,3 
$()</td>	<td colspan="1">$val27</td>	</tr>	</table>	</div>	puis on conclut :	<br class="spacer">	<label for="reply30">$val21 recevra</label>  
!read oef/embed.phtml r30,3 
$() $(val36[$val41])	<br class="spacer">	et <label for="reply31">$val22 recevra</label>  
!read oef/embed.phtml r31,3 
$() $(val36[$val41]). 
!endif
$()	
