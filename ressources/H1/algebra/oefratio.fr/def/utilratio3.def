val10=$[rint($(tmp0))]
val11=pour répondre directement,	  pour calculer la quantité d'une part du partage,	  pour utiliser des proportions,	  pour utiliser un tableau de proportionnalité
val12=$(val11[$val6])
val13=Je sais répondre <b>sans aide</b>.,	Je choisis de calculer la quantité d'une <b>part</b> du partage.,	Je choisis de calculer des <b>proportions</b>.,	Je choisis d'utiliser un <b>tableau de proportionnalité</b>.	
val13=$(val13[$val7])
val14=yellow,lightblue,lightgrey,paleturquoise,lightsalmon
val14=$(val14[$val6])
!readproc slib/text/balloon [$(val13[1])],$(val14[1]),250,100,triangle=left-in 
tmp0=$slib_out
val15=$(tmp0)
!readproc slib/text/balloon [$(val13[2])],$(val14[2]),250,100,triangle=left-in 
tmp0=$slib_out
val16=$(tmp0)
!readproc slib/text/balloon [$(val13[3])],$(val14[3]),250,100,triangle=left-in 
tmp0=$slib_out
val17=$(tmp0)
!readproc slib/text/balloon [$(val13[4])],$(val14[4]),250,100,triangle=left-in 
tmp0=$slib_out
val18=$(tmp0)
val19=<p>Répondre directement ou choisir l'aide.</p>
val20=répondre,part,tableau
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val21=<span class="ecrit_1">$(tmp0)</span>
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val22=<span class="ecrit_2">$(tmp0)</span>
!readproc slib/lang/fname fr,girl 
tmp0=$slib_out
val23=<span class="ecrit_3">$(tmp0)</span>
tmp0=!shuffle $val21,$val22,$val23

val24=$(tmp0)
tmp0=!listuniq $val24

val24=$(tmp0)
tmp0=!itemcnt $val24

val25=$[rint($(tmp0))]
!if $val25<3 
tmp0=!shuffle Pierre,Diane,Albane

val24=$(tmp0)
val21=<span class="ecrit_1">$(val24[1])</span>
val22=<span class="ecrit_2">$(val24[2])</span>
val23=<span class="ecrit_3">$(val24[3])</span>
!endif
tmp0=!randint 1, 10

val26=$[rint($(tmp0))]
tmp0=!randint 1, 10

val27=$[rint($(tmp0))]
tmp0=!randint 1, 10

val28=$[rint($(tmp0))]
!while $val26=$val27 and $val27=$val28 
tmp0=!randint 1, 10

val26=$[rint($(tmp0))]
tmp0=!randint 1, 10

val27=$[rint($(tmp0))]
tmp0=!randint 1, 10

val28=$[rint($(tmp0))]
!endwhile
val29=$[rint(gcd($val26,$val27))]
val29=$[rint(gcd($val28,$val29))]
val26=$[rint($val26/$val29)]
val27=$[rint($val27/$val29)]
val28=$[rint($val28/$val29)]
val30=$[rint($val26+$val27+$val28)]
tmp0=!randint 3, 20

val31=$[rint($val30*$(tmp0))]
val32=$[rint($val31/$val30)]
val33=$[rint($val26*$val32)]
val34=$[rint($val27*$val32)]
val35=$[rint($val28*$val32)]
val36=$val26,$val27,$val28
val37=gâteaux,billes,&oelig;ufs de Pâques,euros
!if $val26=1 
val38=gâteau,bille,&oelig;uf,euro
val39=part
!else
val38=$val37
val39=parts
!endif
!if $val27=1 
val40=gâteau,bille,&oelig;uf,euro
val41=part
!else
val40=$val37
val41=parts
!endif
!if $val28=1 
val42=gâteau,bille,&oelig;uf,euro
val43=part
!else
val42=$val37
val43=parts
!endif
tmp0=!randint 1, 4

val44=$[rint($(tmp0))]

!ifval $val44>2
val45= d'
!else
val45= de 
!endif
val46=\textcolor{red}{$val26} : \textcolor{blue}{$val27} : \textcolor{maroon}{$val28}
val47=1
val48=r1
val49=Nombre total de parts
val50=
!for val51 =1 to $val26  
val50=$val50<div class="unepart part_1"> </div>
!if  $val51 < $val26  
val50=$val50,
!endif
!next
!for val52 =1 to $val27 
!if  $val52 < $val27  
!endif
val50=$val50,<div class="unepart part_2"> </div>
!next
!readproc slib/text/matrixhtml	  [$val50],	  wimscenter wimsborder,	  TH=1	  CAPTION="Nombre total de parts"	  COLSPAN=[1,1,$val26;1,$val51,$val27]	 
tmp0=$slib_out
val53=$(tmp0)
dynsteps=yes
oefsteps=$val48 
nextstep=!nosubst $val48 
!readproc oef/steps.proc
