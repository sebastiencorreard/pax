:question
$()<div class="wims_question"><span style="font-weight:bold">$val21</span>,	<span style="font-weight:bold">$val22</span> et <span style="font-weight:bold">$val23</span>	se partagent des $(val37[$val44]) selon le ratio	<span class="nowrap" style="font-weight:bold">
!insmath $val46
$()</span>.	<p> Sachant que $val21 reçoit $val33 $(val37[$val44]), on veut déterminer le nombre $val45$(val37[$val44]) que recevront $val22 et $val23.</p></div>	
!if $m_step=1 
$()	$val19	<ul class="inline"><li>	 
!read oef/embed.phtml reply1,1,<img src="$val8/$(val9[1])" alt="$(val11[2])"> 
$()	$val15	</li><li>	 
!read oef/embed.phtml reply1,2,<img src="$val8/$(val9[2])" alt="$(val11[2])"> 
$()	$val16	</li><li>	 
!read oef/embed.phtml reply1,3,<img src="$val8/$(val9[4])" alt="$(val11[4])"> 
$()	$val18	</li>	</ul>	 
!endif
$()	
!if $m_step=2 and $val54=répondre 
$()	<br><label for="reply2">$val22 reçoit</label>  
!read oef/embed.phtml reply2,3 
$() $(val37[$val44]).	<br><label for="reply3">$val23 reçoit</label>  
!read oef/embed.phtml reply3,3 
$() $(val37[$val44]). 
!endif
$()	
!if $m_step=2 and $val54==part 
$()	<br>On commence par déterminer la quantité $val45$(val37[$val44]) que représente une part.	<p>On peut illustrer la situation par le dessin suivant&nbsp;:</p>	<br>Part de $val21 <span class="unepart part_1 ecrit_1">AAA</span> Part de $val22 <span class="unepart part_2 ecrit_2">AAA</span>Part de $val23 <span class="unepart part_3 ecrit_3">AAA</span>	<br>$val53	<br><label for="reply4">Avec le ratio 
!insmath $val46
$(), $val21 reçoit  
!read oef/embed.phtml r4,3 
$() $val39</label><label for="reply5"> pendant que $val22 reçoit  
!read oef/embed.phtml r5,3 
$()$val41</label> et<label for="reply6"> $val23 reçoit  
!read oef/embed.phtml r6,3 
$()$val43</label>.	<br><label for="reply7">Comme $val21 a reçu  
!read oef/embed.phtml r7,3 
$() $(val37[$val44])</label> et que<label for="reply8"> cela représente</label> 
!read oef/embed.phtml r8,3 
$() $val39 alors <label for="reply9"><b>une part</b> représente  
!read oef/embed.phtml r9,3 
$() $(val37[$val44]).</label>	<br><label for="reply10">Donc $val22 a reçu  
!read oef/embed.phtml reply10,3 
$() $(val37[$val44]) et <label for="reply11">$val23 a reçu  
!read oef/embed.phtml reply11,3 
$() $(val37[$val44]).</label> 
!endif
$()	
!if $m_step=2 and $val54==tableau 
$()Comme le ratio est une situation de proportionnalité, on complète ce tableau de proportionnalité en commençant par le remplir grâce aux données de l'énoncé.</li>	<table class="wimscenter wimsborder">	<tr>	<td colspan="1"><label for="reply12">$val21</label></td>	<td colspan="1"><label for="reply13">$val22</label></td>	<td colspan="1"><label for="reply14">$val23</label></td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r12,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r13,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r14,3 
$()</td>	</tr>	<tr>	<td colspan="1"> 
!read oef/embed.phtml r15,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r16,3 
$()</td>	<td colspan="1"> 
!read oef/embed.phtml r17,3 
$()</td>	</tr>	</table>	Puis on conclut <label for="reply18">$val22 va recevoir</label>  
!read oef/embed.phtml r18,3 
$() $(val37[$val44]) et <label for="reply19">$val23 va recevoir</label>  
!read oef/embed.phtml r19,3 
$() $(val37[$val44]).</div>	 
!endif
$()
$()
!exit

