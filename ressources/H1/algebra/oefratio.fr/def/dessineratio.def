!set title=Dessiner un ratio dans un damier
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel,Verbecq
email=lionel.verbecq@ac-versailles.fr
keywords=ratio, proportion,proportionality
language=fr
computeanswer=no
precision=100000000
leftrange=-5.000000
rightrange=5.000000
oefcss=<style> .macss{background-color: #FAFAD2;} .damier {width:3px;height:3px;} .col1 {background-color:#FFFF00} .col2 {background-color:#FF0000} .wims_matrix td{padding:0} .unepart{width:100%;height:1em} .part_1{background-color:red} .part_2{background-color:blue} .part_3{background-color:maroon} .ecrit_1{color:red} .ecrit_2{color:blue} .ecrit_3{color:maroon} </style>

ansorder=r
varcnt=35
prevarcnt=32
postvarcnt=2
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0))]
tmp0=!randint 2, 5

val7=$[rint($(tmp0))]
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
val6=$[rint($val6*$val8)]
val7=$[rint($val7*$val8)]
val9=$[rint(20*$val6)]
val10=$[rint(20*$val7)]
val11=$[rint($val6*$val7)]
tmp0=!randint 1, $val11-1

val12=$[rint($(tmp0))]
val13=$[$val11/2]
!if $val12=$val13 
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0))]
tmp0=!randint $val12+1, $val11-1

val15=$[rint($(tmp0))]
val16=$val14,$val15
tmp=!nonempty items $val16

tmp0=!randitem $tmp
val12=$(tmp0)
!endif
val17=$[rint($val11-$val12)]
val18=$[rint(gcd($val12,$val17))]
val19=$[rint($val12/$val18)]
val20=$[rint($val17/$val18)]
val21=$[rint($val11/($val19+$val20))]
val22=Colorier des cases en rouge afin que le nombre de cases rouges et le nombre de cases jaunes soient dans le ratio
val23=Commencer par sélectionner la couleur rouge en cliquant sur le petit rectangle jaune.
val24=Votre réponse est-elle juste&nbsp;?&nbsp;
val25=<table class="wimsborder unstriped">
val26=$[rint(0)]
!for val27 =1 to $val7 
val25=$val25 <tr>
!for val28 =1 to $val6 
val26=$[rint($val26+1)]
!if $val26<=$val12 
val25=$val25 <td class="damier col2"></td>
!else
val25=$val25 <td class="damier col1"></td>
!endif
!next
val25=$val25</tr>
!next
val25=$val25 </table>
replytype1=clicktile

replyname1=
replygood1=?analyze 29
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=!nosubst Une réponse possible est <div class="unbreakable">$val25</div>


!goto stat

!exit

:question
$()	$(val22[1]) <span class="nowrap" style="font-weight:bold">	
!insmath $val19 : $val20 
$() </span> ( lire 
!insmath $val19
$() pour 
!insmath $val20
$()&nbsp;).	<div class="wimscenter">	 
!read oef/embed.phtml r1, $val9 x $val10	[xrange 0,$val6	yrange 0,$val7	background_color yellow	colors red] 
$()	</div>	<div class="wims_instruction">	$val23	</div>	
$()
!exit

:hint
$()Le nombre de cases rouges et le nombre de cases jaunes sont dans le ratio 
!insmath 4 : 5 
$() signifie qu'à chaque fois que l'on colorie <strong>
!insmath  4
$() cases en rouge</strong>,	on doit colorier <strong>
!insmath 5
$() cases en jaune</strong>. Exemple :	<div><img src="$val1/faireratio_hint.png" alt="Illustration d'un ratio 4 pour 5 dans une grille de 6 par 6" /></div>
$()
!exit

:help
$()
$()
!exit

:solution
$()Une réponse possible est <div class="unbreakable">$val25</div>
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!listuniq $val29

val30=$(tmp0)
tmp0=!itemcnt $val30

val30=$[rint($(tmp0)-1)]

!exit

:feedback
!ifval $val17=$val30
 <div class='oef_feedbacks'> <div class="macss">Attention, vous avez inversé les couleurs, il doit y avoir $val12 
!if $val12>1 
$()cases rouges. 
!else
$() case rouge. 
!endif
$()</div>
$()</div>
!endif

!exit

:test

!ifval $val12 = $val30
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val24

!exit

:stat
vsavelist=1,6,7,9,10,12,17,19,20,22,23,24,25,29
embedcnt=1
