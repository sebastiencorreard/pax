\title{Trouver un ratio à partir d'un dessin}
\integer{nbre1=randint(1..10)}
\integer{nbre2=randint(1..10)}
\while{\nbre1=\nbre2}{
\integer{nbre1=randint(1..10)}
\integer{nbre2=randint(1..10)}}
\integer{pgcd=gcd(\nbre1,\nbre2)}
\integer{rep1=\nbre1/\pgcd}
\integer{rep2=\nbre2/\pgcd}
\text{ListImage=pomme.jpg,
banane.jpg}
\text{pomme=<img src="\imagedir/\ListImage[1]" alt="dessin d'une pomme" />}
\text{banane=<img src="\imagedir/\ListImage[2]" alt="dessin d'une banane" />}
\text{liste=\pomme,\banane}
\if{\nbre1>1}{\for{i = 1 to \nbre1-1}{
\text{liste=\liste,\banane}}}
\if{\nbre2>1}{\for{j = 1 to \nbre2-1}{
\text{liste=\liste,\pomme}}}
\integer{total=\nbre1+\nbre2}
\text{liste=shuffle(\liste)}
\text{ordre=1,2}
\if{\nbre1=1}{\text{ordre1= les pommes,la banane}
\text{ordre2=Les pommes,La banane}
\text{ordre3=pommes,banane}}
\if{\nbre2=1}{\text{ordre1= la pomme,les bananes}
\text{ordre2=La pomme,Les bananes}
\text{ordre3=pomme,bananes}}
\if{\nbre1<>1 and \nbre2<>1}{\text{ordre1= les pommes,les bananes}
\text{ordre2=Les pommes,Les bananes}
\text{ordre3=pommes,bananes}}
\text{ordremel=shuffle(\ordre)}
\if{\ordremel[1]=1}{\integer{good1=\rep1}
\integer{good2=\rep2}
\integer{sol1=\nbre1}
\integer{sol2=\nbre2}}
{\integer{good1=\rep2}
\integer{good2=\rep1}
\integer{sol1=\nbre2}
\integer{sol2=\nbre1}}
\rational{frac=\good1/\good2}
\statement{Dans quel ratio sont <b>\ordre1[\ordremel[2]]</b> et <b>\ordre1[\ordremel[1]]</b>&nbsp;?
\for{k=1 to \total}{\liste[\k]}
<div class="spacer"><b>\ordre2[\ordremel[2]]</b> et <b>\ordre1[\ordremel[1]]</b>
sont dans le ratio <span class="nowrap">\embed{reply1,3}:\embed{reply2,3}.</span></div>
<div class="wims_instruction">On donnera le ratio sous forme simplifiée lorsque cela est possible.</div>
}
\answer{}{\good1}{type=numexp}
\answer{}{\good2}{type=numexp}
\integer{test=gcd(\reply1,\reply2)}
\condition{Avez-vous le bon ratio&nbsp;?}{\reply1/\reply2=\frac}{weight=3}
\condition{Avez-vous donné le bon ratio sous forme simplifiée (quand c'est possible)&nbsp;?}{\reply1/\reply2=\frac and \test=1}{weight=1}
\feedback{\reply1/\reply2=\good1/\good2 and \test<>1}{<div class="macss"> Vous pouvez simplifier votre réponse par \pgcd.</div>}
\feedback{\reply1=\good2 and \reply2=\good1}{<div class="macss">Vous avez inversé les nombres de la réponse.<p>Le premier nombre correspond aux \ordre3[\ordremel[2]] et le second nombre correspond aux \ordre3[\ordremel[2]].</p></div>}
\solution{Il y a \sol1 \ordre3[\ordremel[2]] et \sol2 \ordre3[\ordremel[1]].
<br>\ordre2[\ordremel[2]] et \ordre1[\ordremel[1]] sont dans le ratio \(\sol1 : \sol2\).
\if{\pgcd=1}{<p>Ce ratio ne peut pas être simplifié.</p>}
{<p>Comme \sol1 et \sol2 sont divisibles par \pgcd, le ratio se simplifie en <span class="nowrap">\(\good1 : \good2\).</span></p>}}
\hint{Simplifier un ratio (quand c'est possible), c'est diviser chaque nombre du ratio par un diviseur commun aux nombres du ratio.
<p>Par exemple, pour simplifier le ratio \(16:18\), on cherche un diviseur commun à \(16\) et \(18\).</p>
<p>\(16) et \(18) sont divisibles par \(2) et on a <span class="nowrap">\( 16 = 2 \times 8 \) et \( 18 = 2 \times 9\).</span></p>
<p>Donc le ratio \(16:18\) se simplifie en <span class="nowrap">\(8:9\).</span></p>}

