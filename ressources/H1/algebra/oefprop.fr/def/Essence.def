val8=hoe ver kan hij daarop rijden
val9=Afstand (in \(\textrm{km}\))
!endif
tmp0=!randitem 8,10,12,14,16

val10=$[rint($(tmp0))]
tmp0=!randint 4*$val10, 7*$val10

val11=$[rint($(tmp0))]
val12=$[($val11/$val10)*100]
replytype1=default
replyname1=$val9
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val10 $(val7[2]) \(\textrm{km}\). $(val7[3]) $val11 $(val7[4]) <p>$val8?</p> \end{statement} 


!goto stat

!exit

