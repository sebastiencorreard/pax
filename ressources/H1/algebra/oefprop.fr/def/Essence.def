!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Une voiture consomme,litres d'essence aux 100,	  Son réservoir peut contenir,litres d'essence
val8=Quelle est son autonomie
val9=Autonomie (en \(\textrm{km}\))
