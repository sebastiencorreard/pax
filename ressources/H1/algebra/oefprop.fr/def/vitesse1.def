!set title=Vitesse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, Xiao
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
precision=10000
title_en=Speed
title_nl=TITRE_nl
title_es=Velocidad1

ansorder=r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture a parcouru une distance de,en
val9=Durée en,Distance en
val10=La vitesse moyenne est de
!if $val6=en 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture a parcouru une distance de,en
val9=Durée en,Distance en
val10=La vitesse moyenne est de
!endif
!if $val6=es 
tmp=!trim Complete la tabla	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Un vehículo ha recorrido una distancia de,en
val9=Duración en,Distancia en
val10=La velocidad media es de
!endif
!if $val6=nl 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture a parcouru une distance de,en
val9=Durée en,Distance en
val10=La vitesse moyenne est de
!endif
tmp0=!randint 70, 180

val11=$[rint($(tmp0))]
tmp0=!randint 85, 165

val12=$[rint($(tmp0))]
val13=$[$val12*6/10]
val14=$[rint(floor($val11/60))]
val15=$[rint($val11-60*$val14)]
val16=$[$val11*$val12/100]
val17=$[rint(60)]
replytype1=numeric
replyname1=
replygood1=$[$val11]
replytype2=numeric
replyname2=
replygood2=$[$val17]
replytype3=numeric
replyname3=
replygood3=$[$val13]
replytype4=numeric
replyname4=
replygood4=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val16 
!insmath \mathrm{km}
$() ($(val8[2]) $val14 
!insmath \textrm{h}
$() $val15 
!insmath \textrm{min}
$()).	<p>$(val7[1;]) ($(val7[2;])):</p>	<table class="wimscenter wimsborder">	<tr><th><label for="reply1">$(val9[1]) 
!insmath \textrm{min}
$()</label></th><td> 
!read oef/embed.phtml reply 1 
$()</td><td> 
!read oef/embed.phtml reply 2 
$()</td></tr>	<tr><th><label for="reply3">$(val9[2]) 
!insmath \textrm{km}
$()</label></th><td>$val16</td><td> 
!read oef/embed.phtml reply 3 
$()</td>	</tr></table>	<div><label for="reply4">$val10</label>  
!read oef/embed.phtml reply 4 
$() 
!insmath \textrm{km / h}
$().</div>	
$()
!exit

