!set title=Poids
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, Xiao
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Weights
title_nl=Gewicht
title_es=Pesos

ansorder=r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Un camion est,fois plus lourd qu'une voiture tandis qu'un	  camion est, fois moins lourd qu'un char.,	  Sachant qu'un camion pèse, tonnes, calculer le poids d'une voiture et d'un char (en tonnes).
val8=Poids d'une voiture (en tonnes)
val9=Poids d'un char (en tonnes)
!if $val6=en 
val7=A truck is,times heavier than a car while	  the truck is, lighter than a tank. Knowing that the truck	  weighs, tons, compute the weights of a car and of a tank (in tons).
val8=Weight of a car (in tons)
val9=Weight of a tank (in tons)
!endif
!if $val6=es 
val7=Un camión es,veces más pesado que un coche mientras que	  el camión es, veces más ligero que un tanque.,	  Sabiendo que el camión pesa, toneladas, calcular los pesos	  (in toneladas) del coche y del tanque.
val8=Peso del coche
val9=Peso del tanqu
!endif
!if $val6=nl 
val7=Een vrachtwagen is,keer zwaarder dan een auto terwijl de	  vrachtwagen, eer lichter is dan een tank. ,	  Wetend dat de vrachtwagen, ton weegt, bereken het gewicht van een auto	  en van een tank (in tonnen).
val8=Gewicht van een auto
val9=Gewicht van een tank
!endif
tmp0=!randitem 8,10

val10=$[rint($(tmp0))]
tmp0=!randitem 4,5

val11=$[rint($(tmp0))]
tmp0=!randint 8, 12

val12=$[rint($(tmp0))]
val13=$[$val12/$val10]
val14=$[rint($val12*$val11)]
replytype1=default
replyname1=$val8
replygood1=$val13
replytype2=default
replyname2=$val9
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val10 $(val7[2]) $val11 fois $(val7[3]) $val12 $(val7[4]), $(val7[5]) \end{statement} 


!goto stat

!exit

