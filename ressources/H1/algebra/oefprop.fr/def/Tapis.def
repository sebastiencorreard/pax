!endif
!if $val6=nl 
val7=monte,baisse
tmp=!trim De prijs van een tapijt was ,euros ein november	  met een,van, in decembe	  en een,van, in januari
val8=!translate internal $	\
$ to ;; in $tmp
val9=Wat is de nieuwe prijs
val10=De nieuw prijs is
