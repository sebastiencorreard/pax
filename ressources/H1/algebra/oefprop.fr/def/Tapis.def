val12=euros
!endif
tmp0=!randitem 20,25,30,35,40,45,50,55,60

val13=$[rint($(tmp0)*10)]
tmp0=!randint 10, 40

val14=$[rint($(tmp0))]
tmp0=!randitem 1,2

val15=$[rint($(tmp0))]
tmp0=!item $val15 of $val7

val16=$(tmp0)
tmp0=!item $val15 of $(val7[2,1])

val17=$(tmp0)
choicename1=$val10
choicegood1=$(val11[1]) $val13 $val12
choicebad1=$(val11[2]) $val13 $val12, $(val11[3])
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val8[1;1]) $val13 $(val8[1;2]), $(val8[2;1]) $val16 $(val8[2;2]) $val14 \% $(val8[2;3]), $(val8[3;1]) $val17 $(val8[3;2]) $val14 \% $(val8[3;3]). <p>$val9?</p> \end{statement} 


