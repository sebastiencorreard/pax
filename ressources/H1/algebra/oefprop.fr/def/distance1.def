!set title=Distance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@tele2.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
precision=10000
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
title_en=TITRE_en
title_nl=Distance
title_es=Distance

ansorder=r,r,r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Le voyage a duré 
val9=Durée en min,Distance en km
val10=La distance parcourue est de
!if $val6=en 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Le voyage a duré 
val9=Durée en min,Distance en km
val10=La distance parcourue est de
!endif
!if $val6=es 
tmp=!trim Complete la tabla	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Un vehículo circula a una velocidad media de,	  El viaje ha durado 
val9=Duración en min,Distancia en km
val10=La distancia recurrida es de
!endif
!if $val6=nl 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Le voyage a duré 
val9=Durée en min,Distance en km
val10=La distance parcourue est de
!endif
tmp0=!randint 70, 180

val11=$[rint($(tmp0))]
tmp0=!randint 85, 165

val12=$[rint($(tmp0))]
val13=$[$val12*6/10]
val14=$[rint(floor($val11/60))]
val15=$[rint($val11-60*$val14)]
val16=$[$val11*$val12/100]
val17=$[rint(60)]
replytype1=numeric
replyname1=
replygood1=$[$val17]
replytype2=numeric
replyname2=
replygood2=$[$val11]
replytype3=numeric
replyname3=
replygood3=$[$val16]
replytype4=numeric
replyname4=
replygood4=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val13 
!insmath \textrm{km/h}
$().	$(val8[2]) $val14 
!insmath \textrm{h}
$() $val15 
!insmath \textrm{min}
$().	<p>	$(val7[1;]) ($(val7[2;])) :</p>	<table class="wimscenter wimsborder">	<tr><th>$(val9[1])</th><td> 
!read oef/embed.phtml reply 1 
$()</td><td> 
!read oef/embed.phtml reply 2 
$()</td></tr>	<tr><th>$(val9[2])</th><td>$val13</td><td> 
!read oef/embed.phtml reply 3 
$()</td></tr>	</table>	<div><label for="reply4">$val10</label>  
!read oef/embed.phtml reply 4 
$() 
!insmath km
$().</div>	
$()
!exit

