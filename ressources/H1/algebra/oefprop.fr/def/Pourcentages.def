!set title=Pourcentages
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, Xiao
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Percentages
title_nl=Percentages
title_es=Porcentajes

ansorder=r,r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Parmi les,élèves du collège	font de l'allemand	font de l'espagnol
val7=!translate internal $	\
$ to ;; in $tmp
val8=Combien sont-ils
val9=Quel pourcentage cela représente-t-il
val10=Nombre d'élèves
val11=Pourcentage
!if $val6=en 
tmp=!trim Parmi les,élèves du collège	font de l'allemand	font de l'espagnol
val7=!translate internal $	\
$ to ;; in $tmp
val8=Combien sont-ils
val9=Quel pourcentage cela représente-t-il
val10=Nombre d'élèves
val11=Pourcentage
!endif
!if $val6=es 
tmp=!trim Entre los,alumnos del instituto	  dan alemán.	  dan español.
val7=!translate internal $	\
$ to ;; in $tmp
val8=¿Cuántos son
val9=¿Qué porcentaje representan
val10=Número de alumnos
val11=Porcentaje
!endif
!if $val6=nl 
tmp=!trim Van de,leerlingen in de onderbouw doen er	  Duits.	doen er Spaans
val7=!translate internal $	\
$ to ;; in $tmp
val8=Hoeveel zijn dat er
val9=Hoeveel percent zijn dat er
val10=Aantal leerlingen
val11=Perrcentage
!endif
tmp0=!randint 800, 950

val12=$[rint($(tmp0))]
tmp0=!randint 100, 290

val13=$[rint($(tmp0))]
val14=$[round(($val13/$val12)*1000)/10]
tmp0=!randint 200, 400

val15=$[rint($(tmp0))]
val16=$[round(($val15/$val12)*10000)/100]
replytype1=default
replyname1=$val10
replygood1=$val13
replytype2=default
replyname2=$val11
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} \begin{itemize} \item $(val7[1;1]) $val12 $(val7[1;2]), $val14\% $(val7[2;]). $val8? \item $val15 $(val7[3;]). $val9? \end{itemize} \end{statement} 


!goto stat

!exit

:question
$()<p>	$(val7[1;1]) $val12 $(val7[1;2]), $val14% $(val7[2;]).	$val8?</p>	<p>$val15 $(val7[3;]).	$val9?</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $m_begin{itemize} $m_item $(val7[1;1]) $val12 $(val7[1;2]), $val14\% $(val7[2;]). $val8? $m_item $val15 $(val7[3;]). $val9? $m_end{itemize} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,12,14,15
embedcnt=0
