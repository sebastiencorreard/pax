!set title=Échelle I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, Xiao
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
precision=10000
title_en=Échelle I
title_nl=Schaal I
title_es=Escala

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Une carte routière est à l'échelle
val8=Quelle distance réelle (en \(\textrm{km}\)) représente, sur la carte&nbsp;
val9=Distance réelle (en \(\textrm{km}\))
!if $val6=en 
val7=Une carte routière est à l'échelle
val8=Quelle distance réelle (en \(\textrm{km}\)) représente, sur la carte&nbsp;
val9=Distance réelle (en \(\textrm{km}\))
!endif
!if $val6=es 
val7=Un mapa de carreteras está en la escala
val8=¿Qué distancia real (en \(\textrm{km}\)) représenta, en el mapa
val9=Distancia real (en \(\textrm{km}\))
!endif
!if $val6=nl 
val7=Een plattegrond is op schaal
val8=Wat is de werkelijke afstand (in \(\textrm{km}\)) die, op de kaart voorstelt
val9=Werkelijke afstand (in \(\textrm{km}\))
!endif
tmp0=!randitem 15,20,25,50,100,200,250,500

val10=$[rint($(tmp0)*1000)]
tmp0=!randint 3, 15

val11=$[rint($(tmp0))]
val12=$[($val11*$val10)/100000]
replytype1=default
replyname1=$val9
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val7 1/$val10. $(val8[1]) $val11 \(\textrm{cm}\) $(val8[2])? \end{statement} 


!goto stat

!exit

:question
$()$val7 1/$val10. $(val8[1]) $val11 
!insmath \textrm{cm}
$() $(val8[2]) ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val7 1/$val10. $(val8[1]) $val11 
!insmath \textrm{cm}
$() $(val8[2])? $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11
embedcnt=0
