!endif
!if $val6=es 
val7=J'ai acheté un lecteur de CD. J'ai payé,	  euros avec, CD qui valent chacun, euros.
val8=Quel est le prix du lecteur&nbsp;
val9=Prix (en euros)
!endif
!if $val6=nl 
val7=Ik heb een cdrom-lezer gekocht. Voor de lezer plus,	  cdroms die ieder,euro kosten heb ik , euro betaald.
val8=Wat is de prijs van de cdrom-lezer
val9=Prijs (in euros)
!endif
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
tmp0=!randint 10, 25

val11=$[rint($(tmp0))]
tmp0=!randint 25, 60

val12=$[rint($(tmp0))]
val13=$[rint(($val10*$val11)+$val12)]
replytype1=numexp
replyname1=$val9
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val13 $(val7[2]) $val10 $(val7[3]) $val11 $(val7[4]) \par $val8? \end{statement} 


!goto stat

!exit

