!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=J'ai acheté un lecteur de CD. J'ai payé,	  euros avec, CD qui valent chacun, euros.
val8=Quel est le prix du lecteur&nbsp;
val9=Prix (en euros)
!if $val6=en 
val7=I have bought a CD rom driver. I have paid,	  dollars with, CD roms which cost, dollars each.
