!set title=Temps de parcours
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu, Xiao
email=xiao@unice.fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
precision=10000
title_en=Temps de parcours
title_nl=Temps de parcours.
title_es=Tiempo de recorrido

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim En voiture, j'ai parcouru	  en roulant à la vitesse moyenne de
val7=!translate internal $	\
$ to ;; in $tmp
val8=Pendant combien de minutes ai-je roulé&nbsp;
val9=Temps en
!if $val6=en 
tmp=!trim En voiture, j'ai parcouru	  en roulant à la vitesse moyenne de
val7=!translate internal $	\
$ to ;; in $tmp
val8=Pendant combien de minutes ai-je roulé&nbsp;
val9=Temps en
!endif
!if $val6=es 
tmp=!trim En coche, he recorrido	   circulando a la velocidad media de
val7=!translate internal $	\
$ to ;; in $tmp
val8=¿Durante cuántos minutos he circulado
val9=Tiempo en
!endif
!if $val6=nl 
tmp=!trim Ik heb met de auto	  afgelegd met een gemiddelde snelheid van
val7=!translate internal $	\
$ to ;; in $tmp
val8=Hoeveel minuten heb ik gereden
val9=Tijd in
!endif
tmp0=!randitem 60,66,72,84,90,96,102,108,114,120

val10=$[rint($(tmp0))]
tmp0=!randitem 62,70,80,92,100,110

val11=$[rint($(tmp0))]
val12=$[rint($val11*$val10/60)]
replytype1=default
replyname1=$val9 \(\textrm{min}\)
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1;]) $val12 \(\textrm{km}\) $(val7[2;]) $val11 \(\textrm{km/h}\). <p>$val8?</p> \end{statement} 


!goto stat

!exit

:question
$()$(val7[1;]) $val12 
!insmath \textrm{km}
$() $(val7[2;]) $val11 
!insmath \textrm{km/h}
$().	<p>$val8?</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1;]) $val12 
!insmath \textrm{km}
$() $(val7[2;]) $val11 
!insmath \textrm{km/h}
$(). <p>$val8?</p> $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11,12
embedcnt=0
