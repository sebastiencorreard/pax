!set title=Durée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@tele2.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
leftrange=-5.000000
rightrange=5.000000
computeanswer=yes
computeanswer=yes
precision=10000
title_en=TITRE_en
title_nl=Durée
title_es=Duración1

ansorder=r,r,r,r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Elle a parcouru une distance de
val9=Durée en min,Distance en
val10=La durée du parcours est de
val11=Si je convertis en heures et minutes
!if $val6=en 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Elle a parcouru une distance de
val9=Durée en,Distance en
val10=La durée du parcours est de
val11=Si je convertis en heures et minutes
!endif
!if $val6=es 
tmp=!trim Complete la tabla	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Un vehículo circula a una velocidad media de,	  Ha recorrido una distancia de
val9=Duración en,Distancia en
val10=La duración del recorrido es de
val11=Si lo convertimos en horas y minutos
!endif
!if $val6=nl 
tmp=!trim Remplir le tableau de proportionalité	  l'une des cases doit contenir le résultat final
val7=!translate internal $	\
$ to ;; in $tmp
val8=Une voiture roule à une vitesse moyenne de,	  Elle a parcouru une distance de
val9=Durée en min,Distance en
val10=La durée du parcours est de
val11=Si je convertis en heures et minutes
!endif
tmp0=!randint 70, 180

val12=$[rint($(tmp0))]
tmp0=!randint 85, 165

val13=$[rint($(tmp0))]
val14=$[$val13*6/10]
val15=$[rint(floor($val12/60))]
val16=$[rint($val12-60*$val15)]
val17=$[$val12*$val13/100]
val18=$[rint(60)]
replytype1=numeric
replyname1=
replygood1=$[$val18]
replytype2=numeric
replyname2=
replygood2=$[$val12]
replytype3=numeric
replyname3=
replygood3=$[$val17]
replytype4=numeric
replyname4=
replygood4=$[$val12]
replytype5=numeric
replyname5=
replygood5=$[$val15]
replytype6=numeric
replyname6=
replygood6=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val8[1]) $val14 
!insmath \textrm{km/h}
$().	$(val8[2]) $val17 
!insmath \textrm{km}
$().	<p>$(val7[1;]) ($(val7[2;])) :</p>	<table class="wimscenter wimsborder">	<tr><th>$(val9[1]) min</th><td> 
!read oef/embed.phtml reply 1 
$()</td><td> 
!read oef/embed.phtml reply 2 
$()</td></tr>	<tr><th>$(val9[2]) 
!insmath \textrm{km}
$()</th><td>$val14</td><td> 
!read oef/embed.phtml reply 3 
$()</td></tr>	</table>	<ul><li><label for="reply4">$val10</label>  
!read oef/embed.phtml reply 4,4 
$() 
!insmath \textrm{min}
$().	</li><li>	$val11:  
!read oef/embed.phtml reply 5,4 
$() 
!insmath \textrm{h}
$()  
!read oef/embed.phtml reply 6,4 
$() 
!insmath \textrm{min}
$().	</li></ul>	
$()
!exit

