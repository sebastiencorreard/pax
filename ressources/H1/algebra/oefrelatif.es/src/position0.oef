\title{¿A la derecha o la la izquierda de 0? }
\language{es}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{A= randint(1..7)}
\text{liste=derecha, izquierda}
\text{choix=random(1,2)}
\text{droite=item(\choix,\liste)}
\text{absc=\choix=1? \A:-\A}

\statement{El punto \(A) tiene de abscisa +\A o -\A. Ahora bien, está a la \droite de 0. ¿Cuál es su abscisa? 
}
\answer{Su abscisa es}{\absc}{type=number}
