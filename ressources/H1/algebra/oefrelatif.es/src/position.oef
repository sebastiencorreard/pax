\title{¿A derecha o izquierda de un punto?}
\language{es}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{A= random(1,-1)*randint(1..7)}
\text{A=\A>0 ? +\A}
\integer{B= randint(abs(\A)+1..11)}
\text{liste=derecha, izquierda}
\text{choix=random(1,2)}
\text{droite=item(\choix,\liste)}
\integer{absc=\choix=1 and \B>\A? \B}
\integer{absc=\choix=1 and \B<\A? -\B}
\integer{absc=\choix=2 and \B>\A? -\B}
\integer{absc=\choix=1 and \B<\A? \B}
\text{absc=\absc>0? +\absc}
\statement{El punto \(B) tiene de abscisa +\B o -\B. Ahora bien, está a la \droite de \(A) que tiene de abscisa \A. ¿Cuál es su abscisa? 
}
\answer{Su abscisa es}{\absc}{type=number}
