\integer{m=6}

 \title{Axe gradué et fractions irréductibles}
 \integer{m1=0}
 \integer{signe=1}

!! je crois que la notion de fraction irréductible n'est vue dans toute sa généralité qu'en troisième
 \text{consigne=<b>Consigne</b>. La fraction doit être présentée sous la forme la plus simple possible (fraction irréductible). }

\language{fr}
\author{Bernadette, Perrin-Riou; Paul, Byache}
\email{paul.byache@ac-aix-marseille.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\text{a=0}
\text{dessin=}
\for{i=\m1 to \m}{
\integer{a=\i*1}
\integer{s=\i}
\text{dessin=\dessin
text blue, \s,-1, medium,\a}}

!pour avoir plus de chance de tomber sur une fraction réductible
\integer{den=randitem(4,6,9,10)}
\integer{num=randint( 4..20)}

\rational{a=\signe*\num/\den}
\text{nd=pari([numerator(\a),denominator(\a)])}

\text{name_enonce=Voici la droite graduée. Le point indiqué par la flèche sur la droite graduée
  a comme abscisse le quotient de deux entiers. Il s'agit de}
\text{dessin=xrange \m1-0.1,\m+0.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,\m,0,10,black
parallel \m1,-0.3,\m1,0.3,1/\den,0, 200, blue
parallel \m1,-0.8,\m1,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black}
!supprimé pour plus de lisibilité:
!!!!!!!!!!!!!!parallel \m1,-0.8,\m1,0.4,1/2,0, 40, blue
\text{dessintikz=drawtikz(600,70
\dessin)}
\statement{\name_enonce
<table class="wimscenter wimsnoborder">
<tr><td>\embed{reply 1,2
autocomplete="off"}</td></tr>
<tr><td><hr></td></tr>
<tr><td>\embed{reply 2,2
autocomplete="off"}</td></tr>
</table>
<div class="wimscenter">\draw{600,50}
{\dessin}
</div>
<div class="wims_instruction">
\consigne
</div>
}
\answer{numérateur}{\nd[1]}{type=numeric}
\answer{dénominateur}{\nd[2]}{type=numeric}
\real{test1=\reply1/\reply2-\a}
\feedback{\test1=0 and \reply1<>\nd[1]}{
<i>Vous n'avez pas simplifié la fraction.</i>}

\latex{
\begin{statement}
\name_enonce
\begin{center}
\LARGE
\(\frac{\cdots}{\cdots}\)
\end{center}
\begin{center}
\dessintikz
\end{center}
\consigne
\end{statement}
}
