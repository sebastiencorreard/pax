\computeanswer{no}
\format{html}
\precision{10000}


 \title{Dénominateur ou numérateur manquant}
 \integer{fill=random(1,2,3,4)}
 \text{name=item(\fill,numérateur,dénominateur,numérateur,dénominateur)}
\integer{mul=randint(2..11)}
\text{f1=randint(1..10)}
\text{f2=randint(1..10)}
\text{f2= (\f2=1 and \fill=2) ? 7 : \f2}
\integer{f3=\f1*\mul}
\integer{f4=\f2*\mul}

\text{rep=item(\fill,\f1,\f2,\f3,\f4)}
\text{hr=<hr>}
\text{fw=60}
\text{big1=<span class="larger">}
\text{big2=</span>}
\text{size=2}
\text{name_enonce=Remplissez le \name ci-dessous pour établir l'égalité&nbsp;:}
\statement{\name_answer:
<table class="wimscenter wimsnoborder">
<tr>
\if{\f2=1}{
<td rowspan="3">\big1
\if{\fill=1}{\embed{reply 1,\size
autocomplete="off"}}{\f1}\big2</td>}{
<td>\big1
\if{\fill=1}{\embed{reply 1,\size
autocomplete=off}}{\f1}\big2</td>}
<td rowspan="3">\big1&nbsp;&nbsp;=&nbsp;&nbsp;\big2</td>
<td>\big1
\if{\fill=3}{\embed{reply 1,\size
autocomplete="off"}}{\f3}\big2</td>
</tr><tr>
<td>\hr</td>
\if{\f2<>1}{<td>\hr</td>}
</tr><tr>
\if{\f2<>1}{<td>\big1
\if{\fill=2}{\embed{reply 1,\size
autocomplete="off"}}{\f2}\big2</td>}
<td>\big1
\if{\fill=4}{\embed{reply 1,\size
autocomplete=off}}{\f4}\big2</td>
</tr></table>
}
\answer{Le \name}{\rep}{type=numeric}
\latex{

\begin{statement}
\name_enonce
\par
\LARGE
\begin{center}
\ifnum\fill=1

\(\frac{\cdots}{\f2}=\frac{\f3}{\f4}\)

\fi

\ifnum\fill=2
\(\frac{\f1}{\cdots}=\frac{\f3}{\f4}\)
\fi

\ifnum\fill=3

\(\frac{\f1}{\f2}=\frac{\cdots}{\f4}\)
\fi

\ifnum\fill=4
\(\frac{\f1}{\f2}=\frac{\f3}{\cdots}\)
\fi
\end{center}
\end{statement}
