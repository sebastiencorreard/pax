\title{Simplification (apprentissage)}
\language{fr}
\precision{10000}
\author{Bernadette, Perrin-Riou;Paul,Byache}
\email{paul.byache@ac-aix-marseille.fr}
\computeanswer{no}
\format{html}

\text{dessin=}
\for{i=0 to 6}{
\integer{a=\i}
\text{dessin=\dessin
text blue, \a,-1, medium,\a}}

\integer{x=randint(2,3)}
\integer{den= \x=2? randitem(4,6,10):randitem(6,9)}
\integer{num= \x=2? randitem(2,14,22):randitem(3,15,21,33)}

\rational{a=\num/\den}
\integer{nums=\num/\x}
\integer{dens=\den/\x}

\text{dessin2=}
\for{i=1 to \nums}{
\real{b=(\i-0.5)/\dens}
\text{dessin2=\dessin2
arc \b,0,1/\dens,2,0,180,red}}

\text{dessin=xrange -0.1,6.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,6.1,0,10,black
parallel 0,-0.3,0,0.3,1/\den,0, 200, blue
parallel 0,-0.8,0,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black
}
\text{name_enonce1=Voici la droite graduée.
  Le point indiqué par la flèche sur la droite graduée
  a comme abscisse la fraction}
\text{name_enonce2=Simplifie cette fraction}

\text{dessintikz=drawtikz(600,70
\dessin)}

\statement{\name_enonce1 \((\num)/(\den)\). \name_enonce2:
<table class="wimscenter wimsnoborder">
<tr><td></td><td>\embed{reply 1,6
autocomplete="off"}</td></tr>
<tr><td>La fraction simplifiée est :</td><td><hr></td></tr>
<tr><td></td><td>\embed{reply 2,6
autocomplete="off"}</td></tr>
</table>
<div class="wimscenter">
\draw{600,50}{\dessin}
</div>
}

\answer{numérateur}{\nums}{type=numeric}
\answer{dénominateur}{\dens}{type=numeric}

\hint{Regrouper par \x
les intervalles entre deux graduations, comme ceci :
<div class="wimscenter">
\draw{600,50}
{xrange -0.1,6.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,6.1,0,10,black

parallel 0,-0.3,0,0.3,1/\den,0, 200, blue

parallel 0,-0.8,0,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black
\dessin2
}
</div>}

\solution{<b>Solution :</b>
Pour trouver la fraction simplifiée \((\nums)/(\dens)\),
on pouvait <b>diviser au numérateur et au dénominateur de \((\num)/(\den)\) par \x.</b>
<p>
Sur la droite graduée, cela correspond à regrouper par \x
les intervalles entre deux graduations, comme ceci :
</p>
<div class="wimscenter">
\draw{600,50}
{xrange -0.1,6.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,6.1,0,10,black

parallel 0,-0.3,0,0.3,1/\den,0, 200, blue

parallel 0,-0.8,0,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black
\dessin2
}
</div>}
\latex{
\begin{statement}
\name_enonce1 \(\frac{\num}{\den}\). \name_enonce2:
\LARGE
\begin{center}
\(\frac{\cdots}{\cdots}\)
\end{center}
\begin{center}
\dessintikz
\end{center}
\end{statement}}
