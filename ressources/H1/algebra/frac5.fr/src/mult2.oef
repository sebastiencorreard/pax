\title{Multiplication en écriture fractionnaire}
\language{fr}
\author{Paul, Byache}
\email{paul.byache@ac-aix-marseille.fr}
\precision{10000}

\real{a=randint(0..20)*random(1,10,0.1,100,0.01)}
\real{b=randint(1..20)*random(1,10,0.1,100,0.01)}
\real{c=randint(0..20)*random(1,10,0.1,100,0.01)}
\real{d=randint(1..20)*random(1,10,0.1,100,0.01)}

\real{num=\a*\c}
\real{den=\b*\d}
\text{name_enonce=Compléter le calcul suivant:}
\statement{ \name_enonce
<table class="wimscenter wimsnoborder">
<tr><td>\a</td><td></td><td>\c</td><td></td><td>\embed{reply 1,6
autocomplete="off"}</td></tr>
<tr><td><hr></td><td>&times;</td><td><hr></td><td>=</td><td><hr></td></tr>
<tr><td>\b</td><td></td><td>\d</td><td></td><td>\embed{reply 2,6
autocomplete="off"}</td></tr>
</table>

}

\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}

\condition{La réponse est-elle bonne ? }{\a*\c*\rep2=\b*\d*\rep1}
\condition{Le numérateur est-il bien calculé ?}{\a*\c*\rep2=\b*\d*\rep1 or \a*\c=\rep1}
\condition{Le dénominateur est-il bien calculé ?}{(\a*\c*\rep2=\b*\d*\rep1 and \num!=0) or \rep2=\b*\d}

\solution{La bonne réponse (non simplifiée) était : \((\num) / (\den))}

\latex{
\begin{statement}
\name_enonce
\par
\begin{center}
\LARGE
\(\frac{\a}{\b}\times \frac{\c}{\d}=\frac{\cdots}{\cdots}\)
\end{center}
\end{statement}
}
