\title{Lire une fraction sur un axe}

\language{fr}
\author{Bernadette, Perrin-Riou;Paul, Byache}
\email{paul.byache@ac-aix-marseille.fr}
\computeanswer{no}
\format{html}

\integer{m=6}
\integer{m1=0}

\text{dessin=}
\for{i=0 to 6}{
\text{dessin=\dessin
text blue, \i,-1, medium,\i}}

\integer{den=randitem(4,6,9,10)}
\integer{num=randint( 4..20)}
\rational{a=\num/\den}
\text{plus=\a notsametext \num/\den ? (ou \(\a\) sous forme simplifiée). : .}

\text{dessin2=}
\for{i=1 to \num}{
\real{b=(\i-0.5)/\den}
\text{dessin2=\dessin2
arc \b,0,1/\den,2,0,180,red}}

\text{dessin=xrange \m1-0.1,\m+0.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,\m,0,10,black
parallel \m1,-0.3,\m1,0.3,1/\den,0, 200, blue
parallel \m1,-0.8,\m1,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black}
\text{name_enonce=Voici la droite graduée. Le point indiqué par
  la flèche sur la droite graduée
  a comme abscisse le quotient de deux entiers. Il s'agit de}

\text{dessintikz=drawtikz(600,70
\dessin)}

\statement{\name_enonce
<table class="wimscenter wimsnoborder">
<tr><td>\embed{reply 1,3
autocomplete="off"}</td></tr>
<tr><td><hr></td></tr>
<tr><td>\embed{reply 2,3
autocomplete="off"}</td></tr>
</table>
<div class="wimscenter">\draw{600,50}
{\dessin}
</div>
<div class="wims_instruction">
</div>
}

\answer{numérateur}{\nd1}{type=numeric}
\answer{dénominateur}{\nd2}{type=numeric}
\condition{Votre réponse est-elle correcte ?}{\reply1=\reply2*\a}


\solution{<b>Solution :</b>
Pour trouver la fraction représentée, on peut remarquer que les unités sont partagées en \den parties égales et que de l'origine 
jusqu'au point indiqué, il y a \num parties : 
<div class="wimscenter">
\draw{600,50}
{xrange -0.1,6.1
yrange -2,2.2
hline black,0,0
arrow 2.5,0,6.1,0,10,black

parallel 0,-0.3,0,0.3,1/\den,0, 200, blue

parallel 0,-0.8,0,0.6,1,0, 40, red
\dessin
arrow \a,2,\a,0, 8, black
\dessin2
}
</div>La solution est donc \(\num\over\den\) \plus}

\latex{
\begin{statement}
\name_enonce
\LARGE
\(\frac{\cdots}{\cdots}\)
\begin{center}
\dessintikz
\end{center}
\end{statement}

}
