\language{fr}
\author{Paul, Byache}
\email{paul.byache@ac-aix-marseille.fr}
\computeanswer{no}
\format{html}
\precision{10000}


 \title{Simplifier une fraction}

\integer{mul=randint(2..11)}
\integer{f1=randint(1..10)}
\integer{f2=randint(1..10)}
\integer{f=pari(gcd(\f1,\f2))}
\integer{f3=\f1*\mul}
\integer{f4=\f2*\mul}

\if{\f1=\f2}{
\integer{f=\f1}
}
\integer{f1=\f1/\f}
\integer{f2=\f2/\f}

\text{hr=<hr>}
\text{big1=<span class="larger">}
\text{big2=</span>}
\text{size=2}
\text{name_enonce=Simplifier le plus possible la fraction&nbsp;}
\statement{\name_enonce:
<table class="wimscenter wimsnoborder">
<tr>
<td>\big1 \f3 \big2</td>
<td rowspan="3">\big1=\big2</td>
<td>\big1 \embed{reply 1,\size} \big2</td>
</tr><tr>
<td>\hr</td>
<td>\hr</td>
</tr><tr>
<td>\big1 \f4 \big2 </td>
<td>\big1 \embed{reply 2,\size
autocomplete="off"}\big2</td>
</tr></table>
}
\answer{}{\f1}{type=numeric}
\answer{}{\f2}{type=numeric}

\latex{
\begin{statement}
\name_enonce
\LARGE
\begin{center}
\(\frac{\f3}{\f4} = \frac{\cdots}{\cdots}\)
\end{center}
\end{statement}
}


