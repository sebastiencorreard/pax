\title{Mult. de fractions (avec simplification)}
\language{fr}
\author{Paul, Byache}
\email{paul.byache@ac-aix-marseille.fr}

\real{a=randint(1..10)}
\real{b=randint(1..10)}
\real{c=randint(1..20)}
\real{d=randint(1..20)}
\integer{test=\a*\c/\b*\d}
\real{test2=\a*\c/\b*\d}
\integer{b= \test=\test2 or \test2=1 ? randint(2..10) : \b}
\integer{d= \test=\test2 or \test2=1 ? randint(2..20) : \d}
\integer{a= \test=\test2 or \test2=1 ? randint(1..\b-1) : \a}
\integer{c= \test=\test2 or \test2=1 ? randint(1..\d-1) : \c}

\real{num=\a*\c}
\real{den=\b*\d}
\text{sol=maxima(\num/\den)}
\text{sol1=wims( replace internal / by , in \sol)}
\integer{sol2=\num / \sol1[1]}
\text{sol3=\sol2=1 ? :<p>Pour obtenir cette réponse, il fallait simplifier
par \sol2 (plusieurs méthodes étaient sans doute possibles).</p>}
\text{name_enonce=Compléter le calcul suivant en donnant la réponse sous forme
  de fraction simplifiée le plus possible}
\statement{\name_enonce:
<table class="wimscenter wimsnoborder">
<tr><td>\a</td><td></td><td>\c</td><td></td><td>\embed{reply 1,3
autocomplete="off"}</td></tr>
<tr><td><hr></td><td>&times;</td><td><hr></td><td>=</td><td><hr></td></tr>
<tr><td>\b</td><td></td><td>\d</td><td></td><td>\embed{reply 2,3
autocomplete="off"}</td></tr>
</table>
}

\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}


\condition{La réponse est-elle bonne ? }{\a*\c*\rep2=\b*\d*\rep1}
\condition{La bonne réponse était-elle simplifiée ?}{\rep1/\rep2 issametext \sol}

\solution{La bonne réponse (simplifiée le plus possible) était : \(\frac{\sol1[1]}{\sol1[2]}\)
\sol3}

\latex{
\begin{statement}
\name_enonce
\par
\begin{center}
\LARGE
\(\frac{\a}{\b}\times \frac{\c}{\d}=\frac{\cdots}{\cdots}\)
\end{center}
\end{statement}
}
