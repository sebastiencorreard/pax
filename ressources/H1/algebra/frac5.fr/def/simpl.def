!set title=Simplifier une fraction
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul.byache@ac-aix-marseille.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 11

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
t_=!replace internal \( by ( in gcd($val7,$val8)
tmp0=!exec pari $t_

val9=$[rint($(tmp0))]
val10=$[rint($val7*$val6)]
val11=$[rint($val8*$val6)]
!if $val7=$val8 
val9=$[rint($val7)]
!endif
val7=$[rint($val7/$val9)]
val8=$[rint($val8/$val9)]
val12=<hr>
val13=<span class="larger">
val14=</span>
val15=2
val16=Simplifier le plus possible la fraction&nbsp;
replytype1=numeric
replyname1=
replygood1=$[$val7]
replytype2=numeric
replyname2=
replygood2=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val16 \LARGE \begin{center} \(\frac{$val10}{$val11} = \frac{\cdots}{\cdots}\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()$val16:	<table class="wimscenter wimsnoborder">	<tr>	<td>$val13 $val10 $val14</td>	<td rowspan="3">$val13=$val14</td>	<td>$val13  
!read oef/embed.phtml reply 1,$val15 
$() $val14</td>	</tr><tr>	<td>$val12</td>	<td>$val12</td>	</tr><tr>	<td>$val13 $val11 $val14 </td>	<td>$val13  
!read oef/embed.phtml reply 2,$val15	autocomplete="off" 
$()$val14</td>	</tr></table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val16 $m_LARGE $m_begin{center} 
!insmath \frac{$val10}{$val11} = \frac{\cdots}{\cdots}
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14,15,16
embedcnt=2
