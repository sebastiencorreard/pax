!set title=Axe gradué et fractions irréductibles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou; Paul, Byache
email=paul.byache@ac-aix-marseille.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=19
prevarcnt=17
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(6)]
val7=$[rint(0)]
val8=$[rint(1)]
val9=<b>Consigne</b>. La fraction doit être présentée sous la forme la plus simple possible (fraction irréductible). 
val10=0
val11=
!for val12 =$val7 to $val6 
val10=$[rint($val12*1)]
val13=$[rint($val12)]
val11=$val11	text blue, $val13,-1, medium,$val10
!next
tmp=!nonempty items 4,6,9,10

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
tmp0=!randint  4, 20

val15=$[rint($(tmp0))]
t_=!rawmath $val8*$val15/$val14
val10=!exec pari print($t_)
t_=!replace internal \( by ( in [numerator($val10),denominator($val10)]
tmp0=!exec pari $t_

val16=$(tmp0)
val17=Voici la droite graduée. Le point indiqué par la flèche sur la droite graduée	  a comme abscisse le quotient de deux entiers. Il s'agit de
val11=xrange $val7-0.1,$val6+0.1	yrange -2,2.2	hline black,0,0	arrow 2.5,0,$val6,0,10,black	parallel $val7,-0.3,$val7,0.3,1/$val14,0, 200, blue	parallel $val7,-0.8,$val7,0.6,1,0, 40, red	$val11	arrow $val10,2,$val10,0, 8, black
!readproc oef/drawtikz.phtml 600,70 \
$val11 
tmp0=$ins_tikz
val18=$(tmp0)
replytype1=numeric
replyname1=numérateur
replygood1=$[$(val16[1])]
replytype2=numeric
replyname2=dénominateur
replygood2=$[$(val16[2])]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \begin{center} \LARGE \(\frac{\cdots}{\cdots}\) \end{center} \begin{center} $val18 \end{center} $val9 \end{statement} 


!goto stat

!exit

:question
$()$val17	<table class="wimscenter wimsnoborder">	<tr><td> 
!read oef/embed.phtml reply 1,2	autocomplete="off" 
$()</td></tr>	<tr><td><hr></td></tr>	<tr><td> 
!read oef/embed.phtml reply 2,2	autocomplete="off" 
$()</td></tr>	</table>	<div class="wimscenter"> 
!read oef/draw.phtml 600,50 \
$val11 
$()	</div>	<div class="wims_instruction">	$val9	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_begin{center} $m_LARGE 
!insmath \frac{\cdots}{\cdots}
$() $m_end{center} $m_begin{center} $val18 $m_end{center} $val9 $m_end{statement} 
$()
!exit

:postdef
val19=$[$m_reply1/$m_reply2-$val10]

!exit

:feedback
!ifval $val19=0 and $m_reply1<>$(val16[1])
 <div class='oef_feedbacks'>	<i>Vous n'avez pas simplifié la fraction.</i>
$()</div>
!endif

!exit

:test

!exit

:stat
