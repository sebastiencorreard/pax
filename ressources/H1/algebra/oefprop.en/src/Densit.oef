\title{Density}
\language{en}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{The population density of a country is 
\d inhabitants/km<sup>2</sup>.
Its population is \p millions.
What is its area (in thousands of km<sup>2</sup>)?}


\answer{Area}{\s}{type=default}
