\title{Weights}
\language{en}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\c=random(8,10)}
\integer{\s=random(4,5)}
\integer{\p=random(8..12)}
\real{\v=\p/\c}
\integer{\t=\p*\s}
\statement{A truck is \c times heavier than a car, while the truck is
\s times lighter than a tank. Knowing that the truck weighs \p tons,
compute the weights of a car and of a tank (in tons).}


\answer{Weight of a car}{\v}{type=default}
\answer{Weight of a tank}{\t}{type=default}



