\title{Solving Percents using Proportions I}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{b=(100*\a/\p)}
\integer{h=\a*100}

\statement{<center>\a is \p percent of what number (to the nearest hundredth)?</center>}

\hint{Is/Of = Percent/100
<p>Substitute \a for  Is  and \p for  Percent 
<p>Multiply \a by 100 and divide by \p}
\answer{The number}{\b}


\solution{<center>Is/Of = Percent/100
<p>\a * 100 divided by \p
<p>\h / \p
<p>answer = \b</center>}
