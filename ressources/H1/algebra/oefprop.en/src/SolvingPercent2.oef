\title{Solving Percents using Proportions II}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{b=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{a=(\p*\b/100)}
\integer{h=\p*\b}

\statement{<center>What is \p percent of \b (to the nearest hundredth)?</center>}

\hint{Is/Of = Percent/100
<p>Substitute \b for Of and \p for  Percent 
<p>Multiply \b * \p and divide by 100}
\answer{The number}{\a}


\solution{<center>Is/Of = Percent/100
<p>Is * 100 = Percent * Of
<p>100 * Is = \b * \p
<p>100 * Is = \h
<p>Is = \h / 100
<p>Is = \a</center>}
