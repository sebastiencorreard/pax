\title{Solving proportions (level 2)}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-8,-6,-4,-2,2,4,6,8)}
\integer{b=random(-9,-7,-5,-3,3,5,7,9)}
\integer{c=\a+\b}
\integer{d=\a*\b}
\integer{e=\d+1}
\integer{f=\e-\c}
\integer{g=(-1)*\a}
\integer{h=(-1)*\b}

\statement{Solve the following proportion.
<p>(enter two solutions)
<p>(x + 1)/x = \f/(x + \d)}

\hint{Cross-products are equal. Set up an equation using the means and extemes, then solve for x.}
\answer{1st answer}{\ans1}
\answer{2nd answer}{\ans2}

\condition{\ans1}{\ans1=\g or \ans1=\h}
\condition{\ans2}{\ans2=\g or \ans2=\h}
\solution{<center>(x + 1)(x + \d) = \f x
<p>x<sup>2</sup> + \e x + \d = \f x
<p>x<sup>2</sup> + \e x - \f x + \d = \f x - \f x
<p>x<sup>2</sup> + \c x + \d = 0
<p>(x + \a)(x + \b) = 0
<p>\g and \h = answers</center>}
