\title{Solving proportions (level 1d)}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(2,3,5,7)}
\integer{c=random(2,3,5,7)}
\integer{b=random(-7,-5,-3,-2,2,3,5,7)}
\integer{d=random(-7,-5,-3,-2,2,3,5,7)}
\integer{e=(\b*\c)}
\integer{f=(\a*\d)}
\integer{g=\a*\b}
\integer{h=\c*\d}
\integer{j=\g*\h}

\statement{<center>Solve for x: x/\g = \h/\e</center>}

\hint{Cross-products are equal. Set up an equation
<p>(\e)x = \g(\h)}
\answer{x}{\f}

