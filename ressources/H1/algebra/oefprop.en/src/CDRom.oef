\title{CD Rom}
\language{en}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\c=random(2..10)}
\integer{\u=random(10..50)}
\integer{\l=random(80..200)}
\integer{\t=(\c*\u)+\l}
\statement{I have bought a CD rom driver. I have paid \t dollars with 
\c CD roms which cost \u dollars each. What is the price of the CD rom driver?
}


\answer{Price (in dollars)}{\l}{type=default}