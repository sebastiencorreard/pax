\title{Solving Percents using Proportions III}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{b=random(1..99)}
\real{p=\a*100/\b}

\integer{h=\a*100}

\statement{<center>\a is what percent of \b (to the nearest hundredth)?</center>}

\hint{Is/Of = Percent/100
<p>Substitute \a for  Is  and \b for Of 
<p>Multiply \a by 100 and divide by \b}
\answer{The number}{\p}


\solution{<center>Is/Of = Percent/100
<p>Is * 100 = Of * Percent
<p>\a * 100 = \b * Percent
<p>\h = \b * Percent
<p>\h / \b = Percent
<p>\p = Percent</center>}
