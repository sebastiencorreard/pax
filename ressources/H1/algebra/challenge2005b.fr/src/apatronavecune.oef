\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
   On réalise un patron du solide ci-contre. Tous les cubes sont identiques. 
   Combien de carrés faut-il utiliser pour construire ce patron ?
   <div class="wimscenter">
     Il faudra \embed{r1,5} cubes.
   </div>
  </div>
  <div class="cell small-12 medium-6 large-4">
    <img alt="Cube" src="\imagedir/cubesaplat.gif">
  </div>
</div>
}

\answer{}{64}{type=number}
