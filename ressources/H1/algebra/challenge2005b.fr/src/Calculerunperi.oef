\title{Calculer un périmètre}
\language{fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{p=54}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    Cette image représente une parcelle de terrain.
    Quel est son périmètre ?<br>
<u><b>Votre réponse </b></u><br>
Son périmètre est de \embed{r1,8} m.
  </div>
  <div class="cell small-12 medium-6 large-4">
    <img alt="parcelle" src="\imagedir/perimetre.gif">
  </div>
</div>}
 
\answer{Vitesse}{\p}{type=number}
