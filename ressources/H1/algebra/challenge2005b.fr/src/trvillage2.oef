\title{Traversée de village II}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\if{random(1,2)=1}{
 \text{nom=slib(lang/fname girl)}
}{
 \text{nom=La maman de slib(lang/fname)}
}
\integer{vit=random(30..40)}
\integer{dur=18*random(5..15)}
\real{len=\dur*\vit/3.6}
\integer{min=floor(\dur/60)}
\integer{sec=\dur-\min*60}

\statement{\nom est une conductrice prudente. Elle traverse un village
de \len mètres de long. La limitation de vitesse est de 50km/h mais il faut
ralentir en quelques occasions et finalement elle traverse ce village en
\min minutes et \sec secondes. Quelle est sa vitesse moyenne ?
<br>
<u><b>Votre réponse </b></u><br>
 \embed{reply 1,3} km/h

}

\answer{Vitesse}{\vit}{type=number}
