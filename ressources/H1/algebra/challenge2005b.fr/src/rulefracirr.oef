\integer{m=6}

 \title{Règle et fractions irréductibles}
 \integer{m1=0}
 \integer{signe=1}
 \text{consigne=La fraction doit être présentée sous forme irréductible. }
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{1000}
\text{a=0}
\text{dessin=}
\for{i=\m1 to \m}{
\integer{a=\i*1}
\integer{s=\i}
\text{dessin=\dessin
text blue, \s,-1, medium,\a}}
\text{den=randitem(2,4,5,3)}
\text{num=randint( 1..10)}
\rational{a=\signe*\num/\den}
\text{nd=pari([numerator(\a),denominator(\a)])}
\text{nd=\nd[2]=1? \nd[1],2}
\statement{ Voici la droite graduée. Le point indiqué par la flèche sur la droite graduée
a comme abscisse le quotient de deux entiers. Il s'agit de
