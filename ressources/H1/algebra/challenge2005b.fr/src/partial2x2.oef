\language{fr}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\format{html}



 \title{Tableau partiel 2x2}


\text{matrix=1,0;0,0}
\text{shr=shuffle(2)}
\text{shc=shuffle(2)}
\text{matrix=wims(lines2rows \matrix[\shr;\shc])}
\text{mlist=wims(replace ; by , in \matrix)}
\text{replylist=wims(positionof item 0 in \mlist)}
\text{givenlist=wims(positionof item 1 in \mlist)}

\text{replies=item(1..(2*2),r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,r16)}
\steps{\replies[\replylist]}



\integer{rows=2}
\integer{cols=2}
\integer{tot=(2*2)}

\integer{confparm3=\confparm3=?1}
\integer{confparm2=\confparm2=?1}
\text{o1=item(\confparm2,1,1,2,2)}
\text{o2=item(\confparm2,1,2,1,2)}
\text{op1=item(\o1,+,*)}
\text{op2=item(\o2,+,*)}
\text{Name1=item(\o1,Somme,Produit)}
\text{Name2=item(\o2,Somme,Produit)}
\text{names=item(\confparm2,la somme indiquée,
        la somme ou le produit indiqué,
        la somme ou le produit indiqué,
        le produit indiqué)}
\text{vars=shuffle(a,b,c,d,r,s,t,x,y,z)}
\text{rt=sqrt(random(2,3,5))}
\text{list=wims(record \confparm3 of src/data)}
\text{nature=row(1,\list)}
\text{parms=row(2,\list)}
\text{obj=\parms[1]}
\text{sizex=\parms[2]}
\text{sizey=\parms[3]}
\text{sizex=\sizex =? 60}
\text{sizey=\sizey=? 35}
\text{size=\sizex \sizey}
\text{list=wims(rows2lines row(3..-1,\list))}
\integer{n=items(\list)}
\if{\n<=3}{
 \text{a=\list[1]}
 \text{b=\list[2]}
 \text{c=\list[3]}
 \text{randtype=computed}
 \if{\c<0}{
  \text{sh1=wims(values \c*x,-(\c)*x for x=\a to \b)}
 }{
  \text{sh1=wims(values \c*x for x=\a to \b)}
 }
 \text{sh=item(1..\tot,shuffle(\sh1))}
}{
 \text{randtype=listed}
 \text{sh=item(1..\tot,shuffle(\list))}
}
\text{sh=wims(mathsubst f=\vars[1] in \sh)}
\text{sh=wims(mathsubst g=\vars[2] in \sh)}
\text{sh=wims(mathsubst rt=\rt in \sh)}
\text{empty=}

\text{goodlist=(\sh[1]),(\sh[2]),(\sh[3]),(\sh[4]),
(\sh[5]),(\sh[6]),(\sh[7]),(\sh[8]),
(\sh[9]),(\sh[10]),(\sh[11]),(\sh[12]),
(\sh[13]),(\sh[14]),(\sh[15]),(\sh[16])}

\text{rowvals=}
\for{x=1 to \rows}{
 \text{r=wims(replace , by \op1 in \goodlist[(\x-1)*\cols+1..\x*\cols])}
 \text{r=maxima(expand(\r))}
 \text{rowvals=wims(append item \r to \rowvals)}
}

\text{colvals=}
\for{y=1 to \cols}{
 \text{c=wims(replace , by \op2 in \goodlist[wims(values \cols*(x-1)+\y for x=1 to \rows)])}
 \text{c=maxima(expand(\c))}
 \text{colvals=wims(append item \c to \colvals)}
}
\statement{<em>\nature</em>.
Remplissez le tableau en tirant dedans les \obj en bas,
de sorte que chaque ligne et chaque colonne donne \names&nbsp;:
<table class="wimscenter wimsborder">
  <tr>
    <td></td>
    \for{cc=1 to 2}{<th>colonne \cc</th>}
    <th>\Name1</th>
  </tr>
  \for{rr=1 to 2}{
    <tr>
      <th>ligne \rr</th>
      \for{cc=1 to 2}{
        <td>
         \if{\mlist[(\rr-1)*\cols+\cc]=1}
          {\(\sh[(\rr-1)*\cols+\cc])}{\embed{\replies[(\rr-1)*\cols+\cc],\size}}
       </td>
      }
      <td>\(\rowvals[\rr])</td>
   </tr>
  }
  <tr>
   <th>\Name2</th>
   \for{cc=1 to 2}{<td>\(\colvals[\cc])</td>}
   <td></td>
  </tr>
</table>
}



\answer{Case 1}{\(\sh[1])}{type=dragfill}
\answer{Case 2}{\(\sh[2])}{type=dragfill}
\answer{Case 3}{\(\sh[3])}{type=dragfill}
\answer{Case 4}{\(\sh[4])}{type=dragfill}
\answer{Case 5}{\(\sh[5])}{type=dragfill}
\answer{Case 6}{\(\sh[6])}{type=dragfill}
\answer{Case 7}{\(\sh[7])}{type=dragfill}
\answer{Case 8}{\(\sh[8])}{type=dragfill}
\answer{Case 9}{\(\sh[9])}{type=dragfill}
\answer{Case 10}{\(\sh[10])}{type=dragfill}
\answer{Case 11}{\(\sh[11])}{type=dragfill}
\answer{Case 12}{\(\sh[12])}{type=dragfill}
\answer{Case 13}{\(\sh[13])}{type=dragfill}
\answer{Case 14}{\(\sh[14])}{type=dragfill}
\answer{Case 15}{\(\sh[15])}{type=dragfill}
\answer{Case 16}{\(\sh[16])}{type=dragfill}
