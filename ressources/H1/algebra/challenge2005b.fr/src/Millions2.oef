\language{fr}
\computeanswer{no}
\format{html}
\precision{10000}





 \title{Millions}

\text{dizaine=dix,vingt,trente,quarante,cinquante,soixante,soixante-dix,
        quatre-vingt}
\text{unite=un,deux,trois,quatre,cinq,six,sept,huit,neuf}
\text{ps=shuffle(2,3,4,5,6,8)}
\text{pt=shuffle(2,3,4,5,6,7,8,9)}
\integer{p1=\ps[1]}
\integer{p2=\pt[1]}
\integer{q1=\ps[2]}
\integer{q2=\pt[2]}
\integer{r1=\ps[3]}
\integer{r2=\pt[3]}
\text{P=\dizaine[\p1] \unite[\p2]}
\text{Q=\dizaine[\q1] \unite[\q2]}
\text{R=\dizaine[\r1] \unite[\r2]}
\text{z=0}
\text{n=\p1\p2\z\q1\q2\z\r1\r2}
\text{N=wims(translate - to , in \P millions \Q mille \R)}
\text{N=wims(words2items \N)}
\text{other=wims(translate - to , in \dizaine \unite)}
\text{other=wims(words2items \other)}
\integer{cnt=items(\N)+1}
\statement{
Composez en lettres le nombre \n.
<div class="wimscenter">
 \embed{r1,65x27x\cnt}
</div>
}
\reply{Le nombre}{\N;\other}{type=clickfill}
