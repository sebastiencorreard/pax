\title{Aéroport}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{ville=random(Paris,Londres,New York,Los Angeles, Beijing, Tokyo, Hong
Kong, Rome, Nice, Moscou, Shanghaï, Singapour, Genève, Zurich, Bruxelles,
Berlin, Montréal)}
\text{h=h}
\integer{ah=random(9..15)}
\integer{am=random(1..11)*5}
\integer{a=\ah*60+\am}
\text{am=wims(char -2,-1 of 0\am)}
\integer{comptoir=random(30,35,40,45,50)}
\integer{ta=\a-\comptoir}
\integer{t1=random(6..11)*5}
\integer{s1=random(3..5)*5}
\integer{s2=random(2..5)*5}
\integer{t2=\t1+\s1}
\integer{t3=\t2+\s2}
\integer{good=random(1..4)}
\integer{tt=item(\good,randint(\t3+2..\t3+20),
      randint(\t2+2..\t3-2),
      randint(\t1+2..\t2-2),
      randint(\t1-15..\t1-2))}
\integer{td=\ta-\tt}
\integer{hd=floor(\td/60)}
\integer{md=\td-60*\hd}
\text{md=wims(char -2,-1 of 0\md)}
\integer{size=160}
\text{clock=slib(draw/clock \hd:\md,160,1,nosecond)}
\text{nom=slib(lang/fname boy)}
\integer{prix1=random(3..10)}
\integer{prix2=random((\prix1+1)*1.2..(\prix1+1)*1.8)}
\integer{prix3=random(\prix2*1.6..\prix2*3)}
\integer{ha=floor(\ta/60)}
\integer{ma=\ta-60*\ha}
\text{ma=wims(char -2,-1 of 0\ma)}

\statement{
\nom doit prendre un avion pour \ville à \ah\h\am.
Il doit se présenter à l'aéroport au moins \comptoir minutes
avant le décollage.
Pour aller à l'aéroport, il a le choix entre :
<ul>
<li>le bus de ville qui prend \t3 minutes. Prix : \prix1 euros.</li>
<li>le bus de l'aéroport qui prend \t2 minutes. Prix : \prix2 euros.</li>
<li>le taxi qui prend \t1 minutes. Prix : \prix3 euros.</li>
</ul>
<div class="wimscenter">
\draw{\size,\size}{\clock}
</div>
Quel est le moyen le plus économique pour aller à l'aéroport, sans rater
l'avion ?
}


\answer{La réponse}{\good;Le bus de ville, Le bus de l'aéroport,
Le taxi, Aucun : il est déjà trop tard}{type=menu}

\solution{Il est \hd\h\md.
\nom doit arriver à l'aéroport à \ha\h\ma. Il a donc \tt minutes
pour faire le trajet.}
