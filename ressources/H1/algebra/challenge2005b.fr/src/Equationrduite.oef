\title{Equation réduite}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{lva.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{a=random(-15..15)}
\integer{bm=random(1..10)}
\integer{bp=random(1..2)}
\integer{b=\bm*(-1)^\bp}
\integer{c=random(-10..10)}

\function{equ=maxima(expand(simplify(\a*x + \b*y + \c)))}
\text{eq0=texmath(\equ)}


\function{m=simplify((-1)*\a/\b)}
\function{p=simplify((-1)*\c/\b)}

\function{eqr=maxima(expand(simplify(\m*x+\p)))}
\text{eqr0=texmath(\eqr)}

\statement{Donner le coefficient directeur ainsi que l'ordonnée à l'origine
de la droite \(d) d'équation :
<div class="wimscenter">
 \(\eq0 = 0)
</div>
}

\answer{Coefficient directeur}{\m}{type=default}

\answer{Ordonnée à l'origine}{\p}{type=default}

\solution{L'équation réduite de la droite \(d) est \(y = \eqr0)}
