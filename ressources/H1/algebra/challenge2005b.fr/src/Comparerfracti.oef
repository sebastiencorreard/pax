\title{Comparer fractions}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{num1=random(11112..99998)}
\integer{den1=random(11112..99998)}
\integer{num2=\num1}
\integer{den2=\den1}
\if{random(1,2)=1}{
 \integer{a=1}
 \text{good=3}
}{
 \integer{a=-1}
 \text{good=1}
}
\if{random(1,2)=1}{
 \integer{den2=\den1+(\a)}
}{
 \integer{num2=\num1-(\a)}
}

\statement{Comparez :
<div class="wimscenter">
 \(\frac{\num1}{\den1})
 est \embed{reply 1}
 \(\frac{\num2}{\den2})
</div>
}

\answer{Le pourcentage}{\good;plus petit que, égal à, plus grand que}{type=menu}
