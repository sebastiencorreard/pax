\title{Somme de radicaux.1}
\integer{p=random(2..9)}
\integer{q=\p^2}
\integer{r=random(2..9)}
\integer{s=\r^2}
\integer{c=2*\s}
\integer{d=2*\q}
\integer{g=\p+\r}
\text{reponse=\g*sqrt(2),sqrt(2)*\g}
\statement{Mettre sous forme \(a\sqrt b), a entier le plus grand possible,
la somme \(\sqrt \d + \sqrt \c).
<p>Dans votre réponse, écrivez a*sqrt(b),
avec les valeurs que vous aurez trouvées pour a et b.
</p>}

\answer{La réponse}{\reponse}{type=litexp}
