\title{Centre de gravité}
\language{fr}
\range{-5..5}
\author{Frédéric, Pitoun}
\email{frederic.pitoun@free.fr}
\computeanswer{yes}
\format{html}
\precision{10000}

\integer{x1=random(-5..5)}
\integer{y1=random(-5..5)}
\integer{xl=random(1..5)}
\integer{yl=random(1..5)}
\integer{xL=random(-5..-1)}
\integer{yL=random(1..5)}
\integer{d1=random(1..2)}
\integer{x2=\x1+\xl*(-1)^\d1}
\integer{y2=\y1+\yl*(-1)^\d1}
\integer{x3=\x1+\xL*(-1)^\d1}
\integer{y3=\y1+\yL*(-1)^\d1}
\rational{x4=(\x2+\x3)/2}
\rational{y4=(\y2+\y3)/2}
\rational{x5=\x1+2*(\x4-\x1)/3}
\rational{y5=\y1+2*(\y4-\y1)/3}



\text{b=\d=0?Oui:Non}
\text{m=\d=0?Non:Oui}
\statement{Dans un repère donné, on considère les  points
\(A)\(\left(\begin{array}{c} \x1 \\ \y1 \end{array}\right)),
\(B)\(\left(\begin{array}{c} \x2 \\ \y2 \end{array}\right)) et
\(C)\(\left(\begin{array}{c} \x3 \\ \y3 \end{array}\right)).
Déterminer les coordonnées du milieu \(I) du segment \([BC]),
 en déduire les coordonnées du centre de gravité \(G) du triangle \(ABC).}


\answer{Abscisse du point \(G)}{\x5}{type=rational}
\answer{Ordonnée du point \(G)}{\y5}{type=rational}

\hint{On peut commencer par déterminer les coordonnées du milieu d'un des segments du triangle \(ABC), puis utiliser la relation vectorielle :
<div class="wimscenter"> \(\overrightarrow{AG}=\frac{2}{3} \overrightarrow{AI})</div>
 \(I) désignant le milieu de \([BC]) et \(G) le centre de gravité du triangle \(ABC).}

\solution{On peut utiliser la propriété:  \(G) centre de gravité de A\(BC )\(\Leftrightarrow) \(\overrightarrow{AG})=\(\frac{2}{3} \overrightarrow{AI}), où \(I) désigne le milieu de \([BC]).}
