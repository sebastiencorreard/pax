\title{Q1.1.C0}
\language{fr}
\range{-5..5}
\computeanswer{no}
\format{html}
\precision{10000}
\integer{x=random(15..25)}
\integer{som = \x-2}
\integer{y=\x -1}
\integer{bi1 = 2}
\integer{bi2 = 1}
\integer{bi3 = \x+1}
\integer{bi4 = \x-3}
\statement{Avec mon frère, nous avons partagé équitablement nos billes.
  J'en avais \x, maintenant j'en ai \y. Combien mon frère avait-il de billes ?}

\choice{La somme}{\som}{\bi1,\bi2,\bi3,\bi4}

