\title{Calculer somme et produit de racines}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\real{a=randint(3..9)/10}
\real{b=randint(11..18)/10}
\real{sa=\a^2}
\real{sb=\b^2}
\real{somme=\a+\b}
\real{prod=\a*\b}

\statement{Calculez :
<ul>
 <li>\(\sqrt{\sa} + \sqrt{\sb}) = \embed{reply 1,4} .</li>
 <li>\(\sqrt{\sa} \times \sqrt{\sb}) = \embed{reply 2,4} .</li>
</ul>
}

\answer{La somme}{\somme}{type=number}
\answer{Le produit}{\prod}{type=number}
