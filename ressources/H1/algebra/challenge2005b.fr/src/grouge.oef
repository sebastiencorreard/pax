\title{Globules rouges}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=random(4,5,6,7)}
\integer{cm=random(2,3,4,5,6,7,8,12,14,15,16,18,20,25,30,40,50)}
\integer{N=\n*\cm}
\integer{p=floor(log10(\N))}
\real{a=\N/10^\p}
\integer{b=9+\p}

\statement{Lors d'une analyse de sang, on a dénombré \(\n*10^6) globules
rouges par mm<sup>3</sup> de sang.
<br>
Combien y a-t-il de globules rouges dans \cm cm<sup>3</sup> de ce sang ?
<div class="wimscenter">
   \embed{reply 1,4}&times;10<sup>\embed{reply 2,2}</sup>
</div>
<div class="wims_instruction">Écrivez votre réponse sous forme \(a*10^b),
  avec \(1 <= a < 10).
</div>
}

\answer{a}{\a}{type=number}
\answer{b}{\b}{type=number}
