 !exit
!endif

tmp0=!randint 2, 9

val6=$[rint($(tmp0))]
val7=$[rint($val6^2)]
tmp0=!randint 2, 9

val8=$[rint($(tmp0))]
val9=$[rint($val8^2)]
val10=$[rint(2*$val9)]
val11=$[rint(2*$val7)]
val12=$[rint($val6+$val8)]
val13=$val12*sqrt(2),sqrt(2)*$val12
replytype1=litexp
replyname1=La réponse
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

