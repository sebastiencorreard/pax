val6=randint
val7=60x30
val8=$[rint(4)]
tmp0=!values $val6(19)+x/10 for x=1 to 9

val9=$(tmp0)
tmp0=!values $val6(199)/10+x/100 for x=1 to 9

val10=$(tmp0)
val11=$(val9[1..$val8]),$(val10[1..$val8])
