val11=$(tmp0)
!for val21 =1 to $val14 
tmp0=!append item \({$(val11[$val21])}) to $val20

val20=$(tmp0)
!next
!else
!for val21 =1 to $val14 
tmp0=!append item \($(val11[$val21])) to $val20

val20=$(tmp0)
!next
!endif
tmp0=!item 1 to $val14 of r1,r2,r3,r4,r5,r6,r7,r8

val22=$(tmp0)
oefsteps=$val22 
nextstep=!nosubst $val22 
!readproc oef/steps.proc
