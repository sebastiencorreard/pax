!set title=Partage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 15, 25

val6=$[rint($(tmp0))]
val7=$[rint($val6-2)]
val8=$[rint($val6 -1)]
val9=$[rint(2)]
val10=$[rint(1)]
val11=$[rint($val6+1)]
val12=$[rint($val6-3)]
choicename1=La somme
choicegood1=$val7
choicebad1=$val9,$val10,$val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Avec mon frère, nous avons partagé équitablement nos billes.	  J'en avais $val6, maintenant j'en ai $val8. Combien mon frère avait-il de billes ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=0
