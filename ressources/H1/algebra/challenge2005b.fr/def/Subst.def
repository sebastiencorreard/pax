!set title=Subst
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,3

tmp1=!shuffle 1,$(tmp0)

val6=$(tmp1)
tmp0=!item 1 of $val6

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!item 2 of $val6

val9=$[rint($(tmp0))]
tmp0=!randitem 2,3,4

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=!rawmath ($val7*x+$val8)*($val10-$val9*x)
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!randitem 1,2,3

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem $val12*a+$val13,$val13+$val12*a,$val13-$val12*a

val14=!rawmath $(tmp0)
tmp0=!mathsubst x=($val14) in $val11

t_=!replace internal \( by ( in $(tmp0)
tmp1=!exec pari $t_

val15=!rawmath $(tmp1)
replytype1=algexp
replyname1=La formule
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Combien vaut 
!insmath $val11
$(), si 
!insmath x = $val14
$() ?	Substituez, développez et simplifiez.	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,14
embedcnt=0
