val17=$(val6[$val12]) $(val7[$val13])
val18=$(val6[$val14]) $(val7[$val15])
val19=0
val20=$val10$val11$val19$val12$val13$val19$val14$val15
tmp0=!translate - to , in $val16 millions $val17 mille $val18

val21=$(tmp0)
tmp0=!words2items $val21

val21=$(tmp0)
tmp0=!translate - to , in $val6 $val7

val22=$(tmp0)
tmp0=!words2items $val22

val22=$(tmp0)
tmp0=!itemcnt $val21

val23=$[rint($(tmp0)+1)]
replytype1=clickfill
replyname1=Le nombre
replygood1=$val21;$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

