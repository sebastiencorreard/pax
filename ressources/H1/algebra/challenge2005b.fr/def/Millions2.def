 !exit
!endif

val6=dix,vingt,trente,quarante,cinquante,soixante,soixante-dix,	        quatre-vingt
val7=un,deux,trois,quatre,cinq,six,sept,huit,neuf
tmp0=!shuffle 2,3,4,5,6,8

val8=$(tmp0)
tmp0=!shuffle 2,3,4,5,6,7,8,9

val9=$(tmp0)
val10=$[rint($(val8[1]))]
val11=$[rint($(val9[1]))]
val12=$[rint($(val8[2]))]
val13=$[rint($(val9[2]))]
val14=$[rint($(val8[3]))]
val15=$[rint($(val9[3]))]
