!set title=Cdrom
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu Xiao
email=xiao@unice.fr
language=nl
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 10

val6=$[rint($(tmp0))]
tmp0=!randint 5, 12

val7=$[rint($(tmp0))]
tmp0=!randint 80, 250

val8=$[rint($(tmp0))]
val9=$[rint(($val6*$val7)+$val8)]
replytype1=default
replyname1=Prijs (in euros)
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ik heb een cdrom-lezer gekocht. Voor de lezer plus $val6 cdroms die ieder 	$val7 euro kosten heb ik $val9 euro betaald. Wat is de prijs van de cdrom-lezer?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9
embedcnt=0
