tmp0=!randitem 15,20,25,50,100,200,250,500

val6=$[rint($(tmp0)*1000)]
tmp0=!randint 3, 15

val7=$[rint($(tmp0))]
val8=$[($val7*$val6)/100000]
replytype1=default
replyname1=Afstand op de kaart
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

