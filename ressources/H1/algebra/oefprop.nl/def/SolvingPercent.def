val6=$[rint($(tmp0))]
tmp0=!randint 1, 99

val7=$[rint($(tmp0))]
val8=$[rint($val7)]
val9=$[(100*$val6/$val8)]
val10=$[rint($val6*100)]
replyname1=Het getal
