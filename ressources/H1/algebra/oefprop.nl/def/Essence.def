!set title=Benzine
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu Xiao
email=xiao@unice.fr
language=nl
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 8,10,12,14,16

val6=$[rint($(tmp0))]
tmp0=!randint 4*$val6, 7*$val6

val7=$[rint($(tmp0))]
val8=$[($val7/$val6)*100]
replytype1=default
replyname1=Afstand (in km)
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Een auto verbruikt $val6 liter benzine per 100 km. Zijn 	tank kan $val7 liter bevatten, hoe ver kan hij daarop rijden?
$()
