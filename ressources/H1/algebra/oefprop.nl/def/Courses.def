!set title=Boodschappen
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Dingyu Xiao
email=xiao@unice.fr
language=nl
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

val6=$[rint($(tmp0))]
tmp0=!randitem 0.5,0.55,0.6,0.65,0.7,0.75,0.8,0.85,0.9,0.95,1

val7=$[$(tmp0)]
tmp0=!randitem 0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.45,0.5

val8=$[$(tmp0)]
val9=$[$val7+$val8]
val10=$[($val6*$val9)-$val8]
tmp0=!randitem sinaasappelsap, appelsap, Coca cola, druivensap

val11=$(tmp0)
replytype1=default
replyname1=Prijs van een fles
replygood1=$val9
replytype2=default
replyname2=Mijn geld
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Mijn moeder stuurt mij naar de supermarkt om $val11 te kopen. 	Ik neem $val6 flessen. Bij de kassa hoor ik dat ik $val8 euro tekort kom. 	Ik zet een fles terug en ga terug naar de kassa. Ik krijg vervolgens 	$val7 euro terug. Wat is de prijs van een fles $val11? Hoeveel geld had ik 	bij mij?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,11
embedcnt=0
