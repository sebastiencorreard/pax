\title{Percentages oplossen met verhoudingen I}
\language{nl}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{b=(100*\a/\p)}
\integer{h=\a*100}

\statement{<center>\a is \p procent van welk getal (tot twee cijfers achter de komma)?</center>}

\hint{Is/Van = Procent/100
<p>Vul \a in voor  Is  en \p voor  Procent 
<p>Vermenigvuldig \a met 100 en deel door \p}
\answer{Het getal}{\b}


\solution{<center>Is/Of = Procent/100
<p>\a * 100 gedeeld door \p
<p>\h / \p
<p>answer = \b</center>}
