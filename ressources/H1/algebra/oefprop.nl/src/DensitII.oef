\title{Dichtheid II}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{Het oppervlak van een land is \s km<sup>2</sup> en haar aantal 
bewoners is  \p miljoen. Wat is de bevolkingsdichtheid (in duizenden per 
km<sup>2</sup>)?}


\answer{Dichtheid}{\d}{type=default}
