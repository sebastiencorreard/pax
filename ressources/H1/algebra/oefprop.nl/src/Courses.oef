\title{Boodschappen}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{b=random(2..8)}
\real{\r=random(0.5,0.55,0.6,0.65,0.7,0.75,0.8,0.85,0.9,0.95,1)}
\real{\m=random(0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.45,0.5)}
\real{\p=\r+\m}
\real{\s=(\b*\p)-\m}
\text{\n=random(sinaasappelsap, appelsap, Coca cola, druivensap)}


\statement{Mijn moeder stuurt mij naar de supermarkt om \n te kopen. 
Ik neem \b flessen. Bij de kassa hoor ik dat ik \m euro tekort kom. 
Ik zet een fles terug en ga terug naar de kassa. Ik krijg vervolgens 
\r euro terug. Wat is de prijs van een fles \n? Hoeveel geld had ik 
bij mij?}

\answer{Prijs van een fles}{\p}{type=default}
\answer{Mijn geld}{\s}{type=default}



