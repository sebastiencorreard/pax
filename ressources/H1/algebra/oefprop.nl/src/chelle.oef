\title{Schaal}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translation{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\e=random(15,20,25,50,100,200,250,500)*1000}
\integer{\a=random(3..15)}
\real{\d=(\a*\e)/100000}

\statement{Een plattegrond is op schaal 1/\e. Wat is de werkelijke afstand (in 
km) die \a cm op de kaart voorstelt? }

\answer{Werkelijke afstand}{\d}{type=default}
