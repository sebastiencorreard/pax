\title{Dichtheid}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{De bevolkingsdichtheid van een land is 
\d bewoners/km<sup>2</sup>. Er wonen \p miljoen mensen. 
Wat is haar oppervlak (in duizenden  km<sup>2</sup>) ?}


\answer{oppervlak}{\s}{type=default}
