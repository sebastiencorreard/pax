\title{Percentages oplossen met verhoudingen III}
\language{nl}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{b=random(1..99)}
\real{p=\a*100/\b}

\integer{h=\a*100}

\statement{<center>\a is welk percentage van \b (tot twee cijfers achter de komma)?</center>}

\hint{Is/Van = Procent/100
<p>Vul \a in voor  Is  en \b voor Van  
<p>Vermenigvuldig \a met 100 en deel door \b}
\answer{Het getal}{\p}


\solution{<center>Is/Van = Procent/100
<p>Is * 100 = Of * Procent
<p>\a * 100 = \b * Procent
<p>\h = \b * Procent
<p>\h / \b = Procent
<p>\p = Procent</center>}
