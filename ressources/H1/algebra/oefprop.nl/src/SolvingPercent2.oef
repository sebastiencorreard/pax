\title{Percentages oplossen met verhoudingen II}
\language{nl}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{100}

\integer{b=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{a=(\p*\b/100)}
\integer{h=\p*\b}

\statement{<center>Wat is \p procent van \b (tot twee cijfers achter de komma)?</center>}

\hint{Is/Van = Procent/100
<p>Vul \b  in voor Van en \p voor  Procent 
<p>Vermenigvuldig \b * \p en deel door 100}
\answer{Het getal}{\a}


\solution{<center>Is/Van = Procent/100
<p>Is * 100 = Procent * Of
<p>100 * Is = \b * \p
<p>100 * Is = \h
<p>Is = \h / 100
<p>Is = \a</center>}
