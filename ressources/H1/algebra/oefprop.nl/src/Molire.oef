\title{Molière}
\language{fr}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\a=random(15..30)}
\integer{\r=random(2..10)}
\real{\f=randint(50..100)/2}
\real{\p=(\f*\a)-(\r*\a)}
\statement{Le professeur de français a acheté \a exemplaires de l'Avare.
Le libraire lui a fait une remise de \r francs par livre. Il a
payé \p francs. Quel est le prix du livre sans la remise ?}


\answer{Prix (en francs)}{\f}{type=default}



