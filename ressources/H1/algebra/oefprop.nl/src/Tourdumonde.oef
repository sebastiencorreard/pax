\title{De wereld rond}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\k=random(3..16)}
\integer{\v=random(80,100,125,160)}
\integer{\h=40000/\v}
\statement{De omtrek van de aarde is ongeveer 40000 km. Om een 
reis rond de wereldbol met de auto te simuleren rijdt een piloot 
op een circuit van \k km met een gemiddelde snelheid van \v km/h 
(inclusief pauzes en onderhoud). Hoe land doet hij er over, in uren?}

\answer{Uren}{\h}{type=default}



