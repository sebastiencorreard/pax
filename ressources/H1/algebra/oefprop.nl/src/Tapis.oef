\title{Tapijt}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\f=random(20,25,30,35,40,45,50,55,60)*100}
\integer{\s=random(10..40)}
\integer{t=random(1,2)}
\text{t1=item(\t,stijging,daling)}
\text{t2=item(\t,daling,stijging)}
\statement{De prijs van een tapijt was \f euro in november, met 
een \t1 van \s% in december, en een \t2 van \s% in januari. Wat is 
de nieuwe prijs?}


\choice{De nieuw prijs is}{minder dan \f euro}{meer dan \f euro, dezelfde}


