\title{Gewicht}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\c=random(8,10)}
\integer{\s=random(4,5)}
\integer{\p=random(8..12)}
\real{\v=\p/\c}
\integer{\t=\p*\s}
\statement{Een vrachtwagen is \c keer zwaarder dan een auto, terwijl de
vrachtwagen \s keer lichter is dan een tank. Wetend dat de vrachtwagen
\p ton weegt, bereken het gewicht van een auto en van een tank (in tonnen).}

\answer{Gewicht van een auto}{\v}{type=default}
\answer{Gewicht van een tank}{\t}{type=default}



