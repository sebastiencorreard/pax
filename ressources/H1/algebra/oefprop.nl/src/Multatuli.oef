\title{Multatuli}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\a=random(15..30)}
\integer{\r=random(2..10)}
\real{\f=randint(50..100)/2}
\real{\p=(\f*\a)-(\r*\a)}
\statement{De meester heeft \a exemplaren gekocht van Max Havelaar. 
Bij de boekwinkel heeft het \r euro korting gekregen op ieder 
boek. Hij heeft \p euro betaald. Wat is de prijs van het boek zonder korting?}


\answer{Prijs (in euro)}{\f}{type=default}



