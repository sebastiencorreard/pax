\title{Pyramide}
\language{nl}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\translator{Reinie ERNE}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\b=random(10..22)*10}
\integer{\h=random(5..13)*10}
\integer{\e=random(5..14)*100}
\real{\c=(\b*100)/\e}
\statement{Een pyramide heeft een vierkante voet van \b m. Zijn hoogte is 
\h m. Als je een houten model wilt maken op schaal 1/\e, wat is dan de 
lengte van de zijkant van de voet (in cm)?}


\answer{Zijkant van de voet}{\c}{type=default}



