\title{Verhoudingen (niveau 1b)}
\language{nl}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\translator{Reinie Erne}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(2,3,5,7)}
\integer{c=random(2,3,5,7)}
\integer{b=random(-7,-5,-3,-2,2,3,5,7)}
\integer{d=random(-7,-5,-3,-2,2,3,5,7)}
\integer{e=(\b*\c)}
\integer{f=(\a*\d)}
\integer{g=\a*\b}
\integer{h=\c*\d}
\integer{j=\g*\h}

\statement{<center>Los op voor x:<p>\e/\h = \g/x</center>}

\hint{Kruisproducten zijn gelijk. Maak er de volgende vergelijking van
<p>(\e)x = \g(\h)}
\answer{x}{\f}


\solution{<center>\g(\h) = (\e)x (kruisproducten)
<p>\j = \e x
<p>\j/\e = (\e)x/\e (beide zijden delen door \e)
<p>\f = x (antwoord)
</center>}
