!set title=Distance sur la droite graduée
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_es=Distancia sobre la recta graduada
title_nl=Afstend op de getallenlijn

ansorder=r
varcnt=26
prevarcnt=25
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=$[rint(3)]
val8=$[rint(3)]
val9=0
val10=
!for val11 =-$val7 to $val8 
val9=$[rint($val11)]
val12=$[rint($val11)]
val10=$val10	text black, $val12,-1, medium,$val9
!next
tmp0=!randitem 1,-1

tmp1=!randint 0, 10*$val7-1

val13=$[$(tmp0)*$(tmp1)/10]
tmp0=!randitem 1,-1

tmp1=!randint 0, 10*$val7-1

val14=$[$(tmp0)*$(tmp1)/10]
val15=$[abs($val13-($val14))]

!ifval $val13>0
val13= +$val13
!endif

!ifval $val14>0
val14= +$val14
!endif
val10=xrange -$val7-0.1,3	yrange -2,2	hline black,0,0	arrow 2.5,0,3,0,10,black	parallel -$val7,-0.8,-$val7,0.4,1/2,0, 40, blue	parallel -$val7,-0.3,-$val7,0.3,1/10,0, 200, blue	parallel -$val7,-0.8,-$val7,0.6,1,0, 40, red	$val10
!readproc oef/drawtikz.phtml 600,50 \
$val10 
tmp0=$ins_tikz
val16=$(tmp0)
val17=En s'aidant de la règle graduée, déterminer la distance entre les	deux points \(A ($val13)\) et \(B ($val14)\).
val18=Distance entre
val19=et
!if $val6=es 
val17=Ayudándose de la regla graduada, determinar la distancia entre	  los puntos \(A ($val13)\) y \(B ($val14)\).
val18=Distancia entre
val19=y
!endif
!if $val6=nl 
val17=Bepaal met behulp van de getallenlijn de afstand tussen de twee punten \(A ($val13)\) en \(B ($val14)\).
val18=De afstand tussen 
val19=en
!endif
replytype1=numeric
replyname1=$val18 \(A\) $val19 \(B\)
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val17 \begin{center} $val16 \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val17	<div class="wimscenter">	 
!read oef/draw.phtml 600,50 \
$val10 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val17 $m_begin{center} $val16 $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,16,17
embedcnt=0
