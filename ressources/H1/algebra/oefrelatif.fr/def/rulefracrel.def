val13=$[rint(6)]
val14=$[rint(-$val13)]
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val15=$[rint($(tmp0))]
val16=0
val17=
!for val18 =$val14 to $val13 
val16=$[rint($val18*1)]
val19=$[rint($val18)]
val17=$val17	  text blue, $val19,-1, medium,$val16
!next
tmp=!nonempty items 2,4,5

tmp0=!randitem $tmp
val20=$(tmp0)
tmp0=!randint 1, 10

val21=$(tmp0)
t_=!replace internal \( by ( in divrem($val21,$val20)~[2]
tmp0=!exec pari $t_

val22=$(tmp0)
!while $val22=0 
val20=$[rint($val20*$val20)]
t_=!replace internal \( by ( in divrem($val21,$val20)~[2]
tmp0=!exec pari $t_

val22=$(tmp0)
!endwhile
t_=!rawmath $val15*$val21/$val20
val16=!exec pari print($t_)
t_=!replace internal \( by ( in [numerator($val16),denominator($val16)]
tmp0=!exec pari $t_

val23=$(tmp0)
val17=xrange $val14-0.1,$val13+0.1	  yrange -2,2.2	  hline black,0,0	  arrow 2.5,0,$val13,0,10,black	  parallel $val14,-0.8,$val14,0.4,1/2,0, 40, blue	  parallel $val14,-0.3,$val14,0.3,1/10,0, 200, blue	  parallel $val14,-0.8,$val14,0.6,1,0, 40, red	  $val17	  arrow $val16,2,$val16,0, 8, black	
