!set title=Ranger des nombres relatifs II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_es=Ordenar números relativos II
title_nl=Noteer de getallen in de goede volgorde II

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=croissant,décroissant
val8=En s'aidant de la règle graduée, ranger dans	  l'ordre, les nombres suivants.
!if $val6=es 
val7=creciente,decreciente
val8=Ayudándose de la regla graduada, ordenar de forma,	  los siguientes números
!endif
!if $val6=nl 
val7=stijgend,dalend
val8=Bepaal aan de hand van de getallenlijn de volgorde van de getoonde getallen.
!endif
val9=$[rint(3)]
val10=$[rint(3)]
val11=0
val12=
!for val13 =-$val9 to $val10 
val11=$[rint($val13)]
val14=$[rint($val13)]
val12=$val12	text black, $val14,-1, medium,$val11
!next
tmp0=!randint 0, 10*$val9-1

val15=$[-$(tmp0)/10]
tmp0=!randint 0, 10*$val9-1

val16=$[$(tmp0)/10]
tmp0=!randint 10, 10*$val9-1

val17=$[-$(tmp0)/10]
tmp0=!randitem 1,-1

tmp1=!randint 10, 10*$val9-1

val18=$[$(tmp0)*$(tmp1)/10]
tmp0=!randint 10, 10*$val9-1

val19=$[-$(tmp0)/10]
tmp0=!randint 10, 10*$val9-1

val20=$[-$(tmp0)/10]
tmp0=!listuniq $val15,$val16,$val17,$val19,$val18,$val20

val21=$(tmp0)
tmp0=!randitem 1,2

val22=$(tmp0)
tmp0=!item $val22 of $val7

val23=$(tmp0)
tmp0=!sort numeric list $val21

val24=$(tmp0)
tmp0=!shuffle $val21

val25=$(tmp0)
tmp0=!replace , by ,&nbsp; &nbsp; in $val25

val25=$(tmp0)
tmp0=!sort reverse numeric list $val24

val26=$(tmp0)

!ifval $val22=1
val27= $val24
!else
val27=$val26
!endif
val12=xrange -$val9-0.1,$val10+0.1	yrange -2,2	hline black,0,0	arrow $val10-0.5,0,$val10,0,10,black	parallel -$val9,-0.8,-$val9,0.4,1/2,0,40, blue	parallel -$val9,-0.3,-$val9,0.3,1/10,0,200, blue	parallel -$val9,-0.8,-$val9,0.6,1,0,40, red	$val12
!readproc oef/drawtikz.phtml 600,50 \
$val12 
tmp0=$ins_tikz
val28=$(tmp0)
replytype1=vector
replyname1=
replygood1=$val27
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val8[1]), $(val8[2]) $val23 $(val8[3]) $val25 \begin{center} $val28 \end{center} \end{statement} 


!goto stat

!exit

:question
$()$(val8[1]), $(val8[2]) $val23 $(val8[3])	<div class="wimscenter"> $val25</div>	<div class="wimscenter"> 
!read oef/draw.phtml 600,50 \
	$val12	 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val8[1]), $(val8[2]) $val23 $(val8[3]) $val25 $m_begin{center} $val28 $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,12,23,25,28
embedcnt=0
