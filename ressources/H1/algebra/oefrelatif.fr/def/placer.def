!set title=Placer un point dans le plan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=100
title_es=Placer un point dans le plan
title_nl=Zet een punt in het platte vlak

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Mettre le point \(A\) en
!if $val6=es 
val7=Mettez le point \(A\) en
!endif
!if $val6=nl 
!endif
tmp0=!randint -7, 7

tmp1=!randint -7, 7

val8=$(tmp0), $(tmp1)

!ifval $(val8[1])=0 and $(val8[2])=0 
tmp0=!randint -7, 7

tmp1=!randint 1, 7

val8= $(tmp0), $(tmp1)
!endif
val9=var brd = JXG.JSXGraph.initBoard('jxgbox', {	 axis:true,boundingbox: [-10, 10, 10, -10], grid:true});	grid = brd.create('grid', []);	jxgbox_rep1 = brd.create('point',jxgbox_var1);	
replytype1=jsxgraph

replyoption1=precision=5 
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath ($val8)
$().	<div class="wimscenter">	  
!read oef/embed.phtml r1,400x400	jxgbox	$val9	jxgbox_var1=[0,0]	 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=1
