val6=$[rint($(tmp0))]
tmp0=!randint 1, 99

val7=$[rint($(tmp0))]
val8=$[rint($val7)]
val9=$[(100*$val6/$val8)]
val10=$[rint($val6*100)]
replyname1=答数
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 部分/总数 = 百分数/100 <p>把 $val6 代入部分, $val8 代入百分数 <p>把 $val6 乘以 100 再除以 $val8

solution=!nosubst <center>部分/总数 = 百分数/100 <p>$val6 * 100 除以 $val8 <p>$val10 / $val8 <p>答案 = $val9</center>


!goto stat

!exit

