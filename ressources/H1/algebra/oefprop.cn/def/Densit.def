!set title=密度
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Dingyu Xiao
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 15

val6=$[rint($(tmp0)*10)]
tmp0=!randint 40, 70

val7=$[rint($(tmp0)*10)]
val8=$[$val7*$val6/1000]
replytype1=default
replyname1=面积
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()一个国家的人口密度是 $val6 居民/公里<sup>2</sup>. 它的居民有 $val8 百万。 	它的面积是多少 (千公里<sup>2</sup>)?
$()
!exit

