 !exit
!endif

tmp0=!randint 1, 99

val6=$[rint($(tmp0))]
tmp0=!randint 1, 99

val7=$[rint($(tmp0))]
val8=$[rint($val7)]
val9=$[($val8*$val6/100)]
val10=$[rint($val8*$val6)]
replyname1=答数
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst 部分/总数 = 百分数/100 <p>把 $val6 代入总数, $val8 代入百分数 <p>把 $val6 乘以 $val8 再除以 100

solution=!nosubst <center>部分/总数 = 百分数/100 <p>部分 * 100 = 百分数 * 总数 <p>100 * 部分 = $val6 * $val8 <p>100 * 部分 = $val10 <p>部分 = $val10 / 100 <p>部分 = $val9</center>


!goto stat

!exit

:question
$()<center>$val6 的百分之 $val8 是多少 (精确到小数点后2位)?</center>
$()
!exit

:hint
$()部分/总数 = 百分数/100 <p>把 $val6 代入总数, $val8 代入百分数 <p>把 $val6 乘以 $val8 再除以 100
$()
!exit

:help
$()
$()
!exit

:solution
