\title{密度}
\language{cn}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\d=random(5..15)*10}
\integer{\s=random(40..70)*10}
\real{\p=\s*\d/1000}
\statement{一个国家的人口密度是 \d 居民/公里<sup>2</sup>. 它的居民有 \p 百万。
它的面积是多少 (千公里<sup>2</sup>)?}


\answer{面积}{\s}{type=default}
