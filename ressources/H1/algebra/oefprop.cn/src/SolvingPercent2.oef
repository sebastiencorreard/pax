\title{用比例解百分数 II}
\language{cn}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{b=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{a=(\p*\b/100)}
\integer{h=\p*\b}

\statement{<center>\b 的百分之 \p 是多少 (精确到小数点后2位)?</center>}

\hint{部分/总数 = 百分数/100 
<p>把 \b 代入总数, \p 代入百分数
<p>把 \b 乘以 \p 再除以 100}
\answer{答数}{\a}


\solution{<center>部分/总数 = 百分数/100	
<p>部分 * 100 = 百分数 * 总数
<p>100 * 部分 = \b * \p
<p>100 * 部分 = \h
<p>部分 = \h / 100
<p>部分 = \a</center>}
