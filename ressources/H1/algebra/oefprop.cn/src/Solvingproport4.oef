\title{解比例 (水平 1b)}
\language{cn}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(2,3,5,7)}
\integer{c=random(2,3,5,7)}
\integer{b=random(-7,-5,-3,-2,2,3,5,7)}
\integer{d=random(-7,-5,-3,-2,2,3,5,7)}
\integer{e=(\b*\c)}
\integer{f=(\a*\d)}
\integer{g=\a*\b}
\integer{h=\c*\d}
\integer{j=\g*\h}

\statement{<center>求解 x:<p>\e/\h = \g/x</center>}

\hint{由交叉乘积相等. 建立方程
<p>(\e)x = \g(\h)}
\answer{x}{\f}


\solution{<center>\g(\h) = (\e)x (交叉乘积)
<p>\j = \e x
<p>\j/\e = (\e)x/\e (两边除以 \e)
<p>\f = x (答数)
</center>}
