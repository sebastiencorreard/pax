\title{用比例解百分数 III}
\language{cn}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{b=random(1..99)}
\real{p=\a*100/\b}

\integer{h=\a*100}

\statement{<center>\a 是 \b 的百分之几(精确到小数点后2位)?</center>}

\hint{部分/总数 = 百分数/100 
<p>把 \a 代入部分, \b 代入总数
<p>把 \a 乘以 100 再除以 \b}
\answer{答数}{\p}


\solution{<center>部分/总数 = 百分数/100 
<p>部分 * 100 = 总数 * 百分数 
<p>\a * 100 = \b * 百分数 
<p>\h = \b * 百分数 
<p>\h / \b = 百分数
<p>\p = 百分数</center>}
