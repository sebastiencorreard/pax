\title{重量}
\language{cn}
\range{-5..5}
\author{Dingyu Xiao}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{\c=random(8,10)}
\integer{\s=random(4,5)}
\integer{\p=random(8..12)}
\real{\v=\p/\c}
\integer{\t=\p*\s}
\statement{一辆卡车比一辆小轿车重 \c 倍, 这辆卡车比一辆坦克轻 \s 倍。
已知这辆卡车的重量是 \p 吨, 计算小轿车和坦克的重量(吨)。}


\answer{小轿车的重量}{\v}{type=default}
\answer{坦克的重量}{\t}{type=default}



