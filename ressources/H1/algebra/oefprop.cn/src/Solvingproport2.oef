\title{解比例 (水平 2)}
\language{en}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(-8,-6,-4,-2,2,4,6,8)}
\integer{b=random(-9,-7,-5,-3,3,5,7,9)}
\integer{c=\a+\b}
\integer{d=\a*\b}
\integer{e=\d+1}
\integer{f=\e-\c}
\integer{g=(-1)*\a}
\integer{h=(-1)*\b}

\statement{<center>解下列比例式.	
<p>(给两个解)	
<p>(x + 1)/x = \f/(x + \d)</center>}

\hint{由交叉乘积相等. 利用中项与外项建立方程, 然后解出 x.}
\answer{第一个答数}{\ans1}
\answer{第二个答数}{\ans2}

\condition{\ans1}{\ans1=\g or \ans1=\h}
\condition{\ans2}{\ans2=\g or \ans2=\h}
\solution{<center>(x + 1)(x + \d) = \f x
<p>x<sup>2</sup> + \e x + \d = \f x
<p>x<sup>2</sup> + \e x - \f x + \d = \f x - \f x
<p>x<sup>2</sup> + \c x + \d = 0
<p>(x + \a)(x + \b) = 0
<p>\g 以及 \h = 答数</center>}
