\title{解比例 (水平 1d)}
\language{cn}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(2,3,5,7)}
\integer{c=random(2,3,5,7)}
\integer{b=random(-7,-5,-3,-2,2,3,5,7)}
\integer{d=random(-7,-5,-3,-2,2,3,5,7)}
\integer{e=(\b*\c)}
\integer{f=(\a*\d)}
\integer{g=\a*\b}
\integer{h=\c*\d}
\integer{j=\g*\h}

\statement{<center>求解 x: x/\g = \h/\e</center>}

\hint{由交叉乘积相等. 建立方程
<p>(\e)x = \g(\h)}
\answer{x}{\f}

