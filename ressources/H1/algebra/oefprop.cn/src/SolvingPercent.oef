\title{用比例解百分数 I}
\language{cn}
\range{-5..5}
\author{Mark Miller}
\email{markmillermvhs@hotmail.com}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..99)}
\integer{c=random(1..99)}
\integer{p=\c}
\real{b=(100*\a/\p)}
\integer{h=\a*100}

\statement{<center>\a 是哪个数的百分之 \p (精确到小数点后2位)?</center>}

\hint{部分/总数 = 百分数/100	
<p>把 \a 代入部分, \p 代入百分数
<p>把 \a 乘以 100 再除以 \p}
\answer{答数}{\b}


\solution{<center>部分/总数 = 百分数/100	
<p>\a * 100 除以 \p
<p>\h / \p
<p>答案 = \b</center>}
