!set title=Cycliste
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Un cycliste
val7=$[rint(15)]
val8=$[rint(50)]
val9=8, 9,16,18,24,25,27,35,36,42
val10=2, 3, 4, 3, 2, 5, 9, 7, 3, 7
val11=15,20,15,10, 5,12,20,12, 5,10
tmp0=!randint 1, 10

val12=$[rint($(tmp0))]
val13=$[rint($(val9[$val12]))]
val14=$[rint($(val11[$val12]))]
val15=$[rint($(val10[$val12]))]
tmp0=!randint $val7*10/$val14, $val8*10/$val14

val16=$[$(tmp0)*$val14/10]
val17=$[$val16/$val14*$val15]
replyname1=La vitesse
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6 parcourt $val17 km en $val13 minutes. Quelle est sa vitesse ?	<div class="wimscenter">	 
!read oef/embed.phtml r1,6 
$() kilomètre/heure.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13,17
embedcnt=1
