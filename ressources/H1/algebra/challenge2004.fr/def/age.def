!set title=Age deviné
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=21
prevarcnt=14
postvarcnt=6
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=4
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2,3

val6=$[rint($(tmp0))]
val7=$[rint(1)]
val8=
tmp0=!randint 3, 9

val9=$[rint($(tmp0))]
tmp0=!randint 3, 9

val10=$[rint($(tmp0))]
tmp0=!randint 0, 9

val11=$[rint($(tmp0))]
val12=$[rint($val7*($val6+$val9+$val10+$val11))]
val13=$[rint($val6$val9$val10$val11+$val12)]
tmp0=!randitem 1,2

val14=$(tmp0)
tmp0=!item $val14 of boy,girl

val15=$(tmp0)
tmp0=!item $val14 of il,elle

val16=$(tmp0)
tmp0=!item $val14 of né,née

val17=$(tmp0)
!readproc slib/lang/fname $val15 
tmp0=$slib_out
val18=$(tmp0)
!readproc slib/lang/frapostrophe de $val18 
tmp0=$slib_out
val19=$(tmp0)
replytype1=numeric
replyname1=L'âge $val19
replygood1=?analyze 20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Nous sommes en l'an $val13, et $val18 vient de fêter son	  anniversaire. Maintenant $val16 a un âge égal à $val8 la	  somme des chiffres de son année de naissance. Quel est son âge&nbsp;?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
val21=$[rint(0)]
val20=$[rint($val20)]
!if $val20>0 and $val20<=150 
val22=$[rint($val13-$val20)]
val23=$[rint(floor($val22/1000)+floor($val22/100)%10+floor($val22/10)%10+$val22%10)]
val23=$[rint($val7*$val23)]

!ifval $val23=$val20
val21=$[rint(1)]
!endif
!endif

!exit

:feedback
!ifval $val20<0
 <div class='oef_feedbacks'>Tiens $val18 a un âge négatif !
$()</div>
!endif
!ifval $val20=0
 <div class='oef_feedbacks'>$val18 vient de naître ?!
$()</div>
!endif
!ifval $val20>150
 <div class='oef_feedbacks'>$val18 vient de battre tous les records de longévité ?
$()</div>
!endif
!ifval $val20>0 and $val20<=150 and $val21=0
 <div class='oef_feedbacks'>	  Si $val18 a $val20 ans en $val13, $val16 est $val17 en l'an $val22.	  Donc $val8 la somme des chiffres de son année de naissance est $val23, qui n'est	  pas égale à l'âge $val19. Désolé.	<p>	  Essaie de voir si $val18 pourrait avoir $val12 ans.	</p>	
$()</div>
!endif

!exit

:test

!ifval $val21=1
 condtest1=1
!else
 condtest1=0
!endif
condname1=L'âge $val19 = $val8 la somme des chiffres

!exit

:stat
vsavelist=7,8,12,13,16,17,18,19,20
embedcnt=0
