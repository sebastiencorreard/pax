!set title=Triangles isocèles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of 0.15,0.5

val7=$[$(tmp0)]
tmp0=!item $val6 of DB = DA, BA = BD

val8=$(tmp0)
tmp0=!randint 4, 26

val9=$[rint($(tmp0)*2)]
tmp0=!item $val6 of 180-3*$val9,90-3*$val9/2

val10=$[rint($(tmp0))]
replyname1=L'angle A
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-8">	    <ul>	    <li>
!insmath ABC
$() est un triangle isocèle de sommet 
!insmath A
$() (c'est-à-dire 
!insmath AB = AC
$()).</li>	    <li>
!insmath D
$() est un point appartenant à 
!insmath BC
$() tel que 
!insmath $val8
$() ;</li>	    <li>L'angle 
!insmath \widehat {CBA}
$() vaut $val9 degrés ; </li>	    </ul>	    Combien mesure l'angle 
!insmath \widehat {DAC}
$()&nbsp;?	    <div class="wimscenter">	       
!read oef/embed.phtml r1,5 
$() degrés.	      <div class="wims_instruction">	        Le dessin ci-contre n'est qu'une indication délibérément imprécise.	      </div>	    </div>	  </div>	  <div class="cell small-12 medium-6 large-4">	     
!read oef/draw.phtml 300,200 \
	 xrange -1.2,1.2	 yrange -0.7,0.7	 linewidth 2	 triangle -1,-0.5,1,-0.5,0,0.5,blue	 segment 0,0.5,$val7,-0.5,blue	 text black,-1.1,-0.5,large,B	 text black,1.02,-0.5,large,C	 text black,-0.03,0.65,large,A	 text black,$val7-0.03,-0.53,large,D	 
$()	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9
embedcnt=1
