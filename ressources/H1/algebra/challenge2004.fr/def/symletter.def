!set title=Symétrie des lettres
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=8
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=oui,non
tmp=!trim A,1,2	B,1,2	C,1,2	D,1,2	E,1,2	F,2,2	G,2,2	H,1,1	I,1,1	K,2,2	L,2,2	M,1,2	N,2,1	O,1,1	P,2,2	R,2,2	S,2,1	T,1,2	U,1,2	V,1,2	W,1,2	X,1,1	Y,1,2	Z,2,1	
val7=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp0=!rowcnt $tmp
val8=$[rint($(tmp0))]
tmp0=!shuffle $val8

val9=$(tmp0)
tmp0=!item 1 of $val9

tmp=!translate internal $	$ to ; in $val7

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val10=$(tmp1)
tmp0=!item 2 of $val9

tmp=!translate internal $	$ to ; in $val7

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val11=$(tmp1)
tmp0=!item 3 of $val9

tmp=!translate internal $	$ to ; in $val7

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val12=$(tmp1)
tmp0=!item 4 of $val9

tmp=!translate internal $	$ to ; in $val7

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val13=$(tmp1)
tmp0=!item 1 of $val10

val14=$(tmp0)
tmp0=!item 1 of $val11

val15=$(tmp0)
tmp0=!item 1 of $val12

val16=$(tmp0)
tmp0=!item 1 of $val13

val17=$(tmp0)
tmp0=!item 2 of $val10

val18=$(tmp0)
tmp0=!item 2 of $val11

val19=$(tmp0)
tmp0=!item 2 of $val12

val20=$(tmp0)
tmp0=!item 2 of $val13

val21=$(tmp0)
tmp0=!item 3 of $val10

val22=$(tmp0)
tmp0=!item 3 of $val11

val23=$(tmp0)
tmp0=!item 3 of $val12

val24=$(tmp0)
tmp0=!item 3 of $val13

val25=$(tmp0)
replytype1=radio
replyname1=Centre pour $val14
replygood1=$val18;$val6
replytype2=radio
replyname2=Axe pour $val14
replygood2=$val22;$val6
replytype3=radio
replyname3=Centre pour $val15
replygood3=$val19;$val6
replytype4=radio
replyname4=Axe pour $val15
replygood4=$val23;$val6
replytype5=radio
replyname5=Centre pour $val16
replygood5=$val20;$val6
replytype6=radio
replyname6=Axe pour $val16
replygood6=$val24;$val6
replytype7=radio
replyname7=Centre pour $val17
replygood7=$val21;$val6
replytype8=radio
replyname8=Axe pour $val17
replygood8=$val25;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Parmi les lettres suivantes, lesquelles ont un axe de symétrie,	lesquelles ont un centre de symétrie ?	<table class="wimsborder wimscenter">	<tr><th>Lettre</th><th>Axe de symétrie</th><th>Centre de symétrie</th></tr>	<tr><td>$(val10[1])</td>	<td> 
!read oef/embed.phtml reply 1 
$()</td>	<td> 
!read oef/embed.phtml reply 2 
$()</td></tr>	<tr><td>$(val11[1])</td>	<td> 
!read oef/embed.phtml reply 3 
$()</td>	<td> 
!read oef/embed.phtml reply 4 
$()</td></tr>	<tr><td>$(val12[1])</td>	<td> 
!read oef/embed.phtml reply 5 
$()</td>	<td> 
!read oef/embed.phtml reply 6 
$()</td></tr>	<tr><td>$(val13[1])</td>	<td> 
!read oef/embed.phtml reply 7 
$()</td>	<td> 
!read oef/embed.phtml reply 8 
$()</td></tr>	</table>	
$()
!exit

