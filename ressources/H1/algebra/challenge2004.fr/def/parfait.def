!set title=Nombres parfaits
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=3
prevarcnt=2
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 2,4,6,12

val6=$[rint($(tmp0))]
val7=$[rint(2^$val6*(2^($val6+1)-1))]
replytype1=set
replyname1=Liste de nombres parfaits
replygood1=6
replyname2=\(n)
replygood2=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Un nombre naturel parfait est un nombre égal à la somme de ses diviseurs	  autres que lui-même.	<p>	  Donnez la liste des nombres parfaits inférieur à 10.	 
!read oef/embed.phtml r1,6 
$()	</p><p>	  On ne connaît que les 30 premiers nombres parfaits : ils s'écrivent tous	  sous la forme 
!insmath 2^n*( 2^(n+1) - 1 )
$(), où 
!insmath n
$() est un entier naturel.	</p><p>	  Trouvez la valeur de 
!insmath n
$() correspondant au nombre parfait $val7.	</p>	
$()
!exit

