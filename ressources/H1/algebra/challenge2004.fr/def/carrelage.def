val6=$[rint($(tmp0))]
val7=$[rint($val6^2)]
tmp0=!randint 500, 800

val8=$[rint($(tmp0))]
val9=$[rint(floor($val8/$val6/2)*2)]

!ifval $val9%10=0
val9=$[rint($val9+2)]
!endif
val10=$[rint($val9^2)]
val8=$[$val9*$val6/100]
val11=$[$val8^2]
