!set title=Millions I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=dix,vingt,trente,quarante,cinquante,soixante,soixante-dix,	 quatre-vingt
val7=un,deux,trois,quatre,cinq,six,sept,huit,neuf
tmp0=!shuffle 2,3,4,5,6,8

val8=$(tmp0)
tmp0=!shuffle 2,3,4,5,6,7,8,9

val9=$(tmp0)
val10=$[rint($(val8[1]))]
val11=$[rint($(val9[1]))]
val12=$[rint($(val8[2]))]
val13=$[rint($(val9[2]))]
val14=$[rint($(val8[3]))]
val15=$[rint($(val9[3]))]
val16=$(val6[$val10]) $(val7[$val11])
val17=$(val6[$val12]) $(val7[$val13])
val18=$(val6[$val14]) $(val7[$val15])
val19=0
val20=$val10$val11$val19$val12$val13$val19$val14$val15
replytype1=litexp
replyname1=Le nombre
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Ecrivez en chiffres le nombre suivant.	<div class="wimscenter">	 $val16 millions $val17 mille et $val18.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=16,17,18
embedcnt=0
