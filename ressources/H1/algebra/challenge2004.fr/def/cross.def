!set title=Cross
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 40,50,60,80,120,150,160,180

val6=$[rint($(tmp0))]
tmp0=!shuffle 3,4

val7=$(tmp0)
val8=$[rint($(val7[1])*$val6)]
val9=$[rint($(val7[2])*$val6)]
val10=$[rint(5*$val6)]
tmp0=!randitem 1,2

val11=$[rint($(tmp0))]
tmp0=!item $val11 of AE,AD

val12=$(tmp0)
tmp0=!item $val11 of $val8,$val9

val13=$[rint($(tmp0))]
tmp0=!randitem 2,3,4

val14=$[rint($(tmp0))]
val15=$[rint($val13*$val14)]
val16=$[rint($val8+$val10*($val14+1)+$val9*($val14-1))]
replytype1=default
replyname1=La longueur
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-8">	    Des élèves participent à un cross. Avant le départ, un plan leur a été remis	   (les dimensions ne sont pas respectées).	   <p>	    On peut lire les indications suivantes&nbsp;:	   </p>	   <div class="wimscenter">	     AB = $val8 m ; AC = $val9 m ; $val12 = $val15 m.	   </div>	   L'angle A est droit. Les droites (BC) et (DE) sont parallèles.	   <p>	    Quelle est la longueur du parcours ABCDE ?	   </p>	   <div class="wimscenter"> 
!read oef/embed.phtml r1,6 
$() m</div>	  </div>	  <div class="cell small-12 medium-6 large-4">	     <img src="$val1/cross.png" alt="la carte">	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,8,9,12,15
embedcnt=1
