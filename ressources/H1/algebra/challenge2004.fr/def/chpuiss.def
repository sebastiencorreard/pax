!set title=Chiffres de puissance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 8

val6=$[rint($(tmp0))]
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
val8=$[rint($val6$val7)]
val9=$[rint(9*($val8-2)+(9-$val6)+(10-$val7))]
replytype1=default
replyname1=Somme des chiffres
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Quelle est la somme des chiffres de 
!insmath 10^$val8 - $val8
$() ?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=0
