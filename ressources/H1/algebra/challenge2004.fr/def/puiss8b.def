!set title=Puissances 8 - b
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(4)]
val7=$[rint(8)]
tmp0=!shuffle $val6^3

val8=$(tmp0)
val8=$(val8[1..20])
val9=
val10=
!for val11 =1 to $val7 
val12=$[rint(($(val8[$val11]))%$val6+3)]
val13=$[rint((floor($(val8[$val11])/$val6))%$val6+3)]
val14=$[rint((floor($(val8[$val11])/$val6^2))+2)]
tmp0=!append item $val12^($val13^$val14) to $val9

val9=$(tmp0)
tmp0=!append item log($val12)*($val13^$val14) to $val10

val10=$(tmp0)
!next
tmp0=!values x for x in $val10

val15=$(tmp0)
tmp0=!makelist \(x) for x in $val9

val9=$(tmp0)
tmp0=!sort numeric items $val15

val16=$(tmp0)
val17=
!for val11 =1 to $val7 
tmp0=!positionof item $(val16[$val11]) in $val15

val18=$[rint($(tmp0))]
tmp0=!append item $val18 to $val17

val17=$(tmp0)
!next
tmp0=!item $val17 of $val9

val19=$(tmp0)
val20=55x55x$val7
replytype1=dragfill
replyname1=L'ordre
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Rangez les $val7 nombres suivants selon leur ordre de grandeur,	  du plus petit au plus grand.	  <div class="wimscenter">	    
!read oef/embed.phtml r1,$val20 
$()	  </div>	 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,20
embedcnt=1
