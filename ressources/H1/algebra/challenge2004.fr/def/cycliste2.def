!set title=Cycliste II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Un cycliste avance
val7=$[rint(15)]
val8=$[rint(50)]
tmp0=!randint $val7/1.8, $val8/1.8

val9=$[$(tmp0)*0.5]
val10=$[$val9*3.6]
val11=\(\textrm{m/s}\)
val12=\(\textrm{km/h}\)
replyname1=La vitesse en km/h
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6 à une vitesse moyenne de $val9 $val11. Quelle est cette vitesse en	$val12&nbsp;?	 
!read oef/embed.phtml r1,6 
$() $val12	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,11,12
embedcnt=1
