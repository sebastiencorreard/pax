!if $status=waiting
 !exit
!endif

tmp0=!shuffle 10

val6=$(tmp0)
tmp0=!item 1 to 5 of $val6

tmp1=!sort numeric items $(tmp0)

val6=$(tmp1)
tmp0=!item 1 of $val6

val7=$[rint($(tmp0))]
tmp0=!item 2 of $val6

val8=$[rint($(tmp0))]
tmp0=!item 3 of $val6

val9=$[rint($(tmp0))]
tmp0=!item 4 of $val6

val10=$[rint($(tmp0))]
tmp0=!item 5 of $val6

val11=$[rint($(tmp0))]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
val13=$[rint($val12+$val7)]
val14=$[rint($val12+$val8)]
val15=$[rint($val12+$val9)]
val16=$[rint($val12+$val10)]
val17=$[rint($val12+$val11)]
tmp0=!shuffle 6

val18=$(tmp0)
tmp0=!item 1 of $val18

val19=$[rint($(tmp0)+1994)]
tmp0=!item 2 of $val18

val20=$[rint($(tmp0)+1994)]
tmp0=!item 1 of $val18

tmp1=!item $(tmp0) of $val12,$val13,$val14,$val15,$val16,$val17

val21=$[rint($(tmp1)*10)]
tmp0=!item 2 of $val18

tmp1=!item $(tmp0) of $val12,$val13,$val14,$val15,$val16,$val17

val22=$[rint($(tmp1)*10)]
tmp0=!shuffle 6

val23=$(tmp0)
tmp0=!item 1 of $val23

val24=$[rint($(tmp0)+1994)]
tmp0=!item 2 of $val23

val25=$[rint($(tmp0)+1994)]
tmp0=!item 1 of $val23

tmp1=!item $(tmp0) of $val12,$val13,$val14,$val15,$val16,$val17

val26=$[rint($(tmp1)*10)]
tmp0=!item 2 of $val23

tmp1=!item $(tmp0) of $val12,$val13,$val14,$val15,$val16,$val17

val27=$[rint($(tmp1)*10)]
replytype1=numeric
replyname1=Chiffres d'affaire de $val19
replygood1=$[$val21]
replytype2=numeric
replyname2=Chiffres d'affaire de $val20
replygood2=$[$val22]
replytype3=numeric
replyname3=L'année de $val26 millions
replygood3=$[$val24]
replytype4=numeric
replyname4=L'année de $val27 millions
replygood4=$[$val25]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

