!set title=Montre en avance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of d'avance,de retard

val7=$(tmp0)
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
tmp0=!item $val8 of 24,12

val9=$(tmp0)
tmp0=!item $val8 of 1,2

val10=$[rint($(tmp0))]
tmp0=!randitem 2,3,4,5,6,8,9,10,12,15,16,18,20

val11=$[rint($(tmp0))]
val12=$[3600/($val11*$val10)]
replytype1=numeric
replyname1=Nombre de jours
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Ma montre qui indique les $val9 heures prend $val11 secondes $val7 par heure.	  Je viens de la mettre à	  l'heure. Dans combien de jours indiquera-t-elle à nouveau l'heure exacte ?	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,11
embedcnt=0
