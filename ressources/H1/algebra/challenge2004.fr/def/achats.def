!set title=Achats
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem bus,train

val6=$(tmp0)
tmp0=!randint 15, 38

val7=$[$(tmp0)/10]
tmp0=!randint 10, 29

val8=$[$(tmp0)/10]
tmp0=!randint 2, 8

val9=$[rint($(tmp0))]
tmp0=!randint 5, 10*$val8-2

val10=$[$(tmp0)/10]
val11=$[$val10+$val9*$val8+$val7]
replytype1=numeric
replyname1=Nombre de boissons
replygood1=$[$val9]
replytype2=numeric
replyname2=Somme qui reste
replygood2=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Je dispose de $val11 euros, je dois aller à la ville en $val6	pour acheter des boissons à $val8 euros l'unité. Le ticket de $val6	aller et retour coûte $val7 euros.	<div>	Combien puis-je, au maximum, acheter	de boissons ?  
!read oef/embed.phtml reply 1,2 
$()	</div>	<div>	Et combien me restera-t-il ?  
!read oef/embed.phtml reply 2,6 
$() euros.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,11
embedcnt=2
