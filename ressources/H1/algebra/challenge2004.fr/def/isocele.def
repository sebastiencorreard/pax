!set title=Triangle isocèle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem A,B,C

val6=$(tmp0)
tmp0=!randint 95, 175

val7=$[rint($(tmp0))]
val8=$[rint(2*$val7-180)]
replyname1=L'angle A
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Dans un triangle ABC isocèle de sommet $val6, soit I le point commun des	  bissectrices des angles B et C. <p>	  L'angle BIC vaut $val7 degrés, combien vaut l'angle A ?	 
!read oef/embed.phtml r1,3 
$() degrés.	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
