!set title=Cheveu
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 20

val6=$[rint($(tmp0))]
tmp0=!randint 8, 16

val7=$[$(tmp0)/100]
val8=$[10*$val6*(0.25*pi*$val7^2)]
replytype1=numeric
replyname1=Volume du cheveu
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Un cheveu est long de $val6 
!insmath cm
$(), et il a un diamètre constant de $val7 
!insmath mm
$().	  Quel est son volume&nbsp;?	<div class="wimscenter">	  
!read oef/embed.phtml r1,8 
$() 
!insmath mm^2
$().	</div>	<div class="wims_instruction">	  Précision requise : 4 chiffres après la virgule.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
