!set title=Libraire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 39

val6=$[rint($(tmp0))]
tmp0=!randint 5, 39

val7=$[rint($(tmp0))]
tmp0=!shuffle 20

val8=$(tmp0)
tmp0=!item 1 of $val8

val9=$[rint($(tmp0)+3)]
tmp0=!item 2 of $val8

val10=$[rint($(tmp0)+3)]
val11=$[rint($val9*$val6+$val10*$val7)]
val12=$[rint($val6+$val7)]
replytype1=numeric
replyname1=Nombre de livres à $val9 euros
replygood1=$[$val6]
replytype2=numeric
replyname2=Nombre de livres à $val10 euros
replygood2=$[$val7]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Un libraire a vendu $val12 livres, les uns à $val9 euros et les	autres à $val10 euros, pour une somme totale de $val11 euros.	Combien a-t-il vendu de livres de chaque sorte ?	<ul>	 <li>  
!read oef/embed.phtml reply 1,3 
$() à $val9 euros </li>	 <li>  
!read oef/embed.phtml reply 2,3 
$() à $val10 euros </li>	</ul>	
$()
!exit

