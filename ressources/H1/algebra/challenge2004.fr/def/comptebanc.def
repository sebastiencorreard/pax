!set title=Compte bancaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=créditrice
val7=débitrice
tmp0=!randitem -1,1

val8=$[rint($(tmp0))]

!ifval $val8>0
val9=$val6
!else
val9=$val7
!endif
tmp0=!randint 30, 99

val10=$[rint($(tmp0)*10)]
tmp0=!randitem -1,1

val11=$[rint($(tmp0))]
tmp0=!randint 20, 120

val12=$[rint($(tmp0)*10)]

!ifval $val11>0
val13=Je mets sur mon compte un chèque de $val12 euros
!else
val13=	 J'établis un chèque de $val12 euros pour mes achats	
!endif
val14=$[rint($val8*$val10+($val11*$val12))]

!ifval $val14>0
val15=$[rint(1)]
!else
val15=$[rint(2)]
!endif
val16=$[rint(abs($val14))]
replytype1=menu
replyname1=La nouvelle position
replygood1=$val15;$val6,$val7
replytype2=numeric
replyname2=Le nouveau montant
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Mon compte bancaire est en position $val9 pour un montant de	$val10 euros. $val13.	<p>	Mon compte sera en position  
!read oef/embed.phtml reply 1 
$() pour un montant de	 
!read oef/embed.phtml reply 2,5 
$() euros.	</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,13
embedcnt=2
