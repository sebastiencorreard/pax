!set title=Equations de droites parallèles
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 6

val6=$(tmp0)
tmp0=!randitem 1,-1

val7=($(val6[1])+1)*$(tmp0)
tmp0=!randitem 1,-1

val8=($(val6[2])+1)*$(tmp0)
tmp0=!shuffle 8

val9=$(tmp0)
tmp0=!randitem 1,-1

val10=($(val9[1])+1)*$(tmp0)
tmp0=!randitem 1,-1

val11=($(val9[2])+1)*$(tmp0)
val12=$[rint($(val9[1])*$val7)]
val13=$[rint(-($(val9[1]))*$val8)]
tmp0=!randint 1, 30

tmp1=!randitem 1,-1

val14=$[rint($(tmp0)*$(tmp1))]
val15=$[rint($(val9[2])*$val7)]
val16=$[rint($(val9[2])*$val8)]
val17=$val12,$val13,$val15,$val16
tmp0=!randint 1, 4

val18=$[rint($(tmp0))]
val19=$(val17[$val18])
tmp0=!replace item number $val18 by k in $val17

val17=$(tmp0)
replytype1=default
replyname1=\(k)
replygood1=$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Trouver le coefficient 
!insmath k
$() pour que les deux droites suivantes soient	  parallèles :	<ul>	  <li>
!insmath $(val17[2])*y = $(val17[1])*x + $val14
$()</li>	  <li>
!insmath $(val17[3])*x + $(val17[4])*y + $val14 = 0
$()</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,17
embedcnt=0
