!set title=Herbe et foin
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 55, 80

val6=$[rint($(tmp0))]
tmp0=!randint 8, 18

val7=$[rint($(tmp0))]
val8=$[1000*(100-$val6)/(100-$val7)]
val9=$[rint(floor($val8))]
val10=$[rint(ceil($val8))]
val11=$[rint(rint($val8))]
replytype1=range
replyname1=Poids de foin
replygood1=!rawmath $val9,$val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  L'herbe fraiche contient une partie sèche et de l'eau ;	  dans l'herbe fraiche, le pourcentage d'eau est $val6%.	  après plusieurs jours de séchage, on a du foin, et le pourcentage d'eau est	  tombé à $val7%.	<p>	  Quel poids de foin a-t-on avec une tonne d'herbe fraiche ?	</p><div class="wimscenter">	 
!read oef/embed.phtml r1,6 
$() kg (arrondis au kg près).	</div>	
$()
