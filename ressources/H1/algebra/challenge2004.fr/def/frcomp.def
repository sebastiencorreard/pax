 !exit
!endif

tmp0=!randint 11112, 99998

val6=$[rint($(tmp0))]
tmp0=!randint 11112, 99998

val7=$[rint($(tmp0))]
val8=$[rint($val6)]
val9=$[rint($val7)]
tmp0=!randitem 1,2

!if $(tmp0)=1 
val10=$[rint(1)]
val11=3
!else
val10=$[rint(-1)]
val11=1
!endif
tmp0=!randitem 1,2

!if $(tmp0)=1 
val9=$[rint($val7+($val10))]
!else
val8=$[rint($val6-($val10))]
!endif
replytype1=menu
replyname1=Le pourcentage
replygood1=$val11;plus petit que, égal à, plus grand que
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

