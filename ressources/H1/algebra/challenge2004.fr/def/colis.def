!set title=Colis
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6

val6=$(tmp0)
tmp0=!sort numeric items $(val6[1..3])

val6=1,$(tmp0)
tmp0=!randint 90, 110

val7=$[$(tmp0)/10]
tmp0=!randint 50, 80

val8=$[$(tmp0)/10]
tmp0=!randint 25, 45

val9=$[$(tmp0)/10]
tmp0=!values $val7*x for x in $val6

val10=$(tmp0)
tmp0=!values $val8*x for x in $val6

val11=$(tmp0)
tmp0=!values $val9*x for x in $val6

val12=$(tmp0)
tmp0=!shuffle 2,3,4

val13=$(tmp0)
tmp0=!sort numeric items $(val13[1,2])

val13=$(tmp0)
tmp=!translate ";': to $     $ in $(val6[$(val13[2])])^3/$(val6[$(val13[1])])^3

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val14=$(tmp0)
replyname1=Coefficient N°2
replygood1=$(val6[2])
replyname2=Coefficient N°3
replygood2=$(val6[3])
replyname3=Coefficient N°4
replygood3=$(val6[4])
replytype4=default
replyname4=Rapport du volume
replygood4=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Pour l'expédition de colis, la poste vend plusieurs boites en carton&nbsp;:	<table class="wimscenter wimsborder">	<tr><th>Numéro de la boite</th><th>N°1</th><th>N°2</th><th>N°3</th><th>N°4</th></tr>	<tr><th>Largeur</th>	 
!for m_i=1 to 4 
$()<td>$(val10[$m_i])</td> 
!next
$()	</tr>	<tr><th>Hauteur</th>	 
!for m_i=1 to 4 
$()<td>$(val11[$m_i])</td> 
!next
$()	</tr>	<tr><th>Profondeur</th>	 
!for m_i=1 to 4 
$()<td>$(val12[$m_i])</td> 
!next
$()	</tr>	<tr><th>Coefficient d'agrandissement</th>	<td>1</td>	 
!for m_i=1 to 3 
$()<td> 
!read oef/embed.phtml r\i,3 
$()</td> 
!next
$()	</tr>	</table>	<p>	  Remplissez les coefficients d'agrandissement dans le tableau.	</p>	  Quel est le rapport du volume de la boite $(val13[2]) par rapport à la boite	$(val13[1]) ?  
!read oef/embed.phtml r4,9 
$()	
$()
!exit

