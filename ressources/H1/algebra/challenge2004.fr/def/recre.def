!set title=Récréation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=h
val7=retard,avance
tmp0=!randitem horloge,montre

val8=$(tmp0)
val9=$[rint(200)]
tmp0=!randitem 9,10,11,2,3,4

val10=$[rint($(tmp0))]
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
tmp0=!item $val10 of 1,deux,trois,quatre,5,6,7,8,neuf,dix,onze

val12=$(tmp0)
tmp0=!item $val11 of  pile, et quart, et demi, moins le quart

val13=$(tmp0)
tmp0=!item $val11 of 0,15,30,-15

val11=$[rint($(tmp0))]
val14=$[rint($val10*60+($val11))]
tmp0=!randint 4, 36

val15=$[rint($(tmp0))]
val16=$[rint($val11-$val15)]
val17=$[rint(0)]
!readproc slib/draw/clock $val10:$val16:$val17,$val9,1,nosecond 
tmp0=$slib_out
val18=$(tmp0)
replytype1=numeric
replyname1=Nombre de minutes
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-8">	    Le cours commence à $val12 heures $val13.	    Les élèves peuvent encore jouer pendant	     
!read oef/embed.phtml reply 1,2 
$() minutes.	  </div>	  <div class="cell small-12 medium-6 large-4">	     
!read oef/draw.phtml $val9,$val9 \
$val18 
$()	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,12,13,18
embedcnt=1
