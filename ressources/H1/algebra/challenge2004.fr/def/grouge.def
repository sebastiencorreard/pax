!set title=Globules rouges
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 4,5,6,7

val6=$[rint($(tmp0))]
tmp0=!randitem 2,3,4,5,6,7,8,12,14,15,16,18,20,25,30,40,50

val7=$[rint($(tmp0))]
val8=$[rint($val6*$val7)]
val9=$[rint(floor(log10($val8)))]
val10=$[$val8/10^$val9]
val11=$[rint(9+$val9)]
replytype1=numeric
replyname1=a
replygood1=$[$val10]
replytype2=numeric
replyname2=b
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Lors d'une analyse de sang, on a dénombré 
!insmath $val6*10^6
$() globules	rouges par 
!insmath mm^3
$() de sang.	<p>	Combien y a-t-il de globules rouges dans $val7 
!insmath cm^3
$() de ce sang ?	</p>	<div class="wimscenter">	    
!read oef/embed.phtml reply 1,4 
$()&times;10<sup> 
!read oef/embed.phtml reply 2,2 
$()</sup>	</div>	<div class="wims_instruction">	 Ecrivez la réponse sous forme 
!insmath a*10^b
$(), avec 
!insmath 1 <= a < 10
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=2
