!set title=Equation avec puissance
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
computeanswer=no
precision=10000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 30

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randitem 2,4,5,8,10,20

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=!rawmath $val6+$val7*x
tmp0=!randitem 5,7,9

val9=$[rint($(tmp0))]
val10=$[-($val6+1)/($val7)]
replytype1=default
replyname1=\(x)
replygood1=$val10,non
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  Résoudre l'équation 
!insmath ($val8)^$val9 = -1
$().	<div class="wims_instruction">	  Taper <span class="tt">non</span> si vous pensez qu'il n'y a pas de solution.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=0
