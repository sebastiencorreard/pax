\title{Réduction de prix I}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{prix1=randint(2..30)*randint(20,40,60)}
\integer{aug=random(5,10,15,20,25,30)}
\integer{prix2=\prix1*(1-\aug/100)}
\text{obj=slib(life/frcommodity \prix1,\prix2)}
\text{art=item(1,\obj)}
\text{nom=item(2,\obj)}
\text{Art=wims(translate u to U in \art)}
\text{red=random(une réduction,un rabais)}

\statement{\Art \nom dont le prix initial était \prix1 euros a eu
\red de \aug pourcents.
<p>
Quel est le nouveau prix ?
\embed{reply 1,4} euros.
</p>
}

\answer{Le nouveau prix}{\prix2}{type=number}

