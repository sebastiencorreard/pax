\statement{
Cette forme bleue est dessinée dans un carré de 4 cm de côté. Quelle est
son aire ?
<div class="wimscenter">
Aire = \embed{reply 1,5} \(cm^2)
</div>
<div class="wimscenter">
\draw{160,180}{
 transparent white
 xrange \xrange
 yrange \yrange
 frect 0,0,4,4,yellow
 fpoly blue,\polygon
 poly black,\polygon
 parallel 0,0,0,4,1,0,5,black
 parallel 0,0,4,0,0,1,5,black
}
</div>
}

