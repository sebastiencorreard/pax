\title{Augmentation de prix II}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{prix1=randint(3..20)*random(10,20,30,40,50,100)}
\integer{aug=random(4,5,6,8,10,12,15,17,18,20,23,25,27,30)}
\real{prix2=\prix1*(1+\aug/100)}
\text{obj=slib(life/frcommodity \prix1,\prix2)}
\text{art=item(1,\obj)}
\text{nom=item(2,\obj)}
\text{Art=wims(translate u to U in \art)}
\text{vendu=\art issametext un?vendu:vendue}

\statement{\Art \nom dont le prix initial était \prix1 euros est \vendu
\prix2 euros.
<p>
Quel est le pourcentage d'augmentation ?
\embed{reply 1,3} %
</p>
}

\answer{Le pourcentage}{\aug}{type=number}

