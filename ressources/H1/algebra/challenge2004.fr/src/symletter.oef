\title{Symétrie des lettres}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{yesno=oui,non}
\matrix{data=
A,1,2
B,1,2
C,1,2
D,1,2
E,1,2
F,2,2
G,2,2
H,1,1
I,1,1
K,2,2
L,2,2
M,1,2
N,2,1
O,1,1
P,2,2
R,2,2
S,2,1
T,1,2
U,1,2
V,1,2
W,1,2
X,1,1
Y,1,2
Z,2,1
}
\integer{n=rows(\data)}
\text{sh=shuffle(\n)}
\text{L1=row(item(1,\sh),\data)}
\text{L2=row(item(2,\sh),\data)}
\text{L3=row(item(3,\sh),\data)}
\text{L4=row(item(4,\sh),\data)}
\text{l1=item(1,\L1)}
\text{l2=item(1,\L2)}
\text{l3=item(1,\L3)}
\text{l4=item(1,\L4)}
\text{c11=item(2,\L1)}
\text{c21=item(2,\L2)}
\text{c31=item(2,\L3)}
\text{c41=item(2,\L4)}
\text{c12=item(3,\L1)}
\text{c22=item(3,\L2)}
\text{c32=item(3,\L3)}
\text{c42=item(3,\L4)}

\statement{Parmi les lettres suivantes, lesquelles ont un axe de symétrie,
lesquelles ont un centre de symétrie ?
<table class="wimsborder wimscenter">
<tr><th>Lettre</th><th>Axe de symétrie</th><th>Centre de symétrie</th></tr>
<tr><td>\L1[1]</td>
<td>\embed{reply 1}</td>
<td>\embed{reply 2}</td></tr>
<tr><td>\L2[1]</td>
<td>\embed{reply 3}</td>
<td>\embed{reply 4}</td></tr>
<tr><td>\L3[1]</td>
<td>\embed{reply 5}</td>
<td>\embed{reply 6}</td></tr>
<tr><td>\L4[1]</td>
<td>\embed{reply 7}</td>
<td>\embed{reply 8}</td></tr>
</table>
}

\answer{Centre pour \l1}{\c11;\yesno}{type=radio}
\answer{Axe pour \l1}{\c12;\yesno}{type=radio}
\answer{Centre pour \l2}{\c21;\yesno}{type=radio}
\answer{Axe pour \l2}{\c22;\yesno}{type=radio}
\answer{Centre pour \l3}{\c31;\yesno}{type=radio}
\answer{Axe pour \l3}{\c32;\yesno}{type=radio}
\answer{Centre pour \l4}{\c41;\yesno}{type=radio}
\answer{Axe pour \l4}{\c42;\yesno}{type=radio}
