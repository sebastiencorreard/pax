\title{Récréation}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{h=h}
\text{retav=retard,avance}
\text{montre=random(horloge,montre)}
\integer{size=200}
\integer{xh=random(9,10,11,2,3,4)}
\integer{xm=random(1..4)}
\text{htext=item(\xh,1,deux,trois,quatre,5,6,7,8,neuf,dix,onze)}
\text{mtext=item(\xm, pile, et quart, et demi, moins le quart)}
\integer{xm=item(\xm,0,15,30,-15)}
\integer{tc=\xh*60+(\xm)}
\integer{delai=random(4..36)}
\integer{dm=\xm-\delai}
\integer{sec=0}
\text{clock=slib(draw/clock \xh:\dm:\sec,\size,1,nosecond)}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    Le cours commence à \htext heures \mtext.
    Les élèves peuvent encore jouer pendant
    \embed{reply 1,2} minutes.
  </div>
  <div class="cell small-12 medium-6 large-4">
    \draw{\size,\size}{\clock}
  </div>
</div>
}

\answer{Nombre de minutes}{\delai}{type=number}
