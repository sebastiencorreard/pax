\title{Secondes}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{m1=random(2,3,4)*10+random(1..9)}
\integer{m2=random(2..8)}
\integer{ss2=random(1..5)*10+random(1..9)}
\integer{h3=random(1,2,3)}
\integer{m3=random(1,2,3,4)*10+random(1..9)}
\integer{ss3=random(0..5)*10+random(1..9)}
\integer{s1=\m1*60}
\integer{s2=\m2*60+\ss2}
\integer{s3=\h3*3600+\m3*60+\ss3}

\statement{Exprimez en secondes :
<ul><li>
\m1 mn = \embed{reply 1,5} s
</li><li>
 \m2 mn \ss2 s = \embed{reply 2,5} s
</li><li>
\h3 h \m3 mn \ss3 s = \embed{reply 3,5} s
</li></ul>
}

\answer{La réponse 1}{\s1}{type=number}
\answer{La réponse 2}{\s2}{type=number}
\answer{La réponse 3}{\s3}{type=number}
