\title{Réduction de prix III}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{prix1=randint(1..30)*randint(20,40,60)}
\integer{aug=random(5,10,15,20,25,30)}
\integer{prix2=\prix1*(1-\aug/100)}
\text{obj=slib(life/frcommodity \prix1,\prix2)}
\text{art=item(1,\obj)}
\text{nom=item(2,\obj)}
\text{Art=wims(translate u to U in \art)}
\text{vendu=\art issametext un?vendu:vendue}
\text{red=random(une réduction,un rabais)}

\statement{Après \red de \aug pourcents,
\art \nom est \vendu \prix2 euros.
<p>
Quel est son ancien prix ?
\embed{reply 1,4} euros.
</p>
}

\answer{L'ancien prix}{\prix1}{type=number}

