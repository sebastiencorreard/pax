\title{Aire quadrillé}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{sh=shuffle(3,4,5,6,7)}
\integer{y1=item(1,\sh)}
\integer{y2=item(2,\sh)}
\integer{y3=item(3,\sh)}
\integer{x2=random(3,4)}
\real{aire=4*((\y1+\y2-2)/2*(\x2-1)+(\y2+\y3-2)/2*(6-\x2))}

\statement{
Ce quadrillage est composé de carrés de 2 cm de côté. Calculez l'aire de la
forme hachurée en rouge.
<div class="wimscenter">
Aire = \embed{reply 1,5} \(cm^2)
</div>
<div class="wimscenter">
\draw{160,180}{
 transparent white
 xrange -0.5,7.5
 yrange -0.5,8.5
 polygon black,1,1,1,\y1,\x2,\y2,6,\y3,6,1
 linewidth 3
 hatchfill 1.5,1.5,7,-7,red
 linewidth 1
 parallel 0,0,7,0,0,1,9,black
 parallel 0,0,0,8,1,0,8,black
}
</div>
}

\answer{L'aire}{\aire}{type=number}
