\title{2 langues}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{langues=shuffle(l'allemand, l'italien, le grec, le latin,
	l'espagnol)}
\text{lang1=item(1,\langues)}
\text{lang2=item(2,\langues)}
\integer{p1=random(6..35)}
\integer{p2=random(6..35)}
\integer{comm=random(2..min(\p1,\p2)-3)}
\integer{comple=100-\p1-\p2+\comm}

\statement{Dans un lycée, \p1% des élèves apprennent \lang1, \comple%
n'apprennent ni \lang1 ni \lang2, \comm% apprennent les deux langues.
<p>
Quel est le pourcentage de ceux qui apprennent \lang2 ? \embed{reply 1,2}%.
</p>
}

\answer{Le pourcentage}{\p2}{type=number}

