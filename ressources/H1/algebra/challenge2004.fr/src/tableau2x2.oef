\title{Tableau à 2 entrées}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{vp=random(1,2)}
\integer{hp=random(1,2)}
\integer{vh=random(1,2)}
\integer{min=25}
\integer{max=60}
\integer{n11=random(\min..\max)}
\integer{n12=random(\min..\max)}
\integer{n21=random(\min..\max)}
\integer{n22=random(\min..\max)}
\integer{n13=\n11+\n12}
\integer{n23=\n21+\n22}
\integer{n31=\n11+\n21}
\integer{n32=\n12+\n22}
\integer{n33=\n13+\n23}
\matrix{table=\n11,\n12
\n21,\n22}
\integer{pos=\hp+2*\vp-2}
\integer{rep1=item(\pos,\n12,\n11,\n11,\n11)}
\integer{rep2=item(\pos,\n21,\n21,\n12,\n12)}
\integer{rep3=item(\pos,\n22,\n22,\n22,\n21)}
\integer{rep4=\vh=1?item(\hp,\n23,\n13):item(\vp,\n32,\n31)}
\integer{rep5=\n33}
\integer{r12=item(\pos,1,2,2,2)}
\integer{r21=item(\pos,2,2,3,3)}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-12 large-6">
   Ce tableau représente la répartition des employés d'une entreprise
   en hommes et femmes, verticalement, selon qu'ils se définissent
   comme principalement francophones ou anglophones, horizontalement.
   <p>On vous demande de retrouver les cinq effectifs manquants.</p>
  </div>
  <div class="cell small-12 medium-12 large-6">
    <table class="wimsborder wimscenter">
    <tr><th>/</th><th>Hommes</th><th>Femmes</th><th>total</th></tr>
    <tr><th>Francophones</th>
    <td>\if{\hp=1 and \vp=1}{\n11}{\embed{reply 1,3}}</td>
    <td>\if{\hp=2 and \vp=1}{\n12}{\embed{reply \r12,3}}</td>
    <td>\if{\vh=2 or \hp=1}{\n13}{\embed{reply 4,3}}</td>
    </tr><tr><th>Anglophones</th>
    <td>\if{\hp=1 and \vp=2}{\n21}{\embed{reply \r21,3}}</td>
    <td>\if{\hp=2 and \vp=2}{\n22}{\embed{reply 3,3}}</td>
    <td>\if{\vh=2 or \hp=2}{\n23}{\embed{reply 4,3}}</td>
    </tr><tr><th>total</th>
    <td>\if{\vh=1 or \vp=1}{\n31}{\embed{reply 4,3}}</td>
    <td>\if{\vh=1 or \vp=2}{\n32}{\embed{reply 4,3}}</td>
    <td>\embed{reply 5,3}</td>
    </tr>
    </table>
  </div>
</div>
}

\answer{Case 1}{\rep1}{type=number}
\answer{Case 2}{\rep2}{type=number}
\answer{Case 3}{\rep3}{type=number}
\answer{Case 4}{\rep4}{type=number}
\answer{Case 5}{\rep5}{type=number}
