\title{Compte bancaire}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{cred=créditrice}
\text{deb=débitrice}
\integer{pos1=random(-1,1)}
\text{Pos1=\pos1>0?\cred:\deb}
\integer{mont1=random(30..99)*10}
\integer{op=random(-1,1)}
\integer{mont2=random(20..120)*10}
\text{Op=\op>0?Je mets sur mon compte un chèque de \mont2 euros:
 J'établis un chèque de \mont2 euros pour mes achats
}
\integer{rem=\pos1*\mont1+(\op*\mont2)}
\integer{Pos2=\rem>0?1:2}
\integer{mont3=abs(\rem)}

\statement{Mon compte bancaire est en position \Pos1 pour un montant de
\mont1 euros. \Op.
<p>
Mon compte sera en position \embed{reply 1} pour un montant de
\embed{reply 2,5} euros.
</p>
}

\answer{La nouvelle position}{\Pos2;\cred,\deb}{type=menu}
\answer{Le nouveau montant}{\mont3}{type=number}

