\title{Quarts et tiers}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a1=randint(2..18)*5}
\integer{a2=randint(2..18)*5}
\integer{a3=randint(2..18)*5}
\integer{a4=randint(2..18)*5}

\text{words=Un quart, Les trois quarts, Le tiers, Les deux tiers}
\text{num=1,3,1,2}
\text{den=4,4,3,3}
\text{sh=shuffle(4)}
\text{w1=item(item(1,\sh),\words)}
\text{w2=item(item(2,\sh),\words)}
\text{w3=item(item(3,\sh),\words)}
\text{w4=item(item(4,\sh),\words)}
\integer{b1=\a1*item(item(1,\sh),\num)}
\integer{b2=\a2*item(item(2,\sh),\num)}
\integer{b3=\a3*item(item(3,\sh),\num)}
\integer{b4=\a4*item(item(4,\sh),\num)}
\integer{c1=\a1*item(item(1,\sh),\den)}
\integer{c2=\a2*item(item(2,\sh),\den)}
\integer{c3=\a3*item(item(3,\sh),\den)}
\integer{c4=\a4*item(item(4,\sh),\den)}

\statement{Ecrivez les valeurs correspondantes :
<ul>
<li>\w1 de \c1 : \embed{reply 1,4}</li>
<li>\w2 de \c2 : \embed{reply 2,4}</li>
<li>\w3 de \c3 : \embed{reply 3,4}</li>
<li>\w4 de \c4 : \embed{reply 4,4}</li>
</ul>
}

\answer{La réponse 1}{\b1}{type=number}
\answer{La réponse 2}{\b2}{type=number}
\answer{La réponse 3}{\b3}{type=number}
\answer{La réponse 4}{\b4}{type=number}

