\title{Parking T}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{xtot=random(100..200)}
\integer{ytot=random(\xtot*0.35..\xtot*0.6)}
\integer{x1=random(\xtot*0.25..\xtot*0.4)}
\integer{x2=random(\xtot*0.6..\xtot*0.75)}
\integer{y1=random(\ytot*0.35..\ytot*0.45)}
\integer{y2=random(\ytot*0.5..\ytot*0.6)}
\integer{xx2=\x2-\x1}
\integer{xx3=\xtot-\x2}
\real{xmean=(\x1+\x2)/2}
\integer{yy1=\ytot-\y1}
\integer{yy2=\ytot-\y2}
\integer{xmargin=\xtot*0.25}
\integer{xrange=\xtot+2*\xmargin}
\integer{ymargin=\ytot*0.25}
\integer{yrange=\ytot+2*\ymargin}
\integer{xpixel=400}
\integer{ypixel=\yrange/\xrange*\xpixel}
\real{yp=\yrange/\ypixel}
\real{xp=\xrange/\xpixel}
\if{random(1,2)=1}{
 \text{yr=-\ymargin,\ytot+\ymargin}
 \real{yy=8*\yp}
}{
 \text{yr=\ytot+\ymargin,-\ymargin}
 \real{yy=-8*\yp}
}

\if{random(1,2)=1}{
 \text{hh=text black,(\xtot+\x2)/2-20*\xp,\y2+(\yy)+10*\yp,large,\xx3 m
 text black,\x2+6*\xp,\ytot*0.85+(\yy),large,\yy2 m
 }
}{
 \text{hh=text black,\x1/2-20*\xp,\y1+(\yy)+10*\yp,large,\x1 m
 text black,\x1-40*\xp,\ytot*0.85+(\yy),large,\yy1 m
 }
}
\integer{aire=\xtot*\ytot-\x1*\yy1-\xx3*\yy2}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-8">
    Voici le parking d'un supermarché.
    Quelle est sa superficie ? 
    <div class="wimscenter">
      \embed{reply 1,5} \(\textrm{m}^2\)
    </div>
  </div>
  <div class="cell small-12 medium-6 large-4">
    \draw{\xpixel,\ypixel}{
xrange -\xmargin,\xtot+\xmargin
yrange \yr
fill 0,0,white
linewidth=2
poly red,0,0,0,\y1,\x1,\y1,\x1,\ytot,\x2,\ytot,\x2,\y2,\xtot,\y2,\xtot,0
fill 0.5*\xtot,0.1*\ytot,grey
text black,0.4*\xtot,0.25*\ytot+(\yy),medium,Parking
text black,0.5*\xtot-20*\xp,\yy-10*\yp,large,\xtot m
text black,\xmean-20*\xp,\ytot+(\yy)+10*\yp,large,\xx2 m
text black,-40*\xp,\y1/2+(\yy),large,\y1 m
text black,\xtot+6*\xp,\y2/2+(\yy),large,\y2 m
\hh
}
  </div>
</div>
}

\answer{La superficie}{\aire}{type=number}
