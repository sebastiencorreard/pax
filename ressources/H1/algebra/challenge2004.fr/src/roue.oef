\title{Roue du cycliste}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{rot=random(150..300)}
\real{vit=round(\rot*0.7*60*3.14)/1000}

\statement{Les roues d'un cycliste mesurent 0.7m de diamètre et font
\rot tours à la minute.
<p>
Quelle est la vitesse horaire du cycliste ?
\embed{reply 1,8} km/h.
</p>
<div class="wims_instruction">
On prendra \(\pi \simeq 3.14) et on conservera trois chiffres après la virgule.
</div>}

\answer{La vitesse}{\vit}{type=number}

