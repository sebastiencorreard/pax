\title{Achats}
\language{fr}
\range{-5..5}
\author{XIAO, Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{transport=random(bus,train)}
\real{billet=randint(15..38)/10}
\real{prix=randint(10..29)/10}
\integer{cnt=randint(2..8)}
\real{rendu=randint(5..10*\prix-2)/10}
\real{tot=\rendu+\cnt*\prix+\billet}

\statement{Je dispose de \tot euros, je dois aller à la ville en \transport
pour acheter des boissons à \prix euros l'unité. Le ticket de \transport
aller et retour coûte \billet euros.
<div>
Combien puis-je, au maximum, acheter
de boissons ? \embed{reply 1,2}
</div>
<div>
Et combien me restera-t-il ? \embed{reply 2,6} euros.
</div>
}

\answer{Nombre de boissons}{\cnt}{type=number}
\answer{Somme qui reste}{\rendu}{type=number}

