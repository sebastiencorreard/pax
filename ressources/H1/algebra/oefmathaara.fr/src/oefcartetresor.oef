\title{La carte au trésor}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src="\imagedir/image004.jpg" alt=""> }
\text{a=R}
\integer{\size=5}
\text{enonc=Sur une feuille quadrillée : <ul><li>
Tracer la droite (d) perpendiculaire à (AC) passant par B.
</li><li>Tracer la médiatrice de [GE].
</li><li>Elle coupe la droite (d) en O.
</li><li>Tracer le cercle de centre O et de rayon 5 carreaux.
</li><li>Le trésor se trouve à l'intersection du cercle et de la parallèle
  à la médiatrice de [GE], passant par L, mais ne se trouve pas au point L.
</li></ul>
En quel point se trouve le trésor  &#63;}

\statement{
<div class="grid-x grid-margin-x">
<div class="cell small-12 medium-6 large-7">
\enonc
</div>
<div class="cell small-12 medium-6 large-5">
\ill
</div>
</div>
<div><label for="reply1">Le trésor se trouve au point </label>: \embed{r1,\size}
</div>}

\answer{}{\rep}{type=default}

\condition{Bonne réponse }{\rep issametext \a}
