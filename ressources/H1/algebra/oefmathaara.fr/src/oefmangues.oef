\title{Des mangues, des papayes et des bananes}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{prix=15,20,25,30,35,40,45,50}
\text{prix=shuffle(\prix)}
\integer{te=2*\prix[1]+\prix[2]+\prix[3]}
\integer{ta=7*\prix[2]}
\integer{mo=3*\prix[2]+5*\prix[1]}
\integer{re=\prix[1]+2*\prix[2]+2*\prix[3]}
\text{ill=<img src="\imagedir/marche.jpg" alt=""> }

\integer{size=5}
\text{enonc=Chez Tom Ati le vendeur de fruits et légumes de Uruville,
toutes les mangues sont au même prix, toutes les papayes ont la même valeur,
aucune banane ne coûte plus cher qu'une autre.
<ul><li>
Teiki achète deux mangues, une papaye et une banane pour \te Tara ;
</li><li>Tahia achète sept papayes pour \ta Tara ;
</li><li>Moea achète trois papayes et cinq mangues pour \mo Tara ;
</li><li>Reia achète deux bananes, une mangue et deux papayes.
</li></ul>
Combien va payer Reia &#63;}

\statement{
<div class="grid-x grid-margin-x">
<div class="cell small-12 medium-6 large-7">
\enonc
</div>
<div class="cell small-12 medium-6 large-5">
\ill
</div>
</div>
<div><label for="reply1">Reia va payer</label> \embed{r1,\size} Tara.
</div>}

\answer{}{\rep}{type=default}
\condition{Bonne réponse }{\rep=\re}
