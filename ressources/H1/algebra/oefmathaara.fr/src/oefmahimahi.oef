\title{Repas de Mahi-mahi}
\language{fr}
\range{-5..5}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\integer{ma=randint(10..30)*10}
\integer{plus=randint(3..9)}
\integer{re=(\ma-10*\plus)/5}
\text{ill=<img src=\imagedir/mahimahi.jpg alt=""> }

\integer{size=5}
\text{enonc=Un mahi-mahi a mangé \ma marara pendant cinq jours.
Chaque jour, il a mangé \plus marara de plus que le jour précédent.
<div>
Combien a-t-il mangé de marara le premier jour &#63;
</div>}

\statement{
 <div class="grid-x grid-margin-x">
<div class="cell small-12 medium-6 large-7">
\enonc
</div>
<div class="cell small-12 medium-6 large-5">
\ill
</div>
</div>
<div><label for="reply1">Le premier jour, le mahi-mahi a mangé </label>
\embed{r1,\size} marara.
</div>}

\answer{}{\rep}{type=default}
\condition{Bonne réponse }{\rep=\re}
