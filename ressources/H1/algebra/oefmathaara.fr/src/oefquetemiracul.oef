\text{ill=<img src="\imagedir/tirelire.jpg" alt=""> }
\integer{a=48}
\integer{size=5}
\text{enonc=Le Père Fusion a fait une quête miraculeuse.
<ul><li>Sa tirelire contient des boutons et des pièces, tous en or ou en argent.
</li><li>
Les boutons représentent 20 % des objets de la tirelire, 40 % des pièces sont en argent.
</li></ul>
<p>Quel pourcentage des objets de sa tirelire représentent les pièces en or &#63;
</p>}

\statement{
<div class="grid-x grid-margin-x">
<div class="cell small-12 medium-6 large-7">
\enonc
</div>
<div class="cell small-12 medium-6 large-5">
\ill
</div>
</div>
\embed{r1,\size} % <label for="reply1">
  des objets de la tirelire sont des pièces d'or.</label>
}

\answer{}{\rep}{type=default}
\condition{Bonne réponse }{\rep=\a}
