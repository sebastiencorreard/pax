!set title=Tarzan
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/tarzan.jpg" alt=""> 
val7=$[rint(12)]
val8=$[rint(3)]
val9=$[rint(5)]
val10=Dans la forêt, Tarzan se déplace de liane en liane.	<p>	Il existe deux sortes de lianes : les courtes qui permettent de faire des sauts de 7 mètres	et les longues qui permettent de faire des sauts de 13 mètres.</p><p>	Tarzan veut arriver précisément sur une pierre qui se situe à 123 mètres de là où il se trouve.	<p><p>	Combien de lianes courtes et combien de lianes longues doit-il utiliser &#63;</p> 
replytype1=default
replyname1=
replygood1=?analyze 11
replytype2=default
replyname2=
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val10	</div>	<div class="cell small-12 medium-6 large-5">	$val6	</div>	</div>	<div>Il utilise  
!read oef/embed.phtml r1,$val9 
$() <label for="reply1">lianes courtes</label>	et  
!read oef/embed.phtml r2,$val9 
$() <label for="reply2">lianes longues.</label>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val11=$val7 and $val12=$val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=6,7,8,9,10,11,12
embedcnt=2
