!set title=Le poids des mots
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(269)]
val7=<img src="$val1/balance-roberval.jpg" alt=""> 
val8=$[rint(5)]
val9=Robert Val est un passionné des poids et mesures : il vient d'inventer	une nouvelle balance capable de peser les lettres, les mots et les phrases.	<ul><li>Chaque lettre a pour poids son numéro d'ordre dans notre alphabet :	<br><br>A pèse 1 ; B pèse 2 ; C pèse 3 ; ... R pèse 18 ; ... et Z pèse 26.	</li><li>	Le poids d'un mot est la somme des poids des lettres qui le composent :	par exemple, ARA pèse 20 (1+18+1). Le poids d'un groupe de mots ou d'une phrase est la somme des poids des mots de ce groupe ou de cette phrase. 	</li></ul>	Quel est le poids de « RALLYE MATHÉMATIQUE MATHAARA » &#63;
replytype1=default
replyname1=
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val9	</div>	<div class="cell small-12 medium-6 large-5">	$val7	</div>	</div>	<div><label for="reply1">RALLYE MATHÉMATIQUE MATHAARA pèse </label>	 
!read oef/embed.phtml r1,$val8 
$().	</div>
$()
!exit

