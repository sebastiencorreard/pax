!set title=Des mangues, des papayes et des bananes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=15,20,25,30,35,40,45,50
tmp0=!shuffle $val6

val6=$(tmp0)
val7=$[rint(2*$(val6[1])+$(val6[2])+$(val6[3]))]
val8=$[rint(7*$(val6[2]))]
val9=$[rint(3*$(val6[2])+5*$(val6[1]))]
val10=$[rint($(val6[1])+2*$(val6[2])+2*$(val6[3]))]
val11=<img src="$val1/marche.jpg" alt=""> 
val12=$[rint(5)]
val13=Chez Tom Ati le vendeur de fruits et légumes de Uruville,	toutes les mangues sont au même prix, toutes les papayes ont la même valeur,	aucune banane ne coûte plus cher qu'une autre.	<ul><li>	Teiki achète deux mangues, une papaye et une banane pour $val7 Tara ;	</li><li>Tahia achète sept papayes pour $val8 Tara ;	</li><li>Moea achète trois papayes et cinq mangues pour $val9 Tara ;	</li><li>Reia achète deux bananes, une mangue et deux papayes.	</li></ul>	Combien va payer Reia &#63;
replytype1=default
replyname1=
replygood1=?analyze 14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val13	</div>	<div class="cell small-12 medium-6 large-5">	$val11	</div>	</div>	<div><label for="reply1">Reia va payer</label>  
!read oef/embed.phtml r1,$val12 
$() Tara.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val14=$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=10,11,12,13,14
embedcnt=1
