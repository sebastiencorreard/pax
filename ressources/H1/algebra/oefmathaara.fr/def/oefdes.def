!set title=Des dés spéciaux
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(11)]
val7=<img src="$val1/des.jpg" alt=""> 
val8=$[rint(5)]
val9=Leila possède un dé un peu spécial. Voici deux positions de ce dé,	dont les faces sont numérotées de telle façon que des faces opposées aient toujours	la même somme.	<div>	Quel est le nombre opposé à 13 &#63;</div>
replytype1=default
replyname1=
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val9	</div>	<div class="cell small-12 medium-6 large-5">	$val7	</div>	</div>	<div><label for="reply1">Le nombre opposé à 13 est</label>  
!read oef/embed.phtml r1,$val8 
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val10=$val6
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=1
