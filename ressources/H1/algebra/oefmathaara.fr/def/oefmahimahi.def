!set title=Repas de Mahi-mahi
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 30

val6=$[rint($(tmp0)*10)]
tmp0=!randint 3, 9

val7=$[rint($(tmp0))]
val8=$[rint(($val6-10*$val7)/5)]
val9=<img src=$val1/mahimahi.jpg alt=""> 
val10=$[rint(5)]
val11=Un mahi-mahi a mangé $val6 marara pendant cinq jours.	Chaque jour, il a mangé $val7 marara de plus que le jour précédent.	<div>	Combien a-t-il mangé de marara le premier jour &#63;	</div>
replytype1=default
replyname1=
replygood1=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 <div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val11	</div>	<div class="cell small-12 medium-6 large-5">	$val9	</div>	</div>	<div><label for="reply1">Le premier jour, le mahi-mahi a mangé </label>	 
!read oef/embed.phtml r1,$val10 
$() marara.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val12=$val8
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=8,9,10,11,12
embedcnt=1
