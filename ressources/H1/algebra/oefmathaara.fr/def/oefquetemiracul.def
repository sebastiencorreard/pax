!set title=La quête miraculeuse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/tirelire.jpg" alt=""> 
val7=$[rint(48)]
val8=$[rint(5)]
val9=Le Père Fusion a fait une quête miraculeuse.	<ul><li>Sa tirelire contient des boutons et des pièces, tous en or ou en argent.	</li><li>	Les boutons représentent 20 % des objets de la tirelire, 40 % des pièces sont en argent.	</li></ul>	<p>Quel pourcentage des objets de sa tirelire représentent les pièces en or &#63;	</p>
replytype1=default
replyname1=
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	<div class="cell small-12 medium-6 large-7">	$val9	</div>	<div class="cell small-12 medium-6 large-5">	$val6	</div>	</div>	 
!read oef/embed.phtml r1,$val8 
$() % <label for="reply1">	  des objets de la tirelire sont des pièces d'or.</label>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val10=$val7
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=6,7,8,9,10
embedcnt=1
