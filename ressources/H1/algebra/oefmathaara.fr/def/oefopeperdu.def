!set title=Les opérations perdues
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000

ansorder=r,r
varcnt=3
prevarcnt=2
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=+ , - , \(\times) , \(\div) 
val7=20x20
replytype1=clickfill
replyname1=
replygood1=?analyze 8;$(val6[1])|$(val6[3])
replytype2=clickfill
replyname2=
replygood2=?analyze 9;$(val6[2])|$(val6[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter avec les signes d'opérations ( $val6 ) 	<div class="wimscenter">	
!insmath 5
$()  
!read oef/embed.phtml r1,$val7 
$() 
!insmath 
$()5  
!read oef/embed.phtml r2,$val7 
$() 
!insmath 5 = 6
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val8=$(val6[1]) and $val9 isin $(val6[4]))	  or ($val9=$(val6[1]) and $val8 isin $(val6[4]))
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=6,7,8,9
embedcnt=2
