\title{Eau de mer}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{r1=random(1,2)}
\integer{r2=random(1,2)}
\integer{r3=random(1,2)}
\text{m1=item(\r1,Un kg,Une tonne)}
\text{m2=item(\r1,grammes,kg)}
\text{m3=item(\r2,un litre,un mètre cube)}
\text{m4=item(\r2,grammes,kg)}
\text{m5=item(\r3,mètres cubes,litres)}
\text{m6=item(\r3,une tonne,un kg)}

\statement{
<div class="float_right"><img src="\imagedir/vulgaris.jpg" style="width:300px" alt=""></div>
<p>
\m1 d'eau de mer donne 32 \m2 de sel. Combien de \m5 d'eau
de mer faut-il faire évaporer pour obtenir \m6 de sel, sachant qu'\m3
d'eau de mer pèse 1025 \m4 ?
</p>
}

\answer{Nombre de \m5}{30.4878}{type=number}
