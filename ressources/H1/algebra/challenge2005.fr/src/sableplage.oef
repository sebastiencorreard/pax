\title{Sable d'une plage}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{long=random(2..5)}
\integer{large=random(10,100)}
\if{\large=10}{
 \integer{b=14}\integer{g=13}
}{
 \integer{b=13}\integer{g=14}
}
\text{sh=item(1..4,shuffle(5,6,7,8,9,10,11,12,\b,15,16,17,18,19,20))}
\text{ps=wims(sort numeric items \g,\sh)}
\text{p1=item(1,\ps)}
\text{p2=item(2,\ps)}
\text{p3=item(3,\ps)}
\text{p4=item(4,\ps)}
\text{p5=item(5,\ps)}
\integer{good=position(\g,\ps)}

\statement{La forme d'une certaine plage de la Sicile est assimilée à
un rectangle de \large mètres de large et \long kilomètres de long.
Elle contient du sable sur une profondeur uniforme de 1 mètre. On considère
que chaque grain de sable occupe environ un espace d'1 millimètre cube. Quel
est l'ordre de grandeur du nombre de grains de sable de cette plage ?
<div class="wimscenter">
 \embed{reply 1,1,\(\long*10^\p1)}
 \embed{reply 1,2,\(\long*10^\p2)}
 \embed{reply 1,3,\(\long*10^\p3)}
 \embed{reply 1,4,\(\long*10^\p4)}
 \embed{reply 1,5,\(\long*10^\p5)}
</div>}

\answer{Le nombre}{\good;\long*10^\p1,\long*10^\p2,
\long*10^\p3,\long*10^\p4,\long*10^\p5}{type=checkbox}
