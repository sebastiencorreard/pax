\title{Traversée de village}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\if{random(1,2)=1}{
 \text{nom=slib(lang/fname girl)}
}{
 \text{nom=La maman de slib(lang/fname)}
}
\integer{vit=random(15..20)*2}
\integer{dur=9*random(10..25)}
\real{len=\dur*\vit/3.6}
\integer{min=floor(\dur/60)}
\integer{sec=\dur-\min*60}

\statement{
<div class="float_right">
<img src="\imagedir/voiture.jpg" style="width:300px" alt="">
</div>
<p>\nom est une conductrice prudente. Elle traverse un village
de \len mètres de long. La limitation de vitesse est de 50km/h mais il faut
ralentir en quelques occasions et finalement elle traverse ce village à la
vitesse moyenne de \vit km/h. Quelle a été la durée de sa traversée du
village ?</p>
<div class="wimscenter">
 \embed{reply 1,2} min \embed{reply 2,2} sec
</div>}

\answer{Minutes}{\min}{type=number}
\answer{Secondes}{\sec}{type=number}
