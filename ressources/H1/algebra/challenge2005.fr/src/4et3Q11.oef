\title{L'intrus(3*2)}
\language{fr}
\statement{
Quelle est l'égalité fausse ? <ul>
<li> A &#58; \(\sqrt{3} + \sqrt{3} = 2 \sqrt{3})</li>
<li> B &#58; \(\sqrt {2 \times 3} = \sqrt{6})</li>
<li> C &#58; \(\sqrt {2 + 3} = \sqrt 5)</li>
<li> D &#58; \(\sqrt{2} \times \sqrt{3} = \sqrt{6}) </li>
<li> E &#58; \(\sqrt{2} + \sqrt{3} = \sqrt{5}).</li>
</ul>}
\choice{Choisissez}{E}{A,B,C,D}
