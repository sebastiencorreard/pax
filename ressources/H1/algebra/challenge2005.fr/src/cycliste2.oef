\title{Cycliste II}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{rot=random(150..300)}
\real{vit=round(\rot*0.7*60*3.14)/1000}

\statement{Les roues d'un cycliste mesurent 0.7m de diamètre, et il avance à
\vit km/h.
<div class="spacer">
Combien de tours les roues font-elles par minute ?
\embed{reply 1,8}
</div>
<div class="wims_instruction">
On prendra \(\pi \simeq 3.14) et on arrondit la réponse à l'entier le plus
proche.
</div>
}

\answer{La vitesse}{\rot}{type=number}

