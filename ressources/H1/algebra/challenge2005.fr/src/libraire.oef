\title{Libraire}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{num1=random(5..39)}
\integer{num2=random(5..39)}
\text{prix=shuffle(20)}
\integer{prix1=item(1,\prix)+3}
\integer{prix2=item(2,\prix)+3}
\integer{prixtot=\prix1*\num1+\prix2*\num2}
\integer{tot=\num1+\num2}

\statement{Un libraire a vendu \tot livres, les uns à \prix1 euros et les
autres à \prix2 euros, pour une somme totale de \prixtot euros.
<p>
Combien a-t-il vendu de livre de chaque sorte ?
</p>
<ul><li>
 \embed{reply 1,3} à \prix1 euros
 </li><li>
 \embed{reply 2,3} à \prix2 euros
 </li></ul>
}

\answer{Nombre de livres à \prix1 euros}{\num1}{type=number}
\answer{Nombre de livres à \prix2 euros}{\num2}{type=number}

