\title{Subst}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{sh=shuffle(1,random(2,3))}
\integer{c1=item(1,\sh)}
\integer{c2=random(1,2,3)*random(1,-1)}
\integer{c3=item(2,\sh)}
\integer{c4=random(2,3,4)*random(1,-1)}
\function{xexp=(\c1*x+\c2)*(\c4-\c3*x)}
\integer{a1=random(1,2)}
\integer{a2=random(1,2,3)*random(1,-1)}
\function{aexp=random(\a1*a+\a2,\a2+\a1*a,\a2-\a1*a)}
\function{aa=pari(wims(mathsubst x=(\aexp) in \xexp))}

\statement{Combien vaut \(\xexp), si \(x = \aexp) ?
<p>
Substituez, développez et simplifiez.
</p>}

\answer{La formule}{\aa}{type=algexp}

