\title{Parcours 2 villes}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{data=randomrow(
Toulouse, Montauban, 50
Montpellier, Nimes, 50
Nancy, Metz, 60
Marseille, Toulon, 60
Le Mans, Tours, 80
Angers, Nantes, 90
Saint-Etienne, Valence, 90
Lyon, Valence, 100
Grenoble, Valence, 100
Lyon, Grenoble, 100
Dijon, Besançon, 100
Paris, Reims, 140
Genève, Grenoble, 140
Nantes, Poitiers, 180
Genève, Besançon, 180
Bordeaux, Bayonne, 180
Toulouse, Perpignan, 200
)}
\matrix{means=
50, 75, 100, 120
60, 80, 90, 100,120
80, 100, 120
90, 75, 105, 120
100, 75,120
140, 70, 105
180, 75, 90, 105, 120
200, 75, 120
}

\text{villes=shuffle(item(1..2,\data))}
\text{ville1=item(1,\villes)}
\text{ville2=item(2,\villes)}
\integer{dist=item(3,\data)}
\integer{h1=random(7..16)}
\integer{min1=random(1..11)*5}
\text{min1=\min1=5?05}
\text{mean=item(2..-1,wims(select \means where column1=\dist))}
\integer{mean=randitem(\mean)}
\integer{time=\dist*60/\mean}
\integer{min2=\min1+\time}
\integer{carry=floor(\min2/60)}
\integer{h=\h1+\carry}
\integer{min=\min2%60}

\statement{La distance entre \ville1 et \ville2 est de \dist km.
Un automobiliste part de \ville1 à \h1 h \min1. A quelle heure arrivera-t-il
à \ville2 si sa vitesse moyenne est de \mean km/h ?
<div class="wimscenter">
 \embed{reply 1,2} h \embed {reply 2,2} min
</div>
}

\answer{Heure}{\h}{type=number}
\answer{Minute}{\min}{type=number}

