\title{Chocolats}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{prix=random(11,12,13,14,15,16,17,18)}
\integer{quant=random(4,6,7,8,9)}
\text{nom=slib(lang/fname girl)}
\integer{tot=\prix*\quant}

\statement{Une boite de chocolats coûte \prix euros. \nom en achète
\quant.
<p>Combien doit-elle payer ?</p>
<div class="wimscenter">\embed{reply 1,4} euros.</div>
}

\answer{A payer}{\tot}{type=number}
