\title{Cube coupé}
\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{n=random(4..7)}
\integer{N=\n^3}
\integer{rep=(\n-2)^3}
\text{col=randomrow(
rouge,rouge
vert,verte
blanc,blanche
noir,noire
jaune,jaune
bleu,bleue
)}
\text{col1=item(1,\col)}
\text{col2=item(2,\col)}

\statement{
Un cube peint en \col1 a été coupé en \N = \(\n^3) petits cubes identiques.
<p>
Combien d'entre eux n'ont-ils aucune face \col2 ?
</p>
}

\answer{Le nombre}{\rep}{type=number}
