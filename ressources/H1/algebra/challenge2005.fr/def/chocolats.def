!set title=Chocolats
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 11,12,13,14,15,16,17,18

val6=$[rint($(tmp0))]
tmp0=!randitem 4,6,7,8,9

val7=$[rint($(tmp0))]
!readproc slib/lang/fname girl 
tmp0=$slib_out
val8=$(tmp0)
val9=$[rint($val6*$val7)]
replytype1=numeric
replyname1=A payer
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Une boite de chocolats coûte $val6 euros. $val8 en achète	$val7.	<p>Combien doit-elle payer ?</p>	<div class="wimscenter"> 
!read oef/embed.phtml reply 1,4 
$() euros.</div>	
$()
!exit

