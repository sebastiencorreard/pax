!set title=Parcours 2 villes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 	Toulouse, Montauban, 50	Montpellier, Nimes, 50	Nancy, Metz, 60	Marseille, Toulon, 60	Le Mans, Tours, 80	Angers, Nantes, 90	Saint-Etienne, Valence, 90	Lyon, Valence, 100	Grenoble, Valence, 100	Lyon, Grenoble, 100	Dijon, Besançon, 100	Paris, Reims, 140	Genève, Grenoble, 140	Nantes, Poitiers, 180	Genève, Besançon, 180	Bordeaux, Bayonne, 180	Toulouse, Perpignan, 200	

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp=!trim 50, 75, 100, 120	60, 80, 90, 100,120	80, 100, 120	90, 75, 105, 120	100, 75,120	140, 70, 105	180, 75, 90, 105, 120	200, 75, 120	
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!item 1 to 2 of $val6

tmp1=!shuffle $(tmp0)

val8=$(tmp1)
tmp0=!item 1 of $val8

val9=$(tmp0)
tmp0=!item 2 of $val8

val10=$(tmp0)
tmp0=!item 3 of $val6

val11=$[rint($(tmp0))]
tmp0=!randint 7, 16

val12=$[rint($(tmp0))]
tmp0=!randint 1, 11

val13=$[rint($(tmp0)*5)]

!ifval $val13=5
val13=05
!endif
tmp0=!select $val7 where column1=$val11

tmp1=!item 2 to -1 of $(tmp0)

val14=$(tmp1)
tmp=!nonempty items $val14

tmp0=!randitem $tmp
val14=$[rint($(tmp0))]
val15=$[rint($val11*60/$val14)]
val16=$[rint($val13+$val15)]
val17=$[rint(floor($val16/60))]
val18=$[rint($val12+$val17)]
val19=$[rint($val16%60)]
replytype1=numeric
replyname1=Heure
replygood1=$[$val18]
replytype2=numeric
replyname2=Minute
replygood2=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()La distance entre $val9 et $val10 est de $val11 km.	Un automobiliste part de $val9 à $val12 h $val13. A quelle heure arrivera-t-il	à $val10 si sa vitesse moyenne est de $val14 km/h ?	<div class="wimscenter">	  
!read oef/embed.phtml reply 1,2 
$() h  
!read oef/embed.phtml reply 2,2 
$() min	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11,12,13,14
embedcnt=2
