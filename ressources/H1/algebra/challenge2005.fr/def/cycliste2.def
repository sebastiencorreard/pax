tmp0=!randint 150, 300

val6=$[rint($(tmp0))]
val7=$[round($val6*0.7*60*3.14)/1000]
replytype1=numeric
replyname1=La vitesse
replygood1=$[$val6]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Les roues d'un cycliste mesurent 0.7m de diamètre, et il avance à	$val7 km/h.	<div class="spacer">	Combien de tours les roues font-elles par minute ?	 
