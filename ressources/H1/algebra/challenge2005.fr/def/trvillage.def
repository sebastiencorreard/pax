!set title=Traversée de village
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang, XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 1,2

!if $(tmp0)=1 
!readproc slib/lang/fname girl 
tmp0=$slib_out
val6=$(tmp0)
!else
!readproc slib/lang/fname 
tmp0=$slib_out
val6=La maman de $(tmp0)
!endif
tmp0=!randint 15, 20

val7=$[rint($(tmp0)*2)]
tmp0=!randint 10, 25

val8=$[rint(9*$(tmp0))]
val9=$[$val8*$val7/3.6]
val10=$[rint(floor($val8/60))]
val11=$[rint($val8-$val10*60)]
replytype1=numeric
replyname1=Minutes
replygood1=$[$val10]
replytype2=numeric
replyname2=Secondes
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_right">	<img src="$val1/voiture.jpg" style="width:300px" alt="">	</div>	<p>$val6 est une conductrice prudente. Elle traverse un village	de $val9 mètres de long. La limitation de vitesse est de 50km/h mais il faut	ralentir en quelques occasions et finalement elle traverse ce village à la	vitesse moyenne de $val7 km/h. Quelle a été la durée de sa traversée du	village ?</p>	<div class="wimscenter">	  
!read oef/embed.phtml reply 1,2 
$() min  
!read oef/embed.phtml reply 2,2 
$() sec	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,7,9
embedcnt=2
