!set title=Nature d'un angle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=aigu,droit,obtus,plat
val7=Donner la mesure d'un angle
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val8=$(tmp0)
val9=<img src="\dessin" alt="">
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
replytype1=numeric
replyname1=
replygood1=?analyze 11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<label for="reply1">$val7 $(val6[$val10]) :</label>  
!read oef/embed.phtml r1,4 
$()°	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val11<90 and $val10=1 and $val11>0) or ($val11=90 and $val10=2) or	($val11>90 and $val10=3 and $val11<180) or ($val11=180 and $val10=4)
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=6,7,10,11
embedcnt=1
