val6=Comparer la mesure des angles&nbsp;
val6=Comparer la mesure des angles&nbsp;
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 2, 11

val8=$[rint($(tmp0)*10)]
tmp0=!randint 7, 16

val9=$[rint($(tmp0)*10)]
!readproc oef/draw.phtml 300,300 \
xrange -10,10	yrange -2,18	segment -7,0,-7+cos($val8*pi/180)*19,sin($val8*pi/180)*19,black	segment -7,0,7,0,black	arc -7,0,3,3,0,$val8,black	fill -7+cos($val8*pi/360),sin($val8*pi/360),red	text black,-7.5,-0.5,medium,$(val7[1])	segment -7+cos(($val8)*pi/180)*5-0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5+0.2*cos(($val8)*pi/180),-7+cos(($val8)*pi/180)*5+0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5-0.2*cos(($val8)*pi/180),black	text black,-7+cos(($val8+8)*pi/180)*6,sin(($val8+8)*pi/180)*6,medium,$(val7[2])	segment 7,0,7+cos($val9*pi/180)*19,sin($val9*pi/180)*19,black	arc 7,0,3,3,$val9,180,black	fill 7+cos(($val9+180)*pi/360),sin(($val9+180)*pi/360),blue	text black,7,-0.5,medium,$(val7[3])	segment 7+cos(($val9)*pi/180)*5-0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5+0.2*cos(($val9)*pi/180),7+cos(($val9)*pi/180)*5+0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5-0.2*cos(($val9)*pi/180),black	text black,7+cos(($val9+8)*pi/180)*6,sin(($val9+8)*pi/180)*6,medium,$(val7[4])	 
tmp0=$ins_url
val10=$(tmp0)
val11=\(\widehat{$(val7[3])$(val7[1])$(val7[2])}),\(\widehat{$(val7[1])$(val7[3])$(val7[4])})
val12=\(\ < \),\(\ = \),\(\ > \)
val13=$[rint(180-$val9)]
!if $val8<$val13 
val14=$(val12[1])
!endif
!if $val8=$val13 
val14=$(val12[2])
!endif
!if $val8>$val13 
