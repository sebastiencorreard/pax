val6=Oui,Non,Je ne sais pas
val7=Les deux angles, ont-ils la même mesure&nbsp;
val8=Pour répondre à la question, tu peux t'aider des intersections des arcs de cercle	  avec les côtés des angles.
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val9=$(tmp0)
tmp0=!randint 30, 80

val10=$[rint($(tmp0))]
tmp0=!randitem 0,5

val11=$[rint($(tmp0))]
val12=$[rint($val10+$val11)]
!if $val11=0 
val13=$[rint(1)]
!else
val13=$[rint(2)]
!endif
!readproc oef/draw.phtml 300,300 \
xrange -5,25	yrange -5,25	arc 0,0,40,40,357,3,black	arc 0,0,40,40,357+$val10,3+$val10,black	arc 0,0,10,10,0,$val10,black	seg 0,0,25,0,black	rotate $val10	seg 0,0,25,0,black	fill 3,-0.5,6,red	 
tmp0=$ins_url
val14=$(tmp0)
!readproc oef/draw.phtml 300,300 \
xrange -5,25	yrange -5,25	arc 0,0,40,40,357,3,black	arc 0,0,40,40,357+$val12,3+$val12,black	arc 0,0,10,10,0,$val12,black	seg 0,0,25,0,black	rotate $val12	seg 0,0,25,0,black	fill 3,-0.5,6,yellow	 
tmp0=$ins_url
val15=$(tmp0)
val16=<img src="$val14" alt="">
val17=<img src="$val15" alt="">
replytype1=radio
replyname1=
replygood1=$val13;$val6
