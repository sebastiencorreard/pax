!set title=Codage des angles 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Nous avons les mesures suivantes&nbsp;,	  Donner la mesure de l'angle
tmp0=!randint 10, 50

val7=$[rint($(tmp0))]
tmp0=!randint $val7+1, 85

val8=$[rint($(tmp0))]
val9=$[rint(90-$val7)]
val10=$[rint(90+$val7)]
val11=\(\widehat{CDG}), \(\widehat{ABC}),	 \(\widehat{GCD}), \(\widehat{GJK}),	 \(\widehat{DGM})
tmp0=!randint 1, 5

val12=$(tmp0)
val13=$val7,$val8,$val9,$val10,90
val14=$[rint($(val13[$val12]))]
val15=angle5b
val16=<img src="$val1/$val15.jpg" alt="">
replytype1=raw
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val16</div>	<div class="medium_size text_col">		$(val6[1])	<ul><li>	
!insmath \widehat{GHJ}
$() = $val7 °	</li><li>
!insmath \widehat{FBL}
$() = $val8 °	</li><li>
!insmath \widehat{GJH}
$() = $val9 °	</li><li>
!insmath \widehat{BCG}
$() = $val10 °	</li></ul>	$(val6[2]) $(val11[$val12]) :	<div class="wimscenter"><label for="reply1"> $(val11[$val12]) =</label>  
!read oef/embed.phtml r1,3 
$() °</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,12,16
embedcnt=1
