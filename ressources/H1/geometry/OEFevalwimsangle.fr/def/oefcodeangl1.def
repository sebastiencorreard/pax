!set title=Codage des angles 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer sur les deux angles qui ont la même mesure.
val7=\(\widehat{DBC}),\(\widehat{DAC}),	\(\widehat{ACD}),\(\widehat{DCB}),	\(\widehat{ACB})
tmp0=!shuffle 5

val8=$(tmp0)
tmp0=!positionof item 3 in $val8

val9=$[rint($(tmp0))]
tmp0=!positionof item 4 in $val8

val10=$[rint($(tmp0))]
val7=$(val7[$(val8[1])]),$(val7[$(val8[2])]),$(val7[$(val8[3])]),$(val7[$(val8[4])]),$(val7[$(val8[5])])
val11=angle1
val12=<img src="$val1/$val11.jpg" alt="">
replytype1=mark
replyname1=
replygood1=$val9,$val10;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val12</div>	<div class="medium_size text_col">		$val6 :	 
!read oef/embed.phtml r1 
$()	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12
embedcnt=1
