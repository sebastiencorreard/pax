!set title=Reproduire un angle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r,r,r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Étape
val7=Reproduction d'un angle sans rapporteur
val8=Voici les différentes étapes de la reproduction d'un angle.	  Mettre les images dans le bon ordre des étapes de construction.
val9=<img src="$val1/reproangl1r.jpg" alt="">,<img src="$val1/reproangl2r.jpg" alt="">,<img src="$val1/reproangl3r.jpg" alt="">,	<img src="$val1/reproangl4r.jpg" alt="">,<img src="$val1/reproangl5r.jpg" alt="">,<img src="$val1/reproangl6r.jpg" alt="">
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val9[1])
replytype2=dragfill
replyname2=
replygood2=$(val9[2])
replytype3=dragfill
replyname3=
replygood3=$(val9[3])
replytype4=dragfill
replyname4=
replygood4=$(val9[4])
replytype5=dragfill
replyname5=
replygood5=$(val9[5])
replytype6=dragfill
replyname6=
replygood6=$(val9[6])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<h2>$val7</h2>	<p>$val8</p>	<table class="wimscenter wimsborder">	<tr><th>$val6 1</th><th>$val6 2</th><th>$val6 3</th></tr>	<tr>	 
!for m_i=1 to 3 
$()<td> 
!read oef/embed.phtml r\i,250x250 
$()</td> 
!next
$()	</tr>	<tr><th>$val6 4</th><th>$val6 5</th><th>$val6 6</th></tr>	<tr>	 
!for m_i=4 to 6 
$()<td> 
!read oef/embed.phtml r\i,250x250 
$()</td> 
!next
$()	</tr>	</table>
$()
!exit

