!set title=Rapporteur 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner la mesure de l'angle
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 1, 17

tmp1=!randint 2, 8

val8=$[rint($(tmp0)*10+$(tmp1))]
val9=$[rint(180-$val8)]
!readproc oef/draw.phtml 515,284 \
xrange -10,10	yrange -1,10	copy -10.225,9.75,-1,-1,-1,-1,rapport.jpg	linewidth 2	segment 0,0,cos($val8*pi/180)*10,sin($val8*pi/180)*10,blue		arc 0,0,2,2,$val8,180,blue	text blue,cos(($val8-8)*pi/180)*5,sin(($val8-8)*pi/180)*5,medium,$(val7[4])	segment cos(($val8)*pi/180)*5-0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5+0.2*cos(($val8)*pi/180),cos(($val8)*pi/180)*5+0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5-0.2*cos(($val8)*pi/180),blue	segments blue, 0,0,-10,0,-5,-0.2,-5,0.2	text blue,-5,-0.2,medium,$(val7[2])	text blue,-0.5,0,medium,$(val7[1]) 
tmp0=$ins_url
val10=$(tmp0)
val11=<img src="$val10" alt="">
replytype1=raw
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val11</div>	 <div class="medium_size text_col">	$val6 
!insmath \widehat{$(val7[4])$(val7[1])$(val7[2])}
$() :	  
!read oef/embed.phtml r1,2 
$()°	 </div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11
embedcnt=1
