!set title=Nature d'un angle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=aigu,droit,obtus,plat
val7=L'angle est 
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val8=$(tmp0)
tmp0=!randitem 3,4,5,6,7,8,9,9,9,9,10,11,12,13,14,15

val9=$[rint($(tmp0))]
tmp0=!randint 2, 18-$val9

val10=$[rint($(tmp0))]
val11=$[rint(($val10+$val9)*10)]
val10=$[rint($val10*10)]
val9=$[rint($val9*10)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10		segment 0,0,cos($val10*pi/180)*9,sin($val10*pi/180)*9,black	segment 0,0,cos($val11*pi/180)*9,sin($val11*pi/180)*9,black	arc 0,0,2,2,$val10,$val11,black	fill  cos((($val10+$val11)/2)*pi/180)/2,sin((($val10+$val11)/2)*pi/180)/2,red		text black,-0.5,0,medium,$(val8[1]) 
tmp0=$ins_url
val12=$(tmp0)
!if $val9<90 
val13=1
!endif
!if $val9=90 
val13=2
!endif
!if $val9>90 and $val9<180 
val13=3
!endif
!if $val9=180 
val13=4
!endif
val14=<img src="$val12" alt="">
replytype1=radio
replyoption1=shuffle 
replyname1=
replygood1=$val13;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val14</div>	 <div class="medium_size text_col">	$val7  
!read oef/embed.phtml r1 
$()	</div></div>	
$()
!exit

