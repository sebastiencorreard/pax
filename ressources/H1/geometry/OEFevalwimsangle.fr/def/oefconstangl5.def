!set title=Construction d'un angle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Construire un angle, de,sur une feuille de brouillon.	  Placer le point B sur la demi-droite ,tel que	  Ensuite, placer le point C sur la demi-droite,tel que	  Donner la mesure du segment	
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 15, 85

val7=$[rint($(tmp0))]
tmp0=!randint 30, 90

val8=$[$(tmp0)/10]
val9=$[rint(20*$val8*sin(pi*$val7/360))]
val10=$[($val9-1)/10]
val11=$[($val9+1)/10]
replytype1=range
replyname1=
replygood1=!rawmath $val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ul>	<li>	$(val6[1;1]) 
!insmath \widehat{xAy}
$() $(val6[1;2]) $val7 ° $(val6[1;3])	</li><li>	$(val6[2;1]) &#91;Ax&#41; $(val6[2;2])  AB = $val8 cm.	</li><li>	$(val6[3;1]) &#91;Ay&#41; $(val6[3;2]) AC = $val8 cm.	</li><li>	$(val6[4;]) [BC].	<div class="wimscenter"><label for="reply1">BC =</label>  
!read oef/embed.phtml r1,4 
$() cm </div>	</li></ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
