!set title=Estimation d'un angle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner la mesure de l'angle
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
tmp0=!randint 3, 10

val9=$[rint($(tmp0))]
tmp0=!randint $val9+1, 11

val10=$[rint($(tmp0))]
val8=$[rint(($val10-$val9)*20)]
val11=\(\widehat{$(val7[$val9])$(val7[1])$(val7[$val10])})
val12=
!for val13 =0 to 9 
val14=$[rint($val13*20)]
val12=$val12	segment 0,0,cos($val14*pi/180)*9,sin($val14*pi/180)*9,black	text black,cos(($val14+9-$val13)*pi/180)*6,sin(($val14+9-$val13)*pi/180)*6,medium,$(val7[2+$val13])	segment cos(($val14)*pi/180)*5-0.2*sin(($val14)*pi/180),sin(($val14)*pi/180)*5+0.2*cos(($val14)*pi/180),cos(($val14)*pi/180)*5+0.2*sin(($val14)*pi/180),sin(($val14)*pi/180)*5-0.2*cos(($val14)*pi/180),black
!next
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	$val12	text black,0,-0.2,medium,$(val7[1]) 
tmp0=$ins_url
val12=$(tmp0)
val15=<img src="$val12" alt="">
val16=30°,50°,70°,90°,110°,130°,150°,170°
replytype1=numeric
replyname1=
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	  <div class="medium_size img_col">$val15</div>	  <div class="medium_size text_col">	  <label for="reply1">$val6 $val11</label> =  
!read oef/embed.phtml r1,4 
$()°	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,15
embedcnt=1
