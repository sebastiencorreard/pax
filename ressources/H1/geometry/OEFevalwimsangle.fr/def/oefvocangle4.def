!set title=Vocabulaire sur les angles 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=L'angle,a pour sommet , et pour côtés
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 3, 16

val8=$[$(tmp0)*10]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val8*pi/180)*9,sin($val8*pi/180)*9,black	segment 0,0,9,0,black	arc 0,0,2,2,0,$val8,black	fill cos(($val8/2)*pi/180)/2,sin(($val8/2)*pi/180)/2,red	text black,cos(($val8+8)*pi/180)*6,sin(($val8+8)*pi/180)*6,medium,$(val7[3])	segment cos(($val8)*pi/180)*5-0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5+0.2*cos(($val8)*pi/180),cos(($val8)*pi/180)*5+0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5-0.2*cos(($val8)*pi/180),black	segment 5,-0.2,5,0.2,black	text black,5,-0.2,medium,$(val7[2])	text black,-0.5,0,medium,$(val7[1]) 
tmp0=$ins_url
val9=$(tmp0)
val10=\(\widehat{$(val7[3])$(val7[1])$(val7[2])}),\(\widehat{$(val7[1])$(val7[2])$(val7[3])}),\(\widehat{$(val7[2])$(val7[3])$(val7[1])}),	 &#91; \($(val7[1])$(val7[2])) &#41; et &#91; \($(val7[1])$(val7[3])) &#41;,	 &#91; \($(val7[1])$(val7[2])) &#41; et &#91; \($(val7[3])$(val7[1])) &#41;,	 &#91; \($(val7[2])$(val7[1])) &#41; et &#91; \($(val7[3])$(val7[1])) &#41;,	 &#91; \($(val7[2])$(val7[1])) &#41; et &#91; \($(val7[1])$(val7[3])) &#41;,	\($(val7[1])),\($(val7[2])),\($(val7[3]))
val11=$(val10[2]),$(val10[3]),$(val10[5]),$(val10[6]),$(val10[7]),$(val10[9]),$(val10[10])
val12=<img src="$val9" alt="">
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val10[1]);$val11
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$(val10[8])
replytype3=dragfill
replyname3=
replygood3=$(val10[4])
