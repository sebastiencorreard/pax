!set title=Estimation d'un angle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La mesure de l'angle est&nbsp;
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
val9=$[rint($val8*2+1)]
tmp0=!randint 1, 18-$val9

val10=$[rint($(tmp0))]
val11=$[rint(($val10+$val9)*10)]
val10=$[rint($val10*10)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val10*pi/180)*9,sin($val10*pi/180)*9,black	segment 0,0,cos($val11*pi/180)*9,sin($val11*pi/180)*9,black	arc 0,0,2,2,$val10,$val11,black	fill  cos((($val10+$val11)/2)*pi/180)/2,sin((($val10+$val11)/2)*pi/180)/2,red	text black,-0.5,0,medium,$(val7[1]) 
tmp0=$ins_url
val12=$(tmp0)
val13=<img src="$val12" alt="">
val14=30°,50°,70°,90°,110°,130°,150°,170°
replytype1=click
replyname1=
replygood1=$val8;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	  <div class="medium_size img_col"> $val13</div>	  <div class="medium_size text_col">$val6:  
!read oef/embed.phtml r1 
$().	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13
embedcnt=1
