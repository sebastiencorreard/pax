val6=Cliquer sur tous les angles qui ont la même mesure&nbsp;,	  Cliquer sur les angles qui ont la même mesure&nbsp;
val7=\(\widehat{ABC}), \(\widehat{BED}),	\(\widehat{EDB}), \(\widehat{BAC}),	\(\widehat{ACB}), \(\widehat{DFE})
val8=\(\widehat{ABC}),\(\widehat{ACB}),	\(\widehat{DFE}),\(\widehat{FEC}),	\(\widehat{DEF}),\(\widehat{EFC})
tmp0=!shuffle 6

val9=$(tmp0)
tmp0=!positionof item 1 in $val9

val10=$[rint($(tmp0))]
tmp0=!positionof item 2 in $val9

val11=$[rint($(tmp0))]
tmp0=!positionof item 3 in $val9

val12=$[rint($(tmp0))]
val7=$(val7[$(val9[1])]),$(val7[$(val9[2])]),$(val7[$(val9[3])]),$(val7[$(val9[4])]),$(val7[$(val9[5])]),$(val7[$(val9[6])])
tmp0=!shuffle 6

val13=$(tmp0)
tmp0=!positionof item 3 in $val13

val14=$[rint($(tmp0))]
tmp0=!positionof item 4 in $val13

val15=$[rint($(tmp0))]
val8=$(val8[$(val13[1])]),$(val8[$(val13[2])]),$(val8[$(val13[3])]),$(val8[$(val13[4])]),$(val8[$(val13[5])]),$(val8[$(val13[6])])
val16=angle3
val17=<img src="$val1/$val16.jpg" alt="">
replytype1=mark
replyname1=
replygood1=$val10,$val11,$val12;$val7
replytype2=mark
replyname2=
replygood2=$val14,$val15;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

