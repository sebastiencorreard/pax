!set title=Vocabulaire sur les angles 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le nom de l'angle est
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 3, 16

val8=$[$(tmp0)*10]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val8*pi/180)*9,sin($val8*pi/180)*9,black	segment 0,0,9,0,black	arc 0,0,2,2,0,$val8,black	fill cos(($val8/2)*pi/180)/2,sin(($val8/2)*pi/180)/2,red	text black,cos(($val8+8)*pi/180)*6,sin(($val8+8)*pi/180)*6,medium,$(val7[3])	segment cos(($val8)*pi/180)*5-0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5+0.2*cos(($val8)*pi/180),cos(($val8)*pi/180)*5+0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5-0.2*cos(($val8)*pi/180),black	segment 5,-0.2,5,0.2,black	text black,5,-0.2,medium,$(val7[2])	text black,-0.5,0,medium,$(val7[1]) 
tmp0=$ins_url
val9=$(tmp0)
val10=\(\widehat{$(val7[3])$(val7[1])$(val7[2])}),\(\widehat{$(val7[1])$(val7[2])$(val7[3])}),\(\widehat{$(val7[2])$(val7[3])$(val7[1])})
val11=1
val12=<img src="$val9" alt="">
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val10[$val11]);$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val12</div>	 <div class="medium_size text_col">	$val6:  
!read oef/embed.phtml r1,120x40 
$()	 </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12
embedcnt=1
