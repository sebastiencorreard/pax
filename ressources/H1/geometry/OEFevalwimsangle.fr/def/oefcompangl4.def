val6=Comparer la mesure des angles&nbsp;
val6=Comparer la mesure des angles&nbsp;
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
val9=$[rint($val8*2+1)]
tmp0=!randint 1, 18-$val9

val10=$[rint($(tmp0))]
val11=$[rint(($val10+$val9)*10)]
val10=$[rint($val10*10)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val10*pi/180)*9,sin($val10*pi/180)*9,black	segment 0,0,cos($val11*pi/180)*9,sin($val11*pi/180)*9,black	arc 0,0,2,2,$val10,$val11,black	fill cos((($val10+$val11)/2)*pi/180)/2,sin((($val10+$val11)/2)*pi/180)/2,red	text black,-0.5,0,medium,$(val7[1])	segment cos(($val10)*pi/180)*5-0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5+0.2*cos(($val10)*pi/180),cos(($val10)*pi/180)*5+0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5-0.2*cos(($val10)*pi/180),black	segment cos(($val11)*pi/180)*5-0.2*sin(($val11)*pi/180),sin(($val11)*pi/180)*5+0.2*cos(($val11)*pi/180),cos(($val11)*pi/180)*5+0.2*sin(($val11)*pi/180),sin(($val11)*pi/180)*5-0.2*cos(($val11)*pi/180),black	text black,cos(($val10+8)*pi/180)*6,sin(($val10+8)*pi/180)*6,medium,$(val7[2])	text black,cos(($val11+8-$val8)*pi/180)*6,sin(($val11+8-$val8)*pi/180)*6,medium,$(val7[3]) 
tmp0=$ins_url
val12=$(tmp0)
tmp0=!randint 1, 8

val13=$[rint($(tmp0))]
val14=$[rint($val13*2+1)]
tmp0=!randint 1, 18-$val14

val15=$[rint($(tmp0))]
val16=$[rint(($val15+$val14)*10)]
val15=$[rint($val15*10)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val15*pi/180)*9,sin($val15*pi/180)*9,black	segment 0,0,cos($val16*pi/180)*9,sin($val16*pi/180)*9,black	arc 0,0,2,2,$val15,$val16,black	fill cos((($val15+$val16)/2)*pi/180)/2,sin((($val15+$val16)/2)*pi/180)/2,blue	text black,-0.5,0,medium,$(val7[4])	segment cos(($val15)*pi/180)*5-0.2*sin(($val15)*pi/180),sin(($val15)*pi/180)*5+0.2*cos(($val15)*pi/180),cos(($val15)*pi/180)*5+0.2*sin(($val15)*pi/180),sin(($val15)*pi/180)*5-0.2*cos(($val15)*pi/180),black	segment cos(($val16)*pi/180)*5-0.2*sin(($val16)*pi/180),sin(($val16)*pi/180)*5+0.2*cos(($val16)*pi/180),cos(($val16)*pi/180)*5+0.2*sin(($val16)*pi/180),sin(($val16)*pi/180)*5-0.2*cos(($val16)*pi/180),black	text black,cos(($val15+8)*pi/180)*6,sin(($val15+8)*pi/180)*6,medium,$(val7[5])	text black,cos(($val16+8-$val8)*pi/180)*6,sin(($val16+8-$val8)*pi/180)*6,medium,$(val7[6]) 
tmp0=$ins_url
val17=$(tmp0)
