!set title=Estimation d'un angle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner la mesure de l'angle
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randint 1, 8

val8=$[rint($(tmp0))]
tmp0=!randint 3, 10

val9=$[rint($(tmp0))]
val10=$[rint(($val9-2)*20)]
val11=$[rint($val10+20)]
tmp0=!randint $val10+4, $val11-4

val12=$[rint($(tmp0))]
val13=\(\widehat{$(val7[12])$(val7[1])$(val7[2])})
val14=
!for val15 =0 to 9 
val16=$[rint($val15*20)]
val14=$val14	segment 0,0,cos($val16*pi/180)*9,sin($val16*pi/180)*9,black	text black,cos(($val16+9-$val15)*pi/180)*6,sin(($val16+9-$val15)*pi/180)*6,medium,$(val7[2+$val15])	segment cos(($val16)*pi/180)*5-0.2*sin(($val16)*pi/180),sin(($val16)*pi/180)*5+0.2*cos(($val16)*pi/180),cos(($val16)*pi/180)*5+0.2*sin(($val16)*pi/180),sin(($val16)*pi/180)*5-0.2*cos(($val16)*pi/180),black
!next
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	$val14	text black,0,-0.2,medium,$(val7[1])	segment 0,0,9,0,red	segment 0,0,cos($val12*pi/180)*9,sin($val12*pi/180)*9,red	text red,cos(($val12+10-$val9)*pi/180)*8,sin(($val12+10-$val9)*pi/180)*8,medium,$(val7[12])	segment cos(($val12)*pi/180)*7-0.2*sin(($val12)*pi/180),sin(($val12)*pi/180)*7+0.2*cos(($val12)*pi/180),cos(($val12)*pi/180)*7+0.2*sin(($val12)*pi/180),sin(($val12)*pi/180)*7-0.2*cos(($val12)*pi/180),black 
tmp0=$ins_url
val14=$(tmp0)
val17=<img src="$val14" alt="">
val18=30°,50°,70°,90°,110°,130°,150°,170°
replytype1=numeric
replyname1=
replygood1=$[$val10]
replytype2=numeric
replyname2=
replygood2=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	  <div class="medium_size img_col">$val17</div>	  <div class="medium_size text_col"><label for="reply1">$val6</label>	<div class="wimscenter"> 
!read oef/embed.phtml r1,4 
$()° <label for="reply2">&lt; $val13 &lt;</label>	 
!read oef/embed.phtml r2,4 
$()° </div></div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13,17
embedcnt=2
