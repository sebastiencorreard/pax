val6=Comparer la mesure des angles&nbsp;
val6=Comparer la mesure des angles&nbsp;
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
tmp0=!randitem 2,3,4,5,6,7,8,10,11,12,13,14,15,16

val8=$[rint($(tmp0))]
val9=$[rint(180)]
val8=$[rint($val8*10)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val8*pi/180)*9,sin($val8*pi/180)*9,black	arc 0,0,2,2,0,$val8,black	segment cos(($val8/2)*pi/180)*0.7,sin(($val8/2)*pi/180)*0.7,cos(($val8/2)*pi/180)*1.3,sin(($val8/2)*pi/180)*1.3,black	text black,cos(($val8+8)*pi/180)*6,sin(($val8+8)*pi/180)*6,medium,$(val7[4])	segment cos(($val8)*pi/180)*5-0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5+0.2*cos(($val8)*pi/180),cos(($val8)*pi/180)*5+0.2*sin(($val8)*pi/180),sin(($val8)*pi/180)*5-0.2*cos(($val8)*pi/180),black	segment 0,0,cos($val9*pi/180)*9,sin($val9*pi/180)*9,black	arc 0,0,4,4,$val8,$val9,black	text black,cos(($val9+4)*pi/180)*5,sin(($val9+4)*pi/180)*5,medium,$(val7[3])	segment cos(($val9)*pi/180)*5-0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5+0.2*cos(($val9)*pi/180),cos(($val9)*pi/180)*5+0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5-0.2*cos(($val9)*pi/180),black	segment 0,0,9,0,black	segment 5,-0.2,5,0.2,black	text black,5,-0.2,medium,$(val7[2])	text black,-0.5,0,medium,$(val7[1]) 
tmp0=$ins_url
val10=$(tmp0)
val11=\(\widehat{$(val7[3])$(val7[1])$(val7[4])}),\(\widehat{$(val7[4])$(val7[1])$(val7[2])})
!if $val8<90 
val12=$(val11[2])
val13=$(val11[1])
!else
val12=$(val11[1])
val13=$(val11[2])
!endif
val14=<img src="$val10" alt="">
