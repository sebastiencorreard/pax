\title{Mesure d'angle (1)}
\language{fr}
\author{Paul, Byache}
\email{byachepaul@yahoo.fr}
\format{html}

\integer{aaa=randint(3..15)*10}
\integer{choix=random(1,2)}
\text{A=\choix=1 ? A : B}
\text{B=\choix=1 ? B : A}
\text{BAC=\choix=1 ? BAC : CBA}
\text{ang=\choix=1 ? C,A,B : A,B,C}

\text{appletoption=height=400
width=600
showToolBar=true
enableRightClick=false
customToolBar=0|40
A=(-1,-15)
C=(15,-15)
B=(5,0)
a=Ray[\A,\B]
b=Ray[\A,C]
u=Angle[\ang]
setLabelVisible('u',false)
file=rapport0.ggb}

\statement{
Déplace les points A, B ou C pour que l'angle \(\widehat{\BAC}) mesure \aaa°.
<div>
\embed{r1, 600 x 400
\appletoption}
</div>
<div class="wims_instruction">Tolérance sur les mesures d'angles : 5° en plus ou en moins.
<br />
Pour déplacer le rapporteur, déplacer le point rouge (H).
<br />
Pour faire tourner le rapporteur, déplacer le point vert (D).
</div>
}

\answer{Vérification des coordonnées : }{n,abs(abs(v_u)-\aaa)<5,L'angle est-il correct ?}{type=geogebra}
{option=extra=yes output=nothing ignore=H&D&z&w&E max=125 }

\text{R=wims(replace = by , in \reply1)}
\text{ang=wims(select \R where column 2 issametext angle)}
\integer{ang=round(\ang[3])}
\feedback{1=1}{L'angle que vous avez construit mesure environ : \ang °
(valeur arrondie au degré près).}
