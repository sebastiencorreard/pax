\title{Angle "à vue d'oeil"}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\integer{aaa=randint(3..15)*10}
\integer{choix=random(1,2)}
\text{A=\choix=1 ? A : B}
\text{B=\choix=1 ? B : A}
\text{BAC=\choix=1 ? BAC : CBA}
\text{ang=\choix=1 ? C,A,B : A,B,C}

\text{appletoption=height=400
width=600
showToolBar=true
enableRightClick=false
customToolBar=0|40
A=(-1,-15)
C=(15,-15)
B=(5,0)
a=Ray[\A,\B]
b=Ray[\A,C]
u=Angle[\ang]
setLabelVisible('u',false)
file=blanc.ggb}

\statement{ Déplace les points A, B ou C pour que l'angle \(\widehat{\BAC}) mesure \aaa°.

<div class="float_left spacer">
\embed{r1, 600 x 400
\appletoption}
</div>
<div class="small">Tolérance sur les mesures d'angles :
<br />15° en plus ou en moins.
</div>
}

\answer{Vérification des coordonnées : }{n,abs(abs(v_u)-\aaa)<15,L'angle est-il correct ?}{type=geogebra}
{option=extra=yes output=nothing ignore=H&D&z&w&E max=125 }

\text{R=wims(replace = by , in \reply1)}
\text{ang=wims(select \R where column 2 issametext angle)}
\integer{ang=round(\ang[3])}
\integer{diff=abs(\ang-\aaa)}
\feedback{1=1}{L'angle que vous avez construit mesure environ : \ang °
(valeur arrondie au degré près).<br />
Il y a donc un écart de \diff ° avec la valeur demandée (\aaa °) et
la tolérance dans cet exercice est de 15 °...
}

\hint{<div class="wims_emph"><span class="bold">Rappels :</span>
<ul><li>un angle droit mesure 90 °</li>
<li>un angle plat mesure 180 °</li>
</ul>}
