!set title=Angle "à vue d'oeil"
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=r
varcnt=12
prevarcnt=7
postvarcnt=4
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 15

val6=$[rint($(tmp0)*10)]
tmp0=!randitem 1,2

val7=$[rint($(tmp0))]

!ifval $val7=1 
val8= A 
!else
val8= B
!endif

!ifval $val7=1 
val9= B 
!else
val9= A
!endif

!ifval $val7=1 
val10= BAC 
!else
val10= CBA
!endif

!ifval $val7=1 
val11= C,A,B 
!else
val11= A,B,C
!endif
val12=height=400	width=600	showToolBar=true	enableRightClick=false	customToolBar=0|40	A=(-1,-15)	C=(15,-15)	B=(5,0)	a=Ray[$val8,$val9]	b=Ray[$val8,C]	u=Angle[$val11]	setLabelVisible('u',false)	file=blanc.ggb
replytype1=geogebra

replyoption1=extra=yes output=nothing ignore=H&D&z&w&E max=125 
replyname1=Vérification des coordonnées :
replygood1=n,abs(abs(v_u)-$val6)<15,L'angle est-il correct ?
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst <div class="wims_emph"><span class="bold">Rappels :</span> <ul><li>un angle droit mesure 90 °</li> <li>un angle plat mesure 180 °</li> </ul>


!goto stat

!exit

:question
$() Déplace les points A, B ou C pour que l'angle 
!insmath \widehat{$val10}
$() mesure $val6°.		<div class="float_left spacer">	 
!read oef/embed.phtml r1, 600 x 400	$val12 
$()	</div>	<div class="small">Tolérance sur les mesures d'angles :	<br />15° en plus ou en moins.	</div>	
$()
!exit

:hint
$()<div class="wims_emph"><span class="bold">Rappels :</span> <ul><li>un angle droit mesure 90 °</li> <li>un angle plat mesure 180 °</li> </ul>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!replace = by , in $m_reply1

val13=$(tmp0)
tmp0=!select $val13 where column 2 issametext angle

val11=$(tmp0)
val11=$[rint(round($(val11[3])))]
val14=$[rint(abs($val11-$val6))]

!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>L'angle que vous avez construit mesure environ : $val11 °	(valeur arrondie au degré près).<br />	Il y a donc un écart de $val14 ° avec la valeur demandée ($val6 °) et	la tolérance dans cet exercice est de 15 °...	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,10,11,12
embedcnt=1
