\title{Construction d'un triangle particulier 2}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{tri1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,-80+s*160,-80, black)}

\text{tri2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80, black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
arc -80,-80,320,320,0,s*90,red)}

\text{tri3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80, black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
arc -80,-80,320,320,0,90,red
arc 80,-80,320,320,180-s*90,180,red)}

\text{tri4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80, black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
arc -80,-80,320,320,0,90,red
arc 80,-80,320,320,90,180,red
text black,0,78,medium,C)}

\text{tri5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80, black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
arc -80,-80,320,320,0,90,red
arc 80,-80,320,320,90,180,red
text black,0,78,medium,C
segment -80,-80,-80+80*s,-80+136*s,black)}

\text{tri6=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80, black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
arc -80,-80,320,320,0,90,red
arc 80,-80,320,320,90,180,red
text black,0,78,medium,C
segment -80,-80,-80+80,-80+136,black
segment 80,-80,80-80*s,-80+136*s,black)}

\text{fig=<img src="\tri1" alt="">,<img src="\tri2" alt="">,<img src="\tri3" alt="">,
<img src="\tri4" alt="">,<img src="\tri5" alt="">,<img src="\tri6" alt="">}

\text{rep=Je trace un segment [AB] de longueur 8 cm.,
Je trace un arc de cercle de centre A et de rayon AB.,
Je trace un arc de cercle de centre B et de rayon AB.,
Je nomme C le point d'intersection des deux arcs de cercle.,
Je trace le segment [AC].,
Et pour finir le triangle ABC&#44;je trace le segment [BC].}

\statement{
<p>Construire un triangle équilatéral ABC tel que : AB = 8 cm.</p>
Voici les différentes étapes de construction.
Placer le texte d'explication correct sous chaque dessin.
<table class="wimscenter wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\fig[\i]</td>}
</tr><tr>
\for{i=1 to 3}{<td>\embed{r\i,200x80}</td>}
</tr>
<tr><th>Étape 4</th><th>Étape 5</th><th>Étape 6</th></tr>
<tr>
\for{i=4 to 6}{<td>\fig[\i]</td>}
</tr>
<tr>
\for{i=4 to 6}{<td>\embed{r\i,200x80}</td>}
</tr>
</table>}

\answer{}{\rep[1]}{type=dragfill}{option=shuffle}
\answer{}{\rep[2]}{type=dragfill}
\answer{}{\rep[3]}{type=dragfill}
\answer{}{\rep[4]}{type=dragfill}
\answer{}{\rep[5]}{type=dragfill}
\answer{}{\rep[6]}{type=dragfill}
