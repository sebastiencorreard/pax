\title{Construction d'un triangle isocèle 5}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{rep=Je trace un segment [AB] de longueur 8 cm.,
En premier&#44; je trace un angle de sommet A&#44; de côté &#91;AB&#41; et qui mesure 55°.,
En second&#44; je trace un angle de sommet B&#44; de côté &#91;BA&#41; et qui mesure 55°.,
Je nomme C le point d'intersection des deux nouveaux côtés tracés.,
}


\statement{
Construire un triangle isocèle ABC tel que :
<div class="wimscenter"> AB = 8 cm,&nbsp; \(\widehat{BAC}) = 55°.</div>
Choisir le texte expliquant les étapes correspondant à la construction
présentée dans l'exercice précédent.
<table class="wimscenter wimsborder">
\for{i=1 to 4}{<tr><th>Étape \i</th><td>\embed{r\i,400x40}</td></tr>}
</table>}

\answer{}{\rep[1]}{type=dragfill}{option=shuffle}
\answer{}{\rep[2]}{type=dragfill}
\answer{}{\rep[3]}{type=dragfill}
\answer{}{\rep[4]}{type=dragfill}
