\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Vocabulaire 3}

\text{nom=shuffle(A,B,C,E,F,G,H,J,K,L,M,N,R,S,T)}

\integer{b=randint(20..80)}
\integer{h=randint(20..130)}
\text{triiso=draw(200,200
segment 100-\b,150,100+\b,150,black
text black,100-\b-15,150,medium,\nom[1]
segment 100-\b,150,100,150-\h,black
text black,100,150-\h-15,medium,\nom[2]
segment 100+\b,150,100,150-\h,black
text black,100+\b+10,150,medium,\nom[3]
linewidth 2
segment (200-\b)/2-4,(300-\h)/2-4,(200-\b)/2+4,(300-\h)/2+4,red
segment (200+\b)/2-4,(300-\h)/2+4,(200+\b)/2+4,(300-\h)/2-4,red)}

\matrix{quest=le sommet principal est le sommet
la base est le côté }

\integer{a=randint(1..2)}
\if{\a=1}{\text{rep=\nom[2]}}{\text{rep=[\nom[1]\nom[3]]|[\nom[3]\nom[1]]}}
\text{quest=row(\a,\quest)}

\text{fig=<img src="\triiso" alt="">}

\statement{  <div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
Dans le triangle \nom[1]\nom[2]\nom[3],
<label for="reply1">\quest</label> \embed{r1,8}.
</div></div>
}

\answer{}{\rep}{type=text}
