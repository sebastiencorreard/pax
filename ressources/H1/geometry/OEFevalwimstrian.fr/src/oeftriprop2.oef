\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Propriétés 2}

\text{nom=shuffle(A,B,C,E,F,G,H,J,K,L,M,N,R,S,T)}

\integer{b=randint(20..80)}
\integer{h=randint(20..130)}
\text{triiso=draw(200,200
segment 100-\b,150,100+\b,150,black
text black,100-\b-15,150,medium,\nom[1]
segment 100-\b,150,100,150-\h,black
text black,100,150-\h-15,medium,\nom[2]
segment 100+\b,150,100,150-\h,black
text black,100+\b+10,150,medium,\nom[3]
linewidth 2
segment (200-\b)/2-4,(300-\h)/2-4,(200-\b)/2+4,(300-\h)/2+4,red
segment (200+\b)/2-4,(300-\h)/2+4,(200+\b)/2+4,(300-\h)/2-4,red)}

\integer{l=randint(20..80)}
\text{triequ=draw(200,200
segment 100-\l,150,100+\l,150,black
text black,100-\l-15,150,medium,\nom[1]
segment 100-\l,150,100,150-\l*sqrt(3),black
text black,100,150-\l*sqrt(3)-15,medium,\nom[2]
segment 100+\l,150,100,150-\l*sqrt(3),black
text black,100+\l+10,150,medium,\nom[3]
linewidth 2
segment (200-\l)/2-4,(300-\l*sqrt(3))/2-4,(200-\l)/2+4,(300-\l*sqrt(3))/2+4,red
segment (200+\l)/2-4,(300-\l*sqrt(3))/2+4,(200+\l)/2+4,(300-\l*sqrt(3))/2-4,red
segment 100-4,150+4,100+4,150-4,red)}

\integer{lo=randint(20..130)}
\integer{la=randint(40..130)}
\if{abs(\la-\lo)<11}{\integer{la=\la-20}}
\text{trirec=draw(200,200
segment 50,150,50+\lo,150,black
text black,50-15,150,medium,\nom[1]
segment 50,150,50,150-\la,black
text black,50-15,150-\la-15,medium,\nom[2]
segment 50,150-\la,50+\lo,150,black
text black,50+\lo+10,150,medium,\nom[3]
linewidth 2
segment 51,142,58,142,red
segment 58,142,58,149,red)}

\text{nat= triangle isocèle, triangle équilatéral, triangle rectangle}
\matrix{prop=Le triangle a deux côtés de même longueur.,Le triangle a deux angles égaux.
Le triangle a trois côtés de même longueur.,Le triangle a trois angles égaux.
Le triangle a un côté qui s'appelle l'hypoténuse.,Le triangle a un angle droit.}

\integer{a=randint(1..3)}
\integer{b=randint(1..2)}
\text{enonc=column(\b,\prop)}
\text{reps=<img src="\triiso" alt="">,<img src="\triequ" alt="">,<img src="\trirec" alt="">}
\integer{rep=\a}
\text{aff=\reps[\a]}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\aff</div>
 <div class="medium_size text_col">
 Cliquer sur la propriété que possède le triangle ci-contre :
<div class="wimscenter">\embed{r1}</div>
 </div>
</div>
}

\answer{}{\rep;\enonc}{type=click}
