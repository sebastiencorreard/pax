\title{Construction d'un triangle isocèle 3}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{tri1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,-80+160*s,-80,black)}

\text{tri2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-s*55/90)*pi/2)*200,-80+cos((1-s*55/90)*pi/2)*200, black
arc -80,-80,50,50,1,1+s*54,red)}

\text{tri3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc -80,-80,50,50,1,54,red
segment 80,-80,80-sin((1-55/90*s)*pi/2)*200,-80+cos((1-55/90*s)*pi/2)*200, black
arc 80,-80,50,50,180-55*s,180,red
)}

\text{tri4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc -80,-80,50,50,1,54,red
segment 80,-80,80-sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc 80,-80,50,50,126,179,red
text black,-3,55,medium,C)}

\text{fig=<img src="\tri1" alt="">,<img src="\tri2" alt="">,<img src="\tri3" alt="">,
<img src="\tri4" alt="">}

\text{reps=La règle,L'équerre,Le compas,Le rapporteur et la règle,Le crayon uniquement}

\statement{
Construire un triangle isocèle ABC tel que :
 <div class="wimscenter">AB = 8 cm et \(\widehat{BAC}) = 55°.</div>
Voici les différentes étapes de construction.
Choisir l'instrument à utiliser à chaque étape sous chaque dessin.
<table class="wimscenter wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\fig[\i]</td>}
</tr><tr>
\for{i=1 to 3}{<td>\embed{r\i}</td>}
</tr>
<tr><th>Étape 4</th><th></th><th></th></tr>
<tr>
\for{i=4 to 4}{<td>\fig[\i]</td>}
<td></td><td></td>
</tr><tr>
\for{i=4 to 5}{<td>\embed{r\i}</td>}
<td></td>
</tr>
</table>}

\answer{}{1;\reps}{type=menu}
\answer{}{4;\reps}{type=menu}
\answer{}{4;\reps}{type=menu}
\answer{}{5;\reps}{type=menu}
