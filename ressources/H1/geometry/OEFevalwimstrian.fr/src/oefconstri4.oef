\title{Construction d'un triangle 4}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{tri1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,-80+s*160,-50, black)}

\text{tri2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
arc -80,-50,270,270,40,40+s*50,red)}

\text{tri3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
arc -80,-50,270,270,40,90,red
arc 80,-50,360,360,145-s*20,145,red)}

\text{tri4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
arc -80,-50,270,270,40,90,red
arc 80,-50,360,360,125,145,red
text black,-45,98,medium,C)}

\text{tri5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
arc -80,-50,270,270,40,90,red
arc 80,-50,360,360,125,145,red
segment -80,-50,-80+37*s,-50+130*s,black
text black,-45,98,medium,C)}

\text{tri6=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
arc -80,-50,270,270,40,90,red
arc 80,-50,360,360,125,145,red
segment -80,-50,-43,80,black
segment 80,-50,80-123*s,-50+130*s,black
text black,-45,98,medium,C)}

\text{fig=<img src="\tri1" alt="">,<img src="\tri2" alt="">,<img src="\tri3" alt="">,
<img src="\tri4" alt="">,<img src="\tri5" alt="">,<img src="\tri6" alt="">}

\text{rep=Je trace un segment [AB] de longueur 8 cm.,
Je trace un arc de cercle de centre A et de rayon 6&#44;8 cm.,
Je trace un arc de cercle de centre B et de rayon 9 cm&#44; sécant au premier arc de cercle.,
Je nomme C le point d'intersection des deux arcs de cercle.,
Je trace le segment [AC].,
Et pour finir le triangle ABC&#44;je trace le segment [BC].}

\statement{
Construire un triangle ABC, telque :
<div class="wimscenter"> AB = 8 cm, BC = 9 cm et AC = 6,8 cm.</div>
Voici les différentes étapes de construction.
Placer le texte d'explication correct sous chaque dessin.
<table class="wimscenter wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\fig[\i]</td>}
</tr><tr>
\for{i=1 to 3}{<td>\embed{r\i,250x80}</td>}
</tr>
<tr><th>Étape 4</th><th>Étape 5</th><th>Étape 6</th></tr>
<tr>
\for{i=4 to 6}{<td>\fig[\i]</td>}
</tr><tr>
\for{i=4 to 6}{<td>\embed{r\i,250x80}</td>}
</tr>
</table>}

\answer{}{\rep[1]}{type=dragfill}{option=shuffle}
\answer{}{\rep[2]}{type=dragfill}
\answer{}{\rep[3]}{type=dragfill}
\answer{}{\rep[4]}{type=dragfill}
\answer{}{\rep[5]}{type=dragfill}
\answer{}{\rep[6]}{type=dragfill}
