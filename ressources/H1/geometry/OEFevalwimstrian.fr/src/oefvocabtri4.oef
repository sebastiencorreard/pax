\format{html}
\title{Vocabulaire 4}

\text{nom=shuffle(A,B,C,E,F,G,H,J,K,L,M,N,R,S,T)}

\integer{l=randint(20..80)}
\text{triequ=draw(200,200
segment 100-\l,150,100+\l,150,black
text black,100-\l-15,150,medium,\nom[1]
segment 100-\l,150,100,150-\l*sqrt(3),black
text black,100,150-\l*sqrt(3)-15,medium,\nom[2]
segment 100+\l,150,100,150-\l*sqrt(3),black
text black,100+\l+10,150,medium,\nom[3]
linewidth 2
segment (200-\l)/2-4,(300-\l*sqrt(3))/2-4,(200-\l)/2+4,(300-\l*sqrt(3))/2+4,red
segment (200+\l)/2-4,(300-\l*sqrt(3))/2+4,(200+\l)/2+4,(300-\l*sqrt(3))/2-4,red
segment 100-4,150+4,100+4,150-4,red)}

\text{n=shuffle(\nom[1],\nom[2],\nom[3])}
\matrix{quest=le sommet opposé au côté [\n[1]\n[2]] est le sommet
le côté opposé au sommet \n[1] est le côté }

\integer{a=randint(1..2)}
\if{\a=1}{\text{rep=\n[3]}}{\text{rep=[\n[2]\n[3]]|[\n[3]\n[2]]}}
\text{quest=row(\a,\quest)}

\text{fig=<img src="\triequ" alt="">}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
Dans le triangle \nom[1]\nom[2]\nom[3],
<label for="reply1">\quest</label> \embed{r1,8}.
</div></div>
}

\answer{}{\rep}{type=text}
