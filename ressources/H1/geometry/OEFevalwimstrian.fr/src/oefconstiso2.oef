\title{Construction d'un triangle isocèle 2}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{tri1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,-80+160*s,-80,black)}

\text{tri2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-s*55/90)*pi/2)*200,-80+cos((1-s*55/90)*pi/2)*200, black
arc -80,-80,50,50,1,1+s*54,red)}

\text{tri3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc -80,-80,50,50,1,54,red
segment 80,-80,80-sin((1-55/90*s)*pi/2)*200,-80+cos((1-55/90*s)*pi/2)*200, black
arc 80,-80,50,50,180-55*s,180,red
)}

\text{tri4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc -80,-80,50,50,1,54,red
segment 80,-80,80-sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc 80,-80,50,50,126,179,red
)}

\text{tri5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-80,80,-80,black
segment -80,-85,-80,-75,black
segment 80,-85,80,-75,black
text black,-85,-88,medium,A
text black,75,-88,medium,B
segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc -80,-80,50,50,1,54,red
segment 80,-80,80-sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black
arc 80,-80,50,50,126,179,red
text black,-3,55,medium,C)}

\text{fig=<img src="\tri1" alt="">,<img src="\tri2" alt="">,<img src="\tri3" alt="">,
<img src="\tri4" alt="">,<img src="\tri5" alt="">}

\statement{
Construire un triangle isocèle connaissant la longueur de la base et
la mesure d'un angle de la base :
Mettre les images dans le bon ordre des étapes de construction.
<table class="wimscenter wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\embed{r\i,200x200}</td>}
</tr>
<tr><th>Étape 4</th><th>Étape 5</th><th></th></tr>
<tr>
\for{i=4 to 5}{<td>\embed{r\i,200x200}</td>}
<td></td>
</tr>
</table>}

\answer{}{\fig[1]}{type=dragfill}{option=shuffle}
\answer{}{\fig[2]}{type=dragfill}
\answer{}{\fig[3]}{type=dragfill}
\answer{}{\fig[4]}{type=dragfill}
\answer{}{\fig[5]}{type=dragfill}
