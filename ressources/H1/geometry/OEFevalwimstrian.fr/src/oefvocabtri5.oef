\title{Vocabulaire 5}

\text{nom=shuffle(A,B,C,E,F,G,H,J,K,L,M,N,R,S,T)}

\integer{lo=randint(20..130)}
\integer{la=randint(40..130)}
\if{abs(\la-\lo)<11}{\integer{la=\la-20}}
\text{trirec=draw(200,200
segment 50,150,50+\lo,150,black
text black,50-15,150,medium,\nom[1]
segment 50,150,50,150-\la,black
text black,50-15,150-\la-15,medium,\nom[2]
segment 50,150-\la,50+\lo,150,black
text black,50+\lo+10,150,medium,\nom[3]
linewidth 2
segment 51,142,58,142,red
segment 58,142,58,149,red)}

\text{n=shuffle(\nom[1],\nom[2],\nom[3])}
\matrix{quest=Le triangle \n[1]\n[2]\n[3] est rectangle en
Dans le triangle \nom[1]\nom[2]\nom[3], le côté opposé au sommet de l'angle droit est le côté }

\integer{a=randint(1..2)}
\if{\a=1}{\text{rep=\nom[1]}}{\text{rep=[\nom[2]\nom[3]]|[\nom[3]\nom[2]]}}
\text{quest=row(\a,\quest)}

\text{fig=<img src="\trirec" alt="">}

\statement{  <div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<label for="reply1">\quest</label> \embed{r1,8}.
</div></div>
}

\answer{}{\rep}{type=text}
