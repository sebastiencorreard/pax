\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Vocabulaire 2}

\text{nom=shuffle(A,B,C,E,F,G,H,J,K,L,M,N,R,S,T)}

\integer{x1=randint(20..80)}
\integer{y1=randint(120..180)}
\integer{x2=randint(20..180)}
\integer{y2=randint(20..80)}
\integer{x3=randint(120..180)}
\integer{y3=randint(120..180)}

\text{trique=draw(200,200
segment \x1,\y1,\x2,\y2,black
text black,\x1-15,\y1,medium,\nom[1]
segment \x1,\y1,\x3,\y3,black
text black,\x2,\y2-15,medium,\nom[2]
segment \x2,\y2,\x3,\y3,black
text black,\x3+10,\y3,medium,\nom[3])}

\text{n=shuffle(\nom[1],\nom[2],\nom[3])}
\matrix{quest=le sommet opposé au côté [\n[1]\n[2]] est le sommet
le côté opposé au sommet \n[1] est le côté }

\integer{a=randint(1..2)}
\if{\a=1}{\text{rep=\n[3]}}{\text{rep=[\n[2]\n[3]]|[\n[3]\n[2]]}}
\text{quest=row(\a,\quest)}

\text{fig=<img src="\trique" alt="">}

\statement{  <div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
Dans le triangle \nom[1]\nom[2]\nom[3],
\quest \embed{r1,8}.
</div></div>
}

\answer{}{\rep}{type=text}
