\title{Construction d'un triangle particulier 5}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{tri1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,-80+s*160,-50, black)}

\text{tri2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
triangle 20-100*s,-50,80-100*s,-50,20-s*100,54,blue
triangle 30-100*s,-40,60-100*s,-40,30-s*100,15,blue
fill 25-100*s,-45,grey)}

\text{tri3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
triangle 20-100,-50,80-100,-50,20-100,54,blue
triangle 30-100,-40,60-100,-40,30-100,15,blue
fill 25-100,-45,grey
segment -80,-50,-80,-50+s*140, black
)}

\text{tri4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
segment -80,-50,-80,-50+140, black
segment -85,90,-75,90, black
text black,-95,90,medium,C)}

\text{tri5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment -80,-50,80,-50, black
segment -80,-45,-80,-55,black
segment 80,-45,80,-55,black
text black,-85,-58,medium,A
text black,75,-58,medium,B
segment -80,-50,-80,-50+140, black
segment -85,90,-75,90, black
text black,-95,90,medium,C
segment -80,90,-80+160*s,90-140*s,black)}

\text{fig=<img src="\tri1" alt="">,<img src="\tri2" alt="">,<img src="\tri3" alt="">,
<img src="\tri4" alt="">,<img src="\tri5" alt="">}

\text{rep=Je trace un segment [AB] de longueur 8 cm.,
J'utilise l'équerre pour tracer la perpendiculaire à la droite (AB) passant par le point A.,
Je trace la demi-droite perpendiculaire à la droite (AB).,
Je trace le segment [AC] de longueur 7 cm sur la demi-droite précédente.,
Je trace le segment [CB].}

\statement{Construire un triangle ABC rectangle en A tel que :
<div class="wimscenter"> AB = 8 cm et AC = 7 cm.</div>
Voici les différentes étapes de construction.
Placer le texte d'explication correct sous chaque dessin.
<table class="wimscenter wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\fig[\i]</td>}
</tr><tr>
\for{i=1 to 3}{<td>\embed{r\i,250x80}</td>}
</tr>
<tr><th>Étape 4</th><th>Étape 5</th><th></th></tr>
<tr>
\for{i=4 to 5}{<td>\fig[\i]</td>}
<td></td>
</tr>
<tr>
\for{i=4 to 5}{<td>\embed{r\i,250x80}</td>}

</tr>
</table>}

\answer{}{\rep[1]}{type=dragfill}{option=shuffle}
\answer{}{\rep[2]}{type=dragfill}
\answer{}{\rep[3]}{type=dragfill}
\answer{}{\rep[4]}{type=dragfill}
\answer{}{\rep[5]}{type=dragfill}
