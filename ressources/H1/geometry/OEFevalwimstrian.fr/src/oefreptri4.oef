\title{Reproduire un triangle 4}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\integer{m1=randint(4..8)}
\integer{m2=randint(\m1+1..12)}

\text{tri=draw(300,300
xrange -100,200
yrange -150,150
linewidth 1
triangle 0,0,0,80,160,0,black
text black,-15,5,medium,A
text black,-15,90,medium,B
text black,165,0,medium,C
text black,65,65,medium,E
text black,100,-120,medium,F
rotate -54
triangle 0,0,0,80,160,0,black)}

\integer{mm=20*\m1*\m2/sqrt(\m1^2+\m2^2)}
\real{mi=(\mm-2)/10}
\real{ma=(\mm+2)/10}
\text{fig=<img src="\tri" alt="">}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<ul><li>Nous avons deux triangles rectangles de même mesure.
</li><li>Le point E appartient au segment [BC].
</li><li>AB = \m1 cm et AC= \m2 cm.
</li></ul>
Construire la figure sur une feuille de brouillon.
et donner la mesure du segment [CF] :
<div class="wimscenter"> CF = \embed{r1,5} cm.</div>
</div></div>
}

\answer{}{\mi,\ma}{type=range}
