!set title=Vocabulaire sur les triangles particuliers 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/triang01b.jpg" alt="">,<img src="$val1/triang02b.jpg" alt="">,<img src="$val1/triang03b.jpg" alt="">,<img src="$val1/triang04b.jpg" alt="">,	<img src="$val1/triang05b.jpg" alt="">,<img src="$val1/triang06b.jpg" alt="">,<img src="$val1/triang07b.jpg" alt="">,<img src="$val1/triang08b.jpg" alt="">,	<img src="$val1/triang09b.jpg" alt="">,<img src="$val1/triang10b.jpg" alt="">,<img src="$val1/triang11b.jpg" alt="">,<img src="$val1/triang12b.jpg" alt="">,	<img src="$val1/triang13b.jpg" alt="">,<img src="$val1/triang14b.jpg" alt="">,<img src="$val1/triang15b.jpg" alt="">,<img src="$val1/triang16b.jpg" alt="">,	<img src="$val1/triang17b.jpg" alt="">,<img src="$val1/triang18b.jpg" alt="">,<img src="$val1/triang19b.jpg" alt="">,<img src="$val1/triang20b.jpg" alt="">
tmp0=!randitem 2,3,4,5,6,9,10,11,12,14,15,17,18,20

val7=$[rint($(tmp0))]
val8=autre,quelconque,rectangle,isocèle,équilatéral,rectangle et isocèle
val9=6,3,2,4,5,4,6,1,4,5,4,2,1,2,5,1,2,2,6,4
replytype1=texte

replyname1=
replygood1=$(val8[$(val9[$val7])])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	 <div class="medium_size img_col">$(val6[$val7])</div>	 <div class="medium_size text_col">	<label for="reply1">Cette figure est un triangle</label>  
!read oef/embed.phtml r1 
$()	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
