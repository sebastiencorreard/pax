 !exit
!endif

val6=Triangle isocèle, Triangle équilatéral, Triangle rectangle
tmp=!trim Le triangle a deux côtés de même longueur.,Le triangle a deux angles égaux.	Le triangle a trois côtés de même longueur.,Le triangle a trois angles égaux.	Le triangle a un côté qui s'appelle l'hypoténuse.,Le triangle a un angle droit.
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=$(val7[$val8;$val9])
val11=$[rint($val8)]
replytype1=click
replyname1=
replygood1=$val11;$val6,Triangle quelconque
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

