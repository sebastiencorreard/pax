!set title=Prouver 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val6=$(tmp0)
tmp=!trim triangle isocèle,deux côtés de même longueur	triangle équilatéral,trois côtés de même longueur	triangle rectangle,un angle droit	triangle isocèle et rectangle,deux côtés de même longueur et un angle droit
val7=!translate internal $	\
$ to ;; in $tmp
val8=deux,trois,côtés,de,même,longueur,et,un,angle,droit
val9=correspond
val10=60x200x300
tmp=!translate internal $	$ to ; in $val7

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val7

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!shuffle 4

val13=$(tmp0)
val11=$(val11[$(val13[1])]),$(val11[$(val13[2])]),$(val11[$(val13[3])]),$(val11[$(val13[4])])
val12=$(val12[$(val13[1])]),$(val12[$(val13[2])]),$(val12[$(val13[3])]),$(val12[$(val13[4])])
replytype1=$val9

replyname1=
replygood1=$val11;$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Comment prouver qu'un triangle est particulier ?	<p>$m_enonc</p>	<div class="wimscenter"> 
!read oef/embed.phtml r1,$val10 
$()</div>	
$()
!exit

