!set title=Reproduire un triangle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 8

val6=$[rint($(tmp0))]
tmp0=!randint $val6+1, 12

val7=$[rint($(tmp0))]
!readproc oef/draw.phtml 300,300 \
xrange -250,50	yrange -50,250	linewidth 1	triangle 0,0,-200,0,-200,120,black	text black,10,5,medium,A	text black,-210,0,medium,B	text black,-210,125,medium,C	text black,15,245,medium,E	rotate -31	triangle 0,0,-200,0,-200,120,black	rotate -62	triangle 0,0,-200,0,-200,120,black	 
tmp0=$ins_url
val8=$(tmp0)
val9=$[rint(20*$val6)]
val10=$[($val9-2)/10]
val11=$[($val9+2)/10]
val12=<img src="$val8" alt="">
replytype1=range
replyname1=
replygood1=!rawmath $val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val12</div>	 <div class="medium_size text_col">	Nous avons trois triangles rectangles de même mesure.	<div class="wimscenter">BC = $val6 cm et AB = $val7 cm.</div>	Reproduire la figure avec les bonnes mesures sur une feuille de brouillon.	et donner la mesure du segment [CE] :	<div class="wimscenter"><label for="reply1">CE =</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,12
embedcnt=1
