!set title=Énoncé 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val6=$(tmp0)
val7=Nous avons un triangle $(val6[1])$(val6[2])$(val6[3]) isocèle de sommet $(val6[3]) tels que
tmp0=!randint 40, 80

val8=$[$(tmp0)/10]
tmp0=!randint $val8*10+10, 100

val9=$[$(tmp0)/10]
val10=$val8,$val9
val11=$[$(val10[1])]
val12=$[$(val10[1])]
tmp=!nonempty items $(val6[1])$(val6[3]) = $(val10[1]) cm et $(val6[1])$(val6[2]) = $(val10[2]) cm,	$(val6[1])$(val6[2]) = $(val10[2]) cm et $(val6[1])$(val6[3]) = $(val10[1]) cm

tmp0=!randitem $tmp
val13=$(tmp0)
val14=$(val6[2])$(val6[3])
replytype1=range
replyname1=
replygood1=!rawmath $val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div>$val7 $val13.</div>	<p>	Faire la figure sur une feuille de brouillon	et donner la mesure de $val14.</p>	<div class="wimscenter"><label for="reply1">$val14</label> =  
!read oef/embed.phtml r1,4 
$() cm</div>	
$()
!exit

