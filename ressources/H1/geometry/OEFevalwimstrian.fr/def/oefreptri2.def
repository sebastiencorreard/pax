!set title=Reproduire un triangle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 10

val6=$[rint($(tmp0))]
tmp0=!randint 7, 12

val7=$[rint($(tmp0))]
!readproc oef/draw.phtml 300,300 \
xrange -150,150	yrange -150,150	linewidth 1	triangle -80,-100,80,-100,0,100,black	text black,-90,-100,medium,A	text black,85,110,medium,B	rotate 180	triangle -80,-100,80,-100,0,100,black 
tmp0=$ins_url
val8=$(tmp0)
val9=$[sqrt($val7^2-$val6^2/4)]
val10=$[rint(10*sqrt($val6^2+$val9^2))]
val11=$[($val10-2)/10]
val12=$[($val10+2)/10]
val13=<img src="$val8" alt="">
replytype1=range
replyname1=
replygood1=!rawmath $val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val13</div>	 <div class="medium_size text_col">	<ul><li>Nous avons deux triangles isocèles de même mesure.	</li><li>La base mesure $val6 cm	</li><li>et les côtés égaux des triangles mesurent $val7 cm.	</li></ul>	Construire la figure sur une feuille de brouillon.	et donner la mesure du segment [AB] :	<div class="wimscenter"> <label for="reply1">AB =</label>	 
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,13
embedcnt=1
