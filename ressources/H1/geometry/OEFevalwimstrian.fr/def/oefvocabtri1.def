choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!randint 20, 80

val7=$[rint($(tmp0))]
tmp0=!randint 120, 180

val8=$[rint($(tmp0))]
tmp0=!randint 20, 180

val9=$[rint($(tmp0))]
tmp0=!randint 20, 80

val10=$[rint($(tmp0))]
tmp0=!randint 120, 180

val11=$[rint($(tmp0))]
tmp0=!randint 120, 180

val12=$[rint($(tmp0))]
!readproc oef/draw.phtml 200,200 \
segment $val7,$val8,$val9,$val10,black	text black,$val7-15,$val8,medium,$(val6[1])	segment $val7,$val8,$val11,$val12,black	text black,$val9,$val10-15,medium,$(val6[2])	segment $val9,$val10,$val11,$val12,black	text black,$val11+10,$val12,medium,$(val6[3]) 
tmp0=$ins_url
val13=$(tmp0)
tmp=!trim Le point $(val6[1]),Le point $(val6[2]),Le point $(val6[3])	Le segment [$(val6[1])$(val6[2])],Le segment [$(val6[3])$(val6[1])],Le segment [$(val6[2])$(val6[3])]
val14=!translate internal $	\
$ to ;; in $tmp
val15=sommet,côté
tmp0=!randint 1, 2

val16=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!randint 1, 3

val17=$[rint($(tmp0))]
tmp0=!item $val17 of $val14

val14=$(tmp0)
val18=<img src="$val13" alt="">
replytype1=raw
replyoption1=nocase 
replyname1=
replygood1=$(val15[$val16])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	 <div class="medium_size img_col">$val18</div>	 <div class="medium_size text_col">	<label for="reply1">$val14 est un</label>  
!read oef/embed.phtml r1,8 
$() du triangle $(val6[1])$(val6[2])$(val6[3]).	</div></div>	
$()
