!set title=Construction d'un triangle isocèle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 200,200 \
animate 40,0.01,0	xrange -100,100	yrange -100,100	linewidth 2	segment -80,-80,-80+160*s,-80,black 
tmp0=$ins_url
val6=$(tmp0)
!readproc oef/draw.phtml 200,200 \
animate 40,0.01,0	xrange -100,100	yrange -100,100	linewidth 2	segment -80,-80,80,-80,black	segment -80,-85,-80,-75,black	segment 80,-85,80,-75,black	text black,-85,-88,medium,A	text black,75,-88,medium,B	segment -80,-80,-80+sin((1-s*55/90)*pi/2)*200,-80+cos((1-s*55/90)*pi/2)*200, black	arc -80,-80,50,50,1,1+s*54,red 
tmp0=$ins_url
val7=$(tmp0)
!readproc oef/draw.phtml 200,200 \
animate 40,0.01,0	xrange -100,100	yrange -100,100	linewidth 2	segment -80,-80,80,-80,black	segment -80,-85,-80,-75,black	segment 80,-85,80,-75,black	text black,-85,-88,medium,A	text black,75,-88,medium,B	segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black	arc -80,-80,50,50,1,54,red	segment 80,-80,80-sin((1-55/90*s)*pi/2)*200,-80+cos((1-55/90*s)*pi/2)*200, black	arc 80,-80,50,50,180-55*s,180,red	 
tmp0=$ins_url
val8=$(tmp0)
!readproc oef/draw.phtml 200,200 \
animate 40,0.01,0	xrange -100,100	yrange -100,100	linewidth 2	segment -80,-80,80,-80,black	segment -80,-85,-80,-75,black	segment 80,-85,80,-75,black	text black,-85,-88,medium,A	text black,75,-88,medium,B	segment -80,-80,-80+sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black	arc -80,-80,50,50,1,54,red	segment 80,-80,80-sin((1-55/90)*pi/2)*200,-80+cos((1-55/90)*pi/2)*200, black	arc 80,-80,50,50,126,179,red	text black,-3,55,medium,C 
tmp0=$ins_url
val9=$(tmp0)
val10=<img src="$val6" alt="">,<img src="$val7" alt="">,<img src="$val8" alt="">,	<img src="$val9" alt="">
val11=Je trace un segment [AB] de longueur 8 cm.,	Je trace un angle de sommet A&#44; de côté &#91;AB&#41; et qui mesure 55°.,	Je trace un angle de sommet B&#44; de côté &#91;BA&#41; et qui mesure 55°.,	Je nomme C le point d'intersection des deux nouveaux côtés tracés.,	
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val11[1])
replytype2=dragfill
replyname2=
replygood2=$(val11[2])
replytype3=dragfill
replyname3=
replygood3=$(val11[3])
replytype4=dragfill
replyname4=
replygood4=$(val11[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Construire un triangle isocèle ABC tel que :	 <div class="wimscenter">AB = 8 cm,&nbsp; 
!insmath \widehat{BAC}
$() = 55°.</div>	Voici les différentes étapes de construction.	Placer le texte d'explication correct sous chaque dessin.	<table class="wimscenter wimsborder">	<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>	<tr>	 
!for m_i=1 to 3 
$()<td>$(val10[$m_i])</td> 
!next
$()	</tr><tr>	 
!for m_i=1 to 3 
$()<td> 
!read oef/embed.phtml r\i,250x80 
$()</td> 
!next
$()	</tr>	<tr><th>Étape 4</th><th></th><th></th></tr>	<tr>	 
!for m_i=4 to 4 
$()<td>$(val10[$m_i])</td> 
!next
$()	<td></td><td></td></tr><tr>	 
!for m_i=4 to 4 
$()<td> 
!read oef/embed.phtml r\i,250x80 
$()</td> 
!next
$()	<td></td><td></td></tr>	</table>
$()
!exit

