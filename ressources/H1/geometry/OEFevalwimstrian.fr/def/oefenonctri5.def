!set title=Énoncé 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val6=$(tmp0)
val7=Nous avons un triangle $(val6[1])$(val6[2])$(val6[3]) formé	par deux triangles $(val6[1])$(val6[2])$(val6[4]) et $(val6[1])$(val6[3])$(val6[4]) rectangles en $(val6[4]).
tmp0=!randint 40, 70

val8=$[$(tmp0)/10]
tmp0=!randint $val8*10+10, 100

val9=$[$(tmp0)/10]
tmp0=!randint $val8*10+10, 100

val10=$[$(tmp0)/10]
val11=$[rint(sqrt($val9^2-$val8^2)*10)]
val12=$[rint(sqrt($val10^2-$val8^2)*10)]
val13=$[rint($val11+$val12)]
val14=$[($val13-2)/10]
val15=$[($val13+2)/10]
val16=Nous avons les mesures suivantes	$(val6[1])$(val6[4]) = $val8 cm &#44;	$(val6[1])$(val6[2]) = $val9 cm et $(val6[1])$(val6[3]) = $val10 cm
val17=$(val6[2])$(val6[3])
replytype1=range
replyname1=
replygood1=!rawmath $val14,$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div>$val7 $val16.</div>	<p>	Faire la figure sur une feuille de brouillon	et donner la mesure de $val17.</p>	<div class="wimscenter"><label for="reply1">$val17</label> =  
!read oef/embed.phtml r1,4 
$() cm</div>	
$()
!exit

