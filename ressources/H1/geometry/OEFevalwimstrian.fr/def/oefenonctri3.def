!set title=Énoncé 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val6=$(tmp0)
val7=Nous avons un triangle $(val6[1])$(val6[2])$(val6[3]) équilatéral tel que
tmp0=!randint 40, 90

val8=$[$(tmp0)/10]
val9=$(val6[1])$(val6[2]) = $val8 cm
val10=$(val6[2])$(val6[3])
val11=$[$val8]
val12=$[$val8]
replytype1=range
replyname1=
replygood1=!rawmath $val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div>$val7 $val9.</div>	<p>	Faire la figure sur une feuille de brouillon	et donner la mesure de $val10.</p>	<div class="wimscenter"><label for="reply1">$val10</label> =  
!read oef/embed.phtml r1,4 
$() cm</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10
embedcnt=1
