!set title=Propriétés 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Triangle isocèle, Triangle équilatéral, Triangle rectangle
tmp=!trim Le triangle a deux côtés de même longueur.,Le triangle a deux angles égaux.	Le triangle a trois côtés de même longueur.,Le triangle a trois angles égaux.	Le triangle a un côté qui s'appelle l'hypoténuse.,Le triangle a un angle droit.
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!column $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val11=$[rint($val8)]
replytype1=click
replyname1=
replygood1=$val11;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Cliquer sur la propriété que possède le triangle suivant:	<p class="wimscenter">$(val6[$val8])</p>	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

