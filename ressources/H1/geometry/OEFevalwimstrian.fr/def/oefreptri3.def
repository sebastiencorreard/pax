!set title=Reproduire un triangle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 6, 10

val6=$[rint($(tmp0))]
!readproc oef/draw.phtml 300,300 \
xrange -150,150	yrange -150,150	linewidth 1	circle 0,0,230,black	triangle -100,-58,0,115,100,-58,black	text black,-80,10,medium,A	text black,75,10,medium,B	rotate -60	triangle -100,-58,0,115,100,-58,black 
tmp0=$ins_url
val7=$(tmp0)
val8=$[rint(10*$val6*2/3)]
val9=$[($val8-1)/10]
val10=$[($val8+1)/10]
val11=<img src="$val7" alt="">
replytype1=range
replyname1=
replygood1=!rawmath $val9,$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val11</div>	 <div class="medium_size text_col">	<ul><li>	Nous avons deux triangles équilatéraux de même mesure.	</li><li>Les côtés des deux triangles sont parallèles.	</li><li>et les côtés des triangles mesurent $val6 cm.	</li></ul>	Construire la figure sur une feuille de brouillon.	et donner la mesure du segment [AB] :	<div class="wimscenter"> <label for="reply1">AB =</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11
embedcnt=1
