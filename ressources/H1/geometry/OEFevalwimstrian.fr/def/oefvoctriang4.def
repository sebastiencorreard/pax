!set title=Vocabulaire sur les triangles particuliers 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/triangcomplex2b.jpg" alt="">
val7=autre, un triangle quelconque, un triangle rectangle, un triangle isocèle, un triangle équilatéral, un triangle rectangle et isocèle
val8=ABD,ADB,BDA,BAD,DBA,DAB,EGD,EDG,DGE,DEG,GDE,GED,KHJ,KJH,JHK,JKH,HJK,HKJ,	IKHF,HFIK,BDEC,DECB,DFHG,HGDF
val9=5,3,4,1
tmp0=!randint 1, 24

val10=$[rint($(tmp0))]
val11=$[rint($(val9[ceil($val10/6)]))]
replytype1=radio
replyname1=
replygood1=$val11;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	 <div class="medium_size img_col">$val6</div>	 <div class="medium_size text_col">	La figure géométrique $(val8[$val10]) est :  
!read oef/embed.phtml r1 
$()	</div></div>	
$()
!exit

