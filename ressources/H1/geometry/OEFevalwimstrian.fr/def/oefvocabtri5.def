tmp0=!randint 40, 130

val8=$[rint($(tmp0))]
!if abs($val8-$val7)<11 
val8=$[rint($val8-20)]
!endif
!readproc oef/draw.phtml 200,200 \
segment 50,150,50+$val7,150,black	text black,50-15,150,medium,$(val6[1])	segment 50,150,50,150-$val8,black	text black,50-15,150-$val8-15,medium,$(val6[2])	segment 50,150-$val8,50+$val7,150,black	text black,50+$val7+10,150,medium,$(val6[3])	linewidth 2	segment 51,142,58,142,red	segment 58,142,58,149,red 
tmp0=$ins_url
val9=$(tmp0)
tmp0=!shuffle $(val6[1]),$(val6[2]),$(val6[3])

val10=$(tmp0)
