val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!if $val12=1 
val13=$(val6[1])
!else
val13=[$(val6[2])$(val6[3])]|[$(val6[3])$(val6[2])]
!endif
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
