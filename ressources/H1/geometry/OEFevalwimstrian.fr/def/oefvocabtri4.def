!set title=Vocabulaire 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!randint 20, 80

val7=$[rint($(tmp0))]
!readproc oef/draw.phtml 200,200 \
segment 100-$val7,150,100+$val7,150,black	text black,100-$val7-15,150,medium,$(val6[1])	segment 100-$val7,150,100,150-$val7*sqrt(3),black	text black,100,150-$val7*sqrt(3)-15,medium,$(val6[2])	segment 100+$val7,150,100,150-$val7*sqrt(3),black	text black,100+$val7+10,150,medium,$(val6[3])	linewidth 2	segment (200-$val7)/2-4,(300-$val7*sqrt(3))/2-4,(200-$val7)/2+4,(300-$val7*sqrt(3))/2+4,red	segment (200+$val7)/2-4,(300-$val7*sqrt(3))/2+4,(200+$val7)/2+4,(300-$val7*sqrt(3))/2-4,red	segment 100-4,150+4,100+4,150-4,red 
tmp0=$ins_url
val8=$(tmp0)
tmp0=!shuffle $(val6[1]),$(val6[2]),$(val6[3])

val9=$(tmp0)
tmp=!trim le sommet opposé au côté [$(val9[1])$(val9[2])] est le sommet	le côté opposé au sommet $(val9[1]) est le côté 
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
!if $val11=1 
val12=$(val9[3])
!else
val12=[$(val9[2])$(val9[3])]|[$(val9[3])$(val9[2])]
!endif
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val13=<img src="$val8" alt="">
replytype1=case
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val13</div>	 <div class="medium_size text_col">	Dans le triangle $(val6[1])$(val6[2])$(val6[3]),	<label for="reply1">$val10</label>  
!read oef/embed.phtml r1,8 
$().	</div></div>	
$()
!exit

