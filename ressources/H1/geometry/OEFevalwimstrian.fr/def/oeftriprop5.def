postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Si le triangle , est isocèle&#130; , alors , il a , deux , côtés , de même longueur., trois	Si le triangle , est isocèle&#130; , alors , il a , deux , angles , égaux., trois	Si le triangle , est équilatéral&#130; , alors , il a , trois , côtés , de même longueur., deux	Si le triangle , est équilatéral&#130; , alors , il a , trois , angles , égaux., deux	Si le triangle , est rectangle&#130; , alors , il a , un , angle , droit., deux , obtus.
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 5

val7=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!item 1 to 7 of $val8

val9=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val9;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

