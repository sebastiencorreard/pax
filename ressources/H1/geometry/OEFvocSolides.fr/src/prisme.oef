\text{rep2=item(2,\var2)}
\integer{var3=item(2,\var)}
\text{var3=row(\var3,\list2)}
\text{quest3=item(1,\var3)}
\text{rep3=item(2,\var3)}

\text{fig=slib(geo3D/3Dviewer \fig1,height="250")}  

