\text{rep2=item(\choix1,5,8,10,7)}
\text{rep3=item(\choix1,9,18,24,15)}
\text{rep4=item(\choix1,6,12,16,10)}
\text{list2=Combien a-t-il de faces ?,\rep2
Combien a-t-il d'arêtes ?,\rep3
Combien a-t-il de sommets ?,\rep4}
