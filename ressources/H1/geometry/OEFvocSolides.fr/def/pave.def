!set title=Vocabulaire 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=P. BYACHE
email=byachepaul@yahoo.fr
language=fr

ansorder=r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=un cube,un pavé droit, un prisme droit à base triangulaire, un prisme droit à base hexagonale, une pyramide à base triangulaire, une pyramide à base carrée, un cylindre, un cône
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
tmp0=!item $val7 of  un cube,un pavé droit|un parallélépipède rectangle|un prisme droit à base carrée|un prisme droit à base rectangulaire

val8=$(tmp0)
tmp=!translate internal $	$ to ; in Combien a-t-il de faces ?,6	Combien a-t-il d'arêtes ?,12	Combien a-t-il de sommets ?,8

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)

!ifval $val7=1 
val12= carrés 
!else
val12= rectangles
!endif
!readproc slib/geo3D/threeD v 0 0 0	v 1 0 0	v 1 1 0	v 0 1 0	v 0 0 $val7	v 1 0 $val7	v 1 1 $val7	v 0 1 $val7	f 1 2 3 4	f 5 6 7 8	l 1 5	l 2 6	l 3 7	l 4 8	 
tmp0=$slib_out
val13=$(tmp0)
!readproc slib/utilities/nopaste 
tmp0=$slib_out
val14=$(tmp0)
replytype1=case
replyname1=
replygood1=$val8
replytype2=case
replyname2=
replygood2=$val11
replytype3=case
replyname3=
replygood3=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst Choisissez parmi les mots suivants :<br> $val6


!goto stat

!exit

