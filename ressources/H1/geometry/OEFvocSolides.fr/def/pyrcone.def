val6=un tétraèdre|une pyramide à base triangulaire|une pyramide dont la base est triangulaire|une pyramide dont la base est un triangle, une pyramide à base carrée|une pyramide dont la base est carrée|une pyramide dont la base est un carré, une pyramide à base pentagonale|une pyramide dont la base est pentagonale|une pyramide dont la base est un pentagone
tmp0=!randitem 1,2,3

val7=$[rint($(tmp0))]
tmp0=!item $val7 of $val6 

val8=$(tmp0)
tmp0=!item $val7 of tetrahedron,square_pyramid,pentagonal_pyramid

val9=$(tmp0)
tmp0=!item $val7 of 4,5,6

val10=$(tmp0)
tmp0=!item $val7 of 6,8,10

val11=$(tmp0)
tmp0=!item $val7 of 4,5,6

val12=$(tmp0)
val13=Combien a-t-il de faces ?,$val10	Combien a-t-il d'arêtes ?,$val11	Combien a-t-il de sommets ?,$val12
tmp0=!shuffle 1,2,3

val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val13

tmp=!row $val15 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

val16=$(tmp0)
tmp0=!item 2 of $val15

val10=$(tmp0)
tmp0=!item 2 of $val14

val17=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val13

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$(tmp0)
tmp0=!item 2 of $val17

val11=$(tmp0)
!readproc slib/geo3D/3Dviewer $val9,height="250" 
tmp0=$slib_out
val19=$(tmp0)
!readproc slib/utilities/nopaste 
tmp0=$slib_out
val20=$(tmp0)
