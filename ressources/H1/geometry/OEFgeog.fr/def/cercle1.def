!set title=Cercle (centre-point)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
title_ca=Circumferencia (centre-punt)
title_it=Circonferenza (centro-punto)
title_es=Circunferencia (centro-punto)
title_en=Circle (center-point)

ansorder=r
varcnt=40
prevarcnt=39
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]

!ifval $val7=1 
val8= A 
!else
val8= B
!endif

!ifval $val7=1 
val9= B 
!else
val9= A
!endif
val10=f,=Circle[$val8,$val9],\correct
val11=yes
val12=$[rint(3)]
val13=nothing
val14=height=400	width=600	showToolBar=true	enableRightClick=true	file=blanc.ggb	
val15=Votre figure est-elle correcte
val16=Votre score a été diminué car certains objets n'avaient pas le bon nom.
val17=Point
val18=Cercle
val19=
val20=Tracer un cercle de centre $val8 passant par un point $val9.
!if $val6=it 
val15=La figura è corretta
val16=Siete stati penalizzati perché alcuni oggetti non avevano il nome richiesto.
val17=Punto
val18=Circonferenza
val19=
val20=Tracciare una circonferenza di centro $val8 passante per un punto $val9.
!endif
!if $val6=es 
val15=La figura es correcta
val16=La nota se ha reducido porque el nombre de algún objecto no es correcto.
val17=Punto
val18=Circulo
val19=
val20=Dibujar una circunferencia con centro en un punto $val8 y que pase por otro punto $val9.
!endif
!if $val6=en 
val15=Is your figure correct
val16=Your score has been decreased because you did not give the good names to some objects.
val17=Point
val18=Circle
val19=
val20=Draw a circle with center $val8 going through a point $val9.
!endif
!if $val6=ca 
val15=La figura és correcta
val16=La nota s'ha reduït perquè el nom d'algun objecte no és correcte.
val17=Punt
val18=Cercle
val19=
val20=Dibuixar una circumferència amb centre en un punt $val8 i que passi per un altre punt $val9.
!endif
replytype1=geogebra

replyoption1=extra=$val11 output=$val13 max=$val12 weights=1&1&0 
replyname1=
replygood1=$val10 ?
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val19


!goto stat

!exit

:question
$()$val20	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val14 
$()	</div>	
$()
!exit

:hint
$()$val19
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval .5 isin $m_sc_reply1
 <div class='oef_feedbacks'><span class="oef_indbad">$val16</span>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=14,16,19,20
embedcnt=1
