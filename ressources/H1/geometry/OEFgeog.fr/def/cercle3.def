!set title=Cercle (centre-diamètre)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
title_ca=Circumferencia (centre-diametre)
title_it=Circonferenza (centro-diametro)
title_es=Circunferencia (centro-diametro)
title_en=Circle (center-diameter)

ansorder=r
varcnt=39
prevarcnt=38
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items 4,5,6,7,8,9,10,11,12

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
val8=$[$val7/2]
val9=f,=Circle[A,$val8],\correct
val10=yes
val11=$[rint(3)]
val12=nothing
val13=height=400	width=600	showToolBar=true	enableRightClick=true	file=blanc.ggb	
val14=Votre figure est-elle correcte
val15=Votre score a été diminué car certains objets n'avaient pas le bon nom.
val16=Point
val17=Cercle
val18=
val19=Tracer un cercle de centre A et de diamètre $val7.
!if $val6=it 
val14=La figura è corretta
val15=Siete stati penalizzati perché alcuni oggetti non avevano il nome richiesto.
val16=Punto
val17=Circonferenza
val18=
val19=Tracciare una circonferenza di centro A e di diametro $val7.
!endif
!if $val6=es 
val14=La figura es correcta
val15=La nota se ha reducido porque el nombre de algún objecto no es correcto.
val16=Punto
val17=Circulo
val18=
val19=Dibujar una circunferencia con centro en un punto A y de diámetro $val7.
!endif
!if $val6=en 
val14=Is your figure correct
val15=Your score has been decreased because you did not give the good names to some objects.
val16=Point
val17=Circle
val18=
val19=Draw a circle with center A and diameter $val7
!endif
!if $val6=ca 
val14=La figura és correcta
val15=La nota s'ha reduït perquè el nom d'algun objecte no és correcte.
val16=Punt
val17=Cercle
val18=
val19=Dibuixar una circumferència amb centre en un punt A i de diàmetre $val7.
!endif
replytype1=geogebra

replyoption1=extra=$val10 output=$val12 max=$val11 weights=1&1&0 
replyname1=
replygood1=$val9 ?
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val18


!goto stat

!exit

:question
$()$val19	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val13 
$()	</div>	
$()
!exit

:hint
$()$val18
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval .5 isin $m_sc_reply1
 <div class='oef_feedbacks'><span class="oef_indbad">$val15</span>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=13,15,18,19
embedcnt=1
