!set title=Demi-droite
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
title_ca=Semirecta
title_it=Semiretta
title_es=Semirecta
title_en=Semiline

ansorder=r
varcnt=37
prevarcnt=36
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=f,=Ray[A,B],\correct
val8=yes
val9=$[rint(3)]
val10=nothing
val11=height=400	width=600	showToolBar=true	enableRightClick=true	file=blanc.ggb	
val12=Votre figure est-elle correcte
val13=Votre score a été diminué car certains objets n'avaient pas le bon nom.
val14=Point
val15=Cercle
val16=
val17=Tracer une demi-droite &#91;AB&#41;.
!if $val6=it 
val12=La figura è corretta
val13=Siete stati penalizzati perché alcuni oggetti non avevano il nome richiesto.
val14=Punto
val15=Circonferenza
val16=
val17=Tracciare una semiretta &#91;AB&#41;.
!endif
!if $val6=es 
val12=La figura es correcta
val13=La nota se ha reducido porque el nombre de algún objecto no es correcto.
val14=Punto
val15=Circulo
val16=
val17=Dibujar una semirecta &#91;AB&#41;.
!endif
!if $val6=en 
val12=Is your figure correct
val13=Your score has been decreased because you did not give the good names to some objects.
val14=Point
val15=Circle
val16=
val17=Draw a semiline &#91;AB&#41;.
!endif
!if $val6=ca 
val12=La figura és correcta
val13=La nota s'ha reduït perquè el nom d'algun objecte no és correcte.
val14=Punt
val15=Cercle
val16=
val17=Dibuixar una semirecta &#91;AB&#41;.
!endif
replytype1=geogebra

replyoption1=extra=$val8 output=$val10 max=$val9 weights=1&1&0 
replyname1=
replygood1=$val7 ?
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val16


!goto stat

!exit

:question
$()$val17	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val11 
$()	</div>	
$()
!exit

:hint
$()$val16
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval .5 isin $m_sc_reply1
 <div class='oef_feedbacks'><span class="oef_indbad">$val13</span>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=11,13,16,17
embedcnt=1
