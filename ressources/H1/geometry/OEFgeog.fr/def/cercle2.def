!set title=Cercle (centre-rayon)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
title_ca=Circumferencia (centre-radi)
title_it=Circonferenza (centro-raggio)
title_es=Circunferencia (centro-radio)
title_en=Circle (center-radius)

ansorder=r
varcnt=38
prevarcnt=37
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!nonempty items 4,5,6,7,8,9,10,11,12

tmp0=!randitem $tmp
val7=$[rint($(tmp0))]
val8=f,=Circle[A,$val7],\correct
val9=yes
val10=$[rint(3)]
val11=nothing
val12=height=400	width=600	showToolBar=true	enableRightClick=true	file=blanc.ggb	
val13=Votre figure est-elle correcte
val14=Votre score a été diminué car certains objets n'avaient pas le bon nom.
val15=Point
val16=Cercle
val17=
val18=Tracer un cercle de centre A et de rayon $val7.
!if $val6=it 
val13=La figura è corretta
val14=Siete stati penalizzati perché alcuni oggetti non avevano il nome richiesto.
val15=Punto
val16=Circonferenza
val17=
val18=Tracciare una circonferenza di centro A e di raggio $val7.
!endif
!if $val6=es 
val13=La figura es correcta
val14=La nota se ha reducido porque el nombre de algún objecto no es correcto.
val15=Punto
val16=Circulo
val17=
val18=Dibujar una circunferencia con centro en un punto A y de radio $val7.
!endif
!if $val6=en 
val13=Is your figure correct
val14=Your score has been decreased because you did not give the good names to some objects.
val15=Point
val16=Circle
val17=
val18=Draw a circle with center A and radius $val7
!endif
!if $val6=ca 
val13=La figura és correcta
val14=La nota s'ha reduït perquè el nom d'algun objecte no és correcte.
val15=Punt
val16=Cercle
val17=
val18=Dibuixar una circumferència amb centre en un punt A i de radi $val7.
!endif
replytype1=geogebra

replyoption1=extra=$val9 output=$val11 max=$val10 weights=1&1&0 
replyname1=
replygood1=$val8 ?
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val17


!goto stat

!exit

:question
$()$val18	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val12 
$()	</div>	
$()
!exit

:hint
$()$val17
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval .5 isin $m_sc_reply1
 <div class='oef_feedbacks'><span class="oef_indbad">$val14</span>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,14,17,18
embedcnt=1
