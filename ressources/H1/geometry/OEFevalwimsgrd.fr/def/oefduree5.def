!set title=Durée 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=7,24,60,60
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
!if $val10<3 
tmp0=!randint 25, 239

val11=$[rint($(tmp0))]
!else
tmp0=!randint 61, 599

val11=$[rint($(tmp0))]
!endif
val12=$[rint(floor($val11/$(val9[$val10-1])))]
val13=$[rint($val11-$val12*$(val9[$val10-1]))]
replyname1=
replygood1=$val12
replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Compléter l'égalité suivante :	<div class="wimscenter">$val11 $(val7[$val10]) =  
!read oef/embed.phtml r1,5 
$() $(val7[$val10-1])  
!read oef/embed.phtml r2,5 
$() $(val7[$val10])</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11
embedcnt=2
