!set title=Durée 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=100000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=7,24,60,60
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
!if $val10<3 
tmp0=!randint 1, 6

val11=$[rint($(tmp0))]
!endif
!if $val10=3 
tmp0=!randint 1, 23

val11=$[rint($(tmp0))]
!endif
val12=$[rint($val11)]
tmp0=!randint 2, 3

val13=$[rint($(tmp0))]
val14=$[rint($val10+$val13)]
!if $val14>5 
val14=$[rint(5)]
!endif
!for val15 =$val10 to $val14-1 
val12=$[rint($val12*$(val9[$val15]))]
!next
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Compléter l'égalité suivante :	<div class="wimscenter"><label for="reply1">$val11 $(val7[$val10]) =</label>  
!read oef/embed.phtml r1,5 
$() $(val7[$val14])</div>	
$()
!exit

