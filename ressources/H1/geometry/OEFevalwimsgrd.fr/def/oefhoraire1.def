!set title=Horaires 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=100000

ansorder=r
varcnt=27
prevarcnt=26
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=avion,train,voiture
val7=semaine,jour,heure,minute,seconde
val8=semaines,jours,heures,minutes,secondes
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=boy,girl
val11=Il,Elle
!readproc slib/lang/fname fr,$(val10[$val9]) 
tmp0=$slib_out
val12=$(tmp0)
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val13=$(tmp0)
val14=$val7
val15=$val8
val16=$(val7[1]),j,h,min,s
val17=7,24,60,60
val18=+
val19=$[rint(3)]
tmp0=!randint 7, 20

val20=$[rint($(tmp0))]
tmp0=!randint 2, 59

val21=$[rint($(tmp0))]
tmp0=!randint 1, 22-$val20

val22=$[rint($(tmp0))]
tmp0=!randint 61-$val21, 59

val23=$[rint($(tmp0))]
val24=$[rint($val20+$val22)]
val25=$[rint($val21+$val23)]
val26=$[rint(floor($val25/$(val17[$val19])))]
val25=$[rint($val25-$val26*$(val17[$val19]))]
val24=$[rint($val24+$val26)]
val27=$val24 $(val16[$val19]) $val25 $(val16[$val19+1])
val28=fait un voyage en,	  part à,	  Son voyage dure,	  Quelle est son heure d'arrivée
val29=$val20,$val21,$val22,$val23
replytype1=raw
replyoption1=nocase nospace 
replyname1=
replygood1=$val27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val12 $(val28[1]) $val13 :	<ul>	<li>$(val11[$val9]) $(val28[2]) $(val29[1]) $(val16[$val19]) $(val29[2]) $(val16[$val19+1]). </li>	<li>$(val28[3]) $(val29[3]) $(val16[$val19]) $(val29[4]) $(val16[$val19+1]).</li>	</ul>	<div class="spacer">$(val28[4]) ?  
!read oef/embed.phtml r1,20 
$()</div>	<div class="wims_instruction">	<ul><li>Rappel des unités :	h : heure ; min : minute ; s : seconde.	</li><li>Exemple pour le format de réponse : 11 h 4 min; 1 h 45 min</li>	</ul>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,11,12,13,16,19,28,29
embedcnt=1
