!set title=Soustraction de durées 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=10000

ansorder=r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=-
tmp0=!randint 2, 4

val10=$[rint($(tmp0))]
!if $val10=2 
tmp0=!randint 2, 6

val11=$[rint($(tmp0))]
tmp0=!randint 2, 23

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val11-1

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0))]
!endif
!if $val10=3 
tmp0=!randint 2, 23

val11=$[rint($(tmp0))]
tmp0=!randint 2, 59

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val11-1

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0))]
!endif
!if $val10=4 
tmp0=!randint 2, 59

val11=$[rint($(tmp0))]
tmp0=!randint 2, 59

val12=$[rint($(tmp0))]
tmp0=!randint 1, $val11-1

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val12-1

val14=$[rint($(tmp0))]
!endif
val15=$[rint($val11-$val13)]
val16=$[rint($val12-$val14)]
replyname1=
replygood1=$val15
replyname2=
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Faire le calcul suivant et donner le résultat :	<div class="wimscenter"> $val11 $(val8[$val10]) $val12 $(val8[$val10+1]) $val9	$val13 $(val8[$val10]) $val14 $(val8[$val10+1]) =	 
!read oef/embed.phtml r1,5 
$() $(val8[$val10])  
!read oef/embed.phtml r2,5 
$() $(val8[$val10+1]) </div>	<div class="wims_instruction">Rappel des unités :	j : jour ; h : heure ; min : minute ; s : seconde.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,10,11,12,13,14
embedcnt=2
