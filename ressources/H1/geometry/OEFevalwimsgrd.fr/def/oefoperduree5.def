val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
!if $val11=2 
tmp0=!randint 2, 5

val13=$[rint($(tmp0))]
tmp0=!randint 2, 22

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val13-1

val15=$[rint($(tmp0))]
tmp0=!randint $val14+1, 23

val16=$[rint($(tmp0))]
!endif
!if $val11=3 
tmp0=!randint 2, 22

val13=$[rint($(tmp0))]
tmp0=!randint 2, 59

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val13-1

val15=$[rint($(tmp0))]
tmp0=!randint $val14+1, 59

val16=$[rint($(tmp0))]
!endif
!if $val11>3 
tmp0=!randint 1, 59

val13=$[rint($(tmp0))]
tmp0=!randint 2, 59

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val13-1

val15=$[rint($(tmp0))]
tmp0=!randint $val14+1, 59

val16=$[rint($(tmp0))]
!endif
val17=$[rint($val13-1)]
val18=$[rint($val17-$val15)]
val19=$[rint($(val9[$val11])+$val14)]
val20=$[rint($val19-$val16)]
