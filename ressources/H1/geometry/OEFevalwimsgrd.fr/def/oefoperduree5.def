!goto stat

!exit

:question
$()Faire le calcul suivant et donner le résultat :	<div class="wimscenter"> $val13 $(val8[$val11]) $val14 $(val8[$val11+1]) $val10	$val15 $(val8[$val11]) $val16 $(val8[$val11+1]) =	 
!read oef/embed.phtml r1,5 
$() $(val8[$val11])  
!read oef/embed.phtml r2,5 
$() $(val8[$val11+1]) </div>	<div class="wims_instruction">Rappel des unités :	j : jour ; h : heure ; min : minute ; s : seconde.</div>		Remplir correctement avec des nombres l'opération posée pour pouvoir faire le calcul :	<table class="wimscenter wimsnoborder">	<tr><td></td><td> 
!read oef/embed.phtml r3,5 
$()</td><td>$(val8[$val11])</td><td> 
!read oef/embed.phtml r4,5 
$()</td><td>$(val8[$val11+1])</td><td></td></tr>	<tr><td>-</td><td> 
!read oef/embed.phtml r5,5 
$()</td><td>$(val8[$val11])</td><td> 
!read oef/embed.phtml r6,5 
$()</td><td>$(val8[$val11+1])</td><td></td></tr>	<tr><td colspan="5"><hr></td></tr>	<tr><td></td><td> 
!read oef/embed.phtml r7,5 
$()</td><td>$(val8[$val11])</td><td> 
!read oef/embed.phtml r8,5 
$()</td><td>$(val8[$val11+1])</td><td></td></tr>	</table>
$()
