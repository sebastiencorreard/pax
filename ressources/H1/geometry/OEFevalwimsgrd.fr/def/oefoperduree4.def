!set title=Addition de durées 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=100000

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=7,24,60,60
val10=+
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
!if $val11=2 
tmp0=!randint 1, 5

val13=$[rint($(tmp0))]
tmp0=!randint 2, 23

val14=$[rint($(tmp0))]
tmp0=!randint 1, 5-$val13

val15=$[rint($(tmp0))]
tmp0=!randint 25-$val14, 23

val16=$[rint($(tmp0))]
!endif
!if $val11=3 
tmp0=!randint 1, 22

val13=$[rint($(tmp0))]
tmp0=!randint 2, 59

val14=$[rint($(tmp0))]
tmp0=!randint 1, 22-$val13

val15=$[rint($(tmp0))]
tmp0=!randint 61-$val14, 59

val16=$[rint($(tmp0))]
!endif
!if $val11>3 
tmp0=!randint 1, 59

val13=$[rint($(tmp0))]
tmp0=!randint 2, 59

val14=$[rint($(tmp0))]
tmp0=!randint 1, 59-$val13

val15=$[rint($(tmp0))]
tmp0=!randint 61-$val14, 59

val16=$[rint($(tmp0))]
!endif
val17=$[rint($val13+$val15)]
val18=$[rint($val14+$val16)]
val19=$[rint(floor($val18/$(val9[$val11])))]
val18=$[rint($val18-$val19*$(val9[$val11]))]
val17=$[rint($val17+$val19)]
replyname1=
replygood1=$val17
replyname2=
replygood2=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Faire le calcul suivant et donner le résultat :	<div class="wimscenter"> $val13 $(val8[$val11]) $val14 $(val8[$val11+1]) $val10	$val15 $(val8[$val11]) $val16 $(val8[$val11+1]) =	 
!read oef/embed.phtml r1,5 
$() $(val8[$val11])  
!read oef/embed.phtml r2,5 
$() $(val8[$val11+1]) </div>	<div class="wims_instruction">Rappel des unités :	j : jour ; h : heure ; min : minute ; s : seconde.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,13,14,15,16
embedcnt=2
