!set title=Durée 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=100000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=7,24,60,60
tmp0=!randint 2, 5

val10=$[rint($(tmp0))]
!if $val10<3 
tmp0=!randint 2, 12

val11=$[rint($(tmp0))]
!else
tmp0=!randint 2, 59

val11=$[rint($(tmp0))]
!endif
val12=$[rint($val11*$(val9[$val10-1]))]
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Compléter l'égalité suivante :	<div class="wimscenter"><label for="reply1">$val12 $(val7[$val10]) =</label>  
!read oef/embed.phtml r1,5 
$() $(val7[$val10-1])</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,12
embedcnt=1
