!set title=Multiplication de durées
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=time
precision=100000

ansorder=r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=semaine,jour,heure,minute,seconde
val7=semaines,jours,heures,minutes,secondes
val8=semaine,j,h,min,s
val9=7,24,60,60
val10=\(\times)
tmp0=!randint 3, 5

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
!if $val11=3 
tmp0=!randint 23/$val12+1, 23

val13=$[rint($(tmp0))]
!endif
!if $val11=4 
tmp0=!randint 59/$val12+1, 59

val13=$[rint($(tmp0))]
!endif
!if $val11=5 
tmp0=!randint 59/$val12+1, 59

val13=$[rint($(tmp0))]
!endif
val14=$[rint($val13*$val12)]
val15=$[rint(floor($val14/$(val9[$val11-1])))]
val16=$[rint($val14-$val15*$(val9[$val11-1]))]
!if $val16=0 
val12=$[rint($val12+1)]
val14=$[rint($val13*$val12)]
val15=$[rint(floor($val14/$(val9[$val11-1])))]
val16=$[rint($val14-$val15*$(val9[$val11-1]))]
!endif
replyname1=
replygood1=$val15
replyname2=
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Faire le calcul suivant et donner le résultat :	<div class="wimscenter"> $val13 $(val8[$val11]) $val10 $val12 =	 
!read oef/embed.phtml r1,5 
$() $(val8[$val11-1])  
!read oef/embed.phtml r2,5 
$() $(val8[$val11]) </div>	<div class="wims_instruction">Rappel des unités :	j : jour ; h : heure ; min : minute ; s : seconde.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,12,13
embedcnt=2
