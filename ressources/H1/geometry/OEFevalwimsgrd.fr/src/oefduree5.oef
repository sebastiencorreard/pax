\title{Durée 5}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\keywords{time}
\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\text{conv=7,24,60,60}
\precision(100000)

\integer{ch=randint(2..5)}
\if{\ch<3}{\integer{nb=randint(25..239)}}{\integer{nb=randint(61..599)}}
\integer{m=floor(\nb/\conv[\ch-1])}
\integer{n=\nb-\m*\conv[\ch-1]}

\statement{ Compléter l'égalité suivante :
<div class="wimscenter">\nb \units[\ch] = \embed{r1,5} \units[\ch-1] \embed{r2,5} \units[\ch]</div>
}

\answer{}{\m}
\answer{}{\n}
