\title{Multiplication de durées}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\keywords{time}
\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\text{conv=7,24,60,60}
\text{sign=\(\times)}
\integer{ch=randint(3..5)}
\integer{m=randint(2..9)}
\if{\ch=3}{\integer{a1=randint(23/\m+1..23)}}
\if{\ch=4}{\integer{a1=randint(59/\m+1..59)}}
\if{\ch=5}{\integer{a1=randint(59/\m+1..59)}}

\integer{r=\a1*\m}
\integer{rep1=floor(\r/\conv[\ch-1])}
\integer{rep2=\r-\rep1*\conv[\ch-1]}
\if{\rep2=0}{\integer{m=\m+1}
  \integer{r=\a1*\m}
  \integer{rep1=floor(\r/\conv[\ch-1])}
  \integer{rep2=\r-\rep1*\conv[\ch-1]}
}

\statement{Faire le calcul suivant et donner le résultat :
<div class="wimscenter"> \a1 \abr[\ch] \sign \m =
\embed{r1,5} \abr[\ch-1] \embed{r2,5} \abr[\ch] </div>
<div class="wims_instruction">Rappel des unités :
j : jour ; h : heure ; min : minute ; s : seconde.</div>}
\answer{}{\rep1}
\answer{}{\rep2}
