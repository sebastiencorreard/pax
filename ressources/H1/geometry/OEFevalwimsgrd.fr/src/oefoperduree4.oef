\title{Addition de durées 2}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\keywords{time}
\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\text{conv=7,24,60,60}
\text{sign=+}
\integer{ch=randint(2..4)}
\integer{m=randint(2..9)}
\if{\ch=2}{\integer{a1=randint(1..5)}
  \integer{b1=randint(2..23)}
  \integer{a2=randint(1..5-\a1)}
  \integer{b2=randint(25-\b1..23)}}
\if{\ch=3}{\integer{a1=randint(1..22)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..22-\a1)}
  \integer{b2=randint(61-\b1..59)}}
\if{\ch>3}{\integer{a1=randint(1..59)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..59-\a1)}
  \integer{b2=randint(61-\b1..59)}}
\integer{r=\a1+\a2}
\integer{s=\b1+\b2}
\integer{t=floor(\s/\conv[\ch])}
\integer{s=\s-\t*\conv[\ch]}
\integer{r=\r+\t}


\statement{Faire le calcul suivant et donner le résultat :
<div class="wimscenter"> \a1 \abr[\ch] \b1 \abr[\ch+1] \sign
\a2 \abr[\ch] \b2 \abr[\ch+1] =
\embed{r1,5} \abr[\ch] \embed{r2,5} \abr[\ch+1] </div>
<div class="wims_instruction">Rappel des unités :
j : jour ; h : heure ; min : minute ; s : seconde.</div>}
\answer{}{\r}
\answer{}{\s}
