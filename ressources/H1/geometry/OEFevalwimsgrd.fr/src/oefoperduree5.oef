\title{Soustraction de durées 2}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\keywords{time}

\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\text{conv=7,24,60,60}
\text{sign=-}
\integer{ch=randint(2..4)}
\integer{m=randint(2..9)}
\if{\ch=2}{\integer{a1=randint(2..5)}
  \integer{b1=randint(2..22)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(\b1+1..23)}}
\if{\ch=3}{\integer{a1=randint(2..22)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(\b1+1..59)}}
\if{\ch>3}{\integer{a1=randint(1..59)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(\b1+1..59)}}
\integer{u=\a1-1}
\integer{r=\u-\a2}
\integer{t=\conv[\ch]+\b1}
\integer{s=\t-\b2}

\statement{Faire le calcul suivant et donner le résultat :
<div class="wimscenter"> \a1 \abr[\ch] \b1 \abr[\ch+1] \sign
\a2 \abr[\ch] \b2 \abr[\ch+1] =
\embed{r1,5} \abr[\ch] \embed{r2,5} \abr[\ch+1] </div>
<div class="wims_instruction">Rappel des unités :
j : jour ; h : heure ; min : minute ; s : seconde.</div>

Remplir correctement avec des nombres l'opération posée pour pouvoir faire le calcul :
<table class="wimscenter wimsnoborder">
<tr><td></td><td>\embed{r3,5}</td><td>\abr[\ch]</td><td>\embed{r4,5}</td><td>\abr[\ch+1]</td><td></td></tr>
<tr><td>-</td><td>\embed{r5,5}</td><td>\abr[\ch]</td><td>\embed{r6,5}</td><td>\abr[\ch+1]</td><td></td></tr>
<tr><td colspan="5"><hr></td></tr>
<tr><td></td><td>\embed{r7,5}</td><td>\abr[\ch]</td><td>\embed{r8,5}</td><td>\abr[\ch+1]</td><td></td></tr>
</table>}

\answer{}{\r}
\answer{}{\s}
\answer{}{\u}
\answer{}{\t}
\answer{}{\a2}
\answer{}{\b2}
\answer{}{\r}
\answer{}{\s}
