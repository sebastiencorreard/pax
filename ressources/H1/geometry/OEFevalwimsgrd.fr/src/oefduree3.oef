\title{Durée 3}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\keywords{time}
\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\text{conv=7,24,60,60}
\precision{100000}

\integer{ch=randint(1..3)}
\if{\ch<3}{\integer{nb=randint(1..6)}}
\if{\ch=3}{\integer{nb=randint(1..23)}}
\integer{rep=\nb}
\integer{a=randint(2..3)}
\integer{d=\ch+\a}
\if{\d>5}{\integer{d=5}}
\for{i=\ch to \d-1}
     {\integer{\rep=\rep*\conv[\i]}}


\statement{
Compléter l'égalité suivante :
<div class="wimscenter"><label for="reply1">\nb \units[\ch] =</label> \embed{r1,5} \units[\d]</div>
}

\answer{}{\rep}
