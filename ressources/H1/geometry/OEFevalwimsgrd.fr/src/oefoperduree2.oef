\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\keywords{time}
\text{unit=semaine,jour,heure,minute,seconde}
\text{units=semaines,jours,heures,minutes,secondes}
\text{abr=semaine,j,h,min,s}
\title{Soustraction de durées 1}
\text{sign=-}
\precision{10000}
\integer{ch=randint(2..4)}
\if{\ch=2}{\integer{a1=randint(2..6)}
  \integer{b1=randint(2..23)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(1..\b1-1)}}
\if{\ch=3}{\integer{a1=randint(2..23)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(1..\b1-1)}}
\if{\ch=4}{\integer{a1=randint(2..59)}
  \integer{b1=randint(2..59)}
  \integer{a2=randint(1..\a1-1)}
  \integer{b2=randint(1..\b1-1)}}
\integer{rep1=\a1-\a2}
\integer{rep2=\b1-\b2}
\statement{Faire le calcul suivant et donner le résultat :
<div class="wimscenter"> \a1 \abr[\ch] \b1 \abr[\ch+1] \sign
\a2 \abr[\ch] \b2 \abr[\ch+1] =
\embed{r1,5} \abr[\ch] \embed{r2,5} \abr[\ch+1] </div>
<div class="wims_instruction">Rappel des unités :
j : jour ; h : heure ; min : minute ; s : seconde.</div>}
\answer{}{\rep1}
\answer{}{\rep2}
