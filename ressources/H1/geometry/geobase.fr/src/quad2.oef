\title{Vocabulaire 2 des quadrilatères.}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}
\language{fr}
\text{nopaste=slib(utilities/nopaste)}
\text{confparm1= \confparm1 issametext ? 1,2,3,4 : \confparm1}
\text{list1=un quadrilatère quelconque, un losange, un rectangle, un carré, un quadrilatère croisé, un trapèze, un parallélogramme, un cerf-volant}
\integer{a=wims(randitem \confparm1)}
\text{list2=wims(item \confparm1 of \list1)}

\text{mot=item(\a,\list1)}
\text{lettres=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,P,Q,R,S,T,U,V,W,X,Y,Z)}
\text{l=item(1,\lettres)}
\text{m=item(2,\lettres)}
\text{n=item(3,\lettres)}
\text{o=item(4,\lettres)}
\integer{test=random(1,2,3,4,5,6)}
\text{q2=item(\test, &#91;\l\m&#93; est,&#91;\l\n&#93; est , &#91;\l\m&#93; et &#91;\m\n&#93; sont deux, &#91;\l\m&#93; et &#91;\n\o&#93; sont deux, \l et \m sont deux, \l et \n sont deux)}
\text{rep2=item(\test,un côté,une diagonale,côtés consécutifs|côtés adjacents,côtés opposés,sommets consécutifs,sommets opposés)}

!!angle de rotation des figures
\real{d=random(0..6.28)}

!!définition des sommets du quadrilatère
\if{\a=1}{
!!quad quelconque
\real{x1=4*cos(\d)}
\real{y1=4*sin(\d)}
\real{x2=cos(1.57+\d)}
\real{y2=sin(1.57+\d)}
\real{x3=2*cos(3.14+\d)}
\real{y3=2*sin(3.14+\d)}
\real{x4=4*cos(4.71+\d)}
\real{y4=4*sin(4.71+\d)}
}
\if{\a=2}{
!!losange
\real{x1=4*cos(\d)}
\real{y1=4*sin(\d)}
\real{x2=2*cos(1.57+\d)}
\real{y2=2*sin(1.57+\d)}
\real{x3=4*cos(3.14+\d)}
\real{y3=4*sin(3.14+\d)}
\real{x4=2*cos(4.71+\d)}
\real{y4=2*sin(4.71+\d)}
}
\if{\a=3}{
!!rectangle
\real{x1=3*cos(\d)}
\real{y1=3*sin(\d)}
\real{x2=4.243*cos(0.785+\d)}
\real{y2=4.243*sin(0.785+\d)}
\real{x4=3*cos(3.14+\d)}
\real{y4=3*sin(3.14+\d)}
\real{x3=4.243*cos(2.356+\d)}
\real{y3=4.243*sin(2.356+\d)}
}
\if{\a=4}{
!!carré
\real{x1=3*cos(\d)}
\real{y1=3*sin(\d)}
\real{x2=3*cos(1.57+\d)}
\real{y2=3*sin(1.57+\d)}
\real{x3=3*cos(3.14+\d)}
\real{y3=3*sin(3.14+\d)}
\real{x4=3*cos(4.71+\d)}
\real{y4=3*sin(4.71+\d)}
}
\if{\a=5}{
!!quad croisé
\real{x1=4*cos(\d)}
\real{y1=4*sin(\d)}
\real{x4=cos(1.57+\d)}
\real{y4=sin(1.57+\d)}
\real{x2=2*cos(3.14+\d)}
\real{y2=2*sin(3.14+\d)}
\real{x3=4*cos(4.71+\d)}
\real{y3=4*sin(4.71+\d)}
}
\if{\a=6}{
!!trapèze
\real{x1=2*cos(\d)}
\real{y1=2*sin(\d)}
\real{x2=2*cos(1.52+\d)}
\real{y2=2*sin(1.52+\d)}
\real{x3=3*cos(2.54+\d)}
\real{y3=3*sin(2.54+\d)}
\real{x4=3*cos(5.31+\d)}
\real{y4=3*sin(5.31+\d)}
}
\if{\a=7}{
!!parallélogramme
\real{x1=3*cos(\d)}
\real{y1=3*sin(\d)}
\real{x2=2*cos(0.785+\d)}
\real{y2=2*sin(0.785+\d)}
\real{x3=3*cos(3.14+\d)}
\real{y3=3*sin(3.14+\d)}
\real{x4=2*cos(3.925+\d)}
\real{y4=2*sin(3.925+\d)}
}
\if{\a=8}{
!!cerf-volant
\real{x1=4*cos(\d)}
\real{y1=4*sin(\d)}
\real{x2=1*cos(1.57+\d)}
\real{y2=1*sin(1.57+\d)}
\real{x3=2*cos(3.14+\d)}
\real{y3=2*sin(3.14+\d)}
\real{x4=1*cos(4.71+\d)}
\real{y4=1*sin(4.71+\d)}
}


\statement{C'est... \embed{c1,25} et
\q2...\embed{r1,25
autocomplete="off"}
<div class="wimscenter">
\draw{600,200}{
   linewidth 1
   xrange -15,15
   yrange -5,5
   poly green,\x1,\y1,\x2,\y2,\x3,\y3,\x4,\y4
   segment \x1,\y1,\x3,\y3,blue
   segment \x2,\y2,\x4,\y4,blue
   linewidth 2
   text red,\x1,\y1-0.3,giant,\l
   text red,\x2,\y2-0.3,giant,\m
   text red,\x3,\y3-0.3,giant,\n
   text red,\x4,\y4-0.3,giant,\o
}
</div>
}

\choice{}{\mot}{\list1}{weight=2}
\answer{}{\rep2}{type=case}{weight=2}
\hint{\nopaste Choisissez parmi les mots suivants :<div class="wimscenter">
\un côté, une diagonale, des côtés consécutifs, des côtés opposés, des sommets consécutifs,
des sommets opposés
</div>}
