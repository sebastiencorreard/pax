\title{Vocabulaire 1 des segments, droites...}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}
\language{fr}

\integer{a=random(6,8,10)}
\integer{b=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\integer{k1=random(1,0)}
\integer{k2=random(1,0)}
\integer{k3=random(1,0)}
\real{t1=-1+2*\k1/5}
\real{t2=2-2*\k2/5}
\text{m1=random(A,B,C)}
\text{m2=random(D,E,F)}
!! taille des points
\real{z=0.3}
\real{x1=\a*\t1}
\real{x2=\a*\t2}
\real{y1=\b*\t1}
\real{y2=\b*\t2}
\integer{test=4*\k3+2*\k2+\k1+1}
\text{choix=un segment, une demi-droite, une demi-droite, une droite, un segment, un point, un point, une droite}
\text{mot=item(\test,\choix)}
\text{choix2=&#91;\m1\m2&#93;  , &#91;\m2\m1&#41; , &#91;\m1\m2&#41; , &#40;\m1\m2&#41; , &#91;\m1\m2&#93; , \m2 , \m1 , &#40;\m1\m2&#41;}
\text{nom=item(\test,\choix2)}

\statement{C'est... \embed{r1,20
autocomplete="off"}.
Son nom est...\embed{c1}
<div class="wimscenter">
\if{\test<6 or \test>7}{\draw{600,200}{
   linewidth 1
   xrange -31,31
   yrange -12,12
   trange -1,2
   plot green, \a*t,\b*t
   linewidth 2
   segment \x1-\z , \y1-\z , \x1+\z , \y1+\z , red
   segment \x1-\z , \y1+\z , \x1+\z , \y1-\z , red
   segment \x2-\z , \y2-\z , \x2+\z , \y2+\z , red
   segment \x2-\z , \y2+\z , \x2+\z , \y2-\z , red
   text red,\x1,\y1-2*\z,giant,\m1
   text red,\x2,\y2-2*\z,giant,\m2
}}
\if{\test=6}{\draw{600,200}{
   linewidth 2
   xrange -31,31
   yrange -12,12
   segment \x2-\z , \y2-\z , \x2+\z , \y2+\z , red
   segment \x2-\z , \y2+\z , \x2+\z , \y2-\z , red
   text red,\x2,\y2-2*\z,giant,\m2
}}
\if{\test=7}{\draw{600,200}{
   linewidth 2
   xrange -31,31
   yrange -12,12
   segment \x1-\z , \y1-\z , \x1+\z , \y1+\z , red
   segment \x1-\z , \y1+\z , \x1+\z , \y1-\z , red
   text red,\x1,\y1-2*\z,giant,\m1
}}
</div>
}

\answer{}{\mot}{type=case}
\choice{}{\nom}{\choix2}
\hint{Choisissez parmi les mots suivants :<div class="wimscenter">
un point,
un segment,
une droite,
une demi-droite
</div>}