\title{Vocabulaire 2 des segments, droites...}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}
\language{fr}

\integer{a=random(6,8,10)}
\integer{b=random(-5,-4,-3,-2,-1,1,2,3,4,5)}
\integer{c=random(0,1)}
\integer{k1=random(1,0)}
\integer{k2=random(1,0)}
\real{t1=-1+2*\k1/5}
\real{t2=2-2*\k2/5}
\text{m1=random(A,B,C)}
\text{m2=random(D,E,D)}
!! taille des points
\real{z=0.3}
\real{x1=\a*\t1}
\real{x2=\a*\t2}
\real{y1=\b*\t1}
\real{y2=\b*\t2}
\integer{test=2*\k2+\k1+1}
\integer{h1=0}
\integer{h2=0}
\if{\c=1}{\if{\test=2}{\text{m1=random(x,y,z)}
                       \integer{h1=1}}
          \if{\test=3}{\text{m2=random(u,v,w)}
                       \integer{h2=1}}
          \if{\test=4}{\text{m1=random(x,y,z)}
                       \integer{h1=1}
                       \text{m2=random(u,v,w)}
                       \integer{h2=1}}
}

\text{choix=le segment &#91;\m1 \m2&#93;, la demi-droite &#91;\m2 \m1&#41;, la demi-droite &#91;\m1 \m2&#41;, la droite &#40;\m1 \m2&#41;}
\text{rep1=item(\test,\choix)}
\text{rep2=item(\h1+1,Oui c'est un point. , Non ce n'est pas un point)}
\text{rep3=item(\h2+1,Oui c'est un point. , Non ce n'est pas un point)}



\statement{C'est... \embed{c1,20} <br>
\m1 est-il un point ?\embed{c2}<br>
\m2 est-il un point ?\embed{c3}
<div class="wimscenter">
\if{\h1=0 and \h2=0}{\draw{600,200}{
   linewidth 1
   xrange -31,31
   yrange -12.5,12
   trange -1,2
   plot green, \a*t,\b*t
   linewidth 2
   segment \x1-\z , \y1-\z , \x1+\z , \y1+\z , red
   segment \x1-\z , \y1+\z , \x1+\z , \y1-\z , red
   segment \x2-\z , \y2-\z , \x2+\z , \y2+\z , red
   segment \x2-\z , \y2+\z , \x2+\z , \y2-\z , red
   text red,\x1,\y1-2*\z,giant,\m1
   text red,\x2,\y2-2*\z,giant,\m2
}}
\if{\h1=1 and \h2=0}{\draw{600,200}{
   linewidth 1
   xrange -31,31
   yrange -12.5,12
   trange -1,2
   plot green, \a*t,\b*t
   linewidth 2
   segment \x2-\z , \y2-\z , \x2+\z , \y2+\z , red
   segment \x2-\z , \y2+\z , \x2+\z , \y2-\z , red
   text red,\x1,\y1-2*\z,giant,\m1
   text red,\x2,\y2-2*\z,giant,\m2
}}
\if{\h2=1 and \h1=0}{\draw{600,200}{
   linewidth 1
   xrange -31,31
   yrange -12.5,12
   trange -1,2
   plot green, \a*t,\b*t
   linewidth 2
   segment \x1-\z , \y1-\z , \x1+\z , \y1+\z , red
   segment \x1-\z , \y1+\z , \x1+\z , \y1-\z , red
   text red,\x1,\y1-2*\z,giant,\m1
   text red,\x2,\y2-2*\z,giant,\m2
}}
\if{\h1=1 and \h2=1}{\draw{600,200}{
   linewidth 1
   xrange -31,31
   yrange -12.5,12
   trange -1,2
   plot green, \a*t,\b*t
   linewidth 2
   text red,\x1,\y1-2*\z,giant,\m1
   text red,\x2,\y2-2*\z,giant,\m2
}}
</div>
}

\choice{}{\rep1}{\choix}
\choice{}{\rep2}{Oui c'est un point. , Non ce n'est pas un point}
\choice{}{\rep3}{Oui c'est un point. , Non ce n'est pas un point}
\hint{Choisissez parmi les mots suivants :<div class="wimscenter">
un point,
un segment,
une droite,
une demi-droite</div>}
