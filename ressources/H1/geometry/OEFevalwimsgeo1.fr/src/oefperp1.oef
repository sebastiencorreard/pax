\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Perpendiculaires 1}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}

\integer{pe=randint(-70..70)}
\integer{pa=random(+,-)randint(40..40)}
\text{d1=-100,80,80,-100}
\text{d2=\pe,-100,\pe,100}
\text{d3=-50,-100,100,50}
\text{d4=-100,\pa,100,\pa}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,-95,90,medium,d1
text black,\pe+5,95,medium,d2
text black,-60,-80,medium,d3
text black,-95,\pa-5,medium,d4
segment \d1,black
segment \d2,black
segment \d3,black
segment \d4,black
)}

\text{fig=<img src="\dess1" alt="">}
\text{name_instruction=Pour répondre : écrire <span class="tt">d1</span> ou
<span class="tt">d2</span> ou <span class="tt">d3</span> ou <span class="tt">d4</span>
et en séparant par une virgule dans le cas de plusieurs réponses.}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<label for="reply1">Quelle est la droite perpendiculaire à la droite d1&nbsp;?</label>
\embed{r1,5}
<div class="wims_instruction">\name_instruction</div>
</div></div>}

\answer{}{d3}{type=raw}
