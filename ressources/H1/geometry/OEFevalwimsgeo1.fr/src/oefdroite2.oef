\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite 2}

\text{ch=shuffle(6)}
\integer{x1=randint(20..140)}
\integer{y1=randint(20..140)}
\integer{x2=randint(160..280)}
\integer{y2=randint(20..140)}
\integer{x3=randint(20..140)}
\integer{y3=randint(160..280)}
\integer{x4=randint(160..280)}
\integer{y4=randint(160..280)}

\matrix{nb=\x1,\y1,\x2,\y2
\x3,\y3,\x4,\y4
\x2,\y2,\x3,\y3
\x1,\y1,\x3,\y3
\x1,\y1,\x4,\y4
\x4,\y4,\x2,\y2}

\text{nb1=row(\ch[1],\nb)}
\text{nb2=row(\ch[2],\nb)}
\text{nb3=row(\ch[3],\nb)}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}

\real{p=(\nb1[4]-\nb1[2])/(\nb1[3]-\nb1[1])}
\integer{x5=0}
\integer{x6=500}
\integer{y5=\nb1[2]+\p*(\x5-\nb1[1])}
\integer{y6=\nb1[2]+\p*(\x6-\nb1[1])}

\text{dess=draw(300,300
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-15,\y1-10,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+10,\y2-10,medium,\nom[2]
segment \x3+4,\y3+4,\x3-4,\y3-4,black
segment \x3-4,\y3+4,\x3+4,\y3-4,black
text black,\x3-15,\y3-10,medium,\nom[3]
segment \x4+4,\y4+4,\x4-4,\y4-4,black
segment \x4-4,\y4+4,\x4+4,\y4-4,black
text black,\x4+10,\y4-10,medium,\nom[4]
segment \nb1,black
segment \nb2,black
segment \nb3,black
segment \x5,\y5,\x6,\y6,black
)}
\text{enonc=Sur ce dessin, la droite représentée se nomme :}
\text{reps=(\nom[1]\nom[2]),(\nom[3]\nom[4]),(\nom[2]\nom[3]),(\nom[1]\nom[3]),(\nom[1]\nom[4]),(\nom[4]\nom[2])}
\text{rep=\ch[1]}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 \enonc<div>\embed{r1}</div>
</div>
</div>
}

\answer{}{\rep;\reps}{type=radio}{option=shuffle}
