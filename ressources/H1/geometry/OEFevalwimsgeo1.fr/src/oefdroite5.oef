\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite 5}
\integer{n=randint(1..3)}
\integer{x1=randint(20..185)}
\integer{y1=randint(20..380)}
\integer{x2=randint(215..380)}
\integer{y2=randint(20..380)}
\integer{x3=randint(\x1+15..\x2-15)}
\real{p1=(\y2-\y1)/(\x2-\x1)}
\real{y3=\y1+\p1*(\x3-\x1)}

\text{nom=shuffle(A,B,C,E,F,G,M,N,P,R,S,T,U)}

\integer{x4=randint(\x1+15..\x2-15)}
\integer{y4=\y1+\p1*(\x4-\x1)}
\if{\y4>400-\y4}{\integer{y4=randint(15..\y4-30)}}
       {\integer{y4=randint(\y4+30..385)}}

\real{p2=(\y4-\y3)/(\x4-\x3)}


\integer{x5=0}
\integer{x6=400}
\integer{y5=\y1+\p1*(\x5-\x1)}
\integer{y6=\y1+\p1*(\x6-\x1)}
\integer{y7=\y3+\p2*(\x5-\x3)}
\integer{y8=\y3+\p2*(\x6-\x3)}

\text{dessin=draw(400,400
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-15,\y1-15,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2-15,\y2-15,medium,\nom[2]
segment \x3+4,\y3+4,\x3-4,\y3-4,black
segment \x3-4,\y3+4,\x3+4,\y3-4,black
text black,\x3-15,\y3-15,medium,\nom[4]
segment \x4+4,\y4+4,\x4-4,\y4-4,black
segment \x4-4,\y4+4,\x4+4,\y4-4,black
text black,\x4-15,\y4-15,medium,\nom[3]
segment \x5,\y5,\x6,\y6,black
segment \x5,\y7,\x6,\y8,black)}
\integer{a=randint(1..3)}
\matrix{rep=(\nom[3]\nom[4])|(\nom[4]\nom[3])
(\nom[3]\nom[4])|(\nom[4]\nom[3])
(\nom[1]\nom[4])|(\nom[4]\nom[1])|(\nom[1]\nom[2])|(\nom[2]\nom[1])|(\nom[2]\nom[4])|(\nom[4]\nom[2])}
\integer{a=randint(1..4)}
\matrix{rep=(\nom[3]\nom[4])|(\nom[4]\nom[3])|(\nom[2]\nom[3])|(\nom[3]\nom[2])
(\nom[3]\nom[4])|(\nom[4]\nom[3])|(\nom[1]\nom[3])|(\nom[3]\nom[1])
(\nom[1]\nom[4])|(\nom[4]\nom[1])|(\nom[1]\nom[2])|(\nom[2]\nom[1])|(\nom[2]\nom[4])|(\nom[4]\nom[2])
(\nom[3]\nom[1])|(\nom[1]\nom[3])|(\nom[2]\nom[3])|(\nom[3]\nom[2])
}

\text{rep=row(\a,\rep)}
\text{enonc= Le point \nom[\a] n'appartient pas à la droite :}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dessin" alt=""></div>
 <div class="medium_size text_col">\enonc \embed{r1,5}.
 </div>
</div>
}
\answer{}{\rep}{type=case}
