\title{Reporter une longueur 4}
\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\real{r=randint(10..18)*0.5}

\text{etap1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
arc 0,0,180,180,0,s*370,red)}

\text{etap2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,85,0,95,red
arc 0,90,180,180,180,180+s*180,red)}

\text{etap3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,85,0,95,red
arc 0,90,180,180,200,220,black
arc 0,90,180,180,320,340,black
segment 0,90,-75*s,90-s*44,red
segment 0,90,75*s,90-s*44,red)}

\text{etap4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,85,0,95,red
arc 0,90,180,180,200,220,black
arc 0,90,180,180,320,340,black
segment 0,90,-75,46,blue
segment 0,90,75,46,blue
arc 75,46,180,180,250,250+s*40,red)}

\text{etap5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,85,0,95,red
arc 0,90,180,180,200,220,black
arc 0,90,180,180,320,340,black
segment 0,90,-75,46,blue
segment 0,90,75,46,blue
arc 75,46,180,180,250,290,black
segment 77,45,77,45-s*90,red)}

\text{etap6=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,85,0,95,red
arc 0,90,180,180,200,220,black
arc 0,90,180,180,320,340,black
segment 0,90,-75,46,blue
segment 0,90,75,46,blue
arc 75,46,180,180,250,290,black
segment 77,45,77,-44,blue
segment 77,-44,0,-90,blue
segment -77,-44,0,-90,blue
segment -77,-44,-77,44,blue
arc 77,-44,180,180,200,220,black
arc 0,-90,180,180,140,160,black)}

\text{fig=<img src="\etap1" alt="">,<img src="\etap2" alt="">,<img src="\etap3" alt="">,
<img src="\etap4" alt="">,<img src="\etap5" alt="">,<img src="\etap6" alt="">}

\statement{
Voici une construction à faire sur une feuille de brouillon, en respectant les étapes.
<div class="spacer"> Vous tracerez dans l'étape 1, un cercle de \r cm de rayon.</div>
<table class="wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th></tr>
<tr>
\for{i=1 to 3}{<td>\fig[\i]</td>}
</tr>
<tr><th>Étape 4</th><th>Étape 5</th><th>Étape 6</th></tr>
<tr>
\for{i=4 to 6}{<td>\fig[\i]</td>}
</tr>
</table>
<p>La figure bleue obtenue est un hexagone régulier.</p>
<div class="spacer">Donner la mesure des côtés de cet hexagone : \embed{r1,5} cm.
</div>}

\answer{}{\r}{type=numeric}
