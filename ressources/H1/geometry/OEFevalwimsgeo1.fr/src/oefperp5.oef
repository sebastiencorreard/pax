\title{Perpendiculaires 5}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{d=shuffle(d1,d2,d3)}

\text{d1=40,100,40,-100}
\text{d2=-61,100,64,-100}
\text{d3=-18,100,-18,-100}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,45,98,medium,\d[1]
text black,-75,98,medium,\d[2]
text black,-35,-85,medium,\d[3]
segment \d1,black
segment \d2,black
segment \d3,black
triangle -90,-60,90,-60,40,20,black
text black,-90,-63,medium,\nom[1]
text black,48,30,medium,\nom[2]
text black,90,-63,medium,\nom[3]
text black,30,-63,medium,\nom[4]
text black,-30,30,medium,\nom[5]
text black,-30,-63,medium,\nom[6]
text black,-30,-5,medium,\nom[7]
text black,3,15,medium,\nom[8])
}

\text{fig=<img src="\dess1" alt="">}
\text{ch=randint(1..4)}
\integer{a=randint(1..2)}
\text{reps=(\nom[1]\nom[2]),(\nom[3]\nom[1]),(\nom[3]\nom[2]),
\d[1],\d[2],\d[3]}
\matrix{drp=7,\nom[4]
2,\nom[2]
4,\nom[8]
9,\nom[6]}
\matrix{drs=15,\nom[5]
1,\nom[1]
5,\nom[7]
6,\nom[3]}
\text{enonc=sécantes et perpendiculaires au point,sécantes et non perpendiculaires au point}
\text{enonc1=Nous avons un triangle, rectangle en}
\text{enonc2=Nous avons tracé des droites d1, d2 et d3 parallèles
  ou perpendiculaires à une droite existante.}
\text{name_complete=Compléter avec les étiquettes&nbsp;}
\text{name_embed=Les droites,sont}

\if{\a=1}{\text{dr=row(\ch,\drp)}}{\text{dr=row(\ch,\drs)}}

\text{reps=\reps[1] et \reps[2],\reps[1] et \reps[3],\reps[1] et \reps[4],
\reps[1] et \reps[5],\reps[1] et \reps[6],\reps[2] et \reps[3],
\reps[2] et \reps[4],\reps[2] et \reps[5],\reps[2] et \reps[6],
\reps[3] et \reps[4],\reps[3] et \reps[5],\reps[3] et \reps[6],
\reps[4] et \reps[5],\reps[4] et \reps[6],\reps[5] et \reps[6]}
