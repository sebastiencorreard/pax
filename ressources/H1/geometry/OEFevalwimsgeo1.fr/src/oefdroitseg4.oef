\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite et segment 4}
\integer{n=randint(1..3)}
\integer{x1=randint(20..185)}
\integer{y1=randint(20..380)}
\integer{x2=randint(215..380)}
\integer{y2=randint(20..380)}
\integer{x3=randint(\x1+15..\x2-15)}
\real{p1=(\y2-\y1)/(\x2-\x1)}
\real{y3=\y1+\p1*(\x3-\x1)}

\text{nom=shuffle(A,B,C,E,F,G,M,N,P,R,S,T,U)}

\integer{x4=randint(\x1+15..\x2-15)}
\integer{y4=\y1+\p1*(\x4-\x1)}
\if{\y4>400-\y4}{\integer{y4=randint(15..\y4-30)}}
       {\integer{y4=randint(\y4+30..385)}}

\real{p2=(\y4-\y3)/(\x4-\x3)}
\integer{x5=0}
\integer{x6=400}
\integer{y5=\y1+\p1*(\x5-\x1)}
\integer{y6=\y1+\p1*(\x6-\x1)}
\integer{y7=\y3+\p2*(\x5-\x3)}
\integer{y8=\y3+\p2*(\x6-\x3)}


\text{dess=draw(400,400
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-15,\y1-10,medium,\nom[4]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2-15,\y2-10,medium,\nom[3]
segment \x3+4,\y3+4,\x3-4,\y3-4,black
segment \x3-4,\y3+4,\x3+4,\y3-4,black
text black,\x3-15,\y3-10,medium,\nom[2]
segment \x4+4,\y4+4,\x4-4,\y4-4,black
segment \x4-4,\y4+4,\x4+4,\y4-4,black
segment \x5,\y5,\x6,\y6,black
segment \x5,\y7,\x6,\y8,black
text black,\x4-15,\y4-10,medium,\nom[1])}

\text{a=randint(1..4)}

\text{enonc=Nous avons trois points \nom[4], \nom[2] et \nom[3] alignés,
et un point \nom[1] n'appartenant pas à la droite (\nom[3]\nom[4]).
<p>Choisir toutes les bonnes réponses :</p>}
\text{enonc1=le point \nom[\a] appartient au segment [\nom[1]\nom[2]]}
\text{enonc2=le point \nom[\a] appartient au segment [\nom[4]\nom[3]]}
\text{enonc3=le point \nom[\a] appartient à la droite &#40;\nom[1]\nom[2]&#41;}
\text{enonc4=le point \nom[\a] appartient à la droite &#40;\nom[4]\nom[3]&#41;}
\text{enonc5=le point \nom[\a] appartient à la demi-droite &#91;\nom[2]\nom[4]&#41;}
\text{enonc6=le point \nom[\a] appartient au segment &#91;\nom[2]\nom[3]&#93;}

\matrix{rep1=1
1,2,3
2,3
2}
\matrix{rep2=1
1,2,3
2
2,3}

\text{rep1=row(\a,\rep1)}
\text{rep2=row(\a,\rep2)}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 \enonc
<ol><li>\embed{r1,1}</li><li>\embed{r1,2}</li><li>\embed{r1,3}</li></ol>
<ol><li>\embed{r2,1}</li><li>\embed{r2,2}</li><li>\embed{r2,3}</li></ol>
 </div>
</div>
}
\answer{}{\rep1;\enonc1,\enonc2,\enonc6}{type=checkbox}{option=shuffle}
\answer{}{\rep2;\enonc3,\enonc4,\enonc5}{type=checkbox}{option=shuffle}
