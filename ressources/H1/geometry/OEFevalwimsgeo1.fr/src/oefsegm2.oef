\langage{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Segment 2}

\text{ch=shuffle(6)}
\integer{x1=randint(20..140)}
\integer{y1=randint(20..140)}
\integer{x2=randint(160..280)}
\integer{y2=randint(20..140)}
\integer{x3=randint(20..140)}
\integer{y3=randint(160..280)}
\integer{x4=randint(160..280)}
\integer{y4=randint(160..280)}

\matrix{nb=\x1,\y1,\x2,\y2
\x3,\y3,\x4,\y4
\x2,\y2,\x3,\y3
\x1,\y1,\x3,\y3
\x1,\y1,\x4,\y4
\x4,\y4,\x2,\y2}

\text{nb1=row(\ch[1],\nb)}
\text{nb2=row(\ch[2],\nb)}
\text{nb3=row(\ch[3],\nb)}

\real{p=arctg((\nb1[4]-\nb1[2])/(\nb1[3]-\nb1[1]))}
\real{e=4*sin(\p)}
\real{f=4*cos(\p)}

\integer{xx1=\nb1[1]+\e}
\integer{yy1=\nb1[2]-\f}
\integer{xx2=\nb1[3]+\e}
\integer{yy2=\nb1[4]-\f}
\integer{xx3=\nb1[3]-\e}
\integer{yy3=\nb1[4]+\f}
\integer{xx4=\nb1[1]-\e}
\integer{yy4=\nb1[2]+\f}
\text{rep=polygon white,\xx1,\yy1,\xx2,\yy2,\xx3,\yy3,\xx4,\yy4}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{dess=draw(300,300
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-15,\y1-10,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+10,\y2-10,medium,\nom[2]
segment \x3+4,\y3+4,\x3-4,\y3-4,black
segment \x3-4,\y3+4,\x3+4,\y3-4,black
text black,\x3-15,\y3-10,medium,\nom[3]
segment \x4+4,\y4+4,\x4-4,\y4-4,black
segment \x4-4,\y4+4,\x4+4,\y4-4,black
text black,\x4+10,\y4-10,medium,\nom[4]
segment \nb1,black
segment \nb2,black
segment \nb3,black
\rep)}

\matrix{nom=[\nom[1]\nom[2]]
[\nom[3]\nom[4]]
[\nom[2]\nom[3]]
[\nom[1]\nom[3]]
[\nom[1]\nom[4]]
[\nom[4]\nom[2]]}

\text{enonc=Cliquer sur le segment row(\ch[1],\nom) :}

\statement{
\enonc
<div class="wimscenter">\embed{r1}</div>}

\answer{}{\dess;\rep}{type=coord}
