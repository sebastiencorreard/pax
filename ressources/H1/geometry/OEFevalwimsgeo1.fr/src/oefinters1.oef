\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Intersection 1}

\integer{x1=randint(60..160)}
\integer{y1=randint(60..160)}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}

\real{p1=random(0.1..+10)}
\real{p2=random(-2..-10)}
\integer{x2=0}
\integer{x3=200}
\integer{y11=\y1+1/\p1*(\x2-\x1)}
\integer{y12=\y1+1/\p1*(\x3-\x1)}
\integer{y21=\y1+1/\p2*(\x2-\x1)}
\integer{y22=\y1+1/\p2*(\x3-\x1)}

\integer{x5=40}
\integer{y15=\y1+1/\p1*(\x5-\x1)}
\if{\y15<15}{\integer{y15=15}}
\integer{y25=\y1+1/\p2*(\x5-\x1)}

\text{dess=draw(200,200
text black,\x1,\y1-20,medium,\nom[1]
text black,\x5,\y15-15,medium,d1
text black,\x5,\y25+5,medium,d2
segment \x2,\y11,\x3,\y12,black
segment \x2,\y21,\x3,\y22,black
)}

\matrix{enonc=Les droites d1 et d2,au point \nom[1],1
Le point , des droites d1 et d2 est le point \nom[1],2
\nom[1] est le point , des droites d1 et d2,2
Les droites d1 et d2 sont , au point \nom[1],3}

\text{reps=se coupent,d'intersection,sécantes,parallèles,se coupe,parallèle}

\text{a=randint(1..4)}
\text{enonc=row(\a,\enonc)}
\integer{rep=\enonc[3]}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 Nous avons deux droites d1 et d2 et un point \nom[1] :
<div>
\enonc[1] \embed{r1} \enonc[2]
</div>
 </div>
</div>
}

\answer{}{\rep;\reps}{type=menu}{option=shuffle}
