\text{enonc1=Les trois points \nom[\reps[2]], \nom[\reps[1]] et \nom[\reps[3]] }
\text{enonc2=Les segments [\nom[\reps[1]]\nom[\reps[2]]] et [\nom[\reps[1]]\nom[\reps[3]]]}
