\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Parallèles 5}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{d=shuffle(d1,d2,d3)}

\text{d1=15,100,15,-100}
\text{d2=-49,100,43,-100}
\text{d3=-18,100,-18,-100}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,0,-85,medium,\d[1]
text black,-65,98,medium,\d[2]
text black,-35,-85,medium,\d[3]
segment \d1,black
segment \d2,black
segment \d3,black
triangle -80,-60,80,-60,15,80,black
text black,-90,-63,medium,\nom[1]
text black,8,95,medium,\nom[2]
text black,80,-63,medium,\nom[3]
text black,5,-63,medium,\nom[4]
text black,-30,43,medium,\nom[5]
text black,-30,-63,medium,\nom[6]
text black,28,-47,medium,\nom[7]
text black,5,-37,medium,\nom[8])
}

\text{fig=<img src="\dess1" alt="">}
\text{ch=randint(1..4)}
\text{reps=(\nom[1]\nom[2]),(\nom[3]\nom[1]),(\nom[3]\nom[2]),
\d[1],\d[2],\d[3]}
\matrix{dr=\reps[3],\reps[5],\nom[3]
\reps[5],\reps[3],\nom[7]
\reps[4],\reps[6],\nom[4]
\reps[6],\reps[4],\nom[6]
}

\text{dr=row(\ch,\dr)}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<ul class="wims_nopuce">
<li>Nous avons un triangle \nom[1]\nom[2]\nom[3].
</li><li>
Nous avons tracé des droites parallèles et perpendiculaires d1, d2 et d3.
</li></ul>
<p>Compléter avec les étiquettes.</p>
<div class="spacer">
La droite \embed{r1,40x20} est parallèle à la droite \embed{r2}
et passe par le point \dr[3].
</div>
</div></div>}

\answer{}{\dr[1];\reps}{type=clickfill}
\answer{}{\dr[2];\reps}{type=clickfill}
