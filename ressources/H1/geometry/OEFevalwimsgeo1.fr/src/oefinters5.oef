\langage{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Intersection 5}
\integer{n=randint(1..3)}
\integer{x1=randint(20..185)}
\integer{y1=randint(20..380)}
\integer{x2=randint(215..380)}
\integer{y2=randint(20..380)}
\integer{x3=randint(\x1+15..\x2-15)}
\real{p1=(\y2-\y1)/(\x2-\x1)}
\real{y3=\y1+\p1*(\x3-\x1)}

\text{nom=shuffle(A,B,C,E,F,G,M,N,P,R,S,T,U)}

\integer{x4=randint(\x1+15..\x2-15)}
\integer{y4=\y1+\p1*(\x4-\x1)}
\if{\y4>400-\y4}{\integer{y4=randint(15..\y4-30)}}
       {\integer{y4=randint(\y4+30..385)}}

\real{p2=(\y4-\y3)/(\x4-\x3)}
\real{p3=(\y4-\y1)/(\x4-\x1)}
\real{p4=(\y4-\y2)/(\x4-\x2)}

\integer{x5=0}
\integer{x6=400}
\integer{y5=\y1+\p1*(\x5-\x1)}
\integer{y6=\y1+\p1*(\x6-\x1)}
\integer{y7=\y3+\p2*(\x5-\x3)}
\integer{y8=\y3+\p2*(\x6-\x3)}
\integer{y9=\y4+\p3*(\x5-\x4)}
\integer{y10=\y4+\p3*(\x6-\x4)}
\integer{y11=\y4+\p4*(\x5-\x4)}
\integer{y12=\y4+\p4*(\x6-\x4)}

\text{dess=draw(400,400
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-10,\y1-20,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2-10,\y2-20,medium,\nom[2]
segment \x3+4,\y3+4,\x3-4,\y3-4,black
segment \x3-4,\y3+4,\x3+4,\y3-4,black
text black,\x3-10,\y3-20,medium,\nom[3]
segment \x4+4,\y4+4,\x4-4,\y4-4,black
segment \x4-4,\y4+4,\x4+4,\y4-4,black
segment \x5,\y5,\x6,\y6,black
segment \x5,\y7,\x6,\y8,black
segment \x5,\y9,\x6,\y10,black
segment \x5,\y11,\x6,\y12,black
text black,\x4-10,\y4-20,medium,\nom[4])}

\text{quest=shuffle(4)}
\integer{ch=(\quest[1]+\quest[2])*(\quest[3]+\quest[4])}
\if{\ch=21}{\text{rep=\nom[3]}}
\if{\ch=24}{\text{rep=\nom[2]}}
\if{\ch=25}{\text{rep=\nom[1]}}

\text{enonc=Le point d'intersection des droites (\nom[\quest[1]]\nom[\quest[2]]) et (\nom[\quest[3]]\nom[\quest[4]]) est le point }

\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 <label for="reply1">\enonc</label>
\embed{r1,5}
 </div>
</div>
}


\answer{}{\rep}{type=text}
