\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Perpendiculaires 3}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{d=shuffle(d1,d2,d3,d4,d5,d6)}

\text{d1=-100,-60,100,-60}
\text{d2=-100,30,100,30}
\text{d3=70,100,70,-100}
\text{d4=-90,100,100,-90}
\text{d5=-60,-100,100,60}
\text{d6=-100,-80,80,100}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,85,-45,medium,\d[1]
text black,-95,45,medium,\d[2]
text black,55,-85,medium,\d[3]
text black,-75,95,medium,\d[4]
text black,-45,-85,medium,\d[5]
text black,-65,-15,medium,\d[6]
segment \d1,black
segment \d2,black
segment \d3,black
segment \d4,black
segment \d5,black
segment \d6,black
text black,-18,43,medium,\nom[1]
text black,5,43,medium,\nom[2]
text black,60,43,medium,\nom[3]
text black,23,2,medium,\nom[4]
text black,-80,-63,medium,\nom[5]
text black,-17,-63,medium,\nom[6]
text black,60,-63,medium,\nom[7]
text black,60,98,medium,\nom[8]
text black,-6,10,medium,\nom[9])
}

\text{fig=<img src="\dess1" alt="">}
\matrix{dr=\d[1],\d[3],\nom[7]
\d[2],\d[3],\nom[3]
\d[3],\d[1],\nom[7]
\d[3],\d[2],\nom[3]
\d[4],\d[5],\nom[4]
\d[4],\d[6],\nom[9]
\d[5],\d[4],\nom[4]
\d[6],\d[4],\nom[9]
}

\text{ch=randint(1..8)}
\text{reps=row(\ch,\dr)}
\text{name_instruction=Pour répondre : écrire <span class="tt">d1</span> ou
<span class="tt">d2</span> ou <span class="tt">d3</span> ou <span class="tt">d4</span> ou
<span class="tt">d5</span> ou <span class="tt">d6</span>
et en séparant par une virgule dans le cas de plusieurs réponses.}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<label for="reply1">Quelle est la droite perpendiculaire à la droite \reps[1]
passant par le point \reps[3]?</label> \embed{r1,5}
<div class="wims_instruction">\name_instruction</div></div></div>}

\answer{}{\reps[2]}{type=raw}
