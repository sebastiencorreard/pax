\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite et segment 5}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}

\integer{y=240}
\integer{x1=20}
\integer{d1=randint(20..99)}
\integer{d2=randint(110-\d1..270-\d1)}
\integer{d3=randint(20..99)}
\integer{d4=randint(110-\d1..200-\d1)}

\integer{x2=\x1+\d1}
\integer{x3=\x2+\d2}
\integer{x4=\x1+\d3}
\integer{x5=\x4+\d4}

\text{dess=draw(300,300
linewidth 1
segment \x1,\y+4,\x1,\y-4,black
text black,\x1,\y-20,medium,\nom[1]
segment \x2,\y+4,\x2,\y-4,black
text black,\x2,\y-20,medium,\nom[2]
segment \x3,\y+4,\x3,\y-4,black
text black,\x3,\y-20,medium,\nom[3]
segment \x4+4,\y-\d3+4,\x4-4,\y-\d3-4,black
text black,\x4,\y-\d3-20,medium,\nom[4]
segment \x5+4,\y-\d3-\d4+4,\x5-4,\y-\d3-\d4-4,black
text black,\x5,\y-\d3-\d4-20,medium,\nom[5]

segment \x1,\y,\x3,\y,black
segment 0,\y,300,\y,black
segment 0,260,260,0,black
)}

\text{a=randint(1..5)}

\text{enonc=Nous avons trois points \nom[1], \nom[2] et \nom[3] alignés.
<br>Choisir toutes les bonnes réponses :}

\text{enonc1=&#91;\nom[1]\nom[2]&#93;,&#91;\nom[1]\nom[3]&#93;,&#91;\nom[2]\nom[3]&#93;,&#91;\nom[1]\nom[4]&#93;,&#91;\nom[1]\nom[5]&#93;,&#91;\nom[4]\nom[5]&#93;}
\text{enonc2=&#40;\nom[1]\nom[2]&#41;,&#40;\nom[2]\nom[3]&#41;,&#40;\nom[1]\nom[4]&#41;,&#40;\nom[4]\nom[5]&#41;}
\matrix{rep1=1,2,4,5
1,2,3
2,3
4,5,6
5,6}

\matrix{rep2=1,2,3,4
1,2
1,2
3,4
3,4}

\text{rep1=row(\a,\rep1)}
\text{rep2=row(\a,\rep2)}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
\enonc
<ul><li>
Le point \nom[\a] appartient au(x) segment(s) :
<div class="wimscenter">\embed{r1}</div>
</li><li>
Le point \nom[\a] appartient à la (aux) droite(s) :
<div class="wimscenter">\embed{r2}</div>
</li></ul></div></div>
}
\answer{}{\rep1;\enonc1}{type=checkbox}
\answer{}{\rep2;\enonc2}{type=checkbox}
