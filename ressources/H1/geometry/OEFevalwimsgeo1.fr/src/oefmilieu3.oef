\format{html}
\precision{100000}
\title{Milieu 3}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\text{nom=item(1..6,\nom)}

\text{dess=draw(300,300
linewidth 1
segment 20,150,280,150,black
text black,15,130,medium,\nom[1]
segment 20,145,20,155,black
text black,67,130,medium,\nom[2]
segment 49,145,43,155,red
segment 72,145,72,155,black
text black,119,130,medium,\nom[3]
segment 101,145,95,155,red
segment 124,145,124,155,black
text black,171,130,medium,\nom[4]
segment 153,145,148,155,red
segment 176,145,176,155,black
text black,223,130,medium,\nom[5]
segment 205,145,199,155,red
segment 228,145,228,155,black
text black,275,130,medium,\nom[6]
segment 257,145,251,155,red
segment 280,145,280,155,black)}

\text{a=shuffle(6)}
\text{b=\a[1],\a[2],\a[3]}
\text{b=wims(sort numeric items \b)}
\real{x=(\b[1]+\b[3])/2}
\if{\b[2]=\x}{\integer{rep1=1}}{\integer{rep1=2}}
\text{name_rep=oui,non,je ne sais pas}
\text{enonc1=Le point \nom[\b[2]] est le milieu du segment}
\matrix{seg=1,3
1,5
2,4
2,6
3,5
4,6}
\integer{c=randint(1..6)}
\text{seg=row(\c,\seg)}
\text{enonc2=Le milieu du segment [\nom[\seg[1]]\nom[\seg[2]]] est le point&nbsp;}
\integer{rep2=(\seg[1]+\seg[2])/2}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 <ul><li>\enonc1 [\nom[\b[1]]\nom[\b[3]]]: \embed{r1}</li>
<li>\enonc2 \embed{r2} \rep2
</li></ul>
 </div>
</div>
}
\answer{}{\rep1;\name_rep}{type=radio}
\answer{}{\rep2;\nom}{type=radio}{option=shuffle}
