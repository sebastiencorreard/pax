\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Parallèles 1}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}

\integer{pe=randint(-80..0)}
\integer{pa=20}
\text{d1=-100,40,40,-100}
\text{d2=-100,\pe,100,\pe}
\text{d3=-20,100,100,-20}
\text{d4=-100,\pa,100,\pa}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,-95,50,medium,d1
text black,-95,\pe-5,medium,d2
text black,5,95,medium,d3
text black,-95,\pa-5,medium,d4
segment \d1,black
segment \d2,black
segment \d3,black
segment \d4,black
)}

\text{fig=<img src="\dess1" alt="">}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">

<label for="reply1">Quelle est la droite parallèle à la droite d1 ?</label> \embed{r1,5}
<div class="wims_instruction">Pour répondre : écrire d1 ou d2 ou d3 ou d4.</div>
</div>
</div>}
\answer{}{d3}{type=raw}
