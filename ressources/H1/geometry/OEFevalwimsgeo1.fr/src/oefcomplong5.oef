\title{Longueur comparaison 5}

\text{dessin=draw(306,300
xrange -150,153
yrange -150,150
segment 0,5,0,-5,black
segment 5,0,-5,0,black
segment -140,0,140,0,black
segment -138,15,138,15,black
text black,-150,5,medium,A
text black,145,5,medium,B
circle 0,0,280,black
text black,-150,30,medium,C
text black,145,30,medium,D
text black,0,-15,medium,O)}

\text{nat=shuffle(AB,CD)}

\text{fig=<img src="\dessin" alt="">}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
Nous avons un cercle de centre O. Les points A,B,C et D appartiennent au cercle.
<p>Comparer la longueur des segments :</p>
<div class="wimscenter larger">\embed{r1,120x40}  &lt; \embed{r2,120x40}</div>
 </div>
</div>}

\answer{}{CD}{type=dragfill}
\answer{}{AB}{type=dragfill}
