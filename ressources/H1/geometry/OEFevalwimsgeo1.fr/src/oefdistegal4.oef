\language{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Coder 4}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}

\text{segm=segment 10,145,10,155,black
segment 10,150,50,150,black
segment 50,145,50,155,black
segment 33,145,27,155,red}

\integer{a=randint(2..6)}
\for{i=1 to \a}
{\integer{n1=10+40*\i}
\integer{n2=50+40*\i}
\integer{n3=33+40*\i}
\integer{n4=27+40*\i}
\text{seg=segment \n1,145,\n1,155,black
segment \n1,150,\n2,150,black
segment \n2,145,\n2,155,black
segment \n3,145,\n4,155,red}
\text{segm=\segm \seg}}

\text{dess=draw(300,300
text black,10,130,medium,\nom[1]
text black,50,130,medium,\nom[2]
linewidth 1
\segm
text black,10+40*(\a+1),130,medium,\nom[3])}

\integer{d=randint(2..9)}
\text{enonc1=Le segment [\nom[1]\nom[2]] mesure \d cm.}
\text{enonc2=Donner la mesure du segment [\nom[1]\nom[3]].}
\integer{rep=\d*(\a+1)}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
\enonc1
<div><label for="reply1">\enonc2</label> \embed{r1,5} cm.</div>
 </div>
</div>
}
\answer{}{\rep}{type=numeric}
