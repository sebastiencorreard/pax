\title{Reporter une longueur 5}
\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\real{r=randint(10..18)*0.5}
\integer{rep=\r*sin(pi/5)*20}
\real{rep1=(\rep-2)/10}
\real{rep2=(\rep+2)/10}
\text{etap1=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
arc 0,0,180,180,0,s*370,red)}

\text{etap2=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90*s,0,red)}

\text{etap3=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90,0,black
square 0,10,10,red
segment 0,0,0,90*s,red
)}

\text{etap4=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90,0,black
square 0,10,10,black
segment 0,0,0,90,black
arc 45,0,90,90,0,s*190,red)}

\text{etap5=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90,0,black
square 0,10,10,black
segment 0,0,0,90,black
arc 45,0,90,90,0,190,black
circle 22,0,10,red
circle 68,0,10,red
segment 45,0,45-45*s,90*s,red)}

\text{etap6=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90,0,black
square 0,10,10,black
segment 0,0,0,90,black
arc 45,0,90,90,0,190,black
circle 22,0,10,black
circle 68,0,10,black
segment 45,0,0,90,black
arc 0,90,112,112,180,180+s*190,red
)}

\text{etap7=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment 0,0,90,0,black
square 0,10,10,black
segment 0,0,0,90,black
arc 45,0,90,90,0,190,black
circle 22,0,10,black
circle 68,0,10,black
segment 45,0,0,90,black
arc 0,90,112,112,180,360,black
segment -50,72,-50+100*s,72,red
)}

\text{etap8=draw(200,200
animate 40,0.01,0
xrange -100,100
yrange -100,100
linewidth 2
segment 0,5,0,-5,black
segment 5,0,-5,0,black
circle 0,0,180,black
segment -50,72,50,72,blue
arc -50,72,202,202,180,180+s*200,red
segment -50,72,-86,-21,blue
segment 0,-90,-86,-21,blue
segment 0,-90,86,-21,blue
segment 50,72,86,-21,blue)}

\text{fig=<img src="\etap1" alt="">,<img src="\etap2" alt="">,<img src="\etap3" alt="">,
<img src="\etap4" alt="">,<img src="\etap5" alt="">,<img src="\etap6" alt="">,
<img src="\etap7" alt="">,<img src="\etap8" alt="">}

\statement{
Voici une construction à faire sur une feuille de brouillon, en respectant les étapes.
<div class="spacer"> Vous tracerez dans l'étape 1 un cercle de \r cm de rayon.</div>

<table class="wimsborder">
<tr><th>Étape 1</th><th>Étape 2</th><th>Étape 3</th><th>Étape 4</th></tr>
<tr>
\for{i=1 to 4}{<td>\fig[\i]</td>}
</tr>
<tr><th>Etape 5</th><th>Etape 6</th><th>Etape 7</th><th>Etape 8</th></tr>
<tr>
\for{i=5 to 8}{<td>\fig[\i]</td>}
</tr>
</table>
<p>La figure bleue obtenue est un pentagone régulier.</p>
<div class="spacer">
Donner la mesure des côtés de ce pentagone : \embed{r1,5} cm.
</div>}

\answer{}{\rep1,\rep2}{type=range}
