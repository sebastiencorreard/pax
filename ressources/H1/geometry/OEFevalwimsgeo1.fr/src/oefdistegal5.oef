\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Coder 5}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}

\text{segm=segment 7,13,13,7,black
segment 10,10,50,50,black
segment 47,53,53,47,black
segment 30,35,30,25,red

segment 47,53,53,47,black
segment 50,50,80,80,black
segment 77,83,83,77,black
segment 63,68,63,58,red
segment 67,72,67,62,red
}

\integer{b=randint(0..2)}
\for{i=0 to \b}
{\integer{n1=80+30*\i}
\integer{n2=\n1+30}
\integer{n3=(\n1+\n2)/2}
\text{seg=segment \n1-3,\n1+3,\n1+3,\n1-3,black
segment \n1,\n1,\n2,\n2,black
segment \n2-3,\n2+3,\n2+3,\n2-3,black
segment \n3-2,\n3-5,\n3-2,\n3+5,red
segment \n3+2,\n3-5,\n3+2,\n3+5,red}
\text{segm=\segm \seg}}


\integer{a=randint(1..3-\b)}
\for{i=0 to \a}
{\integer{n1=\n2+40*\i}
\integer{n4=\n1+40}
\integer{n3=(\n1+\n4)/2}
\text{seg=segment \n1-3,\n1+3,\n1+3,\n1-3,black
segment \n1,\n1,\n4,\n4,black
segment \n4-3,\n4+3,\n4+3,\n4-3,black
segment \n3,\n3-5,\n3,\n3+5,red}
\text{segm=\segm \seg}}

\text{dess=draw(300,300
text black,20,1,medium,\nom[1]
text black,60,40,medium,\nom[2]
text black,90,70,medium,\nom[3]
linewidth 1
\segm
text black,90+40*(\a+1)+30*(\b+1),70+40*(\a+1)+30*(\b+1),medium,\nom[4])}

\integer{d=randint(2..9)}
\integer{e=randint(1..\d-1)}
\text{enonc1=Le segment [\nom[1]\nom[2]] mesure \d cm.
<br>Le segment [\nom[2]\nom[3]] mesure \e cm.}

\text{enonc2=Donner la mesure du segment [\nom[1]\nom[4]].}
\integer{rep=\d*(\a+2)+\e*(\b+2)}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
 <ul class="wims_nopuce">
<li>\enonc1</li><li><label for="reply1">\enonc2</label> \embed{r1,5} cm.
</li></ul>
 </div>
</div>
}
\answer{}{\rep}{type=numeric}
