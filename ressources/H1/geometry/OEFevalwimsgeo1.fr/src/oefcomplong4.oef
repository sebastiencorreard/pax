\title{Longueur comparaison 4}

\text{dessin=draw(600,150
xrange -300,300
yrange 0,150
segment -280,50,280,50,black
segment -280,50,-280,100,black
segment -280,100,280,50,black
text black,-285,45,medium,A
text black,285,45,medium,B
square -280,60,10,red
text black,-285,115,medium,C)}

\text{nat=shuffle(AB,BC)}

\text{fig=<img src="\dessin" alt="">}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
  Comparer la longueur des segments :
<div class="wimscenter larger">\embed{r1,120x40}&lt;\embed{r2,120x40}</div>
 </div>
</div>}
\answer{}{AB}{type=dragfill}
\answer{}{BC}{type=dragfill}
