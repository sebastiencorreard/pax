\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Longueur comparaison 1}

\integer{l1=randint(14..30)*10}
\integer{e=random(10,15,20,25,30)}
\text{sg=random(+,-)}
\integer{l2=\l1 \sg \e}
\integer{ang1=randint(40..90)}
\integer{ang2=randint(0..\ang1-20)}

\text{dessin=draw(400,400
xrange -200,200
yrange -200,200
rotate \ang1
segment -\l1/2,100,\l1/2,100,black
segment -\l1/2,95,-\l1/2,105,black
segment \l1/2,95,\l1/2,105,black
text black,-\l1/2-10,110,medium,A
text black,\l1/2+10,110,medium,B
rotate \ang2
segment -\l2/2,-100,\l2/2,-100,black
segment -\l2/2,-95,-\l2/2,-105,black
segment \l2/2,-95,\l2/2,-105,black
text black,-\l2/2-10,-105,medium,E
text black,\l2/2+5,-105,medium,F)}

\if{\l1<\l2}{\text{nat=AB,EF}}{\text{nat=EF,AB}}

\text{fig=<img src="\dessin" alt="">}

\statement{<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
 Comparer la longueur des segments :
<div class="wimscenter larger">\embed{r1,120x40} &lt; \embed{r2,120x40}</div>
 </div>
</div>
}
\answer{}{\nat[1]}{type=dragfill}{option=shuffle}
\answer{}{\nat[2]}{type=dragfill}{option=shuffle}
