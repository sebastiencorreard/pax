\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Parallèles 2}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{d=shuffle(d1,d2,d3,d4,d5,d6)}

\text{d1=-100,-60,100,-60}
\text{d2=-100,30,100,30}
\text{d3=70,100,70,-100}
\text{d4=-90,100,100,-90}
\text{d5=-60,-100,100,60}
\text{d6=-100,-80,80,100}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,85,-45,medium,\d[1]
text black,-95,45,medium,\d[2]
text black,55,-85,medium,\d[3]
text black,-75,95,medium,\d[4]
text black,-45,-85,medium,\d[5]
text black,-65,-15,medium,\d[6]
segment \d1,black
segment \d2,black
segment \d3,black
segment \d4,black
segment \d5,black
segment \d6,black)}

\text{fig=<img src="\dess1" alt="">}
\text{dr=\d[2],\d[1],,,\d[6],\d[5]}
\text{ch=random(1,2,5,6)}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
<label for="reply1">Quelle est la droite parallèle à la droite \d[\ch]  ?
 ou quelles sont les droites parallèles à la droite \d[\ch] ?</label>
 <div class="wimscenter">\embed{r1,5}</div>
<div class="wims_instruction">Pour répondre : écrire d1 ou d2 ou d3 ou d4 ou d5 ou d6
et en séparant par une virgule dans le cas de plusieurs réponses.</div>
</div>
</div>}
\answer{}{\dr[\ch]}{type=raw}
