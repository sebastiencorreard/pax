\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite et segment 1}

\integer{x1=randint(20..60)}
\integer{y1=randint(20..130)}
\integer{x2=randint(90..130)}
\integer{y2=randint(20..130)}



\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{dess1=draw(150,150
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-15,\y1-10,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+10,\y2-10,medium,\nom[2]
segment \x1,\y1,\x2,\y2,black)}

\real{p=(\y2-\y1)/(\x2-\x1)}

\integer{x3=0}
\real{y3=\y1+\p*(\x3-\x1)}
\integer{x4=150}
\real{y4=\y1+\p*(\x4-\x1)}

\text{dess2=draw(150,150
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-5,\y1-20,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+5,\y2-20,medium,\nom[2]
segment \x3,\y3,\x4,\y4,black)}

\text{dess3=draw(150,150
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-5,\y1-20,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+5,\y2-20,medium,\nom[2]
segment \x1,\y1,\x4,\y4,black)}

\integer{x5=(\x1+\x2)/2}
\integer{y5=(\y1+\y2)/2}
\real{d=sqrt((\x2-\x1)^2+(\y2-\y1)^2)}

\text{dess4=draw(150,150
linewidth 1
segment \x1+4,\y1+4,\x1-4,\y1-4,black
segment \x1-4,\y1+4,\x1+4,\y1-4,black
text black,\x1-5,\y1-20,medium,\nom[1]
segment \x2+4,\y2+4,\x2-4,\y2-4,black
segment \x2-4,\y2+4,\x2+4,\y2-4,black
text black,\x2+5,\y2-20,medium,\nom[2]
circle \x5,\y5,\d,black)}

\text{quest1= du segment,de la droite,de la demi-droite}
\text{quest2=&#91;\nom[1]\nom[2]&#93;,&#40;\nom[1]\nom[2]&#41;,&#91;\nom[1]\nom[2]&#41;}

\integer{a=randint(1..3)}
\text{reps=<img src="\dess1" alt="">,<img src="\dess2" alt="">,<img src="\dess3" alt="">,<img src="\dess4" alt="">}
\text{affich=shuffle(\reps)}
\integer{rep=positionof(\reps[\a],\affich)}
\text{enonc=Cliquer sur la bonne représentation \quest1[\a] \quest2[\a].}

\statement{\enonc <div>\embed{r1}</div>
}

\answer{}{\rep;\affich}{type=click}
