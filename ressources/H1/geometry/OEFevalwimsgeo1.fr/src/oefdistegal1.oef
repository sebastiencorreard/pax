\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Coder 1}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}

\text{l1h=draw(24,24
segment 0,12,24,12,black
segment 8,18,12,6,red
segment 12,18,16,6,red)}

\text{l2h=draw(24,24
segment 0,12,24,12,black
segment 10,18,14,6,red)}

\text{l3h=draw(24,24
segment 0,12,24,12,black
circle 12,12,8,red)}

\text{a1=draw(24,24
square 2,2,10,red
segment 12,0,12,24,black
segment 0,12,24,12,black)}

\text{codes=<img src="\l1h" alt="">,<img src="\l2h" alt="">,<img src="\l3h" alt="">,<img src="\a1" alt="">}
\integer{a=randint(1..3)}
\text{rep=item(\a,\codes)}

\text{dess=draw(300,300
linewidth 1
segment 40,150,260,150,black
text black,35,130,medium,\nom[1]
segment 40,145,40,155,black
segment 150,145,150,155,black
text black,145,130,medium,\nom[2]
segment 260,145,260,155,black
text black,255,130,medium,\nom[3]
)}

\text{cod1=83x138}
\text{cod2=193x138}
\text{enonc1=Le point \nom[2] est le milieu du segment [\nom[1]\nom[3]].}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\special{imagefill \dess,300x300,24x24
    r1,\cod1
    r2,\cod2
  }</div>
 <div class="medium_size text_col">
 \enonc1
<p>
Coder la figure avec les symboles donnés.
</p>
</div></div>
}

\answer{}{\rep;\codes}{type=dragfill}{option=shuffle}
\answer{}{\rep;<img src="\a1" alt="">}{type=dragfill}{option=shuffle}
