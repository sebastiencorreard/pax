\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite et segment 3}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\real{e=0.1}
\integer{y=150}
\integer{x1=20}
\integer{d1=randint(20..99)}
\integer{d2=randint(110-\d1..270-\d1)}
\integer{x2=\x1+\d1}
\integer{x3=\x2+\d2}
\text{dess=draw(300,300
linewidth 1
segment \x1,\y+4,\x1,\y-4,black
text black,\x1,\y-20,medium,\nom[1]
segment \x2,\y+4,\x2,\y-4,black
text black,\x2,\y-20,medium,\nom[2]
segment \x3,\y+4,\x3,\y-4,black
text black,\x3,\y-20,medium,\nom[3]
segment \x1,\y,\x3,\y,black
segment 0,\y,300,\y,black
)}

\text{a=shuffle(3)}

\text{enonc=Nous avons trois points \nom[1], \nom[2] et \nom[3] alignés.
<br>Choisir toutes les bonnes réponses :}
\text{enonc1=le point \nom[\a[1]] appartient au segment [\nom[\a[2]]\nom[\a[3]]]}
\text{enonc2=le point \nom[\a[1]] appartient à la droite (\nom[\a[2]]\nom[\a[3]])}
\text{enonc3=le point \nom[\a[1]] appartient à la demi-droite &#91;\nom[\a[2]]\nom[\a[3]]&#41;}
\matrix{rep=2
1,2,3
2,3
0
2,3
1,2,3
2}
\integer{b=2*\a[1]+\a[2]-\a[3]}
\text{rep=row(\b,\rep)}

\statement{<div class="wims_columns">
 <div class="medium_size img_col"><img src="\dess" alt=""></div>
 <div class="medium_size text_col">
\enonc
<ul><li>\embed{r1,1}</li>
<li>\embed{r1,2}</li>
<li>\embed{r1,3}</li>
</ul>
</div></div>
}
\answer{}{\rep;\enonc1,\enonc2,\enonc3}{type=checkbox}
