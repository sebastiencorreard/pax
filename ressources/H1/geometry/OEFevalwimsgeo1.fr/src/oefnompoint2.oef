text black,\x[1]-20,\y[1]-20,medium,\nom[1]
segment \x[2]+4,\y[2]+4,\x[2]-4,\y[2]-4,black
segment \x[2]-4,\y[2]+4,\x[2]+4,\y[2]-4,black
