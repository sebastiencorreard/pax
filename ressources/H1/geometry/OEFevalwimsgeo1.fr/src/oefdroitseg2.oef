\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Droite et segment 2}

\text{nom=shuffle(A,B,C,E,F,G,H,R,S,T,U)}
\text{rep1=&#91;\nom[1]\nom[2]&#93;}
\text{rep2=&#91;\nom[1]\nom[2]&#41;}
\text{rep3=&#40;\nom[1]\nom[2]&#41;}
\text{rep4=\nom[1]\nom[2]}

\text{enonc1= Un segment limité par deux points \nom[1] et \nom[2] se note : }
\text{enonc3= Une droite passant par deux points \nom[1] et \nom[2] se note : }
\text{enonc2= Une demi-droite limitée par un point \nom[1] et passant par le point \nom[2] se note : }
\text{enonc=\enonc1,\enonc2,\enonc3}
\text{reps=\rep1,\rep2,\rep3,\rep4}
\integer{a=randint(1..3)}
\text{rep=\reps[\a]}

\statement{\enonc[\a]
}
\choice{}{\rep}{\reps}{option=shuffle}
