\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Longueur comparaison 3}

\integer{a1=randint(14..30)*10}
\integer{e1=random(10,15,20)}
\integer{e2=random(10,15,20)}
\integer{a2=\a1+\e1}
\integer{a3=\a2+\e2}
\text{l=\a1,\a2,\a3}
\text{ch=shuffle(3)}
\text{nat=AB,EF,RS}
\integer{l1=\l[\ch[1]]}
\integer{l2=\l[\ch[2]]}
\integer{l3=\l[\ch[3]]}
\integer{ang1=randint(40..90)}
\integer{ang2=randint(0..\ang1-20)}

\text{dessin=draw(400,400
xrange -200,200
yrange -200,200
segment -\l3/2,150,\l3/2,150,black
segment -\l3/2,145,-\l3/2,155,black
segment \l3/2,145,\l3/2,155,black
text black,-\l3/2-10,160,medium,R
text black,\l3/2+10,160,medium,S
rotate \ang1
segment -\l1/2,100,\l1/2,100,black
segment -\l1/2,95,-\l1/2,105,black
segment \l1/2,95,\l1/2,105,black
text black,-\l1/2-10,110,medium,A
text black,\l1/2+10,110,medium,B
rotate \ang2
segment -\l2/2,-100,\l2/2,-100,black
segment -\l2/2,-95,-\l2/2,-105,black
segment \l2/2,-95,\l2/2,-105,black
text black,-\l2/2-10,-105,medium,E
text black,\l2/2+5,-105,medium,F)}

\if{\ch=3,1,2}{\text{ch=2,3,1}}
   {\if{\ch=2,3,1}{\text{ch=3,1,2}}}
\text{fig=<img src="\dessin" alt="">}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
 Comparer la longueur des segments :
<div class="wimscenter larger">\embed{r1,120x40} &lt;\embed{r2,120x40}
 &lt;\embed{r3,120x40}</div>
 </div>
</div>
 }

\answer{}{\nat[\ch[1]]}{type=dragfill}{option=shuffle}
\answer{}{\nat[\ch[2]]}{type=dragfill}{option=shuffle}
\answer{}{\nat[\ch[3]]}{type=dragfill}{option=shuffle}
