\language{fr}
\author{Jean-Luc,Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\title{Parallèles 4}

\text{nom=shuffle(A,B,C,E,F,G,R,S,T)}
\text{d=shuffle(d1,d2,d3,d4,d5,d6)}

\text{d1=-100,-60,100,-60}
\text{d2=-100,30,100,30}
\text{d3=70,100,70,-100}
\text{d4=-100,90,100,90}
\text{d5=-60,-100,100,60}
\text{d6=-100,-80,80,100}

\text{dess1=draw(200,200
xrange -100,100
yrange -100,100
text black,85,-45,medium,\d[1]
text black,-95,45,medium,\d[2]
text black,55,-85,medium,\d[3]
text black,-95,85,medium,\d[4]
text black,-45,-85,medium,\d[5]
text black,-65,-15,medium,\d[6]
segment \d1,black
segment \d2,black
segment \d3,black
segment \d4,black
segment \d5,black
segment \d6,black
text black,-38,85,medium,\nom[1]
segment -38,87,-38,93,black
text black,5,43,medium,\nom[2]
text black,60,43,medium,\nom[3]
text black,-80,-63,medium,\nom[5]
text black,-17,-63,medium,\nom[6]
text black,60,-63,medium,\nom[7]
text black,75,85,medium,\nom[8])
}

\text{fig=<img src="\dess1" alt="">}
\matrix{dr=\d[1],\d[2],\nom[2]
\d[1],\d[4],\nom[1]
\d[2],\d[1],\nom[5],\nom[6]
\d[2],\d[4],\nom[1]
\d[4],\d[2],\nom[2]
\d[4],\d[1],\nom[6],\nom[5]
\d[5],\d[6],\nom[5],\nom[2]
\d[6],\d[5],\nom[6]
}
\text{ch=randint(1..8)}
\text{reps=row(\ch,\dr)}
\text{pt=item(3..4,\reps)}
\if{items(\pt)<>1}{\text{pt=shuffle(\pt)}}

\statement{
<div class="wims_columns">
 <div class="medium_size img_col">\fig</div>
 <div class="medium_size text_col">
 <label for="reply1">
 Quelle est la droite parallèle à la droite \reps[1] passant par le point \pt[1] ?</label>
 \embed{r1,5}
<div class="wims_instruction">Pour répondre : écrire d1 ou d2 ou d3 ou d4 ou d5 ou d6.
</div></div>
</div>
}

\answer{}{\reps[2]}{type=raw}
