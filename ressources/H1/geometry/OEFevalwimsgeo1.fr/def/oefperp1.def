!set title=Perpendiculaires 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!randint -70, 70

val7=$[rint($(tmp0))]
tmp0=!randitem +,-

tmp1=!randint 40, 40

val8=$[rint($(tmp0)$(tmp1))]
val9=-100,80,80,-100
val10=$val7,-100,$val7,100
val11=-50,-100,100,50
val12=-100,$val8,100,$val8
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	text black,-95,90,medium,d1	text black,$val7+5,95,medium,d2	text black,-60,-80,medium,d3	text black,-95,$val8-5,medium,d4	segment $val9,black	segment $val10,black	segment $val11,black	segment $val12,black	 
tmp0=$ins_url
val13=$(tmp0)
val14=<img src="$val13" alt="">
val15=Pour répondre : écrire <span class="tt">d1</span> ou	<span class="tt">d2</span> ou <span class="tt">d3</span> ou <span class="tt">d4</span>	et en séparant par une virgule dans le cas de plusieurs réponses.
replytype1=raw
replyname1=
replygood1=d3
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val14</div>	 <div class="medium_size text_col">	<label for="reply1">Quelle est la droite perpendiculaire à la droite d1&nbsp;?</label>	 
!read oef/embed.phtml r1,5 
$()	<div class="wims_instruction">$val15</div>	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,15
embedcnt=1
