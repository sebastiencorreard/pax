!set title=Longueur comparaison 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r,r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 600,150 \
xrange -300,300	yrange 0,150	segment -280,50,280,50,black	segment -280,50,-280,100,black	segment -280,100,280,50,black	text black,-285,45,medium,A	text black,285,45,medium,B	square -280,60,10,red	text black,-285,115,medium,C 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!shuffle AB,BC

val7=$(tmp0)
val8=<img src="$val6" alt="">
replytype1=dragfill
replyname1=
replygood1=AB
replytype2=dragfill
replyname2=
replygood2=BC
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val8</div>	 <div class="medium_size text_col">	  Comparer la longueur des segments :	<div class="wimscenter larger"> 
!read oef/embed.phtml r1,120x40 
$()&lt; 
!read oef/embed.phtml r2,120x40 
$()</div>	 </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=2
