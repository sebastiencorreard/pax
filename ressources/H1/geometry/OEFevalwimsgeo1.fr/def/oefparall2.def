!set title=Parallèles 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!shuffle d1,d2,d3,d4,d5,d6

val7=$(tmp0)
val8=-100,-60,100,-60
val9=-100,30,100,30
val10=70,100,70,-100
val11=-90,100,100,-90
val12=-60,-100,100,60
val13=-100,-80,80,100
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	text black,85,-45,medium,$(val7[1])	text black,-95,45,medium,$(val7[2])	text black,55,-85,medium,$(val7[3])	text black,-75,95,medium,$(val7[4])	text black,-45,-85,medium,$(val7[5])	text black,-65,-15,medium,$(val7[6])	segment $val8,black	segment $val9,black	segment $val10,black	segment $val11,black	segment $val12,black	segment $val13,black 
tmp0=$ins_url
val14=$(tmp0)
val15=<img src="$val14" alt="">
val16=$(val7[2]),$(val7[1]),,,$(val7[6]),$(val7[5])
tmp0=!randitem 1,2,5,6

val17=$(tmp0)
replytype1=raw
replyname1=
replygood1=$(val16[$val17])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val15</div>	 <div class="medium_size text_col">	<label for="reply1">Quelle est la droite parallèle à la droite $(val7[$val17])  ?	 ou quelles sont les droites parallèles à la droite $(val7[$val17]) ?</label>	 <div class="wimscenter"> 
!read oef/embed.phtml r1,5 
$()</div>	<div class="wims_instruction">Pour répondre : écrire d1 ou d2 ou d3 ou d4 ou d5 ou d6	et en séparant par une virgule dans le cas de plusieurs réponses.</div>	</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,15,17
embedcnt=1
