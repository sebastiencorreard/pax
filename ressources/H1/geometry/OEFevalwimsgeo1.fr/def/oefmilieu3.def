!set title=Milieu 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=100000

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!item 1 to 6 of $val6

val6=$(tmp0)
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 20,150,280,150,black	text black,15,130,medium,$(val6[1])	segment 20,145,20,155,black	text black,67,130,medium,$(val6[2])	segment 49,145,43,155,red	segment 72,145,72,155,black	text black,119,130,medium,$(val6[3])	segment 101,145,95,155,red	segment 124,145,124,155,black	text black,171,130,medium,$(val6[4])	segment 153,145,148,155,red	segment 176,145,176,155,black	text black,223,130,medium,$(val6[5])	segment 205,145,199,155,red	segment 228,145,228,155,black	text black,275,130,medium,$(val6[6])	segment 257,145,251,155,red	segment 280,145,280,155,black 
tmp0=$ins_url
val7=$(tmp0)
tmp0=!shuffle 6

val8=$(tmp0)
val9=$(val8[1]),$(val8[2]),$(val8[3])
tmp0=!sort numeric items $val9

val9=$(tmp0)
val10=$[($(val9[1])+$(val9[3]))/2]
!if $(val9[2])=$val10 
val11=$[rint(1)]
!else
val11=$[rint(2)]
!endif
val12=oui,non,je ne sais pas
val13=Le point $(val6[$(val9[2])]) est le milieu du segment
tmp=!trim 1,3	1,5	2,4	2,6	3,5	4,6
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 6

val15=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val15 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val16=Le milieu du segment [$(val6[$(val14[1])])$(val6[$(val14[2])])] est le point&nbsp;
val17=$[rint(($(val14[1])+$(val14[2]))/2)]
replytype1=radio
replyname1=
replygood1=$val11;$val12
replytype2=radio
replyoption2=shuffle 
replyname2=
replygood2=$val17;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val7" alt=""></div>	 <div class="medium_size text_col">	 <ul><li>$val13 [$(val6[$(val9[1])])$(val6[$(val9[3])])]:  
!read oef/embed.phtml r1 
$()</li>	<li>$val16  
!read oef/embed.phtml r2 
$() $val17	</li></ul>	 </div>	</div>	
$()
!exit

