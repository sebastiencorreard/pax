!set title=Coder 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=100000

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=segment 10,145,10,155,black	segment 10,150,50,150,black	segment 50,145,50,155,black	segment 33,145,27,155,red
tmp0=!randint 2, 6

val8=$[rint($(tmp0))]
!for val9 =1 to $val8 
val10=$[rint(10+40*$val9)]
val11=$[rint(50+40*$val9)]
val12=$[rint(33+40*$val9)]
val13=$[rint(27+40*$val9)]
val14=segment $val10,145,$val10,155,black	segment $val10,150,$val11,150,black	segment $val11,145,$val11,155,black	segment $val12,145,$val13,155,red
val7=$val7 $val14
!next
!readproc oef/draw.phtml 300,300 \
text black,10,130,medium,$(val6[1])	text black,50,130,medium,$(val6[2])	linewidth 1	$val7	text black,10+40*($val8+1),130,medium,$(val6[3]) 
tmp0=$ins_url
val15=$(tmp0)
tmp0=!randint 2, 9

val16=$[rint($(tmp0))]
val17=Le segment [$(val6[1])$(val6[2])] mesure $val16 cm.
val18=Donner la mesure du segment [$(val6[1])$(val6[3])].
val19=$[rint($val16*($val8+1))]
replytype1=numeric
replyname1=
replygood1=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val15" alt=""></div>	 <div class="medium_size text_col">	$val17	<div><label for="reply1">$val18</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	 </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15,17,18
embedcnt=1
