!set title=Vocabulaire parallèle perpendiculaire 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!randint 0, 80

val7=$[rint($(tmp0))]
tmp0=!randitem +,-

tmp1=!randint 20, 70

val8=$[rint($(tmp0)$(tmp1))]
tmp0=!randint 20, 80

val9=$[rint($(tmp0))]
val10=-100,0,100,0
val11=$val7,-100,$val7,100
val12=-100,$val8,100,$val8
val13=-100+$val9,-100,-30+$val9,100
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	square $val7,10,10,red	square $val7,$val8,10,red	text black,-95,20,medium,d1	text black,$val7+5,-85,medium,d2	segment $val10,black	segment $val11,black	segment $val12,black	text black,85,$val8+15,medium,d3	segment $val13,black	text black,-120+$val9,-85,medium,d4 
tmp0=$ins_url
val14=$(tmp0)
tmp=!trim d1,d2,2	d1,d4,2	d2,d3,2	d2,d4,2	d3,d4,2	d1,d3,1	d3,d1,1
val15=!translate internal $	\
$ to ;; in $tmp
val16=parallèles,sécantes
tmp0=!randint 1, 7

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val18=<img src="$val14" alt="">
val19=Les deux droites $(val15[1]) et $(val15[2]) sont
replytype1=menu
replyoption1=shuffle 
replyname1=
replygood1=$(val15[3]);$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val18</div>	 <div class="medium_size text_col">	$val19		 
!read oef/embed.phtml r1 
$().		 </div>	</div>		
$()
!exit

