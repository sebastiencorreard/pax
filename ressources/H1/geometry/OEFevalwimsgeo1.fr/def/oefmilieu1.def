!set title=Milieu 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Si un point d'un segment, est à égale distance, des extrémités, alors ce point est, le milieu du segment.	Si un point est, le milieu d'un segment, alors il est, à égale distance, de ses extrémités.	Le milieu d'un segment, est un point situé, à égale distance, des extrémités, du segment.	Le milieu d'un segment, est un point, équidistant, des extrémités, du segment.
val6=!translate internal $	\
$ to ;; in $tmp
val7=Placer les mots dans l'ordre pour faire une phrase correcte&nbsp;
tmp0=!randint 1, 4

val8=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val6;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7:	<div class="spacer"> 
!read oef/embed.phtml r1,150x50 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=1
