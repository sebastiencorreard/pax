!set title=Parallèles 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!shuffle d1,d2,d3

val7=$(tmp0)
val8=15,100,15,-100
val9=-49,100,43,-100
val10=-18,100,-18,-100
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	text black,0,-85,medium,$(val7[1])	text black,-65,98,medium,$(val7[2])	text black,-35,-85,medium,$(val7[3])	segment $val8,black	segment $val9,black	segment $val10,black	triangle -80,-60,80,-60,15,80,black	text black,-90,-63,medium,$(val6[1])	text black,8,95,medium,$(val6[2])	text black,80,-63,medium,$(val6[3])	text black,5,-63,medium,$(val6[4])	text black,-30,43,medium,$(val6[5])	text black,-30,-63,medium,$(val6[6])	text black,28,-47,medium,$(val6[7])	text black,5,-37,medium,$(val6[8]) 
tmp0=$ins_url
val11=$(tmp0)	
val12=<img src="$val11" alt="">
tmp0=!randint 1, 4

val13=$(tmp0)
val14=($(val6[1])$(val6[2])),($(val6[3])$(val6[1])),($(val6[3])$(val6[2])),	$(val7[1]),$(val7[2]),$(val7[3])
tmp=!trim $(val14[3]),$(val14[5]),$(val6[3])	$(val14[5]),$(val14[3]),$(val6[7])	$(val14[4]),$(val14[6]),$(val6[4])	$(val14[6]),$(val14[4]),$(val6[6])	
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
replytype1=clickfill
replyname1=
replygood1=$(val15[1]);$val14
replytype2=clickfill
replyname2=
replygood2=$(val15[2]);$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val12</div>	 <div class="medium_size text_col">	<ul class="wims_nopuce">	<li>Nous avons un triangle $(val6[1])$(val6[2])$(val6[3]).	</li><li>	Nous avons tracé des droites parallèles et perpendiculaires d1, d2 et d3.	</li></ul>	<p>Compléter avec les étiquettes.</p>	<div class="spacer">	La droite  
!read oef/embed.phtml r1,40x20 
$() est parallèle à la droite  
!read oef/embed.phtml r2 
$()	et passe par le point $(val15[3]).	</div>	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12,15
embedcnt=2
