!set title=Reporter une longueur 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r,r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/compas3.jpg" alt="compas">
tmp0=!randint 1, 4

tmp1=!randint 1, 9

val7=$[$(tmp0)+$(tmp1)/10]
val8=$[4*$val7]
replytype1=atext
replyname1=
replygood1=4|quatre
replytype2=numeric
replyname2=
replygood2=$[$val8]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val6</div>	 <div class="medium_size text_col">			Nous utilisons le compas pour reporter la longueur du segment [AB].	<p>	La longueur du segment [EF] est égale à  
!read oef/embed.phtml r1,6 
$() fois la longueur du segment [AB].	</p>	<div class="spacer">	Si le segment [AB] mesure $val7 cm, alors le segment [EF] mesure  
!read oef/embed.phtml r2,5 
$() cm.	</div>	<div class="wims_instruction">	Faire le dessin au brouillon pour vérifier son résultat.	</div>	</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=2
