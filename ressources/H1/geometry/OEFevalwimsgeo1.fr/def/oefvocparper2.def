!set title=Vocabulaire parallèle perpendiculaire 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!randint -80, 80

val7=$[rint($(tmp0))]
tmp0=!randitem +,-

tmp1=!randint 20, 80

val8=$[rint($(tmp0)$(tmp1))]
val9=-100,0,100,0
val10=$val7,-100,$val7,100
val11=-100,$val8,100,$val8
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	square $val7,10,10,red	text black,$val7-10,-5,medium,$(val6[1])	text black,-95,20,medium,d1	text black,$val7+5,95,medium,d2	segment $val9,black	segment $val10,black	 
tmp0=$ins_url
val12=$(tmp0)
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	square $val7,10,10,red	square $val7,$val8,10,red	text black,$val7-10,-5,medium,$(val6[1])	text black,-95,20,medium,d1	text black,$val7+5,95,medium,d2	segment $val9,black	segment $val10,black	segment $val11,black	text black,85,$val8+15,medium,d3	 
tmp0=$ins_url
val13=$(tmp0)
val14=perpendiculaires,parallèles
val15=d2,d3
tmp0=!randint 1, 2

val16=$(tmp0)
val17=<img src="$val12" alt="">,<img src="$val13" alt="">
val17=$(val17[$val16])
val18=Les deux droites d1 et $(val15[$val16]) sont
replytype1=raw
replyoption1=nocase 
replyname1=
replygood1=$(val14[$val16])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val17</div>	 <div class="medium_size text_col">	$val18		 
!read oef/embed.phtml r1,15 
$().		 </div>	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=17,18
embedcnt=1
