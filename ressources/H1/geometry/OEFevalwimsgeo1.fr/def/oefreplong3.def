!set title=Reporter une longueur 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=3
prevarcnt=2
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 500,300 \
xrange -250,250	yrange -150,150	linewidth 1	segment -90,0,90,0,black	segment 30,120,-90,0,black	segment 30,120,90,0,black	segment -250,-100,250,-100,black	segment -240,-105,-240,-95,black	segment -60,-105,-60,-95,black	segment 110,-105,110,-95,black	segment 244,-105,244,-95,black	text black,-244,-80,medium,A	text black,239,-80,medium,B 
tmp0=$ins_url
val6=$(tmp0)
val7=<img src="$val6" alt="">
replytype1=atext
replyname1=
replygood1=périmètre
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val7</div>	 <div class="medium_size text_col">	 Nous avons reporté les longueurs des trois côtés du triangle	avec le compas sur la droite (AB).	<div class="spacer">	La longueur du segment [AB] correspond au  
!read oef/embed.phtml r1,15 
$() du triangle.	</div>	</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=1
