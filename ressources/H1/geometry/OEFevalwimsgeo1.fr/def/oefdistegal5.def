!set title=Coder 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=100000

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=segment 7,13,13,7,black	segment 10,10,50,50,black	segment 47,53,53,47,black	segment 30,35,30,25,red		segment 47,53,53,47,black	segment 50,50,80,80,black	segment 77,83,83,77,black	segment 63,68,63,58,red	segment 67,72,67,62,red	
tmp0=!randint 0, 2

val8=$[rint($(tmp0))]
!for val9 =0 to $val8 
val10=$[rint(80+30*$val9)]
val11=$[rint($val10+30)]
val12=$[rint(($val10+$val11)/2)]
val13=segment $val10-3,$val10+3,$val10+3,$val10-3,black	segment $val10,$val10,$val11,$val11,black	segment $val11-3,$val11+3,$val11+3,$val11-3,black	segment $val12-2,$val12-5,$val12-2,$val12+5,red	segment $val12+2,$val12-5,$val12+2,$val12+5,red
val7=$val7 $val13
!next
tmp0=!randint 1, 3-$val8

val14=$[rint($(tmp0))]
!for val9 =0 to $val14 
val10=$[rint($val11+40*$val9)]
val15=$[rint($val10+40)]
val12=$[rint(($val10+$val15)/2)]
val13=segment $val10-3,$val10+3,$val10+3,$val10-3,black	segment $val10,$val10,$val15,$val15,black	segment $val15-3,$val15+3,$val15+3,$val15-3,black	segment $val12,$val12-5,$val12,$val12+5,red
val7=$val7 $val13
!next
!readproc oef/draw.phtml 300,300 \
text black,20,1,medium,$(val6[1])	text black,60,40,medium,$(val6[2])	text black,90,70,medium,$(val6[3])	linewidth 1	$val7	text black,90+40*($val14+1)+30*($val8+1),70+40*($val14+1)+30*($val8+1),medium,$(val6[4]) 
tmp0=$ins_url
val16=$(tmp0)
tmp0=!randint 2, 9

val17=$[rint($(tmp0))]
tmp0=!randint 1, $val17-1

val18=$[rint($(tmp0))]
val19=Le segment [$(val6[1])$(val6[2])] mesure $val17 cm.	<br>Le segment [$(val6[2])$(val6[3])] mesure $val18 cm.
val20=Donner la mesure du segment [$(val6[1])$(val6[4])].
val21=$[rint($val17*($val14+2)+$val18*($val8+2))]
replytype1=numeric
replyname1=
replygood1=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val16" alt=""></div>	 <div class="medium_size text_col">	 <ul class="wims_nopuce">	<li>$val19</li><li><label for="reply1">$val20</label>  
!read oef/embed.phtml r1,5 
$() cm.	</li></ul>	 </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

