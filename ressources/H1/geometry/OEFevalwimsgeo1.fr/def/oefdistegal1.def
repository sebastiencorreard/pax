!set title=Coder 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=100000

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	segment 8,18,12,6,red	segment 12,18,16,6,red 
tmp0=$ins_url
val7=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	segment 10,18,14,6,red 
tmp0=$ins_url
val8=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	circle 12,12,8,red 
tmp0=$ins_url
val9=$(tmp0)
!readproc oef/draw.phtml 24,24 \
square 2,2,10,red	segment 12,0,12,24,black	segment 0,12,24,12,black 
tmp0=$ins_url
val10=$(tmp0)
val11=<img src="$val7" alt="">,<img src="$val8" alt="">,<img src="$val9" alt="">,<img src="$val10" alt="">
tmp0=!randint 1, 3

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11

val13=$(tmp0)
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 40,150,260,150,black	text black,35,130,medium,$(val6[1])	segment 40,145,40,155,black	segment 150,145,150,155,black	text black,145,130,medium,$(val6[2])	segment 260,145,260,155,black	text black,255,130,medium,$(val6[3])	 
tmp0=$ins_url
val14=$(tmp0)
val15=83x138
val16=193x138
val17=Le point $(val6[2]) est le milieu du segment [$(val6[1])$(val6[3])].
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val13;$val11
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val13;<img src="$val10" alt="">
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"> 
!read oef/special.phtml imagefill $val14,300x300,24x24	    r1,$val15	    r2,$val16	   
$()</div>	 <div class="medium_size text_col">	 $val17	<p>	Coder la figure avec les symboles donnés.	</p>	</div></div>	
$()
