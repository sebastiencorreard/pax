!set title=Vocabulaire parallèle perpendiculaire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!randint -50, 50

val7=$[rint($(tmp0))]
tmp0=!randitem +,-

tmp1=!randint 30, 60

val8=$[rint($(tmp0)$(tmp1))]
tmp0=!randitem +,-

tmp1=!randint 10, 80

val9=$[rint($(tmp0)$(tmp1))]
val10=-100,0,100,0
val11=$val7,-100,$val7,100
val12=-100,$val8,100,$val8
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	rotate $val9	segment $val7,10,$val7+10,10,red	segment $val7+10,0,$val7+10,10,red	text black,$val7-10,-5,medium,$(val6[1])	text black,-75,20,medium,d1	text black,$val7+5,75,medium,d2	segment $val10,black	segment $val11,black	 
tmp0=$ins_url
val13=$(tmp0)
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	rotate $val9	segment $val7,10,$val7+10,10,red	segment $val7+10,0,$val7+10,10,red	segment $val7,$val8+10,$val7+10,$val8+10,red	segment $val7+10,$val8,$val7+10,$val8+10,red	text black,$val7-10,-5,medium,$(val6[1])	text black,-75,20,medium,d1	text black,$val7+5,75,medium,d2	segment $val10,black	segment $val11,black	segment $val12,black	text black,75,$val8+15,medium,d3	 
tmp0=$ins_url
val14=$(tmp0)
val15=perpendiculaires,parallèles
val16=d2,d3
tmp0=!randint 1, 2

val17=$(tmp0)
val18=<img src="$val13" alt="">,<img src="$val14" alt="">
val18=$(val18[$val17])
val19=Les deux droites d1 et $(val16[$val17]) sont
replytype1=raw
replyoption1=nocase 
replyname1=
replygood1=$(val15[$val17])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val18</div>	 <div class="medium_size text_col">	$val19		 
!read oef/embed.phtml r1,15 
$().		 </div>	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18,19
embedcnt=1
