!set title=Nommer un point 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer sur le point
tmp0=!shuffle A,B,C

val7=$(tmp0)
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!shuffle 94

val9=$(tmp0)
val10=
!for val11 =1 to 3 
val12=$[rint(($(val9[$val11])+4)*5)]
tmp0=!append item $val12 to $val10

val10=$(tmp0)
!next
val13=
!for val11 =4 to 6 
val14=$[rint(($(val9[$val11])+4)*5)]
tmp0=!append item $val14 to $val13

val13=$(tmp0)
!next
val15=$[rint($(val10[$val8]))]
val16=$[rint($(val13[$val8]))]
!readproc oef/draw.phtml 500,500 \
linewidth 2	poly black,$(val10[1]),$(val13[1]),$(val10[2]),$(val13[2]),$(val10[3]),$(val13[3])	text black,$(val10[1])-20,$(val13[1])-20,medium,$(val7[1])	text black,$(val10[2])-20,$(val13[2])-20,medium,$(val7[2])	text black,$(val10[3])-20,$(val13[3])-20,medium,$(val7[3]) 
tmp0=$ins_url
val17=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val17;circle,$val15,$val16,12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div>$val6 $(val7[$val8]).</div>	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
