!set title=Intersection 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 60, 160

val6=$[rint($(tmp0))]
tmp0=!randint 60, 160

val7=$[rint($(tmp0))]
tmp0=!shuffle A,B,C,E,F,G,R,S,T

val8=$(tmp0)
tmp0=!random 0.1, +10

val9=$[$(tmp0)]
tmp0=!random -2, -10

val10=$[$(tmp0)]
val11=$[rint(0)]
val12=$[rint(200)]
val13=$[rint($val7+1/$val9*($val11-$val6))]
val14=$[rint($val7+1/$val9*($val12-$val6))]
val15=$[rint($val7+1/$val10*($val11-$val6))]
val16=$[rint($val7+1/$val10*($val12-$val6))]
val17=$[rint(40)]
val18=$[rint($val7+1/$val9*($val17-$val6))]
!if $val18<15 
val18=$[rint(15)]
!endif
val19=$[rint($val7+1/$val10*($val17-$val6))]
!readproc oef/draw.phtml 200,200 \
text black,$val6,$val7-20,medium,$(val8[1])	text black,$val17,$val18-15,medium,d1	text black,$val17,$val19+5,medium,d2	segment $val11,$val13,$val12,$val14,black	segment $val11,$val15,$val12,$val16,black	 
tmp0=$ins_url
val20=$(tmp0)
tmp=!trim Les, droites d1 et d2, se coupent, au point, $(val8[1])	Le point d'intersection, des, droites d1 et d2, est, le point $(val8[1])	La droite d1, coupe, la droite d2, au point, $(val8[1])	Les, droites d1 et d2, sont, sécantes, au point $(val8[1])
val21=!translate internal $	\
$ to ;; in $tmp
val22=se coupent,d'intersection,sécantes,parallèles,se coupe,parallèle
tmp0=!randint 1, 4

val23=$(tmp0)
tmp=!translate internal $	$ to ; in $val21

tmp=!row $val23 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
val24=$[rint($(val21[3]))]
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val21;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

