$()	<div class="wims_columns">	 <div class="small_size img_col"><img src="$val20" alt=""></div>	 <div class="medium_size text_col">	 Placer les mots dans l'ordre pour faire une phrase correcte.	<div class="spacer"> 
!read oef/embed.phtml r1,120x30 
$()</div>	</div>	</div>	
$()
!exit

