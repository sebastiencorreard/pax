!set title=Longueur comparaison 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 14, 30

val6=$[rint($(tmp0)*10)]
tmp0=!randitem 0,10,15,20,25,30

val7=$[rint($(tmp0))]
tmp0=!randitem +,-

val8=$(tmp0)
val9=$[rint($val6 $val8 $val7)]
tmp0=!randint 40, 90

val10=$[rint($(tmp0))]
tmp0=!randint 0, $val10-20

val11=$[rint($(tmp0))]
!readproc oef/draw.phtml 400,400 \
xrange -200,200	yrange -200,200	rotate $val10	segment -$val6/2,100,$val6/2,100,black	segment -$val6/2,95,-$val6/2,105,black	segment $val6/2,95,$val6/2,105,black	text black,-$val6/2-10,110,medium,A	text black,$val6/2+10,110,medium,B	rotate $val11	segment -$val9/2,-100,$val9/2,-100,black	segment -$val9/2,-95,-$val9/2,-105,black	segment $val9/2,-95,$val9/2,-105,black	text black,-$val9/2-10,-105,medium,E	text black,$val9/2+5,-105,medium,F 
tmp0=$ins_url
val12=$(tmp0)
val13=AB,EF
val14=<img src="$val12" alt="">
val15=<span style="font-size:24pt"> < </span>,<span style="font-size:24pt"> = </span>,<span style="font-size:24pt"> > </span>
!if $val6<$val9 
val16=$(val15[1])
!endif
!if $val6=$val9 
val16=$(val15[2])
!endif
!if $val6>$val9 
val16=$(val15[3])
!endif
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val16;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val14</div>	 <div class="medium_size text_col">	Comparer la longueur des segments :	<div class="wimscenter larger"> $(val13[1])  
!read oef/embed.phtml r1,80x50 
$() $(val13[2])</div>	 </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14
embedcnt=1
