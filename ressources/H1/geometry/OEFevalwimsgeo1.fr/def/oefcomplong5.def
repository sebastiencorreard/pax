!set title=Longueur comparaison 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r,r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 306,300 \
xrange -150,153	yrange -150,150	segment 0,5,0,-5,black	segment 5,0,-5,0,black	segment -140,0,140,0,black	segment -138,15,138,15,black	text black,-150,5,medium,A	text black,145,5,medium,B	circle 0,0,280,black	text black,-150,30,medium,C	text black,145,30,medium,D	text black,0,-15,medium,O 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!shuffle AB,CD

val7=$(tmp0)
val8=<img src="$val6" alt="">
replytype1=dragfill
replyname1=
replygood1=CD
replytype2=dragfill
replyname2=
replygood2=AB
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val8</div>	 <div class="medium_size text_col">	Nous avons un cercle de centre O. Les points A,B,C et D appartiennent au cercle.	<p>Comparer la longueur des segments :</p>	<div class="wimscenter larger"> 
!read oef/embed.phtml r1,120x40 
$()  &lt;  
!read oef/embed.phtml r2,120x40 
$()</div>	 </div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=2
