!set title=Vocabulaire parallèle perpendiculaire 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
val7=$[rint(50)]
val8=$[rint(50)]
val9=$[rint(20)]
val10=-100,0,100,0
val11=$val7,-100,$val7,100
val12=-100,$val8,100,$val8
val13=-100+$val9,-100,-30+$val9,100
!readproc oef/draw.phtml 200,200 \
xrange -100,100	yrange -100,100	square $val7,10,10,red	square $val7,$val8,10,red	text black,-95,20,medium,d1	text black,$val7+5,-85,medium,d2	segment $val10,black	segment $val11,black	segment $val12,black	text black,85,$val8+15,medium,d3	segment $val13,black	text black,-120+$val9,-85,medium,d4	text black,$val7-10,$val8+15,medium,$(val6[1])	text black,$val7-10,-5,medium,$(val6[2])	text black,$val9-60,-5,medium,$(val6[3])	text black,$val9-55,$val8+15,medium,$(val6[4])	 
tmp0=$ins_url
val14=$(tmp0)
tmp=!trim Les droites d2, et d3 sont ,sécantes ,et perpendiculaires ,au point,$(val6[1]).	La perpendiculaire, à la droite d3, passant par le point, $(val6[1]), est la droite d2.	Les droites d1, et d2 sont ,sécantes ,et perpendiculaires ,au point,$(val6[2]).	La perpendiculaire, à la droite d2, passant par le point, $(val6[2]), est la droite d1.	Les droites d1, et d4 sont ,sécantes, au point,$(val6[3]).	Les droites d3, et d4 sont ,sécantes, au point,$(val6[4]).	
val15=!translate internal $	\
$ to ;; in $tmp
val16=$(val6[1]),$(val6[2]),$(val6[3]),$(val6[4]),parallèles,sécantes,perpendiculaires
tmp0=!randint 1, 6

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val15

tmp=!row $val17 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val18=<img src="$val14" alt="">
val19=Reconstituer la phrase décrivant le dessin.
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val18</div>	 <div class="medium_size text_col">	$val19		 </div>	</div>		 
!read oef/embed.phtml r1,180x50 
$()		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18,19
embedcnt=1
