!set title=Droite et segment 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T,U

val6=$(tmp0)
val7=&#91;$(val6[1])$(val6[2])&#93;
val8=&#91;$(val6[1])$(val6[2])&#41;
val9=&#40;$(val6[1])$(val6[2])&#41;
val10=$(val6[1])$(val6[2])
val11=Un segment limité par deux points $(val6[1]) et $(val6[2]) se note : 
val12=Une droite passant par deux points $(val6[1]) et $(val6[2]) se note : 
val13=Une demi-droite limitée par un point $(val6[1]) et passant par le point $(val6[2]) se note : 
val14=$val11,$val13,$val12
val15=$val7,$val8,$val9,$val10
tmp0=!randint 1, 3

val16=$[rint($(tmp0))]
val17=$(val15[$val16])
choiceoption1=shuffle 
choicename1=
choicegood1=$val17
choicebad1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val14[$val16])	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=14,16
embedcnt=0
