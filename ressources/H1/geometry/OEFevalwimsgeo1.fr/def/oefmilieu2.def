!set title=Milieu 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr
precision=100000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,R,S,T

val6=$(tmp0)
tmp0=!shuffle 3

val7=$(tmp0)
tmp0=!randint 1, 24

val8=$[rint($(tmp0))]
val8=$[rint($val8*2)]
!if $(val7[1])=3 
val9=$[rint($val8)]
val10=$[rint($val8*2)]
!endif
!if $(val7[2])=3 
val9=$[rint($val8)]
val10=$[rint($val8)]
!endif
!if $(val7[3])=3 
val9=$[rint($val8*2)]
val10=$[rint($val8)]
!endif
tmp=!trim Le point $(val6[3]) est le milieu du segment [$(val6[1])$(val6[2])].	Si $(val6[$(val7[1])])$(val6[$(val7[2])]) = $val9 cm alors $(val6[$(val7[2])])$(val6[$(val7[3])]) = 
val11=!translate internal $	\
$ to ;; in $tmp
replytype1=numeric
replyname1=
replygood1=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<ul><li>	$(val11[1;])	</li><li>	$(val11[2;])  
!read oef/embed.phtml r1,5 
$() cm	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

