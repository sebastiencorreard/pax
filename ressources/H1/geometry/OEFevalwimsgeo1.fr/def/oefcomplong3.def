!set title=Longueur comparaison 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=r,r,r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 14, 30

val6=$[rint($(tmp0)*10)]
tmp0=!randitem 10,15,20

val7=$[rint($(tmp0))]
tmp0=!randitem 10,15,20

val8=$[rint($(tmp0))]
val9=$[rint($val6+$val7)]
val10=$[rint($val9+$val8)]
val11=$val6,$val9,$val10
tmp0=!shuffle 3

val12=$(tmp0)
val13=AB,EF,RS
val14=$[rint($(val11[$(val12[1])]))]
val15=$[rint($(val11[$(val12[2])]))]
val16=$[rint($(val11[$(val12[3])]))]
tmp0=!randint 40, 90

val17=$[rint($(tmp0))]
tmp0=!randint 0, $val17-20

val18=$[rint($(tmp0))]
!readproc oef/draw.phtml 400,400 \
xrange -200,200	yrange -200,200	segment -$val16/2,150,$val16/2,150,black	segment -$val16/2,145,-$val16/2,155,black	segment $val16/2,145,$val16/2,155,black	text black,-$val16/2-10,160,medium,R	text black,$val16/2+10,160,medium,S	rotate $val17	segment -$val14/2,100,$val14/2,100,black	segment -$val14/2,95,-$val14/2,105,black	segment $val14/2,95,$val14/2,105,black	text black,-$val14/2-10,110,medium,A	text black,$val14/2+10,110,medium,B	rotate $val18	segment -$val15/2,-100,$val15/2,-100,black	segment -$val15/2,-95,-$val15/2,-105,black	segment $val15/2,-95,$val15/2,-105,black	text black,-$val15/2-10,-105,medium,E	text black,$val15/2+5,-105,medium,F 
tmp0=$ins_url
val19=$(tmp0)
!if $val12=3,1,2 
val12=2,3,1
!else
!if $val12=2,3,1 
val12=3,1,2
!endif
!endif
val20=<img src="$val19" alt="">
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val13[$(val12[1])])
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$(val13[$(val12[2])])
replytype3=dragfill
replyoption3=shuffle 
replyname3=
replygood3=$(val13[$(val12[3])])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val20</div>	 <div class="medium_size text_col">	 Comparer la longueur des segments :	<div class="wimscenter larger"> 
!read oef/embed.phtml r1,120x40 
$() &lt; 
!read oef/embed.phtml r2,120x40 
$()	 &lt; 
!read oef/embed.phtml r3,120x40 
$()</div>	 </div>	</div>	 
$()
!exit

