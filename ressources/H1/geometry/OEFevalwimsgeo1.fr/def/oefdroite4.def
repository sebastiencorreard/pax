!set title=Droite 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
language=fr

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,R,S,T,U

val6=$(tmp0)
val7=&#91;$(val6[1])$(val6[2])&#93;
val8=&#91;$(val6[1])$(val6[2])&#41;
val9=&#40;$(val6[1])$(val6[2])&#41;
val10=$(val6[1])$(val6[2])
val11=Une droite passant par deux points $(val6[1]) et $(val6[2]) se note : 
choiceoption1=shuffle 
choicename1=
choicegood1=$val9
choicebad1=$val8,$val7,$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

