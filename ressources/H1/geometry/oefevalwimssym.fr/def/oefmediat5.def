!set title=Définition de la médiatrice 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=perpendicular_bisector

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer sur un point de la médiatrice du segment [AB]	  autre que le milieu du segment [AB].
!readproc oef/draw.phtml 300,300 \
segment 20,280,280,20,black	segment 100,100,200,200,black	segment 95,105,105,95,black	segment 195,205,205,195,black	segment 150,10,150,290,black	segment 10,150,290,150,black	segment 220,10,80,290,black	segment 10,220,290,80,black	segment 0,250,250,0,black	segment 50,290,290,50,black	text black,90,90,medium,A	text black,202,202,medium,B	 
tmp0=$ins_url
val7=$(tmp0)
val8=polygon,10,284,16,290,138,168,132,162|polygon,162,132,168,138,290,16,284,10
replytype1=coord
replyname1=
replygood1=$val7;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=1
