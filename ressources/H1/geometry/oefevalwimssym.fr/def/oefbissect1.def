!set title=Définition de la bissectrice 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=angle_bisector

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim La bissectrice,d'un angle,est	l'axe,de symétrie,de cet angle.	La bissectrice,d'un angle,est la demi-droite,qui partage	cet angle,en deux angles,de même mesure.	La bissectrice,d'un angle,est une demi-droite,qui partage	en deux parties, superposables.
val6=!translate internal $	\
$ to ;; in $tmp
val7=Placer les mots dans l'ordre pour faire une phrase correcte&nbsp;
tmp0=!randint 0, 2

val8=$[rint($(tmp0)*2)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8+1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8+2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val9;$val9
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val10;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7:	<ul class="wims_nopuce"><li> 
!read oef/embed.phtml r1,180x30 
$()</li>	<li> 
!read oef/embed.phtml r2,180x30 
$().</li>	</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=2
