!set title=Instruments 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Un élève a construit le symétrique d'une figure	  par rapport à la droite (d).
val7=Oui,Non,Je ne sais pas
val8=L'équerre a été mal utilisée car les perpendiculaires ne sont pas respectées.,	  Le compas a été mal utilisé car les reports de longueurs ne sont pas corrects.,	  L'élève ne connaît pas les propriétés de la symétrie qui conserve la longueur des segments et la mesure des angles.,	  Non il n'y a pas d'erreur.
tmp=!trim La construction de l'élève est correcte&nbsp;	  La construction n'est pas correcte car&nbsp;,choisir la (ou les) erreur(s)
val9=!translate internal $	\
$ to ;; in $tmp
!readproc oef/draw.phtml 400,400 \
xrange -200,200	yrange -200,200	linewidth 2	rotate 0	segment -300,-300,300,300, black	text black,180,180,medium,(d)	segment -40,80,40,80, black	segment -40,80,-40,140, black	segment 40,80,40,140, black	segment -40,140,0,180,black	segment 40,140,0,180,black	linewidth 1	segment -40,90,-40,-90,black	segment 40,90,40,-90,black	linewidth 2	rotate 180	segment -40,80,40,80, black	segment -40,80,-40,140, black	segment 40,80,40,140, black	segment -40,140,0,180,black	segment 40,140,0,180,black 
tmp0=$ins_url
val10=$(tmp0)
val11=2
val12=1,2
val10=<img src="$val10" alt="">
replytype1=menu
replyname1=
replygood1=$val11;$val7
replytype2=checkbox
replyname2=
replygood2=$val12;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	  $val10	  </div>	  <div class="medium_size">	  $val6	<ul><li>	  $(val9[1;]) :  
!read oef/embed.phtml r1 
$()	</li><li>	$(val9[2;1]): <i>($(val9[2;2]))</i>:	<ul><li> 
!read oef/embed.phtml r2,1 
$()</li>	<li> 
!read oef/embed.phtml r2,2 
$()</li>	<li> 
!read oef/embed.phtml r2,3 
$()</li>	<li> 
!read oef/embed.phtml r2,4 
$()</li></ul>	</li></ul>	</div>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10
embedcnt=5
