segment 0,300,300,0,red	segment 75,215,85,225,black	segment 75,225,85,215,black	segment 70,105,80,95,black	segment 70,95,80,105,black	segment 255,45,245,55,black	segment 255,55,245,45,black	text black,60,100,medium,C	text black,85,225,medium,B	text black,255,55,medium,A	 
