!set title=Utiliser la médiatrice 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry,perpendicular_bisector

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 300,300 \
xrange -150,150	yrange -150,150	rotate 40	segment 0,-150,0,150,black	segment -100,-50,100,-50,black	segment -48,-44,-52,-56,red	segment -52,-44,-56,-56,red	segment 48,-56,52,-44,red	segment 52,-56,56,-44,red	segment -100,-55,-100,-45,black	segment 100,-55,100,-45,black	segment 0,-40,10,-40,red	segment 10,-40,10,-50,red	text black,10,140,medium,(d)	text black,-110,-55,medium,A	text black,105,-55,medium,B	 
tmp0=$ins_url
val6=$(tmp0)
val7=$val6
val8=La droite (d) est perpendiculaire à la droite (AB)
val9=et la droite (d) passe par le milieu du segment [AB] &#44;
val10=donc la droite (d) est la médiatrice du segment [AB].
val11=$val8,$val9
val12=$val10
val13=320x40
replytype1=dragfill
replyname1=
replygood1=$val11
replytype2=dragfill
replyname2=
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="wimscenter">	    <img src="$val7" alt="">	</div>	  Placer les étiquettes dans le bon ordre :	<ul>	<li> 
!read oef/embed.phtml r1,$val13 
$()</li>	<li> 
!read oef/embed.phtml r2,$val13 
$()</li>	</ul>		
$()
!exit

