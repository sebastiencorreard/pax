!set title=Reconnaitre une symétrie axiale 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry

ansorder=c
varcnt=36
prevarcnt=35
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=darkblue,green
tmp0=!shuffle $val6

val6=$(tmp0)
val7=lightblue
tmp0=!randint -12, 12

val8=$[0.4*$(tmp0)]
tmp0=!randint -24, -12

val9=$[0.4*$(tmp0)]
tmp0=!randint -12, -4

val10=$[0.4*$(tmp0)]
tmp0=!randint 12, 22

val11=$[0.4*$(tmp0)]
tmp0=!randint 2, 12

val12=$[0.4*$(tmp0)]
tmp0=!randint 12, 32

val13=$[0.4*$(tmp0)]
val14=$[$val8+$val10]
val15=$[$val9+$val11]
val16=$[$val8+$val12]
val17=$[$val9+$val13]
val18=$[max(-$val9,max(-$val15,-$val17))]
val19=$[min(-$val9,min(-$val15,-$val17))]
val20=$[$val19+$val18]
tmp=!trim 0,0,0,-1,oui	0,1.2,0,-1,non	$val20,$val20,$val20,1,non	1.2,1.2,1.2,-1,non	0,0,0,-1,oui	0,0,0,-1,oui
val21=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 6

val22=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val21

tmp=!row $val22 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val21=$(tmp0)
val23=$[$(val21[1])]
val24=$[0]
val25=$[$(val21[2])]
val26=$[0]
val27=$[$(val21[3])]
val28=$[0]
val29=$[$(val21[4])]
val30=$[1]
val31=$[($val8+$val24)*$val30]
val32=$[($val9+$val23)*$val29]
val33=$[($val14+$val26)*$val30]
val34=$[($val15+$val25)*$val29]
val35=$[($val16+$val28)*$val30]
val36=$[($val17+$val27)*$val29]
val37=vline 0,0,$val7	hline 0,0,black	text black,9,1,large,D1
!readproc oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10	gridfill 0,0,10,10,$val7	translate 0.2,0.2	linewidth 2	vline 2,0,$val7	vline 4,0,$val7	vline 6,0,$val7	vline 8,0,$val7	vline 10,0,$val7	vline -2,0,$val7	vline -4,0,$val7	vline -6,0,$val7	vline -8,0,$val7	vline -10,0,$val7	hline 0,2,$val7	hline 0,4,$val7	hline 0,6,$val7	hline 0,8,$val7	hline 0,10,$val7	hline 0,-2,$val7	hline 0,-4,$val7	hline 0,-6,$val7	hline 0,-8,$val7	hline 0,-10,$val7	triangle $val8,$val9,$val14,$val15,$val16,$val17,$(val6[1])	triangle $val31,$val32,$val33,$val34,$val35,$val36,$(val6[2])	$val37 
tmp0=$ins_url
val38=$(tmp0)
choicename1=
choicegood1=$(val21[5])
choicebad1=oui,non
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

