!set title=Raisonnements 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 300,300 \
segment 100,0,100,300,red	segment 0,150,300,150,red	segment 20,150,100,70,black	segment 100,70,239,150,black	segment 100,230,239,150,black	segment 20,150,100,230,black	segment 50,150,100,70,black	segment 150,150,100,70,black	segment 50,150,100,230,black	segment 150,150,100,230,black	text black,10,135,medium,A	text black,90,60,medium,B	text black,245,135,medium,C	text black,90,230,medium,D	text black,45,135,medium,E	text black,90,135,medium,F	text black,155,135,medium,G	 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!randint 5, 12

val7=$[rint($(tmp0))]
tmp0=!randint $val7+1, 29

val8=$[rint($(tmp0))]
tmp0=!randint 2, $val7-1

val9=$[rint($(tmp0))]
tmp0=!randint 5, 12

val10=$[rint($(tmp0))]
val11=$[rint(arctan(($val7-$val9)/$val10)/pi*180)]
val12=$[rint(2*$val11)]
val13=$[rint($val9+$val8-$val7)]
val13=$val13 cm
val14=$val12 °
val15=<li>Le point G est le symétrique du point E par rapport à la droite (BD).</li>	  <li>Le segment [AF] mesure $val7 cm, le segment [FC] mesure $val8 cm et le segment [AE] mesure $val9 cm.</li>
val16=Calculer la longueur du segment [GC]:
val17=L'angle \(\widehat{EBF}) mesure $val11 °.
val18=EBG
replytype1=units
replyname1=
replygood1=$val13
replytype2=units
replyname2=
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val6" alt="">	  </div>	  <div class="medium_size">	    <ul>	    $val15	    <li>	    <label for="reply1">$val16</label>  
!read oef/embed.phtml r1,10 
$()	    </li>	    
!if $val17!= 
$()	      <li>$val17</li>	     
!endif
$()	    <li>	    <label for="reply2">Donner la mesure de l'angle 
!insmath \widehat{$val18}
$() :</label>	     
!read oef/embed.phtml r2,10 
$().	    </li>	    </ul>	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,15,16,17,18
embedcnt=2
