!set title=Compléter une symétrie 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la construction avec les instruments de géométrie sur une feuille de brouillon	et répondre à la question :
tmp0=!shuffle 35

val7=$(tmp0)
val8=$[(20+$(val7[1]))*2/10]
val9=$[(20+$(val7[2]))*2/10]
val10=$[(20+$(val7[3]))*2/10]
val11=$[rint(sqrt($val9^2-(($val8^2+$val9^2-$val10^2)/(2*$val8))^2)*20)]
val12=$[($val11-1)/10]
val13=$[($val11+1)/10]
val14=<li>Tracer un triangle ABC tel que :	<div class="wimscenter">AC = $val8 cm&#44; AB = $val9 cm et BC = $val10 cm.</div></li>	<li>Construire le triangle AEC, symétrique du triangle ABC par rapport à la droite (AC).</li>
val15=Mesurer le segment BE.
val16=BE
replytype1=range
replyname1=
replygood1=!rawmath $val12,$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<ul>	$val14	<li>$val15</li>	</ul>	<div class="wimscenter"><label for="reply1">$val16 =</label>	 
!read oef/embed.phtml r1,10 
$() cm.</div>	<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,14,15,16
embedcnt=1
