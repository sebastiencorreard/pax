$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val11" alt="">	  </div>	  <div class="medium_size">	  $(val6[1;1]) &#91;$(val8[1])$(val8[4])&#41; $(val6[1;2]) 
!insmath \widehat{$(val8[3])$(val8[1])$(val8[2])}
$().	  $(val6[2;1]) 
!insmath \widehat{$(val8[3])$(val8[1])$(val8[2])}
$() $(val6[2;2]) $val10°.	  <div class="spacer"><label for="reply1">	    $val7 
!insmath \widehat{$(val8[4])$(val8[1])$(val8[2])}
$()&nbsp;: </label> 
