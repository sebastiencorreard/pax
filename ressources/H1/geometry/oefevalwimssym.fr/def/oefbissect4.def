tmp=!trim La demi-droite, est la bissectrice de l'angle	  L'angle, mesure
val6=!translate internal $	\
$ to ;; in $tmp
val7=Donner la mesure de l'angle
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val8=$(tmp0)
tmp0=!randint 2, 8

val9=$[rint($(tmp0)*10)]
val10=$[rint($val9*2)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val9*pi/180)*9,sin($val9*pi/180)*9,black	arc 0,0,2,2,0,$val9,red	arc 0,0,4,4,$val9,$val10,red	segment cos(($val9/2)*pi/180)*0.7,sin(($val9/2)*pi/180)*0.7,cos(($val9/2)*pi/180)*1.3,sin(($val9/2)*pi/180)*1.3,red	segment cos(($val10*0.75)*pi/180)*1.6,sin(($val10*0.75)*pi/180)*1.6,cos(($val10*0.75)*pi/180)*2.4,sin(($val10*0.75)*pi/180)*2.4,red	text black,cos(($val9+8)*pi/180)*6,sin(($val9+8)*pi/180)*6,medium,$(val8[4])	segment cos(($val9)*pi/180)*5-0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5+0.2*cos(($val9)*pi/180),cos(($val9)*pi/180)*5+0.2*sin(($val9)*pi/180),sin(($val9)*pi/180)*5-0.2*cos(($val9)*pi/180),black	segment 0,0,cos($val10*pi/180)*9,sin($val10*pi/180)*9,black	text black,cos(($val10+4)*pi/180)*6,sin(($val10+4)*pi/180)*6,medium,$(val8[3])	segment cos(($val10)*pi/180)*5-0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5+0.2*cos(($val10)*pi/180),cos(($val10)*pi/180)*5+0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5-0.2*cos(($val10)*pi/180),black	segment 0,0,9,0,black	segment 5,-0.2,5,0.2,black	text black,5,-0.2,medium,$(val8[2])	text black,-0.5,0,medium,$(val8[1]) 
tmp0=$ins_url
val11=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

