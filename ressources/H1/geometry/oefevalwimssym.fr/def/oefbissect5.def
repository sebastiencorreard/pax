!set title=Définition de la bissectrice 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=angle_bisector

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Tous les angles représentés ont la même mesure.	  La bissectrice de l'angle,est la demi-droite
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val7=$(tmp0)
val8=
!for val9 =0 to 9 
val10=$[rint($val9*20)]
val8=$val8	  segment 0,0,cos($val10*pi/180)*9,sin($val10*pi/180)*9,black	  text black,cos(($val10+9-$val9)*pi/180)*6,sin(($val10+9-$val9)*pi/180)*6,medium,$(val7[2+$val9])	  segment cos(($val10)*pi/180)*5-0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5+0.2*cos(($val10)*pi/180),cos(($val10)*pi/180)*5+0.2*sin(($val10)*pi/180),sin(($val10)*pi/180)*5-0.2*cos(($val10)*pi/180),black
!next
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	$val8	text black,0,-0.2,medium,$(val7[1]) 
tmp0=$ins_url
val8=$(tmp0)
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
tmp0=!randint 1, (11-$val11)/2

val12=$[rint($val11+$(tmp0)*2)]
val13=\(\widehat{$(val7[$val11])$(val7[1])$(val7[$val12])})
val14=$[rint(($val11+$val12)/2)]
val15=$(val7[1])$(val7[$val14])
val16=<img src="$val8" alt="">
replytype1=raw
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wimscenter">$val16</div>	  $(val6[1;])	  <div class="spacer"><label for="reply1">$(val6[2;1]) $val13	$(val6[2;2])</label> &#91; 
!read oef/embed.phtml r1,2 
$()&#41;.	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13,16
embedcnt=1
