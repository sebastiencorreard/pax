!set title=Raisonnements 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 300,300 \
rect 50,90,250,210,black	poly black,50,90,158,34,250,210,142,266	line 20,72,280,228,red	line 50,210,158,34,black	line 250,90,142,266,black	text black,40,70,medium,A	text black,255,75,medium,B	text black,250,220,medium,C	text black,40,215,medium,D	text black,140,270,medium,F	text black,150,20,medium,G 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!randint 6, 29

val7=$[rint($(tmp0))]
tmp0=!randint 3, $val7-1

val8=$[rint($(tmp0))]
val9=$[rint(($val7+$val8)*2)]
val9=$val9 cm
val10=90°
val11=<li>Le quadrilatère ABCD est un rectangle.</li>	 <li>Le point F est le symétrique du point B par rapport à la droite (AC).</li>	 <li>Le point G est le symétrique du point D par rapport à la droite (AC).</li>	 <li>Le segment [AB] mesure $val7 cm et le segment [BC] mesure $val8 cm.</li>
val12=Calculer le périmètre du quadrilatère AGCF:
val13=CFA
replytype1=units
replyname1=
replygood1=$val9
replytype2=units
replyname2=
replygood2=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val6" alt="">	  </div>	  <div class="medium_size">	    <ul>	    $val11	    <li>	    <label for="reply1">$val12</label>  
!read oef/embed.phtml r1,10 
$()	    </li>	    
!if $m_enonc2!= 
$()	      <li>$m_enonc2</li>	     
!endif
$()	    <li>	    <label for="reply2">Donner la mesure de l'angle 
!insmath \widehat{$val13}
$() :</label>	     
!read oef/embed.phtml r2,10 
$().	    </li>	    </ul>	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,12,13
embedcnt=2
