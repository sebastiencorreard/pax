!set title=Phrase à compléter 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=symmetry
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000

ansorder=r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Le point
val8=est 
val9=du point $(val6[3]) par rapport à la droite &#40;
val10=&#41;.
val11=$(val6[4])
val12=le symétrique
val13=$(val6[1])$(val6[2])|$(val6[2])$(val6[1])
val14=$[rint(2)]
val15=$[rint(12)]
val16=$[rint(2)]
!readproc oef/draw.phtml 300,300 \
segment 0,300,300,0,red	segment 75,215,85,225,black	segment 75,225,85,215,black	segment 70,105,80,95,black	segment 70,95,80,105,black	segment 255,45,245,55,black	segment 255,55,245,45,black	segment 194,219,204,229,black	segment 194,229,204,219,black	segment 75,100,199,224,black	circle 106,131,8,red	circle 168,193,8,red	segment 130,155,137,148,red	segment 137,148,144,155,red	text black,60,100,medium,$(val6[3])	text black,85,225,medium,$(val6[2])	text black,255,55,medium,$(val6[1])	text black,184,225,medium,$(val6[4])	 
tmp0=$ins_url
val17=$(tmp0)
replytype1=case
replyname1=
replygood1=$val11
replytype2=case
replyname2=
replygood2=$val12
replytype3=case
replyname3=
replygood3=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val17" alt="">	  </div>	  <div class="medium_size">	  <label for="reply1">$val7</label>  
!read oef/embed.phtml r1,$val14 
$()	  <label for="reply2">$val8</label>  
!read oef/embed.phtml r2,$val15 
$()	  <label for="reply3">$val9</label>  
!read oef/embed.phtml r3,$val16 
$()	  $val10	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
