!set title=Reconnaitre une symétrie axiale 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry

ansorder=c
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=darkblue,green
tmp0=!shuffle $val6

val6=$(tmp0)
val7=lightblue
tmp0=!randint -20, -5

val8=$[rint($(tmp0))]
val9=$[0.4*$val8]
tmp0=!randint -20, $val8

val10=$[0.4*$(tmp0)]
tmp0=!randint -5, 10

val8=$[rint($(tmp0))]
val11=$[0.4*$val8]
tmp0=!randint -20, -10

val12=$[0.4*$(tmp0)]
tmp0=!randint 12, 22

val8=$[rint($(tmp0))]
val13=$[0.4*$val8]
tmp0=!randint -15, $val8

val14=$[0.4*$(tmp0)]
val15=$[max($val10,max($val12,$val14))]
val16=$[min($val9,min($val11,$val13))]
val17=$[(10-$val15)*0.8]
tmp=!trim 0,0,0,0,0,0,1,1,oui	1.2,1.2,0,0,0,0,1,1,non	$val9-$val10,$val10-$val9,$val11-$val12,$val12-$val11,$val13-$val14,$val14-$val13,-1,1,non	0,0,0,0,0,0,1,1,oui	$val9-$val10,$val10-$val9,$val11-$val12,$val12-$val11,$val13-$val14,$val14-$val13,1,-1,non	$val9-$val10,$val10-$val9+$val17,$val11-$val12,$val12-$val11+$val17,$val13-$val14,$val14-$val13+$val17,1,1,non	0,0,0,0,0,0,1,1,oui	0,0,0,0,0,0,1,1,oui
val18=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 8

val19=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val18

tmp=!row $val19 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
val20=$[$(val18[1])]
val21=$[$(val18[2])]
val22=$[$(val18[3])]
val23=$[$(val18[4])]
val24=$[$(val18[5])]
val25=$[$(val18[6])]
val26=$[$(val18[7])]
val27=$[$(val18[8])]
val28=$[($val10+$val20)*$val26]
val29=$[($val9+$val21)*$val27]
val30=$[($val12+$val22)*$val26]
val31=$[($val11+$val23)*$val27]
val32=$[($val14+$val24)*$val26]
val33=$[($val13+$val25)*$val27]
val34=vline 0,0,$val7	segment 10,10,-10,-10,black	text black,9,9,large,D1
!readproc oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10	gridfill 0,0,10,10,$val7	translate 0.2,0.2	linewidth 2	vline 2,0,$val7	vline 4,0,$val7	vline 6,0,$val7	vline 8,0,$val7	vline 10,0,$val7	vline -2,0,$val7	vline -4,0,$val7	vline -6,0,$val7	vline -8,0,$val7	vline -10,0,$val7	hline 0,2,$val7	hline 0,4,$val7	hline 0,6,$val7	hline 0,8,$val7	hline 0,10,$val7	hline 0,-2,$val7	hline 0,-4,$val7	hline 0,-6,$val7	hline 0,-8,$val7	hline 0,-10,$val7	triangle $val9,$val10,$val11,$val12,$val13,$val14,$(val6[1])	triangle $val28,$val29,$val30,$val31,$val32,$val33,$(val6[2])	$val34 
tmp0=$ins_url
val35=$(tmp0)
choicename1=
choicegood1=$(val18[9])
choicebad1=oui,non
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

