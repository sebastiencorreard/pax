!set title=Compléter une symétrie 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la construction avec les instruments de géométrie sur une feuille de brouillon	et répondre à la question :
tmp0=!randint 15, 30

val7=$[$(tmp0)]
tmp0=!randint 10, $val7*2-5

val8=$[$(tmp0)*2/10]
val7=$[$val7*2/10]
val9=$[rint(sqrt($val7^2-$val8^2/4)*20)]
val10=$[($val9-1)/10]
val11=$[($val9+1)/10]
val12=<li>Tracer un cercle de centre A et de rayon $val7 cm.</li>	<li>Tracer une corde [EF] du cercle telle que EF = $val8 cm.</li>	<li>Construire le cercle de centre S, symétrique du cercle de centre A par rapport à la droite (EF).</li>	
val13=Mesurer le segment AS.
val14=AS
replytype1=range
replyname1=
replygood1=!rawmath $val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<ul>	$val12	<li>$val13</li>	</ul>	<div class="wimscenter"><label for="reply1">$val14 =</label>	 
!read oef/embed.phtml r1,10 
$() cm.</div>	<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12,13,14
embedcnt=1
