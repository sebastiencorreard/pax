!set title=Raisonnements 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 300,300 \
segment 150,0,150,300,red	square 50,80,100,black	square 150,80,100,black	text black,45,185,medium,A	text black,140,185,medium,B	text black,140,65,medium,C	text black,45,65,medium,D	text black,250,185,medium,F	text black,250,65,medium,G	text black,155,10,medium,D1	 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!randint 3, 19

val7=$[rint($(tmp0))]
val8=$[rint($val7*6)]
val8=$val8 cm
val9=90°
val10=<li>Le quadrilatère ABCD est un carré.</li>	<li>Le point F est le symétrique du point A par rapport à la droite D1.</li>	<li>Le segment [AB] mesure $val7 cm.</li>
val11=Calculer le périmètre du quadrilatère AFGD:
val12=L'angle \(\widehat{DAB}) mesure $val9.
val13=BFG
replytype1=units
replyname1=
replygood1=$val8
replytype2=units
replyname2=
replygood2=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val6" alt="">	  </div>	  <div class="medium_size">	    <ul>	    $val10	    <li>	    <label for="reply1">$val11</label>  
!read oef/embed.phtml r1,10 
$()	    </li>	    
!if $val12!= 
$()	      <li>$val12</li>	     
!endif
$()	    <li>	    <label for="reply2">Donner la mesure de l'angle 
!insmath \widehat{$val13}
$() :</label>	     
!read oef/embed.phtml r2,10 
$().	    </li>	    </ul>	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10,11,12,13
embedcnt=2
