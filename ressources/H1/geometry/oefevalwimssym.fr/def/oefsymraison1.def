!set title=Raisonnements 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 300,300 \
segment 150,0,150,300,red	segment 75,150,225,150,black	segment 75,150,150,75,black	segment 150,75,225,150,black	segment 70,145,80,155,black	segment 70,155,80,145,black	segment 220,145,230,155,black	segment 230,145,220,155,black	text black,60,140,medium,A	text black,235,140,medium,B	text black,140,65,medium,C	text black,140,135,medium,M	text black,155,10,medium,D1	 
tmp0=$ins_url
val6=$(tmp0)
tmp0=!randint 5, 29

val7=$[rint($(tmp0))]
tmp0=!randint 1, $val7-1

val8=$[rint($(tmp0))]
val9=$[rint(arccos($val8/$val7)/pi*180)]
val10=$[rint(($val7+$val8)*2)]
val10=$val10 cm
val11=$val9 °
val12=<li>Le point B est le symétrique du point A par rapport à la droite D1</li>	<li>Le segment [AC] mesure $val7 cm et le segment [AM] mesure $val8 cm.</li>
val13=Calculer le périmètre du triangle ABC:
val14=L'angle \(\widehat{CAB}) mesure $val11.
val15=CBA
replytype1=units
replyname1=
replygood1=$val10
replytype2=units
replyname2=
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size">	    <img src="$val6" alt="">	  </div>	  <div class="medium_size">	    <ul>	    $val12	    <li>	    <label for="reply1">$val13</label>  
!read oef/embed.phtml r1,10 
$()	    </li>	    
!if $val14!= 
$()	      <li>$val14</li>	     
!endif
$()	    <li>	    <label for="reply2">Donner la mesure de l'angle 
!insmath \widehat{$val15}
$() :</label>	     
!read oef/embed.phtml r2,10 
$().	    </li>	    </ul>	  </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12,13,14,15
embedcnt=2
