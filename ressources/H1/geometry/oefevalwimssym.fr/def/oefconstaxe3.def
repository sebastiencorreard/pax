!set title=Compléter une symétrie 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la construction avec les instruments de géométrie sur une feuille de brouillon	et répondre à la question :
tmp0=!randint 25, 45

val7=$[$(tmp0)]
tmp0=!randint 20, $val7-3

val8=$[$(tmp0)*2/10]
val7=$[$val7*2/10]
val9=$[rint(sqrt($val8^2+$val7^2)*10)]
val10=$[rint($val7*$val8*200/$val9)]
val11=$[($val10-1)/10]
val12=$[($val10+1)/10]
val13=<li>Tracer un rectangle EFGH tel que :	<div class="wimscenter">EF = $val7 cm et EG = $val8 cm.</div></li>	<li>Construire le rectangle HRFS, symétrique du rectangle EFGH par rapport à la droite (HF).</li>	<li>Le point R est le symétrique du point E et le point S est le symétrique du point G.</li>
val14=Mesurer le segment ER.
val15=ER
replytype1=range
replyname1=
replygood1=!rawmath $val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<ul>	$val13	<li>$val14</li>	</ul>	<div class="wimscenter"><label for="reply1">$val15 =</label>	 
!read oef/embed.phtml r1,10 
$() cm.</div>	<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13,14,15
embedcnt=1
