val6=Avec l'équerre et la règle graduée&nbsp;
val7=Pour tracer le point C', symétrique du point C par rapport à la droite (AB),	 j'utilise l'équerre pour tracer une droite 
val8=à la droite 
val9=et passant par le point
val10=Cette droite coupe la droite (AB) au point M.	 Avec la règle graduée, je mesure la longueur du segment 
val11=et je reporte cette longueur pour que le point M soit le milieu du segment 
val12=perpendiculaire,parallèle,sécante
val13=Votre réponse
!readproc oef/draw.phtml 300,300 \
segment 0,300,300,0,red	segment 75,215,85,225,black	segment 75,225,85,215,black	segment 70,105,80,95,black	segment 70,95,80,105,black	segment 255,45,245,55,black	segment 255,55,245,45,black	text black,60,100,medium,C	text black,85,225,medium,B	text black,255,55,medium,A	 
tmp0=$ins_url
val14=$(tmp0)
tmp0=!shuffle $val12

val15=$(tmp0)
tmp0=!positionof item $(val12[1]) in $val15

val16=$(tmp0)
val17=(AB),(AC),(BC)
tmp0=!shuffle $val17

val17=$(tmp0)
tmp0=!positionof item (AB) in $val17

val18=$(tmp0)
val19=C,A,B
tmp0=!shuffle $val19

val19=$(tmp0)
tmp0=!positionof item C in $val19

val20=$(tmp0)
val21=[MC],[MA],[MB]
tmp0=!shuffle $val21

val21=$(tmp0)
tmp0=!positionof item [MC] in $val21

val22=$(tmp0)
val23=[CC'],[BC'],[AC']
tmp0=!shuffle $val23

val23=$(tmp0)
tmp0=!positionof item [CC'] in $val23

val24=$(tmp0)
