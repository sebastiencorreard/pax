!set title=Placer le symétrique 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=lightblue
tmp0=!randint -4, 4

val7=$[2*$(tmp0)]
tmp0=!randint -4, 4

val8=$[2*$(tmp0)]
val9=$[$val8]
val10=$[$val7]
val11=$[250+$val9*25+5]
val12=$[250-$val10*25-5]
val13=hline 0,0,$val6	vline 0,0,$val6	segment 10,10,-10,-10,black	text black,9,9,large,D1
!readproc oef/draw.phtml 500,500 \
xrange -10,10	yrange -10,10	gridfill 0,0,10,10,$val6	translate 0.2,0.2	linewidth 2	vline 2,0,$val6	vline 4,0,$val6	vline 6,0,$val6	vline 8,0,$val6	vline 10,0,$val6	vline -2,0,$val6	vline -4,0,$val6	vline -6,0,$val6	vline -8,0,$val6	vline -10,0,$val6	hline 0,2,$val6	hline 0,4,$val6	hline 0,6,$val6	hline 0,8,$val6	hline 0,10,$val6	hline 0,-2,$val6	hline 0,-4,$val6	hline 0,-6,$val6	hline 0,-8,$val6	hline 0,-10,$val6	segment $val7+0.2,$val8+0.2,$val7-0.2,$val8-0.2,black	segment $val7-0.2,$val8+0.2,$val7+0.2,$val8-0.2,black	$val13 
tmp0=$ins_url
val14=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val14;circle,$val11,$val12,12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  	Cliquer pour placer le symétrique du point par rapport	à la droite D1.		<div class="wimscenter">	 
!read oef/embed.phtml r1 
$()	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=
embedcnt=1
