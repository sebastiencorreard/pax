!set title=Définition de la médiatrice 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=perpendicular_bisector

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim La médiatrice,d'un segment,est la droite	  passant par,le milieu du segment,et perpendiculaire,à ce segment.	  Si un point,est sur la médiatrice,d'un segment	  alors il est à égale,distance (équidistant),des extrémités,du segment.	  Si un point,est à égale,distance (équidistant),des extrémités,d'un segment	  alors il est,sur la médiatrice,de ce segment.	  On appelle,médiatrice,d'un segment	  la droite,perpendiculaire,à ce segment,en son milieu.	  La médiatrice,d'un segment,est	  un axe,de symétrie,de ce segment.	  Si un point,appartient,à la médiatrice,d'un segment	  alors il est situé,à égale distance,des extrémités,de ce segment.
val6=!translate internal $	\
$ to ;; in $tmp
val7=Placer les mots dans l'ordre pour faire une phrase correcte
tmp0=!randint 0, 5

val8=$[rint($(tmp0)*2)]
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8+1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8+2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val9;$val9
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val10;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7:	<ul class="inline">	<li> 
!read oef/embed.phtml r1,180x30 
$()</li>	<li> 
!read oef/embed.phtml r2,180x30 
$()</li>	</ul>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=2
