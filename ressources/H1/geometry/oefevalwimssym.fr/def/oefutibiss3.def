!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 8

val6=$[rint($(tmp0)*10)]
val7=$[rint($val6*2)]
!readproc oef/draw.phtml 400,200 \
xrange -10,10	yrange -1,10	segment 0,0,cos($val6*pi/180)*9,sin($val6*pi/180)*9,black	arc 0,0,2,2,0,$val6,red	arc 0,0,4,4,$val6,$val7,red	segment cos(($val6/2)*pi/180)*0.7,sin(($val6/2)*pi/180)*0.7,cos(($val6/2)*pi/180)*1.3,sin(($val6/2)*pi/180)*1.3,red	segment cos(($val7*0.75)*pi/180)*1.6,sin(($val7*0.75)*pi/180)*1.6,cos(($val7*0.75)*pi/180)*2.4,sin(($val7*0.75)*pi/180)*2.4,red	text black,cos(($val6+8)*pi/180)*6,sin(($val6+8)*pi/180)*6,medium,E	segment cos(($val6)*pi/180)*5-0.2*sin(($val6)*pi/180),sin(($val6)*pi/180)*5+0.2*cos(($val6)*pi/180),cos(($val6)*pi/180)*5+0.2*sin(($val6)*pi/180),sin(($val6)*pi/180)*5-0.2*cos(($val6)*pi/180),black	segment 0,0,cos($val7*pi/180)*9,sin($val7*pi/180)*9,black	text black,cos(($val7+4)*pi/180)*5.4,sin(($val7+4)*pi/180)*6,medium,C	segment cos(($val7)*pi/180)*5-0.2*sin(($val7)*pi/180),sin(($val7)*pi/180)*5+0.2*cos(($val7)*pi/180),cos(($val7)*pi/180)*5+0.2*sin(($val7)*pi/180),sin(($val7)*pi/180)*5-0.2*cos(($val7)*pi/180),black	segment 0,0,9,0,black	segment 5,-0.2,5,0.2,black	text black,5,-0.4,medium,B	text black,-0.5,0,medium,A 
tmp0=$ins_url
val8=$(tmp0)
val9=$val8
val10=alors \(\widehat{BAE}) ,=,\(\widehat{EAC}).
val11=Si la demi-droite &#91;AE&#41; est la bissectrice ,de l'angle \(\widehat{BAC}) &#44;
val12=$val11
val13=$val10
replytype1=dragfill
replyname1=
replygood1=$val12
replytype2=dragfill
replyname2=
replygood2=$val13
