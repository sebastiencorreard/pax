!set title=Compléter une symétrie 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=symmetry
precision=1000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la construction avec les instruments de géométrie sur une feuille de brouillon	et répondre à la question :
tmp0=!randint 30, 55

val7=$[$(tmp0)]
tmp0=!randint 20, $val7-5

val8=$[$(tmp0)*2/10]
val7=$[$val7*2/10]
val9=$[sqrt($val8^2/4+$val7^2/4)]
val10=$[rint(sqrt($val7^2-($val7^4/(4*$val9^2)))*20)]
val11=$[($val10-1)/10]
val12=$[($val10+1)/10]
val13=<li>Tracer un losange ABCE tel que :	<div class="wimscenter">BE = $val7 cm et AC = $val8 cm.</div></li>	<li>Construire le losange BCRS, symétrique du losange ABCE par	rapport à la droite (BC).</li>
val14=Mesurer le segment ER.
val15=ER
replytype1=range
replyname1=
replygood1=!rawmath $val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6	<ul>	$val13	<li>$val14</li>	</ul>	<div class="wimscenter"><label for="reply1">$val15 =</label>	 
!read oef/embed.phtml r1,10 
$() cm.</div>	<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,13,14,15
embedcnt=1
