rapport à la droite (BC).</li>}
\text{enonc3=Mesurer le segment ER.}
\text{enonc4=ER}


\title{Compléter une symétrie 5}

\statement{
\enonc1
<ul>
\enonc2
<li>\enonc3</li>
</ul>
<div class="wimscenter"><label for="reply1">\enonc4 =</label>
