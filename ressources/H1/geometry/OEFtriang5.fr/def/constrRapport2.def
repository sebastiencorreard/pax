!set title=Parallélogramme (angles et rapporteur)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=r
varcnt=3
prevarcnt=2
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4, 10

val6=$[rint($(tmp0)*10)]
val7=height=500	width=1500	showToolBar=true	enableRightClick=true	customToolBar=0|40|5	angle=$val6 °	file=rapport1.ggb
replytype1=geogebra

replyoption1=norebuild  extra=yes output=nocoord max=125 ignore=  weights=1&1&8 
replyname1=Vérification des coordonnées :
replygood1=f,D=point,Le point D est-il construit ?;	n,abs((y_B-y_A)-(y_C-y_D))<0.7 && abs((x_B-x_A)-(x_C-x_D))<0.7,Le point D est-il bien placé ?
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()On a commencé la construction d'un parallélogramme ABCD.	Placer correctement le point D à l'intersection	des demi-droites &#91;AI&#41; et &#91;CJ&#41;.	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val7 
$()	</div>	
$()
!exit

