!set title=Construction (angles et rapporteur)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$[rint($(tmp0)*10)]
tmp0=!randint 7, 11

val7=$[rint($(tmp0)*10)]
val8=height=400	width=600	showToolBar=true	enableRightClick=false	customToolBar=0|40|5	file=rapport.ggb
replytype1=geogebra

replyoption1=extra=yes output=nocoord max=125 ignore=H&D weights=1&1&8 
replyname1=Vérification des angles :
replygood1=f,C=point,Le point C est-il construit ?;	n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_B+i*y_B-x_J-i*y_J)))-$val7)<5,L'angle de sommet B mesure-t-il <b>environ</b> $val7 ° ?;	n,abs(abs(180/pi*arg((x_A+i*y_A-x_B-i*y_B)/(x_A+i*y_A-x_I-i*y_I)))-$val6)<5,L'angle de sommet A mesure-t-il <b>environ</b> $val6 ° ?
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Placer le point C à l'intersection des demi-droites &#91;AI&#41; et &#91;BJ&#41;	tel que :	<div class="wimscenter">
!insmath \widehat{BAC}
$() mesure environ $val6° et	
!insmath \widehat{ABC}
$() mesure environ $val7°.	</div>	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val8 
$()	</div>	<div class="wims_instruction">	Tolérance sur les mesures d'angles : 5° en plus ou en moins.	<br/>	Pour déplacer le rapporteur, déplacer le point rouge (H).	<br/>	Pour faire tourner le rapporteur, déplacer le point vert (D).	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
