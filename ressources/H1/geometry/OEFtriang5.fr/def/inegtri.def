!set title=Inégalité triangulaire.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 3

val6=$[rint($(tmp0))]
tmp0=!randint 5, 20

val7=$[rint($(tmp0))]
tmp0=!randint $val7, 30

val8=$[rint($(tmp0))]
tmp0=!randint $val8+1, $val7+$val8-1

tmp1=!randint $val7+$val8+1, 60

tmp2=!item $val6 of $(tmp0),$val7+$val8,$(tmp1)

val9=$[rint($(tmp2))]
tmp0=!shuffle $val7,$val8,$val9

val10=$(tmp0)
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val11=$(tmp0)
val12=Oui : il est possible à construire., Non : il est aplati en un segment.,Non : il est impossible à construire.
tmp0=!item $val6 of $val12

val13=$(tmp0)
choicename1=
choicegood1=$val13
choicebad1=$val12
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11 dit qu'il a tracé un triangle dont les longueurs des côtés mesurent :	<div class="wimscenter">$(val10[1]) cm, $(val10[2]) cm et $(val10[3]) cm.</div>	Je ne suis pas sûr que $val11 ait bien tracé son triangle...	<p>Ce triangle est-il possible à construire ?</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()La bonne réponse était : "$val13"	 En effet :	<br /> 
!if $val6=1 
$()$val7+$val8>$val9 <br />$val7+$val9>$val8 <br />et $val9+$val8>$val7 <br />donc les trois longueurs des côtés vérifient la propriété de l'inégalité triangulaire. 
!else
$()	 
!if $val6=2 
$()$val7+$val8=$val9 <br />donc les trois sommets du triangle sont des points alignés. 
!else
$()	 $val7+$val8<$val9 <br />donc les trois longueurs ne vérifient pas la propriété de l'inégalité triangulaire. 
!endif
$() 
!endif
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,11,13
embedcnt=0
