!set title=Construction (angles)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=r
varcnt=6
prevarcnt=4
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 50

val6=$[rint($(tmp0))]
tmp0=!randint 70, 110

val7=$[rint($(tmp0))]
val8=$[rint($val7-$val6)]
val9=height=400	width=700	showToolBar=true	enableRightClick=true	customToolBar=0|40|1|5|15|46|18|6	file=blank2.ggb	
replytype1=geogebra

replyoption1=output=nocoord extra=yes max=15 
replyname1=Vérification des angles :
replygood1=n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_B+i*y_B-x_C-i*y_C)))+abs(180/pi*arg((x_A+i*y_A-x_B-i*y_B)/(x_A+i*y_A-x_C-i*y_C)))-$val7-$val6)<20,Les angles sont-ils <b>approximativement</b> corrects ?;	n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_B+i*y_B-x_C-i*y_C)))-$val7)<0.001,L'angle de sommet B mesure-t-il <b>précisément</b> $val7 ° ?;	n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_C+i*y_C-x_A-i*y_A)))-$val6)<0.001,L'angle de sommet A mesure-t-il <b>précisément</b> $val6 ° ?
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Construire un triangle ABC tel que :		<div class="wimscenter">
!insmath \widehat{A}
$()=$val6° et 
!insmath \widehat{B}
$()=$val7° </div>	<div class="wimscenter">	 
!read oef/embed.phtml r1, 600 x 400	$val9 
$()	</div>	<div class="wims_instruction">	Pour renommer un point, il faut cliquer-droit dessus et choisir le menu <span class="tt">	renommer</span>.</div>			
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!text mark c,=,p in $m_reply1

val10=$(tmp0)

!exit

:feedback
!ifval 111 isin $val10
 <div class='oef_feedbacks'><font color=red>Attention : le point s'appelle "C majuscule" et pas "c minuscule" !</font>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,9
embedcnt=1
