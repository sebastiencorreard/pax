val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 13, 29

val8=$[rint($(tmp0)*2)]
val9=$[rint((180-$val8)/2)]
val10=$[rint(120-$val9)]
val11=$[rint(90-$val10)]
tmp0=!randitem 20,-10,170,200

val12=$[rint($(tmp0))]

!ifval $val12>30 
val13= 1.5,1.25 
!else
val13= 0,0
!endif

!ifval $val12>30 
val14= -0.2 
!else
val14= 0
