\title{Construction (longueur des côtés)}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\text{a=shuffle(5)}
\integer{b=\a[2]}
\integer{a=\a[1]}
\integer{c= \b<\a ? randint(\a-\b+1..\a+\b-1) : randint(\b-\a+1..\a+\b-1)}

\text{appletoption=height=400
width=600
showToolBar=true
enableRightClick=true
customToolBar=0|40|1|34|45|16|6
file=blank2.ggb
}

\text{enonce=Tracer un triangle dont les longueurs des côtés vérifient
<div class="wimscenter">\( AB = \c), \(AC = \b) et \(BC = \a) </div>}

\statement{\enonce

<div class="wimscenter">
\embed{r1, 600 x 400
\appletoption}
</div>
}

\answer{Vérification des longueurs : }{n,abs((x_A-x_B)^2+(y_A-y_B)^2-\c^2)<10^(-5),La longueur AB est-elle égale à \c ?;
n,abs((x_A-x_C)^2+(y_A-y_C)^2-\b^2)<10^(-5),La longueur AC est-elle égale à \b ? ;
n,abs((x_C-x_B)^2+(y_C-y_B)^2-\a^2)<10^(-5),La longueur BC est-elle égale à \a ?;
n,abs((x_A-x_B)^2+(y_A-y_B)^2-\c^2)+abs((x_A-x_C)^2+(y_A-y_C)^2-\b^2)+abs((x_C-x_B)^2+(y_C-y_B)^2-\a^2)<4,hiden}{type=geogebra}
{option=output=nocoord extra=yes}

\feedback{circle notin \reply1}{<font color=red>Pensez à utiliser des cercles !</font>}
\matrix{test=\sc_reply1}
\feedback{\test[1;1]<>1 and \test[2;4]=1}{<font color=red>L'un des points doit être à l'intersection de deux cercles.</font>
<br>On ne doit pas pouvoir déplacer ce point, sauf si on déplace les autres points et les cercles.}
