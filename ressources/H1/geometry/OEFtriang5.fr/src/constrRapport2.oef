\statement{On a commencé la construction d'un parallélogramme ABCD.
Placer correctement le point D à l'intersection
des demi-droites &#91;AI&#41; et &#91;CJ&#41;.
<div class="wimscenter">
\embed{r1, 600 x 400
\appletoption}
</div>
}

\answer{Vérification des coordonnées : }{f,D=point,Le point D est-il construit ?;
n,abs((y_B-y_A)-(y_C-y_D))<0.7 && abs((x_B-x_A)-(x_C-x_D))<0.7,Le point D est-il bien placé ?}{type=geogebra}{option=norebuild  extra=yes output=nocoord max=125 ignore=  weights=1&1&8}
