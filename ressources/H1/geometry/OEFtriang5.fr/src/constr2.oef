\title{Construction (angles)}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\integer{a=randint(10..50)}
\integer{b=randint(70..110)}
\integer{c=\b-\a}

\text{appletoption=height=400
width=700
showToolBar=true
enableRightClick=true
customToolBar=0|40|1|5|15|46|18|6
file=blank2.ggb
}

\statement{Construire un triangle ABC tel que :

<div class="wimscenter">\(\widehat{A})=\a° et \(\widehat{B})=\b° </div>
<div class="wimscenter">
\embed{r1, 600 x 400
\appletoption}
</div>
<div class="wims_instruction">
Pour renommer un point, il faut cliquer-droit dessus et choisir le menu <span class="tt">
renommer</span>.</div>


}

\answer{Vérification des angles : }{n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_B+i*y_B-x_C-i*y_C)))+abs(180/pi*arg((x_A+i*y_A-x_B-i*y_B)/(x_A+i*y_A-x_C-i*y_C)))-\b-\a)<20,Les angles sont-ils <b>approximativement</b> corrects ?;
n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_B+i*y_B-x_C-i*y_C)))-\b)<0.001,L'angle de sommet B mesure-t-il <b>précisément</b> \b ° ?;
n,abs(abs(180/pi*arg((x_B+i*y_B-x_A-i*y_A)/(x_C+i*y_C-x_A-i*y_A)))-\a)<0.001,L'angle de sommet A mesure-t-il <b>précisément</b> \a ° ?}{type=geogebra}
{option=output=nocoord extra=yes max=15}
\text{test=wims(text mark c,=,p in \reply1)}
\feedback{111 isin \test}{<font color=red>Attention : le point s'appelle "C majuscule" et pas "c minuscule" !</font>}
