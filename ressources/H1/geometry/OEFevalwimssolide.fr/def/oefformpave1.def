!set title=Formules de volume 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Volume du parallélépipède rectangle
val8=longueur \(\times\) largeur \(\times\) hauteur
val9=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du triangle,	  Aire du rectangle,	  Volume du cube
val10=Mettez en relation&nbsp;
val11=longueur,largeur,hauteur,côté
val12=70x200x270
val13=2 \(\times) $(val11[1]) + 2 \(\times) $(val11[2]),	4 \(\times) $(val11[4]),	$(val11[4]) \(\times) $(val11[4]),	base \(\times) $(val11[3]) \(\div) 2,	$(val11[1]) \(\times) $(val11[2]),	$(val11[4]) \(\times) $(val11[4]) \(\times) $(val11[4])
tmp0=!shuffle 6

val14=$(tmp0)
val15=$(val9[$(val14[1])]),$(val9[$(val14[2])]),$(val9[$(val14[3])]),$val7
val16=$(val13[$(val14[1])]),$(val13[$(val14[2])]),$(val13[$(val14[3])]),$val8
replytype1=correspond
replyname1=
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val10:	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val12 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,12
embedcnt=1
