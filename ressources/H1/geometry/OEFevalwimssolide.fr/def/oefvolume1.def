!set title=Volume 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nous avons un cube de, cm de côté.
val8=Le volume du cube est de&nbsp;
tmp0=!randint 1, 9

val9=$[rint($(tmp0))]
val10=$[rint($val9*10)]
val11=$[rint($val9*10)]
val12=$[rint($val9*5)]
val13=$[rint($val10+$val12)]
val14=$[rint($val11+$val12)]
val15=$[rint($val9*$val9*$val9)]
val16=$[rint(4)]
!readproc oef/draw.phtml 340,300 \
rect 170-$val13/2,130+$val14/2,170+$val13/2-$val12,130-$val14/2+$val12,black	segment 170+$val13/2-$val10,130-$val14/2,170+$val13/2,130-$val14/2,black	segment 170+$val13/2-$val10,130-$val14/2,170+$val13/2-$val10-$val12,130-$val14/2+$val12,black	segment 170+$val13/2,130-$val14/2,170+$val13/2-$val12,130-$val14/2+$val12,black	segment 170+$val13/2,130-$val14/2,170+$val13/2,130-$val14/2+$val11,black	segment 170+$val13/2-$val12,130-$val14/2+$val12+$val11,170+$val13/2,130-$val14/2+$val11,black	dsegment 170+$val13/2-$val10,130-$val14/2+$val11,170+$val13/2,130-$val14/2+$val11,black	dsegment 170+$val13/2-$val10,130-$val14/2+$val11,170+$val13/2-$val10-$val12,130-$val14/2+$val11+$val12,black	dsegment 170+$val13/2-$val10,130-$val14/2+$val11,170+$val13/2-$val10,130-$val14/2,black	 
tmp0=$ins_url
val17=$(tmp0)
val18=$(val7[1]) $val9 cm $(val7[2])
val19=$val8
val20=\(\mathrm{cm}^3\)
replytype1=numeric
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_columns">	  <div class="medium_size img_col"><img src="$val17" alt=""></div>	  <div class="medium_size text_col">	  $val18 <label for="reply1">$val19:</label>  
!read oef/embed.phtml r1,$val16 
$() $val20:	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
