!set title=Conversions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Convertir&nbsp;
val8=\(\mathrm{m}^3),\(\mathrm{dm}^3),\(\mathrm{cm}^3),\(\mathrm{mm}^3)
val9=\(\mathrm{hL}),\(\mathrm{daL}),\(\mathrm{L}),\(\mathrm{dL}),\(\mathrm{cL}),\(\mathrm{mL})
tmp0=!randint 1, 9

val10=$[rint($(tmp0))]
tmp0=!randint 1, 3

val11=$[rint($(tmp0))]
!if $val11=1 
tmp0=!randint 1, 6

val12=$[rint($(tmp0))]
!else
tmp0=!randint ($val11-1)*3, 6

val12=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 9

val13=$[rint($(tmp0))]
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
!if $val14=1 
tmp0=!randint 1, 6

val15=$[rint($(tmp0))]
!else
tmp0=!randint ($val14-1)*3, 6

val15=$[rint($(tmp0))]
!endif
val16=$[$val10*10^($val12-3*($val11-1))]
val17=$[$val13*10^($val15-3*($val14-1))]
replytype1=numeric
replyname1=
replygood1=$[$val16]
replytype2=numeric
replyname2=
replygood2=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7:	<ul><li><label for="reply1">$val10 $(val8[$val11]) =</label>  
!read oef/embed.phtml r1,10 
$() $(val9[$val12])	</li><li><label for="reply2">$val13 $(val8[$val14]) =</label>  
!read oef/embed.phtml r2,10 
$() $(val9[$val15])	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11,12,13,14,15
embedcnt=2
