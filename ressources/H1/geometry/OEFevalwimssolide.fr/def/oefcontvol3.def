!set title=Contenance de volumes 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Choisir la bonne valeur&nbsp;
val8=\(\textrm{km}^3),\(\textrm{hm}^3),\(\textrm{dam}^3),\(\textrm{m}^3),\(\textrm{dm}^3),\(\textrm{cm}^3),\(\textrm{mm}^3)
val9=\(\textrm{hL}),\(\textrm{daL}),\(\textrm{L}),\(\textrm{dL}),\(\textrm{cL}),\(\textrm{mL})
val10=menu
tmp0=!randitem 6,7

val11=$[rint($(tmp0))]
val12=1,10,100,1 000,10 000,100 000,1 000 000
val13=$val7: 1 L = 
val14=$(val8[$val11])
!if $val11=6 
val11=$[rint(4)]
!endif
val15=$val11;$val12
val16=$[rint(10)]
replytype1=$val10

replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13	
!if $val10=correspond 
$()<div class="wimscenter"> 
!endif
$()	 
!read oef/embed.phtml r1,$val16 
$()	
!if $val10=correspond 
$()</div> 
!endif
$()	$val14	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,13,14,16
embedcnt=1
