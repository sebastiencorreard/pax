!set title=Construction d'un patron 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 20, 75

val7=$[rint($(tmp0))]
tmp0=!randint 30, 100-$val7

val8=$[rint($(tmp0))]
tmp0=!randint $val8, 270-2*$val8

val9=$[rint($(tmp0))]
val10=$[rint((340-$val9-2*$val7)/2)]
val11=$[rint(150+$val8+$val7)]
!readproc oef/draw.phtml 340,300 \
arrow2 0,20,340,20,10,black	text black,100,5,medium,Longueur de la feuille	arrow2 10,0,10,300,10,black	text black,15,280,medium,Hauteur de la feuille	rect $val10+$val7,$val11,$val10+$val7+$val9,$val11-$val8,black	arrow2 $val10+$val7,$val11+10,$val10+$val7+$val9,$val11+10,10,black	text black,$val10+$val7+$val9/2,$val11+15,medium,a	rect $val10+$val7+$val9,$val11-$val8,$val10+$val7,$val11-$val8-$val7,black	arrow2 $val10+$val7+$val9+10,$val11-$val8,$val10+$val7+$val9+10,$val11-$val8-$val7,10,black	text black,$val10+$val7+$val9+20,$val11-$val8-$val7/2-5,medium,c	rect $val10+$val7,$val11-$val8-$val7,$val10,$val11-$val7-2*$val8,black	arrow2 $val10+$val7-10,$val11,$val10+$val7-10,$val11-$val8,10,black	text black,$val10+$val7-25,$val11-$val8/2-5,medium,b	rect $val10+$val7,$val11-$val8-$val7,$val10+$val7+$val9,$val11-$val7-2*$val8,black	rect $val10+$val7+$val9,$val11-$val7-2*$val8,$val10+2*$val7+$val9,$val11-$val7-$val8,black	rect $val10+$val7+$val9,$val11-$val7-2*$val8,$val10+$val7,$val11-2*$val8-2*$val7,black	 
tmp0=$ins_url
val12=$(tmp0)
val13=<img src="$val12" alt="">
val14=$[rint(($val7+$val8)*2)]
val15=$[rint($val9+$val7*2)]
replytype1=raw
replyname1=
replygood1=$val15
replytype2=raw
replyname2=
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val13</div>	 <div class="medium_size text_col">	Nous avons le patron d'un parallélépipède rectangle.	Nous avons les dimensions suivantes :	<ul><li>a = $val9 mm	</li><li> b = $val8 mm	</li><li> c = $val7 mm	</li></ul>	Nous ne faisons pas de languette pour le collage.	Trouver les dimensions minima de la feuille de papier :	<ul><li><label for="reply1">Longueur minimum de la feuille :</label>  
!read oef/embed.phtml r1,5 
$() mm	</li><li><label for="reply2">Hauteur minimum de la feuille :</label> 
!read oef/embed.phtml r2,5 
$() mm	</li></ul>	</div></div>	
$()
!exit

