!set title=Contenance de volumes 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Mettre en relation&nbsp;
val8=correspond
tmp0=!randitem 4,5

val9=$[rint($(tmp0))]
tmp0=!randitem 3,4,5,6

val10=$[rint($(tmp0))]
val11=1 \(\textrm{m}^3\),100 \(\textrm{dm}^3\),10 \(\textrm{dm}^3\),1 \(\textrm{dm}^3\),100 \(\textrm{cm}^3\),10 \(\textrm{cm}^3\),1 \(\textrm{cm}^3\)
val12=1 000 L,100 L,10 L,1 L,1 dL,1 cL,1 mL
tmp0=!shuffle 7

val13=$(tmp0)
val14=$val7
val15=$(val11[$(val13[1])]),$(val11[$(val13[2])]),$(val11[$(val13[3])]),$(val11[$(val13[4])])
val16=$(val12[$(val13[1])]),$(val12[$(val13[2])]),$(val12[$(val13[3])]),$(val12[$(val13[4])])
val17=$val15;$val16
val18=$[rint(100x30)]
replytype1=$val8

replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14	
!if $val8=correspond 
$()<div class="wimscenter"> 
!endif
$()	 
!read oef/embed.phtml r1,$val18 
$()	
!if $val8=correspond 
$()</div> 
!endif
$()	$m_enonc2	
$()
!exit

