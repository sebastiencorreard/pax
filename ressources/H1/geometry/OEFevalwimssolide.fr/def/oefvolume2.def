!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Le volume du parallélépipède rectangle est de&nbsp;
val8=Nous avons un parallélépipède rectangle fabriqué à l'aide de cubes identiques.	  Chaque cube mesure 1 cm de côté.
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
tmp0=!randint 2, 9

val10=$[rint($(tmp0))]
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
val12=$[rint(20)]
val13=$[rint(170-($val9+$val10/2)*10)]
val14=$[rint(150+($val11+$val10/2)*10)]
val15=$[rint($val9*$val10*$val11)]
val16=$[rint(4)]
val17=
!for val18 =1 to $val11 
val19=$[rint($val18)]
!for val20 =0 to $val9-1 
val21=square $val13+20*$val20,$val14-$val19*$val12,$val12,black
val17=$val17	$val21
!next
val17=$val17	$val21
!next
val13=$[rint(170-($val9+$val10/2)*10+$val9*20)]
val14=$[rint(150+($val11+$val10/2)*10)]
val22=
!for val18 =1 to $val11 
val19=$[rint($val18)]
!for val20 =0 to $val10-1 
val23=poly black,$val13+10*$val20,$val14-$val19*$val12-10*$val20,$val13+10*$val20+10,$val14-$val19*$val12-10-10*$val20,$val13+10*$val20+10,$val14-$val19*$val12+10-10*$val20,$val13+10*$val20,$val14-$val19*$val12+20-10*$val20
val22=$val22	$val23
!next
val22=$val22	$val23
!next
val13=$[rint(170-($val9+$val10/2)*10)]
val14=$[rint(150+($val11+$val10/2)*10-20*$val11)]
val24=
!for val18 =0 to $val10-1 
val19=$[rint($val18)]
!for val20 =0 to $val9-1 
val25=poly black,$val13+20*$val20+10*$val18,$val14-$val19*($val12/2),$val13+20*$val20+10+10*$val18,$val14-$val19*($val12/2)-10,$val13+20*$val20+30+10*$val18,$val14-$val19*($val12/2)-10,$val13+20*$val20+20+10*$val18,$val14-$val19*($val12/2)
val24=$val24	$val25
!next
val24=$val24	$val25
!next
!readproc oef/draw.phtml 340,300 \
$val24	$val22	$val17	 
tmp0=$ins_url
