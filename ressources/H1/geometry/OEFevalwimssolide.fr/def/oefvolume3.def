!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Le volume du parallélépipède rectangle est de&nbsp;
val8=Nous avons un parallélépipède rectangle fabriqué à l'aide de cubes identiques.	  Chaque cube mesure ,de côté.
tmp0=!randint 2, 9

val9=$[rint($(tmp0))]
tmp0=!randint 2, 9

val10=$[rint($(tmp0))]
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
val13=$[rint(20)]
val14=$[rint(170-($val9+$val10/2)*10)]
val15=$[rint(150+($val11+$val10/2)*10)]
val16=$[rint($val9*$val10*$val11*$val12^3)]
val17=$[rint(6)]
val18=
!for val19 =1 to $val11 
val20=$[rint($val19)]
!for val21 =0 to $val9-1 
val22=square $val14+20*$val21,$val15-$val20*$val13,$val13,black
val18=$val18	$val22
!next
val18=$val18	$val22
!next
val14=$[rint(170-($val9+$val10/2)*10+$val9*20)]
val15=$[rint(150+($val11+$val10/2)*10)]
val23=
!for val19 =1 to $val11 
val20=$[rint($val19)]
!for val21 =0 to $val10-1 
val24=poly black,$val14+10*$val21,$val15-$val20*$val13-10*$val21,$val14+10*$val21+10,$val15-$val20*$val13-10-10*$val21,$val14+10*$val21+10,$val15-$val20*$val13+10-10*$val21,$val14+10*$val21,$val15-$val20*$val13+20-10*$val21
val23=$val23	$val24
!next
val23=$val23	$val24
!next
val14=$[rint(170-($val9+$val10/2)*10)]
val15=$[rint(150+($val11+$val10/2)*10-20*$val11)]
val25=
!for val19 =0 to $val10-1 
val20=$[rint($val19)]
!for val21 =0 to $val9-1 
val26=poly black,$val14+20*$val21+10*$val19,$val15-$val20*($val13/2),$val14+20*$val21+10+10*$val19,$val15-$val20*($val13/2)-10,$val14+20*$val21+30+10*$val19,$val15-$val20*($val13/2)-10,$val14+20*$val21+20+10*$val19,$val15-$val20*($val13/2)
val25=$val25	$val26
!next
val25=$val25	$val26
!next
!readproc oef/draw.phtml 340,300 \
$val25	$val23	$val18	 
tmp0=$ins_url
