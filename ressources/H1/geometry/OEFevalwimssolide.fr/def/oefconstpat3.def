val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=longueur,largeur,diamètre, rayon, hauteur
tmp0=!randint 10, 37

val8=$[rint($(tmp0)*2)]
tmp0=!randint 30, 100-$val8

val9=$[rint($(tmp0))]
tmp0=!randint $val9, 270-2*$val9

val10=$[rint($(tmp0))]
val11=$[rint($val10+$val8)]
val12=$[rint($val9+$val8)]
val13=$[rint($val8/2)]
!readproc oef/draw.phtml 340,300 \
frect 170-$val11/2+$val13,130+$val12/2-$val13,170+$val11/2-$val13,130-$val12/2+$val13,yellow	rect 170-$val11/2+$val13,130+$val12/2-$val13,170+$val11/2-$val13,130-$val12/2+$val13,black	segment 170+$val11/2-$val10,130-$val12/2,170+$val11/2,130-$val12/2,black	segment 170+$val11/2-$val10,130-$val12/2,170+$val11/2-$val10-$val13,130-$val12/2+$val13,black	segment 170+$val11/2,130-$val12/2,170+$val11/2-$val13,130-$val12/2+$val13,black	segment 170+$val11/2,130-$val12/2,170+$val11/2,130-$val12/2+$val9,black	segment 170+$val11/2-$val13,130-$val12/2+$val13+$val9,170+$val11/2,130-$val12/2+$val9,black	dsegment 170+$val11/2-$val10,130-$val12/2+$val9,170+$val11/2,130-$val12/2+$val9,black	dsegment 170+$val11/2-$val10,130-$val12/2+$val9,170+$val11/2-$val10-$val13,130-$val12/2+$val9+$val13,black	dsegment 170+$val11/2-$val10,130-$val12/2+$val9,170+$val11/2-$val10,130-$val12/2,black	 
tmp0=$ins_url
val14=$(tmp0)
val11=$[rint((340-$val10-2*$val8)/2)]
val12=$[rint(150+$val9+$val8)]
!readproc oef/draw.phtml 340,300 \
frect $val11+$val8,$val12,$val11+$val8+$val10,$val12-$val9,yellow	rect $val11+$val8,$val12,$val11+$val8+$val10,$val12-$val9,black	arrow2 $val11+$val8,$val12+10,$val11+$val8+$val10,$val12+10,10,black	text black,$val11+$val8+$val10/2,$val12+15,medium,a	rect $val11+$val8+$val10,$val12-$val9,$val11+$val8,$val12-$val9-$val8,black	arrow2 $val11+$val8+$val10+10,$val12-$val9,$val11+$val8+$val10+10,$val12-$val9-$val8,10,black	text black,$val11+$val8+$val10+20,$val12-$val9-$val8/2-5,medium,c	rect $val11+$val8,$val12-$val9-$val8,$val11,$val12-$val8-2*$val9,black	arrow2 $val11+$val8-10,$val12,$val11+$val8-10,$val12-$val9,10,black	text black,$val11+$val8-25,$val12-$val9/2-5,medium,b	rect $val11+$val8,$val12-$val9-$val8,$val11+$val8+$val10,$val12-$val8-2*$val9,black	rect $val11+$val8+$val10,$val12-$val8-2*$val9,$val11+2*$val8+$val10,$val12-$val8-$val9,black	rect $val11+$val8+$val10,$val12-$val8-2*$val9,$val11+$val8,$val12-2*$val9-2*$val8,black	 
tmp0=$ins_url
val15=$(tmp0)
val16=<img src="$val15" alt="">
val17=<img src="$val14" alt="">
val18=$[rint(($val8+$val9)*2)]
val19=$[rint($val10+$val8*2)]
replytype1=raw
replyname1=
replygood1=$val10
replytype2=raw
replyname2=
replygood2=$val8
replytype3=raw
replyname3=
replygood3=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">$val17<br>$val16</div>	 <div class="medium_size text_col">	Nous avons un parallélépipède rectangle et le dessin de son patron.	Le parallélépipède a les dimensions suivantes :	<ul><li> $(val7[1]) : $val10 mm	</li><li> $(val7[2]) &nbsp; : $val9 mm	</li><li> $(val7[3]) &nbsp; : $val8 mm	</li></ul>	Trouver les dimensions du patron :	<ul><li><label for="reply1">a =</label>  
!read oef/embed.phtml r1,5 
$() mm	</li><li><label for="reply2">b = </label> 
!read oef/embed.phtml r2,5 
$() mm	</li><li><label for="reply3">c =</label>  
!read oef/embed.phtml r3,5 
$() mm	</li></ul>	</div></div>	
$()
