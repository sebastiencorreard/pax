!set title=Formules de volume 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Volume du parallélépipède rectangle
val8=Mettez en relation&nbsp;
val9=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du triangle,	  Aire du rectangle,	  Volume du cube
val10=70x200x270
val11=2 \(\times) L + 2 \(\times) l,	4 \(\times) c,	c \(\times)  c,	b \(\times) h \(\div) 2,	L \(\times) l,	c \(\times)  c \(\times)  c
val12=L \(\times) l \(\times) h
tmp0=!shuffle 6

val13=$(tmp0)
val14=$(val9[$(val13[1])]),$(val9[$(val13[2])]),$(val9[$(val13[3])]),$val7
val15=$(val11[$(val13[1])]),$(val11[$(val13[2])]),$(val11[$(val13[3])]),$val12
replytype1=correspond
replyname1=
replygood1=$val14;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8:	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val10 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=1
