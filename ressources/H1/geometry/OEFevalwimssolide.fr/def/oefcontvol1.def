!set title=Contenance de volumes 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Choisir la bonne unité&nbsp;
val8=\(\textrm{km}^3),\(\textrm{hm}^3),\(\textrm{dam}^3),\(\textrm{m}^3),\(\textrm{dm}^3),\(\textrm{cm}^3),\(\textrm{mm}^3)
val9=\(\textrm{hL}),\(\textrm{daL}),\(\textrm{L}),\(\textrm{dL}),\(\textrm{cL}),\(\textrm{mL})
val10=$val7: 1 L = 1 
val11=click
val12=5;$val8
val13=$[rint(10)]
replytype1=$val11

replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	
!if $val11=correspond 
$()<div class="wimscenter"> 
!endif
$()	 
!read oef/embed.phtml r1,$val13 
$()	
!if $val11=correspond 
$()</div> 
!endif
$()	$m_enonc2	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,13
embedcnt=1
