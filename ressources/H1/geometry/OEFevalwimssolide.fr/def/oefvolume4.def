!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Le volume du parallélépipède rectangle est de&nbsp;
val8=Nous avons un parallélépipède rectangle.	  Sa longueur mesure, sa largeur , et sa hauteur 
tmp0=!randint 17, 99

val9=$[rint($(tmp0))]
tmp0=!randint 6, $val9-10

val10=$[rint($(tmp0))]
tmp0=!randint 2, 49

val11=$[rint($(tmp0))]
val12=$[rint($val9*$val10*$val11)]
val13=$[rint(6)]
val14=$(val8[1]) $val9 cm, $(val8[2]) $val10 cm $(val8[3]) $val11 cm.
val15=$val7
val16=$[rint(120)]
val17=$[rint(60)]
val18=$[rint(50)]
val19=$[rint($val16+$val18)]
val20=$[rint($val17+$val18)]
!readproc oef/draw.phtml 200,180 \
rect 100-$val19/2,80+$val20/2,100+$val19/2-$val18,80-$val20/2+$val18,black	segment 100+$val19/2-$val16,80-$val20/2,100+$val19/2,80-$val20/2,black	segment 100+$val19/2-$val16,80-$val20/2,100+$val19/2-$val16-$val18,80-$val20/2+$val18,black	segment 100+$val19/2,80-$val20/2,100+$val19/2-$val18,80-$val20/2+$val18,black	segment 100+$val19/2,80-$val20/2,100+$val19/2,80-$val20/2+$val17,black	segment 100+$val19/2-$val18,80-$val20/2+$val18+$val17,100+$val19/2,80-$val20/2+$val17,black	dsegment 100+$val19/2-$val16,80-$val20/2+$val17,100+$val19/2,80-$val20/2+$val17,black	dsegment 100+$val19/2-$val16,80-$val20/2+$val17,100+$val19/2-$val16-$val18,80-$val20/2+$val17+$val18,black	dsegment 100+$val19/2-$val16,80-$val20/2+$val17,100+$val19/2-$val16,80-$val20/2,black	 
tmp0=$ins_url
val21=$(tmp0)
val22=\(\mathrm{cm}^3\)
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

