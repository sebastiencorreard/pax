val6=$(tmp0)
val7=Sur le patron du cube, marier les côtés pour le pliage en	  utilisant la même lettre&nbsp;
val8=black,white
val9=$[rint(80)]
val10=a,b,c
tmp0=!shuffle $val10

val10=$(tmp0)
tmp=!trim 1,2,3,6,10,14,120,310,160,20,215,230,80,125,120,150,80x20,160x360,290x70	1,2,6,7,11,12,35,70,295,155,90,20,170,205,200,240,240x280,320x180,320x280	2,5,6,10,11,14,295,235,250,180,120,320,120,240,90,205,210x80,210x150,30x150	1,2,6,10,11,15,120,230,295,310,250,365,120,150,90,125,30x70,160x20,80x20	1,2,6,10,14,15,40,70,90,20,170,20,90,125,120,150,110x230,110x310,160x360	3,7,8,10,11,14,250,20,380,150,330,200,200,150,170,180,110x310,160x360,290x230	2,5,6,7,11,12,165,20,295,150,90,205,90,100,120,70,370x230,320x180,240x280	2,5,6,7,8,11,165,20,295,235,40,155,120,75,90,100,320x100,320x200,370x150	
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 8

val12=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=
!for val15 =1 to 6 
val16=$[rint(floor(($(val13[$val15])-1)/4))]
val17=$[rint(50+($(val13[$val15])-4*$val16-1)*$val9)]
val18=$[rint(40+$val16*$val9)]
tmp0=!append item $val17 to $val14

val14=$(tmp0)
tmp0=!append item $val18 to $val14

val14=$(tmp0)
!next
val19=$(val13[17])
val20=$(val13[18])
val21=$(val13[19])
!readproc oef/draw.phtml 420,400 \
square $(val14[1]),$(val14[2]),$val9,$(val8[1])	square $(val14[3]),$(val14[4]),$val9,$(val8[1])	square $(val14[5]),$(val14[6]),$val9,$(val8[1])	square $(val14[7]),$(val14[8]),$val9,$(val8[1])	square $(val14[9]),$(val14[10]),$val9,$(val8[1])	square $(val14[11]),$(val14[12]),$val9,$(val8[1])	text black,$(val13[7]),$(val13[8]),large,$(val10[1])	text black,$(val13[9]),$(val13[10]),large,$(val10[2])	text black,$(val13[11]),$(val13[12]),large,$(val10[3])	text black,$(val13[13]),$(val13[14]),large,d	text black,$(val13[15]),$(val13[16]),large,d 
