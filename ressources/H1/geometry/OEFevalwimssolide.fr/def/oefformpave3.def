!set title=Formules de volume 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Nous avons un parallélépipède rectangle	  qui a pour longueur XXXX \(\textrm{cm}\), pour largeur YYYY \(\textrm{cm}\)	  et pour hauteur ZZZZ \(\textrm{cm}\).
val8=formule,longueur,largeur,hauteur
val9=Donner le volume du parallélépipède rectangle&nbsp;
tmp0=!randint 2, 9

val10=$[rint($(tmp0))]
tmp0=!randint 2, $val10

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
val13=$[rint($val10*$val11*$val12)]
tmp0=!replace internal XXXX by $val10 in $val7

val14=$(tmp0)
tmp0=!replace internal YYYY by $val11 in $val14

val14=$(tmp0)
tmp0=!replace internal ZZZZ by $val12 in $val14

val14=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14	<div class="wims_question">	<label for="reply1">$val9</label>	<div class="wimscenter"> 
!read oef/embed.phtml r1,7 
$() 
!insmath \textrm{cm}^3
$().</div>	</div>	<div class="wims_instruction">	$(val8[1])=$(val8[2]) 
!insmath \times
$() $(val8[3]) 
!insmath \times
$() $(val8[4])	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9,14
embedcnt=1
