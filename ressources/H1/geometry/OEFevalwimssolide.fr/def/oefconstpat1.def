!set title=Construction d'un patron 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=black,white
val8=$[rint(80)]
val9=a,b,c
tmp0=!shuffle $val9

val9=$(tmp0)
tmp=!trim 1,2,3,6,10,14,120,310,160,20,215,230,80,125,120,150,3,4	1,2,6,7,11,12,35,70,295,155,90,20,170,205,200,240,4,3	2,5,6,10,11,14,295,235,250,180,120,320,120,240,90,205,3,4	1,2,6,10,11,15,120,230,295,310,250,365,120,150,90,125,3,4	1,2,6,10,14,15,40,70,90,20,170,20,90,125,120,150,3,4	3,7,8,10,11,14,250,20,380,150,330,200,200,150,170,180,3,4	2,5,6,7,11,12,165,20,295,150,90,205,90,100,120,70,4,3	2,5,6,7,8,11,165,20,295,235,40,155,120,75,90,100,4,3	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 30, 120

val11=$[rint($(tmp0))]
tmp0=!randint 1, 8

val12=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
val14=$[rint($val11*$(val13[17]))]
val15=$[rint($val11*$(val13[18]))]
val16=
!for val17 =1 to 6 
val18=$[rint(floor(($(val13[$val17])-1)/4))]
val19=$[rint(50+($(val13[$val17])-4*$val18-1)*$val8)]
val20=$[rint(40+$val18*$val8)]
tmp0=!append item $val19 to $val16

val16=$(tmp0)
tmp0=!append item $val20 to $val16

val16=$(tmp0)
!next
!readproc oef/draw.phtml 420,400 \
arrow2 0,20,420,20,10,black	text black,100,5,medium,Longueur de la feuille	arrow2 10,0,10,400,10,black	text black,15,380,medium,Hauteur de la feuille	square $(val16[1]),$(val16[2]),$val8,$(val7[1])	square $(val16[3]),$(val16[4]),$val8,$(val7[1])	square $(val16[5]),$(val16[6]),$val8,$(val7[1])	square $(val16[7]),$(val16[8]),$val8,$(val7[1])	square $(val16[9]),$(val16[10]),$val8,$(val7[1])	square $(val16[11]),$(val16[12]),$val8,$(val7[1])	 
tmp0=$ins_url
val21=$(tmp0)
val22=<img src="$val21" alt="">
replytype1=raw
replyname1=
replygood1=$val14
replytype2=raw
replyname2=
replygood2=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val22</div>	 <div class="medium_size text_col">	Nous avons le patron d'un cube dont les côtés mesurent $val11 mm.	 Nous ne faisons pas de languette pour le collage.	<p>Trouver les dimensions minima de la feuille de papier :</p>	<ul><li><label for="reply1">Longueur minimum de la feuille :</label>  
!read oef/embed.phtml r1,5 
$() mm	</li><li><label for="reply2">Hauteur minimum de la feuille :</label>  
!read oef/embed.phtml r2,5 
$() mm	</li></ul></div></div>	
$()
!exit

