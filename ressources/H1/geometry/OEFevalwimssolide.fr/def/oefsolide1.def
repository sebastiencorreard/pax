!set title=Description de solides 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Le solide suivant est un parallélépipède rectangle&nbsp;
val8=$[rint(12)]
tmp=!trim src="$val1/pave1.jpg",6,8,12,1,6	src="$val1/pave2.jpg",6,8,12,1,6	src="$val1/pave3.jpg",6,8,12,1,6	src="$val1/pave4.jpg",6,8,12,1,6	src="$val1/pave5.jpg",6,8,12,1,6	src="$val1/cube1.jpg",6,8,12,1,6	src="$val1/prism1.jpg",5,6,9,2,3	src="$val1/prism2.jpg",7,10,15,2,5	src="$val1/prism3.jpg",8,12,18,2,6	src="$val1/pyram1.jpg",5,5,8,2,1	src="$val1/pyram2.jpg",4,4,6,2,0	src="$val1/pyram3.jpg",6,6,10,2,0	
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 12

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 1 of $(tmp0)

val11=$(tmp1)
val12=$val7
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!item 5 of $(tmp0)

val13=$(tmp1)
val14=oui,non,je ne sais pas
val15=radio
replytype1=$val15

replyname1=
replygood1=$val13;$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col"><img $val11 alt=""></div>	 <div class="medium_size text_col">$val12:  
!read oef/embed.phtml r1,\large 
$()</div>	 </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12
embedcnt=1
