!set title=Conversions de volumes 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Convertir&nbsp;
val8=\(\textrm{km}^3),\(\textrm{hm}^3),\(\textrm{dam}^3),\(\textrm{m}^3),\(\textrm{dm}^3),\(\textrm{cm}^3),\(\textrm{mm}^3)
tmp0=!randint 1, 3

val9=$[rint($(tmp0))]
tmp0=!randint 5-$val9, 8-$val9

val10=$[rint($(tmp0))]
tmp0=!randint 1111, 9999

val11=$[rint($(tmp0))]
val11=$[floor($val11/10^($val9-1))/10^$val10]
tmp0=!randint 1, 6

val12=$[rint($(tmp0))]
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
!if $val12+$val13>7 
val13=$[rint(1)]
tmp0=!randint 1, 5

val12=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 4

val14=$[rint($(tmp0))]
tmp0=!randint 1, $val14-1

val15=$[rint($(tmp0))]
tmp0=!randint 11111, 99999

val16=$[rint($(tmp0))]
val16=$[floor($val16/10^($val14-1))*10^$val15]
tmp0=!randint 2, 7

val17=$[rint($(tmp0))]
tmp0=!randint -3, -1

val18=$[rint($(tmp0))]
!if $val17+$val18<1 
val18=$[rint(-1)]
!endif
val19=$[$val11*10^($val13*3)]
val20=$[$val16*10^($val18*3)]
replytype1=numeric
replyname1=
replygood1=$[$val19]
replytype2=numeric
replyname2=
replygood2=$[$val20]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7:	<ul><li>	<label for="reply1">$val11 $(val8[$val12]) =</label>  
!read oef/embed.phtml r1,10 
$() $(val8[$val12+$val13])	</li><li><label for="reply2">$val16 $(val8[$val17]) =</label>  
!read oef/embed.phtml r2,10 
$() $(val8[$val17+$val18])	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,11,12,13,16,17,18
embedcnt=2
