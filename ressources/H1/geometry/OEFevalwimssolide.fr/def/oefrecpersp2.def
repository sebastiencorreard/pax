!set title=Parallélépipède 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Donner le nombre de faces,	  Donner le nombre d'arêtes,	  Donner le nombre de sommets,	  Les arêtes cachées sont représentées	
val8=oui,non
val9=Nous avons un cube
val10=src="$val1/Cubec.gif"
replytype1=raw
replyname1=
replygood1=6
replytype2=raw
replyname2=
replygood2=12
replytype3=raw
replyname3=
replygood3=8
replytype4=radio
replyname4=
replygood4=2;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col"><img $val10 alt=""></div>	 <div class="medium_size text_col">	$val9.	<ul><li><label for="reply1">$(val7[1]):</label>  
!read oef/embed.phtml r1,3 
$()	</li><li><label for="reply2">$(val7[2]):</label>  
!read oef/embed.phtml r2,3 
$()	</li><li><label for="reply3">$(val7[3]):</label>  
!read oef/embed.phtml r3,3 
$()	</li><li>$(val7[4]):  
!read oef/embed.phtml r4,3 
$()	</li></ul>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10
embedcnt=4
