!set title=Formules de volume 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Donner la formule pour calculer le volume d'un parallélépipède rectangle&nbsp;
val8=longueur,largeur,hauteur,diamètre, rayon
val9=100x40
val10=2,\(\times),$(val8[1]),$(val8[2]),4,\(\,\pi),$(val8[3]),$(val8[5]),$(val8[4])
val11=$(val8[1]),\(\times),$(val8[2]),\(\times),$(val8[3])	  |$(val8[1]),\(\times),$(val8[3]),\(\times),$(val8[2])	  |$(val8[2]),\(\times),$(val8[1]),\(\times),$(val8[3])	  |$(val8[2]),\(\times),$(val8[3]),\(\times),$(val8[1])	  |$(val8[3]),\(\times),$(val8[2]),\(\times),$(val8[1])	  |$(val8[3]),\(\times),$(val8[1]),\(\times),$(val8[2])	
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val11;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	<div class="wimscenter">	 
!read oef/embed.phtml r1,$val9 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=1
