\title{Construction d'un patron 3}

\text{name_long=longueur,largeur,diamètre, rayon, hauteur}

\integer{ha=randint(10..37)*2}
\integer{la=randint(30..100-\ha)}
\integer{lo=randint(\la..270-2*\la)}
\integer{xo=\lo+\ha}
\integer{yo=\la+\ha}
\integer{hb=\ha/2}
\text{pave=draw(340,300
frect 170-\xo/2+\hb,130+\yo/2-\hb,170+\xo/2-\hb,130-\yo/2+\hb,yellow
rect 170-\xo/2+\hb,130+\yo/2-\hb,170+\xo/2-\hb,130-\yo/2+\hb,black
segment 170+\xo/2-\lo,130-\yo/2,170+\xo/2,130-\yo/2,black
segment 170+\xo/2-\lo,130-\yo/2,170+\xo/2-\lo-\hb,130-\yo/2+\hb,black
segment 170+\xo/2,130-\yo/2,170+\xo/2-\hb,130-\yo/2+\hb,black
segment 170+\xo/2,130-\yo/2,170+\xo/2,130-\yo/2+\la,black
segment 170+\xo/2-\hb,130-\yo/2+\hb+\la,170+\xo/2,130-\yo/2+\la,black
dsegment 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2,130-\yo/2+\la,black
dsegment 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2-\lo-\hb,130-\yo/2+\la+\hb,black
dsegment 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2-\lo,130-\yo/2,black
)}
\integer{xo=(340-\lo-2*\ha)/2}
\integer{yo=150+\la+\ha}
\text{patron=draw(340,300
frect \xo+\ha,\yo,\xo+\ha+\lo,\yo-\la,yellow
rect \xo+\ha,\yo,\xo+\ha+\lo,\yo-\la,black
arrow2 \xo+\ha,\yo+10,\xo+\ha+\lo,\yo+10,10,black
text black,\xo+\ha+\lo/2,\yo+15,medium,a
rect \xo+\ha+\lo,\yo-\la,\xo+\ha,\yo-\la-\ha,black
arrow2 \xo+\ha+\lo+10,\yo-\la,\xo+\ha+\lo+10,\yo-\la-\ha,10,black
text black,\xo+\ha+\lo+20,\yo-\la-\ha/2-5,medium,c
rect \xo+\ha,\yo-\la-\ha,\xo,\yo-\ha-2*\la,black
arrow2 \xo+\ha-10,\yo,\xo+\ha-10,\yo-\la,10,black
text black,\xo+\ha-25,\yo-\la/2-5,medium,b
rect \xo+\ha,\yo-\la-\ha,\xo+\ha+\lo,\yo-\ha-2*\la,black
rect \xo+\ha+\lo,\yo-\ha-2*\la,\xo+2*\ha+\lo,\yo-\ha-\la,black
rect \xo+\ha+\lo,\yo-\ha-2*\la,\xo+\ha,\yo-2*\la-2*\ha,black
)}
\text{fig2=<img src="\patron" alt="">}
\text{fig1=<img src="\pave" alt="">}
\integer{rep2=(\ha+\la)*2}
\integer{rep1=\lo+\ha*2}
