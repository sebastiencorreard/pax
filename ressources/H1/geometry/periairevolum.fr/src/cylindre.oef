\language{fr}
\range{-5..5}
\author{Marie-Claude, David}
\email{mcld@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{100}
\title{Aire et volume d'un cylindre}
\keywords{area, volume}
\integer{n=random(1..4)}

\integer{m=random(10..99)}
\real{w=\m/10} petit volume
\integer{k=random(2..9)} coefficient multiplicateur
\integer{p=random(1..2)}
\text{unit=\(cm^3)}

choix entre le rayon et le diamètre
\integer{q=random(1,2)}
\text{RD= \q=1? rayon : diamètre}
\if{\n=1}{
	\if{\p=1}
		{\text{question=plus grande}
		\real{v=\w}
		\real{rep=\k*\w}
		}
	\if{\p=2}
		{\text{question= plus petite}
		\real{v=\k*\w}
		\real{rep=\w}
		}
	\text{enonce= Soit un cylindre à base circulaire de volume \(\v) \unit. Quel est, en \unit, le volume d'un second cylindre de même base et de hauteur \(\k) fois \question ? }
	\text{introrep=Volume du second cylindre en \unit}
}

\if{\n=2}{
		\if{\p=1}
		{\text{question=plus grand}
		\real{v=\w}
		\real{rep=\k^2*\w}
		}
	\if{\p=2}
		{\text{question= plus petit}
		\real{v=\k^2*\w}
		\real{rep=\w}
		}
	\text{enonce= Soit un cylindre à base circulaire de volume \(\v) \unit. Quel est, en \unit, le volume d'un second cylindre de même hauteur et de \RD de base \(\k) fois \question ? }
	\text{introrep=Volume du second cylindre en \unit}
}

\if{\n=3}{	\real{v=\k^2*\w}
		\real{rep=\k}
		\text{enonce= Soit un cylindre à base circulaire de volume \(\w) \unit et un second cylindre de même hauteur et de volume \(\v) \unit. Quel est le rapport du \RD de base du second cylindre à celui du premier ? }
	\text{introrep= Rapport}
}

\if{\n=4}{\real{v=\k*\w}
		\real{rep=\k}
	\text{enonce= Soit un cylindre à base circulaire de volume \(\w) \unit et un second cylindre de même base et de volume \(\v) \unit. Quel est le rapport de la hauteur du second cylindre à celle du premier ? }
	\text{introrep= Rapport}
}


\statement{ \enonce}

\answer{\introrep} {\rep}{type=numeric}
