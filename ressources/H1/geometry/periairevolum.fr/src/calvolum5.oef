\title{Volume du prisme et du cylindre}
\keywords{ volume}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{10000}

\integer{la=randint(26..99)}
\integer{lo=randint(\la+10..129)}
\integer{di=randint(26..69)}
\integer{di=\di*2}
\integer{ha=randint(41..119)}
\real{bpa=\la*\lo/100}
\real{bpr=\la*\lo/200}
\real{bcy=pi*\di*\di/400}
\real{bcy1=floor(\bcy*100)/100}
\real{bcy2=\bcy1+0.01}

\text{pave=draw(300,300
rect 30,230,170,130,black
segment 30,130,80,80,black
segment 170,130,220,80,black
segment 170,230,220,180,black
dsegment 30,230,80,180,black
dsegment 80,180,80,80,black
dsegment 80,180,220,180,black
segment 80,80,220,80,black
segment 220,80,220,180,black
)}
\text{prism=draw(300,300
rect 30,250,200,110,black
segment 30,110,150,30,black
segment 150,30,200,110,black
dsegment 30,250,150,180,black
dsegment 150,180,200,250,black
dsegment 150,180,150,30,black
)}
\text{cyl=draw(300,300
ellipse 150,100,200,100,black
arc 150,220,200,100,0,180,black
arc 150,220,200,100,200,220,black
arc 150,220,200,100,240,260,black
arc 150,220,200,100,280,300,black
arc 150,220,200,100,320,340,black
segment 50,100,50,220,black
segment 250,100,250,220,black
)}
\text{u1=\(cm)}
\text{u2=\(cm^2)}
\text{u3=\(cm^3)}

\text{faux1=Pi &times; diamètre}
\text{faux2=Pi &times; Longueur &times; largeur}
\text{faux3=base &times; hauteur}
\text{pa=Longueur &times; largeur}
\text{pr=(base &times; hauteur)/2}
\text{cy=Pi &times; rayon &times; rayon}
\real{la=\la/10}
\real{lo=\lo/10}
\real{di=\di/10}
\real{ha=\ha/10}

\matrix{vol=\pave,\bpa,\bpa,\pa,Longueur : \lo cm&#44; largeur : \la cm et hauteur : \ha cm
\prism,\bpr,\bpr,\pr, base du triangle : \lo cm&#44; hauteur du triangle : \la cm et hauteur du prisme : \ha cm
\cyl,\bcy1,\bcy2,\cy, diamètre du disque : \di cm et hauteur du cylindre : \ha cm <div class="wims_instruction">Le résultat de l'aire sera accepté au centième de \(cm^2) près et le volume au \(cm^3) près </div>
}
\integer{a=randint(1..3)}
\text{qu=row(\a,\vol)}
\if{\a=1}{\real{rep=\la*\lo*\ha}}{\real{rep=\qu[2]*\ha}}
\if{\a=3}{\integer{rep1=floor(\bcy1*\ha)}
           \integer{rep2=\rep1+1}}
          {\real{rep1=\rep}
           \real{rep2=\rep}}

\statement{<div class="float_right"><img src="\qu[1]" alt=""></div>
<p>Vous devez calculer le volume du solide suivant en utilisant la calculatrice :</p>

Nous avons les dimensions suivantes :
\qu[5]
<ul>
<li>Choisir la formule pour calculer l'aire de la surface de base du solide :\embed{r1,160x40}</li>
<li>Je donne l'aire de la surface de base du solide : \embed{r2,6}</li>
<li>Donner l'unité du résultat :\embed{r3}</li>
<li>Je donne le volume du solide :\embed{r4,6}</li>
<li>Donner l'unité du résultat :\embed{r5}</li>
</ul>
<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>
}

\answer{}{\qu[4];\pa,\pr,\cy,\faux1,\faux2,\faux3}{type=clickfill}
\answer{}{\qu[2],\qu[3]}{type=range}
\answer{}{\u2;\u1,\u2,\u3}{type=clickfill}
\answer{}{\rep1,\rep2}{type=range}
\answer{}{\u3;\u1,\u2,\u3}{type=clickfill}
