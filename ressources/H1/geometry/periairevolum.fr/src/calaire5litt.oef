\title{Aire latérale du prisme et du cylindre (littéral)}
\keywords{area}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{10000}

\integer{la=randint(26..99)}
\integer{li=randint(26..99)}
\integer{lo=randint(\la+10..129)}
\integer{di=randint(26..69)}
\integer{di=\di*2}
\integer{ha=randint(41..119)}
\real{ppa=(\la+\lo)/5}
\real{ppr=(\la+\lo+\li)/10}
\real{pcy=pi*\di/10}
\real{pcy1=floor(\pcy*100)/100}
\real{pcy2=\pcy1+0.01}

\text{pave=draw(300,300
rect 30,230,170,130,black
segment 30,130,80,80,black
segment 170,130,220,80,black
segment 170,230,220,180,black
dsegment 30,230,80,180,black
dsegment 80,180,80,80,black
dsegment 80,180,220,180,black
segment 80,80,220,80,black
segment 220,80,220,180,black
)}
\text{prism=draw(300,300
rect 30,250,200,110,black
segment 30,110,150,30,black
segment 150,30,200,110,black
dsegment 30,250,150,180,black
dsegment 150,180,200,250,black
dsegment 150,180,150,30,black
)}
\text{cyl=draw(300,300
ellipse 150,100,200,100,black
arc 150,220,200,100,0,180,black
arc 150,220,200,100,200,220,black
arc 150,220,200,100,240,260,black
arc 150,220,200,100,280,300,black
arc 150,220,200,100,320,340,black
segment 50,100,50,220,black
segment 250,100,250,220,black
)}
\text{u1=\(cm)}
\text{u2=\(cm^2)}
\text{u3=\(cm^3)}

\text{cy=\(\ \pi) &times; D}
\text{faux2=\(\ pi) &times; L &times; l}
\text{faux3=b &times; h}
\text{faux4=L &times; l}
\text{pa=(L + l) &times; 2}
\text{pr=c1 + c2 + c3}
\text{faux1=\(\ pi) &times; r &times; r}
\real{la=\la/10}
\real{lo=\lo/10}
\real{li=\li/10}
\real{di=\di/10}
\real{ha=\ha/10}

\matrix{vol=\pave,\ppa,\ppa,\pa,<li>Longueur : \lo cm largeur : \la cm </li><li> hauteur : \ha cm</li>
\prism,\ppr,\ppr,\pr, <li>Triangle de base : côté 1 : \lo cm   côté 2 : \la cm  côté 3 : \li cm </li><li> hauteur du prisme : \ha cm</li>
\cyl,\pcy1,\pcy2,\cy, <li>diamètre du disque : \di cm </li><li> hauteur du cylindre : \ha cm </li>,Le résultat du périmètre sera accepté au centième de \(cm) près  et l'aire au \(cm^2) près.
}
\integer{a=randint(1..3)}
\text{qu=row(\a,\vol)}
\real{rep=\qu[2]*\ha}
\if{\a=3}{\integer{rep1=floor(\pcy1*\ha)}
           \integer{rep2=\rep1+1}}
          {\real{rep1=\rep}
           \real{rep2=\rep}}

\statement{<div class="float_right"><img src="\qu[1]" alt=""></div>
Vous devez calculer l'aire latérale du solide suivant en utilisant la calculatrice :

<p>Nous avons les dimensions suivantes :</p>
<ul class="inline">\qu[5]</ul>
\if{\qu[6]!=}{
<div class="wims_instruction">\qu[6]</div>}
<ul><li>Choisir la formule pour calculer le périmètre de la base :\embed{r1,170x40}
</li><li>Je donne le périmètre de la base : \embed{r2,6}
<br>Donner l'unité du résultat :\embed{r3}
</li><li>Je donne l'aire latérale du solide :\embed{r4,6}
<br>Donner l'unité du résultat :\embed{r5}
</li></ul>
<div class="wims_instruction">Vous utiliserez le point comme séparateur décimal.</div>
}

\answer{}{\qu[4];\faux2,\faux4,\pa,\faux3,\pr,\cy,\faux1}{type=clickfill}
\answer{}{\qu[2],\qu[3]}{type=range}
\answer{}{\u1;\u1,\u2,\u3}{type=clickfill}
\answer{}{\rep1,\rep2}{type=range}
\answer{}{\u2;\u1,\u2,\u3}{type=clickfill}
