\title{Calculs d'aires}
\keywords{area}
\langage{fr}
\keywords{area}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{10000}

\integer{ch=randint(1..5)}
\if{\ch=1}{
\integer{a=10*randint(10..20)}
\integer{b=10*randint(10..20)}
\integer{c=10*randint(2..\a/20)}
\integer{d=10*randint(2..\b*3/40)}
\integer{e=10*randint(3..\a/10-\c/10-2)}
\integer{x=(300-\a)/2}
\integer{y=300-(300-\b)/2}
\real{rep=(\a*\b-\d*\e)/100}
}
\if{\ch=2}{
\integer{a=10*randint(11..25)}
\integer{d=10*randint(11..25)}
\integer{b=10*randint(3..\d/10-5)}
\integer{c=10*randint(3..\a/10-5)}
\integer{x=(300-\a)/2}
\integer{y=300-(300-\d)/2}
\real{rep=(\a*\d-(\a-\c)*(\d-\b)/2)/100}
}
\if{\ch=3}{
\integer{a=10*randint(10..25)}
\integer{b=10*randint(3..20)}
\integer{d=10*randint(3..25-\b/10)}
\integer{c=10*randint(3..\a/20)}
\integer{e=10*randint(3..\a/10-\c/10-2)}
\integer{f=10*randint(3..\b/10+\d/10-3)}
\integer{x=(300-\a)/2}
\integer{y=300-(300-\b-\d)/2}
\real{rep=(\b*\c+(\b+\d)*\e+(\a-\c-\e)*(\b+\d-\f))/100}}

\if{\ch=4}{
\integer{a=10*randint(2..10)}
\integer{b=10*randint(5..(26-\a/10))/2}
\integer{x=(300-\a)/2}
\integer{y=150+\a/2+\b}
\real{rep=(\a*\b*4+\a*\a)/100}}

\if{\ch=5}{
\integer{a=10*randint(14..25)}
\integer{b=10*randint(14..25)}
\integer{c=10*randint(3..8)}
\integer{f=10*randint(3..8)}
\integer{d=10*randint(3..\a/10-\f/10-5)}
\integer{e=10*randint(3..\b/10-\c/10-5)}
\integer{x=(300-\a)/2}
\integer{y=150+\b/2}
\real{rep=(\a*\e+(\b-\e)*\d-\f*\e/2-\d*\c/2)/100}}

\text{fig1=draw(300,300
poly black,\x,\y,\x+\a,\y,\x+\a,\y-\b,\x+\a-\c,\y-\b,\x+\a-\c,\y-\b+\d,\x+\a-\c-\e,\y-\b+\d,\x+\a-\c-\e,\y-\b,\x,\y-\b
text red,\x-8,\y,medium,A
text red,\x+\a+2,\y,medium,B
text red,\x+\a+2,\y-\b-8,medium,C
text red,\x+\a-\c-8,\y-\b-8,medium,D
text red,\x+\a-\c-5,\y-\b+\d+5,medium,E
text red,\x+\a-\c-\e,\y-\b+\d+5,medium,F
)}

\text{fig2=draw(300,300
poly black,\x,\y,\x+\a,\y,\x+\a,\y-\b,\x+\c,\y-\d,\x,\y-\d
text red,\x-8,\y,medium,A
text red,\x+\a+2,\y,medium,B
text red,\x+\a+5,\y-\b-8,medium,C
text red,\x+\c+5,\y-\d-10,medium,D
text red,\x-8,\y-\d-8,medium,E
)}

\text{fig3=draw(300,300
poly black,\x,\y,\x+\a,\y,\x+\a,\y-\b,\x+\a-\c,\y-\b,\x+\a-\c,\y-\b-\d,\x+\a-\c-\e,\y-\b-\d,\x+\a-\c-\e,\y-\b-\d+\f,\x,\y-\b-\d+\f
text red,\x-8,\y,medium,A
text red,\x+\a+2,\y,medium,B
text red,\x+\a+2,\y-\b-8,medium,C
text red,\x+\a-\c-8,\y-\b-8,medium,D
text red,\x+\a-\c+5,\y-\b-\d-5,medium,E
text red,\x+\a-\c-\e-8,\y-\b-\d-5,medium,F
text red,\x+\a-\c-\e,\y-\b-\d+\f+5,medium,G
text red,\x-8,\y-\b-\d+\f-8,medium,H)}

\text{fig4=draw(300,300
poly black,\x,\y,\x+\a,\y,\x+\a,\y-\b,\x+\a+\b,\y-\b,\x+\a+\b,\y-\b-\a,\x+\a,\y-\b-\a,\x+\a,\y-\b-\a-\b,\x,\y-\b-\a-\b,\x,\y-\b-\a,\x-\b,\y-\b-\a,\x-\b,\y-\b,\x,\y-\b
text red,\x-8,\y,medium,A
text red,\x+\a+2,\y,medium,B
text red,\x+\a+5,\y-\b+5,medium,C)}

\text{fig5=draw(300,300
poly black,\x,\y,\x+\a,\y,\x+\a,\y-\b,\x+\a-\d,\y-\b+\c,\x+\a-\d,\y-\e,\x+\f,\y-\e
text red,\x-8,\y,medium,A
text red,\x+\a+2,\y,medium,B
text red,\x+\a+2,\y-\b-8,medium,C
text red,\x+\a-\d-8,\y-\b+\c-8,medium,D
text red,\x+\a-\d+5,\y-\e-5,medium,E
text red,\x+\f-10,\y-\e-16,medium,F
dsegment \x+\a,\y-\b,\x+\a-\d,\y-\b,black
dsegment \x+\a-\d,\y-\b,\x+\a-\d,\y-\b+\c,black
dsegment \x+\f,\y-\e,\x,\y-\e,black
dsegment \x,\y-\e,\x,\y,black
text red,\x+\a-\d-8,\y-\b-5,medium,G
text red,\x-10,\y-\e-8,medium,H
)}

\real{a=\a/10}
\real{b=\b/10}
\real{d=\d/10}
\real{c=\c/10}
\real{e=\e/10}
\real{f=\f/10}

\matrix{cons=\fig1,<li> AB = \a cm </li><li> BC = \b cm </li><li> CD = \c cm</li><li> DE = \d cm </li><li>  EF = \e cm</li>
\fig2,<li> AB = \a cm </li><li> BC = \b cm </li><li> DE = \c cm</li><li> EA = \d cm</li>
\fig3,<li> AB = \a cm </li><li> BC = \b cm </li><li> CD = \c cm</li><li> DE = \d cm </li><li>  EF = \e cm </li><li>  FG = \f cm</li>
\fig4,<li> Les quatre branches de la croix ont la même longueur et la même largeur </li><li> AB = \a cm </li><li> BC = \b cm</li>
\fig5,<li> AB = \a cm </li><li> BC = \b cm </li><li> CG = \d cm</li><li> DG = \c cm </li><li>  AH = \e cm </li><li> FH = \f cm</li>}

\text{fig=row(\ch,\cons)}

\statement{<div class="float_right"><img src="\fig[1]" alt=""></div>
Vous devez calculer l'aire de la figure.

<p>Nous avons les dimensions suivantes :</p>
<ul>\fig[2]</ul>
<div class="spacer">
Je donne l'aire : \embed{r1,6} cm²
</div>
}

\answer{}{\rep}{type=numeric}
