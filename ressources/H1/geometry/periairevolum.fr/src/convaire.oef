\title{Conversions d'aires}
\keywords{area, conversion}
\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}

\text{unit=\(km^2),\(hm^2),\(dam^2),\(m^2),\(dm^2),\(cm^2),\(mm^2)}
\integer{e=randint(2..6)}
\integer{n1=randint(1..3)}
\integer{z1=randint(0..3)}
\integer{s1=randint(1..3)}
\if{\s1+\e>7}{\integer{s1=7-\e}}
\text{nb=shuffle(9)}
\text{nb1=}
\text{nn1=}
\for{i=1 to \n1}
    {\text{nb1=wims(append item \nb[\i] to \nb1)}
      \integer{nn1=\nn1 \nb[\i]}}
\for{i=1 to \z1}
    {\text{nb1=wims(append item 0 to \nb1)}
      \integer{nn1=\nn1 0}}

\integer{n2=randint(1..3)}
\integer{z2=randint(0..3)}
\integer{s2=randint(1..3)}
\if{\e-\s2<1}{\integer{s2=1}}
\text{nb=shuffle(9)}
\text{nb2=}
\text{nn2=}
\for{i=1 to \n2}
    {\text{nb2=wims(append item \nb[\i] to \nb2)}
     \integer{nn2=\nn2 \nb[\i]}}
\for{i=1 to \z2}
    {\text{nb2=wims(append item 0 to \nb2)}
     \integer{nn2=\nn2 0}}

\integer{n3=randint(1..3)}
\integer{d3=randint(1..3)}
\integer{s3=randint(1..3)}
\if{\s3+\e>7}{\integer{s3=7-\e}}
\text{nb=shuffle(9)}
\text{nb3=}
\text{nn3=}
\for{i=1 to \n3}
    {\text{nb3=wims(append item \nb[\i] to \nb3)}
     \integer{nn3=\nn3 \nb[\i]}}
\real{nn3=\nn3/10^\d3}

\integer{n4=randint(1..5)}
\integer{d4=randint(1..2)}
\integer{s4=randint(1..3)}
\if{\e-\s4<1}{\integer{s4=1}}
\text{nb=shuffle(9)}
\text{nb4=}
\text{nn4=}
\for{i=1 to \n4}
    {\text{nb4=wims(append item \nb[\i] to \nb4)}
     \integer{nn4=\nn4 \nb[\i]}}
\real{nn4=\nn4/10^\d4}
\if{\n1+\z1>\n2+\z2}{\integer{max=\n1+\z1}}{\integer{max=\n2+\z2}}
\if{\d3>\d4}{\integer{max=\d3}}{\integer{max=\d4}}
\integer{max=ceil(\max/2)*2}
\integer{l=\e+\max/2}
\real{rep1=\nn1*10^(\s1*2)}
\real{rep2=\nn2*10^(-\s2*2)}
\real{rep3=\nn3*10^(\s3*2)}
\real{rep4=\nn4*10^(-\s4*2)}

\statement{
Nous avons partiellement tracé le tableau de conversion.
<p>Compléter la première ligne du tableau en précisant les bonnes unités avec les étiquettes :</p>
<table class="wimscenter wimsborder">
<tr><td></td><td></td>

\for{j=1 to \e-2}
{<td colspan="2" rowspan="1"></td>}
<td colspan="2" rowspan="1"><span class="larger">\embed{r1,80x30}</span></td>
<td colspan="2" rowspan="1"><span class="larger">\embed{r2}</span></td>
<td colspan="2" rowspan="1"><span class="larger">\embed{r3}</span></td>
\for{j=\e+2 to \l}
{<td colspan="2" rowspan="1"></td>}
</tr><tr>
\for{j=1 to 2+2*\e-\n1-\z1}
   {<td></td>}
\for{j=1 to \n1+\z1}
    {<td><span class="larger">\nb1[\j]</span></td>}
\for{j=1 to \max}
   {<td></td>}
</tr><tr>
\for{j=1 to 2+2*\e-\n2-\z2}
    {<td></td>}
\for{j=1 to \n2+\z2}
    {<td><span class="larger">\nb2[\j]</span></td>}
\for{j=1 to \max}
   {<td></td>}
</tr><tr>
\for{j=1 to 2+2*\e-\n3+\d3}
    {<td></td>}
\for{j=1 to \n3}
    {<td><span class="larger">\nb3[\j]</span></td>}
\for{j=1 to \max-\d3}
   {<td></td>}
</tr><tr>
\for{j=1 to 2+2*\e-\n4+\d4}
    {<td></td>}
\for{j=1 to \n4}
    {<td><span class="larger">\nb4[\j]</span></td>}
\for{j=1 to \max-\d4}
   {<td></td>}
</tr>
</table>
En vous aidant du tableau et éventuellement en le complétant sur votre brouillon :
<p>Convertir</p>
<ul>
<li>\nn1 \unit[\e] =  \embed{r4,10} \unit[\e+\s1]</li>
<li>\nn2 \unit[\e] = \embed{r5,10} \unit[\e-\s2]</li>
<li>\nn3 \unit[\e] = \embed{r6,10} \unit[\e+\s3]</li>
<li>\nn4 \unit[\e] = \embed{r7,10} \unit[\e-\s4]</li>
</ul>
}

\answer{}{\unit[\e-1];\(km^2),\(hm^2),\(dam^2),\(m^2),\(dm^2),\(cm^2),\(mm^2)}{type=clickfill}
\answer{}{\unit[\e];\(km^2),\(hm^2),\(dam^2),\(m^2),\(dm^2),\(cm^2),\(mm^2)}{type=clickfill}
\answer{}{\unit[\e+1];\(km^2),\(hm^2),\(dam^2),\(m^2),\(dm^2),\(cm^2),\(mm^2)}{type=clickfill}
\answer{}{\rep1}{type=auto}
\answer{}{\rep2}{type=auto}
\answer{}{\rep3}{type=auto}
\answer{}{\rep4}{type=auto}
