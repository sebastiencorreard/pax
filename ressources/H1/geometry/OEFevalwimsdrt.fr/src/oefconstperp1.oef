\title{Programme de construction de droites 1}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\real{p1=0.6}
\real{p2=-1/\p1}

\text{dess=draw(300,300
linewidth 1
text black,190,40,medium,\nom[1]
segment 0,80,300,80+300*\p1,black
segment 0,400,300,400+300*\p2,black
segment 198,58,207,67,black
text black,10,65,medium,(d1)
text black,45,270,medium,(d2))
}

\text{enonc=Tracer une droite (d1).,
Placer un point \nom[1] n'appartenant pas à la droite (d1).,
Tracer une droite (d2) perpendiculaire à la droite (d1) et passant par le point \nom[1].}

\statement{
<table><tr><td><img src="\dess" alt=""></td>
<td>Mettre dans l'ordre les phrases du programme de construction,
permettant de tracer le dessin ci-contre.
<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>
<ol><li> \embed{r1,500x30}
</li><li> \embed{r2,500x30}
</li><li> \embed{r3,500x30}
</li></ol>
</td></tr></table>}

\answer{}{\enonc[1]}{type=dragfill}{option=shuffle}
\answer{}{\enonc[2]}{type=dragfill}
\answer{}{\enonc[3]}{type=dragfill}
