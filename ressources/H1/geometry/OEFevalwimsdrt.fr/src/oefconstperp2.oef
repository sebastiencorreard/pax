\title{Programme de construction de droites 2}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\real{p1=0.6}

\text{dess=draw(300,300
linewidth 1
segment 0,150,300,150,black
segment 150,0,150,300,black
text black,140,155,medium,\nom[1]
text black,140,85,medium,\nom[2]
text black,260,155,medium,\nom[3]
segment 0,60,300,60+300*\p1,black
segment 0,-10,300,-10+300*\p1,black
text black,10,135,medium,(d2)
text black,120,270,medium,(d1)
text black,40,70,medium,(d3))
}

\text{enonc=Tracer deux droites (d1) et (d2) perpendiculaires au point \nom[1].,
Placer un point \nom[2] sur la droite (d1) et un point \nom[3] sur la droite (d2).,
Tracer la droite (\nom[2]\nom[3]).,
Tracer la droite (d3) parallèle à la droite (\nom[2]\nom[3]) et passant par le point \nom[1].}

\statement{
<table><tr><td><img src="\dess" alt=""></td>
<td>Mettre dans l'ordre les phrases du programme de construction,
permettant de tracer le dessin ci-contre.
<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>
<ol><li> \embed{r1,500x30}
</li><li> \embed{r2,500x30}
</li><li> \embed{r3,500x30}
</li><li> \embed{r4,500x30}
</li></ol>
</td></tr></table>}

\answer{}{\enonc[1]}{type=dragfill}{option=shuffle}
\answer{}{\enonc[2]}{type=dragfill}
\answer{}{\enonc[3]}{type=dragfill}
\answer{}{\enonc[4]}{type=dragfill}
