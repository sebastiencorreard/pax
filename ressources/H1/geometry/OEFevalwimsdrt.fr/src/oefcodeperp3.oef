\text{d1=shuffle(row(\dp[1],\dt))}
\text{d2=shuffle(row(\dp[2],\dt))}
\text{rep=\pt[\a]}

\statement{
  <div class="float_right">\fig[\ch]</div>
Les droites (\pt[\d1[1]]\pt[\d1[2]]) et (\pt[\d2[1]]\pt[\d2[2]]) sont perpendiculaires au point
