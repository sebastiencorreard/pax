\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Programme de construction de droites 5}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\integer{r=randint(25..45)}
\integer{d=\r+randint(5..15)}
\real{r=\r*2/10}
\real{d=\d*2/10}
\real{e=\r/(2*(1+(\r*\r)/(\d*\d)))}
\real{e=\r-\e}
\real{r1=\e-0.2}
\real{r2=\e+0.2}
\real{inf=\e-0.4}
\real{sup=\e+0.4}
\real{p1=-0.7}
\real{p2=-1/\p1}

\text{dess=draw(300,300
linewidth 1
segment 0,235,300,235+300*\p1,black
segment 0,-158,300,-158+300*\p2,black
segment 50,200,250,200,black
segment 250,0,250,300,black
segment 250,195,250,205,black
segment 0,152,300,152,black
text black,35,190,medium,\nom[1]
text black,260,190,medium,\nom[2]
text black,260,60,medium,\nom[3]
text black,170,95,medium,\nom[4]
text black,110,135,medium,\nom[5]
text black,260,135,medium,\nom[6]
text black,210,280,medium,(d1))}

\text{enonc=Tracer un segment [\nom[1]\nom[2]] de longueur \d cm.,
Tracer la droite (d1) perpendiculaire à la droite (\nom[1]\nom[2]) et passant par le point \nom[2].,
Placer un point \nom[3] sur la droite (d1) tel que \nom[2]\nom[3] = \r cm.,
Tracer la droite (\nom[2]\nom[4]) perpendiculaire à la droite (\nom[1]\nom[3])&#130; <br>le point \nom[4] appartient à la droite (\nom[1]\nom[3]).,
Placer le point \nom[5]&#130; milieu du segment [\nom[1]\nom[4]].,
Tracer la droite (\nom[5]\nom[6]) parallèle à la droite (\nom[1]\nom[2])&#130; <br>le point \nom[6] appartient à la droite (\nom[2]\nom[3]).,}

\statement{
<table><tr><td><img src="\dess" alt=""></td>
<td>Mettre dans l'ordre les phrases du programme de construction,
permettant de tracer le dessin ci-contre.
<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>
<ol><li> \embed{r1,500x40}
</li><li> \embed{r2,500x40}
</li><li> \embed{r3,500x40}
</li><li> \embed{r4,500x40}
</li><li> \embed{r5,500x40}
</li><li> \embed{r6,500x40}
</li></ol>
</td></tr></table>
 Faire la construction et donner la mesure suivante :
\nom[3]\nom[6] = \embed{r7,5} cm
}

\answer{}{\enonc[1]}{type=dragfill}{option=shuffle}
\answer{}{\enonc[2]}{type=dragfill}
\answer{}{\enonc[3]}{type=dragfill}
\answer{}{\enonc[4]}{type=dragfill}
\answer{}{\enonc[5]}{type=dragfill}
\answer{}{\enonc[6]}{type=dragfill}
\answer{}{\rep}{type=numeric}
\condition{précision suffisante:}{\rep<=\r2 and \rep>=\r1}
\condition{mesure avec marge d'erreur :}{\rep<=\sup and \rep>=\inf}
