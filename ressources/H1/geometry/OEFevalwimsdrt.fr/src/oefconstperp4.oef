\langage{fr}
\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Programme de construction de droites 4}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\integer{r=randint(25..45)}
\integer{d=\r+randint(5..15)}
\real{r=\r*2/10}
\real{d=\d*2/10}
\real{e=sqrt(\r*\r/4+\d*\d)/2}
\real{r1=\e-0.2}
\real{r2=\e+0.2}
\real{inf=\e-0.4}
\real{sup=\e+0.4}
\real{p1=1.32}

\text{dess=draw(300,300
linewidth 1
text black,35,200,medium,\nom[1]
segment 0,2,300,2+300*\p1,black
segment 50,200,250,200,black
segment 50,195,50,205,black
segment 250,195,250,205,black
segment 150,0,150,300,black
segment 150,78,50,200,black
segment 150,78,250,200,black
text black,260,200,medium,\nom[2]
text black,135,205,medium,\nom[3]
text black,135,65,medium,\nom[4]
text black,85,130,medium,\nom[5]
text black,155,30,medium,(d1)
text black,20,70,medium,(d2))}

\text{enonc=Tracer un segment [\nom[1]\nom[2]] de longueur \r cm.,
Placer le point \nom[3]&#130; milieu du segment [\nom[1]\nom[2]].,
Tracer la droite (d1) perpendiculaire à la droite (\nom[1]\nom[2]) et passant par le point \nom[3].,
Placer un point \nom[4] sur la droite (d1) tel que \nom[3]\nom[4] = \d cm.,
Tracer la droite (d2) parallèle à la droite (\nom[2]\nom[4]) et passant par le point \nom[3].,
Placer le point \nom[5] à l'intersection des droites (d2) et (\nom[1]\nom[4]).}

\statement{
<table><tr><td><img src="\dess" alt=""></td>
<td>Mettre dans l'ordre les phrases du programme de construction,
permettant de tracer le dessin ci-contre.
<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>
<ol><li> \embed{r1,500x30}
</li><li> \embed{r2,500x30}
</li><li> \embed{r3,500x30}
</li><li> \embed{r4,500x30}
</li><li> \embed{r5,500x30}
</li><li> \embed{r6,500x30}
</li></ol>
</td></tr></table>
 Faire la construction et donner la mesure suivante :
\nom[1]\nom[5] = \embed{r7,5} cm
}

\answer{}{\enonc[1]}{type=dragfill}{option=shuffle}
\answer{}{\enonc[2]}{type=dragfill}
\answer{}{\enonc[3]}{type=dragfill}
\answer{}{\enonc[4]}{type=dragfill}
\answer{}{\enonc[5]}{type=dragfill}
\answer{}{\enonc[6]}{type=dragfill}
\answer{}{\rep}{type=numeric}
\condition{précision suffisante:}{\rep<=\r2 and \rep>=\r1}
\condition{mesure avec marge d'erreur :}{\rep<=\sup and \rep>=\inf}
