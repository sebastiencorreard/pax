\author{Jean-Luc, Donadoni}
\email{jluc.donadoni@laposte.net}
\format{html}
\precision{100000}
\title{Coder les perpendiculaires 1}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}

\text{l1h=draw(24,24
segment 0,12,24,12,black
segment 8,18,12,6,red
segment 12,18,16,6,red)}

\text{l2h=draw(24,24
segment 0,12,24,12,black
segment 10,18,14,6,red)}

\text{l3h=draw(24,24
segment 0,12,24,12,black
circle 12,12,8,red)}

\text{a1=draw(24,24
square 2,2,10,red
segment 12,0,12,24,black
segment 0,12,24,12,black)}

\text{ahd1=draw(24,24
segment 0,24,24,0,black
segment 0,12,24,12,black)}

\text{avd1=draw(24,24
segment 0,24,24,0,black
segment 12,24,12,0,black)}

\text{codes=<img src="\l1h" alt="">,<img src="\l2h" alt="">,<img src="\l3h" alt="">,<img src="\a1" alt="">,<img src="\ahd1" alt="">,<img src="\avd1" alt="">}
\text{rep1=item(4,\codes)}
\text{rep2=item(6,\codes)}

\text{dess=draw(300,300
linewidth 1
segment 0,150,300,150,black
segment 100,300,300,100,black
text black,20,130,medium,(d1)
segment 150,0,150,300,black
text black,120,20,medium,(d2)
text black,260,100,medium,(d3))}

\text{cod1=138x138}
\text{cod2=138x238}
\text{enonc1=Les droites (d1) et (d2) sont perpendiculaires.}

\statement{
  <div class="float_left">\special{imagefill \dess,300x300,24x24
    r1,\cod1
    r2,\cod2}
</div>
\enonc1
<div class="clearall spacer">
Compléter la figure avec les images contenant un codage ou celles sans codage :
</div>}

\answer{}{\rep1;\codes}{type=dragfill}{option=shuffle}
\answer{}{\rep2;\codes}{type=dragfill}{option=shuffle}
