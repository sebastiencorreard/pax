\title{Programme de construction de droites 3}
\text{nom=shuffle(A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T)}
\real{p1=0.6}
\real{p2=-1/\p1}

\text{dess=draw(300,300
linewidth 1
segment 0,100,300,100,black
segment 0,200,300,200,black
text black,135,150,medium,\nom[3]
text black,65,85,medium,\nom[1]
text black,230,185,medium,\nom[2]
segment 0,60,300,60+300*\p1,black
segment 0,400,300,400+300*\p2,black
text black,10,105,medium,(d1)
text black,10,205,medium,(d2)
text black,10,50,medium,(d3))
}

\text{enonc=Tracer deux droites parallèles (d1) et (d2).,
Tracer une droite (d3) sécante à la droite (d1).,
Placer le point \nom[1] à l'intersection des droites (d1) et (d3) <br>et le point \nom[2] à l'intersection des droites (d2) et (d3).,
Placer le milieu \nom[3] du segment [\nom[1]\nom[2]].,
Tracer la perpendiculaire à la droite (\nom[1]\nom[2]) et passant par le point \nom[3].}

\statement{
<table><tr><td><img src="\dess" alt=""></td>
<td>Mettre dans l'ordre les phrases du programme de construction,
permettant de tracer le dessin ci-contre.
<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>
<ol><li> \embed{r1,500x40}
</li><li> \embed{r2,500x40}
</li><li> \embed{r3,500x40}
</li><li> \embed{r4,500x40}
</li><li> \embed{r5,500x40}
</li></ol>
</td></tr></table>}

\answer{}{\enonc[1]}{type=dragfill}{option=shuffle}
\answer{}{\enonc[2]}{type=dragfill}
\answer{}{\enonc[3]}{type=dragfill}
\answer{}{\enonc[4]}{type=dragfill}
\answer{}{\enonc[5]}{type=dragfill}
