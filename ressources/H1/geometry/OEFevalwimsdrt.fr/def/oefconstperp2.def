!set title=Programme de construction de droites 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=$[0.6]
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 0,150,300,150,black	segment 150,0,150,300,black	text black,140,155,medium,$(val6[1])	text black,140,85,medium,$(val6[2])	text black,260,155,medium,$(val6[3])	segment 0,60,300,60+300*$val7,black	segment 0,-10,300,-10+300*$val7,black	text black,10,135,medium,(d2)	text black,120,270,medium,(d1)	text black,40,70,medium,(d3) 
tmp0=$ins_url
val8=$(tmp0)	
val9=Tracer deux droites (d1) et (d2) perpendiculaires au point $(val6[1]).,	Placer un point $(val6[2]) sur la droite (d1) et un point $(val6[3]) sur la droite (d2).,	Tracer la droite ($(val6[2])$(val6[3])).,	Tracer la droite (d3) parallèle à la droite ($(val6[2])$(val6[3])) et passant par le point $(val6[1]).
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val9[1])
replytype2=dragfill
replyname2=
replygood2=$(val9[2])
replytype3=dragfill
replyname3=
replygood3=$(val9[3])
replytype4=dragfill
replyname4=
replygood4=$(val9[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table><tr><td><img src="$val8" alt=""></td>	<td>Mettre dans l'ordre les phrases du programme de construction,	permettant de tracer le dessin ci-contre.	<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>	<ol><li>  
!read oef/embed.phtml r1,500x30 
$()	</li><li>  
!read oef/embed.phtml r2,500x30 
$()	</li><li>  
!read oef/embed.phtml r3,500x30 
$()	</li><li>  
!read oef/embed.phtml r4,500x30 
$()	</li></ol>	</td></tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=4
