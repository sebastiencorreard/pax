!set title=Programme de construction de droites 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=7
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!randint 25, 45

val7=$[rint($(tmp0))]
tmp0=!randint 5, 15

val8=$[rint($val7+$(tmp0))]
val7=$[$val7*2/10]
val8=$[$val8*2/10]
val9=$[sqrt($val7*$val7/4+$val8*$val8)/2]
val10=$[$val9-0.2]
val11=$[$val9+0.2]
val12=$[$val9-0.4]
val13=$[$val9+0.4]
val14=$[1.32]
!readproc oef/draw.phtml 300,300 \
linewidth 1	text black,35,200,medium,$(val6[1])	segment 0,2,300,2+300*$val14,black	segment 50,200,250,200,black	segment 50,195,50,205,black	segment 250,195,250,205,black	segment 150,0,150,300,black	segment 150,78,50,200,black	segment 150,78,250,200,black	text black,260,200,medium,$(val6[2])	text black,135,205,medium,$(val6[3])	text black,135,65,medium,$(val6[4])	text black,85,130,medium,$(val6[5])	text black,155,30,medium,(d1)	text black,20,70,medium,(d2) 
tmp0=$ins_url
val15=$(tmp0)
val16=Tracer un segment [$(val6[1])$(val6[2])] de longueur $val7 cm.,	Placer le point $(val6[3])&#130; milieu du segment [$(val6[1])$(val6[2])].,	Tracer la droite (d1) perpendiculaire à la droite ($(val6[1])$(val6[2])) et passant par le point $(val6[3]).,	Placer un point $(val6[4]) sur la droite (d1) tel que $(val6[3])$(val6[4]) = $val8 cm.,	Tracer la droite (d2) parallèle à la droite ($(val6[2])$(val6[4])) et passant par le point $(val6[3]).,	Placer le point $(val6[5]) à l'intersection des droites (d2) et ($(val6[1])$(val6[4])).
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val16[1])
replytype2=dragfill
replyname2=
replygood2=$(val16[2])
replytype3=dragfill
replyname3=
replygood3=$(val16[3])
replytype4=dragfill
replyname4=
replygood4=$(val16[4])
replytype5=dragfill
replyname5=
replygood5=$(val16[5])
replytype6=dragfill
replyname6=
replygood6=$(val16[6])
replytype7=numeric
replyname7=
replygood7=?analyze 17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table><tr><td><img src="$val15" alt=""></td>	<td>Mettre dans l'ordre les phrases du programme de construction,	permettant de tracer le dessin ci-contre.	<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>	<ol><li>  
!read oef/embed.phtml r1,500x30 
$()	</li><li>  
!read oef/embed.phtml r2,500x30 
$()	</li><li>  
!read oef/embed.phtml r3,500x30 
$()	</li><li>  
!read oef/embed.phtml r4,500x30 
$()	</li><li>  
!read oef/embed.phtml r5,500x30 
$()	</li><li>  
!read oef/embed.phtml r6,500x30 
$()	</li></ol>	</td></tr></table>	 Faire la construction et donner la mesure suivante :	$(val6[1])$(val6[5]) =  
!read oef/embed.phtml r7,5 
$() cm	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val17<=$val11 and $val17>=$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=précision suffisante:

!ifval $val17<=$val13 and $val17>=$val12
 condtest2=1
!else
 condtest2=0
!endif
condname2=mesure avec marge d'erreur :

!exit

:stat
vsavelist=6,10,11,12,13,15,17
embedcnt=7
