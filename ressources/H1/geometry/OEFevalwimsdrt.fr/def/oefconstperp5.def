:test

!ifval $val18<=$val11 and $val18>=$val10
 condtest1=1
!else
 condtest1=0
!endif
condname1=précision suffisante:

!ifval $val18<=$val13 and $val18>=$val12
 condtest2=1
!else
 condtest2=0
!endif
condname2=mesure avec marge d'erreur :

!exit

:stat
vsavelist=6,10,11,12,13,16,18
embedcnt=7
