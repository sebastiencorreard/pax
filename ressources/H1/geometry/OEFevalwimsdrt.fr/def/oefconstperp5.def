!set title=Programme de construction de droites 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r,r,r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=7
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!randint 25, 45

val7=$[rint($(tmp0))]
tmp0=!randint 5, 15

val8=$[rint($val7+$(tmp0))]
val7=$[$val7*2/10]
val8=$[$val8*2/10]
val9=$[$val7/(2*(1+($val7*$val7)/($val8*$val8)))]
val9=$[$val7-$val9]
val10=$[$val9-0.2]
val11=$[$val9+0.2]
val12=$[$val9-0.4]
val13=$[$val9+0.4]
val14=$[-0.7]
val15=$[-1/$val14]
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 0,235,300,235+300*$val14,black	segment 0,-158,300,-158+300*$val15,black	segment 50,200,250,200,black	segment 250,0,250,300,black	segment 250,195,250,205,black	segment 0,152,300,152,black	text black,35,190,medium,$(val6[1])	text black,260,190,medium,$(val6[2])	text black,260,60,medium,$(val6[3])	text black,170,95,medium,$(val6[4])	text black,110,135,medium,$(val6[5])	text black,260,135,medium,$(val6[6])	text black,210,280,medium,(d1) 
tmp0=$ins_url
val16=$(tmp0)
val17=Tracer un segment [$(val6[1])$(val6[2])] de longueur $val8 cm.,	Tracer la droite (d1) perpendiculaire à la droite ($(val6[1])$(val6[2])) et passant par le point $(val6[2]).,	Placer un point $(val6[3]) sur la droite (d1) tel que $(val6[2])$(val6[3]) = $val7 cm.,	Tracer la droite ($(val6[2])$(val6[4])) perpendiculaire à la droite ($(val6[1])$(val6[3]))&#130; <br>le point $(val6[4]) appartient à la droite ($(val6[1])$(val6[3])).,	Placer le point $(val6[5])&#130; milieu du segment [$(val6[1])$(val6[4])].,	Tracer la droite ($(val6[5])$(val6[6])) parallèle à la droite ($(val6[1])$(val6[2]))&#130; <br>le point $(val6[6]) appartient à la droite ($(val6[2])$(val6[3])).,
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val17[1])
replytype2=dragfill
replyname2=
replygood2=$(val17[2])
replytype3=dragfill
replyname3=
replygood3=$(val17[3])
replytype4=dragfill
replyname4=
replygood4=$(val17[4])
replytype5=dragfill
replyname5=
replygood5=$(val17[5])
replytype6=dragfill
replyname6=
replygood6=$(val17[6])
replytype7=numeric
replyname7=
replygood7=?analyze 18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table><tr><td><img src="$val16" alt=""></td>	<td>Mettre dans l'ordre les phrases du programme de construction,	permettant de tracer le dessin ci-contre.	<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>	<ol><li>  
!read oef/embed.phtml r1,500x40 
$()	</li><li>  
!read oef/embed.phtml r2,500x40 
$()	</li><li>  
!read oef/embed.phtml r3,500x40 
$()	</li><li>  
!read oef/embed.phtml r4,500x40 
$()	</li><li>  
!read oef/embed.phtml r5,500x40 
$()	</li><li>  
!read oef/embed.phtml r6,500x40 
$()	</li></ol>	</td></tr></table>	 Faire la construction et donner la mesure suivante :	$(val6[3])$(val6[6]) =  
!read oef/embed.phtml r7,5 
$() cm	
$()
!exit

