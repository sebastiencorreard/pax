val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	segment 8,18,12,6,red	segment 12,18,16,6,red 
tmp0=$ins_url
val7=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	segment 10,18,14,6,red 
tmp0=$ins_url
val8=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,12,24,12,black	circle 12,12,8,red 
tmp0=$ins_url
val9=$(tmp0)
!readproc oef/draw.phtml 24,24 \
square 2,2,10,red	segment 12,0,12,24,black	segment 0,12,24,12,black 
tmp0=$ins_url
val10=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,24,24,0,black	segment 0,12,24,12,black 
tmp0=$ins_url
val11=$(tmp0)
!readproc oef/draw.phtml 24,24 \
segment 0,24,24,0,black	segment 12,24,12,0,black 
tmp0=$ins_url
val12=$(tmp0)
val13=<img src="$val7" alt="">,<img src="$val8" alt="">,<img src="$val9" alt="">,<img src="$val10" alt="">,<img src="$val11" alt="">,<img src="$val12" alt="">
tmp0=!item 4 of $val13

val14=$(tmp0)
tmp0=!item 6 of $val13

val15=$(tmp0)
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 0,150,300,150,black	segment 100,300,300,100,black	text black,20,130,medium,(d1)	segment 150,0,150,300,black	text black,120,20,medium,(d2)	text black,260,100,medium,(d3) 
tmp0=$ins_url
val16=$(tmp0)
val17=138x138
val18=138x238
val19=Les droites (d1) et (d2) sont perpendiculaires.
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val14;$val13
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val15;$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

