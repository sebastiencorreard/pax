!set title=Programme de construction de droites 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=$[0.6]
val8=$[-1/$val7]
!readproc oef/draw.phtml 300,300 \
linewidth 1	text black,190,40,medium,$(val6[1])	segment 0,80,300,80+300*$val7,black	segment 0,400,300,400+300*$val8,black	segment 198,58,207,67,black	text black,10,65,medium,(d1)	text black,45,270,medium,(d2) 
tmp0=$ins_url
val9=$(tmp0)	
val10=Tracer une droite (d1).,	Placer un point $(val6[1]) n'appartenant pas à la droite (d1).,	Tracer une droite (d2) perpendiculaire à la droite (d1) et passant par le point $(val6[1]).
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val10[1])
replytype2=dragfill
replyname2=
replygood2=$(val10[2])
replytype3=dragfill
replyname3=
replygood3=$(val10[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table><tr><td><img src="$val9" alt=""></td>	<td>Mettre dans l'ordre les phrases du programme de construction,	permettant de tracer le dessin ci-contre.	<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>	<ol><li>  
!read oef/embed.phtml r1,500x30 
$()	</li><li>  
!read oef/embed.phtml r2,500x30 
$()	</li><li>  
!read oef/embed.phtml r3,500x30 
$()	</li></ol>	</td></tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=3
