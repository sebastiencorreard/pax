!set title=Programme de construction de droites 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=$[0.6]
val8=$[-1/$val7]
!readproc oef/draw.phtml 300,300 \
linewidth 1	segment 0,100,300,100,black	segment 0,200,300,200,black	text black,135,150,medium,$(val6[3])	text black,65,85,medium,$(val6[1])	text black,230,185,medium,$(val6[2])	segment 0,60,300,60+300*$val7,black	segment 0,400,300,400+300*$val8,black	text black,10,105,medium,(d1)	text black,10,205,medium,(d2)	text black,10,50,medium,(d3) 
tmp0=$ins_url
val9=$(tmp0)	
val10=Tracer deux droites parallèles (d1) et (d2).,	Tracer une droite (d3) sécante à la droite (d1).,	Placer le point $(val6[1]) à l'intersection des droites (d1) et (d3) <br>et le point $(val6[2]) à l'intersection des droites (d2) et (d3).,	Placer le milieu $(val6[3]) du segment [$(val6[1])$(val6[2])].,	Tracer la perpendiculaire à la droite ($(val6[1])$(val6[2])) et passant par le point $(val6[3]).
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val10[1])
replytype2=dragfill
replyname2=
replygood2=$(val10[2])
replytype3=dragfill
replyname3=
replygood3=$(val10[3])
replytype4=dragfill
replyname4=
replygood4=$(val10[4])
replytype5=dragfill
replyname5=
replygood5=$(val10[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table><tr><td><img src="$val9" alt=""></td>	<td>Mettre dans l'ordre les phrases du programme de construction,	permettant de tracer le dessin ci-contre.	<div class="wims_instruction">Vous pouvez faire une recherche au brouillon.</div>	<ol><li>  
!read oef/embed.phtml r1,500x40 
$()	</li><li>  
!read oef/embed.phtml r2,500x40 
$()	</li><li>  
!read oef/embed.phtml r3,500x40 
$()	</li><li>  
!read oef/embed.phtml r4,500x40 
$()	</li><li>  
!read oef/embed.phtml r5,500x40 
$()	</li></ol>	</td></tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=5
