!set title=Coder les perpendiculaires 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src="$val1/codeperp1a.jpg" alt="">,<img src="$val1/codeperp2a.jpg" alt="">,<img src="$val1/codeperp3a.jpg" alt="">,	<img src="$val1/codeperp4a.jpg" alt="">,<img src="$val1/codeperp5a.jpg" alt="">,<img src="$val1/codeperp6a.jpg" alt="">
tmp0=!randint 1, 6

val7=$[rint($(tmp0))]
tmp=!trim C,B,E,F,R,A,G	F,B,G,E,C,R,A	R,A,C,B,E,G,F	G,E,R,A,C,F,B	R,F,A,G,E,C,B	R,C,B,G,E,F,A
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val7 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp=!trim 1,4	2,5,7	1,2,6	1,3,7	3,4,5,6
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 1,3	2,3	4,5	1,3	2,3	4,5	1,4	1,5	2,4	2,5	3,4	3,5
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 12

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $(val10[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!shuffle $(tmp0)

val12=$(tmp1)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $(val10[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp1=!shuffle $(tmp0)

val13=$(tmp1)
!if $val11<7 
val14=$[rint(1)]
!else
val14=$[rint(2)]
!endif
replytype1=menu
replyname1=
replygood1=$val14; sont perpendiculaires , ne sont pas perpendiculaires 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="float_right">$(val6[$val7])</div>	Les droites ($(val8[$(val12[1])])$(val8[$(val12[2])])) et ($(val8[$(val13[1])])$(val8[$(val13[2])]))  
!read oef/embed.phtml r1 
$().	
$()
