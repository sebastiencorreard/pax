\title{Comparaison de périmètres 1}



\text{enonc1=On considère un quadrillage de 1 cm sur 1 cm.
 Le périmètre de la figure rouge est :}






\text{typ=radio}
\integer{a=8}
\integer{b=7}
\integer{lo=40}
\integer{xo=10}
\integer{yo=290}
\integer{e=randint(1..3)}
\integer{f=randint(1..3)}
\integer{g=randint(1..7-\e)}
\integer{h=randint(1..6-\f)}
\if{\g=\h and \g=4}{\integer{h=3}}
\if{\g=3 and \h=6}{\integer{h=5}}
\if{\g=6 and \h=3}{\integer{h=2}}
\integer{r1=(\h+\g)*2}
\integer{r2=\h*\g}
\integer{r3=\h+\g}
\integer{r4=(\h+\g)*4}
\real{r5=\g*\h/2}
\integer{ch=1}
\text{rep=\r1 cm,\r2 cm,\r3 cm,\r4 cm,\r5 cm}
\integer{large=4}
\text{val=10+\lo*\e,10+\lo*\f,10+\lo*(\e+\g),10+\lo*(\f+\h)}
\text{fig=linewidth 4
rect \val,red}
\text{t=}
\for{i=1 to \b}{
  \integer{y=\i}
  \for{j=0 to \a-1}{
    \text{t1=square \xo+\lo*\j,\yo-\y*\lo,\lo,black}
    \text{t=\t
\t1}}
    \text{t=\t
\t1}}

\text{rect=draw(340,300
\t
\fig
)}
