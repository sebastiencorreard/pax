!set title=Longueur du cercle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter,length
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=On considère un cercle qui a pour longueur de,	  Donner la longueur du cercle 
val8=On prendra 3.14 comme valeur approchée de \(\,\pi\).
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
val10=$(val6[3]),$(val6[4])
tmp0=!randint 11, 99

val11=$[$(tmp0)/10]
!if $val9=1 
val12=$[$val11*3.14]
!else
val12=$[$val11*6.28]
!endif
val13=$(val7[1]) $(val10[$val9]) $val11 cm. $(val7[2])
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<label for="reply1">$val13:</label>	   
!read oef/embed.phtml r1,5 
$()	  $m_enonc2 cm.	  <div class="wims_instruction">$val8</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,13
embedcnt=1
