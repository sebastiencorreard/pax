!set title=Formule de l'aire du rectangle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=100x40
val7=longueur,largeur,diamètre,rayon,côté,hauteur,base
val8=Donner la formule pour calculer l'aire d'un rectangle&nbsp;
val9=$(val7[4])
val10=2,\(\times\),$(val7[1]),$(val7[2]),4,\(\pi\),$(val7[3]),$(val7[4])
val11=$(val7[1]),\(\times\),$(val7[2])	  |$(val7[2]),\(\times\),$(val7[1])	
replytype1=clickfill
replyname1=
replygood1=$val11;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8	  <div class="wimscenter">	   
!read oef/embed.phtml r1,$val6 
$()	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8
embedcnt=1
