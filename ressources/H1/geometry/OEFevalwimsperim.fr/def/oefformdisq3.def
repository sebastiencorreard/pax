!set title=Formule de l'aire du disque 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=10000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du rectangle,	  Aire du triangle,	  Périmètre du cercle,	  Aire du disque
val8=Donner la formule de l'aire du disque
val9=200x50
val10=2 \(\times\) $(val6[1]) + 2 \(\times\) $(val6[2]),	  4 \(\times\) $(val6[5]),	  $(val6[5]) \(\times\) $(val6[5]),	  $(val6[1]) \(\times\) $(val6[2]),	  6 \(\times\) $(val6[5]) \(\div\) 2,	  \(\pi \times\) $(val6[3]),	  \(\pi \times\) $(val6[4]) \(\times\) $(val6[4])
tmp0=!shuffle 6

val11=$(tmp0)
val12=$(val10[$(val11[1])]),$(val10[$(val11[2])]),$(val10[$(val11[3])]),$(val10[7])
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$(val12[4]);$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8	  <div class="wimscenter"> 
!read oef/embed.phtml reply 1,$val9 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,9
embedcnt=1
