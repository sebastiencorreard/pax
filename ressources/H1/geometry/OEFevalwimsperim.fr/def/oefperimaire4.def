 !exit
!endif

val6=Le périmètre du rectangle est de 
val7=L'aire du rectangle est de 
val8=On considère un rectangle. Sa longueur mesure, sa largeur
val9=\(cm\)
val10=\(cm^2)
!readproc oef/draw.phtml 150,100 \
rect 20,20,130,80,black	 
tmp0=$ins_url
val11=$(tmp0)
tmp0=!shuffle 3

val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint($(val12[2]))]
!if $val13=1 
tmp0=!randint 2, 9

val15=$[rint($(tmp0)*10)]
!else
tmp0=!randint 17, 99

val15=$[rint($(tmp0))]
!endif
!if $val14=1 
tmp0=!randint 1, $val15/10

val16=$[rint($(tmp0)*10)]
!else
tmp0=!randint 6, $val15-10

val16=$[rint($(tmp0))]
!endif
val17=$[$val15*10^($val13-2)]
val18=$[$val16*10^($val14-2)]
val19=dm,cm,mm
val20=$[($val15+$val16)*2]
val21=$[$val15*$val16]
val22=$[rint(6)]
val23=$(val8[1]) $val17 $(val19[$val13]), $(val8[2]) $val18 $(val19[$val14]).
replytype1=numeric
replyname1=
replygood1=$[$val20]
replytype2=numeric
replyname2=
replygood2=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val11" alt=""></div>	 <div class="medium_size text_col">	  $val23	  <div class="spacer"><label for="reply1">$val6</label>	   
!read oef/embed.phtml r1,$val22 
$() $val9.</div>	  <div class="spacer"><label for="reply2">$val7</label>	   
!read oef/embed.phtml r2,$val22 
$() $val10.</div>	  </div></div>	
$()
!exit

