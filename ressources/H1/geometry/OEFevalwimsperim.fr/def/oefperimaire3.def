!set title=Périmètre et aire 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area,perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le périmètre du rectangle est de 
val7=L'aire du rectangle est de 
val8=On considère un rectangle. Sa longueur mesure, sa largeur
val9=\(cm\)
val10=\(cm^2)
!readproc oef/draw.phtml 150,100 \
rect 20,20,130,80,black	 
tmp0=$ins_url
val11=$(tmp0)
tmp0=!randint 60, 199

val12=$[$(tmp0)/10]
tmp0=!randint 10, $val12*10-10

val13=$[$(tmp0)/10]
val14=$[($val12+$val13)*2]
val15=$[$val12*$val13]
val16=$[rint(6)]
val17=$(val8[1]) $val12 cm, $(val8[2]) $val13 cm.
replytype1=numeric
replyname1=
replygood1=$[$val14]
replytype2=numeric
replyname2=
replygood2=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val11" alt=""></div>	 <div class="medium_size text_col">	  $val17	  <div class="spacer"><label for="reply1">$val6</label>	   
!read oef/embed.phtml r1,$val16 
$() $val9.</div>	  <div class="spacer"><label for="reply2">$val7</label>	   
!read oef/embed.phtml r2,$val16 
$() $val10.</div>	  </div></div>	
$()
!exit

