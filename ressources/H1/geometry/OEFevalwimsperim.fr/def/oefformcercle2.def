!set title=Formule du périmètre du cercle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=perimeter
precision=10000

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=En cas de besoin, utiliser la virgule comme séparateur décimal.
val7=On considère un cercle qui a un ,de,	  Calculer son
val8=longueur,largeur,diamètre,rayon,côté,hauteur,base
val9=$(val8[4]),$(val8[3])
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!randint 8, 80

val11=$[$(tmp0)*2/10]
val12=$[$val11/2]
!if $val10=1 
val13=$[$val12]
val14=$[$val11]
val15=$(val8[3])
val16=$(val8[4])
!else
val13=$[$val11]
val14=$[$val12]
val15=$(val8[4])
val16=$(val8[3])
!endif
tmp0=!replace internal . by , in $val13

val13=$(tmp0)
tmp0=!replace internal . by , in $val14

val14=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) $val15 $(val7[2]) $val14 cm.	<div class="spacer"><label for="reply1">$(val7[3]) $val16 :</label>	 
!read oef/embed.phtml r1,6 
$() cm</div>	<div class="wims_instruction">	$val6</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,14,15,16
embedcnt=1
