!set title=Calculer un périmètre 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Vous devez calculer le périmètre de la figure.
val7=Les quatre branches de la croix ont la même longueur et la même largeur
val8=Le périmètre
val9=est&nbsp;
val10=Les dimensions sont les suivantes&nbsp;
tmp0=!randint 2, 10

val11=$[rint(10*$(tmp0))]
tmp0=!randint 5, (26-$val11/10)

val12=$[rint(10*$(tmp0)/2)]
val13=$[rint((300-$val11)/2)]
val14=$[rint(150+$val11/2+$val12)]
val15=$[($val12*8+$val11*4)/10]
!readproc oef/draw.phtml 300,300 \
poly black,$val13,$val14,$val13+$val11,$val14,$val13+$val11,$val14-$val12,$val13+$val11+$val12,$val14-$val12,$val13+$val11+$val12,$val14-$val12-$val11,$val13+$val11,$val14-$val12-$val11,$val13+$val11,$val14-$val12-$val11-$val12,$val13,$val14-$val12-$val11-$val12,$val13,$val14-$val12-$val11,$val13-$val12,$val14-$val12-$val11,$val13-$val12,$val14-$val12,$val13,$val14-$val12	text red,$val13-8,$val14,medium,A	text red,$val13+$val11+2,$val14,medium,B	text red,$val13+$val11+5,$val14-$val12+5,medium,C 
tmp0=$ins_url
val16=$(tmp0)
val11=$[$val11/10]
val12=$[$val12/10]
val17=$val10:	  <ul><li>$val7</li><li>\(A B\) = $val11 cm</li><li>\(B C\) = $val12 cm</li></ul>
replytype1=numeric
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val16" alt="">	 </div>	 <div class="medium_size text_col">	 <p>$val6</p>	  $val17	  <div class="spacer">	  <label for="reply1"> $val8 $val9: </label>  
!read oef/embed.phtml r1,6 
$() cm.	  </div>	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,16,17
embedcnt=1
