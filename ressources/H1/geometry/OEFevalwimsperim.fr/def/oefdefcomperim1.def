!set title=Comparaison de périmètres 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=33
prevarcnt=32
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.	 Le périmètre de la figure rouge est :
val7=radio
val8=$[rint(8)]
val9=$[rint(7)]
val10=$[rint(40)]
val11=$[rint(10)]
val12=$[rint(290)]
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
tmp0=!randint 1, 3

val14=$[rint($(tmp0))]
tmp0=!randint 1, 7-$val13

val15=$[rint($(tmp0))]
tmp0=!randint 1, 6-$val14

val16=$[rint($(tmp0))]
!if $val15=$val16 and $val15=4 
val16=$[rint(3)]
!endif
!if $val15=3 and $val16=6 
val16=$[rint(5)]
!endif
!if $val15=6 and $val16=3 
val16=$[rint(2)]
!endif
val17=$[rint(($val16+$val15)*2)]
val18=$[rint($val16*$val15)]
val19=$[rint($val16+$val15)]
val20=$[rint(($val16+$val15)*4)]
val21=$[$val15*$val16/2]
val22=$[rint(1)]
val23=$val17 cm,$val18 cm,$val19 cm,$val20 cm,$val21 cm
val24=$[rint(4)]
val25=10+$val10*$val13,10+$val10*$val14,10+$val10*($val13+$val15),10+$val10*($val14+$val16)
val26=linewidth 4	rect $val25,red
val27=
!for val28 =1 to $val9 
val29=$[rint($val28)]
!for val30 =0 to $val8-1 
val31=square $val11+$val10*$val30,$val12-$val29*$val10,$val10,black
val27=$val27	$val31
!next
val27=$val27	$val31
!next
!readproc oef/draw.phtml 340,300 \
$val27	$val26	 
tmp0=$ins_url
val32=$(tmp0)
replytype1=$val7

replyoption1=shuffle 
replyname1=
replygood1=$val22;$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val32" alt="">	 </div>	 <div class="medium_size text_col">	  $val6 
!read oef/embed.phtml r1 
$() $m_enonc2.	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,32
embedcnt=1
