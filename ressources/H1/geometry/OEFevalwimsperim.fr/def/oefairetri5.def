!set title=Aire du triangle rectangle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un triangle \(A B C\) rectangle en \(B\) avec,	  et son aire mesure
val7=Le côté \([B C]\) du triangle rectangle mesure: 
tmp0=!randint 5, 19

val8=$[rint($(tmp0)*2)]
tmp0=!randint 3, $val8-6

val9=$[rint($(tmp0))]
val10=$[rint($val8*$val9/2)]
val11=$[rint($val8)]
val12=$[rint(6)]
val13=$(val6[1])	 \(A B\) = $val9 cm $(val6[2]) $val10 \(cm^2).
val14=cm
!readproc oef/draw.phtml 150,100 \
triangle 20,20,20,80,130,80,black	text black,15,5,medium,A	text black,15,85,medium,B	text black,135,85,medium,C	 
tmp0=$ins_url
val15=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size img_col"><img src="$val15" alt=""></div>	  <div class="medium_size text_col">$val13	    <div class="spacer">	    <label for="reply1">$val7</label>  
!read oef/embed.phtml r1,$val12 
$() $val14.	    </div>	  </div>	</div>	
$()
!exit

