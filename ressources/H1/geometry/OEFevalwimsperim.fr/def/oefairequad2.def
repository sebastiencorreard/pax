prevarcnt=29
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.
val7=Trouver l'aire de la figure rouge à l'aide du quadrillage&nbsp;
val8=$[rint(8)]
val9=$[rint(7)]
val10=$[rint(40)]
val11=$[rint(10)]
val12=$[rint(290)]
tmp0=!randint 1, 7

val13=$[rint($(tmp0))]
tmp0=!randint 1, 6

val14=$[rint($(tmp0))]
tmp0=!randint 1, 6

val15=$[rint($(tmp0))]
!if $val14=$val15 
val14=$[rint(2)]
tmp0=!randint 3, 6

val15=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 7

val16=$[rint($(tmp0))]
!if $val13=$val16 
val13=$[rint(2)]
tmp0=!randint 3, 7

val16=$[rint($(tmp0))]
!endif
val17=$[abs(($val13-$val16)*($val14-$val15)/2)]
tmp0=!randint 1, 2

val18=$[rint($(tmp0))]
val19=$[rint(4)]
!if ch=1 
val20=10+$val10*$val13,10+$val10*$val14,10+$val10*$val13,10+$val10*$val15,10+$val10*$val16,10+$val10*$val15
!else
val20=10+$val10*$val13,10+$val10*$val14,10+$val10*$val16,10+$val10*$val14,10+$val10*$val16,10+$val10*$val15
!endif
val21=linewidth 4	triangle $val20,red
val22=
!for val23 =1 to $val9 
val24=$[rint($val23)]
!for val25 =0 to $val8-1 
val26=square $val11+$val10*$val25,$val12-$val24*$val10,$val10,black
val22=$val22	$val26
!next
val22=$val22	$val26
!next
!readproc oef/draw.phtml 340,300 \
$val22	$val21 
tmp0=$ins_url
val27=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val17]
