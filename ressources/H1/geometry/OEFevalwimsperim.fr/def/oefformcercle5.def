!set title=Formule du périmètre du cercle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=perimeter
precision=10000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=100x40
val7=Donner la formule pour calculer le périmètre d'un cercle,	  qui utilise le
val8=longueur,largeur,diamètre,rayon,côté,hauteur,base
val9=$(val8[3]),$(val8[4])
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
val11=2,\(\times),$(val8[1]),$(val8[2]),4,\(\,\pi),$(val8[3]),$(val8[4])
!if $val10=1 
val12=\(\,\pi),\(\times),$(val8[3])|$(val8[4]),\(\times),\(\,\pi)
!else
val12=2,\(\times),\(\,\pi),\(\times),$(val8[4])	    |\(\,\pi),\(\times),2,\(\times),$(val8[4])	    |\(\,\pi),\(\times),$(val8[4]),\(\times),2	    |2,\(\times),$(val8[4]),\(\times),\(\,\pi)	    |$(val8[4]),\(\times),\(\,\pi),\(\times),2	    |$(val8[4]),\(\times),2,\(\times),\(\,\pi)
!endif
replytype1=clickfill
replyname1=
replygood1=$val12;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 $(val9[$val10]) :	  <div class="wimscenter"> 
!read oef/embed.phtml r1,$val6 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10
embedcnt=1
