!set title=Calculer un périmètre 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le périmètre
val6=La longueur
val7=est&nbsp;
val8=Le rectangle a&nbsp;,pour périmètre, pour largeur
tmp0=!randint 8, 25

val9=$[rint(10*$(tmp0))]
tmp0=!randint 4, ($val9/10)-2

val10=$[rint(10*$(tmp0))]
val11=$[rint((300-$val9)/2)]
val12=$[rint((300-$val10)/2)]
val13=$[$val9/10]
val14=
!readproc oef/draw.phtml 300,300 \
rect $val11,$val12,$val11+$val9,$val12+$val10,black 
tmp0=$ins_url
val15=$(tmp0)
val10=$[$val10/10]
val16=$[$val9/5+$val10*2]
val17=$(val8[1]): <ul><li>$(val8[2]) $val16 cm,</li><li>$(val8[3]) $val10 cm</li></ul>
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val15" alt="">	 </div>	 <div class="medium_size text_col">	 <p>$val14</p>	  $val17	  <div class="spacer">	  <label for="reply1"> $val6 $val7: </label>  
!read oef/embed.phtml r1,6 
$() cm.	  </div>	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,14,15,17
embedcnt=1
