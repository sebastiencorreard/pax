!set title=Formule de l'aire du disque 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=10000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du rectangle,	  Aire du triangle,	  Périmètre du cercle,	  Aire du disque
val7=Donner la formule de l'aire du disque
val8=200x50
val9=\(2 \times L + 2 \times l\),	  \(4 \times c\),	  \(c \times c\),	  \(L \times l\),	  \(b \times h \div 2\),	  \(\pi \times D\),	  \(\pi \times r \times r\)	
tmp0=!shuffle 6

val10=$(tmp0)
val11=$(val9[$(val10[1])]),$(val9[$(val10[2])]),$(val9[$(val10[3])]),$(val9[7])
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$(val11[4]);$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7	  <div class="wimscenter"> 
!read oef/embed.phtml reply 1,$val8 
$()</div>	
$()
!exit

