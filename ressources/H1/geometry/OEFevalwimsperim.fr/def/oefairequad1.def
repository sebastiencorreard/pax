!set title=Aire du pavage 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.
val7=Trouver l'aire de la figure rouge à l'aide du quadrillage&nbsp;
val8=$[rint(8)]
val9=$[rint(7)]
val10=$[rint(40)]
val11=$[rint(10)]
val12=$[rint(290)]
tmp0=!randint 1, 7

val13=$[rint($(tmp0))]
tmp0=!randint 1, 6

val14=$[rint($(tmp0))]
tmp0=!randint 1, 6

val15=$[rint($(tmp0))]
!if $val14=$val15 
val14=$[rint(2)]
tmp0=!randint 3, 6

val15=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 7

val16=$[rint($(tmp0))]
!if $val13=$val16 
val13=$[rint(2)]
tmp0=!randint 3, 7

val16=$[rint($(tmp0))]
!endif
val17=$[abs(($val13-$val16)*($val14-$val15))]
val18=$[rint(4)]
val19=10+$val10*$val13,10+$val10*$val14,10+$val10*$val16,10+$val10*$val15
val20=linewidth 4	rect $val19,red
val21=
!for val22 =1 to $val9 
val23=$[rint($val22)]
!for val24 =0 to $val8-1 
val25=square $val11+$val10*$val24,$val12-$val23*$val10,$val10,black
val21=$val21	$val25
!next
val21=$val21	$val25
!next
!readproc oef/draw.phtml 340,300 \
$val21	$val20 
tmp0=$ins_url
val26=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val26" alt="">	 </div>	 <div class="medium_size text_col">	$val6	<div class="spacer">	<label for="reply1">$val7:</label>	   
!read oef/embed.phtml r1,$val18 
$() 
!insmath cm^2
$().	</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,18,26
embedcnt=1
