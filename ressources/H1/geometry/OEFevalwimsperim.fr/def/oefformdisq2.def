!set title=Formule de l'aire du disque 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=10000

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=En cas de besoin, vous utiliserez la virgule	  comme séparateur décimal.
val8=On considère un cercle qui a pour longueur de
val9=Calculer son
val10=$(val6[4]),$(val6[3])
tmp0=!randint 1, 2

val11=$[rint($(tmp0))]
tmp0=!randint 8, 80

val12=$[$(tmp0)*2/10]
val13=$[$val12/2]
!if $val11=1 
val14=$[$val13]
val15=$[$val12]
val16=$(val6[3])
val17=$(val6[4])
!else
val14=$[$val12]
val15=$[$val13]
val16=$(val6[4])
val17=$(val6[3])
!endif
tmp0=!replace internal . by , in $val14

val14=$(tmp0)
tmp0=!replace internal . by , in $val15

val15=$(tmp0)
replytype1=raw
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8 $val16 $val15 cm.	  <div class="spacer"><label for="reply1">$(val9[3])	  $val9 $val17</label> :	   
!read oef/embed.phtml r1,6 
$() cm</div>	  <div class="wims_instruction">$val7</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,15,16,17
embedcnt=1
