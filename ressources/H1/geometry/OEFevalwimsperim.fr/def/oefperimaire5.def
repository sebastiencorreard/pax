 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Donner la formule pour calculer le périmètre d'un rectangle&nbsp;,	  Donner la formule pour calculer l'aire d'un rectangle&nbsp;
val7=longueur,largeur,diamètre,rayon,côté,hauteur,base
val8=100x40
val9=2,\(\times\),$(val7[1]),$(val7[2]),4,\(\pi),diamètre,rayon,+
val10=$(val7[1]),\(\times\),2,+,$(val7[2]),\(\times\),2	  |$(val7[2]),\(\times\),2,+,$(val7[1]),\(\times\),2	  |2,\(\times\),$(val7[1]),+,2,\(\times\),$(val7[2])	  |2,\(\times\),$(val7[2]),+,2,\(\times\),$(val7[1])	  |$(val7[1]),\(\times\),2,+,2,\(\times\),$(val7[2])	  |$(val7[2]),\(\times\),2,+,2,\(\times\),$(val7[1])	
val11=$(val7[1]),\(\times\),$(val7[2])	  |$(val7[2]),\(\times\),$(val7[1])
replytype1=clickfill
replyname1=
replygood1=$val10;$val9
replytype2=clickfill
replyname2=
replygood2=$val11;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

