!set title=Aire d'un triangle quelconque 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un triangle quelconque \(A B C\) de hauteur \([A H]\).
val7=Nous avons&nbsp;:
val8=Calculer l'aire du triangle
tmp0=!randint 40, 140

val9=$[rint($(tmp0))]
tmp0=!randint 40, 140

val10=$[rint($(tmp0))]
tmp0=!randint $val9/2+10, $val9-20

val11=$[$(tmp0)/10]
val12=$[$val9/10-$val11]
val13=$[$val10/10]
val14=$[rint($val11*10)]
val15=$[rint($val12*10)]
val16=$[rint($val13*10)]
val17=$[$val11*$val13/2]
val18=$[$val12*$val13/2]
val19=$[$val17+$val18]
val20=$[rint(6)]
!readproc oef/draw.phtml 220,180 \
linewidth 1	triangle 140,90+$val16/2,140,90-$val16/2,140-$val14,90+$val16/2,black	triangle 140,90+$val16/2,140,90-$val16/2,140+$val15,90+$val16/2,black	text black,140,75-$val16/2,medium,A	text black,145+$val15,95+$val16/2,medium,B	text black,135-$val14,95+$val16/2,medium,C	text black,140,95+$val16/2,medium,H 
tmp0=$ins_url
val21=$(tmp0)
val22=$val6 <p>$val7	\(C H\) = $val11 cm &#44; \(H B\) = $val12 cm , \(A H\) = $val13 cm.</p>
val23=\(cm^2\)
replytype1=numeric
replyname1=
replygood1=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val21" alt="">	 </div>	 <div class="medium_size text_col">	 $val22	 <div class="spacer">	  <label for="reply1">$val8 
!insmath A B C
$()</label>:  
!read oef/embed.phtml r1,$val20 
$() $val23.</div>	</div>	</div>	
$()
!exit

