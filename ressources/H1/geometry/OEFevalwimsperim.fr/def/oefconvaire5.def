val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Convertir&nbsp;
val7=\(km^2),\(hm^2),\(dam^2),\(\textrm{m}^2),\(dm^2),\(cm^2),\(mm^2)
tmp0=!randint 1, 3

val8=$[rint($(tmp0))]
tmp0=!randint 5-$val8, 8-$val8

val9=$[rint($(tmp0))]
tmp0=!randint 1111, 9999

val10=$[rint($(tmp0))]
val10=$[floor($val10/10^($val8-1))/10^$val9]
tmp0=!randint 1, 6

val11=$[rint($(tmp0))]
tmp0=!randint 1, 4

val12=$[rint($(tmp0))]
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
!if $val11+$val12>7 
val12=$[rint(1)]
!endif
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val13-1

val14=$[rint($(tmp0))]
tmp0=!randint 11111, 99999

val15=$[rint($(tmp0))]
val15=$[floor($val15/10^($val13-1))*10^$val14]
tmp0=!randint 2, 7

val16=$[rint($(tmp0))]
tmp0=!randint -4, -1

val17=$[rint($(tmp0))]
tmp0=!randint -2, -1

val17=$[rint($(tmp0))]
!if $val16+$val17<1 
val17=$[rint(-1)]
!endif
val18=$[$val10*10^($val12*2)]
val19=$[$val15*10^($val17*2)]
replytype1=numeric
replyname1=
replygood1=$[$val18]
replytype2=numeric
replyname2=
replygood2=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

