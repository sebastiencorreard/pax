!set title=Aire du pavage 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.
val7=Trouver l'aire de la figure rouge à l'aide du quadrillage&nbsp;
val8=$[rint(8)]
val9=$[rint(7)]
val10=$[rint(40)]
val11=$[rint(10)]
val12=$[rint(290)]
tmp0=!randint 2, 6

val13=$[rint($(tmp0))]
tmp0=!randint 1, $val13-1

val14=$[rint($(tmp0))]
tmp0=!randint $val13+1, 7

val15=$[rint($(tmp0))]
val16=$[2*($val13*$val14+$val13*$val15-$val15*$val14-$val13*$val13)]
val17=$[rint(4)]
val18=10+$val10*$val14,50+$val10*($val13-$val14),10+$val10*$val13,50,10+$val10*$val15,50+$val10*($val15-$val13),10+$val10*($val14+$val15-$val13),50+$val10*($val15-$val14)
val19=linewidth 4	poly red,$val18
val20=
!for val21 =1 to $val9 
val22=$[rint($val21)]
!for val23 =0 to $val8-1 
val24=square $val11+$val10*$val23,$val12-$val22*$val10,$val10,black
val20=$val20	$val24
!next
val20=$val20	$val24
!next
!readproc oef/draw.phtml 340,300 \
$val20	$val19 
tmp0=$ins_url
val25=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val25" alt="">	 </div>	 <div class="medium_size text_col">	$val6	<div class="spacer">	<label for="reply1">$val7:</label>	   
!read oef/embed.phtml r1,$val17 
$() 
!insmath cm^2
$().	</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,17,25
embedcnt=1
