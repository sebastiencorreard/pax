val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un cercle qui a pour longueur de rayon
val7=Calculer&nbsp;, rayon
tmp0=!randint 3, 29

val8=$[rint($(tmp0))]
val9=$[rint(2*$val8)]
val10=$[rint($val8*$val8)]
val11=$val6 $val8 cm.
replytype1=numeric
replyname1=
replygood1=$[$val9]
replytype2=numeric
replyname2=
replygood2=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11	<div class="spacer"> $(val7[1]): <label for="reply1">2 
!insmath \times
$() $(val7[2]) =</label>	 
!read oef/embed.phtml r1,7 
$()</div>	<div class="spacer"> $(val7[1]): <label for="reply2">$(val7[2]) 
!insmath \times
$() $(val7[2]) =</label>	 
!read oef/embed.phtml r2,7 
$()</div>	
$()
!exit

