!set title=Aire du pavage 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.
val7=Trouver l'aire de la figure rouge à l'aide du quadrillage&nbsp;
val8=$[rint(8)]
val9=$[rint(7)]
val10=$[rint(40)]
val11=$[rint(10)]
val12=$[rint(290)]
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
tmp0=!randint 5, 7

val14=$[rint($(tmp0))]
tmp0=!randint $val13+1, $val14-1

val15=$[rint($(tmp0))]
tmp0=!randint $val13+1, $val14-1

val16=$[rint($(tmp0))]
val17=$[rint(1)]
tmp0=!randint 3, 6

val18=$[rint($(tmp0))]
tmp0=!randint 2, $val18-1

val19=$[rint($(tmp0))]
tmp0=!randint 2, $val18-1

val20=$[rint($(tmp0))]
val21=$[(($val18-$val17)*($val14-$val13)+($val19-$val20)*($val16-$val15))/2]
val22=$[rint(4)]
val23=10+$val10*$val13,10+$val10*$val19,10+$val10*$val15,10+$val10*$val17,10+$val10*$val14,10+$val10*$val20,10+$val10*$val16,10+$val10*$val18
val24=linewidth 4	poly red,$val23
val20=
!for val25 =1 to $val9 
val26=$[rint($val25)]
!for val27 =0 to $val8-1 
val28=square $val11+$val10*$val27,$val12-$val26*$val10,$val10,black
val20=$val20	$val28
!next
val20=$val20	$val28
!next
!readproc oef/draw.phtml 340,300 \
$val20	$val24 
tmp0=$ins_url
val29=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val29" alt="">	 </div>	 <div class="medium_size text_col">	$val6	<div class="spacer">	<label for="reply1">$val7:</label>	   
!read oef/embed.phtml r1,$val22 
$() 
!insmath cm^2
$().	</div>	</div></div>	
$()
!exit

