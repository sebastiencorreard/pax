!set title=Comparaison de périmètres 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un pavage formé de triangles équilatéraux de 1 cm de côté.	 Le périmètre de la figure rouge est :
val7=radio
val8=$[34.64]
val9=$[rint(10)]
val10=$[rint(290)]
tmp0=!randitem 1,3,5,7

val11=$[rint($(tmp0))]
tmp0=!randint 1, $val11

val12=$[rint($(tmp0))]
!if $val12=2 
tmp0=!randitem 3,5

val11=$[rint($(tmp0))]
tmp0=!randint 2, 8-$val11

val13=$[rint($(tmp0))]
!else
tmp0=!randint 1, 8-$val11

val13=$[rint($(tmp0))]
!endif
val14=$[rint(3*$val12+$val13*2)]
val15=$[rint(0)]
!for val16 =1 to $val12 
val15=$[rint(($val13+$val16-1)*2+1+$val15)]
!next
!if $val12=$val13 and $val12=1 
val17=$[rint(2*$val12+$val13+1)]
!else
val17=$[rint(2*$val12+$val13)]
!endif
val18=$[rint($val12)]
val19=$[rint(($val12+$val13)*$val12)]
val20=$[rint(1)]
val21=$val14 cm,$val15 cm,$val17 cm,$val18 cm,$val19 cm
val22=$[rint(4)]
val23=40,$val8*$val11,20*($val12+2),$val8*($val11-$val12),20*($val13+2*$val12+2),$val8*($val11+$val13),20*($val13+2),$val8*($val11+$val13)
val24=linewidth 4	poly red,$val23
val25=
!for val26 =0 to 5 
val27=parallel 20,$val8*($val26*2-2),0,$val8*($val26*2-1),40,0,10,black	parallel 20,$val8*($val26*2-2),40,$val8*($val26*2-1),40,0,10,black	segment 0,$val8*($val26*2-2),340,$val8*($val26*2-2),black	parallel 40,$val8*\($val26*2-1),20,$val8*($val26*2),40,0,10,black	parallel 0,$val8*($val26*2-1),20,$val8*($val26*2),40,0,10,black	segment 0,$val8*($val26*2-1),340,$val8*($val26*2-1),black
val25=$val25	$val27
!next
!readproc oef/draw.phtml 340,300 \
$val25	$val24	 
tmp0=$ins_url
val28=$(tmp0)
replytype1=$val7

replyoption1=shuffle 
replyname1=
replygood1=$val20;$val21
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

