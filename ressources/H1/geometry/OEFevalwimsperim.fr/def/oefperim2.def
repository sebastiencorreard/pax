!set title=Calculer un périmètre 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Vous devez calculer le périmètre de la figure.
val7=Le périmètre
val8=est&nbsp;
val9=Les dimensions sont les suivantes&nbsp;
tmp0=!randint 11, 25

val10=$[rint(10*$(tmp0))]
tmp0=!randint 11, 25

val11=$[rint(10*$(tmp0))]
tmp0=!randint 3, $val11/10-5

val12=$[rint(10*$(tmp0))]
tmp0=!randint 3, $val10/10-5

val13=$[rint(10*$(tmp0))]
val14=$[rint((300-$val10)/2)]
val15=$[rint(300-(300-$val11)/2)]
val16=$[rint(sqrt(($val10-$val13)^2+($val11-$val12)^2))]
val17=$[($val10+$val12+$val16+$val13+$val11)/10]
!readproc oef/draw.phtml 300,300 \
poly black,$val14,$val15,$val14+$val10,$val15,$val14+$val10,$val15-$val12,$val14+$val13,$val15-$val11,$val14,$val15-$val11	text red,$val14-8,$val15,medium,A	text red,$val14+$val10+2,$val15,medium,B	text red,$val14+$val10+5,$val15-$val12-8,medium,C	text red,$val14+$val13+5,$val15-$val11-10,medium,D	text red,$val14-8,$val15-$val11-8,medium,E	 
tmp0=$ins_url
val18=$(tmp0)
val10=$[$val10/10]
val12=$[$val12/10]
val11=$[$val11/10]
val13=$[$val13/10]
val19=$[\e/10]
val16=$[$val16/10]
val20=$val9: <ul><li>\(A B\) = $val10 cm </li><li>\(B C\) = $val12 cm </li><li>\(C D\) = $val16 cm</li>	<li>\(D E\) = $val13 cm</li><li>\(E A\) = $val11 cm</li></ul> 
replytype1=numeric
replyname1=
replygood1=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val18" alt="">	 </div>	 <div class="medium_size text_col">	 <p>$val6</p>	  $val20	  <div class="spacer">	  <label for="reply1"> $val7 $val8: </label>  
!read oef/embed.phtml r1,6 
$() cm.	  </div>	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,18,20
embedcnt=1
