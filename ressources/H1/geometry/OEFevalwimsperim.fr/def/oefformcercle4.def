!set title=Formule du périmètre du cercle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=perimeter
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=Cliquez sur la formule
val8=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du disque,	  Aire du rectangle,	  Aire du triangle	
val9=du périmètre du cercle
val10=200x60
val11=\(2 \times L + 2 \times l\),	\(4 \times c\),	\(c \times c\),	\(\pi \times r \times r\),	\(L \times l\),	\(b \times h \div 2\)	
val12=\(\pi \times) D
tmp0=!shuffle 6

val13=$(tmp0)
val14=$(val8[$(val13[1])]),$(val8[$(val13[2])]),$(val8[$(val13[3])]),$val9
val15=$(val11[$(val13[1])]),$(val11[$(val13[2])]),$(val11[$(val13[3])]),$val12
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val12;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 $val9	<div class="wimscenter"> 
!read oef/embed.phtml reply 1,$val10 
$()</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10
embedcnt=1
