!set title=Aire du disque 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=1000000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soit un cercle dont le diamètre a pour longueur 
val7=Calculer, rayon
tmp0=!randint 2, 24

val8=$[rint($(tmp0)*2)]
val9=$[rint($val8*$val8/4)]
replytype1=numeric
replyname1=
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6 $val8 cm.	<div class="spacer">$(val7[1]) :	<label for="reply1">$(val7[2]) 
!insmath \times
$() $(val7[2])</label> =  
!read oef/embed.phtml r1,7 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
