choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=L'aire du triangle rectangle rouge est de 
val7=On considère un carré de, de côté.
tmp0=!randitem 2,4,6,8,10

val8=$[rint($(tmp0))]
val9=$[rint($val8*30)]
val10=$[rint($val8*30)]
val11=$[rint($val9/2)]
val12=$[rint($val10/2)]
val13=$[rint($val8*$val8/2)]
val14=$[rint(4)]
!readproc oef/draw.phtml 280,240 \
rect 140-$val11/2,110+$val12/2,140+$val11/2,110-$val12/2,black	linewidth 2	triangle 140-$val11/2,110+$val12/2,140-$val11/2,110-$val12/2,140+$val11/2,110-$val12/2,red 
tmp0=$ins_url
val15=$(tmp0)
val16=$(val7[1]) $val8 cm $(val7[2])
val17=\(cm^2)
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	  <div class="medium_size img_col"><img src="$val15" alt=""></div>	  <div class="medium_size text_col">$val16	    <div class="spacer">	    <label for="reply1">$val6</label>  
!read oef/embed.phtml r1,$val14 
$() $val17.	    </div>	  </div>	</div>	
