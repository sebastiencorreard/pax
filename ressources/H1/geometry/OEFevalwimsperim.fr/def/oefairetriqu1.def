val6=On considère un triangle quelconque \(A B C\) de hauteur \([A H]\).
val7=Nous avons&nbsp;:
val8=Calculer l'aire du triangle
tmp0=!randint 4, 14

val9=$[rint($(tmp0))]
tmp0=!randint 2, 7

val10=$[rint($(tmp0)*2)]
tmp0=!randint $val9/2+1, $val9-2

val11=$[rint($(tmp0))]
val12=$[rint($val9-$val11)]
val13=$[rint($val10)]
val14=$[rint($val11*10)]
val15=$[rint($val12*10)]
val16=$[rint($val13*10)]
val17=$[rint($val11*$val13/2)]
val18=$[rint($val12*$val13/2)]
val19=$[rint($val17+$val18)]
val20=$[rint(4)]
!readproc oef/draw.phtml 220,180 \
linewidth 1	triangle 140,90+$val16/2,140,90-$val16/2,140-$val14,90+$val16/2,black	triangle 140,90+$val16/2,140,90-$val16/2,140+$val15,90+$val16/2,black	text black,140,75-$val16/2,medium,A	text black,145+$val15,95+$val16/2,medium,B	text black,135-$val14,95+$val16/2,medium,C	text black,140,95+$val16/2,medium,H 
tmp0=$ins_url
val21=$(tmp0)
val22=$val6 <p>$val7	\(C H\) = $val11 cm &#44; \(H B\) = $val12 cm &#44; \(A H\) = $val13 cm.	</p>
val23=$val8 \(C H A\) :
val24=$val8 \(B H A\) :
val25=$val8 \(A B C\) :
val26=\(cm^2\)
replytype1=numeric
replyname1=
replygood1=$[$val17]
replytype2=numeric
replyname2=
replygood2=$[$val18]
replytype3=numeric
replyname3=
