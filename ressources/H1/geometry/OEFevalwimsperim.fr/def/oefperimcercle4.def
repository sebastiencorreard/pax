!set title=Longueur du cercle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter,length
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=On considère un cercle qui a pour longueur de,	  Donner la longueur du cercle 
val8=On prendra 3 comme valeur approchée de \(\,\pi\).
val7=On considère un cercle qui a pour longueur, Donner la longueur du 
val9=1
val10=$(val6[3])
tmp0=!randint 11, 99

val11=$[$(tmp0)/10]
val12=$[$val11*3]
val13=$[$val11]
val14=$(val7[1]) $val12 cm. $(val7[2]) $(val10[$val9])
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

