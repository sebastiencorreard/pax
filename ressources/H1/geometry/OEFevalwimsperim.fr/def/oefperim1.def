!set title=Calculer un périmètre 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=10000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Vous devez calculer le périmètre de la figure.
val7=Le périmètre
val8=est&nbsp;
val9=Le rectangle a pour longueur, et pour largeur
tmp0=!randint 80, 250

val10=$[rint($(tmp0))]
tmp0=!randint 40, $val10-20

val11=$[rint($(tmp0))]
val12=$[rint((300-$val10)/2)]
val13=$[rint((300-$val11)/2)]
val14=$[($val11*2+$val10*2)/10]
!readproc oef/draw.phtml 300,300 \
rect $val12,$val13,$val12+$val10,$val13+$val11,black	 
tmp0=$ins_url
val15=$(tmp0)
val10=$[$val10/10]
val11=$[$val11/10]
val16=$(val9[1]) $val10 cm $(val9[2]) $val11 cm.
replytype1=numeric
replyname1=
replygood1=$[$val14]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val15" alt="">	 </div>	 <div class="medium_size text_col">	 <p>$val6</p>	  $val16	  <div class="spacer">	  <label for="reply1"> $val7 $val8: </label>  
!read oef/embed.phtml r1,6 
$() cm.	  </div>	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,15,16
embedcnt=1
