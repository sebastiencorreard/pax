!set title=Formule de l'aire du rectangle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=area
precision=10000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=longueur,largeur,diamètre,rayon,côté,hauteur,base
val7=Périmètre du rectangle,	  Périmètre du carré,	  Aire du carré,	  Aire du disque,	  Aire du triangle,	  Périmètre du cercle
val8=Cliquer sur la formule de l'aire du rectangle&nbsp;
val9=Aire du rectangle
val10=200x60
val11=\(4 \times c\),	\(c \times c\),	\(\pi \times r \times r\),	\(b \times h \div 2\),	\(\pi \times D\),	\(2 \times L + 2 \times l\)
val12=\(L \times l\)
tmp0=!itemcnt $val11

val13=$(tmp0)
tmp0=!shuffle $val13

val14=$(tmp0)
val15=$(val11[$(val14[1])]),$(val11[$(val14[2])]),$(val11[$(val14[3])]),$val12
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val12;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val8:	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val10 
$()	</div>	
$()
!exit

