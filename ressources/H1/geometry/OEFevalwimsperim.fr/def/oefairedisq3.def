!set title=Aire du disque 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=1000000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un cercle qui a pour longueur de rayon,	  Donner l'aire du disque&nbsp;
val7=On prendra 3 comme valeur approchée de \(\,\pi\).
tmp0=!randint 3, 29

val8=$[rint($(tmp0))]
val9=$[rint($val8*$val8*3)]
val10=$(val6[1]) $val8 cm. $(val6[2])
replytype1=numeric
replyname1=
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <label for="reply1">$val10:</label> 
!read oef/embed.phtml r1,7 
$()$m_enonc2 cm².	  <div class="wims_instruction">$val7</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10
embedcnt=1
