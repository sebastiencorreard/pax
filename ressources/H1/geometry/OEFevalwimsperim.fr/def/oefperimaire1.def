!set title=Périmètre et aire 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=perimeter,area
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net

ansorder=r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=On considère un quadrillage de 1 cm sur 1 cm.,	  Trouver le périmètre de la figure rouge à l'aide du quadrillage&nbsp;,	  Trouver l'aire de la figure rouge à l'aide du quadrillage&nbsp;
val7=$[rint(8)]
val8=$[rint(7)]
val9=$[rint(40)]
val10=$[rint(10)]
val11=$[rint(290)]
tmp0=!randint 1, 7

val12=$[rint($(tmp0))]
tmp0=!randint 1, 6

val13=$[rint($(tmp0))]
tmp0=!randint 1, 6

val14=$[rint($(tmp0))]
!if $val13=$val14 
val13=$[rint(2)]
tmp0=!randint 3, 6

val14=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 7

val15=$[rint($(tmp0))]
!if $val12=$val15 
val12=$[rint(2)]
tmp0=!randint 3, 7

val15=$[rint($(tmp0))]
!endif
val16=$[abs(($val12-$val15)*($val13-$val14))]
val17=$[(abs($val12-$val15)+abs($val13-$val14))*2]
val18=$[rint(4)]
val19=10+$val9*$val12,10+$val9*$val13,10+$val9*$val15,10+$val9*$val14
val20=linewidth 4	rect $val19,red
val21=
!for val22 =1 to $val8 
val23=$[rint($val22)]
!for val24 =0 to $val7-1 
val25=square $val10+$val9*$val24,$val11-$val23*$val9,$val9,black
val21=$val21	$val25
!next
val21=$val21	$val25
!next
!readproc oef/draw.phtml 340,300 \
$val21	$val20 
tmp0=$ins_url
val26=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val17]
replytype2=numeric
replyname2=
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col">	   <img src="$val26" alt="">	 </div>	 <div class="medium_size text_col">	  <p>$(val6[1])</p>	  <div class="spacer"><label for="reply1">	 $(val6[2]):	  </label>	   
!read oef/embed.phtml r1,$val18 
$() 
!insmath cm
$().	  </div>	  <div class="spacer">	  <label for="reply2">	  $(val6[3]):</label>	   
!read oef/embed.phtml r2,$val18 
$() 
!insmath cm^2
$().	  </div>	  </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,18,26
embedcnt=2
