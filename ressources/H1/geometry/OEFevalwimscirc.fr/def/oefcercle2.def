!set title=Cercle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Soit un cercle de centre
val8=cercle,centre,diamètre,rayon,corde,rond,trait,sommet,compas
val9=Placer les légendes&nbsp;
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	text black,140,150,medium,$(val6[1])	segment 58,58,242,242,black	segment 30,100,100,270,black	segment 150,150,210,35,black	arrow 190,150,150,150,10,black	arrow 150,240,150,280,10,black 
tmp0=$ins_url
val10=$(tmp0)
val11=40x170
val12=150x60
val13=70x90
val14=193x138
val15=120x230
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$(val8[5]);$val8
replytype2=clickfill
replyoption2=shuffle 
replyname2=
replygood2=$(val8[4]);$val8
replytype3=clickfill
replyoption3=shuffle 
replyname3=
replygood3=$(val8[3]);$val8
replytype4=clickfill
replyoption4=shuffle 
replyname4=
replygood4=$(val8[2]);$val8
replytype5=clickfill
replyoption5=shuffle 
replyname5=
replygood5=$(val8[1]);$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val7 $(val6[1]). $val9:	  <div class="wimscenter"> 
!read oef/special.phtml imagefill $val10,300x300,70x24	    r1,$val11	    r2,$val12	    r3,$val13	    r4,$val14	    r5,$val15 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,9,10,11,12,13,14,15
embedcnt=1
