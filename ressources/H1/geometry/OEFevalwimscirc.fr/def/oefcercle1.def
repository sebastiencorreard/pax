 !exit
!endif

tmp=!trim Tout point, qui appartient, à un cercle, est à une même, distance, du centre.	Un cercle, est l'ensemble de tous, les points du plan situés, à une même distance, d'un point appelé, centre.	Un cercle, de centre O, est une figure plane constituée, de tous les points situés, à la même distance, appelée rayon, du point O.	On appelle cercle, de centre O et, de rayon r, l'ensemble des points d'un plan situés, à la distance r, du point O.
val6=!translate internal $	\
$ to ;; in $tmp
val7=Placer les mots dans l'ordre pour faire une phrase correcte&nbsp;
tmp0=!randint 1, 4

val8=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!row $val8 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val6;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

