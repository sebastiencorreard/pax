!set title=Programme de construction 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
tmp0=!randint 20, 40

val7=$[rint($(tmp0))]
val8=Mettre dans l'ordre les phrases du programme de construction,	  permettant de tracer le dessin ci-contre.
val9=Tracer un cercle de centre $(val6[1]) et de rayon $val7 cm.,	  Tracer un diamètre [$(val6[2])$(val6[3])] du cercle.,	  Placer le milieu $(val6[4]) du segment [$(val6[2])$(val6[1])].,	  Placer un point $(val6[5]) appartenant au cercle tel que le segment [$(val6[4])$(val6[5])] mesure $val7 cm.,	  Tracer les segments [$(val6[4])$(val6[5])] et [$(val6[3])$(val6[5])].,
val10=Faire la construction et donner la mesure suivante&nbsp;
val11=précision suffisante&nbsp;,mesure avec marge d'erreur&nbsp;
val7=$[$val7*2/10]
val12=$[$val7*sqrt(2.5)]
val13=$[$val12-0.2]
val14=$[$val12+0.2]
val15=$[$val12-0.4]
val16=$[$val12+0.4]
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	text black,150,130,medium,$(val6[1])	segment 42,78,258,222,black	segment 96,114,193,28,black	segment 193,28,258,222,black	segment 146,154,154,146,black	text black,30,65,medium,$(val6[2])	text black,265,220,medium,$(val6[3])	text black,95,95,medium,$(val6[4])	text black,200,15,medium,$(val6[5]) 
tmp0=$ins_url
val17=$(tmp0)	
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val9[1])
replytype2=dragfill
replyname2=
replygood2=$(val9[2])
replytype3=dragfill
replyname3=
replygood3=$(val9[3])
replytype4=dragfill
replyname4=
replygood4=$(val9[4])
replytype5=dragfill
replyname5=
replygood5=$(val9[5])
replytype6=numeric
replyname6=
replygood6=?analyze 18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val17" alt=""></div>	 <div class="medium_size text_col">	$val8		<ol><li> 
!read oef/embed.phtml r1,500x40 
$()	</li><li> 
!read oef/embed.phtml r2,500x40 
$()	</li><li> 
!read oef/embed.phtml r3,500x40 
$()	</li><li> 
!read oef/embed.phtml r4,500x40 
$()	</li><li> 
!read oef/embed.phtml r5,500x40 
$()	</li></ol>		 </div>	</div>		<p>$val10</p>	<div class="spacer">		$(val6[3])$(val6[5]) =  
!read oef/embed.phtml r6,5 
$() cm		</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!ifval $val18<=$val14 and $val18>=$val13
 condtest1=1
!else
 condtest1=0
!endif
condname1=$(val11[1]):

!ifval $val18<=$val16 and $val18>=$val15
 condtest2=1
!else
 condtest2=0
!endif
condname2=$(val11[2]):

!exit

:stat
vsavelist=6,8,10,11,13,14,15,16,17,18
embedcnt=6
