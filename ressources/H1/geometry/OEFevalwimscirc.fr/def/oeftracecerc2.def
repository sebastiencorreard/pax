 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T,U

val6=$(tmp0)
tmp0=!randint 1, 9

val7=$[rint($(tmp0))]
val8=$[rint($val7*2)]
val9=$[rint(\e*2)]
!readproc oef/draw.phtml 300,300 \
circle 150,150,260,black	circle 215,150,130,black	segment 20,150,280,150,black	text black,140,132,medium,$(val6[1])	segment 146,146,154,154,black	segment 146,154,154,146,black	text black,205,132,medium,$(val6[2])	segment 211,146,219,156,black	segment 211,156,219,146,black	text black,285,132,medium,$(val6[3])	text black,10,132,medium,$(val6[4])	text black,40,40,medium,(C1)	text black,160,80,medium,(C2)	 
tmp0=$ins_url
val10=$(tmp0)
tmp=!trim Le cercle de centre $(val6[1]) et de rayon $val7 cm est le cercle ,3	Le cercle de centre $(val6[1]) et de rayon $val8 cm est le cercle ,1	Le cercle de centre $(val6[1]) et de diamètre $val8 cm est le cercle ,3	Le cercle de centre $(val6[1]) et de diamètre $val9 cm est le cercle ,1	Le cercle de centre $(val6[2]) et de rayon $val7 cm est le cercle ,2	Le cercle de centre $(val6[2]) et de rayon $val8 cm est le cercle ,3	Le cercle de centre $(val6[2]) et de diamètre $val7 cm est le cercle ,3	Le cercle de centre $(val6[2]) et de diamètre $val8 cm est le cercle ,2	Le cercle de centre $(val6[3]) et de rayon $val7 cm est le cercle ,3	Le cercle de centre $(val6[3]) et de rayon $val8 cm est le cercle ,3	
val11=!translate internal $	\
$ to ;; in $tmp
val12=aucun des deux
val13=Cocher la bonne réponse
tmp=!trim Soient deux cercles (C1) et (C2).	  Le segment, mesure
val14=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
val15=$[rint($(tmp0))]
tmp0=!randint 1, $val15

val16=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val17=(C1),(C2),$val12
replytype1=radio
replyname1=
replygood1=$(val11[2]);$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

