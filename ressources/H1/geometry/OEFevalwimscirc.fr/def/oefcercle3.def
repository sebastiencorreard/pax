!set title=Cercle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Le point $(val6[1]) est ,le centre, du cercle.	Le segment [$(val6[5])$(val6[6])] est ,une corde, du cercle.	Le segment [$(val6[2])$(val6[3])] est ,un diamètre, du cercle.	Le segment [$(val6[1])$(val6[4])] est ,un rayon, du cercle.	Le point $(val6[1]) est le centre ,du cercle, de diamètre [$(val6[2])$(val6[3])].
val8=Soit un cercle.	  Compléter la phrase sans oublier l'article&nbsp;
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	text black,140,150,medium,$(val6[1])	segment 58,58,242,242,black	segment 30,100,100,270,black	segment 150,150,210,35,black	text black,45,45,medium,$(val6[2])	text black,247,247,medium,$(val6[3])	text black,210,20,medium,$(val6[4])	text black,20,90,medium,$(val6[5])	text black,90,275,medium,$(val6[6]) 
tmp0=$ins_url
val9=$(tmp0)
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
replytype1=nocase
replyname1=
replygood1=$(val7[2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val9" alt=""></div>	 <div class="medium_size text_col">	$val8:	<div class="wims_question">$(val7[1])  
!read oef/embed.phtml r1,15 
$() $(val7[3])</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

