!set title=Programme de construction 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=5
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Mettre dans l'ordre les phrases du programme de construction,	  permettant de tracer le dessin ci-contre.
val8=Tracer un segment [$(val6[2])$(val6[1])] de 6 cm.,	  Tracer un cercle de centre $(val6[1]) et passant par le point $(val6[2]).,	  Tracer une corde [$(val6[2])$(val6[3])] de 6 cm.,	  Tracer une corde [$(val6[3])$(val6[4])] de 6 cm.,	  Tracer une corde [$(val6[4])$(val6[5])] de 6 cm.,
val9=Vous pouvez faire une recherche au brouillon.
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	text black,150,130,medium,$(val6[1])	segment 20,150,150,150,black	segment 146,146,154,154,black	segment 146,154,154,146,black	segment 20,150,87,37,black	segment 87,37,213,37,black	segment 213,37,280,150,black	text black,10,135,medium,$(val6[2])	text black,80,20,medium,$(val6[3])	text black,215,20,medium,$(val6[4])	text black,285,135,medium,$(val6[5]) 
tmp0=$ins_url
val10=$(tmp0)	
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val8[1])
replytype2=dragfill
replyname2=
replygood2=$(val8[2])
replytype3=dragfill
replyname3=
replygood3=$(val8[3])
replytype4=dragfill
replyname4=
replygood4=$(val8[4])
replytype5=dragfill
replyname5=
replygood5=$(val8[5])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val10" alt=""></div>	 <div class="medium_size text_col">	$val7		<div class="wims_instruction">$val9</div>		<ol><li> 
!read oef/embed.phtml r1,500x40 
$()	</li><li> 
!read oef/embed.phtml r2,500x40 
$()	</li><li> 
!read oef/embed.phtml r3,500x40 
$()	</li><li> 
!read oef/embed.phtml r4,500x40 
$()	</li><li> 
!read oef/embed.phtml r5,500x40 
$()	</li></ol>		 </div>	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10
embedcnt=5
