!set title=Programme de construction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Mettre dans l'ordre les phrases du programme de construction,	  permettant de tracer le dessin ci-contre.
val8=Placer deux points distincts $(val6[2]) et $(val6[1]).,	  Tracer le cercle (C1) de centre $(val6[1]) et passant par le point $(val6[2]).,	  Placer le point $(val6[3]) à l'intersection de la droite ($(val6[1])$(val6[2])) et du cercle (C1).,	  Tracer le cercle (C2) de centre $(val6[3]) et passant par le point $(val6[2]).
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	circle 85,150,130,black	text black,85,130,medium,$(val6[1])	segment 20,150,280,150,black	segment 81,146,89,154,black	segment 81,154,89,146,black	text black,10,135,medium,$(val6[2])	text black,155,135,medium,$(val6[3])	text black,40,40,medium,(C2)	text black,75,70,medium,(C1) 
tmp0=$ins_url
val9=$(tmp0)	
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val8[1])
replytype2=dragfill
replyname2=
replygood2=$(val8[2])
replytype3=dragfill
replyname3=
replygood3=$(val8[3])
replytype4=dragfill
replyname4=
replygood4=$(val8[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val9" alt=""></div>	 <div class="medium_size text_col">	$val7		<ol><li> 
!read oef/embed.phtml r1,500x30 
$()	</li><li> 
!read oef/embed.phtml r2,500x30 
$()	</li><li> 
!read oef/embed.phtml r3,500x30 
$()	</li><li> 
!read oef/embed.phtml r4,500x30 
$()	</li></ol>		<div class="wims_instruction">$m_name_instruction</div>		 </div>	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=4
