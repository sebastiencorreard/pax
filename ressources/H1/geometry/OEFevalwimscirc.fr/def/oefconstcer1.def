!set title=Programme de construction 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,E,F,G,H,I,J,K,L,M,N,R,S,T

val6=$(tmp0)
val7=Mettre dans l'ordre les phrases du programme de construction,	  permettant de tracer le dessin ci-contre.
val8=Tracer un segment [$(val6[2])$(val6[3])] de 12 cm de longueur.,	  Placer le point $(val6[1])&#130 milieu du segment [$(val6[2])$(val6[3])].,	  Tracer le cercle de centre $(val6[1]) et passant par le point $(val6[2]).
!readproc oef/draw.phtml 300,300 \
linewidth 1	circle 150,150,260,black	text black,135,150,medium,$(val6[1])	segment 58,58,242,242,black	segment 146,146,154,154,black	segment 146,154,154,146,black	text black,45,45,medium,$(val6[2])	text black,247,247,medium,$(val6[3]) 
tmp0=$ins_url
val9=$(tmp0)	
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$(val8[1])
replytype2=dragfill
replyname2=
replygood2=$(val8[2])
replytype3=dragfill
replyname3=
replygood3=$(val8[3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_columns">	 <div class="medium_size img_col"><img src="$val9" alt=""></div>	 <div class="medium_size text_col">	$val7		<ol><li> 
!read oef/embed.phtml r1,400x30 
$()	</li><li> 
!read oef/embed.phtml r2,400x30 
$()	</li><li> 
!read oef/embed.phtml r3,400x30 
$()	</li></ol>		 </div>	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=3
