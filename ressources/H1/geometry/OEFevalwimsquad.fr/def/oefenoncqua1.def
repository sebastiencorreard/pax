!set title=Énoncé 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la figure sur une feuille de brouillon	  et donner la mesure de
val7=Mesure de
val8=Soit un rectangle, tel que
val9=et
val10=la diagonale 
tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val11=$(tmp0)
val12=$(val8[1]) $(val11[1])$(val11[2])$(val11[3])$(val11[4]) $(val8[2])
tmp0=!randint 40, 80

val13=$[$(tmp0)/10]
tmp0=!randint $val13*10+10, 120

val14=$[$(tmp0)/10]
val15=$[rint(sqrt($val13^2+$val14^2)*10)]
val16=$[($val15-1)/10]
val17=$[($val15+1)/10]
tmp0=!shuffle $val13,$val14

val18=$(tmp0)
val19=$(val11[1])$(val11[2]) = $(val18[1]) cm $val9 $(val11[1])$(val11[4]) = $(val18[2]) cm.
val20=$val10
replytype1=range
replyname1=
replygood1=!rawmath $val16,$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12 $val19 \par $val6 $val20. \par $val7 $val20= \(\cdots \) cm. \end{statement} 


!goto stat

!exit

:question
$()	$val12	$val19	<p>$val6 $val20.</p>	<div class="spacer"><label for="reply1">$val7 $val20 =</label>  
!read oef/embed.phtml r1,4 
$() cm.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val12 $val19 $m_par $val6 $val20. $m_par $val7 $val20= 
!insmath \cdots 
$() cm. $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,12,19,20
embedcnt=1
