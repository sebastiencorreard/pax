!set title=Énoncé 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la figure sur une feuille de brouillon	  et donner la mesure de
val7=Mesure de
val8=Soit un carré, tel que
val9=la diagonale mesure
tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val10=$(tmp0)
val11=$(val8[1]) $(val10[1])$(val10[2])$(val10[3])$(val10[4]) $(val8[2])
tmp0=!randint 40, 90

val12=$[$(tmp0)/10]
val13=$val9 $val12 cm
val14=$(val10[1])$(val10[2])
val15=$[rint($val12/sqrt(2)*10)]
val16=$[($val15-1)/10]
val17=$[($val15+1)/10]
replytype1=range
replyname1=
replygood1=!rawmath $val16,$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val11 $val13 \par $val6 $val14. \par $val7 $val14= \(\cdots \) cm. \end{statement} 


!goto stat

!exit

:question
$()	$val11	$val13	<p>$val6 $val14.</p>	<div class="spacer"><label for="reply1">$val7 $val14 =</label>  
!read oef/embed.phtml r1,4 
$() cm.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val11 $val13 $m_par $val6 $val14. $m_par $val7 $val14= 
!insmath \cdots 
$() cm. $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,13,14
embedcnt=1
