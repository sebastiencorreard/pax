!set title=Vocabulaire de quadrilatères particuliers 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r,r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cette figure est
val7=autre qu'un quadrilatère, un rectangle, un losange, un carré, un quadrilatère quelconque, un cerf-volant
val8=<img src="$val1/quad01b.jpg" alt="">,<img src="$val1/quad02b.jpg" alt="">,<img src="$val1/quad03b.jpg" alt="">,<img src="$val1/quad04b.jpg" alt="">,	<img src="$val1/quad05b.jpg" alt="">,<img src="$val1/quad06b.jpg" alt="">,<img src="$val1/quad07b.jpg" alt="">,<img src="$val1/quad08b.jpg" alt="">,	<img src="$val1/quad09b.jpg" alt="">,<img src="$val1/quad11b.jpg" alt="">,<img src="$val1/quad12b.jpg" alt="">,	<img src="$val1/quad14b.jpg" alt="">,<img src="$val1/quad16b.jpg" alt="">,	<img src="$val1/quad17b.jpg" alt="">,<img src="$val1/quad18b.jpg" alt="">,<img src="$val1/quad19b.jpg" alt="">,<img src="$val1/quad20b.jpg" alt="">
tmp0=!shuffle 17

val9=$(tmp0)
val10=2,3,2,4,5,3,2,2,4,1,2,5,5,5,1,6,6
replytype1=clickfill
replyname1=
replygood1=$(val7[$(val10[$(val9[1])])]);$val7
replytype2=clickfill
replyname2=
replygood2=$(val7[$(val10[$(val9[2])])]);$val7
replytype3=clickfill
replyname3=
replygood3=$(val7[$(val10[$(val9[3])])]);$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		</div>	 <div class="medium_size text_col">		  <table class="wimsborder wimscenter"><tr>	<td>$(val8[$(val9[1])])</td>	<td>$(val8[$(val9[2])])</td>	<td>$(val8[$(val9[3])])</td></tr>	<tr><td> 
!read oef/embed.phtml r1,150x40 
$()</td>	<td> 
!read oef/embed.phtml r2 
$()</td>	<td> 
!read oef/embed.phtml r3 
$()</td></tr>	</table>		
$()
!exit

