!set title=Reproduire un quadrilatère 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soient trois rectangles de mêmes mesures.
val7=Largeur,Longueur
val8=Reproduire la figure avec les bonnes mesures sur une feuille de brouillon	  et donner la mesure du segment [AB]&nbsp;
tmp0=!randint 4, 8

val9=$[rint($(tmp0))]
tmp0=!randint $val9+1, 12

val10=$[rint($(tmp0))]
val11=xrange -170,130	yrange -80,220	linewidth 1	triangle 0,0,-150,0,-150,120,black	triangle 0,0,0,120,-150,120,black	text black,-160,130,medium,A	text black,85,185,medium,B	rotate -38.5	triangle 0,0,-150,0,-150,120,black	triangle 0,0,0,120,-150,120,black	rotate -77	triangle 0,0,-150,0,-150,120,black	triangle 0,0,0,120,-150,120,black
val12=$[rint(20*$val9)]
val13=$[($val12-2)/10]
val14=$[($val12+2)/10]
!readproc oef/draw.phtml 300,300 \
$val11 
tmp0=$ins_url
val15=$(tmp0)
val16=<img src="$val15" alt="">
!readproc oef/drawtikz.phtml 300,300 \
$val11 
tmp0=$ins_tikz
val17=$(tmp0)
replytype1=range
replyname1=
replygood1=!rawmath $val13,$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val9 cm $(val7[2]) $val10 cm. \par $val8: \(AB =\cdots\) cm. \begin{center} $val17 \end{center} \end{statement}


!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val16</div>	 <div class="medium_size text_col">	 $val6		$(val7[1]) $val9 cm $(val7[2]) $val10 cm.		<p>$val8:</p>	<div class="spacer"> <label for="reply1">AB =</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1]) $val9 cm $(val7[2]) $val10 cm. $m_par $val8: 
!insmath AB =\cdots
$() cm. $m_begin{center} $val17 $m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,16,17
embedcnt=1
