!set title=Vocabulaire de quadrilatères particuliers 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cette figure est
val7=autre,un rectangle, un losange, un carré, un quadrilatère quelconque, un cerf-volant
val8=<img src="$val1/quad01b.jpg" alt="">,<img src="$val1/quad02b.jpg" alt="">,<img src="$val1/quad08b.jpg" alt="">,<img src="$val1/quad04b.jpg" alt="">,	<img src="$val1/quad05b.jpg" alt="">,<img src="$val1/quad06b.jpg" alt="">,<img src="$val1/quad07b.jpg" alt="">,<img src="$val1/quad08b.jpg" alt="">,	<img src="$val1/quad09b.jpg" alt="">,<img src="$val1/quad12b.jpg" alt="">,	<img src="$val1/quad14b.jpg" alt="">,<img src="$val1/quad16b.jpg" alt="">,	<img src="$val1/quad17b.jpg" alt="">,<img src="$val1/quad19b.jpg" alt="">,<img src="$val1/quad20b.jpg" alt="">
tmp0=!randint 1, 15

val9=$(tmp0)
val10=2,3,2,4,5,3,2,2,4,2,5,5,5,6,6
replytype1=atext
replyname1=
replygood1=$(val7[$(val10[$val9])])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="wims_columns">	 <div class="medium_size img_col">		$(val8[$val9])		</div>	 <div class="medium_size text_col">		<label for="reply1">$val6</label>		 
!read oef/embed.phtml r1 
$().	</div></div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9
embedcnt=1
