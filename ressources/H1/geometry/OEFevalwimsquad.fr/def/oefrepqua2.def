!set title=Reproduire un quadrilatère 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soient quatre carrés de même mesure.
val7=Les côtés mesurent
val8=Reproduire la figure avec les bonnes mesures sur une feuille de brouillon	  et donner la mesure du segment [AB]&nbsp;
tmp0=!randint 35, 65

val9=$[rint($(tmp0))]
val10=xrange -150,150	yrange -150,150	linewidth 1	text black,-145,15,medium,A	text black,140,15,medium,B	rotate -135	poly black,-20,-20,-20,60,60,60,60,-20	poly black,20,-20,100,-20,100,-100,20,-100	rotate 45	poly black,-20,-20,-20,60,60,60,60,-20	poly black,20,-20,100,-20,100,-100,20,-100
val11=$[rint(5*$val9*sqrt(2)/2)]
val12=$[($val11-1)/10]
val13=$[($val11+1)/10]
val9=$[$val9/10]
!readproc oef/draw.phtml 300,300 \
$val10 
tmp0=$ins_url
val14=$(tmp0)
val15=<img src="$val14" alt="">
!readproc oef/drawtikz.phtml 300,300 \
$val10 
tmp0=$ins_tikz
val16=$(tmp0)
replytype1=range
replyname1=
replygood1=!rawmath $val12,$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 $val9 cm. \par $val8: \(AB =\cdots\) cm. \begin{center} $val16 \end{center} \end{statement}


!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val15</div>	 <div class="medium_size text_col">	 $val6		$val7 $val9 cm.		<p>$val8:</p>	<div class="spacer"> <label for="reply1">AB =</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 $val9 cm. $m_par $val8: 
!insmath AB =\cdots
$() cm. $m_begin{center} $val16 $m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,15,16
embedcnt=1
