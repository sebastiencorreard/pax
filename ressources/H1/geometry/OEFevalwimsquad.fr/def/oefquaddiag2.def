!set title=Diagonales d'un quadrilatère 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=quadrilatère quelconque, rectangle, carré, losange
val7=Il a deux diagonales.,	Il a ses diagonales de même longueur.,	Il a ses diagonales perpendiculaires.,	Il a ses diagonales parallèles.,	Ses diagonales ont le même milieu.
val8=Cliquer sur toutes les propriétés d'un 
tmp0=!randint 1, 4

val9=$[rint($(tmp0))]
val10=$(val6[$val9])
tmp0=!replace internal XXXX by $val10 in $val7

val7=$(tmp0)
tmp=!trim 1	1,2,5	1,2,3,5	1,3,5
val11=!translate internal $	\
$ to ;; in $tmp
val12=$(val6[$val9])&nbsp;:
val13=5
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
val15=$val7
val16=
!for val17 =1 to $val13 
val16=$val16	\item $(val15[$val17])
!next
replytype1=checkbox
replyname1=
replygood1=$val14;$val7
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val8 \par $val12 \par \begin{checkbox} $val16 \end{checkbox} \end{statement} 


!goto stat

!exit

:question
$()	$val8 $val12	<ul> 
!for m_h=1 to $val13 
$()<li> 
!read oef/embed.phtml r1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val8 $m_par $val12 $m_par $m_begin{checkbox} $val16 $m_end{checkbox} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,12,13,16
embedcnt=1
