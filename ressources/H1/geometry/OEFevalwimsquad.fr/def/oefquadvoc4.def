!set title=Vocabulaire de quadrilatères particuliers 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La figure géométrique, est
val7=autre, un rectangle, un carré, un losange, un cerf-volant
val8=<img src="$val1/triangcomplex2b.jpg" alt="">
val9=BDGC,BDEC,BDCE,DFHG,HGDF,FDGH,IKHF,KIFH,FKIH,DEG,ABCED,KHJ
val10=1,3,1,2,2,2,4,4,1,1,1,1
tmp0=!randint 1, 12

val11=$[rint($(tmp0))]
val12=$[rint($(val10[$val11]))]
replytype1=radio
replyname1=
replygood1=$val12;$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="wims_columns">	 <div class="medium_size img_col">		$val8		</div>	 <div class="medium_size text_col">		$(val6[1]) $(val9[$val11]) $(val6[2]):		 
!read oef/embed.phtml r1 
$().	</div></div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9,11
embedcnt=1
