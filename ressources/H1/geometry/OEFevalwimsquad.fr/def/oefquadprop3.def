val10=!translate internal $	\
$ to ;; in $tmp
val11=$(val8[$val9])
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
