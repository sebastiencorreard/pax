$()<div class="wims_columns">	 <div class="medium_size img_col">$val15</div>	 <div class="medium_size text_col">	$(val8[1]) $(val10[1]) $(val8[2]) $(val10[2]) $(val8[3]).	<p>$(val9[1]):</p>	<ul> <li>$(val9[2]) $(val14[$(val13[1])]) :  
!read oef/embed.phtml r1,150x40 
$()	</li><li>$(val9[2]) $(val14[$(val13[2])]) :  
