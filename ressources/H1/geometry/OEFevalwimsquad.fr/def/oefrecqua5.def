!set title=Reconnaître un quadrilatère 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r,r,r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
