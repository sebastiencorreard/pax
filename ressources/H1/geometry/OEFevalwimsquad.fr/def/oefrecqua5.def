val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=rectangle,carré,quadrilatère quelconque,losange
val7=rouge,noir,bleu,vert
val8=Nous avons deux cercles de même rayon.	Le point , est le centre du premier cercle	et le point,  est le centre du deuxième cercle.
val9=Donner la nature des quadrilatères&nbsp;, Quadrilatère
tmp0=!shuffle A,B,C,E,F,G,H,J,K,L,M,N,R,S,T

val10=$(tmp0)
tmp=!nonempty items 0,30,60,90,120,150,180,210,240,270,300,330

tmp0=!randitem $tmp
val11=$(tmp0)
!readproc oef/draw.phtml 300,300 \
xrange -150,150	yrange -150,150	rotate $val11	circle -65,0,160,black	circle 65,0,160,black	linewidth 2	poly red,-65,80,65,80,65,-80,-65,-80	poly black,-145,0,-65,80,15,0,-65,-80	poly blue,145,0,65,80,15,0,65,-80	poly green,-65,0,0,45,65,0,0,-45	text black,-75,0,medium,$(val10[1])	text black,70,0,medium,$(val10[2]) 
tmp0=$ins_url
val12=$(tmp0)
tmp0=!shuffle 4

val13=$(tmp0)
val14=$val7
val15=<img src="$val12" alt="">
replytype1=clickfill
replyname1=
replygood1=$(val6[$(val13[1])]);$val6
replytype2=clickfill
replyname2=
replygood2=$(val6[$(val13[2])]);$val6
replytype3=clickfill
replyname3=
replygood3=$(val6[$(val13[3])]);$val6
replytype4=clickfill
replyname4=
replygood4=$(val6[$(val13[4])]);$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

