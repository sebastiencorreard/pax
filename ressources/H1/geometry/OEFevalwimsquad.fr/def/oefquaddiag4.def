!set title=Diagonales d'un quadrilatère 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=quadrilatère quelconque, rectangle, carré, losange
val7=J'ai deux diagonales.,	  J'ai des diagonales qui ont le même milieu.,	  J'ai des diagonales de même longueur.,	  J'ai des diagonales perpendiculaires.
val8=Je suis un quadrilatère qui vérifie exactement les propriétés suivantes	  (c'est-à-dire sans propriété supplémentaire), Je suis
tmp=!trim $(val7[1]),	$(val7[1]),$(val7[2]),$(val7[3])	$(val7[1]),$(val7[2]),$(val7[3]),$(val7[4])	$(val7[1]),$(val7[2]),$(val7[4])
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
val11=$(val6[$val10])
tmp=!translate internal $	$ to ; in $val9

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
tmp0=!itemcnt $val12

val13=$(tmp0)
val14=
!for val15 =1 to $val13 
val14=$val14	\item $(val12[$val15])
!next
replytype1=atext
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val8[1]): \begin{radio} $val14 \end{radio} $(val8[2]) \end{statement} 


!goto stat

!exit

:question
$()	$(val8[1]):	<ul> 
!for m_j=1 to $val13 
$()<li>$(val12[$m_j])</li> 
!next
$()</ul>	<div class="spacer"><label for="reply1">$(val8[2]) </label> 
!read oef/embed.phtml r1,24 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val8[1]): $m_begin{radio} $val14 $m_end{radio} $(val8[2]) $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,12,13,14
embedcnt=1
