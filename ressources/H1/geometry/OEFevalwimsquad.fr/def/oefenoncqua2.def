!set title=Énoncé 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Faire la figure sur une feuille de brouillon	  et donner la mesure de
val7=Mesure de
val8=Soit un rectangle, tel que
val9=le côté, mesure , et la diagonale
tmp0=!shuffle A,B,C,E,F,G,H,R,S,T

val10=$(tmp0)
val11=$(val8[1]) $(val10[1])$(val10[2])$(val10[3])$(val10[4]) $(val8[2])
tmp0=!randint 40, 80

val12=$[$(tmp0)/10]
tmp0=!randint $val12*10+10, 120

val13=$[$(tmp0)/10]
val14=$[rint(sqrt($val13^2-$val12^2)*10)]
val15=$[($val14-1)/10]
val16=$[($val14+1)/10]
val17=$val12,$val13
val18=$(val9[1]) [$(val10[1])$(val10[2])] $(val9[2]) $(val17[1]) cm	  $(val9[3]) $(val17[2]) cm.
val19=$(val10[1])$(val10[4])
replytype1=range
replyname1=
replygood1=!rawmath $val15,$val16
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val11 $val18 \par $val6 $val19. \par $val7 $val19= \(\cdots \) cm. \end{statement} 


!goto stat

!exit

:question
$()	$val11	$val18	<p>$val6 $val19.</p>	<div class="spacer"><label for="reply1">$val7 $val19 =</label>  
!read oef/embed.phtml r1,4 
$() cm.	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val11 $val18 $m_par $val6 $val19. $m_par $val7 $val19= 
!insmath \cdots 
$() cm. $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,11,18,19
embedcnt=1
