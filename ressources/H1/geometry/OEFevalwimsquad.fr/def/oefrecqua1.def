!set title=Reconnaître un quadrilatère 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=carré,rectangle,carré,losange,quadrilatère quelconque
val7=Le centre du cercle est le point
val8=Donner la nature du quadrilatère
val9=O
tmp=!trim square 0,0,100,black	rect 0,0,-120,100,black	poly black,0,100,100,0,0,-100,-100,0	poly black,0,140,100,0,0,-140,-100,0
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val12=\nat[\r]
val13=$val6
val14=xrange -150,150	yrange -150,150	circle 0,0,200,black	$val10	segment 5,5,-5,-5,black	segment 5,-5,-5,5,black	text black,-10,-10,medium,$val9
!readproc oef/draw.phtml 300,300 \
$val14 
tmp0=$ins_url
val15=$(tmp0)
!readproc oef/drawtikz.phtml 300,300 \
$val14 
tmp0=$ins_tikz
val16=$(tmp0)
val17=<img src="$val15" alt="">
val18=
!for val19  in $val13 
val18=$val18	\item $val19
!next
replytype1=clickfill
replyname1=
replygood1=$(val13[$val11]);$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val8: \begin{center} $val16 \end{center} \begin{radio} $val18 \end{radio} \end{statement} 


!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val17</div>	 <div class="medium_size text_col">	$val7 $(val9[1]).	$val8:	<div class="wimscenter">		 
!read oef/embed.phtml r1,150x40 
$()		</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val8: $m_begin{center} $val16 $m_end{center} $m_begin{radio} $val18 $m_end{radio} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,16,17,18
embedcnt=1
