!set title=Reproduire un quadrilatère 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Soient trois losanges de mêmes mesures.
val7=Les diagonales des losanges mesurent, et
val8=Reproduire la figure avec les bonnes mesures sur une feuille de brouillon	  et donner la mesure du segment [AB]&nbsp;
tmp0=!randint 3, 5

val9=$[rint($(tmp0))]
tmp0=!randint $val9+2, 10

val10=$[rint($(tmp0))]
val11=xrange -150,150	yrange -150,150	linewidth 1	poly black,0,0,-30,70,0,140,30,70	text black,-70,-40,medium,A	text black,70,-40,medium,B	rotate -46	poly black,0,0,-30,70,0,140,30,70	rotate -92	poly black,0,0,-30,70,0,140,30,70	rotate 46	poly black,0,0,-30,70,0,140,30,70	rotate 92	poly black,0,0,-30,70,0,140,30,70
val12=$[(2*pi-10*atan($val9/$val10))/2]
val13=$[rint(20*sqrt($val9^2/4+$val10^2/4)*sin($val12))]
val14=$[($val13-2)/10]
val15=$[($val13+2)/10]
!readproc oef/draw.phtml 300,300 \
$val11 
tmp0=$ins_url
val16=$(tmp0)
val17=<img src="$val16" alt="">
!readproc oef/drawtikz.phtml 300,300 \
$val11 
tmp0=$ins_tikz
val18=$(tmp0)
replytype1=range
replyname1=
replygood1=!rawmath $val14,$val15
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val9 cm $(val7[2]) $val10 cm. \par $val8: \(AB =\cdots\) cm. \begin{center} $val18 \end{center} \end{statement}


!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val17</div>	 <div class="medium_size text_col">	 $val6		$(val7[1]) $val9 cm $(val7[2]) $val10 cm.		<p>$val8:</p>	<div class="spacer"> <label for="reply1">AB =</label>  
!read oef/embed.phtml r1,5 
$() cm.</div>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1]) $val9 cm $(val7[2]) $val10 cm. $m_par $val8: 
!insmath AB =\cdots
$() cm. $m_begin{center} $val18 $m_end{center} $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,10,17,18
embedcnt=1
