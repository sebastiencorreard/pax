!set title=Vocabulaire de quadrilatères particuliers 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=La figure géométrique, est
val7=un rectangle, un carré, un losange
val6=Donner le nom d'
val8=<img src="$val1/triangcomplex2b.jpg" alt="">
val9=DFHG|FHGD|HGDF|GDFH|GHFD|DGHF|FDGH|HFDG,	BDEC|DECB|ECBD|CBDE|BCED|CEDB|EDBC|DBCE,	IKHF|KHFI|HFIK|FIKH|IFHK|FHKI|HKIF|KIFH
tmp0=!randint 1, 3

val10=$[rint($(tmp0))]
val11=$(val9[$val10])
replytype1=case
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()		<div class="wims_columns">	 <div class="medium_size img_col">		$val8		</div>	 <div class="medium_size text_col">		<label for="reply1">$val6$(val7[$val10]) :</label>		 
!read oef/embed.phtml r1 
$().	</div></div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10
embedcnt=1
