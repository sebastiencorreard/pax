!set title=Diagonales d'un quadrilatère 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=quadrilatère quelconque, rectangle, carré, losange
val7=Il a deux diagonales.,	Il a ses diagonales de même longueur.,	Il a ses diagonales perpendiculaires.,	Ses diagonales ont le même milieu.
val8=Choisir le ou les quadrilatère(s) qui possède(nt)	  toujours la propriété suivante&nbsp;:
val9=quadrilatère
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
val11=$val9
tmp0=!replace internal XXXX by $val11 in $val7

val7=$(tmp0)
tmp=!trim 1,2,3,4	2,3	3,4	2,3,4
val12=!translate internal $	\
$ to ;; in $tmp
val13=<p>$(val7[$val10])</p>
val14=4
tmp=!translate internal $	$ to ; in $val12

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$val6
val17=
!for val18 =1 to $val14 
val17=$val17	\item $(val16[$val18])
!next
replytype1=checkbox
replyname1=
replygood1=$val15;$val6
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val8 \par $val13 \par \begin{checkbox} $val17 \end{checkbox} \end{statement} 


!goto stat

!exit

:question
$()	$val8 $val13	<ul> 
!for m_h=1 to $val14 
$()<li> 
!read oef/embed.phtml r1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val8 $m_par $val13 $m_par $m_begin{checkbox} $val17 $m_end{checkbox} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,13,14,17
embedcnt=1
