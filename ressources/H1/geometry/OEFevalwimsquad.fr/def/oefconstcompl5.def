val6=Reproduire sur une feuille la figure suivante avec les bonnes dimensions.,	 Mesurer la longueur
tmp0=!randint 40, 60

val7=$[rint($(tmp0))]
tmp0=!randint 20, 40

val8=$[rint($(tmp0))]
val7=$[$val7/10]
val8=$[$val8/10]
val9=xrange -100,100	yrange -100,100	triangle -40,-70,40,-70,0,0,black	triangle 40,-70,0,0,75,-50,black	triangle -40,-70,0,0,-75,-50,black	triangle -75,-50,0,0,0,90,black	triangle 75,-50,0,0,0,90,black	circle -23,-40,10,red	circle 23,-40,10,red	circle 0,-70,10,red	text black,-7,97,medium,A	text black,-7,-60,medium,B	segment -4,38,4,42,red	segment -4,36,4,40,red	segment 60,-62,56,-58,red	segment -60,-62,-56,-58,red	segment -32,-28,-38,-22,red	segment -34,-28,-40,-22,red	segment 32,-28,38,-22,red	segment 34,-28,40,-22,red	segment 37,-65,44,-61,red	segment 44,-61,46,-66,red	segment -37,-65,-44,-61,red	segment -44,-61,-46,-66,red	dsegment 0,0,0,-70,black	arrow2 77,-58,44,-80,10,black	arrow2 -40,-80,40,-80,10,black	text black,-10,-85,medium,$val7 cm	text black,60,-75,medium,$val8 cm
!readproc oef/draw.phtml 300,300 \
$val9 
tmp0=$ins_url
val10=$(tmp0)
!readproc oef/drawtikz.phtml 300,300 \
$val9 
tmp0=$ins_tikz
val11=$(tmp0)
val10=<img src="$val10" alt="">
val12=$[rint(rint((sqrt($val7*$val7+$val8*$val8)+$val7*sqrt(3)/2)*10))]
val13=$[($val12-1)/10]
val14=$[($val12+1)/10]
replytype1=range
replyname1=
replygood1=!rawmath $val13,$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val6[1]) <p>$(val6[2]) AB.</p> \par \(A B\)= \(\cdots\) cm. \begin{center} $val11 \end{center} \end{statement} 


!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">$val10</div>	 <div class="medium_size text_col">	$(val6[1])	<p>$(val6[2]) AB.</p>	<div class="spacer"><label for="reply1">AB =</label>  
