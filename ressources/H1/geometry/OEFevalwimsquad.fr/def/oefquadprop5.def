!set title=Propriétés des quadrilatères 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=quadrilatère quelconque, rectangle, carré, losange
val7=Cliquer sur toutes les propriétés du
val8=Il a quatre côtés.,	Il a quatre angles.,	Il a ses côtés adjacents de même longueur.,	Il a deux angles égaux.,	Il a ses côtés opposés de même longueur.,	Il a ses côtés opposés parallèles.,	Il a trois angles droits.,	Il a tous ses côtés de même longueur.,	Il a ses angles opposés de même mesure.
val7=Cliquer sur la ou les propriétés que possède le,	   et que ne possède pas le 
tmp0=!replace internal Le XXXX by Il in $val8

val8=$(tmp0)
tmp=!trim 1,2	1,2,4,5,6,7,9	1,2,3,4,5,6,7,8,9	1,2,3,4,5,6,8,9
val9=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 2,1	3,1	4,1	3,2	3,4	2,4	4,2
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 7

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $(val10[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val9

tmp=!row $(val10[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp0=!listcomplement $val13 in $val12

val14=$(tmp0)
val15=
!for val16 =1 to 9 
val15=$val15	  \item $(val8[$val16])
!next
replytype1=checkbox
replyname1=
replygood1=$val14;$val8
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $(val6[$(val10[1])]), $(val7[2]) $(val6[$(val10[2])]): \begin{checkbox} $val15 \end{checkbox} \end{statement} 


!goto stat

!exit

:question
$()$(val7[1]) $(val6[$(val10[1])]) $(val7[2]) $(val6[$(val10[2])]):	<ul> 
!for m_h=1 to 9 
$()<li> 
!read oef/embed.phtml r1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1]) $(val6[$(val10[1])]), $(val7[2]) $(val6[$(val10[2])]): $m_begin{checkbox} $val15 $m_end{checkbox} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,15
embedcnt=1
