!set title=Diagonales d'un quadrilatère 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc,Donadoni
email=jluc.donadoni@gmail.com
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=quadrilatère quelconque, rectangle, carré, losange
val7=Il a deux diagonales.,	Il a ses diagonales de même longueur.,	Il a ses diagonales perpendiculaires.,	Il a ses diagonales parallèles.,	Ses diagonales ont le même milieu.
val8=Il
val9=Cliquer sur la ou les propriétés que possède le,	  mais que ne possède pas le
tmp0=!replace internal Le XXXX by $val8 in $val7

val7=$(tmp0)
tmp=!trim 1	1,2,5	1,2,3,5	1,3,5
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 2,1	3,1	4,1	3,2	3,4	2,4	4,2
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 7

val12=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!listcomplement $val14 in $val13

val15=$(tmp0)
val16=
!for val17 =1 to 5 
val16=$val16	\item $(val7[$val17])
!next
replytype1=checkbox
replyname1=
replygood1=$val15;$val7
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val9[1]) $(val6[$(val11[1])]), $(val9[2]) $(val6[$(val11[2])]): \begin{checkbox} $val16 \end{checkbox} \end{statement} 


!goto stat

!exit

:question
$()	$(val9[1]) $(val6[$(val11[1])]), $(val9[2]) $(val6[$(val11[2])]):	<ul> 
!for m_h=1 to 5 
$()<li> 
!read oef/embed.phtml r1,\h 
$()</li> 
!next
$()</ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val9[1]) $(val6[$(val11[1])]), $(val9[2]) $(val6[$(val11[2])]): $m_begin{checkbox} $val16 $m_end{checkbox} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,11,16
embedcnt=1
