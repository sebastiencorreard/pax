!set title=Trajet de la lumière 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=oui,non
val7=aucune
val8=Pour s'aider, il est possible de tracer un segment.	  Il n'en sera pas tenu compte dans la notation.
val9=Une caisse noire est munie de deux trous, une source lumineuse	  ponctuelle S est placée devant l'un des trous et l'observateur B	  regarde par l'autre trou. Dans la caisse, on a placé un objet blanc A	  et un cache opaque.
val10=L'observateur B voit-il l'objet A?
val11=20
tmp0=!randint 1, 9

val12=0,$(tmp0)
tmp0=!randint 8, 14

val13=$(tmp0)
tmp0=!randint 2, 5

tmp1=!randitem 6,8

tmp=!nonempty items $(tmp0),$(tmp1)

tmp2=!randitem $tmp
val14=$val13,$(tmp2),$val13,10
tmp0=!randint $val13+2, $val11-2

tmp1=!randint 2, 8

val15=$(tmp0),$(tmp1)
val16=$[$(val12[2])+($(val15[2])-$(val12[2]))/($(val15[1])-$(val12[1]))*$(val14[1])]
t_=!replace internal \( by ( in abs($val16-$(val14[2]))
tmp0=!exec pari $t_

!if $(tmp0)<4 
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val17=$[$val16+$(tmp0)]
val14=$val13,$val17,$val13,10
!endif
val18=$[($(val12[1])-$(val14[1]))*($(val15[2])-$(val14[2]))-($(val12[2])-$(val14[2]))*($(val15[1])-$(val14[1]))]
tmp0=!randint $val13+2, $val11-2

val19=$(tmp0),10
val20=xrange -2,$val11+2	yrange -2,12	frectangle 0,0,$val11,10, grey
val20=$val20	linewidth 6	crosshair $val12,yellow	text black,-1,$(val12[2]),large,S	segment $val14,black	linewidth 2	crosshair $val15,black	text black,$(val15[1]),$(val15[2]),large,A	crosshair $val19,blue	text blue,$(val19[1]),$(val19[2]),large,B	

!ifval $val18>0
val21= 1
!else
val21=2
!endif
!if $val18>0 
val22=linewidth 1	arrow $val12,$val15,10,yellow	arrow $val15,$val19,10,yellow
!else
val22=linewidth 1	arrow $val12,$val13,$val16,10,yellow
!endif
replytype1=radio
replyname1=
replygood1=$val21;$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val9	<div class="wimscenter">	 
!read oef/canvasdraw.phtml 400,200 \
	$val20	userdraw segment,blue 
$()	</div>	<div class="wims_question">	$val10  
!read oef/embed.phtml r1,1 
$(), 
!read oef/embed.phtml r1,2 
$()	</div>	<div class="wims_instruction">$val8</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'> 
!read oef/canvasdraw.phtml 400,200 \
	$val20	$val22 
$()	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=8,9,10,20,22
embedcnt=2
