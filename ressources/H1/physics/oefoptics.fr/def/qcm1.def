!set title=Sources de lumière 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=oui,non
val7=aucune
val8=Pour s'aider, il est possible de tracer un segment.	  Il n'en sera pas tenu compte dans la notation.
val9=sources primaires de lumière,objets diffusants
val10=Parmi les objets suivants, quels sont ceux qui sont des
tmp=!trim le Soleil,1	l'écran de télévision en fonctionnement,1	le filament d'une lampe allumée,1	la flamme de la bougie,1	une étoile,1	un laser,1	une ampoule allumée,1	un ver luisant,1	la lave d'un volcan,1	la lune,2	la terre,2	les arbres,2	le mur de la classe,2	les planètes,2	un écran de cinéma pendant la projection,2	les planètes du système solaire,2	les yeux d'un chat la nuit,2	les bandes réfléchissantes sur les vêtements,2	
val11=!translate internal $	\
$ to ;; in $tmp
val12=Un objet diffusant reçoit de la lumière et la rediffuse	dans toutes les directions.
val13=Une source primaire produit sa propre lumière.
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val14=$(tmp0)
val15=$val10 $(val9[$val14])
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
val16=$(tmp0)
tmp0=!shuffle $val16

val17=$(tmp0)
val18=5
val17=$(val17[1..$val18])
val19=
!for val20 =1 to 5 

!ifval $(val11[$(val17[$val20]);2])==$val14
tmp0=!append item $val20 to $val19

val19= $(tmp0)
!endif
!next
replytype1=checkbox
replyname1=
replygood1=$val19;$(val11[$val17;1])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">$val15?</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval 1=1
 <div class='oef_feedbacks'>	
!if $val14=1 
$()$val12 
!else
$() $val13 
!endif
$()	
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=12,13,14,15
embedcnt=0
