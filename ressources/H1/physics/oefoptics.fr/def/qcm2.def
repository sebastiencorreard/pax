!set title=Sources de lumière 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=oui,non
val7=aucune
val8=Pour s'aider, il est possible de tracer un segment.	  Il n'en sera pas tenu compte dans la notation.
val9=Une source primaire de lumière,Un objet diffusant
val10=produit sa propre lumière,reçoit de la lumière,et,la rediffuse	  dans toutes les directions
val11=Former la définition&nbsp;
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val12=$(tmp0)
val13=$val11 $(val9[$val12])

!ifval $val12=1
val14= $(val10[1])
!else
val14=	  $(val10[2,3,4])	
!endif
replytype1=compose
replyname1=
replygood1=$val14;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">$val11:	</div>	$(val9[$val12])  
!read oef/embed.phtml reply1 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,11,12
embedcnt=1
