!set title=Phases de la Lune Nord (P)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr

ansorder=r
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=oui,non
val7=aucune
val8=Pour s'aider, il est possible de tracer un segment.	  Il n'en sera pas tenu compte dans la notation.
val9=Mettre dans l'ordre les phases de la Lune après la phase indiquée	  si l'on est dans l'hémisphère
val10=Nord, Sud
val11=On est dans l'hémisphère
val12=2
t_=!replace internal \( by ( in [[1,1],[sqrt(2)/2,1],[0,1],[-sqrt(2)/2,1],[-1,-1],[-sqrt(2)/2,-1],[0,-1],[sqrt(2)/2,-1]]
tmp0=!exec pari $t_

val13=$(tmp0)
val14=grey
val15=yellow
val16=grey
val17=black
val18=grey
val19=red
val20=0,0
val21=2
val22=-90,90,270
val23=3
val24=$[rint($val23%2)]
val25=$[rint(($val23-$val24)/2)]
val26=0,-1,1,0
val27=
val28=
val29=1
val30=80
tmp0=!makelist <img src="$val1/moon/x.gif" width="$val30" alt=""> for x=1 to 8

val31=$(tmp0)
val32=$val31
val33=$(val10[1])
tmp0=!randint 1, 8

val34=$(tmp0)
t_=!replace internal \( by ( in vector(8,j,lift(Mod(j+$val34,8))+1)
tmp0=!exec pari $t_

val34=$(tmp0)
val32=$(val32[$val34])
replytype1=reorder
replyname1=$(val32[1])
replygood1=$(val32[2..-1]);
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <div class="wims_question">$val9 $val33.</div>	  <div class="wimscenter">$(val32[1])</div>	   
!read oef/embed.phtml r1,8x120 
$()	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,32,33
embedcnt=1
