!if $wims_read_parm!=slib_header
  !goto proc
!endif

slib_author=

slib_example=0,0,50,0,6,20

slib_r12equire=maxima, pari
!exit

:proc
!distribute items $wims_read_parm into slib_x1,slib_y1,slib_r1,slib_x2,slib_y2,slib_r2

!!pour l'instant slib_x1,slib_y1=0
!set slib_x1=0
!set slib_y1=0
!set slib_y2=0
!set slib_range=1000
slib_sl1=$[($slib_r1+$slib_r2)/(($slib_x2)^2-($slib_r1+$slib_r2)^2)^(1/2)]
slib_sl2=$[($slib_r1-$slib_r2)/(($slib_x2)^2-($slib_r1-$slib_r2)^2)^(1/2)]
!!slib_b1=$[-$slib_x2*$slib_sl1 - $slib_r2*($slib_sl1^2+1)^(1/2)]
!!slib_b2=$[-$slib_x2*$slib_sl1 + $slib_r2*($slib_sl1^2+1)^(1/2)]

slib_Z1=$slib_x2*$slib_r1/($slib_r1+$slib_r2)
!if $slib_r1!=$slib_r2
  slib_Z2=$slib_x2*$slib_r1/($slib_r1-$slib_r2)
  slib_Z3=0
!else
  slib_Z2=0
  slib_Z3=$slib_r1
!endif

slib_dessin=linewidth 2

slib_limx1= ($slib_sl1)^2/(1+($slib_sl1)^2)*$slib_Z1
slib_limx2= ($slib_sl2)^2/(1+($slib_sl2)^2)*$slib_Z2

slib_dessin=$slib_dessin\
trange $slib_limx1,XXXXXX1\
dplot green,t,-$slib_sl1*(t-$slib_Z1)\
trange $slib_limx1,XXXXXX1\
dplot green,t,$slib_sl1*(t-$slib_Z1)\
trange $slib_limx2,XXXXXX2\
plot red,t,-$slib_sl2*(t-$slib_Z2)-$slib_Z3\
trange $slib_limx2,XXXXXX2\
plot red,t,$slib_sl2*(t-$slib_Z2)+$slib_Z3\
linewidth 1

slib_out=$slib_sl1,$slib_sl2,$slib_Z1,$slib_Z2,[$slib_dessin]
