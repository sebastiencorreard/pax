!set title=Figures usuelles : Compléter le script
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bruno, Mifsud
email=bruno.mifsud@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Aucun logiciel n'est autorisé pour répondre à cet exercice,	 sans quoi il ne sert pas à grand chose pour progresser.
tmp0=!randitem 1,2,3,5,6

val7=$[rint($(tmp0))]
!if $val7=1 
tmp0=!randitem 4,90

val8=$[$(tmp0)]
!endif
!if $val7=2 
tmp0=!randitem 3,120

val8=$[$(tmp0)]
!endif
!if $val7=3 
tmp0=!randitem 2,90

val8=$[$(tmp0)]
!endif
!if $val7=5 
val8=$[90]
!endif
!if $val7=6 
tmp0=!randitem 60,100

val8=$[$(tmp0)]
!endif
val9=fig$val7.png
val10=pgm$val7$val8.png
val11=pgm$val7.png
val12=Quelle valeur faut-il saisir dans ce script pour obtenir la figure ci dessous ?	
tmp0=!item 1 of 1 oui,	2 non

val13=$(tmp0)
tmp0=!word 1 of $val13

val13=$(tmp0)

!ifval $val13=1 
tmp0=!embraced randitem $val12

val12=$(tmp0)
!endif
replytype1=numeric
replyname1=Réponse
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val12 \end{statement} 


!goto stat

!exit

:question
$()	<div class="wimscenter"> 
!read oef/img.phtml $val1/$val10  
$()</div>	$val12	<br /><div class="wimscenter"> 
!read oef/img.phtml $val1/$val9  
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()	Script :  
!read oef/img.phtml $val1/$val11  
$().	Figure obtenue :  
!read oef/img.phtml $val1/$val9  
$().	
$()
!exit

:latex
$() $m_begin{statement} $val12 $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,9,10,11,12
embedcnt=0
