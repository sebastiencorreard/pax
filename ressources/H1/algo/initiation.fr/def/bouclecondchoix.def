val10=$(tmp0)
val11=
!while $val11 issametext  
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val11=$(val12[2])
!endwhile
val13=$(val12[1])
tmp0=!lowercase $val13

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val14=$(tmp2)
!if $val2=1 
val15=Clique sur le seul script qui permet à la balle WIMS de sortir du couloir :	
!else
val15=Clique sur la seule figure dont le script suivant permet de faire sortir la balle WIMS du couloir :	
!endif
tmp=!translate internal $	$ to ; in $val7

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val7

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!positionof item $val11 in $val17

val18=$(tmp0)
tmp0=!makelist x for x=1 to $val10

val19=$(tmp0)
tmp0=!shuffle $val19

val19=$(tmp0)
val19=$(val19[1..$val8])
tmp0=!listintersection $val18 and $val19

val20=$(tmp0)
!if $val20= 
tmp0=!itemcnt $val18

val21=$[rint($(tmp0))]

!ifval $val21 >1 
tmp=!nonempty items $val18

tmp0=!randitem $tmp
val18= $(tmp0)
!endif
val19=$val18,$(val19[1..$val8-1])
tmp0=!shuffle $val19

val19=$(tmp0)
!endif
tmp=!trim $val7
val7=!translate internal $	\
$ to ;; in $tmp
val16=$(val7[$val19;1])
val17=$(val7[$val19;2])
tmp0=!itemcnt $val16

val8=$(tmp0)
val22=
!for val23 =1 to $val8 

!ifval / isin $(val16[$val23]) 
tmp0=!append item $(val16[$val23]) to $val22

val22= $(tmp0)
!else
tmp1=!append item $val1/$(val16[$val23]) to $val22

val22=	  $(tmp1)
!endif
