}
\text{data=wims(embraced randitem \data)}
\text{tot=rows(\data)}
\text{imagenonce=}
\while{\imagenonce issametext }{
 \text{mot = randrow(\data)}
 \text{imagenonce=\mot[2]}
}
\text{image=\mot[1]}
\text{ext=item(2,wims(replace internal . by , in wims(lowercase \image)))}
