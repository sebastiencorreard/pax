tmp=!trim Cliquer sur le(s) mois dont le total des précipitations est compris entre	  mm et	  mm	  strictement supérieur à	  mm et strictement inférieur à	  mm
val10=!translate internal $	\
$ to ;; in $tmp
tmp=!trim 50,50,50,60,70,60,40,50,50,50,50,50	80,60,60,70,50,40,20,20,80,140,100,90	50,40,50,50,60,60,60,40,50,60,50,60	50,50,40,50,40,30,15,30,50,80,60,60	30,40,40,40,80,80,70,60,60,50,50,40	60,40,60,50,60,70,60,50,60,70,70,70
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 6

val12=$[rint($(tmp0))]
val8=$(val8[$val12])
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val13=
val14=
val15=$[rint(0)]
val16=$[rint(0)]
!for val17 =1 to 6 
tmp0=!randint $(val11[$val17])-10, $(val11[$val17])+10

val14=$[rint($(tmp0))]
val15=$[rint($val15+$val14)]
tmp0=!append item $val14 to $val13

val13=$(tmp0)
!next
!for val17 =7 to 12 
tmp0=!randint $(val11[$val17])-10, $(val11[$val17])+10

val14=$[rint($(tmp0))]
val16=$[rint($val16+$val14)]
tmp0=!append item $val14 to $val13

val13=$(tmp0)
!next
val18=\rp mm
val19=$[rint(20)]
val20=mark
val21=$[rint(50)]
tmp0=!randint 1, 3

val22=$[rint($val21-10*$(tmp0))]
tmp0=!randint 1, 3

val23=$[rint($val21+10*$(tmp0))]
val24=$(val10[1;]) $val22 $(val10[2;]) $val23 $(val10[3;])	  ($(val10[4;]) $val22 $(val10[5;]) $val23 $(val10[6;])).
val18=
!for val25 =1 to 12 
!if $val22<$(val13[$val25]) and $val23>$(val13[$val25]) 
tmp0=!append item $val25 to $val18

val18=$(tmp0)
!endif
!next
