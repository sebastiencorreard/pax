!set title=Faire un tableau 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000

ansorder=r,r,r,r,r,r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=6
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Après un contrôle de mathématiques, le professeur dresse un tableau	  des notes obtenues par les élèves de sa classe
val7=En utilisant le graphique, remplir le tableau
val8=Note sur ,Nombre d'élèves,Notes,Nbr
tmp0=!shuffle 0,4,7

val9=$(tmp0)
!for val10 =1 to 3 
tmp0=!randint 2, 6

val9=$val9,$(tmp0)
!next
tmp0=!shuffle $val9

val9=$(tmp0)
val11=frect 1,0,2,$(val9[1]),red
val12=frect 3,0,4,$(val9[2]),red
val13=frect 5,0,6,$(val9[3]),red
val14=frect 7,0,8,$(val9[4]),red
val15=frect 9,0,10,$(val9[5]),red
val16=frect 11,0,12,$(val9[6]),red
val17=
!for val10 =0 to 20 step 4 
val17=$val17	  text black,$val10/2+1.4,-0.2,small,$val10
!next
!for val10 =1 to 10 
val17=$val17	  text black,-0.7,$val10+0.2,small,$val10
!next
val18=fill 0,0,220,220,255
!readproc oef/draw.phtml 506,308, \
  xrange -1,22	  yrange -1,8	  $val18	  parallel 1,0,1,8,1,0,20,grey	  parallel 0,0.5,21,0.5,0,0.5,16,grey	  linewidth 2	  arrow -1,0,21,0,10,black	  arrow 0,-1,0,8,10,black	  text black,18.6,0.8,medium,$(val8[3])	  text black,0.5,7.9,medium,$(val8[4])	  $val17	$val11	$val12	$val13	$val14	$val15	$val16	  
tmp0=$ins_url
val19=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$(val9[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val9[2])]
replytype3=numeric
replyname3=
replygood3=$[$(val9[3])]
replytype4=numeric
replyname4=
replygood4=$[$(val9[4])]
replytype5=numeric
replyname5=
replygood5=$[$(val9[5])]
replytype6=numeric
replyname6=
replygood6=$[$(val9[6])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	  <img src="$val19" alt="">	  </div>	  <div class="medium_size text_col">	  $val6.	<p>$val7.</p>	<table class="wimscenter wimsborder table-scroll">	 <tr><th>$(val8[1]) 20</th>	 
!for m_i=0 to 20 step 4 
$()<td><label for="reply$m_i">$m_i</label></td> 
!next
$()	 </tr><tr><th>$(val8[2])</th>	  
!for m_i=1 to 6 
$()<td> 
!read oef/embed.phtml r\i,2 
$()</td> 
!next
$()	 </tr></table>	 </div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,19
embedcnt=1
