val6=Janvier,Février,Mars,Avril,Mai,Juin,Juillet,Août,Septembre,Octobre,Novembre,Décembre
val7=de janvier,de février,de mars,d'avril,de mai,de juin,	  de juillet,d'août,de septembre,d'octobre,de novembre,de décembre
val8=Toulouse,Nice,Paris,Marseille,Strasbourg,Lille
val9=Nous avons les moyennes des températures par mois pour la ville de
val10=Donner la température moyenne la plus haute
tmp=!trim 5,2,2,3,4,4,2,1,3,4,5,3	13,1,2,2,4,3,3,1,2,4,4,2	5,1,3,3,4,3,2,1,3,4,5,2	7,1,3,3,4,4,3,1,3,4,5,3	1,1,4,3,4,3,2,1,4,5,5,3	3,1,2,2,4,3,2,1,3,4,4,2
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 6

val12=$[rint($(tmp0))]
val8=$(val8[$val12])
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val12 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!randint $(val11[1]), $(val11[1])+1

val13=$(tmp0)
val14=$val13
!for val15 =2 to 8 
tmp0=!randint $(val11[$val15])-1, $(val11[$val15])+1

val14=$[rint($val14+$(tmp0))]
tmp0=!append item $val14 to $val13

val13=$(tmp0)
!next
!for val15 =9 to 12 
tmp0=!randint $(val11[$val15]), $(val11[$val15])+1

val14=$[rint($val14-$(tmp0))]
tmp0=!append item $val14 to $val13

val13=$(tmp0)
!next
val16=$val10
val17=$[rint(0)]
!for val18 =1 to 12 
val17=$[rint(max($val17,$(val13[$val18])))]
!next
val19=$[rint(10)]
replytype1=raw
replyoption1=nocase 
replyname1=
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

