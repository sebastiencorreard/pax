!set title=Lire un graphique 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000

ansorder=r,r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim Nous avons fait un relevé de températures tous les trois jours.	  En utilisant le graphique, répondre aux questions suivantes&nbsp;	  La température la plus basse est de	  La température la plus élevée est de
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 10, 25

val7=$(tmp0)
!for val8 =1 to 9 
tmp0=!randint -5, +5

val9=$[rint($(tmp0))]
!if $(val7[$val8])+$val9>=0 and $(val7[$val8])+$val9<=30 
val10=$[rint($(val7[$val8])+$val9)]
val7=$val7,$val10
!else
val7=$val7,$(val7[$val8])
!endif
!next
tmp0=!sort numeric items $val7

val11=$(tmp0)
val12=segment 2,$(val7[1])/4,4,$(val7[2])/4,red
val13=segment 4,$(val7[2])/4,6,$(val7[3])/4,red
val14=segment 6,$(val7[3])/4,8,$(val7[4])/4,red
val15=segment 8,$(val7[4])/4,10,$(val7[5])/4,red
val16=segment 10,$(val7[5])/4,12,$(val7[6])/4,red
val17=segment 12,$(val7[6])/4,14,$(val7[7])/4,red
val18=segment 14,$(val7[7])/4,16,$(val7[8])/4,red
val19=segment 16,$(val7[8])/4,18,$(val7[9])/4,red
val20=segment 18,$(val7[9])/4,20,$(val7[10])/4,red
val21=
!for val8 =0 to 30 step 3 
val21=$val21	  text black,$val8/1.5-0.2,-0.2,small,$val8
!next
!for val8 =0 to 30 step 2 
val21=$val21	  text black,-0.7,$val8/4+0.2,small,$val8
!next
val22=fill 0,0,220,220,255
!readproc oef/draw.phtml 506,308, \
  xrange -1,22	  yrange -1,8	  $val22	  parallel 1,0,1,8,1,0,20,grey	  parallel 0,0.5,21,0.5,0,0.5,16,grey	  linewidth 2	  arrow -1,0,21,0,10,black	  arrow 0,-1,0,8,10,black	  text black,18.6,0.8,medium,Jours	  text black,0.5,7.9,medium,°C	  $val21	$val12	$val13	$val14	$val15	$val16	$val17	$val18	$val19	$val20 
tmp0=$ins_url
val23=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$(val11[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val11[10])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	  <div class="medium_size img_col">	  <img src="$val23" alt="">	  </div>	  <div class="medium_size text_col">	$(val6[1;])	$(val6[2;]):	<ul>	<li><label for="reply1">$(val6[3;])</label>  
!read oef/embed.phtml r1,3 
$() °C.</li>	<li><label for="reply2">$(val6[4;])</label>  
!read oef/embed.phtml r2,3 
$() °C.</li>	</ul>	</div></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,23
embedcnt=2
