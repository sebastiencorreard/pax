!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Nous avons fait un relevé de températures tous les trois jours.	  En utilisant le graphique, remplir le tableau&nbsp;
val7=Température en
val8=Jours
tmp0=!randint 10, 25

val9=$(tmp0)
!for val10 =1 to 9 
tmp0=!randint -5, +5

val11=$[rint($(tmp0))]
!if $(val9[$val10])+$val11>=0 and $(val9[$val10])+$val11<=30 
val12=$[rint($(val9[$val10])+$val11)]
val9=$val9,$val12
!else
val9=$val9,$(val9[$val10])
!endif
!next
val13=segment 2,$(val9[1])/4,4,$(val9[2])/4,red
val14=segment 4,$(val9[2])/4,6,$(val9[3])/4,red
val15=segment 6,$(val9[3])/4,8,$(val9[4])/4,red
val16=segment 8,$(val9[4])/4,10,$(val9[5])/4,red
val17=segment 10,$(val9[5])/4,12,$(val9[6])/4,red
val18=segment 12,$(val9[6])/4,14,$(val9[7])/4,red
val19=segment 14,$(val9[7])/4,16,$(val9[8])/4,red
val20=segment 16,$(val9[8])/4,18,$(val9[9])/4,red
val21=segment 18,$(val9[9])/4,20,$(val9[10])/4,red
val22=
!for val10 =0 to 30 step 3 
val22=$val22	  text black,$val10/1.5-0.2,-0.2,small,$val10
!next
!for val10 =0 to 30 step 2 
val22=$val22	  text black,-0.7,$val10/4+0.2,small,$val10
!next
val23=fill 0,0,220,220,255
!readproc oef/draw.phtml 506,308, \
  xrange -1,22	  yrange -1,8	  $val23	  parallel 1,0,1,8,1,0,20,grey	  parallel 0,0.5,21,0.5,0,0.5,16,grey	  linewidth 2	  arrow -1,0,21,0,10,black	  arrow 0,-1,0,8,10,black	  text black,18.6,0.8,medium,$val8	  text black,0.5,7.9,medium,°C	  $val22	$val13	$val14	$val15	$val16	$val17	$val18	$val19	$val20	$val21 
tmp0=$ins_url
val24=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$(val9[1])]
