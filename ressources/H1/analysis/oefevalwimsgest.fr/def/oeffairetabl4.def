$()<div class="wims_columns">	 <div class="medium_size img_col">	  <img src="$val24" alt="">	  </div>	  <div class="medium_size text_col">	$val6:	</div>	</div>	<table class="wimscenter wimsborder table-scroll">	 <tr><th>$val8</th>	 
!for m_i=3 to 30 step 3 
$()<td><label for="reply$m_i">$m_i</label></td> 
