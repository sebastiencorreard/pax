!set title=Lecture d'une fraction 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=1000

ansorder=r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Nous avons une demi-droite graduée. Le point indiqué par la flèche	  correspond à une fraction <strong>simple</strong>.	  Donner cette fraction&nbsp;
val7=Numérateur,Dénominateur
tmp=!nonempty items 2,4,5,10

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
val9=$[rint(1)]
val10=$[rint($val8)]
val11=$[rint(2)]
val12=$[rint(0)]
val13=0
val14=
!for val15 =$val12 to $val11 
val13=$[rint($val15*1)]
val16=$[rint($val15)]
val14=$val14	    text blue, $val16,-1, medium,$val13
!next
val17=$[rint($val8)]
val18=$[rint(1)]
t_=!rawmath $val18/$val17
val13=!exec pari print($t_)
replytype1=raw
replyname1=$(val7[1])
replygood1=$val18
replytype2=raw
replyname2=$(val7[2])
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<div class="wimscenter">	 
!read oef/special.phtml mathmlinput [\frac{reply1}{reply2}],3	reply1	reply2 
$()	</div>	<div class="wimscenter"> 
!read oef/draw.phtml 600,80 \
xrange $val12-0.1,$val11+0.1	yrange -2,2.2	segment 0,0,2.2,0,black	parallel $val12,-0.8,$val12,0.4,1/$val9,0, 40, blue	parallel $val12,-0.3,$val12,0.3,1/$val10,0, 200, blue	parallel $val12,-0.8,$val12,0.6,1,0, 40, red	$val14	arrow $val13,2,$val13,0, 8, black	 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,11,12,13,14
embedcnt=1
