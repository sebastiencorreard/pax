!set title=Faire un tableau 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
precision=10000

ansorder=r,r,r,r,r,r,r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=9
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 35, 79

val6=$(tmp0)
!for val7 =1 to 8 
tmp0=!randint 35, 79

val8=$[rint($(tmp0))]
val6=$val6,$val8
!next
val9=On a demandé aux élèves d'un collège le nombre de frères et soeurs qu'ils avaient.	<ul><li>$(val6[1]) élèves ont dit qu'ils avaient aucune soeur et aucun frère,	</li><li>$(val6[2]) élèves une soeur et aucun frère, $(val6[3]) élèves une soeur et un frère,	</li><li>$(val6[4]) élèves deux soeurs et aucun frère, $(val6[5]) élèves deux soeurs et un frère,	</li><li>$(val6[6]) élèves deux soeurs et deux frères, $(val6[7]) élèves aucune soeur et un frère,	</li><li>$(val6[8]) élèves aucune soeur et deux frères, $(val6[9]) une soeur et deux frères.	</li></ul>
val10=soeur,soeurs,frère,frères
val11=Avec les informations contenues dans ce texte, compléter le tableau suivant&nbsp;
replytype1=numeric
replyname1=
replygood1=$[$(val6[1])]
replytype2=numeric
replyname2=
replygood2=$[$(val6[2])]
replytype3=numeric
replyname3=
replygood3=$[$(val6[4])]
replytype4=numeric
replyname4=
replygood4=$[$(val6[7])]
replytype5=numeric
replyname5=
replygood5=$[$(val6[3])]
replytype6=numeric
replyname6=
replygood6=$[$(val6[5])]
replytype7=numeric
replyname7=
replygood7=$[$(val6[8])]
replytype8=numeric
replyname8=
replygood8=$[$(val6[9])]
replytype9=numeric
replyname9=
replygood9=$[$(val6[6])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val9	<p>	$val11:	</p>	<table class="wimscenter wimsborder table-scroll">	 <tr><th></th><th>0 $(val10[1])</th><th>1 $(val10[1])</th>	 <th>2 $(val10[2])</th>	</tr><tr><th>0 $(val10[3])</th>	  
!for m_i=1 to 3 
$()<td> 
!read oef/embed.phtml r\i,3 
$()</td> 
!next
$()	</tr><tr><th>1 $(val10[3])</th>	  
!for m_i=4 to 6 
$()<td> 
!read oef/embed.phtml r\i,3 
$()</td> 
!next
$()	</tr><tr><th>2 $(val10[4])</th>	  
!for m_i=7 to 9 
$()<td> 
!read oef/embed.phtml r\i,3 
$()</td> 
!next
$()	</tr></table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10,11
embedcnt=3
