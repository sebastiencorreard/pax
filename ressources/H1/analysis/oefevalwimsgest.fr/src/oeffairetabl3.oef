\format{html}
\language{fr}
\range{-5..5}

\title{Faire un tableau 3}

\text{name_instruction=Voici les âges dans une population à la suite d'une enquête&nbsp;}
\text{name_question=Compléter le tableau suivant,Nbre de personnes,
  Nombre total de personnes (Effectif total), Effectif,Nbre total de personnes,Ages}



\precision{1000}
\integer{n=randint(20..50)}
\integer{nmin=randint(30..40)}
\integer{neff=\nmin+4}
\text{liste1=slib(stat/random \n, \nmin,\neff)}
\text{liste2=wims(values x for x= \nmin to \neff+1)}
\text{E=slib(stat/effectif [\liste1],[\liste2])}
\text{E=item(1,\E)}
\text{E=wims(declosing \E)}
\text{eff1=item(1,\E)}
\text{eff2=item(2,\E)}
\text{eff3=item(3,\E)}
\text{eff4=item(4,\E)}
\text{eff5=item(5,\E)}
\text{table=<table class="wimscenter wimsborder" style="background-color:skyblue">}
\integer{nn=ceil(\n/10)}
\for{i=0 to \nn-1}
 {\text{table=\table<tr>}
 \for{j=1 to 10}
 {\text{a=item(\i*10+\j,\liste1)}
\text{table=\table<td>\a</td>}
 }
\text{table=\table</tr>}
}
\text{table=\table</table>}
\real{a1=item(1,\liste2)}
\real{a2=item(2,\liste2)}
\real{a3=item(3,\liste2)}
\real{a4=item(4,\liste2)}
\real{a5=item(5,\liste2)}
\text{tableau=<table class="wimscenter wimsborder table-scroll">}
\text{tableau=\tableau<tr><th>\name_question[6]</th>
<td><label for="reply1">\a1</label></td>
<td><label for="reply2">\a2</label></td>
<td><label for="reply3">\a3</label></td>
<td><label for="reply4">\a4</label></td>
<td><label for="reply5">\a5</label></td>
}
\text{tableau=\tableau</tr>}
\integer{efft=\eff1+\eff2+\eff3+\eff4+\eff5}
\statement{\name_instruction:
\table
\name_question[1]
\tableau
<tr><th>\name_question[2]</th>
<td>\embed{reply 1,8}</td>
<td>\embed{reply 2,8}</td>
<td>\embed{reply 3,8}</td>
<td>\embed{reply 4,8}</td>
<td>\embed{reply 5,8}</td>
</tr>
</table>
<label for="reply6">\name_question[3]&nbsp;:</label>\embed{r6,8}
}
\answer{\name_question[4] 1}{\eff1}{type=numeric}
\answer{\name_question[4] 2}{\eff2}{type=numeric}
\answer{\name_question[4] 3}{\eff3}{type=numeric}
\answer{\name_question[4] 4}{\eff4}{type=numeric}
\answer{\name_question[4] 5}{\eff5}{type=numeric}
\answer{\name_question[5]}{\efft}{type=numeric}

\text{sol=<p>Le nombre total de personnes est \(\efft\).</p>}



\solution{\(\eff1+\eff2+\eff3+\eff4+\eff5=\efft\).<p>\sol</p>}

