\text{name_instruction=Nous avons fait une enquête dans le collège sur la qualité des élèves.}
\text{name_total=Total}
\text{name_question=Répondre aux questions suivantes&nbsp;}

\text{enonc1=L'effectif des \sex[\b] en \niv[\a] est}
\text{enonc2=L'effectif des élèves du collège est}



\matrix{val=randint(30..70),randint(30..70),randint(30..70),randint(30..70)
randint(30..70),randint(30..70),randint(30..70),randint(30..70)
randint(30..70),randint(30..70),randint(30..70),randint(30..70)
randint(30..70),randint(30..70),randint(30..70),randint(30..70)}
\text{totl=}
\text{aff=}
\for{i=1 to 4}{\text{lig=row(\i,\val)}
\text{aff=\aff,\lig}
\integer{tot=\lig[1]+\lig[2]+\lig[3]+\lig[4]}
\text{totl=\totl,\tot}}
\text{totc=}
\for{i=1 to 4}{\text{col=column(\i,\val)}
\integer{tot=\col[1]+\col[2]+\col[3]+\col[4]}
\text{totc=\totc,\tot}}
\integer{tott=\totc[5]+\totc[2]+\totc[3]+\totc[4]}

\text{a=randint(1..4)}
\integer{b=randint(1..2)}
\integer{rp1=item(\a[1],row(\b*2,\val))+item(\a[1],row(\b*2-1,\val))}
\integer{rp2=\tott}
\integer{aux1=\a[1]}
\integer{aux2=\b*2}

\text{niv=6ème,5ème,4ème,3ème,Total}
\text{qual=externes, demi-pensionnaires, externes, demi-pensionnaires}
\text{sex=filles,garçons}
\text{name_instruction=Nous avons fait une enquête dans le collège sur la qualité des élèves.}
\text{name_total=Total}
\text{name_question=Répondre aux questions suivantes&nbsp;}

\text{enonc1=L'effectif des \sex[\b] en \niv[\a] est}
\text{enonc2=L'effectif des élèves du collège est}



\text{sol=On calcule le nombre de \sex[\b] en \niv[\a]&nbsp;: \(\val[\b*2-1;\a[1]]+\val[\b*2;\a[1]]=\rp1\).
<p>Il y a <mark class="yellow">\(\rp1\)</mark> \sex[\b] en \niv[\a].
<p>On lit directement la réponse dans le tableau&nbsp;: il y a <mark class="PaleGreen">\(\rp2\)</mark> élèves dans le collège.</p>}



\statement{\name_instruction
<table class="wimscenter wimsborder table-scroll">
<tr><th></th>
\for{m=0 to 5}{<th>\niv[\m]</th>}
</tr>
\for{k=1 to 4}
  {<tr>
   \if{\k=1 or \k=3}{<th colspan="1" rowspan="2">\sex[\k/2+1]</th>}
   <th>\qual[\k]</th>
   \for{j=1 to 4}{
   <td>\aff[\j+4*(\k-1)+1]</td>}
   <td>\totl[\k+1]</td></tr>}
<tr><th></th><th>\name_total</th>
\for{l=2 to 5}{<td>\totc[\l]</td>}
<td>\tott</td></tr></table>
