\title{Petit problème de pourcentage 3}

\matrix{name_m= sont internes , sont demi-pensionnaires , sont externes
  ont entre 0 &euro; et 5 &euro; d'argent de poche , ont entre 6 &euro; et 10 &euro; d'argent de poche , ont entre 11 &euro; et 20 &euro; d'argent de poche
  aiment la couleur jaune , aiment la couleur rouge , aiment la couleur bleue
  viennent à pied au collège , viennent en vélo au collège , viennent en bus au collège
  viennent au club échec du collège , viennent à la chorale du collège , viennent au club montage vidéo du collège }
\text{name_instruction=Il y a,Nous savons que,élèves dans un collège.,des élèves,
Combien d'élèves, Il y a,élèves qui}

\integer{a=randint(1..5)}
\text{m=row(\a,\name_m)}
\text{m=randomitem(\m)}

\integer{n=randint(8..20)*40}
\integer{p=75}
\integer{rep=\n*\p/100}
\integer{tmp=\n/4}
\text{sol=\(75 \%=\frac{75}{100}=\frac{3}{4}\), les trois quarts...on divise par 4 puis on multiplie par 3.<p>
Pour trouver \(75 \% \) d'un nombre, on divise le nombre par 4 puis on multiplie le résultat par 3.</p>
\((\n \div 4) \times 3 = \tmp \times 3 = \rep\)}

