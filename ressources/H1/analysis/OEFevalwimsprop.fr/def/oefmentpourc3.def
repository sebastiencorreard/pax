!set title=Calcul mental de pourcentage 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=percents, mental_calculation
precision=100000

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 24

val6=$[rint($(tmp0)*4)]
tmp0=!randitem 5,25

val7=$[rint($(tmp0))]
!if $val7=5 
val6=$[rint($val6*10)]
!endif
val8=$[rint($val6*$val7/100)]
!if $val7=5 
val9=\(5\%\) est la moitié de \(10\%\).<p>	Pour calculer \(5\%\), on commence par calculer \(10\%\) en divisant par 10 puis on divise le résultat par 2.<p>	\(5\%\) de \($val6\) font \($val6 \div 10 \div 2=$val8\)
!else
val9=\(25\%=\frac{25}{100}=\frac{1}{4}\)  le quart  on divise par 4.<p>	\($val7\%\) de \($val6\) font \($val6 \div 4 = $val8\)
!endif
!readproc slib/oef/env lang 
tmp0=$slib_out
val10=$(tmp0)
val11=Calculer mentalement.,Combien font,de,Mentalement,de,font
replytype1=numeric
replyname1=
replygood1=$[$val8]
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val9

latex=!nosubst  \begin{statement} $(val11[2]) $val7 \% $(val11[3]) $val6 ? : \dotfill \end{statement} \begin{solution} $(val11[4]) $val7 \% $(val11[5]) $val6 $(val11[6]) $val8 \end{solution} 


!goto stat

!exit

:question
$()	$(val11[1])	<div class="wims_question"><label for="reply1">$(val11[2]) $val7 % $(val11[3]) $val6 </label>:  
!read oef/embed.phtml r1,5 
$().</div>	
$()
!exit

:hint
$()Pourcentages avec lesquels il est facile de calculer :	<ul class="wims_nopuce">	<li>0% d'un nombre ..... 0<p>	<li>1% d'un nombre ...... 
!insmath 1\%=\frac{1}{100}
$() un centième...on divise le nombre par 100.</li>	<li>10% d'un nombre ...... 
!insmath 10\%=\frac{1}{10}
$() un dixième...on divise le nombre par 10.</li>	<li>25% d'un nombre ......
!insmath 25\%=\frac{25}{100}=\frac{1}{4}
$() un quart...on divise le nombre par 4.</li>	<li>50% d'un nombre ......
!insmath 50\%=\frac{50}{100}=\frac{1}{2}
$() la moitié...on divise le nombre par 2.</li>	</ul>	Penser aussi que 
!insmath 5\%
$() est la moitié de 
!insmath 10\%
$() ou que 
!insmath 75\%
$() est le triple de 
!insmath 25\%
$().
$()
!exit

:help
$()
$()
!exit

:solution
$()$val9
$()
!exit

:latex
$() $m_begin{statement} $(val11[2]) $val7 \% $(val11[3]) $val6 ? : $m_dotfill $m_end{statement} $m_begin{solution} $(val11[4]) $val7 \% $(val11[5]) $val6 $(val11[6]) $val8 $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9,11
embedcnt=1
