!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim Une cuillère à soupe de farine contient 15 g de farine et trois cuillères contiennent 45 g.,1	  Un chiot de 4 mois pèse 7 kg. A l'âge de 12 mois&#44; il pèse 12 kg.,2	  Un mètre de tissu coûte 10 &euro;. Si j'en achète une longueur de 5 m&#44; je paye 30 &euro;.,2	  Un carré de 3 m de côté a une aire de 9 mètres carrés et un carré de 6 m de côté a une aire de 36 mètres carrés.,2	  Un carré de 3 m de côté a un périmètre de 12 m et un carré de 6 m de côté a un périmètre de 24 m.,1	  Un congélateur qui a un volume de 150 litres coûte 300 &euro;&#44; un modèle de 300 litres coûte 500 &euro;.,2	  Pour un effectif de 3 personnes&#44; il faut une baguette de pain. Pour un goûter de 12 personnes&#44; j'achète 4 baguettes.,1	  Pour un effectif de 4 personnes&#44; on compte une masse de 250 g de spaghettis. Pour 12 personnes&#44; je prévois 750 g.,1	  Pour une durée d'une heure&#44; il est tombé 20 mm de hauteur d'eau de pluie. En trois heures&#44; il est tombé 60 mm.,1	  Pour une durée d'une heure&#44; il est tombé 20 mm de hauteur d'eau de pluie. En trois heures&#44; il est tombé 40 mm.,2	  Une masse de 3 kg de fraises coûte 10 &euro;. Sur l'étiquette&#44; nous pouvons lire aussi 1 kg pour 4 &euro;.,2	  Un automobiliste parcourt une distance de 120 km en 2 h. Son voyage de 240 km a une durée de 4 h.,1	  Un automobiliste parcourt une distance de 120 km en 2 h. Son voyage de 240 km a une durée de 5 h.,2	  Dans un lotissement&#44; un terrain de 800 mètres carrés d'aire coûte 120 000 &euro; et un autre de 1 200 mètres carrés coûte 160 000 &euro;.,2	  Une moto consomme en moyenne un volume de 4 litres de carburant pour 100 kilomètres. Pour parcourir 50 km&#44; elle a consommé 2 litres.,1	  Une masse de 2 kg de tomates coûte 3 &euro;. Pour 6 kg&#44; je paierai 9 &euro;.,1	  Une voiture qui roule a une vitesse de 10 km/h&#44; a besoin d'une distance de freinage de 2 m. Si elle roule à 50 km/h&#44; elle a besoin de 16 m.,2	
val7=!translate internal $	\
$ to ;; in $tmp
val8=avons,n'avons pas, je ne sais pas
tmp=!trim Dans le texte précédent, nous	des grandeurs proportionnelles.
val9=!translate internal $	\
$ to ;; in $tmp
val10=avons,n'avons pas
tmp=!trim Dans le texte précédent, nous	des grandeurs proportionnelles.
val11=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val7

tmp0=!rowcnt $tmp
val12=$[rint($(tmp0))]
tmp0=!randint 1, $val12

val13=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
!if $(val14[2])=1 
val15=$(val10[1])
!else
val15=$(val10[2])
!endif
replytype1=menu
replyname1=
replygood1=$(val14[2]);$val8
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val14[1]) $(val9[1]) \emph{$val8} $(val9[2])\par \dotfill \end{statement} \begin{solution} $(val11[1;]) \textbf{$val15} $(val11[2;]) \end{solution} 


!goto stat

!exit

