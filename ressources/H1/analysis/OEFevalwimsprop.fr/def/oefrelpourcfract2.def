!set title=Relation pourcentage et fraction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=percents, fraction
precision=100000

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Écrire la fraction sous forme de pourcentage.
tmp0=!randitem 10,20,50

val8=$[rint($(tmp0))]
tmp0=!randint 1, $val8-1

val9=$[rint($(tmp0))]
val10=$[rint(100/$val8)]
val11=$[rint($val9*$val10)]
replytype1=numeric
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7\par \[ \dfrac{$val9}{$val8}=\ldots \% \] \end{statement} \begin{solution} \[ \dfrac{$val9}{$val8}=$val11 \%\] \end{solution} 


!goto stat

!exit

:question
$()	$val7	<div class="wimscenter"><label for="reply1">
!insmath \Large{\frac{$val9}{$val8}}
$()=</label>  
!read oef/embed.phtml r1,5 
$() %</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()On transforme la fraction donnée en une fraction égale de dénominateur 100.	<p>
!insmath \frac{$val9}{$val8}=\frac{$val9 \times $val10}{$val8 \times $val10}=\frac{$val11}{100}=$val11 \%
$().</p>
$()
!exit

:latex
$() $m_begin{statement} $val7$m_par \[ $m_dfrac{$val9}{$val8}=$m_ldots \% \] $m_end{statement} $m_begin{solution} \[ $m_dfrac{$val9}{$val8}=$val11 \%\] $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=1
