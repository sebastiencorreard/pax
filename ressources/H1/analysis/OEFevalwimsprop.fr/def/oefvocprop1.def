!set title=Grandeurs proportionnelles 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=proportionality

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Placer les mots dans l'ordre pour faire une phrase correcte.
tmp=!trim Deux grandeurs, sont proportionnelles, si les valeurs de l'une, s'obtiennent, en multipliant (ou en divisant), par un même nombre non nul, les valeurs de l'autre.	  Deux grandeurs, sont proportionnelles, lorsque les valeurs de l'une, s'obtiennent, en multipliant(ou en divisant), les valeurs de l'autre, par un même nombre non nul.	  Deux grandeurs, sont proportionnelles, si l'on peut calculer, les valeurs de l'une, en multipliant (ou en divisant), les valeurs de l'autre, par un même nombre non nul.
val8=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val8

tmp0=!rowcnt $tmp
val9=$[rint($(tmp0))]
tmp0=!randint 1, $val9

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val10 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val8=$(tmp0)
tmp0=!item 1 to 4 of $val8

val11=$(tmp0)
tmp0=!item 5 to 7 of $val8

val12=$(tmp0)
tmp0=!shuffle \fbox{$(val11[1])},\fbox{$(val11[2])},\fbox{$(val11[3])},\fbox{$(val11[4])}

val13=$(tmp0)
tmp0=!shuffle \fbox{$(val12[1])},\fbox{$(val12[2])},\fbox{$(val12[3])}

val14=$(tmp0)
replytype1=dragfill
replyoption1=shuffle 
replyname1=
replygood1=$val11;$val11
replytype2=dragfill
replyoption2=shuffle 
replyname2=
replygood2=$val12;$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 : \begin{itemize} \item $val13 \item $val14 \end{itemize} \end{statement} \begin{solution} \begin{itemize} \item $val11 \item $val12 \end{itemize} \end{solution} 


!goto stat

!exit

:question
$()	$val7 :	<div class="spacer">	 
!read oef/embed.phtml r1,200x50 
$() <br> 
!read oef/embed.phtml r2,200x50 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 : $m_begin{itemize} $m_item $val13 $m_item $val14 $m_end{itemize} $m_end{statement} $m_begin{solution} $m_begin{itemize} $m_item $val11 $m_item $val12 $m_end{itemize} $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11,12,13,14
embedcnt=2
