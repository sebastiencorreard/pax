!set title=Relation pourcentage et fraction 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Associer chaque pourcentage avec la fraction qui lui correspond.
tmp0=!shuffle 2,4,5,10,20,25,50

val8=$(tmp0)
val9=$[rint(100/$(val8[1]))]
val10=$[rint(100/$(val8[2]))]
val11=$[rint(100/$(val8[3]))]
val12=$[rint(100/$(val8[4]))]
val13=$val9 %,$val10 %,$val11 %,$val12 %
val14=\(\dfrac{1}{$(val8[1])}\),\(\dfrac{1}{$(val8[2])}\),\(\dfrac{1}{$(val8[3])}\),\(\dfrac{1}{$(val8[4])}\),
tmp0=!shuffle $val14

val15=$(tmp0)
replytype1=correspond
replyname1=
replygood1=$val13;$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 \begin{center} \renewcommand{\arraystretch}{2} \begin{tabular}{rccl} $val9 \% & \textbullet & \textbullet & $(val15[1]) \\ $val10 \% & \textbullet & \textbullet & $(val15[2]) \\ $val11 \% & \textbullet & \textbullet & $(val15[3]) \\ $val12 \% & \textbullet & \textbullet & $(val15[4]) \end{tabular} \end{center} \end{statement} \begin{solution} \begin{center} \renewcommand{\arraystretch}{2} \begin{tabular}{rccl} $val9 \% & \textbullet & \textbullet & $(val14[1]) \\\ $val10 \% & \textbullet & \textbullet & $(val14[2]) \\\ $val11 \% & \textbullet & \textbullet & $(val14[3]) \\\ $val12 \% & \textbullet & \textbullet & $(val14[4]) \end{tabular} \end{center} \end{solution} 


!goto stat

!exit

:question
$()	$val7	<div class="wimscenter">	 
!read oef/embed.phtml r1,60x60x60 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 $m_begin{center} $m_renewcommand{$m_arraystretch}{2} $m_begin{tabular}{rccl} $val9 \% & $m_textbullet & $m_textbullet & $(val15[1]) \ $val10 \% & $m_textbullet & $m_textbullet & $(val15[2]) \ $val11 \% & $m_textbullet & $m_textbullet & $(val15[3]) \ $val12 \% & $m_textbullet & $m_textbullet & $(val15[4]) $m_end{tabular} $m_end{center} $m_end{statement} $m_begin{solution} $m_begin{center} $m_renewcommand{$m_arraystretch}{2} $m_begin{tabular}{rccl} $val9 \% & $m_textbullet & $m_textbullet & $(val14[1]) \\ $val10 \% & $m_textbullet & $m_textbullet & $(val14[2]) \\ $val11 \% & $m_textbullet & $m_textbullet & $(val14[3]) \\ $val12 \% & $m_textbullet & $m_textbullet & $(val14[4]) $m_end{tabular} $m_end{center} $m_end{solution} 
$()
!exit

:feedback

