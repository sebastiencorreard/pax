!set title=Relation pourcentage et fraction 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Associer chaque pourcentage avec la fraction qui lui correspond.
tmp=!trim 3	2,3,4	3,7,9	3,7,9,11,13,17,19	2,3,4,6,7,8,9,11,12,13,14,16,17,18,19,21,22,23,24	3,7,9,11,13,17,19,21,23,27,29,31,33,37,39,41,43,47,49
val8=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 6

val9=$(tmp0)
val10=4,5,10,20,25,50
tmp=!translate internal $	$ to ; in $val8

tmp=!row $(val9[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!nonempty items $(tmp0)

tmp1=!randitem $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!row $(val9[2]) of $tmp
tmp2=!translate internal $\
$ to ; in $tmp
tmp=!nonempty items $(tmp2)

tmp3=!randitem $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!row $(val9[3]) of $tmp
tmp4=!translate internal $\
$ to ; in $tmp
tmp=!nonempty items $(tmp4)

tmp5=!randitem $tmp
tmp=!translate internal $	$ to ; in $val8

tmp=!row $(val9[4]) of $tmp
tmp6=!translate internal $\
$ to ; in $tmp
tmp=!nonempty items $(tmp6)

tmp7=!randitem $tmp
val11=$(tmp1),$(tmp3),$(tmp5),$(tmp7)
val12=$[rint($(val11[1])*100/$(val10[$(val9[1])]))]
val13=$[rint($(val11[2])*100/$(val10[$(val9[2])]))]
val14=$[rint($(val11[3])*100/$(val10[$(val9[3])]))]
val15=$[rint($(val11[4])*100/$(val10[$(val9[4])]))]
val16=$val12 %,$val13 %,$val14 %,$val15 % 
val17=\(\dfrac{$(val11[1])}{$(val10[$(val9[1])])}\),\(\dfrac{$(val11[2])}{$(val10[$(val9[2])])}\),\(\dfrac{$(val11[3])}{$(val10[$(val9[3])])}\),\(\dfrac{$(val11[4])}{$(val10[$(val9[4])])}\),
tmp0=!shuffle $val17

val18=$(tmp0)
replytype1=correspond
replyname1=
replygood1=$val16;$val17
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 \begin{center} \renewcommand{\arraystretch}{2} \begin{tabular}{rccl} $val12 \% & \textbullet & \textbullet & $(val18[1]) \\ $val13 \% & \textbullet & \textbullet & $(val18[2]) \\ $val14 \% & \textbullet & \textbullet & $(val18[3]) \\ $val15 \% & \textbullet & \textbullet & $(val18[4]) \end{tabular} \end{center} \end{statement} \begin{solution} \begin{center} \renewcommand{\arraystretch}{2} \begin{tabular}{rccl} $val12 \% & \textbullet & \textbullet & $(val17[1]) \\\ $val13 \% & \textbullet & \textbullet & $(val17[2]) \\\ $val14 \% & \textbullet & \textbullet & $(val17[3]) \\\ $val15 \% & \textbullet & \textbullet & $(val17[4]) \end{tabular} \end{center} \end{solution} 


!goto stat

!exit

:question
$()	$val7	<div class="wimscenter">	 
!read oef/embed.phtml r1,60x60x60 
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 $m_begin{center} $m_renewcommand{$m_arraystretch}{2} $m_begin{tabular}{rccl} $val12 \% & $m_textbullet & $m_textbullet & $(val18[1]) \ $val13 \% & $m_textbullet & $m_textbullet & $(val18[2]) \ $val14 \% & $m_textbullet & $m_textbullet & $(val18[3]) \ $val15 \% & $m_textbullet & $m_textbullet & $(val18[4]) $m_end{tabular} $m_end{center} $m_end{statement} $m_begin{solution} $m_begin{center} $m_renewcommand{$m_arraystretch}{2} $m_begin{tabular}{rccl} $val12 \% & $m_textbullet & $m_textbullet & $(val17[1]) \\ $val13 \% & $m_textbullet & $m_textbullet & $(val17[2]) \\ $val14 \% & $m_textbullet & $m_textbullet & $(val17[3]) \\ $val15 \% & $m_textbullet & $m_textbullet & $(val17[4]) $m_end{tabular} $m_end{center} $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,12,13,14,15,17,18
embedcnt=1
