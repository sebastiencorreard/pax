!set title=Petit problème de pourcentage 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
keywords=percents
precision=100000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp=!trim sont internes , sont demi-pensionnaires , sont externes	  ont entre 0 &euro; et 5 &euro; d'argent de poche , ont entre 6 &euro; et 10 &euro; d'argent de poche , ont entre 11 &euro; et 20 &euro; d'argent de poche	  aiment la couleur jaune , aiment la couleur rouge , aiment la couleur bleue	  viennent à pied au collège , viennent en vélo au collège , viennent en bus au collège	  viennent au club échec du collège , viennent à la chorale du collège , viennent au club montage vidéo du collège 
val7=!translate internal $	\
$ to ;; in $tmp
val8=Il y a,Nous savons que,élèves dans un collège.,des élèves,	Combien d'élèves, Il y a,élèves qui
tmp0=!randint 1, 5

val9=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!row $val9 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp=!nonempty items $val10

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!randint 30, 80

val11=$[rint($(tmp0)*10)]
tmp0=!randitem 30,40,60,70,80,90

val12=$[rint($(tmp0))]
val13=$[rint($val11*$val12/100)]
val14=$[rint($val11*$val12)]
val15=\(\frac{x}{$val11}=\frac{$val12}{100}\)<p>	On utilise l'égalité des produits en croix.</p>	<ul class="wims_nopuce">	<li>\(x \times 100 = $val11 \times $val12\)</li><li>	\(x \times 100 = $val14\)</li><li>	\(x = \frac{$val14}{100}\)</li><li>	\(x = $val13\)</li></ul>
replytype1=numeric
replyname1=
replygood1=$[$val13]
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val15<p> $(val8[6]) $val13 $(val8[7]) $val10.

latex=!nosubst  \begin{statement} $(val8[1]) $val11 $(val8[3]) $(val8[2]) $val12 \% $(val8[4]) $val10. $(val8[5]) $val10 ? \par $(val8[6]) \dotfill $(val8[7]) $val10. \end{statement} \begin{solution} $(val8[6]) $val13 $(val8[7]) $val10. \end{solution} 


!goto stat

!exit

:question
$()	<div class="wims_question">	$(val8[1]) $val11 $(val8[3])	<p>$(val8[2]) $val12 % $(val8[4]) $val10.</p>	<p>$(val8[5]) $val10 ?</p>	</div>	<div class="spacer"><label for="reply1">$(val8[6])</label>  
!read oef/embed.phtml r1,5 
$()	$(val8[7]) $val10.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val15<p> $(val8[6]) $val13 $(val8[7]) $val10.
$()
!exit

:latex
$() $m_begin{statement} $(val8[1]) $val11 $(val8[3]) $(val8[2]) $val12 \% $(val8[4]) $val10. $(val8[5]) $val10 ? $m_par $(val8[6]) $m_dotfill $(val8[7]) $val10. $m_end{statement} $m_begin{solution} $(val8[6]) $val13 $(val8[7]) $val10. $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,11,12,13,15
embedcnt=1
