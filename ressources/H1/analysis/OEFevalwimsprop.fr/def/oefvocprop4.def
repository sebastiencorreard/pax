val10=$[rint($(tmp0))]
tmp0=!randint 1, $val10

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
