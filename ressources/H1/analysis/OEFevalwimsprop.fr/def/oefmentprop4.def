!set title=Petit problème de proportionnalité 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=proportionality
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
precision=100000

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=de pommes,de fraises,d'abricots,de prunes,de pêches,de poires,d'oranges,de framboises,de nectarines,de cerises
val8=On sait que,coûte,Combien coûte,On peut dire que
tmp0=!randint 1, 10

val9=$[rint($(tmp0))]
val10=$(val7[$val9])
tmp0=!randint 2, 8

val11=$[rint($(tmp0))]
tmp0=!shuffle 2,3,5,7,11,13,17,19

val12=$(tmp0)
val13=$[rint($(val12[1]))]
val12=$[rint($(val12[2]))]
val14=$[rint($val11*$val12)]
val15=$[rint($val11*$val13)]
val16=\($val12 \ \kg\) coûtent \($val14 \ \euro\) donc \(1 \ \kg\) coûte \(\frac{$val14}{$val12}=$val11 \ \euro\).	<p>Ainsi, \($val13 \ \kg\) coûtent \($val13 \times $val11 = $val15 \ \euro\).</p>
!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=de pommes,de fraises,d'abricots,de prunes,de pêches,de poires,d'oranges,de framboises,de nectarines,de cerises
val8=On sait que,coûte,Combien coûte,On peut dire que
val17=$[$val14*$val13/$val12]
replytype1=numeric
replyname1=
replygood1=$[$val15]
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst C'est une situation de proportionnalité. <p>$val16</p> $(val8[4]) $val13 kg $val10 $(val8[2]) $val17 &euro;.

latex=!nosubst  \begin{statement} $(val8[1]) $val12 kg $val10 $(val8[2]) $val14 &euro;. $(val8[3]) $val13 kg ?\par $val13 kg $val10 $(val8[2]) \dotfill &euro; \end{statement} \begin{solution} $(val8[4]) $val13 kg $val10 $(val8[2]) $val15 &euro;. \end{solution} 


!goto stat

!exit

:question
$()	<div class="wims_question">	$(val8[1]) $val12 kg $val10 $(val8[2]) $val14 &euro;.	$(val8[3]) $val13 kg ?	</div>	<div class="spacer">	<label for="reply1">$(val8[4]) $val13 kg $val10 $(val8[2])</label>	   
!read oef/embed.phtml r1,5 
$() &euro;.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()C'est une situation de proportionnalité. <p>$val16</p> $(val8[4]) $val13 kg $val10 $(val8[2]) $val17 &euro;.
$()
!exit

:latex
$() $m_begin{statement} $(val8[1]) $val12 kg $val10 $(val8[2]) $val14 &euro;. $(val8[3]) $val13 kg ?$m_par $val13 kg $val10 $(val8[2]) $m_dotfill &euro; $m_end{statement} $m_begin{solution} $(val8[4]) $val13 kg $val10 $(val8[2]) $val15 &euro;. $m_end{solution} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10,12,13,14,15,16,17
embedcnt=1
