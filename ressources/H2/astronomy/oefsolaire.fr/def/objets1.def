!set title=Objets du système solaire
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=chantal.causse@noos.fr
keywords=solar_system, planet, moon

ansorder=r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(6)]
val7=$[rint(140)]
val8=$[rint(300)]
val9=$[rint(128)]
tmp=!trim Soleil<p class="wims_credits">Crédit : Skylab/NASA</p>,<img src="$val1/41.jpg" alt="">	Mercure<p class="wims_credits">Crédit : NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington</p>,<img src="$val1/img03.jpg" alt="">	Venus<p class="wims_credits">Crédit : C.J.Hamilton/NASA</p>,<img src="$val1/152.gif" alt="">	Terre<p class="wims_credits">Crédit : NASA</p>,<img src="$val1/190.jpg" alt="">	Lune (face visible)<p class="wims_credits">Crédit : F.Colas/Pic du Midi/IMCCE</p>,<img src="$val1/192.jpg" alt="">	Lune (face cachée)<p class="wims_credits">Crédit : Apollo16/NASA</p>,<img src="$val1/614.jpg" alt="">	Mars<p class="wims_credits">Crédit : P.James/NASA/STSCI</p>,<img src="$val1/73.jpg" alt="">	Jupiter<p class="wims_credits">Crédit : NASA</p>,<img src="$val1/59.jpg" alt="">	Saturne<p class="wims_credits">Crédit : ESO</p>,<img src="$val1/eso0204a.jpg" alt="">	Uranus<p class="wims_credits">Crédit : ESO</p>,<img src="$val1/eso0237a.jpg" alt="">	Neptune<p class="wims_credits">Crédit : Voyager/NASA</p>,<img src="$val1/86.jpg" alt="">	Pluton<p class="wims_credits">Crédit : HST/STSCI</p>,<img src="$val1/105.jpg" alt="">	{[Comète de Hale-Bopp<p class="wims_credits">Crédit : ESO/E. Slawik</p>,<img src="$val1/img01.jpg" alt="">],[Comète de Halley<p class="wims_credits">Crédit : ESO</p>, <img src="$val1/img02.jpg" alt="">]}	Astéroïde ITOKAWA<p class="wims_credits">Crédit : JAXA</p>,<img src="$val1/eso1405c.jpg" alt="">	Titan (satellite de Saturne)<p class="wims_credits">Crédit : ESO/J.L.Beuzit et al./SPHERE Consortium</p>,<img src="$val1/eso1417b.jpg" alt="">	Comète Tchouri<p class="wims_credits">Crédit : ESA/Rosetta/NAVCAM</p>,<img src="$val1/img04.jpg" alt="">
val10=!translate internal $	\
$ to ;; in $tmp
val11=Associer les objets du système solaire à leurs photos.
tmp0=!item 1 of 1 oui, 2 non

val12=$(tmp0)
tmp0=!word 1 of $val12

val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp0=!rowcnt $tmp
val13=$[rint($(tmp0))]

!ifval $val6>$val13
val6=$[rint($val13)]
!endif
tmp0=!shuffle $val13

tmp1=!item 1 to $val6 of $(tmp0)

val14=$(tmp1)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
val15=[]
tmp0=!char 1 of $val15

val16=$(tmp0)
tmp0=!char 2 of $val15

val17=$(tmp0)

!ifval $val12=1
tmp0=!embraced randitem $val10

val10= $(tmp0)
!endif
tmp0=!replace internal $val16 by  in $val10

val10=$(tmp0)
tmp0=!replace internal $val17 by  in $val10

val10=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val19=$(tmp0)
val20=$(val7[])x$(val8[])x$val9

!ifval $val12=1
tmp0=!embraced randitem $val11

val11= $(tmp0)
!endif
replytype1=correspond
replyname1=La réponse
replygood1=$val18;$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val11	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val20 
$()	</div>
$()
!exit

