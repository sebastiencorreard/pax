!set title=Les objets du système solaire et leur densité
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=chantal.causse@noos.fr
keywords=solar_system, densité 

ansorder=r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r,r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=20
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=
val6=$[rint(4)]
val7=200x70
val8=Saturne<br>Masse : \(5.68*10^26) kg<br>Rayon moyen : 58 200 km,	Uranus<br>Masse : \(8.68*10^25) kg<br>Rayon moyen : 25 400 km,	Jupiter<br>Masse : \(1.90*10^27) kg<br>Rayon moyen : 69 900 km,	Soleil<br>Masse : \(2*10^30) kg<br>Rayon moyen : 700 000 km,	Neptune<br>Masse : \(1.02*10^26) kg<br>Rayon moyen : 24 600 km,	Lune<br>Masse : \(7.35*10^22) kg<br>Rayon moyen : 1 738 km,	Mars<br>Masse : \(6.42*10^23) kg<br>Rayon moyen : 3 390 km,	Vénus<br>Masse : \(4.87*10^24) kg<br>Rayon moyen : 6 050 km,	Mercure<br>Masse : \(3.30*10^23) kg<br>Rayon moyen : 2 440 km,	Terre<br>Masse : \(5.97*10^24) kg<br>Rayon moyen : 6 370 km
val9=Ranger ces objets du système solaire en ordre de densité croissante.
tmp0=!item 2 of 1 oui, 2 non

val10=$(tmp0)
tmp0=!word 1 of $val10

val10=$(tmp0)

!ifval $val10=1 
tmp0=!embraced randitem $val8

val8= $(tmp0)
!endif
tmp0=!itemcnt $val8

val11=$[rint($(tmp0))]
val6=$[rint(min(20,min($val6,$val11)))]
!if $val6<$val11 
tmp0=!shuffle $val11

val12=$(tmp0)
tmp0=!sort numeric items $(val12[1..$val6])

val12=$(tmp0)
tmp0=!item $val12 of $val8

val8=$(tmp0)
!endif
tmp0=!makelist r x for x=1 to $val6

val13=$(tmp0)
oefsteps=$val13 
nextstep=!nosubst $val13 
!readproc oef/steps.proc
