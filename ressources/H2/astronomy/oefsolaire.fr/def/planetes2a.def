credits=
val6=Ranger les planètes le long de la flèche en les classant de la plus petite à la plus grande.<br>	Le nom de chaque planète (au-dessus de la flèche) doit être associé à son diamètre.
val7=6
val8=blue
val9=100
val10=$[rint(40)]
val11=$[rint(1)]
val12=0
val13=4 900 km,Mercure	6 800 km,Mars	12 100 km,Vénus	12 700 km,Terre	49 200 km,Neptune	50 700 km,Uranus	116 000 km,Saturne	140 000 km,Jupiter
tmp0=!item 2 of 1 oui, 2 non

val14=$(tmp0)
tmp0=!word 1 of $val14

val14=$(tmp0)
val15=$[$val7-0.3]
val16=-1,$val7+1

!ifval $val12 iswordof 0 
val17= -5,5
!else
val17=-2,5
!endif

!ifval $val12=1 
val17= -5,2
!endif

!ifval $val12=3 
val17= -5,4
!endif
tmp=!translate internal $	$ to ; in $val13

tmp0=!rowcnt $tmp
val18=$(tmp0)
tmp0=!shuffle $val18

val19=$(tmp0)
val19=$(val19[1..$val7])
tmp0=!sort numeric item $val19

val19=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row $val19 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)

!ifval $val14=1 
tmp0=!embraced randitem $val13

val13= $(tmp0)
!endif
tmp=!trim $val13
val20=!translate internal $	\
$ to ;; in $tmp
val21=$[rint((1.5*$val9)*($val15+1))]
val22=$[rint(4*$val10)]
val21=$val21,$val22
val23=xrange $val16	yrange $val17	polyline $val8,$val15,$val11/2,-1,$val11/2,-1,-$val11/2,$val15,-$val11/2,$val15,-$val11,$val7+0.5,0,$val15,$val11,$val15,$val11/2	fill 0,0,$val8	

!ifval $val12=0 
tmp0=!values x for x=1 to 2*$val7

val24= $(tmp0)
!endif

!ifval $val12=1 
tmp0=!values 2*x-1 for x=1 to $val7

val24= $(tmp0)
!endif

!ifval $val12=2 or $val12=3
tmp0=!values 2*x for x=1 to $val7

val24= $(tmp0)
!endif
tmp0=!makelist r x for x in  $val24

val24=$(tmp0)
val25=
val26=
val27=
!for val28 =0 to $val7-1 

!ifval $val12=0 or $val12=1 or $val12=3 
val23= $val23	  segment $val28-0.1,-$val11/2,$val28-0.1,-2*$val11,$val8
!endif

!ifval $val12=0 or $val12=2 or $val12=3
val23= $val23	  segment $val28-0.1,$val11/2,$val28-0.1,2*$val11,$val8
!endif
t_=!replace internal \( by ( in [2*$val28+1,2*$val28+2]
tmp0=!exec pari $t_

val29=$(tmp0)
!readproc slib/draw/convpixel $val28-0.5,-2,$val21,$val16,$val17,0,pixels 
tmp0=$slib_out
val30=$(tmp0)
val25=$val25	 r$(val29[1]),$(val30[1]) x $(val30[2])
!readproc slib/draw/convpixel $val28-0.5,-2,$val21,$val16,$val17,0,pixels 
tmp0=$slib_out
val30=$(tmp0)
val27=$val27	 r$(val29[2]),$(val30[1]) x $(val30[2])
!readproc slib/draw/convpixel $val28-0.5,4,$val21,$val16,$val17,0,pixels 
tmp0=$slib_out
val30=$(tmp0)
val26=$val26	r$(val29[2]),$(val30[1]) x $(val30[2])

!ifval $val12=3
val23= $val23	 text black, $val28-0.2,3,medium,$(val13[$val28+1;1])
!endif
!next

!ifval $val12=1 or $val12=0
val31= $val25
!endif

!ifval $val12=2 or $val12=0
val31= $val31	 $val26
!endif

!ifval $val12=3
val31= $val27
!endif
!readproc oef/draw.phtml $val21 \
$val23 
tmp0=$ins_url
val32=$(tmp0)
oefsteps=$val24 
nextstep=!nosubst $val24 
!readproc oef/steps.proc
