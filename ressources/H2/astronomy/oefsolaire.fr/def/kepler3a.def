$()	$val7	
!if $m_step = 1 
$()$val21 
!else
$() Le calcul fait à la première question montre que $val19 <br> 
!endif
$()	
!if $m_step = 2 
$()$val35<br>	
!if $val8 = 1 
$()La période de révolution de ce satellite autour de la Terre sera de  
!read oef/embed.phtml reply 2,3 
$() heures et  
!read oef/embed.phtml reply 3,2 
$() minutes (arrondir à la minute entière). 
!endif
$()	
!if $val8 = 2 
$()La troisième loi de Képler permet de calculer la période de révolution de $(val37[1]) autour du Soleil :  
!read oef/embed.phtml reply 2,3 
$() jours  (arrondir à l'entier). 
!endif
$()	 
!endif
$()	
$()
