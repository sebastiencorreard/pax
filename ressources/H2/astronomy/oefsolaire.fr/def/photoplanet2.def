!set title=Trouver le nom d'une planète d'après une photo
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Chantal,Causse
email=chantal.causse@noos.fr
keywords=solar_system, planet 

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Quel est le nom de cette planète du système solaire ?	<div class="wims_instruction"> Une indication sur l'origine de ce nom est donnée dans l'aide.</div>
val7=img03.jpg,Mercure,NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington,Nom du messager des dieux chez les Romains&#44;  donné à cette planète en raison de sa rapidité de déplacement (ou de sa proximité au Soleil).	152.gif,Venus,C.J.Hamilton/NASA,Nom de la déesse romaine de l'amour et de la beauté&#44;  donné à la planète qui était considérée comme la plus belle du ciel par les Romains.	190.jpg,Terre,NASA,Son nom vient du mot latin désignant un lien sec&#44;  par opposition à la mer.	73.jpg,Mars,P.James/NASA/STSCI,Nom du dieu romain de la guerre&#44;  donné à cette planète en raison de sa couleur rouge.	59.jpg,Jupiter,NASA,Nom du dieu romain de la foudre et du tonnerre.	eso0204a.jpg,Saturne,ESO,Nom du dieu romain du temps qui passe&#44;  car cette planète a un déplacement très lent.	eso0237a.jpg,Uranus,ESO,Nom du dieu romain du ciel.	86.jpg,Neptune,Voyager/NASA,Nom du dieu romain de la mer.
val8=$[rint(4)]
val9=128
val10=128
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val12=$(val11[1])
tmp0=!lowercase $val12

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val13=$(tmp2)
val14=$(val11[3])
val15=$(val11[4])
val11=$(val11[2])
tmp=!translate internal $	$ to ; in  $val7

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp0=!listcomplement $val11 in $val16

val17=$(tmp0)
tmp0=!shuffle $val17

val17=$(tmp0)
val17=$(val17[1..$val8])
credits=Crédit photographique : $val14
replytype1=clickfill
replyname1=
replygood1=$val11;$val17
question=__EXECUTED_1692754_EXERCISE__
help=!nosubst $val15


!goto stat

!exit

:question
$()	$val6	<p class="wimscenter">	
!if $val13 isitemof png,gif,jpg,jpeg 
$()	   
!read oef/img.phtml $val1/$val12  
$()	   
!else
$()	   $val12 
!endif
$()</p>		<div class="wimscenter">	 
!read oef/embed.phtml r1,$val10 x $val9 
$()	</div>		
$()
!exit

:hint
$()
$()
!exit

:help
$()$val15
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,9,10,12,13,15
embedcnt=1
