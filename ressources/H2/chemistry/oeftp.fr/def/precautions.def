!set title=Reconnaitre les précautions à prendre suivant les pictogrammes de sécurité.
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Thierry, Tousch;Marie-joëlle,Ramage
email=tousch.thierry@mailoo.org
keywords=pictogramme,sécurité

ansorder=r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Associer la précaution à prendre à chacun des pictogrammes de sécurité présentés.
credits=
val7=$[rint(5)]
val8=$[rint(70)]
val9=$[rint(70)]
val10=$[rint(400)]
tmp=!trim <img src="$val1/comburant.jpg">, Tenir à l'écart des combustibles.	<img src="$val1/corrosif.jpg">, Porter des lunettes.	<img src="$val1/environnement.jpg">, Éviter le rejet dans l'environnement.	<img src="$val1/explosif.jpg">, Éviter les chocs et les frictions.	<img src="$val1/gaz.jpg">, Ne pas percer.	<img src="$val1/inflammable.jpg">, Éviter tout contact avec les sources d'allumage.	<img src="$val1/silhouete.jpg">, Utiliser le matériel adéquat pour toute manipulation.	<img src="$val1/toxique.jpg">, Proscrire l'ingestion et l'inhalation.
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!item 1 of 1 oui, 2 non

val12=$(tmp0)
tmp0=!word 1 of $val12

val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp0=!rowcnt $tmp
val13=$[rint($(tmp0))]

!ifval $val7>$val13
val7=$[rint($val13)]
!endif
tmp0=!shuffle $val13

tmp1=!item 1 to $val7 of $(tmp0)

val14=$(tmp1)
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val14 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)

!ifval $val12=1
tmp0=!embraced randitem $val11

val11= $(tmp0)
!endif
tmp=!translate internal $	$ to ; in $val11

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$(val8[])x$(val9[])x$val10

!ifval $val12=1
tmp0=!embraced randitem \explain

val18= $(tmp0)
!endif
replytype1=correspond
replyoption1=split 
replyname1=La réponse
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="wims_question">$val6	<div class="wimscenter">	 
!read oef/embed.phtml reply 1,$val17 
$()	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,17
embedcnt=1
