 !exit
!endif

credits=https://commons.wikimedia.org/wiki
val6=Erlenmeyer.jpg, erlenmeyer,l'	Ballon.jpg, ballon, le	Becher.jpg, bécher,le	Cristallisoir.jpg, cristallisoir,le	Eprouvette.jpg, éprouvette,l'	Pipetteplastique.jpg, pipette,la	Pissette.jpg, pissette,la	Tubeaessai.jpg, tube à essai,le	Verreapied.jpg, verre à pied,le
val7=$[rint(4)]
val8=100
!if $val8 notsametext  
tmp0=!nospace $val8 px

val8=style="height:$(tmp0)"
!endif
tmp0=!embraced randitem $val6

val6=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp0=!rowcnt $tmp
val9=$(tmp0)
val10=
!while $val10 issametext  
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val10=$(val11[2])
!endwhile
val12=$(val11[1])
tmp0=!lowercase $val12

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val13=$(tmp2)
val14=$(val11[3])
val15=$val14 $val10
val15=$val14 $val10
!if $val14 issametext l' 
tmp0=!nospace $val15

val15=$(tmp0)
!endif
!readproc slib/lang/frapostrophe de $val15 
tmp0=$slib_out
val15=$(tmp0)
val16=Cliquer sur l'image <span class="wims_emph">$val15</span>.
tmp=!translate internal $	$ to ; in $val6

tmp=!column 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val6

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)
tmp0=!positionof item $val10 in $val18

val19=$(tmp0)
tmp0=!makelist x for x=1 to $val9

val20=$(tmp0)
tmp0=!shuffle $val20

val20=$(tmp0)
val20=$(val20[1..$val7])
tmp0=!listintersection $val19 and $val20

val21=$(tmp0)
!if $val21= 
tmp0=!itemcnt $val19

val22=$[rint($(tmp0))]

!ifval $val22 >1 
tmp=!nonempty items $val19

tmp0=!randitem $tmp
val19= $(tmp0)
!endif
val20=$val19,$(val20[1..$val7-1])
tmp0=!shuffle $val20

val20=$(tmp0)
!endif
tmp=!trim $val6
val6=!translate internal $	\
$ to ;; in $tmp
val17=$(val6[$val20;1])
val18=$(val6[$val20;2])
tmp0=!itemcnt $val17

val7=$(tmp0)
val23=
!for val24 =1 to $val7 

!ifval / isin $(val17[$val24]) 
tmp0=!append item $(val17[$val24]) to $val23

val23= $(tmp0)
!else
tmp1=!append item $val1/$(val17[$val24]) to $val23

val23=	  $(tmp1)
!endif
!next
tmp0=!makelist imgrename(x $val8) for x in $val23

val17=$(tmp0)
tmp0=!positionof item $val10 in $val18

val19=$(tmp0)
replytype1=multipleclick

replyoption1=shuffle 
replyname1=
replygood1=$val19;$val17
