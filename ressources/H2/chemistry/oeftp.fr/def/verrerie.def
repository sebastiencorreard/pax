!set title=Ecrire le nom d'un matériel de verrerie 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jolène, Pulvar
email=marie-joelle.ramage@universite-paris-saclay.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=https://commons.wikimedia.org/wiki
tmp=!trim Erlenmeyer.jpg, Erlenmeyer	Ballon.jpg, Ballon	Becher.jpg, Bécher	Cristallisoir.jpg, Cristallisoir	Eprouvette.jpg, Éprouvette	Pipetteplastique.jpg, Pipette	Pissette.jpg, Pissette	Tubeaessai.jpg, Tube à essai	Verreapied.jpg, Verre à pied
val6=!translate internal $	\
$ to ;; in $tmp
val7=Écrire le nom de cet objet sans article et au singulier.
val8=40
tmp=!translate internal $	$ to ; in $val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!embraced randitem $val9

val9=$(tmp0)
val10=$(val9[1])
tmp0=!lowercase $val10

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val11=$(tmp2)
val9=$(val9[2])
replytype1=nocase
replyname1=
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p>$val7</p>	  <p class="wimscenter">	    
!if $val11 isitemof png,gif,jpg,jpeg 
$()	       
!read oef/img.phtml $val1/$val10  
$()	     
!else
$()	     $val10 
!endif
$()	  </p>	  <div class="wimscenter">	        
!read oef/embed.phtml r1,$val8	      default 
$()	  </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,7,8,10,11
embedcnt=1
