!set title=Trouver le nom d'un matériel de verrerie donné parmi une liste
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Marie-joëlle, Ramage
email=marie-joelle.ramage@u-psud.fr

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

credits=https://commons.wikimedia.org/wiki
val6=Glisser-déposer l'étiquette du nom de l'objet présenté	  sous l'image.
val7=Erlenmeyer.jpg, erlenmeyer,l'	Ballon.jpg, ballon, le	Becher.jpg, bécher,le	Cristallisoir.jpg, cristallisoir,le	Eprouvette.jpg, éprouvette,l'	Pipetteplastique.jpg, pipette,la	Pissette.jpg, pissette,la	Tubeaessai.jpg, tube à essai,le	Verreapied.jpg, verre à pied,le
val8=$[rint(3)]
val9=40
val10=200
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val12=$(val11[1])
tmp0=!lowercase $val12

tmp1=!replace internal . by , in $(tmp0)

tmp2=!item 2 of $(tmp1)

val13=$(tmp2)
val11=$(val11[2])
tmp=!translate internal $	$ to ; in  $val7

tmp=!column 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!listcomplement $val11 in $val14

val15=$(tmp0)
tmp0=!shuffle $val15

val15=$(tmp0)
val15=$(val15[1..$val8])
replytype1=clickfill
replyname1=
replygood1=$val11;$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  <p>$val6</p>	  <p class="wimscenter">	    
!if $val13 isitemof png,gif,jpg,jpeg 
$()	       
!read oef/img.phtml $val1/$val12  
$()	     
!else
$() $val12 
!endif
$()	  </p>		  <p class="wimscenter">	     
!read oef/embed.phtml r1,$val10 x $val9 
$()	  </p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,6,9,10,12,13
embedcnt=1
