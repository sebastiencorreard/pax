\text{instruction=Écrire le nom de cet objet sans article et au singulier.}
:La taille des cases en pixels.
\text{sizeh=40}
:%%%%%%%%%%%%% Maintenant l'énoncé en code html. %%%%%%%%%%%%%%%%%%%%
\text{mot = randrow(\data)}
\text{mot=wims(embraced randitem \mot)}
\text{image=\mot[1]}
\text{ext=item(2,wims(replace internal . by , in wims(lowercase \image)))}
\text{mot =\mot[2]}
\statement{
<p>\instruction</p>
  <p class="wimscenter">
    \if{\ext isitemof png,gif,jpg,jpeg}{
      \img{\imagedir/\image}
    }
    {\image}
  </p>
  <div class="wimscenter">
       \embed{r1,\sizeh
      default}
  </div>
}
\answer{}{\mot}{type=nocase}
