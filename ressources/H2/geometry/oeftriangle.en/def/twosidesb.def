val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
val9=$[rint(max($val7,$val8))]
val10=$[rint(min($val7,$val8))]

!ifval $val7>$val8
val11=AB
!else
val11=BC
!endif

!ifval $val7>$val8
val12=BC
!else
val12=AB
!endif
val13=$[$val9^2+$val10^2]
val14=$[$val9^2-$val10^2]
val15=$[sqrt($val13)]
val16=$[sqrt($val14)]
val17=$[rint((ceil($val15)-1) - (floor($val16)+1) + 1)]
val18=$[rint(($val7+$val8-1) - (floor($val15)+1) + 1)]
val19=$[rint((ceil($val16)-1) - ($val9-$val10+1) + 1)]

!ifval $val19<0
val19=$[rint(0)]
!endif
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val20=$[rint($(tmp0))]
val21=acute, obtuse
val22=In order that \(A B C\) be an acute triangle, \(A C^2\) must be more than	  \($val11^2-$val12^2=$val14=$val14\) and less than	  \(A B^2+B C^2=$val13\), by Pythagorean Theorem.
val23=In order that \(A B C\) be a triangle, \(A C\) must be at least	  $val9-$val10+1 and at most $val7+$val8-1.<p>	  When $val11 is the longest side of the triangle, \(A C\) must be less than $val16 by	  Pythagorean Theorem. When \(A C\) is the longest side, it must be more than $val15,	  again by Pythagorean Theoerem.</p><p>	  Therefore, there are $val19 (resp. $val18) obtuse triangles whose	  longest side is $val11 (resp. \(A C\)).</p>
tmp=!trim How many	  triangles \(A B C\) are there, with \(A C\) an integer and
val24=!translate internal $	\
$ to ;; in $tmp
val25=Number of triangles
!if $val6=fr 
val21=aigus, obtus
val22=Pour que \(A B C\) soit un triangle aigu, \(A C^2\) doit être plus grand que	  \($val11^2-$val12^2=$val14\) et plus petit que	  \(A B^2+B C^2=$val13\), par le théorème de Pythagore.
val23=Pour que \(A B C\) soit un triangle, \(A C\) doit être au moins	  $val9-$val10+1 et au plus $val7+$val8-1. <p>	  Quand $val11 est le côté le plus long du triangle, \(A C\) doit être plus petit que $val16	  par le théorème de Pythagore. Quand \(A C\) est le côté le plus long, il doit être	  plus grand que $val15, encore par le théorème de Pythagore. </p><p>	  Donc, il y a $val19 (resp. $val18) triangles obtus ayant des côtés de longueur entière	  et dont le côté le plus long est $val11 (resp. \(A C\)).</p>
tmp=!trim Combien y a-t-il de triangles	  \(A B C\), avec \(A C\) entier et
val24=!translate internal $	\
$ to ;; in $tmp
val25=Nombre de triangles
!endif
!if $val6=nl 
val21=acute, obtuse
val22=Om \(A B C\) een scherphoekige driehoek te laten zijn, moet \(A C^2\) meer zijn dan	  \($val11^2-$val12^2=$val14=$val14\) en minder dan	  \(A B^2+B C^2=$val13=$val13\) zijn, de stelling vam Pythagoras.
val23=Om \(A B C\) een driehoek te laten zijn, moet \(A C\) op zijn minst	  $val9-$val10+1 zijn en maximaal $val7+$val8-1.<p>	  Als $val11 de langste zijde is van de driehoek, moet \(A C\) (stelling van Pythagoras)	  minder zijn dan $val16.	  Als \(A C\) de langste zijde is, moet deze langer zijn dan $val15	  (wederom de stelling van Pythagoras),</p><p>	  Hierdoor zijn $val19 (respectievelijk. $val18) stompe driehoeken,	  met als langste zijde $val11 (resp. \(A C\)).</p>
tmp=!trim Hoeveel	  driehoeken \(A B C\) zijn er, met \(A C\) een integer,
val24=!translate internal $	\
$ to ;; in $tmp
val25=Aantal Driehoeken
!endif
tmp0=!item $val20 of $val21

val26=$(tmp0)
tmp0=!item $val20 of $val17,$val18+$val19

val27=$[rint($(tmp0))]

!ifval $val20=1
val28=$val22
!else
val28=$val23
!endif
replytype1=default
replyname1=$val25
replygood1=$val27
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst $val28


!goto stat

