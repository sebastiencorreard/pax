!set title=Type recognition I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Reconnaissance de types I
title_nl=Driehoek Herkenning I

ansorder=c
varcnt=32
prevarcnt=31
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=It is a right triangle
val8=It is an acute triangle
val9=It is an obtuse triangle
val10=It is not a triangle
val11=How is a ``triangle'' \(A B C\) with 3 sides
val12=The triangle 
!if $val6=fr 
val7=C'est un triangle rectangle
val8=C'est un triangle aigu
val9=C'est un triangle obtus
val10=Ce n'est pas un triangle
val11=Quel est le type du ``triangle'' \(A B C\) (s'il existe) dont les 3 côtés vérifient
val12=Le triangle 
!endif
!if $val6=nl 
val7=Het is een rechthoekige driehoek
val8=Het is een driehoek met een scherpe hoek
val9=Het is een driehoek met een stompe hoek
val10=Het is geen driehoek
val11=Tot welke soort behoort de ``driehoek'' \(A B C\) met 3 zijden
val12=De driehoek
!endif
tmp0=!randint 1, 4

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val7,$val8,$val9,$val10

val14=$(tmp0)
tmp=!trim 3,4,5	6,8,10	9,12,15	12,16,20	15,20,25	5,12,13	10,24,26	7,24,25	
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val15

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!item 1 of $val15

tmp1=!randint 5, 15

tmp2=!randint 4, 13

tmp3=!randint 3, 10

tmp4=!item $val13 of $(tmp0),$(tmp1),$(tmp2),	 $(tmp3)

val16=$[rint($(tmp4))]
tmp0=!item 2 of $val15

tmp1=!randint 5, 15

tmp2=!randint 4, 13

tmp3=!randint 3, 10

tmp4=!item $val13 of $(tmp0),$(tmp1),$(tmp2),	 $(tmp3)

val17=$[rint($(tmp4))]
tmp0=!item 3 of $val15

tmp1=!randint max($val16,$val17), ceil(sqrt($val16^2+$val17^2))-1

tmp2=!randint floor(sqrt($val16^2+$val17^2))+1, $val16+$val17-1

tmp3=!randint $val16+$val17+1, $val16+$val17+6

tmp4=!item $val13 of $(tmp0),	 $(tmp1),	 $(tmp2),	 $(tmp3)

val18=$[rint($(tmp4))]
tmp0=!shuffle $val16,$val17,$val18

val19=$(tmp0)
tmp0=!item 1 of $val19

val20=$[rint($(tmp0))]
tmp0=!item 2 of $val19

val21=$[rint($(tmp0))]
tmp0=!item 3 of $val19

val22=$[rint($(tmp0))]
val23=$val7,$val8,$val9,$val10
choicename1=$val12 :
choicegood1=$val14
choicebad1=$val23
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val11	<div class="wimscenter">	 
!insmath A B = $val20
$() , 
!insmath B C = $val21
$(), 
!insmath C A = $val22
$() ?	</div>
$()
!exit

