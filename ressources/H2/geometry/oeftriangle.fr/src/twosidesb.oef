\title{Deux côtés aigus}

\language{fr}
\range{-5..5}
\author{Gang, XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\observation{Exercice demandant de la réflexion ayant une indication après une réponse fausse.}
\integer{ab=random(10..40)}
\integer{bc=random(10..40)}
\integer{max=max(\ab,\bc)}
\integer{min=min(\ab,\bc)}
\text{long=\ab>\bc?AB:BC}
\text{short=\ab>\bc?BC:AB}
\real{q1=\max^2+\min^2}
\real{q2=\max^2-\min^2}
\real{sq1=sqrt(\q1)}
\real{sq2=sqrt(\q2)}
\integer{n1=(ceil(\sq1)-1) - (floor(\sq2)+1) + 1}
\integer{n2=(\ab+\bc-1) - (floor(\sq1)+1) + 1}
\integer{n3=(ceil(\sq2)-1) - (\max-\min+1) + 1}
\integer{n3=\n3<0?0}
\integer{o=randitem(1,2)}

\text{name_acute=aigus, obtus}
\text{ans1=Pour que \(A B C\) soit un triangle aigu, \(A C^2\) doit être plus grand que
  \(\long^2-\short^2=\q2\) et plus petit que
  \(A B^2+B C^2=\q1\), par le théorème de Pythagore.}
\text{ans2=Pour que \(A B C\) soit un triangle, \(A C\) doit être au moins
  \max-\min+1 et au plus \ab+\bc-1. <p>
  Quand \long est le côté le plus long du triangle, \(A C\) doit être plus petit que \sq2
  par le théorème de Pythagore. Quand \(A C\) est le côté le plus long, il doit être
  plus grand que \sq1, encore par le théorème de Pythagore. </p><p>
  Donc, il y a \n3 (resp. \n2) triangles obtus ayant des côtés de longueur entière
  et dont le côté le plus long est \long (resp. \(A C\)).</p>}
\matrix{name_instruction=Combien y a-t-il de triangles
  \(A B C\), avec \(A C\) entier et}
\text{name_answer=Nombre de triangles}

\text{type=item(\o,\name_acute)}
\integer{n=item(\o,\n1,\n2+\n3)}
\text{ans=\o=1?\ans1:\ans2}
\statement{\name_instruction[1;] \type \name_instruction[2;]
<div class="wimscenter">
  \(A B = \ab\), \(B C = \bc\)&nbsp;?
</div>}
\answer{\name_answer}{\n}{type=default}
\solution{\ans}

