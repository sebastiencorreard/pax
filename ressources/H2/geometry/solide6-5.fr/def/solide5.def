!set title=Bases d'un solide 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
title_nl=Grondvlak deel I

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=triangulaire,rectangulaire,hexagonale,carrée,	  dodécagonale,pentagonale,octogonale
val8=Pour ce prisme droit, nous avons une base
!if $val6=nl 
val7=driehoekig,rechthoekig,zeshoekig,vierkant,	  dodecagonaal,vijfhoekig,achthoekig
val8=van deze prisma is het grondvlak
!endif
val9=$[rint(10)]
tmp=!trim $(val7[1]),$val1/prismetrianga2.jpg	$(val7[2]),$val1/pave2.jpg	$(val7[3]),$val1/prismehexa2.jpg	$(val7[4]),$val1/cube2.jpg	$(val7[5]),$val1/prismeb2.jpg	$(val7[3]),$val1/prismec2.jpg	$(val7[6]),$val1/prismemaison2.jpg	$(val7[5]),$val1/solide62.jpg	$(val7[7]),$val1/solide72.jpg	$(val7[7]),$val1/solide82.jpg
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val9

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
choicename1=
choicegood1=$(val12[1])
choicebad1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="float_right"><img src="$(val12[2])" alt=""></div>	$val8		 
!read oef/embed.phtml c1 
$().		
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,12
embedcnt=1
