!set title=Reconnaitre des solides 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
title_nl=Objecten deel II

ansorder=r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=cylindre,prisme,autre
val8=Mettre en relation.
!if $val6=nl 
val7=cilinder,prisma,anders
val8=Leg de correcte verbanden.
!endif
val9=$[rint(5)]
tmp=!trim $(val7[2]),$val1/prismetrianga2.jpg	$(val7[1]),$val1/cylindre2.jpg	$(val7[2]),$val1/pave2.jpg	$(val7[3]),$val1/pyramide2.jpg	$(val7[2]),$val1/prismehexa2.jpg	$(val7[2]),$val1/cube2.jpg	$(val7[2]),$val1/prismeb2.jpg	$(val7[2]),$val1/prismec2.jpg	$(val7[3]),$val1/prismed2.jpg	$(val7[2]),$val1/prismemaison2.jpg	$(val7[1]),$val1/solide12.jpg	$(val7[3]),$val1/solide22.jpg	$(val7[3]),$val1/solide32.jpg	$(val7[3]),$val1/solide42.jpg	$(val7[3]),$val1/solide52.jpg	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val9

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[3]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[4]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[5]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$(val12[1]),$(val13[1]),$(val14[1]),$(val15[1]),$(val16[1])
val18=<img src="$(val12[2])" alt="">,<img src="$(val13[2])" alt="">,	<img src="$(val14[2])" alt="">,<img src="$(val15[2])" alt="">,<img src="$(val16[2])" alt="">
replytype1=correspond
replyname1=
replygood1=$val18;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val8	<div class="wimscenter">  
!read oef/embed.phtml r1,90x100 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=1
