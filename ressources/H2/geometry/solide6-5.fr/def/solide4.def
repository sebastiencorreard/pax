!set title=Faces; arêtes et sommets
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
title_nl=Vlakken en zijden

ansorder=r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=cylindre,prisme,autre
tmp=!trim Pour le solide ci-contre, donner	  le nombre de faces	  le nombre de sommets	  le nombre d'arêtes
val8=!translate internal $	\
$ to ;; in $tmp
!if $val6=nl 
val7=cilinder,prisma,anders
tmp=!trim Geef voor het onderstaande ruimtelijke object	  Het totale aantal vlakken	  Het totale aantal hoekpunten	  Het totale aantal zijden
val8=!translate internal $	\
$ to ;; in $tmp
!endif
val9=$[rint(10)]
tmp=!trim 5,$val1/prismetrianga2.jpg	10,$val1/solide72.jpg	6,$val1/pave2.jpg	14,$val1/solide62.jpg	8,$val1/prismehexa2.jpg	6,$val1/cube2.jpg	14,$val1/prismeb2.jpg	8,$val1/prismec2.jpg	10,$val1/solide82.jpg	7,$val1/prismemaison2.jpg	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val9

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint(($val13 - 2)*2)]
val15=$[rint(($val13 - 2)*3)]
replytype1=auto

replyname1=$(val8[2;])
replygood1=$val13
replytype2=auto

replyname2=$(val8[3;])
replygood2=$val14
replytype3=auto

replyname3=$(val8[4;])
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_right"><img src="$(val12[2])" alt=""></div>	 $(val8[1;])	<ul><li>	<label for="reply1">$(val8[2;]):</label>  
!read oef/embed.phtml r1,3 
$()	</li><li>	<label for="reply2">$(val8[3;]):</label>  
!read oef/embed.phtml r2,3 
$()	</li><li>	<label for="reply3">$(val8[4;]):</label>  
!read oef/embed.phtml r3,3 
$()	</li></ul>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,12
embedcnt=3
