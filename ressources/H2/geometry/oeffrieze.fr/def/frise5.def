!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=$[rint(6)]
val8=$[rint(3)]
tmp0=!shuffle blue,red,yellow,green,purple,blue,red,yellow,green,purple

val9=$(tmp0)
tmp0=!makelist x:y for x = 0 to $val7-1

tmp1=!makelist $(tmp0) for y=1 to $val8

val10=$(tmp1)
tmp0=!shuffle $val10

val10=$(tmp0)
val11=$[rint(5)]
tmp=!trim $(val10[1..$val11])
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal , by ; in $val12

tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal : by , in $val12

tmp=!trim $(tmp0)
val12=!translate internal $	\
$ to ;; in $tmp
val13=$[rint(2)]
val14=
val15=
!for val16 =1 to $val11 
val17=
!for val18 =0 to $val13 
!if $val18>0 
val19=[$(val12[$val16;1]),$(val12[$val16;2])]
t_=!replace internal \( by ( in $val19+[$val18*$val7,0]
tmp0=!exec pari $t_

val20=$(tmp0)
tmp0=!replace internal , by : in $val20

val20=$(tmp0)
tmp0=!append item $val20 to $val17

val17=$(tmp0)
!endif
val19=[$val7-1-$(val12[$val16;1]),-$(val12[$val16;2])+1]
t_=!replace internal \( by ( in $val19+[$val18*$val7,0]
tmp0=!exec pari $t_

val20=$(tmp0)
tmp0=!replace internal , by : in $val20

val20=$(tmp0)
tmp0=!append item $val20 to $val17

val17=$(tmp0)
tmp0=!replace internal , by : in $(val12[$val16;])

val21=$(tmp0)
!next
tmp0=!append line square $(val9[$val16]),$val21 to $val15

val15=$(tmp0)
tmp0=!append line $(val9[$val16]),$val17 to $val14

val14=$(tmp0)
!next
val22=$[rint(2*$val7)]
val23=$[rint($val7/2)]
val24=$[rint(($val13+1)*$val7)]
val25=$[rint(100*($val13+1))]
val26=$[rint(100)]
val27=0,$val24
!readproc oef/draw.phtml $val25,$val26 \
xrange $val27	yrange -$val8,$val8	arrow 1,-$val8+1.5, 1+$val7-0.3,-$val8+1.5,10,black	transparent white	linewidth 6	\points 
tmp0=$ins_url
val28=$(tmp0)	
val29=xrange $val27	yrange -$val8,$val8	$val15	background_color lightgreen	linewidth 7	point red,$val23:0	copy 0,0,$val28	
!readproc slib/oef/env wims_version 
tmp0=$slib_out
val30=$(tmp0)
tmp0=!char 1 to 4 of $val30

val30=$(tmp0)
!if $val30 > 4.08 
val31=Cliquer sur le bouton pour changer de couleur.
!if $val6=en 
val31=Click on the button to change the colour
!endif
!if $val6=nl 
val31=Klik op de knop om van kleur te veranderen.
!endif
!if $val6=it 
val31=Cliccare sul pulsante per cambiare il colore dei quadretti
!endif
!if $val6=es 
val31=Clicar sobre el botón para cambiar el color
!endif
!if $val6=ca 
val31=Clicar sobre el botó per canviar el color
!endif
!else
val31=$val30 Utilisez le click droit pour changer de couleur.
!if $val6=en 
val31=The right mouse click changes the colour.
!endif
!if $val6=nl 
val31=De rechter muisknop gebruiken om de kleur te veranderen.
!endif
!if $val6=it 
val31=Utilizzare il tasto destro del mouse per cambiare il	colore dei quadretti.
!endif
!if $val6=es 
val31=El clic derecho del mouse cambia el color.
!endif
!if $val6=ca 
val31=El clic dret del ratolí canvia el color.
!endif
!endif
val32=En cliquant sur les carrés, prolonger la figure en une frise	par translation du vecteur dessiné et par symétrie centrale par rapport au point. 
!if $val6=en 
val32=Complete, by clicking the squares,	 the pattern [a Frieze group] by repetitive translation in the direction and distance dictated by the vector and reflection in the given point. 
!endif
!if $val6=nl 
val32=Klik met je muis op de vierkantjes en maak zo het patroon [een strookpatroongroep of Frieze] verder af d.m.v. herhaalde translatie in richting en afstand met de getoonde vector en puntspiegeling.
!endif
!if $val6=it 
val32=Utilizzando il minor numero di quadretti, prolungare la figura in un fregio con	traslazioni corrispondenti al vettore indicato e con rotazioni di 180 gradi rispetto al punto indicato.
!endif
!if $val6=es 
val32=Haciendo clic en los cuadrados, extender la figura en un friso	  por traslación del vector dibujado y por simetría central con respecto al punto. 
!endif
!if $val6=ca 
val32=Clicant als quadrats, estén la figura en un fris	  per translació del vector dibuixat i per simetria central respecte al punt. 
!endif
