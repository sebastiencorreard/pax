!set title=Calcul d'angle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000
title_nl=Bereken de hoeken 3

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer les angles ci-dessous.
val8=L'angle \(\widehat{A B C}) mesure,	  L'angle \(\widehat{A C D}) mesure,	  L'angle \(\widehat{A D C}) mesure
val9=Angle
!if $val6=nl 
val7=Bereken onderstaande hoeken.
val8=&ang; \(\widehat{A B C}) =,	  &ang; \(\widehat{A C D}) =,	  &ang; \(\widehat{A D C}) =
val9=Hoeken
!endif
tmp0=!randint 10, 40

val10=$[rint($(tmp0))]
tmp0=!randint 50, 120

val11=$[rint($(tmp0))]
tmp0=!randint 10, 50

val12=$[rint($(tmp0))]
val13=$[rint(180-$val11)]
val14=$[rint($val11-$val10)]
val15=$[rint(180-$val11-$val12)]
val16=$[rint(180-$val10-$val12)]
val17=$val12
val18=xrange -20,20	yrange -20,20	triangle 0,11,4,-11,-15,-11,black	triangle 0,11,19,-11,4,-11,black	text black,-17,-10,medium,B	text black,6,-12,medium,C	text black,18,-13,medium,D	text black,0,14,medium,A
replytype1=chset
replyname1=$val9 \(\widehat{B C A}\)
replygood1=$val13
replytype2=chset
replyname2=$val9 \(\widehat{B A C}\)
replygood2=$val14
replytype3=chset
replyname3=$val9 \(\widehat{C A D}\)
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	 
!read oef/draw.phtml 200,200 \
$val18 
$()	</div>	<div class="medium_size txt_col">		<p>$(val8[1]) $val10°. $(val8[2]) $val11°.		$(val8[3]) $val17°.		</p>	<p>$val7</p>	</div></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,11,17,18
embedcnt=0
