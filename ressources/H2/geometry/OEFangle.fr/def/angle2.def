!set title=Calcul d'angle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Luc, Donadoni
email=jluc.donadoni@laposte.net
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=1000
title_nl=Bereken de hoeken 2

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Calculer les angles ci-dessous.
val8=Le triangle \(A B E\) est rectangle en \(A\) et le quadrilatère \(B C D E\) est un parallélogramme.
val9=L'angle \(\widehat{C B E}) mesure,	  l'angle \(\widehat{F C E}) mesure
val10=Angle
!if $val6=nl 
val7=Bereken onderstaande hoeken.
val8=De driehoek \(A B E\) heeft een rechte hoek in \(A\) en de vierhoek \(B C D E\) is een parallellogram.
val9=&ang; \(\widehat{C B E}) =,	  &ang; \(\widehat{F C E}) =
val10=Hoeken
!endif
tmp0=!randint 10, 70

val11=$[rint($(tmp0))]
val12=$[rint(180)]
val13=$[rint(144-$val11)]
val14=$[rint(36)]
val15=$[rint($val11)]
val16=$val11
val17=$val14
val18=$val16
val19=xrange -20,20	yrange -20,20	triangle -15,-11,-15,11,0,11,black	triangle 0,11,4,-11,-9,-2.2,black	triangle -15,-11,-9,-2.2,4,-11,black	triangle 0,11,19,11,4,-11,black	segment -4,-7,-2,-5,red	segment -5,6,-3,4,red	text black,-17,13,medium,A	text black,-17,-10,medium,B	text black,6,-10,medium,C	text black,18,14,medium,D	text black,0,14,medium,E	text black,-11,0,medium,F
replytype1=chset
replyname1=$val10 \(\widehat{D E C}\)
replygood1=$val13
replytype2=chset
replyname2=$val10 \(\widehat{E D C}\)
replygood2=$val14
replytype3=chset
replyname3=$val10 \(\widehat{E C D}\)
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<div class="wims_columns">	 <div class="medium_size img_col">	 
!read oef/draw.phtml 200,200 \
$val19 
$()	</div>	<div class="medium_size txt_col">		$val8		<p>$(val9[1]) $val17°. $(val9[2]) $val18°.		</p>	<p>$val7</p>	</div></div>
$()
!exit

