val6=$(tmp0)
tmp=!trim A E B,E B A,\comp,1	A E B,E B C,\alt,4	A B E,E B C,\comp,1	A E C,C E D,\supp,2	B F C,C F E,\supp,2	F E C,E C D,\alt,4	B C F,E D C,\rien,6	A B E,A E B,\comp,1	A E B,E D C,\corr,5	E D C,D C B,\supp,2
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val7

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val9=$(tmp0)
tmp0=!item 1 of $val9

val10=$(tmp0)
tmp0=!item 2 of $val9

val11=$(tmp0)
