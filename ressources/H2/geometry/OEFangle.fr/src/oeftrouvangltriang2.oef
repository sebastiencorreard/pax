<ul><li>
\(\nom[1] \nom[3]\) = \l1 cm,
\(\nom[1] \nom[2]\) = \l2 cm,
\(\nom[2] \nom[3]\) = \l3 cm
</li><li>
\(\widehat{\nom[2] \nom[1] \nom[3]}) = \a1°
</li><li>
\(\widehat{\nom[1] \nom[2] \nom[3]}) = \a2°
</li></ul>
<p>\name_instruc1</p>
