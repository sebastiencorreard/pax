!set title=Vlakken en zijden
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=DONADONI Jluc
email=jluc.donadoni@laposte.net

ansorder=r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(10)]
val7=cilinder
val8=prisma
val9=anders
tmp=!trim 5,src=$val1/prismetrianga2.jpg	10,src=$val1/solide72.jpg	6,src=$val1/pave2.jpg	14,src=$val1/solide62.jpg	8,src=$val1/prismehexa2.jpg	6,src=$val1/cube2.jpg	14,src=$val1/prismeb2.jpg	8,src=$val1/prismec2.jpg	10,src=$val1/solide82.jpg	7,src=$val1/prismemaison2.jpg	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val6

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
val13=$[rint($(val12[1]))]
val14=$[rint(($val13 - 2)*2)]
val15=$[rint(($val13 - 2)*3)]
replytype1=auto

replyname1=
replygood1=$val13
replytype2=auto

replyname2=
replygood2=$val14
replytype3=auto

replyname3=
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() <br><font size="3"><font face="comic sans ms"><br>	Geef voor het onderstaande ruimtelijke object: 	<br><center>	<table border=1><tr>	<td>	<br>Het totale aantal vlakken<br><br>	Het totale aantal hoekpunten<br><br>	Het totale aantal zijden<br><br>	</td>	<td>	 
!read oef/embed.phtml r1,3 
$()<br><br>	 
!read oef/embed.phtml r2,3 
$()<br><br> 	 
!read oef/embed.phtml r3,3 
$()	</td>	<td><img $(val12[2])></td></tr>	</table>	</center></font></font><br><br>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=3
