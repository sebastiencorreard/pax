!set title=Grondvlak deel I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=DONADONI Jluc
email=jluc.donadoni@laposte.net

ansorder=c
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(9)]
val7=rechthoekig
val8=driehoekig
val9=vijfhoekig
val10=zeshoekig
val11=achthoekig
val12=twaalfhoekig
tmp=!trim $val8,src=$val1/prismetrianga2.jpg	$val7,src=$val1/pave2.jpg	$val7,src=$val1/prismehexa2.jpg	$val12,src=$val1/prismeb2.jpg	$val10,src=$val1/prismec2.jpg	$val9,src=$val1/prismemaison2.jpg	$val7,src=$val1/solide62.jpg	$val7,src=$val1/solide72.jpg	$val11,src=$val1/solide82.jpg	
val13=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val6

val14=$(tmp0)
tmp0=!shuffle $val14

val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val13

tmp=!row $(val14[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
choicename1=
choicegood1=$(val15[1])
choicebad1=$val7,$val8,$val9,$val10,$val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() <br><font size="3"><font face="comic sans ms"><br>	 Bekijk het volgende ruimtelijke object :<br><br>	<center><img $(val15[2])>	<br>van deze figuur is het voorvlak  
!read oef/embed.phtml r1 
$()	</center></font></font><br><br>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=1
