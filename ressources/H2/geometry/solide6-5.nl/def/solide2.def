!set title=Objecten deel II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=DONADONI Jluc
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(5)]
val7=cilinder
val8=prisma
val9=anders
tmp=!trim $val8,src=$val1/prismetrianga2.jpg	$val7,src=$val1/cylindre2.jpg	$val8,src=$val1/pave2.jpg	$val9,src=$val1/pyramide2.jpg	$val8,src=$val1/prismehexa2.jpg	$val8,src=$val1/cube2.jpg	$val8,src=$val1/prismeb2.jpg	$val8,src=$val1/prismec2.jpg	$val9,src=$val1/prismed2.jpg	$val8,src=$val1/prismemaison2.jpg	$val7,src=$val1/solide12.jpg	$val9,src=$val1/solide22.jpg	$val9,src=$val1/solide32.jpg	$val9,src=$val1/solide42.jpg	$val9,src=$val1/solide52.jpg	
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val6

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[1]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val13=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[3]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[4]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[5]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$(val12[1]),$(val13[1]),$(val14[1]),$(val15[1]),$(val16[1])
val18=<img $(val12[2])>,<img $(val13[2])>,	<img $(val14[2])>,<img $(val15[2])>,<img $(val16[2])>
replytype1=correspond
replyname1=
replygood1=$val18;$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<font size="3"><font face="comic sans ms">	<center> Leg de correcte verbanden : 	<br><center>  
!read oef/embed.phtml r1,90x100 
$()</center> </font></font>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=
embedcnt=1
