$ to ; in $tmp
val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[4]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val10

tmp=!row $(val11[5]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
replytype1=clickfill
replyname1=1
replygood1=$(val12[1]);cilinder
replytype2=clickfill
replyname2=2
replygood2=$(val13[1]);anders
replytype3=clickfill
replyname3=3
replygood3=$(val14[1]);cilinder
replytype4=clickfill
replyname4=4
replygood4=$(val15[1]);anders
