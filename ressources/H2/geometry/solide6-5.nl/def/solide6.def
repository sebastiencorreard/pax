!set title=Grondvlak deel II
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=DONADONI Jluc
email=jluc.donadoni@laposte.net

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$[rint(10)]
val7=vierkant
val8=rechthoekig
val9=driehoekig
val10=vijfhoekig
val11=zeshoekig
val12=achthoekig
val13=twaalfhoekig
tmp=!trim $val9,src=$val1/prismetrianga2.jpg	$val8,src=$val1/pave2.jpg	$val11,src=$val1/prismehexa2.jpg	$val7,src=$val1/cube2.jpg	$val13,src=$val1/prismeb2.jpg	$val11,src=$val1/prismec2.jpg	$val10,src=$val1/prismemaison2.jpg	$val13,src=$val1/solide62.jpg	$val12,src=$val1/solide72.jpg	$val12,src=$val1/solide82.jpg	
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!values v for v=1 to $val6

val15=$(tmp0)
tmp0=!shuffle $val15

val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val14

tmp=!row $(val15[2]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
val17=$val7,$val8,$val9,$val10,$val11,$val12,$val13
tmp0=!positionof item $(val16[1]) in $val17

val18=$[rint($(tmp0))]
replytype1=menu
replyname1=
replygood1=$val18;$val7,$val8,$val9,$val10,$val11,$val12,$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() <br><font size="3"><font face="comic sans ms"><br>	 Bekijk het volgende 'ruimtelijke object' :<br><br>                                                              	<center><img $(val16[2])>	<br>van deze prisma is het grondvlak 
!read oef/embed.phtml r1 
$()	</center></font></font>	
$()
!exit

