\title{Zijden deel II}
\langage{nl}
\author{DONADONI Jluc}
\email{jluc.donadoni@laposte.net}
\format{html}
\matrix{som=A,B,C,D,E,F,G,H
J,K,L,M,N,O,P,Q
R,S,T,U,V,W,X,Y}
\text{som=randrow(\som)}
\text{som=shuffle(\som)}

\text{a=shuffle(3)}
\integer{b=randint(1..3)}
\integer{c=randint(1..3)}

\matrix{paralls=\som[1]\som[4],\som[5]\som[8],\som[2]\som[3],\som[6]\som[7]
\som[1]\som[5],\som[2]\som[6],\som[4]\som[8],\som[3]\som[7]
\som[1]\som[2],\som[5]\som[6],\som[7]\som[8],\som[3]\som[4]}
\text{\parall1=row(item(1,\a),\paralls)}
\text{\parall2=row(item(2,\a),\paralls)}
\text{\parall3=row(item(3,\a),\paralls)}
\text{parall=shuffle(\parall1)}
\text{chpars=\parall[2],\parall[4],
\parall2[1],\parall2[1+\b],\parall3[1],\parall3[1+\b]}
\text{chpar=shuffle(\chpars)}
\integer{repl1=positionof(\parall[2],\chpar)}
\integer{repl2=positionof(\parall[4],\chpar)}

\integer{lo=randint(80..200)}
\integer{la=randint(50..160)}
\integer{ha=randint(20..80)}
\integer{xo=\lo+\ha}
\integer{yo=\la+\ha}
\text{pave=draw(340,300
transparent white
rect 170-\xo/2,130+\yo/2,170+\xo/2-\ha,130-\yo/2+\ha,black
line 170+\xo/2-\lo,130-\yo/2,170+\xo/2,130-\yo/2,black
line 170+\xo/2-\lo,130-\yo/2,170+\xo/2-\lo-\ha,130-\yo/2+\ha,black
line 170+\xo/2,130-\yo/2,170+\xo/2-\ha,130-\yo/2+\ha,black
line 170+\xo/2,130-\yo/2,170+\xo/2,130-\yo/2+\la,black
line 170+\xo/2-\ha,130-\yo/2+\ha+\la,170+\xo/2,130-\yo/2+\la,black
dline 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2,130-\yo/2+\la,black
dline 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2-\lo-\ha,130-\yo/2+\la+\ha,black
dline 170+\xo/2-\lo,130-\yo/2+\la,170+\xo/2-\lo,130-\yo/2,black
text red,170-\xo/2-8,130+\yo/2+5,huge,\som[1]
text red,170+\xo/2-\ha,130-\yo/2+\ha+\la+5,huge,\som[2]
text red,170+\xo/2-\ha+5,130-\yo/2+\ha,huge,\som[3]
text red,170+\xo/2-\lo-\ha-10,130-\yo/2+\ha-5,huge,\som[4]
text red,170+\xo/2-\lo+3,130-\yo/2+\la+3,huge,\som[5]
text red,170+\xo/2+3,130-\yo/2+\la+3,huge,\som[6]
text red,170+\xo/2+5,130-\yo/2-10,huge,\som[7]
text red,170+\xo/2-\lo-12,130-\yo/2-10,huge,\som[8]
)}

\statement{ <br><font size="3"><font face="comic sans ms">
<center> 
<table>
    <td>
	Geef een zijde parallel aan zijde \parall[1]:
	<br>
	\embed{r1}
	<hr>
	<br>
	Geef de zijden parallel aan zijde \parall[1]:
	<br>
	\embed{r2}
    </td>
    <td>
	<img src=\pave>
    </td>
</table>
</center>
</font></font><br>}

\answer{}{\repl1,\repl2;\chpar[1],\chpar[2],
\chpar[3],\chpar[4],\chpar[5],\chpar[6]}{type=radio}
\answer{}{\repl1,\repl2;\chpar[1],\chpar[2],
\chpar[3],\chpar[4],\chpar[5],\chpar[6]}{type=checkbox}
\hint{<em>Geef <b>een</b> zijde</em> wil zeggen: klik een willekeurige zijde<br>
<em>Geef <b>de</b> zijden</em> wil zeggen: klik zoveel mogelijk zijden aan }
