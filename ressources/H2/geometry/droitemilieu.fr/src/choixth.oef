\matrix{hyp=\A\B\C est un triangle<br>\D est le milieu de \([\A\B])<br>\E est le milieu de \([\A\C])
\A\B\C est un triangle<br>\D est le milieu de \([\A\B])<br>\E est le milieu de \([\A\C])
\A\B\C est un triangle<br>\D est le milieu de \([\A\B])<br>\((\D\E)) // \((\B\C))}

\text{hypo=row(\choix,\hyp)}

\matrix{question=Démontrer que les droites \((\D\E)) et \((\B\C)) sont parallèles.,Démontrer que les droites \((\D\E)) et \((\B\C)) sont parallèles.,Que peut-on dire des droites \((\D\E)) et \((\B\C)) &#063; Justifier.
Calculer la longueur \(\D\E).,Montrer que \(\D\E=1/2 \B\C).,Montrer que la longueur de \([\B\C]) est le double de celle de \([\D\E]).
Calculer la longueur \(\A\E).,Montrer que \E est le milieu de \([\A\C]).,Montrer que \E est le milieu de \([\A\C]).}

\text{quest=row(\choix,\question)}
\integer{r=random(1,2,3)}
\text{quest=item(\r,\quest)}

\text{th=SI ABC est un triangle<br>SI I est le milieu de [AB]<br>SI J est le milieu de [AC]<br><br>ALORS : (IJ)//(BC),SI ABC est un triangle<br>SI I est le milieu de [AB]<br>SI J est le milieu de [AC]<br><br>ALORS : IJ = 1/2 BC,SI ABC est un triangle<br>SI I est le milieu de [AB] <br>et J est un point de [AC]<br>SI (IJ)//(BC)<br><br>ALORS : J est le milieu de [AC]}

