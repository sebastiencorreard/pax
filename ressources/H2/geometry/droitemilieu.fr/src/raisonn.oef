\text{hypo=row(\choix,\hyp)}

\matrix{question=Démontrer que les droites \((\D\E)) et \((\B\C)) sont parallèles.,Démontrer que les droites \((\D\E)) et \((\B\C)) sont parallèles.,Que peut-on dire des droites \((\D\E)) et \((\B\C)) &#063; Justifier.
Calculer la longueur \(\D\E).,Montrer que \(\D\E=1/2 \B\C).,Montrer que la longueur de \([\B\C]) est le double de celle de \([\D\E]).
Montrer que \E est le milieu de \([\A\C]).,Montrer que \E est le milieu de \([\A\C]).,Montrer que \E est le milieu de \([\A\C]).}

\text{quest=row(\choix,\question)}
\integer{r=random(1,2,3)}
\text{quest=item(\r,\quest)}

\text{list=\A\B\C est un triangle,\D est le milieu de \([\A\B]),\E est le milieu de \([\A\C]),\((\D\E))//\((\B\C)),\(\D\E = 1/2 \B\C) donc \D\E=\DE}

\text{hypot= \choix=3 ? item([1,2,4],\list)|item([1,4,2],\list)|item([2,1,4],\list)|item([2,4,1],\list)|item([4,1,2],\list)|item([4,2,1],\list) : item([1,2,3],\list)|item([1,3,2],\list)|item([2,1,3],\list)|item([2,3,1],\list)|item([3,1,2],\list)|item([3,2,1],\list) }
\integer{numero=item(\choix,4,5,3)}
