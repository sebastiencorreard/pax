\title{中心}
\language{cn}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{always=总在三角形内部}
\text{depend=有时在三角形外面}
\text{never =总在三角形外面}
\matrix{data=
中垂线, 外心, \depend, 中垂线, 外接圆的中心
高, 垂心, \depend
角平分线, 内心, \always, 角平分线, 内切圆的中心
中线, 重心, \always, , 重心
}
\text{bad=triangle angle sides perimeter vertex point intersection straight line}
\text{one=randomrow(\data)}
\text{colone=shuffle(中垂线,高,角平分线,中线)}
\text{coltwo=外心,垂心,内心,重心}
\integer{type=random(1,2)}
\text{col=\type=1?\colone:\coltwo}
\text{A=<u><tt>&nbsp;&nbsp;&nbsp;&nbsp;(A)&nbsp;&nbsp;&nbsp;&nbsp;</tt></u>}
\text{B=<u><tt>&nbsp;&nbsp;&nbsp;&nbsp;(B)&nbsp;&nbsp;&nbsp;&nbsp;</tt></u>}
\text{AA=\type=1?\A:item(1,\one)}
\text{BB=\type=1?item(2,\one):\A}
\text{good=item(\type,\one)}
\text{good2=item(3,\one)}

\statement{填充:<p>
三角形的 3 条 
\AA
的交点是这个三角形的
\BB .
它 \B .
}

\choice{(A)}{\good}{\col}
\choice{(B)}{\good2}{\always,\depend,\never}
