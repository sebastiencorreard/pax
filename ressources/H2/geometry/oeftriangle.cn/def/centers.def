!set title=中心
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=cn
leftrange=-5.000000
rightrange=5.000000
author=Gang XIAO
email=xiao@unice.fr
computeanswer=no
precision=10000

ansorder=c,c
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=0
choicecnt=2
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=总在三角形内部
val7=有时在三角形外面
val8=总在三角形外面
tmp=!trim 中垂线, 外心, $val7, 中垂线, 外接圆的中心	高, 垂心, $val7	角平分线, 内心, $val6, 角平分线, 内切圆的中心	中线, 重心, $val6, , 重心	
val9=!translate internal $	\
$ to ;; in $tmp
val10=triangle angle sides perimeter vertex point intersection straight line
tmp=!translate internal $	$ to ; in $val9

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!shuffle 中垂线,高,角平分线,中线

val12=$(tmp0)
val13=外心,垂心,内心,重心
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]

!ifval $val14=1
val15=$val12
!else
val15=$val13
!endif
val16=<u><tt>&nbsp;&nbsp;&nbsp;&nbsp;(A)&nbsp;&nbsp;&nbsp;&nbsp;</tt></u>
val17=<u><tt>&nbsp;&nbsp;&nbsp;&nbsp;(B)&nbsp;&nbsp;&nbsp;&nbsp;</tt></u>

!ifval $val14=1
val18=$val16
!else
tmp0=!item 1 of $val11

val18=$(tmp0)
!endif

!ifval $val14=1
tmp0=!item 2 of $val11

val19=$(tmp0)
!else
val19=$val16
!endif
tmp0=!item $val14 of $val11

val20=$(tmp0)
tmp0=!item 3 of $val11

val21=$(tmp0)
choicename1=(A)
choicegood1=$val20
choicebad1=$val15
choicename2=(B)
choicegood2=$val21
choicebad2=$val6,$val7,$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()填充:<p>	三角形的 3 条 	$val18	的交点是这个三角形的	$val19 .	它 $val17 .	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=17,18,19
embedcnt=0
