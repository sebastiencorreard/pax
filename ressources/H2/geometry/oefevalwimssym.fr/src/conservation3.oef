\title{Propriété de conservation 3}
% fonction de repérage du point correctement construit : Gilles Marbeuf
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}

\css{
<style>
.ggb{
margin-bottom:1em;
}
div.ggb div.inline{
display:block;
}
</style>
}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,L,M,N,P,Q,R,S,T)}
\text{A=\lettres[1]}
\text{O=\lettres[2]}
\text{B=\lettres[3]}
\text{C=\lettres[4]}
\text{D=\lettres[5]}
\text{E=\lettres[6]}
\text{F=\lettres[7]}
\text{G=\lettres[8]}
\text{H=\lettres[9]}
\text{I=\lettres[10]}
\text{J=\lettres[11]}

\text{X=randint(2..6),randint(2..6),randint(-6..-2),randint(-6..-2)}
\text{Y=randint(2..6),randint(-6..-2),randint(-6..-2),randint(2..6)}
\text{ch=1,2,3,4}

\real{r=rint(random(3..5)*100)/100}

\text{appletoptionI=\A = (\X[\ch[1]],\Y[\ch[1]]);
setFixed('\A',true);
setLabelVisible('\A',true);
\B = (\X[\ch[2]],\Y[\ch[2]]);
setFixed('\B',true);
setLabelVisible('\B',true);
\C = (\X[\ch[3]],\Y[\ch[3]]);
setFixed('\C',true);
setLabelVisible('\C',true);
\D = (\X[\ch[4]],\Y[\ch[4]]);
setFixed('\D',true);
setLabelVisible('\D',true);
\O = (-9,-9);
setFixed('\O',true);
setLabelVisible('\O',true);
Segment[\A,\B];Segment[\B,\C];Segment[\C,\D];Segment[\D,\A];
u=Segment[\A,\C];v=Segment[\B,\D];\I=Intersect[u,v];
setLabelVisible('\I',true);}

\real{angle=random(pi/3..3*pi/2)}
\real{x1=\X[\ch[1]]*cos(\angle)+\Y[\ch[1]]*sin(\angle)}
\real{y1=-\X[\ch[1]]*sin(\angle)+\Y[\ch[1]]*cos(\angle)}
\real{x2=\X[\ch[2]]*cos(\angle)+\Y[\ch[2]]*sin(\angle)}
\real{y2=-\X[\ch[2]]*sin(\angle)+\Y[\ch[2]]*cos(\angle)}
\real{x3=\X[\ch[3]]*cos(\angle)+\Y[\ch[3]]*sin(\angle)}
\real{y3=-\X[\ch[3]]*sin(\angle)+\Y[\ch[3]]*cos(\angle)}
\real{x4=\X[\ch[4]]*cos(\angle)+\Y[\ch[4]]*sin(\angle)}
\real{y4=-\X[\ch[4]]*sin(\angle)+\Y[\ch[4]]*cos(\angle)}
\real{x5=\X[\ch[4]]*cos(\angle)+\Y[\ch[4]]*sin(\angle)}
\real{y5=-\X[\ch[4]]*sin(\angle)+\Y[\ch[4]]*cos(\angle)}

\text{appletoptionf=\E = (\x1,\y1);
setFixed('\E',true);
setLabelVisible('\E',true)
\F = (\x2,\y2);
setFixed('\F',true);
setLabelVisible('\F',true)
\G = (\x3,\y3);
setFixed('\G',true);
setLabelVisible('\G',true)
\H = (\x4,\y4);
setFixed('\H',true);
setLabelVisible('\H',true)
test=Slider(0,1,1)
setVisible('test',false)
}

\text{appletoptiong=height=550;
width=490;
showToolBar=true;
enableRightClick=true;
showAlgebraInput=false;
setCoordSystem(-10,10,-10,10);
customToolBar=0|40;
file=vierge.ggb;
\appletoptionI}

\text{appletoptiond=height=550
width=490
showToolBar=true
enableRightClick=true
showAlgebraInput=false
setCoordSystem(-10,10,-10,10)
customToolBar=0|40|6|2|10|5|15
file=vierge.ggb;
\appletoptionf}

\text{applet2=slib(geo2D/geogebra number=2;\appletoptiong)}

\text{name=slib(lang/fname boy,fr)}
\statement{
<script>
function listener(obj){
var g=ggbApplet0;
if (g.getObjectType(obj)=="point"){
var n=g.getObjectNumber();
var li=[];
var ind=0;
var x31=\x3-(\x1);
var y31=\y3-(\y1);
var x42=\x4-(\x2);
var y42=\y4-(\y2);
for (k=0;k<n;k++){
 if (g.getObjectType(g.getObjectName(k))=="point")
  {li[ind]=g.getObjectName(k);
   var x_pt=g.getXcoord(g.getObjectName(k));
   var y_pt=g.getYcoord(g.getObjectName(k));
   ind+=1;
   if((Math.abs((x_pt-(\x1))*(y31)-(x31*(y_pt-(\y1))))<0.000001)&&(Math.abs((x_pt-(\x2))*(y42)-(x42*(y_pt-(\y2))))<0.000001))
     {g.evalCommand("test="+1);}
  }
}
l='{';
for (k=0;k<ind-1;k++){l=l+li[k]+','};
l=l+li[ind-1]+'}';
g.evalCommand("ListePts="+l);
}}

function ggbUpdate() {
  ggbApplet0.registerAddListener("listener");
}
</script>

\name a commencé à construire le symétrique du quadrilatère \A\B\C\D et de son centre \I par rapport au point \O mais sa feuille s'est déchirée.<br>
Les deux morceaux de la feuille sont ci-dessous.<br>
Il a déjà construit les images respectivement \E, \F, \G et \H des points \A, \B, \C et \D.<br>
Pouvez-vous construire tout de même l'image, nommée \J, du point \I par la symétrie de centre \O
sur le morceau de gauche ?

<div class="flex_box">
<div  class="ggb" onclick="ggbUpdate();" ontouchstart="ggbUpdate();">\embed{r1, 490 x 550
\appletoptiond}</div>
<div class="ggb">\applet2</div>
</div>

<div class="wims_instruction">Attention, vous devez donner le bon nom aux objets !!</div>}

\answer{}{n,v_test==1,L'image de \I est correctement construite;
n,abs((x_\J-(x_\E))*(y_\G-(y_\E))-(x_\G-(x_\E))*(y_\J-(y_\E)))<10^(-6)&abs((x_\J-(x_\F))*(y_\H-(y_\F))-(x_\H-(x_\F))*(y_\J-(y_\F)))<10^(-6),L'image de \I est correctement nommée
}{type=geogebra} {option=extra=yes output=formal max=15 }
