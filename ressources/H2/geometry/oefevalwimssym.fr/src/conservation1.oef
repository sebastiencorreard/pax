\title{Propriété de conservation 1}
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}

\css{
<style>
.ggb{
margin-bottom:1em;
}
div.ggb div.inline{
display:block;
}
</style>
}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,L,M,N,P,Q,R,S,T)}
\text{A=\lettres[1]}
\text{O=\lettres[2]}
\text{B=\lettres[3]}
\text{C=\lettres[4]}
\text{D=\lettres[5]}
\text{E=\lettres[6]}
\text{F=\lettres[7]}

\text{X=randint(2..6),randint(2..6),randint(-6..-2),randint(-6..-2)}
\text{Y=randint(2..6),randint(-6..-2),randint(-6..-2),randint(2..6)}
\text{ch=shuffle(1,2,3,4)}

\real{r=rint(random(3..5)*100)/100}

\text{appletoptionI=\A = (\X[\ch[1]],\Y[\ch[1]]);
setFixed('\A',true);
setLabelVisible('\A',true);
\O = (\X[\ch[4]],\Y[\ch[4]]);
setFixed('\O',true);
setLabelVisible('\O',true);
\C = Circle[\A,\r];
setLabelVisible('\C',true);
setCoordSystem(-10,10,-10,10);}

\real{angle=random(pi/3..3*pi/2)}
\real{x1=\X[\ch[1]]*cos(\angle)+\Y[\ch[1]]*sin(\angle)}
\real{y1=-\X[\ch[1]]*sin(\angle)+\Y[\ch[1]]*cos(\angle)}

\text{appletoptionf=\B =(\x1,\y1);
setFixed('\B',true)
setLabelVisible('\B',true)
setCoordSystem(-10,10,-10,10)}

\text{size=490,550}
\text{appletoptiong=height=\size[2];
width=\size[1];
showToolBar=true;
enableRightClick=true;
showAlgebraInput=false;
customToolBar=0|40|1|2|10|38;
allowRescaling=false;
file=vierge.ggb;
\appletoptionI}
\text{appletoptiond=height=\size[2];
width=\size[1];
showToolBar=true;
enableRightClick=true;
showAlgebraInput=false;
allowRescaling=false;
customToolBar=0|40|6|2|10|15|5|34;
file=vierge.ggb;
\appletoptionf}

\text{applet2=slib(geo2D/geogebra number=2;\appletoptiong)}

\text{name=slib(lang/fname boy,fr)}
\statement{
\name a commencé à construire le symétrique par rapport au point \O du cercle \C de centre \A mais sa feuille s'est déchirée.<br>
Les deux morceaux de la feuille sont ci-dessous.
Il a déjà construit l'image \B du centre \A.
<p>
Pouvez-vous construire tout de même l'image du cercle par la symétrie de
centre \O sur le morceau de gauche ?
</p>
<div class="flex_box">
<div class="ggb">\embed{r1, \size[1] x \size[2] \appletoptiond}</div>
<div class="ggb">\applet2</div>
</div>}

\answer{}{f,=Circle[\B,\r],}{type=geogebra}{option=extra=yes output=nothing precision=2 max=10}
