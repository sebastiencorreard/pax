\css{
<style>
.ggb{
margin-bottom:1em;
}
div.ggb div.inline{
display:block;
}
</style>
}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,L,M,N,P,Q,R,S,T)}
\text{A=\lettres[1]}
\text{O=\lettres[2]}
\text{B=\lettres[3]}
\text{C=\lettres[4]}
\text{D=\lettres[5]}
\text{E=\lettres[6]}
\text{F=\lettres[7]}

\text{X=randint(2..9),randint(2..9),randint(-9..-2),randint(-9..-2)}
\text{Y=randint(2..9),randint(-9..-2),randint(-9..-2),randint(2..9)}
\text{ch=shuffle(1,2,3,4)}

\text{appletoptionI=\A = (\X[\ch[1]],\Y[\ch[1]]);
setFixed('\A',true);
setLabelVisible('\A',true);
\B = (\X[\ch[2]],\Y[\ch[2]]);
setFixed('\B',true);
setLabelVisible('\B',true);
\C = (\X[\ch[3]],\Y[\ch[3]]);
setFixed('\C',true);
setLabelVisible('\C',true);
\O = (\X[\ch[4]],\Y[\ch[4]]);
setFixed('\O',true);
setLabelVisible('\O',true);
Segment[\A,\B];Segment[\A,\C];
Segment[\B,\C];}

\real{angle=random(pi/3..3*pi/2)}
\real{decx=cos(\angle)}
\real{decy=sin(\angle)}
\real{x1=\X[\ch[1]]*cos(\angle)+\Y[\ch[1]]*sin(\angle)}
\real{y1=-\X[\ch[1]]*sin(\angle)+\Y[\ch[1]]*cos(\angle)}
\real{x2=\X[\ch[2]]*cos(\angle)+\Y[\ch[2]]*sin(\angle)}
\real{y2=-\X[\ch[2]]*sin(\angle)+\Y[\ch[2]]*cos(\angle)}
\real{x3=\X[\ch[3]]*cos(\angle)+\Y[\ch[3]]*sin(\angle)}
\real{y3=-\X[\ch[3]]*sin(\angle)+\Y[\ch[3]]*cos(\angle)}

\text{appletoptionf=\D = (\x1,\y1);
setFixed('\D',true);
setLabelVisible('\D',true);
\E = (\x2,\y2);
setFixed('\E',true);
setLabelVisible('\E',true);
W =(\x3,\y3);
setFixed('W',true);
SetVisibleInView(W,1,false);
f=Line[\D,W];
test=Slider(0,1,1)
setVisible('test',false)
}

\real{r1=rint(sqrt((\X[\ch[1]]-\X[\ch[3]])^2+(\Y[\ch[1]]-\Y[\ch[3]])^2)*100)/100}
\real{r2=rint(sqrt((\X[\ch[2]]-\X[\ch[3]])^2+(\Y[\ch[2]]-\Y[\ch[3]])^2)*100)/100}

\text{appletoptiong=height=550;
width=490;
showToolBar=true;
enableRightClick=true;
showAlgebraInput=false;
setCoordSystem(-10,10,-10,10);
customToolBar=0|40|2|10|38;
file=vierge.ggb
\appletoptionI}

\text{appletoptiond=height=550
width=490
showToolBar=true
enableRightClick=true
showAlgebraInput=false
setCoordSystem(-10,10,-10,10)
customToolBar=0|40|6|2|10|15|5|34
file=vierge.ggb
\appletoptionf}

\text{applet2=slib(geo2D/geogebra number=2;\appletoptiong)}

\text{name=slib(lang/fname boy,fr)}

\statement{
<script>
function listener(obj){
var g=ggbApplet0;
if (g.getObjectType(obj)=="point"){
var n=g.getObjectNumber();
var li=[];
var ind=0;
var x_0=\x3;
var y_0=\y3;
for (k=0;k<n;k++){
 if (g.getObjectType(g.getObjectName(k))=="point")
  {li[ind]=g.getObjectName(k);
   ind+=1;
   if((Math.abs(g.getXcoord(g.getObjectName(k))-(x_0))<0.001)&&(Math.abs(g.getYcoord(g.getObjectName(k))-(y_0))<0.001))
     {g.evalCommand("test="+1);}
  }
}
l='{';
for (k=0;k<ind-1;k++){l=l+li[k]+','};
l=l+li[ind-1]+'}';
g.evalCommand("ListePts="+l);
}}

function ggbUpdate() {
  ggbApplet0.registerAddListener("listener");
}
</script>

\name a commencé à construire le symétrique par rapport au point \O du
triangle \A\B\C mais sa feuille s'est déchirée.
Les deux morceaux de la feuille sont ci-dessous.<br>
Il a déjà construit \D et \E les images respectives de \A et \B ainsi que l'image de la droite (\A\C).<br>
Pouvez-vous construire tout de même l'image, nommée \F, du point \C par la
symétrie de centre \O sur le morceau de gauche ?
<div class="flex_box">
<div  class="ggb" onclick="ggbUpdate();" ontouchstart="ggbUpdate();">\embed{r1, 490 x 550
\appletoptiond}</div>
<div class="ggb">\applet2</div>
</div>
<div class="wims_instruction">Attention vous devez donner le bon nom aux objets !!</div>}

\answer{}{n,v_test==1,Image de \C correctement construite;
n,((\x3-(x_\F))^2+(\y3-(y_\F))^2)<0.1,Image de \C correctement nommée
}{type=geogebra}{option=extra=yes output=formal max=15 precision=2}
