\title{Propriété de conservation 2}
% fonction de repérage du point correctement construit : Gilles Marbeuf
\author{Fabrice, Guerimand}
\email{fguerima@free.fr}

\css{
<style>
.ggb{
margin-bottom:1em;
}
div.ggb div.inline{
display:block;
}
</style>
}

\text{lettres=shuffle(A,B,C,D,E,F,G,H,L,M,N,P,Q,R,S,T)}
\text{A=\lettres[1]}
\text{O=\lettres[2]}
\text{B=\lettres[3]}
\text{C=\lettres[4]}
\text{D=\lettres[5]}
\text{E=\lettres[6]}
\text{F=\lettres[7]}

\text{X=randint(2..6),randint(2..6),randint(-6..-2),randint(-6..-2)}
\text{Y=randint(2..6),randint(-6..-2),randint(-6..-2),randint(2..6)}
\text{ch=shuffle(1,2,3,4)}

\real{r=rint(random(3..5)*100)/100}

\real{Xm=(\X[\ch[1]]+\X[\ch[2]])/2}
\real{Ym=(\Y[\ch[1]]+\Y[\ch[2]])/2}

\text{appletoptionI=\A = (\X[\ch[1]],\Y[\ch[1]]);
setFixed('\A',true);
setLabelVisible('\A',true);
\B = (\X[\ch[2]],\Y[\ch[2]]);
setFixed('\B',true);
setLabelVisible('\B',true);
\C = (\Xm,\Ym);
setFixed('\C',true);
setLabelVisible('\C',true);
\O = (\X[\ch[4]],\Y[\ch[4]]);
setFixed('\O',true);
setLabelVisible('\O',true);
Segment[\A,\B];}

\real{angle=random(pi/3..3*pi/2)}
\real{x1=\X[\ch[1]]*cos(\angle)+\Y[\ch[1]]*sin(\angle)}
\real{y1=-\X[\ch[1]]*sin(\angle)+\Y[\ch[1]]*cos(\angle)}
\real{x2=\X[\ch[2]]*cos(\angle)+\Y[\ch[2]]*sin(\angle)}
\real{y2=-\X[\ch[2]]*sin(\angle)+\Y[\ch[2]]*cos(\angle)}

\text{appletoptionf=\D=(\x1,\y1);
setFixed('\D',true);
setLabelVisible('\D',true);
\E=(\x2,\y2);
setFixed('\E',true);
setLabelVisible('\E',true)
test=Slider(0,1,1)
setVisible('test',false)
}

\text{appletoptiong=height=550;
width=490;
showToolBar=true;
enableRightClick=false;
showAlgebraInput=false;
setCoordSystem(-10,10,-10,10);
customToolBar=0|40;
number=1
file=vierge.ggb;
\appletoptionI}

\text{appletoptiond=height=550
width=490
language=fr
useBrowserForJS=true
showToolBar=true
enableRightClick=true
showAlgebraInput=false
setCoordSystem(-10,10,-10,10)
customToolBar=0|40|6|2|10|15|5|34
file=vierge.ggb;
\appletoptionf}

\text{applet2=slib(geo2D/geogebra number=2;\appletoptiong )}

\text{name=slib(lang/fname boy,fr)}
\statement{

<script>
function listener(obj){
var g=ggbApplet0;
if (g.getObjectType(obj)=="point"){
var n=g.getObjectNumber();
var li=[];
var ind=0;
var x_0=(\x1+\x2)/2;
var y_0=(\y1+\y2)/2;
for (k=0;k<n;k++){
 if (g.getObjectType(g.getObjectName(k))=="point")
  {li[ind]=g.getObjectName(k);
   ind+=1;
   if((Math.abs(g.getXcoord(g.getObjectName(k))-(x_0))<0.001)&&(Math.abs(g.getYcoord(g.getObjectName(k))-(y_0))<0.001))
     {g.evalCommand("test="+1);}
  }
}
l='{';
for (k=0;k<ind-1;k++){l=l+li[k]+','};
l=l+li[ind-1]+'}';
g.evalCommand("ListePts="+l);
}}

function ggbUpdate() {
  ggbApplet0.registerAddListener("listener");
}
</script>
\name a commencé à construire le symétrique du segment [\A\B] et de son milieu \C par rapport au point \O mais sa feuille s'est déchirée.<br>
Les deux morceaux de la feuille sont ci-dessous.<br>
Il a déjà construit les images respectivement \D et \E des extrémités \A et \B du segment.<br>
Pouvez-vous construire tout de même l'image, nommée \F, du point \C par la symétrie de centre \O sur le morceau de gauche ?

<div class="flex_box">
<div class="ggb" onclick="ggbUpdate();" ontouchstart="ggbUpdate();">\embed{r1, 490 x 550 \appletoptiond}</div>
<div class="ggb">\applet2</div>
</div>
<div class="wims_instruction">Attention, vous devez donner le bon nom aux objets !</div>}

\answer{}{n,v_test==1,Image de \C correctement construite;n,(x_\F-(x_\E+x_\D)/2)^2+(y_\F-(y_\E+y_\D)/2)^2<=10^(-6),Image de \C correctement nommée}{type=geogebra} {option=extra=yes output=formal max=15}
