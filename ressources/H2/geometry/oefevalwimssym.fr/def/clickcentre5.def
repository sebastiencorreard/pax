!set title=Centre de symétrie d'une figure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquez avec la souris à l'emplacement du centre	  de symétrie de la figure suivante&nbsp;
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
tmp0=!randint 50, 75

val9=$[rint(2*$(tmp0))]
val10=0,180;	180,0
tmp0=!shuffle 1,2

val11=$(tmp0)
val12=10,-10
tmp=!nonempty items green,red,yellow,pink,brown,grey

tmp0=!randitem $tmp
val13=$(tmp0)
val14=linewidth 2	segment $val7,$val8+150,$val7+2*$val9,$val8+150,black	arc $val7+$val9/2,$val8+150,$val9,$val9,$(val10[$(val11[1]);1]),$(val10[$(val11[1]);2]),black	arc $val7+3*$val9/2,$val8+150,$val9,$val9,$(val10[$(val11[2]);1]),$(val10[$(val11[2]);2]),black	fill $val7+$val9/2,$val8+150+$(val12[$(val11[1])]),$val13	fill $val7+3*$val9/2,$val8+150+$(val12[$(val11[2])]),$val13	
val15=$[rint($val7+$val9)]
val16=$[rint($val8+150)]
val17=$[rint(20)]
!readproc oef/draw.phtml 400,400 \
$val14 
tmp0=$ins_url
val18=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val18;circle,$val15,$val16,$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val6	<div class="wimscenter"> 
!read oef/embed.phtml r1,400x400 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=1
