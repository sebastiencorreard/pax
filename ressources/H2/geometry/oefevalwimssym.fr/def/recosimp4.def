!set title=Figure simple et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 75, 120

val6=$[rint($(tmp0))]
!readproc oef/draw.phtml 200,200 \
circle 100,100,$val6,black 
tmp0=$ins_url
val7=$(tmp0)
val8=$[rint(1)]
val9=Oui,Non
tmp0=!item $val8 of $val9

val8=$(tmp0)
choicename1=
choicegood1=$val8
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val7" alt=""></div>
$()
!exit

