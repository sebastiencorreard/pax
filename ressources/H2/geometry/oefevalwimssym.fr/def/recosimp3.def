!set title=Figure simple et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc oef/draw.phtml 200,200 \
polygon black,60,40,140,40,180,160,20,160 
tmp0=$ins_url
val6=$(tmp0)
val7=$[rint(2)]
val8=Oui,Non
tmp0=!item $val7 of $val8

val7=$(tmp0)
choicename1=
choicegood1=$val7
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val6" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=0
