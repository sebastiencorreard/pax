!set title=Figure et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]

!ifval $val6=2
val7=$[rint(200/8+1)]
!else
val7=$[rint(200/9+1)]
!endif
val8=fsquare 1,1,$val7,black	fsquare 2,2,$val7,black	fsquare 2,3,$val7,black	fsquare 3,4,$val7,black	fsquare 4,4,$val7,black	fsquare 5,3,$val7,black	fsquare 5,2,$val7,black	fsquare 6,1,$val7,black	fsquare 2,5,$val7,black	fsquare 5,5,$val7,black
!if $val6=2 
!readproc oef/draw.phtml 200,200 \
range 0,8,8,0	$val8	fsquare 1,6,$val7,black	fsquare 6,6,$val7,black 
tmp0=$ins_url
val9=$(tmp0)
!else
!readproc oef/draw.phtml 200,200 \
range -0.5,8.5,9,0	$val8	fsquare 2,6,$val7,black	fsquare 5,6,$val7,black	fsquare 1,7,$val7,black	fsquare 6,7,$val7,black 
tmp0=$ins_url
val9=$(tmp0)
!endif
val10=Oui,Non
tmp0=!item $val6 of $val10

val6=$(tmp0)
choicename1=
choicegood1=$val6
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val9" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=0
