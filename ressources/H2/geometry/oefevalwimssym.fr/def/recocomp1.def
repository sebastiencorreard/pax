!set title=Figure et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 60, 90

val7=$[rint($(tmp0))]

!ifval $val6=1
val8=$[rint($val7)]
!else
tmp0=!randint 30, 45

val8=$[rint($(tmp0))]
!endif
!readproc oef/draw.phtml 200,200 \
circle 100,100-$val8/2+1,$val8,black	circle 100,100+$val7/2-1,$val7,black 
tmp0=$ins_url
val9=$(tmp0)
val10=Oui,Non
tmp0=!item $val6 of $val10

val6=$(tmp0)
choicename1=
choicegood1=$val6
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val9" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=0
