$()	<script>	function listener(obj){	var g=ggbApplet0;	if (g.getObjectType(obj)=="point"){	var n=g.getObjectNumber();	var li=[];	var ind=0;	var x31=$val28-($val24);	var y31=$val29-($val25);	var x42=$val30-($val26);	var y42=$val31-($val27);	for (k=0;k<n;k++){	 if (g.getObjectType(g.getObjectName(k))=="point")	  {li[ind]=g.getObjectName(k);	   var x_pt=g.getXcoord(g.getObjectName(k));	   var y_pt=g.getYcoord(g.getObjectName(k));	   ind+=1;	   if((Math.abs((x_pt-($val24))*(y31)-(x31*(y_pt-($val25))))<0.000001)&&(Math.abs((x_pt-($val26))*(y42)-(x42*(y_pt-($val27))))<0.000001))	     {g.evalCommand("test="+1);}	  }	}	l='{';	for (k=0;k<ind-1;k++){l=l+li[k]+','};	l=l+li[ind-1]+'}';	g.evalCommand("ListePts="+l);	}}		function ggbUpdate() {	  ggbApplet0.registerAddListener("listener");	}	</script>		$val38 a commencé à construire le symétrique du quadrilatère $val7$val9$val10$val11 et de son centre $val16 par rapport au point $val8 mais sa feuille s'est déchirée.<br>	Les deux morceaux de la feuille sont ci-dessous.<br>	Il a déjà construit les images respectivement $val12, $val13, $val14 et $val15 des points $val7, $val9, $val10 et $val11.<br>	Pouvez-vous construire tout de même l'image, nommée $val17, du point $val16 par la symétrie de centre $val8	sur le morceau de gauche ?		<div class="flex_box">	<div  class="ggb" onclick="ggbUpdate();" ontouchstart="ggbUpdate();"> 
