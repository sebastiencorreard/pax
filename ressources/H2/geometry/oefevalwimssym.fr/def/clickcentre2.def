!set title=Centre de symétrie d'une figure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquez avec la souris à l'emplacement du centre	  de symétrie de la figure suivante&nbsp;
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
val9=linewidth 2	segment $val7+125,$val8+100,$val7+125,$val8+300,black	polygon black,$val7+75,$val8+120,$val7+125,$val8+170,$val7+125,$val8+230,$val7+75,$val8+280	polygon black,$val7+175,$val8+120,$val7+125,$val8+170,$val7+125,$val8+230,$val7+175,$val8+280
val10=$[rint($val7+125)]
val11=$[rint($val8+200)]
val12=$[rint(20)]
!readproc oef/draw.phtml 400,400 \
$val9 
tmp0=$ins_url
val13=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val13;circle,$val10,$val11,$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val6	<div class="wimscenter"> 
!read oef/embed.phtml r1,400x400 
$()</div>
$()
!exit

