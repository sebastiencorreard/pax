!set title=Centre de symétrie d'une figure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquez avec la souris à l'emplacement du centre	  de symétrie de la figure suivante&nbsp;
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
tmp0=!randint 50, 100

val9=$[rint($(tmp0))]
val10=linewidth 2	polygon black,$val7+1.5*$val9,$val8,$val7+2*$val9,$val8+$val9,$val7+3*$val9,$val8+1.5*$val9,$val7+2*$val9,$val8+2*$val9,$val7+1.5*$val9,$val8+3*$val9,$val7+$val9,$val8+2*$val9,$val7,$val8+1.5*$val9,$val7+$val9,$val8+$val9
val11=$[rint($val7+1.5*$val9)]
val12=$[rint($val8+1.5*$val9)]
val13=$[rint(20)]
!readproc oef/draw.phtml 400,400 \
$val10 
tmp0=$ins_url
val14=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val14;circle,$val11,$val12,$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val6	<div class="wimscenter"> 
!read oef/embed.phtml r1,400x400 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6
embedcnt=1
