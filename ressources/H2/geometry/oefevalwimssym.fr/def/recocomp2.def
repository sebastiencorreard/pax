!set title=Figure et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
val7=$[rint(70)]
!if $val6=1 
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
!if $val8=1 
!readproc oef/draw.phtml 200,200 \
square 100-$val7/2,100-$val7/2,$val7,black	polygon black,100-$val7/2,100-$val7/2,100,100-$val7/2-sqrt(3)/2*$val7,100+$val7/2,100-$val7/2	polygon black,100-$val7/2,100+$val7/2,100,100+$val7/2+sqrt(3)/2*$val7,100+$val7/2,100+$val7/2 
tmp0=$ins_url
val9=$(tmp0)
!else
!readproc oef/draw.phtml 200,200 \
square 100-$val7/2,100-$val7/2,$val7,black	polygon black,100-$val7/2,100-$val7/2,100-$val7/2-sqrt(3)/2*$val7,100,100-$val7/2,100+$val7/2	polygon black,100+$val7/2,100-$val7/2,100+$val7/2+sqrt(3)/2*$val7,100,100+$val7/2,100+$val7/2 
tmp0=$ins_url
val9=$(tmp0)
!endif
!else
tmp=!translate internal $	$ to ; in polygon black,100-$val7/2,100-$val7/2,100,100-$val7/2-sqrt(3)/2*$val7,100+$val7/2,100-$val7/2	polygon black,100-$val7/2,100+$val7/2,100,100+$val7/2+sqrt(3)/2*$val7,100+$val7/2,100+$val7/2	polygon black,100-$val7/2,100-$val7/2,100-$val7/2-sqrt(3)/2*$val7,100,100-$val7/2,100+$val7/2	polygon black,100+$val7/2,100-$val7/2,100+$val7/2+sqrt(3)/2*$val7,100,100+$val7/2,100+$val7/2

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
!readproc oef/draw.phtml 200,200 \
square 100-$val7/2,100-$val7/2,$val7,black	$val10 
tmp0=$ins_url
val9=$(tmp0)
!endif
val11=Oui,Non
tmp0=!item $val6 of $val11

val6=$(tmp0)
choicename1=
choicegood1=$val6
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

