!set title=Centre de symétrie d'une figure
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquez avec la souris à l'emplacement du centre	  de symétrie de la figure suivante&nbsp;
tmp0=!randint 10, 40

val7=$[rint($(tmp0))]
tmp0=!randint 10, 40

val8=$[rint($(tmp0))]
tmp0=!randint 75, 150

val9=$[rint($(tmp0))]
tmp0=!randint 100, 150

val10=$[rint(2*$(tmp0))]
tmp0=!randint 10, 150

val11=$[rint($(tmp0))]
val12=linewidth 2	polygon black,$val7,$val8,$val7+$val9,$val8,$val7+$val11,$val8+$val10,$val7+$val9+$val11,$val8+$val10
val13=$[rint($val7+($val9+$val11)/2)]
val14=$[rint($val8+$val10/2)]
val15=$[rint(20)]
!readproc oef/draw.phtml 400,400 \
$val12 
tmp0=$ins_url
val16=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val16;circle,$val13,$val14,$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val6	<div class="wimscenter"> 
!read oef/embed.phtml r1,400x400 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

