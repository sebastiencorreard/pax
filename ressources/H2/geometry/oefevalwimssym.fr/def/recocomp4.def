!set title=Figure et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!randint 50, 80

val7=$[rint($(tmp0))]
!if $val6=1 
!readproc oef/draw.phtml 200,200 \
polygon black,20,100-$val7,20,100,100,100	polygon black,180,100+$val7,180,100,100,100 
tmp0=$ins_url
val8=$(tmp0)
!else
tmp=!nonempty items -1,1

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]
!readproc oef/draw.phtml 200,200 \
polygon black,20,100+$val9*$val7,20,100,100,100	polygon black,180,100+$val9*$val7,180,100,100,100 
tmp0=$ins_url
val8=$(tmp0)
!endif
val10=Oui,Non
tmp0=!item $val6 of $val10

val6=$(tmp0)
choicename1=
choicegood1=$val6
choicebad1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val8" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8
embedcnt=0
