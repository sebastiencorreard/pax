!set title=Figure et centre de symétrie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fguerima@free.fr

ansorder=c
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
!if $val6=2 
!readproc oef/draw.phtml 200,200 \
circle 100,100,160,black	polygon black,100-sqrt(3)/2*80,60,100+sqrt(3)/2*80,60,100,180 
tmp0=$ins_url
val7=$(tmp0)
!else
!readproc oef/draw.phtml 200,200 \
arc 100,80,150,150,180,360,black	segment 25,80,175,80,black	segment 25,120,175,120,black	arc 100,120,150,150,0,180,black 
tmp0=$ins_url
val7=$(tmp0)
!endif
val8=Oui,Non
tmp0=!item $val6 of $val8

val6=$(tmp0)
choicename1=
choicegood1=$val6
choicebad1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 La figure ci-dessous possède-t-elle un centre de symétrie ?	<div class="wimscenter"><img src="$val7" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7
embedcnt=0
