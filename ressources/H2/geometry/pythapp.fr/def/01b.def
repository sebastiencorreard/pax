!set title=01.b Identifier une hypoténuse
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Euler,Académie de Versailles
email=euler.wims@ac-versailles.fr
keywords=
keywords=triangle rectangle
computeanswer=yes
oefdescription=Déterminer l'hypoténuse du triangle rectangle donné.
oefobservation=Déterminer l'hypoténuse d'un triangle rectangle donné. Une figure accompagne la solution seulement. 
oefcss= <style> .indication{ font-weight:bold;color:#009999; margin-bottom: 0.8em; margin-top: 0.8em; } .quest{ color:blue; font-weight:bold; margin:0; } </style> 

ansorder=r
varcnt=75
prevarcnt=61
postvarcnt=13
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
!if $val6=fr 
credits=
!endif
val7=AME,AMI,ARC,ART,BAC,BAL,BAM,BAS,BEC,BLE,BOA,BOL,BON,BUS,BUT,BZH,	CAP,CAR,CIL,CLE,COL,COR,COU,CRI,CRU,DIX,DON,DOS,DRU,DUO,DUR,	EAU,EST,FAC,FAR,FAT,FER,FEU,FIL,FIN,FOL,FOU,FUT,GAI,GEL,INF,	JEU,JET,JUS,LAC,LET,LIN,LIT,LOI,LOT,LYS,MAI,MAL,MAT,MER,MIL,MOI,MON,MOT,MOU,MUR,	NEF,NEZ,PAF,PIC,PIN,PLI,POC,POF,POT,PUR,RAP,RAS,RAZ,RIA,RIO,RIZ,RUE,	SAC,SEC,SEL,SET,SIX,SOC,SOL,SON,SOU,SPI,SUD,SUP,	TAC,TAS,TIC,TIR,THE,TOI,TON,TRI,UNE,UNI,VAL,VAN,VER,VUE,YEN,ZEN	
tmp=!nonempty items $val7

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!char 1 of $val8

val9=$(tmp0)
tmp0=!char 2 of $val8

val10=$(tmp0)
tmp0=!char 3 of $val8

val11=$(tmp0)
val12=$val9,$val10,$val11
tmp0=!randint 1, 3

val13=$[rint($(tmp0))]
val14=$(val12[$val13])
tmp0=!listcomplement $val14 in $val12

val15=$(tmp0)
val16=
val17=
val18=
tmp=!nonempty items \(\left[$(val15[1])$(val15[2])\right]\),\(\left[$(val15[2])$(val15[1])\right]\)

tmp0=!randitem $tmp
tmp=!nonempty items \(\left[$(val15[1])$val14\right]\),\(\left[$val14$(val15[1])\right]\)

tmp1=!randitem $tmp
tmp=!nonempty items \(\left[$(val15[2])$val14\right]\),\(\left[$val14$(val15[2])\right]\)

tmp2=!randitem $tmp
val19=$(tmp0),$(tmp1),$(tmp2)
tmp0=!shuffle $val19

val19=$(tmp0)
tmp0=!positionof item \(\left[$(val15[1])$(val15[2])\right]\) in $val19

val20=$[rint($(tmp0))]
!if $val20=NaN 
tmp0=!positionof item \(\left[$(val15[2])$(val15[1])\right]\) in $val19

val20=$[rint($(tmp0))]
!endif
tmp0=!shuffle 3

val21=$(tmp0)
tmp0=!positionof item $val20 in $val21

val22=$(tmp0)
val23=$(val19[$val21])
tmp0=!randint 0, 255

val24=$[rint($(tmp0))]
tmp0=!randint 0, 255

val25=$[rint($(tmp0))]
tmp0=!randint 0, 255

val26=$[rint($(tmp0))]
val27=rgb($val24,$val25,$val26)	
tmp0=!randint 1, 3

val28=$[rint($(tmp0))]
tmp0=!randint 1, 3

val29=$[rint($(tmp0))]
tmp0=!random 0, 6.28

val30=$[$(tmp0)]
val31=$[Pi/2+$val30]
val32=$[$val28*cos($val30)]
val33=$[$val28*sin($val30)]
val34=$[$val29*cos($val31)]
val35=$[$val29*sin($val31)]
val36=$[min(0.3,min($val28/10,$val29/10))	    ]
val37=$[min(min(0,$val32),$val34)-1]
val38=$[max(max(0,$val32),$val34)+1]
val39=$[min(min(0,$val33),$val35)-1]
val40=$[max(max(0,$val33),$val35)+1]
val41=$[rint(($val38-$val37))]
val42=$[rint(($val40-$val39))]
val43={showCopyright : false,axis:false,	   boundingbox: [$val37,$val40,$val38,$val39],	   grid:false,	   keepaspectratio : true,	   zoom: {factorX: 1.25,factorY: 1.25,wheel: true,needShift: true,eps: 0.001},	   pan:{	    needShift: false,	    enabled: true,	    needTwoFingers: true,	    pinchHorizontal: true,	    pinchVertical: true,	    pinchSensitivity: 7	   }	  }	
val44=A=brd.create('point',[0,0],{name:'$val14',face:'x',size:3,color:'$val27',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});	    B=brd.create('point',[$val32,$val33],{name:'$(val15[1])',face:'x',size:3,color:'$val27',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});	    C=brd.create('point',[$val34,$val35],{name:'$(val15[2])',face:'x',size:3,color:'$val27',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});	    brd.create('angle',[B,A,C],{name:' ',radius:$val36,strokeColor:'black',fillColor:'red',fillOpacity:0.8});	    brd.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: '$val27',highlightfillColor:'$val27'})	    
!readproc slib/geo2D/jsxgraph sol brd,[$val41 x $val42,center min=200px max=300px scroll],var brd = JXG.JSXGraph.initBoard('sol',$val43); $val44 
tmp0=$slib_out
val45=$(tmp0)
val46=Cliquer, dans la liste ci-dessous, sur l'hypoténuse du triangle $val9$val10$val11&nbsp;:
val47=Compléter.
val48=Vous avez répondu&nbsp;:<br class="spacer">
val49=Cette réponse est exacte.
val50=Cette réponse est fausse.
val51=<span class="euler_credit">Figure réalisée avec JSXGraph</span>
val52=Soit $val9$val10$val11 un triangle rectangle en <span class="nowrap">$val14.</span><br class="spacer">
val53=$val52
val54=Son hypoténuse est le côté
val55=Son hypoténuse est le côté ..........
val56=Le point $val14 est le sommet de l'angle droit&nbsp;; <br>	les côtés de l'angle droit sont les segments [$val14$(val15[1])] et [$val14$(val15[2])]&nbsp;; <br>	le troisième côté du triangle, côté opposé à l'angle droit, est l'hypoténuse.	<p> Ici l'hypoténuse est le côté <span class="oef_indgood">[$(val15[1])$(val15[2])]</span>,	  nommé aussi <span class="oef_indgood">[$(val15[2])$(val15[1])]</span>.</p>	
val57=Hypoténuse identifiée&nbsp;
val58=Hypoténuse correctement écrite&nbsp;
val59=Réponse correcte
val60=Réponse fausse
val61=Réponse correcte oubliée
val62=Par définition, l'hypoténuse d'un triangle rectangle est le côté opposé à son angle droit.
val63=Dans un triangle rectangle, le carré de la longueur de l'hypoténuse est égal à la somme des carrés des	 longueurs des deux côtés de l'angle droit.
replytype1=radio
replyname1=
replygood1=$val22;$val21
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst  $val62 

solution=!nosubst  <div class="grid-x grid-margin-x"> <div class="cell small-12 medium-12 large-6"> <div class ="euler_quest_nobg"> <p>$val53</p> $val55 </div> <div class ="euler_rep_good_nobg"> $val56 </div> </div> <div class="cell small-12 medium-12 large-6" style="text-align:center"> $val45 $val51 </div> </div> 


!goto stat

!exit

