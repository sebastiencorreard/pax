%%%%%%%%%%%%%% TITLE %%%%%%%%%%%%%
\title{01.a Identifier une hypoténuse}
\author{Euler,Académie de Versailles}
%%% CK & GM %%%
\language{\lang}
\email{euler.wims@ac-versailles.fr}
\format{html}
\computeanswer{yes}
\if{\lang=fr}{
\keywords{}
\credits{}
\keywords{triangle rectangle}
}
%%%%%%%%%%%%% DESCRIPTION - OBSERVATION %%%%%%%%%%%%%%%
\description{Déterminer l'hypoténuse du triangle rectangle donné.}
\observation{Déterminer l'hypoténuse d'un triangle rectangle donné.
Une figure accompagne
    l'énoncé et la solution.
}
%%% css commune autre que css euler et css particuliere %%%
\css{
<style>
.indication{
  font-weight:bold;color:#009999;
  margin-bottom: 0.8em;
  margin-top: 0.8em;
}
.quest{
  color:blue;
  font-weight:bold;
  margin:0;
}
</style>
}
%%%%% VARIABLES DE L'EXERCICE %%%%%
%%
%%% Noms des triangles
\text{noms_triangles=AME,AMI,ARC,ART,BAC,BAL,BAM,BAS,BEC,BLE,BOA,BOL,BON,BUS,BUT,BZH,
CAP,CAR,CIL,CLE,COL,COR,COU,CRI,CRU,DIX,DON,DOS,DRU,DUO,DUR,
EAU,EST,FAC,FAR,FAT,FER,FEU,FIL,FIN,FOL,FOU,FUT,GAI,GEL,INF,
JEU,JET,JUS,LAC,LET,LIN,LIT,LOI,LOT,LYS,MAI,MAL,MAT,MER,MIL,MOI,MON,MOT,MOU,MUR,
NEF,NEZ,PAF,PIC,PIN,PLI,POC,POF,POT,PUR,RAP,RAS,RAZ,RIA,RIO,RIZ,RUE,
SAC,SEC,SEL,SET,SIX,SOC,SOL,SON,SOU,SPI,SUD,SUP,
TAC,TAS,TIC,TIR,THE,TOI,TON,TRI,UNE,UNI,VAL,VAN,VER,VUE,YEN,ZEN
}
%% Les noms des objets géométriques
\text{nom = randitem(\noms_triangles)}
#######POUR TEST ########
%%%text{nom = ABC}
#########################
\text{A = wims(char 1 of \nom)}
\text{B = wims(char 2 of \nom)}
\text{C = wims(char 3 of \nom)}
\text{Triangle=\A,\B,\C}
\integer{Alea=randint(1..3)}
\text{Sommet=\Triangle[\Alea]}
\text{Hyp=wims(listcomplement \Sommet in \Triangle)}
%%% Variable pour après statement
\text{sigle=}
  \text{sigle_title=}
  \text{checked=}
  \text{liste_cotes=randitem(\(\left[\Hyp[1]\Hyp[2]\right]\),\(\left[\Hyp[2]\Hyp[1]\right]\)),randitem(\(\left[\Hyp[1]\Sommet\right]\),\(\left[\Sommet\Hyp[1]\right]\)),randitem(\(\left[\Hyp[2]\Sommet\right]\),\(\left[\Sommet\Hyp[2]\right]\))}
  \text{liste_cotes=wims(shuffle \liste_cotes)}
  \integer{posi=wims(positionof item \(\left[\Hyp[1]\Hyp[2]\right]\) in \liste_cotes)}
  \if{\posi=NaN}{\integer{posi=wims(positionof item \(\left[\Hyp[2]\Hyp[1]\right]\) in \liste_cotes)}}
  \text{shuf=shuffle(3)}
  \text{solution1=position(\posi,\shuf)}
  \text{propo=\liste_cotes[\shuf]}
%%%%%% FIGURES %%%%%%
%%% Couleurs
\integer{red=randint(0..255)}
\integer{green=randint(0..255)}
\integer{blue=randint(0..255)}
\text{couleur=rgb(\red,\green,\blue)
}
    %% Figure
    %%% Les points
    \integer{x_B=randint(1..3)}
    \integer{y_C=randint(1..3)}
    \real{angleRot=random(0..6.28)}
    \real{angleRot2=Pi/2+\angleRot}
    \real{x_B2=\x_B*cos(\angleRot)}
    \real{y_B2=\x_B*sin(\angleRot)}
    \real{x_C2=\y_C*cos(\angleRot2)}
    \real{y_C2=\y_C*sin(\angleRot2)}
    \real{radiusAngle=min(0.3,min(\x_B/10,\y_C/10))
    }
    \real{xMin=min(min(0,\x_B2),\x_C2)-1}
    \real{xMax=max(max(0,\x_B2),\x_C2)+1}
    \real{yMin=min(min(0,\y_B2),\y_C2)-1}
    \real{yMax=max(max(0,\y_B2),\y_C2)+1}
%%% Le cadre
\integer{LCadre=(\xMax-\xMin)}
\integer{hCadre=(\yMax-\yMin)}
%%% Options JSXGraph
\text{options=
  {showCopyright : false,axis:false,
   boundingbox: [\xMin,\yMax,\xMax,\yMin],
   grid:false,
   keepaspectratio : true,
   zoom: {factorX: 1.25,factorY: 1.25,wheel: true,needShift: true,eps: 0.001},
   pan:{
    needShift: false,
    enabled: true,
    needTwoFingers: true,
    pinchHorizontal: true,
    pinchVertical: true,
    pinchSensitivity: 7
   }
  }
}
    \text{constructions=
    A=brd.create('point',[0,0],{name:'\Sommet',face:'x',size:3,color:'\couleur',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});
    B=brd.create('point',[\x_B2,\y_B2],{name:'\Hyp[1]',face:'x',size:3,color:'\couleur',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});
    C=brd.create('point',[\x_C2,\y_C2],{name:'\Hyp[2]',face:'x',size:3,color:'\couleur',fixed:true,showInfobox:false,label:{autoPosition: true,fixed: false}});
    brd.create('angle',[B,A,C],{name:' ',radius:\radiusAngle,strokeColor:'black',fillColor:'red',fillOpacity:0.8});
    brd.create('polygon',[A,B,C],{strokeColor: 'black',fillColor: '\couleur',highlightfillColor:'\couleur'})
    }
    %%% Le dessin énoncé
    \text{fig_enonce=slib(geo2D/jsxgraph enonce brd,[\LCadre x \hCadre,center min=200px max=300px scroll],var brd = JXG.JSXGraph.initBoard('enonce',\options); \constructions)}
    %%% Le dessin solution
    \text{fig_sol=slib(geo2D/jsxgraph sol brd,[\LCadre x \hCadre,center min=200px max=300px scroll],var brd = JXG.JSXGraph.initBoard('sol',\options); \constructions)}
%%%%%%%%%%%%%%%%%% TEXTES DE L EXERCICE %%%%%%%%%%%
\text{enonce0=Cliquer, dans la liste ci-dessous, sur l'hypoténuse du triangle \A\B\C&nbsp;:}
\text{enonce0_sol=Compléter.}
\text{reprise_rep=Vous avez répondu&nbsp;:<br class="spacer">}
\text{rep_exacte=Cette réponse est exacte.}
\text{rep_fausse=Cette réponse est fausse.}
\text{credits_JSX=<span class="euler_credit">Figure réalisée avec JSXGraph</span>}
\text{enonce1=Soit \A\B\C un triangle rectangle en <span class="nowrap">\Sommet.</span><br class="spacer">}
\text{enonce1_sol=\enonce1}
\text{enonce_saisie=Son hypoténuse est le côté}
\text{enonce_saisie_sol=Son hypoténuse est le côté ..........}
\text{sol_sol1=Le point \Sommet est le sommet de l'angle droit&nbsp;; <br>
les côtés de l'angle droit sont les segments [\Sommet\Hyp[1]] et [\Sommet\Hyp[2]]&nbsp;; <br>
le troisième côté du triangle, côté opposé à l'angle droit, est l'hypoténuse.
<p> Ici l'hypoténuse est le côté <span class="oef_indgood">[\Hyp[1]\Hyp[2]]</span>,
  nommé aussi <span class="oef_indgood">[\Hyp[2]\Hyp[1]]</span>.</p>
}
\text{cond1=Hypoténuse identifiée&nbsp;}
\text{cond2=Hypoténuse correctement écrite&nbsp;}
%%% Sigle Title %%%%
\text{title_good=Réponse correcte}
\text{title_bad=Réponse fausse}
\text{title_forget=Réponse correcte oubliée}
%%%%%%%%%%%%%% HINT %%%%%%%%%%%%%%
\text{indic1=Par définition, l'hypoténuse d'un triangle rectangle est le côté opposé à son angle droit.}
\text{indic2=Dans un triangle rectangle, le carré de la longueur de l'hypoténuse est égal à la somme des carrés des
 longueurs des deux côtés de l'angle droit.}
%%%%%%%%%%%%%%%%%%%%%%%%%%% HELP %%%%%%%%%%%%%%%%%%%%%%%%%%%
\text{aide1=
