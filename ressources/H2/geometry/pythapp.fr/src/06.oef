%%%%% VARIABLES DE L'EXERCICE %%%%%
%%
%%% Noms des triangles
\text{noms_triangles=AME,AMI,ARC,ART,BAC,BAL,BAM,BAS,BEC,BLE,BOA,BOL,BON,BUS,BUT,BZH,
CAP,CAR,CIL,CLE,COL,COR,COU,CRI,CRU,DIX,DON,DOS,DRU,DUO,DUR,
EAU,EST,FAC,FAR,FAT,FER,FEU,FIL,FIN,FOL,FOU,FUT,GAI,GEL,INF,
JEU,JET,JUS,LAC,LET,LIN,LIT,LOI,LOT,LYS,MAI,MAL,MAT,MER,MIL,MOI,MON,MOT,MOU,MUR,
NEF,NEZ,PAF,PIC,PIN,PLI,POC,POF,POT,PUR,RAP,RAS,RAZ,RIA,RIO,RIZ,RUE,
SAC,SEC,SEL,SET,SIX,SOC,SOL,SON,SOU,SPI,SUD,SUP,
TAC,TAS,TIC,TIR,THE,TOI,TON,TRI,UNE,UNI,VAL,VAN,VER,VUE,YEN,ZEN
}
%% Les noms des objets géométriques
\text{nom = randitem(\noms_triangles)}
#######POUR TEST ########
%%%text{nom = ABC}
#########################
\text{A = wims(char 1 of \nom)}
\text{B = wims(char 2 of \nom)}
\text{C = wims(char 3 of \nom)}
\text{liste_sommets=\(\mathrm{\A}\),\(\mathrm{\B}\), \(\mathrm{\C}\)}
%%% Pour chaque ligne : item 1 = égalité, item 2 = justifications pour bloc solution si nécessaires
\matrix{mat1=\(\B\C^2=\A\B^2+\A\C^2\),
\(\C\B^2=\B\A^2+\A\C^2\),
\(\A\B^2+\A\C^2=\B\C^2\),
}
\integer{nb_egal=rows(\mat1)}
\matrix{mat2=wims(replace internal \A by @ in \mat1)}
\matrix{mat2=wims(replace internal \B by \A in \mat2)}
\matrix{mat2=wims(replace internal @ by \B in \mat2)}
\matrix{mat3=wims(replace internal \B by @ in \mat2)}
\matrix{mat3=wims(replace internal \C by \B in \mat3)}
\matrix{mat3=wims(replace internal @ by \C in \mat3)}
\matrix{mat1=\mat1[randint(1..\nb_egal);]}
\matrix{mat2=\mat2[randint(1..\nb_egal);]}
\matrix{mat3=\mat3[randint(1..\nb_egal);]}
\matrix{data_egalites=\mat1
\mat2
\mat3}
\matrix{data=1,a,b
a,1,b
a,b,1}
\text{mix = shuffle(rows(\data))}
\text{data2 = \data[\mix[1..3]; ]}
\text{rep1=position(1,\data2[1;])}
\text{rep2=position(1,\data2[2;])}
\text{rep3=position(1,\data2[3;])}
%%% Variables pour analyses après statement
\text{checked=}
\text{repons=}
\text{screply=}
\text{sigle=}
\text{sigle_title=}
%%%%%% FIGURES %%%%%%
%%%%%%%%%%%%%%%%%% TEXTES DE L EXERCICE %%%%%%%%%%%
\text{enonce0_sol=Compléter.}
\text{reprise_rep=Vous avez répondu&nbsp;:<br class="spacer">}
\text{rep_exacte=Cette réponse est exacte.}
\text{rep_fausse=Cette réponse est fausse.}
\text{def_triangle=Le triangle \(\A\B\C\) est rectangle en }
\text{def_triangle2=Dans le triangle \(\A\B\C\) rectangle en }
\text{sol1=d'après le théorème de Pythagore}
\text{sol2= on a successivement&nbsp;:}
\text{enonce0=On donne trois descriptions de triangle \(\A\B\C\) et trois égalités.
<div class="spacer quest">Pour chacun des cas suivants, sélectionner le sommet qui permet d'associer à l'égalité de Pythagore donnée le triangle rectangle correspondant.</div>
}
%%%%% TABLE SOLUTION %%%%
\text{th1=Triangle}
\text{th2=&#201;galité}
\text{sol_liaison=Des indications ci-dessus nous déduisons les associations suivantes&nbsp;:
}
%%% Sigle Title %%%%
\text{title_good=Réponse correcte}
\text{title_bad=Réponse fausse}
\text{title_forget=Réponse correcte oubliée}
%%%%%%%%%%%%%% HINT %%%%%%%%%%%%%%
\text{titre_indic1=Indication 1 - Hypoténuse}
\text{titre_indic2=Indication 2 - Théorème de Pythagore}
\text{indic1=Par définition, l'hypoténuse d'un triangle rectangle est le côté opposé à son angle droit.}
\text{indic2=Dans un triangle rectangle, le carré de la longueur de l'hypoténuse est égal à la somme des carrés des
 longueurs des deux côtés de l'angle droit.}
%%%%%%%%%%%%%%%%%%%%%%%%%%% HELP %%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%% STATEMENT %%%%%%%
\statement{
<div class="euler_quest">
\enonce0
</div>
\if{\reply1!=}{<div class="spacer">\reprise_rep</div>}
<div class="wims_scrollable">
<table class="tab_sol">
  <tr>
    <th >\th2</th>
    <th>\def_triangle</th>
  </tr>
  \for{k=1 to 3}
   {<tr>
     <th scope="row">\data_egalites[\mix[\k];1]</th>
      <td>
        <fieldset class="euler_field">
         <legend> </legend>
        <ul class="wims_nopuce euler_ul_check">
          \for{n=1 to 3}
          {<li \if{\sc_reply1!=}{class="\checked[\k;\n]"}>
           \embed{reply\k,\n,\liste_sommets[\n] }
           \if {\sc_reply1!=}{<span class="\sigle[\k;\n]" title="\sigle_title[\k;\n]"></span>}
          </li>}
        </ul>
        </fieldset>
      </td>
    </tr>
   }
</table>
</div>
}
%%%%% ANSWER %%%%%%
\answer{}{\rep1;\data2[1;]}{type=radio}
\answer{}{\rep2;\data2[2;]}{type=radio}
\answer{}{\rep3;\data2[3;]}{type=radio}
\text{screply=\sc_reply1,\sc_reply2,\sc_reply3}
\text{repons=\reply1,\reply2,\reply3}
\for {r=1 to 3}
  {\text{ligne1=}
   \text{ligne2=}
   \text{ligne3=}
   \for {j=1 to 3}
    {\if{\data2[\r;\j] isitemof \repons[\r]}
      {\text{temp1=euler_radio_checked}
      \if{\screply[\r]=1}
        {\text{temp2=oef_indgood tick}
         \text{temp3=\title_good}
        }
        {\text{temp2=oef_indbad cross}
         \text{temp3=\title_bad}
        }
      }
      {\text{temp1=euler_radio_nochecked}
       \text{temp2=oef_indneutral}
       \text{temp3=0}
      }
     \text{ligne1=wims(append item \temp1 to \ligne1)}
     \text{ligne2=wims(append item \temp2 to \ligne2)}
     \text{ligne3=wims(append item \temp3 to \ligne3)}
    }
    \matrix{checked=\checked
    \ligne1}
    \matrix{sigle=\sigle
    \ligne2}
    \matrix{sigle_title=\sigle_title
    \ligne3}
}
%%%%% HINT %%%%%
