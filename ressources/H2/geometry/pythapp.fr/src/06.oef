}
%%%%% SOLUTION %%%%%
\solution{
  <div class="indication">\titre_indic1</div>
  <div>\indic1</div>
  <div class="spacer indication">\titre_indic2</div>
  <div>\indic2</div>
  <div class="spacer">
  <p>\sol_liaison</p>
   <table class="tab_sol">
