!set title=Alignement 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
val10=$(val6[4])
tmp0=!randint 45, 105

val11=$[rint($(tmp0))]
val12=$[rint(180-$val11)]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 3, 10

val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 130, 180

val14=$[rint($(tmp0))]
val15=$[rint($val14+220*tan((90-$val11)*pi/180))]
val15=$[rint(min(270,$val15))]
val15=$[rint(max(30,$val15))]
!readproc oef/draw.phtml 300,300 \
triangle 20,260,$val15,40,$val14,260+$val13,black	triangle $val15,40,$val14,260+$val13,280,260,black	text black,15,265,medium,$val7	text black,$val14-5,265+$val13,medium,$val8	text black,275,265,medium,$val9	text black,$val15-5,25,medium,$val10 
tmp0=$ins_url
val16=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_left spacer"><img width="300" src="$val16" alt="" /></div>	<div class="float_left spacer">
!insmath $val7$val8$val10
$() et 
!insmath $val8$val10$val9
$() sont des triangles. L'angle du sommet	$val8 du triangle 
!insmath $val7$val8$val10
$() mesure $val11 degrés.<br/>	Quelle doit être la mesure de l'angle du sommet $val8 du triangle 
!insmath $val8$val9$val10
$()	pour que les points $val7, $val8 et $val9 soient alignés ?	<p>	<b>Votre réponse :</b>	 
!read oef/embed.phtml r1,5 
$() degrés.	</p>	</div>		
$()
!exit

