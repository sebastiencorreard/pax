!set title=Nom de triangle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=triangle isocèle,triangle rectangle,triangle rectangle isocèle,triangle équilatéral
tmp0=!random pi/3, 2*pi/3

val7=$[$(tmp0)]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!random pi/6, 3*pi/12

val8=$[pi/2+$(tmp0)*$(tmp1)]
tmp=!trim 0,$val7,2*pi-$val7,white,white,white,white,red,red	0,pi,pi+$val8,white,white,white,white,white,red	0,pi,3*pi/2,white,white,white,red,red,red	0,2*pi/3,4*pi/3,white,white,white,red,red,red
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val10=$[rint($(tmp0))]
!readproc slib/triangle $(val9[$val10;]) 
tmp0=$slib_out
val11=$(tmp0)
!readproc oef/draw.phtml 300,300 \
$val11 
tmp0=$ins_url
val12=$(tmp0)
choicename1=
choicegood1=$(val6[$val10])
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	D'après le codage, quel est le nom du triangle suivant ?	<div class="wimscenter"><img src="$val12" alt=""/></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=0
