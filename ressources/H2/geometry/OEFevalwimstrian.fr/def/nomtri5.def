!set title=Nom de triangle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=triangles isocèles,triangles rectangles,triangles rectangles isocèles,triangles équilatéraux
tmp=!trim 1,3,4,5,6,7	2,3,6	3,6	4,7
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!random pi/3, 2*pi/3

val8=$[$(tmp0)]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!random pi/6, 3*pi/12

val9=$[pi/2+$(tmp0)*$(tmp1)]
tmp=!trim 0,$val8,2*pi-$val8,white,white,white,white,red,red	0,pi,pi+$val9,white,white,white,white,white,red	0,pi,3*pi/2,white,white,white,red,red,red	0,2*pi/3,4*pi/3,white,white,white,red,red,red	0,$val8,2*pi-$val8,white,red,red,white,white,white	0,pi,3*pi/2,red,red,white,white,white,red	0,2*pi/3,4*pi/3,red,red,red,white,white,white
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val11=$[rint($(tmp0))]
tmp=!nonempty items $(val7[$val11;])

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
tmp0=!values v for v=1 to 7

val13=$(tmp0)
tmp0=!listcomplement $val12 in $val13

val13=$(tmp0)
tmp0=!shuffle $val13

val13=$val12,$(tmp0)
val14=
val15=
!for val16 =1 to 4 
!readproc slib/triangle $(val10[$(val13[$val16]);]) 
tmp0=$slib_out
val17=$(tmp0)
!readproc oef/draw.phtml 150,150 \
$val17 
tmp0=$ins_url
val17=$(tmp0)
tmp0=!append item $val17 to $val14

val14=$(tmp0)

!ifval $(val13[$val16]) isitemof $(val7[$val11;])
tmp0=!append item $val16 to $val15

val15=$(tmp0)
!endif
!next
replytype1=checkbox
replyname1=
replygood1=$val15;Triangle 1,Triangle 2,Triangle 3,Triangle 4
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Parmi les triangles suivants, lequel ou lesquels sont des $(val6[$val11]) ?	<table class="wimscenter wimsborder">	 <tr> 
!for m_k=1 to 4 
$()<td>Triangle $m_k</td> 
!next
$()</tr>	 <tr> 
!for m_l=1 to 4 
$()<td><img src="$(val14[$m_l])" alt="" /></td> 
!next
$()</tr>	</table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,14
embedcnt=0
