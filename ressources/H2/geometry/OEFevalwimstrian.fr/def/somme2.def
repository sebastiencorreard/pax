!set title=Déterminer la mesure d'un angle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
tmp=!nonempty items $val7$val8$val9,$val7$val9$val8,$val8$val7$val9,$val8$val9$val7,$val9$val7$val8,$val9$val8$val7

tmp0=!randitem $tmp
val10=$(tmp0)
val11=isocèle rectangle en $val7
val12=45
tmp=!nonempty items $val8,$val9

tmp0=!randitem $tmp
val13=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le triangle $val10 est $val11.<p>	Quelle est la mesure, en degrés, de l'angle 
!insmath \widehat{$val13}
$() ?	</p>	<b>Votre réponse :</b>	 
!read oef/embed.phtml r1,5 
$() degrés.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,13
embedcnt=1
