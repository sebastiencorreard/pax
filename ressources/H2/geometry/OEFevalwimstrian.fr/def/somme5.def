!set title=Déterminer la mesure d'un angle 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle A,B,C,D,E,F,G,H

val6=$(tmp0)
val7=$(val6[1])
val8=$(val6[2])
val9=$(val6[3])
tmp=!nonempty items $val7$val8$val9,$val7$val9$val8,$val8$val7$val9,$val8$val9$val7,$val9$val7$val8,$val9$val8$val7

tmp0=!randitem $tmp
val10=$(tmp0)
tmp0=!randint 15, 40

val11=$[rint($(tmp0))]
val12=$[rint(180-2*$val11)]
val13=isocèle en $val7. L'angle \(\widehat{$val8}) mesure $val11 degrés
val14=$val7
replytype1=numexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Le triangle $val10 est $val13.<p>	Quelle est la mesure, en degrés, de l'angle 
!insmath \widehat{$val14}
$() ?	</p>	<b>Votre réponse :</b>	 
!read oef/embed.phtml r1,5 
$() degrés.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,13,14
embedcnt=1
