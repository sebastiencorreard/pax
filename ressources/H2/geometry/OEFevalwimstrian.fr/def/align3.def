!set title=Alignement 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Oui&#44; les points sont alignés,Non&#44; les points ne sont pas alignés
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
tmp0=!item $val7 of $val6

val8=$(tmp0)

!ifval $val7=1
val9=$[rint(60)]
!else
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 1, 5

val9=$[rint(60+$(tmp0)*$(tmp1))]
!endif
choicename1=
choicegood1=$val8
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_left"><img width="300" src="$val1/align3.jpg" alt="" /></div>	<div class="float_left">	Sur la figure ci-contre, les triangles ABC et BDE sont équilatéraux.<br/>	Le triangle BCE est isocèle en E.<br/>	L'angle 
!insmath \ \alpha
$() mesure $val9 degrés.	<p >Les points A, B et D sont-ils alignés ?</p>	</div>		
$()
!exit

