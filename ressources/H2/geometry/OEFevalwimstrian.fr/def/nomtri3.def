!set title=Nom de triangle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=triangle isocèle,triangle rectangle,triangle rectangle isocèle,triangle équilatéral
tmp=!trim exactement deux angles de même mesure	un angle droit	un angle droit et deux angles de même mesure	trois angles de même mesure
val7=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 4

val8=$[rint($(tmp0))]
choicename1=
choicegood1=$(val6[$val8])
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Je suis un triangle possèdant $(val7[$val8;]).	Quel est mon nom ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8
embedcnt=0
