!set title=Alignement 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Oui&#44; les points sont alignés,Non&#44; les points ne sont pas alignés
tmp0=!randint 1, 2

val7=$[rint($(tmp0))]
tmp0=!item $val7 of $val6

val8=$(tmp0)
tmp0=!randint 30, 40

val9=$[rint($(tmp0))]
tmp0=!randint 30, 40

val10=$[rint($(tmp0))]

!ifval $val7=1
val11=$[rint($val9+$val10)]
!else
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
tmp1=!randint 1, 5

val11=$[rint($val9+$val10+$(tmp0)*$(tmp1))]
!endif
choicename1=
choicegood1=$val8
choicebad1=$val6
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="float_left">	<img width="300" src="$val1/align2.JPG" alt="" />	</div><div class="float_left">	Sur la figure ci-contre, le triangle ABM est isocèle en B.	Les angles 
!insmath \ \alpha
$(), 
!insmath \ \beta
$() et 
!insmath \ \gamma
$() mesurent respectivement	$val9, $val10 et $val11 degrés.	<p>Les points A, M et C sont-ils alignés ?</p>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,9,10,11
embedcnt=0
