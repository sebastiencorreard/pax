\title{Nom de triangle 1}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}

\text{list=triangle isocèle,triangle rectangle,triangle rectangle isocèle,triangle équilatéral}
\real{a=random(pi/3..2*pi/3)}
\real{b=pi/2+randitem(1,-1)*random(pi/6..3*pi/12)}
\matrix{don=0,\a,2*pi-\a,white,white,white,white,red,red
0,pi,pi+\b,white,white,white,white,white,red
0,pi,3*pi/2,white,white,white,red,red,red
0,2*pi/3,4*pi/3,white,white,white,red,red,red}

\integer{ch=randint(1..4)}

\text{figure=slib(triangle \don[\ch;])}
\text{image=draw(300,300
\figure)}

\statement{
D'après le codage, quel est le nom du triangle suivant ?
<div class="wimscenter"><img src="\image" alt=""/></div>}

\choice{}{\list[\ch]}{\list}
