\title{Alignement 1}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}

\text{l=shuffle(A,B,C,D,E,F)}
\text{A=\l[1]}
\text{B=\l[2]}
\text{C=\l[3]}
\text{D=\l[4]}

\integer{alpha=randint(45..105)}
\integer{beta=180-\alpha}

\integer{z=randitem(1,-1)*randint(3..10)}
\integer{y=randint(130..180)}
\integer{x=\y+220*tan((90-\alpha)*pi/180)}
\integer{x=min(270,\x)}
\integer{x=max(30,\x)}
\text{image=draw(300,300
triangle 20,260,\x,40,\y,260+\z,black
triangle \x,40,\y,260+\z,280,260,black
text black,15,265,medium,\A
text black,\y-5,265+\z,medium,\B
text black,275,265,medium,\C
text black,\x-5,25,medium,\D)}

\statement{
<div class="float_left spacer"><img width="300" src="\image" alt="" /></div>
<div class="float_left spacer">\(\A\B\D) et \(\B\D\C) sont des triangles. L'angle du sommet
\B du triangle \(\A\B\D) mesure \alpha degrés.<br/>
Quelle doit être la mesure de l'angle du sommet \B du triangle \(\B\C\D)
pour que les points \A, \B et \C soient alignés ?
<p>
<b>Votre réponse :</b>
\embed{r1,5} degrés.
</p>
</div>

}

\answer{}{\beta}{type=numexp}
