\text{list=triangle isocèle,triangle rectangle,triangle rectangle isocèle,triangle équilatéral}

\matrix{don=exactement deux côtés de même longueur
un angle droit
un angle droit et deux côtés de même longueur
trois côtés de même longueur}

\integer{ch=randint(1..4)}

\statement{
Je suis un triangle possédant \don[\ch;].
Quel est mon nom ?}

\choice{}{\list[\ch]}{\list}
