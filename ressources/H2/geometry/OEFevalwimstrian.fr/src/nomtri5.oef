\title{Nom de triangle 5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}

\text{list=triangles isocèles,triangles rectangles,triangles rectangles isocèles,triangles équilatéraux}

\matrix{ltrep=1,3,4,5,6,7
2,3,6
3,6
4,7}

\real{a=random(pi/3..2*pi/3)}
\real{b=pi/2+randitem(1,-1)*random(pi/6..3*pi/12)}
\matrix{don=0,\a,2*pi-\a,white,white,white,white,red,red
0,pi,pi+\b,white,white,white,white,white,red
0,pi,3*pi/2,white,white,white,red,red,red
0,2*pi/3,4*pi/3,white,white,white,red,red,red
0,\a,2*pi-\a,white,red,red,white,white,white
0,pi,3*pi/2,red,red,white,white,white,red
0,2*pi/3,4*pi/3,red,red,red,white,white,white}

\integer{ch=randint(1..4)}
\integer{t=randitem(\ltrep[\ch;])}
\text{rd=wims(values v for v=1 to 7)}
\text{rd=wims(listcomplement \t in \rd)}
\text{rd=\t,shuffle(\rd)}
\text{image=}
\text{rep=}
\for{m=1 to 4}{
 \text{fig=slib(triangle \don[\rd[\m];])}
 \text{fig=draw(150,150
\fig)}
 \text{image=wims(append item \fig to \image)}
 \text{rep=\rd[\m] isitemof \ltrep[\ch;]?wims(append item \m to \rep)}
}


\statement{
Parmi les triangles suivants, lequel ou lesquels sont des \list[\ch] ?
<table class="wimscenter wimsborder">
 <tr>\for{k=1 to 4}{<td>Triangle \k</td>}</tr>
 <tr>\for{l=1 to 4}{<td><img src="\image[\l]" alt="" /></td>}</tr>
</table>}

\answer{}{\rep;Triangle 1,Triangle 2,Triangle 3,Triangle 4}{type=checkbox}
