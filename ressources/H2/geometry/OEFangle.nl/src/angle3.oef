\title{Bereken de hoeken 3}
\language{nl}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}
\integer{anga = randint(10..40)}
\integer{angb = randint(50..120)}
\integer{angc = randint(10..50)}
\integer{angle1=180-\angb}
\integer{angle2=\angb-\anga}
\integer{angle3=180-\angb-\angc}
\integer{angle4=180-\anga-\angc}

\statement{<p><center>

\draw{200,200}{
xrange -20,20
yrange -20,20
triangle 0,11,4,-11,-15,-11,black
triangle 0,11,19,-11,4,-11,black
text black,-17,-10,medium,B
text black,6,-12,medium,C
text black,18,-13,medium,D
text black,0,14,medium,A
}
</center> <p>
Gegeven is:&nbsp;<b><font size="+2">&ang;</font> ABC</b>= \anga ,  <b><font size="+2">&ang;</font> ACD</b>= \angb en
 <b><font size="+2">&ang;</font> ADC</b>= \angc. &nbsp; Bereken onderstaande hoeken. }

\answer{ <font size="+2">&ang;</font> BCA &nbsp;=&nbsp;}{\angle1}{type=chset}
\answer{ <font size="+2">&ang;</font> BAC &nbsp;=&nbsp;}{\angle2}{type=chset}
\answer{ <font size="+2">&ang;</font> CAD &nbsp;=&nbsp;}{\angle3}{type=chset}
\answer{ <font size="+2">&ang;</font> BAD &nbsp;=&nbsp;}{\angle4}{type=chset}