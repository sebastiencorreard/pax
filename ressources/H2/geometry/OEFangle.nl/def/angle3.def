!set title=Bereken de hoeken 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=1000

ansorder=r,r,r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 40

val6=$[rint($(tmp0))]
tmp0=!randint 50, 120

val7=$[rint($(tmp0))]
tmp0=!randint 10, 50

val8=$[rint($(tmp0))]
val9=$[rint(180-$val7)]
val10=$[rint($val7-$val6)]
val11=$[rint(180-$val7-$val8)]
val12=$[rint(180-$val6-$val8)]
replytype1=chset
replyname1=<font size="+2">&ang;</font> BCA &nbsp;
replygood1=$val9
replytype2=chset
replyname2=<font size="+2">&ang;</font> BAC &nbsp;
replygood2=$val10
replytype3=chset
replyname3=<font size="+2">&ang;</font> CAD &nbsp;
replygood3=$val11
replytype4=chset
replyname4=<font size="+2">&ang;</font> BAD &nbsp;
replygood4=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p><center>		 
!read oef/draw.phtml 200,200 \
	xrange -20,20	yrange -20,20	triangle 0,11,4,-11,-15,-11,black	triangle 0,11,19,-11,4,-11,black	text black,-17,-10,medium,B	text black,6,-12,medium,C	text black,18,-13,medium,D	text black,0,14,medium,A	 
$()	</center> <p>	Gegeven is:&nbsp;<b><font size="+2">&ang;</font> ABC</b>= $val6 ,  <b><font size="+2">&ang;</font> ACD</b>= $val7 en	 <b><font size="+2">&ang;</font> ADC</b>= $val8. &nbsp; Bereken onderstaande hoeken. 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=0
