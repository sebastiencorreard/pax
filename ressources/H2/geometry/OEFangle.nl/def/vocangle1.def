!set title=Naamgeving van hoeken
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=10000

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=complementair
val7=supplementair
val8=tegenovergestelde van de som
val9=buitenhoek-binnenhoek
val10=overeenkomstige hoeken
val11=niets van dit al
tmp=!trim AEB,EBA,$val6,1	AEB,EBC,$val9,4	ABE,EBC,$val6,1	AEC,CED,$val7,2	BFC,CFE,$val7,2	FEC,ECD,$val9,4	BCF,EDC,$val11,6	EFC,FCB,$val11,6	AEB,EDC,$val10,5	EDC,EBC,$val7,2
val12=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 10

val13=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val12

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val14=$(tmp0)
tmp0=!item 1 of $val14

val15=$(tmp0)
tmp0=!item 2 of $val14

val16=$(tmp0)
tmp0=!item 4 of $val14

val17=$(tmp0)
replytype1=menu
replyname1=
replygood1=$val17;$val6,$val7,$val8,$val9,$val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<p><center>	 
!read oef/draw.phtml 200,200 \
	xrange -20,20	yrange -20,20	triangle -15,-11,-15,11,0,11,black	triangle 0,11,4,-11,-9,-2.2,black	triangle -15,-11,-9,-2.2,4,-11,black	triangle 0,11,19,11,4,-11,black	line -4,-7,-2,-5,red	line -5,6,-3,4,red	text black,-17,13,medium,A	text black,-17,-10,medium,B	text black,6,-10,medium,C	text black,18,14,medium,D	text black,0,14,medium,E	text black,-11,0,medium,F	 
$()	</p><center>	De driehoek <b>ABE</b> heeft een rechte hoek in <b>A</b> en de vierhoek <b>BCDE </b>is een parallellogram.<br>	De hoeken &nbsp &nbsp <b><font size="+2">&ang;</font> $val15</b> &nbsp;&nbsp; en  &nbsp;&nbsp; <b><font size="+2">&ang;</font> $val16</b> &nbsp; &nbsp; zijn ....	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15,16
embedcnt=0
