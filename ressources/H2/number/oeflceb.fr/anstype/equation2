size_row=$(oef_fill_option[1;2])

!!##on compare la suite d'equations.
m_reply$i=$(reply$i)
repl=!lines2rows $(reply$i)
repl_rows=!linecnt $(reply$i)
reply_$i=<table>
!for u= 1 to $repl_rows
  reply_$i=$(reply_$i)\
  <tr>
  !for j=1 to $size_row
   reply_$i=$(reply_$i)\
  <td>$(oef_fill_option[2;]) readonly=readonly value="$(repl[$u;$j])"></td>
  !next
  </tr>
!next
  reply_$i=$(reply_$i)\
</table>

!if $wims_read_parm=nocompare
 !exit
!endif
