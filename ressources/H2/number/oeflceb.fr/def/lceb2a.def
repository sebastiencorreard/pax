replyoption1=limit=6 
replyname1=
replygood1=?analyze 27
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} Avec les nombres $val15 et les quatre opérations, essayez d'obtenir le nombre $val7. \end{statement} \begin{solution} \($val26\) \end{solution} 


!goto stat

!exit

:question
$()<p>	$val10 <span class="tt">$(val17[1]) + $(val17[2]) = $val21</span>.	$val11	</p>	<table class="wimscenter lceb">	<tr> 
!for m_u=1 to $val6 
$()<th>$(val15[$m_u])</th> 
!next
$()</tr>	<tr><td class="goal" colspan="$val6">$val7</td></tr>	<tr><td class="answer" colspan="$val6">	 
!read oef/embed.phtml r1,150x1	default 
$()	</td></tr>	</table>	
$()
!exit

