!readproc slib/oef/env lang 
tmp0=$slib_out
val9=$(tmp0)
val10=Avec les nombres de la première ligne du tableau et les 4 opérations,	vous devez obtenir le nombre $val7 ; écrivez votre première opération et son résultat,	par exemple
val11=envoyez le résultat, puis continuez.
tmp=!trim Vous avez utilisé les nombres donnés	Les opérations sont justes	Vous avez trouvé le résultat ou le résultat le plus proche	Votre nombre est compris entre \M1 et \M2
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Choisissez un nombre entre \M1 et \M2.	Vous n'avez pas joué le jeu ... 
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Votre réponse	 Une réponse possible
val14=!translate internal $	\
$ to ;; in $tmp
!if $val9=en 
val10=Using numbers from the first row and the four arithmetic operations,	you must arrive to $val7 ; write your first operation and its result,	for example
val11=send the result, then continue.
tmp=!trim You used the given numbers	Te calculations are correct	You found the target number or the nearest result	Your number lies between \M1 and \M2
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Choose a number between \M1 and \M2.	You didn't play the game ... 
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Your answer	 One possible answer
val14=!translate internal $	\
$ to ;; in $tmp
!endif
!if $val9=it 
val10=Con i numeri della prima riga e le 4 operazioni	dovete ottenere il numero $val7 ; scrivi la tua prima operazione e il corrispondente risultato,	per esempio
val11=invia la risposta, quindi continua.
tmp=!trim Hai utilizzato i numeri dati	Le operazioni sono corertte	Hai trovato il risultato o il risultato più vicino	Il numero inserito è compreso tra \M1 e \M2
val12=!translate internal $	\
$ to ;; in $tmp
tmp=!trim Scegli un numero tra \M1 e \M2.	Non avete giocato ... 
val13=!translate internal $	\
$ to ;; in $tmp
tmp=!trim La tua risposta	 Una risposta possibile
val14=!translate internal $	\
$ to ;; in $tmp
!endif
val15=$(val8[1..6])
tmp0=!items2words $val15

val16=$(tmp0)
tmp0=!nospace $val15

val15=$(tmp0)
tmp0=!replace internal ,0 by in $val15

val15=$(tmp0)
tmp0=!nonempty items $val15

val15=$(tmp0)
val17=$val15
tmp0=!exec lceb $val7 $val16

val18=$(tmp0)
val19=$val18
tmp0=!line 3 to -1 of $val18

val18=$(tmp0)

!ifval NOTFOUND isin $val19
tmp0=!line 2 of $val19

tmp1=!word 2 of $(tmp0)

val20= $(tmp1) 
!else
val20= $val7
!endif
val21=$[rint($(val17[1]) + $(val17[2]))]
val22=
val23=
val24=$val6
val25=
tmp=!trim $val18
val26=!translate internal $	\
$ to ;; in $tmp
tmp0=!texmath $val26

val26=$(tmp0)
!readproc slib/text/matrixtex [$val26],lbrace,. 
tmp0=$slib_out
val26=$(tmp0)
