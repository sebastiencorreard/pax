!insmath $val26
$() $m_end{solution} 
$()
!exit

:postdef
val28=$val15
tmp=!translate internal $	$ to ; in $m_reply1

tmp0=!rowcnt $tmp
val29=$[rint($(tmp0))]
tmp=!trim $m_reply1
val30=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal <pre> by in $val30

val30=$(tmp0)
tmp0=!replace internal </pre> by in $val30

val30=$(tmp0)
!for val31 =1 to $val29 
val32=$(val30[$val31;])
tmp0=!replace internal = by == in $val32

val33=$(tmp0)
t_=!replace internal \( by ( in $val33
tmp0=!exec pari $t_

val33=$(tmp0)
tmp0=!append item $val33 to $val23

val23=$(tmp0)
tmp0=!translate internal +=-*/ to ,,,,, in $val32

val34=$(tmp0)
tmp0=!nonempty items $val34

val34=$(tmp0)
tmp0=!positionof item $(val34[1]) in $val28

val35=$(tmp0)
tmp0=!positionof item $(val34[2]) in $val28

val36=$(tmp0)
val35=$[rint($(val35[1]))]

!ifval $(val34[1]) notsametext $(val34[2])
val36=$[rint( $(val36[1]))]
!else
val36=$[rint($(val36[2]))]
!endif

!ifval $val35 notwordof 1 2 3 4 5 6 or $val36 notwordof 1 2 3 4 5 6 
tmp0=!append item 0 to $val22

val22= $(tmp0)
!else
tmp1=!append item 1 to $val22

val22=$(tmp1)
!endif
!if 0 notin $val22 
tmp0=!replace internal item number $val35 by in $val28

val28=$(tmp0)
tmp0=!replace internal item number $val36 by in $val28

val28=$(tmp0)
tmp0=!append item $(val34[3]) to $val28

val28=$(tmp0)
tmp0=!nonempty items $val28

val28=$(tmp0)
!endif

!ifval $val33=1
val25=$val25	$val32
!else
val25=$val25	<span style="color:red">$val32</span>
!endif
!next

!ifval $val7 isitemof $val28 
val37= 1
!else
val37=0
!endif

!ifval $val37=0 and abs($val20 - $val7) >= abs($val7 - $(val34[3])) 
val37= 1
!endif

!exit

