tmp=!trim Lisbonne,-17.7,-13	Madrid,-13.9,-12.6	Rome,-3.9,-12.9	Athènes,3.2,-16.5	Tirana,0.6,-13.6	Sofia,2.6,-12.2	Belgrade,0.8,-10.7	Bucarest,4,-10.4	Budapest,-0.2,-8.4	Bratislava,-1,-7.7	Vienne,-1.7,-7.7	Prague,-2.7,-5.9	Berlin,-3,-4	Bruxelles,-7.7,-5	Amesterdan,-7.3,-4.1	Londres,-9.8,-3.9	Dublin,-12.5,-1.5	Copenhague,-3.5,-1.5	Oslo,-4,2.4	Stokholm,-1.4,1.8	Helsinki,1.9,2.9	Tallinn,2,2	Riga,2,0	Vilnius,2.2,-2	Minsk,3.5,-2.5	Moscou,8,0.2	Varsovie,0.65,-4.1	Kiev,5.3,-5.1
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 28

val7=$[rint($(tmp0))]
tmp0=!randint 1 , 28

val8=$[rint($(tmp0))]
!while $val7 = $val8 
tmp0=!randint 1 , 28

val8=$[rint($(tmp0))]
!endwhile
tmp=!trim 
val9=!translate internal $	\
$ to ;; in $tmp
val10=$[rint(sqrt(($(val6[$val7;2])-$(val6[$val8;2]))^2+($(val6[$val7;3])-$(val6[$val8;3]))^2)*100)]
val11=$[$val10/100]
val12=$[$val11*150]
val13=$[($val11-0.4)*150]
val14=$[($val11+0.4)*150]
val15=$[$val12/250]
val16=$[$val13/250]
val17=$[$val14/250]
val18=$[$val12/750]
val19=$[$val13/750]
val20=$[$val14/750]

!ifval $val15<($val18+2) 
val21=$[rint(1)]
!else
val21=$[rint(2)]
!endif
val22=var brd = JXG.JSXGraph.initBoard('jxgbox', {	axis:true,boundingbox: [-20, 20, 20, -20], grid:true, shownavigation:true,showFullscreen: true});	var urlImg = "$val1/Capital.png";	var carte = brd.create('image',[urlImg,[-24,-22], [48,38] ],{fixed:true});	var dfp = brd.create('text',[-16,16,"Placer les capitales suivantes :" ],{fontSize:30});	jxgbox_rep1 = brd.create('point',jxgbox_var1 , {face:'+', name:'$(val6[$val7;1])', size:6, showInfobox: false});	jxgbox_rep2 = brd.create('point',jxgbox_var2, {face:'+', name:'$(val6[$val8;1])', size:6, showInfobox: false});
!readproc slib/geo2D/jsxgraph box,800 x 800, var brd = JXG.JSXGraph.initBoard('box', {	  axis:true,boundingbox: [-20, 20, 20, -20], grid:true, shownavigation:true,showFullscreen: true});	        var urlImg = "$val1/Capital.png";	        var carte = brd.create('image',[urlImg,[-24,-22], [48,38] ],{fixed:true});	        var sos = brd.create('point',[3.5,15] , {face:'+', size:8,fixed:false, showInfobox: false,Color:'black'});	        var soss = brd.create('point',[15,15] , {face:'+', size:8,fixed:false, showInfobox: false,Color:'black'});	        brd.create('text',[-16,17,function(){	return 'Utiliser le segment [AB] pour effectuer des mesures: AB =' + sos.Dist(soss).toFixed(2) +' unités';}],{fontSize:20});	        brd.create('point',[$(val6[$val7;2]),$(val6[$val7;3])] , {face:'o',fixed:true, size:1, showInfobox: false,name:'$(val6[$val7;1])',Color:'green'});	        brd.create('point',[$(val6[$val8;2]),$(val6[$val8;3])] , {face:'o',fixed:true, size:1, showInfobox: false,name:'$(val6[$val8;1])',Color:'green'});	        var sss= brd.create('line',[sos,soss],{straightFirst:false, straightLast:false});	               
tmp0=$slib_out
val23=$(tmp0)
replytype1=jsxgraph

replyoption1=precision=5 noanalyzeprint 
replyname1=
replygood1=$(val6[$val7;2]),$(val6[$val7;3]);$(val6[$val8;2]),$(val6[$val8;3])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="encadre">	<div class="problematique">	Quel est le moyen de transport le plus rapide pour aller de $(val6[$val7;1]) à $(val6[$val8;1]) ?	</div>	<div class="enonce">	Le TGV roule à la vitesse moyenne de 250 km/h.	<br> L'avion vole à la vitesse de 750 km/h mais il faut arriver 2H à l'avance pour	 compléter les modalités d'enregistrement.	</div>	<div class="question">	Sur le graphique, placer les 2 capitales suivantes :	<ul><li>$(val6[$val7;1]) de coordonnées ( $(val6[$val7;2]) , $(val6[$val7;3]) )</li><li>$(val6[$val8;1]) dont la valeur en abscisse	est de $(val6[$val8;2]) et en ordonnée de $(val6[$val8;3]) </li></ul>	</div>	 
!read oef/embed.phtml r1,800x800	jxgbox	$val22	jxgbox_var1=[5,16.5] ; jxgbox_var2=[10,16.5] 
$()	</div>
$()
