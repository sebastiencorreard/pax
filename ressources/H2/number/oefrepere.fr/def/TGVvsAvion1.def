:postdef
tmp=!trim $m_reply1
val9=!translate internal $	\
$ to ;; in $tmp
!readproc slib/geo2D/jsxgraph box,800 x 800, var brd = JXG.JSXGraph.initBoard('box', {	  axis:true,boundingbox: [-20, 20, 20, -20], grid:true, shownavigation:true});	        var urlImg = "$val1/Capital.png";	        var carte = brd.create('image',[urlImg,[-24,-22], [48,38] ],{fixed:true});	        brd.create('text',[-16,16,"Les points que vous avez placé sont représenté par une croix rouge:" ],{fontSize:20});	        brd.create('point',[14.5,16.2] , {face:'+',fixed:true, size:6, showInfobox: false,name:''});	  brd.create('text',[-16,14,"Les bonnes réponses sont les ronds verts :" ],{fontSize:20});	        brd.create('point',[3.5,14.2] , {face:'o',fixed:true, size:6, showInfobox: false,name:'',strokeColor:'green',fillColor:'none'});	        brd.create('point',[$(val6[$val7;2]),$(val6[$val7;3])] , {face:'o',fixed:true, size:6, showInfobox: false,name:'$(val6[$val7;1])', strokeColor:'green',fillColor:'none'});	        brd.create('point',[$(val6[$val8;2]),$(val6[$val8;3])] , {face:'o',fixed:true, size:6, showInfobox: false,name:'$(val6[$val8;1])', strokeColor:'green',fillColor:'none'});	        brd.create('point',[$(val9[1;1]),$(val9[1;2])] , {face:'+',fixed:true, size:6, showInfobox: false,name:'$(val6[$val7;1])'});	        brd.create('point',[$(val9[2;1]),$(val9[2;2])] , {face:'+',fixed:true, size:6, showInfobox: false,name:'$(val6[$val8;1])'});	        
tmp0=$slib_out
val24=$(tmp0)	

!exit

:feedback
!ifval abs($(val9[1;1]) -$(val6[$val7;2]))>0.2 or abs($(val9[1;2]) -$(val6[$val7;3]))>0.2 or abs($(val9[2;1]) -$(val6[$val8;2]))>0.2 or abs($(val9[2;2]) -$(val6[$val8;3]))>0.2
