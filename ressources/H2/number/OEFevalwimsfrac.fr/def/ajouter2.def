!set title=Ajouter/soustraire deux fractions 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F

tmp0=!randitem $tmp
val7=$(tmp0)
val8=$(val6[1])/$(val6[2])
val9=$(val6[1])/$(val6[3])
val10=-
tmp0=!texmath $val8

tmp1=!texmath $val9

val11=$(tmp0) $val10 $(tmp1)
tmp=!translate ";': to $     $ in $val8 $val10 $val9

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val12=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=$val7
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter"> 
!insmath $val7 = $val11
$() </div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11
embedcnt=0
