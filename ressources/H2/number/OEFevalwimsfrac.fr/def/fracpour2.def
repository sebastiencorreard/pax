!set title=Ecriture fractionnaire et pourcentage 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=4
prevarcnt=3
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 10,25,50,20

tmp0=!randitem $tmp
val6=$[rint($(tmp0))]
tmp0=!randint $val6+1, 2*$val6-1

val7=$[rint($(tmp0))]
val8=$[$val7/$val6*100]
replytype1=numexp
replyname1=
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est l'écriture sous forme de pourcentage de la fraction 
!insmath \frac{$val7}{$val6}
$() ?	<div>	<b>Votre réponse</b>  
!read oef/embed.phtml r1,4 
$() %</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
