!set title=Réduction de fraction 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(\frac{1}{2}),\(\frac{1}{3}),\(\frac{2}{3}),\(\frac{3}{4}),\(\frac{1}{4})
val7=1,2	1,3	2,3	3,4	1,4
tmp0=!shuffle 1,2,3,4,5

val8=$(tmp0)
val9=
val10=
!for val11 =1 to 4 
tmp=!translate internal $	$ to ; in $val7

tmp=!row $(val8[$val11]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item $(val8[$val11]) of $val6

val13=$(tmp0)
tmp0=!append item $val13 to $val10

val10=$(tmp0)
tmp0=!randint 2, 8

val14=$[rint($(tmp0))]
val15=$[rint($val14*$(val12[1]))]
val16=$[rint($val14*$(val12[2]))]
tmp0=!append item \(\frac{$val15}{$val16}) to $val9

val9=$(tmp0)
!next
replytype1=correspond
replyname1=
replygood1=$val9;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Mettre en correspondance les fractions égales.	<div class="wimscenter"> 
!read oef/embed.phtml r1,60x100x100 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=
embedcnt=1
