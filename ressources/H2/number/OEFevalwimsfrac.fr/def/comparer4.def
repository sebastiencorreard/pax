!set title=Comparer avec une fraction à l'unité 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
!if $val6=1 
tmp0=!randint 35, 99

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val7=$[$(tmp0)+$(tmp1)*0.1+$(tmp2)*0.01]
tmp0=!randint 1, 2

tmp1=!randint 1, 9

val8=$[$(tmp0)+$(tmp1)*.1]
!else
tmp0=!randint 35, 99

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val8=$[$(tmp0)+$(tmp1)*0.1+$(tmp2)*0.01]
tmp0=!randint 1, 2

tmp1=!randint 1, 9

val7=$[$(tmp0)+$(tmp1)*.1]
!endif
val9=$val8/$val7
tmp0=!randint 1, 2

val6=$[rint($(tmp0))]
tmp0=!item $val6 of plus grand,plus petit

val10=$(tmp0)

!ifval ($val6=1 and $val9>1) or ($val6=2 and $val9<1)
val11=Vrai
!else
val11=Faux
!endif
tmp0=!texmath $val9

val9=$(tmp0)
choicename1=
choicegood1=$val11
choicebad1=Vrai,Faux
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Répondre par Vrai ou Faux :	<div class="wimscenter">	
!insmath $val9
$() est $val10 que 1.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10
embedcnt=0
