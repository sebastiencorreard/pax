!set title=Comparer deux fractions 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint($(val6[1])+1)]
val8=$[rint($(val6[2])+1)]
val9=$(val6[1])/$val7
val10=$(val6[2])/$val8

!ifval $val9<$val10
val11=$val9,$val10
!else
val11=$val10,$val9
!endif
tmp0=!texmath $(val11[1])

tmp1=!texmath $(val11[2])

val11=\($(tmp0)),\($(tmp1))
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of la plus grande,la plus petite

val13=$(tmp0)

!ifval $val12=1
val14=$(val11[2])
!else
val14=$(val11[1])
!endif
choicename1=
choicegood1=$val14
choicebad1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est $val13 des deux fractions ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13
embedcnt=0
