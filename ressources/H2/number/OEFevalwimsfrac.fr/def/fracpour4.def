!set title=Ecriture fractionnaire et pourcentage 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=\(\frac{3}{4}),75 %	\(\frac{2}{5}),40 %	\(\frac{1}{5}),20 %	\(\frac{1}{4}),25 %	\(\frac{1}{2}),50 %	\(\frac{4}{5}),80 %
tmp0=!shuffle 1,2,3,4,5,6

val7=$(tmp0)
val8=
val9=
!for val10 =1 to 4 
tmp=!translate internal $	$ to ; in $val6

tmp=!row $(val7[$val10]) of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
tmp0=!append item $(val11[1]) to $val8

val8=$(tmp0)
tmp0=!append item $(val11[2]) to $val9

val9=$(tmp0)
!next
replytype1=correspond
replyname1=
replygood1=$val8;$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Mettre en correspondance chaque fraction avec le pourcentage qu'elle représente.	<div class="wimscenter"> 
!read oef/embed.phtml r1,60x100x100 
$()</div>
$()
!exit

