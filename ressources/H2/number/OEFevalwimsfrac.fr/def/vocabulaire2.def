!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=$(val6[2]) est 
val8=de la fraction \(\frac{$(val6[1])}{$(val6[2])})
val9=le dénominateur
val10=le numérateur,la fraction,le quotient
replytype1=dragfill
replyname1=
replygood1=$val9;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Complétez la phrase suivante en utilisant l'une des étiquettes ci-dessous :	<div class="wimscenter">$val7  
!read oef/embed.phtml r1,130x30x1 
$() $val8</div>
$()
!exit

