!set title=Réduction de fraction 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 1,2	7,5	2,5	3,4	7,4

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!randitem 4,9,6

val7=$[rint($(tmp0))]
val8=$[rint($(val6[1])*$val7)]
val9=$[rint($(val6[2])*$val7)]
replytype1=numexp
replyname1=\(\frac{$val8}{$val9})
replygood1=$(val6[1])/$(val6[2])
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est l'écriture simplifiée de la fraction 
!insmath \frac{$val8}{$val9}
$() ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
!insmath \frac{$val8}{$val9} = \frac{$(val6[1])\times $val7}{$(val6[2]) \times $val7} = \frac{$(val6[1])}{$(val6[2])}
$().
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=0
