!set title=Comparer deux fractions 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=$[rint(min($(val6[1]),$(val6[2])))]
val8=$[rint(max($(val6[1]),$(val6[2])))]
val9=$[rint(min($(val6[3]),$(val6[4])))]
val10=$[rint(max($(val6[3]),$(val6[4])))]
val11=$val7/$val8
val12=$val10/$val9

!ifval $val11<$val12
val13=$val11,$val12
!else
val13=$val12,$val11
!endif
tmp0=!texmath $(val13[1])

tmp1=!texmath $(val13[2])

val13=\($(tmp0)),\($(tmp1))
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of la plus grande,la plus petite

val15=$(tmp0)

!ifval $val14=1
val16=$(val13[2])
!else
val16=$(val13[1])
!endif
choicename1=
choicegood1=$val16
choicebad1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est $val15 des deux fractions ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=15
embedcnt=0
