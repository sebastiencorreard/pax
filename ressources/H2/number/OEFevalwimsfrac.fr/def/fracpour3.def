!set title=Ecriture fractionnaire et pourcentage 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=3
prevarcnt=2
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 3/4,Les trois quarts	2/5,Les deux cinquièmes	1/5,Le cinquième	1/4,Le quart	1/2,La moitié	4/5,Les quatre cinquièmes

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
val7=$[$(val6[1])*100]
replytype1=numexp
replyname1=
replygood1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val6[2]) des enfants ont un ordinateur chez eux.<p>	Quel pourcentage des enfants a un ordinateur ?</p>	<b>Votre réponse</b>  
!read oef/embed.phtml r1,4 
$() %
$()
!exit

