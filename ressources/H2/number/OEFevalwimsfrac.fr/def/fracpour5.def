!set title=Ecriture fractionnaire et pourcentage 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 45

val6=$[rint($(tmp0))]
tmp0=!randint 3, 22

val7=$[rint($(tmp0))]
tmp0=!randint 2, 8

val8=$[rint($(tmp0))]
tmp0=!randint 3, 17

val9=$[rint($(tmp0))]
val10=\(\frac{$val6}{50}),\(\frac{$val7}{25}),\(\frac{$val8}{10}),\(\frac{$val9}{20})
tmp=!translate ";': to $     $ in 2*$val6

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 4*$val7

tmp=!lower $tmp
tmp1=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 10*$val8

tmp=!lower $tmp
tmp2=!exec maxima fullratsimp($tmp);
tmp=!translate ";': to $     $ in 5*$val9

tmp=!lower $tmp
tmp3=!exec maxima fullratsimp($tmp);
val11=$(tmp0) %,$(tmp1) %,$(tmp2) %,$(tmp3) %
replytype1=correspond
replyname1=
replygood1=$val10;$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Mettre en correspondance chaque fraction avec le pourcentage qu'elle représente.	<div class="wimscenter"> 
!read oef/embed.phtml r1,60x100x100 
$()</div>
$()
!exit

