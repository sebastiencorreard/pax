!set title=Réduction de fraction 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 5

val6=$(tmp0)
val7=\(\frac{1}{2}),\(\frac{1}{3}),\(\frac{2}{3}),\(\frac{3}{4}),\(\frac{1}{4})
val8=1,2	1,3	2,3	3,4	1,4
tmp0=!item $val6 of $val7

val9=$(tmp0)
tmp=!translate internal $	$ to ; in $val8

tmp=!row $val6 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val10=$(tmp0)
tmp0=!randint 3, 9

val11=$[rint($(tmp0))]
val12=$[rint($val11*$(val10[1]))]
val13=$[rint($val11*$(val10[2]))]
choicename1=Réponse
choicegood1=$val9
choicebad1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Parmi les nombres ci-dessous lequel est égal à 
!insmath \frac{$val12}{$val13}
$() ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=0
