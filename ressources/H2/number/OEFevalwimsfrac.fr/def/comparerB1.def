!set title=Comparer deux fractions 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=$(val6[1])/$(val6[2])
val8=$(val6[3])/$(val6[2])

!ifval $val7<$val8
val9=$val7,$val8
!else
val9=$val8,$val7
!endif
tmp0=!texmath $(val9[1])

tmp1=!texmath $(val9[2])

val9=\($(tmp0)),\($(tmp1))
tmp0=!randint 1, 2

val10=$[rint($(tmp0))]
tmp0=!item $val10 of la plus grande,la plus petite

val11=$(tmp0)

!ifval $val10=1
val12=$(val9[2])
!else
val12=$(val9[1])
!endif
choicename1=
choicegood1=$val12
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Quelle est $val11 des deux fractions ?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11
embedcnt=0
