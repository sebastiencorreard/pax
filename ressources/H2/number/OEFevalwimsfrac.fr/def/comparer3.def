!set title=Comparer avec une fraction à l'unité 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 15

val6=$(tmp0)
val7=1/$val6
tmp0=!randint 1, 2

val8=$[rint($(tmp0))]
tmp0=!item $val8 of plus grand,plus petit

val9=$(tmp0)

!ifval ($val8=1 and $val7>1) or ($val8=2 and $val7<1)
val10=Vrai
!else
val10=Faux
!endif
tmp0=!texmath $val7

val7=$(tmp0)
choicename1=
choicegood1=$val10
choicebad1=Vrai,Faux
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Répondre par Vrai ou Faux :	<div class="wimscenter">	
!insmath $val7
$() est $val9 que 1.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
