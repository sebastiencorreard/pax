!set title=Comparer avec une fraction à l'unité 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

val6=$(tmp0)
tmp0=!randint 10, 20

val7=$(tmp0)
val8=-$val7/$val6
tmp0=!randint 1, 2

val9=$[rint($(tmp0))]
tmp0=!item $val9 of plus grand,plus petit

val10=$(tmp0)

!ifval ($val9=1 and $val8>1) or ($val9=2 and $val8<1)
val11=Vrai
!else
val11=Faux
!endif
tmp0=!texmath $val8

val8=$(tmp0)
choicename1=
choicegood1=$val11
choicebad1=Vrai,Faux
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Répondre par Vrai ou Faux :	<div class="wimscenter">	
!insmath $val8
$() est $val10 que 1.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=0
