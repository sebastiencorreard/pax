!set title=Calcul A4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=calculation

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 5

val6=$[rint($(tmp0)*10)]
tmp0=!randint 2, 3

tmp1=!randint 2, 9

tmp2=!randint 1, 9

tmp3=!randint 1, 9

val7=$[$(tmp0)*10+$(tmp1)+0.01*$(tmp2)+$(tmp3)*0.1]
val8=$[$val6-$val7]
tmp0=!randint 5, 19

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val9=$[$(tmp0)+0.01*$(tmp1)+$(tmp2)*0.1]
val10=$val7+$val9+$val8
val11=A
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val12=$(tmp0)

!ifval A isin $val11
tmp0=!texmath $val10

val11=$(tmp0)
!endif
val13=$[$val10]
replytype1=numexp
replyoption1=noreduction 
replyname1=$val12
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter">
!insmath $val12 = $val11
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12
embedcnt=0
