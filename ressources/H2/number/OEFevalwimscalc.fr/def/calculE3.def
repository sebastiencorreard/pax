!set title=Calcul E3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=calculation

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7

val6=$(tmp0)
tmp0=!randint 5, 25

val7=$[rint(($(val6[2])+$(val6[2]))*$(tmp0))]
tmp0=!randint 11, 55

tmp1=!randint 1, 9

val8=$[$(tmp0)+0.1*$(tmp1)]
val9=$val7/($(val6[1])+$(val6[2]))+$val8
val10=A
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val11=$(tmp0)

!ifval A isin $val10
tmp0=!texmath $val9

val10=$(tmp0)
!endif
val12=$[$val9]
replytype1=numexp
replyoption1=noreduction 
replyname1=$val11
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter">
!insmath $val11 = $val10
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=0
