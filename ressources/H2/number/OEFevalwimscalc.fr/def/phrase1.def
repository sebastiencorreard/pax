!set title=Ecrire un calcul 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=oper_prec
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!shuffle 2,3,4,5,6,7,8,9

val6=$(tmp0)
val7=La somme de $(val6[1]) et du produit de $(val6[2]) et $(val6[3]).
val8=$(val6[1])+$(val6[2])*$(val6[3])
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val9=$(tmp0)
replytype1=litexp
replyname1=$val9
replygood1=$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Ecrire l'expression numérique $val9 correspondant à la phrase suivante :	<div class="wimscenter">$val7</div>	<div class="wims_instruction">Vous ne devez pas effectuer le calcul.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9
embedcnt=0
