!set title=Calcul B2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
keywords=calculation

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!translate internal $	$ to ; in 2,5	4,25

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val6=$(tmp0)
tmp0=!shuffle $val6

val6=$(tmp0)
tmp0=!randint 2, 3

tmp1=!randint 2, 9

val7=$[rint($(tmp0)*10+$(tmp1))]
val8=$(val6[1])*$val7/$(val6[2])
val9=$(val6[1]) \times $val7 \div $(val6[2])
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val10=$(tmp0)

!ifval A isin $val9
tmp0=!texmath $val8

val9=$(tmp0)
!endif
val11=$[$val8]
replytype1=numexp
replyoption1=noreduction 
replyname1=$val10
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Calculer l'expression suivante :	<div class="wimscenter">
!insmath $val10 = $val9
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9,10
embedcnt=0
