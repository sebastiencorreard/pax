\title{Placer un point sur une demi-droite graduée 1}

\text{name_enonce=Cliquer pour placer le point d'abscisse, sur la droite graduée ci-dessous&nbsp;}

\integer{coeffzone=1}

 \integer{xmax=randint(6..8)}
 \integer{xmin=0}
 \real{grd=0.1}
 \integer{x=randint(\xmin+1..\xmax-1)}

\text{dessin=slib(draw/drtgraduee 1200,\xmin,\xmax,\grd,black,grey,40,0)}
\real{ex=1120/(\xmax-\xmin)}
\real{rep=40+\ex*(\x-\xmin)}
\text{figure=draw(1200,100
\dessin)}
