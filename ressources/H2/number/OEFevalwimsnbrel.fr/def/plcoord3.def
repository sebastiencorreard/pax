!set title=Placer un point dans un repère 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le plan est muni d'un repère orthonormal. Cliquer dans le repère pour	  placer le point de coordonnées
val7=Votre réponse
val8=Point
val9=$[rint(400)]
val10=$[rint(400)]
tmp0=!values v for v=1 to 5

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
val12=$[rint(0)]
tmp=!nonempty items 1,-1

tmp0=!randitem $tmp
val13=$[rint($(tmp0)*$(val11[2]))]
tmp=!nonempty items A,B,C,D,E

tmp0=!randitem $tmp
val14=$(tmp0)
!readproc slib/draw/repere $val9,$val10,20,-6,6,-6,6,1,1,black,grey 
tmp0=$slib_out
val15=$(tmp0)
tmp=!translate internal $	$ to ; in $val15

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp0=!item 1 of $val16

val17=$[rint($(tmp0))]
tmp0=!item 2 of $val16

val18=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val15

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val16=$(tmp0)
tmp0=!item 1 of $val16

val19=$[$(tmp0)]
tmp0=!item 2 of $val16

val20=$[$(tmp0)]
tmp0=!line 3 to -1 of $val15

val21=$(tmp0)
val21=$val21	text black,$val17-10,$val18+4,small,0	text black,$val17+$val19-4,$val18+4,small,1	text black,$val17-12,$val18+$val20-4,small,1
val22=$[rint($val17+($val19)*($val12))]
val23=$[rint($val18+($val20)*($val13))]
!readproc oef/draw.phtml $val9,$val10, \
$val21 
tmp0=$ins_url
val24=$(tmp0)
replytype1=coord
replyname1=$val8 \($val14)
replygood1=$val24;circle,$val22,$val23,$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6 
!insmath ($val12;$val13)
$().	<div>	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

