val6=Quelle est la distance entre le point d'abscisse,	  et le point d'abscisse , d'une droite graduée&nbsp;
val7=Distance
tmp0=!shuffle A,B,C,D,E,F,G

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 2, 5

tmp1=!randint 1, 9

val11=$[-$(tmp0)-0.1*$(tmp1)]
tmp0=!randint 1, 9

tmp1=!randint 7, 9

val12=$[-$(tmp0)*0.1-$(tmp1)]
val13=$[abs($val11-$val12)]
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
val15=$(val6[1]) $val11 $(val6[2]) $val12 $(val6[3])&#63;
replytype1=numexp
replyname1=$val7
replygood1=$val13
