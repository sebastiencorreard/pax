!set title=Calcul A2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Calculer l'expression suivante&nbsp;
tmp0=!values v/10 for v=10 to 100

val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
val8=$(val7[1])+(-$(val7[2]))
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[$val8]
replytype1=numexp
replyname1=$val9
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val6:	<div class="wimscenter">
!insmath $val9 = $val8
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,9
embedcnt=0
