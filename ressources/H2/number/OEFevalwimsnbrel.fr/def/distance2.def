!set title=Distance entre deux points 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Quelle est la distance entre les points, et,	  placés sur le graphique ci-dessous&nbsp;
val7=Distance
tmp0=!shuffle A,B,C,D,E,F,G

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 4, 5

val11=$[rint($(tmp0))]
val12=$[rint(-$val11)]
val13=$[0.1]
tmp0=!randint 0, $val11-1

tmp1=!randint 1, 9

val14=$[$(tmp0)+0.1*$(tmp1)]
tmp0=!randint $val12, -1

tmp1=!randint 1, 9

val15=$[$(tmp0)+0.1*$(tmp1)]
val16=$[abs($val14-$val15)]
!readproc slib/draw/drtgraduee 1200,$val12,$val11,$val13,black,grey,40 
tmp0=$slib_out
val17=$(tmp0)
!readproc oef/draw.phtml 1200,100 \
$val17	text blue,$val14,2,medium,$val9	fcircle $val14,0,8,blue	text blue,$val15,2,medium,$val10	fcircle $val15,0,8,blue 
tmp0=$ins_url
val18=$(tmp0)
val19=$(val6[1]) $val9 $(val6[2]) $val10 $(val6[3])&#63;	<div class="wimscenter"><img src="$val18" alt=""></div>
replytype1=numexp
replyname1=$val7
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val19
$()
!exit

