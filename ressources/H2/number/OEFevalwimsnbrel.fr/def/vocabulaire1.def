!set title=Vocabulaire 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer sur, du repère dessiné ci-dessous&nbsp;
val7=l'origine
val8=circle,220,220,8
!readproc slib/draw/repere 440,440,20,-5,5,-5,5,1,1,black,grey 
tmp0=$slib_out
val9=$(tmp0)
!readproc oef/draw.phtml 440,440 \
$val9	text black,255,225,medium,1	text black,210,225,medium,0	text black,210,175,medium,1 
tmp0=$ins_url
val10=$(tmp0)
replytype1=coord
replyname1=
replygood1=$val10;$val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val6[1]) $val7 $(val6[2]):	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7
embedcnt=1
