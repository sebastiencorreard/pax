!set title=Placer un point sur une demi-droite graduée 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer pour placer le point d'abscisse, sur la droite graduée ci-dessous&nbsp;
val7=$[rint(1)]
tmp0=!randint 6, 8

val8=$[rint($(tmp0))]
val9=$[rint(0)]
val10=$[0.1]
tmp0=!randint $val9+1, $val8-1

val11=$[rint($(tmp0))]
!readproc slib/draw/drtgraduee 1200,$val9,$val8,$val10,black,grey,40,0 
tmp0=$slib_out
val12=$(tmp0)
val13=$[1120/($val8-$val9)]
val14=$[40+$val13*($val11-$val9)]
!readproc oef/draw.phtml 1200,100 \
$val12 
tmp0=$ins_url
val15=$(tmp0)
replytype1=coord
replyname1=\A
replygood1=$val15;circle,$val14,50,$val13*$val10*$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val11 $(val6[2]):	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11
embedcnt=1
