!set title=Comparer deux nombres décimaux 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Quel est le plus, des deux nombres,et
val7=petit,grand
val8=le plus
tmp0=!randint 1, 9

tmp1=!randint 1, 9

val9=$[rint($(tmp0)*10+$(tmp1))]
tmp0=!randint 5, 8

tmp1=!randint 1, 9

val10=$[-$val9-$(tmp0)*0.1-$(tmp1)*0.01]
tmp0=!randint 1, 4

tmp1=!randint 1, 9

val11=$[-$val9-$(tmp0)*0.1-$(tmp1)*0.01]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val7

val13=$(tmp0)

!ifval $val12=1
val14=$[min($val10,$val11)]
!else
val14=$[max($val10,$val11)]
!endif
choicename1=$val8 $val13
choicegood1=$val14
choicebad1=$val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val13 $(val6[2])	  $val10 $(val6[3]) $val11?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,10,11,13
embedcnt=0
