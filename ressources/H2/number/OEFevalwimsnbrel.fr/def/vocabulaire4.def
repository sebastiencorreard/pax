!set title=Vocabulaire 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r,r,r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Compléter les phrases suivantes en utilisant	  les étiquettes ci-dessous
val7=Dans le plan muni d'un repère, un point est repéré par ses,	On dit par exemple qu'un point, a pour,	Dans ce cas, est son, et, son
val8=coordonnées,coordonnées,abscisse,ordonnée
val9=Premier mot,Deuxième mot,Troisième mot,Quatrième mot
tmp=!nonempty items A,B,C,D,E,F,M,N

tmp0=!randitem $tmp
val10=$(tmp0)
val11=150x20x1
tmp0=!values v,-v for v=1 to 10

val12=$(tmp0)
tmp0=!shuffle $val12

val12=$(tmp0)
replytype1=clickfill
replyname1=$(val9[1])
replygood1=$(val8[1])
replytype2=clickfill
replyname2=$(val9[2])
replygood2=$(val8[2])
replytype3=clickfill
replyname3=$(val9[3])
replygood3=$(val8[3])
replytype4=clickfill
replyname4=$(val9[4])
replygood4=$(val8[4])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val6:	<div class="wims_question">$(val7[1]),	$(val7[2])  
!read oef/embed.phtml r1,$val11 
$().	<br>	$(val7[3]) $val10 $(val7[4])  
!read oef/embed.phtml r2,$val11 
$() ($(val12[1]);$(val12[2])).	$(val7[5]), $(val12[1]) $(val7[6])  
!read oef/embed.phtml r3,$val11 
$()	$(val7[7]) $(val12[2]) $(val7[8])  
!read oef/embed.phtml r4,$val11 
$().	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10,11,12
embedcnt=4
