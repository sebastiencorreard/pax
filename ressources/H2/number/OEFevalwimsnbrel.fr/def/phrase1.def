!set title=Écrire un calcul 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=est la somme de, et de l'opposé de
val7=Écrire l'expression numérique, correspondant à la phrase suivante&nbsp;
val8=Vous ne devez pas effectuer le calcul.
tmp0=!shuffle 2,3,4,5,6,7,8,9

val9=$(tmp0)
val10=$(val6[1]) $(val9[1]) $(val6[2]) $(val9[2]).
val11=$(val9[1])+(-$(val9[2]))
tmp=!nonempty items A,B,C,D,E,F,G,H

tmp0=!randitem $tmp
val12=$(tmp0)
replytype1=litexp
replyname1=$val12
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) $val12 $(val7[2]):	<div class="wims_question">$val12 $val10</div>	<div class="wims_instruction">$val8</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,10,12
embedcnt=0
