!set title=Lire l'abscisse d'un point B5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Quelle est l'abscisse du point,représenté sur la droite graduée ci-dessous&nbsp;
val7=Abscisse de,Ordonnée de
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!randint 11, 17

val9=$[rint($(tmp0))]
val10=$[rint($val9+2)]
val11=$[rint($val9)]
val12=$[0.1]
tmp0=!randint 1, 9

tmp1=!randint 1, 9

tmp2=!randint 0, 1

val13=$[$val11+0.1*$(tmp0)+0.01*$(tmp1)+$(tmp2)]
!readproc slib/draw/drtgraduee 1200,$val11,$val10,$val12,black,grey,40,0 
tmp0=$slib_out
val14=$(tmp0)
!readproc oef/draw.phtml 1200,100 \
$val14	text blue,$val13,2,medium,$val8	fcircle $val13,0,8,blue  
tmp0=$ins_url
val15=$(tmp0)
replytype1=numexp
replyname1=$(val7[1]) $val8
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val8 $(val6[2])?	<div class="wimscenter"><img src="$val15" alt=""></div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,8,15
embedcnt=0
