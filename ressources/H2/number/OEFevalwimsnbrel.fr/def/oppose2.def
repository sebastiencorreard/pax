!set title=Points opposés 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Les abscisses des points,et,placés sur le graphique ci-dessous sont-elles opposées&nbsp;
val7=Oui,Non
tmp0=!shuffle A,B,C,D,E,F,G

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 4, 5

val11=$[rint($(tmp0))]
val12=$[rint(-$val11)]
val13=$[0.1]
tmp0=!randint 1, $val11-3

tmp1=!randint 1, 9

val14=$[$(tmp0)+0.1*$(tmp1)]
tmp0=!randint 2, 4

val15=$[-$val14+0.1*$(tmp0)]
!readproc slib/draw/drtgraduee 1200,$val12,$val11,$val13,black,grey,40 
tmp0=$slib_out
val16=$(tmp0)
!readproc oef/draw.phtml 1200,100 \
$val16	text blue,$val14,2,medium,$val9	fcircle $val14,0,8,blue	text blue,$val15,2,medium,$val10	fcircle $val15,0,8,blue 
tmp0=$ins_url
val17=$(tmp0)
val18=$(val6[1]) $val9 $(val6[2]) $val10 $(val6[3]) &#63;	<div class="wimscenter"><img src="$val17" alt=""></div>
val19=2
val19=$(val7[$val19])
choicename1=
choicegood1=$val19
choicebad1=$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val18
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=18
embedcnt=0
