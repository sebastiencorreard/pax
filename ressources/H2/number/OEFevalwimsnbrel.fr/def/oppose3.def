 !exit
!endif

val6=Les points d'abscisse ,et ,d'une droite graduée sont-ils symétriques par rapport à l'origine&nbsp;
val7=Oui,Non
tmp0=!shuffle A,B,C,D,E,F,G

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!randint 1, 9

tmp1=!randint 7, 9

val11=$[$(tmp0)*0.1+$(tmp1)]
val12=$[-$val11]
val13=$(val6[1]) $val12 $(val6[2]) $val11 $(val6[3])&#63;
