!set title=Comparer deux nombres décimaux 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Quel est le plus, des deux nombres,et
val7=petit,grand
val8=le plus
tmp0=!randint 100, 999

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val9=$[$(tmp0)+$(tmp1)*0.1+$(tmp2)*0.01]
tmp0=!randint 10, 99

tmp1=!randint 1, 9

tmp2=!randint 1, 9

val10=$[$(tmp0)+$(tmp1)*0.1+$(tmp2)*0.01]
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp0=!item $val11 of $val7

val12=$(tmp0)

!ifval $val11=1
val13=$[min($val9,$val10)]
!else
val13=$[max($val9,$val10)]
!endif
choicename1=$val8 $val12
choicegood1=$val13
choicebad1=$val9,$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val12 $(val6[2])	  $val9 $(val6[3]) $val10?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,10,12
embedcnt=0
