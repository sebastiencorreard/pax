val6=Le point, est de coordonnées ,	  dans le plan muni d'un repère.
val7=Quelle est l', du point
val8=abscisse,ordonnée
tmp=!nonempty items A,B,C,D,E,F,M,N

tmp0=!randitem $tmp
val9=$(tmp0)
tmp0=!values v,-v for v=1 to 10

val10=$(tmp0)
tmp0=!shuffle $val10

val10=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]

!ifval $val11=1
val12=$(val8[1])
!else
val12=$(val8[2])
!endif

!ifval $val11=1
val13=$[rint($(val10[1]))]
!else
val13=$[rint($(val10[2]))]
!endif
replytype1=numexp
replyname1=$val12
replygood1=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

