!set title=Lire les coordonnées d'un point 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=24
prevarcnt=23
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Le plan est muni d'un repère orthonormal. Quelles sont les coordonnées du point,	  ci-dessous&nbsp;
val7=Votre réponse
val8=Abscisse de,Ordonnée de
val9=$[rint(400)]
val10=$[rint(400)]
tmp0=!values v for v=1 to 5

val11=$(tmp0)
tmp0=!shuffle $val11

val11=$(tmp0)
tmp0=!shuffle -1,1

val12=$(tmp0)
val13=$[rint($(val12[1])*$(val11[1]))]
val14=$[rint($(val12[2])*$(val11[2]))]
tmp=!nonempty items A,B,C,D,E

tmp0=!randitem $tmp
val15=$(tmp0)
!readproc slib/draw/repere $val9,$val10,20,-6,6,-6,6,1,1,black,grey 
tmp0=$slib_out
val16=$(tmp0)
tmp=!translate internal $	$ to ; in $val16

tmp=!row 1 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val18=$[rint($(tmp0))]
tmp0=!item 2 of $val17

val19=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val16

tmp=!row 2 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val17=$(tmp0)
tmp0=!item 1 of $val17

val20=$[$(tmp0)]
tmp0=!item 2 of $val17

val21=$[$(tmp0)]
tmp0=!line 3 to -1 of $val16

val22=$(tmp0)
val22=$val22	text black,$val18-10,$val19+4,small,0	text black,$val18+$val20-4,$val19+4,small,1	text black,$val18-12,$val19+$val21-4,small,1
val23=$[rint($val18+($val20)*($val13))]
val24=$[rint($val19+($val21)*($val14))]
val25=$val22	linewidth 1	segment $val23-4,$val24+4,$val23+4,$val24-4,red	segment $val23-4,$val24-4,$val23+4,$val24+4,red	text red,$val23-10,$val24+4,medium,$val15
replytype1=numexp
replyname1=$(val8[1]) \($val15)
replygood1=$val13
replytype2=numexp
replyname2=$(val8[2]) \($val15)
replygood2=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) 
!insmath $val15
$() $(val6[2])?	<div class="wimscenter">	 
!read oef/draw.phtml $val9,$val10 \
$val25 
$()	</div>	<b>$val7:</b>	<div class="wimscenter">	
!insmath $val15
$() a pour coordonnées ( 
!read oef/embed.phtml r1,3 
$() ;  
!read oef/embed.phtml r2,3 
$()).	</div>
$()
!exit

