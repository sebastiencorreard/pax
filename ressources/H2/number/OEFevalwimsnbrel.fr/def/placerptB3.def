!set title=Placer un point sur une demi-droite graduée 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Cliquer pour placer le point d'abscisse, sur la droite graduée ci-dessous&nbsp;
val7=$[rint(1)]
tmp0=!randint 11, 17

val8=$[rint($(tmp0))]
tmp0=!randint 3, 5

val9=$[rint($val8+$(tmp0))]
val10=$[rint($val8)]
val11=$[0.1]
tmp0=!randint $val10+1, $val9-1

val12=$[$(tmp0)]
!readproc slib/draw/drtgraduee 1200,$val10,$val9,$val11,black,grey,40,0 
tmp0=$slib_out
val13=$(tmp0)
val14=$[1120/($val9-$val10)]
val15=$[40+$val14*($val12-$val10)]
!readproc oef/draw.phtml 1200,100 \
$val13 
tmp0=$ins_url
val16=$(tmp0)
replytype1=coord
replyname1=\A
replygood1=$val16;circle,$val15,50,$val14*$val11*$val7
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val6[1]) $val12 $(val6[2]):	<div class="wimscenter"> 
!read oef/embed.phtml r1 
$()</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,12
embedcnt=1
