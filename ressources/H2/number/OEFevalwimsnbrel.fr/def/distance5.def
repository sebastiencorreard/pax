val6=Quelle est la distance entre le point d'abscisse,	  et le point d'abscisse , d'une droite graduée&nbsp;
val7=Distance
tmp0=!shuffle A,B,C,D,E,F,G

val8=$(tmp0)
val9=$(val8[1])
val10=$(val8[2])
tmp0=!shuffle 1,-1

val11=$(tmp0)
tmp0=!randint 2, 5

tmp1=!randint 1, 9

val12=$[$(val11[1])*$(tmp0)+$(val11[1])*0.1*$(tmp1)]
tmp0=!randint 1, 9

tmp1=!randint 7, 9

val13=$[$(val11[2])*$(tmp0)*0.1+$(val11[2])*$(tmp1)]
val14=$[abs($val12-$val13)]
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
val16=$(val6[1]) $val12 $(val6[2]) $val13 $(val6[3])&#63;
