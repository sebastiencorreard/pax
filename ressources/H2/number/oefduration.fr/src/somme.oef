\title{ Somme en heures et minutes }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\text{h1=randint(1..22)}
\text{h2=randint(0..(23-\h1))}
\text{m1=randint(1..59)}
\text{m2=randint(1..59)}
\integer{mt=\m1+\m2}


\if {\mt >=60 } {\text{mr=\mt-60} \text{hr =\h1+\h2+1}} {\text{mr=\mt}  \text{hr =\h1+\h2}}
\statement{Donne en heures et minutes le résultat de :   \h1 h \m1 min  +  \h2 h \m2 min  =
\embed{reply 1,2}   h    \embed{reply 2,2} min.
}

\answer { heures }{\hr}{type=numeric}
\answer { minute }{\mr}{type=numeric}
