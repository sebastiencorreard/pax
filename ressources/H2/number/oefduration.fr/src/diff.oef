\title{ Différence en heures et minutes }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\text{h1=randint(2..23)}
\text{h2=randint(1..(\h1-1))}
\text{m1=randint(1..59)}
\text{m2=randint(1..59)}


\if {\m1 < \m2 } {\text{mr=\m1+60-\m2} \text{hr =\h1-\h2-1}} {\text{mr=\m1-\m2}  \text{hr =\h1-\h2}}
\statement{Donne en heures et minutes le résultat de :   \h1 h \m1 min  -  \h2 h \m2 min  =
\embed{reply 1,2}  h  \embed{reply 2,2} min.}

\answer { }{\hr}{type=numeric}
\answer { }{\mr}{type=numeric}
