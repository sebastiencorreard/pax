\title{  Durée décimale vers sexagésimale }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\integer{coef=randint(1..19)}
\integer{min=3*\coef}
\integer{h=randint(1..23)}

\real{heure_deci=\h+\min/60}

\statement{<div style="color:#FF0000">
(Attention: la virgule est représentée  par un point)</div>
<p>
Complète le cadre ci-dessous en écrivant la durée \heure_deci heures en heures sexagésimales : <br>
\heure_deci h = \embed{reply 1,2} h \embed{reply 2,2} min.
</p>}

\answer { }{\h}{type=numeric}
\answer { }{\min}{type=numeric}
