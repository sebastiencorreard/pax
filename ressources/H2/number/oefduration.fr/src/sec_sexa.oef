\title{ Secondes en h, min et s }
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\text{h=randint(1..22)}
\text{m=randint(1..59)}
\text{s=randint(1..59)}



\integer{totalseconde=\h*3600+\m*60+\s}
\statement{Complète :  \totalseconde secondes =
\embed{reply 1,2}   h  \embed{reply 2,2} min \embed{reply 3,2} s.}

\answer { }{\h}{type=numeric}
\answer { }{\m}{type=numeric}
\answer { }{\s}{type=numeric}
