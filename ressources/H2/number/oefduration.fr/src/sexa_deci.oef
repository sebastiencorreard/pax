\title{Durée sexagésimale vers décimale}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\integer{coef=randint(1..19)}
\integer{min=3*\coef}
\integer{h=randint(1..23)}

\real{heure_deci=\h+\min/60}
\text{heures=\h=1? heure:heures}
\statement{<div style="color:#FF0000">
(Attention : la virgule est représentée  par un point.)</div>
<p>
Complète le cadre ci-dessous en écrivant la durée \h heure \min min en heures décimales : <br>
\h \heures \min min = \embed{reply 1,4}  h.
</p>
}

\answer { }{\heure_deci}{type=numeric}
