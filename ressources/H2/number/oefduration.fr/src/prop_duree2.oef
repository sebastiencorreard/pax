\title{Durée-proportionnalité 1}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\integer{tarj=randint(25..55)}
\real{tars=5*\tarj/60}
\integer{h=floor(\tars)}
\real{min=\tarj*5-\h*60}


\statement{Un employé met \tarj min pour effectuer le trajet aller-retour entre chez lui et son lieu de travail.
Calculer et exprimer en heures et minutes le temps de trajet nécessaire pour
 effectuer les cinq allers-retours d'une semaine de travail : <br>
 En une semaine, pour aller travailler, il va passer \embed{reply 1,2} h et \embed{reply 2,2} min
 dans les transports.}

\answer { }{\h}{type=numeric}
\answer { }{\min}{type=numeric}
