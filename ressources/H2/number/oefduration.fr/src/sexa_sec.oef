\title{Heures, min et sec en secondes}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}
\precision{100000000}

\text{h=randint(1..23)}
\text{m=randint(1..59)}
\text{s=randint(1..59)}
\integer{totals=3600*\h+60*\m+\s}
\statement{ Calcule le nombre de secondes contenues dans \h h \m min \s s.

<div class="wimscenter">\h h \m min \s s = \embed{r1,6} s.
</div>}

\answer{\h h \m min \s s}{\totals}{type=numeric}
