\title{ Durée-proportionnalité 2}
\author{Jean-Philippe, Colpin}
\email{jp.colpin@laposte.net}

\integer{coef=randint(50..90)}
\real{tp_deci=35*\coef/100}
\integer{h=floor(\tp_deci)}
\real{min=(\tp_deci-\h)*60}


\statement{Suite à la naissance du petit dernier, un jeune parent décide de travailler à temps partiel.
Calculer et exprimer la réponse en heures et minutes le temps de travail hebomadaire que représente
\coef % de 35 h :
<p>
il va travailler \embed{reply 1,4} h et \embed{reply 2,4} min.
</p>}

\answer { }{\h}{type=numeric}
\answer { }{\min}{type=numeric}
