!set title= Différence en heures et minutes 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 23

val6=$(tmp0)
tmp0=!randint 1, ($val6-1)

val7=$(tmp0)
tmp0=!randint 1, 59

val8=$(tmp0)
tmp0=!randint 1, 59

val9=$(tmp0)
!if $val8 < $val9  
val10=$val8+60-$val9
val11=$val6-$val7-1
!else
val10=$val8-$val9
val11=$val6-$val7
!endif
replytype1=numeric
replyname1=
replygood1=$[$val11]
replytype2=numeric
replyname2=
replygood2=$[$val10]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Donne en heures et minutes le résultat de :   $val6 h $val8 min  -  $val7 h $val9 min  =	 
!read oef/embed.phtml reply 1,2 
$()  h   
!read oef/embed.phtml reply 2,2 
$() min.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=2
