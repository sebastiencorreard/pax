feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 19

val6=$[rint($(tmp0))]
val7=$[rint(3*$val6)]
tmp0=!randint 1, 23

val8=$[rint($(tmp0))]
val9=$[$val8+$val7/60]

!ifval $val8=1
val10= heure
!else
val10=heures
!endif
replytype1=numeric
replyname1=
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

