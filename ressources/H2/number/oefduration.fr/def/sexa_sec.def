!set title=Heures, min et sec en secondes
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Philippe, Colpin
email=jp.colpin@laposte.net
precision=100000000

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 23

val6=$(tmp0)
tmp0=!randint 1, 59

val7=$(tmp0)
tmp0=!randint 1, 59

val8=$(tmp0)
val9=$[rint(3600*$val6+60*$val7+$val8)]
replytype1=numeric
replyname1=$val6 h $val7 min $val8 s
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Calcule le nombre de secondes contenues dans $val6 h $val7 min $val8 s.		<div class="wimscenter">$val6 h $val7 min $val8 s =  
!read oef/embed.phtml r1,6 
$() s.	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8
embedcnt=1
