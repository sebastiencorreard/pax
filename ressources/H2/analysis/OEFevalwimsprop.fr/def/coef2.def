!set title=Coefficient niveau 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Denis,Guicheteau
email=math.42@laposte.net 
language=fr

ansorder=r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Trouver le coefficient de proportionnalité du tableau.
tmp0=!randint 1, 12

val11=$[rint($(tmp0))]
tmp0=!randint 2, 20

val12=$[rint($(tmp0))]
val13=$[rint($val11 * $val12)]
tmp0=!randint 2, 20

val14=$[rint($(tmp0))]
val15=$[rint($val14 * $val11)]
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<table class="wimscenter wimsborder">	  <tr>	    <td> $val12 </td> <td> $val14 </td><td rowspan="2">	     <img src="$val1/fleche1.jpg" alt=""><br>	     
!insmath times
$() 
!read oef/embed.phtml r1,4 
$()<br>	     <img src="$val1/fleche2.jpg" alt=""></td>	  </tr><tr>	    <td> $val13 </td> <td> $val15 </td>	  </tr>	</table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,10,12,13,14,15
embedcnt=1
