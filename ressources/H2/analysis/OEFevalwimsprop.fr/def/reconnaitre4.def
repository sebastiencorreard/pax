!set title=Reconnaître 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val8=Oui,Non
val10=La phrase suivante est-elle vraie&nbsp;
tmp=!translate internal $	$ to ; in Le nombre d'habitants d'un village est proportionnel au nombre de maisons,2	  Le prix payé est proportionnel au nombre de personnes allant au cinéma,1	  La quantité d'essence consommée est proportionnelle au nombre de personnes assises dans la voiture,2	  La taille d'une personne est proportionnelle à son âge,2	  Le nombre d'habitants d'un immeuble est proportionnel à sa hauteur,2	  À la station service&#44; le prix à payer est propotionnel au nombre de litres d'essence achétés,1

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val11=$(tmp0)
val12=$(val8[$(val11[2])])
choicename1=$val7
choicegood1=$val12
choicebad1=$(val8[1]),$(val8[2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10?	<div class="wimscenter" style="font-style:italic">$(val11[1]).</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=0
