!set title=Utiliser un rapport d'échelle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val7=Largeur,Votre réponse
val10=veut réaliser un plan à l'échelle ,de sa chambre.	  La largeur de sa chambre est de,centimètres.
val11=Quelle doit être, en centimètres,	  la largeur de sa chambre sur le plan&nbsp;
!readproc slib/lang/fname boy,fr 
tmp0=$slib_out
val12=$(tmp0)
tmp=!nonempty items 10,20,25,40

tmp0=!randitem $tmp
val13=$[rint($(tmp0))]
tmp0=!randint 250/$val13, 450/$val13

val14=$[$(tmp0)]
val15=$[rint($val14*$val13)]
replytype1=numexp
replyname1=$(val7[1])
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val12 $(val10[1]) 
!insmath \frac{1}{$val13}
$() $(val10[2]) $val15 $(val10[3])	<p>	$val11?	</p>	<b>$(val7[2])</b> :  
!read oef/embed.phtml r1,5 
$() cm.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,11,12,13,15
embedcnt=1
