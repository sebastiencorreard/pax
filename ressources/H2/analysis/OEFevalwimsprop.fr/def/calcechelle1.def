!set title=Calculer un rapport d'échelle 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Une réduction,Un agrandissement
val11=dans la réalité sont représentés par,sur un dessin.
val12=Le dessin est-il un agrandissement ou une	  réduction de la réalité&nbsp;
val9=$val10
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!randint 10, 20

val14=$[rint($(tmp0))]

!ifval $val13=1
tmp0=!randint 2, 9

val15=$[rint($(tmp0))]
!else
tmp1=!randint 21, 30

val15=$[rint($(tmp1))]
!endif
tmp=!nonempty items cm,mm,dm

tmp0=!randitem $tmp
val16=$(tmp0)
val17=$val16
val18=$(val9[$val13])
choicename1=
choicegood1=$val18
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val14 $val16 $(val11[1]) $val15 $val17 $(val11[2])<br>	<p>$val12?</p> 
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=11,12,14,15,16,17
embedcnt=0
