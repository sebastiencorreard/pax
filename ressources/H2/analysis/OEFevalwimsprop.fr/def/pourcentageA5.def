!set title=Appliquer un pourcentage 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Le résultat doit être arrondi au centième si nécessaire.
val11=Sur une tablette de chocolat pesant, il est écrit,de cacao
val12=Quel est le poids de cacao dans la tablette
val13=grammes
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val14=$(tmp0)
val15=$val13
tmp0=!randint 6, 15

val16=$[rint($(tmp0)*5)]
tmp=!nonempty items 125,250,300,150,200,350

tmp0=!randitem $tmp
val17=$[rint($(tmp0))]
val18=$[rint($val16*$val17)/100]
val19=$(val11[1]) $val17 $val15, $(val11[2]) <i>$val16 % $(val11[3])</i>.
val20=$val12
replytype1=numexp
replyname1=
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val19	<p>$val20 ?</p>	<div class="spacer">	<b>$val7</b>:  
!read oef/embed.phtml r1,5 
$() $val15.</div>	<div class="wims_instruction">$val10</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,15,19,20
embedcnt=1
