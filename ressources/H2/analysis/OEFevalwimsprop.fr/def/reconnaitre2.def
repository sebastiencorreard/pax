$()	$val15 $val10	<div class="wimscenter">	<img src="$val14" alt="">	</div>	$val15 $(val11[1]) $(val16[1]) $(val11[2]),	$(val11[3]) $(val16[2]) $(val11[4])<p>	$val15 $val12?</p>
$()
