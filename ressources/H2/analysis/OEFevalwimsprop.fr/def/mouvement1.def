!set title=Mouvement uniforme 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=La position occupée par une bille bleue	  est notée à intervalles réguliers et reportée sur le graphique ci-dessous&nbsp;
val11=La bille bleue suit-elle un déplacement uniforme
tmp0=!randint 1, 2

val12=$[rint($(tmp0))]
tmp0=!randint 6, 12

val13=$[rint($(tmp0))]

!ifval $val12=1
val14=$[rint(floor(98/$val13))]
!else
val14=$[rint(13)]
!endif

!ifval $val12=1
val15=$val13*s
!else
val15=(s)^2/2
!endif
val16=xrange -51,50	yrange -3,3	arrow -51,0,50,0,20,black
!for val17 =0 to $val14 
evaltmp=-49+$val15

evaltmp=!mathsubst s=($val17) in $evaltmp
tmp0=($evaltmp)
val18=$(tmp0)
val16=$val16	fcircle $val18,0,10,blue
!readproc oef/draw.phtml 1000,100 \
$val16 
tmp0=$ins_url
val19=$(tmp0)
!next
val20=$val10:	<div class="wimscenter"><img src="$val19" alt=""></div>
val21=$val11
val22=$(val9[$val12])
choicename1=
choicegood1=$val22
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val20	<p>	$val21 ?	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=20,21
embedcnt=0
