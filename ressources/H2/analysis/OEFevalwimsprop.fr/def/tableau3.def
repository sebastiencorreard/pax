!set title=Tableau de nombres 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Ce tableau est-il un tableau de proportionnalité &#63;
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
tmp0=!randint 2, 6

tmp1=!randint 12, 18

val12=$(tmp0),$(tmp1)
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
!if $val14=1 
tmp0=!shuffle 11,12,13,14,15,16,17,18,19

val15=$(tmp0)
tmp0=!item 1 to 3 of $val15

val15=$(tmp0)
!else
tmp0=!randint 11, 17

val15=$(tmp0)
val16=$[rint($val15+$(val12[1]))]
val17=$[rint($val15+$(val12[2]))]
val15=$val15,$val16,$val17
!endif
val18=
!if $val13=2 
!for val19 =1 to 3 
val20=$[rint($(val15[$val19])*$val11)]
tmp0=!append item $val20 to $val18

val18=$(tmp0)
!next
!else
!if $val14=1 
tmp0=!randint 20, 99

val21=$[rint($(tmp0))]
val16=$[rint($val21+$(val12[1]))]
val17=$[rint($val21+$(val12[2]))]
val18=$val21,$val16,$val17
!else
!for val19 =1 to 3 
val20=$[rint($(val15[$val19])+$(val12[1]))]
tmp0=!append item $val20 to $val18

val18=$(tmp0)
!next
!endif
!endif
tmp0=!item $val13 of $val9

val22=$(tmp0)
choicename1=$val7
choicegood1=$val22
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<table class="wimscenter wimsborder">	 <tr>	  <td>$(val15[1])</td>	  <td>$(val15[2])</td>	  <td>$(val15[3])</td>	 </tr><tr>	  <td >$(val18[1])</td>	  <td >$(val18[2])</td>	  <td >$(val18[3])</td>	 </tr>	 </table>	$m_compenonce
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,15,18
embedcnt=0
