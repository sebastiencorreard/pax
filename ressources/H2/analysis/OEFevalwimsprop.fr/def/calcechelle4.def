!set title=Calculer un rapport d'échelle 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=dans la réalité sont représentés par,sur un dessin.
val11=Quel est le rapport d'échelle&nbsp;
val7=Rapport
tmp0=!randitem 10,20,40,50,200,500

val12=$[rint($(tmp0))]
tmp0=!randint 1, 9

val13=$[rint($(tmp0)*100)]
val14=$[$val13/$val12]
tmp=!translate internal $	$ to ; in Km,m,1000	m,cm,100	m,mm,1000

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
val16=$(val15[1])
val17=$(val15[2])
tmp=!translate ";': to $     $ in $val14/($val13*$(val15[3]))

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=$val7
replygood1=$val18
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13 $val16 $(val10[1]) $val14 $val17 $(val10[2])<p>	$val11?	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,13,14,16,17
embedcnt=0
