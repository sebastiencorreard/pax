!set title=Mouvement uniforme 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=La position occupée par une bille	  est notée à intervalles réguliers et reportée sur le graphique ci-dessous&nbsp;
val11=Le point vert marque la position initiale et le point rouge la	  position finale de la bille.
val12=La bille suit-elle un déplacement uniforme
tmp0=!randint 1, 2

val13=$[rint($(tmp0))]
!if $val13=1 
tmp0=!randint 10, 15

val14=$[rint($(tmp0))]
val15=$[rint(floor(300/$val14))]
tmp0=!values $val14*v for v=0 to $val15-1

val14=$(tmp0)
!else
val14=0,10,30,60,100,150,210,280
val15=8
!endif
val16=circle 150,150,260,black
!for val17 =1 to $val15 
val18=$[150+130*cos($(val14[$val17])/180*pi)]
val19=$[150+130*sin($(val14[$val17])/180*pi)]

!ifval $val17=1
val20=green
!else
val20=blue
!endif

!ifval $val17=$val15
val20=red
!else
val20=$val20
!endif
val16=$val16	fcircle $val18,$val19,10,$val20
!readproc oef/draw.phtml 300,300 \
$val16 
tmp0=$ins_url
val21=$(tmp0)
!next
val22=$val10:	  <div class="wimscenter"><img src="$val21" alt=""></div>	  $val11
val23=$val12
val24=$(val9[$val13])
choicename1=
choicegood1=$val24
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val22	<p>	$val23 ?	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=22,23
embedcnt=0
