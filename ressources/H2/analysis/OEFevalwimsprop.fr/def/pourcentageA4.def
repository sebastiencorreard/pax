!set title=Appliquer un pourcentage 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=21
prevarcnt=20
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Le résultat doit être arrondi au centième si nécessaire.
val11=a acheté une action à, Il lit dans le journal que sa valeur a augmenté de
val12=Quel est le prix actuel de cette action,Combien a-t-il gagné
val13=euros
!readproc slib/lang/fname fr,boy 
tmp0=$slib_out
val14=$(tmp0)
val15=$val13
tmp=!nonempty items 15,20,25,30,35,40

tmp0=!randitem $tmp
val16=$(tmp0)
tmp0=!randint 500, 1000

val17=$[$(tmp0)/100]
val18=$[rint($val16*$val17)/100]
tmp0=!randint 1, 2

val19=$[rint($(tmp0))]
!if $val19=1 
val20=$val14 $(val11[1]) $val17 $val15. $(val11[2]) $val16 %.
val21=$(val12[1])
val22=$[$val17+$val18]
!else
val20=$val14 $(val11[1]) $val17 $val15. $(val11[2]) $val16 %.
val21=$(val12[2])
val22=$[$val18]
!endif
replytype1=numexp
replyname1=
replygood1=$val22
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val20	<p>$val21 ?</p>	<div class="spacer">	<b>$val7</b>:  
!read oef/embed.phtml r1,5 
$() $val15.</div>	<div class="wims_instruction">$val10</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,15,20,21
embedcnt=1
