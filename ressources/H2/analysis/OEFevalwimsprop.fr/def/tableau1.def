!set title=Tableau de nombres 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=16
prevarcnt=15
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Ce tableau est-il un tableau de proportionnalité &#63;
tmp=!nonempty items 10,100

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
tmp0=!shuffle 11,12,13,14,15,16,17,18,19

val12=$(tmp0)
tmp0=!item 1 to 3 of $val12

val12=$(tmp0)
val13=
tmp0=!randint 1, 3

val14=$[rint($(tmp0)*$val11)]
tmp0=!randint 1, 2

val15=$[rint($(tmp0))]
!for val16 =1 to 3 

!ifval $val15=1 and $val16=3
val17=$[rint($(val12[$val16])*$val11+$val14)]
!else
val17=$[rint($(val12[$val16])*$val11)]
!endif
tmp0=!append item $val17 to $val13

val13=$(tmp0)
!next
tmp0=!item $val15 of $val9

val18=$(tmp0)
choicename1=$val7
choicegood1=$val18
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<table class="wimscenter wimsborder">	 <tr>	  <td>$(val12[1])</td>	  <td>$(val12[2])</td>	  <td>$(val12[3])</td>	 </tr><tr>	  <td >$(val13[1])</td>	  <td >$(val13[2])</td>	  <td >$(val13[3])</td>	 </tr>	 </table>	$m_compenonce
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,12,13
embedcnt=0
