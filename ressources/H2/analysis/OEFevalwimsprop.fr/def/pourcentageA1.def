!set title=Appliquer un pourcentage 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=17
prevarcnt=16
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Calculer les pourcentages suivants&nbsp;
val7=Votre réponse
val11=de
tmp=!nonempty items 10,20,30,40,50

tmp0=!randitem $tmp
val12=$[rint($(tmp0))]
tmp0=!randitem 25,75

val13=$[rint($(tmp0))]
tmp0=!randint 1, 5

tmp1=!randint 1, 9

val14=$[rint($(tmp0)*10+$(tmp1))]
tmp0=!randint 201, 299

val15=$[rint($(tmp0))]
tmp0=!randint 11, 19

val16=$[rint($(tmp0)*10)]
tmp0=!randint 201, 299

val17=$[rint($(tmp0))]
val18=$[$val15*$val12/100]
val19=$[$val17*$val13/100]
val20=$[$val16*$val14/100]
replytype1=litexp
replyname1=$val7 1
replygood1=$val18
replytype2=litexp
replyname2=$val7 2
replygood2=$val19
replytype3=litexp
replyname3=Réponse 3
replygood3=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10:	<table>	 <tr>	  <td>$val12 % $val11 $val15 : </td><td> 
!read oef/embed.phtml r1,5 
$()</td>	 </tr><tr>	  <td>$val13 % $val11 $val17 : </td><td> 
!read oef/embed.phtml r2,5 
$()</td>	 </tr><tr>	  <td>$val14 % $val11 $val16 : </td><td> 
!read oef/embed.phtml r3,5 
$()</td>	 </tr>	</table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14,15,16,17
embedcnt=3
