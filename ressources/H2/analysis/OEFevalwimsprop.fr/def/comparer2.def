!set title=Comparer des proportions 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=c
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=La première,La deuxième
val11=de femmes,d'hommes
val12=grande,petite
val13=Deux patrons comparent la proportion,	  dans leur entreprise respective.
val14=Le premier trouve qu'il y a , et le deuxième
val15=Dans quelle entreprise la proportion,est-elle la plus
tmp0=!shuffle 1/2,1/3,2/3,1/4,3/4,1/5,2/5,3/5,4/5,1/10,3/10,7/10,9/10

val16=$(tmp0)
val9=$val10
tmp0=!randint 1, 2

val17=$[rint($(tmp0))]

!ifval $val17=1
val18=$(val12[1])
!else
val18=$(val12[2])
!endif
!if $val17=1 

!ifval $(val16[1])<$(val16[2])
val19=$(val9[2])
!else
val19=$(val9[1])
!endif
!else

!ifval $(val16[1])<$(val16[2])
val19=$(val9[1])
!else
val19=$(val9[2])
!endif
!endif
tmp=!nonempty items $val11

tmp0=!randitem $tmp
val20=$(tmp0)
choicename1=
choicegood1=$val19
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val13[1]) $val20 $(val13[2])	$(val14[1]) $(val16[1]) $val20 $(val14[2]) $(val16[2]).	<p>	$(val15[1]) $val20 $(val15[2]) $val18 ?	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,14,15,16,18,20
embedcnt=0
