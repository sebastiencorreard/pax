!set title=Quatrième proportionnelle niveau 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Compléter ce tableau de proportionnalité.
tmp0=!randint 2, 10

tmp1=!randint 1, 9

val11=$[$(tmp0)+$(tmp1)/10]
tmp0=!randint 2, 5

val12=$[$val11*$(tmp0)]
tmp0=!randint 2, 10

val13=$[$val12*$(tmp0)]
val14=$[($val11 * $val13)/$val12]
replyname1=$val7
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<table class="wimscenter wimsborder"><tr><td>		  $val11</td><td> 
!read oef/embed.phtml r1,4 
$()</td>	  </tr><tr>	  <td>$val12</td><td>$val13		  </td></tr></table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13
embedcnt=1
