!set title=Coefficient niveau 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Denis,Guicheteau
email=math.42@laposte.net 
language=fr

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=Trouver le coefficient de proportionnalité du tableau.
val11=kg de cerises,prix à payer (euros)
tmp0=!randint 1, 5

tmp1=!randint 1, 9

val12=$[$(tmp0)+$(tmp1)/10]
tmp0=!randint 2, 20

val13=$[rint($(tmp0))]
val14=$[$val12 * $val13]
tmp0=!randint 2, 20

val15=$[rint($(tmp0))]
!while $val15==$val13 
tmp0=!randint 2, 20

val15=$[rint($(tmp0))]
!endwhile
val16=$[$val15 * $val12]
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val10	<table class="wimscenter wimsborder">	  <tr>	    <th>$(val11[1])</th><td> $val13 </td><td> $val15</td>	    <td rowspan="2"> <img src="$val1/fleche1.jpg" alt="fleche1">	    <br>
!insmath times
$() 
!read oef/embed.phtml r1,4 
$()<br><img src="$val1/fleche2.jpg" alt="fleche2"></td>	  </tr><tr>	    <th>$(val11[2])</th><td> $val14 </td> <td> $val16 </td>	  </tr>	</table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=1,10,11,13,14,15,16
embedcnt=1
