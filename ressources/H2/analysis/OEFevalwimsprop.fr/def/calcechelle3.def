!set title=Calculer un rapport d'échelle 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice,Guerimand
email=fwguerima@free.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Votre réponse
val8=Oui,Non
val9=$(val8[2]),$(val8[1])
val10=dans la réalité sont représentés par,sur un dessin.
val11=Quel est le rapport d'échelle&nbsp;
val7=Rapport
tmp0=!randitem 100,1000,200,400,500,2000,5000

val12=$[rint($(tmp0))]
tmp0=!randint 1, 9

val13=$[rint($(tmp0)*100)]
val14=$[$val13*$val12]
tmp=!nonempty items cm,mm,dm

tmp0=!randitem $tmp
val15=$(tmp0)
val16=$val15
tmp=!translate ";': to $     $ in $val14/$val13

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val17=$(tmp0)
replytype1=numexp
replyoption1=noreduction 
replyname1=$val7
replygood1=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val13 $val15 $(val10[1]) $val14 $val16 $(val10[2])<p>	$val11?	</p>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,13,14,15,16
embedcnt=0
