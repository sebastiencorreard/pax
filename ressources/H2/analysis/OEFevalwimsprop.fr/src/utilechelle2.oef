\title{Utiliser un rapport d'échelle 2}

\text{name_answer=Votre réponse}
\text{name_yesno=Oui,Non}
\text{bad=\name_yesno[2],\name_yesno[1]}

\text{name_answer=Largeur,Votre réponse}

\text{name_question=Compléter la phrase suivante&nbsp;}

\text{name_enonce=Sur un plan à l'échelle,
  représentent, mètres dans la réalité.}


 \integer{E=randitem(100,200,250,400,500,1000)}
 \integer{l=randint(5..10)}
 \real{rep=\l*\E/100}
 \statement{\name_question:
<div class="wimscenter">\name_enonce[1] \(\frac{1}{\E}),
\l centimètres \name_enonce[2] \embed{r1,8} \name_enonce[3]</div>}
\answer{\name_answer[1]}{\rep}{type=numexp}

