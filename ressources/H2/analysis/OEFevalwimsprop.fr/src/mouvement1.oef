\title{Mouvement uniforme 1}

\text{name_answer=Votre réponse}
\text{name_yesno=Oui,Non}
\text{bad=\name_yesno[2],\name_yesno[1]}

\text{name_enonce=La position occupée par une bille bleue
  est notée à intervalles réguliers et reportée sur le graphique ci-dessous&nbsp;}
\text{name_question=La bille bleue suit-elle un déplacement uniforme}


 \integer{ch=randint(1..2)}
 \integer{f=randint(6..12)}
 \integer{nb=\ch=1?floor(98/\f):13}
 \text{formule=\ch=1?\f*s:(s)^2/2}
 \text{dessin=xrange -51,50
yrange -3,3
arrow -51,0,50,0,20,black}
 \for{k=0 to \nb}{
  \text{v=evalue(-49+\formule,s=\k)}
  \text{dessin=\dessin
fcircle \v,0,10,blue}
 \text{figure=draw(1000,100
\dessin)}
 }
 \text{enonce=\name_enonce:
<div class="wimscenter"><img src="\figure" alt=""></div>}
 \text{question=\name_question}
 \text{good=\bad[\ch]}

\statement{\enonce
<p>
\question ?
</p>}
\choice{}{\good}{\bad}

