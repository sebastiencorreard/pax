\email{fwguerima@free.fr}
maintenance WIMS EDU

\text{lang=slib(oef/env lang)}




\title{Mouvement uniforme 2}

\text{name_answer=Votre réponse}
\text{name_yesno=Oui,Non}
\text{bad=\name_yesno[2],\name_yesno[1]}

\text{name_enonce1=La position occupée par une bille
  est notée à intervalles réguliers et reportée sur le graphique ci-dessous&nbsp;}
\text{name_enonce2=Le point vert marque la position initiale et le point rouge la
  position finale de la bille.}
 \text{name_question=La bille suit-elle un déplacement uniforme}

 \integer{ch=randint(1..2)}
 \if{\ch=1}{
  \integer{p=randint(10..15)}
  \integer{nb=floor(300/\p)}
  \text{p=wims(values \p*v for v=0 to \nb-1)}
 }{
  \text{p=0,10,30,60,100,150,210,280}
  \text{nb=8}
 }
 \text{dessin=circle 150,150,260,black}
 \for{k=1 to \nb}{
  \real{x1=150+130*cos(\p[\k]/180*pi)}
  \real{y1=150+130*sin(\p[\k]/180*pi)}
  \text{color=\k=1?green:blue}
  \text{color=\k=\nb?red:\color}
  \text{dessin=\dessin
fcircle \x1,\y1,10,\color}
 \text{figure=draw(300,300
\dessin)}
 }
 \text{enonce=\name_enonce1:
  <div class="wimscenter"><img src="\figure" alt=""></div>
  \name_enonce2}
 \text{question=\name_question}
 \text{good=\bad[\ch]}

\statement{\enonce
<p>
\question ?
</p>}
\choice{}{\good}{\bad}

