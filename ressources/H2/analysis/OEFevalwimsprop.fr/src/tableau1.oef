\title{Tableau de nombres 1}

\text{name_answer=Votre réponse}
\text{name_yesno=Oui,Non}
\text{bad=\name_yesno[2],\name_yesno[1]}

\text{enonce=Ce tableau est-il un tableau de proportionnalité &#63;}


  \integer{a=randitem(10,100)}
 \text{tab=shuffle(11,12,13,14,15,16,17,18,19)}
 \text{tab=item(1 to 3,\tab)}
 \text{tab2=}
 \integer{b=randint(1..3)*\a}
 \integer{ch=randint(1..2)}
 \for{k=1 to 3}{
  \integer{t=\ch=1 and \k=3?\tab[\k]*\a+\b:\tab[\k]*\a}
  \text{tab2=wims(append item \t to \tab2)}
 }
 \text{good=item(\ch,\bad)}

\statement{
\enonce
<table class="wimscenter wimsborder">
 <tr>
  <td>\tab[1]</td>
  <td>\tab[2]</td>
  <td>\tab[3]</td>
 </tr><tr>
  <td >\tab2[1]</td>
  <td >\tab2[2]</td>
  <td >\tab2[3]</td>
 </tr>
 </table>
\compenonce}
\choice{\name_answer}{\good}{\bad}

