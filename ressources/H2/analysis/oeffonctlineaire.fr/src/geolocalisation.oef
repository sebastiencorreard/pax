\text{flash=slib(media/video [ogg="https://tube-sciences-technologies.apps.education.fr/download/videos/d1c0d23f-ca86-4316-9402-c4c3691601cc-240.ogv"])} 
\text{listetableau= wims(makelist r x for x = 4 to 9)}

\matrix{STEP= reply1, reply2
reply3
\listetableau
reply10
reply11, reply12
reply13, reply14, reply15
reply16, reply17
reply18, reply19
reply20
reply21, reply22, reply23, reply24
}
\steps{\STEP}
\integer{nn=randint(1..6)}
\integer{T=5*\nn}
\real{vs=331.5+0.6*\T}
\text{tppj=1,2,3}


\text{dppj=} 
\text{listcoordonne=}
\text{listcoor=}
\for{u=1 to 3}{ 
  \real{s=\vs*\u}
  \integer{dd=(\u+1)*60+4}
  \integer{aa=(6-1)*60-(\u)*60-3}
  \text{dppj=wims(append item \s to \dppj)}
  \text{listcoordonne=wims(append item \dd,\aa to \listcoordonne)}
\text{listcoor=wims(append item \u,\s to \listcoor)}
}

\text{alphabet = Pierre,Paul,Jacques,Pinocchio}
\text{axe=Temps,Distance,1 cm pour 1 s,1 cm pour \vs m}

\text{ppj=<img src="\imagedir/pierre.gif" alt="Pierre" />,<img src="\imagedir/paul.gif" alt="Paul" />,<img src="\imagedir/jacques.gif" alt="Jacques" />}

\matrix{eleve=Pierre,rue Monge,51,706,Paul,rue du vieux collège,750,600,Jacques,à l'intersection de la rue Devosge et de la rue Courtepée,364,53
Pierre,place Saint Michel,678,574,Paul,rue de Berbisey,116,797,Jacques,rue Alfred de Musset,900,1083
}
\integer{jj=randint(1..2)}
\real{xpi=\eleve[\jj;3]/50}
\real{xpa=\eleve[\jj;7]/50}
\real{xj=\eleve[\jj;11]/50}
\real{ypi=(1098-\eleve[\jj;4]-30)/50}
\real{ypa=(1098-\eleve[\jj;8]-30)/50}
\real{yj=(1098-\eleve[\jj;12]-30)/50}
\if{\jj=1}{\real{signe=1}}{\real{signe=-1}}

\real{p=((\xpi+0.3)^2-(\xpa+0.3)^2+(\ypi+0.3)^2-(\ypa+0.3)^2+3*(\vs*9.5/607)^2)/2/(\ypi-\ypa)}
\real{pp=((\xpi+0.3)^2-(\xj+0.3)^2+(\ypi+0.3)^2-(\yj+0.3)^2+8*(\vs*9.5/607)^2)/2/(\ypi-\yj)}
\real{m=-(\xpi-\xpa)/(\ypi-\ypa)}
\real{mm=-(\xpi-\xj)/(\ypi-\yj)}
\real{xff=(\pp-\p)/(\m-\mm)}
\real{yff=(\m*\pp-\p*\mm)/(-\mm+\m)}

\real{xpin=(2)}

\integer{tt=randint(1..2)}

\if{\tt=1}{\real{ypin=\signe*sqrt((9.5*2.5*\vs/607)^2-(\xpin+0.3-\xff)^2)-0.3+\yff}}
{\real{ypin=\signe*sqrt((9.5*2.5*\vs/607)^2-(\xpin+0.3-\xff)^2)-0.3+\yff-2}}
\real{AB=607/9.5*sqrt((\xpin+0.3-\xff)^2+(\ypin+0.3-\yff)^2)}
\integer{AZ=\AB*10}
\real{ABB=\AZ/10}
\real{tmpin=2.5}
\integer{xxxx=(\tmpin+1)*60+4}
\real{yyy=\AB/\vs}
\integer{yyyy=(6-1)*60-(\yyy)*60+21}

\text{po=slib(millimetre 7,6,,,1,\vs,[255,255,255],[190,190,190],,style:grad=xy)}
\text{porep=slib(millimetre 7,6,,,1,\vs,[255,255,255],[190,190,190],,style:grad=xy,style:dot=+,\listcoor)}
\text{droi=slib(graphpaper/func_milli 7,6,,,1,\vs,[255,255,255],[190,190,190],,\vs*x,[],\listcoor)}
\text{droifinal=slib(graphpaper/func_milli 7,6,,,1,\vs,[255,255,255],[190,190,190],,\vs*x,[],\listcoor,\tmpin,\AB)}

\text{axe=linewidth 1
text red,25,59,giant,Distance
text red,20,56,giant,  1 cm pour \vs m
text red,50,6,giant,  Temps 
text red,45,3,giant,  1 cm pour 1 s}

\text{point=\po
\axe}
\text{pointrep=\porep
\axe}
\text{droite=\droi
\axe}
\text{droitefinal=\droifinal
\axe}

\text{urlpoint = draw(420,360
\point)}

\text{urlpointrep = draw(420,360
\pointrep)}
