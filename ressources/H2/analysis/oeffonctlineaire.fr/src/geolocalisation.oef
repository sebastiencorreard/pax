\text{pro=Où se trouve l'orage? "besoin d'un chasseur d'orage"}
\text{enonce=On va déterminer simplement le lieu où se trouve la foudre.}
\text{tableau=}

\text{A=slib(geo2D/jsxgraph jsxbox,1300 x 1300,
var board = JXG.JSXGraph.initBoard('jsxbox', {originX: 50, originY: 1249, unitX: 50, unitY: 50, axis:true,shownavigation:false, grid:true});
var urlImg = "\imagedir/map.jpg";
var im = board.create('image',[urlImg, [0,0], [22.9,21.96]],{fixed:true});

var urlpierre = "\imagedir/pierre.gif";
var impi = board.create('image',[urlpierre, [\xpi,\ypi], [0.6,0.6] ]);
var pi = board.createElement('point',[\xpi+0.3,\ypi+0.3], {name:'Pierre',style:12,fixed:true});

var urlpaul = "\imagedir/paul.gif";
var impa = board.create('image',[urlpaul, [\xpa,\ypa], [0.6,0.6] ]);
var pa = board.createElement('point',[\xpa+0.3,\ypa+0.3], {name:'Paul',style:12,fixed:true});

var urljacques = "\imagedir/jacques.gif";
var imj = board.create('image',[urljacques, [\xj,\yj], [0.6,0.6] ]);
var j = board.createElement('point',[\xj+0.3,\yj+0.3], {name:'Jacques',style:12,fixed:true});

var plpa = board.createElement('point',[\xpa+2.3,\ypa+2.3], {name:'A',style:5,strokeColor:'#2900fb'});
var plj = board.createElement('point',[\xj+2.3,\yj+2.3], {name:'B', style:5,strokeColor:'#2900fb'});

var f = board.createElement('point',[12,22.5], {name:'Foudre', style:6, strokeColor:'#2900fb'});

var cpi = board.createElement('circle',["Pierre",\dppj[1]*9.5/607], {strokeColor:'#990000',strokeWidth:6});
var cpa = board.createElement('circle',["Paul","A"], {strokeColor:'#990000',strokeWidth:6});
var cj = board.createElement('circle',["Jacques","B"], {strokeColor:'#990000',strokeWidth:6});

var dfp = board.createElement('text',[14,24.5,function(){
    return 'Distance entre Paul et la Foudre = ' + (pa.Dist(plpa)*607/9.5).toFixed(1) +' m';
  }],{fontSize:'20px'});

var dfp = board.createElement('text',[14,23.5,function(){
    return 'Distance entre Jacques et la Foudre = ' + (j.Dist(plj)*607/9.5).toFixed(1) +' m';
  }],{fontSize:'20px'});

var dfp = board.createElement('text',[14,22.5,function(){
    return 'La Foudre a pour coordonnées : ' +'('+ f.X() +';'+f.Y()+')';}],{fontSize:'20px'});
)}
\text{B=slib(geo2D/jsxgraph jsxbox,1300 x 1300,
var board = JXG.JSXGraph.initBoard('jsxbox', {originX: 50, originY: 1249, unitX: 50, unitY: 50, axis:true,shownavigation:false, grid:true});
var urlImg = "\imagedir/map.jpg";
var im = board.create('image',[urlImg, [0,0], [22.9,21.96]],{fixed:true});

var urlpierre = "\imagedir/pierre.gif";
var impi = board.create('image',[urlpierre, [\xpi,\ypi], [0.6,0.6] ]);
var pi = board.createElement('point',[\xpi+0.3,\ypi+0.3], {name:'Pierre',style:12,fixed:true});

var urlpaul = "\imagedir/paul.gif";
var impa = board.create('image',[urlpaul, [\xpa,\ypa], [0.6,0.6] ]);
var pa = board.createElement('point',[\xpa+0.3,\ypa+0.3], {name:'Paul',style:12,fixed:true});

var urljacques = "\imagedir/jacques.gif";
var imj = board.create('image',[urljacques, [\xj,\yj], [0.6,0.6] ]);
var j = board.createElement('point',[\xj+0.3,\yj+0.3], {name:'Jacques',style:12,fixed:true});

var urlPinocchio = "\imagedir/Pinocchio.png";
var imPin = board.create('image',[urlPinocchio, [\xpin,\ypin], [0.6,0.6] ]);
var j = board.createElement('point',[\xpin+0.3,\ypin+0.3], {name:'Pinocchio',style:12,fixed:true});


var plpa = board.createElement('point',[12,23.5], {name:'A',style:5,strokeColor:'#2900fb'});
var plj = board.createElement('point',[13,23.5], {name:'B', style:5,strokeColor:'#2900fb'});
var li = board.createElement('line',[plpa,plj],{straightFirst:false, straightLast:false, strokeWidth:3, dash:0});

var f = board.createElement('point',[\xff,\yff], {name:'Foudre', style:6,fixed:true});

var cpi = board.createElement('circle',["Pierre",\dppj[1]*9.5/607], {strokeColor:'#990000',strokeWidth:6});
var cpa = board.createElement('circle',["Paul",\dppj[2]*9.5/607], {strokeColor:'#990000',strokeWidth:6});
var cj = board.createElement('circle',["Jacques",\dppj[3]*9.5/607], {strokeColor:'#990000',strokeWidth:6});

var dfp = board.createElement('text',[14,24.5,function(){
    return 'La Foudre a pour coordonnées : ' +'('+ f.X().toFixed(1) +';'+f.Y().toFixed(1)+')';
  }],{fontSize:'20px'});
var dfp = board.createElement('text',[14,23.5,function(){
    return 'La Distance entre les points A et B est de ' + (plpa.Dist(plj)*607/9.5).toFixed(1) +' m';
  }],{fontSize:'20px'});
)}
