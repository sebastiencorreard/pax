\answer{}{\rep1[6];\rep1}{type=clickfill}{option=shuffle noanalyzeprint nonstop}
\answer{Dépend-il du temps?}{1;oui,non}{type=radio}{option=shuffle split nonstop}
\answer{}{\rep1[7]}{type=clickfill}{option=noanalyzeprint nonstop}
\answer{Dépend-il du temps}{2;oui,non}{type=radio}{option=shuffle split nonstop}

\answer{L'eau consommée au bout de 5 minutes :}{\qc}{type=numeric}{option= nonstop}
\answer{L'eau consommée au bout de 10 minutes :}{\qd}{type=numeric}{option= nonstop}
\answer{L'eau consommée au bout de 15 minutes :}{\qq}{type=numeric}{option= nonstop}
\answer{L'eau consommée au bout de 20 minutes :}{\qv}{type=numeric}{option= nonstop}
