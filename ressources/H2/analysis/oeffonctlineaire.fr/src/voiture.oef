reply68
reply69, reply70
reply71
reply72
reply73
reply74, reply75
}
\steps{\STEP}

mode debug
integer{n=9}
\integer{n=randint(0..17)}
mode debug
integer{v=200}
\integer{v=110+10*\n}
\text{vi=\v}

\integer{d=340}
\integer{dpi=1377-\d/100*60}
\integer{t=\d/\v*10}
\real{ta=\t/10}
\real{tamin=\ta-0.1}
\real{tamax=\ta+0.1}
\integer{taentier=floor(\ta)}
\integer{tapi=(\ta+1)*60+3}
\real{tfleche=\t+10}
\real{dfleche=\d/10+10}


\text{vt=} 
\text{listcoordonne=}
\text{listcoor=}
\for{u=1 to 8}{ 
  \integer{s=\v*\u}
  \integer{dd=(\u+1)*60+6}
  \integer{aa=1377-(66+\n*6)*\u}
  \text{vt=wims(append item \s to \vt)}
  \text{listcoordonne=wims(append item \dd,\aa to \listcoordonne)}
  \text{listcoor=wims(append item \u,\s to \listcoor)}
} 

\text{alphabet = A,B,C,D,E,F,G,H}
\text{axe=Temps,Distance,1 cm pour 1 Heure,1 cm pour 100 Km}

\text{L=slib(millimetre 4,6,,,,,[255,255,255],[190,190,190],,style:grad=no)}
\text{Croix=slib(millimetre 4,6,2,3,,,[255,255,255],[190,190,190],,style:grad=no)}
\text{T=slib(millimetre 4,6,,3,,,[255,255,255],[190,190,190],,style:grad=no)}
\text{ae=slib(millimetre 10,10,,,,,[255,255,255],[190,190,190],,style:grad=no)}
\text{grad=slib(millimetre 15,24,,,,,[255,255,255],[190,190,190],,style:grad=no)}
\text{point=slib(millimetre 15,24,,,1,100,[255,255,255],[190,190,190],,style:grad=xy)}
\text{pointrep=slib(millimetre 15,24,,,1,100,[255,255,255],[190,190,190],,style:grad=xy,style:dot=+,\listcoor)}
\text{vecteur=slib(graphpaper/func_milli 15,24,,,1,100,[255,255,255],[190,190,190],,\v*x,[],\listcoor)}
\text{flechefirst= linewidth 2
arrow 10,\dfleche,\tfleche,\dfleche,10,red}
\text{finalfirst=\vecteur \flechefirst}
\text{flechesecond= linewidth 2
arrow 10,\dfleche,\tfleche,\dfleche,10,red
linewidth 2
arrow \tfleche,\dfleche,\tfleche,10,10,red}
\text{finalsecond=\vecteur \flechesecond}


\text{urlL = draw(240,360
\L)}
\text{urlCroix = draw(240,360
\Croix)}
\text{urlT = draw(240,360
\T)}
\text{urlae = draw(600,600
\ae)}
\text{urlgrad = draw(900,1440
\grad)}
\text{urlpoint = draw(900,1440
\point)}
\text{urlpointrep = draw(900,1440
\pointrep)}
\text{urlvecteur = draw(900,1440
\vecteur)}
\text{urlfinalfirst = draw(900,1440
\finalfirst)}
\text{urlfinalsecond = draw(900,1440
\finalsecond)}

\text{listegraph=<img src="\urlL" alt="Repère en L" />,<img src="\urlT" alt="Repère en T inversé" />,<img src="\urlCroix" alt="Repère en croix" />}
\text{li=shuffle(3)}
\text{lgm=wims(makelist li[\x] for x=1 to 3)}
\text{listegraphmixe=\listegraph[\li[1]],\listegraph[\li[2]],\listegraph[\li[3]]}
\integer{rep=position(1,\li)}

\text{gggo=} 
\for{u=0 to 21}{ 
\integer{h=1305-\u*60} 
\text{gggo=wims(append item \h to \gggo)}
}
\text{ggga=} 
\for{e=0 to 13}{ 
\integer{r=98+\e*60} 
\text{ggga=wims(append item \r to \ggga)}
}

\text{pro=Quel est le temps mis par la Ferrari pour parcourir la
 distance de \d Km de Paris à Dijon ?
<br /><br />}
\text{enonce= Une Ferrari F40 roule à la vitesse moyenne de <b>\v Km/h</b>
 sur une autoroute allemande.}

\statement{
<br />
<div class="consigne">
<div id="boiteg">
<img src="\imagedir/Ferrarif40_2.jpg" alt="Ferrari" />
</div>
<p class="problematique"> \pro</p>
<p class="special_letter">\enonce</p>

\if{\step==1}{
<br />
<div class="question">
<div class="etape">ÉTAPE \step sur 13</div>
<ul><li> La voiture roule pendant une heure. Calculez la distance
 parcourue ? \embed{reply1, 4} Km. </li>
<li> La voiture roule pendant 2 heures. Calculez la distance
 parcourue ? \embed{reply2, 4} Km. </li>
<li> La voiture roule pendant 5 heures. Calculez la distance
 parcourue ?  \embed{reply3, 4} Km. </li></ul>
</div>}

\if{\step==2}{
<div class="question">
<div class="etape">ÉTAPE \step sur 13</div>
La voiture roule pendant <span class="bold" style="color:#cf3333">x</span>
 heures. Donnez l'expression littérale de la distance parcourue
 <span class="bold" style="color:#fbf80a">D(x)</span> par la Ferrari en
 complétant les calculs suivants.
<br />
Vous venez de réaliser les calculs suivants :
<br />
<table class="wimscenter wimsnoborder">
<tr>
<td><span style="color:#cf3333">1</span></td>
<td><span style="color:#3F5B98"> \times</span></td>
<td><span style="color:#ec10ed">\v</span></td>
<td><span style="color:#3F5B98">=</span></td>
<td><span style="color:#fbf80a">\v</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">2</span></td>
<td><span style="color:#3F5B98">\times</span></td>
<td><span style="color:#ec10ed">\v</span></td>
<td><span style="color:#3F5B98">=</span></td>
<td><span style="color:#fbf80a">\reply2</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">5</span></td>
<td><span style="color:#3F5B98">\times</span></td>
<td><span style="color:#ec10ed">\v</span></td>
<td><span style="color:#3F5B98">=</span></td>
<td><span style="color:#fbf80a">\reply3</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">&darr;</span></td>
<td><span style="color:#3F5B98">&nbsp;&nbsp;</span></td>
<td><span style="color:#ec10ed">&darr;</span></td>
<td><span style="color:#3F5B98">&nbsp;&nbsp;</span></td>
<td><span style="color:#fbf80a">&darr;</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">\embed{reply4, 4}</span></td>
<td><span style="color:#3F5B98">\times</span></td>
<td><span style="color:#ec10ed">\embed{reply5, 4}</span></td>
<td><span style="color:#3F5B98">=</span></td>
<td><span style="color:#fbf80a">\embed{reply6, 4}</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">&darr;</span></td>
<td><span style="color:#3F5B98">&nbsp;&nbsp;</span></td>
<td><span style="color:#ec10ed">&darr;</span></td>
<td><span style="color:#3F5B98">&nbsp;&nbsp;</span></td>
<td><span style="color:#fbf80a">&darr;</span></td>
</tr>
<tr>
<td><span style="color:#cf3333">\embed{reply7, 4}</span></td>
<td><span style="color:#3F5B98">\times</span></td>
<td><span style="color:#ec10ed">\embed{reply8, 4}</span></td>
<td><span style="color:#3F5B98">=</span></td>
<td><span style="color:#fbf80a">\embed{reply9, 4}</span></td>
</tr>
</table>
<br />
<span style="text-decoration:underline">Conclusion :</span> A tout temps <span class="bold" style="color:#cf3333">x</span>
, on fait correspondre une distance de valeur : \embed{reply10, 4} .
 Vous définissez ainsi une fonction linéaire et vous écrivez :
 <span class="bold" style="color:#fbf80a">D(x)</span>=\embed{reply11, 4}
  </div>}

