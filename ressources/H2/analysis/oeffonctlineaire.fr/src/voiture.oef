\answer{En 1 Heure, la voiture parcourt }{\v }{type=numeric}
\answer{En 2 Heures, la voiture parcourt }{\v*2}{type=numeric}
\answer{En 5 Heures, la voiture parcourt }{\v*5}{type=numeric}

\answer{Le temps est }{<font color="#cf3333">Temps</span>}{type=dragfill}{option=shuffle nonstop}
\answer{Le coefficient est }{<font color="#ec10ed">\vi</span>}{type=dragfill}{option=shuffle  nonstop}
\answer{La distance est }{<font color="#fbf80a">Distance</span>}{type=dragfill}{option=shuffle nonstop}
\answer{L'inconnue est }{x}{type=nocase}{option=nonstop}
\answer{La constante est }{\vi}{type=numeric}{option=nonstop}
\answer{La distance parcourue est }{ D(x) }{type=algexp}{option=nonstop}
\answer{L'expression algébrique est }{\vi x}{type=algexp}{option=nonstop}
\answer{La fonction linéaire est }{\vi x}{type=algexp}{option=nonstop}

\answer{En 1 Heure, la voiture parcourt }{\v }{type=numeric}{option=nonstop}
\answer{En 2 Heures, la voiture parcourt }{\v*2}{type=numeric}{option=nonstop}
\answer{En 3 Heures, la voiture parcourt }{\v*3}{type=numeric}{option=nonstop}
\answer{En 4 Heure, la voiture parcourt }{\v*4 }{type=numeric}{option=nonstop}
\answer{En 5 Heures, la voiture parcourt }{\v*5}{type=numeric}{option=nonstop}
\answer{En 6 Heures, la voiture parcourt }{\v*6}{type=numeric}{option=nonstop}
\answer{En 7 Heure, la voiture parcourt }{\v*7 }{type=numeric}{option=nonstop}
\answer{En 8 Heures, la voiture parcourt }{\v*8}{type=numeric}{option=nonstop}

\answer{L'ordonnée du point A est }{\v }{type=numeric}{option=nonstop}
\answer{L'ordonnée du point B est }{\v*2}{type=numeric}{option=nonstop}
\answer{L'ordonnée du point C est }{\v*3}{type=numeric}{option=nonstop}
