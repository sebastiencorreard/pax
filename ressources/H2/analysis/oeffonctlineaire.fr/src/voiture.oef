\format{html}
\precision{10000}

\text{listereponse= wims(makelist r x for x = 33 to 67)} 

\matrix{STEP= reply1, reply2, reply3
reply4, reply5, reply6, reply7, reply8, reply9, reply10, reply11
reply12, reply13, reply14, reply15, reply16, reply17, reply18, reply19
reply20, reply21, reply22, reply23, reply24, reply25, reply26, reply27
reply28
reply29, reply30, reply31, reply32
