\computeanswer{no}
\format{html}
\precision{10000}

\matrix{STEP= reply1
reply2, reply3, reply4, reply5
reply6, reply7, reply8
}
\steps{\STEP}

\integer{jj=randint(1..2)}
\text{pe=proche,éloignée}
\text{ep=\jj=1 ? item(1,\pe),item(2,\pe):item(2,\pe),item(1,\pe)}

#Planete,ua,Mkm,s,s ou h, min,seconde ou heure,minute,axe x,axe y,a,tmin,tmax

\matrix{plan=MERCURE,0.39,58.5,195,3,15,secondes,minutes,50,10,0.3,3,3,5,25
VÉNUS,0.72,108,360,6,0,secondes,minutes,100,10,0.3,5,6,0,60
TERRE,1,150,500,8,20,secondes,minutes,100,20,0.3,8,8,0,60
MARS,1.52,228,760,12,40,secondes,minutes,100,50,0.3,12,13,0,60
JUPITER,5.2,780,2600,43,20,secondes,minutes,500,100,0.3,41,45,0,60
SATURNE,9.55,1432.5,1.3,1,20,heures,minutes,1,500,1080,1,1,8,32
URANUS,19.22,2883,2.8,2,40,heures,minutes,1,500,1080,2,2,28,52
NEPTUNE,30.11,4516.5,4.2,4,11,heures,minutes,1,500,1080,3,4,0,60}

\text{planete=\jj=1 ? \plan[;1]:NEPTUNE,URANUS,SATURNE,JUPITER,MARS,TERRE,VÉNUS,MERCURE}

\integer{kk=randint(1..8)}
\while{\kk=3}{\integer{kk=randint(1..8)}} 
##debug
integer{kk=7}

\text{size=200x50}
\text{symbol=  \( \frac {\plan[\kk;2] \times  150 } {1} ), \( \frac {\plan[\kk;2] \times  1} {150} )}

\text{droite=slib(graphpaper/func_milli 10,12,,,\plan[\kk;9],\plan[\kk;10],,,,\plan[\kk;11]*x,[],\listcoor,\tmpin,\AB)}
\text{axe=linewidth 1
text red,17,118,giant,  d en  millions de km
text red,80,6,giant,  t en \plan[\kk;7]}

\text{final=\droite \axe}


\text{urlfinal= draw(660,480
\final)}


\text{pro=Combien de temps la lumière met-elle pour arriver
 sur une planète du système solaire ?}
\text{enonce=On va déterminer simplement le temps du voyage de la
 lumière dans l'espace.}
\text{tableau=}

\text{B=slib(geo2D/jsxgraph jsxbox,660 x 840,
var board = JXG.JSXGraph.initBoard('jsxbox', {originX: 90, originY: 750, unitX: 60, unitY: 60, axis:false,shownavigation:false, grid:false});
var urlImg = "\urlfinal";
var im = board.create('image',[urlImg, [-1,-1], [10,12]]);
var dfu = board.createElement('point',[1,11.5], {name:'',face:'+', size:4});
var ffu = board.createElement('point',[4,11.5], {name:'',face:'+', size:4});
var liu = board.createElement('line',[dfu,ffu], 
 {straightFirst:false, straightLast:false, strokeWidth:2, lastArrow:true});
var dfd = board.createElement('point',[5,12.1], {name:'',face:'+', size:4});
var ffd = board.createElement('point',[5,11.2], {name:'',face:'+', size:4});
var lid = board.createElement('line',[dfd,ffd], 
 {straightFirst:false, straightLast:false, strokeWidth:2, lastArrow:true});
)}

\statement{
