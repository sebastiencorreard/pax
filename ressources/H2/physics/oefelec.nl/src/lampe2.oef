\title{Lampen en voltage II}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}

\real{n=randitem(3,6,9,12,24,36)}
nombre de lampes
\integer{m=randint(2..4)}
\text{choix=random(1,2,3)}
\text{m=\choix=3 ? 4}
\text{lamp=\(L_1)}
\for{i=2 to \m}
{\text{lamp=\lamp, \(L_\i)}}

choix 1 en parallèle :
\integer{rep=\choix=1? \n}
choix 2 en série :
\integer{rep=\choix=2? \m*\n}
choix 3 : en parallèles deux par deux
\integer{rep=\choix=3 ? \m*\n/2}

\text{circuit=2,0.5,0,0.5,0,5,5,5,5,0.5,3,0.5}
\text{couleur=orange}


\text{pos=\choix>1 ? 1,5,2,5}
\text{pos=\choix=1  ? 2,5,3,5}
\real{a=item(1,\pos)}
\real{b=item(2,\pos)}
\real{c=item(3,\pos)}
\real{d=item(4,\pos)}
\real{u=(\a+\c)/2}
\real{v=(\b+\d)/2}
\real{diam= ((\c-\a)^2+(\d-\b)^2)^(1/2)}
\text{R1=ellipse \u,\v,\diam,\diam,\couleur
line  \a,\b,\c,\d,\couleur
linewidth 5
line (3*(\a)+(\c))/4,(3*(\b)+(\d))/4,(3*(\c)+(\a))/4,(3*(\d)+(\b))/4, \couleur
linewidth 1}

\text{pos=\choix>1 ? 3,5,4,5}
\text{pos=\choix=1 ? 3,4,4,4}
\real{a=item(1,\pos)}
\real{b=item(2,\pos)}
\real{c=item(3,\pos)}
\real{d=item(4,\pos)}
\real{u=(\a+\c)/2}
\real{v=(\b+\d)/2}
\real{diam= ((\c-\a)^2+(\d-\b)^2)^(1/2)}
\text{R2=ellipse \u,\v,\diam,\diam,\couleur
line  \a,\b,\c,\d,\couleur
linewidth 5
line (3*(\a)+(\c))/4,(3*(\b)+(\d))/4,(3*(\c)+(\a))/4,(3*(\d)+(\b))/4, \couleur
linewidth 1}

\text{pos=\choix=2? 0,2.5,0,3.5}
\text{pos=\choix=1? 1,3,2,3}
\text{pos=\choix=3? 1,3,2,3}
\real{a=item(1,\pos)}
\real{b=item(2,\pos)}
\real{c=item(3,\pos)}
\real{d=item(4,\pos)}
\real{u=(\a+\c)/2}
\real{v=(\b+\d)/2}
\real{diam= ((\c-\a)^2+(\d-\b)^2)^(1/2)}
\text{R3=ellipse \u,\v,\diam,\diam,\couleur
line  \a,\b,\c,\d,\couleur
linewidth 5
line (3*(\a)+(\c))/4,(3*(\b)+(\d))/4,(3*(\c)+(\a))/4,(3*(\d)+(\b))/4, \couleur
linewidth 1}
\text{pos=\choix=2? 5,2.5,5,3.5}
\text{pos=\choix=1? 3,2,4,2}
\text{pos=\choix=3? 3,3,4,3}
\real{a=item(1,\pos)}
\real{b=item(2,\pos)}
\real{c=item(3,\pos)}
\real{d=item(4,\pos)}
\real{u=(\a+\c)/2}
\real{v=(\b+\d)/2}
\real{diam= ((\c-\a)^2+(\d-\b)^2)^(1/2)}
\text{R4=ellipse \u,\v,\diam,\diam,\couleur
line  \a,\b,\c,\d,\couleur
linewidth 5
line (3*(\a)+(\c))/4,(3*(\b)+(\d))/4,(3*(\c)+(\a))/4,(3*(\d)+(\b))/4, \couleur
linewidth 1}
\text{pos=2,0.5,3,0.5}
\real{a=item(1,\pos)}
\real{b=item(2,\pos)}
\real{c=item(3,\pos)}
\real{d=item(4,\pos)}
\real{u1=(\a+\c)/2}
\real{v=(\b+\d)/2}
\real{diam= ((\c-\a)^2+(\d-\b)^2)^(1/2)}
\text{gen=ellipse \u1,\v,\diam,\diam,black
text black, \u1-0.1,\v+0.2, medium, B
text black, \u1-1,\v,medium,+
text black, \u1+1,\v,medium,-}
\text{dessin=lines black ,\circuit
\gen
\R1
\R2}
\text{dessin=\choix=1?\dessin
lines black ,0,4,5,4}

\if{\m>=3}{
\text{dessin=\dessin
\R3}
\text{dessin=\choix=1 or \choix=3?\dessin
lines black ,0,3,5,3}
}
\if{\m>=4}{
\text{dessin=\dessin
\R4}
\text{dessin=\choix=1?\dessin
lines black ,0,2,5,2}
}

\statement{De lampen \lamp zijn bedoeld voor \n Volts. <br>
Ze branden normaal, en hebben dus de goede spanning. 
<center>\draw{200,200}
{transparent white
xrange -2,7
yrange -2,7
\dessin
}
</center>
Welke spanning geeft de batterij \(B)? 

}

\answer{Spanning van de Batterij}{\rep V}{type=units}
