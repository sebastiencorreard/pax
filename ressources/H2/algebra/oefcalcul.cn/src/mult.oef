\title{有符号数的相乘}
\language{cn}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=random(2..10)*random(1,-1)}
\text{n=\n >0 ? +\n}
\integer{m=random(2..10)*random(1,-1)}
\text{m=\m >0 ? +\m}
\integer{p=random(2..10)*random(1,-1)}
\text{p=\p >0 ? +\p}
\integer{sol= \n*(\m)*(\p)}
\text{sol = \sol>0 ? +\sol}


\statement{计算 : 
<center> \((\n)\times (\m)\times (\p))= \embed{reply 1, 12} 
</center>}
\answer{}{\sol}{type=numeric}
