val29=
tmp0=!replace internal \over by / in $val25,$val26,$val27,$val28,\o5,\o6

val30=$(tmp0)
tmp0=!text select /1234567890, in $val30

val30=$(tmp0)
t_=!replace internal \( by ( in ($(val30[1]))-($(val30[2]))
tmp0=!exec pari $t_

val31=$(tmp0)
