val17=
tmp0=!itemcnt $val8

!for val10 =1 to $(tmp0) 
!if $(val16[$val10])>0 
val18=$(val9[$val10;1..$(val16[$val10])])
tmp0=!append item $val18 to $val17

val17=$(tmp0)
!endif
!next
tmp0=!itemcnt $val17

val19=$[rint($(tmp0))]
val20=
!for val21  in $val17 
tmp0=!replace internal / by \over in $val21

val18=$(tmp0)
