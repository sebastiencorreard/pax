 !exit
!endif

tmp0=!randint 1, 20

val6=$[rint($(tmp0))]
tmp0=!randint 1, 20

val7=$[rint($(tmp0))]
tmp0=!randitem 2,3,4,5

val8=$[rint($(tmp0))]
val9=$[rint($val6 * $val8)]
val10=$[rint($val7 * $val8)]
val11=$[rint(gcd($val9,$val10))]
tmp=!translate ";': to $     $ in $val9 / $val10

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val12=!exec pari print($t_)
replytype1=litexp
replyname1=
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

