!set title=Comparer deux nombres
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 120

val6=$[rint($(tmp0))]
tmp0=!randint 10, 120

val7=$[rint($(tmp0))]
t_=!rawmath $val6/$val7
val8=!exec pari print($t_)
tmp0=!randint 10, 120

val9=$[rint($(tmp0))]
tmp0=!randint 10, 120

val10=$[rint($(tmp0))]
t_=!rawmath $val9/$val10
val11=!exec pari print($t_)
val12=\frac{$val6}{$val7}
val13=\frac{$val9}{$val10}
!if  $val8>$val11 
val14=>
!endif
!if  $val8<$val11 
val14=<
!endif
!if  $val8=$val11 
val14==
!endif
replytype1=dragfill
replyname1=
replygood1=$val14;<,>,=
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compléter la réponse avec le signe mathématique (<, > ou =) qui convient :	<div>	On considère les nombres : 
!insmath A=$val12 
$() et 
!insmath B=$val13
$()<br/>	On a : 
!insmath A
$()  
!read oef/embed.phtml r1,20 
$() 
!insmath B
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13
embedcnt=1
