!set title=Economies
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r,r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem 6,10,12,15

val6=$[rint($(tmp0))]
!readproc slib/stat/posdiscretelaw 3,$val6,Q 
tmp0=$slib_out
val7=$(tmp0)
!readproc slib/lang/fname fr, 
tmp0=$slib_out
val8=$(tmp0)
tmp0=!randitem son argent de poche, l'argent donné par ses parents, ses économies

val9=$(tmp0)
tmp0=!randitem des loisirs, des jeux, des livres, des disques, des basckets

val10=$(tmp0)
tmp0=!randitem des bonbons, des friandises, un repas au fast-food, une crêpe au nutella

val11=$(tmp0)
t_=!rawmath $(val7[1])+$(val7[2])
val12=!exec pari print($t_)
t_=!rawmath $(val7[3])
val13=!exec pari print($t_)
replytype1=litexp
replyname1=
replygood1=$val12
replytype2=litexp
replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%;">		$val8 a dépensé 
!insmath $(val7[1])
$() de $val9 pour $val10, et $(val7[2]) pour $val11.	<ul><li>	Quelle est la part de budget dépensée :  
!read oef/embed.phtml r1,10 
$()	</li><li>	Quelle est la part de budget qui reste :  
!read oef/embed.phtml r2,10 
$()	</li></ul>	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,11
embedcnt=2
