!set title=Décomposition a+b/c
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 11, 99

val6=$[rint($(tmp0))]
tmp0=!randint 2, 9

val7=$[rint($(tmp0))]
val8=\(\frac{$val6}{$val7})
t_=!replace internal \( by ( in divide($val6,$val7)
tmp0=!exec maxima $t_

val9=$(tmp0)
!if $(val9[2])=0 
val10=$val8=$(val9[1])
!else
val10=$val8=$(val9[1])+$(val9[2])/ $val7
!endif
tmp0=!randint 11, 99

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
val13=\(\frac{$val11}{$val12})
t_=!replace internal \( by ( in divide($val11,$val12)
tmp0=!exec maxima $t_

val14=$(tmp0)
!if $(val14[2])=0 
val15=$(val14[1])
!else
val15=$(val14[1])+$(val14[2])/ $val12
!endif
replytype1=litexp
replyname1=
replygood1=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Écrire la fraction sous la forme d'un nombre entier ou sous la forme d'une	somme d'un entier et d'une fraction inférieure à 1.	<br/> Par exemple $val10	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">	On donne la fraction $val13. On peut donc l'écrire sous la forme :  
!read oef/embed.phtml r1,20 
$()	</div>
$()
!exit

