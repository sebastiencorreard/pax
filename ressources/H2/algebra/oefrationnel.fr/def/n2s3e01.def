!set title=Produit à l'aide des décimaux
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r,r,r,r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 999

val6=$[rint($(tmp0))]
tmp0=!randitem 10,100,1000

val7=$[rint($(tmp0))]
tmp0=!randint 1, 999

val8=$[rint($(tmp0))]
tmp0=!randitem 10,100,1000

val9=$[rint($(tmp0))]
val10=\(\frac{$val8}{$val9})
val11=\(\frac{$val6}{$val7})
val12=$[$val6/$val7]
val13=$[$val8/$val9]
val14=$[$val13 * $val12]
val15=$[rint($val7*$val9)]
val16=$[$val14 * $val15]
oefsteps=reply1,reply2	reply3	reply4 
nextstep=!nosubst reply1,reply2	reply3	reply4 
!readproc oef/steps.proc
replytype1=algtexp

replyname1=$val10
replygood1=$val13
replytype2=algexp
replyname2=$val11
replygood2=$val12
replytype3=algexp
replyname3=\C
replygood3=$val14
replytype4=algexp
replyname4=
replygood4=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Complète les calculs suivants en passant par l'écriture décimale. On a  :	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">	
!if $m_step=1 
$()	<table>	 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val10 
!insmath times
$() $val11 </td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td> 
!read oef/embed.phtml r1,6 
$() 
!insmath times
$()  
!read oef/embed.phtml r2,6 
$()</td></tr>	</table> 
!endif
$()		
!if $m_step=2 
$()	<table>	 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val10 
!insmath times
$() $val11 </td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val13 
!insmath times
$() $val12</td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td> 
!read oef/embed.phtml r3,6 
$()</td></tr>	</table>	 
!endif
$()		
!if $m_step=3 
$()	<table>	 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val10 
!insmath times
$() $val11 </td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val13 
!insmath times
$() $val12</td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td>$val14</td></tr>		 <tr><td>
!insmath C
$() </td>	 <td> =   </td>	 <td><sup> 
!read oef/embed.phtml r4,6 
$()</sup> / <sub>$val15</sub></td></tr>	</table>	 
!endif
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,12,13,14,15
embedcnt=4
