 !exit
!endif

tmp0=!randitem 2,3,5,7,11

val6=$[rint($(tmp0))]
tmp0=!randint 1, 70

val7=$[rint($(tmp0)*$val6)]
tmp0=!randint 1, 70

val8=$[rint($(tmp0)*$val6)]
val9=\( \frac{$val7}{$val8} )
tmp=!translate ";': to $     $ in $val7 / $val8

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
t_=!rawmath $(tmp0)
val10=!exec pari print($t_)
replytype1=litexp
replyname1=
replygood1=$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

