!set title=Comparons à un entier
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 10, 120

val6=$[rint($(tmp0))]
tmp0=!randint 10, 120

val7=$[rint($(tmp0))]
tmp0=!randitem 2,3

val8=$[rint($(tmp0))]
t_=!rawmath $val6/$val7
val9=!exec pari print($t_)
val10=\frac{$val6}{$val7}
!if  $val9>$val8 
val11=$[rint(1)]
!endif
!if  $val9<$val8 
val11=$[rint(2)]
!endif
!if  $val9=$val8 
val11=$[rint(3)]
!endif
replytype1=click
replyname1=
replygood1=$val11;Ce nombre est plus grand que $val8,<br/>Ce nombre est plus petit que $val8,<br/>Ce nombre est égal à $val8
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dire si le nombre proposé est plus grand ou plus petit que $val8, en cliquant sur la bonne réponse.	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">		On considère le nombre : 
!insmath A=$val10 
$()<br/> 
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=8,10
embedcnt=1
