!set title=Comparons à 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=9
prevarcnt=8
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 100

val6=$[rint($(tmp0))]
tmp0=!randint 1, 100

val7=$[rint($(tmp0))]
t_=!rawmath $val6/$val7
val8=!exec pari print($t_)
val9=$val6/$val6
tmp0=!randitem $val8,$val8,$val8,$val8,$val8,$val9

val10=$(tmp0)
!if  $val10>1 
val11=$[rint(1)]
!endif
!if  $val10<1 
val11=$[rint(2)]
!endif
!if  $val10=1 or $val10=$val9 
val11=$[rint(3)]
!endif
replytype1=click
replyname1=
replygood1=$val11;Ce nombre est plus grand que 1,<br/>Ce nombre est plus petit que 1,<br/>Ce nombre est égal à 1
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Dire si le nombre proposé est plus grand ou plus petit que 1, en cliquant sur la bonne réponse.	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">		On considère le nombre : $val10 <br/> 
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

