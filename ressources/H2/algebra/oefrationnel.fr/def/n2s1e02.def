!set title=Comparer deux fractions à 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 500

val6=$[rint($(tmp0))]
tmp0=!randint 501, 1000

val7=$[rint($(tmp0))]
tmp0=!randint 2, 500

val8=$[rint($(tmp0))]
tmp0=!randint 501, 1000

val9=$[rint($(tmp0))]
t_=!rawmath $val6/$val7
val10=!exec pari print($t_)
val11=$val9/$val8
val12=$[$val10-$val11]
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]
!if $val13=1 
val14=\frac{$val6}{$val7}
val15=\frac{$val9}{$val8}
!else
val15=\frac{$val6}{$val7}
val14=\frac{$val9}{$val8}
!endif
!if $val12<0 and $val13=1 
val16=$[rint(3)]
!endif
!if $val12=0 
val16=$[rint(2)]
!endif
!if $val12>0 and $val13=1 
val16=$[rint(1)]
!endif
!if $val12<0 and $val13=2 
val16=$[rint(1)]
!endif
!if $val12>0 and $val13=2 
val16=$[rint(3)]
!endif
replytype1=click
replyname1=
replygood1=$val16;\(A) est plus grand que \(B), <br/> \(A) est égal à \(B), <br/> \(A) est plus petit que \(B)
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()En comparant mentalement les deux fractions à 1, dire laquelle est la plus grande.	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">		On considère les deux nombres 
!insmath A=$val14
$() et 
!insmath B=$val15
$() <br/> 
!read oef/embed.phtml r1 
$()	</div>
$()
!exit

