val8=$[rint($(tmp0))]
tmp0=!randint 2, 15

val9=$[rint($(tmp0))]
tmp0=!randitem -,+

val10=$(tmp0)
val11=$[rint(gcd($val7,$val9))]
!if $val11<>1 
val9=$[rint(5)]
tmp0=!randitem 2,3,6,7,8

val7=$[rint($(tmp0))]
!endif
val12=$[$val6 / $val7 - $val8 / $val9]
!if $val12<0 
val13=$[rint($val6)]
val14=$[rint($val7)]
val6=$[rint($val8)]
val7=$[rint($val9)]
val8=$[rint($val13)]
val9=$[rint($val14)]
!endif
t_=!rawmath $val6 / $val7 $val10 $val8 / $val9
val15=!exec pari print($t_)
val16=$[rint($val9)]
val17=$[rint($val7)]
val18=$[rint($val9)]
val19=$[rint($val7)]
val20=$[rint($val6 * $val9)]
val21=$[rint($val8 * $val7)]
val22=$[rint($val9 * $val7)]
val23=$[rint($val9 * $val7)]
val24=$[rint($val20 $val10 $val21)]
val25=$[rint($val22)]
t_=!rawmath $val15
val26=!exec pari print($t_)
