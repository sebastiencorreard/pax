!set title=Sommes de fractions de même dénominateur
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 40, 100

val6=$[rint($(tmp0))]
tmp0=!randitem +,-

val7=$(tmp0)
!if $val7 = + 
tmp0=!randint 1, 100

val8=$[rint($(tmp0))]
!endif
!if $val7 = - 
tmp0=!randint 1, 40

val8=$[rint($(tmp0))]
!endif
tmp0=!randint 1, 100

val9=$[rint($(tmp0))]
val10=$[rint($val6 $val7 $val8)]
val11=$[rint(gdc($val10,$val9))]
val12=$[rint($val10)]
t_=!rawmath ($val10 / $val9)
val13=!exec pari print($t_)
replytype1=litexp
replyname1=
replygood1=$val12
replytype2=litexp
replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Donne la fraction irréductible :	<div style="text-align : center;	background-color : #FFFFF0;	padding : 1%;	margin : 5% 15%; ">		
!if $val11=0 
$()	<table class="wimscenter wimsnoborder">	 <tr><td> $val6 </td>	  <td>     </td>	  <td> $val8 </td>	  <td> </td>	  <td>  
!read oef/embed.phtml r1,6 
$() </td></tr>	 <tr><td> <hr/> </td>	  <td>  $val7    </td>	  <td> <hr/> </td>	  <td> =   </td>	  <td> <hr/> </td> </tr>	 <tr><td> $val9 </td>	  <td>     </td>	  <td> $val9   </td>	  <td>     </td>	  <td> $val9  </td></tr>	</table> 
!endif
$()		
!if $val11<>0 
$()	<table class="wimscenter wimsnoborder">	 <tr><td> $val6 </td>	  <td>     </td>	  <td> $val8 </td>	  <td> </td>	  <td>  
!read oef/embed.phtml r1,6 
$() </td>	  <td> </td></tr>	 <tr><td> <hr/> </td>	  <td>  $val7    </td>	  <td> <hr/> </td>	  <td> =   </td>	  <td> <hr/> </td>	  <td> =  
!read oef/embed.phtml r2,6 
$()</td> </tr>	 <tr><td> $val9 </td>	  <td>     </td>	  <td> $val9   </td>	  <td>     </td>	  <td> $val9  </td>	  <td> </td></tr>	</table>	 
!endif
$()	</div>	
$()
!exit

:hint
$()
$()
!exit

