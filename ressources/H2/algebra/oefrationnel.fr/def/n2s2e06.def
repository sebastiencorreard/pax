!set title=Sommes fractions dénom. différents
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
author=Jean-Baptiste, Frondas
oefobservation=Exercices pour le début de la cinquieme avec des positifs

ansorder=r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 15

val7=$[rint($(tmp0))]
tmp0=!randint 1, 20

val8=$[rint($(tmp0))]
tmp0=!randint 2, 15

val9=$[rint($(tmp0))]
tmp0=!randitem -,+

val10=$(tmp0)
val11=$[rint(gcd($val7,$val9))]
!if $val11<>1 
val9=$[rint(5)]
tmp0=!randitem 2,3,6,7,8

val7=$[rint($(tmp0))]
!endif
val12=$[$val6 / $val7 - $val8 / $val9]
!if $val12<0 
val13=$[rint($val6)]
val14=$[rint($val7)]
val6=$[rint($val8)]
val7=$[rint($val9)]
val8=$[rint($val13)]
val9=$[rint($val14)]
!endif
t_=!rawmath $val6 / $val7 $val10 $val8 / $val9
val15=!exec pari print($t_)
val16=$[rint($val9)]
val17=$[rint($val7)]
val18=$[rint($val9)]
val19=$[rint($val7)]
val20=$[rint($val6 * $val9)]
val21=$[rint($val8 * $val7)]
val22=$[rint($val9 * $val7)]
val23=$[rint($val9 * $val7)]
val24=$[rint($val20 $val10 $val21)]
val25=$[rint($val22)]
t_=!rawmath $val15
val26=!exec pari print($t_)
replytype1=numexp
replyname1=
replygood1=$val26
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Effectuer le calcul proposé, on donnera le résultat sous la forme d'une fraction irréductible :		<table class="wimscenter wimsnoborder">	  <tr><td>       </td>	    <td>$val6  </td>	    <td>       </td>	    <td> $val8 </td></tr>	  <tr><td> A =   </td>	    <td> <hr/> </td>	    <td> $val10 </td>	    <td> <hr/> </td></tr>	  <tr><td>         </td>	    <td> $val7 </td>	    <td>         </td>	    <td> $val9 </td></tr>	</table>		Donner la fraction simplifiée, si la fraction est irréductible, la recopier.	<table class="wimscenter wimsnoborder">	  <tr><td> A = </td>	  <td>  
