\title{Sommes de fractions de même dénominateur}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(40..100)}
\text{sign=random(+,-)}
\if{\sign = +}{\integer{b=random(1..100)}}
\if{\sign = -}{\integer{b=random(1..40)}}

\integer{denom=random(1..100)}

\integer{num=\a \sign \b}

\integer{comm=gdc(\num,\denom)}

\integer{rep1=\num}
\rational{rep2=(\num / \denom)}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Donne la fraction irréductible :
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

\if{\comm=0}{
<table class="wimscenter wimsnoborder">
	<tr><td> \a </td>
		<td>     </td>
		<td> \b </td>
		<td>	</td>
		<td> \embed{r1,6} </td></tr>
	<tr><td> <hr/> </td>
		<td>  \sign    </td>
		<td> <hr/> </td>
		<td> = 		</td>
		<td> <hr/> </td> </tr>
	<tr><td> \denom </td>
		<td>     </td>
		<td> \denom   </td>
		<td>     </td>
		<td> \denom  </td></tr>
</table>}

\if{\comm<>0}{
<table class="wimscenter wimsnoborder">
	<tr><td> \a </td>
		<td>     </td>
		<td> \b </td>
		<td>	</td>
		<td> \embed{r1,6} </td>
		<td> </td></tr>
	<tr><td> <hr/> </td>
		<td>  \sign    </td>
		<td> <hr/> </td>
		<td> = 		</td>
		<td> <hr/> </td>
		<td> = \embed{r2,6}</td> </tr>
	<tr><td> \denom </td>
		<td>     </td>
		<td> \denom   </td>
		<td>     </td>
		<td> \denom  </td>
		<td> </td></tr>
</table>
}
</div>
}


%%%%%%%
\answer{}{\rep1}{type=litexp}
\answer{}{\rep2}{type=litexp}
