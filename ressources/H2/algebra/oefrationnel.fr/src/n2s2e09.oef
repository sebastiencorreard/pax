\title{Palmarès}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{n=random(5..20)}
\text{proba=slib(stat/posdiscretelaw 3,\n,Q)}

\text{prena=random(Sophie, Alexandra, Marie, Anne, Judith, Augustine)}
\text{prenb=random(Florence, Justine, Gaëlle, Élodie, Guillemette, Anna)}
\text{prenc=random(Patricia, Corinne, Magali, Laure, Armelle, Laurence)}

\rational{rep1=maxima(max(\proba[1],\proba[2],\proba[3]))}

\if{\rep1=\proba[1] and \proba[1]<>\proba[2] and  \proba[1]<>\proba[3]}{\text{rep=\prena}}
\if{\rep1=\proba[1] and \proba[1]=\proba[2]  and  \proba[1]<>\proba[3]}{\text{rep=\prena,\prenb}}
\if{\rep1=\proba[1] and \proba[1]<>\proba[2] and  \proba[1]=\proba[3]}{\text{rep=\prena,\prenc}}
\if{\rep1=\proba[1] and \proba[1]=\proba[2]  and  \proba[1]=\proba[3]}{\text{rep=\prena,\prenb,\prenc}}
\if{\rep1=\proba[2] and \proba[2]<>\proba[1] and  \proba[2]<>\proba[3]}{\text{rep=\prenb}}
\if{\rep1=\proba[2] and \proba[2]<>\proba[1] and  \proba[2]=\proba[3]}{\text{rep=\prenb,\prenc}}
\if{\rep1=\proba[3] and \proba[3]<>\proba[1] and  \proba[3]<>\proba[2]}{\text{rep=\prenc}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

À l'élection de <i>Miss Math</i>, \prena a remporté \proba[1] des suffrages, \prenb \proba[2] et \prenc tous les autres. Qui a été élue ?
</div>
<div class="wims_instruction">
Pour les ex aequo, mettre les prénoms des élues dans le même ordre que celui de l'énoncé,
séparés par des virgules.
</div>}

Solutions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\solution{Pour calculer combien \prenc a remporté de voix, on fait \(1-\proba[1]-\proba[2]=\proba[3]). Celle qui a le plus de suffrage est \rep, qui a obtenu \rep1 des voix}

Aide
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\help{Il faut calculer combien \prenc a remporté de voix}

%%%%%%%
\answer{Personne élue}{\rep}{type=text}
