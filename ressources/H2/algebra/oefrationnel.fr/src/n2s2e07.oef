\title{Simplifier -III}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\integer{n=random(2,3,5,7,11)}
\integer{a=random(1..70)*\n}
\integer{b=random(1..70)*\n}

\text{enonce=\( \frac{\a}{\b} )}

\rational{rep1=simplify(\a / \b)}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Donner la fraction irréductible :
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

On donne A = \enonce. La fraction irréductible est : A = \embed{r1,10}
</div>}

%%%%%%%
\answer{}{\rep1}{type=litexp}
