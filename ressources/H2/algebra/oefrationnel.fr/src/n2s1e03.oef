\title{Comparons à un entier}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(10..120)}
\integer{b=random(10..120)}
\integer{c=random(2,3)}

\rational{d=\a/\b}
\text{A=\frac{\a}{\b}}
\if{ \d>\c}{\integer{rep=1}}
\if{ \d<\c}{\integer{rep=2}}
\if{ \d=\c}{\integer{rep=3}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Dire si le nombre proposé est plus grand ou plus petit que \c, en cliquant sur la bonne réponse.
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

On considère le nombre : \(A=\A )<br/>\embed{r1}
</div>}
%%%%%%%
\answer{}{\rep;Ce nombre est plus grand que \c,<br/>Ce nombre est plus petit que \c,<br/>Ce nombre est égal à \c}{type=click}
