\title{Comparer deux fractions à 1}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(2..500)}
\integer{b=random(501..1000)}
\integer{c=random(2..500)}
\integer{d=random(501..1000)}
\rational{e=\a/\b}
\text{f=\d/\c}

\real{diff=\e-\f}

\integer{choix=random(1,2)}
\if{\choix=1}{\text{A=\frac{\a}{\b}} and \text{B=\frac{\d}{\c}}}{\text{B=\frac{\a}{\b}} and \text{A=\frac{\d}{\c}}}

\if{\diff<0 and \choix=1}{\integer{rep=3}}
\if{\diff=0}{\integer{rep=2}}
\if{\diff>0 and \choix=1}{\integer{rep=1}}
\if{\diff<0 and \choix=2}{\integer{rep=1}}
\if{\diff>0 and \choix=2}{\integer{rep=3}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{En comparant mentalement les deux fractions à 1, dire laquelle est la plus grande.
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

On considère les deux nombres \(A=\A) et \(B=\B) <br/>\embed{r1}
</div>}
%%%%%%%
\answer{}{\rep;\(A) est plus grand que \(B), <br/> \(A) est égal à \(B), <br/> \(A) est plus petit que \(B)}{type=click}
