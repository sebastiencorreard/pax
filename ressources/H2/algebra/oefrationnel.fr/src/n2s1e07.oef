\title{Décomposition a+b/c}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{p1=random(11..99)}
\integer{q1=random(2..9)}

\text{fraction1=\(\frac{\p1}{\q1})}
\text{resultat1=maxima(divide(\p1,\q1))}

\if{\resultat1[2]=0}{\text{exemple=\fraction1=\resultat1[1]}}{\text{exemple=\fraction1=\resultat1[1]+\resultat1[2]/ \q1}}

\integer{p=random(11..99)}
\integer{q=random(2..9)}

\text{fraction=\(\frac{\p}{\q})}
\text{resultat=maxima(divide(\p,\q))}

\if{\resultat[2]=0}{\text{sol=\resultat[1]}}{\text{sol=\resultat[1]+\resultat[2]/ \q}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Écrire la fraction sous la forme d'un nombre entier ou sous la forme d'une
somme d'un entier et d'une fraction inférieure à 1.
<br/> Par exemple \exemple
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">
On donne la fraction \fraction. On peut donc l'écrire sous la forme : \embed{r1,20}
</div>}
%%%%%%%
\answer{}{\sol}{type=litexp}
