\title{Ranger les fractions (3  fractions)}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\text{liste= 1/16 , 1/8 , 3/16 , 1/4 , 5/16 , 3/8 , 7/16 , 1/2 , 9/16 , 5/8 , 11/16 , 7/8 , 15/16 , 2/2 , 9/8 , 14/12 , 11/8 , 3/2 , 13/8 , 7/4 , 15/8 , 8/4 , 9/4 , 5/2 , 11/4 , 6/2 , 13/4 , 7/2 , 15/4 , 8/2 , 9/2 , 10/2 , 11/2 , 12/2 , 13/2 , 15/2 , 16/2 }

\integer{a=random(1..13)}
\integer{b=random(14..27)}
\integer{c=random(28..37)}


\text{choix=\liste[\a],\liste[\b],\liste[\c]}

\text{sign=random(<,>)}

\if{\sign = >}{\text{choix=\liste[\c],\liste[\b],\liste[\a]}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Ranger les fractions dans l'ordre demandé :
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">
Le classement est : <br/><br/><br/>
\embed{r1,40} \sign \embed{r2,40} \sign \embed{r3,40} </div>}
%%%%%%%
\answer{}{\choix[1];\choix}{type=clickfill}
\answer{}{\choix[2];\choix}{type=clickfill}
\answer{}{\choix[3];\choix}{type=clickfill}
