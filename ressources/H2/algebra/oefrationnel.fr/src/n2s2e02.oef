\title{Simplifications - I}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(1..20)}
\integer{b=random(1..20)}

\integer{n=random(2,3,4,5)}

\integer{aa=\a * \n}
\integer{bb=\b * \n}

\integer{comm=gcd(\aa,\bb)}

\integer{rep1=\aa / \comm}
\integer{rep2=\bb / \comm}

\integer{popo=random(1,2)}
\if{\popo = 1}{\integer{rep3=\rep2}}{\integer{rep3=\rep1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Complète afin de trouver une écriture simplifiée de chacune des fractions :

<table class="wimscenter wimsnoborder">
\if{\popo = 1}{	<tr><td> \aa </td>
		<td>     </td>
		<td>\comm \(\times) \embed{r1,6} </td>
		<td>     </td>
		<td> \rep1 </td></tr>}
		{<tr><td> \aa </td>
		<td>     </td>
		<td>\comm \(\times) \embed{r1,6} </td>
		<td>     </td>
		<td> \embed{r3,6} </td></tr>}
	<tr><td> <hr/> </td>
		<td>  =    </td>
		<td> <hr/> </td>
		<td>  =    </td>
		<td> <hr/> </td></tr>

\if{\popo = 1}{	<tr><td> \bb </td>
		<td>     </td>
		<td>\comm \(times) \embed{r2,6}</td>
		<td>    </td>
		<td> \embed{r3,6} </td></tr>}
		{<tr><td> \bb </td>
		<td>     </td>
		<td>\comm \(times) \embed{r2,6}</td>
		<td>    </td>
		<td> \rep2 </td></tr>}
</table>
}


%%%%%%%
\answer{}{\rep1}{type=numeric}
\answer{}{\rep2}{type=numeric}
\answer{}{\rep3}{type=numeric}
