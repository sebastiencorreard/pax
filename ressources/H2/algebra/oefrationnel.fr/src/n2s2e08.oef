\title{Economies}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{n=random(6,10,12,15)}
\text{proba=slib(stat/posdiscretelaw 3,\n,Q)}
\text{prenom=slib(lang/fname fr,)}
\text{argent=random(son argent de poche, l'argent donné par ses parents, ses économies)}
\text{loisir=random(des loisirs, des jeux, des livres, des disques, des basckets)}
\text{friandises=random(des bonbons, des friandises, un repas au fast-food, une crêpe au nutella)}

\rational{rep1=\proba[1]+\proba[2]}
\rational{rep2=\proba[3]}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%;">

\prenom a dépensé \(\proba[1]) de \argent pour \loisir, et \proba[2] pour \friandises.
<ul><li>
Quelle est la part de budget dépensée : \embed{r1,10}
</li><li>
Quelle est la part de budget qui reste : \embed{r2,10}
</li></ul>
</div>}

%%%%%%%
\answer{}{\rep1}{type=litexp}
\answer{}{\rep2}{type=litexp}
