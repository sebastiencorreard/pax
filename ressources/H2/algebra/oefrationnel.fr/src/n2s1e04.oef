\title{Comparer deux nombres}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(10..120)}
\integer{b=random(10..120)}
\rational{c=\a/\b}

\integer{d=random(10..120)}
\integer{e=random(10..120)}
\rational{f=\d/\e}

\text{A=\frac{\a}{\b}}
\text{B=\frac{\d}{\e}}

\if{ \c>\f}{\text{rep=>}}
\if{ \c<\f}{\text{rep=<}}
\if{ \c=\f}{\text{rep==}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Compléter la réponse avec le signe mathématique (<, > ou =) qui convient :
<div>
On considère les nombres : \(A=\A ) et \(B=\B)<br/>
On a : \(A) \embed{r1,20} \(B)
</div>
}
%%%%%%%
\answer{}{\rep;<,>,=}{type=dragfill}
