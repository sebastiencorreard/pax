\title{Comparons à 1}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



\integer{a=random(1..100)}
\integer{b=random(1..100)}
\rational{d=\a/\b}
\text{e=\a/\a}

\text{c=random(\d,\d,\d,\d,\d,\e)}
\if{ \c>1}{\integer{rep=1}}
\if{ \c<1}{\integer{rep=2}}
\if{ \c=1 or \c=\e}{\integer{rep=3}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Dire si le nombre proposé est plus grand ou plus petit que 1, en cliquant sur la bonne réponse.
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">

On considère le nombre : \c <br/>\embed{r1}
</div>}
%%%%%%%
\answer{}{\rep;Ce nombre est plus grand que 1,<br/>Ce nombre est plus petit que 1,<br/>Ce nombre est égal à 1}{type=click}
