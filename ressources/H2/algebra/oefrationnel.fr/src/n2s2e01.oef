\title{Addition à l'aide des décimaux}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
\observation{Exercices pour le début de la cinquieme avec des positifs}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\integer{a=random(1..999)}
\integer{b=random(10,100,1000)}
\integer{c=random(1..999)}
\integer{d=random(10,100,1000)}
\text{sign=random(+,-)}

\if{\a/\b-\c/\d<0}{\text{A=\(\frac{\c}{\d})} and \text{B=\(\frac{\a}{\b})} }
\if{\a/\b-\c/\d<0}{\real{res1=\c / \d} and \real{res2= \a / \b} }

\if{\a/\b-\c/\d>0}{\text{B=\(\frac{\c}{\d})} and \text{A=\(\frac{\a}{\b})} }
\if{\a/\b-\c/\d>0}{\real{res2=\c / \d} and \real{res1= \a / \b} }

\real{fin=\res1 \sign \res2}

\integer{comm=max(\b,\d)}
\real{num=\fin * \comm}

\steps{reply1,reply2
reply3
reply4}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{
Complète les calculs suivants en passant par l'écriture décimale. On a  :
<div style="text-align : center;
background-color : #FFFFF0;
padding : 1%;
margin : 5% 15%; ">
\if{\step=1}{
<table>
	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\A \sign \B </td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\embed{r1,6} \sign \embed{r2,6}</td></tr>
</table>}


\if{\step=2}{
<table>
	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\A \sign \B </td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\res1 \sign \res2</td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\embed{r3,6}</td></tr>
</table>
}

\if{\step=3}{
<table>
	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\A \sign \B </td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\res1 \sign \res2</td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td>\fin</td></tr>

	<tr><td>\(C) </td>
	<td> =   </td>
	<td><sup>\embed{r4,6}</sup> / <sub>\comm</sub></td></tr>
</table>
}
</div>
}
%%%%%%%
\answer{\A}{\res1}{type=algtexp}
\answer{\B}{\res2}{type=algexp}
\answer{\C}{\fin}{type=algexp}
\answer{}{\num}{type=algexp}
