!set title=Signo de un producto
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Bernadette, Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=c
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 5, 20

val6=$[rint($(tmp0))]
tmp0=!randint 3, $val6

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$(tmp0)
val9=positivo,négativo
tmp0=!item $val8 of négativos, positivos

val10=$(tmp0)

!ifval $val8=1 
val11=$[rint( $val7)]
!else
val11=$[rint( $val6-$val7)]
!endif

!ifval (-1)^($val11)=1
tmp0=!item 1 of $val9

val12= $(tmp0)
!else
tmp1=!item 2 of $val9

val12= $(tmp1)
!endif
choicename1=Signe
choicegood1=$val12
choicebad1=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()El signo de un producto de  $val6 factores no nulos que implican exactamente $val7 factores $val10 	es 
!read oef/embed.phtml choice 1 
$().  	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,10
embedcnt=1
