!set title=Prioridades y cálculo
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

val6=$(tmp0)
tmp0=!randint 2, 10

val7=$(tmp0)
tmp0=!randint 3, 10

val8=$(tmp0)
val9=$val6 más $val7 multiplicado por $val8,	$val6 más $val7 luego multiplica por $val8,	$val6 más $val7 que en primer lugar multiplicó por $val8,	$val6 multiplicado por $val7 más $val8,	$val6 multiplicado por la suma de $val7 y $val8,	$val6 más $val7 dividido por $val8,	$val6 más $val7 que en primer lugar se dividió por $val8,	$val6 luego divide por $val7 más $val8 ,	$val6 dividido por $val7 más $val8,	$val6 más $val7 luego divide por $val8,	$val6 dividido por $val7 luego añade $val8	
val10=\(\quad $val6 + $val7 \times $val8\quad  ;),	\(\quad ($val6 + $val7) \times $val8\quad  ;),	\(\quad $val6 \times$val7 + $val8\quad  ;),	\(\quad $val6 \times ($val7+ $val8)\quad  ;),	\(\quad $val6 + \frac{$val7}{$val8}\quad  ;),	\(\quad \frac{$val6 + $val7}{$val8}\quad  ;),	\(\quad \frac{$val6}{$val7+$val8}\quad  ;),	\(\quad \frac{$val6 }{$val7} +$val8\quad  ;)	
tmp=!trim $(val10[1]), $(val10[2])| $(val10[2]),$(val10[1])	$(val10[2])	$(val10[1])	$(val10[3]), $(val10[4])| $(val10[4]),$(val10[3])	$(val10[4])	$(val10[5]),$(val10[6])|$(val10[6]),$(val10[5])	$(val10[5])	$(val10[7]) 	$(val10[8]),$(val10[7])|$(val10[7]),$(val10[8])	$(val10[6])	$(val10[8])	
val11=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2

val12=$(tmp0)

!ifval $val12=1 
tmp0=!randint 1, 5

val13= $(tmp0)
!else
tmp1=!randint 1, 6

val13=5+$(tmp1)
!endif
tmp0=!item $val13 of $val9

val14=$(tmp0)
tmp=!translate internal $	$ to ; in $val11

tmp=!row $val13 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)

!ifval $val12=1
val16=$(val10[1..4])
!else
val16=$(val10[5..8])
!endif
replytype1=compose
replyname1=
replygood1=$val15;$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

