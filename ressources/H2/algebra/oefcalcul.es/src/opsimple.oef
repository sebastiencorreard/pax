\title{Operaciones simples sobre los relativos}
\author{Odile, Bénassy}
\email{obenassy@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a1=random(6..35)}
\integer{a2=random(6..35)}
\integer{s1=random(-1,1)}
\integer{s2=random(-1,1)}

\integer{x1=\s1 * \a1}
\integer{x2=\s2 * \a2}
\if{\x1=\x2}{\integer{x2=\s2 * (\a2 + 1)}}

\text{x2aff= \s2=-1? (\x2) : \x2}

\integer{opeitem=random(1,2)}
\text{ope=item(\opeitem, +,-)}
\text{openames=adición, sustracción, multiplicación, división}
\text{opename=item(\opeitem, \openames)}

\integer{s2final= \opeitem=1? \s2 : -\s2}
\integer{opename2item= \s1=\s2final? 1:2} 
\text{opename2=item(\opename2item, \openames)}
\if{\opename2item=1}{\integer{operuleitem= \s2=-1? 2:1}}
\if{\opename2item=2}{\integer{operuleitem= \s2=-1? 4:3}}

\integer{res=\x1 \ope \x2}
\integer{ressign=evalue(\res / abs(\res))}
\text{ressignaff= \ressign=-1? - : +}


\text{operules=tomo simplemente el signo de los dos números.,retiro los paréntesis luego yo tomo el signo de los dos números.,observo quien de los dos números a la mayor distancia a cero.,retiro los paréntesis y luego observo quien de los dos números a la mayor distancia a cero.,utilizo la "regla de las señales".}
\text{operule=item(\operuleitem, \operules)}

\steps{choice 1
choice 2, choice 3
choice 4, reply 1
}

\statement{

<br><br>O sea la operación : <br><br>\x1 \ope \x2aff.
<br><br>
\if{\step<=1}{es una \embed{choice 1}.}

\if{\step=2}{Para encontrar el signo del resultado, <br>\embed{choice 2}
<br><br>¿Cuál es el signo del resultado? \embed{choice 3}}

\if{\step=3}{Para calcular el resultado, debo hacer una \embed{choice 4}.
<br><br>Encuentro : \embed{reply 1,3}}

}

\choice{}{\opename}{\openames}
\choice{}{\operule}{\operules}
\choice{}{\ressignaff}{+,-}
\choice{}{\opename2}{\openames}
\answer{}{\res}{type=numeric}
