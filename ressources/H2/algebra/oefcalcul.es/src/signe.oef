\title{Signo de un producto}
\language{fr}
\range{-5..5}
\author{Bernadette, Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}


\integer{n=randint(5..20)}
\integer{m=randint(3..\n)}
\text{choix=random(1,2)}
\text{sol= positivo,négativo}
\text{negatif=item(\choix,négativos, positivos)}
\integer{rep=\choix=1 ? \m: \n-\m}
\text{reponse=(-1)^(\rep)=1? item(1,\sol): item(2,\sol)}
\statement{El signo de un producto de  \n factores no nulos que implican exactamente \m factores \negatif 
es\embed{choice 1}.  
}
\choice{Signe}{\reponse}{\sol}
