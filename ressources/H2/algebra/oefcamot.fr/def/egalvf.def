!set title=Egalité vraie ou fausse ?
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
language=fr

ansorder=r,r,r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 9

val6=$[$(tmp0)]
tmp0=!randint 10, 41

val7=$[$(tmp0)]
tmp0=!randitem +,-

val8=$(tmp0)
tmp0=!randitem 1,2

val9=$[rint($(tmp0))]
val10=$[$val7 $val8 $val6+$val9-1]
tmp0=!randint 1, 9

val11=$[$(tmp0)]
tmp0=!randitem 1,2

val12=$[rint($(tmp0))]
tmp0=!item $val12 of $val11*$val6,$val11*10+$val6

val13=$[$(tmp0)]
tmp0=!randitem 1,2

val14=$[rint($(tmp0))]
t_=!rawmath $val6*($val7+$val14-1)
val15=!exec pari print($t_)
tmp0=!randitem 1,2

val16=$[rint($(tmp0))]
val17=$[rint($val7*$val11)]
tmp0=!item $val16 of $val17 $val8 $val11 * $val6,($val17 $val8 $val11) * $val6

val18=$[$(tmp0)]
replytype1=radio
replyname1=
replygood1=$val9 ; Vrai,Faux
replytype2=radio
replyname2=
replygood2=$val12 ; Vrai,Faux
replytype3=radio
replyname3=
replygood3=$val14 ; Vrai,Faux
replytype4=radio
replyname4=
replygood4=$val16 ; Vrai,Faux
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() Dans cet exercice, 
!insmath x
$() = $val6 .<br> Voici des égalités : sont-elles vraies ou fausses ?	<table class="block_center">	<tr><td style="text-align:right">
