$() </td></tr>	<tr><td style="text-align:right">
!insmath $val11*x 
$() </td><td> = </td><td> 
!insmath  $val13
$() </td><td>&nbsp;&nbsp;&nbsp;</td><td> 
!read oef/embed.phtml r2 
$() </td></tr>	<tr><td style="text-align:right">
!insmath $val15 / x 
$() </td><td> = </td><td> 
!insmath  $val7
$()  </td><td>&nbsp;&nbsp;&nbsp;</td><td> 
!read oef/embed.phtml r3 
$() </td></tr>	<tr><td style="text-align:right">
!insmath $val17 $val8 $val11 * x 
$() </td><td> = </td><td> 
!insmath  $val18
$()  </td><td>&nbsp;&nbsp;&nbsp;</td><td> 
