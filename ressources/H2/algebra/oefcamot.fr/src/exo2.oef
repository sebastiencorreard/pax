\title{Expressions et phrases (structurel)(#).}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\text{confparm1=randitem(\confparm1)}
\if{\confparm1 notwordof 1 2 3 4 5 6}{
    \text{confparm1 = randint(1..6)}
 }
\if{\confparm2 notwordof 3 4 5 6}{
    \text{confparm2 = 5}
 }

\if {\confparm1 = 1}{
!!expressions sans lettres
\real{a=randint(10..100)/10}
\real{b=randint(10..100)/10}
\real{c=randint(10..100)/10}
\real{b=\b=\a? \b+1 : \b}
\real{c=(\c=\a or \c=\b)? (\b+\a)/2 : \c}
 \text{expressions=\(\a + \b \times \c),\((\a + \b) \times \c),\( \b \times \a + \c),\(\a - \b \times \c),\((\a - \b) \times \c),\( \b \times \a - \c)}
 \text{phrases=La somme de \a et du produit de \b et \c . , Le produit de la somme de \a et \b et de \c. ,
La somme du produit de \b et \a et de \c. , La différence entre \a et le produit de \b par \c. ,
Le produit de la différence entre \a et \b et de \c. , La différence entre le produit de \b par \a et \c.}
}

\if {\confparm1 = 2}{
!!expressions avec lettres et avec signes de multiplication
\real{a0=randint(10..100)/10}
\real{b0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\text{a=random(\a0,x,y)}
\text{b=random(\b0,z)}
\text{c=random(\c0,t)}
\text{expressions=\(\a + \b \times \c),\((\a + \b) \times \c),\( \b \times \a + \c),\(\a - \b \times \c),\((\a - \b) \times \c),\( \b \times \a - \c)}
\text{phrases=La somme de \(\a) et du produit de \(\b) et \(\c) . , Le produit de la somme de \(\a) et \(\b) et de \(\c). ,
La somme du produit de \(\b) et \(\a) et de \(\c). , La différence entre \(\a) et le produit de \(\b) par \(\c). ,
Le produit de la différence entre \(\a) et \(\b) et de \(\c). , La différence entre le produit de \(\b) par \(\a) et \(\c).}
}

\if {\confparm1 = 3}{
!!expressions sans signe de multiplication
\real{b0=randint(10..100)/10}
\text{a=random(x,y,b)}
\text{b=random(\b0,z)}
\text{c=random(k,a,t,c)}
 \text{expressions=\(\a + \b \c),\((\a + \b) \c),\(\b \a + \c),\(\a - \b \c),\((\a - \b) \c),\(\b \a - \c)}
 \text{phrases=La somme de \(\a) et du produit de \(\b) et \(\c) . , Le produit de la somme de \(\a) et \(\b) et de \(\c). ,
La somme du produit de \(\b) et \(\a) et de \(\c). , La différence entre \(\a) et le produit de \(\b) par \(\c). ,
Le produit de la différence entre \(\a) et \(\b) et de \(\c). , La différence entre le produit de \(\b) par \(\a) et \(\c).}
}

\if {\confparm1 = 4}{
!!expressions avec ou sans lettres et de type distributivité 5ème
\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{c=random(\c0,c)}
 \text{expressions=\(\a (\b + \c)),\(\a \b + \a \c),\(\a (\b - \c)),\(\a \b - \a \c),\(\a \b + \c),\(\a \b - \c)}
 \text{phrases= Le produit de \(\a) et de la somme de \(\b) et \(\c). ,
La somme du produit de \(\a) et \(\b) et du produit de \(\a) et \(\c). ,
 Le produit de  \(\a) et de la différence entre \(\b) et \(\c). ,
La différence entre le produit de \(\a) et \(\b) et le produit de \(\a) et \(\c). ,
La somme du produit de \(\a) et \(\b) et de \(\c). ,
La différence entre le produit de \(\a) et \(\b) et \(\c).}
}

\if {\confparm1 = 5}{
!!expressions avec ou sans lettres et de type distributivité 4ème

\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\real{d0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{c=random(\c0,c)}
\text{d=random(\d0,d)}
 \text{expressions=\((\a + \b) (\c + \d)),\(\a \c + \a \d + \b \c + \b \d),\((\a - \b) (\c + \d)),\((\a - \b) (\c - \d)),\(\a \c + \b \d),\(\a \c - \b \d)}
 \text{phrases=Le produit de la somme de \(\a) et \(\b) et de la somme de \(\c) et \(\d). ,
 La somme du produit de \(\a) et \(\c) &#44; du produit de \(\a) et \(\d) &#44; du produit de \(\b) et \(\c) et du produit de \(\b) et \(\d). ,
Le produit de la différence entre \(\a) à \(\b) et de la somme de \(\c) et \(\d). ,
Le produit de la différence entre \(\a) à \(\b) et de la différence entre \(\c) et \(\d). ,
La somme du produit de \(\a) et \(\c) et du produit de \(\b) et \(\d). ,
La différence entre le produit de \(\a) et \(\c) et le produit de \(\b) et \(\d).}
}

\if {\confparm1 = 6}{
!!expressions avec ou sans lettres et de type produits remarquables !!3ème

\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{expressions=\((\b + \a)^2),\(\a^2 + 2*\a*\b + \b^2),\((\a - \b)^2),\(\a^2 - \b^2),\((\a - \b) (\a + \b)),\(\a^2 + \b^2)}
\text{phrases=Le carré de la somme de \(\a) et \(\b). , La somme du carré de  \(\a) &#44; du produit de 2 par \(\b) et par \(\a) &#44; et du carré de \(\b). ,  Le carré de la différence entre \(\a) et \(\b). , La différence entre le carré de \(\a) et le carré de \(\b), Le produit de la différence entre \(\a) et \(\b) et de la somme de \(\a) et \(\b)., La somme du carré de \(\b) et du carré de \(\a).}
}

\text{ind=shuffle(1,2,3,4,5,6)}
\text{ind=item(1..\confparm2,\ind)}
\text{expressions=item([\ind],\expressions)}
\text{phrases=item([\ind],\phrases)}

\statement{Relier chaque expression à la phrase correspondante :
<div class="wimscenter">
\embed{r1,80,100,1000 }</div>}

 \answer{}{\expressions;\phrases}{type = correspond}{option=split}
