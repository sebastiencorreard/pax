\title{Erreurs d'utilisation du signe égal.(#)}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}


\integer{a=randint(3..10)}
\integer{b=randint(3..10)}
\integer{d=randint(3..10)}
\integer{c=randint(11..20)}
\text{confparm1=randitem(\confparm1)}

\if{\confparm1 notwordof 1 2 3 4 5 6}{
    \text{confparm1 = randint(1..6)}
 }
\if {\confparm1 = 1 or \confparm1 = 2}{
!!Expressions sans lettres
!!Expressions avec lettres et avec signes de multiplication pas disponible
\integer{ab=\a*\b}
\integer{r=\a*\b+\c}
\text{exp= (\(\a * \b) ) + \c =  \ab + \c = \r,
(\(\a * \b) ) + \c <br>=  \ab + \c <br>= \r,
(\(\a * \b) ) + \c <br> \ab + \c <br> \r,
(\(\a * \b) ) + \c &nbsp; &nbsp; &nbsp;&nbsp; &nbsp; \ab + \c &nbsp;&nbsp; &nbsp; &nbsp; &nbsp;  \r,
(\(\a * \b) ) + \c = \(\a * \b) = \ab = \ab + \c = \r,
(\(\a * \b) ) + \c <br>= \(\a * \b) <br>= \ab <br>= \ab + \c <br>= \r,
(\(\a * \b) ) + \c <br>=  On commence par la multiplication.<br>=  \ab + \c <br>= Ensuite on fait l'addition.<br>=  \r
}
\text{num=2,6}
\text{num=1,3}
\text{num0=(\(\a * \b) ) + \c, \(\a * \b), \ab ,\ab + \c, \r}
\text{cnt=4}
\text{num2= =,=,=,=}

\text{alg0=(\(\a*\b))+\c}
\text{alg1=\ab+\c}
\text{alg2=\r}
}

\if {\confparm1 = 3 or \confparm1 = 4 or \confparm1 = 5}{
!!expressions sans signe de multiplication
!!expressions avec ou sans lettres et de type distributivité 5ème
!!expressions avec ou sans lettres et de type distributivité 4ème pas disponible
\integer{ab=\a+\b}
\text{exp= \(\a x + \b x) = \((\a + \b) x) = \(\ab x),
\(\a x + \b x)<br>= \((\a + \b) x)<br> = \(\ab x),
\(\a x + \b x)<br> \((\a + \b) x)<br>  \(\ab x),
\(\a x + \b x)&nbsp; &nbsp; &nbsp;&nbsp; &nbsp; \((\a + \b) x) &nbsp; &nbsp; &nbsp;&nbsp; &nbsp; \(\ab x),
\(\a x + \b x)= (\a + \b) = \ab = \(\ab x),
\(\a x + \b x)<br>= \a + \b <br>= \ab <br>= \(\ab x),
\(\a x + \b x)<br>= On commence par factoriser.<br>= \((\a + \b) x)<br> = Ensuite on fait l'addition.<br>=   \(\ab x)
}
\text{num=2,6}
\text{num=1,3}
\text{num0=\(\a x + \b x), (\a + \b), \ab, \(\ab x)}
\text{num2= =,=,=}
\text{cnt=3}
\text{alg0=\(\a x + \b x)}
\text{alg1=(\a+\b)x}
\text{alg2=\ab x}
}

\if {\confparm1 = 6}{
!!expressions avec ou sans lettres et de type produit remarquable 3ème
\integer{ab=\a+\b}
\integer{ab2=(\a+\b)^2}
\text{exp= \((\a x + \b x)^2) = \((\ab x)^2) = \ab2 \(x^2),
\((\a x + \b x)^2)<br>  = \((\ab x)^2) <br> = \ab2 \(x^2),
\((\a x + \b x)^2) &nbsp; &nbsp; &nbsp;&nbsp; &nbsp;  \((\ab x)^2) &nbsp; &nbsp; &nbsp;&nbsp; &nbsp;  \ab2 \(x^2),
\((\a x + \b x)^2)<br>   \((\ab x)^2) <br> \ab2 \(x^2),
 \((\a x + \b x)^2) = \(\ab x) = \((\ab x)^2) = \ab2 \(x^2),
\((\a x + \b x)^2)<br>  = \(\ab x)<br>  = \((\ab x)^2) <br> = \ab2 \(x^2),
\(\a x + \b x)^2<br>= On commence par factoriser.<br>= \((\ab x)^2)<br> = Ensuite on met au carré.<br>=   \ab2 \(x^2)
}
\text{num=2,4}
\text{num=1,2}
\text{num0= \((\a x + \b x)^2) , \(\ab x), \((\ab x)^2), \ab2 \(x^2)}
\text{num2= =,=,=}
\text{cnt = 3}
\text{alg0=\((\a x + \b x)^2)}
\text{alg1=(\ab x)^2}
\text{alg2=\ab2 x^2}
}

\integer{n=items(\exp)}
\integer{i=randint(1..\n)}

!!expressions justes
\if{\i<3}{\integer{j=1}
}
!!expressions où il manque des "="
\if{\i<5 and \i>2}{\integer{j=2}
}
!!expressions avec égalités fausses
\if{\i<7 and \i>4}{\integer{j=3}
}
!!expressions avec phrases mélangées
\if{\i=7}{\integer{j=4}
}
\text{calcul=item(\i,\exp)}

\text{ nstep = reply 1 }
\nextstep{ \nstep }

 \statement{
  \if{\step=1}{
    Voici un calcul qui a été rédigé par un élève.
    <div class="wimscenter">  \calcul </div>
    Le résultat est correct. <br>
     Mais le calcul est-il bien rédigé ? \embed{reply1}.
    \exit{}
  }
  \if{\step>=2 and \j=3}{
    <div class="wimscenter">\calcul </div>
    Cliquer sur les signes d'égalité qui sont faux.
    <div class="wimscenter">
    \for{s = 1 to \cnt}{\num0[\s] \embed{reply2,\s} } \num0[\cnt+1]</div>
  }
  \if{\step>=2 and \j<>3}{
    Réécrire le calcul en le corrigeant.
    <table class="wimscenter"><tr><td>\alg0</td> </tr><tr><td>= \embed{reply3,10
autocomplete="off"} </td> </tr>
    <tr><td>= \embed{reply4,10
autocomplete="off"}</td> </tr></table>

     \if {\confparm1 = 6}{<div class="wims_instruction">
     Pour taper " x carré ", vous pouvez taper <span class="tt">x^2</span></div>}
  }
}

\answer{}{\j ; Oui il est bien rédigé. , Non car il manque des signes =. , Non car certaines égalités sont fausses., Non car certaines égalités mélangent des calculs et des phrases. }{type=menu}
\answer{}{\num;\num2}{type=mark}{option=split}
\answer{}{\alg1}{type=litexp}
\answer{}{\alg2}{type=litexp}

\text{nstep= (\step=2) and (\j=3) ? reply 2}
\text{nstep= (\step=2) and (\j=2 or \j=4) ? reply 3, reply 4}

ajouter un feedback dans le cas du type mark lorsque la réponse est fausse.
