\title{Egalité vraie ou fausse ?}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\real{a=randint(2..9)}
\real{b=randint(10..41)}
\text{signe=random(+,-)}
\integer{rep1=random(1,2)}
\real{c=\b \signe \a+\rep1-1}
\real{d=randint(1..9)}
\integer{rep2=random(1,2)}
\real{e=item(\rep2,\d*\a,\d*10+\a)}
\integer{rep3=random(1,2)}
\rational{f=\a*(\b+\rep3-1)}
\integer{rep4=random(1,2)}
\integer{bd=\b*\d}
\real{g=item(\rep4,\bd \signe \d * \a,(\bd \signe \d) * \a)}

\statement{ Dans cet exercice, \(x) = \a .<br> Voici des égalités : sont-elles vraies ou fausses ?
<table class="block_center">
<tr><td style="text-align:right">\(\b \signe x) </td><td> = </td><td> \(\c)  </td><td>&nbsp;&nbsp;&nbsp;</td><td>\embed{r1} </td></tr>
<tr><td style="text-align:right">\(\d*x ) </td><td> = </td><td> \( \e) </td><td>&nbsp;&nbsp;&nbsp;</td><td>\embed{r2} </td></tr>
<tr><td style="text-align:right">\(\f / x ) </td><td> = </td><td> \( \b)  </td><td>&nbsp;&nbsp;&nbsp;</td><td>\embed{r3} </td></tr>
<tr><td style="text-align:right">\(\bd \signe \d * x ) </td><td> = </td><td> \( \g)  </td><td>&nbsp;&nbsp;&nbsp;</td><td>\embed{r4} </td></tr>
</table>}

\answer{}{\rep1 ; Vrai,Faux}{type=radio}
\answer{}{\rep2 ; Vrai,Faux}{type=radio}
\answer{}{\rep3 ; Vrai,Faux}{type=radio}
\answer{}{\rep4 ; Vrai,Faux}{type=radio}
