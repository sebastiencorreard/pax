\title{Le signe égal dans tous les sens !}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\text{nom=shuffle(A,B,C,D,E,F)}
\text{a=item(1,\nom)}
\text{b=item(2,\nom)}

\integer{pa=randint(1..9)*10}
\integer{pb=randint(1..9)*10}
\integer{pab=\pa+\pb}
\integer{p2a=2*\pa}

\matrix{data=\a = \pa , \b = \a , \b = ... , \pa
\a = \pa , \a = \b , \b = ... , \pa
\a = \b , \b = \pa , \b = ... , \pa
\b = \a , \b = \pa , \b = ... , \pa
\pa = \a , \b = \a , \b = ... , \pa
\pa = \a , \a = \b , \b = ... , \pa
\a = \b , \pa = \b , \b = ... , \pa
\b = \a , \pa = \b , \b = ... , \pa
\pa = \a , \b = \pb , \a = ... , \pa
\pa = \a , \pb = \b , \a = ... , \pa
\pa = \a , \pb = \b , \b = ... , \pb
\a = \pa , \pb = \b , \b = ... , \pb
\a + \b = \pab , \a = \pa , \b = ... , \pb
\b + \a = \pab , \a = \pa , \b = ... , \pb
\pa = \a ,\a + \b = \pab ,  \b = ... , \pb
\pa = \a , \b + \a = \pab , \b = ... , \pb
\pab = \a + \b , \a = \pa , \b = ... , \pb
\pab = \a + \b , \a = \pa , \b = ... , \pb
\pa = \a ,\pab = \a + \b ,  \b = ... , \pb
\pa = \a , \pab = \a + \b , \b = ... , \pb
2 &times; \a = \p2a , \b = \pb , \a = ... , \pa
\p2a = 2 &times; \a , \b = \pb , \a = ... , \pa
\pb = \b ,2 &times; \a = \p2a ,  \a = ... , \pa
\pb = \b , \p2a = 2 &times; \a , \a = ... , \pa}

\integer{n=rows(\data)}
\integer{i=randint(1..\n)}
\text{e1=\data[\i;1]}
\text{e2=\data[\i;2]}
\text{e3=\data[\i;3]}
\text{rep=\data[\i;4]}

\statement{
<table class="wimscenter"><tr><td>\img{\imagedir/balance.jpg }</td>
<td>  </td><td>\img{\imagedir/masses.jpg }</td></tr>
<tr><td>\img{\imagedir/masse.jpg }
Masse \a .</td><td></td>
<td>\img{\imagedir/masse.jpg } Masse \b .</td></tr>
</table>
Avec une balance, on a effectué deux pesées (en grammes) :
<div class="wimscenter"><b>Pesée 1 :</b> \e1<br>
<b>Pesée 2 : </b>\e2
</div>
Complète : \e3 \embed{r1,5
autocomplete="off"}
}

\answer{}{\rep}{type=numeric}
