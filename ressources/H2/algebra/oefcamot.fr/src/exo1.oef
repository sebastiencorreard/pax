\title{Expressions et phrases (procédural)(#).}
\language{fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\format{html}

\text{confparm1=randitem(\confparm1)}

\if{\confparm1 notwordof 1 2 3 4 5 6}{
    \text{confparm1 = randint(1..6)}
 }

\if{\confparm2 notwordof 3 4 5 6}{
    \text{confparm2 = 5}
 }

\if {\confparm1 = 1}{
!!expressions sans lettres
\real{a=randint(10..100)/10}
\real{b=randint(10..100)/10}
\real{c=randint(10..100)/10}
\real{b=\b=\a? \b+1 : \b}
\real{c=(\c=\a or \c=\b)? (\b+\a)/2 : \c}
 \text{expressions=\(\a + \b \times \c),\((\a + \b) \times \c),\( \b \times \a + \c),\(\a - \b \times \c),\((\a - \b) \times \c),\( \b \times \a - \c)}
 \text{phrases=Multiplier \b par \c puis ajouter \a au résultat. , Ajouter \a et \b et multiplier le résultat par \c. , Multiplier \b par \a puis ajouter \c  au résultat. , Multiplier \b par \c puis soustraire  le résultat à \a. , Soustraire \b à \a et multiplier le résultat par \c. , Multiplier \b par \a puis soustraire \c  au résultat.}
}

\if {\confparm1 = 2}{
!!expressions avec lettres et avec signes de multiplication
\real{a0=randint(10..100)/10}
\real{b0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\text{a=random(\a0,x,y)}
\text{b=random(\b0,z)}
\text{c=random(\c0,t)}
 \text{expressions=\(\a + \b \times \c),\((\a + \b) \times \c),\( \b \times \a + \c),\(\a - \b \times \c),\((\a - \b) \times \c),\( \b \times \a - \c)}
 \text{phrases=Multiplier \(\b) par \(\c) puis ajouter \(\a) au résultat. , Ajouter \(\a) et \(\b) et multiplier le résultat par \(\c). , Multiplier \(\b) par \(\a) puis ajouter \(\c)  au résultat. , Multiplier \(\b) par \(\c) puis soustraire  le résultat à \(\a). , Soustraire \(\b) à \(\a) et multiplier le résultat par \(\c). , Multiplier \(\b) par \(\a) puis soustraire \(\c)  au résultat.}
}

\if {\confparm1 = 3}{
!!expressions sans signe de multiplication
\real{b0=randint(10..100)/10}
\text{a=random(x,y,b)}
\text{b=random(\b0,z)}
\text{c=random(k,a,t,c)}
 \text{expressions=\(\a + \b \c),\((\a + \b) \c),\(\b \a + \c),\(\a - \b \c),\((\a - \b) \c),\(\b \a - \c)}
 \text{phrases=Multiplier \(\b) par \(\c) puis ajouter \(\a) au résultat. , Ajouter \(\a) et \(\b) et multiplier le résultat par \(\c). , Multiplier \(\b) par \(\a) puis ajouter \(\c)  au résultat. , Multiplier \(\b) par \(\c) puis soustraire le résultat à \(\a). , Soustraire \(\b) à \(\a) et multiplier le résultat par \(\c). , Multiplier \(\b) par \(\a) puis soustraire \(\c)  au résultat.}
}

\if {\confparm1 = 4}{
!!expressions avec ou sans lettres et de type distributivité 5ème
\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{c=random(\c0,c)}
 \text{expressions=\(\a (\b + \c)),\(\a \b + \a \c),\(\a (\b - \c)),\(\a \b - \a \c),\(\a \b + \c),\(\a \b - \c)}
 \text{phrases=Ajouter \(\b) et \(\c) puis multiplier le résultat par  \(\a). ,  Multiplier \(\a) et \(\b). Multiplier \(\a) et \(\c). Ajouter les deux résultats. , Soustraire \(\c) à \(\b) et multiplier le résultat par \(\a). , Multiplier \(\a) et \(\b). Multiplier \(\a) et \(\c). Soustraire les deux résultats. , Multiplier \(\b) par \(\a) puis ajouter \(\c)  au résultat. , Multiplier \(\b) par \(\a) puis soustraire \(\c)  au résultat.}
}

\if {\confparm1 = 5}{
!!expressions avec ou sans lettres et de type distributivité 4ème

\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\real{c0=randint(10..100)/10}
\real{d0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{c=random(\c0,c)}
\text{d=random(\d0,d)}
 \text{expressions=\((\a + \b) (\c + \d)),\(\a \c + \a \d + \b \c + \b \d),\((\a - \b) (\c + \d)),\((\a - \b) (\c - \d)),\(\a \c + \b \d),\(\a \c - \b \d)}
 \text{phrases=Ajouter \(\a) et \(\b). Ajouter \(\c) et \(\d). Puis multiplier les deux résultats. ,  Multiplier \(\a) et \(\c). Multiplier \(\a) et \(\d). Multiplier \(\b) et \(\c). Multiplier \(\b) et \(\d). Ajouter les quatre résultats. , Soustraire \(\b) à \(\a). Ajouter \(\c) et \(\d). Puis multiplier les deux résultats. , Soustraire \(\b) à \(\a). Soustraire \(\d) à \(\c). Puis multiplier les deux résultats. ,Multiplier \(\a) et \(\c). Multiplier \(\b) et \(\d). Ajouter les deux résultats. , Multiplier \(\a) et \(\c). Multiplier \(\b) et \(\d). Soustraire les deux résultats.}
}

\if {\confparm1 = 6}{
!!expressions avec ou sans lettres et de type produits remarquables !!3ème

\real{b0=randint(10..100)/10}
\real{a0=randint(10..100)/10}
\text{a=random(x,\a0)}
\text{b=random(\b0,z)}
\text{expressions=\((\a + \b)^2),\(\a^2 + 2*\a*\b + \b^2),\((\a - \b)^2),\(\a^2 -  \b^2),\((\a - \b) (\a + \b)),\(\a^2 + \b^2)}
\text{phrases=Ajouter \(\a) et \(\b). Mettre le résultat au carré. ,  Mettre \(\a) au carré. Multiplier 2 par \(\a) et par \(\b). Mettre \(\b) au carré. Ajouter les trois résultats. ,  Soustraire \(\b) à \(\a) . Mettre le résultat au carré. ,  Mettre \(\a) au carré. Mettre \(\b) au carré. Soustraire les deux résultats., Soustraire \(\b) à \(\a). Ajouter \(\a) et \(\b). Multiplier les deux résultats. , Mettre \(\b) et \(\a) au carré. Ajouter le carré de \(\b) au carré de \(\a).}
}


\text{ind=shuffle(1,2,3,4,5,6)}
\text{ind=item(1..\confparm2,\ind)}
\text{expressions=item([\ind],\expressions)}
\text{phrases=item([\ind],\phrases)}

\statement{Relier chaque expression à la phrase correspondante :
<div class="wimscenter">
\embed{r1,80,100,1000 }</div>}

 \answer{}{\expressions;\phrases}{type = correspond}{option=split}
