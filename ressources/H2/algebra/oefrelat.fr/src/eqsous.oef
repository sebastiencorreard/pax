\title{Equations : soustractions de nombres relatifs.}
\language{fr}
\range{-5..5}
\author{Paul,Byache}
\email{paul@byache.fr}
\computeanswer{no}
\format{html}
\precision{1000}



\if{\confparm1=}{\text{confparm1=2}}
\if{\confparm2=}{\text{confparm2=1}}
\if{\confparm3=}{\text{confparm3=1}}
\if{\confparm4=}{\text{confparm4=2}}


\if{\confparm3=1}{
\text{dessin=text red, 1,0.2, medium,0}
\for{i=1 to 10}{
\text{dessin=\dessin
text blue, 1,\i+0.2, medium,\i}}
\for{i=-10 to -1}{
\text{dessin=\dessin
text green, 1,\i+0.2, medium,\i}}
}

\integer{a=randint(-10^\confparm2..10^\confparm2)}
\integer{b=randint(-10^\confparm2..10^\confparm2)}
\if{\confparm1=1}{
\text{aplus=\a>0 ? (+\a) : (\a)}
\text{bplus=\b>0 ? (+\b) : (\b)}
}
\text{bpar=\b<0 ? &#40;\b&#41; : \b}

\integer{c=\a-\b}

\integer{choix=random(1,2)}
\integer{sol=item(\choix,\a,\b)}
\text{inc=item(\confparm4,&#63;,x)}
\if{\choix=1}{
\text{a=<I>\inc</I>}
\text{aplus=<I>\inc</I>}
}{
\text{b=\inc}
\text{bplus=<I>\inc</I>}
\text{bpar=<I>\inc</I>}
}


\text{image=draw(140,400
xrange -4,10
yrange -10.5,10.5
arrow 0,-10.5,0,10.5,10,black
arrow -3,\a/10^(\confparm2-1),0,\a/10^(\confparm2-1),10,red
parallel -0.3,-10,0.3,-10,0,1, 21, black
\dessin
arc 3.6,(\a+\rep)/(2*10^(\confparm2-1)),5,abs(\rep-\a)/10^(\confparm2-1),270,90,red
arc 3.6,(\rep^2+1)/(\rep^2+1)*(\a+\c)/(2*10^(\confparm2-1)),5,abs(\b)/10^(\confparm2-1),270,90,green
arrow 3.4,\rep/10^(\confparm2-1),2.4,\rep/10^(\confparm2-1),10,red
arrow 3.4,(\rep^2+1)/(\rep^2+1)*\c/10^(\confparm2-1),2.4,\c/10^(\confparm2-1),10,green)}


\statement{
\if{\confparm3=1}{
<img src=\image style="float:right;width:140px;">
}
<div class="wimscenter">
<p>Donne le résultat du calcul suivant :</p>
<p>
\if{\confparm1=1}{\aplus - \bplus}
\if{\confparm1=2}{\a - \bpar }
= \c</p>
<div>Le nombre inconnu est :\embed{reply 1,1}</div>
\if{\confparm3=1}{<div class="wims_instruction">L'axe gradué affiché à droite peut être une aide !</div>}
</div>
}

\answer{}{\sol}{type=numeric}
