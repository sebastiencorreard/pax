!endif
!if $val4=1 
val6=text red, 1,0.2, medium,0
!for val7 =1 to 10 
val6=$val6	text blue, 1,$val7+0.2, medium,$val7
!next
!for val7 =-10 to -1 
val6=$val6	text green, 1,$val7+0.2, medium,$val7
!next
!endif
tmp0=!randint -10^$val3, 10^$val3

val8=$[rint($(tmp0))]
tmp0=!randint -10^$val3, 10^$val3

val9=$[rint($(tmp0))]
!if $val2=1 

!ifval $val8>0 
val10= (+$val8) 
!else
val10= ($val8)
!endif

!ifval $val9>0 
val11= (+$val9) 
!else
val11= ($val9)
!endif
!endif
val12=$[rint($val8+$val9)]
tmp0=!randitem 1,2

val13=$[rint($(tmp0))]
tmp0=!item $val13 of $val8,$val9

val14=$[rint($(tmp0))]
tmp0=!item $val5 of &#63;,x

val15=$(tmp0)
!if $val13=1 
val8=$val15
val10=<I>$val15</I>
!else
val9=$val15
val11=<I>$val15</I>
!endif
!readproc oef/draw.phtml 140,400 \
xrange -4,10	yrange -10.5,10.5	arrow 0,-10.5,0,10.5,10,black	arrow -3,$val8/10^($val3-1),0,$val8/10^($val3-1),10,red	parallel -0.3,-10,0.3,-10,0,1, 21, black	$val6	arc 3.6,($val8+\rep)/(2*10^($val3-1)),5,abs(\rep-$val8)/10^($val3-1),270,90,red	arc 3.6,(\rep^2+1)/(\rep^2+1)*($val8+$val12)/(2*10^($val3-1)),5,abs($val9)/10^($val3-1),270,90,green	arrow 3.4,\rep/10^($val3-1),2.4,\rep/10^($val3-1),10,red	arrow 3.4,(\rep^2+1)/(\rep^2+1)*$val12/10^($val3-1),2.4,$val12/10^($val3-1),10,green 
tmp0=$ins_url
val16=$(tmp0)
replytype1=numeric
replyname1=
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

