 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
tmp0=!randint 1, 10

val7=$(tmp0)
tmp0=!randint 2, 10

val8=$(tmp0)
tmp0=!randint 3, 10

val9=$(tmp0)
val10=$val7 plus $val8 multiplié par $val9,	$val7 plus $val8 puis multiplie par $val9,	$val7 plus $val8 que l'on a d'abord multiplié par $val9,	$val7 multiplié par $val8 plus $val9,	$val7 multiplié par la somme de $val8 et de $val9,	$val7 plus $val8 divisé par $val9,	$val7 plus $val8 que l'on a d'abord divisé par $val9,	$val7 puis divise par $val8 plus $val9 ,	$val7 divisé par $val8 plus $val9,	$val7 plus $val8 puis divise par $val9,	$val7 divisé par $val8 puis ajoute $val9	
val11=On calcule,	  Quelle est l'expression mathématique convenable&nbsp;
val12=S'il y a ambiguité, il faut donner toutes les possibilités.
!if $val6=en 
val10=$val7 plus $val8 multiplié par $val9,	$val7 plus $val8 puis multiplie par $val9,	$val7 plus $val8 que l'on a d'abord multiplié par $val9,	$val7 multiplié par $val8 plus $val9,	$val7 multiplié par la somme de $val8 et de $val9,	$val7 plus $val8 divisé par $val9,	$val7 plus $val8 que l'on a d'abord divisé par $val9,	$val7 puis divise par $val8 plus $val9 ,	$val7 divisé par $val8 plus $val9,	$val7 plus $val8 puis divise par $val9,	$val7 divisé par $val8 puis ajoute $val9	
val11=On calcule,	  Quelle est l'expression mathématique convenable&nbsp;
val12=S'il y a ambiguité, il faut donner toutes les possibilités.
!endif
!if $val6=es 
val10=$val7 más $val8 multiplicado por $val9,	$val7 más $val8 luego multiplica por $val9,	$val7 más $val8 que en primer lugar multiplicó por $val9,	$val7 multiplicado por $val8 más $val9,	$val7 multiplicado por la suma de $val8 y $val9,	$val7 más $val8 dividido por $val9,	$val7 más $val8 que en primer lugar se dividió por $val9,	$val7 luego divide por $val8 más $val9 ,	$val7 dividido por $val8 más $val9,	$val7 más $val8 luego divide por $val9,	$val7 dividido por $val8 luego añade $val9	
val11=Se calcula,	  ¿Cuál es la expresión matemática conveniente?
val12=Si hay ambigüedad, es necesario dar todas las posibilidades.
!endif
!if $val6=nl 
val10=$val7 plus $val8 multiplié par $val9,	$val7 plus $val8 puis multiplie par $val9,	$val7 plus $val8 que l'on a d'abord multiplié par $val9,	$val7 multiplié par $val8 plus $val9,	$val7 multiplié par la somme de $val8 et de $val9,	$val7 plus $val8 divisé par $val9,	$val7 plus $val8 que l'on a d'abord divisé par $val9,	$val7 puis divise par $val8 plus $val9 ,	$val7 divisé par $val8 plus $val9,	$val7 plus $val8 puis divise par $val9,	$val7 divisé par $val8 puis ajoute $val9	
val11=On calcule,	  Quelle est l'expression mathématique convenable&nbsp;
val12=S'il y a ambiguité, il faut donner toutes les possibilités.
!endif
val13=\(\quad $val7 + $val8 \times $val9\quad ;\),	\(\quad ($val7 + $val8) \times $val9\quad ;\),	\(\quad $val7 \times$val8 + $val9\quad ;\),	\(\quad $val7 \times ($val8+ $val9)\quad ;\),	\(\quad $val7 + \frac{$val8}{$val9}\quad ;\),	\(\quad \frac{$val7 + $val8}{$val9}\quad ;\),	\(\quad \frac{$val7}{$val8+$val9}\quad ;\),	\(\quad \frac{$val7 }{$val8} +$val9\quad ;\)	
tmp=!trim $(val13[1]), $(val13[2])| $(val13[2]),$(val13[1])	$(val13[2])	$(val13[1])	$(val13[3]), $(val13[4])| $(val13[4]),$(val13[3])	$(val13[4])	$(val13[5]),$(val13[6])|$(val13[6]),$(val13[5])	$(val13[5])	$(val13[7])	$(val13[8]),$(val13[7])|$(val13[7]),$(val13[8])	$(val13[6])	$(val13[8])	
val14=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2

val15=$(tmp0)

!ifval $val15=1 
tmp0=!randint 1, 5

val16= $(tmp0)
!else
tmp1=!randint 1, 6

val16=5+$(tmp1)
!endif
tmp0=!item $val16 of $val10

val17=$(tmp0)
tmp=!translate internal $	$ to ; in $val14

tmp=!row $val16 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val18=$(tmp0)

!ifval $val15=1
val19=$(val13[1..4])
!else
val19=$(val13[5..8])
!endif
replytype1=compose
replyname1=
replygood1=$val18;$val19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

