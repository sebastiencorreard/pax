!set title=Multiplication d'entiers relatifs 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Multiplication of signed integers 
title_es=Multiplicación de enteros relativos 
title_nl=Vermenigvuldiging van negatieve getallen 

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Effectue le calcul suivant&nbsp;
!if $val6=en 
val7=Calculate
!endif
!if $val6=es 
val7=Efectúa el cálculo siguiente
!endif
!if $val6=nl 
val7=Bereken
!endif
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val8=$[rint($(tmp0)*$(tmp1))]

!ifval $val8 >0 
val8= +$val8
!endif
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]

!ifval $val9 >0 
val9= +$val9
!endif
tmp0=!randint 2, 10

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]

!ifval $val10 >0 
val10= +$val10
!endif
val11=$[rint($val8*($val9)*($val10))]

!ifval $val11>0 
val11= +$val11
!endif
replytype1=numeric
replyname1=
replygood1=$[$val11]
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7: \begin{center} \(($val8)\times ($val9)\times ($val10)\) = \(\dots\dots\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()<p>$val7: </p>	<div class="wimscenter"><label for="reply1">	
!insmath ($val8)\times ($val9)\times ($val10)
$()</label> =  
!read oef/embed.phtml reply 1, 12 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7: $m_begin{center} 
!insmath ($val8)\times ($val9)\times ($val10)
$() = 
!insmath \dots\dots
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
