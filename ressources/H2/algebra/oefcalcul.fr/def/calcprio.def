!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=la multiplication, l'addition
val8=Vous devez calculer,	  et donner le résultat sous la forme d'une fraction irréductible.,	  Quelle opération faites-vous en premier&nbsp;,	  Calculez (vous devez simplifier les fractions)&nbsp;
val9=Opération
