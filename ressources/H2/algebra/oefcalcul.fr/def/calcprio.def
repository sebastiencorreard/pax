val7=de vermenigvuldiging, de optelling
val8=Bereken,	  en geef het resultaat in de vorm van een onherleidbare fractie.	  Welke bewerking ga je als eerst toepassen,	  Okee ! (je moet wel eerst de breuken vereenvoudigen)
val9=bewerking
!endif
tmp0=!randitem 1,2

val10=$(tmp0)
tmp0=!randitem 1,3,5,7,6,2

val11=$[rint($(tmp0))]
tmp0=!randitem 4,5,11

val12=$[rint($(tmp0))]
tmp0=!randitem 1,2,3,5

val13=$[rint($(tmp0))]
tmp0=!randitem 4,7,9,8

val14=$[rint($(tmp0))]
tmp0=!randitem 1,2,3,7

val15=$[rint($(tmp0))]
tmp0=!randitem 5,10

val16=$[rint($(tmp0))]
val17=\frac{$val11}{$val12}+\frac{$val13}{$val14}

!ifval $val10=2
val17= $val17
!else
val17= ($val17)
!endif
val18=\frac{$val15}{$val16}

!ifval $val10=2
tmp0=!item 1 of $val7

val19= $(tmp0)
!else
tmp1=!item 2 of $val7

val19= $(tmp1)
!endif

!ifval $val10=2 
val20= +
!else
val20= \(\times)
!endif

!ifval $val10=2 
val21= +
!else
val21= \times
!endif

!ifval $val10=2
t_=!replace internal \( by ( in numerator($val11/$val12)
tmp0=!exec pari $t_

val22= $(tmp0)
!else
t_=!replace internal \( by ( in numerator($val11/$val12+$val13/$val14)
tmp1=!exec pari $t_

val22= $(tmp1)
!endif

!ifval $val10=2
t_=!replace internal \( by ( in denominator($val11/$val12)
tmp0=!exec pari $t_

val23= $(tmp0)
!else
t_=!replace internal \( by ( in denominator($val11/$val12+$val13/$val14)
tmp1=!exec pari $t_

val23= $(tmp1)
!endif

!ifval $val10=1
t_=!replace internal \( by ( in numerator($val15/$val16)
tmp0=!exec pari $t_

val24= $(tmp0)
!else
t_=!replace internal \( by ( in numerator($val13*$val15/($val14*$val16))
tmp1=!exec pari $t_

val24= $(tmp1)
!endif

!ifval $val10=1
t_=!replace internal \( by ( in denominator($val15/$val16)
tmp0=!exec pari $t_

val25= $(tmp0)
!else
t_=!replace internal \( by ( in denominator($val13*$val15/($val14*$val16))
tmp1=!exec pari $t_

val25= $(tmp1)
!endif

!ifval $val10=1
t_=!replace internal \( by ( in numerator( ($val11/$val12+$val13/$val14)*($val15/$val16))
tmp0=!exec pari $t_

val26= $(tmp0)
!else
t_=!replace internal \( by ( in numerator( $val11/($val12)+($val13/($val14)*($val15/($val16))))
tmp1=!exec pari $t_

val26=	$(tmp1)
!endif

!ifval $val10=1
t_=!replace internal \( by ( in denominator( ($val11/$val12+$val13/$val14)*($val15/$val16))
tmp0=!exec pari $t_

val27= $(tmp0)
!else
t_=!replace internal \( by ( in denominator( $val11/($val12)+($val13/($val14)*($val15/($val16))))
tmp1=!exec pari $t_

val27=	$(tmp1)
!endif
