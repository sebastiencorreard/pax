!set title=Signe d'un produit 
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Signe d'un produit 
title_es=Signo de un producto 
title_nl=Signe d'un produit 

ansorder=c
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Le signe d'un produit de,	  facteurs non nuls comportant exactement,	  facteurs,	  est
val8=positif,négatif
val9=négatifs, positifs
val10=Signe
!if $val6=en 
val7=Le signe d'un produit de,	  facteurs non nuls comportant exactement,	  facteurs,	  est
val8=positif,négatif
val9=négatifs, positifs
val10=Signe
!endif
!if $val6=es 
val7=El signo de un producto de,	  factores no nulos que implican exactamente,	  factores,	  es
val8=positivo,négativo
val9=négativos, positivos
val10=Signe
!endif
!if $val6=nl 
val7=Le signe d'un produit de,	  facteurs non nuls comportant exactement,	  facteurs,	  est
val8=positif,négatif
val9=négatifs, positifs
val10=Signe
!endif
tmp0=!randint 5, 20

val11=$[rint($(tmp0))]
tmp0=!randint 3, $val11

val12=$[rint($(tmp0))]
tmp0=!randitem 1,2

val13=$(tmp0)
val14=$val8
tmp0=!item $val13 of $val9

val15=$(tmp0)

!ifval $val13=1 
val16=$[rint( $val12)]
!else
val16=$[rint( $val11-$val12)]
!endif

!ifval (-1)^($val16)=1
tmp0=!item 1 of $val14

val17= $(tmp0)
!else
tmp1=!item 2 of $val14

val17= $(tmp1)
!endif
choicename1=$val10
choicegood1=$val17
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $(val7[1]) $val11 $(val7[2]) $val12 $(val7[3]) $val15 $(val7[4]) \(\dots\dots\) \end{statement} 


!goto stat

!exit

:question
$()	$(val7[1]) $val11 $(val7[2]) $val12 $(val7[3]) $val15	$(val7[4])  
!read oef/embed.phtml choice 1 
$().	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1]) $val11 $(val7[2]) $val12 $(val7[3]) $val15 $(val7[4]) 
!insmath \dots\dots
$() $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11,12,15
embedcnt=1
