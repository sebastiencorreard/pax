\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(-1,1)*random(3..15)}
\integer{b=random(-1,1)*random(3..15)}
\integer{b=(\a>0 and \b>0)?-\b}

\integer{ch=random(1..3)}
\text{bad=-,+,\(\times)}
\text{good=item(\ch,\bad)}
\text{sg=-,+,*}
\text{sg=item(\ch,\sg)}
\integer{res=(\a)\sg(\b)}

\statement{Compléter le calcul suivant:
<div class="wimscenter"> (\a)\embed{reply 1,30x30}(\b)=\res.</div>}


\answer{Réponse}{\good;\bad}{type=dragfill}
