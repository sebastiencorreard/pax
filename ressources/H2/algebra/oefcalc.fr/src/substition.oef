\title{Substitution}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a1=random(2..10)}
\integer{sa=random(1,-1)}
\integer{a=\sa*\a1}
\integer{b1=random(2..10)}
\integer{sb=random(1,-1)}
\integer{b=\sb*\b1}
\integer{c=random(-10..-2)}
\text{inc=random(x,y,a,b)}
\integer{ch=randint(1..2)}
\text{enonce=item(\ch,\a \inc + \b,\b + \a \inc)}
\integer{rep=\a*\c+\b}
\text{b2=\sb<0?(\b)}
\text{a2=\sa<0?(\a)}
\text{sol=item(\ch,\(\a \times(\c) + \b2 = \rep),\(\b + \a2 \times(\c) = \rep))}
\statement{Calculer l'expression \(\enonce) lorsque \(\inc) vaut \c.}

\answer{Réponse}{\rep}{type=numexp}

\solution{
\sol}
