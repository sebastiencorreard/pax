\title{Calcul Z}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=random(1..10)}
\integer{b=random(1..10)}
\text{e1=random(-\a,\a)}
\text{e2=random(+\b,-\b,-(-\b))}
\integer{rep=\e1\e2}
\statement{Calculez \(\e1 \e2).}


\answer{Réponse}{\rep}{type=numexp}

\solution{\if{\e2=-(-\b)}
{\(\e1\e2=\e1+\b=\rep)}
{\(\e1\e2=\rep)}}
