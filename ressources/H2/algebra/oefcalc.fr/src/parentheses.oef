\title{Supprimer parenthèses}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..15)}
\integer{b=random(1..15)}
\integer{c=random(1..15)}
\matrix{don=\a+(\b+\c),\a+\b+\c,\a+(\b+\c)=\a+\b+\c=\a+\b+\c
\a+(\b-\c),\a+\b-\c,\a+(\b-\c)=\a+\b-\c
\a-(\b+\c),\a-\b-\c,\a-(\b+\c)=\a-(\b)-(+\c)=\a-\b-\c
\a-(\b-\c),\a-\b+\c,\a-(\b-\c)=\a-(\b)-(-\c)=\a-\b+\c
\a+(-\b+\c),\a-\b+\c,\a+(-\b+\c)=\a-\b+\c
\a+(-\b-\c),\a-\b-\c,\a+(-\b-\c)=\a-\b-\c
\a-(-\b+\c),\a+\b-\c,\a-(-\b+\c)=\a-(-\b)-(+\c)=\a+\b-\c
\a-(-\b-\c),\a+\b+\c,\a-(-\b-\c)=\a-(-\b)-(-\c)=\a+\b+\c}
\integer{n=random(1..8)}
\text{list=row(\n,\don)}
\text{enonce=item(1,\list)}
\text{rep=item(2,\list)}
\text{sol=item(3,\list)}

\statement{Réécrire sans les parenthèses l'expression: \(\enonce).}


\answer{Réponse}{\rep}{type=litexp}

\solution{\(\sol)}
