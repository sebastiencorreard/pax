\title{Clc Mental règles * +}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{b1=random(1..100)}
\integer{b2=random(1..100)}
\text{b=random(\b1.\b2,\b1,-\b1,-\b1.\b2)}
\integer{n=random(1,2)}
\text{symb=\times,+}
\text{symb=item(\n,\symb)}
\text{a=\n=1?random(0,(-1),1,0.1,(-0.1)):random((-1),1,0.1,(-0.1))}
\text{symbc=*,+}
\text{symbc=item(\n,\symbc)}
\text{enonce=random(\b\symb\a,\a\symb\b)}
\real{rep=\a\symbc\b}

\statement{Calculer rapidement \(\enonce).}


\answer{Réponse}{\rep}{type=numexp}
