\title{Vocabulaire * + nombre}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\integer{a=random(1..10)}
\integer{b=random(-\a,\a)}
\text{bad=une somme,un produit,un terme,un facteur,un quotient,une différence}
\matrix{don=(Quand on ajoute deux nombres, chaque nombre est),3,( de la somme.)
(Le résultat d'une multiplication est ),2,(.)
(Quand on multiplie deux nombres, chaque nombre est),4,(du produit.)
(Le résultat d'une addition est),1,(.)}

\integer{no=random(1..4)}
\text{don=row(\no,\don)}
\text{enonce1=item(1,\don)}
\text{enonce1=wims(declosing \enonce1)}
\integer{nogood=item(2,\don)}
\text{good=item(\nogood,\bad)}
\text{enonce2=item(3,\don)}
\text{enonce2=wims(declosing \enonce2)}

\statement{Complète la phrase:
<div class="wimscenter">\enonce1 \embed{r1,130x30x1} \enonce2 </div>}

\answer{Réponse}{\good;\bad}{type=dragfill}
