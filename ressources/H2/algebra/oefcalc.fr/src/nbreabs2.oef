\title{Nombre manquant 2}
\language{fr}
\range{-5..5}
\author{Fabrice, Guerimand}
\email{fwguerima@free.fr}
\computeanswer{no}
\format{html}
\precision{100}

\observation{Nombre manquant possède deux versions. La première ne demande pas de gérer les parenthèses, la seconde (celle-ci) oui.}

\integer{a=random(-1,1)*random(2..12)}
\integer{b=random(-1,1)*random(2..12)}
\integer{b=(\a>0 and \b>0)?-\b}

\text{symb=random(-,+,*)}
\integer{res=(\a)\symb(\b)}
\integer{choix=random(1,2)}
\integer{\goodrep=\choix=1?\a:\b}
\if{\choix=2 and \goodrep<0}{
  \text{goodrep=(\goodrep)}
}

\text{b=\b<0?(\b):\b}

\statement{Retrouver le nombre manquant: 
<div class="wimscenter">
\if{\choix=1}{
 \embed{reply 1,5}\symb \b=\res.
}{
 \a \symb \embed{reply 1,5}=\res.
}
</div>}

\answer{Réponse}{\goodrep}{type=raw}{option=nospace}
