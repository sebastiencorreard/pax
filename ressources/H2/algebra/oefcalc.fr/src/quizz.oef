\matrix{listinc=a,b,c
x,y,z
u,v,w}
\text{listinc=row(random(1,2,3),\listinc)}
\text{a1=item(1,\listinc)}
\text{a2=item(2,\listinc)}
\text{a3=item(3,\listinc)}

\matrix{don=La somme \(\a1 + \a1) est toujours du signe de \(\a1),1
Le produit \(\a1 \times \a1) est toujours du signe de \(\a1),2
Le produit \(-\a1 \times \a1) est toujours négatif,1
Le produit \(\a1 \times \a2) est toujours positif,2
Si le produit \(\a1 \times \a2) est positif alors la somme \(\a1+\a2) l'est aussi,2
Si le produit \(\a1 \times \a2) est négatif alors la somme \(\a1+\a2) est toujours négative,2
Le produit \(\a1 \times \a2 \times \a1 \times \a2) est toujours positif,1
Le produit \(-\a1 \times \a2 \times \a1 \times \a2) est toujours négatif,1
\(-\a1) est toujours négatif,2}
\integer{n=random(1..9)}
\text{list=row(\n,\don)}
\text{enonce=item(1,\list)}
\text{bad=Oui elle est vraie, Non elle est fausse}
\text{good=item(item(2,\list),\bad)}
\text{consigne=randitem(La phrase suivante est-elle vraie quels que soient \(\a1 ) et \(\a2 ) deux nombres relatifs différents de zéro,La phrase suivante est-elle vraie quels que soient les deux nombres relatifs \(\a1) et \(\a2)  différents de zéro)}

\statement{\consigne ?
<div class="wimscenter">\enonce.</div>}

\choice{Réponse}{\good}{\bad}
