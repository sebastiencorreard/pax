tmp0=!randint 2, 100

val6=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
val8=$[rint($val7*$val6)]

!ifval $val7=1
val8=$val8
!else
val8=($val8)
!endif
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val10=$[rint($(tmp0))]
