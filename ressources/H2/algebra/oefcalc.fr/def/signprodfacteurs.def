!ifval $val19=1
val20=$val20
!else
val20=($val20)
!endif
tmp0=!randint 2, 100

val21=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val22=$[rint($(tmp0))]
val23=$[rint($val22*$val21)]

!ifval $val22=1
val23=$val23
!else
val23=($val23)
!endif
val24=$[rint($val7*$val10*$val13*$val16*$val19*$val22)]
val25=Positif,Négatif

!ifval $val24>0
tmp0=!item 1 of $val25

val26=$(tmp0)
!else
tmp1=!item 2 of $val25

val26=$(tmp1)
!endif
choicename1=Réponse
