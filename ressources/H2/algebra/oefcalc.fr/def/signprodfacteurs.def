!ifval $val13=1
val14=$val14
!else
val14=($val14)
!endif
tmp0=!randint 2, 1000

val15=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val16=$[rint($(tmp0))]
val17=$[rint($val16*$val15)]

!ifval $val16=1
val17=$val17
!else
val17=($val17)
!endif
tmp0=!randint 2, 10

val18=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val19=$[rint($(tmp0))]
