!set title=Quizz sur inconnues
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=c
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=0
choicecnt=1
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!trim a,b,c	x,y,z	u,v,w
val6=!translate internal $	\
$ to ;; in $tmp
tmp0=!randitem 1,2,3

tmp=!translate internal $	$ to ; in $val6

tmp=!row $(tmp0) of $tmp
tmp1=!translate internal $\
$ to ; in $tmp
val6=$(tmp1)
tmp0=!item 1 of $val6

val7=$(tmp0)
tmp0=!item 2 of $val6

val8=$(tmp0)
tmp0=!item 3 of $val6

val9=$(tmp0)
tmp=!trim La somme \($val7 + $val7) est toujours du signe de \($val7),1	Le produit \($val7 \times $val7) est toujours du signe de \($val7),2	Le produit \(-$val7 \times $val7) est toujours négatif,1	Le produit \($val7 \times $val8) est toujours positif,2	Si le produit \($val7 \times $val8) est positif alors la somme \($val7+$val8) l'est aussi,2	Si le produit \($val7 \times $val8) est négatif alors la somme \($val7+$val8) est toujours négative,2	Le produit \($val7 \times $val8 \times $val7 \times $val8) est toujours positif,1	Le produit \(-$val7 \times $val8 \times $val7 \times $val8) est toujours négatif,1	\(-$val7) est toujours négatif,2
val10=!translate internal $	\
$ to ;; in $tmp
tmp0=!randint 1, 9

val11=$[rint($(tmp0))]
tmp=!translate internal $	$ to ; in $val10

tmp=!row $val11 of $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val12=$(tmp0)
tmp0=!item 1 of $val12

val13=$(tmp0)
val14=Oui elle est vraie, Non elle est fausse
tmp0=!item 2 of $val12

tmp1=!item $(tmp0) of $val14

val15=$(tmp1)
tmp=!nonempty items La phrase suivante est-elle vraie quels que soient \($val7 ) et \($val8 ) deux nombres relatifs différents de zéro,La phrase suivante est-elle vraie quels que soient les deux nombres relatifs \($val7) et \($val8)  différents de zéro

tmp0=!randitem $tmp
val16=$(tmp0)
choicename1=Réponse
choicegood1=$val15
choicebad1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val16 ?	<div class="wimscenter">$val13.</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=13,16
embedcnt=0
