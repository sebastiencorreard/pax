!set title=Substitution
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand
email=fwguerima@free.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=100

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 10

val6=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val7=$[rint($(tmp0))]
val8=$[rint($val7*$val6)]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randitem 1,-1

val10=$[rint($(tmp0))]
val11=$[rint($val10*$val9)]
tmp0=!randint -10, -2

val12=$[rint($(tmp0))]
tmp0=!randitem x,y,a,b

val13=$(tmp0)
tmp0=!randint 1, 2

val14=$[rint($(tmp0))]
tmp0=!item $val14 of $val8 $val13 + $val11,$val11 + $val8 $val13

val15=$(tmp0)
val16=$[rint($val8*$val12+$val11)]

!ifval $val10<0
val17=($val11)
!endif

!ifval $val7<0
val18=($val8)
!endif
tmp0=!item $val14 of \($val8 \times($val12) + $val17 = $val16),\($val11 + $val18 \times($val12) = $val16)

val19=$(tmp0)
replytype1=numexp
replyname1=Réponse
replygood1=$val16
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst  $val19


!goto stat

!exit

:question
$()Calculer l'expression 
!insmath $val15
$() lorsque 
!insmath $val13
$() vaut $val12.
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$() $val19
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12,13,15,19
embedcnt=0
