!set title=Rectangle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
keywords=pbsolving,linear_system
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 20, 50

val6=$[rint($(tmp0))]
tmp0=!randint 20, 50

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=$[rint(2*($val8+$val6))]
replytype1=default
replyname1=Longueur
replygood1=$val8
replytype2=default
replyname2=Largeur
replygood2=$val6
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Nous avons un rectangle ayant un périmètre de $val9 mm. Sachant que	la longueur fait $val7 mm de plus que la largeur, trouver la longueur et la	largeur (en mm).	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()Soit 
!insmath x
$() la longueur, 
!insmath y
$() la largeur. Alors nous avons le système suivant.	<div class="wimscenter">	  
!insmath \left\lbrace \begin{array}{ccccc}	 2x &+& 2y &=& $val9\\	 x &-& y &=& $val7\end{array}\right .
$()	</div>	Et la solution de ce système est 
!insmath x = $val8
$(), 
!insmath y = $val6
$().	
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,9
embedcnt=0
