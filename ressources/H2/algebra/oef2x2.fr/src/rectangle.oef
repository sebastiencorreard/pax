\title{Rectangle}
\language{fr}
\range{-5..5}
\author{Gang XIAO}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}
\keywords{pbsolving,linear_system}
\integer{y=random(20..50)}
\integer{diff=random(20..50)}
\integer{x=\y+\diff}
\integer{peri=2*(\x+\y)}

\statement{Nous avons un rectangle ayant un périmètre de \peri mm. Sachant que
la longueur fait \diff mm de plus que la largeur, trouver la longueur et la
largeur (en mm).
}

\answer{Longueur}{\x}{type=default}
\answer{Largeur}{\y}{type=default}
\solution{Soit \(x\) la longueur, \(y\) la largeur. Alors nous avons le système suivant.
<div class="wimscenter">
  \(\left\lbrace \begin{array}{ccccc}
	2x &+& 2y &=& \peri\\
	x &-& y &=& \diff\end{array}\right .\)
</div>
Et la solution de ce système est \(x = \x\), \(y = \y\).
}

