\title{Restaurant}
\language{en}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x=random(2..8)}
\integer{y=random(2..8)}
\integer{pers=\x+\y}
\integer{child=random(13..25)}
\integer{adult=random(\child*1.2..\child*1.8)}
\integer{tot=\child*\x+\adult*\y}

\statement{\pers persons go to restaurant for dinner.
<p>
The menu costs \child dollars for each child, and \adult dollars for
each adult. The total cost for the dinner goes to \tot dollars.
<p>
Among these \pers persons,
how many children and how many adults are there?
}

\answer{Children}{\x}{type=default}
\answer{Adults}{\y}{type=default}
\solution{Let x be the number of children, and y the number of adults.
We have the following system. <p><center>
	x + y = \pers<br>
	\child x + \adult y = \tot
</center> <p>
And the solution of this system is x=\x, y=\y.
}

