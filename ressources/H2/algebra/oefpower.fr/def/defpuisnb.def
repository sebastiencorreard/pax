tmp0=!randint 2, 6

val8=$[rint($(tmp0))]
tmp0=!randint 2, 4

val9=$[rint($(tmp0))]
tmp0=!randint -6, -2

val10=$[rint($(tmp0))]
tmp0=!randint 2, 4

val11=$[rint($(tmp0))]
tmp0=!randint 2, 6

val12=$[rint($(tmp0))]
tmp0=!randint 2, 4

val13=$[rint($(tmp0))]
tmp0=!randint -6, -2

val14=$[rint($(tmp0))]
tmp0=!randint 2, 4

val15=$[rint($(tmp0))]
t_=!replace internal \( by ( in  $val8^$val9
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
t_=!replace internal \( by ( in  ($val10)^$val11
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
t_=!replace internal \( by ( in  -1*(($val12)^($val13))
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
t_=!replace internal \( by ( in  -1*(($val14)^($val15))
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val19=!exec pari print($t_)
val20=$val8^$val9
val21=($val10)^$val11
val22=-$val12^$val13
val23=-($val14)^$val15
tmp0=!randint 1, 4

val24=$[rint($(tmp0))]
!if $val24=1 
val25=$val20
t_=!rawmath $val16
val26=!exec pari print($t_)
!endif
!if $val24=2 
val25=$val21
t_=!rawmath $val17
val26=!exec pari print($t_)
!endif
!if $val24=3 
