!set title=Opération 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=ambali@free.fr
title_en=Operation 1
title_es=Operación 1
title_it=Operazioni 1
title_nl=Bewerkingen 1

ansorder=r,r
varcnt=22
prevarcnt=20
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Compléter l'égalité afin qu'elle soit vérifiée&nbsp;
val8=Donner le résultat sous la forme
!if $val6=en 
val7=Complete the equality so that it becomes true
val8=Give the result in the form
!endif
!if $val6=es 
val7=Completar la igualdad para que esté comprobada
val8=Dar el resultado en la forma
!endif
!if $val6=it 
val7=Completa l'eguaguaglianza
val8=Scrivi il risultato nella forma
!endif
!if $val6=nl 
val7=Reken uit en schrijf in de vorm
val8=Geef het resultaat in de vorm
!endif
tmp0=!randint 1, 20

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val12=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val9 / $val10
val13=!exec pari print($t_)
t_=!rawmath $val11 / $val12
val14=!exec pari print($t_)
tmp0=!randint 1, 10

tmp=!nonempty items -1,1

tmp1=!randitem $tmp
val15=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in  $val13*$val14
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
t_=!replace internal \( by ( in ($val16)^($val15)
tmp0=!exec pari $t_

val17=$[$(tmp0)]
replyname1=
replygood1=?analyze 18
replyname2=
replygood2=?analyze 19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7 :	<div class="wimscenter">	 
!insmath  ($val13)^{$val15} \times ($val14)^{$val15} = 
$()  
!read oef/embed.phtml  reply1 ,8 
$()<sup> 
!read oef/embed.phtml reply2,3 
$()</sup>	</div>	<div class="wims_instruction">$val8 
!insmath a^p
$().</div>	
$()
!exit

