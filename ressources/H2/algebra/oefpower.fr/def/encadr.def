!set title=Encadrement de nombres décimaux
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_en=Bounds of decimal numbers
title_es=Encuadre de números decimales
title_it=Approssimazioni di numeri decimali
title_nl=Grenzen van decimale getallen

ansorder=r,r
varcnt=28
prevarcnt=27
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Donner un encadrement du nombre,par des puissances de 10 consécutives.
val8=Exposant inférieur
val9=Exposant supérieur
val10=Vous pouvez d'abord écrire le nombre en utilisant la notation scientifique.
!if $val6=en 
val7=Give bounds of the number, by consecutive powers of 10.
val8=Exponent
val9=Exponent
val10=You can first write \(A\) using scientific notation.
!endif
!if $val6=es 
val7=Dar un encuadre del número , por potencias de 10 consecutivas. 
val8=Exponent 
val9=Exponent 
val10=Pueden en primer lugar escribir el número utilizando la notación científica.
!endif
!if $val6=it 
val7=Appossima il numero, con potenze consecutive di 10.
val8=Esponente
val9=Esponente
val10=Come prima cosa puoi scrivere il numero utilizzando la notazione scientifica.
!endif
!if $val6=nl 
val7=Geef de grenzen van het getal, uitgedrukt als machten van 10.
val8=exponent
val9=exponent
val10=Je kunt eerst \(A\) schrijven met wetenschappelijke notatie.
!endif
tmp0=!randint 3, 6

val11=$[rint($(tmp0))]
tmp0=!randint 5, 7

tmp1=!randint 1, 3

tmp=!nonempty items $(tmp0),$(tmp1)

tmp2=!randitem $tmp
val12=$[rint($(tmp2))]
tmp0=!randint 10^($val11), 10^($val11+1)-1

val13=$[$(tmp0)]
val14=$[$val13/10^($val12)]
val15=$[$val11-($val12)]
val16=$[$val11-($val12)+1]
replytype1=numeric
replyname1=$val8
replygood1=$[$val15]
replytype2=numeric
replyname2=$val9
replygood2=$[$val16]
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val10

latex=!nosubst  \begin{statement} $(val7[1]) \($val14\) $(val7[2]). \begin{center}\(10^{\cdots} \leq $val14 < 10^{\cdots}\)\end{center} \end{statement} 


!goto stat

!exit

:question
$()$(val7[1]) 
!insmath $val14
$() $(val7[2])	 <div class="wimscenter">	 <label for="reply1">10</label><sup><sup> 
!read oef/embed.phtml reply 1,4 
$()</sup></sup>
!insmath \leq
$() $val14	 
!insmath \lt
$() <label for="reply1">10</label><sup><sup> 
!read oef/embed.phtml reply 2,4 
$()</sup></sup>	</div>	
$()
!exit

:hint
$()$val10
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $(val7[1]) 
!insmath $val14
$() $(val7[2]). $m_begin{center}
!insmath 10^{\cdots} \leq $val14 < 10^{\cdots}
$()$m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,10,14
embedcnt=2
