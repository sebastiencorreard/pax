!set title=Définition écriture scientifique
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=ambali@free.fr
title_en=Definition of scientific notation
title_es=Definición escritura científica
title_it=Definizione notazione scientifica
title_nl=De wetenschappelijke notatie

ansorder=r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Donner l'écriture scientifique du nombre
!if $val6=en 
val7=Write the following number \(A\) using scientific notation:
!endif
!if $val6=es 
val7=Dar la escritura científica del número
!endif
!if $val6=it 
val7=Scrivi il numero dato utilizzando la notazione scientifica:
!endif
!if $val6=nl 
val7=Geef de wetenschappelijke schrijfwijze van \(A\) in
!endif
tmp0=!randint 3, 6

val8=$[rint($(tmp0))]
tmp0=!randint 5, 7

tmp1=!randint 1, 3

tmp=!nonempty items $(tmp0),$(tmp1)

tmp2=!randitem $tmp
val9=$[rint($(tmp2))]
tmp0=!randint 10^($val8), 10^($val8 + 1)-1

val10=$[$(tmp0)]
val11=$[$val10/10^($val9)]
val12=$[$val10/10^($val8)]
val13=$[$val8-$val9]
replyname1=
replygood1=$val12
replyname2=
replygood2=$val13
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst  \begin{statement} $val7 \( A = $val11\): \begin{center} \(A = \cdots \times 10^{\cdots}\) \end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val7 
!insmath  A = $val11
$():	<div class="wimscenter">	 <label for="reply1">
!insmath A = 
$()</label>	   
!read oef/embed.phtml  reply1 ,8 
$() <label for="reply2">
!insmath \times 10
$()</label>	  <sup> 
!read oef/embed.phtml reply2,3 
$()</sup>	 </div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$() $m_begin{statement} $val7 
!insmath  A = $val11
$(): $m_begin{center} 
!insmath A = \cdots \times 10^{\cdots}
$() $m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,11
embedcnt=2
