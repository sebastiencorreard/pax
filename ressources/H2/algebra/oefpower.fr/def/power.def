 <div class='oef_feedbacks'>$val10: 
!insmath (a^n)^m=a^(n*m)
$() ?
$()</div>
!endif
!ifval $m_reply2=$val21 and $m_reply2 <> $val19 
 <div class='oef_feedbacks'>$val11	<div class="wimscenter">
!insmath ($val14^$val13)^$val17 = $val14^{$val13\times $val17}=$val14^{$val19} =$val20 
$() </div> $val12	<div class="wimscenter">
!insmath $val14^$val13
$() $m_times 
!insmath $val14^$val17
$() = 
