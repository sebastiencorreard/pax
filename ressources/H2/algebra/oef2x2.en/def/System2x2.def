!set title=System 2x2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Gang XIAO
email=xiao@unice.fr
keywords=linear_system
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000
title_fr=Système 2x2
title_ca=Sistema 2x2
title_es=System 2x2
title_nl=Systeem 2x2

ansorder=r,r
varcnt=20
prevarcnt=19
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Solve the following system of equations for, and
!if $val6=fr 
val7=Résoudre le système d'équations suivant en, et
!endif
!if $val6=ca 
val7=Resol el següent sistema d'equacions amb incògnites,i 
!endif
!if $val6=es 
val7=Solve the following system of equations for, and
!endif
!if $val6=nl 
val7=Los het onderstaande systeem van vergelijkingen op voor, en
!endif
tmp0=!randint -3, 2

tmp1=!randitem 1,2

val8=$[rint(3*$(tmp0)+$(tmp1))]
tmp0=!randint -3, 2

tmp1=!randitem 1,2

val9=$[rint(3*$(tmp0)+$(tmp1))]
tmp0=!randint -3, 2

tmp1=!randitem 1,2

val10=$[rint(3*$(tmp0)+$(tmp1))]
tmp0=!randitem -3,-2,-1,1,2,3

val11=$[rint(3*$(tmp0))]
tmp0=!randitem 0,1

val12=$[rint($(tmp0))]

!ifval $val12=0
val13=$[rint($val10)]
!else
val13=$[rint($val11)]
!endif

!ifval $val12=0
val14=$[rint($val11)]
!else
val14=$[rint($val10)]
!endif
tmp0=!randint -5, 5

val15=$[rint($(tmp0))]
tmp0=!randint -5, 5

val16=$[rint($(tmp0))]
tmp0=!texmath $val8*x+$val9*y

val17=$(tmp0)
tmp0=!texmath $val13*x+$val14*y

val18=$(tmp0)
val19=$[rint($val8*($val15)+($val9)*($val16))]
val20=$[rint($val13*($val15)+($val14)*($val16))]
replytype1=default
replyname1=\(x\)
replygood1=$val15
replytype2=default
replyname2=\(y\)
replygood2=$val16
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$(val7[1]) 
!insmath x
$() $(val7[2]) 
!insmath y
$().	<div class="wimscenter">	 
!insmath \left \lbrace \begin{array}{ccc}$val17&=&$val19	 \\\  $val18&=&$val20\end{array}\right .
$()		</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,17,18,19,20
embedcnt=0
