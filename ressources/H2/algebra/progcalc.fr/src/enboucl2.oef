\title{Programme de calcul en boucle 2}
\langage {fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\langage{html}
\precision{10000}
\css{<style>
table.algo {border: 2px solid #999;}
.fleche {font-size:2em;}
</style>}
\text{confparm1=\confparm1= ? 1,2,3,4,5:\confparm1}
\text{confparm2=\confparm2= ?3:\confparm2}
\text{confparm3=\confparm3= ? 1:\confparm3}
\text{confparm4=\confparm4= ? 1:\confparm4}


\integer{p=random(1..10)}
\integer{q=random(3..7)}
\if{\confparm3=1}{
\integer{q=1}
}
\if{\confparm3=2}{
\integer{q=10}
}
\integer{x=random(1..10)}
\if{\confparm3=2}{
\real{x=randint(1..300)/10}
}
\if{\confparm3=3}{
\rational{x=\p/\q}
}

\integer{c=random(2..5)}
\integer{a=random(1..3)*\q+\c}
\integer{d=random(1..10)}
\real{b=\c*\d-(\a-\c)*\x}

\text{at=numeric}
\text{op=}
\real{sol1=\x}
\real{sol2=\x*\a}
\real{sol3=\x*\a+\b}
\real{sol4=\x+\d}

\if{\confparm3=3}{
\text{at=numexp}
\text{op=noreduction}
\rational{sol1=\x}
\rational{sol2=\x*\a}
\rational{sol3=\x*\a+\b}
\rational{sol4=\x+\d}
\text{consigne=Donner les réponses <b>exactes</b> sous forme de fractions (pas forcément simplifiées).}
}
\text{mot=ajoute}
\if{\b<0}{
\text{mot=soustrait}
\real{b=-\b}
}

\text{sol=On multiplie<br/>par \a.,On \mot \b.,On divise<br/> par \c.,On soustrait \d.}

\text{HINT=<iframe src="scripts/js/wincalc.html" height="300" width="500" frameborder="0" align="right">
<iframe src=scripts/js/wincalc.html height=300 width=500 frameborder=0 align=right>
</iframe>
Il est plus pratique d'utiliser votre propre calculatrice mais voici une calculatrice.<br>Pour calculer \(sqrt(8)) par exemple, taper
<span class="tt">8</span> puis la touche <span class="tt">sqrt</span>.
<br>Notez les résultats sur une feuille de brouillon.<br>Quand vous avez fini vos calculs,
cliquez sur "retour au travail" ci-dessous.:}

\statement{Complète le programme de calcul ci-dessous.
<div class="wims_instruction">\consigne</div>
<div class="unbreakable">
<table class="wimscenter algo">
<tr><td></td><td></td><td>\sol[1]</td><td></td><td></td></tr>
<tr><td></td>
<td>
\embed{r1,10
autocomplete="off"}
</td>
<td class="fleche">&rarr;</td>
<td>
\embed{r2,10
autocomplete="off"}
</td>
<td></td></tr>
<tr><td>\sol[4]</td>
<td class="fleche">&uarr;</td>
<td></td>
<td class="fleche">&darr;</td>
<td>\sol[2]</td></tr>
<tr><td></td>
<td>
\embed{r4,10
autocomplete="off"}
</td>
<td class="fleche">&larr;</td>
<td>
\embed{r3,10
autocomplete="off"}
</td><td></td></tr>
<tr><td></td><td></td><td>\sol[3]</td><td></td><td></td></tr>
</table>
</div>
}

\answer{Etape 1 : }{\sol1}{type=\at}{option=\op}
\answer{Etape 2 : }{\sol2}{type=\at}{option=\op}
\answer{Etape 3 : }{\sol3}{type=\at}{option=\op}
\answer{Etape 4 : }{\sol4}{type=\at}{option=\op}

