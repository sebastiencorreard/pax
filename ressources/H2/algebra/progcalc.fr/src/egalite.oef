\title{Egalité de deux programmes de calcul(1).}

\langage {fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\langage{html}
\precision{10000}
\css{<style>
table.algo {border: 2px solid #999;}
.fleche {font-size:2em;}
.center {text-align:center;}
</style>}

\text{confparm1=\confparm1= ? 1,2,3,4,5:\confparm1}
\text{confparm2=\confparm2= ?3:\confparm2}
\text{confparm3=\confparm3= ? 1:\confparm3}
\text{confparm4=\confparm4= ? 1:\confparm4}

\integer{p=random(1..10)}
\integer{q=random(3..7)}
\if{\confparm3=1}{
\integer{q=1}
}
\if{\confparm3=2}{
\integer{q=10}
}
\integer{x=randint(1..10)}
\if{\confparm3=2}{
\real{x=randint(1..300)/10}
}
\if{\confparm3=3}{
\rational{x=\p/\q}
}

\integer{c=1}
\integer{f=1}
\if{\confparm2=3}{
\integer{c=randint(2..5)}
\integer{f=randint(2..5)}
}


\integer{d=random(2..5)}
\integer{a=random(2..10)}
\integer{a= \a=\d ? \a+1 : \a} #il ne faut pas que les deux programmes de calcul soient identiques
\integer{b=random(1..10)}
\rational{e=(\x*(\f*\a-\c*\d)+\f*\b)/\c}
\if{\confparm2=1}{
\rational{e=\x*(\a-1)}
}

\matrix{js1=eval(document.getElementById('caseXXX').value)*\a
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\b))
eval(document.getElementById('caseXXX').value)/\c}

\text{data1=document.getElementById('caseYYY').value=Math.round(\js1[1;]*10000000000000000000)/10000000000000000000}
\text{data2=document.getElementById('caseYYY').value=Math.round(\js1[2;]*10000000000000000000)/10000000000000000000}
\text{data3=document.getElementById('caseYYY').value=Math.round(\js1[3;]*10000000000000000000)/10000000000000000000}
\text{op1=wims(replace internal XXX by 1 in \data1)}
\text{op1=wims(replace internal YYY by 2 in \op1)}
\text{op2=wims(replace internal XXX by 2 in \data2)}
\text{op2=wims(replace internal YYY by 3 in \op2)}
\text{op3=wims(replace internal XXX by 3 in \data3)}
\text{op3=wims(replace internal YYY by 4 in \op3)}

\matrix{js2=eval(document.getElementById('caseXXX').value)*\d
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\e))
eval(document.getElementById('caseXXX').value)/\f
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\e))}

\text{data4=document.getElementById('caseYYY').value=Math.round(\js2[1;]*10000000000000000000)/10000000000000000000}
\text{data4bis=document.getElementById('caseYYY').value=Math.round(\js2[4;]*10000000000000000000)/10000000000000000000}
\text{data5=document.getElementById('caseYYY').value=Math.round(\js2[2;]*10000000000000000000)/10000000000000000000}
\text{data6=document.getElementById('caseYYY').value=Math.round(\js2[3;]*10000000000000000000)/10000000000000000000}
\text{op4=wims(replace internal XXX by 1 in \data4)}
\text{op4=wims(replace internal YYY by 5 in \op4)}
\text{op5=wims(replace internal XXX by 5 in \data5)}
\text{op5=wims(replace internal YYY by 6 in \op5)}
\text{op6=wims(replace internal XXX by 6 in \data6)}
\text{op6=wims(replace internal YYY by 7 in \op6)}
\text{op4bis=wims(replace internal XXX by 1 in \data4bis)}
\text{op4bis=wims(replace internal YYY by 5 in \op4bis)}

\text{calcule=\op1;\op2;\op3;\op4;\op5;\op6;}
\if{\confparm2=2}{
\text{calcule=\op1;\op2;\op4;\op5;}
}
\if{\confparm2=1}{
\text{calcule=\op1;\op4bis;}
}


\text{at= \confparm3=3 ? algexp : numeric}
\text{mot=ajoute}
\if{\e<0}{
\text{mot=soustrait}
\rational{e=-\e}
}

\text{sol1=On multiplie<br>par \a.,On ajoute \b.,On divise<br> par \c.}
\text{sol2=On multiplie<br>par \d.,On \mot \e.,On divise<br> par \f.}
\if{\confparm2=1}{
\text{sol2=On \mot \e.}
}

\text{HINT=<iframe src=scripts/js/wincalc.html height="400" width="500" frameborder="0" align="right">
<iframe src=scripts/js/wincalc.html height=300 width=500 frameborder=0 align=right>
</iframe>
Il est plus pratique d'utiliser votre propre calculatrice mais voici une calculatrice.<br>Pour calculer \(sqrt(8)) par exemple, taper
<span class="tt">8</span> puis la touche <span class="tt">sqrt</span>.
<br>Notez les résultats sur une feuille de brouillon.<br>Quand vous avez fini vos calculs,
cliquez sur "retour au travail" ci-dessous.:}

\statement{Voici deux programmes de calcul qui utilisent la même valeur de départ.
<br>Quelle valeur de départ faut-il choisir pour que les deux programmes de calculs aboutissent au même résultat ?
