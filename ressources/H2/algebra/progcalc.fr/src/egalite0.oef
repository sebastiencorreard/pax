\title{Egalité de deux programmes de calcul (0).}

\langage {fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\langage{html}
\precision{10000}
\css{<style>
table.algo {border: 2px solid #999;}
.fleche {font-size:2em;}
.center {text-align:center;}
</style>}

\text{confparm1=\confparm1= ? 1,2,3,4,5:\confparm1}
# confparm2 n'est pas utilisé dans cet exo
\text{confparm3=\confparm3= ? 1:\confparm3}
\text{confparm4=\confparm4= ? 1:\confparm4}

\integer{p=random(1..10)}
\integer{q=random(3..7)}
\if{\confparm3=1}{
\integer{q=1}
}
\if{\confparm3=2}{
\integer{q=10}
}
\integer{x=randint(1..10)}
\if{\confparm3=2}{
\real{x=randint(1..300)/10}
}
\if{\confparm3=3}{
\rational{x=\p/\q}
}

\integer{a=random(4..10)}
\integer{d=\a- random(1..2)}
\integer{b=random(1..10)}
\rational{e=\x*(\a-\d)}

\matrix{js1=eval(document.getElementById('caseXXX').value)*\a}

\text{data1=document.getElementById('caseYYY').value=Math.round(\js1[1;]*10000000000000000000)/10000000000000000000}
\text{op1=wims(replace internal XXX by 1 in \data1)}
\text{op1=wims(replace internal YYY by 2 in \op1)}

\matrix{js2=eval(document.getElementById('caseXXX').value)*\d
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\e))}

\text{data4=document.getElementById('caseYYY').value=Math.round(\js2[1;]*10000000000000000000)/10000000000000000000}
\text{data5=document.getElementById('caseYYY').value=Math.round(\js2[2;]*10000000000000000000)/10000000000000000000}
\text{op4=wims(replace internal XXX by 1 in \data4)}
\text{op4=wims(replace internal YYY by 5 in \op4)}
\text{op5=wims(replace internal XXX by 5 in \data5)}
\text{op5=wims(replace internal YYY by 6 in \op5)}


\text{calcule=\op1;\op4;\op5;}

\text{at= \confparm3=3 ? algexp : numeric}
\text{mot=ajoute}
\if{\e<0}{
\text{mot=soustrait}
\rational{e=-\e}
}

\text{sol1=On multiplie<br>par \a.}
\text{sol2=On multiplie<br>par \d.,On \mot \e.}

\text{HINT=<iframe src=scripts/js/wincalc.html height="400" width="500" frameborder="0" align="right">
<iframe src=scripts/js/wincalc.html height=300 width=500 frameborder=0 align=right>
</iframe>
