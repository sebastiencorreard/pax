\title{Programme de calcul en boucle}
\langage {fr}
\author{Paul, Byache}
\email{paul@byache.fr}
\langage{html}
\css{<style>
table.algo {border: 2px solid #999;}
.fleche {font-size:2em;}
</style>}
\text{confparm1=\confparm1= ? 1,2,3,4,5:\confparm1}
\text{confparm2=\confparm2= ?3:\confparm2}
\text{confparm3=\confparm3= ? 1:\confparm3}
\text{confparm4=\confparm4= ? 1:\confparm4}

\integer{a=random(1..11)}
\integer{b=random(3..9)}
\integer{a= \a=\b ? \a+1 : \a}
\integer{ab=\a*\b}
!!à mettre en type real si seulement additions et multiplications
\rational{asb=\a/\b}
\if{1 notin \confparm1 and 2 notin \confparm1}{
\real{asb=\a/\b}
}

\integer{n=randint(1..8)}
\if{2 isin \confparm1}{
\integer{n=randint(9..15)}
}
\if{1 isin \confparm1}{
\integer{n=randint(16..23)}
}

**lignes 1 à 8**boucles avec + et *
**lignes 9 à 15**inverse
**lignes 16 à 23**racines carrées
\matrix{prog=7,9,10,8
8,9,10,7
9,8,7,10
10,8,7,9
9,7,11,8
10,7,13,8
7,9,8,12
7,10,8,14
9,3,3,10
6,3,3,5
3,13,11,3
7,3,7,3
5,3,5,3
3,6,3,6
3,8,3,8
7,1,2,8
2,8,7,1
10,2,1,9
1,9,10,2
5,1,2,6
1,6,5,2
1,3,2,3
3,2,1,3}
\integer{n1=\prog[\n;1]}
\integer{n2=\prog[\n;2]}
\integer{n3=\prog[\n;3]}
\integer{n4=\prog[\n;4]}

\text{sol=carré,racine carrée,inverse,inverse,double,moitié,fois \b,divisé par \b,plus \a,moins \a,moins \ab,moins \asb,plus \ab,plus \asb}
\matrix{js=Math.pow(document.getElementById('caseXXX').value,2)
Math.pow(document.getElementById('caseXXX').value,0.5)
1/eval(document.getElementById('caseXXX').value)
1/eval(document.getElementById('caseXXX').value)
2*eval(document.getElementById('caseXXX').value)
eval(document.getElementById('caseXXX').value)/2
eval(document.getElementById('caseXXX').value)*\b
eval(document.getElementById('caseXXX').value)/\b
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\a))
Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp(\a))
Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp(\ab))
Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp(\asb))
Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp(\ab))
Math.log(Math.exp(document.getElementById('caseXXX").value)*Math.exp(\asb))}

\text{data1=document.getElementById('caseYYY').value=Math.round(\js[\n1;]*100000000000000000)/100000000000000000}
\text{data2=document.getElementById('caseYYY').value=Math.round(\js[\n2;]*100000000000000000)/100000000000000000}
\text{data3=document.getElementById('caseYYY').value=Math.round(\js[\n3;]*100000000000000000)/100000000000000000}
\text{op1=wims(replace internal XXX by 1 in \data1)}
\text{op1=wims(replace internal YYY by 2 in \op1)}
\text{op2=wims(replace internal XXX by 2 in \data2)}
\text{op2=wims(replace internal YYY by 3 in \op2)}
\text{op3=wims(replace internal XXX by 3 in \data3)}
\text{op3=wims(replace internal YYY by 4 in \op3)}


\statement{Tu dois trouver quels calculs sont effectués dans chaque étape du programme de calcul représenté ci-dessous.
Pour cela, tu peux modifier la valeur de la case jaune et cliquer sur <span class="tt">Calcule</span>.
<div class="unbreakable">
<table class="wimscenter algo">
<tr><td colspan="5">Etape 1</td></tr>
<tr><td></td>
<td>
<input type="text" style="color:blue;background:yellow" id="case1" size="5" value="3" />
</td>
<td class="fleche">&rarr;</td>
<td>
<input type="text" id="case2" size="10" />
</td>
<td></td></tr>
<tr><td>Etape 4</td>
<td class="fleche">&uarr;</td>
<td></td>
<td class="fleche">&darr;</td>
<td>Etape 2</td></tr>
<tr><td></td>
<td>
<input type="text" id="case4" size="10" />
</td>
<td class="fleche">&larr;</td>
<td>
<input type="text" id="case3" size="10" />
</td><td></td></tr>
<tr><td colspan="5">Etape 3</td></tr>
<tr><td colspan="5">
<input type="button" value="Calcule" onclick="\op1;\op2;\op3;" />
<input type="reset" value="Efface" />
</td></tr></table>
</div>

Entrez votre réponse :
<ul>
 <li>Etape 1 : \embed{r1,120x20x1}</li>
 <li>Etape 2 : \embed{r2,120x20x1}</li>
 <li>Etape 3 : \embed{r3,120x20x1}</li>
 <li>Etape 4 : \embed{r4,120x20x1}</li>
</ul>
}

\answer{Etape 1 : }{\sol[\n1];\sol}{type=clickfill}
\answer{Etape 2 : }{\sol[\n2];}{type=clickfill}
\answer{Etape 3 : }{\sol[\n3];}{type=clickfill}
\answer{Etape 4 : }{\sol[\n4];}{type=clickfill}
