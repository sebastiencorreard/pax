$()
$()
!exit

:solution
$()Vous avez répondu $val28 ; une bonne réponse possible était : $val7 (il y a parfois deux bonnes réponses possibles)
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!replace internal XXX by $val28 in $(val16[$val10;])

val29=$(tmp0)
!if $val3>1 
tmp0=!replace internal XXX by $val29 in $(val16[$val11;])

val29=$(tmp0)
!if $val3>2 
tmp0=!replace internal XXX by $val29 in $(val16[$val12;])

val29=$(tmp0)
!endif
!endif
val30=$[abs($val29-$val18)]

!exit

:feedback

!exit

:test

!ifval $val30<10^(-12)
 condtest1=1
!else
 condtest1=0
!endif
condname1=Votre réponse est correcte ? 

!ifval $val30<10^(-2)
 condtest2=1
!else
 condtest2=0
!endif
condname2=Votre réponse est proche d'une réponse correcte ? 

!exit

:stat
vsavelist=3,5,7,10,11,12,13,16,18,25,26,27,28
