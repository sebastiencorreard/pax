!set title=Antécédent par un programme de calcul
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
precision=10000
oefcss=<style> table.algo {border: 2px solid #999;} .fleche {font-size:2em;} </style>

ansorder=r
varcnt=45
prevarcnt=40
postvarcnt=4
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2= 
val2= 1,2,3,4,5
!else
val2=$val2
!endif

!ifval $val3= 
val3=3
!else
val3=$val3
!endif

!ifval $val4= 
val4= 1
!else
val4=$val4
!endif

!ifval $val5= 
val5= 1
!else
val5=$val5
!endif
tmp0=!randitem 4,5,8,10

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

val7=$[rint($(tmp0))]
!if $val4=2 
tmp0=!randint 1, 300

t_=!rawmath $(tmp0)/10
val7=!exec pari print($t_)
!endif
!if $val4=2 and 1 notin $val2 and 2 notin $val2 
tmp0=!randint 1, 300

val7=$[$(tmp0)/10]
!endif
!if $val4=3 
tmp0=!randint 1, 10

tmp1=!randint 3, 10

t_=!rawmath $(tmp0)/$(tmp1)
val7=!exec pari print($t_)
!endif
tmp0=!values x*2 for x in $val2

val8=$(tmp0)
tmp0=!values x-1 for x in $val8

val8=$val8,$(tmp0)

!ifval 2 isin $val8 
tmp0=!listcomplement 10 in $val8

val8= $(tmp0)
!else
val8=$val8
!endif
tmp0=!shuffle $val8

val8=$(tmp0)
tmp0=!itemcnt $val8

val9=$[rint($(tmp0))]
!if $val3=3 and $val9=2 
val3=$[rint(2)]
!endif
tmp0=!item 1 of $val8

val10=$[rint($(tmp0))]
tmp0=!item 2 of $val8

val11=$[rint($(tmp0))]
tmp0=!item 3 of $val8

val12=$[rint($(tmp0))]
val13=carré,racine carrée,inverse,inverse,double,moitié,divisé par $val6,fois $val6,plus $val6,moins $val6
tmp0=!item $val8 of $val13

val14=$(tmp0)
tmp=!trim Math.pow(document.getElementById('caseXXX').value,2)	Math.pow(document.getElementById('caseXXX').value,0.5)	1/eval(document.getElementById('caseXXX').value)	1/eval(document.getElementById('caseXXX').value)	2*eval(document.getElementById('caseXXX').value)	eval(document.getElementById('caseXXX').value)/2	eval(document.getElementById('caseXXX').value)/$val6	eval(document.getElementById('caseXXX').value)*$val6	Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp($val6))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val6))
val15=!translate internal $	\
$ to ;; in $tmp
tmp=!trim (XXX)^2	sqrt(XXX)	1/(XXX)	1/(XXX)	2*(XXX)	(XXX)/2	(XXX)/$val6	(XXX)*$val6	(XXX)+$val6	(XXX)-$val6
val16=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal XXX by $val7 in $(val16[$val10;])

val17=$(tmp0)
!if $val3>1 
tmp0=!replace internal XXX by $val17 in $(val16[$val11;])

val17=$(tmp0)
!if $val3>2 
tmp0=!replace internal XXX by $val17 in $(val16[$val12;])

val17=$(tmp0)
!endif
!endif
tmp=!translate ";': to $     $ in $val17

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val18=$(tmp0)
val19=document.getElementById('caseYYY').value=Math.round($(val15[$val10;])*100000000000000000)/100000000000000000
val20=document.getElementById('caseYYY').value=Math.round($(val15[$val11;])*100000000000000000)/100000000000000000
val21=document.getElementById('caseYYY').value=Math.round($(val15[$val12;])*100000000000000000)/100000000000000000
tmp0=!replace internal XXX by 1 in $val19

val22=$(tmp0)
tmp0=!replace internal YYY by 2 in $val22

val22=$(tmp0)
tmp0=!replace internal XXX by 2 in $val20

val23=$(tmp0)
tmp0=!replace internal YYY by 3 in $val23

val23=$(tmp0)
tmp0=!replace internal XXX by 3 in $val21

val24=$(tmp0)
tmp0=!replace internal YYY by 4 in $val24

val24=$(tmp0)
!if $val3==1 
val25=$val22;
!endif
!if $val3==2 
val25=$val22;$val23;
!endif
!if $val3==3 
val25=$val22;$val23;$val24;
!endif
val26=$[rint(1+2*$val3)]

!ifval (1 isin $val2 or 2 isin $val2) 
val27=	<iframe src=scripts/js/wincalc.html height=300 width=500 frameborder=0 align=right>	</iframe>	Il est plus pratique d'utiliser votre propre calculatrice mais voici une calculatrice.<br>Pour calculer \(sqrt(8)) par exemple, taper	<span class="tt">8</span> puis la touche <span class="tt">sqrt</span>.	<br>Notez les résultats sur une feuille de brouillon.<br>Quand vous avez fini vos calculs,	cliquez sur "retour au travail" ci-dessous.
!else
val27=
!endif
replytype1=numeric
replyname1=
replygood1=?analyze 28
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val27

solution=!nosubst Vous avez répondu $val28 ; une bonne réponse possible était : $val7 (il y a parfois deux bonnes réponses possibles)


!goto stat

!exit

:question
$() Voici un programme de calcul.	<p>Quel nombre de départ faut-il choisir	<b>pour que le résultat du programme de calcul soit 
!insmath $val18
$() ?</b>	</p>	<div class="unbreakable">	<table class="wimscenter algo">	<tr><td></td><td>$(val13[$val10])</td>	
!if $val3>1 
$()<td></td><td>$(val13[$val11])</td>	
!if $val3>2 
$()<td></td><td>$(val13[$val12])</td>	 
!endif
$() 
!endif
$()<td></td></tr>	<tr><td>	<input type="text" style="color:blue;background:yellow" id="case1" size="5" value="3" />	</td>	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case2" size="10" />	</td>	
!if $val3>1 
$()	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case3" size="10" />	</td>	
!if $val3>2 
$()	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case4" size="10" />	</td> 
!endif
$() 
!endif
$()</tr>		
!if $val5=1 
$()	<tr><td colspan="$val26">	<input type="button" value="Calcule" onclick="$val25" />	<input type="reset" value="Efface" />	</td></tr> 
!endif
$()	</table>	</div>	
!if $val5=1 
$()	<div class="wims_instruction">	Pour t'aider, tu peux modifier le nombre de départ (case jaune) et	cliquer sur <span class="tt">Calcule</span>.	</div> 
!endif
$()	L'antécédent à choisir est :  
!read oef/embed.phtml r1	autocomplete="off" 
$()	
$()
!exit

