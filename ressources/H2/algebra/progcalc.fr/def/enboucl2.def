!set title=Programme de calcul en boucle 2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
precision=10000
oefcss=<style> table.algo {border: 2px solid #999;} .fleche {font-size:2em;} </style>

ansorder=r,r,r,r
varcnt=34
prevarcnt=33
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2= 
val2= 1,2,3,4,5
!else
val2=$val2
!endif

!ifval $val3= 
val3=3
!else
val3=$val3
!endif

!ifval $val4= 
val4= 1
!else
val4=$val4
!endif

!ifval $val5= 
val5= 1
!else
val5=$val5
!endif
tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
tmp0=!randint 3, 7

val7=$[rint($(tmp0))]
!if $val4=1 
val7=$[rint(1)]
!endif
!if $val4=2 
val7=$[rint(10)]
!endif
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
!if $val4=2 
tmp0=!randint 1, 300

val8=$[$(tmp0)/10]
!endif
!if $val4=3 
t_=!rawmath $val6/$val7
val8=!exec pari print($t_)
!endif
tmp0=!randint 2, 5

val9=$[rint($(tmp0))]
tmp0=!randint 1, 3

val10=$[rint($(tmp0)*$val7+$val9)]
tmp0=!randint 1, 10

val11=$[rint($(tmp0))]
val12=$[$val9*$val11-($val10-$val9)*$val8]
val13=numeric
val14=
val15=$[$val8]
val16=$[$val8*$val10]
val17=$[$val8*$val10+$val12]
val18=$[$val8+$val11]
!if $val4=3 
val13=numexp
val14=noreduction
t_=!rawmath $val8
val15=!exec pari print($t_)
t_=!rawmath $val8*$val10
val16=!exec pari print($t_)
t_=!rawmath $val8*$val10+$val12
val17=!exec pari print($t_)
t_=!rawmath $val8+$val11
val18=!exec pari print($t_)
val19=Donner les réponses <b>exactes</b> sous forme de fractions (pas forcément simplifiées).
!endif
val20=ajoute
!if $val12<0 
val20=soustrait
val12=$[-$val12]
!endif
val21=On multiplie<br/>par $val10.,On $val20 $val12.,On divise<br/> par $val9.,On soustrait $val11.
val22=<iframe src="scripts/js/wincalc.html" height="300" width="500" frameborder="0" align="right">	<iframe src=scripts/js/wincalc.html height=300 width=500 frameborder=0 align=right>	</iframe>	Il est plus pratique d'utiliser votre propre calculatrice mais voici une calculatrice.<br>Pour calculer \(sqrt(8)) par exemple, taper	<span class="tt">8</span> puis la touche <span class="tt">sqrt</span>.	<br>Notez les résultats sur une feuille de brouillon.<br>Quand vous avez fini vos calculs,	cliquez sur "retour au travail" ci-dessous.:
replytype1=$val13

replyoption1=$val14 
replyname1=Etape 1 :
replygood1=$val15
replytype2=$val13

replyoption2=$val14 
replyname2=Etape 2 :
replygood2=$val16
replytype3=$val13

replyoption3=$val14 
replyname3=Etape 3 :
replygood3=$val17
replytype4=$val13

replyoption4=$val14 
replyname4=Etape 4 :
replygood4=$val18
question=__EXECUTED_1692754_EXERCISE__
hint=!nosubst $val22


!goto stat

!exit

:question
$()Complète le programme de calcul ci-dessous.	<div class="wims_instruction">$val19</div>	<div class="unbreakable">	<table class="wimscenter algo">	<tr><td></td><td></td><td>$(val21[1])</td><td></td><td></td></tr>	<tr><td></td>	<td>	 
!read oef/embed.phtml r1,10	autocomplete="off" 
$()	</td>	<td class="fleche">&rarr;</td>	<td>	 
!read oef/embed.phtml r2,10	autocomplete="off" 
$()	</td>	<td></td></tr>	<tr><td>$(val21[4])</td>	<td class="fleche">&uarr;</td>	<td></td>	<td class="fleche">&darr;</td>	<td>$(val21[2])</td></tr>	<tr><td></td>	<td>	 
!read oef/embed.phtml r4,10	autocomplete="off" 
$()	</td>	<td class="fleche">&larr;</td>	<td>	 
!read oef/embed.phtml r3,10	autocomplete="off" 
$()	</td><td></td></tr>	<tr><td></td><td></td><td>$(val21[3])</td><td></td><td></td></tr>	</table>	</div>	
$()
!exit

