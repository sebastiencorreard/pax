!set title=Programme de calcul en ligne
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
oefcss=<style> table.algo {border: 2px solid #999;} .fleche {font-size:2em;} </style>

ansorder=r,r,r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2= 
val2= 1,2,3,4,5
!else
val2=$val2
!endif

!ifval $val3= 
val3=3
!else
val3=$val3
!endif

!ifval $val4= 
val4= 1
!else
val4=$val4
!endif

!ifval $val5= 
val5= 1
!else
val5=$val5
!endif
tmp0=!randint 3, 9

val6=$[rint($(tmp0))]
tmp0=!values x*2 for x in $val2

val7=$(tmp0)
tmp0=!values x-1 for x in $val7

val7=$val7,$(tmp0)
tmp0=!randitem $val7

val8=$[rint($(tmp0))]
tmp0=!randitem $val7

val9=$[rint($(tmp0))]
tmp0=!randitem $val7

val10=$[rint($(tmp0))]
val11=carré,racine carrée,inverse,inverse,double,moitié,divisé par $val6,fois $val6,plus $val6,moins $val6
tmp0=!item $val7 of $val11

val12=$(tmp0)
tmp=!trim Math.pow(document.getElementById('caseXXX').value,2)	Math.pow(document.getElementById('caseXXX').value,0.5)	1/eval(document.getElementById('caseXXX').value)	1/eval(document.getElementById('caseXXX').value)	2*eval(document.getElementById('caseXXX').value)	eval(document.getElementById('caseXXX').value)/2	eval(document.getElementById('caseXXX').value)/$val6	eval(document.getElementById('caseXXX').value)*$val6	Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp($val6))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val6))
val13=!translate internal $	\
$ to ;; in $tmp
val14=document.getElementById('caseYYY').value=Math.round($(val13[$val8;])*100000000000000000)/100000000000000000
val15=document.getElementById('caseYYY').value=Math.round($(val13[$val9;])*100000000000000000)/100000000000000000
val16=document.getElementById('caseYYY').value=Math.round($(val13[$val10;])*100000000000000000)/100000000000000000
tmp0=!replace internal XXX by 1 in $val14

val17=$(tmp0)
tmp0=!replace internal YYY by 2 in $val17

val17=$(tmp0)
tmp0=!replace internal XXX by 2 in $val15

val18=$(tmp0)
tmp0=!replace internal YYY by 3 in $val18

val18=$(tmp0)
tmp0=!replace internal XXX by 3 in $val16

val19=$(tmp0)
tmp0=!replace internal YYY by 4 in $val19

val19=$(tmp0)
!if $val3=1 
val20=$val17;
!endif
!if $val3=2 
val20=$val17;$val18;
!endif
!if $val3=3 
val20=$val17;$val18;$val19;
!endif
val21=$[rint(1+2*$val3)]
val22=document.getElementById('caseYYY').value
tmp0=!replace internal YYY by 1 in $val22

val23=$(tmp0)
tmp0=!replace internal YYY by 2 in $val22

val24=$(tmp0)
tmp0=!replace internal YYY by 3 in $val22

val25=$(tmp0)
tmp0=!replace internal YYY by 4 in $val22

val26=$(tmp0)
val27=$val23 =3;$val24 ='';$val25= '';$val26 =''; 
tmp0=!nospace $val27

val27=$(tmp0)
tmp0=!item 1 to $val3 of r1,r2,r3

val28=$(tmp0)
oefsteps=$val28 
nextstep=!nosubst $val28 
!readproc oef/steps.proc
replytype1=clickfill
replyname1=Etape 1 :
replygood1=$(val11[$val8]);$val12
replytype2=clickfill
replyname2=Etape 2 :
replygood2=$(val11[$val9]);
replytype3=clickfill
replyname3=Etape 3 :
replygood3=$(val11[$val10]);
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Tu dois trouver quels calculs sont effectués dans chaque étape du programme de calcul représenté ci-dessous.	<br>Pour cela, tu peux modifier la valeur de la case jaune et cliquer sur <span class="tt">Calcule</span>.	<br>	<div class="unbreakable">	<table class="wimscenter algo">	<tr><td></td><td>Etape 1</td>	
!if $val3>1 
$()<td></td><td>Etape 2</td>	
!if $val3>2 
$()<td></td><td>Etape 3</td>	 
!endif
$() 
!endif
$()<td></td></tr>	<tr><td>	<input type="text" style="color:blue;background:yellow" id="case1" size="5" value="3" />	</td>	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case2" size="10" />	</td>	
!if $val3>1 
$()	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case3" size="10" />	</td>	
!if $val3>2 
$()	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case4" size="10" />	</td> 
!endif
$() 
!endif
$()</tr>	<tr><td colspan="$val21">	<input type="button" value="Calcule" onclick="$val20" />	<input type="button" value="Efface" onclick="$val27" />	</td></tr></table>	</div>		<p>Entrez votre réponse :</p>	<p>Etape 1 :  
!read oef/embed.phtml r1,80x40 
$()	
!if $val3>1 
$()<br/>Etape 2 :  
!read oef/embed.phtml r2,80x40 
$() 
!endif
$()	
!if $val3>2 
$()<br/>Etape 3 :  
!read oef/embed.phtml r3,80x40 
$() 
!endif
$()		</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=3,20,21,27
embedcnt=3
