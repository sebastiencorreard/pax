!set title=Programme de calcul en boucle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
oefcss=<style> table.algo {border: 2px solid #999;} .fleche {font-size:2em;} </style>

ansorder=r,r,r,r
varcnt=30
prevarcnt=29
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2= 
val2= 1,2,3,4,5
!else
val2=$val2
!endif

!ifval $val3= 
val3=3
!else
val3=$val3
!endif

!ifval $val4= 
val4= 1
!else
val4=$val4
!endif

!ifval $val5= 
val5= 1
!else
val5=$val5
!endif
tmp0=!randint 1, 11

val6=$[rint($(tmp0))]
tmp0=!randint 3, 9

val7=$[rint($(tmp0))]

!ifval $val6=$val7 
val6=$[rint( $val6+1 )]
!else
val6=$[rint( $val6)]
!endif
val8=$[rint($val6*$val7)]
t_=!rawmath $val6/$val7
val9=!exec pari print($t_)
!if 1 notin $val2 and 2 notin $val2 
val9=$[$val6/$val7]
!endif
tmp0=!randint 1, 8

val10=$[rint($(tmp0))]
!if 2 isin $val2 
tmp0=!randint 9, 15

val10=$[rint($(tmp0))]
!endif
!if 1 isin $val2 
tmp0=!randint 16, 23

val10=$[rint($(tmp0))]
!endif
tmp=!trim 7,9,10,8	8,9,10,7	9,8,7,10	10,8,7,9	9,7,11,8	10,7,13,8	7,9,8,12	7,10,8,14	9,3,3,10	6,3,3,5	3,13,11,3	7,3,7,3	5,3,5,3	3,6,3,6	3,8,3,8	7,1,2,8	2,8,7,1	10,2,1,9	1,9,10,2	5,1,2,6	1,6,5,2	1,3,2,3	3,2,1,3
val11=!translate internal $	\
$ to ;; in $tmp
val12=$[rint($(val11[$val10;1]))]
val13=$[rint($(val11[$val10;2]))]
val14=$[rint($(val11[$val10;3]))]
val15=$[rint($(val11[$val10;4]))]
val16=carré,racine carrée,inverse,inverse,double,moitié,fois $val7,divisé par $val7,plus $val6,moins $val6,moins $val8,moins $val9,plus $val8,plus $val9
tmp=!trim Math.pow(document.getElementById('caseXXX').value,2)	Math.pow(document.getElementById('caseXXX').value,0.5)	1/eval(document.getElementById('caseXXX').value)	1/eval(document.getElementById('caseXXX').value)	2*eval(document.getElementById('caseXXX').value)	eval(document.getElementById('caseXXX').value)/2	eval(document.getElementById('caseXXX').value)*$val7	eval(document.getElementById('caseXXX').value)/$val7	Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp($val6))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val6))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val8))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val9))	Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp($val8))	Math.log(Math.exp(document.getElementById('caseXXX").value)*Math.exp($val9))
val17=!translate internal $	\
$ to ;; in $tmp
val18=document.getElementById('caseYYY').value=Math.round($(val17[$val12;])*100000000000000000)/100000000000000000
val19=document.getElementById('caseYYY').value=Math.round($(val17[$val13;])*100000000000000000)/100000000000000000
val20=document.getElementById('caseYYY').value=Math.round($(val17[$val14;])*100000000000000000)/100000000000000000
tmp0=!replace internal XXX by 1 in $val18

val21=$(tmp0)
tmp0=!replace internal YYY by 2 in $val21

val21=$(tmp0)
tmp0=!replace internal XXX by 2 in $val19

val22=$(tmp0)
tmp0=!replace internal YYY by 3 in $val22

val22=$(tmp0)
tmp0=!replace internal XXX by 3 in $val20

val23=$(tmp0)
tmp0=!replace internal YYY by 4 in $val23

val23=$(tmp0)
replytype1=clickfill
replyname1=Etape 1 :
replygood1=$(val16[$val12]);$val16
replytype2=clickfill
replyname2=Etape 2 :
replygood2=$(val16[$val13]);
replytype3=clickfill
replyname3=Etape 3 :
replygood3=$(val16[$val14]);
replytype4=clickfill
replyname4=Etape 4 :
replygood4=$(val16[$val15]);
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Tu dois trouver quels calculs sont effectués dans chaque étape du programme de calcul représenté ci-dessous.	Pour cela, tu peux modifier la valeur de la case jaune et cliquer sur <span class="tt">Calcule</span>.	<div class="unbreakable">	<table class="wimscenter algo">	<tr><td colspan="5">Etape 1</td></tr>	<tr><td></td>	<td>	<input type="text" style="color:blue;background:yellow" id="case1" size="5" value="3" />	</td>	<td class="fleche">&rarr;</td>	<td>	<input type="text" id="case2" size="10" />	</td>	<td></td></tr>	<tr><td>Etape 4</td>	<td class="fleche">&uarr;</td>	<td></td>	<td class="fleche">&darr;</td>	<td>Etape 2</td></tr>	<tr><td></td>	<td>	<input type="text" id="case4" size="10" />	</td>	<td class="fleche">&larr;</td>	<td>	<input type="text" id="case3" size="10" />	</td><td></td></tr>	<tr><td colspan="5">Etape 3</td></tr>	<tr><td colspan="5">	<input type="button" value="Calcule" onclick="$val21;$val22;$val23;" />	<input type="reset" value="Efface" />	</td></tr></table>	</div>		Entrez votre réponse :	<ul>	 <li>Etape 1 :  
!read oef/embed.phtml r1,120x20x1 
$()</li>	 <li>Etape 2 :  
!read oef/embed.phtml r2,120x20x1 
$()</li>	 <li>Etape 3 :  
!read oef/embed.phtml r3,120x20x1 
$()</li>	 <li>Etape 4 :  
!read oef/embed.phtml r4,120x20x1 
$()</li>	</ul>	
$()
