!set title=Programme de calcul (2 sens)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul, Byache
email=paul@byache.fr
oefcss=<style> table.algo {border: 2px solid #999;} .fleche {font-size:2em;} </style>

ansorder=r,r
varcnt=23
prevarcnt=22
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif


!ifval $val2= 
val2= 1,2,3,4,5
!else
val2=$val2
!endif

!ifval $val3= 
val3=3
!else
val3=$val3
!endif

!ifval $val4= 
val4= 1
!else
val4=$val4
!endif

!ifval $val5= 
val5= 1
!else
val5=$val5
!endif
tmp0=!randint 3, 9

val6=$[rint($(tmp0))]
tmp0=!randitem $val2

val7=$[rint($(tmp0))]
tmp0=!randitem 1,2

val8=$[rint($(tmp0))]
tmp0=!item $val8 of 2*$val7,2*$val7-1

val9=$[rint($(tmp0))]
tmp0=!item 3-$val8 of 2*$val7,2*$val7-1

val10=$[rint($(tmp0))]
val11=carré,racine carrée,inverse,inverse,double,moitié,divisé par $val6,fois $val6,plus $val6,moins $val6
tmp0=!values x*2 for x in $val2

val12=$(tmp0)
tmp0=!values x-1 for x in $val12

val12=$val12,$(tmp0)
tmp0=!item $val12 of $val11

val13=$(tmp0)
tmp=!trim Math.pow(document.getElementById('caseXXX').value,2)	Math.pow(document.getElementById('caseXXX').value,0.5)	1/eval(document.getElementById('caseXXX').value)	1/eval(document.getElementById('caseXXX').value)	2*eval(document.getElementById('caseXXX').value)	eval(document.getElementById('caseXXX').value)/2	eval(document.getElementById('caseXXX').value/)$val6	eval(document.getElementById('caseXXX').value)*$val6	Math.log(Math.exp(document.getElementById('caseXXX').value)*Math.exp($val6))	Math.log(Math.exp(document.getElementById('caseXXX').value)/Math.exp($val6))
val14=!translate internal $	\
$ to ;; in $tmp
val15=document.getElementById('caseYYY').value=Math.round($(val14[$val9;])*100000000000000000)/100000000000000000
tmp0=!replace internal XXX by 1 in $val15

val16=$(tmp0)
tmp0=!replace internal YYY by 2 in $val16

val16=$(tmp0)
val17=document.getElementById('caseYYY').value
tmp0=!replace internal YYY by 1 in $val17

val18=$(tmp0)
tmp0=!replace internal YYY by 2 in $val17

val19=$(tmp0)
val20=$val18=3;$val19=''; 
tmp0=!nospace $val20

val20=$(tmp0)
replytype1=clickfill
replyname1=Sens 1 :
replygood1=$(val11[$val9]);$val13
replytype2=clickfill
replyname2=Sens 2 :
replygood2=$(val11[$val10]);
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Tu dois trouver quels calculs sont effectués dans chaque étape du programme de calcul représenté ci-dessous.	<br>Pour cela, tu peux modifier la valeur de la case jaune et cliquer sur "Calcule".	<div class="unbreakable">	<table class="wimscenter algo">	<tr><td></td><td>Sens 1</td><td></td></tr>	<tr><td>	<input type="text" style="color:blue;background:yellow" id="case1" size="5" value="3"/>	</td>	<td class="fleche">&rarr;<br>&larr;</td>	<td>	<input type="text" id="case2" size="10" />	</td></tr>	<tr><td></td><td>Sens 2</td><td></td></tr>	<tr><td colspan="3">	<input type="button" value="Calcule" onclick="$val16" />	<input type="button" value="Efface" onclick="$val20" />	</td></tr></table>	</div>	<p>Entrez votre réponse :</p>	<p>Sens 1 :  
!read oef/embed.phtml r1,80x40 
$()<br/>Sens 2 :  
!read oef/embed.phtml r2,80x40 
$()	</p>	
$()
!exit

