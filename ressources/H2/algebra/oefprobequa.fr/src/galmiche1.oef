\title{Problème 1}
\language{fr}
\author{Raphaël, Galmiche}
\email{gr501591@etu.unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n1=randint(2..10)}
\integer{n2=randint(10..15)}
\integer{p=randint(3..7)}
\integer{n3=\n1*\p+\n2}

\text{prenom=randitem(Aurélien, Marc, Jérôme, Jérémy, Frédéric, Nicolas, Florian, Thomas, Raphaël, Thibault, Fabien, Olivier)}
\text{fruit=randitem(pommes, poires, cerises, fraises, kiwis, figues, pêches, litchies)}


\statement{
\prenom se fait livrer à domicile \n1 kg de \fruit. Le coût de livraison est de \n2 &euro;.
Il paie au total \n3 &euro;.
<div>
  Un kg de \fruit coûte \embed{r1,5} &euro;.
</div>
}

\answer{ }{\p}{type=numexp}
