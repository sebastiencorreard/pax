\title{Équation}
\language{fr}
\range{-5..5}

\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(17..31)}

\integer{a=randint(1..10)*randitem(1,-1)}
\integer{b=randint(1..10)*randitem(1,-1)}
\integer{c=randint(-10..10)}
\text{eq1=\(\a (\b x + \c))}
\text{eq3=\(\a-x)}

\integer{d=randint(1..10)*randitem(1,-1)}
\integer{e=randint(1..10)*randitem(1,-1)}
\integer{f=randint(-10..10)}
\text{eq2=\(\d-(\e x + \f))}

\integer{a= (\a*\b+\e)=0? \n}
\rational{sol1=(\d-\f-(\a*\c))/(\a*\b+\e)}
\rational{sol2=(\a-\d+\f)/(1-\e)}

\statement{Résoudre les équations suivantes :
  <ul>
  <li>
    \eq1 = \eq2
      <br> S = { \embed{r1} }
  </li><li>
    \eq2 = \eq3
      <br> S = { \embed{r2} }
  </li>
</ul>
 <div class="wims_instruction">Penser à simplifier vos résultats.</div>
}

\answer{}{\sol1}{type=numexp}
\answer{}{\sol2}{type=numexp}
