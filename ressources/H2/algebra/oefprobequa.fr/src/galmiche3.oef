\title{Problème avec deux inconnues}
\language{fr}
\author{Raphaël, Galmiche}
\email{gr501591@etu.unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n1=randint(5..50)}
\integer{n2=randint(5..50)}
\integer{n3=\n1+\n2}
\integer{n4=2*\n1+4*\n2}
\text{p=randitem(vélos, motos)}
\text{q=randitem(voitures, camions)}
\text{Marque=randitem(d'une grande surface, d'un magasin, d'une galerie marchande)}

\statement{
Sur le parking \Marque, on dénombre \n3 véhicules (\p et \q) et \n4 roues.
<ul><li>
  Il y a \embed{r1,20*10} \p dans ce parking.
</li><li>
  Il y a \embed{r2,20*10} \q dans ce parking.
  </li></ul>
}

\answer{ }{\n1}{type=numexp}
\answer{ }{\n2 }{type=numexp}
