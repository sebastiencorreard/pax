\title{Equation et identités remarquables}
\language{fr}
\range{-5..5}
\author{Nesrine}
\email{ness936@hotmail.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=randint(1..10)}
\integer{a2=\a^2}
\integer{b=randint(1..10)}
\integer{b2=\b^2}
\integer{dp=2*\a*\b}
\integer{n=randitem(1,2,3)}

\if{\n=1}{
 \text{eq=\(\a2 x^2 - \dp x + \b2)}
 \text{fact=(\a  x - \b)^2}
 \text{fact= \a=1? (x - \b)^2}
 \rational{sol1=\b/\a}
 \rational{sol2=\sol1}
}{
 \if{\n=2}{
  \text{eq=\(\a2 x^2 + \dp x + \b2)}
  \text{fact=(\a  x + \b)^2}
  \text{fact= \a=1? (x + \b)^2}
  \rational{sol1=-\b/\a}
  \text{sol2=\sol1}
 }{
  \text{eq=\(\a2 x^2 - \b2)}
  \text{fact=(\a x - \b)(\a x + \b)}
  \text{fact= \a=1? (x - \b)(x + \b)}
  \rational{sol1=-\b/\a}
  \rational{sol2=\b/\a}
 }
}

\steps{r1
r2,r3}

\statement{
<ol>
\if{\step=1}{
 <li> Factoriser l'expression suivante :
  <br> \eq = \embed{r1}</li>
}{
 <li> Factoriser l'expression suivante :
  <br> \eq = \reply1
  </li><li>Résoudre l'équation suivante : \eq = 0
  <br>
  La (ou les) solutions sont \embed{r2,5} et \embed{r3,5}.
 <div class="wims_instruction">
  S'il y a deux solutions, les écrire dans l'ordre croissant.
  S'il n'y a qu'une seule solution, l'écrire dans les deux cases.
</li>}
</ol>
}

\answer{}{\fact}{type=algexp}
\answer{}{\sol1}{type=numexp}
\answer{}{\sol2}{type=numexp}
