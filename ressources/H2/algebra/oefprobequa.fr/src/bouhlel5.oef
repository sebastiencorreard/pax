\title{Inéquation et intervalle}
\language{fr}
\range{-5..5}
\author{Nesrine}
\email{ness936@hotmail.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{list=wims(values v,-v for v=2 to 10)}

\integer{a=randint(-10..10)}
\integer{b=randitem(\list)}
\integer{c=randitem(\list)}

\integer{c= \c=\a? \c+1}

\integer{d=randitem(\list)}
\text{n=simplify((\c*\d -\b)/(\a-\c))}
\text{b1=\b<0? \b:+\b}
\text{d1=\d<0? \d:+\d}
\if{\a-\c>0}{
 \text{eq1=\(\a x\b1 < \c (x\d1)\)}
 \text{eq2=\(\c (x\d1) \leq \a x\b1\)}
 \text{eq3=\(\a x \b1 \geq \c (x\d1)\)}
 \text{eq4=\(\c (x\d1) < \a x\b1)}
}{
\text{eq1=\(\c (x\d1) < \a x\b1\)}
\text{eq2=\(\a x\b1 \geq \c (x\d1)\)}
\text{eq3=\(\c (x\d1) \leq \a x\b1\)}
\text{eq4=\(\a x\b1  < \c (x\d1)\)}
}

\text{figure=
segment 10,30,90,30,black
segment 50,20,50,40,red
text black,50,5,medium,\n
}

\text{dess1=draw(100,60
\figure
frect 10,29,50,31,red
segment 50,20,55,20,red
segment 50,40,55,40,red
)}

\text{dess2=draw(100,60
\figure
frect 10,29,50,31,red
segment 50,20,45,20,red
segment 50,40,45,40,red
)}
\text{dess3=draw(100,60
\figure
frect 90,29,50,31,red
segment 50,20,55,20,red
segment 50,40,55,40,red
)}
\text{dess4=draw(100,60
\figure
frect 90,29,50,31,red
segment 50,20,45,20,red
segment 50,40,45,40,red
)}

\text{intervalle=<img src="\dess1" alt="">,<img src="\dess2" alt="">,<img src="\dess3" alt="">,<img src="\dess4" alt="">}
\text{inequation=\eq1,\eq2,\eq3,\eq4}

\statement{
Associer à chaque inéquation son ensemble solution.
<div class="wimscenter">>\embed{r1,100x200}</div>
}

\answer{}{\intervalle;\inequation}{type=correspond}
