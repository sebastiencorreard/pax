\title{Equation : résolution premier degré}
\language{fr}
\range{-5..5}
\author{Nesrine}
\email{ness936@hotmail.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a=randint(1..10)*randitem(1,-1)}
\integer{b=randint(-10..10)}
\integer{c=randint(1..10)*randitem(1,-1)}
\integer{d=randint(-10..10)}
\real{rep1=min(-\b/\a,-\d/\c)}
\real{rep2=max(-\b/\a,-\d/\c)}

\text{eq1=\b=0?\(\a x):\(\a x +\b)}
\text{eq2=\d=0?\(\c x):\(\c x +\d)}

\steps{r1,r2
r3,r4}

\rational{n1=-\b/\a}
\rational{n2=-\d/\c}

\rational{rep1=-\b/\a}
\rational{rep2=-\d/\c}

\statement{
 <ol>
 \if{\step=1}{
  <li>Résoudre les deux équations suivantes :
    <ul>
    <li>\eq1 = 0 <br> S = \embed{r1} </li>
    <li>\eq2 = 0 <br> S = \embed{r2} </li></ul>
   <div class="wims_instruction">Pensez à simplifier vos résultats ! </div></li>
 }{
  <li>Résoudre les deux équations suivantes :
  <ul>
    <li>\eq1 = 0 <br> S = \reply1 </li>
    <li> \eq2 = 0 <br> S = \reply2 </li></ul></li>
   <li> Résoudre l'équation suivante : (\eq1)(\eq2) = 0
   <div>S = { \embed{r3,5} ; \embed{r4,5}}</div>
   <div class="wims_instruction">Écrire vos réponses par ordre croissant.</div>
   </li>
 }
 </ol>
}

\answer{}{\rep1}{type=numexp}{option=nonstop}
\answer{}{\rep2}{type=numexp}{option=nonstop}
\answer{}{\n1}{type=numexp}
\answer{}{\n2}{type=numexp}
