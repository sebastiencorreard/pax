\title{Inéquation avec tableau de signe}
\language{fr}
\range{-5..5}
\author{Nesrine}
\email{ness936@hotmail.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\text{n=randitem(1,2)}
\text{m=randitem(1,2)}
\integer{nb1=randint(2..25)}
\integer{nb2=randint(2..25)}

\if{\n=1}{
 \integer{a=randint(2..11)}
 \text{sign1=-}
 \text{sign2=+}
 \if{\m=1}{
  \integer{b=randint(2..11)}
 }{
  \integer{b=randint(-11..-2)}
 }
}{
 \integer{a=randint(-11..-2)}
 \text{sign1=+}
 \text{sign2=-}
 \if{\m=1}{
  \integer{b=randint(2..11)}
 }{
  \integer{b=randint(-11..-2)}
 }
}
\integer{X=-\b/\a - \nb1}
\integer{Y=-\b/\a + \nb2}
\text{eq=\(\a  x + \b)}
\rational{rep=-\b / \a}
\statement{
Remplir le tableau de signe suivant :
<table class="wimscenter wimsborder">
  <tr>
    <td>x</td>
    <td>\X</td>
    <td>\embed{r1,8}</td>
    <td>\Y</td>
 </tr><tr>
    <td>\eq</td>
    <td>\embed{r2}</td>
    <td>0</td>
    <td>\embed{r3}</td>
 </tr>
</table>
}

\answer{}{\rep}{type=numexp}
\answer{}{\sign1}{type=clickfill}
\answer{}{\sign2}{type=clickfill}
