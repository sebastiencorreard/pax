!set title=Inéquation et intervalle
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nesrine
email=ness936@hotmail.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=25
prevarcnt=24
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!values v,-v for v=2 to 10

val6=$(tmp0)
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val8=$[rint($(tmp0))]
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val9=$[rint($(tmp0))]

!ifval $val9=$val7
val9=$[rint( $val9+1)]
!endif
tmp=!nonempty items $val6

tmp0=!randitem $tmp
val10=$[rint($(tmp0))]
tmp=!translate ";': to $     $ in ($val9*$val10 -$val8)/($val7-$val9)

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val11=$(tmp0)

!ifval $val8<0
val12= $val8
!else
val12=+$val8
!endif

!ifval $val10<0
val13= $val10
!else
val13=+$val10
!endif
!if $val7-$val9>0 
val14=\($val7 x$val12 < $val9 (x$val13)\)
val15=\($val9 (x$val13) \leq $val7 x$val12\)
val16=\($val7 x $val12 \geq $val9 (x$val13)\)
val17=\($val9 (x$val13) < $val7 x$val12)
!else
val14=\($val9 (x$val13) < $val7 x$val12\)
val15=\($val7 x$val12 \geq $val9 (x$val13)\)
val16=\($val9 (x$val13) \leq $val7 x$val12\)
val17=\($val7 x$val12  < $val9 (x$val13)\)
!endif
val18=segment 10,30,90,30,black	segment 50,20,50,40,red	text black,50,5,medium,$val11	
!readproc oef/draw.phtml 100,60 \
$val18	frect 10,29,50,31,red	segment 50,20,55,20,red	segment 50,40,55,40,red	 
tmp0=$ins_url
val19=$(tmp0)
!readproc oef/draw.phtml 100,60 \
$val18	frect 10,29,50,31,red	segment 50,20,45,20,red	segment 50,40,45,40,red	 
tmp0=$ins_url
val20=$(tmp0)
!readproc oef/draw.phtml 100,60 \
$val18	frect 90,29,50,31,red	segment 50,20,55,20,red	segment 50,40,55,40,red	 
tmp0=$ins_url
val21=$(tmp0)
!readproc oef/draw.phtml 100,60 \
$val18	frect 90,29,50,31,red	segment 50,20,45,20,red	segment 50,40,45,40,red	 
tmp0=$ins_url
val22=$(tmp0)
val23=<img src="$val19" alt="">,<img src="$val20" alt="">,<img src="$val21" alt="">,<img src="$val22" alt="">
val24=$val14,$val15,$val16,$val17
replytype1=correspond
replyname1=
replygood1=$val23;$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

