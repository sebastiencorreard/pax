!set title=Inéquation avec tableau de signe
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nesrine
email=ness936@hotmail.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=19
prevarcnt=18
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items 1,2

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!randint 2, 25

val8=$[rint($(tmp0))]
tmp0=!randint 2, 25

val9=$[rint($(tmp0))]
!if $val6=1 
tmp0=!randint 2, 11

val10=$[rint($(tmp0))]
val11=-
val12=+
!if $val7=1 
tmp0=!randint 2, 11

val13=$[rint($(tmp0))]
!else
tmp0=!randint -11, -2

val13=$[rint($(tmp0))]
!endif
!else
tmp0=!randint -11, -2

val10=$[rint($(tmp0))]
val11=+
val12=-
!if $val7=1 
tmp0=!randint 2, 11

val13=$[rint($(tmp0))]
!else
tmp0=!randint -11, -2

val13=$[rint($(tmp0))]
!endif
!endif
val14=$[rint(-$val13/$val10 - $val8)]
val15=$[rint(-$val13/$val10 + $val9)]
val16=\($val10  x + $val13)
t_=!rawmath -$val13 / $val10
val17=!exec pari print($t_)
replytype1=numexp
replyname1=
replygood1=$val17
replytype2=clickfill
replyname2=
replygood2=$val11
replytype3=clickfill
replyname3=
replygood3=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

