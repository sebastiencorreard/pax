!set title=Problème avec deux inconnues
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Raphaël, Galmiche
email=gr501591@etu.unice.fr
language=fr
computeanswer=no
precision=10000

ansorder=r,r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

