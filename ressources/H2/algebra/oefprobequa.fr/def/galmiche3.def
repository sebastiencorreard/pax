 !exit
!endif

tmp0=!randint 5, 50

val6=$[rint($(tmp0))]
tmp0=!randint 5, 50

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=$[rint(2*$val6+4*$val7)]
tmp=!nonempty items vélos, motos

tmp0=!randitem $tmp
val10=$(tmp0)
tmp=!nonempty items voitures, camions

tmp0=!randitem $tmp
val11=$(tmp0)
tmp=!nonempty items d'une grande surface, d'un magasin, d'une galerie marchande

tmp0=!randitem $tmp
val12=$(tmp0)
replytype1=numexp
replyname1=
replygood1=$val6
replytype2=numexp
replyname2=
replygood2=$val7 
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

