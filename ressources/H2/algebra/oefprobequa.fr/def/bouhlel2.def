!set title=Équation
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 17, 31

val6=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val7=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
val10=\($val7 ($val8 x + $val9))
val11=\($val7-x)
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val13=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val14=$[rint($(tmp0))]
val15=\($val12-($val13 x + $val14))

!ifval ($val7*$val8+$val13)=0
val7=$[rint( $val6)]
!endif
t_=!rawmath ($val12-$val14-($val7*$val9))/($val7*$val8+$val13)
val16=!exec pari print($t_)
t_=!rawmath ($val7-$val12+$val14)/(1-$val13)
val17=!exec pari print($t_)
replytype1=numexp
replyname1=
replygood1=$val16
replytype2=numexp
replyname2=
replygood2=$val17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Résoudre les équations suivantes :	  <ul>	  <li>	    $val10 = $val15	      <br> S = {  
!read oef/embed.phtml r1 
$() }	  </li><li>	    $val15 = $val11	      <br> S = {  
!read oef/embed.phtml r2 
$() }	  </li>	</ul>	 <div class="wims_instruction">Penser à simplifier vos résultats.</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11,15
embedcnt=2
