!set title=Equation et identités remarquables
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nesrine
email=ness936@hotmail.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r
varcnt=22
prevarcnt=21
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

val6=$[rint($(tmp0))]
val7=$[rint($val6^2)]
tmp0=!randint 1, 10

val8=$[rint($(tmp0))]
val9=$[rint($val8^2)]
val10=$[rint(2*$val6*$val8)]
tmp=!nonempty items 1,2,3

tmp0=!randitem $tmp
val11=$[rint($(tmp0))]
!if $val11=1 
val12=\($val7 x^2 - $val10 x + $val9)
val13=($val6  x - $val8)^2

!ifval $val6=1
val13= (x - $val8)^2
!endif
t_=!rawmath $val8/$val6
val14=!exec pari print($t_)
t_=!rawmath $val14
val15=!exec pari print($t_)
!else
!if $val11=2 
val12=\($val7 x^2 + $val10 x + $val9)
val13=($val6  x + $val8)^2

!ifval $val6=1
val13= (x + $val8)^2
!endif
t_=!rawmath -$val8/$val6
val14=!exec pari print($t_)
val15=$val14
!else
val12=\($val7 x^2 - $val9)
val13=($val6 x - $val8)($val6 x + $val8)

!ifval $val6=1
val13= (x - $val8)(x + $val8)
!endif
t_=!rawmath -$val8/$val6
val14=!exec pari print($t_)
t_=!rawmath $val8/$val6
val15=!exec pari print($t_)
!endif
!endif
oefsteps=r1	r2,r3 
nextstep=!nosubst r1	r2,r3 
!readproc oef/steps.proc
replytype1=algexp
replyname1=
replygood1=$val13
replytype2=numexp
replyname2=
replygood2=$val14
replytype3=numexp
replyname3=
replygood3=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<ol>	
!if $m_step=1 
$()	 <li> Factoriser l'expression suivante :	  <br> $val12 =  
!read oef/embed.phtml r1 
$()</li>	 
!else
$() 	 <li> Factoriser l'expression suivante :	  <br> $val12 = $m_reply1	  </li><li>Résoudre l'équation suivante : $val12 = 0	  <br>	  La (ou les) solutions sont  
!read oef/embed.phtml r2,5 
$() et  
!read oef/embed.phtml r3,5 
$().	 <div class="wims_instruction">	  S'il y a deux solutions, les écrire dans l'ordre croissant.	  S'il n'y a qu'une seule solution, l'écrire dans les deux cases.	</li> 
!endif
$()	</ol>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=12
embedcnt=3
