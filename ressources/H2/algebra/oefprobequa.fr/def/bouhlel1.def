!set title=Equation : résolution premier degré
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Nesrine
email=ness936@hotmail.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val7=$[rint($(tmp0))]
tmp0=!randint 1, 10

tmp=!nonempty items 1,-1

tmp1=!randitem $tmp
val8=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -10, 10

val9=$[rint($(tmp0))]
val10=$[min(-$val7/$val6,-$val9/$val8)]
val11=$[max(-$val7/$val6,-$val9/$val8)]

!ifval $val7=0
val12=\($val6 x)
!else
val12=\($val6 x +$val7)
!endif

!ifval $val9=0
val13=\($val8 x)
!else
val13=\($val8 x +$val9)
!endif
t_=!rawmath -$val7/$val6
val14=!exec pari print($t_)
t_=!rawmath -$val9/$val8
val15=!exec pari print($t_)
t_=!rawmath -$val7/$val6
val10=!exec pari print($t_)
t_=!rawmath -$val9/$val8
val11=!exec pari print($t_)
oefsteps=r1,r2	r3,r4 
nextstep=!nosubst r1,r2	r3,r4 
!readproc oef/steps.proc
replytype1=numexp
replyoption1=nonstop 
replyname1=
replygood1=$val10
replytype2=numexp
replyoption2=nonstop 
replyname2=
replygood2=$val11
replytype3=numexp
replyname3=
replygood3=$val14
replytype4=numexp
replyname4=
replygood4=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	 <ol>	 
!if $m_step=1 
$()	  <li>Résoudre les deux équations suivantes :	    <ul>	    <li>$val12 = 0 <br> S =  
!read oef/embed.phtml r1 
$() </li>	    <li>$val13 = 0 <br> S =  
!read oef/embed.phtml r2 
$() </li></ul>	   <div class="wims_instruction">Pensez à simplifier vos résultats ! </div></li>	  
!else
$() 	  <li>Résoudre les deux équations suivantes :	  <ul>	    <li>$val12 = 0 <br> S = $m_reply1 </li>	    <li> $val13 = 0 <br> S = $m_reply2 </li></ul></li>	   <li> Résoudre l'équation suivante : ($val12)($val13) = 0	   <div>S = {  
!read oef/embed.phtml r3,5 
$() ;  
!read oef/embed.phtml r4,5 
$()}</div>	   <div class="wims_instruction">Écrire vos réponses par ordre croissant.</div>	   </li>	  
!endif
$()	 </ol>	
$()
!exit

