!set title=Jeu de ficelle sur la plage
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=1000

ansorder=r
varcnt=6
prevarcnt=4
postvarcnt=1
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src=$val1/ficelle.jpg> 
val7=$[95]
val8=$[rint(10)]
val9=Hereone s’amuse sur la plage. Elle plante cinq tiges et tend une ficelle entre chaque tige. Voilà à peu près ce que ça donne puisque le dessin n’est pas à l’échelle . 	<br><br>	Les angles \(\hat P), \(\hat I), \(\hat T) et \(\hat O) sont les angles intérieurs du quadrilatère formé.	<br><br>	L’angle \(\hat I) mesure trois degrés de plus que l’angle \(\hat P)	<br><br>	L’angle \(\hat T) mesure cinq degrés de moins que l’angle \(\hat I).	<br><br>	L’angle \(\hat O) mesure neuf degrés de plus que l’angle \(\hat T).	<br><br>	Quelle est la mesure de l’angle \(\hat O)  &#63;
replytype1=raw
replyname1=reponse
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val9	<br><br> L'angle 
!insmath \hat O
$() mesure  
!read oef/embed.phtml r1,$val8 
$() degrés.	</td><td>$val6</td>	</tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

