 !exit
!endif

val6=<img src=$val1/rat.jpg> 
val7=$[10]
val8=$[14]
val9=$[rint(3)]
val10=Il y a deux groupes de rats, les rats gris et les rats blancs	<br><br>	Le chef des rats gris dit au chef des rats blancs :	<br>« Donne moi deux rats et nous serons le même nombre. »	<br><br>	Le chef des rats blancs dit au chef des rats gris : 	<br>« Pas question ! donne moi deux rats et dans mon clan nous serons deux fois plus nombreux que dans le tien . »	<br><br>	Quel est le nombre de rats gris &#63; 	<br><br>	Quel est le nombre de rats blancs &#63; 
replytype1=raw
replyname1=reponse
replygood1=?analyze 11
replytype2=raw
replyname2=reponse
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val10	</td><td>$val6</td>	</tr></table>	<br><br>	Il y a  
!read oef/embed.phtml r1,$val9 
$() rats gris et  
!read oef/embed.phtml r2,$val9 
$() rats blancs
$()
!exit

