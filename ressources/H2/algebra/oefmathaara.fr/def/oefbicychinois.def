val8=$[rint(10)]
val9=Dans une petite ville de la province de Hakka, en Chine, au bord de la Rivière des Perles, vivent 3333 familles qui ont chacune au moins une bicyclette. 	<br><br>Aucune famille ne possède plus de trois bicyclettes; 	<br>il y a autant de familles propriétaires de trois bicyclettes que de familles qui n'en ont qu'une; 	<br>le nombre de familles qui possèdent deux bicyclettes est neuf fois plus grand que le nombre de celles qui en possèdent trois.	<br><br>	Combien y a-t-il de bicyclettes dans cette ville  &#63;
replytype1=raw
replyname1=reponse
replygood1=?analyze 10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

