!set title=Le quadruple de TEHERE
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=fr
leftrange=-5.000000
rightrange=5.000000
author=Jean-Luc DONADONI
email=jluc.donadoni@laposte.net
computeanswer=no
precision=1000

ansorder=r,r
varcnt=6
prevarcnt=5
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=<img src=$val1/quadruple.jpg> 
val7=$[rint(892)]
val8=$[rint(912)]
val9=$[rint(5)]
val10=Tehere sait que pour avoir des amis il faut être généreux. 	<br>Elle a écrit la multiplication suivante dans laquelle chaque lettre distincte représente un même chiffre. 	<br><br>	Quelle est la plus petite valeur de HOA, et quelle est la plus grande &#63;
replytype1=default
replyname1=
replygood1=?analyze 11
replytype2=default
replyname2=
replygood2=?analyze 12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<table>	<tr><td><br><br>$val10	<br><br> La plus petite valeur est  
!read oef/embed.phtml r1,$val9 
$() et la plus grande est  
!read oef/embed.phtml r2,$val9 
$().	</td><td>$val6</td>	</tr></table>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!ifval ($val11=$val7 and $val12=$val8) or ($val11=$val8 and $val12=$val7)
 condtest1=1
!else
 condtest1=0
!endif
condname1=Bonne réponse 

!exit

:stat
vsavelist=6,7,8,9,10,11,12
embedcnt=2
