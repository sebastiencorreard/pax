\title{Le quadruple de TEHERE}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/quadruple.jpg> }
\integer{a=892}
\integer{b=912}
\integer{size=5}
\text{enonc=Tehere sait que pour avoir des amis il faut être généreux. 
<br>Elle a écrit la multiplication suivante dans laquelle chaque lettre distincte représente un même chiffre. 
<br><br>
Quelle est la plus petite valeur de HOA, et quelle est la plus grande &#63;}

\statement{
<table>
<tr><td><br><br>\enonc
<br><br> La plus petite valeur est \embed{r1,\size} et la plus grande est \embed{r2,\size}.
</td><td>\ill</td>
</tr></table>}


\answer{}{\rep1}{type=default}
\answer{}{\rep2}{type=default}
\condition{Bonne réponse }{(\rep1=\a and \rep2=\b) or (\rep1=\b and \rep2=\a)}
