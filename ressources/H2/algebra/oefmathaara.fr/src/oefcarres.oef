\title{Les carrés de Kehea}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/carres.jpg> }
\real{a=215}
\integer{size=3}
\text{enonc=Kehea est un garçon surprenant : 
<br>il ne sait pas faire une multiplication, mais il connaît les carrés de tous les entiers de 1 à 100. 
<br>Kehea doit calculer le produit 85 x 135. 
<br>Il dessine alors un rectangle de 135 mm de long et 85 mm de large, puis il trace dans ce rectangle 
le carré le plus grand possible, fait de même dans le rectangle restant et ainsi de suite, jusqu’à paver 
entièrement le rectangle initial. 
<br>Il obtient ainsi huit carrés. 
<br><br>
Écrire le nombre 85 x 135 comme la somme de huit carrés }

\statement{
<table>
<tr><td><br><br>\enonc
</td><td>\ill</td>
</tr></table>
<br><br>
85 x 135 = \embed{r1,\size}² + \embed{r2,\size}² + \embed{r3,\size}² + \embed{r4,\size}²
+\embed{r5,\size}² + \embed{r6,\size}² + \embed{r7,\size}²  +  \embed{r8,\size}² }


\answer{reponse}{\c1}{type=raw}
\answer{reponse}{\c2}{type=raw}
\answer{reponse}{\c3}{type=raw}
\answer{reponse}{\c4}{type=raw}
\answer{reponse}{\c5}{type=raw}
\answer{reponse}{\c6}{type=raw}
\answer{reponse}{\c7}{type=raw}
\answer{reponse}{\c8}{type=raw}

\integer{ct=\c1+\c2+\c3+\c4+\c5+\c6+\c7+\c8}
\condition{Bonne Reponse : }{\ct=\a}
