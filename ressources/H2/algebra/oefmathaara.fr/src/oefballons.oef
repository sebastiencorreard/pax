\text{ill1=<img src=\imagedir/ballonp.jpg> }
\text{ill2=<img src=\imagedir/boite.jpg> }
\integer{a=49}
\integer{size=5}
\text{enonc=Au club de football, une armoire de rangement est formée de neuf casiers dont la disposition est représentée ci-dessus. 
<br><br>Dans chaque casier marqué A, il y a le même nombre de ballons de football. 
<br>Dans chaque casier marqué B, il y a un autre même nombre de ballons.
<br> Les deux casiers non marqués ont le même nombre de ballons. 
<br><br>
Kiki, la mascotte du club, a compté tous les ballons qui sont remisés dans cette armoire. Elle fait rapport à l’entraîneur :
<br><br>
« Chaque casier marqué A contient deux ballons de plus que celui marqué B. Tout casier non marqué a un ballon de moins que celui marqué B. Les trois casiers marqués A contiennent un ballon de plus que les quatre casiers marqués B. »
<br><br>
Combien Kiki a-t-elle compté de ballons dans l’armoire &#63;}

\statement{
<table>
<tr><td><br><br></td></tr>
<tr><td>\ill2</td></tr>
<tr><td><br><br>\enonc </td></tr>
<tr><td><br><br> Kiki a compté  \embed{r1,\size} ballons dans l'armoire.
\ill1</td>
</tr></table>}


\answer{}{\rep}{type=default}
\condition{Bonne réponse }{\rep=\a}
