\title{Bicyclettes chinoises}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/bicychinois.jpg> }
\real{a=6666}
\integer{size=10}
\text{enonc=Dans une petite ville de la province de Hakka, en Chine, au bord de la Rivière des Perles, vivent 3333 familles qui ont chacune au moins une bicyclette. 
<br><br>Aucune famille ne possède plus de trois bicyclettes; 
<br>il y a autant de familles propriétaires de trois bicyclettes que de familles qui n'en ont qu'une; 
<br>le nombre de familles qui possèdent deux bicyclettes est neuf fois plus grand que le nombre de celles qui en possèdent trois.
<br><br>
Combien y a-t-il de bicyclettes dans cette ville  &#63;}

\statement{
<table>
<tr><td><br><br>\enonc
<br><br> Dans cette ville, il y a \embed{r1,\size} bicyclettes.
</td><td>\ill</td>
</tr></table>}


\answer{reponse}{\elev}{type=raw}

\text{elev=wims(translate , to . in \elev)}
