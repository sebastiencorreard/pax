\title{Les bonnes notes récompensées}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/500F.jpg> }
\integer{a=16}
\integer{size=5}
\text{enonc=Un père promet de donner à son enfant 500F à chaque fois qu'il obtient au moins un 10 en maths. 
<br>Au contraire, chaque fois que l'enfant a moins que 10, il doit payer 800F à son père.
<br><br>Dans l'année, l'enfant a eu 26 devoirs de maths et pourtant, aucun ne doit d'argent à l'autre.
<br><br>
Combien de fois l'enfant a-t-il obtenu au moins 10 en maths &#63;}

\statement{
<table>
<tr><td><br><br>\enonc
<br><br> L’enfant a obtenu \embed{r1,\size} fois une note d’au moins 10.
</td><td>\ill</td>
</tr></table>}


\answer{}{\rep}{type=default}
\condition{Bonne réponse }{\rep=\a}
