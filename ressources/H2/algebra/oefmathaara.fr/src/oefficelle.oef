\title{Jeu de ficelle sur la plage}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/ficelle.jpg> }
\real{a=95}
\integer{size=10}
\text{enonc=Hereone s’amuse sur la plage. Elle plante cinq tiges et tend une ficelle entre chaque tige. Voilà à peu près ce que ça donne puisque le dessin n’est pas à l’échelle . 
<br><br>
Les angles \(\hat P), \(\hat I), \(\hat T) et \(\hat O) sont les angles intérieurs du quadrilatère formé.
<br><br>
L’angle \(\hat I) mesure trois degrés de plus que l’angle \(\hat P)
<br><br>
L’angle \(\hat T) mesure cinq degrés de moins que l’angle \(\hat I).
<br><br>
L’angle \(\hat O) mesure neuf degrés de plus que l’angle \(\hat T).
<br><br>
Quelle est la mesure de l’angle \(\hat O)  &#63;}

\statement{
<table>
<tr><td><br><br>\enonc
<br><br> L'angle \(\hat O) mesure \embed{r1,\size} degrés.
</td><td>\ill</td>
</tr></table>}


\answer{reponse}{\elev}{type=raw}

\text{elev=wims(translate , to . in \elev)}
\condition{Bonne Reponse : }{\elev=\a}
