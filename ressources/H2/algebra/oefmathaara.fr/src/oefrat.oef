\title{L'année du rat}
\language{fr}
\range{-5..5}
\author{Jean-Luc DONADONI}
\email{jluc.donadoni@laposte.net}
\computeanswer{no}
\format{html}
\precision{1000}

\text{ill=<img src=\imagedir/rat.jpg> }
\real{a=10}
\real{b=14}
\integer{size=3}
\text{enonc=Il y a deux groupes de rats, les rats gris et les rats blancs
<br><br>
Le chef des rats gris dit au chef des rats blancs :
<br>« Donne moi deux rats et nous serons le même nombre. »
<br><br>
Le chef des rats blancs dit au chef des rats gris : 
<br>« Pas question ! donne moi deux rats et dans mon clan nous serons deux fois plus nombreux que dans le tien . »
<br><br>
Quel est le nombre de rats gris &#63; 
<br><br>
Quel est le nombre de rats blancs &#63; }

\statement{
<table>
<tr><td><br><br>\enonc
</td><td>\ill</td>
</tr></table>
<br><br>
Il y a \embed{r1,\size} rats gris et \embed{r2,\size} rats blancs}


\answer{reponse}{\c1}{type=raw}
\answer{reponse}{\c2}{type=raw}

\condition{Bonne Reponse : }{\c1=\a and \c2=\b}
