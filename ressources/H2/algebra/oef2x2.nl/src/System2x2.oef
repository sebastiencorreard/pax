\title{Systeem 2x2}
\language{nl}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{a1=3*random(-3..2)+random(1,2)}
\integer{b1=3*random(-3..2)+random(1,2)}
\integer{s=3*random(-3..2)+random(1,2)}
\integer{t=3*random(-3,-2,-1,1,2,3)}
\integer{v=random(0,1)}
\integer{a2=\v=0?\s:\t}
\integer{b2=\v=0?\t:\s}
\integer{x=random(-5..5)}
\integer{y=random(-5..5)}
\text{e1=htmlmath(\a1*x+\b1*y)}
\text{e2=htmlmath(\a2*x+\b2*y)}
\integer{c1=\a1*(\x)+(\b1)*(\y)}
\integer{c2=\a2*(\x)+(\b2)*(\y)}

\statement{Los het volgende stelsel van vergelijkingen op voor <b>\(x)</b> en <b>\(y)</b>.
<p><center><table border=0>
	<tr><td align=right>\e1<td>=<td>\c1
	<tr><td align=right>\e2<td>=<td>\c2
</table></center> <p>}


\answer{\(x)}{\x}{type=default}
\answer{\(y)}{\y}{type=default}



