\title{Restaurant}
\language{nl}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x=random(2..8)}
\integer{y=random(2..8)}
\integer{pers=\x+\y}
\integer{child=random(13..25)}
\integer{adult=random(\child*1.2..\child*1.8)}
\integer{tot=\child*\x+\adult*\y}

\statement{\pers mensen gaan naar een restaurant.
<p>
Het kinderdagmenu kost \child &euro; per kind, en \adult &euro; voor
een volwassene.<br>
De totale kosten bedragen voor dit etentje \tot &euro;.
<p>
Hoeveel kinderen en hoeveel volwassenen zitter er onder
deze \pers personen?
}

\answer{Kinderen}{\x}{type=default}
\answer{volwassenen}{\y}{type=default}
\solution{Laat x het aantal kinderen zijn, en y het aantal volwassenen
<br>
We hebben dus nu het volgende stelsel van vergelijkingen:<p><center>
	x + y = \pers<br>
	\child x + \adult y = \tot
</center> <p>
En de oplossing van dit stelsel van vergelijkingen is dus: x=\x en  y=\y.<br>
Dus \x kinderen en \y volwassenen.
}
