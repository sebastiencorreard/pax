\title{Rechthoek}
\language{nl}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{y=random(20..50)}
\integer{diff=random(20..50)}
\integer{x=\y+\diff}
\integer{peri=2*(\x+\y)}

\statement{We hebben een rechthoek met een omtrek van \peri millimeter. <br>
Gegeven is verder dat de lengte \diff millimeter groter is dan de breedte,<br>
Bereken met deze gegevens de lengte en de breedte van deze rechthoek (in millimeter)
}

\answer{Lengte}{\x}{type=default}
\answer{Breedte}{\y}{type=default}
\solution{Laat x = lengte, y = breedte.<br>
Dan hebben we dus het volgende stelsel van vergelijkingen:
 <p><center>
	2x + 2y = \peri<br>
	x - y = \diff
</center> <p>
En de oplossing van dit systeem is dus: x=\x en  y=\y
}
