 !exit
!endif

tmp0=!randint 20, 50

val6=$[rint($(tmp0))]
tmp0=!randint 20, 50

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
val9=$[rint(2*($val8+$val6))]
replytype1=default
replyname1=Lengte
replygood1=$val8
replytype2=default
replyname2=Breedte
replygood2=$val6
question=__EXECUTED_1692754_EXERCISE__
solution=!nosubst Laat x = lengte, y = breedte.<br> Dan hebben we dus het volgende stelsel van vergelijkingen: <p><center> 2x + 2y = $val9<br> x - y = $val7 </center> <p> En de oplossing van dit systeem is dus: x=$val8 en y=$val6 


!goto stat

!exit

:question
