!set title=Operación 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=ambali@free.fr

ansorder=r,r
varcnt=14
prevarcnt=12
postvarcnt=1
replycnt=2
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Completar la igualdad para que esté comprobada
val8=Dar el resultado en la forma
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 1, 20

tmp1=!randitem -1,1

val12=$[rint($(tmp0)*$(tmp1))]
t_=!rawmath $val9 / $val10
val13=!exec pari print($t_)
t_=!rawmath $val11 / $val12
val14=!exec pari print($t_)
tmp0=!randint 1, 10

tmp1=!randitem -1,1

val15=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in  $val13*$val14
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val16=!exec pari print($t_)
t_=!replace internal \( by ( in ($val16)^($val15)
tmp0=!exec pari $t_

val17=$[$(tmp0)]
replyname1=
replygood1=?analyze 18
replyname2=
replygood2=?analyze 19
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$val7 :	<div class="wimscenter">	 
!insmath  ($val13)^{$val15} \times ($val14)^{$val15} = 
$()  
!read oef/embed.phtml  reply1 ,8 
$()<sup> 
!read oef/embed.phtml reply2,3 
$()</sup>	</div>	<div class="wims_instruction">$val8 
!insmath a^p
$().</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
t_=!replace internal \( by ( in ($val18)^($val19)
tmp0=!exec pari $t_

val20=$[$(tmp0)]

!exit

:feedback

!exit

:test

!ifval ($val18=$val16 or $val18=(-1)*$val16 or $val18=1/$val16 or $val18=(-1)/$val16)	and ($val19=$val15 or $val19=(-1)*$val15) and ($val20 =$val17)
 condtest1=1
!else
 condtest1=0
!endif
condname1=

!exit

:stat
vsavelist=7,8,13,14,15,16,17,18,19
embedcnt=2
