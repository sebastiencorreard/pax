val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=dénominateur
val8=numérateur
val9=Remplissez le,ci-dessous pour établir l'égalité&nbsp;:
val10=Le
val11=$val7
tmp0=!randitem 2,4

val12=$(tmp0)
val13=1,2,3,4,5,6,8,10
tmp0=!itemcnt $val13

val14=$[rint($(tmp0))]
val15=1/2,3/2,5/2,1/3,2/3,4/3,5/3,	1/4,3/4,5/4,1/5,2/5,3/5,4/5,6/5,1/6,5/6
val16=
!for val17  in $val15 
tmp0=!translate / to , in $val17

val18=$(tmp0)
tmp0=!values $(val18[1])*x for x in $val13

val19=$(tmp0)
tmp0=!values $(val18[2])*x for x in $val13

val20=$(tmp0)
val21=
!for val22 =1 to $val14 
tmp0=!append item $(val19[$val22])/$(val20[$val22]) to $val21

val21=$(tmp0)
!next
tmp0=!shuffle $val21

tmp=!trim $val16	$(tmp0)
val16=!translate internal $	\
$ to ;; in $tmp
!next
tmp=!translate internal $	$ to ; in $val16

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val15=$(tmp0)
tmp0=!translate internal / to , in $(val15[1])

val23=$(tmp0)
tmp0=!translate internal / to , in $(val15[2])

val24=$(tmp0)
tmp0=!item $val12 of $val23,$val24

val25=$(tmp0)
val26=<hr style="height:2px;background-color:black" />
tmp0=!nospace 60 px

val27=$(tmp0)
val28=<span class="bold" style="font-size:30px;">
val29=</span>
val30=2
replytype1=numeric
replyname1=$val10 $val11
replygood1=$[$val25]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

