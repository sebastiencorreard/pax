:postdef
val38=
tmp0=!replace internal \over by / in $val32,$val33,$val34,$val35,$val36,$val37

val39=$(tmp0)
tmp0=!text select /1234567890, in $val39

val39=$(tmp0)
t_=!replace internal \( by ( in ($(val39[1]))-($(val39[2]))
tmp0=!exec pari $t_

val40=$(tmp0)
t_=!replace internal \( by ( in ($(val39[3]))-($(val39[4]))
tmp0=!exec pari $t_

val41=$(tmp0)
t_=!replace internal \( by ( in ($(val39[5]))-($(val39[6]))
tmp0=!exec pari $t_

val42=$(tmp0)

