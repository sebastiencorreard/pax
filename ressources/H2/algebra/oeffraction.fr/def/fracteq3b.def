 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Parmi les fractions présentées ci-dessous,trouvez,qui sont égales.
val8=Les fractions identiques :
val9=Première paire :
val10=Deuxième paire :
val11=Troisième paire :
val12=Fraction
val13=deux,deux paires, trois paires
val14=1,2,3,4,5,6
tmp0=!itemcnt $val14

val15=$[rint($(tmp0))]
val16=1/2,3/2,5/2,1/3,2/3,4/3,5/3,	1/4,3/4,5/4,1/5,2/5,3/5,4/5,6/5,1/6,5/6
val17=
!for val18  in $val16 
tmp0=!translate / to , in $val18

val19=$(tmp0)
tmp0=!values $(val19[1])*x for x in $val14

val20=$(tmp0)
tmp0=!values $(val19[2])*x for x in $val14

val21=$(tmp0)
val22=
!for val23 =1 to $val15 
tmp0=!append item $(val20[$val23])/$(val21[$val23]) to $val22

val22=$(tmp0)
!next
tmp0=!shuffle $val22

tmp=!trim $val17	$(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
!next
tmp0=!itemcnt $val16

tmp1=!values 0 for x=1 to 100

tmp2=!item 1 to $(tmp0) of 3,2,2,1,1,	 $(tmp1)

val24=$(tmp2)
tmp0=!shuffle $val24

val24=$(tmp0)
val25=
tmp0=!itemcnt $val16

!for val18 =1 to $(tmp0) 
!if $(val24[$val18])>0 
val26=$(val17[$val18;1..$(val24[$val18])])
tmp0=!append item $val26 to $val25

val25=$(tmp0)
!endif
!next
tmp0=!itemcnt $val25

val27=$[rint($(tmp0))]
val28=
!for val29  in $val25 
tmp0=!replace internal / by \over in $val29

val26=$(tmp0)
tmp0=!append item \({$val26}) to $val28

val28=$(tmp0)
!next
val30=40x60x1
tmp0=!item 3 of $val13

val31=$(tmp0)
replytype1=dragfill
replyname1=$val12 1
replygood1=?analyze 32;$(val28[1]),$(val28[$m_3*2+1..$val27])
replytype2=dragfill
replyname2=$val12 2
replygood2=?analyze 33;$(val28[2])
replytype3=dragfill
replyname3=$val12 3
replygood3=?analyze 34;$(val28[3])
replytype4=dragfill
replyname4=$val12 4
replygood4=?analyze 35;$(val28[4])
replytype5=dragfill
replyname5=$val12 5
replygood5=?analyze 36;$(val28[5])
replytype6=dragfill
replyname6=$val12 6
replygood6=?analyze 37;$(val28[6])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

