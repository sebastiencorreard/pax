\if{\step=2}{
 \text{nstep=r2,r3,r4,r5,r6,r7,r8,r9}
}
\text{test1=\test1<1 and \m1>0 and \m1=floor(\m1) and \m2>0 and \m2=floor(\m2)
    and \nn1=\num1*\m1 and \nd1=\den1*\m1
    and \nn2=\num2*\m2 and \nd2=\den2*\m2
