\text{name_answer4=Nieuwe teller}
\text{name_answer5=Nieuwe noemer}
\text{name_answer6=Teller van de som}
\text{name_answer7=Noemer van de som}
\text{name_condition1=De vermenigvuldigin is correct}
\text{name_condition2=De optelling is goed}
\text{name_feedback1=De twee breuken hebben verschillende noemers,Deze kun je nooit direct optellen ; altijd eerst herschrijven zodat ze een geljke noemer hebben.}
\text{name_feedback2=Om de breuken niet in getalswaarde mogen veranderen moeten
