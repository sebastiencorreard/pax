!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Among the fractions presented below,find,that are equal.
val8=The equal fractions:
val9=First pair:
val10=Second pair:
val11=Third pair:
val12=Fraction
val13=two, two pairs, three pairs
!if $val6=it 
val7=Tra le frazioni elencate sotto, individuarne,	che siano equivalenti.
val8=Le frazioni equivalenti:
val9=Prima coppia:
val10=Seconda coppia:
val11=Terza coppia:
val12=Frazione
val13=due, due coppie, tre coppie
!endif
!if $val6=fr 
val7=Parmi les fractions présentées ci-dessous,trouvez,qui sont égales.
val8=Les fractions identiques :
val9=Première paire :
val10=Deuxième paire :
val11=Troisième paire :
val12=Fraction
val13=deux,deux paires, trois paires
!endif
!if $val6=nl 
val7=Uit de onderstaande breuken ,zoek ,die gelijkwaardig zijn.
val8=De gelijke breuken:
val9=Eerste paar:
val10=Tweede paar:
val11=Derde paar:
val12=Breuken
val13=twee, twee paar, drie paar
!endif
val14=1,2,3,4,5,6
tmp0=!itemcnt $val14

val15=$[rint($(tmp0))]
val16=1/2,3/2,5/2,1/3,2/3,4/3,5/3,	1/4,3/4,5/4,1/5,2/5,3/5,4/5,6/5,1/6,5/6
val17=
!for val18  in $val16 
tmp0=!translate / to , in $val18

val19=$(tmp0)
tmp0=!values $(val19[1])*x for x in $val14

val20=$(tmp0)
tmp0=!values $(val19[2])*x for x in $val14

val21=$(tmp0)
val22=
!for val23 =1 to $val15 
tmp0=!append item $(val20[$val23])/$(val21[$val23]) to $val22

val22=$(tmp0)
!next
tmp0=!shuffle $val22

tmp=!trim $val17	$(tmp0)
val17=!translate internal $	\
$ to ;; in $tmp
!next
tmp0=!itemcnt $val16

tmp1=!values 0 for x=1 to 100

tmp2=!item 1 to $(tmp0) of 2,1,	 $(tmp1)

val24=$(tmp2)
tmp0=!shuffle $val24

val24=$(tmp0)
val25=
tmp0=!itemcnt $val16

!for val18 =1 to $(tmp0) 
!if $(val24[$val18])>0 
val26=$(val17[$val18;1..$(val24[$val18])])
tmp0=!append item $val26 to $val25

val25=$(tmp0)
!endif
!next
tmp0=!itemcnt $val25

val27=$[rint($(tmp0))]
val28=
!for val29  in $val25 
tmp0=!replace internal / by \over in $val29

val26=$(tmp0)
tmp0=!append item \({$val26}) to $val28

val28=$(tmp0)
!next
val30=40x60x1
tmp0=!item 1 of $val13

val31=$(tmp0)
replytype1=dragfill
replyname1=$val12 1
replygood1=?analyze 32;$(val28[1]),$(val28[$m_1*2+1..$val27])
replytype2=dragfill
replyname2=$val12 2
replygood2=?analyze 33;$(val28[2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

