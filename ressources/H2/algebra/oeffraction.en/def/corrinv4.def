!set title=Correspondance inverse 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=XIAO, Gang
email=xiao@unice.fr
language=en
computeanswer=no
precision=10000
title_it=Corrispondenza tra inverse 4
title_fr=Correspondance inverse 4
title_nl=Overeenkomstig invers 4

ansorder=r
varcnt=35
prevarcnt=34
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Establish the correspondance between
val8=the fractions and their inverses.
val9=The correspondance
!if $val6=it 
val7=Mettere in corrispondenza
val8=ciascuna frazione con la sua inversa.
val9=La corrispondenza
!endif
!if $val6=fr 
val7=Etablissez la correspondance entre
val8=les fractions et leurs inverses.
val9=La correspondance
!endif
!if $val6=nl 
val7=Slepen: tussen 
val8=de breuken met hun inversen.
val9=De overeenkomstigheid
!endif
val10=$[rint(4)]
val11=1,2,3,4,5,6,8,9,10,12
tmp0=!itemcnt $val11

val12=$[rint($(tmp0))]
val13=1/2,3/2,5/2,1/3,2/3,4/3,5/3,	1/4,3/4,5/4,1/5,2/5,3/5,4/5,6/5,1/6,5/6
val14=
!for val15  in $val13 
tmp0=!translate / to , in $val15

val16=$(tmp0)
tmp0=!values $(val16[1])*x for x in $val11

val17=$(tmp0)
tmp0=!values $(val16[2])*x for x in $val11

val18=$(tmp0)
val19=
!for val20 =1 to $val12 
tmp0=!append item $(val17[$val20])/$(val18[$val20]) to $val19

val19=$(tmp0)
!next
tmp0=!shuffle $val19

tmp=!trim $val14	$(tmp0)
val14=!translate internal $	\
$ to ;; in $tmp
!next
tmp0=!itemcnt $val13

tmp1=!shuffle $(tmp0)

val21=$(tmp1)
tmp0=!translate internal / to , in $(val14[$(val21[1..$val10]);1,2])

val22=$(tmp0)
val23=
val24=
!for val25 =1 to $val10 
tmp0=!append item \($(val22[$val25;1])/($(val22[$val25;2]))) to $val23

val23=$(tmp0)
tmp0=!append item \($(val22[$val25;4])/($(val22[$val25;3]))) to $val24

val24=$(tmp0)
!next
val26=50x50x50
replytype1=correspond
replyname1=$val9
replygood1=$val23;$val24
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

