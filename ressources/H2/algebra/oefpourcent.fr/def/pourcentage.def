val7=een lengte, een volume,een hoogte,een gewicht,een prijs
val8=verhoogt,verlaagt
val9=Je,met,Met hoeveel moeten wij, vermenigvuldigen 
val10=Je moet vermenigvuldigen met
!endif
tmp0=!randint 10, 90

val11=$[rint($(tmp0))]
tmp0=!randint 1, 5

val12=$(tmp0)
tmp0=!item $val12 of $val7

val13=$(tmp0)
tmp0=!item $val12 of l,v,h,m,p

val14=$(tmp0)
tmp0=!randitem 1,-1

val15=$(tmp0)
val16=$val8

!ifval $val15=1 
tmp0=!item 1 of $val16

val17= $(tmp0)
!else
tmp1=!item 2 of $val16

val17=$(tmp1)
!endif
val18=$[(100+($val15)*$val11)/100]
replytype1=numeric
replyname1=$val10
replygood1=$[$val18]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

