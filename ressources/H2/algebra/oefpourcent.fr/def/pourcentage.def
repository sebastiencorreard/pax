val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=une longueur,une hauteur,une masse,un prix,un volume,un poids
val8=augmente,diminue
val9=On,de ,Par combien doit-on multiplier 
val10=On doit multiplier par
!if $val6=es 
val7=una longitud, una altura, una masa,un volumen, un precio
val8=aumenta, disminuye
val9=Se,de , ¿Por cuánto debemos multiplicar 
val10=Se debe multiplicar por
!endif
