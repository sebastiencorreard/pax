\matrix{name_statement=Write the number, in two ways
  scientific notation
  as,with \(a\) an integer and not multiple of 10}
\text{name_answer=scientific notation,exponent,\(a\), exponent}
\integer{n=randint(3..8)}
\integer{p=random(randint(5..7),randint(1..5))}
\real{a=randint(10^(\n)..10^(\n+1)-1)}
\real{A=\a/10^(\p)}
\real{s=\a}
\integer{ct=0}
\for{i=1 to \n}{\real{b=10*floor(\s/10)}
\if{\b=\s}{
  \real{s=\s/10}
  \integer{ct=\ct+1}}
}
\real{sol1= \a/10^(\n)}
\real{sol2=\n-(\p)}
\text{sol3=pari(\s)}
\real{sol4=\ct-\p}
\statement{\name_statement[1;1] \(\A\) \name_statement[1;2]:
<ul><li>
\name_statement[2;]
 <div class="wimscenter"> \(\A\)
= \embed{reply 1, 12}\times 10<sup><sup>\embed{reply 2,4}</sup></sup></div>
</li><li>
\name_statement[3;1] \(a 10^p\) \name_statement[3;2]
<div class="wimscenter">\(\A\)
= \embed{reply 3, 12} \times 10<sup><sup>\embed{reply 4,4}</sup></sup></div>
</li></ul>
}
