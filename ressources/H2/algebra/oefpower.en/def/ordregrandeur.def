!set title=Order of magnitude
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=ambali@free.fr

ansorder=r,r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Determine an order of magnitude for the number
val8=If necessary, the exponent in the power of 10 can be zero.
tmp0=!randint 3, 6

val9=$[rint($(tmp0))]
tmp0=!randint 5, 7

tmp1=!randint 1, 3

tmp2=!randitem $(tmp0),$(tmp1)

val10=$[rint($(tmp2))]
tmp0=!randint 10^($val9), 10^($val9 + 1)-1

val11=$[$(tmp0)]
val12=$[$val11/10^($val10)]
val13=$[$val11/10^($val9)]
val14=$[$val9-$val10]
val15=$[$val14]
val16=$[rint($val13)]
!if $val16=10 
val16=$[1]
val15=$[$val15+1]
!else
!endif
replyname1=
replygood1=$val16
replyname2=
replygood2=$val15
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	  $val7 
!insmath  A = $val12
$().	<div class="wimscenter">	
!insmath A = 
$()  
!read oef/embed.phtml  reply1 ,3 
$()
!insmath  \times 10 
$() <sup> 
!read oef/embed.phtml reply2,3 
$()</sup></div>	<div class="wims_instruction">	$val8	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,8,12
embedcnt=2
