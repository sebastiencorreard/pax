!set title=Definition of power; relative integer exponent
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Jean-Baptiste, Frondas
email=ambali@free.fr

ansorder=r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Determine the value of the number
val8=Give the result as an integer or an irreducible fraction.
tmp0=!randint 2, 6

val9=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,-1,1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -6, -2

val11=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,-1,1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 6

val13=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,-1,1

val14=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint -6, -2

val15=$[rint($(tmp0))]
tmp0=!randint 2, 4

tmp1=!randitem -1,-1,1

val16=$[rint($(tmp0)*$(tmp1))]
t_=!replace internal \( by ( in  $val9^$val10
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val17=!exec pari print($t_)
t_=!replace internal \( by ( in  ($val11)^$val12
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val18=!exec pari print($t_)
t_=!replace internal \( by ( in  -1*(($val13)^($val14))
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val19=!exec pari print($t_)
t_=!replace internal \( by ( in  -1*(($val15)^($val16))
tmp0=!exec pari $t_

t_=!rawmath $(tmp0)
val20=!exec pari print($t_)
val21=$val9^$val10
val22=($val11)^$val12
val23=-$val13^$val14
val24=-($val15)^$val16
tmp0=!randint 1, 4

val25=$[rint($(tmp0))]
!if $val25=1 
val26=$val21
t_=!rawmath $val17
val27=!exec pari print($t_)
!endif
!if $val25=2 
val26=$val22
t_=!rawmath $val18
val27=!exec pari print($t_)
!endif
!if $val25=3 
val26=$val23
t_=!rawmath $val19
val27=!exec pari print($t_)
!endif
!if $val25=4 
val26=$val24
t_=!rawmath $val20
val27=!exec pari print($t_)
!endif
replyname1=\(A\)
replygood1=$val27
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

