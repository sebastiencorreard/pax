!set title=Table of powers
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=10
prevarcnt=9
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Complete the table
val8=Be careful ! We have always
tmp0=!randint 3, 6

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 3, 9

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
val11=$[rint($val9*($val10))]
val12=$[rint(($val11)^2)]
val13=$[rint(($val9)^2)]
val14=$[rint(($val10)^2)]
replytype1=litexp
replyname1=\($val10*a\)
replygood1=$val11
replytype2=litexp
replyname2=\(($val10*a)^2\)
replygood2=$val12
replytype3=litexp
replyname3=\(a^2\)
replygood3=$val13
replytype4=litexp
replyname4=\($val14*a^2\)
replygood4=$val12
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7:	<div class="unbreakable">	<table class="wimscenter wimsborder">	<tr><td>
!insmath a
$()</td><td><label for="reply1">
!insmath $val10 a
$()</label></td><td><label for="reply2">
!insmath ($val10 a)^2
$()	</label></td><td><label for="reply3">
!insmath a^2
$()</label></td>	<td><label for="reply4">
!insmath $val14 a^2
$()</label></td></tr>	<tr><td>$val9</td><td> 
!read oef/embed.phtml reply 1,6 
$()</td>	<td> 
!read oef/embed.phtml reply 2,6 
$()</td>	<td> 
!read oef/embed.phtml reply 3,6 
$()</td>	<td> 
!read oef/embed.phtml reply 4,6 
$()</td>	</tr>	</table>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_reply2 <>$m_reply4
 <div class='oef_feedbacks'>$val8 
!insmath ($val10 a)^2=$val14 a^2
$().
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=7,8,9,10,14
embedcnt=4
