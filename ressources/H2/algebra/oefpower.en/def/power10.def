!set title=Powers of 10
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Bernadette, Perrin-Riou
email=bernadette.m.riou@orange.fr
language=fr
leftrange=-5.000000
rightrange=5.000000
computeanswer=no
precision=10000

ansorder=r
varcnt=15
prevarcnt=14
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

!readproc slib/oef/env lang 
tmp0=$slib_out
val6=$(tmp0)
val7=Write the number as 
val8=exponent
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val9=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val10=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val11=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val12=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val13=$[rint($(tmp0)*$(tmp1))]
val14=10^{$val9}
val15=10^($val10)
val16=10^($val12)
val17=10^($val11)
val18=10^($val13)
val19=$[rint(($val9)+($val10)+($val12)-($val11)-($val13))]
replytype1=numeric
replyname1=$val8
replygood1=$[$val19]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()$val7 
!insmath 10^n
$() :	<div class="wimscenter"> 
!insmath \frac{10^{$val9}\times 10^{$val10} \times 10^{$val12}}{10^{$val11}\times 10^{$val13}}
$()	= 10<sup><sup> 
!read oef/embed.phtml reply 1,3 
$()</sup></sup></div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=7,9,10,11,12,13
embedcnt=1
