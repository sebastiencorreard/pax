\title{矩形}
\language{cn}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{y=random(20..50)}
\integer{diff=random(20..50)}
\integer{x=\y+\diff}
\integer{peri=2*(\x+\y)}

\statement{有一个周长是 \peri 毫米的矩形。长比宽长 \diff 毫米, 解出长和宽(毫米).}

\answer{长}{\x}{type=default}
\answer{宽}{\y}{type=default}
\solution{设 x = 长, y = 宽。那么我们有下面的方程组。
<p><center> 	2x + 2y = \peri<br>
 	x - y = \diff </center><p>
解这个方程组得 x=\x, y=\y.} 

