\title{餐馆}
\language{cn}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x=random(2..8)}
\integer{y=random(2..8)}
\integer{pers=\x+\y}
\integer{child=random(13..25)}
\integer{adult=random(\child*1.2..\child*1.8)}
\integer{tot=\child*\x+\adult*\y}

\statement{\pers 人去餐馆吃晚餐。
<p>小孩每位 \child 美元, 大人每位 \adult 美元。 这顿晚餐总共花去 \tot 美元。 
<p> 这 \pers 人中, 有多少小孩和多少大人? }

\answer{小孩}{\x}{type=default}
\answer{大人}{\y}{type=default}
\solution{设小孩数为 x , 大人数为 y 。 我们有下列方程组。
<p><center> 	x + y = \pers<br>
 	\child x + \adult y = \tot </center>
<p> 解这个方程组得 x=\x, y=\y. }

