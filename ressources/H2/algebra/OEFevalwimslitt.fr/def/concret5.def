!set title=Établir une formule 5
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items A,B,C,D

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!translate internal $	$ to ; in x,y	a,b	u,v

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val7=$(tmp0)
tmp0=!shuffle $val7

val7=$(tmp0)
tmp0=!shuffle 2,3,4,6,8,10

val8=$(tmp0)
val9=$(val8[1])*$(val7[1])+$(val8[2])*$(val7[2])
val10=Un restaurateur dispose de tables de $(val8[1]) places et	  de tables de $(val8[2]) places. Dans sa salle, il met en place \($(val7[1])\) tables de	  $(val8[1]) places et \($(val7[2])\) tables de $(val8[2]) places.	
val11=Exprimer le nombre \($val6\) de chaises	  dont il a besoin en fonction de \($(val7[1])\) et de \($(val7[2])\).	
replytype1=algexp
replyname1=$val6
replygood1=$val9
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val10 \end{statement} $val11 


!goto stat

!exit

:question
$()	$val10	<p>$val11</p>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val10 $m_end{statement} $val11 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=10,11
embedcnt=0
