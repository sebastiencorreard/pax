!set title=Simplifier une expression 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22

ansorder=r
varcnt=18
prevarcnt=17
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=1
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Simplifier l'expression suivante&nbsp;
val7=Vous ne devez écrire que les symboles indispensables.
val8=Réponse
val9=Bonne réponse
val10=La bonne réponse est 
val11=Aucun symbole mutiplié n'est nécessaire
val6=Simplifier l'expression suivante&nbsp;
val7=Vous ne devez écrire que les symboles indispensables.
val8=Réponse
val9=Bonne réponse
val10=La bonne réponse est 
val11=Aucun symbole mutiplié n'est nécessaire
tmp0=!shuffle 2,3,4,5,6,7,8,9

val12=$(tmp0)
tmp=!nonempty items x,y,a,b

tmp0=!randitem $tmp
val13=$(tmp0)
val14=$(val12[1]) \times $val13 + $(val12[2])
val15=$(val12[1])$val13+$(val12[2]) $(val12[2])+$(val12[1])$val13
tmp0=!word 1 of $val15

val16=$(tmp0)
replytype1=raw
replyname1=$val8
replygood1=?analyze 17
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val6: \($val14 \). \end{statement}


!goto stat

!exit

:question
$()	$val6:	<div class="wimscenter">	 
!insmath $val14 = 
$()  
!read oef/embed.phtml r1,7 
$().	</div>	<div class="wims_instruction">$val7</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()$val10 
!insmath $val16
$().<br>	$val11.
$()
!exit

:latex
$()$m_begin{statement} $val6: 
!insmath $val14 
$(). $m_end{statement}
$()
!exit

:feedback

!exit

:test

!ifval $val17 iswordof $val15
 condtest1=1
!else
 condtest1=0
!endif
condname1=$val9

!exit

:stat
vsavelist=6,7,9,10,11,14,15,16,17
embedcnt=1
