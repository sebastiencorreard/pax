!set title=Établir une formule 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Écrire la formule,	  donnant la mesure de l'aire de la figure ci-dessous en fonction de 
tmp=!nonempty items A,B,C,D

tmp0=!randitem $tmp
val7=$(tmp0)
tmp=!nonempty items x,y,a,b,u,v

tmp0=!randitem $tmp
val8=$(tmp0)
tmp0=!randint 2, 5

val9=$[rint(2*$(tmp0))]
tmp=!translate ";': to $     $ in $val9^2+$val9*$val8/2

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val10=$(tmp0)
t_=!replace internal \( by ( in expand($val10);
tmp0=!exec maxima $t_

val11=$(tmp0)
!readproc oef/draw.phtml 300,150 \
square 10,100,10,red	circle 60,10,8,red	circle 10,60,8,red	circle 110,60,8,red	circle 60,110,8,red	square 10,10,100, black	triangle 110,110,110,10,290,110,black	text black,60,120,medium,$val9	text black,200,120,medium,$val8	 
tmp0=$ins_url
val12=$(tmp0)
replytype1=algexp
replyname1=\($val7\)
replygood1=$val10,$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	$(val6[1]) 
!insmath $val7
$() $(val6[2]) 
!insmath $val8
$().	<div class="wimscenter">	<img src="$val12" alt="">	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
