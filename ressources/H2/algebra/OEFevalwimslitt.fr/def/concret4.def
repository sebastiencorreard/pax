!set title=Établir une formule 4
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items A,B,C,D

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items x,y,a,b,u,v

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!randint 1, 3

val8=$[rint(100*$(tmp0))]
tmp=!translate ";': to $     $ in 2*$val8/$val7

tmp=!lower $tmp
tmp0=!exec maxima fullratsimp($tmp);
val9=$(tmp0)
val10=$val9+2
val11=Un jardinier plante des arbres des deux côtés d'un chemin de	  \($val8 m\) de long. Il plante un arbre tous les \($val7\) mètres.
val12=Quelle est la formule,	  qui permet de déterminer le nombre d'arbres que le jardinier doit acheter&nbsp;
replytype1=algexp
replyname1=\($val6\)
replygood1=$val9,$val10
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val11 $(val12[1]) \($val6\) $(val12[2])? \end{statement}


!goto stat

!exit

:question
$()	$val11	$(val12[1]) 
!insmath $val6
$() $(val12[2])?
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val11 $(val12[1]) 
!insmath $val6
$() $(val12[2])? $m_end{statement}
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,11,12
embedcnt=0
