!set title=Établir une expression littérale 1
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=la somme de, et de
val7=Pour un nombre, comment s'écrit
val8=Votre réponse
tmp0=!shuffle 2,3,4,5,6,7,8,9

val9=$(tmp0)
tmp=!nonempty items x,y,a,b

tmp0=!randitem $tmp
val10=$(tmp0)
val6=$(val6[1]) \($val10\) $(val6[2]) $(val9[1])
val11=$val10+$(val9[1]),$(val9[1])+$val10
replyname1=
replygood1=$val11
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $(val7[1]) \($val10\), $(val7[2]) $val6 ? \end{statement} 


!goto stat

!exit

:question
$()	$(val7[1]) 
!insmath $val10
$(), $(val7[2]) $val6 ?	<div>	<span class="bold">$val8&nbsp;: </span>  
!read oef/embed.phtml r1,7 
$()	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $(val7[1]) 
!insmath $val10
$(), $(val7[2]) $val6 ? $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,7,8,10
embedcnt=1
