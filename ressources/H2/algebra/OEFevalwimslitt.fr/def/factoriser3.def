!set title=Factoriser une expression 3
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Fabrice, Guerimand

ansorder=r
varcnt=8
prevarcnt=7
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=Factoriser l'expression suivante&nbsp;
tmp0=!shuffle 2,3,4,5,6,7,8,9

val7=$(tmp0)
tmp=!nonempty items x,y,a,b

tmp0=!randitem $tmp
val8=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$[rint($(val7[1])*$(val7[2]))]
val11=$(val7[1]) \times $val8+$val10
val12=$(val7[1])*($val8+$(val7[2]))
replytype1=litexp
replyoption1=polfactor 
replyname1=\($val9\)
replygood1=$val12
question=__EXECUTED_1692754_EXERCISE__
latex=!nosubst \begin{statement} $val6 \begin{center}\($val9 = $val11\).\end{center} \end{statement} 


!goto stat

!exit

:question
$()	$val6	<div class="wimscenter">
!insmath $val9 = $val11
$().</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()$m_begin{statement} $val6 $m_begin{center}
!insmath $val9 = $val11
$().$m_end{center} $m_end{statement} 
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=6,9,11
embedcnt=0
