\title{Decimale getallen en machten van 10}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(3..8)}
\integer{p=random(randint(5..7),randint(1..5))}
\real{a=randint(10^(\n)..10^(\n+1)-1)}
\real{A=\a/10^(\p)}

\real{s=\a}
\integer{ct=0}
\for{i=1 to \n}{\real{b=10*floor(\s/10)}
\if{\b=\s}{\real{s=\s/10}
\integer{ct=\ct+1}}
}
\real{sol1= \a/10^(\n)}
\real{sol2=\n-(\p)}
\text{sol3=pari(\s)}
\real{sol4=\ct-\p}
\statement{Schrijf het getal \(\A) op twee manieren : 
<ul><li>
wetenschappelijke notatie
 <center> \(\A)
= \embed{reply 1, 12}  \times 10<sup><sup>\embed{reply 2,4}</sup></sup></center>
</li>
<li> 
als \(a  \times 10^p) met \(a)  integers en geen veelvoud van  10  :
<center> \(\A)
= \embed{reply 3, 12}  \times 10<sup><sup>\embed{reply 4,4}</sup></sup></center>
</li>
</ul>
}
\answer{exponent}{\sol1}{type=numeric}
\answer{exponent}{\sol2}{type=numeric}
\answer{exponent}{\sol3}{type=numeric}
\answer{exponent}{\sol4}{type=numeric}


