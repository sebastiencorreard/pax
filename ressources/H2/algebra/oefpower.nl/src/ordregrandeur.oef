\title{Orde grootte}
\email{ambali@free.fr}
\language{nl}
\author{Jean-Baptiste Frondas}
\integer{ n1 = random(3..6)}
\integer{ p = random(randint(5..7),randint(1..3))}
\real{ a = randint(10^(\n1)..10^(\n1 + 1)-1)}
\real{ b = \a/10^(\p)}	
\real{ result =\a/10^(\n1)}
\real{ expos=\n1-\p}
\real{ exposa=\expos}
\integer{ pe=\result}
\if{\pe=10}{\real{ pe=1} \real{ exposa=\exposa+1}}{}
\statement{<p style="text-align : center;
background-color : #FFFFFF;
padding : 1%;
margin : 5% 15%; ">
Bepaal de orde grootte van getal \(A) in: \( A = \b)<br/>
\(A = ) \embed{ reply1 ,3}\( \times 10 ) <sup>\embed{reply2,3}</sup></p>
<em>Let op: de macht kan ook 0 worden.</em>
}
\hint{Bijvoorbeeld: met <em>orde grootte<em> van het getal 2345.678 bedoelen we dus 2&times;10<sup>3</sup>}
\answer{}{\pe}
\answer{}{\exposa}
