\title{Tabel van Machten II}
\language{nl}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(2,3)}
\integer{m=randint(2,3)}
\integer{m=\m=\n? \m+1}
\integer{mn=\m*\n}
\integer{msn=\m+\n}
\integer{nn=\n^2}
\integer{mm=\m^2}
\integer{a=randint(2..5)*random(1,-1)}
\text{an=pari((\a)^\n)}
\text{am=pari((\a)^\m)}
\text{amn=pari((\a)^(\mn))}
\text{amsn=pari((\a)^(\msn))}
\text{ann=pari((\a)^(\nn))}
\text{amm=pari((\a)^(\mm))}
\statement{Vul de tabel verder in:
<table align="center" border=1 bgcolor="antiquewhite">
<tr align="center">
<td>&nbsp;&nbsp;\(a)&nbsp;&nbsp;</td>
<td>\( a^\n)</td>
<td>\(a^\m)</td>
<td>\((a^\n)^\n)</td>
<td>\((a^\n)^\m)</td>
<td>\((a^\m)^\m)</td>
<td>\(a^\m a^\n)</td>
<td>\(a^\mn)</td>
<td>\(a^\nn)</td>
<td>\(a^\mm)</td></tr>
<tr align="center">
<td>\a</td>
<td>\embed{reply 1,6}</td>
<td>\embed{reply 2,6}</td>
<td>\embed{reply 3,6}</td>
<td>\embed{reply 4,6}</td>
<td>\embed{reply 5,6}</td>
<td>\embed{reply 6,6}</td>
<td>\embed{reply 7,6}</td>
<td>\embed{reply 8,6}</td>
<td>\embed{reply 9,6}</td>
</tr>
</table>
}
\answer{\(a^\n)}{\an}{type=litexp}
\answer{\(a^\m)}{\am}{type=litexp}
\answer{\((a^\n)^\n)}{\ann}{type=litexp}
\answer{\((a^\n)^\m)}{\amn}{type=litexp}
\answer{\((a^\m)^\m)}{\amm}{type=litexp}
\answer{\(a^\m a^\n)}{\amsn}{type=litexp}
\answer{\(a^\mn)}{\amn}{type=litexp}
\answer{\(a^\nn)}{\ann}{type=litexp}
\answer{\(a^\mm)}{\amm}{type=litexp}
\feedback{\reply3 <>reply8}{ Opgelet:  \((a^\n)^\n = a^\nn)}
\feedback{\reply4<>reply7}{ Opgelet:  \((a^\n)^\m = a^\mn)}
\feedback{\reply5<>reply9}{ Opgelet:  \((a^\m)^\m = a^\mm)}
\feedback{\reply6 = \reply7 and \mn<>4}{Opgelet: in't algemeen is \(a^m*a^n) iets anders dan \(a^{mn})}
