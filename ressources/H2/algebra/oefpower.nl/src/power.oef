\title{Machten van een getal}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(2..5)}
\real{a=randint(2,3,5,4)}
\integer{c=randint(2,3,6,5,7,11)}
\integer{b= \a*\c}
\integer{p=randint(2..5)}
\integer{sol1= \c}
\integer{sol2= \n*\p}
\text{aa=pari(\a^(\sol2))}
\text{faux=pari(\n+\p)}
\integer{afaux=\a^(\faux)}
\statement{Schrijf \(\left(\frac{\b^{\n}}{\a^{\n}}\right)^{\p}) als een macht van een geheel getal (integer)
:
<center> \(\left(\frac{\b^{\n}}{\a^{\n}}\right)^\p)= \embed{reply 1, 4}<sup><sup>
\embed{reply 2,4}</sup></sup></center>
}
\answer{}{\sol1}{type=numeric}
\answer{}{\sol2}{type=numeric}
\hint{vereenvoudig eerst de breuk.}
\feedback{\reply2<>\sol2} {Heb je de regel  : \((a^n)^m=a^(n*m)) toegepast ?}
\feedback{\reply2=\faux and \reply2 <> \sol2 }{niet door elkaar halen : 
<center>\((\a^\n)^\p= \a^{\n  \times \p}=\a^{\sol2}=\aa ) </center> and
<center>\(\a^\n  \times \a^\p=\a^{\n+\p}=\a^{\faux}=\afaux)
</center>}
