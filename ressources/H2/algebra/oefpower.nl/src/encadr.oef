\title{Grenzen van decimale getallen}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(3..6)}
\integer{p=random(randint(5..7),randint(1..3))}
\real{a=randint(10^(\n)..10^(\n+1)-1)}
\real{A=\a/10^(\p)}

\real{sol1= \n-(\p)}
\real{sol2=\n-(\p)+1}

\statement{Geef de grenzen van het getal \(\A) uitgedrukt als machten van 10.

 <center>10<sup><sup>\embed{reply 1,4}</sup></sup>\(\leq) \A
 < 10<sup><sup>\embed{reply 2,4}</sup></sup>
</center>
}
\answer{exponent}{\sol1}{type=numeric}
\answer{exponent}{\sol2}{type=numeric}
\hint{Je kunt het best \(A) in de wetenschappelijke notatie opschrijven. }

