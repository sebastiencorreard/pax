!set title=Machten van 10
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r
varcnt=12
prevarcnt=11
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val2=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val3=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val4=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val5=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 2, 11

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
val7=10^{$val2}
val8=10^($val3)
val9=10^($val5)
val10=10^($val4)
val11=10^($val6)
val12=$[rint(($val2)+($val3)+($val5)-($val4)-($val6))]
replytype1=numeric
replyname1=exponent
replygood1=$[$val12]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Schrijf het getal als  
!insmath 10^n
$() :	<center> 
!insmath \frac{10^{$val2}  \times 10^{$val3}   \times 10^{$val5}}{10^{$val4}  \times 10^{$val6}}
$()	= 10<sup><sup> 
!read oef/embed.phtml reply 1,3 
$()</sup></sup></center>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=2,3,4,5,6
embedcnt=1
