!set title=De wetenschappelijke notatie
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
email=ambali@free.fr

ansorder=r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 6

val6=$[rint($(tmp0))]
tmp0=!randint 5, 7

tmp1=!randint 1, 3

tmp2=!randitem $(tmp0),$(tmp1)

val7=$[rint($(tmp2))]
tmp0=!randint 10^($val6), 10^($val6 + 1)-1

val8=$[$(tmp0)]
val9=$[$val8/10^($val7)]
val10=$[$val8/10^($val6)]
val11=$[$val6-$val7]
replyname1=
replygood1=$val10
replyname2=
replygood2=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p style="text-align : center;	background-color : #FFFFFF;	padding : 1%;	margin : 5% 15%; ">	Geef de wetenschappelijke schrijfwijze van 
!insmath A
$() in : 
!insmath  A = $val9
$()<br/>	 
!insmath A = 
$()  
!read oef/embed.phtml  reply1 ,8 
$() 
!insmath \times 10
$()<sup> 
!read oef/embed.phtml reply2,3 
$()</sup>	</p>	
$()
!exit

