!set title=Orde grootte
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr
language=nl
author=Jean-Baptiste Frondas

ansorder=r,r
varcnt=11
prevarcnt=10
postvarcnt=0
replycnt=2
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 6

val6=$[rint($(tmp0))]
tmp0=!randint 5, 7

tmp1=!randint 1, 3

tmp2=!randitem $(tmp0),$(tmp1)

val7=$[rint($(tmp2))]
tmp0=!randint 10^($val6), 10^($val6 + 1)-1

val8=$[$(tmp0)]
val9=$[$val8/10^($val7)]
val10=$[$val8/10^($val6)]
val11=$[$val6-$val7]
val12=$[$val11]
val13=$[rint($val10)]
!if $val13=10 
val13=$[1]
val12=$[$val12+1]
!else
!endif
replyname1=
replygood1=$val13
replyname2=
replygood2=$val12
question=__EXECUTED_1692754_EXERCISE__
hint=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()<p style="text-align : center;	background-color : #FFFFFF;	padding : 1%;	margin : 5% 15%; ">	Bepaal de orde grootte van getal 
!insmath A
$() in: 
!insmath  A = $val9
$()<br/>	
!insmath A = 
$()  
!read oef/embed.phtml  reply1 ,3 
$()
!insmath  \times 10 
$() <sup> 
!read oef/embed.phtml reply2,3 
$()</sup></p>	<em>Let op: de macht kan ook 0 worden.</em>	
$()
!exit

:hint
$()Bijvoorbeeld: met <em>orde grootte<em> van het getal 2345.678 bedoelen we dus 2&times;10<sup>3</sup>
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback

!exit

:test

!exit

:stat
vsavelist=9
embedcnt=2
