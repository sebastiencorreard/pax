!set title=Tabel van Machten I
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette PERRIN-RIOU
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 3, 6

tmp1=!randitem 1,-1

val6=$[rint($(tmp0)*$(tmp1))]
tmp0=!randint 3, 9

tmp1=!randitem 1,-1

val7=$[rint($(tmp0)*$(tmp1))]
val8=$[rint($val6*($val7))]
val9=$[rint(($val8)^2)]
val10=$[rint(($val6)^2)]
val11=$[rint(($val7)^2)]
replytype1=litexp
replyname1=\($val7*a)
replygood1=$val8
replytype2=litexp
replyname2=\(($val7*a)^2)
replygood2=$val9
replytype3=litexp
replyname3=\(a^2)
replygood3=$val10
replytype4=litexp
replyname4=\($val11*a^2)
replygood4=$val9
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Vul de tabel verder in:	<table align="center" border=1 bgcolor="antiquewhite">	<tr align="center"><td>&nbsp;&nbsp;
!insmath a
$() &nbsp;&nbsp;</td><td>
!insmath $val7 a
$()</td><td>
!insmath ($val7 a)^2
$()</td><td>
!insmath a^2
$()</td><td>
!insmath $val11 a^2
$()</td></tr>	<tr align="center"><td>$val6</td><td> 
!read oef/embed.phtml reply 1,6 
$()</td>	<td> 
!read oef/embed.phtml reply 2,6 
$()</td>	<td> 
!read oef/embed.phtml reply 3,6 
$()</td>	<td> 
!read oef/embed.phtml reply 4,6 
$()</td>	</tr>	</table>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:feedback
!ifval $m_reply2 <>$m_reply4
 <p>Opgelet: altijd geldt 
!insmath ($val7 a)^2=$val11 a^2
$().	
$()
!endif

!exit

:test

!exit

:stat
vsavelist=6,7,11
embedcnt=4
