\title{Factoriser 2}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\integer{a1=random(2..99)}
\integer{b1=random(2..99)}
\integer{c1=random(2..99)}

\text{a2=randint(x,y,z)}
\text{b2=randint(t,t)}
\text{c2=randint(p,q,r)}

\text{a=random(\a1,\a2)}
\text{b=random(\b1,\b2)}
\text{c=random(\c1,\c2)}
\text{sign=random(+,-)}

\text{exp1=\a * ( \b \sign \c )}
\text{exp2=(\b \sign \c) * \a }


\text{exp3=\a * ( \c \sign \b )}
\text{exp4=(\c \sign \b) * \a }


\if{\sign=+}{\text{resultat=\exp1,\exp2,\exp3,\exp4}}
\if{\sign=-}{\text{resultat=\exp1,\exp2}}

\text{result1=\a \( \times ) \b \sign \a \( \times ) \c}
\text{result2=\b \( \times ) \a \sign \c \( \times ) \a}
\text{result3=\a \( \times ) \b \sign \c \( \times ) \a}
\text{result4=\b \( \times ) \a \sign \a \( \times ) \c}

\text{result5=\a \( \times ) \c \sign \a \( \times ) \b}
\text{result6=\a \( \times ) \c \sign \b \( \times ) \a}
\text{result7=\c \( \times ) \a \sign \b \( \times ) \a}
\text{result8=\c \( \times ) \a \sign \a \( \times ) \b}

\if{\sign=+}{\text{exp=random(\result1,\result2,\result3,\result4,\result5,\result6,\result7,\result8)}}
\if{\sign=-}{\text{exp=random(\result1,\result2,\result3,\result4)}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Factorise l'expression proposée :

<div class="wimscenter">
\exp = \embed{r1,20}
</div>
<div class="wims_instruction">
Utiliser <span class="tt">*</span> en remplacement du signe \(\times) de la multiplication.
</div>
}

Réponses
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\reply{}{\resultat}{type= litexp}
