\integer{b=random(0..15)}
\integer{c=random(0..15)}
\matrix{phrase1= \a \(\times) &#40; \b + \c &#41; , Le produit de \a par la somme de \b et de \c
				\a \(\times) \b + \c , La somme du produit de \a par \b et de \c
				\b \(\times) \c - \a , La différence du produit de \b par \c et de \a
				&#40; \a - \b &#41; \(\times) \c, Le produit de la différence de \a et \b par \c
}
\text{s=shuffle(4)}
\matrix{ phrase= \phrase1[\s;\s] }

