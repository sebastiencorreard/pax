\title{Correspondance 2}
\email{ambali@free.fr}
\author{Jean-Baptiste, Frondas}
Exercices pour le début de la cinquieme avec des positifs

\integer{a1=random(2..99)}
\integer{b1=random(2..99)}
\integer{c1=random(2..99)}

\text{a2=randint(x,y,z)}
\text{b2=randint(t,t)}
\text{c2=randint(p,q,r)}

\text{a=random(\a1,\a2)}
\text{b=random(\b1,\b2)}
\text{c=random(\c1,\c2)}


\matrix{phrase1=\a \(\times) &#40;\b - \c &#41; , \a \(\times) \b - \a \(\times) \c
				\b \(\times)\a - \b \(\times) \c , \b \(\times) &#40; \a - \c &#41;
				\a \(\times) &#40;\b + \c &#41; , \a \(\times) \b + \a \(\times) \c
				\b \(\times)\a + \b \(\times) \c , \b \(\times) &#40; \a + \c &#41;
}

\text{s=shuffle(4)}
\matrix{ phrase= \phrase1[\s;\s] }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Associer les expressions qui conduisent au même résultat :
<div class="wimscenter">
\embed{reply1}
</div>
}

