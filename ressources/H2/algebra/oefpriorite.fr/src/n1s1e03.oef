\title{Marquer les priorités}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\integer{a=random(2..30)}
\integer{b=random(2..30)}
\integer{c=random(2..30)}
\integer{d=random(2..30)}
\text{sig1=random(+,-)}
\text{sig11=random(+,-)}
\text{sig2=random(\(times),÷)}
\text{sig22=random(\(times),÷)}
\text{multi=\(times)}
\text{div=÷}
\text{sig=random(+,-,÷,\(\times))}
\integer{choix=random(1..18)}
\if{\choix=1}{\text{enonce=\a,\sig1,\b,\sig2,\c} and \matrix{rep=4}}
\if{\choix=2}{\text{enonce=\a,\sig2,\b,\sig1,\c} and \matrix{rep=2}}
\if{\choix=3}{\text{enonce=\a,\multi,\b,\multi,\c} and \matrix{rep=2}}
\if{\choix=4}{\text{enonce=\a,\div,\b,\multi,\c} and \matrix{rep=2}}
\if{\choix=5}{\text{enonce=\a,\div,\b,\div,\c} and \matrix{rep=2}}
\if{\choix=6}{\text{enonce=\a,\multi,\b,\div,\c} and \matrix{rep=2}}
\if{\choix=7}{\text{enonce=\a,\sig1,\b,\sig2,\c,\sig11,\d} and \matrix{rep=4}}
\if{\choix=8}{\text{enonce=\a,\sig1,\b,\sig11,\c,\sig2,\d} and \matrix{rep=2,6}}
\if{\choix=9}{\text{enonce=\a,\sig2,\b,\sig1,\c,\sig22,\d} and \matrix{rep=2,6}}
\if{\choix=10}{\text{enonce=&#40;,\a,\sig1,\b,&#41;,\sig11,\c} and \matrix{rep=3}}
\if{\choix=11}{\text{enonce=&#40;,\a,\sig1,\b,&#41;,\sig2,\c} and \matrix{rep=3}}
\if{\choix=12}{\text{enonce=\a,\sig1,&#40;,\b,\sig11,\c,&#41;} and \matrix{rep=5}}
\if{\choix=13}{\text{enonce=\a,\sig1,&#40;,\b,\sig2,\c,&#41;} and \matrix{rep=5}}
\if{\choix=14}{\text{enonce=&#40;,\a,\sig1,\b,&#41;,\sig2,&#40;,\c,\sig11,\d,&#41;} and \matrix{rep=3,9}}
\if{\choix=15}{\text{enonce=&#40;,\a,\sig1,\b,&#41;,\sig11,&#40;,\c,\sig1,\d,&#41;} and \matrix{rep=3,9}}
\if{\choix=16}{\text{enonce=&#40;,\a,\sig2,\b,&#41;,\sig1,&#40;,\c,\sig22,\d,&#41;} and \matrix{rep=3,9}}
\if{\choix=17}{\text{enonce=&#40;,\a,\sig2,\b,&#41;,\sig22,&#40;,\c,\sig1,\d,&#41;} and \matrix{rep=3,9}}

\if{\choix=18}{\text{enonce=\a,\sig1,\b,\sig2,&#40;,\c,\sig,\d,&#41;} and \matrix{rep=7}}

\integer{cnt=items(\enonce)}


Statement
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Dans cet exercice, il faut marquer (en cliquant dessus) la ou les opérations prioritaires,
c'est-à-dire celle par laquelle il faut commencer le calcul.
Parfois, il y a plusieurs possibilités, il faut alors cocher
toutes celles possibles :
<p>
L'expression est :
</p>
<div class="wimscenter">
\for{u = 1 to \cnt}{\embed{r1, \u}}
</div>

}

