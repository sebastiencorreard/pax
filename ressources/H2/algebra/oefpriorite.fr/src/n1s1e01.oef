\title{Calculs en ligne avec ou sans priorité}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\integer{choix=random(1..4)}
\text{lettre=random(A,B,C,D,E,F,G,H,I,J,K,L,M,N)}

CX1 du type 14+5+3
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\if{\choix=1}{
\text{sig1=random(+,-)}
\text{sig2=random(+,-)}

\integer{a=randint(10..40)}
\if{\sig1=-}{\integer{b=randint(1..7*\a/8)}}{\integer{b=random(1..30)}}
\integer{interm=(\a \sig1 \b)}
\if{\sig2=-}{\integer{c=randint(1..7*\interm/8)}}{\integer{c=random(1..30)}}


\integer{result = (\a \sig1 \b \sig2 \c)}
\text{enonce = On donne \lettre \(=) \a \sig1 \b \sig2 \c}
\text{monaide = Il n'y a pas de priorité ; les calculs se font de gauche à droite}
\text{masolution =
<table>
<tr><td>\lettre </td>
<td>= </td>
<td><span style="color:red">\a \sig1 \b </span>\sig2 \c , il n'y a pas de priorité, on mène le calcul de gauche à droite</td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td><span style="color:red">\interm</span> \sig2 \c </td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td>\result </td></tr>
</table>
}
}

CX2 du type 14*/5*/3
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\if{\choix=2}{
\text{sig1=random(*,/)}
\text{sig2=random(*,/)}
\if{\sig1=*}{\text{sigg1=\( \times )}}{\text{sigg1 = ÷}}
\if{\sig2=*}{\text{sigg2=\( \times )}}{\text{sigg2 = ÷}}
\if{\sig1=* and \sig2=*}{
    \integer{a=random(2..10)}
    \integer{b=random(2..10)}
    \integer{c=random(2..10)}
    }
\if{\sig1=* and \sig2=/}{
    \integer{a=random(2..10)}
    \integer{c=random(2..7)}
    \integer{b=random(1..5)*\c}
    }
\if{\sig1=/ and \sig2=*}{
    \integer{b=random(2..7)}
    \integer{a=random(1..5)*\b}
    \integer{c=random(2..10)}
    }
\if{\sig1=/ and \sig2=/}{
    \integer{c=random(2..6)}
    \integer{b=random(1..5)*\c}
    \integer{a=random(1..3)*\b*\c}
    }

\integer{interm=(\a \sig1 \b)}


\integer{result = (\a \sig1 \b \sig2 \c)}
\text{enonce = On donne \lettre \(=) \a \sigg1 \b \sigg2 \c}
\text{monaide = Il n'y a pas de priorité ; les calculs se font de gauche à droite}
\text{masolution =
<table>
<tr><td>\lettre </td>
<td>= </td>
<td><span style="color:red">\a \sigg1 \b </span>\sigg2 \c , il n'y a pas de priorité, on mène le calcul de gauche à droite</td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td><span style="color:red">\interm</span> \sigg2 \c </td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td>\result </td></tr>
</table>
}
}

CX3 du type 14*/5+-3
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\if{\choix=3}{
\text{sig1=random(*,/)}
\text{sig2=random(+,-)}
\if{\sig1=*}{\text{sigg1=\( \times )}}{\text{sigg1 = ÷}}
\if{\sig2=+}{\text{sigg2=+}}{\text{sigg2 = -}}
\if{\sig1=* and \sig2=+}{
    \integer{a=random(2..10)}
    \integer{b=random(2..10)}
    \integer{c=random(2..10)}
    }
\if{\sig1=* and \sig2=-}{
    \integer{a=random(2..10)}
    \integer{b=random(2..10)}
    \integer{c=random(2..7*\a*\b/8)}
    }
\if{\sig1=/ and \sig2=+}{
    \integer{b=random(4..12)}
    \integer{a=random(3..7)*\b}
    \integer{c=random(2..10)}
    }
\if{\sig1=/ and \sig2=-}{
    \integer{b=random(4..12)}
    \integer{a=random(3..7)*\b}
    \integer{c=random(2..7*\a/\b/8)}
    }

\integer{interm=(\a \sig1 \b)}


\integer{result = (\a \sig1 \b \sig2 \c)}
\text{enonce = On donne \lettre \(=) \a \sigg1 \b \sigg2 \c}
\text{monaide = Il faut bien repérer la priorité pour commencer le calcul !}
\text{masolution =
<table>
<tr><td>\lettre </td>
<td> = </td>
<td><span style="color:red">\a \sigg1 \b </span>\sigg2 \c , le calcul prioritaire est en rouge</td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td><span style="color:red">\interm</span> \sigg2 \c </td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td>\result </td></tr>
</table>
}
}



CX4 du type 14+-5*/3
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\if{\choix=4}{
\text{sig1=random(+,-)}
\text{sig2=random(*,/)}
\if{\sig1=+}{\text{sigg1=+}}{\text{sigg1 = -}}
\if{\sig2=*}{\text{sigg2=\( \times )}}{\text{sigg2 = ÷}}
\if{\sig1=+ and \sig2=*}{
    \integer{a=random(2..10)}
    \integer{b=random(2..10)}
    \integer{c=random(2..10)}
    }
\if{\sig1=+ and \sig2=/}{
    \integer{a=random(2..20)}
    \integer{c=random(2..10)}
    \integer{b=random(3..10)*\c}
    }
\if{\sig1=- and \sig2=*}{
    \integer{b=random(2..10)}
    \integer{c=random(2..10)}
    \integer{a=random(3*\b*\c/2..3*\b*\c)}
    }
\if{\sig1=- and \sig2=/}{
    \integer{c=random(2..10)}
    \integer{b=random(2..8)*\c}
    \integer{a=random(3*\b/\c/2..3*\b/\c)}
    }

\integer{interm=(\b \sig2 \c)}


\integer{result = (\a \sig1 \b \sig2 \c)}
\text{enonce = On donne \lettre \(=) \a \sigg1 \b \sigg2 \c}
\text{monaide = Il faut bien repérer la priorité pour commencer le calcul !}
\text{masolution =
<table>
<tr><td>\lettre </td>
<td>= </td>
<td>\a \sigg1 <span style="color:red">\b \sigg2 \c</span> , le calcul prioritaire est en rouge</td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td>\a \sigg1 <span style="color:red">\interm</span> </td></tr>

<tr><td>\lettre </td>
<td>= </td>
<td>\result </td></tr>
</table>
}
}



