\title{Transformation de terrain}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\text{nouvanc=random(nouveau,ancien,nouveau)}
\text{dunouvanc=slib(lang/frapostrophe de le \nouvanc)}
\integer{longi=random(30..60)*10}
\integer{largi=random(15..30)*10}
\text{var1=random(d'augmenter,de diminuer)}
\text{var2=random(d'augmenter,de diminuer)}
\integer{longv=random(1..15)*10}
\integer{largv=random(1..12)*10}

\if{\nouvanc=ancien}{
	\text{expaire=\longi*\largi}
	\text{aireexp=\largi*\longi}
	\text{expperi=(\longi+\largi)*2}
	\text{expperi1=2*(\longi+\largi)}
	\text{expperi2=(\largi+\longi)*2}
	\text{expperi3=2*(\largi+\longi)}
	\integer{aire=\longi*\largi}
	\integer{peri=(\longi+\largi)*2}
}

\if{\nouvanc=nouveau}{
	\if{\var1=d'augmenter}{\integer{long=\longi+\longv}}{\integer{long=\longi-\longv}}
	\if{\var2=d'augmenter}{\integer{larg=\largi+\largv}}{\integer{larg=\largi-\largv}}
	\text{expaire=\long*\larg}
	\text{aireexp=\larg*\long}
	\text{expperi=(\long+\larg)*2}
	\text{expperi1=2*(\long+\larg)}
	\text{expperi2=(\larg+\long)*2}
	\text{expperi3=2*(\larg+\long)}
	\integer{aire=\long*\larg}
	\integer{peri=(\long+\larg)*2}
}



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{ À l'origine, le terrain rectangulaire de mon grand-père mesurait
\longi de long sur \largi de large. Mon grand-père décide \var1 sa longueur de \longv mètres et  \var2 sa largeur de \largv mètres.
<ul><li>
Écris une expression pour calculer l'aire \dunouvanc terrain
	<div class="wimscenter" style="background-color : #FFFFF0;">\embed{r1,20}</div>
	</li><li>
	Écris une expression pour calculer le périmètre \dunouvanc terrain
	<div class="wimscenter">\embed{r2,20}</div>
  </li><li>Donne le résultat de tes calculs, pour :
     <ul><li>l'aire : \embed{r3,8}
     </li><li>le périmètre : \embed{r4,8}</li>
     </ul>
    </li>
</ul>
<div class="wims_instruction">Utiliser * en remplacement du signe \(\times) de la multiplication.</div>
}

Réponses
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\reply{}{\expaire,\aireexp}{type= litexp}
\reply{}{\expperi,\expperi1,\expperi2,\expperi3}{type= litexp}
\reply{}{\aire}{type= numeric}
\reply{}{\peri}{type= numeric}
