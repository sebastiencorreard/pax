\title{Le bon poids}
\email{ambali@free.fr}
  \computeanswer{ yes }
  \precision{ 100 }
Exercices pour le début de la cinquieme avec des positifs

\text{enonce=L'indice de poids corporel d'une personne adulte s'obtient par le calcul suivant : \(\frac{P}{T \times T})  où \(P) représente le poids de la personne en kilogrammes et \(T) la taille de la personne en mètres.<br> L'indice correct chez l'homme est entre 20 et 25, chez la femme entre 19 et 24<br>}

\text{a=random(Fabrice,Paul,Jacques)}
\text{b=random(Jean,Philippe,Matthieu)}
\text{c=random(Luc,Alexandre,Damien)}
\text{d=random(Marie,Augustine,Louise)}

Fabrice
\integer{pa=random(60..95)}

\integer{ia=random(1800..2700)}
\real{iia=\ia/ 100}

\integer{ta=sqrt(\pa / \ia )*1000}

\integer{iia= \pa / ( \ta * \ta)*1000000}
\real{iiia=\iia / 100}

\if{\iiia<20}{\text{appa=insuffisant}}{\if{\iiia>25}{\text{appa=trop élevé}}{\text{appa=correct}}}

Jean
\integer{pb=random(60..95)}

\integer{ib=random(1800..2700)}
\real{iib=\ib/ 100}

\integer{tb=sqrt(\pb / \ib )*1000}

\integer{iib= \pb / ( \tb * \tb)*1000000}
\real{iiib=\iib / 100}

\if{\iiib<20}{\text{appb=insuffisant}}{\if{\iiib>25}{\text{appb=trop élevé}}{\text{appb=correct}}}

Luc

\integer{pc=random(60..95)}

\integer{ic=random(1800..2700)}
\real{iic=\ic/ 100}

\integer{tc=sqrt(\pc / \ic )*1000}

\integer{iic= \pc / ( \tc * \tc)*1000000}
\real{iiic=\iic / 100}

\if{\iiic<20}{\text{appc=insuffisant}}{\if{\iiic>25}{\text{appc=trop élevé}}{\text{appc=correct}}}

Marie
\integer{pd=random(60..95)}

\integer{id=random(1800..2700)}
\real{iid=\id/ 100}

\integer{td=sqrt(\pd / \id )*1000}

\integer{iid= \pd / ( \td * \td)*1000000}
\real{iiid=\iid / 100}

\if{\iiid<19}{\text{appd=insuffisant}}{\if{\iiid>24}{\text{appd=trop élevé}}{\text{appd=correct}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Bien lire l'énoncé et répondre aux deux questions posées dans la tableau.
<div style="background-color: #FFFFF0;">
\enonce
</div>
<ol>
		<li> Calculer l'indice de poids de chaque personne.</li>
		<li> Dans chaque cas, cet indice est-il correct, trop élevé ou insuffisant ?</li>
</ol>
<table class="wimscenter wimsborder">
<tr>
	<th>Prénoms</th>
	<th>Poids</th>
	<th>Taille</th>
	<th>Indice</th>
	<th>Interprétation</th>
</tr><tr>
	<td>\a</td>
	<td>\pa kg</td>
	<td>\ta cm</td>
	<td>\embed{r1,8}</td>
	<td>\embed{r2,20}</td>
</tr><tr>
	<td>\b</td>
	<td>\pb kg</td>
	<td>\tb cm</td>
	<td>\embed{r3,8}</td>
	<td>\embed{r4,20}</td>
</tr><tr>
	<td>\c</td>
	<td>\pc kg</td>
	<td>\tc cm</td>
	<td>\embed{r5,8}</td>
	<td>\embed{r6,20}</td>
</tr><tr>
	<td>\d</td>
	<td>\pd kg</td>
	<td>\td cm</td>
	<td>\embed{r7,8}</td>
	<td>\embed{r8,20}</td>
</tr>
</table>
}

