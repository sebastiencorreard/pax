\title{Calculs en tableau}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\integer{a=random(0..15)}
\integer{b=random(0..15)}
\integer{c=random(0..15)}
\integer{rep1=((\a+\b)*\c)}
\integer{rep2=(\a+\b*\c)}
\integer{rep3=(\a*(\b+\c))}

Statement
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Compléter le tableau :
<table class="wimscenter wimsborder">
	<tr>
		<td> a </td>
		<td> b </td>
		<td> c </td>
		<td>\((a+b)\times c\) </td>
		<td>\(a+b\times c\) </td>
		<td> \(a \times ( b+c)\) </td>
	</tr><tr>
		<td> \a </td>
		<td> \b </td>
		<td> \c </td>
		<td> \embed{r1,8} </td>
		<td> \embed{r2,8} </td>
		<td> \embed{r3,8} </td>
	</tr>
</table>
}

