Exercices pour le début de la cinquieme avec des positifs

\integer{a=random(1..15)}
\integer{b=random(1..15)}
\integer{c=random(1..15)}
\integer{d=random(1..15)}
\text{sig=random(+,-)}
\integer{aa=random(\b*\c..2*\b*\c)}
\integer{bb=random(5..10)*\c-\a}
\integer{res1= \a*\b+\c}
\integer{res2=\a*(\b+\c)}
\integer{res3=\aa-\b*\c}
\integer{res4=(\a+\bb)/\c}
\matrix{phrase1=La somme du produit de \a par \b et de \c, \res1
				Le produit de \a par la somme de \b et de \c, \res2
				La différence de \aa et du produit de \b par \c, \res3
				Le quotient de la somme de \a et \bb par \c, \res4
}
\matrix{phrase= randomrow(\phrase1)}

