\title{Développer 2}
\email{ambali@free.fr}

Exercices pour le début de la cinquieme avec des positifs

\integer{a1=random(2..99)}
\integer{b1=random(2..99)}
\integer{c1=random(2..99)}

\text{a2=randint(x,y,z)}
\text{b2=randint(t,t)}
\text{c2=randint(p,q,r)}

\text{a=random(\a1,\a2)}
\text{b=random(\b1,\b2)}
\text{c=random(\c1,\c2)}
\text{sign=random(+,-)}

\text{exp1=\a \(\times) ( \b \sign \c )}
\text{exp2=(\b \sign \c) \(\times) \a }

\text{exp=random(\exp1,\exp2)}

\text{result1=\a * \b \sign \a * \c}
\text{result2=\b * \a \sign \c * \a}
\text{result3=\a * \b \sign \c * \a}
\text{result4=\b * \a \sign \a * \c}

\text{result5=\a * \c \sign \a * \b}
\text{result6=\a * \c \sign \b * \a}
\text{result7=\c * \a \sign \b * \a}
\text{result8=\c * \a \sign \a * \b}

\if{\sign=+}{\text{resultat=\result1,\result2,\result3,\result4,\result5,\result6,\result7,\result8}}

\if{\sign=-}{\text{resultat=\result1,\result2,\result3,\result4}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\statement{Développe l'expression proposée :
<div class="wimscenter">
\exp = \embed{r1,20}
</div>
<div class="wims_instruction">Utiliser <span class="tt">*</span> en remplacement du signe \(\times) de la multiplication.</div>
}
Réponses
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\reply{}{\resultat}{type= litexp}
