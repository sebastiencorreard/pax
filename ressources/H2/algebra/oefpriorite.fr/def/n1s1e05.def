!set title=Association math-français
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 0, 15

val6=$[rint($(tmp0))]
tmp0=!randint 0, 15

val7=$[rint($(tmp0))]
tmp0=!randint 0, 15

val8=$[rint($(tmp0))]
tmp=!trim $val6 \(\times) &#40; $val7 + $val8 &#41; , Le produit de $val6 par la somme de $val7 et de $val8	    $val6 \(\times) $val7 + $val8 , La somme du produit de $val6 par $val7 et de $val8	    $val7 \(\times) $val8 - $val6 , La différence du produit de $val7 par $val8 et de $val6	    &#40; $val6 - $val7 &#41; \(\times) $val8, Le produit de la différence de $val6 et $val7 par $val8	
val9=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 4

val10=$(tmp0)
tmp=!trim $(val9[$val10;$val10]) 
val11=!translate internal $	\
$ to ;; in $tmp
replytype1=correspond
replyoption1=split 
replyname1=
replygood1=$(val11[;1]);$(val11[;2])
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

