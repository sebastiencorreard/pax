!set title=Du français au résultat
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 15

val6=$[rint($(tmp0))]
tmp0=!randint 1, 15

val7=$[rint($(tmp0))]
tmp0=!randint 1, 15

val8=$[rint($(tmp0))]
tmp0=!randint 1, 15

val9=$[rint($(tmp0))]
tmp0=!randitem +,-

val10=$(tmp0)
tmp0=!randint $val7*$val8, 2*$val7*$val8

val11=$[rint($(tmp0))]
tmp0=!randint 5, 10

val12=$[rint($(tmp0)*$val8-$val6)]
val13=$[rint($val6*$val7+$val8)]
val14=$[rint($val6*($val7+$val8))]
val15=$[rint($val11-$val7*$val8)]
val16=$[rint(($val6+$val12)/$val8)]
tmp=!trim La somme du produit de $val6 par $val7 et de $val8, $val13	    Le produit de $val6 par la somme de $val7 et de $val8, $val14	    La différence de $val11 et du produit de $val7 par $val8, $val15	    Le quotient de la somme de $val6 et $val12 par $val8, $val16	
val17=!translate internal $	\
$ to ;; in $tmp
tmp=!translate internal $	$ to ; in $val17

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)
val18=!translate internal $	\
$ to ;; in $tmp
replytype1=numeric
replyname1=
replygood1=$[$(val18[2])]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

