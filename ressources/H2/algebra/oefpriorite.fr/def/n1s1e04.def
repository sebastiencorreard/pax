 !exit
!endif

tmp0=!randint 0, 15

val6=$[rint($(tmp0))]
tmp0=!randint 0, 15

val7=$[rint($(tmp0))]
tmp0=!randint 0, 15

val8=$[rint($(tmp0))]
val9=$[rint((($val6+$val7)*$val8))]
val10=$[rint(($val6+$val7*$val8))]
val11=$[rint(($val6*($val7+$val8)))]
replyname1=
replygood1=$val9
replyname2=
replygood2=$val10
replyname3=
replygood3=$val11
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Compléter le tableau :	<table class="wimscenter wimsborder">	 <tr>	  <td> a </td>	  <td> b </td>	  <td> c </td>	  <td>
!insmath (a+b)\times c
$() </td>	  <td>
!insmath a+b\times c
$() </td>	  <td> 
!insmath a \times ( b+c)
$() </td>	 </tr><tr>	  <td> $val6 </td>	  <td> $val7 </td>	  <td> $val8 </td>	  <td>  
!read oef/embed.phtml r1,8 
$() </td>	  <td>  
!read oef/embed.phtml r2,8 
$() </td>	  <td>  
!read oef/embed.phtml r3,8 
$() </td>	 </tr>	</table>	
$()
!exit

