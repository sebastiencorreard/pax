val18=$val6 * $val8 $val9 $val7 * $val6
val19=$val8 * $val6 $val9 $val7 * $val6
val20=$val8 * $val6 $val9 $val6 * $val7
!if $val9=+ 
val21=$val13,$val14,$val15,$val16,$val17,$val18,$val19,$val20
!endif
!if $val9=- 
val21=$val13,$val14,$val15,$val16
!endif
replytype1=litexp
replyname1=
