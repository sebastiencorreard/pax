choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 99

val6=$[rint($(tmp0))]
tmp0=!randint 2, 99

val7=$[rint($(tmp0))]
tmp0=!randint 2, 99

val8=$[rint($(tmp0))]
tmp0=!randitem x,y,z

val9=$(tmp0)
tmp0=!randitem t,t

val10=$(tmp0)
tmp0=!randitem p,q,r

val11=$(tmp0)
tmp0=!randitem $val6,$val9

val12=$(tmp0)
tmp0=!randitem $val7,$val10

val13=$(tmp0)
tmp0=!randitem $val8,$val11

val14=$(tmp0)
tmp0=!randitem +,-

val15=$(tmp0)
val16=$val12 * ( $val13 $val15 $val14 )
val17=($val13 $val15 $val14) * $val12 
val18=$val12 * ( $val14 $val15 $val13 )
val19=($val14 $val15 $val13) * $val12 
!if $val15=+ 
val20=$val16,$val17,$val18,$val19
!endif
!if $val15=- 
val20=$val16,$val17
!endif
val21=$val12 \( \times ) $val13 $val15 $val12 \( \times ) $val14
val22=$val13 \( \times ) $val12 $val15 $val14 \( \times ) $val12
val23=$val12 \( \times ) $val13 $val15 $val14 \( \times ) $val12
val24=$val13 \( \times ) $val12 $val15 $val12 \( \times ) $val14
val25=$val12 \( \times ) $val14 $val15 $val12 \( \times ) $val13
val26=$val12 \( \times ) $val14 $val15 $val13 \( \times ) $val12
val27=$val14 \( \times ) $val12 $val15 $val13 \( \times ) $val12
val28=$val14 \( \times ) $val12 $val15 $val12 \( \times ) $val13
!if $val15=+ 
tmp0=!randitem $val21,$val22,$val23,$val24,$val25,$val26,$val27,$val28

val29=$(tmp0)
!endif
!if $val15=- 
tmp0=!randitem $val21,$val22,$val23,$val24

val29=$(tmp0)
!endif
replytype1=litexp
replyname1=
replygood1=$val20
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

