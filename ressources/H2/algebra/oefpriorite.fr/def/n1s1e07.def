 !exit
!endif

tmp0=!randint 2, 10

val6=$[rint($(tmp0))]
tmp0=!randint 2, 10

val7=$[rint($(tmp0))]
tmp0=!randint 2, 10

val8=$[rint($(tmp0))]
tmp0=!randint 2, 10

val9=$[rint($(tmp0))]
tmp0=!randint 2, 10

val10=$[rint($(tmp0))]
tmp0=!randint 1, 6

val11=$[rint($(tmp0)*100)]
tmp0=!randitem Adrien,Jean,Paul,Luc,Jacques,Clément,Thimotée

val12=$(tmp0)
val13=$val6*$val11+$val7*$val11+$val8*$val11+$val9*$val11+$val10*$val11
val14=$val11*$val6+$val11*$val7+$val11*$val8+$val11*$val9+$val11*$val10
val15=($val6+$val7+$val8+$val9+$val10)*$val11
val16=$val11*($val6+$val7+$val8+$val9+$val10)
