!set title=Transformation de terrain
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
email=ambali@free.fr

ansorder=r,r,r,r
varcnt=29
prevarcnt=28
postvarcnt=0
replycnt=4
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem nouveau,ancien,nouveau

val6=$(tmp0)
!readproc slib/lang/frapostrophe de le $val6 
tmp0=$slib_out
val7=$(tmp0)
tmp0=!randint 30, 60

val8=$[rint($(tmp0)*10)]
tmp0=!randint 15, 30

val9=$[rint($(tmp0)*10)]
tmp0=!randitem d'augmenter,de diminuer

val10=$(tmp0)
tmp0=!randitem d'augmenter,de diminuer

val11=$(tmp0)
tmp0=!randint 1, 15

val12=$[rint($(tmp0)*10)]
tmp0=!randint 1, 12

val13=$[rint($(tmp0)*10)]
!if $val6=ancien 
val14=$val8*$val9
val15=$val9*$val8
val16=($val8+$val9)*2
val17=2*($val8+$val9)
val18=($val9+$val8)*2
val19=2*($val9+$val8)
val20=$[rint($val8*$val9)]
val21=$[rint(($val8+$val9)*2)]
!endif
!if $val6=nouveau 
!if $val10=d'augmenter 
val22=$[rint($val8+$val12)]
!else
val22=$[rint($val8-$val12)]
!endif
!if $val11=d'augmenter 
val23=$[rint($val9+$val13)]
!else
val23=$[rint($val9-$val13)]
!endif
val14=$val22*$val23
val15=$val23*$val22
val16=($val22+$val23)*2
val17=2*($val22+$val23)
val18=($val23+$val22)*2
val19=2*($val23+$val22)
val20=$[rint($val22*$val23)]
val21=$[rint(($val22+$val23)*2)]
!endif
replytype1=litexp
replyname1=
replygood1=$val14,$val15
replytype2=litexp
replyname2=
replygood2=$val16,$val17,$val18,$val19
replytype3=numeric
replyname3=
replygood3=$[$val20]
replytype4=numeric
replyname4=
replygood4=$[$val21]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$() À l'origine, le terrain rectangulaire de mon grand-père mesurait	$val8 de long sur $val9 de large. Mon grand-père décide $val10 sa longueur de $val12 mètres et  $val11 sa largeur de $val13 mètres.	<ul><li>	Écris une expression pour calculer l'aire $val7 terrain	 <div class="wimscenter" style="background-color : #FFFFF0;"> 
!read oef/embed.phtml r1,20 
$()</div>	 </li><li>	 Écris une expression pour calculer le périmètre $val7 terrain	 <div class="wimscenter"> 
!read oef/embed.phtml r2,20 
$()</div>	  </li><li>Donne le résultat de tes calculs, pour :	     <ul><li>l'aire :  
!read oef/embed.phtml r3,8 
$()	     </li><li>le périmètre :  
!read oef/embed.phtml r4,8 
$()</li>	     </ul>	    </li>	</ul>	<div class="wims_instruction">Utiliser * en remplacement du signe 
!insmath \times
$() de la multiplication.</div>	
$()
!exit

