val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 99

val6=$[rint($(tmp0))]
tmp0=!randint 2, 99

val7=$[rint($(tmp0))]
tmp0=!randint 2, 99

val8=$[rint($(tmp0))]
tmp0=!randitem +,-

val9=$(tmp0)
val10=$val6 * ( $val7 $val9 $val8 )
val11=($val7 $val9 $val8) * $val6 
val12=$val6 * ( $val8 $val9 $val7 )
val13=($val8 $val9 $val7) * $val6 
!if $val9=+ 
val14=$val10,$val11,$val12,$val13
!endif
!if $val9=- 
val14=$val10,$val11
!endif
val15=$val6 \( \times ) $val7 $val9 $val6 \( \times ) $val8
val16=$val7 \( \times ) $val6 $val9 $val8 \( \times ) $val6
val17=$val6 \( \times ) $val7 $val9 $val8 \( \times ) $val6
val18=$val7 \( \times ) $val6 $val9 $val6 \( \times ) $val8
val19=$val6 \( \times ) $val8 $val9 $val6 \( \times ) $val7
val20=$val6 \( \times ) $val8 $val9 $val7 \( \times ) $val6
val21=$val8 \( \times ) $val6 $val9 $val7 \( \times ) $val6
val22=$val8 \( \times ) $val6 $val9 $val6 \( \times ) $val7
!if $val9=+ 
tmp0=!randitem $val15,$val16,$val17,$val18,$val19,$val20,$val21,$val22

val23=$(tmp0)
!endif
!if $val9=- 
tmp0=!randitem $val15,$val16,$val17,$val18

val23=$(tmp0)
!endif
replytype1=litexp
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Factorise l'expression proposée :	<div class="wimscenter">	$val23 =  
