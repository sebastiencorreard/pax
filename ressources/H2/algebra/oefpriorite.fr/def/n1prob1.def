tmp0=!randint 60, 95

val11=$[rint($(tmp0))]
tmp0=!randint 1800, 2700

val12=$[rint($(tmp0))]
val13=$[$val12/ 100]
val14=$[rint(sqrt($val11 / $val12 )*1000)]
val13=$[rint($val11 / ( $val14 * $val14)*1000000)]
val15=$[$val13 / 100]
!if $val15<20 
val16=insuffisant
!else
!if $val15>25 
val16=trop élevé
!else
val16=correct
!endif
!endif
