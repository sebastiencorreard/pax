!set title=Optellen van Breuken
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
language=nl
leftrange=-5.000000
rightrange=5.000000
author=Bernadette Perrin-Riou
email=bpr@math.u-psud.fr
computeanswer=no
precision=10000

ansorder=r,r,r,r,r,r,r,r,r,r,r
varcnt=13
prevarcnt=12
postvarcnt=0
replycnt=11
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randitem +,-

val6=$(tmp0)

!ifval $val6=+
val7=  optelsommetje
!else
val7= aftreksommetje
!endif
tmp0=!randitem 3,7,5,15,9,11

val8=$[rint($(tmp0))]
tmp0=!randitem 2,4,7,8,13

val9=$[rint($(tmp0))]
tmp0=!randitem 2,4,8,14,7

val10=$[rint($(tmp0))]
tmp0=!randitem 5,11,3,9,25,15

val11=$[rint($(tmp0))]
val12=$[rint($val8*($val11))]
val13=$[rint($val9*($val11))]
val14=$[rint($val9*($val10))]
val15=$[rint($val12 $val6$val14)]
t_=!replace internal \( by ( in numerator($val15/$val13)
tmp0=!exec pari $t_

val16=$(tmp0)
t_=!replace internal \( by ( in denominator($val15/$val13)
tmp0=!exec pari $t_

val17=$(tmp0)
oefsteps=reply1,reply2,reply3,reply4	reply5,reply6,reply7,reply8	reply9	reply10, reply11 
nextstep=!nosubst reply1,reply2,reply3,reply4	reply5,reply6,reply7,reply8	reply9	reply10, reply11 
!readproc oef/steps.proc
replytype1=numeric
replyname1=
replygood1=$[$val11]
replytype2=numeric
replyname2=
replygood2=$[$val11]
replytype3=numeric
replyname3=
replygood3=$[$val9]
replytype4=numeric
replyname4=
replygood4=$[$val9]
replytype5=numeric
replyname5=
replygood5=$[$val12]
replytype6=numeric
replyname6=
replygood6=$[$val13]
replytype7=numeric
replyname7=
replygood7=$[$val14]
replytype8=numeric
replyname8=
replygood8=$[$val13]
replytype9=numeric
replyname9=
replygood9=$[$val15]
replytype10=numeric
replyname10=
replygood10=$[$val16]
replytype11=numeric
replyname11=
replygood11=$[$val17]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Bereken het volgende $val7 :	
!insmath \frac{$val8}{$val9}$val6 \frac{$val10}{$val11}
$(). 	<br>		 
!if $m_step<=1 
$()Om dit te kunnen, 	breng beide breuken onder dezelfde noemer :<center>	<table> <tr><td></td><td>$val8 $m_times  
!read oef/embed.phtml reply 1,3 
$()</td><td></td>	<td>$val10 $m_times  
!read oef/embed.phtml reply 3,3 
$()</td>	</tr>	<tr><td>
!insmath \frac{$val8}{$val9}$val6 \frac{$val10}{$val11}
$()= </td>	<td><hr></td><td>&nbsp;&nbsp;$val6 &nbsp;&nbsp;</td><td><hr></td></tr>	<tr><td></td><td>$val9 $m_times  
!read oef/embed.phtml reply 2,3 
$()</td><td></td>	<td>$val11 $m_times  
!read oef/embed.phtml reply 4,3 
$()</td></tr>	</table></center> 
!endif
$()		 
!if $m_step=2 
$()En voer de vermenigvuldiging uit :	<center><table> <tr><td></td><td>  
!read oef/embed.phtml reply 5,3 
$()</td><td></td>	<td>  
!read oef/embed.phtml reply 7,3 
$()</td>	</tr>	<tr><td>
!insmath \frac{$val8}{$val9}$val6 \frac{$val10}{$val11}= \frac{$val8\times $val11}{$val9\times  $val11}$val6 	\frac{$val10\times $val9}{$val11\times $val9}=
$() </td>	<td><hr></td><td> &nbsp;&nbsp;$val6 &nbsp;&nbsp; </td><td><hr></td></tr>	<tr><td></td><td>  
!read oef/embed.phtml reply 6,3 
$()</td><td></td>	<td> 
!read oef/embed.phtml reply 8,3 
$()</td></tr>	</table>	</center>	 
!endif
$()		 
!if $m_step=3 
$()als laatste, tel de tellers op (of trek ze van elkaar af)	<center><table> <tr><td></td><td>  
!read oef/embed.phtml reply 9,3 
$()</td>	</tr>	<tr><td>
!insmath \frac{$val8}{$val9}$val6 \frac{$val10}{$val11}= \frac{$val8\times $val11}{$val9\times  $val11}$val6 	\frac{$val10\times $val9}{$val11\times $val9}=\frac{$val12}{$val13}$val6 	\frac{$val14}{$val13}=
$() </td><td><hr></td>	</tr>	<tr><td></td><td>$val13</td></tr>	</table> 
!endif
$() 	 
!if $m_step>=4 
$()En, indien mogelijk,vereenvoudig verder  :	<center><table><tr><td> </td><td>	 
!read oef/embed.phtml reply 10,3 
$()</td></tr>	<tr><td>
!insmath \frac{$val8}{$val9}$val6 \frac{$val10}{$val11}= \frac{$val15}{$val13}=
$()</td><td><hr>	</td>	</tr>	<tr><td> </td><td>  
!read oef/embed.phtml reply 11,3 
$()</td></tr>	</table> </center>	 
!endif
$()
$()
!exit

