\title{十进数与 10 的方幂}
\language{cn}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(3..8)}
\integer{p=random(randint(5..7),randint(1..5))}
\real{a=randint(10^(\n)..10^(\n+1)-1)}
\real{A=\a/10^(\p)}

\real{s=\a}
\integer{ct=0}
\for{i=1 to \n}{\real{b=10*floor(\s/10)}
\if{\b=\s}{\real{s=\s/10}
\integer{ct=\ct+1}}
}
\real{sol1= \a/10^(\n)}
\real{sol2=\n-(\p)}
\text{sol3=pari(\s)}
\real{sol4=\ct-\p}
\statement{用两种方式表示数 \(\A) : 
<ul><li>
浮点数 (科学记数法)
 <center> \(\A)
= \embed{reply 1, 12}\times 10<sup><sup>\embed{reply 2,4}</sup></sup></center>
</li>
<li> 
写成 \(a\times 10^p) 其中 \(a) 是整数但不是 10 的倍数 :
<center> \(\A)
= \embed{reply 3, 12}\times 10<sup><sup>\embed{reply 4,4}</sup></sup></center>
</li>
</ul>
}
\answer{指数}{\sol1}{type=numeric}
\answer{指数}{\sol2}{type=numeric}
\answer{指数}{\sol3}{type=numeric}
\answer{指数}{\sol4}{type=numeric}
