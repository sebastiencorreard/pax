\title{数的方幂}
\language{cn}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(2..5)}
\real{a=randint(2,3,5,4)}
\integer{c=randint(2,3,6,5,7,11)}
\integer{b= \a*\c}
\integer{p=randint(2..5)}
\integer{sol1= \c}
\integer{sol2= \n*\p}
\text{aa=pari(\a^(\sol2))}
\text{faux=pari(\n+\p)}
\integer{afaux=\a^(\faux)}
\statement{把 \((\frac{\b^{\n}}{\a^{\n}})^{\p}) 写成整数的幂
 (取最大可能的方幂)
:
<center> \((\frac{\b^{\n}}{\a^{\n}})^\p)= \embed{reply 1, 4}<sup><sup>
\embed{reply 2,4}</sup></sup></center>
}
\answer{}{\sol1}{type=numeric}
\answer{}{\sol2}{type=numeric}
\hint{首先化简分数.}
\feedback{\reply2<>\sol2} {你应用了规则 : \((a^n)^m=a^(n*m)) ?}
\feedback{\reply2=\faux and \reply2 <> \sol2 }{不要搞混 : 
<center>\((\a^\n)^\p= \a^{\n\times \p}=\a^{\sol2}=\aa ) </center> 和
<center>\(\a^\n\times \a^\p=\a^{\n+\p}=\a^{\faux}=\afaux)
</center>}
