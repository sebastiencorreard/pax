\title{十进数的界}
\language{cn}
\range{-5..5}
\author{Bernadette PERRIN-RIOU}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(3..6)}
\integer{p=random(randint(5..7),randint(1..3))}
\real{a=randint(10^(\n)..10^(\n+1)-1)}
\real{A=\a/10^(\p)}

\real{sol1= \n-(\p)}
\real{sol2=\n-(\p)+1}

\statement{用 10 的相邻的方幂给出数 \(\A) 的界.

 <center>10<sup><sup>\embed{reply 1,4}</sup></sup>\(\leq) \A
 < 10<sup><sup>\embed{reply 2,4}</sup></sup>
</center>
}
\answer{指数}{\sol1}{type=numeric}
\answer{指数}{\sol2}{type=numeric}
\hint{你可以先把 \(A) 写成科学记数法. }
