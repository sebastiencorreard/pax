\title{4. Le concessionnaire : + ou - de %}
\language{fr}
\range{-5..5}
\author{Julien LYOTARD}
\email{Julien.lyotard@ac-dijon.fr}

\computeanswer{no}
\format{html}
\precision{10000}

\text{style=wims(record 0 of style.css)} 

\text{pro=Quel sera le salaire d'Emmanuelle en fin de mois ?}

\text{chefdesventes=https://www.onisep.fr/Ressources/Univers-Metier/Metiers/chef-cheffe-des-ventes}

\integer{n=randint(10..50)}
\integer{s=randint(1200..2100)}

\text{choix=random(1,-1)}
\text{augdim=d'augmenter,de diminuer}
\text{modifie=\choix=1 ? item(1,\augdim):item(2,\augdim)}

\real{rep=(100+(\choix)*\n)}
\text{reptxt=\rep % =>}
\integer{sal=(100+(\choix)*\n)*\s/100}
\real{sol=(\choix)*\n}


\text{size=200x80x1}

\text{operation=  \( \frac {\s \times  \rep } {100} )}
\text{operation1=  \( \frac {\s \times  \n } {100} )}
\text{operation2=  \( \frac {\s \times  100} {\n} )}
\text{operation3=  \( \frac {\s \times  100 } {\n} )}


\text{listerole=Animateur,Entraineur,Coach,Manageur}
\text{but=Augmenter le chiffre d'affaire,Recruter des commerciaux,Encadrer ses collaborateurs,Concevoir des produits,Élaborer une stratégie marketing}
\text{condition=Horaire variable, Sur les routes,A l'intérieur,Sous pression,Horaire fixe,Dans un bureau,A l'extérieur,Sans pression}
\text{diplome=BTS,BUT,Diplôme d'école supérieure de commerce ou de gestion,Master en marketing ou en vente}
\text{symbol=\n,\n % =>,\operation1,\operation2,\operation3}

\matrix{STEP= reply1, reply2, reply3, reply4, reply5
reply6
reply7, reply8, reply9, reply10, reply11
reply12
}
\steps{\STEP}

\text{enonce1=Emmanuelle travaille en tant que commerciale
 chez un concessionnaire de voiture. Elle a un salaire fixe de \s &euro;.
 À chaque fin de mois, elle est conviée par <a class="lien" href="\chefdesventes" target="_blank"> le chef des ventes <span>la fiche métier</span></a>
 pour connaître le pourcentage des objectifs atteints.
En fonction des ventes réalisées,
 le chef décide \modifie son salaire de \n %.}

\statement{
<br>
<div class="consigne">
<div id="boited">
<img src="\imagedir/cons.jpg" alt="Voiture">
</div>
<div id="boiteg">
<img src="\imagedir/directeur.jpg" alt="Directeur">
</div>
<p class="problematique"> \pro</p>
<div class="consigne">\enonce1</div>
<br> 

 
\if{\step==1}{
<br>
<div class="consigne">
Après avoir consulté, la fiche métier
 en cliquant sur le lien <a class="lien" href="\chefdesventes" target="_blank"> le chef des ventes <span>la fiche métier</span></a>
 , répondez aux questions posées.
</div>
<br>
<div class="etape">ÉTAPE \step sur 4</div>
<div class="question">
Quel est le rôle d'un chef de ventes ? </div>
<ul>
\for{h = 1 to 4}{<li>\embed{reply1,\h}</li>}
</ul>

<div class="question">Quel est le but d'un chef des ventes ? </div>
\embed{reply2}
<br>
<div class="question">Quelles sont ses conditions de travail ? </div>
 \embed{reply3,\size}
<br>
<div class="question">Quel est le salaire brut d'un débutant ? </div>\embed{reply4,4}
<br>
<div class="question">Quel est le diplôme minimum qu'il doit posséder ?</div> \embed{reply5,200x90x1}
}
  
\if{\step==2}{
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Le pourcentage lié au nouveau salaire est  de \embed{reply6, 4} %.
</div>}

\if{\step=3}{ 
<br>
<div class="consigne">
Le pourcentage vient \modifie de <b>\rep %.</b></div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Complètez le tableau ci-dessous pour calculer le nouveau salaire. 
<br>
<table class="wimscenter">
<tr>
<td>\embed{reply7,\size}</td>
<td>\embed{reply8,\size}pour</td>
<td>\embed{reply9,\size}</td>
</tr><tr>
<td></td>
<td>\embed{reply10,\size}</td>
<td>\embed{reply11,\size}</td>
</tr></table>
<br>
</div>
}


\if{\step==4}{ 
<div class="consigne">Le calcul à réaliser est donc le suivant : <b>\operation</b>.</div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Le montant de son nouveau salaire est donc égale à \embed{reply12, 6} &#128;.
<br>
 Arrondissez votre résultat à l'euro près. 
</div>
  }
</div>}
\answer{Son rôle est :}{2,3,4;\listerole}{type=radio}{option=shuffle split}
\answer{Son but est :}{1,2,3;\but}{type=checkbox}{option=shuffle split}
\answer{Ses conditions de travail sont :}{1,2,3,4;\condition}{type=checkbox}{option=shuffle split}
\answer{Son salaire est de }{3000,3300,3500}{type=range}
\answer{Son diplôme minimum est de type }{BTS;\diplome}{type=dragfill}
\answer{Le nouveau pourcentage est }{\rep }{type=numeric}{weight=5}
\answer{Tableau 1}{\reptxt;\symbol}{type=dragfill}
\answer{Tableau 2}{\rep}{type=dragfill}
\answer{Tableau 3}{100}{type=dragfill}
\answer{Tableau 5}{\operation}{type=dragfill}
\answer{Tableau 6}{\s}{type=dragfill}



\answer{Votre nouveau salaire est de}{\sal}{type=numeric}{weight=5}
\solution{
<div class="solution">
\if{\step=2}{
Pour calculer le pourcentage lié au nouveau salaire, il suffit de réaliser l'opération suivante :
100 + \sol = \rep}
</div>}
