\statement{
<div class="consigne">
<p class="problematique"> Quels sont les salariés qui pourront accéder à leur logement ?</p>
 
<br>
\if{\step=1}{
<div class="consigne">Attribuez à chaque profession
 un logement de \special{help arbitraire, manière arbitraire}. Cliquez
 sur <b>"Envoyez la réponse"</b> pour transmettre vos propositions à un agent immobilier.</div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 3</div>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Profession</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
</tr>
\for{j=1 to 3}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>\embed{reply\j,100x100x1}</td>}
</table>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Profession</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
</tr>
\for{j=4 to 6}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>\embed{reply\j,100x100x1}</td>}
</table>
</div>
}

\if{\step=2}{ 
<br>
<div class="consigne">
L'agent immobilier reçoit donc 6 dossiers pour des demandes de
 logements. Dans ces dossiers, il récupère les données
 essentielles qui sont la profession, le montant du revenu de
 chacun des futurs occupants et le loyer. Il construit donc 
un tableau pour recenser les divers renseignements. <br>
Puis il calcule le pourcentage que représente le loyer par rapport
 au revenu. Ils réalise donc le calcul suivant :
<div class="wimscenter"> \( {\frac {montant\;du\;loyer} {montant\;du\;salaire}} \times {100})</div>
<img src="\imagedir/attention.png" alt="Attention" > aux \special{help Arrondi, arrondis}.
</div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 3</div>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Statut social</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
<th>&nbsp;&nbsp;Loyer&nbsp;</th>
<th>Pourcentage arrondi à l'unité</th>
</tr>
\for{j=1 to 3}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>\if{\j=1}{\rep1}
\if{\j=2}{\rep2}
\if{\j=3}{\rep3}
</td>
<td>\logement[\numero[\j];1] &euro;</td>
<td>\embed{reply\j+6,1}</td>}
</table>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Statut social</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
<th>&nbsp;&nbsp;Loyer&nbsp;</th>
<th>Pourcentage arrondi à l'unité</th>
</tr>
\for{j=4 to 6}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>\if{\j=4}{\rep4}
\if{\j=5}{\rep5}
\if{\j=6}{\rep6}
</td>
<td>\logement[\numero[\j];1] &euro;</td>
<td>\embed{reply\j+6,1}</td>}
</table>
</div>
}

\if{\step>=3}{ 
<br>
<div class="consigne">Après avoir calculé le pourcentage du loyer par
 rapport au revenu, il attribut le logement seulement aux personnes
 dont le loyer n'\special{help Synonyme, exède} pas 33% des revenus.
<br>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Statut social</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
<th>&nbsp;&nbsp;Loyer&nbsp;</th>
<th>% arrondi à l'unité</th>
</tr>
\for{j=1 to 3}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>
\if{\j=1}{\rep1}
\if{\j=2}{\rep2}
\if{\j=3}{\rep3}
</td>
<td>\logement[\numero[\j];1] &euro;</td>
<td>
\if{\j=1}{\if {\pourcentage1==\resultat1}{<span class="oef_condgood">\pourcentage1 %</span>}{<span class="oef_condbad"><strike>\pourcentage1 %</strike></span><span class="oef_condgood"> \resultat1 %</span>}}
\if{\j=2}{\if {\pourcentage2==\resultat2}{<span class="oef_condgood">\pourcentage2 %</span>}{<span class="oef_condbad"><strike>\pourcentage2 %</strike></span><span class="oef_condgood"> \resultat2 %</span>}}
\if{\j=3}{\if {\pourcentage3==\resultat3}{<span class="oef_condgood">\pourcentage3 %</span>}{<span class="oef_condbad"><strike>\pourcentage3 %</strike></span><span class="oef_condgood"> \resultat3 %</span>}}
</td>
}
</table>
<table class="wimscenter wimsborder" style="display: inline-block;">
<tr>
<th>Statut social</th>
<th>Salarié</th>
<th>Salaire</th>
<th>Logement</th>
<th>&nbsp;&nbsp;Loyer&nbsp;</th>
<th>% arrondi à l'unité</th>
</tr>
\for{j=4 to 6}{
<tr>
<td>\locataire[\li[\j];1]</td>
<td>\locataire[\li[\j];2]</td>
<td>\locataire[\li[\j];3] &euro;</td>
<td>\if{\j=4}{\rep4}
\if{\j=5}{\rep5}
\if{\j=6}{\rep6}
</td>
<td>\logement[\numero[\j];1] &euro;</td>
<td>
\if{\j=4}{\if {\pourcentage1==\resultat1}{<span class="oef_condgood">\pourcentage4 %</span>}{<span class="oef_condbad"><strike>\pourcentage4 %</strike></span><span class="oef_condgood"> \resultat4 %</span>}}
\if{\j=5}{\if {\pourcentage2==\resultat2}{<span class="oef_condgood">\pourcentage5 %</span>}{<span class="oef_condbad"><strike>\pourcentage5 %</strike></span><span class="oef_condgood"> \resultat5 %</span>}}
\if{\j=6}{\if {\pourcentage3==\resultat3}{<span class="oef_condgood">\pourcentage6 %</span>}{<span class="oef_condbad"><strike>\pourcentage6 %</strike></span><span class="oef_condgood"> \resultat6 %</span>}}
</td>
}
</table>





</div>

<br>
<div class="question">
\if{\step==3}{<div class="etape">ÉTAPE \step sur 3</div>}
Quels sont les dossiers qui vont être acceptés par l'agent immobilier?
<br>
<div class="wimscenter">\embed{reply13,115x115x6}</div>
</div>
}

</div>}


\answer{}{\rep1;\loge}{type=clickfill}{option=nonstop noanalyzeprint}
\answer{}{\rep2}{type=clickfill}{option=nonstop noanalyzeprint}
\answer{}{\rep3}{type=clickfill}{option=nonstop noanalyzeprint}
\answer{}{\rep4}{type=clickfill}{option=nonstop noanalyzeprint}
\answer{}{\rep5}{type=clickfill}{option=nonstop noanalyzeprint}
\answer{}{\rep6}{type=clickfill}{option=nonstop noanalyzeprint}

\help{ \style
\if{ \help_subject issametext arbitraire}{<div class="aide">
<b>De manière arbitraire :</b> Vous choisissez d'attribuer les logements comme vous souhaitez.
</div>}
\if{ \help_subject issametext Arrondi}{<div class="aide">\Ar</div>}
\if{ \help_subject issametext Synonyme}{<div class="aide">Un synonyme du verbe <b>
 excéder </b> est :<ul>
<li> <b>dépasser</b> </li>
<li> <b>être supérieur à</b> </li></ul></div>}
}

\text{numero=position(\rep1,\loge),position(\rep2,\loge),position(\rep3,\loge),position(\rep4,\loge),position(\rep5,\loge),position(\rep6,\loge)}

\integer{loyer1=\logement[\numero[1];1]}
\integer{salaire1=\locataire[\li[1];3]}
\integer{resultat1=(\loyer1)/(\salaire1)*100}
\integer{loyer2=\logement[\numero[2];1]}
\integer{salaire2=\locataire[\li[2];3]}
\integer{resultat2=(\loyer2)/(\salaire2)*100}
\integer{loyer3=\logement[\numero[3];1]}
\integer{salaire3=\locataire[\li[3];3]}
\integer{resultat3=(\loyer3)/(\salaire3)*100}
\integer{loyer4=\logement[\numero[4];1]}
\integer{salaire4=\locataire[\li[4];3]}
\integer{resultat4=(\loyer4)/(\salaire4)*100}
\integer{loyer5=\logement[\numero[5];1]}
\integer{salaire5=\locataire[\li[5];3]}
\integer{resultat5=(\loyer5)/(\salaire5)*100}
\integer{loyer6=\logement[\numero[6];1]}
\integer{salaire6=\locataire[\li[6];3]}
\integer{resultat6=(\loyer6)/(\salaire6)*100}

\text{resultat=\resultat1,\resultat2,\resultat3,\resultat4,\resultat5,\resultat6}

\answer{}{\pourcentage1}{type=numeric}{option=noanalyzeprint}
\answer{}{\pourcentage2}{type=numeric}{option=noanalyzeprint}
\answer{}{\pourcentage3}{type=numeric}{option=noanalyzeprint}
\answer{}{\pourcentage4}{type=numeric}{option=noanalyzeprint}
\answer{}{\pourcentage5}{type=numeric}{option=noanalyzeprint}
\answer{}{\pourcentage6}{type=numeric}{option=noanalyzeprint}


\condition{Pour le pourcentage 1 vous avez répondu \pourcentage1 %. La bonne réponse est de \resultat1 %.}{\pourcentage1=\resultat1}
\condition{Pour le pourcentage 2 vous avez répondu \pourcentage2 %. La bonne réponse est de \resultat2 %.}{\pourcentage2=\resultat2}
\condition{Pour le pourcentage 3 vous avez répondu \pourcentage3 %. La bonne réponse est de \resultat3 %.}{\pourcentage3=\resultat3}
\condition{Pour le pourcentage 4 vous avez répondu \pourcentage4 %. La bonne réponse est de \resultat4 %.}{\pourcentage4=\resultat4}
\condition{Pour le pourcentage 5 vous avez répondu \pourcentage5 %. La bonne réponse est de \resultat5 %.}{\pourcentage5=\resultat5}
\condition{Pour le pourcentage 6 vous avez répondu \pourcentage6 %. La bonne réponse est de \resultat6 %.}{\pourcentage6=\resultat6}

\if{\step=2}{
\for{u=1 to 6}{\text{personnage=\resultat[\u] <= \a ? wims(append item \u to \personnage)}}
\for{u=1 to items(\personnage)}{\text{rrzz=\rrzz,\locataire1[\personnage[\u]]}}
\text{rrzz=wims(nonempty items \rrzz)}
\text{test1=wims(listcomplement \rrzz in \locataire1)}}
\answer{}{\plumo;\locataire1}{type=dragfill}{option=nonstop analyzeprint noorder}
\text{test2=wims(listcomplement \plumo in \rrzz)}
\condition{Vous avez choisi les bons dossiers }{\plumo notin \test1 and items(\rrzz)==items(\plumo) and items(\test2)==0}
\feedback{\plumo isin \test1 or items(\rrzz)!=items(\plumo) or items(\test2)!=0}{<b>Vous avez choisi les candidats suivants : \reply13 mais
 vous auriez du choisir les candidatures : \rrzz .</b>}

\text{nstep=}
\text{nstep=\step=2 ? reply7, reply8, reply9, reply10, reply11, reply12}
\text{nstep=\step=3? reply13}
