\integer{loyerimmeublebis=randint(300..400)}
\integer{loyerimmeuble=randint(400..500)}
\integer{loyerpetitemaison=randint(500..600)}
\integer{loyermaison=randint(600..1000)}
\integer{loyermaisoncampagne=randint(1000..1500)}
\integer{loyermaisonarchitecte=randint(1500..2000)}

\integer{SalaireRetraite=randint(2000..4000)}
\integer{SalairePolicier=randint(1500..3000)}
\integer{SalaireFemmeAffaire=randint(5000..6000)}
\integer{SalaireChimiste=randint(2000..2500)}
\integer{SalaireArtisan=randint(3000..4000)}
\integer{SalaireDocteur=randint(4000..6000)}

\matrix{locataire=
Artisan,<img src="\imagedir/Artisan.jpg" alt="Artisan" >,\SalaireArtisan
Chimiste,<img src="\imagedir/Chimiste.jpg" alt="Chimiste" >,\SalaireChimiste
Retraité,<img src="\imagedir/PersonneAge.jpg" alt="Peronne âgée" >,\SalaireRetraite
Femme d'affaire,<img src="\imagedir/FemmeAffaire.jpg" alt="Femme d'affaire" >,\SalaireFemmeAffaire
Policier,<img src="\imagedir/Policier.jpg" alt="Policier" >,\SalairePolicier
Docteur,<img src="\imagedir/Docteur.jpg" alt="Docteur" >,\SalaireDocteur
}
\text{li=shuffle(rows(\locataire))}
\text{loca=column(2,\locataire)}
# indispensable
\text{locataire1=\locataire[\li[1..6];2]}

\matrix{logement=
\loyerimmeublebis,<img src="\imagedir/Immeublebis.jpg" alt="Immeuble bis" >
\loyerimmeuble,<img src="\imagedir/Immeuble.jpg" alt="Immeuble" >
\loyerpetitemaison,<img src="\imagedir/PetiteMaison.jpg" alt="Petite Maison" >
\loyermaison,<img src="\imagedir/Maison.jpg" alt="Maison" >
\loyermaisoncampagne,<img src="\imagedir/MaisonCampagne.jpg" alt="Maison de campagne" >
\loyermaisonarchitecte,<img src="\imagedir/MaisonArchitecte.jpg" alt="Maison d'architecte" >
}
\text{loge=column(2,\logement)}

#indispensable pour afficher les réponses utiles en mode debug

