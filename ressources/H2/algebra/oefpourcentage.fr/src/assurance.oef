\title{3. Assurance : + ou - de &#37;}
\language{fr}
\range{-5..5}
\author{Julien LYOTARD}
\email{Julien.Lyotard@ac-dijon.fr}

\computeanswer{no}
\format{html}
\precision{10000}

\text{style=wims(record 0 of style.css)} 
\text{pc=wims(record 0 of help/ProduitenCroix.txt)} 
\text{Ar=wims(record 0 of help/Arrondi.txt)} 

\integer{primescooter=randint(500..800)}
\integer{prime2CV=randint(100..300)}
\integer{primemini=randint(700..1000)}
\integer{primevoituresport=randint(800..1300)}
\integer{a=randint(0..2)}

\if{\a==0}{\integer{\n=5}}
\if{\a==1}{\integer{\n=25}}
\if{\a==2}{\integer{\n=56}}
\if{\a==0}{\text{choix=-1}}{\text{choix=1}}
\if{\a==2}{\text{acci=accidents responsables}}{\text{acci=accident responsable}}
\text{augdim=d'augmenter,de diminuer}
\text{modifie=(\a==1 or \a==2)? item(1,\augdim):item(2,\augdim)}
\text{ad=augmente,diminue}
\text{mod=(\a==1 or \a==2)? item(1,\ad):item(2,\ad)}

\text{listeCV=2CV4.jpg,2CV3.jpg}
\text{CV=randomitem(\listeCV)}

\text{listescooter=scootersympa.jpg,scooterpink.jpg,scooterjeune.jpg}
\text{scooter=randomitem(\listescooter)}

\text{listesmini=minicoopers1.jpg,minicoopers2.jpg,minicooperspink.jpg}
\text{mini=randomitem(\listesmini)}

\text{listesvoituresports=cons.jpg,consession.jpg,porchegt.jpg}
\text{voituresports=randomitem(\listesvoituresports)}


\matrix{vehicule=
sa mini cooper,\imagedir/\mini,\primescooter
sa 2CV,\imagedir/\CV,\prime2CV
son scooter,\imagedir/\scooter,\primescooter
sa voiture de sport,\imagedir/\voituresports,\primevoituresport}

\text{quest = randomrow(\vehicule)}


\real{rep=(100+(\choix)*\n)}
\text{reptxt=\rep &#37; =>}
\integer{sal=(100+(\choix)*\n)*\quest[3]/100}
\real{resultvirgule=(100+(\choix)*\n)*\quest[3]/100}
\real{sol=(\choix)*\n}
\text{size=200x80x1}

\text{\operation=  \( \frac {\quest[3] \times  \rep } {100} )}
\text{\operation1=  \( \frac {\quest[3] \times  \n } {100} )}
\text{\operation2=  \( \frac {\quest[3] \times  100} {\n} )}
\text{\operation3=  \( \frac {\quest[3] \times  100 } {\n} )}

\text{symbol=\n,\n &#37; =>,\operation1,\operation2,\operation3}

\matrix{STEP= reply1 
reply2, reply3, reply4, reply5,reply6,
reply7
}
\nextstep{\STEP}
\text{pro=Quelle sera la prime d'assurance payée par Lucas ?}

\text{enonce2=La compagnie assurance TOURIX assure le véhicule de
 Lucas. Pour assurer \quest[1], celui-ci paye \quest[3] &#8364;.
 Lucas est un jeune conducteur donc son pourcentage lié à la prime
 est de 100 &#37;. Dans son contrat, il est spécifié les points
 suivants :<br>
<ul class="circle"><li>Si aucun accident responsable ne lui arrive
 durant l'année, il profite d'un bonus de <b>5 &#37;.</b></li>
<li>En cas d'un accident responsable, une majoration de
 <b>25 &#37;</b> sera appliquée.</li>
<li>En cas de 2 accidents responsables, une majoration de
 <b>56 &#37;</b> sera appliquée.</li>
</ul>
Sur l'année Lucas a eu <b>\a</b> \acci.
<br><br>}

\statement{
<div class="consigne">
<div id="boited">
<img src="\quest[2]" alt="véhicule" >
</div>
<p class="problematique">\pro</p>
<br><br>
<div class="consigne">\enonce2</div>

\if{\step==1}{
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Le pourcentage lié à la nouvelle prime est
 de \embed{reply1, 4} &#37;.</div>

\special{help Indication, Super Aide}
}

\if{\step=2}{ 
<br>
<div class="consigne">Le pourcentage vient \modifie de <b>\rep &#37;.</b></div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Complètez le tableau ci-dessous pour calculer la nouvelle prime. 

<table class="wimscenter wimsborder">
<tr>
<td>\embed{reply2,\size}</td>
<td>\embed{reply3,\size}pour</td>
<td>\embed{reply4,\size}</td>
</tr><tr>
<td></td>
<td>\embed{reply5,\size}</td>
<td>\embed{reply6,\size}</td>
</tr></table>
</div>
\special{help Aide, Super Aide}
}


\if{\step==3}{ 
<br>

<br>
<div class="consigne">Le calcul à réaliser est donc le suivant : <b>\operation</b>.</div>
<br>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
Le montant de sa prime est donc égale à \embed{reply7, 6} €.
<br>
 Arrondissez votre résultat à l'euro près.
</div>
\special{help Arrondi, Super Aide}
}

\if{\step==4 and \prime!=\sal}{
<br>

<br>
<div class="consigne">Le calcul à réaliser est donc le suivant : <b>\operation</b>.</div>
<br>
<br>
<div class="cours">Arrondissez votre résultat à l'euro près. Consultez
 l'aide pour plus de précision.</div>
<br>
<div class="question">
<div class="etape">ÉTAPE \step sur 4</div>
<b>2ÈME ESSAI:</b> Le montant de sa prime est donc égale à \embed{reply8, 6} €.
<br>
</div>
\special{help Arrondi, Super Aide}
}

</div>}


\help{ \style
\if{ \help_subject issametext Aide}{<div class="aide">\pc</div>}
\if{ \help_subject issametext Arrondi}{<div class="aide">\Ar</div>}
\if{ \help_subject issametext Indication}{<div class="aide">
<ul>
<li type="square">Lorsque Lucas n'a pas d'accident, la prime diminue.</li>
<li type="square">Lorsque Lucas a un ou plusieurs accidents, la prime augmente.</li>
</ul>
</div>}
}

\answer{Pourcentage }{\rep }{type=numeric}{weight=5}
\answer{Tableau 1}{\reptxt;\symbol}{type=dragfill}
\answer{Tableau 2}{\rep}{type=dragfill}
\answer{Tableau 3}{100}{type=dragfill}
\answer{Tableau 5}{\operation}{type=dragfill}
\answer{Tableau 6}{\quest[3]}{type=dragfill}

\answer{nouvelle prime}{\prime}{type=numeric}{weight=5}
\answer{nouvelle prime}{\sal}{type=numeric}{weight=5}

\condition{Votre première réponse est-elle correcte ?? }{\prime=\sal}
\text{STEP=}
\if{ \step=4 and \prime!=\sal}{\text{STEP = r8}}
\feedback{\prime!=\sal and \reply8=\sal}{Vous avez répondu correctement au 2ème essai.}

\solution{ \style
<br>
<div class="solution">
\if{\step=1}{
Sur l'année Lucas a eu <b>\a</b> \acci. La prime de départ est de 100 &#37; et elle
 \mod de \n &#37;. Pour calculer le nouveau pourcentage lié à 
 l'assurance, il suffit de réaliser l'opération suivante :
100 + \sol = \rep}
\if{\step=2}{
Le pourcentage vient \modifie de <b>\rep &#37;</b>. Pour utiliser
 un pourcentage, il suffit de construire un tableau de
 proportionnalité comme indiqué : 
<br>
<br>
<table align="center" border=1>
<tr>
<td align=center>\rep &#37; =></td>
<td align=center>\rep pour</td>
<td align=center>100</td>
</tr><tr>
<td align=center></td>
<td align=center>\( \frac {\quest[3] \times  \rep} {100} = \sal )</td>
<td align=center>\quest[3]</td>

</tr></table>
<br>
<div class="cours">
A savoir : Pour compléter un tableau de proportionnalité,
 on multiplie les nombres en diagonale et on divise par le dernier.
</div>
}
\if{\step=4 and \prime!=\sal and \reply8!=\sal}{En réalisant l'opération proposée sur votre calculatrice,
vous trouvez le résultat suivant : \resultvirgule.
En utilisant la règle suivante :<br>
<div class="cours">
A savoir : Lorsque le nombre après la virgule est compris entre 0 et 4
, on arrondi en dessous.
Lorsque le nombre après la virgule est compris entre 5 et 9
, on arrondi au dessus.
 </div>
Par conséquent le montant de la prime est de \sal €.
}
</div>
}
