!ifval $val20=$val25
 condtest3=1
!else
 condtest3=0
!endif
condname3=la bonne réponse est de $val25 % 

!ifval $val21=$val26
 condtest4=1
!else
 condtest4=0
!endif
condname4=le prix de l'article avec la remise est de $val26 € 

