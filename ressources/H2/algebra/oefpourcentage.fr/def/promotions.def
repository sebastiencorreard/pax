$()
!exit

:postdef
val22=$[rint($val16*$val17)]
val23=$[$val22/100]
val24=$[$val16-$val23]
val25=$[100-$val17]
val26=$[$val16-$val23]
val13=

!ifval ($m_step=3 and $val18=$val23) 
val13= reply5
!endif

!ifval ($m_step=4 and $val19=$val24) 
val13= reply6
!endif

!ifval ($m_step=5 and $val20=$val25) 
val13= reply7
!endif

!ifval ($m_step=6 and $val21=$val26) 
val13= 
!endif

!exit

