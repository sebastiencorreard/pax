\title{Percentage}
\language{nl}
\range{-5..5}
\author{Bernadette Perrin-Riou}
\email{bpr@math.u-psud.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{n=randint(10..90)}
\text{u=randint(1..5)}
\text{longueur=item(\u,een lengte, een volume,een hoogte,een gewicht,een prijs)}
\text{l=item(\u,l,v,h,m,p)}
\text{choix=random(1,-1)}
\text{augdim=verhoogt,verlaagt}
\text{augmente=\choix=1 ? item(1,\augdim):item(2,\augdim)}

\real{rep=(100+(\choix)*\n)/100}

\statement{Je \augmente  \longueur  \(\l) met \n %. Met hoeveel moeten wij  \(\l) vermenigvuldigen? }
\answer{Je moet \(\l) vermenigvuldigen met }{\rep}{type=numeric}
