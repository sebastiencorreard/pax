\title{Restaurant}
\language{ca}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{x=random(2..8)}
\integer{y=random(2..8)}
\integer{pers=\x+\y}
\integer{child=random(13..25)}
\integer{adult=random(\child*1.2..\child*1.8)}
\integer{tot=\child*\x+\adult*\y}

\statement{\pers persones van a un restaurant a menjar.
<p>
El menú té un preu de \child euros per cada xiquet, i \adult euros per
cada adult. S'ha pagat un total de \tot euros.
<p>
Entre aquestes \pers persones,
quants xiquets i quants adults hi ha?
}

\answer{Xiquets}{\x}{type=default}
\answer{Adults}{\y}{type=default}
\solution{Sigui x el número de xiquets, i y el número d'adults.
Tenim el següent sistema. <p><center>
	x + y = \pers<br>
	\child x + \adult y = \tot
</center> <p>
I la solució d'aquest sistema és x=\x, y=\y.
}

