\title{Rectangle}
\language{ca}
\range{-5..5}
\author{XIAO Gang}
\email{xiao@unice.fr}
\computeanswer{no}
\format{html}
\precision{10000}

\integer{y=random(20..50)}
\integer{diff=random(20..50)}
\integer{x=\y+\diff}
\integer{peri=2*(\x+\y)}

\statement{El perímetre d'un rectangle és \peri mm. Saben que 
és \diff mm més llarg que ample, troba la longitud i l'amplada
 del rectangle (en mm).
}

\answer{Longitut}{\x}{type=default}
\answer{Amplada}{\y}{type=default}
\solution{Sigui x = longitud, y = amplada. Llavors
tenim el següent sistema. <p><center>
	2x + 2y = \peri<br>
	x - y = \diff
</center> <p>
I la solució d'aquest sistema és x=\x, y=\y.
}

