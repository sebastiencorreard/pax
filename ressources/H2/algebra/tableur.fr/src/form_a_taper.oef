\langage {fr}
\author{Lionel,Verbecq}
\email{lionel.verbecq@ac-versailles.fr}
\langage{html}

\title{II Quelle est la formule ? (réf. rel.)2}

\text{sign1=randitem(+, -)}
\text{sign2=randitem(+, -)}
\text{a=wims (values v for v=2 to 9)}
\text{a=shuffle(\a)}
\text{A=randitem(A,B,C,D,E,F,G)}
\text{expres=\a[1]*x^2\sign1\a[2]*x\sign2\a[3]}
\text{sol=wims(replace internal x by A2 in \expres)}


\text{quest=Quelle formule faut-il rentrer en B2 pour ensuite l'étirer vers le bas ?}

\text{test=}
\text{test2=}
\text{rep2=}
\text{egal=}

\statement{
<div class="grid-x grid-margin-x">
  <div class="cell small-12 medium-6 large-7">
     On considère l'expression littérale suivante \(\A=\expres\).
     <p>On souhaite utiliser un tableur afin de calculer le résultat de cette expression 
     pour des valeurs numériques placées dans la première colonne.</p>
   <p>\quest</p>
  \embed{r1,50,30}
</div>
   <div class="cell small-12 medium-6 large-5">
     <img  src="\imagedir/tab1bis.jpg" alt="" style="width:300px;" />
   </div>
 
</div>}
\answer{ La formule à entrer est }{\rep}{type=raw}
\text{egal=wims(char 1 of \rep)}
\text{rep2=wims(char 2 to -1 of \rep)}
\text{test=pari((\rep)-(\sol)==0)}
\text{test2=pari((\rep2)-(\sol)==0)}
\condition{Votre formule commence-t-elle bien par le signe égal ?}{\egal issametext =}{weight=1}
\condition{Votre formule est-elle correcte ? }{\test issametext 1 or \test2 issametext 1}{weight=4}
\feedback{A2 notin \rep }{ Attention : vous n'avez pas utilisé les références de la cellule contenant la valeur -5. Cette référence est " A2 ".}
\feedback{* notin \rep }{ Attention : en général dans un tableur, on est obligé d'indiquer les signes de multiplication par le symbole " * " }
\feedback{² isin \rep }{ Attention : pour la puissance deux, utiliser par exemple " ^2 ". }
