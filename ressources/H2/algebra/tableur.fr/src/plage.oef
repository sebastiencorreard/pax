\title{I Quels sont les nombres de la plage...}
\langage {fr}
\author{Paul,Byache}
\email{paul@byache.fr}
\langage{html}

\integer{x1=random(4)}
\integer{i=random(2)}
\integer{x2=\x1+\i}
\integer{y1=random(8)}
\integer{j=random(0,1)}
\integer{y2=\y1+\j}
\text{a1=item(\x1,A,B,C,D,E,F)}
\text{a2=item(\x2,A,B,C,D,E,F)}

\text{rep=}
\for{m=0 to \i}{
\for{n=0 to \j}{
\integer{plus=6*(\y1+\n-1)+\x1+\m}
\text{rep=\rep,\plus}
}}

\statement{Voici une image de page de <b>tableur</b>.<br>
Donnez la liste des nombres écrits dans la plage \a1\y1:\a2\y2
<br>
(séparés par des virgules). \embed{r1}<div class="wimscenter">
\img{\imagedir/tablplein.JPG}</div>
}

\answer{}{\rep}{type=set}
