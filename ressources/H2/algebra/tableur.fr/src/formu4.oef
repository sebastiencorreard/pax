\title{III Quelle est la formule ? (réf. abs.)2}
\langage {fr}
\author{Paul,Byache}
\email{paul@byache.fr}
\langage{html}

choix de la ligne et la colonne sur laquelle porte la question
\integer{ligne=random(5)+2}
\integer{colonne=random(5)}

\text{alphabet=C,D,E,F,G,H,I,J,K,L}
lettre désigne l'intitulé de la colonne sur laquelle porte la question
\text{lettre=item(\colonne,\alphabet)}

référence de la cellule sur laquelle porte la question
\text{cel=wims(nospace \lettre \ligne)}

bonne réponse
\text{good=wims(nospace =\lettre $2 * $B \ligne)}

emplacement de la case sur laquelle porte la question (pixels)
\integer{x=183+(\colonne-1)*73.6}
\integer{y=140+(\ligne-1)*19.1}

autres réponses
on met des dollars partout où c'est possible dans "=C2*B5"
\text{reps=}
\for{i=1 to 2}{
 \for{j=1 to 2}{
  \for{k=1 to 2}{
   \for{l=1 to 2}{
     \text{d1=item(\i,,$)}
     \text{d2=item(\j,,$)}
     \text{d3=item(\k,,$)}
     \text{d4=item(\l,,$)}
     \text{reps=\reps,=\d1 \lettre \d2 2* \d3 B \d4 \ligne}
   }
  }
 }
}
\text{reps=wims(nospace \reps)}
\text{reps=wims(nonempty item \reps)}
\text{reps=wims(listcomplement \good in \reps)}
\text{reps=wims(shuffle \reps)}
\text{reps=item(1..3,\reps)}

\statement{
Voici l'image d'un écran de tableur.<br>
Les cellules colorées ont permis de calculer rapidement les tables de multiplications.<br>
Quelle formule doit-on taper dans la cellule \cel si on veut remplir
 toute la fin du tableau en "tirant" cette formule <b>vers la droite et vers le bas ?</b>

<div class="wimscenter">
\special{imagefill \imagedir/im3.jpg,1059x381,74x19
reply 1,\x x \y
}
</div> }

\answer{ }{ \good;\reps }{ type=clickfill } {option=shuffle}
