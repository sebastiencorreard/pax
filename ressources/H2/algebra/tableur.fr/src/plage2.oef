\title{I Sélectionner la plage [Java].}
\langage {fr}
\author{Paul,Byache}
\email{paul@byache.fr}
\langage{html}

\integer{x1=random(2)}
\integer{i=random(4)}
\integer{x2=\x1+\i}
\integer{y1=random(6)}
\integer{j=random(2)}
\integer{y2=\y1+\j}
\text{a1=item(\x1,A,B,C,D,E,F)}
\text{a2=item(\x2,A,B,C,D,E,F)}

\integer{xe1=34+(\x1-1)*81-5}
\integer{xe2=34+(\x2)*81+5}
\integer{ye1=138+(\y1-1)*17-5}
\integer{ye2=138+(\y2)*17+5}

\integer{xi1=34+(\x1-1)*81+10}
\integer{xi2=34+(\x2)*81-10}
\integer{yi1=138+(\y1-1)*17+7}
\integer{yi2=138+(\y2)*17-7}

\text{url_dessin = draw(525,278
xrange 0,525
yrange 0,278
copy 0,278,-1,-1,-1,-1,tablvide.jpg) }

\statement{Voici une image de page de <b>tableur</b>.<br>
Sélectionnez la plage \a1\y1:\a2\y2
<div class="wimscenter">\embed{r1,525 x 278}</div>
}

\answer{}{\url_dessin;rectangle,\xe1,\ye1,\xe2,\ye2,\xi1,\yi1,\xi2,\yi2}{type=jsxgraphcurve}
