!set title=II Tableur et programme de calcul.  
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel,Verbecq
email=lionel.verbecq@ac-versailles.fr

ansorder=r
varcnt=7
prevarcnt=6
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=1
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 1, 20

val6=$[rint($(tmp0))]
tmp0=!randint 2, 20

val7=$[rint($(tmp0))]
val8=Parmi les propositions, sélectionner la formule à entrer dans la cellule B2 pour pouvoir ensuite l'étirer vers le bas ?
tmp0=!shuffle ((A2+$val6)*$val7)^2,=A2+$val6*$val7^2,A2+$val6*$val7^2,=((B1+$val6)*$val7)^2,((B1+$val6)*$val7)^2,=B1+$val6*$val7^2,B1+$val6*$val7^2,=((B2+$val6)*$val7)^2,((B2+$val6)*$val7)^2,=B2+$val6*$val7^2,B2+$val6*$val7^2,=((-6+$val6)*$val7)^2,((-6+$val6)*$val7)^2,=-6+$val6*$val7^2,-6+$val6*$val7^2

val9=$(tmp0)
val10=$(val9[1..5])
val11==((A2+$val6)*$val7)^2
replytype1=clickfill
replyoption1=shuffle 
replyname1=
replygood1=$val11;$val10
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-7">	     Voici un programme de calcul.	<ul>	    <li> Choisir un nombre,</li>	    <li> ajouter $val6,</li>	    <li> multiplier par $val7,</li>	    <li> mettre le résultat au carré.</li>	</ul> 	<p>On souhaiterait effectuer les calculs de ce programme dans un tableur. 	<br>$val8</p>	<div class="wimscenter">  
!read oef/embed.phtml r1,150,40 
$()</div>	</div>	   <div class="cell small-12 medium-6 large-5">	     <img src="$val1/tab1.jpg" alt="" />	   </div>	</div>	
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:feedback
!ifval $m_sc_reply1=0
 <div class='oef_feedbacks'> <strong>On rappelle qu'une formule tableur commence par le signe = et reprend les références des cellules ( et non la valeur de la cellule ).</strong>
$()</div>
!endif

!exit

:test

!exit

:stat
vsavelist=1,6,7,8
embedcnt=1
