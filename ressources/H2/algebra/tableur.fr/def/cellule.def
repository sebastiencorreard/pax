!set title=I Quel est le nombre écrit dans la cellule...
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr

ansorder=r
varcnt=5
prevarcnt=4
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 6

val6=$[rint($(tmp0))]
tmp0=!randint 9

val7=$[rint($(tmp0))]
tmp0=!item $val6 of A,B,C,D,E,F

val8=$(tmp0)
val9=$[rint(6*($val7-1)+$val6)]
replytype1=numeric
replyname1=
replygood1=$[$val9]
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici une image de page de <b>tableur</b>.<br>	Quel est le nombre écrit dans la cellule $val8$val7 ? 
!read oef/embed.phtml r1	autocomplete="off" 
$()	<div class="wimscenter">	 
!read oef/img.phtml $val1/tablplein.JPG style="display: block;margin: auto;"  
$()	</div>	
$()
!exit

