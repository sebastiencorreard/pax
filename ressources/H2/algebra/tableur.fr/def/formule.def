val16=$[rint($(val10[6;1])$val7$(val10[6;2]))]
val17=$val11,$val12,$val13,$val14,$val15,$val16
val18=
!for val19 =$val9-1 to $val9+1 

!ifval $(val10[$val19;2])<0 
val20= ($(val10[$val19;2])) 
!else
val20= $(val10[$val19;2])
!endif
val18=$val18,= $(val10[$val19;1]) + $val20,= $(val10[$val19;1]) - $val20,= $(val10[$val19;1]) * $val20
!next
tmp0=!shuffle $val18

val18=$(tmp0)
tmp0=!item 1 to 4 of $val18

val18=$(tmp0)

!ifval $(val10[$val9;2])>-1 
tmp=!nonempty items $(val10[$val9;1]) * $(val10[$val9;2]),$(val10[$val9;1]) - $(val10[$val9;2]),$(val10[$val9;1]) + $(val10[$val9;2])

tmp0=!randitem $tmp
val20= $(tmp0) 
!else
val20= $(val10[$val9;1]) $val7 ($(val10[$val9;2]))
!endif
val18=$val18,= A $val7 B,$val20

!ifval $(val10[$val9;2])>-1 
val21= = $(val10[$val9;1]) $val7 $(val10[$val9;2]) 
!else
val21= = $(val10[$val9;1]) $val7 ($(val10[$val9;2]))
