val23=
!for val19 =1 to 6 
!for val24 =1 to 3 

!ifval $val24=3 
val25= $(val17[$val19]) 
!else
val25= $(val10[$val19;$val24])
!endif
val23=$val23	         text black,93+($val24-1)*81,135-($val19-1)*23,medium,$val25
!next
!next
