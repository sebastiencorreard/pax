val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

val6=$val1/tablvide.jpg
tmp0=!randint 6

val7=$[rint($(tmp0))]
tmp0=!randint 8

val8=$[rint($(tmp0))]
tmp0=!item $val7 of A,B,C,D,E,F

val9=$(tmp0)
val10=$[rint(70+($val7-1)*81)]
val11=$[rint(70+($val7)*81)]
val12=$[rint(200+($val8-1)*17)]
val13=$[rint(200+($val8)*17)]
replytype1=coord
replyname1=
replygood1=$val6;rectangle,$val10,$val12,$val11,$val13
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

