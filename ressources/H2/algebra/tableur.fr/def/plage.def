!set title=I Quels sont les nombres de la plage...
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Paul,Byache
email=paul@byache.fr

ansorder=r
varcnt=14
prevarcnt=13
postvarcnt=0
replycnt=1
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 4

val6=$[rint($(tmp0))]
tmp0=!randint 2

val7=$[rint($(tmp0))]
val8=$[rint($val6+$val7)]
tmp0=!randint 8

val9=$[rint($(tmp0))]
tmp0=!randitem 0,1

val10=$[rint($(tmp0))]
val11=$[rint($val9+$val10)]
tmp0=!item $val6 of A,B,C,D,E,F

val12=$(tmp0)
tmp0=!item $val8 of A,B,C,D,E,F

val13=$(tmp0)
val14=
!for val15 =0 to $val7 
!for val16 =0 to $val10 
val17=$[rint(6*($val9+$val16-1)+$val6+$val15)]
val14=$val14,$val17
!next
!next
replytype1=set
replyname1=
replygood1=$val14
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()Voici une image de page de <b>tableur</b>.<br>	Donnez la liste des nombres écrits dans la plage $val12$val9:$val13$val11	<br>	(séparés par des virgules).  
!read oef/embed.phtml r1 
$()<div class="wimscenter">	 
!read oef/img.phtml $val1/tablplein.JPG  
$()</div>	
$()
!exit

