!set title=II Quelle est la formule ? (réf. rel.)2
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
author=Lionel,Verbecq
email=lionel.verbecq@ac-versailles.fr

ansorder=r
varcnt=17
prevarcnt=12
postvarcnt=4
replycnt=1
choicecnt=0
conditioncnt=2
feedbackcnt=3
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp=!nonempty items +, -

tmp0=!randitem $tmp
val6=$(tmp0)
tmp=!nonempty items +, -

tmp0=!randitem $tmp
val7=$(tmp0)
tmp0=!values v for v=2 to 9

val8=$(tmp0)
tmp0=!shuffle $val8

val8=$(tmp0)
tmp=!nonempty items A,B,C,D,E,F,G

tmp0=!randitem $tmp
val9=$(tmp0)
val10=$(val8[1])*x^2$val6$(val8[2])*x$val7$(val8[3])
tmp0=!replace internal x by A2 in $val10

val11=$(tmp0)
val12=Quelle formule faut-il rentrer en B2 pour ensuite l'étirer vers le bas ?
val13=
val14=
val15=
val16=
replytype1=raw
replyname1=La formule à entrer est
replygood1=?analyze 17
question=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	<div class="grid-x grid-margin-x">	  <div class="cell small-12 medium-6 large-7">	     On considère l'expression littérale suivante 
!insmath $val9=$val10
$().	     <p>On souhaite utiliser un tableur afin de calculer le résultat de cette expression 	     pour des valeurs numériques placées dans la première colonne.</p>	   <p>$val12</p>	   
!read oef/embed.phtml r1,50,30 
$()	</div>	   <div class="cell small-12 medium-6 large-5">	     <img  src="$val1/tab1bis.jpg" alt="" style="width:300px;" />	   </div>	 	</div>
$()
!exit

:hint
$()
$()
!exit

:help
$()
$()
!exit

:solution
$()
$()
!exit

:latex
$()
$()
!exit

:postdef
tmp0=!char 1 of $val17

val16=$(tmp0)
tmp0=!char 2 to -1 of $val17

val15=$(tmp0)
t_=!replace internal \( by ( in ($val17)-($val11)==0
tmp0=!exec pari $t_

val13=$(tmp0)
t_=!replace internal \( by ( in ($val15)-($val11)==0
tmp0=!exec pari $t_

val14=$(tmp0)

!exit

:feedback
!ifval A2 notin $val17 
 <div class='oef_feedbacks'> Attention : vous n'avez pas utilisé les références de la cellule contenant la valeur -5. Cette référence est " A2 ".
$()</div>
!endif
!ifval * notin $val17 
 <div class='oef_feedbacks'> Attention : en général dans un tableur, on est obligé d'indiquer les signes de multiplication par le symbole " * " 
$()</div>
!endif
!ifval ² isin $val17 
 <div class='oef_feedbacks'> Attention : pour la puissance deux, utiliser par exemple " ^2 ". 
$()</div>
!endif

!exit

:test
condweight1=1 

!ifval $val16 issametext =
 condtest1=1
!else
 condtest1=0
!endif
condname1=Votre formule commence-t-elle bien par le signe égal ?
condweight2=4 

!ifval $val13 issametext 1 or $val14 issametext 1
 condtest2=1
!else
 condtest2=0
!endif
condname2=Votre formule est-elle correcte ? 

!exit

:stat
vsavelist=1,9,10,11,12,13,14,15,16,17
embedcnt=1
