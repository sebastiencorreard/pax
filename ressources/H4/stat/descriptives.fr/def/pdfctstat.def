!set title=Pièces défectueuses (Questions de statistiques)
!if $wims_read_parm!=$empty
 !goto $wims_read_parm
!endif
oef2wims_version=3.22
keywords=absolute_frequency, relative_frequency, percentage
author=Paul,Byache
email=paul@byache.fr
oefobservation=On peut donner les réponses en fractions ou en valeurs décimales. Une solution donne les bonnes réponses sous forme de fractions.
language=fr
computeanswer=yes
precision=200
oefcss=<style type="text/css"> .cadre {border-style:solid;text-align:center; border-width:0px;margin-left:auto; margin-right:auto; border: 1px; } .ctable {text-align:center;padding:4px;} .consigne {color:#000080;margin-bottom:6px;} .bonne {color:#008000;margin-bottom:6px;} .formatrep {font-style:italic;font-size:90%;} table.tableau, table.cadre {margin-left:auto; margin-right:auto; border-collapse: collapse; padding: 6px; margin-top: 10px; margin-bottom: 10px; } table.tableau th, table.cadre th { text-align:center; border: 1px solid #999; padding:6px; background-color:#D6EBEB; } table.tableau td, table.cadre td, table.tableau tr, table.cadre tr{ text-align:center; border: 1px solid #999; padding:6px; } table.tableau tr th:first-child { min-width:100px; } </style>

ansorder=r,r,r
varcnt=43
prevarcnt=42
postvarcnt=0
replycnt=3
choicecnt=0
conditioncnt=0
feedbackcnt=0
format=html

val1=$imagedir
val2=$confparm1
val3=$confparm2
val4=$confparm3
val5=$confparm4

!if $testcondition=yes
 !goto test
!endif
!if $status=waiting
 !exit
!endif

tmp0=!randint 2, 20

val6=$[rint($(tmp0)*1000)]
tmp0=!shuffle A,B,C,E,F,G,H

val7=$(tmp0)
val8=$(val7[1])
val9=$(val7[2])
val10=$(val7[3])
tmp0=!randint 2, 9

val11=$[rint($(tmp0))]
tmp0=!randint 2, 9

val12=$[rint($(tmp0))]
tmp0=!randint 2, 9

val13=$[rint($(tmp0))]
tmp0=!randint 1, 4

val14=$[rint($(tmp0)*10)]
tmp0=!randint 1, 4

val15=$[rint($(tmp0)*10)]
val16=$[rint(100-$val14-$val15)]
val17=$[rint($val6*$val14*$val11/10000)]
val18=$[rint($val6*$val15*$val12/10000)]
val19=$[rint($val6*$val16*$val13/10000)]
val20=$[rint($val6*($val14*$val11+$val15*$val12+$val16*$val13)/10000)]
val21=$[rint($val6*$val14*(100-$val11)/10000)]
val22=$[rint($val6*$val15*(100-$val12)/10000)]
val23=$[rint($val6*$val16*(100-$val13)/10000)]
val24=$[rint($val6*($val14*(100-$val11)+$val15*(100-$val12)+$val16*(100-$val13))/10000)]
val25=$[rint($val6*$val14/100)]
val26=$[rint($val6*$val15/100)]
val27=$[rint($val6*$val16/100)]
tmp=!translate internal $	$ to ; in Quelle est la fréquence des ampoules ayant un défaut parmi les ampoules produites par la machine $val8,f_$val8(D),$val17/$val25	Quelle est la fréquence des ampoules ayant un défaut parmi les ampoules qui n'ont pas été produites par la machine $val8,f_\overline{$val8}(D),($val20-$val17)/($val6-$val25)	Quelle est la fréquence des ampoules ayant un défaut parmi les ampoules produites par la machine $val9,f_$val9(D),$val18/$val26	Quelle est la fréquence des ampoules ayant un défaut parmi les ampoules qui n'ont pas été produites par la machine $val9,f_\overline{$val9}(D),($val20-$val18)/($val6-$val26)

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in Quelle est la fréquence des ampoules produites par la machine $val8 parmi celles qui ont un défaut,f_D($val8),$val17/$val20	Quelle est la fréquence des ampoules ne provenant pas de la machine $val8 parmi celles qui ont un défaut,f_D(\overline{$val8}),($val20-$val17)/$val20	Quelle est la fréquence des ampoules produites par la machine $val10 parmi celles qui ont un défaut,f_D($val10),$val19/$val20	Quelle est la fréquence des ampoules ne provenant pas de la machine $val10 parmi celles qui ont un défaut,f_D(\overline{$val10}),($val20-$val19)/$val20

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp1=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in Quelle est la fréquence des ampoules ayant un défaut,f(D),$val20/$val6	Quelle est la fréquence des ampoules n'ayant pas de défaut,f(\overline{D}),$val24/$val6	Quelle est la fréquence des ampoules provenant de la machine $val8,f($val8),$val25/$val6	Quelle est la fréquence des ampoules ne provenant pas de la machine $val9,f(\overline{$val9}),($val6-$val26)/$val6	Quelle est la fréquence des ampoules ne provenant pas de la machine $val10,f(\overline{$val10}),($val6-$val27)/$val6

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp2=!translate internal $\
$ to ; in $tmp
tmp=!translate internal $	$ to ; in Quelle est la fréquence des ampoules n'ayant pas de défaut parmi les ampoules produites par la machine $val10,f_$val10(\overline{D}),$val23/$val27	Quelle est la fréquence des ampoules produites par la machine $val10 parmi celles qui n'ont pas de défaut,f_\overline{D}($val10),$val23/$val24	Quelle est la fréquence des ampoules n'ayant pas de défaut parmi les ampoules produites par la machine $val9,f_$val9(\overline{D}),$val22/$val26	Quelle est la fréquence des ampoules produites par la machine $val9 parmi celles qui n'ont pas de défaut,f_\overline{D}($val9),$val22/$val24

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp3=!translate internal $\
$ to ; in $tmp
tmp=!trim $(tmp0)	$(tmp1)	$(tmp2)	$(tmp3)
val28=!translate internal $	\
$ to ;; in $tmp
tmp0=!shuffle 1,2,4

tmp1=!shuffle 3,$(tmp0)

val29=$(tmp1)
tmp=!trim $(val28[$(val29[1]);])	$(val28[$(val29[2]);])	$(val28[$(val29[3]);])	$(val28[$(val29[4]);])
val30=!translate internal $	\
$ to ;; in $tmp
tmp0=!replace internal / by , in $(val30[1;3])

val31=$(tmp0)
val32=$[rint($(val31[1]))]
val33=$[rint($(val31[2]))]
val34=$val32/$val33
tmp0=!replace internal / by , in $(val30[2;3])

val31=$(tmp0)
val32=$[rint($(val31[1]))]
val33=$[rint($(val31[2]))]
val35=$val32/$val33
tmp0=!replace internal / by , in $(val30[3;3])

val31=$(tmp0)
val32=$[rint($(val31[1]))]
val33=$[rint($(val31[2]))]
val36=$val32/$val33
tmp0=!replace internal / by , in $(val30[4;3])

val31=$(tmp0)
val32=$[rint($(val31[1]))]
val33=$[rint($(val31[2]))]
val37=$val32/$val33
tmp=!translate internal $	$ to ; in La machine $val8 produit $val14 % de la production, la machine $val9 produit $val15 % de la production et la machine $val10 fournit le reste.	La machine $val9 produit $val15 % de la production, la machine $val10 produit $val16 % de la production et la machine $val8 fournit le reste.	La machine $val8 produit $val14 % de la production, la machine $val10 produit $val16 % de la production et la machine $val9 fournit le reste.

tmp=!nonempty rows $tmp
tmp=!randrow $tmp
tmp0=!translate internal $\
$ to ; in $tmp
val38=$(tmp0)
replytype1=numeric
replyname1=question 1
replygood1=$[$(val30[1;3])]
replytype2=numeric
replyname2=question 2
replygood2=$[$(val30[2;3])]
replytype3=numeric
replyname3=question 3
replygood3=$[$(val30[3;3])]
question=__EXECUTED_1692754_EXERCISE__
solution=__EXECUTED_1692754_EXERCISE__

!goto stat

!exit

:question
$()	Un fabriquant d'ampoules possède trois machines notées $val8, $val9 et $val10.	La production quotidienne totale du fabriquant est de $val6 ampoules. Certaines ampoules présentent un défaut de fabrication.	Voici un tableau résumant les différents effectifs dans la production.	<table class="cadre">	<tr><td></td><th>Machine $val8</th><th>Machine $val9</th><th>Machine $val10</th><th>Total</th></tr>	<tr><th>Avec défaut</th><td>$val17</td><td>$val18</td><td>$val19</td><td>$val20</td></tr>	<tr><th>Sans défaut</th><td>$val21</td><td>$val22</td><td>$val23</td><td>$val24</td></tr>	<tr><th>Total</th><td>$val25</td><td>$val26</td><td>$val27</td><td>$val6</td></tr>	</table>	<p>$(val30[1;1]) ?  
!read oef/embed.phtml r1,10 
$()</p>	<p>$(val30[2;1]) ?  
!read oef/embed.phtml r2,10 
$()</p>	<p>$(val30[3;1]) ?  
!read oef/embed.phtml r3,10 
$()</p>	<div class="wims_instruction">Donnez vos réponses sous forme décimale ou sous forme de fraction. Par exemple, si une réponse est 20%,	vous pouvez répondre 0.2 ou 20/100 ou encore 1/5.</div>	
$()
!exit

