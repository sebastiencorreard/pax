{
  "Statement block": {
    "prefix": "statement",
    "body": [
      "\\statement{",
      "  $1",
      "}"
    ],
    "description": "Insert a statement block"
  },
  "Answer block": {
    "prefix": "answer",
    "body": [
      "\\answer{$1}{$2}{type=$3}"
    ],
    "description": "Insert an answer definition"
  },
  "If block": {
    "prefix": "if",
    "body": [
      "\\if{$1}{",
      "  $2",
      "}{$3}"
    ],
    "description": "Insert an OEF if block"
  },
  "For block": {
    "prefix": "for",
    "body": [
      "\\for{$1=1 to $2}{",
      "  $3",
      "}"
    ],
    "description": "Insert an OEF for loop"
  },
  "Inline math": {
    "prefix": "math",
    "body": [
      "\\($1\\)"
    ],
    "description": "Insert inline math delimiters"
  },
  "Embed": {
    "prefix": "embed",
    "body": [
      "\\embed{$1}"
    ],
    "description": "Insert an OEF embed placeholder"
  }
}
