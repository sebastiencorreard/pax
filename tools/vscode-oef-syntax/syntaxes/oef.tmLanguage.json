{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OEF",
  "scopeName": "source.oef",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#metaDirectives"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#math"
    },
    {
      "include": "#commandsWithArgs"
    },
    {
      "include": "#defVariables"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#html"
    },
    {
      "include": "#braces"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-percent.oef",
          "match": "%%.*$"
        },
        {
          "name": "comment.line.number-sign.def",
          "match": "(?m)^\\s*#.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.def",
          "match": "(?m)^\\s*:[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.label.reference.def",
          "match": "(?i)(?<=!goto\\s):?[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "metaDirectives": {
      "patterns": [
        {
          "name": "keyword.control.directive.oef",
          "match": "(?m)^\\s*![a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "keyword.control.directive.def",
          "match": "![a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.oef",
          "match": "(?i)\\b(?:wims|pari|maxima|texmath|rawmath|slib|random|randint|randitem|randomitem|shuffle|item|items|replace|expand|factor|fullratsimp|ratsimp|simplify|cancel|radsimp|diff|subst|ev|coeff|hipow|limit|cardinality|op|args|ordergreat|setdifference|concat|denominator|numerator|vecmax|vecmin|divrem|polcoeff|poldegree|matdet|isprime|matrix|vector|core|abs|sqrt|floor|ceil|row|rint|round|min|max|pow|sin|cos|tan|asin|acos|atan|atan2|log|log10|log2|exp|mod|fact|sign|gcd)\\b(?=\\s*\\()"
        }
      ]
    },
    "math": {
      "patterns": [
        {
          "name": "meta.math.inline.oef",
          "begin": "\\\\\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.math.begin.oef"
            }
          },
          "end": "\\\\\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.math.end.oef"
            }
          },
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#braces"
            }
          ]
        }
      ]
    },
    "commandsWithArgs": {
      "patterns": [
        {
          "name": "support.function.command.oef",
          "match": "\\\\(?:[A-Za-z][A-Za-z0-9_]*|[0-9]+)(?=\\s*\\{)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.indexed.oef",
          "match": "\\\\(?:[A-Za-z][A-Za-z0-9_]*|[0-9]+)\\[[^\\]\\r\\n]+\\]"
        },
        {
          "name": "variable.other.oef",
          "match": "\\\\(?:[A-Za-z][A-Za-z0-9_]*|[0-9]+)"
        }
      ]
    },
    "defVariables": {
      "patterns": [
        {
          "name": "variable.other.def.parenthesized",
          "match": "\\$\\([A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]\\r\\n]+\\])?\\)"
        },
        {
          "name": "variable.other.def",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.oef",
          "match": "(?<![A-Za-z0-9_])(?:-?\\d+(?:\\.\\d+)?(?:\\.\\.-?\\d+(?:\\.\\d+)?)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.oef",
          "match": "\\.\\.|>=|<=|!=|==|=|\\+|-|\\*|/|\\^|>|<|\\?|:"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oef",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oef",
              "match": "\\\\[\\\"nrt]"
            }
          ]
        },
        {
          "name": "string.quoted.other.backtick.oef",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.oef",
              "match": "\\\\[`nrt]"
            }
          ]
        }
      ]
    },
    "html": {
      "patterns": [
        {
          "name": "meta.tag.inline.html.oef",
          "match": "</?[A-Za-z][^>]*?>"
        }
      ]
    },
    "braces": {
      "patterns": [
        {
          "name": "punctuation.section.braces.begin.oef",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.oef",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.oef",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.oef",
          "match": "\\]"
        }
      ]
    }
  }
}
