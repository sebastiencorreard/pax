{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OEF",
  "scopeName": "source.oef",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#metaDirectives"
    },
    {
      "include": "#math"
    },
    {
      "include": "#commandsWithArgs"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#html"
    },
    {
      "include": "#braces"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-percent.oef",
          "match": "%%.*$"
        }
      ]
    },
    "metaDirectives": {
      "patterns": [
        {
          "name": "keyword.control.directive.oef",
          "match": "(?m)^\\s*![a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "math": {
      "patterns": [
        {
          "name": "meta.math.inline.oef",
          "begin": "\\\\\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.math.begin.oef"
            }
          },
          "end": "\\\\\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.math.end.oef"
            }
          },
          "patterns": [
            {
              "include": "#variables"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#braces"
            }
          ]
        }
      ]
    },
    "commandsWithArgs": {
      "patterns": [
        {
          "name": "support.function.command.oef",
          "match": "\\\\(?:[A-Za-z][A-Za-z0-9_]*|[0-9]+)(?=\\s*\\{)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.oef",
          "match": "\\\\(?:[A-Za-z][A-Za-z0-9_]*|[0-9]+)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.oef",
          "match": "(?<![A-Za-z0-9_])(?:-?\\d+(?:\\.\\d+)?(?:\\.\\.-?\\d+(?:\\.\\d+)?)?)(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.oef",
          "match": "\\.\\.|>=|<=|!=|==|=|\\+|-|\\*|/|\\^|>|<|\\?|:"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oef",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oef",
              "match": "\\\\[\\\"nrt]"
            }
          ]
        }
      ]
    },
    "html": {
      "patterns": [
        {
          "name": "meta.tag.inline.html.oef",
          "match": "</?[A-Za-z][^>]*?>"
        }
      ]
    },
    "braces": {
      "patterns": [
        {
          "name": "punctuation.section.braces.begin.oef",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.oef",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.oef",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.oef",
          "match": "\\]"
        }
      ]
    }
  }
}
