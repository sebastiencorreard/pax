{
  "name": "pax-oef-syntax",
  "displayName": "PAX OEF Syntax",
  "description": "Syntax highlighting and snippets for WIMS/OEF .oef files",
  "version": "0.1.0",
  "publisher": "pax-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "oef",
    "wims",
    "pax",
    "math",
    "education"
  ],
  "repository": {
    "type": "git",
    "url": "https://example.invalid/pax-oef-syntax"
  },
  "contributes": {
    "languages": [
      {
        "id": "oef",
        "aliases": [
          "OEF",
          "WIMS OEF"
        ],
        "extensions": [
          ".oef"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oef",
        "scopeName": "source.oef",
        "path": "./syntaxes/oef.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "oef",
        "path": "./snippets/oef.json"
      }
    ]
  }
}
