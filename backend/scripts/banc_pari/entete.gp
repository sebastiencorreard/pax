default(output,0);
default(secure,1);
alias(ln,log);
alias(pi,Pi);
alias(euler,Euler);
alias(PI,Pi);
i=I;
e=exp(1);
E=exp(1);
sec(x)=1/cos(x);
csc(x)=1/sin(x);
lg(x)=log(x)/log(10);
log2(x)=log(x)/log(10);
alias(log10,lg);
alias(sgn,sign);
alias(ch,cosh);
alias(sh,sinh);
alias(th,tanh);
alias(arccos,acos);
alias(arcsin,asin);
alias(tg,tan);
alias(arctan,atan);
alias(arctg,atan);
alias(Argch,acosh);
alias(Argsh,asinh);
alias(Argth,atanh);
alias(argch,acosh);
alias(argsh,asinh);
alias(argth,atanh);
alias(cot,cotan);
alias(ctg,cotan);
alias(rint,round);
alias(RANDOM,random);
alias(SOLVE,solve);
alias(parirandom,random);
alias(parisolve,solve);
\p 20
