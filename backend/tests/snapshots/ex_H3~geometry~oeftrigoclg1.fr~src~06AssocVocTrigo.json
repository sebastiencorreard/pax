  "solution_html": "<div class=\"grid-x grid-margin-x\">\t  <div class=\"cell small-12 medium-6 large-6 \">\t   <div class =\"euler_quest_nobg\">\t    <p><span class=\"nowrap\"> CRU </span> est un triangle rectangle en C.</p>\tReconnaître le <strong>cosinus</strong>, le <strong>sinus</strong> et la <strong>tangente</strong> de l'angle \t<span class=\"nowrap\">\\(\\widehat{CRU}\\).</span>\t   </div>\t  </div>\t     <div class=\"cell small-12 medium-5 large-4\">\t    <div class=\"pax-jsxgraph\" id=\"jsxbox\" data-w=\"500\" data-h=\"500\" data-maxw=\"500\" data-jsxgraph=\"jsxsol,250 x 216,var brd = JXG.JSXGraph.initBoard(&#x27;jsxsol&#x27;, {showCopyright : false,axis:false, boundingbox: [-2.7051611,1.5,3.5581676,-3.9161098],grid:false}); A=brd.create(&#x27;point&#x27;,[0,0],{name:&#x27;C&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tB=brd.create(&#x27;point&#x27;,[-1.2051611,-2.4161098],{name:&#x27;R&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tC=brd.create(&#x27;point&#x27;,[2.0581676,-1.0266188],{name:&#x27;U&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tbrd.create(&#x27;angle&#x27;,[B,A,C],{name:&#x27; &#x27;,radius:0.38333333,strokeColor:&#x27;black&#x27;,fillColor:&#x27;red&#x27;,fillOpacity:0.8});\tbrd.create(&#x27;polygon&#x27;,[A,B,C],{strokeColor: &#x27;black&#x27;,fillColor: &#x27;rgb(140,125,114)&#x27;,highlightfillColor:&#x27;rgb(140,125,114)&#x27;});\thypo=brd.create(&#x27;segment&#x27;,[B,C]);\tcat1=brd.create(&#x27;segment&#x27;,[A,B]);\tcat2=brd.create(&#x27;segment&#x27;,[A,C]);\t\tbrd.create(&#x27;angle&#x27;,[C,B,A],{name:&#x27; &#x27;,radius:0.38333333,strokeColor:&#x27;black&#x27;,fillColor:&#x27;rgb(140,125,114)&#x27;,fillOpacity:1});\"></div>\t   </div>\t       </div>\t  \t  <div class=\"euler_rep_good_nobg\" style=\"overfl