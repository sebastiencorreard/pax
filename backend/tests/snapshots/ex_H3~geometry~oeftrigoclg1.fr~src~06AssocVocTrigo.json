;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tB=brd.create(&#x27;point&#x27;,[-1.2051611,-2.4161098],{name:&#x27;R&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tC=brd.create(&#x27;point&#x27;,[2.0581676,-1.0266188],{name:&#x27;U&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(140,125,114)&#x27;,fixed:true,showInfobox:false,label:{fixed: false}});\tbrd.create(&#x27;angle&#x27;,[B,A,C],{name:&#x27; &#x27;,radius:0.38333333,strokeColor:&#x27;black&#x27;,fillColor:&#x27;red&#x27;,fillOpacity:0.8});\tbrd.create(&#x27;polygon&#x27;,[A,B,C],{strokeColor: &#x27;black&#x27;,fillColor: &#x27;rgb(140,125,114)&#x27;,highlightfillColor:&#x27;rgb(140,125,114)&#x27;});\thypo=brd.create(&#x27;segment&#x27;,[B,C]);\tcat1=brd.create(&#x27;segment&#x27;,[A,B]);\tcat2=brd.create(&#x27;segment&#x27;,[A,C]);\t\tbrd.create(&#x27;angle&#x27;,[C,B,A],{name:&#x27; &#x27;,radius:0.38333333,strokeColor:&#x27;black&#x27;,fillColor:&#x27;rgb(140,125,114)&#x27;,fillOpacity:1});\"></div>  </div>\t</div>\t",
