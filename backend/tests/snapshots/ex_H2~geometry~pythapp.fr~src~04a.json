;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(125,114,71)&#x27;,fixed:true,showInfobox:false});\t    C2=brd.create(&#x27;point&#x27;,[-4.8989795,0],{name:&#x27;&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(125,114,71)&#x27;,fixed:true,showInfobox:false});\t    cC=brd.create(&#x27;polygon&#x27;,[A,C,C1,C2],{strokeColor: &#x27;black&#x27;,fillColor: &#x27;rgb(125,114,71)&#x27;,fillOpacity:0.2,highlightfillColor:&#x27;rgb(125,114,71)&#x27;});\t    D1=brd.create(&#x27;point&#x27;,[8.3630811,3.4641016],{name:&#x27;&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(125,114,71)&#x27;,fixed:true,showInfobox:false});\t    D2=brd.create(&#x27;point&#x27;,[4.8989795,8.3630811],{name:&#x27;&#x27;,face:&#x27;x&#x27;,size:3,color:&#x27;rgb(125,114,71)&#x27;,fixed:true,showInfobox:false});\t    cD=brd.create(&#x27;polygon&#x27;,[C,B,D1,D2],{strokeColor: &#x27;black&#x27;,fillColor: &#x27;rgb(125,114,71)&#x27;,fillOpacity:0.5,highlightfillColor:&#x27;rgb(125,114,71)&#x27;});\t    Pt_AireB=brd.create(&#x27;point&#x27;,[1.7320508,-1.7320508],{name:&#x27;12&#x27;,face:&#x27;x&#x27;,size:0,fixed:true,showInfobox:false,color:&#x27;rgb(125,114,71)&#x27;,strokeOpacity:0,label:{position:&#x27;top&#x27;,offset:[-5,0]}});\t      Pt_AireC=brd.create(&#x27;point&#x27;,[-2.4494898,2.4494898],{name:&#x27;24&#x27;,face:&#x27;x&#x27;,size:0,fixed:true,showInfobox:false,color:&#x27;rgb(125,114,71)&#x27;,strokeOpacity:0,label:{position:&#x27;top&#x27;,offset:[-5,0]}});\"></div> <span class=\"euler_credit\">Figure réalisée avec JSXGraph</span> </div> </div> ",
  "hint_html": " <div class=\"indication\">Indication 1 - Théorème de Pythagore</div> <div class=\"spacer\">Dans un triangle rectangle, le carré de la longueur de l'hypoténuse est égal à la somme des carrés des\t longueurs des deux côtés de l'angle droit.\t<br class=\"spacer\">Dit autrement : \"l'aire du carré construit sur l'hypoténuse est égale à la somme des aires des carrés\t construits sur les côtés de l'angle droit.\"</div> <div class=\"spacer indication\"><br class=\"spacer\">Indication 2</div> <div ><br>L'aire d'un carré de côté de longueur \\(\\mathbf{c}\\) est égale au produit <span class=\"nowrap\">\\(\\mathbf{c \\times c}\\).</span>\t<br class=\"spacer\">\tIci, on pourra donc calculer l'aire du carré construit sur l'hypoténuse (indication 1), puis en déduire la longueur de l'hypoténuse (indication 2).</div> "
