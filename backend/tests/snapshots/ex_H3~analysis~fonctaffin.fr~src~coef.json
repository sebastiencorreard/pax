  "solution_html": "<span style=\"text-decoration-line: underline\" class=\"font-weight: bold\">Méthode 1&nbsp;:</span>\t<div class=\"container\">\t  <div class=\"image-wrapper spacer\">\t    <button id=\"startBtn2\" style=\"background-color: #ddd;border: 1px solid #bbb;border-radius: 6px;padding: 8px 14px;font-size: 1rem;cursor: pointer;transition: background 0.2s;margin-bottom: 8px;\">Démarrer l’animation</button>\t    <div class=\"pax-jsxgraph\" id=\"jsxbox2\" data-w=\"350\" data-h=\"350\" data-maxw=\"350\" data-minw=\"250\" data-jsxgraph=\"JXG.Options.label.autoPosition = true;\tJXG.Options.elements.highlight=false;\tvar bb=[-6,6,6,-6];\tvar board2= JXG.JSXGraph.initBoard(&#x27;jsxbox2&#x27;, {boundingbox: bb,showCopyright:false,showNavigation:true,axis:true,keepAspectRatio:true,grid:{gridX:1,gridY:1,drawGrid:true}});\tvar xmin=Math.ceil(bb[0]), xmax=Math.floor(bb[1]);\tvar graph=board2.create(&#x27;functiongraph&#x27;,[function(x){ return -3*x;}, -50, 50],{strokeColor:&#x27;red&#x27;});\tvar attractors=[];\tfor (var i=xmin; i&lt;=xmax;i++) {attractors.push(board2.create(&#x27;point&#x27;,[i,-3*i],{visible:true,face:&#x27;cross&#x27;,name:&#x27;&#x27;,fixed:true,showInfobox:false}));}\tvar A=null;\tfor (var i=0; i&lt;attractors.length; i++){\t    var p=attractors[i];\t    if (p.X()&gt;0 &amp;&amp; Math.abs(p.Y()-Math.round(p.Y()))&lt;0.000001) {\t        A=p;\t        break;\t    }\t}\tA.setAttribute({size:10,color:&#x27;black&#x27;,name:&#x27;A&#x27;,label:{fontSize:16}});\tfunction startAnimation() {\t  blink(A,2000,100);\t  var xA=A.X(),yA=A.Y();\t  var arrowX=board2.create(&#x27;arrow&#x27;,[[0,0],[xA,0]],{color:&#x27;blue&#x27;,dash:2,visible:false});\t  var arrowXDep=board2.create(&#x27;arrow&#x27;,[[0,0],[0,0]],{color:&#x27;blue&#x27;,dash:2,visible:true});\t  var textX=board2.create(&#x27;text&#x27;, [xA/2,0,xA],{visible:false,fontSize: 25,strokeColor: &#x27;blue&#x27;,anchorX: &#x27;middle&#x27;,anchorY: &#x27;bottom&#x27;});\t  var arrowY=board2.create(&#x27;arrow&#x27;,[[xA,0],A],{color: &#x27;green&#x27;, dash: 2,visible:false});\t  var arrowYDep=board2.create(&#x27;arrow&#x27;,[[xA,0],[xA,0]],{color: &#x27;green&#x27;, dash:2,visible:false});\t  var textY=board2.create(&#x27;text&#x27;,[xA+0.1,yA/2,yA],{visible:false,fontSize: 25,strokeColor: &#x27;green&#x27;,anchorX: &#x27;left&#x27;,anchorY:&#x27;middle&#x27;});\t  var minY=Math.min(0,yA),\t      maxY=Math.max(0,yA);\t  var marginX=xA*0.2,\t      marginY=(maxY-minY)*0.2;\t  var targetBbox2=[\t      xA*(-1)*0.2,\t      Math.max(0,yA)+marginY,\t      xA*1.2,\t      Math.min(0,yA)-marginY];\t  setTimeout(function() {\t    animateBoundingBox(board2,targetBbox2, 3000);\t  }, 2000);\t  var step1=0;\t  setTimeout(function() {\t  (function animateSteps(){\t          arrows=[],\t          step=0;\t      function next(){\t          if (step&lt;xA) {\t              var k=step;\t              var P1= board2.create(&#x27;point&#x27;,[k,-3*k], {visible:false});\t              var P2= board2.create(&#x27;point&#x27;,[k+1,-3*k], {visible:false});\t              var hArrow = board2.create(&#x27;arrow&#x27;,[P1,P2], {strokeColor:&#x27;blue&#x27;, dash:2});\t              var hLabel = board2.create(&#x27;text&#x27;,[\t                  function(){ return k + 0.5; },\t                  function(){ return -3*k + 0.1; },\t                  &quot;1&quot;\t              ],{\t                  fontSize:14, strokeColor:&#x27;blue&#x27;,\t                  anchorX:&#x27;middle&#x27;, anchorY:&#x27;bottom&#x27;,offset:[0,10]\t              });\t              arrows.push(P1, P2, hArrow, hLabel);\t              setTimeout(function(){\t                  var Q1 = board2.create(&#x27;point&#x27;,[k+1,-3*k], {visible:false});\t                  var Q2 = board2.create(&#x27;point&#x27;,[k+1,-3*(k+1)],{visible:false});\t                  var vArrow = board2.create(&#x27;arrow&#x27;,[Q1,Q2],{strokeColor:&#x27;green&#x27;, dash:2});\t                  var vLabel = board2.create(&#x27;text&#x27;,[\t                      function(){ return k+1+ 0.1; },\t                      function(){ return -3*k + -3/2; },\t                      &quot;a&quot;\t                  ],{\t                      fontSize:14, strokeColor:&#x27;green&#x27;,\t                      anchorX:&#x27;left&#x27;, anchorY:&#x27;middle&#x27;,offset:[-20,0]\t                  });\t                  arrows.push(Q1, Q2, vArrow, vLabel);\t                  step++;\t                  setTimeout(next, 800);\t              }, 800);\t              } else {\t                  if (step1&lt;1){\t                               var t1=0;\t                               var interval1=setInterval(function(){\t                                arrowXDep.setAttribute({visible:true});\t                                t1+=0.02;\t                                var xEnd=xA*t1;\t                                arrowXDep.point2.moveTo([xEnd,0],0);\t                                if(t1&gt;=1){clearInterval(interval1);\t                                arrowX.setAttribute({visible:true});\t                                textX.setAttribute({visible:true});\t                                var t2=0;\t                                                     var interval2=setInterval(function(){\t                                                       arrowYDep.setAttribute({visible:true});\t                                                       t2+=0.02;\t                                                       var yEnd=yA*t2;\t                                                       arrowYDep.point2.moveTo([xA,yEnd],0);\t                                                       if(t2&gt;=1){clearInterval(interval2);\t                                                                 arrowY.setAttribute({visible:true});\t                                                                 textY.setAttribute({visible:true});\t                                                                 }\t                                                                 },100);\t                                          }\t                                                                   },100);\t                                                         }\t              arrows.forEach(function(obj){\t                  board2.removeObject(obj);\t              });\t              setTimeout(function(){\t                  arrows = [];\t                  step = 0;\t                  next();\t                  step1++;\t              }, 500);\t          }\t      }\t      next();\t      })();\t      }, 2000);\t}\tvar btnExt=document.getElementById(&#x27;startBtn2&#x27;);\tbtnExt.addEventListener(&#x27;click&#x27;, function(){\t            btnExt.disabled = true;\t            startAnimation();\t                                            });\"></div>\t  </div>\t  <div class=\"table-wrapper\">\t    Soit \\(a\\) le coefficient de la fonction linéaire \\(f\\).\t    <p><p>Ainsi, pour tout nombre \\(x\\), on a <span class=\"nowrap\">\\(f(x)=a \\times x\\)</span> où \\(a\\) est également le coefficient directeur (ou <span style=\"color:red\">pente</span>) de la droite représentant la fonction \\(f\\).\t<p>Graphiquement, le coefficient directeur \\(a\\) de la droite signifie qu'à partir de n'importe quel point de la droite, <span style=\"color:red\">en avançant d'une unité en abscisse, l'ordonnée augmente de \\(a\\) unité(s).</span></p></p>\t    <div class =\"accordion\">\t      <div>Cliquer ici pour voir la démonstration</div>\t        <div class=\"box_content\">\t           <div class=\"container\">\t             <div class=\"image-wrapper\"> <img src=\"/api/static/H3/analysis/fonctaffin.fr/images/capture.png\" alt=\"pente\" style=\"width:500px\"><p>Illustration cas a>0 et x>0</p></div>\t             <div class=\"table-wrapper\">\t               <p>Pour tout nombre <span class=\"nowrap\">\\(x\\),</span></p>\t               \\(f(x+1)-f(x)=a \\times (x+1)-a \\times x\\)               <p>\\(f(x+1)-f(x)=a\\times x + a \\times 1 - a \\times x\\)</p>\t               \\(f{\\left(x + 1 \\right)} - f{\\left(x \\right)} = a x + a - a x\\)               <p>\\(f{\\left(x + 1 \\right)} - f{\\left(x \\right)} = a\\)</p>\t             </div>\t          </div>\t        </div>\t      </div>\t      On repère un point sur la droite à coordonnées entières&nbsp;: <span class=\"nowrap\">\\(A(1 \\, ; \\,-3)\\).</span>\t      <p><p>Pour aller de l'origine du repère au point \\(A\\), on se déplace de \\(1\\) unité(s) sur l'axe des abscisses et de \\(-3\\) unité(s) sur l'axe des ordonnées donc \\(1 \\times a = -3\\) soit finalement</p>\t      <span class=\"nowrap\">\\(a=\\frac{-3}{1}=-3\\).</span>\t    </div>\t</div>\t<span style=\"text-decoration-line: underline\" class=\"font-weight: bold\">Méthode 2&nbsp;:</span>\t<p>Une fonction linéaire \\(f\\) de coefficient \\(a\\) est définie pour tout nombre \\(x\\) par <span class=\"nowrap\">\\(f(x)=a \\times x\\).</span>\t<p>Ainsi, pour \\(x\\) non nul, <span class=\"nowrap\">\\(a=\\frac{f(x)}{x}\\).</span>\t<p>On repère ensuite un point sur la droite&nbsp;: \\(A(1 \\, ; \\,-3)\\).</p>\tCela signifie que le nombre \\(1\\) a pour image \\(-3\\) par la fonction <span class=\"nowrap\">\\(f\\).</span>\t<p>Donc <span class=\"nowrap\">\\(a=\\frac{-3}{1}=-3\\).</span>\t",
  "hint_html": "Le coefficient d'une fonction linéaire est également le coefficient directeur (ou pente) de la droite représentant cette fonction linéaire."
}