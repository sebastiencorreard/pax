  "statement_html": "La droite ci-dessous est la représentation graphique d'une fonction linéaire <span class=\"nowrap\">\\(f\\).</span>\t<div class=\"container\">\t  <div class=\"image-wrapper\"><div class=\"pax-jsxgraph\" id=\"jsxbox\" data-w=\"350\" data-h=\"350\" data-maxw=\"350\" data-minw=\"250\" data-jsxgraph=\"JXG.Options.label.autoPosition = true;\tJXG.Options.elements.highlight = false;\tvar bb=[-6,6,6,-6];\tvar xdep=Math.floor(3/-3);\tvar board = JXG.JSXGraph.initBoard(&#x27;jsxbox&#x27;, {boundingbox: bb,showCopyright:false,showNavigation:true,axis:true,keepAspectRatio:true,grid:{gridX:1,gridY:1,drawGrid:true}});\tvar xmin=Math.ceil(bb[0]), xmax=Math.floor(bb[1]);\tvar graph=board.create(&#x27;line&#x27;,[[0,0],[1,-3]],{strokeWidth:2,strokeColor:&#x27;red&#x27;,fixed:true});\tvar attractors=[];\tfor (var i=xmin; i&lt;=xmax;i++) {attractors.push(board.create(&#x27;point&#x27;,[i,-3*i],{visible:true,name:&#x27;&#x27;,size:2,fixed:true,showInfobox:false}));}\tvar pt=board.create(&#x27;glider&#x27;,[-2,-3*(-2),graph],{name:&#x27;A&#x27;,label:{fontSize:20},face:&#x27;cross&#x27;,size:8,color:&#x27;black&#x27;,showInfobox:false,fixed:false,snapToPoints:true,attractors:attractors,attractorDistance:1,attractorUnit:&#x27;user&#x27;});\tvar ptx=board.create(&#x27;point&#x27;,[function() {return pt.X();},0],{face:&#x27;cross&#x27;,size:4,color:&#x27;brown&#x27;,visible:false});\tboard.create(&#x27;segment&#x27;,[pt,ptx],{color:&#x27;blue&#x27;,dash:2});\tboard.create(&#x27;text&#x27;,[function() {return pt.X();},0,function(){var x=Number(JXG.toFixed(pt.X(),1));return x.toLocaleString(&#x27;fr-FR&#x27;);}],{fontSize: 25,strokeColor: &#x27;blue&#x27;,anchorX: &#x27;middle&#x27;,anchorY: function() { return pt.Y()&gt; 0 ? &#x27;top&#x27; : &#x27;bottom&#x27;;},offset: function() {return pt.Y()&gt;0?[0, 10]:[0, -10];}});\tvar pty=board.create(&#x27;point&#x27;,[0,function(){return pt.Y();}],{face:&#x27;cross&#x27;,size: 4,color: &#x27;brown&#x27;,visible: false});\tboard.create(&#x27;segment&#x27;,[pt,pty],{ color: &#x27;green&#x27;, dash: 2 });\tboard.create(&#x27;text&#x27;, [0,function(){return pt.Y();},function(){var y=Number(JXG.toFixed(pt.Y(),2));return y.toLocaleString(&#x27;fr-FR&#x27;);}],{fontSize: 25,strokeColor: &#x27;green&#x27;,anchorY: &#x27;middle&#x27;,anchorX:function(){return pt.X()&gt;0?&#x27;right&#x27;:&#x27;left&#x27;;},offset: function(){return pt.X()&gt;0?[10,0]:[-10, 0];}});\"></div></div>\t  <div class=\"table-wrapper\">\t    <div class=\"euler_quest_nobg spacer\">En déplaçant le point \\(\\mathrm{A}\\) sur les points de la droite d'abscisse entière, déterminer le coefficient de la fonction linéaire.</div>\t    <div class=\"euler_answer_nobg\"><label for=\"reply1\">Par lecture graphique, le coefficient de la fonction linéaire est égal à</label> <span class=\"nowrap\"> <span class=\"oef-input\" name=\"reply1\" data-size=\"4\"></span>.</span></div>\t    <div class=\"wims_instruction spacer\">Vous donnerez la réponse sous la forme d'un nombre entier si possible ou d'une fraction irréductible de dénominateur positif.</div>\t  </div>\t</div>",
