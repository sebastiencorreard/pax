  "solution_html": "<div class=\"container\">\t   <div class=\"image-block\">\t     <button id=\"startBtn2\" style=\"background-color: #ddd;border: 1px solid #bbb;border-radius: 6px;padding: 8px 14px;font-size: 1rem;cursor: pointer;transition: background 0.2s;margin-bottom: 8px;\">Démarrer l’animation</button>\t     <div class=\"image-wrapper\"><div class=\"pax-jsxgraph\" id=\"jsxbox2\" data-w=\"350\" data-h=\"350\" data-maxw=\"350\" data-minw=\"250\" data-jsxgraph=\"JXG.Options.label.autoPosition = true;\tvar board2 = JXG.JSXGraph.initBoard(&#x27;jsxbox2&#x27;, {\t  boundingbox: [-6,6,6,-6],axis:true,\t  showCopyright: false,\t  showNavigation: true,\t  axis: true,\t  keepAspectRatio: false,\tdefaultAxes: {\t    x: {ticks:{insertTicks:false,ticksDistance:2,drawLabels:true,minorTicks:0}},\t    y:{ticks:{insertTicks:false,ticksDistance: 2,drawLabels:true,minorTicks:0}}\t    },\t    grid:{drawGrid:true,gridX:1,gridY:1,}});\tvar graph = board2.create(&#x27;line&#x27;,[[0,-2],[1,0.5]],{strokeWidth:2,strokeColor:&#x27;red&#x27;});\tvar pMid = board2.create(&#x27;point&#x27;, [2.5, 4.25], {\t  name: &#x27;&#x27;,\t  fixed: true,\t  face: &#x27;cross&#x27;,\t  size: 8,\t  color: &#x27;black&#x27;,\t  showInfobox: false,\t  visible: false,\t});\tvar pant = board2.create(&#x27;point&#x27;, [2.5,0], {\t  name: &#x27;&#x27;,\t  fixed: true,\t  face: &#x27;&#x27;,\t  size: 4,\t  color: &#x27;brown&#x27;,\t  showInfobox: false,\t  visible: false,\t});\tvar pimg = board2.create(&#x27;point&#x27;, [0,4.25], {\t  name: &#x27;&#x27;,\t  fixed: true,\t  face: &#x27;&#x27;,\t  size: 4,\t  color: &#x27;brown&#x27;,\t  showInfobox: false,\t  visible: false,\t});\tvar ant=Number(2.5);\tvar antv=ant.toLocaleString(&#x27;fr-FR&#x27;);\tvar deuxlignes=antv;\tvar tant = board2.create(&#x27;text&#x27;, [2.5,function() { return 4.25 &gt; 0 ?-0.3:0.2;},deuxlignes], {\t  fontSize: 14,\t  strokeColor:&#x27;blue&#x27;,\t  visible: false,\t  anchorX: &#x27;middle&#x27;,\t  anchorY: function() { return 4.25 &gt; 0 ? &#x27;top&#x27; : &#x27;bottom&#x27;; },\t});\tvar img=Number(4.25);\tvar imgv=img.toLocaleString(&#x27;fr-FR&#x27;);\tvar uneligne=imgv +&#x27; image&#x27;;\tvar timg = board2.create(&#x27;text&#x27;, [function() { return 2.5 &gt; 0 ? -0.2:0.2;}, 4.25,uneligne], {\t  fontSize: 14,\t  strokeColor:&#x27;green&#x27;,\t  visible: false,\t  anchorY: &#x27;middle&#x27;,\t  anchorX: function() { return 2.5 &gt; 0 ? &#x27;right&#x27; : &#x27;left&#x27;; }});\tvar xA = pMid.X(), yA = pMid.Y();\tvar xA = pMid.X(), yA = pMid.Y();\tvar targetBbox2;\tif (yA &gt; 0 &amp;&amp; xA &gt; 0) {targetBbox2=[-1.5,yA*1.3,xA*1.3,-1.5];}\telse if (yA &gt; 0 &amp;&amp; xA &lt; 0) {targetBbox2 = [xA*1.3,yA*1.3,1.5,-1.5];}\telse if (yA &lt; 0 &amp;&amp; xA &gt; 0) {targetBbox2 = [-1.5,1.5,xA*1.3,yA*1.3];}\telse if (yA &lt; 0 &amp;&amp; xA &lt; 0) {targetBbox2 = [xA*1.3,1.5,1.5,yA*1.3];}\telse targetBbox2 = board2.getBoundingBox();\tfunction startAnimation(){\ttant.setAttribute({size:10,color:&#x27;blue&#x27;,visible:false});\tblink(tant,3000,100);\tpMid.setAttribute({visible:false});\ttant.setAttribute({visible:true});\ttimg.setAttribute({visible:false});\tvar arrow1 = board2.create(&#x27;arrow&#x27;,[[2.5,0],[2.5,0]],{strokeColor:&#x27;blue&#x27;,lastArrow:1,dash:2});\tvar t1 = 0;\tvar interval1 = setInterval(function(){\t    t1+= 0.02;\t    arrow1.point2.moveTo([2.5, t1*4.25],0);\t    if(t1&gt;=1){\t      clearInterval(interval1);\t      arrow1.setAttribute({visible:true});\t      pMid.setAttribute({visible:true});\t      arrow1.setAttribute({lastArrow:0});\t      setTimeout(startArrow2,500);\t      }\t     },30);\t  function startArrow2(){\t    var arrow2=board2.create(&#x27;arrow&#x27;,[[2.5,4.25],[2.5,4.25]],{strokeColor:&#x27;green&#x27;,lastArrow:1,dash:2});\t    var t2=0;\t    var interval2=setInterval(function(){\t    t2+=0.02;\t    var xEnd=2.5*(1-t2);\t    arrow2.point2.moveTo([xEnd,4.25], 0);\t      if(t2&gt;=1){\t        clearInterval(interval2);\t        timg.setAttribute({visible:true});\t        arrow2.setAttribute({lastArrow:0});\t        blink(timg,3000,100);\t   setTimeout(function(){\t          board2.removeObject(arrow1);\t          board2.removeObject(arrow2);\t          timg.setAttribute({visible:false});\t          pMid.setAttribute({visible:false});\t          startAnimation();\t          },3000);\t        }\t    },30);\t  }\t  }\tvar btnExt = document.getElementById(&#x27;startBtn2&#x27;);\t  btnExt.addEventListener(&#x27;click&#x27;, function() {\t    btnExt.disabled = true;\t    blink(tant,3000,100);\t    setTimeout(animateBoundingBox(board2, targetBbox2, 2400),3000);\t    setTimeout(startAnimation, 1250);\t  });\"></div></div>\t   </div>\t   <div class=\"table-wrapper\"><b><span style=\"color: red;\">L'image</span></b> du nombre \\(2,5\\) par la fonction \\(h\\) est, par définition,\t<b><span style=\"color: red;\">l'ordonnée</span></b> du point de la droite dont l'abscisse est <span class=\"nowrap\">\\(2,5\\).</span><p>\tOn se place sur le point de la droite dont l'abscisse est \\(2,5\\) puis, on lit son ordonnée.\t    <p>Par lecture graphique, \\(2,5\\) a pour image \\(4,25\\) par la fonction <span class=\"nowrap\">\\(h\\).</span></p>\t   </div>\t</div>\t",
