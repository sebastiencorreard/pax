ine x1=\"195.15\" y1=\"600.00\" x2=\"195.15\" y2=\"0.00\" stroke=\"#008000\" stroke-width=\"2.0\" stroke-dasharray=\"4,3\" /><text x=\"182.91\" y=\"564.71\" fill=\"#008000\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">Q1=11</text><text x=\"0.00\" y=\"419.12\" fill=\"#008000\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">14.5</text><line x1=\"0.00\" y1=\"300.00\" x2=\"600.00\" y2=\"300.00\" stroke=\"#800080\" stroke-width=\"2.0\" stroke-dasharray=\"4,3\" /><line x1=\"306.12\" y1=\"600.00\" x2=\"306.12\" y2=\"0.00\" stroke=\"#800080\" stroke-width=\"2.0\" stroke-dasharray=\"4,3\" /><text x=\"293.88\" y=\"564.71\" fill=\"#800080\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">Mediane=20</text><text x=\"0.00\" y=\"291.18\" fill=\"#800080\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">29</text><line x1=\"0.00\" y1=\"172.06\" x2=\"600.00\" y2=\"172.06\" stroke=\"#a52a2a\" stroke-width=\"2.0\" stroke-dasharray=\"4,3\" /><line x1=\"498.80\" y1=\"600.00\" x2=\"498.80\" y2=\"0.00\" stroke=\"#a52a2a\" stroke-width=\"2.0\" stroke-dasharray=\"4,3\" /><text x=\"486.55\" y=\"564.71\" fill=\"#a52a2a\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">Q3=36</text><text x=\"0.00\" y=\"163.24\" fill=\"#a52a2a\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">43.5</text><text x=\"24.49\" y=\"44.12\" fill=\"#0000ff\" font-size=\"12\" font-family=\"sans-serif\" font-weight=\"bold\" text-anchor=\"start\" dominant-baseline=\"hanging\">58</text></svg></div>\t"
