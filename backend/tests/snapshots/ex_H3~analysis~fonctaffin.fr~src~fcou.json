  "statement_html": "<div class=\"euler_quest_nobg spacer\">Parmi les courbes ci-dessous, quelle est celle qui représente la fonction affine \\(f\\) définie pour tout nombre \\(x\\) par <span class=\"nowrap\">\\(f x = - 3 x - 2\\)&nbsp;&#63;</span></div>\t<div class=\"euler_answer_nobg\">\t  <ul class=\"inline\">\t    <li> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"1\" data-content=\"Courbe A\"></span><div class=\"pax-jsxgraph\" id=\"jsxbox3\" data-w=\"400\" data-h=\"400\" data-maxw=\"400\" data-minw=\"200\" data-jsxgraph=\"JXG.Options.elements.highlight = false;\tvar board3 = JXG.JSXGraph.initBoard(&#x27;jsxbox3&#x27;, {\t    boundingbox:[-10,10,10,-10],\t    showCopyright:false,\t    keepAspectRatio:true,\t    pan:{enabled:false},\t    axis:true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1,\t  }\t    });\tvar graph = board3.create(&#x27;functiongraph&#x27;,[function(x){ return (3)*x+(-2);},-50,50]);\"></div></li>\t    <li> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"2\" data-content=\"Courbe B\"></span><div class=\"pax-jsxgraph\" id=\"jsxbox2\" data-w=\"400\" data-h=\"400\" data-maxw=\"400\" data-minw=\"200\" data-jsxgraph=\"JXG.Options.elements.highlight = false;\tvar board2 = JXG.JSXGraph.initBoard(&#x27;jsxbox2&#x27;, {\t    boundingbox:[-10,10,10,-10],\t    showCopyright:false,\t    keepAspectRatio:true,\t    pan:{enabled:false},\t    axis:true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1,\t  }\t    });\tvar graph = board2.create(&#x27;functiongraph&#x27;,[function(x){ return (4)*x+(1);},-50,50]);\"></div></li>\t    <li> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"3\" data-content=\"Courbe C\"></span><div class=\"pax-jsxgraph\" id=\"jsxbox4\" data-w=\"400\" data-h=\"400\" data-maxw=\"400\" data-minw=\"200\" data-jsxgraph=\"JXG.Options.elements.highlight = false;\tvar board4 = JXG.JSXGraph.initBoard(&#x27;jsxbox4&#x27;, {\t    boundingbox:[-10,10,10,-10],\t    showCopyright:false,\t    keepAspectRatio:true,\t    pan:{enabled:false},\t    axis:true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1,\t  }\t    });\tvar graph = board4.create(&#x27;functiongraph&#x27;,[function(x){ return (-4)*x+(1);},-50,50]);\"></div></li>\t    <li> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"4\" data-content=\"Courbe D\"></span><div class=\"pax-jsxgraph\" id=\"jsxbox1\" data-w=\"400\" data-h=\"400\" data-maxw=\"400\" data-minw=\"200\" data-jsxgraph=\"JXG.Options.elements.highlight = false;\tvar board1 = JXG.JSXGraph.initBoard(&#x27;jsxbox1&#x27;, {\t    boundingbox:[-10,10,10,-10],\t    showCopyright:false,\t    keepAspectRatio:true,\t    pan:{enabled:false},\t    axis:true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1,\t  }\t    });\tvar graph = board1.create(&#x27;functiongraph&#x27;,[function(x){ return (-3)*x+(-2);},-50,50]);\"></div></li>\t  </ul>\t</div>\t",
