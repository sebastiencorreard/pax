 true, pinchVertical: true,pinchSensitivity: 7}});\tbrd.suspendUpdate();\tfor(var jj = 0; jj < xlen; jj=jj+1) {\tbrd.create('point', [x_liste[jj],y_liste[jj]],{color:'black'});\t}\tbrd.unsuspendUpdate();}\texecidtest2.addEventListener('click',graph);\t</script>\t",
