  "solution_html": " <div class=\"container\"> <div class=\"image-block\"> <button id=\"startBtn2\" style=\"background-color: #ddd;border: 1px solid #bbb;border-radius: 6px;padding: 8px 14px;font-size: 1rem;cursor: pointer;transition: background 0.2s;margin-bottom: 8px;\">Démarrer l’animation</button> <div class=\"image_wrapper\"><div class=\"pax-jsxgraph\" id=\"jsxbox2\" data-w=\"350\" data-h=\"350\" data-maxw=\"350\" data-minw=\"250\" data-jsxgraph=\"var board2 = JXG.JSXGraph.initBoard(&#x27;jsxbox2&#x27;, {\t    boundingbox: [-7, 7, 7, -7],\t    showCopyright: false,\t    keepAspectRatio: false,\t    axis: true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1\t  }\t});\tvar ptA = board2.create(&#x27;point&#x27;, [-4, 5], { name: &#x27;A&#x27;, size: 6, color: &#x27;black&#x27;, face: &#x27;plus&#x27;, showInfobox: false, fixed: true,label:{fontSize:25} });\tvar ptB = board2.create(&#x27;point&#x27;, [-1, 2], { name: &#x27;B&#x27;, size: 6, color: &#x27;black&#x27;, face: &#x27;plus&#x27;, showInfobox: false, fixed: true,label:{fontSize:25} });\tvar ptC = board2.create(&#x27;point&#x27;, [3, -2], { name: &#x27;C&#x27;, size: 6, color: &#x27;black&#x27;, face: &#x27;plus&#x27;, showInfobox: false, fixed: true,label:{fontSize:25} });\tvar ptD = board2.create(&#x27;point&#x27;, [4, -3], { name: &#x27;D&#x27;, size: 6, color: &#x27;black&#x27;, face: &#x27;plus&#x27;, showInfobox: false, fixed: true,label:{fontSize:25} });\tvar graph = board2.create(&#x27;line&#x27;, [ptA,ptB],{strokeWidth:2,strokeColor:&#x27;blue&#x27;});\tvar Ax = board2.create(&#x27;point&#x27;, [-4, 0], { name: &#x27;-4&#x27;, visible: false, color: &#x27;blue&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25,autoPosition: false,anchorX:&#x27;middle&#x27;,anchorY:&#x27;top&#x27;, offset: [-8, -10], color: &#x27;blue&#x27;} });\tvar Ay = board2.create(&#x27;point&#x27;, [0, 5], { name: &#x27;5&#x27;, visible: false, color: &#x27;green&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;left&#x27;,anchorY:&#x27;middle&#x27;, offset: [10, 3], color: &#x27;green&#x27; } });\tvar dxA = board2.create(&#x27;segment&#x27;, [[-4, 5], [0, 5]], { size: 2, color: &#x27;green&#x27;, dash: 1, fixed: true });\tvar dyA = board2.create(&#x27;segment&#x27;, [[-4, 5], [-4, 0]], { size: 2, color: &#x27;blue&#x27;, dash: 1, fixed: true });\tvar Bx = board2.create(&#x27;point&#x27;, [-1, 0], { name: &#x27;-1&#x27;, visible: false, color: &#x27;blue&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;middle&#x27;,anchorY:&#x27;top&#x27;, offset: [-8, -10], color: &#x27;blue&#x27; } });\tvar By = board2.create(&#x27;point&#x27;, [0, 2], { name: &#x27;2&#x27;, visible: false, color: &#x27;green&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;left&#x27;,anchorY:&#x27;middle&#x27;, offset: [10, 15], color: &#x27;green&#x27; } });\tvar dxB = board2.create(&#x27;segment&#x27;, [[-1, 2], [0, 2]], { size: 2, color: &#x27;green&#x27;, dash: 1, fixed: true });\tvar dyB = board2.create(&#x27;segment&#x27;, [[-1, 2], [-1, 0]], { size: 2, color: &#x27;blue&#x27;, dash: 1, fixed: true });\tvar Cx = board2.create(&#x27;point&#x27;, [3, 0], { name: &#x27;3&#x27;, visible: false, color: &#x27;blue&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;middle&#x27;,anchorY:&#x27;top&#x27;, offset: [-8, 30], color: &#x27;blue&#x27; } });\tvar Cy = board2.create(&#x27;point&#x27;, [0, -2], { name: &#x27;-2&#x27;, visible: false, color: &#x27;green&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;left&#x27;,anchorY:&#x27;middle&#x27;, offset: [-40, 15], color: &#x27;green&#x27; } });\tvar dxC = board2.create(&#x27;segment&#x27;, [[3, -2], [0, -2]], { size: 2, color: &#x27;green&#x27;, dash: 1, fixed: true });\tvar dyC = board2.create(&#x27;segment&#x27;, [[3, -2], [3, 0]], { size: 2, color: &#x27;blue&#x27;, dash: 1, fixed: true });\tvar Dx = board2.create(&#x27;point&#x27;, [4, 0], { name: &#x27;4&#x27;,visible: false, color: &#x27;blue&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;middle&#x27;,anchorY:&#x27;top&#x27;, offset: [-8, 30], color: &#x27;blue&#x27; } });\tvar Dy = board2.create(&#x27;point&#x27;, [0, -3], { name: &#x27;-3&#x27;, visible: false, color: &#x27;green&#x27;, strokeColor: &#x27;red&#x27;, face: &#x27;cross&#x27;, showInfobox: false, fixed: true, label: {fontSize:25, autoPosition: false,anchorX:&#x27;left&#x27;,anchorY:&#x27;middle&#x27;, offset: [-30, 15], color: &#x27;green&#x27; } });\tvar dxD = board2.create(&#x27;segment&#x27;, [[4, -3], [0, -3]], { size: 2, color: &#x27;green&#x27;, dash: 1, fixed: true });\tvar dyD = board2.create(&#x27;segment&#x27;, [[4, -3], [4, 0]], { size: 2, color: &#x27;blue&#x27;, dash: 1, fixed: true });\tvar groups = {\t    A: { main: ptA, auxPoints: [Ax, Ay], segments: [dxA, dyA] },\t    B: { main: ptB, auxPoints: [Bx, By], segments: [dxB, dyB] },\t    C: { main: ptC, auxPoints: [Cx, Cy], segments: [dxC, dyC] },\t    D: { main: ptD, auxPoints: [Dx, Dy], segments: [dxD, dyD] },\t};\tvar letters = [&quot;A&quot;, &quot;B&quot;, &quot;C&quot;, &quot;D&quot;];\tvar currentIndex = 0;\tvar btnExt = document.getElementById(&#x27;startBtn2&#x27;);\t  btnExt.addEventListener(&#x27;click&#x27;, function() {\t    btnExt.disabled = true;\t    setTimeout(animateBoundingBox(board2, targetBbox2, 1200),1000);\t    setTimeout(startAnimation, 600);\t  });\"></div></div> </div> <div class=\"table-wrapper spacer\">Dans un repère, la représentation graphique d'une fonction \\(f\\) est l'ensemble des points de coordonnées <span class=\"nowrap\">\\((x \\, ; \\, y)\\) avec \\(y = f{\\left(x \\right)}\\).</span><p>On regarde les coordonnées de chaque point pour complèter le tableau de valeurs.</p> <table id=\"mytab2\" class=\"wimsborder mytab2\" style=\"font-size: 16px; width: 100%; border-collapse: collapse;\">\t    <tr>\t        <td></td>\t        <td>\\(A\\)</td>\t        <td>\\(B\\)</td>\t        <td>\\(C\\)</td>\t        <td>\\(D\\)</td>\t    </tr>\t    <tr>\t        <td>\\(x\\)</td>\t        <td>\\(-4\\)</td>\t        <td>\\(-1\\)</td>\t        <td>\\(3\\)</td>\t        <td>\\(4\\)</td>\t    </tr>\t    <tr>\t        <td>\\(f{\\left(x \\right)}\\)</td>\t        <td>\\(5\\)</td>\t        <td>\\(2\\)</td>\t        <td>\\(-2\\)</td>\t        <td>\\(-3\\)</td>\t    </tr>\t</table> </div> </div> <script type=\"text/javascript\"> function resetGraph() { for (var letter in groups) { groups[letter].main.setAttribute({ color: 'black', size: 6, face: 'cross', visible: true, label:{color:'black'}}); groups[letter].auxPoints.forEach(function(pt) { pt.setAttribute({ visible: false,visible: false }); }); groups[letter].segments.forEach(function(seg) { seg.setAttribute({ visible: false }); }); } } function highlightGroup(letter) { resetGraph(); groups[letter].main.setAttribute({ color: 'blue', size: 6, face: 'cross',withLabel:true,label:{color:'red',fontSize:25}}); groups[letter].auxPoints.forEach(function(pt) { pt.setAttribute({ visible: true}); }); groups[letter].segments.forEach(function(seg) { seg.setAttribute({ visible: true }); }); updateTableHighlight(letter); } function updateTableHighlight(letter) { var table = document.getElementById(\"mytab2\"); var colMap = { A: 1, B: 2, C: 3, D: 4 }; var colIndex = colMap[letter]; var defaultRowColors = ['white', 'lightblue', 'lightgreen']; var rows = table.getElementsByTagName(\"tr\"); for (var i = 0; i < rows.length; i++) { var cells = rows[i].getElementsByTagName(\"td\"); for (var j = 0; j < cells.length; j++) { if (j === colIndex) { cells[j].style.backgroundColor = \"red\"; } else { cells[j].style.backgroundColor = defaultRowColors[i] || 'white'; } } } } function animateGroups() { var letter = letters[currentIndex]; highlightGroup(letter); currentIndex = (currentIndex + 1) % letters.length; } document.getElementById('startBtn2').addEventListener('click', function() { this.disabled = true; highlightGroup(letters[currentIndex]); setInterval(animateGroups, 2500); }); </script> ",
