r.length; i < len; i++){\t    let v = arr[i];\t    let vv = ar[i];\t    xmin = (v < xmin && Math.abs(v)>0.0001) ? v : xmin;\t    xmax = (v > xmax && Math.abs(v)>0.0001) ? v : xmax;\t    ymin = (vv < ymin && Math.abs(v)>0.0001) ? vv : ymin;\t    ymax = (vv > ymax && Math.abs(v)>0.0001) ? vv : ymax;}\t  return [Math.round(xmin)-1,Math.round(xmax)+1,Math.round(ymin)-1,Math.round(ymax)+1];}\tlet xyminmax=findMinMax(x_liste,y_liste);\tJXG.Options.point.size =60/81;\tvar brd = JXG.JSXGraph.initBoard('jsxbox', {axis:true, boundingbox: [xyminmax[0],xyminmax[3],xyminmax[1],xyminmax[2]],\tshownavigation:false,showCopyright : false,\tshowZoom : true,keepaspectratio : false,\t  zoom: {factorX: 1.25,factorY: 1.25,wheel: true,needShift: false,eps: 0.001},\t  pan: {needShift: false,enabled: true,needTwoFingers: true,pinchHorizontal: true, pinchVertical: true,pinchSensitivity: 7}});\tbrd.suspendUpdate();\tfor(var jj = 0; jj < xlen; jj=jj+1) {\tbrd.create('point', [x_liste[jj],y_liste[jj]],{color:color_liste[jj]});\t}\tbrd.unsuspendUpdate();}\texecidtest2.addEventListener('click',graph);\t</script>\t",
