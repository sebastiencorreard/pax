;\t        ele.style.backgroundColor='white';\t        ele.style.padding='0 0.2em 0 0.2em';\t        document.querySelector('#td2'+i_modepasapas+' input').focus();\t        i_modepasapas=i_modepasapas+1;\t        if(i_modepasapas==3+1){mode_pasapas.style.visibility='hidden';};\t    }\t    mode_pasapas.addEventListener('click',test);\t  </script>",
