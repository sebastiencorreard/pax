{
  "statement_html": "<div class=\"euler_quest_nobg\">On considère la représentation graphique d'une fonction affine.\t  <p>Parmi les fonctions proposées, laquelle correspond à la représentation graphique donnée&nbsp;&#63;</p>\t</div>\t<div class=\"container\">\t  <div><div class=\"pax-jsxgraph\" id=\"jsxbox1\" data-w=\"400\" data-h=\"400\" data-maxw=\"400\" data-minw=\"200\" data-jsxgraph=\"JXG.Options.elements.highlight = false;\tvar board1 = JXG.JSXGraph.initBoard(&#x27;jsxbox1&#x27;, {\t    boundingbox:[-10,10,10,-10],\t    showCopyright:false,\t    keepAspectRatio:true,\t    pan:{enabled:false},\t    axis:true,\t    grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1,\t  }\t    });\tvar graph = board1.create(&#x27;functiongraph&#x27;,[function(x){ return (-3)*x+(-2);},-50,50]);\"></div></div>\t  <div class=\"euler_answer_nobg\">\t      <ul class=\"wims_nopuce\">\t        <li class=\"spacer\"> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"1\" data-content=\"\\(i : x \\mapsto 3 x - 2\\)\"></span></li>\t        <li class=\"spacer\"> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"2\" data-content=\"\\(h : x \\mapsto 4 x + 1\\)\"></span></li>\t        <li class=\"spacer\"> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"3\" data-content=\"\\(g : x \\mapsto 1 - 4 x\\)\"></span></li>\t        <li class=\"spacer\"> <span class=\"oef-radio-inline\" name=\"reply1\" data-value=\"4\" data-content=\"\\(f : x \\mapsto - 3 x - 2\\)\"></span></li>\t      </ul>\t  </div>\t</div>",
  "answers": [
