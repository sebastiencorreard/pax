  "statement_html": "<div class=\"pax-jsxgraph\" id=\"jsxbox\" data-w=\"250\" data-h=\"250\" data-maxw=\"350\" data-minw=\"250\" data-jsxgraph=\"JXG.Options.elements.highlight=false;\tJXG.Options.elements.tabindex=-1;\tvar board = JXG.JSXGraph.initBoard(&#x27;jsxbox&#x27;, {\t    boundingbox: [-78,78,78,-78],\t    showCopyright:false,\t    keepAspectRatio:true,\t    axis: false});\tvar z1 = 32;\tvar z2 = 6;\tvar r1 = z1;\tvar r2 = z2;\tvar xc1 = -r2-10;\tvar xc2 = r1;\tvar wheel1 = board.create(&#x27;circle&#x27;, [[xc1,0],r1], {fillColor:&#x27;Lightblue&#x27;,strokeColor: &#x27;blue&#x27;, strokeWidth: 2,fixed: true});\tvar wheel2 = board.create(&#x27;circle&#x27;, [[xc2,0],r2], {fillColor:&#x27;#C4A484&#x27;,strokeColor: &#x27;brown&#x27;, strokeWidth: 2,fixed: true});\tvar pA = board.create(&#x27;point&#x27;, [xc1+r1, 0], {name: &#x27;&#x27;, size: 2, color: &#x27;blue&#x27;,labelColor:&#x27;blue&#x27;,fixed:true});\tvar pB = board.create(&#x27;point&#x27;, [xc2+r2, 0], {name: &#x27;&#x27;, size: 2, color: &#x27;brown&#x27;,labelColor:&#x27;brown&#x27;,fixed:true});\tvar slider = board.create(&#x27;slider&#x27;, [[-78+1,55], [78-1,55], [0, 0, 50000]],{snapWidth:32,tabindex:10,withLabel: false});\tvar seg1 = board.create(&#x27;segment&#x27;, [[xc1,0],pA],{visible: true, label: false, fixed: true,color: &#x27;blue&#x27;,strokeWidth:6,showInfobox: false});\tvar seg2 = board.create(&#x27;segment&#x27;, [[xc2,0],pB],{visible: true, label: false, fixed: true,color: &#x27;brown&#x27;,strokeWidth:6,showInfobox: false});\tvar t1=board.create(&#x27;text&#x27;, [-78+20,55+10,&quot;Déplacer le curseur pour faire tourner les  segments&quot;],{fixed: true});\tvar t2 = board.create(&#x27;text&#x27;,[xc2+r2+2.5,0,&quot;Départ&quot;],{fixed: true});\tvar teeth1 = [], teeth2 = [];\tfor (var i=0;i&lt;z1;i++) {\t    var angle=i*2*Math.PI/z1;\t    teeth1.push(board.create(&#x27;point&#x27;, [xc1+r1* Math.cos(angle),r1*(Math.sin(angle))],{fixed:true,name:&#x27;&#x27;,size:1,color:&#x27;black&#x27;,visible:false}));\t    var seg = board.create(&#x27;segment&#x27;, [[xc1,0],[xc1+r1*Math.cos(angle),r1*(Math.sin(angle))]],{visible:true,label:false,fixed:true,color:&#x27;black&#x27;,size:1,showInfobox:false});\t}\tfor (var i=0;i&lt;z2;i++) {\t    var angle=i*2*Math.PI/z2;\t    teeth2.push(board.create(&#x27;point&#x27;,[xc2+r2*Math.cos(angle), r2*(Math.sin(angle))],{size:1,color:&#x27;black&#x27;,fixed: true,name:&#x27;&#x27;,visible:false}));\t    var seg=board.create(&#x27;segment&#x27;,[[xc2,0],[xc2+r2*Math.cos(angle),r2*(Math.sin(angle))]],{visible:true,label:false,fixed:true,color:&#x27;black&#x27;,size:1,showInfobox:false});\t}\tboard.on(&#x27;update&#x27;, function() {\t    var angle1=-slider.Value()*Math.PI/180/z1 ;\t    var angle2=angle1*z1/z2;\t    pA.moveTo([xc1+r1* Math.cos(angle1),r1* Math.sin(angle1)]);\t    pB.moveTo([xc2+r2*Math.cos(angle2), r2*Math.sin(angle2)]);\t});\tboard.update();\"></div>\t<span style=\"color:blue\">Le disque bleu est partagé en <b>\\(32\\)</b> secteurs égaux</span> et <span style=\"color:brown\">le disque marron est partagé en <b>\\(6\\)</b> secteurs égaux.</span>.\t<p>Les segments avancent à la même vitesse.</p>\tCombien de tours complets doit effectuer chacun des segments pour qu'ils se retrouvent en même temps, de nouveau, et pour la première fois, dans la position de départ&nbsp;?\t<p>Les deux segments seront, <b>pour la première fois</b>, ensemble à nouveau dans la position de départ lorsque&nbsp;:</p>\t<ul><li><label for=\"reply1\"><span style=\"color:blue\">le segment bleu</span> aura fait</label> <span class=\"oef-input\" name=\"reply1\" data-size=\"5\"></span> tour(s),</li>\t<li><label for=\"reply2\"><span style=\"color:brown\">le segment marron</span> aura fait</label> <span class=\"oef-input\" name=\"reply2\" data-size=\"5\"></span> tour(s).</li></ul>\t",
