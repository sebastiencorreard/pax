  "statement_html": "<div class=\"euler_quest_nobg spacer\">Déplacer les points A et B de manière à ce que la droite obtenue soit la représentation graphique de la fonction affine \\(i\\) définie pour tout nombre \\(x\\) par <span class=\"nowrap\">\\(i{\\left(x \\right)} = 5 - 3 x\\).</span></div>\t<div class=\"spacer\">\t<div class=\"euler_answer_nobg\"> <div class=\"pax-jsxgraph\" data-reply=\"reply1\" id=\"jsxbox\" data-w=\"400\" data-h=\"400\" data-maxw=\"500\" data-minw=\"250\" data-jsxgraph=\"JXG.Options.line.highlight = false;\tJXG.Options.label.autoPosition = true;\tvar board=JXG.JSXGraph.initBoard(&#x27;jsxbox&#x27;,{boundingbox: [-10,10,10,-10], showCopyright:false, showNavigation:true,keepAspectRatio:true, axis:true,\t grid: {\t    drawGrid: true,\t    gridX: 1,\t    gridY: 1\t  }\t});\tvar jsxbox_rep1 = board.create(&#x27;point&#x27;,[-3,2],{face:&#x27;plus&#x27;,name:&#x27;A&#x27;,size:8,color:&#x27;black&#x27;,showInfobox:false,snapToGrid:true,label:{fontSize:15}});\tvar jsxbox_rep2 = board.create(&#x27;point&#x27;,[3,2], {face:&#x27;plus&#x27;,name:&#x27;B&#x27;,size:8,color:&#x27;black&#x27;,showInfobox:false,snapToGrid:true,label:{fontSize:15}});\tvar d = board.create(&#x27;line&#x27;,[jsxbox_rep1,jsxbox_rep2]);\t;try{var __paxC=function(){return [(jsxbox_rep1.X()+&#x27;,&#x27;+jsxbox_rep1.Y()),(jsxbox_rep2.X()+&#x27;,&#x27;+jsxbox_rep2.Y())].join(&#x27;;&#x27;)+&#x27;;&#x27;;};if(typeof __paxReport===&#x27;function&#x27;){board.on(&#x27;update&#x27;,function(){__paxReport(__paxC());});__paxReport(__paxC());}}catch(e){if(typeof console!==&#x27;undefined&#x27;)console.error(&#x27;pax jsx capture&#x27;,e);}\"></div>  </div>\t</div>\t",
