  "statement_html": "<div class=\"encadre\">\t<p class=\"problematique\">Pixel Art et Python</p>\t<div id=\"boited\">\t<img src=\"/api/static/H4/programming/pixelart.fr/images/Tennis_for_Two_Machine_at_CAX_2010.jpg\" alt=\"Jeux de Tennis\" />\t</div>\t<div class=\"enonce\">\tTennis for Two est un jeu vidéo de tennis conçu en 1958 par William Higinbotham\t et développé par Robert Dvorak, souvent considéré comme le premier jeu vidéo de l'histoire.\t <a href=\"https://fr.wikipedia.org/wiki/Tennis_for_Two\" target=\"_blank\">Source Wikipedia</a>\t</div>\tLes premières consoles de jeux ne disposent pas de beaucoup de mémoire donc les programmeurs\t sont obligés de coder les images en binaire, c'est-à-dire par une suite de 0 et de 1.\t Le zéro correspond à la couleur noire.\t\t<div>\t <div class=\"pax-codeeditor\" data-codeeditor=\"{&quot;id&quot;: &quot;idtest2&quot;, &quot;themes&quot;: [&quot;ambiance&quot;], &quot;fullscreen&quot;: false, &quot;init&quot;: true, &quot;instructions&quot;: [&quot;if k%2==0 :&quot;], &quot;codes&quot;: [{&quot;lang&quot;: &quot;python&quot;, &quot;code&quot;: &quot;#################\\n##Initialisation#\\n#################\\nnombre_ligne=1\\nnombre_colonne=20\\nmat=[[1] * nombre_colonne for _ in range(nombre_ligne)]\\n########################\\n##Boucle sur la matrice#\\n########################\\nfor i in range(nombre_ligne):\\n  for j in range(nombre_colonne):\\n      mat[i][j]=??\\n###########################\\n##Affichage de la matrice##\\n###########################\\nfor i in range(nombre_ligne):\\n  print(mat[i])&quot;, &quot;name&quot;: &quot;&quot;, &quot;readonly&quot;: false}], &quot;run&quot;: {&quot;reply&quot;: &quot;reply1&quot;, &quot;label&quot;: &quot;Jouer le code !&quot;, &quot;variables&quot;: [&quot;mat&quot;], &quot;keywords&quot;: [&quot;for&quot;, &quot;if&quot;]}}\"></div></div>\tModifier cet algorithme avec l'instruction conditionnelle <code>if k%2==0 :</code>\t pour qu'il effectue <b>sans erreur</b> la représentation donnée à droite ou ci-dessous.\t<br/>\t<div class=\"wimscenter wimsborder box\">\t<div class=\"pax-jsxgraph\" id=\"jsxbox\" data-w=\"500\" data-h=\"500\" data-maxw=\"500\" data-jsxgraph=\"jsxbox,400 x 400,JXG.Options.point.fixed = true;\tJXG.Options.point.showInfobox=false;\tJXG.Options.point.name = &quot;&quot;;\tJXG.Options.point.face = &quot;[]&quot;;\tJXG.Options.point.withLabel=true;\"></div>\t</div>\t<div class=\"wimscenter wimsborder box\">\t<div class=\"pax-jsxgraph\" id=\"jsxbox\" data-w=\"500\" data-h=\"500\" data-maxw=\"500\" data-jsxgraph=\"jsxbox1,400 x 400,JXG.Options.point.fixed = true;\tJXG.Options.point.showInfobox=false;\tJXG.Options.point.highlight=true;\tJXG.Options.point.name = &quot;&quot;;\tJXG.Options.point.face = &quot;[]&quot;;\tJXG.Options.point.size = 7.5;\tJXG.Options.point.withLabel=true;\tvar board = JXG.JSXGraph.initBoard(&#x27;jsxbox1&#x27;, {axis:false, boundingbox: [-2,-2,22,22],\tshownavigation:false,showCopyright:false,showFullscreen: true});\txaxis = board.create(&#x27;axis&#x27;, [[0, 0], [1,0]],\t      {name:&#x27;nombre de colonnes&#x27;,\t      withLabel: true,\t      label: {position: &#x27;lrt&#x27;,offset: [-100, 25]},\t      });\txaxis.removeAllTicks();\tboard.create(&#x27;ticks&#x27;, [xaxis, 1],{\t  strokeColor:&#x27;#ccc&#x27;,\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [5, 10]},\t  minorTicks:0,\t  drawZero:true});\tyaxis = board.create(&#x27;axis&#x27;, [[0, 0], [0,1]],\t      {name:&#x27;nombre de lignes&#x27;,\t      withLabel: true,\t      label: {position: &#x27;lrt&#x27;,offset: [10, 0]}\t      ,ticks:{scale: 1}}\t      );\tyaxis.removeAllTicks();\tboard.create(&#x27;ticks&#x27;, [yaxis, 1],{\t  strokeColor:&#x27;#ccc&#x27;,\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [-15, -10]},\t  minorTicks:0,\t  drawZero:true});\tboard.create(&#x27;point&#x27;, [2-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [4-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [6-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [8-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [10-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [12-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [14-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [16-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [18-0.5,0.5],{color:&#x27;black&#x27;});\nboard.create(&#x27;point&#x27;, [20-0.5,0.5],{color:&#x27;black&#x27;});\"></div>\t</div>\t</div>\t<script>\tfunction graph(){\tmat=Sk.ffi.remapToJs(Sk.globals[\"mat\"]);\tlet matligne=mat.length;\tlet matcolonne=mat[0].length;\tlet max=Math.max(matligne,matcolonne);\tlet gg=1.1*max;\tlet ggm=0.1*max;\tJXG.Options.point.size = 150/max;\tvar brd = JXG.JSXGraph.initBoard('jsxbox', {axis:false, boundingbox: [-ggm,-ggm,gg,gg],\tshownavigation:false,showCopyright:false,showFullscreen: true});\txxaxis = brd.create('axis', [[0, 0], [1,0]],\t      {name:'nombre de colonnes',\t      withLabel: true,\t      label: {position: 'lrt',offset: [-100, 25]},\t      });\txxaxis.removeAllTicks();\tbrd.create('ticks', [xxaxis, 1],{\t  strokeColor:'#ccc',\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [5, 10]},\t  minorTicks:0,\t  drawZero:true});\tyyaxis = brd.create('axis', [[0, 0], [0,1]],\t      {name:'nombre de lignes',\t      withLabel: true,\t      label: {position: 'lrt',offset: [10, 0]}\t      ,ticks:{scale: 1}}\t      );\tyyaxis.removeAllTicks();\tbrd.create('ticks', [yyaxis, 1],{\t  strokeColor:'#ccc',\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [-15, -10]},\t  minorTicks:0,\t  drawZero:true});\tbrd.suspendUpdate();\tfor(var jj = 0; jj < matligne; jj=jj+1) {\tfor(var ii = 0; ii < matcolonne; ii=ii+1) {\t/*name:aaa[ss][jj][ii]*/\tif(mat[jj][ii]==0){\tbrd.create('point', [ii+0.5,jj+0.5],{color:'black'});}}}\tbrd.unsuspendUpdate();}\texecidtest2.addEventListener('click',graph);\t</script>\t",
