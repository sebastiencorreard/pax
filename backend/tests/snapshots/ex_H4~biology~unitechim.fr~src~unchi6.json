  "statement_html": "\t  <style type=\"text/css\">\t .enonce{margin-bottom:0}\t .qcm_prompt2{margin-top:.5em}\t img{vertical-align:middle;}\t .q_num, .panel .wims_title{\t font-size:150%;font-family:Impact, Charcoal, sans-serif;\t color:#777;\t }\t .feedback{border:1px dashed grey;padding:0.5em;margin:0;}\t .reponse {\t   margin: 0 1em;\t   padding: .5em;\t   border-radius:5px;\t   background-color: #FFCC99;\t }\t .panel{\t    padding:.5em 1em .5em 1em;\t    margin:.5em 0;\t    border:1px solid #d8d8d8;\t    border-radius:5px;\t    background-color: #f2f2f2;\t }\t .panel.callout{\t    border-color:#c5e5f3;\t    border-width:2px;\t    background-color: #F2F9FC;\t }\t .callout .q_num, .callout .wims_title{color:black;}\t\t .panel .wims_title, .panel .wimscenter{margin-top:-1.2em;}\t ol li{margin-bottom: .5em;list-style: upper-alpha;}\t input[type='checkbox'] { font-size:150%; }\t .strike{text-decoration:line-through;}\t .oef_indpartial{color:navy;}\t #answeranalysis{display:none;}\t </style>\t  <div class=\"instructions\">Répondez aux questions pour tester et consolider vos connaissances sur l'unité chimique du vivant.</div>\t\t   \t                <div class=\"panel callout\">      \t        <div class=\"enonce\">\t       <span class=\"q_num\">1 :</span>        <span class=\"preliminaire\">&nbsp;</span>\t       <span class=\"question\">L'eau est une molécule fondamentale du vivant :</span>\t     </div>\t    \t              <div class=\"question\">\t        <ol>\t            <li> <label class=\"oef-checkbox-label\"><input type=\"checkbox\" class=\"oef-checkbox\" name=\"reply1\" value=\"1\" /> qui a pour formule chimique CO2.</label>, <label class=\"oef-checkbox-label\"><input type=\"checkbox\" class=\"oef-checkbox\" name=\"reply1\" value=\"2\" /> qui est composée de deux molécules d'hydrogène et d'une d'oxygène.</label>, <label class=\"oef-checkbox-label\"><input type=\"checkbox\" class=\"oef-checkbox\" name=\"reply1\" value=\"3\" /> qui est la molécule minérale la pl