  "solution_html": "<div class=\"table-scroll\"><div class=\"table-scroll\"><table class=\"wimsborder wims_matrix1\">\n  <tr><th style=\"text-align:center\">Description d'évolution</th> <th style=\"text-align:center\">Expression en fonction de \\(x\\)</th></tr>\n  <tr><td style=\"text-align:center\">hausse de 6 €<br>puis baisse de 12 %</td> <td style=\"text-align:center\">\\(\\left(x + 6 \\right) \\times \\left(1-\\frac{12}{100}\\right)\\) \\(=\\) \\(0.88 \\left(x + 6\\right)\\)</td></tr>\n  <tr><td style=\"text-align:center\">hausse de 6 % <br>puis hausse de 12 %</td> <td style=\"text-align:center\">\\(x \\times \\left(1+\\frac{6}{100}\\right) \\times \\left(1+\\frac{12}{100}\\right)\\) \\(=\\) \\(1.1872 x\\)</td></tr>\n  <tr><td style=\"text-align:center\">hausse de 6 €<br>puis hausse de 12 %</td> <td style=\"text-align:center\">\\(\\left(x + 6 \\right) \\times \\left(1+\\frac{12}{100}\\right)\\) \\(=\\) \\(1.12 \\left(x + 6\\right)\\)</td></tr>\n  <tr><td style=\"text-align:center\">baisse de 6 %<br>puis hausse de 12 €</td> <td style=\"text-align:center\">\\(x \\times \\left(1-\\frac{6}{100}\\right) +12\\) \\(=\\) \\(0.94 x + 12\\)</td></tr>\n  <tr><td style=\"text-align:center\">baisse de 6 €<br>puis hausse de 12 %</td> <td style=\"text-align:center\">\\(\\left(x - 6 \\right) \\times \\left(1+\\frac{12}{100}\\right)\\) \\(=\\) \\(1.12 \\left(x - 6\\right)\\)</td></tr>\n</table></div></div> "
