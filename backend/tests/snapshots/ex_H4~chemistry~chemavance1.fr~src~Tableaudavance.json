bsp;\t  </td>\t   <td class=\"td-center\">\t  <div style=\"background:lightyellow;border:black dashed 1px\">0+1*x</div>\t </td>\t</tr>\t<!-- ligne 5 -->\t<tr>\t <td>état final</td>\t <td class=\"td-center\">\\(x_{max}\\)= <span class=\"oef-input\" name=\"reply1\" data-size=\"4\"></span></td>\t     <td class=\"td-center\"> <span class=\"oef-input\" name=\"reply2\" data-size=\"10\"></span></td>\t   <td>&nbsp;</td>\t     <td class=\"td-center\"> <span class=\"oef-input\" name=\"reply3\" data-size=\"10\"></span></td>\t   <td>&nbsp;</td>\t     <td class=\"td-center\"> <span class=\"oef-input\" name=\"reply4\" data-size=\"10\"></span></td>\t   <td>&nbsp;</td>\t   <td class=\"td-center\"> <span class=\"oef-input\" name=\"reply5\" data-size=\"10\"></span></td>\t</tr>\t</table>\t\t\t",
