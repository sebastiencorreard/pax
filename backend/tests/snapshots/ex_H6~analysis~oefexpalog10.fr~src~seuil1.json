  "statement_html": "<div class=\"wims_question\">Déterminer le plus petit entier naturel \\(n\\) tel que \\(3.1^n > 5\\:006\\:000\\).</div>\t\\(n =\\) <span class=\"oef-input\" name=\"reply1\" data-size=\"3\"></span>.",
