max;\tJXG.Options.point.size = 150/max;\tvar brd = JXG.JSXGraph.initBoard('jsxbox', {axis:false, boundingbox: [-ggm,-ggm,gg,gg],\tshownavigation:false,showCopyright:false,showFullscreen: true});\txxaxis = brd.create('axis', [[0, 0], [1,0]],\t      {name:'nombre de colonnes',\t      withLabel: true,\t      label: {position: 'lrt',offset: [-100, 25]},\t      });\txxaxis.removeAllTicks();\tbrd.create('ticks', [xxaxis, 1],{\t  strokeColor:'#ccc',\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [5, 10]},\t  minorTicks:0,\t  drawZero:true});\tyyaxis = brd.create('axis', [[0, 0], [0,1]],\t      {name:'nombre de lignes',\t      withLabel: true,\t      label: {position: 'lrt',offset: [10, 0]}\t      ,ticks:{scale: 1}}\t      );\tyyaxis.removeAllTicks();\tbrd.create('ticks', [yyaxis, 1],{\t  strokeColor:'#ccc',\t  majorHeight:-1,\t  drawLabels:true,\t  label: { offset: [-15, -10]},\t  minorTicks:0,\t  drawZero:true});\tbrd.suspendUpdate();\tfor(var jj = 0; jj < matligne; jj=jj+1) {\tfor(var ii = 0; ii < matcolonne; ii=ii+1) {\t/*name:aaa[ss][jj][ii]*/\tif(mat[jj][ii]==0){\tbrd.create('point', [ii+0.5,jj+0.5],{color:'black'});}}}\tbrd.unsuspendUpdate();}\texecidtest2.addEventListener('click',graph);\t</script>\t",
