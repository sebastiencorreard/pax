ment&#x27;,[B,C]);\tcat1=brd.create(&#x27;segment&#x27;,[A,B]);\tcat2=brd.create(&#x27;segment&#x27;,[A,C]);\t\tbrd.create(&#x27;angle&#x27;,[C,B,A],{name:&#x27; &#x27;,radius:0.38333333,strokeColor:&#x27;black&#x27;,fillColor:&#x27;rgb(140,125,114)&#x27;,fillOpacity:1});\t;var jsxbox_objet=[];var __paxObjR=function(){try{if(typeof __paxReport===&#x27;function&#x27;)__paxReport(jsxbox_objet.toString());}catch(e){}};try{cat1.on(&#x27;up&#x27;,function(){if(cat1.getAttribute(&#x27;strokeWidth&#x27;)!=5){jsxbox_objet.push(&#x27;cat1&#x27;);cat1.setAttribute({strokeWidth:5});}else{cat1.setAttribute({strokeWidth:2});jsxbox_objet.splice(jsxbox_objet.indexOf(&#x27;cat1&#x27;),1);}__paxObjR();});}catch(e){}try{hypo.on(&#x27;up&#x27;,function(){if(hypo.getAttribute(&#x27;strokeWidth&#x27;)!=5){jsxbox_objet.push(&#x27;hypo&#x27;);hypo.setAttribute({strokeWidth:5});}else{hypo.setAttribute({strokeWidth:2});jsxbox_objet.splice(jsxbox_objet.indexOf(&#x27;hypo&#x27;),1);}__paxObjR();});}catch(e){}try{cat2.on(&#x27;up&#x27;,function(){if(cat2.getAttribute(&#x27;strokeWidth&#x27;)!=5){jsxbox_objet.push(&#x27;cat2&#x27;);cat2.setAttribute({strokeWidth:5});}else{cat2.setAttribute({strokeWidth:2});jsxbox_objet.splice(jsxbox_objet.indexOf(&#x27;cat2&#x27;),1);}__paxObjR();});}catch(e){}__paxObjR();\"></div>      </div>\t       </div>\t</div>\t",
